.DS_Store
Thumbs.db
out

# the CONTRIBUTING.md bootstrap output (`mach build . -o m`), and the
# generation binaries a self-host fixpoint check leaves beside it
/m
/m[0-9]
/g[A-Z]

# a qemu-user leg that crashes drops its core in the working directory, so an
# untracked-file sweep picks them up and commits them
*.core

# transaction control files a pre-#3310 formatter left beside the sources
.mach-txn-lock
.machtxn.*
