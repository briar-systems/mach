# a SPIR-V module for Vulkan 1.3 (SPIR-V 1.6, 2.3 physical layout; Vulkan 1.3, appendix A)
flags --target vulkan-spirv --env vulkan1.3 -k module
takes gpu
local spirv-val --target-env vulkan1.3
has   Magic: 0x7230203
has   Version: 0x10600
# the Shader capability, logical addressing under the Vulkan memory model, which Vulkan 1.3
# requires a device to support and which needs its capability, and an entry point
has   Opcode: OpCapability ; Capability: Shader
has   Opcode: OpCapability ; Capability: VulkanMemoryModel
has   Opcode: OpMemoryModel ; AddressingModel: Logical ; MemoryModel: Vulkan
has   Opcode: OpEntryPoint
# no capability of another client API
lacks Opcode: OpCapability ; Capability: Kernel
lacks Opcode: OpCapability ; Capability: Addresses
