# a SPIR-V module for no stated environment: SPIR-V 1.6 with every device feature a Vulkan
# consumer can enable (SPIR-V 1.6, 2.3 physical layout), checked as Vulkan 1.3 consumes it
flags --target vulkan-spirv -k module
takes gpu
local spirv-val --target-env vulkan1.3
has   Magic: 0x7230203
has   Version: 0x10600
# the Shader capability, logical or physical addressing under the Vulkan memory model, and an
# entry point
has   Opcode: OpCapability ; Capability: Shader
has   Opcode: OpCapability ; Capability: VulkanMemoryModel
has   Opcode: OpMemoryModel ; MemoryModel: Vulkan
has   Opcode: OpEntryPoint
# no capability of another client API
lacks Opcode: OpCapability ; Capability: Kernel
lacks Opcode: OpCapability ; Capability: Addresses
