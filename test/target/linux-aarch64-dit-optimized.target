# linux on aarch64 with FEAT_DIT selected, as linux-aarch64-dit, built with the optimizer and
# mirl's verifiers, so a pass that breaks a constant-time function's timing or leaks a secret is
# refused or shows when the constant-time programs run (Arm ARM DDI 0487, "About PSTATE.DIT")
flags --target linux-aarch64 --ext dit -O --verify
takes run/secret
local qemu-aarch64
has   Class: ELFCLASS64
has   DataEncoding: ELFDATA2LSB
has   Machine: EM_AARCH64
has   Type: ET_EXEC
each  Type: PT_LOAD ; Alignment: 65536
lacks Type: PT_LOAD ; Flags: PF_X PF_W
lacks Type: PT_GNU_STACK ; Flags: PF_X
# no loader and no runtime relocates a static image, so the constants that hold addresses are
# read-only data from the start: the image has no RELRO segment and no writable .data.rel.ro
lacks Type: PT_GNU_RELRO
lacks Name: .data.rel.ro ; Flags: SHF_WRITE
