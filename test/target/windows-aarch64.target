# a PE32+ console executable for windows on arm64 (Microsoft PE/COFF specification)
flags --target windows-aarch64
has   Magic: MZ
has   Machine: IMAGE_FILE_MACHINE_ARM64
has   IMAGE_FILE_EXECUTABLE_IMAGE
has   Magic: 0x20b
has   Subsystem: IMAGE_SUBSYSTEM_WINDOWS_CUI
# arm64 windows loads every image at a randomized base: relocations must not be stripped
has   IMAGE_DLLCHARACTERISTICS_DYNAMIC_BASE
lacks IMAGE_FILE_RELOCS_STRIPPED
lacks ImportTableSize: 0x0
lacks IMAGE_SCN_MEM_EXECUTE ; IMAGE_SCN_MEM_WRITE
