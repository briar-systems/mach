# a PE32+ console executable for windows on x86-64 (Microsoft PE/COFF specification)
flags --target windows-x86_64
local wine
has   Magic: MZ
has   Machine: IMAGE_FILE_MACHINE_AMD64
has   IMAGE_FILE_EXECUTABLE_IMAGE
has   Magic: 0x20b
has   Subsystem: IMAGE_SUBSYSTEM_WINDOWS_CUI
# a windows program reaches the system through imports, and no section is writable and executable
lacks ImportTableSize: 0x0
lacks IMAGE_SCN_MEM_EXECUTE ; IMAGE_SCN_MEM_WRITE
# a program imports only what the functions it keeps call: no image of the corpus reaches
# the network, so none imports winsock
lacks Name: ws2_32.dll
