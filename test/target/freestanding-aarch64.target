# a static ELF executable with no operating system, aarch64 (ELF gABI; ELF for the Arm 64-bit Architecture)
flags --target freestanding-aarch64 --isa armv8-a+fp+simd --set stack_reserve=0x10000
has   Class: ELFCLASS64
has   Machine: EM_AARCH64
has   Type: ET_EXEC
lacks Type: PT_LOAD ; Flags: PF_X PF_W
