# a WebAssembly module for WASI preview 1 (WebAssembly core specification 1.0, binary format)
flags --target wasi-wasm32
local wasmtime run
has   Format: WASM
has   Version: 0x1
# a command module imports the system's functions, has code and a memory, and exports its entry
has   Type: IMPORT
has   Type: CODE
has   Type: MEMORY
has   Type: EXPORT
# a command exports its entry as `_start` and its memory as `memory`, and imports only
# what the runtime provides, from wasi_snapshot_preview1, since an import no runtime
# module provides fails instantiation (WASI preview 1 application ABI; WebAssembly core
# specification 1.0, 4.5.4 instantiation)
has   Name: _start ; Kind: FUNCTION
has   Name: memory ; Kind: MEMORY
each  Module ; Module: wasi_snapshot_preview1
