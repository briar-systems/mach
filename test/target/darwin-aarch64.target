# a Mach-O executable for macOS on arm64, loaded by dyld (Mach-O file format, <mach-o/loader.h>)
flags --target darwin-aarch64
has   Magic: MH_MAGIC_64
has   CpuType: ARM64
has   FileType: MH_EXECUTE
has   Flags: MH_DYLDLINK MH_PIE
has   Name: __PAGEZERO ; initprot: ---
has   Name: __TEXT
has   Name: __LINKEDIT
has   Cmd: LC_LOAD_DYLINKER ; Name: /usr/lib/dyld
has   Cmd: LC_MAIN
has   Cmd: LC_SYMTAB
has   Cmd: LC_BUILD_VERSION
has   Name: /usr/lib/libSystem.B.dylib
# the arm64 kernel runs no unsigned code: the image carries a code signature
has   Cmd: LC_CODE_SIGNATURE
lacks initprot: rwx
