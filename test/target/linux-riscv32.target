# a static ELF executable for linux on riscv32 under ilp32d (ELF gABI; RISC-V ELF psABI)
flags --target linux-riscv32 --isa rv32gc --abi ilp32d
local qemu-riscv32
has   Class: ELFCLASS32
has   DataEncoding: ELFDATA2LSB
has   Machine: EM_RISCV
has   Type: ET_EXEC
has   Flags: EF_RISCV_FLOAT_ABI_DOUBLE
lacks Flags: EF_RISCV_RVE
each  Type: PT_LOAD ; Alignment: 4096
lacks Type: PT_LOAD ; Flags: PF_X PF_W
lacks Type: PT_GNU_STACK ; Flags: PF_X
# the constants that hold addresses are read-only once the runtime has protected them, as no loader
# starts a static image: a RELRO segment is read-only, lies in a writable loaded segment and holds
# those constants. an image with none of them has no RELRO segment, and each rule holds of it
lacks Type: PT_GNU_RELRO ; Flags: PF_W
lacks Type: PT_GNU_RELRO ; Flags: PF_X
inside Type: PT_GNU_RELRO | Type: PT_LOAD ; Flags: PF_W PF_R
inside Name: .data.rel.ro | Type: PT_GNU_RELRO
