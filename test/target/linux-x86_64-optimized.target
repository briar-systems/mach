# the host's system again, built with the optimizer and mirl's verifiers, so a miscompile
# that only an optimization pass makes still shows (ELF gABI; System V ABI, AMD64 supplement)
flags --target linux-x86_64 -O --verify
has   Machine: EM_X86_64
has   Type: ET_EXEC
lacks Type: PT_LOAD ; Flags: PF_X PF_W
