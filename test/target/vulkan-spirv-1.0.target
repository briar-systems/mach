# a SPIR-V module for Vulkan 1.0 (SPIR-V 1.0, 2.3 physical layout; Vulkan 1.0, appendix A)
flags --target vulkan-spirv --env vulkan1.0 -k module
takes gpu
local spirv-val --target-env vulkan1.0
has   Magic: 0x7230203
has   Version: 0x10000
# the Shader capability under logical addressing and the GLSL450 memory model, since the
# Vulkan memory model needs SPIR-V 1.3, and an entry point
has   Opcode: OpCapability ; Capability: Shader
has   Opcode: OpMemoryModel ; AddressingModel: Logical ; MemoryModel: GLSL450
has   Opcode: OpEntryPoint
lacks Opcode: OpCapability ; Capability: VulkanMemoryModel
# nothing of SPIR-V 1.3 or later: no subgroup operations and no physical addresses
lacks Opcode: OpCapability ; Capability: GroupNonUniform
lacks Opcode: OpCapability ; Capability: PhysicalStorageBufferAddresses
# no capability of another client API
lacks Opcode: OpCapability ; Capability: Kernel
lacks Opcode: OpCapability ; Capability: Addresses
