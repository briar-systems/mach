# the WebAssembly module for WASI preview 1 with simd128 again, built with the optimizer and mirl's
# verifiers, so a miscompile or a broken invariant that only optimised simd128 code makes still
# shows (WebAssembly core specification 2.0, 128-bit SIMD)
flags --target wasi-wasm32 --ext simd128 -O --verify
local wasmtime run
has   Format: WASM
has   Version: 0x1
has   Type: IMPORT
has   Type: CODE
has   Type: MEMORY
has   Type: EXPORT
has   Name: _start ; Kind: FUNCTION
has   Name: memory ; Kind: MEMORY
each  Module ; Module: wasi_snapshot_preview1
