# a PE32+ UEFI application for AArch64 (UEFI specification 2.10, 2.1.1; Microsoft PE/COFF specification)
flags --target uefi-aarch64 --abi aapcs64win
has   Magic: MZ
has   Machine: IMAGE_FILE_MACHINE_ARM64
has   IMAGE_FILE_EXECUTABLE_IMAGE
has   Magic: 0x20b
has   Subsystem: IMAGE_SUBSYSTEM_EFI_APPLICATION
has   ImportTableSize: 0x0
lacks IMAGE_FILE_RELOCS_STRIPPED
