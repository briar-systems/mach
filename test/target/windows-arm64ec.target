# a PE32+ console executable for windows on arm64 in emulation compatible code (Microsoft
# PE/COFF specification, ARM64EC ABI). std has no entry for it, so it takes the programs that
# state their own
flags --target windows-arm64ec
takes run/entry
has   Magic: MZ
has   Machine: IMAGE_FILE_MACHINE_AMD64
has   IMAGE_FILE_EXECUTABLE_IMAGE
has   Magic: 0x20b
has   Subsystem: IMAGE_SUBSYSTEM_WINDOWS_CUI
has   IMAGE_DLLCHARACTERISTICS_DYNAMIC_BASE
lacks IMAGE_FILE_RELOCS_STRIPPED
lacks ImportTableSize: 0x0
lacks IMAGE_SCN_MEM_EXECUTE ; IMAGE_SCN_MEM_WRITE
# the loader finds the hybrid image's code map and auxiliary import table through its metadata
has   CHPEMetadataPointer
has   AuxiliaryIAT ; AuxiliaryIATCopy
