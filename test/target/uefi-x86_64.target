# a PE32+ UEFI application for x64 (UEFI specification 2.10, 2.1.1; Microsoft PE/COFF specification)
flags --target uefi-x86_64
has   Magic: MZ
has   Machine: IMAGE_FILE_MACHINE_AMD64
has   IMAGE_FILE_EXECUTABLE_IMAGE
has   Magic: 0x20b
has   Subsystem: IMAGE_SUBSYSTEM_EFI_APPLICATION
# firmware links nothing: no imports. it loads the image anywhere, so relocations are kept
has   ImportTableSize: 0x0
lacks IMAGE_FILE_RELOCS_STRIPPED
