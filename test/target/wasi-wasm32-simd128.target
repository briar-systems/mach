# a WebAssembly module for WASI preview 1 with simd128 (WebAssembly core specification 2.0,
# 128-bit SIMD), whose v128 holds a vector of 16 bytes and no shorter one: every other vector
# is taken lane by lane, so a vector of 8 bytes builds and runs as on the plain module
flags --target wasi-wasm32 --ext simd128
local wasmtime run
has   Format: WASM
has   Version: 0x1
has   Type: IMPORT
has   Type: CODE
has   Type: MEMORY
has   Type: EXPORT
has   Name: _start ; Kind: FUNCTION
has   Name: memory ; Kind: MEMORY
each  Module ; Module: wasi_snapshot_preview1
