# the Vulkan 1.2 module again, built with the optimizer and mirl's verifiers, so a pointer an
# optimization pass merges where paths join, which logical addressing without variable pointers
# cannot carry, still shows (SPIR-V 1.5, 2.3 physical layout; Vulkan 1.2, appendix A)
flags --target vulkan-spirv --env vulkan1.2 -k module -O --verify
takes gpu
local spirv-val --target-env vulkan1.2
has   Magic: 0x7230203
has   Version: 0x10500
# the Shader capability under logical addressing and the GLSL450 memory model, since the
# Vulkan memory model is an optional feature this target does not select, and an entry point
has   Opcode: OpCapability ; Capability: Shader
has   Opcode: OpMemoryModel ; AddressingModel: Logical ; MemoryModel: GLSL450
has   Opcode: OpEntryPoint
lacks Opcode: OpCapability ; Capability: VulkanMemoryModel
# no physical addresses, an optional feature of Vulkan 1.2 this target does not select
lacks Opcode: OpCapability ; Capability: PhysicalStorageBufferAddresses
# no capability of another client API
lacks Opcode: OpCapability ; Capability: Kernel
lacks Opcode: OpCapability ; Capability: Addresses
