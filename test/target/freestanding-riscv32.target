# a static ELF executable with no operating system, riscv32 under the soft-float ilp32 (ELF gABI; RISC-V ELF psABI)
flags --target freestanding-riscv32 --isa rv32imc --abi ilp32 --set stack_reserve=0x10000
has   Class: ELFCLASS32
has   Machine: EM_RISCV
has   Type: ET_EXEC
# ilp32 is the soft-float convention: no float-ABI bit, and not the embedded convention
lacks Flags: EF_RISCV_FLOAT_ABI_SINGLE
lacks Flags: EF_RISCV_FLOAT_ABI_DOUBLE
lacks Flags: EF_RISCV_FLOAT_ABI_QUAD
lacks Flags: EF_RISCV_RVE
lacks Type: PT_LOAD ; Flags: PF_X PF_W
