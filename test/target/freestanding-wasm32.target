# a WebAssembly module nothing but its host runs, with no system interface (WebAssembly core
# specification 1.0, binary format). std.runtime's `_start` calls main(0, nil) as every
# freestanding entry does, and some of the corpus's programs count a program name in argc, so no
# runner calls it here
flags --target freestanding-wasm32
has   Format: WASM
has   Version: 0x1
has   Type: CODE
has   Type: MEMORY
has   Type: EXPORT
# the module exports the entry std.runtime defines as `_start` and its memory as `memory`
has   Name: _start ; Kind: FUNCTION
has   Name: memory ; Kind: MEMORY
# no system supplies a module, so a program that declares no import imports nothing, and
# above all nothing from wasi_snapshot_preview1
lacks Type: IMPORT
lacks Module: wasi_snapshot_preview1
# an active data segment initializes memory 0, the only memory a 1.0 module may have, so the
# only valid memory index is 0 (WebAssembly core specification 1.0, binary format, data section)
each  MemoryIndex ; MemoryIndex: 0
