# a static ELF executable for linux on x86-64 (ELF gABI; System V ABI, AMD64 supplement)
flags --target linux-x86_64
local qemu-x86_64
has   Class: ELFCLASS64
has   DataEncoding: ELFDATA2LSB
has   Machine: EM_X86_64
has   Type: ET_EXEC
# every loaded segment sits on a 4 KiB page, none is both writable and executable, nor is the stack
each  Type: PT_LOAD ; Alignment: 4096
lacks Type: PT_LOAD ; Flags: PF_X PF_W
# the program header table holds exactly the headers the image states, no reserved null slot
lacks Type: PT_NULL
lacks Type: PT_GNU_STACK ; Flags: PF_X
# no loader and no runtime relocates a static image, so the constants that hold addresses are
# read-only data from the start: the image has no RELRO segment and no writable .data.rel.ro
lacks Type: PT_GNU_RELRO
lacks Name: .data.rel.ro ; Flags: SHF_WRITE
# the image is entered at the runtime's `_start`, never at main: the runtime and main are in
# the image, kept by the entry and by the runtime's call, since a symbol keeps nothing
has   Name: _start ; Type: STT_FUNC
has   Name: _rt_init ; Type: STT_FUNC
has   Name: main ; Type: STT_FUNC
# a function nothing refers to is left out, whatever symbol it states (run/fun/unreached.mach)
lacks Name: corpus_unreached
# x86-64's table states a multiply and a division at 32 and 64 bits alone, so a narrow product
# runs at 32 bits and keeps the low bits, never a helper call (run/int/small.mach)
lacks Name: __mirl_mul8
lacks Name: __mirl_mul16
# a comparison widened to 64 bits is its setcc into a register cleared by xor, with no extension
# after it, so the function is the stores of its parameters, the clear, the compare, the setcc and
# the return (run/int/widen.mach)
each  Name: corpus_widen_compare ; Size: 19
# a module array takes the floor sysv64 states for a global array variable, 16 from 16 bytes
# (x86-64 psABI, 3.1.2 aggregates and unions), its element's alignment below that, and an
# `#[align]` above it (run/data/array_align.mach)
each  Name: corpus_align_small ; Value: %4
each  Name: corpus_align_sixteen ; Value: %16
each  Name: corpus_align_large ; Value: %16
each  Name: corpus_align_wide ; Value: %64
