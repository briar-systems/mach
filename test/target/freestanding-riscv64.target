# a static ELF executable with no operating system, riscv64 under lp64d (ELF gABI; RISC-V ELF psABI)
flags --target freestanding-riscv64 --isa rv64gc --abi lp64d --set stack_reserve=0x10000
has   Class: ELFCLASS64
has   Machine: EM_RISCV
has   Type: ET_EXEC
has   Flags: EF_RISCV_FLOAT_ABI_DOUBLE
lacks Flags: EF_RISCV_RVE
lacks Type: PT_LOAD ; Flags: PF_X PF_W
