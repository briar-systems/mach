# a WebAssembly module for WASI preview 1 that its host calls only through its exports, a reactor
# (WebAssembly core specification 1.0, binary format; WASI preview 1 application ABI)
flags --target wasi-wasm32 -k module
takes reactor
local wasm-tools validate
has   Format: WASM
has   Version: 0x1
has   Type: CODE
has   Type: MEMORY
has   Type: EXPORT
# a reactor exports its memory as `memory` and no entry, neither a command's `_start` nor an
# `_initialize`, since its globals hold constant initial values and nothing runs before a call
has   Name: memory ; Kind: MEMORY
lacks Name: _start
lacks Name: _initialize
# what it imports, it imports from wasi_snapshot_preview1, as a command does
each  Module ; Module: wasi_snapshot_preview1
# an active data segment initializes memory 0, the only memory a 1.0 module may have
each  MemoryIndex ; MemoryIndex: 0
