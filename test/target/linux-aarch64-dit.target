# linux on aarch64 with FEAT_DIT selected, under which aarch64's data-processing instructions
# have data-independent timing (Arm ARM DDI 0487, "About PSTATE.DIT"): a hard constant-time
# function builds here and nowhere else on linux-aarch64. it takes the constant-time programs
flags --target linux-aarch64 --ext dit
takes run/secret
local qemu-aarch64
has   Class: ELFCLASS64
has   DataEncoding: ELFDATA2LSB
has   Machine: EM_AARCH64
has   Type: ET_EXEC
each  Type: PT_LOAD ; Alignment: 65536
lacks Type: PT_LOAD ; Flags: PF_X PF_W
lacks Type: PT_GNU_STACK ; Flags: PF_X
