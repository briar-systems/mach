# a static ELF executable for linux on riscv64 under lp64d with the v extension (ELF gABI; RISC-V ELF psABI;
# RVV 1.0). a constant-time function here holds its vector code to Zvkt, which a soft function assumes
# and a hard one needs selected
flags --target linux-riscv64 --ext v
local qemu-riscv64 -cpu rv64,v=true
has   Class: ELFCLASS64
has   DataEncoding: ELFDATA2LSB
has   Machine: EM_RISCV
has   Type: ET_EXEC
# e_flags name the double-float convention and not the embedded one
has   Flags: EF_RISCV_FLOAT_ABI_DOUBLE
lacks Flags: EF_RISCV_RVE
each  Type: PT_LOAD ; Alignment: 4096
lacks Type: PT_LOAD ; Flags: PF_X PF_W
lacks Type: PT_GNU_STACK ; Flags: PF_X
# the constants that hold addresses are read-only once the runtime has protected them, as no loader
# starts a static image: a RELRO segment is read-only, lies in a writable loaded segment and holds
# those constants. an image with none of them has no RELRO segment, and each rule holds of it
lacks Type: PT_GNU_RELRO ; Flags: PF_W
lacks Type: PT_GNU_RELRO ; Flags: PF_X
inside Type: PT_GNU_RELRO | Type: PT_LOAD ; Flags: PF_W PF_R
inside Name: .data.rel.ro | Type: PT_GNU_RELRO
# an unsigned comparison of 64-bit lanes is one packed sequence with no mask register, and an
# arithmetic shift of 8-bit lanes by a count per lane is five packed instructions, each beside its
# frame, the loads and stores of its vectors and the one vsetivli they share (run/vec/compare_lanes.mach, run/vec/shift_lanes.mach)
each  Name: corpus_lanes_lt_u64 ; Size: 112
each  Name: corpus_lanes_sar8 ; Size: 100
# a load, two adds and a store of one vector state are one vsetivli and the four instructions,
# beside the frame of a build without optimisation (run/vec/configured.mach)
each  Name: corpus_configured ; Size: 54
