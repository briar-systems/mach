# a Mach-O executable for macOS on x86-64, loaded by dyld (Mach-O file format, <mach-o/loader.h>)
flags --target darwin-x86_64
has   Magic: MH_MAGIC_64
has   CpuType: X86_64
has   FileType: MH_EXECUTE
has   Flags: MH_DYLDLINK MH_PIE
# what dyld needs of a main executable: a zero page, the loader's path, an entry point, libSystem
has   Name: __PAGEZERO ; initprot: ---
has   Name: __TEXT
has   Name: __LINKEDIT
has   Cmd: LC_LOAD_DYLINKER ; Name: /usr/lib/dyld
has   Cmd: LC_MAIN
has   Cmd: LC_SYMTAB
has   Cmd: LC_BUILD_VERSION
has   Name: /usr/lib/libSystem.B.dylib
# imports bind by two-level namespace, each call through a stub in __TEXT and each
# non-lazy pointer in __DATA_CONST, and a C name keeps the leading
# underscore Mach-O gives it (run/fun/import.mach binds getpid)
has   Flags: MH_TWOLEVEL
each  Name: __stubs ; Segment: __TEXT
each  Name: __got ; Segment: __DATA_CONST
lacks Type: N_UNDF ; Name: getpid
lacks initprot: rwx
# the image is entered at the runtime's `start`, never at main: the runtime and main are in
# the image, kept by the entry and by the runtime's call, since a symbol keeps nothing
has   Name: _start ; Type: N_SECT
has   Name: __rt_init ; Type: N_SECT
has   Name: __rt_exit ; Type: N_SECT
has   Name: _main ; Type: N_SECT
# a function nothing refers to is left out, whatever symbol it states (run/fun/unreached.mach)
lacks Name: _corpus_unreached
