# a dynamically linked, position-independent ELF executable for linux on x86-64 with the gnu
# environment (ELF gABI; System V ABI, AMD64 supplement), started by the host's dynamic loader
flags --target linux-x86_64 --env gnu
has   Class: ELFCLASS64
has   Machine: EM_X86_64
# position independent: an ET_DYN image the loader may place anywhere
has   Type: ET_DYN
# the loader the kernel starts it through, and the dynamic section it reads
has   Type: PT_INTERP ; Interpreter: /lib64/ld-linux-x86-64.so.2
has   Type: PT_DYNAMIC
inside Name: .dynamic | Type: PT_DYNAMIC
# the data the loader relocates is made read-only once relocated: the RELRO segment is read-only,
# lies in a writable loaded segment, and holds the relocated constants and the dynamic section
has   Type: PT_GNU_RELRO ; Flags: PF_R
lacks Type: PT_GNU_RELRO ; Flags: PF_W
lacks Type: PT_GNU_RELRO ; Flags: PF_X
inside Type: PT_GNU_RELRO | Type: PT_LOAD ; Flags: PF_W PF_R
inside Name: .data.rel.ro | Type: PT_GNU_RELRO
inside Name: .dynamic | Type: PT_GNU_RELRO
# every loaded segment sits on a 4 KiB page, none is both writable and executable, nor is the stack
each  Type: PT_LOAD ; Alignment: 4096
lacks Type: PT_LOAD ; Flags: PF_X PF_W
lacks Type: PT_GNU_STACK ; Flags: PF_X
has   Name: _start ; Type: STT_FUNC
has   Name: main ; Type: STT_FUNC
