               	lui	t1, 0x1
               	addiw	t1, t1, -0x280
               	add	t1, sp, t1
               	ld	s0, 0x0(t1)
               	lui	t0, 0x1
               	addiw	t0, t0, -0x270
               	add	sp, sp, t0
               	ret
