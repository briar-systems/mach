# the 128-bit folds, in a module of their own: a target that declares no
# 128-bit integer (riscv32, spirv) refuses the type where a declaration names
# it, so the cases that fold a u128 or i128 import this beside lib/fold and
# every other case never sees the type (#3511).
#
# a 128-bit value folds as its two little-endian 64-bit limbs, low limb first.

use corpus.lib.fold;

pub fun mix_u128(h: u64, v: u128) u64 {
    ret fold.mix_u64(fold.mix_u64(h, v::u64), (v >> 64)::u64);
}

pub fun mix_i128(h: u64, v: i128) u64 {
    ret mix_u128(h, v:~u128);
}
