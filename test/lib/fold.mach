# FNV-1a checksum folding, the one accumulator every case in the corpus uses.
#
# every value folds through its full 64-bit widening, so a single byte loop covers
# every width and lib/corpus.h is a transcription rather than a second design.
# unsigned widths zero-extend, signed widths sign-extend and are then read as their
# two's-complement pattern, and floats fold by bit pattern so NaN and -0.0 are exact.

val INIT: u64 = 14695981039346656037;
val PRIME: u64 = 1099511628211;

pub fun init() u64 { ret INIT; }

# fold the eight little-endian bytes of v into h
pub fun mix_u64(h: u64, v: u64) u64 {
    var a: u64 = h;
    var i: u64 = 0;
    for (i < 8) {
        a = a ^ ((v >> (i * 8)) & 255);
        a = a * PRIME;
        i = i + 1;
    }
    ret a;
}

pub fun mix_u8(h: u64, v: u8) u64 { ret mix_u64(h, v::u64); }
pub fun mix_u16(h: u64, v: u16) u64 { ret mix_u64(h, v::u64); }
pub fun mix_u32(h: u64, v: u32) u64 { ret mix_u64(h, v::u64); }

pub fun mix_i8(h: u64, v: i8) u64 { ret mix_u64(h, v::i64:~u64); }
pub fun mix_i16(h: u64, v: i16) u64 { ret mix_u64(h, v::i64:~u64); }
pub fun mix_i32(h: u64, v: i32) u64 { ret mix_u64(h, v::i64:~u64); }
pub fun mix_i64(h: u64, v: i64) u64 { ret mix_u64(h, v:~u64); }

pub fun mix_f32(h: u64, v: f32) u64 { ret mix_u64(h, (v:~u32)::u64); }
pub fun mix_f64(h: u64, v: f64) u64 { ret mix_u64(h, v:~u64); }
