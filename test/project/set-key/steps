# --set spells a key as its table does: one key of the passes table is written over every
# profile, and a path through a profile table is refused naming the spelling that writes it
0 build . -O --set passes.licm=false -w out/set
1 build . --set profile.release.passes.licm=false | as `--set passes.licm=false`
# a project build that writes a profile key names its output, and an entry build, whose profile its command line states, need not
1 build . --set simd=require | name an artifact path with -o
0 build src/main.mach --source std=dep/std --set simd=require
0 build src/main.mach --source std=dep/std -O --set passes.licm=false
