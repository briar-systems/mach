# the records a script reads hold real values: a unit names the target it resolved to though no
# -t selected one, a library's built object carries its size as an executable's does, and a
# listing, which writes no output, names none
0 build . -a records -v --report lines | unit	schema=3	verb=building	artifact=records	target=native	profile=debug
0 build . -a archive --report lines | built.bytes=
0 build . -a shared --report lines | built.bytes=
0 test . -a archive --list --report lines | summary
0 test . -a archive --list --report lines |! <output>
# a refusal raised before any unit builds still ends with the tally
1 build . -t nosuch | 1 error / 0 warnings
1 build . --set simd=fast -o out/fast | 1 error / 0 warnings
# the targets a manifest may name are the ones a build can be made for
0 info targets | linux-x86_64
0 info targets |! opencl-spirv
0 info targets |! sysv32
