# a count of one on a log line takes the singular
0 build . -a single -v -w out/a | 1 module
0 build . -a single -v -w out/b |! 1 modules
# among several cells each failing cell's diagnostics come before the failed line that names it
# with its own count, and no tally of them all follows
1 build . -a broken -t * | failed      broken  one  1 error
1 build . -a broken -t * | failed      broken  two  1 error
1 build . -a broken -t * |! errors /
