use std.types.string.str;
use std.types.string.str_len;

pub rec Pair[T] {
    left:  T;
    right: T;
}

pub fun swap[T](p: Pair[T]) Pair[T] {
    ret Pair[T]{left: p.right, right: p.left};
}

pub fun greeting() str {
    ret "hello";
}

pub fun length(s: str) i64 {
    ret str_len(s)::i64;
}

test swap__exchanges {
    val p: Pair[i64] = swap[i64](Pair[i64]{left: 1, right: 2});
    if (p.left != 2 || p.right != 1) {
        ret 1;
    }
    ret 0;
}
