# wasm32 modules of exports build with no entry, an import from the module a link entry names,
# and std's heap over linear memory. an import no entry attributes is refused, and so is one whose
# entry the artifact does not link, as for a bin. a freestanding bin with no _start is still a
# module of its exports, and a wasi bin with none is refused, naming kind = "module"
0 build . --target web --artifact adder
0 build . --target web --artifact host
0 build . --target web --artifact heap
1 build . --target web --artifact unattributed | #[library
1 build . --target web --artifact unlinked | not among the link's dependencies
0 build . --target web --artifact entryless
0 build . --target wasi --artifact reactor
0 build . --target wasi --artifact adder
1 build . --target wasi --artifact entryless | kind = "module"
