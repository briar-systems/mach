# the module that supplies `host.report` to the adder, as a host would: it counts the reports

var reports: i32 = 0;

# take one report
#[export]
#[symbol("report")]
pub fun report(n: i32) {
    reports = reports + 1;
}

# how many reports were taken
#[export]
#[symbol("reports")]
pub fun count() i32 {
    ret reports;
}
