# a module of exports: `add` reports its first operand to the host's `report`, imported from the
# module the `host` link entry names, and returns the sum

#[library("host")]
ext fun report(n: i32);

# the sum of two operands, the first reported to the host
#[export]
#[symbol("add")]
pub fun add(a: i32, b: i32) i32 {
    report(a);
    ret a + b;
}
