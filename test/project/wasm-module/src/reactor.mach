# a wasi reactor: a module its host calls through its exports, with no _start and no main, which
# keeps a running total across the host's calls

var total: i64 = 0;

# add `n` to the running total and return it
#[export]
#[symbol("accumulate")]
pub fun accumulate(n: i64) i64 {
    total = total + n;
    ret total;
}

# the running total
#[export]
#[symbol("total")]
pub fun current() i64 {
    ret total;
}
