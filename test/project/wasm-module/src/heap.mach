# a module that allocates through std's heap over linear memory, which grows as it fills

use std.allocator;
use std.allocator.heap;
use std.types.error.err;
use std.types.result.res;

# allocate `count` blocks of 4 KiB, at most 64, more than the memory first holds, mark each and
# free them all, returning the sum of the marks read back, or -1 when the heap refuses a step
#[export]
#[symbol("churn")]
pub fun churn(count: i32) i32 {
    var src: heap.Source;
    var h:   heap.Heap;
    var a:   allocator.Allocator;
    heap.linear_source(?src);
    val err_init: err[allocator.Error] = heap.init(?h, ?src, 0);
    if (sel err_init.err) { ret -1; }
    val err_wired: err[allocator.Error] = heap.allocator(?a, ?h);
    if (sel err_wired.err) { ret -1; }
    var blocks: [64]*u8;
    var made:   i32 = 0;
    for (made < count && made < 64) {
        val res_block: res[*u8, allocator.Error] = allocator.allocate[u8](?a, 4096);
        if (sel res_block.err) { ret -1; }
        res_block.ok[0]    = made::u8;
        res_block.ok[4095] = made::u8;
        blocks[made]       = res_block.ok;
        made               = made + 1;
    }
    var sum: i32 = 0;
    var k:   i32 = 0;
    for (k < made) {
        sum = sum + blocks[k][0]::i32 + blocks[k][4095]::i32;
        val err_freed: err[allocator.Error] = allocator.deallocate[u8](?a, blocks[k], 4096);
        if (sel err_freed.err) { ret -1; }
        k = k + 1;
    }
    ret sum;
}
