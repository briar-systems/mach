# git dependencies from a local repository, vlib.bundle (a git bundle tagging v0.1.0 and v0.2.0),
# beside a project app and two path dependencies liba and libc that select vlib at each tag.
# a relative git path, like a relative path, names a place beside the manifest that declares it:
# app's `../vlib.bundle` is beside app, wherever mach runs, and liba's is beside liba's source
0 dep add app vlib --git ../vlib.bundle --ref tag/v0.1.0 | realized  vlib
# a pull with nothing to do says so for each dependency, as update does
0 dep pull app | unchanged  vlib
# the copy under test/out may sit in no repository: list then names no pin and reads nothing
0 dep list app | ref=tag/v0.1.0  realized
0 dep verify app | verified  app
0 dep remove app vlib --purge | removed  [dep.vlib]
# vlib realized for a requirer, then a clash between two requirers, named from the root's id
0 dep add app liba --path ../liba | realized  vlib
1 dep add app libc --path ../libc | app -> libc -> vlib requires git
# declaring vlib at another ref moves its existing checkout, as it realizes a new one
0 dep add app vlib --git ../vlib.bundle --ref tag/v0.2.0 | updated  vlib
0 dep verify app | verified  app
0 dep list app | ref=tag/v0.2.0  realized
