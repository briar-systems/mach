# `a` where the low bit of the secret flag `c` is set, and `b` otherwise
#[constant_time("soft")]
pub fun pick(c: ^u8, a: ^u8, b: ^u8) ^u8 {
    val mask: ^u8 = 0 - (c & 1);
    ret (a & mask) | (b & ~mask);
}

# 1 where `a` and `b` are equal, and 0 otherwise. its instances are compiled into the objects
# of the modules that ask for them
#[constant_time("soft")]
pub fun same[T](a: ^T, b: ^T) ^u8 {
    ret (a == b)::^u8;
}
