use std.runtime;

# division and remainder by constant divisors, which an optimizer rewrites into shifts and
# multiplies: powers of two on signed operands must still truncate toward zero, and the
# magic-number forms must hold at the extremes of each width and for negative divisors.

fun s32(a: i32, b: i32, c: i32) i64 {
    if (a / 2 != -500000 || a % 2 != -1)          { ret 1; }
    if (a / 8 != -125000 || a % 8 != -1)          { ret 2; }
    if (a / 7 != -142857 || a % 7 != -2)          { ret 3; }
    if (a / 10 != -100000 || a % 10 != -1)        { ret 4; }
    if (a / -3 != 333333 || a % -3 != -2)         { ret 5; }
    if (b / 7 != 306783378 || b % 1000 != 647)    { ret 6; }
    if (c / 7 != -306783378 || c % 7 != -2)       { ret 7; }
    if (c / 10 != -214748364 || c % 10 != -8)     { ret 8; }
    if (c / 2 != -1073741824 || c % 8 != 0)       { ret 9; }
    ret 0;
}

fun u64s(x: u64) i64 {
    if (x / 7 != 2623536934927580674 || x % 7 != 2)      { ret 11; }
    if (x / 10 != 1836475854449306472 || x % 10 != 0)    { ret 12; }
    if (x / 16 != 1147797409030816545 || x % 16 != 0)    { ret 13; }
    if (x / 1000003 != 18364703450382 || x % 1000003 != 713574) { ret 14; }
    ret 0;
}

fun s64(y: i64) i64 {
    if (y / 2 != -4611686018427387903 || y % 2 != -1)    { ret 21; }
    if (y / 7 != -1317624576693539401 || y % 7 != 0)     { ret 22; }
    if (y / -10 != 922337203685477580 || y % -10 != -7)  { ret 23; }
    if (y / 4096 != -2251799813685247 || y % 4096 != -4095) { ret 24; }
    ret 0;
}

fun narrow(a: i8, b: u8, c: i16, d: u16) i64 {
    if (a / 8 != -12 || a % 8 != -4)              { ret 31; }
    if (a / 7 != -14 || a % 7 != -2)              { ret 32; }
    if (b / 7 != 28 || b % 7 != 4 || b / 16 != 12) { ret 33; }
    if (c / 1000 != -30 || c % 1000 != 0)         { ret 34; }
    if (d / 10 != 6553 || d % 10 != 5)            { ret 35; }
    ret 0;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var r: i64 = s32(-1000001, 2147483647, -2147483648);
    if (r != 0) { ret r; }
    r = u64s(0xfedcba9876543210);
    if (r != 0) { ret r; }
    r = s64(-9223372036854775807);
    if (r != 0) { ret r; }
    ret narrow(-100, 200, -30000, 65535);
}
