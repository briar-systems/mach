use std.runtime;

# shifts at every width: `<<` fills zeros, `>>` is logical on unsigned and copies the sign on
# signed, and a run-time count at or past the width saturates (0, or the sign fill). x is
# 0x96 repeated, y the same bits signed. the counts are parameters of several integer types.

fun s8(x: u8, y: i8, k: u8, n: u64) i64 {
    if (x << k != 0xb0)  { ret 1; }
    if (x >> k != 0x12)  { ret 2; }
    if (y >> k != -14)   { ret 3; }
    if (y << k != -80)   { ret 4; }
    if (x >> (k + 4) != 1) { ret 5; }
    if (y >> (k + 4) != -1) { ret 6; }
    if (x << n != 0)     { ret 7; }
    if (x >> n != 0)     { ret 8; }
    if (y >> n != -1)    { ret 9; }
    if ((y & 0x7f) >> n != 0) { ret 10; }
    ret 0;
}

fun s16(x: u16, y: i16, k: i32, n: u8) i64 {
    if (x << k != 0xb4b0)  { ret 11; }
    if (x >> k != 0x12d2)  { ret 12; }
    if (y >> k != -3374)   { ret 13; }
    if (y << k != -19280)  { ret 14; }
    if (x >> (k + 12) != 1)  { ret 15; }
    if (y >> (k + 12) != -1) { ret 16; }
    if (x << n != 0)       { ret 17; }
    if (x >> n != 0)       { ret 18; }
    if (y >> n != -1)      { ret 19; }
    ret 0;
}

fun s32(x: u32, y: i32, k: u32, n: u32) i64 {
    if (x << k != 0xb4b4b4b0)  { ret 21; }
    if (x >> k != 0x12d2d2d2)  { ret 22; }
    if (y >> k != -221064494)  { ret 23; }
    if (y << k != -1263225680) { ret 24; }
    if (x >> (k + 28) != 1)    { ret 25; }
    if (y >> (k + 28) != -1)   { ret 26; }
    if (x << n != 0)           { ret 27; }
    if (x >> n != 0)           { ret 28; }
    if (y >> n != -1)          { ret 29; }
    ret 0;
}

fun s64(x: u64, y: i64, k: u64, n: u16) i64 {
    if (x << k != 0xb4b4b4b4b4b4b4b0)   { ret 31; }
    if (x >> k != 0x12d2d2d2d2d2d2d2)   { ret 32; }
    if (y >> k != -949464768499756334)  { ret 33; }
    if (y << k != -5425512962855750480) { ret 34; }
    if (x >> (k + 60) != 1)             { ret 35; }
    if (y >> (k + 60) != -1)            { ret 36; }
    if (x << n != 0)                    { ret 37; }
    if (x >> n != 0)                    { ret 38; }
    if (y >> n != -1)                   { ret 39; }
    if (x << (n - 33) != 0x9696969600000000) { ret 40; }
    ret 0;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var r: i64 = s8(0x96, -106, 3, 8);
    if (r != 0) { ret r; }
    r = s16(0x9696, -26986, 3, 200);
    if (r != 0) { ret r; }
    r = s32(0x96969696, -1768515946, 3, 32);
    if (r != 0) { ret r; }
    ret s64(0x9696969696969696, -7595718147998050666, 3, 65);
}
