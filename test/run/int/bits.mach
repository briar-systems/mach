use std.runtime;

# `&`, `|` and `^` at every width, on operands whose top bits are set, so a lowering that
# works in a wider register and extends the wrong way leaks into the result.

fun b8(a: u8, b: u8, s: i8) i64 {
    if ((a & b) != 0x84)   { ret 1; }
    if ((a | b) != 0xf6)   { ret 2; }
    if ((a ^ b) != 0x72)   { ret 3; }
    if ((s & 0x0f) != 6)   { ret 4; }
    if ((s | 1) != -105)   { ret 5; }
    if ((s ^ -1) != 105)   { ret 6; }
    ret 0;
}

fun b16(a: u16, b: u16) i64 {
    if ((a & b) != 0x8484) { ret 11; }
    if ((a | b) != 0xf6f6) { ret 12; }
    if ((a ^ b) != 0x7272) { ret 13; }
    ret 0;
}

fun b32(a: u32, b: u32) i64 {
    if ((a & b) != 0x84848484) { ret 21; }
    if ((a | b) != 0xf6f6f6f6) { ret 22; }
    if ((a ^ b) != 0x72727272) { ret 23; }
    ret 0;
}

fun b64(a: u64, b: u64, s: i64) i64 {
    if ((a & b) != 0x8484848484848484) { ret 31; }
    if ((a | b) != 0xf6f6f6f6f6f6f6f6) { ret 32; }
    if ((a ^ b) != 0x7272727272727272) { ret 33; }
    if ((s & 0xff) != 0x96)            { ret 34; }
    if ((s ^ s) != 0)                  { ret 35; }
    ret 0;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var r: i64 = b8(0x96, 0xe4, -106);
    if (r != 0) { ret r; }
    r = b16(0x9696, 0xe4e4);
    if (r != 0) { ret r; }
    r = b32(0x96969696, 0xe4e4e4e4);
    if (r != 0) { ret r; }
    ret b64(0x9696969696969696, 0xe4e4e4e4e4e4e4e4, -7595718147998050666);
}
