use std.runtime;

# the six comparisons relate mathematical values: unsigned operands with the top bit set
# order above small ones, signed negatives below every unsigned value, and a mix of widths
# and signedness compares the true values in either operand order.

fun unsigned(a: u32, b: u32, c: u8, d: u8) i64 {
    if (!(a > b))  { ret 1; }
    if (!(b < a))  { ret 2; }
    if (!(a >= a)) { ret 3; }
    if (!(b <= a)) { ret 4; }
    if (a == b)    { ret 5; }
    if (!(a != b)) { ret 6; }
    if (!(c > d))  { ret 7; }
    if (c <= d)    { ret 8; }
    ret 0;
}

fun signed(a: i32, b: i32, c: i8, d: i8, e: i64) i64 {
    if (!(a < b))  { ret 11; }
    if (a >= b)    { ret 12; }
    if (!(b > a))  { ret 13; }
    if (!(c < d))  { ret 14; }
    if (!(c <= c)) { ret 15; }
    if (!(e < 0))  { ret 16; }
    ret 0;
}

fun mixed(m1: i64, max: u64, n8: i8, f8: u8, n32: i32, s16: u16, big: u64, s8: i8) i64 {
    if (!(m1 < max))  { ret 21; }
    if (m1 == max)    { ret 22; }
    if (!(max > m1))  { ret 23; }
    if (!(n8 < f8))   { ret 24; }
    if (n8 == f8)     { ret 25; }
    if (!(n32 < s16)) { ret 26; }
    if (!(big > s8))  { ret 27; }
    if (!(s8 < big))  { ret 28; }
    if (!(s16 > n8))  { ret 29; }
    if (!(f8 == s16 - 3)) { ret 30; }
    ret 0;
}

fun truth(a: i64, b: i64) i64 {
    val lt: u1 = a < b;
    val gt: u1 = a > b;
    if (lt != 1 || gt != 0)        { ret 31; }
    if ((lt & gt) != 0)            { ret 32; }
    if ((lt | gt) != 1)            { ret 33; }
    if ((lt ^ 1) != gt)            { ret 34; }
    if (lt::u64 + gt::u64 != 1)    { ret 35; }
    ret 0;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var r: i64 = unsigned(0x80000000, 1, 200, 100);
    if (r != 0) { ret r; }
    r = signed(-2147483648, 1, -128, 127, -1);
    if (r != 0) { ret r; }
    r = mixed(-1, 0xffffffffffffffff, -1, 255, -5, 258, 0x8000000000000000, 100);
    if (r != 0) { ret r; }
    ret truth(-3, 3);
}
