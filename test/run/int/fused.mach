use std.runtime;
use std.types.bool.bool;

# shapes a target writes shorter once registers are allocated, or folds into one instruction, each
# with operands where the shorter form would go wrong if it read a flag the longer one sets apart.
# a compare with zero (`corpus_fused_sign`), the test after an and, an add or a subtract, kept
# where the branch reads the carry or the overflow a subtract leaves unlike the test
# (`below_after`), a copy and an add, an element `i + 1` whose offset enters the displacement
# (`corpus_fused_index`), a sign extended load (`corpus_fused_extend`), a float zero, a byte
# converted to a float (`corpus_fused_convert`), a product by 9 (`corpus_fused_times`), by 5 at 32
# bits and by 12, which stays one imul (`corpus_fused_twelve`), and the address and store of a field of element `i + 1` (`corpus_fused_field`,
# `corpus_fused_mark`). the dump rules of linux-x86_64-optimized hold the named functions to their
# short forms.

#[symbol("corpus_fused_sign")]
fun sign(a: i64) i64 {
    if (a < 0) { ret -1; }
    ret 1;
}

# the wrapped difference of the least i64 and one is the greatest, which is not below zero, though
# the subtract's own flags say less: the test after it stays
fun below_after(a: i64) bool {
    val d: i64 = a - 1;
    ret d < 0;
}

fun masked(a: u64) u64 {
    val m: u64 = a & 12;
    if (m != 0) { ret m; }
    ret 99;
}

fun both(a: i64, b: i64) i64 {
    val s: i64 = a + 40;
    ret s * a + b;
}

#[symbol("corpus_fused_index")]
fun shift_up(p: *i32, n: i64) {
    var i: i64 = n - 2;
    for (i >= 0) {
        p[i + 1] = p[i];
        i        = i - 1;
    }
}

#[symbol("corpus_fused_extend")]
fun widened(p: *i32, i: i64) i64 {
    ret p[i]::i64 * 3;
}

fun zeros(p: *f64, n: i64) {
    var i: i64 = 0;
    for (i < n) {
        p[i] = 0.0;
        i    = i + 1;
    }
}

rec Pair {
    a: i32;
    b: i32;
}

#[inline("never")]
#[symbol("corpus_fused_convert")]
fun convert(p: *u8, i: i64) f32 {
    ret p[i]::f32;
}

#[inline("never")]
#[symbol("corpus_fused_times")]
fun times(a: i64) i64 {
    ret a * 9;
}

#[inline("never")]
#[symbol("corpus_fused_twelve")]
fun twelve(a: i64) i64 {
    ret a * 12;
}

fun fivefold(a: i32) i32 {
    ret a * 5;
}

#[inline("never")]
#[symbol("corpus_fused_field")]
fun field(p: *Pair, i: i64) *i32 {
    ret ?p[i + 1].b;
}

#[inline("never")]
#[symbol("corpus_fused_mark")]
fun mark(p: *Pair, i: i64) {
    p[i + 1].b = 7;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val one: i64 = argc;
    val min: i64 = -9223372036854775807 - 1;
    if (sign(-one) != -1 || sign(0) != 1 || sign(min) != -1)                  { ret 1; }
    if (below_after(min) || !below_after(0) || below_after(one))              { ret 2; }
    if (masked(4 * one::u64) != 4 || masked(3) != 99 || masked(0xffff) != 12) { ret 3; }
    if (both(one, 2) != 43 || both(-40, 5) != 5)                              { ret 4; }
    var a: [5]i32 = [5]i32{1, 2, 3, 4, -5};
    shift_up(?a[0], 5);
    if (a[0] != 1 || a[1] != 1 || a[2] != 2 || a[4] != 4) { ret 5; }
    a[3] = -2147483647 - 1;
    if (widened(?a[0], 3) != -6442450944 || widened(?a[0], one) != 3) { ret 6; }
    var f: [3]f64 = [3]f64{1.5, -2.0, 3.0};
    zeros(?f[0], 3 * one);
    if (f[0] != 0.0 || f[2] != 0.0) { ret 7; }
    var bytes: [4]u8 = [4]u8{0, 1, 255, 128};
    if (convert(?bytes[0], 0) != 0.0 || convert(?bytes[0], one) != 1.0 || convert(?bytes[0], 2 * one) != 255.0 || convert(?bytes[0], 3) != 128.0) { ret 8; }
    if (times(one) != 9 || times(-3) != -27 || times(min) != min)                                                                                 { ret 9; }
    if (twelve(one) != 12 || twelve(-3) != -36 || twelve(min) != 0)                                                                               { ret 13; }
    if (fivefold(one::i32) != 5 || fivefold(-7) != -35 || fivefold(429496730) != -2147483646)                                                     { ret 10; }
    var ps: [3]Pair;
    if (field(?ps[0], one) != ?ps[2].b) { ret 11; }
    mark(?ps[0], one);
    if (ps[2].b != 7 || ps[1].b != 0 || ps[2].a != 0) { ret 12; }
    ret 0;
}
