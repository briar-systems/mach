use std.runtime;

# an `and`, `or` or `xor` with a constant that changes no bit any reader reads becomes its
# other operand: each function below masks a value and then reads part of it, through a
# truncation, a shift, a carry or a loop. where the mask changes a bit that is read, as the
# carry of an add, the sign an arithmetic shift brings in, or the low bits an `or` sets, it must
# stay, and every result holds only if each mask the pass takes away changed nothing read.

#[inline("never")]
fun low_byte(x: u64) u8 {
    ret (x & 0xffff)::u8;
}

#[inline("never")]
fun or_high(x: u32) u8 {
    ret (x | 0xff00)::u8;
}

#[inline("never")]
fun or_low(x: u32) u8 {
    ret (x | 0x0f)::u8;
}

#[inline("never")]
fun xor_out(x: u64) u64 {
    ret (x ^ 0xf0) >> 8;
}

#[inline("never")]
fun xor_in(x: u64) u64 {
    ret (x ^ 0xf00) >> 8;
}

#[inline("never")]
fun carry(x: u64) u64 {
    ret ((x & 0xff) + 1) & 0x1ff;
}

#[inline("never")]
fun wrap(x: u64) u64 {
    ret ((x & 0xff) + 1) & 0xff;
}

#[inline("never")]
fun up(x: u64) u64 {
    ret (x & 0xffffffff) << 32;
}

#[inline("never")]
fun down(x: u64) u64 {
    ret (x & 0xffffffff00000000) >> 32;
}

#[inline("never")]
fun sign(x: i64) i64 {
    ret (x & 0x7fffffffffffffff) >> 62;
}

#[inline("never")]
fun looped(x: u64, n: u64) u8 {
    var v: u64 = x | 0xff00;
    var i: u64 = 0;
    for (i < n) {
        v = v + 0x100;
        i = i + 1;
    }
    ret v::u8;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val n: u64 = argc::u64;
    val x: u64 = n * 0x0123456789abcdef;
    if (low_byte(x) != (x & 0xff)::u8)                  { ret 1; }
    if (or_high(0x12345678) != 0x78)                    { ret 2; }
    if (or_low(0x12345670) != 0x7f)                     { ret 3; }
    if (or_low(0xffffffff) != 0xff)                     { ret 4; }
    if (xor_out(x) != x >> 8)                           { ret 5; }
    if (xor_in(0xabcd) != 0xa4)                         { ret 6; }
    if (carry(0x1ff) != 0x100)                          { ret 7; }
    if (carry(n + 0xfe) != (n + 0xfe) % 0x100 + 1)     { ret 8; }
    if (wrap(0x2ff) != 0)                               { ret 9; }
    if (up(0xffffffff00000001) != 0x100000000)          { ret 10; }
    if (down(0x00000001ffffffff) != 1)                  { ret 11; }
    if (sign(-1) != 1)                                  { ret 12; }
    if (sign(-9223372036854775807 - 1) != 0)            { ret 13; }
    if (looped(0x1234, n + 2) != 0x34)                  { ret 14; }
    if (looped(x, 0) != (x & 0xff)::u8)                 { ret 15; }
    ret 0;
}
