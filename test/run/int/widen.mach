use std.runtime;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;

# comparisons widened to every integer width, and chains of narrow arithmetic on a target whose
# arithmetic runs wider. a comparison's result is 0 or 1 in its whole register, so its zero
# extensions are the value itself (the dump rules of linux-x86_64, linux-aarch64 and linux-riscv64
# hold `corpus_widen_compare` to the compare and return alone), and each narrow operation that reads
# only the low bits of its operands reads the wide result of the one before, truncated once at
# the end. operands come through calls at the edges of each width, so no fold decides them.

fun lt(a: i64, b: i64) bool { ret a < b; }
#[symbol("corpus_widen_compare")]
fun wide(a: i64, b: i64) u64 { ret (a < b)::u64; }
fun below(a: u64, b: u64) u16 { ret (a < b)::u16; }
fun same(a: i32, b: i32) i32 { ret (a == b)::i32 + 1; }
fun unordered(a: f64, b: f64) u32 { ret (a != b)::u32 * 3; }
fun chosen(a: u8, b: u8, take: bool) u64 {
    var c: bool = a > b;
    if (take) { c = a == b; }
    ret c::u64;
}
fun chain8(a: u8, b: u8, c: u8) u8 { ret ((a + b) * c ^ a) << 1; }
fun chain_s8(a: i8, b: i8) i8 { ret -((a - b) * b) ^ ~a; }
fun chain16(a: u16, b: u16) u16 { ret (((a * b) + a) << 3) >> 2; }
fun bits8(a: u8, b: u8) u8 { ret ((a & b) | (a ^ 0x5a)) + b; }

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val one: i64 = argc;
    val min: i64 = -9223372036854775807 - 1;
    if (!lt(min, 0) || lt(0, min) || lt(one, one)) { ret 1; }
    if (wide(min, 9223372036854775807) != 1 || wide(9223372036854775807, min) != 0 || wide(-one, 0) != 1) { ret 2; }
    if (below(0, 0xffffffffffffffff) != 1 || below(0xffffffffffffffff, 0) != 0 || below(one::u64, one::u64) != 0) { ret 3; }
    if (same(-2147483647 - 1, -2147483647 - 1) != 2 || same(-1, 0x7fffffff) != 1 || same(one::i32, 1) != 2) { ret 4; }
    val nan: f64 = 0.0 / (one - 1)::f64;
    if (unordered(nan, nan) != 3 || unordered(1.0, one::f64) != 0 || unordered(-0.0, 0.0) != 0) { ret 5; }
    if (chosen(255, 0, false) != 1 || chosen(0, 255, false) != 0 || chosen(7, 7, true) != 1 || chosen(7, 8, true) != 0) { ret 6; }
    # (255 + 2) * 3 = 771 is 3 at 8 bits, 3 ^ 255 = 252, 252 << 1 = 504 is 248
    if (chain8(255, 2 * one::u8, 3) != 248 || chain8(128, 128, 255) != 0 || chain8(0, 0, 0) != 0) { ret 7; }
    # -128 - 1 wraps to 127, -(127 * 1) ^ ~(-128) = -127 ^ 127 = -2; 127 - -128 wraps to -1, -(-1 * -128) wraps to -128, ^ ~127 gives 0
    if (chain_s8(-128, one::i8) != -2 || chain_s8(127, -128) != 0 || chain_s8(0, 0) != -1) { ret 8; }
    # 65535 * 65535 + 65535 = 0 at 16 bits; 300 * 300 + 300 is 24764, << 3 is 1504, >> 2 is 376
    if (chain16(65535, 65535) != 0 || chain16(300, 300 * one::u16) != 376 || chain16(1, 1) != 4) { ret 9; }
    # (255 & 1) | (255 ^ 0x5a) = 1 | 0xa5 = 0xa5, + 1 = 0xa6; (0 & 255) | 0x5a = 0x5a, + 255 = 0x159 is 0x59
    if (bits8(255, one::u8) != 0xa6 || bits8(0, 255) != 0x59) { ret 10; }
    ret 0;
}
