use std.runtime;

# the most negative literal a 256 or 512-bit integer takes, -2^127, is that value at the
# full width: negative, with its sign filled through every word above the low 128 bits.

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val a: i256 = -170141183460469231731687303715884105728;
    if (a >= 0)           { ret 1; }
    if ((a >> 200) != -1) { ret 2; }
    val b: i512 = -170141183460469231731687303715884105728;
    if (b >= 0)           { ret 3; }
    if ((b >> 400) != -1) { ret 4; }
    val m: i128 = -170141183460469231731687303715884105728;
    if (a != m::i256)     { ret 5; }
    if (b != m::i512)     { ret 6; }
    ret 0;
}
