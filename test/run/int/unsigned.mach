use std.runtime;

# every unsigned width through the five operators and `~`, with operands that wrap at the
# width: a lowering that computes in a wider register and forgets to cut the result fails.
# the operands arrive as parameters so no check folds at compile time.

fun u8s(a: u8, c: u8) i64 {
    if (a + a != 144) { ret 1; }
    if (a - c != 193) { ret 2; }
    if (c - a != 63)  { ret 3; }
    if (a * c != 120) { ret 4; }
    if (a / c != 28)  { ret 5; }
    if (a % c != 4)   { ret 6; }
    if (~a != 55)     { ret 7; }
    ret 0;
}

fun u16s(a: u16, c: u16) i64 {
    if (a + a != 54464) { ret 11; }
    if (a - c != 59993) { ret 12; }
    if (c - a != 5543)  { ret 13; }
    if (a * c != 26784) { ret 14; }
    if (a / c != 8571)  { ret 15; }
    if (a % c != 3)     { ret 16; }
    if (~a != 5535)     { ret 17; }
    ret 0;
}

fun u32s(a: u32, c: u32) i64 {
    if (a + a != 3705032704) { ret 21; }
    if (a - c != 3999999993) { ret 22; }
    if (c - a != 294967303)  { ret 23; }
    if (a * c != 2230196224) { ret 24; }
    if (a / c != 571428571)  { ret 25; }
    if (a % c != 3)          { ret 26; }
    if (~a != 294967295)     { ret 27; }
    ret 0;
}

fun u64s(a: u64, c: u64) i64 {
    if (a + a != 17553255926290448384) { ret 31; }
    if (a - c != 17999999999999999993) { ret 32; }
    if (c - a != 446744073709551623)   { ret 33; }
    if (a * c != 15319535557742690304) { ret 34; }
    if (a / c != 2571428571428571428)  { ret 35; }
    if (a % c != 4)                    { ret 36; }
    if (~a != 446744073709551615)      { ret 37; }
    ret 0;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var r: i64 = u8s(200, 7);
    if (r != 0) { ret r; }
    r = u16s(60000, 7);
    if (r != 0) { ret r; }
    r = u32s(4000000000, 7);
    if (r != 0) { ret r; }
    ret u64s(18000000000000000000, 7);
}
