# reports: algebraic canonical.canonical.byte_float; algebraic canonical.canonical.wrap; algebraic canonical.canonical.scale; algebraic canonical.canonical.left
use std.runtime;

# the canonical forms the optimiser gives before selection, each checked at the inputs that tell a wrong form apart:
# an unsigned conversion to float of a value under 2^63 taken as the signed one, a signed remainder and quotient of
# an index its loop bounds taken as unsigned, products by powers of two taken as shifts, and compares written with
# their constant first exchanged, a float one on a nan among them. a signed remainder whose dividend may be negative
# keeps its sign.

fun byte_float(x: u64) f32 {
    ret (x & 0xff)::f32;
}

fun wrap(n: i64) i64 {
    var sum: i64 = 0;
    var i:   i64 = 0;
    for (i < 65536) {
        sum = sum + (i + 1) % 65536 + (i + 1) / 1024 + (i + 1) % 7;
        i   = i + 1;
    }
    ret sum + n;
}

fun signed_rem(x: i64) i64 {
    ret x % 8 + x / 4;
}

fun scale(x: i64, y: u32) i64 {
    ret x * 8 + 16 * x + (y * 0x80000000)::i64;
}

fun left(x: i64, y: u32, f: f64) i64 {
    var r: i64 = 0;
    if (0 < x)    { r = r + 1; }
    if (5 >= y)   { r = r + 2; }
    if (0.0 < f)  { r = r + 4; }
    if (1.0 >= f) { r = r + 8; }
    ret r;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val one: i64 = argc;
    val all: u64 = 0::u64 - one::u64;
    if (byte_float(all) != 255.0)                       { ret 1; }
    if (byte_float(0x80 * one::u64) != 128.0)            { ret 2; }
    if (wrap(one) != 2149711934)                         { ret 3; }
    if (signed_rem(0 - 13 * one) != 0 - 8)               { ret 4; }
    if (signed_rem(13 * one) != 8)                       { ret 5; }
    if (scale(0 - 3 * one, one::u32) != 0 - 72 + 2147483648) { ret 6; }
    if (scale(one, 3 * one::u32) != 24 + 2147483648)     { ret 7; }
    val zero: f64 = (one - 1)::f64;
    val nan:  f64 = zero / zero;
    if (left(one, 5 * one::u32, 0.5) != 15)              { ret 8; }
    if (left(0 - one, 6 * one::u32, 2.0) != 4)           { ret 9; }
    if (left(0, 0, nan) != 2)                            { ret 10; }
    ret 0;
}
