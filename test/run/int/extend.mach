use std.runtime;
use std.types.size.usize;

# `::` to a wider integer extends by the source's signedness: a signed source sign-extends
# into every wider type, signed or not, and an unsigned one zero-extends. each source holds
# its top bit set, so an extension of the wrong kind changes the value.

fun from8(a: i8, x: u8) i64 {
    if (a::i16 != -106)               { ret 1; }
    if (a::i32 != -106)               { ret 2; }
    if (a::i64 != -106)               { ret 3; }
    if (a::u16 != 0xff96)             { ret 4; }
    if (a::u32 != 0xffffff96)         { ret 5; }
    if (a::u64 != 0xffffffffffffff96) { ret 6; }
    if (x::u16 != 0x96)               { ret 7; }
    if (x::i32 != 150)                { ret 8; }
    if (x::u64 != 150)                { ret 9; }
    if (x::i64 != 150)                { ret 10; }
    ret 0;
}

fun from16(a: i16, x: u16) i64 {
    if (a::i32 != -30000)             { ret 11; }
    if (a::i64 != -30000)             { ret 12; }
    if (a::u32 != 0xffff8ad0)         { ret 13; }
    if (a::u64 != 0xffffffffffff8ad0) { ret 14; }
    if (x::u32 != 0x8ad0)             { ret 15; }
    if (x::i64 != 35536)              { ret 16; }
    ret 0;
}

fun from32(a: i32, x: u32) i64 {
    if (a::i64 != -2000000000)        { ret 21; }
    if (a::u64 != 0xffffffff88ca6c00) { ret 22; }
    if (x::u64 != 0x88ca6c00)         { ret 23; }
    if (x::i64 != 2294967296)         { ret 24; }
    ret 0;
}

# same width: the bits are kept, so the value is read again in the other signedness
fun same(a: i32, x: u32, b: i64) i64 {
    if (a::u32 != 4294967284)         { ret 31; }
    if (x::i32 != -12)                { ret 32; }
    if (b::u64 != 0xfffffffffffffffe) { ret 33; }
    if ((b::u64)::i64 != -2)          { ret 34; }
    ret 0;
}

# a cast that moves a register unchanged, where both the source and the result stay live and
# the source changes after, so a move that a copy stands for keeps the two values apart
fun kept(a: i32, p: *u8, f: u8) i64 {
    var x: i32   = a;
    var w: i64   = 0;
    var q: usize = 0;
    var t: u64   = 0;
    var i: i64   = 0;
    for (i < 3) {
        w = x::i64;
        q = p::usize;
        t = f::u64;
        x = x + 1;
        p = (q + 1)::*u8;
        f = f ^ 1;
        i = i + 1;
    }
    if (w != -2000000000 + 2) { ret 41; }
    if (x != -2000000000 + 3) { ret 42; }
    if (q + 1 != p::usize)    { ret 43; }
    if (t != 1)               { ret 44; }
    if (f != 0)               { ret 45; }
    ret 0;
}

# the zero extension of a loaded value, which the load leaves zero extended in its register so
# the extension may take it as it stands: each width read back through memory with its top bit set
fun loaded(p: *u8, q: *u16, w: *u32) i64 {
    if (p[0]::u64 != 0x96)        { ret 51; }
    if (p[0]::u32 != 0x96)        { ret 52; }
    if (q[0]::u64 != 0x8ad0)      { ret 53; }
    if (w[0]::u64 != 0x88ca6c00)  { ret 54; }
    if ((p[0]::u16)::u64 != 0x96) { ret 55; }
    ret 0;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var r: i64 = from8(-106, 0x96);
    if (r != 0) { ret r; }
    r = from16(-30000, 0x8ad0);
    if (r != 0) { ret r; }
    r = from32(-2000000000, 0x88ca6c00);
    if (r != 0) { ret r; }
    r = same(-12, 0xfffffff4, -2);
    if (r != 0) { ret r; }
    var b: u8  = 0x96;
    var h: u16 = 0x8ad0;
    var d: u32 = 0x88ca6c00;
    r = loaded(?b, ?h, ?d);
    if (r != 0) { ret r; }
    ret kept(-2000000000, nil, 1);
}
