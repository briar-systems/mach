use std.runtime;

# `::` to a wider integer extends by the source's signedness: a signed source sign-extends
# into every wider type, signed or not, and an unsigned one zero-extends. each source holds
# its top bit set, so an extension of the wrong kind changes the value.

fun from8(a: i8, x: u8) i64 {
    if (a::i16 != -106)                  { ret 1; }
    if (a::i32 != -106)                  { ret 2; }
    if (a::i64 != -106)                  { ret 3; }
    if (a::u16 != 0xff96)                { ret 4; }
    if (a::u32 != 0xffffff96)            { ret 5; }
    if (a::u64 != 0xffffffffffffff96)    { ret 6; }
    if (x::u16 != 0x96)                  { ret 7; }
    if (x::i32 != 150)                   { ret 8; }
    if (x::u64 != 150)                   { ret 9; }
    if (x::i64 != 150)                   { ret 10; }
    ret 0;
}

fun from16(a: i16, x: u16) i64 {
    if (a::i32 != -30000)                { ret 11; }
    if (a::i64 != -30000)                { ret 12; }
    if (a::u32 != 0xffff8ad0)            { ret 13; }
    if (a::u64 != 0xffffffffffff8ad0)    { ret 14; }
    if (x::u32 != 0x8ad0)                { ret 15; }
    if (x::i64 != 35536)                 { ret 16; }
    ret 0;
}

fun from32(a: i32, x: u32) i64 {
    if (a::i64 != -2000000000)           { ret 21; }
    if (a::u64 != 0xffffffff88ca6c00)    { ret 22; }
    if (x::u64 != 0x88ca6c00)            { ret 23; }
    if (x::i64 != 2294967296)            { ret 24; }
    ret 0;
}

# same width: the bits are kept, so the value is read again in the other signedness
fun same(a: i32, x: u32, b: i64) i64 {
    if (a::u32 != 4294967284)            { ret 31; }
    if (x::i32 != -12)                   { ret 32; }
    if (b::u64 != 0xfffffffffffffffe)    { ret 33; }
    if ((b::u64)::i64 != -2)             { ret 34; }
    ret 0;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var r: i64 = from8(-106, 0x96);
    if (r != 0) { ret r; }
    r = from16(-30000, 0x8ad0);
    if (r != 0) { ret r; }
    r = from32(-2000000000, 0x88ca6c00);
    if (r != 0) { ret r; }
    ret same(-12, 0xfffffff4, -2);
}
