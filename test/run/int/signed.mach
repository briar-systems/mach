use std.runtime;

# every signed width through the operators, unary `-` and `~`, with operands that wrap at
# the width (integer arithmetic is two's complement and wraps) and division that truncates
# toward zero, the remainder taking the dividend's sign.

fun i8s(a: i8, c: i8) i64 {
    if (a + a != 56)   { ret 1; }
    if (a - c != -107) { ret 2; }
    if (c - a != 107)  { ret 3; }
    if (a * c != 68)   { ret 4; }
    if (a / c != -14)  { ret 5; }
    if (a % c != -2)   { ret 6; }
    if (-a != 100)     { ret 7; }
    if (~a != 99)      { ret 8; }
    if (a / -c != 14)  { ret 9; }
    if (a % -c != -2)  { ret 10; }
    ret 0;
}

fun i16s(a: i16, c: i16) i64 {
    if (a + a != 5536)    { ret 11; }
    if (a - c != -30007)  { ret 12; }
    if (c - a != 30007)   { ret 13; }
    if (a * c != -13392)  { ret 14; }
    if (a / c != -4285)   { ret 15; }
    if (a % c != -5)      { ret 16; }
    if (-a != 30000)      { ret 17; }
    if (~a != 29999)      { ret 18; }
    if (a / -c != 4285)   { ret 19; }
    if (a % -c != -5)     { ret 20; }
    ret 0;
}

fun i32s(a: i32, c: i32) i64 {
    if (a + a != 294967296)    { ret 21; }
    if (a - c != -2000000007)  { ret 22; }
    if (c - a != 2000000007)   { ret 23; }
    if (a * c != -1115098112)  { ret 24; }
    if (a / c != -285714285)   { ret 25; }
    if (a % c != -5)           { ret 26; }
    if (-a != 2000000000)      { ret 27; }
    if (~a != 1999999999)      { ret 28; }
    if (a / -c != 285714285)   { ret 29; }
    if (a % -c != -5)          { ret 30; }
    ret 0;
}

fun i64s(a: i64, c: i64) i64 {
    if (a + a != 446744073709551616)    { ret 31; }
    if (a - c != -9000000000000000007)  { ret 32; }
    if (c - a != 9000000000000000007)   { ret 33; }
    if (a * c != -7659767778871345152)  { ret 34; }
    if (a / c != -1285714285714285714)  { ret 35; }
    if (a % c != -2)                    { ret 36; }
    if (-a != 9000000000000000000)      { ret 37; }
    if (~a != 8999999999999999999)      { ret 38; }
    if (a / -c != 1285714285714285714)  { ret 39; }
    if (a % -c != -2)                   { ret 40; }
    ret 0;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var r: i64 = i8s(-100, 7);
    if (r != 0) { ret r; }
    r = i16s(-30000, 7);
    if (r != 0) { ret r; }
    r = i32s(-2000000000, 7);
    if (r != 0) { ret r; }
    ret i64s(-9000000000000000000, 7);
}
