use std.runtime;

# 256 and 512-bit integers, legalized over the target's registers: a carry through every
# lane, the widening multiply into 512 bits, and sign fill across lanes. the operands derive
# from argc (1) so nothing folds.

fun add(a: u256, b: u256) u256 {
    ret a + b;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val one: u256 = argc::u256;
    val top: u256 = one << 255;
    val s: u256 = add(top, top - one);
    if ((s >> 255)::u64 != 1) { ret 1; }
    val p: u512 = (s::u512) * (s::u512);
    if ((p >> 510)::u64 != 3) { ret 2; }
    val m: i256 = -(one::i256);
    if ((m >> 200)::i64 != -1) { ret 3; }
    if ((m::u256 >> 250)::u64 != 63) { ret 4; }
    ret 0;
}
