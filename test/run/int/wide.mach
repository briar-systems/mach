use std.runtime;

# 128-bit integers, realized as two 64-bit lanes: carries and borrows cross the lanes, shifts
# move bits between them, a comparison decides on the high lane, division calls the
# compiler's helpers, and the widening multiply of two 64-bit values is the full product.

fun unsigned(a: u128, b: u128, n: u32) i64 {
    if (a + b != 0xfedcba98765432110123456789abcdf2) { ret 1; }
    if (a - b != 0xfedcba987654320f0123456789abcdec) { ret 2; }
    if (b - a != 0x0123456789abcdf0fedcba9876543214) { ret 3; }
    if (a * b != 0xfdb97530eca8641f0369d0369d0369cd) { ret 4; }
    if (a / b != 0xfedcba987654320d)                 { ret 5; }
    if (a % b != 0x048d159e26af37c8)                 { ret 6; }
    if (a >> 70 != 0x03fb72ea61d950c8)               { ret 7; }
    if (a << 70 != 0x48d159e26af37bc00000000000000000) { ret 8; }
    if ((a >> 64)::u64 != 0xfedcba9876543210)        { ret 9; }
    if (a::u64 != 0x0123456789abcdef)                { ret 10; }
    if (a >> n != 0)                                 { ret 11; }
    if (!(a > b) || b >= a)                          { ret 12; }
    # equal high lanes: the low lane decides
    if (!(a - 1 < a))                                { ret 13; }
    ret 0;
}

fun signed(a: i128, n: u32) i64 {
    if (a >> 70 != -1281023894007608)                       { ret 21; }
    if (a / 7 != -216052296457738706761765052811876720)     { ret 22; }
    if (a % 7 != -1)                                        { ret 23; }
    if (a >> n != -1)                                       { ret 24; }
    if (!(a < 0))                                           { ret 25; }
    if (a::i64 != 0x0123456789abcdef)                       { ret 26; }
    ret 0;
}

fun widening(x: u64, y: i64, z: i64) i64 {
    val full: u128 = (x::u128) * (x::u128);
    if ((full >> 64)::u64 != 0xfffffffffffffffe)       { ret 31; }
    if (full::u64 != 1)                                { ret 32; }
    val s: i128 = (y::i128) * (z::i128);
    if (s != -27670116110564327421)                    { ret 33; }
    if (x::u128 + 1 != 0x10000000000000000)            { ret 34; }
    if (y::i128 != -3)                                 { ret 35; }
    if (y::u128 != 0xfffffffffffffffffffffffffffffffd) { ret 36; }
    ret 0;
}

fun check() i64 {
    var r: i64 = unsigned(0xfedcba98765432100123456789abcdef, 0x10000000000000003, 128);
    if (r != 0) { ret r; }
    r = signed(-1512366075204170947332355369683137041, 200);
    if (r != 0) { ret r; }
    ret widening(0xffffffffffffffff, -3, 0x7fffffffffffffff);
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    ret check();
}
