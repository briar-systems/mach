use std.runtime;

# `::` to a narrower integer keeps the low bits and reads them in the destination's
# signedness. `::u1` is not a narrowing: it asks whether the value is non-zero.

fun cut(v: u64, n: i64, h: u16) i64 {
    if (v::u32 != 0x9abcdef0)  { ret 1; }
    if (v::u16 != 0xdef0)      { ret 2; }
    if (v::u8 != 0xf0)         { ret 3; }
    if (v::i8 != -16)          { ret 4; }
    if (v::i16 != -8464)       { ret 5; }
    if (v::i32 != -1698898192) { ret 6; }
    if (n::u8 != 254)          { ret 7; }
    if (n::i8 != -2)           { ret 8; }
    if (n::u32 != 4294967294)  { ret 9; }
    if ((v::u32)::u16 != 0xdef0) { ret 10; }
    if (h::u1 != 1)            { ret 11; }
    if (h::u8 != 0)            { ret 12; }
    if ((h - 256)::u1 != 0)    { ret 13; }
    val t: u1 = h::u1;
    if (t::u64 != 1)           { ret 14; }
    ret 0;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    ret cut(0x123456789abcdef0, -2, 256);
}
