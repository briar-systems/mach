use std.runtime;

# multiply, divide and remainder of 8 and 16-bit integers, signed and unsigned, at the edges of
# each width: products that wrap, quotients and remainders truncated toward zero with the
# remainder taking the dividend's sign, and the most negative dividend. operands come through
# calls, so no fold decides them, and a target that has no instruction at the narrow width
# computes each at a wider one and keeps the low bits (linux-x86_64's dump rule)

fun mul8(a: i8, b: i8) i8 { ret a * b; }
fun mulu8(a: u8, b: u8) u8 { ret a * b; }
fun mul16(a: i16, b: i16) i16 { ret a * b; }
fun mulu16(a: u16, b: u16) u16 { ret a * b; }
fun div8(a: i8, b: i8) i8 { ret a / b; }
fun rem8(a: i8, b: i8) i8 { ret a % b; }
fun divu8(a: u8, b: u8) u8 { ret a / b; }
fun remu8(a: u8, b: u8) u8 { ret a % b; }
fun div16(a: i16, b: i16) i16 { ret a / b; }
fun rem16(a: i16, b: i16) i16 { ret a % b; }
fun divu16(a: u16, b: u16) u16 { ret a / b; }
fun remu16(a: u16, b: u16) u16 { ret a % b; }

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val one: i8 = argc::i8;
    # 16 * 8 = 128 wraps to -128, -128 * -1 wraps to -128, 127 * 127 = 16129 keeps 1
    if (mul8(16, 8 * one) != -128 || mul8(-128, -one) != -128 || mul8(127, 127) != 1) { ret 1; }
    if (mulu8(16, 16) != 0 || mulu8(255, 255) != 1 || mulu8(15, 17) != 255) { ret 2; }
    if (mul16(256, 128) != -32768 || mul16(-32768, -1) != -32768 || mul16(181, 181) != 32761) { ret 3; }
    if (mulu16(65535, 65535) != 1 || mulu16(256, 256) != 0 || mulu16(255, 257) != 65535) { ret 4; }
    if (div8(-128, one) != -128 || div8(-128, 2) != -64 || div8(127, -1) != -127 || div8(-7, 2) != -3) { ret 5; }
    if (rem8(-7, 2) != -1 || rem8(7, -2) != 1 || rem8(-128, 3) != -2 || rem8(-128, 127) != -1) { ret 6; }
    if (divu8(255, one::u8) != 255 || divu8(255, 2) != 127 || divu8(128, 255) != 0) { ret 7; }
    if (remu8(255, 2) != 1 || remu8(200, 255) != 200 || remu8(255, 16) != 15) { ret 8; }
    if (div16(-32768, 1) != -32768 || div16(-32768, 2) != -16384 || div16(32767, -1) != -32767) { ret 9; }
    if (rem16(-32768, 3) != -2 || rem16(-32768, 32767) != -1 || rem16(-9, 4) != -1) { ret 10; }
    if (divu16(65535, 1) != 65535 || divu16(65535, 256) != 255 || divu16(32768, 65535) != 0) { ret 11; }
    if (remu16(65535, 256) != 255 || remu16(40000, 65535) != 40000 || remu16(65535, 2) != 1) { ret 12; }
    ret 0;
}
