use std.runtime;

# values carried in pieces across loops that read them and never write them,
# which the allocator splits at the loop: one value of the loop's own,
# reloaded before the loop, in place of a reload in each block. `k` is
# written by the outer loop and only read by the inner one, which ends early
# on some trips, and every call leaves no caller-saved register to hold them

#[inline("never")]
fun bump(x: u64) u64 {
    ret x + 1;
}

fun walk(n: u64, a: u64, b: u64, c: u64, d: u64, e: u64, f: u64, g: u64, h: u64) u64 {
    var s: u64 = 0;
    var k: u64 = a;
    var i: u64 = 0;
    for (i < n) {
        s = bump(s) + a * i + (b ^ i) + (c | i) - (d & i) + e + f + g + h;
        k = k * 3 + i;
        var j: u64 = 0;
        for (j < 3) {
            s = s + bump(k + j) + (h >> (j & 7));
            if (s % 1000 == 7) { brk; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret s + a + b + c + d + e + f + g + h + k;
}

# ten values live across calls, more than the preserved registers hold, so
# some are carried in pieces, then a loop with no call that reads nine of
# them in different blocks, which its free registers hold
fun spread(n: u64, a: u64) u64 {
    val x0: u64 = bump(a * 0x9e3779b97f4a7c15);
    val x1: u64 = bump(x0 * 0x9e3779b97f4a7c15 + 1);
    val x2: u64 = bump(x1 * 0x9e3779b97f4a7c15 + 2);
    val x3: u64 = bump(x2 * 0x9e3779b97f4a7c15 + 3);
    val x4: u64 = bump(x3 * 0x9e3779b97f4a7c15 + 4);
    val x5: u64 = bump(x4 * 0x9e3779b97f4a7c15 + 5);
    val x6: u64 = bump(x5 * 0x9e3779b97f4a7c15 + 6);
    val x7: u64 = bump(x6 * 0x9e3779b97f4a7c15 + 7);
    val x8: u64 = bump(x7 * 0x9e3779b97f4a7c15 + 8);
    val x9: u64 = bump(x8 * 0x9e3779b97f4a7c15 + 9);
    var s:  u64 = 0;
    var i:  u64 = 0;
    for (i < n) {
        if ((i & 1) != 0) { s = s + x5 * i + x6 + (x0 ^ x1); }
        or                { s = s ^ (x7 + i + (x2 | x3)); }
        if (i % 3 == 0)   { s = s + (x8 >> (i & 63)) - x4; }
        i = i + 1;
    }
    ret s + x0 + x1 + x2 + x3 + x4 + x5 + x6 + x7 + x8 + x9;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val n: u64 = 56 + argc::u64;
    if (walk(n, 0xfedcba9876543210, 3, 0xffffffffffffffff, 0x8000000000000001, 12345, 0x8000000000000000, 77, 0x0f0f0f0f0f0f0f0f) != 0x6459e5f330247717) { ret 1; }
    if (walk(0, 0xfedcba9876543210, 3, 0xffffffffffffffff, 0x8000000000000001, 12345, 0x8000000000000000, 77, 0x0f0f0f0f0f0f0f0f) != 0x0cc8843ffbb7a3b8) { ret 2; }
    if (spread(39 + argc::u64, 0x123456789abcdef) != 0x66e1bb529cb81a6d)                                                                                 { ret 3; }
    if (spread(0, 0x123456789abcdef) != 0x99b8414c1ddaa102)                                                                                              { ret 4; }
    ret 0;
}
