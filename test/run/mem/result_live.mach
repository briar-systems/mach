# targets: linux-x86_64 linux-x86_64-optimized
# flags:   --set debug=false
use std.types.error.err;
use std.types.result.res;

use std.runtime;

# a local is the result's memory while nothing else writes that memory and the local is still to be read: a local
# returned alongside a return that builds a fresh value, or one built by a call that reads the local first, and two
# locals returned on different paths, the first read no more once the second is declared, each through a recursion
# that returns what the level below returned. a copy of a tag whose case a guard fixes moves that case, into a local,
# by assignment and through a field. a statement's temporaries, the results of calls it discards, have their storage
# scoped to it. a payload passed by value twice, the second time to a call whose result is stored through a pointer,
# reaches both callees whole. each case checks what it computes. built without debug information, as a release build
# is: with it, each return keeps its own code.

rec Big {
    a: i64;
    b: i64;
    c: i64;
    d: i64;
    e: i64;
}

tag Fault: u8 {
    none;
    bad: Big;
}

rec Holder {
    n: i64;
    f: Fault;
}

#[inline("never")]
fun leaf(n: i64) Big {
    ret Big{a: n, b: 2, c: 3, d: 4, e: 5};
}

# a local returned on one path, a fresh value on another
#[inline("never")]
fun beside(n: i64) Big {
    if (n == 0) {
        ret Big{a: 1, b: 2, c: 3, d: 4, e: 5};
    }
    val r: Big = beside(n - 1);
    if (r.a == 999) { ret Big{a: 0, b: 0, c: 0, d: 0, e: 0}; }
    ret r;
}

# two locals on different paths: the first is read no more once the second is declared
#[inline("never")]
fun two(n: i64) Big {
    if (n == 0) {
        ret Big{a: 1, b: 2, c: 3, d: 4, e: 5};
    }
    val first: Big = leaf(n);
    if (first.a != n) { ret first; }
    val second: Big = two(n - 1);
    ret second;
}

#[inline("never")]
fun make(x: i64) res[Big, Fault] {
    if (x < 0)  { ret res[Big, Fault].err{Fault.bad{Big{a: x, b: 1, c: 2, d: 3, e: 4}}}; }
    if (x == 0) { ret res[Big, Fault].err{Fault.none{}}; }
    ret res[Big, Fault].ok{Big{a: x, b: x + 1, c: x + 2, d: x + 3, e: x + 4}};
}

#[inline("never")]
fun fault_big(f: Fault) Big {
    if (sel f.bad) { ret f.bad; }
    ret Big{a: 0, b: 0, c: 0, d: 0, e: 0};
}

# std.io.reader.read's shape: the local returned on one path, a fresh value on another, and on a third a value built
# by a call that reads the local before it writes the result
#[inline("never")]
fun relay(n: i64) res[Big, Fault] {
    if (n == 0) {
        ret res[Big, Fault].ok{Big{a: 1, b: 2, c: 3, d: 4, e: 5}};
    }
    val r: res[Big, Fault] = relay(n - 1);
    if (sel r.ok) {
        if (r.ok.a == 999) { ret res[Big, Fault].err{Fault.none{}}; }
        ret r;
    }
    ret res[Big, Fault].ok{fault_big(r.err)};
}

#[inline("never")]
fun relay_once(x: i64) res[Big, Fault] {
    val r: res[Big, Fault] = make(x);
    if (sel r.ok) {
        if (r.ok.a == 999) { ret res[Big, Fault].err{Fault.none{}}; }
        ret r;
    }
    ret res[Big, Fault].ok{fault_big(r.err)};
}

# copies of a tag whose case a guard fixes: into a local, by assignment, and from a field of a parameter
#[inline("never")]
fun known(f: Fault, h: Holder) i64 {
    var total: i64 = 0;
    if (sel f.bad) {
        val y: Fault = f;
        var z: Fault = Fault.none{};
        z = f;
        if (sel y.bad) { total = total + y.bad.a; }
        if (sel z.bad) { total = total + z.bad.e; }
    }
    if (sel h.f.bad) {
        val w: Fault = h.f;
        if (sel w.bad) { total = total + w.bad.c; }
    }
    if (sel f.none) {
        val q: Fault = f;
        if (sel q.none) { total = total + 1000; }
    }
    ret total;
}

#[inline("never")]
fun discarded(n: i64) i64 {
    if (n == 0) {
        ret 0;
    }
    leaf(n);
    leaf(n + 1);
    leaf(n + 2);
    leaf(n + 3);
    ret discarded(n - 1) + 1;
}

rec Wide {
    a: i64;
    b: i64;
    c: i64;
    d: i64;
    e: i64;
    f: i64;
}

rec Sink {
    n:      i64;
    failed: i64;
    error:  Wide;
}

#[inline("never")]
fun write_all(n: i64) err[Wide] {
    if (n > 3) { ret err[Wide].err{Wide{a: n, b: 2, c: 3, d: 4, e: 5, f: 6}}; }
    ret err[Wide].ok{};
}

#[inline("never")]
fun persisted(e: Wide) i64 {
    ret e.a;
}

#[inline("never")]
fun reprefix(e: Wide, k: i64) Wide {
    ret Wide{a: e.a + k, b: e.b, c: e.c, d: e.d, e: e.e, f: e.f};
}

# std.io.writer.push's shape: a call's error payload passed by value, then passed again to a call whose result is
# stored through a pointer, after stores through it
#[inline("never")]
fun push(b: *Sink) i64 {
    val done: err[Wide] = write_all(b.n);
    b.n = 0;
    if (sel done.err) {
        b.failed = b.failed + persisted(done.err);
        b.error  = reprefix(done.err, 5);
        ret 1;
    }
    ret 0;
}

fun sum(p: Big) i64 {
    ret p.a + p.b * 2 + p.c * 3 + p.d * 4 + p.e * 5;
}

fun check(r: res[Big, Fault], a: i64, e: i64) i64 {
    if (sel r.ok) {
        if (r.ok.a != a || r.ok.e != e) { ret 1; }
        ret 0;
    }
    ret 1;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    if (sum(beside(64)) != 55)       { ret 1; }
    if (sum(two(64)) != 55)          { ret 3; }
    if (check(relay(64), 1, 5) != 0) { ret 5; }

    if (check(relay_once(argc + 2), argc + 2, argc + 6) != 0) { ret 7; }
    if (check(relay_once(0 - 9), 0 - 9, 4) != 0)              { ret 8; }
    if (check(relay_once(0), 0, 0) != 0)                      { ret 9; }

    val bad:  Fault  = Fault.bad{Big{a: argc + 10, b: 0, c: argc + 30, d: 0, e: argc + 50}};
    val held: Holder = Holder{n: 1, f: bad};
    if (known(bad, held) != 3 * argc + 90)                          { ret 10; }
    if (known(Fault.none{}, Holder{n: 0, f: Fault.none{}}) != 1000) { ret 11; }

    if (discarded(64) != 64) { ret 12; }

    var sink: Sink = Sink{n: argc + 4, failed: 0, error: Wide{a: 0, b: 0, c: 0, d: 0, e: 0, f: 0}};
    if (push(?sink) != 1)                                                   { ret 14; }
    if (sink.n != 0 || sink.failed != argc + 4)                             { ret 15; }
    if (sink.error.a != argc + 9 || sink.error.b != 2 || sink.error.f != 6) { ret 16; }
    sink.n = 1;
    if (push(?sink) != 0 || sink.error.a != argc + 9) { ret 17; }
    ret 0;
}
