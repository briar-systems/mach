use std.runtime;

# a #[volatile] record: every access to its storage is kept, in order and at its width. a
# program cannot see the accesses themselves, so this holds the values: writes through a
# pointer read back, and a loop of read-modify-writes accumulates.

#[volatile]
rec Regs {
    ctrl:   u32;
    status: u8;
    data:   u64;
}

var device: Regs;

fun poke(r: *Regs, n: u64) {
    var i: u64 = 0;
    for (i < n) {
        r.data = r.data + i;
        r.status = r.status + 1;
        i = i + 1;
    }
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val r: *Regs = ?device;
    r.ctrl = 0x8000_0001;
    if (r.ctrl != 0x8000_0001) { ret 1; }
    poke(r, 10);
    if (r.data != 45 || r.status != 10) { ret 2; }
    var local: Regs = device;
    local.ctrl = 0;
    if (device.ctrl != 0x8000_0001 || local.data != 45) { ret 3; }
    ret 0;
}
