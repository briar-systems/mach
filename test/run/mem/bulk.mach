use std.runtime;
use std.types.size.usize;

# copies and fills of a run of bytes, checked byte for byte against loops the vectoriser leaves alone, with the bytes
# around the run checked unchanged. a known length is a whole array moved through a frame slot of a constant-time
# function, which the bulk legalisation moves by units on every target, and moved plainly, by units where the target
# has no bulk instruction: lengths from one byte through a unit of 16 less one, one and one more, several units and a
# tail, and past the in-place bound so a loop with an overlapping last unit moves them. a length not known is a loop
# the vectoriser makes one copy or fill of, over the same lengths and zero. every run starts off any alignment. a known
# copy whose two ranges overlap, the destination below the source and above it, past the in-place bound and within it,
# gives the destination the bytes the source held before it.

val ROOM: usize = 400;

# the byte the bytes around a run hold
val GUARD: u8 = 0xee;

#[inline("never")]
fun plain_copy[T](d: *T, s: *T) {
    @d = @s;
}

#[inline("never")]
fun plain_zero[T](d: *T) {
    var a: T;
    @d = a;
}

#[inline("never")]
#[constant_time("soft")]
fun timed_copy[T](d: *T, s: *T) {
    var a: T = @s;
    @d = a;
}

#[inline("never")]
#[constant_time("soft")]
fun timed_zero[T](d: *T) {
    var a: T;
    @d = a;
}

#[inline("never")]
fun copy_u8(d: *u8, s: *u8, n: usize) {
    var i: usize = 0;
    for (i < n) {
        d[i] = s[i];
        i    = i + 1;
    }
}

#[inline("never")]
#[vectorize("never")]
fun twin_copy(d: *u8, s: *u8, n: usize) {
    var i: usize = 0;
    for (i < n) {
        d[i] = s[i];
        i    = i + 1;
    }
}

#[inline("never")]
fun fill_u8(d: *u8, x: u8, n: usize) {
    var i: usize = 0;
    for (i < n) {
        d[i] = x;
        i    = i + 1;
    }
}

#[inline("never")]
#[vectorize("never")]
fun twin_fill(d: *u8, x: u8, n: usize) {
    var i: usize = 0;
    for (i < n) {
        d[i] = x;
        i    = i + 1;
    }
}

fun seed(src: *u8, out: *u8, want: *u8) {
    var i: usize = 0;
    for (i < ROOM) {
        src[i]  = ((i * 37 + 11) & 0xff)::u8;
        out[i]  = GUARD;
        want[i] = GUARD;
        i       = i + 1;
    }
}

fun same(a: *u8, b: *u8) u8 {
    var i: usize = 0;
    for (i < ROOM) {
        if (a[i] != b[i]) { ret 0; }
        i = i + 1;
    }
    ret 1;
}

# each known copy and fill of a T, from byte 3 of the source to byte 1 of the destination
fun known[T]() u8 {
    val n:    usize = $size_of(T);
    var src:  [ROOM]u8;
    var out:  [ROOM]u8;
    var want: [ROOM]u8;
    var mode: usize = 0;
    for (mode < 4) {
        seed(?src[0], ?out[0], ?want[0]);
        val s: *T = (?src[3]):~*T;
        val d: *T = (?out[1]):~*T;
        if (mode == 0) {
            plain_copy[T](d, s);
            twin_copy(?want[1], ?src[3], n);
        }
        or (mode == 1) {
            timed_copy[T](d, s);
            twin_copy(?want[1], ?src[3], n);
        }
        or (mode == 2) {
            plain_zero[T](d);
            twin_fill(?want[1], 0, n);
        }
        or {
            timed_zero[T](d);
            twin_fill(?want[1], 0, n);
        }
        if (same(?out[0], ?want[0]) == 0) { ret 0; }
        mode = mode + 1;
    }
    ret 1;
}

# a known copy of a T within one buffer, from byte `from` to byte `to`, checked against the bytes the source held,
# which a copy through a second buffer gives
fun overlapped[T](from: usize, to: usize) u8 {
    val n:    usize = $size_of(T);
    var buf:  [ROOM]u8;
    var held: [ROOM]u8;
    var want: [ROOM]u8;
    seed(?buf[0], ?held[0], ?want[0]);
    seed(?want[0], ?held[0], ?held[0]);
    twin_copy(?held[0], ?buf[from], n);
    twin_copy(?want[to], ?held[0], n);
    plain_copy[T]((?buf[to]):~*T, (?buf[from]):~*T);
    ret same(?buf[0], ?want[0]);
}

# each overlapping copy of a T, the destination a byte, a unit less one and a unit plus one below and above the source
fun overlaps[T]() u8 {
    var shift: [3]usize = [3]usize{1, 15, 17};
    var k:     usize    = 0;
    for (k < 3) {
        if (overlapped[T](40, 40 - shift[k]) == 0) { ret 0; }
        if (overlapped[T](40, 40 + shift[k]) == 0) { ret 0; }
        k = k + 1;
    }
    ret 1;
}

# the copy and fill of n bytes the vectoriser makes of a loop, from byte 5 of the source to byte 2 of the destination
fun unknown(n: usize) u8 {
    var src:  [ROOM]u8;
    var out:  [ROOM]u8;
    var want: [ROOM]u8;
    seed(?src[0], ?out[0], ?want[0]);
    copy_u8(?out[2], ?src[5], n);
    twin_copy(?want[2], ?src[5], n);
    if (same(?out[0], ?want[0]) == 0) { ret 0; }
    seed(?src[0], ?out[0], ?want[0]);
    fill_u8(?out[2], 0x5a, n);
    twin_fill(?want[2], 0x5a, n);
    ret same(?out[0], ?want[0]);
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    if (known[[1]u8]() == 0)      { ret 1; }
    if (known[[15]u8]() == 0)     { ret 2; }
    if (known[[16]u8]() == 0)     { ret 3; }
    if (known[[17]u8]() == 0)     { ret 4; }
    if (known[[31]u8]() == 0)     { ret 5; }
    if (known[[33]u8]() == 0)     { ret 6; }
    if (known[[64]u8]() == 0)     { ret 7; }
    if (known[[87]u8]() == 0)     { ret 8; }
    if (overlaps[[87]u8]() == 0)  { ret 13; }
    if (overlaps[[200]u8]() == 0) { ret 14; }
    if (overlaps[[300]u8]() == 0) { ret 15; }
    if (known[[128]u8]() == 0)    { ret 9; }
    if (known[[200]u8]() == 0)    { ret 10; }
    if (known[[300]u8]() == 0)    { ret 11; }
    if (known[[391]u8]() == 0)    { ret 12; }
    var lengths: [14]usize = [14]usize{0, 1, 15, 16, 17, 31, 32, 33, 64, 87, 128, 200, 300, 391};
    var k:       usize     = 0;
    for (k < 14) {
        if (unknown(lengths[k]) == 0) { ret (20 + k)::i64; }
        k = k + 1;
    }
    ret 0;
}
