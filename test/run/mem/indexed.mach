use std.runtime;

# loads through an index of each width a pointer reaches: bytes, halfwords, words, doublewords,
# pointers and both float widths, at an index from a call so no fold decides it, at the first and
# last element and through a pointer past the start with a negative index. a target with a load
# that adds a register, shifted by the element's size, takes each as one (linux-aarch64's dump rule)

fun at8(p: *u8, i: i64) u8 { ret p[i]; }
fun at16(p: *i16, i: i64) i16 { ret p[i]; }
#[symbol("corpus_indexed_word")]
fun at32(p: *u32, i: i64) u32 { ret p[i]; }
fun at64(p: *i64, i: i64) i64 { ret p[i]; }
fun atf(p: *f32, i: i64) f32 { ret p[i]; }
fun atd(p: *f64, i: i64) f64 { ret p[i]; }
fun atp(p: **u8, i: i64) *u8 { ret p[i]; }

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val one: i64 = argc;
    var b: [4]u8 = [4]u8{1, 2, 255, 4};
    var h: [4]i16 = [4]i16{-32768, 2, 3, 32767};
    var w: [4]u32 = [4]u32{0xffffffff, 7, 8, 0x80000000};
    var d: [4]i64 = [4]i64{-9223372036854775807 - 1, 5, 6, 9223372036854775807};
    var f: [4]f32 = [4]f32{0.5, 1.5, 2.5, -3.5};
    var g: [4]f64 = [4]f64{0.25, 1.25, 2.25, -1.0e300};
    var q: [4]*u8 = [4]*u8{?b[0], ?b[1], ?b[2], ?b[3]};
    if (at8(?b[0], 3 * one) != 4 || at8(?b[0], 2 * one) != 255 || at8(?b[3], -3 * one) != 1) { ret 1; }
    if (at16(?h[0], 0 * one) != -32768 || at16(?h[0], 3 * one) != 32767 || at16(?h[3], -2 * one) != 2) { ret 2; }
    if (at32(?w[0], 0 * one) != 0xffffffff || at32(?w[0], 3 * one) != 0x80000000 || at32(?w[2], -one) != 7) { ret 3; }
    if (at64(?d[0], 0 * one) != -9223372036854775807 - 1 || at64(?d[0], 3 * one) != 9223372036854775807 || at64(?d[3], -2 * one) != 5) { ret 4; }
    if (atf(?f[0], 3 * one) != -3.5 || atf(?f[2], -one) != 1.5) { ret 5; }
    if (atd(?g[0], 3 * one) != -1.0e300 || atd(?g[3], -3 * one) != 0.25) { ret 6; }
    if (atp(?q[0], 2 * one) != ?b[2] || atp(?q[3], -3 * one) != ?b[0]) { ret 7; }
    ret 0;
}
