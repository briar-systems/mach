use std.runtime;

# stack frames: a local larger than a page, which a target that grows its stack a page at a
# time must probe; recursion whose frames each hold a buffer; and more live values than any
# target has registers, so the allocator spills and reloads them across a call. the deepest
# use stays well inside 64 KiB, the smallest stack a run target gives (wasm's).

fun big(seed: u64) u64 {
    var buf: [20000]u8;
    var i: u64 = 0;
    for (i < 20000) {
        buf[i] = (i + seed)::u8;
        i = i + 7;
    }
    var s: u64 = 0;
    i = 0;
    for (i < 20000) {
        s = s + buf[i]::u64;
        i = i + 7;
    }
    ret s;
}

fun deep(n: u64) u64 {
    var pad: [8]u64;
    pad[n % 8] = n;
    if (n == 0) { ret 0; }
    ret deep(n - 1) + pad[n % 8];
}

fun id(x: u64) u64 { ret x; }

fun pressure(k: u64) u64 {
    val a: u64 = k + 1;  val b: u64 = k + 2;  val c: u64 = k + 3;  val d: u64 = k + 4;
    val e: u64 = k + 5;  val f: u64 = k + 6;  val g: u64 = k + 7;  val h: u64 = k + 8;
    val i: u64 = k + 9;  val j: u64 = k + 10; val l: u64 = k + 11; val m: u64 = k + 12;
    val n: u64 = k + 13; val o: u64 = k + 14; val p: u64 = k + 15; val q: u64 = k + 16;
    val r: u64 = k + 17; val s: u64 = k + 18; val t: u64 = k + 19; val u: u64 = k + 20;
    val v: u64 = k + 21; val w: u64 = k + 22; val x: u64 = k + 23; val y: u64 = k + 24;
    val z: u64 = k + 25; val aa: u64 = k + 26; val bb: u64 = k + 27; val cc: u64 = k + 28;
    val dd: u64 = k + 29; val ee: u64 = k + 30; val ff: u64 = k + 31; val gg: u64 = k + 32;
    val fa: f64 = k::f64 + 0.5; val fb: f64 = fa * 2.0; val fc: f64 = fb + fa; val fd: f64 = fc * fb;
    val mid: u64 = id(k);
    ret a * b + c * d + e * f + g * h + i * j + l * m + n * o + p * q + r * s + t * u + v * w
      + x * y + z * aa + bb * cc + dd * ee + ff * gg + mid + (fa + fb + fc + fd)::u64;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    # i = 0, 7, ... 19999: the bytes (i + 1) mod 256
    var expect: u64 = 0;
    var i: u64 = 0;
    for (i < 20000) {
        expect = expect + ((i + 1) % 256);
        i = i + 7;
    }
    if (big(1) != expect)      { ret 1; }
    if (deep(200) != 20100)  { ret 2; }
    # k = 0: 1*2 + 3*4 + ... + 31*32 = 5712, plus 0.5 + 1 + 1.5 + 1.5 = 4.5, cut to 4
    if (pressure(0) != 5716)   { ret 3; }
    ret 0;
}
