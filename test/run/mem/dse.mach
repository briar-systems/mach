use std.runtime;

# a store whose bytes a later store of its block writes again, with no read between, is dead:
# every store below is written again, and what lies between decides whether it was read first.
# a load through a pointer that may be the same place, a call that reads, a narrower store over
# part of it, a load of a local at an index that may be the stored one, and a volatile record
# each keep the first store, and every result holds only if they do. the helpers stay calls, so
# their pointers are parameters the pass cannot see through.

#[volatile]
rec Port {
    data: u64;
}

var port:   Port;
var global: u64;
var seen:   u64;

#[inline("never")]
fun look() {
    seen = global;
}

#[inline("never")]
fun through(p: *u64, q: *u64, x: u64) u64 {
    @p = x;
    val got: u64 = @q;
    @p = x + 1;
    ret got;
}

#[inline("never")]
fun before_call(x: u64) u64 {
    global = x;
    look();
    global = x + 1;
    ret seen;
}

#[inline("never")]
fun partial(p: *u64, x: u64) u64 {
    @p = x;
    val low: *u8 = p::*u8;
    @low = 0;
    @p = @p | 1;
    ret @p;
}

#[inline("never")]
fun kept(x: u64) u64 {
    port.data = x;
    port.data = x + 1;
    ret port.data;
}

#[inline("never")]
fun twice(p: *u64, x: u64) {
    @p = x;
    @p = x * 2;
}

#[inline("never")]
fun local(i: u64, j: u64, x: u64) u64 {
    var a: [4]u64;
    a[i & 3] = x;
    val got: u64 = a[j & 3];
    a[i & 3] = 7;
    ret got;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val n:   u64 = argc::u64;
    var one: u64 = 0;
    var two: u64 = 7;
    if (through(?one, ?one, n) != n)                        { ret 1; }
    if (one != n + 1)                                       { ret 2; }
    if (through(?one, ?two, n) != 7)                        { ret 3; }
    if (before_call(n) != n || global != n + 1)             { ret 4; }
    if (partial(?one, (n << 8) | 0x55) != ((n << 8) | 1))   { ret 5; }
    if (kept(n) != n + 1)                                   { ret 6; }
    twice(?two, n);
    if (two != n * 2)                                       { ret 7; }
    if (local(n, n, n + 3) != n + 3)                        { ret 8; }
    if (local(n, n + 4, n + 3) != n + 3)                    { ret 9; }
    if (local(n, n + 1, n + 3) != 0)                        { ret 10; }
    ret 0;
}
