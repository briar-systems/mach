use std.runtime;

# a local whose address never escapes is reached by no call, so a load of it may stand across one, while a local
# whose address goes into a call, or travels as a value a block passes on, is written by what receives it: each
# load after the call must read what the callee wrote, at every index the program chooses at run time.

var counter: u32 = 0;

fun bump(p: *u32, i: i64) {
    p[i] = p[i] + 1;
    counter = counter + 1;
}

fun busy() {
    counter = counter + 1;
}

fun through(p: *u32) {
    p[0] = p[0] + 100;
}

fun check(argc: i64) i64 {
    val i:  i64    = argc;
    var a:  [4]u32 = [4]u32{1, 2, 3, 4};
    var b:  [4]u32 = [4]u32{5, 6, 7, 8};
    var c:  [4]u32 = [4]u32{9, 10, 11, 12};
    var d:  [4]u32 = [4]u32{13, 14, 15, 16};
    val a0: u32    = a[i];
    bump(?a[0], i);
    val a1: u32 = a[i];
    if (a1 != a0 + 1) { ret 1; }
    val b0: u32 = b[i];
    busy();
    val b1: u32 = b[i];
    if (b1 != b0 || b1 != 6) { ret 2; }
    var p: *u32 = ?c[0];
    if (counter > 100) { p = ?d[0]; }
    val c0: u32 = c[0];
    through(p);
    val c1: u32 = c[0];
    if (c1 != c0 + 100) { ret 3; }
    if (counter != 2) { ret 4; }
    ret 0;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    ret check(argc);
}
