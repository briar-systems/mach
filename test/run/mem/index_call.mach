use std.runtime;

# an array indexed by the widened result of a call narrower than the pointer, where the
# memory analysis follows the zero extension back to the call and must not read its
# callee address as a number.

fun slot_of(n: u64) u32 {
    if (n == 0) { ret 3; }
    ret (n + 4)::u32;
}

fun pick(k: u8) u8 {
    ret k % 4;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var kinds: [16]u8;
    var i: u64 = 0;
    for (i < 8) {
        kinds[i] = (i * 3)::u8;
        i = i + 1;
    }
    var hits: u64 = 0;
    i = 0;
    for (i < 4) {
        if (kinds[slot_of(i)::u64] != 0) { hits = hits + kinds[slot_of(i)::u64]::u64; }
        i = i + 1;
    }
    # slots 3, 5, 6, 7 hold 9, 15, 18, 21
    if (hits != 63) { ret 1; }
    var lanes: [4]i8 = [4]i8{-1, -2, -3, -4};
    if (lanes[pick(6)::u64] != -3) { ret 2; }
    ret 0;
}
