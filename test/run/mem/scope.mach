use std.runtime;

# a local's storage ends with its block: two locals of sibling blocks, each handed to a callee, may
# share one frame slot and each block still reads back what it wrote, while a local of a nested
# block lives beside one of the block around it that a pointer still reads, so the two never share.
# a pointer into a local that x86 forms with lea and keeps in a register across a block whose local
# has the same layout keeps the two apart too, as every access through it reads the first.

#[inline("never")]
fun fill(p: *u64, seed: u64) {
    p[0] = seed;
    p[1] = seed + 1;
    p[2] = seed + 2;
    p[3] = seed + 3;
}

#[inline("never")]
fun sum(p: *u64) u64 {
    ret p[0] + p[1] + p[2] + p[3];
}

#[inline("never")]
fun put(p: *u64, v: u64) {
    @p = v;
}

#[inline("never")]
fun get(p: *u64) u64 {
    ret @p;
}

# each pass makes both locals anew, one after the other
fun siblings(n: u64) u64 {
    var total: u64 = 0;
    var i:     u64 = 0;
    for (i < n) {
        var first: u64 = 0;
        {
            var a: [4]u64;
            fill(?a[0], i);
            first = sum(?a[0]);
        }
        {
            var b: [4]u64;
            fill(?b[0], i * 10);
            if (sum(?b[0]) != (i * 40) + 6) { ret 0; }
            total = total + first + (sum(?b[0]) * 2);
        }
        i = i + 1;
    }
    ret total;
}

# the outer local lasts while the inner one lives, read through a pointer taken before it
fun nested(seed: u64) u64 {
    var outer: [4]u64;
    fill(?outer[0], seed);
    val p: *u64 = ?outer[0];
    var r: u64  = 0;
    {
        var inner: [4]u64;
        fill(?inner[0], seed + 100);
        r = (sum(p) * 1000) + sum(?inner[0]);
    }
    ret r;
}

# the upper half of `x` is read and written through a register the whole loop, while each pass
# makes `y` anew and hands it to a callee
fun formed(n: u64, pick: u64) u64 {
    var x:  u64  = n * 3;
    val q:  *u32 = (?x):~*u32;
    var hp: *u32 = ?q[1];
    if (pick == 7) { hp = ?q[0]; }
    var total: u64 = 0;
    var i:     u64 = 0;
    for (i < n) {
        @hp = @hp + 1;
        {
            var y: u64 = 0;
            put(?y, (i * 1000) + 0xffff_0000_0000);
            total = total + get(?y);
        }
        total = total + (@hp)::u64;
        i     = i + 1;
    }
    ret total;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    # sum over i < 4 of (4 i + 6) + 2 (40 i + 6) = 84 i + 18: 0 + 18, 84 + 18, 168 + 18, 252 + 18
    if (siblings(4) != 576) { ret 1; }
    # outer sums to 4 * 5 + 6 = 26, inner to 4 * 105 + 6 = 426
    if (nested(5) != 26426) { ret 2; }
    # each pass adds its own value, and the upper half of 12 counts 1, 2, 3 and 4
    if (formed(4, argc::u64) != (4 * 0xffff_0000_0000) + 6000 + 10) { ret 3; }
    ret 0;
}
