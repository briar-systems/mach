use std.runtime;

# a thread-local block larger than 4096 bytes: a variable placed past the first 4096 bytes
# of the block keeps the high part of its thread pointer offset, so no two variables alias.
# uefi keeps no thread-local storage and refuses the variable, so the checks are not built there.

$if ($mach.build.sys != $mach.sys.uefi) {
    #[thread]
    var low: i64;

    #[thread]
    var big: [8192]u8;

    #[thread]
    var high: i64;

    fun check() i64 {
        low       = 7;
        high      = 9;
        big[0]    = 1;
        big[8191] = 2;
        if (low != 7)       { ret 1; }
        if (high != 9)      { ret 2; }
        if (big[0] != 1)    { ret 3; }
        if (big[8191] != 2) { ret 4; }
        if (big[4096] != 0) { ret 5; }
        ret 0;
    }
}
$or {
    fun check() i64 {
        ret 0;
    }
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    ret check();
}
