use std.runtime;

# frame slots an optimised build lets share: values spilled across calls in one phase and
# others in a later one take the same slots, a value spilled in the first phase and read
# after the second keeps its own, and a value spilled across a loop's back edge keeps its
# slot for the whole loop

fun id(x: i64) i64 {
    ret x;
}

fun phases(s: i64) i64 {
    var kept: i64 = id(s + 100);
    var a0:   i64 = id(s + 1);
    var a1:   i64 = id(s + 2);
    var a2:   i64 = id(s + 3);
    var a3:   i64 = id(s + 4);
    var a4:   i64 = id(s + 5);
    var a5:   i64 = id(s + 6);
    var a6:   i64 = id(s + 7);
    var a7:   i64 = id(s + 8);
    var t:    i64 = id(a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7);
    var b0:   i64 = id(t + 1);
    var b1:   i64 = id(t + 2);
    var b2:   i64 = id(t + 3);
    var b3:   i64 = id(t + 4);
    var b4:   i64 = id(t + 5);
    var b5:   i64 = id(t + 6);
    var b6:   i64 = id(t + 7);
    var b7:   i64 = id(t + 8);
    ret id(b0 + b1 + b2 + b3 + b4 + b5 + b6 + b7) + kept;
}

fun looped(n: i64) i64 {
    var sum: i64 = 0;
    var i:   i64 = 0;
    for (i < n) {
        var c0: i64 = id(i + 1);
        var c1: i64 = id(i + 2);
        var c2: i64 = id(i + 3);
        var c3: i64 = id(i + 4);
        var c4: i64 = id(i + 5);
        var c5: i64 = id(i + 6);
        var c6: i64 = id(i + 7);
        sum = id(sum + c0 + c1 + c2 + c3 + c4 + c5 + c6);
        i   = i + 1;
    }
    ret sum;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    if (phases(0) != 324 + 100)                   { ret 1; }
    if (phases(5) != 8 * (8 * 5 + 36) + 36 + 105) { ret 2; }
    if (looped(10) != 7 * 45 + 28 * 10)           { ret 3; }
    ret 0;
}
