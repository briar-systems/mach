use std.runtime;

# a load of the bytes a store of its block just wrote reads the stored value: each load below
# follows a store, and what lies between decides whether the stored value still holds. a store
# through a pointer that may be the same place, a narrower store over part of a wide one, a load
# of part of a wide store, a call that writes, and a volatile record each leave the load reading
# memory, and every result holds only if they do. the helpers stay calls, so their pointers are
# parameters the pass cannot see through.

#[volatile]
rec Port {
    data: u64;
}

var port:   Port;
var global: u64;

#[inline("never")]
fun bump() {
    global = global + 100;
}

#[inline("never")]
fun same(p: *u64, q: *u64, x: u64) u64 {
    @p = x;
    @q = x + 1;
    ret @p;
}

#[inline("never")]
fun after_call(x: u64) u64 {
    global = x;
    bump();
    ret global;
}

#[inline("never")]
fun narrow(p: *u64, x: u64) u64 {
    @p = x;
    val low: *u8 = p::*u8;
    @low = 0xff;
    ret @p;
}

#[inline("never")]
fun part(p: *u64, x: u64) u64 {
    @p = x;
    val bytes: *u8 = p::*u8;
    ret bytes[1]::u64;
}

#[inline("never")]
fun kept(x: u64) u64 {
    port.data = x;
    port.data = port.data + 1;
    ret port.data;
}

#[inline("never")]
fun apart(p: *u64, x: u64) u64 {
    p[1] = x;
    p[2] = x * 2;
    ret p[1] * 10 + p[2];
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val n:   u64    = argc::u64;
    var one: u64    = 0;
    var two: u64    = 0;
    var row: [4]u64;
    if (same(?one, ?one, n) != n + 1)                { ret 1; }
    if (same(?one, ?two, n) != n)                    { ret 2; }
    if (two != n + 1)                                { ret 3; }
    if (after_call(n) != n + 100)                    { ret 4; }
    if (narrow(?one, 0x1234) != 0x12ff)              { ret 5; }
    if (narrow(?one, n << 8) != ((n << 8) | 0xff))   { ret 6; }
    if (part(?one, 0xa1b2) != 0xa1)                  { ret 7; }
    if (part(?one, 0xffffffffffffffff) != 0xff)      { ret 8; }
    if (kept(n) != n + 1)                            { ret 9; }
    if (apart(?row[0], n) != n * 12)                 { ret 10; }
    if (row[1] != n || row[2] != n * 2)              { ret 11; }
    ret 0;
}
