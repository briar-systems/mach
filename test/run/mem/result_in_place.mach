# targets: linux-x86_64 linux-x86_64-optimized linux-aarch64 linux-aarch64-optimized linux-riscv64 linux-riscv64-optimized
# flags:   --set debug=false
use std.types.result.res;

use std.runtime;

# aggregates built where they are kept: a call's result written into the local it initialises, a
# local returned unchanged built in the caller's result memory, a parameter read where it arrives
# and a tag whose case is known copied as that case alone. a recursion whose every level returns
# what the level below returned holds no copy of the record in its frame, so the stack it takes
# per level stays below what one copy and its temporary would need (80 bytes). then the cases the
# rules must refuse: a result whose destination the callee reads through a pointer or a global
# while it builds it, which has to be built apart and copied, each checked by value. it builds
# without debug information, as a release build does: with it, each return keeps its own code.

rec Big {
    a: i64;
    b: i64;
    c: i64;
    d: i64;
    e: i64;
}

tag Fault: u8 {
    none;
    bad: Big;
}

var top:    u64;
var bottom: u64;

#[inline("never")]
fun mark(at: *u64) {
    var here: i64 = 0;
    @at = (?here):~u64;
}

#[inline("never")]
fun chain(n: i64) Big {
    if (n == 0) {
        mark(?bottom);
        ret Big{a: 1, b: 2, c: 3, d: 4, e: 5};
    }
    val r: Big = chain(n - 1);
    ret r;
}

#[inline("never")]
fun sum(p: Big) i64 {
    ret p.a + p.b * 2 + p.c * 3 + p.d * 4 + p.e * 5;
}

# the callee reads the record it is assigned to, through a global
var g: Big;

#[inline("never")]
fun rotated_global() Big {
    ret Big{a: g.e, b: g.a, c: g.b, d: g.c, e: g.d};
}

# the callee reads the record it is assigned to, through a pointer it was given before
var seen: *Big;

#[inline("never")]
fun rotated_seen() Big {
    ret Big{a: seen.e, b: seen.a, c: seen.b, d: seen.c, e: seen.d};
}

#[inline("never")]
fun make(x: i64) res[Big, Fault] {
    if (x < 0)  { ret res[Big, Fault].err{Fault.bad{Big{a: x, b: 1, c: 2, d: 3, e: 4}}}; }
    if (x == 0) { ret res[Big, Fault].err{Fault.none{}}; }
    ret res[Big, Fault].ok{Big{a: x, b: x + 1, c: x + 2, d: x + 3, e: x + 4}};
}

# a result's payload built in place in the incoming result memory, and a tag returned whole on the
# path its case is known
#[inline("never")]
fun relay(x: i64) res[Big, Fault] {
    val r: res[Big, Fault] = make(x);
    if (sel r.ok) {
        if (r.ok.a == 7) { ret res[Big, Fault].err{Fault.none{}}; }
        ret r;
    }
    ret res[Big, Fault].ok{fault_big(r.err)};
}

#[inline("never")]
fun fault_big(f: Fault) Big {
    if (sel f.bad) { ret f.bad; }
    ret Big{a: 0, b: 0, c: 0, d: 0, e: 0};
}

# the first record is read as an argument after a call that the second argument makes
#[inline("never")]
fun later(p: Big, q: Big) i64 {
    ret sum(p) - sum(q);
}

#[inline("never")]
fun ordered(p: Big) i64 {
    ret later(p, chain(3));
}

fun check(r: res[Big, Fault], a: i64, e: i64) i64 {
    if (sel r.ok) {
        if (r.ok.a != a || r.ok.e != e) { ret 1; }
        ret 0;
    }
    ret 1;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    mark(?top);
    val deep: Big = chain(64);
    if (sum(deep) != 55)           { ret 1; }
    if (top <= bottom)             { ret 2; }
    if ((top - bottom) / 64 >= 80) { ret 3; }

    g = Big{a: 1, b: 2, c: 3, d: 4, e: 5};
    g = rotated_global();
    if (g.a != 5 || g.b != 1 || g.c != 2 || g.d != 3 || g.e != 4) { ret 4; }

    var x: Big = Big{a: 1, b: 2, c: 3, d: 4, e: 5};
    seen = ?x;
    x    = rotated_seen();
    if (x.a != 5 || x.b != 1 || x.c != 2 || x.d != 3 || x.e != 4) { ret 5; }

    if (check(relay(argc + 2), argc + 2, argc + 6) != 0) { ret 6; }
    if (check(relay(0 - 9), 0 - 9, 4) != 0)              { ret 7; }
    if (check(relay(0), 0, 0) != 0)                      { ret 8; }
    val seven: res[Big, Fault] = relay(7);
    if (sel seven.ok) { ret 9; }

    if (ordered(Big{a: 2, b: 2, c: 3, d: 4, e: 5}) != 1) { ret 10; }
    ret 0;
}
