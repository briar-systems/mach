use std.runtime;

# a #[thread] module var: the thread's copy starts from the initializer, and reads and
# writes reach the same copy from every function the thread runs.
# uefi keeps no thread-local storage and refuses the variable, so the checks are not built there.

$if ($mach.build.sys != $mach.sys.uefi) {
    #[thread]
    var depth: u64 = 5;

    #[thread]
    var zero: [4]u32;

    fun enter() u64 {
        depth = depth + 1;
        ret depth;
    }

    fun check() i64 {
        if (depth != 5)                   { ret 1; }
        if (enter() != 6 || enter() != 7) { ret 2; }
        if (depth != 7)                   { ret 3; }
        zero[2] = 9;
        if (zero[0] != 0 || zero[2] != 9) { ret 4; }
        ret 0;
    }
}
$or {
    fun check() i64 {
        ret 0;
    }
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    ret check();
}
