use std.runtime;
use std.types.size.usize;

# layout the program fixes: a packed record has no padding and its unaligned fields read
# and write in place, align(N) raises a type's alignment for globals and locals alike, a
# union overlaps its fields at offset 0 and is as large as its largest, and every natural
# field sits on its own alignment.

#[packed]
rec Header {
    magic:   u8;
    version: u16;
    length:  u32;
    sum:     u64;
}

#[packed]
#[align(8)]
rec Frame { a: u8; b: u32; }

#[align(64)]
rec Line { x: u8; }

uni Number {
    i: u64;
    f: f64;
    b: [8]u8;
}

rec Natural { a: u8; b: u64; c: u16; d: u32; }

rec Packet {
    kind: u8;
    data: uni { word: u32; half: [2]u16; };
}

var line_global: Line;

fun touch(h: *Header, v: u32) {
    h.length = v;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    if ($size_of(Header) != 15 || $align_of(Header) != 1) { ret 1; }
    if ($offset_of(Header, version) != 1 || $offset_of(Header, length) != 3 || $offset_of(Header, sum) != 7) { ret 2; }
    if ($size_of(Frame) != 8 || $align_of(Frame) != 8 || $offset_of(Frame, b) != 1) { ret 3; }

    var raw: [16]u8;
    val h: *Header = (?raw[1])::*Header;
    h.magic = 0x7f;
    h.version = 0x0201;
    touch(h, 0x06050403);
    h.sum = 0x0e0d0c0b0a090807;
    # after the magic byte the fields' little-endian bytes run 1, 2, ... 14
    var i: u64 = 1;
    for (i < 15) {
        if (raw[i + 1] != i::u8) { ret 4; }
        i = i + 1;
    }
    if (raw[1] != 0x7f || raw[2] != 1 || raw[5] != 4 || raw[15] != 0x0e) { ret 5; }
    if (h.length != 0x06050403 || h.sum != 0x0e0d0c0b0a090807) { ret 6; }

    var line_local: Line;
    if ((?line_local)::usize % 64 != 0)  { ret 7; }
    if ((?line_global)::usize % 64 != 0) { ret 8; }
    if ($align_of(Line) != 64 || $size_of(Line) != 64) { ret 9; }

    if ($size_of(Number) != 8)           { ret 10; }
    var n: Number;
    n.f = -2.0;
    if (n.i != 0xc000000000000000 || n.b[7] != 0xc0) { ret 11; }
    n.b[0] = 1;
    if (n.i != 0xc000000000000001)       { ret 12; }

    if ($offset_of(Natural, b) % 8 != 0 || $offset_of(Natural, c) % 2 != 0 || $offset_of(Natural, d) % 4 != 0) { ret 13; }
    if ($size_of(Natural) % $align_of(Natural) != 0 || $align_of(Natural) < 8) { ret 14; }

    var pk: Packet;
    pk.data.word = 0x00020001;
    if (pk.data.half[0] != 1 || pk.data.half[1] != 2) { ret 15; }
    ret 0;
}
