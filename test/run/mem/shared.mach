use std.runtime;

# an address or index that several accesses fold into their addressing modes and that a call or
# a later block still reads in a register: the optimizer shares one computation of it, so the
# selector must keep its definition for the reads no pattern covers.

rec Pool {
    head:     [4]u64;
    frontier: [4]u64;
}

rec Line {
    base:  *u8;
    len:   u64;
    cap:   u64;
    owner: *u8;
}

rec Slot {
    flag:  u8;
    front: Line;
    back:  Line;
    seen:  u64;
}

#[inline("never")]
fun limit(chunk: u64) u64 {
    ret chunk + 1;
}

#[inline("never")]
fun oldest(pool: *Pool, chunk: u64) u64 {
    if (pool.frontier[chunk] < limit(chunk)) { ret pool.frontier[chunk]; }
    ret pool.head[chunk];
}

#[inline("never")]
fun length(l: *Line) u64 {
    ret l.len;
}

#[inline("never")]
fun swap(s: *Slot, fresh: *Line) {
    s.front = s.back;
    s.back  = @fresh;
    if (s.flag != 0) {
        val n: u64 = length(?s.back);
        if (n < s.back.cap) { s.seen = n; }
    }
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var pool: Pool;
    pool.head[1]     = 7;
    pool.frontier[1] = 9;
    if (oldest(?pool, 1) != 7) { ret 1; }

    var s: Slot;
    s.flag = 1;
    s.seen = 0;
    var fresh: Line;
    fresh.base  = nil;
    fresh.len   = 3;
    fresh.cap   = 8;
    fresh.owner = nil;
    s.back = fresh;
    swap(?s, ?fresh);
    if (s.front.len != 3 || s.seen != 3) { ret 2; }
    ret 0;
}
