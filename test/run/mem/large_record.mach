# flags: --set optimize=true
use std.runtime;
use std.types.bool.bool;

# a record holding an array of a ten-case tag and a run of bytes, of more scalars than the aggregates legalisation takes
# apart, made by a call the optimiser expands into a loop that stores each into an array, and passed round a loop that
# remakes it: the expansion hands the record on through a block parameter, which the legalisation holds in a slot of its
# own. the record is kept small in bytes, so the frames of the expanded copies fit a wasm stack

rec Key {
    code: u32;
    held: bool;
}

rec Move {
    x: f64;
    y: f64;
}

rec Drop {
    count: u64;
    paths: *u8;
    block: *u8;
}

tag Event: u8 {
    close;
    key:     Key;
    button:  Key;
    moved:   Move;
    scroll:  Move;
    resize:  Move;
    text:    u32;
    dropped: Drop;
    inside:  bool;
    compose: Drop;
}

rec Queue {
    events: [16]Event;
    names:  [1024]u8;
    head:   u64;
    len:    u64;
}

fun queue_new(n: u64) Queue {
    var q: Queue;
    q.head      = n;
    q.len       = n * 2;
    q.events[n] = Event.text{(n + 7)::u32};
    ret q;
}

fun queue_next(q: Queue, n: u64) Queue {
    var r: Queue = q;
    r.head            = r.head + n;
    r.events[n + 8]   = Event.moved{Move{x: n::f64, y: 0.5}};
    r.names[1000 + n] = n::u8;
    ret r;
}

fun text_of(e: Event) u32 {
    if (sel e.text) { ret e.text; }
    ret 0;
}

fun check() i64 {
    var qs: [12]Queue;
    var i:  u64 = 0;
    for (i < 12) {
        qs[i] = queue_new(i);
        i     = i + 1;
    }
    i = 0;
    for (i < 12) {
        if (qs[i].head != i)                   { ret 1; }
        if (qs[i].len != i * 2)                { ret 2; }
        if (text_of(qs[i].events[i]) != i + 7) { ret 3; }
        i = i + 1;
    }
    var q: Queue = queue_new(3);
    i = 0;
    for (i < 5) {
        q = queue_next(q, i);
        i = i + 1;
    }
    if (q.head != 13)               { ret 4; }
    if (text_of(q.events[3]) != 10) { ret 5; }
    if (q.names[1004] != 4)         { ret 9; }
    val e: Event = q.events[12];
    if (sel e.moved) {
        if (e.moved.x != 4.0) { ret 6; }
        ret 0;
    }
    ret 7;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    ret check();
}
