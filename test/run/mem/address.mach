use std.runtime;
use std.types.size.usize;

# pointers: indexing scales by the element, address arithmetic goes through usize, a
# pointer to a pointer, a pointer to a record field and to an array element, ordering of
# addresses, retyping a pointer to read the bytes of a wider value (every run target is
# little-endian), the untyped `ptr`, and nil.

rec Node { val0: u32; next: *Node; }

fun step(pp: **u32) {
    @pp = ((@pp)::usize + 4)::*u32;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var xs: [5]u32 = [5]u32{10, 11, 12, 13, 14};
    val p: *u32 = ?xs[0];
    if (p[3] != 13)              { ret 1; }
    val q: *u32 = ?xs[2];
    if (@q != 12 || q[1] != 13)  { ret 2; }
    val r: *u32 = (p::usize + 2 * $size_of(u32))::*u32;
    if (r != q)                  { ret 3; }
    if (!(p < q) || q <= p)      { ret 4; }
    if (q::usize - p::usize != 8) { ret 5; }

    var cur: *u32 = p;
    step(?cur);
    step(?cur);
    if (@cur != 12)              { ret 6; }
    @cur = 99;
    if (xs[2] != 99)             { ret 7; }

    var w: u64 = 0x0807060504030201;
    val bytes: *u8 = (?w)::*u8;
    if (bytes[0] != 1 || bytes[7] != 8) { ret 8; }
    bytes[1] = 0xff;
    if (w != 0x080706050403ff01) { ret 9; }
    val halves: *u32 = (?w)::*u32;
    if (halves[1] != 0x08070605) { ret 10; }

    var c: Node = Node{val0: 3, next: nil};
    var b: Node = Node{val0: 2, next: ?c};
    var a: Node = Node{val0: 1, next: ?b};
    var n: *Node = ?a;
    var total: u32 = 0;
    for (n != nil) {
        total = total * 10 + n.val0;
        n = n.next;
    }
    if (total != 123)            { ret 11; }
    val f: *u32 = ?b.val0;
    @f = 7;
    if (a.next.val0 != 7)        { ret 12; }

    val raw: ptr = (?w)::ptr;
    val back: *u64 = raw::*u64;
    if (@back != w)              { ret 13; }
    ret 0;
}
