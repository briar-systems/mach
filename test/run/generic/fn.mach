use std.runtime;

fun twice[T](x: T) T {
    ret x + x;
}

rec Pair[T] {
    a: T;
    b: T;
}

fun first[T](p: Pair[T]) T {
    ret p.a;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    if (twice[u64](21) != 42) { ret 1; }
    var small: u8 = 4;
    if (twice[u8](small) != 8) { ret 2; }
    if (twice[f64](1.25) != 2.5) { ret 3; }
    val p: Pair[u32] = Pair[u32]{a: 7, b: 9};
    if (first[u32](p) != 7) { ret 4; }
    ret 0;
}
