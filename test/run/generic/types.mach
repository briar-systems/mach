use std.runtime;

# generics instantiated over several types: each instance takes its operand class from the
# concrete type, so one comparison is signed in one instance and unsigned or float in
# another. generic records with two parameters, nested instances, a generic tag, a fixed
# stack of T, and a generic calling a generic through pointers.

fun max[T](a: T, b: T) T {
    if (a > b) { ret a; }
    ret b;
}

fun swap[T](a: *T, b: *T) {
    val t: T = @a;
    @a = @b;
    @b = t;
}

fun sort3[T](xs: *T) {
    if (xs[0] > xs[1]) { swap[T](?xs[0], ?xs[1]); }
    if (xs[1] > xs[2]) { swap[T](?xs[1], ?xs[2]); }
    if (xs[0] > xs[1]) { swap[T](?xs[0], ?xs[1]); }
}

rec Duo[A, B] { a: A; b: B; }

fun flip[A, B](d: Duo[A, B]) Duo[B, A] {
    ret Duo[B, A]{a: d.b, b: d.a};
}

tag Maybe[T]: u8 { none; some: T; }

fun or_else[T](m: Maybe[T], d: T) T {
    if (sel m.some) { ret m.some; }
    ret d;
}

rec Stack[T] { items: [8]T; n: u64; }

fun push[T](s: *Stack[T], v: T) {
    s.items[s.n] = v;
    s.n = s.n + 1;
}

fun pop[T](s: *Stack[T]) T {
    s.n = s.n - 1;
    ret s.items[s.n];
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    if (max[i8](-1, 1) != 1)            { ret 1; }
    if (max[u8](255, 1) != 255)         { ret 2; }
    if (max[i64](-5, -9) != -5)         { ret 3; }
    if (max[f32](-0.5, -1.5) != -0.5)   { ret 4; }
    if (max[u64](0x8000000000000000, 1) != 0x8000000000000000) { ret 5; }

    var xs: [3]i16 = [3]i16{300, -2, 7};
    sort3[i16](?xs[0]);
    if (xs[0] != -2 || xs[1] != 7 || xs[2] != 300) { ret 6; }
    var fs: [3]f64 = [3]f64{2.5, 0.5, -1.0};
    sort3[f64](?fs[0]);
    if (fs[0] != -1.0 || fs[2] != 2.5)  { ret 7; }

    val d: Duo[u8, f64] = Duo[u8, f64]{a: 3, b: 1.5};
    val f: Duo[f64, u8] = flip[u8, f64](d);
    if (f.a != 1.5 || f.b != 3)         { ret 8; }
    val nest: Duo[Duo[u8, f64], i32] = Duo[Duo[u8, f64], i32]{a: d, b: -1};
    if (nest.a.b != 1.5 || nest.b != -1) { ret 9; }

    if (or_else[i32](Maybe[i32].some{-4}, 9) != -4) { ret 10; }
    if (or_else[i32](Maybe[i32].none{}, 9) != 9)    { ret 11; }
    if (or_else[Duo[u8, f64]](Maybe[Duo[u8, f64]].some{d}, Duo[u8, f64]{a: 0, b: 0.0}).a != 3) { ret 12; }

    var s: Stack[u16];
    push[u16](?s, 1);
    push[u16](?s, 2);
    push[u16](?s, 3);
    if (pop[u16](?s) != 3 || pop[u16](?s) != 2 || s.n != 1) { ret 13; }
    ret 0;
}
