use std.runtime;

# an asm body is read in its instruction set's dialect, whatever the target: a brace inside a
# comment, a string or a character constant neither opens nor closes it, so each body below
# holds unbalanced braces in all three and an apostrophe in a comment. on aarch64 `#` begins
# an immediate and `//` a comment, and every arm is read on every target, `$if` or not

#[symbol("corpus_dialect}{")]
fun seven() u64 {
    ret 7;
}

# a + '}' - '{', which is a + 2
fun add_two(a: u32) u32 {
    var r: u32 = 0;
    $if ($mach.build.arch == $mach.arch.x86_64) {
        asm x86-64 {
            mov eax, {a}        # it's a comment holding } and { and a lone "
            add eax, '}'; sub eax, '{'
            mov {r}, eax        /* a block comment holding } */
        }
    }
    $or ($mach.build.arch == $mach.arch.aarch64) {
        asm armv8-a {
            ldr w9, {a}         // it's a comment holding } and { and a lone "
            add w9, w9, #'}'; sub w9, w9, #'{'
            str w9, {r}         /* a block comment holding } */
        }
    }
    $or ($mach.build.arch == $mach.arch.riscv64) {
        asm rv64i {
            lw a0, {a}          # it's a comment holding } and { and a lone "
            addi a0, a0, '}'; addi a0, a0, -'{'
            sw a0, {r}          /* a block comment holding } */
        }
    }
    $or ($mach.build.arch == $mach.arch.riscv32) {
        asm rv32i {
            lw a0, {a}          # it's a comment holding } and { and a lone "
            addi a0, a0, '}'; addi a0, a0, -'{'
            sw a0, {r}          /* a block comment holding } */
        }
    }
    $or ($mach.build.arch == $mach.arch.wasm32) {
        asm mvp {
            local.get {r}       ;; it's a comment holding } and { and a lone "
            local.get {a}       (; a block comment holding } (; nested { ;) ;)
            i32.load
            i32.const 2
            i32.add
            i32.store
        }
    }
    $or {
        $error("no assembly block for this architecture");
    }
    ret r;
}

# the function the symbol `corpus_dialect}{` names, its address taken by a string that
# holds braces. mach-o spells the symbol with a leading underscore, so darwin skips it
fun seven_at() fun() u64 {
    var p: ptr = nil;
    $if ($mach.build.sys == $mach.sys.darwin) {
        ret seven;
    }
    $or ($mach.build.arch == $mach.arch.x86_64) {
        asm x86-64 {
            lea rax, [rip + "corpus_dialect}{"]
            mov {p}, rax
        }
    }
    $or ($mach.build.arch == $mach.arch.aarch64) {
        asm armv8-a {
            adr x9, "corpus_dialect}{"
            str x9, {p}
        }
    }
    $or ($mach.build.arch == $mach.arch.riscv64) {
        asm rv64i {
            lla a0, "corpus_dialect}{"
            sd a0, {p}
        }
    }
    $or ($mach.build.arch == $mach.arch.riscv32) {
        asm rv32i {
            lla a0, "corpus_dialect}{"
            sw a0, {p}
        }
    }
    $or {
        ret seven;
    }
    ret p::fun() u64;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    if (add_two(5) != 7) { ret 1; }
    val f: fun() u64 = seven_at();
    if (f() != 7) { ret 2; }
    ret 0;
}
