# targets: linux-x86_64 linux-aarch64 linux-riscv64
use std.runtime;

# a data directive that declares what it writes, in a function whose value lives across the
# block: the block's footprint reads only registers an instruction could, so the value is kept
# and the function builds and returns it

fun across(a: i64) i64 {
    $if ($mach.build.arch == $mach.arch.x86_64) {
        asm x86-64 {
            .byte 0x0f, 0x31 :: writes(rax, rdx)
        }
    }
    $or ($mach.build.arch == $mach.arch.aarch64) {
        asm armv8-a {
            .word 0xd503201f :: writes()
        }
    }
    $or ($mach.build.arch == $mach.arch.riscv64) {
        asm rv64i {
            .word 0x00000013 :: writes()
        }
    }
    $or {
        $error("no assembly block for this architecture");
    }
    ret a + 1;
}

# a block that reads every general register the allocator may assign, rbp
# among them, none of which anything in the function set: such a read reads
# nothing the program names, so the registers are free before the block and
# the value live across it is kept elsewhere
fun every(a: i64) i64 {
    $if ($mach.build.arch == $mach.arch.x86_64) {
        asm x86-64 {
            test rax, rax
            test rbx, rbx
            test rcx, rcx
            test rdx, rdx
            test rsi, rsi
            test rdi, rdi
            test rbp, rbp
            test r8, r8
            test r9, r9
            test r10, r10
            test r11, r11
            test r12, r12
            test r13, r13
            test r14, r14
            test r15, r15
        }
    }
    ret a * 3;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    if (across(argc + 40) != 42) { ret 1; }
    if (every(argc + 13) != 42)  { ret 2; }
    ret 0;
}
