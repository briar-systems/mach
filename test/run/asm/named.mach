# targets: linux-x86_64 linux-x86_64-optimized linux-aarch64 linux-aarch64-optimized linux-riscv64

use std.runtime;

# an assembly block calls a function by its symbol, which nothing else names: the call is a
# relocation against the symbol, so the link keeps the function

var hit: i64 = 0;

#[symbol("corpus_asm_reached")]
fun reached() {
    hit = 7;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    $if ($mach.build.arch == $mach.arch.x86_64) {
        asm x86-64 {
            call corpus_asm_reached
        }
    }
    $or ($mach.build.arch == $mach.arch.aarch64) {
        asm armv8-a {
            bl corpus_asm_reached
        }
    }
    $or ($mach.build.arch == $mach.arch.riscv64) {
        asm rv64i {
            call corpus_asm_reached
        }
    }
    $or {
        $error("no assembly block for this architecture");
    }
    if (hit != 7) { ret 1; }
    ret 0;
}
