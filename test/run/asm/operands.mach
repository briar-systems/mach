# targets: linux-x86_64 linux-x86_64-optimized

use std.runtime;

# an operand resolves by what it names: a compile-time constant, a module `val` or a comptime
# parameter, is an immediate, and a run-time value a register where the instruction takes
# one, written back after the block where the block writes it, and memory where it takes no
# register. a block marked `noreturn` ends its function, which may then be `noreturn` itself

val BIAS: u64 = 40;

fun biased($n: u64, x: u64) u64 {
    var r: u64 = x;
    asm x86-64 {
        add {r}, {BIAS}
        add {r}, {n}
    }
    ret r;
}

fun doubled(x: u32) u32 {
    var r: u32 = 0;
    asm x86-64 {
        mov eax, {x}
        add eax, eax
        mov {r}, eax
    }
    ret r;
}

#[noreturn]
fun leave(code: i64) {
    #[noreturn]
    asm x86-64 {
        mov rdi, {code}
        mov eax, 60
        syscall
    }
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    if (biased(2, 1) != 43)  { leave(1); }
    if (doubled(21) != 42)   { leave(2); }
    leave(0);
}
