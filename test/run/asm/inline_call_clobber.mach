# targets: linux-x86_64 linux-x86_64-optimized

use std.runtime;

#[symbol("corpus_asm_clobber_regs")]
fun clobber_regs() {
    asm x86-64 {
        mov rax, 1111
        mov rcx, 2222
        mov rdx, 3333
        mov rsi, 4444
        mov rdi, 5555
        mov r8, 6666
        mov r9, 7777
        mov r10, 8888
        mov r11, 9999
    }
}

fun sum_inline(a0: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64, a6: i64, a7: i64) i64 {
    var r: i64 = 0;
    asm x86-64 {
        call corpus_asm_clobber_regs
        mov rax, {a0}
        add rax, {a1}
        add rax, {a2}
        add rax, {a3}
        add rax, {a4}
        add rax, {a5}
        add rax, {a6}
        add rax, {a7}
        mov {r}, rax
    }
    ret r;
}

fun sum_live_across(a0: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64, a6: i64, a7: i64) i64 {
    val s0: i64 = a0 + 1;
    val s1: i64 = a1 + 2;
    val s2: i64 = a2 + 3;
    val s3: i64 = a3 + 4;
    val s4: i64 = a4 + 5;
    val s5: i64 = a5 + 6;
    val s6: i64 = a6 + 7;
    val s7: i64 = a7 + 8;
    asm x86-64 {
        call corpus_asm_clobber_regs
    }
    ret s0 + s1 + s2 + s3 + s4 + s5 + s6 + s7;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val a0: i64 = argc + 1;
    val a1: i64 = argc + 2;
    val a2: i64 = argc + 3;
    val a3: i64 = argc + 4;
    val a4: i64 = argc + 5;
    val a5: i64 = argc + 6;
    val a6: i64 = argc + 7;
    val a7: i64 = argc + 8;

    val expect_inline: i64 = argc * 8 + 36;
    val expect_across: i64 = argc * 8 + 72;

    if (sum_inline(a0, a1, a2, a3, a4, a5, a6, a7) != expect_inline) {
        ret 1;
    }
    if (sum_live_across(a0, a1, a2, a3, a4, a5, a6, a7) != expect_across) {
        ret 2;
    }
    ret 0;
}
