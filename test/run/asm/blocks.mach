use std.runtime;

# an inline assembly block on each instruction set a run target has, chosen by $if: locals
# substituted as operands, read and written, and a pointer local staged through a register
# to reach its pointee. each block computes a * 3 + b and stores it through the pointer.

fun mad(a: u32, b: u32, out: *u32) {
    var r: u32 = 0;
    $if ($mach.build.arch == $mach.arch.x86_64) {
        asm x86-64 {
            mov eax, {a}
            lea eax, [eax + eax * 2]
            add eax, {b}
            mov {r}, eax
            mov rcx, {out}
            mov [rcx], eax
        }
    }
    $or ($mach.build.arch == $mach.arch.aarch64) {
        asm armv8-a {
            ldr w9, {a}
            ldr w10, {b}
            add w9, w9, w9, lsl 1
            add w9, w9, w10
            str w9, {r}
            ldr x11, {out}
            str w9, [x11]
        }
    }
    $or ($mach.build.arch == $mach.arch.riscv64) {
        asm rv64i {
            lw a0, {a}
            lw a1, {b}
            slli a2, a0, 1
            add a0, a0, a2
            add a0, a0, a1
            sw a0, {r}
            ld a3, {out}
            sw a0, 0(a3)
        }
    }
    $or ($mach.build.arch == $mach.arch.riscv32) {
        asm rv32i {
            lw a0, {a}
            lw a1, {b}
            slli a2, a0, 1
            add a0, a0, a2
            add a0, a0, a1
            sw a0, {r}
            lw a3, {out}
            sw a0, 0(a3)
        }
    }
    $or ($mach.build.arch == $mach.arch.wasm32) {
        asm mvp {
            local.get {r}
            local.get {a}
            i32.load
            i32.const 3
            i32.mul
            local.get {b}
            i32.load
            i32.add
            i32.store
        }
        @out = r;
    }
    $or {
        $error("no assembly block for this architecture");
    }
    if (r != @out) { @out = 0; }
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var got: u32 = 0;
    mad(14, argc::u32, ?got);
    if (got != 43) { ret 1; }
    mad(0x40000000, 5, ?got);
    if (got != 0xc0000005) { ret 2; }
    ret 0;
}
