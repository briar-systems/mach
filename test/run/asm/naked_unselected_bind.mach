# targets: linux-x86_64
use capability: std.system.capability;
use std.runtime;

# a `#[naked]` function's asm block that binds a name, in an arm of a body `$if` the build does
# not select, is never judged: the build lowers only the selected arm, and sema judges only it.
# the gate reads another module's constant, which resolve cannot decide and sema does

#[naked]
fun echo(a: u64) u64 {
    $if (!capability.HOSTED) {
        asm x86-64 {
            mov rax, {a}
            ret
        }
    }
    $or {
        asm x86-64 {
            mov rax, rdi
            ret
        }
    }
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    if (echo(41) != 41) { ret 1; }
    ret 0;
}
