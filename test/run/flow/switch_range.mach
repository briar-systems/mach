use std.runtime;

# a range arm among tests of one value against constants: the tests before it are one chain, the range is tested
# as written, and the tests after it start another chain, so every value in, at the ends of and around the range
# reaches the first arm that holds of it in the source's order

fun graded(x: i32) i32 {
    if (x == 1) {
        ret 10;
    }
    or (x == 2) {
        ret 20;
    }
    or (x == 3) {
        ret 30;
    }
    or (x >= 5 && x <= 9) {
        ret 50 + x;
    }
    or (x == 6) {
        ret 60;
    }
    or (x == 10) {
        ret 100;
    }
    or (x == 11) {
        ret 110;
    }
    or (x == 12) {
        ret 120;
    }
    or (x == 13) {
        ret 130;
    }
    ret -1;
}

fun graded_want(x: i32) i32 {
    val low:  [3]i32 = [3]i32{10, 20, 30};
    val high: [4]i32 = [4]i32{100, 110, 120, 130};
    if (x >= 1 && x <= 3) {
        ret low[(x - 1)::u32];
    }
    if (x >= 5 && x <= 9) {
        ret 50 + x;
    }
    if (x >= 10 && x <= 13) {
        ret high[(x - 10)::u32];
    }
    ret -1;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var x: i32 = -3;
    for (x < 20) {
        if (graded(x) != graded_want(x)) {
            ret 1;
        }
        x = x + 1;
    }
    ret 0;
}
