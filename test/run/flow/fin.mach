use std.runtime;

# `fin` runs when its block exits, in reverse order of declaration: at the end of a block, at
# every iteration of a loop body, through `brk` and `cnt`, and after a `ret` has evaluated its
# value, which a fin cannot change.

var log: u64 = 0;

fun note(d: u64) {
    log = log * 10 + d;
}

fun leave(early: u1) u64 {
    fin { note(1); }
    fin { note(2); }
    if (early) {
        fin { note(3); }
        ret log;
    }
    note(4);
    ret log;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    {
        fin { note(1); }
        fin { note(2); }
        note(3);
    }
    if (log != 321) { ret 1; }

    log = 0;
    var i: u64 = 0;
    for (i < 4) {
        fin { note(9); }
        i = i + 1;
        if (i == 2) { cnt; }
        if (i == 3) { brk; }
        note(i);
    }
    # i = 1: 1 then 9; i = 2: cnt, 9; i = 3: brk, 9
    if (log != 1999) { ret 2; }

    log = 0;
    if (leave(1) != 0) { ret 3; }
    if (log != 321)    { ret 4; }
    log = 0;
    if (leave(0) != 4) { ret 5; }
    if (log != 421)    { ret 6; }
    ret 0;
}
