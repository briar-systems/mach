use std.runtime;

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var sum: u64 = 0;
    var i:   u64 = 1;
    for (i <= 10) {
        sum = sum + i;
        i   = i + 1;
    }
    if (sum != 55) { ret 1; }
    var evens: u64 = 0;
    var k:     u64 = 0;
    for (k < 100) {
        k = k + 1;
        if (k > 10)     { brk; }
        if (k % 2 == 1) { cnt; }
        evens = evens + k;
    }
    if (evens != 30) { ret 2; }
    ret 0;
}
