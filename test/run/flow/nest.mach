use std.runtime;

# the loop forms beyond a plain counted loop: an unconditioned `for` left by `brk`, nested
# loops where `brk` and `cnt` reach only the innermost, a `ret` from inside two loops, and a
# loop whose body never runs.

fun find(limit: u64) u64 {
    var i: u64 = 0;
    for (i < limit) {
        var j: u64 = 0;
        for (j < limit) {
            if (i * j == 42 && i < j) { ret i * 100 + j; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret 0;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var n: u64 = 0;
    for {
        n = n + 1;
        if (n == 7) { brk; }
    }
    if (n != 7) { ret 1; }

    # pairs (i, j) with j < i over 0..5, skipping j == 2, stopping each row past 3
    var pairs: u64 = 0;
    var i: u64 = 0;
    for (i < 5) {
        var j: u64 = 0;
        for (j < i) {
            j = j + 1;
            if (j == 2) { cnt; }
            if (j > 3)  { brk; }
            pairs = pairs + 1;
        }
        i = i + 1;
    }
    # rows i = 1..4 count j in 1..i except 2, at most 3: 1, 1, 2, 2
    if (pairs != 6) { ret 2; }

    if (find(10) != 607) { ret 3; }
    if (find(5) != 0)    { ret 4; }

    var never: u64 = 0;
    for (never > 0) {
        ret 5;
    }
    ret 0;
}
