use std.runtime;

# a wide constant read inside a loop is made once ahead of it and carried through the loop:
# each loop below reads constants no 32-bit immediate holds, in a loop that runs no trip, one
# trip and several, in a loop inside another and beside a constant that fits. the reference
# loops read the same numbers from globals, so they hold no constant, and every result holds
# only if the carried constant is the constant on every trip.

var ka: u64 = 0x9e3779b97f4a7c15;
var kb: u64 = 0x100000001b3;
var kc: i64 = -0x80000001;

#[inline("never")]
fun mix(n: u64, seed: u64) u64 {
    var h: u64 = seed;
    var i: u64 = 0;
    for (i < n) {
        h = (h ^ 0x9e3779b97f4a7c15) * 0x100000001b3;
        i = i + 1;
    }
    ret h;
}

#[inline("never")]
fun mix_ref(n: u64, seed: u64, a: u64, b: u64) u64 {
    var h: u64 = seed;
    var i: u64 = 0;
    for (i < n) {
        h = (h ^ a) * b;
        i = i + 1;
    }
    ret h;
}

#[inline("never")]
fun nest(n: u64, m: u64) i64 {
    var t: i64 = 0;
    var i: u64 = 0;
    for (i < n) {
        var j: u64 = 0;
        for (j < m) {
            t = t * 3 + -0x80000001;
            j = j + 1;
        }
        t = t ^ 0x7fffffff;
        i = i + 1;
    }
    ret t;
}

#[inline("never")]
fun nest_ref(n: u64, m: u64, c: i64) i64 {
    var t: i64 = 0;
    var i: u64 = 0;
    for (i < n) {
        var j: u64 = 0;
        for (j < m) {
            t = t * 3 + c;
            j = j + 1;
        }
        t = t ^ 0x7fffffff;
        i = i + 1;
    }
    ret t;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val n: u64 = argc::u64;
    var k: u64 = 0;
    for (k < 4) {
        if (mix(n + k - 1, n) != mix_ref(n + k - 1, n, ka, kb)) { ret 1; }
        if (nest(n + k - 1, k) != nest_ref(n + k - 1, k, kc))   { ret 2; }
        k = k + 1;
    }
    if (mix(0, 5) != 5)                                          { ret 3; }
    ret 0;
}
