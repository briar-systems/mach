# reports: switch switch_dense.switch_dense.dense 1
use std.runtime;

# a chain of tests of one value against dense constants is one multi-way branch, and on a target that branches
# through tables a jump table: every value below the least case, between the cases, past the greatest and at the
# selector's extremes reaches the arm the compares in their order reach, a constant tested twice keeps its first
# arm, and a selector narrower or as wide as the register reads its own bits

fun dense(x: u32) u32 {
    if (x == 10) {
        ret 3;
    }
    or (x == 11) {
        ret 5;
    }
    or (x == 12) {
        ret 7;
    }
    or (x == 15) {
        ret 11;
    }
    or (x == 14) {
        ret 13;
    }
    or (x == 11) {
        ret 19;
    }
    or (x == 17) {
        ret 23;
    }
    ret 1;
}

fun dense_want(x: u32) u32 {
    val arms: [8]u32 = [8]u32{3, 5, 7, 1, 13, 11, 1, 23};
    if (x >= 10 && x <= 17) {
        ret arms[x - 10];
    }
    ret 1;
}

fun bytes(x: u8) u64 {
    var r: u64 = 100;
    if (x == 0) {
        r = 7;
    }
    or (x == 1) {
        r = 9;
    }
    or (x == 2) {
        r = 4;
    }
    or (x == 3) {
        r = 8;
    }
    or (x == 4) {
        r = 2;
    }
    ret r + x::u64;
}

fun bytes_want(x: u8) u64 {
    val arms: [5]u64 = [5]u64{7, 9, 4, 8, 2};
    if (x <= 4) {
        ret arms[x] + x::u64;
    }
    ret 100 + x::u64;
}

fun top(x: u64) u64 {
    if (x == 0xffffffffffffffff) {
        ret 1;
    }
    or (x == 0xfffffffffffffffe) {
        ret 2;
    }
    or (x == 0xfffffffffffffffc) {
        ret 3;
    }
    or (x == 0xfffffffffffffffb) {
        ret 4;
    }
    ret 0;
}

fun top_want(x: u64) u64 {
    val arms: [5]u64 = [5]u64{1, 2, 0, 3, 4};
    if (x >= 0xfffffffffffffffb) {
        ret arms[0xffffffffffffffff - x];
    }
    ret 0;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var x: u32 = 0;
    for (x < 40) {
        if (dense(x) != dense_want(x)) {
            ret 1;
        }
        x = x + 1;
    }
    val far: [4]u32 = [4]u32{0x7fffffff, 0x80000000, 0x8000000a, 0xffffffff};
    var k:   u32    = 0;
    for (k < 4) {
        if (dense(far[k]) != dense_want(far[k])) {
            ret 2;
        }
        k = k + 1;
    }
    var b: u32 = 0;
    for (b < 256) {
        if (bytes(b::u8) != bytes_want(b::u8)) {
            ret 3;
        }
        b = b + 1;
    }
    var t: u64 = 0;
    for (t < 8) {
        val v: u64 = 0xffffffffffffffff - t;
        if (top(v) != top_want(v)) {
            ret 4;
        }
        if (top(t) != top_want(t)) {
            ret 5;
        }
        t = t + 1;
    }
    ret 0;
}
