use std.runtime;

# chains of tests of one value at the boundaries of its type, signed and unsigned: a case is the value's bits, so the
# least and greatest signed values, minus one and zero, and the unsigned values next to the sign bit each reach their
# own arm, and every value of a byte, read signed and read unsigned, reaches the arm the compares reach

fun signed_byte(x: i8) i32 {
    if (x == -128) {
        ret 1;
    }
    or (x == -127) {
        ret 2;
    }
    or (x == -1) {
        ret 3;
    }
    or (x == 0) {
        ret 4;
    }
    or (x == 126) {
        ret 5;
    }
    or (x == 127) {
        ret 6;
    }
    ret 0;
}

fun signed_byte_want(x: i8) i32 {
    val keys: [6]i8  = [6]i8{-128, -127, -1, 0, 126, 127};
    var r:    i32    = 0;
    var k:    u32    = 0;
    for (k < 6) {
        r = r + (k::i32 + 1) * (keys[k] == x)::i32;
        k = k + 1;
    }
    ret r;
}

fun unsigned_byte(x: u8) i32 {
    if (x == 0) {
        ret 1;
    }
    or (x == 127) {
        ret 2;
    }
    or (x == 128) {
        ret 3;
    }
    or (x == 129) {
        ret 4;
    }
    or (x == 255) {
        ret 5;
    }
    or (x == 126) {
        ret 6;
    }
    ret 0;
}

fun unsigned_byte_want(x: u8) i32 {
    val keys: [6]u8 = [6]u8{0, 127, 128, 129, 255, 126};
    var r:    i32   = 0;
    var k:    u32   = 0;
    for (k < 6) {
        r = r + (k::i32 + 1) * (keys[k] == x)::i32;
        k = k + 1;
    }
    ret r;
}

fun around_zero(x: i16) i32 {
    if (x == -2) {
        ret 1;
    }
    or (x == -1) {
        ret 2;
    }
    or (x == 0) {
        ret 3;
    }
    or (x == 1) {
        ret 4;
    }
    or (x == 2) {
        ret 5;
    }
    ret 0;
}

fun wide(x: i64) i32 {
    if (x == -9223372036854775807 - 1) {
        ret 1;
    }
    or (x == -1) {
        ret 2;
    }
    or (x == 0) {
        ret 3;
    }
    or (x == 9223372036854775807) {
        ret 4;
    }
    or (x == 1) {
        ret 5;
    }
    ret 0;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var b: i32 = 0;
    for (b < 256) {
        val s: i8 = (b - 128)::i8;
        if (signed_byte(s) != signed_byte_want(s)) {
            ret 1;
        }
        if (unsigned_byte(b::u8) != unsigned_byte_want(b::u8)) {
            ret 2;
        }
        b = b + 1;
    }
    var z: i16 = -4;
    for (z <= 4) {
        var want: i32 = 0;
        if (z >= -2 && z <= 2) {
            want = (z + 3)::i32;
        }
        if (around_zero(z) != want) {
            ret 3;
        }
        z = z + 1;
    }
    if (around_zero(-32768) != 0 || around_zero(32767) != 0) {
        ret 4;
    }
    val keys: [5]i64 = [5]i64{-9223372036854775807 - 1, -1, 0, 9223372036854775807, 1};
    var k:    u32    = 0;
    for (k < 5) {
        if (wide(keys[k]) != (k + 1)::i32) {
            ret 5;
        }
        k = k + 1;
    }
    if (wide(2) != 0 || wide(-2) != 0 || wide(9223372036854775806) != 0 || wide(-9223372036854775807) != 0) {
        ret 6;
    }
    ret 0;
}
