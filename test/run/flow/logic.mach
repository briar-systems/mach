use std.runtime;

# `&&` and `||` short-circuit: the right operand runs only when the left does not decide.
# a global counts the calls a condition made. `!` negates a u1.

var calls: u64 = 0;

fun yes() u1 {
    calls = calls + 1;
    ret 1;
}

fun no() u1 {
    calls = calls + 1;
    ret 0;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    if (no() && yes())  { ret 1; }
    if (calls != 1)     { ret 2; }
    if (!(yes() || no())) { ret 3; }
    if (calls != 2)     { ret 4; }
    if (!(yes() && yes())) { ret 5; }
    if (calls != 4)     { ret 6; }
    if (no() || no())   { ret 7; }
    if (calls != 6)     { ret 8; }
    # || binds looser than &&: no() && yes() || yes() is (no() && yes()) || yes()
    if (!(no() && yes() || yes())) { ret 9; }
    if (calls != 8)     { ret 10; }
    val t: u1 = !no();
    if (t != 1)         { ret 11; }
    val small: i64 = argc - 1;
    if (small != 0 && 10 / small > 1) { ret 12; }
    ret 0;
}
