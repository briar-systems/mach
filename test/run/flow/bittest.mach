use std.runtime;

# a masked bit's test feeds both a branch and a stored condition. a target that fuses the
# and, the compare and the branch into one bit-test branch must still compute the and for
# the compare it repeats for the store.

fun masked(flags: u32, y: u1, out: *u1) { @out = (flags & 16) != 0 && y; }

fun masked_not(flags: u32, y: u1, out: *u1) {
    val v: u1 = (flags & 16) != 0 && !y;
    @out = v;
}

fun high(flags: u64, y: u1, out: *u1) { @out = (flags & 0x100000000) == 0 && y; }

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var m: u1 = 1;
    var v: u1 = 1;
    var h: u1 = 0;
    masked(argc::u32, 1, ?m);
    if (m != 0) { ret 1; }
    masked_not(argc::u32, 0, ?v);
    if (v != 0) { ret 2; }
    masked(argc::u32 | 16, 1, ?m);
    if (m != 1) { ret 3; }
    high(argc::u64, 1, ?h);
    if (h != 1) { ret 4; }
    high(argc::u64 | 0x100000000, 1, ?h);
    if (h != 0) { ret 5; }
    ret 0;
}
