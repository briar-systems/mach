use std.runtime;

# a chain of tests of one value against constants too far apart for a table is one multi-way branch the back end
# tests case by case in increasing order: every case, its neighbours and the selector's extremes reach the arm the
# compares in the source's order reach, an arm that only sets a variable joins the code after the chain, and the
# arguments a join receives from each arm stay the arm's own

var seen: u64 = 0;

fun sparse(x: u64) u64 {
    var r: u64 = 0;
    if (x == 0x8000000000000000) {
        r = 6;
    }
    or (x == 1000) {
        r = 3;
    }
    or (x == 1) {
        r = 1;
    }
    or (x == 0xffffffffffffffff) {
        r = 7;
    }
    or (x == 65536) {
        seen = seen + 1;
        r    = 4;
    }
    or (x == 100) {
        r = 2;
    }
    or (x == 0x100000000) {
        r = 5;
    }
    or {
        r = 9;
    }
    ret r * 10 + x % 7;
}

fun sparse_want(x: u64) u64 {
    val keys: [7]u64 = [7]u64{0x8000000000000000, 1000, 1, 0xffffffffffffffff, 65536, 100, 0x100000000};
    val arms: [7]u64 = [7]u64{6, 3, 1, 7, 4, 2, 5};
    var r:    u64    = 9;
    var k:    u64    = 7;
    for (k > 0) {
        k = k - 1;
        r = r * (keys[k] != x)::u64 + arms[k] * (keys[k] == x)::u64;
    }
    ret r * 10 + x % 7;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val keys: [9]u64 = [9]u64{0, 1, 100, 1000, 65536, 0x100000000, 0x8000000000000000, 0xffffffffffffffff, 0x7fffffffffffffff};
    var want: u64    = 0;
    var k:    u64    = 0;
    for (k < 9) {
        var d: u64 = 0;
        for (d < 3) {
            val x: u64 = keys[k] + d - 1;
            if (sparse(x) != sparse_want(x)) {
                ret 1;
            }
            if (x == 65536) {
                want = want + 1;
            }
            d = d + 1;
        }
        k = k + 1;
    }
    if (seen != want) {
        ret 2;
    }
    ret 0;
}
