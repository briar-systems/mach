use std.runtime;

# a chain of tests of one value interrupted by a test of another: the tests before the interruption are one chain,
# the other value is tested where the source tests it, and the tests after it start a chain of their own, so a case
# of the second chain is reached only where the interrupting test fails

fun mixed(x: u32, y: u32) u32 {
    if (x == 0) {
        ret 1;
    }
    or (x == 1) {
        ret 2;
    }
    or (x == 2) {
        ret 3;
    }
    or (y == 4) {
        ret 4;
    }
    or (x == 3) {
        ret 5;
    }
    or (x == 4) {
        ret 6;
    }
    or (x == 5) {
        ret 7;
    }
    or (x == 6) {
        ret 8;
    }
    ret 9;
}

fun mixed_want(x: u32, y: u32) u32 {
    if (x <= 2) {
        ret x + 1;
    }
    if (y == 4) {
        ret 4;
    }
    if (x <= 6) {
        ret x + 2;
    }
    ret 9;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var x: u32 = 0;
    for (x < 10) {
        var y: u32 = 0;
        for (y < 8) {
            if (mixed(x, y) != mixed_want(x, y)) {
                ret 1;
            }
            y = y + 1;
        }
        x = x + 1;
    }
    ret 0;
}
