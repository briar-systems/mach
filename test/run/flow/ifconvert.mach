use std.runtime;

# a branch whose arms only compute values for the block they join becomes a select of each
# value: here each test has arms that compute both ways, or an arm whose work must not run on
# the other path, a call with an effect, a division whose divisor the test guards, and a load
# through a pointer the test guards. each result holds only if the work of the arm not taken
# never runs where it can be seen.

var calls: u64;

#[inline("never")]
fun note() u64 {
    calls = calls + 1;
    ret calls;
}

#[inline("never")]
fun pick(c: u64, x: u64, y: u64) u64 {
    var r: u64 = y + 1;
    if (c > 5) { r = x * 3 + 1; }
    ret r;
}

#[inline("never")]
fun both(c: u64, x: u64, y: u64) u64 {
    var r: u64 = 0;
    if ((c & 1) == 0) { r = x ^ y; }
    or { r = x - y; }
    ret r;
}

#[inline("never")]
fun least(a: i64, b: i64) i64 {
    var m: i64 = a;
    if (b < a) { m = b; }
    ret m;
}

#[inline("never")]
fun divided(x: u64, d: u64) u64 {
    var q: u64 = 0;
    if (d != 0) { q = x / d; }
    ret q;
}

#[inline("never")]
fun loaded(p: *u64) u64 {
    var v: u64 = 7;
    if (p != nil) { v = @p; }
    ret v;
}

#[inline("never")]
fun effect(c: u64, x: u64) u64 {
    var r: u64 = x;
    if (c > 2) { r = note() + 100; }
    ret r;
}

#[inline("never")]
fun shifted(x: u64, s: u64) u64 {
    var r: u64 = 0;
    if (s < 64) { r = x << s; }
    ret r;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val n:    u64 = argc::u64;
    var cell: u64 = 41;
    if (pick(5, n, 10) != 11)                 { ret 1; }
    if (pick(6, n, 10) != n * 3 + 1)          { ret 2; }
    if (both(2, n, 3) != (n ^ 3))             { ret 3; }
    if (both(3, n + 5, 3) != n + 2)           { ret 4; }
    if (least(-1, 0) != -1)                   { ret 5; }
    if (least(0, -1) != -1)                   { ret 6; }
    if (least(-9223372036854775807 - 1, 9223372036854775807) != -9223372036854775807 - 1) { ret 7; }
    if (divided(n + 9, 0) != 0)               { ret 8; }
    if (divided(n + 9, n) != (n + 9) / n)     { ret 9; }
    if (loaded(nil) != 7)                     { ret 10; }
    if (loaded(?cell) != 41)                  { ret 11; }
    if (effect(2, n) != n)                    { ret 12; }
    if (calls != 0)                           { ret 13; }
    if (effect(3, n) != 101)                  { ret 14; }
    if (calls != 1)                           { ret 15; }
    if (shifted(n, 64) != 0)                  { ret 16; }
    if (shifted(n, 63) != (n << 63))          { ret 17; }
    ret 0;
}
