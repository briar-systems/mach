# reports: bypass result_chain.result_chain.chain 8; thread result_chain.result_chain.chain
# flags: --set debug=false
use std.types.result.res;

use std.runtime;

# a chain of fallible steps expanded in place in a loop: each step returns a result whose case is known on each of its
# paths, and the caller tests the case a few instructions later, so the forwarders the expansion leaves go and each
# test is threaded away. each chain runs on inputs where every step succeeds, where the first step fails, where a
# later step fails on a later trip, and where a step fails on the last trip, and the failure's case and the trip
# count are checked, so a threaded edge that takes the wrong target or passes the wrong value shows. it builds without
# debug information, as a release build does: with it, each result stays in a slot the debugger reads, and the store
# to that slot is an effect no threaded edge may skip.

tag StepError: u8 {
    negative;
    large;
}

var trips: u64;

fun step_sign(v: i64) res[i64, StepError] {
    if (v < 0) { ret res[i64, StepError].err{StepError.negative{}}; }
    ret res[i64, StepError].ok{v * 3 + 1};
}

fun step_size(v: i64) res[i64, StepError] {
    if (v > 1000000) { ret res[i64, StepError].err{StepError.large{}}; }
    ret res[i64, StepError].ok{v - 1};
}

# both steps on every element, the sum of what they give, or the code of the first failure
#[inline("never")]
fun chain(xs: *i64, n: u64) i64 {
    var acc: i64 = 0;
    var i:   u64 = 0;
    for (i < n) {
        trips = trips + 1;
        val a: res[i64, StepError] = step_sign(xs[i]);
        if (sel a.err) {
            if (sel a.err.negative) { ret 0 - 1; }
            ret 0 - 2;
        }
        val b: res[i64, StepError] = step_size(a.ok);
        if (sel b.err) {
            if (sel b.err.large) { ret 0 - 3; }
            ret 0 - 4;
        }
        acc = acc + b.ok;
        i   = i + 1;
    }
    ret acc;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val one:  i64    = argc;
    var good: [4]i64 = [4]i64{1, 2, 3, 4};
    var neg:  [4]i64 = [4]i64{0 - 5, 2, 3, 4};
    var big:  [4]i64 = [4]i64{1, 2, 400000, 4};
    var last: [4]i64 = [4]i64{1, 2, 3, 0 - 1};
    good[0] = one;
    if (chain(?good[0], 4) != 3 + 6 + 9 + 12) { ret 1; }
    if (trips != 4)                           { ret 2; }
    if (chain(?neg[0], 4) != 0 - 1)           { ret 3; }
    if (trips != 5)                           { ret 4; }
    if (chain(?big[0], 4) != 0 - 3)           { ret 5; }
    if (trips != 8)                           { ret 6; }
    if (chain(?last[0], 4) != 0 - 1)          { ret 7; }
    if (trips != 12)                          { ret 8; }
    if (chain(?good[0], 0) != 0)              { ret 9; }
    if (trips != 12)                          { ret 10; }
    ret 0;
}
