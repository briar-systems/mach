use std.runtime;

# a small innermost loop is copied once, so each trip around the copy runs its body twice: each
# loop below runs no trip, one trip, two and three, one past the copies, and leaves by its test,
# by a break to the same place, or with a value made inside it read after it. every result holds
# only if the copied loop leaves after exactly the trips it left after before.

#[inline("never")]
fun sum(n: u64) u64 {
    var s: u64 = 0;
    var i: u64 = 0;
    for (i < n) {
        s = s + i * 3 + 1;
        i = i + 1;
    }
    ret s;
}

#[inline("never")]
fun find(p: *u64, n: u64, x: u64) u64 {
    var i: u64 = 0;
    for (i < n) {
        if (p[i] == x) { brk; }
        i = i + 1;
    }
    ret i;
}

#[inline("never")]
fun last(n: u64) u64 {
    var v: u64 = 77;
    var i: u64 = 0;
    for (i < n) {
        v = i * i;
        i = i + 1;
    }
    ret v;
}

#[inline("never")]
fun down(n: u64) u64 {
    var k:     u64 = n;
    var steps: u64 = 0;
    for (k != 0) {
        k     = k - 1;
        steps = steps + 2;
    }
    ret steps + k;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val base: u64    = argc::u64 - 1;
    var row:  [4]u64 = [4]u64{5, 6, 7, 8};
    var t:    u64    = 0;
    for (t < 5) {
        val n: u64 = base + t;
        if (sum(n) != (3 * n * (n - 1)) / 2 + n || (n == 0 && sum(n) != 0)) { ret 1; }
        if (find(?row[0], n, 99) != n)                                       { ret 2; }
        if (n < 4 && find(?row[0], 4, row[n]) != n)                          { ret 3; }
        if (n > 0 && find(?row[0], n, row[n - 1]) != n - 1)                  { ret 4; }
        if (n == 0 && last(n) != 77)                                         { ret 5; }
        if (n > 0 && last(n) != (n - 1) * (n - 1))                           { ret 6; }
        if (down(n) != 2 * n)                                                { ret 7; }
        t = t + 1;
    }
    ret 0;
}
