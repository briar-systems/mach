# targets: linux-x86_64 linux-x86_64-optimized
# flags:   --set passes.promote=false --set passes.licm=true --set passes.cse=false
use std.runtime;

# a build turns optimisation passes on and off one by one over optimize: here loop invariant
# motion runs in a build that does not optimise, and promotion and common subexpressions stay off
# in one that does, which every pass must leave computing the same sums

fun sum(n: u64, k: u64) u64 {
    var total: u64 = 0;
    var i:     u64 = 0;
    for (i < n) {
        val step: u64 = k * 3 + 1;
        total = total + step + (k * 3 + 1);
        i     = i + 1;
    }
    ret total;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    if (sum(10, argc::u64) != 80) { ret 1; }
    if (sum(0, 7) != 0)           { ret 2; }
    ret 0;
}
