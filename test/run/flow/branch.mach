use std.runtime;

fun grade(n: u64) u64 {
    if (n < 10)  { ret 1; }
    or (n < 100) { ret 2; }
    or           { ret 3; }
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    if (grade(5) != 1)    { ret 1; }
    if (grade(50) != 2)   { ret 2; }
    if (grade(500) != 3)  { ret 3; }
    ret 0;
}
