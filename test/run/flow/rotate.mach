# reports: rotate rotate.rotate.share 1; rotate rotate.rotate.search 2
use std.types.size.usize;

use std.runtime;

# loops tested at their top, which rotation turns into a guard and a test at the bottom: one whose body reads a global
# nothing in it writes and divides it by the trip count, which is zero exactly when the loop runs no trip, and a
# search of a needle in a haystack with an early exit, its inner loop reading the needle's bytes. each runs no trip,
# one trip and many, and the answers are checked against their closed forms, so a guard that lets a loop run when it
# should not, a value read after the loop from the wrong copy of the test, or a division moved ahead of the guard (a
# trap on the run of no trip) shows.

var TOTAL: u64;

var HAY:    [64]u8;
var NEEDLE: [4]u8;

# the share of TOTAL each of `n` trips gets, summed over them: a run of no trip divides nothing
#[inline("never")]
fun share(n: u64) u64 {
    var acc: u64 = 0;
    var i:   u64 = 0;
    for (i < n) {
        acc = acc + TOTAL / n;
        i   = i + 1;
    }
    ret acc + i;
}

# the first place of the needle's first `m` bytes in the haystack's first `n`, n where it is not found
#[inline("never")]
fun search(n: usize, m: usize) usize {
    var i: usize = 0;
    for (i + m <= n) {
        var k: usize = 0;
        for (k < m && HAY[i + k] == NEEDLE[k]) {
            k = k + 1;
        }
        if (k == m) { ret i; }
        i = i + 1;
    }
    ret n;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    TOTAL = 1000 + argc::u64;
    var n: u64 = 0;
    for (n < 9) {
        var want: u64 = n;
        if (n != 0)           { want = n * (TOTAL / n) + n; }
        if (share(n) != want) { ret 1; }
        n = n + 1;
    }
    var i: usize = 0;
    for (i < 64) {
        HAY[i] = (i % 7)::u8;
        i      = i + 1;
    }
    NEEDLE[0] = 3;
    NEEDLE[1] = 4;
    NEEDLE[2] = 5;
    NEEDLE[3] = 6;
    # no trip of the outer loop, one, and many
    if (search(2, 4) != 2)  { ret 2; }
    if (search(7, 4) != 3)  { ret 3; }
    if (search(6, 4) != 6)  { ret 4; }
    if (search(64, 4) != 3) { ret 5; }
    # an empty needle matches at once, with no trip of the inner loop
    if (search(64, 0) != 0) { ret 6; }
    NEEDLE[3] = 0;
    if (search(64, 4) != 64) { ret 7; }
    ret 0;
}
