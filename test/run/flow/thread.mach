use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;

use std.runtime;

# an edge that passes a block a constant its branch decides on goes straight to the branch's
# target: here each flag is set on some paths and tested again after the paths join, one arm of
# each first test has a side effect that must run exactly once, and a loop whose header tests a
# flag its latch sets must still run every trip. where the flag is read again after its test,
# the edge stays, and the value read must still be the flag's.

var calls: u64;

#[inline("never")]
fun note() u64 {
    calls = calls + 1;
    ret calls;
}

# the flag is a constant on each incoming edge
#[inline("never")]
fun twice(x: u64) u64 {
    var hit: bool = false;
    var out: u64  = 0;
    if (x > 10) {
        out = note();
        hit = true;
    }
    if (hit) { ret out + 1000; }
    ret x;
}

# the flag is a constant on one edge and a comparison on the other
#[inline("never")]
fun mixed(x: u64, y: u64) u64 {
    var ok: bool = y == 3;
    if (x == 0) { ok = false; }
    if (ok) { ret 1; }
    ret 2;
}

# a loop whose header reads the flag its latch passes
#[inline("never")]
fun spin(n: u64) u64 {
    var more:  bool = n > 0;
    var trips: u64  = 0;
    for (more) {
        trips = trips + 1;
        more  = trips < n;
    }
    ret trips;
}

# a loop whose header reads a flag the entering edge passes as a constant
#[inline("never")]
fun spin_once(n: u64) u64 {
    var more:  bool = true;
    var trips: u64  = 0;
    for (more) {
        trips = trips + 1;
        more  = trips < n;
    }
    ret trips;
}

# the flag is read again after the test that would be threaded
#[inline("never")]
fun reread(x: u64) u64 {
    var big: u64 = 0;
    if (x > 10) { big = 1; }
    var out: u64 = 5;
    if (big == 1) { out = note() + 50; }
    ret out + big * 1000;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val n: u64 = argc::u64;
    if (twice(n) != n)               { ret 1; }
    if (calls != 0)                  { ret 2; }
    if (twice(n + 20) != 1001)       { ret 3; }
    if (calls != 1)                  { ret 4; }
    if (mixed(0, 3) != 2)            { ret 5; }
    if (mixed(n, 3) != 1)            { ret 6; }
    if (mixed(n, n + 3) != 2)        { ret 7; }
    if (spin(0) != 0)                { ret 8; }
    if (spin(n) != n)                { ret 9; }
    if (spin(n + 4) != n + 4)        { ret 10; }
    if (spin_once(0) != 1)           { ret 14; }
    if (spin_once(n + 2) != n + 2)   { ret 15; }
    if (reread(n) != 5)              { ret 11; }
    if (reread(n + 20) != 1052)      { ret 12; }
    if (calls != 2)                  { ret 13; }
    ret 0;
}
