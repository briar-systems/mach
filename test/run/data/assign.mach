use std.runtime;
use std.types.size.usize;

# assignment is a right-associative expression whose value is what the place received, and
# an aggregate assignment copies as if the whole right side were read first, so a move
# between overlapping storage keeps every element.

uni Overlap {
    head: [4]u64;
    tail: rec { pad: u64; rest: [4]u64; };
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var a: u64 = 0;
    var b: u64 = 0;
    var c: u64 = 0;
    a = b = c = argc::u64 + 6;
    if (a != 7 || b != 7 || c != 7)    { ret 1; }

    var buf: [6]u64 = [6]u64{1, 2, 3, 4, 5, 6};
    val p: *u64 = ?buf[0];
    # move four words down by one: 2 3 4 5 land at 0..3
    @(p::*[4]u64) = @((p::usize + 8)::*[4]u64);
    if (buf[0] != 2 || buf[3] != 5 || buf[4] != 5 || buf[5] != 6) { ret 2; }
    # and up by one: 2 2 3 4 5 6 -> buf[1..4] = old buf[0..3]
    @((p::usize + 8)::*[4]u64) = @(p::*[4]u64);
    if (buf[0] != 2 || buf[1] != 2 || buf[2] != 3 || buf[4] != 5) { ret 3; }

    var o: Overlap;
    o.head = [4]u64{10, 20, 30, 40};
    o.tail.rest = o.head;
    if (o.head[1] != 10 || o.tail.rest[0] != 10 || o.tail.rest[3] != 40) { ret 4; }
    ret 0;
}
