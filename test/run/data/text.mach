use std.runtime;

# string literals are pointers to NUL-terminated bytes in static memory, with every escape
# giving the byte its code names; character literals are u8 values. bytes are read through
# the pointer and copied into a local buffer that is then written.

fun length(s: *u8) u64 {
    var n: u64 = 0;
    for (s[n] != 0) { n = n + 1; }
    ret n;
}

fun same(a: *u8, b: *u8) u1 {
    var i: u64 = 0;
    for (a[i] == b[i]) {
        if (a[i] == 0) { ret 1; }
        i = i + 1;
    }
    ret 0;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val s: *u8 = "hello, mach";
    if (length(s) != 11)                    { ret 1; }
    if (s[0] != 'h' || s[7] != 'm' || s[11] != 0) { ret 2; }
    val e: *u8 = "\n\t\r\\\'\"\0x";
    if (e[0] != 10 || e[1] != 9 || e[2] != 13 || e[3] != 92 || e[4] != 39 || e[5] != 34 || e[6] != 0) { ret 3; }
    if (e[7] != 'x' || length(e) != 6)      { ret 4; }
    val h: *u8 = "\x41\x7f\xff";
    if (h[0] != 'A' || h[1] != 0x7f || h[2] != 255) { ret 5; }
    if ('\n' != 10 || '\x20' != ' ' || '\\' != 92 || '\0' != 0) { ret 6; }
    if (!same(s, "hello, mach") || same(s, "hello, mac") || same(s, "hello, machs")) { ret 7; }

    var buf: [16]u8;
    var i: u64 = 0;
    for (s[i] != 0) {
        var c: u8 = s[i];
        if (c >= 'a' && c <= 'z') { c = c - 32; }
        buf[i] = c;
        i = i + 1;
    }
    if (!same(?buf[0], "HELLO, MACH"))      { ret 8; }
    if (!same("", ""))                      { ret 9; }
    ret 0;
}
