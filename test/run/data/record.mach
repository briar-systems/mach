use std.runtime;

rec Point {
    x: i64;
    y: i64;
}

rec Line {
    from: Point;
    to:   Point;
    tag:  u8;
}

fun span(l: Line) i64 {
    ret (l.to.x - l.from.x) + (l.to.y - l.from.y);
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var l: Line = Line{from: Point{x: 1, y: 2}, to: Point{x: 11, y: 22}};
    if (span(l) != 30) { ret 1; }
    if (l.tag != 0)    { ret 2; }
    var copy: Line = l;
    l.to.x = 100;
    if (copy.to.x != 11) { ret 3; }
    if (span(l) != 119)  { ret 4; }
    ret 0;
}
