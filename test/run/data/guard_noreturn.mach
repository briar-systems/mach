use std.runtime;
use std.system.panic.panic;

tag Boxed: u8 {
    none;
    some: i64;
}

tag Inner: u8 {
    zero;
    nonzero: i64;
}

#[noreturn]
fun stop() {
    for {}
}

#[noreturn]
fun stop_t[T](x: T) {
    for {}
}

fun via_stop(v: Boxed) i64 {
    if (sel v.none) {
        stop();
    }
    ret v.some;
}

fun via_panic(v: Boxed) i64 {
    if (sel v.none) {
        panic("unexpected none");
    }
    ret v.some;
}

fun via_generic(v: Boxed) i64 {
    if (sel v.none) {
        stop_t[i64](1);
    }
    ret v.some;
}

fun via_asm_noreturn(v: Boxed) i64 {
    if (sel v.none) {
        $if ($mach.build.arch == $mach.arch.x86_64) {
            #[noreturn]
            asm x86-64 {
                ud2
            }
        }
        $or {
            stop();
        }
    }
    ret v.some;
}

fun via_comptime_if(v: Boxed) i64 {
    if (sel v.none) {
        $if ($mach.build.pointer_width > 0) {
            ret 0;
        }
        $or {
            val ignored: i64 = 1;
        }
    }
    ret v.some;
}

fun via_bare_for(v: Boxed) i64 {
    if (sel v.none) {
        for {}
    }
    ret v.some;
}

fun via_nested_sel(v: Boxed, inner: Inner) i64 {
    if (sel v.none) {
        if (sel inner.zero) {
            stop();
        }
        or (sel inner.nonzero) {
            ret inner.nonzero;
        }
    }
    ret v.some;
}

fun via_brk(v: Boxed) i64 {
    var out: i64 = 7;
    for {
        if (sel v.none) {
            brk;
        }
        out = v.some;
        brk;
    }
    ret out;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val base: i64 = argc * 10;
    val s: Boxed = Boxed.some{base + 1};
    val n: Boxed = Boxed.none{};

    if (via_stop(s) != base + 1) { ret 1; }
    if (via_panic(s) != base + 1) { ret 2; }
    if (via_generic(s) != base + 1) { ret 3; }
    if (via_asm_noreturn(s) != base + 1) { ret 4; }
    if (via_comptime_if(s) != base + 1) { ret 5; }
    if (via_comptime_if(n) != 0) { ret 6; }
    if (via_bare_for(s) != base + 1) { ret 7; }
    if (via_nested_sel(s, Inner.zero{}) != base + 1) { ret 8; }
    if (via_nested_sel(n, Inner.nonzero{base + 2}) != base + 2) { ret 9; }
    if (via_brk(s) != base + 1) { ret 10; }
    if (via_brk(n) != 7) { ret 11; }
    ret 0;
}
