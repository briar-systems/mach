use std.runtime;

# globals and their initializers: zero for everything left out (a record, an array, a
# pointer, a float, a tag takes its first case), constant records, arrays and floats, a
# negative narrow value, and addresses the image must relocate: a pointer to another global,
# into an array, a string, a function, and a table of them.

rec Pair { a: i32; b: f64; }

tag Mode: u8 { off; on: u32; }

fun seven() i64 { ret 7; }

# 0 for off, the payload plus one for on
fun level(m: Mode) u32 {
    if (sel m.on) { ret m.on + 1; }
    ret 0;
}
fun nine() i64 { ret 9; }

var zr: Pair;
var za: [3]u64;
var zp: *u64;
var zf: f32;
var zm: Mode;

val MINUS: i8 = -100;
val HALF: f32 = 0.5;
val PAIR: Pair = Pair{a: -3, b: 2.25};
val WIDE: u64 = $size_of(Pair) * 0 + 0xdead_beef_cafe_f00d;
var nums: [4]u64 = [4]u64{1, 2, 3, 4};
var target: u64 = 41;
var to_target: *u64 = ?target;
var to_third: *u64 = ?nums[2];
val NAME: *u8 = "mach";
val NAMES: [3]*u8 = [3]*u8{"a", "bc", "def"};
val FN: fun() i64 = seven;
val FNS: [2]fun() i64 = [2]fun() i64{seven, nine};
var nested: [2]Pair = [2]Pair{Pair{a: 1, b: 1.5}, Pair{a: 2, b: 2.5}};

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    if (zr.a != 0 || zr.b != 0.0 || za[2] != 0 || zp != nil || zf != 0.0) { ret 1; }
    if (level(zm) != 0)                     { ret 2; }
    if (MINUS::i64 != -100 || HALF + HALF != 1.0) { ret 3; }
    if (PAIR.a != -3 || PAIR.b != 2.25)     { ret 4; }
    if (WIDE != 0xdeadbeefcafef00d)         { ret 5; }
    @to_target = @to_target + 1;
    if (target != 42)                       { ret 6; }
    if (@to_third != 3 || to_third[1] != 4) { ret 7; }
    if (NAME[0] != 'm' || NAME[3] != 'h' || NAME[4] != 0) { ret 8; }
    if (NAMES[2][2] != 'f' || NAMES[1][0] != 'b') { ret 9; }
    if (FN() != 7 || FNS[1]() != 9)         { ret 10; }
    nested[1].b = nested[0].b + nested[1].b;
    if (nested[1].b != 4.0 || nested[0].a != 1) { ret 11; }
    zm = Mode.on{5};
    if (level(zm) != 6)                     { ret 12; }
    ret 0;
}
