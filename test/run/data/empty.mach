use std.runtime;

# constants of a type with no size: an empty array and an empty record lay out as nothing,
# $each over the empty array unrolls to nothing, and over an array of empty records once for
# each element.

rec Unit {}

val NONE: [0]i64 = [0]i64{};
val UNIT: Unit = Unit{};
val UNITS: [2]Unit = [2]Unit{Unit{}, Unit{}};

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var t: i64 = 0;
    $each e in NONE { t = t + 1; }
    if (t != 0) { ret 1; }
    var n: i64 = 0;
    $each u in UNITS { n = n + 1; }
    if (n != 2) { ret 2; }
    if ($size_of(Unit) != 0) { ret 3; }
    ret 0;
}
