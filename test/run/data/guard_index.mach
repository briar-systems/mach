use std.runtime;

# guards on an element picked by an index name: assigning the index is allowed and ends the
# guard, so the payload is read before the assignment, bound to a name across it, or tested
# again after it. a loop that never assigns the index keeps a guard opened outside it.

tag Slot: u8 { empty; full: i64; }

fun sum_full(slots: *Slot, n: u64) i64 {
    var total: i64 = 0;
    var i:     u64 = 0;
    for (i < n) {
        if (sel slots[i].full) {
            total = total + slots[i].full;
            i     = i + 1;
            cnt;
        }
        i = i + 1;
    }
    ret total;
}

fun first_full(slots: *Slot, n: u64) i64 {
    var i: u64 = 0;
    for (i < n) {
        if (!(sel slots[i].full)) {
            i = i + 1;
            cnt;
        }
        val v: i64 = slots[i].full;
        i = i + 1;
        ret v;
    }
    ret -1;
}

fun pair(slots: *Slot) i64 {
    var i: u64 = 0;
    if (sel slots[i].full) {
        val head: i64 = slots[i].full;
        i = i + 1;
        if (sel slots[i].full) { ret head * 10 + slots[i].full; }
        ret head;
    }
    ret 0;
}

fun repeat(slots: *Slot, times: u64) i64 {
    var i:     u64 = 0;
    var k:     u64 = 0;
    var total: i64 = 0;
    if (sel slots[i].full) {
        for (k < times) {
            total = total + slots[i].full;
            k     = k + 1;
        }
    }
    ret total;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var slots: [4]Slot = [4]Slot{Slot.full{1}, Slot.empty{}, Slot.full{2}, Slot.full{4}};
    if (sum_full(?slots[0], 4) != 7)   { ret 1; }
    if (first_full(?slots[1], 3) != 2) { ret 2; }
    if (pair(?slots[2]) != 24)         { ret 3; }
    if (pair(?slots[0]) != 1)          { ret 4; }
    if (repeat(?slots[3], 3) != 12)    { ret 5; }
    ret 0;
}
