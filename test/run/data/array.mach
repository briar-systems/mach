use std.runtime;

rec Grid {
    cells: [8]u32;
    used:  u32;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var g: Grid = Grid{};
    var i: u32  = 0;
    for (i < 8) {
        g.cells[i] = i * i;
        g.used     = g.used + 1;
        i          = i + 1;
    }
    var sum: u32 = 0;
    var k:   u32 = 0;
    for (k < g.used) {
        sum = sum + g.cells[k];
        k   = k + 1;
    }
    if (sum != 140)       { ret 1; }
    if (g.cells[7] != 49) { ret 2; }
    ret 0;
}
