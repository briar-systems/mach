use std.runtime;

# tag cases and their guards: an arm, the right side of `&&`, a chain whose arms exit, a
# final bare `or`, and a payload written and addressed in place. discriminators of each
# width sit at offset 0 and number the cases from 0; a zeroed tag is its first case.

rec Box { w: u64; h: u64; d: u64; }

tag Shape: u16 {
    dot;
    line: i64;
    square: i32;
    box: Box;
}

tag Wide: u64 { a; b: u8; }

fun size(s: Shape) i64 {
    if (sel s.dot) {
        ret 0;
    }
    or (sel s.line) {
        ret s.line;
    }
    or (sel s.square) {
        ret (s.square * s.square)::i64;
    }
    or {
        ret (s.box.w * s.box.h * s.box.d)::i64;
    }
}

fun long_line(s: Shape) u1 {
    ret sel s.line && s.line > 100;
}

fun grow(s: Shape) Shape {
    var t: Shape = s;
    if (sel t.box) {
        t.box.d = t.box.d * 2;
        val p: *u64 = ?t.box.w;
        @p = @p + 1;
    }
    ret t;
}

fun square_or(s: Shape, fallback: i32) i32 {
    if (!(sel s.square)) { ret fallback; }
    ret s.square;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    if (size(Shape.dot{}) != 0)               { ret 1; }
    if (size(Shape.line{-5}) != -5)           { ret 2; }
    if (size(Shape.square{-6}) != 36)         { ret 3; }
    val b: Shape = Shape.box{Box{w: 2, h: 3, d: 4}};
    if (size(b) != 24)                        { ret 4; }
    if (size(grow(b)) != 48 + 24)             { ret 5; }
    if (size(b) != 24)                        { ret 6; }
    if (long_line(Shape.line{50}) || !long_line(Shape.line{500}) || long_line(b)) { ret 7; }
    if (square_or(Shape.square{9}, 0) != 9 || square_or(b, -1) != -1) { ret 8; }

    var zero: Shape;
    if (!(sel zero.dot))                      { ret 9; }
    var shapes: [3]Shape = [3]Shape{Shape.line{1}, Shape.dot{}, Shape.square{3}};
    var total: i64 = 0;
    var i: u64 = 0;
    for (i < 3) {
        total = total + size(shapes[i]);
        i = i + 1;
    }
    if (total != 10)                          { ret 10; }

    val sq: Shape = Shape.square{1};
    if (((?sq)::*u16)[0] != 2)                  { ret 11; }
    val w: Wide = Wide.b{7};
    if (((?w)::*u64)[0] != 1 || $size_of(Wide) != 16) { ret 12; }
    val is_line: u1 = sel shapes[0].line;
    if (!is_line || sel shapes[0].dot)        { ret 13; }
    ret 0;
}
