use std.runtime;
use std.types.size.usize;

# numbers made of addresses in global initializers, which the link fixes: an address as an
# integer, an address with a constant added or taken away, and the distance between two
# symbols with and without a constant, each checked against the same number formed at run
# time. a string `val` is the address of its bytes at every use and still has a slot of its
# own holding that address

var buf:  [32]u8;
var tail: u8;

val BASE: usize = (?buf)::usize;
val PAST: usize = (?buf[8])::usize + 16;
val BACK: usize = (?buf)::usize - 4;
val SPAN: u32   = ((?tail)::usize - (?buf)::usize)::u32;
val WIDE: usize = (?tail)::usize - (?buf[4])::usize + 8;
val HELD: [2]usize = [2]usize{(?tail)::usize, 3 + (?buf)::usize};

val MSG: *u8 = "corpus";

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val base: usize = (?buf)::usize;
    if (BASE != base)                                         { ret 1; }
    if (PAST != base + 24)                                    { ret 2; }
    if (BACK != base - 4)                                     { ret 3; }
    if (SPAN != ((?tail)::usize - base)::u32)                 { ret 4; }
    if (WIDE != (?tail)::usize - (base + 4) + 8)              { ret 5; }
    if (HELD[0] != (?tail)::usize || HELD[1] != base + 3)     { ret 6; }
    val again: *u8 = MSG;
    if (again != MSG)                                         { ret 7; }
    if (@(?MSG) != MSG)                                       { ret 8; }
    if (MSG[0] != 'c' || MSG[5] != 's' || MSG[6] != 0)        { ret 9; }
    ret 0;
}
