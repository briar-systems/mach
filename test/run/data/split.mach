use std.runtime;

# locals whose members are each read and written alone become one slot per member, and each member keeps its own
# value: a record updated member by member in a loop, an array of fixed indices, a record whose address goes into a
# call, a union written through one member and read through another, and a record copied whole, which stay whole.

rec Point {
    x: i64;
    y: i64;
    z: u32;
    w: u8;
}

uni Bits {
    f: f32;
    u: u32;
}

fun touch(p: *Point) {
    p.y = p.y + 1000;
}

fun walk(n: i64) i64 {
    var p: Point = Point{x: 1, y: 2, z: 3, w: 4};
    var i: i64   = 0;
    for (i < n) {
        p.x = p.x + p.y;
        p.y = p.y + 1;
        p.z = p.z + p.w::u32;
        p.w = p.w + 1;
        i   = i + 1;
    }
    ret p.x + p.y + p.z::i64 + p.w::i64;
}

fun fixed(n: i64) i64 {
    var a: [4]i64 = [4]i64{n, n + 1, n + 2, n + 3};
    a[1] = a[0] + a[3];
    a[2] = a[2] * 2;
    ret a[0] + a[1] + a[2] + a[3];
}

fun escaped(n: i64) i64 {
    var p: Point = Point{x: n, y: n, z: 0, w: 0};
    touch(?p);
    ret p.x + p.y;
}

fun pun(n: u32) u32 {
    var b: Bits;
    b.u = n;
    val f: f32 = b.f;
    b.f = f;
    ret b.u;
}

fun copied(n: i64) i64 {
    var p: Point = Point{x: n, y: n + 1, z: 2, w: 3};
    var q: Point = p;
    q.x = q.x + 10;
    ret p.x + q.x + q.y + q.z::i64 + q.w::i64;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val n: i64 = argc + 4;
    if (walk(n) != 70)                     { ret 1; }
    if (fixed(n) != 5 + 13 + 14 + 8)       { ret 2; }
    if (escaped(n) != 5 + 1005)            { ret 3; }
    if (pun(0x3f800000 + argc::u32) != 0x3f800001) { ret 4; }
    if (copied(n) != 5 + 15 + 6 + 2 + 3)   { ret 5; }
    ret 0;
}
