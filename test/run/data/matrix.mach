use std.runtime;

# arrays as values: nested arrays, an array literal with an inferred length, copies on
# assignment and on a call, an array returned from a function, an array of records, a
# range read and a range store, and $length_of.

rec Cell { k: u8; v: i32; }

fun transpose(m: [2][3]i32) [3][2]i32 {
    var t: [3][2]i32;
    var i: u64 = 0;
    for (i < 2) {
        var j: u64 = 0;
        for (j < 3) {
            t[j][i] = m[i][j];
            j = j + 1;
        }
        i = i + 1;
    }
    ret t;
}

fun clobber(a: [4]u16) u16 {
    a[0] = 999;
    ret a[0] + a[3];
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val m: [2][3]i32 = [2][3]i32{[3]i32{1, 2, 3}, [3]i32{-4, -5, -6}};
    val t: [3][2]i32 = transpose(m);
    if (t[0][1] != -4 || t[2][0] != 3 || t[2][1] != -6) { ret 1; }

    val days: [_]u8 = [_]u8{31, 28, 31, 30, 31};
    if ($length_of(days) != 5)  { ret 2; }
    var sum: u64 = 0;
    var i: u64 = 0;
    for (i < $length_of(days)) {
        sum = sum + days[i]::u64;
        i = i + 1;
    }
    if (sum != 151)             { ret 3; }

    var a: [4]u16 = [4]u16{10, 20, 30, 40};
    var b: [4]u16 = a;
    b[1] = 7;
    if (a[1] != 20)             { ret 4; }
    if (clobber(a) != 1039)     { ret 5; }
    if (a[0] != 10)             { ret 6; }

    var cells: [3]Cell;
    cells[1] = Cell{k: 'x', v: -7};
    cells[2].v = cells[1].v * 2;
    if (cells[0].k != 0 || cells[0].v != 0 || cells[2].v != -14) { ret 7; }

    val mid: [2]u16 = a[1, 2];
    if (mid[0] != 20 || mid[1] != 30) { ret 8; }
    a[2, 2] = [2]u16{5, 6};
    if (a[1] != 20 || a[2] != 5 || a[3] != 6) { ret 9; }
    val k: u64 = (argc + 1)::u64;
    val run: [2]u16 = a[k, 2];
    if (run[0] != 5 || run[1] != 6) { ret 10; }
    ret 0;
}
