use std.runtime;

# a module array takes the floor its target's abi states for a global array variable, and never
# less than its element's alignment. the bytes ahead of each array leave it off any boundary its
# element would not reach, so only the floor or `#[align]` puts it on one (the target files state
# each one's alignment)

#[symbol("corpus_align_pad0")]
var pad0:    u32    = 1;
#[symbol("corpus_align_small")]
var small:   [3]f32 = [3]f32{1.0, 2.0, 3.0};
#[symbol("corpus_align_pad1")]
var pad1:    u32    = 2;
#[symbol("corpus_align_sixteen")]
val SIXTEEN: [4]f32 = [4]f32{1.0, 2.0, 3.0, 4.0};
#[symbol("corpus_align_pad2")]
var pad2:    u32    = 3;
#[symbol("corpus_align_large")]
var large:   [64]f32;
#[symbol("corpus_align_pad3")]
var pad3:    u32    = 4;
#[symbol("corpus_align_wide")]
#[align(64)]
var wide:    [2]f32 = [2]f32{5.0, 6.0};

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val sum: f32 = small[2] + SIXTEEN[3] + large[63] + wide[1];
    if (sum != 13.0)                     { ret 1; }
    if (pad0 + pad1 + pad2 + pad3 != 10) { ret 2; }
    ret 0;
}
