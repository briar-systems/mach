use std.runtime;

# #[embed] sources a val's bytes from a file at compile time; this file embeds itself, so
# its first bytes are the line above and its length is the length of this file.

#[embed("embed.mach")]
val SELF: [_]u8;

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val head: *u8 = "use std.runtime;\n";
    var i: u64 = 0;
    for (head[i] != 0) {
        if (SELF[i] != head[i]) { ret 1; }
        i = i + 1;
    }
    if ($length_of(SELF) < 300 || SELF[$length_of(SELF) - 1] != '\n') { ret 2; }
    ret 0;
}
