use std.runtime;
use std.types.char.char;
use std.types.size.usize;

# a string literal checked against an array of u8 is that array, holding the literal's bytes and
# nothing else: a terminator only where one is written, the length checked or taken from the
# literal, at module scope and in a function, in a record field, an array of arrays, an argument,
# a result and an assignment, and placed with the binding's own section and alignment. a binding
# of array type answers `$length_of` and `$size_of` for its own type, in an array length, a `$if`
# and a loop bound

rec Tag {
    id:   u8;
    name: [3]u8;
}

val A: [3]u8    = "abc";
val B: [4]u8    = "abc\0";
val D: [_]u8    = "abc";
val E: [_]u8    = "a\nb\x41\0z";
val C: [2]char  = "hi";
val R: Tag      = Tag{id: 7, name: "xyz"};
val P: [2][3]u8 = [2][3]u8{"abc", "def"};
val M: [_]u8    =
    \\ab
    \\cd
;

#[section("rbytes")]
#[align(64)]
val PLACED: [5]u8 = "place";

var COUNTER: [3]u8  = "000";
var WIDE:    [_]u16 = [_]u16{1, 2};

def Twice: [2 * $length_of(D) + 1]u8;

$if ($length_of(D) != 3) {
    $error("a [_]u8 takes the literal's byte count");
}

fun sum(xs: [3]u8) u64 {
    ret xs[0]::u64 + xs[1]::u64 + xs[2]::u64;
}

fun name() [3]u8 {
    ret "mch";
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    if (A[0] != 'a' || A[1] != 'b' || A[2] != 'c')                                            { ret 1; }
    if ($size_of([3]u8) != 3 || $length_of(A) != 3)                                           { ret 2; }
    if ($length_of(B) != 4 || B[3] != 0 || B[2] != 'c')                                       { ret 3; }
    if ($length_of(D) != 3 || D[2] != 'c')                                                    { ret 4; }
    if ($length_of(E) != 6)                                                                   { ret 5; }
    if (E[0] != 'a' || E[1] != 10 || E[2] != 'b' || E[3] != 0x41 || E[4] != 0 || E[5] != 'z') { ret 6; }
    if (C[0] != 'h' || C[1] != 'i')                                                           { ret 7; }
    if (R.id != 7 || R.name[0] != 'x' || R.name[2] != 'z')                                    { ret 8; }
    if (P[0][0] != 'a' || P[1][2] != 'f' || $length_of(P) != 2)                               { ret 9; }
    if ($length_of(M) != 5 || M[2] != 10 || M[4] != 'd')                                      { ret 10; }

    # the bytes are the binding's own storage: its address reads them, at its alignment
    val at: *u8 = (?PLACED)::*u8;
    if (at[0] != 'p' || at[4] != 'e') { ret 11; }
    if ((?PLACED)::usize % 64 != 0)   { ret 12; }

    # a module var's bytes are written in place
    COUNTER[1] = '9';
    if (COUNTER[0] != '0' || COUNTER[1] != '9' || COUNTER[2] != '0') { ret 13; }

    # locals: a val, and a var that holds its own copy
    val la: [3]u8 = "xyz";
    var lb: [4]u8 = "xyz\0";
    lb[0] = 'w';
    if (la[0] != 'x' || lb[0] != 'w' || lb[3] != 0) { ret 14; }
    var lc: [3]u8 = "abc";
    var ld: [3]u8 = "abc";
    lc[0] = 'q';
    if (ld[0] != 'a') { ret 15; }
    val le: [_]u8 = "a\0b";
    if ($length_of(le) != 3 || le[1] != 0 || le[2] != 'b') { ret 16; }

    # an argument, a result and an assignment take the array the same way
    if (sum("abc") != 294) { ret 17; }
    val n: [3]u8 = name();
    if (n[0] != 'm' || n[2] != 'h') { ret 18; }
    lc = "def";
    if (lc[0] != 'd' || lc[2] != 'f') { ret 19; }

    # a record field and an array of arrays in a function
    val t: Tag = Tag{id: 1, name: "pqr"};
    if (t.name[1] != 'q') { ret 20; }
    val g: [2][3]u8 = [2][3]u8{"ghi", "jkl"};
    if (g[0][0] != 'g' || g[1][2] != 'l') { ret 21; }

    # the same text bound to a pointer still stores its terminator
    val s: *u8 = "abc";
    if (s[3] != 0) { ret 22; }

    # comptime reads a constant's bytes
    $if (A[1] != 'b') {
        $error("comptime reads the bytes of a string literal array");
    }
    var seen: u64 = 0;
    $each b in A {
        seen = seen + b::u64;
    }
    if (seen != 294) { ret 23; }

    # a binding answers the layout intrinsics for its type
    if ($size_of(Twice) != 7 || $length_of(Twice) != 7) { ret 24; }
    if ($length_of(WIDE) != 2 || $size_of(WIDE) != 4)   { ret 25; }
    if ($size_of(E) != 6 || $length_of(le) != 3)        { ret 26; }
    var count: u64 = 0;
    var k:     u64 = 0;
    for (k < $length_of(le)) {
        count = count + 1;
        k     = k + 1;
    }
    if (count != 3) { ret 27; }
    $if ($length_of(le) != 3) {
        $error("a local answers `$length_of` in a `$if`");
    }
    ret 0;
}
