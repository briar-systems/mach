use std.types.size.usize;

use std.runtime;

# records by value into and out of functions, one of each shape the calling conventions
# classify apart: two small integers, two words, an integer beside a float, all-float
# records of two, three and four members at each width, three odd bytes, and one too large
# for registers. a callee that changes its copy leaves the caller's alone. records of 41, 88 and 300 bytes go
# through the stack, each passed on again by the callee that took it, beside integers that fill the registers, and
# reach the last callee with every byte in its place.

rec Small  { a: u32; b: i32; }
rec Words  { a: u64; b: u64; }
rec Mixed  { f: f64; i: i64; }
rec Pair32 { x: f32; y: f32; }
rec Trio64 { x: f64; y: f64; z: f64; }
rec Quad32 { x: f32; y: f32; z: f32; w: f32; }
rec Bytes  { a: u8; b: u8; c: u8; }
rec Large  { a: u64; b: u64; c: u64; d: u64; e: u64; }
rec Odd    { f: f32; i: u16; g: f32; }
rec Id41   { r: [41]u8; }
rec Rec88  { a: [11]u64; }
rec Rec300 { h: u32; b: [296]u8; }

fun small(s: Small) Small {
    ret Small{a: s.b::u32, b: s.a::i32};
}

fun words(w: Words) Words {
    ret Words{a: w.b + 1, b: w.a + 1};
}

fun mixed(m: Mixed) Mixed {
    ret Mixed{f: m.i::f64, i: m.f::i64};
}

fun pair32(p: Pair32) Pair32 {
    ret Pair32{x: p.y, y: p.x};
}

fun trio64(t: Trio64) Trio64 {
    ret Trio64{x: t.z, y: t.x, z: t.y};
}

fun quad32(q: Quad32) Quad32 {
    ret Quad32{x: q.w, y: q.z, z: q.y, w: q.x};
}

fun bytes(b: Bytes) Bytes {
    ret Bytes{a: b.c, b: b.a, c: b.b};
}

fun odd(o: Odd) Odd {
    ret Odd{f: o.g, i: o.i + 1, g: o.f};
}

fun large(l: Large) Large {
    var c: Large = l;
    c.a = l.e;
    c.e = l.a;
    ret c;
}

fun spoil(l: Large) u64 {
    var m: Large = l;
    l.a = 0;
    ret m.a + l.a;
}

# eight records after six integers: the later ones go on the stack
fun many(i1: u64, i2: u64, i3: u64, i4: u64, i5: u64, i6: u64,
    a: Small, b: Mixed, c: Pair32, d: Words, e: Bytes, f: Trio64, g: Large, h: Quad32) f64 {
    val ints: u64 = i1 + i2 + i3 + i4 + i5 + i6 + a.a::u64 + d.a + d.b + e.a::u64 + e.c::u64 + g.a + g.e;
    val fl:   f64 = b.f + c.x::f64 + c.y::f64 + f.x + f.z + h.x::f64 + h.w::f64;
    ret ints::f64 * 1000.0 + fl;
}

# each byte weighted by its place, so a byte moved or lost changes the sum
#[inline("never")]
fun weigh41(a: Id41, b: Id41) u64 {
    var t: u64   = 0;
    var i: usize = 0;
    for (i < 41) {
        t = t + (i + 1)::u64 * a.r[i]::u64 + (i + 100)::u64 * b.r[i]::u64;
        i = i + 1;
    }
    ret t;
}

#[inline("never")]
fun relay41(a: Id41, b: Id41) u64 {
    ret weigh41(a, b);
}

#[inline("never")]
fun weigh88(x: Rec88, k: u64) u64 {
    x.a[3] = k;
    var t: u64   = 0;
    var i: usize = 0;
    for (i < 11) {
        t = t + (i + 1)::u64 * x.a[i];
        i = i + 1;
    }
    ret t;
}

#[inline("never")]
fun relay88(x: Rec88) u64 {
    ret weigh88(x, x.a[3] + 1) + x.a[3];
}

#[inline("never")]
fun weigh300(i1: u64, i2: u64, i3: u64, i4: u64, i5: u64, i6: u64, x: Rec300, y: Id41) u64 {
    var t: u64   = x.h::u64 + i1 + i2 + i3 + i4 + i5 + i6;
    var i: usize = 0;
    for (i < 296) {
        t = t + (i + 1)::u64 * x.b[i]::u64;
        i = i + 1;
    }
    ret t + weigh41(y, y);
}

#[inline("never")]
fun relay300(x: Rec300, y: Id41) u64 {
    ret weigh300(1, 2, 3, 4, 5, 6, x, y);
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val s: Small = small(Small{a: 7, b: -9});
    if (s.a != 0xfffffff7 || s.b != 7) { ret 1; }
    val w: Words = words(Words{a: 0x1_0000_0000, b: 5});
    if (w.a != 6 || w.b != 0x1_0000_0001) { ret 2; }
    val m: Mixed = mixed(Mixed{f: 2.5, i: -4});
    if (m.f != -4.0 || m.i != 2) { ret 3; }
    val p: Pair32 = pair32(Pair32{x: 1.5, y: -2.5});
    if (p.x != -2.5 || p.y != 1.5) { ret 4; }
    val t: Trio64 = trio64(Trio64{x: 1.0, y: 2.0, z: 3.0});
    if (t.x != 3.0 || t.y != 1.0 || t.z != 2.0) { ret 5; }
    val q: Quad32 = quad32(Quad32{x: 1.0, y: 2.0, z: 3.0, w: 4.0});
    if (q.x != 4.0 || q.y != 3.0 || q.z != 2.0 || q.w != 1.0) { ret 6; }
    val b: Bytes = bytes(Bytes{a: 1, b: 2, c: 3});
    if (b.a != 3 || b.b != 1 || b.c != 2) { ret 7; }
    val o: Odd = odd(Odd{f: 0.25, i: 41, g: 0.5});
    if (o.f != 0.5 || o.i != 42 || o.g != 0.25) { ret 8; }
    val big: Large = Large{a: 1, b: 2, c: 3, d: 4, e: 5};
    val l:   Large = large(big);
    if (l.a != 5 || l.b != 2 || l.d != 4 || l.e != 1) { ret 9; }
    if (big.a != 1 || big.e != 5)                     { ret 10; }
    if (spoil(big) != 1 || big.a != 1)                { ret 11; }
    # ints 21 + 7 + 3 + 4 + 1 + 3 + 1 + 5 = 45, floats 2.5 + 1.5 - 2.5 + 1 + 3 + 1 + 4 = 10.5
    val r: f64 = many(1, 2, 3, 4, 5, 6, Small{a: 7, b: 0}, Mixed{f: 2.5, i: 0}, Pair32{x: 1.5, y: -2.5},
        Words{a: 3, b: 4}, Bytes{a: 1, b: 0, c: 3}, Trio64{x: 1.0, y: 0.0, z: 3.0}, big,
        Quad32{x: 1.0, y: 0.0, z: 0.0, w: 4.0});
    if (r != 45010.5) { ret 12; }

    var a41: Id41;
    var b41: Id41;
    var w41: u64   = 0;
    var n:   usize = 0;
    for (n < 41) {
        a41.r[n] = (n * 7 + argc::usize)::u8;
        b41.r[n] = (n * 3 + 1)::u8;
        w41      = w41 + (n + 1)::u64 * a41.r[n]::u64 + (n + 100)::u64 * b41.r[n]::u64;
        n        = n + 1;
    }
    if (relay41(a41, b41) != w41) { ret 13; }

    var x88: Rec88;
    var w88: u64 = 0;
    n = 0;
    for (n < 11) {
        x88.a[n] = (n * 1000 + 5)::u64 + argc::u64;
        n        = n + 1;
    }
    n = 0;
    for (n < 11) {
        var v: u64 = x88.a[n];
        if (n == 3) { v = x88.a[3] + 1; }
        w88 = w88 + (n + 1)::u64 * v;
        n   = n + 1;
    }
    if (relay88(x88) != w88 + x88.a[3]) { ret 14; }
    if (x88.a[3] != 3005 + argc::u64)   { ret 15; }

    var x300: Rec300;
    x300.h = 77 + argc::u32;
    var w300: u64 = x300.h::u64 + 21;
    n = 0;
    for (n < 296) {
        x300.b[n] = (n * 13 + 5)::u8;
        w300      = w300 + (n + 1)::u64 * x300.b[n]::u64;
        n         = n + 1;
    }
    var wy: u64 = 0;
    n = 0;
    for (n < 41) {
        wy = wy + (n + 1)::u64 * a41.r[n]::u64 + (n + 100)::u64 * a41.r[n]::u64;
        n  = n + 1;
    }
    if (relay300(x300, a41) != w300 + wy) { ret 16; }
    ret 0;
}
