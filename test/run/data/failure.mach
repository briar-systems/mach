use std.runtime;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;

# the std failure tags, which are ordinary generic tags: a function that can fail returns
# one, the caller tests the case and exits, and the exiting chain guards the success
# payload for the rest of the block. a zeroed res is its err case and a zeroed opt is none.

tag Bad: u8 { empty; range: u64; }

fun digit(c: u8) res[u64, Bad] {
    if (c < '0' || c > '9') { ret res[u64, Bad].err{Bad.range{c::u64}}; }
    ret res[u64, Bad].ok{(c - '0')::u64};
}

fun number(s: *u8) res[u64, Bad] {
    if (s[0] == 0) { ret res[u64, Bad].err{Bad.empty{}}; }
    var n: u64 = 0;
    var i: u64 = 0;
    for (s[i] != 0) {
        val d: res[u64, Bad] = digit(s[i]);
        if (sel d.err) { ret res[u64, Bad].err{d.err}; }
        n = n * 10 + d.ok;
        i = i + 1;
    }
    ret res[u64, Bad].ok{n};
}

fun find(xs: *u32, n: u64, want: u32) opt[u64] {
    var i: u64 = 0;
    for (i < n) {
        if (xs[i] == want) { ret opt[u64].some{i}; }
        i = i + 1;
    }
    ret opt[u64].none{};
}

fun check(v: u64) err[Bad] {
    if (v > 100) { ret err[Bad].err{Bad.range{v}}; }
    ret err[Bad].ok{};
}

fun bad_char(r: res[u64, Bad]) u64 {
    if (sel r.ok) { ret 0; }
    if (sel r.err.range) { ret r.err.range; }
    ret 1;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val a: res[u64, Bad] = number("4096");
    if (sel a.err)                       { ret 1; }
    if (a.ok != 4096)                    { ret 2; }
    if (bad_char(number("12x4")) != 'x') { ret 3; }
    if (bad_char(number("")) != 1)       { ret 4; }

    var xs: [4]u32 = [4]u32{5, 9, 2, 9};
    val at: opt[u64] = find(?xs[0], 4, 9);
    if (!(sel at.some && at.some == 1))  { ret 5; }
    val gone: opt[u64] = find(?xs[0], 4, 7);
    if (!(sel gone.none))                { ret 6; }

    val fine: err[Bad] = check(50);
    if (sel fine.err)                    { ret 7; }
    val e: err[Bad] = check(500);
    if (sel e.ok)                        { ret 8; }
    if (bad_char(res[u64, Bad].err{e.err}) != 500) { ret 9; }

    var zr: res[u64, Bad];
    var zo: opt[u8];
    if (!(sel zr.err) || !(sel zo.none)) { ret 10; }
    ret 0;
}
