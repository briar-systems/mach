use std.runtime;
use std.types.size.usize;

# a pointer `val` from an integer address at module scope, as a memory-mapped device is
# named: its slot holds the address, and a use in code reads the same number, a volatile
# record's pointer included. nothing is dereferenced

#[volatile]
rec Fb {
    status: u32;
    px:     [4]u32;
}

val FB:   *Fb  = 0xB8000::*Fb;
val BYTE: *u8  = 0x1234::*u8;
val TOP:  *u64 = 0xFFFF_0000::*u64;

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    if (FB::usize != 0xB8000)           { ret 1; }
    if (BYTE::usize != 0x1234)          { ret 2; }
    if (TOP::usize != 0xFFFF_0000)      { ret 3; }
    if ((@(?FB))::usize != 0xB8000)     { ret 4; }
    if ((@(?BYTE))::usize != 0x1234)    { ret 5; }
    if ((?FB.px[1])::usize != 0xB8008)  { ret 6; }
    ret 0;
}
