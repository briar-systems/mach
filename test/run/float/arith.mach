use std.runtime;

# the float operators at both widths: exact results where the operands allow them, and the
# round-to-nearest-even result where they do not, read back as bits so f32 work done in f64
# (or the reverse) shows. `%` is the truncated remainder with the dividend's sign.

fun f32s(a: f32, b: f32, one: f32, ten: f32) i64 {
    if (a + b != 3.75)   { ret 1; }
    if (a * b != 3.375)  { ret 2; }
    if (b - a != 0.75)   { ret 3; }
    if (b / a != 1.5)    { ret 4; }
    if (-a != -1.5)      { ret 5; }
    if (5.5 % b != 1.0)  { ret 6; }
    if (-5.5 % b != -1.0) { ret 7; }
    val tenth: f32 = one / ten;
    if (tenth:~u32 != 0x3dcccccd)                     { ret 8; }
    if ((tenth + tenth + tenth / 2.0 * 2.0):~u32 != 0x3e99999a) { ret 9; }
    if ((one / 3.0):~u32 != 0x3eaaaaab)               { ret 10; }
    # 2^24 + 1 is not an f32: the sum rounds back to 2^24
    if (16777216.0 + one != 16777216.0)               { ret 11; }
    if (!(a < b) || a >= b || !(b > a) || !(a <= a))  { ret 12; }
    ret 0;
}

fun f64s(a: f64, b: f64, one: f64, ten: f64) i64 {
    if (a + b != 3.75)   { ret 21; }
    if (a * b != 3.375)  { ret 22; }
    if (b - a != 0.75)   { ret 23; }
    if (b / a != 1.5)    { ret 24; }
    if (-a != -1.5)      { ret 25; }
    if (5.5 % b != 1.0)  { ret 26; }
    if (-5.5 % b != -1.0) { ret 27; }
    val tenth: f64 = one / ten;
    if ((tenth + (tenth + tenth)):~u64 != 0x3fd3333333333334) { ret 28; }
    if ((one / 3.0):~u64 != 0x3fd5555555555555)       { ret 29; }
    if (16777216.0 + one != 16777217.0)               { ret 30; }
    if (9007199254740992.0 + one != 9007199254740992.0) { ret 31; }
    if (!(a < b) || a >= b || !(b > a) || !(a <= a))  { ret 32; }
    ret 0;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val r: i64 = f32s(1.5, 2.25, 1.0, 10.0);
    if (r != 0) { ret r; }
    ret f64s(1.5, 2.25, 1.0, 10.0);
}
