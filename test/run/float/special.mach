use std.runtime;

# infinities, NaN and signed zero, made at run time from a zero parameter: a NaN is unequal
# to everything and unordered, -0 equals +0 with its own bits, and `%` follows C fmod.

fun f64s(z: f64, one: f64) i64 {
    val inf: f64 = one / z;
    val ninf: f64 = -one / z;
    val nan: f64 = z / z;
    val nz: f64 = -z;
    if (inf:~u64 != 0x7ff0000000000000)  { ret 1; }
    if (ninf:~u64 != 0xfff0000000000000) { ret 2; }
    if (nan == nan)                      { ret 3; }
    if (!(nan != nan))                   { ret 4; }
    if (nan < one || nan > one || nan <= one || nan >= one) { ret 5; }
    if (nz != z)                         { ret 6; }
    if (nz:~u64 != 0x8000000000000000)   { ret 7; }
    if (!(inf > 1.7976931348623157e308)) { ret 8; }
    if (inf + ninf == inf + ninf)        { ret 9; }
    if (5.5 % inf != 5.5)                { ret 10; }
    val r: f64 = one % z;
    if (r == r)                          { ret 11; }
    if ((one / ninf):~u64 != 0x8000000000000000) { ret 12; }
    ret 0;
}

fun f32s(z: f32, one: f32) i64 {
    val inf: f32 = one / z;
    val nan: f32 = z / z;
    if (inf:~u32 != 0x7f800000)          { ret 21; }
    if (nan == nan)                      { ret 22; }
    if ((-z):~u32 != 0x80000000)         { ret 23; }
    # the largest f32 doubled overflows to infinity
    val max: f32 = 3.4028234663852886e38;
    if ((max * (one + one)):~u32 != 0x7f800000) { ret 24; }
    # the smallest subnormal halved rounds to zero, and the smallest normal halved is subnormal
    val tiny: f32 = 0x1:~f32;
    if (tiny / (one + one) != 0.0)       { ret 25; }
    if ((0x00800000:~f32 / (one + one)):~u32 != 0x00400000) { ret 26; }
    ret 0;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val r: i64 = f64s(0.0, 1.0);
    if (r != 0) { ret r; }
    ret f32s(0.0, 1.0);
}
