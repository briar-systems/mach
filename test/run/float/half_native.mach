# targets: linux-riscv64
use std.runtime;
use std.types.bool.bool;

# f16 under `#[extension("zfh")]` on a build that does not select zfh: the function computes in
# binary16 natively (linux-riscv64's dump rule holds `corpus_half_native` to fdiv.h, fmul.h and
# fadd.h in its frame), and gives the bits the build's own f16, computed through binary32, gives,
# at a rounding tie, past the largest finite value, at the smallest subnormal and for a nan

#[extension("zfh")]
#[symbol("corpus_half_native")]
fun native(a: f16, b: f16) f16 {
    ret a / b + a * b;
}

fun widened(a: f16, b: f16) f16 {
    ret a / b + a * b;
}

fun same(a: f16, b: f16) bool {
    ret native(a, b):~u16 == widened(a, b):~u16;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val one: f16 = argc::f16;
    if (native(one, 3.0):~u16 != 0x42ab || !same(one, 3.0)) { ret 1; }
    if (native(65504.0, one * 2.0):~u16 != 0x7c00 || !same(65504.0, one * 2.0)) { ret 2; }
    val tiny: f16 = 0x0001u16:~f16;
    if (native(tiny, one * 2.0):~u16 != 0x0002 || !same(tiny, one * 2.0)) { ret 3; }
    if (native(tiny, one):~u16 != 0x0002 || !same(tiny, one)) { ret 4; }
    val nan: f16 = (one - one) / (one - one);
    if (native(nan, one) == native(nan, one)) { ret 5; }
    if (native(-2.0, 0.5 * one):~u16 != widened(-2.0, 0.5 * one):~u16) { ret 6; }
    ret 0;
}
