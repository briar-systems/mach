use std.runtime;

# conversions between floats and integers. float to integer truncates toward zero and, at
# run time, saturates: below the minimum gives the minimum, above the maximum the maximum,
# NaN gives 0. integer to float rounds to nearest even. f64 to f32 rounds once, f32 to f64
# is exact, and `:~` moves bits without converting.

fun to_int(p: f64, n: f64, s: f32, z: f64) i64 {
    if (p::u8 != 40 || p::i8 != 40 || p::u16 != 40 || p::i16 != 40) { ret 1; }
    if (p::u32 != 40 || p::i32 != 40 || p::u64 != 40 || p::i64 != 40) { ret 2; }
    if (n::i8 != -40 || n::i16 != -40 || n::i32 != -40 || n::i64 != -40) { ret 3; }
    if (s::u8 != 40 || s::i64 != 40 || (-s)::i32 != -40)  { ret 4; }
    if ((p - 40.75 + 0.9999)::i32 != 0 || (n + 40.75 - 0.9999)::i32 != 0) { ret 5; }
    # saturation
    if ((p * 10.0)::u8 != 255 || (n * 10.0)::i8 != -128)  { ret 6; }
    if (n::u32 != 0 || n::u64 != 0)                       { ret 7; }
    if ((p * 1.0e20)::i64 != 9223372036854775807)        { ret 8; }
    if ((n * 1.0e20)::i64 != -9223372036854775807 - 1)   { ret 9; }
    if ((p * 1.0e30)::u64 != 0xffffffffffffffff)         { ret 10; }
    if ((z / z)::i32 != 0 || (z / z)::u64 != 0)          { ret 11; }
    # above 2^63 and 2^31, where a signed conversion alone cannot answer
    if ((9223372036854777856.0 + z)::u64 != 9223372036854777856) { ret 12; }
    if ((3000000000.0 + z)::u32 != 3000000000)           { ret 13; }
    if ((s * 1.0e9)::u32 != 0xffffffff)                  { ret 14; }
    ret 0;
}

fun to_float(m: u64, k: i64, q: u32, b: i8) i64 {
    if (m::f64 != 18446744073709551616.0)                { ret 21; }
    if (k::f64 != -1.0 || k::f32 != -1.0)               { ret 22; }
    # 2^24 + 1 rounds to 2^24 in f32 and is exact in f64
    if (q::f32 != 16777216.0 || q::f64 != 16777217.0)   { ret 23; }
    if (b::f64 != -128.0 || (b::u8)::f32 != 128.0)      { ret 24; }
    if ((m >> 11)::f64 != 9007199254740991.0)           { ret 25; }
    ret 0;
}

fun widths(one: f64, ten: f64) i64 {
    val tenth: f64 = one / ten;
    val t32: f32 = tenth::f32;
    if (t32:~u32 != 0x3dcccccd)                    { ret 31; }
    if (t32::f64:~u64 != 0x3fb99999a0000000)       { ret 32; }
    if ((one * 1.0e300)::f32:~u32 != 0x7f800000)   { ret 33; }
    if (0x3ff8000000000000:~f64 != 1.5)            { ret 34; }
    if ((-one):~u64 != 0xbff0000000000000)         { ret 35; }
    if ((one::f32):~i32 != 0x3f800000)             { ret 36; }
    ret 0;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var r: i64 = to_int(40.75, -40.75, 40.75, 0.0);
    if (r != 0) { ret r; }
    r = to_float(0xffffffffffffffff, -1, 16777217, -128);
    if (r != 0) { ret r; }
    ret widths(1.0, 10.0);
}
