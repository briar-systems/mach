# targets: linux-x86_64-optimized
use std.runtime;

# a float of either width held across a call, which leaves no float register as it was, so each is spilled
# before it and reloaded after it. a float is its register's low bits alone, so its slot and both moves take its
# own bytes, 8 for a binary64 and 4 for a binary32, not the 16 of the whole register, and the value read back is
# the one stored.

#[inline("never")]
fun scaled(x: f64) f64 {
    ret x * 3.0;
}

#[inline("never")]
fun halved(x: f32) f32 {
    ret x / 2.0;
}

#[inline("never")]
#[symbol("corpus_spill_f64")]
fun mixed(a: f64, b: f64, c: f32) f64 {
    val x: f64 = scaled(a);
    val y: f32 = halved(c);
    val z: f64 = scaled(b);
    ret a * x + b * z + (c * y)::f64;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val r: f64 = mixed(1.5, 2.0, 4.0);
    # 1.5 * 4.5 + 2.0 * 6.0 + 4.0 * 2.0
    if (r != 26.75) { ret 1; }
    ret 0;
}
