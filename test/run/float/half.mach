use std.runtime;

# f16 (IEEE binary16) on every target, with or without half-precision hardware: each
# operation is rounded once to binary16, conversions round to nearest even, and a
# comparison against a wider float relates the exact values.

fun ops(one: f16, three: f16, max: f16, d: f64, n: u32) i64 {
    val third: f16 = one / three;
    if (third:~u16 != 0x3555)                     { ret 1; }
    if ((one + one / (one + one)) * (one + one) + 0.25 != 3.25) { ret 2; }
    if ((max + max):~u16 != 0x7c00)               { ret 3; }
    if ((5.5f16 + (one - one)) % three != 2.5)     { ret 4; }
    if (!(third < 0.3333333333333333f64))         { ret 5; }
    if ((-third):~u16 != 0xb555)                  { ret 6; }
    if ((d / 10.0)::f16:~u16 != 0x2e66)           { ret 7; }
    if (third::f64 != 0.333251953125)             { ret 8; }
    # 2049 lies halfway between 2048 and 2050: ties go to the even 2048; 2051 goes to 2052
    if (n::f16 != 2048.0 || (n + 2)::f16 != 2052.0) { ret 9; }
    if ((-(three - 0.25))::i32 != -2)             { ret 10; }
    if ((n * 40)::f16:~u16 != 0x7c00)             { ret 11; }
    ret 0;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    ret ops(1.0, 3.0, 65504.0, 1.0, 2049);
}
