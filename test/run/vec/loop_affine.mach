# reports: vectorise loop_affine.loop_affine.matmul_f32 1; vectorise loop_affine.loop_affine.rows_add 1; vectorise loop_affine.loop_affine.offset_xor 1; vectorise loop_affine.loop_affine.below_xor 1; vectorise loop_affine.loop_affine.self_update 1; vectorise loop_affine.loop_affine.copy_global 1; vectorise loop_affine.loop_affine.copy_offset 1; vectorise loop_affine.loop_affine.fill_at 1; vectorise loop_affine.loop_affine.stencil 1
use std.runtime;
use std.types.size.usize;

# loops whose element indices are the stepping parameter plus a part the loop does not define: a flat two-dimensional
# product over globals, rows of two pointers a run-time distance apart, a stream read at a run-time or constant offset
# from the one it writes, a stream updated in place at an offset, a copy from an offset source and a fill at an offset,
# and a strided read the vectoriser leaves alone. each is checked against a twin the vectoriser leaves alone at every
# size around the lane counts, and where two streams share an array at every distance either way, so a wrong origin
# or a wrong decision about overlap changes the result.

val SIZE: usize = 256;

var MA: [576]f32;
var MB: [576]f32;
var MO: [576]f32;
var MT: [576]f32;

var SRC: [256]u8;
var DST: [256]u8;
var TWN: [256]u8;

# a flat product: rows of `c` columns, the inner index `i * c + j`
#[inline("never")]
fun matmul_f32(m: usize, kk: usize, c: usize) {
    var i: usize = 0;
    for (i < m) {
        var k: usize = 0;
        for (k < kk) {
            val aik: f32   = MA[i * kk + k];
            var j:   usize = 0;
            for (j < c) {
                MO[i * c + j] = MO[i * c + j] + aik * MB[k * c + j];
                j             = j + 1;
            }
            k = k + 1;
        }
        i = i + 1;
    }
}

#[inline("never")]
#[vectorize("never")]
fun twin_matmul(m: usize, kk: usize, c: usize) {
    var i: usize = 0;
    for (i < m) {
        var k: usize = 0;
        for (k < kk) {
            val aik: f32   = MA[i * kk + k];
            var j:   usize = 0;
            for (j < c) {
                MT[i * c + j] = MT[i * c + j] + aik * MB[k * c + j];
                j             = j + 1;
            }
            k = k + 1;
        }
        i = i + 1;
    }
}

# rows of two pointers, whose distance is the same on every row
#[inline("never")]
fun rows_add(d: *u32, s: *u32, rows: usize, cols: usize, w: usize) {
    var r: usize = 0;
    for (r < rows) {
        var j: usize = 0;
        for (j < cols) {
            d[r * w + j] = s[r * w + j] + 5;
            j            = j + 1;
        }
        r = r + 1;
    }
}

#[inline("never")]
#[vectorize("never")]
fun twin_rows_add(d: *u32, s: *u32, rows: usize, cols: usize, w: usize) {
    var r: usize = 0;
    for (r < rows) {
        var j: usize = 0;
        for (j < cols) {
            d[r * w + j] = s[r * w + j] + 5;
            j            = j + 1;
        }
        r = r + 1;
    }
}

# one array read at a run-time offset from where it is written
#[inline("never")]
fun offset_xor(a: *u32, off: i64, k: u32, n: i64) {
    var i: i64 = 0;
    for (i < n) {
        a[i] = a[i + off] ^ k;
        i    = i + 1;
    }
}

#[inline("never")]
#[vectorize("never")]
fun twin_offset_xor(a: *u32, off: i64, k: u32, n: i64) {
    var i: i64 = 0;
    for (i < n) {
        a[i] = a[i + off] ^ k;
        i    = i + 1;
    }
}

# one array read three elements past where it is written, which no lane reads after an earlier one wrote
#[inline("never")]
fun below_xor(a: *u32, k: u32, n: usize) {
    var i: usize = 0;
    for (i < n) {
        a[i] = a[i + 3] ^ k;
        i    = i + 1;
    }
}

#[inline("never")]
#[vectorize("never")]
fun twin_below_xor(a: *u32, k: u32, n: usize) {
    var i: usize = 0;
    for (i < n) {
        a[i] = a[i + 3] ^ k;
        i    = i + 1;
    }
}

# one array read three elements below where it is written, which every vector would read before an earlier lane wrote
#[inline("never")]
fun above_xor(a: *u32, k: u32, n: usize) {
    var i: usize = 0;
    for (i < n) {
        a[i + 3] = a[i] ^ k;
        i        = i + 1;
    }
}

#[inline("never")]
#[vectorize("never")]
fun twin_above_xor(a: *u32, k: u32, n: usize) {
    var i: usize = 0;
    for (i < n) {
        a[i + 3] = a[i] ^ k;
        i        = i + 1;
    }
}

# a stream updated in place at an offset
#[inline("never")]
fun self_update(a: *u32, off: usize, k: u32, n: usize) {
    var i: usize = 0;
    for (i < n) {
        a[i + off] = (a[i + off] ^ k) + 7;
        i          = i + 1;
    }
}

#[inline("never")]
#[vectorize("never")]
fun twin_self_update(a: *u32, off: usize, k: u32, n: usize) {
    var i: usize = 0;
    for (i < n) {
        a[i + off] = (a[i + off] ^ k) + 7;
        i          = i + 1;
    }
}

# a copy between two globals from an offset source
#[inline("never")]
fun copy_global(off: usize, n: usize) {
    var i: usize = 0;
    for (i < n) {
        DST[i] = SRC[i + off];
        i      = i + 1;
    }
}

#[inline("never")]
#[vectorize("never")]
fun twin_copy_global(off: usize, n: usize) {
    var i: usize = 0;
    for (i < n) {
        TWN[i] = SRC[i + off];
        i      = i + 1;
    }
}

# a copy within one array from a run-time offset
#[inline("never")]
fun copy_offset(a: *u16, off: i64, n: i64) {
    var i: i64 = 0;
    for (i < n) {
        a[i] = a[i + off];
        i    = i + 1;
    }
}

#[inline("never")]
#[vectorize("never")]
fun twin_copy_offset(a: *u16, off: i64, n: i64) {
    var i: i64 = 0;
    for (i < n) {
        a[i] = a[i + off];
        i    = i + 1;
    }
}

# a fill at an offset
#[inline("never")]
fun fill_at(d: *u8, off: usize, x: u8, n: usize) {
    var i: usize = 0;
    for (i < n) {
        d[i + off] = x;
        i          = i + 1;
    }
}

# a strided read, which no unit serves as one access, so the loop stays scalar
#[inline("never")]
fun strided(d: *u32, s: *u32, n: usize) {
    var i: usize = 0;
    for (i < n) {
        d[i] = s[i * 2] + 1;
        i    = i + 1;
    }
}

#[inline("never")]
#[vectorize("never")]
fun twin_strided(d: *u32, s: *u32, n: usize) {
    var i: usize = 0;
    for (i < n) {
        d[i] = s[i * 2] + 1;
        i    = i + 1;
    }
}

# a three point stencil, whose `s[i + 1]` reads the step `i + 1` the branch back also passes
#[inline("never")]
fun stencil(d: *u32, s: *u32, n: usize) {
    var i: usize = 1;
    for (i < n) {
        d[i] = (s[i - 1] + s[i]) + s[i + 1];
        i    = i + 1;
    }
}

#[inline("never")]
#[vectorize("never")]
fun twin_stencil(d: *u32, s: *u32, n: usize) {
    var i: usize = 1;
    for (i < n) {
        d[i] = (s[i - 1] + s[i]) + s[i + 1];
        i    = i + 1;
    }
}

fun seed_u32(a: *u32, b: *u32) {
    var i: usize = 0;
    for (i < SIZE) {
        val x: u32 = (i::u32 * 2654435761) ^ 0x5bd1e995;
        a[i] = x;
        b[i] = x;
        i    = i + 1;
    }
}

fun same_u32(a: *u32, b: *u32) u8 {
    var i: usize = 0;
    for (i < SIZE) {
        if (a[i] != b[i]) { ret 0; }
        i = i + 1;
    }
    ret 1;
}

fun seed_u16(a: *u16, b: *u16) {
    var i: usize = 0;
    for (i < SIZE) {
        val x: u16 = ((i * 40503 + 7) & 0xffff)::u16;
        a[i] = x;
        b[i] = x;
        i    = i + 1;
    }
}

fun same_u16(a: *u16, b: *u16) u8 {
    var i: usize = 0;
    for (i < SIZE) {
        if (a[i] != b[i]) { ret 0; }
        i = i + 1;
    }
    ret 1;
}

fun seed_matrices() {
    var i: usize = 0;
    for (i < 576) {
        MA[i] = ((i * 7) % 13)::f32 - 6.0;
        MB[i] = ((i * 5) % 11)::f32 * 0.5;
        MO[i] = (i % 9)::f32;
        MT[i] = (i % 9)::f32;
        i     = i + 1;
    }
}

fun same_matrices() u8 {
    var i: usize = 0;
    for (i < 576) {
        if (MO[i]:~u32 != MT[i]:~u32) { ret 0; }
        i = i + 1;
    }
    ret 1;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var a: [256]u32;
    var b: [256]u32;
    var h: [256]u16;
    var g: [256]u16;
    var p: [256]u8;
    # the flat product at every row width to 24 and one to three rows
    var c: usize = 0;
    for (c <= 24) {
        var m: usize = 1;
        for (m <= 3) {
            seed_matrices();
            matmul_f32(m, 4, c);
            twin_matmul(m, 4, c);
            if (same_matrices() == 0) { ret 1; }
            m = m + 1;
        }
        c = c + 1;
    }
    # rows of every width to 40 in an array of rows 41 wide, the destination 0 to 50 elements past the source or below
    var cols: usize = 0;
    for (cols <= 40) {
        var k: usize = 0;
        for (k <= 100) {
            seed_u32(?a[0], ?b[0]);
            rows_add(?a[k], ?a[50], 3, cols, 41);
            twin_rows_add(?b[k], ?b[50], 3, cols, 41);
            if (same_u32(?a[0], ?b[0]) == 0) { ret 3; }
            k = k + 1;
        }
        cols = cols + 1;
    }
    # a run-time offset from 40 below to 40 above, every length to 70, from an odd start
    var n: i64 = 0;
    for (n <= 70) {
        var off: i64 = -40;
        for (off <= 40) {
            seed_u32(?a[0], ?b[0]);
            offset_xor(?a[83], off, (argc + 0x5a5a)::u32, n);
            twin_offset_xor(?b[83], off, (argc + 0x5a5a)::u32, n);
            if (same_u32(?a[0], ?b[0]) == 0) { ret 4; }
            seed_u16(?h[0], ?g[0]);
            copy_offset(?h[83], off, n);
            twin_copy_offset(?g[83], off, n);
            if (same_u16(?h[0], ?g[0]) == 0) { ret 5; }
            off = off + 1;
        }
        n = n + 1;
    }
    # constant offsets either way, an offset stream updated in place, a strided read, a stencil written 6 elements
    # below its source to 6 above
    var len: usize = 0;
    for (len <= 70) {
        seed_u32(?a[0], ?b[0]);
        below_xor(?a[5], argc::u32 + 9, len);
        twin_below_xor(?b[5], argc::u32 + 9, len);
        if (same_u32(?a[0], ?b[0]) == 0) { ret 6; }
        seed_u32(?a[0], ?b[0]);
        above_xor(?a[5], argc::u32 + 9, len);
        twin_above_xor(?b[5], argc::u32 + 9, len);
        if (same_u32(?a[0], ?b[0]) == 0) { ret 7; }
        var off: usize = 0;
        for (off <= 9) {
            seed_u32(?a[0], ?b[0]);
            self_update(?a[1], off, argc::u32 + 0x3c, len);
            twin_self_update(?b[1], off, argc::u32 + 0x3c, len);
            if (same_u32(?a[0], ?b[0]) == 0) { ret 8; }
            off = off + 1;
        }
        seed_u32(?a[0], ?b[0]);
        strided(?a[150], ?a[3], len);
        twin_strided(?b[150], ?b[3], len);
        if (same_u32(?a[0], ?b[0]) == 0) { ret 9; }
        var k: usize = 0;
        for (k <= 12) {
            seed_u32(?a[0], ?b[0]);
            stencil(?a[k + 94], ?a[100], len);
            twin_stencil(?b[k + 94], ?b[100], len);
            if (same_u32(?a[0], ?b[0]) == 0) { ret 12; }
            k = k + 1;
        }
        len = len + 1;
    }
    # a copy from an offset source between globals and a fill at an offset, every length to 70
    var i: usize = 0;
    for (i < 256) {
        SRC[i] = ((i * 37 + 11) & 0xff)::u8;
        i      = i + 1;
    }
    len = 0;
    for (len <= 70) {
        var off: usize = 0;
        for (off <= 40) {
            i = 0;
            for (i < 256) {
                DST[i] = 0;
                TWN[i] = 0;
                p[i]   = SRC[i];
                i      = i + 1;
            }
            copy_global(off, len);
            twin_copy_global(off, len);
            fill_at(?p[3], off, (argc + 0xc1)::u8, len);
            i = 0;
            for (i < 256) {
                if (DST[i] != TWN[i]) { ret 10; }
                var want: u8 = SRC[i];
                if (i >= 3 + off && i < 3 + off + len) { want = (argc + 0xc1)::u8; }
                if (p[i] != want)                      { ret 11; }
                i = i + 1;
            }
            off = off + 1;
        }
        len = len + 1;
    }
    ret 0;
}
