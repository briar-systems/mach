# targets: linux-aarch64 linux-riscv64-v linux-riscv64-v-optimized
# flags:   --set simd=require
use std.runtime;
use std.types.size.usize;

# shifts of 8-, 16-, 32- and 64-bit lanes by a count per lane, built under `simd = "require"`,
# which refuses any vector operation taken lane by lane, each lane checked against the
# shift the ir states over every pair of an edge value and an edge count: 0, 1, W-1, W, W+1,
# all ones, 2W and the sign bit alone, read unsigned, so a count of W or more gives zero, or
# the sign fill for an arithmetic right shift. riscv64 with v takes the count modulo W and
# clears or fills the lanes past it with no mask register

val VALUE8: [8]u8 = [8]u8{0x0, 0x1, 0xff, 0x80, 0x7f, 0x2, 0x81, 0x7e};
val COUNT8: [8]u8 = [8]u8{0x0, 0x1, 0x7, 0x8, 0x9, 0xff, 0x10, 0x80};
val VALUE16: [8]u16 = [8]u16{0x0, 0x1, 0xffff, 0x8000, 0x7fff, 0x2, 0x8001, 0x7ffe};
val COUNT16: [8]u16 = [8]u16{0x0, 0x1, 0xf, 0x10, 0x11, 0xffff, 0x20, 0x8000};
val VALUE32: [8]u32 = [8]u32{0x0, 0x1, 0xffffffff, 0x80000000, 0x7fffffff, 0x2, 0x80000001, 0x7ffffffe};
val COUNT32: [8]u32 = [8]u32{0x0, 0x1, 0x1f, 0x20, 0x21, 0xffffffff, 0x40, 0x80000000};
val VALUE64: [8]u64 = [8]u64{0x0, 0x1, 0xffffffffffffffff, 0x8000000000000000, 0x7fffffffffffffff, 0x2, 0x8000000000000001, 0x7ffffffffffffffe};
val COUNT64: [8]u64 = [8]u64{0x0, 0x1, 0x3f, 0x40, 0x41, 0xffffffffffffffff, 0x80, 0x8000000000000000};

fun shl8(a: u8x16, c: u8x16) u8x16 {
    ret a << c;
}

fun shr8(a: u8x16, c: u8x16) u8x16 {
    ret a >> c;
}

#[symbol("corpus_lanes_sar8")]
fun sar8(a: i8x16, c: i8x16) i8x16 {
    ret a >> c;
}

fun shl16(a: u16x8, c: u16x8) u16x8 {
    ret a << c;
}

fun shr16(a: u16x8, c: u16x8) u16x8 {
    ret a >> c;
}

fun sar16(a: i16x8, c: i16x8) i16x8 {
    ret a >> c;
}

fun shl32(a: u32x4, c: u32x4) u32x4 {
    ret a << c;
}

fun shr32(a: u32x4, c: u32x4) u32x4 {
    ret a >> c;
}

fun sar32(a: i32x4, c: i32x4) i32x4 {
    ret a >> c;
}

fun shl64(a: u64x2, c: u64x2) u64x2 {
    ret a << c;
}

fun shr64(a: u64x2, c: u64x2) u64x2 {
    ret a >> c;
}

fun sar64(a: i64x2, c: i64x2) i64x2 {
    ret a >> c;
}

# 0 where every shift of 8-bit lanes matches the shift the ir states, else the failing code
fun pairs8(argc: i64, code: i64) i64 {
    val flip: u8 = (argc - 1)::u8;
    var c: usize = 0;
    for (c < 64) {
        var pa: [16]u8;
        var pc: [16]u8;
        var k: usize = 0;
        for (k < 16) {
            pa[k] = VALUE8[(c + k) / 8] ^ flip;
            pc[k] = COUNT8[(c + k) % 8] ^ flip;
            k = k + 1;
        }
        val l: [16]u8 = shl8(pa:~u8x16, pc:~u8x16):~[16]u8;
        val r: [16]u8 = shr8(pa:~u8x16, pc:~u8x16):~[16]u8;
        val s: [16]i8 = sar8(pa:~i8x16, pc:~i8x16):~[16]i8;
        k = 0;
        for (k < 16) {
            val x: u8 = pa[k];
            val n: u8 = pc[k];
            var wl: u8 = 0;
            var wr: u8 = 0;
            var ws: i8 = x:~i8 >> 7;
            if (n < 8) {
                wl = x << n;
                wr = x >> n;
                ws = x:~i8 >> n:~i8;
            }
            if (l[k] != wl) { ret code; }
            if (r[k] != wr) { ret code + 1; }
            if (s[k] != ws) { ret code + 2; }
            k = k + 1;
        }
        c = c + 16;
    }
    ret 0;
}

# 0 where every shift of 16-bit lanes matches the shift the ir states, else the failing code
fun pairs16(argc: i64, code: i64) i64 {
    val flip: u16 = (argc - 1)::u16;
    var c: usize = 0;
    for (c < 64) {
        var pa: [8]u16;
        var pc: [8]u16;
        var k: usize = 0;
        for (k < 8) {
            pa[k] = VALUE16[(c + k) / 8] ^ flip;
            pc[k] = COUNT16[(c + k) % 8] ^ flip;
            k = k + 1;
        }
        val l: [8]u16 = shl16(pa:~u16x8, pc:~u16x8):~[8]u16;
        val r: [8]u16 = shr16(pa:~u16x8, pc:~u16x8):~[8]u16;
        val s: [8]i16 = sar16(pa:~i16x8, pc:~i16x8):~[8]i16;
        k = 0;
        for (k < 8) {
            val x: u16 = pa[k];
            val n: u16 = pc[k];
            var wl: u16 = 0;
            var wr: u16 = 0;
            var ws: i16 = x:~i16 >> 15;
            if (n < 16) {
                wl = x << n;
                wr = x >> n;
                ws = x:~i16 >> n:~i16;
            }
            if (l[k] != wl) { ret code; }
            if (r[k] != wr) { ret code + 1; }
            if (s[k] != ws) { ret code + 2; }
            k = k + 1;
        }
        c = c + 8;
    }
    ret 0;
}

# 0 where every shift of 32-bit lanes matches the shift the ir states, else the failing code
fun pairs32(argc: i64, code: i64) i64 {
    val flip: u32 = (argc - 1)::u32;
    var c: usize = 0;
    for (c < 64) {
        var pa: [4]u32;
        var pc: [4]u32;
        var k: usize = 0;
        for (k < 4) {
            pa[k] = VALUE32[(c + k) / 8] ^ flip;
            pc[k] = COUNT32[(c + k) % 8] ^ flip;
            k = k + 1;
        }
        val l: [4]u32 = shl32(pa:~u32x4, pc:~u32x4):~[4]u32;
        val r: [4]u32 = shr32(pa:~u32x4, pc:~u32x4):~[4]u32;
        val s: [4]i32 = sar32(pa:~i32x4, pc:~i32x4):~[4]i32;
        k = 0;
        for (k < 4) {
            val x: u32 = pa[k];
            val n: u32 = pc[k];
            var wl: u32 = 0;
            var wr: u32 = 0;
            var ws: i32 = x:~i32 >> 31;
            if (n < 32) {
                wl = x << n;
                wr = x >> n;
                ws = x:~i32 >> n:~i32;
            }
            if (l[k] != wl) { ret code; }
            if (r[k] != wr) { ret code + 1; }
            if (s[k] != ws) { ret code + 2; }
            k = k + 1;
        }
        c = c + 4;
    }
    ret 0;
}

# 0 where every shift of 64-bit lanes matches the shift the ir states, else the failing code
fun pairs64(argc: i64, code: i64) i64 {
    val flip: u64 = (argc - 1)::u64;
    var c: usize = 0;
    for (c < 64) {
        var pa: [2]u64;
        var pc: [2]u64;
        var k: usize = 0;
        for (k < 2) {
            pa[k] = VALUE64[(c + k) / 8] ^ flip;
            pc[k] = COUNT64[(c + k) % 8] ^ flip;
            k = k + 1;
        }
        val l: [2]u64 = shl64(pa:~u64x2, pc:~u64x2):~[2]u64;
        val r: [2]u64 = shr64(pa:~u64x2, pc:~u64x2):~[2]u64;
        val s: [2]i64 = sar64(pa:~i64x2, pc:~i64x2):~[2]i64;
        k = 0;
        for (k < 2) {
            val x: u64 = pa[k];
            val n: u64 = pc[k];
            var wl: u64 = 0;
            var wr: u64 = 0;
            var ws: i64 = x:~i64 >> 63;
            if (n < 64) {
                wl = x << n;
                wr = x >> n;
                ws = x:~i64 >> n:~i64;
            }
            if (l[k] != wl) { ret code; }
            if (r[k] != wr) { ret code + 1; }
            if (s[k] != ws) { ret code + 2; }
            k = k + 1;
        }
        c = c + 2;
    }
    ret 0;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var r: i64 = 0;
    r = pairs8(argc, 1);
    if (r != 0) { ret r; }
    r = pairs16(argc, 5);
    if (r != 0) { ret r; }
    r = pairs32(argc, 9);
    if (r != 0) { ret r; }
    r = pairs64(argc, 13);
    if (r != 0) { ret r; }
    ret 0;
}
