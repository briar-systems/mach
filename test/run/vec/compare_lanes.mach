        val m_ne: [4]u32 = ne_s32(va, vb):~[4]u32;
        val m_lt: [4]u32 = lt_s32(va, vb):~[4]u32;
        val m_le: [4]u32 = le_s32(va, vb):~[4]u32;
        val m_gt: [4]u32 = gt_s32(va, vb):~[4]u32;
        val m_ge: [4]u32 = ge_s32(va, vb):~[4]u32;
        k = 0;
        for (k < 4) {
            if (m_eq[k] != mask32(pa[k] == pb[k])) { ret code + 0; }
            if (m_ne[k] != mask32(pa[k] != pb[k])) { ret code + 1; }
            if (m_lt[k] != mask32(pa[k] < pb[k])) { ret code + 2; }
            if (m_le[k] != mask32(pa[k] <= pb[k])) { ret code + 3; }
            if (m_gt[k] != mask32(pa[k] > pb[k])) { ret code + 4; }
            if (m_ge[k] != mask32(pa[k] >= pb[k])) { ret code + 5; }
