fun gt_s64(a: i64x2, b: i64x2) u64x2 {
    ret a > b;
}

fun ge_s64(a: i64x2, b: i64x2) u64x2 {
    ret a >= b;
}

#[symbol("corpus_lanes_lt_u64")]
fun lt_u64(a: u64x2, b: u64x2) u64x2 {
    ret a < b;
}

fun le_u64(a: u64x2, b: u64x2) u64x2 {
    ret a <= b;
}

fun gt_u64(a: u64x2, b: u64x2) u64x2 {
    ret a > b;
}

fun ge_u64(a: u64x2, b: u64x2) u64x2 {
    ret a >= b;
}

# 0 where every signed comparison of 8-bit lanes matches the scalar one, else the failing code
fun pairs_s8(argc: i64, code: i64) i64 {
    val flip: u8 = (argc - 1)::u8;
    var c: usize = 0;
    for (c < 64) {
        var pa: [16]i8;
        var pb: [16]i8;
        var k: usize = 0;
        for (k < 16) {
            pa[k] = (EDGE8[(c + k) / 8] ^ flip):~i8;
            pb[k] = (EDGE8[(c + k) % 8] ^ flip):~i8;
            k = k + 1;
        }
        val va: i8x16 = pa:~i8x16;
        val vb: i8x16 = pb:~i8x16;
        val m_eq: [16]u8 = eq_s8(va, vb):~[16]u8;
        val m_ne: [16]u8 = ne_s8(va, vb):~[16]u8;
        val m_lt: [16]u8 = lt_s8(va, vb):~[16]u8;
        val m_le: [16]u8 = le_s8(va, vb):~[16]u8;
        val m_gt: [16]u8 = gt_s8(va, vb):~[16]u8;
        val m_ge: [16]u8 = ge_s8(va, vb):~[16]u8;
        k = 0;
        for (k < 16) {
            if (m_eq[k] != mask8(pa[k] == pb[k])) { ret code + 0; }
            if (m_ne[k] != mask8(pa[k] != pb[k])) { ret code + 1; }
            if (m_lt[k] != mask8(pa[k] < pb[k])) { ret code + 2; }
            if (m_le[k] != mask8(pa[k] <= pb[k])) { ret code + 3; }
            if (m_gt[k] != mask8(pa[k] > pb[k])) { ret code + 4; }
            if (m_ge[k] != mask8(pa[k] >= pb[k])) { ret code + 5; }
            k = k + 1;
        }
        c = c + 16;
    }
    ret 0;
}

# 0 where every unsigned comparison of 8-bit lanes matches the scalar one, else the failing code
fun pairs_u8(argc: i64, code: i64) i64 {
    val flip: u8 = (argc - 1)::u8;
    var c: usize = 0;
    for (c < 64) {
        var pa: [16]u8;
        var pb: [16]u8;
        var k: usize = 0;
        for (k < 16) {
            pa[k] = EDGE8[(c + k) / 8] ^ flip;
            pb[k] = EDGE8[(c + k) % 8] ^ flip;
            k = k + 1;
        }
        val va: u8x16 = pa:~u8x16;
        val vb: u8x16 = pb:~u8x16;
        val m_lt: [16]u8 = lt_u8(va, vb):~[16]u8;
        val m_le: [16]u8 = le_u8(va, vb):~[16]u8;
        val m_gt: [16]u8 = gt_u8(va, vb):~[16]u8;
        val m_ge: [16]u8 = ge_u8(va, vb):~[16]u8;
        k = 0;
        for (k < 16) {
            if (m_lt[k] != mask8(pa[k] < pb[k])) { ret code + 0; }
            if (m_le[k] != mask8(pa[k] <= pb[k])) { ret code + 1; }
            if (m_gt[k] != mask8(pa[k] > pb[k])) { ret code + 2; }
            if (m_ge[k] != mask8(pa[k] >= pb[k])) { ret code + 3; }
            k = k + 1;
        }
        c = c + 16;
    }
    ret 0;
}

