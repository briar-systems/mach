# 0 where every unsigned comparison of 64-bit lanes matches the scalar one, else the failing code
fun pairs_u64(argc: i64, code: i64) i64 {
    val flip: u64 = (argc - 1)::u64;
    var c: usize = 0;
    for (c < 64) {
        var pa: [2]u64;
        var pb: [2]u64;
        var k: usize = 0;
        for (k < 2) {
            pa[k] = EDGE64[(c + k) / 8] ^ flip;
            pb[k] = EDGE64[(c + k) % 8] ^ flip;
            k = k + 1;
        }
        val va: u64x2 = pa:~u64x2;
        val vb: u64x2 = pb:~u64x2;
        val m_lt: [2]u64 = lt_u64(va, vb):~[2]u64;
        val m_le: [2]u64 = le_u64(va, vb):~[2]u64;
        val m_gt: [2]u64 = gt_u64(va, vb):~[2]u64;
        val m_ge: [2]u64 = ge_u64(va, vb):~[2]u64;
        k = 0;
        for (k < 2) {
            if (m_lt[k] != mask64(pa[k] < pb[k])) { ret code + 0; }
            if (m_le[k] != mask64(pa[k] <= pb[k])) { ret code + 1; }
            if (m_gt[k] != mask64(pa[k] > pb[k])) { ret code + 2; }
            if (m_ge[k] != mask64(pa[k] >= pb[k])) { ret code + 3; }
            k = k + 1;
        }
        c = c + 2;
    }
    ret 0;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var r: i64 = 0;
    r = pairs_s8(argc, 1);
    if (r != 0) { ret r; }
    r = pairs_u8(argc, 9);
    if (r != 0) { ret r; }
    r = pairs_s16(argc, 17);
    if (r != 0) { ret r; }
    r = pairs_u16(argc, 25);
    if (r != 0) { ret r; }
    r = pairs_s32(argc, 33);
    if (r != 0) { ret r; }
    r = pairs_u32(argc, 41);
    if (r != 0) { ret r; }
    r = pairs_s64(argc, 49);
    if (r != 0) { ret r; }
    r = pairs_u64(argc, 57);
    if (r != 0) { ret r; }
    ret 0;
}
