# targets: linux-aarch64 linux-riscv64-v linux-riscv64-v-optimized
# flags:   --set simd=require
use std.runtime;
use std.types.bool.bool;
use std.types.size.usize;

# every integer comparison of 8-, 16-, 32- and 64-bit lanes as a mask, built under
# `simd = "require"`, which refuses any vector operation taken lane by lane, each lane checked
# against the scalar comparison over every pair of the edge values: 0, 1, all ones, the
# signed minimum and maximum and their neighbours. riscv64 with v computes these with no mask
# register, by sequences of subtracts, logic and arithmetic shifts that spread a sign

val EDGE8: [8]u8 = [8]u8{0x0, 0x1, 0xff, 0x80, 0x7f, 0x2, 0x81, 0x7e};
val EDGE16: [8]u16 = [8]u16{0x0, 0x1, 0xffff, 0x8000, 0x7fff, 0x2, 0x8001, 0x7ffe};
val EDGE32: [8]u32 = [8]u32{0x0, 0x1, 0xffffffff, 0x80000000, 0x7fffffff, 0x2, 0x80000001, 0x7ffffffe};
val EDGE64: [8]u64 = [8]u64{0x0, 0x1, 0xffffffffffffffff, 0x8000000000000000, 0x7fffffffffffffff, 0x2, 0x8000000000000001, 0x7ffffffffffffffe};

fun mask8(b: bool) u8 {
    if (b) { ret 0xff; }
    ret 0;
}

fun eq_s8(a: i8x16, b: i8x16) u8x16 {
    ret a == b;
}

fun ne_s8(a: i8x16, b: i8x16) u8x16 {
    ret a != b;
}

fun lt_s8(a: i8x16, b: i8x16) u8x16 {
    ret a < b;
}

fun le_s8(a: i8x16, b: i8x16) u8x16 {
    ret a <= b;
}

fun gt_s8(a: i8x16, b: i8x16) u8x16 {
    ret a > b;
}

fun ge_s8(a: i8x16, b: i8x16) u8x16 {
    ret a >= b;
}

fun lt_u8(a: u8x16, b: u8x16) u8x16 {
    ret a < b;
}

fun le_u8(a: u8x16, b: u8x16) u8x16 {
    ret a <= b;
}

fun gt_u8(a: u8x16, b: u8x16) u8x16 {
    ret a > b;
}

fun ge_u8(a: u8x16, b: u8x16) u8x16 {
    ret a >= b;
}

fun mask16(b: bool) u16 {
    if (b) { ret 0xffff; }
    ret 0;
}

fun eq_s16(a: i16x8, b: i16x8) u16x8 {
    ret a == b;
}

fun ne_s16(a: i16x8, b: i16x8) u16x8 {
    ret a != b;
}

fun lt_s16(a: i16x8, b: i16x8) u16x8 {
    ret a < b;
}

fun le_s16(a: i16x8, b: i16x8) u16x8 {
    ret a <= b;
}

fun gt_s16(a: i16x8, b: i16x8) u16x8 {
    ret a > b;
}

fun ge_s16(a: i16x8, b: i16x8) u16x8 {
    ret a >= b;
}

fun lt_u16(a: u16x8, b: u16x8) u16x8 {
    ret a < b;
}

fun le_u16(a: u16x8, b: u16x8) u16x8 {
    ret a <= b;
}

fun gt_u16(a: u16x8, b: u16x8) u16x8 {
    ret a > b;
}

fun ge_u16(a: u16x8, b: u16x8) u16x8 {
    ret a >= b;
}

fun mask32(b: bool) u32 {
    if (b) { ret 0xffffffff; }
    ret 0;
}

fun eq_s32(a: i32x4, b: i32x4) u32x4 {
    ret a == b;
}

fun ne_s32(a: i32x4, b: i32x4) u32x4 {
    ret a != b;
}

fun lt_s32(a: i32x4, b: i32x4) u32x4 {
    ret a < b;
}

fun le_s32(a: i32x4, b: i32x4) u32x4 {
    ret a <= b;
}

fun gt_s32(a: i32x4, b: i32x4) u32x4 {
    ret a > b;
}

fun ge_s32(a: i32x4, b: i32x4) u32x4 {
    ret a >= b;
}

fun lt_u32(a: u32x4, b: u32x4) u32x4 {
    ret a < b;
}

fun le_u32(a: u32x4, b: u32x4) u32x4 {
    ret a <= b;
}

fun gt_u32(a: u32x4, b: u32x4) u32x4 {
    ret a > b;
}

fun ge_u32(a: u32x4, b: u32x4) u32x4 {
    ret a >= b;
}

fun mask64(b: bool) u64 {
    if (b) { ret 0xffffffffffffffff; }
    ret 0;
}

fun eq_s64(a: i64x2, b: i64x2) u64x2 {
    ret a == b;
}

fun ne_s64(a: i64x2, b: i64x2) u64x2 {
    ret a != b;
}

fun lt_s64(a: i64x2, b: i64x2) u64x2 {
    ret a < b;
}

fun le_s64(a: i64x2, b: i64x2) u64x2 {
    ret a <= b;
