        val m_ne: [8]u16 = ne_s16(va, vb):~[8]u16;
        val m_lt: [8]u16 = lt_s16(va, vb):~[8]u16;
        val m_le: [8]u16 = le_s16(va, vb):~[8]u16;
        val m_gt: [8]u16 = gt_s16(va, vb):~[8]u16;
        val m_ge: [8]u16 = ge_s16(va, vb):~[8]u16;
