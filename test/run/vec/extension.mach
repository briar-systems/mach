# targets: linux-x86_64 linux-x86_64-optimized
# flags:   --set simd=require
use std.runtime;

# a function naming `avx2` past the target's baseline is legalised under the build's selection
# widened by it, built under `simd = "require"`, which refuses any vector operation taken lane by
# lane: the baseline compares 64-bit lanes with no packed form, and the widened selection does,
# so only a legalisation reading the function's own selection takes the comparison whole. the
# corpus runs on a host that holds avx2, as the caller owns the check before an outlier call

#[extension("avx2")]
fun product(a: i32x8, b: i32x8) i32x8 {
    ret a * b + a;
}

#[extension("avx2")]
fun below(a: i64x4, b: i64x4) u64x4 {
    ret a < b;
}

#[extension("avx2")]
fun narrow(a: u16x16, b: u16x16) u16x16 {
    ret a * b;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val one: i32   = argc::i32;
    val a:   i32x8 = i32x8{one, -1, 2147483647, -2147483647 - one, 3, 0, 65536, -7};
    val b:   i32x8 = i32x8{5, -1, 2, 2, 0, 9, 65536, 7};
    val p:   i32x8 = product(a, b);
    # 1*5+1, -1*-1-1, (2^31-1)*2 wraps to -2, then + 2^31-1, -2^31*2 wraps to 0, then + -2^31
    if (p[0] != 6 || p[1] != 0 || p[2] != 2147483645 || p[3] != -2147483647 - one) { ret 1; }
    # 3*0+3, 0*9+0, 2^32 wraps to 0, then + 65536, -49 - 7
    if (p[4] != 3 || p[5] != 0 || p[6] != 65536 || p[7] != -56) { ret 2; }
    val big: i64   = 9223372036854775807;
    val x64: i64x4 = i64x4{argc - 2, big, -big - 1, 5};
    val y64: i64x4 = i64x4{0, -big - 1, big, 5};
    val lt:  u64x4 = below(x64, y64);
    # -1 < 0, the largest above the smallest, the smallest below the largest, equal lanes
    if (lt[0] != 0xffffffffffffffff || lt[1] != 0 || lt[2] != 0xffffffffffffffff || lt[3] != 0) { ret 5; }
    val h: u16 = argc::u16;
    val x: u16x16 = u16x16{h, 2, 255, 256, 65535, 65535, 0, 300, 7, 8, 9, 10, 11, 12, 13, 14};
    val y: u16x16 = u16x16{h, 3, 255, 256, 65535, 2, 9, 300, 1, 1, 1, 1, 1, 1, 1, 0};
    val q: u16x16 = narrow(x, y);
    # 65025, 65536 wraps to 0, 65535^2 wraps to 1, 65535*2 wraps to 65534, 90000 wraps to 24464
    if (q[0] != 1 || q[1] != 6 || q[2] != 65025 || q[3] != 0 || q[4] != 1 || q[5] != 65534) { ret 3; }
    if (q[6] != 0 || q[7] != 24464 || q[8] != 7 || q[15] != 0) { ret 4; }
    ret 0;
}
