# reports: vectorise loop_map.loop_map.xor_u8 1; vectorise loop_map.loop_map.add_u32 1
use std.runtime;
use std.types.size.usize;

# lanewise loops, which an optimised build runs a vector at a time over the trips a whole number of vectors covers
# and one element at a time over the rest. each is checked against a twin the vectoriser leaves alone, writing into
# its sources and next to them at every distance from 40 elements below to 40 above, for every length to past twice
# the widest lane count, from starts that are not a multiple of any lane count. a destination a few elements past a
# source makes a later element read what an earlier one wrote, which a vector that read all its lanes first would
# not see, so a wrong test changes the result.

val SIZE: usize = 256;

#[inline("never")]
fun xor_u8(d: *u8, a: *u8, k: u8, n: usize) {
    var i: usize = 0;
    for (i < n) {
        d[i] = a[i] ^ k;
        i    = i + 1;
    }
}

#[inline("never")]
#[vectorize("never")]
fun twin_xor_u8(d: *u8, a: *u8, k: u8, n: usize) {
    var i: usize = 0;
    for (i < n) {
        d[i] = a[i] ^ k;
        i    = i + 1;
    }
}

#[inline("never")]
fun add_u32(d: *u32, a: *u32, b: *u32, n: usize) {
    var i: usize = 0;
    for (i < n) {
        d[i] = a[i] + b[i];
        i    = i + 1;
    }
}

#[inline("never")]
#[vectorize("never")]
fun twin_add_u32(d: *u32, a: *u32, b: *u32, n: usize) {
    var i: usize = 0;
    for (i < n) {
        d[i] = a[i] + b[i];
        i    = i + 1;
    }
}

# a product that wraps and a difference, both at 16 bits
#[inline("never")]
fun mul_i16(d: *i16, a: *i16, b: *i16, n: usize) {
    var i: usize = 0;
    for (i < n) {
        d[i] = a[i] * b[i] - a[i];
        i    = i + 1;
    }
}

#[inline("never")]
#[vectorize("never")]
fun twin_mul_i16(d: *i16, a: *i16, b: *i16, n: usize) {
    var i: usize = 0;
    for (i < n) {
        d[i] = a[i] * b[i] - a[i];
        i    = i + 1;
    }
}

#[inline("never")]
fun axpy_f32(d: *f32, a: *f32, x: *f32, c: f32, n: usize) {
    var i: usize = 0;
    for (i < n) {
        d[i] = a[i] * x[i] + c;
        i    = i + 1;
    }
}

#[inline("never")]
#[vectorize("never")]
fun twin_axpy_f32(d: *f32, a: *f32, x: *f32, c: f32, n: usize) {
    var i: usize = 0;
    for (i < n) {
        d[i] = a[i] * x[i] + c;
        i    = i + 1;
    }
}

#[inline("never")]
fun or_u64(d: *u64, a: *u64, b: *u64, n: usize) {
    var i: usize = 0;
    for (i != n) {
        d[i] = ~(a[i] | b[i]);
        i    = i + 1;
    }
}

#[inline("never")]
#[vectorize("never")]
fun twin_or_u64(d: *u64, a: *u64, b: *u64, n: usize) {
    var i: usize = 0;
    for (i != n) {
        d[i] = ~(a[i] | b[i]);
        i    = i + 1;
    }
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var p: [256]u8;
    var q: [256]u8;
    var a: [256]u32;
    var b: [256]u32;
    var c: [256]u32;
    var h: [256]i16;
    var g: [256]i16;
    var e: [256]i16;
    var f: [256]f32;
    var y: [256]f32;
    var z: [256]f32;
    var w: [256]u64;
    var v: [256]u64;
    var u: [256]u64;
    var n: usize = 0;
    for (n <= 70) {
        var k: usize = 0;
        for (k <= 80) {
            var i: usize = 0;
            for (i < SIZE) {
                val x: u8 = ((i * 151 + 7) & 0xff)::u8;
                p[i] = x;
                q[i] = x;
                a[i] = (i::u32 * 2654435761) ^ 0x7fffffff;
                b[i] = a[i];
                c[i] = i::u32 * 0x01000193 + 0xfffffff0;
                h[i] = (((i * 4099) & 0xffff)::u16):~i16;
                g[i] = h[i];
                e[i] = (((i * 77 + 32760) & 0xffff)::u16):~i16;
                f[i] = (i::f32 - 100.0) * 0.375;
                y[i] = f[i];
                z[i] = 1.0 / (i::f32 + 0.5);
                w[i] = i::u64 * 0x9e3779b97f4a7c15;
                v[i] = w[i];
                u[i] = ~(i::u64 << (i & 63)::u64);
                i    = i + 1;
            }
            # the destination k - 40 elements from the first source, which starts at an odd index
            xor_u8(?p[k + 3], ?p[43], (argc + 0x5a)::u8, n);
            twin_xor_u8(?q[k + 3], ?q[43], (argc + 0x5a)::u8, n);
            add_u32(?a[k + 5], ?a[45], ?c[7], n);
            twin_add_u32(?b[k + 5], ?b[45], ?c[7], n);
            mul_i16(?h[k + 1], ?h[41], ?e[9], n);
            twin_mul_i16(?g[k + 1], ?g[41], ?e[9], n);
            axpy_f32(?f[k + 7], ?f[47], ?z[3], argc::f32 - 0.25, n);
            twin_axpy_f32(?y[k + 7], ?y[47], ?z[3], argc::f32 - 0.25, n);
            or_u64(?w[k + 3], ?u[11], ?w[43], n);
            twin_or_u64(?v[k + 3], ?u[11], ?v[43], n);
            i = 0;
            for (i < SIZE) {
                if (p[i] != q[i])           { ret 1; }
                if (a[i] != b[i])           { ret 2; }
                if (h[i] != g[i])           { ret 3; }
                if (f[i]:~u32 != y[i]:~u32) { ret 4; }
                if (w[i] != v[i])           { ret 5; }
                i = i + 1;
            }
            k = k + 1;
        }
        n = n + 1;
    }
    ret 0;
}
