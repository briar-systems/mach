# reports: vectorise loop_widen.loop_widen.to_f32 1; vectorise loop_widen.loop_widen.filter_sum 1; vectorise loop_widen.loop_widen.filter_else 1; vectorise loop_widen.loop_widen.count_less 1
use std.runtime;
use std.types.size.usize;

# loops whose lanes change type: bytes summed into a 64-bit total, bytes widened to floats and scaled, a sum of the
# elements a comparison admits, taken where it holds and where it fails, a count of the bytes below a bound and of the
# elements below others, and a sum of products of elements widened before they multiply. each is checked against a twin
# the vectoriser leaves alone at every length up to past the widest unit's lanes and over a long run, with bytes whose
# sum overflows any narrower total and elements on both sides of each comparison, so a lane widened wrong, a lane
# skipped in place of the identity or a wrong trip count changes the result.

val SIZE: usize = 4096;

var BYTES: [4096]u8;
var LEFT:  [4096]i32;
var RIGHT: [4096]i32;
var OUT:   [4096]f32;
var TWIN:  [4096]f32;

#[inline("never")]
fun sum_u8(n: usize) i64 {
    var acc: i64   = 0;
    var i:   usize = 0;
    for (i < n) {
        acc = acc + BYTES[i]::i64;
        i   = i + 1;
    }
    ret acc;
}

#[inline("never")]
#[vectorize("never")]
fun twin_sum_u8(n: usize) i64 {
    var acc: i64   = 0;
    var i:   usize = 0;
    for (i < n) {
        acc = acc + BYTES[i]::i64;
        i   = i + 1;
    }
    ret acc;
}

#[inline("never")]
fun to_f32(n: usize) {
    var i: usize = 0;
    for (i < n) {
        OUT[i] = (BYTES[i]::f32) * 0.00390625;
        i      = i + 1;
    }
}

#[inline("never")]
#[vectorize("never")]
fun twin_to_f32(n: usize) {
    var i: usize = 0;
    for (i < n) {
        TWIN[i] = (BYTES[i]::f32) * 0.00390625;
        i       = i + 1;
    }
}

#[inline("never")]
fun filter_sum(n: usize) i64 {
    var acc: i64   = 0;
    var i:   usize = 0;
    for (i < n) {
        if (LEFT[i] > RIGHT[i]) { acc = acc + LEFT[i]::i64; }
        i = i + 1;
    }
    ret acc;
}

#[inline("never")]
#[vectorize("never")]
fun twin_filter_sum(n: usize) i64 {
    var acc: i64   = 0;
    var i:   usize = 0;
    for (i < n) {
        if (LEFT[i] > RIGHT[i]) { acc = acc + LEFT[i]::i64; }
        i = i + 1;
    }
    ret acc;
}

# the sum taken where the comparison fails, from a start the caller gives
#[inline("never")]
fun filter_else(n: usize, start: i64) i64 {
    var acc: i64   = start;
    var i:   usize = 0;
    for (i < n) {
        if (LEFT[i] > RIGHT[i]) {}
        or                      { acc = acc + LEFT[i]::i64; }
        i = i + 1;
    }
    ret acc;
}

#[inline("never")]
#[vectorize("never")]
fun twin_filter_else(n: usize, start: i64) i64 {
    var acc: i64   = start;
    var i:   usize = 0;
    for (i < n) {
        if (LEFT[i] > RIGHT[i]) {}
        or                      { acc = acc + LEFT[i]::i64; }
        i = i + 1;
    }
    ret acc;
}

#[inline("never")]
fun count_below(n: usize, bound: u8) i64 {
    var c: i64   = 0;
    var i: usize = 0;
    for (i < n) {
        if (BYTES[i] < bound) { c = c + 1; }
        i = i + 1;
    }
    ret c;
}

#[inline("never")]
#[vectorize("never")]
fun twin_count_below(n: usize, bound: u8) i64 {
    var c: i64   = 0;
    var i: usize = 0;
    for (i < n) {
        if (BYTES[i] < bound) { c = c + 1; }
        i = i + 1;
    }
    ret c;
}

#[inline("never")]
fun madd(n: usize) i64 {
    var acc: i64   = 0;
    var i:   usize = 0;
    for (i < n) {
        acc = acc + LEFT[i]::i64 * RIGHT[i]::i64;
        i   = i + 1;
    }
    ret acc;
}

#[inline("never")]
#[vectorize("never")]
fun twin_madd(n: usize) i64 {
    var acc: i64   = 0;
    var i:   usize = 0;
    for (i < n) {
        acc = acc + LEFT[i]::i64 * RIGHT[i]::i64;
        i   = i + 1;
    }
    ret acc;
}

#[inline("never")]
fun count_less(n: usize) i64 {
    var c: i64   = 0;
    var i: usize = 0;
    for (i < n) {
        if (LEFT[i] < RIGHT[i]) { c = c + 1; }
        i = i + 1;
    }
    ret c;
}

#[inline("never")]
#[vectorize("never")]
fun twin_count_less(n: usize) i64 {
    var c: i64   = 0;
    var i: usize = 0;
    for (i < n) {
        if (LEFT[i] < RIGHT[i]) { c = c + 1; }
        i = i + 1;
    }
    ret c;
}

# every length from none to past the widest unit's lanes, then the whole arrays and one short of them
fun check(n: usize, bound: u8) i64 {
    if (sum_u8(n) != twin_sum_u8(n))                         { ret 1; }
    if (filter_sum(n) != twin_filter_sum(n))                 { ret 2; }
    if (filter_else(n, -7) != twin_filter_else(n, -7))       { ret 3; }
    if (count_below(n, bound) != twin_count_below(n, bound)) { ret 4; }
    if (count_less(n) != twin_count_less(n))                 { ret 7; }
    if (madd(n) != twin_madd(n))                             { ret 6; }
    var k: usize = 0;
    for (k < SIZE) {
        OUT[k]  = -1.0;
        TWIN[k] = -1.0;
        k       = k + 1;
    }
    to_f32(n);
    twin_to_f32(n);
    k = 0;
    for (k < SIZE) {
        if (OUT[k]:~u32 != TWIN[k]:~u32) { ret 5; }
        k = k + 1;
    }
    ret 0;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var i: usize = 0;
    for (i < SIZE) {
        # bytes high enough that a total of more than a few overflows a narrower sum, and low ones below the bound
        BYTES[i] = ((i * 37 + 200) & 0xff)::u8;
        # magnitudes near the limits, so the sum of the admitted ones leaves 32 bits, and each side of the comparison
        LEFT[i]  = (i::u32 * 2654435761):~i32;
        RIGHT[i] = (i::u32 * 40503 + 0x7f000000):~i32;
        if ((i & 3) == 1) { RIGHT[i] = LEFT[i]; }
        i = i + 1;
    }
    val bound: u8    = (argc + 99)::u8;
    var n:     usize = 0;
    for (n <= 70) {
        val got: i64 = check(n, bound);
        if (got != 0) { ret got; }
        n = n + 1;
    }
    val whole: i64 = check(SIZE, bound);
    if (whole != 0) { ret 10 + whole; }
    val short: i64 = check(SIZE - 1, bound);
    if (short != 0) { ret 20 + short; }
    # the long run's totals leave any narrower type
    if (twin_sum_u8(SIZE) < 65536)                          { ret 31; }
    if (twin_count_below(SIZE, bound) == 0)                 { ret 32; }
    if (twin_count_below(SIZE, bound) == SIZE::i64)         { ret 33; }
    if (twin_filter_sum(SIZE) == twin_filter_else(SIZE, 0)) { ret 34; }
    ret 0;
}
