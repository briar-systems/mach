use std.runtime;
use std.types.size.usize;

# reductions, which an optimised build runs a vector of partial values at a time where they regroup exactly: integer
# sums, products and the bitwise ones, from trips of none and one up past several vectors, from every start, over
# values at the sign boundary and wrapping sums, each against a twin the vectoriser leaves alone. a float sum is not
# reassociated where the build does not permit it: over values whose sum depends on the order they are added in, the
# loop gives exactly what the twin gives, which a regrouped sum would not.

val SIZE: usize = 200;

#[inline("never")]
fun sum_u32(a: *u32, n: usize) u32 {
    var s: u32   = 0;
    var i: usize = 0;
    for (i < n) {
        s = s + a[i];
        i = i + 1;
    }
    ret s;
}

#[inline("never")]
#[vectorize("never")]
fun twin_sum_u32(a: *u32, n: usize) u32 {
    var s: u32   = 0;
    var i: usize = 0;
    for (i < n) {
        s = s + a[i];
        i = i + 1;
    }
    ret s;
}

# a signed sum from a start that is not zero, an accumulator that starts at a value the caller gives
#[inline("never")]
fun sum_i8(a: *i8, from: usize, to: usize, s0: i8) i8 {
    var s: i8    = s0;
    var i: usize = from;
    for (i < to) {
        s = a[i] + s;
        i = i + 1;
    }
    ret s;
}

#[inline("never")]
#[vectorize("never")]
fun twin_sum_i8(a: *i8, from: usize, to: usize, s0: i8) i8 {
    var s: i8    = s0;
    var i: usize = from;
    for (i < to) {
        s = a[i] + s;
        i = i + 1;
    }
    ret s;
}

# a product, an exclusive or and an or of a value the loop does not define, in one loop
#[inline("never")]
fun mixed_u16(a: *u16, b: *u16, k: u16, n: usize) u64 {
    var p: u16   = 1;
    var x: u16   = 0;
    var o: u16   = 0;
    var i: usize = 0;
    for (i != n) {
        p = p * (a[i] | 1);
        x = x ^ (a[i] + b[i]);
        o = o | k;
        i = i + 1;
    }
    ret p::u64 | (x::u64 << 16) | (o::u64 << 32);
}

#[inline("never")]
#[vectorize("never")]
fun twin_mixed_u16(a: *u16, b: *u16, k: u16, n: usize) u64 {
    var p: u16   = 1;
    var x: u16   = 0;
    var o: u16   = 0;
    var i: usize = 0;
    for (i != n) {
        p = p * (a[i] | 1);
        x = x ^ (a[i] + b[i]);
        o = o | k;
        i = i + 1;
    }
    ret p::u64 | (x::u64 << 16) | (o::u64 << 32);
}

# an and of 64-bit lanes, a dot product of 64-bit integers that wraps
#[inline("never")]
fun dot_u64(a: *u64, b: *u64, n: usize) u64 {
    var d: u64   = 0;
    var m: u64   = 0xffffffffffffffff;
    var i: usize = 0;
    for (i < n) {
        d = d + a[i] * b[i];
        m = m & (a[i] | b[i]);
        i = i + 1;
    }
    ret d ^ m;
}

#[inline("never")]
#[vectorize("never")]
fun twin_dot_u64(a: *u64, b: *u64, n: usize) u64 {
    var d: u64   = 0;
    var m: u64   = 0xffffffffffffffff;
    var i: usize = 0;
    for (i < n) {
        d = d + a[i] * b[i];
        m = m & (a[i] | b[i]);
        i = i + 1;
    }
    ret d ^ m;
}

# a float sum the build does not permit to regroup
#[inline("never")]
fun sum_f64(a: *f64, n: usize) f64 {
    var s: f64   = 0.0;
    var i: usize = 0;
    for (i < n) {
        s = s + a[i];
        i = i + 1;
    }
    ret s;
}

#[inline("never")]
#[vectorize("never")]
fun twin_sum_f64(a: *f64, n: usize) f64 {
    var s: f64   = 0.0;
    var i: usize = 0;
    for (i < n) {
        s = s + a[i];
        i = i + 1;
    }
    ret s;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var a: [200]u32;
    var c: [200]i8;
    var h: [200]u16;
    var g: [200]u16;
    var w: [200]u64;
    var v: [200]u64;
    var f: [200]f64;
    var i: usize = 0;
    for (i < SIZE) {
        a[i] = (i::u32 * 2654435761) | 0x80000000;
        # the sign boundary and its neighbours, so a sum wraps both ways
        c[i] = (((i * 37 + 125) & 0xff)::u8):~i8;
        h[i] = ((i * 40503 + 1) & 0xffff)::u16;
        g[i] = ((i * 7919) & 0xffff)::u16;
        w[i] = i::u64 * 0x9e3779b97f4a7c15 + 0x8000000000000000;
        v[i] = ~(i::u64 * 0x2545f4914f6cdd1d);
        # a large value then small ones: added in order the small ones round away one by one, grouped they do not
        f[i] = 1.0;
        if ((i & 15) == 0) { f[i] = 9007199254740992.0; }
        if ((i & 15) == 8) { f[i] = -9007199254740992.0; }
        i = i + 1;
    }
    var n: usize = 0;
    for (n <= 100) {
        if (sum_u32(?a[3], n) != twin_sum_u32(?a[3], n)) { ret 1; }
        var from: usize = 0;
        for (from <= 17) {
            val s0: i8 = (argc + 126)::i8;
            if (sum_i8(?c[0], from, from + n, s0) != twin_sum_i8(?c[0], from, from + n, s0)) { ret 2; }
            from = from + 1;
        }
        val k: u16 = (argc::u16 << 9) | 3;
        if (mixed_u16(?h[1], ?g[5], k, n) != twin_mixed_u16(?h[1], ?g[5], k, n)) { ret 3; }
        if (dot_u64(?w[7], ?v[2], n) != twin_dot_u64(?w[7], ?v[2], n))           { ret 4; }
        if (sum_f64(?f[0], n):~u64 != twin_sum_f64(?f[0], n):~u64)               { ret 5; }
        n = n + 1;
    }
    # no trip at all leaves each accumulator as it started
    if (sum_u32(?a[0], 0) != 0)                         { ret 6; }
    if (sum_i8(?c[0], 9, 9, -128) != -128)              { ret 7; }
    if (mixed_u16(?h[0], ?g[0], 5, 0) != 1)             { ret 8; }
    if (dot_u64(?w[0], ?v[0], 0) != 0xffffffffffffffff) { ret 9; }
    ret 0;
}
