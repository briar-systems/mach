        k32_64 = 0;
        for (k32_64 < 4) {
            if (ws32_64[k32_64] != (p32_64[k32_64]:~i32)::i64) { ret 111; }
            if (wu32_64[k32_64] != p32_64[k32_64]::u64) { ret 112; }
            k32_64 = k32_64 + 1;
        }
        c = c + 1;
    }
    ret 0;
}

fun same32(a: u32, b: u32) bool {
    val nan: u32 = (((1::u32 << 8) - 1) << 23);
    if ((a & nan) == nan && (a & ((1::u32 << 23) - 1)) != 0 && (b & nan) == nan && (b & ((1::u32 << 23) - 1)) != 0) { ret 1; }
    ret a == b;
}

fun same64(a: u64, b: u64) bool {
    val nan: u64 = (((1::u64 << 11) - 1) << 52);
    if ((a & nan) == nan && (a & ((1::u64 << 52) - 1)) != 0 && (b & nan) == nan && (b & ((1::u64 << 52) - 1)) != 0) { ret 1; }
    ret a == b;
}

# 0 where every float row of 32-bit lanes matches the scalar operation bit for bit, a nan for a nan, else the failing check
fun floats32(argc: i64) i64 {
    var c: usize = 0;
    for (c < 64) {
        var pa: [8]f32;
        var pb: [8]f32;
        var k: usize = 0;
        for (k < 8) {
            pa[k] = FBITS32[((c + k) / 8) % 8]:~f32;
            pb[k] = FBITS32[(c + k) % 8]:~f32;
            k = k + 1;
        }
        val va: f32x8 = pa:~f32x8;
        val vb: f32x8 = pb:~f32x8;
        val r_fadd: [8]u32 = fadd32(va, vb):~[8]u32;
        val r_fsub: [8]u32 = fsub32(va, vb):~[8]u32;
        val r_fmul: [8]u32 = fmul32(va, vb):~[8]u32;
        val r_fdiv: [8]u32 = fdiv32(va, vb):~[8]u32;
        val m_feq: [8]u32 = feq32(va, vb):~[8]u32;
        val m_fne: [8]u32 = fne32(va, vb):~[8]u32;
        val m_flt: [8]u32 = flt32(va, vb):~[8]u32;
        val m_fle: [8]u32 = fle32(va, vb):~[8]u32;
        val m_fgt: [8]u32 = fgt32(va, vb):~[8]u32;
        val m_fge: [8]u32 = fge32(va, vb):~[8]u32;
        val r_put: [8]u32 = fput32(va, pb[1]):~[8]u32;
        k = 0;
        for (k < 8) {
            if (!same32(r_fadd[k], (pa[k] + pb[k]):~u32)) { ret 113; }
            if (!same32(r_fsub[k], (pa[k] - pb[k]):~u32)) { ret 114; }
            if (!same32(r_fmul[k], (pa[k] * pb[k]):~u32)) { ret 115; }
            if (!same32(r_fdiv[k], (pa[k] / pb[k]):~u32)) { ret 116; }
            if (m_feq[k] != mask32(pa[k] == pb[k])) { ret 117; }
            if (m_fne[k] != mask32(pa[k] != pb[k])) { ret 118; }
            if (m_flt[k] != mask32(pa[k] < pb[k])) { ret 119; }
            if (m_fle[k] != mask32(pa[k] <= pb[k])) { ret 120; }
            if (m_fgt[k] != mask32(pa[k] > pb[k])) { ret 121; }
            if (m_fge[k] != mask32(pa[k] >= pb[k])) { ret 122; }
            if ((k == 0 || k == 7) && r_put[k] != pb[1]:~u32) { ret 123; }
            if (k != 0 && k != 7 && r_put[k] != pa[k]:~u32) { ret 124; }
            if (k == 0 && (ffirst32(va):~u32 != pa[0]:~u32 || flast32(va):~u32 != pa[7]:~u32)) { ret 125; }
            k = k + 1;
        }
        c = c + 8;
    }
    ret 0;
}

# 0 where every float row of 64-bit lanes matches the scalar operation bit for bit, a nan for a nan, else the failing check
fun floats64(argc: i64) i64 {
    var c: usize = 0;
    for (c < 64) {
        var pa: [4]f64;
        var pb: [4]f64;
        var k: usize = 0;
        for (k < 4) {
            pa[k] = FBITS64[((c + k) / 8) % 8]:~f64;
            pb[k] = FBITS64[(c + k) % 8]:~f64;
            k = k + 1;
        }
        val va: f64x4 = pa:~f64x4;
        val vb: f64x4 = pb:~f64x4;
        val r_fadd: [4]u64 = fadd64(va, vb):~[4]u64;
        val r_fsub: [4]u64 = fsub64(va, vb):~[4]u64;
        val r_fmul: [4]u64 = fmul64(va, vb):~[4]u64;
        val r_fdiv: [4]u64 = fdiv64(va, vb):~[4]u64;
        val m_feq: [4]u64 = feq64(va, vb):~[4]u64;
        val m_fne: [4]u64 = fne64(va, vb):~[4]u64;
        val m_flt: [4]u64 = flt64(va, vb):~[4]u64;
        val m_fle: [4]u64 = fle64(va, vb):~[4]u64;
        val m_fgt: [4]u64 = fgt64(va, vb):~[4]u64;
        val m_fge: [4]u64 = fge64(va, vb):~[4]u64;
        val r_put: [4]u64 = fput64(va, pb[1]):~[4]u64;
        k = 0;
        for (k < 4) {
            if (!same64(r_fadd[k], (pa[k] + pb[k]):~u64)) { ret 126; }
            if (!same64(r_fsub[k], (pa[k] - pb[k]):~u64)) { ret 127; }
            if (!same64(r_fmul[k], (pa[k] * pb[k]):~u64)) { ret 128; }
            if (!same64(r_fdiv[k], (pa[k] / pb[k]):~u64)) { ret 129; }
            if (m_feq[k] != mask64(pa[k] == pb[k])) { ret 130; }
            if (m_fne[k] != mask64(pa[k] != pb[k])) { ret 131; }
            if (m_flt[k] != mask64(pa[k] < pb[k])) { ret 132; }
            if (m_fle[k] != mask64(pa[k] <= pb[k])) { ret 133; }
            if (m_fgt[k] != mask64(pa[k] > pb[k])) { ret 134; }
            if (m_fge[k] != mask64(pa[k] >= pb[k])) { ret 135; }
            if ((k == 0 || k == 3) && r_put[k] != pb[1]:~u64) { ret 136; }
            if (k != 0 && k != 3 && r_put[k] != pa[k]:~u64) { ret 137; }
            if (k == 0 && (ffirst64(va):~u64 != pa[0]:~u64 || flast64(va):~u64 != pa[3]:~u64)) { ret 138; }
            k = k + 1;
        }
        c = c + 4;
    }
    ret 0;
}

# 0 where every lane of each conversion matches the scalar cast, else the failing check
fun converted(argc: i64) i64 {
    var c: usize = 0;
    for (c < 16) {
        var pf: [8]f32;
        var pi: [8]u32;
        var k: usize = 0;
        for (k < 8) {
            pf[k] = CONV32[(c + k) % 16]:~f32;
            pi[k] = EDGE32[(c + k) % 8];
            k = k + 1;
        }
        val vf: f32x8 = pf:~f32x8;
        val vi: u32x8 = pi:~u32x8;
        val r_fs_i: [8]i32 = cvt_fs_i(vf):~[8]i32;
        val r_fs_u: [8]u32 = cvt_fs_u(vf):~[8]u32;
        val r_i_fs: [8]u32 = cvt_i_fs(vi:~i32x8):~[8]u32;
        val r_u_fs: [8]u32 = cvt_u_fs(vi):~[8]u32;
        k = 0;
        for (k < 8) {
            if (r_fs_i[k] != pf[k]::i32) { ret 139; }
            if (r_fs_u[k] != pf[k]::u32) { ret 140; }
            if (r_i_fs[k] != (pi[k]:~i32)::f32:~u32) { ret 141; }
            if (r_u_fs[k] != pi[k]::f32:~u32) { ret 142; }
            k = k + 1;
        }
        c = c + 1;
    }
    ret 0;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var r: i64 = 0;
    r = pairs8(argc);
    if (r != 0) { ret r; }
    r = pairs16(argc);
    if (r != 0) { ret r; }
    r = pairs32(argc);
    if (r != 0) { ret r; }
    r = pairs64(argc);
    if (r != 0) { ret r; }
    r = widened(argc);
    if (r != 0) { ret r; }
    r = floats32(argc);
    if (r != 0) { ret r; }
    r = floats64(argc);
    if (r != 0) { ret r; }
    r = converted(argc);
    if (r != 0) { ret r; }
    ret 0;
}
