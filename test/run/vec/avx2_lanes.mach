val CONV32: [16]u32 = [16]u32{0x00000000, 0xbf000000, 0x3fc00000, 0x4f000000, 0xcf000000, 0x4f800000, 0x4effffff, 0x4f7fffff, 0xbf800000, 0x7f800000, 0xff800000, 0x7fc00000, 0xcf000001, 0x80000000, 0x4b7fffff, 0x3f7fffff};
val CONV64: [8]u64 = [8]u64{0xbfe0000000000000, 0x3ff8000000000000, 0x41e0000000000000, 0xc1e0000000000000, 0x41dfffffffe00000, 0xc1e0000000100000, 0x7ff8000000000000, 0xfff0000000000000};

# 0 where every integer row of 8-bit lanes matches the scalar operation, else the failing check
fun pairs8(argc: i64) i64 {
    val flip: u8 = (argc - 1)::u8;
    var c: usize = 0;
    for (c < 64) {
        var pa: [32]u8;
        var pb: [32]u8;
        var pc: [32]u8;
        var k: usize = 0;
        for (k < 32) {
            pa[k] = EDGE8[((c + k) / 8) % 8] ^ flip;
            pb[k] = EDGE8[(c + k) % 8] ^ flip;
            pc[k] = COUNT8[(c + k) % 8];
            k = k + 1;
        }
        val va: u8x32 = pa:~u8x32;
        val vb: u8x32 = pb:~u8x32;
        val vc: u8x32 = pc:~u8x32;
        val sa: i8x32 = va:~i8x32;
        val sb: i8x32 = vb:~i8x32;
        val r_add: [32]u8 = add8(va, vb):~[32]u8;
        val r_sub: [32]u8 = sub8(va, vb):~[32]u8;
        val r_mul: [32]u8 = mul8(va, vb):~[32]u8;
        val r_and: [32]u8 = and8(va, vb):~[32]u8;
        val r_or: [32]u8 = or8(va, vb):~[32]u8;
        val r_xor: [32]u8 = xor8(va, vb):~[32]u8;
        val r_not: [32]u8 = not8(va):~[32]u8;
        val m_eq_s: [32]u8 = eq_s8(sa, sb):~[32]u8;
        val m_ne_s: [32]u8 = ne_s8(sa, sb):~[32]u8;
        val m_lt_s: [32]u8 = lt_s8(sa, sb):~[32]u8;
        val m_le_s: [32]u8 = le_s8(sa, sb):~[32]u8;
        val m_gt_s: [32]u8 = gt_s8(sa, sb):~[32]u8;
        val m_ge_s: [32]u8 = ge_s8(sa, sb):~[32]u8;
        val m_eq_u: [32]u8 = eq_u8(va, vb):~[32]u8;
        val m_ne_u: [32]u8 = ne_u8(va, vb):~[32]u8;
        val m_lt_u: [32]u8 = lt_u8(va, vb):~[32]u8;
        val m_le_u: [32]u8 = le_u8(va, vb):~[32]u8;
        val m_gt_u: [32]u8 = gt_u8(va, vb):~[32]u8;
        val m_ge_u: [32]u8 = ge_u8(va, vb):~[32]u8;
        val r_shl: [32]u8 = shl8(va, vc):~[32]u8;
        val r_shr: [32]u8 = shr8(va, vc):~[32]u8;
        val r_sar: [32]i8 = sar8(sa, vc:~i8x32):~[32]i8;
        val r_put: [32]u8 = put8(va, pb[1]):~[32]u8;
        k = 0;
        for (k < 32) {
            if (r_add[k] != (pa[k] + pb[k])) { ret 1; }
            if (r_sub[k] != (pa[k] - pb[k])) { ret 2; }
            if (r_mul[k] != (pa[k] * pb[k])) { ret 3; }
            if (r_and[k] != (pa[k] & pb[k])) { ret 4; }
