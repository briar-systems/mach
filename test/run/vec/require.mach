# targets: linux-x86_64 linux-x86_64-optimized linux-aarch64 linux-aarch64-optimized windows-x86_64
# flags:   --set simd=require
use std.runtime;

# shifts by a count per lane held in a local and passed as a parameter, built under
# `simd = "require"`, which refuses any vector operation taken lane by lane: a target's vector
# unit computes these shifts for any count, so a build with or without optimisation takes them

fun held16(x: u16x8, n: u16) u16x8 {
    val c: u16x8 = u16x8{n, n, n, n, 0 * n, 15 * n, 16 * n, 17 * n};
    ret x << c;
}

fun held32(x: i32x4, n: i32) i32x4 {
    val c: i32x4 = i32x4{n, n, n, n};
    ret x << c;
}

fun held64(x: u64x2, n: u64) u64x2 {
    val c: u64x2 = u64x2{n, 64 * n};
    ret x >> c;
}

fun passed16(x: i16x8, c: i16x8) i16x8 {
    ret x >> c;
}

fun passed32(x: i32x4, c: i32x4) i32x4 {
    ret x >> c;
}

fun passed64(x: u64x2, c: u64x2) u64x2 {
    ret x << c;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val a: u16x8 = held16(u16x8{1, 2, 3, 4, 5, 6, 7, 8}, argc::u16);
    if (a[0] != 2 || a[3] != 8 || a[4] != 5 || a[5] != 0 || a[6] != 0 || a[7] != 0) { ret 1; }
    val b: i32x4 = held32(i32x4{1, -2, 3, -4}, argc::i32);
    if (b[0] != 2 || b[1] != -4 || b[2] != 6 || b[3] != -8) { ret 2; }
    val c: u64x2 = held64(u64x2{6, 6}, argc::u64);
    if (c[0] != 3 || c[1] != 0) { ret 3; }
    val one: i16   = argc::i16;
    val d:   i16x8 = passed16(i16x8{-8, -8, -8, -8, 8, 8, 8, 8}, i16x8{0, one, 15 * one, 16 * one, -one, one, 2 * one, 3 * one});
    if (d[0] != -8 || d[1] != -4 || d[2] != -1 || d[3] != -1 || d[4] != 0 || d[5] != 4 || d[6] != 2 || d[7] != 1) { ret 4; }
    val n: i32   = argc::i32;
    val e: i32x4 = passed32(i32x4{-16, 16, -16, 16}, i32x4{n, 2 * n, 32 * n, -n});
    if (e[0] != -8 || e[1] != 4 || e[2] != -1 || e[3] != 0) { ret 5; }
    val f: u64x2 = passed64(u64x2{1, 1}, u64x2{63 * argc::u64, 64 * argc::u64});
    if (f[0] != 0x8000000000000000 || f[1] != 0) { ret 6; }
    ret 0;
}
