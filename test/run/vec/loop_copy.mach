use std.runtime;
use std.types.size.usize;

# copy and fill loops, which an optimised build turns into one copy or fill of the bytes they move where a test at
# run time admits it. each loop is checked against a twin the vectoriser leaves alone, over every distance between
# destination and source from two runs before to two runs past, both overlapping ways, for every length to past
# twice a vector of bytes, from starts that are not a multiple of any lane count. a forward element loop whose
# destination lies a little past its source repeats the first elements, which a copy of the whole run would not do,
# so a wrong test changes the result.

val SIZE: usize = 200;

#[inline("never")]
fun copy_u32(d: *u32, s: *u32, n: usize) {
    var i: usize = 0;
    for (i < n) {
        d[i] = s[i];
        i    = i + 1;
    }
}

#[inline("never")]
#[vectorize("never")]
fun twin_u32(d: *u32, s: *u32, n: usize) {
    var i: usize = 0;
    for (i < n) {
        d[i] = s[i];
        i    = i + 1;
    }
}

#[inline("never")]
fun copy_u8(d: *u8, s: *u8, n: usize) {
    var i: usize = 0;
    for (n > i) {
        d[i] = s[i];
        i    = i + 1;
    }
}

#[inline("never")]
#[vectorize("never")]
fun twin_u8(d: *u8, s: *u8, n: usize) {
    var i: usize = 0;
    for (n > i) {
        d[i] = s[i];
        i    = i + 1;
    }
}

# a count from a start that is not zero, ending where the index equals the bound
#[inline("never")]
fun copy_from(d: *u64, s: *u64, from: usize, to: usize) {
    var i: usize = from;
    for (i != to) {
        d[i] = s[i];
        i    = i + 1;
    }
}

#[inline("never")]
#[vectorize("never")]
fun twin_from(d: *u64, s: *u64, from: usize, to: usize) {
    var i: usize = from;
    for (i != to) {
        d[i] = s[i];
        i    = i + 1;
    }
}

# a signed count, which runs no trip for a bound at or below the start
#[inline("never")]
fun copy_signed(d: *u16, s: *u16, from: i64, to: i64) {
    var i: i64 = from;
    for (i < to) {
        d[i] = s[i];
        i    = i + 1;
    }
}

#[inline("never")]
fun fill_u8(d: *u8, x: u8, n: usize) {
    var i: usize = 0;
    for (i < n) {
        d[i] = x;
        i    = i + 1;
    }
}

#[inline("never")]
fun fill_zero(d: *u32, n: usize) {
    var i: usize = 0;
    for (i < n) {
        d[i] = 0;
        i    = i + 1;
    }
}

#[inline("never")]
fun fill_ones(d: *u64, n: usize) {
    var i: usize = 0;
    for (i < n) {
        d[i] = 0x0101010101010101;
        i    = i + 1;
    }
}

# bytes that differ, which no fill of one byte can store
#[inline("never")]
fun fill_mixed(d: *u32, n: usize) {
    var i: usize = 0;
    for (i < n) {
        d[i] = 0x01020304;
        i    = i + 1;
    }
}

fun seed_u32(a: *u32, b: *u32) {
    var i: usize = 0;
    for (i < SIZE) {
        val x: u32 = (i::u32 * 2654435761) ^ 0x5bd1e995;
        a[i] = x;
        b[i] = x;
        i    = i + 1;
    }
}

fun same_u32(a: *u32, b: *u32) u8 {
    var i: usize = 0;
    for (i < SIZE) {
        if (a[i] != b[i]) { ret 0; }
        i = i + 1;
    }
    ret 1;
}

fun seed_u8(a: *u8, b: *u8) {
    var i: usize = 0;
    for (i < SIZE) {
        val x: u8 = ((i * 37 + 11) & 0xff)::u8;
        a[i] = x;
        b[i] = x;
        i    = i + 1;
    }
}

fun same_u8(a: *u8, b: *u8) u8 {
    var i: usize = 0;
    for (i < SIZE) {
        if (a[i] != b[i]) { ret 0; }
        i = i + 1;
    }
    ret 1;
}

fun seed_u64(a: *u64, b: *u64) {
    var i: usize = 0;
    for (i < SIZE) {
        val x: u64 = i::u64 * 0x9e3779b97f4a7c15;
        a[i] = x;
        b[i] = x;
        i    = i + 1;
    }
}

fun same_u64(a: *u64, b: *u64) u8 {
    var i: usize = 0;
    for (i < SIZE) {
        if (a[i] != b[i]) { ret 0; }
        i = i + 1;
    }
    ret 1;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var a: [200]u32;
    var b: [200]u32;
    var p: [200]u8;
    var q: [200]u8;
    var w: [200]u64;
    var v: [200]u64;
    var h: [200]u16;
    var g: [200]u16;
    # every distance from 0 to 64 elements below and above the source, every length to 40, a start of 3
    var n: usize = 0;
    for (n <= 40) {
        var k: usize = 0;
        for (k <= 128) {
            seed_u32(?a[0], ?b[0]);
            copy_u32(?a[k + 3], ?a[67], n);
            twin_u32(?b[k + 3], ?b[67], n);
            if (same_u32(?a[0], ?b[0]) == 0) { ret 1; }
            seed_u8(?p[0], ?q[0]);
            copy_u8(?p[k], ?p[67], n);
            twin_u8(?q[k], ?q[67], n);
            if (same_u8(?p[0], ?q[0]) == 0) { ret 2; }
            k = k + 1;
        }
        n = n + 1;
    }
    # a start and a bound that are not zero, both ways round, and the copy into a second array
    var from: usize = 0;
    for (from <= 20) {
        var to: usize = from;
        for (to <= from + 37) {
            var k: usize = 0;
            for (k <= 70) {
                seed_u64(?w[0], ?v[0]);
                copy_from(?w[k], ?w[35], from, to);
                twin_from(?v[k], ?v[35], from, to);
                if (same_u64(?w[0], ?v[0]) == 0) { ret 3; }
                k = k + 1;
            }
            to = to + 1;
        }
        from = from + 1;
    }
    # a signed count: bounds below, at and past the start, a negative start
    var lo: i64 = -3;
    for (lo <= 5) {
        var hi: i64 = -6;
        for (hi <= 30) {
            var i: usize = 0;
            for (i < SIZE) {
                h[i] = (i * 3 + 1)::u16;
                g[i] = 0;
                i    = i + 1;
            }
            copy_signed(?g[40], ?h[40], lo, hi);
            i = 0;
            for (i < SIZE) {
                val j:    i64 = i::i64 - 40;
                var want: u16 = 0;
                if (j >= lo && j < hi) { want = (i * 3 + 1)::u16; }
                if (g[i] != want)      { ret 4; }
                i = i + 1;
            }
            hi = hi + 1;
        }
        lo = lo + 1;
    }
    # fills: one byte of any value, zero, equal bytes, and bytes that differ, each from an odd start
    n = 0;
    for (n <= 70) {
        seed_u8(?p[0], ?q[0]);
        fill_u8(?p[5], (argc + 0xa4)::u8, n);
        var i: usize = 0;
        for (i < SIZE) {
            var want: u8 = q[i];
            if (i >= 5 && i < 5 + n) { want = (argc + 0xa4)::u8; }
            if (p[i] != want)        { ret 5; }
            i = i + 1;
        }
        seed_u32(?a[0], ?b[0]);
        fill_zero(?a[3], n);
        fill_mixed(?b[3], n);
        i = 0;
        for (i < SIZE) {
            if (i >= 3 && i < 3 + n) {
                if (a[i] != 0 || b[i] != 0x01020304) { ret 6; }
            }
            or (a[i] != b[i]) { ret 7; }
            i = i + 1;
        }
        seed_u64(?w[0], ?v[0]);
        fill_ones(?w[1], n);
        i = 0;
        for (i < SIZE) {
            var want: u64 = v[i];
            if (i >= 1 && i < 1 + n) { want = 0x0101010101010101; }
            if (w[i] != want)        { ret 8; }
            i = i + 1;
        }
        n = n + 1;
    }
    ret 0;
}
