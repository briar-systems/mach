# targets: linux-riscv64-v
use std.runtime;

# a load, two adds and a store of one vector type and length run under one vsetivli: each rvv
# instruction states its vtype and vector length, and the configure step establishes a state only
# where it differs from the one in force (linux-riscv64-v.target holds `corpus_configured` to its size)

#[symbol("corpus_configured")]
fun triple(p: *i32x4, q: *i32x4) {
    val a: i32x4 = @p;
    @q = a + a + a;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var x: i32x4 = i32x4{argc::i32, 2, 3, -4};
    var y: i32x4 = i32x4{0, 0, 0, 0};
    triple(?x, ?y);
    if (y[0] != 3 || y[1] != 6 || y[2] != 9 || y[3] != -12) { ret 1; }
    ret 0;
}
