# targets: wasi-wasm32-simd128 wasi-wasm32-simd128-optimized
# flags:   --set simd=require
use std.runtime;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.size.usize;

# the lanewise rows of simd128, each instruction keyed on the lane type it reads, built under
# `simd = "require"`, which refuses any vector operation taken lane by lane, and checked lane by
# lane against the scalar operation over every pair of the edge values: 0, 1, all ones, the
# signed minimum and maximum and their neighbours. integer sums, differences, products (bytes in
# wasm_seq_lanes.mach), bitwise operations, comparisons as masks (unsigned 64-bit ones there too), lane
# reads and writes, shuffles and the float arithmetic and comparisons, nan, the infinities, signed zero and
# integers past the bounds among the float edges, and the conversions between 32-bit integer and float lanes

val EDGE8: [8]u8 = [8]u8{0x0, 0x1, 0xff, 0x80, 0x7f, 0x2, 0x81, 0x7e};
val EDGE16: [8]u16 = [8]u16{0x0, 0x1, 0xffff, 0x8000, 0x7fff, 0x2, 0x8001, 0x7ffe};
val EDGE32: [8]u32 = [8]u32{0x0, 0x1, 0xffffffff, 0x80000000, 0x7fffffff, 0x2, 0x80000001, 0x7ffffffe};
val EDGE64: [8]u64 = [8]u64{0x0, 0x1, 0xffffffffffffffff, 0x8000000000000000, 0x7fffffffffffffff, 0x2, 0x8000000000000001, 0x7ffffffffffffffe};
val FBITS32: [8]u32 = [8]u32{0x00000000, 0x80000000, 0x3f800000, 0xcf000000, 0x4f800000, 0x7f800000, 0xff800000, 0x7fc00000};
val FBITS64: [8]u64 = [8]u64{0x0000000000000000, 0x8000000000000000, 0x3ff0000000000000, 0xc1e0000000000000, 0x7ff0000000000000, 0xfff0000000000000, 0x0000000000000001, 0x7ff8000000000000};

fun mask8(b: bool) u8 {
    if (b) { ret 0xff; }
    ret 0;
}

fun mask16(b: bool) u16 {
    if (b) { ret 0xffff; }
    ret 0;
}

fun mask32(b: bool) u32 {
    if (b) { ret 0xffffffff; }
    ret 0;
}

fun mask64(b: bool) u64 {
    if (b) { ret 0xffffffffffffffff; }
    ret 0;
}

fun add8(a: u8x16, b: u8x16) u8x16 {
    ret a + b;
}

fun sub8(a: u8x16, b: u8x16) u8x16 {
    ret a - b;
}

fun and8(a: u8x16, b: u8x16) u8x16 {
    ret a & b;
}

fun or8(a: u8x16, b: u8x16) u8x16 {
    ret a | b;
}

fun xor8(a: u8x16, b: u8x16) u8x16 {
    ret a ^ b;
}

fun not8(a: u8x16) u8x16 {
    ret ~a;
}

fun eq_s8(a: i8x16, b: i8x16) u8x16 {
    ret a == b;
}

fun ne_s8(a: i8x16, b: i8x16) u8x16 {
    ret a != b;
}

fun lt_s8(a: i8x16, b: i8x16) u8x16 {
    ret a < b;
}

fun le_s8(a: i8x16, b: i8x16) u8x16 {
    ret a <= b;
}

fun gt_s8(a: i8x16, b: i8x16) u8x16 {
    ret a > b;
}

fun ge_s8(a: i8x16, b: i8x16) u8x16 {
    ret a >= b;
}

fun eq_u8(a: u8x16, b: u8x16) u8x16 {
    ret a == b;
}

fun ne_u8(a: u8x16, b: u8x16) u8x16 {
    ret a != b;
}

fun lt_u8(a: u8x16, b: u8x16) u8x16 {
    ret a < b;
}

fun le_u8(a: u8x16, b: u8x16) u8x16 {
    ret a <= b;
}

fun gt_u8(a: u8x16, b: u8x16) u8x16 {
    ret a > b;
}

fun ge_u8(a: u8x16, b: u8x16) u8x16 {
    ret a >= b;
}

fun read8(a: u8x16) u8 {
    ret a[1];
}

fun write8(a: u8x16, x: u8) u8x16 {
    var v: u8x16 = a;
    v[0] = x;
    ret v;
}

fun mid8(a: u8x32) u8x16 {
    ret a[8, 16];
}

