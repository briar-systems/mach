# 0 where every integer row of 8-bit lanes matches the scalar operation, else the failing code
fun pairs8(argc: i64, code: i64) i64 {
    val flip: u8 = (argc - 1)::u8;
    var c: usize = 0;
    for (c < 64) {
        var pa: [16]u8;
        var pb: [16]u8;
        var k: usize = 0;
        for (k < 16) {
            pa[k] = EDGE8[(c + k) / 8] ^ flip;
            pb[k] = EDGE8[(c + k) % 8] ^ flip;
            k = k + 1;
        }
        val va: u8x16 = pa:~u8x16;
        val vb: u8x16 = pb:~u8x16;
        val sa: i8x16 = va:~i8x16;
        val sb: i8x16 = vb:~i8x16;
        val r_add: [16]u8 = add8(va, vb):~[16]u8;
        val r_sub: [16]u8 = sub8(va, vb):~[16]u8;
        val r_and: [16]u8 = and8(va, vb):~[16]u8;
        val r_or: [16]u8 = or8(va, vb):~[16]u8;
        val r_xor: [16]u8 = xor8(va, vb):~[16]u8;
        val r_not: [16]u8 = not8(va):~[16]u8;
        val m_eq_s: [16]u8 = eq_s8(sa, sb):~[16]u8;
        val m_ne_s: [16]u8 = ne_s8(sa, sb):~[16]u8;
        val m_lt_s: [16]u8 = lt_s8(sa, sb):~[16]u8;
        val m_le_s: [16]u8 = le_s8(sa, sb):~[16]u8;
        val m_gt_s: [16]u8 = gt_s8(sa, sb):~[16]u8;
        val m_ge_s: [16]u8 = ge_s8(sa, sb):~[16]u8;
        val m_eq_u: [16]u8 = eq_u8(va, vb):~[16]u8;
        val m_ne_u: [16]u8 = ne_u8(va, vb):~[16]u8;
        val m_lt_u: [16]u8 = lt_u8(va, vb):~[16]u8;
        val m_le_u: [16]u8 = le_u8(va, vb):~[16]u8;
        val m_gt_u: [16]u8 = gt_u8(va, vb):~[16]u8;
        val m_ge_u: [16]u8 = ge_u8(va, vb):~[16]u8;
        val r_write: [16]u8 = write8(va, pb[1]):~[16]u8;
        if (read8(va) != pa[1]) { ret code; }
        if (r_write[0] != pb[1]) { ret code; }
        var pj: [32]u8;
        k = 0;
        for (k < 16) {
            pj[k] = pa[k];
            pj[k + 16] = pb[k];
            k = k + 1;
        }
        val r_mid: [16]u8 = mid8(pj:~u8x32):~[16]u8;
        k = 0;
        for (k < 16) {
            if (r_add[k] != (pa[k] + pb[k])) { ret code + 1; }
            if (r_sub[k] != (pa[k] - pb[k])) { ret code + 2; }
            if (r_and[k] != (pa[k] & pb[k])) { ret code + 3; }
            if (r_or[k] != (pa[k] | pb[k])) { ret code + 4; }
            if (r_xor[k] != (pa[k] ^ pb[k])) { ret code + 5; }
            if (r_not[k] != ~pa[k]) { ret code + 6; }
            if (m_eq_s[k] != mask8(pa[k]:~i8 == pb[k]:~i8)) { ret code + 7; }
            if (m_ne_s[k] != mask8(pa[k]:~i8 != pb[k]:~i8)) { ret code + 8; }
            if (m_lt_s[k] != mask8(pa[k]:~i8 < pb[k]:~i8)) { ret code + 9; }
            if (m_le_s[k] != mask8(pa[k]:~i8 <= pb[k]:~i8)) { ret code + 10; }
            if (m_gt_s[k] != mask8(pa[k]:~i8 > pb[k]:~i8)) { ret code + 11; }
            if (m_ge_s[k] != mask8(pa[k]:~i8 >= pb[k]:~i8)) { ret code + 12; }
            if (m_eq_u[k] != mask8(pa[k] == pb[k])) { ret code + 13; }
            if (m_ne_u[k] != mask8(pa[k] != pb[k])) { ret code + 14; }
            if (m_lt_u[k] != mask8(pa[k] < pb[k])) { ret code + 15; }
            if (m_le_u[k] != mask8(pa[k] <= pb[k])) { ret code + 16; }
            if (m_gt_u[k] != mask8(pa[k] > pb[k])) { ret code + 17; }
            if (m_ge_u[k] != mask8(pa[k] >= pb[k])) { ret code + 18; }
            if (k != 0 && r_write[k] != pa[k]) { ret code + 19; }
            if (r_mid[k] != pj[k + 8]) { ret code + 20; }
            k = k + 1;
        }
        c = c + 16;
    }
    ret 0;
}

# 0 where every integer row of 16-bit lanes matches the scalar operation, else the failing code
fun pairs16(argc: i64, code: i64) i64 {
    val flip: u16 = (argc - 1)::u16;
    var c: usize = 0;
    for (c < 64) {
        var pa: [8]u16;
        var pb: [8]u16;
        var k: usize = 0;
        for (k < 8) {
            pa[k] = EDGE16[(c + k) / 8] ^ flip;
            pb[k] = EDGE16[(c + k) % 8] ^ flip;
            k = k + 1;
        }
        val va: u16x8 = pa:~u16x8;
        val vb: u16x8 = pb:~u16x8;
        val sa: i16x8 = va:~i16x8;
        val sb: i16x8 = vb:~i16x8;
        val r_add: [8]u16 = add16(va, vb):~[8]u16;
        val r_sub: [8]u16 = sub16(va, vb):~[8]u16;
        val r_mul: [8]u16 = mul16(va, vb):~[8]u16;
        val r_and: [8]u16 = and16(va, vb):~[8]u16;
        val r_or: [8]u16 = or16(va, vb):~[8]u16;
        val r_xor: [8]u16 = xor16(va, vb):~[8]u16;
        val r_not: [8]u16 = not16(va):~[8]u16;
        val m_eq_s: [8]u16 = eq_s16(sa, sb):~[8]u16;
        val m_ne_s: [8]u16 = ne_s16(sa, sb):~[8]u16;
        val m_lt_s: [8]u16 = lt_s16(sa, sb):~[8]u16;
        val m_le_s: [8]u16 = le_s16(sa, sb):~[8]u16;
        val m_gt_s: [8]u16 = gt_s16(sa, sb):~[8]u16;
        val m_ge_s: [8]u16 = ge_s16(sa, sb):~[8]u16;
        val m_eq_u: [8]u16 = eq_u16(va, vb):~[8]u16;
        val m_ne_u: [8]u16 = ne_u16(va, vb):~[8]u16;
        val m_lt_u: [8]u16 = lt_u16(va, vb):~[8]u16;
        val m_le_u: [8]u16 = le_u16(va, vb):~[8]u16;
        val m_gt_u: [8]u16 = gt_u16(va, vb):~[8]u16;
        val m_ge_u: [8]u16 = ge_u16(va, vb):~[8]u16;
        val r_write: [8]u16 = write16(va, pb[1]):~[8]u16;
        if (read16(va) != pa[1]) { ret code; }
        if (r_write[0] != pb[1]) { ret code; }
        var pj: [16]u16;
        k = 0;
        for (k < 8) {
            pj[k] = pa[k];
            pj[k + 8] = pb[k];
            k = k + 1;
        }
        val r_mid: [8]u16 = mid16(pj:~u16x16):~[8]u16;
        k = 0;
        for (k < 8) {
            if (r_add[k] != (pa[k] + pb[k])) { ret code + 1; }
            if (r_sub[k] != (pa[k] - pb[k])) { ret code + 2; }
            if (r_mul[k] != (pa[k] * pb[k])) { ret code + 3; }
            if (r_and[k] != (pa[k] & pb[k])) { ret code + 4; }
            if (r_or[k] != (pa[k] | pb[k])) { ret code + 5; }
            if (r_xor[k] != (pa[k] ^ pb[k])) { ret code + 6; }
            if (r_not[k] != ~pa[k]) { ret code + 7; }
            if (m_eq_s[k] != mask16(pa[k]:~i16 == pb[k]:~i16)) { ret code + 8; }
            if (m_ne_s[k] != mask16(pa[k]:~i16 != pb[k]:~i16)) { ret code + 9; }
            if (m_lt_s[k] != mask16(pa[k]:~i16 < pb[k]:~i16)) { ret code + 10; }
            if (m_le_s[k] != mask16(pa[k]:~i16 <= pb[k]:~i16)) { ret code + 11; }
            if (m_gt_s[k] != mask16(pa[k]:~i16 > pb[k]:~i16)) { ret code + 12; }
            if (m_ge_s[k] != mask16(pa[k]:~i16 >= pb[k]:~i16)) { ret code + 13; }
            if (m_eq_u[k] != mask16(pa[k] == pb[k])) { ret code + 14; }
            if (m_ne_u[k] != mask16(pa[k] != pb[k])) { ret code + 15; }
            if (m_lt_u[k] != mask16(pa[k] < pb[k])) { ret code + 16; }
            if (m_le_u[k] != mask16(pa[k] <= pb[k])) { ret code + 17; }
            if (m_gt_u[k] != mask16(pa[k] > pb[k])) { ret code + 18; }
            if (m_ge_u[k] != mask16(pa[k] >= pb[k])) { ret code + 19; }
            if (k != 0 && r_write[k] != pa[k]) { ret code + 20; }
            if (r_mid[k] != pj[k + 4]) { ret code + 21; }
            k = k + 1;
        }
        c = c + 8;
    }
    ret 0;
}

# 0 where every integer row of 32-bit lanes matches the scalar operation, else the failing code
fun pairs32(argc: i64, code: i64) i64 {
    val flip: u32 = (argc - 1)::u32;
    var c: usize = 0;
    for (c < 64) {
        var pa: [4]u32;
        var pb: [4]u32;
        var k: usize = 0;
        for (k < 4) {
            pa[k] = EDGE32[(c + k) / 8] ^ flip;
            pb[k] = EDGE32[(c + k) % 8] ^ flip;
            k = k + 1;
        }
        val va: u32x4 = pa:~u32x4;
        val vb: u32x4 = pb:~u32x4;
        val sa: i32x4 = va:~i32x4;
        val sb: i32x4 = vb:~i32x4;
        val r_add: [4]u32 = add32(va, vb):~[4]u32;
        val r_sub: [4]u32 = sub32(va, vb):~[4]u32;
        val r_mul: [4]u32 = mul32(va, vb):~[4]u32;
        val r_and: [4]u32 = and32(va, vb):~[4]u32;
        val r_or: [4]u32 = or32(va, vb):~[4]u32;
        val r_xor: [4]u32 = xor32(va, vb):~[4]u32;
        val r_not: [4]u32 = not32(va):~[4]u32;
        val m_eq_s: [4]u32 = eq_s32(sa, sb):~[4]u32;
        val m_ne_s: [4]u32 = ne_s32(sa, sb):~[4]u32;
        val m_lt_s: [4]u32 = lt_s32(sa, sb):~[4]u32;
        val m_le_s: [4]u32 = le_s32(sa, sb):~[4]u32;
        val m_gt_s: [4]u32 = gt_s32(sa, sb):~[4]u32;
        val m_ge_s: [4]u32 = ge_s32(sa, sb):~[4]u32;
        val m_eq_u: [4]u32 = eq_u32(va, vb):~[4]u32;
        val m_ne_u: [4]u32 = ne_u32(va, vb):~[4]u32;
        val m_lt_u: [4]u32 = lt_u32(va, vb):~[4]u32;
        val m_le_u: [4]u32 = le_u32(va, vb):~[4]u32;
        val m_gt_u: [4]u32 = gt_u32(va, vb):~[4]u32;
        val m_ge_u: [4]u32 = ge_u32(va, vb):~[4]u32;
        val r_write: [4]u32 = write32(va, pb[1]):~[4]u32;
        if (read32(va) != pa[1]) { ret code; }
        if (r_write[0] != pb[1]) { ret code; }
        var pj: [8]u32;
        k = 0;
        for (k < 4) {
            pj[k] = pa[k];
            pj[k + 4] = pb[k];
            k = k + 1;
        }
        val r_mid: [4]u32 = mid32(pj:~u32x8):~[4]u32;
        k = 0;
        for (k < 4) {
            if (r_add[k] != (pa[k] + pb[k])) { ret code + 1; }
            if (r_sub[k] != (pa[k] - pb[k])) { ret code + 2; }
            if (r_mul[k] != (pa[k] * pb[k])) { ret code + 3; }
            if (r_and[k] != (pa[k] & pb[k])) { ret code + 4; }
            if (r_or[k] != (pa[k] | pb[k])) { ret code + 5; }
            if (r_xor[k] != (pa[k] ^ pb[k])) { ret code + 6; }
            if (r_not[k] != ~pa[k]) { ret code + 7; }
            if (m_eq_s[k] != mask32(pa[k]:~i32 == pb[k]:~i32)) { ret code + 8; }
            if (m_ne_s[k] != mask32(pa[k]:~i32 != pb[k]:~i32)) { ret code + 9; }
            if (m_lt_s[k] != mask32(pa[k]:~i32 < pb[k]:~i32)) { ret code + 10; }
            if (m_le_s[k] != mask32(pa[k]:~i32 <= pb[k]:~i32)) { ret code + 11; }
            if (m_gt_s[k] != mask32(pa[k]:~i32 > pb[k]:~i32)) { ret code + 12; }
            if (m_ge_s[k] != mask32(pa[k]:~i32 >= pb[k]:~i32)) { ret code + 13; }
            if (m_eq_u[k] != mask32(pa[k] == pb[k])) { ret code + 14; }
            if (m_ne_u[k] != mask32(pa[k] != pb[k])) { ret code + 15; }
            if (m_lt_u[k] != mask32(pa[k] < pb[k])) { ret code + 16; }
            if (m_le_u[k] != mask32(pa[k] <= pb[k])) { ret code + 17; }
            if (m_gt_u[k] != mask32(pa[k] > pb[k])) { ret code + 18; }
            if (m_ge_u[k] != mask32(pa[k] >= pb[k])) { ret code + 19; }
            if (k != 0 && r_write[k] != pa[k]) { ret code + 20; }
            if (r_mid[k] != pj[k + 2]) { ret code + 21; }
            k = k + 1;
        }
        c = c + 4;
    }
    ret 0;
}

# 0 where every integer row of 64-bit lanes matches the scalar operation, else the failing code
fun pairs64(argc: i64, code: i64) i64 {
    val flip: u64 = (argc - 1)::u64;
    var c: usize = 0;
    for (c < 64) {
        var pa: [2]u64;
        var pb: [2]u64;
        var k: usize = 0;
        for (k < 2) {
            pa[k] = EDGE64[(c + k) / 8] ^ flip;
            pb[k] = EDGE64[(c + k) % 8] ^ flip;
            k = k + 1;
        }
        val va: u64x2 = pa:~u64x2;
        val vb: u64x2 = pb:~u64x2;
        val sa: i64x2 = va:~i64x2;
        val sb: i64x2 = vb:~i64x2;
        val r_add: [2]u64 = add64(va, vb):~[2]u64;
        val r_sub: [2]u64 = sub64(va, vb):~[2]u64;
        val r_mul: [2]u64 = mul64(va, vb):~[2]u64;
        val r_and: [2]u64 = and64(va, vb):~[2]u64;
        val r_or: [2]u64 = or64(va, vb):~[2]u64;
        val r_xor: [2]u64 = xor64(va, vb):~[2]u64;
        val r_not: [2]u64 = not64(va):~[2]u64;
        val m_eq_s: [2]u64 = eq_s64(sa, sb):~[2]u64;
        val m_ne_s: [2]u64 = ne_s64(sa, sb):~[2]u64;
        val m_lt_s: [2]u64 = lt_s64(sa, sb):~[2]u64;
        val m_le_s: [2]u64 = le_s64(sa, sb):~[2]u64;
        val m_gt_s: [2]u64 = gt_s64(sa, sb):~[2]u64;
        val m_ge_s: [2]u64 = ge_s64(sa, sb):~[2]u64;
        val r_write: [2]u64 = write64(va, pb[1]):~[2]u64;
        if (read64(va) != pa[1]) { ret code; }
        if (r_write[0] != pb[1]) { ret code; }
        var pj: [4]u64;
        k = 0;
        for (k < 2) {
            pj[k] = pa[k];
            pj[k + 2] = pb[k];
            k = k + 1;
        }
        val r_mid: [2]u64 = mid64(pj:~u64x4):~[2]u64;
        k = 0;
        for (k < 2) {
            if (r_add[k] != (pa[k] + pb[k])) { ret code + 1; }
            if (r_sub[k] != (pa[k] - pb[k])) { ret code + 2; }
            if (r_mul[k] != (pa[k] * pb[k])) { ret code + 3; }
            if (r_and[k] != (pa[k] & pb[k])) { ret code + 4; }
            if (r_or[k] != (pa[k] | pb[k])) { ret code + 5; }
            if (r_xor[k] != (pa[k] ^ pb[k])) { ret code + 6; }
            if (r_not[k] != ~pa[k]) { ret code + 7; }
            if (m_eq_s[k] != mask64(pa[k]:~i64 == pb[k]:~i64)) { ret code + 8; }
            if (m_ne_s[k] != mask64(pa[k]:~i64 != pb[k]:~i64)) { ret code + 9; }
            if (m_lt_s[k] != mask64(pa[k]:~i64 < pb[k]:~i64)) { ret code + 10; }
            if (m_le_s[k] != mask64(pa[k]:~i64 <= pb[k]:~i64)) { ret code + 11; }
            if (m_gt_s[k] != mask64(pa[k]:~i64 > pb[k]:~i64)) { ret code + 12; }
            if (m_ge_s[k] != mask64(pa[k]:~i64 >= pb[k]:~i64)) { ret code + 13; }
            if (k != 0 && r_write[k] != pa[k]) { ret code + 14; }
            if (r_mid[k] != pj[k + 1]) { ret code + 15; }
            k = k + 1;
        }
        c = c + 2;
    }
    ret 0;
}

fun itof_s(a: i32x4) f32x4 {
    ret a::f32x4;
}

fun itof_u(a: u32x4) f32x4 {
    ret a::f32x4;
}

fun ftoi_s(a: f32x4) i32x4 {
    ret a::i32x4;
}

fun ftoi_u(a: f32x4) u32x4 {
    ret a::u32x4;
}

fun same32(a: u32, b: u32) bool {
    val nan: u32 = (((1::u32 << 8) - 1) << 23);
    if ((a & nan) == nan && (a & ((1::u32 << 23) - 1)) != 0 && (b & nan) == nan && (b & ((1::u32 << 23) - 1)) != 0) { ret true; }
    ret a == b;
}

fun same64(a: u64, b: u64) bool {
    val nan: u64 = (((1::u64 << 11) - 1) << 52);
    if ((a & nan) == nan && (a & ((1::u64 << 52) - 1)) != 0 && (b & nan) == nan && (b & ((1::u64 << 52) - 1)) != 0) { ret true; }
    ret a == b;
}

# 0 where every float row of 32-bit lanes matches the scalar operation, bit for bit, else the failing code
fun floats32(code: i64) i64 {
    var c: usize = 0;
    for (c < 64) {
        var pa: [4]f32;
        var pb: [4]f32;
        var k: usize = 0;
        for (k < 4) {
            pa[k] = FBITS32[(c + k) / 8]:~f32;
            pb[k] = FBITS32[(c + k) % 8]:~f32;
            k = k + 1;
        }
        val va: f32x4 = pa:~f32x4;
        val vb: f32x4 = pb:~f32x4;
        val r_fadd: [4]u32 = fadd32(va, vb):~[4]u32;
        val r_fsub: [4]u32 = fsub32(va, vb):~[4]u32;
        val r_fmul: [4]u32 = fmul32(va, vb):~[4]u32;
        val r_fdiv: [4]u32 = fdiv32(va, vb):~[4]u32;
        val m_feq: [4]u32 = feq32(va, vb):~[4]u32;
        val m_fne: [4]u32 = fne32(va, vb):~[4]u32;
        val m_flt: [4]u32 = flt32(va, vb):~[4]u32;
        val m_fle: [4]u32 = fle32(va, vb):~[4]u32;
        val c_s: [4]u32 = itof_s(va:~i32x4):~[4]u32;
        val c_u: [4]u32 = itof_u(va:~u32x4):~[4]u32;
        val t_s: [4]i32 = ftoi_s(va):~[4]i32;
        val t_u: [4]u32 = ftoi_u(va):~[4]u32;
        k = 0;
        for (k < 4) {
            if (!same32(r_fadd[k], (pa[k] + pb[k]):~u32)) { ret code + 0; }
            if (!same32(r_fsub[k], (pa[k] - pb[k]):~u32)) { ret code + 1; }
            if (!same32(r_fmul[k], (pa[k] * pb[k]):~u32)) { ret code + 2; }
            if (!same32(r_fdiv[k], (pa[k] / pb[k]):~u32)) { ret code + 3; }
            if (m_feq[k] != mask32(pa[k] == pb[k])) { ret code + 4; }
            if (m_fne[k] != mask32(pa[k] != pb[k])) { ret code + 5; }
            if (m_flt[k] != mask32(pa[k] < pb[k])) { ret code + 6; }
            if (m_fle[k] != mask32(pa[k] <= pb[k])) { ret code + 7; }
            if (c_s[k] != (pa[k]:~i32)::f32:~u32) { ret code + 8; }
            if (c_u[k] != (pa[k]:~u32)::f32:~u32) { ret code + 9; }
            if (t_s[k] != pa[k]::i32) { ret code + 10; }
            if (t_u[k] != pa[k]::u32) { ret code + 11; }
            k = k + 1;
        }
        c = c + 4;
    }
    ret 0;
}

# 0 where every float row of 64-bit lanes matches the scalar operation, bit for bit, else the failing code
fun floats64(code: i64) i64 {
    var c: usize = 0;
    for (c < 64) {
        var pa: [2]f64;
        var pb: [2]f64;
        var k: usize = 0;
        for (k < 2) {
            pa[k] = FBITS64[(c + k) / 8]:~f64;
            pb[k] = FBITS64[(c + k) % 8]:~f64;
            k = k + 1;
        }
        val va: f64x2 = pa:~f64x2;
        val vb: f64x2 = pb:~f64x2;
        val r_fadd: [2]u64 = fadd64(va, vb):~[2]u64;
        val r_fsub: [2]u64 = fsub64(va, vb):~[2]u64;
        val r_fmul: [2]u64 = fmul64(va, vb):~[2]u64;
        val r_fdiv: [2]u64 = fdiv64(va, vb):~[2]u64;
        val m_feq: [2]u64 = feq64(va, vb):~[2]u64;
        val m_fne: [2]u64 = fne64(va, vb):~[2]u64;
        val m_flt: [2]u64 = flt64(va, vb):~[2]u64;
        val m_fle: [2]u64 = fle64(va, vb):~[2]u64;
        k = 0;
        for (k < 2) {
            if (!same64(r_fadd[k], (pa[k] + pb[k]):~u64)) { ret code + 0; }
            if (!same64(r_fsub[k], (pa[k] - pb[k]):~u64)) { ret code + 1; }
            if (!same64(r_fmul[k], (pa[k] * pb[k]):~u64)) { ret code + 2; }
            if (!same64(r_fdiv[k], (pa[k] / pb[k]):~u64)) { ret code + 3; }
            if (m_feq[k] != mask64(pa[k] == pb[k])) { ret code + 4; }
            if (m_fne[k] != mask64(pa[k] != pb[k])) { ret code + 5; }
            if (m_flt[k] != mask64(pa[k] < pb[k])) { ret code + 6; }
            if (m_fle[k] != mask64(pa[k] <= pb[k])) { ret code + 7; }
            k = k + 1;
        }
        c = c + 2;
    }
    ret 0;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var r: i64 = 0;
    r = pairs8(argc, 1);
    if (r != 0) { ret r; }
    r = pairs16(argc, 41);
    if (r != 0) { ret r; }
    r = pairs32(argc, 81);
    if (r != 0) { ret r; }
    r = pairs64(argc, 121);
    if (r != 0) { ret r; }
    r = floats32(161);
    if (r != 0) { ret r; }
    r = floats64(175);
    if (r != 0) { ret r; }
    ret 0;
}
