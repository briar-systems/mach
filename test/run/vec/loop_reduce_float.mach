# flags: --set relax=["float-reassoc"]
# reports: vectorise loop_reduce_float.loop_reduce_float.sum_f32 1
use std.runtime;
use std.types.size.usize;

# float reductions under the float-reassoc relaxation, which an optimised build regroups into a vector of partial
# values. the values are chosen so every grouping gives one result: sums and dot products of small integers and
# products of powers of two, from trips of none and one up past several vectors. the identity each lane starts at
# keeps signed zeros, so a sum of negative zeros from a negative zero stays negative and one from a positive zero
# stays positive, and a nan anywhere in the run makes the result a nan.

val SIZE: usize = 200;

#[inline("never")]
fun sum_f32(a: *f32, n: usize, s0: f32) f32 {
    var s: f32   = s0;
    var i: usize = 0;
    for (i < n) {
        s = s + a[i];
        i = i + 1;
    }
    ret s;
}

#[inline("never")]
fun product_f64(a: *f64, n: usize) f64 {
    var p: f64   = 1.0;
    var i: usize = 0;
    for (i < n) {
        p = a[i] * p;
        i = i + 1;
    }
    ret p;
}

#[inline("never")]
fun dot_f64(a: *f64, b: *f64, n: usize) f64 {
    var d: f64   = 0.0;
    var i: usize = 0;
    for (i < n) {
        d = d + a[i] * b[i];
        i = i + 1;
    }
    ret d;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var a: [200]f32;
    var z: [200]f32;
    var q: [200]f32;
    var p: [200]f64;
    var x: [200]f64;
    var y: [200]f64;
    var i: usize = 0;
    for (i < SIZE) {
        a[i] = (i % 13)::f32 - 6.0;
        z[i] = -0.0;
        q[i] = 1.0;
        p[i] = 2.0;
        if ((i & 1) == 1) { p[i] = 0.5; }
        x[i] = (i % 7)::f64;
        y[i] = 3.0 - (i % 5)::f64;
        i    = i + 1;
    }
    val s0: f32   = (argc - 1)::f32;
    var n:  usize = 0;
    for (n <= 100) {
        var want: f32   = s0;
        var dot:  f64   = 0.0;
        var j:    usize = 0;
        for (j < n) {
            want = want + a[j + 1];
            dot  = dot + x[j + 2] * y[j];
            j    = j + 1;
        }
        if (sum_f32(?a[1], n, s0) != want) { ret 1; }
        var prod: f64 = 1.0;
        if ((n & 1) == 1)                    { prod = 2.0; }
        if (product_f64(?p[0], n) != prod)   { ret 2; }
        if (dot_f64(?x[2], ?y[0], n) != dot) { ret 3; }
        # negative zeros from a negative zero, and from a positive zero
        if (sum_f32(?z[3], n, -0.0):~u32 != 0x80000000) { ret 4; }
        if (sum_f32(?z[3], n, 0.0):~u32 != 0)           { ret 5; }
        n = n + 1;
    }
    # a nan at every place of runs of every length past it
    var at: usize = 0;
    for (at < 40) {
        q[at] = 0.0 / (argc - 1)::f32;
        n     = at + 1;
        for (n <= 70) {
            val r: f32 = sum_f32(?q[0], n, 0.0);
            if (r == r) { ret 6; }
            n = n + 1;
        }
        if (sum_f32(?q[0], at, 0.0) != at::f32) { ret 7; }
        q[at] = 1.0;
        at    = at + 1;
    }
    ret 0;
}
