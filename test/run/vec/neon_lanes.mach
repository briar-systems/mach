# targets: linux-aarch64
# flags:   --set simd=require
use std.runtime;
use std.types.bool.bool;
use std.types.size.usize;

# the neon rows the admission rule gains, built under `simd = "require"`, each lane checked against
# the scalar cast over the edge values: the conversions between 32-bit integers and binary32 and
# between 64-bit integers and binary64, both ways, signed and unsigned, saturating at the bounds and
# giving 0 for a nan as the scalar casts do, at 8 and 16 bytes

val EDGE8: [8]u8 = [8]u8{0x0, 0x1, 0xff, 0x80, 0x7f, 0x2, 0x81, 0x7e};
val COUNT8: [8]u8 = [8]u8{0x0, 0x1, 0x7, 0x8, 0x9, 0xff, 0x10, 0x80};
val EDGE16: [8]u16 = [8]u16{0x0, 0x1, 0xffff, 0x8000, 0x7fff, 0x2, 0x8001, 0x7ffe};
val COUNT16: [8]u16 = [8]u16{0x0, 0x1, 0xf, 0x10, 0x11, 0xffff, 0x20, 0x8000};
val EDGE32: [8]u32 = [8]u32{0x0, 0x1, 0xffffffff, 0x80000000, 0x7fffffff, 0x2, 0x80000001, 0x7ffffffe};
val COUNT32: [8]u32 = [8]u32{0x0, 0x1, 0x1f, 0x20, 0x21, 0xffffffff, 0x40, 0x80000000};
val EDGE64: [8]u64 = [8]u64{0x0, 0x1, 0xffffffffffffffff, 0x8000000000000000, 0x7fffffffffffffff, 0x2, 0x8000000000000001, 0x7ffffffffffffffe};
val COUNT64: [8]u64 = [8]u64{0x0, 0x1, 0x3f, 0x40, 0x41, 0xffffffffffffffff, 0x80, 0x8000000000000000};
val FBITS32: [8]u32 = [8]u32{0x00000000, 0x80000000, 0x3f800000, 0xcf000000, 0x4f800000, 0x7f800000, 0xff800000, 0x7fc00000};
val FBITS64: [8]u64 = [8]u64{0x0000000000000000, 0x8000000000000000, 0x3ff0000000000000, 0xc1e0000000000000, 0x7ff0000000000000, 0xfff0000000000000, 0x0000000000000001, 0x7ff8000000000000};

fun mask8(b: bool) u8 {
    if (b) { ret 0xff; }
    ret 0;
}

fun shl_ref8(a: u8, c: u8) u8 {
    if (c >= 8) { ret 0; }
    ret a << c;
}

fun shr_ref8(a: u8, c: u8) u8 {
    if (c >= 8) { ret 0; }
    ret a >> c;
}

fun sar_ref8(a: i8, c: u8) i8 {
    if (c >= 8) { ret a >> 7; }
    ret a >> c;
}

fun mask16(b: bool) u16 {
    if (b) { ret 0xffff; }
    ret 0;
}

fun shl_ref16(a: u16, c: u16) u16 {
    if (c >= 16) { ret 0; }
    ret a << c;
}

fun shr_ref16(a: u16, c: u16) u16 {
    if (c >= 16) { ret 0; }
    ret a >> c;
}

fun sar_ref16(a: i16, c: u16) i16 {
    if (c >= 16) { ret a >> 15; }
    ret a >> c;
}

fun mask32(b: bool) u32 {
    if (b) { ret 0xffffffff; }
    ret 0;
}

fun shl_ref32(a: u32, c: u32) u32 {
    if (c >= 32) { ret 0; }
    ret a << c;
}

fun shr_ref32(a: u32, c: u32) u32 {
    if (c >= 32) { ret 0; }
    ret a >> c;
}

fun sar_ref32(a: i32, c: u32) i32 {
    if (c >= 32) { ret a >> 31; }
    ret a >> c;
}

fun mask64(b: bool) u64 {
    if (b) { ret 0xffffffffffffffff; }
    ret 0;
}

fun shl_ref64(a: u64, c: u64) u64 {
    if (c >= 64) { ret 0; }
    ret a << c;
}

fun shr_ref64(a: u64, c: u64) u64 {
    if (c >= 64) { ret 0; }
    ret a >> c;
}

fun sar_ref64(a: i64, c: u64) i64 {
    if (c >= 64) { ret a >> 63; }
    ret a >> c;
}

fun cvt_fs_i(a: f32x4) i32x4 {
    ret a::i32x4;
}

fun cvt_fs_u(a: f32x4) u32x4 {
    ret a::u32x4;
}

fun cvt_i_fs(a: i32x4) f32x4 {
    ret a::f32x4;
}

fun cvt_u_fs(a: u32x4) f32x4 {
    ret a::f32x4;
}

fun cvt_fd_l(a: f64x2) i64x2 {
    ret a::i64x2;
}

fun cvt_fd_ul(a: f64x2) u64x2 {
    ret a::u64x2;
}

fun cvt_l_fd(a: i64x2) f64x2 {
    ret a::f64x2;
}

fun cvt_ul_fd(a: u64x2) f64x2 {
    ret a::f64x2;
}

fun cvt_fs_i2(a: f32x2) i32x2 {
    ret a::i32x2;
}

fun cvt_u_fs2(a: u32x2) f32x2 {
    ret a::f32x2;
}

val CONV64W: [8]u64 = [8]u64{0x43e0000000000000, 0xc3e0000000000000, 0x43f0000000000000, 0x43dfffffffffffff, 0xbfe0000000000000, 0x7ff8000000000000, 0x43efffffffffffff, 0xfff0000000000000};
val CONV32: [16]u32 = [16]u32{0x00000000, 0xbf000000, 0x3fc00000, 0x4f000000, 0xcf000000, 0x4f800000, 0x4effffff, 0x4f7fffff, 0xbf800000, 0x7f800000, 0xff800000, 0x7fc00000, 0xcf000001, 0x80000000, 0x4b7fffff, 0x3f7fffff};
val CONV64: [8]u64 = [8]u64{0xbfe0000000000000, 0x3ff8000000000000, 0x41e0000000000000, 0xc1e0000000000000, 0x41dfffffffe00000, 0xc1e0000000100000, 0x7ff8000000000000, 0xfff0000000000000};

# 0 where every integer row of 8-bit lanes matches the scalar operation, else the failing check
fun pairs8(argc: i64) i64 {
    val flip: u8 = (argc - 1)::u8;
    var c: usize = 0;
    for (c < 64) {
        var pa: [16]u8;
        var pb: [16]u8;
        var pc: [16]u8;
        var k: usize = 0;
        for (k < 16) {
            pa[k] = EDGE8[((c + k) / 8) % 8] ^ flip;
            pb[k] = EDGE8[(c + k) % 8] ^ flip;
            pc[k] = COUNT8[(c + k) % 8];
            k = k + 1;
        }
        val va: u8x16 = pa:~u8x16;
        val vb: u8x16 = pb:~u8x16;
        val vc: u8x16 = pc:~u8x16;
        val sa: i8x16 = va:~i8x16;
        val sb: i8x16 = vb:~i8x16;
        k = 0;
        for (k < 16) {
            k = k + 1;
        }
        c = c + 16;
    }
    ret 0;
}

# 0 where every integer row of 16-bit lanes matches the scalar operation, else the failing check
fun pairs16(argc: i64) i64 {
    val flip: u16 = (argc - 1)::u16;
    var c: usize = 0;
    for (c < 64) {
        var pa: [8]u16;
        var pb: [8]u16;
        var pc: [8]u16;
        var k: usize = 0;
        for (k < 8) {
            pa[k] = EDGE16[((c + k) / 8) % 8] ^ flip;
            pb[k] = EDGE16[(c + k) % 8] ^ flip;
            pc[k] = COUNT16[(c + k) % 8];
            k = k + 1;
        }
        val va: u16x8 = pa:~u16x8;
        val vb: u16x8 = pb:~u16x8;
        val vc: u16x8 = pc:~u16x8;
        val sa: i16x8 = va:~i16x8;
        val sb: i16x8 = vb:~i16x8;
        k = 0;
        for (k < 8) {
            k = k + 1;
        }
        c = c + 8;
    }
    ret 0;
}

# 0 where every integer row of 32-bit lanes matches the scalar operation, else the failing check
fun pairs32(argc: i64) i64 {
    val flip: u32 = (argc - 1)::u32;
    var c: usize = 0;
    for (c < 64) {
        var pa: [4]u32;
        var pb: [4]u32;
        var pc: [4]u32;
        var k: usize = 0;
        for (k < 4) {
            pa[k] = EDGE32[((c + k) / 8) % 8] ^ flip;
            pb[k] = EDGE32[(c + k) % 8] ^ flip;
            pc[k] = COUNT32[(c + k) % 8];
            k = k + 1;
        }
        val va: u32x4 = pa:~u32x4;
        val vb: u32x4 = pb:~u32x4;
        val vc: u32x4 = pc:~u32x4;
        val sa: i32x4 = va:~i32x4;
        val sb: i32x4 = vb:~i32x4;
        k = 0;
        for (k < 4) {
            k = k + 1;
        }
        c = c + 4;
    }
    ret 0;
}

# 0 where every integer row of 64-bit lanes matches the scalar operation, else the failing check
fun pairs64(argc: i64) i64 {
    val flip: u64 = (argc - 1)::u64;
    var c: usize = 0;
    for (c < 64) {
        var pa: [2]u64;
        var pb: [2]u64;
        var pc: [2]u64;
        var k: usize = 0;
        for (k < 2) {
            pa[k] = EDGE64[((c + k) / 8) % 8] ^ flip;
            pb[k] = EDGE64[(c + k) % 8] ^ flip;
            pc[k] = COUNT64[(c + k) % 8];
            k = k + 1;
        }
        val va: u64x2 = pa:~u64x2;
        val vb: u64x2 = pb:~u64x2;
        val vc: u64x2 = pc:~u64x2;
        val sa: i64x2 = va:~i64x2;
        val sb: i64x2 = vb:~i64x2;
        k = 0;
        for (k < 2) {
            k = k + 1;
        }
        c = c + 2;
    }
    ret 0;
}

# 0 where every lane of each conversion matches the scalar cast, else the failing check
fun converted(argc: i64) i64 {
    var c: usize = 0;
    for (c < 16) {
        var pf: [4]f32;
        var pi: [4]u32;
        var pw: [2]f64;
        var pl: [2]u64;
        var k: usize = 0;
        for (k < 4) {
            pf[k] = CONV32[(c + k) % 16]:~f32;
            pi[k] = EDGE32[(c + k) % 8];
            if (k < 2) {
                pw[k] = CONV64W[(c + k) % 8]:~f64;
                pl[k] = EDGE64[(c + k + 5) % 8];
            }
            k = k + 1;
        }
        val vf: f32x4 = pf:~f32x4;
        val vi: u32x4 = pi:~u32x4;
        val r_fs_i: [4]i32 = cvt_fs_i(vf):~[4]i32;
        val r_fs_u: [4]u32 = cvt_fs_u(vf):~[4]u32;
        val r_i_fs: [4]u32 = cvt_i_fs(vi:~i32x4):~[4]u32;
        val r_u_fs: [4]u32 = cvt_u_fs(vi):~[4]u32;
        val r_fd_l: [2]i64 = cvt_fd_l(pw:~f64x2):~[2]i64;
        val r_fd_ul: [2]u64 = cvt_fd_ul(pw:~f64x2):~[2]u64;
        val r_l_fd: [2]u64 = cvt_l_fd(pl:~i64x2):~[2]u64;
        val r_ul_fd: [2]u64 = cvt_ul_fd(pl:~u64x2):~[2]u64;
        var pf2: [2]f32;
        var pi2: [2]u32;
        pf2[0] = pf[0];
        pf2[1] = pf[1];
        pi2[0] = pi[0];
        pi2[1] = pi[1];
        val r_fs_i2: [2]i32 = cvt_fs_i2(pf2:~f32x2):~[2]i32;
        val r_u_fs2: [2]u32 = cvt_u_fs2(pi2:~u32x2):~[2]u32;
        k = 0;
        for (k < 4) {
            if (r_fs_i[k] != pf[k]::i32) { ret 1; }
            if (r_fs_u[k] != pf[k]::u32) { ret 2; }
            if (r_i_fs[k] != (pi[k]:~i32)::f32:~u32) { ret 3; }
            if (r_u_fs[k] != pi[k]::f32:~u32) { ret 4; }
            if (k < 2 && r_fd_l[k] != pw[k]::i64) { ret 5; }
            if (k < 2 && r_fd_ul[k] != pw[k]::u64) { ret 6; }
            if (k < 2 && r_l_fd[k] != (pl[k]:~i64)::f64:~u64) { ret 7; }
            if (k < 2 && r_ul_fd[k] != pl[k]::f64:~u64) { ret 8; }
            if (k < 2 && r_fs_i2[k] != pf2[k]::i32) { ret 9; }
            if (k < 2 && r_u_fs2[k] != pi2[k]::f32:~u32) { ret 10; }
            k = k + 1;
        }
        c = c + 1;
    }
    ret 0;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var r: i64 = 0;
    r = pairs8(argc);
    if (r != 0) { ret r; }
    r = pairs16(argc);
    if (r != 0) { ret r; }
    r = pairs32(argc);
    if (r != 0) { ret r; }
    r = pairs64(argc);
    if (r != 0) { ret r; }
    r = converted(argc);
    if (r != 0) { ret r; }
    ret 0;
}
