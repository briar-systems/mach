# targets: linux-riscv64-v linux-riscv64-v-optimized
# flags:   --ext zkt
use std.runtime;
use std.types.size.usize;

# under zkt without zvkt the scalar instructions are timed and the vector ones are not, so a
# constant-time function, hard or soft, keeps the lanes of its vectors in scalar registers and adds
# them one by one, while a plain function packs the same addition (linux-riscv64-v.target holds
# `corpus_timed_hard` and `corpus_timed_soft` to the size of sixteen byte additions and
# `corpus_timed_plain` to that of one vadd.vv). each lane is checked against the scalar sum over
# every pair of the edge values

val EDGE8: [8]u8 = [8]u8{0x0, 0x1, 0xff, 0x80, 0x7f, 0x2, 0x81, 0x7e};

#[constant_time("hard")]
#[symbol("corpus_timed_hard")]
fun hard_sum(p: *^u8x16, q: *^u8x16, r: *^u8x16) {
    @r = @p + @q;
}

#[constant_time("soft")]
#[symbol("corpus_timed_soft")]
fun soft_sum(p: *^u8x16, q: *^u8x16, r: *^u8x16) {
    @r = @p + @q;
}

#[symbol("corpus_timed_plain")]
fun plain_sum(p: *u8x16, q: *u8x16, r: *u8x16) {
    @r = @p + @q;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val flip: u8 = (argc - 1)::u8;
    var c: usize = 0;
    for (c < 64) {
        var pa: [16]u8;
        var pb: [16]u8;
        var k: usize = 0;
        for (k < 16) {
            pa[k] = EDGE8[(c + k) / 8] ^ flip;
            pb[k] = EDGE8[(c + k) % 8] ^ flip;
            k = k + 1;
        }
        var a: u8x16 = pa:~u8x16;
        var b: u8x16 = pb:~u8x16;
        var sa: ^u8x16 = a;
        var sb: ^u8x16 = b;
        var h: ^u8x16 = a;
        var o: ^u8x16 = a;
        var s: u8x16 = a;
        hard_sum(?sa, ?sb, ?h);
        soft_sum(?sa, ?sb, ?o);
        plain_sum(?a, ?b, ?s);
        val mh: [16]u8 = (h:>u8x16):~[16]u8;
        val mo: [16]u8 = (o:>u8x16):~[16]u8;
        val ms: [16]u8 = s:~[16]u8;
        k = 0;
        for (k < 16) {
            val want: u8 = pa[k] + pb[k];
            if (mh[k] != want) { ret 1; }
            if (mo[k] != want) { ret 2; }
            if (ms[k] != want) { ret 3; }
            k = k + 1;
        }
        c = c + 16;
    }
    ret 0;
}
