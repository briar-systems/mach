# targets: windows-x86_64 windows-aarch64 windows-arm64ec
# a windows program that states its own entry and reaches the system through imports alone,
# with no runtime of std's, so it builds for windows-arm64ec, which std has no entry for. two
# functions of one library called natively each take an exit thunk there, and the image
# gives each import its own check.

#[library("kernel32")]
#[symbol("GetTickCount")]
ext fun get_tick_count() u32;

#[library("kernel32")]
#[symbol("Sleep")]
ext fun sleep(ms: u32);

#[library("kernel32")]
#[symbol("ExitProcess")]
ext fun exit_process(code: u32);

#[symbol("mainCRTStartup")]
pub fun start() {
    val before: u32 = get_tick_count();
    sleep(1);
    val after: u32 = get_tick_count();
    if (after - before > 600000) { exit_process(1); }
    exit_process(0);
}
