use std.runtime;

# comptime value parameters: each distinct argument makes its own instance, the body
# branches on the parameter with $if, and the parameter reads as a constant inside it.

fun scale($k: u8, x: u64) u64 {
    $if (k == 0) {
        ret 0;
    }
    $or (k == 1) {
        ret x;
    }
    $or {
        ret x * k::u64;
    }
}

fun fill($n: u64, v: u32) u32 {
    var i: u64 = 0;
    var s: u32 = 0;
    for (i < n) {
        s = s + v;
        i = i + 1;
    }
    ret s;
}

fun shift_by($s: u32, x: u64) u64 {
    ret x << s;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val x: u64 = argc::u64 + 6;
    if (scale(0, x) != 0)            { ret 1; }
    if (scale(1, x) != 7)            { ret 2; }
    if (scale(3, x) != 21)           { ret 3; }
    if (scale(255, x) != 1785)       { ret 4; }
    if (fill(3, 5) != 15 || fill(10, 2) != 20) { ret 5; }
    if (shift_by(63, 1) != 0x8000000000000000 || shift_by(4, x) != 112) { ret 6; }
    ret 0;
}
