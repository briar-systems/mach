# targets: linux-x86_64 linux-x86_64-optimized windows-x86_64 darwin-x86_64 freestanding-x86_64 uefi-x86_64 darwin-aarch64 linux-aarch64-dit linux-aarch64-dit-optimized linux-riscv64-zkt
use std.runtime;

# `$mach.build.ct_mul` answers 1 for the multiplies a hard function is admitted on every
# target named above, the same targets secret/hard_admitted.mach builds a hard 64-bit
# multiply on, so the fold and the validator agree.

val LOW32: u8 = $mach.build.ct_mul(low, 32);
val LOW64: u8 = $mach.build.ct_mul(low, 64);

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    if (LOW64 != 1) { ret 1; }
    if (LOW32 != 1) { ret 2; }
    ret 0;
}
