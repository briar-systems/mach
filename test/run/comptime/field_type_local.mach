use std.runtime;

# inside `$each f in $fields(T)`, a local annotated `f.type` or `*f.type` takes each field's own
# type in each iteration: the copies and the pointers read back what the record holds

rec Mixed {
    wide:  i64;
    small: u8;
    real:  f32;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var m: Mixed = Mixed{wide: -40000000000, small: 200, real: 2.5};
    var ints:  i64 = 0;
    var reals: f32 = 0.0;
    var bytes: u64 = 0;
    $each f in $fields(Mixed) {
        val q: f.type  = m.[f];
        val p: *f.type = ?m.[f];
        bytes = bytes + $size_of(f.type);
        $if (f.type == i64) {
            ints = ints + q + @p;
        }
        $or (f.type == u8) {
            ints = ints + q::i64 + (@p)::i64;
        }
        $or (f.type == f32) {
            reals = q * @p;
        }
    }
    if (ints != -80000000000 + 400) { ret 1; }
    if (reals != 6.25)              { ret 2; }
    if (bytes != 13)                { ret 3; }
    ret 0;
}
