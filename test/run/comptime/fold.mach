use std.runtime;

# constant folding agrees with the code that computes the same expression at run time: each
# module constant below is evaluated by the compiler, and main recomputes it from operands
# it only knows at run time (argc is 1).

val DIV: i32 = -1000001 / 7;
val REM: i32 = -1000001 % -3;
val SHR: i16 = -26986 >> 3;
val SHL: u32 = 0x96969696 << 3;
val CUT: u8 = 0x1234::u8;
val EXT: u64 = (-106)::i8::u64;
val FLT: f64 = 1.0 / 3.0;
val F2I: i32 = -40.75::i32;
val I2F: f32 = 16777217::f32;
val BITS: u32 = 1.5f32:~u32;
val MIX: i64 = (7 * 6 - 2) / 3 % 5;
val LT: u1 = -1i64 < 0xffffffffffffffffu64;

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val one: i64 = argc;
    if ((-1000001 * one)::i32 / 7 != DIV)           { ret 1; }
    if ((-1000001 * one)::i32 % -3 != REM)          { ret 2; }
    if ((-26986 * one)::i16 >> 3 != SHR)            { ret 3; }
    if ((0x96969696 * one)::u32 << 3 != SHL)        { ret 4; }
    if ((0x1234 * one)::u8 != CUT)                  { ret 5; }
    if ((-106 * one)::i8::u64 != EXT)               { ret 6; }
    if (one::f64 / 3.0 != FLT)                      { ret 7; }
    if ((-40.75 * one::f64)::i32 != F2I)            { ret 8; }
    if ((16777217 * one)::f32 != I2F)               { ret 9; }
    if ((1.5 * one::f32):~u32 != BITS)              { ret 10; }
    if ((7 * 6 * one - 2) / 3 % 5 != MIX)           { ret 11; }
    if ((-one < 0xffffffffffffffffu64) != LT)          { ret 12; }
    if (DIV != -142857 || REM != -2 || SHR != -3374 || CUT != 0x34 || F2I != -40 || MIX != 3 || LT != 1) { ret 13; }
    ret 0;
}
