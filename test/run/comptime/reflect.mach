use std.runtime;

# reflection that unrolls at compile time: $each over a record's fields with projection
# (read and written), over a tag's cases with the case test and guarded payload, and over a
# constant array; type predicates and type constructors; and $mach.build facts that agree
# with what the program measures.

rec Mixed { a: i64; b: u8; c: f32; d: u16; }

tag Event: u16 { idle; key: u8; move: i32; }

val PRIMES: [4]u64 = [4]u64{2, 3, 5, 7};

fun total(m: Mixed) i64 {
    var t: i64 = 0;
    $each f in $fields(Mixed) {
        t = t + m.[f]::i64;
    }
    ret t;
}

fun bump(m: *Mixed) {
    $each f in $fields(Mixed) {
        $if ($is_integer(f.type)) { m.[f] = m.[f] + 1; }
    }
}

fun offsets() u64 {
    var s: u64 = 0;
    $each f in $fields(Mixed) {
        s = s + f.offset;
    }
    ret s;
}

fun weight[T](e: T) i64 {
    var w: i64 = 0;
    $each c in $cases(T) {
        if (sel e.[c]) {
            w = c.code::i64 * 1000;
            $if (c.has_payload) { w = w + e.[c]::i64; }
        }
    }
    ret w;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var m: Mixed = Mixed{a: 100, b: 20, c: 3.5, d: 4};
    if (total(m) != 127)                      { ret 1; }
    bump(?m);
    if (m.a != 101 || m.b != 21 || m.c != 3.5 || m.d != 5) { ret 2; }
    if (offsets() != $offset_of(Mixed, a) + $offset_of(Mixed, b) + $offset_of(Mixed, c) + $offset_of(Mixed, d)) { ret 3; }

    if (weight[Event](Event.idle{}) != 0)     { ret 4; }
    if (weight[Event](Event.key{65}) != 1065) { ret 5; }
    if (weight[Event](Event.move{-7}) != 1993) { ret 6; }

    var sum: u64 = 0;
    $each p in PRIMES {
        sum = sum * 10 + p;
    }
    if (sum != 2357)                          { ret 7; }

    var facts: u64 = 0;
    $if ($is_record(Mixed) && $is_tag(Event) && !$is_tag(Mixed)) { facts = facts + 1; }
    $if ($is_integer(u8) && $is_float(f16) && !$is_float(i64)) { facts = facts + 1; }
    $if ($is_pointer(*u8) && !$is_pointer(u64))                 { facts = facts + 1; }
    $if ($type_of(m.c) == f32 && $type_of(sum) != u32)          { facts = facts + 1; }
    $if ($size_of($discriminant_of(Event)) == 2 && $size_of($pointee_of(*Mixed)) == $size_of(Mixed)) { facts = facts + 1; }
    if (facts != 5)                           { ret 8; }

    if ($mach.build.pointer_width != $size_of(ptr)) { ret 9; }
    var arch_ok: u1 = 0;
    $if ($mach.build.arch == $mach.arch.x86_64 || $mach.build.arch == $mach.arch.aarch64 || $mach.build.arch == $mach.arch.riscv64) {
        arch_ok = $size_of(ptr) == 8;
    }
    $or {
        arch_ok = $size_of(ptr) == 4;
    }
    if (!arch_ok)                             { ret 10; }
    ret 0;
}
