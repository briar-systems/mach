use std.runtime;

# a comptime value parameter sizes an array in the body of each instance and shadows the
# module constant of its spelling there, while a module constant read in the body, or by
# another constant, still reads the constant. an $each variable sizes one per iteration.

val N:  i64    = 9;
val M:  i64    = N + 1;
val ES: [2]i64 = [2]i64{2, 5};

fun count($N: i64) i64 {
    var xs: [N]i64;
    var i:  i64 = 0;
    for (i < N) {
        xs[i] = i;
        i     = i + 1;
    }
    val p: *[N]i64 = ?xs;
    ret $length_of([N]i64) + $size_of([N]i64)::i64 + p[0][N - 1];
}

fun outer($K: i64) i64 {
    ret count(K + 1);
}

fun reads_module($N: i64) i64 {
    var a: [M]u8;
    ret $length_of([M]u8) * 100 + $length_of([N]u8);
}

fun each_length() i64 {
    var s: i64 = 0;
    $each L in ES {
        var b: [L]u8;
        s = s + $length_of([L]u8) + $size_of([L]u8)::i64;
    }
    ret s;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    if (count(3) != 29)        { ret 1; }
    if (count(1) != 9)         { ret 2; }
    if (outer(4) != 49)        { ret 3; }
    if (reads_module(2) != 1002) { ret 4; }
    if (each_length() != 14)   { ret 5; }
    ret 0;
}
