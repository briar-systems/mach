use std.runtime;

# variadic packs, monomorphized per call's type list: $each over the pack, va.len, a pack
# forwarded whole with va..., leading fixed parameters, and per-element dispatch on the
# element's type.

fun count(va: ...) u64 {
    ret va.len;
}

fun sum(va: ...) i64 {
    var t: i64 = 0;
    $each a in va {
        $if ($type_of(a) == f64 || $type_of(a) == f32) {
            t = t + (a * 10.0)::i64;
        }
        $or {
            t = t + a::i64;
        }
    }
    ret t;
}

fun biased(base: i64, va: ...) i64 {
    ret base + sum(va...) + count(va...)::i64;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    if (count() != 0 || count(1u8, 2u8, 3u8) != 3) { ret 1; }
    if (sum(1i64, 2i64, 3i64) != 6)                 { ret 2; }
    # 5 + 250 + 2.5 * 10 - 3
    if (sum(5u8, 250u16, 2.5f64, -3i32) != 277)     { ret 3; }
    if (biased(100, 1u8, -1i8, 0.5f32) != 108)      { ret 4; }
    if (biased(7) != 7)                             { ret 5; }
    ret 0;
}
