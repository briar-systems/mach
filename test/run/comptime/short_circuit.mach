use std.runtime;

# a comptime `&&` whose left side is false, and a `||` whose left side is true, leave the right
# side unread, so a name of one architecture's extension catalog stands behind a test of that
# architecture and the file builds for every target. a right side that is read is evaluated

$if ($mach.build.arch == $mach.arch.x86_64 && $mach.build.ext.sha == 1) {
    val ARCH: i64 = 1;
}
$or ($mach.build.arch == $mach.arch.x86_64) {
    val ARCH: i64 = 1;
}
$or ($mach.build.arch == $mach.arch.aarch64 && $mach.build.ext.sha2 == 1) {
    val ARCH: i64 = 2;
}
$or ($mach.build.arch == $mach.arch.aarch64) {
    val ARCH: i64 = 2;
}
$or {
    val ARCH: i64 = 3;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var want: i64 = 3;
    $if ($mach.build.arch == $mach.arch.x86_64) {
        want = 1;
    }
    $or ($mach.build.arch == $mach.arch.aarch64) {
        want = 2;
    }
    if (ARCH != want) { ret 1; }

    var or_taken: i64 = 0;
    $if ($mach.build.arch != $mach.arch.x86_64 || $mach.build.ext.sha == $mach.build.ext.sha) {
        or_taken = 1;
    }
    if (or_taken != 1) { ret 2; }

    var nested: i64 = 0;
    $if ($mach.build.arch == $mach.arch.aarch64 && ($mach.build.ext.sha2 == 1 || $mach.build.ext.sha2 == 0)) {
        nested = 2;
    }
    $or ($mach.build.pointer_width > 0 || $mach.build.ext.no_such_extension == 1) {
        nested = 1;
    }
    $if ($mach.build.arch == $mach.arch.aarch64) {
        if (nested != 2) { ret 3; }
    }
    $or {
        if (nested != 1) { ret 4; }
    }
    ret 0;
}
