# targets: windows-x86_64
# flags:   run/link/coff_unwind.obj
# has:     Name: .used
# lacks:   Name: .unused
# inside:  Name: .used | StartAddress
# a foreign COFF object whose unwind data is keyless COMDAT `.xdata$` and `.pdata$`, as MinGW
# and zig write it, with a `-exclude-symbols:` directive (coff_unwind.py writes the object and
# says what it holds). the program calls `used_fn` and never `unused_fn`, so the link keeps the
# used function's section and its function table entry and drops the unused one with its
# entry: an entry lives while the function its first relocation names lives, and keeps nothing
# alive itself. the directive is read and holds with nothing to do in an executable.

#[library("kernel32")]
#[symbol("ExitProcess")]
ext fun exit_process(code: u32);

#[symbol("used_fn")]
ext fun used_fn(x: i32) i32;

#[symbol("mainCRTStartup")]
pub fun start() {
    exit_process(used_fn(-1)::u32);
}
