# targets: windows-x86_64
# lacks:   TLSDirectory
# a thread-local variable only a function nothing calls reads: collection drops the function
# and the variable's `.tls$` section, so the image holds no thread-local data, and the
# reference the dead function makes to `_tls_index` is dropped with it, leaving no bound
# symbol in a TLS index cell the image never reserves.

#[library("kernel32")]
#[symbol("ExitProcess")]
ext fun exit_process(code: u32);

#[thread]
var counter: u32;

pub fun bump() u32 {
    counter = counter + 1;
    ret counter;
}

#[symbol("mainCRTStartup")]
pub fun start() {
    exit_process(0);
}
