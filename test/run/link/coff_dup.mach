# targets: windows-x86_64
# flags:   run/link/coff_dup_a.lib run/link/coff_dup_b.lib
# two byte-identical archives of a member as zig writes compiler_rt, where `dup_fn` is a weak
# external aliasing `.weak.dup_fn.default`, the default in a NODUPLICATES COMDAT (coff_dup.py
# writes them and says what they hold). the first archive's member is pulled for `dup_fn`, and its
# weak external then stands in for the definition, so the second archive's copy is never pulled
# and the link is exactly the link of one archive.

#[library("kernel32")]
#[symbol("ExitProcess")]
ext fun exit_process(code: u32);

#[symbol("dup_fn")]
ext fun dup_fn(x: i32) i32;

#[symbol("mainCRTStartup")]
pub fun start() {
    exit_process(dup_fn(-2)::u32);
}
