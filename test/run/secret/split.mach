use std.runtime;

# a constant-time local of a secret member beside public ones is split member by member, and the secret member keeps
# its secrecy in a slot of its own: the public counter still steers the loop, the secret sum is declassified once at
# the end, and the value is what the unsplit record gives.

rec State {
    key:   ^u64;
    count: u64;
    mix:   ^u32;
}

#[constant_time("soft")]
fun run(k: ^u64, n: u64) ^u64 {
    var s: State = State{key: k, count: 0, mix: 7};
    for (s.count < n) {
        s.key   = s.key + s.mix::^u64;
        s.mix   = s.mix ^ s.key::^u32;
        s.count = s.count + 1;
    }
    ret s.key + s.mix::^u64;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val k:   u64 = argc::u64 + 40;
    val got: u64 = run(k, 3):>u64;
    var key: u64 = k;
    var mix: u32 = 7;
    var i:   u64 = 0;
    for (i < 3) {
        key = key + mix::u64;
        mix = mix ^ key::u32;
        i   = i + 1;
    }
    if (got != key + mix::u64) { ret 1; }
    ret 0;
}
