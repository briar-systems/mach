use std.runtime;

# records that hold a secret beside a public member, passed and returned by value between
# constant-time functions. the walk holds a general register byte by byte, so a branch on
# the public member of a record that shares a register with a secret one is admitted:
# two words, one word of two halves, three and six bytes, and a record built and returned.

rec Words  { k: ^u64; n: u64; }
rec Halves { k: ^u32; n: u32; }
rec Three  { k: ^u8; n: u8; m: u8; }
rec Six    { k: ^u16; n: u16; m: u16; }

#[constant_time("soft")]
fun make(k: ^u64, n: u64) Words {
    ret Words{k: k ^ 1, n: n + 1};
}

#[constant_time("soft")]
fun words(r: Words) ^u64 {
    if (r.n == 16) { ret r.k; }
    ret 0;
}

#[constant_time("soft")]
fun halves(r: Halves) ^u32 {
    if (r.n == 8) { ret r.k + 1; }
    ret 0;
}

#[constant_time("soft")]
fun three(r: Three) ^u8 {
    if (r.n == 3) { ret r.k ^ r.m; }
    ret 0;
}

#[constant_time("soft")]
fun six(r: Six) ^u16 {
    if (r.m == 6) { ret r.k + r.n; }
    ret 0;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val k: u64 = argc::u64 + 40;
    if (words(make(k, 15)):>u64 != (k ^ 1))                     { ret 1; }
    if (halves(Halves{k: k::^u32, n: 8}):>u32 != k::u32 + 1)    { ret 2; }
    if (three(Three{k: k::^u8, n: 3, m: 7}):>u8 != (k::u8 ^ 7)) { ret 3; }
    if (six(Six{k: k::^u16, n: 2, m: 6}):>u16 != k::u16 + 2)    { ret 4; }
    ret 0;
}
