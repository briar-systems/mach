use std.runtime;

# secret unions and secret arrays passed and returned by value between constant-time
# functions, and a secret global written and read.

uni Word { q: ^u64; h: [2]^u32; b: [8]^u8; }

var stored: ^u64 = 0;

#[constant_time("soft")]
fun make(s: ^u64) Word {
    var w: Word;
    w.q = s;
    ret w;
}

#[constant_time("soft")]
fun lanes(w: Word, a: [4]^u64) [4]^u64 {
    var r: [4]^u64 = a;
    r[0]   = r[0] ^ w.h[1]::^u64;
    r[3]   = r[3] + w.b[0]::^u64;
    stored = r[0];
    ret r;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val k: u64 = argc::u64 + 0x10;
    var a: [4]^u64;
    a[0] = k;
    a[3] = 5;
    val r: [4]^u64 = lanes(make((k << 32) | 0x77), a);
    if (r[0]:>u64 != (k ^ k))  { ret 1; }
    if (r[3]:>u64 != 5 + 0x77) { ret 2; }
    if (stored:>u64 != 0)      { ret 3; }
    ret 0;
}
