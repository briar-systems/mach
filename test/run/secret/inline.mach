use std.runtime;

# inlining around constant-time functions: a small constant-time callee is expanded into a constant-time caller, its
# secrets kept secret in the copy so the caller's walk checks the copy as the callee's walk checked it, once in a loop
# over a secret table. a small callee not checked constant time is never expanded into a constant-time caller and stays
# a call taking only public values, and a constant-time callee is never expanded into a caller that is not.

var noted: u64 = 0;

#[constant_time("soft")]
fun choose(mask: ^u64, a: ^u64, b: ^u64) ^u64 {
    ret (a & mask) | (b & ~mask);
}

fun note(n: u64) u64 {
    noted = noted + n;
    ret n + 1;
}

#[constant_time("soft")]
fun pick(table: *^u64, want: u64) ^u64 {
    var out: ^u64 = 0;
    var i:   u64  = 0;
    for (i < 8) {
        val hit: ^u64 = 0 - (i == want)::^u64;
        out = choose(hit, table[i], out);
        i   = note(i);
    }
    ret out;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var table: [8]^u64;
    var i:     u64 = 0;
    for (i < 8) {
        table[i] = (i * 0x0101010101010101 + argc::u64)::^u64;
        i        = i + 1;
    }
    if (pick(?table[0], 5):>u64 != 5 * 0x0101010101010101 + 1) { ret 1; }
    if (pick(?table[0], 9):>u64 != 0) { ret 2; }
    if (noted != 2 * 28) { ret 3; }
    val m: ^u64 = choose(0xffff0000ffff0000u64, 0x1111111111111111u64, 0x2222222222222222u64);
    if (m:>u64 != 0x1111222211112222u64) { ret 4; }
    ret 0;
}
