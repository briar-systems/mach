# targets: linux-x86_64 linux-x86_64-optimized windows-x86_64 darwin-x86_64 freestanding-x86_64 uefi-x86_64 darwin-aarch64 linux-aarch64-dit linux-aarch64-dit-optimized linux-riscv64-zkt
use std.runtime;

# a hard function that multiplies secrets, with no gate: every target named above
# guarantees the multiply's timing, so it builds there. a target that stops guaranteeing it
# refuses the file, and refuse/secret/hard_target.mach holds the targets that must not.

#[constant_time("hard")]
fun product(a: ^u64, b: ^u64) ^u64 {
    ret a * b;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val n: u64 = argc::u64 + 0x1_0000_0001;
    if (product(n, n + 2):>u64 != n * (n + 2)) { ret 1; }
    ret 0;
}
