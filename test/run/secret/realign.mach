use std.runtime;

# locals aligned past the stack's alignment make the prologue realign the stack pointer,
# and the walk follows the frame off both origins: a secret kept in an aligned slot,
# rewritten and returned through it, the same aligned to a page, and an aligned frame that
# also calls out.

#[align(128)]
rec Line { k: ^u64; n: u64; }

#[align(4096)]
rec Page { k: ^u64; n: u64; }

#[align(64)]
rec Pad { v: u64; }

#[constant_time("soft")]
fun twice(k: ^u64) ^u64 {
    ret k + k;
}

#[constant_time("soft")]
fun kept(s: ^u64) ^u64 {
    var l: Line;
    l.k = s ^ 7;
    l.n = 1;
    val t: ^u64 = l.k ^ 0xff;
    l.k = t;
    ret l.k + l.n;
}

#[constant_time("soft")]
fun paged(s: ^u64) ^u64 {
    var l: Page;
    l.k = s;
    l.n = 2;
    ret l.k * l.n;
}

#[constant_time("soft")]
fun called(s: ^u64) ^u64 {
    var p: Pad;
    var l: Line;
    p.v = 3;
    l.k = twice(s);
    l.n = p.v;
    if (l.n != 3) { ret 0; }
    ret l.k + l.n;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val k: u64 = argc::u64 + 9;
    if (kept(k):>u64 != (k ^ 7 ^ 0xff) + 1) { ret 1; }
    if (called(k):>u64 != k * 2 + 3)        { ret 2; }
    if (paged(k):>u64 != k * 2)             { ret 3; }
    ret 0;
}
