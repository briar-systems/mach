use std.runtime;

# a frame past a page makes windows' prologue probe the stack and move the stack pointer by
# the probe's count, shifted (`sub sp, sp, x15, lsl #4` on aarch64). the walk follows the
# stack pointer through it, so when a copy of a large secret record takes every register and
# the frame code borrows one through its emergency slot, the walk places that spill in the
# frame, private, as it is.

rec Big {
    k: [130]^u64;
    n: u64;
}

rec Pair {
    p: *u8;
    n: u64;
}

fun make() Big {
    var b: Big;
    ret b;
}

#[constant_time("soft")]
fun use_all(a: *Big, b: Pair, c: Pair, d: Pair, e: Pair, f: Pair) u64 {
    ret a.n + b.n + c.n + d.n + e.n + f.n;
}

#[constant_time("soft")]
fun probed(b: Pair, c: Pair, d: Pair, e: Pair, g: Pair) u64 {
    var pad: [520]^u64;
    var a:   Big = make();
    pad[3] = a.k[7];
    ret use_all(?a, b, c, d, e, g);
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val q: Pair = Pair{p: nil, n: 0};
    if (probed(q, q, q, q, q) != 0) { ret 1; }
    ret 0;
}
