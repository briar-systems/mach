use std.runtime;

# short-circuit operators with a public left operand and a secret right one, used as a
# value: the secret operand is evaluated without a branch on it, so the function is
# constant time.

#[constant_time("soft")]
fun both(p: u64, k: ^u64) ^u64 {
    val a: ^u1 = p > 3 && k == 5;
    val o: ^u1 = p > 3 || k == 5;
    ret a::^u64 + o::^u64 * 2;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val k: u64 = argc::u64 + 4;
    if (both(9, k):>u64 != 3) { ret 1; }
    if (both(1, k):>u64 != 2) { ret 2; }
    if (both(1, 7):>u64 != 0) { ret 3; }
    ret 0;
}
