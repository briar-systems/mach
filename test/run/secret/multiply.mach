use std.runtime;

# secret multiplies in a soft function: the low product at each width, the widening
# product and its high half, and signed products. a soft function runs them under the
# timing mode where the processor has it and runs anyway where it does not.

#[constant_time("soft")]
fun low(a: ^u64, b: ^u64, c: ^u32, e: ^u8) ^u64 {
    ret (a * b) ^ (c * c)::^u64 ^ (e * 3)::^u64;
}

#[constant_time("soft")]
fun high(a: ^u64, b: ^u64) ^u64 {
    val w: ^u128 = (a::^u128) * (b::^u128);
    ret (w >> 64)::^u64;
}

#[constant_time("soft")]
fun signed(d: ^i64) ^i64 {
    ret d * d * -1;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val n: u64 = argc::u64 + 6;
    if (low(n, 9, 5, 7):>u64 != ((n * 9) ^ 25 ^ 21))  { ret 1; }
    if (high(0x8000_0000_0000_0000, n * 2):>u64 != n) { ret 2; }
    if (signed(-(n::i64)):>i64 != -((n * n)::i64))    { ret 3; }
    ret 0;
}
