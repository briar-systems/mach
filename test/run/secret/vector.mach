use std.runtime;

# secret vectors: lane arithmetic, bitwise operations, shifts by secret lane counts and
# compares used as masks for a branch-free select.

#[constant_time("soft")]
fun vmix(a: ^u32x4, b: ^u32x4) ^u32x4 {
    val s: ^u32x4 = a + b;
    val x: ^u32x4 = s ^ (a & b);
    val l: ^u32x4 = x << (b & u32x4{7, 7, 7, 7});
    val m: ^u32x4 = (a < b)::^u32x4;
    ret (l & m) | (x & ~m);
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val n: u32   = argc::u32;
    val r: u32x4 = vmix(u32x4{n, 9, 2, 0}, u32x4{3, 4, 1, 0}):>u32x4;
    # lane 0: 1 < 3 so (4 ^ 1) << 3, lane 1: 9 >= 4, lane 2: 2 >= 1, lane 3: 0 >= 0
    if (r[0] != 40 || r[1] != 13 || r[2] != 3 || r[3] != 0) { ret 1; }
    ret 0;
}
