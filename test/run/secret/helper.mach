use std.runtime;

# a constant-time function divides public 64-bit integers, which a 32-bit target divides by
# mirl's helper: the helper's result is formed from its operands alone, so with every
# operand public the result is public and the function may test it, branch on it and
# return it as declared.

#[constant_time("soft")]
fun aligned(total: u64) u64 {
    if (total % 128 == 0) { ret total / 128; }
    ret 0;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val n: u64 = 0x1_0000_0000_0000 * (argc::u64 + 1);
    if (aligned(n) != n / 128) { ret 1; }
    if (aligned(n + 3) != 0)   { ret 2; }
    ret 0;
}
