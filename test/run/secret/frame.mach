use std.runtime;

# secrets a constant-time function keeps in its own frame: a secret array local written at
# constant indices and read back, a secret held live across a call so it is spilled to a
# slot and reloaded, and a frame larger than a page, which a target that probes its stack
# probes. the walk follows each slot, so none is refused and each reads back what it wrote.

#[constant_time("soft")]
fun twice(k: ^u64) ^u64 {
    ret k + k;
}

#[constant_time("soft")]
fun table(k: ^u64) ^u64 {
    var t: [8]^u64;
    t[0] = k;
    t[3] = k ^ 0xff;
    t[7] = t[0] + t[3];
    ret t[7] - t[0];
}

#[constant_time("soft")]
fun spilled(k: ^u64) ^u64 {
    val a: ^u64 = k * 3;
    val b: ^u64 = twice(k);
    val c: ^u64 = twice(a);
    ret a + b + c;
}

#[constant_time("soft")]
fun paged(k: ^u8) ^u64 {
    var big: [5000]^u8;
    big[0]    = k;
    big[4999] = k + 1;
    ret big[0]::^u64 + big[4999]::^u64 + big[2500]::^u64;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val k: u64 = argc::u64 + 6;
    if (table(k):>u64 != (k ^ 0xff))    { ret 1; }
    if (spilled(k):>u64 != k * 11)      { ret 2; }
    if (paged(k::u8):>u64 != k * 2 + 1) { ret 3; }
    ret 0;
}
