use std.runtime;

# a generic union whose concrete variant is secret: the parameter-typed variant says nothing
# at the declaration, and the all-secret instance agrees.

uni U[T] {
    a: T;
    b: ^u32;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var u: U[^u32];
    u.b = 7;
    if (u.a:>u32 != 7) { ret 1; }
    ret argc - argc;
}
