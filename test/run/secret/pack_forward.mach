use std.runtime;

# a constant-time pack function forwarding its pack to a function that is not constant time:
# each instance decides it from its own elements, so an instance whose every element is
# public is accepted, while one holding a secret is refused.

fun count(va: ...) u64 {
    var t: u64 = 0;
    $each k in va { t = t + k::u64; }
    ret t;
}

#[constant_time("soft")]
fun forward(va: ...) u64 {
    ret count(va...);
}

#[constant_time("soft")]
fun relay(va: ...) u64 {
    ret forward(va...);
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val k: u64 = argc::u64 + 2;
    if (forward(k, 4u32) != k + 4) { ret 1; }
    if (relay(k, k, 1u8) != k * 2 + 1) { ret 2; }
    ret 0;
}
