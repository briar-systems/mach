use std.runtime;

# wipes from constant-time code: a kept fill over a secret buffer of a run-time length,
# which is the one copy or fill of a secret whose length need not be known when compiled,
# and over a record that holds a secret beside a public member. wipes of 1, 31, 32, 33
# and 300 bytes of a known length and of run-time lengths, each from an odd start, leave
# every byte of the run zero and every byte around it as it was, and a wipe of a frame
# slot reads back zero.

val ROOM: u64 = 320;

rec Ctx { key: [32]^u8; rounds: u32; sched: [8]^u32; }

#[constant_time("soft")]
fun wipe(c: *Ctx, b: *^u8, n: u64) {
    $zeroize(b, n);
    $zeroize(c, 1);
}

#[inline("never")]
#[constant_time("soft")]
fun wipe_of[T](p: *T) {
    $zeroize(p, 1);
}

#[inline("never")]
#[constant_time("soft")]
fun wipe_n(p: *^u8, n: u64) {
    $zeroize(p, n);
}

# a frame slot holding a secret, wiped before the function returns, read back after the wipe
#[inline("never")]
#[constant_time("soft")]
fun scrub(x: ^u8) u8 {
    var k: [33]^u8;
    k[0]  = x;
    k[16] = x;
    k[32] = x;
    $zeroize(?k, 1);
    ret (k[0] | k[16] | k[32]):>u8;
}

fun fill(buf: *^u8) {
    var i: u64 = 0;
    for (i < ROOM) {
        buf[i] = 0xee;
        i      = i + 1;
    }
}

# whether bytes 1 to n of the buffer are zero and every other is as `fill` left it
fun wiped(buf: *^u8, n: u64) u8 {
    var i: u64 = 0;
    for (i < ROOM) {
        var want: u8 = 0xee;
        if (i >= 1 && i < 1 + n) { want = 0; }
        if (buf[i]:>u8 != want)  { ret 0; }
        i = i + 1;
    }
    ret 1;
}

fun known[T]() u8 {
    var buf: [ROOM]^u8;
    fill(?buf[0]);
    wipe_of[T]((?buf[1]):~*T);
    ret wiped(?buf[0], $size_of(T));
}

fun unknown(n: u64) u8 {
    var buf: [ROOM]^u8;
    fill(?buf[0]);
    wipe_n(?buf[1], n);
    ret wiped(?buf[0], n);
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var c: Ctx;
    var b: [40]^u8;
    c.key[3]   = argc::u8;
    c.rounds   = 14;
    c.sched[7] = 9;
    b[7]       = 9;
    b[39]      = 9;
    wipe(?c, ?b[0], 40);
    if (c.key[3]:>u8 != 0 || c.rounds != 0 || c.sched[7]:>u32 != 0) { ret 1; }
    if (b[7]:>u8 != 0 || b[39]:>u8 != 0)                            { ret 2; }
    if (known[[1]^u8]() == 0)                                       { ret 3; }
    if (known[[31]^u8]() == 0)                                      { ret 4; }
    if (known[[32]^u8]() == 0)                                      { ret 5; }
    if (known[[33]^u8]() == 0)                                      { ret 6; }
    if (known[[300]^u8]() == 0)                                     { ret 7; }
    var lengths: [7]u64 = [7]u64{0, 1, 31, 32, 33, 300, 17};
    var k:       u64    = 0;
    for (k < 7) {
        if (unknown(lengths[k]) == 0) { ret (10 + k)::i64; }
        k = k + 1;
    }
    if (scrub(argc::u8) != 0) { ret 20; }
    ret 0;
}
