use std.runtime;

# results holding a secret beside a public member: a large record a constant-time callee
# returns by reference into a local, and a public status beside a secret output. the
# caller branches on what the result's type declares public and keeps the secret secret.

use std.types.result.res;

rec Out { k: ^u64; tag: [3]^u64; len: u64; }

#[constant_time("soft")]
fun seal(k: ^u64, n: u64) Out {
    var o: Out;
    o.k      = k;
    o.tag[0] = k ^ 1;
    o.tag[2] = k ^ 2;
    o.len    = n;
    ret o;
}

#[constant_time("soft")]
fun open(key: *^u8, n: u64, out: *^u8) res[u64, u8] {
    if (n != 4) { ret res[u64, u8].err{1}; }
    var i: u64 = 0;
    for (i < 4) {
        out[i] = key[i] ^ 0xaa;
        i      = i + 1;
    }
    ret res[u64, u8].ok{4};
}

#[constant_time("soft")]
fun total(k: ^u64, key: *^u8, out: *^u8) ^u64 {
    var acc: ^u64 = 0;
    val o:   Out  = seal(k, 3);
    var i:   u64  = 0;
    for (i < o.len) {
        acc = acc + o.tag[i];
        i   = i + 1;
    }
    val r: res[u64, u8] = open(key, 4, out);
    if (sel r.err) { ret 0; }
    ret acc + r.ok::^u64;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val k:   u64 = argc::u64 + 16;
    var key: [4]^u8;
    var out: [4]^u8;
    key[1] = 5;
    if (total(k, ?key[0], ?out[0]):>u64 != (k ^ 1) + (k ^ 2) + 4) { ret 1; }
    if (out[1]:>u8 != (5 ^ 0xaa) || out[0]:>u8 != 0xaa)           { ret 2; }
    ret 0;
}
