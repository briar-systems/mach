use std.runtime;

# shifts and rotates by a secret count at several widths and signs, which every target
# realizes with a shift instruction whose timing the count does not decide.

#[constant_time("soft")]
fun shifts(x: ^u64, n: ^u64, y: ^u32, m: ^u8, z: ^i32) ^u64 {
    val a: ^u64 = x << (n & 63);
    val b: ^u64 = x >> (n & 63);
    val c: ^u32 = y << (m & 31);
    val d: ^i32 = z >> (m & 31);
    ret a ^ b ^ c::^u64 ^ (d:~^u32)::^u64;
}

#[constant_time("soft")]
fun rotl(x: ^u32, n: ^u32) ^u32 {
    val s: ^u32 = n & 31;
    ret (x << s) | (x >> ((32 - s) & 31));
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val n: u64 = argc::u64 + 3;
    # -64 >> 4 is -4, whose 32 bits are 0xfffffffc
    val want: u64 = 0xf0f00 ^ 0xf0f ^ 0x810 ^ 0xfffffffc;
    if (shifts(0xf0f0, n, 0x81, n::u8, -64):>u64 != want) { ret 1; }
    if (rotl(0x80000001, 1):>u32 != 3)                    { ret 2; }
    if (rotl(0x12345678, n::u32 + 4):>u32 != 0x34567812)  { ret 3; }
    ret 0;
}
