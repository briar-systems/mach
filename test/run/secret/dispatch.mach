use std.runtime;

# a cipher dispatch table: each entry's function type is an alias marked constant time, so a
# constant-time function may pass secrets through the value it selects with a public index,
# trusted as a direct call of a marked function is. a marked value converts to the plain type
# with no cast, and a marked type is an ordinary type as a field, a parameter, a result and a
# type argument. a hard function converts to the soft type where hard functions build.

#[constant_time("soft")]
def Seal: fun(*^u8, u64) ^u64;

def Plain: fun(*^u8, u64) ^u64;

rec Cipher {
    id:   u64;
    seal: Seal;
}

rec Boxed[T] {
    held: T;
}

#[constant_time("soft")]
fun sum_bytes(data: *^u8, n: u64) ^u64 {
    var acc: ^u64 = 0;
    var i:   u64  = 0;
    for (i < n) {
        acc = acc + data[i]::^u64;
        i   = i + 1;
    }
    ret acc;
}

#[constant_time("soft")]
fun xor_bytes(data: *^u8, n: u64) ^u64 {
    var acc: ^u64 = 0;
    var i:   u64  = 0;
    for (i < n) {
        acc = acc ^ data[i]::^u64;
        i   = i + 1;
    }
    ret acc;
}

#[constant_time("soft")]
fun seal_with(table: *Cipher, which: u64, data: *^u8, n: u64) ^u64 {
    ret table[which].seal(data, n);
}

#[constant_time("soft")]
fun seal_through(seal: Seal, data: *^u8, n: u64) ^u64 {
    ret seal(data, n);
}

#[constant_time("soft")]
fun seal_boxed(box: *Boxed[Seal], data: *^u8, n: u64) ^u64 {
    ret box.held(data, n);
}

fun pick(which: u64) Seal {
    if (which == 0) { ret sum_bytes; }
    ret xor_bytes;
}

$if ($mach.build.ct_mul(low, 64) == 1) {
    #[constant_time("hard")]
    def HardSeal: fun(*^u8, u64) ^u64;

    #[constant_time("hard")]
    fun hard_sum(data: *^u8, n: u64) ^u64 {
        var acc: ^u64 = 0;
        var i:   u64  = 0;
        for (i < n) {
            acc = acc + data[i]::^u64;
            i   = i + 1;
        }
        ret acc;
    }

    #[constant_time("hard")]
    fun hard_through(seal: HardSeal, data: *^u8, n: u64) ^u64 {
        ret seal(data, n);
    }

    fun hard_check(data: *^u8) i64 {
        val soft: Seal = hard_sum;
        if (seal_through(soft, data, 4):>u64 != 10)    { ret 10; }
        if (hard_through(hard_sum, data, 4):>u64 != 10) { ret 11; }
        ret 0;
    }
}
$or {
    fun hard_check(data: *^u8) i64 {
        ret 0;
    }
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var bytes: [4]^u8 = [4]^u8{1, 2, 3, 4};
    var table: [2]Cipher;
    table[0] = Cipher{id: 1, seal: sum_bytes};
    table[1] = Cipher{id: 2, seal: xor_bytes};
    val which: u64 = argc::u64 - 1;
    if (seal_with(?table[0], which, ?bytes[0], 4):>u64 != 10)     { ret 1; }
    if (seal_with(?table[0], which + 1, ?bytes[0], 4):>u64 != 4)  { ret 2; }
    if (seal_through(pick(1), ?bytes[0], 4):>u64 != 4)         { ret 3; }
    var box: Boxed[Seal] = Boxed[Seal]{held: sum_bytes};
    if (seal_boxed(?box, ?bytes[0], 4):>u64 != 10)              { ret 4; }
    val plain: Plain = table[1].seal;
    if (plain(?bytes[0], 4):>u64 != 4)                          { ret 5; }
    ret hard_check(?bytes[0]);
}
