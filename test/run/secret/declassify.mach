use std.runtime;

# a declassification is public only in the part it covers: the low byte of a secret word
# declassified and passed as a public argument, a public narrow result, one member of a
# record secret in two, and one lane of a secret vector. the rest stays secret.

rec Two { lo: ^u32; hi: ^u32; }

fun take(b: u8) u64 {
    ret b::u64 + 1;
}

#[constant_time("soft")]
fun low_byte(k: ^u64) u64 {
    ret take((k::^u8):>u8);
}

#[constant_time("soft")]
fun member(t: Two) u32 {
    ret t.lo:>u32;
}

#[constant_time("soft")]
fun lane(v: ^u32x4) u32 {
    ret v[2]:>u32;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val k: u64 = argc::u64 + 0x1230;
    if (low_byte(k) != (k & 0xff) + 1)             { ret 1; }
    if (member(Two{lo: k::^u32, hi: 9}) != k::u32) { ret 2; }
    if (lane(u32x4{1, 2, k::u32, 4}) != k::u32)    { ret 3; }
    ret 0;
}
