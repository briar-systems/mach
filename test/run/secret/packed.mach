use std.runtime;

# a packed record lays a secret member at an offset no alignment would give it, so its
# bytes share words with public members on either side. a constant-time function reads
# and writes the secret through a pointer and decides on the public members.

#[packed]
rec Hdr {
    tag: u8;
    key: ^u32;
    len: u16;
    mac: ^u64;
}

#[constant_time("soft")]
fun mix(h: *Hdr, k: ^u32) ^u64 {
    h.key = h.key ^ k;
    if (h.tag != 7 || h.len != 300) { ret 0; }
    h.mac = h.mac + h.key::^u64;
    ret h.mac;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    if ($size_of(Hdr) != 15) { ret 1; }
    val k: u32 = argc::u32 + 0x1000;
    var h: Hdr = Hdr{tag: 7, key: 0x0f0f, len: 300, mac: 5};
    if (mix(?h, k):>u64 != 5 + (0x0f0f ^ k)::u64) { ret 2; }
    if (h.tag != 7 || h.len != 300)               { ret 3; }
    ret 0;
}
