use std.runtime;

# `$mach.build.ct_mul` on the x86-64 host answers 1 for every multiply the one-operand and
# two-operand mul and imul rows run, all of them on Intel's data operand independent timing
# list, so the low half and the widening product are held as the high halves are. a rule
# that folds a constant-scale multiply into an address does not run a multiply and never
# counts against the cell.

$if ($mach.build.arch == $mach.arch.x86_64) {
    fun cells() i64 {
        var r: i64 = 0;
        $if ($mach.build.ct_mul(low, 32) == 0)    { r = r | 1; }
        $if ($mach.build.ct_mul(low, 64) == 0)    { r = r | 2; }
        $if ($mach.build.ct_mul(high_u, 64) == 0) { r = r | 4; }
        $if ($mach.build.ct_mul(high_s, 64) == 0) { r = r | 8; }
        $if ($mach.build.ct_mul(wide_u, 64) == 0) { r = r | 16; }
        $if ($mach.build.ct_mul(wide_s, 64) == 0) { r = r | 32; }
        ret r;
    }
}
$or {
    fun cells() i64 {
        ret 0;
    }
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    ret cells();
}
