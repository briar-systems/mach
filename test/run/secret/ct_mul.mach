# targets: linux-x86_64 windows-x86_64 darwin-aarch64 linux-aarch64-dit linux-riscv64-zkt
use std.runtime;

# `$mach.build.ct_mul` answers for a multiply as the build computes it, after the narrow
# and wide legalisation, so every cell each target named above declares or realizes is 1.

$if ($mach.build.ct_mul(low, 8) != 1)     { $error("low 8"); }
$if ($mach.build.ct_mul(low, 16) != 1)    { $error("low 16"); }
$if ($mach.build.ct_mul(low, 32) != 1)    { $error("low 32"); }
$if ($mach.build.ct_mul(low, 64) != 1)    { $error("low 64"); }
$if ($mach.build.ct_mul(high_u, 64) != 1) { $error("high_u 64"); }
$if ($mach.build.ct_mul(high_s, 64) != 1) { $error("high_s 64"); }
$if ($mach.build.ct_mul(wide_u, 64) != 1) { $error("wide_u 64"); }
$if ($mach.build.ct_mul(wide_s, 64) != 1) { $error("wide_s 64"); }

#[constant_time("hard")]
fun product(a: ^u8, b: ^u8) ^u8 {
    ret a * b;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val n: u8 = argc::u8 + 6;
    if (product(n, n):>u8 != n * n) { ret 1; }
    ret 0;
}
