# targets: linux-x86_64 linux-x86_64-optimized linux-aarch64 linux-aarch64-dit linux-riscv64 linux-riscv64-zkt linux-riscv32 windows-x86_64 windows-aarch64 darwin-x86_64 darwin-aarch64 freestanding-x86_64 freestanding-aarch64 freestanding-riscv64 freestanding-riscv32 uefi-x86_64 uefi-aarch64
use std.runtime;

# a constant-time function divides public 128-bit integers by mirl's helpers, which take
# them in registers, on the stack or in copies passed by reference, and return the result
# in registers or by reference: with every operand public the result is public. wasm is
# left out: its walk names no memory a call passes a value in, so there the result of a
# helper given a 128-bit operand in memory stays secret.

#[constant_time("soft")]
fun split(a: u128, b: u128, c: i128, d: i128) u128 {
    ret (a / b) + (a % b) + (c / d)::u128 + (c % d)::u128;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val a:    u128 = (argc::u128 << 70) + 12345;
    val want: u128 = a / 1000 + a % 1000 + (-700)::u128 + (-1)::u128;
    if (split(a, 1000, -7001, 10) != want) { ret 1; }
    ret 0;
}
