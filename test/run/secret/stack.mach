use std.runtime;

# records holding secrets that the conventions pass on the stack: past the argument
# registers, and too large for registers. the callee reads its secret members off its
# incoming arguments and branches on a public member beside them.

rec Pair { k: ^u64; n: u64; }
rec Big  { k: ^u64; a: u64; b: u64; c: u64; d: u64; }

#[constant_time("soft")]
fun late(a: u64, b: u64, c: u64, d: u64, e: u64, f: u64, g: u64, h: u64, p: Pair, q: Pair) ^u64 {
    if (p.n + q.n != a + b + c + d + e + f + g + h) { ret 0; }
    ret p.k ^ q.k;
}

#[constant_time("soft")]
fun big(r: Big, s: Big) ^u64 {
    if (r.d != 4 || s.a != 1) { ret 0; }
    ret r.k + s.k + r.c;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val k: u64  = argc::u64 + 0x100;
    val p: Pair = Pair{k: k, n: 30};
    val q: Pair = Pair{k: 0xf0, n: 6};
    if (late(1, 2, 3, 4, 5, 6, 7, 8, p, q):>u64 != (k ^ 0xf0)) { ret 1; }
    val r: Big = Big{k: k, a: 1, b: 2, c: 3, d: 4};
    val s: Big = Big{k: 9, a: 1, b: 0, c: 0, d: 0};
    if (big(r, s):>u64 != k + 12) { ret 2; }
    ret 0;
}
