use std.runtime;

# a secret float moved through a constant-time function and declassified, a public int
# converted to a float while a moved secret float may sit in the register it writes, and the
# low word of a secret 128-bit value declassified. on aarch64 a one-source float instruction
# reads its destination unless fpcr.nep is clear, so the function clears it around its own
# code. riscv's zkt promises no float instruction's timing, so a secret float is refused
# there and the float half is not built.

$if ($mach.build.arch != $mach.arch.riscv64 && $mach.build.arch != $mach.arch.riscv32) {
    #[constant_time("soft")]
    fun open(x: ^f64) f64 {
        val y: ^f64 = x;
        ret y:>f64;
    }

    #[constant_time("soft")]
    fun convert(p: *^f64, out: *^f64, n: i32) f32 {
        val s: ^f64 = @p;
        @out = s;
        ret n::f32;
    }

    fun floats(n: u64) i64 {
        val s: ^f64 = n::f64 + 0.5;
        if (open(s) != n::f64 + 0.5) { ret 1; }
        var k: ^f64 = s;
        var o: ^f64 = 0.0;
        if (convert(?k, ?o, 3) != 3.0) { ret 2; }
        if (o:>f64 != n::f64 + 0.5)    { ret 3; }
        ret 0;
    }
}
$or {
    fun floats(n: u64) i64 {
        ret 0;
    }
}

#[constant_time("soft")]
fun low(w: ^u128) u64 {
    ret (w::^u64):>u64;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val n: u64 = argc::u64 + 2;
    if (floats(n) != 0)                                  { ret 1; }
    if (low(((n::u128) << 64) | 0x1234::u128) != 0x1234) { ret 2; }
    ret 0;
}
