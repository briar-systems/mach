use std.runtime;

# a record returned by reference whose padding the caller zeroes after the call: the abi
# legalisation states its stores public, and only them, so the verifiers of the optimized
# line take the address arithmetic it builds for each one as the plain arithmetic it is.

rec Out {
    key:  ^u64;
    tag:  u8;
    rest: [4]u64;
}

#[constant_time("soft")]
fun make(k: ^u64) Out {
    ret Out{key: k, tag: 1, rest: [4]u64{1, 2, 3, 4}};
}

#[constant_time("soft")]
fun key(k: ^u64) ^u64 {
    val o: Out = make(k);
    ret o.key;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    if (key(argc::u64::^u64):>u64 != argc::u64) { ret 1; }
    ret 0;
}
