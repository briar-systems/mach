# targets: linux-riscv64 linux-riscv64-zkt freestanding-riscv64
use std.runtime;

# a conditional jump whose registers hold numbers the walk knows goes only the way it goes:
# 0 is below 16, 5 is not zero and -1 is not at least 1, so the store of a secret to a public
# word in the arm each one skips is on no path any execution takes, and is not refused. the
# path a counted loop's first test skips is the same, which the optimizer lays out.
#[constant_time("soft")]
fun skipped(k: ^u64) u64 {
    var x: u64 = 0;
    asm rv64i {
        li t0, 0
        li t1, 16
        bltu t0, t1, 1f
        ld t2, {k}
        sd t2, {x}
        1:
        li t0, 5
        bnez t0, 2f
        ld t2, {k}
        sd t2, {x}
        2:
        li t0, -1
        li t1, 1
        bge t0, t1, 3f
        j 4f
        3:
        ld t2, {k}
        sd t2, {x}
        4:
    }
    ret x;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    if (skipped(argc::u64::^u64) != 0) { ret 1; }
    ret 0;
}
