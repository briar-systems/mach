use std.runtime;

# thread-local variables in constant-time code: a public counter bumped while the
# function holds a secret, and a secret one written and read. the address is public,
# formed from the thread pointer. darwin reaches a thread-local through a resolver call
# the check cannot see into and uefi keeps no thread-local storage, so neither builds it.

$if ($mach.build.sys != $mach.sys.darwin && $mach.build.sys != $mach.sys.uefi) {
    #[thread]
    var count: u64 = 0;

    #[thread]
    var held: ^u64 = 0;

    #[constant_time("soft")]
    fun bump(k: ^u64) ^u64 {
        count = count + 1;
        held  = held ^ k;
        ret held + count::^u64;
    }

    fun check(k: u64) i64 {
        if (bump(k):>u64 != k + 1) { ret 1; }
        if (bump(k):>u64 != 2)     { ret 2; }
        if (count != 2)            { ret 3; }
        ret 0;
    }
}
$or {
    fun check(k: u64) i64 {
        ret 0;
    }
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    ret check(argc::u64 + 0x40);
}
