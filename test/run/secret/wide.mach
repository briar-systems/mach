use std.runtime;

# secret integers wider than a register, each lowered to word operations the walk checks:
# 128-bit add, subtract, compare as a value and shift by a secret count.

#[constant_time("soft")]
fun mix(a: ^u128, b: ^u128, n: ^u32) ^u128 {
    val s: ^u128 = a + b;
    val d: ^u128 = s - (b >> 3);
    val c: ^u128 = (a < b)::^u128;
    ret (d << (n & 63)) + c;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val a:    u128 = (0x1_0000_0000_0000_0000::u128) * (argc::u128 + 1) + 5;
    val b:    u128 = 0xffff_ffff_ffff_fff8::u128;
    val s:    u128 = a + b;
    val want: u128 = ((s - (b >> 3)) << 4) + 0;
    if (mix(a, b, 4):>u128 != want) { ret 1; }
    ret 0;
}
