# targets: linux-x86_64 linux-x86_64-optimized linux-aarch64 linux-riscv64
# flags:   --set optimize=true
# lacks:   Name: .data.rel.ro
use std.runtime;

# a chain of tests of a public value in a constant-time function keeps its compares in every optimised build: no pass
# makes a multi-way branch of it there and no jump table is laid out, so the image holds no table of addresses, which
# a table is the one thing this program would place, while the same chain outside such a function would branch
# through one. the arms are still reached as the source orders them, and each mixes the secret only arithmetically

#[constant_time("soft")]
fun pick(x: u32, a: ^u32) ^u32 {
    if (x == 0) {
        ret a + 3;
    }
    or (x == 1) {
        ret a ^ 5;
    }
    or (x == 2) {
        ret a * 7;
    }
    or (x == 3) {
        ret a - 11;
    }
    or (x == 4) {
        ret a | 13;
    }
    or (x == 5) {
        ret a & 17;
    }
    ret a;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val a:    u32    = 0x5a5a;
    val want: [7]u32 = [7]u32{a + 3, a ^ 5, a * 7, a - 11, a | 13, a & 17, a};
    var x:    u32    = 0;
    for (x < 9) {
        var k: u32 = x;
        if (k > 6) {
            k = 6;
        }
        val got: u32 = pick(x, a::^u32):>u32;
        if (got != want[k]) {
            ret 1;
        }
        x = x + 1;
    }
    ret 0;
}
