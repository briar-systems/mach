use std.crypto.ct;
use std.runtime;

# a constant-time loop over another module's constant-time helpers: `ct.select_u64` and the mask it calls are offered
# by their module and expanded into the constant-time caller, their secrets kept secret in the copy, so the caller's
# walk checks the copies as the helper's walk checked it. the selection is checked on both flags and on every entry.

#[constant_time("soft")]
fun pick(table: *^u64, want: u64) ^u64 {
    var out: ^u64 = 0;
    var i:   u64  = 0;
    for (i < 8) {
        val hit: ^u8 = (i == want)::^u8;
        out = ct.select_u64(hit, table[i], out);
        i   = i + 1;
    }
    ret out;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var table: [8]^u64;
    var i:     u64 = 0;
    for (i < 8) {
        table[i] = (i * 0x0101010101010101 + argc::u64)::^u64;
        i        = i + 1;
    }
    i = 0;
    for (i < 8) {
        if (pick(?table[0], i):>u64 != i * 0x0101010101010101 + 1) { ret 1; }
        i = i + 1;
    }
    if (pick(?table[0], 8):>u64 != 0) { ret 2; }
    if (ct.select_u64(1::^u8, 0xffffffffffffffff::^u64, 0::^u64):>u64 != 0xffffffffffffffff) { ret 3; }
    if (ct.select_u64(0::^u8, 0xffffffffffffffff::^u64, 0::^u64):>u64 != 0) { ret 4; }
    ret 0;
}
