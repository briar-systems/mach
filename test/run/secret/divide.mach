use std.runtime;

# a constant-time function may divide public values: a count declassified from a secret
# and tested for zero divides a public length. the division's operands are public, so
# neither the divide nor the compiler's own test of the divisor is refused.

#[constant_time("soft")]
fun share(k: ^u64, n: u64) ^u64 {
    val d: u64 = (k & 3):>u64;
    var q: u64 = n;
    if (d != 0) { q = n / d; }
    ret k ^ q::^u64;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val k: u64 = argc::u64 + 2;
    if (share(k, 120):>u64 != (k ^ 40))  { ret 1; }
    if (share(4, 120):>u64 != (4 ^ 120)) { ret 2; }
    ret 0;
}
