use std.runtime;

# a generic constant-time function instantiated at a secret type and at a public one: the
# instance's mode is the generic's, and each instance is checked at its own types.

#[constant_time("soft")]
fun pick[T](mask: T, a: T, b: T) T {
    ret (a & mask) | (b & ~mask);
}

#[constant_time("soft")]
fun use_both(m: ^u64, n: u64) ^u64 {
    val s: ^u64 = pick[^u64](m, 0x1111, 0x2222);
    val p: u64  = pick[u64](n, 0x30, 0x40);
    if (p == 0x30) { ret s; }
    ret s + 1;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val all: u64 = 0xffff_ffff_ffff_ffff;
    if (use_both(all, all):>u64 != 0x1111) { ret 1; }
    if (use_both(0, 0):>u64 != 0x2223)     { ret 2; }
    ret argc - argc;
}
