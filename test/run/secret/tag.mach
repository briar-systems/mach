use std.runtime;

# tags holding secrets in constant-time code: an option of a secret passed by value and by
# reference, its case tested by the public discriminator, and a tag whose cases disagree
# on secrecy, set and tested through a pointer.

use std.types.option.opt;

tag Mixed: u8 {
    open: u64;
    key:  ^u64;
}

#[constant_time("soft")]
fun get(o: opt[^u64]) ^u64 {
    if (sel o.some) { ret o.some; }
    ret 0;
}

#[constant_time("soft")]
fun get_ref(o: *opt[[3]^u64]) ^u64 {
    if (sel o.some) { ret o.some[2]; }
    ret 0;
}

#[constant_time("soft")]
fun set_key(m: *Mixed, k: ^u64) {
    @m = Mixed.key{k};
}

#[constant_time("soft")]
fun read(m: *Mixed) ^u64 {
    if (sel m.key)  { ret m.key; }
    if (sel m.open) { ret m.open::^u64; }
    ret 0;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val k: u64 = argc::u64 + 70;
    if (get(opt[^u64].some{k}):>u64 != k) { ret 1; }
    if (get(opt[^u64].none{}):>u64 != 0)  { ret 2; }
    var a: [3]^u64;
    a[2] = k;
    var o: opt[[3]^u64] = opt[[3]^u64].some{a};
    if (get_ref(?o):>u64 != k) { ret 3; }
    var m: Mixed = Mixed.open{5};
    if (read(?m):>u64 != 5) { ret 4; }
    set_key(?m, k);
    if (read(?m):>u64 != k) { ret 5; }
    ret 0;
}
