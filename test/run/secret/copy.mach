use std.runtime;

# secret and public locals beside each other, each filled by a whole copy and then the
# public one decides a branch: the copy of the secret one is stated secret and the walk
# keeps the public bytes public, at a size moved in words, one with a tail, and one past
# a page.

rec B64   { b: [64]u8; }
rec S64   { b: [64]^u8; }
rec B1025 { b: [1025]u8; }
rec S1025 { b: [1025]^u8; }
rec B5000 { b: [5000]u8; }
rec S5000 { b: [5000]^u8; }

#[constant_time("soft")]
fun c64(s: *S64, p: *B64) ^u8 {
    val ks: S64 = @s;
    val kp: B64 = @p;
    if (kp.b[63] != 7) { ret 0; }
    ret ks.b[63];
}

#[constant_time("soft")]
fun c1025(s: *S1025, p: *B1025) ^u8 {
    val ks: S1025 = @s;
    val kp: B1025 = @p;
    if (kp.b[1024] != 7) { ret 0; }
    ret ks.b[1024];
}

#[constant_time("soft")]
fun c5000(s: *S5000, p: *B5000) ^u8 {
    val ks: S5000 = @s;
    val kp: B5000 = @p;
    if (kp.b[4999] != 7) { ret 0; }
    ret ks.b[4999];
}

var s64:   S64;
var p64:   B64;
var s1025: S1025;
var p1025: B1025;
var s5000: S5000;
var p5000: B5000;

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val k: u8 = argc::u8 + 40;
    s64.b[63]     = k;
    p64.b[63]     = 7;
    s1025.b[1024] = k;
    p1025.b[1024] = 7;
    s5000.b[4999] = k;
    p5000.b[4999] = 7;
    if (c64(?s64, ?p64):>u8 != k)       { ret 1; }
    if (c1025(?s1025, ?p1025):>u8 != k) { ret 2; }
    if (c5000(?s5000, ?p5000):>u8 != k) { ret 3; }
    ret 0;
}
