use std.runtime;

# inline assembly in a constant-time function, read by the walk byte by byte: a record of a
# secret and a public word arrives in one register, the block shifts the public word down
# and branches on it, and moves a public byte out with a narrow load. none of it reads a
# secret byte, so none is refused. targets with no such block compute the same in mach.

rec R { k: ^u32; n: u32; }

#[constant_time("soft")]
fun public_half(s: R) u32 {
    var x: u32 = 0;
    $if ($mach.build.arch == $mach.arch.x86_64) {
        asm x86-64 {
            mov rax, {s}
            shr rax, 32
            mov ecx, 0
            cmp eax, 5
            jne 1f
            mov ecx, 1
            1:
            mov {x}, ecx
        }
    }
    $or ($mach.build.arch == $mach.arch.aarch64) {
        asm armv8-a {
            ldr x9, {s}
            lsr x9, x9, 32
            mov w10, 0
            cmp w9, 5
            b.ne 1f
            mov w10, 1
            1:
            str w10, {x}
        }
    }
    $or ($mach.build.arch == $mach.arch.riscv64) {
        asm rv64i {
            ld t0, {s}
            srli t0, t0, 32
            li t1, 5
            li t2, 0
            bne t0, t1, 1f
            li t2, 1
            1:
            sw t2, {x}
        }
    }
    $or {
        if (s.n == 5) { x = 1; }
    }
    ret x;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    if (public_half(R{k: argc::^u32, n: 5}) != 1) { ret 1; }
    if (public_half(R{k: 5, n: 6}) != 0)          { ret 2; }
    ret 0;
}
