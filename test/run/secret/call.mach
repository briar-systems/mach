use std.runtime;

# calls out of a constant-time function. a trusted callee is checked against its own
# declaration, so a secret may go to it. a callee not checked constant time may be called
# with public values while the caller's secrets sit where it cannot reach them: directly
# and through an ext declaration, whose public results decide a branch, and through a
# function value.

var noted: u64 = 0;

fun note(n: u64) u64 {
    noted = noted + n;
    ret n * 3;
}

#[symbol("corpus_secret_call_note")]
fun note_impl(n: u64) u64 {
    ret note(n);
}

#[symbol("corpus_secret_call_note")]
ext fun note_ext(n: u64) u64;

var through: fun(u64) u64 = nil;

#[constant_time("soft")]
fun mix(k: ^u64) ^u64 {
    ret k ^ 0x5a;
}

#[constant_time("soft")]
fun work(k: ^u64) ^u64 {
    var held: [4]^u64;
    held[1] = mix(k);
    if (note(1) != 3)     { ret 0; }
    if (note_ext(2) != 6) { ret 0; }
    val v: u64 = through(4);
    held[2] = mix(held[1]);
    ret held[1] + held[2] + v::^u64;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    through = note;
    val k: u64 = argc::u64 + 0x300;
    if (work(k):>u64 != (k ^ 0x5a) + k + 12) { ret 1; }
    if (noted != 7)                          { ret 2; }
    ret 0;
}
