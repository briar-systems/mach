use std.runtime;

# hard functions, built where the build guarantees every timing mode their code needs,
# which `$mach.build.ct_mul` answers: a hard multiply, a hard caller of a soft callee,
# which it may trust there, and std's constant-time helpers called from hard code.
# elsewhere a hard function is refused, so none is built.

use std.crypto.ct;

#[constant_time("soft")]
fun square(k: ^u64) ^u64 {
    ret k * k;
}

$if ($mach.build.ct_mul(low, 64) == 1) {
    #[constant_time("hard")]
    fun product(a: ^u64, b: ^u64) ^u64 {
        ret a * b + square(a);
    }

    #[constant_time("hard")]
    fun pick(c: ^u8, a: ^u64, b: ^u64) ^u64 {
        ret ct.select_u64(c, a, b);
    }

    fun check(n: u64) i64 {
        if (product(n, 3):>u64 != n * 3 + n * n) { ret 1; }
        if (pick(1, n, 9):>u64 != n)             { ret 2; }
        if (pick(0, n, 9):>u64 != 9)             { ret 3; }
        ret 0;
    }
}
$or {
    fun check(n: u64) i64 {
        if (square(n):>u64 != n * n) { ret 4; }
        ret 0;
    }
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    ret check(argc::u64 + 10);
}
