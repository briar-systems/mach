use std.runtime;

# a record whose 8-byte vector lies across both eightbytes, aligned to one lane, by value
# through a call as a result and as an argument, with float and integer lanes.

rec Pair {
    flag: u8;
    v:    f32x2;
}

rec Wide {
    flag: u16;
    v:    i16x4;
}

fun make(a: f32, b: f32) Pair {
    ret Pair{flag: 7, v: f32x2{a, b}};
}

fun second(p: Pair) f32 {
    ret p.v[1];
}

fun widen(x: i16) Wide {
    ret Wide{flag: 9, v: i16x4{x, x + 1, x + 2, x + 3}};
}

fun last(w: Wide) i16 {
    ret w.v[3];
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val one: f32  = argc::f32;
    val p:   Pair = make(320.0 * one, 180.0 * one);
    if (p.flag != 7 || p.v[0] != 320.0 || p.v[1] != 180.0) { ret 1; }
    if (second(Pair{flag: 1, v: f32x2{one, 2.5}}) != 2.5)   { ret 2; }
    val w: Wide = widen(argc::i16 + 9);
    if (w.flag != 9 || w.v[0] != 10 || w.v[3] != 13)       { ret 3; }
    if (last(w) != 13)                                     { ret 4; }
    ret 0;
}
