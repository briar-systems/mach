use std.runtime;
use std.system.panic;

# std's panic never returns, so a function with a result type may end in it. the panic sits behind a test that is false
# at run time, and the paths before it return

fun parsed(n: i64) i64 {
    if (n >= 0) { ret n * 2; }
    panic.panic("negative input");
}

fun pick(n: i64) i64 {
    if (n == 1)      { ret 10; }
    or (n == 2)      { ret 20; }
    or               { panic.panic("no such pick"); }
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    if (parsed(argc) != 2)  { ret 1; }
    if (pick(argc) != 10)   { ret 2; }
    ret 0;
}
