# targets: darwin-aarch64 darwin-x86_64
use std.runtime;

# a call to a function the system library provides and a pointer to it, so the image binds
# an import: a call stub, its lazy pointer and a non-lazy pointer, which the darwin target
# files judge. the program runs only on darwin, where the process id is positive.

#[library("libsystem")]
ext fun getpid() i32;

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val f: fun() i32 = getpid;
    if (getpid() <= 0)   { ret 1; }
    if (f() != getpid()) { ret 2; }
    ret 0;
}
