# reports: inline across.across.sweep 2
use std.math;
use std.math.bits;
use std.runtime;

# calls of small functions of another module are expanded in place when optimising, from the bodies the module offers:
# a helper with several returns, one guarding its least input, a helper calling another helper the same module offers,
# a shift helper on its zero and wrapping counts, inside a loop and outside one. each result is checked against the
# edge inputs that tell a wrong join of the returns or a wrong binding of the offered bodies apart.

fun sweep(base: i64) i64 {
    var sum: i64 = 0;
    var i:   i64 = 0 - 3;
    for (i <= 3) {
        sum = sum + math.clamp(base * i, 0 - 2, 2) + math.abs(i);
        i   = i + 1;
    }
    ret sum;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val one:  i64 = argc;
    val wide: u64 = argc::u64;
    if (math.clamp(0 - 5 * one, 0 - 2, 2) != 0 - 2)  { ret 1; }
    if (math.clamp(5 * one, 0 - 2, 2) != 2)          { ret 2; }
    if (math.clamp(one, 0 - 2, 2) != 1)              { ret 3; }
    if (math.abs(0 - 9223372036854775807 - one) != 9223372036854775807) { ret 4; }
    if (math.abs(0 - 7 * one) != 7)                  { ret 5; }
    if (sweep(one) != 12)                            { ret 6; }
    if (bits.ctz(0) != 64 + wide - 1)                { ret 7; }
    if (bits.ctz(wide << 63) != 63)                  { ret 8; }
    if (bits.ctz(wide * 40) != 3)                    { ret 9; }
    if (bits.rotate_left(0x8000000000000001 * wide, 0) != 0x8000000000000001) { ret 10; }
    if (bits.rotate_left(0x8000000000000001 * wide, 64) != 0x8000000000000001) { ret 11; }
    if (bits.rotate_left(0x8000000000000001 * wide, 1) != 3)  { ret 12; }
    if (bits.rotate_right(3 * wide, 65) != 0x8000000000000001) { ret 13; }
    var n: u64 = 0;
    var k: u64 = 0;
    for (k < 64) {
        n = n + bits.popcount(bits.rotate_left(wide, k));
        k = k + 1;
    }
    if (n != 64) { ret 14; }
    ret 0;
}
