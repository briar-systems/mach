use std.runtime;

fun fact(n: u64) u64 {
    if (n < 2) { ret 1; }
    ret n * fact(n - 1);
}

fun fib(n: u64) u64 {
    if (n < 2) { ret n; }
    ret fib(n - 1) + fib(n - 2);
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    if (fact(10) != 3628800) { ret 1; }
    if (fib(20) != 6765)     { ret 2; }
    ret 0;
}
