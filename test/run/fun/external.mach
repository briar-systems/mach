use std.runtime;

# a call through an `ext fun` declaration, which reaches its symbol by the C convention of
# the target. the symbol is defined in this file under #[symbol], so the call and the
# definition must agree on how integers, floats and a small record travel.

rec Vec2 { x: f32; y: f32; }

#[symbol("corpus_blend")]
fun blend(a: i32, w: f64, v: Vec2, b: u8) f64 {
    ret a::f64 * w + v.x::f64 * v.y::f64 + b::f64;
}

#[symbol("corpus_blend")]
ext fun c_blend(a: i32, w: f64, v: Vec2, b: u8) f64;

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    # -3 * 0.5 + 2 * 4 + 200
    if (c_blend(-3, 0.5, Vec2{x: 2.0, y: 4.0}, 200) != 206.5) { ret 1; }
    if (blend(-3, 0.5, Vec2{x: 2.0, y: 4.0}, 200) != 206.5)   { ret 2; }
    ret 0;
}
