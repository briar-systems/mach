use std.runtime;

# a chain of `sel` tests that names every case of one tag ends the function with no bare `or`: one arm per case, an arm
# that names several cases with `||`, a `!sel` arm and the one case it leaves, a pointer place. each is called on every
# case and checked against what it returns

tag Shape: u8 {
    dot;
    line:   i64;
    square: i64;
}

tag Level: u8 {
    low;
    mid;
    high;
    peak;
}

fun size(s: Shape) i64 {
    if (sel s.dot)       { ret 0; }
    or (sel s.line)      { ret s.line; }
    or (sel s.square)    { ret s.square * s.square; }
}

fun band(l: Level) i64 {
    if (sel l.low)                 { ret 1; }
    or (sel l.mid || sel l.high)   { ret 2; }
    or (sel l.peak)                { ret 3; }
}

fun not_dot(s: Shape) i64 {
    if (!sel s.dot) { ret 7; }
    or (sel s.dot)  { ret 8; }
}

fun through(p: *Shape) i64 {
    if (sel p.dot)        { ret 0; }
    or (sel p.line || sel p.square) { ret 5; }
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val one: i64   = argc;
    var s:   Shape = Shape.square{3 * one};
    if (size(Shape.dot{}) != 0)              { ret 1; }
    if (size(Shape.line{4 * one}) != 4)      { ret 2; }
    if (size(s) != 9)                        { ret 3; }
    if (band(Level.low{}) != 1)              { ret 4; }
    if (band(Level.mid{}) != 2)              { ret 5; }
    if (band(Level.high{}) != 2)             { ret 6; }
    if (band(Level.peak{}) != 3)             { ret 7; }
    if (not_dot(Shape.dot{}) != 8)           { ret 8; }
    if (not_dot(Shape.line{one}) != 7)       { ret 9; }
    if (through(?s) != 5)                    { ret 10; }
    ret 0;
}
