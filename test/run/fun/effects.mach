use std.runtime;

# what a call of a function of the same module may do is read from its body and what it calls: a load may stand across
# a call that writes nothing, and never across one that writes what it reads, directly, through a pointer it is given,
# through a callee of a callee, or at the bottom of a recursion. a callee that writes only a local of its own writes
# nothing its caller can see.

var g:     u32    = 7;
var table: [8]u32 = [8]u32{1, 2, 3, 4, 5, 6, 7, 8};

fun peek() u32 {
    ret g;
}

fun set(v: u32) {
    g = v;
}

fun via(v: u32) {
    set(v);
}

fun store(p: *u32, v: u32) {
    @p = v;
}

fun scratch(n: u32) u32 {
    var local: [4]u32;
    local[n & 3] = n;
    ret local[n & 3] + 1;
}

fun even(n: u32) u32 {
    if (n == 0) {
        g = g + 10;
        ret 1;
    }
    ret odd(n - 1);
}

fun odd(n: u32) u32 {
    if (n == 0) { ret 0; }
    ret even(n - 1);
}

fun sum(n: i64) u32 {
    var total: u32 = 0;
    var i:     i64 = 0;
    for (i < n) {
        val x: u32 = table[i & 7];
        total = total + scratch(x);
        val y: u32 = table[i & 7];
        total = total + x + y;
        i = i + 1;
    }
    ret total;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val a: u32 = g;
    val b: u32 = peek();
    if (a != 7 || b != 7) { ret 1; }
    set(8);
    if (g != 8) { ret 2; }
    via(9);
    if (g != 9) { ret 3; }
    store(?g, 11);
    if (g != 11) { ret 4; }
    val s: u32 = scratch(argc::u32);
    if (s != argc::u32 + 1 || g != 11) { ret 5; }
    if (even(argc::u32 + 3) != 1) { ret 6; }
    if (g != 21) { ret 7; }
    if (sum(argc * 8) != 116) { ret 8; }
    ret 0;
}
