use std.runtime;

# narrow integers across calls: a callee reads an i8 or i16 argument with its sign and a u8
# or u16 without, and a caller widens a narrow result by the result's signedness. calling
# conventions differ in who extends, which is where this breaks.

fun widen(a: i8, b: u8, c: i16, d: u16) i64 {
    ret a::i64 * 1000000 + b::i64 * 10000 + c::i64 * 10 + d::i64;
}

fun neg8(x: i8) i8 { ret -x; }
fun inv8(x: u8) u8 { ret ~x; }
fun neg16(x: i16) i16 { ret -x; }
fun low16(x: u64) u16 { ret x::u16; }
fun neg32(x: i32) i32 { ret -x; }

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    # -5 * 1000000 + 250 * 10000 - 300 * 10 + 65000
    if (widen(-5, 250, -300, 65000) != -2438000) { ret 1; }
    if (neg8(5)::i64 != -5)                      { ret 2; }
    if (inv8(5)::i64 != 250)                     { ret 3; }
    if (neg16(300)::i64 != -300)                 { ret 4; }
    if (low16(0xffff_0000_0000_fffe)::u64 != 0xfffe) { ret 5; }
    if (neg32(7)::i64 != -7)                     { ret 6; }
    if (neg32(7)::u64 != 0xfffffffffffffff9)     { ret 7; }
    ret 0;
}
