use std.runtime;

# calls of small functions of the same module are expanded in place when optimising: a helper with several returns, a
# helper making a local array called once per trip of a loop, so its slot must start fresh each time, a helper with a
# loop of its own, a helper returning a record, a chain of helpers expanded into each other, an `inline("always")`
# function too large for the size rule, an `inline("never")` one, and a recursive pair, which stays a pair of calls.
# each result is checked against the edge inputs that tell a wrong join of the returns apart.

rec Pair {
    lo: u32;
    hi: u32;
}

fun clamp(x: i64, lo: i64, hi: i64) i64 {
    if (x < lo) { ret lo; }
    if (x > hi) { ret hi; }
    ret x;
}

fun fresh(n: u32) u32 {
    var buf: [4]u32;
    buf[n & 3] = buf[n & 3] + n;
    ret buf[0] + buf[1] + buf[2] + buf[3];
}

fun bits(x: u64) u32 {
    var n: u32 = 0;
    var v: u64 = x;
    for (v != 0) {
        n = n + (v & 1)::u32;
        v = v >> 1;
    }
    ret n;
}

fun split(x: u64) Pair {
    ret Pair{lo: x::u32, hi: (x >> 32)::u32};
}

fun twice(x: u32) u32 {
    ret x + x;
}

fun quad(x: u32) u32 {
    ret twice(twice(x));
}

#[inline("always")]
fun grade(x: i64) i64 {
    var out: i64 = 0;
    if (x < -100) { out = 1; }
    or (x < 0) { out = 2; }
    or (x == 0) { out = 3; }
    or (x < 10) { out = 4; }
    or (x < 100) { out = 5; }
    or (x < 1000) { out = 6; }
    or { out = 7; }
    ret out * 10 + clamp(x, -9, 9);
}

#[inline("never")]
fun keep(x: u32) u32 {
    ret x ^ 0x5a;
}

fun even(n: u32) u32 {
    if (n == 0) { ret 1; }
    ret odd(n - 1);
}

fun odd(n: u32) u32 {
    if (n == 0) { ret 0; }
    ret even(n - 1);
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val edges: [7]i64 = [7]i64{-9223372036854775807 - 1, -101, -1, 0, 5, 101, 9223372036854775807};
    val clamped: [7]i64 = [7]i64{-50, -50, -1, 0, 5, 50, 50};
    var i: i64 = 0;
    for (i < 7) {
        if (clamp(edges[i], -50, 50) != clamped[i]) { ret 1; }
        i = i + 1;
    }

    var total: u32 = 0;
    var n:     u32 = 0;
    for (n < 8) {
        total = total + fresh(n);
        n = n + 1;
    }
    if (total != 28) { ret 2; }

    var counted: u32 = 0;
    i = 0;
    for (i < 4) {
        counted = counted + bits(0xffffffffffffffffu64 >> (i * 16)::u64);
        i = i + 1;
    }
    if (counted != 160) { ret 3; }

    val p: Pair = split(0x89abcdef01234567u64 + argc::u64 - 1);
    if (p.lo != 0x01234567 || p.hi != 0x89abcdef) { ret 4; }

    if (quad(argc::u32 + 0x3fffffff) != 0x00000000) { ret 5; }

    val graded: [7]i64 = [7]i64{1 * 10 - 9, 1 * 10 - 9, 2 * 10 - 1, 30, 4 * 10 + 5, 6 * 10 + 9, 7 * 10 + 9};
    i = 0;
    for (i < 7) {
        if (grade(edges[i]) != graded[i]) { ret 6; }
        i = i + 1;
    }

    if (keep(argc::u32) != 0x5b) { ret 7; }
    if (even(10 + argc::u32) != 0 || odd(10 + argc::u32) != 1) { ret 8; }
    ret 0;
}
