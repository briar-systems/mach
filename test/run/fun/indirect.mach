use std.runtime;

# calls through function values: a parameter, a record field, a table indexed at run time,
# a function returned from a function, and nil as a function value.

def BinOp: fun(i64, i64) i64;

rec Op {
    name: u8;
    run:  BinOp;
}

fun add(a: i64, b: i64) i64 { ret a + b; }
fun sub(a: i64, b: i64) i64 { ret a - b; }
fun mul(a: i64, b: i64) i64 { ret a * b; }

fun apply(f: BinOp, a: i64, b: i64) i64 {
    ret f(a, b);
}

fun pick(k: u8) BinOp {
    if (k == '+') { ret add; }
    if (k == '-') { ret sub; }
    ret mul;
}

fun twice(f: fun(f64) f64, x: f64) f64 {
    ret f(f(x));
}

fun half(x: f64) f64 { ret x / 2.0; }

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    if (apply(add, 40, 2) != 42) { ret 1; }
    if (apply(sub, 40, 2) != 38) { ret 2; }
    val op: Op = Op{name: '*', run: mul};
    if (op.run(6, 7) != 42)      { ret 3; }
    var table: [3]BinOp = [3]BinOp{add, sub, mul};
    var acc: i64 = 0;
    var i: u64 = 0;
    for (i < 3) {
        acc = acc + table[i](10, 3);
        i = i + 1;
    }
    # 13 + 7 + 30
    if (acc != 50)               { ret 4; }
    if (pick('-')(1, 2) != -1)   { ret 5; }
    if (pick('x')(5, 5) != 25)   { ret 6; }
    if (twice(half, 10.0) != 2.5) { ret 7; }
    var none: BinOp = nil;
    if (none != nil)             { ret 8; }
    none = pick('+');
    if (none == nil || none(1, 1) != 2) { ret 9; }
    ret 0;
}
