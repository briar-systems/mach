use std.runtime;

# each function ends where control never passes: every arm of a chain returns, a bare `for` no `brk` leaves, a call to a
# `noreturn` function, a `$error` in the arms the build does not select, a chain over every case of a tag closed by a bare
# `or`, a `$each` whose iterations return. each is called on inputs that take every path and checked against what it returns

tag Shape: u8 {
    dot;
    line:   i64;
    square: i64;
}

rec Pair {
    a: i64;
    b: i64;
}

fun sign(n: i64) i64 {
    if (n < 0)      { ret 0 - 1; }
    or (n > 0)      { ret 1; }
    or              { ret 0; }
}

fun root_over(n: i64) i64 {
    var i: i64 = 0;
    for {
        if (i * i >= n) { ret i; }
        i = i + 1;
    }
}

#[noreturn]
fun stop() {
    for {}
}

fun checked(n: i64) i64 {
    if (n >= 0) { ret n; }
    stop();
}

fun width() i64 {
    $if ($mach.build.pointer_width == 8)      { ret 64; }
    $or ($mach.build.pointer_width == 4)      { ret 32; }
    $or                                       { $error("no width for this target"); }
}

fun size(s: Shape) i64 {
    if (sel s.dot)  { ret 0; }
    or (sel s.line) { ret s.line; }
    or              { ret s.square * s.square; }
}

fun first_field(p: Pair) i64 {
    $each f in $fields(Pair) {
        ret p.[f];
    }
}

fun nested(n: i64) i64 {
    {
        fin { n = n + 1; }
        if (n > 10) { ret 10; }
        or          { ret n; }
    }
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val one: i64 = argc;
    if (sign(0 - 5 * one) != 0 - 1)                    { ret 1; }
    if (sign(5 * one) != 1)                            { ret 2; }
    if (sign(one - 1) != 0)                            { ret 3; }
    if (root_over(17 * one) != 5)                      { ret 4; }
    if (root_over(0) != 0)                             { ret 5; }
    if (checked(7 * one) != 7)                         { ret 6; }
    if (width() != $mach.build.pointer_width * 8)      { ret 7; }
    if (size(Shape.dot{}) != 0)                        { ret 8; }
    if (size(Shape.line{4 * one}) != 4)                { ret 9; }
    if (size(Shape.square{3 * one}) != 9)              { ret 10; }
    if (first_field(Pair{a: 6 * one, b: 2}) != 6)      { ret 11; }
    if (nested(20 * one) != 10)                        { ret 12; }
    if (nested(3 * one) != 3)                          { ret 13; }
    ret 0;
}
