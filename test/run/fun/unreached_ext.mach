use std.runtime;

# an `ext fun` nothing defines, called only by a function nothing refers to: the link judges
# undefined symbols after it collects, so a reference only collected code makes refuses nothing

ext fun corpus_missing_in_this_build() i32;

pub fun never_called() i32 {
    ret corpus_missing_in_this_build();
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    ret 0;
}
