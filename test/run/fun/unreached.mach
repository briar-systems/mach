use std.runtime;

# a function nothing refers to is not in the image, though it states a symbol: a symbol names a
# function for whatever refers to it by name, and keeps nothing (the target files lack it)

#[symbol("corpus_unreached")]
pub fun unreached() i64 {
    ret 1;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    ret 0;
}
