# targets: linux-x86_64 linux-x86_64-gnu darwin-x86_64 freestanding-x86_64
use std.runtime;

# a `va_list` received as a fixed parameter and forwarded to an `ext fun`. on system v x86-64
# the type is an array of one record, so a parameter decays to one pointer in a register. both
# ends of the forward are defined here under #[symbol] with the decayed `ptr`, and the forward
# moves the list from the first argument register to the second.

#[abi_type("va_list")]
def VaList;

#[symbol("corpus_sink")]
fun sink(a: i64, p: ptr) i64 {
    ret a * 0x10000 + (p :~ i64);
}

#[symbol("corpus_sink")]
ext fun c_sink(a: i64, ap: VaList) i64;

#[symbol("corpus_forward")]
fun forward(ap: VaList, a: i64) i64 {
    ret c_sink(a, ap);
}

#[symbol("corpus_forward")]
ext fun c_forward(p: ptr, a: i64) i64;

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    if ($size_of(VaList) != 8 || $align_of(VaList) != 8) { ret 1; }
    if (c_forward(0x1000 :~ ptr, 1) != 0x11000)           { ret 2; }
    ret 0;
}
