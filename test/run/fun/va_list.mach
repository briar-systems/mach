# targets: linux-x86_64 linux-x86_64-optimized linux-x86_64-gnu darwin-x86_64 freestanding-x86_64
use std.runtime;

# a `va_list` received as a fixed parameter and forwarded to an `ext fun`. on system v x86-64
# the type is an array of one record, so a parameter decays to one pointer in a register. the
# naked `enter` hands a raw pointer to `forward` in the first argument register, `forward`
# receives it as a `VaList` and passes it to `c_sink` in the second, and `sink`, the definition
# `c_sink` declares with the same signature, reads the bytes it received.

#[abi_type("va_list")]
def VaList;

#[symbol("corpus_sink")]
fun sink(a: i64, ap: VaList) i64 {
    var p: i64;
    asm x86-64 {
        mov rax, {ap}
        mov {p}, rax
    }
    ret a * 0x10000 + p;
}

#[symbol("corpus_sink")]
ext fun c_sink(a: i64, ap: VaList) i64;

#[symbol("corpus_forward")]
fun forward(ap: VaList, a: i64) i64 {
    ret c_sink(a, ap);
}

#[naked]
fun enter(p: ptr, a: i64) i64 {
    $if ($mach.build.sys == $mach.sys.darwin) {
        asm x86-64 {
            jmp _corpus_forward
        }
    }
    $or {
        asm x86-64 {
            jmp corpus_forward
        }
    }
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    if ($size_of(VaList) != 8 || $align_of(VaList) != 8) { ret 1; }
    if (enter(0x1000 :~ ptr, 1) != 0x11000)               { ret 2; }
    ret 0;
}
