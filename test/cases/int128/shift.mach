# u128 and i128 shifts across the limb boundary and at and past the width (#3756).
# one noinline part per type.

use corpus.lib.fold;
use corpus.lib.fold128;

# u128 shifts: << and >> (logical, zero-filling) across the limb boundary at every
# count below 128, then counts at and past the width (128, 129, 200, 255),
# which saturate: 0 for << and a logical >>, the sign fill for an arithmetic
# >> (#3756). a constant count at or above the width is a compile error, so
# the saturating counts come through a noinline call. the 128-bit shift is
# legalized into a barrel of constant stages, and the saturation wraps it.
#[noinline]
fun opaque_shift_u128(n: u8) u8 {
    ret n;
}

#[noinline]
fun shift_u128(seed: u64) u64 {
    var h: u64  = fold.init();
    val s: u128 = seed::u128;

    val big: u128 = 0xFEDC_BA98_7654_3210_0123_4567_89AB_CDEF;
    val pos: u128 = 0x0123_4567_89AB_CDEF_FEDC_BA98_7654_3210;
    var a:   u128 = big ^ s;
    var b:   u128 = pos ^ s;

    var k: u8 = 0;
    for (k < 128) {
        h = fold128.mix_u128(h, a << k);
        h = fold128.mix_u128(h, a >> k);
        h = fold128.mix_u128(h, b >> k);
        k = k + 1;
    }

    # opaque_shift_u128 counts at and past the width saturate
    h = fold128.mix_u128(h, a << opaque_shift_u128(127));
    h = fold128.mix_u128(h, a >> opaque_shift_u128(127));
    h = fold128.mix_u128(h, b >> opaque_shift_u128(127));
    h = fold128.mix_u128(h, a << opaque_shift_u128(128));
    h = fold128.mix_u128(h, a >> opaque_shift_u128(128));
    h = fold128.mix_u128(h, b >> opaque_shift_u128(128));
    h = fold128.mix_u128(h, a << opaque_shift_u128(129));
    h = fold128.mix_u128(h, a >> opaque_shift_u128(129));
    h = fold128.mix_u128(h, b >> opaque_shift_u128(129));
    h = fold128.mix_u128(h, a << opaque_shift_u128(200));
    h = fold128.mix_u128(h, a >> opaque_shift_u128(200));
    h = fold128.mix_u128(h, b >> opaque_shift_u128(200));
    h = fold128.mix_u128(h, a << opaque_shift_u128(255));
    h = fold128.mix_u128(h, a >> opaque_shift_u128(255));
    h = fold128.mix_u128(h, b >> opaque_shift_u128(255));

    # a seeded u64 count that straddles the width
    var j: u64 = 0;
    for (j < 12) {
        val n: u64 = 122 + j + (seed & 3);
        h = fold128.mix_u128(h, a << n);
        h = fold128.mix_u128(h, a >> n);
        h = fold128.mix_u128(h, b >> n);
        j = j + 1;
    }

    ret h;
}

# i128 shifts: << and >> (arithmetic, sign-filling) across the limb boundary at every
# count below 128, then counts at and past the width (128, 129, 200, 255),
# which saturate: 0 for << and a logical >>, the sign fill for an arithmetic
# >> (#3756). a constant count at or above the width is a compile error, so
# the saturating counts come through a noinline call. the 128-bit shift is
# legalized into a barrel of constant stages, and the saturation wraps it.
#[noinline]
fun opaque_shift_i128(n: u8) u8 {
    ret n;
}

#[noinline]
fun shift_i128(seed: u64) u64 {
    var h: u64  = fold.init();
    val s: i128 = seed::i128;

    val big: i128 = -0x0123_4567_89AB_CDEF_FEDC_BA98_7654_3211;
    val pos: i128 = 0x7EDC_BA98_7654_3210_0123_4567_89AB_CDEF;
    var a:   i128 = big ^ s;
    var b:   i128 = pos ^ s;

    var k: u8 = 0;
    for (k < 128) {
        h = fold128.mix_i128(h, a << k);
        h = fold128.mix_i128(h, a >> k);
        h = fold128.mix_i128(h, b >> k);
        k = k + 1;
    }

    # opaque_shift_i128 counts at and past the width saturate
    h = fold128.mix_i128(h, a << opaque_shift_i128(127));
    h = fold128.mix_i128(h, a >> opaque_shift_i128(127));
    h = fold128.mix_i128(h, b >> opaque_shift_i128(127));
    h = fold128.mix_i128(h, a << opaque_shift_i128(128));
    h = fold128.mix_i128(h, a >> opaque_shift_i128(128));
    h = fold128.mix_i128(h, b >> opaque_shift_i128(128));
    h = fold128.mix_i128(h, a << opaque_shift_i128(129));
    h = fold128.mix_i128(h, a >> opaque_shift_i128(129));
    h = fold128.mix_i128(h, b >> opaque_shift_i128(129));
    h = fold128.mix_i128(h, a << opaque_shift_i128(200));
    h = fold128.mix_i128(h, a >> opaque_shift_i128(200));
    h = fold128.mix_i128(h, b >> opaque_shift_i128(200));
    h = fold128.mix_i128(h, a << opaque_shift_i128(255));
    h = fold128.mix_i128(h, a >> opaque_shift_i128(255));
    h = fold128.mix_i128(h, b >> opaque_shift_i128(255));

    # a seeded u64 count that straddles the width
    var j: u64 = 0;
    for (j < 12) {
        val n: u64 = 122 + j + (seed & 3);
        h = fold128.mix_i128(h, a << n);
        h = fold128.mix_i128(h, a >> n);
        h = fold128.mix_i128(h, b >> n);
        j = j + 1;
    }

    ret h;
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    h = fold.mix_u64(h, shift_u128(seed));
    h = fold.mix_u64(h, shift_i128(seed));
    ret h;
}
