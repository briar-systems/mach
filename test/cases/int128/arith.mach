# u128 and i128 add, sub, negate, bitwise and shifts across the limb boundary.
# one noinline part per type.

use corpus.lib.fold;
use corpus.lib.fold128;

# u128 add, sub, negate, bitwise and shifts across the limb boundary, seeded so
# the carries and the wraps cannot fold away at compile time.
#[noinline]
fun arith_u128(seed: u64) u64 {
    var h: u64  = fold.init();
    val s: u128 = seed::u128;

    val lo_ones: u128 = 18446744073709551615;
    val top:     u128 = 1u128 << 127;
    val big:     u128 = 0x0123_4567_89AB_CDEF_FEDC_BA98_7654_3210;

    var a: u128 = lo_ones + s;
    var i: u128 = 0;
    for (i < 20) {
        a = a + (lo_ones - i);
        h = fold128.mix_u128(h, a);
        a = a - (i * 3 + 1);
        h = fold128.mix_u128(h, a);
        i = i + 1;
    }

    var b: u128 = big ^ s;
    h = fold128.mix_u128(h, b + b);
    h = fold128.mix_u128(h, b - a);
    h = fold128.mix_u128(h, a - b);
    h = fold128.mix_u128(h, 0 - b);
    h = fold128.mix_u128(h, ~b);
    h = fold128.mix_u128(h, b & a);
    h = fold128.mix_u128(h, b | a);
    h = fold128.mix_u128(h, b ^ a);
    h = fold128.mix_u128(h, top + top);
    h = fold128.mix_u128(h, top - 1 + s);

    var k: u128 = 0;
    for (k < 128) {
        h = fold128.mix_u128(h, b << k);
        h = fold128.mix_u128(h, b >> k);
        h = fold128.mix_u128(h, (b << k) | (b >> (127 - k)));
        k = k + 9;
    }
    h = fold128.mix_u128(h, b << 64);
    h = fold128.mix_u128(h, b >> 64);
    h = fold128.mix_u128(h, (b >> 64) << 64);
    h = fold.mix_u64(h, (b >> 64)::u64);
    h = fold.mix_u64(h, b::u64);
    ret h;
}

# i128 add, sub, negate and arithmetic shift with the sign in the high limb,
# every operand seeded so the borrow across the limbs is computed at run time.
# no signed result overflows: the C reference has no UB to hide behind.
#[noinline]
fun arith_i128(seed: u64) u64 {
    var h: u64  = fold.init();
    val s: i128 = seed::i128;

    val imax:    i128 = 170141183460469231731687303715884105727;
    val imin:    i128 = -170141183460469231731687303715884105727 - 1;
    val lo_ones: i128 = 18446744073709551615;

    var a: i128 = -lo_ones - s;
    var i: i128 = 0;
    for (i < 20) {
        a = a - (lo_ones - i);
        h = fold128.mix_i128(h, a);
        a = a + (i * 5 + 2);
        h = fold128.mix_i128(h, a);
        i = i + 1;
    }

    val b: i128 = (0x0123_4567_89AB_CDEF_FEDC_BA98_7654_3210 ^ s) - imax;
    h = fold128.mix_i128(h, b);
    h = fold128.mix_i128(h, 0 - b);
    h = fold128.mix_i128(h, -b);
    h = fold128.mix_i128(h, b + a);
    h = fold128.mix_i128(h, b - a);
    h = fold128.mix_i128(h, imax - s);
    h = fold128.mix_i128(h, imin + s);
    h = fold128.mix_i128(h, imax + imin);
    h = fold128.mix_i128(h, ~b);

    var k: i128 = 0;
    for (k < 128) {
        h = fold128.mix_i128(h, a >> k);
        h = fold128.mix_i128(h, b >> k);
        h = fold128.mix_i128(h, imin >> k);
        k = k + 11;
    }
    h = fold128.mix_i128(h, a >> 64);
    h = fold128.mix_i128(h, a >> 127);
    h = fold128.mix_i128(h, (imax >> 5) << 3);
    h = fold.mix_i64(h, a::i64);
    h = fold.mix_i64(h, (a >> 64)::i64);
    ret h;
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    h = fold.mix_u64(h, arith_u128(seed));
    h = fold.mix_u64(h, arith_i128(seed));
    ret h;
}
