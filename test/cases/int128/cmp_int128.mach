# every comparison over 128-bit operands, same type and mixed: u128 against
# u128 and i128 against i128 where the limbs alone disagree with the whole,
# then the mixed pairs (u128 with i128, u128 with u64, i128 with i64), which
# compare mathematical values, so a negative is below every unsigned value.

use corpus.lib.fold;
use corpus.lib.fold128;

fun bit(c: u8) u64 {
    ret c::u64;
}

fun fold_pair_u(h: u64, a: u128, b: u128) u64 {
    var r: u64 = h;
    r = fold.mix_u64(r, bit(a == b));
    r = fold.mix_u64(r, bit(a != b));
    r = fold.mix_u64(r, bit(a < b));
    r = fold.mix_u64(r, bit(a <= b));
    r = fold.mix_u64(r, bit(a > b));
    r = fold.mix_u64(r, bit(a >= b));
    ret r;
}

fun fold_pair_s(h: u64, a: i128, b: i128) u64 {
    var r: u64 = h;
    r = fold.mix_u64(r, bit(a == b));
    r = fold.mix_u64(r, bit(a != b));
    r = fold.mix_u64(r, bit(a < b));
    r = fold.mix_u64(r, bit(a <= b));
    r = fold.mix_u64(r, bit(a > b));
    r = fold.mix_u64(r, bit(a >= b));
    ret r;
}

fun fold_pair_us(h: u64, a: u128, b: i128) u64 {
    var r: u64 = h;
    r = fold.mix_u64(r, bit(a == b));
    r = fold.mix_u64(r, bit(a != b));
    r = fold.mix_u64(r, bit(a < b));
    r = fold.mix_u64(r, bit(a <= b));
    r = fold.mix_u64(r, bit(a > b));
    r = fold.mix_u64(r, bit(a >= b));
    r = fold.mix_u64(r, bit(b < a));
    r = fold.mix_u64(r, bit(b >= a));
    ret r;
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: u128 = seed::u128;
    val t: i128 = seed::i128;

    val u: [6]u128 = [6]u128{0, s, (1u128 << 64) + s, (1u128 << 64) - 1 - s, (1u128 << 127) + s,
        340282366920938463463374607431768211455 - s};
    val v: [6]i128 = [6]i128{0, t, (1i128 << 64) + t, -1 - t, -(1i128 << 64) - t,
        -170141183460469231731687303715884105727 - 1 + t};

    var i: u64 = 0;
    for (i < 6) {
        var j: u64 = 0;
        for (j < 6) {
            h = fold_pair_u(h, u[i], u[j]);
            h = fold_pair_s(h, v[i], v[j]);
            h = fold_pair_us(h, u[i], v[j]);
            j = j + 1;
        }
        i = i + 1;
    }

    val w64: u64 = 18446744073709551615 - seed;
    val n64: i64 = -1 - seed::i64;
    i = 0;
    for (i < 6) {
        h = fold.mix_u64(h, bit(u[i] < w64));
        h = fold.mix_u64(h, bit(u[i] == w64));
        h = fold.mix_u64(h, bit(w64 <= u[i]));
        h = fold.mix_u64(h, bit(v[i] < n64));
        h = fold.mix_u64(h, bit(v[i] == n64));
        h = fold.mix_u64(h, bit(n64 >= v[i]));
        h = fold.mix_u64(h, bit(u[i] > n64));
        h = fold.mix_u64(h, bit(v[i] < w64));
        i = i + 1;
    }
    ret h;
}
