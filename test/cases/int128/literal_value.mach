# `::` converts an untyped literal's exact value, then extends or truncates it to
# the target as it would any value, and a literal expression runs at its context
# type, so a shift wider than i64 is exact. each value is checked in a global the
# compiler folds, passed through a call at run time, and against the suffixed
# literal of the same value, which `$if` also compares at compile time

use corpus.lib.fold;
use corpus.lib.fold128;

val CAST_2P64:     u128 = 18446744073709551616::u128;
val CAST_1E19:     u128 = 10000000000000000000::u128;
val CAST_NEG_2P64: i128 = (-18446744073709551616)::i128;
val CAST_U128_MAX: u128 = 340282366920938463463374607431768211455::u128;
val CAST_I128_MAX: i128 = 170141183460469231731687303715884105727::i128;
val CAST_I128_MIN: i128 = (-170141183460469231731687303715884105728)::i128;
val SHL_2P100:     u128 = 1 << 100;

fun cast_comptime_exact() u8 {
    $if (18446744073709551616::u128 == 18446744073709551616u128 && (-18446744073709551616)::i128 == -18446744073709551616i128) { ret 1; }
    $or                                                                                                                        { ret 0; }
}

#[noinline]
fun through_u128(x: u128) u128 {
    ret x;
}

#[noinline]
fun through_i128(x: i128) i128 {
    ret x;
}

fun same_u128(a: u128, b: u128) u8 {
    if (a == b) { ret 1; }
    ret 0;
}

fun same_i128(a: i128, b: i128) u8 {
    if (a == b) { ret 1; }
    ret 0;
}

pub fun checksum(seed: u64) u64 {
    var h: u64  = fold.init();
    val s: u128 = seed::u128;
    val t: i128 = seed::i128;

    h = fold.mix_u8(h, cast_comptime_exact());

    h = fold128.mix_u128(h, CAST_2P64 + s);
    h = fold128.mix_u128(h, CAST_1E19 + s);
    h = fold128.mix_i128(h, CAST_NEG_2P64 + t);
    h = fold128.mix_u128(h, CAST_U128_MAX - s);
    h = fold128.mix_i128(h, CAST_I128_MAX - t);
    h = fold128.mix_i128(h, CAST_I128_MIN + t);
    h = fold.mix_u8(h, same_u128(CAST_2P64 + s, 18446744073709551616u128 + s));
    h = fold.mix_u8(h, same_u128(CAST_1E19 + s, 10000000000000000000u128 + s));
    h = fold.mix_u8(h, same_i128(CAST_NEG_2P64 + t, -18446744073709551616i128 + t));
    h = fold.mix_u8(h, same_u128(CAST_U128_MAX - s, 340282366920938463463374607431768211455u128 - s));
    h = fold.mix_u8(h, same_i128(CAST_I128_MAX - t, 170141183460469231731687303715884105727i128 - t));
    h = fold.mix_u8(h, same_i128(CAST_I128_MIN + t, -170141183460469231731687303715884105728i128 + t));

    h = fold128.mix_u128(h, through_u128(18446744073709551616::u128) + s);
    h = fold128.mix_u128(h, through_u128(10000000000000000000::u128) + s);
    h = fold128.mix_i128(h, through_i128((-18446744073709551616)::i128) + t);
    h = fold128.mix_u128(h, through_u128(340282366920938463463374607431768211455::u128) - s);
    h = fold128.mix_i128(h, through_i128(170141183460469231731687303715884105727::i128) - t);
    h = fold128.mix_i128(h, through_i128((-170141183460469231731687303715884105728)::i128) + t);

    h = fold128.mix_u128(h, SHL_2P100 + s);
    h = fold128.mix_u128(h, through_u128(1 << 100) + s);
    h = fold128.mix_u128(h, through_u128((1 << 100)::u128) + s);
    h = fold.mix_u8(h, same_u128(SHL_2P100 + s, 1267650600228229401496703205376u128 + s));
    ret h;
}
