# the unsigned and signed 128-bit products: widening, high half and full product.
# one noinline part per type.

use corpus.lib.fold;
use corpus.lib.fold128;

# the three unsigned products a 128-bit type offers: the full u64 x u64 product
# through widening, its high half selected by a shift by 64, and the wrapping
# u128 x u128 low product. the operands are seeded so nothing folds.
#[noinline]
fun wide_mul_u128(a: u64, b: u64) u128 {
    ret (a::u128) * (b::u128);
}

#[noinline]
fun high_mul_u128(a: u64, b: u64) u64 {
    ret (((a::u128) * (b::u128)) >> 64)::u64;
}

#[noinline]
fun low_mul_u128(a: u128, b: u128) u128 {
    ret a * b;
}

#[noinline]
fun mul_u128(seed: u64) u64 {
    var h: u64 = fold.init();

    val ops: [8]u64 = [8]u64{0, 1, 18446744073709551615, 9223372036854775808,
        6510615555426900570 ^ seed, 14106333703424951235 ^ seed, 7 ^ seed, 18446744073709551614 ^ seed};
    var i: u64 = 0;
    for (i < 8) {
        var j: u64 = 0;
        for (j < 8) {
            h = fold128.mix_u128(h, wide_mul_u128(ops[i], ops[j]));
            h = fold.mix_u64(h, high_mul_u128(ops[i], ops[j]));
            h = fold.mix_u64(h, (ops[i]::u128 * ops[j]::u128)::u64);
            j = j + 1;
        }
        i = i + 1;
    }

    val s: u128 = seed::u128;
    var a: u128 = 0x0123_4567_89AB_CDEF_FEDC_BA98_7654_3210 + s;
    var k: u128 = 0;
    for (k < 12) {
        a = low_mul_u128(a, (k << 64) + 2 * k + 3);
        h = fold128.mix_u128(h, a);
        k = k + 1;
    }
    val b: u128 = 340282366920938463463374607431768211455 - s;
    h = fold128.mix_u128(h, low_mul_u128(b, b));
    h = fold128.mix_u128(h, low_mul_u128(b, a));
    h = fold128.mix_u128(h, low_mul_u128(a, b));
    h = fold128.mix_u128(h, a * a);
    h = fold128.mix_u128(h, a * 340282366920938463463374607431768211455);
    h = fold128.mix_u128(h, a * 18446744073709551616);
    ret h;
}

# the signed products: the full i64 x i64 product through widening, its high
# half by an arithmetic shift by 64, and an i128 x i128 product that stays in
# range. the operands cover both signs and the extremes, seeded so nothing
# folds. no product overflows i128, so the C reference has no UB.
#[noinline]
fun wide_mul_i128(a: i64, b: i64) i128 {
    ret (a::i128) * (b::i128);
}

#[noinline]
fun high_mul_i128(a: i64, b: i64) i64 {
    ret (((a::i128) * (b::i128)) >> 64)::i64;
}

#[noinline]
fun mul_i128(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: i64 = (seed & 1023)::i64;

    val ops: [8]i64 = [8]i64{0, 1, -1, -9223372036854775807 - 1, 9223372036854775807 - s,
        -6510615555426900570 + s, 7 + s, -7 - s};
    var i: u64 = 0;
    for (i < 8) {
        var j: u64 = 0;
        for (j < 8) {
            h = fold128.mix_i128(h, wide_mul_i128(ops[i], ops[j]));
            h = fold.mix_i64(h, high_mul_i128(ops[i], ops[j]));
            h = fold.mix_i64(h, (ops[i]::i128 * ops[j]::i128)::i64);
            j = j + 1;
        }
        i = i + 1;
    }

    # both factors stay below 2^63 in magnitude, so the product fits
    var a: i128 = -(0x7EDC_BA98_7654_3210::i128) - s::i128;
    var k: i128 = 1;
    for (k < 6) {
        val p: i128 = a * (k - 3);
        h = fold128.mix_i128(h, p);
        h = fold128.mix_i128(h, (k - 3) * a);
        h = fold128.mix_i128(h, p >> 64);
        k = k + 1;
    }
    val b: i128 = (1i128 << 62) + s::i128;
    h = fold128.mix_i128(h, b * b);
    h = fold128.mix_i128(h, b * -b);
    h = fold128.mix_i128(h, -b * -b);
    h = fold128.mix_i128(h, a * 4);
    h = fold128.mix_i128(h, a * -4);
    ret h;
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    h = fold.mix_u64(h, mul_u128(seed));
    h = fold.mix_u64(h, mul_i128(seed));
    ret h;
}
