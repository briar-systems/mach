# conversions into and out of the 128-bit types: zero and sign extension from
# every narrower width, truncation to every narrower width, the u128/i128
# reinterpretation, and the float conversions in both directions on values
# whose rounding crosses the limb boundary. every float that converts to an
# integer is in range, so the C reference has no UB.

use corpus.lib.fold;
use corpus.lib.fold128;

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();

    val a8: i8 = ((seed::u8) | 128):~i8;
    val a16: i16 = ((seed::u16) | 32768):~i16;
    val a32: i32 = ((seed::u32) | 2147483648):~i32;
    val a64: i64 = (seed | 9223372036854775808):~i64;
    val u8v: u8 = a8:~u8;
    val u16v: u16 = a16:~u16;
    val u32v: u32 = a32:~u32;
    val u64v: u64 = a64:~u64;

    h = fold128.mix_i128(h, a8::i128);
    h = fold128.mix_i128(h, a16::i128);
    h = fold128.mix_i128(h, a32::i128);
    h = fold128.mix_i128(h, a64::i128);
    h = fold128.mix_u128(h, u8v::u128);
    h = fold128.mix_u128(h, u16v::u128);
    h = fold128.mix_u128(h, u32v::u128);
    h = fold128.mix_u128(h, u64v::u128);
    h = fold128.mix_u128(h, a64::u128);
    h = fold128.mix_i128(h, u64v::i128);

    val w: u128 = (u64v::u128 << 64) | (seed ^ 0x5555_5555_5555_5555)::u128;
    val x: i128 = w:~i128;
    h = fold.mix_u8(h, w::u8);
    h = fold.mix_u16(h, w::u16);
    h = fold.mix_u32(h, w::u32);
    h = fold.mix_u64(h, w::u64);
    h = fold.mix_i8(h, x::i8);
    h = fold.mix_i16(h, x::i16);
    h = fold.mix_i32(h, x::i32);
    h = fold.mix_i64(h, x::i64);
    h = fold128.mix_i128(h, x);
    h = fold128.mix_u128(h, x:~u128);
    h = fold128.mix_i128(h, w::i128);
    h = fold128.mix_u128(h, x::u128);

    # to float: values above 2^64 and above 2^53 within the high limb, both signs
    h = fold.mix_f64(h, w::f64);
    h = fold.mix_f64(h, x::f64);
    h = fold.mix_f64(h, (w >> 3)::f64);
    h = fold.mix_f64(h, (x >> 3)::f64);
    h = fold.mix_f64(h, ((1u128 << 100) + seed::u128)::f64);
    h = fold.mix_f64(h, (0 - ((1i128 << 100) + seed::i128))::f64);
    h = fold.mix_f64(h, ((1u128 << 64) + 1)::f64);
    h = fold.mix_f64(h, ((1u128 << 64) + (1u128 << 11) + 1)::f64);
    h = fold.mix_f32(h, (w >> 4)::f32);
    h = fold.mix_f32(h, x::f32);

    # from float: exact powers of two beyond 2^64, and fractions that truncate
    val big: f64 = 1.0e30 + seed::f64;
    h = fold128.mix_u128(h, big::u128);
    h = fold128.mix_i128(h, big::i128);
    h = fold128.mix_i128(h, (0.0 - big)::i128);
    h = fold128.mix_u128(h, 18446744073709551616.0::u128);
    h = fold128.mix_u128(h, 1.5::u128);
    h = fold128.mix_i128(h, (-1.5)::i128);
    h = fold128.mix_u128(h, (3.0e38 + seed::f64)::u128);
    h = fold128.mix_i128(h, (1.5e38 + seed::f64)::i128);
    h = fold128.mix_i128(h, (-1.5e38 - seed::f64)::i128);
    h = fold128.mix_u128(h, (1.0e20::f32)::u128);
    ret h;
}
