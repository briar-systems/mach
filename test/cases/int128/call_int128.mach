# 128-bit values across calls: passed at every register position a convention
# treats specially (the odd position AAPCS64 rounds past, the position where
# one register is left, the stack), returned, and mixed with floats and
# narrower integers, through functions the optimizer may not inline.

use corpus.lib.fold;
use corpus.lib.fold128;

#[noinline]
fun ret_wide(lo: u64, hi: u64) u128 {
    ret (hi::u128 << 64) | lo::u128;
}

#[noinline]
fun ret_signed(v: i64) i128 {
    ret v::i128 * 3;
}

#[noinline]
fun odd_then_wide(a: u64, b: u128, c: u64) u128 {
    ret b + a::u128 - c::u128;
}

#[noinline]
fun three_wide(a: u128, b: u128, c: u128, d: u64) u128 {
    ret a ^ (b << 1) ^ (c >> 1) ^ d::u128;
}

#[noinline]
fun six_then_wide(a: u64, b: u64, c: u64, d: u64, e: u64, f: u64, g: u128, h: u64) u128 {
    ret g + (a + b + c + d + e + f + h)::u128;
}

#[noinline]
fun seven_then_wide(a: u64, b: u64, c: u64, d: u64, e: u64, f: u64, g: u64, w: u128, z: u64) u128 {
    ret w - (a + b + c + d + e + f + g)::u128 + z::u128;
}

#[noinline]
fun eight_then_wide(a: u64, b: u64, c: u64, d: u64, e: u64, f: u64, g: u64, h: u64, w: u128, v: i128) i128 {
    ret v - w:~i128 + (a + b + c + d + e + f + g + h)::i128;
}

#[noinline]
fun floats_between(a: f64, b: u128, c: f32, d: i128, e: f64) i128 {
    ret d + b:~i128 + (a::i64)::i128 + (c::i64)::i128 - (e::i64)::i128;
}

#[noinline]
fun many_wide(a: u128, b: u128, c: u128, d: u128, e: u128, f: u128, g: u128, h: u128, i: u128) u128 {
    ret a + (b << 1) + (c << 2) + (d << 3) + (e << 4) + (f << 5) + (g << 6) + (h << 7) + (i << 8);
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: u64 = seed;
    val w: u128 = ret_wide(s ^ 0x0F0F_0F0F_0F0F_0F0F, 0xFEDC_BA98_7654_3210 + s);
    val n: i128 = ret_signed(-1 - s::i64);
    h = fold128.mix_u128(h, w);
    h = fold128.mix_i128(h, n);
    h = fold128.mix_u128(h, odd_then_wide(s + 1, w, s + 2));
    h = fold128.mix_u128(h, three_wide(w, w + 1, w + 2, s));
    h = fold128.mix_u128(h, six_then_wide(s, s + 1, s + 2, s + 3, s + 4, s + 5, w, s + 6));
    h = fold128.mix_u128(h, seven_then_wide(s, s + 1, s + 2, s + 3, s + 4, s + 5, s + 6, w, s + 7));
    h = fold128.mix_i128(h, eight_then_wide(s, s + 1, s + 2, s + 3, s + 4, s + 5, s + 6, s + 7, w, n));
    h = fold128.mix_i128(h, floats_between(1.5 + s::f64, w, 2.5, n, -3.5));
    h = fold128.mix_u128(h, many_wide(w, w + 1, w + 2, w + 3, w + 4, w + 5, w + 6, w + 7, w + 8));
    ret h;
}
