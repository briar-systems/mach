# the signed products: the full i64 x i64 product through widening, its high
# half by an arithmetic shift by 64, and an i128 x i128 product that stays in
# range. the operands cover both signs and the extremes, seeded so nothing
# folds. no product overflows i128, so the C reference has no UB.

use corpus.lib.fold;
use corpus.lib.fold128;

#[noinline]
fun wide(a: i64, b: i64) i128 {
    ret (a::i128) * (b::i128);
}

#[noinline]
fun high(a: i64, b: i64) i64 {
    ret (((a::i128) * (b::i128)) >> 64)::i64;
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: i64 = (seed & 1023)::i64;

    val ops: [8]i64 = [8]i64{0, 1, -1, -9223372036854775807 - 1, 9223372036854775807 - s,
        -6510615555426900570 + s, 7 + s, -7 - s};
    var i: u64 = 0;
    for (i < 8) {
        var j: u64 = 0;
        for (j < 8) {
            h = fold128.mix_i128(h, wide(ops[i], ops[j]));
            h = fold.mix_i64(h, high(ops[i], ops[j]));
            h = fold.mix_i64(h, (ops[i]::i128 * ops[j]::i128)::i64);
            j = j + 1;
        }
        i = i + 1;
    }

    # both factors stay below 2^63 in magnitude, so the product fits
    var a: i128 = -(0x7EDC_BA98_7654_3210::i128) - s::i128;
    var k: i128 = 1;
    for (k < 6) {
        val p: i128 = a * (k - 3);
        h = fold128.mix_i128(h, p);
        h = fold128.mix_i128(h, (k - 3) * a);
        h = fold128.mix_i128(h, p >> 64);
        k = k + 1;
    }
    val b: i128 = (1i128 << 62) + s::i128;
    h = fold128.mix_i128(h, b * b);
    h = fold128.mix_i128(h, b * -b);
    h = fold128.mix_i128(h, -b * -b);
    h = fold128.mix_i128(h, a * 4);
    h = fold128.mix_i128(h, a * -4);
    ret h;
}
