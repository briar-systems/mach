# u128 and i128 quotients and remainders through the compiler's helpers.
# one noinline part per type.

use corpus.lib.fold;
use corpus.lib.fold128;

# u128 quotients and remainders through the compiler's helpers, at every shape
# the restoring division sees: divisors below and above the limb boundary,
# dividends below the divisor, equal operands, powers of two and all-ones, with
# both seeded so nothing folds. a quotient and remainder of one pair are
# checked against each other through q * d + r.
#[noinline]
fun divrem_u128(seed: u64) u64 {
    var h: u64  = fold.init();
    val s: u128 = seed::u128;

    val big: u128    = 0x0123_4567_89AB_CDEF_FEDC_BA98_7654_3210 + s;
    val ds:  [8]u128 = [8]u128{1, 3 + s, 4294967311, 18446744073709551615 - s, 18446744073709551616 + s,
        (1u128 << 100) + 12345 + s, big >> 7, 340282366920938463463374607431768211455 - s};
    val ns: [6]u128 = [6]u128{0, 7 + s, 18446744073709551615, big, 340282366920938463463374607431768211455, big ^ (s << 77)};

    var i: u64 = 0;
    for (i < 6) {
        var j: u64 = 0;
        for (j < 8) {
            val q: u128 = ns[i] / ds[j];
            val r: u128 = ns[i] % ds[j];
            h = fold128.mix_u128(h, q);
            h = fold128.mix_u128(h, r);
            h = fold128.mix_u128(h, q * ds[j] + r - ns[i]);
            j = j + 1;
        }
        i = i + 1;
    }

    var a: u128 = big;
    var k: u128 = 0;
    for (k < 10) {
        a = a / (k + 2);
        h = fold128.mix_u128(h, a);
        h = fold128.mix_u128(h, big % (a + 1));
        k = k + 1;
    }
    h = fold128.mix_u128(h, big / big);
    h = fold128.mix_u128(h, big % big);
    h = fold128.mix_u128(h, (big >> 64) / ((big::u64)::u128 + 1));
    ret h;
}

# i128 quotients and remainders in every sign combination: the quotient
# truncates toward zero and the remainder takes the dividend's sign, as C's
# do. the extremes stay clear of imin / -1, the one pair whose quotient does
# not exist, so the C reference has no UB.
#[noinline]
fun divrem_i128(seed: u64) u64 {
    var h: u64  = fold.init();
    val s: i128 = (seed & 1023)::i128;

    val imax: i128 = 170141183460469231731687303715884105727;
    val imin: i128 = -170141183460469231731687303715884105727 - 1;
    val big:  i128 = 0x0123_4567_89AB_CDEF_FEDC_BA98_7654_3210 + s;

    val ds: [8]i128 = [8]i128{1, -1, 3 + s, -(3 + s), 18446744073709551616 + s, -(18446744073709551616 + s), big >> 9, imax - s};
    val ns: [7]i128 = [7]i128{0, 7 + s, -(7 + s), big, -big, imax, imin + s + 1};

    var i: u64 = 0;
    for (i < 7) {
        var j: u64 = 0;
        for (j < 8) {
            val q: i128 = ns[i] / ds[j];
            val r: i128 = ns[i] % ds[j];
            h = fold128.mix_i128(h, q);
            h = fold128.mix_i128(h, r);
            h = fold128.mix_i128(h, q * ds[j] + r - ns[i]);
            j = j + 1;
        }
        i = i + 1;
    }

    h = fold128.mix_i128(h, imin / 2);
    h = fold128.mix_i128(h, imin % 2);
    h = fold128.mix_i128(h, imin / imax);
    h = fold128.mix_i128(h, imin % imax);
    h = fold128.mix_i128(h, imin / (imin + 1));
    h = fold128.mix_i128(h, imax / -7);
    h = fold128.mix_i128(h, imax % -7);
    h = fold128.mix_i128(h, -7 / imax);
    h = fold128.mix_i128(h, -7 % imax);
    ret h;
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    h = fold.mix_u64(h, divrem_u128(seed));
    h = fold.mix_u64(h, divrem_i128(seed));
    ret h;
}
