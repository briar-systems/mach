# the f32 values that a lowering is most likely to lose: both zeros, both
# infinities, NaN, and the denormal range. every non-NaN result folds its exact
# bit pattern, so -0.0 is distinguished from +0.0 and a denormal from zero, which
# folding by value could never do.

use corpus.lib.fold;

fun opaque_f32(bits: u32, s: u32) f32 { ret (bits + s):~f32; }

# a NaN result's payload and sign are not fixed across targets: x86 hands back a
# quieted source operand and riscv hands back its own canonical NaN. so an
# operation that produces a NaN is verified to produce a NaN and nothing more,
# while every other result is verified bit for bit.
fun fold32(h: u64, v: f32) u64 {
    if (v != v) { ret fold.mix_u32(h, 0xFFFFFFFF); }
    ret fold.mix_f32(h, v);
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: u32 = seed::u32;

    val one:  f32 = opaque_f32(0x3F800000, s);
    val mone: f32 = opaque_f32(0xBF800000, s);
    val pz:   f32 = opaque_f32(0x00000000, s);
    val nz:   f32 = opaque_f32(0x80000000, s);
    val pinf: f32 = opaque_f32(0x7F800000, s);
    val ninf: f32 = opaque_f32(0xFF800000, s);
    val nan:  f32 = opaque_f32(0x7FC00000, s);
    val fmax: f32 = opaque_f32(0x7F7FFFFF, s);
    val fmin: f32 = opaque_f32(0x00800000, s);
    val dmax: f32 = opaque_f32(0x007FFFFF, s);
    val tiny: f32 = opaque_f32(0x00000001, s);

    # signed zero. the sum of two zeros is negative only when both are, the
    # difference follows the second operand's sign, and the product follows the
    # sign rule, so every one of these separates -0.0 from +0.0 by bits alone.
    h = fold32(h, pz);
    h = fold32(h, nz);
    h = fold32(h, pz + pz);
    h = fold32(h, pz + nz);
    h = fold32(h, nz + pz);
    h = fold32(h, nz + nz);
    h = fold32(h, pz - pz);
    h = fold32(h, pz - nz);
    h = fold32(h, nz - pz);
    h = fold32(h, nz - nz);
    h = fold32(h, pz * one);
    h = fold32(h, pz * mone);
    h = fold32(h, nz * one);
    h = fold32(h, nz * mone);
    h = fold32(h, nz * nz);
    h = fold32(h, pz * nz);
    h = fold32(h, -pz);
    h = fold32(h, -nz);
    h = fold32(h, pz / one);
    h = fold32(h, pz / mone);
    h = fold32(h, nz / one);
    h = fold32(h, nz / mone);
    h = fold.mix_u8(h, pz == nz);
    h = fold.mix_u8(h, pz < nz);
    h = fold.mix_u8(h, nz < pz);

    # infinity, including the two exact signed zeros a finite divided by an
    # infinity must land on
    h = fold32(h, pinf);
    h = fold32(h, ninf);
    h = fold32(h, -pinf);
    h = fold32(h, one / pz);
    h = fold32(h, one / nz);
    h = fold32(h, mone / pz);
    h = fold32(h, mone / nz);
    h = fold32(h, pinf + one);
    h = fold32(h, pinf + pinf);
    h = fold32(h, pinf - ninf);
    h = fold32(h, pinf * pinf);
    h = fold32(h, pinf * ninf);
    h = fold32(h, pinf * mone);
    h = fold32(h, one / pinf);
    h = fold32(h, mone / pinf);
    h = fold32(h, one / ninf);
    h = fold32(h, pinf / one);
    h = fold32(h, fmax + fmax);
    h = fold.mix_u8(h, pinf > fmax);
    h = fold.mix_u8(h, ninf < 0.0f32 - fmax);

    # the invalid operations. each is verified to be a NaN and not to be anything
    # else: the payload a target hands back is its own choice, so folding it would
    # be reporting more than the corpus can anchor.
    h = fold32(h, pinf - pinf);
    h = fold32(h, ninf + pinf);
    h = fold32(h, pinf * pz);
    h = fold32(h, ninf * nz);
    h = fold32(h, pinf / pinf);
    h = fold32(h, pz / pz);
    h = fold32(h, nz / pz);

    # NaN as an operand. identity is exact, arithmetic is classified, and the
    # negation is exact because it is defined as the sign-bit flip on every
    # operand rather than as an arithmetic operation.
    h = fold.mix_u32(h, nan:~u32);
    h = fold.mix_u8(h, nan != nan);
    h = fold.mix_u8(h, nan == nan);
    h = fold.mix_u8(h, nan < nan);
    h = fold.mix_u8(h, nan >= nan);
    h = fold.mix_u32(h, (-nan):~u32);
    h = fold.mix_u32(h, (-(-nan)):~u32);
    h = fold32(h, nan + one);
    h = fold32(h, one + nan);
    h = fold32(h, nan * pz);
    h = fold32(h, nan - nan);
    h = fold32(h, nan / nan);
    h = fold32(h, nan / pinf);

    # the denormal range. gradual underflow is a value question, not a speed
    # lever: a lowering that flushes to zero loses every one of these.
    h = fold32(h, tiny);
    h = fold32(h, dmax);
    h = fold32(h, fmin);
    h = fold32(h, dmax + tiny);
    h = fold32(h, fmin - tiny);
    h = fold32(h, tiny + tiny);
    h = fold32(h, tiny * 1.5f32);
    h = fold32(h, tiny * 0.5f32);
    h = fold32(h, -tiny);
    h = fold32(h, tiny * 8388608.0f32);
    h = fold32(h, dmax / fmin);
    h = fold.mix_u8(h, tiny > pz);
    h = fold.mix_u8(h, tiny == pz);
    h = fold.mix_u8(h, (0.0f32 - tiny) < nz);

    # the whole ladder from the smallest normal down through every binade of the
    # denormal range and into zero, in one halving step at a time
    var d: f32 = fmin;
    var i: u32 = 0;
    for (i < 30) {
        d = d * 0.5f32;
        h = fold32(h, d);
        i = i + 1;
    }

    # a bit reinterpret is not a conversion: every pattern must survive the round
    # trip through f32 unchanged, NaN payloads included
    var rt: [8]u32;
    rt[0] = 0x00000000;
    rt[1] = 0x80000000;
    rt[2] = 0x00000001;
    rt[3] = 0x7F800000;
    rt[4] = 0xFF800000;
    rt[5] = 0x7FC00000;
    rt[6] = 0xFFC0DEAD;
    rt[7] = 0x7F800001;
    var k: u32 = 0;
    for (k < 8) {
        val f: f32 = (rt[k] + s):~f32;
        h = fold.mix_u32(h, f:~u32);
        k = k + 1;
    }

    # widening an integer into f32 is a rounding question: above 2^24 the source
    # no longer fits the significand, so each of these pins round-to-nearest-even
    # on a conversion rather than on an arithmetic op
    val ua: u32 = 16777216 + s;
    val ub: u32 = 16777217 + s;
    val uc: u32 = 16777219 + s;
    val ud: u32 = 4294967295 + s;
    val ia: i32 = (0xFEFFFFFF + s):~i32;
    val ib: i32 = (0x80000000 + s):~i32;
    h = fold32(h, ua::f32);
    h = fold32(h, ub::f32);
    h = fold32(h, uc::f32);
    h = fold32(h, ud::f32);
    h = fold32(h, s::f32);
    h = fold32(h, ia::f32);
    h = fold32(h, ib::f32);

    # narrowing a float into an integer truncates toward zero. these operands sit
    # at magnitudes below 2^31, which is the range both the signed and the
    # unsigned destination hold.
    val ca: f32 = 1.5f32 * one;
    val cb: f32 = 16777216.0f32 * one;
    val cc: f32 = 2147483520.0f32 * one;
    val cd: f32 = 0.0f32 - 1.5f32 * one;
    val ce: f32 = 0.5f32 * one;
    h = fold.mix_u32(h, ca::u32);
    h = fold.mix_u32(h, cb::u32);
    h = fold.mix_u32(h, cc::u32);
    h = fold.mix_u32(h, ce::u32);
    h = fold.mix_u32(h, pz::u32);
    h = fold.mix_i32(h, cd::i32);
    h = fold.mix_i32(h, cc::i32);
    h = fold.mix_i32(h, (0.0f32 - ce)::i32);
    h = fold.mix_i64(h, cd::i64);
    h = fold.mix_i64(h, (0.0f32 - cb)::i64);
    ret h;
}
