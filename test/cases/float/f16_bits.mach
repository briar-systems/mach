# the exact bits of every f16 operation, NaNs included, where f16_ops checks a
# NaN only as a NaN. which NaN comes out is the target's, so there is no C
# reference: a column with native half rows is held to its base column, which
# runs the expansion on the same target, bit for bit (EXACT.<target>, #3801).
# the table holds quiet and signaling NaNs of both signs and several payloads
# beside the values f16_ops draws on.

use corpus.lib.fold;

fun opaque_f16_bits(bits: u16, s: u16) f16 {
    ret (bits + s):~f16;
}

fun table_f16_bits(i: u32) u16 {
    var t: [18]u16;
    t[0]  = 0x0000;
    t[1]  = 0x8000;
    t[2]  = 0x0001;
    t[3]  = 0x03FF;
    t[4]  = 0x7BFF;
    t[5]  = 0x7C00;
    t[6]  = 0xFC00;
    t[7]  = 0x7E00; # quiet NaN
    t[8]  = 0xFE00; # negative quiet NaN
    t[9]  = 0x7F55; # quiet NaN with a payload
    t[10] = 0x7C01; # signaling NaN
    t[11] = 0xFD55; # negative signaling NaN with a payload
    t[12] = 0x7D00; # signaling NaN, payload in the top bits
    t[13] = 0x3C00;
    t[14] = 0x3555;
    t[15] = 0xC900;
    t[16] = 0x6800;
    t[17] = 0x2E66;
    ret t[i];
}

val N_F16_BITS: u32 = 18;

#[noinline]
fun arith_f16_bits(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: u16 = seed::u16;
    var i: u32 = 0;
    for (i < N_F16_BITS) {
        val a: f16 = opaque_f16_bits(table_f16_bits(i), s);
        h = fold.mix_u16(h, (-a):~u16);
        var j: u32 = 0;
        for (j < N_F16_BITS) {
            val b: f16 = opaque_f16_bits(table_f16_bits(j), s);
            h = fold.mix_u16(h, (a + b):~u16);
            h = fold.mix_u16(h, (a - b):~u16);
            h = fold.mix_u16(h, (a * b):~u16);
            h = fold.mix_u16(h, (a / b):~u16);
            j = j + 1;
        }
        i = i + 1;
    }
    ret h;
}

#[noinline]
fun convert_f16_bits(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: u16 = seed::u16;
    var i: u32 = 0;
    for (i < N_F16_BITS) {
        val a: f16 = opaque_f16_bits(table_f16_bits(i), s);
        h = fold.mix_f32(h, a::f32);
        h = fold.mix_f64(h, a::f64);
        i = i + 1;
    }
    var d: [6]u64;
    d[0] = 0x7FF4000000000001;
    d[1] = 0xFFF8040000000000;
    d[2] = 0x7FF0000000000001;
    d[3] = 0x7FFFFFFFFFFFFFFF;
    d[4] = 0x3FF0020000000000;
    d[5] = 0x40EFFE0000000000;
    var f: [4]u32;
    f[0] = 0x7FA00001;
    f[1] = 0xFFC00001;
    f[2] = 0x7FFFFFFF;
    f[3] = 0x3DCCCCCD;
    var k: u32 = 0;
    for (k < 6) {
        h = fold.mix_u16(h, ((d[k] + seed):~f64)::f16:~u16);
        k = k + 1;
    }
    k = 0;
    for (k < 4) {
        h = fold.mix_u16(h, ((f[k] + seed::u32):~f32)::f16:~u16);
        k = k + 1;
    }
    ret h;
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    h = fold.mix_u64(h, arith_f16_bits(seed));
    h = fold.mix_u64(h, convert_f16_bits(seed));
    ret h;
}
