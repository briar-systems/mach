# the f64 values that a lowering is most likely to lose: both zeros, both
# infinities, NaN, and the denormal range, plus the two float width conversions
# whose edges are overflow to infinity and gradual underflow. every non-NaN result
# folds its exact bit pattern, so -0.0 is distinguished from +0.0 and a denormal
# from zero, which folding by value could never do.

use corpus.lib.fold;

fun opaque_f64(bits: u64, s: u64) f64 { ret (bits + s):~f64; }

# a NaN result's payload and sign are not fixed across targets: x86 hands back a
# quieted source operand and riscv hands back its own canonical NaN. so an
# operation that produces a NaN is verified to produce a NaN and nothing more,
# while every other result is verified bit for bit.
fun fold64(h: u64, v: f64) u64 {
    if (v != v) { ret fold.mix_u64(h, 0xFFFFFFFFFFFFFFFF); }
    ret fold.mix_f64(h, v);
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();

    val one:  f64 = opaque_f64(0x3FF0000000000000, seed);
    val mone: f64 = opaque_f64(0xBFF0000000000000, seed);
    val pz:   f64 = opaque_f64(0x0000000000000000, seed);
    val nz:   f64 = opaque_f64(0x8000000000000000, seed);
    val pinf: f64 = opaque_f64(0x7FF0000000000000, seed);
    val ninf: f64 = opaque_f64(0xFFF0000000000000, seed);
    val nan:  f64 = opaque_f64(0x7FF8000000000000, seed);
    val dmax: f64 = opaque_f64(0x7FEFFFFFFFFFFFFF, seed);
    val dmin: f64 = opaque_f64(0x0010000000000000, seed);
    val denm: f64 = opaque_f64(0x000FFFFFFFFFFFFF, seed);
    val tiny: f64 = opaque_f64(0x0000000000000001, seed);

    # signed zero. the sum of two zeros is negative only when both are, the
    # difference follows the second operand's sign, and the product follows the
    # sign rule, so every one of these separates -0.0 from +0.0 by bits alone.
    h = fold64(h, pz);
    h = fold64(h, nz);
    h = fold64(h, pz + pz);
    h = fold64(h, pz + nz);
    h = fold64(h, nz + pz);
    h = fold64(h, nz + nz);
    h = fold64(h, pz - pz);
    h = fold64(h, pz - nz);
    h = fold64(h, nz - pz);
    h = fold64(h, nz - nz);
    h = fold64(h, pz * one);
    h = fold64(h, pz * mone);
    h = fold64(h, nz * one);
    h = fold64(h, nz * mone);
    h = fold64(h, nz * nz);
    h = fold64(h, pz * nz);
    h = fold64(h, -pz);
    h = fold64(h, -nz);
    h = fold64(h, pz / one);
    h = fold64(h, pz / mone);
    h = fold64(h, nz / one);
    h = fold64(h, nz / mone);
    h = fold.mix_u8(h, pz == nz);
    h = fold.mix_u8(h, pz < nz);
    h = fold.mix_u8(h, nz < pz);

    # infinity, including the two exact signed zeros a finite divided by an
    # infinity must land on
    h = fold64(h, pinf);
    h = fold64(h, ninf);
    h = fold64(h, -pinf);
    h = fold64(h, one / pz);
    h = fold64(h, one / nz);
    h = fold64(h, mone / pz);
    h = fold64(h, mone / nz);
    h = fold64(h, pinf + one);
    h = fold64(h, pinf + pinf);
    h = fold64(h, pinf - ninf);
    h = fold64(h, pinf * pinf);
    h = fold64(h, pinf * ninf);
    h = fold64(h, pinf * mone);
    h = fold64(h, one / pinf);
    h = fold64(h, mone / pinf);
    h = fold64(h, one / ninf);
    h = fold64(h, pinf / one);
    h = fold64(h, dmax + dmax);
    h = fold.mix_u8(h, pinf > dmax);
    h = fold.mix_u8(h, ninf < 0.0f64 - dmax);

    # the invalid operations. each is verified to be a NaN and not to be anything
    # else: the payload a target hands back is its own choice, so folding it would
    # be reporting more than the corpus can anchor.
    h = fold64(h, pinf - pinf);
    h = fold64(h, ninf + pinf);
    h = fold64(h, pinf * pz);
    h = fold64(h, ninf * nz);
    h = fold64(h, pinf / pinf);
    h = fold64(h, pz / pz);
    h = fold64(h, nz / pz);

    # NaN as an operand. identity is exact, arithmetic is classified, and the
    # negation is exact because it is defined as the sign-bit flip on every
    # operand rather than as an arithmetic operation.
    h = fold.mix_u64(h, nan:~u64);
    h = fold.mix_u8(h, nan != nan);
    h = fold.mix_u8(h, nan == nan);
    h = fold.mix_u8(h, nan < nan);
    h = fold.mix_u8(h, nan >= nan);
    h = fold.mix_u64(h, (-nan):~u64);
    h = fold.mix_u64(h, (-(-nan)):~u64);
    h = fold64(h, nan + one);
    h = fold64(h, one + nan);
    h = fold64(h, nan * pz);
    h = fold64(h, nan - nan);
    h = fold64(h, nan / nan);
    h = fold64(h, nan / pinf);

    # the denormal range. gradual underflow is a value question, not a speed
    # lever: a lowering that flushes to zero loses every one of these.
    h = fold64(h, tiny);
    h = fold64(h, denm);
    h = fold64(h, dmin);
    h = fold64(h, denm + tiny);
    h = fold64(h, dmin - tiny);
    h = fold64(h, tiny + tiny);
    h = fold64(h, tiny * 1.5f64);
    h = fold64(h, tiny * 0.5f64);
    h = fold64(h, -tiny);
    h = fold64(h, tiny * 4503599627370496.0f64);
    h = fold64(h, denm / dmin);
    h = fold.mix_u8(h, tiny > pz);
    h = fold.mix_u8(h, tiny == pz);
    h = fold.mix_u8(h, (0.0f64 - tiny) < nz);

    # the whole ladder from the smallest normal down through every binade of the
    # denormal range and into zero, in one halving step at a time
    var d: f64 = dmin;
    var i: u64 = 0;
    for (i < 60) {
        d = d * 0.5f64;
        h = fold64(h, d);
        i = i + 1;
    }

    # a bit reinterpret is not a conversion: every pattern must survive the round
    # trip through f64 unchanged, NaN payloads included
    var rt: [8]u64;
    rt[0] = 0x0000000000000000;
    rt[1] = 0x8000000000000000;
    rt[2] = 0x0000000000000001;
    rt[3] = 0x7FF0000000000000;
    rt[4] = 0xFFF0000000000000;
    rt[5] = 0x7FF8000000000000;
    rt[6] = 0xFFF8000000C0DEAD;
    rt[7] = 0x7FF0000000000001;
    var k: u64 = 0;
    for (k < 8) {
        val f: f64 = (rt[k] + seed):~f64;
        h = fold.mix_u64(h, f:~u64);
        k = k + 1;
    }

    # the two float width conversions. narrowing rounds and can overflow to
    # infinity or fall into the f32 denormal range, widening is always exact.
    # neither direction carries a NaN here, because the payload a widening or
    # narrowing hands back is target-defined.
    val n32a: f32 = dmax::f32;
    val n32b: f32 = tiny::f32;
    val n32c: f32 = opaque_f64(0x36A0000000000000, seed)::f32;
    val n32d: f32 = opaque_f64(0x3FF0000010000000, seed)::f32;
    val n32e: f32 = opaque_f64(0x3FF0000030000000, seed)::f32;
    val n32f: f32 = nz::f32;
    val n32g: f32 = ninf::f32;
    h = fold.mix_f32(h, n32a);
    h = fold.mix_f32(h, n32b);
    h = fold.mix_f32(h, n32c);
    h = fold.mix_f32(h, n32d);
    h = fold.mix_f32(h, n32e);
    h = fold.mix_f32(h, n32f);
    h = fold.mix_f32(h, n32g);
    h = fold64(h, n32c::f64);
    h = fold64(h, n32f::f64);
    h = fold64(h, n32g::f64);

    # widening an integer into f64 is a rounding question: above 2^53 the source
    # no longer fits the significand, so each of these pins round-to-nearest-even
    # on a conversion rather than on an arithmetic op
    val ua: u64 = 9007199254740992 + seed;
    val ub: u64 = 9007199254740993 + seed;
    val uc: u64 = 9007199254740995 + seed;
    val ud: u64 = 18446744073709551615 + seed;
    val ia: i64 = (0xFFDFFFFFFFFFFFFF + seed):~i64;
    val ib: i64 = (0x8000000000000000 + seed):~i64;
    h = fold64(h, ua::f64);
    h = fold64(h, ub::f64);
    h = fold64(h, uc::f64);
    h = fold64(h, ud::f64);
    h = fold64(h, seed::f64);
    h = fold64(h, ia::f64);
    h = fold64(h, ib::f64);

    # narrowing a float into an integer truncates toward zero. these operands sit
    # at magnitudes below 2^63, which is the range both the signed and the
    # unsigned destination hold.
    val ca: f64 = 1.5f64 * one;
    val cb: f64 = 9007199254740992.0f64 * one;
    val cc: f64 = 4611686018427387904.0f64 * one;
    val cd: f64 = 0.0f64 - 1.5f64 * one;
    val ce: f64 = 0.5f64 * one;
    h = fold.mix_u64(h, ca::u64);
    h = fold.mix_u64(h, cb::u64);
    h = fold.mix_u64(h, cc::u64);
    h = fold.mix_u64(h, ce::u64);
    h = fold.mix_u64(h, pz::u64);
    h = fold.mix_i64(h, cd::i64);
    h = fold.mix_i64(h, cc::i64);
    h = fold.mix_i64(h, (0.0f64 - ce)::i64);
    h = fold.mix_i32(h, cd::i32);
    h = fold.mix_u32(h, ca::u32);
    ret h;
}
