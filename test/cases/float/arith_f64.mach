# f64 add, sub, mul, div, negate and the truncated remainder. the f32 twin of this
# case pins the same surface one width down, so a lowering that reaches for the
# wrong operation width shows up here as a quotient rounded at bit 24.

use corpus.lib.fold;

# a f64 built from its exact bit pattern, offset by the opaque seed so the value is
# unknowable at compile time and exact at run time
fun opaque_f64(bits: u64, s: u64) f64 { ret (bits + s):~f64; }

# a NaN result's payload and sign are not fixed across targets: x86 hands back a
# quieted source operand and riscv hands back its own canonical NaN. so a NaN folds
# one sentinel, and every other result folds its exact bits.
fun fold64(h: u64, v: f64) u64 {
    if (v != v) { ret fold.mix_u64(h, 0xFFFFFFFFFFFFFFFF); }
    ret fold.mix_f64(h, v);
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();

    # multiplying by an opaque 1.0 is the exact identity on every f64, including
    # -0.0 and every denormal, so it carries the seed without perturbing a value
    val one: f64 = opaque_f64(0x3FF0000000000000, seed);

    val a: f64 = 1.5f64 * one;
    val b: f64 = 0.25f64 * one;
    h = fold64(h, a + b);
    h = fold64(h, a - b);
    h = fold64(h, b - a);
    h = fold64(h, a * b);
    h = fold64(h, a / b);
    h = fold64(h, b / a);
    h = fold64(h, -a);
    h = fold64(h, 0.0f64 - a);
    h = fold64(h, a - a);
    h = fold64(h, (0.0f64 - a) + a);

    # inexact quotients at f64 precision: a result computed at f32 width and widened
    # back is zero below bit 24, so these separate the two widths outright
    val three: f64 = 3.0f64 * one;
    val third: f64 = one / three;
    h = fold64(h, third);
    h = fold64(h, third * three);
    h = fold64(h, one - third - third - third);
    h = fold64(h, one / 49.0f64);
    h = fold64(h, one / 1048576.5f64);
    h = fold64(h, 1048576.5f64 / three);

    # ties at the 2^53 boundary: 2^53 + 1 rounds down to even, 2^53 + 2 is exact,
    # and the two groupings of the same three addends differ
    val p53: f64 = 9007199254740992.0f64 * one;
    h = fold64(h, p53 + one);
    h = fold64(h, p53 + one + one);
    h = fold64(h, p53 + (one + one));
    h = fold64(h, p53 - one);
    h = fold64(h, (p53 + one) - p53);

    # a serial dependence chain: every step rounds, so a regrouped accumulation
    # lands on a different bit pattern
    var acc: f64 = 0.0f64 * one;
    var i: u64 = 0;
    for (i < 24) {
        acc = acc + third;
        acc = acc * 1.5f64;
        h = fold64(h, acc);
        i = i + 1;
    }

    # the overflow edge: DBL_MAX is exact, and one step past it is +/- infinity
    val dmax: f64 = opaque_f64(0x7FEFFFFFFFFFFFFF, seed);
    h = fold64(h, dmax);
    h = fold64(h, dmax / 2.0f64);
    h = fold64(h, dmax + dmax);
    h = fold64(h, dmax * 2.0f64);
    h = fold64(h, 0.0f64 - dmax * 2.0f64);
    h = fold64(h, dmax * dmax);
    h = fold64(h, dmax - dmax);

    # gradual underflow: the smallest normal halves into a denormal rather than
    # into zero, and the smallest denormal halves to zero by round-to-nearest-even
    val dmin: f64 = opaque_f64(0x0010000000000000, seed);
    val tiny: f64 = opaque_f64(0x0000000000000001, seed);
    h = fold64(h, dmin * 0.5f64);
    h = fold64(h, dmin / 2.0f64);
    h = fold64(h, dmin - tiny);
    h = fold64(h, dmin * one);
    h = fold64(h, tiny + tiny);
    h = fold64(h, tiny * 0.5f64);
    h = fold64(h, tiny * 0.75f64);
    h = fold64(h, tiny * 9007199254740992.0f64);
    h = fold64(h, tiny / dmin);

    # the truncated remainder. every operand pair here has an exact quotient
    # truncation and an exact product, so the result is the IEEE remainder under
    # both readings of the operator and the oracle does not bake in a lowering.
    val r: f64 = 5.5f64 * one;
    val q: f64 = 3.0f64 * one;
    h = fold64(h, r % q);
    h = fold64(h, (0.0f64 - r) % q);
    h = fold64(h, r % (0.0f64 - q));
    h = fold64(h, (0.0f64 - r) % (0.0f64 - q));
    h = fold64(h, (7.0f64 * one) % 0.5f64);
    h = fold64(h, one % q);
    h = fold64(h, q % q);
    h = fold64(h, (1048576.0f64 * one) % q);
    ret h;
}
