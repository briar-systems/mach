# every f64 comparison predicate over every ordered pair drawn from a table that
# holds both infinities, both zeros, both smallest denormals, a quiet NaN and a
# signaling NaN, then the mixed-width form. mach widens the narrower operand
# exactly before comparing, so a f32 denormal compared against a f64 must relate
# its true value and not a value flushed or re-rounded on the way up.

use corpus.lib.fold;

# a NaN's payload is not fixed across targets, so a NaN folds one sentinel and
# every other value folds its exact bits. only the min / max scan reaches this.
fun fold64(h: u64, v: f64) u64 {
    if (v != v) { ret fold.mix_u64(h, 0xFFFFFFFFFFFFFFFF); }
    ret fold.mix_f64(h, v);
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: u32 = seed::u32;

    var v: [12]f64;
    v[0]  = (0xFFF0000000000000 + seed):~f64;    # -inf
    v[1]  = (0xBFF0000000000000 + seed):~f64;    # -1.0
    v[2]  = (0x8010000000000000 + seed):~f64;    # -DBL_MIN
    v[3]  = (0x8000000000000001 + seed):~f64;    # -smallest denormal
    v[4]  = (0x8000000000000000 + seed):~f64;    # -0.0
    v[5]  = (0x0000000000000000 + seed):~f64;    # +0.0
    v[6]  = (0x0000000000000001 + seed):~f64;    # +smallest denormal
    v[7]  = (0x3FF0000000000000 + seed):~f64;    # 1.0
    v[8]  = (0x7FEFFFFFFFFFFFFF + seed):~f64;    # DBL_MAX
    v[9]  = (0x7FF0000000000000 + seed):~f64;    # +inf
    v[10] = (0x7FF8000000000000 + seed):~f64;    # quiet NaN
    v[11] = (0x7FF0000000000001 + seed):~f64;    # signaling NaN

    var i: u64 = 0;
    for (i < 12) {
        var j: u64 = 0;
        for (j < 12) {
            val x: f64 = v[i];
            val y: f64 = v[j];

            h = fold.mix_u8(h, x == y);
            h = fold.mix_u8(h, x != y);
            h = fold.mix_u8(h, x < y);
            h = fold.mix_u8(h, x <= y);
            h = fold.mix_u8(h, x > y);
            h = fold.mix_u8(h, x >= y);

            # the same six relations as branch conditions rather than as
            # materialized bytes, which is a different lowering path
            var c: u8 = 0;
            if (x < y)  { c = c + 1; }
            if (x <= y) { c = c + 2; }
            if (x > y)  { c = c + 4; }
            if (x >= y) { c = c + 8; }
            if (x == y) { c = c + 16; }
            if (x != y) { c = c + 32; }
            h = fold.mix_u8(h, c);

            h = fold.mix_u8(h, (x < y) && (y < x));
            h = fold.mix_u8(h, (x < y) || (y < x));
            h = fold.mix_u8(h, !(x < y));
            h = fold.mix_u8(h, (x == x) && (y == y));
            h = fold.mix_u8(h, (x != x) || (y != y));
            j = j + 1;
        }
        i = i + 1;
    }

    # the mixed-width form: the f32 side widens exactly, so every relation still
    # relates the two mathematical values
    var w: [8]f32;
    w[0] = (0xFF800000 + s):~f32;       # -inf
    w[1] = (0xBF800000 + s):~f32;       # -1.0
    w[2] = (0x80000000 + s):~f32;       # -0.0
    w[3] = (0x00000000 + s):~f32;       # +0.0
    w[4] = (0x00000001 + s):~f32;       # +smallest f32 denormal, a normal f64 widened
    w[5] = (0x3F800000 + s):~f32;       # 1.0
    w[6] = (0x7F800000 + s):~f32;       # +inf
    w[7] = (0x7FC00000 + s):~f32;       # quiet NaN

    var a: u64 = 0;
    for (a < 12) {
        var b: u64 = 0;
        for (b < 8) {
            val x: f64 = v[a];
            val y: f32 = w[b];
            h = fold.mix_u8(h, x == y);
            h = fold.mix_u8(h, x != y);
            h = fold.mix_u8(h, x < y);
            h = fold.mix_u8(h, x <= y);
            h = fold.mix_u8(h, y < x);
            h = fold.mix_u8(h, y <= x);
            b = b + 1;
        }
        a = a + 1;
    }

    # a min / max scan: every comparison against a NaN is false, so the result
    # depends on the scan order and is identical only if each relation is
    # NaN-false in the same way
    var lo: f64 = v[0];
    var hi: f64 = v[0];
    var m: u64 = 1;
    for (m < 12) {
        if (v[m] < lo) { lo = v[m]; }
        if (v[m] > hi) { hi = v[m]; }
        m = m + 1;
    }
    h = fold64(h, lo);
    h = fold64(h, hi);

    # a total count of true relations over the whole table, so a single wrong cell
    # moves a value that no per-pair fold could cancel
    var trues: u32 = 0;
    var p: u64 = 0;
    for (p < 12) {
        var q: u64 = 0;
        for (q < 12) {
            trues = trues + (v[p] <  v[q])::u32;
            trues = trues + (v[p] <= v[q])::u32;
            trues = trues + (v[p] == v[q])::u32;
            trues = trues + (v[p] != v[q])::u32;
            q = q + 1;
        }
        p = p + 1;
    }
    h = fold.mix_u32(h, trues);
    ret h;
}
