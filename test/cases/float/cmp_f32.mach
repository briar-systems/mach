# every f32 comparison predicate over every ordered pair drawn from a table that
# holds both infinities, both zeros, both smallest denormals, a quiet NaN, a
# negative NaN and a signaling NaN. an unordered pair must read false for every
# relation except `!=`, in both operand orders, so a lowering that reads the raw
# unsigned flags without folding parity in shows up on the NaN rows.

use corpus.lib.fold;

# a NaN's payload is not fixed across targets, so a NaN folds one sentinel and
# every other value folds its exact bits. only the min / max scan reaches this: the
# predicates themselves fold u8 results, which are exact everywhere.
fun fold32(h: u64, v: f32) u64 {
    if (v != v) { ret fold.mix_u32(h, 0xFFFFFFFF); }
    ret fold.mix_f32(h, v);
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: u32 = seed::u32;

    var v: [12]f32;
    v[0]  = (0xFF800000 + s):~f32;      # -inf
    v[1]  = (0xBF800000 + s):~f32;      # -1.0
    v[2]  = (0x80800000 + s):~f32;      # -FLT_MIN
    v[3]  = (0x80000001 + s):~f32;      # -smallest denormal
    v[4]  = (0x80000000 + s):~f32;      # -0.0
    v[5]  = (0x00000000 + s):~f32;      # +0.0
    v[6]  = (0x00000001 + s):~f32;      # +smallest denormal
    v[7]  = (0x3F800000 + s):~f32;      # 1.0
    v[8]  = (0x7F7FFFFF + s):~f32;      # FLT_MAX
    v[9]  = (0x7F800000 + s):~f32;      # +inf
    v[10] = (0x7FC00000 + s):~f32;      # quiet NaN
    v[11] = (0x7F800001 + s):~f32;      # signaling NaN

    var i: u32 = 0;
    for (i < 12) {
        var j: u32 = 0;
        for (j < 12) {
            val x: f32 = v[i];
            val y: f32 = v[j];

            h = fold.mix_u8(h, x == y);
            h = fold.mix_u8(h, x != y);
            h = fold.mix_u8(h, x < y);
            h = fold.mix_u8(h, x <= y);
            h = fold.mix_u8(h, x > y);
            h = fold.mix_u8(h, x >= y);

            # the same six relations as branch conditions rather than as
            # materialized bytes, which is a different lowering path
            var c: u8 = 0;
            if (x < y)  { c = c + 1; }
            if (x <= y) { c = c + 2; }
            if (x > y)  { c = c + 4; }
            if (x >= y) { c = c + 8; }
            if (x == y) { c = c + 16; }
            if (x != y) { c = c + 32; }
            h = fold.mix_u8(h, c);

            h = fold.mix_u8(h, (x < y) && (y < x));
            h = fold.mix_u8(h, (x < y) || (y < x));
            h = fold.mix_u8(h, !(x < y));
            h = fold.mix_u8(h, (x == x) && (y == y));
            h = fold.mix_u8(h, (x != x) || (y != y));
            j = j + 1;
        }
        i = i + 1;
    }

    # a min / max scan: every comparison against a NaN is false, so the result
    # depends on the scan order and is identical only if each relation is
    # NaN-false in the same way
    var lo: f32 = v[0];
    var hi: f32 = v[0];
    var m: u32 = 1;
    for (m < 12) {
        if (v[m] < lo) { lo = v[m]; }
        if (v[m] > hi) { hi = v[m]; }
        m = m + 1;
    }
    h = fold32(h, lo);
    h = fold32(h, hi);

    # a total count of true relations over the whole table, so a single wrong cell
    # moves a value that no per-pair fold could cancel
    var trues: u32 = 0;
    var p: u32 = 0;
    for (p < 12) {
        var q: u32 = 0;
        for (q < 12) {
            trues = trues + (v[p] <  v[q])::u32;
            trues = trues + (v[p] <= v[q])::u32;
            trues = trues + (v[p] == v[q])::u32;
            trues = trues + (v[p] != v[q])::u32;
            q = q + 1;
        }
        p = p + 1;
    }
    h = fold.mix_u32(h, trues);
    ret h;
}
