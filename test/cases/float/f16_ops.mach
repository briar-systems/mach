# every f16 operator, comparison and conversion over the binary16 values a
# lowering is most likely to lose: both zeros, the smallest and largest
# subnormals, the smallest normal, the largest finite, both infinities, a NaN,
# rounding ties and conversions that overflow to infinity. each result folds
# its exact encoding, so it is checked bit for bit against the correctly
# rounded one. one noinline part per family (#3799).

use corpus.lib.fold;

fun opaque_f16_ops(bits: u16, s: u16) f16 {
    ret (bits + s):~f16;
}

# a NaN from arithmetic takes its sign and payload from the target's own
# binary64 unit, so an operation that yields one is checked to yield a NaN
fun fold_f16_ops(h: u64, v: f16) u64 {
    if (v != v) { ret fold.mix_u16(h, 0xFFFF); }
    ret fold.mix_u16(h, v:~u16);
}

fun fold32_f16_ops(h: u64, v: f32) u64 {
    if (v != v) { ret fold.mix_u32(h, 0xFFFFFFFF); }
    ret fold.mix_f32(h, v);
}

# the table every part draws from, as encodings
fun table_f16_ops(i: u32) u16 {
    var t: [22]u16;
    t[0]  = 0x0000; # +0
    t[1]  = 0x8000; # -0
    t[2]  = 0x0001; # smallest subnormal
    t[3]  = 0x8001;
    t[4]  = 0x03FF; # largest subnormal
    t[5]  = 0x83FF;
    t[6]  = 0x0400; # smallest normal
    t[7]  = 0x7BFF; # largest finite, 65504
    t[8]  = 0xFBFF;
    t[9]  = 0x7C00; # +inf
    t[10] = 0xFC00; # -inf
    t[11] = 0x7E00; # quiet NaN
    t[12] = 0x3C00; # 1
    t[13] = 0xBC00; # -1
    t[14] = 0x3C01; # 1 + ulp
    t[15] = 0x3E00; # 1.5
    t[16] = 0x4200; # 3
    t[17] = 0x2E66; # 0.1
    t[18] = 0x6800; # 2048, where the ulp is 2
    t[19] = 0x3555; # 1/3
    t[20] = 0x0200; # a subnormal halfway up
    t[21] = 0xC900; # -10
    ret t[i];
}

val N_F16_OPS: u32 = 22;

#[noinline]
fun arith_f16_ops(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: u16 = seed::u16;
    var i: u32 = 0;
    for (i < N_F16_OPS) {
        val a: f16 = opaque_f16_ops(table_f16_ops(i), s);
        h = fold_f16_ops(h, -a);
        var j: u32 = 0;
        for (j < N_F16_OPS) {
            val b: f16 = opaque_f16_ops(table_f16_ops(j), s);
            h = fold_f16_ops(h, a + b);
            h = fold_f16_ops(h, a - b);
            h = fold_f16_ops(h, a * b);
            h = fold_f16_ops(h, a / b);
            # an infinite dividend or a zero divisor leaves `%` to the target's
            # own conversion of the quotient, so only the rest are folded
            if ((table_f16_ops(i) & 0x7FFF) != 0x7C00 && (table_f16_ops(j) & 0x7FFF) != 0) {
                h = fold_f16_ops(h, a % b);
            }
            j = j + 1;
        }
        i = i + 1;
    }

    # ties: 2048 + 1 and 2048 + 3 sit halfway between representable values,
    # and 65504 + 16 is the tie at the top that rounds to infinity
    val big: f16 = opaque_f16_ops(0x6800, s);
    val one: f16 = opaque_f16_ops(0x3C00, s);
    h = fold_f16_ops(h, big + one);
    h = fold_f16_ops(h, big + one + one + one);
    h = fold_f16_ops(h, big + (one + one + one));
    h = fold_f16_ops(h, opaque_f16_ops(0x7BFF, s) + opaque_f16_ops(0x4C00, s));
    h = fold_f16_ops(h, opaque_f16_ops(0x7BFF, s) + opaque_f16_ops(0x4BFF, s));
    # a subnormal product rounding to even, and one to the smallest normal
    h = fold_f16_ops(h, opaque_f16_ops(0x0001, s) * opaque_f16_ops(0x3800, s));
    h = fold_f16_ops(h, opaque_f16_ops(0x0003, s) * opaque_f16_ops(0x3800, s));
    h = fold_f16_ops(h, opaque_f16_ops(0x03FF, s) + opaque_f16_ops(0x0001, s));
    ret h;
}

#[noinline]
fun cmp_f16_ops(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: u16 = seed::u16;
    var i: u32 = 0;
    for (i < N_F16_OPS) {
        val a: f16 = opaque_f16_ops(table_f16_ops(i), s);
        var j: u32 = 0;
        for (j < N_F16_OPS) {
            val b: f16 = opaque_f16_ops(table_f16_ops(j), s);
            var c: u8  = 0;
            if (a < b)  { c = c + 1; }
            if (a <= b) { c = c + 2; }
            if (a > b)  { c = c + 4; }
            if (a >= b) { c = c + 8; }
            if (a == b) { c = c + 16; }
            if (a != b) { c = c + 32; }
            h = fold.mix_u8(h, c);
            j = j + 1;
        }
        i = i + 1;
    }
    ret h;
}

#[noinline]
fun widen_f16_ops(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: u16 = seed::u16;
    var i: u32 = 0;
    for (i < N_F16_OPS) {
        val a: f16 = opaque_f16_ops(table_f16_ops(i), s);
        h = fold32_f16_ops(h, a::f32);
        h = fold.mix_f64(h, a::f64);
        # a finite value converts to every integer that holds it
        if ((table_f16_ops(i) & 0x7C00) != 0x7C00) {
            h = fold.mix_i32(h, a::i32);
            h = fold.mix_i64(h, a::i64);
            h = fold.mix_i16(h, (a / opaque_f16_ops(0x5C00, s))::i16);
            if ((table_f16_ops(i) & 0x8000) == 0) {
                h = fold.mix_u16(h, a::u16);
                h = fold.mix_u64(h, a::u64);
            }
        }
        i = i + 1;
    }
    # a quiet NaN's payload survives widening
    h = fold.mix_f64(h, opaque_f16_ops(0x7F55, s)::f64);
    ret h;
}

#[noinline]
fun narrow_f16_ops(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: u64 = seed;
    var d: [24]u64;
    d[0]  = 0x40A0020000000000; # 2049: a tie, to 2048
    d[1]  = 0x40A0060000000000; # 2051: a tie, to 2052
    d[2]  = 0x40EFFDFFFFFFFFFF; # just below 65520: to 65504
    d[3]  = 0x40EFFE0000000000; # 65520: the tie that overflows to infinity
    d[4]  = 0xC0EFFE0000000000;
    d[5]  = 0x4202A05F20000000; # 1e10
    d[6]  = 0x3E60000000000000; # 2^-25: a tie, to zero
    d[7]  = 0x3E60000000000001; # just above: to the smallest subnormal
    d[8]  = 0x3E78000000000000; # 1.5 * 2^-24: a tie, to 2 * 2^-24
    d[9]  = 0x3E84000000000000; # 2.5 * 2^-24: a tie, to 2 * 2^-24
    d[10] = 0x3F0FFC0000000000; # the largest subnormal plus half an ulp: a tie, to the smallest normal
    d[11] = 0x3E50000000000000; # 2^-26: to zero
    d[12] = 0x0000000000000001; # a binary64 subnormal
    d[13] = 0x8000000000000000; # -0
    d[14] = 0x7FF0000000000000;
    d[15] = 0xFFF0000000000000;
    d[16] = 0x7FF4000000000001; # a signaling NaN: quieted, the top of its payload kept
    d[17] = 0xFFF8040000000000; # a negative quiet NaN with a payload
    d[18] = 0x3FB999999999999A; # 0.1
    d[19] = 0x3FF0020000000000; # 1 + half an ulp: a tie, to 1
    d[20] = 0x3FF0060000000000; # 1 + 3 half ulps: a tie, to 1 + 2 ulps
    d[21] = 0x3FF0020000000001; # just past the tie: up
    d[22] = 0x40EFFC0000000000; # 65504 exactly
    d[23] = 0x3F10000000000000; # 2^-14, the smallest normal

    var i: u32 = 0;
    for (i < 24) {
        val x: f64 = (d[i] + s):~f64;
        h = fold.mix_u16(h, x::f16:~u16);
        i = i + 1;
    }

    val s32: u32 = seed::u32;
    h = fold.mix_u16(h, (0x3DCCCCCD + s32):~f32::f16:~u16); # 0.1
    h = fold.mix_u16(h, (0x477FF000 + s32):~f32::f16:~u16); # 65520: infinity
    h = fold.mix_u16(h, (0x33800000 + s32):~f32::f16:~u16); # 2^-24
    h = fold.mix_u16(h, (0x33000000 + s32):~f32::f16:~u16); # 2^-25: a tie, to zero
    h = fold.mix_u16(h, (0x45001000 + s32):~f32::f16:~u16); # 2049: a tie, to 2048
    h = fold.mix_u16(h, (0x7FC00001 + s32):~f32::f16:~u16); # a NaN whose payload lies below binary16's

    # integers round to nearest even and overflow to infinity
    val si: i32 = seed::i32;
    h = fold.mix_u16(h, (2049 + si)::f16:~u16);
    h = fold.mix_u16(h, (2051 + si)::f16:~u16);
    h = fold.mix_u16(h, (65519 + si)::f16:~u16);
    h = fold.mix_u16(h, (65520 + si)::f16:~u16);
    h = fold.mix_u16(h, (0 - 65520 + si)::f16:~u16);
    h = fold.mix_u16(h, (0 - 2051 + si)::f16:~u16);
    h = fold.mix_u16(h, (0 + si)::f16:~u16);
    h = fold.mix_u16(h, (0xFFFFFFFF + seed::u32)::f16:~u16);
    h = fold.mix_u16(h, (0x7FFFFFFFFFFFFFFF + seed:~i64)::f16:~u16);
    h = fold.mix_u16(h, (0 - 0x7FFFFFFFFFFFFFFF + seed:~i64)::f16:~u16);
    h = fold.mix_u16(h, (0xFFFFFFFFFFFFFFFF + seed)::f16:~u16);
    h = fold.mix_u16(h, (255 + seed::u8)::f16:~u16);
    h = fold.mix_u16(h, (0 - 32767 + seed::i16)::f16:~u16);
    ret h;
}

# the same operations folded at compile time, which must give the encodings
# the runtime lowering gives
val FOLD_ADD_TIE: f16 = 2048.0f16 + 1.0f16;
val FOLD_ADD_UP:  f16 = 2048.0f16 + 3.0f16;
val FOLD_ADD_INF: f16 = 65504.0f16 + 16.0f16;
val FOLD_MUL:     f16 = 0.1f16 * 0.1f16;
val FOLD_MUL_SUB: f16 = 0.000000059604644775390625f16 * 1.5f16;
val FOLD_DIV:     f16 = 1.0f16 / 3.0f16;
val FOLD_REM:     f16 = 5.5f16 % 3.0f16;
val FOLD_NEG:     f16 = -(1.5f16);
val FOLD_NARROW:  f16 = 65519.0::f16;
val FOLD_INT:     f16 = 2049::u32::f16;
val FOLD_WIDE:    f64 = 0.000000059604644775390625f16::f64;

#[noinline]
fun folded_f16_ops(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: u16 = seed::u16;
    h = fold.mix_u16(h, (FOLD_ADD_TIE:~u16) + s);
    h = fold.mix_u16(h, (FOLD_ADD_UP:~u16) + s);
    h = fold.mix_u16(h, (FOLD_ADD_INF:~u16) + s);
    h = fold.mix_u16(h, (FOLD_MUL:~u16) + s);
    h = fold.mix_u16(h, (FOLD_MUL_SUB:~u16) + s);
    h = fold.mix_u16(h, (FOLD_DIV:~u16) + s);
    h = fold.mix_u16(h, (FOLD_REM:~u16) + s);
    h = fold.mix_u16(h, (FOLD_NEG:~u16) + s);
    h = fold.mix_u16(h, (FOLD_NARROW:~u16) + s);
    h = fold.mix_u16(h, (FOLD_INT:~u16) + s);
    h = fold.mix_f64(h, FOLD_WIDE);
    ret h;
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    h = fold.mix_u64(h, arith_f16_ops(seed));
    h = fold.mix_u64(h, cmp_f16_ops(seed));
    h = fold.mix_u64(h, widen_f16_ops(seed));
    h = fold.mix_u64(h, narrow_f16_ops(seed));
    h = fold.mix_u64(h, folded_f16_ops(seed));
    ret h;
}
