# i8 add and sub chains that cross the wrap boundary in both directions, plus
# negation expressed as 0 - x, with every chain seeded by an opaque value so the
# whole case cannot collapse to one constant.

use corpus.lib.fold;

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: i8 = seed::i8;

    val IMAX: i8 = 127;
    val IMIN: i8 = -127 - 1;

    var a: i8 = -16 + s;
    var i: i8 = 0;
    for (i < 32) {
        a = a + (i * 7 + 1);
        h = fold.mix_i8(h, a);
        a = a - (i * 3 + 2);
        h = fold.mix_i8(h, a);
        i = i + 1;
    }

    var b: i8 = s;
    var j: i8 = 0;
    for (j < 8) {
        b = b - (j * 53 + 1);
        h = fold.mix_i8(h, b);
        j = j + 1;
    }

    val n: i8 = 0 - a;
    h = fold.mix_i8(h, n);
    h = fold.mix_i8(h, 0 - n);
    h = fold.mix_i8(h, 0 - s);
    h = fold.mix_i8(h, IMAX + a);
    h = fold.mix_i8(h, IMIN - a);
    h = fold.mix_i8(h, -1 + a);
    h = fold.mix_i8(h, a + b);
    h = fold.mix_i8(h, a - b);
    h = fold.mix_i8(h, b - a);
    ret h;
}
