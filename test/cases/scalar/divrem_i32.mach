# i32 division and remainder, folding q, r and the identity d*q + r. divisors
# stay strictly positive and never -1, and dividends stay well clear of
# i32::MIN, so every operand pair is inside mach's defined domain and the
# defined-behaviour C mapping alike.

use corpus.lib.fold;

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: i32 = seed::i32;

    var d: i32 = 2000000000 - s;
    var i: i32 = 0;
    for (i < 16) {
        val v: i32 = i * 131 + 3 + s;
        val q: i32 = d / v;
        val r: i32 = d % v;
        h = fold.mix_i32(h, q);
        h = fold.mix_i32(h, r);
        h = fold.mix_i32(h, v * q + r);
        d = d - v;
        i = i + 1;
    }

    var e: i32 = 0 - (2000000000 + s);
    i = 0;
    for (i < 8) {
        val v: i32 = i * 197 + 5 + s;
        val q: i32 = e / v;
        val r: i32 = e % v;
        h = fold.mix_i32(h, q);
        h = fold.mix_i32(h, r);
        h = fold.mix_i32(h, v * q + r);
        e = e + v;
        i = i + 1;
    }

    val big: i32 = 2147483644 + s;
    val small: i32 = 3 + s;
    val q0: i32 = big / small;
    val r0: i32 = big % small;
    h = fold.mix_i32(h, q0);
    h = fold.mix_i32(h, r0);
    h = fold.mix_i32(h, small * q0 + r0);

    val q1: i32 = small / big;
    val r1: i32 = small % big;
    h = fold.mix_i32(h, q1);
    h = fold.mix_i32(h, r1);
    h = fold.mix_i32(h, big * q1 + r1);
    ret h;
}
