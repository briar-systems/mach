# i16 add and sub chains that cross the wrap boundary in both directions, plus
# negation expressed as 0 - x, with every chain seeded by an opaque value so the
# whole case cannot collapse to one constant.

use corpus.lib.fold;

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: i16 = seed::i16;

    val IMAX: i16 = 32767;
    val IMIN: i16 = -32767 - 1;

    var a: i16 = -16 + s;
    var i: i16 = 0;
    for (i < 32) {
        a = a + (i * 7 + 1);
        h = fold.mix_i16(h, a);
        a = a - (i * 3 + 2);
        h = fold.mix_i16(h, a);
        i = i + 1;
    }

    var b: i16 = s;
    var j: i16 = 0;
    for (j < 8) {
        b = b - (j * 12345 + 1);
        h = fold.mix_i16(h, b);
        j = j + 1;
    }

    val n: i16 = 0 - a;
    h = fold.mix_i16(h, n);
    h = fold.mix_i16(h, 0 - n);
    h = fold.mix_i16(h, 0 - s);
    h = fold.mix_i16(h, IMAX + a);
    h = fold.mix_i16(h, IMIN - a);
    h = fold.mix_i16(h, -1 + a);
    h = fold.mix_i16(h, a + b);
    h = fold.mix_i16(h, a - b);
    h = fold.mix_i16(h, b - a);
    ret h;
}
