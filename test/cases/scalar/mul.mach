# products that exceed the width at 32 and 64 bits, signed and unsigned, seeded so the
# wrap cannot fold. one noinline part per type.

use corpus.lib.fold;

# u32 products that exceed the width, seeded so the wrap cannot be folded away
# at compile time.
#[noinline]
fun mul_u32(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: u32 = seed::u32;

    var a: u32 = 2654435761 + s;
    var i: u32 = 0;
    for (i < 16) {
        a = a * (2 * i + 3);
        h = fold.mix_u32(h, a);
        i = i + 1;
    }

    var b: u32 = 4294967231 + s;
    h = fold.mix_u32(h, b * b);
    h = fold.mix_u32(h, b * 4294967295);
    h = fold.mix_u32(h, a * b);
    h = fold.mix_u32(h, b * a);

    var c: u32 = 65537 + s;
    h = fold.mix_u32(h, c * c);
    h = fold.mix_u32(h, c * 65535);
    ret h;
}

# i32 products that exceed the width, seeded so the wrap cannot be folded away
# at compile time. wraparound on a signed product is bit-identical to the
# unsigned product, so this exercises the signed multiply encoding, not a
# different value domain.
#[noinline]
fun mul_i32(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: i32 = seed::i32;

    var a: i32 = -1640531527 + s;
    var i: i32 = 0;
    for (i < 16) {
        a = a * (2 * i + 3);
        h = fold.mix_i32(h, a);
        i = i + 1;
    }

    var b: i32 = -65 + s;
    h = fold.mix_i32(h, b * b);
    h = fold.mix_i32(h, b * -1);
    h = fold.mix_i32(h, a * b);
    h = fold.mix_i32(h, b * a);

    var c: i32 = 65537 + s;
    h = fold.mix_i32(h, c * c);
    h = fold.mix_i32(h, c * -1);
    ret h;
}

# u64 products that exceed the width, seeded so the wrap cannot be folded away
# at compile time.
#[noinline]
fun mul_u64(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: u64 = seed;

    var a: u64 = 11400714819323198485 + s;
    var i: u64 = 0;
    for (i < 16) {
        a = a * (2 * i + 3);
        h = fold.mix_u64(h, a);
        i = i + 1;
    }

    var b: u64 = 18446744073709551553 + s;
    h = fold.mix_u64(h, b * b);
    h = fold.mix_u64(h, b * 18446744073709551615);
    h = fold.mix_u64(h, a * b);
    h = fold.mix_u64(h, b * a);

    var c: u64 = 4294967311 + s;
    h = fold.mix_u64(h, c * c);
    h = fold.mix_u64(h, c * 4294967295);
    ret h;
}

# i64 products that exceed the width, seeded so the wrap cannot be folded away
# at compile time. wraparound on a signed product is bit-identical to the
# unsigned product, so this exercises the signed multiply encoding, not a
# different value domain.
#[noinline]
fun mul_i64(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: i64 = seed::i64;

    var a: i64 = -7046029254386353131 + s;
    var i: i64 = 0;
    for (i < 16) {
        a = a * (2 * i + 3);
        h = fold.mix_i64(h, a);
        i = i + 1;
    }

    var b: i64 = -63 + s;
    h = fold.mix_i64(h, b * b);
    h = fold.mix_i64(h, b * -1);
    h = fold.mix_i64(h, a * b);
    h = fold.mix_i64(h, b * a);

    var c: i64 = 4294967311 + s;
    h = fold.mix_i64(h, c * c);
    h = fold.mix_i64(h, c * -1);
    ret h;
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    h = fold.mix_u64(h, mul_u32(seed));
    h = fold.mix_u64(h, mul_i32(seed));
    h = fold.mix_u64(h, mul_u64(seed));
    h = fold.mix_u64(h, mul_i64(seed));
    ret h;
}
