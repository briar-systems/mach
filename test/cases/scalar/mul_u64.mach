# u64 products that exceed the width, seeded so the wrap cannot be folded away
# at compile time.

use corpus.lib.fold;

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: u64 = seed;

    var a: u64 = 11400714819323198485 + s;
    var i: u64 = 0;
    for (i < 16) {
        a = a * (2 * i + 3);
        h = fold.mix_u64(h, a);
        i = i + 1;
    }

    var b: u64 = 18446744073709551553 + s;
    h = fold.mix_u64(h, b * b);
    h = fold.mix_u64(h, b * 18446744073709551615);
    h = fold.mix_u64(h, a * b);
    h = fold.mix_u64(h, b * a);

    var c: u64 = 4294967311 + s;
    h = fold.mix_u64(h, c * c);
    h = fold.mix_u64(h, c * 4294967295);
    ret h;
}
