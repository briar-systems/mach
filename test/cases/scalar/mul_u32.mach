# u32 products that exceed the width, seeded so the wrap cannot be folded away
# at compile time.

use corpus.lib.fold;

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: u32 = seed::u32;

    var a: u32 = 2654435761 + s;
    var i: u32 = 0;
    for (i < 16) {
        a = a * (2 * i + 3);
        h = fold.mix_u32(h, a);
        i = i + 1;
    }

    var b: u32 = 4294967231 + s;
    h = fold.mix_u32(h, b * b);
    h = fold.mix_u32(h, b * 4294967295);
    h = fold.mix_u32(h, a * b);
    h = fold.mix_u32(h, b * a);

    var c: u32 = 65537 + s;
    h = fold.mix_u32(h, c * c);
    h = fold.mix_u32(h, c * 65535);
    ret h;
}
