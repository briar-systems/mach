# add and sub chains that cross the wrap boundary in both directions, plus negation,
# at every integer width and signedness, one noinline part per type. the narrow signed
# parts keep the re-extension after narrow arithmetic live.

use corpus.lib.fold;

# u8 add and sub chains that cross the wrap boundary in both directions, plus
# negation expressed as 0 - x, with every chain seeded by an opaque value so the
# whole case cannot collapse to one constant.
#[noinline]
fun arith_u8(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: u8  = seed::u8;

    var a: u8 = 240 + s;
    var i: u8 = 0;
    for (i < 32) {
        a = a + (i * 7 + 1);
        h = fold.mix_u8(h, a);
        a = a - (i * 3 + 2);
        h = fold.mix_u8(h, a);
        i = i + 1;
    }

    var b: u8 = s;
    var j: u8 = 0;
    for (j < 8) {
        b = b - (j * 181 + 1);
        h = fold.mix_u8(h, b);
        j = j + 1;
    }

    val n: u8 = 0 - a;
    h = fold.mix_u8(h, n);
    h = fold.mix_u8(h, 0 - n);
    h = fold.mix_u8(h, 0 - s);
    h = fold.mix_u8(h, 127 + a);
    h = fold.mix_u8(h, 128 - a);
    h = fold.mix_u8(h, 255 + a);
    h = fold.mix_u8(h, a + b);
    h = fold.mix_u8(h, a - b);
    h = fold.mix_u8(h, b - a);
    ret h;
}

# i8 add and sub chains that cross the wrap boundary in both directions, plus
# negation expressed as 0 - x, with every chain seeded by an opaque value so the
# whole case cannot collapse to one constant.
#[noinline]
fun arith_i8(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: i8  = seed::i8;

    val IMAX: i8 = 127;
    val IMIN: i8 = -127 - 1;

    var a: i8 = -16 + s;
    var i: i8 = 0;
    for (i < 32) {
        a = a + (i * 7 + 1);
        h = fold.mix_i8(h, a);
        a = a - (i * 3 + 2);
        h = fold.mix_i8(h, a);
        i = i + 1;
    }

    var b: i8 = s;
    var j: i8 = 0;
    for (j < 8) {
        b = b - (j * 53 + 1);
        h = fold.mix_i8(h, b);
        j = j + 1;
    }

    val n: i8 = 0 - a;
    h = fold.mix_i8(h, n);
    h = fold.mix_i8(h, 0 - n);
    h = fold.mix_i8(h, 0 - s);
    h = fold.mix_i8(h, IMAX + a);
    h = fold.mix_i8(h, IMIN - a);
    h = fold.mix_i8(h, -1 + a);
    h = fold.mix_i8(h, a + b);
    h = fold.mix_i8(h, a - b);
    h = fold.mix_i8(h, b - a);
    ret h;
}

# u16 add and sub chains that cross the wrap boundary in both directions, plus
# negation expressed as 0 - x, with every chain seeded by an opaque value so the
# whole case cannot collapse to one constant.
#[noinline]
fun arith_u16(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: u16 = seed::u16;

    var a: u16 = 65520 + s;
    var i: u16 = 0;
    for (i < 32) {
        a = a + (i * 7 + 1);
        h = fold.mix_u16(h, a);
        a = a - (i * 3 + 2);
        h = fold.mix_u16(h, a);
        i = i + 1;
    }

    var b: u16 = s;
    var j: u16 = 0;
    for (j < 8) {
        b = b - (j * 43981 + 1);
        h = fold.mix_u16(h, b);
        j = j + 1;
    }

    val n: u16 = 0 - a;
    h = fold.mix_u16(h, n);
    h = fold.mix_u16(h, 0 - n);
    h = fold.mix_u16(h, 0 - s);
    h = fold.mix_u16(h, 32767 + a);
    h = fold.mix_u16(h, 32768 - a);
    h = fold.mix_u16(h, 65535 + a);
    h = fold.mix_u16(h, a + b);
    h = fold.mix_u16(h, a - b);
    h = fold.mix_u16(h, b - a);
    ret h;
}

# i16 add and sub chains that cross the wrap boundary in both directions, plus
# negation expressed as 0 - x, with every chain seeded by an opaque value so the
# whole case cannot collapse to one constant.
#[noinline]
fun arith_i16(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: i16 = seed::i16;

    val IMAX: i16 = 32767;
    val IMIN: i16 = -32767 - 1;

    var a: i16 = -16 + s;
    var i: i16 = 0;
    for (i < 32) {
        a = a + (i * 7 + 1);
        h = fold.mix_i16(h, a);
        a = a - (i * 3 + 2);
        h = fold.mix_i16(h, a);
        i = i + 1;
    }

    var b: i16 = s;
    var j: i16 = 0;
    for (j < 8) {
        b = b - (j * 12345 + 1);
        h = fold.mix_i16(h, b);
        j = j + 1;
    }

    val n: i16 = 0 - a;
    h = fold.mix_i16(h, n);
    h = fold.mix_i16(h, 0 - n);
    h = fold.mix_i16(h, 0 - s);
    h = fold.mix_i16(h, IMAX + a);
    h = fold.mix_i16(h, IMIN - a);
    h = fold.mix_i16(h, -1 + a);
    h = fold.mix_i16(h, a + b);
    h = fold.mix_i16(h, a - b);
    h = fold.mix_i16(h, b - a);
    ret h;
}

# u32 add and sub chains that cross the wrap boundary in both directions, plus
# negation expressed as 0 - x, with every chain seeded by an opaque value so the
# whole case cannot collapse to one constant.
#[noinline]
fun arith_u32(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: u32 = seed::u32;

    var a: u32 = 4294967280 + s;
    var i: u32 = 0;
    for (i < 32) {
        a = a + (i * 7 + 1);
        h = fold.mix_u32(h, a);
        a = a - (i * 3 + 2);
        h = fold.mix_u32(h, a);
        i = i + 1;
    }

    var b: u32 = s;
    var j: u32 = 0;
    for (j < 8) {
        b = b - (j * 305419896 + 1);
        h = fold.mix_u32(h, b);
        j = j + 1;
    }

    val n: u32 = 0 - a;
    h = fold.mix_u32(h, n);
    h = fold.mix_u32(h, 0 - n);
    h = fold.mix_u32(h, 0 - s);
    h = fold.mix_u32(h, 2147483647 + a);
    h = fold.mix_u32(h, 2147483648 - a);
    h = fold.mix_u32(h, 4294967295 + a);
    h = fold.mix_u32(h, a + b);
    h = fold.mix_u32(h, a - b);
    h = fold.mix_u32(h, b - a);
    ret h;
