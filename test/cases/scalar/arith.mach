# u64 add and sub chains that cross the wrap boundary in both directions, plus
# negation expressed as 0 - x, with every chain seeded by an opaque value so the
# whole case cannot collapse to one constant.
#[noinline]
fun arith_u64(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: u64 = seed;

    var a: u64 = 18446744073709551600 + s;
    var i: u64 = 0;
    for (i < 32) {
        a = a + (i * 7 + 1);
        h = fold.mix_u64(h, a);
        a = a - (i * 3 + 2);
        h = fold.mix_u64(h, a);
        i = i + 1;
    }

    var b: u64 = s;
    var j: u64 = 0;
    for (j < 8) {
        b = b - (j * 1311768467294899695 + 1);
        h = fold.mix_u64(h, b);
        j = j + 1;
    }

    val n: u64 = 0 - a;
    h = fold.mix_u64(h, n);
    h = fold.mix_u64(h, 0 - n);
    h = fold.mix_u64(h, 0 - s);
    h = fold.mix_u64(h, 9223372036854775807 + a);
    h = fold.mix_u64(h, 9223372036854775808 - a);
    h = fold.mix_u64(h, 18446744073709551615 + a);
    h = fold.mix_u64(h, a + b);
    h = fold.mix_u64(h, a - b);
    h = fold.mix_u64(h, b - a);
    ret h;
}

# i64 add and sub chains that cross the wrap boundary in both directions, plus
# negation expressed as 0 - x, with every chain seeded by an opaque value so the
# whole case cannot collapse to one constant.
#[noinline]
fun arith_i64(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: i64 = seed::i64;

    val IMAX: i64 = 9223372036854775807;
    val IMIN: i64 = -9223372036854775807 - 1;

    var a: i64 = -16 + s;
    var i: i64 = 0;
    for (i < 32) {
        a = a + (i * 7 + 1);
        h = fold.mix_i64(h, a);
        a = a - (i * 3 + 2);
        h = fold.mix_i64(h, a);
        i = i + 1;
    }

    var b: i64 = s;
    var j: i64 = 0;
    for (j < 8) {
        b = b - (j * 1311768467294899695 + 1);
        h = fold.mix_i64(h, b);
        j = j + 1;
    }

    val n: i64 = 0 - a;
    h = fold.mix_i64(h, n);
    h = fold.mix_i64(h, 0 - n);
    h = fold.mix_i64(h, 0 - s);
    h = fold.mix_i64(h, IMAX + a);
    h = fold.mix_i64(h, IMIN - a);
    h = fold.mix_i64(h, -1 + a);
    h = fold.mix_i64(h, a + b);
    h = fold.mix_i64(h, a - b);
    h = fold.mix_i64(h, b - a);
    ret h;
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    h = fold.mix_u64(h, arith_u8(seed));
    h = fold.mix_u64(h, arith_i8(seed));
    h = fold.mix_u64(h, arith_u16(seed));
    h = fold.mix_u64(h, arith_i16(seed));
    h = fold.mix_u64(h, arith_u32(seed));
    h = fold.mix_u64(h, arith_i32(seed));
    h = fold.mix_u64(h, arith_u64(seed));
    h = fold.mix_u64(h, arith_i64(seed));
    ret h;
}
