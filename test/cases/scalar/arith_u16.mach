# u16 add and sub chains that cross the wrap boundary in both directions, plus
# negation expressed as 0 - x, with every chain seeded by an opaque value so the
# whole case cannot collapse to one constant.

use corpus.lib.fold;

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: u16 = seed::u16;

    var a: u16 = 65520 + s;
    var i: u16 = 0;
    for (i < 32) {
        a = a + (i * 7 + 1);
        h = fold.mix_u16(h, a);
        a = a - (i * 3 + 2);
        h = fold.mix_u16(h, a);
        i = i + 1;
    }

    var b: u16 = s;
    var j: u16 = 0;
    for (j < 8) {
        b = b - (j * 43981 + 1);
        h = fold.mix_u16(h, b);
        j = j + 1;
    }

    val n: u16 = 0 - a;
    h = fold.mix_u16(h, n);
    h = fold.mix_u16(h, 0 - n);
    h = fold.mix_u16(h, 0 - s);
    h = fold.mix_u16(h, 32767 + a);
    h = fold.mix_u16(h, 32768 - a);
    h = fold.mix_u16(h, 65535 + a);
    h = fold.mix_u16(h, a + b);
    h = fold.mix_u16(h, a - b);
    h = fold.mix_u16(h, b - a);
    ret h;
}
