# division and remainder by constants at 8, 16, 32 and 64 bits, signed and
# unsigned: every 8- and 16-bit dividend, and edge and pseudo-random ones at
# 32 and 64 bits, by divisors that take each sequence the lowering picks (#3350).
# generated: one noinline part per type.

use corpus.lib.fold;

#[noinline]
fun divconst_u8(seed: u64) u64 {
    var h: u64 = fold.init();
    var i: u64 = 0;
    for (i < 256) {
        val x: u8 = (i + seed)::u8;
        h = fold.mix_u8(h, x / 2);
        h = fold.mix_u8(h, x % 2);
        h = fold.mix_u8(h, x / 3);
        h = fold.mix_u8(h, x % 3);
        h = fold.mix_u8(h, x / 5);
        h = fold.mix_u8(h, x % 5);
        h = fold.mix_u8(h, x / 7);
        h = fold.mix_u8(h, x % 7);
        h = fold.mix_u8(h, x / 10);
        h = fold.mix_u8(h, x % 10);
        h = fold.mix_u8(h, x / 16);
        h = fold.mix_u8(h, x % 16);
        h = fold.mix_u8(h, x / 25);
        h = fold.mix_u8(h, x % 25);
        h = fold.mix_u8(h, x / 127);
        h = fold.mix_u8(h, x % 127);
        h = fold.mix_u8(h, x / 128);
        h = fold.mix_u8(h, x % 128);
        h = fold.mix_u8(h, x / 129);
        h = fold.mix_u8(h, x % 129);
        h = fold.mix_u8(h, x / 255);
        h = fold.mix_u8(h, x % 255);
        h = fold.mix_u8(h, x / 85);
        h = fold.mix_u8(h, x % 85);
        i = i + 1;
    }
    ret h;
}

