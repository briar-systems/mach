        h = fold.mix_u64(h, x / 1000000007);
        h = fold.mix_u64(h, x % 1000000007);
        h = fold.mix_u64(h, x / 6700417);
        h = fold.mix_u64(h, x % 6700417);
        h = fold.mix_u64(h, x / 9223372036854775807);
        h = fold.mix_u64(h, x % 9223372036854775807);
        h = fold.mix_u64(h, x / 9223372036854775808);
        h = fold.mix_u64(h, x % 9223372036854775808);
        h = fold.mix_u64(h, x / 9223372036854775809);
