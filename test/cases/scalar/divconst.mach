#[noinline]
fun divconst_u32(seed: u64) u64 {
    var h: u64 = fold.init();
    var v: u64 = 0x9E3779B97F4A7C15 + seed;
    var i: u64 = 0;
    for (i < 2048) {
        v = v * 6364136223846793005 + 1442695040888963407;
        var xu: u64 = v >> (i & 31);
        if (i < 8)            { xu = (0::u64 - 4 + i) >> (64 - 32); }
        if (i >= 8 && i < 16) { xu = (i - 8) << (32 - 3); }
        val x: u32 = xu::u32;
        h = fold.mix_u32(h, x / 2);
        h = fold.mix_u32(h, x % 2);
        h = fold.mix_u32(h, x / 3);
        h = fold.mix_u32(h, x % 3);
        h = fold.mix_u32(h, x / 5);
        h = fold.mix_u32(h, x % 5);
        h = fold.mix_u32(h, x / 7);
        h = fold.mix_u32(h, x % 7);
        h = fold.mix_u32(h, x / 10);
        h = fold.mix_u32(h, x % 10);
        h = fold.mix_u32(h, x / 16);
        h = fold.mix_u32(h, x % 16);
        h = fold.mix_u32(h, x / 25);
        h = fold.mix_u32(h, x % 25);
        h = fold.mix_u32(h, x / 641);
        h = fold.mix_u32(h, x % 641);
        h = fold.mix_u32(h, x / 1000000007);
        h = fold.mix_u32(h, x % 1000000007);
        h = fold.mix_u32(h, x / 6700417);
        h = fold.mix_u32(h, x % 6700417);
        h = fold.mix_u32(h, x / 2147483647);
        h = fold.mix_u32(h, x % 2147483647);
        h = fold.mix_u32(h, x / 2147483648);
        h = fold.mix_u32(h, x % 2147483648);
        h = fold.mix_u32(h, x / 2147483649);
        h = fold.mix_u32(h, x % 2147483649);
        h = fold.mix_u32(h, x / 4294967295);
        h = fold.mix_u32(h, x % 4294967295);
        h = fold.mix_u32(h, x / 1431655765);
        h = fold.mix_u32(h, x % 1431655765);
        i = i + 1;
    }
    ret h;
}

#[noinline]
fun divconst_i32(seed: u64) u64 {
    var h: u64 = fold.init();
    var v: u64 = 0x9E3779B97F4A7C15 + seed;
    var i: u64 = 0;
    for (i < 2048) {
        v = v * 6364136223846793005 + 1442695040888963407;
        var xu: u64 = v >> (i & 31);
        if (i < 8)            { xu = (0::u64 - 4 + i) >> (64 - 32); }
        if (i >= 8 && i < 16) { xu = (i - 8) << (32 - 3); }
        val x: i32 = (xu::u32):~i32;
        h = fold.mix_i32(h, x / 2);
        h = fold.mix_i32(h, x % 2);
        h = fold.mix_i32(h, x / 3);
        h = fold.mix_i32(h, x % 3);
        h = fold.mix_i32(h, x / 7);
        h = fold.mix_i32(h, x % 7);
        h = fold.mix_i32(h, x / 10);
        h = fold.mix_i32(h, x % 10);
        h = fold.mix_i32(h, x / 64);
        h = fold.mix_i32(h, x % 64);
        h = fold.mix_i32(h, x / 1000000007);
        h = fold.mix_i32(h, x % 1000000007);
        h = fold.mix_i32(h, x / -3);
        h = fold.mix_i32(h, x % -3);
        h = fold.mix_i32(h, x / -7);
        h = fold.mix_i32(h, x % -7);
        h = fold.mix_i32(h, x / -10);
        h = fold.mix_i32(h, x % -10);
        h = fold.mix_i32(h, x / -641);
        h = fold.mix_i32(h, x % -641);
        h = fold.mix_i32(h, x / -2);
        h = fold.mix_i32(h, x % -2);
        h = fold.mix_i32(h, x / -16);
        h = fold.mix_i32(h, x % -16);
        h = fold.mix_i32(h, x / (-2147483647 - 1));
        h = fold.mix_i32(h, x % (-2147483647 - 1));
        h = fold.mix_i32(h, x / -2147483647);
        h = fold.mix_i32(h, x % -2147483647);
        h = fold.mix_i32(h, x / 2147483647);
        h = fold.mix_i32(h, x % 2147483647);
        h = fold.mix_i32(h, x / 2147483646);
        h = fold.mix_i32(h, x % 2147483646);
        h = fold.mix_i32(h, x / -1073741825);
        h = fold.mix_i32(h, x % -1073741825);
        h = fold.mix_i32(h, x / 6700417);
        h = fold.mix_i32(h, x % 6700417);
        i = i + 1;
    }
    ret h;
}

