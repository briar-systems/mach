#[noinline]
fun divconst_i64(seed: u64) u64 {
    var h: u64 = fold.init();
    var v: u64 = 0x9E3779B97F4A7C15 + seed;
    var i: u64 = 0;
    for (i < 2048) {
        v = v * 6364136223846793005 + 1442695040888963407;
        var xu: u64 = v >> (i & 31);
        if (i < 8)            { xu = (0::u64 - 4 + i) >> (64 - 64); }
        if (i >= 8 && i < 16) { xu = (i - 8) << (64 - 3); }
        val x: i64 = (xu::u64):~i64;
        h = fold.mix_i64(h, x / 2);
        h = fold.mix_i64(h, x % 2);
        h = fold.mix_i64(h, x / 3);
        h = fold.mix_i64(h, x % 3);
        h = fold.mix_i64(h, x / 7);
        h = fold.mix_i64(h, x % 7);
        h = fold.mix_i64(h, x / 10);
        h = fold.mix_i64(h, x % 10);
        h = fold.mix_i64(h, x / 64);
        h = fold.mix_i64(h, x % 64);
        h = fold.mix_i64(h, x / 1000000007);
        h = fold.mix_i64(h, x % 1000000007);
        h = fold.mix_i64(h, x / -3);
        h = fold.mix_i64(h, x % -3);
        h = fold.mix_i64(h, x / -7);
        h = fold.mix_i64(h, x % -7);
        h = fold.mix_i64(h, x / -10);
        h = fold.mix_i64(h, x % -10);
        h = fold.mix_i64(h, x / -641);
        h = fold.mix_i64(h, x % -641);
        h = fold.mix_i64(h, x / -2);
        h = fold.mix_i64(h, x % -2);
        h = fold.mix_i64(h, x / -16);
        h = fold.mix_i64(h, x % -16);
        h = fold.mix_i64(h, x / (-9223372036854775807 - 1));
        h = fold.mix_i64(h, x % (-9223372036854775807 - 1));
        h = fold.mix_i64(h, x / -9223372036854775807);
        h = fold.mix_i64(h, x % -9223372036854775807);
        h = fold.mix_i64(h, x / 9223372036854775807);
        h = fold.mix_i64(h, x % 9223372036854775807);
        h = fold.mix_i64(h, x / 9223372036854775806);
        h = fold.mix_i64(h, x % 9223372036854775806);
        h = fold.mix_i64(h, x / -4611686018427387905);
        h = fold.mix_i64(h, x % -4611686018427387905);
        h = fold.mix_i64(h, x / 6700417);
        h = fold.mix_i64(h, x % 6700417);
        i = i + 1;
    }
    ret h;
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    h = fold.mix_u64(h, divconst_u8(seed));
    h = fold.mix_u64(h, divconst_i8(seed));
    h = fold.mix_u64(h, divconst_u16(seed));
    h = fold.mix_u64(h, divconst_i16(seed));
    h = fold.mix_u64(h, divconst_u32(seed));
    h = fold.mix_u64(h, divconst_i32(seed));
    h = fold.mix_u64(h, divconst_u64(seed));
    h = fold.mix_u64(h, divconst_i64(seed));
    ret h;
}
