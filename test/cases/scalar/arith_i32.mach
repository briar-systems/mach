# i32 add and sub chains that cross the wrap boundary in both directions, plus
# negation expressed as 0 - x, with every chain seeded by an opaque value so the
# whole case cannot collapse to one constant.

use corpus.lib.fold;

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: i32 = seed::i32;

    val IMAX: i32 = 2147483647;
    val IMIN: i32 = -2147483647 - 1;

    var a: i32 = -16 + s;
    var i: i32 = 0;
    for (i < 32) {
        a = a + (i * 7 + 1);
        h = fold.mix_i32(h, a);
        a = a - (i * 3 + 2);
        h = fold.mix_i32(h, a);
        i = i + 1;
    }

    var b: i32 = s;
    var j: i32 = 0;
    for (j < 8) {
        b = b - (j * 305419896 + 1);
        h = fold.mix_i32(h, b);
        j = j + 1;
    }

    val n: i32 = 0 - a;
    h = fold.mix_i32(h, n);
    h = fold.mix_i32(h, 0 - n);
    h = fold.mix_i32(h, 0 - s);
    h = fold.mix_i32(h, IMAX + a);
    h = fold.mix_i32(h, IMIN - a);
    h = fold.mix_i32(h, -1 + a);
    h = fold.mix_i32(h, a + b);
    h = fold.mix_i32(h, a - b);
    h = fold.mix_i32(h, b - a);
    ret h;
}
