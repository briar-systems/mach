# u8 add and sub chains that cross the wrap boundary in both directions, plus
# negation expressed as 0 - x, with every chain seeded by an opaque value so the
# whole case cannot collapse to one constant.

use corpus.lib.fold;

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: u8 = seed::u8;

    var a: u8 = 240 + s;
    var i: u8 = 0;
    for (i < 32) {
        a = a + (i * 7 + 1);
        h = fold.mix_u8(h, a);
        a = a - (i * 3 + 2);
        h = fold.mix_u8(h, a);
        i = i + 1;
    }

    var b: u8 = s;
    var j: u8 = 0;
    for (j < 8) {
        b = b - (j * 181 + 1);
        h = fold.mix_u8(h, b);
        j = j + 1;
    }

    val n: u8 = 0 - a;
    h = fold.mix_u8(h, n);
    h = fold.mix_u8(h, 0 - n);
    h = fold.mix_u8(h, 0 - s);
    h = fold.mix_u8(h, 127 + a);
    h = fold.mix_u8(h, 128 - a);
    h = fold.mix_u8(h, 255 + a);
    h = fold.mix_u8(h, a + b);
    h = fold.mix_u8(h, a - b);
    h = fold.mix_u8(h, b - a);
    ret h;
}
