# i64 add and sub chains that cross the wrap boundary in both directions, plus
# negation expressed as 0 - x, with every chain seeded by an opaque value so the
# whole case cannot collapse to one constant.

use corpus.lib.fold;

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: i64 = seed::i64;

    val IMAX: i64 = 9223372036854775807;
    val IMIN: i64 = -9223372036854775807 - 1;

    var a: i64 = -16 + s;
    var i: i64 = 0;
    for (i < 32) {
        a = a + (i * 7 + 1);
        h = fold.mix_i64(h, a);
        a = a - (i * 3 + 2);
        h = fold.mix_i64(h, a);
        i = i + 1;
    }

    var b: i64 = s;
    var j: i64 = 0;
    for (j < 8) {
        b = b - (j * 1311768467294899695 + 1);
        h = fold.mix_i64(h, b);
        j = j + 1;
    }

    val n: i64 = 0 - a;
    h = fold.mix_i64(h, n);
    h = fold.mix_i64(h, 0 - n);
    h = fold.mix_i64(h, 0 - s);
    h = fold.mix_i64(h, IMAX + a);
    h = fold.mix_i64(h, IMIN - a);
    h = fold.mix_i64(h, -1 + a);
    h = fold.mix_i64(h, a + b);
    h = fold.mix_i64(h, a - b);
    h = fold.mix_i64(h, b - a);
    ret h;
}
