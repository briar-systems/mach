# u64 division and remainder, folding q, r and the identity d*q + r, with
# dividends near both width boundaries and divisors that stay strictly nonzero.

use corpus.lib.fold;

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: u64 = seed;

    var d: u64 = 18446744073709551615 - s;
    var i: u64 = 0;
    for (i < 16) {
        val v: u64 = i * 131 + 3 + s;
        val q: u64 = d / v;
        val r: u64 = d % v;
        h = fold.mix_u64(h, q);
        h = fold.mix_u64(h, r);
        h = fold.mix_u64(h, v * q + r);
        d = d - v;
        i = i + 1;
    }

    val big: u64 = 18446744073709551613 + s;
    val small: u64 = 3 + s;
    val q0: u64 = big / small;
    val r0: u64 = big % small;
    h = fold.mix_u64(h, q0);
    h = fold.mix_u64(h, r0);
    h = fold.mix_u64(h, small * q0 + r0);

    val q1: u64 = small / big;
    val r1: u64 = small % big;
    h = fold.mix_u64(h, q1);
    h = fold.mix_u64(h, r1);
    h = fold.mix_u64(h, big * q1 + r1);
    ret h;
}
