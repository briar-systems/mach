# loops that read more constants than the registers hold, so constants built
# once ahead of each loop are built again where they are read rather than
# spilled (#3807): more float constants than float registers, more wide
# integer constants than general registers, constants read across a call, an
# inner loop's constants beside its outer loop's, and the literals that stay
# in place (a low-bit mask and a power-of-two multiplier).

use corpus.lib.fold;

#[noinline]
fun opaque(v: u64) u64 {
    ret v ^ 0x5A;
}

# every input and constant is a multiple of 1/256 well inside the mantissa,
# so every product and sum is exact whatever the order the target keeps
#[noinline]
fun floats64(seed: u64) u64 {
    var h:   u64 = fold.init();
    var acc: f64 = 0.0;
    var i:   u64 = 0;
    for (i < 24) {
        val x: f64 = ((i * 7 + seed) & 255)::f64 * 0.00390625;
        acc = acc + x * 1.5 + x * 2.25 + x * 3.125 + x * 4.0625 + x * 5.5
            + x * 6.75 + x * 7.875 + x * 8.5 + x * 9.25 + x * 10.75
            + x * 11.5 + x * 12.125 + x * 13.25 + x * 14.5 + x * 15.75
            + x * 16.5 + x * 17.25 + x * 18.75 + x * 19.5 + x * 20.125;
        h = fold.mix_f64(h, acc);
        i = i + 1;
    }
    ret h;
}

#[noinline]
fun floats32(seed: u64) u64 {
    var h:   u64 = fold.init();
    var acc: f32 = 0.0;
    var i:   u64 = 0;
    for (i < 20) {
        val x: f32 = ((i * 5 + seed) & 63)::f32 * 0.0625;
        acc = acc * 0.5 + x * 1.25 + x * 2.5 + x * 3.75 + x * 4.5 + x * 5.25
            + x * 6.5 + x * 7.75 + x * 8.25 + x * 9.5 + x * 10.25
            + x * 11.75 + x * 12.5 + x * 13.25 + x * 14.75 + x * 15.5
            + x * 16.25 + x * 17.5;
        h = fold.mix_f32(h, acc);
        i = i + 1;
    }
    ret h;
}

#[noinline]
fun wide(seed: u64) u64 {
    var h: u64 = fold.init();
    var a: u64 = seed;
    var b: u64 = seed + 1;
    var c: u64 = seed + 2;
    var d: u64 = seed + 3;
    var e: u64 = seed + 4;
    var f: u64 = seed + 5;
    var i: u64 = 0;
    for (i < 16) {
        a = (a ^ i) * 1099511628211;
        b = (b + a) * 11400714819323198485;
        c = (c ^ b) * 14029467366897019727;
        d = (d + c) * 1609587929392839161;
        e = (e ^ d) * 9650029242287828579;
        f = (f + e) * 2870177450012600261;
        a = a ^ 3337190745834213367;
        b = b + 5754853343627963903;
        c = c ^ 12297829382473034410;
        d = d + 6148914691236517205;
        e = e & 18446744069414584320;
        f = f | 1229782938247303441;
        h = fold.mix_u64(h, a ^ b ^ c ^ d ^ e ^ f);
        i = i + 1;
    }
    ret h;
}

# a constant read on both sides of a call, an inner loop's constants beside the
# outer loop's, 32-bit constants no one instruction builds on some targets,
# and a low-bit mask and a power-of-two multiplier that stay literal
#[noinline]
fun nested(seed: u64) u64 {
    var h: u64 = fold.init();
    var r: u64 = 0;
    for (r < 6) {
        var x: u64 = (r + seed) * 6364136223846793005;
        x = opaque(x) ^ 6364136223846793005;
        var c: u32 = 0;
        for (c < 5) {
            val w: u32 = (x::u32 + c) * 305419896;
            h = fold.mix_u32(h, (w ^ 2596069104) | 16777473);
            h = fold.mix_u64(h, (x & 4294967295) * 1099511627776);
            c = c + 1;
        }
        h = fold.mix_u64(h, x);
        r = r + 1;
    }
    ret h;
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    h = fold.mix_u64(h, floats64(seed));
    h = fold.mix_u64(h, floats32(seed));
    h = fold.mix_u64(h, wide(seed));
    h = fold.mix_u64(h, nested(seed));
    ret h;
}
