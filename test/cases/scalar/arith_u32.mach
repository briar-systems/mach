# u32 add and sub chains that cross the wrap boundary in both directions, plus
# negation expressed as 0 - x, with every chain seeded by an opaque value so the
# whole case cannot collapse to one constant.

use corpus.lib.fold;

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: u32 = seed::u32;

    var a: u32 = 4294967280 + s;
    var i: u32 = 0;
    for (i < 32) {
        a = a + (i * 7 + 1);
        h = fold.mix_u32(h, a);
        a = a - (i * 3 + 2);
        h = fold.mix_u32(h, a);
        i = i + 1;
    }

    var b: u32 = s;
    var j: u32 = 0;
    for (j < 8) {
        b = b - (j * 305419896 + 1);
        h = fold.mix_u32(h, b);
        j = j + 1;
    }

    val n: u32 = 0 - a;
    h = fold.mix_u32(h, n);
    h = fold.mix_u32(h, 0 - n);
    h = fold.mix_u32(h, 0 - s);
    h = fold.mix_u32(h, 2147483647 + a);
    h = fold.mix_u32(h, 2147483648 - a);
    h = fold.mix_u32(h, 4294967295 + a);
    h = fold.mix_u32(h, a + b);
    h = fold.mix_u32(h, a - b);
    h = fold.mix_u32(h, b - a);
    ret h;
}
