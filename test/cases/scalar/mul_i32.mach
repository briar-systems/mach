# i32 products that exceed the width, seeded so the wrap cannot be folded away
# at compile time. wraparound on a signed product is bit-identical to the
# unsigned product, so this exercises the signed multiply encoding, not a
# different value domain.

use corpus.lib.fold;

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: i32 = seed::i32;

    var a: i32 = -1640531527 + s;
    var i: i32 = 0;
    for (i < 16) {
        a = a * (2 * i + 3);
        h = fold.mix_i32(h, a);
        i = i + 1;
    }

    var b: i32 = -65 + s;
    h = fold.mix_i32(h, b * b);
    h = fold.mix_i32(h, b * -1);
    h = fold.mix_i32(h, a * b);
    h = fold.mix_i32(h, b * a);

    var c: i32 = 65537 + s;
    h = fold.mix_i32(h, c * c);
    h = fold.mix_i32(h, c * -1);
    ret h;
}
