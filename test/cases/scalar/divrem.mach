# division and remainder at 32 and 64 bits, signed and unsigned, folding q, r and d*q + r.
# one noinline part per type.

use corpus.lib.fold;

# u32 division and remainder, folding q, r and the identity d*q + r, with
# dividends near both width boundaries and divisors that stay strictly nonzero.
#[noinline]
fun divrem_u32(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: u32 = seed::u32;

    var d: u32 = 4294967295 - s;
    var i: u32 = 0;
    for (i < 16) {
        val v: u32 = i * 131 + 3 + s;
        val q: u32 = d / v;
        val r: u32 = d % v;
        h = fold.mix_u32(h, q);
        h = fold.mix_u32(h, r);
        h = fold.mix_u32(h, v * q + r);
        d = d - v;
        i = i + 1;
    }

    val big:   u32 = 4294967293 + s;
    val small: u32 = 3 + s;
    val q0:    u32 = big / small;
    val r0:    u32 = big % small;
    h = fold.mix_u32(h, q0);
    h = fold.mix_u32(h, r0);
    h = fold.mix_u32(h, small * q0 + r0);

    val q1: u32 = small / big;
    val r1: u32 = small % big;
    h = fold.mix_u32(h, q1);
    h = fold.mix_u32(h, r1);
    h = fold.mix_u32(h, big * q1 + r1);
    ret h;
}

# i32 division and remainder, folding q, r and the identity d*q + r. divisors
# stay strictly positive and never -1, and dividends stay well clear of
# i32::MIN, so every operand pair is inside mach's defined domain and the
# defined-behaviour C mapping alike.
#[noinline]
fun divrem_i32(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: i32 = seed::i32;

    var d: i32 = 2000000000 - s;
    var i: i32 = 0;
    for (i < 16) {
        val v: i32 = i * 131 + 3 + s;
        val q: i32 = d / v;
        val r: i32 = d % v;
        h = fold.mix_i32(h, q);
        h = fold.mix_i32(h, r);
        h = fold.mix_i32(h, v * q + r);
        d = d - v;
        i = i + 1;
    }

    var e: i32 = 0 - (2000000000 + s);
    i = 0;
    for (i < 8) {
        val v: i32 = i * 197 + 5 + s;
        val q: i32 = e / v;
        val r: i32 = e % v;
        h = fold.mix_i32(h, q);
        h = fold.mix_i32(h, r);
        h = fold.mix_i32(h, v * q + r);
        e = e + v;
        i = i + 1;
    }

    val big:   i32 = 2147483644 + s;
    val small: i32 = 3 + s;
    val q0:    i32 = big / small;
    val r0:    i32 = big % small;
    h = fold.mix_i32(h, q0);
    h = fold.mix_i32(h, r0);
    h = fold.mix_i32(h, small * q0 + r0);

    val q1: i32 = small / big;
    val r1: i32 = small % big;
    h = fold.mix_i32(h, q1);
    h = fold.mix_i32(h, r1);
    h = fold.mix_i32(h, big * q1 + r1);
    ret h;
}

# u64 division and remainder, folding q, r and the identity d*q + r, with
# dividends near both width boundaries and divisors that stay strictly nonzero.
#[noinline]
fun divrem_u64(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: u64 = seed;

    var d: u64 = 18446744073709551615 - s;
    var i: u64 = 0;
    for (i < 16) {
        val v: u64 = i * 131 + 3 + s;
        val q: u64 = d / v;
        val r: u64 = d % v;
        h = fold.mix_u64(h, q);
        h = fold.mix_u64(h, r);
        h = fold.mix_u64(h, v * q + r);
        d = d - v;
        i = i + 1;
    }

    val big:   u64 = 18446744073709551613 + s;
    val small: u64 = 3 + s;
    val q0:    u64 = big / small;
    val r0:    u64 = big % small;
    h = fold.mix_u64(h, q0);
    h = fold.mix_u64(h, r0);
    h = fold.mix_u64(h, small * q0 + r0);

    val q1: u64 = small / big;
    val r1: u64 = small % big;
    h = fold.mix_u64(h, q1);
    h = fold.mix_u64(h, r1);
    h = fold.mix_u64(h, big * q1 + r1);
    ret h;
}

# i64 division and remainder, folding q, r and the identity d*q + r. divisors
# stay strictly positive and never -1, and dividends stay well clear of
# i64::MIN, so every operand pair is inside mach's defined domain and the
# defined-behaviour C mapping alike.
#[noinline]
fun divrem_i64(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: i64 = seed::i64;

    var d: i64 = 9000000000000000000 - s;
    var i: i64 = 0;
    for (i < 16) {
        val v: i64 = i * 131 + 3 + s;
        val q: i64 = d / v;
        val r: i64 = d % v;
        h = fold.mix_i64(h, q);
        h = fold.mix_i64(h, r);
        h = fold.mix_i64(h, v * q + r);
        d = d - v;
        i = i + 1;
    }

    var e: i64 = 0 - (9000000000000000000 + s);
    i = 0;
    for (i < 8) {
        val v: i64 = i * 197 + 5 + s;
        val q: i64 = e / v;
        val r: i64 = e % v;
        h = fold.mix_i64(h, q);
        h = fold.mix_i64(h, r);
        h = fold.mix_i64(h, v * q + r);
        e = e + v;
        i = i + 1;
    }

    val big:   i64 = 9223372036854775804 + s;
    val small: i64 = 3 + s;
    val q0:    i64 = big / small;
    val r0:    i64 = big % small;
    h = fold.mix_i64(h, q0);
    h = fold.mix_i64(h, r0);
    h = fold.mix_i64(h, small * q0 + r0);

    val q1: i64 = small / big;
    val r1: i64 = small % big;
    h = fold.mix_i64(h, q1);
    h = fold.mix_i64(h, r1);
    h = fold.mix_i64(h, big * q1 + r1);
    ret h;
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    h = fold.mix_u64(h, divrem_u32(seed));
    h = fold.mix_u64(h, divrem_i32(seed));
    h = fold.mix_u64(h, divrem_u64(seed));
    h = fold.mix_u64(h, divrem_i64(seed));
    ret h;
}
