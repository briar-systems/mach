# i64 division and remainder, folding q, r and the identity d*q + r. divisors
# stay strictly positive and never -1, and dividends stay well clear of
# i64::MIN, so every operand pair is inside mach's defined domain and the
# defined-behaviour C mapping alike.

use corpus.lib.fold;

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: i64 = seed::i64;

    var d: i64 = 9000000000000000000 - s;
    var i: i64 = 0;
    for (i < 16) {
        val v: i64 = i * 131 + 3 + s;
        val q: i64 = d / v;
        val r: i64 = d % v;
        h = fold.mix_i64(h, q);
        h = fold.mix_i64(h, r);
        h = fold.mix_i64(h, v * q + r);
        d = d - v;
        i = i + 1;
    }

    var e: i64 = 0 - (9000000000000000000 + s);
    i = 0;
    for (i < 8) {
        val v: i64 = i * 197 + 5 + s;
        val q: i64 = e / v;
        val r: i64 = e % v;
        h = fold.mix_i64(h, q);
        h = fold.mix_i64(h, r);
        h = fold.mix_i64(h, v * q + r);
        e = e + v;
        i = i + 1;
    }

    val big: i64 = 9223372036854775804 + s;
    val small: i64 = 3 + s;
    val q0: i64 = big / small;
    val r0: i64 = big % small;
    h = fold.mix_i64(h, q0);
    h = fold.mix_i64(h, r0);
    h = fold.mix_i64(h, small * q0 + r0);

    val q1: i64 = small / big;
    val r1: i64 = small % big;
    h = fold.mix_i64(h, q1);
    h = fold.mix_i64(h, r1);
    h = fold.mix_i64(h, big * q1 + r1);
    ret h;
}
