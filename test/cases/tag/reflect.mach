# reflection over a tag at compile time agreeing with the runtime value: `$cases`
# walked with `$each`, `sel v.[c]` and `v.[c]` through a descriptor, a value
# constructed through `T.[c]{}`, and the descriptor's code and offset folded next
# to the C layout's constants. `$is_tag` and `$discriminant_of` fold as sizes.
# the seed flows through the constructed payloads, so the walk must be a real
# runtime test and not a folded constant.

use corpus.lib.fold;

tag Tri: u8 {
    a: u32;
    b: u32;
    c: u32;
}

tag Reply: u16 {
    empty;
    value: i64;
}

fun code_of(t: Tri) u64 {
    var out: u64 = 99;
    $each c in $cases(Tri) {
        if (sel t.[c]) { out = c.code; }
    }
    ret out;
}

fun payload_of(t: Tri) u32 {
    var out: u32 = 0;
    $each c in $cases(Tri) {
        if (sel t.[c]) { out = t.[c]; }
    }
    ret out;
}

fun reply_walk(h: u64, r: Reply) u64 {
    var x: u64 = h;
    $each c in $cases(Reply) {
        if (sel r.[c]) {
            x = fold.mix_u64(x, c.code);
            $if (c.has_payload) {
                x = fold.mix_u64(x, c.offset);
                x = fold.mix_i64(x, r.[c]);
            }
        }
    }
    ret x;
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: u32 = seed::u32;

    $if ($is_tag(Tri)) { h = fold.mix_u8(h, 1); } $or { h = fold.mix_u8(h, 0); }
    $if ($is_tag(u32)) { h = fold.mix_u8(h, 1); } $or { h = fold.mix_u8(h, 0); }
    h = fold.mix_u64(h, $size_of($discriminant_of(Tri)));
    h = fold.mix_u64(h, $size_of($discriminant_of(Reply)));

    # every case constructed through its descriptor, then tested and read at runtime
    $each c in $cases(Tri) {
        val t: Tri = Tri.[c]{c.code::u32 * 100 + s};
        h = fold.mix_u64(h, code_of(t));
        h = fold.mix_u32(h, payload_of(t));
        h = fold.mix_u64(h, c.offset);
    }

    var r: Reply;
    h = reply_walk(h, r);
    r = Reply.value{77 + seed::i64};
    h = reply_walk(h, r);
    $each c in $cases(Reply) {
        $if (!c.has_payload) {
            r = Reply.[c]{};
        }
    }
    h = reply_walk(h, r);
    ret h;
}
