# tags inside tags, tags inside records, records inside tags and a payloadless
# case at every level. each level is constructed, replaced and read through its
# own guard, so a nested payload placed at the wrong common offset or an inner
# discriminator clobbered by an outer construction moves the checksum.

use corpus.lib.fold;

tag Reply: u8 {
    empty;
    value: i64;
}

tag Outer: u8 {
    none;
    inner: Reply;
}

rec Box {
    n: u8;
    r: Reply;
    k: u32;
}

tag Holder: u8 {
    nothing;
    box: Box;
    deep: Outer;
}

fun reply_of(r: Reply) i64 {
    if (sel r.value) { ret r.value; }
    ret -1;
}

fun outer_of(o: Outer) i64 {
    if (sel o.inner) { ret reply_of(o.inner) + 1000; }
    ret -2;
}

fun fold_box(h: u64, b: Box) u64 {
    var x: u64 = fold.mix_u8(h, b.n);
    x = fold.mix_i64(x, reply_of(b.r));
    x = fold.mix_u32(x, b.k);
    ret x;
}

fun fold_holder(h: u64, hd: Holder) u64 {
    if (sel hd.box) { ret fold_box(fold.mix_u8(h, 1), hd.box); }
    or (sel hd.deep) { ret fold.mix_i64(fold.mix_u8(h, 2), outer_of(hd.deep)); }
    ret fold.mix_u8(h, 0);
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: i64 = seed::i64;

    # a zero outer is none; a zero inner under an explicit inner is empty
    var o: Outer;
    h = fold.mix_i64(h, outer_of(o));
    o = Outer.inner{Reply.empty{}};
    h = fold.mix_i64(h, outer_of(o));
    o = Outer.inner{Reply.value{7 + s}};
    h = fold.mix_i64(h, outer_of(o));

    # the inner payload written and the inner case replaced under the outer guard
    if (sel o.inner) {
        if (sel o.inner.value) { o.inner.value = o.inner.value * 3; }
        h = fold.mix_i64(h, outer_of(o));
        o.inner = Reply.empty{};
        h = fold.mix_i64(h, outer_of(o));
        o.inner = Reply.value{11 + s};
    }
    h = fold.mix_i64(h, outer_of(o));

    # a record with a tag field: omitted field is zero, field replacement, record copy
    var b: Box = Box{n: 3, k: 9};
    h = fold_box(h, b);
    b.r = Reply.value{20 + s};
    h = fold_box(h, b);
    val b2: Box = b;
    b.r = Reply.empty{};
    h = fold_box(h, b);
    h = fold_box(h, b2);

    # a record inside a tag, and a tag inside a tag inside a tag
    var hd: Holder;
    h = fold_holder(h, hd);
    hd = Holder.box{b2};
    h = fold_holder(h, hd);
    if (sel hd.box) {
        hd.box.k = hd.box.k + 1;
        if (sel hd.box.r.value) { hd.box.r.value = hd.box.r.value + 1; }
    }
    h = fold_holder(h, hd);
    hd = Holder.deep{o};
    h = fold_holder(h, hd);
    if (sel hd.deep) {
        if (sel hd.deep.inner) {
            if (sel hd.deep.inner.value) { hd.deep.inner.value = hd.deep.inner.value + 5; }
        }
    }
    h = fold_holder(h, hd);
    hd = Holder.deep{Outer.none{}};
    h = fold_holder(h, hd);
    hd = Holder.nothing{};
    h = fold_holder(h, hd);
    val hc: Holder = Holder.box{Box{n: 1, r: Reply.value{s}, k: 2}};
    h = fold_holder(h, hc);
    ret h;
}
