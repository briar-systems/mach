# `sel` and the guarded payload read, write and address under every guard kind
# the contract opens: a chain arm, an exiting chain by `ret`, `brk` and `cnt`, the
# right operand of `&&`, a three-case chain that leaves one case untested, a
# nested guard, a pointer auto-dereference and an explicit dereference. every
# guarded access is on a path the case actually selects, so the debug-profile
# discriminator check never fires and both pipelines compute the same fold.

use corpus.lib.fold;

tag Reply: u8 {
    empty;
    value: i64;
}

tag Three: u8 {
    a;
    b: i64;
    c: u8;
}

tag Outer: u8 {
    none;
    inner: Reply;
}

fun make(v: i64) Reply {
    ret Reply.value{v};
}

# arm guard: read, write and address inside the block
fun arm(r: Reply) i64 {
    var t: Reply = r;
    if (sel t.value) {
        t.value = t.value + 1;
        val p: *i64 = ?t.value;
        @p = @p + 100;
        ret t.value;
    }
    ret -1;
}

# exiting chain by ret: the rest of the function is guarded
fun chain_ret(r: Reply) i64 {
    var t: Reply = r;
    if (!sel t.value) { ret -1; }
    t.value = t.value + 1;
    val p: *i64 = ?t.value;
    @p = @p + 100;
    ret t.value;
}

# exiting chain by brk: the rest of the loop body is guarded
fun chain_brk(r: Reply) i64 {
    var t: Reply = r;
    var out: i64 = -1;
    var once: u8 = 0;
    for (once == 0) {
        once = 1;
        if (!sel t.value) { brk; }
        t.value = t.value + 1;
        val p: *i64 = ?t.value;
        @p = @p + 100;
        out = t.value;
    }
    ret out;
}

# exiting chain by cnt: every iteration re-establishes the guard
fun chain_cnt(a: [4]Reply) i64 {
    var arr: [4]Reply = a;
    var sum: i64 = 0;
    var i: u64 = 0;
    for (i < 4) {
        val j: u64 = i;
        i = i + 1;
        if (!sel arr[j].value) { cnt; }
        arr[j].value = arr[j].value + 1;
        val p: *i64 = ?arr[j].value;
        @p = @p + 100;
        sum = sum + arr[j].value;
    }
    ret sum;
}

# the right operand of `&&` is guarded by the `sel` on its left
fun andop(r: Reply) i64 {
    var t: Reply = r;
    var out: i64 = 0;
    if (sel t.value && t.value > 3) { out = out + 1; }
    if (sel t.value && @(?t.value) > 3) { out = out + 10; }
    if (sel t.empty || (sel t.value && t.value == 1)) { out = out + 100; }
    ret out;
}

# a three-case tag: the exiting chain tests two cases and guards the third
fun three(t: Three) i64 {
    var v: Three = t;
    if (sel v.a) { ret -1; }
    or (sel v.c) { ret v.c::i64; }
    v.b = v.b + 1;
    val p: *i64 = ?v.b;
    ret @p;
}

# nested guards: the inner payload under the outer arm and an inner exiting chain
fun nested(o: Outer) i64 {
    var v: Outer = o;
    if (sel v.inner) {
        if (!sel v.inner.value) { ret -1; }
        v.inner.value = v.inner.value + 1;
        val p: *i64 = ?v.inner.value;
        @p = @p + 100;
        ret v.inner.value;
    }
    ret -2;
}

# a pointer place: `sel p.value` reads through the pointer, and so does `(@p).value`
fun through(r: Reply) i64 {
    var t: Reply = r;
    val p: *Reply = ?t;
    var out: i64 = 0;
    if (sel p.value) { p.value = p.value + 1; out = out + p.value; }
    if (sel (@p).value) { out = out + (@p).value; }
    ret out;
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: i64 = seed::i64 + 41;

    h = fold.mix_i64(h, arm(make(s)));
    h = fold.mix_i64(h, arm(Reply.empty{}));
    h = fold.mix_i64(h, chain_ret(make(s)));
    h = fold.mix_i64(h, chain_ret(Reply.empty{}));
    h = fold.mix_i64(h, chain_brk(make(s)));
    h = fold.mix_i64(h, chain_brk(Reply.empty{}));

    var a: [4]Reply;
    a[0] = make(1);
    a[2] = make(2 + s);
    h = fold.mix_i64(h, chain_cnt(a));

    h = fold.mix_i64(h, andop(make(s)));
    h = fold.mix_i64(h, andop(make(1)));
    h = fold.mix_i64(h, andop(Reply.empty{}));

    h = fold.mix_i64(h, three(Three.b{5 + s}));
    h = fold.mix_i64(h, three(Three.c{9}));
    h = fold.mix_i64(h, three(Three.a{}));

    h = fold.mix_i64(h, nested(Outer.inner{make(s)}));
    h = fold.mix_i64(h, nested(Outer.inner{Reply.empty{}}));
    h = fold.mix_i64(h, nested(Outer.none{}));

    h = fold.mix_i64(h, through(make(s)));
    h = fold.mix_i64(h, through(Reply.empty{}));

    # `sel` is an ordinary value of the boolean width and can be bound
    val done: u8 = sel a[2].value;
    if (done != 0) { h = fold.mix_u8(h, 1); } or { h = fold.mix_u8(h, 0); }
    ret h;
}
