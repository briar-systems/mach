# a secret payload under a public discriminator: the public case is tested with
# `sel`, the secret payload is read under its guard and stripped with `:>`
# before any arithmetic (this case is about storage and carriers, so no body
# is `#[oblivious]`), an outer-secret tag is copied whole and stripped
# back to its public type, and the tag crosses a call and a return with its
# payload secret. the C reference has no secrecy, so the checksum is exactly
# the public computation the qualifiers must not change.

use corpus.lib.fold;

tag SecretReply: u8 {
    failed: i32;
    value: ^u64;
}

fun make(v: u64) SecretReply {
    ret SecretReply.value{v};
}

fun bump(r: SecretReply) SecretReply {
    if (sel r.value) { ret SecretReply.value{(r.value:>u64) + 1}; }
    ret SecretReply.failed{-1};
}

fun public_of(r: SecretReply) u64 {
    if (sel r.failed) { ret r.failed:~u32::u64; }
    ret r.value:>u64;
}

fun copy_whole(v: ^SecretReply) ^SecretReply {
    val u: ^SecretReply = v;
    ret u;
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();

    var r: SecretReply;
    h = fold.mix_u64(h, public_of(r));
    r = make(1000 + seed);
    h = fold.mix_u64(h, public_of(r));
    r = bump(r);
    h = fold.mix_u64(h, public_of(r));
    if (sel r.value) {
        # the arithmetic is public: assigning an expression to a secret place types it
        # against the destination, and secret arithmetic needs `#[oblivious]`
        val open: u64 = (r.value:>u64) * 3;
        r.value = open;
    }
    h = fold.mix_u64(h, public_of(r));
    r = SecretReply.failed{-7 - seed::i32};
    h = fold.mix_u64(h, public_of(r));
    h = fold.mix_u64(h, public_of(bump(r)));

    # an outer-secret tag copies by its fixed extent; stripping restores the public view
    val hidden: ^SecretReply = make(5 + seed);
    val back: SecretReply = copy_whole(hidden):>SecretReply;
    h = fold.mix_u64(h, public_of(back));
    ret h;
}
