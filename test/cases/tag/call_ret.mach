# tags passed and returned by value at the sizes that cross each convention's
# register boundaries: 1, 3, 8, 9, 16 and 24 bytes, a float payload in its own
# eightbyte, a mixed float and integer payload set, a nested tag, three tags in
# one call with a trailing scalar, and a tag reached through a pointer parameter.
# every callee returns a value derived from every payload byte it received, so
# a carrier that drops or shifts logical bytes moves the checksum.

use corpus.lib.fold;

tag P1: u8 { a; b; }
tag T3: u8 { a; b: [2]u8; }
tag S8: u8 { a; b: u32; }
tag T9: u8 { a; b: [8]u8; }
tag T16: u8 { a; b: i64; }
tag O24: u8 { a; b: [2]i64; c: u8; }
tag TF16: u8 { a; b: f64; }
tag TF8: u8 { a; b: f32; }
tag TFM: u8 { a; b: f64; c: i64; }
tag Nest: u8 { a; b: S8; }

fun flip_p1(v: P1) P1 {
    if (sel v.a) { ret P1.b{}; }
    ret P1.a{};
}

fun bump_t3(v: T3) T3 {
    if (sel v.b) { ret T3.b{[2]u8{v.b[1] + 1, v.b[0] + 2}}; }
    ret T3.b{[2]u8{1, 2}};
}

fun bump_s8(v: S8) S8 {
    if (sel v.b) { ret S8.b{v.b * 3}; }
    ret v;
}

fun sum_t9(v: T9) u64 {
    if (!sel v.b) { ret 0; }
    var acc: u64 = 0;
    var i: u64 = 0;
    for (i < 8) {
        acc = acc * 31 + v.b[i]::u64;
        i = i + 1;
    }
    ret acc;
}

fun rot_t9(v: T9) T9 {
    if (!sel v.b) { ret v; }
    var out: [8]u8;
    var i: u64 = 0;
    for (i < 8) {
        out[i] = v.b[(i + 1) & 7];
        i = i + 1;
    }
    ret T9.b{out};
}

fun bump_t16(v: T16) T16 {
    if (sel v.b) { ret T16.b{v.b + 1}; }
    ret T16.b{-1};
}

fun sum_o24(v: O24) i64 {
    var out: i64 = -1;
    if (sel v.b) { out = v.b[0] * 7 + v.b[1]; }
    or (sel v.c) { out = v.c::i64; }
    ret out;
}

fun swap_o24(v: O24) O24 {
    if (sel v.b) { ret O24.b{[2]i64{v.b[1], v.b[0]}}; }
    ret O24.c{200};
}

fun half_tf16(v: TF16) TF16 {
    if (sel v.b) { ret TF16.b{v.b * 0.5}; }
    ret TF16.b{1.0};
}

fun double_tf8(v: TF8) TF8 {
    if (sel v.b) { ret TF8.b{v.b * 2.0}; }
    ret TF8.b{0.25};
}

fun cross_tfm(v: TFM) TFM {
    var out: TFM = v;
    if (sel v.b) { out = TFM.c{v.b::i64}; }
    or (sel v.c) { out = TFM.b{v.c::f64 + 0.5}; }
    ret out;
}

fun nest_of(v: Nest) u32 {
    var out: u32 = 0;
    if (sel v.b) {
        out = 1;
        if (sel v.b.b) { out = v.b.b + 1; }
    }
    ret out;
}

fun three(x: T16, y: T9, z: O24, k: u64) T16 {
    var acc: i64 = k::i64;
    if (sel x.b) { acc = acc + x.b; }
    acc = acc + sum_t9(y)::i64;
    acc = acc + sum_o24(z);
    ret T16.b{acc};
}

fun poke(p: *T16, by: i64) {
    if (sel p.b) { p.b = p.b + by; }
    or { @p = T16.b{by}; }
}

fun fold_t3(h: u64, v: T3) u64 {
    if (sel v.b) { ret fold.mix_u8(fold.mix_u8(h, v.b[0]), v.b[1]); }
    ret fold.mix_u8(h, 255);
}

fun fold_s8(h: u64, v: S8) u64 {
    if (sel v.b) { ret fold.mix_u32(h, v.b); }
    ret fold.mix_u32(h, 4294967295);
}

fun fold_t16(h: u64, v: T16) u64 {
    if (sel v.b) { ret fold.mix_i64(h, v.b); }
    ret fold.mix_i64(h, -2);
}

fun fold_tf16(h: u64, v: TF16) u64 {
    if (sel v.b) { ret fold.mix_f64(h, v.b); }
    ret fold.mix_u8(h, 0);
}

fun fold_tf8(h: u64, v: TF8) u64 {
    if (sel v.b) { ret fold.mix_f32(h, v.b); }
    ret fold.mix_u8(h, 0);
}

fun fold_tfm(h: u64, v: TFM) u64 {
    var out: u64 = fold.mix_u8(h, 0);
    if (sel v.b) { out = fold.mix_f64(h, v.b); }
    or (sel v.c) { out = fold.mix_i64(h, v.c); }
    ret out;
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: u8 = seed::u8;
    val si: i64 = seed::i64;

    var p: P1 = flip_p1(P1.a{});
    if (sel p.b) { h = fold.mix_u8(h, 1); } or { h = fold.mix_u8(h, 0); }
    p = flip_p1(p);
    if (sel p.b) { h = fold.mix_u8(h, 1); } or { h = fold.mix_u8(h, 0); }

    var t3: T3 = bump_t3(T3.a{});
    h = fold_t3(h, t3);
    t3 = bump_t3(T3.b{[2]u8{10 + s, 20 + s}});
    h = fold_t3(h, t3);

    var s8: S8 = bump_s8(S8.b{1000 + seed::u32});
    h = fold_s8(h, s8);
    h = fold_s8(h, bump_s8(S8.a{}));

    var t9: T9 = T9.b{[8]u8{1 + s, 2, 3, 4, 5, 6, 7, 8}};
    h = fold.mix_u64(h, sum_t9(t9));
    t9 = rot_t9(t9);
    h = fold.mix_u64(h, sum_t9(t9));
    h = fold.mix_u64(h, sum_t9(T9.a{}));

    var t16: T16 = bump_t16(T16.b{123456789 + si});
    h = fold_t16(h, t16);
    h = fold_t16(h, bump_t16(T16.a{}));

    var o24: O24 = O24.b{[2]i64{3 + si, 4}};
    h = fold.mix_i64(h, sum_o24(o24));
    o24 = swap_o24(o24);
    h = fold.mix_i64(h, sum_o24(o24));
    o24 = swap_o24(O24.a{});
    h = fold.mix_i64(h, sum_o24(o24));
    h = fold.mix_i64(h, sum_o24(O24.a{}));

    var tf16: TF16 = half_tf16(TF16.b{5.0 + si::f64});
    h = fold_tf16(h, tf16);
    h = fold_tf16(h, half_tf16(TF16.a{}));
    var tf8: TF8 = double_tf8(TF8.b{1.25 + si::f32});
    h = fold_tf8(h, tf8);
    h = fold_tf8(h, double_tf8(TF8.a{}));
    var tfm: TFM = cross_tfm(TFM.b{9.0 + si::f64});
    h = fold_tfm(h, tfm);
    tfm = cross_tfm(tfm);
    h = fold_tfm(h, tfm);
    h = fold_tfm(h, cross_tfm(TFM.a{}));

    h = fold.mix_u32(h, nest_of(Nest.b{S8.b{77 + seed::u32}}));
    h = fold.mix_u32(h, nest_of(Nest.b{S8.a{}}));
    h = fold.mix_u32(h, nest_of(Nest.a{}));

    h = fold_t16(h, three(t16, t9, o24, 5 + seed));
    h = fold_t16(h, three(T16.a{}, T9.a{}, O24.a{}, seed));

    var q: T16 = T16.a{};
    poke(?q, 40 + si);
    h = fold_t16(h, q);
    poke(?q, 2);
    h = fold_t16(h, q);
    ret h;
}
