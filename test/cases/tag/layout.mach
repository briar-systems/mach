# the checked layout of natural, packed and over-aligned tags with u8, u16 and u32
# discriminators, folded as sizes, alignments and offsets against the C layout of
# the same shape, then exercised through construction, reads and writes so that a
# payload placed at the wrong offset moves a value and not only a number.

use corpus.lib.fold;

tag Reply: u8 {
    empty;
    value: i64;
}

tag Wide: u16 {
    none;
    small: u8;
    big: u64;
}

tag Quad: u32 {
    none;
    pair: [2]u16;
    word: u32;
}

#[packed]
tag Packed: u8 {
    none;
    value: u64;
}

#[align(16)]
tag Aligned: u8 {
    none;
    value: u8;
}

tag Float: u8 {
    none;
    half: f32;
    full: f64;
}

fun wide_of(w: Wide) u64 {
    var out: u64 = 0;
    if (sel w.small) { out = w.small::u64; }
    or (sel w.big) { out = w.big; }
    ret out;
}

fun quad_of(q: Quad) u32 {
    var out: u32 = 0;
    if (sel q.pair) { out = (q.pair[0]::u32 << 16) | q.pair[1]::u32; }
    or (sel q.word) { out = q.word; }
    ret out;
}

fun packed_of(p: Packed) u64 {
    if (sel p.value) { ret p.value; }
    ret 0;
}

fun aligned_of(a: Aligned) u8 {
    if (sel a.value) { ret a.value; }
    ret 0;
}

fun float_of(h: u64, f: Float) u64 {
    var out: u64 = fold.mix_u8(h, 0);
    if (sel f.half) { out = fold.mix_f32(h, f.half); }
    or (sel f.full) { out = fold.mix_f64(h, f.full); }
    ret out;
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: u32 = seed::u32;

    h = fold.mix_u64(h, $size_of(Reply));
    h = fold.mix_u64(h, $align_of(Reply));
    h = fold.mix_u64(h, $offset_of(Reply, value));
    h = fold.mix_u64(h, $size_of($discriminant_of(Reply)));
    h = fold.mix_u64(h, $size_of(Wide));
    h = fold.mix_u64(h, $align_of(Wide));
    h = fold.mix_u64(h, $offset_of(Wide, small));
    h = fold.mix_u64(h, $offset_of(Wide, big));
    h = fold.mix_u64(h, $size_of($discriminant_of(Wide)));
    h = fold.mix_u64(h, $size_of(Quad));
    h = fold.mix_u64(h, $align_of(Quad));
    h = fold.mix_u64(h, $offset_of(Quad, pair));
    h = fold.mix_u64(h, $offset_of(Quad, word));
    h = fold.mix_u64(h, $size_of($discriminant_of(Quad)));
    h = fold.mix_u64(h, $size_of(Packed));
    h = fold.mix_u64(h, $align_of(Packed));
    h = fold.mix_u64(h, $offset_of(Packed, value));
    h = fold.mix_u64(h, $size_of(Aligned));
    h = fold.mix_u64(h, $align_of(Aligned));
    h = fold.mix_u64(h, $offset_of(Aligned, value));
    h = fold.mix_u64(h, $size_of(Float));
    h = fold.mix_u64(h, $align_of(Float));
    h = fold.mix_u64(h, $offset_of(Float, half));
    h = fold.mix_u64(h, $offset_of(Float, full));

    var w: Wide;
    h = fold.mix_u64(h, wide_of(w));
    w = Wide.small{(3 + s)::u8};
    h = fold.mix_u64(h, wide_of(w));
    w = Wide.big{4041206221 + seed};
    h = fold.mix_u64(h, wide_of(w));
    if (sel w.big) { w.big = w.big ^ 65535; }
    h = fold.mix_u64(h, wide_of(w));

    var q: Quad;
    h = fold.mix_u32(h, quad_of(q));
    q = Quad.pair{[2]u16{(5 + s)::u16, (6 + s)::u16}};
    h = fold.mix_u32(h, quad_of(q));
    if (sel q.pair) { q.pair[1] = q.pair[1] + 256; }
    h = fold.mix_u32(h, quad_of(q));
    q = Quad.word{3735928559 + s};
    h = fold.mix_u32(h, quad_of(q));

    # packed storage: an unaligned payload written and read in place
    var p: Packed;
    h = fold.mix_u64(h, packed_of(p));
    p = Packed.value{81985529216486895 + seed};
    h = fold.mix_u64(h, packed_of(p));
    if (sel p.value) { p.value = p.value + 1; }
    h = fold.mix_u64(h, packed_of(p));
    val pc: Packed = p;
    h = fold.mix_u64(h, packed_of(pc));

    var al: Aligned;
    h = fold.mix_u8(h, aligned_of(al));
    al = Aligned.value{(9 + s)::u8};
    h = fold.mix_u8(h, aligned_of(al));
    val ac: Aligned = al;
    h = fold.mix_u8(h, aligned_of(ac));

    var f: Float;
    h = float_of(h, f);
    f = Float.half{1.5 + s::f32};
    h = float_of(h, f);
    f = Float.full{-2.25 + s::f64};
    h = float_of(h, f);
    ret h;
}
