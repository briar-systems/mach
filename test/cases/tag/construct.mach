# construction of every case form, the zero default, replacement by a payloadless
# case, a payload write under a guard, an alias declared with `def`, an identity
# cast and the RHS-first rule of a replacement that reads the old payload. every
# selected case and payload is folded so a wrong code or a stale payload moves
# the checksum.

use corpus.lib.fold;

tag Reply: u8 {
    empty;
    value: i64;
}

tag Flag: u8 {
    off;
    on;
}

def R: Reply;

fun value_of(r: Reply) i64 {
    if (sel r.value) { ret r.value; }
    ret -1;
}

fun is_empty(r: Reply) u8 {
    if (sel r.empty) { ret 1; }
    ret 0;
}

fun flag_code(f: Flag) u8 {
    if (sel f.on) { ret 1; }
    ret 0;
}

fun fold_reply(h: u64, r: Reply) u64 {
    var x: u64 = fold.mix_u8(h, is_empty(r));
    x = fold.mix_i64(x, value_of(r));
    ret x;
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: i64 = seed::i64;

    # the zero default selects the first case with a zero payload
    var r: Reply;
    h = fold_reply(h, r);

    r = Reply.value{40 + s};
    h = fold_reply(h, r);

    # a payload write under an arm guard keeps the case
    if (sel r.value) { r.value = r.value * 2; }
    h = fold_reply(h, r);

    # a replacement reads the old payload before the destination is overwritten
    r = Reply.value{value_of(r) + 1};
    h = fold_reply(h, r);

    # replacement by a payloadless case
    r = Reply.empty{};
    h = fold_reply(h, r);

    # the alias constructs and tests as the tag it names
    var a: R = R.value{7 + s};
    h = fold_reply(h, a);
    val c: Reply = a::Reply;
    h = fold_reply(h, c);
    a = R.empty{};
    h = fold_reply(h, a);

    # a payloadless tag is only its discriminator
    var f: Flag;
    h = fold.mix_u8(h, flag_code(f));
    f = Flag.on{};
    h = fold.mix_u8(h, flag_code(f));
    val g: Flag = f;
    f = Flag.off{};
    h = fold.mix_u8(h, flag_code(f));
    h = fold.mix_u8(h, flag_code(g));

    # a copy carries the case and payload, and the source is unchanged by a write to the copy
    var d: Reply = Reply.value{100 + s};
    var e: Reply = d;
    if (sel e.value) { e.value = e.value + 5; }
    h = fold_reply(h, d);
    h = fold_reply(h, e);
    ret h;
}
