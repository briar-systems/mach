# arrays of tags: zero-initialized elements, element replacement through a
# runtime index, a payload write through an index, a whole-array copy, an array
# held in a record and passed by value, and a count of the selected cases. the
# fold walks every element in order, so a stride computed from the wrong size
# or a discriminator written into a neighbour moves the checksum.

use corpus.lib.fold;

tag Reply: u8 {
    empty;
    value: i64;
}

tag Small: u16 {
    none;
    byte: u8;
    pair: [2]u8;
}

rec Bag {
    count: u32;
    items: [5]Reply;
}

fun reply_of(r: Reply) i64 {
    if (sel r.value) { ret r.value; }
    ret -1;
}

fun small_of(v: Small) u32 {
    var out: u32 = 65535;
    if (sel v.byte) { out = v.byte::u32; }
    or (sel v.pair) { out = (v.pair[0]::u32 << 8) | v.pair[1]::u32; }
    ret out;
}

fun fold_bag(h: u64, b: Bag) u64 {
    var x: u64 = fold.mix_u32(h, b.count);
    var i: u64 = 0;
    for (i < 5) {
        x = fold.mix_i64(x, reply_of(b.items[i]));
        i = i + 1;
    }
    ret x;
}

fun selected(b: Bag) u32 {
    var n: u32 = 0;
    var i: u64 = 0;
    for (i < 5) {
        if (sel b.items[i].value) { n = n + 1; }
        i = i + 1;
    }
    ret n;
}

fun fold_smalls(h: u64, a: [3]Small) u64 {
    var x: u64 = h;
    var i: u64 = 0;
    for (i < 3) {
        x = fold.mix_u32(x, small_of(a[i]));
        i = i + 1;
    }
    ret x;
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: i64 = seed::i64;

    var b: Bag;
    h = fold_bag(h, b);
    h = fold.mix_u32(h, selected(b));

    # every other element replaced through a runtime index
    var i: u64 = seed;
    for (i < 5) {
        b.items[i] = Reply.value{s + i::i64 * 10};
        i = i + 2;
    }
    b.count = selected(b);
    h = fold_bag(h, b);

    # a payload write through an index under its guard, and a replacement back to empty
    if (sel b.items[2].value) { b.items[2].value = b.items[2].value + 7; }
    b.items[4] = Reply.empty{};
    b.count = selected(b);
    h = fold_bag(h, b);

    # a whole-array copy carries every element; the source is untouched by writes to the copy
    var copy: [5]Reply = b.items;
    copy[0] = Reply.value{-5};
    if (sel copy[2].value) { copy[2].value = 0; }
    var c: Bag = Bag{count: selected(b), items: copy};
    h = fold_bag(h, b);
    h = fold_bag(h, c);

    # the record with the array is passed and returned by value
    val d: Bag = c;
    h = fold_bag(h, d);

    # a wider discriminator with a small payload: stride is the tag's size, not the payload's
    var sm: [3]Small;
    h = fold_smalls(h, sm);
    sm[0] = Small.byte{(3 + seed)::u8};
    sm[1] = Small.pair{[2]u8{(4 + seed)::u8, 5}};
    sm[2] = Small.byte{6};
    h = fold_smalls(h, sm);
    if (sel sm[1].pair) { sm[1].pair[1] = sm[1].pair[1] + 1; }
    sm[2] = Small.none{};
    h = fold_smalls(h, sm);
    ret h;
}
