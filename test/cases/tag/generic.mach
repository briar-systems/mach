# one generic tag instantiated at a byte, a 64-bit integer, a double, a record
# and at itself, each constructed, tested, read and replaced through the same
# source. the C reference spells each instantiation by hand, so a specialization
# that shares a layout it should not, or misplaces a payload of a different
# alignment, moves the checksum.

use corpus.lib.fold;

tag Box[T]: u8 {
    none;
    some: T;
}

rec Pair {
    a: u32;
    b: u16;
}

fun byte_of(b: Box[u8]) u8 {
    if (sel b.some) { ret b.some; }
    ret 255;
}

fun long_of(b: Box[i64]) i64 {
    if (sel b.some) { ret b.some; }
    ret -1;
}

fun real_of(h: u64, b: Box[f64]) u64 {
    if (sel b.some) { ret fold.mix_f64(h, b.some); }
    ret fold.mix_u8(h, 0);
}

fun pair_of(b: Box[Pair]) u32 {
    if (sel b.some) { ret b.some.a * 1000 + b.some.b::u32; }
    ret 0;
}

fun deep_of(b: Box[Box[i64]]) i64 {
    if (sel b.some) { ret long_of(b.some) + 1000000; }
    ret -2;
}

fun bump_long(b: Box[i64]) Box[i64] {
    if (sel b.some) { ret Box[i64].some{b.some + 1}; }
    ret Box[i64].some{0};
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: i64 = seed::i64;

    var bb: Box[u8];
    h = fold.mix_u8(h, byte_of(bb));
    bb = Box[u8].some{(7 + seed)::u8};
    h = fold.mix_u8(h, byte_of(bb));
    if (sel bb.some) { bb.some = bb.some * 2; }
    h = fold.mix_u8(h, byte_of(bb));
    bb = Box[u8].none{};
    h = fold.mix_u8(h, byte_of(bb));

    var bl: Box[i64];
    h = fold.mix_i64(h, long_of(bl));
    bl = Box[i64].some{1234567890123 + s};
    h = fold.mix_i64(h, long_of(bl));
    bl = bump_long(bl);
    h = fold.mix_i64(h, long_of(bl));
    h = fold.mix_i64(h, long_of(bump_long(Box[i64].none{})));

    var br: Box[f64];
    h = real_of(h, br);
    br = Box[f64].some{2.5 + s::f64};
    h = real_of(h, br);
    if (sel br.some) { br.some = br.some * -3.0; }
    h = real_of(h, br);

    var bp: Box[Pair];
    h = fold.mix_u32(h, pair_of(bp));
    bp = Box[Pair].some{Pair{a: 4 + seed::u32, b: 9}};
    h = fold.mix_u32(h, pair_of(bp));
    if (sel bp.some) { bp.some.b = bp.some.b + 1; }
    h = fold.mix_u32(h, pair_of(bp));

    var bd: Box[Box[i64]];
    h = fold.mix_i64(h, deep_of(bd));
    bd = Box[Box[i64]].some{bl};
    h = fold.mix_i64(h, deep_of(bd));
    bd = Box[Box[i64]].some{Box[i64].none{}};
    h = fold.mix_i64(h, deep_of(bd));
    if (sel bd.some) { bd.some = Box[i64].some{42 + s}; }
    h = fold.mix_i64(h, deep_of(bd));

    h = fold.mix_u64(h, $size_of(Box[u8]));
    h = fold.mix_u64(h, $size_of(Box[i64]));
    h = fold.mix_u64(h, $size_of(Box[f64]));
    h = fold.mix_u64(h, $size_of(Box[Pair]));
    h = fold.mix_u64(h, $size_of(Box[Box[i64]]));
    h = fold.mix_u64(h, $align_of(Box[Pair]));
    ret h;
}
