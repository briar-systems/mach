# f32<->u32 and f64<->u64 round trips through the bit-reinterpret cast, plus a
# couple of ordinary float constants, so a lowering that routes the bits
# through an FP conversion instead of a plain move changes the bit pattern.

use corpus.lib.fold;

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();

    val s32: u32 = (seed::u32) ^ 3226013659;
    val f: f32 = s32:~f32;
    val back32: u32 = f:~u32;
    h = fold.mix_u32(h, s32);
    h = fold.mix_f32(h, f);
    h = fold.mix_u32(h, back32);

    val s64: u64 = seed ^ 4614256656552045848;
    val d: f64 = s64:~f64;
    val back64: u64 = d:~u64;
    h = fold.mix_u64(h, s64);
    h = fold.mix_f64(h, d);
    h = fold.mix_u64(h, back64);

    val pi: f32 = 3.14159265;
    val pi_bits: u32 = pi:~u32;
    val pi_back: f32 = pi_bits:~f32;
    h = fold.mix_u32(h, pi_bits);
    h = fold.mix_f32(h, pi_back);

    val e: f64 = 2.718281828459045;
    val e_bits: u64 = e:~u64;
    val e_back: f64 = e_bits:~f64;
    h = fold.mix_u64(h, e_bits);
    h = fold.mix_f64(h, e_back);

    ret h;
}
