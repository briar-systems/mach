# f32<->f64 both directions, values that lose precision crossing the cut:
# one ULP above 1.0f, a decimal that is inexact in either width, the first
# integer f32 cannot represent exactly (2^24 + 1), and a magnitude near the
# f32 range limit widened exactly. then NaN payloads crossing the cut, once
# from the opaque seed and once folded at compile time: a NaN keeps its sign
# and the top of its payload with the quiet bit set, and the folded
# conversion gives the bits the runtime one does.

use corpus.lib.fold;

val NAN_SNAN: f64 = 0x7FF4000000000001::u64:~f64;
val NAN_NEG:  f64 = 0xFFF8040000000000::u64:~f64;
val NAN_LOW:  f64 = 0x7FF0000020000000::u64:~f64;
val NAN_F32:  f32 = 0x7FA00001::u32:~f32;

val FOLD_SNAN:  f32 = NAN_SNAN::f32;
val FOLD_NEG:   f32 = NAN_NEG::f32;
val FOLD_LOW:   f32 = NAN_LOW::f32;
val FOLD_WIDE:  f64 = NAN_F32::f64;
val FOLD_HALF:  f32 = 0x7F55::u16:~f16::f32;

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val z: f64 = seed::f64;
    val zf: f32 = seed::f32;

    val d1: f64 = 1.0000000596046448 + z;
    val f1: f32 = d1::f32;
    val d1b: f64 = f1::f64;
    h = fold.mix_f64(h, d1);
    h = fold.mix_f32(h, f1);
    h = fold.mix_f64(h, d1b);

    val d2: f64 = 0.1 + z;
    val f2: f32 = d2::f32;
    val d2b: f64 = f2::f64;
    h = fold.mix_f64(h, d2);
    h = fold.mix_f32(h, f2);
    h = fold.mix_f64(h, d2b);

    val d3: f64 = 16777217.0 + z;
    val f3: f32 = d3::f32;
    h = fold.mix_f64(h, d3);
    h = fold.mix_f32(h, f3);

    val f4: f32 = 3.4028235e38 + zf;
    val d4: f64 = f4::f64;
    h = fold.mix_f32(h, f4);
    h = fold.mix_f64(h, d4);

    # a signaling NaN, a negative quiet NaN, and one whose payload lies only in
    # the bits binary32 drops
    h = fold.mix_u32(h, (0x7FF4000000000001 + seed):~f64::f32:~u32);
    h = fold.mix_u32(h, (0xFFF8040000000000 + seed):~f64::f32:~u32);
    h = fold.mix_u32(h, (0x7FF0000020000000 + seed):~f64::f32:~u32);
    h = fold.mix_u64(h, (0x7FA00001 + seed::u32):~f32::f64:~u64);
    h = fold.mix_u32(h, (0x7F55 + seed::u16):~f16::f32:~u32);

    val s32: u32 = seed::u32;
    h = fold.mix_u32(h, (FOLD_SNAN:~u32) + s32);
    h = fold.mix_u32(h, (FOLD_NEG:~u32) + s32);
    h = fold.mix_u32(h, (FOLD_LOW:~u32) + s32);
    h = fold.mix_u64(h, (FOLD_WIDE:~u64) + seed);
    h = fold.mix_u32(h, (FOLD_HALF:~u32) + s32);

    ret h;
}
