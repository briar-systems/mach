# f32<->f64 both directions, values that lose precision crossing the cut:
# one ULP above 1.0f, a decimal that is inexact in either width, the first
# integer f32 cannot represent exactly (2^24 + 1), and a magnitude near the
# f32 range limit widened exactly.

use corpus.lib.fold;

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val z: f64 = seed::f64;
    val zf: f32 = seed::f32;

    val d1: f64 = 1.0000000596046448 + z;
    val f1: f32 = d1::f32;
    val d1b: f64 = f1::f64;
    h = fold.mix_f64(h, d1);
    h = fold.mix_f32(h, f1);
    h = fold.mix_f64(h, d1b);

    val d2: f64 = 0.1 + z;
    val f2: f32 = d2::f32;
    val d2b: f64 = f2::f64;
    h = fold.mix_f64(h, d2);
    h = fold.mix_f32(h, f2);
    h = fold.mix_f64(h, d2b);

    val d3: f64 = 16777217.0 + z;
    val f3: f32 = d3::f32;
    h = fold.mix_f64(h, d3);
    h = fold.mix_f32(h, f3);

    val f4: f32 = 3.4028235e38 + zf;
    val d4: f64 = f4::f64;
    h = fold.mix_f32(h, f4);
    h = fold.mix_f64(h, d4);

    ret h;
}
