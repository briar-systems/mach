# every signed widening pair, opaque operands with the top bit set so a
# lowering that zero-extends where it must sign-extend drops the sign.

use corpus.lib.fold;

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();

    val a8: i8 = ((seed::u8) | 128):~i8;
    val b8: i8 = ~a8;
    val a16: i16 = ((seed::u16) | 32768):~i16;
    val b16: i16 = ~a16;
    val a32: i32 = ((seed::u32) | 2147483648):~i32;
    val b32: i32 = ~a32;

    h = fold.mix_i16(h, a8::i16);
    h = fold.mix_i16(h, b8::i16);
    h = fold.mix_i32(h, a8::i32);
    h = fold.mix_i32(h, b8::i32);
    h = fold.mix_i64(h, a8::i64);
    h = fold.mix_i64(h, b8::i64);

    h = fold.mix_i32(h, a16::i32);
    h = fold.mix_i32(h, b16::i32);
    h = fold.mix_i64(h, a16::i64);
    h = fold.mix_i64(h, b16::i64);

    h = fold.mix_i64(h, a32::i64);
    h = fold.mix_i64(h, b32::i64);

    h = fold.mix_i64(h, (a8::i64) + (a16::i64) + (a32::i64));
    h = fold.mix_i64(h, (b8::i64) + (b16::i64) + (b32::i64));

    ret h;
}
