# every int->float pair, values with the top bit set on the widest widths so
# unsigned/signed 64-bit to float conversion (the case a signed-only hardware
# CVT instruction gets wrong without a correction) is exercised, not just the
# small-magnitude values every width converts trivially.

use corpus.lib.fold;

fun fold_from(h: u64, u8v: u8, u16v: u16, u32v: u32, u64v: u64, i8v: i8, i16v: i16, i32v: i32, i64v: i64) u64 {
    var a: u64 = fold.mix_f32(h, u8v::f32);
    a = fold.mix_f64(a, u8v::f64);
    a = fold.mix_f32(a, u16v::f32);
    a = fold.mix_f64(a, u16v::f64);
    a = fold.mix_f32(a, u32v::f32);
    a = fold.mix_f64(a, u32v::f64);
    a = fold.mix_f32(a, u64v::f32);
    a = fold.mix_f64(a, u64v::f64);
    a = fold.mix_f32(a, i8v::f32);
    a = fold.mix_f64(a, i8v::f64);
    a = fold.mix_f32(a, i16v::f32);
    a = fold.mix_f64(a, i16v::f64);
    a = fold.mix_f32(a, i32v::f32);
    a = fold.mix_f64(a, i32v::f64);
    a = fold.mix_f32(a, i64v::f32);
    a = fold.mix_f64(a, i64v::f64);
    ret a;
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();

    val u8v: u8 = (seed::u8) | 128;
    val i8v: i8 = u8v:~i8;
    val u16v: u16 = (seed::u16) | 32768;
    val i16v: i16 = u16v:~i16;
    val u32v: u32 = (seed::u32) | 2147483648;
    val i32v: i32 = u32v:~i32;
    val u64v: u64 = seed | 9223372036854775808;
    val i64v: i64 = u64v:~i64;

    h = fold_from(h, u8v, u16v, u32v, u64v, i8v, i16v, i32v, i64v);

    val small_u64: u64 = seed | 1;
    val small_i64: i64 = 0 - (small_u64::i64);
    h = fold.mix_f32(h, small_u64::f32);
    h = fold.mix_f64(h, small_u64::f64);
    h = fold.mix_f32(h, small_i64::f32);
    h = fold.mix_f64(h, small_i64::f64);

    ret h;
}
