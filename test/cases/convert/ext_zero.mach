# every unsigned widening pair, opaque operands with the top bit set so a
# lowering that reads a stale high half, or sign-extends where it must
# zero-extend, changes the checksum.

use corpus.lib.fold;

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();

    val a8: u8 = (seed::u8) | 128;
    val b8: u8 = 255 - a8;
    val a16: u16 = (seed::u16) | 32768;
    val b16: u16 = 65535 - a16;
    val a32: u32 = (seed::u32) | 2147483648;
    val b32: u32 = 4294967295 - a32;

    h = fold.mix_u16(h, a8::u16);
    h = fold.mix_u16(h, b8::u16);
    h = fold.mix_u32(h, a8::u32);
    h = fold.mix_u32(h, b8::u32);
    h = fold.mix_u64(h, a8::u64);
    h = fold.mix_u64(h, b8::u64);

    h = fold.mix_u32(h, a16::u32);
    h = fold.mix_u32(h, b16::u32);
    h = fold.mix_u64(h, a16::u64);
    h = fold.mix_u64(h, b16::u64);

    h = fold.mix_u64(h, a32::u64);
    h = fold.mix_u64(h, b32::u64);

    h = fold.mix_u64(h, (a8::u64) + (a16::u64) + (a32::u64));
    h = fold.mix_u64(h, (b8::u64) + (b16::u64) + (b32::u64));

    ret h;
}
