# every float->int pair, in-range values so truncation toward zero is
# well-defined on both sides. a positive value exercises every width; a
# negative value exercises the signed widths only, since a negative float
# converted to an unsigned int is undefined behavior in the C mapping. a
# fractional value near zero exercises the truncation-toward-zero edge mach
# defines for the conversion.

use corpus.lib.fold;

fun fold_pos(h: u64, p: f32, q: f64) u64 {
    var a: u64 = fold.mix_u8(h, p::u8);
    a = fold.mix_u16(a, p::u16);
    a = fold.mix_u32(a, p::u32);
    a = fold.mix_u64(a, p::u64);
    a = fold.mix_i8(a, p::i8);
    a = fold.mix_i16(a, p::i16);
    a = fold.mix_i32(a, p::i32);
    a = fold.mix_i64(a, p::i64);
    a = fold.mix_u8(a, q::u8);
    a = fold.mix_u16(a, q::u16);
    a = fold.mix_u32(a, q::u32);
    a = fold.mix_u64(a, q::u64);
    a = fold.mix_i8(a, q::i8);
    a = fold.mix_i16(a, q::i16);
    a = fold.mix_i32(a, q::i32);
    a = fold.mix_i64(a, q::i64);
    ret a;
}

fun fold_neg(h: u64, p: f32, q: f64) u64 {
    var a: u64 = fold.mix_i8(h, p::i8);
    a = fold.mix_i16(a, p::i16);
    a = fold.mix_i32(a, p::i32);
    a = fold.mix_i64(a, p::i64);
    a = fold.mix_i8(a, q::i8);
    a = fold.mix_i16(a, q::i16);
    a = fold.mix_i32(a, q::i32);
    a = fold.mix_i64(a, q::i64);
    ret a;
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val z32: f32 = seed::f32;
    val z64: f64 = seed::f64;

    val pos32: f32 = 40.75 + z32;
    val pos64: f64 = 40.75 + z64;
    h = fold_pos(h, pos32, pos64);

    val neg32: f32 = -40.75 - z32;
    val neg64: f64 = -40.75 - z64;
    h = fold_neg(h, neg32, neg64);

    val e1: f32 = 127.0 + z32;
    h = fold.mix_i8(h, e1::i8);
    val e2: f32 = 255.0 + z32;
    h = fold.mix_u8(h, e2::u8);
    val e3: f64 = 0.9999 + z64;
    h = fold.mix_u8(h, e3::u8);
    h = fold.mix_i8(h, e3::i8);
    val e4: f64 = -0.9999 - z64;
    h = fold.mix_i8(h, e4::i8);

    ret h;
}
