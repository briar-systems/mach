# float to unsigned at and above the signed boundary, which the rest of the convert
# group deliberately stays below. on x86-64 the conversion is a two-arm expansion
# around 2^31 and 2^63 (#2909) and only the arm below the boundary was ever reached.
#
# the boundary itself proves nothing: a bare signed convert of exactly 2^31 or 2^63
# yields the integer-indefinite value, which is the correct unsigned answer, so a
# probe there agrees with a broken lowering. every value above the boundary here is
# strictly above it, and the values below are kept as the positive control that the
# already-covered arm still answers the same.
#
# every constant is exactly representable in its source width, so truncation removes
# nothing and the answer is the value itself. the destination range holds it, which
# is what keeps the C mapping defined.

use corpus.lib.fold;

fun f32_u32(h: u64, p: f32) u64 { ret fold.mix_u32(h, p::u32); }
fun f64_u32(h: u64, q: f64) u64 { ret fold.mix_u32(h, q::u32); }
fun f32_u64(h: u64, p: f32) u64 { ret fold.mix_u64(h, p::u64); }
fun f64_u64(h: u64, q: f64) u64 { ret fold.mix_u64(h, q::u64); }

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val z32: f32 = seed::f32;
    val z64: f64 = seed::f64;

    # f32 -> u32. the spacing at 2^31 is 256, so the first value above it is 2^31+256
    h = f32_u32(h, 2147483520.0 + z32);
    h = f32_u32(h, 2147483648.0 + z32);
    h = f32_u32(h, 2147483904.0 + z32);
    h = f32_u32(h, 3221225472.0 + z32);
    h = f32_u32(h, 4294967040.0 + z32);

    # f64 -> u32, where every integer in the range is exact
    h = f64_u32(h, 2147483647.0 + z64);
    h = f64_u32(h, 2147483648.0 + z64);
    h = f64_u32(h, 2147483649.0 + z64);
    h = f64_u32(h, 3000000000.0 + z64);
    h = f64_u32(h, 4294967295.0 + z64);

    # f32 -> u64. the spacing at 2^63 is 2^40, so the first value above it is 2^63+2^40
    h = f32_u64(h, 4611686018427387904.0 + z32);
    h = f32_u64(h, 9223372036854775808.0 + z32);
    h = f32_u64(h, 9223373136366403584.0 + z32);
    h = f32_u64(h, 13835058055282163712.0 + z32);
    h = f32_u64(h, 18446742974197923840.0 + z32);

    # f64 -> u64. the spacing at 2^63 is 2048
    h = f64_u64(h, 9223372036854774784.0 + z64);
    h = f64_u64(h, 9223372036854775808.0 + z64);
    h = f64_u64(h, 9223372036854777856.0 + z64);
    h = f64_u64(h, 13835058055282163712.0 + z64);
    h = f64_u64(h, 18446744073709549568.0 + z64);

    ret h;
}
