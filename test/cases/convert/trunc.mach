# every narrowing pair, values whose bits above the cut differ from the bits
# kept, so a lowering that fails to drop the high part changes the checksum.

use corpus.lib.fold;

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();

    val v64: u64 = (seed ^ 1311768467463790320) | 1;
    val v32: u32 = v64::u32;
    val v16: u16 = v64::u16;
    val v8: u8 = v64::u8;

    h = fold.mix_u32(h, v32);
    h = fold.mix_u16(h, v16);
    h = fold.mix_u8(h, v8);

    val w32: u32 = v32 ^ 1431655765;
    val w16: u16 = w32::u16;
    val w8: u8 = w32::u8;

    h = fold.mix_u16(h, w16);
    h = fold.mix_u8(h, w8);

    val u16v: u16 = v16 ^ 21845;
    val u8v: u8 = u16v::u8;
    h = fold.mix_u8(h, u8v);

    h = fold.mix_u64(h, (v32::u64) + (v16::u64) + (v8::u64));
    h = fold.mix_u64(h, (w16::u64) + (w8::u64) + (u8v::u64));

    ret h;
}
