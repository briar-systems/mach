# every value here is computed twice, once as a compile-time constant the comptime
# evaluator folds and once from the opaque seed through codegen, and the two are
# folded in lockstep so a divergence at any step changes the checksum. this is the
# one group whose constant side is meant to fold: seed is zero at run time, so the
# two sides are equal by construction and an inequality is the evaluator and the
# backend disagreeing about the same expression.

use corpus.lib.fold;

val K0: u64 = 305419896;
val K1: u64 = K0 * 3 + 7;
val K2: u64 = (K1 << 13) ^ 0x0F0F0F0F0F;
val K3: u64 = K2 ^ (K2 >> 7);
val K4: u64 = K3 & 0xFFFFFFFF;
val K5: u64 = K4 * 2654435761;
val K6: u64 = K5 >> 17;
val K7: u64 = K6 + K4;

val F0: f64 = 1.0 / 3.0;
val F1: f64 = F0 * 7.0 - 2.0;
val F2: f64 = F1 / 1.1;
val F3: f64 = F2 * F2 + F0;

val G0: f32 = 1.0 / 3.0;
val G1: f32 = G0 * 7.0 - 2.0;
val G2: f32 = G1 / 1.1;
val G3: f32 = G2 * G2 + G0;

val TAPS: [6]u64 = [6]u64{1, 3, 7, 15, 31, 63};

val MODE_MIX: u8 = 0;
val MODE_ROT: u8 = 1;

# monomorphized per comptime argument: each instance compiles only its own arm.
# single-exit, because an early return out of a branch has no structured spir-v
# form and control flow is another group's surface
fun apply($mode: u8, n: u64) u64 {
    var r: u64 = 0;
    $if (mode == MODE_MIX) {
        r = (n ^ (n >> 29)) * 1099511628211;
    }
    $or (mode == MODE_ROT) {
        r = ((n << 17) | (n >> 47)) + 12345;
    }
    ret r;
}

# the same dispatch decided at run time, so both arms are emitted and selected
fun apply_rt(mode: u8, n: u64) u64 {
    var r: u64 = 0;
    if (mode == MODE_MIX) {
        r = (n ^ (n >> 29)) * 1099511628211;
    } or (mode == MODE_ROT) {
        r = ((n << 17) | (n >> 47)) + 12345;
    }
    ret r;
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();

    var r0: u64 = K0 + seed;
    var r1: u64 = r0 * 3 + 7;
    var r2: u64 = (r1 << 13) ^ 0x0F0F0F0F0F;
    var r3: u64 = r2 ^ (r2 >> 7);
    var r4: u64 = r3 & 0xFFFFFFFF;
    var r5: u64 = r4 * 2654435761;
    var r6: u64 = r5 >> 17;
    var r7: u64 = r6 + r4;

    h = fold.mix_u64(h, K0);
    h = fold.mix_u64(h, r0);
    h = fold.mix_u64(h, K1);
    h = fold.mix_u64(h, r1);
    h = fold.mix_u64(h, K2);
    h = fold.mix_u64(h, r2);
    h = fold.mix_u64(h, K3);
    h = fold.mix_u64(h, r3);
    h = fold.mix_u64(h, K4);
    h = fold.mix_u64(h, r4);
    h = fold.mix_u64(h, K5);
    h = fold.mix_u64(h, r5);
    h = fold.mix_u64(h, K6);
    h = fold.mix_u64(h, r6);
    h = fold.mix_u64(h, K7);
    h = fold.mix_u64(h, r7);

    val zd: f64 = seed::f64;
    var d0: f64 = (1.0 + zd) / 3.0;
    var d1: f64 = d0 * 7.0 - 2.0;
    var d2: f64 = d1 / 1.1;
    var d3: f64 = d2 * d2 + d0;

    h = fold.mix_f64(h, F0);
    h = fold.mix_f64(h, d0);
    h = fold.mix_f64(h, F1);
    h = fold.mix_f64(h, d1);
    h = fold.mix_f64(h, F2);
    h = fold.mix_f64(h, d2);
    h = fold.mix_f64(h, F3);
    h = fold.mix_f64(h, d3);

    val zf: f32 = seed::f32;
    var e0: f32 = (1.0 + zf) / 3.0;
    var e1: f32 = e0 * 7.0 - 2.0;
    var e2: f32 = e1 / 1.1;
    var e3: f32 = e2 * e2 + e0;

    h = fold.mix_f32(h, G0);
    h = fold.mix_f32(h, e0);
    h = fold.mix_f32(h, G1);
    h = fold.mix_f32(h, e1);
    h = fold.mix_f32(h, G2);
    h = fold.mix_f32(h, e2);
    h = fold.mix_f32(h, G3);
    h = fold.mix_f32(h, e3);

    # the comptime unroll and the runtime loop over the same six taps
    var ct_acc: u64 = 0;
    $each t in TAPS {
        ct_acc = ct_acc ^ (t * 2654435761);
        h = fold.mix_u64(h, ct_acc);
    }

    var taps: [6]u64;
    taps[0] = 1 + seed;
    taps[1] = 3 + seed;
    taps[2] = 7 + seed;
    taps[3] = 15 + seed;
    taps[4] = 31 + seed;
    taps[5] = 63 + seed;

    var rt_acc: u64 = 0;
    var i: u64 = 0;
    for (i < 6) {
        rt_acc = rt_acc ^ (taps[i] * 2654435761);
        h = fold.mix_u64(h, rt_acc);
        i = i + 1;
    }

    # the same two gates decided at compile time and at run time
    $if (K7 < K5) {
        h = fold.mix_u64(h, 11);
    }
    $or {
        h = fold.mix_u64(h, 22);
    }
    if (r7 < r5) {
        h = fold.mix_u64(h, 11);
    } or {
        h = fold.mix_u64(h, 22);
    }

    $if (K4 > 0xFFFF) {
        h = fold.mix_u64(h, 33);
    }
    $or {
        h = fold.mix_u64(h, 44);
    }
    if (r4 > 0xFFFF) {
        h = fold.mix_u64(h, 33);
    } or {
        h = fold.mix_u64(h, 44);
    }

    val m0: u8 = MODE_MIX + seed::u8;
    val m1: u8 = MODE_ROT + seed::u8;

    h = fold.mix_u64(h, apply(MODE_MIX, r7));
    h = fold.mix_u64(h, apply_rt(m0, r7));
    h = fold.mix_u64(h, apply(MODE_ROT, r7));
    h = fold.mix_u64(h, apply_rt(m1, r7));
    h = fold.mix_u64(h, apply(MODE_MIX, r4));
    h = fold.mix_u64(h, apply_rt(m0, r4));
    h = fold.mix_u64(h, apply(MODE_ROT, r4));
    h = fold.mix_u64(h, apply_rt(m1, r4));

    ret h;
}
