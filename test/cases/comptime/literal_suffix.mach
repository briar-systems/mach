# a literal's suffix gives it its type in every phase: at the extremes of each
# width, in hex and octal, on floats of each width, folded at compile time,
# stored in a global, passed through a call, and as the tail elements of a
# pack. `$type_of` agrees with the runtime, and an unsuffixed literal is i64 at
# compile time. a literal expression takes its context type, so `0 - 1` and
# `~7` wrap and mask at u64. each value folds, and each compile-time agreement
# folds as 1

use corpus.lib.fold;

val CROSS:     u32 = 4000000000u32;
val WRAP_MAX:  u64 = 0 - 1;
val WRAP_MASK: u64 = ~7;

fun cross_comptime_kind() u8 {
    $if ($type_of(4000000000u32) == u32) { ret 1; }
    $or                                  { ret 0; }
}

fun signed_comptime_kind() u8 {
    $if ($type_of(1i8) == i8) { ret 1; }
    $or                       { ret 0; }
}

fun float_comptime_kind() u8 {
    $if ($type_of(1.5f32) == f32) { ret 1; }
    $or                           { ret 0; }
}

fun unsuffixed_comptime_kind() u8 {
    $if ($type_of(1) == i64) { ret 1; }
    $or                      { ret 0; }
}

fun sink(va: ...) u32 {
    var acc: u32 = 0;
    $each a in va { acc = acc + a; }
    ret acc;
}

#[noinline]
fun through_u32(x: u32) u32 {
    ret x;
}

#[noinline]
fun through_u64(x: u64) u64 {
    ret x;
}

#[noinline]
fun through_f32(x: f32) f32 {
    ret x;
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: u32 = seed::u32;

    h = fold.mix_u64(h, 18446744073709551615u64 - seed);
    h = fold.mix_i8(h, -128i8 + seed::i8);
    h = fold.mix_i64(h, 9223372036854775807i64 - seed:~i64);
    h = fold.mix_u8(h, 0xFFu8 - seed::u8);
    h = fold.mix_u32(h, 0o755u32 + s);
    h = fold.mix_f32(h, 1.5e2f32 + s::f32);
    h = fold.mix_f32(h, 0.1f32 + s::f32);
    h = fold.mix_f64(h, 0.1f64 + s::f64);
    h = fold.mix_f32(h, through_f32(0.5f32));

    h = fold.mix_u8(h, cross_comptime_kind());
    h = fold.mix_u8(h, signed_comptime_kind());
    h = fold.mix_u8(h, float_comptime_kind());
    h = fold.mix_u8(h, unsuffixed_comptime_kind());
    h = fold.mix_u32(h, 4000000000u32 - 1000000000u32 + s);
    h = fold.mix_u32(h, through_u32(CROSS + s));
    h = fold.mix_u32(h, CROSS - 1u32 + s);
    h = fold.mix_u32(h, 7u32 + 1 + s);
    h = fold.mix_u64(h, 7u32::u64 + seed);

    h = fold.mix_u32(h, sink(7u32 + s, 8u32));
    h = fold.mix_u32(h, sink(7::u32 + s, 8::u32));

    h = fold.mix_u64(h, through_u64((-1)::u64) - seed);
    h = fold.mix_u64(h, through_u64(18446744073709551616::u64) + seed);
    h = fold.mix_u64(h, WRAP_MAX - seed);
    h = fold.mix_u64(h, through_u64(0 - 1) - seed);
    h = fold.mix_u64(h, WRAP_MASK - seed);
    h = fold.mix_u64(h, through_u64(~7) - seed);
    ret h;
}
