# a generic whose type-argument list is not position-for-position its callee's:
# `find_extra[K, V, M, P]` and `find_first[V, K, M, P]` both hand `hk[K, M, P]`
# the types they name, so the `$type_of` gate inside hk selects the arm of the
# policy that was passed and the concrete instance runs the arm the source means.
# the same-position caller `find_same` is the control every layout agrees with.

use corpus.lib.fold;

rec Natural {}
rec Custom  {}

rec A[K, V] { k: K; v: V; policy: Natural; }
rec B[K, V] { k: K; v: V; policy: Custom; }

fun hk[K, M, P](m: *M, p: P, key: *K) u64 {
    var r: u64 = 0;
    $if ($type_of(p) == Natural) {
        r = (@key)::u64 * 3 + 1;
    }
    $or ($type_of(p) == Custom) {
        r = m.k::u64 * 5 + m.v::u64;
    }
    $or { $error("no policy arm"); }
    ret r;
}

fun find_same[K, M, P](m: *M, p: P, key: *K) u64 { ret hk[K, M, P](m, p, key); }
fun find_extra[K, V, M, P](m: *M, p: P, key: *K) u64 { ret hk[K, M, P](m, p, key); }
fun find_first[V, K, M, P](m: *M, p: P, key: *K) u64 { ret hk[K, M, P](m, p, key); }

fun get_same[K, V](m: *A[K, V], key: *K) u64 {
    var p: Natural;
    ret find_same[K, A[K, V], Natural](m, p, key);
}

fun get_extra[K, V](m: *A[K, V], key: *K) u64 {
    var p: Natural;
    ret find_extra[K, V, A[K, V], Natural](m, p, key);
}

fun get_first[K, V](m: *B[K, V], key: *K) u64 {
    var p: Custom;
    ret find_first[V, K, B[K, V], Custom](m, p, key);
}

fun get_first_natural[K, V](m: *A[K, V], key: *K) u64 {
    var p: Natural;
    ret find_first[V, K, A[K, V], Natural](m, p, key);
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();

    var a: A[i64, u8];
    a.k = (seed + 11)::i64;
    a.v = (seed + 2)::u8;
    var b: B[i64, u8];
    b.k = (seed + 7)::i64;
    b.v = (seed + 3)::u8;
    var key: i64 = (seed + 40)::i64;

    h = fold.mix_u64(h, get_same[i64, u8](?a, ?key));
    h = fold.mix_u64(h, get_extra[i64, u8](?a, ?key));
    h = fold.mix_u64(h, get_first[i64, u8](?b, ?key));
    h = fold.mix_u64(h, get_first_natural[i64, u8](?a, ?key));

    var c: B[u32, u16];
    c.k = (seed + 9)::u32;
    c.v = (seed + 4)::u16;
    var key32: u32 = (seed + 50)::u32;
    h = fold.mix_u64(h, get_first[u32, u16](?c, ?key32));

    ret h;
}
