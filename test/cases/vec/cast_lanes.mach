# vector `::` converts each lane with the scalar rule, for every pair of lane types
# at four lanes (#3493). one noinline probe per pair runs the conversion whether
# the target packs it or expands it per lane; four lanes of a 64-bit
# type are wider than a 128-bit register, so the mixed shapes where only one side
# has a memory image are here too. integer lanes run through each type's extremes.
# float lanes the C mapping defines fold by value; NaN, the infinities and values
# outside the destination fold only as agreement with the scalar `::` of the same
# lane on the same target, which is the contract: a vector lane converts exactly
# as the scalar does.

use corpus.lib.fold;

#[noinline]
fun v_i8_u8(v: i8x4) u8x4 {
    ret v::u8x4;
}

#[noinline]
fun v_i8_i16(v: i8x4) i16x4 {
    ret v::i16x4;
}

