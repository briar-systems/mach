fun agree_f32_i8(h: u64, x: f32x4) u64 {
    val v: i8x4 = v_f32_i8(x);
    var a: u64 = h;
    var same0: u8 = 0;
    if (v[0] == s_f32_i8(x[0])) { same0 = 1; }
    a = fold.mix_u8(a, same0);
    var same1: u8 = 0;
    if (v[1] == s_f32_i8(x[1])) { same1 = 1; }
    a = fold.mix_u8(a, same1);
    var same2: u8 = 0;
    if (v[2] == s_f32_i8(x[2])) { same2 = 1; }
    a = fold.mix_u8(a, same2);
    var same3: u8 = 0;
    if (v[3] == s_f32_i8(x[3])) { same3 = 1; }
    a = fold.mix_u8(a, same3);
    ret a;
}

