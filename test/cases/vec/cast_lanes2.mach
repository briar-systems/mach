pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val zero_f32: f32 = seed::f32;
    val zero_f64: f64 = seed::f64;
    var x_i8_i64_0: i8x2 = i8x2{(-127 - 1), 127};
    h = fold_i64(h, v_i8_i64(x_i8_i64_0));
    var x_i8_i64_1: i8x2 = i8x2{-1, 53};
    x_i8_i64_1[1] = x_i8_i64_1[1] ^ seed::i8;
    h = fold_i64(h, v_i8_i64(x_i8_i64_1));
    var x_i8_u64_0: i8x2 = i8x2{(-127 - 1), 127};
    h = fold_u64(h, v_i8_u64(x_i8_u64_0));
    var x_i8_u64_1: i8x2 = i8x2{-1, 53};
    x_i8_u64_1[1] = x_i8_u64_1[1] ^ seed::i8;
    h = fold_u64(h, v_i8_u64(x_i8_u64_1));
    var x_i8_f64_0: i8x2 = i8x2{(-127 - 1), 127};
    h = fold_f64(h, v_i8_f64(x_i8_f64_0));
    var x_i8_f64_1: i8x2 = i8x2{-1, 53};
    x_i8_f64_1[1] = x_i8_f64_1[1] ^ seed::i8;
    h = fold_f64(h, v_i8_f64(x_i8_f64_1));
    var x_u8_i64_0: u8x2 = u8x2{0, 255};
    h = fold_i64(h, v_u8_i64(x_u8_i64_0));
    var x_u8_i64_1: u8x2 = u8x2{128, 53};
    x_u8_i64_1[1] = x_u8_i64_1[1] ^ seed::u8;
    h = fold_i64(h, v_u8_i64(x_u8_i64_1));
    var x_u8_u64_0: u8x2 = u8x2{0, 255};
    h = fold_u64(h, v_u8_u64(x_u8_u64_0));
    var x_u8_u64_1: u8x2 = u8x2{128, 53};
    x_u8_u64_1[1] = x_u8_u64_1[1] ^ seed::u8;
    h = fold_u64(h, v_u8_u64(x_u8_u64_1));
    var x_u8_f64_0: u8x2 = u8x2{0, 255};
    h = fold_f64(h, v_u8_f64(x_u8_f64_0));
    var x_u8_f64_1: u8x2 = u8x2{128, 53};
    x_u8_f64_1[1] = x_u8_f64_1[1] ^ seed::u8;
    h = fold_f64(h, v_u8_f64(x_u8_f64_1));
    var x_i16_i64_0: i16x2 = i16x2{(-32767 - 1), 32767};
    h = fold_i64(h, v_i16_i64(x_i16_i64_0));
    var x_i16_i64_1: i16x2 = i16x2{-1, 13689};
    x_i16_i64_1[1] = x_i16_i64_1[1] ^ seed::i16;
    h = fold_i64(h, v_i16_i64(x_i16_i64_1));
    var x_i16_u64_0: i16x2 = i16x2{(-32767 - 1), 32767};
    h = fold_u64(h, v_i16_u64(x_i16_u64_0));
    var x_i16_u64_1: i16x2 = i16x2{-1, 13689};
    x_i16_u64_1[1] = x_i16_u64_1[1] ^ seed::i16;
    h = fold_u64(h, v_i16_u64(x_i16_u64_1));
    var x_i16_f64_0: i16x2 = i16x2{(-32767 - 1), 32767};
    h = fold_f64(h, v_i16_f64(x_i16_f64_0));
    var x_i16_f64_1: i16x2 = i16x2{-1, 13689};
    x_i16_f64_1[1] = x_i16_f64_1[1] ^ seed::i16;
    h = fold_f64(h, v_i16_f64(x_i16_f64_1));
    var x_u16_i64_0: u16x2 = u16x2{0, 65535};
    h = fold_i64(h, v_u16_i64(x_u16_i64_0));
    var x_u16_i64_1: u16x2 = u16x2{32768, 13689};
    x_u16_i64_1[1] = x_u16_i64_1[1] ^ seed::u16;
    h = fold_i64(h, v_u16_i64(x_u16_i64_1));
    var x_u16_u64_0: u16x2 = u16x2{0, 65535};
    h = fold_u64(h, v_u16_u64(x_u16_u64_0));
    var x_u16_u64_1: u16x2 = u16x2{32768, 13689};
    x_u16_u64_1[1] = x_u16_u64_1[1] ^ seed::u16;
    h = fold_u64(h, v_u16_u64(x_u16_u64_1));
    var x_u16_f64_0: u16x2 = u16x2{0, 65535};
    h = fold_f64(h, v_u16_f64(x_u16_f64_0));
    var x_u16_f64_1: u16x2 = u16x2{32768, 13689};
    x_u16_f64_1[1] = x_u16_f64_1[1] ^ seed::u16;
    h = fold_f64(h, v_u16_f64(x_u16_f64_1));
    var x_i32_i64_0: i32x2 = i32x2{(-2147483647 - 1), 2147483647};
    h = fold_i64(h, v_i32_i64(x_i32_i64_0));
    var x_i32_i64_1: i32x2 = i32x2{-1, 324508639};
    x_i32_i64_1[1] = x_i32_i64_1[1] ^ seed::i32;
    h = fold_i64(h, v_i32_i64(x_i32_i64_1));
    var x_i32_u64_0: i32x2 = i32x2{(-2147483647 - 1), 2147483647};
    h = fold_u64(h, v_i32_u64(x_i32_u64_0));
    var x_i32_u64_1: i32x2 = i32x2{-1, 324508639};
    x_i32_u64_1[1] = x_i32_u64_1[1] ^ seed::i32;
    h = fold_u64(h, v_i32_u64(x_i32_u64_1));
    var x_i32_f64_0: i32x2 = i32x2{(-2147483647 - 1), 2147483647};
    h = fold_f64(h, v_i32_f64(x_i32_f64_0));
    var x_i32_f64_1: i32x2 = i32x2{-1, 324508639};
    x_i32_f64_1[1] = x_i32_f64_1[1] ^ seed::i32;
    h = fold_f64(h, v_i32_f64(x_i32_f64_1));
