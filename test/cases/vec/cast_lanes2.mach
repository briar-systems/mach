# the 2-lane sibling of cast_lanes (#3493): every lane pair with a 64-bit side at two
# lanes, which fits one 128-bit register, so a target that packs a 64-bit conversion
# runs it here. integer lanes run through each type's extremes, two lanes per probe.
# float lanes the C mapping defines fold by value; NaN, the infinities and values
# outside the destination fold only as agreement with the scalar `::` of the same
# lane on the same target.

use corpus.lib.fold;

#[noinline]
fun v_i8_i64(v: i8x2) i64x2 {
    ret v::i64x2;
}

