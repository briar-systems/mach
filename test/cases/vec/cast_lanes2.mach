fun fold_i8(h: u64, v: i8x2) u64 {
    var a: u64 = h;
    a = fold.mix_i8(a, v[0]);
    a = fold.mix_i8(a, v[1]);
    ret a;
}

fun fold_u8(h: u64, v: u8x2) u64 {
    var a: u64 = h;
    a = fold.mix_u8(a, v[0]);
    a = fold.mix_u8(a, v[1]);
    ret a;
}

