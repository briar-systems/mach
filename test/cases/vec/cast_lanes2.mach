    ret a;
}

fun agree_f32_i64(h: u64, x: f32x2) u64 {
    val v: i64x2 = v_f32_i64(x);
    var a: u64 = h;
    var same0: u8 = 0;
    if (v[0] == s_f32_i64(x[0])) { same0 = 1; }
    a = fold.mix_u8(a, same0);
    var same1: u8 = 0;
    if (v[1] == s_f32_i64(x[1])) { same1 = 1; }
    a = fold.mix_u8(a, same1);
    ret a;
}

fun agree_f32_u64(h: u64, x: f32x2) u64 {
    val v: u64x2 = v_f32_u64(x);
    var a: u64 = h;
    var same0: u8 = 0;
    if (v[0] == s_f32_u64(x[0])) { same0 = 1; }
    a = fold.mix_u8(a, same0);
    var same1: u8 = 0;
    if (v[1] == s_f32_u64(x[1])) { same1 = 1; }
    a = fold.mix_u8(a, same1);
    ret a;
}

fun agree_f32_f64(h: u64, x: f32x2) u64 {
    val v: f64x2 = v_f32_f64(x);
    var a: u64 = h;
    var same0: u8 = 0;
    if (v[0]:~u64 == s_f32_f64(x[0]):~u64) { same0 = 1; }
    a = fold.mix_u8(a, same0);
    var same1: u8 = 0;
    if (v[1]:~u64 == s_f32_f64(x[1]):~u64) { same1 = 1; }
    a = fold.mix_u8(a, same1);
    ret a;
}

