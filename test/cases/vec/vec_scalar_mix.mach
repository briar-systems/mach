# the boundary between vector lanes and scalar registers. mach has no scalar-vector
# cast, so every crossing is a lane read or a lane write, and each one has to move
# the value between a vector register and a general or float register without
# changing it. lanes are extracted into scalar arithmetic, driven through scalar
# control flow and value conversions, and written back into lanes.

use corpus.lib.fold;

fun fold_f32x4(h: u64, v: f32x4) u64 {
    var a: u64 = fold.mix_f32(h, v[0]);
    a = fold.mix_f32(a, v[1]);
    a = fold.mix_f32(a, v[2]);
    a = fold.mix_f32(a, v[3]);
    ret a;
}

fun fold_i32x4(h: u64, v: i32x4) u64 {
    var a: u64 = fold.mix_i32(h, v[0]);
    a = fold.mix_i32(a, v[1]);
    a = fold.mix_i32(a, v[2]);
    a = fold.mix_i32(a, v[3]);
    ret a;
}

fun fold_u32x4(h: u64, v: u32x4) u64 {
    var a: u64 = fold.mix_u32(h, v[0]);
    a = fold.mix_u32(a, v[1]);
    a = fold.mix_u32(a, v[2]);
    a = fold.mix_u32(a, v[3]);
    ret a;
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val z: f32 = seed::f32;
    val s: u32 = seed::u32;

    var a: f32x4 = f32x4{1.5, -2.25, 3.75, -0.5};
    var b: f32x4 = f32x4{0.5, 4.0, -0.125, 8.0};
    a[0] = a[0] + z;
    b[2] = b[2] + z;

    # each lane product is a value of its own before anything is added to it, so
    # neither side may contract a product and a sum into one instruction
    val p0: f32 = a[0] * b[0];
    val p1: f32 = a[1] * b[1];
    val p2: f32 = a[2] * b[2];
    val p3: f32 = a[3] * b[3];
    h = fold.mix_f32(h, p0);
    h = fold.mix_f32(h, p1);
    h = fold.mix_f32(h, p2);
    h = fold.mix_f32(h, p3);

    var dot: f32 = p0 + p1;
    h = fold.mix_f32(h, dot);
    dot = dot + p2;
    h = fold.mix_f32(h, dot);
    dot = dot + p3;
    h = fold.mix_f32(h, dot);

    var c: f32x4 = a;
    c[0] = dot;
    c[1] = a[3] - b[0];
    c[2] = b[1] + a[2];
    c[3] = 0.0 - a[1];
    h = fold_f32x4(h, c);
    h = fold_f32x4(h, c * b);

    # horizontal max and min run through scalar branches, so each lane has to reach
    # a general comparison intact
    var mx: f32 = a[0];
    if (a[1] > mx) { mx = a[1]; }
    if (a[2] > mx) { mx = a[2]; }
    if (a[3] > mx) { mx = a[3]; }
    var mn: f32 = a[0];
    if (a[1] < mn) { mn = a[1]; }
    if (a[2] < mn) { mn = a[2]; }
    if (a[3] < mn) { mn = a[3]; }
    h = fold.mix_f32(h, mx);
    h = fold.mix_f32(h, mn);
    h = fold.mix_f32(h, mx - mn);

    # integer lanes converted to float lanes one at a time
    var iv: i32x4 = i32x4{7, -13, 21, -31};
    iv[1] = iv[1] + seed::i32;
    var fv: f32x4;
    fv[0] = iv[0]::f32;
    fv[1] = iv[1]::f32;
    fv[2] = iv[2]::f32;
    fv[3] = iv[3]::f32;
    h = fold_f32x4(h, fv);
    h = fold_f32x4(h, fv * a);

    # and back, on values that are exact integers, so nothing depends on a rounding
    # mode and the truncating conversion is the only thing under test
    var back: i32x4;
    back[0] = (fv[0] * 4.0)::i32;
    back[1] = (fv[1] * 4.0)::i32;
    back[2] = (fv[2] * 4.0)::i32;
    back[3] = (fv[3] * 4.0)::i32;
    h = fold_i32x4(h, back);
    h = fold_i32x4(h, back * iv);
    h = fold_i32x4(h, back - iv);

    var uv: u32x4 = u32x4{4294967295, 1, 2863311530, 305419896};
    uv[3] = uv[3] + s;
    var acc: u32 = 0;
    acc = acc + uv[0];
    h = fold.mix_u32(h, acc);
    acc = acc ^ uv[1];
    h = fold.mix_u32(h, acc);
    acc = acc * uv[2];
    h = fold.mix_u32(h, acc);
    acc = acc - uv[3];
    h = fold.mix_u32(h, acc);

    var out: u32x4;
    out[0] = acc;
    out[1] = acc ^ uv[0];
    out[2] = acc + uv[1];
    out[3] = acc - uv[2];
    h = fold_u32x4(h, out);
    h = fold_u32x4(h, out + uv);

    # every lane read and every lane written each iteration, with cross-lane
    # dependencies, so a lane that is written before it is read changes the result
    var vv: f32x4 = a;
    var n: u64 = 0;
    for (n < 4) {
        val t0: f32 = vv[0] + vv[3];
        val t1: f32 = vv[1] - vv[2];
        val t2: f32 = vv[2] * 0.5;
        val t3: f32 = vv[3] + 1.25;
        vv[0] = t0;
        vv[1] = t1;
        vv[2] = t2;
        vv[3] = t3;
        h = fold_f32x4(h, vv);
        n = n + 1;
    }
    ret h;
}
