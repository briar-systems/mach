# the vector rows at 16-bit lanes: one noinline probe per (operation, signedness
# and, for a compare, predicate) of the retained vector vocabulary, so the golden
# shows each probe's body on its own and the decoder witnesses which cells the
# target packs and which it expands per lane. every lane result folds in order.

use corpus.lib.fold;

#[noinline]
fun row_add_i16(a: i16x8, b: i16x8) i16x8 {
    ret a + b;
}

#[noinline]
fun row_add_u16(a: u16x8, b: u16x8) u16x8 {
    ret a + b;
}

#[noinline]
fun row_sub_i16(a: i16x8, b: i16x8) i16x8 {
    ret a - b;
}

#[noinline]
fun row_sub_u16(a: u16x8, b: u16x8) u16x8 {
    ret a - b;
}

#[noinline]
fun row_mul_i16(a: i16x8, b: i16x8) i16x8 {
    ret a * b;
}

#[noinline]
fun row_mul_u16(a: u16x8, b: u16x8) u16x8 {
    ret a * b;
}

#[noinline]
fun row_div_i16(a: i16x8, b: i16x8) i16x8 {
    ret a / b;
}

#[noinline]
fun row_div_u16(a: u16x8, b: u16x8) u16x8 {
    ret a / b;
}

#[noinline]
fun row_and_i16(a: i16x8, b: i16x8) i16x8 {
    ret a & b;
}

#[noinline]
fun row_and_u16(a: u16x8, b: u16x8) u16x8 {
    ret a & b;
}

#[noinline]
fun row_or_i16(a: i16x8, b: i16x8) i16x8 {
    ret a | b;
}

#[noinline]
fun row_or_u16(a: u16x8, b: u16x8) u16x8 {
    ret a | b;
}

#[noinline]
fun row_xor_i16(a: i16x8, b: i16x8) i16x8 {
    ret a ^ b;
}

#[noinline]
fun row_xor_u16(a: u16x8, b: u16x8) u16x8 {
    ret a ^ b;
}

#[noinline]
fun row_not_i16(a: i16x8) i16x8 {
    ret ~a;
}

#[noinline]
fun row_not_u16(a: u16x8) u16x8 {
    ret ~a;
}

#[noinline]
fun row_cmp_lt_i16(a: i16x8, b: i16x8) u16x8 {
    ret a < b;
}

#[noinline]
fun row_cmp_eq_i16(a: i16x8, b: i16x8) u16x8 {
    ret a == b;
}

#[noinline]
fun row_cmp_lt_u16(a: u16x8, b: u16x8) u16x8 {
    ret a < b;
}

#[noinline]
fun row_cmp_eq_u16(a: u16x8, b: u16x8) u16x8 {
    ret a == b;
}

fun fold_i16x8(h: u64, v: i16x8) u64 {
    var a: u64 = h;
    a = fold.mix_i16(a, v[0]);
    a = fold.mix_i16(a, v[1]);
    a = fold.mix_i16(a, v[2]);
    a = fold.mix_i16(a, v[3]);
    a = fold.mix_i16(a, v[4]);
    a = fold.mix_i16(a, v[5]);
    a = fold.mix_i16(a, v[6]);
    a = fold.mix_i16(a, v[7]);
    ret a;
}

fun fold_u16x8(h: u64, v: u16x8) u64 {
    var a: u64 = h;
    a = fold.mix_u16(a, v[0]);
    a = fold.mix_u16(a, v[1]);
    a = fold.mix_u16(a, v[2]);
    a = fold.mix_u16(a, v[3]);
    a = fold.mix_u16(a, v[4]);
    a = fold.mix_u16(a, v[5]);
    a = fold.mix_u16(a, v[6]);
    a = fold.mix_u16(a, v[7]);
    ret a;
}

pub fun checksum(seed: u64) u64 {
    var h:     u64 = fold.init();
    val si:    i16 = seed::i16;
    val su:    u16 = seed::u16;
    val imin:  i16 = (32768::u16):~i16;
    val imin1: i16 = imin + 1;
    {
        var a: i16x8 = i16x8{32767, imin, 7, -3, 100, 1, 0, 42};
        var b: i16x8 = i16x8{3, 2, -7, 5, 9, 32767, 1, 6};
        a[0] = a[0] + si;
        h    = fold_i16x8(h, row_add_i16(a, b));
    }
    {
        var a: u16x8 = u16x8{65535, 0, 7, 3, 100, 1, 0, 42};
        var b: u16x8 = u16x8{3, 2, 7, 5, 9, 65535, 1, 6};
        a[0] = a[0] + su;
        h    = fold_u16x8(h, row_add_u16(a, b));
    }
    {
        var a: i16x8 = i16x8{32767, imin, 7, -3, 100, 1, 0, 42};
        var b: i16x8 = i16x8{3, 2, -7, 5, 9, 32767, 1, 6};
        a[0] = a[0] + si;
        h    = fold_i16x8(h, row_sub_i16(a, b));
    }
    {
        var a: u16x8 = u16x8{65535, 0, 7, 3, 100, 1, 0, 42};
        var b: u16x8 = u16x8{3, 2, 7, 5, 9, 65535, 1, 6};
        a[0] = a[0] + su;
        h    = fold_u16x8(h, row_sub_u16(a, b));
    }
    {
        var a: i16x8 = i16x8{32767, imin, 7, -3, 100, 1, 0, 42};
        var b: i16x8 = i16x8{3, 2, -7, 5, 9, 32767, 1, 6};
        a[0] = a[0] + si;
        h    = fold_i16x8(h, row_mul_i16(a, b));
    }
    {
        var a: u16x8 = u16x8{65535, 0, 7, 3, 100, 1, 0, 42};
        var b: u16x8 = u16x8{3, 2, 7, 5, 9, 65535, 1, 6};
        a[0] = a[0] + su;
        h    = fold_u16x8(h, row_mul_u16(a, b));
    }
    {
        var a: i16x8 = i16x8{32767, imin, 7, -3, 100, 1, 0, 42};
        var b: i16x8 = i16x8{3, 2, -7, 5, 9, 32767, 1, 6};
        a[0] = a[0] + si;
        h    = fold_i16x8(h, row_div_i16(a, b));
    }
    {
        var a: u16x8 = u16x8{65535, 0, 7, 3, 100, 1, 0, 42};
        var b: u16x8 = u16x8{3, 2, 7, 5, 9, 65535, 1, 6};
        a[0] = a[0] + su;
        h    = fold_u16x8(h, row_div_u16(a, b));
    }
    {
        var a: i16x8 = i16x8{32767, imin, 7, -3, 100, 1, 0, 42};
        var b: i16x8 = i16x8{3, 2, -7, 5, 9, 32767, 1, 6};
        a[0] = a[0] + si;
        h    = fold_i16x8(h, row_and_i16(a, b));
    }
    {
        var a: u16x8 = u16x8{65535, 0, 7, 3, 100, 1, 0, 42};
        var b: u16x8 = u16x8{3, 2, 7, 5, 9, 65535, 1, 6};
        a[0] = a[0] + su;
        h    = fold_u16x8(h, row_and_u16(a, b));
    }
    {
        var a: i16x8 = i16x8{32767, imin, 7, -3, 100, 1, 0, 42};
        var b: i16x8 = i16x8{3, 2, -7, 5, 9, 32767, 1, 6};
        a[0] = a[0] + si;
        h    = fold_i16x8(h, row_or_i16(a, b));
    }
    {
        var a: u16x8 = u16x8{65535, 0, 7, 3, 100, 1, 0, 42};
        var b: u16x8 = u16x8{3, 2, 7, 5, 9, 65535, 1, 6};
        a[0] = a[0] + su;
        h    = fold_u16x8(h, row_or_u16(a, b));
    }
    {
        var a: i16x8 = i16x8{32767, imin, 7, -3, 100, 1, 0, 42};
        var b: i16x8 = i16x8{3, 2, -7, 5, 9, 32767, 1, 6};
        a[0] = a[0] + si;
        h    = fold_i16x8(h, row_xor_i16(a, b));
    }
    {
        var a: u16x8 = u16x8{65535, 0, 7, 3, 100, 1, 0, 42};
        var b: u16x8 = u16x8{3, 2, 7, 5, 9, 65535, 1, 6};
        a[0] = a[0] + su;
        h    = fold_u16x8(h, row_xor_u16(a, b));
    }
    {
        var a: i16x8 = i16x8{32767, imin, 7, -3, 100, 1, 0, 42};
        a[0] = a[0] + si;
        h    = fold_i16x8(h, row_not_i16(a));
    }
    {
        var a: u16x8 = u16x8{65535, 0, 7, 3, 100, 1, 0, 42};
        a[0] = a[0] + su;
        h    = fold_u16x8(h, row_not_u16(a));
    }
    {
        var a: i16x8 = i16x8{32767, imin, 7, -3, 100, 1, 0, 42};
        var b: i16x8 = i16x8{3, 2, -7, 5, 9, 32767, 1, 6};
        a[0] = a[0] + si;
        h    = fold_u16x8(h, row_cmp_lt_i16(a, b));
    }
    {
        var a: i16x8 = i16x8{32767, imin, 7, -3, 100, 1, 0, 42};
        var b: i16x8 = i16x8{3, 2, -7, 5, 9, 32767, 1, 6};
        a[0] = a[0] + si;
        h    = fold_u16x8(h, row_cmp_eq_i16(a, b));
    }
    {
        var a: u16x8 = u16x8{65535, 0, 7, 3, 100, 1, 0, 42};
        var b: u16x8 = u16x8{3, 2, 7, 5, 9, 65535, 1, 6};
        a[0] = a[0] + su;
        h    = fold_u16x8(h, row_cmp_lt_u16(a, b));
    }
    {
        var a: u16x8 = u16x8{65535, 0, 7, 3, 100, 1, 0, 42};
        var b: u16x8 = u16x8{3, 2, 7, 5, 9, 65535, 1, 6};
        a[0] = a[0] + su;
        h    = fold_u16x8(h, row_cmp_eq_u16(a, b));
    }
    ret h;
}
