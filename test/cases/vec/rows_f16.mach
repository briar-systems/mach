# the vector rows at f16 lanes (#3802): one noinline probe per operation and
# compare predicate of the retained vector vocabulary, so each cell runs through
# its own body whether the target packs it, computes it in binary32 lanes or
# expands it per lane. the operands reach ties, a subnormal, the largest finite
# value and its overflow to infinity. every lane result folds in order.

use corpus.lib.fold;

#[noinline]
fun row_add_f16(a: f16x8, b: f16x8) f16x8 {
    ret a + b;
}

#[noinline]
fun row_sub_f16(a: f16x8, b: f16x8) f16x8 {
    ret a - b;
}

#[noinline]
fun row_mul_f16(a: f16x8, b: f16x8) f16x8 {
    ret a * b;
}

#[noinline]
fun row_div_f16(a: f16x8, b: f16x8) f16x8 {
    ret a / b;
}

#[noinline]
fun row_cmp_lt_f16(a: f16x8, b: f16x8) u16x8 {
    ret a < b;
}

#[noinline]
fun row_cmp_eq_f16(a: f16x8, b: f16x8) u16x8 {
    ret a == b;
}

fun fold_f16x8(h: u64, v: f16x8) u64 {
    var a: u64 = h;
    a = fold.mix_u16(a, v[0]:~u16);
    a = fold.mix_u16(a, v[1]:~u16);
    a = fold.mix_u16(a, v[2]:~u16);
    a = fold.mix_u16(a, v[3]:~u16);
    a = fold.mix_u16(a, v[4]:~u16);
    a = fold.mix_u16(a, v[5]:~u16);
    a = fold.mix_u16(a, v[6]:~u16);
    a = fold.mix_u16(a, v[7]:~u16);
    ret a;
}

fun fold_u16x8(h: u64, v: u16x8) u64 {
    var a: u64 = h;
    a = fold.mix_u16(a, v[0]);
    a = fold.mix_u16(a, v[1]);
    a = fold.mix_u16(a, v[2]);
    a = fold.mix_u16(a, v[3]);
    a = fold.mix_u16(a, v[4]);
    a = fold.mix_u16(a, v[5]);
    a = fold.mix_u16(a, v[6]);
    a = fold.mix_u16(a, v[7]);
    ret a;
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: f16 = seed::f16;
    {
        var a: f16x8 = f16x8{1.5, -2.25, 1024.0, 0.125, 65504.0, 0.00006103515625, -0.000000059604644775390625, 3.0};
        var b: f16x8 = f16x8{0.5, 4.0, -2.0, 8.0, 65504.0, 0.5, 0.5, 7.0};
        a[0] = a[0] + s;
        h    = fold_f16x8(h, row_add_f16(a, b));
    }
    {
        var a: f16x8 = f16x8{1.5, -2.25, 1024.0, 0.125, 65504.0, 0.00006103515625, -0.000000059604644775390625, 3.0};
        var b: f16x8 = f16x8{0.5, 4.0, -2.0, 8.0, 65504.0, 0.5, 0.5, 7.0};
        a[0] = a[0] + s;
        h    = fold_f16x8(h, row_sub_f16(a, b));
    }
    {
        var a: f16x8 = f16x8{1.5, -2.25, 1024.0, 0.125, 65504.0, 0.00006103515625, -0.000000059604644775390625, 3.0};
        var b: f16x8 = f16x8{0.5, 4.0, -2.0, 8.0, 65504.0, 0.5, 0.5, 7.0};
        a[0] = a[0] + s;
        h    = fold_f16x8(h, row_mul_f16(a, b));
    }
    {
        var a: f16x8 = f16x8{1.5, -2.25, 1024.0, 0.125, 65504.0, 0.00006103515625, -0.000000059604644775390625, 3.0};
        var b: f16x8 = f16x8{0.5, 4.0, -2.0, 8.0, 65504.0, 0.5, 0.5, 7.0};
        a[0] = a[0] + s;
        h    = fold_f16x8(h, row_div_f16(a, b));
    }
    {
        var a: f16x8 = f16x8{1.5, -2.25, 1024.0, 0.125, 65504.0, 0.00006103515625, -0.000000059604644775390625, 3.0};
        var b: f16x8 = f16x8{0.5, 4.0, -2.0, 8.0, 65504.0, 0.5, 0.5, 7.0};
        a[0] = a[0] + s;
        h    = fold_u16x8(h, row_cmp_lt_f16(a, b));
    }
    {
        var a: f16x8 = f16x8{1.5, -2.25, 1024.0, 0.125, 65504.0, 0.00006103515625, -0.000000059604644775390625, 3.0};
        var b: f16x8 = f16x8{0.5, 4.0, -2.0, 8.0, 65504.0, 0.5, 0.5, 7.0};
        a[0] = a[0] + s;
        h    = fold_u16x8(h, row_cmp_eq_f16(a, b));
    }
    ret h;
}
