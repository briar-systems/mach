# integer reductions the vectorizer takes with no float reassociation (#3345):
# a plain sum, product and bitwise folds, a multiply-accumulate at the element
# width and widened, and predicated updates, where a compare picks the lanes
# that add, multiply or and their value in, both the select if-conversion
# leaves and the branch it declines because the arm reloads the element. the
# counts and filtered sums widen byte and word lanes into a wider accumulator.
# the trip count is odd, so the scalar tail always runs, and the -O0 and -O2
# answers are each other's oracle as well as the C reference's.

use corpus.lib.fold;

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val n: u64 = 67 - (seed & 1);
    val s: u32 = seed::u32;

    var b: [67]u8;
    var x: [67]i32;
    var y: [67]i32;
    var u: [67]u32;
    var i: u64 = 0;
    for (i < n) {
        val r: u32 = i::u32 * 2654435761 + s;
        b[i] = ((r >> 13) & 15)::u8;
        x[i] = (r >> 7)::i32 - 16777216;
        y[i] = ((r * 40503) >> 9)::i32 - 4194304;
        u[i] = (r >> 20) | 1;
        i    = i + 1;
    }

    val k:   u8  = (seed & 7)::u8 + 4;
    var cnt: u64 = 0;
    var big: u32 = 0;
    i = 0;
    for (i < n) {
        if (b[i] == k) { cnt = cnt + 1; }
        i = i + 1;
    }
    i = 0;
    for (i < n) {
        if (b[i] > 7) { big = big + 1; }
        i = i + 1;
    }
    h = fold.mix_u64(h, cnt);
    h = fold.mix_u32(h, big);

    val t:    i32 = s::i32 & 1023;
    var cs:   i32 = 0;
    var skip: i32 = 0;
    var ws:   i64 = 0;
    i = 0;
    for (i < n) {
        if (x[i] > t) { cs = cs + x[i]; }
        i = i + 1;
    }
    i = 0;
    for (i < n) {
        val v: i32 = x[i];
        if (v > y[i]) {}
        or            { skip = skip + v; }
        i = i + 1;
    }
    i = 0;
    for (i < n) {
        if (x[i] > y[i]) { ws = ws + x[i]::i64; }
        i = i + 1;
    }
    h = fold.mix_i32(h, cs);
    h = fold.mix_i32(h, skip);
    h = fold.mix_i64(h, ws);

    var ma: i32 = 0;
    var mw: i64 = 0;
    i = 0;
    for (i < n) {
        ma = ma + x[i] * y[i];
        i  = i + 1;
    }
    i = 0;
    for (i < n) {
        mw = mw + x[i]::i64 * y[i]::i64;
        i  = i + 1;
    }
    h = fold.mix_i32(h, ma);
    h = fold.mix_i64(h, mw);

    var p:  u32 = 1;
    var pp: u32 = 3;
    var an: u32 = 4294967295;
    var ac: u32 = 4294967295;
    var o:  u32 = 0;
    var xr: u32 = 0;
    i = 0;
    for (i < n) {
        p = p * u[i];
        i = i + 1;
    }
    i = 0;
    for (i < n) {
        val w: u32 = u[i];
        if (w > 2000) { pp = pp * w; }
        i = i + 1;
    }
    i = 0;
    for (i < n) {
        an = an & (u[i] | 3072);
        i  = i + 1;
    }
    i = 0;
    for (i < n) {
        val w: u32 = u[i];
        if (w < 3000) { ac = ac & w; }
        i = i + 1;
    }
    i = 0;
    for (i < n) {
        o  = o | u[i];
        xr = xr ^ u[i];
        i  = i + 1;
    }
    h = fold.mix_u32(h, p);
    h = fold.mix_u32(h, pp);
    h = fold.mix_u32(h, an);
    h = fold.mix_u32(h, ac);
    h = fold.mix_u32(h, o);
    h = fold.mix_u32(h, xr);
    ret h;
}
