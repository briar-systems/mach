# the 12-byte three-lane vector: $size_of is 12 and $align_of is 4, so a lowering
# that reaches for a 16-byte f32x4 register form drops lane 2, reads past the value,
# or strides an array by 16. every lane is folded in lane order, so a wrong lane
# changes the checksum rather than cancelling out.

use corpus.lib.fold;

rec Pair {
    lead: u32;
    v: f32x3;
    trail: u32;
}

fun fold_vec(h: u64, v: f32x3) u64 {
    var a: u64 = fold.mix_f32(h, v[0]);
    a = fold.mix_f32(a, v[1]);
    a = fold.mix_f32(a, v[2]);
    ret a;
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val z: f32 = seed::f32;

    var a: f32x3 = f32x3{1.5, -2.25, 3.75};
    var b: f32x3 = f32x3{0.5, 4.0, -0.125};
    a[0] = a[0] + z;
    b[2] = b[2] + z;

    h = fold_vec(h, a);
    h = fold_vec(h, b);
    h = fold_vec(h, a + b);
    h = fold_vec(h, a - b);
    h = fold_vec(h, b - a);
    h = fold_vec(h, a * b);
    h = fold_vec(h, a / b);

    # a packed array of the 12-byte type: a 16-byte stride reads the wrong element
    var arr: [4]f32x3;
    arr[0] = a;
    arr[1] = a + b;
    arr[2] = a * b;
    arr[3] = b;
    var k: u64 = 0;
    for (k < 4) {
        h = fold_vec(h, arr[k]);
        k = k + 1;
    }

    # scalars either side of the vector, so a wrong size or alignment moves a neighbour
    var r: Pair;
    r.lead = 4294967295;
    r.v = arr[2];
    r.trail = 305419896;
    h = fold.mix_u32(h, r.lead);
    h = fold_vec(h, r.v);
    h = fold.mix_u32(h, r.trail);
    ret h;
}
