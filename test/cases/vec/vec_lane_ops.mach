# lane addressing on its own: every lane index of every shape is read and written at
# least once, and every result is a permutation whose lanes are all distinct. an
# insert or extract that is off by one lane, or that addresses the wrong half of a
# 16-lane shape, produces a different permutation and so a different checksum.

use corpus.lib.fold;

fun fold_u32x4(h: u64, v: u32x4) u64 {
    var a: u64 = fold.mix_u32(h, v[0]);
    a = fold.mix_u32(a, v[1]);
    a = fold.mix_u32(a, v[2]);
    a = fold.mix_u32(a, v[3]);
    ret a;
}

fun fold_f32x4(h: u64, v: f32x4) u64 {
    var a: u64 = fold.mix_f32(h, v[0]);
    a = fold.mix_f32(a, v[1]);
    a = fold.mix_f32(a, v[2]);
    a = fold.mix_f32(a, v[3]);
    ret a;
}

fun fold_f64x2(h: u64, v: f64x2) u64 {
    var a: u64 = fold.mix_f64(h, v[0]);
    a = fold.mix_f64(a, v[1]);
    ret a;
}

fun fold_i8x16(h: u64, v: i8x16) u64 {
    var a: u64 = fold.mix_i8(h, v[0]);
    a = fold.mix_i8(a, v[1]);
    a = fold.mix_i8(a, v[2]);
    a = fold.mix_i8(a, v[3]);
    a = fold.mix_i8(a, v[4]);
    a = fold.mix_i8(a, v[5]);
    a = fold.mix_i8(a, v[6]);
    a = fold.mix_i8(a, v[7]);
    a = fold.mix_i8(a, v[8]);
    a = fold.mix_i8(a, v[9]);
    a = fold.mix_i8(a, v[10]);
    a = fold.mix_i8(a, v[11]);
    a = fold.mix_i8(a, v[12]);
    a = fold.mix_i8(a, v[13]);
    a = fold.mix_i8(a, v[14]);
    a = fold.mix_i8(a, v[15]);
    ret a;
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: u32 = seed::u32;
    val z: f32 = seed::f32;
    val d: f64 = seed::f64;
    val e: i8 = seed::i8;

    var u: u32x4 = u32x4{286331153, 572662306, 858993459, 1145324612};
    u[0] = u[0] + s;
    u[3] = u[3] + s;
    h = fold_u32x4(h, u);

    var rev: u32x4;
    rev[0] = u[3];
    rev[1] = u[2];
    rev[2] = u[1];
    rev[3] = u[0];
    h = fold_u32x4(h, rev);

    var rot: u32x4;
    rot[0] = u[1];
    rot[1] = u[2];
    rot[2] = u[3];
    rot[3] = u[0];
    h = fold_u32x4(h, rot);

    var swap: u32x4;
    swap[0] = u[2];
    swap[1] = u[3];
    swap[2] = u[0];
    swap[3] = u[1];
    h = fold_u32x4(h, swap);

    var bcast: u32x4;
    bcast[0] = u[2];
    bcast[1] = u[2];
    bcast[2] = u[2];
    bcast[3] = u[2];
    h = fold_u32x4(h, bcast);

    # an uninitialized vector local default-initializes to all-zero lanes, so only
    # lane 1 here is ever written
    var sparse: u32x4;
    sparse[1] = u[0];
    h = fold_u32x4(h, sparse);

    # the same lane written twice: the second write wins
    var over: u32x4 = u;
    over[1] = u[0];
    over[1] = u[3];
    h = fold_u32x4(h, over);

    # each lane read back through the vector immediately after it is written, so a
    # write that only reached a shadow copy is visible
    var seq: u32x4 = u32x4{0, 0, 0, 0};
    seq[0] = u[0] + 1;
    h = fold.mix_u32(h, seq[0]);
    seq[1] = seq[0] + u[1];
    h = fold.mix_u32(h, seq[1]);
    seq[2] = seq[1] ^ u[2];
    h = fold.mix_u32(h, seq[2]);
    seq[3] = seq[2] - u[3];
    h = fold.mix_u32(h, seq[3]);
    h = fold_u32x4(h, seq);

    # a permutation feeding a lane-wise operator: both the permute and the operator
    # have to agree about which lane is which
    h = fold_u32x4(h, rev + u);
    h = fold_u32x4(h, rot - u);
    h = fold_u32x4(h, swap * u);
    h = fold_u32x4(h, rev ^ rot);

    var f: f32x4 = f32x4{1.5, -2.25, 3.75, -0.5};
    f[1] = f[1] + z;
    h = fold_f32x4(h, f);

    var frev: f32x4;
    frev[0] = f[3];
    frev[1] = f[2];
    frev[2] = f[1];
    frev[3] = f[0];
    h = fold_f32x4(h, frev);

    # two sources interleaved lane by lane
    var mix: f32x4;
    mix[0] = f[0];
    mix[1] = frev[1];
    mix[2] = f[2];
    mix[3] = frev[3];
    h = fold_f32x4(h, mix);
    h = fold_f32x4(h, mix * frev);
    h = fold.mix_f32(h, f[0] - frev[0]);
    h = fold.mix_f32(h, f[3] - frev[3]);

    var g: f64x2 = f64x2{1.5, -2.25};
    g[0] = g[0] + d;
    var gswap: f64x2;
    gswap[0] = g[1];
    gswap[1] = g[0];
    h = fold_f64x2(h, g);
    h = fold_f64x2(h, gswap);
    h = fold_f64x2(h, gswap - g);

    var q: i8x16 = i8x16{-9, 7, -5, 3, -1, 2, -4, 6, -8, 9, -3, 1, -2, 4, -6, 8};
    q[0] = q[0] + e;
    q[15] = q[15] + e;
    h = fold_i8x16(h, q);

    # all sixteen lane indices written from the mirrored index, so an insert that
    # addresses only the low eight lanes changes the upper half
    var qrev: i8x16;
    qrev[0] = q[15];
    qrev[1] = q[14];
    qrev[2] = q[13];
    qrev[3] = q[12];
    qrev[4] = q[11];
    qrev[5] = q[10];
    qrev[6] = q[9];
    qrev[7] = q[8];
    qrev[8] = q[7];
    qrev[9] = q[6];
    qrev[10] = q[5];
    qrev[11] = q[4];
    qrev[12] = q[3];
    qrev[13] = q[2];
    qrev[14] = q[1];
    qrev[15] = q[0];
    h = fold_i8x16(h, qrev);
    h = fold_i8x16(h, qrev + q);
    h = fold_i8x16(h, qrev ^ q);
    ret h;
}
