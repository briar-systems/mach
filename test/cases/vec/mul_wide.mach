# widen-then-multiply on integer lanes (#3462): one noinline probe per operand lane
# width, signedness and lane count, so the shapes that fuse into the target's
# packed widening multiply and the ones that keep the extend-then-multiply path
# each run on their own.
# the operands run through each lane type's extremes and every result lane folds in
# order.

use corpus.lib.fold;

#[noinline]
fun mw_i8(a: i8x8, b: i8x8) i16x8 {
    ret a::i16x8 * b::i16x8;
}

#[noinline]
fun mw_u8(a: u8x8, b: u8x8) u16x8 {
    ret a::u16x8 * b::u16x8;
}

#[noinline]
fun mw_i16(a: i16x4, b: i16x4) i32x4 {
    ret a::i32x4 * b::i32x4;
}

#[noinline]
fun mw_u16(a: u16x4, b: u16x4) u32x4 {
    ret a::u32x4 * b::u32x4;
}

#[noinline]
fun mw_i32(a: i32x2, b: i32x2) i64x2 {
    ret a::i64x2 * b::i64x2;
}

#[noinline]
fun mw_u32(a: u32x2, b: u32x2) u64x2 {
    ret a::u64x2 * b::u64x2;
}

#[noinline]
fun mw_i16_2(a: i16x2, b: i16x2) i32x2 {
    ret a::i32x2 * b::i32x2;
}

#[noinline]
fun mw_u8_4(a: u8x4, b: u8x4) u16x4 {
    ret a::u16x4 * b::u16x4;
}

#[noinline]
fun mw_i16_8(a: i16x8, b: i16x8) i32x8 {
    ret a::i32x8 * b::i32x8;
}

#[noinline]
fun mw_u16_8(a: u16x8, b: u16x8) u32x8 {
    ret a::u32x8 * b::u32x8;
}

#[noinline]
fun mw_i8_16(a: i8x16, b: i8x16) i16x16 {
    ret a::i16x16 * b::i16x16;
}

#[noinline]
fun mw_mixed16(a: i16x4, b: u16x4) i32x4 {
    ret a::i32x4 * b::i32x4;
}

fun fold_i16x8(h: u64, v: i16x8) u64 {
    var a: u64 = h;
    a = fold.mix_i16(a, v[0]);
    a = fold.mix_i16(a, v[1]);
    a = fold.mix_i16(a, v[2]);
    a = fold.mix_i16(a, v[3]);
    a = fold.mix_i16(a, v[4]);
    a = fold.mix_i16(a, v[5]);
    a = fold.mix_i16(a, v[6]);
    a = fold.mix_i16(a, v[7]);
    ret a;
}

fun fold_i16x16(h: u64, v: i16x16) u64 {
    var a: u64 = h;
    a = fold.mix_i16(a, v[0]);
    a = fold.mix_i16(a, v[1]);
    a = fold.mix_i16(a, v[2]);
    a = fold.mix_i16(a, v[3]);
    a = fold.mix_i16(a, v[4]);
    a = fold.mix_i16(a, v[5]);
    a = fold.mix_i16(a, v[6]);
    a = fold.mix_i16(a, v[7]);
    a = fold.mix_i16(a, v[8]);
    a = fold.mix_i16(a, v[9]);
    a = fold.mix_i16(a, v[10]);
    a = fold.mix_i16(a, v[11]);
    a = fold.mix_i16(a, v[12]);
    a = fold.mix_i16(a, v[13]);
    a = fold.mix_i16(a, v[14]);
    a = fold.mix_i16(a, v[15]);
    ret a;
}

fun fold_i32x2(h: u64, v: i32x2) u64 {
    var a: u64 = h;
    a = fold.mix_i32(a, v[0]);
    a = fold.mix_i32(a, v[1]);
    ret a;
}

fun fold_i32x4(h: u64, v: i32x4) u64 {
    var a: u64 = h;
    a = fold.mix_i32(a, v[0]);
    a = fold.mix_i32(a, v[1]);
    a = fold.mix_i32(a, v[2]);
    a = fold.mix_i32(a, v[3]);
    ret a;
}

fun fold_i32x8(h: u64, v: i32x8) u64 {
    var a: u64 = h;
    a = fold.mix_i32(a, v[0]);
    a = fold.mix_i32(a, v[1]);
    a = fold.mix_i32(a, v[2]);
    a = fold.mix_i32(a, v[3]);
    a = fold.mix_i32(a, v[4]);
    a = fold.mix_i32(a, v[5]);
    a = fold.mix_i32(a, v[6]);
    a = fold.mix_i32(a, v[7]);
    ret a;
}

fun fold_i64x2(h: u64, v: i64x2) u64 {
    var a: u64 = h;
    a = fold.mix_i64(a, v[0]);
    a = fold.mix_i64(a, v[1]);
    ret a;
}

fun fold_u16x4(h: u64, v: u16x4) u64 {
    var a: u64 = h;
    a = fold.mix_u16(a, v[0]);
    a = fold.mix_u16(a, v[1]);
    a = fold.mix_u16(a, v[2]);
    a = fold.mix_u16(a, v[3]);
    ret a;
}

fun fold_u16x8(h: u64, v: u16x8) u64 {
    var a: u64 = h;
    a = fold.mix_u16(a, v[0]);
    a = fold.mix_u16(a, v[1]);
    a = fold.mix_u16(a, v[2]);
    a = fold.mix_u16(a, v[3]);
    a = fold.mix_u16(a, v[4]);
    a = fold.mix_u16(a, v[5]);
    a = fold.mix_u16(a, v[6]);
    a = fold.mix_u16(a, v[7]);
    ret a;
}

fun fold_u32x4(h: u64, v: u32x4) u64 {
    var a: u64 = h;
    a = fold.mix_u32(a, v[0]);
    a = fold.mix_u32(a, v[1]);
    a = fold.mix_u32(a, v[2]);
    a = fold.mix_u32(a, v[3]);
    ret a;
}

fun fold_u32x8(h: u64, v: u32x8) u64 {
    var a: u64 = h;
    a = fold.mix_u32(a, v[0]);
    a = fold.mix_u32(a, v[1]);
    a = fold.mix_u32(a, v[2]);
    a = fold.mix_u32(a, v[3]);
    a = fold.mix_u32(a, v[4]);
    a = fold.mix_u32(a, v[5]);
    a = fold.mix_u32(a, v[6]);
    a = fold.mix_u32(a, v[7]);
    ret a;
}

fun fold_u64x2(h: u64, v: u64x2) u64 {
    var a: u64 = h;
    a = fold.mix_u64(a, v[0]);
    a = fold.mix_u64(a, v[1]);
    ret a;
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    {
        var a: i8x8 = i8x8{(128::u8):~i8, 127, -1, 0, 1, -127, 126, 7};
        var b: i8x8 = i8x8{(128::u8):~i8, (128::u8):~i8, 127, 5, 127, 127, (128::u8):~i8, 9};
        a[1] = a[1] ^ seed::i8;
        h    = fold_i16x8(h, mw_i8(a, b));
    }
    {
        var a: i8x8 = i8x8{127, (128::u8):~i8, (128::u8):~i8, 127, -1, 2, 127, (128::u8):~i8};
        var b: i8x8 = i8x8{127, 127, (128::u8):~i8, -127, 11, 2, (128::u8):~i8, 124};
        a[1] = a[1] ^ seed::i8;
        h    = fold_i16x8(h, mw_i8(a, b));
    }
    {
        var a: i8x8 = i8x8{(128::u8):~i8, (128::u8):~i8, 127, 5, 127, 127, (128::u8):~i8, 9};
        var b: i8x8 = i8x8{127, (128::u8):~i8, (128::u8):~i8, 127, -1, 2, 127, (128::u8):~i8};
        a[1] = a[1] ^ seed::i8;
        h    = fold_i16x8(h, mw_i8(a, b));
    }
    {
        var a: u8x8 = u8x8{0, 255, 254, 0, 1, 1, 254, 7};
        var b: u8x8 = u8x8{0, 0, 255, 5, 255, 255, 0, 9};
        a[1] = a[1] ^ seed::u8;
        h    = fold_u16x8(h, mw_u8(a, b));
    }
    {
        var a: u8x8 = u8x8{255, 0, 0, 255, 254, 2, 255, 0};
        var b: u8x8 = u8x8{255, 255, 0, 1, 11, 2, 0, 252};
        a[1] = a[1] ^ seed::u8;
        h    = fold_u16x8(h, mw_u8(a, b));
    }
    {
        var a: u8x8 = u8x8{0, 0, 255, 5, 255, 255, 0, 9};
        var b: u8x8 = u8x8{255, 0, 0, 255, 254, 2, 255, 0};
        a[1] = a[1] ^ seed::u8;
        h    = fold_u16x8(h, mw_u8(a, b));
    }
    {
        var a: i16x4 = i16x4{(32768::u16):~i16, 32767, -1, 0};
        var b: i16x4 = i16x4{(32768::u16):~i16, (32768::u16):~i16, 32767, 5};
        a[1] = a[1] ^ seed::i16;
        h    = fold_i32x4(h, mw_i16(a, b));
    }
    {
        var a: i16x4 = i16x4{32767, (32768::u16):~i16, (32768::u16):~i16, 32767};
        var b: i16x4 = i16x4{32767, 32767, (32768::u16):~i16, 9};
        a[1] = a[1] ^ seed::i16;
        h    = fold_i32x4(h, mw_i16(a, b));
    }
    {
        var a: i16x4 = i16x4{(32768::u16):~i16, (32768::u16):~i16, 32767, 5};
        var b: i16x4 = i16x4{32767, (32768::u16):~i16, (32768::u16):~i16, 32767};
        a[1] = a[1] ^ seed::i16;
        h    = fold_i32x4(h, mw_i16(a, b));
    }
    {
        var a: u16x4 = u16x4{0, 65535, 65534, 0};
        var b: u16x4 = u16x4{0, 0, 65535, 5};
        a[1] = a[1] ^ seed::u16;
        h    = fold_u32x4(h, mw_u16(a, b));
    }
    {
        var a: u16x4 = u16x4{65535, 0, 0, 65535};
        var b: u16x4 = u16x4{65535, 65535, 0, 9};
        a[1] = a[1] ^ seed::u16;
        h    = fold_u32x4(h, mw_u16(a, b));
    }
    {
        var a: u16x4 = u16x4{0, 0, 65535, 5};
        var b: u16x4 = u16x4{65535, 0, 0, 65535};
        a[1] = a[1] ^ seed::u16;
        h    = fold_u32x4(h, mw_u16(a, b));
    }
    {
        var a: i32x2 = i32x2{(2147483648::u32):~i32, 2147483647};
        var b: i32x2 = i32x2{(2147483648::u32):~i32, (2147483648::u32):~i32};
        a[1] = a[1] ^ seed::i32;
        h    = fold_i64x2(h, mw_i32(a, b));
    }
    {
        var a: i32x2 = i32x2{2147483647, (2147483648::u32):~i32};
        var b: i32x2 = i32x2{2147483647, 5};
        a[1] = a[1] ^ seed::i32;
        h    = fold_i64x2(h, mw_i32(a, b));
    }
    {
        var a: i32x2 = i32x2{(2147483648::u32):~i32, (2147483648::u32):~i32};
        var b: i32x2 = i32x2{2147483647, (2147483648::u32):~i32};
        a[1] = a[1] ^ seed::i32;
        h    = fold_i64x2(h, mw_i32(a, b));
    }
    {
        var a: u32x2 = u32x2{0, 4294967295};
        var b: u32x2 = u32x2{0, 0};
        a[1] = a[1] ^ seed::u32;
        h    = fold_u64x2(h, mw_u32(a, b));
    }
    {
        var a: u32x2 = u32x2{4294967295, 0};
        var b: u32x2 = u32x2{4294967295, 5};
        a[1] = a[1] ^ seed::u32;
        h    = fold_u64x2(h, mw_u32(a, b));
    }
    {
        var a: u32x2 = u32x2{0, 0};
        var b: u32x2 = u32x2{4294967295, 0};
        a[1] = a[1] ^ seed::u32;
        h    = fold_u64x2(h, mw_u32(a, b));
    }
    {
        var a: i16x2 = i16x2{(32768::u16):~i16, 32767};
        var b: i16x2 = i16x2{(32768::u16):~i16, (32768::u16):~i16};
        a[1] = a[1] ^ seed::i16;
        h    = fold_i32x2(h, mw_i16_2(a, b));
    }
    {
        var a: i16x2 = i16x2{32767, (32768::u16):~i16};
        var b: i16x2 = i16x2{32767, 5};
        a[1] = a[1] ^ seed::i16;
        h    = fold_i32x2(h, mw_i16_2(a, b));
    }
    {
        var a: i16x2 = i16x2{(32768::u16):~i16, (32768::u16):~i16};
        var b: i16x2 = i16x2{32767, (32768::u16):~i16};
        a[1] = a[1] ^ seed::i16;
        h    = fold_i32x2(h, mw_i16_2(a, b));
    }
    {
        var a: u8x4 = u8x4{0, 255, 254, 0};
        var b: u8x4 = u8x4{0, 0, 255, 5};
        a[1] = a[1] ^ seed::u8;
        h    = fold_u16x4(h, mw_u8_4(a, b));
    }
    {
        var a: u8x4 = u8x4{255, 0, 0, 255};
        var b: u8x4 = u8x4{255, 255, 0, 9};
        a[1] = a[1] ^ seed::u8;
        h    = fold_u16x4(h, mw_u8_4(a, b));
    }
    {
        var a: u8x4 = u8x4{0, 0, 255, 5};
        var b: u8x4 = u8x4{255, 0, 0, 255};
        a[1] = a[1] ^ seed::u8;
        h    = fold_u16x4(h, mw_u8_4(a, b));
    }
    {
        var a: i16x8 = i16x8{(32768::u16):~i16, 32767, -1, 0, 1, -32767, 32766, 7};
        var b: i16x8 = i16x8{(32768::u16):~i16, (32768::u16):~i16, 32767, 5, 32767, 32767, (32768::u16):~i16, 9};
        a[1] = a[1] ^ seed::i16;
        h    = fold_i32x8(h, mw_i16_8(a, b));
    }
    {
        var a: i16x8 = i16x8{32767, (32768::u16):~i16, (32768::u16):~i16, 32767, -1, 2, 32767, (32768::u16):~i16};
        var b: i16x8 = i16x8{32767, 32767, (32768::u16):~i16, -32767, 11, 2, (32768::u16):~i16, 32764};
        a[1] = a[1] ^ seed::i16;
        h    = fold_i32x8(h, mw_i16_8(a, b));
    }
    {
        var a: i16x8 = i16x8{(32768::u16):~i16, (32768::u16):~i16, 32767, 5, 32767, 32767, (32768::u16):~i16, 9};
        var b: i16x8 = i16x8{32767, (32768::u16):~i16, (32768::u16):~i16, 32767, -1, 2, 32767, (32768::u16):~i16};
        a[1] = a[1] ^ seed::i16;
        h    = fold_i32x8(h, mw_i16_8(a, b));
    }
    {
        var a: u16x8 = u16x8{0, 65535, 65534, 0, 1, 1, 65534, 7};
        var b: u16x8 = u16x8{0, 0, 65535, 5, 65535, 65535, 0, 9};
        a[1] = a[1] ^ seed::u16;
        h    = fold_u32x8(h, mw_u16_8(a, b));
    }
    {
        var a: u16x8 = u16x8{65535, 0, 0, 65535, 65534, 2, 65535, 0};
        var b: u16x8 = u16x8{65535, 65535, 0, 1, 11, 2, 0, 65532};
        a[1] = a[1] ^ seed::u16;
        h    = fold_u32x8(h, mw_u16_8(a, b));
    }
    {
        var a: u16x8 = u16x8{0, 0, 65535, 5, 65535, 65535, 0, 9};
        var b: u16x8 = u16x8{65535, 0, 0, 65535, 65534, 2, 65535, 0};
        a[1] = a[1] ^ seed::u16;
        h    = fold_u32x8(h, mw_u16_8(a, b));
    }
    {
        var a: i8x16 = i8x16{(128::u8):~i8, 127, -1, 0, 1, -127, 126, 7, (128::u8):~i8, 127, 3, (128::u8):~i8, 100, 127, -126, 42};
        var b: i8x16 = i8x16{(128::u8):~i8, (128::u8):~i8, 127, 5, 127, 127, (128::u8):~i8, 9, 127, 127, (128::u8):~i8, -127, 11, 2, (128::u8):~i8, 124};
        a[1] = a[1] ^ seed::i8;
        h    = fold_i16x16(h, mw_i8_16(a, b));
    }
    {
        var a: i8x16 = i8x16{127, (128::u8):~i8, (128::u8):~i8, 127, -1, 2, 127, (128::u8):~i8, 0, 127, (128::u8):~i8, 13, 127, (128::u8):~i8, 1, (128::u8):~i8};
        var b: i8x16 = i8x16{127, (128::u8):~i8, (128::u8):~i8, 127, -1, 2, 127, (128::u8):~i8, 0, 127, (128::u8):~i8, 13, 127, (128::u8):~i8, 1, (128::u8):~i8};
        a[1] = a[1] ^ seed::i8;
        h    = fold_i16x16(h, mw_i8_16(a, b));
    }
    {
        var a: i16x4 = i16x4{(32768::u16):~i16, 32767, -1, 0};
        var b: u16x4 = u16x4{0, 0, 65535, 5};
        a[1] = a[1] ^ seed::i16;
        h    = fold_i32x4(h, mw_mixed16(a, b));
    }
    {
        var a: i16x4 = i16x4{32767, (32768::u16):~i16, (32768::u16):~i16, 32767};
        var b: u16x4 = u16x4{65535, 0, 0, 65535};
        a[1] = a[1] ^ seed::i16;
        h    = fold_i32x4(h, mw_mixed16(a, b));
    }
    {
        var a: i16x4 = i16x4{1, -32767, 32766, 7};
        var b: u16x4 = u16x4{65535, 65535, 0, 9};
        a[1] = a[1] ^ seed::i16;
        h    = fold_i32x4(h, mw_mixed16(a, b));
    }
    ret h;
}
