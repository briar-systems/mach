# widen-then-multiply: the fused shapes lower to the target's packed widening
# multiply where its catalog declares one, and every other shape keeps the
# extend-then-multiply path. each lane is the product of the widened lanes,
# through every lane type's extremes, and a full-width product's halves
# through the narrower shape agree with it. every lane of every product folds

use corpus.lib.fold;

#[noinline]
fun widen_mul_i8x8(a: i8x8, b: i8x8) i16x8 {
    ret a::i16x8 * b::i16x8;
}

#[noinline]
fun widen_mul_u8x8(a: u8x8, b: u8x8) u16x8 {
    ret a::u16x8 * b::u16x8;
}

#[expect("vector.scalarize")]
#[noinline]
fun widen_mul_i8x16(a: i8x16, b: i8x16) i16x16 {
    ret a::i16x16 * b::i16x16;
}

#[noinline]
fun widen_mul_i16x4(a: i16x4, b: i16x4) i32x4 {
    ret a::i32x4 * b::i32x4;
}

#[noinline]
fun widen_mul_u16x4(a: u16x4, b: u16x4) u32x4 {
    ret a::u32x4 * b::u32x4;
}

#[expect("vector.scalarize")]
#[noinline]
fun widen_mul_i16x8(a: i16x8, b: i16x8) i32x8 {
    ret a::i32x8 * b::i32x8;
}

#[expect("vector.scalarize")]
#[noinline]
fun widen_mul_u16x8(a: u16x8, b: u16x8) u32x8 {
    ret a::u32x8 * b::u32x8;
}

#[noinline]
fun widen_mul_i32x2(a: i32x2, b: i32x2) i64x2 {
    ret a::i64x2 * b::i64x2;
}

#[noinline]
fun widen_mul_u32x2(a: u32x2, b: u32x2) u64x2 {
    ret a::u64x2 * b::u64x2;
}

# a mixed pair is never fused, and still multiplies the lanes as widened
#[noinline]
fun widen_mul_mixed(a: i16x4, b: u16x4) i32x4 {
    ret a::i32x4 * b::i32x4;
}

fun fold_i16x16(h: u64, v: i16x16) u64 {
    var a: u64 = h;
    a = fold.mix_i16(a, v[0]);
    a = fold.mix_i16(a, v[1]);
    a = fold.mix_i16(a, v[2]);
    a = fold.mix_i16(a, v[3]);
    a = fold.mix_i16(a, v[4]);
    a = fold.mix_i16(a, v[5]);
    a = fold.mix_i16(a, v[6]);
    a = fold.mix_i16(a, v[7]);
    a = fold.mix_i16(a, v[8]);
    a = fold.mix_i16(a, v[9]);
    a = fold.mix_i16(a, v[10]);
    a = fold.mix_i16(a, v[11]);
    a = fold.mix_i16(a, v[12]);
    a = fold.mix_i16(a, v[13]);
    a = fold.mix_i16(a, v[14]);
    a = fold.mix_i16(a, v[15]);
    ret a;
}

fun fold_i16x8(h: u64, v: i16x8) u64 {
    var a: u64 = h;
    a = fold.mix_i16(a, v[0]);
    a = fold.mix_i16(a, v[1]);
    a = fold.mix_i16(a, v[2]);
    a = fold.mix_i16(a, v[3]);
    a = fold.mix_i16(a, v[4]);
    a = fold.mix_i16(a, v[5]);
    a = fold.mix_i16(a, v[6]);
    a = fold.mix_i16(a, v[7]);
    ret a;
}

fun fold_i32x4(h: u64, v: i32x4) u64 {
    var a: u64 = h;
    a = fold.mix_i32(a, v[0]);
    a = fold.mix_i32(a, v[1]);
    a = fold.mix_i32(a, v[2]);
    a = fold.mix_i32(a, v[3]);
    ret a;
}

fun fold_i32x8(h: u64, v: i32x8) u64 {
    var a: u64 = h;
    a = fold.mix_i32(a, v[0]);
    a = fold.mix_i32(a, v[1]);
    a = fold.mix_i32(a, v[2]);
    a = fold.mix_i32(a, v[3]);
    a = fold.mix_i32(a, v[4]);
    a = fold.mix_i32(a, v[5]);
    a = fold.mix_i32(a, v[6]);
    a = fold.mix_i32(a, v[7]);
    ret a;
}

fun fold_i64x2(h: u64, v: i64x2) u64 {
    var a: u64 = h;
    a = fold.mix_i64(a, v[0]);
    a = fold.mix_i64(a, v[1]);
    ret a;
}

fun fold_u16x8(h: u64, v: u16x8) u64 {
    var a: u64 = h;
    a = fold.mix_u16(a, v[0]);
    a = fold.mix_u16(a, v[1]);
    a = fold.mix_u16(a, v[2]);
    a = fold.mix_u16(a, v[3]);
    a = fold.mix_u16(a, v[4]);
    a = fold.mix_u16(a, v[5]);
    a = fold.mix_u16(a, v[6]);
    a = fold.mix_u16(a, v[7]);
    ret a;
}

fun fold_u32x4(h: u64, v: u32x4) u64 {
    var a: u64 = h;
    a = fold.mix_u32(a, v[0]);
    a = fold.mix_u32(a, v[1]);
    a = fold.mix_u32(a, v[2]);
    a = fold.mix_u32(a, v[3]);
    ret a;
}

fun fold_u32x8(h: u64, v: u32x8) u64 {
    var a: u64 = h;
    a = fold.mix_u32(a, v[0]);
    a = fold.mix_u32(a, v[1]);
    a = fold.mix_u32(a, v[2]);
    a = fold.mix_u32(a, v[3]);
    a = fold.mix_u32(a, v[4]);
    a = fold.mix_u32(a, v[5]);
    a = fold.mix_u32(a, v[6]);
    a = fold.mix_u32(a, v[7]);
    ret a;
}

fun fold_u64x2(h: u64, v: u64x2) u64 {
    var a: u64 = h;
    a = fold.mix_u64(a, v[0]);
    a = fold.mix_u64(a, v[1]);
    ret a;
}

pub fun checksum(seed: u64) u64 {
    var h:     u64 = fold.init();
    val s_i16: i16 = seed::i16;
    val s_i32: i32 = seed::i32;
    val s_i8:  i8  = seed::i8;
    val s_u16: u16 = seed::u16;
    val s_u32: u32 = seed::u32;
    val s_u8:  u8  = seed::u8;

    var v1: i8x16 = i8x16{-128, -128, 127, 127, -128, -1, 0, 1, -127, 126, 7, -7, 100, -100, 1, -1};
    v1[0] = v1[0] ^ s_i8;
    var v2: i8x16 = i8x16{-128, 127, 127, -128, -1, -128, -128, 127, 3, -5, -128, 127, 2, 100, 0, -1};
    v2[0] = v2[0] ^ s_i8;
    h     = fold_i16x16(h, widen_mul_i8x16(v1, v2));
    h     = fold_i16x8(h, widen_mul_i8x8(i8x8{v1[0], v1[1], v1[2], v1[3], v1[4], v1[5], v1[6], v1[7]}, i8x8{v2[0], v2[1], v2[2], v2[3], v2[4], v2[5], v2[6], v2[7]}));
    h     = fold_i16x8(h, widen_mul_i8x8(i8x8{v1[8], v1[9], v1[10], v1[11], v1[12], v1[13], v1[14], v1[15]}, i8x8{v2[8], v2[9], v2[10], v2[11], v2[12], v2[13], v2[14], v2[15]}));
    var v3: u8x8 = u8x8{255, 255, 0, 255, 128, 1, 200, 17};
    v3[0] = v3[0] ^ s_u8;
    var v4: u8x8 = u8x8{255, 0, 255, 1, 128, 255, 200, 15};
    v4[0] = v4[0] ^ s_u8;
    h     = fold_u16x8(h, widen_mul_u8x8(v3, v4));
    var v5: i16x8 = i16x8{-32768, -32768, 32767, -32768, -1, 32767, 300, -3};
    v5[0] = v5[0] ^ s_i16;
    var v6: i16x8 = i16x8{-32768, 32767, 32767, -1, -32768, -1, -300, 32767};
    v6[0] = v6[0] ^ s_i16;
    h     = fold_i32x8(h, widen_mul_i16x8(v5, v6));
    h     = fold_i32x4(h, widen_mul_i16x4(i16x4{v5[0], v5[1], v5[2], v5[3]}, i16x4{v6[0], v6[1], v6[2], v6[3]}));
    h     = fold_i32x4(h, widen_mul_i16x4(i16x4{v5[4], v5[5], v5[6], v5[7]}, i16x4{v6[4], v6[5], v6[6], v6[7]}));
    var v7: u16x8 = u16x8{65535, 65535, 0, 65535, 32768, 1, 40000, 257};
    v7[0] = v7[0] ^ s_u16;
    var v8: u16x8 = u16x8{65535, 0, 65535, 1, 32768, 65535, 40000, 255};
    v8[0] = v8[0] ^ s_u16;
    h     = fold_u32x8(h, widen_mul_u16x8(v7, v8));
    h     = fold_u32x4(h, widen_mul_u16x4(u16x4{v7[0], v7[1], v7[2], v7[3]}, u16x4{v8[0], v8[1], v8[2], v8[3]}));
    h     = fold_u32x4(h, widen_mul_u16x4(u16x4{v7[4], v7[5], v7[6], v7[7]}, u16x4{v8[4], v8[5], v8[6], v8[7]}));
    var v9: i16x4 = i16x4{-32768, 32767, -1, 5};
    v9[0] = v9[0] ^ s_i16;
    var v10: u16x4 = u16x4{65535, 65535, 65535, 0};
    v10[0] = v10[0] ^ s_u16;
    h      = fold_i32x4(h, widen_mul_mixed(v9, v10));
    var v11: i32x2 = i32x2{-2147483648, -2147483648};
    v11[0] = v11[0] ^ s_i32;
    var v12: i32x2 = i32x2{-2147483648, 2147483647};
    v12[0] = v12[0] ^ s_i32;
    h      = fold_i64x2(h, widen_mul_i32x2(v11, v12));
    var v13: i32x2 = i32x2{2147483647, 123456789};
    v13[0] = v13[0] ^ s_i32;
    var v14: i32x2 = i32x2{-1, -987654321};
    v14[0] = v14[0] ^ s_i32;
    h      = fold_i64x2(h, widen_mul_i32x2(v13, v14));
    var v15: u32x2 = u32x2{4294967295, 4294967295};
    v15[0] = v15[0] ^ s_u32;
    var v16: u32x2 = u32x2{4294967295, 2};
    v16[0] = v16[0] ^ s_u32;
    h      = fold_u64x2(h, widen_mul_u32x2(v15, v16));
    var v17: u32x2 = u32x2{2147483648, 0};
    v17[0] = v17[0] ^ s_u32;
    var v18: u32x2 = u32x2{2147483648, 4294967295};
    v18[0] = v18[0] ^ s_u32;
    h      = fold_u64x2(h, widen_mul_u32x2(v17, v18));
    ret h;
}
