# the vector rows at 64-bit lanes: one noinline probe per (operation, signedness
# and, for a compare, predicate) of the retained vector vocabulary, so the golden
# shows each probe's body on its own and the decoder witnesses which cells the
# target packs and which it expands per lane. every lane result folds in order.

use corpus.lib.fold;

#[noinline]
fun row_add_f64(a: f64x2, b: f64x2) f64x2 {
    ret a + b;
}

#[noinline]
fun row_sub_f64(a: f64x2, b: f64x2) f64x2 {
    ret a - b;
}

#[noinline]
fun row_mul_f64(a: f64x2, b: f64x2) f64x2 {
    ret a * b;
}

#[noinline]
fun row_div_f64(a: f64x2, b: f64x2) f64x2 {
    ret a / b;
}

#[noinline]
fun row_cmp_lt_f64(a: f64x2, b: f64x2) u64x2 {
    ret a < b;
}

#[noinline]
fun row_cmp_eq_f64(a: f64x2, b: f64x2) u64x2 {
    ret a == b;
}

fun fold_f64x2(h: u64, v: f64x2) u64 {
    var a: u64 = h;
    a = fold.mix_f64(a, v[0]);
    a = fold.mix_f64(a, v[1]);
    ret a;
}

fun fold_u64x2(h: u64, v: u64x2) u64 {
    var a: u64 = h;
    a = fold.mix_u64(a, v[0]);
    a = fold.mix_u64(a, v[1]);
    ret a;
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: f64 = seed::f64;
    {
        var a: f64x2 = f64x2{1.5, -2.25};
        var b: f64x2 = f64x2{0.5, 4.0};
        a[0] = a[0] + s;
        h    = fold_f64x2(h, row_add_f64(a, b));
    }
    {
        var a: f64x2 = f64x2{1.5, -2.25};
        var b: f64x2 = f64x2{0.5, 4.0};
        a[0] = a[0] + s;
        h    = fold_f64x2(h, row_sub_f64(a, b));
    }
    {
        var a: f64x2 = f64x2{1.5, -2.25};
        var b: f64x2 = f64x2{0.5, 4.0};
        a[0] = a[0] + s;
        h    = fold_f64x2(h, row_mul_f64(a, b));
    }
    {
        var a: f64x2 = f64x2{1.5, -2.25};
        var b: f64x2 = f64x2{0.5, 4.0};
        a[0] = a[0] + s;
        h    = fold_f64x2(h, row_div_f64(a, b));
    }
    {
        var a: f64x2 = f64x2{1.5, -2.25};
        var b: f64x2 = f64x2{0.5, 4.0};
        a[0] = a[0] + s;
        h    = fold_u64x2(h, row_cmp_lt_f64(a, b));
    }
    {
        var a: f64x2 = f64x2{1.5, -2.25};
        var b: f64x2 = f64x2{0.5, 4.0};
        a[0] = a[0] + s;
        h    = fold_u64x2(h, row_cmp_eq_f64(a, b));
    }
    ret h;
}
