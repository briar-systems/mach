# f32x4 exactly fills a 128-bit vector register: $size_of is 16 and $align_of is 16.
# every lane runs through add, sub, mul and div, and every result is folded in lane
# order against a ramp whose lanes are all distinct, so a lane that lands in the
# wrong position changes the checksum instead of cancelling out.

use corpus.lib.fold;

rec Pair {
    lead: u32;
    v: f32x4;
    trail: u32;
}

fun fold_vec(h: u64, v: f32x4) u64 {
    var a: u64 = fold.mix_f32(h, v[0]);
    a = fold.mix_f32(a, v[1]);
    a = fold.mix_f32(a, v[2]);
    a = fold.mix_f32(a, v[3]);
    ret a;
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val z: f32 = seed::f32;

    var a: f32x4 = f32x4{1.5, -2.25, 3.75, -0.5};
    var b: f32x4 = f32x4{0.5, 4.0, -0.125, 8.0};
    val ramp: f32x4 = f32x4{1.0, 3.0, 9.0, 27.0};
    a[0] = a[0] + z;
    a[3] = a[3] + z;
    b[1] = b[1] + z;
    b[2] = b[2] + z;

    h = fold_vec(h, a);
    h = fold_vec(h, b);
    h = fold_vec(h, a + b);
    h = fold_vec(h, a - b);
    h = fold_vec(h, b - a);
    h = fold_vec(h, a * b);
    h = fold_vec(h, a / b);
    h = fold_vec(h, b / a);
    h = fold_vec(h, a * ramp);
    h = fold_vec(h, ramp - b);
    h = fold_vec(h, ramp / a);

    # the product is folded before it is added, so neither side may contract the
    # pair into a fused multiply-add
    var acc: f32x4 = f32x4{0.0, 0.0, 0.0, 0.0};
    var i: u64 = 0;
    for (i < 6) {
        val t: f32x4 = a * ramp;
        h = fold_vec(h, t);
        acc = acc + t;
        h = fold_vec(h, acc);
        a = a - b;
        h = fold_vec(h, a);
        i = i + 1;
    }

    var arr: [4]f32x4;
    arr[0] = a;
    arr[1] = a + b;
    arr[2] = a * ramp;
    arr[3] = acc;
    var k: u64 = 0;
    for (k < 4) {
        h = fold_vec(h, arr[k]);
        k = k + 1;
    }

    # scalars either side of the vector, so a wrong size or alignment moves a neighbour
    var r: Pair;
    r.lead = 4294967295;
    r.v = arr[2];
    r.trail = 305419896;
    h = fold.mix_u32(h, r.lead);
    h = fold_vec(h, r.v);
    h = fold.mix_u32(h, r.trail);
    ret h;
}
