# the vector rows at 32-bit lanes: one noinline probe per (operation, signedness
# and, for a compare, predicate) of the retained vector vocabulary, so the golden
# shows each probe's body on its own and the decoder witnesses which cells the
# target packs and which it expands per lane. every lane result folds in order.

use corpus.lib.fold;

#[noinline]
fun row_add_i32(a: i32x4, b: i32x4) i32x4 {
    ret a + b;
}

#[noinline]
fun row_add_u32(a: u32x4, b: u32x4) u32x4 {
    ret a + b;
}

#[noinline]
fun row_sub_i32(a: i32x4, b: i32x4) i32x4 {
    ret a - b;
}

#[noinline]
fun row_sub_u32(a: u32x4, b: u32x4) u32x4 {
    ret a - b;
}

#[noinline]
fun row_mul_i32(a: i32x4, b: i32x4) i32x4 {
    ret a * b;
}

#[noinline]
fun row_mul_u32(a: u32x4, b: u32x4) u32x4 {
    ret a * b;
}

#[noinline]
fun row_div_i32(a: i32x4, b: i32x4) i32x4 {
    ret a / b;
}

#[noinline]
fun row_div_u32(a: u32x4, b: u32x4) u32x4 {
    ret a / b;
}

#[noinline]
fun row_and_i32(a: i32x4, b: i32x4) i32x4 {
    ret a & b;
}

#[noinline]
fun row_and_u32(a: u32x4, b: u32x4) u32x4 {
    ret a & b;
}

#[noinline]
fun row_or_i32(a: i32x4, b: i32x4) i32x4 {
    ret a | b;
}

#[noinline]
fun row_or_u32(a: u32x4, b: u32x4) u32x4 {
    ret a | b;
}

#[noinline]
fun row_xor_i32(a: i32x4, b: i32x4) i32x4 {
    ret a ^ b;
}

#[noinline]
fun row_xor_u32(a: u32x4, b: u32x4) u32x4 {
    ret a ^ b;
}

#[noinline]
fun row_not_i32(a: i32x4) i32x4 {
    ret ~a;
}

#[noinline]
fun row_not_u32(a: u32x4) u32x4 {
    ret ~a;
}

#[noinline]
fun row_cmp_lt_i32(a: i32x4, b: i32x4) u32x4 {
    ret a < b;
}

#[noinline]
fun row_cmp_eq_i32(a: i32x4, b: i32x4) u32x4 {
    ret a == b;
}

#[noinline]
fun row_cmp_lt_u32(a: u32x4, b: u32x4) u32x4 {
    ret a < b;
}

#[noinline]
fun row_cmp_eq_u32(a: u32x4, b: u32x4) u32x4 {
    ret a == b;
}

fun fold_i32x4(h: u64, v: i32x4) u64 {
    var a: u64 = h;
    a = fold.mix_i32(a, v[0]);
    a = fold.mix_i32(a, v[1]);
    a = fold.mix_i32(a, v[2]);
    a = fold.mix_i32(a, v[3]);
    ret a;
}

fun fold_u32x4(h: u64, v: u32x4) u64 {
    var a: u64 = h;
    a = fold.mix_u32(a, v[0]);
    a = fold.mix_u32(a, v[1]);
    a = fold.mix_u32(a, v[2]);
    a = fold.mix_u32(a, v[3]);
    ret a;
}

pub fun checksum(seed: u64) u64 {
    var h:     u64 = fold.init();
    val si:    i32 = seed::i32;
    val su:    u32 = seed::u32;
    val imin:  i32 = (2147483648::u32):~i32;
    val imin1: i32 = imin + 1;
    {
        var a: i32x4 = i32x4{2147483647, imin, 7, -3};
        var b: i32x4 = i32x4{3, 2, -7, 5};
        a[0] = a[0] + si;
        h    = fold_i32x4(h, row_add_i32(a, b));
    }
    {
        var a: u32x4 = u32x4{4294967295, 0, 7, 3};
        var b: u32x4 = u32x4{3, 2, 7, 5};
        a[0] = a[0] + su;
        h    = fold_u32x4(h, row_add_u32(a, b));
    }
    {
        var a: i32x4 = i32x4{2147483647, imin, 7, -3};
        var b: i32x4 = i32x4{3, 2, -7, 5};
        a[0] = a[0] + si;
        h    = fold_i32x4(h, row_sub_i32(a, b));
    }
    {
        var a: u32x4 = u32x4{4294967295, 0, 7, 3};
        var b: u32x4 = u32x4{3, 2, 7, 5};
        a[0] = a[0] + su;
        h    = fold_u32x4(h, row_sub_u32(a, b));
    }
    {
        var a: i32x4 = i32x4{2147483647, imin, 7, -3};
        var b: i32x4 = i32x4{3, 2, -7, 5};
        a[0] = a[0] + si;
        h    = fold_i32x4(h, row_mul_i32(a, b));
    }
    {
        var a: u32x4 = u32x4{4294967295, 0, 7, 3};
        var b: u32x4 = u32x4{3, 2, 7, 5};
        a[0] = a[0] + su;
        h    = fold_u32x4(h, row_mul_u32(a, b));
    }
    {
        var a: i32x4 = i32x4{2147483647, imin, 7, -3};
        var b: i32x4 = i32x4{3, 2, -7, 5};
        a[0] = a[0] + si;
        h    = fold_i32x4(h, row_div_i32(a, b));
    }
    {
        var a: u32x4 = u32x4{4294967295, 0, 7, 3};
        var b: u32x4 = u32x4{3, 2, 7, 5};
        a[0] = a[0] + su;
        h    = fold_u32x4(h, row_div_u32(a, b));
    }
    {
        var a: i32x4 = i32x4{2147483647, imin, 7, -3};
        var b: i32x4 = i32x4{3, 2, -7, 5};
        a[0] = a[0] + si;
        h    = fold_i32x4(h, row_and_i32(a, b));
    }
    {
        var a: u32x4 = u32x4{4294967295, 0, 7, 3};
        var b: u32x4 = u32x4{3, 2, 7, 5};
        a[0] = a[0] + su;
        h    = fold_u32x4(h, row_and_u32(a, b));
    }
    {
        var a: i32x4 = i32x4{2147483647, imin, 7, -3};
        var b: i32x4 = i32x4{3, 2, -7, 5};
        a[0] = a[0] + si;
        h    = fold_i32x4(h, row_or_i32(a, b));
    }
    {
        var a: u32x4 = u32x4{4294967295, 0, 7, 3};
        var b: u32x4 = u32x4{3, 2, 7, 5};
        a[0] = a[0] + su;
        h    = fold_u32x4(h, row_or_u32(a, b));
    }
    {
        var a: i32x4 = i32x4{2147483647, imin, 7, -3};
        var b: i32x4 = i32x4{3, 2, -7, 5};
        a[0] = a[0] + si;
        h    = fold_i32x4(h, row_xor_i32(a, b));
    }
    {
        var a: u32x4 = u32x4{4294967295, 0, 7, 3};
        var b: u32x4 = u32x4{3, 2, 7, 5};
        a[0] = a[0] + su;
        h    = fold_u32x4(h, row_xor_u32(a, b));
    }
    {
        var a: i32x4 = i32x4{2147483647, imin, 7, -3};
        a[0] = a[0] + si;
        h    = fold_i32x4(h, row_not_i32(a));
    }
    {
        var a: u32x4 = u32x4{4294967295, 0, 7, 3};
        a[0] = a[0] + su;
        h    = fold_u32x4(h, row_not_u32(a));
    }
    {
        var a: i32x4 = i32x4{2147483647, imin, 7, -3};
        var b: i32x4 = i32x4{3, 2, -7, 5};
        a[0] = a[0] + si;
        h    = fold_u32x4(h, row_cmp_lt_i32(a, b));
    }
    {
        var a: i32x4 = i32x4{2147483647, imin, 7, -3};
        var b: i32x4 = i32x4{3, 2, -7, 5};
        a[0] = a[0] + si;
        h    = fold_u32x4(h, row_cmp_eq_i32(a, b));
    }
    {
        var a: u32x4 = u32x4{4294967295, 0, 7, 3};
        var b: u32x4 = u32x4{3, 2, 7, 5};
        a[0] = a[0] + su;
        h    = fold_u32x4(h, row_cmp_lt_u32(a, b));
    }
    {
        var a: u32x4 = u32x4{4294967295, 0, 7, 3};
        var b: u32x4 = u32x4{3, 2, 7, 5};
        a[0] = a[0] + su;
        h    = fold_u32x4(h, row_cmp_eq_u32(a, b));
    }
    ret h;
}
