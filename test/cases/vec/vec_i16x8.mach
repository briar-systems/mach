# i16x8 fills a 128-bit vector register with eight signed halfword lanes: $size_of
# is 16 and $align_of is 16. this is the one integer shape x86_64 has a packed
# multiply for, so the packed and the expanded lowerings must produce the same
# lanes. lane magnitudes are bounded so no sum or product leaves the i16 range.

use corpus.lib.fold;

rec Pair {
    lead: u32;
    v: i16x8;
    trail: u32;
}

fun fold_vec(h: u64, v: i16x8) u64 {
    var a: u64 = fold.mix_i16(h, v[0]);
    a = fold.mix_i16(a, v[1]);
    a = fold.mix_i16(a, v[2]);
    a = fold.mix_i16(a, v[3]);
    a = fold.mix_i16(a, v[4]);
    a = fold.mix_i16(a, v[5]);
    a = fold.mix_i16(a, v[6]);
    a = fold.mix_i16(a, v[7]);
    ret a;
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: i16 = seed::i16;

    var a: i16x8 = i16x8{1001, -1103, 1207, -1301, 1409, -1511, 1601, -1709};
    var b: i16x8 = i16x8{13, -11, 9, -7, 5, -3, 2, -1};
    val ramp: i16x8 = i16x8{1, 2, 3, 4, 5, 6, 7, 8};
    val zero: i16x8 = i16x8{0, 0, 0, 0, 0, 0, 0, 0};
    a[0] = a[0] + s;
    a[6] = a[6] + s;
    b[2] = b[2] + s;
    b[7] = b[7] + s;

    h = fold_vec(h, a);
    h = fold_vec(h, b);
    h = fold_vec(h, a + b);
    h = fold_vec(h, a - b);
    h = fold_vec(h, b - a);
    h = fold_vec(h, a * b);
    h = fold_vec(h, a * ramp);
    h = fold_vec(h, b * ramp);
    h = fold_vec(h, (a + b) * ramp);
    h = fold_vec(h, zero - a);
    h = fold_vec(h, zero - b);
    h = fold_vec(h, a & b);
    h = fold_vec(h, a | b);
    h = fold_vec(h, a ^ b);
    h = fold_vec(h, ~a);
    h = fold_vec(h, ~b);
    h = fold_vec(h, (a & b) ^ (a | b));

    var acc: i16x8 = zero;
    var sum: i16x8 = zero;
    var i: u64 = 0;
    for (i < 6) {
        val t: i16x8 = a * ramp;
        h = fold_vec(h, t);
        acc = acc ^ t;
        h = fold_vec(h, acc);
        sum = sum + a;
        h = fold_vec(h, sum);
        a = a + b;
        h = fold_vec(h, a);
        i = i + 1;
    }

    var arr: [4]i16x8;
    arr[0] = a;
    arr[1] = a + b;
    arr[2] = a * ramp;
    arr[3] = acc;
    var k: u64 = 0;
    for (k < 4) {
        h = fold_vec(h, arr[k]);
        k = k + 1;
    }

    # scalars either side of the vector, so a wrong size or alignment moves a neighbour
    var r: Pair;
    r.lead = 4294967295;
    r.v = arr[2];
    r.trail = 305419896;
    h = fold.mix_u32(h, r.lead);
    h = fold_vec(h, r.v);
    h = fold.mix_u32(h, r.trail);
    ret h;
}
