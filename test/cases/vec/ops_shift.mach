}

#[noinline]
fun shift_left_u64x2(v: u64x2, c: u64) u64x2 {
    ret v << u64x2{c, c};
}

#[noinline]
fun shift_right_u64x2(v: u64x2, c: u64) u64x2 {
    ret v >> u64x2{c, c};
}

#[noinline]
fun shift_left_lanes_u64x2(v: u64x2, c: u64x2) u64x2 {
    ret v << c;
}

#[noinline]
fun shift_right_lanes_u64x2(v: u64x2, c: u64x2) u64x2 {
    ret v >> c;
}

#[noinline]
fun shift_left_i64x2(v: i64x2, c: i64) i64x2 {
    ret v << i64x2{c, c};
}

#[noinline]
fun shift_right_i64x2(v: i64x2, c: i64) i64x2 {
    ret v >> i64x2{c, c};
}

#[noinline]
fun shift_left_lanes_i64x2(v: i64x2, c: i64x2) i64x2 {
    ret v << c;
}

#[noinline]
fun shift_right_lanes_i64x2(v: i64x2, c: i64x2) i64x2 {
    ret v >> c;
}

fun fold_i16x8(h: u64, v: i16x8) u64 {
    var a: u64 = h;
    a = fold.mix_i16(a, v[0]);
    a = fold.mix_i16(a, v[1]);
    a = fold.mix_i16(a, v[2]);
    a = fold.mix_i16(a, v[3]);
    a = fold.mix_i16(a, v[4]);
    a = fold.mix_i16(a, v[5]);
    a = fold.mix_i16(a, v[6]);
    a = fold.mix_i16(a, v[7]);
    ret a;
}

fun fold_i32x4(h: u64, v: i32x4) u64 {
    var a: u64 = h;
    a = fold.mix_i32(a, v[0]);
    a = fold.mix_i32(a, v[1]);
    a = fold.mix_i32(a, v[2]);
    a = fold.mix_i32(a, v[3]);
    ret a;
}

fun fold_i64x2(h: u64, v: i64x2) u64 {
    var a: u64 = h;
    a = fold.mix_i64(a, v[0]);
    a = fold.mix_i64(a, v[1]);
    ret a;
}

fun fold_i8x16(h: u64, v: i8x16) u64 {
    var a: u64 = h;
    a = fold.mix_i8(a, v[0]);
    a = fold.mix_i8(a, v[1]);
    a = fold.mix_i8(a, v[2]);
    a = fold.mix_i8(a, v[3]);
    a = fold.mix_i8(a, v[4]);
    a = fold.mix_i8(a, v[5]);
    a = fold.mix_i8(a, v[6]);
    a = fold.mix_i8(a, v[7]);
    a = fold.mix_i8(a, v[8]);
    a = fold.mix_i8(a, v[9]);
    a = fold.mix_i8(a, v[10]);
    a = fold.mix_i8(a, v[11]);
    a = fold.mix_i8(a, v[12]);
    a = fold.mix_i8(a, v[13]);
    a = fold.mix_i8(a, v[14]);
    a = fold.mix_i8(a, v[15]);
    ret a;
}

fun fold_u16x8(h: u64, v: u16x8) u64 {
    var a: u64 = h;
    a = fold.mix_u16(a, v[0]);
    a = fold.mix_u16(a, v[1]);
    a = fold.mix_u16(a, v[2]);
    a = fold.mix_u16(a, v[3]);
    a = fold.mix_u16(a, v[4]);
    a = fold.mix_u16(a, v[5]);
    a = fold.mix_u16(a, v[6]);
    a = fold.mix_u16(a, v[7]);
    ret a;
}

fun fold_u32x4(h: u64, v: u32x4) u64 {
    var a: u64 = h;
    a = fold.mix_u32(a, v[0]);
    a = fold.mix_u32(a, v[1]);
    a = fold.mix_u32(a, v[2]);
    a = fold.mix_u32(a, v[3]);
    ret a;
}

fun fold_u64x2(h: u64, v: u64x2) u64 {
    var a: u64 = h;
    a = fold.mix_u64(a, v[0]);
    a = fold.mix_u64(a, v[1]);
    ret a;
}

fun fold_u8x16(h: u64, v: u8x16) u64 {
    var a: u64 = h;
    a = fold.mix_u8(a, v[0]);
    a = fold.mix_u8(a, v[1]);
    a = fold.mix_u8(a, v[2]);
    a = fold.mix_u8(a, v[3]);
    a = fold.mix_u8(a, v[4]);
    a = fold.mix_u8(a, v[5]);
    a = fold.mix_u8(a, v[6]);
    a = fold.mix_u8(a, v[7]);
    a = fold.mix_u8(a, v[8]);
    a = fold.mix_u8(a, v[9]);
    a = fold.mix_u8(a, v[10]);
    a = fold.mix_u8(a, v[11]);
    a = fold.mix_u8(a, v[12]);
    a = fold.mix_u8(a, v[13]);
    a = fold.mix_u8(a, v[14]);
    a = fold.mix_u8(a, v[15]);
    ret a;
}

pub fun checksum(seed: u64) u64 {
    var h:     u64 = fold.init();
    val s_i16: i16 = seed::i16;
    val s_i32: i32 = seed::i32;
    val s_i64: i64 = seed::i64;
    val s_i8:  i8  = seed::i8;
    val s_u16: u16 = seed::u16;
    val s_u32: u32 = seed::u32;
    val s_u64: u64 = seed;
    val s_u8:  u8  = seed::u8;

    var v1: u8x16 = u8x16{1, 128, 127, 165, 255, 3, 64, 129, 1, 128, 127, 165, 255, 3, 64, 129};
    v1[0] = v1[0] ^ s_u8;
    h     = fold_u8x16(h, v1 << u8x16{2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2});
    h     = fold_u8x16(h, v1 >> u8x16{7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7});
    h     = fold_u8x16(h, shift_left_u8x16(v1, 0));
    h     = fold_u8x16(h, shift_right_u8x16(v1, 0));
    h     = fold_u8x16(h, shift_left_u8x16(v1, 1));
    h     = fold_u8x16(h, shift_right_u8x16(v1, 1));
    h     = fold_u8x16(h, shift_left_u8x16(v1, 7));
    h     = fold_u8x16(h, shift_right_u8x16(v1, 7));
    h     = fold_u8x16(h, shift_left_u8x16(v1, 8));
    h     = fold_u8x16(h, shift_right_u8x16(v1, 8));
    h     = fold_u8x16(h, shift_left_u8x16(v1, 9));
    h     = fold_u8x16(h, shift_right_u8x16(v1, 9));
    h     = fold_u8x16(h, shift_left_u8x16(v1, 16));
    h     = fold_u8x16(h, shift_right_u8x16(v1, 16));
    h     = fold_u8x16(h, shift_left_u8x16(v1, 33));
    h     = fold_u8x16(h, shift_right_u8x16(v1, 33));
    h     = fold_u8x16(h, shift_left_u8x16(v1, 255));
    h     = fold_u8x16(h, shift_right_u8x16(v1, 255));
    var v2: u8x16 = u8x16{0, 1, 7, 8, 3, 200, 5, 9, 0, 1, 7, 8, 3, 200, 5, 9};
    h = fold_u8x16(h, shift_left_lanes_u8x16(v1, v2));
    h = fold_u8x16(h, shift_right_lanes_u8x16(v1, v2));
    var v3: i8x16 = i8x16{1, -128, 127, -91, -1, 3, 64, -127, 1, -128, 127, -91, -1, 3, 64, -127};
    v3[0] = v3[0] ^ s_i8;
    h     = fold_i8x16(h, v3 << i8x16{2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2});
    h     = fold_i8x16(h, v3 >> i8x16{7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7});
    h     = fold_i8x16(h, shift_left_i8x16(v3, 0));
    h     = fold_i8x16(h, shift_right_i8x16(v3, 0));
    h     = fold_i8x16(h, shift_left_i8x16(v3, 1));
    h     = fold_i8x16(h, shift_right_i8x16(v3, 1));
    h     = fold_i8x16(h, shift_left_i8x16(v3, 7));
    h     = fold_i8x16(h, shift_right_i8x16(v3, 7));
    h     = fold_i8x16(h, shift_left_i8x16(v3, 8));
    h     = fold_i8x16(h, shift_right_i8x16(v3, 8));
    h     = fold_i8x16(h, shift_left_i8x16(v3, 9));
    h     = fold_i8x16(h, shift_right_i8x16(v3, 9));
    h     = fold_i8x16(h, shift_left_i8x16(v3, 16));
    h     = fold_i8x16(h, shift_right_i8x16(v3, 16));
    h     = fold_i8x16(h, shift_left_i8x16(v3, 33));
    h     = fold_i8x16(h, shift_right_i8x16(v3, 33));
    h     = fold_i8x16(h, shift_left_i8x16(v3, 127));
    h     = fold_i8x16(h, shift_right_i8x16(v3, 127));
    h     = fold_i8x16(h, shift_left_i8x16(v3, -1));
    h     = fold_i8x16(h, shift_right_i8x16(v3, -1));
    h     = fold_i8x16(h, shift_left_i8x16(v3, -128));
    h     = fold_i8x16(h, shift_right_i8x16(v3, -128));
    var v4: i8x16 = i8x16{0, 1, 7, 8, 3, -1, 5, 9, 0, 1, 7, 8, 3, -1, 5, 9};
    h = fold_i8x16(h, shift_left_lanes_i8x16(v3, v4));
    h = fold_i8x16(h, shift_right_lanes_i8x16(v3, v4));
    var v5: u16x8 = u16x8{1, 32768, 32767, 42330, 65535, 3, 16384, 32769};
    v5[0] = v5[0] ^ s_u16;
    h     = fold_u16x8(h, v5 << u16x8{5, 5, 5, 5, 5, 5, 5, 5});
    h     = fold_u16x8(h, v5 >> u16x8{15, 15, 15, 15, 15, 15, 15, 15});
    h     = fold_u16x8(h, shift_left_u16x8(v5, 0));
    h     = fold_u16x8(h, shift_right_u16x8(v5, 0));
    h     = fold_u16x8(h, shift_left_u16x8(v5, 1));
    h     = fold_u16x8(h, shift_right_u16x8(v5, 1));
    h     = fold_u16x8(h, shift_left_u16x8(v5, 15));
    h     = fold_u16x8(h, shift_right_u16x8(v5, 15));
    h     = fold_u16x8(h, shift_left_u16x8(v5, 16));
    h     = fold_u16x8(h, shift_right_u16x8(v5, 16));
    h     = fold_u16x8(h, shift_left_u16x8(v5, 17));
    h     = fold_u16x8(h, shift_right_u16x8(v5, 17));
    h     = fold_u16x8(h, shift_left_u16x8(v5, 33));
    h     = fold_u16x8(h, shift_right_u16x8(v5, 33));
    h     = fold_u16x8(h, shift_left_u16x8(v5, 257));
    h     = fold_u16x8(h, shift_right_u16x8(v5, 257));
    h     = fold_u16x8(h, shift_left_u16x8(v5, 65535));
    h     = fold_u16x8(h, shift_right_u16x8(v5, 65535));
    var v6: u16x8 = u16x8{0, 1, 15, 16, 3, 300, 5, 17};
    h = fold_u16x8(h, shift_left_lanes_u16x8(v5, v6));
    h = fold_u16x8(h, shift_right_lanes_u16x8(v5, v6));
    var v7: u16x8 = u16x8{257, 256, 16, 65535, 513, 2, 17, 258};
    h = fold_u16x8(h, shift_left_lanes_u16x8(v5, v7));
    h = fold_u16x8(h, shift_right_lanes_u16x8(v5, v7));
    var v8: i16x8 = i16x8{1, -32768, 32767, -23206, -1, 3, 16384, -32767};
    v8[0] = v8[0] ^ s_i16;
    h     = fold_i16x8(h, v8 << i16x8{5, 5, 5, 5, 5, 5, 5, 5});
    h     = fold_i16x8(h, v8 >> i16x8{15, 15, 15, 15, 15, 15, 15, 15});
    h     = fold_i16x8(h, shift_left_i16x8(v8, 0));
    h     = fold_i16x8(h, shift_right_i16x8(v8, 0));
    h     = fold_i16x8(h, shift_left_i16x8(v8, 1));
    h     = fold_i16x8(h, shift_right_i16x8(v8, 1));
    h     = fold_i16x8(h, shift_left_i16x8(v8, 15));
    h     = fold_i16x8(h, shift_right_i16x8(v8, 15));
    h     = fold_i16x8(h, shift_left_i16x8(v8, 16));
    h     = fold_i16x8(h, shift_right_i16x8(v8, 16));
    h     = fold_i16x8(h, shift_left_i16x8(v8, 17));
    h     = fold_i16x8(h, shift_right_i16x8(v8, 17));
    h     = fold_i16x8(h, shift_left_i16x8(v8, 33));
    h     = fold_i16x8(h, shift_right_i16x8(v8, 33));
    h     = fold_i16x8(h, shift_left_i16x8(v8, 257));
    h     = fold_i16x8(h, shift_right_i16x8(v8, 257));
    h     = fold_i16x8(h, shift_left_i16x8(v8, -1));
    h     = fold_i16x8(h, shift_right_i16x8(v8, -1));
    h     = fold_i16x8(h, shift_left_i16x8(v8, -32768));
    h     = fold_i16x8(h, shift_right_i16x8(v8, -32768));
    var v9: i16x8 = i16x8{0, 1, 15, 16, 3, -1, 5, 17};
    h = fold_i16x8(h, shift_left_lanes_i16x8(v8, v9));
    h = fold_i16x8(h, shift_right_lanes_i16x8(v8, v9));
    var v10: i16x8 = i16x8{257, 256, 16, -1, 513, 2, 17, -32767};
    h = fold_i16x8(h, shift_left_lanes_i16x8(v8, v10));
    h = fold_i16x8(h, shift_right_lanes_i16x8(v8, v10));
    var v11: u32x4 = u32x4{1, 2147483648, 2147483647, 3735928559};
    v11[0] = v11[0] ^ s_u32;
    h      = fold_u32x4(h, v11 << u32x4{10, 10, 10, 10});
    h      = fold_u32x4(h, v11 >> u32x4{31, 31, 31, 31});
    h      = fold_u32x4(h, shift_left_u32x4(v11, 0));
    h      = fold_u32x4(h, shift_right_u32x4(v11, 0));
    h      = fold_u32x4(h, shift_left_u32x4(v11, 1));
    h      = fold_u32x4(h, shift_right_u32x4(v11, 1));
    h      = fold_u32x4(h, shift_left_u32x4(v11, 31));
    h      = fold_u32x4(h, shift_right_u32x4(v11, 31));
    h      = fold_u32x4(h, shift_left_u32x4(v11, 32));
    h      = fold_u32x4(h, shift_right_u32x4(v11, 32));
    h      = fold_u32x4(h, shift_left_u32x4(v11, 33));
    h      = fold_u32x4(h, shift_right_u32x4(v11, 33));
    h      = fold_u32x4(h, shift_left_u32x4(v11, 64));
    h      = fold_u32x4(h, shift_right_u32x4(v11, 64));
    h      = fold_u32x4(h, shift_left_u32x4(v11, 257));
    h      = fold_u32x4(h, shift_right_u32x4(v11, 257));
    h      = fold_u32x4(h, shift_left_u32x4(v11, 4294967295));
    h      = fold_u32x4(h, shift_right_u32x4(v11, 4294967295));
    var v12: u32x4 = u32x4{0, 31, 32, 40};
    h = fold_u32x4(h, shift_left_lanes_u32x4(v11, v12));
    h = fold_u32x4(h, shift_right_lanes_u32x4(v11, v12));
    var v13: u32x4 = u32x4{257, 256, 33, 4294967041};
    h = fold_u32x4(h, shift_left_lanes_u32x4(v11, v13));
    h = fold_u32x4(h, shift_right_lanes_u32x4(v11, v13));
    var v14: i32x4 = i32x4{1, -2147483648, 2147483647, -559038737};
    v14[0] = v14[0] ^ s_i32;
    h      = fold_i32x4(h, v14 << i32x4{10, 10, 10, 10});
    h      = fold_i32x4(h, v14 >> i32x4{31, 31, 31, 31});
    h      = fold_i32x4(h, shift_left_i32x4(v14, 0));
    h      = fold_i32x4(h, shift_right_i32x4(v14, 0));
    h      = fold_i32x4(h, shift_left_i32x4(v14, 1));
    h      = fold_i32x4(h, shift_right_i32x4(v14, 1));
    h      = fold_i32x4(h, shift_left_i32x4(v14, 31));
    h      = fold_i32x4(h, shift_right_i32x4(v14, 31));
    h      = fold_i32x4(h, shift_left_i32x4(v14, 32));
    h      = fold_i32x4(h, shift_right_i32x4(v14, 32));
    h      = fold_i32x4(h, shift_left_i32x4(v14, 33));
    h      = fold_i32x4(h, shift_right_i32x4(v14, 33));
