}

#[noinline]
fun shift_left_i32x4(v: i32x4, c: i32) i32x4 {
    ret v << i32x4{c, c, c, c};
}

#[noinline]
fun shift_right_i32x4(v: i32x4, c: i32) i32x4 {
    ret v >> i32x4{c, c, c, c};
}

#[noinline]
fun shift_left_lanes_i32x4(v: i32x4, c: i32x4) i32x4 {
    ret v << c;
}

#[noinline]
fun shift_right_lanes_i32x4(v: i32x4, c: i32x4) i32x4 {
