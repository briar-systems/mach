# each lane shifts as the scalar operator does, at every lane width and
# signedness: by a uniform constant, by a uniform count at run time and by a
# count per lane, including counts at and past the lane width, which saturate
# to 0 or to the sign fill for a signed `>>`, negative counts, and counts whose
# low byte is small but whose value is out of range. every lane of every
# result folds

use corpus.lib.fold;

#[expect("vector.scalarize")]
#[noinline]
fun shift_left_u8x16(v: u8x16, c: u8) u8x16 {
    ret v << u8x16{c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c};
}

#[expect("vector.scalarize")]
#[noinline]
fun shift_right_u8x16(v: u8x16, c: u8) u8x16 {
    ret v >> u8x16{c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c};
}

#[expect("vector.scalarize")]
#[noinline]
fun shift_left_lanes_u8x16(v: u8x16, c: u8x16) u8x16 {
    ret v << c;
}

#[expect("vector.scalarize")]
#[noinline]
fun shift_right_lanes_u8x16(v: u8x16, c: u8x16) u8x16 {
    ret v >> c;
}

#[expect("vector.scalarize")]
#[noinline]
fun shift_left_i8x16(v: i8x16, c: i8) i8x16 {
    ret v << i8x16{c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c};
}

#[expect("vector.scalarize")]
#[noinline]
fun shift_right_i8x16(v: i8x16, c: i8) i8x16 {
    ret v >> i8x16{c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c};
}

#[expect("vector.scalarize")]
#[noinline]
fun shift_left_lanes_i8x16(v: i8x16, c: i8x16) i8x16 {
    ret v << c;
}

#[expect("vector.scalarize")]
#[noinline]
fun shift_right_lanes_i8x16(v: i8x16, c: i8x16) i8x16 {
    ret v >> c;
}

#[noinline]
fun shift_left_u16x8(v: u16x8, c: u16) u16x8 {
    ret v << u16x8{c, c, c, c, c, c, c, c};
}

#[noinline]
fun shift_right_u16x8(v: u16x8, c: u16) u16x8 {
    ret v >> u16x8{c, c, c, c, c, c, c, c};
}

#[noinline]
fun shift_left_lanes_u16x8(v: u16x8, c: u16x8) u16x8 {
    ret v << c;
}

#[noinline]
fun shift_right_lanes_u16x8(v: u16x8, c: u16x8) u16x8 {
    ret v >> c;
}

#[noinline]
fun shift_left_i16x8(v: i16x8, c: i16) i16x8 {
    ret v << i16x8{c, c, c, c, c, c, c, c};
}

#[noinline]
fun shift_right_i16x8(v: i16x8, c: i16) i16x8 {
    ret v >> i16x8{c, c, c, c, c, c, c, c};
}

#[noinline]
fun shift_left_lanes_i16x8(v: i16x8, c: i16x8) i16x8 {
    ret v << c;
}

#[noinline]
fun shift_right_lanes_i16x8(v: i16x8, c: i16x8) i16x8 {
    ret v >> c;
}

#[noinline]
fun shift_left_u32x4(v: u32x4, c: u32) u32x4 {
    ret v << u32x4{c, c, c, c};
}

#[noinline]
fun shift_right_u32x4(v: u32x4, c: u32) u32x4 {
    ret v >> u32x4{c, c, c, c};
}

#[noinline]
fun shift_left_lanes_u32x4(v: u32x4, c: u32x4) u32x4 {
    ret v << c;
}

#[noinline]
fun shift_right_lanes_u32x4(v: u32x4, c: u32x4) u32x4 {
