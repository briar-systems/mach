# the vector rows at 64-bit lanes: one noinline probe per (operation, signedness
# and, for a compare, predicate) of the retained vector vocabulary, so the golden
# shows each probe's body on its own and the decoder witnesses which cells the
# target packs and which it expands per lane. every lane result folds in order.

use corpus.lib.fold;

#[noinline]
fun row_add_i64(a: i64x2, b: i64x2) i64x2 {
    ret a + b;
}

#[noinline]
fun row_add_u64(a: u64x2, b: u64x2) u64x2 {
    ret a + b;
}

#[noinline]
fun row_sub_i64(a: i64x2, b: i64x2) i64x2 {
    ret a - b;
}

#[noinline]
fun row_sub_u64(a: u64x2, b: u64x2) u64x2 {
    ret a - b;
}

#[noinline]
fun row_mul_i64(a: i64x2, b: i64x2) i64x2 {
    ret a * b;
}

#[noinline]
fun row_mul_u64(a: u64x2, b: u64x2) u64x2 {
    ret a * b;
}

#[noinline]
fun row_div_i64(a: i64x2, b: i64x2) i64x2 {
    ret a / b;
}

#[noinline]
fun row_div_u64(a: u64x2, b: u64x2) u64x2 {
    ret a / b;
}

#[noinline]
fun row_and_i64(a: i64x2, b: i64x2) i64x2 {
    ret a & b;
}

#[noinline]
fun row_and_u64(a: u64x2, b: u64x2) u64x2 {
    ret a & b;
}

#[noinline]
fun row_or_i64(a: i64x2, b: i64x2) i64x2 {
    ret a | b;
}

#[noinline]
fun row_or_u64(a: u64x2, b: u64x2) u64x2 {
    ret a | b;
}

#[noinline]
fun row_xor_i64(a: i64x2, b: i64x2) i64x2 {
    ret a ^ b;
}

#[noinline]
fun row_xor_u64(a: u64x2, b: u64x2) u64x2 {
    ret a ^ b;
}

#[noinline]
fun row_not_i64(a: i64x2) i64x2 {
    ret ~a;
}

#[noinline]
fun row_not_u64(a: u64x2) u64x2 {
    ret ~a;
}

#[noinline]
fun row_cmp_lt_i64(a: i64x2, b: i64x2) u64x2 {
    ret a < b;
}

#[noinline]
fun row_cmp_eq_i64(a: i64x2, b: i64x2) u64x2 {
    ret a == b;
}

#[noinline]
fun row_cmp_lt_u64(a: u64x2, b: u64x2) u64x2 {
    ret a < b;
}

#[noinline]
fun row_cmp_eq_u64(a: u64x2, b: u64x2) u64x2 {
    ret a == b;
}

fun fold_i64x2(h: u64, v: i64x2) u64 {
    var a: u64 = h;
    a = fold.mix_i64(a, v[0]);
    a = fold.mix_i64(a, v[1]);
    ret a;
}

fun fold_u64x2(h: u64, v: u64x2) u64 {
    var a: u64 = h;
    a = fold.mix_u64(a, v[0]);
    a = fold.mix_u64(a, v[1]);
    ret a;
}

pub fun checksum(seed: u64) u64 {
    var h:     u64 = fold.init();
    val si:    i64 = seed::i64;
    val su:    u64 = seed::u64;
    val imin:  i64 = (9223372036854775808::u64):~i64;
    val imin1: i64 = imin + 1;
    {
        var a: i64x2 = i64x2{9223372036854775807, imin};
        var b: i64x2 = i64x2{3, 2};
        a[0] = a[0] + si;
        h    = fold_i64x2(h, row_add_i64(a, b));
    }
    {
        var a: u64x2 = u64x2{18446744073709551615, 0};
        var b: u64x2 = u64x2{3, 2};
        a[0] = a[0] + su;
        h    = fold_u64x2(h, row_add_u64(a, b));
    }
    {
        var a: i64x2 = i64x2{9223372036854775807, imin};
        var b: i64x2 = i64x2{3, 2};
        a[0] = a[0] + si;
        h    = fold_i64x2(h, row_sub_i64(a, b));
    }
    {
        var a: u64x2 = u64x2{18446744073709551615, 0};
        var b: u64x2 = u64x2{3, 2};
        a[0] = a[0] + su;
        h    = fold_u64x2(h, row_sub_u64(a, b));
    }
    {
        var a: i64x2 = i64x2{9223372036854775807, imin};
        var b: i64x2 = i64x2{3, 2};
        a[0] = a[0] + si;
        h    = fold_i64x2(h, row_mul_i64(a, b));
    }
    {
        var a: u64x2 = u64x2{18446744073709551615, 0};
        var b: u64x2 = u64x2{3, 2};
        a[0] = a[0] + su;
        h    = fold_u64x2(h, row_mul_u64(a, b));
    }
    {
        var a: i64x2 = i64x2{9223372036854775807, imin};
        var b: i64x2 = i64x2{3, 2};
        a[0] = a[0] + si;
        h    = fold_i64x2(h, row_div_i64(a, b));
    }
    {
        var a: u64x2 = u64x2{18446744073709551615, 0};
        var b: u64x2 = u64x2{3, 2};
        a[0] = a[0] + su;
        h    = fold_u64x2(h, row_div_u64(a, b));
    }
    {
        var a: i64x2 = i64x2{9223372036854775807, imin};
        var b: i64x2 = i64x2{3, 2};
        a[0] = a[0] + si;
        h    = fold_i64x2(h, row_and_i64(a, b));
    }
    {
        var a: u64x2 = u64x2{18446744073709551615, 0};
        var b: u64x2 = u64x2{3, 2};
        a[0] = a[0] + su;
        h    = fold_u64x2(h, row_and_u64(a, b));
    }
    {
        var a: i64x2 = i64x2{9223372036854775807, imin};
        var b: i64x2 = i64x2{3, 2};
        a[0] = a[0] + si;
        h    = fold_i64x2(h, row_or_i64(a, b));
    }
    {
        var a: u64x2 = u64x2{18446744073709551615, 0};
        var b: u64x2 = u64x2{3, 2};
        a[0] = a[0] + su;
        h    = fold_u64x2(h, row_or_u64(a, b));
    }
    {
        var a: i64x2 = i64x2{9223372036854775807, imin};
        var b: i64x2 = i64x2{3, 2};
        a[0] = a[0] + si;
        h    = fold_i64x2(h, row_xor_i64(a, b));
    }
    {
        var a: u64x2 = u64x2{18446744073709551615, 0};
        var b: u64x2 = u64x2{3, 2};
        a[0] = a[0] + su;
        h    = fold_u64x2(h, row_xor_u64(a, b));
    }
    {
        var a: i64x2 = i64x2{9223372036854775807, imin};
        a[0] = a[0] + si;
        h    = fold_i64x2(h, row_not_i64(a));
    }
    {
        var a: u64x2 = u64x2{18446744073709551615, 0};
        a[0] = a[0] + su;
        h    = fold_u64x2(h, row_not_u64(a));
    }
    {
        var a: i64x2 = i64x2{9223372036854775807, imin};
        var b: i64x2 = i64x2{3, 2};
        a[0] = a[0] + si;
        h    = fold_u64x2(h, row_cmp_lt_i64(a, b));
    }
    {
        var a: i64x2 = i64x2{9223372036854775807, imin};
        var b: i64x2 = i64x2{3, 2};
        a[0] = a[0] + si;
        h    = fold_u64x2(h, row_cmp_eq_i64(a, b));
    }
    {
        var a: u64x2 = u64x2{18446744073709551615, 0};
        var b: u64x2 = u64x2{3, 2};
        a[0] = a[0] + su;
        h    = fold_u64x2(h, row_cmp_lt_u64(a, b));
    }
    {
        var a: u64x2 = u64x2{18446744073709551615, 0};
        var b: u64x2 = u64x2{3, 2};
        a[0] = a[0] + su;
        h    = fold_u64x2(h, row_cmp_eq_u64(a, b));
    }
    ret h;
}
