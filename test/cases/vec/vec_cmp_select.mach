# lane-wise comparison and the select idiom built on it. a comparison yields a
# same-shape unsigned mask, all-ones for true and all-zeros for false, so a lowering
# that produces 1 instead of all-ones passes the comparison and then selects
# garbage. operand pairs cover less, equal and greater in the same vector, the
# signed and unsigned readings of the same bits disagree on at least one lane, and
# the float pair puts -0.0 against 0.0, which compare equal and fold differently.

use corpus.lib.fold;

fun fold_u8x16(h: u64, v: u8x16) u64 {
    var a: u64 = fold.mix_u8(h, v[0]);
    a = fold.mix_u8(a, v[1]);
    a = fold.mix_u8(a, v[2]);
    a = fold.mix_u8(a, v[3]);
    a = fold.mix_u8(a, v[4]);
    a = fold.mix_u8(a, v[5]);
    a = fold.mix_u8(a, v[6]);
    a = fold.mix_u8(a, v[7]);
    a = fold.mix_u8(a, v[8]);
    a = fold.mix_u8(a, v[9]);
    a = fold.mix_u8(a, v[10]);
    a = fold.mix_u8(a, v[11]);
    a = fold.mix_u8(a, v[12]);
    a = fold.mix_u8(a, v[13]);
    a = fold.mix_u8(a, v[14]);
    a = fold.mix_u8(a, v[15]);
    ret a;
}

fun fold_u16x8(h: u64, v: u16x8) u64 {
    var a: u64 = fold.mix_u16(h, v[0]);
    a = fold.mix_u16(a, v[1]);
    a = fold.mix_u16(a, v[2]);
    a = fold.mix_u16(a, v[3]);
    a = fold.mix_u16(a, v[4]);
    a = fold.mix_u16(a, v[5]);
    a = fold.mix_u16(a, v[6]);
    a = fold.mix_u16(a, v[7]);
    ret a;
}

fun fold_u32x4(h: u64, v: u32x4) u64 {
    var a: u64 = fold.mix_u32(h, v[0]);
    a = fold.mix_u32(a, v[1]);
    a = fold.mix_u32(a, v[2]);
    a = fold.mix_u32(a, v[3]);
    ret a;
}

fun fold_u64x2(h: u64, v: u64x2) u64 {
    var a: u64 = fold.mix_u64(h, v[0]);
    a = fold.mix_u64(a, v[1]);
    ret a;
}

fun fold_f32x4(h: u64, v: f32x4) u64 {
    var a: u64 = fold.mix_f32(h, v[0]);
    a = fold.mix_f32(a, v[1]);
    a = fold.mix_f32(a, v[2]);
    a = fold.mix_f32(a, v[3]);
    ret a;
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: u32 = seed::u32;
    val t: i32 = seed::i32;
    val z: f32 = seed::f32;
    val w: u16 = seed::u16;
    val e: u8 = seed::u8;

    var a: u32x4 = u32x4{10, 20, 30, 4294967295};
    var b: u32x4 = u32x4{20, 20, 10, 1};
    a[0] = a[0] + s;
    b[3] = b[3] + s;
    h = fold_u32x4(h, a < b);
    h = fold_u32x4(h, a > b);
    h = fold_u32x4(h, a == b);
    h = fold_u32x4(h, a != b);
    h = fold_u32x4(h, a <= b);
    h = fold_u32x4(h, a >= b);

    val m: u32x4 = a < b;
    h = fold_u32x4(h, (m & a) | (~m & b));
    h = fold_u32x4(h, (m & b) | (~m & a));
    h = fold_u32x4(h, m & (a + b));
    h = fold_u32x4(h, ~m | (a - b));

    # the same bit patterns read as signed: lane 0 and lane 2 disagree with the
    # unsigned reading above
    var p: i32x4 = i32x4{-1, 5, -2000000000, 7};
    var q: i32x4 = i32x4{1, 5, 2000000000, -7};
    p[0] = p[0] + t;
    q[3] = q[3] + t;
    h = fold_u32x4(h, p < q);
    h = fold_u32x4(h, p > q);
    h = fold_u32x4(h, p == q);
    h = fold_u32x4(h, p != q);
    h = fold_u32x4(h, p <= q);
    h = fold_u32x4(h, p >= q);

    var fa: f32x4 = f32x4{1.5, -0.0, 3.0, -2.0};
    var fb: f32x4 = f32x4{2.5, 0.0, 3.0, -3.0};
    fa[0] = fa[0] + z;
    h = fold_f32x4(h, fa);
    h = fold_f32x4(h, fb);
    h = fold_u32x4(h, fa < fb);
    h = fold_u32x4(h, fa > fb);
    h = fold_u32x4(h, fa == fb);
    h = fold_u32x4(h, fa != fb);
    h = fold_u32x4(h, fa <= fb);
    h = fold_u32x4(h, fa >= fb);

    # selecting float lanes goes through the bit reinterpret, so the mask must be
    # all-ones and the -0.0 lane must survive as -0.0
    val fm: u32x4 = fa < fb;
    val lo: f32x4 = ((fm & (fa:~u32x4)) | (~fm & (fb:~u32x4))):~f32x4;
    val hi: f32x4 = ((fm & (fb:~u32x4)) | (~fm & (fa:~u32x4))):~f32x4;
    h = fold_f32x4(h, lo);
    h = fold_f32x4(h, hi);
    h = fold_f32x4(h, hi - lo);

    var ga: f64x2 = f64x2{1.5, -0.0};
    var gb: f64x2 = f64x2{2.5, 0.0};
    ga[0] = ga[0] + seed::f64;
    h = fold_u64x2(h, ga < gb);
    h = fold_u64x2(h, ga == gb);
    h = fold_u64x2(h, ga != gb);
    h = fold_u64x2(h, ga >= gb);

    var ha: u16x8 = u16x8{1, 65535, 32768, 7, 7, 0, 300, 65534};
    var hb: u16x8 = u16x8{2, 1, 32767, 7, 8, 65535, 300, 65535};
    ha[0] = ha[0] + w;
    hb[7] = hb[7] + w;
    h = fold_u16x8(h, ha < hb);
    h = fold_u16x8(h, ha == hb);
    h = fold_u16x8(h, ha > hb);
    val hm: u16x8 = ha < hb;
    h = fold_u16x8(h, (hm & ha) | (~hm & hb));

    var ka: u8x16 = u8x16{1, 255, 128, 7, 7, 0, 200, 254, 3, 9, 11, 13, 17, 19, 23, 29};
    var kb: u8x16 = u8x16{2, 1, 127, 7, 8, 255, 200, 255, 3, 8, 12, 13, 18, 19, 22, 30};
    ka[0] = ka[0] + e;
    kb[15] = kb[15] + e;
    h = fold_u8x16(h, ka < kb);
    h = fold_u8x16(h, ka == kb);
    h = fold_u8x16(h, ka >= kb);
    val km: u8x16 = ka < kb;
    h = fold_u8x16(h, (km & ka) | (~km & kb));
    ret h;
}
