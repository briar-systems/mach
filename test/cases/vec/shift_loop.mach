# loops that shift, which the vectorizer widens by the count's form (#3853): a
# count the loop does not change is the uniform form, one scalar for every
# lane, and a count read per element is the per-lane form. each loop runs over
# counts inside the width, at it, past it and with a small low byte past it,
# so every lane saturates as the scalar shift does: 0, or the sign fill for a
# signed `>>`. the -O0 and -O2 checksums and the C reference agree whichever
# form a target packs, and whichever loops it leaves scalar.

use corpus.lib.fold;

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val n: u64 = 67 - (seed & 1);
    val r: u32 = (seed >> 40)::u32;

    val c32: [12]u32 = [12]u32{0, 1, 5, 31, 32, 33, 63, 64, 255, 256, 257, 4294967295};
    val c64: [8]u64  = [8]u64{0, 1, 63, 64, 65, 257, 4294967297, 18446744073709551615};
    val c8:  [8]u8   = [8]u8{0, 1, 7, 8, 9, 15, 16, 255};

    var a:  [67]u32;
    var b:  [67]i32;
    var s:  [67]u32;
    var sb: [67]i32;
    var q:  [67]u64;
    var t:  [67]u64;
    var w:  [67]i16;
    var y:  [67]u8;
    var i:  u64 = 0;
    for (i < n) {
        a[i]  = i::u32 * 2654435761 + 12345 + seed::u32;
        b[i]  = (i::u32 * 2246822519 + 3266489917)::i32;
        s[i]  = c32[i % 12] + r;
        sb[i] = (c32[(i + 5) % 12] + r)::i32;
        q[i]  = i * 11400714819323198485 + 1442695040888963407;
        t[i]  = c64[i % 8] + r::u64;
        w[i]  = (i::u32 * 40503 + 7)::i16;
        y[i]  = (i::u32 * 97 + 3)::u8;
        i     = i + 1;
    }

    var o:  [67]u32;
    var ob: [67]i32;
    var oq: [67]u64;
    var ow: [67]i16;
    var oy: [67]u8;

    # a count the loop does not change: the uniform form
    var j: u64 = 0;
    for (j < 12) {
        val k: u32 = c32[j] + r;
        i = 0;
        for (i < n) {
            o[i] = a[i] << k;
            i    = i + 1;
        }
        i = 0;
        for (i < n) {
            h = fold.mix_u32(h, o[i]);
            i = i + 1;
        }
        i = 0;
        for (i < n) {
            o[i] = a[i] >> k;
            i    = i + 1;
        }
        i = 0;
        for (i < n) {
            h = fold.mix_u32(h, o[i]);
            i = i + 1;
        }
        i = 0;
        for (i < n) {
            ob[i] = b[i] >> k::i32;
            i     = i + 1;
        }
        i = 0;
        for (i < n) {
            h = fold.mix_i32(h, ob[i]);
            i = i + 1;
        }
        j = j + 1;
    }
    j = 0;
    for (j < 8) {
        val k: u64 = c64[j] + r::u64;
        i = 0;
        for (i < n) {
            oq[i] = q[i] << k;
            i     = i + 1;
        }
        i = 0;
        for (i < n) {
            h = fold.mix_u64(h, oq[i]);
            i = i + 1;
        }
        i = 0;
        for (i < n) {
            oq[i] = q[i] >> k;
            i     = i + 1;
        }
        i = 0;
        for (i < n) {
            h = fold.mix_u64(h, oq[i]);
            i = i + 1;
        }
        # a count of a narrower type than the lanes it shifts
        val kb: u8 = c8[j] + r::u8;
        i = 0;
        for (i < n) {
            ow[i] = w[i] >> kb;
            i     = i + 1;
        }
        i = 0;
        for (i < n) {
            h = fold.mix_i16(h, ow[i]);
            i = i + 1;
        }
        i = 0;
        for (i < n) {
            oy[i] = y[i] << kb;
            i     = i + 1;
        }
        i = 0;
        for (i < n) {
            h = fold.mix_u8(h, oy[i]);
            i = i + 1;
        }
        j = j + 1;
    }

    # a count read per element: the per-lane form
    i = 0;
    for (i < n) {
        o[i] = a[i] << s[i];
        i    = i + 1;
    }
    i = 0;
    for (i < n) {
        h = fold.mix_u32(h, o[i]);
        i = i + 1;
    }
    i = 0;
    for (i < n) {
        o[i] = a[i] >> s[i];
        i    = i + 1;
    }
    i = 0;
    for (i < n) {
        h = fold.mix_u32(h, o[i]);
        i = i + 1;
    }
    i = 0;
    for (i < n) {
        ob[i] = b[i] >> sb[i];
        i     = i + 1;
    }
    i = 0;
    for (i < n) {
        h = fold.mix_i32(h, ob[i]);
        i = i + 1;
    }
    i = 0;
    for (i < n) {
        oq[i] = q[i] >> t[i];
        i     = i + 1;
    }
    i = 0;
    for (i < n) {
        h = fold.mix_u64(h, oq[i]);
        i = i + 1;
    }
    ret h;
}
