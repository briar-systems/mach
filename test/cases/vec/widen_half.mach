# the lane-halving widen of one narrower vector's half: `v[0, n]::T` is the low
# half and `v[n, n]::T` the high half, each one lane-halving widen where the
# target packs the cell. one noinline probe per cell and half, and a literal
# of lane extensions in a permuted order that takes the lane path. the
# operands run through each lane type's extremes and every result lane folds
# in order.

use corpus.lib.fold;

#[noinline]
fun lo_i8(v: i8x16) i16x8 {
    ret v[0, 8]::i16x8;
}

#[noinline]
fun hi_i8(v: i8x16) i16x8 {
    ret v[8, 8]::i16x8;
}

#[noinline]
fun lo_u8(v: u8x16) u16x8 {
    ret v[0, 8]::u16x8;
}

#[noinline]
fun hi_u8(v: u8x16) u16x8 {
    ret v[8, 8]::u16x8;
}

#[noinline]
fun lo_i16(v: i16x8) i32x4 {
    ret v[0, 4]::i32x4;
}

#[noinline]
fun hi_i16(v: i16x8) i32x4 {
    ret v[4, 4]::i32x4;
}

#[noinline]
fun lo_u16(v: u16x8) u32x4 {
    ret v[0, 4]::u32x4;
}

#[noinline]
fun hi_u16(v: u16x8) u32x4 {
    ret v[4, 4]::u32x4;
}

#[noinline]
fun lo_i32(v: i32x4) i64x2 {
    ret v[0, 2]::i64x2;
}

#[noinline]
fun hi_i32(v: i32x4) i64x2 {
    ret v[2, 2]::i64x2;
}

#[noinline]
fun lo_u32(v: u32x4) u64x2 {
    ret v[0, 2]::u64x2;
}

#[noinline]
fun hi_u32(v: u32x4) u64x2 {
    ret v[2, 2]::u64x2;
}

# a literal of lane extensions: the lane path through a stack slot
#[noinline]
fun permuted_i16(v: i16x8) i32x4 {
    ret i32x4{v[0]::i32, v[2]::i32, v[1]::i32, v[3]::i32};
}

fun fold_i16x8(h: u64, v: i16x8) u64 {
    var a: u64 = h;
    a = fold.mix_i16(a, v[0]);
    a = fold.mix_i16(a, v[1]);
    a = fold.mix_i16(a, v[2]);
    a = fold.mix_i16(a, v[3]);
    a = fold.mix_i16(a, v[4]);
    a = fold.mix_i16(a, v[5]);
    a = fold.mix_i16(a, v[6]);
    a = fold.mix_i16(a, v[7]);
    ret a;
}

fun fold_u16x8(h: u64, v: u16x8) u64 {
    var a: u64 = h;
    a = fold.mix_u16(a, v[0]);
    a = fold.mix_u16(a, v[1]);
    a = fold.mix_u16(a, v[2]);
    a = fold.mix_u16(a, v[3]);
    a = fold.mix_u16(a, v[4]);
    a = fold.mix_u16(a, v[5]);
    a = fold.mix_u16(a, v[6]);
    a = fold.mix_u16(a, v[7]);
    ret a;
}

fun fold_i32x4(h: u64, v: i32x4) u64 {
    var a: u64 = h;
    a = fold.mix_i32(a, v[0]);
    a = fold.mix_i32(a, v[1]);
    a = fold.mix_i32(a, v[2]);
    a = fold.mix_i32(a, v[3]);
    ret a;
}

fun fold_u32x4(h: u64, v: u32x4) u64 {
    var a: u64 = h;
    a = fold.mix_u32(a, v[0]);
    a = fold.mix_u32(a, v[1]);
    a = fold.mix_u32(a, v[2]);
    a = fold.mix_u32(a, v[3]);
    ret a;
}

fun fold_i64x2(h: u64, v: i64x2) u64 {
    var a: u64 = h;
    a = fold.mix_i64(a, v[0]);
    a = fold.mix_i64(a, v[1]);
    ret a;
}

fun fold_u64x2(h: u64, v: u64x2) u64 {
    var a: u64 = h;
    a = fold.mix_u64(a, v[0]);
    a = fold.mix_u64(a, v[1]);
    ret a;
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    {
        var v: i8x16 = i8x16{(128::u8):~i8, 127, -1, 0, 1, -127, 126, 7, (128::u8):~i8, -2, 3, 127, -127, 64, -64, 100};
        v[1] = v[1] ^ seed::i8;
        h    = fold_i16x8(h, lo_i8(v));
        h    = fold_i16x8(h, hi_i8(v));
    }
    {
        var v: u8x16 = u8x16{0, 255, 254, 0, 1, 1, 254, 7, 128, 129, 3, 255, 2, 64, 192, 100};
        v[1] = v[1] ^ seed::u8;
        h    = fold_u16x8(h, lo_u8(v));
        h    = fold_u16x8(h, hi_u8(v));
    }
    {
        var v: i16x8 = i16x8{(32768::u16):~i16, 32767, -1, 0, 1, -32767, 32766, -7};
        v[1] = v[1] ^ seed::i16;
        h    = fold_i32x4(h, lo_i16(v));
        h    = fold_i32x4(h, hi_i16(v));
        h    = fold_i32x4(h, permuted_i16(v));
    }
    {
        var v: u16x8 = u16x8{0, 65535, 65534, 0, 1, 32768, 32767, 7};
        v[1] = v[1] ^ seed::u16;
        h    = fold_u32x4(h, lo_u16(v));
        h    = fold_u32x4(h, hi_u16(v));
    }
    {
        var v: i32x4 = i32x4{(2147483648::u32):~i32, 2147483647, -1, -2147483647};
        v[1] = v[1] ^ seed::i32;
        h    = fold_i64x2(h, lo_i32(v));
        h    = fold_i64x2(h, hi_i32(v));
    }
    {
        var v: u32x4 = u32x4{0, 4294967295, 2147483648, 7};
        v[1] = v[1] ^ seed::u32;
        h    = fold_u64x2(h, lo_u32(v));
        h    = fold_u64x2(h, hi_u32(v));
    }
    ret h;
}
