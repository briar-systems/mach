# the vector rows at 8-bit lanes: one noinline probe per (operation, signedness
# and, for a compare, predicate) of the retained vector vocabulary, so the golden
# shows each probe's body on its own and the decoder witnesses which cells the
# target packs and which it expands per lane. every lane result folds in order.

use corpus.lib.fold;

#[noinline]
fun row_add_i8(a: i8x16, b: i8x16) i8x16 {
    ret a + b;
}

#[noinline]
fun row_add_u8(a: u8x16, b: u8x16) u8x16 {
    ret a + b;
}

#[noinline]
fun row_sub_i8(a: i8x16, b: i8x16) i8x16 {
    ret a - b;
}

#[noinline]
fun row_sub_u8(a: u8x16, b: u8x16) u8x16 {
    ret a - b;
}

#[noinline]
fun row_mul_i8(a: i8x16, b: i8x16) i8x16 {
    ret a * b;
}

#[noinline]
fun row_mul_u8(a: u8x16, b: u8x16) u8x16 {
    ret a * b;
}

#[noinline]
fun row_div_i8(a: i8x16, b: i8x16) i8x16 {
    ret a / b;
}

#[noinline]
fun row_div_u8(a: u8x16, b: u8x16) u8x16 {
    ret a / b;
}

#[noinline]
fun row_and_i8(a: i8x16, b: i8x16) i8x16 {
    ret a & b;
}

#[noinline]
fun row_and_u8(a: u8x16, b: u8x16) u8x16 {
    ret a & b;
}

#[noinline]
fun row_or_i8(a: i8x16, b: i8x16) i8x16 {
    ret a | b;
}

#[noinline]
fun row_or_u8(a: u8x16, b: u8x16) u8x16 {
    ret a | b;
}

#[noinline]
fun row_xor_i8(a: i8x16, b: i8x16) i8x16 {
    ret a ^ b;
}

#[noinline]
fun row_xor_u8(a: u8x16, b: u8x16) u8x16 {
    ret a ^ b;
}

#[noinline]
fun row_not_i8(a: i8x16) i8x16 {
    ret ~a;
}

#[noinline]
fun row_not_u8(a: u8x16) u8x16 {
    ret ~a;
}

#[noinline]
fun row_cmp_lt_i8(a: i8x16, b: i8x16) u8x16 {
    ret a < b;
}

#[noinline]
fun row_cmp_eq_i8(a: i8x16, b: i8x16) u8x16 {
    ret a == b;
}

#[noinline]
fun row_cmp_lt_u8(a: u8x16, b: u8x16) u8x16 {
    ret a < b;
}

#[noinline]
fun row_cmp_eq_u8(a: u8x16, b: u8x16) u8x16 {
    ret a == b;
}

fun fold_i8x16(h: u64, v: i8x16) u64 {
    var a: u64 = h;
    a = fold.mix_i8(a, v[0]);
    a = fold.mix_i8(a, v[1]);
    a = fold.mix_i8(a, v[2]);
    a = fold.mix_i8(a, v[3]);
    a = fold.mix_i8(a, v[4]);
    a = fold.mix_i8(a, v[5]);
    a = fold.mix_i8(a, v[6]);
    a = fold.mix_i8(a, v[7]);
    a = fold.mix_i8(a, v[8]);
    a = fold.mix_i8(a, v[9]);
    a = fold.mix_i8(a, v[10]);
    a = fold.mix_i8(a, v[11]);
    a = fold.mix_i8(a, v[12]);
    a = fold.mix_i8(a, v[13]);
    a = fold.mix_i8(a, v[14]);
    a = fold.mix_i8(a, v[15]);
    ret a;
}

fun fold_u8x16(h: u64, v: u8x16) u64 {
    var a: u64 = h;
    a = fold.mix_u8(a, v[0]);
    a = fold.mix_u8(a, v[1]);
    a = fold.mix_u8(a, v[2]);
    a = fold.mix_u8(a, v[3]);
    a = fold.mix_u8(a, v[4]);
    a = fold.mix_u8(a, v[5]);
    a = fold.mix_u8(a, v[6]);
    a = fold.mix_u8(a, v[7]);
    a = fold.mix_u8(a, v[8]);
    a = fold.mix_u8(a, v[9]);
    a = fold.mix_u8(a, v[10]);
    a = fold.mix_u8(a, v[11]);
    a = fold.mix_u8(a, v[12]);
    a = fold.mix_u8(a, v[13]);
    a = fold.mix_u8(a, v[14]);
    a = fold.mix_u8(a, v[15]);
    ret a;
}

pub fun checksum(seed: u64) u64 {
    var h:     u64 = fold.init();
    val si:    i8  = seed::i8;
    val su:    u8  = seed::u8;
    val imin:  i8  = (128::u8):~i8;
    val imin1: i8  = imin + 1;
    {
        var a: i8x16 = i8x16{127, imin, 7, -3, 100, 1, 0, 42, 126, imin1, 13, 29, 64, 5, 99, 17};
        var b: i8x16 = i8x16{3, 2, -7, 5, 9, 127, 1, 6, 2, 3, 13, 4, 8, 5, 11, 1};
        a[0] = a[0] + si;
        h    = fold_i8x16(h, row_add_i8(a, b));
    }
    {
        var a: u8x16 = u8x16{255, 0, 7, 3, 100, 1, 0, 42, 254, 1, 13, 29, 64, 5, 99, 17};
        var b: u8x16 = u8x16{3, 2, 7, 5, 9, 255, 1, 6, 2, 3, 13, 4, 8, 5, 11, 1};
        a[0] = a[0] + su;
        h    = fold_u8x16(h, row_add_u8(a, b));
    }
    {
        var a: i8x16 = i8x16{127, imin, 7, -3, 100, 1, 0, 42, 126, imin1, 13, 29, 64, 5, 99, 17};
        var b: i8x16 = i8x16{3, 2, -7, 5, 9, 127, 1, 6, 2, 3, 13, 4, 8, 5, 11, 1};
        a[0] = a[0] + si;
        h    = fold_i8x16(h, row_sub_i8(a, b));
    }
    {
        var a: u8x16 = u8x16{255, 0, 7, 3, 100, 1, 0, 42, 254, 1, 13, 29, 64, 5, 99, 17};
        var b: u8x16 = u8x16{3, 2, 7, 5, 9, 255, 1, 6, 2, 3, 13, 4, 8, 5, 11, 1};
        a[0] = a[0] + su;
        h    = fold_u8x16(h, row_sub_u8(a, b));
    }
    {
        var a: i8x16 = i8x16{127, imin, 7, -3, 100, 1, 0, 42, 126, imin1, 13, 29, 64, 5, 99, 17};
        var b: i8x16 = i8x16{3, 2, -7, 5, 9, 127, 1, 6, 2, 3, 13, 4, 8, 5, 11, 1};
        a[0] = a[0] + si;
        h    = fold_i8x16(h, row_mul_i8(a, b));
    }
    {
        var a: u8x16 = u8x16{255, 0, 7, 3, 100, 1, 0, 42, 254, 1, 13, 29, 64, 5, 99, 17};
        var b: u8x16 = u8x16{3, 2, 7, 5, 9, 255, 1, 6, 2, 3, 13, 4, 8, 5, 11, 1};
        a[0] = a[0] + su;
        h    = fold_u8x16(h, row_mul_u8(a, b));
    }
    {
        var a: i8x16 = i8x16{127, imin, 7, -3, 100, 1, 0, 42, 126, imin1, 13, 29, 64, 5, 99, 17};
        var b: i8x16 = i8x16{3, 2, -7, 5, 9, 127, 1, 6, 2, 3, 13, 4, 8, 5, 11, 1};
        a[0] = a[0] + si;
        h    = fold_i8x16(h, row_div_i8(a, b));
    }
    {
        var a: u8x16 = u8x16{255, 0, 7, 3, 100, 1, 0, 42, 254, 1, 13, 29, 64, 5, 99, 17};
        var b: u8x16 = u8x16{3, 2, 7, 5, 9, 255, 1, 6, 2, 3, 13, 4, 8, 5, 11, 1};
        a[0] = a[0] + su;
        h    = fold_u8x16(h, row_div_u8(a, b));
    }
    {
        var a: i8x16 = i8x16{127, imin, 7, -3, 100, 1, 0, 42, 126, imin1, 13, 29, 64, 5, 99, 17};
        var b: i8x16 = i8x16{3, 2, -7, 5, 9, 127, 1, 6, 2, 3, 13, 4, 8, 5, 11, 1};
        a[0] = a[0] + si;
        h    = fold_i8x16(h, row_and_i8(a, b));
    }
    {
        var a: u8x16 = u8x16{255, 0, 7, 3, 100, 1, 0, 42, 254, 1, 13, 29, 64, 5, 99, 17};
        var b: u8x16 = u8x16{3, 2, 7, 5, 9, 255, 1, 6, 2, 3, 13, 4, 8, 5, 11, 1};
        a[0] = a[0] + su;
        h    = fold_u8x16(h, row_and_u8(a, b));
    }
    {
        var a: i8x16 = i8x16{127, imin, 7, -3, 100, 1, 0, 42, 126, imin1, 13, 29, 64, 5, 99, 17};
        var b: i8x16 = i8x16{3, 2, -7, 5, 9, 127, 1, 6, 2, 3, 13, 4, 8, 5, 11, 1};
        a[0] = a[0] + si;
        h    = fold_i8x16(h, row_or_i8(a, b));
    }
    {
        var a: u8x16 = u8x16{255, 0, 7, 3, 100, 1, 0, 42, 254, 1, 13, 29, 64, 5, 99, 17};
        var b: u8x16 = u8x16{3, 2, 7, 5, 9, 255, 1, 6, 2, 3, 13, 4, 8, 5, 11, 1};
        a[0] = a[0] + su;
        h    = fold_u8x16(h, row_or_u8(a, b));
    }
    {
        var a: i8x16 = i8x16{127, imin, 7, -3, 100, 1, 0, 42, 126, imin1, 13, 29, 64, 5, 99, 17};
        var b: i8x16 = i8x16{3, 2, -7, 5, 9, 127, 1, 6, 2, 3, 13, 4, 8, 5, 11, 1};
        a[0] = a[0] + si;
        h    = fold_i8x16(h, row_xor_i8(a, b));
    }
    {
        var a: u8x16 = u8x16{255, 0, 7, 3, 100, 1, 0, 42, 254, 1, 13, 29, 64, 5, 99, 17};
        var b: u8x16 = u8x16{3, 2, 7, 5, 9, 255, 1, 6, 2, 3, 13, 4, 8, 5, 11, 1};
        a[0] = a[0] + su;
        h    = fold_u8x16(h, row_xor_u8(a, b));
    }
    {
        var a: i8x16 = i8x16{127, imin, 7, -3, 100, 1, 0, 42, 126, imin1, 13, 29, 64, 5, 99, 17};
        a[0] = a[0] + si;
        h    = fold_i8x16(h, row_not_i8(a));
    }
    {
        var a: u8x16 = u8x16{255, 0, 7, 3, 100, 1, 0, 42, 254, 1, 13, 29, 64, 5, 99, 17};
        a[0] = a[0] + su;
        h    = fold_u8x16(h, row_not_u8(a));
    }
    {
        var a: i8x16 = i8x16{127, imin, 7, -3, 100, 1, 0, 42, 126, imin1, 13, 29, 64, 5, 99, 17};
        var b: i8x16 = i8x16{3, 2, -7, 5, 9, 127, 1, 6, 2, 3, 13, 4, 8, 5, 11, 1};
        a[0] = a[0] + si;
        h    = fold_u8x16(h, row_cmp_lt_i8(a, b));
    }
    {
        var a: i8x16 = i8x16{127, imin, 7, -3, 100, 1, 0, 42, 126, imin1, 13, 29, 64, 5, 99, 17};
        var b: i8x16 = i8x16{3, 2, -7, 5, 9, 127, 1, 6, 2, 3, 13, 4, 8, 5, 11, 1};
        a[0] = a[0] + si;
        h    = fold_u8x16(h, row_cmp_eq_i8(a, b));
    }
    {
        var a: u8x16 = u8x16{255, 0, 7, 3, 100, 1, 0, 42, 254, 1, 13, 29, 64, 5, 99, 17};
        var b: u8x16 = u8x16{3, 2, 7, 5, 9, 255, 1, 6, 2, 3, 13, 4, 8, 5, 11, 1};
        a[0] = a[0] + su;
        h    = fold_u8x16(h, row_cmp_lt_u8(a, b));
    }
    {
        var a: u8x16 = u8x16{255, 0, 7, 3, 100, 1, 0, 42, 254, 1, 13, 29, 64, 5, 99, 17};
        var b: u8x16 = u8x16{3, 2, 7, 5, 9, 255, 1, 6, 2, 3, 13, 4, 8, 5, 11, 1};
        a[0] = a[0] + su;
        h    = fold_u8x16(h, row_cmp_eq_u8(a, b));
    }
    ret h;
}
