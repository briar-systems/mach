# u32x4 fills a 128-bit vector register: $size_of is 16 and $align_of is 16. lanes
# start on both sides of the wrap boundary, so every add, sub and mul carries out of
# at least one lane and a lowering that borrows or carries between lanes is visible.

use corpus.lib.fold;

rec Pair {
    lead: u32;
    v: u32x4;
    trail: u32;
}

fun fold_vec(h: u64, v: u32x4) u64 {
    var a: u64 = fold.mix_u32(h, v[0]);
    a = fold.mix_u32(a, v[1]);
    a = fold.mix_u32(a, v[2]);
    a = fold.mix_u32(a, v[3]);
    ret a;
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: u32 = seed::u32;

    var a: u32x4 = u32x4{4294967280, 1, 2147483648, 305419896};
    var b: u32x4 = u32x4{17, 4294967295, 2147483649, 1};
    val ramp: u32x4 = u32x4{1, 3, 9, 27};
    val zero: u32x4 = u32x4{0, 0, 0, 0};
    a[0] = a[0] + s;
    a[2] = a[2] + s;
    b[1] = b[1] + s;
    b[3] = b[3] + s;

    h = fold_vec(h, a);
    h = fold_vec(h, b);
    h = fold_vec(h, a + b);
    h = fold_vec(h, a - b);
    h = fold_vec(h, b - a);
    h = fold_vec(h, a * b);
    h = fold_vec(h, a * ramp);
    h = fold_vec(h, b * ramp);
    h = fold_vec(h, (a + b) * ramp);
    h = fold_vec(h, zero - a);
    h = fold_vec(h, zero - b);
    h = fold_vec(h, a & b);
    h = fold_vec(h, a | b);
    h = fold_vec(h, a ^ b);
    h = fold_vec(h, ~a);
    h = fold_vec(h, ~b);
    h = fold_vec(h, (a & b) ^ (a | b));

    var acc: u32x4 = zero;
    var sum: u32x4 = zero;
    var i: u64 = 0;
    for (i < 6) {
        val t: u32x4 = a * ramp;
        h = fold_vec(h, t);
        acc = acc ^ t;
        h = fold_vec(h, acc);
        sum = sum + a;
        h = fold_vec(h, sum);
        a = a + b;
        h = fold_vec(h, a);
        i = i + 1;
    }

    var arr: [4]u32x4;
    arr[0] = a;
    arr[1] = a + b;
    arr[2] = a * ramp;
    arr[3] = acc;
    var k: u64 = 0;
    for (k < 4) {
        h = fold_vec(h, arr[k]);
        k = k + 1;
    }

    # scalars either side of the vector, so a wrong size or alignment moves a neighbour
    var r: Pair;
    r.lead = 4294967295;
    r.v = arr[2];
    r.trail = 305419896;
    h = fold.mix_u32(h, r.lead);
    h = fold_vec(h, r.v);
    h = fold.mix_u32(h, r.trail);
    ret h;
}
