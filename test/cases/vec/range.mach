# range indexing `x[start, count]` and `::` between `[N]T` and `TxN` (#3779).
# `p[i, 4]::f32x4` is one vector load and `p[i, 4] = v::[4]f32` one vector
# store, through a pointer and on a local array, at a constant (aligned) and a
# seed-driven (unaligned) offset. `v[0, n]::T` and `v[n, n]::T` over a vector
# of `2n` lanes are the lane-halving widen where the target packs it, signed
# and unsigned, at every lane width. a range of a vector that is not a half, a
# vector range written in place and an array range read and stored keep their
# plain meaning. every result lane or element folds in order.

use corpus.lib.fold;

#[noinline]
fun load_f32(p: *f32, i: u64) f32x4 {
    ret p[i, 4]::f32x4;
}

#[noinline]
fun load_f32_const(p: *f32) f32x4 {
    ret p[4, 4]::f32x4;
}

#[noinline]
fun store_f32(p: *f32, i: u64, v: f32x4) {
    p[i, 4] = (v * v)::[4]f32;
}

#[noinline]
fun load_f64(p: *f64, i: u64) f64x2 {
    ret p[i, 2]::f64x2;
}

#[noinline]
fun store_i32(p: *i32, i: u64, v: i32x4) {
    p[i, 4] = (v + v)::[4]i32;
}

#[noinline]
fun load_u8(p: *u8, i: u64) u8x16 {
    ret p[i, 16]::u8x16;
}

#[noinline]
fun store_u8(p: *u8, i: u64, v: u8x16) {
    p[i, 16] = (v + v)::[16]u8;
}

# a local array: the window starts at `i`, then two lanes on
#[noinline]
fun array_i16(a: i16, b: i16, i: u64) i16x8 {
    var arr: [14]i16 = [14]i16{a, b, a + b, a - b, b - a, a, b, 7, -7, a, b, 3, 11, -11};
    arr[i + 2, 8] = (arr[i, 8]::i16x8 + i16x8{1, 1, 1, 1, 1, 1, 1, 1})::[8]i16;
    ret arr[2, 8]::i16x8;
}

#[noinline]
fun lo_i8(v: i8x16) i16x8 {
    ret v[0, 8]::i16x8;
}

#[noinline]
fun hi_i8(v: i8x16) i16x8 {
    ret v[8, 8]::i16x8;
}

#[noinline]
fun lo_u8(v: u8x16) u16x8 {
    ret v[0, 8]::u16x8;
}

#[noinline]
fun hi_u8(v: u8x16) u16x8 {
    ret v[8, 8]::u16x8;
}

#[noinline]
fun lo_i16(v: i16x8) i32x4 {
    ret v[0, 4]::i32x4;
}

#[noinline]
fun hi_i16(v: i16x8) i32x4 {
    ret v[4, 4]::i32x4;
}

#[noinline]
fun lo_u16(v: u16x8) u32x4 {
    ret v[0, 4]::u32x4;
}

#[noinline]
fun hi_u16(v: u16x8) u32x4 {
    ret v[4, 4]::u32x4;
}

#[noinline]
fun lo_i32(v: i32x4) i64x2 {
    ret v[0, 2]::i64x2;
}

#[noinline]
fun hi_i32(v: i32x4) i64x2 {
    ret v[2, 2]::i64x2;
}

#[noinline]
fun lo_u32(v: u32x4) u64x2 {
    ret v[0, 2]::u64x2;
}

#[noinline]
fun hi_u32(v: u32x4) u64x2 {
    ret v[2, 2]::u64x2;
}

# the middle four lanes are not a half: a lane range, then the extension
#[noinline]
fun mid_i16(v: i16x8) i32x4 {
    ret v[2, 4]::i32x4;
}

# ranges whose first lane sits at a byte offset no doubleword shuffle reaches,
# and a float range
#[noinline]
fun mid_u8(v: u8x16) u8x8 {
    ret v[3, 8];
}

#[noinline]
fun mid_u16(v: u16x8) u16x4 {
    ret v[1, 4];
}

#[noinline]
fun mid_f32(v: f32x4) f32x2 {
    ret v[1, 2];
}

# a vector range read and written in place
#[noinline]
fun swap_halves(v: u32x4) u32x4 {
    var w: u32x4 = v;
    w[0, 2] = v[2, 2];
    w[2, 2] = v[0, 2];
    ret w;
}

# an array range read, and stored into another array
#[noinline]
fun shift_i64(a: i64, b: i64, i: u64) [4]i64 {
    val src: [6]i64 = [6]i64{a, b, a + b, a - b, a * b, b - a};
    var dst: [4]i64;
    dst[1, 3] = src[i, 3];
    dst[0]    = src[5];
    ret dst;
}

fun fold_f32x4(h: u64, v: f32x4) u64 {
    var a: u64 = h;
    a = fold.mix_f32(a, v[0]);
    a = fold.mix_f32(a, v[1]);
    a = fold.mix_f32(a, v[2]);
    a = fold.mix_f32(a, v[3]);
    ret a;
}

fun fold_f64x2(h: u64, v: f64x2) u64 {
    var a: u64 = h;
    a = fold.mix_f64(a, v[0]);
    a = fold.mix_f64(a, v[1]);
    ret a;
}

fun fold_i16x8(h: u64, v: i16x8) u64 {
    var a: u64    = h;
    var k: u64    = 0;
    val w: [8]i16 = v::[8]i16;
    for (k < 8) {
        a = fold.mix_i16(a, w[k]);
        k = k + 1;
    }
    ret a;
}

fun fold_u16x8(h: u64, v: u16x8) u64 {
    var a: u64    = h;
    var k: u64    = 0;
    val w: [8]u16 = v::[8]u16;
    for (k < 8) {
        a = fold.mix_u16(a, w[k]);
        k = k + 1;
    }
    ret a;
}

fun fold_u8x16(h: u64, v: u8x16) u64 {
    var a: u64    = h;
    var k: u64    = 0;
    val w: [16]u8 = v::[16]u8;
    for (k < 16) {
        a = fold.mix_u8(a, w[k]);
        k = k + 1;
    }
    ret a;
}

fun fold_i32x4(h: u64, v: i32x4) u64 {
    var a: u64 = h;
    a = fold.mix_i32(a, v[0]);
    a = fold.mix_i32(a, v[1]);
    a = fold.mix_i32(a, v[2]);
    a = fold.mix_i32(a, v[3]);
    ret a;
}

fun fold_u32x4(h: u64, v: u32x4) u64 {
    var a: u64 = h;
    a = fold.mix_u32(a, v[0]);
    a = fold.mix_u32(a, v[1]);
    a = fold.mix_u32(a, v[2]);
    a = fold.mix_u32(a, v[3]);
    ret a;
}

fun fold_i64x2(h: u64, v: i64x2) u64 {
    var a: u64 = h;
    a = fold.mix_i64(a, v[0]);
    a = fold.mix_i64(a, v[1]);
    ret a;
}

fun fold_u64x2(h: u64, v: u64x2) u64 {
    var a: u64 = h;
    a = fold.mix_u64(a, v[0]);
    a = fold.mix_u64(a, v[1]);
    ret a;
}

pub fun checksum(seed: u64) u64 {
    var h:  u64 = fold.init();
    val at: u64 = seed & 3;
    {
        var f: [16]f32;
        var k: u64 = 0;
        for (k < 16) {
            f[k] = (k::f32 - 5.5) * 1.25 + seed::f32;
            k    = k + 1;
        }
        h = fold_f32x4(h, load_f32(?f[0], at + 1));
        {
            val m: f32x2 = mid_f32(load_f32(?f[0], at + 1));
            h = fold.mix_f32(h, m[0]);
            h = fold.mix_f32(h, m[1]);
        }
        h = fold_f32x4(h, load_f32_const(?f[0]));
        store_f32(?f[0], at + 3, f32x4{1.5, -2.0, 0.25, 8.0});
        store_f32(?f[0], 8, f32x4{3.0, -0.5, 2.5, -4.0});
        k = 0;
        for (k < 16) {
            h = fold.mix_f32(h, f[k]);
            k = k + 1;
        }
    }
    {
        var f: [8]f64;
        var k: u64 = 0;
        for (k < 8) {
            f[k] = (k::f64 - 3.5) * 0.75 + seed::f64;
            k    = k + 1;
        }
        h = fold_f64x2(h, load_f64(?f[0], at + 1));
        h = fold_f64x2(h, load_f64(?f[0], 2));
    }
    {
        var a: [12]i32;
        var k: u64 = 0;
        for (k < 12) {
            a[k] = (k::i32 - 6) * 1000003 + seed::i32;
            k    = k + 1;
        }
        store_i32(?a[0], at + 1, i32x4{1073741823, -1073741823, 5, -9});
        store_i32(?a[0], 8, i32x4{1, -1, 536870912, -536870912});
        k = 0;
        for (k < 12) {
            h = fold.mix_i32(h, a[k]);
            k = k + 1;
        }
    }
    {
        var b: [40]u8;
        var k: u64 = 0;
        for (k < 40) {
            b[k] = (k * 37 + seed)::u8;
            k    = k + 1;
        }
        h = fold_u8x16(h, load_u8(?b[0], at + 1));
        store_u8(?b[0], at + 17, load_u8(?b[0], 0));
        k = 0;
        for (k < 40) {
            h = fold.mix_u8(h, b[k]);
            k = k + 1;
        }
    }
    h = fold_i16x8(h, array_i16(3 + seed::i16, -20000, at));
    {
        var v: i8x16 = i8x16{(128::u8):~i8, 127, -1, 0, 1, -127, 126, 7, (128::u8):~i8, -2, 3, 127, -127, 64, -64, 100};
        v[1] = v[1] ^ seed::i8;
        h    = fold_i16x8(h, lo_i8(v));
        h    = fold_i16x8(h, hi_i8(v));
    }
    {
        var v: u8x16 = u8x16{0, 255, 254, 0, 1, 1, 254, 7, 128, 129, 3, 255, 2, 64, 192, 100};
        v[1] = v[1] ^ seed::u8;
        h    = fold_u16x8(h, lo_u8(v));
        h    = fold_u16x8(h, hi_u8(v));
        val m: [8]u8 = mid_u8(v)::[8]u8;
        var k: u64   = 0;
        for (k < 8) {
            h = fold.mix_u8(h, m[k]);
            k = k + 1;
        }
    }
    {
        var v: i16x8 = i16x8{(32768::u16):~i16, 32767, -1, 0, 1, -32767, 32766, -7};
        v[1] = v[1] ^ seed::i16;
        h    = fold_i32x4(h, lo_i16(v));
        h    = fold_i32x4(h, hi_i16(v));
        h    = fold_i32x4(h, mid_i16(v));
    }
    {
        var v: u16x8 = u16x8{0, 65535, 65534, 0, 1, 32768, 32767, 7};
        v[1] = v[1] ^ seed::u16;
        h    = fold_u32x4(h, lo_u16(v));
        h    = fold_u32x4(h, hi_u16(v));
        val m: [4]u16 = mid_u16(v)::[4]u16;
        var k: u64    = 0;
        for (k < 4) {
            h = fold.mix_u16(h, m[k]);
            k = k + 1;
        }
    }
    {
        var v: i32x4 = i32x4{(2147483648::u32):~i32, 2147483647, -1, -2147483647};
        v[1] = v[1] ^ seed::i32;
        h    = fold_i64x2(h, lo_i32(v));
        h    = fold_i64x2(h, hi_i32(v));
    }
    {
        var v: u32x4 = u32x4{0, 4294967295, 2147483648, 7};
        v[1] = v[1] ^ seed::u32;
        h    = fold_u64x2(h, lo_u32(v));
        h    = fold_u64x2(h, hi_u32(v));
        h    = fold_u32x4(h, swap_halves(v));
    }
    {
        val r: [4]i64 = shift_i64(5 + seed::i64, -9, at);
        h = fold.mix_i64(h, r[0]);
        h = fold.mix_i64(h, r[1]);
        h = fold.mix_i64(h, r[2]);
        h = fold.mix_i64(h, r[3]);
    }
    ret h;
}
