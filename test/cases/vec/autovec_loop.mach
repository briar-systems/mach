# loops the vectorizer is expected to take at -O2 and leave alone at -O0, so the
# -O0 and -O2 checksums are themselves the oracle for the transform. the trip count
# is derived from the opaque seed and is not a multiple of any vector width, so the
# tail is always live. one loop carries a dependence from the previous element and
# must not be vectorized at all, and the float sum is accumulated in a fixed order,
# so a reassociated reduction changes the result rather than the schedule.

use corpus.lib.fold;

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val n: u64 = 67 - (seed & 1);
    val m: u64 = 37 - (seed & 1);
    val s: u32 = seed::u32;
    val z: f32 = seed::f32;

    var a: [67]u32;
    var b: [67]u32;
    var i: u64 = 0;
    for (i < n) {
        a[i] = i::u32 * 2654435761 + 12345;
        b[i] = 4294967295 - i::u32 * 40503;
        i = i + 1;
    }
    a[0] = a[0] + s;
    b[1] = b[1] + s;

    var c: [67]u32;
    i = 0;
    for (i < n) {
        c[i] = a[i] * 3 + b[i];
        i = i + 1;
    }
    i = 0;
    for (i < n) {
        h = fold.mix_u32(h, c[i]);
        i = i + 1;
    }

    var sum: u32 = 0;
    var xacc: u32 = 0;
    i = 0;
    for (i < n) {
        sum = sum + c[i];
        xacc = xacc ^ a[i];
        i = i + 1;
    }
    h = fold.mix_u32(h, sum);
    h = fold.mix_u32(h, xacc);

    # a branch per element, the if-conversion shape
    var d: [67]u32;
    i = 0;
    for (i < n) {
        if (a[i] > b[i]) { d[i] = a[i] - b[i]; } or { d[i] = b[i] - a[i]; }
        i = i + 1;
    }
    i = 0;
    for (i < n) {
        h = fold.mix_u32(h, d[i]);
        i = i + 1;
    }

    # a stride of two: the elements between the writes keep their fill value, so a
    # vectorized store that covers a contiguous run overwrites them
    var e: [67]u32;
    i = 0;
    for (i < n) {
        e[i] = 2863311530;
        i = i + 1;
    }
    i = 0;
    for (i < n) {
        e[i] = c[i] ^ 1;
        i = i + 2;
    }
    i = 0;
    for (i < n) {
        h = fold.mix_u32(h, e[i]);
        i = i + 1;
    }

    # element i needs the result for i-1, so there is no legal vectorization
    var g: [67]u32;
    g[0] = a[0];
    i = 1;
    for (i < n) {
        g[i] = g[i - 1] * 31 + a[i];
        i = i + 1;
    }
    i = 0;
    for (i < n) {
        h = fold.mix_u32(h, g[i]);
        i = i + 1;
    }

    var fa: [37]f32;
    var fb: [37]f32;
    i = 0;
    for (i < m) {
        fa[i] = i::f32 + z;
        fb[i] = 1.25 - i::f32;
        i = i + 1;
    }

    var fc: [37]f32;
    i = 0;
    for (i < m) {
        fc[i] = fa[i] * fb[i];
        i = i + 1;
    }
    i = 0;
    for (i < m) {
        h = fold.mix_f32(h, fc[i]);
        i = i + 1;
    }

    var fd: [37]f32;
    i = 0;
    for (i < m) {
        fd[i] = fa[i] / fb[i];
        i = i + 1;
    }
    i = 0;
    for (i < m) {
        h = fold.mix_f32(h, fd[i]);
        i = i + 1;
    }

    # accumulated in element order, so a reassociated reduction rounds differently
    var fs: f32 = 0.0;
    i = 0;
    for (i < m) {
        fs = fs + fd[i];
        i = i + 1;
    }
    h = fold.mix_f32(h, fs);
    ret h;
}
