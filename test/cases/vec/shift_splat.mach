# the hashing idiom a uniform shift count exists for (#3736, #3740): a lane-wise
# xorshift-multiply mix, `x ^ (x >> {16, 16, 16, 16})` then a multiply by a
# splat constant, run over several rounds, and the same round with its shift
# counts known only at run time. the counts are the same in every lane of each
# literal, so each shift is the uniform form; the rounds fold every lane.

use corpus.lib.fold;

#[noinline]
fun mix_round(x: u32x4) u32x4 {
    var y: u32x4 = x ^ (x >> u32x4{16, 16, 16, 16});
    y = y * u32x4{0x7FEB352D, 0x7FEB352D, 0x7FEB352D, 0x7FEB352D};
    y = y ^ (y >> u32x4{15, 15, 15, 15});
    y = y * u32x4{0x846CA68B, 0x846CA68B, 0x846CA68B, 0x846CA68B};
    ret y ^ (y >> u32x4{16, 16, 16, 16});
}

#[noinline]
fun mix_round_by(x: u32x4, a: u32, b: u32) u32x4 {
    var y: u32x4 = x ^ (x >> u32x4{a, a, a, a});
    y = y * u32x4{0x7FEB352D, 0x7FEB352D, 0x7FEB352D, 0x7FEB352D};
    y = y ^ (y << u32x4{b, b, b, b});
    ret y;
}

#[noinline]
fun rotate_u64(x: u64x2, k: u64) u64x2 {
    val r: u64 = 64 - k;
    ret (x << u64x2{k, k}) | (x >> u64x2{r, r});
}

#[noinline]
fun sign_steps_i16(x: i16x8, k: i16) i16x8 {
    ret (x >> i16x8{k, k, k, k, k, k, k, k}) + (x << i16x8{3, 3, 3, 3, 3, 3, 3, 3});
}

fun fold_u32x4(h: u64, v: u32x4) u64 {
    var a: u64 = h;
    a = fold.mix_u32(a, v[0]);
    a = fold.mix_u32(a, v[1]);
    a = fold.mix_u32(a, v[2]);
    a = fold.mix_u32(a, v[3]);
    ret a;
}

fun fold_u64x2(h: u64, v: u64x2) u64 {
    var a: u64 = h;
    a = fold.mix_u64(a, v[0]);
    a = fold.mix_u64(a, v[1]);
    ret a;
}

fun fold_i16x8(h: u64, v: i16x8) u64 {
    var a: u64 = h;
    a = fold.mix_i16(a, v[0]);
    a = fold.mix_i16(a, v[1]);
    a = fold.mix_i16(a, v[2]);
    a = fold.mix_i16(a, v[3]);
    a = fold.mix_i16(a, v[4]);
    a = fold.mix_i16(a, v[5]);
    a = fold.mix_i16(a, v[6]);
    a = fold.mix_i16(a, v[7]);
    ret a;
}

pub fun checksum(seed: u64) u64 {
    var h: u64   = fold.init();
    var x: u32x4 = u32x4{0x9E3779B9, 0x85EBCA6B, 0xC2B2AE35, 0x27D4EB2F};
    x[0] = x[0] + seed::u32;
    var i: u32 = 0;
    for (i < 8) {
        x = mix_round(x);
        h = fold_u32x4(h, x);
        i = i + 1;
    }
    var n: u32 = seed::u32 + 13;
    i = 0;
    for (i < 8) {
        x = mix_round_by(x, n, n + 4);
        h = fold_u32x4(h, x);
        n = n + 3;
        i = i + 1;
    }
    var r: u64x2 = u64x2{0x0123456789ABCDEF, 0xFEDCBA9876543210};
    r[1] = r[1] + seed;
    var k: u64 = seed + 1;
    for (k < 64) {
        r = rotate_u64(r, k);
        h = fold_u64x2(h, r);
        k = k + 7;
    }
    var s: i16x8 = i16x8{-32768, 32767, -1, 1, -300, 300, -7, 7};
    s[0] = s[0] + seed::i16;
    var j: i16 = seed::i16;
    for (j < 20) {
        s = sign_steps_i16(s, j);
        h = fold_i16x8(h, s);
        j = j + 3;
    }
    ret h;
}
