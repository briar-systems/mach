# f32x2 is narrower than the vector register: $size_of is 8 and $align_of is 4, one
# lane rather than the whole shape. it is a packed aggregate that loads piecewise,
# so an array of it strides by 8 and a record places it at a 4-byte offset. every
# lane runs through add, sub, mul and div, folded in lane order.

use corpus.lib.fold;

rec Pair {
    lead: u32;
    v: f32x2;
    trail: u32;
}

fun fold_vec(h: u64, v: f32x2) u64 {
    var a: u64 = fold.mix_f32(h, v[0]);
    a = fold.mix_f32(a, v[1]);
    ret a;
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val z: f32 = seed::f32;

    var a: f32x2 = f32x2{1.5, -2.25};
    var b: f32x2 = f32x2{0.5, 4.0};
    val ramp: f32x2 = f32x2{1.0, 27.0};
    a[0] = a[0] + z;
    b[1] = b[1] + z;

    h = fold_vec(h, a);
    h = fold_vec(h, b);
    h = fold_vec(h, a + b);
    h = fold_vec(h, a - b);
    h = fold_vec(h, b - a);
    h = fold_vec(h, a * b);
    h = fold_vec(h, a / b);
    h = fold_vec(h, b / a);
    h = fold_vec(h, a * ramp);
    h = fold_vec(h, ramp - b);
    h = fold_vec(h, ramp / a);

    # the product is folded before it is added, so neither side may contract the
    # pair into a fused multiply-add
    var acc: f32x2 = f32x2{0.0, 0.0};
    var i: u64 = 0;
    for (i < 6) {
        val t: f32x2 = a * ramp;
        h = fold_vec(h, t);
        acc = acc + t;
        h = fold_vec(h, acc);
        a = a - b;
        h = fold_vec(h, a);
        i = i + 1;
    }

    # six elements at an 8-byte stride: a stride rounded up to the register width
    # would read the wrong element from the third onwards
    var arr: [6]f32x2;
    arr[0] = a;
    arr[1] = a + b;
    arr[2] = a * ramp;
    arr[3] = acc;
    arr[4] = b - a;
    arr[5] = b;
    var k: u64 = 0;
    for (k < 6) {
        h = fold_vec(h, arr[k]);
        k = k + 1;
    }

    # scalars either side of the vector, so a wrong size or alignment moves a neighbour
    var r: Pair;
    r.lead = 4294967295;
    r.v = arr[2];
    r.trail = 305419896;
    h = fold.mix_u32(h, r.lead);
    h = fold_vec(h, r.v);
    h = fold.mix_u32(h, r.trail);
    ret h;
}
