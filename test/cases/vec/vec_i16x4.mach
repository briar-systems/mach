# i16x4 is narrower than the vector register: $size_of is 8 and $align_of is 2, one
# lane rather than the whole shape. that makes it a packed aggregate that loads
# piecewise, so an array of it strides by 8 and a record can place it at an odd
# halfword offset. every lane runs through add, sub, mul and the bitwise operators.

use corpus.lib.fold;

rec Pair {
    lead: u8;
    v: i16x4;
    trail: u8;
}

fun fold_vec(h: u64, v: i16x4) u64 {
    var a: u64 = fold.mix_i16(h, v[0]);
    a = fold.mix_i16(a, v[1]);
    a = fold.mix_i16(a, v[2]);
    a = fold.mix_i16(a, v[3]);
    ret a;
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: i16 = seed::i16;

    var a: i16x4 = i16x4{1001, -1103, 1207, -1301};
    var b: i16x4 = i16x4{13, -11, 9, -7};
    val ramp: i16x4 = i16x4{1, 2, 3, 4};
    val zero: i16x4 = i16x4{0, 0, 0, 0};
    a[0] = a[0] + s;
    a[3] = a[3] + s;
    b[1] = b[1] + s;
    b[2] = b[2] + s;

    h = fold_vec(h, a);
    h = fold_vec(h, b);
    h = fold_vec(h, a + b);
    h = fold_vec(h, a - b);
    h = fold_vec(h, b - a);
    h = fold_vec(h, a * b);
    h = fold_vec(h, a * ramp);
    h = fold_vec(h, b * ramp);
    h = fold_vec(h, (a + b) * ramp);
    h = fold_vec(h, zero - a);
    h = fold_vec(h, zero - b);
    h = fold_vec(h, a & b);
    h = fold_vec(h, a | b);
    h = fold_vec(h, a ^ b);
    h = fold_vec(h, ~a);
    h = fold_vec(h, ~b);
    h = fold_vec(h, (a & b) ^ (a | b));

    var acc: i16x4 = zero;
    var sum: i16x4 = zero;
    var i: u64 = 0;
    for (i < 6) {
        val t: i16x4 = a * ramp;
        h = fold_vec(h, t);
        acc = acc ^ t;
        h = fold_vec(h, acc);
        sum = sum + a;
        h = fold_vec(h, sum);
        a = a + b;
        h = fold_vec(h, a);
        i = i + 1;
    }

    # six elements at an 8-byte stride: a stride rounded up to the register width
    # would read the wrong element from the fourth onwards
    var arr: [6]i16x4;
    arr[0] = a;
    arr[1] = a + b;
    arr[2] = a * ramp;
    arr[3] = acc;
    arr[4] = sum;
    arr[5] = a ^ b;
    var k: u64 = 0;
    for (k < 6) {
        h = fold_vec(h, arr[k]);
        k = k + 1;
    }

    # a byte on either side, so the vector must land at offset 2 and leave the
    # trailing byte where the record says it is
    var r: Pair;
    r.lead = 219;
    r.v = arr[2];
    r.trail = 173;
    h = fold.mix_u8(h, r.lead);
    h = fold_vec(h, r.v);
    h = fold.mix_u8(h, r.trail);
    ret h;
}
