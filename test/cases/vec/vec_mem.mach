# the memory surface of the two shapes whose size and alignment disagree: f32x3 is
# 12 bytes aligned to 4, f32x5 is 20 bytes aligned to 16. neither can be handled by
# rounding the value up to a register: a 16-byte store into a packed buffer of
# f32x3 overwrites the next element, and a 16-byte load reads part of it. every
# write here has a live neighbour on at least one side, and the neighbour is folded
# after the write, so a store that is too wide changes the checksum.

use corpus.lib.fold;

rec Vertex {
    pos: f32x3;
    id: u32;
}

rec Odd {
    tag: u8;
    v: f32x3;
    tail: u8;
}

rec Mesh {
    head: u32;
    tri: [3]f32x3;
    foot: u32;
}

rec Wide {
    lead: u32;
    w: f32x5;
    trail: u32;
}

fun fold3(h: u64, v: f32x3) u64 {
    var a: u64 = fold.mix_f32(h, v[0]);
    a = fold.mix_f32(a, v[1]);
    a = fold.mix_f32(a, v[2]);
    ret a;
}

fun fold5(h: u64, v: f32x5) u64 {
    var a: u64 = fold.mix_f32(h, v[0]);
    a = fold.mix_f32(a, v[1]);
    a = fold.mix_f32(a, v[2]);
    a = fold.mix_f32(a, v[3]);
    a = fold.mix_f32(a, v[4]);
    ret a;
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val z: f32 = seed::f32;

    # a packed buffer written forward and read backward, so an element is never read
    # in the order it was stored
    var buf: [7]f32x3;
    var i: u64 = 0;
    for (i < 7) {
        val fi: f32 = i::f32;
        var v: f32x3;
        v[0] = fi + z;
        v[1] = fi - 1.25;
        v[2] = 100.0 - fi;
        buf[i] = v;
        i = i + 1;
    }
    var k: u64 = 7;
    for (k > 0) {
        k = k - 1;
        h = fold3(h, buf[k]);
    }

    # the vector at offset 0 of a 16-byte record, with the trailing scalar inside
    # what a 16-byte store of the vector would cover
    var verts: [4]Vertex;
    var j: u64 = 0;
    for (j < 4) {
        verts[j].pos = buf[j];
        verts[j].id = 2863311530 - j::u32;
        j = j + 1;
    }
    j = 0;
    for (j < 4) {
        h = fold3(h, verts[j].pos);
        h = fold.mix_u32(h, verts[j].id);
        j = j + 1;
    }

    var o: Odd;
    o.tag = 219;
    o.v = buf[5];
    o.tail = 173;
    h = fold.mix_u8(h, o.tag);
    h = fold3(h, o.v);
    h = fold.mix_u8(h, o.tail);

    # a whole record copied by assignment, then only the copy mutated
    var o2: Odd = o;
    o2.v = o2.v + buf[1];
    h = fold.mix_u8(h, o2.tag);
    h = fold3(h, o2.v);
    h = fold.mix_u8(h, o2.tail);
    h = fold.mix_u8(h, o.tag);
    h = fold3(h, o.v);
    h = fold.mix_u8(h, o.tail);

    var mesh: Mesh;
    mesh.head = 4294967295;
    mesh.tri[0] = buf[0];
    mesh.tri[1] = buf[3];
    mesh.tri[2] = buf[6];
    mesh.foot = 305419896;
    h = fold.mix_u32(h, mesh.head);
    var t: u64 = 0;
    for (t < 3) {
        h = fold3(h, mesh.tri[t]);
        t = t + 1;
    }
    h = fold.mix_u32(h, mesh.foot);

    var pv: f32x3 = buf[2];
    var p: *f32x3 = ?pv;
    @p = @p + buf[4];
    h = fold3(h, pv);
    val readback: f32x3 = @p;
    h = fold3(h, readback);

    # a pointer into the middle of the packed buffer: both neighbours are folded
    # after the write
    var q: *f32x3 = ?buf[3];
    @q = @q * f32x3{2.0, 4.0, 8.0};
    h = fold3(h, buf[2]);
    h = fold3(h, buf[3]);
    h = fold3(h, buf[4]);

    # the 20-byte shape, whose size is not a multiple of its alignment
    var wbuf: [5]f32x5;
    var m: u64 = 0;
    for (m < 5) {
        val fm: f32 = m::f32;
        var w: f32x5;
        w[0] = fm + z;
        w[1] = fm - 1.25;
        w[2] = 100.0 - fm;
        w[3] = fm + 7.5;
        w[4] = 0.0 - fm;
        wbuf[m] = w;
        m = m + 1;
    }
    m = 5;
    for (m > 0) {
        m = m - 1;
        h = fold5(h, wbuf[m]);
    }

    var wide: Wide;
    wide.lead = 4294967295;
    wide.w = wbuf[3];
    wide.trail = 305419896;
    h = fold.mix_u32(h, wide.lead);
    h = fold5(h, wide.w);
    h = fold.mix_u32(h, wide.trail);

    var wp: *f32x5 = ?wbuf[1];
    @wp = @wp + wbuf[4];
    h = fold5(h, wbuf[0]);
    h = fold5(h, wbuf[1]);
    h = fold5(h, wbuf[2]);
    ret h;
}
