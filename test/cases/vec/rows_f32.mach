# the vector rows at 32-bit lanes: one noinline probe per (operation, signedness
# and, for a compare, predicate) of the retained vector vocabulary, so the golden
# shows each probe's body on its own and the decoder witnesses which cells the
# target packs and which it expands per lane. every lane result folds in order.

use corpus.lib.fold;

#[noinline]
fun row_add_f32(a: f32x4, b: f32x4) f32x4 {
    ret a + b;
}

#[noinline]
fun row_sub_f32(a: f32x4, b: f32x4) f32x4 {
    ret a - b;
}

#[noinline]
fun row_mul_f32(a: f32x4, b: f32x4) f32x4 {
    ret a * b;
}

#[noinline]
fun row_div_f32(a: f32x4, b: f32x4) f32x4 {
    ret a / b;
}

#[noinline]
fun row_cmp_lt_f32(a: f32x4, b: f32x4) u32x4 {
    ret a < b;
}

#[noinline]
fun row_cmp_eq_f32(a: f32x4, b: f32x4) u32x4 {
    ret a == b;
}

fun fold_f32x4(h: u64, v: f32x4) u64 {
    var a: u64 = h;
    a = fold.mix_f32(a, v[0]);
    a = fold.mix_f32(a, v[1]);
    a = fold.mix_f32(a, v[2]);
    a = fold.mix_f32(a, v[3]);
    ret a;
}

fun fold_u32x4(h: u64, v: u32x4) u64 {
    var a: u64 = h;
    a = fold.mix_u32(a, v[0]);
    a = fold.mix_u32(a, v[1]);
    a = fold.mix_u32(a, v[2]);
    a = fold.mix_u32(a, v[3]);
    ret a;
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: f32 = seed::f32;
    {
        var a: f32x4 = f32x4{1.5, -2.25, 1024.0, 0.125};
        var b: f32x4 = f32x4{0.5, 4.0, -2.0, 8.0};
        a[0] = a[0] + s;
        h    = fold_f32x4(h, row_add_f32(a, b));
    }
    {
        var a: f32x4 = f32x4{1.5, -2.25, 1024.0, 0.125};
        var b: f32x4 = f32x4{0.5, 4.0, -2.0, 8.0};
        a[0] = a[0] + s;
        h    = fold_f32x4(h, row_sub_f32(a, b));
    }
    {
        var a: f32x4 = f32x4{1.5, -2.25, 1024.0, 0.125};
        var b: f32x4 = f32x4{0.5, 4.0, -2.0, 8.0};
        a[0] = a[0] + s;
        h    = fold_f32x4(h, row_mul_f32(a, b));
    }
    {
        var a: f32x4 = f32x4{1.5, -2.25, 1024.0, 0.125};
        var b: f32x4 = f32x4{0.5, 4.0, -2.0, 8.0};
        a[0] = a[0] + s;
        h    = fold_f32x4(h, row_div_f32(a, b));
    }
    {
        var a: f32x4 = f32x4{1.5, -2.25, 1024.0, 0.125};
        var b: f32x4 = f32x4{0.5, 4.0, -2.0, 8.0};
        a[0] = a[0] + s;
        h    = fold_u32x4(h, row_cmp_lt_f32(a, b));
    }
    {
        var a: f32x4 = f32x4{1.5, -2.25, 1024.0, 0.125};
        var b: f32x4 = f32x4{0.5, 4.0, -2.0, 8.0};
        a[0] = a[0] + s;
        h    = fold_u32x4(h, row_cmp_eq_f32(a, b));
    }
    ret h;
}
