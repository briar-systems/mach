# a window of consecutive elements through one pointer converted to a vector:
# `p[i, 4]::f32x4` is one vector load at every lane type, with a variable
# index, a constant index and a local array. a literal of loads (permuted, at
# stride two, or mixing in a second pointer) takes the lane path through a
# stack slot. every result lane folds in order and the index comes from the
# seed so each probe reads a different window.

use corpus.lib.fold;

#[noinline]
fun load_f32(p: *f32, i: u64) f32x4 {
    ret p[i, 4]::f32x4;
}

#[noinline]
fun load_f64(p: *f64, i: u64) f64x2 {
    ret p[i, 2]::f64x2;
}

#[noinline]
fun load_i32(p: *i32, i: u64) i32x4 {
    ret p[i, 4]::i32x4;
}

#[noinline]
fun load_u32(p: *u32, i: u64) u32x4 {
    ret p[i, 4]::u32x4;
}

#[noinline]
fun load_i64(p: *i64, i: u64) i64x2 {
    ret p[i, 2]::i64x2;
}

#[noinline]
fun load_i16(p: *i16, i: u64) i16x8 {
    ret p[i, 8]::i16x8;
}

#[noinline]
fun load_u8(p: *u8, i: u64) u8x16 {
    ret p[i, 16]::u8x16;
}

# constant indices: the window starts at lane 2
#[noinline]
fun load_f32_const(p: *f32) f32x4 {
    ret p[2, 4]::f32x4;
}

# a local array: the element address carries the array as its pointee
#[noinline]
fun load_f32_array(a: f32, b: f32, i: u64) f32x4 {
    var arr: [8]f32 = [8]f32{a, b, a + b, a - b, a * b, b - a, a + a, b + b};
    ret arr[i, 4]::f32x4;
}

# a literal of loads, two lanes out of order: the lane path
#[noinline]
fun load_f32_permuted(p: *f32, i: u64) f32x4 {
    ret f32x4{p[i], p[i + 2], p[i + 1], p[i + 3]};
}

# a literal of every other element: the lane path
#[noinline]
fun load_f32_stride2(p: *f32, i: u64) f32x4 {
    ret f32x4{p[i], p[i + 2], p[i + 4], p[i + 6]};
}

# a literal whose last lane reads a second pointer: the lane path
#[noinline]
fun load_f32_mixed(p: *f32, q: *f32, i: u64) f32x4 {
    ret f32x4{p[i], p[i + 1], p[i + 2], q[i + 3]};
}

fun fold_f32x4(h: u64, v: f32x4) u64 {
    var a: u64 = h;
    a = fold.mix_f32(a, v[0]);
    a = fold.mix_f32(a, v[1]);
    a = fold.mix_f32(a, v[2]);
    a = fold.mix_f32(a, v[3]);
    ret a;
}

fun fold_f64x2(h: u64, v: f64x2) u64 {
    var a: u64 = h;
    a = fold.mix_f64(a, v[0]);
    a = fold.mix_f64(a, v[1]);
    ret a;
}

fun fold_i32x4(h: u64, v: i32x4) u64 {
    var a: u64 = h;
    a = fold.mix_i32(a, v[0]);
    a = fold.mix_i32(a, v[1]);
    a = fold.mix_i32(a, v[2]);
    a = fold.mix_i32(a, v[3]);
    ret a;
}

fun fold_u32x4(h: u64, v: u32x4) u64 {
    var a: u64 = h;
    a = fold.mix_u32(a, v[0]);
    a = fold.mix_u32(a, v[1]);
    a = fold.mix_u32(a, v[2]);
    a = fold.mix_u32(a, v[3]);
    ret a;
}

fun fold_i64x2(h: u64, v: i64x2) u64 {
    var a: u64 = h;
    a = fold.mix_i64(a, v[0]);
    a = fold.mix_i64(a, v[1]);
    ret a;
}

fun fold_i16x8(h: u64, v: i16x8) u64 {
    var a: u64 = h;
    a = fold.mix_i16(a, v[0]);
    a = fold.mix_i16(a, v[1]);
    a = fold.mix_i16(a, v[2]);
    a = fold.mix_i16(a, v[3]);
    a = fold.mix_i16(a, v[4]);
    a = fold.mix_i16(a, v[5]);
    a = fold.mix_i16(a, v[6]);
    a = fold.mix_i16(a, v[7]);
    ret a;
}

fun fold_u8x16(h: u64, v: u8x16) u64 {
    var a: u64 = h;
    a = fold.mix_u8(a, v[0]);
    a = fold.mix_u8(a, v[1]);
    a = fold.mix_u8(a, v[2]);
    a = fold.mix_u8(a, v[3]);
    a = fold.mix_u8(a, v[4]);
    a = fold.mix_u8(a, v[5]);
    a = fold.mix_u8(a, v[6]);
    a = fold.mix_u8(a, v[7]);
    a = fold.mix_u8(a, v[8]);
    a = fold.mix_u8(a, v[9]);
    a = fold.mix_u8(a, v[10]);
    a = fold.mix_u8(a, v[11]);
    a = fold.mix_u8(a, v[12]);
    a = fold.mix_u8(a, v[13]);
    a = fold.mix_u8(a, v[14]);
    a = fold.mix_u8(a, v[15]);
    ret a;
}

pub fun checksum(seed: u64) u64 {
    var h:  u64 = fold.init();
    val at: u64 = seed & 3;
    {
        var f: [16]f32;
        var d: [16]f32;
        var k: u64 = 0;
        for (k < 16) {
            f[k] = (k::f32 - 5.5) * 1.25;
            d[k] = k::f32 * -0.5 + seed::f32;
            k    = k + 1;
        }
        h = fold_f32x4(h, load_f32(?f[0], at));
        h = fold_f32x4(h, load_f32(?f[0], at + 4));
        h = fold_f32x4(h, load_f32_const(?f[0]));
        h = fold_f32x4(h, load_f32_array(1.5 + seed::f32, -2.25, at));
        h = fold_f32x4(h, load_f32_permuted(?f[0], at));
        h = fold_f32x4(h, load_f32_stride2(?f[0], at));
        h = fold_f32x4(h, load_f32_mixed(?f[0], ?d[0], at));
    }
    {
        var f: [8]f64;
        var k: u64 = 0;
        for (k < 8) {
            f[k] = (k::f64 - 3.5) * 0.75 + seed::f64;
            k    = k + 1;
        }
        h = fold_f64x2(h, load_f64(?f[0], at));
        h = fold_f64x2(h, load_f64(?f[0], at + 2));
    }
    {
        var a: [16]i32;
        var u: [16]u32;
        var k: u64 = 0;
        for (k < 16) {
            a[k] = (k::i32 - 8) * 1000003 + seed::i32;
            u[k] = k::u32 * 2654435761 + seed::u32;
            k    = k + 1;
        }
        h = fold_i32x4(h, load_i32(?a[0], at));
        h = fold_u32x4(h, load_u32(?u[0], at + 1));
    }
    {
        var a: [8]i64;
        var k: u64 = 0;
        for (k < 8) {
            a[k] = (k::i64 - 4) * 1000000007 + seed::i64;
            k    = k + 1;
        }
        h = fold_i64x2(h, load_i64(?a[0], at));
    }
    {
        var a: [16]i16;
        var k: u64 = 0;
        for (k < 16) {
            a[k] = (k::i16 - 8) * 2001 + seed::i16;
            k    = k + 1;
        }
        h = fold_i16x8(h, load_i16(?a[0], at));
    }
    {
        var a: [32]u8;
        var k: u64 = 0;
        for (k < 32) {
            a[k] = (k * 37 + seed)::u8;
            k    = k + 1;
        }
        h = fold_u8x16(h, load_u8(?a[0], at));
        h = fold_u8x16(h, load_u8(?a[0], at + 16));
    }
    ret h;
}
