# u64x2 fills a 128-bit vector register with two 64-bit lanes: $size_of is 16 and
# $align_of is 16. lanes start on both sides of the wrap boundary, so a lowering
# that lets a carry cross the lane split changes the checksum.

use corpus.lib.fold;

rec Pair {
    lead: u32;
    v: u64x2;
    trail: u32;
}

fun fold_vec(h: u64, v: u64x2) u64 {
    var a: u64 = fold.mix_u64(h, v[0]);
    a = fold.mix_u64(a, v[1]);
    ret a;
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();

    var a: u64x2 = u64x2{18446744073709551600, 305419896};
    var b: u64x2 = u64x2{17, 18446744073709551615};
    val ramp: u64x2 = u64x2{1, 27};
    val zero: u64x2 = u64x2{0, 0};
    a[0] = a[0] + seed;
    b[1] = b[1] + seed;

    h = fold_vec(h, a);
    h = fold_vec(h, b);
    h = fold_vec(h, a + b);
    h = fold_vec(h, a - b);
    h = fold_vec(h, b - a);
    h = fold_vec(h, a * b);
    h = fold_vec(h, a * ramp);
    h = fold_vec(h, b * ramp);
    h = fold_vec(h, (a + b) * ramp);
    h = fold_vec(h, zero - a);
    h = fold_vec(h, zero - b);
    h = fold_vec(h, a & b);
    h = fold_vec(h, a | b);
    h = fold_vec(h, a ^ b);
    h = fold_vec(h, ~a);
    h = fold_vec(h, ~b);
    h = fold_vec(h, (a & b) ^ (a | b));

    var acc: u64x2 = zero;
    var sum: u64x2 = zero;
    var i: u64 = 0;
    for (i < 6) {
        val t: u64x2 = a * ramp;
        h = fold_vec(h, t);
        acc = acc ^ t;
        h = fold_vec(h, acc);
        sum = sum + a;
        h = fold_vec(h, sum);
        a = a + b;
        h = fold_vec(h, a);
        i = i + 1;
    }

    var arr: [4]u64x2;
    arr[0] = a;
    arr[1] = a + b;
    arr[2] = a * ramp;
    arr[3] = acc;
    var k: u64 = 0;
    for (k < 4) {
        h = fold_vec(h, arr[k]);
        k = k + 1;
    }

    # scalars either side of the vector, so a wrong size or alignment moves a neighbour
    var r: Pair;
    r.lead = 4294967295;
    r.v = arr[2];
    r.trail = 305419896;
    h = fold.mix_u32(h, r.lead);
    h = fold_vec(h, r.v);
    h = fold.mix_u32(h, r.trail);
    ret h;
}
