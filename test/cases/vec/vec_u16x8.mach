# u16x8 fills a 128-bit vector register with eight halfword lanes: $size_of is 16
# and $align_of is 16. lanes start on both sides of the wrap boundary, so every add,
# sub and mul truncates in at least one lane and a lowering that keeps the full
# 32-bit product, or lets a carry cross a lane, changes the checksum.

use corpus.lib.fold;

rec Pair {
    lead: u32;
    v: u16x8;
    trail: u32;
}

fun fold_vec(h: u64, v: u16x8) u64 {
    var a: u64 = fold.mix_u16(h, v[0]);
    a = fold.mix_u16(a, v[1]);
    a = fold.mix_u16(a, v[2]);
    a = fold.mix_u16(a, v[3]);
    a = fold.mix_u16(a, v[4]);
    a = fold.mix_u16(a, v[5]);
    a = fold.mix_u16(a, v[6]);
    a = fold.mix_u16(a, v[7]);
    ret a;
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: u16 = seed::u16;

    var a: u16x8 = u16x8{65520, 1, 32768, 65535, 4097, 2, 40000, 12345};
    var b: u16x8 = u16x8{17, 65535, 32769, 1, 60000, 30000, 25537, 54321};
    val ramp: u16x8 = u16x8{1, 3, 9, 27, 81, 243, 729, 2187};
    val zero: u16x8 = u16x8{0, 0, 0, 0, 0, 0, 0, 0};
    a[0] = a[0] + s;
    a[6] = a[6] + s;
    b[2] = b[2] + s;
    b[7] = b[7] + s;

    h = fold_vec(h, a);
    h = fold_vec(h, b);
    h = fold_vec(h, a + b);
    h = fold_vec(h, a - b);
    h = fold_vec(h, b - a);
    h = fold_vec(h, a * b);
    h = fold_vec(h, a * ramp);
    h = fold_vec(h, b * ramp);
    h = fold_vec(h, (a + b) * ramp);
    h = fold_vec(h, zero - a);
    h = fold_vec(h, zero - b);
    h = fold_vec(h, a & b);
    h = fold_vec(h, a | b);
    h = fold_vec(h, a ^ b);
    h = fold_vec(h, ~a);
    h = fold_vec(h, ~b);
    h = fold_vec(h, (a & b) ^ (a | b));

    var acc: u16x8 = zero;
    var sum: u16x8 = zero;
    var i: u64 = 0;
    for (i < 6) {
        val t: u16x8 = a * ramp;
        h = fold_vec(h, t);
        acc = acc ^ t;
        h = fold_vec(h, acc);
        sum = sum + a;
        h = fold_vec(h, sum);
        a = a + b;
        h = fold_vec(h, a);
        i = i + 1;
    }

    var arr: [4]u16x8;
    arr[0] = a;
    arr[1] = a + b;
    arr[2] = a * ramp;
    arr[3] = acc;
    var k: u64 = 0;
    for (k < 4) {
        h = fold_vec(h, arr[k]);
        k = k + 1;
    }

    # scalars either side of the vector, so a wrong size or alignment moves a neighbour
    var r: Pair;
    r.lead = 4294967295;
    r.v = arr[2];
    r.trail = 305419896;
    h = fold.mix_u32(h, r.lead);
    h = fold_vec(h, r.v);
    h = fold.mix_u32(h, r.trail);
    ret h;
}
