# twenty-eight values live at once across a loop that also calls out, so every
# register bank is oversubscribed and the allocator must spill. the chain is
# cyclic, so no value can be rematerialized from a later one or sunk out of the
# loop, and every value is folded at the end. a spill slot that is too narrow, a
# reload that misses a store, or a spill dropped across the call changes the
# checksum rather than merely the schedule.

use corpus.lib.fold;

fun rol(x: u64, n: u64) u64 { ret (x << n) | (x >> (64 - n)); }

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: u64 = seed;

    var a0: u64 = 6364136223846793005 + s;
    var a1: u64 = 1442695040888963407 ^ s;
    var a2: u64 = 11400714819323198485 + s;
    var a3: u64 = 14029467366897019727 ^ s;
    var a4: u64 = 1609587929392839161 + s;
    var a5: u64 = 9650029242287828579 ^ s;
    var a6: u64 = 2870177450012600261 + s;
    var a7: u64 = 8261357461348097633 ^ s;
    var a8: u64 = 4823894509314446453 + s;
    var a9: u64 = 3512524072905137951 ^ s;
    var a10: u64 = 7046029254386353131 + s;
    var a11: u64 = 5545126536417089969 ^ s;
    var a12: u64 = 12297829382473034411 + s;
    var a13: u64 = 15726070495360670683 ^ s;
    var a14: u64 = 2246822519342508753 + s;
    var a15: u64 = 3266489917871134591 ^ s;

    # narrower slots beside the wide ones: a 4-byte spill reloaded as 8 bytes
    # carries the neighbour's bits back
    var w0: u32 = (2654435761 + s)::u32;
    var w1: u32 = (40503 ^ s)::u32;
    var w2: u32 = (2246822519 + s)::u32;
    var w3: u32 = (3266489917 ^ s)::u32;

    val z: f64 = seed::f64;
    var f0: f64 = 1.5 + z;
    var f1: f64 = -2.25 + z;
    var f2: f64 = 3.125 + z;
    var f3: f64 = -0.75 + z;
    var f4: f64 = 5.625 + z;
    var f5: f64 = -1.375 + z;
    var f6: f64 = 0.875 + z;
    var f7: f64 = -4.5 + z;

    var i: u64 = 0;
    for (i < 24) {
        val t: u64 = a0 ^ rol(a15, 29);
        a0 = a1 + rol(a0, 7);
        a1 = a2 ^ rol(a1, 11);
        a2 = a3 + rol(a2, 13);
        a3 = a4 ^ rol(a3, 17);
        a4 = a5 + rol(a4, 19);
        a5 = a6 ^ rol(a5, 23);
        a6 = a7 + rol(a6, 31);
        a7 = a8 ^ rol(a7, 37);
        a8 = a9 + rol(a8, 41);
        a9 = a10 ^ rol(a9, 43);
        a10 = a11 + rol(a10, 47);
        a11 = a12 ^ rol(a11, 53);
        a12 = a13 + rol(a12, 59);
        a13 = a14 ^ rol(a13, 61);
        a14 = a15 + rol(a14, 3);
        a15 = t + i;

        val u: u32 = w0 ^ (a12::u32);
        w0 = w1 + (a0::u32);
        w1 = w2 ^ (a4::u32);
        w2 = w3 + (a8::u32);
        w3 = u;

        val g: f64 = f0;
        f0 = f0 * 1.5 + f1;
        f1 = f1 * 0.75 + f2;
        f2 = f2 * 1.25 + f3;
        f3 = f3 * 0.5 + f4;
        f4 = f4 * 1.75 + f5;
        f5 = f5 * 0.625 + f6;
        f6 = f6 * 1.125 + f7;
        f7 = f7 * 0.875 + g;

        h = fold.mix_u64(h, a0 ^ a8);
        h = fold.mix_u32(h, w0);
        h = fold.mix_f64(h, f0 + f4);
        i = i + 1;
    }

    h = fold.mix_u64(h, a0);
    h = fold.mix_u64(h, a1);
    h = fold.mix_u64(h, a2);
    h = fold.mix_u64(h, a3);
    h = fold.mix_u64(h, a4);
    h = fold.mix_u64(h, a5);
    h = fold.mix_u64(h, a6);
    h = fold.mix_u64(h, a7);
    h = fold.mix_u64(h, a8);
    h = fold.mix_u64(h, a9);
    h = fold.mix_u64(h, a10);
    h = fold.mix_u64(h, a11);
    h = fold.mix_u64(h, a12);
    h = fold.mix_u64(h, a13);
    h = fold.mix_u64(h, a14);
    h = fold.mix_u64(h, a15);
    h = fold.mix_u32(h, w0);
    h = fold.mix_u32(h, w1);
    h = fold.mix_u32(h, w2);
    h = fold.mix_u32(h, w3);
    h = fold.mix_f64(h, f0);
    h = fold.mix_f64(h, f1);
    h = fold.mix_f64(h, f2);
    h = fold.mix_f64(h, f3);
    h = fold.mix_f64(h, f4);
    h = fold.mix_f64(h, f5);
    h = fold.mix_f64(h, f6);
    h = fold.mix_f64(h, f7);
    ret h;
}
