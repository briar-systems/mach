# every local of a frame sits below the frame pointer's one-word reach once a
# 768-byte pad is laid out: scalars of each width, two floats, a packed record
# whose wider fields sit at offsets no access width divides, and a short tail
# array. each slot is written, read back after a loop over the pad, and folded,
# at four seeds

use corpus.lib.fold;

#[packed]
rec Skewed {
    tag:  u8;
    wide: u64;
    mid:  u32;
    half: u16;
}

fun mix(h: u64, v: u64) u64 {
    ret (h ^ v) * 1099511628211;
}

#[noinline]
fun deep_slots(seed: u64) u64 {
    var pad:  [96]u64;
    var a:    u64 = seed + 1;
    var b:    u32 = (seed + 2)::u32;
    var c:    u16 = (seed + 3)::u16;
    var d:    u8  = (seed + 4)::u8;
    var e:    f64 = 1.5;
    var g:    f32 = 2.25;
    var s:    Skewed;
    var tail: [3]u8;
    pad[0]  = a;
    pad[95] = seed;
    s.tag   = d;
    s.wide  = a * 3;
    s.mid   = b + 7;
    s.half  = c + 9;
    tail[0] = d + 1;
    tail[2] = d + 2;

    var i: u64 = 1;
    for (i < 95) {
        pad[i] = pad[i - 1] + i;
        i      = i + 1;
    }
    a = a + pad[94];
    b = b + s.mid;
    c = c + s.half;
    e = e + g::f64;

    var h: u64 = 14695981039346656037;
    h = mix(h, a);
    h = mix(h, b::u64);
    h = mix(h, c::u64);
    h = mix(h, d::u64);
    h = mix(h, e::u64);
    h = mix(h, s.tag::u64);
    h = mix(h, s.wide);
    h = mix(h, s.mid::u64);
    h = mix(h, s.half::u64);
    h = mix(h, tail[0]::u64 + tail[2]::u64);
    h = mix(h, pad[95]);
    ret h;
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    var k: u64 = 0;
    for (k < 4) {
        h = fold.mix_u64(h, deep_slots((seed + k) * 1000003));
        k = k + 1;
    }
    ret h;
}
