# frames that need stack probes, recursed deep enough to walk far past the
# committed stack: a frame of one page less its header and one of a page
# multiple, each at every alignment three hundred calls sweep, a 24 KiB frame
# whose probe walks pages at depth, and a probed frame that also returns a
# record through memory. the cold branch never runs and only sizes the frame

use corpus.lib.fold;

#[volatile]
rec BarePageStorage {
    first: u8;
    rest:  [4031]u8;
}

#[volatile]
rec MultiplePageStorage {
    first: u8;
    rest:  [8127]u8;
}

#[noinline]
fun bare_page_recurse(n: i32) i32 {
    if (n == -1234567) {
        var cold: BarePageStorage;
        cold.first = 1;
        ret cold.first::i32;
    }
    if (n <= 0) { ret 7; }
    val x: i32 = bare_page_recurse(n - 1);
    ret x + 1;
}

#[noinline]
fun page_multiple_recurse(n: i32) i32 {
    if (n == -1234567) {
        var cold: MultiplePageStorage;
        cold.first = 1;
        ret cold.first::i32;
    }
    if (n <= 0) { ret 11; }
    val x: i32 = page_multiple_recurse(n - 1);
    ret x + 1;
}

#[noinline]
fun deep_wide_recurse(n: i32, seed: u8) u8 {
    var buf: [24576]u8;
    buf[24575] = seed;
    buf[0]     = n::u8;
    if (n <= 0) { ret buf[0] + buf[24575]; }
    val r: u8 = deep_wide_recurse(n - 1, seed + 1);
    ret r + buf[0];
}

rec Desc {
    a: i64;
    b: i32;
}

#[noinline]
fun make_desc() Desc {
    var d: Desc;
    d.a = 77;
    d.b = 3;
    ret d;
}

#[noinline]
fun saved_frame_recurse(n: i32, acc: i64) i64 {
    var buf: [8100]u8;
    buf[8099] = n::u8;
    val d: Desc = make_desc();
    if (n <= 0) { ret acc + d.a + buf[8099]::i64; }
    val r: i64 = saved_frame_recurse(n - 1, acc + d.b::i64);
    ret r + buf[8099]::i64;
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: i32 = seed::i32;
    h = fold.mix_i32(h, bare_page_recurse(300 + s));
    h = fold.mix_i32(h, page_multiple_recurse(300 + s));
    h = fold.mix_u8(h, deep_wide_recurse(64 + s, 1 + seed::u8));
    h = fold.mix_i64(h, saved_frame_recurse(300 + s, seed::i64));
    ret h;
}
