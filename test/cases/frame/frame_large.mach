# a frame far past 4 KiB: three arrays totalling 8 KiB, so a local's displacement
# from the frame base leaves the short-immediate range every target encodes
# directly. constant far-end indices pin the largest displacements, runtime
# indices exercise the computed form, and both ends are read before any write so
# default initialization is proven to cover the whole frame and not its first page.

use corpus.lib.fold;

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: u64 = seed;

    var a: [640]u64;
    var b: [512]u32;
    var c: [1024]u8;

    h = fold.mix_u64(h, a[0]);
    h = fold.mix_u64(h, a[639]);
    h = fold.mix_u32(h, b[0]);
    h = fold.mix_u32(h, b[511]);
    h = fold.mix_u8(h, c[0]);
    h = fold.mix_u8(h, c[1023]);

    var i: u64 = 0;
    for (i < 640) {
        a[i] = ((i + s) * 6364136223846793005) ^ (i << 17);
        i = i + 1;
    }

    i = 0;
    for (i < 512) {
        b[i] = (((i * 2654435761) + s) ^ (i >> 3))::u32;
        i = i + 1;
    }

    i = 0;
    for (i < 1024) {
        c[i] = (((i * 131) + s) ^ (i >> 2))::u8;
        i = i + 1;
    }

    # folding inside the loop puts a call under the large frame, so a callee-saved
    # register or a frame base the prologue got wrong shows up as a wrong element
    var j: u64 = 0;
    for (j < 64) {
        h = fold.mix_u64(h, a[(((j * 9) + s) % 640)]);
        h = fold.mix_u32(h, b[(((j * 13) + s) % 512)]);
        h = fold.mix_u8(h, c[(((j * 29) + s) % 1024)]);
        j = j + 1;
    }

    a[(639 - (s & 1))] = a[639] + 1;
    b[(511 - (s & 3))] = b[511] + 7;
    c[(1023 - (s & 7))] = (c[1023] + 11)::u8;

    h = fold.mix_u64(h, a[638]);
    h = fold.mix_u64(h, a[639]);
    h = fold.mix_u32(h, b[508]);
    h = fold.mix_u32(h, b[511]);
    h = fold.mix_u8(h, c[1016]);
    h = fold.mix_u8(h, c[1023]);
    ret h;
}
