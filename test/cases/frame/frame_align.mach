# over-aligned locals in a frame deliberately made awkward. f32x4, f64x2 and
# u32x4 each fill the vector register and so align to 16, the ABI only promises
# 16 at a call boundary, and `Wide` asks for 64, which forces the masking
# prologue. odd-sized locals sit between them so no alignment comes for free.
#
# an address is not a value, so nothing here masks one. alignment is proven by
# results: a whole-register vector load or store on a misaligned slot either
# faults or reads the wrong bytes, and every lane and every field is folded in a
# fixed order, so either shows up as a different checksum or a nonzero exit.

use corpus.lib.fold;

#[align(64)]
rec Wide {
    a: u64;
    b: u64;
}

fun fold_f32x4(h: u64, v: f32x4) u64 {
    var t: u64 = fold.mix_f32(h, v[0]);
    t = fold.mix_f32(t, v[1]);
    t = fold.mix_f32(t, v[2]);
    t = fold.mix_f32(t, v[3]);
    ret t;
}

fun fold_f64x2(h: u64, v: f64x2) u64 {
    var t: u64 = fold.mix_f64(h, v[0]);
    t = fold.mix_f64(t, v[1]);
    ret t;
}

fun fold_u32x4(h: u64, v: u32x4) u64 {
    var t: u64 = fold.mix_u32(h, v[0]);
    t = fold.mix_u32(t, v[1]);
    t = fold.mix_u32(t, v[2]);
    t = fold.mix_u32(t, v[3]);
    ret t;
}

# a callee with its own over-aligned local and its own odd-sized one, so the
# masking prologue is exercised where a frame pointer and a return address
# already sit on the stack
fun spin(v: f32x4) f32x4 {
    var odd: [7]u8;
    var acc: f32x4 = f32x4{0.0, 0.0, 0.0, 0.0};
    var i: u64 = 0;
    for (i < 4) {
        odd[i] = (i * 17)::u8;
        acc = acc + v;
        acc = acc * f32x4{1.5, 0.5, 1.25, 0.75};
        i = i + 1;
    }
    acc[0] = acc[0] + (odd[3]::f32);
    ret acc;
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: u64 = seed;
    val z: f32 = seed::f32;
    val w: f64 = seed::f64;

    var pad0: [3]u8;
    var va: f32x4 = f32x4{1.5, -2.25, 3.75, -0.5};
    var pad1: [5]u8;
    var da: f64x2 = f64x2{1.25, -3.5};
    var pad2: u16;
    var ua: u32x4 = u32x4{4294967295, 1, 2654435761, 305419896};
    var pad3: [1]u8;
    var db: f64x2 = f64x2{0.5, 6.25};
    var ub: u32x4 = u32x4{3266489917, 2246822519, 7, 4294967291};
    var big: Wide;
    var arr: [3]Wide;
    var vs: [4]f32x4;

    pad0[0] = (s + 1)::u8;
    pad0[2] = (s + 3)::u8;
    pad1[1] = (s + 5)::u8;
    pad1[4] = (s + 7)::u8;
    pad2 = (s + 65521)::u16;
    pad3[0] = (s + 251)::u8;

    va[0] = va[0] + z;
    da[1] = da[1] + w;
    ua[2] = ua[2] + s::u32;

    h = fold_f32x4(h, va);
    h = fold_f64x2(h, da);
    h = fold_u32x4(h, ua);
    h = fold_f32x4(h, va + va);
    h = fold_f32x4(h, va * va);
    h = fold_f64x2(h, db);
    h = fold_f64x2(h, da * db);
    h = fold_f64x2(h, da - db);
    h = fold_f64x2(h, da / db);
    h = fold_u32x4(h, ub);
    h = fold_u32x4(h, ua * ub);
    h = fold_u32x4(h, ua + ub);
    h = fold_u32x4(h, ua ^ ub);

    h = fold_f32x4(h, spin(va));
    h = fold_f32x4(h, spin(va * va));

    # a packed array of the whole-register shape: every element is 16-aligned only
    # if the array's own base is
    vs[0] = va;
    vs[1] = va + va;
    vs[2] = spin(va);
    vs[3] = va * va;
    var k: u64 = 0;
    for (k < 4) {
        h = fold_f32x4(h, vs[k]);
        k = k + 1;
    }

    big.a = 1229782938247303441 + s;
    big.b = 8608480567731124087 ^ s;
    h = fold.mix_u64(h, big.a);
    h = fold.mix_u64(h, big.b);

    k = 0;
    for (k < 3) {
        arr[k].a = (k * 2654435761) + s;
        arr[k].b = (k << 40) ^ big.a;
        k = k + 1;
    }
    k = 0;
    for (k < 3) {
        h = fold.mix_u64(h, arr[k].a);
        h = fold.mix_u64(h, arr[k].b);
        k = k + 1;
    }

    h = fold.mix_u8(h, pad0[0]);
    h = fold.mix_u8(h, pad0[1]);
    h = fold.mix_u8(h, pad0[2]);
    h = fold.mix_u8(h, pad1[1]);
    h = fold.mix_u8(h, pad1[4]);
    h = fold.mix_u16(h, pad2);
    h = fold.mix_u8(h, pad3[0]);
    ret h;
}
