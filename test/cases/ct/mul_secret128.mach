# the widening multiply of two secret 64-bit limbs, the shape a multi-precision
# library writes: the full product, its high half selected by a shift by 64 and
# its low half, beside a public schoolbook reference over 32-bit halves. the
# high-half form must compile to the target's one high multiply (mul, umulh,
# mulhu) with no 128-bit product materialized. only a target that admits a
# secret 64-bit widening multiply builds this case.

use corpus.lib.fold;
use corpus.lib.fold128;

#[noinline]
#[oblivious]
fun hw_hi(a: ^u64, b: ^u64) ^u64 {
    ret (((a::^u128) * (b::^u128)) >> 64)::^u64;
}

#[noinline]
#[oblivious]
fun hw_lo(a: ^u64, b: ^u64) ^u64 {
    ret ((a::^u128) * (b::^u128))::^u64;
}

#[noinline]
#[oblivious]
fun hw_wide(a: ^u64, b: ^u64) ^u128 {
    ret (a::^u128) * (b::^u128);
}

# the same product over four 32 x 32 partial products
fun ref_hi(a: u64, b: u64) u64 {
    val al: u64 = a & 0xFFFF_FFFF;
    val ah: u64 = a >> 32;
    val bl: u64 = b & 0xFFFF_FFFF;
    val bh: u64 = b >> 32;
    val ll: u64 = al * bl;
    val lh: u64 = al * bh;
    val hl: u64 = ah * bl;
    val hh: u64 = ah * bh;
    val mid: u64 = (ll >> 32) + (lh & 0xFFFF_FFFF) + (hl & 0xFFFF_FFFF);
    ret hh + (lh >> 32) + (hl >> 32) + (mid >> 32);
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val ops: [8]u64 = [8]u64{0, 1, 18446744073709551615, 9223372036854775808,
        6510615555426900570 ^ seed, 14106333703424951235 ^ seed, 7 ^ seed, 18446744073709551614 ^ seed};
    var i: u64 = 0;
    for (i < 8) {
        var j: u64 = 0;
        for (j < 8) {
            h = fold.mix_u64(h, hw_hi(ops[i], ops[j]):>u64);
            h = fold.mix_u64(h, ref_hi(ops[i], ops[j]));
            h = fold.mix_u64(h, hw_lo(ops[i], ops[j]):>u64);
            h = fold.mix_u64(h, ops[i] * ops[j]);
            h = fold128.mix_u128(h, hw_wide(ops[i], ops[j]):>u128);
            j = j + 1;
        }
        i = i + 1;
    }
    ret h;
}
