# secrets the convention passes and returns through memory: a 32-byte vector, a
# 40-byte record, a 16-byte record, a five-element array and a record holding a
# secret array, each crossing an #[oblivious] call by value and coming back by
# value (#4133). a stack-passed or indirectly passed argument and the hidden
# result pointer are public addresses to secret bytes, so every column that
# checks constant time builds these; `chain` also passes each result straight on
# as the next call's argument.

use corpus.lib.fold;

rec Big {
    a: u64;
    b: u64;
    c: u64;
    d: u64;
    e: u64;
}

rec Two {
    a: u64;
    b: u64;
}

rec Keyed {
    k:   ^[40]u8;
    tag: u64;
}

#[noinline]
#[oblivious]
fun vx(a: ^u32x8, b: ^u32x8) ^u32x8 {
    ret (a ^ b) + a;
}

#[noinline]
#[oblivious]
fun bx(a: ^Big, b: ^Big) ^Big {
    var r: ^Big = a;
    r.a = a.a ^ b.e;
    r.c = a.c + b.b;
    r.e = a.e + b.a;
    ret r;
}

#[noinline]
#[oblivious]
fun tx(a: ^Two, b: ^Two) ^Two {
    var r: ^Two = a;
    r.a = a.a ^ b.b;
    r.b = a.b + b.a;
    ret r;
}

#[noinline]
#[oblivious]
fun ax(a: ^[5]u64, b: ^[5]u64) ^[5]u64 {
    var r: ^[5]u64 = a;
    var i: u64     = 0;
    for (i < 5) {
        r[i] = a[i] ^ b[4 - i];
        i    = i + 1;
    }
    ret r;
}

#[noinline]
#[oblivious]
fun kx(a: Keyed, b: Keyed) Keyed {
    var r: Keyed = a;
    r.k[0]  = a.k[0] ^ b.k[39];
    r.k[39] = a.k[39] + b.k[0];
    r.tag   = a.tag + b.tag;
    ret r;
}

#[noinline]
#[oblivious]
fun chain(v: ^u32x8, g: ^Big, t: ^Two, q: ^[5]u64) ^Big {
    val w: ^u32x8  = vx(vx(v, v), v);
    val h: ^Big    = bx(bx(g, g), g);
    val u: ^Two    = tx(tx(t, t), t);
    val z: ^[5]u64 = ax(ax(q, q), q);
    var r: ^Big    = h;
    r.b = h.b ^ w[5]::^u64;
    r.d = h.d ^ u.b ^ z[3];
    ret r;
}

fun fold_vec(h: u64, v: u32x8) u64 {
    var r: u64 = fold.mix_u32(h, v[0]);
    r = fold.mix_u32(r, v[1]);
    r = fold.mix_u32(r, v[2]);
    r = fold.mix_u32(r, v[3]);
    r = fold.mix_u32(r, v[4]);
    r = fold.mix_u32(r, v[5]);
    r = fold.mix_u32(r, v[6]);
    ret fold.mix_u32(r, v[7]);
}

fun fold_big(h: u64, g: Big) u64 {
    var r: u64 = fold.mix_u64(h, g.a);
    r = fold.mix_u64(r, g.b);
    r = fold.mix_u64(r, g.c);
    r = fold.mix_u64(r, g.d);
    ret fold.mix_u64(r, g.e);
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: u32 = seed::u32;

    val v: u32x8 = u32x8{2863311530 ^ s, 1, 4294967295, 2147483648, 7 ^ s, 305419896, 65535 ^ s, 3735928559};
    val u: u32x8 = u32x8{1431655765, 2 ^ s, 0, 4294967294, 3 ^ s, 2271560481, 16777215, 4276215469 ^ s};
    h = fold_vec(h, vx(v, u):>u32x8);
    h = fold_vec(h, vx(u, v):>u32x8);

    val g: Big = Big{a: 6510615555426900570 ^ seed, b: 1, c: 18446744073709551615, d: 9223372036854775808, e: 7 ^ seed};
    val k: Big = Big{a: 3, b: 14106333703424951235 ^ seed, c: 18446744073709551614, d: 5 ^ seed, e: 81985529216486895};
    h = fold_big(h, bx(g, k):>Big);
    h = fold_big(h, bx(k, g):>Big);

    val t:  Two = Two{a: 12297829382473034410 ^ seed, b: 18446744073709551615};
    val o:  Two = Two{a: 2, b: 6148914691236517205 ^ seed};
    val tr: Two = tx(t, o):>Two;
    h = fold.mix_u64(h, tr.a);
    h = fold.mix_u64(h, tr.b);

    val q:  [5]u64 = [5]u64{1 ^ seed, 18446744073709551615, 9223372036854775808, 12345678901234567 ^ seed, 42};
    val p:  [5]u64 = [5]u64{7, 11 ^ seed, 13, 17, 18446744073709551557 ^ seed};
    val ar: [5]u64 = ax(q, p):>[5]u64;
    var i:  u64    = 0;
    for (i < 5) {
        h = fold.mix_u64(h, ar[i]);
        i = i + 1;
    }

    var ka: Keyed;
    var kb: Keyed;
    var j:  u64 = 0;
    for (j < 40) {
        ka.k[j] = (seed + j * 37)::u8;
        kb.k[j] = (seed ^ (j * 91))::u8;
        j       = j + 1;
    }
    ka.tag = seed;
    kb.tag = 18446744073709551615;
    val kr: Keyed = kx(ka, kb);
    j = 0;
    for (j < 40) {
        h = fold.mix_u8(h, kr.k[j]:>u8);
        j = j + 1;
    }
    h = fold.mix_u64(h, kr.tag);

    h = fold_big(h, chain(v, g, t, q):>Big);
    ret h;
}
