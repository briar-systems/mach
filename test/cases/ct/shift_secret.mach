# a shift by a secret count in a #[oblivious] function: the saturation of a
# count at or above the width is a compare and a mask, never a branch, so every
# column that admits a secret variable shift builds these and the validator
# finds no conditional branch on the count (#3756). the counts straddle the
# width of each operand: 0, 1, w-1, w, w+1, 2w and 255.

use corpus.lib.fold;

#[noinline]
#[oblivious]
fun shl8(a: ^u8, n: ^u8) ^u8 { ret a << n; }

#[noinline]
#[oblivious]
fun sar8(a: ^i8, n: ^u8) ^i8 { ret a >> n; }

#[noinline]
#[oblivious]
fun shr32(a: ^u32, n: ^u8) ^u32 { ret a >> n; }

#[noinline]
#[oblivious]
fun sar32(a: ^i32, n: ^u8) ^i32 { ret a >> n; }

#[noinline]
#[oblivious]
fun shl64(a: ^u64, n: ^u8) ^u64 { ret a << n; }

#[noinline]
#[oblivious]
fun shr64(a: ^u64, n: ^u8) ^u64 { ret a >> n; }

#[noinline]
#[oblivious]
fun sar64(a: ^i64, n: ^u8) ^i64 { ret a >> n; }

fun fold8(h: u64, seed: u64) u64 {
    val counts: [7]u8 = [7]u8{0, 1, 7, 8, 9, 16, 255};
    val a:      u8    = 165 ^ seed::u8;
    val b:      i8    = (-91 ^ seed::i8);
    var r:      u64   = h;
    var i:      u64   = 0;
    for (i < 7) {
        r = fold.mix_u8(r, shl8(a, counts[i]):>u8);
        r = fold.mix_i8(r, sar8(b, counts[i]):>i8);
        i = i + 1;
    }
    ret r;
}

fun fold32(h: u64, seed: u64) u64 {
    val counts: [7]u8 = [7]u8{0, 1, 31, 32, 33, 64, 255};
    val a:      u32   = 2863311530 ^ seed::u32;
    val b:      i32   = (-1431655766 ^ seed::i32);
    var r:      u64   = h;
    var i:      u64   = 0;
    for (i < 7) {
        r = fold.mix_u32(r, shr32(a, counts[i]):>u32);
        r = fold.mix_i32(r, sar32(b, counts[i]):>i32);
        r = fold.mix_i32(r, sar32(-b, counts[i]):>i32);
        i = i + 1;
    }
    ret r;
}

fun fold64(h: u64, seed: u64) u64 {
    val counts: [7]u8 = [7]u8{0, 1, 63, 64, 65, 128, 255};
    val a:      u64   = 12297829382473034410 ^ seed;
    val b:      i64   = (-6148914691236517206 ^ seed:~i64);
    var r:      u64   = h;
    var i:      u64   = 0;
    for (i < 7) {
        r = fold.mix_u64(r, shl64(a, counts[i]):>u64);
        r = fold.mix_u64(r, shr64(a, counts[i]):>u64);
        r = fold.mix_i64(r, sar64(b, counts[i]):>i64);
        r = fold.mix_i64(r, sar64(-b, counts[i]):>i64);
        i = i + 1;
    }
    ret r;
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    h = fold8(h, seed);
    h = fold32(h, seed);
    h = fold64(h, seed);
    ret h;
}
