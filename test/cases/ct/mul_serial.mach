# the branch-free bit-serial multiply over secret operands at every width, beside
# the public product of the same operands: the reference ct/mul_secret checks the
# secret hardware multiply against, proven here on every target. the operands are
# the extremes (0, 1, all-ones, top bit) and four seed-mixed patterns, every pair.

use corpus.lib.fold;

#[noinline]
#[oblivious]
fun serial8(a: ^u8, b: ^u8) ^u8 {
    var acc: ^u8 = 0;
    var i:   u8  = 0;
    for (i < 8) {
        val bit: ^u8 = (b >> i) & 1;
        acc = acc + ((a << i) & (0 - bit));
        i   = i + 1;
    }
    ret acc;
}

#[noinline]
#[oblivious]
fun serial16(a: ^u16, b: ^u16) ^u16 {
    var acc: ^u16 = 0;
    var i:   u16  = 0;
    for (i < 16) {
        val bit: ^u16 = (b >> i) & 1;
        acc = acc + ((a << i) & (0 - bit));
        i   = i + 1;
    }
    ret acc;
}

#[noinline]
#[oblivious]
fun serial32(a: ^u32, b: ^u32) ^u32 {
    var acc: ^u32 = 0;
    var i:   u32  = 0;
    for (i < 32) {
        val bit: ^u32 = (b >> i) & 1;
        acc = acc + ((a << i) & (0 - bit));
        i   = i + 1;
    }
    ret acc;
}

#[noinline]
#[oblivious]
fun serial64(a: ^u64, b: ^u64) ^u64 {
    var acc: ^u64 = 0;
    var i:   u64  = 0;
    for (i < 64) {
        val bit: ^u64 = (b >> i) & 1;
        acc = acc + ((a << i) & (0 - bit));
        i   = i + 1;
    }
    ret acc;
}

fun fold8(h: u64, seed: u64) u64 {
    val s:   u8    = seed::u8;
    val ops: [8]u8 = [8]u8{0, 1, 255, 128, 90 ^ s, 195 ^ s, 7 ^ s, 254 ^ s};
    var r:   u64   = h;
    var i:   u64   = 0;
    for (i < 8) {
        var j: u64 = 0;
        for (j < 8) {
            r = fold.mix_u8(r, serial8(ops[i], ops[j]):>u8);
            r = fold.mix_u8(r, ops[i] * ops[j]);
            j = j + 1;
        }
        i = i + 1;
    }
    ret r;
}

fun fold16(h: u64, seed: u64) u64 {
    val s:   u16    = seed::u16;
    val ops: [8]u16 = [8]u16{0, 1, 65535, 32768, 23130 ^ s, 50115 ^ s, 7 ^ s, 65534 ^ s};
    var r:   u64    = h;
    var i:   u64    = 0;
    for (i < 8) {
        var j: u64 = 0;
        for (j < 8) {
            r = fold.mix_u16(r, serial16(ops[i], ops[j]):>u16);
            r = fold.mix_u16(r, ops[i] * ops[j]);
            j = j + 1;
        }
        i = i + 1;
    }
    ret r;
}

fun fold32(h: u64, seed: u64) u64 {
    val s:   u32    = seed::u32;
    val ops: [8]u32 = [8]u32{0, 1, 4294967295, 2147483648, 1515870810 ^ s, 3284386755 ^ s, 7 ^ s, 4294967294 ^ s};
    var r:   u64    = h;
    var i:   u64    = 0;
    for (i < 8) {
        var j: u64 = 0;
        for (j < 8) {
            r = fold.mix_u32(r, serial32(ops[i], ops[j]):>u32);
            r = fold.mix_u32(r, ops[i] * ops[j]);
            j = j + 1;
        }
        i = i + 1;
    }
    ret r;
}

fun fold64(h: u64, seed: u64) u64 {
    val ops: [8]u64 = [8]u64{0, 1, 18446744073709551615, 9223372036854775808,
        6510615555426900570 ^ seed, 14106333703424951235 ^ seed, 7 ^ seed, 18446744073709551614 ^ seed};
    var r: u64 = h;
    var i: u64 = 0;
    for (i < 8) {
        var j: u64 = 0;
        for (j < 8) {
            r = fold.mix_u64(r, serial64(ops[i], ops[j]):>u64);
            r = fold.mix_u64(r, ops[i] * ops[j]);
            j = j + 1;
        }
        i = i + 1;
    }
    ret r;
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    h = fold8(h, seed);
    h = fold16(h, seed);
    h = fold32(h, seed);
    h = fold64(h, seed);
    ret h;
}
