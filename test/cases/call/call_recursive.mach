# recursion deep enough that per-frame storage has to be per-frame. every recursive
# function here writes locals, recurses, and then reads those locals back, so a
# frame that shares storage with its callee returns the callee's values instead of
# its own. the shapes cover linear recursion with an array local, mutual recursion
# between two frame layouts, binary recursion where two sibling calls run against
# one frame, tail-position recursion whose frame must survive the call anyway, and
# recursion that returns a record through a caller-supplied destination.

use corpus.lib.fold;

rec Acc { lo: u64; mid: u64; hi: u64; }

fun gen(s: u64, k: u64) u64 {
    ret k * 6364136223846793005 + 1442695040888963407 + s;
}

fun descend(depth: u64, v: u64, h: u64) u64 {
    var local: [8]u64;
    var i: u64 = 0;
    for (i < 8) {
        local[i] = v * (i + 1) + depth;
        i = i + 1;
    }
    val guard: u64 = v ^ depth;

    var a: u64 = h;
    if (depth > 0) {
        a = descend(depth - 1, v * 3 + 1, a);
    }

    i = 0;
    for (i < 8) {
        a = fold.mix_u64(a, local[i]);
        i = i + 1;
    }
    a = fold.mix_u64(a, guard);
    ret fold.mix_u64(a, depth);
}

fun ping(depth: u64, v: u64, h: u64) u64 {
    var quad: [4]u64;
    var i: u64 = 0;
    for (i < 4) {
        quad[i] = v + i * 7 + depth;
        i = i + 1;
    }

    var a: u64 = h;
    if (depth > 0) {
        a = pong(depth - 1, v ^ 305419896, a);
    }

    i = 0;
    for (i < 4) {
        a = fold.mix_u64(a, quad[i]);
        i = i + 1;
    }
    ret fold.mix_u64(a, depth * 2);
}

fun pong(depth: u64, v: u64, h: u64) u64 {
    var six: [6]u64;
    var i: u64 = 0;
    for (i < 6) {
        six[i] = v * (i + 3) - depth;
        i = i + 1;
    }
    val mark: u64 = ~v;

    var a: u64 = h;
    if (depth > 0) {
        a = ping(depth - 1, v + 11, a);
    }

    i = 0;
    for (i < 6) {
        a = fold.mix_u64(a, six[i]);
        i = i + 1;
    }
    a = fold.mix_u64(a, mark);
    ret fold.mix_u64(a, depth * 3 + 1);
}

# two sibling calls in one frame: the second must see the frame the first left
fun tree(depth: u64, v: u64, h: u64) u64 {
    val here: u64 = v * 2654435761 + depth;
    var a: u64 = fold.mix_u64(h, here);
    if (depth > 0) {
        a = tree(depth - 1, here + 1, a);
        a = fold.mix_u64(a, here);
        a = tree(depth - 1, here ^ 2863311530, a);
    }
    ret fold.mix_u64(a, here);
}

# the recursive call is the last statement, but the frame still owns an array the
# fold below reads, so the call cannot become a jump into this frame
fun tail(depth: u64, v: u64, h: u64) u64 {
    var buf: [4]u64;
    var i: u64 = 0;
    for (i < 4) {
        buf[i] = v ^ (i * 1099511628211 + depth);
        i = i + 1;
    }
    var a: u64 = h;
    i = 0;
    for (i < 4) {
        a = fold.mix_u64(a, buf[i]);
        i = i + 1;
    }
    if (depth == 0) {
        ret a;
    }
    ret tail(depth - 1, v * 5 + 3, a);
}

# recursion whose result comes back through a caller-supplied destination
fun gather(depth: u64, v: u64) Acc {
    var here: Acc;
    here.lo = v + depth;
    here.mid = v * 3 + depth;
    here.hi = ~v ^ depth;
    if (depth == 0) {
        ret here;
    }
    val below: Acc = gather(depth - 1, v * 7 + 1);
    ret Acc{ lo: here.lo ^ below.hi, mid: here.mid + below.mid, hi: here.hi ^ below.lo };
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();

    var v: [6]u64;
    var i: u64 = 0;
    for (i < 6) {
        v[i] = gen(seed, i);
        i = i + 1;
    }

    h = descend(40 + seed, v[0], h);
    h = ping(33 + seed, v[1], h);
    h = pong(33 + seed, v[2], h);
    h = tree(8, v[3] + seed, h);
    h = tail(48 + seed, v[4], h);

    var k: u64 = 0;
    for (k < 4) {
        val g: Acc = gather(24 + seed, v[k] + seed);
        h = fold.mix_u64(h, g.lo);
        h = fold.mix_u64(h, g.mid);
        h = fold.mix_u64(h, g.hi);
        k = k + 1;
    }

    ret h;
}
