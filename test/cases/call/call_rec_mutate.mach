# a callee writes to its own by-value record parameter, and the caller's object must
# be unchanged (mach #3416). the caller owns the copy on every ABI, as C does, so the
# callee works in the memory it was handed; that is only safe because the memory is
# already a copy the caller made. each size covers a different carrier class: M8 and
# M16 arrive in registers, M24 and M64 by reference or in the outgoing stack area,
# and MA16 is over-aligned. every callee overwrites every field, folds what it wrote,
# and the caller folds its own object afterwards, so a callee writing through to the
# caller's storage changes the checksum instead of passing silently.

use corpus.lib.fold;

rec M8 { a: u32; b: u32; }
rec M16 { a: u64; b: u64; }
rec M24 { a: u64; b: u64; c: u64; }
rec M64 { a: u64; b: u64; c: u64; d: u64; e: u64; f: u64; g: u64; h: u64; }

#[align(16)]
rec MA16 { a: u8; b: u8; }

fun gen(s: u64, k: u64) u64 {
    ret k * 6364136223846793005 + 1442695040888963407 + s;
}

fun fold8(h: u64, r: M8) u64 {
    var a: u64 = fold.mix_u32(h, r.a);
    ret fold.mix_u32(a, r.b);
}

fun fold16(h: u64, r: M16) u64 {
    var a: u64 = fold.mix_u64(h, r.a);
    ret fold.mix_u64(a, r.b);
}

fun fold24(h: u64, r: M24) u64 {
    var a: u64 = fold.mix_u64(h, r.a);
    a = fold.mix_u64(a, r.b);
    ret fold.mix_u64(a, r.c);
}

fun fold64(h: u64, r: M64) u64 {
    var a: u64 = fold.mix_u64(h, r.a);
    a = fold.mix_u64(a, r.b);
    a = fold.mix_u64(a, r.c);
    a = fold.mix_u64(a, r.d);
    a = fold.mix_u64(a, r.e);
    a = fold.mix_u64(a, r.f);
    a = fold.mix_u64(a, r.g);
    ret fold.mix_u64(a, r.h);
}

fun folda(h: u64, r: MA16) u64 {
    var a: u64 = fold.mix_u8(h, r.a);
    ret fold.mix_u8(a, r.b);
}

fun clobber8(v: M8, k: u64) u64 {
    var r: M8 = v;
    r.a = k::u32;
    r.b = (k >> 32)::u32;
    ret fold8(fold8(fold.init(), v), r);
}

fun clobber16(v: M16, k: u64) u64 {
    v.a = k;
    v.b = ~k;
    ret fold16(fold.init(), v);
}

fun clobber24(v: M24, k: u64) u64 {
    v.a = k;
    v.b = ~k;
    v.c = k ^ 0x5555555555555555;
    ret fold24(fold.init(), v);
}

fun clobber64(v: M64, k: u64) u64 {
    v.a = k;
    v.b = ~k;
    v.c = k + 3;
    v.d = k * 7;
    v.e = k ^ 0x0F0F0F0F0F0F0F0F;
    v.f = k - 11;
    v.g = k >> 3;
    v.h = k << 5;
    ret fold64(fold.init(), v);
}

fun clobbera(v: MA16, k: u64) u64 {
    v.a = k::u8;
    v.b = (k >> 8)::u8;
    ret folda(fold.init(), v);
}

# a clobbering callee reached through a `fun` value: the compiler cannot see which
# body runs, so the caller's copy is the only thing that keeps the object intact
fun clobber16_indirect(v: M16, k: u64) u64 {
    v.a = k + 1;
    v.b = k + 2;
    ret fold16(fold.init(), v);
}

# the object is passed twice in one call, after a clobbering call has already run
fun twice64(x: M64, y: M64) u64 {
    ret fold64(fold64(fold.init(), x), y);
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    h = fold.mix_u64(h, $size_of(M8)::u64);
    h = fold.mix_u64(h, $size_of(M16)::u64);
    h = fold.mix_u64(h, $size_of(M24)::u64);
    h = fold.mix_u64(h, $size_of(M64)::u64);
    h = fold.mix_u64(h, $size_of(MA16)::u64);
    h = fold.mix_u64(h, $align_of(MA16)::u64);

    var v: [8]u64;
    var i: u64 = 0;
    for (i < 8) {
        v[i] = gen(seed, i);
        i = i + 1;
    }

    var r8: M8 = M8{ a: v[0]::u32, b: v[1]::u32 };
    var r16: M16 = M16{ a: v[2], b: v[3] };
    var r24: M24 = M24{ a: v[4], b: v[5], c: v[6] };
    var r64: M64 = M64{ a: v[0], b: v[1], c: v[2], d: v[3],
                        e: v[4], f: v[5], g: v[6], h: v[7] };
    var ra: MA16 = MA16{ a: v[7]::u8, b: (v[7] >> 8)::u8 };

    var pass: u64 = 0;
    for (pass < 3) {
        val k: u64 = gen(seed, pass + 17);

        h = fold.mix_u64(h, clobber8(r8, k));
        h = fold8(h, r8);

        h = fold.mix_u64(h, clobber16(r16, k));
        h = fold16(h, r16);

        h = fold.mix_u64(h, clobber24(r24, k));
        h = fold24(h, r24);

        h = fold.mix_u64(h, clobber64(r64, k));
        h = fold64(h, r64);

        h = fold.mix_u64(h, clobbera(ra, k));
        h = folda(h, ra);

        val f: fun(M16, u64) u64 = clobber16_indirect;
        h = fold.mix_u64(h, f(r16, k));
        h = fold16(h, r16);

        h = fold.mix_u64(h, twice64(r64, r64));
        h = fold64(h, r64);

        pass = pass + 1;
    }

    ret h;
}
