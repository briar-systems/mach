# calls through function values. the callee is chosen by a runtime index the
# optimizer cannot pin, so every one of these is a real indirect call: through a
# table, through a variable reassigned in a loop, through a parameter, and through a
# value returned by another call. the indirect callees cover the argument and return
# shapes that differ from a plain scalar call, so an indirect path that builds its
# arguments differently from the direct path disagrees here.

use corpus.lib.fold;

rec B24 { a: u64; b: u64; c: u64; }

def BinOp: fun(u64, u64) u64;
def RecOp: fun(B24) u64;
def MakeOp: fun(u64) B24;

fun gen(s: u64, k: u64) u64 {
    ret k * 6364136223846793005 + 1442695040888963407 + s;
}

fun op_add(a: u64, b: u64) u64 { ret a + b; }
fun op_sub(a: u64, b: u64) u64 { ret a - b; }
fun op_mul(a: u64, b: u64) u64 { ret a * b; }
fun op_xor(a: u64, b: u64) u64 { ret a ^ (b * 3); }

fun op_rot(a: u64, b: u64) u64 {
    val r: u64 = (b & 63) | 1;
    ret (a << r) | (a >> (64 - r));
}

fun op_mix(a: u64, b: u64) u64 {
    var x: u64 = a ^ (b >> 7);
    x = x * 1099511628211;
    ret x ^ (x >> 31);
}

fun fold24(h: u64, r: B24) u64 {
    var a: u64 = fold.mix_u64(h, r.a);
    a = fold.mix_u64(a, r.b);
    ret fold.mix_u64(a, r.c);
}

fun sum24(r: B24) u64 { ret r.a + r.b * 3 + r.c; }
fun xor24(r: B24) u64 { ret r.a ^ r.b ^ (r.c * 5); }

fun mk_lin(v: u64) B24 { ret B24{ a: v, b: v + 1, c: v + 2 }; }
fun mk_pow(v: u64) B24 { ret B24{ a: v, b: v * v, c: ~v }; }

# many arguments reached indirectly: the outgoing area must be built exactly as the
# direct path builds it
fun wide(a0: u64, a1: u32, a2: f64, a3: u8, a4: f32, a5: u64, a6: i32,
         a7: f64, a8: u16, a9: u64, a10: f32, a11: u64) u64 {
    var h: u64 = fold.init();
    h = fold.mix_u64(h, a0);
    h = fold.mix_u32(h, a1);
    h = fold.mix_f64(h, a2);
    h = fold.mix_u8(h, a3);
    h = fold.mix_f32(h, a4);
    h = fold.mix_u64(h, a5);
    h = fold.mix_i32(h, a6);
    h = fold.mix_f64(h, a7);
    h = fold.mix_u16(h, a8);
    h = fold.mix_u64(h, a9);
    h = fold.mix_f32(h, a10);
    ret fold.mix_u64(h, a11);
}

fun apply(f: BinOp, a: u64, b: u64) u64 { ret f(a, b); }

fun apply_twice(f: BinOp, a: u64, b: u64) u64 { ret f(f(a, b), b); }

# a function value chosen and returned by another call
fun pick(k: u64) BinOp {
    if (k == 0) { ret op_add; }
    or (k == 1) { ret op_sub; }
    or (k == 2) { ret op_mul; }
    or (k == 3) { ret op_xor; }
    or (k == 4) { ret op_rot; }
    ret op_mix;
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();

    var v: [12]u64;
    var i: u64 = 0;
    for (i < 12) {
        v[i] = gen(seed, i);
        i = i + 1;
    }

    var tbl: [6]BinOp;
    tbl[0] = op_add;
    tbl[1] = op_sub;
    tbl[2] = op_mul;
    tbl[3] = op_xor;
    tbl[4] = op_rot;
    tbl[5] = op_mix;

    var rt: [2]RecOp;
    rt[0] = sum24;
    rt[1] = xor24;

    var mt: [2]MakeOp;
    mt[0] = mk_lin;
    mt[1] = mk_pow;

    var acc: u64 = seed + 1;
    var k: u64 = 0;
    for (k < 12) {
        val idx: u64 = (v[k] + seed) % 6;
        acc = tbl[idx](acc, v[k]);
        h = fold.mix_u64(h, acc);
        h = fold.mix_u64(h, apply(tbl[idx], acc, v[k]));
        h = fold.mix_u64(h, apply_twice(tbl[(idx + 1) % 6], acc, v[k]));
        h = fold.mix_u64(h, pick((v[k] + seed) % 6)(acc, v[k]));
        k = k + 1;
    }

    # a function value held in a variable across a call, then used
    var f: BinOp = tbl[(v[0] + seed) % 6];
    k = 0;
    for (k < 8) {
        val g: BinOp = tbl[(v[k] + seed + k) % 6];
        acc = f(acc, g(acc, v[k]));
        h = fold.mix_u64(h, acc);
        f = g;
        k = k + 1;
    }

    # indirect calls that take and return records
    k = 0;
    for (k < 8) {
        val mi: u64 = (v[k] + seed) % 2;
        val ri: u64 = (v[k] + seed + 1) % 2;
        val r: B24 = mt[mi](v[k] + acc);
        h = fold24(h, r);
        h = fold.mix_u64(h, rt[ri](r));
        h = fold.mix_u64(h, rt[ri](mt[mi](v[k])));
        k = k + 1;
    }

    # a wide signature reached indirectly and directly, folded both ways
    var w: fun(u64, u32, f64, u8, f32, u64, i32, f64, u16, u64, f32, u64) u64 = wide;
    k = 0;
    for (k < 4) {
        val d: u64 = v[k] + seed;
        h = fold.mix_u64(h, w(d, d::u32, (d & 4095)::f64 / 8.0, d::u8,
                              (d & 255)::f32, d * 3, d::u32:~i32,
                              (d & 65535)::f64 / 64.0, d::u16, ~d,
                              (d & 1023)::f32 - 512.0, d ^ acc));
        h = fold.mix_u64(h, wide(d, d::u32, (d & 4095)::f64 / 8.0, d::u8,
                                 (d & 255)::f32, d * 3, d::u32:~i32,
                                 (d & 65535)::f64 / 64.0, d::u16, ~d,
                                 (d & 1023)::f32 - 512.0, d ^ acc));
        k = k + 1;
    }

    ret h;
}
