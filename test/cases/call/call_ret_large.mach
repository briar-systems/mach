# record returns too large for registers, so every one comes back through a caller
# supplied destination. the destinations are the shapes that break a naive
# implementation: a plain local, an element of an array, a field of an enclosing
# record, the argument area of an outer call, and the very variable that was also
# passed in by value, which must be read as a copy before the destination is
# written.

use corpus.lib.fold;

rec N16 { a: u64; b: u64; }
rec B20 { a: u32; b: u32; c: u32; d: u32; e: u32; }
rec B24 { a: u64; b: u64; c: u64; }
rec B24f { x: f64; y: f64; z: f64; }
rec B32 { a: u64; b: u64; c: u64; d: u64; }
rec B40m { a: u64; x: f64; b: u32; c: u32; y: f64; d: u64; }
rec B48 { a: u64; b: u64; c: u64; d: u64; e: u64; f: u64; }
rec Nest { lead: u32; big: B24; tail: N16; }

fun gen(s: u64, k: u64) u64 {
    ret k * 6364136223846793005 + 1442695040888963407 + s;
}

fun fold20(h: u64, r: B20) u64 {
    var a: u64 = fold.mix_u32(h, r.a);
    a = fold.mix_u32(a, r.b);
    a = fold.mix_u32(a, r.c);
    a = fold.mix_u32(a, r.d);
    ret fold.mix_u32(a, r.e);
}

fun fold24(h: u64, r: B24) u64 {
    var a: u64 = fold.mix_u64(h, r.a);
    a = fold.mix_u64(a, r.b);
    ret fold.mix_u64(a, r.c);
}

fun fold24f(h: u64, r: B24f) u64 {
    var a: u64 = fold.mix_f64(h, r.x);
    a = fold.mix_f64(a, r.y);
    ret fold.mix_f64(a, r.z);
}

fun fold32(h: u64, r: B32) u64 {
    var a: u64 = fold.mix_u64(h, r.a);
    a = fold.mix_u64(a, r.b);
    a = fold.mix_u64(a, r.c);
    ret fold.mix_u64(a, r.d);
}

fun fold40m(h: u64, r: B40m) u64 {
    var a: u64 = fold.mix_u64(h, r.a);
    a = fold.mix_f64(a, r.x);
    a = fold.mix_u32(a, r.b);
    a = fold.mix_u32(a, r.c);
    a = fold.mix_f64(a, r.y);
    ret fold.mix_u64(a, r.d);
}

fun fold48(h: u64, r: B48) u64 {
    var a: u64 = fold.mix_u64(h, r.a);
    a = fold.mix_u64(a, r.b);
    a = fold.mix_u64(a, r.c);
    a = fold.mix_u64(a, r.d);
    a = fold.mix_u64(a, r.e);
    ret fold.mix_u64(a, r.f);
}

fun fold_nest(h: u64, r: Nest) u64 {
    var a: u64 = fold.mix_u32(h, r.lead);
    a = fold24(a, r.big);
    a = fold.mix_u64(a, r.tail.a);
    ret fold.mix_u64(a, r.tail.b);
}

fun layout(h: u64) u64 {
    var a: u64 = fold.mix_u64(h, $size_of(B20)::u64);
    a = fold.mix_u64(a, $size_of(B24)::u64);
    a = fold.mix_u64(a, $size_of(B24f)::u64);
    a = fold.mix_u64(a, $size_of(B32)::u64);
    a = fold.mix_u64(a, $size_of(B40m)::u64);
    a = fold.mix_u64(a, $size_of(B48)::u64);
    a = fold.mix_u64(a, $size_of(Nest)::u64);
    a = fold.mix_u64(a, $offset_of(Nest, big)::u64);
    a = fold.mix_u64(a, $offset_of(Nest, tail)::u64);
    ret a;
}

fun mk20(v: u64) B20 {
    ret B20{ a: v::u32, b: (v >> 8)::u32, c: (v >> 16)::u32,
             d: (v >> 24)::u32, e: (v >> 32)::u32 };
}

fun mk24(v: u64) B24 { ret B24{ a: v, b: ~v, c: v * 3 + 1 }; }

fun mk24f(v: u64) B24f {
    ret B24f{ x: (v & 65535)::f64 / 8.0,
              y: (v & 4095)::f64 - 2048.0,
              z: (v & 262143)::f64 / 64.0 };
}

fun mk32(v: u64) B32 { ret B32{ a: v, b: v + 1, c: v * 5, d: ~v }; }

fun mk40m(v: u64) B40m {
    ret B40m{ a: v, x: (v & 8191)::f64 / 2.0, b: v::u32, c: (v >> 16)::u32,
              y: (v & 131071)::f64 / 32.0, d: v * 7 };
}

fun mk48(v: u64) B48 {
    ret B48{ a: v, b: v + 1, c: v + 2, d: v * 9, e: ~v, f: v ^ 2863311530 };
}

# takes a large record by value and returns another: the destination and the
# incoming copy are both memory, so a caller that reuses one area for both loses
fun bump24(r: B24, d: u64) B24 {
    ret B24{ a: r.a + d, b: r.b ^ d, c: r.c + r.a };
}

fun bump48(r: B48, d: u64) B48 {
    ret B48{ a: r.a + d, b: r.b ^ d, c: r.c + r.a, d: r.d + r.b,
             e: r.e ^ r.c, f: r.f + d };
}

fun widen(r: B24) B48 {
    ret B48{ a: r.a, b: r.b, c: r.c, d: r.a ^ r.b, e: r.b ^ r.c, f: r.c ^ r.a };
}

fun narrow(r: B48) B24 {
    ret B24{ a: r.a ^ r.d, b: r.b ^ r.e, c: r.c ^ r.f };
}

fun nest_of(v: u64) Nest {
    ret Nest{ lead: v::u32, big: mk24(v), tail: N16{ a: v * 11, b: ~v } };
}

fun take_two(p: B48, q: B24, x: u64) u64 {
    var h: u64 = fold.init();
    h = fold48(h, p);
    h = fold24(h, q);
    ret fold.mix_u64(h, x);
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = layout(fold.init());

    var v: [8]u64;
    var i: u64 = 0;
    for (i < 8) {
        v[i] = gen(seed, i);
        i = i + 1;
    }

    var k: u64 = 0;
    for (k < 8) {
        val w: u64 = v[k] + seed;
        h = fold20(h, mk20(w));
        h = fold24(h, mk24(w));
        h = fold24f(h, mk24f(w));
        h = fold32(h, mk32(w));
        h = fold40m(h, mk40m(w));
        h = fold48(h, mk48(w));
        h = fold_nest(h, nest_of(w));
        k = k + 1;
    }

    # the destination is the same variable the argument copy is taken from
    var acc: B24 = mk24(seed + 1);
    k = 0;
    for (k < 8) {
        acc = bump24(acc, v[k]);
        h = fold24(h, acc);
        k = k + 1;
    }

    var big: B48 = mk48(seed + 2);
    k = 0;
    for (k < 8) {
        big = bump48(big, v[k]);
        h = fold48(h, big);
        k = k + 1;
    }

    # the destination is an array element, then a field of an enclosing record
    var arr: [6]B32;
    k = 0;
    for (k < 6) {
        arr[k] = mk32(v[k] + seed);
        k = k + 1;
    }
    k = 0;
    for (k < 6) {
        h = fold32(h, arr[k]);
        k = k + 1;
    }

    var n: Nest;
    n.lead = 305419896;
    n.big = bump24(mk24(seed + 3), v[0]);
    n.tail = N16{ a: v[1], b: v[2] };
    h = fold_nest(h, n);

    # a returned record straight into another call's argument area, both directions
    k = 0;
    for (k < 4) {
        val w: u64 = v[k] + seed;
        h = fold.mix_u64(h, take_two(widen(mk24(w)), narrow(mk48(w)), w));
        h = fold48(h, widen(narrow(mk48(w))));
        h = fold24(h, narrow(widen(mk24(w))));
        h = fold24(h, bump24(narrow(bump48(mk48(w), w)), w));
        k = k + 1;
    }

    ret h;
}
