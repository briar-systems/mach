# variadic packs, which mach monomorphizes per call-site type-list rather than
# passing at run time, so each call below is an ordinary call to its own instance
# and the codegen question is whether that instance's signature is built from the
# element types in order. the instantiations cover an empty pack, a homogeneous one
# long enough to spill past the argument registers, heterogeneous integer and float
# element lists, leading fixed parameters, one and two levels of `va...` forwarding,
# and a runtime accumulator threaded across the unrolled body.

use corpus.lib.fold;

fun gen(s: u64, k: u64) u64 {
    ret k * 6364136223846793005 + 1442695040888963407 + s;
}

fun fold_pack(h: u64, va: ...) u64 {
    var a: u64 = h;
    $each x in va {
        $if ($type_of(x) == f32) { a = fold.mix_f32(a, x); }
        $or ($type_of(x) == f64) { a = fold.mix_f64(a, x); }
        $or { a = fold.mix_u64(a, x::u64); }
    }
    ret fold.mix_u64(a, va.len::u64);
}

fun bias_pack(h: u64, base: u64, va: ...) u64 {
    var a: u64 = fold.mix_u64(h, base);
    $each x in va {
        $if ($type_of(x) == f32) { a = fold.mix_f32(a, x); }
        $or ($type_of(x) == f64) { a = fold.mix_f64(a, x); }
        $or { a = fold.mix_u64(a, x::u64 + base); }
    }
    ret fold.mix_u64(a, va.len::u64);
}

fun fwd_pack(h: u64, va: ...) u64 { ret fold_pack(h, va...); }

fun fwd2_pack(h: u64, va: ...) u64 { ret fwd_pack(h, va...); }

fun fwd_bias(h: u64, base: u64, va: ...) u64 { ret bias_pack(h, base * 3, va...); }

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();

    var v: [12]u64;
    var i: u64 = 0;
    for (i < 12) {
        v[i] = gen(seed, i);
        i = i + 1;
    }

    # an empty pack: the instance has no elements and the body never runs
    h = fold_pack(h);
    h = fwd_pack(h);
    h = fwd2_pack(h);

    var k: u64 = 0;
    for (k < 4) {
        val d: u64 = v[k] + seed;

        # every element is a typed local, so the instance's type-list is the one
        # written here rather than one a literal's default width decided
        val e8: u8 = d::u8;
        val e16: i16 = d::u16:~i16;
        val e32: u32 = d::u32;
        val e64: i64 = d:~i64;
        val g8: u8 = (d >> 7)::u8;
        val g16: u16 = (d >> 3)::u16;
        val g32: i32 = (d >> 11)::u32:~i32;
        val p32: f32 = (d & 4095)::f32 / 8.0;
        val q32: f32 = (d & 255)::f32 - 128.0;
        val r32: f32 = (d & 1023)::f32 / 4.0;
        val s32: f32 = (d & 511)::f32 / 2.0;
        val p64: f64 = (d & 65535)::f64 / 64.0;
        val q64: f64 = (d & 262143)::f64 / 256.0;
        val r64: f64 = (d & 8191)::f64 / 2.0;

        # a heterogeneous integer list: each element carries its own width and
        # signedness into the instance signature
        h = fold_pack(h, e8, e16, e32, e64, g8, g16, g32, d * 3);

        # homogeneous and long enough to put a tail in stack slots
        h = fold_pack(h, v[0] + d, v[1], v[2], v[3], v[4], v[5], v[6], v[7],
                      v[8], v[9], v[10], v[11]);

        # a float list, folded by bit pattern
        h = fold_pack(h, p32, p64, q32, q64);

        # int and float interleaved: neither bank can be assigned by position
        h = fold_pack(h, d, p32, e32, p64, e16, d * 5);

        # leading fixed parameters ahead of the pack
        h = bias_pack(h, d, e8, e32, d * 7, g16);
        h = bias_pack(h, d, r32, d, r64);

        # forwarded once, twice, and into a callee with its own fixed parameter
        h = fwd_pack(h, e8, e16, e32, e64);
        h = fwd2_pack(h, e8, e16, e32, e64);
        h = fwd2_pack(h, d, p32, p64);
        h = fwd_bias(h, d, e8, e32, d * 7, g16);

        # a single-element pack, and one whose only element is a float
        h = fold_pack(h, d);
        h = fold_pack(h, s32);

        k = k + 1;
    }

    ret h;
}
