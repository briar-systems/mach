# integer, float and vector arguments interleaved in one signature, so neither bank
# can be assigned by counting positions. twenty arguments overflow both banks on
# every ABI, and the three vectors sit at different widths (12, 16 and 8 bytes) so a
# lowering that assigns a vector out of the wrong bank, or lets one consume an
# integer register it should not, moves every argument after it.

use corpus.lib.fold;

fun gen(s: u64, k: u64) u64 {
    ret k * 6364136223846793005 + 1442695040888963407 + s;
}

fun as_f32(v: u64) f32 {
    ret ((v & 4095)::f32 - 2048.0) / 8.0;
}

fun as_f64(v: u64) f64 {
    ret ((v & 1048575)::f64 - 524288.0) / 64.0;
}

fun mixed(a0: u64, x0: f32, a1: u32, y0: f64, v0: f32x3,
          a2: i64, x1: f32, a3: u16, v1: f32x4, y1: f64,
          a4: u64, x2: f32, a5: u8, y2: f64, v2: f32x2,
          a6: u64, x3: f32, a7: i32, y3: f64, a8: u64) u64 {
    var h: u64 = fold.init();
    h = fold.mix_u64(h, a0);
    h = fold.mix_f32(h, x0);
    h = fold.mix_u32(h, a1);
    h = fold.mix_f64(h, y0);
    h = fold.mix_f32(h, v0[0]);
    h = fold.mix_f32(h, v0[1]);
    h = fold.mix_f32(h, v0[2]);
    h = fold.mix_i64(h, a2);
    h = fold.mix_f32(h, x1);
    h = fold.mix_u16(h, a3);
    h = fold.mix_f32(h, v1[0]);
    h = fold.mix_f32(h, v1[1]);
    h = fold.mix_f32(h, v1[2]);
    h = fold.mix_f32(h, v1[3]);
    h = fold.mix_f64(h, y1);
    h = fold.mix_u64(h, a4);
    h = fold.mix_f32(h, x2);
    h = fold.mix_u8(h, a5);
    h = fold.mix_f64(h, y2);
    h = fold.mix_f32(h, v2[0]);
    h = fold.mix_f32(h, v2[1]);
    h = fold.mix_u64(h, a6);
    h = fold.mix_f32(h, x3);
    h = fold.mix_i32(h, a7);
    h = fold.mix_f64(h, y3);
    h = fold.mix_u64(h, a8);

    # cross-bank combinations, so a value delivered to the right bank at the wrong
    # index is caught even when both arguments were folded individually
    h = fold.mix_u64(h, a0 + a4 * a6 - a8);
    h = fold.mix_f32(h, x0 + x1 * x2 - x3);
    h = fold.mix_f64(h, y0 + y1 * y2 - y3);
    val w: f32x3 = v0 + f32x3{v1[0], v1[1], v2[0]};
    h = fold.mix_f32(h, w[0]);
    h = fold.mix_f32(h, w[1]);
    h = fold.mix_f32(h, w[2]);
    ret h;
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();

    var v: [24]u64;
    var i: u64 = 0;
    for (i < 24) {
        v[i] = gen(seed, i);
        i = i + 1;
    }

    var r: u64 = 0;
    var pass: u64 = 0;
    for (pass < 3) {
        val d: u64 = pass * 11 + seed;

        val q0: f32x3 = f32x3{as_f32(v[16]), as_f32(v[17]), as_f32(v[18])};
        val q1: f32x4 = f32x4{as_f32(v[19]), as_f32(v[20]), as_f32(v[21]), as_f32(v[22])};
        val q2: f32x2 = f32x2{as_f32(v[23]), as_f32(v[0] + d)};

        r = mixed(v[0] + d, as_f32(v[1]), v[2]::u32, as_f64(v[3]), q0,
                  v[4]:~i64, as_f32(v[5]), v[6]::u16, q1, as_f64(v[7]),
                  v[8], as_f32(v[9]), v[10]::u8, as_f64(v[11]), q2,
                  v[12], as_f32(v[13]), v[14]::u32:~i32, as_f64(v[15]), v[1] + d);
        h = fold.mix_u64(h, r);

        pass = pass + 1;
    }

    # the outer call's arguments are built while an inner call owns both banks
    val e0: f32x3 = f32x3{as_f32(r), as_f32(v[2]), as_f32(v[3])};
    val e1: f32x4 = f32x4{as_f32(v[4]), as_f32(v[5]), as_f32(v[6]), as_f32(v[7])};
    val e2: f32x2 = f32x2{as_f32(v[8]), as_f32(v[9])};
    h = fold.mix_u64(h, mixed(
        mixed(v[0], as_f32(v[1]), v[2]::u32, as_f64(v[3]), e0,
              v[4]:~i64, as_f32(v[5]), v[6]::u16, e1, as_f64(v[7]),
              v[8], as_f32(v[9]), v[10]::u8, as_f64(v[11]), e2,
              v[12], as_f32(v[13]), v[14]::u32:~i32, as_f64(v[15]), v[1]),
        as_f32(v[3]), v[5]::u32, as_f64(v[7]), e0,
        v[9]:~i64, as_f32(v[11]), v[13]::u16, e1, as_f64(v[15]),
        v[17], as_f32(v[19]), v[21]::u8, as_f64(v[23]), e2,
        v[2], as_f32(v[4]), v[6]::u32:~i32, as_f64(v[8]), r));

    ret h;
}
