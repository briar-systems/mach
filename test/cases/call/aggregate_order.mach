# an aggregate value is captured where it is evaluated: a by-value argument
# before a later argument's call writes its source, read from a local, a global,
# a field, an element, an array and a union; the right side of an assignment
# before a call in its destination writes it; and a returned value before the
# function's `fin` writes it. `order` records the evaluation order of the calls
# that observe and write, and every value the callee or caller ends with folds

use corpus.lib.fold;

rec Pair    { first: i64; second: i64; }
rec Nested  { item: Pair; }
uni Overlay { item: Pair; bytes: [16]u8; }

var global_pair: Pair;

fun take_pair(item: Pair, effect: i64) i64 {
    ret item.first + item.second + effect;
}

fun take_array(item: [3]i64, effect: i64) i64 {
    ret item[0] + item[1] + item[2] + effect;
}

fun take_overlay(item: Overlay, effect: i64) i64 {
    ret item.item.first + item.item.second + effect;
}

fun mutate(item: *Pair) i64 {
    item.first  = 99;
    item.second = 100;
    ret 0;
}

fun mutate_array(item: *[3]i64) i64 {
    @item = [3]i64{99, 100, 101};
    ret 0;
}

fun observe(item: *Pair, order: *i64) *Pair {
    @order = @order * 10 + 1;
    ret item;
}

fun mutate_ordered(item: *Pair, order: *i64) i64 {
    @order = @order * 10 + 2;
    ret mutate(item);
}

fun destination(out: *Pair, source: *Pair, order: *i64) *Pair {
    mutate_ordered(source, order);
    ret out;
}

fun return_before_cleanup(item: *Pair) Pair {
    fin { mutate(item); }
    ret @item;
}

fun fold_pair(h: u64, p: Pair) u64 {
    ret fold.mix_i64(fold.mix_i64(h, p.first), p.second);
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: i64 = seed:~i64;

    var item:   Pair = Pair{first: 7 + s, second: 8};
    var order:  i64  = s;
    val actual: i64  = take_pair(@observe(?item, ?order), mutate_ordered(?item, ?order));
    h = fold.mix_i64(h, order);
    h = fold_pair(h, item);
    h = fold.mix_i64(h, actual);

    var local:     Pair = Pair{first: 7 + s, second: 8};
    val local_sum: i64  = take_pair(local, mutate(?local));
    h           = fold.mix_i64(h, local_sum);
    h           = fold_pair(h, local);
    global_pair = Pair{first: 7 + s, second: 8};
    val global_sum: i64 = take_pair(global_pair, mutate(?global_pair));
    h = fold.mix_i64(h, global_sum);
    h = fold_pair(h, global_pair);

    var outer: Nested = Nested{item: Pair{first: 7 + s, second: 8}};
    val field: i64    = take_pair(outer.item, mutate(?outer.item));
    h = fold.mix_i64(h, field);
    h = fold_pair(h, outer.item);
    var items:   [1]Pair = [1]Pair{Pair{first: 7 + s, second: 8}};
    val indexed: i64     = take_pair(items[0], mutate(?items[0]));
    h = fold.mix_i64(h, indexed);
    h = fold_pair(h, items[0]);

    var arr:       [3]i64 = [3]i64{7 + s, 8, 9};
    val array_sum: i64    = take_array(arr, mutate_array(?arr));
    h = fold.mix_i64(h, array_sum);
    h = fold.mix_i64(h, arr[0]);
    h = fold.mix_i64(h, arr[2]);
    var over:    Overlay = Overlay{item: Pair{first: 7 + s, second: 8}};
    val overlay: i64     = take_overlay(over, mutate(?over.item));
    h = fold.mix_i64(h, overlay);
    h = fold_pair(h, over.item);

    var source:  Pair = Pair{first: 7 + s, second: 8};
    var out:     Pair;
    var order_2: i64  = s;
    @destination(?out, ?source, ?order_2) = @observe(?source, ?order_2);
    h                                     = fold.mix_i64(h, order_2);
    h                                     = fold_pair(h, source);
    h                                     = fold_pair(h, out);

    var held:   Pair = Pair{first: 7 + s, second: 8};
    val result: Pair = return_before_cleanup(?held);
    h = fold_pair(h, held);
    h = fold_pair(h, result);
    ret h;
}
