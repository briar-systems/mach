# record arguments at 24, 32 and 48 bytes: past every ABI's register threshold, so
# each one is a caller-built copy the callee reads through a pointer. the three
# 24-byte records differ only in field types, which is what separates aarch64's
# homogeneous-float aggregate rule from a plain memory argument, and the nested and
# mixed shapes make the callee's view of the copy depend on field offsets rather
# than on size alone.

use corpus.lib.fold;

rec N16 { a: u64; b: u64; }
rec L24 { a: u64; b: u64; c: u64; }
rec L24f { x: f64; y: f64; z: f64; }
rec L24m { a: u64; x: f64; b: u32; c: u32; }
rec L32 { a: u64; b: u64; c: u64; d: u64; }
rec L32n { lo: N16; hi: N16; }
rec L48 { a: u64; b: u64; c: u64; d: u64; e: u64; f: u64; }
rec L48m { a: u64; x: f64; b: u32; c: u32; y: f64; d: u64; e: u64; }

fun gen(s: u64, k: u64) u64 {
    ret k * 6364136223846793005 + 1442695040888963407 + s;
}

fun fold_l24(h: u64, r: L24) u64 {
    var a: u64 = fold.mix_u64(h, r.a);
    a = fold.mix_u64(a, r.b);
    ret fold.mix_u64(a, r.c);
}

fun fold_l24f(h: u64, r: L24f) u64 {
    var a: u64 = fold.mix_f64(h, r.x);
    a = fold.mix_f64(a, r.y);
    ret fold.mix_f64(a, r.z);
}

fun fold_l24m(h: u64, r: L24m) u64 {
    var a: u64 = fold.mix_u64(h, r.a);
    a = fold.mix_f64(a, r.x);
    a = fold.mix_u32(a, r.b);
    ret fold.mix_u32(a, r.c);
}

fun fold_l32(h: u64, r: L32) u64 {
    var a: u64 = fold.mix_u64(h, r.a);
    a = fold.mix_u64(a, r.b);
    a = fold.mix_u64(a, r.c);
    ret fold.mix_u64(a, r.d);
}

fun fold_l32n(h: u64, r: L32n) u64 {
    var a: u64 = fold.mix_u64(h, r.lo.a);
    a = fold.mix_u64(a, r.lo.b);
    a = fold.mix_u64(a, r.hi.a);
    ret fold.mix_u64(a, r.hi.b);
}

fun fold_l48(h: u64, r: L48) u64 {
    var a: u64 = fold.mix_u64(h, r.a);
    a = fold.mix_u64(a, r.b);
    a = fold.mix_u64(a, r.c);
    a = fold.mix_u64(a, r.d);
    a = fold.mix_u64(a, r.e);
    ret fold.mix_u64(a, r.f);
}

fun fold_l48m(h: u64, r: L48m) u64 {
    var a: u64 = fold.mix_u64(h, r.a);
    a = fold.mix_f64(a, r.x);
    a = fold.mix_u32(a, r.b);
    a = fold.mix_u32(a, r.c);
    a = fold.mix_f64(a, r.y);
    a = fold.mix_u64(a, r.d);
    ret fold.mix_u64(a, r.e);
}

fun layout(h: u64) u64 {
    var a: u64 = fold.mix_u64(h, $size_of(L24)::u64);
    a = fold.mix_u64(a, $size_of(L24f)::u64);
    a = fold.mix_u64(a, $size_of(L24m)::u64);
    a = fold.mix_u64(a, $size_of(L32)::u64);
    a = fold.mix_u64(a, $size_of(L32n)::u64);
    a = fold.mix_u64(a, $size_of(L48)::u64);
    a = fold.mix_u64(a, $size_of(L48m)::u64);
    a = fold.mix_u64(a, $align_of(L24)::u64);
    a = fold.mix_u64(a, $align_of(L24f)::u64);
    a = fold.mix_u64(a, $align_of(L48m)::u64);
    a = fold.mix_u64(a, $offset_of(L24, c)::u64);
    a = fold.mix_u64(a, $offset_of(L24m, b)::u64);
    a = fold.mix_u64(a, $offset_of(L24m, c)::u64);
    a = fold.mix_u64(a, $offset_of(L32n, hi)::u64);
    a = fold.mix_u64(a, $offset_of(L48, f)::u64);
    a = fold.mix_u64(a, $offset_of(L48m, y)::u64);
    a = fold.mix_u64(a, $offset_of(L48m, e)::u64);
    ret a;
}

fun take_large(p0: u64, l24: L24, l24f: L24f, l24m: L24m, p1: u32, l32: L32,
               l32n: L32n, x0: f64, l48: L48, l48m: L48m, t24: L24, t32: L32,
               t48: L48, x1: f32, p2: u64) u64 {
    var h: u64 = fold.init();
    h = fold.mix_u64(h, p0);
    h = fold_l24(h, l24);
    h = fold_l24f(h, l24f);
    h = fold_l24m(h, l24m);
    h = fold.mix_u32(h, p1);
    h = fold_l32(h, l32);
    h = fold_l32n(h, l32n);
    h = fold.mix_f64(h, x0);
    h = fold_l48(h, l48);
    h = fold_l48m(h, l48m);
    h = fold_l24(h, t24);
    h = fold_l32(h, t32);
    h = fold_l48(h, t48);
    h = fold.mix_f32(h, x1);
    h = fold.mix_u64(h, p2);

    # the callee's copy is its own: a caller that passed the address of its own
    # value instead of a copy would see these writes
    var c48: L48 = l48;
    c48.a = c48.a + 1;
    c48.f = c48.f ^ 4294967295;
    h = fold_l48(h, c48);
    h = fold_l48(h, l48);
    ret h;
}

fun mk24(v: u64) L24 { ret L24{ a: v, b: v * 3 + 1, c: v ^ 305419896 }; }

fun mk24f(v: u64) L24f {
    ret L24f{ x: (v & 65535)::f64 / 8.0,
              y: (v & 4095)::f64 - 2048.0,
              z: (v & 262143)::f64 / 64.0 };
}

fun mk24m(v: u64) L24m {
    ret L24m{ a: v, x: (v & 32767)::f64 / 4.0, b: v::u32, c: (v >> 32)::u32 };
}

fun mk32(v: u64) L32 { ret L32{ a: v, b: ~v, c: v * 5, d: v >> 3 }; }

fun mk32n(v: u64) L32n {
    ret L32n{ lo: N16{ a: v, b: v + 11 }, hi: N16{ a: v * 7, b: ~v } };
}

fun mk48(v: u64) L48 {
    ret L48{ a: v, b: v + 1, c: v + 2, d: v * 9, e: ~v, f: v ^ 2863311530 };
}

fun mk48m(v: u64) L48m {
    ret L48m{ a: v, x: (v & 8191)::f64 / 2.0, b: v::u32, c: (v >> 16)::u32,
              y: (v & 131071)::f64 / 32.0, d: v * 3, e: ~v };
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = layout(fold.init());

    var v: [12]u64;
    var i: u64 = 0;
    for (i < 12) {
        v[i] = gen(seed, i);
        i = i + 1;
    }

    var r: u64 = 0;
    var pass: u64 = 0;
    for (pass < 3) {
        val d: u64 = pass * 19 + seed;
        r = take_large(v[0] + d, mk24(v[1]), mk24f(v[2]), mk24m(v[3]), v[4]::u32,
                       mk32(v[5] + d), mk32n(v[6]), (v[7] & 1023)::f64,
                       mk48(v[8]), mk48m(v[9]), mk24(v[10]), mk32(v[11]),
                       mk48(v[0]), (v[1] & 255)::f32, v[2]);
        h = fold.mix_u64(h, r);
        pass = pass + 1;
    }

    h = fold.mix_u64(h, take_large(
        r, mk24(r), mk24f(r), mk24m(r), r::u32, mk32(r), mk32n(r),
        (r & 1023)::f64, mk48(r), mk48m(r), mk24(v[10]), mk32(v[11]),
        mk48(v[0]), (v[1] & 255)::f32, v[3]));

    ret h;
}
