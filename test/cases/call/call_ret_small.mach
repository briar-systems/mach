# record returns small enough to come back in registers. the ten shapes cover 1, 2,
# 4, 8, 12 and 16 bytes and, at 8 and 16, the same size in three field layouts, so a
# return classifier that reads size alone rather than field types brings the
# all-float pair back through the integer registers. every returned record is folded
# field by field, stored into an array so its stride is exercised, and fed straight
# back into a call as an argument so the return slot and the outgoing argument area
# overlap in the same statement.

use corpus.lib.fold;

rec S1 { a: u8; }
rec S2 { a: u16; }
rec S4 { a: u32; }
rec S8 { a: u32; b: u32; }
rec S8f { x: f32; y: f32; }
rec S12 { a: u32; b: u32; c: u32; }
rec S16 { a: u64; b: u64; }
rec S16f { x: f64; y: f64; }
rec S16m { a: u64; x: f64; }
rec S16n { x: f64; a: u64; }

fun gen(s: u64, k: u64) u64 {
    ret k * 6364136223846793005 + 1442695040888963407 + s;
}

fun ret1(v: u64) S1 { ret S1{ a: v::u8 }; }
fun ret2(v: u64) S2 { ret S2{ a: v::u16 }; }
fun ret4(v: u64) S4 { ret S4{ a: v::u32 }; }
fun ret8(v: u64) S8 { ret S8{ a: v::u32, b: (v >> 32)::u32 }; }

fun ret8f(v: u64) S8f {
    ret S8f{ x: (v & 4095)::f32 / 8.0, y: (v & 255)::f32 - 128.0 };
}

fun ret12(v: u64) S12 {
    ret S12{ a: v::u32, b: (v >> 16)::u32, c: (v >> 32)::u32 };
}

fun ret16(v: u64) S16 { ret S16{ a: v, b: ~v }; }

fun ret16f(v: u64) S16f {
    ret S16f{ x: (v & 65535)::f64 / 8.0, y: (v & 262143)::f64 / 64.0 };
}

fun ret16m(v: u64) S16m {
    ret S16m{ a: v * 3 + 1, x: (v & 32767)::f64 / 4.0 };
}

fun ret16n(v: u64) S16n {
    ret S16n{ x: (v & 8191)::f64 / 2.0, a: v ^ 305419896 };
}

fun fold8(h: u64, r: S8) u64 {
    var a: u64 = fold.mix_u32(h, r.a);
    ret fold.mix_u32(a, r.b);
}

fun fold8f(h: u64, r: S8f) u64 {
    var a: u64 = fold.mix_f32(h, r.x);
    ret fold.mix_f32(a, r.y);
}

fun fold12(h: u64, r: S12) u64 {
    var a: u64 = fold.mix_u32(h, r.a);
    a = fold.mix_u32(a, r.b);
    ret fold.mix_u32(a, r.c);
}

fun fold16(h: u64, r: S16) u64 {
    var a: u64 = fold.mix_u64(h, r.a);
    ret fold.mix_u64(a, r.b);
}

fun fold16f(h: u64, r: S16f) u64 {
    var a: u64 = fold.mix_f64(h, r.x);
    ret fold.mix_f64(a, r.y);
}

fun fold16m(h: u64, r: S16m) u64 {
    var a: u64 = fold.mix_u64(h, r.a);
    ret fold.mix_f64(a, r.x);
}

fun fold16n(h: u64, r: S16n) u64 {
    var a: u64 = fold.mix_f64(h, r.x);
    ret fold.mix_u64(a, r.a);
}

fun layout(h: u64) u64 {
    var a: u64 = fold.mix_u64(h, $size_of(S1)::u64);
    a = fold.mix_u64(a, $size_of(S2)::u64);
    a = fold.mix_u64(a, $size_of(S4)::u64);
    a = fold.mix_u64(a, $size_of(S8)::u64);
    a = fold.mix_u64(a, $size_of(S8f)::u64);
    a = fold.mix_u64(a, $size_of(S12)::u64);
    a = fold.mix_u64(a, $size_of(S16)::u64);
    a = fold.mix_u64(a, $size_of(S16f)::u64);
    a = fold.mix_u64(a, $size_of(S16m)::u64);
    a = fold.mix_u64(a, $size_of(S16n)::u64);
    ret a;
}

# a returned record fed straight back in as an argument
fun regain(r16: S16, r16f: S16f, r16m: S16m, r12: S12, r8: S8, r8f: S8f) u64 {
    var h: u64 = fold.init();
    h = fold16(h, r16);
    h = fold16f(h, r16f);
    h = fold16m(h, r16m);
    h = fold12(h, r12);
    h = fold8(h, r8);
    h = fold8f(h, r8f);
    ret h;
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = layout(fold.init());

    var v: [8]u64;
    var i: u64 = 0;
    for (i < 8) {
        v[i] = gen(seed, i);
        i = i + 1;
    }

    var k: u64 = 0;
    for (k < 8) {
        val w: u64 = v[k] + seed;
        h = fold.mix_u8(h, ret1(w).a);
        h = fold.mix_u16(h, ret2(w).a);
        h = fold.mix_u32(h, ret4(w).a);
        h = fold8(h, ret8(w));
        h = fold8f(h, ret8f(w));
        h = fold12(h, ret12(w));
        h = fold16(h, ret16(w));
        h = fold16f(h, ret16f(w));
        h = fold16m(h, ret16m(w));
        h = fold16n(h, ret16n(w));
        k = k + 1;
    }

    # an array of returned records: a return written at the wrong width leaves a
    # neighbouring element short
    var a12: [6]S12;
    var a16: [6]S16m;
    k = 0;
    for (k < 6) {
        a12[k] = ret12(v[k] + seed);
        a16[k] = ret16m(v[k] * 3 + seed);
        k = k + 1;
    }
    k = 0;
    for (k < 6) {
        h = fold12(h, a12[k]);
        h = fold16m(h, a16[k]);
        k = k + 1;
    }

    k = 0;
    for (k < 4) {
        val w: u64 = v[k] + seed;
        h = fold.mix_u64(h, regain(ret16(w), ret16f(w), ret16m(w),
                                   ret12(w), ret8(w), ret8f(w)));
        k = k + 1;
    }

    ret h;
}
