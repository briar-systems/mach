# an aggregate argument is captured where it is evaluated, so a later argument that
# writes its source does not change what the callee sees (mach #3460). the caller may
# read an argument in place only when nothing evaluated after it can write, and each
# block here has a later argument that does: a call writing a global directly, a call
# writing a local through a pointer, a call writing through the pointer the argument is
# read from, and a call writing a field of the record the argument is a member of. R
# travels by reference or in the stack area, S in registers. the last block reads in
# place with nothing later, into callees that overwrite their parameter, which an
# inlined body must not write through to the caller's object.

use corpus.lib.fold;

rec R { a: u64; b: u64; c: u64; d: u64; e: u64; }
rec S { a: u32; b: u32; }
rec W { tag: u64; inner: R; small: S; }

var gr: R;
var gs: S;

fun gen(s: u64, k: u64) u64 {
    ret k * 6364136223846793005 + 1442695040888963407 + s;
}

fun make_r(s: u64) R {
    ret R{ a: gen(s, 1), b: gen(s, 2), c: gen(s, 3), d: gen(s, 4), e: gen(s, 5) };
}

fun fold_r(h: u64, r: R) u64 {
    var a: u64 = fold.mix_u64(h, r.a);
    a = fold.mix_u64(a, r.b);
    a = fold.mix_u64(a, r.c);
    a = fold.mix_u64(a, r.d);
    ret fold.mix_u64(a, r.e);
}

fun fold_s(h: u64, r: S) u64 {
    ret fold.mix_u32(fold.mix_u32(h, r.a), r.b);
}

fun take_r(r: R, k: u64) u64 {
    ret fold_r(fold.mix_u64(fold.init(), k), r);
}

fun take_s(r: S, k: u64) u64 {
    ret fold_s(fold.mix_u64(fold.init(), k), r);
}

fun take_rs(r: R, s: S, k: u64) u64 {
    ret fold_s(fold_r(fold.mix_u64(fold.init(), k), r), s);
}

fun write_globals(k: u64) u64 {
    gr = make_r(k);
    gs = S{ a: k::u32, b: (k >> 32)::u32 };
    ret k;
}

fun poke_r(p: *R, k: u64) u64 {
    p.a = k;
    p.c = ~k;
    p.e = k + 9;
    ret k;
}

fun poke_s(p: *S, k: u64) u64 {
    p.a = k::u32;
    p.b = ~k::u32;
    ret k;
}

fun poke_w(p: *W, k: u64) u64 {
    p.tag = k;
    p.inner.b = k ^ 0x5555555555555555;
    p.small.a = (k + 1)::u32;
    ret k;
}

fun clobber_r(v: R, k: u64) u64 {
    v.a = k;
    v.b = k + 1;
    v.c = k + 2;
    v.d = k + 3;
    v.e = k + 4;
    ret fold_r(fold.init(), v);
}

fun clobber_s(v: S, k: u64) u64 {
    v.a = k::u32;
    v.b = (k >> 16)::u32;
    ret fold_s(fold.init(), v);
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();

    var pass: u64 = 0;
    for (pass < 3) {
        val k: u64 = gen(seed, pass + 11);

        # a later argument's call writes the global source directly
        gr = make_r(k);
        gs = S{ a: (k >> 3)::u32, b: (k >> 35)::u32 };
        h = fold.mix_u64(h, take_r(gr, write_globals(k + 1)));
        h = fold_r(h, gr);
        h = fold.mix_u64(h, take_s(gs, write_globals(k + 2)));
        h = fold_s(h, gs);
        h = fold.mix_u64(h, take_rs(gr, gs, write_globals(k + 3)));
        h = fold_r(h, gr);

        # a later argument's call writes the local source through a pointer
        var l: R = make_r(k + 4);
        var ls: S = S{ a: (k >> 5)::u32, b: (k >> 37)::u32 };
        val lp: *R = ?l;
        val lsp: *S = ?ls;
        h = fold.mix_u64(h, take_r(l, poke_r(lp, k + 5)));
        h = fold_r(h, l);
        h = fold.mix_u64(h, take_s(ls, poke_s(lsp, k + 6)));
        h = fold_s(h, ls);

        # the argument is read through the pointer the later call writes through
        h = fold.mix_u64(h, take_r(@lp, poke_r(lp, k + 7)));
        h = fold_r(h, l);
        h = fold.mix_u64(h, take_s(@lsp, poke_s(lsp, k + 8)));
        h = fold_s(h, ls);

        # the argument is a member of the record the later call writes
        var w: W = W{ tag: k, inner: make_r(k + 9), small: S{ a: k::u32, b: 7 } };
        val wp: *W = ?w;
        h = fold.mix_u64(h, take_rs(w.inner, w.small, poke_w(wp, k + 10)));
        h = fold_r(h, w.inner);
        h = fold_s(h, w.small);
        h = fold.mix_u64(h, w.tag);

        # nothing later writes: read in place, into callees that overwrite the parameter
        h = fold.mix_u64(h, clobber_r(l, k + 12));
        h = fold_r(h, l);
        h = fold.mix_u64(h, clobber_s(ls, k + 13));
        h = fold_s(h, ls);
        h = fold.mix_u64(h, clobber_r(gr, k + 14));
        h = fold_r(h, gr);
        h = fold.mix_u64(h, clobber_r(w.inner, k + 15));
        h = fold_r(h, w.inner);
        h = fold.mix_u64(h, clobber_r(@lp, k + 16));
        h = fold_r(h, l);

        pass = pass + 1;
    }

    ret h;
}
