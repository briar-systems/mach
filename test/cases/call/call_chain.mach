# a long call chain in which every frame holds more values live across its call than
# the target has volatile registers, so the allocator has to put them in
# callee-saved registers and each callee has to give them back. the leaf burns a
# wide working set of its own, integer and float, so a callee-saved register that is
# written and not restored comes back changed. every held value is folded after the
# call returns, never before, which is the only ordering that can see the loss.

use corpus.lib.fold;

fun gen(s: u64, k: u64) u64 {
    ret k * 6364136223846793005 + 1442695040888963407 + s;
}

fun bit(x: u64, j: u64) f64 {
    ret ((x >> j) & 1023)::f64 / 8.0;
}

fun bit32(x: u64, j: u64) f32 {
    ret ((x >> j) & 255)::f32 / 4.0;
}

# no calls, a wide working set: whatever the allocator reaches for here is what the
# frames above need back
fun burn(x: u64) u64 {
    var a0: u64 = x ^ 1;
    var a1: u64 = x * 3 + 2;
    var a2: u64 = ~x + 3;
    var a3: u64 = x * 5 + 4;
    var a4: u64 = x ^ 2863311530;
    var a5: u64 = x * 7 + 6;
    var a6: u64 = ~x * 9;
    var a7: u64 = x + 305419896;
    var a8: u64 = x * 11 + 10;
    var a9: u64 = x ^ 1431655765;
    var a10: u64 = x * 13 + 12;
    var a11: u64 = ~x ^ x;
    var b0: f64 = bit(x, 0);
    var b1: f64 = bit(x, 5);
    var b2: f64 = bit(x, 11);
    var b3: f32 = bit32(x, 17);
    var b4: f32 = bit32(x, 23);
    var b5: f32 = bit32(x, 29);

    var i: u64 = 0;
    for (i < 6) {
        a0 = a0 + a1;
        a1 = a1 ^ a2;
        a2 = a2 + a3;
        a3 = a3 ^ a4;
        a4 = a4 + a5;
        a5 = a5 ^ a6;
        a6 = a6 + a7;
        a7 = a7 ^ a8;
        a8 = a8 + a9;
        a9 = a9 ^ a10;
        a10 = a10 + a11;
        a11 = a11 ^ a0;
        b0 = b0 + b1;
        b1 = b1 - b2;
        b2 = b2 + b0;
        b3 = b3 + b4;
        b4 = b4 - b5;
        b5 = b5 + b3;
        i = i + 1;
    }

    var h: u64 = fold.init();
    h = fold.mix_u64(h, a0 ^ a1 ^ a2 ^ a3 ^ a4 ^ a5);
    h = fold.mix_u64(h, a6 ^ a7 ^ a8 ^ a9 ^ a10 ^ a11);
    h = fold.mix_f64(h, b0 + b1 + b2);
    h = fold.mix_f32(h, b3 + b4 + b5);
    ret h;
}

fun chain(n: u64, x: u64, h: u64) u64 {
    val c0: u64 = x * 3 + 1;
    val c1: u64 = x ^ 305419896;
    val c2: u64 = ~x;
    val c3: u64 = x * 5 + n;
    val c4: u64 = x + 2863311530;
    val c5: u64 = x * 7 + 3;
    val c6: u64 = x ^ 1431655765;
    val c7: u64 = x * 9 + n;
    val c8: u64 = ~x + 11;
    val c9: u64 = x * 13 + 5;
    val c10: u64 = x ^ n;
    val c11: u64 = x * 17 + 7;
    val d0: f64 = bit(x, 1);
    val d1: f64 = bit(x, 9);
    val d2: f64 = bit(x, 19);
    val d3: f32 = bit32(x, 3);
    val d4: f32 = bit32(x, 13);
    val d5: f32 = bit32(x, 25);

    var a: u64 = h;
    if (n > 0) {
        a = chain(n - 1, x * 3 + n, a);
    } or {
        a = fold.mix_u64(a, burn(x));
    }

    a = fold.mix_u64(a, c0);
    a = fold.mix_u64(a, c1);
    a = fold.mix_u64(a, c2);
    a = fold.mix_u64(a, c3);
    a = fold.mix_u64(a, c4);
    a = fold.mix_u64(a, c5);
    a = fold.mix_u64(a, c6);
    a = fold.mix_u64(a, c7);
    a = fold.mix_u64(a, c8);
    a = fold.mix_u64(a, c9);
    a = fold.mix_u64(a, c10);
    a = fold.mix_u64(a, c11);
    a = fold.mix_f64(a, d0);
    a = fold.mix_f64(a, d1);
    a = fold.mix_f64(a, d2);
    a = fold.mix_f32(a, d3);
    a = fold.mix_f32(a, d4);
    a = fold.mix_f32(a, d5);
    a = fold.mix_f64(a, d0 + d1 - d2);
    a = fold.mix_f32(a, d3 + d4 - d5);
    ret fold.mix_u64(a, c0 ^ c5 ^ c11);
}

fun stage_d(x: u64, h: u64) u64 {
    val e0: u64 = x + 1;
    val e1: u64 = x * 3;
    val e2: u64 = ~x;
    val e3: f64 = bit(x, 2);
    val e4: f32 = bit32(x, 7);
    var a: u64 = fold.mix_u64(h, burn(x ^ 12345));
    a = fold.mix_u64(a, e0);
    a = fold.mix_u64(a, e1);
    a = fold.mix_u64(a, e2);
    a = fold.mix_f64(a, e3);
    ret fold.mix_f32(a, e4);
}

fun stage_c(x: u64, h: u64) u64 {
    val e0: u64 = x ^ 11;
    val e1: u64 = x * 5 + 2;
    val e2: u64 = ~x + 7;
    val e3: u64 = x + 2863311530;
    val e4: u64 = x * 9;
    val e5: f64 = bit(x, 4);
    val e6: f64 = bit(x, 14);
    val e7: f32 = bit32(x, 21);
    var a: u64 = stage_d(x * 7 + 1, h);
    a = fold.mix_u64(a, e0);
    a = fold.mix_u64(a, e1);
    a = fold.mix_u64(a, e2);
    a = fold.mix_u64(a, e3);
    a = fold.mix_u64(a, e4);
    a = fold.mix_f64(a, e5);
    a = fold.mix_f64(a, e6);
    a = fold.mix_f32(a, e7);
    ret fold.mix_u64(a, e0 ^ e4);
}

fun stage_b(x: u64, h: u64) u64 {
    val e0: u64 = x * 13 + 3;
    val e1: u64 = x ^ 1431655765;
    val e2: u64 = ~x * 3;
    val e3: u64 = x + 17;
    val e4: u64 = x * 19;
    val e5: u64 = x ^ 305419896;
    val e6: u64 = x + 23;
    val e7: f64 = bit(x, 6);
    val e8: f64 = bit(x, 16);
    val e9: f64 = bit(x, 26);
    val e10: f32 = bit32(x, 9);
    val e11: f32 = bit32(x, 27);
    var a: u64 = stage_c(x + 29, h);
    a = fold.mix_u64(a, e0);
    a = fold.mix_u64(a, e1);
    a = fold.mix_u64(a, e2);
    a = fold.mix_u64(a, e3);
    a = fold.mix_u64(a, e4);
    a = fold.mix_u64(a, e5);
    a = fold.mix_u64(a, e6);
    a = fold.mix_f64(a, e7);
    a = fold.mix_f64(a, e8);
    a = fold.mix_f64(a, e9);
    a = fold.mix_f32(a, e10);
    a = fold.mix_f32(a, e11);
    ret fold.mix_u64(a, e0 + e3 + e6);
}

fun stage_a(x: u64, h: u64) u64 {
    val e0: u64 = x + 31;
    val e1: u64 = x * 37;
    val e2: u64 = ~x ^ 41;
    val e3: u64 = x * 43 + 2;
    val e4: u64 = x + 47;
    val e5: u64 = x ^ 2863311530;
    val e6: u64 = x * 53;
    val e7: u64 = ~x + 59;
    val e8: u64 = x * 61 + 4;
    val e9: f64 = bit(x, 8);
    val e10: f64 = bit(x, 18);
    val e11: f32 = bit32(x, 11);
    val e12: f32 = bit32(x, 19);
    var a: u64 = stage_b(x * 3 + 5, h);
    a = fold.mix_u64(a, e0);
    a = fold.mix_u64(a, e1);
    a = fold.mix_u64(a, e2);
    a = fold.mix_u64(a, e3);
    a = fold.mix_u64(a, e4);
    a = fold.mix_u64(a, e5);
    a = fold.mix_u64(a, e6);
    a = fold.mix_u64(a, e7);
    a = fold.mix_u64(a, e8);
    a = fold.mix_f64(a, e9);
    a = fold.mix_f64(a, e10);
    a = fold.mix_f32(a, e11);
    a = fold.mix_f32(a, e12);
    ret fold.mix_u64(a, e0 ^ e4 ^ e8);
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();

    var v: [6]u64;
    var i: u64 = 0;
    for (i < 6) {
        v[i] = gen(seed, i);
        i = i + 1;
    }

    h = chain(16 + seed, v[0], h);
    h = chain(1 + seed, v[1], h);

    var k: u64 = 0;
    for (k < 4) {
        h = stage_a(v[k] + seed, h);
        k = k + 1;
    }

    h = fold.mix_u64(h, burn(v[5] + seed));
    ret h;
}
