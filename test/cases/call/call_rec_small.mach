# record arguments at 1, 2, 4 and 8 bytes: the sizes every ABI passes whole in a
# single register. the record sizes and field offsets are folded first, so a layout
# that disagrees with the C reference is caught before any value is, and each record
# is then passed interleaved with scalars so a record that wrongly consumes two
# registers, or is passed by reference when it should be by value, moves the
# arguments after it.

use corpus.lib.fold;

rec R1 { a: u8; }
rec R2 { a: u8; b: u8; }
rec R4 { a: u8; b: u8; c: u16; }
rec R8 { a: u32; b: u16; c: u8; }

fun gen(s: u64, k: u64) u64 {
    ret k * 6364136223846793005 + 1442695040888963407 + s;
}

fun fold_r1(h: u64, r: R1) u64 { ret fold.mix_u8(h, r.a); }

fun fold_r2(h: u64, r: R2) u64 {
    var a: u64 = fold.mix_u8(h, r.a);
    ret fold.mix_u8(a, r.b);
}

fun fold_r4(h: u64, r: R4) u64 {
    var a: u64 = fold.mix_u8(h, r.a);
    a = fold.mix_u8(a, r.b);
    ret fold.mix_u16(a, r.c);
}

fun fold_r8(h: u64, r: R8) u64 {
    var a: u64 = fold.mix_u32(h, r.a);
    a = fold.mix_u16(a, r.b);
    ret fold.mix_u8(a, r.c);
}

fun layout(h: u64) u64 {
    var a: u64 = fold.mix_u64(h, $size_of(R1)::u64);
    a = fold.mix_u64(a, $size_of(R2)::u64);
    a = fold.mix_u64(a, $size_of(R4)::u64);
    a = fold.mix_u64(a, $size_of(R8)::u64);
    a = fold.mix_u64(a, $align_of(R1)::u64);
    a = fold.mix_u64(a, $align_of(R2)::u64);
    a = fold.mix_u64(a, $align_of(R4)::u64);
    a = fold.mix_u64(a, $align_of(R8)::u64);
    a = fold.mix_u64(a, $offset_of(R2, b)::u64);
    a = fold.mix_u64(a, $offset_of(R4, b)::u64);
    a = fold.mix_u64(a, $offset_of(R4, c)::u64);
    a = fold.mix_u64(a, $offset_of(R8, b)::u64);
    a = fold.mix_u64(a, $offset_of(R8, c)::u64);
    ret a;
}

fun take_small(p0: u64, r1: R1, p1: u32, r2: R2, x0: f64, r4: R4, p2: u64,
               r8: R8, s1: R1, s2: R2, s4: R4, s8: R8, x1: f32, p3: u64) u64 {
    var h: u64 = fold.init();
    h = fold.mix_u64(h, p0);
    h = fold_r1(h, r1);
    h = fold.mix_u32(h, p1);
    h = fold_r2(h, r2);
    h = fold.mix_f64(h, x0);
    h = fold_r4(h, r4);
    h = fold.mix_u64(h, p2);
    h = fold_r8(h, r8);
    h = fold_r1(h, s1);
    h = fold_r2(h, s2);
    h = fold_r4(h, s4);
    h = fold_r8(h, s8);
    h = fold.mix_f32(h, x1);
    h = fold.mix_u64(h, p3);

    # a copy of an argument record, mutated and folded again: the callee's copy must
    # be its own, so writing it cannot change what the caller still holds
    var c8: R8 = r8;
    c8.a = c8.a + 1;
    c8.b = c8.b + 2;
    c8.c = c8.c + 3;
    h = fold_r8(h, c8);
    h = fold_r8(h, r8);
    ret h;
}

fun mk1(v: u64) R1 { ret R1{ a: v::u8 }; }
fun mk2(v: u64) R2 { ret R2{ a: v::u8, b: (v >> 8)::u8 }; }
fun mk4(v: u64) R4 { ret R4{ a: v::u8, b: (v >> 8)::u8, c: (v >> 16)::u16 }; }
fun mk8(v: u64) R8 { ret R8{ a: v::u32, b: (v >> 32)::u16, c: (v >> 48)::u8 }; }

pub fun checksum(seed: u64) u64 {
    var h: u64 = layout(fold.init());

    var v: [12]u64;
    var i: u64 = 0;
    for (i < 12) {
        v[i] = gen(seed, i);
        i = i + 1;
    }

    var r: u64 = 0;
    var pass: u64 = 0;
    for (pass < 3) {
        val d: u64 = pass * 13 + seed;
        r = take_small(v[0] + d, mk1(v[1]), v[2]::u32, mk2(v[3]),
                       (v[4] & 1023)::f64, mk4(v[5]), v[6], mk8(v[7] + d),
                       mk1(v[8]), mk2(v[9]), mk4(v[10]), mk8(v[11]),
                       (v[0] & 255)::f32, v[1]);
        h = fold.mix_u64(h, r);
        pass = pass + 1;
    }

    # records built by a call inside the argument list of another call
    h = fold.mix_u64(h, take_small(
        r, mk1(r), r::u32, mk2(r), (r & 1023)::f64, mk4(r), v[6],
        mk8(r), mk1(v[8]), mk2(v[9]), mk4(v[10]), mk8(v[11]),
        (v[0] & 255)::f32, v[2]));

    ret h;
}
