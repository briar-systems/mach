# float argument passing past the end of every ABI's float argument registers.
# sixteen alternating f32/f64 arguments overflow eight on x86_64, aarch64 and
# riscv, and a second sixteen, all f32, put that tail in stack slots wider than the
# value. every operand is a multiple of 1/64 with a small exponent, so every sum and
# product below is exact in both f32 and f64 and the case measures argument
# placement rather than rounding. sixteen is also the most parameters the SPIR-V
# target accepts, which is why the tail stops there rather than running longer.

use corpus.lib.fold;

fun gen(s: u64, k: u64) u64 {
    ret k * 6364136223846793005 + 1442695040888963407 + s;
}

fun as_f32(v: u64) f32 {
    ret ((v & 4095)::f32 - 2048.0) / 8.0;
}

fun as_f64(v: u64) f64 {
    ret ((v & 1048575)::f64 - 524288.0) / 64.0;
}

fun takef16(a0: f32, a1: f64, a2: f32, a3: f64, a4: f32, a5: f64, a6: f32, a7: f64,
            a8: f32, a9: f64, a10: f32, a11: f64, a12: f32, a13: f64, a14: f32, a15: f64) u64 {
    var h: u64 = fold.init();
    h = fold.mix_f32(h, a0);
    h = fold.mix_f64(h, a1);
    h = fold.mix_f32(h, a2);
    h = fold.mix_f64(h, a3);
    h = fold.mix_f32(h, a4);
    h = fold.mix_f64(h, a5);
    h = fold.mix_f32(h, a6);
    h = fold.mix_f64(h, a7);
    h = fold.mix_f32(h, a8);
    h = fold.mix_f64(h, a9);
    h = fold.mix_f32(h, a10);
    h = fold.mix_f64(h, a11);
    h = fold.mix_f32(h, a12);
    h = fold.mix_f64(h, a13);
    h = fold.mix_f32(h, a14);
    h = fold.mix_f64(h, a15);
    h = fold.mix_f32(h, a0 + a2 * a4 - a6);
    h = fold.mix_f64(h, a1 + a3 * a5 - a7);
    h = fold.mix_f32(h, a8 - a10 + a12 * a14);
    h = fold.mix_f64(h, a9 - a11 + a13 * a15);
    ret h;
}

fun takef16s(b0: f32, b1: f32, b2: f32, b3: f32, b4: f32, b5: f32, b6: f32,
             b7: f32, b8: f32, b9: f32, b10: f32, b11: f32, b12: f32, b13: f32,
             b14: f32, b15: f32) u64 {
    var h: u64 = fold.init();
    h = fold.mix_f32(h, b0);
    h = fold.mix_f32(h, b1);
    h = fold.mix_f32(h, b2);
    h = fold.mix_f32(h, b3);
    h = fold.mix_f32(h, b4);
    h = fold.mix_f32(h, b5);
    h = fold.mix_f32(h, b6);
    h = fold.mix_f32(h, b7);
    h = fold.mix_f32(h, b8);
    h = fold.mix_f32(h, b9);
    h = fold.mix_f32(h, b10);
    h = fold.mix_f32(h, b11);
    h = fold.mix_f32(h, b12);
    h = fold.mix_f32(h, b13);
    h = fold.mix_f32(h, b14);
    h = fold.mix_f32(h, b15);
    h = fold.mix_f32(h, b0 + b15);
    h = fold.mix_f32(h, b7 - b12);
    h = fold.mix_f32(h, b3 * b14);
    ret h;
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();

    var v: [20]u64;
    var i: u64 = 0;
    for (i < 20) {
        v[i] = gen(seed, i);
        i = i + 1;
    }

    var f: [20]f32;
    var d: [20]f64;
    i = 0;
    for (i < 20) {
        f[i] = as_f32(v[i]);
        d[i] = as_f64(v[i]);
        i = i + 1;
    }

    var r: u64 = 0;
    var pass: u64 = 0;
    for (pass < 3) {
        val bias: f32 = (pass & 3)::f32 / 4.0;

        r = takef16(f[0] + bias, d[1], f[2], d[3], f[4], d[5], f[6], d[7],
                    f[8], d[9], f[10], d[11], f[12], d[13], f[14], d[15]);
        h = fold.mix_u64(h, r);

        r = takef16s(f[0], f[1], f[2], f[3], f[4], f[5], f[6], f[7], f[8], f[9],
                     f[10], f[11], f[12], f[13], f[14], f[15] + bias);
        h = fold.mix_u64(h, r);

        pass = pass + 1;
    }

    # a float call live across another float call: the argument registers of the
    # outer call are built while the inner call owns the whole bank
    h = fold.mix_u64(h, takef16(
        as_f32(takef16s(f[19], f[18], f[17], f[16], f[15], f[14], f[13], f[12],
                        f[11], f[10], f[9], f[8], f[7], f[6], f[5], f[4])),
        d[0], f[1], d[2], f[3], d[4], f[5], d[6],
        as_f32(r), d[8], f[9], d[10], f[11], d[12], f[13], d[14]));

    ret h;
}
