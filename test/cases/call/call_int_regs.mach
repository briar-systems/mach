# integer argument passing past the end of every ABI's argument registers. sixteen
# mixed-width arguments overflow six on x86_64 and eight on aarch64 and riscv, and a
# second sixteen, all narrower than a stack slot, put that tail in slots wider than
# the values. every argument is folded in parameter order, so a swapped pair, a slot
# written at the wrong width, or a narrow argument extended the wrong way changes
# the checksum. sixteen is also the most parameters the SPIR-V target accepts, which
# is why the tail stops there rather than running longer.

use corpus.lib.fold;

fun gen(s: u64, k: u64) u64 {
    ret k * 6364136223846793005 + 1442695040888963407 + s;
}

fun take16(a0: u8, a1: i8, a2: u16, a3: i16, a4: u32, a5: i32, a6: u64, a7: i64,
           a8: u8, a9: i8, a10: u16, a11: i16, a12: u32, a13: i32, a14: u64, a15: i64) u64 {
    var h: u64 = fold.init();
    h = fold.mix_u8(h, a0);
    h = fold.mix_i8(h, a1);
    h = fold.mix_u16(h, a2);
    h = fold.mix_i16(h, a3);
    h = fold.mix_u32(h, a4);
    h = fold.mix_i32(h, a5);
    h = fold.mix_u64(h, a6);
    h = fold.mix_i64(h, a7);
    h = fold.mix_u8(h, a8);
    h = fold.mix_i8(h, a9);
    h = fold.mix_u16(h, a10);
    h = fold.mix_i16(h, a11);
    h = fold.mix_u32(h, a12);
    h = fold.mix_i32(h, a13);
    h = fold.mix_u64(h, a14);
    h = fold.mix_i64(h, a15);
    ret h;
}

fun take16n(b0: u8, b1: u8, b2: i8, b3: i8, b4: u16, b5: u16, b6: i16, b7: i16,
            b8: u8, b9: i8, b10: u16, b11: i16, b12: u8, b13: i8, b14: u16, b15: i16) u64 {
    var h: u64 = fold.init();
    h = fold.mix_u8(h, b0);
    h = fold.mix_u8(h, b1);
    h = fold.mix_i8(h, b2);
    h = fold.mix_i8(h, b3);
    h = fold.mix_u16(h, b4);
    h = fold.mix_u16(h, b5);
    h = fold.mix_i16(h, b6);
    h = fold.mix_i16(h, b7);
    h = fold.mix_u8(h, b8);
    h = fold.mix_i8(h, b9);
    h = fold.mix_u16(h, b10);
    h = fold.mix_i16(h, b11);
    h = fold.mix_u8(h, b12);
    h = fold.mix_i8(h, b13);
    h = fold.mix_u16(h, b14);
    h = fold.mix_i16(h, b15);
    ret h;
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();

    var v: [20]u64;
    var i: u64 = 0;
    for (i < 20) {
        v[i] = gen(seed, i);
        i = i + 1;
    }

    var r: u64 = 0;
    var pass: u64 = 0;
    for (pass < 3) {
        val d: u64 = pass * 7 + seed;

        r = take16(v[0]::u8, v[1]::u8:~i8, v[2]::u16, v[3]::u16:~i16,
                   v[4]::u32, v[5]::u32:~i32, v[6] + d, v[7]:~i64,
                   v[8]::u8, v[9]::u8:~i8, v[10]::u16, v[11]::u16:~i16,
                   v[12]::u32, v[13]::u32:~i32, v[14] + d, v[15]:~i64);
        h = fold.mix_u64(h, r);

        r = take16n(v[0]::u8, v[1]::u8, v[2]::u8:~i8, v[3]::u8:~i8,
                    v[4]::u16, v[5]::u16, v[6]::u16:~i16, v[7]::u16:~i16,
                    (v[8] + d)::u8, v[9]::u8:~i8, v[10]::u16, v[11]::u16:~i16,
                    v[12]::u8, v[13]::u8:~i8, v[14]::u16, (v[15] + d)::u16:~i16);
        h = fold.mix_u64(h, r);

        pass = pass + 1;
    }

    # a call whose arguments are themselves calls: the argument area is built while
    # another call is live, so a caller that reuses one outgoing slot loses a value
    h = fold.mix_u64(h, take16(
        take16(v[0]::u8, v[1]::u8:~i8, v[2]::u16, v[3]::u16:~i16,
               v[4]::u32, v[5]::u32:~i32, v[6], v[7]:~i64,
               v[8]::u8, v[9]::u8:~i8, v[10]::u16, v[11]::u16:~i16,
               v[12]::u32, v[13]::u32:~i32, v[14], v[15]:~i64)::u8,
        v[1]::u8:~i8, v[2]::u16, v[3]::u16:~i16,
        r::u32, v[5]::u32:~i32, v[6], v[7]:~i64,
        take16n(v[16]::u8, v[17]::u8, v[18]::u8:~i8, v[19]::u8:~i8,
                v[4]::u16, v[5]::u16, v[6]::u16:~i16, v[7]::u16:~i16,
                v[8]::u8, v[9]::u8:~i8, v[10]::u16, v[11]::u16:~i16,
                v[12]::u8, v[13]::u8:~i8, v[14]::u16, v[15]::u16:~i16)::u8,
        v[9]::u8:~i8, v[10]::u16, v[11]::u16:~i16,
        v[12]::u32, v[13]::u32:~i32, v[14], v[15]:~i64));

    ret h;
}
