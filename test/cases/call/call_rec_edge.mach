# record arguments at 9, 12, 16 and 17 bytes: the sizes that straddle every ABI's
# classification boundary. 16 is the last size x86_64 SysV passes in registers and
# 17 is the first it passes in memory, 9 and 17 are odd sizes whose tail byte needs
# a partial load, and the three 16-byte records differ only in field types so a
# classifier that reads size alone rather than fields sends the all-float one
# through the integer registers.

use corpus.lib.fold;

rec E9 { head: u8; body: [8]u8; }
rec E12 { a: u32; b: u32; c: u32; }
rec E16 { a: u64; b: u64; }
rec E16f { x: f64; y: f64; }
rec E16m { a: u64; x: f64; }
rec E17 { head: u8; body: [16]u8; }

fun gen(s: u64, k: u64) u64 {
    ret k * 6364136223846793005 + 1442695040888963407 + s;
}

fun fold_e9(h: u64, r: E9) u64 {
    var a: u64 = fold.mix_u8(h, r.head);
    var i: u64 = 0;
    for (i < 8) {
        a = fold.mix_u8(a, r.body[i]);
        i = i + 1;
    }
    ret a;
}

fun fold_e12(h: u64, r: E12) u64 {
    var a: u64 = fold.mix_u32(h, r.a);
    a = fold.mix_u32(a, r.b);
    ret fold.mix_u32(a, r.c);
}

fun fold_e16(h: u64, r: E16) u64 {
    var a: u64 = fold.mix_u64(h, r.a);
    ret fold.mix_u64(a, r.b);
}

fun fold_e16f(h: u64, r: E16f) u64 {
    var a: u64 = fold.mix_f64(h, r.x);
    ret fold.mix_f64(a, r.y);
}

fun fold_e16m(h: u64, r: E16m) u64 {
    var a: u64 = fold.mix_u64(h, r.a);
    ret fold.mix_f64(a, r.x);
}

fun fold_e17(h: u64, r: E17) u64 {
    var a: u64 = fold.mix_u8(h, r.head);
    var i: u64 = 0;
    for (i < 16) {
        a = fold.mix_u8(a, r.body[i]);
        i = i + 1;
    }
    ret a;
}

fun layout(h: u64) u64 {
    var a: u64 = fold.mix_u64(h, $size_of(E9)::u64);
    a = fold.mix_u64(a, $size_of(E12)::u64);
    a = fold.mix_u64(a, $size_of(E16)::u64);
    a = fold.mix_u64(a, $size_of(E16f)::u64);
    a = fold.mix_u64(a, $size_of(E16m)::u64);
    a = fold.mix_u64(a, $size_of(E17)::u64);
    a = fold.mix_u64(a, $align_of(E9)::u64);
    a = fold.mix_u64(a, $align_of(E12)::u64);
    a = fold.mix_u64(a, $align_of(E16)::u64);
    a = fold.mix_u64(a, $align_of(E16f)::u64);
    a = fold.mix_u64(a, $align_of(E16m)::u64);
    a = fold.mix_u64(a, $align_of(E17)::u64);
    a = fold.mix_u64(a, $offset_of(E9, body)::u64);
    a = fold.mix_u64(a, $offset_of(E12, c)::u64);
    a = fold.mix_u64(a, $offset_of(E16, b)::u64);
    a = fold.mix_u64(a, $offset_of(E16f, y)::u64);
    a = fold.mix_u64(a, $offset_of(E16m, x)::u64);
    a = fold.mix_u64(a, $offset_of(E17, body)::u64);
    ret a;
}

fun take_edge(p0: u64, e9: E9, p1: u32, e12: E12, x0: f64, e16: E16,
              e16f: E16f, e16m: E16m, p2: u64, e17: E17, t9: E9, t12: E12,
              t16: E16, t17: E17, x1: f32, p3: u64) u64 {
    var h: u64 = fold.init();
    h = fold.mix_u64(h, p0);
    h = fold_e9(h, e9);
    h = fold.mix_u32(h, p1);
    h = fold_e12(h, e12);
    h = fold.mix_f64(h, x0);
    h = fold_e16(h, e16);
    h = fold_e16f(h, e16f);
    h = fold_e16m(h, e16m);
    h = fold.mix_u64(h, p2);
    h = fold_e17(h, e17);
    h = fold_e9(h, t9);
    h = fold_e12(h, t12);
    h = fold_e16(h, t16);
    h = fold_e17(h, t17);
    h = fold.mix_f32(h, x1);
    h = fold.mix_u64(h, p3);

    # the callee's copy is its own: writing it must leave the caller's value alone
    var c17: E17 = e17;
    c17.head = c17.head + 1;
    var i: u64 = 0;
    for (i < 16) {
        c17.body[i] = c17.body[i] + i::u8 + 1;
        i = i + 1;
    }
    h = fold_e17(h, c17);
    h = fold_e17(h, e17);
    ret h;
}

fun mk9(v: u64) E9 {
    var r: E9;
    r.head = v::u8;
    var i: u64 = 0;
    for (i < 8) {
        r.body[i] = (v >> (i * 8))::u8 + i::u8;
        i = i + 1;
    }
    ret r;
}

fun mk12(v: u64) E12 {
    ret E12{ a: v::u32, b: (v >> 16)::u32, c: (v >> 32)::u32 };
}

fun mk16(v: u64) E16 {
    ret E16{ a: v, b: v * 3 + 7 };
}

fun mk16f(v: u64) E16f {
    ret E16f{ x: (v & 65535)::f64 / 8.0, y: (v & 4095)::f64 - 2048.0 };
}

fun mk16m(v: u64) E16m {
    ret E16m{ a: v ^ 305419896, x: (v & 262143)::f64 / 64.0 };
}

fun mk17(v: u64) E17 {
    var r: E17;
    r.head = (v >> 7)::u8;
    var i: u64 = 0;
    for (i < 16) {
        r.body[i] = (v >> (i * 4))::u8 ^ i::u8;
        i = i + 1;
    }
    ret r;
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = layout(fold.init());

    var v: [12]u64;
    var i: u64 = 0;
    for (i < 12) {
        v[i] = gen(seed, i);
        i = i + 1;
    }

    var r: u64 = 0;
    var pass: u64 = 0;
    for (pass < 3) {
        val d: u64 = pass * 17 + seed;
        r = take_edge(v[0] + d, mk9(v[1]), v[2]::u32, mk12(v[3]),
                      (v[4] & 1023)::f64, mk16(v[5] + d), mk16f(v[6]), mk16m(v[7]),
                      v[8], mk17(v[9]), mk9(v[10]), mk12(v[11]),
                      mk16(v[0]), mk17(v[1]), (v[2] & 255)::f32, v[3]);
        h = fold.mix_u64(h, r);
        pass = pass + 1;
    }

    h = fold.mix_u64(h, take_edge(
        r, mk9(r), r::u32, mk12(r), (r & 1023)::f64, mk16(r), mk16f(r), mk16m(r),
        v[8], mk17(r), mk9(v[10]), mk12(v[11]), mk16(v[0]), mk17(v[1]),
        (v[2] & 255)::f32, v[4]));

    ret h;
}
