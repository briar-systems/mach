# the operator matrix of #3432 written once against a type parameter and
# instantiated at six types. every operator here resolves at the instantiation,
# against that instance's concrete type, so a body that resolved one against the
# wrong type disagrees with the C reference rather than with another mach
# function. the reference spells each row out concretely at each width, which is
# the concrete control the issue asks the generic to match.

use corpus.lib.fold;

fun int_reduce[T](a: T, b: T) T {
    var acc: T = 0;
    acc = acc + (a + b);
    acc = acc + (b - a);
    acc = acc + (a * b);
    acc = acc + (b / a);
    acc = acc + (b % a);
    acc = acc + (a & b);
    acc = acc + (a | b);
    acc = acc + (a ^ b);
    acc = acc + (a << 2);
    acc = acc + (b >> 1);
    acc = acc + (~a);
    acc = acc + ((0::T) - a);
    acc = acc + (1::T);
    ret acc;
}

fun int_cmp[T](a: T, b: T) u8 {
    var m: u8 = 0;
    if (a == b) { m = m | 1; }
    if (a != b) { m = m | 2; }
    if (a < b)  { m = m | 4; }
    if (a > b)  { m = m | 8; }
    if (a <= b) { m = m | 16; }
    if (a >= b) { m = m | 32; }
    if (a == 0) { m = m | 64; }
    ret m;
}

fun flt_reduce[T](a: T, b: T) T {
    var acc: T = 0.0;
    acc = acc + (a + b);
    acc = acc + (b - a);
    acc = acc + (a * b);
    acc = acc + (b / a);
    acc = acc + ((0.0::T) - a);
    acc = acc + (1.0::T);
    ret acc;
}

fun flt_cmp[T](a: T, b: T) u8 {
    var m: u8 = 0;
    if (a == b)   { m = m | 1; }
    if (a != b)   { m = m | 2; }
    if (a < b)    { m = m | 4; }
    if (a > b)    { m = m | 8; }
    if (a <= b)   { m = m | 16; }
    if (a >= b)   { m = m | 32; }
    if (a == 0.0) { m = m | 64; }
    ret m;
}

# `:~` and `$size_of` answer for the same parameter: the reinterpret is only
# well formed at a width the intrinsic agrees with
fun width[T](a: T) u64 {
    ret $size_of(T);
}

fun bits64[T](a: T) u64 {
    ret a:~u64;
}

# ordering with no comparator parameter, the shape std's sort could not have
fun maxof[T](a: T, b: T) T {
    if (a > b) { ret a; }
    ret b;
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: u64 = seed & 3;

    val a8: u8 = (7 + s)::u8;
    val b8: u8 = (19 + s)::u8;
    h = fold.mix_u8(h, int_cmp[u8](a8, b8));
    h = fold.mix_u8(h, int_reduce[u8](a8, b8));
    h = fold.mix_u8(h, maxof[u8](a8, b8));

    val a32: u32 = (7 + s)::u32;
    val b32: u32 = (19 + s)::u32;
    h = fold.mix_u8(h, int_cmp[u32](a32, b32));
    h = fold.mix_u32(h, int_reduce[u32](a32, b32));
    h = fold.mix_u32(h, maxof[u32](a32, b32));

    val a64: u64 = 7 + s;
    val b64: u64 = 19 + s;
    h = fold.mix_u8(h, int_cmp[u64](a64, b64));
    h = fold.mix_u64(h, int_reduce[u64](a64, b64));
    h = fold.mix_u64(h, maxof[u64](a64, b64));

    val ai: i64 = (7 + s)::i64;
    val bi: i64 = (19 + s)::i64;
    h = fold.mix_u8(h, int_cmp[i64](ai, bi));
    h = fold.mix_i64(h, int_reduce[i64](ai, bi));
    h = fold.mix_i64(h, maxof[i64](ai, bi));

    val af: f64 = (7 + s)::f64;
    val bf: f64 = (19 + s)::f64;
    h = fold.mix_u8(h, flt_cmp[f64](af, bf));
    h = fold.mix_f64(h, flt_reduce[f64](af, bf));
    h = fold.mix_f64(h, maxof[f64](af, bf));

    val a32f: f32 = (7 + s)::f32;
    val b32f: f32 = (19 + s)::f32;
    h = fold.mix_u8(h, flt_cmp[f32](a32f, b32f));
    h = fold.mix_f32(h, flt_reduce[f32](a32f, b32f));
    h = fold.mix_f32(h, maxof[f32](a32f, b32f));

    h = fold.mix_u64(h, width[u8](a8));
    h = fold.mix_u64(h, width[u32](a32));
    h = fold.mix_u64(h, width[f64](af));
    h = fold.mix_u64(h, bits64[i64](ai));
    h = fold.mix_u64(h, bits64[f64](af));

    ret h;
}
