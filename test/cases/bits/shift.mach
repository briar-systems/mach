# shifts at every width and signedness: << and >> at counts 0, 1 and w-1, then counts
# at and past the width, which saturate (#3756). one noinline part per type.

use corpus.lib.fold;

# u8 shifts: << and >> (logical, zero-filling) at counts 0, 1 and w-1, then
# counts at and past the width, which saturate: a count at or above 8
# answers 0 for << and a logical >>, and the sign fill for an arithmetic >>
# (#3756). a constant count at or above the width is a compile error, so every
# saturating count here is opaque: it comes through a noinline call.
#[noinline]
fun opaque_shift_u8(n: u8) u8 {
    ret n;
}

#[noinline]
fun shift_u8(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: u8  = seed::u8;

    val zero: u8 = 0;
    val ones: u8 = 255;
    val even: u8 = 170;
    val odd:  u8 = 85;

    var a: u8 = ones ^ s;
    var b: u8 = even ^ s;
    var c: u8 = odd ^ s;
    var z: u8 = zero ^ s;

    h = fold.mix_u8(h, a << 0);
    h = fold.mix_u8(h, a << 1);
    h = fold.mix_u8(h, a << 7);
    h = fold.mix_u8(h, a >> 0);
    h = fold.mix_u8(h, a >> 1);
    h = fold.mix_u8(h, a >> 7);
    h = fold.mix_u8(h, b << 1);
    h = fold.mix_u8(h, b >> 1);
    h = fold.mix_u8(h, b >> 7);
    h = fold.mix_u8(h, c << 1);
    h = fold.mix_u8(h, c >> 1);
    h = fold.mix_u8(h, z << 5);
    h = fold.mix_u8(h, z >> 5);

    # the register count path, every count below the width
    var i: u8 = 0;
    for (i < 8) {
        h = fold.mix_u8(h, a << i);
        h = fold.mix_u8(h, a >> i);
        h = fold.mix_u8(h, b << i);
        h = fold.mix_u8(h, c >> i);
        i = i + 1;
    }

    # opaque_shift_u8 counts at and past the width (7, 8, 9, 16, 23, 255) saturate
    h = fold.mix_u8(h, a << opaque_shift_u8(7));
    h = fold.mix_u8(h, a >> opaque_shift_u8(7));
    h = fold.mix_u8(h, b >> opaque_shift_u8(7));
    h = fold.mix_u8(h, c << opaque_shift_u8(7));
    h = fold.mix_u8(h, a << opaque_shift_u8(8));
    h = fold.mix_u8(h, a >> opaque_shift_u8(8));
    h = fold.mix_u8(h, b >> opaque_shift_u8(8));
    h = fold.mix_u8(h, c << opaque_shift_u8(8));
    h = fold.mix_u8(h, a << opaque_shift_u8(9));
    h = fold.mix_u8(h, a >> opaque_shift_u8(9));
    h = fold.mix_u8(h, b >> opaque_shift_u8(9));
    h = fold.mix_u8(h, c << opaque_shift_u8(9));
    h = fold.mix_u8(h, a << opaque_shift_u8(16));
    h = fold.mix_u8(h, a >> opaque_shift_u8(16));
    h = fold.mix_u8(h, b >> opaque_shift_u8(16));
    h = fold.mix_u8(h, c << opaque_shift_u8(16));
    h = fold.mix_u8(h, a << opaque_shift_u8(23));
    h = fold.mix_u8(h, a >> opaque_shift_u8(23));
    h = fold.mix_u8(h, b >> opaque_shift_u8(23));
    h = fold.mix_u8(h, c << opaque_shift_u8(23));
    h = fold.mix_u8(h, a << opaque_shift_u8(255));
    h = fold.mix_u8(h, a >> opaque_shift_u8(255));
    h = fold.mix_u8(h, b >> opaque_shift_u8(255));
    h = fold.mix_u8(h, c << opaque_shift_u8(255));

    # 33 wraps the 32-bit alu count to 1, which only the saturation answers as 0
    # or the sign fill rather than a shift by one
    h = fold.mix_u8(h, a << opaque_shift_u8(33));
    h = fold.mix_u8(h, a >> opaque_shift_u8(33));
    h = fold.mix_u8(h, b >> opaque_shift_u8(33));
    h = fold.mix_u8(h, c << opaque_shift_u8(33));

    # a seeded count that straddles the width, as a wider integer than u8
    var j: u64 = 0;
    for (j < 12) {
        val n: u64 = 2 + j + (seed & 3);
        h = fold.mix_u8(h, a << n);
        h = fold.mix_u8(h, a >> n);
        h = fold.mix_u8(h, b >> n);
        j = j + 1;
    }

    ret h;
}

# i8 shifts: << and >> (arithmetic, sign-filling) at counts 0, 1 and w-1, then
# counts at and past the width, which saturate: a count at or above 8
# answers 0 for << and a logical >>, and the sign fill for an arithmetic >>
# (#3756). a constant count at or above the width is a compile error, so every
# saturating count here is opaque: it comes through a noinline call.
#[noinline]
fun opaque_shift_i8(n: u8) u8 {
    ret n;
}

#[noinline]
fun shift_i8(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: i8  = seed::i8;

    val zero: i8 = 0;
    val neg1: i8 = -1;
    val even: i8 = -86;
    val odd:  i8 = 85;

    var a: i8 = neg1 ^ s;
    var b: i8 = even ^ s;
    var c: i8 = odd ^ s;
    var z: i8 = zero ^ s;

    h = fold.mix_i8(h, a << 0);
    h = fold.mix_i8(h, a << 1);
    h = fold.mix_i8(h, a << 7);
    h = fold.mix_i8(h, a >> 0);
    h = fold.mix_i8(h, a >> 1);
    h = fold.mix_i8(h, a >> 7);
    h = fold.mix_i8(h, b << 1);
    h = fold.mix_i8(h, b >> 1);
    h = fold.mix_i8(h, b >> 7);
    h = fold.mix_i8(h, c << 1);
    h = fold.mix_i8(h, c >> 1);
    h = fold.mix_i8(h, z << 5);
    h = fold.mix_i8(h, z >> 5);

    # the register count path, every count below the width
    var i: u8 = 0;
    for (i < 8) {
        h = fold.mix_i8(h, a << i);
        h = fold.mix_i8(h, a >> i);
        h = fold.mix_i8(h, b << i);
        h = fold.mix_i8(h, c >> i);
        i = i + 1;
    }

    # opaque_shift_i8 counts at and past the width (7, 8, 9, 16, 23, 255) saturate
    h = fold.mix_i8(h, a << opaque_shift_i8(7));
    h = fold.mix_i8(h, a >> opaque_shift_i8(7));
    h = fold.mix_i8(h, b >> opaque_shift_i8(7));
    h = fold.mix_i8(h, c << opaque_shift_i8(7));
    h = fold.mix_i8(h, a << opaque_shift_i8(8));
    h = fold.mix_i8(h, a >> opaque_shift_i8(8));
    h = fold.mix_i8(h, b >> opaque_shift_i8(8));
    h = fold.mix_i8(h, c << opaque_shift_i8(8));
    h = fold.mix_i8(h, a << opaque_shift_i8(9));
    h = fold.mix_i8(h, a >> opaque_shift_i8(9));
    h = fold.mix_i8(h, b >> opaque_shift_i8(9));
    h = fold.mix_i8(h, c << opaque_shift_i8(9));
    h = fold.mix_i8(h, a << opaque_shift_i8(16));
    h = fold.mix_i8(h, a >> opaque_shift_i8(16));
    h = fold.mix_i8(h, b >> opaque_shift_i8(16));
    h = fold.mix_i8(h, c << opaque_shift_i8(16));
    h = fold.mix_i8(h, a << opaque_shift_i8(23));
    h = fold.mix_i8(h, a >> opaque_shift_i8(23));
    h = fold.mix_i8(h, b >> opaque_shift_i8(23));
    h = fold.mix_i8(h, c << opaque_shift_i8(23));
    h = fold.mix_i8(h, a << opaque_shift_i8(255));
    h = fold.mix_i8(h, a >> opaque_shift_i8(255));
    h = fold.mix_i8(h, b >> opaque_shift_i8(255));
    h = fold.mix_i8(h, c << opaque_shift_i8(255));

    # 33 wraps the 32-bit alu count to 1, which only the saturation answers as 0
    # or the sign fill rather than a shift by one
    h = fold.mix_i8(h, a << opaque_shift_i8(33));
    h = fold.mix_i8(h, a >> opaque_shift_i8(33));
    h = fold.mix_i8(h, b >> opaque_shift_i8(33));
    h = fold.mix_i8(h, c << opaque_shift_i8(33));

    # a seeded count that straddles the width, as a wider integer than u8
    var j: u64 = 0;
    for (j < 12) {
        val n: u64 = 2 + j + (seed & 3);
        h = fold.mix_i8(h, a << n);
        h = fold.mix_i8(h, a >> n);
        h = fold.mix_i8(h, b >> n);
        j = j + 1;
    }

    ret h;
}

# u16 shifts: << and >> (logical, zero-filling) at counts 0, 1 and w-1, then
# counts at and past the width, which saturate: a count at or above 16
# answers 0 for << and a logical >>, and the sign fill for an arithmetic >>
# (#3756). a constant count at or above the width is a compile error, so every
# saturating count here is opaque: it comes through a noinline call.
#[noinline]
fun opaque_shift_u16(n: u8) u8 {
    ret n;
}

#[noinline]
fun shift_u16(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: u16 = seed::u16;

    val zero: u16 = 0;
    val ones: u16 = 65535;
    val even: u16 = 43690;
    val odd:  u16 = 21845;

    var a: u16 = ones ^ s;
    var b: u16 = even ^ s;
    var c: u16 = odd ^ s;
    var z: u16 = zero ^ s;

    h = fold.mix_u16(h, a << 0);
    h = fold.mix_u16(h, a << 1);
    h = fold.mix_u16(h, a << 15);
    h = fold.mix_u16(h, a >> 0);
    h = fold.mix_u16(h, a >> 1);
    h = fold.mix_u16(h, a >> 15);
    h = fold.mix_u16(h, b << 1);
    h = fold.mix_u16(h, b >> 1);
    h = fold.mix_u16(h, b >> 15);
    h = fold.mix_u16(h, c << 1);
    h = fold.mix_u16(h, c >> 1);
    h = fold.mix_u16(h, z << 5);
    h = fold.mix_u16(h, z >> 5);

    # the register count path, every count below the width
    var i: u8 = 0;
    for (i < 16) {
        h = fold.mix_u16(h, a << i);
        h = fold.mix_u16(h, a >> i);
        h = fold.mix_u16(h, b << i);
        h = fold.mix_u16(h, c >> i);
        i = i + 1;
    }

    # opaque_shift_u16 counts at and past the width (15, 16, 17, 32, 39, 255) saturate
    h = fold.mix_u16(h, a << opaque_shift_u16(15));
    h = fold.mix_u16(h, a >> opaque_shift_u16(15));
    h = fold.mix_u16(h, b >> opaque_shift_u16(15));
    h = fold.mix_u16(h, c << opaque_shift_u16(15));
    h = fold.mix_u16(h, a << opaque_shift_u16(16));
    h = fold.mix_u16(h, a >> opaque_shift_u16(16));
    h = fold.mix_u16(h, b >> opaque_shift_u16(16));
    h = fold.mix_u16(h, c << opaque_shift_u16(16));
    h = fold.mix_u16(h, a << opaque_shift_u16(17));
    h = fold.mix_u16(h, a >> opaque_shift_u16(17));
    h = fold.mix_u16(h, b >> opaque_shift_u16(17));
    h = fold.mix_u16(h, c << opaque_shift_u16(17));
    h = fold.mix_u16(h, a << opaque_shift_u16(32));
    h = fold.mix_u16(h, a >> opaque_shift_u16(32));
    h = fold.mix_u16(h, b >> opaque_shift_u16(32));
    h = fold.mix_u16(h, c << opaque_shift_u16(32));
    h = fold.mix_u16(h, a << opaque_shift_u16(39));
    h = fold.mix_u16(h, a >> opaque_shift_u16(39));
    h = fold.mix_u16(h, b >> opaque_shift_u16(39));
    h = fold.mix_u16(h, c << opaque_shift_u16(39));
    h = fold.mix_u16(h, a << opaque_shift_u16(255));
    h = fold.mix_u16(h, a >> opaque_shift_u16(255));
    h = fold.mix_u16(h, b >> opaque_shift_u16(255));
    h = fold.mix_u16(h, c << opaque_shift_u16(255));

    # 33 wraps the 32-bit alu count to 1, which only the saturation answers as 0
    # or the sign fill rather than a shift by one
    h = fold.mix_u16(h, a << opaque_shift_u16(33));
    h = fold.mix_u16(h, a >> opaque_shift_u16(33));
    h = fold.mix_u16(h, b >> opaque_shift_u16(33));
    h = fold.mix_u16(h, c << opaque_shift_u16(33));

    # a seeded count that straddles the width, as a wider integer than u8
    var j: u64 = 0;
    for (j < 12) {
        val n: u64 = 10 + j + (seed & 3);
        h = fold.mix_u16(h, a << n);
        h = fold.mix_u16(h, a >> n);
        h = fold.mix_u16(h, b >> n);
        j = j + 1;
    }

    ret h;
}

# i16 shifts: << and >> (arithmetic, sign-filling) at counts 0, 1 and w-1, then
# counts at and past the width, which saturate: a count at or above 16
# answers 0 for << and a logical >>, and the sign fill for an arithmetic >>
# (#3756). a constant count at or above the width is a compile error, so every
# saturating count here is opaque: it comes through a noinline call.
#[noinline]
fun opaque_shift_i16(n: u8) u8 {
    ret n;
}

#[noinline]
fun shift_i16(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: i16 = seed::i16;

    val zero: i16 = 0;
    val neg1: i16 = -1;
    val even: i16 = -21846;
    val odd:  i16 = 21845;

    var a: i16 = neg1 ^ s;
    var b: i16 = even ^ s;
    var c: i16 = odd ^ s;
    var z: i16 = zero ^ s;

    h = fold.mix_i16(h, a << 0);
    h = fold.mix_i16(h, a << 1);
    h = fold.mix_i16(h, a << 15);
    h = fold.mix_i16(h, a >> 0);
    h = fold.mix_i16(h, a >> 1);
    h = fold.mix_i16(h, a >> 15);
    h = fold.mix_i16(h, b << 1);
    h = fold.mix_i16(h, b >> 1);
    h = fold.mix_i16(h, b >> 15);
    h = fold.mix_i16(h, c << 1);
    h = fold.mix_i16(h, c >> 1);
    h = fold.mix_i16(h, z << 5);
    h = fold.mix_i16(h, z >> 5);

    # the register count path, every count below the width
    var i: u8 = 0;
    for (i < 16) {
        h = fold.mix_i16(h, a << i);
        h = fold.mix_i16(h, a >> i);
        h = fold.mix_i16(h, b << i);
        h = fold.mix_i16(h, c >> i);
        i = i + 1;
    }

    # opaque_shift_i16 counts at and past the width (15, 16, 17, 32, 39, 255) saturate
    h = fold.mix_i16(h, a << opaque_shift_i16(15));
    h = fold.mix_i16(h, a >> opaque_shift_i16(15));
    h = fold.mix_i16(h, b >> opaque_shift_i16(15));
    h = fold.mix_i16(h, c << opaque_shift_i16(15));
    h = fold.mix_i16(h, a << opaque_shift_i16(16));
    h = fold.mix_i16(h, a >> opaque_shift_i16(16));
    h = fold.mix_i16(h, b >> opaque_shift_i16(16));
    h = fold.mix_i16(h, c << opaque_shift_i16(16));
    h = fold.mix_i16(h, a << opaque_shift_i16(17));
    h = fold.mix_i16(h, a >> opaque_shift_i16(17));
    h = fold.mix_i16(h, b >> opaque_shift_i16(17));
    h = fold.mix_i16(h, c << opaque_shift_i16(17));
    h = fold.mix_i16(h, a << opaque_shift_i16(32));
    h = fold.mix_i16(h, a >> opaque_shift_i16(32));
    h = fold.mix_i16(h, b >> opaque_shift_i16(32));
    h = fold.mix_i16(h, c << opaque_shift_i16(32));
    h = fold.mix_i16(h, a << opaque_shift_i16(39));
    h = fold.mix_i16(h, a >> opaque_shift_i16(39));
    h = fold.mix_i16(h, b >> opaque_shift_i16(39));
    h = fold.mix_i16(h, c << opaque_shift_i16(39));
    h = fold.mix_i16(h, a << opaque_shift_i16(255));
    h = fold.mix_i16(h, a >> opaque_shift_i16(255));
    h = fold.mix_i16(h, b >> opaque_shift_i16(255));
    h = fold.mix_i16(h, c << opaque_shift_i16(255));

    # 33 wraps the 32-bit alu count to 1, which only the saturation answers as 0
    # or the sign fill rather than a shift by one
    h = fold.mix_i16(h, a << opaque_shift_i16(33));
    h = fold.mix_i16(h, a >> opaque_shift_i16(33));
    h = fold.mix_i16(h, b >> opaque_shift_i16(33));
    h = fold.mix_i16(h, c << opaque_shift_i16(33));

    # a seeded count that straddles the width, as a wider integer than u8
    var j: u64 = 0;
    for (j < 12) {
        val n: u64 = 10 + j + (seed & 3);
        h = fold.mix_i16(h, a << n);
        h = fold.mix_i16(h, a >> n);
        h = fold.mix_i16(h, b >> n);
        j = j + 1;
    }

    ret h;
}

# u32 shifts: << and >> (logical, zero-filling) at counts 0, 1 and w-1, then
# counts at and past the width, which saturate: a count at or above 32
# answers 0 for << and a logical >>, and the sign fill for an arithmetic >>
# (#3756). a constant count at or above the width is a compile error, so every
# saturating count here is opaque: it comes through a noinline call.
#[noinline]
fun opaque_shift_u32(n: u8) u8 {
    ret n;
}

#[noinline]
fun shift_u32(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: u32 = seed::u32;

    val zero: u32 = 0;
    val ones: u32 = 4294967295;
    val even: u32 = 2863311530;
    val odd:  u32 = 1431655765;

    var a: u32 = ones ^ s;
    var b: u32 = even ^ s;
    var c: u32 = odd ^ s;
    var z: u32 = zero ^ s;

    h = fold.mix_u32(h, a << 0);
    h = fold.mix_u32(h, a << 1);
    h = fold.mix_u32(h, a << 31);
    h = fold.mix_u32(h, a >> 0);
    h = fold.mix_u32(h, a >> 1);
    h = fold.mix_u32(h, a >> 31);
    h = fold.mix_u32(h, b << 1);
    h = fold.mix_u32(h, b >> 1);
    h = fold.mix_u32(h, b >> 31);
    h = fold.mix_u32(h, c << 1);
    h = fold.mix_u32(h, c >> 1);
    h = fold.mix_u32(h, z << 5);
    h = fold.mix_u32(h, z >> 5);

    # the register count path, every count below the width
    var i: u8 = 0;
    for (i < 32) {
        h = fold.mix_u32(h, a << i);
        h = fold.mix_u32(h, a >> i);
        h = fold.mix_u32(h, b << i);
        h = fold.mix_u32(h, c >> i);
        i = i + 1;
    }

    # opaque_shift_u32 counts at and past the width (31, 32, 33, 64, 71, 255) saturate
    h = fold.mix_u32(h, a << opaque_shift_u32(31));
    h = fold.mix_u32(h, a >> opaque_shift_u32(31));
    h = fold.mix_u32(h, b >> opaque_shift_u32(31));
    h = fold.mix_u32(h, c << opaque_shift_u32(31));
    h = fold.mix_u32(h, a << opaque_shift_u32(32));
    h = fold.mix_u32(h, a >> opaque_shift_u32(32));
    h = fold.mix_u32(h, b >> opaque_shift_u32(32));
    h = fold.mix_u32(h, c << opaque_shift_u32(32));
    h = fold.mix_u32(h, a << opaque_shift_u32(33));
    h = fold.mix_u32(h, a >> opaque_shift_u32(33));
    h = fold.mix_u32(h, b >> opaque_shift_u32(33));
    h = fold.mix_u32(h, c << opaque_shift_u32(33));
    h = fold.mix_u32(h, a << opaque_shift_u32(64));
    h = fold.mix_u32(h, a >> opaque_shift_u32(64));
    h = fold.mix_u32(h, b >> opaque_shift_u32(64));
    h = fold.mix_u32(h, c << opaque_shift_u32(64));
    h = fold.mix_u32(h, a << opaque_shift_u32(71));
    h = fold.mix_u32(h, a >> opaque_shift_u32(71));
    h = fold.mix_u32(h, b >> opaque_shift_u32(71));
    h = fold.mix_u32(h, c << opaque_shift_u32(71));
    h = fold.mix_u32(h, a << opaque_shift_u32(255));
    h = fold.mix_u32(h, a >> opaque_shift_u32(255));
    h = fold.mix_u32(h, b >> opaque_shift_u32(255));
    h = fold.mix_u32(h, c << opaque_shift_u32(255));

    # a seeded count that straddles the width, as a wider integer than u8
    var j: u64 = 0;
    for (j < 12) {
        val n: u64 = 26 + j + (seed & 3);
        h = fold.mix_u32(h, a << n);
        h = fold.mix_u32(h, a >> n);
        h = fold.mix_u32(h, b >> n);
        j = j + 1;
    }

    # a count masked below the width is in range by construction and takes the
    # bare shift, no saturation
    h = fold.mix_u32(h, a << (opaque_shift_u32(37) & 31));
    h = fold.mix_u32(h, b >> (opaque_shift_u32(255) & 31));

    ret h;
}

# i32 shifts: << and >> (arithmetic, sign-filling) at counts 0, 1 and w-1, then
# counts at and past the width, which saturate: a count at or above 32
# answers 0 for << and a logical >>, and the sign fill for an arithmetic >>
# (#3756). a constant count at or above the width is a compile error, so every
# saturating count here is opaque: it comes through a noinline call.
#[noinline]
fun opaque_shift_i32(n: u8) u8 {
    ret n;
}

#[noinline]
fun shift_i32(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: i32 = seed::i32;

    val zero: i32 = 0;
    val neg1: i32 = -1;
    val even: i32 = -1431655766;
    val odd:  i32 = 1431655765;

    var a: i32 = neg1 ^ s;
    var b: i32 = even ^ s;
    var c: i32 = odd ^ s;
    var z: i32 = zero ^ s;

    h = fold.mix_i32(h, a << 0);
    h = fold.mix_i32(h, a << 1);
    h = fold.mix_i32(h, a << 31);
    h = fold.mix_i32(h, a >> 0);
    h = fold.mix_i32(h, a >> 1);
    h = fold.mix_i32(h, a >> 31);
    h = fold.mix_i32(h, b << 1);
    h = fold.mix_i32(h, b >> 1);
    h = fold.mix_i32(h, b >> 31);
    h = fold.mix_i32(h, c << 1);
    h = fold.mix_i32(h, c >> 1);
    h = fold.mix_i32(h, z << 5);
    h = fold.mix_i32(h, z >> 5);

    # the register count path, every count below the width
    var i: u8 = 0;
    for (i < 32) {
        h = fold.mix_i32(h, a << i);
        h = fold.mix_i32(h, a >> i);
        h = fold.mix_i32(h, b << i);
        h = fold.mix_i32(h, c >> i);
        i = i + 1;
    }

    # opaque_shift_i32 counts at and past the width (31, 32, 33, 64, 71, 255) saturate
    h = fold.mix_i32(h, a << opaque_shift_i32(31));
    h = fold.mix_i32(h, a >> opaque_shift_i32(31));
    h = fold.mix_i32(h, b >> opaque_shift_i32(31));
    h = fold.mix_i32(h, c << opaque_shift_i32(31));
    h = fold.mix_i32(h, a << opaque_shift_i32(32));
    h = fold.mix_i32(h, a >> opaque_shift_i32(32));
    h = fold.mix_i32(h, b >> opaque_shift_i32(32));
    h = fold.mix_i32(h, c << opaque_shift_i32(32));
    h = fold.mix_i32(h, a << opaque_shift_i32(33));
    h = fold.mix_i32(h, a >> opaque_shift_i32(33));
    h = fold.mix_i32(h, b >> opaque_shift_i32(33));
    h = fold.mix_i32(h, c << opaque_shift_i32(33));
    h = fold.mix_i32(h, a << opaque_shift_i32(64));
    h = fold.mix_i32(h, a >> opaque_shift_i32(64));
    h = fold.mix_i32(h, b >> opaque_shift_i32(64));
    h = fold.mix_i32(h, c << opaque_shift_i32(64));
    h = fold.mix_i32(h, a << opaque_shift_i32(71));
    h = fold.mix_i32(h, a >> opaque_shift_i32(71));
    h = fold.mix_i32(h, b >> opaque_shift_i32(71));
    h = fold.mix_i32(h, c << opaque_shift_i32(71));
    h = fold.mix_i32(h, a << opaque_shift_i32(255));
    h = fold.mix_i32(h, a >> opaque_shift_i32(255));
    h = fold.mix_i32(h, b >> opaque_shift_i32(255));
    h = fold.mix_i32(h, c << opaque_shift_i32(255));

    # a seeded count that straddles the width, as a wider integer than u8
    var j: u64 = 0;
    for (j < 12) {
        val n: u64 = 26 + j + (seed & 3);
        h = fold.mix_i32(h, a << n);
        h = fold.mix_i32(h, a >> n);
        h = fold.mix_i32(h, b >> n);
        j = j + 1;
    }

    ret h;
}

# u64 shifts: << and >> (logical, zero-filling) at counts 0, 1 and w-1, then
# counts at and past the width, which saturate: a count at or above 64
# answers 0 for << and a logical >>, and the sign fill for an arithmetic >>
# (#3756). a constant count at or above the width is a compile error, so every
# saturating count here is opaque: it comes through a noinline call.
#[noinline]
fun opaque_shift_u64(n: u8) u8 {
    ret n;
}

#[noinline]
fun shift_u64(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: u64 = seed::u64;

    val zero: u64 = 0;
    val ones: u64 = 18446744073709551615;
    val even: u64 = 12297829382473034410;
    val odd:  u64 = 6148914691236517205;

    var a: u64 = ones ^ s;
    var b: u64 = even ^ s;
    var c: u64 = odd ^ s;
    var z: u64 = zero ^ s;

    h = fold.mix_u64(h, a << 0);
    h = fold.mix_u64(h, a << 1);
    h = fold.mix_u64(h, a << 63);
    h = fold.mix_u64(h, a >> 0);
    h = fold.mix_u64(h, a >> 1);
    h = fold.mix_u64(h, a >> 63);
    h = fold.mix_u64(h, b << 1);
    h = fold.mix_u64(h, b >> 1);
    h = fold.mix_u64(h, b >> 63);
    h = fold.mix_u64(h, c << 1);
    h = fold.mix_u64(h, c >> 1);
    h = fold.mix_u64(h, z << 5);
    h = fold.mix_u64(h, z >> 5);

    # the register count path, every count below the width
    var i: u8 = 0;
    for (i < 64) {
        h = fold.mix_u64(h, a << i);
        h = fold.mix_u64(h, a >> i);
        h = fold.mix_u64(h, b << i);
        h = fold.mix_u64(h, c >> i);
        i = i + 1;
    }

    # opaque_shift_u64 counts at and past the width (63, 64, 65, 128, 135, 255) saturate
    h = fold.mix_u64(h, a << opaque_shift_u64(63));
    h = fold.mix_u64(h, a >> opaque_shift_u64(63));
    h = fold.mix_u64(h, b >> opaque_shift_u64(63));
    h = fold.mix_u64(h, c << opaque_shift_u64(63));
    h = fold.mix_u64(h, a << opaque_shift_u64(64));
    h = fold.mix_u64(h, a >> opaque_shift_u64(64));
    h = fold.mix_u64(h, b >> opaque_shift_u64(64));
    h = fold.mix_u64(h, c << opaque_shift_u64(64));
    h = fold.mix_u64(h, a << opaque_shift_u64(65));
    h = fold.mix_u64(h, a >> opaque_shift_u64(65));
    h = fold.mix_u64(h, b >> opaque_shift_u64(65));
    h = fold.mix_u64(h, c << opaque_shift_u64(65));
    h = fold.mix_u64(h, a << opaque_shift_u64(128));
    h = fold.mix_u64(h, a >> opaque_shift_u64(128));
    h = fold.mix_u64(h, b >> opaque_shift_u64(128));
    h = fold.mix_u64(h, c << opaque_shift_u64(128));
    h = fold.mix_u64(h, a << opaque_shift_u64(135));
    h = fold.mix_u64(h, a >> opaque_shift_u64(135));
    h = fold.mix_u64(h, b >> opaque_shift_u64(135));
    h = fold.mix_u64(h, c << opaque_shift_u64(135));
    h = fold.mix_u64(h, a << opaque_shift_u64(255));
    h = fold.mix_u64(h, a >> opaque_shift_u64(255));
    h = fold.mix_u64(h, b >> opaque_shift_u64(255));
    h = fold.mix_u64(h, c << opaque_shift_u64(255));

    # a seeded count that straddles the width, as a wider integer than u8
    var j: u64 = 0;
    for (j < 12) {
        val n: u64 = 58 + j + (seed & 3);
        h = fold.mix_u64(h, a << n);
        h = fold.mix_u64(h, a >> n);
        h = fold.mix_u64(h, b >> n);
        j = j + 1;
    }

    ret h;
}

# i64 shifts: << and >> (arithmetic, sign-filling) at counts 0, 1 and w-1, then
# counts at and past the width, which saturate: a count at or above 64
# answers 0 for << and a logical >>, and the sign fill for an arithmetic >>
# (#3756). a constant count at or above the width is a compile error, so every
# saturating count here is opaque: it comes through a noinline call.
#[noinline]
fun opaque_shift_i64(n: u8) u8 {
    ret n;
}

#[noinline]
fun shift_i64(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: i64 = seed::i64;

    val zero: i64 = 0;
    val neg1: i64 = -1;
    val even: i64 = -6148914691236517206;
    val odd:  i64 = 6148914691236517205;

    var a: i64 = neg1 ^ s;
    var b: i64 = even ^ s;
    var c: i64 = odd ^ s;
    var z: i64 = zero ^ s;

    h = fold.mix_i64(h, a << 0);
    h = fold.mix_i64(h, a << 1);
    h = fold.mix_i64(h, a << 63);
    h = fold.mix_i64(h, a >> 0);
    h = fold.mix_i64(h, a >> 1);
    h = fold.mix_i64(h, a >> 63);
    h = fold.mix_i64(h, b << 1);
    h = fold.mix_i64(h, b >> 1);
    h = fold.mix_i64(h, b >> 63);
    h = fold.mix_i64(h, c << 1);
    h = fold.mix_i64(h, c >> 1);
    h = fold.mix_i64(h, z << 5);
    h = fold.mix_i64(h, z >> 5);

    # the register count path, every count below the width
    var i: u8 = 0;
    for (i < 64) {
        h = fold.mix_i64(h, a << i);
        h = fold.mix_i64(h, a >> i);
        h = fold.mix_i64(h, b << i);
        h = fold.mix_i64(h, c >> i);
        i = i + 1;
    }

    # opaque_shift_i64 counts at and past the width (63, 64, 65, 128, 135, 255) saturate
    h = fold.mix_i64(h, a << opaque_shift_i64(63));
    h = fold.mix_i64(h, a >> opaque_shift_i64(63));
    h = fold.mix_i64(h, b >> opaque_shift_i64(63));
    h = fold.mix_i64(h, c << opaque_shift_i64(63));
    h = fold.mix_i64(h, a << opaque_shift_i64(64));
    h = fold.mix_i64(h, a >> opaque_shift_i64(64));
    h = fold.mix_i64(h, b >> opaque_shift_i64(64));
    h = fold.mix_i64(h, c << opaque_shift_i64(64));
    h = fold.mix_i64(h, a << opaque_shift_i64(65));
    h = fold.mix_i64(h, a >> opaque_shift_i64(65));
    h = fold.mix_i64(h, b >> opaque_shift_i64(65));
    h = fold.mix_i64(h, c << opaque_shift_i64(65));
    h = fold.mix_i64(h, a << opaque_shift_i64(128));
    h = fold.mix_i64(h, a >> opaque_shift_i64(128));
    h = fold.mix_i64(h, b >> opaque_shift_i64(128));
    h = fold.mix_i64(h, c << opaque_shift_i64(128));
    h = fold.mix_i64(h, a << opaque_shift_i64(135));
    h = fold.mix_i64(h, a >> opaque_shift_i64(135));
    h = fold.mix_i64(h, b >> opaque_shift_i64(135));
    h = fold.mix_i64(h, c << opaque_shift_i64(135));
    h = fold.mix_i64(h, a << opaque_shift_i64(255));
    h = fold.mix_i64(h, a >> opaque_shift_i64(255));
    h = fold.mix_i64(h, b >> opaque_shift_i64(255));
    h = fold.mix_i64(h, c << opaque_shift_i64(255));

    # a seeded count that straddles the width, as a wider integer than u8
    var j: u64 = 0;
    for (j < 12) {
        val n: u64 = 58 + j + (seed & 3);
        h = fold.mix_i64(h, a << n);
        h = fold.mix_i64(h, a >> n);
        h = fold.mix_i64(h, b >> n);
        j = j + 1;
    }

    # a count masked below the width is in range by construction and takes the
    # bare shift, no saturation
    h = fold.mix_i64(h, a << (opaque_shift_i64(70) & 63));
    h = fold.mix_i64(h, b >> (opaque_shift_i64(255) & 63));

    ret h;
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    h = fold.mix_u64(h, shift_u8(seed));
    h = fold.mix_u64(h, shift_i8(seed));
    h = fold.mix_u64(h, shift_u16(seed));
    h = fold.mix_u64(h, shift_i16(seed));
    h = fold.mix_u64(h, shift_u32(seed));
    h = fold.mix_u64(h, shift_i32(seed));
    h = fold.mix_u64(h, shift_u64(seed));
    h = fold.mix_u64(h, shift_i64(seed));
    ret h;
}
