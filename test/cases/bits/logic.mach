# u32 and u64 bitwise and/or/xor/not over boundary patterns (0, ~0, alternating masks),
# one noinline part per width, folded in a fixed order.

use corpus.lib.fold;

# u32 bitwise and/or/xor/not over boundary patterns (0, ~0, alternating masks),
# every operand mixed with the opaque seed so the whole case cannot collapse to
# one constant.
#[noinline]
fun logic_u32(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: u32 = seed::u32;

    val zero: u32 = 0;
    val ones: u32 = 4294967295;
    val even: u32 = 2863311530;
    val odd:  u32 = 1431655765;

    var a: u32 = zero ^ s;
    var b: u32 = ones ^ s;
    var c: u32 = even ^ s;
    var d: u32 = odd ^ s;

    h = fold.mix_u32(h, a & b);
    h = fold.mix_u32(h, a | b);
    h = fold.mix_u32(h, a ^ b);
    h = fold.mix_u32(h, ~a);
    h = fold.mix_u32(h, ~b);
    h = fold.mix_u32(h, c & d);
    h = fold.mix_u32(h, c | d);
    h = fold.mix_u32(h, c ^ d);
    h = fold.mix_u32(h, ~c);
    h = fold.mix_u32(h, ~d);
    h = fold.mix_u32(h, a & c);
    h = fold.mix_u32(h, b | d);
    h = fold.mix_u32(h, a & d);
    h = fold.mix_u32(h, b | c);
    h = fold.mix_u32(h, (a & b) | (c ^ d));
    h = fold.mix_u32(h, ~(a | b));
    h = fold.mix_u32(h, ~(a & b));
    h = fold.mix_u32(h, ~(c ^ d));

    var i: u32 = 0;
    for (i < 8) {
        val p: u32 = a ^ i;
        val q: u32 = b | i;
        val r: u32 = c & (d ^ i);
        h = fold.mix_u32(h, p & q);
        h = fold.mix_u32(h, p | r);
        h = fold.mix_u32(h, ~(p ^ r));
        i = i + 1;
    }

    ret h;
}

# u64 bitwise and/or/xor/not over boundary patterns (0, ~0, alternating masks),
# every operand mixed with the opaque seed so the whole case cannot collapse to
# one constant.
#[noinline]
fun logic_u64(seed: u64) u64 {
    var h: u64 = fold.init();

    val zero: u64 = 0;
    val ones: u64 = 0xFFFFFFFFFFFFFFFF;
    val even: u64 = 0xAAAAAAAAAAAAAAAA;
    val odd:  u64 = 0x5555555555555555;

    var a: u64 = zero ^ seed;
    var b: u64 = ones ^ seed;
    var c: u64 = even ^ seed;
    var d: u64 = odd ^ seed;

    h = fold.mix_u64(h, a & b);
    h = fold.mix_u64(h, a | b);
    h = fold.mix_u64(h, a ^ b);
    h = fold.mix_u64(h, ~a);
    h = fold.mix_u64(h, ~b);
    h = fold.mix_u64(h, c & d);
    h = fold.mix_u64(h, c | d);
    h = fold.mix_u64(h, c ^ d);
    h = fold.mix_u64(h, ~c);
    h = fold.mix_u64(h, ~d);
    h = fold.mix_u64(h, a & c);
    h = fold.mix_u64(h, b | d);
    h = fold.mix_u64(h, a & d);
    h = fold.mix_u64(h, b | c);
    h = fold.mix_u64(h, (a & b) | (c ^ d));
    h = fold.mix_u64(h, ~(a | b));
    h = fold.mix_u64(h, ~(a & b));
    h = fold.mix_u64(h, ~(c ^ d));

    var i: u64 = 0;
    for (i < 8) {
        val p: u64 = a ^ i;
        val q: u64 = b | i;
        val r: u64 = c & (d ^ i);
        h = fold.mix_u64(h, p & q);
        h = fold.mix_u64(h, p | r);
        h = fold.mix_u64(h, ~(p ^ r));
        i = i + 1;
    }

    ret h;
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    h = fold.mix_u64(h, logic_u32(seed));
    h = fold.mix_u64(h, logic_u64(seed));
    ret h;
}
