# i32 shifts: << (raw bit shift, the same opcode the unsigned form uses) and >>
# (arithmetic, sign-preserving) at amounts 0, 1, w-1, and past the masking
# boundary (w, w+1, 2w-1), where mach's defined shift masks the count to width
# bits rather than treating an out-of-range count as undefined. boundary
# operands include -1 (all ones) and the alternating masks in their signed
# two's-complement form. both an immediate count and an opaque (register)
# count flow through.

use corpus.lib.fold;

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val s:  i32 = seed::i32;
    val su: u32 = seed::u32;

    val zero: i32 = 0;
    val neg1: i32 = -1;
    val even: i32 = -1431655766;
    val odd:  i32 = 1431655765;

    var a: i32 = neg1 ^ s;
    var b: i32 = even ^ s;
    var c: i32 = odd ^ s;
    var z: i32 = zero ^ s;

    h = fold.mix_i32(h, a << 0);
    h = fold.mix_i32(h, a << 1);
    h = fold.mix_i32(h, a << 31);
    h = fold.mix_i32(h, a >> 0);
    h = fold.mix_i32(h, a >> 1);
    h = fold.mix_i32(h, a >> 31);
    h = fold.mix_i32(h, b << 1);
    h = fold.mix_i32(h, b >> 1);
    h = fold.mix_i32(h, b >> 31);
    h = fold.mix_i32(h, c << 1);
    h = fold.mix_i32(h, c >> 1);
    h = fold.mix_i32(h, z << 5);
    h = fold.mix_i32(h, z >> 5);

    # masking boundary: an immediate count >= width folds to count mod width
    h = fold.mix_i32(h, a << 32);
    h = fold.mix_i32(h, a >> 32);
    h = fold.mix_i32(h, a << 33);
    h = fold.mix_i32(h, a >> 33);
    h = fold.mix_i32(h, a << 63);
    h = fold.mix_i32(h, a >> 63);
    h = fold.mix_i32(h, b << 32);
    h = fold.mix_i32(h, b >> 63);

    # opaque (register) count, the variable-shift encoding path
    var i: u32 = 0;
    for (i < 32) {
        h = fold.mix_i32(h, a << i);
        h = fold.mix_i32(h, a >> i);
        h = fold.mix_i32(h, b << (i + su));
        h = fold.mix_i32(h, c >> (i + su));
        i = i + 1;
    }

    # an opaque count that straddles the masking boundary
    var j: u32 = 30;
    for (j < 40) {
        h = fold.mix_i32(h, a << (j + su));
        h = fold.mix_i32(h, a >> (j + su));
        j = j + 1;
    }

    ret h;
}
