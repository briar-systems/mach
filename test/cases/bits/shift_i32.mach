# i32 shifts: << and >> (arithmetic, sign-filling) at counts 0, 1 and w-1, then
# counts at and past the width, which saturate: a count at or above 32
# answers 0 for << and a logical >>, and the sign fill for an arithmetic >>
# (#3756). a constant count at or above the width is a compile error, so every
# saturating count here is opaque: it comes through a noinline call.

use corpus.lib.fold;

#[noinline]
fun opaque(n: u8) u8 { ret n; }

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: i32 = seed::i32;

    val zero: i32 = 0;
    val neg1: i32 = -1;
    val even: i32 = -1431655766;
    val odd:  i32 = 1431655765;

    var a: i32 = neg1 ^ s;
    var b: i32 = even ^ s;
    var c: i32 = odd ^ s;
    var z: i32 = zero ^ s;

    h = fold.mix_i32(h, a << 0);
    h = fold.mix_i32(h, a << 1);
    h = fold.mix_i32(h, a << 31);
    h = fold.mix_i32(h, a >> 0);
    h = fold.mix_i32(h, a >> 1);
    h = fold.mix_i32(h, a >> 31);
    h = fold.mix_i32(h, b << 1);
    h = fold.mix_i32(h, b >> 1);
    h = fold.mix_i32(h, b >> 31);
    h = fold.mix_i32(h, c << 1);
    h = fold.mix_i32(h, c >> 1);
    h = fold.mix_i32(h, z << 5);
    h = fold.mix_i32(h, z >> 5);

    # the register count path, every count below the width
    var i: u8 = 0;
    for (i < 32) {
        h = fold.mix_i32(h, a << i);
        h = fold.mix_i32(h, a >> i);
        h = fold.mix_i32(h, b << i);
        h = fold.mix_i32(h, c >> i);
        i = i + 1;
    }

    # opaque counts at and past the width (31, 32, 33, 64, 71, 255) saturate
    h = fold.mix_i32(h, a << opaque(31));
    h = fold.mix_i32(h, a >> opaque(31));
    h = fold.mix_i32(h, b >> opaque(31));
    h = fold.mix_i32(h, c << opaque(31));
    h = fold.mix_i32(h, a << opaque(32));
    h = fold.mix_i32(h, a >> opaque(32));
    h = fold.mix_i32(h, b >> opaque(32));
    h = fold.mix_i32(h, c << opaque(32));
    h = fold.mix_i32(h, a << opaque(33));
    h = fold.mix_i32(h, a >> opaque(33));
    h = fold.mix_i32(h, b >> opaque(33));
    h = fold.mix_i32(h, c << opaque(33));
    h = fold.mix_i32(h, a << opaque(64));
    h = fold.mix_i32(h, a >> opaque(64));
    h = fold.mix_i32(h, b >> opaque(64));
    h = fold.mix_i32(h, c << opaque(64));
    h = fold.mix_i32(h, a << opaque(71));
    h = fold.mix_i32(h, a >> opaque(71));
    h = fold.mix_i32(h, b >> opaque(71));
    h = fold.mix_i32(h, c << opaque(71));
    h = fold.mix_i32(h, a << opaque(255));
    h = fold.mix_i32(h, a >> opaque(255));
    h = fold.mix_i32(h, b >> opaque(255));
    h = fold.mix_i32(h, c << opaque(255));

    # a seeded count that straddles the width, as a wider integer than u8
    var j: u64 = 0;
    for (j < 12) {
        val n: u64 = 26 + j + (seed & 3);
        h = fold.mix_i32(h, a << n);
        h = fold.mix_i32(h, a >> n);
        h = fold.mix_i32(h, b >> n);
        j = j + 1;
    }

    ret h;
}
