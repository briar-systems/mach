# u8 shifts: << and >> (logical, zero-filling) at counts 0, 1 and w-1, then
# counts at and past the width, which saturate: a count at or above 8
# answers 0 for << and a logical >>, and the sign fill for an arithmetic >>
# (#3756). a constant count at or above the width is a compile error, so every
# saturating count here is opaque: it comes through a noinline call.

use corpus.lib.fold;

#[noinline]
fun opaque(n: u8) u8 { ret n; }

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: u8 = seed::u8;

    val zero: u8 = 0;
    val ones: u8 = 255;
    val even: u8 = 170;
    val odd:  u8 = 85;

    var a: u8 = ones ^ s;
    var b: u8 = even ^ s;
    var c: u8 = odd ^ s;
    var z: u8 = zero ^ s;

    h = fold.mix_u8(h, a << 0);
    h = fold.mix_u8(h, a << 1);
    h = fold.mix_u8(h, a << 7);
    h = fold.mix_u8(h, a >> 0);
    h = fold.mix_u8(h, a >> 1);
    h = fold.mix_u8(h, a >> 7);
    h = fold.mix_u8(h, b << 1);
    h = fold.mix_u8(h, b >> 1);
    h = fold.mix_u8(h, b >> 7);
    h = fold.mix_u8(h, c << 1);
    h = fold.mix_u8(h, c >> 1);
    h = fold.mix_u8(h, z << 5);
    h = fold.mix_u8(h, z >> 5);

    # the register count path, every count below the width
    var i: u8 = 0;
    for (i < 8) {
        h = fold.mix_u8(h, a << i);
        h = fold.mix_u8(h, a >> i);
        h = fold.mix_u8(h, b << i);
        h = fold.mix_u8(h, c >> i);
        i = i + 1;
    }

    # opaque counts at and past the width (7, 8, 9, 16, 23, 255) saturate
    h = fold.mix_u8(h, a << opaque(7));
    h = fold.mix_u8(h, a >> opaque(7));
    h = fold.mix_u8(h, b >> opaque(7));
    h = fold.mix_u8(h, c << opaque(7));
    h = fold.mix_u8(h, a << opaque(8));
    h = fold.mix_u8(h, a >> opaque(8));
    h = fold.mix_u8(h, b >> opaque(8));
    h = fold.mix_u8(h, c << opaque(8));
    h = fold.mix_u8(h, a << opaque(9));
    h = fold.mix_u8(h, a >> opaque(9));
    h = fold.mix_u8(h, b >> opaque(9));
    h = fold.mix_u8(h, c << opaque(9));
    h = fold.mix_u8(h, a << opaque(16));
    h = fold.mix_u8(h, a >> opaque(16));
    h = fold.mix_u8(h, b >> opaque(16));
    h = fold.mix_u8(h, c << opaque(16));
    h = fold.mix_u8(h, a << opaque(23));
    h = fold.mix_u8(h, a >> opaque(23));
    h = fold.mix_u8(h, b >> opaque(23));
    h = fold.mix_u8(h, c << opaque(23));
    h = fold.mix_u8(h, a << opaque(255));
    h = fold.mix_u8(h, a >> opaque(255));
    h = fold.mix_u8(h, b >> opaque(255));
    h = fold.mix_u8(h, c << opaque(255));

    # 33 wraps the 32-bit alu count to 1, which only the saturation answers as 0
    # or the sign fill rather than a shift by one
    h = fold.mix_u8(h, a << opaque(33));
    h = fold.mix_u8(h, a >> opaque(33));
    h = fold.mix_u8(h, b >> opaque(33));
    h = fold.mix_u8(h, c << opaque(33));

    # a seeded count that straddles the width, as a wider integer than u8
    var j: u64 = 0;
    for (j < 12) {
        val n: u64 = 2 + j + (seed & 3);
        h = fold.mix_u8(h, a << n);
        h = fold.mix_u8(h, a >> n);
        h = fold.mix_u8(h, b >> n);
        j = j + 1;
    }

    ret h;
}
