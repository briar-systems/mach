# shifts by counts the range analysis proves below the width, which lower to
# the bare machine shift, beside the same shapes run to and past the width,
# which keep the saturation (#3885, #3756): a loop counter under its guard, an
# inclusive guard, a signed counter, a narrow counter, an if around the shift
# and its failing arm, the differences `63 - bit` and `127 - bit` under both
# arms of `bit < 64`, and the load and unload steps of a bitsliced cipher
# whose bit-plane position is proven with no runtime term and unproven with
# one. every unproven count here reaches the width, so a saturation that is
# dropped where it must stay changes the checksum.

use corpus.lib.fold;

#[noinline]
fun opaque(n: u64) u64 { ret n; }

fun below_width(h0: u64, a: u64) u64 {
    var h: u64 = h0;
    var i: u64 = 0;
    for (i < 64) {
        h = fold.mix_u64(h, (a >> i) ^ (a << i));
        i = i + 1;
    }
    var j: u64 = 0;
    for (j <= 63) {
        h = fold.mix_u64(h, a << j);
        j = j + 1;
    }
    var k: i64 = 0;
    for (k < 64) {
        h = fold.mix_i64(h, a:~i64 >> k);
        k = k + 1;
    }
    var n: u8 = 0;
    for (n < 32) {
        h = fold.mix_u32(h, a::u32 << n);
        n = n + 1;
    }
    ret h;
}

fun past_width(h0: u64, a: u64, top: u64) u64 {
    var h: u64 = h0;
    var i: u64 = 0;
    for (i < top) {
        h = fold.mix_u64(h, (a >> i) ^ (a << i));
        h = fold.mix_i64(h, a:~i64 >> i);
        h = fold.mix_u32(h, a::u32 << i);
        i = i + 1;
    }
    var j: u64 = 0;
    for (j <= 64) {
        h = fold.mix_u64(h, a << j);
        j = j + 1;
    }
    var n: u8 = 0;
    for (n < 40) {
        h = fold.mix_u32(h, a::u32 >> n);
        n = n + 1;
    }
    ret h;
}

fun guarded(h0: u64, a: u64, n: u64) u64 {
    var h: u64 = h0;
    if (n < 64) { h = fold.mix_u64(h, a << n); }
    if (n >= 64) { h = fold.mix_u64(h, 1); }
    or           { h = fold.mix_u64(h, a >> n); }
    h = fold.mix_u64(h, a << n);
    ret h;
}

fun differences(h0: u64, a: u64) u64 {
    var h:   u64 = h0;
    var bit: u64 = 0;
    for (bit < 128) {
        if (bit < 64) { h = fold.mix_u64(h, (a >> (63 - bit)) & 1); }
        or            { h = fold.mix_u64(h, (a >> (127 - bit)) & 1); }
        bit = bit + 1;
    }
    ret h;
}

# the bit-plane transpose of 16 bytes into eight planes and back, one block
# at `block`: position is below 64 from the loop guards alone when block is
# 0, and needs the runtime block otherwise
fun transpose(h0: u64, seed: u64, block: u64) u64 {
    var h:     u64 = h0;
    var q:     [8]u64;
    var input: [16]u8;
    var p: u64 = 0;
    for (p < 8) {
        q[p] = 0;
        p    = p + 1;
    }
    var i: u64 = 0;
    for (i < 16) {
        input[i] = (seed * 37 + i * 11)::u8;
        i        = i + 1;
    }
    i = 0;
    for (i < 16) {
        val byte:     u64 = input[i]::u64;
        val position: u64 = (i & 3) * 16 + (i >> 2) * 4 + block;
        var plane:    u64 = 0;
        for (plane < 8) {
            q[plane] = q[plane] | (((byte >> plane) & 1) << position);
            plane    = plane + 1;
        }
        i = i + 1;
    }
    p = 0;
    for (p < 8) {
        h = fold.mix_u64(h, q[p]);
        p = p + 1;
    }
    i = 0;
    for (i < 16) {
        val position: u64 = (i & 3) * 16 + (i >> 2) * 4 + block;
        var byte:     u8  = 0;
        var plane:    u64 = 0;
        for (plane < 8) {
            byte  = byte | (((q[plane] >> position) & 1)::u8 << plane);
            plane = plane + 1;
        }
        h = fold.mix_u8(h, byte);
        i = i + 1;
    }
    ret h;
}

fun transpose_first(h0: u64, seed: u64) u64 {
    var h:     u64 = h0;
    var q:     [8]u64;
    var p:     u64 = 0;
    for (p < 8) {
        q[p] = 0;
        p    = p + 1;
    }
    var i: u64 = 0;
    for (i < 16) {
        val byte:     u64 = (seed * 37 + i * 11) & 255;
        val position: u64 = (i & 3) * 16 + (i >> 2) * 4;
        var plane:    u64 = 0;
        for (plane < 8) {
            q[plane] = q[plane] | (((byte >> plane) & 1) << position);
            plane    = plane + 1;
        }
        i = i + 1;
    }
    p = 0;
    for (p < 8) {
        h = fold.mix_u64(h, q[p]);
        p = p + 1;
    }
    ret h;
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val a: u64 = 0x9E3779B97F4A7C15 ^ seed;
    val b: u64 = 0x8000000000000001 ^ (seed << 7);

    h = below_width(h, a);
    h = below_width(h, b);
    h = past_width(h, a, opaque(72));
    h = past_width(h, b, opaque(64));
    h = guarded(h, a, opaque(5));
    h = guarded(h, a, opaque(63));
    h = guarded(h, a, opaque(64));
    h = guarded(h, b, opaque(200));
    h = differences(h, a);
    h = differences(h, b);
    h = transpose_first(h, seed);
    h = transpose(h, seed, opaque(0));
    h = transpose(h, seed, opaque(3));
    h = transpose(h, seed, opaque(4));
    h = transpose(h, seed, opaque(9));
    ret h;
}
