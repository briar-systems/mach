# u64 shifts: << and >> (logical, zero-filling) at amounts 0, 1, w-1, and past
# the masking boundary (w, w+1, 2w-1), where mach's defined shift masks the
# count to width bits rather than treating an out-of-range count as undefined.
# both an immediate count and an opaque (register) count flow through.

use corpus.lib.fold;

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();

    val zero: u64 = 0;
    val ones: u64 = 0xFFFFFFFFFFFFFFFF;
    val even: u64 = 0xAAAAAAAAAAAAAAAA;
    val odd:  u64 = 0x5555555555555555;

    var a: u64 = ones ^ seed;
    var b: u64 = even ^ seed;
    var c: u64 = odd ^ seed;
    var z: u64 = zero ^ seed;

    h = fold.mix_u64(h, a << 0);
    h = fold.mix_u64(h, a << 1);
    h = fold.mix_u64(h, a << 63);
    h = fold.mix_u64(h, a >> 0);
    h = fold.mix_u64(h, a >> 1);
    h = fold.mix_u64(h, a >> 63);
    h = fold.mix_u64(h, b << 1);
    h = fold.mix_u64(h, b >> 1);
    h = fold.mix_u64(h, c << 1);
    h = fold.mix_u64(h, c >> 1);
    h = fold.mix_u64(h, z << 5);
    h = fold.mix_u64(h, z >> 5);

    # masking boundary: an immediate count >= width folds to count mod width
    h = fold.mix_u64(h, a << 64);
    h = fold.mix_u64(h, a >> 64);
    h = fold.mix_u64(h, a << 65);
    h = fold.mix_u64(h, a >> 65);
    h = fold.mix_u64(h, a << 127);
    h = fold.mix_u64(h, a >> 127);
    h = fold.mix_u64(h, b << 64);
    h = fold.mix_u64(h, b >> 127);

    # opaque (register) count, the variable-shift encoding path
    var i: u64 = 0;
    for (i < 64) {
        h = fold.mix_u64(h, a << i);
        h = fold.mix_u64(h, a >> i);
        h = fold.mix_u64(h, b << (i + seed));
        h = fold.mix_u64(h, c >> (i + seed));
        i = i + 1;
    }

    # an opaque count that straddles the masking boundary
    var j: u64 = 60;
    for (j < 72) {
        h = fold.mix_u64(h, a << (j + seed));
        h = fold.mix_u64(h, a >> (j + seed));
        j = j + 1;
    }

    ret h;
}
