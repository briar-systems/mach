# i64 shifts: << and >> (arithmetic, sign-filling) at counts 0, 1 and w-1, then
# counts at and past the width, which saturate: a count at or above 64
# answers 0 for << and a logical >>, and the sign fill for an arithmetic >>
# (#3756). a constant count at or above the width is a compile error, so every
# saturating count here is opaque: it comes through a noinline call.

use corpus.lib.fold;

#[noinline]
fun opaque(n: u8) u8 { ret n; }

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: i64 = seed::i64;

    val zero: i64 = 0;
    val neg1: i64 = -1;
    val even: i64 = -6148914691236517206;
    val odd:  i64 = 6148914691236517205;

    var a: i64 = neg1 ^ s;
    var b: i64 = even ^ s;
    var c: i64 = odd ^ s;
    var z: i64 = zero ^ s;

    h = fold.mix_i64(h, a << 0);
    h = fold.mix_i64(h, a << 1);
    h = fold.mix_i64(h, a << 63);
    h = fold.mix_i64(h, a >> 0);
    h = fold.mix_i64(h, a >> 1);
    h = fold.mix_i64(h, a >> 63);
    h = fold.mix_i64(h, b << 1);
    h = fold.mix_i64(h, b >> 1);
    h = fold.mix_i64(h, b >> 63);
    h = fold.mix_i64(h, c << 1);
    h = fold.mix_i64(h, c >> 1);
    h = fold.mix_i64(h, z << 5);
    h = fold.mix_i64(h, z >> 5);

    # the register count path, every count below the width
    var i: u8 = 0;
    for (i < 64) {
        h = fold.mix_i64(h, a << i);
        h = fold.mix_i64(h, a >> i);
        h = fold.mix_i64(h, b << i);
        h = fold.mix_i64(h, c >> i);
        i = i + 1;
    }

    # opaque counts at and past the width (63, 64, 65, 128, 135, 255) saturate
    h = fold.mix_i64(h, a << opaque(63));
    h = fold.mix_i64(h, a >> opaque(63));
    h = fold.mix_i64(h, b >> opaque(63));
    h = fold.mix_i64(h, c << opaque(63));
    h = fold.mix_i64(h, a << opaque(64));
    h = fold.mix_i64(h, a >> opaque(64));
    h = fold.mix_i64(h, b >> opaque(64));
    h = fold.mix_i64(h, c << opaque(64));
    h = fold.mix_i64(h, a << opaque(65));
    h = fold.mix_i64(h, a >> opaque(65));
    h = fold.mix_i64(h, b >> opaque(65));
    h = fold.mix_i64(h, c << opaque(65));
    h = fold.mix_i64(h, a << opaque(128));
    h = fold.mix_i64(h, a >> opaque(128));
    h = fold.mix_i64(h, b >> opaque(128));
    h = fold.mix_i64(h, c << opaque(128));
    h = fold.mix_i64(h, a << opaque(135));
    h = fold.mix_i64(h, a >> opaque(135));
    h = fold.mix_i64(h, b >> opaque(135));
    h = fold.mix_i64(h, c << opaque(135));
    h = fold.mix_i64(h, a << opaque(255));
    h = fold.mix_i64(h, a >> opaque(255));
    h = fold.mix_i64(h, b >> opaque(255));
    h = fold.mix_i64(h, c << opaque(255));

    # a seeded count that straddles the width, as a wider integer than u8
    var j: u64 = 0;
    for (j < 12) {
        val n: u64 = 58 + j + (seed & 3);
        h = fold.mix_i64(h, a << n);
        h = fold.mix_i64(h, a >> n);
        h = fold.mix_i64(h, b >> n);
        j = j + 1;
    }

    ret h;
}
