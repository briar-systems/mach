# i64 shifts: << (raw bit shift, the same opcode the unsigned form uses) and >>
# (arithmetic, sign-preserving) at amounts 0, 1, w-1, and past the masking
# boundary (w, w+1, 2w-1), where mach's defined shift masks the count to width
# bits rather than treating an out-of-range count as undefined. boundary
# operands include -1 (all ones) and the alternating masks in their signed
# two's-complement form. both an immediate count and an opaque (register)
# count flow through.

use corpus.lib.fold;

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: i64 = seed::i64;

    val zero: i64 = 0;
    val neg1: i64 = -1;
    val even: i64 = -6148914691236517206;
    val odd:  i64 = 6148914691236517205;

    var a: i64 = neg1 ^ s;
    var b: i64 = even ^ s;
    var c: i64 = odd ^ s;
    var z: i64 = zero ^ s;

    h = fold.mix_i64(h, a << 0);
    h = fold.mix_i64(h, a << 1);
    h = fold.mix_i64(h, a << 63);
    h = fold.mix_i64(h, a >> 0);
    h = fold.mix_i64(h, a >> 1);
    h = fold.mix_i64(h, a >> 63);
    h = fold.mix_i64(h, b << 1);
    h = fold.mix_i64(h, b >> 1);
    h = fold.mix_i64(h, b >> 63);
    h = fold.mix_i64(h, c << 1);
    h = fold.mix_i64(h, c >> 1);
    h = fold.mix_i64(h, z << 5);
    h = fold.mix_i64(h, z >> 5);

    # masking boundary: an immediate count >= width folds to count mod width
    h = fold.mix_i64(h, a << 64);
    h = fold.mix_i64(h, a >> 64);
    h = fold.mix_i64(h, a << 65);
    h = fold.mix_i64(h, a >> 65);
    h = fold.mix_i64(h, a << 127);
    h = fold.mix_i64(h, a >> 127);
    h = fold.mix_i64(h, b << 64);
    h = fold.mix_i64(h, b >> 127);

    # opaque (register) count, the variable-shift encoding path
    var i: u64 = 0;
    for (i < 64) {
        h = fold.mix_i64(h, a << i);
        h = fold.mix_i64(h, a >> i);
        h = fold.mix_i64(h, b << (i + seed));
        h = fold.mix_i64(h, c >> (i + seed));
        i = i + 1;
    }

    # an opaque count that straddles the masking boundary
    var j: u64 = 60;
    for (j < 72) {
        h = fold.mix_i64(h, a << (j + seed));
        h = fold.mix_i64(h, a >> (j + seed));
        j = j + 1;
    }

    ret h;
}
