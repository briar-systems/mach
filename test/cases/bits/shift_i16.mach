# i16 shifts: << and >> (arithmetic, sign-filling) at counts 0, 1 and w-1, then
# counts at and past the width, which saturate: a count at or above 16
# answers 0 for << and a logical >>, and the sign fill for an arithmetic >>
# (#3756). a constant count at or above the width is a compile error, so every
# saturating count here is opaque: it comes through a noinline call.

use corpus.lib.fold;

#[noinline]
fun opaque(n: u8) u8 { ret n; }

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: i16 = seed::i16;

    val zero: i16 = 0;
    val neg1: i16 = -1;
    val even: i16 = -21846;
    val odd:  i16 = 21845;

    var a: i16 = neg1 ^ s;
    var b: i16 = even ^ s;
    var c: i16 = odd ^ s;
    var z: i16 = zero ^ s;

    h = fold.mix_i16(h, a << 0);
    h = fold.mix_i16(h, a << 1);
    h = fold.mix_i16(h, a << 15);
    h = fold.mix_i16(h, a >> 0);
    h = fold.mix_i16(h, a >> 1);
    h = fold.mix_i16(h, a >> 15);
    h = fold.mix_i16(h, b << 1);
    h = fold.mix_i16(h, b >> 1);
    h = fold.mix_i16(h, b >> 15);
    h = fold.mix_i16(h, c << 1);
    h = fold.mix_i16(h, c >> 1);
    h = fold.mix_i16(h, z << 5);
    h = fold.mix_i16(h, z >> 5);

    # the register count path, every count below the width
    var i: u8 = 0;
    for (i < 16) {
        h = fold.mix_i16(h, a << i);
        h = fold.mix_i16(h, a >> i);
        h = fold.mix_i16(h, b << i);
        h = fold.mix_i16(h, c >> i);
        i = i + 1;
    }

    # opaque counts at and past the width (15, 16, 17, 32, 39, 255) saturate
    h = fold.mix_i16(h, a << opaque(15));
    h = fold.mix_i16(h, a >> opaque(15));
    h = fold.mix_i16(h, b >> opaque(15));
    h = fold.mix_i16(h, c << opaque(15));
    h = fold.mix_i16(h, a << opaque(16));
    h = fold.mix_i16(h, a >> opaque(16));
    h = fold.mix_i16(h, b >> opaque(16));
    h = fold.mix_i16(h, c << opaque(16));
    h = fold.mix_i16(h, a << opaque(17));
    h = fold.mix_i16(h, a >> opaque(17));
    h = fold.mix_i16(h, b >> opaque(17));
    h = fold.mix_i16(h, c << opaque(17));
    h = fold.mix_i16(h, a << opaque(32));
    h = fold.mix_i16(h, a >> opaque(32));
    h = fold.mix_i16(h, b >> opaque(32));
    h = fold.mix_i16(h, c << opaque(32));
    h = fold.mix_i16(h, a << opaque(39));
    h = fold.mix_i16(h, a >> opaque(39));
    h = fold.mix_i16(h, b >> opaque(39));
    h = fold.mix_i16(h, c << opaque(39));
    h = fold.mix_i16(h, a << opaque(255));
    h = fold.mix_i16(h, a >> opaque(255));
    h = fold.mix_i16(h, b >> opaque(255));
    h = fold.mix_i16(h, c << opaque(255));

    # 33 wraps the 32-bit alu count to 1, which only the saturation answers as 0
    # or the sign fill rather than a shift by one
    h = fold.mix_i16(h, a << opaque(33));
    h = fold.mix_i16(h, a >> opaque(33));
    h = fold.mix_i16(h, b >> opaque(33));
    h = fold.mix_i16(h, c << opaque(33));

    # a seeded count that straddles the width, as a wider integer than u8
    var j: u64 = 0;
    for (j < 12) {
        val n: u64 = 10 + j + (seed & 3);
        h = fold.mix_i16(h, a << n);
        h = fold.mix_i16(h, a >> n);
        h = fold.mix_i16(h, b >> n);
        j = j + 1;
    }

    ret h;
}
