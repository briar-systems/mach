# u32 shifts: << and >> (logical, zero-filling) at amounts 0, 1, w-1, and past
# the masking boundary (w, w+1, 2w-1), where mach's defined shift masks the
# count to width bits rather than treating an out-of-range count as undefined.
# both an immediate count and an opaque (register) count flow through.

use corpus.lib.fold;

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: u32 = seed::u32;

    val zero: u32 = 0;
    val ones: u32 = 4294967295;
    val even: u32 = 2863311530;
    val odd:  u32 = 1431655765;

    var a: u32 = ones ^ s;
    var b: u32 = even ^ s;
    var c: u32 = odd ^ s;
    var z: u32 = zero ^ s;

    h = fold.mix_u32(h, a << 0);
    h = fold.mix_u32(h, a << 1);
    h = fold.mix_u32(h, a << 31);
    h = fold.mix_u32(h, a >> 0);
    h = fold.mix_u32(h, a >> 1);
    h = fold.mix_u32(h, a >> 31);
    h = fold.mix_u32(h, b << 1);
    h = fold.mix_u32(h, b >> 1);
    h = fold.mix_u32(h, c << 1);
    h = fold.mix_u32(h, c >> 1);
    h = fold.mix_u32(h, z << 5);
    h = fold.mix_u32(h, z >> 5);

    # masking boundary: an immediate count >= width folds to count mod width
    h = fold.mix_u32(h, a << 32);
    h = fold.mix_u32(h, a >> 32);
    h = fold.mix_u32(h, a << 33);
    h = fold.mix_u32(h, a >> 33);
    h = fold.mix_u32(h, a << 63);
    h = fold.mix_u32(h, a >> 63);
    h = fold.mix_u32(h, b << 32);
    h = fold.mix_u32(h, b >> 63);

    # opaque (register) count, the variable-shift encoding path
    var i: u32 = 0;
    for (i < 32) {
        h = fold.mix_u32(h, a << i);
        h = fold.mix_u32(h, a >> i);
        h = fold.mix_u32(h, b << (i + s));
        h = fold.mix_u32(h, c >> (i + s));
        i = i + 1;
    }

    # an opaque count that straddles the masking boundary
    var j: u32 = 30;
    for (j < 40) {
        h = fold.mix_u32(h, a << (j + s));
        h = fold.mix_u32(h, a >> (j + s));
        j = j + 1;
    }

    ret h;
}
