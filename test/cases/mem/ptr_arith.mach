# pointers derived from array elements and record fields, then indexed forward and
# backward. every derived pointer stays inside the object it came from and every
# dereference goes through the type the storage was declared with, so the C
# translation is defined and a disagreement is mach's. addresses are never folded:
# what is folded is what the pointer reaches and how two pointers relate.

use corpus.lib.fold;

rec Cell {
    tag: u16;
    a: u8;
    v: u64;
}

rec Holder {
    pre: u32;
    xs: [8]u32;
    post: u32;
}

fun fold_cell(h: u64, c: Cell) u64 {
    var x: u64 = fold.mix_u16(h, c.tag);
    x = fold.mix_u8(x, c.a);
    x = fold.mix_u64(x, c.v);
    ret x;
}

fun bump(p: *u32, n: u64) {
    var i: u64 = 0;
    for (i < n) {
        p[i] = p[i] + i::u32 + 1;
        i = i + 1;
    }
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: u64 = seed;

    var flat: [16]u32;
    var i: u64 = 0;
    for (i < 16) {
        flat[i] = (2654435761 * (i + 1) + s)::u32;
        i = i + 1;
    }

    val base: *u32 = ?flat[0];
    val mid: *u32 = ?flat[8];

    i = 0;
    for (i < 16) {
        h = fold.mix_u32(h, base[i]);
        i = i + 1;
    }

    # an interior pointer indexed in both directions, covering the whole array from
    # the middle out
    var d: i64 = 0 - 8;
    for (d < 8) {
        h = fold.mix_u32(h, mid[d]);
        d = d + 1;
    }
    h = fold.mix_u32(h, @mid);
    h = fold.mix_u32(h, mid[0 - 1]);
    h = fold.mix_u32(h, mid[7]);

    # a write through a derived pointer, read back through the array name
    bump(mid, 8);
    i = 0;
    for (i < 16) {
        h = fold.mix_u32(h, flat[i]);
        i = i + 1;
    }

    # two pointers to one element: a write through either is visible through both
    val al: *u32 = ?flat[5];
    val bl: *u32 = ?flat[5];
    @al = @al ^ 4042322160;
    h = fold.mix_u32(h, @bl);
    @bl = @bl + 3;
    h = fold.mix_u32(h, @al);
    h = fold.mix_u32(h, flat[5]);

    # how two pointers into one array relate is deterministic, unlike either address
    h = fold.mix_u8(h, (al == bl)::u8);
    h = fold.mix_u8(h, (al == base)::u8);
    h = fold.mix_u8(h, (base == nil)::u8);
    h = fold.mix_u8(h, (mid != base)::u8);

    # a pointer over an element type whose size is not a power of two
    var cells: [6]Cell;
    var k: u64 = 0;
    for (k < 6) {
        cells[k].tag = (k * 5 + 1 + s)::u16;
        cells[k].a = (k + 100)::u8;
        cells[k].v = 1099511628211 * (k + 1) + s;
        k = k + 1;
    }
    val cp: *Cell = ?cells[2];
    var e: i64 = 0 - 2;
    for (e < 4) {
        h = fold_cell(h, cp[e]);
        e = e + 1;
    }
    cp[1].v = cp[1].v + 17;
    cp[0 - 1].tag = cp[0 - 1].tag + 9;
    k = 0;
    for (k < 6) {
        h = fold_cell(h, cells[k]);
        k = k + 1;
    }

    # a pointer to one field of one element, and a pointer to a whole element
    val vp: *u64 = ?cells[4].v;
    @vp = @vp * 3;
    h = fold.mix_u64(h, cells[4].v);
    val tp: *u16 = ?cells[0].tag;
    @tp = @tp + 1;
    h = fold.mix_u16(h, cells[0].tag);

    # a pointer into an array that sits behind a field offset
    var hold: Holder;
    hold.pre = 305419896 + s::u32;
    hold.post = 2596069104 + s::u32;
    k = 0;
    for (k < 8) {
        hold.xs[k] = (k::u32 * 7 + 3) + s::u32;
        k = k + 1;
    }
    val xp: *u32 = ?hold.xs[3];
    var g: i64 = 0 - 3;
    for (g < 5) {
        h = fold.mix_u32(h, xp[g]);
        g = g + 1;
    }
    bump(?hold.xs[0], 8);
    h = fold.mix_u32(h, hold.pre);
    k = 0;
    for (k < 8) {
        h = fold.mix_u32(h, hold.xs[k]);
        k = k + 1;
    }
    h = fold.mix_u32(h, hold.post);
    ret h;
}
