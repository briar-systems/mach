# a whole-record assignment between places that overlap reads every source byte
# before it is overwritten, whichever way they overlap and whatever the size. the
# statement's value is unused, so the copy runs source to destination with no
# snapshot between them (#4235): below, above and onto its own source, for a
# record copied by a loop, one copied piecewise and a byte-aligned one whose
# length leaves a tail.

use corpus.lib.fold;

rec Wide  { w: [96]u64; }
rec Small { b: [40]u8; }
rec Odd   { b: [203]u8; }

fun fold_words(h: u64, p: *u64, n: u64) u64 {
    var a: u64 = h;
    var i: u64 = 0;
    for (i < n) {
        a = fold.mix_u64(a, p[i]);
        i = i + 1;
    }
    ret a;
}

fun fold_bytes(h: u64, p: *u8, n: u64) u64 {
    var a: u64 = h;
    var i: u64 = 0;
    for (i < n) {
        a = fold.mix_u8(a, p[i]);
        i = i + 1;
    }
    ret a;
}

fun wide_at(p: *u64, i: u64) *Wide {
    ret (?p[i])::*Wide;
}

fun small_at(p: *u8, i: u64) *Small {
    ret (?p[i])::*Small;
}

fun odd_at(p: *u8, i: u64) *Odd {
    ret (?p[i])::*Odd;
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: u64 = seed;
    val k: u64 = s & 3;

    var words: [256]u64;
    var i:     u64 = 0;
    for (i < 256) {
        words[i] = (i * 6364136223846793005) ^ s;
        i        = i + 1;
    }
    val wp: *u64 = ?words[0];

    val to0:   *Wide = wide_at(wp, 10);
    val from0: *Wide = wide_at(wp, 13 + k);
    @to0 = @from0;
    h    = fold_words(h, wp, 256);
    val to1:   *Wide = wide_at(wp, 40 + k);
    val from1: *Wide = wide_at(wp, 1);
    @to1 = @from1;
    h    = fold_words(h, wp, 256);
    val to2:   *Wide = wide_at(wp, 7);
    val from2: *Wide = wide_at(wp, 7);
    @to2 = @from2;
    h    = fold_words(h, wp, 256);

    var bytes: [512]u8;
    i = 0;
    for (i < 512) {
        bytes[i] = ((i * 131) + s)::u8;
        i        = i + 1;
    }
    val bp: *u8 = ?bytes[0];

    val to3:   *Small = small_at(bp, 3);
    val from3: *Small = small_at(bp, 11 + k);
    @to3 = @from3;
    h    = fold_bytes(h, bp, 512);
    val to4:   *Small = small_at(bp, 29 + k);
    val from4: *Small = small_at(bp, 5);
    @to4 = @from4;
    h    = fold_bytes(h, bp, 512);
    val to5:   *Odd = odd_at(bp, 101);
    val from5: *Odd = odd_at(bp, 150 + k);
    @to5 = @from5;
    h    = fold_bytes(h, bp, 512);
    val to6:   *Odd = odd_at(bp, 200 + k);
    val from6: *Odd = odd_at(bp, 97);
    @to6 = @from6;
    h    = fold_bytes(h, bp, 512);
    val to7:   *Odd = odd_at(bp, 61);
    val from7: *Odd = odd_at(bp, 61);
    @to7 = @from7;
    h    = fold_bytes(h, bp, 512);
    ret h;
}
