# the addressing forms a backend folds an index into: every element scale it has a
# shift for, one it does not, a field offset added on top of a scaled index, and
# displacements past the immediate range of an aarch64 unsigned offset and a riscv
# 12-bit one. one runtime index expression drives every shape, so a scale applied to
# the wrong element size lands on a different element in exactly one of them.

use corpus.lib.fold;

rec Cell {
    tag: u16;
    a: u8;
    v: u64;
}

rec Odd {
    x: u32;
    y: u32;
    z: u32;
}

rec Far {
    lead: u64;
    pad: [1024]u64;
    mid: u32;
    pad2: [512]u32;
    tail: u16;
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: u64 = seed;

    var a8: [64]u8;
    var a16: [64]u16;
    var a32: [64]u32;
    var a64: [64]u64;
    var ac: [64]Cell;
    var ao: [64]Odd;

    var i: u64 = 0;
    for (i < 64) {
        a8[i] = (i * 3 + 1 + s)::u8;
        a16[i] = (i * 1103 + 7 + s)::u16;
        a32[i] = (i * 2654435761 + 11 + s)::u32;
        a64[i] = 11400714819323198485 * (i + 1) + s;
        ac[i].tag = (i * 5 + 2 + s)::u16;
        ac[i].a = (i + 128)::u8;
        ac[i].v = 1099511628211 * (i + 1) + s;
        ao[i].x = (i * 17 + 1 + s)::u32;
        ao[i].y = (i * 17 + 2 + s)::u32;
        ao[i].z = (i * 17 + 3 + s)::u32;
        i = i + 1;
    }

    # one index expression, every scale
    i = 0;
    for (i < 64) {
        val k: u64 = (i * 13 + s) & 63;
        h = fold.mix_u8(h, a8[k]);
        h = fold.mix_u16(h, a16[k]);
        h = fold.mix_u32(h, a32[k]);
        h = fold.mix_u64(h, a64[k]);
        h = fold.mix_u16(h, ac[k].tag);
        h = fold.mix_u8(h, ac[k].a);
        h = fold.mix_u64(h, ac[k].v);
        h = fold.mix_u32(h, ao[k].x);
        h = fold.mix_u32(h, ao[k].y);
        h = fold.mix_u32(h, ao[k].z);
        i = i + 1;
    }

    # an index the backend can fold into the scale, and the same index written as a
    # shift: both must reach the same element
    i = 0;
    for (i < 32) {
        h = fold.mix_u32(h, a32[i * 2]);
        h = fold.mix_u32(h, a32[i << 1]);
        h = fold.mix_u64(h, a64[(i + 1) * 2 - 2]);
        h = fold.mix_u8(h, a8[63 - i]);
        h = fold.mix_u64(h, ac[(i * 2 + s) & 63].v);
        i = i + 1;
    }

    # a constant index next to a runtime one over the same nested storage
    var grid: [8][8]u32;
    var r: u64 = 0;
    for (r < 8) {
        var c: u64 = 0;
        for (c < 8) {
            grid[r][c] = (r * 71 + c * 13 + s)::u32;
            c = c + 1;
        }
        r = r + 1;
    }
    i = 0;
    for (i < 8) {
        h = fold.mix_u32(h, grid[i][3]);
        h = fold.mix_u32(h, grid[3][i]);
        h = fold.mix_u32(h, grid[i][(i + s) & 7]);
        i = i + 1;
    }
    h = fold.mix_u32(h, grid[7][7]);
    h = fold.mix_u32(h, grid[0][0]);

    # displacements a 12-bit immediate cannot hold
    var f: Far;
    f.lead = 305419896 + s;
    f.mid = 2596069104 + s::u32;
    f.tail = 4660 + s::u16;
    i = 0;
    for (i < 1024) {
        f.pad[i] = (i * 31 + s);
        i = i + 1;
    }
    i = 0;
    for (i < 512) {
        f.pad2[i] = (i * 37 + s)::u32;
        i = i + 1;
    }
    h = fold.mix_u64(h, f.lead);
    h = fold.mix_u64(h, f.pad[0]);
    h = fold.mix_u64(h, f.pad[1023]);
    h = fold.mix_u64(h, f.pad[(s + 700) % 1024]);
    h = fold.mix_u32(h, f.mid);
    h = fold.mix_u32(h, f.pad2[0]);
    h = fold.mix_u32(h, f.pad2[511]);
    h = fold.mix_u32(h, f.pad2[(s + 300) % 512]);
    h = fold.mix_u16(h, f.tail);
    h = fold.mix_u64(h, $offset_of(Far, mid));
    h = fold.mix_u64(h, $offset_of(Far, pad2));
    h = fold.mix_u64(h, $offset_of(Far, tail));
    h = fold.mix_u64(h, $size_of(Far));

    # a running fold over the far storage, so a displacement that is right at one
    # end and wrong at the other cannot pass
    var acc: u64 = 0;
    i = 0;
    for (i < 1024) {
        acc = acc ^ (f.pad[i] * (i + 1));
        i = i + 1;
    }
    h = fold.mix_u64(h, acc);
    acc = 0;
    i = 0;
    for (i < 512) {
        acc = acc + f.pad2[i]::u64 * (i + 3);
        i = i + 1;
    }
    h = fold.mix_u64(h, acc);
    ret h;
}
