# module-scope storage that carries an initializer, so the value has to survive the
# object file's initialized data section and come back byte for byte. scalars at
# every width, an array, a record with padding, and a nested record, each read
# before anything writes it, then mutated through helpers called more than once so
# the reads and writes are real memory traffic rather than one folded constant.

use corpus.lib.fold;

rec Cell {
    tag: u16;
    a: u8;
    v: u64;
}

rec Pair {
    left: Cell;
    right: [3]u16;
    mark: u32;
}

val K_U64: u64 = 11400714819323198485;
val K_I32: i32 = -1234567;
val K_F64: f64 = 0.15625;

var g_u8: u8 = 219;
var g_u16: u16 = 48879;
var g_u32: u32 = 3735928559;
var g_u64: u64 = 18364758544493064720;
var g_i8: i8 = -100;
var g_i16: i16 = -30000;
var g_i32: i32 = -2000000000;
var g_i64: i64 = -4000000000000000000;
var g_f32: f32 = 1.5;
var g_f64: f64 = -2.25;
var g_arr: [6]u32 = [6]u32{10, 20, 30, 40, 50, 60};
var g_cell: Cell = Cell{ tag: 4660, a: 200, v: 1099511628211 };
var g_pair: Pair = Pair{ left: Cell{ tag: 1, a: 2, v: 3 },
                         right: [3]u16{7, 8, 9},
                         mark: 305419896 };

fun fold_cell(h: u64, c: Cell) u64 {
    var x: u64 = fold.mix_u16(h, c.tag);
    x = fold.mix_u8(x, c.a);
    x = fold.mix_u64(x, c.v);
    ret x;
}

fun fold_globals(h: u64) u64 {
    var x: u64 = fold.mix_u8(h, g_u8);
    x = fold.mix_u16(x, g_u16);
    x = fold.mix_u32(x, g_u32);
    x = fold.mix_u64(x, g_u64);
    x = fold.mix_i8(x, g_i8);
    x = fold.mix_i16(x, g_i16);
    x = fold.mix_i32(x, g_i32);
    x = fold.mix_i64(x, g_i64);
    x = fold.mix_f32(x, g_f32);
    x = fold.mix_f64(x, g_f64);
    var i: u64 = 0;
    for (i < 6) {
        x = fold.mix_u32(x, g_arr[i]);
        i = i + 1;
    }
    x = fold_cell(x, g_cell);
    x = fold_cell(x, g_pair.left);
    x = fold.mix_u16(x, g_pair.right[0]);
    x = fold.mix_u16(x, g_pair.right[1]);
    x = fold.mix_u16(x, g_pair.right[2]);
    x = fold.mix_u32(x, g_pair.mark);
    ret x;
}

fun advance(step: u64) {
    g_u8 = g_u8 + step::u8;
    g_u16 = g_u16 + step::u16;
    g_u32 = g_u32 + step::u32;
    g_u64 = g_u64 + step;
    g_i8 = (g_i8:~u8 + step::u8):~i8;
    g_i16 = (g_i16:~u16 + step::u16):~i16;
    g_i32 = (g_i32:~u32 + step::u32):~i32;
    g_i64 = (g_i64:~u64 + step):~i64;
    g_f32 = g_f32 * 1.5;
    g_f64 = g_f64 * 0.5 + 1.0;
    var i: u64 = 0;
    for (i < 6) {
        g_arr[i] = g_arr[i] ^ (step::u32 * (i::u32 + 1));
        i = i + 1;
    }
    g_cell.tag = g_cell.tag + step::u16;
    g_cell.a = g_cell.a ^ step::u8;
    g_cell.v = g_cell.v * 3 + step;
    g_pair.left = g_cell;
    g_pair.right[step % 3] = g_pair.right[step % 3] + 100;
    g_pair.mark = g_pair.mark - step::u32;
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();

    # the initializers as they were emitted, before anything writes
    h = fold_globals(h);

    h = fold.mix_u64(h, K_U64 + seed);
    h = fold.mix_i32(h, K_I32);
    h = fold.mix_f64(h, K_F64);

    var n: u64 = 0;
    for (n < 5) {
        advance(n + 1 + seed);
        h = fold_globals(h);
        n = n + 1;
    }

    # a global read into a local, mutated there, and written back
    var t: u64 = g_u64;
    t = t ^ K_U64;
    g_u64 = t;
    h = fold.mix_u64(h, g_u64);

    var c: Cell = g_cell;
    c.v = c.v + 1;
    g_cell = c;
    h = fold_cell(h, g_cell);
    h = fold_globals(h);
    ret h;
}
