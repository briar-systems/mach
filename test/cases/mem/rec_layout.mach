# nested records whose fields are ordered to force padding at three levels, with
# the sizes, alignments and offsets folded alongside the field values. every field
# carries a distinct sentinel, so an offset the compiler computes one field too far
# lands on a neighbour and moves the checksum rather than being invisible.

use corpus.lib.fold;

rec Tiny {
    a: u8;
    b: u32;
    c: u8;
}

rec Mid {
    lead: u16;
    t: Tiny;
    tail: u8;
}

rec Wide {
    m: Mid;
    d: u64;
    arr: [3]u16;
    e: u8;
}

rec Nest {
    w: Wide;
    ms: [2]Mid;
    z: u32;
}

fun fold_tiny(h: u64, t: Tiny) u64 {
    var x: u64 = fold.mix_u8(h, t.a);
    x = fold.mix_u32(x, t.b);
    x = fold.mix_u8(x, t.c);
    ret x;
}

fun fold_mid(h: u64, m: Mid) u64 {
    var x: u64 = fold.mix_u16(h, m.lead);
    x = fold_tiny(x, m.t);
    x = fold.mix_u8(x, m.tail);
    ret x;
}

fun fold_wide(h: u64, w: Wide) u64 {
    var x: u64 = fold_mid(h, w.m);
    x = fold.mix_u64(x, w.d);
    x = fold.mix_u16(x, w.arr[0]);
    x = fold.mix_u16(x, w.arr[1]);
    x = fold.mix_u16(x, w.arr[2]);
    x = fold.mix_u8(x, w.e);
    ret x;
}

fun fold_nest(h: u64, n: Nest) u64 {
    var x: u64 = fold_wide(h, n.w);
    x = fold_mid(x, n.ms[0]);
    x = fold_mid(x, n.ms[1]);
    x = fold.mix_u32(x, n.z);
    ret x;
}

fun fill_mid(m: *Mid, base: u32) {
    m.lead = base::u16;
    m.t.a = (base + 1)::u8;
    m.t.b = base + 2;
    m.t.c = (base + 3)::u8;
    m.tail = (base + 4)::u8;
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: u32 = seed::u32;

    h = fold.mix_u64(h, $size_of(Tiny));
    h = fold.mix_u64(h, $size_of(Mid));
    h = fold.mix_u64(h, $size_of(Wide));
    h = fold.mix_u64(h, $size_of(Nest));
    h = fold.mix_u64(h, $align_of(Tiny));
    h = fold.mix_u64(h, $align_of(Mid));
    h = fold.mix_u64(h, $align_of(Wide));
    h = fold.mix_u64(h, $align_of(Nest));
    h = fold.mix_u64(h, $offset_of(Tiny, b));
    h = fold.mix_u64(h, $offset_of(Tiny, c));
    h = fold.mix_u64(h, $offset_of(Mid, t));
    h = fold.mix_u64(h, $offset_of(Mid, tail));
    h = fold.mix_u64(h, $offset_of(Wide, d));
    h = fold.mix_u64(h, $offset_of(Wide, arr));
    h = fold.mix_u64(h, $offset_of(Wide, e));
    h = fold.mix_u64(h, $offset_of(Nest, ms));
    h = fold.mix_u64(h, $offset_of(Nest, z));

    var n: Nest;
    h = fold_nest(h, n);

    fill_mid(?n.w.m, 10 + s);
    n.w.d = 18364758544493064720 + seed;
    n.w.arr[0] = (20 + s)::u16;
    n.w.arr[1] = (21 + s)::u16;
    n.w.arr[2] = (22 + s)::u16;
    n.w.e = (23 + s)::u8;
    fill_mid(?n.ms[0], 30 + s);
    fill_mid(?n.ms[1], 40 + s);
    n.z = 50 + s;
    h = fold_nest(h, n);

    # write one field at a time through an interior pointer and fold the whole
    # record after each, so a neighbour touched by the store is caught immediately
    var pb: *u32 = ?n.w.m.t.b;
    @pb = @pb ^ 4042322160;
    h = fold_nest(h, n);

    var pc: *u8 = ?n.ms[1].t.c;
    @pc = @pc + 7;
    h = fold_nest(h, n);

    var pd: *u64 = ?n.w.d;
    @pd = @pd >> 3;
    h = fold_nest(h, n);

    var pz: *u32 = ?n.z;
    @pz = @pz * 3;
    h = fold_nest(h, n);

    # a record copied by value carries the fields and nothing about the padding
    var m2: Mid = n.ms[0];
    m2.t.b = m2.t.b + 1;
    h = fold_mid(h, m2);
    h = fold_mid(h, n.ms[0]);
    n.ms[0] = m2;
    h = fold_nest(h, n);
    ret h;
}
