# module-scope storage with no initializer, which the language defines as zero. the
# zeroes are folded before any write, so a target that emits the storage without
# zeroing it, or places it where the loader does not, fails here rather than in
# whatever later reads it. the array is large enough that its far end needs a
# different addressing form from its start.

use corpus.lib.fold;

rec Cell {
    tag: u16;
    a: u8;
    v: u64;
}

rec Nest {
    head: Cell;
    body: [4]u64;
    tail: u8;
}

var z_u8: u8;
var z_u16: u16;
var z_u32: u32;
var z_u64: u64;
var z_i32: i32;
var z_i64: i64;
var z_f32: f32;
var z_f64: f64;
var z_explicit: u64 = 0;
var z_arr: [512]u32;
var z_cells: [8]Cell;
var z_nest: Nest;

fun fold_cell(h: u64, c: Cell) u64 {
    var x: u64 = fold.mix_u16(h, c.tag);
    x = fold.mix_u8(x, c.a);
    x = fold.mix_u64(x, c.v);
    ret x;
}

fun fold_zeros(h: u64) u64 {
    var x: u64 = fold.mix_u8(h, z_u8);
    x = fold.mix_u16(x, z_u16);
    x = fold.mix_u32(x, z_u32);
    x = fold.mix_u64(x, z_u64);
    x = fold.mix_i32(x, z_i32);
    x = fold.mix_i64(x, z_i64);
    x = fold.mix_f32(x, z_f32);
    x = fold.mix_f64(x, z_f64);
    x = fold.mix_u64(x, z_explicit);
    var i: u64 = 0;
    for (i < 512) {
        x = fold.mix_u32(x, z_arr[i]);
        i = i + 1;
    }
    i = 0;
    for (i < 8) {
        x = fold_cell(x, z_cells[i]);
        i = i + 1;
    }
    x = fold_cell(x, z_nest.head);
    i = 0;
    for (i < 4) {
        x = fold.mix_u64(x, z_nest.body[i]);
        i = i + 1;
    }
    x = fold.mix_u8(x, z_nest.tail);
    ret x;
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();

    # every byte of it is zero before anything writes
    h = fold_zeros(h);

    z_u8 = 200 + seed::u8;
    z_u16 = 40000 + seed::u16;
    z_u32 = 3000000000 + seed::u32;
    z_u64 = 18364758544493064720 + seed;
    z_i32 = (2000000000::u32 + seed::u32):~i32;
    z_i64 = (9000000000000000000::u64 + seed):~i64;
    z_f32 = 1.75;
    z_f64 = -0.0;
    z_explicit = 1099511628211 + seed;

    var i: u64 = 0;
    for (i < 512) {
        z_arr[i] = (2654435761 * (i + 1) + seed)::u32;
        i = i + 1;
    }
    i = 0;
    for (i < 8) {
        z_cells[i].tag = (i * 11 + 3 + seed)::u16;
        z_cells[i].a = (i + 250)::u8;
        z_cells[i].v = 11400714819323198485 * (i + 1) + seed;
        i = i + 1;
    }
    z_nest.head = z_cells[3];
    i = 0;
    for (i < 4) {
        z_nest.body[i] = 305419896 * (i + 1) + seed;
        i = i + 1;
    }
    z_nest.tail = 77;
    h = fold_zeros(h);

    # the far end of the array, reached both by a constant index and a runtime one
    h = fold.mix_u32(h, z_arr[511]);
    h = fold.mix_u32(h, z_arr[256]);
    h = fold.mix_u32(h, z_arr[(seed + 500) % 512]);

    # back to zero one element at a time, so a store that misses its target leaves a
    # nonzero behind for the final pass to find
    i = 0;
    for (i < 512) {
        z_arr[i] = 0;
        i = i + 1;
    }
    i = 0;
    for (i < 8) {
        z_cells[i] = Cell{ tag: 0, a: 0, v: 0 };
        i = i + 1;
    }
    z_u8 = 0;
    z_u16 = 0;
    z_u32 = 0;
    z_u64 = 0;
    z_i32 = 0;
    z_i64 = 0;
    z_f32 = 0.0;
    z_f64 = 0.0;
    z_explicit = 0;
    z_nest.head = Cell{ tag: 0, a: 0, v: 0 };
    i = 0;
    for (i < 4) {
        z_nest.body[i] = 0;
        i = i + 1;
    }
    z_nest.tail = 0;
    h = fold_zeros(h);
    ret h;
}
