# addresses and products stepped with the induction variable instead of
# recomputed from it (#3347), at the edges where the stepped value could drift
# from the recomputed one: records of a stride no scale covers, an index that
# is an affine function of the iv, a downward index, a row base under a nested
# loop, an iv that wraps through zero on its way to the index, a product read
# after a loop that leaves from its body, and a 32-bit iv that wraps.

use corpus.lib.fold;

rec Rec {
    a: u32;
    b: u64;
    c: u16;
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: u64 = seed;

    var rs: [16]Rec;
    var i:  u64 = 0;
    for (i < 16) {
        rs[i].a = (i * 2654435761 + s)::u32;
        rs[i].b = (i * 1099511628211) ^ s;
        rs[i].c = (i * 40503 + s)::u16;
        i       = i + 1;
    }

    var ws: [32]u32;
    i = 0;
    for (i < 32) {
        ws[i] = (i * 69069 + s)::u32;
        i     = i + 1;
    }

    # an affine index, 3 * i + 1
    i = 0;
    for (i < 5) {
        h = fold.mix_u64(h, rs[i * 3 + 1].b);
        h = fold.mix_u32(h, rs[i * 3 + 1].a);
        i = i + 1;
    }

    # a subtracted index, so the address steps down
    i = 0;
    for (i < 16) {
        h = fold.mix_u16(h, rs[15 - i].c);
        i = i + 1;
    }

    # scaled indices over a word array: a unit one with an offset and a doubled one
    i = 0;
    for (i < 13) {
        h = fold.mix_u32(h, ws[i + 5 + (s & 1)]);
        h = fold.mix_u32(h, ws[i * 2 + 1]);
        i = i + 1;
    }

    # a row base, r * 4, under the loop over the row
    var r: u64 = 0;
    for (r < 4) {
        var c: u64 = 0;
        for (c < 4) {
            h = fold.mix_u64(h, rs[r * 4 + c].b + c);
            c = c + 1;
        }
        r = r + 1;
    }

    # an iv that starts below 2^64 and wraps through zero, with the index adding
    # the distance back
    val lead: u64 = 3 + (s & 1);
    var w:    u64 = 0 - lead;
    var n:    u64 = 0;
    for (n < 10) {
        h = fold.mix_u64(h, rs[w + lead].b);
        w = w + 1;
        n = n + 1;
    }

    # a product carried to the next iteration and read after the loop
    var last: u64 = 0;
    i = 0;
    for (i < 7) {
        last = i * 40503 + s;
        h    = fold.mix_u64(h, last);
        i    = i + 1;
    }
    h = fold.mix_u64(h, last);

    # a product read after a loop that leaves from its body
    var m: u64 = 0;
    i = 0;
    for (i < 100) {
        m = i * 12345;
        if (m > 50000 + s) { brk; }
        i = i + 1;
    }
    h = fold.mix_u64(h, m);

    # a 32-bit iv whose product wraps at 32 bits
    var j: u32 = 0;
    for (j < 20) {
        h = fold.mix_u32(h, j * 2654435761 + s::u32);
        j = j + 1;
    }
    ret h;
}
