# stores that truncate and loads that extend, at every scalar width, into fields
# packed tight enough that a store one width too wide lands on a neighbour. every
# field is folded after every store, so a clobbered neighbour changes the checksum
# instead of being overwritten again before anyone looks.

use corpus.lib.fold;

rec Packed {
    b0: u8;
    b1: u8;
    b2: u8;
    b3: u8;
    h0: u16;
    h1: u16;
    w0: u32;
    d0: u64;
}

rec Signed {
    a: i8;
    b: i16;
    c: i32;
    d: i64;
}

fun fold_packed(h: u64, p: Packed) u64 {
    var a: u64 = fold.mix_u8(h, p.b0);
    a = fold.mix_u8(a, p.b1);
    a = fold.mix_u8(a, p.b2);
    a = fold.mix_u8(a, p.b3);
    a = fold.mix_u16(a, p.h0);
    a = fold.mix_u16(a, p.h1);
    a = fold.mix_u32(a, p.w0);
    a = fold.mix_u64(a, p.d0);
    ret a;
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: u64 = seed;

    # an uninitialized record is every field zero, and the zeroes are folded before
    # anything is written so a frame that starts dirty is caught here
    var p: Packed;
    h = fold_packed(h, p);

    val wide: u64 = 18364758544493064720 + s;
    p.b0 = wide::u8;
    p.b1 = (wide >> 8)::u8;
    p.b2 = (wide >> 16)::u8;
    p.b3 = (wide >> 24)::u8;
    p.h0 = wide::u16;
    p.h1 = (wide >> 32)::u16;
    p.w0 = wide::u32;
    p.d0 = wide;
    h = fold_packed(h, p);

    var i: u64 = 0;
    for (i < 8) {
        val v: u64 = wide * (i + 1) + s;
        p.b1 = v::u8;
        p.h1 = (v >> 3)::u16;
        p.w0 = (v >> 5)::u32;
        h = fold_packed(h, p);
        i = i + 1;
    }

    # narrow signed fields written as bit patterns, then read both at their own
    # width and widened, so a zero-extending load where a sign-extending one belongs
    # shows up twice
    var q: Signed;
    var j: u64 = 0;
    for (j < 6) {
        val bits: u64 = 11400714819323198485 * (j + 1) + s;
        q.a = bits::u8:~i8;
        q.b = (bits >> 8)::u16:~i16;
        q.c = (bits >> 16)::u32:~i32;
        q.d = bits:~i64;
        h = fold.mix_i8(h, q.a);
        h = fold.mix_i16(h, q.b);
        h = fold.mix_i32(h, q.c);
        h = fold.mix_i64(h, q.d);
        h = fold.mix_i64(h, q.a::i64);
        h = fold.mix_i64(h, q.b::i64);
        h = fold.mix_i64(h, q.c::i64);
        h = fold.mix_u64(h, q.a:~u8::u64);
        h = fold.mix_u64(h, q.b:~u16::u64);
        h = fold.mix_u64(h, q.c:~u32::u64);
        j = j + 1;
    }

    # a byte-granular store loop over a buffer wide enough to tempt a wider store
    var bytes: [16]u8;
    var k: u64 = 0;
    for (k < 16) {
        bytes[k] = ((wide >> ((k & 7) * 8))::u8) + k::u8;
        k = k + 1;
    }
    k = 0;
    for (k < 16) {
        h = fold.mix_u8(h, bytes[k]);
        k = k + 1;
    }

    # a write through a pointer and a read through the name it aliases
    var x: u64 = wide;
    var xp: *u64 = ?x;
    @xp = @xp ^ 11400714819323198485;
    h = fold.mix_u64(h, x);
    x = x + 1;
    h = fold.mix_u64(h, @xp);
    ret h;
}
