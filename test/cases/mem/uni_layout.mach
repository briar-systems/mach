# raw unions written through one member and read through another. two rules keep
# the C translation defined and the disagreement therefore always mach's: every
# member of a union here is the same size, so a write covers every byte a later
# read touches, and every write is a whole member rather than one element or one
# field of one. float members carry a forced normal exponent, so a pattern read as
# a float is a real number and this case stays about layout.

use corpus.lib.fold;

uni W4 {
    f: f32;
    u: u32;
    i: i32;
    b: [4]u8;
}

uni W8 {
    d: f64;
    u: u64;
    i: i64;
    w: [2]u32;
    b: [8]u8;
}

rec Aa {
    x: u32;
    y: u32;
}

rec Bb {
    p: u16;
    q: u16;
    r: u32;
}

uni RU {
    a: Aa;
    b: Bb;
}

rec Tagged {
    kind: u8;
    val: W8;
}

fun safe32(x: u32) u32 { ret (x & 2155872255) | 1048576000; }

fun safe64(x: u64) u64 { ret (x & 9223376434903384063) | 4600877379321698816; }

fun fold_w4(h: u64, v: W4) u64 {
    var x: u64 = fold.mix_u32(h, v.u);
    x = fold.mix_i32(x, v.i);
    x = fold.mix_f32(x, v.f);
    x = fold.mix_u8(x, v.b[0]);
    x = fold.mix_u8(x, v.b[1]);
    x = fold.mix_u8(x, v.b[2]);
    x = fold.mix_u8(x, v.b[3]);
    ret x;
}

fun fold_w8(h: u64, v: W8) u64 {
    var x: u64 = fold.mix_u64(h, v.u);
    x = fold.mix_i64(x, v.i);
    x = fold.mix_f64(x, v.d);
    x = fold.mix_u32(x, v.w[0]);
    x = fold.mix_u32(x, v.w[1]);
    var k: u64 = 0;
    for (k < 8) {
        x = fold.mix_u8(x, v.b[k]);
        k = k + 1;
    }
    ret x;
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();

    var i: u64 = 0;
    for (i < 6) {
        val raw: u64 = 11400714819323198485 * (i + 1) + seed;

        var a: W4;
        a.u = safe32(raw::u32);
        h = fold_w4(h, a);

        a.i = safe32((raw >> 7)::u32):~i32;
        h = fold_w4(h, a);

        a.f = a.f * 2.0;
        h = fold_w4(h, a);

        var c: W8;
        c.u = safe64(raw);
        h = fold_w8(h, c);

        c.i = safe64(raw >> 9):~i64;
        h = fold_w8(h, c);

        c.d = c.d * 3.0 + 1.0;
        h = fold_w8(h, c);

        i = i + 1;
    }

    # two record shapes over one storage: the write goes through the two 32-bit
    # fields and the read through a 16/16/32 split, so a field offset two bytes out
    # changes the checksum
    var r: RU;
    var j: u64 = 0;
    for (j < 4) {
        val raw: u32 = 2654435761 * (j::u32 + 1) + seed::u32;
        r.a = Aa{ x: raw, y: raw ^ 4042322160 };
        h = fold.mix_u32(h, r.a.x);
        h = fold.mix_u32(h, r.a.y);
        h = fold.mix_u16(h, r.b.p);
        h = fold.mix_u16(h, r.b.q);
        h = fold.mix_u32(h, r.b.r);
        r.b = Bb{ p: raw::u16, q: (raw >> 16)::u16, r: raw + 1 };
        h = fold.mix_u32(h, r.a.x);
        h = fold.mix_u32(h, r.a.y);
        j = j + 1;
    }

    # a discriminated value: the tag and the payload share no storage, so a payload
    # write at any width must leave the tag alone
    var t: Tagged;
    var n: u64 = 0;
    for (n < 4) {
        t.kind = (n + 1)::u8;
        t.val.u = safe64(14695981039346656037 * (n + 1) + seed);
        h = fold.mix_u8(h, t.kind);
        h = fold_w8(h, t.val);
        t.val.d = t.val.d + 0.5;
        h = fold.mix_u8(h, t.kind);
        h = fold_w8(h, t.val);
        n = n + 1;
    }

    var us: [3]W8;
    var m: u64 = 0;
    for (m < 3) {
        us[m].u = safe64(1099511628211 * (m + 1) + seed);
        m = m + 1;
    }
    m = 0;
    for (m < 3) {
        h = fold_w8(h, us[m]);
        m = m + 1;
    }
    ret h;
}
