# indexing at every shape the addressing modes have to cover: constant indices the
# compiler folds into a displacement, runtime indices it has to scale, nested arrays
# where the stride is a product of two extents, arrays of records where it is a
# record size, and an array inside a record where a field offset is added on top.
# every dynamic index is masked or reduced into range, so no read is out of bounds.

use corpus.lib.fold;

rec Cell {
    tag: u16;
    a: u8;
    v: u64;
}

rec Holder {
    pre: u8;
    xs: [7]u32;
    post: u16;
}

fun fold_cell(h: u64, c: Cell) u64 {
    var x: u64 = fold.mix_u16(h, c.tag);
    x = fold.mix_u8(x, c.a);
    x = fold.mix_u64(x, c.v);
    ret x;
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: u64 = seed;

    var flat: [32]u32;
    var i: u64 = 0;
    for (i < 32) {
        flat[i] = (2654435761 * (i + 1) + s)::u32;
        i = i + 1;
    }

    h = fold.mix_u32(h, flat[0]);
    h = fold.mix_u32(h, flat[1]);
    h = fold.mix_u32(h, flat[15]);
    h = fold.mix_u32(h, flat[31]);

    # runtime indices the compiler cannot fold, walking forward then backward
    i = 0;
    for (i < 32) {
        h = fold.mix_u32(h, flat[(i * 7 + s) & 31]);
        i = i + 1;
    }
    i = 32;
    for (i > 0) {
        i = i - 1;
        h = fold.mix_u32(h, flat[i]);
    }

    # a strided walk, so the index advances by more than one element per step
    i = 0;
    for (i < 32) {
        h = fold.mix_u32(h, flat[i]);
        i = i + 5;
    }

    var grid: [4][6]u16;
    var r: u64 = 0;
    for (r < 4) {
        var c: u64 = 0;
        for (c < 6) {
            grid[r][c] = (r * 100 + c * 7 + s)::u16;
            c = c + 1;
        }
        r = r + 1;
    }
    h = fold.mix_u16(h, grid[0][0]);
    h = fold.mix_u16(h, grid[3][5]);
    h = fold.mix_u16(h, grid[(s + 2) & 3][(s + 4) & 3]);
    r = 0;
    for (r < 4) {
        var c: u64 = 0;
        for (c < 6) {
            h = fold.mix_u16(h, grid[r][c]);
            c = c + 1;
        }
        r = r + 1;
    }
    # the two indices swapped over the same storage: a row-major stride the compiler
    # gets wrong reads a different element here than above
    var c2: u64 = 0;
    for (c2 < 6) {
        r = 0;
        for (r < 4) {
            h = fold.mix_u16(h, grid[r][c2]);
            r = r + 1;
        }
        c2 = c2 + 1;
    }

    var cube: [3][3][3]u8;
    var x: u64 = 0;
    for (x < 3) {
        var y: u64 = 0;
        for (y < 3) {
            var z: u64 = 0;
            for (z < 3) {
                cube[x][y][z] = (x * 9 + y * 3 + z + s)::u8;
                z = z + 1;
            }
            y = y + 1;
        }
        x = x + 1;
    }
    x = 0;
    for (x < 3) {
        var y: u64 = 0;
        for (y < 3) {
            var z: u64 = 0;
            for (z < 3) {
                h = fold.mix_u8(h, cube[z][y][x]);
                z = z + 1;
            }
            y = y + 1;
        }
        x = x + 1;
    }
    h = fold.mix_u8(h, cube[2][0][1]);
    h = fold.mix_u8(h, cube[(s + 1) % 3][(s + 2) % 3][s % 3]);

    # an array whose element size is not a power of two, so the index scales by a
    # multiply rather than a shift
    var cells: [5]Cell;
    var k: u64 = 0;
    for (k < 5) {
        cells[k].tag = (k * 3 + 1 + s)::u16;
        cells[k].a = (k + 200)::u8;
        cells[k].v = 1099511628211 * (k + 1) + s;
        k = k + 1;
    }
    k = 0;
    for (k < 5) {
        h = fold_cell(h, cells[k]);
        k = k + 1;
    }
    h = fold_cell(h, cells[(s + 3) % 5]);
    h = fold.mix_u64(h, cells[4].v);
    h = fold.mix_u16(h, cells[(s + 1) % 5].tag);
    h = fold.mix_u64(h, $size_of(Cell));

    # an array behind a field offset, and a whole-array copy between records
    var hold: Holder;
    hold.pre = 17;
    hold.post = 4660;
    k = 0;
    for (k < 7) {
        hold.xs[k] = (k::u32 * 305419896) + s::u32;
        k = k + 1;
    }
    h = fold.mix_u8(h, hold.pre);
    k = 0;
    for (k < 7) {
        h = fold.mix_u32(h, hold.xs[(k * 3 + s) % 7]);
        k = k + 1;
    }
    h = fold.mix_u16(h, hold.post);
    h = fold.mix_u64(h, $offset_of(Holder, xs));

    var hold2: Holder = hold;
    hold2.xs[3] = hold2.xs[3] ^ 4042322160;
    h = fold.mix_u32(h, hold.xs[3]);
    h = fold.mix_u32(h, hold2.xs[3]);
    h = fold.mix_u8(h, hold2.pre);
    h = fold.mix_u16(h, hold2.post);
    ret h;
}
