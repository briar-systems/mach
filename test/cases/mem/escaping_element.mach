# an element address derived by pointer arithmetic and handed to a call: the callee
# reads the element's siblings through it, so each array must stay whole however the
# helper that derives the address is inlined (#3482). the reader stays out of line so
# the address really leaves the function, and the results are folded only at the end
# so nothing between the arrays and the calls changes how they are optimized.

use corpus.lib.fold;

#[noinline]
fun read_run(p: *u8, n: u64) u64 {
    var acc: u64 = 0;
    var k:   u64 = 0;
    for (k < n) {
        acc = (acc << 8) | p[k]::u64;
        k = k + 1;
    }
    ret acc;
}

fun from(s: *u8, i: u64, n: u64) u64 {
    ret read_run(?s[i], n - i);
}

fun from_view(s: *u8, i: u64, n: u64) u64 {
    val p: *u8 = ?s[i];
    ret read_run(p, n - i);
}

pub fun checksum(seed: u64) u64 {
    var four: [4]u8 = [4]u8{0xE4, 0xBD, 0xA0, 0x21};
    val a: u64 = from(?four[0], 0, 3);
    var five: [4]u8 = [4]u8{0xE4, 0xBD, (0xA0 + seed)::u8, 0x21};
    val b: u64 = from(?five[0], 0, 4);
    var six: [8]u8 = [8]u8{1, 2, 3, (4 + seed)::u8, 5, 6, 7, 8};
    val c: u64 = from_view(?six[0], 0, 8);
    var h: u64 = fold.init();
    h = fold.mix_u64(h, a);
    h = fold.mix_u64(h, b);
    h = fold.mix_u64(h, c);
    ret h;
}
