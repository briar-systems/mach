# a union declared inside a generic record, a generic union, and a generic union
# nested in a generic record each lay out like the same union written without
# parameters: every member at offset 0, so a write through one member is what
# another reads, and the record the same size as its plain twin. a second
# instance of the generic union lays out its own wider member. a generic record
# is the control, whose fields do not share storage. each offset agreement,
# each read back and each size folds

use corpus.lib.fold;

rec AnonInGeneric[T, E] {
    tag: u8;
    v:   uni { a: T; b: E; };
}

rec AnonInPlain {
    tag: u8;
    v:   uni { a: u32; b: u32; };
}

rec NestedPlain {
    tag: u8;
    v:   uni { a: u16; b: u32; };
}

uni NamedGeneric[T, E] { a: T; b: E; }

uni NamedPlain { a: u32; b: u32; }

rec NamedInGeneric[T] {
    tag: u8;
    v:   NamedGeneric[T, u32];
}

rec RecGeneric[T, E] { a: T; b: E; }

def AnonU32:   AnonInGeneric[u32, u32];
def NamedU32:  NamedGeneric[u32, u32];
def NamedU64:  NamedGeneric[u64, u32];
def NestedU16: NamedInGeneric[u16];
def RecU32:    RecGeneric[u32, u32];

# 1 when two members start at the same address
fun same(lo: ptr, hi: ptr) u8 {
    if (lo == hi) { ret 1; }
    ret 0;
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: u32 = seed::u32;

    var ag: AnonU32;
    ag.v.b = 2 + s;
    ag.v.a = 1 + s;
    h      = fold.mix_u8(h, same((?ag.v.a)::ptr, (?ag.v.b)::ptr));
    h      = fold.mix_u32(h, ag.v.b);
    var ap: AnonInPlain;
    ap.v.b = 2 + s;
    ap.v.a = 1 + s;
    h      = fold.mix_u8(h, same((?ap.v.a)::ptr, (?ap.v.b)::ptr));
    h      = fold.mix_u32(h, ap.v.b);
    h      = fold.mix_u64(h, $size_of(AnonU32)::u64);
    h      = fold.mix_u64(h, $size_of(AnonInPlain)::u64);

    var ng: NamedU32;
    ng.b = 2 + s;
    ng.a = 1 + s;
    h    = fold.mix_u8(h, same((?ng.a)::ptr, (?ng.b)::ptr));
    h    = fold.mix_u32(h, ng.b);
    var np: NamedPlain;
    np.b = 2 + s;
    np.a = 1 + s;
    h    = fold.mix_u8(h, same((?np.a)::ptr, (?np.b)::ptr));
    h    = fold.mix_u32(h, np.b);
    h    = fold.mix_u64(h, $size_of(NamedU32)::u64);
    h    = fold.mix_u64(h, $size_of(NamedPlain)::u64);
    var wide: NamedU64;
    wide.b = 2 + s;
    wide.a = (1 + s)::u64;
    h      = fold.mix_u8(h, same((?wide.a)::ptr, (?wide.b)::ptr));
    h      = fold.mix_u32(h, wide.b);
    h      = fold.mix_u64(h, $size_of(NamedU64)::u64);

    var nested: NestedU16;
    nested.v.b = 2 + s;
    nested.v.a = (1 + s)::u16;
    h          = fold.mix_u8(h, same((?nested.v.a)::ptr, (?nested.v.b)::ptr));
    h          = fold.mix_u32(h, nested.v.b);
    h          = fold.mix_u64(h, $size_of(NestedU16)::u64);
    h          = fold.mix_u64(h, $size_of(NestedPlain)::u64);

    var r: RecU32;
    r.b = 2 + s;
    r.a = 1 + s;
    h   = fold.mix_u8(h, same((?r.a)::ptr, (?r.b)::ptr));
    h   = fold.mix_u32(h, r.b);
    h   = fold.mix_u32(h, r.a);
    ret h;
}
