# materialization of the boundary constant set into a register, distinct
# from letting it ride as another instruction's immediate operand. each
# constant either reaches h through a runtime branch the compiler cannot
# resolve statically, through a local array store read back at a dynamic
# index, or through a record's per-field store. storage stays function-local
# throughout: a spirv shader has no general global storage, so a
# module-scope var would reach only some targets.

use corpus.lib.fold;

rec Consts {
    a: u32;
    b: u32;
    c: u64;
    d: u32;
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: u64 = seed;

    var w32: u32 = 0;
    if (s == 0) {
        w32 = 2047;                          # 2^11 - 1
    } or {
        w32 = 2147483648;                    # 2^31
    }
    h = fold.mix_u32(h, w32);

    var w64: u64 = 0;
    if (s == 1) {
        w64 = 4294967295;                    # 2^32 - 1
    } or {
        w64 = 9223372036854775807;           # 2^63 - 1
    }
    h = fold.mix_u64(h, w64);

    var wb1: u32 = 0;
    if (s == 2) {
        wb1 = 1431655765;                    # 0x55555555
    } or {
        wb1 = 252645135;                     # 0x0f0f0f0f
    }
    h = fold.mix_u32(h, wb1);

    var wb2: u64 = 0;
    if (s == 3) {
        wb2 = 6148914691236517205;           # 0x5555555555555555
    } or {
        wb2 = 18446462603027742720;          # 0xffff0000ffff0000
    }
    h = fold.mix_u64(h, wb2);

    # each constant materializes into stack storage via its own store; the
    # dynamic index (unknowable at compile time) then forces a real load
    # back rather than letting the read collapse to a known element
    var arr: [3]u64;
    arr[0] = 4294967296;                  # 2^32
    arr[1] = 9223372036854775808;         # 2^63
    arr[2] = 4294901760;                  # 0xffff0000
    val ai: u64 = s % 3;
    h = fold.mix_u64(h, arr[ai]);
    h = fold.mix_u64(h, arr[(ai + 1) % 3]);
    h = fold.mix_u64(h, arr[(ai + 2) % 3]);

    var rc: Consts;
    rc.a = 2047;                          # 2^11 - 1
    rc.b = 2147483648;                    # 2^31
    rc.c = 9223372036854775808;           # 2^63
    rc.d = 1431655765;                    # 0x55555555
    rc.a = rc.a + s::u32;
    h = fold.mix_u32(h, rc.a);
    h = fold.mix_u32(h, rc.b);
    h = fold.mix_u64(h, rc.c);
    h = fold.mix_u32(h, rc.d);

    ret h;
}
