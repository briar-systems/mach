# address computation against the same boundary constant set: array index and
# record-field offsets chosen to straddle riscv's +-2^11 load/store immediate,
# aarch64's 12-bit (optionally scaled) load/store immediate, and x86's 32-bit
# displacement, plus a dynamic index derived from seed so the base+index*scale
# form is exercised alongside the base+immediate-offset form.

use corpus.lib.fold;

rec Node {
    lead: u32;
    v: [3]u64;
    trail: u32;
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: u64 = seed;

    # local, not module-scope storage: a spirv shader has no general global
    # storage, so every array here is a function-local the driver's entry
    # never needs a role decorator to reach
    var TABLE: [4224]u64;
    var NODES: [96]Node;

    # constant indices at boundary byte offsets from TABLE's base (element
    # size 8): 2^11/8, aarch64 imm12*8 = 32760, and one past each
    TABLE[0] = s + 1;
    TABLE[255] = s + 2;                  # byte offset 2040, riscv imm12 - 8
    TABLE[256] = s + 3;                  # byte offset 2048, riscv imm12 + 0
    TABLE[4095] = s + 4;                 # byte offset 32760, aarch64 imm12*8 max
    TABLE[4096] = s + 5;                 # byte offset 32768, one scaled step past
    TABLE[4223] = s + 6;                 # last element
    h = fold.mix_u64(h, TABLE[0]);
    h = fold.mix_u64(h, TABLE[255]);
    h = fold.mix_u64(h, TABLE[256]);
    h = fold.mix_u64(h, TABLE[4095]);
    h = fold.mix_u64(h, TABLE[4096]);
    h = fold.mix_u64(h, TABLE[4223]);

    # dynamic index: unknowable at compile time, forces a base+index*scale
    # address computation rather than a folded base+immediate one
    val i0: u64 = s % 4224;
    val i1: u64 = (s + 4095) % 4224;
    val i2: u64 = (s + 2048) % 4224;
    TABLE[i0] = TABLE[i0] + 7;
    TABLE[i1] = TABLE[i1] + 8;
    TABLE[i2] = TABLE[i2] + 9;
    h = fold.mix_u64(h, TABLE[i0]);
    h = fold.mix_u64(h, TABLE[i1]);
    h = fold.mix_u64(h, TABLE[i2]);

    # record-array addressing: a wider element (Node is 4 + 24 + 4 padded to
    # align 8, so $size_of is 32) forces a shift-and-add scale on targets
    # whose addressing mode has no ×32 form
    val n0: u64 = s % 96;
    val n1: u64 = (s + 63) % 96;
    NODES[n0].lead = 4294967295;
    NODES[n0].v[0] = s + 10;
    NODES[n0].v[1] = s + 11;
    NODES[n0].v[2] = s + 12;
    NODES[n0].trail = 305419896;
    NODES[n1].lead = 2882400001;
    NODES[n1].v[0] = s + 13;
    NODES[n1].v[1] = s + 14;
    NODES[n1].v[2] = s + 15;
    NODES[n1].trail = 19088743;
    h = fold.mix_u32(h, NODES[n0].lead);
    h = fold.mix_u64(h, NODES[n0].v[0]);
    h = fold.mix_u64(h, NODES[n0].v[1]);
    h = fold.mix_u64(h, NODES[n0].v[2]);
    h = fold.mix_u32(h, NODES[n0].trail);
    h = fold.mix_u32(h, NODES[n1].lead);
    h = fold.mix_u64(h, NODES[n1].v[0]);
    h = fold.mix_u64(h, NODES[n1].v[1]);
    h = fold.mix_u64(h, NODES[n1].v[2]);
    h = fold.mix_u32(h, NODES[n1].trail);

    # address-of plus dereference through a computed element: the pointer
    # itself is the boundary-offset address, never observed as a value
    var p: *u64 = ?TABLE[4095];
    @p = @p + 16;
    h = fold.mix_u64(h, @p);

    ret h;
}
