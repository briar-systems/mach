# add/sub against the boundary constant set: riscv's +-2^11 I-type immediate,
# aarch64's 12-bit (optionally <<12) add/sub immediate, x86's 32-bit
# sign-extended immediate, and the 2^63 boundary that forces full-width
# materialization on every target. every chain is seeded so it cannot fold.

use corpus.lib.fold;

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();

    val s32: u32 = seed::u32;
    var a: u32 = s32 + 2047;             # 2^11 - 1
    h = fold.mix_u32(h, a);
    a = a + 2048;                        # 2^11
    h = fold.mix_u32(h, a);
    a = a + 4095;                        # aarch64 imm12 max
    h = fold.mix_u32(h, a);
    a = a + 4096;                        # aarch64 imm12 + 1
    h = fold.mix_u32(h, a);
    a = a + 2147483647;                  # x86 simm32 max, 2^31 - 1
    h = fold.mix_u32(h, a);
    a = a + 2147483648;                  # 2^31, no longer simm32
    h = fold.mix_u32(h, a);
    a = a + 4294967295;                  # 2^32 - 1, wraps in u32
    h = fold.mix_u32(h, a);

    val s64: u64 = seed;
    var b: u64 = s64 + 2047;
    h = fold.mix_u64(h, b);
    b = b - 2048;
    h = fold.mix_u64(h, b);
    b = b + 16773120;                    # aarch64 imm12 << 12 max, 0xfff000
    h = fold.mix_u64(h, b);
    b = b + 16777215;                    # 0xffffff, one past the shifted form
    h = fold.mix_u64(h, b);
    b = b + 2147483647;                  # x86 simm32 max
    h = fold.mix_u64(h, b);
    b = b + 2147483648;                  # 2^31
    h = fold.mix_u64(h, b);
    b = b + 4294967295;                  # 2^32 - 1
    h = fold.mix_u64(h, b);
    b = b + 4294967296;                  # 2^32
    h = fold.mix_u64(h, b);
    b = b + 9223372036854775808;         # 2^63
    h = fold.mix_u64(h, b);

    val si32: i32 = seed::i32;
    var c: i32 = si32 + 2047;
    h = fold.mix_i32(h, c);
    c = c - 2048;
    h = fold.mix_i32(h, c);
    c = c + 2147483647;                  # i32::MAX
    h = fold.mix_i32(h, c);
    c = c - ((2147483648::u32):~i32);    # subtract i32::MIN's bit pattern
    h = fold.mix_i32(h, c);

    val si64: i64 = seed::i64;
    var d: i64 = si64 + 2047;
    h = fold.mix_i64(h, d);
    d = d - 2048;
    h = fold.mix_i64(h, d);
    d = d + 2147483647;
    h = fold.mix_i64(h, d);
    d = d - ((9223372036854775808::u64):~i64);  # subtract i64::MIN's bit pattern
    h = fold.mix_i64(h, d);

    ret h;
}
