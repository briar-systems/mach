# and/or/xor/not against the aarch64 bitmask-immediate boundary set: an
# alternating pattern (0x5555...), a nibble pattern (0x0f0f...), and a
# contiguous high/low run (0xffff0000...), at both 32 and 64 bits, plus their
# complements. every combination is seeded so it cannot fold.

use corpus.lib.fold;

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();

    val s32: u32 = seed::u32;
    var a: u32 = s32 | 1431655765;       # 0x55555555, alternating bits
    h = fold.mix_u32(h, a);
    a = (s32 ^ 1431655765) & 252645135;  # 0x0f0f0f0f, nibble pattern
    h = fold.mix_u32(h, a);
    a = s32 | 4294901760;                # 0xffff0000, contiguous high half
    h = fold.mix_u32(h, a);
    a = s32 & 65535;                     # 0x0000ffff, contiguous low half
    h = fold.mix_u32(h, a);
    a = ~s32;
    h = fold.mix_u32(h, a);
    a = ~(a | 1431655765);
    h = fold.mix_u32(h, a);
    a = (s32 & 252645135) ^ 4294901760;
    h = fold.mix_u32(h, a);

    val s64: u64 = seed;
    var b: u64 = s64 | 6148914691236517205;   # 0x5555555555555555
    h = fold.mix_u64(h, b);
    b = (s64 ^ 6148914691236517205) & 1085102592571150095;  # 0x0f0f0f0f0f0f0f0f
    h = fold.mix_u64(h, b);
    b = s64 | 18446462603027742720;      # 0xffff0000ffff0000
    h = fold.mix_u64(h, b);
    b = s64 & 71777214294589695;         # 0x0000ffff0000ffff
    h = fold.mix_u64(h, b);
    b = ~s64;
    h = fold.mix_u64(h, b);
    b = ~(b | 6148914691236517205);
    h = fold.mix_u64(h, b);
    b = (s64 & 1085102592571150095) ^ 18446462603027742720;
    h = fold.mix_u64(h, b);

    val si32: i32 = seed::i32;
    var c: i32 = si32 | ((1431655765::u32):~i32);
    h = fold.mix_i32(h, c);
    c = ~si32;
    h = fold.mix_i32(h, c);
    c = (si32 ^ c) & ((252645135::u32):~i32);
    h = fold.mix_i32(h, c);

    val si64: i64 = seed::i64;
    var d: i64 = si64 | ((6148914691236517205::u64):~i64);
    h = fold.mix_i64(h, d);
    d = ~si64;
    h = fold.mix_i64(h, d);
    d = (si64 ^ d) & ((1085102592571150095::u64):~i64);
    h = fold.mix_i64(h, d);

    ret h;
}
