# five loop shapes over one accumulator: a counted loop, a while-style condition
# loop counting down, a nested loop that skips one inner value via cnt, an
# early-exit loop via brk, and a loop-carried dependency (each term depends on the
# two computed before it).

use corpus.lib.fold;

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: u32 = seed::u32;

    # counted
    var i: u32 = 0;
    var acc: u32 = s;
    for (i < 16) {
        acc = acc + i * 3 + 1;
        h = fold.mix_u32(h, acc);
        i = i + 1;
    }

    # while-style: condition-only loop counting down to exactly zero
    var w: u32 = 98 + s;
    for (w > 0) {
        w = w - 7;
        h = fold.mix_u32(h, w);
    }

    # nested, with a cnt that skips one inner value per outer pass
    var oi: u32 = 0;
    for (oi < 6) {
        var ij: u32 = 0;
        for (ij < 6) {
            if (ij == 3) { ij = ij + 1; cnt; }
            h = fold.mix_u32(h, oi * 6 + ij + s);
            ij = ij + 1;
        }
        oi = oi + 1;
    }

    # early-exit: brk once a data-dependent bound is reached
    var e: u32 = s;
    for (e < 1000000) {
        h = fold.mix_u32(h, e);
        if (e == 9 + s) { brk; }
        e = e + 1;
    }

    # loop-carried dependency: each term is the sum of the two terms before it
    var p0: u32 = 1 + s;
    var p1: u32 = 1;
    var f: u32 = 0;
    for (f < 20) {
        val nx: u32 = p0 + p1;
        h = fold.mix_u32(h, nx);
        p0 = p1;
        p1 = nx;
        f = f + 1;
    }

    ret h;
}
