# all six integer predicates over boundary pairs at 32 and 64 bits, signed and unsigned,
# one noinline part per type.

use corpus.lib.fold;

# all six predicates over u32 boundary pairs: zero/all-ones and both sides of the
# signed-boundary split (0x7fffffff / 0x80000000), each direction and the matching
# diagonals, so every predicate is exercised at both a true and a false result.
#[noinline]
fun cmp_u32(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: u32 = seed::u32;

    val UMAX: u32 = 4294967295;
    val HALF: u32 = 2147483648;
    val HMAX: u32 = 2147483647;

    var av: [7]u32 = [7]u32{0, 0, UMAX, HMAX, HALF, UMAX, HALF};
    var bv: [7]u32 = [7]u32{0, UMAX, 0, HALF, HMAX, UMAX, HALF};

    var k: u64 = 0;
    for (k < 7) {
        val a: u32 = av[k] + s;
        val b: u32 = bv[k];
        h = fold.mix_u8(h, a == b);
        h = fold.mix_u8(h, a != b);
        h = fold.mix_u8(h, a < b);
        h = fold.mix_u8(h, a > b);
        h = fold.mix_u8(h, a <= b);
        h = fold.mix_u8(h, a >= b);
        k = k + 1;
    }
    ret h;
}

# all six predicates over signed i32 boundary pairs (INT32_MAX/INT32_MIN, 0/-1),
# each direction and the matching diagonals, so every predicate is exercised at
# both a true and a false result. IMIN is materialized by bit-reinterpreting the
# u32 pattern 0x80000000 rather than by negating an out-of-range literal.
#[noinline]
fun cmp_i32(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: i32 = (seed::u32):~i32;

    val imin_bits: u32 = 2147483648;
    val IMIN:      i32 = imin_bits:~i32;
    val IMAX:      i32 = 2147483647;

    var av: [7]i32 = [7]i32{0, 0, -1, IMAX, IMIN, -1, IMIN};
    var bv: [7]i32 = [7]i32{0, -1, 0, IMIN, IMAX, -1, IMIN};

    var k: u64 = 0;
    for (k < 7) {
        val a: i32 = av[k] + s;
        val b: i32 = bv[k];
        h = fold.mix_u8(h, a == b);
        h = fold.mix_u8(h, a != b);
        h = fold.mix_u8(h, a < b);
        h = fold.mix_u8(h, a > b);
        h = fold.mix_u8(h, a <= b);
        h = fold.mix_u8(h, a >= b);
        k = k + 1;
    }
    ret h;
}

# all six predicates over u64 boundary pairs: zero/all-ones and both sides of the
# signed-boundary split (0x7fffffffffffffff / 0x8000000000000000), each direction
# and the matching diagonals, so every predicate is exercised at both a true and a
# false result.
#[noinline]
fun cmp_u64(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: u64 = seed;

    val UMAX: u64 = 18446744073709551615;
    val HALF: u64 = 9223372036854775808;
    val HMAX: u64 = 9223372036854775807;

    var av: [7]u64 = [7]u64{0, 0, UMAX, HMAX, HALF, UMAX, HALF};
    var bv: [7]u64 = [7]u64{0, UMAX, 0, HALF, HMAX, UMAX, HALF};

    var k: u64 = 0;
    for (k < 7) {
        val a: u64 = av[k] + s;
        val b: u64 = bv[k];
        h = fold.mix_u8(h, a == b);
        h = fold.mix_u8(h, a != b);
        h = fold.mix_u8(h, a < b);
        h = fold.mix_u8(h, a > b);
        h = fold.mix_u8(h, a <= b);
        h = fold.mix_u8(h, a >= b);
        k = k + 1;
    }
    ret h;
}

# all six predicates over signed i64 boundary pairs (INT64_MAX/INT64_MIN, 0/-1),
# each direction and the matching diagonals, so every predicate is exercised at
# both a true and a false result. IMIN is materialized by bit-reinterpreting the
# u64 pattern 0x8000000000000000 rather than by negating an out-of-range literal.
#[noinline]
fun cmp_i64(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: i64 = seed:~i64;

    val imin_bits: u64 = 9223372036854775808;
    val IMIN:      i64 = imin_bits:~i64;
    val IMAX:      i64 = 9223372036854775807;

    var av: [7]i64 = [7]i64{0, 0, -1, IMAX, IMIN, -1, IMIN};
    var bv: [7]i64 = [7]i64{0, -1, 0, IMIN, IMAX, -1, IMIN};

    var k: u64 = 0;
    for (k < 7) {
        val a: i64 = av[k] + s;
        val b: i64 = bv[k];
        h = fold.mix_u8(h, a == b);
        h = fold.mix_u8(h, a != b);
        h = fold.mix_u8(h, a < b);
        h = fold.mix_u8(h, a > b);
        h = fold.mix_u8(h, a <= b);
        h = fold.mix_u8(h, a >= b);
        k = k + 1;
    }
    ret h;
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    h = fold.mix_u64(h, cmp_u32(seed));
    h = fold.mix_u64(h, cmp_i32(seed));
    h = fold.mix_u64(h, cmp_u64(seed));
    h = fold.mix_u64(h, cmp_i64(seed));
    ret h;
}
