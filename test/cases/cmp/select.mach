# the conditional assignments if-conversion turns into selects (#3346): min,
# max, abs and clamp at signed and unsigned widths from a byte to a word, a
# conditional accumulate, a 0/1 and a 1/0 choice, and a compare with its
# constant on the left, over a xorshift sequence no predictor learns, so every
# arm is taken and the branch-free form must agree with the branching one.

use corpus.lib.fold;

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    var x: u64 = seed ^ 0x9E3779B97F4A7C15;

    var mn: i32 = 0x7FFFFFFF;
    var mx: u16 = 0;
    var sa: i64 = 0;
    var sc: i8  = 0;
    var ac: u64 = 0;
    var bits: u32 = 0;

    var k: u32 = 0;
    for (k < 200) {
        x = x ^ (x << 13);
        x = x ^ (x >> 7);
        x = x ^ (x << 17);
        val w: i32 = (x & 0x7FFF)::i32 - 0x4000;
        val u: u16 = ((x >> 16) & 0xFFFF)::u16;
        val b: i8  = (((x >> 32) & 0x7F)::i32 - 64)::i8;

        if (w < mn) { mn = w; }
        if (u > mx) { mx = u; }
        var a: i64 = w::i64;
        if (a < 0) { a = 0 - a; }
        sa = sa + a;
        var c: i8 = b;
        if (c < -20) { c = -20; }
        or (c > 20) { c = 20; }
        sc = sc ^ c;
        if (u >= 0x8000) { ac = ac + u::u64; }
        var one: u32 = 0;
        if (w == 7 || u < 0x4000) { one = 1; }
        var zero: u32 = 1;
        if (100 < w) { zero = 0; }
        bits = bits + one + zero;

        h = fold.mix_i32(h, mn);
        h = fold.mix_u16(h, mx);
        h = fold.mix_i64(h, sa);
        h = fold.mix_i8(h, sc);
        h = fold.mix_u64(h, ac);
        h = fold.mix_u32(h, bits);
        k = k + 1;
    }

    ret h;
}
