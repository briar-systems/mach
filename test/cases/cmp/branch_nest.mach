# a nested if/or decision tree, five-wide at the top level and up to three deep in
# its branches, walked once per loop iteration by a value that ranges over every
# leaf across the run, so the whole chain gets laid out and every arm taken, not
# just one path folded to a constant.

use corpus.lib.fold;

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: u32 = seed::u32;

    var k: u32 = 0;
    for (k < 20) {
        val v: u32 = k + s;
        var r: u32 = 0;

        if (v < 4) {
            if (v == 0) { r = 100; }
            or (v == 1) { r = 101; }
            or (v == 2) { r = 102; }
            or { r = 103; }
        } or (v < 8) {
            if (v < 6) {
                if (v == 4) { r = 200; } or { r = 201; }
            } or {
                if (v == 6) { r = 202; } or { r = 203; }
            }
        } or (v < 12) {
            if (v == 8) { r = 300; }
            or (v == 9) { r = 301; }
            or (v == 10) { r = 302; }
            or { r = 303; }
        } or (v < 16) {
            if (v < 14) {
                if (v == 12) { r = 400; } or { r = 401; }
            } or {
                if (v == 14) { r = 402; } or { r = 403; }
            }
        } or {
            if (v == 16) { r = 500; }
            or (v == 17) { r = 501; }
            or (v == 18) { r = 502; }
            or { r = 503; }
        }

        h = fold.mix_u32(h, r);
        h = fold.mix_u32(h, v);
        k = k + 1;
    }

    ret h;
}
