# all six predicates over signed i64 boundary pairs (INT64_MAX/INT64_MIN, 0/-1),
# each direction and the matching diagonals, so every predicate is exercised at
# both a true and a false result. IMIN is materialized by bit-reinterpreting the
# u64 pattern 0x8000000000000000 rather than by negating an out-of-range literal.

use corpus.lib.fold;

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: i64 = seed:~i64;

    val imin_bits: u64 = 9223372036854775808;
    val IMIN: i64 = imin_bits:~i64;
    val IMAX: i64 = 9223372036854775807;

    var av: [7]i64 = [7]i64{0, 0, -1, IMAX, IMIN, -1, IMIN};
    var bv: [7]i64 = [7]i64{0, -1, 0, IMIN, IMAX, -1, IMIN};

    var k: u64 = 0;
    for (k < 7) {
        val a: i64 = av[k] + s;
        val b: i64 = bv[k];
        h = fold.mix_u8(h, a == b);
        h = fold.mix_u8(h, a != b);
        h = fold.mix_u8(h, a < b);
        h = fold.mix_u8(h, a > b);
        h = fold.mix_u8(h, a <= b);
        h = fold.mix_u8(h, a >= b);
        k = k + 1;
    }
    ret h;
}
