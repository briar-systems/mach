# all six predicates over signed i64 boundary pairs (INT64_MAX/INT64_MIN, 0/-1),
# each direction and the matching diagonals, so every predicate is exercised at
# both a true and a false result. IMIN is materialized by bit-reinterpreting the
# u64 pattern 0x8000000000000000 rather than by negating an out-of-range literal.

use corpus.lib.fold;

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: i64 = seed:~i64;

    val imin_bits: u64 = 9223372036854775808;
    val IMIN: i64 = imin_bits:~i64;
    val IMAX: i64 = 9223372036854775807;

    # built by element assignment rather than a brace literal: indexing a
    # literal-initialized local array fails to lower for spirv today,
    # and per-element assignment is the equivalent spelling that avoids it
    var av: [7]i64;
    av[0] = 0;    av[1] = 0;    av[2] = -1;   av[3] = IMAX;
    av[4] = IMIN; av[5] = -1;   av[6] = IMIN;
    var bv: [7]i64;
    bv[0] = 0;    bv[1] = -1;   bv[2] = 0;    bv[3] = IMIN;
    bv[4] = IMAX; bv[5] = -1;   bv[6] = IMIN;

    var k: u64 = 0;
    for (k < 7) {
        val a: i64 = av[k] + s;
        val b: i64 = bv[k];
        h = fold.mix_u8(h, a == b);
        h = fold.mix_u8(h, a != b);
        h = fold.mix_u8(h, a < b);
        h = fold.mix_u8(h, a > b);
        h = fold.mix_u8(h, a <= b);
        h = fold.mix_u8(h, a >= b);
        k = k + 1;
    }
    ret h;
}
