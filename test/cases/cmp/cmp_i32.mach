# all six predicates over signed i32 boundary pairs (INT32_MAX/INT32_MIN, 0/-1),
# each direction and the matching diagonals, so every predicate is exercised at
# both a true and a false result. IMIN is materialized by bit-reinterpreting the
# u32 pattern 0x80000000 rather than by negating an out-of-range literal.

use corpus.lib.fold;

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: i32 = (seed::u32):~i32;

    val imin_bits: u32 = 2147483648;
    val IMIN: i32 = imin_bits:~i32;
    val IMAX: i32 = 2147483647;

    # built by element assignment rather than a brace literal: indexing a
    # literal-initialized local array fails to lower for spirv today,
    # and per-element assignment is the equivalent spelling that avoids it
    var av: [7]i32;
    av[0] = 0;    av[1] = 0;    av[2] = -1;   av[3] = IMAX;
    av[4] = IMIN; av[5] = -1;   av[6] = IMIN;
    var bv: [7]i32;
    bv[0] = 0;    bv[1] = -1;   bv[2] = 0;    bv[3] = IMIN;
    bv[4] = IMAX; bv[5] = -1;   bv[6] = IMIN;

    var k: u64 = 0;
    for (k < 7) {
        val a: i32 = av[k] + s;
        val b: i32 = bv[k];
        h = fold.mix_u8(h, a == b);
        h = fold.mix_u8(h, a != b);
        h = fold.mix_u8(h, a < b);
        h = fold.mix_u8(h, a > b);
        h = fold.mix_u8(h, a <= b);
        h = fold.mix_u8(h, a >= b);
        k = k + 1;
    }
    ret h;
}
