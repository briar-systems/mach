# proves && and || short-circuit correctly: the untaken side's hit counter must
# stay at zero, and a taken side's sequence stamp must follow whatever ran before
# it. four probe slots (0..3) share one sequence counter and are reset between
# subtests, so a reordering or a spurious evaluation changes the folded state
# instead of passing silently. the last three subtests compound && and || so a
# short-circuit inside one operand group is proven independently of whether the
# outer operator goes on to evaluate its other side.

use corpus.lib.fold;

var seq:    u64 = 0;
var hits:   [4]u64;
var stamps: [4]u64;

fun probe(id: u64, r: u8) u8 {
    seq = seq + 1;
    hits[id] = hits[id] + 1;
    stamps[id] = seq;
    ret r;
}

fun reset() {
    seq = 0;
    var i: u64 = 0;
    for (i < 4) {
        hits[i] = 0;
        stamps[i] = 0;
        i = i + 1;
    }
}

fun fold_state(h: u64) u64 {
    var a: u64 = fold.mix_u64(h, seq);
    var i: u64 = 0;
    for (i < 4) {
        a = fold.mix_u64(a, hits[i]);
        a = fold.mix_u64(a, stamps[i]);
        i = i + 1;
    }
    ret a;
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: u8 = seed::u8;

    # && short-circuits on a false left: right must not run
    reset();
    val r1: u8 = probe(0, 0u8) && probe(1, 1u8 ^ s);
    h = fold.mix_u8(h, r1);
    h = fold_state(h);

    # && evaluates a true left's right, left stamped before right
    reset();
    val r2: u8 = probe(0, 1u8) && probe(1, 1u8 ^ s);
    h = fold.mix_u8(h, r2);
    h = fold_state(h);

    # || short-circuits on a true left: right must not run
    reset();
    val r3: u8 = probe(0, 1u8) || probe(1, 0u8 ^ s);
    h = fold.mix_u8(h, r3);
    h = fold_state(h);

    # || evaluates a false left's right, left stamped before right
    reset();
    val r4: u8 = probe(0, 0u8) || probe(1, 1u8 ^ s);
    h = fold.mix_u8(h, r4);
    h = fold_state(h);

    # compound: both groups true, so all four probes run in source order
    reset();
    val r5: u8 = (probe(0, 0u8) || probe(1, 1u8)) && (probe(2, 0u8 ^ s) || probe(3, 1u8));
    h = fold.mix_u8(h, r5);
    h = fold_state(h);

    # compound: the left group short-circuits its own right (probe 1 never runs),
    # but the left group is true so && still evaluates the right group
    reset();
    val r6: u8 = (probe(0, 1u8) || probe(1, 1u8)) && (probe(2, 0u8) || probe(3, 1u8 ^ s));
    h = fold.mix_u8(h, r6);
    h = fold_state(h);

    # compound: the left group is false, so && short-circuits the entire right
    # group (probes 2 and 3 never run)
    reset();
    val r7: u8 = (probe(0, 0u8) || probe(1, 0u8 ^ s)) && (probe(2, 1u8) || probe(3, 1u8));
    h = fold.mix_u8(h, r7);
    h = fold_state(h);

    ret h;
}
