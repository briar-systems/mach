# all six predicates over u32 boundary pairs: zero/all-ones and both sides of the
# signed-boundary split (0x7fffffff / 0x80000000), each direction and the matching
# diagonals, so every predicate is exercised at both a true and a false result.

use corpus.lib.fold;

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: u32 = seed::u32;

    val UMAX: u32 = 4294967295;
    val HALF: u32 = 2147483648;
    val HMAX: u32 = 2147483647;

    # built by element assignment rather than a brace literal: indexing a
    # literal-initialized local array fails to lower for spirv today,
    # and per-element assignment is the equivalent spelling that avoids it
    var av: [7]u32;
    av[0] = 0;    av[1] = 0;    av[2] = UMAX; av[3] = HMAX;
    av[4] = HALF; av[5] = UMAX; av[6] = HALF;
    var bv: [7]u32;
    bv[0] = 0;    bv[1] = UMAX; bv[2] = 0;    bv[3] = HALF;
    bv[4] = HMAX; bv[5] = UMAX; bv[6] = HALF;

    var k: u64 = 0;
    for (k < 7) {
        val a: u32 = av[k] + s;
        val b: u32 = bv[k];
        h = fold.mix_u8(h, a == b);
        h = fold.mix_u8(h, a != b);
        h = fold.mix_u8(h, a < b);
        h = fold.mix_u8(h, a > b);
        h = fold.mix_u8(h, a <= b);
        h = fold.mix_u8(h, a >= b);
        k = k + 1;
    }
    ret h;
}
