# a three-way early-return chain (two tested arms and a fall-through return)
# reached from more than one call site in one function, and from inside a loop.
# the release pipeline inlines every copy, so the caller holds several copies of
# a selection whose arms all leave for the caller's join. every native target
# computes it; on spirv the o2 module is refused by the structurizer (see the
# spirv SKIPS entry), and this case is what deletes that entry when it is fixed.

use corpus.lib.fold;

fun pick(v: u32) u32 {
    if (v == 1) { ret 7; }
    or (v == 2) { ret 9; }
    ret 65535;
}

pub fun checksum(seed: u64) u64 {
    var h: u64 = fold.init();
    val s: u32 = seed::u32;
    h = fold.mix_u32(h, pick(s));
    h = fold.mix_u32(h, pick(s + 1));
    h = fold.mix_u32(h, pick(s + 2));
    var i: u32 = 0;
    for (i < 4) {
        h = fold.mix_u32(h, pick(i + s));
        i = i + 1;
    }
    ret h;
}
