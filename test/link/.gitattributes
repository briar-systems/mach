# the harness is bash and the goldens are byte-exact program stdout (LF); keep the
# whole tree LF on every host so a windows checkout does not turn an LF golden into
# CRLF and diverge every exec diff.
* text eol=lf

# decoded PE icon fixtures are real binary blobs (NUL-bearing); keep them out of
# the LF text normalization so a future replacement with CR/LF bytes survives.
*.ico binary

# fixture objects are Mach-O/COFF binaries: text normalization would corrupt any
# CR or LF byte they happen to carry
*.o binary
