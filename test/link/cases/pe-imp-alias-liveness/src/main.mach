# alias_probe_indirect reaches AliasProbe only through Clang's undefined
# __imp_AliasProbe object symbol; nothing here names AliasProbe directly, and
# nothing declares it as a #[library] import either - libaliasprobe.a's single
# import record is the only source of its DLL attribution.
ext fun alias_probe_indirect() u32;

#[symbol("mainCRTStartup")]
pub fun _start() {
    alias_probe_indirect();
}
