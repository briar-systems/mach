# SPIR-V Flat-decoration fixture: a fragment stage's non-interpolable inputs
#
# Vulkan requires a `Flat` decoration on any fragment-stage `Input` whose type is an
# integer or a 64-bit float, because neither can be interpolated across a primitive.
# `spirv-interface` cannot cover this: it declares an integer input, but no fragment
# stage there reaches one, and the per-stage reachability pass correctly keeps it
# out of the fragment entry point's list. That is the right answer when the fragment
# stage does not use the value and no answer at all for when it does, which is an
# ordinary thing to write - a material index or a per-vertex id passed through to
# the fragment stage is standard (#2747).
#
# EVERY ELEMENT CLASS THAT NEEDS THE DECORATION IS HERE, because the requirement is
# on the element and each class reaches it through different code: a scalar integer,
# a vector of integers, and a 64-bit float. A 32-bit float beside them is the
# control - it is the only interpolable element there is, and it must NOT be
# decorated, so a change that decorated every input would fail this case rather than
# passing it.

#[input(0)] var idx:   i32;
#[input(1)] var ids:   u32x3;
#[input(2)] var deep:  f64;
#[input(3)] var alpha: f32;

#[output(0)] var col: f32x4;

# a fragment stage reading all four. the three non-interpolable ones must each
# carry Flat and the `f32` must not, and all four have to be genuinely read: an
# unread input is dropped from the entry point's interface list and the rule stops
# applying to it, which would pass this case for the wrong reason.
#[stage("fragment")]
fun frag() {
    val k: i32 = idx;
    val l: u32 = ids[1];
    val d: f64 = deep;
    col = f32x4{k::f32, l::f32, d::f32, alpha};
}

# a second fragment stage reaching one of the same variables through a HELPER
# rather than directly. Flat is decided over what a stage can REACH, which is a
# transitive closure over calls, so a variable a stage only touches through a
# callee must be decorated exactly as one it touches itself.
fun helper() f32 { ret (idx * 2)::f32; }

#[stage("fragment")]
fun frag_indirect() {
    col = f32x4{helper(), 0.0, 0.0, 1.0};
}

fun main() i32 { ret 0; }
