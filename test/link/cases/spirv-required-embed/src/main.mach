# the consumer: embeds the shader artifact by its manifest output and reports what
# it carries, so the producer can compare it with the file the build delivered
use std.runtime;
use std.types.size.usize;
use p: std.print;

#[embed("{artifact.shader-tint.out}")]
val TINT: [_]u8;

#[symbol("main")]
fun main() i64 {
    var sum: u64   = 0;
    var i:   usize = 0;
    for (i < $length_of(TINT)) {
        sum = sum + TINT[i]::u64;
        i   = i + 1;
    }
    val magic: u32 = TINT[0]::u32 | (TINT[1]::u32 << 8) | (TINT[2]::u32 << 16) | (TINT[3]::u32 << 24);
    p.printlnf("magic={:x}", magic);
    p.printlnf("len={}", $length_of(TINT));
    p.printlnf("sum={}", sum);
    ret 0;
}
