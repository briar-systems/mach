# the required shader: a helper drawn in from the same module and a stage entry, so
# the delivered module is the entry module's whole reachable set

#[input(0)] var in_colour: f32x4;
#[output(0)] var out_colour: f32x4;

fun halve(v: f32x4) f32x4 {
    ret v * f32x4{0.5, 0.5, 0.5, 1.0};
}

#[stage("fragment")]
fun frag_main() {
    out_colour = halve(in_colour);
}
