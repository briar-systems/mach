# SPIR-V specialization-constant fixture: host-supplied values read at O2
#
# Nothing in the module writes `tile`, `gain` or `bias`, and each is initialized.
# That is the shape an optimizer folds to its initializer, and a module folded that
# way is valid SPIR-V: the pipeline would simply ignore the value the host supplied.
# The golden counts each spec constant's reads in the stage to hold them live.
#
# `tile` also sizes the workgroup, so the stage carries LocalSizeId over the spec
# constant rather than a LocalSize literal of 64.

rec Out {
    ints:   [64]u32;
    floats: [64]f32;
}

#[storage(0, 0)]
var out: Out;

#[builtin("global_invocation")]
var gid: u32x3;

#[spec(0)]
var tile: u32 = 64;
#[spec(7)]
var gain: f32 = 0.5;
#[spec(9)]
var bias: i32 = -3;

#[stage("compute")]
#[workgroup(tile, 1, 1)]
fun scale_main() {
    val i: u32 = gid[0] % tile;
    out.ints[i]   = i * tile + bias::u32;
    out.floats[i] = i::f32 * gain;
}
