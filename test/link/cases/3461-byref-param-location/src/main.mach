# a by-reference aggregate parameter has a -g location that reaches the object (#3461)
#
# `probe` takes a 32-byte record, which aapcs64, lp64d and win64 pass as the address
# of a caller-owned copy and sysv64 hands over in the caller's outgoing area. Its
# home is the incoming pointer, so the location has to say "the memory that pointer
# names": DW_OP_breg<n> while the pointer sits in a register, DW_OP_fbreg + DW_OP_deref
# once it is spilled. The call keeps the pointer alive across a clobber so the debug
# profile moves it into a callee-saved register.
use std.runtime;

pub rec Wide { a: i64; b: i64; c: i64; d: i64; }

#[noinline]
pub fun sink(a: i64) i64 {
    ret a + 1;
}

#[noinline]
pub fun probe(w: Wide, n: i64) i64 {
    val c0: i64 = sink(n);
    ret w.a + w.b + w.c + w.d + c0;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var w: Wide;
    w.a = argc;
    w.b = argc + 1;
    w.c = argc + 2;
    w.d = argc + 3;
    ret probe(w, argc) & 1;
}
