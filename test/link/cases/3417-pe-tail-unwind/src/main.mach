# a frame that ends in a tail jump, walked by windows' own unwinder (#3417)
#
# m_outer holds values across the call into c_touch, so its frame saves
# nonvolatile registers, and then tail-calls m_inner, whose own values across
# the call into c_unwind keep saves of its own; see case.conf.

use p: std.print;
use std.runtime;
use std.types.size.usize;

ext fun c_touch(v: i64) i64;
ext fun c_unwind(v: i64) i64;
ext fun c_drive(out: *i64) i64;

#[noinline]
#[symbol("m_inner")]
pub fun m_inner(seed: i64) i64 {
    val a: i64 = seed * 3;
    val b: i64 = seed + 7;
    val c: i64 = seed * seed;
    val d: i64 = seed - 11;
    val e: i64 = seed * 13;
    val f: i64 = seed + 17;
    val u: i64 = c_unwind(seed);
    ret a + b + c + d + e + f + u;
}

#[noinline]
#[symbol("m_outer")]
pub fun m_outer(seed: i64) i64 {
    val a: i64 = seed * 5;
    val b: i64 = seed + 3;
    val c: i64 = seed * seed;
    val d: i64 = seed - 2;
    val e: i64 = seed * 7;
    val f: i64 = seed + 19;
    val t: i64 = c_touch(seed);
    ret m_inner(a + b + c + d + e + f + t);
}

#[symbol("main")]
fun main(argc: usize, argv: **u8) i64 {
    var out: [10]i64;
    val r:   i64 = c_drive(?out[0]);
    p.printlnf("ret={} inner={}", r, out[0]);
    p.printlnf("rip={} rsp={}", out[1], out[2]);
    p.printlnf("rbx={} rsi={} rdi={}", out[3], out[4], out[5]);
    p.printlnf("r12={} r13={} r14={} r15={}", out[6], out[7], out[8], out[9]);
    ret 0;
}
