# a data import a shared library provides, read and written directly and through
# its taken address (mach #3941, #4035)

use p: std.print;
use std.runtime;

#[library("probe")]
ext var probe_value: i64;
#[library("probe")]
ext var probe_scale: f64;
#[library("probe")]
ext fun probe_get() i64;

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val direct: i64 = probe_value;
    val at: *i64 = ?probe_value;
    p.printlnf("read direct={} taken={}", direct, @at);
    probe_value = direct + 35 + argc;
    p.printlnf("stored direct lib={}", probe_get());
    @at = @at + 1;
    p.printlnf("stored taken lib={} direct={}", probe_get(), probe_value);
    p.printlnf("compared {}", probe_value == 44);
    probe_scale = probe_scale * 2.0;
    p.printlnf("float scale={}", probe_scale::i64);
    ret 0;
}
