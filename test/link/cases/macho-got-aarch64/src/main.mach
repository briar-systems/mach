# three `ext val` reads on aarch64-darwin, each an adrp/ldr pair through a GOT
# slot: two cells another object in this image defines under their C spelling
# (the linker owns and rebases those slots) and libSystem's `__stderrp`, whose
# slot dyld binds. the case is cross-built and inspected on the linux leg and
# executed only on a native arm64 macOS leg.
use case.provider;
use std.runtime;
use p: std.print;
use std.types.size.usize;

ext val cell8: u8;
ext val cell64: u64;
#[library("libSystem")] ext val __stderrp: *u8;

#[symbol("main")]
fun main(argc: usize, argv: **u8) i64 {
    p.printlnf("cell8={}", cell8::i64);
    p.printlnf("cell64={}", cell64::i64);
    var have_stderr: i64 = 0;
    if (__stderrp != nil) { have_stderr = 1; }
    p.printlnf("stderrp={}", have_stderr);
    if (cell8 != 7 || cell64 != 35 || have_stderr != 1) { ret 1; }
    ret 0;
}
