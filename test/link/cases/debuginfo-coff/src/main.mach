# DWARF-in-COFF fixture: two local modules and the std modules the program pulls
use dbgcoff.helper;
use p: std.print;
use std.runtime;

#[noinline]
#[symbol("square")]
fun square(v: i64) i64 {
    ret helper.mul(v, v);
}

#[symbol("main")]
fun main() i64 {
    p.printlnf("{}", square(7));
    p.printlnf("{}", pinned(1));
    ret 0;
}

#[noinline]
fun bump(v: i64) i64 {
    ret v + 1;
}

#[noinline]
fun addr(q: *u64) i64 {
    ret q::i64;
}

# `remat_mark` is one constant move, made while more values than the
# callee-saved registers hold stay live across calls, so the allocator builds
# it again where it is read rather than spill it and the variable's location
# is the constant it holds (#4185)
#[noinline]
fun pinned(seed: i64) i64 {
    var a:          i64  = bump(seed);
    var b:          i64  = bump(a);
    var c:          i64  = bump(b);
    var d:          i64  = bump(c);
    var e:          i64  = bump(d);
    var f:          i64  = bump(e);
    var g:          i64  = bump(f);
    var h:          i64  = bump(g);
    var j:          i64  = bump(h);
    var k:          i64  = bump(j);
    var l:          i64  = bump(k);
    var m:          i64  = bump(l);
    var n:          i64  = bump(m);
    var o:          i64  = bump(n);
    val remat_mark: *u64 = 4096::*u64;
    var i:          i64  = 0;
    for (i < 2) {
        a = bump(a + i);
        b = bump(b + i);
        c = bump(c + i);
        d = bump(d + i);
        e = bump(e + i);
        f = bump(f + i);
        g = bump(g + i);
        h = bump(h + i);
        j = bump(j + i);
        k = bump(k + i);
        l = bump(l + i);
        m = bump(m + i);
        n = bump(n + i);
        o = bump(o + i);
        i = i + 1;
    }
    ret a + b + c + d + e + f + g + h + j + k + l + m + n + o + addr(remat_mark);
}
