# DWARF-in-COFF fixture: two local modules and the std modules the program pulls
use dbgcoff.helper;
use p: std.print;
use std.runtime;

#[noinline]
#[symbol("square")]
fun square(v: i64) i64 {
    ret helper.mul(v, v);
}

#[symbol("main")]
fun main() i64 {
    p.printlnf("{}", square(7));
    ret 0;
}
