# regression pin for #2402: a zero-initialized global is inside the flat image
#
# `raw` stored file bytes only and said bare-metal startup would zero bss itself -
# but the linker exports no `__bss_start` / `__bss_end`, so no startup could find
# the region and nothing ever zeroed it. A 64-byte zero-init global landed at the
# first address PAST the end of a 48-byte image, and the loader, which copies the
# file and nothing else, left whatever the memory happened to hold.
#
# The shape is what matters here: a zero-initialized global larger than the code
# around it, so a writer that reverts to `filesz` produces an image visibly too
# short to contain it. `seeded` is present so the case also covers a real .data
# section sitting between the code and the bss.

var zeros:  [64]u8;
var seeded: [4]u8 = [4]u8{ 0xAA, 0xBB, 0xCC, 0xDD };

#[symbol("_start")]
fun start() i64 {
    var acc: i64 = 0;
    var i: i64 = 0;
    for (i < 64) {
        acc = acc + zeros[i]::i64;
        i = i + 1;
    }
    zeros[0] = seeded[0];
    ret acc;
}
