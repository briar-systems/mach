# a dependency's public surface: `dep_public` is `pub` and must NOT reach the
# library's export table, because a dependency's ABI is the dependency's, not the
# library's. the other two are reachable only because the root project re-exports
# them.
pub fun dep_public(n: i64) i64 { ret n + 100; }

pub fun chained_impl(n: i64) i64 { ret n + 200; }

#[symbol("case_renamed")]
pub fun renamed(n: i64) i64 { ret n + 300; }
