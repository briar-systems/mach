use std.types.size.usize;
use case.parts;

# a chain: this module re-exports `parts`'s re-export of a dependency's definition
fwd parts.chained_impl;
# a renamed declaration: the linker name the `#[symbol]` chose is what is exported
fwd helperdep.api.renamed;
# a whole module, whose own surface is a nested module alias
fwd helperdep.surface;

#[symbol("case_add")]
pub fun case_add(a: i64, b: i64) i64 { ret private_double(a) + b + parts.parts_add(1) + case_private(a); }

pub val CASE_VERSION: i64 = 5;

# private and reachable: in the image, bound locally, absent from the export table
#[noinline]
fun private_double(n: i64) i64 { ret n * 2; }

# private with a `#[symbol]` name a C consumer can spell: a name is not a
# visibility, so linking against it from outside the library must fail
#[symbol("case_private")]
fun case_private(n: i64) i64 { ret n + 7; }

# private and unreachable: link GC can drop it only because it is not an export
#[noinline]
fun private_dead(n: i64) i64 { ret n * 11; }

# a private global: storage the library keeps to itself
var case_calls: i64 = 0;
