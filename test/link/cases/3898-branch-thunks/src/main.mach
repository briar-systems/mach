# calls across 140 MB of code in both directions, through the thunks the link
# places for them (#3898)

use p: std.print;
use std.runtime;

ext fun head_call(x: i64) i64;
ext fun far_call(x: i64) i64;
ext fun far_tail(x: i64) i64;

#[symbol("near_add")]
pub fun near_add(x: i64) i64 {
    ret x + 1000;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    p.printlnf("head={} far={} tail={}", head_call(1), far_call(2), far_tail(3));
    ret 0;
}
