# a backtrace through C frames linked into a mach ELF image (#4048); see case.conf
use std.runtime;
use std.types.size.usize;

ext fun c_middle(depth: i64) i64;

#[noinline]
#[symbol("unwind_inner")]
pub fun unwind_inner(depth: i64) i64 {
    ret depth * 3 + 1;
}

#[noinline]
#[symbol("unwind_outer")]
pub fun unwind_outer(depth: i64) i64 {
    ret c_middle(depth + 1) + 1;
}

#[symbol("main")]
fun main(argc: usize, argv: **u8) i64 {
    if (unwind_outer(argc::i64) < 0) { ret 1; }
    ret 0;
}
