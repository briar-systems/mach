# a backtrace through C frames linked into a mach image (#4048); see case.conf
use p: std.print;
use std.runtime;
use std.types.size.usize;

ext fun probe_walk();
ext fun probe_run(out: *i64);

#[noinline]
#[symbol("unwind_inner")]
pub fun unwind_inner(depth: i64) i64 {
    probe_walk();
    ret depth + 1;
}

#[noinline]
#[symbol("unwind_outer")]
pub fun unwind_outer(depth: i64) i64 {
    ret c_middle(depth + 1) + 1;
}

ext fun c_middle(depth: i64) i64;

#[symbol("main")]
fun main(argc: usize, argv: **u8) i64 {
    var out: [5]i64;
    probe_run(?out[0]);
    p.printlnf("walk {}, inner {}, dwarf {}, middle {}, outer {}", out[0], out[1], out[2], out[3], out[4]);
    ret 0;
}
