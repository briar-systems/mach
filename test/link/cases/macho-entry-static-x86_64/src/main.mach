# the LC_UNIXTHREAD half of the darwin x86_64 entry contract (#2576): a non-PIE
# image is entered at the thread state's pc with the argument block on the stack.
# the same observable as the `--pie` sibling, so the pair proves one entrypoint
# satisfies both contracts rather than trading one for the other.
use std.runtime;
use std.types.string.str;
use std.types.string.str_ends_with;
use p: std.print;
use env: std.process.env;

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    p.printlnf("argc={}", argc);

    # the harness runs the artifact as out/int/prog, so the basename is fixed while
    # the leading directory is not.
    val a0: str = argv[0]::str;
    var named: i64 = 0;
    if (str_ends_with(a0, "prog")) { named = 1; }
    p.printlnf("argv0_is_prog={}", named);

    # envp reaches std.process.env through _rt_envp; a misread argument block
    # poisons it too, so the environment read is part of the observable.
    var buf: [256]u8;
    var have_path: i64 = 0;
    if (env.get("PATH", ?buf[0], 256) >= 0) { have_path = 1; }
    p.printlnf("env_path={}", have_path);

    ret 0;
}
