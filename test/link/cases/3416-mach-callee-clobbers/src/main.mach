# a mach callee writing to its by-value aggregate parameter, called from C (#3416)
#
# Each function overwrites every field of its parameter and returns what it wrote.
# The observable is what the C CALLER still holds afterwards, which C hands back and
# mach prints; see case.conf for why only a foreign caller can say it.

use p: std.print;
use std.runtime;
use std.types.size.usize;

rec Wide { a: i64; b: i64; c: i64; d: i64; }
rec Pair { a: i64; b: i64; }

ext fun c_drives_mach(out: *i64) i64;

#[symbol("m_clobber_wide")]
pub fun m_clobber_wide(w: Wide) i64 {
    w.a = -1;
    w.b = -2;
    w.c = -3;
    w.d = -4;
    ret w.a + w.b + w.c + w.d;
}

#[symbol("m_clobber_pair")]
pub fun m_clobber_pair(p: Pair) i64 {
    p.a = -5;
    p.b = -6;
    ret p.a + p.b;
}

#[symbol("main")]
fun main(argc: usize, argv: **u8) i64 {
    var out: [13]i64;
    val n: i64 = c_drives_mach(?out[0]);
    if (n != 13) {
        p.printlnf("probe reported {} results", n);
        ret 1;
    }
    p.printlnf("wide ret={} intact={} {} {} {}", out[0], out[1], out[2], out[3], out[4]);
    p.printlnf("pair ret={} intact={} {}", out[5], out[6], out[7]);
    p.printlnf("again ret={} intact={} {} {} {}", out[8], out[9], out[10], out[11], out[12]);
    ret 0;
}
