# riscv64 pc-relative hi/lo pair surface case (mach #2797)
#
# Calls into a clang-built riscv64 object whose globals and pooled constants are all
# reached through the psABI's `auipc` + `%pcrel_lo(.Lpcrel_hiK)` pair, and reads every
# value back BY VALUE. The failure this pins is a silent one: mach's linker resolved
# the low half of such a pair against the wrong pc, so each load came from a wrong
# address, and for the pooled-constant shape the wrong address held zero - which turns
# into a whole row of plausible zeros rather than a crash. Printing the values is the
# point; "it linked and exited 0" is exactly what the defect already did.

use std.runtime;
use std.types.size.usize;
use p: std.print;

# four doubles read through one materialized base pointer, each scaled by 1000
ext fun pcrel_doubles(out: *i64) i64;

# four longs read through one materialized base pointer, folded into one value
ext fun pcrel_longs() i64;

# a multiply by a clang-pooled float constant at a NON-ZERO section offset
ext fun scale(v: f64) i64;

# stores through the R_RISCV_PCREL_LO12_S spelling, each into a non-first element so
# the paired high half also carries a non-zero addend
ext fun store_long(v: i64) i64;
ext fun store_double(v: f64) i64;

#[symbol("main")]
fun main(argc: usize, argv: **u8) i64 {
    var d: [4]i64;
    val nd: i64 = pcrel_doubles(?d[0]);
    p.printlnf("doubles n={} {} {} {} {}", nd, d[0], d[1], d[2], d[3]);

    p.printlnf("longs={}", pcrel_longs());

    # 12.5 is the pooled scale; a wrong pool address reads 0.0 and every row is 0
    p.printlnf("scale={} {} {}", scale(2.0::f64), scale(8.0::f64), scale(100.0::f64));

    # the store spelling, read back through the same loaders. a store resolved to the
    # wrong address leaves the original value in place and corrupts something else, so
    # the readback moving is the assertion - not that the call returned.
    val s1: i64 = store_long(777::i64);
    val s2: i64 = store_double(2.5::f64);
    val n3: i64 = pcrel_doubles(?d[0]);
    p.printlnf("stored longs={} doubles={}", pcrel_longs(), d[3]);

    ret 0;
}
