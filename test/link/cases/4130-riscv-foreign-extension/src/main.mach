# a C object whose .riscv.attributes names Zfh, an extension mach has no codegen
# for, links with mach code and runs (mach #4130). see case.conf
use p: std.print;
use std.runtime;
use std.types.size.usize;

ext fun c_half_mul_add(a: u16, b: u16, c: u16) u16;

#[symbol("main")]
fun main(argc: usize, argv: **u8) i64 {
    # 1.5 * 2.0 + 0.25 and 3.0 * -0.5 + 1.0, each exact in binary16
    p.printlnf("zfh {} {}", c_half_mul_add(0x3E00, 0x4000, 0x3400), c_half_mul_add(0x4200, 0xB800, 0x3C00));
    ret 0;
}
