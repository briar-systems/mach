# a realigned mach frame unwound by windows' own unwinder (#4024)
#
# m_realigned's over-aligned local makes its prologue realign rsp, and the
# values it holds across the call into C keep callee-saved registers in use,
# so the frame saves them. c_unwind unwinds through it and reports what the
# caller would get back; see case.conf.

use p: std.print;
use std.runtime;
use std.types.size.usize;

#[align(64)]
rec Wide {
    a: i64;
    b: i64;
}

ext fun c_unwind(aligned: *Wide);
ext fun c_drive(out: *i64) i64;

#[symbol("m_realigned")]
pub fun m_realigned(seed: i64) i64 {
    var w: Wide;
    w.a = seed;
    w.b = seed * 2;
    val a: i64 = seed * 3;
    val b: i64 = seed + 7;
    val c: i64 = seed * seed;
    val d: i64 = seed - 11;
    val e: i64 = seed * 13;
    val f: i64 = seed + 17;
    val g: i64 = seed * 19;
    c_unwind(?w);
    ret a + b + c + d + e + f + g + w.a + w.b;
}

#[symbol("main")]
fun main(argc: usize, argv: **u8) i64 {
    var out: [10]i64;
    val r:   i64 = c_drive(?out[0]);
    p.printlnf("ret={} aligned={}", r, out[0]);
    p.printlnf("rip={} rsp={}", out[1], out[2]);
    p.printlnf("rbx={} rsi={} rdi={}", out[3], out[4], out[5]);
    p.printlnf("r12={} r13={} r14={} r15={}", out[6], out[7], out[8], out[9]);
    ret 0;
}
