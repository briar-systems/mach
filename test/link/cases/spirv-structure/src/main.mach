# SPIR-V structured control-flow fixture (#3371)
#
# each function is a control-flow shape the structurizer must express as nested
# constructs. `#[noinline]` keeps each one a function of its own, so its shape is
# the one written here rather than whatever inlining makes of it in the stage.

tag Shape: u8 {
    dot;
    line: f32;
    tri:  f32;
    quad: f32;
}

#[input(0)]
var which:  u32;
#[input(1)]
var amount: f32;

#[output(0)]
var col: f32x4;

fun pick(w: u32, a: f32) Shape {
    if (w == 0) { ret Shape.dot{}; }
    if (w == 1) { ret Shape.line{a}; }
    if (w == 2) { ret Shape.tri{a}; }
    ret Shape.quad{a};
}

# a chain of four `sel` tests: every arm reconverges on one block
#[noinline]
fun weigh(s: Shape) f32 {
    var r: f32 = 0.0;
    if (sel s.dot)  { r = 1.0; }
    or (sel s.line) { r = s.line * 2.0; }
    or (sel s.tri)  { r = s.tri * 3.0; }
    or (sel s.quad) { r = s.quad * 4.0; }
    ret r;
}

# a loop left from two `brk` sites as well as through its condition
#[noinline]
fun two_breaks(n: u32) f32 {
    var i: u32 = 0;
    var r: f32 = 0.0;
    for (i < n) {
        if (i == 7) {
            r = 1.0;
            brk;
        }
        if (i == 11) {
            r = 2.0;
            brk;
        }
        i = i + 1;
    }
    ret r;
}

# two `if`s that fall into one block
#[noinline]
fun two_ifs(a: u32, b: u32) f32 {
    var r: f32 = 0.0;
    if (a > 3) {
        if (b > 4) { r = 1.0; }
    }
    ret r;
}

# an early return from a loop, inlined into flag: at O2 the loop's exits only
# meet at the continuation the returns join, past the selection the loop sits in,
# so the loop merges on an exit dispatch
fun hit(found: u32, n: u32, key: u32) u32 {
    if (found == 0) { ret 0; }
    var i: u32 = 0;
    for (i < n) {
        if (i * 7 == key) { ret 1; }
        i = i + 1;
    }
    ret 0;
}

#[noinline]
fun flag(n: u32) u32 {
    ret hit(n & 4, n, which);
}

#[stage("fragment")]
fun frag() {
    val s: Shape = pick(which, amount);
    var f: f32   = 0.0;
    if (flag(which + 1) != 0) { f = 1.0; }
    col = f32x4{weigh(s), two_breaks(which), two_ifs(which, which + 1), f};
}

fun main() i32 {
    ret 0;
}
