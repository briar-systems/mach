# the negative direction: the pinned name is in no manifest in the build. the
# refusal stands, and the message lists the logical names the link does provide so
# the mismatch is visible without reading three manifests.
#
# the symbol is undefined here for the same reason as in the sibling case: a pin is
# only ever consulted for a symbol nothing in the link defines, so a case whose
# symbol resolves cannot reach the check at all. the two cases differ in exactly one
# thing - whether the pinned NAME is in the effective link set - which is the
# distinction under test.

use std.runtime;
use std.print;
use std.types.size.usize;

#[library("no-such-library")]
ext fun provider_valu() i32;

#[symbol("main")]
fun main(argc: usize, argv: **u8) i64 {
    print.printlnf("provider={}", provider_valu());
    ret 0;
}
