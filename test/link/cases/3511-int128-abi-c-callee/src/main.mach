# 128-bit integer transport against a C callee and a C caller (mach #3511)
#
# Every function below is paired with one in probe.c of matching signature; see
# case.conf for what each position proves. The observable is a small integer each
# side computes from the two halves of the value and the argument after it, printed
# by mach.

use p: std.print;
use std.runtime;
use std.types.size.usize;

ext fun c_u128(v: u128, next: i64) i64;
ext fun c_i128(v: i128, next: i64) i64;
ext fun c_odd(first: i64, v: u128, next: i64) i64;
ext fun c_six(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, v: u128, next: i64) i64;
ext fun c_seven(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, v: u128, next: i64) i64;
ext fun c_fmix(x: f64, v: u128, y: f64, next: i64) i64;
ext fun c_mk_u128(lo: i64, hi: i64) u128;
ext fun c_mk_i128(x: i64) i128;
ext fun c_drives_mach() i64;

fun halves(v: u128, next: i64) i64 {
    ret (v >> 64)::i64 * 100 + v::i64 + next * 1000;
}

#[symbol("m_u128")]
pub fun m_u128(v: u128, next: i64) i64 {
    ret halves(v, next);
}

#[symbol("m_i128")]
pub fun m_i128(v: i128, next: i64) i64 {
    ret (v >> 64)::i64 * 100 + v::i64 + next * 1000;
}

#[symbol("m_odd")]
pub fun m_odd(first: i64, v: u128, next: i64) i64 {
    ret first * 10000 + halves(v, next);
}

#[symbol("m_six")]
pub fun m_six(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, v: u128, next: i64) i64 {
    ret (a + b + c + d + e + f) * 10000 + halves(v, next);
}

#[symbol("m_seven")]
pub fun m_seven(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, v: u128, next: i64) i64 {
    ret (a + b + c + d + e + f + g) * 10000 + halves(v, next);
}

#[symbol("m_fmix")]
pub fun m_fmix(x: f64, v: u128, y: f64, next: i64) i64 {
    ret (x * 2.0)::i64 * 10000 + halves(v, next) + (y * 2.0)::i64 * 100000;
}

#[symbol("m_mk_u128")]
pub fun m_mk_u128(lo: i64, hi: i64) u128 {
    ret (hi::u128 << 64) | lo::u128;
}

#[symbol("m_mk_i128")]
pub fun m_mk_i128(x: i64) i128 {
    ret x::i128 * 3;
}

fun mk(lo: i64, hi: i64) u128 {
    ret (hi::u128 << 64) | lo::u128;
}

#[symbol("main")]
fun main(argc: usize, argv: **u8) i64 {
    val v: u128 = mk(7, 3);
    p.printlnf("mach->c u128={} i128={} odd={} six={} seven={} fmix={}",
        c_u128(v, 1), c_i128(-5, 2), c_odd(9, v, 3), c_six(1, 2, 3, 4, 5, 6, v, 4),
        c_seven(1, 2, 3, 4, 5, 6, 7, v, 5), c_fmix(1.5, v, 2.5, 6));
    val ru: u128 = c_mk_u128(11, 13);
    val ri: i128 = c_mk_i128(-17);
    p.printlnf("c->mach u128={} i128_lo={} i128_hi={}",
        (ru >> 64)::i64 * 100 + ru::i64, ri::i64, (ri >> 64)::i64);
    p.printlnf("c drives mach: {}", c_drives_mach());
    ret 0;
}
