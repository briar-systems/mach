# a bool-returning `op` under an environment without Int8 (#4302)

rec Out {
    ints: [8]u32;
}

#[storage(0, 0)]
var out: Out;

#[builtin("global_invocation")]
var gid: u32x3;

#[op("spirv", "core", "OpGroupNonUniformElect")]
fun elect(scope: u32) u8;

#[stage("compute")]
#[workgroup(8, 1, 1)]
fun elect_main() {
    if (elect(3)) { out.ints[0] = gid[0]; }
    val first: u8 = elect(3);
    if (first) { out.ints[1] = 1; }
}
