# the entry is naked and reaches nothing, so `keep` is collected by link GC
# while its .debug_info subprogram still names it by address; that address
# is written as the tombstone at the width of the field

#[naked] #[symbol("_start")]
fun start() {
    asm riscv32 {
        ebreak
    }
}

pub fun keep(seed: u64) u64 {
    var a: u64 = seed * 7;
    ret a + 1;
}
