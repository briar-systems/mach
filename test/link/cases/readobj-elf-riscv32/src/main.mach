# a freestanding riscv32 image for the readobj producer: the ELFCLASS32 static
# writer and the ELFCLASS32 relocatable writer are the RV32 paths #3113 has to
# preserve, and this is the only harness case that exercises them. 32-bit values
# only: the riscv32 backend does not legalize wider ones. the entry spins.
var table: [8]u32;
var seeds: [4]u32;
var sink:  u32 = 0;

fun checksum(seed: u32) u32 {
    var acc: u32 = seed;
    seeds[0] = 1;
    seeds[1] = 2;
    seeds[2] = 3;
    seeds[3] = 4;
    var i: u32 = 0;
    for (i < 8) {
        table[i] = acc * 3 + seeds[i % 4];
        acc      = acc ^ table[i];
        i        = i + 1;
    }
    ret acc;
}

#[symbol("_start")]
fun start() {
    sink = checksum(7);
    var spin: u32 = 1;
    for (spin != 0) {
        spin = sink & 0;
        spin = 1;
    }
}
