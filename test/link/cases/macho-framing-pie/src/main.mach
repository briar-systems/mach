# a minimal linked program for the macho-framing producer. the producer reads the
# emitted image's load commands host-side and never executes it, so the body only
# has to link, and it needs code, data, read-only data, and a zero-initialized
# global large enough to land in __bss, so every mapped segment the framing
# describes is actually present
use std.runtime;
use std.types.size.usize;

val greeting: *u8   = "framing";
var counter:  usize = 0;
var scratch:  [8192]u8;

#[symbol("main")]
fun main(argc: usize, argv: **u8) i64 {
    scratch[0] = greeting[0];
    counter    = counter + scratch[0]::usize;
    ret 0;
}
