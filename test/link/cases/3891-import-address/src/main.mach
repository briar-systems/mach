# a function import's address taken, not called (mach #3891), and equal to the
# library's own pointer to it (mach #3942)

use p: std.print;
use std.runtime;

#[library("probe")]
ext fun probe_twice(x: i64) i64;
#[library("probe")]
ext fun probe_apply(f: fun(i64) i64, x: i64) i64;
#[library("probe")]
ext fun probe_is_twice(f: fun(i64) i64) i64;

def Unary: fun(i64) i64;
def Apply: fun(fun(i64) i64, i64) i64;

fun thrice(x: i64) i64 { ret x * 3; }

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val twice: Unary = probe_twice;
    val apply: Apply = probe_apply;
    p.printlnf("called-through twice={} apply={}", twice(20 + argc), apply(thrice, 6 + argc));
    p.printlnf("callback c->import={} c->mach={}", probe_apply(probe_twice, 20 + argc), probe_apply(thrice, 6 + argc));
    p.printlnf("canonical taken={} passed={}", probe_is_twice(twice), probe_is_twice(probe_twice));
    ret 0;
}
