# a minimal linked program for the readobj producer: code, initialized data,
# read-only data and zero-filled data, so every section kind the writer plans
# is present in the image and in the relocatable objects it links from
use std.runtime;
use std.types.size.usize;

val greeting: *u8 = "readobj";
var counter: usize = 0;
var zeroed: [64]usize;

#[symbol("main")]
fun main(argc: usize, argv: **u8) i64 {
    counter = counter + greeting[0]::usize + zeroed[argc % 64];
    ret 0;
}
