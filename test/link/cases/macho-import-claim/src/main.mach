# manifest-declared symbol claiming on Mach-O (#2636). `Sleep` and `Beep` carry no
# #[library] decorator: they stand in for the system references a vendored static
# archive leaves undefined, which reach the link with no Mach declaration to
# decorate. Their providing dylib comes from the `symbols` key on each [link.X].
#
# Both are spelled here, and in mach.toml, WITHOUT darwin's `_` prefix. That is
# the whole point: one manifest spelling has to be correct on every target, and
# the prefix is applied by the target, not written by the user.
ext fun Sleep(ms: u32);

ext fun Beep(hz: u32);

# the decorator path still works and must land in the same dylib as the
# manifest-claimed System import
#[library("System")]
ext fun ExitProcess(code: u32);

#[symbol("start")]
pub fun _start() {
    Sleep(0);
    Beep(0);
    ExitProcess(0);
}
