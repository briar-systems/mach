# tag transport against a C callee and a C caller (mach #3218)
#
# Every function below is paired with one in probe.c of matching layout; see case.conf
# for what the pairing proves. The observable is the value each side computed from the
# discriminator, the payload and the argument after the tag, printed by mach.

use p: std.print;
use std.runtime;
use std.types.size.usize;

tag P1:   u8 { a; b; }
tag T3:   u8 { a; b: [2]u8; }
tag S8:   u8 { a; b: u32; }
tag T9:   u8 { a; b: [8]u8; }
tag T16:  u8 { a; b: i64; }
tag O24:  u8 { a; b: [2]i64; c: u8; }
tag Nest: u8 { a; b: S8; }
#[align(16)]
tag AL16: u8 { a; b: u8; }
tag TF:   u8 { a; b: f64; }
tag TF8:  u8 { a; b: f32; }
tag TFM:  u8 { a; b: f64; c: i64; }
#[packed]
tag PK9: u8 { a; b: i64; }
#[packed]
tag PKA: u64 { a; b: i64; }

ext fun c_p1(v: P1, next: i64) i64;
ext fun c_t3(v: T3, next: i64) i64;
ext fun c_s8(v: S8, next: i64) i64;
ext fun c_t9(v: T9, next: i64) i64;
ext fun c_t16(v: T16, next: i64) i64;
ext fun c_o24(v: O24, next: i64) i64;
ext fun c_nest(v: Nest, next: i64) i64;
ext fun c_al16(v: AL16, next: i64) i64;
ext fun c_al16_after(first: i64, v: AL16, next: i64) i64;
ext fun c_tf(v: TF, next: i64) i64;
ext fun c_tf8(v: TF8, next: i64) i64;
ext fun c_tfm(v: TFM, next: i64) i64;
ext fun c_mk_p1(d: u8) P1;
ext fun c_mk_t3(x: u8) T3;
ext fun c_mk_s8(x: u32) S8;
ext fun c_mk_t9(x: u8) T9;
ext fun c_mk_t16(x: i64) T16;
ext fun c_mk_o24(x: i64) O24;
ext fun c_mk_nest(x: u32) Nest;
ext fun c_mk_al16(x: u8) AL16;
ext fun c_mk_tf(x: f64) TF;
ext fun c_mk_tf8(x: f32) TF8;
ext fun c_mk_tfm(x: i64) TFM;
ext fun c_pk9(v: PK9, next: i64) i64;
ext fun c_pka(v: PKA, next: i64) i64;
ext fun c_mk_pk9(x: i64) PK9;
ext fun c_mk_pka(x: i64) PKA;
ext fun c_drives_mach() i64;

#[symbol("m_t3")]
pub fun m_t3(v: T3, next: i64) i64 {
    if (sel v.b) { ret 100 + v.b[0]::i64 + v.b[1]::i64 * 10 + next * 1000; }
    ret -1;
}

#[symbol("m_t9")]
pub fun m_t9(v: T9, next: i64) i64 {
    if (sel v.b) { ret 100 + v.b[0]::i64 + v.b[7]::i64 * 10 + next * 1000; }
    ret -1;
}

#[symbol("m_al16")]
pub fun m_al16(v: AL16, next: i64) i64 {
    if (sel v.b) { ret 100 + v.b::i64 + next * 1000; }
    ret -1;
}

#[symbol("m_al16_after")]
pub fun m_al16_after(first: i64, v: AL16, next: i64) i64 {
    if (sel v.b) { ret first + 100 + v.b::i64 + next * 1000; }
    ret -1;
}

#[symbol("m_tf")]
pub fun m_tf(v: TF, next: i64) i64 {
    if (sel v.b) { ret 100 + v.b::i64 + next * 1000; }
    ret -1;
}

#[symbol("m_o24")]
pub fun m_o24(v: O24, next: i64) i64 {
    if (sel v.b) { ret 100 + v.b[0] + v.b[1] * 10 + next * 1000; }
    ret -1;
}

#[symbol("m_mk_t9")]
pub fun m_mk_t9(x: u8) T9 {
    var a: [8]u8;
    a[0] = x;
    a[7] = x + 1;
    ret T9.b{a};
}

#[symbol("m_mk_al16")]
pub fun m_mk_al16(x: u8) AL16 {
    ret AL16.b{x};
}

#[symbol("m_mk_tf")]
pub fun m_mk_tf(x: f64) TF {
    ret TF.b{x};
}

#[symbol("m_mk_t3")]
pub fun m_mk_t3(x: u8) T3 {
    var a: [2]u8;
    a[0] = x;
    a[1] = x + 1;
    ret T3.b{a};
}

#[symbol("m_pk9")]
pub fun m_pk9(v: PK9, next: i64) i64 {
    if (sel v.b) { ret 100 + v.b + next * 1000000; }
    ret -1;
}

#[symbol("m_pka")]
pub fun m_pka(v: PKA, next: i64) i64 {
    if (sel v.b) { ret 100 + v.b + next * 1000000; }
    ret -1;
}

#[symbol("m_mk_pk9")]
pub fun m_mk_pk9(x: i64) PK9 {
    ret PK9.b{x};
}

#[symbol("m_mk_pka")]
pub fun m_mk_pka(x: i64) PKA {
    ret PKA.b{x};
}

fun code(v: u8) i64 {
    ret v::i64;
}

#[symbol("main")]
fun main(argc: usize, argv: **u8) i64 {
    var a3: [2]u8;
    a3[0] = 4;
    a3[1] = 5;
    var a9: [8]u8;
    a9[0] = 5;
    a9[7] = 6;
    var a24: [2]i64;
    a24[0] = 8;
    a24[1] = 9;
    p.printlnf("mach->c p1={} t3={} s8={} t9={} t16={} o24={}",
        c_p1(P1.b{}, 7), c_t3(T3.b{a3}, 1), c_s8(S8.b{9}, 2), c_t9(T9.b{a9}, 2), c_t16(T16.b{-3}, 3), c_o24(O24.b{a24}, 5));
    p.printlnf("mach->c nest={} al16={} al16_after={} tf={} tf8={} tfm={}",
        c_nest(Nest.b{S8.b{6}}, 4), c_al16(AL16.b{6}, 3), c_al16_after(9, AL16.b{6}, 3), c_tf(TF.b{7.5}, 4), c_tf8(TF8.b{2.5}, 1), c_tfm(TFM.c{-9}, 2));
    val r1:    P1     = c_mk_p1(1);
    val r3:    T3     = c_mk_t3(4);
    val r8:    S8     = c_mk_s8(0x01020304);
    val r9:    T9     = c_mk_t9(7);
    val r16:   T16    = c_mk_t16(-11);
    val r24:   O24    = c_mk_o24(12);
    var line1: [6]i64 = [6]i64{-1, -1, -1, -1, -1, -1};
    if (sel r1.b)  { line1[0] = 1; }
    if (sel r3.b)  { line1[1] = code(r3.b[0]) * 100 + code(r3.b[1]); }
    if (sel r8.b)  { line1[2] = r8.b::i64; }
    if (sel r9.b)  { line1[3] = code(r9.b[0]) * 100 + code(r9.b[7]); }
    if (sel r16.b) { line1[4] = r16.b; }
    if (sel r24.b) { line1[5] = r24.b[0] * 100 + r24.b[1]; }
    p.printlnf("c->mach p1={} t3={} s8={} t9={} t16={} o24={}", line1[0], line1[1], line1[2], line1[3], line1[4], line1[5]);
    val rn:    Nest   = c_mk_nest(14);
    val ral:   AL16   = c_mk_al16(15);
    val rtf:   TF     = c_mk_tf(16.5);
    val rtf8:  TF8    = c_mk_tf8(2.5);
    val rtfm:  TFM    = c_mk_tfm(-17);
    var line2: [5]i64 = [5]i64{-1, -1, -1, -1, -1};
    if (sel rn.b) {
        if (sel rn.b.b) { line2[0] = rn.b.b::i64; }
    }
    if (sel ral.b)  { line2[1] = ral.b::i64; }
    if (sel rtf.b)  { line2[2] = (rtf.b * 2.0)::i64; }
    if (sel rtf8.b) { line2[3] = (rtf8.b * 2.0)::i64; }
    if (sel rtfm.c) { line2[4] = rtfm.c; }
    p.printlnf("c->mach nest={} al16={} tf2={} tf8x2={} tfm={}", line2[0], line2[1], line2[2], line2[3], line2[4]);
    p.printlnf("mach->c pk9={} pka={}", c_pk9(PK9.b{-5000000000}, 8), c_pka(PKA.b{21}, 9));
    val rpk9:  PK9    = c_mk_pk9(-6000000000);
    val rpka:  PKA    = c_mk_pka(22);
    var line3: [2]i64 = [2]i64{-1, -1};
    if (sel rpk9.b) { line3[0] = rpk9.b; }
    if (sel rpka.b) { line3[1] = rpka.b; }
    p.printlnf("c->mach pk9={} pka={}", line3[0], line3[1]);
    p.printlnf("c drives mach: {}", c_drives_mach());
    ret 0;
}
