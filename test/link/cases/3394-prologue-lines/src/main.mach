# prologue line-attribution fixture (#3394)
#
# `main` calls one std function and nothing else, so at -O2 the inliner puts a
# callee from another file at the top of its body. the check asserts that the
# function's entry address still resolves to this file's `fun main` line, which
# is what a symbolizer and an asm view read for the frame setup.

use std.runtime;
use std.types.size.usize;
use p: std.print;

#[symbol("main")]
fun main(argc: usize, argv: **u8) i64 {
    p.println("prologue");
    ret 0;
}
