# .symtab presence/correctness fixture (#2772), built `kind = "shared"` here
# (#2807 - test/link/cases/symtab/src/main.mach is the identical static-executable
# twin). neither function is `pub`, so the shared writer's own export table
# (.dynsym) never claims either one - both live only in `.symtab`, keeping
# this case about the same table the static twin tests, not a second one.
#
# unlike test/link/cases/debuginfo, this case needs no `-g`: the fact under test is
# that a PLAIN build - the shape every shipped release binary actually has -
# carries a real ELF symbol table, which structural DWARF verification cannot
# speak to at all (DWARF is a `-g`-only concern; `.symtab` is not).
#
# `main` is `pub` because a shared library exports the root project's `pub`
# declarations and nothing else (#3412): with no export at all the link has no
# GC root, and the image comes out empty rather than carrying the symbol table
# this case is about. `burn` stays private, so the case covers both bindings.
#
# `burn` is intentionally sizable (a real loop, not a one-liner) so its `st_size`
# is large enough that an address well inside its body - not just at its entry -
# can be resolved back to it, which is the fact a profiler actually needs
# (attributing a sample mid-function, not only at a call's return address).
use std.runtime;
use p: std.print;
use std.types.size.usize;

# `#[noinline]` because this case needs `burn` to exist as a function in the
# image: at `opt = 2` it is small enough to inline into its only caller, and with
# #3412 a private definition nothing references is dead and link GC drops it, so
# the release leg would have no mid-function address to resolve
#[noinline]
fun burn(n: i64) i64 {
    var total: i64 = 0;
    var i:     i64 = 0;
    for (i < n) {
        total = total + i;
        i     = i + 1;
    }
    ret total;
}

#[symbol("main")]
pub fun main(argc: usize, argv: **u8) i64 {
    val r: i64 = burn(1000 + argc:~i64);
    p.printlnf("r={}", r);
    ret 0;
}
