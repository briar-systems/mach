# narrow integer arguments against a C callee and a C caller (mach #3927)
#
# Every function below is paired with one in probe.c; see case.conf for what each
# proves. Each argument is computed from a runtime value whose bits 8 to 31 are not
# zero, so a caller that does not extend leaves them in the register.

use p: std.print;
use std.runtime;
use std.types.size.usize;

ext fun c_narrow(a: u8, b: i8, c: u16, d: i16, next: i64) i64;
ext fun c_widened(a: u8, b: i8, c: u16, d: i16) i64;
ext fun c_widened_a() i64;
ext fun c_widened_b() i64;
ext fun c_widened_c() i64;
ext fun c_widened_d() i64;
ext fun c_drives_mach() i64;

#[symbol("m_narrow")]
pub fun m_narrow(a: u8, b: i8, c: u16, d: i16, next: i64) i64 {
    ret a::i64 + b::i64 * 1000 + c::i64 * 1000000 + d::i64 * 10000000000 + next;
}

#[symbol("main")]
fun main(argc: usize, argv: **u8) i64 {
    val x: u64 = 0x3c3c3c00 + argc::u64;
    p.printlnf("mach->c narrow={}", c_narrow((x + 0x80)::u8, (x + 0x81)::i8, (x + 0x8000)::u16, (x + 0x8100)::i16, 7));
    c_widened((x + 0x80)::u8, (x + 0x81)::i8, (x + 0x8000)::u16, (x + 0x8100)::i16);
    p.printlnf("widened a={} b={} c={} d={}", c_widened_a(), c_widened_b(), c_widened_c(), c_widened_d());
    p.printlnf("c drives mach: {}", c_drives_mach());
    ret 0;
}
