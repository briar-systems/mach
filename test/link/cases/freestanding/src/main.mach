# freestanding x86_64 flat-image (raw) build fixture
#
# no OS and no std runtime: the entry symbol is defined here and the program
# exits through a raw `exit` syscall. it proves the object-centric build path
# reaches a flat image for an `os=freestanding, of=raw` target - codegen builds
# an in-memory image per module, the driver links straight from those images (no
# per-module `.o` round-trip, which a flat image has no parser for), and the raw
# writer lays the single load segment out as a container-free binary entered at
# its base.
#
# the exit code starts from an `#[embed]`ed byte (0x2d = 45), so the embedded
# bytes must land in the flat image at an address the code resolves with no
# loader, no section table and no runtime (#2507). a counted loop then adds the
# sum 0..9 (45), so running the image asserts the emitted machine code is correct
# end to end: 90.
#
# `start` is the only function, so its code begins at file offset 0 (the image
# base), satisfying raw's entry-at-base contract; the embed's data follows it.
#
# the f16 arithmetic and conversions are inlined integer and binary64 code, so
# the image links them with no runtime helper to provide (#3799). their check
# adds 0 when every result is the correctly rounded one.

#[embed("blob.bin")]
val BLOB: [_]u8;

#[symbol("_start")]
fun start() {
    val q:    f16 = BLOB[0]::f16 / 7.0f16;
    val r:    f16 = q + 0.1f16;
    var code: i64 = BLOB[0]::i64 + (q:~u16)::i64 - 0x466E + (r:~u16)::i64 - 0x4688 + (q::f64 * 1000.0)::i64 - 6429;
    var i:    i64 = 0;
    for (i < 10) {
        code = code + i;
        i    = i + 1;
    }
    asm x86_64 {
        mov rax, 60      # __NR_exit
        mov rdi, {code}  # exit code = BLOB[0] + sum 0..9 = 90
        syscall
    }
}
