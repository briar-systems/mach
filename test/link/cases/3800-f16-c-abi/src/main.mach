# f16 against a C `_Float16` callee and a C caller (mach #3800)
#
# Every function below is paired with one in probe.c of matching signature; see
# case.conf for what each position proves. The observable is a small integer each
# side computes from the bits of its arguments, printed by mach.

use p: std.print;
use std.runtime;
use std.types.size.usize;

rec H2 { a: f16; b: f16; }
rec HI { a: f16; b: i32; }
rec HF { a: f16; b: f32; }
rec H4 { v: [4]f16; }
rec H5 { v: [5]f16; }

ext fun c_scalars(a: i32, x: f16, d: f64, y: f16, f: f32, b: i64) i64;
ext fun c_nine(x0: f16, x1: f16, x2: f16, x3: f16, x4: f16, x5: f16, x6: f16, x7: f16, x8: f16, tail: i32) i64;
ext fun c_flip(x: f16, k: i32) f16;
ext fun c_recs(p: H2, q: HI, r: HF, s: H4, t: H5) i64;
ext fun c_r2(a: f16, b: f16) H2;
ext fun c_ri(a: f16, b: i32) HI;
ext fun c_rf(a: f16, b: f32) HF;
ext fun c_r4(a: f16) H4;
ext fun c_drives_mach() i64;

fun bits(x: f16) i64 {
    ret (x:~u16)::i64;
}

fun mk(u: u16) f16 {
    ret u:~f16;
}

#[symbol("m_scalars")]
pub fun m_scalars(a: i32, x: f16, d: f64, y: f16, f: f32, b: i64) i64 {
    ret a::i64 + 2 * bits(x) + 3 * (d * 4.0)::i64 + 4 * bits(y) + 5 * (f * 4.0)::i64 + 6 * b;
}

#[symbol("m_nine")]
pub fun m_nine(x0: f16, x1: f16, x2: f16, x3: f16, x4: f16, x5: f16, x6: f16, x7: f16, x8: f16, tail: i32) i64 {
    ret bits(x0) + 2 * bits(x1) + 3 * bits(x2) + 4 * bits(x3) + 5 * bits(x4) + 6 * bits(x5)
        + 7 * bits(x6) + 8 * bits(x7) + 9 * bits(x8) + 10 * tail::i64;
}

#[symbol("m_flip")]
pub fun m_flip(x: f16, k: i32) f16 {
    if (k == 0) { ret x; }
    ret mk((x:~u16) ^ 0x8000);
}

#[symbol("m_recs")]
pub fun m_recs(p: H2, q: HI, r: HF, s: H4, t: H5) i64 {
    var sum: i64 = bits(p.a) + 2 * bits(p.b) + 3 * bits(q.a) + 4 * q.b::i64 + 5 * bits(r.a) + 6 * (r.b * 4.0)::i64;
    var i:   u32 = 0;
    for (i < 4) {
        sum = sum + (7 + i)::i64 * bits(s.v[i]);
        i   = i + 1;
    }
    i = 0;
    for (i < 5) {
        sum = sum + (11 + i)::i64 * bits(t.v[i]);
        i   = i + 1;
    }
    ret sum;
}

#[symbol("m_r2")]
pub fun m_r2(a: f16, b: f16) H2 {
    ret H2{a: b, b: a};
}

#[symbol("m_ri")]
pub fun m_ri(a: f16, b: i32) HI {
    ret HI{a: a, b: b * 3};
}

#[symbol("m_rf")]
pub fun m_rf(a: f16, b: f32) HF {
    ret HF{a: a, b: b * 2.0};
}

#[symbol("m_r4")]
pub fun m_r4(a: f16) H4 {
    var r: H4;
    var i: u16 = 0;
    for (i < 4) {
        r.v[i] = mk((a:~u16) + i);
        i      = i + 1;
    }
    ret r;
}

#[symbol("main")]
fun main(argc: usize, argv: **u8) i64 {
    val x: f16 = mk(0x3E00);
    val y: f16 = mk(0xC080);
    p.printlnf("mach->c scalars={} mach={}", c_scalars(7, x, 2.5, y, 1.25, 9), m_scalars(7, x, 2.5, y, 1.25, 9));
    p.printlnf("mach->c nine={} mach={}",
        c_nine(mk(1), mk(2), mk(3), mk(4), mk(5), mk(6), mk(7), mk(8), mk(9), 10),
        m_nine(mk(1), mk(2), mk(3), mk(4), mk(5), mk(6), mk(7), mk(8), mk(9), 10));
    p.printlnf("mach->c flip={} {}", bits(c_flip(x, 0)), bits(c_flip(x, 1)));
    val hp: H2 = H2{a: mk(0x3C00), b: mk(0x4000)};
    val hq: HI = HI{a: mk(0x4200), b: 5};
    val hr: HF = HF{a: mk(0x4400), b: 2.5};
    val hs: H4 = H4{v: [4]f16{mk(0x4500), mk(0x4600), mk(0x4700), mk(0x4800)}};
    val ht: H5 = H5{v: [5]f16{mk(0x4880), mk(0x4900), mk(0x4980), mk(0x4A00), mk(0x4A80)}};
    p.printlnf("mach->c recs={} mach={}", c_recs(hp, hq, hr, hs, ht), m_recs(hp, hq, hr, hs, ht));
    val r2: H2 = c_r2(x, y);
    val ri: HI = c_ri(y, 11);
    val rf: HF = c_rf(x, 1.5);
    val r4: H4 = c_r4(y);
    p.printlnf("c->mach r2={} {} ri={} {} rf={} {}", bits(r2.a), bits(r2.b), bits(ri.a), ri.b, bits(rf.a), (rf.b * 4.0)::i64);
    p.printlnf("c->mach r4={} {} {} {}", bits(r4.v[0]), bits(r4.v[1]), bits(r4.v[2]), bits(r4.v[3]));
    p.printlnf("c drives mach: {}", c_drives_mach());
    ret 0;
}
