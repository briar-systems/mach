# narrow integers in function storage under an environment without Int8 (#4302)
#
# `x` is a truth value held in a u8 local, and `a` and `c` wrap at eight bits.

rec Out {
    ints: [8]u32;
}

#[storage(0, 0)]
var out: Out;

#[builtin("global_invocation")]
var gid: u32x3;

#[stage("compute")]
#[workgroup(8, 1, 1)]
fun narrow_main() {
    val g: u32 = gid[0];
    val x: u8  = g < 4;
    if (x) { out.ints[0] = 1; }
    var a: u8 = g::u8;
    a = a + 250;
    var c: i8 = g::i8;
    c = c - 100;
    if (a < 3) { out.ints[2] = a::u32; }
    out.ints[3] = a::u32 + c::i32::u32;
    out.ints[4] = (c >> 1)::i32::u32;
}
