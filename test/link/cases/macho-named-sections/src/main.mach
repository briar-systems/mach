# links two clang objects that each carry named __DATA sections a runtime finds by
# name, so the producer can read the section identity back out of the image.
#
# this program is never RUN: the fixture's objc metadata is synthetic, and libobjc
# dereferences every __objc_classlist entry for real on darwin (#2637). the call
# below exists so the linked object is reachable, not to report anything - the
# executing initializer case is `macho-mod-init`.
use std.runtime;
use std.types.size.usize;

#[library("probe-a")]
ext fun probe_state() i32;

#[symbol("main")]
fun main(argc: usize, argv: **u8) i64 {
    ret (probe_state())::i64;
}
