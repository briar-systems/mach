use std.types.size.usize;

#[embed("{artifact.shader-quad.out}")]
val QUAD: [_]u8;

pub fun quad_len() usize {
    ret $length_of(QUAD);
}

pub fun quad_sum() u64 {
    var sum: u64   = 0;
    var i:   usize = 0;
    for (i < $length_of(QUAD)) {
        sum = sum + QUAD[i]::u64;
        i   = i + 1;
    }
    ret sum;
}
