# REM-141: on Linux the officially supported interface is the syscall ABI, so
# the correct link set is empty. this program declares no [link.X] entry and
# uses only std.print, so the produced image must link nothing at all - not a
# real system library and not a fixture-built one either.

use std.runtime;
use std.print;
use std.types.size.usize;

#[symbol("main")]
fun main(argc: usize, argv: **u8) i64 {
    print.println("static");
    ret 0;
}
