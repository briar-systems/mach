# the LC_MAIN half of the darwin x86_64 entry contract (#2576): a `--pie` image is
# entered by dyld like a C `main`, with argc/argv/envp in rdi/rsi/rdx. reading all
# three is the point - the abs-bind case builds the same configuration and touches
# none of them, so it passed while the entry captured dyld's return address as argc.
use std.runtime;
use p: std.print;
use std.process.env;
use std.process.env.EnvError;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_ends_with;

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    p.printlnf("argc={}", argc);

    # the harness runs the artifact as out/int/prog, so the basename is fixed while
    # the leading directory is not.
    val a0:    str = argv[0]::str;
    var named: i64 = 0;
    if (str_ends_with(a0, "prog")) { named = 1; }
    p.printlnf("argv0_is_prog={}", named);

    # envp reaches std.process.env through _rt_envp; a misread argument block
    # poisons it too, so the environment read is part of the observable.
    var buf:       [256]u8;
    var have_path: i64 = 0;

    val path: res[opt[usize], EnvError] = env.get("PATH", ?buf[0], 256);
    if (sel path.ok) {
        if (sel path.ok.some) { have_path = 1; }
    }
    p.printlnf("env_path={}", have_path);

    ret 0;
}
