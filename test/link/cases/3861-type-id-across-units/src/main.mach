# $type_id of one type agrees in every object of the program, and differs between types (#3861)
use p: std.print;
use std.runtime;
use std.types.bool.bool;
use std.types.string.str;
use shapes;
use case.a;
use case.b;

val POINT: u64 = $type_id(shapes.Point);

fun check(label: str, holds: bool) u8 {
    if (holds) { p.printlnf("{} ok", label); ret 0; }
    p.printlnf("{} FAILED", label);
    ret 1;
}

#[symbol("main")]
fun main() i32 {
    var bad: u8 = 0;
    bad = bad | check("dep point across modules", shapes.point_id() == a.dep_point_id() && a.dep_point_id() == b.dep_point_id());
    bad = bad | check("dep point as a constant", POINT == shapes.point_id());
    bad = bad | check("instance across modules", shapes.box_id() == a.box_id() && a.box_id() == b.box_id());
    bad = bad | check("same name in two modules", a.own_point_id() != a.dep_point_id());
    bad = bad | check("secret differs", a.secret_box_id() != a.box_id());
    bad = bad | check("instances differ", b.box32_id() != b.box_id());
    ret bad::i32;
}
