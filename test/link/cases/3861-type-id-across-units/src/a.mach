# one module's identities: the dependency's types, and a record named like one of them
use shapes;

pub rec Point { x: u64; }

pub fun own_point_id() u64 { ret shapes.id_of[Point](); }
pub fun dep_point_id() u64 { ret shapes.id_of[shapes.Point](); }
pub fun box_id() u64 { ret shapes.id_of[shapes.Box[u64]](); }
pub fun secret_box_id() u64 { ret shapes.id_of[^shapes.Box[u64]](); }
