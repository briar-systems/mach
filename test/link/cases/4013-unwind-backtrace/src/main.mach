# a backtrace through two mach frames, entered from C (#4013); see case.conf
use p: std.print;
use std.runtime;
use std.types.size.usize;

#[library("libSystem")]
ext fun _Unwind_Backtrace(trace: ptr, arg: ptr) i32;
ext fun probe_callback() ptr;
ext fun probe_run(out: *i64);

#[noinline]
#[symbol("unwind_inner")]
pub fun unwind_inner(depth: i64) i64 {
    val r: i32 = _Unwind_Backtrace(probe_callback(), nil);
    ret depth + r::i64;
}

#[noinline]
#[symbol("unwind_outer")]
pub fun unwind_outer(depth: i64) i64 {
    val r: i64 = unwind_inner(depth + 1);
    ret r + 1;
}

#[symbol("main")]
fun main(argc: usize, argv: **u8) i64 {
    var out: [2]i64;
    probe_run(?out[0]);
    p.printlnf("inner at {}, outer at {}", out[0], out[1]);
    ret 0;
}
