# reports whether dyld ran the __DATA,__mod_init_func entry the linked C object
# registers. the initializer sets a global from -1 to 1, so "init missing" is the
# reading a program gets when the section reaches the image with the wrong section
# type: dyld dispatches on the type, never calls the pointer, and nothing reports it
use std.runtime;
use p: std.print;

#[library("initobj")]
ext fun init_probe() i32;

#[symbol("main")]
fun main() i64 {
    if (init_probe() == 1) { p.println("init ok"); }
    or                     { p.println("init missing"); }
    ret 0;
}
