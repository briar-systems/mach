use std.runtime;
use std.types.size.usize;
use p: std.print;

def VecOp: fun(i32x4) i64;
def StackOp: fun(i64, i64, i64, i64, i32x4) i64;
def NarrowOp: fun(i16x4) i64;
def NarrowStackOp: fun(i64, i64, i64, i64, i16x4) i64;
rec Pair { a: i64; b: i64; }
def PairOp: fun(Pair) i64;

ext fun foreign_fold(v: i32x4) i64;
ext fun foreign_stack(a: i64, b: i64, c: i64, d: i64, v: i32x4) i64;
ext fun foreign_narrow(v: i16x4) i64;
ext fun foreign_narrow_stack(a: i64, b: i64, c: i64, d: i64, v: i16x4) i64;
ext fun select_vec(f: VecOp) VecOp;
ext fun select_stack(f: StackOp) StackOp;
ext fun select_narrow(f: NarrowOp) NarrowOp;
ext fun select_narrow_stack(f: NarrowStackOp) NarrowStackOp;
ext fun select_pair(f: PairOp) PairOp;

fun local_fold(v: i32x4) i64 {
    ret v[0]::i64 + v[1]::i64 * 3 + v[2]::i64 * 5 + v[3]::i64 * 7;
}

fun local_stack(a: i64, b: i64, c: i64, d: i64, v: i32x4) i64 {
    ret a + b + c + d + local_fold(v);
}

fun local_narrow(v: i16x4) i64 {
    ret v[0]::i64 + v[1]::i64 * 3 + v[2]::i64 * 5 + v[3]::i64 * 7;
}

fun local_narrow_stack(a: i64, b: i64, c: i64, d: i64, v: i16x4) i64 {
    ret a + b + c + d + local_narrow(v);
}

fun local_pair(q: Pair) i64 {
    q.a = -5;
    q.b = -6;
    ret q.a + q.b;
}

#[symbol("main")]
fun main(argc: usize, argv: **u8) i64 {
    val v: i32x4 = i32x4{1, 2, 3, 4};
    val foreign: VecOp = select_vec(foreign_fold);
    val local: VecOp = select_vec(local_fold);
    val foreign_tail: StackOp = select_stack(foreign_stack);
    val local_tail: StackOp = select_stack(local_stack);
    val pair: PairOp = select_pair(local_pair);
    val narrow: i16x4 = i16x4{1, 2, 3, 4};
    val foreign_narrow_ptr: NarrowOp = select_narrow(foreign_narrow);
    val local_narrow_ptr: NarrowOp = select_narrow(local_narrow);
    val foreign_narrow_tail: NarrowStackOp = select_narrow_stack(foreign_narrow_stack);
    val local_narrow_tail: NarrowStackOp = select_narrow_stack(local_narrow_stack);
    var q: Pair;
    q.a = 7;
    q.b = 8;

    p.printlnf("foreign direct={} indirect={}", foreign_fold(v), foreign(v));
    p.printlnf("local direct={} indirect={}", local_fold(v), local(v));
    p.printlnf("foreign stack direct={} indirect={}",
               foreign_stack(1, 2, 3, 4, v), foreign_tail(1, 2, 3, 4, v));
    p.printlnf("local stack direct={} indirect={}",
               local_stack(1, 2, 3, 4, v), local_tail(1, 2, 3, 4, v));
    p.printlnf("foreign narrow direct={} indirect={}", foreign_narrow(narrow), foreign_narrow_ptr(narrow));
    p.printlnf("local narrow direct={} indirect={}", local_narrow(narrow), local_narrow_ptr(narrow));
    p.printlnf("foreign narrow stack direct={} indirect={}",
               foreign_narrow_stack(1, 2, 3, 4, narrow), foreign_narrow_tail(1, 2, 3, 4, narrow));
    p.printlnf("local narrow stack direct={} indirect={}",
               local_narrow_stack(1, 2, 3, 4, narrow), local_narrow_tail(1, 2, 3, 4, narrow));
    val pair_direct: i64 = local_pair(q);
    p.printlnf("pair direct={} intact={} {}", pair_direct, q.a, q.b);
    val pair_indirect: i64 = pair(q);
    p.printlnf("pair indirect={} intact={} {}", pair_indirect, q.a, q.b);

    p.printlnf("carrier 2={}", check_carrier_2());
    p.printlnf("carrier 3={}", check_carrier_3());
    p.printlnf("carrier 4={}", check_carrier_4());
    p.printlnf("carrier 8={}", check_carrier_8());
    p.printlnf("carrier 12={}", check_carrier_12());
    p.printlnf("carrier 16={}", check_carrier_16());
    p.printlnf("carrier 20={}", check_carrier_20());
    p.printlnf("carrier 32={}", check_carrier_32());
    p.printlnf("carrier mixed={}", check_carrier_mixed());
    val signed_narrow: i16x4 = i16x4{-32768, -2, 3, -4};
    p.printlnf("foreign signed narrow={}", foreign_narrow(signed_narrow));
    ret 0;
}

def CarrierFn2: fun(u8x2) u8x2;
ext fun carrier_identity_2(v: u8x2) u8x2;
ext fun carrier_select_2(f: CarrierFn2) CarrierFn2;
ext fun carrier_dispatch_2(f: CarrierFn2, v: u8x2) u8x2;
ext fun carrier_stack_2(a: i64, b: i64, c: i64, d: i64, v: u8x2) u8x2;
#[noinline]
fun local_carrier_2(v: u8x2) u8x2 { ret v; }
fun check_carrier_2() i64 {
    val v: u8x2 = u8x2{3, 8};
    val expected: u8x2 = u8x2{13, 8};
    val indirect: CarrierFn2 = carrier_select_2(carrier_identity_2);
    val a: u8x2 = carrier_identity_2(v);
    val b: u8x2 = indirect(v);
    val c: u8x2 = carrier_dispatch_2(local_carrier_2, v);
    val d: u8x2 = carrier_stack_2(1, 2, 3, 4, v);
    var i: usize = 0;
    for (i < 2) {
        if (a[i] != v[i] || b[i] != v[i] || c[i] != v[i]) { ret 1; }
        if (d[i] != expected[i]) { ret 2; }
        i = i + 1;
    }
    ret 0;
}

def CarrierFn3: fun(u8x3) u8x3;
ext fun carrier_identity_3(v: u8x3) u8x3;
ext fun carrier_select_3(f: CarrierFn3) CarrierFn3;
ext fun carrier_dispatch_3(f: CarrierFn3, v: u8x3) u8x3;
ext fun carrier_stack_3(a: i64, b: i64, c: i64, d: i64, v: u8x3) u8x3;
#[noinline]
fun local_carrier_3(v: u8x3) u8x3 { ret v; }
fun check_carrier_3() i64 {
    val v: u8x3 = u8x3{3, 8, 13};
    val expected: u8x3 = u8x3{13, 8, 13};
    val indirect: CarrierFn3 = carrier_select_3(carrier_identity_3);
    val a: u8x3 = carrier_identity_3(v);
    val b: u8x3 = indirect(v);
    val c: u8x3 = carrier_dispatch_3(local_carrier_3, v);
    val d: u8x3 = carrier_stack_3(1, 2, 3, 4, v);
    var i: usize = 0;
    for (i < 3) {
        if (a[i] != v[i] || b[i] != v[i] || c[i] != v[i]) { ret 1; }
        if (d[i] != expected[i]) { ret 2; }
        i = i + 1;
    }
    if (carrier_guard_3(local_carrier_3, v) != 0) { ret 3; }
    ret 0;
}
ext fun carrier_guard_3(f: CarrierFn3, v: u8x3) i64;

