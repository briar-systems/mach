# SPIR-V sampled-image fixture, written with declared handles (#2888)
#
# The subject is the handle: an `OpTypeImage` with its operands, the
# `OpTypeSampledImage` over it, the `UniformConstant` variable bound at a descriptor
# set and binding, and the `OpImageSampleImplicitLod` that reads it.
#
# Every handle here is a DECLARATION rather than a spelling the compiler parses, and
# every sampling function is one `#[op]` declaration. The compiler knows the
# machinery and the target owns the meaning.

# the `image` constructor's operands, in the order the target's row states them.
val TEXEL_F32: u32 = 0;
val TEXEL_U32: u32 = 2;

val DIM_1D:   u32 = 0;
val DIM_2D:   u32 = 1;
val DIM_3D:   u32 = 2;
val DIM_CUBE: u32 = 3;

val NO_DEPTH:       u32 = 0;
val NONARRAYED:     u32 = 0;
val ARRAYED:        u32 = 1;
val SINGLE_SAMPLED: u32 = 0;
val SAMPLED:        u32 = 1;

#[handle("spirv", "image", TEXEL_F32, DIM_2D, NO_DEPTH, NONARRAYED, SINGLE_SAMPLED, SAMPLED)]
pub def Texture2D;
#[handle("spirv", "image", TEXEL_F32, DIM_1D, NO_DEPTH, NONARRAYED, SINGLE_SAMPLED, SAMPLED)]
pub def Texture1D;
#[handle("spirv", "image", TEXEL_F32, DIM_3D, NO_DEPTH, NONARRAYED, SINGLE_SAMPLED, SAMPLED)]
pub def Texture3D;
#[handle("spirv", "image", TEXEL_F32, DIM_CUBE, NO_DEPTH, NONARRAYED, SINGLE_SAMPLED, SAMPLED)]
pub def TextureCube;
#[handle("spirv", "image", TEXEL_F32, DIM_2D, NO_DEPTH, ARRAYED, SINGLE_SAMPLED, SAMPLED)]
pub def Texture2DArray;
#[handle("spirv", "image", TEXEL_F32, DIM_CUBE, NO_DEPTH, ARRAYED, SINGLE_SAMPLED, SAMPLED)]
pub def TextureCubeArray;
#[handle("spirv", "image", TEXEL_U32, DIM_2D, NO_DEPTH, NONARRAYED, SINGLE_SAMPLED, SAMPLED)]
pub def UTexture2D;

# each of these NAMES the image it wraps rather than restating its operands, so the
# two cannot disagree about the image they share.
#[handle("spirv", "sampled_image", Texture2D)]
pub def Sampler2D;
#[handle("spirv", "sampled_image", Texture1D)]
pub def Sampler1D;
#[handle("spirv", "sampled_image", Texture3D)]
pub def Sampler3D;
#[handle("spirv", "sampled_image", TextureCube)]
pub def SamplerCube;
#[handle("spirv", "sampled_image", Texture2DArray)]
pub def Sampler2DArray;
#[handle("spirv", "sampled_image", TextureCubeArray)]
pub def SamplerCubeArray;
#[handle("spirv", "sampled_image", UTexture2D)]
pub def USampler2D;

#[handle("spirv", "sampler")]
pub def Sampler;

#[op("spirv", "core", "OpImageSampleImplicitLod")]
fun sample2(s: Sampler2D, uv: f32x2) f32x4;

#[op("spirv", "core", "OpImageSampleImplicitLod")]
fun sample1(s: Sampler1D, u: f32) f32x4;
#[op("spirv", "core", "OpImageSampleImplicitLod")]
fun sample3(s: Sampler3D, uvw: f32x4) f32x4;
#[op("spirv", "core", "OpImageSampleImplicitLod")]
fun samplecube(s: SamplerCube, dir: f32x4) f32x4;

#[op("spirv", "core", "OpImageSampleImplicitLod")]
fun samplearray(s: Sampler2DArray, uvl: f32x4) f32x4;

#[op("spirv", "core", "OpImageSampleImplicitLod")]
fun samplecubearray(s: SamplerCubeArray, dir: f32x4) f32x4;

#[op("spirv", "core", "OpImageSampleImplicitLod")]
fun sampleids(s: USampler2D, uv: f32x2) u32x4;

#[op("spirv", "core", "OpSampledImage")]
fun combine(t: Texture2D, s: Sampler) Sampler2D;

#[sampler(0, 0)] var albedo:  Sampler2D;
#[sampler(0, 1)] var ramp:    Sampler1D;
#[sampler(0, 2)] var volume:  Sampler3D;
#[sampler(0, 3)] var env:     SamplerCube;
#[sampler(0, 4)] var layers:  Sampler2DArray;
#[sampler(0, 5)] var ids:     USampler2D;
#[sampler(0, 6)] var envs:    SamplerCubeArray;

#[sampler(1, 0)] var base_tex: Texture2D;
#[sampler(1, 1)] var base_smp: Sampler;

#[input(0)] var in_uv:  f32x2;
#[input(1)] var in_uvw: f32x4;

#[output(0)] var out_colour: f32x4;
#[output(1)] var out_ids:    u32x4;

#[stage("fragment")]
fun frag_main() {
    out_colour = sample2(albedo, in_uv);
}

#[stage("fragment")]
fun frag_all() {
    out_colour = sample2(albedo, in_uv)
               + sample1(ramp, in_uv[0])
               + sample3(volume, in_uvw)
               + samplecube(env, in_uvw)
               + samplearray(layers, in_uvw)
               + samplecubearray(envs, in_uvw);
}

#[stage("fragment")]
fun frag_ids() {
    out_ids = sampleids(ids, in_uv);
}

#[stage("fragment")]
fun frag_separate() {
    out_colour = sample2(combine(base_tex, base_smp), in_uv);
}

#[noinline]
fun tinted() f32x4 {
    ret sample2(albedo, in_uv) * sample3(volume, in_uvw);
}

#[stage("fragment")]
fun frag_helper() {
    out_colour = tinted();
}

fun main() i32 {
    ret 0;
}
