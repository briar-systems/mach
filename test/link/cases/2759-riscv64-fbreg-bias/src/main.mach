# a -g frame-slot variable must be described at the address the emitted code uses
#
# `probe` takes a register-passed aggregate, so it is reconstructed into a frame slot
# and gets a `DW_OP_fbreg` location, and it keeps enough values live across calls to
# force callee-saved GP and FP registers to be saved. That matters on riscv64: `s0` is
# pinned at the frame top with the ra/s0 record and both save areas beneath it, so the
# bytes reserved between the frame pointer and the slot region are 16 in a leaf and up
# to 200 here. A fix that corrects the record but not the save areas passes a leaf.
use std.runtime;

pub rec Pair { a: i64; b: i64; }

pub fun sink(a: i64) i64 { ret a + 1; }
pub fun fsink(a: f64) f64 { ret a + 1.0; }

pub fun probe(p: Pair, n: i64) i64 {
    var g0: i64 = n + 1;
    var g1: i64 = n + 2;
    var g2: i64 = n + 3;
    var g3: i64 = n + 4;
    var g4: i64 = n + 5;
    var f0: f64 = 1.5;
    var f1: f64 = 2.5;
    var f2: f64 = 3.5;
    var f3: f64 = 4.5;

    val c0: i64 = sink(g0);
    val d0: f64 = fsink(f0);
    val c1: i64 = sink(g1);
    val d1: f64 = fsink(f1);
    val c2: i64 = sink(g2);
    val d2: f64 = fsink(f2);
    val c3: i64 = sink(g3);
    val d3: f64 = fsink(f3);

    ret p.a + p.b + c0 + c1 + c2 + c3 + g4
        + d0::i64 + d1::i64 + d2::i64 + d3::i64;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var p: Pair;
    p.a = argc;
    p.b = argc + 1;
    ret probe(p, argc) & 1;
}
