# a mach shared library whose frames and whose C object's frames a consumer's
# unwinder walks (#4047); see case.conf
ext fun c_middle(depth: i64) i64;
ext fun probe_walk();
ext fun probe_set(walker: ptr);
ext fun probe_addrs(out: *u64);

#[noinline]
#[symbol("lib_inner")]
pub fun lib_inner(depth: i64) i64 {
    probe_walk();
    ret depth + 1;
}

#[noinline]
#[symbol("lib_outer")]
pub fun lib_outer(depth: i64) i64 {
    ret c_middle(depth + 1) + 1;
}

# runs the chain with `walker` called at its innermost frame
#[noinline]
#[symbol("lib_run")]
pub fun lib_run(walker: ptr) i64 {
    probe_set(walker);
    val r: i64 = lib_outer(0);
    ret r + 1;
}

# where the library's functions start, in chain order from the innermost
#[symbol("lib_addrs")]
pub fun lib_addrs(out: *u64) {
    probe_addrs(out);
}
