# the project's entry. it never `use`s `sys`, so under `mach build` that module
# is not loaded at all and the case would prove nothing; a test build loads every
# module of the project as an orphan, and that load is the walk #3523 broke.

use std.runtime;
use std.types.size.usize;

#[symbol("main")]
fun main(argc: usize, argv: **u8) i64 {
    ret 0;
}
