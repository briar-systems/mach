# an orphan module: nothing imports it, so only a test build loads it. the gate
# below is one only layout can decide and it declares nothing, so the load walk
# has nothing to take from it. before #3523 the walk stopped at such a gate and
# never reached the `ext` after it, which then kept its module-qualified name
# and the link asked the probe object for `case.sys.probe_answer`.

use p: std.print;

pub rec Pair { a: u64; b: u64; }

$if ($size_of(Pair) != 16) {
    $error("pair layout");
}

ext fun probe_answer(x: i64) i64;

test "orphan ext after a layout gate links under its C name" {
    val got: i64 = probe_answer(20);
    p.printlnf("answer={}", got);
    if (got != 41) { ret 1; }
    ret 0;
}
