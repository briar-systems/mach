# SPIR-V version-keyed forms fixture: descriptors of every kind reached from two stages
#
# The environment pins the version, and two forms depend on it. Before SPIR-V 1.4 an
# `OpEntryPoint` lists only its Input and Output variables, and before 1.3 a storage
# buffer is a `Uniform` variable over a `BufferBlock` block rather than a
# `StorageBuffer` variable over a `Block` one (#3399). Each descriptor kind is reached
# so each storage class is listed or omitted on its own, and two stages reach
# different sets so the interface is per entry point rather than per module.

val TEXEL_F32:      u32 = 0;
val DIM_2D:         u32 = 1;
val NO_DEPTH:       u32 = 0;
val NONARRAYED:     u32 = 0;
val SINGLE_SAMPLED: u32 = 0;
val SAMPLED:        u32 = 1;

#[handle("spirv", "image", TEXEL_F32, DIM_2D, NO_DEPTH, NONARRAYED, SINGLE_SAMPLED, SAMPLED)]
def Texture2D;
#[handle("spirv", "sampled_image", Texture2D)]
def Sampler2D;

#[op("spirv", "core", "OpImageSampleImplicitLod")]
fun sample2(s: Sampler2D, uv: f32x2) f32x4;

rec Tint {
    gain: f32x4;
}

rec Palette {
    colours: [4]f32x4;
}

rec Counts {
    hits: [8]u32;
}

#[sampler(0, 0)] var albedo: Sampler2D;
#[uniform(0, 1)] var tint: Tint;
#[storage(0, 2)] var palette: Palette;
#[storage(1, 0)] var counts: Counts;

#[input(0)] var in_uv: f32x2;
#[output(0)] var out_colour: f32x4;

#[builtin("global_invocation")] var global_id: u32x3;

#[stage("fragment")]
fun frag_main() {
    out_colour = sample2(albedo, in_uv) * tint.gain + palette.colours[1];
}

#[stage("compute")]
#[workgroup(8, 1, 1)]
fun count_main() {
    val i: u32 = global_id[0];
    counts.hits[i] = counts.hits[i] + 1;
}
