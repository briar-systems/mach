# unit-case tag transport against a C callee and a C caller (mach #3400)
#
# Every function below is paired with one in probe.c of matching layout; see case.conf
# for what the pairing proves. The observable is the value each side computed from the
# discriminators, the payload and the argument after the tag, printed by mach.

use p: std.print;
use std.runtime;
use std.types.size.usize;

tag U16:  u8 { c0; c1; c2; c3; c4; c5; c6; c7; c8; c9; c10; c11; c12; c13; c14; c15; b: i64; }
tag U16F: u8 { c0; c1; c2; c3; c4; c5; c6; c7; c8; c9; c10; c11; c12; c13; c14; c15; b: f64; }
tag U13:  u8 { c0; c1; c2; c3; c4; c5; c6; c7; c8; c9; c10; c11; c12; b: u32; }
tag W13:  u8 { none; some: U13; }

ext fun c_u16(v: U16, next: i64) i64;
ext fun c_u16f(v: U16F, next: i64) i64;
ext fun c_w13(v: W13, next: i64) i64;
ext fun c_mk_u16(x: i64) U16;
ext fun c_mk_u16f(x: f64) U16F;
ext fun c_mk_w13(x: u32) W13;
ext fun c_drives_mach() i64;

#[symbol("m_u16")]
pub fun m_u16(v: U16, next: i64) i64 {
    if (sel v.b) { ret 1600 + v.b + next * 1000000; }
    ret -1;
}

#[symbol("m_u16f")]
pub fun m_u16f(v: U16F, next: i64) i64 {
    if (sel v.b) { ret 1600 + v.b::i64 + next * 1000; }
    ret -1;
}

#[symbol("m_w13")]
pub fun m_w13(v: W13, next: i64) i64 {
    if (sel v.some) {
        if (sel v.some.b) { ret 1000 + 1300 + v.some.b::i64 + next * 1000000; }
    }
    ret -1;
}

#[symbol("m_mk_u16")]
pub fun m_mk_u16(x: i64) U16 {
    ret U16.b{x};
}

#[symbol("m_mk_u16f")]
pub fun m_mk_u16f(x: f64) U16F {
    ret U16F.b{x};
}

#[symbol("m_mk_w13")]
pub fun m_mk_w13(x: u32) W13 {
    ret W13.some{U13.b{x}};
}

#[symbol("main")]
fun main(argc: usize, argv: **u8) i64 {
    p.printlnf("mach->c u16={} u16f={} w13={}",
        c_u16(U16.b{-5000000000}, 1), c_u16f(U16F.b{2.5}, 2), c_w13(W13.some{U13.b{77}}, 3));
    val ru:   U16    = c_mk_u16(-11);
    val ruf:  U16F   = c_mk_u16f(16.5);
    val rw:   W13    = c_mk_w13(99);
    var line: [3]i64 = [3]i64{-1, -1, -1};
    if (sel ru.b)  { line[0] = ru.b; }
    if (sel ruf.b) { line[1] = (ruf.b * 2.0)::i64; }
    if (sel rw.some) {
        if (sel rw.some.b) { line[2] = rw.some.b::i64; }
    }
    p.printlnf("c->mach u16={} u16f={} w13={}", line[0], line[1], line[2]);
    p.printlnf("c drives mach: {}", c_drives_mach());
    ret 0;
}
