# a record with natural 16-byte alignment against a C callee and a C caller
# (mach #3929)
#
# Every function below is paired with one in probe.c of matching signature; see
# case.conf for what each shape proves. The observable is the integer each side
# computes from every argument, printed by mach.

use p: std.print;
use std.runtime;
use std.types.size.usize;

rec W { v: u128; }
#[align(16)]
rec AL { a: i64; b: i64; }
rec NA { v: AL; }

ext fun c_w(first: i64, v: W, next: i64) i64;
ext fun c_n(first: i64, v: NA, next: i64) i64;
ext fun c_a(first: i64, v: AL, next: i64) i64;
ext fun c_as(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64, x: i8, v: AL, next: i64) i64;
ext fun c_drives_mach() i64;

fun halves(v: u128) i64 {
    ret (v >> 64)::i64 * 100 + v::i64;
}

#[symbol("m_w")]
pub fun m_w(first: i64, v: W, next: i64) i64 {
    ret first * 10000 + halves(v.v) + next * 1000000;
}

#[symbol("m_n")]
pub fun m_n(first: i64, v: NA, next: i64) i64 {
    ret first * 10000 + v.v.b * 100 + v.v.a + next * 1000000;
}

#[symbol("m_a")]
pub fun m_a(first: i64, v: AL, next: i64) i64 {
    ret first * 10000 + v.b * 100 + v.a + next * 1000000;
}

#[symbol("m_as")]
pub fun m_as(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64, x: i8, v: AL, next: i64) i64 {
    ret (a + b + c + d + e + f + g + h) * 10000 + x::i64 * 100000000 + v.b * 100 + v.a + next * 1000000;
}

#[symbol("main")]
fun main(argc: usize, argv: **u8) i64 {
    val w: W  = W{v: (3::u128 << 64) | 7::u128};
    val a: AL = AL{a: 7, b: 3};
    val n: NA = NA{v: a};
    p.printlnf("mach->c w={} n={} a={}", c_w(9, w, 5), c_n(9, n, 5), c_a(9, a, 5));
    p.printlnf("mach->c as={}", c_as(1, 1, 1, 1, 1, 1, 1, 1, 2, a, 5));
    p.printlnf("c drives mach: {}", c_drives_mach());
    ret 0;
}
