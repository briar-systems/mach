# a C++ exception caught across a mach frame (#4211); see case.conf
use p: std.print;
use std.runtime;
use std.types.size.usize;

ext fun cxx_catch(depth: i64) i64;
ext fun cxx_throw(depth: i64) i64;

#[noinline]
#[symbol("unwind_middle")]
pub fun unwind_middle(depth: i64) i64 {
    ret cxx_throw(depth + 1) + 1;
}

#[symbol("main")]
fun main(argc: usize, argv: **u8) i64 {
    p.printlnf("caught {}", cxx_catch(1));
    ret 0;
}
