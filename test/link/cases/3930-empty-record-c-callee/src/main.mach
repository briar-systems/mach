# an empty record argument against a C callee and a C caller (mach #3930)
#
# Every function below is paired with one in probe.c of matching signature; see
# case.conf for what each shape proves. The observable is the integer each side
# computes from the arguments around the empty record, printed by mach.

use p: std.print;
use std.runtime;
use std.types.size.usize;

rec E { }

ext fun c_e(first: i64, v: E, next: i64) i64;
ext fun c_ee(v: E, first: i64, w: E, x: f64, next: i64) i64;
ext fun c_e7(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, v: E, next: i64) i64;
ext fun c_drives_mach() i64;

#[symbol("m_e")]
pub fun m_e(first: i64, v: E, next: i64) i64 {
    ret first * 100 + next;
}

#[symbol("m_ee")]
pub fun m_ee(v: E, first: i64, w: E, x: f64, next: i64) i64 {
    ret first * 100 + (x * 2.0)::i64 * 10000 + next;
}

#[symbol("m_e7")]
pub fun m_e7(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, v: E, next: i64) i64 {
    ret (a + b + c + d + e + f + g) * 100 + next;
}

#[symbol("main")]
fun main(argc: usize, argv: **u8) i64 {
    val v: E = E{};
    p.printlnf("mach->c e={} ee={} e7={}", c_e(3, v, 5), c_ee(v, 3, v, 1.5, 5), c_e7(1, 1, 1, 1, 1, 1, 1, v, 5));
    p.printlnf("c drives mach: {}", c_drives_mach());
    ret 0;
}
