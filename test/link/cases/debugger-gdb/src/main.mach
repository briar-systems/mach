# debugger-behaviour fixture (#2756). rationale and hand-computed values live in
# this case's case.conf. LINE NUMBERS ARE LOAD-BEARING: test/link/lib/produce.sh's
# produce_gdb_session sets `break main.mach:<N>` by exact source line, so a line
# added or removed above `fun addone` or `pinned`'s `ret` moves those breakpoints.
use std.runtime;
use p: std.print;
use std.types.size.usize;

#[inline]
fun addone(v: i64) i64 {
    val r: i64 = v + 1;
    ret r;
}

fun accumulate(n: i64) i64 {
    var total: i64 = 0;
    var i:     i64 = 0;
    for (i < n) {
        total = total + i;
        i     = i + 1;
    }
    ret total;
}

fun deadlocal(v: i64) i64 {
    val unused: i64 = v * 3;
    ret v + 1;
}

# Bug A pair (#2779): `v` is read exactly once, right here, to compute `r` - then
# never again. That single use is real (the debug-only golden checks r_after == 42),
# so `v` genuinely dies the instant this line finishes, well before its LEXICAL scope
# (the whole function body) ends. Not `#[inline]`d, unlike `addone` above: an inlined
# body's own `next` steps out to the caller's frame entirely (verified by hand while
# building this fixture), which is a real, different debugger fact worth having
# somewhere, but it makes a same-frame before/after `v` comparison meaningless. This
# and `staysalive` below are plain calls so the comparison stays apples-to-apples.
fun dies(v: i64) i64 {
    val r: i64 = v + 1;
    ret r;
}

# the control: `v` is read AGAIN on the `ret` line, so it is genuinely live all the
# way to the function's end - the opt0 allocator has no dead storage to reuse here,
# and `v` must keep reading correctly after stepping past the same `val r = v + 1;`
# shape `dies` uses. Asserting this pair together is the point: a fix that reported
# `<optimized out>` for BOTH functions would pass a single-probe test and still be
# wrong.
fun staysalive(v: i64) i64 {
    val r: i64 = v + 1;
    ret r + v;
}

#[symbol("main")]
fun main(argc: usize, argv: **u8) i64 {
    val base: i64 = 40 + argc:~i64;
    val a:    i64 = addone(base);
    val b:    i64 = accumulate(10 + argc:~i64 - 1);
    val c:    i64 = deadlocal(3 + argc:~i64);
    val d:    i64 = dies(40 + argc:~i64);
    val e:    i64 = staysalive(40 + argc:~i64);
    val f:    i64 = pinned(argc:~i64);
    p.printlnf("a={}", a);
    p.printlnf("b={}", b);
    p.printlnf("c={}", c);
    p.printlnf("d={}", d);
    p.printlnf("e={}", e);
    p.printlnf("f={}", f);
    ret 0;
}

#[noinline]
fun bump(v: i64) i64 {
    ret v + 1;
}

#[noinline]
fun addr(q: *u64) i64 {
    ret q::i64;
}

# `remat_mark` is one constant move, made while more values than the
# callee-saved registers hold stay live across calls, so the allocator builds
# it again where it is read rather than spill it and the variable's location
# is the constant it holds (#4185)
#[noinline]
fun pinned(seed: i64) i64 {
    var a:          i64  = bump(seed);
    var b:          i64  = bump(a);
    var c:          i64  = bump(b);
    var d:          i64  = bump(c);
    var e:          i64  = bump(d);
    var f:          i64  = bump(e);
    var g:          i64  = bump(f);
    var h:          i64  = bump(g);
    var j:          i64  = bump(h);
    var k:          i64  = bump(j);
    var l:          i64  = bump(k);
    var m:          i64  = bump(l);
    var n:          i64  = bump(m);
    var o:          i64  = bump(n);
    val remat_mark: *u64 = 4096::*u64;
    var i:          i64  = 0;
    for (i < 2) {
        a = bump(a + i);
        b = bump(b + i);
        c = bump(c + i);
        d = bump(d + i);
        e = bump(e + i);
        f = bump(f + i);
        g = bump(g + i);
        h = bump(h + i);
        j = bump(j + i);
        k = bump(k + i);
        l = bump(l + i);
        m = bump(m + i);
        n = bump(n + i);
        o = bump(o + i);
        i = i + 1;
    }
    ret a + b + c + d + e + f + g + h + j + k + l + m + n + o + addr(remat_mark);
}
