# ten million levels of tail calls in constant stack (#3417); see case.conf

use p: std.print;
use std.runtime;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;

val DEPTH: i64 = 10000000;

#[noinline]
fun count(n: i64, acc: i64) i64 {
    if (n == 0) { ret acc; }
    ret count(n - 1, acc + n);
}

#[noinline]
fun even(n: i64) bool {
    if (n == 0) { ret true; }
    ret odd(n - 1);
}

#[noinline]
fun odd(n: i64) bool {
    if (n == 0) { ret false; }
    ret even(n - 1);
}

#[noinline]
fun spread(n: i64, a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64, i: i64) i64 {
    if (n == 0) { ret a + b * 2 + c * 3 + d * 4 + e * 5 + f * 6 + g * 7 + h * 8 + i * 9; }
    ret rotate(n - 1, i, a, b, c, d, e, f, g, h);
}

#[noinline]
fun rotate(n: i64, a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64, i: i64) i64 {
    ret spread(n, a + 1, b, c, d, e, f, g, h, i);
}

#[noinline]
fun fib(n: i64) i64 {
    if (n < 2) { ret n; }
    ret fib(n - 1) + fib(n - 2);
}

#[symbol("main")]
fun main(argc: usize, argv: **u8) i64 {
    var parity: i64 = 0;
    if (even(DEPTH + 1)) { parity = 1; }
    p.printlnf("count={}", count(DEPTH, 0));
    p.printlnf("parity={}", parity);
    p.printlnf("spread={}", spread(DEPTH, 1, 2, 3, 4, 5, 6, 7, 8, 9));
    p.printlnf("fib={}", fib(25));
    ret 0;
}
