# the fixture from #3362's repro: a `#[section(...)]` data object the image must
# keep by name, and a page-aligned zero-initialized table that must land in a real
# `.bss`. `_start` touches both so nothing here is dead.

#[section(".limine_requests_start")] #[symbol("requests_start")]
pub var requests_start: [4]u64 = [4]u64{1, 2, 3, 4};

#[align(4096)] #[symbol("pml4")]
pub var pml4: [512]u64;

#[symbol("_start")]
pub fun start() i64 {
    pml4[0] = requests_start[0];
    ret pml4[0]::i64;
}
