# SPIR-V debug model fixture: a fragment stage over a uniform record, a local, a loop and a
# callee from another module (#3398)
use tn: case.tone;

rec Grade {
    gain: f32x4;
    knee: f32x4;
}

#[uniform(0, 0)] var grade: Grade;
#[input(0)] var in_colour: f32x4;
#[output(0)] var out_colour: f32x4;

#[stage("fragment")]
fun frag_main() {
    val lifted: f32x4 = in_colour * grade.gain;
    out_colour = tn.curve(lifted, grade.knee[0]);
}
