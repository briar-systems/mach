# a helper in a second module, drawn into the shader so the module names two files

#[noinline]
pub fun curve(v: f32x4, knee: f32) f32x4 {
    var sum:  f32 = 0.0;
    var step: u32 = 0;
    for (step < 3) {
        sum  = sum + v[0] * 0.25;
        step = step + 1;
    }
    if (sum > knee) {
        ret v * f32x4{0.5, 0.5, 0.5, 1.0};
    }
    ret v;
}
