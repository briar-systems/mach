# a frame whose slots are read after an asm block moved sp; see case.conf

use p: std.print;
use std.runtime;
use std.types.size.usize;

#[noinline]
fun deep_slots_after_sp_move(seed: u64) u64 {
    var pad: [64]u64;
    var a:   u64 = seed + 0x1111;
    var b:   u64 = seed + 0x2222;
    var c:   u32 = (seed + 0x3333)::u32;
    var d:   u64 = seed + 0x4444;
    pad[0]  = a;
    pad[63] = b;
    asm aarch64 {
        sub sp, sp, 64
        mov x0, 0
        mov x1, 0
        mov x2, 0
        mov x3, 0
        mov x4, 0
        mov x5, 0
        mov x6, 0
        mov x7, 0
        mov x8, 0
        mov x9, 0
        mov x10, 0
        mov x11, 0
        mov x12, 0
        mov x13, 0
        mov x14, 0
        mov x15, 0
        mov x19, 0
        mov x20, 0
        mov x21, 0
        mov x22, 0
        mov x23, 0
        mov x24, 0
        mov x25, 0
        mov x26, 0
        mov x27, 0
        mov x28, 0
    }
    ret a + b + c::u64 + d + pad[0] + pad[63];
}

#[symbol("main")]
fun main(argc: usize, argv: **u8) i64 {
    p.printlnf("sum={}", deep_slots_after_sp_move(9 + argc::u64));
    ret 0;
}
