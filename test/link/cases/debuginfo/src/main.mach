# debug-info verification fixture (multi-TU)
#
# a small program spanning two local modules (this file and helper) plus the std
# modules it pulls, so the `-g` image carries several compile units. the debuginfo
# case builds it with and without `-g` and asserts, host-side, that (1) the standard
# structural validator (llvm-dwarfdump --verify) accepts the whole multi-TU image and
# (2) adding `-g` perturbs no loadable segment (byte-additivity). the printed output
# is incidental — the case inspects the artifact, it does not diff stdout.

use std.runtime;
use std.types.size.usize;
use p: std.print;
use dbgcase.helper;
use dbgcase.generic;

# a local helper on its own source line, so the fixture's own CU has real line-table
# rows across several functions.
fun square(v: i64) i64 {
    ret helper.mul(v, v);
}

# a `#[naked]` subprogram (#2198), whose DIE declares no DW_AT_frame_base at all -
# there is no frame base the compiler established to name. it is here so the standard
# validator has to accept the attribute's absence, and so `-g` additivity is asserted
# over a function whose `.text` the decorator, not the frame pass, decides.
#[naked] #[symbol("naked_probe")]
fun naked_probe() {
    $if ($mach.build.arch == $mach.arch.x86_64) { asm x86_64 { ret } }
    $or ($mach.build.arch == $mach.arch.aarch64) { asm aarch64 { ret } }
    $or { asm riscv64 { ret } }
}

#[symbol("main")]
fun main(argc: usize, argv: **u8) i64 {
    val a: i64 = helper.add(2, 3);
    val b: i64 = square(a);
    val c: i64 = generic.ident[i64](helper.helper_ident(b));
    val d: i64 = generic.add_n(7, helper.helper_add_n(c));
    val e: i64 = generic.pack_sum(helper.helper_pack_sum(d), 1);
    p.printlnf("a={}", a);
    p.printlnf("b={}", b);
    p.printlnf("c={}", c);
    p.printlnf("d={}", d);
    p.printlnf("e={}", e);
    naked_probe();
    ret 0;
}
