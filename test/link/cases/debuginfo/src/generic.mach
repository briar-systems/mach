# weak generic, comptime-value, and pack instances emitted in every calling module
#[noinline]
pub fun ident[T](v: T) T {
    ret v;
}

#[noinline]
pub fun add_n($n: i64, v: i64) i64 {
    ret n + v;
}

#[noinline]
pub fun pack_sum(va: ...) i64 {
    var total: i64 = 0;
    $each v in va { total = total + v; }
    ret total;
}
