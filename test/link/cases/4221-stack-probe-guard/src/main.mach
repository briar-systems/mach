use std.runtime;
use std.sync.thread;
use std.system.os;
use std.types.size.usize;

val RESERVE: usize = 1048576;
val SLACK:   usize = 65536;
val BELOW:   usize = 262144;
val GUARD:   usize = 65536;

# the frames' buffers escape here, so each frame keeps its buffer on the stack
var sink: usize = 0;

# 1 when the large frame ran below the guard, 2 or 3 when the case could not be set up
var outcome: i64 = 2;

# the frame's storage is live only on a branch that never runs, so nothing
# touches it and the frame is large all the same
#[volatile]
rec Large {
    first: u8;
    rest:  [262143]u8;
}

# never equal to what large_frame is passed
var never: i32 = -1234567;

#[noinline]
fun leaf() {
    sink = sink + 1;
}

# a frame of four guards; its call to leaf is its first write, at its bottom
#[noinline]
fun large_frame(n: i32) {
    if (n == never) {
        var cold: Large;
        cold.first = 1;
        sink       = cold.first::usize;
    }
    leaf();
}

# descend until the frame lies within stop, then take the large frame there
#[noinline]
fun approach(stop: usize) {
    var pad: [512]u8;
    pad[0] = 1;
    sink   = (?pad[0])::usize;
    if ((?pad[0])::usize > stop) { approach(stop); }
    or                           { large_frame(0); }
    sink = sink + pad[0]::usize;
}

# the thread's stack spans at least RESERVE below its entry frame, less what
# the thread's start keeps at its top, which SLACK covers. the guard sits BELOW
# above that, aligned to its own size so it is whole pages on every system
fun worker(arg: *u8) {
    var here:  u8    = 0;
    val low:   usize = (?here)::usize - RESERVE + SLACK;
    val guard: usize = (low + BELOW + GUARD - 1) & ~(GUARD - 1);
    if (os.protect(guard::ptr, GUARD, os.PROT_NONE) != 0) {
        outcome = 3;
        ret;
    }
    approach(guard + GUARD + 16384);
    outcome = 1;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var c: thread.Config;
    thread.config_default(?c);
    c.stack_reserve = RESERVE;
    var t:       thread.Thread;
    val spawned: thread.Operation = thread.spawn_with_config(worker, nil, ?c, ?t);
    if (sel spawned.err) { ret 2; }
    val joined: thread.Operation = thread.join(?t);
    if (sel joined.err) { ret 2; }
    ret outcome;
}
