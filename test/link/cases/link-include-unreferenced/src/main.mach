# demo_cbrt is declared and pinned to the dependency's exported, referenced-mode
# [link.m], exactly like link-include-referenced's consumer, but never called.
# a genuinely unused declared import must not force the dependency into the link.

use std.runtime;
use std.print;
use std.types.size.usize;

#[library("demomath")]
ext fun demo_cbrt(x: f64) f64;

#[symbol("main")]
fun main(argc: usize, argv: **u8) i64 {
    print.println("no demo_cbrt call here");
    ret 0;
}
