# the #3907 repro and its neighbours: constant offsets around and past 2^31
# into a 2.2 GB static array, each read back through a runtime index

use p: std.print;
use std.runtime;

var BIG: [2200000000]u8;

#[noinline]
fun poke(q: *u8) {
    q[2199999998] = 7;
}

#[noinline]
fun far_address() *u8 {
    ret ?BIG[2199999990];
}

#[noinline]
fun at(base: u64, argc: i64) u8 {
    ret BIG[base + argc::u64 - 1];
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    BIG[0]          = 1;
    BIG[2147483647] = 6;
    BIG[2147483648] = 5;
    BIG[2199999999] = 41;
    poke(?BIG[0]);
    val q: *u8 = far_address();
    q[0] = 9;
    p.printlnf("first={} below={} past={} last={}", at(0, argc), at(2147483647, argc), at(2147483648, argc), at(2199999999, argc));
    p.printlnf("pointer={} address={}", at(2199999998, argc), at(2199999990, argc));
    p.printlnf("neighbours={} {} {}", at(2147483646, argc), at(2147483649, argc), at(2199999997, argc));
    p.printlnf("constant={} {}", BIG[2199999999], BIG[2147483648]);
    ret 0;
}
