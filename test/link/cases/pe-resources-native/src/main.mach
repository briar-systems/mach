use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;

#[library("kernel32.dll")]
ext fun GetModuleHandleW(name: *u16) *u8;
#[library("kernel32.dll")]
ext fun FindResourceW(module: *u8, name: *u16, ty: *u16) *u8;
#[library("kernel32.dll")]
ext fun LoadResource(module: *u8, resource: *u8) *u8;
#[library("kernel32.dll")]
ext fun LockResource(resource: *u8) *u8;
#[library("kernel32.dll")]
ext fun SizeofResource(module: *u8, resource: *u8) u32;
#[library("kernel32.dll")]
ext fun GetStdHandle(which: i32) *u8;
#[library("kernel32.dll")]
ext fun WriteFile(handle: *u8, bytes: *u8, len: u32, written: *u32, overlapped: *u8) bool;
#[library("kernel32.dll")]
ext fun ExitProcess(code: u32);

fun int_resource(id: u32) *u16 { ret (id::usize)::*u16; }

fun resource(module: *u8, ty: u32, id: u32, size: *u32) *u8 {
    val found: *u8 = FindResourceW(module, int_resource(id), int_resource(ty));
    if (found == nil) { ret nil; }
    @size = SizeofResource(module, found);
    val loaded: *u8 = LoadResource(module, found);
    if (loaded == nil) { ret nil; }
    ret LockResource(loaded);
}

fun has_utf16(bytes: *u8, len: u32, text: *u16, units: u32) bool {
    var off: u32 = 0;
    for (off + units * 2 <= len) {
        var i: u32 = 0;
        var same: bool = true;
        for (i < units) {
            val lo: u16 = bytes[off + i * 2]::u16;
            val hi: u16 = bytes[off + i * 2 + 1]::u16;
            if ((lo | (hi << 8)) != text[i]) { same = false; brk; }
            i = i + 1;
        }
        if (same) { ret true; }
        off = off + 2;
    }
    ret false;
}

#[symbol("mainCRTStartup")]
pub fun _start() {
    val module: *u8 = GetModuleHandleW(nil);
    var size: u32 = 0;
    val icon: *u8 = resource(module, 3, 1, ?size);
    var ok: bool = icon != nil && size == 4 && icon[0] == 0x11 && icon[3] == 0x44;
    val group: *u8 = resource(module, 14, 1, ?size);
    if (group == nil || size != 20 || group[4] != 1 || group[18] != 1) { ok = false; }
    val version: *u8 = resource(module, 16, 1, ?size);
    var product: [9]u16;
    product[0] = 'g'; product[1] = 'a'; product[2] = 'm'; product[3] = 'e';
    product[4] = '-'; product[5] = 'a'; product[6] = 'p'; product[7] = 'p'; product[8] = 0;
    var filename: [9]u16;
    filename[0] = 'p'; filename[1] = 'r'; filename[2] = 'o'; filename[3] = 'g';
    filename[4] = '.'; filename[5] = 'e'; filename[6] = 'x'; filename[7] = 'e'; filename[8] = 0;
    if (version == nil || !has_utf16(version, size, ?product[0], 9)
        || !has_utf16(version, size, ?filename[0], 9)) { ok = false; }
    val manifest: *u8 = resource(module, 24, 1, ?size);
    if (manifest == nil || size < 20 || manifest[0] != '<' || manifest[1] != '?') { ok = false; }

    var written: u32 = 0;
    if (ok) {
        val msg: str = "resource-api=ok\n";
        WriteFile(GetStdHandle(-11), msg::*u8, 16, ?written, nil);
        ExitProcess(0);
    }
    val fail: str = "resource-api=failed\n";
    WriteFile(GetStdHandle(-11), fail::*u8, 20, ?written, nil);
    ExitProcess(1);
}
