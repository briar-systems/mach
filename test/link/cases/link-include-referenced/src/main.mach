# the consumer writes its own import and pins it to a logical library name that
# only the dependency's exported, referenced-mode [link.m] carries. demo_cbrt is
# genuinely called, so the referenced-mode entry must synthesize a NEEDED with
# its own real soname for the loader to find it.

use std.runtime;
use std.print;
use std.types.size.usize;

#[library("demomath")]
ext fun demo_cbrt(x: f64) f64;

#[symbol("main")]
fun main(argc: usize, argv: **u8) i64 {
    print.printlnf("demo_cbrt={}", demo_cbrt(27.0)::i64);
    ret 0;
}
