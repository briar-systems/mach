# three modules embed byte-identical content and one embeds different content of
# the same length. the producer scans the FINAL IMAGE: the shared 17 bytes must
# appear exactly once and the different 17 bytes exactly once, which is the fact
# an address comparison inside the program cannot show - the addresses can agree
# while the bytes are still emitted twice with only one of the copies referenced.
use std.runtime;
use p: std.print;
use case.lib;
use case.libb;

#[embed("asset.bin")]
val ASSET: [_]u8;

#[symbol("main")]
fun main() i64 {
    p.printlnf("sum={}", (ASSET[0])::i64 + lib.lib_sum());
    p.printlnf("main_lib_same={}", ((?ASSET[0]) == (?lib.LIB_ASSET[0]))::u64);
    p.printlnf("main_libb_same={}", ((?ASSET[0]) == (?libb.LIBB_ASSET[0]))::u64);
    ret 0;
}
