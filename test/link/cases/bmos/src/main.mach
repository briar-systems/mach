# bmos flat-image (raw) build fixture
#
# BareMetal copies a program's bytes to 0xFFFF800000000000 and enters it with
# `call [ProgramLocation]`, so `_start` must begin at file offset 0 (the image
# base) and the program leaves by returning - which is what this body does. it is
# the only function, so it satisfies raw's entry-at-base contract. the loop keeps
# the sum live so isel and encode are exercised; the image is not executed here,
# since no Linux host can map its load address.
#
# the image must also carry its zero-initialized data (#2402): `raw` once stored
# file bytes only and left bss past the end of the file for a startup that cannot
# exist. `zeros` is a zero-init global larger than the code around it, so a writer
# that reverts to `filesz` emits an image too short to contain it, and `seeded` puts
# a real data section between the code and the bss. the byte-level assertion lives
# in the raw writer's unit test.

var zeros:  [64]u8;
var seeded: [4]u8 = [4]u8{0xAA, 0xBB, 0xCC, 0xDD};

#[symbol("_start")]
fun start() i64 {
    var acc: i64 = 0;
    var i:   i64 = 0;
    for (i < 64) {
        acc = acc + zeros[i]::i64;
        i   = i + 1;
    }
    zeros[0] = seeded[0];
    ret acc;
}
