# refuse: operator.operand_type
use std.runtime;

rec Point { x: i64; y: i64; }

fun twice[T](x: T) T {
    ret x + x;
}

# a generic body is checked at each instance against its type arguments
#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val p: Point = twice[Point](Point{x: 1, y: 2});
    ret 0;
}
