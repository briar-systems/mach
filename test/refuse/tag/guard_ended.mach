# refuse: tag.payload_unguarded
use std.runtime;

tag Slot: u8 { empty; full: i64; }

# assigning a name the guarded place is subscripted by ends the guard: `slots[i]` now names
# an element no `sel` tested
#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val slots: [2]Slot = [2]Slot{Slot.full{7}, Slot.empty{}};
    var i:     u64     = 0;
    if (sel slots[i].full) {
        i = i + 1;
        ret slots[i].full;
    }
    ret 0;
}
