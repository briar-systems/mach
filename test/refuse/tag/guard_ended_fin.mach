# refuse: tag.payload_unguarded
use std.runtime;

tag Slot: u8 { empty; full: i64; }

# a `fin` body replays when its block ends, after an assignment later in the block that
# ends the guard
#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val slots: [2]Slot = [2]Slot{Slot.full{7}, Slot.empty{}};
    var i:     u64     = 0;
    var seen:  i64     = 0;
    if (sel slots[i].full) {
        fin { seen = slots[i].full; }
        i = i + 1;
    }
    ret seen;
}
