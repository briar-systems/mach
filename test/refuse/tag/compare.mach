# refuse: operator.aggregate_equality
use std.runtime;

tag Reply: u8 { empty; value: i64; }

# whole tags are never compared: test the case with `sel`
#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val a: Reply = Reply.empty{};
    val b: Reply = Reply.empty{};
    if (a == b) { ret 1; }
    ret 0;
}
