# refuse: tag.payload_unguarded
use std.runtime;

tag Reply: u8 { empty; value: i64; }

# an arm that falls through instead of leaving opens no guard after the chain
fun read(r: Reply) i64 {
    var n: i64 = 0;
    if (sel r.empty) { n = 1; }
    ret r.value + n;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    ret read(Reply.value{3});
}
