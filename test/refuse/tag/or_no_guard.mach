# refuse: tag.payload_unguarded
use std.runtime;

tag Reply: u8 { empty; value: i64; }

# only `&&` guards its right operand: `||` opens no guard
#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val r: Reply = Reply.value{3};
    if (!(sel r.value) || r.value > 2) { ret 1; }
    ret 0;
}
