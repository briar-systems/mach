# refuse: tag.payload_unguarded
use std.runtime;

tag Slot: u8 { empty; full: i64; }

# an assignment in a loop ends a guard opened outside it for the whole loop: a later
# iteration's read follows an earlier iteration's assignment
#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val slots: [2]Slot = [2]Slot{Slot.full{7}, Slot.empty{}};
    var i:     u64     = 0;
    var total: i64     = 0;
    if (sel slots[i].full) {
        for (i < 2) {
            total = total + slots[i].full;
            i     = i + 1;
        }
    }
    ret total;
}
