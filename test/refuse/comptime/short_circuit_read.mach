# refuse: comptime.extension_unknown
use std.runtime;

# the right side of a comptime `&&` whose left side is true is read, and a name it holds that
# the target's catalog lacks is refused

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    $if ($mach.build.pointer_width > 0 && $mach.build.ext.no_such_extension == 1) {
        ret 1;
    }
    ret 0;
}
