# refuse: type.mismatch
use std.runtime;

# a body a comptime parameter sizes is judged at each instance: h(2) is refused, and h(3)
# and the instance-free template are not

fun h($N: i64) i64 {
    val y: [N]i64 = [3]i64{1, 2, 3};
    ret y[0];
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    ret h(3) + h(2);
}
