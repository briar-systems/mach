# refuse: ext.signature
use std.runtime;

#[abi_type("va_list")]
def VaList;

#[symbol("corpus_sink")]
fun sink(a: i64, p: ptr) i64 {
    ret a + (p :~ i64);
}

#[symbol("corpus_sink")]
ext fun c_sink(a: i64, ap: VaList) i64;

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    ret sink(0, nil);
}
