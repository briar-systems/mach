# refuse:  secret.unverifiable
# targets: linux-x86_64
use std.runtime;

rec F { k: ^f32; n: f32; }

# the walk holds a float register whole: the System V convention passes both members of
# this record in one, so the compare of the public member reads the secret one too
#[constant_time("soft")]
fun big(r: F) u64 {
    if (r.n > 1.0) { ret 1; }
    ret 0;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    ret big(F{k: 2.0, n: argc::f32})::i64;
}
