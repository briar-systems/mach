# refuse:  secret.unverifiable
# targets: linux-x86_64 linux-x86_64-optimized linux-aarch64 linux-aarch64-optimized linux-riscv64
use std.runtime;

# the stack pointer, and riscv's thread pointer, are public at every function's entry
# by the convention, so a block that leaves a secret in one is refused
#[constant_time("soft")]
fun plant(k: ^u64) {
    $if ($mach.build.arch == $mach.arch.x86_64) {
        asm x86-64 {
            mov rax, {k}
            mov rsp, rax
        }
    }
    $or ($mach.build.arch == $mach.arch.aarch64) {
        asm armv8-a {
            ldr x9, {k}
            mov sp, x9
        }
    }
    $or {
        asm rv64i {
            ld t0, {k}
            mv tp, t0
        }
    }
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    plant(argc::u64);
    ret 0;
}
