# refuse:  secret.unverifiable
# targets: linux-x86_64 linux-aarch64 linux-riscv64
use std.runtime;

fun touch(q: *u64) {}

# an asm block puts a secret into a local whose type is public, and the local's address
# goes to a callee not checked constant time. the front end sees a public pointer, the
# walk sees memory holding a secret that callee can reach
#[constant_time("soft")]
fun hand(p: *^u64) u64 {
    var x: u64 = 0;
    $if ($mach.build.arch == $mach.arch.x86_64) {
        asm x86-64 {
            mov rax, {p}
            mov rcx, [rax]
            mov {x}, rcx
        }
    }
    $or ($mach.build.arch == $mach.arch.aarch64) {
        asm armv8-a {
            ldr x9, {p}
            ldr x10, [x9]
            str x10, {x}
        }
    }
    $or {
        asm rv64i {
            ld t0, {p}
            ld t1, 0(t0)
            sd t1, {x}
        }
    }
    touch(?x);
    ret 0;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var k: ^u64 = argc::u64;
    ret hand(?k)::i64;
}
