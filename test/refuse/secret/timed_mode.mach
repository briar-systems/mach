# refuse:  secret.call_untrusted
# targets: linux-aarch64 linux-riscv64
use std.runtime;

#[constant_time("soft")]
def Seal: fun(^u64) ^u64;

#[constant_time("soft")]
fun mix(k: ^u64) ^u64 {
    ret k ^ 5;
}

# a hard caller relies on a function type marked soft only where the build guarantees every
# timing mode a soft function's code may be held under, as it relies on a soft callee named
# directly, which an aarch64 build without dit and a riscv64 build without zkt do not
#[constant_time("hard")]
fun apply(seal: Seal, k: ^u64) ^u64 {
    ret seal(k);
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    ret apply(mix, argc::u64):>u64::i64;
}
