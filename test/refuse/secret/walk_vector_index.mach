# refuse:  secret.unverifiable
# targets: linux-riscv64-v linux-riscv64-v-optimized
use std.runtime;

# a vector load or store moves secret bytes at a public address in a constant-time function,
# as a scalar one does, but an indexed load's index vector forms its address, so a secret
# index is refused by the walk
#[constant_time("soft")]
fun look(t: *[8]u64, k: ^u64) ^u64 {
    var r: ^u64 = 0;
    asm rv64gcv {
        ld t0, {k}
        andi t0, t0, 7
        slli t0, t0, 3
        ld t1, {t}
        vsetivli zero, 1, e64, m1, ta, ma
        vmv.v.x v8, t0
        vluxei64.v v9, (t1), v8
        vmv.x.s t2, v9
        sd t2, {r}
    }
    ret r;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var t: [8]u64 = [8]u64{1, 2, 3, 4, 5, 6, 7, 8};
    ret look(?t, argc::u64):>u64::i64;
}
