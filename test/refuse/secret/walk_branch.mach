# refuse:  secret.unverifiable
# targets: linux-x86_64 linux-aarch64 linux-riscv64
use std.runtime;

# the walk of the encoded code sees a compare of a secret and a jump on its flags inside
# an asm block, where the front end sees no branch at all
#[constant_time("soft")]
fun pick(k: ^u64) u64 {
    var r: u64 = 0;
    $if ($mach.build.arch == $mach.arch.x86_64) {
        asm x86-64 {
            mov rax, {k}
            mov ecx, 0
            cmp rax, 5
            jne 1f
            mov ecx, 1
            1:
            mov {r}, rcx
        }
    }
    $or ($mach.build.arch == $mach.arch.aarch64) {
        asm armv8-a {
            ldr x9, {k}
            mov x10, 0
            cmp x9, 5
            b.ne 1f
            mov x10, 1
            1:
            str x10, {r}
        }
    }
    $or {
        asm rv64i {
            ld t0, {k}
            li t1, 5
            li t2, 0
            bne t0, t1, 1f
            li t2, 1
            1:
            sd t2, {r}
        }
    }
    ret r;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    ret pick(argc::u64)::i64;
}
