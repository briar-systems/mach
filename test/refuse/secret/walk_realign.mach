# refuse:  secret.unverifiable
# targets: linux-x86_64 linux-aarch64 linux-riscv64
use std.runtime;

#[align(64)]
rec Line { k: ^u64; n: u64; }

# a local aligned past the stack's alignment makes the prologue realign the stack pointer
# to a point anywhere in the alignment's interval below its entry value. a read through
# the frame pointer, off the entry, into the realigned locals may land on any byte that
# interval reaches, the secret slot among them, so the walk takes it as secret and the
# branch on it is refused
#[constant_time("soft")]
fun test(s: ^u64) u64 {
    var l: Line;
    l.k = s;
    l.n = 1;
    var r: u64 = 0;
    $if ($mach.build.arch == $mach.arch.x86_64) {
        asm x86-64 {
            mov rcx, [rbp - 96]
            mov {r}, rcx
        }
    }
    $or ($mach.build.arch == $mach.arch.aarch64) {
        asm armv8-a {
            ldur x9, [x29, -128]
            str x9, {r}
        }
    }
    $or {
        asm rv64i {
            ld t1, -128(s0)
            sd t1, {r}
        }
    }
    if (r > 5) { ret 1; }
    ret l.n;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    ret test(argc::u64)::i64;
}
