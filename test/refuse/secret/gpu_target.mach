# refuse:  secret.target_unverifiable
# targets: vulkan-spirv
# a downstream compiler translates a SPIR-V module, so no instruction's timing is classified
# and a constant-time function is refused
rec Buf { v: [4]u32; }

#[gpu.storage(0, 0)]
var data: Buf;

#[constant_time("soft")]
fun mix(k: ^u32) ^u32 {
    ret k ^ 5;
}

#[gpu.stage("compute")]
#[gpu.workgroup(1, 1, 1)]
fun main() {
    data.v[0] = mix(data.v[1]):>u32;
}
