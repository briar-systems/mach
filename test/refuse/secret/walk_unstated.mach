# refuse:  secret.unverifiable
# targets: linux-x86_64 linux-x86_64-optimized linux-aarch64 linux-aarch64-optimized linux-riscv64
use std.runtime;

# an address rebuilt from an integer names memory nothing states the secrecy of: no
# frame slot the walk places, no global and no binding's pointee, so a secret stored
# through it is refused
#[constant_time("soft")]
fun put(at: u64, s: *^u64) {
    $if ($mach.build.arch == $mach.arch.x86_64) {
        asm x86-64 {
            mov rax, {at}
            mov rcx, {s}
            mov rcx, [rcx]
            mov [rax], rcx
        }
    }
    $or ($mach.build.arch == $mach.arch.aarch64) {
        asm armv8-a {
            ldr x9, {at}
            ldr x10, {s}
            ldr x10, [x10]
            str x10, [x9]
        }
    }
    $or {
        asm rv64i {
            ld t0, {at}
            ld t1, {s}
            ld t1, 0(t1)
            sd t1, 0(t0)
        }
    }
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var k:   ^u64 = argc::u64;
    var out: u64  = 0;
    put((?out)::u64, ?k);
    ret out::i64;
}
