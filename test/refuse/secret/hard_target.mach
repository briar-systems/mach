# refuse:  secret.target_unguaranteed
# targets: linux-aarch64 linux-riscv64 linux-riscv64-v linux-riscv64-v-optimized wasi-wasm32
use std.runtime;

# a hard function holds only under the timing modes the build guarantees: aarch64 needs
# dit and riscv64 zkt selected, and wasm guarantees no instruction's timing at all
#[constant_time("hard")]
fun mix(a: ^u64, b: ^u64) ^u64 {
    ret (a ^ b) + a;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    ret mix(argc::u64, 3):>u64::i64;
}
