# refuse: secret.cast_qualifier
use std.runtime;
use std.types.size.usize;

# a pointer to secret bytes converted to an integer drops the secrecy of what it reaches,
# and the integer would convert back to a public alias of them
fun address(p: *^u8) usize {
    ret p::usize;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var k: ^u8 = 3;
    if (address(?k) == 0) { ret 1; }
    ret 0;
}
