# refuse:  secret.unverifiable
# targets: linux-x86_64 linux-aarch64 linux-riscv64
use std.runtime;

# an asm block moves a secret into the register of a result the declaration states public
#[constant_time("soft")]
fun open(k: ^u64) u64 {
    var r: u64 = 0;
    $if ($mach.build.arch == $mach.arch.x86_64) {
        asm x86-64 {
            mov rax, {k}
            mov {r}, rax
        }
    }
    $or ($mach.build.arch == $mach.arch.aarch64) {
        asm armv8-a {
            ldr x9, {k}
            str x9, {r}
        }
    }
    $or {
        asm rv64i {
            ld t0, {k}
            sd t0, {r}
        }
    }
    ret r;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    ret open(argc::u64)::i64;
}
