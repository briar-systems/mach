# refuse:  secret.unverifiable
# targets: linux-x86_64 linux-x86_64-optimized linux-aarch64 linux-aarch64-optimized linux-riscv64
use std.runtime;

#[constant_time("soft")]
fun copy(k: *^u64, t: *^u64) {
    @t = @k;
}

# the caller passes no secret by value, and the trusted callee writes one into the local
# through its pointer: after the call the walk takes what the callee could reach as
# secret, so the asm block that moves the local into a public result is refused
#[constant_time("soft")]
fun test(k: *^u64) u64 {
    var t: ^u64 = 0;
    copy(k, ?t);
    var x: u64 = 0;
    $if ($mach.build.arch == $mach.arch.x86_64) {
        asm x86-64 {
            mov rax, {t}
            mov {x}, rax
        }
    }
    $or ($mach.build.arch == $mach.arch.aarch64) {
        asm armv8-a {
            ldr x9, {t}
            str x9, {x}
        }
    }
    $or {
        asm rv64i {
            ld t0, {t}
            sd t0, {x}
        }
    }
    ret x;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var k: ^u64 = argc::u64;
    ret test(?k)::i64;
}
