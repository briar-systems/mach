# refuse: type.mismatch
use std.runtime;

# a `#[weak]` default states no mode, since another definition may replace it with code
# nothing here checked, so its value is no value of a marked function type

#[constant_time("soft")]
def Seal: fun(^u64) ^u64;

#[constant_time("soft")]
#[weak("corpus_secret_timed_weak_mix")]
fun mix(k: ^u64) ^u64 {
    ret k ^ 5;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val seal: Seal = mix;
    ret seal(argc::u64):>u64::i64;
}
