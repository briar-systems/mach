# refuse: type.mismatch
use std.runtime;

# a typed pointer becomes `ptr` with no cast unless what it reaches holds a secret at any
# depth: a pointer to a record whose field points at secret bytes is not one
rec Holder {
    key: *^u8;
}

fun erase(h: *Holder) ptr {
    ret h;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var k: ^u8    = 3;
    var h: Holder = Holder{key: ?k};
    val p: ptr    = erase(?h);
    ret 0;
}
