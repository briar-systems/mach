# refuse:  secret.unverifiable
# targets: linux-x86_64 linux-x86_64-optimized linux-aarch64 linux-aarch64-optimized linux-riscv64
use std.runtime;

# an asm block copies the secret behind one pointer into the public storage behind
# another: the binding's pointee type states that memory public, so the store is refused
#[constant_time("soft")]
fun copy(s: *^u64, p: *u64) {
    $if ($mach.build.arch == $mach.arch.x86_64) {
        asm x86-64 {
            mov rax, {s}
            mov rcx, [rax]
            mov rdx, {p}
            mov [rdx], rcx
        }
    }
    $or ($mach.build.arch == $mach.arch.aarch64) {
        asm armv8-a {
            ldr x9, {s}
            ldr x10, [x9]
            ldr x11, {p}
            str x10, [x11]
        }
    }
    $or {
        asm rv64i {
            ld t0, {s}
            ld t1, 0(t0)
            ld t2, {p}
            sd t1, 0(t2)
        }
    }
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var k:   ^u64 = argc::u64;
    var out: u64  = 0;
    copy(?k, ?out);
    ret out::i64;
}
