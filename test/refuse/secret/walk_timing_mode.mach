# refuse:  secret.unverifiable
# targets: linux-aarch64 linux-aarch64-optimized linux-aarch64-dit linux-aarch64-dit-optimized
use std.runtime;

# only the switch the compiler places may change the timing mode a constant-time
# function's code is checked under: an asm block that clears pstate.dit is refused,
# with no secret anywhere
#[constant_time("soft")]
fun off() {
    asm armv8-a {
        mov x9, xzr
        msr dit, x9
    }
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    off();
    ret 0;
}
