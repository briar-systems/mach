# refuse: secret.cast_qualifier
use std.runtime;

# a pointer's pointee keeps its secrecy at every depth: a public alias of secret storage
# would read the secret back as public
fun open(p: *^u8) *u8 {
    ret p::*u8;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var k: ^u8 = 3;
    ret open(?k)[0]::i64;
}
