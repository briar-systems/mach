# refuse:  secret.unverifiable
# targets: linux-x86_64 linux-aarch64 linux-riscv64
use std.runtime;

# a callee-saved register may hold the caller's secret at entry: a constant-time function
# with no secret parameter that returns one as a public result is refused
#[constant_time("soft")]
fun peek() u64 {
    var r: u64 = 0;
    $if ($mach.build.arch == $mach.arch.x86_64) {
        asm x86-64 {
            mov {r}, rbx
        }
    }
    $or ($mach.build.arch == $mach.arch.aarch64) {
        asm armv8-a {
            str x19, {r}
        }
    }
    $or {
        asm rv64i {
            sd s1, {r}
        }
    }
    ret r;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    ret peek()::i64 & 0;
}
