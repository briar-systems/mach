# refuse: secret.call_untrusted
use std.runtime;

#[constant_time("soft")]
fun mix(k: ^u64) ^u64 {
    ret k ^ 5;
}

# a plain function type states no constant-time mode, so a secret passed through a value
# of one is refused whatever the value points at. an alias of the type marked
# `#[constant_time]` would state one
#[constant_time("soft")]
fun apply(f: fun(^u64) ^u64, k: ^u64) ^u64 {
    ret f(k);
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    ret apply(mix, argc::u64):>u64::i64;
}
