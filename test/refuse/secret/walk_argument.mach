# refuse:  secret.unverifiable
# targets: linux-x86_64 linux-aarch64 linux-riscv64
use std.runtime;

#[constant_time("soft")]
fun next(n: u64) u64 {
    ret n + 1;
}

# a callee checked constant time is trusted only as its declaration states: an asm block
# puts a secret into a local whose type is public, and passing the local where the
# callee declares a public parameter is refused
#[constant_time("soft")]
fun hand(p: *^u64) u64 {
    var x: u64 = 0;
    $if ($mach.build.arch == $mach.arch.x86_64) {
        asm x86-64 {
            mov rax, {p}
            mov rcx, [rax]
            mov {x}, rcx
        }
    }
    $or ($mach.build.arch == $mach.arch.aarch64) {
        asm armv8-a {
            ldr x9, {p}
            ldr x10, [x9]
            str x10, {x}
        }
    }
    $or {
        asm rv64i {
            ld t0, {p}
            ld t1, 0(t0)
            sd t1, {x}
        }
    }
    ret next(x);
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var k: ^u64 = argc::u64;
    ret hand(?k)::i64;
}
