# refuse: secret.call_untrusted
use std.runtime;

fun count(va: ...) u64 {
    var t: u64 = 0;
    $each k in va { t = t + 1; }
    ret t;
}

#[constant_time("soft")]
fun forward(va: ...) u64 {
    ret count(va...);
}

#[constant_time("soft")]
fun relay(va: ...) u64 {
    ret forward(va...);
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val k: ^u64 = argc::u64;
    ret relay(1u64, k)::i64;
}
