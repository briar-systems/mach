# refuse:  secret.call_untrusted
# targets: linux-aarch64 linux-riscv64
use std.runtime;

#[constant_time("soft")]
fun mix(k: ^u64) ^u64 {
    ret k ^ 5;
}

# a hard caller may trust a soft callee only where the build guarantees every timing
# mode a soft function's code may be held under, which an aarch64 build without dit and
# a riscv64 build without zkt do not
#[constant_time("hard")]
fun apply(k: ^u64) ^u64 {
    ret mix(k);
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    ret apply(argc::u64):>u64::i64;
}
