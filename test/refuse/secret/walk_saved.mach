# refuse:  secret.unverifiable
# targets: linux-x86_64 linux-x86_64-optimized linux-aarch64 linux-aarch64-optimized linux-riscv64
use std.runtime;

# the block writes callee-saved registers, so the prologue saves them, and then stores
# onto one of those save slots: the epilogue would restore what the block wrote into
# the caller's register. a store of code the compiler did not make onto a save slot is
# refused whatever it stores
#[constant_time("soft")]
fun spoil(s: *^u64) {
    $if ($mach.build.arch == $mach.arch.x86_64) {
        asm x86-64 {
            mov rax, {s}
            mov rcx, [rax]
            xor ebp, ebp
            mov [rsp - 8], rcx
        }
    }
    $or ($mach.build.arch == $mach.arch.aarch64) {
        asm armv8-a {
            ldr x9, {s}
            ldr x10, [x9]
            mov x19, 0
            mov x20, 0
            mov x21, 0
            mov x22, 0
            add x12, sp, 0x10
            str x10, [x12]
        }
    }
    $or {
        asm rv64i {
            ld t0, {s}
            ld t1, 0(t0)
            li s1, 0
            li s2, 0
            li s3, 0
            li s0, 0
            addi t2, sp, 0x28
            sd t1, 0(t2)
        }
    }
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var k: ^u64 = argc::u64;
    spoil(?k);
    ret 0;
}
