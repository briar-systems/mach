# refuse:  secret.unverifiable
# targets: darwin-aarch64 darwin-x86_64
use std.runtime;

#[thread]
var count: u64 = 0;

# darwin reaches a thread-local through a call of the runtime's resolver, which the
# check cannot see into, so a constant-time function that names one is refused there
#[constant_time("soft")]
fun bump(k: ^u64) ^u64 {
    count = count + 1;
    ret k ^ 1;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    ret bump(argc::u64):>u64::i64;
}
