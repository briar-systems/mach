# refuse: cast.invalid
use std.runtime;

# a cast never gives a function type a constant-time mode, since nothing would check the
# claim it makes

#[constant_time("soft")]
def Seal: fun(u64) u64;

fun plain(k: u64) u64 {
    ret k + 1;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val raw:  u64  = plain:~u64;
    val seal: Seal = raw:~Seal;
    ret seal(argc::u64)::i64;
}
