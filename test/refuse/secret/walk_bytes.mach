# refuse:  secret.unverifiable
# targets: linux-x86_64 linux-x86_64-optimized linux-aarch64 linux-aarch64-optimized linux-riscv64
use std.runtime;

rec R { k: ^u32; n: u32; }

# the walk holds a register's secrecy byte by byte: a record of a secret and a public
# word shares one register, and a shift by 28 moves secret bits into the low word that
# becomes the public result
#[constant_time("soft")]
fun low(s: R) u32 {
    var x: u32 = 0;
    $if ($mach.build.arch == $mach.arch.x86_64) {
        asm x86-64 {
            mov rax, {s}
            shr rax, 28
            mov {x}, eax
        }
    }
    $or ($mach.build.arch == $mach.arch.aarch64) {
        asm armv8-a {
            ldr x9, {s}
            lsr x9, x9, 28
            str w9, {x}
        }
    }
    $or {
        asm rv64i {
            ld t0, {s}
            srli t0, t0, 28
            sw t0, {x}
        }
    }
    ret x;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    ret low(R{k: argc::^u32, n: 5})::i64;
}
