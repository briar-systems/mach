# refuse: secret.call_untrusted
use std.runtime;

# a weak definition may be replaced at link time by code no check here held to constant
# time, so it is not trusted with a secret even when it is marked
#[weak("mix")]
#[constant_time("soft")]
fun mix(k: ^u64) ^u64 {
    ret k ^ 5;
}

#[constant_time("soft")]
fun apply(k: ^u64) ^u64 {
    ret mix(k);
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    ret apply(argc::u64):>u64::i64;
}
