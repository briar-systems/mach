# refuse: type.mismatch
use std.runtime;

# a value of a function type marked constant time holds only a function declared in that
# mode or a stronger one, so an unmarked function with the same signature is refused

#[constant_time("soft")]
def Seal: fun(*^u8, u64) ^u64;

fun sum_bytes(data: *^u8, n: u64) ^u64 {
    var acc: ^u64 = 0;
    var i:   u64  = 0;
    for (i < n) {
        acc = acc + data[i]::^u64;
        i   = i + 1;
    }
    ret acc;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var bytes: [1]^u8 = [1]^u8{3};
    val seal:  Seal   = sum_bytes;
    ret seal(?bytes[0], 1):>u64::i64;
}
