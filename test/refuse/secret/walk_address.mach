# refuse:  secret.unverifiable
# targets: linux-x86_64 linux-aarch64 linux-riscv64
use std.runtime;

# a load whose address is formed from a secret, inside an asm block, is refused by the walk
#[constant_time("soft")]
fun look(t: *[8]u8, k: ^u64) u8 {
    var r: u8 = 0;
    $if ($mach.build.arch == $mach.arch.x86_64) {
        asm x86-64 {
            mov rcx, {k}
            and rcx, 7
            mov rdx, {t}
            movzx eax, byte ptr [rdx + rcx]
            mov {r}, al
        }
    }
    $or ($mach.build.arch == $mach.arch.aarch64) {
        asm armv8-a {
            ldr x9, {k}
            and x9, x9, 7
            ldr x10, {t}
            ldrb w11, [x10, x9]
            strb w11, {r}
        }
    }
    $or {
        asm rv64i {
            ld t0, {k}
            andi t0, t0, 7
            ld t1, {t}
            add t1, t1, t0
            lbu t2, 0(t1)
            sb t2, {r}
        }
    }
    ret r;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var t: [8]u8 = [8]u8{1, 2, 3, 4, 5, 6, 7, 8};
    ret look(?t, argc::u64)::i64;
}
