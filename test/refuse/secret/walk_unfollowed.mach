# refuse:  secret.unverifiable
# targets: linux-x86_64 linux-aarch64 linux-riscv64
use std.runtime;

# what the walk cannot follow it refuses: a jump to an address a register holds leaves
# the code the walk reads, even when the address is public
#[constant_time("soft")]
fun away(k: ^u64, to: u64) {
    $if ($mach.build.arch == $mach.arch.x86_64) {
        asm x86-64 {
            mov rax, {to}
            jmp rax
        }
    }
    $or ($mach.build.arch == $mach.arch.aarch64) {
        asm armv8-a {
            ldr x9, {to}
            br x9
        }
    }
    $or {
        asm rv64i {
            ld t0, {to}
            jalr t1, 0(t0)
        }
    }
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    away(argc::u64, 0);
    ret 0;
}
