# refuse:  secret.unverifiable
# targets: linux-x86_64 linux-x86_64-optimized linux-aarch64 linux-aarch64-optimized linux-riscv64
use std.runtime;

tag T: u8 {
    p: u64;
    s: ^u64;
}

#[constant_time("soft")]
fun look(q: *u64) u64 {
    if (@q == 3) { ret 1; }
    ret 0;
}

#[constant_time("soft")]
fun set_s(t: *T, a: ^u64) {
    @t = T.s{a};
}

# a guard is lexical, so a write of the secret case through a pointer leaves the public
# case's guard standing. the front end lets `?t.p` go to a callee that states its pointee
# public, and the walk refuses it: the memory it points into may hold a secret
#[constant_time("soft")]
fun test(a: ^u64) u64 {
    var t: T = T.p{0};
    if (sel t.p) {
        set_s(?t, a);
        ret look(?t.p);
    }
    ret 0;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    ret test(argc::u64)::i64;
}
