# refuse:  secret.unverifiable
# targets: linux-x86_64 linux-aarch64-dit linux-riscv64-zkt
use std.runtime;

# a division's timing depends on its operands on every target, under the timing mode too,
# so a secret dividend in an asm block's divide is refused by the walk
#[constant_time("soft")]
fun third(k: ^u64) ^u64 {
    var r: ^u64 = 0;
    $if ($mach.build.arch == $mach.arch.x86_64) {
        asm x86-64 {
            mov rax, {k}
            mov edx, 0
            mov ecx, 3
            div rcx
            mov {r}, rax
        }
    }
    $or ($mach.build.arch == $mach.arch.aarch64) {
        asm armv8-a {
            ldr x9, {k}
            mov x10, 3
            udiv x11, x9, x10
            str x11, {r}
        }
    }
    $or {
        asm rv64im {
            ld t0, {k}
            li t1, 3
            divu t2, t0, t1
            sd t2, {r}
        }
    }
    ret r;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    ret third(argc::u64):>u64::i64;
}
