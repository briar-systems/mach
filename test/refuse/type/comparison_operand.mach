# refuse: type.mismatch
use std.runtime;

# a comparison binds tighter than `&`, so `x & 0x0f != 0` gives `&` the u1 of `0x0f != 0`,
# which is refused with a note that the comparison was read first

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val x: u8 = argc::u8;
    if (x & 0x0f != 0) {
        ret 1;
    }
    ret 0;
}
