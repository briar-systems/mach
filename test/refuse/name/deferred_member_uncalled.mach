# refuse: visibility.not_exported
use capability: std.system.capability;
use std.runtime;
use std.system.os;

# a missing module member in the arm a body `$if` selects on another module's constant is
# reported in a function nothing calls, as `mach check` sees it

pub fun f() i64 {
    $if (capability.HOSTED) {
        ret os.no_such_function();
    }
    ret 0;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    ret 0;
}
