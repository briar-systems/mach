# refuse: name.duplicate
use std.runtime;

fun identity[T](value: T) T {
    ret value;
}

#[symbol("symbol_instance.symbol_instance.identity$i64")]
fun imposter(value: i64) i64 {
    ret value + 1;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    ret identity[i64](0) + imposter(-1);
}
