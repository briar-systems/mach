# refuse: visibility.not_exported
use capability: std.system.capability;
use std.runtime;
use std.system.os;

# a module member that does not exist, in the arm a body `$if` selects on a constant of another
# module, which resolve leaves for sema to decide, is reported when that arm is selected

fun pid() i64 {
    $if (capability.HOSTED) {
        ret os.no_such_function();
    }
    ret 0;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    ret pid();
}
