# refuse: syntax.expected_expr
use std.runtime;

# a `def` is a module-scope declaration, so one in a function body is a syntax error, and the
# declaration is skipped whole rather than read again as a name

fun f() {
    def A: i64;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    f();
    ret 0;
}
