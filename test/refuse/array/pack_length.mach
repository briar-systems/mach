# refuse: array.length_not_const
use std.runtime;

# a variadic pack's `.len` is not a compile-time value, so it sizes no array. the file pins the
# key, the reason it names is the fix

fun count(va: ...) u64 {
    var a: [va.len]u8;
    ret 0;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    ret count(1, 2)::i64;
}
