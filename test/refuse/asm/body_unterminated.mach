# refuse: asm.unterminated
use std.runtime;

# a block comment that is never closed holds every brace after it, so the body never closes
fun f() {
    asm x86-64 {
        nop     /* a block comment the body never closes }
    }
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    f();
    ret 0;
}
