# refuse: asm.head
use std.runtime;

# no instruction set of masc's reads the head, so nothing says where the body ends. the
# block is read though its arm is never taken on the host
fun f() {
    $if ($mach.build.arch == $mach.arch.riscv32) {
        asm x86-65 {
            nop
        }
    }
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    f();
    ret 0;
}
