# refuse:  asm.syntax
# targets: linux-aarch64 linux-riscv64
use std.runtime;

# a data directive on a set whose instructions keep an alignment emits a whole number of
# that unit, four bytes on aarch64 and two on riscv64, or every later instruction is off it
fun f() {
    $if ($mach.build.arch == $mach.arch.aarch64) {
        asm armv8-a {
            .byte 0x1f, 0x20, 0x03
        }
    }
    $or ($mach.build.arch == $mach.arch.riscv64) {
        asm rv64i {
            .byte 0x13, 0x00, 0x00
        }
    }
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    f();
    ret 0;
}
