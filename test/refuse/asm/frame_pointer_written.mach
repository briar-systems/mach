# refuse:  asm.unsupported
# targets: linux-x86_64 linux-aarch64 linux-riscv64
use std.runtime;

# the block moves the stack pointer, so the function keeps its frame pointer, and the
# block then writes that register
fun clobber() {
    $if ($mach.build.arch == $mach.arch.x86_64) {
        asm x86-64 {
            push rax
            mov rbp, rax
            pop rax
        }
    }
    $or ($mach.build.arch == $mach.arch.aarch64) {
        asm armv8-a {
            sub sp, sp, 16
            mov x29, x9
            add sp, sp, 16
        }
    }
    $or {
        asm rv64i {
            addi sp, sp, -16
            mv s0, t0
            addi sp, sp, 16
        }
    }
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    clobber();
    ret 0;
}
