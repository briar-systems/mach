# refuse: asm.operand
# targets: linux-x86_64
use capability: std.system.capability;
use std.runtime;

# a `#[naked]` function has no frame, so an asm block in the arm the build selects cannot bind a
# name. sema refuses it at check as the build does. run/asm/naked_unselected_bind.mach holds the
# same block in the arm not selected, which builds

#[naked]
fun echo(a: u64) u64 {
    $if (capability.HOSTED) {
        asm x86-64 {
            mov rax, {a}
            ret
        }
    }
    $or {
        asm x86-64 {
            mov rax, rdi
            ret
        }
    }
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    ret echo(0)::i64;
}
