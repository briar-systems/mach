# refuse: ret.missing
use std.runtime;

tag Reply: u8 {
    empty;
    value: i64;
}

fun read(r: Reply) i64 {
    if (sel r.empty)                    { ret 0; }
    or (sel r.value && r.value > 0)     { ret 1; }
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    ret read(Reply.value{argc});
}
