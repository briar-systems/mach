# refuse:  spirv.interface
# targets: vulkan-spirv-1.1
# under Vulkan 1.1 a uniform block follows std140, which strides an array by 16 bytes, so an
# array of f32 at mach's 4-byte stride is refused rather than silently repacked
rec Weights { w: [4]f32; }

rec Out { v: f32; }

#[gpu.uniform(0, 0)]
var weights: Weights;
#[gpu.storage(0, 1)]
var out:     Out;

#[gpu.stage("compute")]
fun main() {
    out.v = weights.w[1];
}
