# refuse:  op.signature
# targets: vulkan-spirv
# UMin reads its operands as unsigned, so a declaration over i32 would compute another value
# than it states
rec Out { v: i32; }

#[gpu.storage(0, 0)]
var out: Out;

#[intrinsic("spirv", "GLSL.std.450", "UMin")]
fun umin(a: i32, b: i32) i32;

#[gpu.stage("compute")]
fun main() {
    out.v = umin(out.v, 3);
}
