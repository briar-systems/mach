# refuse:  spirv.unsupported
# targets: vulkan-spirv
# flags:   --ext VariablePointersStorageBuffer
# a pointer parameter one call passes a member of a storage block and another a whole block
# needs two pointer types, so the function is refused and is split into one for each
rec Item { a: u32; b: u32; }

rec Buf { n: u32; inner: Item; }

#[gpu.storage(0, 0)]
var data: Buf;
#[gpu.storage(0, 1)]
var whole: Item;

fun bump(p: *Item) {
    p.a = p.b + 1;
}

#[gpu.stage("compute")]
#[gpu.workgroup(1, 1, 1)]
fun main() {
    bump(?data.inner);
    bump(?whole);
}
