# refuse:  op.operand_count
# targets: vulkan-spirv
# Sqrt takes one operand, and this declaration takes two
rec Out { v: f32; }

#[gpu.storage(0, 0)]
var out: Out;

#[intrinsic("spirv", "GLSL.std.450", "Sqrt")]
fun sqrt(x: f32, y: f32) f32;

#[gpu.stage("compute")]
fun main() {
    out.v = sqrt(out.v, 2.0);
}
