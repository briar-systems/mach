# refuse:  spirv.capability
# targets: vulkan-spirv-1.0
# a subgroup operation needs SPIR-V 1.3, past the SPIR-V 1.0 that Vulkan 1.0 consumes
rec Out { v: u32; }

#[gpu.storage(0, 0)]
var out: Out;

#[intrinsic("spirv", "core", "OpGroupNonUniformElect")]
fun elect(scope: u32) u32;

#[gpu.stage("compute")]
fun main() {
    out.v = elect(3);
}
