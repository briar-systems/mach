# refuse:  handle.operand_type
# targets: vulkan-spirv
# a type a handle operand names is a scalar texel or a handle, never a record
rec Texel { r: f32; g: f32; }

#[handle("spirv", "image", Texel, "2D", 0, 0, 0, 1, "Unknown")]
def Texture2D;

#[gpu.sampler(0, 0)]
var texture: Texture2D;

#[gpu.stage("fragment")]
fun main() {}
