# refuse:  spirv.unsupported
# targets: vulkan-spirv
# logical addressing lets a call take a whole local but not a pointer into part of one
rec Out { v: u32; }

#[gpu.storage(0, 0)]
var out: Out;

fun read(p: *u32) u32 {
    ret @p;
}

#[gpu.stage("compute")]
fun main() {
    var pair: [2]u32 = [2]u32{out.v, 1};
    out.v = read(?pair[1]);
}
