# refuse:  op.signature
# targets: vulkan-spirv
# OpArrayLength's literal is the index of the last member of the record its pointer points to,
# the run-time array, so a call passing another member's index is refused
rec Tail { n: u32; items: [0]u32; }

#[gpu.storage(0, 0)]
var tail: Tail;

#[intrinsic("spirv", "core", "OpArrayLength")]
fun length(p: *Tail, member: u32) u32;

#[gpu.stage("compute")]
#[gpu.workgroup(1, 1, 1)]
fun main() {
    tail.n = length(?tail, 0);
}
