# refuse:  op.result_flow
# targets: vulkan-spirv
# a sampled image is consumed in the block that made it, so a function cannot return one
#[handle("spirv", "image", f32, "2D", 0, 0, 0, 1, "Unknown")]
def Texture2D;

#[handle("spirv", "sampled_image", Texture2D)]
def Sampler2D;

#[handle("spirv", "sampler")]
def Sampler;

#[intrinsic("spirv", "core", "OpSampledImage")]
fun combine(t: Texture2D, s: Sampler) Sampler2D;

#[intrinsic("spirv", "core", "OpImageSampleImplicitLod")]
fun sample(s: Sampler2D, uv: f32x2) f32x4;

#[gpu.sampler(0, 0)]
var base:   Texture2D;
#[gpu.sampler(0, 1)]
var linear: Sampler;
#[gpu.input(0)]
var uv:     f32x2;
#[gpu.output(0)]
var colour: f32x4;

fun joined() Sampler2D {
    ret combine(base, linear);
}

#[gpu.stage("fragment")]
fun main() {
    colour = sample(joined(), uv);
}
