# refuse:  read.writeonly_storage
# targets: vulkan-spirv linux-x86_64
# a writeonly binding declares that nothing reads it, so a read is refused on every target
rec Frame { texels: [16]u32; }

#[gpu.storage(0, 0, "writeonly")]
var frame: Frame;

#[gpu.stage("compute")]
fun main() {
    frame.texels[0] = frame.texels[1];
}
