# refuse:  spirv.interface
# targets: vulkan-spirv
# a built-in exists only in the stages SPIR-V defines it in: a fragment stage cannot reach the
# compute stage's invocation id, here through a function it calls
#[gpu.builtin("global_invocation")]
var gid:    u32x3;
#[gpu.output(0)]
var colour: f32x4;

fun shade() f32 {
    ret gid[0]::f32;
}

#[gpu.stage("fragment")]
fun main() {
    colour = f32x4{shade(), 0.0, 0.0, 1.0};
}
