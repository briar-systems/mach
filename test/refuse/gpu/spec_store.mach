# refuse:  assign.readonly_storage
# targets: vulkan-spirv linux-x86_64
# a specialization constant is the host's once the pipeline exists, so a store to it is
# refused on every target
rec Out { v: u32; }

#[gpu.storage(0, 0)]
var out:  Out;
#[gpu.spec(0)]
var tile: u32 = 64;

#[gpu.stage("compute")]
fun main() {
    tile  = 32;
    out.v = tile;
}
