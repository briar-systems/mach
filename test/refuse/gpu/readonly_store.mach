# refuse:  spirv.readonly_store
# targets: vulkan-spirv
# a readonly binding admits an atomic load but not an atomic add, which writes it
rec Counter { n: u32; }

#[gpu.storage(0, 0, "readonly")]
var counter: Counter;

#[intrinsic("spirv", "core", "OpAtomicIAdd")]
fun atomic_add(p: *u32, scope: u32, semantics: u32, v: u32) u32;

#[gpu.stage("compute")]
fun main() {
    val old: u32 = atomic_add(?counter.n, 1, 0x48, 1);
}
