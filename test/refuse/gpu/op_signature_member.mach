# refuse:  op.signature
# targets: vulkan-spirv
# FrexpStruct returns a record of the significand and a 32-bit exponent, so an exponent member
# of another width breaks its row, refused at the declaration
rec Parts { mantissa: f32; exponent: i64; }

rec Out { v: f32; }

#[gpu.storage(0, 0)]
var out: Out;

#[intrinsic("spirv", "GLSL.std.450", "FrexpStruct")]
fun frexp(x: f32) Parts;

#[gpu.stage("compute")]
fun main() {
    out.v = 1.0;
}
