# refuse:  spirv.capability
# targets: vulkan-spirv
# a 64-bit integer needs the Int64 feature, which Vulkan 1.3 leaves optional and this
# target does not select
rec Totals { sum: u64; }

#[gpu.storage(0, 0)]
var totals: Totals;

#[gpu.stage("compute")]
fun main() {
    totals.sum = totals.sum + 1;
}
