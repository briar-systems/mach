# refuse: spirv.recursion
# targets: vulkan-spirv
# SPIR-V has no call stack, so no function of a shader may reach itself
rec Buf { v: [4]u32; }

#[gpu.storage(0, 0)]
var data: Buf;

fun spin(n: u32) u32 {
    ret spin(n + 1);
}

#[gpu.stage("compute")]
#[gpu.workgroup(1, 1, 1)]
fun main() {
    data.v[0] = spin(data.v[1]);
}
