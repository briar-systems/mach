# refuse:  handle.role
# targets: vulkan-spirv
# a handle binds as a descriptor through gpu.sampler or gpu.storage, never as a uniform block
#[handle("spirv", "image", f32, "2D", 0, 0, 0, 1, "Unknown")]
def Texture2D;

#[gpu.uniform(0, 0)]
var texture: Texture2D;

#[gpu.stage("fragment")]
fun main() {}
