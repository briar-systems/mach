# refuse:  handle.storage
# targets: vulkan-spirv
# a handle names a descriptor, not storage the program owns, so it cannot sit in an array
#[handle("spirv", "image", f32, "2D", 0, 0, 0, 1, "Unknown")]
def Texture2D;

#[gpu.sampler(0, 0)]
var textures: [4]Texture2D;

#[gpu.stage("fragment")]
fun main() {}
