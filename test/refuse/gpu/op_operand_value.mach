# refuse:  op.operand_value
# targets: vulkan-spirv
# Vulkan defines no sequentially consistent order, so an atomic asking for one is refused
rec Counter { n: u32; }

#[gpu.storage(0, 0)]
var counter: Counter;

#[intrinsic("spirv", "core", "OpAtomicIAdd")]
fun atomic_add(p: *u32, scope: u32, semantics: u32, v: u32) u32;

#[gpu.stage("compute")]
fun main() {
    val old: u32 = atomic_add(?counter.n, 1, 0x50, 1);
}
