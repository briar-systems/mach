# refuse:  spirv.recursive_type
# targets: vulkan-spirv
# a generic whose argument grows through a pointer at each step has unboundedly many types,
# which logical addressing cannot declare
rec Grow[T] { value: T; next: *Grow[*T]; }

rec Out { v: u32; }

#[gpu.storage(0, 0)]
var out: Out;

#[gpu.stage("compute")]
fun main() {
    var g: Grow[u32];
    g.value = 1;
    out.v   = g.value;
}
