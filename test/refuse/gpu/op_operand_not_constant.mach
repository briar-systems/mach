# refuse:  op.operand_not_constant
# targets: vulkan-spirv
# a barrier's scopes are constant ids, so one read from a buffer at run time is refused
rec Params { scope: u32; }

#[gpu.storage(0, 0)]
var params: Params;

#[intrinsic("spirv", "core", "OpControlBarrier")]
fun barrier(execution: u32, memory: u32, semantics: u32);

#[gpu.stage("compute")]
fun main() {
    barrier(params.scope, 2, 0x108);
}
