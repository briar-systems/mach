# refuse:  spirv.writeonly_load
# targets: vulkan-spirv
# a load the compiler follows through a writeonly binding's address reads the binding
rec Frame { texels: [16]u32; }

rec Out { v: u32; }

#[gpu.storage(0, 0, "writeonly")]
var frame: Frame;
#[gpu.storage(0, 1)]
var out:   Out;

#[gpu.stage("compute")]
fun main() {
    val p: *u32 = ?frame.texels[2];
    out.v = @p;
}
