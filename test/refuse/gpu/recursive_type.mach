# refuse:  spirv.recursive_type
# targets: vulkan-spirv
# a record that reaches itself through a pointer to an array of it has no type logical
# addressing can declare, since only a pointer to a record names it rather than spelling it
rec Tree { kids: *[2]Tree; value: u32; }

rec Out { v: u32; }

#[gpu.storage(0, 0)]
var out: Out;

#[gpu.stage("compute")]
fun main() {
    var t: Tree;
    t.value = 1;
    out.v   = t.value;
}
