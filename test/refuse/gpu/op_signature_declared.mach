# refuse:  op.signature
# targets: vulkan-spirv
# a declaration is held to its row whether or not anything calls it: OpSDot reads a scalar as
# four packed bytes, so a 16-bit one is no type the instruction operates on
rec Out { v: u32; }

#[gpu.storage(0, 0)]
var out: Out;

#[intrinsic("spirv", "core", "OpSDot")]
fun dot(x: i16, y: i16) i32;

#[gpu.stage("compute")]
fun main() {
    out.v = 1;
}
