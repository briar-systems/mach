# refuse:  op.unknown
# targets: vulkan-spirv
# an instruction the language writes with an operator is no intrinsic: OpIAdd is `+`
rec Out { v: u32; }

#[gpu.storage(0, 0)]
var out: Out;

#[intrinsic("spirv", "core", "OpIAdd")]
fun add(a: u32, b: u32) u32;

#[gpu.stage("compute")]
fun main() {
    out.v = add(out.v, 1);
}
