# refuse: decorator.not_constant
use std.runtime;

# `symbol` names what the link sees as the module loads, so its string must be known then

rec Packet { len: u32; }

#[symbol($type_name(Packet))]
fun named() i64 {
    ret 0;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    ret named();
}
