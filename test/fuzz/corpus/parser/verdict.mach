use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.string.str;

use R: std.types.result;

pub rec Verdict {
    finding: bool;
    detail:  str;
}

pub fun accepted() Verdict {
    var v: Verdict;
    v.finding = false;
    v.detail  = "";
    ret v;
}

pub fun rejected(detail: str) Verdict {
    var v: Verdict;
    v.finding = false;
    v.detail  = detail;
    ret v;
}

pub fun violated(detail: str) Verdict {
    var v: Verdict;
    v.finding = true;
    v.detail  = detail;
    ret v;
}

pub fun rejected_if_err(r: R.Result[bool, str]) Verdict {
    if (R.is_err[bool, str](r)) { ret rejected(R.unwrap_err[bool, str](r)); }
    ret accepted();
}
