# the subject of the f16 proof (#3804): the f16 operations this compiler
# lowers, over one slice of a mode's input domain, written to stdout as raw
# little-endian 16-bit words for check.c to hold against its correctly rounded
# reference. a record is what one input's function below writes, in order, and
# check.c reads it in the same order.
#
# usage: f16proof <mode> <lo> <hi>. the modes:
# - add, sub, mul, div: a in [lo, hi) and every b. the f16 operator, the same
#   operation widened to binary32 and to binary64 and narrowed once, then two
#   mutations: narrowed twice, through 13 significand bits and then to f16,
#   and truncated to f16 precision before the narrowing
# - narrow32: every binary32 encoding in [lo, hi) to f16
# - narrow64: every binary64 whose high word is in [lo, hi) and whose low word
#   is 0 or 1, to f16
# - int32: every 32-bit x in [lo, hi) to f16 as i32, u32, the i64 and u64 of
#   those, and x << 32 as u64 and i64
# - int16: every 16-bit x in [lo, hi) to f16 as i16, u16, i8, u8
# - widen: every f16 in [lo, hi) to binary32 and binary64
# - toint: every f16 in [lo, hi) to each integer width, directly and through
#   binary64

use std.filesystem;
use std.io.writer;
use std.print;
use std.runtime;
use std.text.parse;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

val CAP: u32 = 65536;

var buf:    [65536]u16;
var pos:    u32 = 0;
var out:    writer.Writer;
var failed: u8  = 0;

fun flush() {
    if (pos == 0 || failed != 0) {
        pos = 0;
        ret;
    }
    val r: err[writer.WriteError] = writer.write_all(?out, (?buf[0])::*u8, pos::usize * 2);
    if (sel r.err) { failed = 1; }
    pos = 0;
}

fun put16(v: u16) {
    buf[pos] = v;
    pos      = pos + 1;
    if (pos == CAP) { flush(); }
}

fun put64(v: u64) {
    put16(v::u16);
    put16((v >> 16)::u16);
    put16((v >> 32)::u16);
    put16((v >> 48)::u16);
}

# the binary64 `d` rounded to 13 significand bits (a Veltkamp split), so
# narrowing it rounds twice through a format short of binary16's 2p+2 bits: a
# mutation the proof must catch. narrowing through binary32 is not one, since
# binary32 has those 24 bits and rounds just as the binary32 variant does
fun twice(d: f64) f64 {
    if (d != d || d - d != 0.0) { ret d; }
    val c: f64 = d * 1099511627777.0;
    ret c - (c - d);
}

# the binary64 `d` with every significand bit below f16 precision cleared, so
# narrowing it truncates where it should round: a mutation the proof must catch
fun chop(d: f64) f64 {
    if (d != d) { ret d; }
    ret ((d:~u64) & 0xFFFFFC0000000000):~f64;
}

# one pair of every arithmetic mode. out of line, so each rounding runs on
# operands read at run time
#[noinline]
fun arith(op: u32, a: f16, b: f16) {
    var h: f16 = a;
    var s: f32 = 0.0;
    var d: f64 = 0.0;
    if (op == 0) {
        h = a + b;
        s = a::f32 + b::f32;
        d = a::f64 + b::f64;
    }
    or (op == 1) {
        h = a - b;
        s = a::f32 - b::f32;
        d = a::f64 - b::f64;
    }
    or (op == 2) {
        h = a * b;
        s = a::f32 * b::f32;
        d = a::f64 * b::f64;
    }
    or {
        h = a / b;
        s = a::f32 / b::f32;
        d = a::f64 / b::f64;
    }
    put16(h:~u16);
    put16(s::f16:~u16);
    put16(d::f16:~u16);
    put16(twice(d)::f16:~u16);
    put16(chop(d)::f16:~u16);
}

fun run_arith(op: u32, lo: u64, hi: u64) {
    var x: u64 = lo;
    for (x < hi && failed == 0) {
        val a: f16 = x::u16:~f16;
        var y: u32 = 0;
        for (y < 65536) {
            arith(op, a, y::u16:~f16);
            y = y + 1;
        }
        x = x + 1;
    }
}

#[noinline]
fun narrow32(x: u32) {
    put16(x:~f32::f16:~u16);
}

#[noinline]
fun narrow64(hi: u64) {
    put16((hi << 32):~f64::f16:~u16);
    put16(((hi << 32) | 1):~f64::f16:~u16);
}

#[noinline]
fun int32(x: u32) {
    val w: u64 = x::u64 << 32;
    put16((x:~i32)::f16:~u16);
    put16(x::f16:~u16);
    put16((x:~i32)::i64::f16:~u16);
    put16(x::u64::f16:~u16);
    put16(w::f16:~u16);
    put16((w:~i64)::f16:~u16);
}

#[noinline]
fun int16(x: u16) {
    put16((x:~i16)::f16:~u16);
    put16(x::f16:~u16);
    put16((x::u8:~i8)::f16:~u16);
    put16(x::u8::f16:~u16);
}

#[noinline]
fun widen(a: f16) {
    put64((a::f32:~u32)::u64);
    put64(a::f64:~u64);
}

#[noinline]
fun toint(a: f16) {
    val d: f64 = a::f64;
    put64((a::i8:~u8)::u64);
    put64((d::i8:~u8)::u64);
    put64((a::i16:~u16)::u64);
    put64((d::i16:~u16)::u64);
    put64((a::i32:~u32)::u64);
    put64((d::i32:~u32)::u64);
    put64(a::i64:~u64);
    put64(d::i64:~u64);
    put64(a::u8::u64);
    put64(d::u8::u64);
    put64(a::u16::u64);
    put64(d::u16::u64);
    put64(a::u32::u64);
    put64(d::u32::u64);
    put64(a::u64);
    put64(d::u64);
}

fun run_conv(mode: u32, lo: u64, hi: u64) {
    var x: u64 = lo;
    for (x < hi && failed == 0) {
        if (mode == 0) { narrow32(x::u32); }
        or (mode == 1) { narrow64(x); }
        or (mode == 2) { int32(x::u32); }
        or (mode == 3) { int16(x::u16); }
        or (mode == 4) { widen(x::u16:~f16); }
        or             { toint(x::u16:~f16); }
        x = x + 1;
    }
}

fun arg(s: str) u64 {
    val r: res[u64, parse.ParseError] = parse.parse_u64_exact(s, 10);
    if (sel r.err) { ret 0xFFFFFFFFFFFFFFFF; }
    ret r.ok;
}

fun usage() i64 {
    print.eprintln("usage: f16proof <add|sub|mul|div|narrow32|narrow64|int32|int16|widen|toint> <lo> <hi>");
    ret 2;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    if (argc != 4) { ret usage(); }
    val m:        str = argv[1];
    val lo:       u64 = arg(argv[2]);
    val hi:       u64 = arg(argv[3]);
    var arith_op: u32 = 4;
    var conv:     u32 = 6;
    var domain:   u64 = 0x10000;
    if (str_equals(m, "add"))      { arith_op = 0; }
    or (str_equals(m, "sub"))      { arith_op = 1; }
    or (str_equals(m, "mul"))      { arith_op = 2; }
    or (str_equals(m, "div"))      { arith_op = 3; }
    or (str_equals(m, "narrow32")) { conv = 0; }
    or (str_equals(m, "narrow64")) { conv = 1; }
    or (str_equals(m, "int32"))    { conv = 2; }
    or (str_equals(m, "int16"))    { conv = 3; }
    or (str_equals(m, "widen"))    { conv = 4; }
    or (str_equals(m, "toint"))    { conv = 5; }
    or                             { ret usage(); }
    if (conv <= 2)                 { domain = 0x100000000; }
    if (lo > hi || hi > domain)    { ret usage(); }
    out = filesystem.writer(filesystem.STDOUT);
    if (arith_op < 4) { run_arith(arith_op, lo, hi); }
    or                { run_conv(conv, lo, hi); }
    flush();
    if (failed != 0) {
        print.eprintln("f16proof: writing stdout failed");
        ret 1;
    }
    ret 0;
}
