# sampled images in a fragment stage: a combined image and sampler, reached directly and through
# a pointer a function takes, and a separately bound pair joined by OpSampledImage, sampled at
# an implicit and an explicit level of detail, fetched, gathered with a constant offset and
# queried through the image a sampled image holds, a cube image sampled by direction, and a
# depth image sampled by comparison
#[handle("spirv", "image", f32, "2D", 0, 0, 0, 1, "Unknown")]
def Texture2D;

#[handle("spirv", "sampled_image", Texture2D)]
def Sampler2D;

#[handle("spirv", "sampler")]
def Sampler;

#[handle("spirv", "image", f32, "2D", 1, 0, 0, 1, "Unknown")]
def Depth2D;

#[handle("spirv", "sampled_image", Depth2D)]
def Shadow2D;

#[handle("spirv", "image", f32, "Cube", 0, 0, 0, 1, "Unknown")]
def TextureCube;

#[handle("spirv", "sampled_image", TextureCube)]
def SamplerCube;

#[intrinsic("spirv", "core", "OpImageSampleImplicitLod")]
fun sample(s: Sampler2D, uv: f32x2) f32x4;

#[intrinsic("spirv", "core", "OpImageSampleExplicitLod")]
fun sample_lod(s: Sampler2D, uv: f32x2, mask: u32, lod: f32) f32x4;

#[intrinsic("spirv", "core", "OpSampledImage")]
fun combine(t: Texture2D, s: Sampler) Sampler2D;

#[intrinsic("spirv", "core", "OpImage")]
fun image_of(s: Sampler2D) Texture2D;

#[intrinsic("spirv", "core", "OpImageFetch")]
fun fetch(t: Texture2D, at: i32x2, mask: u32, lod: i32) f32x4;

#[intrinsic("spirv", "core", "OpImageGather")]
fun gather(s: Sampler2D, uv: f32x2, component: u32, mask: u32, offset: i32x2) f32x4;

#[intrinsic("spirv", "core", "OpImageQuerySizeLod")]
fun size(t: Texture2D, lod: i32) i32x2;

#[intrinsic("spirv", "core", "OpImageSampleDrefImplicitLod")]
fun shadow(s: Shadow2D, uv: f32x2, depth: f32) f32;

#[intrinsic("spirv", "core", "OpImageSampleImplicitLod")]
fun sample_cube(s: SamplerCube, direction: f32x3) f32x4;

#[gpu.sampler(0, 0)]
var albedo:  Sampler2D;
#[gpu.sampler(0, 1)]
var base:    Texture2D;
#[gpu.sampler(0, 2)]
var linear:  Sampler;
#[gpu.sampler(0, 3)]
var shadows: Shadow2D;
#[gpu.sampler(0, 4)]
var sky:     SamplerCube;
#[gpu.input(0)]
var uv:      f32x2;
#[gpu.output(0)]
var colour:  f32x4;

fun through(s: *Sampler2D, at: f32x2) f32x4 {
    ret sample(@s, at);
}

#[gpu.stage("fragment")]
fun main() {
    var c: f32x4 = through(?albedo, uv) + sample(combine(base, linear), uv);
    c = c + sample_cube(sky, f32x3{uv[0], uv[1], 1.0});
    c = c + sample_lod(albedo, uv, 0x2, 1.0);
    c = c + fetch(base, i32x2{1, 2}, 0x2, 0);
    c = c + gather(albedo, uv, 1, 0x8, i32x2{1, 0});
    val n: i32x2 = size(image_of(albedo), 0);
    colour = c * f32x4{n[0]::f32, n[1]::f32, shadow(shadows, uv, 0.5), 1.0};
}
