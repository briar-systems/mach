# 32-bit atomics and barriers: an add, a compare-exchange and a signed minimum on a storage
# buffer, an increment on workgroup memory ordered by a control barrier, an add on a storage
# image texel through a texel pointer, and an atomic load from a readonly binding
#[handle("spirv", "image", u32, "2D", 0, 0, 0, 2, "R32ui")]
def Counts;

rec Totals { sum: u32; seen: u32; low: i32; }

rec Limit { cap: u32; }

#[gpu.storage(0, 0)]
var totals:  Totals;
#[gpu.storage(0, 1)]
var counts:  Counts;
#[gpu.storage(0, 2, "readonly")]
var limit:   Limit;
#[gpu.shared]
var arrived: u32;
#[gpu.builtin("local_invocation_index")]
var lane:    u32;

#[intrinsic("spirv", "core", "OpAtomicIAdd")]
fun atomic_add(p: *u32, scope: u32, semantics: u32, v: u32) u32;

#[intrinsic("spirv", "core", "OpAtomicCompareExchange")]
fun atomic_swap(p: *u32, scope: u32, equal: u32, unequal: u32, v: u32, comparator: u32) u32;

#[intrinsic("spirv", "core", "OpAtomicSMin")]
fun atomic_min(p: *i32, scope: u32, semantics: u32, v: i32) i32;

#[intrinsic("spirv", "core", "OpAtomicIIncrement")]
fun atomic_increment(p: *u32, scope: u32, semantics: u32) u32;

#[intrinsic("spirv", "core", "OpAtomicLoad")]
fun atomic_load(p: *u32, scope: u32, semantics: u32) u32;

#[intrinsic("spirv", "core", "OpImageTexelPointer")]
fun texel(image: *Counts, at: i32x2, sample: u32) *u32;

#[intrinsic("spirv", "core", "OpControlBarrier")]
fun barrier(execution: u32, memory: u32, semantics: u32);

#[gpu.stage("compute")]
#[gpu.workgroup(64, 1, 1)]
fun main() {
    val n: u32 = atomic_increment(?arrived, 2, 0x108);
    barrier(2, 2, 0x108);
    if (n < atomic_load(?limit.cap, 1, 0x42)) {
        val before: u32 = atomic_add(?totals.sum, 1, 0x48, lane);
        val was:    u32 = atomic_swap(?totals.seen, 1, 0x48, 0x42, 1, 0);
        val low:    i32 = atomic_min(?totals.low, 1, 0x48, before::i32 - was::i32);
        val old:    u32 = atomic_add(texel(?counts, i32x2{lane::i32, 0}, 0), 1, 0x808, 1);
    }
}
