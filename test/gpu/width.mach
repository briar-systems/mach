# targets: vulkan-spirv-none
# integers at their own width under the features that hold them: 8-, 16- and 64-bit members
# of a storage buffer and a uniform block, a record of narrow members in a local, 64-bit
# arithmetic, and a 64-bit atomic, which the environments with a bound declare only when the
# target names each feature
rec Wide { total: u64; count: i64; bytes: [8]u8; halves: [4]i16; }

rec Params { step: u16; shift: u8; scale: i64; }

rec Pair { lo: u8; hi: u16; }

#[gpu.storage(0, 0)]
var wide:   Wide;
#[gpu.uniform(0, 1)]
var params: Params;
#[gpu.builtin("global_invocation")]
var gid:    u32x3;

#[intrinsic("spirv", "core", "OpAtomicIAdd")]
fun atomic_add(p: *u64, scope: u32, semantics: u32, v: u64) u64;

#[gpu.stage("compute")]
#[gpu.workgroup(8, 1, 1)]
fun main() {
    val i:    u32  = gid[0];
    var pair: Pair = Pair{lo: wide.bytes[i]::u8, hi: params.step};
    pair.lo            = pair.lo + params.shift;
    wide.bytes[i]      = pair.lo;
    wide.halves[i % 4] = (pair.hi::i16) - 300;
    val big: u64 = (i::u64 << 40) * params.scale::u64;
    val old: u64 = atomic_add(?wide.total, 1, 0x48, big);
    if (old > 0xffff_ffff_0000) {
        wide.count = wide.count - 1;
    }
}
