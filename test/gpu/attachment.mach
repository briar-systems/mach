# subpass inputs: a fragment stage reads two input attachments at its own place, each bound at
# a descriptor and an input attachment index
#[handle("spirv", "image", f32, "SubpassData", 0, 0, 0, 2, "Unknown")]
def SubpassInput;

#[intrinsic("spirv", "core", "OpImageRead")]
fun load(img: SubpassInput, at: i32x2) f32x4;

#[gpu.storage(0, 0)]
#[gpu.attachment(0)]
var albedo: SubpassInput;
#[gpu.storage(0, 1)]
#[gpu.attachment(1)]
var light:  SubpassInput;
#[gpu.output(0)]
var colour: f32x4;

#[gpu.stage("fragment")]
fun main() {
    colour = load(albedo, i32x2{0, 0}) * load(light, i32x2{0, 0});
}
