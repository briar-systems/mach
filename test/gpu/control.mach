# control flow in a compute stage: a branch on a buffer value and a counted loop
rec Data { v: [64]u32; n: u32; }

#[gpu.storage(0, 0)] var data: Data;
#[gpu.builtin("global_invocation")] var gid: u32x3;

#[gpu.stage("compute")]
#[gpu.workgroup(64, 1, 1)]
fun main() {
    val i: u32 = gid[0];
    if (i >= data.n) { ret; }
    var acc: u32 = 0;
    var k: u32 = 0;
    for (k < 4) {
        acc = acc + data.v[i] * k;
        k = k + 1;
    }
    data.v[i] = acc;
}
