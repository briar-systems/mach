# control flow in a compute stage, which SPIR-V requires to be structured: an early return on
# a buffer value, a counted loop, a chain of conditions with a fallback, a nested loop that
# skips with cnt and leaves with brk, and an unconditional loop left from its middle
rec Data { v: [64]u32; n: u32; }

#[gpu.storage(0, 0)]
var data: Data;
#[gpu.builtin("global_invocation")]
var gid:  u32x3;

#[gpu.stage("compute")]
#[gpu.workgroup(64, 1, 1)]
fun main() {
    val i: u32 = gid[0];
    if (i >= data.n) { ret; }
    var acc: u32 = 0;
    var k:   u32 = 0;
    for (k < 4) {
        acc = acc + data.v[i] * k;
        k   = k + 1;
    }
    if (acc > 100) {
        acc = acc - 100;
    }
    or (acc > 10) {
        acc = acc * 2;
    }
    or {
        acc = acc + 1;
    }
    var row: u32 = 0;
    for (row < 8) {
        row = row + 1;
        if (row % 2 == 0) { cnt; }
        var col: u32 = 0;
        for (col < 8) {
            if (data.v[col] == row) { brk; }
            acc = acc ^ col;
            col = col + 1;
        }
    }
    var steps: u32 = 0;
    for {
        steps = steps + 1;
        if (acc <= 1 || steps == 32) { brk; }
        acc = acc >> 1;
    }
    data.v[i] = acc + steps;
}
