# a compute stage over a uniform block and storage buffers, through a helper function: a
# buffer read and written, a readonly one, a writeonly one, a coherent one, and one no body
# writes, which is decorated as never written without a qualifier
rec Params { factor: f32x4; bias: f32; }

rec Data { v: [64]f32; }

rec Flags { done: u32; }

#[gpu.uniform(0, 0)]
var params: Params;
#[gpu.storage(0, 1)]
var data:   Data;
#[gpu.storage(0, 2, "readonly")]
var source: Data;
#[gpu.storage(0, 3, "writeonly")]
var result: Data;
#[gpu.storage(0, 4, "coherent")]
var flags:  Flags;
#[gpu.storage(0, 5)]
var table:  Data;
#[gpu.builtin("global_invocation")]
var gid:    u32x3;

fun scale(x: f32, k: f32, b: f32) f32 {
    ret x * k + b;
}

#[gpu.stage("compute")]
#[gpu.workgroup(64, 1, 1)]
fun main() {
    val i: u32 = gid[0];
    val x: f32 = scale(source.v[i] + data.v[i] + table.v[63 - i], params.factor[0], params.bias);
    result.v[i] = x;
    data.v[i]   = x * 0.5;
    if (i == 0) {
        flags.done = flags.done + 1;
    }
}
