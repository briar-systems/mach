# a compute stage over a storage buffer and a uniform block, through a helper function
rec Params { factor: f32x4; bias: f32; }

rec Data { v: [64]f32; }

#[gpu.uniform(0, 0)] var params: Params;
#[gpu.storage(0, 1)] var data: Data;
#[gpu.builtin("global_invocation")] var gid: u32x3;

fun scale(x: f32, k: f32, b: f32) f32 {
    ret x * k + b;
}

#[gpu.stage("compute")]
#[gpu.workgroup(64, 1, 1)]
fun main() {
    val i: u32 = gid[0];
    data.v[i] = scale(data.v[i], params.factor[0], params.bias);
}
