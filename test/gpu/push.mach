# push-constant blocks: two stages of one module each read their own block, since Vulkan
# admits one per entry point, and the compute stage scales a buffer by its block's values
rec Scale { factor: f32; offset: f32; count: u32; }

rec Tint { colour: f32x4; }

rec Data { v: [64]f32; }

#[gpu.push]
var scale:  Scale;
#[gpu.push]
var tint:   Tint;
#[gpu.storage(0, 0)]
var data:   Data;
#[gpu.builtin("global_invocation")]
var gid:    u32x3;
#[gpu.output(0)]
var colour: f32x4;

#[gpu.stage("compute")]
#[gpu.workgroup(64, 1, 1)]
fun scale_main() {
    val i: u32 = gid[0];
    if (i < scale.count) {
        data.v[i] = data.v[i] * scale.factor + scale.offset;
    }
}

#[gpu.stage("fragment")]
fun tint_main() {
    colour = tint.colour;
}
