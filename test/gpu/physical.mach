# targets: vulkan-spirv vulkan-spirv-none
# physical pointers, which Vulkan 1.3 requires of every device: pointers stored in a buffer
# lead to records in other buffers, which are read, written and followed two links deep, and
# a store through a pointer read from a readonly binding writes what it points to
rec Node { next: *Node; value: u32; }

rec Head { first: *Node; second: *Node; total: u32; }

rec Shard { v: [64]u32; }

rec Table { shards: [4]*Shard; }

#[gpu.storage(0, 0)]
var head:  Head;
#[gpu.storage(0, 1, "readonly")]
var table: Table;
#[gpu.builtin("global_invocation")]
var gid:   u32x3;

#[gpu.stage("compute")]
#[gpu.workgroup(64, 1, 1)]
fun main() {
    val i: u32   = gid[0];
    val p: *Node = head.first;
    head.second  = p.next;
    p.next.value = p.value + p.next.next.value;
    head.total   = head.second.value;
    val s: *Shard = table.shards[i % 4];
    s.v[i] = s.v[i] + head.total;
}
