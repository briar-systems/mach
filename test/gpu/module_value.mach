# module-level values of 1 and 8 bits: one nothing a stage reaches reads is no part of the
# module, and one a stage reads is carried as a local of its width is, so an environment with
# no Int8 builds it, std's bool and its true included
use std.types.bool.bool;
use std.types.bool.true;

rec Out { flags: [4]u32; bytes: [4]u32; }

#[gpu.storage(0, 0)]
var out: Out;
#[gpu.builtin("global_invocation")]
var gid: u32x3;

val ON:     u1 = 1;
val STEP:   u8 = 200;
val UNUSED: u8 = 3;
val NEVER:  u1 = 0;

fun unreached(x: u8) u8 {
    ret x * UNUSED;
}

fun lifted(x: u8) u8 {
    ret x + STEP;
}

#[gpu.stage("compute")]
#[gpu.workgroup(4, 1, 1)]
fun main() {
    val i: u32  = gid[0];
    val b: u8   = i::u8 + STEP;
    val t: bool = true;
    out.bytes[i] = lifted(b)::u32;
    if (ON)      { out.flags[0] = 1; }
    if (t == ON) { out.flags[1] = 1; }
    out.flags[2] = ON::u32 + t::u32;
}
