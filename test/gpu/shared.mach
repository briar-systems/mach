# workgroup memory: a compute stage stores into a shared array by its local invocation
# and writes a storage buffer from it
rec Out { v: [64]u32; }

#[gpu.storage(0, 0)] var out: Out;
#[gpu.builtin("local_invocation")] var lid: u32x3;
#[gpu.shared] var tile: [64]u32;

#[gpu.stage("compute")]
#[gpu.workgroup(64, 1, 1)]
fun main() {
    val i: u32 = lid[0];
    tile[i] = i * i;
    out.v[i] = tile[i] + 1;
}
