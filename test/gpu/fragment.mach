# a fragment stage: a float input, an integer input the pipeline cannot interpolate, an output
# starting at its initializer and one starting at zero, each varying at its own location
#[gpu.input(0)]
var in_colour:  f32x4;
#[gpu.input(1)]
var in_layer:   u32;
#[gpu.output(0)]
var out_colour: f32x4 = f32x4{0.0, 0.0, 0.0, 1.0};
#[gpu.output(1)]
var out_mask:   u32;

#[gpu.stage("fragment")]
fun main() {
    if (in_layer != 0) {
        out_colour = in_colour;
        out_mask   = in_layer;
    }
}
