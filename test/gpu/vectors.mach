# vectors and matrices: lane-wise float and integer arithmetic, a comparison giving a lane
# mask, lane reads and a range of lanes, conversions between vector types, a three-lane vector,
# and a matrix held as an array of column vectors multiplying a vector in a vertex stage
rec Camera { view: [4]f32x4; tint: f32x4; }

#[gpu.uniform(0, 0)]
var camera:      Camera;
#[gpu.input(0)]
var in_position: f32x4;
#[gpu.input(1)]
var in_index:    u32x4;
#[gpu.output(0)]
var out_colour:  f32x4;
#[gpu.output(1)]
var out_mask:    u32x4;
#[gpu.builtin("position")]
var position:    f32x4;

fun transform(m: [4]f32x4, v: f32x4) f32x4 {
    val x: f32x4 = f32x4{v[0], v[0], v[0], v[0]};
    val y: f32x4 = f32x4{v[1], v[1], v[1], v[1]};
    val z: f32x4 = f32x4{v[2], v[2], v[2], v[2]};
    val w: f32x4 = f32x4{v[3], v[3], v[3], v[3]};
    ret m[0] * x + m[1] * y + m[2] * z + m[3] * w;
}

fun cross(a: f32x3, b: f32x3) f32x3 {
    ret f32x3{a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0]};
}

#[gpu.stage("vertex")]
fun main() {
    position = transform(camera.view, in_position);
    val n: f32x3 = cross(in_position[0, 3]::f32x3, f32x3{0.0, 1.0, 0.0});
    val k: u32x4 = in_index * u32x4{2, 3, 4, 5} + (in_index >> u32x4{1, 1, 1, 1});
    out_mask   = in_position < camera.tint;
    out_colour = camera.tint * k::f32x4 + f32x4{n[0], n[1], n[2], 0.0} - f32x4{1.0, 1.0, 1.0, 0.0} / camera.tint;
}
