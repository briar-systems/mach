# targets: vulkan-spirv-none
# the subgroup operation families a device feature enables: a vote, an arithmetic reduction
# and scan, a clustered reduction, a ballot and broadcast, a shuffle, a relative shuffle and a
# quad swap, each declaring its own capability
use std.types.bool.bool;

rec Data { v: [64]u32; f: [64]f32; }

#[gpu.storage(0, 0)]
var data: Data;
#[gpu.builtin("local_invocation_index")]
var lane: u32;

#[intrinsic("spirv", "core", "OpGroupNonUniformAll")]
fun all(scope: u32, predicate: bool) bool;

#[intrinsic("spirv", "core", "OpGroupNonUniformIAdd")]
fun add(scope: u32, operation: u32, v: u32) u32;

#[intrinsic("spirv", "core", "OpGroupNonUniformIAdd")]
fun cluster_add(scope: u32, operation: u32, v: u32, cluster_size: u32) u32;

#[intrinsic("spirv", "core", "OpGroupNonUniformFMax")]
fun max(scope: u32, operation: u32, v: f32) f32;

#[intrinsic("spirv", "core", "OpGroupNonUniformBallot")]
fun ballot(scope: u32, predicate: bool) u32x4;

#[intrinsic("spirv", "core", "OpGroupNonUniformBroadcastFirst")]
fun first(scope: u32, v: u32) u32;

#[intrinsic("spirv", "core", "OpGroupNonUniformShuffleXor")]
fun shuffle_xor(scope: u32, v: u32, mask: u32) u32;

#[intrinsic("spirv", "core", "OpGroupNonUniformShuffleDown")]
fun shuffle_down(scope: u32, v: u32, delta: u32) u32;

#[intrinsic("spirv", "core", "OpGroupNonUniformQuadSwap")]
fun quad_swap(scope: u32, v: f32, direction: u32) f32;

#[gpu.stage("compute")]
#[gpu.workgroup(64, 1, 1)]
fun main() {
    val v: u32   = data.v[lane];
    val b: u32x4 = ballot(3, v > 4);
    var r: u32   = add(3, 0, v) + add(3, 1, v) + cluster_add(3, 3, v, 4) + b[0];
    r = r + first(3, v) + shuffle_xor(3, v, 1) + shuffle_down(3, v, 2);
    if (all(3, r != 0)) {
        data.v[lane] = r;
    }
    data.f[lane] = max(3, 0, data.f[lane]) + quad_swap(3, data.f[lane], 0);
}
