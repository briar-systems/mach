# a store past a loop to the element the loop stopped at, whose address the optimizer computes
# in the loop header and its unrolled copy and merges at the exit, which the optimized target
# builds with the merge carried as the index and the address rebuilt at the join
rec Buf { v: [64]u32; }

#[gpu.storage(0, 0)]
var buf: Buf;
#[gpu.builtin("global_invocation")]
var gid: u32x3;

#[gpu.stage("compute")]
#[gpu.workgroup(64, 1, 1)]
fun main() {
    var b: u32 = gid[0];
    for (buf.v[b] != 7) { b = (b + 1) & 63; }
    buf.v[b] = 0;
}
