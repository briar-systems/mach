# built-ins of three stages in one module, each read or written only in its own stage: the
# instance index and point size of a vertex stage, the window coordinate of a fragment stage,
# and the workgroup id, workgroup count and flattened local index of a compute stage
rec Out { v: [64]u32; }

#[gpu.storage(0, 0)]
var out:        Out;
#[gpu.builtin("position")]
var position:   f32x4;
#[gpu.builtin("point_size")]
var point_size: f32;
#[gpu.builtin("instance_index")]
var instance:   u32;
#[gpu.builtin("frag_coord")]
var frag_coord: f32x4;
#[gpu.builtin("workgroup_id")]
var group:      u32x3;
#[gpu.builtin("num_workgroups")]
var groups:     u32x3;
#[gpu.builtin("local_invocation_index")]
var local:      u32;
#[gpu.output(0)]
var colour:     f32x4;

#[gpu.stage("vertex")]
fun vertex_main() {
    position   = f32x4{instance::f32, 0.0, 0.0, 1.0};
    point_size = 2.0;
}

#[gpu.stage("fragment")]
fun fragment_main() {
    colour = frag_coord * f32x4{0.5, 0.5, 1.0, 1.0};
}

#[gpu.stage("compute")]
#[gpu.workgroup(8, 8, 1)]
fun compute_main() {
    out.v[local] = group[0] + group[1] * groups[0];
}
