# pointer parameters a shader function never reads: an unused pointer to a module-scope
# variable, an unused pointer to a sampled image's binding, an unused pointer passed on to
# another function, and a pointer to a binding the callee samples through
#[handle("spirv", "image", f32, "2D", 0, 0, 0, 1, "Unknown")]
def Texture2D;

#[handle("spirv", "sampled_image", Texture2D)]
def Sampler2D;

#[intrinsic("spirv", "core", "OpImageSampleImplicitLod")]
fun sample(s: Sampler2D, uv: f32x2) f32x4;

#[gpu.sampler(0, 0)]
var albedo:     Sampler2D;
#[gpu.input(0)]
var in_uv:      f32x2;
#[gpu.output(0)]
var out_colour: f32x4;
var tint:       f32x4;

fun ignore_value(p: *f32x4) {}

fun ignore_image(p: *Sampler2D) {}

fun pass_on(p: *f32x4) {
    ignore_value(p);
}

fun shade(p: *Sampler2D, uv: f32x2) f32x4 {
    ret sample(@p, uv);
}

#[gpu.stage("fragment")]
fun main() {
    ignore_value(?tint);
    ignore_image(?albedo);
    pass_on(?tint);
    out_colour = shade(?albedo, in_uv) + tint;
}
