# targets: vulkan-spirv-1.1 vulkan-spirv-1.2 vulkan-spirv vulkan-spirv-none
# the basic subgroup operation and the subgroup built-ins, which need SPIR-V 1.3 and no device
# feature: one invocation of each subgroup is elected to record its subgroup's size and place
rec Out { size: [16]u32; place: [16]u32; }

#[gpu.storage(0, 0)]
var out:        Out;
#[gpu.builtin("subgroup_size")]
var size:       u32;
#[gpu.builtin("subgroup_invocation")]
var invocation: u32;
#[gpu.builtin("subgroup_id")]
var id:         u32;
#[gpu.builtin("num_subgroups")]
var count:      u32;

#[intrinsic("spirv", "core", "OpGroupNonUniformElect")]
fun elect(scope: u32) u32;

#[gpu.stage("compute")]
#[gpu.workgroup(64, 1, 1)]
fun main() {
    if (elect(3) != 0) {
        out.size[id % 16]  = size;
        out.place[id % 16] = count * 100 + invocation;
    }
}
