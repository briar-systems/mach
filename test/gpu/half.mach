# targets: vulkan-spirv-none
# 16- and 64-bit floats under the features that hold them: f16 in a storage buffer, a push
# block and a stage input and output, computed natively, and f64 arithmetic and conversions
# between the three widths, which the environments with a bound declare only when the target
# names each feature
rec Values { h: [8]f16; d: [8]f64; }

rec Push { gain: f16; bias: f16; }

#[gpu.storage(0, 0)]
var values:    Values;
#[gpu.push]
var push:      Push;
#[gpu.input(0)]
var in_shade:  f16x4;
#[gpu.output(0)]
var out_shade: f16x4;
#[gpu.builtin("global_invocation")]
var gid:       u32x3;

#[gpu.stage("compute")]
#[gpu.workgroup(8, 1, 1)]
fun compute_main() {
    val i: u32 = gid[0];
    val h: f16 = values.h[i] * push.gain + push.bias;
    val d: f64 = values.d[i] * 0.5 + h::f64;
    values.h[i] = d::f16;
    values.d[i] = (h::f32 * 3.0)::f64 + d;
}

#[gpu.stage("fragment")]
fun fragment_main() {
    out_shade = in_shade * f16x4{push.gain, push.gain, push.gain, 1.0};
}
