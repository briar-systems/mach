# storage images and texel buffers in a compute stage: a readonly image read, a writeonly image
# written, a coherent image read and written, an image of a signed integer format read and
# written, a storage texel buffer read and written, a uniform texel buffer fetched, and an
# image's size queried
#[handle("spirv", "image", f32, "2D", 0, 0, 0, 2, "Rgba8")]
def Colour2D;

#[handle("spirv", "image", f32, "2D", 0, 0, 0, 2, "R32f")]
def Scalar2D;

#[handle("spirv", "image", i32, "2D", 0, 0, 0, 2, "R32i")]
def Signed2D;

#[handle("spirv", "image", f32, "Buffer", 0, 0, 0, 2, "Rgba32f")]
def StorageTexels;

#[handle("spirv", "image", f32, "Buffer", 0, 0, 0, 1, "Unknown")]
def UniformTexels;

#[intrinsic("spirv", "core", "OpImageRead")]
fun read(img: Colour2D, at: i32x2) f32x4;

#[intrinsic("spirv", "core", "OpImageWrite")]
fun write(img: Colour2D, at: i32x2, texel: f32x4);

#[intrinsic("spirv", "core", "OpImageRead")]
fun read_scalar(img: Scalar2D, at: i32x2) f32x4;

#[intrinsic("spirv", "core", "OpImageWrite")]
fun write_scalar(img: Scalar2D, at: i32x2, texel: f32);

#[intrinsic("spirv", "core", "OpImageRead")]
fun read_signed(img: Signed2D, at: i32x2) i32x4;

#[intrinsic("spirv", "core", "OpImageWrite")]
fun write_signed(img: Signed2D, at: i32x2, texel: i32);

#[intrinsic("spirv", "core", "OpImageRead")]
fun read_texel(img: StorageTexels, at: i32) f32x4;

#[intrinsic("spirv", "core", "OpImageWrite")]
fun write_texel(img: StorageTexels, at: i32, texel: f32x4);

#[intrinsic("spirv", "core", "OpImageFetch")]
fun fetch_texel(img: UniformTexels, at: i32) f32x4;

#[intrinsic("spirv", "core", "OpImageQuerySize")]
fun size(img: Colour2D) i32x2;

#[gpu.storage(0, 0, "readonly")]
var source:  Colour2D;
#[gpu.storage(0, 1, "writeonly")]
var target:  Colour2D;
#[gpu.storage(0, 2, "coherent")]
var running: Scalar2D;
#[gpu.storage(0, 5)]
var offsets: Signed2D;
#[gpu.storage(0, 3)]
var texels:  StorageTexels;
#[gpu.sampler(0, 4)]
var table:   UniformTexels;
#[gpu.builtin("global_invocation")]
var gid:     u32x3;

#[gpu.stage("compute")]
#[gpu.workgroup(8, 8, 1)]
fun main() {
    val at: i32x2 = i32x2{gid[0]::i32, gid[1]::i32};
    val n:  i32x2 = size(source);
    if (at[0] >= n[0] || at[1] >= n[1]) { ret; }
    val c: f32x4 = read(source, at) * fetch_texel(table, at[0]);
    write(target, at, c);
    write_scalar(running, at, read_scalar(running, at)[0] + c[0]);
    write_signed(offsets, at, read_signed(offsets, at)[0] - 1);
    write_texel(texels, at[1], read_texel(texels, at[0]) + c);
}
