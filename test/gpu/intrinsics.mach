# functions that are target instructions: typed GLSL.std.450 float rows, one with a scalar
# among vector operands and one storing through an out-pointer, signed and unsigned integer
# rows, typed core rows returning a scalar from vectors, a truth value per lane and a count,
# and an untyped row returning a structure, each call becoming its instruction inline
rec Data { v: [8]f32x4; f: [8]f32; i: [8]i32; u: [8]u32; e: [8]i32x4; }

rec Parts { mantissa: f32; exponent: i32; }

#[gpu.storage(0, 0)]
var data: Data;
#[gpu.builtin("global_invocation")]
var gid:  u32x3;

#[intrinsic("spirv", "GLSL.std.450", "Sqrt")]
fun sqrt(x: f32) f32;

#[intrinsic("spirv", "GLSL.std.450", "Normalize")]
fun normalize(v: f32x4) f32x4;

#[intrinsic("spirv", "GLSL.std.450", "FMix")]
fun mix(a: f32x4, b: f32x4, t: f32x4) f32x4;

#[intrinsic("spirv", "GLSL.std.450", "Refract")]
fun refract(i: f32x4, n: f32x4, eta: f32) f32x4;

#[intrinsic("spirv", "GLSL.std.450", "Frexp")]
fun frexp(x: f32x4, exp: *i32x4) f32x4;

#[intrinsic("spirv", "GLSL.std.450", "SMin")]
fun smin(a: i32, b: i32) i32;

#[intrinsic("spirv", "GLSL.std.450", "UClamp")]
fun uclamp(x: u32, lo: u32, hi: u32) u32;

#[intrinsic("spirv", "GLSL.std.450", "FrexpStruct")]
fun frexp_struct(x: f32) Parts;

#[intrinsic("spirv", "core", "OpDot")]
fun dot(a: f32x4, b: f32x4) f32;

#[intrinsic("spirv", "core", "OpIsNan")]
fun is_nan(v: f32x4) u32x4;

#[intrinsic("spirv", "core", "OpAny")]
fun any(v: u32x4) u32;

#[intrinsic("spirv", "core", "OpBitCount")]
fun bit_count(x: u32) u32;

#[gpu.stage("compute")]
#[gpu.workgroup(8, 1, 1)]
fun main() {
    val i: u32   = gid[0];
    val v: f32x4 = normalize(data.v[i]);
    var e: i32x4 = i32x4{0, 0, 0, 0};
    val m: f32x4 = frexp(mix(v, refract(v, v, 0.5), f32x4{0.25, 0.25, 0.25, 0.25}), ?e);
    data.v[i] = m;
    data.e[i] = e;
    data.f[i] = sqrt(dot(v, v));
    if (any(is_nan(m)) != 0) {
        data.i[i] = smin(data.i[i], -1);
    }
    val p: Parts = frexp_struct(data.f[i]);
    data.u[i] = uclamp(bit_count(data.u[i]), 1, 30) + p.exponent::u32;
}
