# specialization constants: an unsigned and a signed integer and a float read as constants the
# host sets, the first also sizing the compute workgroup, which an environment with SPIR-V 1.2
# and maintenance4 writes as LocalSizeId and every other as a WorkgroupSize built-in
rec Out { v: [64]f32; }

#[gpu.storage(0, 0)]
var out:  Out;
#[gpu.builtin("global_invocation")]
var gid:  u32x3;
#[gpu.spec(0)]
var tile: u32 = 64;
#[gpu.spec(1)]
var gain: f32 = 0.5;
#[gpu.spec(2)]
var flip: i32 = -1;

#[gpu.stage("compute")]
#[gpu.workgroup(tile, 1, 1)]
fun main() {
    val i: u32 = gid[0] % tile;
    out.v[i] = out.v[i] * gain * flip::f32;
}
