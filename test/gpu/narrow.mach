# 8- and 16-bit integers and 16-bit floats with no feature that computes at their width: each
# local, parameter, result and vector lane is carried in 32 bits and wrapped or extended at its
# own width, and an f16 computes as the software expansion, so every environment builds it
rec Data { a: u32; b: u32; f: [4]f32; out: [8]u32; }

#[gpu.storage(0, 0)]
var data: Data;

fun wrap(x: u8, y: u8) u8 {
    ret x * y + 7;
}

fun blend(a: f16x4, b: f16x4) f16x4 {
    ret a * b + a / b - b;
}

#[gpu.stage("compute")]
#[gpu.workgroup(1, 1, 1)]
fun main() {
    var b: u8  = data.a::u8;
    val c: i8  = data.b::i8;
    var h: u16 = data.a::u16;
    val s: i16 = data.b::i16;
    b           = b + 200;
    h           = h * 3;
    data.out[0] = wrap(b, data.b::u8)::u32;
    data.out[1] = (c >> 2)::i32::u32;
    data.out[2] = (h << 9)::u32;
    data.out[3] = (s / 7)::i32::u32;
    if (c > -3) { data.out[4] = 1; }
    val v: u8x4 = u8x4{b, b, c::u8, c::u8} + u8x4{250, 6, 1, 255};
    data.out[5] = v[0]::u32 + v[3]::u32;
    val f: f16x4 = f16x4{data.f[0]::f16, data.f[1]::f16, data.f[2]::f16, data.f[3]::f16};
    val r: f16x4 = blend(f, f);
    data.f[0]   = r[0]::f32;
    data.out[6] = r[3]:~u16::u32;
}
