# rows typed by their result's shape or its members: a run-time array's length, the last member
# of a storage buffer's record, and an add with its carry, whose result record holds exactly
# the two members its row names
rec Data { u: [4]u32; }

rec Tail { n: u32; items: [0]u32; }

rec Sum { value: u32; carry: u32; }

#[gpu.storage(0, 0)]
var data: Data;
#[gpu.storage(0, 1)]
var tail: Tail;

#[intrinsic("spirv", "core", "OpArrayLength")]
fun length(p: *Tail, member: u32) u32;

#[intrinsic("spirv", "core", "OpIAddCarry")]
fun add_carry(x: u32, y: u32) Sum;

#[gpu.stage("compute")]
#[gpu.workgroup(1, 1, 1)]
fun main() {
    data.u[0] = length(?tail, 1);
    val s: Sum = add_carry(data.u[2], data.u[3]);
    data.u[2] = s.value;
    data.u[3] = s.carry;
}
