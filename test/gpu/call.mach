# calls in a shader: records and tags passed and returned by value, a tag's case selected
# and guarded, a generic function's instance, and the pointers logical addressing lets a call
# take with no feature (a whole local, a whole module-scope variable, a whole workgroup
# variable, and a pointer parameter passed on through another call)
rec Acc { sum: u32; count: u32; }

tag Step: u32 {
    skip;
    add: u32;
    double;
}

rec Out { v: [64]u32; }

#[gpu.storage(0, 0)]
var out:    Out;
#[gpu.builtin("local_invocation_index")]
var lane:   u32;
#[gpu.shared]
var tile:   [64]u32;
var visits: u32;

fun classify(x: u32) Step {
    if (x == 0)     { ret Step.skip{}; }
    if (x % 2 == 0) { ret Step.double{}; }
    ret Step.add{x};
}

fun apply(acc: Acc, s: Step) Acc {
    var next: Acc = acc;
    if (sel s.add) {
        next.sum = next.sum + s.add;
    }
    or (sel s.double) {
        next.sum = next.sum * 2;
    }
    next.count = next.count + 1;
    ret next;
}

fun larger[T](a: T, b: T) T {
    if (a > b) { ret a; }
    ret b;
}

fun bump(n: *u32) {
    @n = @n + 1;
}

fun bump_twice(n: *u32) {
    bump(n);
    bump(n);
}

fun store(t: *[64]u32, i: u32, x: u32) {
    (@t)[i] = x;
}

#[gpu.stage("compute")]
#[gpu.workgroup(64, 1, 1)]
fun main() {
    var acc: Acc = Acc{sum: 1, count: 0};
    var k:   u32 = 0;
    for (k < 4) {
        acc = apply(acc, classify(lane + k));
        k   = k + 1;
    }
    var calls: u32 = 0;
    bump_twice(?calls);
    bump(?visits);
    store(?tile, lane, acc.sum);
    out.v[lane] = larger[u32](tile[lane], acc.count) + calls + visits;
}
