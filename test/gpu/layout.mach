# block layouts: a uniform block and a storage buffer whose members (scalars, vectors after
# scalars, arrays of vectors and of scalars, a nested record) sit at mach's own offsets, which
# every environment's layout rules admit, so what the shader reads is what the host wrote
rec Light { position: f32x4; colour: f32x3; power: f32; }

rec Frame { lights: [4]Light; count: u32; scale: f32; pad: f32x2; ambient: f32x4; }

rec Items { weights: [16]f32; pairs: [8]u32x2; total: f32; flags: u32; }

#[gpu.uniform(0, 0)]
var frame: Frame;
#[gpu.storage(0, 1)]
var items: Items;
#[gpu.builtin("global_invocation")]
var gid:   u32x3;

#[gpu.stage("compute")]
#[gpu.workgroup(16, 1, 1)]
fun main() {
    val i:     u32   = gid[0];
    val light: Light = frame.lights[i % 4];
    val pair:  u32x2 = items.pairs[i % 8];
    items.weights[i] = light.power * frame.scale + light.colour[1] + frame.ambient[3] + (pair[0] + pair[1])::f32;
    if (i == 0) {
        items.total = frame.pad[0];
        items.flags = frame.count;
    }
}
