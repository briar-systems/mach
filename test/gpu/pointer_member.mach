# targets: vulkan-spirv
# flags:   --ext VariablePointersStorageBuffer
# a pointer parameter takes its type from what its calls pass: a member of a storage block, an
# element of an array of records in one, the same passed on through another call, and the
# whole block to a function of its own
rec Item { a: u32; b: u32; }

rec Buf { n: u32; inner: Item; items: [4]Item; }

#[gpu.storage(0, 0)]
var data: Buf;

fun bump(p: *Item) {
    p.a = p.b + 1;
}

fun via(p: *Item) {
    bump(p);
}

fun count(p: *Buf) {
    p.n = p.n + 1;
}

#[gpu.stage("compute")]
#[gpu.workgroup(1, 1, 1)]
fun main() {
    bump(?data.inner);
    var i: u32 = 0;
    for (i < 4) {
        via(?data.items[i]);
        i = i + 1;
    }
    count(?data);
}
