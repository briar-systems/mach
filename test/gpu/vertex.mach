# a vertex stage: inputs at two locations, the clip position built-in, an output varying
# for the next stage, and the vertex index read from the pipeline
#[gpu.input(0)] var in_position: f32x4;
#[gpu.input(1)] var in_colour: f32x4;
#[gpu.output(0)] var out_colour: f32x4;
#[gpu.builtin("position")] var position: f32x4;
#[gpu.builtin("vertex_index")] var vertex: u32;

#[gpu.stage("vertex")]
fun main() {
    val shade: f32 = (vertex % 3)::f32 * 0.5;
    position = in_position * f32x4{0.5, 0.5, 1.0, 1.0};
    out_colour = in_colour + f32x4{shade, shade, shade, 0.0};
}
