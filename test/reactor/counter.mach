# has: Name: accumulate ; Kind: FUNCTION
# a module that keeps a running total across its host's calls, in a global its exports share

var total: i64 = 0;

# add `n` to the running total and return it
#[export]
#[symbol("accumulate")]
pub fun accumulate(n: i64) i64 {
    total = total + n;
    ret total;
}

# the running total
#[export]
#[symbol("total")]
pub fun current() i64 {
    ret total;
}
