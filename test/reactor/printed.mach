# targets: wasi-wasm32-module
# has:     Field: fd_write ; Module: wasi_snapshot_preview1
# a reactor that prints through std, so its object imports std's printing from the object that
# defines it and the link resolves that import to std's, leaving the module importing fd_write
# from wasi. the object must name the import by bytes it still holds when it states it, which an
# export with a short name tripped before mirl 0.3.2, importing a garbled name in fd_write's place
# (#5016)
use std.print;

# write a line to the host's standard output and return the sum of two operands
#[export]
#[symbol("add")]
pub fun add(a: i32, b: i32) i32 {
    print.println("add");
    ret a + b;
}
