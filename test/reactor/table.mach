# has: Name: crc8 ; Kind: FUNCTION
# a module that answers from a constant table its data segment initializes, the CRC-8 of a byte
# under the polynomial 0x07

val TABLE: [16]u8 = [16]u8{0x00, 0x07, 0x0e, 0x09, 0x1c, 0x1b, 0x12, 0x15, 0x38, 0x3f, 0x36, 0x31, 0x24, 0x23, 0x2a, 0x2d};

# the CRC-8 of `b`, a nibble at a time
#[export]
#[symbol("crc8")]
pub fun crc8(b: u32) u32 {
    var crc: u8 = 0;
    crc = TABLE[((crc >> 4) ^ ((b::u8) >> 4)) & 0x0f] ^ (crc << 4);
    crc = TABLE[((crc >> 4) ^ ((b::u8) & 0x0f)) & 0x0f] ^ (crc << 4);
    ret crc::u32;
}
