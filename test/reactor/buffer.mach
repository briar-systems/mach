# has: Name: checksum ; Kind: FUNCTION
# a module whose host writes bytes into a buffer in its memory and asks for their checksum, as a
# host hands a reactor its input

val SIZE: u32 = 256;

var buffer: [256]u8;

# where in the module's memory the host writes its bytes
#[export]
#[symbol("buffer")]
pub fun at() *u8 {
    ret ?buffer[0];
}

# the sum of the first `n` bytes of the buffer, wrapping at 32 bits, and 0 for more than it holds
#[export]
#[symbol("checksum")]
pub fun checksum(n: u32) u32 {
    if (n > SIZE) { ret 0; }
    var sum: u32 = 0;
    var i:   u32 = 0;
    for (i < n) {
        sum = sum + buffer[i]::u32;
        i   = i + 1;
    }
    ret sum;
}
