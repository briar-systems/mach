# does an unaligned scalar access actually work, on real hardware
#
# #2715 (`#[packed]`) turns entirely on this question, and it cannot be answered
# by an emulator. qemu-aarch64 accepted an `O_DIRECTORY` value a real ARM kernel
# refuses, so a green qemu run is not evidence about what silicon does with a
# misaligned load. This leg's linux-arm64 row runs NATIVELY on ubuntu-24.04-arm
# (int/targets.conf), which is why the case lives here rather than in the unit
# suite.
#
# Each probe writes a value through a deliberately misaligned pointer and reads
# it back through the same one, so a target that silently drops or reorders the
# access prints a wrong number rather than faulting quietly.
#
# riscv64 is NOT evidence either, in the opposite direction: unaligned access on
# RV64 is permitted-but-may-trap, and where it traps Linux emulates it in the
# kernel. So this case passing there says the access is CORRECT and says nothing
# about it being usable - a trap-and-emulate round trip per field access is
# orders of magnitude off a normal load. Correctness here, performance unknown.

use std.runtime;
use p: std.print;

use std.types.size.usize;

#[symbol("main")]
fun main(argc: usize, argv: **u8) i64 {
    var buf: [64]u8;
    var i: usize = 0;
    for (i < 64) { buf[i] = 0; i = i + 1; }

    # a u32 at byte offset 1
    val p32: *u32 = (?buf[1])::*u32;
    @p32 = 0x11223344;
    p.printlnf("u32@1 {}", (@p32)::i64);

    # a u64 at byte offset 3
    val p64: *u64 = (?buf[19])::*u64;
    @p64 = 0x0102030405060708;
    p.printlnf("u64@3 {}", (@p64)::i64);

    # a u16 at byte offset 1, adjacent to the u32 above, to catch an access that
    # is correct in isolation and clobbers its neighbour
    val q: *u16 = (?buf[33])::*u16;
    @q = 0xBEEF;
    p.printlnf("u16@1 {}", (@q)::i64);

    # the neighbour check: the u32 must be untouched by the writes around it
    p.printlnf("u32@1-again {}", (@p32)::i64);
    ret 0;
}
