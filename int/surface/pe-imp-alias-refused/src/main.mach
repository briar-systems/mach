# `__imp_X` is PE's spelling for the address cell the import table synthesizes for
# export X. It is never itself an export, so it must never reach the import table.
#
# canonicalization strips exactly one prefix from an object symbol, so the source
# spelling here is doubled: `__imp___imp_Sleep` canonicalizes to `__imp_Sleep`,
# which the manifest's `symbols = ["__imp_Sleep"]` claim then attributes to
# kernel32. That is the only route by which an aliased name reaches the loader
# plan attributed - a `#[library]` decorator cannot, since it keys on the source
# spelling the canonical name is derived from. The link must refuse it.
#[symbol("__imp___imp_Sleep")]
ext fun Sleep(ms: u32);

#[library("kernel32")]
ext fun ExitProcess(code: u32);

#[symbol("mainCRTStartup")]
pub fun _start() {
    Sleep(0);
    ExitProcess(0);
}
