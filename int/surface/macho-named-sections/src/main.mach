# links two clang objects that each carry named __DATA sections a runtime finds by
# name, and reports whether dyld ran the __mod_init_func entry one of them
# registers. the section identity is asserted structurally by the producer on every
# leg; running the program is what proves the initializer actually fired, and only
# a darwin runner can do that
use std.runtime;
use std.print;
use std.types.size.usize;

#[library("probe-a")]
ext fun probe_state() i32;

#[symbol("main")]
fun main(argc: usize, argv: **u8) i64 {
    if (probe_state() == 1) { print.println("init ok"); }
    or                      { print.println("init missing"); }
    ret 0;
}
