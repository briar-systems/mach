# SPIR-V sampled-image fixture: the shader boom could not write (#2794)
#
# The interface case binds varyings, built-ins and uniform blocks; none of it lets a
# shader read a texture, which is what every shader boom ships does. The subject
# here is the handle: an `OpTypeImage` with its seven operands, the
# `OpTypeSampledImage` over it, the `UniformConstant` variable bound at a descriptor
# set and binding, and the `OpImageSampleImplicitLod` that reads it.
#
# THE SAMPLING OPERATION IS A `#[spirv_op(...)]` DECLARATION, not a new language
# form, and that is the shape the decorator set already had: `cross3` in
# `spirv-ext-inst` is the same thing one instruction over. A sampling function's
# result type is its declared return and its operands are its parameters in order,
# which is the decorator's whole contract - so a sampled image needed no operation
# of its own, and `OpSampledImage`, whose operands are two DIFFERENT handle types,
# fits it unchanged. That is the check that the contract was designed against the
# awkward member rather than the convenient one.

#[spirv_op("core", "OpImageSampleImplicitLod")]
fun sample2(s: sampler2d, uv: f32x2) f32x4;

# THE SAME INSTRUCTION AT EVERY OTHER DIMENSIONALITY. Each of these is one row in
# the handle grammar and nothing else, which is the claim the case exists to test:
# adding `sampler3d` must be a spelling, not a second lowering path. A coordinate's
# component count differs per dimensionality, and the declarations differ only in
# that and in the handle type.
#[spirv_op("core", "OpImageSampleImplicitLod")]
fun sample1(s: sampler1d, u: f32) f32x4;
#[spirv_op("core", "OpImageSampleImplicitLod")]
fun sample3(s: sampler3d, uvw: f32x4) f32x4;
#[spirv_op("core", "OpImageSampleImplicitLod")]
fun samplecube(s: samplercube, dir: f32x4) f32x4;

# AN ARRAYED IMAGE, whose Arrayed operand is the one that separates it from the
# plain `sampler2d` above. Both are in the module at once on purpose: a single
# arrayed handle would pass against an emitter that hard-coded Arrayed to 1 as
# easily as against one that reads it.
#[spirv_op("core", "OpImageSampleImplicitLod")]
fun samplearray(s: sampler2darray, uvl: f32x4) f32x4;

# AN ARRAYED CUBE, which is the one shape whose CAPABILITY depends on two operands
# at once: a cube needs nothing past Shader and an arrayed 2D image needs nothing
# either, but the two together need SampledCubeArray. It sits beside the plain cube
# above so the golden shows the capability appearing for the pair rather than for
# either half, which a case carrying only one of them could not distinguish.
#[spirv_op("core", "OpImageSampleImplicitLod")]
fun samplecubearray(s: samplercubearray, dir: f32x4) f32x4;

# AN INTEGER-SAMPLED IMAGE, which selects a different Sampled Type operand and a
# different result type off the same instruction. It sits beside the float handles
# so a sampled type taken from the result rather than from the declaration is a
# diff rather than a coincidence.
#[spirv_op("core", "OpImageSampleImplicitLod")]
fun sampleids(s: usampler2d, uv: f32x2) u32x4;

# THE SEPARATELY-BOUND FORM: an image with no sampler, a sampler with no image, and
# the instruction that combines them. This is the member a combined-only design
# would have had to be rebuilt for - the handle is not one descriptor but two, and
# the value the lookup takes is computed rather than loaded. It costs one row here
# because the type carries which of the three handle shapes it is rather than
# assuming the combined one.
#[spirv_op("core", "OpSampledImage")]
fun combine(t: texture2d, s: sampler) sampler2d;

#[sampler(0, 0)] var albedo:  sampler2d;
#[sampler(0, 1)] var ramp:    sampler1d;
#[sampler(0, 2)] var volume:  sampler3d;
#[sampler(0, 3)] var env:     samplercube;
#[sampler(0, 4)] var layers:  sampler2darray;
#[sampler(0, 5)] var ids:     usampler2d;
#[sampler(0, 6)] var envs:    samplercubearray;

# a second descriptor SET, so the set and binding decorations are shown to vary
# rather than being constant-folded into one pair everywhere.
#[sampler(1, 0)] var base_tex: texture2d;
#[sampler(1, 1)] var base_smp: sampler;

#[input(0)] var in_uv:  f32x2;
#[input(1)] var in_uvw: f32x4;

#[output(0)] var out_colour: f32x4;
#[output(1)] var out_ids:    u32x4;

# the shader from the issue, written out: a fragment stage that samples a texture
# and writes the result to a colour output.
#[stage("fragment")]
fun frag_main() {
    out_colour = sample2(albedo, in_uv);
}

# every dimensionality in one expression chain, so each handle is genuinely read
# rather than merely declared - a declared-and-unread binding is dropped from the
# entry point's interface list, which would make this case pass with the sampling
# path dead.
#[stage("fragment")]
fun frag_all() {
    out_colour = sample2(albedo, in_uv)
               + sample1(ramp, in_uv[0])
               + sample3(volume, in_uvw)
               + samplecube(env, in_uvw)
               + samplearray(layers, in_uvw)
               + samplecubearray(envs, in_uvw);
}

# the integer path, whose result feeds an integer output rather than being widened
# into the float chain above.
#[stage("fragment")]
fun frag_ids() {
    out_ids = sampleids(ids, in_uv);
}

# the separate image and sampler, combined at the use site. The combined value is
# handed straight to the sample: SPIR-V requires an `OpSampledImage` result be
# consumed in the block that produced it, which is also why a handle cannot be
# named as a local.
#[stage("fragment")]
fun frag_separate() {
    out_colour = sample2(combine(base_tex, base_smp), in_uv);
}

# a handle sampled from a stage's HELPER rather than from the entry point itself,
# so the descriptor variable is reached across a call boundary. The handle is
# module-scope, so the helper reaches it the same way the stage does - and the
# entry point's interface list must still name it, which is a reachability question
# rather than a syntactic one.
# `#[noinline]` is about the GOLDEN rather than about the feature: one observable
# is shared between the debug and release profiles, and a helper the release
# pipeline inlines contributes its instructions at one optimization level and not at
# the other, so the file could not be one golden. The two samples read different
# handles for the same reason - two identical sampling expressions are one
# instruction after common subexpression elimination and two before it.
#[noinline]
fun tinted() f32x4 {
    ret sample2(albedo, in_uv) * sample3(volume, in_uvw);
}

#[stage("fragment")]
fun frag_helper() {
    out_colour = tinted();
}

fun main() i32 {
    ret 0;
}
