# Runtime half of the x86_64 Mach-O GOT fixture. The local symbol is reached
# through clang GOT_LOAD, non-relaxable GOT32, and GOT64 sites; libSystem's
# `__stderrp` is reached through independent imported GOT_LOAD and GOT32 sites.
use std.runtime;
use std.types.size.usize;
use p: std.print;

ext fun got_load_local() i32;
ext fun got_norelax_local() i32;
ext fun got_norelax64_local() i32;
ext fun got_load_import() i32;
ext fun got_norelax_import() i32;

#[symbol("main")]
fun main(argc: usize, argv: **u8) i64 {
    val load_local: i32 = got_load_local();
    val got_local: i32 = got_norelax_local();
    val got64_local: i32 = got_norelax64_local();
    val load_import: i32 = got_load_import();
    val got_import: i32 = got_norelax_import();

    p.printlnf("local-load={}", load_local::i64);
    p.printlnf("local-got={}", got_local::i64);
    p.printlnf("local-got64={}", got64_local::i64);
    p.printlnf("import-load={}", load_import::i64);
    p.printlnf("import-got={}", got_import::i64);

    if (load_local != 40 || got_local != 40 || got64_local != 40
        || load_import != 1 || got_import != 1) { ret 1; }
    ret 0;
}
