# a uniform block whose nested record leaves the following member overlapping it
#
# std140 gives a struct member a base alignment of 16 and rounds its extent up to a
# multiple of 16, so `Inner` occupies bytes 0..16 and `f` must start at 16. mach
# aligns `Inner` to its own largest member, 4, giving it a size of 8, and puts `f`
# at 8. The two layouts disagree, and the offsets are the HOST's contract - a host
# writing the block by `$offset_of` sees mach's - so the block is refused rather
# than repacked, which would move the members out from under that host.
#
# This is not an exotic declaration. A record inside a uniform block is the natural
# way to spell a camera or a material, and `spirv-interface` carries one already.
# That one conforms because its inner record's members are all `f32x4` and force
# 16-byte alignment anyway, which is why it stayed green over an emitter that
# checked nothing (#2746).
#
# The refusal names the member's index, the offset mach placed it at, and the
# offset the rules require, because a reader who has not read the std140 section
# has no way to derive 16 from 8 on their own.

rec Inner { a: f32; b: f32; }
rec Outer { i: Inner; f: f32; t: f32x4; }
#[uniform(0, 0)] var o: Outer;

#[builtin("position")] var position: f32x4;

#[stage("vertex")]
fun v() { position = o.t; }

fun main() i32 { ret 0; }
