# The foreign qz_answer frame carries clang's `.pdata` and `.xdata`. qz_helper is
# defined here so the fixture needs no Windows SDK or import library.
ext fun qz_answer() i32;

#[symbol("qz_helper")]
pub fun helper(value: i32) i32 {
    ret value;
}

#[symbol("mainCRTStartup")]
pub fun _start() {
    qz_answer();
}
