# does an unaligned VECTOR access actually work, on real hardware
#
# The sibling case `unaligned-access` measures the SCALAR question, and that
# measurement is what `#[packed]` (#2715) rests on. There was no equivalent for a
# vector (#2728), which is the worst place to be missing one: the widest access, on
# ISAs that have alignment-requiring forms for exactly this width, and the case
# where an emulator is most likely to be confidently wrong - qemu-user lowers a
# guest load to a host load and the host does unaligned access in hardware, so a
# green qemu leg says nothing about silicon. Only the NATIVE legs count here
# (int/targets.conf: linux, linux-arm64, windows, darwin-aarch64, darwin-x86_64).
#
# BOTH DIRECTIONS, AND NEITHER THROUGH ITSELF. A store probe writes the vector
# through a misaligned pointer and reads the result back BYTE BY BYTE, reassembling
# each lane by hand from four u8 loads. A load probe writes the bytes by hand and
# reads the vector back through a misaligned pointer. Neither probe reads back
# through the access it is measuring, so a store the compiler forwarded to its own
# load, or an access that never reached memory at all, cannot pass.
#
# EVERY LANE, AND THE NEIGHBOURS. A faulting or truncating vector access drops or
# clobbers bytes rather than corrupting the whole value, so a probe that checked a
# sum, or the vector as a unit, could pass with a lane missing. Each lane is its own
# row, and the byte immediately before and after each vector's extent carries a
# sentinel that is asserted intact afterwards - the truncated-store and over-wide-
# store regressions are only visible there.
#
# THE CONTROLS ARE PART OF THE OBSERVABLE. `control-pass` must read ok and
# `control-fail` must read WRONG, so a checker that has degenerated into printing ok
# is caught by its own output; and the aligned round trip must read ok, so a run
# where the whole vector unit is broken is distinguishable from one where only the
# unaligned accesses are.

use std.runtime;
use std.types.size.usize;
use std.types.string.str;
use p: std.print;

fun report(name: str, got: i64, want: i64) {
    if (got == want) { p.printlnf("{} got={} want={} ok", name, got, want); }
    or              { p.printlnf("{} got={} want={} WRONG", name, got, want); }
}

# a lane reassembled from four byte loads: the width the vector store cannot have
# satisfied by handing its own value back.
fun le32(b: *u8, off: usize) i64 {
    ret b[off]::i64
      | (b[off + 1]::i64 << 8)
      | (b[off + 2]::i64 << 16)
      | (b[off + 3]::i64 << 24);
}

fun put32(b: *u8, off: usize, v: i64) {
    b[off]     = (v & 0xFF)::u8;
    b[off + 1] = ((v >> 8) & 0xFF)::u8;
    b[off + 2] = ((v >> 16) & 0xFF)::u8;
    b[off + 3] = ((v >> 24) & 0xFF)::u8;
}

# the sentinel the bytes around every vector extent hold, and must still hold.
val G: i64 = 165;

#[symbol("main")]
fun main(argc: usize, argv: **u8) i64 {
    var buf: [320]u8;
    val b: *u8 = ?buf[0];
    var i: usize = 0;
    for (i < 320) { b[i] = 0xA5; i = i + 1; }

    report("control-pass", 1, 1);
    report("control-fail", 1, 2);

    # the aligned round trip. a vector local is at its natural alignment, so this is
    # the access every target is expected to do well, and it separates "unaligned is
    # broken" from "vectors are broken".
    var ctl: i32x4;
    ctl[0] = 11; ctl[1] = 22; ctl[2] = 33; ctl[3] = 44;
    val ctlr: i32x4 = ctl;
    report("aligned-i32x4-lane0", ctlr[0]::i64, 11);
    report("aligned-i32x4-lane1", ctlr[1]::i64, 22);
    report("aligned-i32x4-lane2", ctlr[2]::i64, 33);
    report("aligned-i32x4-lane3", ctlr[3]::i64, 44);

    # 128-bit STORE at offset 1
    var sa: i32x4;
    sa[0] = 0x01020304; sa[1] = 0x05060708; sa[2] = 0x090A0B0C; sa[3] = 0x0D0E0F10;
    @((?buf[1])::*i32x4) = sa;
    report("i32x4-store@1-lane0", le32(b, 1), 0x01020304);
    report("i32x4-store@1-lane1", le32(b, 5), 0x05060708);
    report("i32x4-store@1-lane2", le32(b, 9), 0x090A0B0C);
    report("i32x4-store@1-lane3", le32(b, 13), 0x0D0E0F10);
    report("i32x4-store@1-guard-before", b[0]::i64, G);
    report("i32x4-store@1-guard-after", b[17]::i64, G);

    # 128-bit LOAD at offset 3
    put32(b, 35, 0x11223344);
    put32(b, 39, 0x55667788);
    put32(b, 43, 0x1A2B3C4D);
    put32(b, 47, 0x2E3F4051);
    val la: i32x4 = @((?buf[35])::*i32x4);
    report("i32x4-load@3-lane0", la[0]::i64, 0x11223344);
    report("i32x4-load@3-lane1", la[1]::i64, 0x55667788);
    report("i32x4-load@3-lane2", la[2]::i64, 0x1A2B3C4D);
    report("i32x4-load@3-lane3", la[3]::i64, 0x2E3F4051);
    report("i32x4-load@3-guard-before", b[34]::i64, G);
    report("i32x4-load@3-guard-after", b[51]::i64, G);

    # 128-bit FLOAT store at offset 5. the lanes are exact in binary32, and the
    # golden is the IEEE bit pattern worked out by hand rather than read back as a
    # float, so a lane that arrives rounded or in the wrong slot shows as a
    # different integer.
    var sf: f32x4;
    sf[0] = 1.5; sf[1] = -2.25; sf[2] = 256.5; sf[3] = 0.75;
    @((?buf[69])::*f32x4) = sf;
    report("f32x4-store@5-lane0", le32(b, 69), 0x3FC00000);
    report("f32x4-store@5-lane1", le32(b, 73), 0xC0100000);
    report("f32x4-store@5-lane2", le32(b, 77), 0x43804000);
    report("f32x4-store@5-lane3", le32(b, 81), 0x3F400000);
    report("f32x4-store@5-guard-before", b[68]::i64, G);
    report("f32x4-store@5-guard-after", b[85]::i64, G);

    # 128-bit FLOAT load at offset 6. each lane is scaled by 4, exact in binary32,
    # so the comparison stays integral without a bitcast.
    put32(b, 102, 0x3FC00000);
    put32(b, 106, 0xC0100000);
    put32(b, 110, 0x43804000);
    put32(b, 114, 0x3F400000);
    val lf: f32x4 = @((?buf[102])::*f32x4);
    report("f32x4-load@6-lane0", (lf[0] * 4.0)::i64, 6);
    report("f32x4-load@6-lane1", (lf[1] * 4.0)::i64, -9);
    report("f32x4-load@6-lane2", (lf[2] * 4.0)::i64, 1026);
    report("f32x4-load@6-lane3", (lf[3] * 4.0)::i64, 3);
    report("f32x4-load@6-guard-before", b[101]::i64, G);
    report("f32x4-load@6-guard-after", b[118]::i64, G);

    # SUB-WIDTH. an `i32x3` is 12 bytes in a 16-byte register (#2697), which is the
    # shape a packed record would most plausibly hold, and the one where an
    # over-wide store reaches four bytes past the field. the guard after the extent
    # is the only place that shows.
    var s3: i32x3;
    s3[0] = 0x21222324; s3[1] = 0x25262728; s3[2] = 0x292A2B2C;
    @((?buf[133])::*i32x3) = s3;
    report("i32x3-store@5-lane0", le32(b, 133), 0x21222324);
    report("i32x3-store@5-lane1", le32(b, 137), 0x25262728);
    report("i32x3-store@5-lane2", le32(b, 141), 0x292A2B2C);
    report("i32x3-store@5-guard-before", b[132]::i64, G);
    report("i32x3-store@5-guard-after", b[145]::i64, G);
    report("i32x3-store@5-guard-after2", b[146]::i64, G);
    report("i32x3-store@5-guard-after3", b[147]::i64, G);
    report("i32x3-store@5-guard-after4", b[148]::i64, G);

    put32(b, 166, 0x31323334);
    put32(b, 170, 0x35363738);
    put32(b, 174, 0x393A3B3C);
    val l3: i32x3 = @((?buf[166])::*i32x3);
    report("i32x3-load@6-lane0", l3[0]::i64, 0x31323334);
    report("i32x3-load@6-lane1", l3[1]::i64, 0x35363738);
    report("i32x3-load@6-lane2", l3[2]::i64, 0x393A3B3C);
    report("i32x3-load@6-guard-before", b[165]::i64, G);
    report("i32x3-load@6-guard-after", b[178]::i64, G);

    var g3: f32x3;
    g3[0] = 1.5; g3[1] = -2.25; g3[2] = 256.5;
    @((?buf[195])::*f32x3) = g3;
    report("f32x3-store@3-lane0", le32(b, 195), 0x3FC00000);
    report("f32x3-store@3-lane1", le32(b, 199), 0xC0100000);
    report("f32x3-store@3-lane2", le32(b, 203), 0x43804000);
    report("f32x3-store@3-guard-before", b[194]::i64, G);
    report("f32x3-store@3-guard-after", b[207]::i64, G);
    report("f32x3-store@3-guard-after2", b[208]::i64, G);
    report("f32x3-store@3-guard-after3", b[209]::i64, G);
    report("f32x3-store@3-guard-after4", b[210]::i64, G);

    put32(b, 221, 0x3FC00000);
    put32(b, 225, 0xC0100000);
    put32(b, 229, 0x43804000);
    val h3: f32x3 = @((?buf[221])::*f32x3);
    report("f32x3-load@1-lane0", (h3[0] * 4.0)::i64, 6);
    report("f32x3-load@1-lane1", (h3[1] * 4.0)::i64, -9);
    report("f32x3-load@1-lane2", (h3[2] * 4.0)::i64, 1026);
    report("f32x3-load@1-guard-before", b[220]::i64, G);
    report("f32x3-load@1-guard-after", b[233]::i64, G);

    ret 0;
}
