# freestanding x86_64 flat-image fixture for `#[embed(...)]` (#2507)
#
# an embedded file has no runtime behind it - the bytes are read-only data the
# image carries - so it must work on a target with no OS, no std runtime, and no
# container around the image. `start` exits with the embed's first byte (0x2d =
# 45), so running the flat image asserts the bytes were laid into it at an
# address the code resolves correctly.
#
# `start` is the only function, so its code begins at file offset 0 (the image
# base), satisfying raw's entry-at-base contract; the embed's data follows it.

#[embed("blob.bin")]
val BLOB: [_]u8;

#[symbol("_start")]
fun start() {
    val code: i64 = BLOB[0]::i64;
    asm x86_64 {
        mov rax, 60      # __NR_exit
        mov rdi, {code}  # exit code = BLOB[0] = 45
        syscall
    }
}
