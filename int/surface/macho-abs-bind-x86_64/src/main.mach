# runtime half of the x86_64 Mach-O absolute-bind fixture (#2563): the C fixture
# holds absolute 64-bit references to libSystem's __stdoutp/__stderrp that dyld
# must bind in place for the check to pass
use std.runtime;
use std.types.size.usize;
use p: std.print;

ext fun mach_abs_bind_check() i32;

#[symbol("main")]
fun main(argc: usize, argv: **u8) i64 {
    val ok: i32 = mach_abs_bind_check();
    p.printlnf("abs-bind={}", ok::i64);
    if (ok != 1) { ret 1; }
    ret 0;
}
