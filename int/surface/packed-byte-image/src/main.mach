# does a `#[packed]` record describe an EXTERNAL byte layout (#2715)
#
# This is the case that proves what `#[packed]` is for. A layout intrinsic can agree
# with a wrong layout: `$size_of` and `$offset_of` are answers the compiler computes,
# so pinning them against the compiler proves only that it is self-consistent. The
# BYTES are the observable a C struct, a file header or a wire frame is actually
# compared against, so the golden below is a byte image worked out by hand from the
# layout rule and never read back from the compiler.
#
# It also spans BOTH padding walks in one observable. `walk` computes size and
# `field_offset_of` computes offsets, independently, each with its own round_up, and
# patching one leaves the other describing a different layout with nothing erroring.
# A byte image is exactly the observable that cannot be satisfied by one of them: a
# wrong offset moves a byte, a wrong size truncates or extends the row.
#
# HEADER, packed. Every field lands where the previous one ended:
#
#   magic     u8    off  0   size 1
#   version   u16   off  1   size 2
#   length    u32   off  3   size 4
#   flags     u8    off  7   size 1
#   checksum  u64   off  8   size 8
#                            size 16, align 1
#
# Naturally the same shape is 24 bytes (version at 2, length at 4, flags at 8,
# checksum at 16), so every single offset differs and the case cannot pass by
# accident against an unpacked layout.
#
# FRAME, packed, holding an UNPACKED record. Packing is not transitive, matching C:
# the inner record keeps its own internal padding and is merely PLACED without any:
#
#   tag       u8      off  0   size 1
#   p         Point   off  1   size 8    (Point is natural: x@0, 3 pad, y@4)
#   end       u16     off  9   size 2
#                              size 11, align 1
#
# so the three padding bytes at image offsets 2..4 are the observable proof of
# non-transitivity. A transitive rule would put p.y at offset 2 and make Frame 8.
#
# The storage is zeroed through the record's own address before any field is
# written, so a padding byte reads 00 rather than whatever the stack held - the
# padding is being ASSERTED here, not tolerated.
#
# STATIC. The last row is the same Header again, but as an initialized global: folded
# to a constant aggregate and emitted into the data section at compile time, with no
# store ever executed. That is a separate code path from the two above, and its image
# must be byte-for-byte the runtime one - a layout applied to stores but not to static
# data is exactly the half-applied shape this case exists to catch.
#
# Every target this runs on is little-endian, which is why a multi-byte field's
# bytes appear least-significant first below.

use std.runtime;
use p: std.print;

use std.types.size.usize;

#[packed]
rec Header {
    magic:    u8;
    version:  u16;
    length:   u32;
    flags:    u8;
    checksum: u64;
}

rec Point {
    x: u8;
    y: u32;
}

#[packed]
rec Frame {
    tag: u8;
    p:   Point;
    end: u16;
}

# a packed global with a static initializer, which is a DIFFERENT code path from the
# two records above. those are stack storage written by ordinary field stores at run
# time; this one is folded to a constant aggregate and emitted into the data section at
# compile time, and it never executes a store at all. the offsets it uses come from the
# same shared layout policy, and this line is what proves they do rather than that
# being assumed - a static image that disagreed with the runtime one would be exactly
# the kind of half-applied layout this whole case exists to catch.
pub var static_header: Header = Header{
    magic:    0x5A,
    version:  0x0102,
    length:   0x11223344,
    flags:    0xC3,
    checksum: 0x0807060504030201,
};

# print `n` bytes starting at `b` as lowercase two-digit hex, space separated
fun dump(b: *u8, n: usize) {
    var i: usize = 0;
    for (i < n) {
        p.printf(" {:02x}", b[i]::u64);
        i = i + 1;
    }
    p.println("");
}

fun zero(b: *u8, n: usize) {
    var i: usize = 0;
    for (i < n) { b[i] = 0; i = i + 1; }
}

#[symbol("main")]
fun main(argc: usize, argv: **u8) i64 {
    var h: Header;
    val hb: *u8 = (?h)::*u8;
    zero(hb, $size_of(Header));

    h.magic    = 0x5A;
    h.version  = 0x0102;
    h.length   = 0x11223344;
    h.flags    = 0xC3;
    h.checksum = 0x0807060504030201;

    p.printf("header");
    dump(hb, $size_of(Header));
    p.printlnf("header size {} align {}", $size_of(Header)::i64, $align_of(Header)::i64);
    p.printlnf("header offs {} {} {} {} {}",
        $offset_of(Header, magic)::i64,
        $offset_of(Header, version)::i64,
        $offset_of(Header, length)::i64,
        $offset_of(Header, flags)::i64,
        $offset_of(Header, checksum)::i64);

    var f: Frame;
    val fb: *u8 = (?f)::*u8;
    zero(fb, $size_of(Frame));

    f.tag = 0xAB;
    f.p.x = 0xCD;
    f.p.y = 0xDEADBEEF;
    f.end = 0x7788;

    p.printf("frame");
    dump(fb, $size_of(Frame));
    p.printlnf("frame size {} align {}", $size_of(Frame)::i64, $align_of(Frame)::i64);
    p.printlnf("frame offs {} {} {}",
        $offset_of(Frame, tag)::i64,
        $offset_of(Frame, p)::i64,
        $offset_of(Frame, end)::i64);
    p.printlnf("point size {} offs {} {}",
        $size_of(Point)::i64,
        $offset_of(Point, x)::i64,
        $offset_of(Point, y)::i64);

    # the same values as `header` above, but placed by the constant-aggregate fold into
    # the data section rather than by stores. the two rows must be identical.
    p.printf("static");
    dump((?static_header)::*u8, $size_of(Header));
    ret 0;
}
