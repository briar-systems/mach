# C-variadic `ext fun` surface case (mach #2575)
#
# Calls a real clang/gcc-built C variadic function and asserts every argument
# round-trips. The C half reads its arguments with `va_arg` under the RUNNER'S own
# ABI, so a mismatch between mach's placement and the platform's is a wrong VALUE
# printed here - the failure shape a fixed-arity declaration produces on Apple arm64,
# where every variadic argument is passed on the stack rather than in a register.
#
# The observable is target-independent on purpose: the same golden must hold on
# darwin-aarch64 (all varargs stacked), linux-arm64 (AAPCS64's ordinary
# register-then-stack rule), and both SysV legs (registers, plus the vector count in
# AL). A leg that disagrees with the others is the bug.

use std.runtime;
use std.types.size.usize;
use p: std.print;

rec Pair { a: i64; b: i64; }
rec Wide { a: i64; b: i64; c: i64; d: i64; }

# `spec` names one character per variadic argument; `out` receives the folded values.
ext fun va_probe(spec: *u8, out: *i64, ...) i64;

#[symbol("main")]
fun main(argc: usize, argv: **u8) i64 {
    var out: [8]i64;
    var s:   [9]u8;

    # ZERO varargs. The tail is empty, but the callee is still variadic: SysV's
    # vector-count register is a live hidden argument it reads either way.
    s[0] = 0;
    p.printlnf("none={}", va_probe(?s[0], ?out[0]));

    # the promoted integer widths, mixed with a double. this is the list that goes
    # wrong on Apple arm64 under a fixed-arity declaration.
    s[0] = 'i'::u8;
    s[1] = 'l'::u8;
    s[2] = 'd'::u8;
    s[3] = 0;
    val n1: i64 = va_probe(?s[0], ?out[0], 7::i32, 8::i64, 2.5::f64);
    p.printlnf("mixed n={} {} {} {}", n1, out[0], out[1], out[2]);

    # a pointer argument, dereferenced by the callee so the observable is its value.
    var v: i64 = 4242;
    s[0] = 'p'::u8;
    s[1] = 0;
    val n2: i64 = va_probe(?s[0], ?out[0], ?v);
    p.printlnf("ptr n={} {}", n2, out[0]);

    # MORE VARARGS THAN REGISTER SLOTS. eight doubles exhaust both AAPCS64's V bank
    # and SysV's XMM bank, so the tail crosses the register/stack boundary on the
    # legs that have one - and never touches a register at all on Apple arm64.
    var i: u32 = 0;
    for (i < 8) {
        s[i] = 'd'::u8;
        i = i + 1;
    }
    s[8] = 0;
    val n3: i64 = va_probe(?s[0], ?out[0],
                           1.0::f64, 2.0::f64, 3.0::f64, 4.0::f64,
                           5.0::f64, 6.0::f64, 7.0::f64, 8.0::f64);
    p.printlnf("floats n={} {} {} {}", n3, out[0], out[3], out[7]);

    # a 16-byte aggregate by value in the tail.
    var pr: Pair;
    pr.a = 3;
    pr.b = 9;
    s[0] = 's'::u8;
    s[1] = 0;
    val n4: i64 = va_probe(?s[0], ?out[0], pr);
    p.printlnf("pair n={} {}", n4, out[0]);

    # a 32-byte aggregate: by reference under AAPCS64, and on Apple arm64 that hidden
    # pointer rides the stack rather than a GP register.
    var w: Wide;
    w.a = 1;
    w.b = 2;
    w.c = 3;
    w.d = 4;
    s[0] = 'w'::u8;
    s[1] = 0;
    val n5: i64 = va_probe(?s[0], ?out[0], w);
    p.printlnf("wide n={} {}", n5, out[0]);

    ret 0;
}
