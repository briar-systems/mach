# #[embed(...)] surface case (#2507)
#
# a `#[embed("path")]` global sources its bytes from a file at compile time,
# resolved relative to the declaring source file's directory. this exercises the
# three end-to-end facts the frontend and back end jointly own: a `[_]u8` embed's
# length comes from the file, an explicit `[N]u8` embed of the same file agrees
# byte-for-byte, and two embeds naming byte-identical files share one data
# placement while an embed of different content does not.

use std.runtime;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use p: std.print;
use case.lib.LIB_ASSET;

#[embed("asset.bin")]
val ASSET: [_]u8;

#[embed("asset.bin")]
val ASSET_FIXED: [17]u8;

#[embed("asset_dup.bin")]
val DUP: [_]u8;

#[embed("asset_other.bin")]
val OTHER: [_]u8;

#[embed("empty.bin")]
val EMPTY: [_]u8;

#[embed("empty.bin")]
val EMPTY_DUP: [_]u8;

#[symbol("main")]
fun main() i64 {
    var i: i64 = 0;
    for (i < 17) {
        p.printlnf("byte[{}]={}", i, (ASSET[i])::u64);
        i = i + 1;
    }

    var fixed_match: bool = true;
    i = 0;
    for (i < 17) {
        if (ASSET_FIXED[i] != ASSET[i]) { fixed_match = false; }
        i = i + 1;
    }
    p.printlnf("fixed_match={}", fixed_match);

    var lib_match: bool = true;
    i = 0;
    for (i < 17) {
        if (LIB_ASSET[i] != ASSET[i]) { lib_match = false; }
        i = i + 1;
    }
    p.printlnf("lib_match={}", lib_match);

    val dup_same:   bool = (?ASSET[0]) == (?DUP[0]);
    val other_same: bool = (?ASSET[0]) == (?OTHER[0]);
    val empty_same: bool = (?EMPTY) == (?EMPTY_DUP);
    p.printlnf("dup_same={}", dup_same);
    p.printlnf("other_same={}", other_same);
    p.printlnf("empty_same={}", empty_same);

    ret 0;
}
