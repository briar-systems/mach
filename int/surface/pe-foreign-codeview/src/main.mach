# The foreign function carries clang CodeView line and procedure records. Its
# helper is defined here so the fixture needs neither an SDK nor an import library.
ext fun codeview_answer() i32;

#[symbol("codeview_helper")]
pub fun helper(value: i32) i32 {
    ret value;
}

#[symbol("mainCRTStartup")]
pub fun _start() {
    codeview_answer();
}
