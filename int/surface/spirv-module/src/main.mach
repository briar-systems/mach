# SPIR-V module fixture: a default-manifest build delivers a valid `.spv`
#
# The manifest spells only isa/os/abi, so the object format is whatever the
# toolchain derives - the case fails if that is anything but the finished-module
# format, since no other one produces a file `spirv-val` accepts. The observable
# is the external Khronos validator's verdict, not mach's own reader.
#
# The bodies cover the SPIR-V back half's scope: straight-line scalar work, the
# structured control flow the emitter reconstructs (selections, counted loops,
# `brk`, `cnt`, nesting, early returns), and direct calls including recursion.
# Every one of these compiles to a construct the validator checks - an
# `OpSelectionMerge` or `OpLoopMerge` whose merge block and continue target it
# verifies dominate correctly - so a reconstruction that drifts fails here rather
# than at a consumer.

fun add(a: i32, b: i32) i32 {
    ret a + b;
}

fun mask(a: i32, b: i32) i32 {
    var c: i32 = a - b;
    c = c & 0x3F;
    c = c | 0x40;
    ret c ^ 0x11;
}

# a selection whose arms rejoin, and one whose arm returns early
fun clamp(v: i32, lo: i32, hi: i32) i32 {
    if (v < lo) { ret lo; }
    var r: i32 = v;
    if (v > hi) { r = hi; } or { r = v; }
    ret r;
}

# short-circuit evaluation, which lowers to nested selections over a joined flag
fun in_range(v: i32, lo: i32, hi: i32) i32 {
    if (v >= lo && v <= hi) { ret 1; }
    if (v < lo || v > hi) { ret 0; }
    ret 2;
}

# a counted loop: one back edge, one exit
fun triangle(n: i32) i32 {
    var s: i32 = 0;
    var i: i32 = 0;
    for (i < n) {
        s = s + i;
        i = i + 1;
    }
    ret s;
}

# `brk` and `cnt` in one body: several edges reaching the loop's merge and
# continue targets
fun sifted(n: i32) i32 {
    var s: i32 = 0;
    var i: i32 = 0;
    for (i < n) {
        i = i + 1;
        if (i % 3 == 0) { cnt; }
        if (i > 64) { brk; }
        s = s + i;
    }
    ret s;
}

# nested loops, the inner one leaving through a break
fun nested(n: i32) i32 {
    var s: i32 = 0;
    var i: i32 = 0;
    for (i < n) {
        var j: i32 = 0;
        for (j < i) {
            if (j > 8) { brk; }
            s = s + j;
            j = j + 1;
        }
        i = i + 1;
    }
    ret s;
}

# direct calls, including a call whose argument is another call's result
fun composed(a: i32, b: i32) i32 {
    val x: i32 = add(a, b);
    ret mask(triangle(x), clamp(x, 0, 16));
}

# a FORWARD call: the callee's id is allocated before any body is emitted, so a
# call naming a function defined further down the module resolves.
#
# This used to be a self-call, which resolved for the same reason and emitted a
# module SPIR-V cannot execute: there is no call stack, so a cycle in the static
# call graph is not expressible. This is a LIBRARY module, so `spirv-val` said
# nothing about it - its cycle rule is scoped to entry points - and the case stayed
# green for eleven releases over a module a consumer would have rejected at link
# time (#2748). The refusal is pinned by `spirv-recursion-refused`; what belongs
# here is the forward reference, which is the property this case was about.
fun fib(n: i32) i32 {
    if (n < 2) { ret n; }
    ret defined_later(n) + 1;
}

fun defined_later(n: i32) i32 {
    ret n - 1;
}

fun main() i32 {
    ret 0;
}
