# how a vector lane is reached, EMISSION side (#2236). each function below is
# recorded as `lane=<0|1> vecmem=<0|1>` read out of the disassembly, because a lane
# access that round-trips through the stack computes the right answer and so cannot
# be told apart by running the program.
#
# every function is `pub` and nothing calls it: an exported function with no call site
# is emitted as its own symbol and never inlined, so each verdict describes exactly
# the body written below it.
use std.runtime;
use std.types.size.usize;

# an INTEGER lane read - UMOV on aarch64. reading four lanes of one vector must not
# spill the vector once: the whole point is that no lane touches memory.
pub fun hsum_i32x4(v: i32x4) i32 { ret v[0] + v[1] + v[2] + v[3]; }

# a FLOAT lane read - DUP (element), which UMOV cannot do because a float lane's
# destination is an FP register. the shape mach-std's horizontal reductions are built
# on, so it matters more than the integer form.
pub fun hsum_f32x4(v: f32x4) f32 { ret v[0] + v[1] + v[2] + v[3]; }
pub fun hsum_f64x2(v: f64x2) f64 { ret v[0] + v[1]; }

# the narrow integer lanes, whose UMOV has no `mov` alias and renders as `umov`
pub fun lane_u8x16(v: u8x16) u8 { ret v[5]; }
pub fun lane_i16x8(v: i16x8) i16 { ret v[3]; }
pub fun lane_i64x2(v: i64x2) i64 { ret v[1]; }

# an INTEGER lane write - INS from a general register. the vector must stay in a
# register across the write.
pub fun set_i32x4(v: i32x4, x: i32) i32x4 { var r: i32x4 = v; r[3] = x; ret r; }

# a FLOAT lane write - INS from another element, sourcing lane 0 of the scalar's own
# FP register
pub fun set_f32x4(v: f32x4, x: f32) f32x4 { var r: f32x4 = v; r[1] = x; ret r; }
pub fun set_f64x2(v: f64x2, x: f64) f64x2 { var r: f64x2 = v; r[0] = x; ret r; }

# read and write in one body, with a lane-wise operator between them: the lane forms
# must compose with the packed ops rather than forcing a round trip between them
pub fun rmw_i32x4(a: i32x4, b: i32x4) i32 {
    var s: i32x4 = a + b;
    s[0] = s[1];
    ret s[0] + s[2];
}

# a vector that genuinely IS in memory: the lane forms must not stop a real
# whole-vector load from being a whole-vector load, so this one records vecmem=1 on a
# target with a vector unit, and is the control for the readings above
pub fun load_lane_i32x4(p: *i32x4) i32 { ret (@p)[2]; }

# the artifact is never run: the observable is the disassembly of the functions
# above, so the entry exists only to link
#[symbol("main")]
fun main(argc: usize, argv: **u8) i64 { ret 0; }
