# an atomic read-modify-write on a field of a `#[packed]` record (#2715)
#
# `std.sync.atomic.fetch_add` takes a `*i64`. Every ISA form of an atomic requires its
# operand naturally aligned, and a packed field is not - so this must be refused. The
# point of the case is WHERE it is refused: at `?c.n`, by the address-of rule, because
# a pointer is the only route an atomic has to a field. The golden is that diagnostic.

use std.runtime;
use p: std.print;
use at: std.sync.atomic;

use std.types.size.usize;

#[packed]
rec Counter {
    tag: u8;
    n:   i64;
}

#[symbol("main")]
fun main(argc: usize, argv: **u8) i64 {
    var c: Counter;
    c.tag = 1;
    c.n   = 0;
    val prev: i64 = at.fetch_add(?c.n, 1);
    p.printlnf("{}", prev);
    ret 0;
}
