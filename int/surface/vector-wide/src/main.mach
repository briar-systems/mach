# Lane exactness for vectors WIDER than the vector register (#2727).
#
# An over-width shape has no register that holds it, so it is placed in memory and
# every operator on it is per-lane scalar code - the same realization a target with
# no vector unit gives every vector, reached through the same authority. What this
# case measures is that the placement is exact: every lane arrives, the object's
# neighbours survive, and a value carried around a loop is the value that was stored.
#
# WHY EVERY CASE HERE RUNS AN OPERATION AND CHECKS LANE VALUES. #2687 enabled `f32x3`
# with a test that only checked `$size_of`, and shipped a miscompile:
# `i32x3{10,20,30} + i32x3{1,2,3}` gave 11, 22, 0 with a green matrix on every leg. A
# shape that is laid out right and computes wrong looks identical to a working one
# from any test that does not add two of them together and read the lanes back.
#
# WHY A LOOP-CARRIED CASE. #2749 found a vector accumulator holding the wrong value
# across a back edge that every straight-line case missed on every target: the phi at
# the loop header named an instruction a rewrite had deleted. Straight-line lanes are
# not evidence about a phi.
#
# THE CONTROLS ARE PART OF THE OBSERVABLE, as in `vector-subwidth`: a `control-pass`
# that must read ok and a `control-fail` that must read WRONG, so a checker that
# reports ok unconditionally is caught by the second line and a program that never
# runs is caught by the golden diff.

use std.runtime;
use std.types.size.usize;
use std.types.string.str;
use p: std.print;

# guard AFTER the over-width vector: a placement that writes the register width
# rather than the object's footprint clobbers the neighbour. this is the shape the
# split has to get right and the one a lane-sum test cannot see.
rec WideAfter  { v: i32x8; guard: i32; }

# guard BEFORE it: catches the opposite regression, where the top of the object never
# reaches memory. neither order covers both directions.
rec WideBefore { guard: i32; v: i32x8; }

# a non-power-of-two shape above the register width, which is the hardest member:
# five 32-bit lanes is one full register plus a sub-width tail, so it exercises both
# directions of the width question at once.
rec Odd { guard0: i32; v: i32x5; guard1: i32; }

fun report(name: str, got: i64, want: i64) {
    if (got == want) { p.printlnf("{} got={} want={} ok", name, got, want); }
    or              { p.printlnf("{} got={} want={} WRONG", name, got, want); }
}

# an over-width vector across a CALL boundary: the ABI has to place a shape no
# argument register holds, and the callee has to read every lane of it back.
fun sum8(v: i32x8) i64 {
    ret v[0]::i64 + v[1]::i64 + v[2]::i64 + v[3]::i64
      + v[4]::i64 + v[5]::i64 + v[6]::i64 + v[7]::i64;
}

# an over-width vector RETURNED, the other half of the boundary.
fun ramp8(base: i32) i32x8 {
    var r: i32x8;
    r[0] = base;     r[1] = base + 1; r[2] = base + 2; r[3] = base + 3;
    r[4] = base + 4; r[5] = base + 5; r[6] = base + 6; r[7] = base + 7;
    ret r;
}

#[symbol("main")]
fun main(argc: usize, argv: **u8) i64 {
    # the controls, first, so a truncated or empty report is obvious
    report("control-pass", 1, 1);
    report("control-fail", 1, 2);

    # a shape that FILLS the register, unchanged by this work. without it a suite that
    # broke every vector would look the same as one that enabled the wide ones.
    var z4: i32x4;  z4[0] = 1; z4[1] = 2; z4[2] = 3; z4[3] = 4;
    var y4: i32x4;  y4[0] = 1; y4[1] = 1; y4[2] = 1; y4[3] = 1;
    val x4: i32x4 = z4 + y4;
    report("i32x4-control", x4[0]::i64 + x4[1]::i64 + x4[2]::i64 + x4[3]::i64, 14);

    # PER-LANE VALUES, not a sum: a sum cannot tell a rotated result from a right one,
    # and a placement that mixes pieces up keeps the total.
    var a8: i32x8;
    a8[0] = 10; a8[1] = 20; a8[2] = 30; a8[3] = 40;
    a8[4] = 50; a8[5] = 60; a8[6] = 70; a8[7] = 80;
    var b8: i32x8;
    b8[0] = 1; b8[1] = 2; b8[2] = 3; b8[3] = 4;
    b8[4] = 5; b8[5] = 6; b8[6] = 7; b8[7] = 8;
    val c8: i32x8 = a8 + b8;
    report("i32x8-lane0", c8[0]::i64, 11);
    report("i32x8-lane1", c8[1]::i64, 22);
    report("i32x8-lane2", c8[2]::i64, 33);
    report("i32x8-lane3", c8[3]::i64, 44);
    report("i32x8-lane4", c8[4]::i64, 55);
    report("i32x8-lane5", c8[5]::i64, 66);
    report("i32x8-lane6", c8[6]::i64, 77);
    report("i32x8-lane7", c8[7]::i64, 88);

    # the sub / bitwise operators, so the expansion is not verified on `+` alone
    val d8: i32x8 = c8 - b8;
    report("i32x8-sub-lane7", d8[7]::i64, 80);
    var m8: i32x8;
    m8[0] = 15; m8[1] = 15; m8[2] = 15; m8[3] = 15;
    m8[4] = 15; m8[5] = 15; m8[6] = 15; m8[7] = 15;
    val e8: i32x8 = b8 & m8;
    report("i32x8-and-lane5", e8[5]::i64, 6);

    # THE NON-POWER-OF-TWO SHAPE above the register: one full register plus a tail.
    var f5: i32x5; f5[0] = 1; f5[1] = 2; f5[2] = 3; f5[3] = 4; f5[4] = 5;
    var g5: i32x5; g5[0] = 1; g5[1] = 1; g5[2] = 1; g5[3] = 1; g5[4] = 1;
    val h5: i32x5 = f5 + g5;
    report("i32x5-lane0", h5[0]::i64, 2);
    report("i32x5-lane3", h5[3]::i64, 5);
    report("i32x5-lane4", h5[4]::i64, 6);

    # a 16-bit lane count that is not a multiple of the register's lane capacity
    var i7: i16x7; i7[0] = 1; i7[1] = 2; i7[2] = 3; i7[3] = 4;
    i7[4] = 5; i7[5] = 6; i7[6] = 7;
    var j7: i16x7; j7[0] = 1; j7[1] = 1; j7[2] = 1; j7[3] = 1;
    j7[4] = 1; j7[5] = 1; j7[6] = 1;
    val k7: i16x7 = i7 + j7;
    report("i16x7-lane6", k7[6]::i64, 8);

    # a 64-bit lane shape at twice the register: f64x4 is 32 bytes of float lanes
    var l4: f64x4; l4[0] = 1.5; l4[1] = 2.5; l4[2] = 3.5; l4[3] = 4.5;
    var m4: f64x4; m4[0] = 0.5; m4[1] = 0.5; m4[2] = 0.5; m4[3] = 0.5;
    val n4: f64x4 = l4 + m4;
    report("f64x4-lane0", n4[0]::i64, 2);
    report("f64x4-lane3", n4[3]::i64, 5);

    # THE LOOP-CARRIED ACCUMULATOR: the vector is a phi at the loop header, so a
    # rewrite that renames a value one block at a time leaves the phi naming a deleted
    # instruction and the accumulator holds the wrong thing (#2749). straight-line
    # lanes never see it.
    var acc: i32x8;
    acc[0] = 0; acc[1] = 0; acc[2] = 0; acc[3] = 0;
    acc[4] = 0; acc[5] = 0; acc[6] = 0; acc[7] = 0;
    var it: i32 = 0;
    for (it < 4) {
        acc = acc + b8;
        it = it + 1;
    }
    report("i32x8-loop-lane0", acc[0]::i64, 4);
    report("i32x8-loop-lane4", acc[4]::i64, 20);
    report("i32x8-loop-lane7", acc[7]::i64, 32);

    # the neighbour guards, both orders
    var wa: WideAfter;
    wa.guard = 99;
    wa.v[0] = 1; wa.v[1] = 2; wa.v[2] = 3; wa.v[3] = 4;
    wa.v[4] = 5; wa.v[5] = 6; wa.v[6] = 7; wa.v[7] = 8;
    report("wide-guard-after", wa.guard::i64, 99);
    report("wide-guard-after-lane7", wa.v[7]::i64, 8);

    var wb: WideBefore;
    wb.guard = 99;
    wb.v[0] = 1; wb.v[1] = 2; wb.v[2] = 3; wb.v[3] = 4;
    wb.v[4] = 5; wb.v[5] = 6; wb.v[6] = 7; wb.v[7] = 8;
    report("wide-guard-before", wb.guard::i64, 99);
    report("wide-guard-before-lane7", wb.v[7]::i64, 8);

    # the odd shape between two guards, so an overrun in either direction is seen
    var od: Odd;
    od.guard0 = 11; od.guard1 = 22;
    od.v[0] = 1; od.v[1] = 2; od.v[2] = 3; od.v[3] = 4; od.v[4] = 5;
    report("odd-guard0", od.guard0::i64, 11);
    report("odd-guard1", od.guard1::i64, 22);
    report("odd-lane4", od.v[4]::i64, 5);

    # the layout the language promises, checked against the same shapes above. an
    # over-width vector is lane-derived in size and aligns to the register width, so
    # `$size_of` is 32 and the field after it starts at 32 rather than at 64.
    report("sizeof-i32x8",  $size_of(i32x8)::i64,  32);
    report("sizeof-i32x5",  $size_of(i32x5)::i64,  20);
    report("sizeof-i16x7",  $size_of(i16x7)::i64,  14);
    report("sizeof-f64x4",  $size_of(f64x4)::i64,  32);
    report("alignof-i32x8", $align_of(i32x8)::i64, 16);
    report("offsetof-guard-after", $offset_of(WideAfter, guard)::i64, 32);
    report("offsetof-v-before",    $offset_of(WideBefore, v)::i64,    16);
    report("sizeof-WideAfter",     $size_of(WideAfter)::i64,          48);
    report("offsetof-odd-guard1",  $offset_of(Odd, guard1)::i64,      36);

    # an array of them is a usable buffer: the stride is the size, so element 1 starts
    # where element 0 ends and neither reads the other's lanes.
    var buf: [3]i32x8;
    var bi: i32 = 0;
    for (bi < 3) {
        var t: i32x8;
        t[0] = bi; t[1] = bi; t[2] = bi; t[3] = bi;
        t[4] = bi; t[5] = bi; t[6] = bi; t[7] = bi;
        buf[bi] = t;
        bi = bi + 1;
    }
    report("array-stride-0", buf[0][7]::i64, 0);
    report("array-stride-2", buf[2][0]::i64, 2);
    report("sizeof-array",   $size_of([3]i32x8)::i64, 96);

    # across a call boundary, both directions
    report("call-arg", sum8(b8), 36);
    val r8: i32x8 = ramp8(100);
    report("call-ret-lane0", r8[0]::i64, 100);
    report("call-ret-lane7", r8[7]::i64, 107);
    report("call-roundtrip", sum8(ramp8(1)), 36);

    ret 0;
}
