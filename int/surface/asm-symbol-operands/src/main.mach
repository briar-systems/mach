# `--emit-asm` must name the symbol an inline-asm statement references (#2788).
#
# Every symbol the asm blocks below name carries a `#[symbol(...)]` literal linkage
# name beginning `iasm_`, so the producer can find each reference in the emitted `.s`
# and in the object's relocation records without knowing anything about the ISA or the
# mangling scheme. The mangled names of these same declarations do NOT begin `iasm_`,
# so a compiler-emitted reference to them can never be mistaken for an inline-asm one.
#
# The program also RUNS: the asm loads `iasm_counter` and calls `iasm_target`, so a
# reference that reached the wrong symbol is a wrong answer as well as wrong text.

use std.runtime;
use std.types.size.usize;
use p: std.print;

#[symbol("iasm_counter")]
pub var iasm_counter_v: i64 = 7;

#[symbol("iasm_other")]
pub var iasm_other_v: i64 = 11;

#[symbol("iasm_target")]
pub fun iasm_target_f() i64 { ret 3; }

# reads `iasm_counter` through a symbol-bearing memory operand and calls
# `iasm_target` through a direct transfer - the two shapes #2788 named.
$if ($mach.build.arch == $mach.arch.x86_64) {
fun probe() i64 {
    var out: i64 = 0;
    asm x86_64 {
        mov rax, [iasm_counter]
        mov {out}, rax
        mov rax, [iasm_other]
        add {out}, rax
        call iasm_target
        add {out}, rax
    }
    ret out;
}
}
$or ($mach.build.arch == $mach.arch.aarch64) {
fun probe() i64 {
    var out: i64 = 0;
    asm aarch64 {
        adrp x9, iasm_counter
        ldr x9, [x9, :lo12:iasm_counter]
        adrp x10, iasm_other
        ldr x10, [x10, :lo12:iasm_other]
        add x9, x9, x10
        bl iasm_target
        add x9, x9, x0
        str x9, {out}
    }
    ret out;
}
}
$or {
fun probe() i64 {
    var out: i64 = 0;
    asm riscv64 {
        la t0, iasm_counter
        ld t1, 0(t0)
        la t0, iasm_other
        ld t2, 0(t0)
        add t1, t1, t2
        call iasm_target
        add t1, t1, a0
        sd t1, {out}
    }
    ret out;
}
}

#[symbol("main")]
fun main(argc: usize, argv: **u8) i64 {
    p.printlnf("probe={}", probe());
    ret 0;
}
