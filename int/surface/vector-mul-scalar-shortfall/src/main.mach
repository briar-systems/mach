# `simd = "require"` sees a per-OPERATION scalar shortfall (#2726)
#
# 64-bit integer lanes are the shape no target packs: NEON's `MUL (vector)` leaves the
# .2d arrangement unallocated, PMULLQ is AVX512DQ with no legacy encoding, and riscv64
# has no vector unit. So all three legs realize this as per-lane scalar code, and all
# three must say so under `require`.
#
# This is the assertion that the lever reaches a CAPABLE target. Before #2726 it was
# gated on `has_v128 == false`, so a project that set `require` precisely to refuse a
# silent scalar expansion was told nothing about the ones x86-64 and aarch64 perform.
# The aarch64 golden here is the one that could not have existed before.
#
# It is also what makes the aarch64 encoder backstop (#2721) unreachable from source:
# the multiply is routed to the scalar expansion, so nothing ever asks NEON for an
# arrangement it does not have.

use std.runtime;
use std.types.size.usize;

fun mul64(a: i64x2, b: i64x2) i64x2 { ret a * b; }

#[symbol("main")]
fun main(argc: usize, argv: **u8) i64 {
    var a: i64x2;
    var b: i64x2;
    var m: i64x2 = mul64(a, b);
    ret m[0];
}
