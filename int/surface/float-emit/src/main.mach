# the scalar-float EMISSION case (#2237)
#
# every function below computes on floats the allocator can keep in the FP bank.
# the observable is how many emitted instructions name the back end's reserved FP
# scratch registers - the pair a value only reaches when the encoder stages it
# there rather than operating on it where it sits. an encoder that routes
# allocated operands through scratch again shows up here as a nonzero count, which
# is what the x86-64 back end did before #2237 and what aarch64 and riscv64 have
# never done.
#
# the sibling `float` case asserts the other half, that the arithmetic computes
# the right values; neither replaces the other.
#
# `#[scalar]` on every kernel: the auto-vectorizer would otherwise replace the
# scalar float path this measures with packed SIMD, and the verdicts would say
# nothing about the scalar encoders.

use std.runtime;
use std.types.size.usize;
use p: std.print;

var xs: [64]f32;
var ys: [64]f32;
var zs: [64]f64;

# three-address arithmetic: multiply and add over allocated FP registers
#[scalar]
fun saxpy(alpha: f32, n: i64) {
    var i: i64 = 0;
    for (i < n) {
        ys[i] = alpha * xs[i] + ys[i];
        i = i + 1;
    }
}

# an accumulating reduction: the destination is the left operand every iteration,
# which is the shape a two-address encoder emits with no copy at all
#[scalar]
fun dot(n: i64) f64 {
    var acc: f64 = 0.0;
    var i: i64 = 0;
    for (i < n) {
        acc = acc + zs[i] * zs[i];
        i = i + 1;
    }
    ret acc;
}

# comparison and negation
#[scalar]
fun maxabs(n: i64) f64 {
    var m: f64 = 0.0;
    var i: i64 = 0;
    for (i < n) {
        var t: f64 = zs[i];
        if (t < 0.0) { t = -t; }
        if (t > m) { m = t; }
        i = i + 1;
    }
    ret m;
}

# width conversions in both directions, float and integer
#[scalar]
fun widen(n: i64) i64 {
    var s: i64 = 0;
    var i: i64 = 0;
    for (i < n) {
        val d: f64 = xs[i]::f64;
        val f: f32 = (d + 1.0)::f32;
        s = s + f::i64;
        i = i + 1;
    }
    ret s;
}

#[symbol("main")]
fun main(argc: usize, argv: **u8) i64 {
    var i: i64 = 0;
    for (i < 64) {
        xs[i] = (i % 7)::f32;
        ys[i] = (i % 5)::f32;
        zs[i] = ((i % 9) - 4)::f64;
        i = i + 1;
    }
    saxpy(1.5::f32, 64);
    p.printlnf("dot={}", (dot(64) * 4.0)::i64);
    p.printlnf("maxabs={}", (maxabs(64) * 4.0)::i64);
    p.printlnf("widen={}", widen(64));
    ret 0;
}
