# qz_indirect reaches Sleep and GetTickCount through Clang's undefined __imp_
# object symbols. GetTickCount has no direct Mach declaration, proving an
# indirect-only import still gets an IAT entry without getting a call stub.
# This direct Mach call reaches the same export through a normal call stub; the PE
# must contain only one loader import and one IAT entry for the two spellings.
ext fun qz_indirect() u32;

#[library("kernel32.dll")]
ext fun Sleep(milliseconds: u32);

#[symbol("mainCRTStartup")]
pub fun _start() {
    qz_indirect();
    Sleep(0);
}
