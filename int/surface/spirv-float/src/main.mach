# SPIR-V scalar floating-point fixture: float work delivers a valid `.spv`
#
# The companion to the spirv-module case, which covers the integer and
# control-flow half. Here the observable is the same - the external Khronos
# validator's verdict on every module the build delivers - but the bodies are
# float-shaped, because the float path is where a plausible-looking module that no
# consumer accepts is easiest to emit.
#
# The specific hazard these bodies exist to catch: a float literal reaches the back
# half as a bare IEEE bit pattern in the same field an integer literal uses, so
# nothing about the value itself says which type to spell it at. Emitting it as an
# integer constant produces a module that round-trips through mach's own reader and
# that spirv-val rejects on the spot (`OpReturnValue`'s type does not match
# `OpFunction`'s), which is exactly what `ret 1.5;` used to do. Every function
# below that mentions a literal is holding that line.
#
# The relations are covered one by one rather than in a bundle because the
# validator cannot tell a correct comparison from a wrong one - both type-check to
# `%bool` - so the value of listing them is that a mapping which drifts to the
# wrong ordered / unordered form is at least visible in the disassembly.

fun add(a: f32, b: f32) f32 { ret a + b; }
fun sub(a: f32, b: f32) f32 { ret a - b; }
fun mul(a: f32, b: f32) f32 { ret a * b; }
fun div(a: f32, b: f32) f32 { ret a / b; }

fun add64(a: f64, b: f64) f64 { ret a + b; }
fun mix64(a: f64, b: f64) f64 { ret (a * b) - (a / b); }

fun neg(a: f32) f32 { ret -a; }

# a float literal in every position it can occupy: returned bare, as an operand,
# and as a call argument. each one must be spelled at the type its consumer
# declares, not at the machine word.
fun literal32() f32 { ret 1.5; }
fun literal64() f64 { ret 1.5; }
fun scale(a: f32) f32 { ret a * 2.5; }
fun offset64(a: f64) f64 { ret a + 0.125; }
fun via_call(a: f32) f32 { ret add(a, 0.75); }

# the six relations. `>` / `>=` canonicalize to the `<` / `<=` forms with their
# operands reversed, so all six reach the emitter as three opcodes.
fun relations(a: f32, b: f32) i32 {
    if (a == b) { ret 1; }
    if (a != b) { ret 2; }
    if (a < b)  { ret 3; }
    if (a <= b) { ret 4; }
    if (a > b)  { ret 5; }
    if (a >= b) { ret 6; }
    ret 0;
}

fun relations64(a: f64, b: f64) i32 {
    if (a < b)  { ret 1; }
    if (a >= b) { ret 2; }
    ret 0;
}

# the conversions between the float widths and across to the integer class, both
# signednesses. these are the shapes whose operand type is not their result type.
fun widen(a: f32) f64 { ret a::f64; }
fun narrow(a: f64) f32 { ret a::f32; }
fun to_signed(a: f32) i32 { ret a::i32; }
fun to_unsigned(a: f32) u32 { ret a::u32; }
fun from_signed(a: i32) f32 { ret a::f32; }
fun from_unsigned(a: u32) f32 { ret a::f32; }
fun reinterpret(a: f32) u32 { ret a:~u32; }

# float values carried across the structured control flow the emitter
# reconstructs: an accumulator living across a loop's back edge is stored and
# reloaded through its variable every iteration, so a mistyped variable shows up
# here rather than in straight-line code.
fun accumulate(n: i32, step: f32) f32 {
    var acc: f32 = 0.0;
    var i: i32 = 0;
    for (i < n) {
        acc = acc + step;
        i = i + 1;
    }
    ret acc;
}

# a selection whose arms both produce a float, joined after the merge: the phi the
# lowering leaves behind is a register copy at the machine word, and the copy's
# destination must still come out float-typed.
fun clamp01(v: f32) f32 {
    var r: f32 = v;
    if (v < 0.0) { r = 0.0; } or (v > 1.0) { r = 1.0; }
    ret r;
}

# mixed int and float in one body, so a single function forces both type families
# through the same variable map.
fun blend(t: f32, n: i32) f32 {
    var acc: f32 = 0.0;
    var i: i32 = 0;
    for (i < n) {
        if (i % 2 == 0) { acc = acc + t; }
        or { acc = acc - (t * 0.5); }
        i = i + 1;
    }
    if (acc < 0.0) { ret 0.0; }
    ret acc;
}

# a float through a direct call chain, including a call whose argument is another
# call's float result.
fun composed(a: f32, b: f32) f32 {
    ret mul(add(a, b), div(a, b));
}

fun main() i32 {
    ret 0;
}
