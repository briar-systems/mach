# element-wise loop auto-vectorization (#2141): a vectorizable loop must produce
# output bit-identical to a #[scalar] scalar reference, at trip counts that
# are multiples of the lane count and not, for signed and unsigned integers and
# for f32/f64, with the runtime alias guard routing overlapping arrays to scalar.
# All observables are integers (floats folded to their bit pattern), so the golden
# is target-independent; on riscv64 both paths run scalar and still agree.
use std.runtime;
use std.types.size.usize;
use p: std.print;

fun i32add_v(a: *i32, b: *i32, c: *i32, n: i64) { var i: i64=0; for(i<n){ a[i]=b[i]+c[i]; i=i+1; } }
#[scalar]
fun i32add_s(a: *i32, b: *i32, c: *i32, n: i64) { var i: i64=0; for(i<n){ a[i]=b[i]+c[i]; i=i+1; } }
fun u8or_v(a: *u8, b: *u8, c: *u8, n: i64) { var i: i64=0; for(i<n){ a[i]=b[i]|c[i]; i=i+1; } }
#[scalar]
fun u8or_s(a: *u8, b: *u8, c: *u8, n: i64) { var i: i64=0; for(i<n){ a[i]=b[i]|c[i]; i=i+1; } }
fun i16add_v(a: *i16, b: *i16, c: *i16, n: i64) { var i: i64=0; for(i<n){ a[i]=b[i]+c[i]; i=i+1; } }
#[scalar]
fun i16add_s(a: *i16, b: *i16, c: *i16, n: i64) { var i: i64=0; for(i<n){ a[i]=b[i]+c[i]; i=i+1; } }
fun i64add_v(a: *i64, b: *i64, c: *i64, n: i64) { var i: i64=0; for(i<n){ a[i]=b[i]+c[i]; i=i+1; } }
#[scalar]
fun i64add_s(a: *i64, b: *i64, c: *i64, n: i64) { var i: i64=0; for(i<n){ a[i]=b[i]+c[i]; i=i+1; } }
fun f64add_v(a: *f64, b: *f64, c: *f64, n: i64) { var i: i64=0; for(i<n){ a[i]=b[i]+c[i]; i=i+1; } }
#[scalar]
fun f64add_s(a: *f64, b: *f64, c: *f64, n: i64) { var i: i64=0; for(i<n){ a[i]=b[i]+c[i]; i=i+1; } }
fun f32mul_v(a: *f32, b: *f32, c: *f32, n: i64) { var i: i64=0; for(i<n){ a[i]=b[i]*c[i]; i=i+1; } }
#[scalar]
fun f32mul_s(a: *f32, b: *f32, c: *f32, n: i64) { var i: i64=0; for(i<n){ a[i]=b[i]*c[i]; i=i+1; } }

# module-scope arrays (#2201), reached through the two-index array-decay gep rather
# than a pointer parameter. the two versions write separate destinations so both
# results survive the comparison; the sources are shared.
var gsrc0: [512]i32; var gsrc1: [512]i32; var gdst_v: [512]i32; var gdst_s: [512]i32;
fun gi32add_v(n: i64) { var i: i64=0; for(i<n){ gdst_v[i]=gsrc0[i]+gsrc1[i]; i=i+1; } }
#[scalar]
fun gi32add_s(n: i64) { var i: i64=0; for(i<n){ gdst_s[i]=gsrc0[i]+gsrc1[i]; i=i+1; } }

# both scope gaps in one loop: a module-scope array scaled by a loop-invariant scalar
var gfsrc: [512]f64; var gfdst_v: [512]f64; var gfdst_s: [512]f64;
fun gf64scale_v(k: f64, n: i64) { var i: i64=0; for(i<n){ gfdst_v[i]=gfsrc[i]*k; i=i+1; } }
#[scalar]
fun gf64scale_s(k: f64, n: i64) { var i: i64=0; for(i<n){ gfdst_s[i]=gfsrc[i]*k; i=i+1; } }

# a loop-carried dependence over module-scope arrays must still DECLINE: the wider gep
# shape must not bypass the dependence proof. seeded identically, both must agree.
fun gcarried_v(n: i64) { var i: i64=1; for(i<n){ gdst_v[i]=gdst_v[i-1]+1; i=i+1; } }
#[scalar]
fun gcarried_s(n: i64) { var i: i64=1; for(i<n){ gdst_s[i]=gdst_s[i-1]+1; i=i+1; } }

# a loop-invariant scalar operand (#2202), broadcast once into the preheader: scaling
# in both operand orders, the fused multiply-add shape, and an integer lane type
fun f32scale_v(a: *f32, b: *f32, k: f32, n: i64) { var i: i64=0; for(i<n){ a[i]=b[i]*k; i=i+1; } }
#[scalar]
fun f32scale_s(a: *f32, b: *f32, k: f32, n: i64) { var i: i64=0; for(i<n){ a[i]=b[i]*k; i=i+1; } }
fun f32scalec_v(a: *f32, b: *f32, k: f32, n: i64) { var i: i64=0; for(i<n){ a[i]=k*b[i]; i=i+1; } }
#[scalar]
fun f32scalec_s(a: *f32, b: *f32, k: f32, n: i64) { var i: i64=0; for(i<n){ a[i]=k*b[i]; i=i+1; } }
fun f32axpy_v(a: *f32, b: *f32, c: *f32, k: f32, n: i64) { var i: i64=0; for(i<n){ a[i]=k*b[i]+c[i]; i=i+1; } }
#[scalar]
fun f32axpy_s(a: *f32, b: *f32, c: *f32, k: f32, n: i64) { var i: i64=0; for(i<n){ a[i]=k*b[i]+c[i]; i=i+1; } }
fun i32bias_v(a: *i32, b: *i32, k: i32, n: i64) { var i: i64=0; for(i<n){ a[i]=b[i]+k; i=i+1; } }
#[scalar]
fun i32bias_s(a: *i32, b: *i32, k: i32, n: i64) { var i: i64=0; for(i<n){ a[i]=b[i]+k; i=i+1; } }

# a mixed-type loop (i32 add + f32 mul in ONE body, same 4-byte width) must DECLINE
# to vectorize (uniform element TYPE is required, not just width) and stay correct
fun mixed_v(a: *i32, b: *i32, x: *f32, y: *f32, n: i64) { var i: i64=0; for(i<n){ a[i]=b[i]+b[i]; x[i]=y[i]*y[i]; i=i+1; } }
#[scalar]
fun mixed_s(a: *i32, b: *i32, x: *f32, y: *f32, n: i64) { var i: i64=0; for(i<n){ a[i]=b[i]+b[i]; x[i]=y[i]*y[i]; i=i+1; } }

# a float negate loop must DECLINE (no vector-negate lowering) and stay correct,
# including the sign of -0.0 (0.0 negates to -0.0; checksums fold the bit pattern)
fun fneg_v(a: *f64, b: *f64, n: i64) { var i: i64=0; for(i<n){ a[i]=0.0-b[i]; i=i+1; } }
#[scalar]
fun fneg_s(a: *f64, b: *f64, n: i64) { var i: i64=0; for(i<n){ a[i]=0.0-b[i]; i=i+1; } }
fun fneg2_v(a: *f64, b: *f64, n: i64) { var i: i64=0; for(i<n){ a[i]=-b[i]; i=i+1; } }
#[scalar]
fun fneg2_s(a: *f64, b: *f64, n: i64) { var i: i64=0; for(i<n){ a[i]=-b[i]; i=i+1; } }

# a conditional store must DECLINE (the body is not the single-block element-wise
# shape) and stay correct: only elements passing the test are written
fun cond_v(a: *i32, b: *i32, c: *i32, n: i64) { var i: i64=0; for(i<n){ if (b[i] < 50) { a[i]=b[i]+c[i]; } i=i+1; } }
#[scalar]
fun cond_s(a: *i32, b: *i32, c: *i32, n: i64) { var i: i64=0; for(i<n){ if (b[i] < 50) { a[i]=b[i]+c[i]; } i=i+1; } }

# affine indices (#2312): the induction variable shifted by a loop-invariant offset,
# with the offset spelled inline and hoisted into a cursor of its own. Both are run at
# a range of offsets and trip counts, so the alias guard's shifted ranges, the vector
# loop's lane stepping and the scalar remainder's re-entry are all exercised at
# offsets a lane group straddles.
fun aff_v(a: *f32, b: *f32, k: f32, o: i64, n: i64) { var i: i64=0; for(i<n){ a[o+i]=k*b[o+i]+a[o+i]; i=i+1; } }
#[scalar]
fun aff_s(a: *f32, b: *f32, k: f32, o: i64, n: i64) { var i: i64=0; for(i<n){ a[o+i]=k*b[o+i]+a[o+i]; i=i+1; } }
fun affcur_v(a: *f32, b: *f32, k: f32, o: i64, n: i64) { var i: i64=0; var t: i64=o; for(i<n){ a[t]=k*b[t]+a[t]; t=t+1; i=i+1; } }
#[scalar]
fun affcur_s(a: *f32, b: *f32, k: f32, o: i64, n: i64) { var i: i64=0; var t: i64=o; for(i<n){ a[t]=k*b[t]+a[t]; t=t+1; i=i+1; } }
# a cursor whose closed form needs the induction variable's own start folded out
fun affcurk_v(a: *f32, b: *f32, k: f32, n: i64) { var i: i64=1; var t: i64=5; for(i<n){ a[t]=k*b[t]+a[t]; t=t+1; i=i+1; } }
#[scalar]
fun affcurk_s(a: *f32, b: *f32, k: f32, n: i64) { var i: i64=1; var t: i64=5; for(i<n){ a[t]=k*b[t]+a[t]; t=t+1; i=i+1; } }

# the matmul inner loop: two invariant row offsets over distinct bases
fun affmm_v(o: *f32, b: *f32, k: f32, ro: i64, ko: i64, n: i64) { var j: i64=0; for(j<n){ o[ro+j]=o[ro+j]+k*b[ko+j]; j=j+1; } }
#[scalar]
fun affmm_s(o: *f32, b: *f32, k: f32, ro: i64, ko: i64, n: i64) { var j: i64=0; for(j<n){ o[ro+j]=o[ro+j]+k*b[ko+j]; j=j+1; } }

# a shifted store over the SAME base as a load is a loop-carried dependence at the
# runtime distance `o`, which must DECLINE and stay correct at every distance -- the
# proof that widening the index did not widen what is vectorized without proof
fun affdep_v(a: *i32, o: i64, n: i64) { var i: i64=0; for(i<n){ a[o+i]=a[i]+1; i=i+1; } }
#[scalar]
fun affdep_s(a: *i32, o: i64, n: i64) { var i: i64=0; for(i<n){ a[o+i]=a[i]+1; i=i+1; } }

# an affine reduction: no store, so no alias guard, but the shifted loads must still
# land on the elements the scalar reduction reads
fun affred_v(a: *i64, o: i64, n: i64) i64 { var s: i64=0; var i: i64=0; for(i<n){ s=s+a[o+i]; i=i+1; } ret s; }
#[scalar]
fun affred_s(a: *i64, o: i64, n: i64) i64 { var s: i64=0; var i: i64=0; for(i<n){ s=s+a[o+i]; i=i+1; } ret s; }

# non-unit strides must DECLINE and stay correct: a doubled stride writes every other
# element and a reversed one walks backwards, neither of which a contiguous lane group
# covers. Recognizing the index affinely is what makes these reachable at all, so the
# stride gate is what stands between them and a wrong answer
fun affstr_v(a: *f32, b: *f32, n: i64) { var i: i64=0; for(i<n){ a[2*i]=b[2*i]+1.0; i=i+1; } }
#[scalar]
fun affstr_s(a: *f32, b: *f32, n: i64) { var i: i64=0; for(i<n){ a[2*i]=b[2*i]+1.0; i=i+1; } }
fun affrev_v(a: *f32, b: *f32, n: i64) { var i: i64=0; for(i<n){ a[n-i]=b[n-i]+1.0; i=i+1; } }
#[scalar]
fun affrev_s(a: *f32, b: *f32, n: i64) { var i: i64=0; for(i<n){ a[n-i]=b[n-i]+1.0; i=i+1; } }

# two DISTINCT bases at DIFFERENT offsets, the shape whose true address windows the
# alias guard can only find by shifting each base by that access's own offset. Called
# below with bases far enough apart that the unshifted windows are disjoint while the
# shifted ones overlap by all but one element: a guard reading the unshifted windows
# routes an overlapping run to the vector path and gets a wrong answer
fun affpq_v(a: *f32, b: *f32, p: i64, q: i64, n: i64) { var i: i64=0; for(i<n){ a[p+i]=b[q+i]+1.0; i=i+1; } }
#[scalar]
fun affpq_s(a: *f32, b: *f32, p: i64, q: i64, n: i64) { var i: i64=0; for(i<n){ a[p+i]=b[q+i]+1.0; i=i+1; } }

# predicated bodies (#2348): the guard covers a register value only, so predicating
# introduces no memory access. Each is paired with a #[scalar] twin, and the byte and
# half-word widths are ALSO checked against an absolute oracle below -- a narrow
# arithmetic fault would otherwise move both twins the same way and read as agreement.
fun pclamp_v(a: *i32, b: *i32, n: i64) { var i: i64=0; for(i<n){ var t: i32=b[i]; if (t > 50) { t = 50; } a[i]=t; i=i+1; } }
#[scalar]
fun pclamp_s(a: *i32, b: *i32, n: i64) { var i: i64=0; for(i<n){ var t: i32=b[i]; if (t > 50) { t = 50; } a[i]=t; i=i+1; } }
fun pmin_v(a: *i32, b: *i32, c: *i32, n: i64) { var i: i64=0; for(i<n){ var x: i32=b[i]; var y: i32=c[i]; var t: i32=x; if (x > y) { t = y; } a[i]=t; i=i+1; } }
#[scalar]
fun pmin_s(a: *i32, b: *i32, c: *i32, n: i64) { var i: i64=0; for(i<n){ var x: i32=b[i]; var y: i32=c[i]; var t: i32=x; if (x > y) { t = y; } a[i]=t; i=i+1; } }
fun pu8_v(a: *u8, b: *u8, n: i64) { var i: i64=0; for(i<n){ var t: u8=b[i]; if (t > 127) { t = 255; } a[i]=t; i=i+1; } }
#[scalar]
fun pu8_s(a: *u8, b: *u8, n: i64) { var i: i64=0; for(i<n){ var t: u8=b[i]; if (t > 127) { t = 255; } a[i]=t; i=i+1; } }
fun pu16_v(a: *u16, b: *u16, n: i64) { var i: i64=0; for(i<n){ var t: u16=b[i]; if (t > 300) { t = 65535; } a[i]=t; i=i+1; } }
#[scalar]
fun pu16_s(a: *u16, b: *u16, n: i64) { var i: i64=0; for(i<n){ var t: u16=b[i]; if (t > 300) { t = 65535; } a[i]=t; i=i+1; } }
fun ptwo_v(a: *i32, d: *i32, b: *i32, n: i64) { var i: i64=0; for(i<n){ var x: i32=b[i]; var t: i32=x; var u: i32=0; if (x > 10) { t = 10; u = 1; } a[i]=t; d[i]=u; i=i+1; } }
#[scalar]
fun ptwo_s(a: *i32, d: *i32, b: *i32, n: i64) { var i: i64=0; for(i<n){ var x: i32=b[i]; var t: i32=x; var u: i32=0; if (x > 10) { t = 10; u = 1; } a[i]=t; d[i]=u; i=i+1; } }

# an arm holding pure arithmetic must DECLINE and stay correct: admitting it would
# leave the arm's value defined in a block if-conversion drops
fun parm_v(a: *i32, b: *i32, n: i64) { var i: i64=0; for(i<n){ var x: i32=b[i]; var t: i32=x; if (x > 10) { t = x + 100; } a[i]=t; i=i+1; } }
#[scalar]
fun parm_s(a: *i32, b: *i32, n: i64) { var i: i64=0; for(i<n){ var x: i32=b[i]; var t: i32=x; if (x > 10) { t = x + 100; } a[i]=t; i=i+1; } }

# comparisons stored as values must stay scalar 0 or 1, never packed all-ones masks
fun pcmp_v(a: *u8, b: *u8, c: *u8, n: i64) { var i: i64=0; for(i<n){ a[i]=(b[i]>c[i]); i=i+1; } }
#[scalar]
fun pcmp_s(a: *u8, b: *u8, c: *u8, n: i64) { var i: i64=0; for(i<n){ a[i]=(b[i]>c[i]); i=i+1; } }

# the guard itself has the same scalar-value constraint when another store consumes it
fun pguard_v(a: *u8, d: *u8, b: *u8, n: i64) { var i: i64=0; for(i<n){ var x: u8=b[i]; var c: u8=x>127; var t: u8=x; if (c) { t=255; } a[i]=t; d[i]=c; i=i+1; } }
#[scalar]
fun pguard_s(a: *u8, d: *u8, b: *u8, n: i64) { var i: i64=0; for(i<n){ var x: u8=b[i]; var c: u8=x>127; var t: u8=x; if (c) { t=255; } a[i]=t; d[i]=c; i=i+1; } }

# an unsupported guard tree must decline even when both selected values vectorize
fun pguardcalc_v(a: *i32, b: *i32, n: i64) { var i: i64=0; for(i<n){ var x: i32=b[i]; var t: i32=x; if ((x*3)>10) { t=10; } a[i]=t; i=i+1; } }
#[scalar]
fun pguardcalc_s(a: *i32, b: *i32, n: i64) { var i: i64=0; for(i<n){ var x: i32=b[i]; var t: i32=x; if ((x*3)>10) { t=10; } a[i]=t; i=i+1; } }

fun ck32(a: *i32, n: i64) i64 { var s: i64=0; var i: i64=0; for(i<n){ s=s*131+(a[i]::i64); i=i+1; } ret s; }
fun cku8(a: *u8, n: i64) i64 { var s: i64=0; var i: i64=0; for(i<n){ s=s*131+(a[i]::i64); i=i+1; } ret s; }
fun cku16(a: *u16, n: i64) i64 { var s: i64=0; var i: i64=0; for(i<n){ s=s*131+(a[i]::i64); i=i+1; } ret s; }
fun ck16(a: *i16, n: i64) i64 { var s: i64=0; var i: i64=0; for(i<n){ s=s*131+(a[i]::i64); i=i+1; } ret s; }
fun ck64(a: *i64, n: i64) i64 { var s: i64=0; var i: i64=0; for(i<n){ s=s*131+a[i]; i=i+1; } ret s; }
fun ckf64(a: *f64, n: i64) i64 { var s: i64=0; var i: i64=0; for(i<n){ s=s*131+(a[i]:~i64); i=i+1; } ret s; }
fun ckf32(a: *f32, n: i64) i64 { var s: i64=0; var i: i64=0; for(i<n){ s=s*131+((a[i]:~i32)::i64); i=i+1; } ret s; }

# a nonzero low byte so distinct checksums are meaningful; kept small to bound the golden
fun norm(x: i64) i64 { var v: i64 = x; if (v < 0) { v = 0 - v; } ret v % 100000; }

#[symbol("main")]
fun main(argc: usize, argv: **u8) i64 {
    var mism: i64 = 0;
    var acc: i64 = 0;
    var av: [512]i64; var as2: [512]i64; var bi: [512]i64; var ci: [512]i64;
    var wv: [512]i32; var ws: [512]i32; var bw: [512]i32; var cw: [512]i32;
    var hv: [512]i16; var hs: [512]i16; var bh: [512]i16; var ch: [512]i16;
    var uv: [512]u8;  var us: [512]u8;  var bu: [512]u8;  var cu: [512]u8;
    var dv: [512]f64; var ds: [512]f64; var bd: [512]f64; var cd: [512]f64;
    var fv: [512]f32; var fs: [512]f32; var bf: [512]f32; var cf: [512]f32;
    var trips: [4]i64; trips[0]=64; trips[1]=63; trips[2]=17; trips[3]=1;
    var ti: i64 = 0;
    for (ti < 4) {
        val n: i64 = trips[ti];
        var i: i64 = 0;
        for (i < n) {
            bi[i]=i*7-13; ci[i]=i*3+5;
            bw[i]=(i*7-13)::i32; cw[i]=(i*3+5)::i32;
            bh[i]=(i*3-9)::i16; ch[i]=(i*2+4)::i16;
            bu[i]=(i*5+1)::u8; cu[i]=(i*3+7)::u8;
            bd[i]=(i::f64)*1.5-7.0; cd[i]=(i::f64)*0.25+2.0;
            bf[i]=(i::f32)*1.5-7.0; cf[i]=(i::f32)*0.5+2.0;
            i=i+1;
        }
        i64add_v(?av[0],?bi[0],?ci[0],n); i64add_s(?as2[0],?bi[0],?ci[0],n); if(ck64(?av[0],n)!=ck64(?as2[0],n)){mism=mism+1;} acc=acc+norm(ck64(?av[0],n));
        i32add_v(?wv[0],?bw[0],?cw[0],n); i32add_s(?ws[0],?bw[0],?cw[0],n); if(ck32(?wv[0],n)!=ck32(?ws[0],n)){mism=mism+1;} acc=acc+norm(ck32(?wv[0],n));
        i16add_v(?hv[0],?bh[0],?ch[0],n); i16add_s(?hs[0],?bh[0],?ch[0],n); if(ck16(?hv[0],n)!=ck16(?hs[0],n)){mism=mism+1;} acc=acc+norm(ck16(?hv[0],n));
        u8or_v(?uv[0],?bu[0],?cu[0],n); u8or_s(?us[0],?bu[0],?cu[0],n); if(cku8(?uv[0],n)!=cku8(?us[0],n)){mism=mism+1;} acc=acc+norm(cku8(?uv[0],n));
        f64add_v(?dv[0],?bd[0],?cd[0],n); f64add_s(?ds[0],?bd[0],?cd[0],n); if(ckf64(?dv[0],n)!=ckf64(?ds[0],n)){mism=mism+1;} acc=acc+norm(ckf64(?dv[0],n));
        f32mul_v(?fv[0],?bf[0],?cf[0],n); f32mul_s(?fs[0],?bf[0],?cf[0],n); if(ckf32(?fv[0],n)!=ckf32(?fs[0],n)){mism=mism+1;} acc=acc+norm(ckf32(?fv[0],n));
        mixed_v(?wv[0],?bw[0],?fv[0],?bf[0],n); mixed_s(?ws[0],?bw[0],?fs[0],?bf[0],n);
        if(ck32(?wv[0],n)!=ck32(?ws[0],n)){mism=mism+1;} if(ckf32(?fv[0],n)!=ckf32(?fs[0],n)){mism=mism+1;}
        acc=acc+norm(ck32(?wv[0],n))+norm(ckf32(?fv[0],n));
        # bd[0..] includes 7.0-offset values; force a 0.0 so -0.0 sign is observable
        bd[0]=0.0;
        fneg_v(?dv[0],?bd[0],n); fneg_s(?ds[0],?bd[0],n); if(ckf64(?dv[0],n)!=ckf64(?ds[0],n)){mism=mism+1;} acc=acc+norm(ckf64(?dv[0],n));
        fneg2_v(?dv[0],?bd[0],n); fneg2_s(?ds[0],?bd[0],n); if(ckf64(?dv[0],n)!=ckf64(?ds[0],n)){mism=mism+1;} acc=acc+norm(ckf64(?dv[0],n));
        var ii2: i64 = 0;
        for (ii2 < n) { wv[ii2]=0-1; ws[ii2]=0-1; ii2=ii2+1; }
        cond_v(?wv[0],?bw[0],?cw[0],n); cond_s(?ws[0],?bw[0],?cw[0],n); if(ck32(?wv[0],n)!=ck32(?ws[0],n)){mism=mism+1;} acc=acc+norm(ck32(?wv[0],n));

        # a loop-invariant scalar operand, splatted once: both operand orders, the
        # fused multiply-add, and an integer lane type
        f32scale_v(?fv[0],?bf[0],1.25,n); f32scale_s(?fs[0],?bf[0],1.25,n); if(ckf32(?fv[0],n)!=ckf32(?fs[0],n)){mism=mism+1;} acc=acc+norm(ckf32(?fv[0],n));
        f32scalec_v(?fv[0],?bf[0],1.25,n); f32scalec_s(?fs[0],?bf[0],1.25,n); if(ckf32(?fv[0],n)!=ckf32(?fs[0],n)){mism=mism+1;} acc=acc+norm(ckf32(?fv[0],n));
        f32axpy_v(?fv[0],?bf[0],?cf[0],1.25,n); f32axpy_s(?fs[0],?bf[0],?cf[0],1.25,n); if(ckf32(?fv[0],n)!=ckf32(?fs[0],n)){mism=mism+1;} acc=acc+norm(ckf32(?fv[0],n));
        i32bias_v(?wv[0],?bw[0],0-9,n); i32bias_s(?ws[0],?bw[0],0-9,n); if(ck32(?wv[0],n)!=ck32(?ws[0],n)){mism=mism+1;} acc=acc+norm(ck32(?wv[0],n));

        # module-scope arrays, plain and scaled, then a loop-carried dependence over
        # the same arrays that must stay scalar
        var gi: i64 = 0;
        for (gi < n) { gsrc0[gi]=(gi*7-13)::i32; gsrc1[gi]=(gi*3+5)::i32; gfsrc[gi]=(gi::f64)*1.5-7.0; gi=gi+1; }
        gi32add_v(n); gi32add_s(n); if(ck32(?gdst_v[0],n)!=ck32(?gdst_s[0],n)){mism=mism+1;} acc=acc+norm(ck32(?gdst_v[0],n));
        gf64scale_v(0.75,n); gf64scale_s(0.75,n); if(ckf64(?gfdst_v[0],n)!=ckf64(?gfdst_s[0],n)){mism=mism+1;} acc=acc+norm(ckf64(?gfdst_v[0],n));
        gi=0; for (gi < n) { gdst_v[gi]=(gi*2+1)::i32; gdst_s[gi]=(gi*2+1)::i32; gi=gi+1; }
        gcarried_v(n); gcarried_s(n); if(ck32(?gdst_v[0],n)!=ck32(?gdst_s[0],n)){mism=mism+1;} acc=acc+norm(ck32(?gdst_v[0],n));
        ti=ti+1;
    }
    # aliasing hazard: dst overlaps src0 by one element -> the runtime guard must
    # route to the scalar fallback so the result still matches the scalar reference
    var arr: [130]i32; var arr2: [130]i32; var cc: [128]i32;
    var j: i64 = 0;
    for (j<130){ arr[j]=(j*5+1)::i32; arr2[j]=(j*5+1)::i32; j=j+1; }
    j=0; for (j<128){ cc[j]=(j*2+3)::i32; j=j+1; }
    i32add_v(?arr[1], ?arr[0], ?cc[0], 128);
    i32add_s(?arr2[1], ?arr2[0], ?cc[0], 128);
    if (ck32(?arr[0],130) != ck32(?arr2[0],130)) { mism = mism + 1; }

    # the same hazard through a splatted loop: the guard is unchanged by the splat, so
    # an overlapping dst / src still takes the scalar fallback
    var fr: [130]f32; var fr2: [130]f32;
    j=0; for (j<130){ fr[j]=(j::f32)*0.5+1.0; fr2[j]=(j::f32)*0.5+1.0; j=j+1; }
    f32scale_v(?fr[1], ?fr[0], 1.25, 128);
    f32scale_s(?fr2[1], ?fr2[0], 1.25, 128);
    if (ckf32(?fr[0],130) != ckf32(?fr2[0],130)) { mism = mism + 1; }

    # affine indices, over a grid of offsets and trip counts. the offsets deliberately
    # include ones that are not a multiple of any lane count, so the vector loop's
    # shifted start and the scalar remainder's re-entry are both covered.
    var aw: [384]f32; var as3: [384]f32; var ab: [384]f32;
    var qv: [384]i32; var qs: [384]i32;
    var rv: [384]i64;
    var aoffs: [5]i64; aoffs[0]=0; aoffs[1]=1; aoffs[2]=3; aoffs[3]=7; aoffs[4]=64;
    var at: i64 = 0;
    for (at < 4) {
        val n: i64 = trips[at];
        var ao: i64 = 0;
        for (ao < 5) {
            val o: i64 = aoffs[ao];
            var i: i64 = 0;
            for (i < 384) {
                ab[i]=(i::f32)*0.5-3.0; aw[i]=(i::f32)*0.25+1.0; as3[i]=(i::f32)*0.25+1.0;
                qv[i]=(i*3+5)::i32; qs[i]=(i*3+5)::i32; rv[i]=i*11-4;
                i=i+1;
            }
            aff_v(?aw[0],?ab[0],1.25,o,n); aff_s(?as3[0],?ab[0],1.25,o,n);
            if (ckf32(?aw[0],384)!=ckf32(?as3[0],384)) { mism=mism+1; }
            affcur_v(?aw[0],?ab[0],0.75,o,n); affcur_s(?as3[0],?ab[0],0.75,o,n);
            if (ckf32(?aw[0],384)!=ckf32(?as3[0],384)) { mism=mism+1; }
            affcurk_v(?aw[0],?ab[0],0.75,n); affcurk_s(?as3[0],?ab[0],0.75,n);
            if (ckf32(?aw[0],384)!=ckf32(?as3[0],384)) { mism=mism+1; }
            affmm_v(?aw[0],?ab[0],1.5,o,5,n); affmm_s(?as3[0],?ab[0],1.5,o,5,n);
            if (ckf32(?aw[0],384)!=ckf32(?as3[0],384)) { mism=mism+1; }
            affdep_v(?qv[0],o,n); affdep_s(?qs[0],o,n);
            if (ck32(?qv[0],384)!=ck32(?qs[0],384)) { mism=mism+1; }
            if (affred_v(?rv[0],o,n) != affred_s(?rv[0],o,n)) { mism=mism+1; }
            acc=acc+norm(ckf32(?aw[0],384))+norm(ck32(?qv[0],384))+norm(affred_v(?rv[0],o,n));
            # the same aliasing hazard through an affine index: the shifted ranges
            # overlap, so the guard must route to the scalar fallback
            i=0; for (i < 384) { aw[i]=(i::f32)*0.25+1.0; as3[i]=(i::f32)*0.25+1.0; i=i+1; }
            aff_v(?aw[2],?aw[0],1.25,o,n); aff_s(?as3[2],?as3[0],1.25,o,n);
            if (ckf32(?aw[0],384)!=ckf32(?as3[0],384)) { mism=mism+1; }
            # the non-unit strides, over the same seeded arrays
            i=0; for (i < 384) { aw[i]=(i::f32)*0.25+1.0; as3[i]=(i::f32)*0.25+1.0; i=i+1; }
            affstr_v(?aw[0],?ab[0],n); affstr_s(?as3[0],?ab[0],n);
            if (ckf32(?aw[0],384)!=ckf32(?as3[0],384)) { mism=mism+1; }
            affrev_v(?aw[0],?ab[0],n); affrev_s(?as3[0],?ab[0],n);
            if (ckf32(?aw[0],384)!=ckf32(?as3[0],384)) { mism=mism+1; }
            acc=acc+norm(ckf32(?aw[0],384));
            ao=ao+1;
        }
        at=at+1;
    }

    # two distinct bases at different offsets. `aw` and `aw+100` are 100 elements
    # apart, so the windows the induction variable alone describes -- [aw, aw+64) and
    # [aw+100, aw+164) -- are disjoint, while the ones the accesses really touch --
    # [aw+101, aw+165) and [aw+100, aw+164) -- overlap at a shift of one element,
    # which is a loop-carried dependence the vector path would read stale.
    var pi2: i64 = 0;
    for (pi2 < 384) { aw[pi2]=(pi2::f32)*0.25+1.0; as3[pi2]=(pi2::f32)*0.25+1.0; pi2=pi2+1; }
    affpq_v(?aw[0], ?aw[100], 101, 0, 64);
    affpq_s(?as3[0], ?as3[100], 101, 0, 64);
    if (ckf32(?aw[0],384)!=ckf32(?as3[0],384)) { mism=mism+1; }
    acc=acc+norm(ckf32(?aw[0],384));

    # predicated bodies, against #[scalar] twins across trip counts
    var prv: [300]i32; var prs: [300]i32; var prd: [300]i32; var pre: [300]i32; var prb: [300]i32; var prc: [300]i32;
    var prqv: [300]u8; var prqs: [300]u8; var prqb: [300]u8; var prqc: [300]u8;
    var prgv: [300]u8; var prgs: [300]u8; var prgdv: [300]u8; var prgds: [300]u8;
    var prwv: [300]u16; var prws: [300]u16; var prwb: [300]u16;
    var prt: i64 = 0;
    for (prt < 4) {
        val n: i64 = trips[prt];
        var i: i64 = 0;
        for (i < 300) {
            prb[i]=((i*37) % 211 - 90)::i32; prc[i]=((i*53) % 197 - 80)::i32;
            prqb[i]=((i*61) % 256)::u8; prqc[i]=((i*29) % 256)::u8;
            prwb[i]=((i*257) % 65536)::u16;
            prv[i]=0-7; prs[i]=0-7; prd[i]=0-7; pre[i]=0-7; prqv[i]=9; prqs[i]=9;
            prgv[i]=9; prgs[i]=9; prgdv[i]=9; prgds[i]=9;
            prwv[i]=13; prws[i]=13;
            i=i+1;
        }
        pclamp_v(?prv[0],?prb[0],n); pclamp_s(?prs[0],?prb[0],n); if(ck32(?prv[0],300)!=ck32(?prs[0],300)){mism=mism+1;}
        pmin_v(?prv[0],?prb[0],?prc[0],n); pmin_s(?prs[0],?prb[0],?prc[0],n); if(ck32(?prv[0],300)!=ck32(?prs[0],300)){mism=mism+1;}
        pu8_v(?prqv[0],?prqb[0],n); pu8_s(?prqs[0],?prqb[0],n); if(cku8(?prqv[0],300)!=cku8(?prqs[0],300)){mism=mism+1;}
        pu16_v(?prwv[0],?prwb[0],n); pu16_s(?prws[0],?prwb[0],n); if(cku16(?prwv[0],300)!=cku16(?prws[0],300)){mism=mism+1;}
        ptwo_v(?prv[0],?prd[0],?prb[0],n); ptwo_s(?prs[0],?pre[0],?prb[0],n);
        if(ck32(?prv[0],300)!=ck32(?prs[0],300)){mism=mism+1;}
        if(ck32(?prd[0],300)!=ck32(?pre[0],300)){mism=mism+1;}
        pcmp_v(?prqv[0],?prqb[0],?prqc[0],n); pcmp_s(?prqs[0],?prqb[0],?prqc[0],n); if(cku8(?prqv[0],300)!=cku8(?prqs[0],300)){mism=mism+1;}
        pguard_v(?prgv[0],?prgdv[0],?prqb[0],n); pguard_s(?prgs[0],?prgds[0],?prqb[0],n);
        if(cku8(?prgv[0],300)!=cku8(?prgs[0],300)){mism=mism+1;}
        if(cku8(?prgdv[0],300)!=cku8(?prgds[0],300)){mism=mism+1;}
        pguardcalc_v(?prv[0],?prb[0],n); pguardcalc_s(?prs[0],?prb[0],n); if(ck32(?prv[0],300)!=ck32(?prs[0],300)){mism=mism+1;}
        parm_v(?prv[0],?prb[0],n); parm_s(?prs[0],?prb[0],n); if(ck32(?prv[0],300)!=ck32(?prs[0],300)){mism=mism+1;}
        acc=acc+norm(ck32(?prv[0],300))+norm(cku8(?prqv[0],300))+norm(cku16(?prwv[0],300))+norm(cku8(?prgv[0],300))+norm(cku8(?prgdv[0],300));
        prt=prt+1;
    }
    # absolute oracles for the narrow widths, computed in i64: a twin pair that a
    # narrow-arithmetic fault moved the same way would agree with each other and
    # disagree here
    var proi: i64 = 0;
    for (proi < 300) { prqb[proi]=(proi % 256)::u8; prqv[proi]=0; proi=proi+1; }
    pu8_v(?prqv[0],?prqb[0],256);
    proi = 0;
    for (proi < 256) {
        var w: i64 = proi % 256;
        if (w > 127) { w = 255; }
        if ((prqv[proi]::i64) != w) { mism = mism + 1; }
        proi=proi+1;
    }
    proi = 0;
    for (proi < 300) { prwb[proi]=((proi*257) % 65536)::u16; prwv[proi]=0; proi=proi+1; }
    pu16_v(?prwv[0],?prwb[0],300);
    proi = 0;
    for (proi < 300) {
        var w: i64 = (proi * 257) % 65536;
        if (w > 300) { w = 65535; }
        if ((prwv[proi]::i64) != w) { mism = mism + 1; }
        proi=proi+1;
    }
    # the aliasing hazard through a predicated body: overlapping dst / src must take
    # the scalar fallback and still match the twin
    var prhv: [130]i32; var prhs: [130]i32;
    var prhj: i64 = 0;
    for (prhj<130){ prhv[prhj]=(prhj*5-60)::i32; prhs[prhj]=(prhj*5-60)::i32; prhj=prhj+1; }
    pclamp_v(?prhv[1], ?prhv[0], 128); pclamp_s(?prhs[1], ?prhs[0], 128);
    if (ck32(?prhv[0],130) != ck32(?prhs[0],130)) { mism = mism + 1; }

    p.printlnf("mismatches={}", mism);
    p.printlnf("acc={}", norm(acc));
    ret 0;
}
