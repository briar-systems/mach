ext fun qz_indirect(value: u32) u32;
ext fun qz_indirect_two(value: u32) u32;
ext fun qz_direct(value: u32) u32;
ext fun qz_keep_winner(value: u32) u32;
ext fun qz_keep_loser(value: u32) u32;

#[symbol("mainCRTStartup")]
pub fun _start() {
    qz_indirect(7);
    qz_indirect_two(7);
    qz_direct(7);
    qz_keep_winner(7);
    qz_keep_loser(7);
}
