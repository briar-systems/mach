# Lane exactness for vectors narrower than the vector register (#2697).
#
# Each shape sets lane `i` to `i + 1`, adds a vector of ones, and sums the lanes.
# For `n` lanes that is `n * (n + 3) / 2`, so a dropped lane changes the total by a
# known amount rather than by a coincidence. The sum is the observable because a
# per-lane print would let a shape pass on the lanes that survived.
#
# THE CONTROLS ARE PART OF THE OBSERVABLE. An earlier probe for this same bug
# packed one bit per shape into the process exit status, which is 8 bits, so the
# shapes past the eighth were silently truncated and the table printed "ok" for a
# shape that was never measured. So this prints a `control-pass` that must read ok
# and a `control-fail` that must read WRONG: if the checker ever reports ok
# unconditionally, the second line catches it, and if the program never runs at all
# the golden diff catches that.

use std.runtime;
use std.types.size.usize;
use std.types.string.str;
use p: std.print;

# guard AFTER the vector: catches a return to the over-wide store, where a 16-byte
# write into a 12-byte field clobbers the neighbour. NOTE this shape PASSES on
# unfixed dev - the truncated store is too short to reach the guard - so it guards
# the opposite regression from Packed2 and neither covers both directions.
rec Packed  { v: i32x3; guard: i32; }

# guard BEFORE the vector: catches the truncation that is live without the fix,
# where the top lane never reaches memory. This is the order that fails on unfixed
# dev, and the issue's own named fixture is the other one.
rec Packed2 { guard: i32; v: i32x3; }

fun report(name: str, got: i64, want: i64) {
    if (got == want) { p.printlnf("{} got={} want={} ok", name, got, want); }
    or              { p.printlnf("{} got={} want={} WRONG", name, got, want); }
}

#[symbol("main")]
fun main(argc: usize, argv: **u8) i64 {
    # the controls, first, so a truncated or empty report is obvious
    report("control-pass", 1, 1);
    report("control-fail", 1, 2);

    # sizes at or below the GP word: these were already correct, because falling
    # back to the GP word only LOSES data once the vector exceeds it
    var a3: i8x3;  a3[0] = 1; a3[1] = 2; a3[2] = 3;
    var b3: i8x3;  b3[0] = 1; b3[1] = 1; b3[2] = 1;
    val c3: i8x3 = a3 + b3;
    report("i8x3", c3[0]::i64 + c3[1]::i64 + c3[2]::i64, 9);

    var d3: i16x3; d3[0] = 1; d3[1] = 2; d3[2] = 3;
    var e3: i16x3; e3[0] = 1; e3[1] = 1; e3[2] = 1;
    val f3: i16x3 = d3 + e3;
    report("i16x3", f3[0]::i64 + f3[1]::i64 + f3[2]::i64, 9);

    var g2: i32x2; g2[0] = 1; g2[1] = 2;
    var h2: i32x2; h2[0] = 1; h2[1] = 1;
    val i2: i32x2 = g2 + h2;
    report("i32x2", i2[0]::i64 + i2[1]::i64, 5);

    var j4: i16x4; j4[0] = 1; j4[1] = 2; j4[2] = 3; j4[3] = 4;
    var k4: i16x4; k4[0] = 1; k4[1] = 1; k4[2] = 1; k4[3] = 1;
    val l4: i16x4 = j4 + k4;
    report("i16x4", l4[0]::i64 + l4[1]::i64 + l4[2]::i64 + l4[3]::i64, 14);

    # THE HOLE: strictly above the GP word and below the vector register. every one
    # of these dropped lanes before the fix.
    var m9: i8x9;
    m9[0] = 1; m9[1] = 2; m9[2] = 3; m9[3] = 4; m9[4] = 5;
    m9[5] = 6; m9[6] = 7; m9[7] = 8; m9[8] = 9;
    var n9: i8x9;
    n9[0] = 1; n9[1] = 1; n9[2] = 1; n9[3] = 1; n9[4] = 1;
    n9[5] = 1; n9[6] = 1; n9[7] = 1; n9[8] = 1;
    val o9: i8x9 = m9 + n9;
    report("i8x9", o9[0]::i64 + o9[1]::i64 + o9[2]::i64 + o9[3]::i64 + o9[4]::i64
                 + o9[5]::i64 + o9[6]::i64 + o9[7]::i64 + o9[8]::i64, 54);

    var q5: i16x5; q5[0] = 1; q5[1] = 2; q5[2] = 3; q5[3] = 4; q5[4] = 5;
    var r5: i16x5; r5[0] = 1; r5[1] = 1; r5[2] = 1; r5[3] = 1; r5[4] = 1;
    val s5: i16x5 = q5 + r5;
    report("i16x5", s5[0]::i64 + s5[1]::i64 + s5[2]::i64 + s5[3]::i64 + s5[4]::i64, 20);

    var t3: i32x3; t3[0] = 1; t3[1] = 2; t3[2] = 3;
    var u3: i32x3; u3[0] = 1; u3[1] = 1; u3[2] = 1;
    val v3: i32x3 = t3 + u3;
    report("i32x3", v3[0]::i64 + v3[1]::i64 + v3[2]::i64, 9);

    var w7: i16x7; w7[0] = 1; w7[1] = 2; w7[2] = 3; w7[3] = 4;
    w7[4] = 5; w7[5] = 6; w7[6] = 7;
    var x7: i16x7; x7[0] = 1; x7[1] = 1; x7[2] = 1; x7[3] = 1;
    x7[4] = 1; x7[5] = 1; x7[6] = 1;
    val y7: i16x7 = w7 + x7;
    report("i16x7", y7[0]::i64 + y7[1]::i64 + y7[2]::i64 + y7[3]::i64
                  + y7[4]::i64 + y7[5]::i64 + y7[6]::i64, 35);

    # a shape that FILLS the register, so the two widths agree. it passed before the
    # fix and must still pass: without it a suite that broke every vector would look
    # the same as one that fixed the narrow ones.
    var z4: i32x4; z4[0] = 1; z4[1] = 2; z4[2] = 3; z4[3] = 4;
    var aa4: i32x4; aa4[0] = 1; aa4[1] = 1; aa4[2] = 1; aa4[3] = 1;
    val ab4: i32x4 = z4 + aa4;
    report("i32x4", ab4[0]::i64 + ab4[1]::i64 + ab4[2]::i64 + ab4[3]::i64, 14);

    # the two neighbour orders, guarding opposite regressions
    var pk: Packed;
    pk.guard = 99;
    pk.v[0] = 1; pk.v[1] = 2; pk.v[2] = 3;
    report("packed-guard-after", pk.guard::i64, 99);

    var pk2: Packed2;
    pk2.guard = 99;
    pk2.v[0] = 7; pk2.v[1] = 8; pk2.v[2] = 9;
    report("packed-guard-before", pk2.v[2]::i64, 9);
    report("packed-guard-before-neighbour", pk2.guard::i64, 99);

    ret 0;
}
