# the constant-pool EMISSION case (#2248, #2700)
#
# every kernel below is written so that WHICH constants it uses decides the golden,
# and so that a change to the interning key or to the per-target cost rule moves a
# number rather than being absorbed.
#
# the constants are chosen deliberately. an "irregular" one (0.1, pi, e) needs
# several MOVZ/MOVK words on aarch64 and several LUI/ADDI/SLLI words on riscv64 and
# has no SSE immediate form at all on x86-64, so all three targets pool it. a
# "regular" one (0.0, and a power of two like 2.0) is either free - x86-64 zeroes a
# register with XORPS, aarch64 and riscv64 read the zero register - or costs one
# instruction plus the bank move, which is what a pooled load costs WITHOUT touching
# memory. those must NOT be pooled, and the zero kernels below are what says so.
#
# `#[scalar]` on every kernel: the auto-vectorizer would otherwise replace the
# scalar float path with packed SIMD and the constants would take a different route.

use std.runtime;
use std.types.size.usize;
use p: std.print;

var zs: [64]f64;

# three distinct irregular f64 constants, each used once: three entries, three
# references
#[scalar]
fun distinct3(x: f64) f64 {
    ret (x * 0.1 + 3.14159265358979) * 2.718281828459045;
}

# ONE irregular constant used four times: the dedup observable. four uses, one
# entry, and the function still names exactly one
#[scalar]
fun repeated(x: f64) f64 {
    ret x * 0.1 + x * 0.1 + (x + 0.1) * 0.1;
}

# the same constant `distinct3` already interned, from another function: a module
# has ONE pool, so this adds no entry. a per-function pool would add three
#[scalar]
fun shared(x: f64) f64 {
    ret x * 0.1 * 3.14159265358979 * 2.718281828459045;
}

# two constants one bit apart. 1.5 is 0x3FF8000000000000 and 0.125 is
# 0x3FC0000000000000; they share every byte but one, so an interning key that
# compared a prefix, a hash, or a truncation rather than the whole image would
# hand both uses one entry and one of the two answers would be wrong. the sibling
# exec case is what catches that, and this line is what says there are two entries
# for it to catch it with.
#
# note that the f32 spelling reaches the back end as an f64 pattern plus an
# explicit narrowing convert - a float literal is not narrowed to its use width
# before lowering - so writing one of these as an f32 would NOT produce a
# four-byte entry. the pool keys on kind and width regardless, because a vector
# constant eight bytes wide can carry an f64's bit pattern exactly.
#[scalar]
fun adjacent(a: f64, b: f64) f64 {
    ret a * 1.5 + b * 0.125;
}

# the cost rule, from the side where the targets DISAGREE. +0.0 is free everywhere
# and is never an entry. 2.0 (0x4000000000000000) is one MOVZ plus a bank move on
# aarch64 and one LUI-class word plus a bank move on riscv64, which a pooled load
# cannot beat, so neither pools it - but x86-64 has no SSE immediate form at all
# and pools it. the goldens differ here on purpose: that difference IS the rule
#[scalar]
fun cheap(x: f64, n: i64) f64 {
    var acc: f64 = 0.0;
    var i: i64 = 0;
    for (i < n) {
        acc = acc + x * 2.0;
        i = i + 1;
    }
    ret acc;
}

# negative zero is 0x8000000000000000: NOT the free zero, and irregular enough to
# pool on every target. it must never share the +0.0 decision, and the exec case
# checks the bit pattern survives
#[scalar]
fun negzero(x: f64) f64 {
    ret (x + -0.0) * -0.0;
}

#[symbol("main")]
fun main(argc: usize, argv: **u8) i64 {
    var i: i64 = 0;
    for (i < 64) {
        zs[i] = (i::f64) + 0.5;
        i = i + 1;
    }
    p.printlnf("distinct3={}", (distinct3(zs[3]) * 1000000.0)::i64);
    p.printlnf("repeated={}", (repeated(zs[5]) * 1000000.0)::i64);
    p.printlnf("shared={}", (shared(zs[7]) * 1000000.0)::i64);
    p.printlnf("adjacent={}", (adjacent(zs[2], zs[9]) * 1000000.0)::i64);
    p.printlnf("cheap={}", (cheap(zs[4], 3) * 1000000.0)::i64);
    p.printlnf("negzero={}", (negzero(zs[6]) * 1000000.0)::i64);
    ret 0;
}
