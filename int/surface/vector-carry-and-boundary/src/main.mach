# Adversarial vector-correctness sweep over axes neither existing vector fixture
# crosses (an audit requested after three silent vector miscompiles - #2687/#2695,
# #2743, #2749 - all shipped with a fully green CI). Two fixtures already cover a
# lot: `vector-subwidth` puts sub-width shapes (i8x3..i32x4) through straight-line
# `+` and a vector-in-struct probe with a SCALAR guard field, but never through a
# loop or a function call. `regression/2749-gap-op-loop-carried` puts a
# loop-carried accumulator through `*` (and one `+`), including nested loops, but
# only at 128-bit shapes (i32x4, i16x8) and only with integer lanes. Every probe
# below is a combination NEITHER of those reaches. Every value is hand-computed;
# see each function's own comment for the arithmetic, and never compare one
# target's output against another's - #2749's own bug had two targets agreeing
# with each other and both being right for reasons unrelated to the defect while
# the third was wrong.
#
# NOT EVERY PROBE HERE HAS TEETH AGAINST #2749. Checked by hand against a compiler
# built from the commit immediately before #2749's fix merged (dev@eb552e2f):
# only `mul_loop3` - #2749's own operator, `*`, loop-carried, at a sub-width shape
# its fixture never tried - actually flips from correct to wrong there, and only
# on `linux` (x86-64); `linux-arm64` and `linux-riscv64` read the right answer
# even pre-fix, for reasons unrelated to the defect (mirroring #2749's own shape,
# just with the "right for the wrong reason" targets swapped - #2749's own i32x4
# case had x86-64 AND riscv64 wrong there, aarch64 right; this sub-width i32x3
# case has ONLY x86-64 wrong, both riscv64 and aarch64 right). Every other probe
# here reads identically correct on the pre-fix compiler too - real, useful
# coverage of combinations nothing else reaches, but not a regression pin, and
# this file does not pretend otherwise.
#
# OVER-WIDTH SHAPES (256-bit+) are refused at the front end on the commit this
# was written against, naming the width in the diagnostic - not attempted here.
# #2805 / #2806 are expected to make them legal; whoever lands that should EXTEND
# the probes below to a wide shape rather than write a new case for it.

use std.runtime;
use std.types.size.usize;
use std.types.string.str;
use p: std.print;

# --- loop-carried accumulators, at shapes/operators #2749's own fixture never
# tried (sub-width, float lanes, bitwise, and a comparison feeding a mask) ---

# THE REGRESSION PIN (see file header): fails on pre-#2749 x86-64.
# a=(2,3,4) b=(2,1,3) n=2: iter1=(4,3,12), iter2=(8,3,36).
fun mul_loop3(a: i32x3, b: i32x3, n: i32) i32x3 {
    var acc: i32x3 = a;
    var i: i32 = 0;
    for (i < n) { acc = acc * b; i = i + 1; }
    ret acc;
}

# a=(10,20,30) b=(1,2,3) n=3 -> a - 3b = (7,14,21).
fun sub_loop3(a: i32x3, b: i32x3, n: i32) i32x3 {
    var acc: i32x3 = a;
    var i: i32 = 0;
    for (i < n) { acc = acc - b; i = i + 1; }
    ret acc;
}

# float lanes through the exact operator #2749 lived in - its own fix and test
# are integer-only. a=(2,3,4) b=(1.5,2.0,0.5) n=2 -> a*b^2 = (4.5,12.0,1.0).
fun mulf_loop3(a: f32x3, b: f32x3, n: i32) f32x3 {
    var acc: f32x3 = a;
    var i: i32 = 0;
    for (i < n) { acc = acc * b; i = i + 1; }
    ret acc;
}

# same operator, float lanes, at the 128-bit width #2749's own fixture used for
# the integer case. a=(1,2,3,4) b=(2.0,0.5,1.5,1.0) n=2 -> a*b^2 =
# (4,0.5,6.75,4).
fun mulf_loop4(a: f32x4, b: f32x4, n: i32) f32x4 {
    var acc: f32x4 = a;
    var i: i32 = 0;
    for (i < n) { acc = acc * b; i = i + 1; }
    ret acc;
}

# bitwise, loop-carried. XOR with the same operand twice cancels, so the
# accumulator must read back as `a` again regardless of how many rounds ran.
fun xor_loop4(a: i32x4, b: i32x4, n: i32) i32x4 {
    var acc: i32x4 = a;
    var i: i32 = 0;
    for (i < n) { acc = acc ^ b; i = i + 1; }
    ret acc;
}

# comparison feeding a mask, loop-carried. a lane-wise `<` yields all-bits-set
# (-1) where true, 0 where false; reinterpreting that as i32x4 and subtracting it
# increments a lane by exactly 1 for as long as it still reads less than `b`, and
# leaves it alone once it does not.
fun cmpadd_loop4(a: i32x4, b: i32x4, n: i32) i32x4 {
    var acc: i32x4 = a;
    var i: i32 = 0;
    for (i < n) {
        val m: u32x4 = acc < b;
        val mi: i32x4 = m::i32x4;
        acc = acc - mi;
        i = i + 1;
    }
    ret acc;
}

# --- call-boundary and aggregate crossings neither existing fixture tries: a
# sub-width vector as both argument and return value, a struct containing one
# returned BY VALUE (not merely constructed locally), two adjacent vector fields
# with no scalar guard between them, a runtime-indexed array of vectors, and
# four vector arguments live in one call ---

fun addv3(a: i32x3, b: i32x3) i32x3 { ret a + b; }
fun roundtrip3(v: i32x3) i32x3 { ret addv3(v, v); }

rec Pt3 { v: i32x3; guard: i32; }
fun make_pt(a: i32, b: i32, c: i32, g: i32) Pt3 {
    var p: Pt3;
    p.v[0] = a; p.v[1] = b; p.v[2] = c;
    p.guard = g;
    ret p;
}

# no scalar guard between the two vector fields, unlike vector-subwidth's own
# probe - strictly stronger, since an over-store here would clobber same-shaped
# data rather than a differently-typed neighbour.
rec TwoV3 { x: i32x3; y: i32x3; }
fun make_twov(a: i32, b: i32, c: i32, d: i32, e: i32, f: i32) TwoV3 {
    var t: TwoV3;
    t.x[0]=a; t.x[1]=b; t.x[2]=c;
    t.y[0]=d; t.y[1]=e; t.y[2]=f;
    ret t;
}

fun sum_lane0(arr: *i32x3, n: i32) i64 {
    var total: i64 = 0;
    var i: i32 = 0;
    for (i < n) { total = total + arr[i][0]::i64; i = i + 1; }
    ret total;
}

fun combine4(a: i32x3, b: i32x3, c: i32x3, d: i32x3) i32x3 {
    val ab: i32x3 = a + b;
    val cd: i32x3 = c + d;
    ret ab - cd;
}

fun report(name: str, got: i64, want: i64) {
    if (got == want) { p.printlnf("{} got={} want={} ok", name, got, want); }
    or              { p.printlnf("{} got={} want={} WRONG", name, got, want); }
}

#[symbol("main")]
fun main(argc: usize, argv: **u8) i64 {
    var a3m: i32x3; a3m[0]=2; a3m[1]=3; a3m[2]=4;
    var b3m: i32x3; b3m[0]=2; b3m[1]=1; b3m[2]=3;
    val r1m: i32x3 = mul_loop3(a3m, b3m, 2);
    report("mul_loop3[0]", r1m[0]::i64, 8);
    report("mul_loop3[1]", r1m[1]::i64, 3);
    report("mul_loop3[2]", r1m[2]::i64, 36);

    var a3: i32x3; a3[0]=10; a3[1]=20; a3[2]=30;
    var b3: i32x3; b3[0]=1; b3[1]=2; b3[2]=3;
    val r1: i32x3 = sub_loop3(a3, b3, 3);
    report("sub_loop3[0]", r1[0]::i64, 7);
    report("sub_loop3[1]", r1[1]::i64, 14);
    report("sub_loop3[2]", r1[2]::i64, 21);

    var af: f32x3; af[0]=2.0::f32; af[1]=3.0::f32; af[2]=4.0::f32;
    var bf: f32x3; bf[0]=1.5::f32; bf[1]=2.0::f32; bf[2]=0.5::f32;
    val r2: f32x3 = mulf_loop3(af, bf, 2);
    report("mulf_loop3[0]", ((r2[0]::f64) * 10.0)::i64, 45);
    report("mulf_loop3[1]", ((r2[1]::f64) * 10.0)::i64, 120);
    report("mulf_loop3[2]", ((r2[2]::f64) * 10.0)::i64, 10);

    var a4f: f32x4; a4f[0]=1.0::f32; a4f[1]=2.0::f32; a4f[2]=3.0::f32; a4f[3]=4.0::f32;
    var b4f: f32x4; b4f[0]=2.0::f32; b4f[1]=0.5::f32; b4f[2]=1.5::f32; b4f[3]=1.0::f32;
    val r4: f32x4 = mulf_loop4(a4f, b4f, 2);
    report("mulf_loop4[0]", ((r4[0]::f64) * 10.0)::i64, 40);
    report("mulf_loop4[1]", ((r4[1]::f64) * 10.0)::i64, 5);
    report("mulf_loop4[2]", ((r4[2]::f64) * 10.0)::i64, 67);
    report("mulf_loop4[3]", ((r4[3]::f64) * 10.0)::i64, 40);

    var ax: i32x4; ax[0]=240; ax[1]=255; ax[2]=15; ax[3]=170;
    var bx: i32x4; bx[0]=15; bx[1]=255; bx[2]=240; bx[3]=85;
    val r5: i32x4 = xor_loop4(ax, bx, 2);
    report("xor_loop4[0]", r5[0]::i64, 240);
    report("xor_loop4[1]", r5[1]::i64, 255);
    report("xor_loop4[2]", r5[2]::i64, 15);
    report("xor_loop4[3]", r5[3]::i64, 170);

    var ac: i32x4; ac[0]=1; ac[1]=5; ac[2]=3; ac[3]=9;
    var bc: i32x4; bc[0]=2; bc[1]=2; bc[2]=3; bc[3]=2;
    val r6: i32x4 = cmpadd_loop4(ac, bc, 2);
    report("cmpadd_loop4[0]", r6[0]::i64, 2);
    report("cmpadd_loop4[1]", r6[1]::i64, 5);
    report("cmpadd_loop4[2]", r6[2]::i64, 3);
    report("cmpadd_loop4[3]", r6[3]::i64, 9);

    var v3: i32x3; v3[0]=5; v3[1]=7; v3[2]=9;
    val r3: i32x3 = roundtrip3(v3);
    report("roundtrip3[0]", r3[0]::i64, 10);
    report("roundtrip3[1]", r3[1]::i64, 14);
    report("roundtrip3[2]", r3[2]::i64, 18);

    val pt: Pt3 = make_pt(11, 22, 33, 77);
    report("make_pt.v0", pt.v[0]::i64, 11);
    report("make_pt.v1", pt.v[1]::i64, 22);
    report("make_pt.v2", pt.v[2]::i64, 33);
    report("make_pt.guard", pt.guard::i64, 77);

    val tv: TwoV3 = make_twov(1, 2, 3, 4, 5, 6);
    report("twov.x0", tv.x[0]::i64, 1);
    report("twov.x1", tv.x[1]::i64, 2);
    report("twov.x2", tv.x[2]::i64, 3);
    report("twov.y0", tv.y[0]::i64, 4);
    report("twov.y1", tv.y[1]::i64, 5);
    report("twov.y2", tv.y[2]::i64, 6);

    var arr: [3]i32x3;
    arr[0][0]=1;   arr[0][1]=2;   arr[0][2]=3;
    arr[1][0]=10;  arr[1][1]=20;  arr[1][2]=30;
    arr[2][0]=100; arr[2][1]=200; arr[2][2]=300;
    val lane0sum: i64 = sum_lane0(?arr[0], 3);
    report("arr_lane0_sum", lane0sum, 111);

    var va: i32x3; va[0]=100; va[1]=200; va[2]=300;
    var vb: i32x3; vb[0]=1;   vb[1]=2;   vb[2]=3;
    var vc: i32x3; vc[0]=10;  vc[1]=20;  vc[2]=30;
    var vd: i32x3; vd[0]=5;   vd[1]=5;   vd[2]=5;
    val r8: i32x3 = combine4(va, vb, vc, vd);
    report("combine4[0]", r8[0]::i64, 86);
    report("combine4[1]", r8[1]::i64, 177);
    report("combine4[2]", r8[2]::i64, 268);

    ret 0;
}
