# an integer input a vertex stage and a fragment stage both read
#
# This is the shape #2747's acceptance asked to VALIDATE, and it cannot: Vulkan
# requires a Flat decoration on a fragment stage's integer input
# (VUID-StandaloneSpirv-Flat-04744) and forbids one on a vertex stage's
# (VUID-StandaloneSpirv-Flat-06202). There is no decoration that satisfies both, so
# there is no valid module for this program and "decorate every integer input"
# would have emitted one that fails on the vertex side instead of the fragment one.
#
# It is refused rather than silently decorated because the two readings are not the
# same value: a vertex stage's input is a vertex ATTRIBUTE the pipeline feeds from a
# buffer, and a fragment stage's input is the interpolated output of the stage
# before it. One variable spelling both is the author having conflated them, and the
# fix is two declarations.

#[input(0)]  var idx: i32;
#[output(0)] var col: f32x4;
#[builtin("position")] var position: f32x4;

#[stage("vertex")]
fun vert() { position = f32x4{idx::f32, 0.0, 0.0, 1.0}; }

#[stage("fragment")]
fun frag() { col = f32x4{idx::f32, 1.0, 1.0, 1.0}; }

fun main() i32 { ret 0; }
