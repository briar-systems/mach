# a handle declared where it cannot live (#2888)
#
# The control is `albedo`: a handle bound exactly as `spirv-sampled-image` binds it,
# and read by a stage, so it is genuinely live rather than merely present. Every
# declaration after it differs from that one in ONE property.

#[handle("spirv", "image", 0, 1, 0, 0, 0, 1)]
pub def Texture2D;
#[handle("spirv", "sampled_image", Texture2D)]
pub def Sampler2D;

#[sampler(0, 0)] var albedo: Sampler2D;

#[input(0)]  var in_uv:      f32x2;
#[output(0)] var out_colour: f32x4;

#[op("spirv", "core", "OpImageSampleImplicitLod")]
fun sample2(s: Sampler2D, uv: f32x2) f32x4;

#[stage("fragment")]
fun frag_main() {
    out_colour = sample2(albedo, in_uv);
}

# REFUSED: a handle with no descriptor to bind it. A shader has no general global
# storage, so this declaration would be reachable from no stage.
var unbound: Sampler2D;

# REFUSED: a `#[sampler]` on a type that is not a handle. It would otherwise be
# emitted as a UniformConstant variable of an ordinary type, which is a different
# descriptor than the block the author meant.
#[sampler(1, 0)] var not_a_handle: f32x4;

# REFUSED: a handle carrying another interface role, which addresses it to a
# storage class no handle may live in. Its own sentence, separate from the unbound
# one: the author DID address this to the pipeline, just to the wrong part of it.
#[input(7)] var wrong_role: Sampler2D;

# REFUSED: a handle behind a pointer. A pointer is an extent the program computes,
# and a handle's extent is the target's, so this is not a shape that could be
# emitted differently.
#[sampler(1, 1)] var indirect: *Sampler2D;

# REFUSED: an array of handles - a descriptor array, which is its own feature and
# not a thing this cut silently flattens.
#[sampler(1, 2)] var atlas: [4]Sampler2D;

# REFUSED: a handle as a record or union field. A record is storage the program owns
# at offsets it can compute, and a handle's representation is not the program's, so
# the block this record would become has no layout at all - and before this rule the
# module compiled clean and was rejected by a validator naming an `OpTypeStruct`
# operand rather than the field that caused it.
rec Material {
    map:   Sampler2D;
    tint:  f32x4;
}
uni Either {
    tex: Texture2D;
    f:   f32;
}

# REFUSED: a handle named as a local. A local is storage the program owns, and a
# handle's representation is not the program's, so the local has nothing that may be
# written into it - which is why the sampled-image case hands a combined handle
# straight to the operation that consumes it rather than binding it to a name first.
fun local_handle() f32x4 {
    val held: Sampler2D = albedo;
    ret sample2(held, in_uv);
}

fun main() i32 {
    ret 0;
}
