# SPIR-V sub-width vector fixture: a vector narrower than 128 bits delivers a
# valid `.spv`
#
# The sibling spirv-vector case covers only shapes that are exactly one 128-bit
# register, and says so. Every function here is a shape that is NOT, which is the
# whole subject: the lane count of the module's result type has to be the
# vector's own, and nothing else in the pipeline names it.
#
# WHY THIS CASE EXISTS. `mir.MirInstr.vec_lane` used to carry a lane class and an
# element byte-width and DERIVE the count as `16 / element-bytes`. That is right
# for f32x4, f64x2, i32x4 and the other seven 128-bit shapes and wrong for every
# shape below, so `a + b` on an `f32x3` emitted `OpFAdd %v4float` inside a
# function typed `%v3float` - a module that builds clean and that spirv-val
# rejects (#2743). Every 128-bit case stayed green throughout, because the
# derivation and the tests agreed with each other.
#
# spirv-val is the observable, not our own expectations. A mistyped result here
# is a validator error, not a diff against a golden we wrote from the emitter.
#
# THE OTHER TARGETS CANNOT COVER THIS. A machine back end picks an instruction
# from the lane CLASS and WIDTH and writes a whole register, so it never reads a
# lane count and was correct on the bug. SPIR-V is the only target that must name
# the vector type, so it is the only one where the count is observable at all.

# --- arithmetic -------------------------------------------------------------
# the repro from #2743, and its 2-lane and integer siblings. each result type
# must be the operand type; a derived count makes every one of these a v4.
fun add3(a: f32x3, b: f32x3) f32x3 { ret a + b; }
fun sub3(a: f32x3, b: f32x3) f32x3 { ret a - b; }
fun mul2(a: f32x2, b: f32x2) f32x2 { ret a * b; }
fun div2(a: f32x2, b: f32x2) f32x2 { ret a / b; }
fun iadd2(a: i32x2, b: i32x2) i32x2 { ret a + b; }
fun iadd3(a: u32x3, b: u32x3) u32x3 { ret a + b; }

# bitwise on integer lanes, which have no float form and so select a different
# opcode off the same descriptor.
fun bits2(a: i32x2, b: i32x2) i32x2 { ret (a & b) | (a ^ b); }
fun bits3(a: u32x3, b: u32x3) u32x3 { ret a & b; }

# a chain, so a mistyped intermediate cannot be absorbed by the return type.
fun chain3(a: f32x3, b: f32x3) f32x3 { ret (a + b) * (a - b); }

# --- compare to mask --------------------------------------------------------
# mach's comparison yields a same-shape UNSIGNED mask vector, and the emitter
# reaches it through a SPIR-V boolean vector plus an OpSelect. That is three
# vector types at once - the operands', the intermediate bvec, and the mask - and
# all three must carry the same count as the source.
fun mask_lt3(a: f32x3, b: f32x3) u32x3 { ret a < b; }
fun mask_eq3(a: f32x3, b: f32x3) u32x3 { ret a == b; }
fun mask_lt2(a: f32x2, b: f32x2) u32x2 { ret a < b; }
fun mask_int2(a: i32x2, b: i32x2) u32x2 { ret a < b; }
fun mask_int3(a: u32x3, b: u32x3) u32x3 { ret a < b; }

# a mask consumed by more vector work, so the mask's own type is load-bearing
# rather than only a return type.
fun masked3(a: u32x3, b: u32x3) u32x3 { ret (a < b) & a; }

# --- lane read --------------------------------------------------------------
# a lane read is the one vector-tagged instruction whose result is a SCALAR, so
# it reads the descriptor for the vector it indexes rather than for what it
# produces. The last lane is the interesting one: it does not exist in the
# 4-lane type a derived count would have named for an f32x3.
fun lane3_last(v: f32x3) f32 { ret v[2]; }
fun lane2_last(v: f32x2) f32 { ret v[1]; }
fun lane_int3(v: u32x3) u32 { ret v[2]; }
fun horizontal3(v: f32x3) f32 { ret v[0] + v[1] + v[2]; }

# --- lane write -------------------------------------------------------------
# OpCompositeInsert is functional: it takes the whole vector and yields another
# of the same type, so both the source and the result carry the count.
fun set_lane3(v: f32x3, x: f32) f32x3 {
    var r: f32x3 = v;
    r[1] = x;
    ret r;
}

fun set_last3(v: f32x3, x: f32) f32x3 {
    var r: f32x3 = v;
    r[2] = x;
    ret r;
}

fun set_lane2(v: f32x2, x: f32) f32x2 {
    var r: f32x2 = v;
    r[0] = x;
    ret r;
}

fun set_int3(v: u32x3, x: u32) u32x3 {
    var r: u32x3 = v;
    r[2] = x;
    ret r;
}

# a lane read feeding a lane write on the same vector, mixing the scalar and
# vector type families through one variable map.
fun rescale3(v: f32x3) f32x3 {
    var r: f32x3 = v;
    r[2] = v[0] * 2.0;
    ret r;
}

# --- construction -----------------------------------------------------------
# OpCompositeConstruct takes exactly as many lanes as the type has. This was the
# one site that NOTICED the derived count, because it counts operands - and it
# reported the mismatch as an internal compiler error with no source location,
# so a 3-lane literal was the single shape that failed loudly.
fun literal3() f32x3 { ret f32x3{1.0, 2.0, 3.0}; }
fun literal2() f32x2 { ret f32x2{1.0, 2.0}; }
fun broadcast3(t: f32) f32x3 { ret f32x3{t, t, t}; }
fun scaled3(v: f32x3, k: f32) f32x3 { ret v * f32x3{k, k, k}; }
fun literal_int3() u32x3 { ret u32x3{1, 2, 3}; }

# --- default-zeroed locals -------------------------------------------------
# `var z: f32x3;` with no initializer, which was refused on this target as
# addressed memory at every READ of the slot while the initialized twin beside it
# was fine (#2758). A declaration without an initializer takes the aggregate branch
# and zeroes the slot, and the sub-width vector memory round trip then rewrote the
# access into a scratch slot walked in 8/4/2/1 chunks - a lowering for a
# byte-addressed machine, running on a target that has no byte addresses. Every
# shape narrower than 16 bytes was refused and no shape that is 16 was, which is
# what named the round trip rather than the zeroing.
#
# The expected module is what `f32x4` already produced: one Function-storage
# OpVariable of the vector's OWN type holding OpConstantNull, and ordinary OpLoads
# of it.
fun zeroed3() f32x3 { var z: f32x3; ret z; }
fun zeroed2() f32x2 { var z: f32x2; ret z; }
fun zeroed_int2() i32x2 { var z: i32x2; ret z; }
fun zeroed_int3() u32x3 { var z: u32x3; ret z; }

# the zero READ lane by lane and written to, which are the two other operations the
# issue measured as refused on the same slot.
fun zeroed_lane3() f32 { var z: f32x3; ret z[0] + z[1] + z[2]; }
fun zeroed_write3(x: f32) f32x3 { var z: f32x3; z[0] = x; ret z; }

# the zero feeding arithmetic against a real value, so the slot is genuinely loaded
# rather than folded away as a constant the emitter never has to name.
fun zeroed_add3(v: f32x3) f32x3 { var z: f32x3; ret z + v; }

# --- across control flow and calls ------------------------------------------
# the copies a lowered `if` / `for` leaves on its phi edges are emitted from the
# instruction's own type, so a sub-width vector that survives straight-line code
# can still come out scalar-typed here.
fun select3(a: f32x3, b: f32x3, t: i32) f32x3 {
    if (t > 0) { ret a + b; }
    ret a - b;
}

fun accumulate3(seed: f32x3, step: f32x3, n: i32) f32x3 {
    var acc: f32x3 = seed;
    var i: i32 = 0;
    for (i < n) {
        acc = acc + step;
        i = i + 1;
    }
    ret acc;
}

fun composed3(a: f32x3, b: f32x3) f32x3 {
    ret mul3(add3(a, b), a);
}

fun mul3(a: f32x3, b: f32x3) f32x3 { ret a * b; }

# --- local aggregates of sub-width vectors ----------------------------------
# a local array and a local record of sub-width vectors, which were unusable for
# exactly the same reason as the bare uninitialized local: declaring one zero-inits
# it (#2758). The element type is what makes these different from the 128-bit
# `[4]f32x4` in the sibling spirv-vector case - a slot of `f32x3` has a memory
# footprint its register does not share, and that is the inequality the round trip
# keyed on.
fun rows3(v: f32x3) f32x3 {
    var rows: [4]f32x3;
    rows[0] = v;
    rows[3] = v + v;
    ret rows[0] * rows[3];
}

rec Frame {
    right: f32x3;
    up:    f32x3;
    uv:    f32x2;
}

fun frame3(a: f32x3, b: f32x3) f32x3 {
    var f: Frame;
    f.right = a;
    f.up    = b;
    ret f.right - f.up;
}

# the record read back WITHOUT ever being written, so the zero itself is the value
# that reaches the return rather than something that overwrote it.
fun frame_zero() f32x2 {
    var f: Frame;
    ret f.uv;
}

fun main() i32 {
    ret 0;
}
