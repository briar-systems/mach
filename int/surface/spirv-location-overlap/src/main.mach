# two outputs at locations one apart, the first of which takes two locations
#
# A location carries four 32-bit components, so a record of two `f32x4` members
# flattens to two of them: `#[output(0)]` runs through location 1, and the
# `#[output(1)]` beside it starts inside that span. The declaration reads as
# obviously fine and is not, which is the whole reason mach computes the span
# rather than trusting the numbers.
#
# The overlap is checked PER STAGE and per direction. Two variables at the same
# location in different stages are two different assignments, and an input and an
# output at the same location are two different spaces, so neither is a collision -
# a module-wide check would refuse programs that are correct.

rec Pair { a: f32x4; b: f32x4; }

#[output(0)] var wide: Pair;
#[output(1)] var col:  f32x4;

#[builtin("position")] var position: f32x4;

#[stage("vertex")]
fun v() {
    position = f32x4{0.0, 0.0, 0.0, 1.0};
    wide.a = position;
    col = position;
}

fun main() i32 { ret 0; }
