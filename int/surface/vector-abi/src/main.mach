# A sub-register-width vector across a call boundary (#2687).
#
# Every observable is a value that made a real call and came back. The controls come
# first, because a report that says "ok" unconditionally and a program that never ran
# both look like a green suite otherwise: `control-fail` MUST read WRONG, and the
# golden diff catches a run that produced nothing.
#
# The arithmetic behind each `want` is written out beside it, so a wrong expectation
# cannot quietly become the definition of correct.

use std.runtime;
use std.types.size.usize;
use std.types.string.str;
use p: std.print;

# a vector field with a scalar field after it, and one with a scalar field before it:
# opposite neighbour orders, guarding opposite regressions
rec Vertex { pos: f32x3; uv: f32x2; guard: i32; }
rec Packed { guard: i32; v: i32x3; }

fun report(name: str, got: i64, want: i64) {
    if (got == want) { p.printlnf("{} got={} want={} ok", name, got, want); }
    or              { p.printlnf("{} got={} want={} WRONG", name, got, want); }
}

# EVERY CALLEE UNDER TEST IS `#[noinline]`. At opt 2 the inliner otherwise deletes
# the call this case exists to exercise, and the release profile then reports green
# on a program that never placed an argument at all - measured, not assumed: with the
# stack half of the fix reverted, `many` reads WRONG on the debug profile and ok on
# the release one.
#[noinline]
fun addf3(a: f32x3, b: f32x3) f32x3 { ret a + b; }
#[noinline]
fun addi3(a: i32x3, b: i32x3) i32x3 { ret a + b; }

# a register-passed vector with a scalar argument on each side
#[noinline]
fun guarded(g0: i32, v: i32x3, g1: i32) i64 {
    ret g0::i64 * 1000000 + (v[0]::i64 * 10000 + v[1]::i64 * 100 + v[2]::i64) * 10 + g1::i64;
}

# ten vectors and six integers: the vector register file is eight deep under SysV,
# win64 and AAPCS64 alike, so v8 and v9 are STACK-passed, each with a scalar guard
# packed on either side of it
#[noinline]
fun many(a0: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64,
         v0: i32x3, v1: i32x3, v2: i32x3, v3: i32x3, v4: i32x3,
         v5: i32x3, v6: i32x3, v7: i32x3,
         g1: i32, v8: i32x3, g2: i32, v9: i32x3, g3: i32) i64 {
    var sum: i64 = 0;
    sum = sum + v0[0]::i64 + v0[1]::i64 + v0[2]::i64;
    sum = sum + v1[0]::i64 + v1[1]::i64 + v1[2]::i64;
    sum = sum + v2[0]::i64 + v2[1]::i64 + v2[2]::i64;
    sum = sum + v3[0]::i64 + v3[1]::i64 + v3[2]::i64;
    sum = sum + v4[0]::i64 + v4[1]::i64 + v4[2]::i64;
    sum = sum + v5[0]::i64 + v5[1]::i64 + v5[2]::i64;
    sum = sum + v6[0]::i64 + v6[1]::i64 + v6[2]::i64;
    sum = sum + v7[0]::i64 + v7[1]::i64 + v7[2]::i64;
    sum = sum + v8[0]::i64 + v8[1]::i64 + v8[2]::i64;
    sum = sum + v9[0]::i64 + v9[1]::i64 + v9[2]::i64;
    ret sum * 1000 + a0 + a1 + a2 + a3 + a4 + a5
        + g1::i64 * 100 + g2::i64 * 10 + g3::i64;
}

#[noinline]
fun vert_sum(vt: Vertex) i64 {
    ret vt.pos[0]::i64 * 100000 + vt.pos[1]::i64 * 10000 + vt.pos[2]::i64 * 1000
      + vt.uv[0]::i64 * 100 + vt.uv[1]::i64 * 10 + vt.guard::i64;
}

#[noinline]
fun make_vert(g: i32) Vertex {
    var vt: Vertex;
    vt.pos[0] = 1.0; vt.pos[1] = 2.0; vt.pos[2] = 3.0;
    vt.uv[0] = 4.0; vt.uv[1] = 5.0;
    vt.guard = g;
    ret vt;
}

#[noinline]
fun packed_sum(pk: Packed) i64 {
    ret pk.guard::i64 * 1000 + pk.v[0]::i64 * 100 + pk.v[1]::i64 * 10 + pk.v[2]::i64;
}

#[noinline]
fun make_packed() Packed {
    var pk: Packed;
    pk.guard = 9;
    pk.v[0] = 1; pk.v[1] = 2; pk.v[2] = 3;
    ret pk;
}

fun mkf3(a: f32, b: f32, c: f32) f32x3 { var v: f32x3; v[0] = a; v[1] = b; v[2] = c; ret v; }
fun mki3(a: i32, b: i32, c: i32) i32x3 { var v: i32x3; v[0] = a; v[1] = b; v[2] = c; ret v; }

#[symbol("main")]
fun main(argc: usize, argv: **u8) i64 {
    report("control-pass", 1, 1);
    report("control-fail", 1, 2);

    # passed by value and returned by value: every lane read individually, so a shape
    # that survives on a sum of lanes but transposes them cannot pass
    val f: f32x3 = addf3(mkf3(1.0, 2.0, 3.0), mkf3(10.0, 20.0, 30.0));
    report("f32x3-lane0", f[0]::i64, 11);
    report("f32x3-lane1", f[1]::i64, 22);
    report("f32x3-lane2", f[2]::i64, 33);

    val i: i32x3 = addi3(mki3(1, 2, 3), mki3(10, 20, 30));
    report("i32x3-lane0", i[0]::i64, 11);
    report("i32x3-lane1", i[1]::i64, 22);
    report("i32x3-lane2", i[2]::i64, 33);

    # a returned vector feeding straight into the next call, so the value is handed
    # from a return register to an argument register without a memory round trip
    val g: f32x3 = addf3(addf3(mkf3(1.0, 1.0, 1.0), mkf3(2.0, 2.0, 2.0)), mkf3(4.0, 4.0, 4.0));
    report("f32x3-chained", g[0]::i64 * 100 + g[1]::i64 * 10 + g[2]::i64, 777);

    # 7 * 1000000 + (1*10000 + 2*100 + 3) * 10 + 9 = 7000000 + 102030 + 9
    report("guarded", guarded(7, mki3(1, 2, 3), 9), 7102039);

    # lanes: 8 * 3 + (2+3+4) + (6+7+8) = 24 + 9 + 21 = 54
    # scalars: 1+2+3+4+5+6 = 21, guards: 4*100 + 5*10 + 6 = 456
    val m: i64 = many(1, 2, 3, 4, 5, 6,
                      mki3(1, 1, 1), mki3(1, 1, 1), mki3(1, 1, 1), mki3(1, 1, 1),
                      mki3(1, 1, 1), mki3(1, 1, 1), mki3(1, 1, 1), mki3(1, 1, 1),
                      4, mki3(2, 3, 4), 5, mki3(6, 7, 8), 6);
    report("many", m, 54477);

    # a 20-byte record whose first field is a vector, returned by value and passed
    # by value; its trailing scalar is the guard
    val vt: Vertex = make_vert(6);
    report("vertex-roundtrip", vert_sum(vt), 123456);
    report("vertex-direct", vert_sum(make_vert(6)), 123456);

    # the other neighbour order: the scalar comes FIRST and the vector is packed
    # against it
    val pk: Packed = make_packed();
    report("packed-roundtrip", packed_sum(pk), 9123);
    report("packed-guard", pk.guard::i64, 9);
    report("packed-lane2", pk.v[2]::i64, 3);

    ret 0;
}
