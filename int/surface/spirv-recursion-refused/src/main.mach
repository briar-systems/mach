# direct recursion in a library module
#
# A SPIR-V execution model has no call stack, so a function may not be reachable
# from itself. That is a rule about the MODULE - its call graph - rather than about
# any one instruction, and before #2748 there was no module-level check for it to
# live in: the emitter walked functions and emitted them, and this file produced a
# module with no diagnostic at all.
#
# The refusal names the chain rather than only its existence, because a mutual cycle
# through several helpers is the case where "there is a cycle somewhere" costs the
# reader the most, and it says why in one clause, because "no recursion" is
# surprising to anyone who has not read the SPIR-V execution model.
#
# `spirv-module` keeps the acyclic side: a deep call chain and a forward reference
# to a function defined later both still build, so this is a cycle detection and
# not a depth limit.

fun fact(n: i32) i32 {
    if (n <= 1) { ret 1; }
    ret n * fact(n - 1);
}

fun main() i32 { ret fact(5); }
