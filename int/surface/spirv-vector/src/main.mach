# SPIR-V vector fixture: 128-bit vector work delivers a valid `.spv`
#
# SPIR-V is one of the two targets that has real vectors rather than a scalar
# expansion of them, so the spirv target declares a vector unit and vectors reach
# the emitter intact. `OpTypeVector` is the point of this case, and the external
# Khronos validator is the observable, as in the sibling spirv-module and
# spirv-float cases.
#
# WHAT IS NOT HERE, and why: a vector LITERAL (`f32x4{1.0, 2.0, 3.0, 4.0}`) and an
# uninitialized vector local. Both lower to an `alloca [4]f32` written lane by lane
# and then read back with a whole-vector `load f32x4` - reinterpreting an array
# allocation as a vector through its pointer. SPIR-V's logical addressing model
# cannot express that at all: a pointer there has exactly one pointee type and
# there is no pointer bitcast. That is a lowering to fix ahead of the back end, not
# an emitter gap, so the backend refuses it by name and this case builds its
# vectors from parameters instead. When the lowering stops going through memory,
# the literal cases belong here.
#
# Also absent by construction: `i8x16` / `u8x16` and `i16x8` / `u16x8`. Every mach
# vector is 128 bits, so those need 16 and 8 components, and a Shader module's
# vector holds at most 4 - 8 and 16 require the Vector16 capability, which only a
# Kernel module may declare. The backend names those four types in its refusal.

fun add4(a: f32x4, b: f32x4) f32x4 { ret a + b; }
fun sub4(a: f32x4, b: f32x4) f32x4 { ret a - b; }
fun mul4(a: f32x4, b: f32x4) f32x4 { ret a * b; }
fun div4(a: f32x4, b: f32x4) f32x4 { ret a / b; }

# f64x2 exercises the other float lane width, and the 2-component vector shape.
fun add2(a: f64x2, b: f64x2) f64x2 { ret a + b; }
fun mix2(a: f64x2, b: f64x2) f64x2 { ret (a * b) - (a / b); }

# integer lanes at both Shader-legal widths. these select the integer opcodes off
# the same shared MIR opcodes the float lanes ride, so a class mix-up here shows up
# as a validator type error rather than as silence.
fun iadd4(a: i32x4, b: i32x4) i32x4 { ret a + b; }
fun isub2(a: i64x2, b: i64x2) i64x2 { ret a - b; }

# bitwise on integer lanes, which have no float form at all.
fun bits4(a: u32x4, b: u32x4) u32x4 { ret (a & b) | (a ^ b); }
fun bits2(a: i64x2, b: i64x2) i64x2 { ret a & b; }

# lane-wise comparison. mach defines the result as a same-shape unsigned MASK
# vector (all-ones / all-zeros lanes), while SPIR-V's compare yields a vector of
# booleans, so the emitter widens through an OpSelect. That reconciliation is the
# most target-specific thing in this file and the easiest to get quietly wrong: a
# raw boolean vector would still validate, as a narrower type than mach declared.
fun mask_lt(a: f32x4, b: f32x4) u32x4 { ret a < b; }
fun mask_eq(a: f32x4, b: f32x4) u32x4 { ret a == b; }
fun mask_ne(a: f32x4, b: f32x4) u32x4 { ret a != b; }
fun mask_le(a: f32x4, b: f32x4) u32x4 { ret a <= b; }
fun mask_gt(a: f32x4, b: f32x4) u32x4 { ret a > b; }
fun mask_int(a: i32x4, b: i32x4) u32x4 { ret a < b; }
fun mask_wide(a: f64x2, b: f64x2) u64x2 { ret a < b; }

# lane reads at every index of a 4-lane vector, and at both indices of a 2-lane
# one. the lane index is a compile-time constant by the language's rule, so these
# are literal-index composite extracts.
fun lane0(v: f32x4) f32 { ret v[0]; }
fun lane3(v: f32x4) f32 { ret v[3]; }
fun horizontal(v: f32x4) f32 { ret v[0] + v[1] + v[2] + v[3]; }
fun lane_wide(v: f64x2) f64 { ret v[1]; }
fun lane_int(v: i32x4) i32 { ret v[2]; }

# lane writes, onto a vector derived from a parameter so nothing is materialized
# out of thin air.
fun set_lane(v: f32x4, x: f32) f32x4 {
    var r: f32x4 = v;
    r[1] = x;
    ret r;
}

fun set_all(v: f32x4, x: f32) f32x4 {
    var r: f32x4 = v;
    r[0] = x;
    r[1] = x;
    r[2] = x;
    r[3] = x;
    ret r;
}

# a scalar read back out of a vector, scaled, and written into another lane: mixes
# the vector and scalar type families through one variable map.
fun rescale(v: f32x4) f32x4 {
    var r: f32x4 = v;
    r[3] = v[0] * 2.0;
    ret r;
}

# vectors carried across the structured control flow the emitter reconstructs. the
# phi edge copies a lowered `if` / `for` leaves behind are emitted at the machine
# word, so a vector whose copy destination came out scalar-typed would fail here
# rather than in straight-line code.
fun select4(a: f32x4, b: f32x4, t: i32) f32x4 {
    if (t > 0) { ret a + b; }
    ret a - b;
}

fun accumulate(seed: f32x4, step: f32x4, n: i32) f32x4 {
    var acc: f32x4 = seed;
    var i: i32 = 0;
    for (i < n) {
        acc = acc + step;
        i = i + 1;
    }
    ret acc;
}

fun sifted(seed: i32x4, step: i32x4, n: i32) i32x4 {
    var acc: i32x4 = seed;
    var i: i32 = 0;
    for (i < n) {
        i = i + 1;
        if (i % 3 == 0) { cnt; }
        if (i > 32) { brk; }
        acc = acc + step;
    }
    ret acc;
}

# a vector through a direct call chain, including a call whose argument is another
# call's vector result.
fun composed(a: f32x4, b: f32x4) f32x4 {
    ret mul4(add4(a, b), div4(a, b));
}

fun main() i32 {
    ret 0;
}
