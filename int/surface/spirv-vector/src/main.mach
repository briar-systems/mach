# SPIR-V vector fixture: 128-bit vector work delivers a valid `.spv`
#
# SPIR-V is one of the two targets that has real vectors rather than a scalar
# expansion of them, so the spirv target declares a vector unit and vectors reach
# the emitter intact. `OpTypeVector` is the point of this case, and the external
# Khronos validator is the observable, as in the sibling spirv-module and
# spirv-float cases.
#
# VECTOR LITERALS AND UNINITIALIZED LOCALS ARE HERE. They were absent while a
# literal round-tripped through an array allocation reinterpreted as a vector,
# which logical addressing cannot express. Three upstream changes removed that:
# the allocation is now made at the vector's own type (#2640), a slot records the
# type it was allocated at (#2673), and `memzero` survives as a whole-object
# operation instead of a run of byte stores (#2669). A local allocation is now a
# Function-storage `OpVariable`, a zero-init is one `OpStore` of `OpConstantNull`,
# and a literal's per-lane writes are `OpAccessChain` from the ordinals MIR keeps.
#
# The broadcast case below is the one to keep. `f32x4{t, t, t, t}` is the only way
# to scale a vector by a computed scalar, because the language has no implicit
# scalar-to-vector conversion and no vector-by-scalar operator - so while literals
# were refused there was NO way to express the most common shader operation after
# add and multiply. A constant-lane literal alone would not have covered it.
#
# Also absent by construction: `i8x16` / `u8x16` and `i16x8` / `u16x8`. Those need
# 16 and 8 components, and a Shader module's vector holds at most 4 - 8 and 16
# require the Vector16 capability, which only a Kernel module may declare. The
# backend names those four types in its refusal.
#
# EVERY SHAPE HERE IS EXACTLY 128 BITS, which is a limit of this case rather than a
# rule of the language. Sub-register-width shapes live in the sibling
# spirv-vector-narrow case: they were mistyped for as long as this file was the
# only vector coverage, and a suite of 128-bit shapes cannot see that (#2743).

fun add4(a: f32x4, b: f32x4) f32x4 { ret a + b; }
fun sub4(a: f32x4, b: f32x4) f32x4 { ret a - b; }
fun mul4(a: f32x4, b: f32x4) f32x4 { ret a * b; }
fun div4(a: f32x4, b: f32x4) f32x4 { ret a / b; }

# f64x2 exercises the other float lane width, and the 2-component vector shape.
fun add2(a: f64x2, b: f64x2) f64x2 { ret a + b; }
fun mix2(a: f64x2, b: f64x2) f64x2 { ret (a * b) - (a / b); }

# integer lanes at both Shader-legal widths. these select the integer opcodes off
# the same shared MIR opcodes the float lanes ride, so a class mix-up here shows up
# as a validator type error rather than as silence.
fun iadd4(a: i32x4, b: i32x4) i32x4 { ret a + b; }
fun isub2(a: i64x2, b: i64x2) i64x2 { ret a - b; }

# bitwise on integer lanes, which have no float form at all.
fun bits4(a: u32x4, b: u32x4) u32x4 { ret (a & b) | (a ^ b); }
fun bits2(a: i64x2, b: i64x2) i64x2 { ret a & b; }

# lane-wise comparison. mach defines the result as a same-shape unsigned MASK
# vector (all-ones / all-zeros lanes), while SPIR-V's compare yields a vector of
# booleans, so the emitter widens through an OpSelect. That reconciliation is the
# most target-specific thing in this file and the easiest to get quietly wrong: a
# raw boolean vector would still validate, as a narrower type than mach declared.
fun mask_lt(a: f32x4, b: f32x4) u32x4 { ret a < b; }
fun mask_eq(a: f32x4, b: f32x4) u32x4 { ret a == b; }
fun mask_ne(a: f32x4, b: f32x4) u32x4 { ret a != b; }
fun mask_le(a: f32x4, b: f32x4) u32x4 { ret a <= b; }
fun mask_gt(a: f32x4, b: f32x4) u32x4 { ret a > b; }
fun mask_int(a: i32x4, b: i32x4) u32x4 { ret a < b; }
fun mask_wide(a: f64x2, b: f64x2) u64x2 { ret a < b; }

# lane reads at every index of a 4-lane vector, and at both indices of a 2-lane
# one. the lane index is a compile-time constant by the language's rule, so these
# are literal-index composite extracts.
fun lane0(v: f32x4) f32 { ret v[0]; }
fun lane3(v: f32x4) f32 { ret v[3]; }
fun horizontal(v: f32x4) f32 { ret v[0] + v[1] + v[2] + v[3]; }
fun lane_wide(v: f64x2) f64 { ret v[1]; }
fun lane_int(v: i32x4) i32 { ret v[2]; }

# lane writes, onto a vector derived from a parameter so nothing is materialized
# out of thin air.
fun set_lane(v: f32x4, x: f32) f32x4 {
    var r: f32x4 = v;
    r[1] = x;
    ret r;
}

fun set_all(v: f32x4, x: f32) f32x4 {
    var r: f32x4 = v;
    r[0] = x;
    r[1] = x;
    r[2] = x;
    r[3] = x;
    ret r;
}

# a scalar read back out of a vector, scaled, and written into another lane: mixes
# the vector and scalar type families through one variable map.
fun rescale(v: f32x4) f32x4 {
    var r: f32x4 = v;
    r[3] = v[0] * 2.0;
    ret r;
}

# vectors carried across the structured control flow the emitter reconstructs. the
# phi edge copies a lowered `if` / `for` leaves behind are emitted at the machine
# word, so a vector whose copy destination came out scalar-typed would fail here
# rather than in straight-line code.
fun select4(a: f32x4, b: f32x4, t: i32) f32x4 {
    if (t > 0) { ret a + b; }
    ret a - b;
}

fun accumulate(seed: f32x4, step: f32x4, n: i32) f32x4 {
    var acc: f32x4 = seed;
    var i: i32 = 0;
    for (i < n) {
        acc = acc + step;
        i = i + 1;
    }
    ret acc;
}

fun sifted(seed: i32x4, step: i32x4, n: i32) i32x4 {
    var acc: i32x4 = seed;
    var i: i32 = 0;
    for (i < n) {
        i = i + 1;
        if (i % 3 == 0) { cnt; }
        if (i > 32) { brk; }
        acc = acc + step;
    }
    ret acc;
}

# a vector through a direct call chain, including a call whose argument is another
# call's vector result.
fun composed(a: f32x4, b: f32x4) f32x4 {
    ret mul4(add4(a, b), div4(a, b));
}

fun main() i32 {
    ret 0;
}

# a vector literal with constant lanes: the classic case, and the one whose
# allocation used to be reinterpreted.
fun literal_const() f32x4 {
    ret f32x4{1.0, 2.0, 3.0, 4.0};
}

# an uninitialized vector local, which is a whole-object zero rather than a
# lane-by-lane one: `OpStore` of `OpConstantNull`, no stores per lane at all.
fun zeroed() f32x4 {
    var z: f32x4;
    ret z;
}

# a literal whose lanes are RUNTIME values - the broadcast that had no other
# spelling. Each lane is an access chain write into the local, so this exercises
# the ordinals rather than a constant fold.
fun broadcast(t: f32) f32x4 {
    ret f32x4{t, t, t, t};
}

# broadcast feeding real arithmetic, which is what a shader actually writes when it
# scales a colour or a position by a computed factor.
fun scaled(v: f32x4, k: f32) f32x4 {
    ret v * f32x4{k, k, k, k};
}

# a local array of vectors, indexed: a local allocation reached by an access chain
# rather than read whole.
fun from_array(v: f32x4) f32x4 {
    var rows: [4]f32x4;
    rows[0] = v;
    rows[2] = v * v;
    ret rows[0] + rows[2];
}

# a local record, whose plain undecorated struct type must be INTERNED - two locals
# of one `rec` sharing one type - unlike a descriptor block, whose decorations make
# it distinct.
rec Pair { a: f32x4; b: f32x4; }
fun from_record(v: f32x4) f32x4 {
    var p: Pair;
    p.a = v;
    ret p.a + p.b;
}
