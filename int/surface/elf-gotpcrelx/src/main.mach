# R_X86_64_GOTPCRELX / R_X86_64_REX_GOTPCRELX surface case (mach #2534)
#
# The C half reaches `shared_counter` and `shared_bump` through the GOT. mach
# honours that indirection rather than relaxing it away, so each reference reads
# its GOT slot at run time and the slot must hold the definition's address. A slot
# left zero, or pointed at the wrong symbol, faults or prints a wrong value here -
# neither of which a link-succeeded check would notice.
#
# The sequence is order-dependent: 7, +5 -> 12, ++ -> 13, and the final read must
# observe every prior write through the same slot.

use std.runtime;
use std.types.size.usize;
use p: std.print;

ext fun read_counter() i32;
ext fun add_counter(n: i32) i32;
ext fun call_bump() i32;

#[symbol("main")]
fun main(argc: usize, argv: **u8) i64 {
    p.printlnf("read={}", read_counter());
    p.printlnf("add={}", add_counter(5));
    p.printlnf("bump={}", call_bump());
    p.printlnf("final={}", read_counter());
    ret 0;
}
