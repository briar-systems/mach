# a program that links a clang-produced Mach-O object: the `ext fun` names a C
# function, so it must bind the underscore-prefixed symbol the Darwin C ABI gives
# it, and the object's own debug / __compact_unwind references into __text are
# section-based relocations. the binary is cross-built on the linux leg and
# inspected structurally rather than executed.
use std.runtime;
use std.types.size.usize;

ext fun mad_device_open(a: i32) i32;

#[symbol("main")]
fun main(argc: usize, argv: **u8) i64 { ret mad_device_open(2)::i64; }
