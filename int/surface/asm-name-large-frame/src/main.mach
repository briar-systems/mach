# asm-name-large-frame surface case (#2231, #2667)
#
# an inline-asm `{name}` binding in a function whose frame is far larger than the
# target's load/store immediate reach. every other frame slot is addressed by a
# COMPILER-emitted access, which each target legalizes through a register the back end
# reserves; a `{name}` is addressed by an AUTHOR-written one, and there is no register
# the compiler may borrow inside someone else's asm body. aarch64 borrowing IP0 for
# exactly that was a silent wrong answer (#2667) and riscv64 refuses rather than borrow
# t0, so the only correct answer is to put the slot where it never needs legalizing.
#
# THE PADDING IS THE TEST. Frame slots sit below the frame pointer, so a `{name}`
# offset is negative, and aarch64's scaled imm12 form is unsigned-only: the whole reach
# is the unscaled imm9's -256, which is thirty-two eight-byte slots. riscv64 reaches
# -2048. The arrays below put both far out of range unless the bound slots are laid out
# first, so a build that lays them out in declaration order fails to encode on aarch64
# and riscv64 - and, before #2667, miscompiled silently on aarch64 rather than failing.
#
# The asm body deliberately holds a live value in the register its target would have
# borrowed (x16 on aarch64, t0 on riscv64), so a regression that reintroduces the
# borrow shows up as a wrong ANSWER here rather than only as a build error.

use std.runtime;
use p: std.print;

fun big_frame(v: i64) i64 {
    var pad_a: [700]i64;
    var pad_b: [700]i64;
    var slot: i64 = v;
    var out: i64 = 0;

    pad_a[0]   = 3;
    pad_a[699] = 5;
    pad_b[0]   = 7;
    pad_b[699] = 11;

    $if ($mach.build.arch == $mach.arch.x86_64) {
        asm x86_64 {
            mov r11, 12345
            mov rax, {slot}
            add rax, r11
            mov {out}, rax
        }
    }
    $or ($mach.build.arch == $mach.arch.aarch64) {
        asm aarch64 {
            mov x16, 12345
            ldr x9, {slot}
            add x9, x9, x16
            str x9, {out}
        }
    }
    $or ($mach.build.arch == $mach.arch.riscv64) {
        asm riscv64 {
            li t0, 12345
            ld a1, {slot}
            add a1, a1, t0
            sd a1, {out}
        }
    }
    $or {
        $error("asm-name-large-frame: unsupported architecture");
    }

    ret out + pad_a[0] + pad_a[699] + pad_b[0] + pad_b[699];
}

#[symbol("main")]
fun main() i64 {
    p.printlnf("big0={}", big_frame(0));
    p.printlnf("big7={}", big_frame(7));
    p.printlnf("bigneg={}", big_frame(0 - 45));
    ret 0;
}
