# regression pin for loop-invariant code motion (#2204)
#
# LICM lifts work that does not change across a loop's iterations into the loop's
# preheader. The preheader runs whenever the loop is REACHED -- including when the
# loop then trips zero times -- so the pass is only correct if it hoists nothing
# that could fault there, and nothing whose value the loop itself can change. This
# case exercises both halves at run time.
#
# Every bound and every operand rides `argc` (1 at runtime, opaque to the
# compiler), so no profile can constant-fold a probe away and every loop entry,
# guard and back edge executes for real.
#
# The FAULT probes must simply complete: a zero-trip loop containing a division by
# zero, and a zero-trip / guarded loop dereferencing a null pointer. Hoisting
# either into the preheader crashes the process (SIGFPE / SIGSEGV) instead of
# printing.
#
# The VALUE probes must print the sequential answer: loops whose body writes the
# same module-scope object they read -- directly, through a pointer, and through a
# distinct global that must NOT block the hoist -- plus indexed reads of
# module-scope arrays and structs, where a split gep prefix that miscomputes an
# offset diverges the checksum.

use std.runtime;
use std.types.size.usize;
use p: std.print;

# a module-scope `val`: an immutable bound whose backing global load is invariant
# and hoistable.
pub val LIMIT: i64 = 8;

# read but never written in the loops below: hoisting its load is legal.
var g_ro: i64 = 3;
# read AND written inside a loop: hoisting its load would read a stale value.
var g_rw: i64 = 0;
# written while an unrelated global is read: must not block that read's hoist.
var g_side: i64 = 0;

var arr: [64]i64;
var grid: [8][8]i64;

rec Rec {
    a: i64;
    b: i64;
}

var recs: [16]Rec;
var cfg: Rec;

# a zero-trip loop containing an invariant division by zero. The divide is
# loop-invariant, so a pass that hoists on invariance alone puts a SIGFPE in the
# preheader; the loop itself never runs, so the correct answer is the seed.
fun zero_trip_div(n: i64, d: i64) i64 {
    var acc: i64 = 7;
    var i: i64 = 0;
    for (i < n) {
        acc = acc + (100 / d) + (100 % d);
        i = i + 1;
    }
    ret acc;
}

# a divide guarded by a test the loop never passes. The loop runs, so a
# "guaranteed to execute" heuristic is not enough: only refusing to speculate the
# divide at all keeps this from faulting.
fun guarded_div(n: i64, d: i64) i64 {
    var acc: i64 = 11;
    var i: i64 = 0;
    for (i < n) {
        if (d != 0) { acc = acc + (100 / d); }
        i = i + 1;
    }
    ret acc;
}

# a zero-trip loop dereferencing a null pointer. The address is loop-invariant but
# its object is unknown, so hoisting the load faults in the preheader.
fun zero_trip_load(n: i64, q: *i64) i64 {
    var acc: i64 = 13;
    var i: i64 = 0;
    for (i < n) {
        acc = acc + q[0];
        i = i + 1;
    }
    ret acc;
}

# the same load, guarded inside a loop that does run.
fun guarded_load(n: i64, q: *i64) i64 {
    var acc: i64 = 17;
    var i: i64 = 0;
    for (i < n) {
        if (q != nil) { acc = acc + q[0]; }
        i = i + 1;
    }
    ret acc;
}

# the loop writes the very global it reads, so the load is not invariant: the
# answer is 0+1+...+(n-1), not n*0.
fun self_written(n: i64) i64 {
    g_rw = 0;
    var i: i64 = 0;
    for (i < n) {
        g_rw = g_rw + i;
        i = i + 1;
    }
    ret g_rw;
}

# the loop writes the same global THROUGH A POINTER, so the store's object is
# unknown and the read must stay put: 3+4+...  rather than n*3.
fun written_through_pointer(n: i64, q: *i64) i64 {
    var acc: i64 = 0;
    var i: i64 = 0;
    for (i < n) {
        acc = acc + g_ro;
        q[0] = q[0] + 1;
        i = i + 1;
    }
    ret acc;
}

# the loop writes a DIFFERENT named global, which cannot reach `g_ro`: its load is
# still hoistable and the sum stays n*3.
fun written_elsewhere(n: i64) i64 {
    var acc: i64 = 0;
    var i: i64 = 0;
    for (i < n) {
        acc = acc + g_ro;
        g_side = g_side + 1;
        i = i + 1;
    }
    ret acc;
}

# a module-scope array indexed by the induction variable: the base address is
# invariant and split into the preheader, the index is not.
fun array_sum(n: i64) i64 {
    var acc: i64 = 0;
    var i: i64 = 0;
    for (i < n) {
        acc = acc * 31 + arr[i];
        i = i + 1;
    }
    ret acc;
}

# a two-dimensional module-scope array read both row-varying and column-varying,
# so the split lands at a different index level in each loop.
fun grid_sum(n: i64) i64 {
    var acc: i64 = 0;
    var i: i64 = 0;
    for (i < n) {
        acc = acc * 31 + grid[i][3];
        i = i + 1;
    }
    var j: i64 = 0;
    for (j < n) {
        acc = acc * 31 + grid[5][j];
        j = j + 1;
    }
    ret acc;
}

# a module-scope array of structs: the varying index sits between the leading
# constant and the trailing field ordinal, so only the leading walk may hoist.
fun rec_sum(n: i64) i64 {
    var acc: i64 = 0;
    var i: i64 = 0;
    for (i < n) {
        acc = acc * 31 + recs[i].a + recs[i].b * 7;
        i = i + 1;
    }
    ret acc;
}

# a wholly invariant field read of a module-scope struct: a constant offset inside
# a global object, hoistable, and the loop must still see the value it wrote just
# before entering.
fun cfg_sum(n: i64) i64 {
    cfg.a = 2;
    cfg.b = 5;
    var acc: i64 = 0;
    var i: i64 = 0;
    for (i < n) {
        acc = acc + cfg.b - cfg.a;
        i = i + 1;
    }
    ret acc;
}

# an invariant bound reloaded from a module-scope `val` every iteration: the load
# hoists and the trip count is unchanged.
fun limit_trips(scale: i64) i64 {
    var acc: i64 = 0;
    var i: i64 = 0;
    for (i < LIMIT * scale) {
        acc = acc + 1;
        i = i + 1;
    }
    ret acc;
}

#[symbol("main")]
fun main(argc: usize, argv: **u8) i64 {
    # 1 at runtime; opaque to the compiler.
    val one: i64 = argc::i64;
    val zero: i64 = one - 1;
    val nul: *i64 = nil;

    var k: i64 = 0;
    for (k < 64 * one) {
        arr[k] = (k * 7) % 13;
        k = k + 1;
    }
    var r: i64 = 0;
    for (r < 8 * one) {
        var c: i64 = 0;
        for (c < 8 * one) {
            grid[r][c] = r * 8 + c;
            c = c + 1;
        }
        r = r + 1;
    }
    var s: i64 = 0;
    for (s < 16 * one) {
        recs[s].a = s;
        recs[s].b = 16 - s;
        s = s + 1;
    }

    # faults: each must print, not crash.
    p.printf("fault:");
    p.printf(" {}", zero_trip_div(zero, zero));      # 7
    p.printf(" {}", guarded_div(4 * one, zero));     # 11
    p.printf(" {}", zero_trip_load(zero, nul));      # 13
    p.printf(" {}", guarded_load(4 * one, nul));     # 17
    p.println("");

    # memory: a write the loop performs must be visible to the loop's own reads.
    p.printf("memory:");
    p.printf(" {}", self_written(10 * one));                    # 45
    p.printf(" {}", written_through_pointer(4 * one, ?g_ro));   # 3+4+5+6 = 18
    p.printf(" {}", g_ro);                                      # 7
    p.printf(" {}", written_elsewhere(4 * one));                # 7*4 = 28
    p.printf(" {}", g_side);                                    # 4
    p.println("");

    # addresses: a split gep prefix that miscomputes an offset diverges these.
    p.printf("address:");
    p.printf(" {}", array_sum(64 * one));
    p.printf(" {}", grid_sum(8 * one));
    p.printf(" {}", rec_sum(16 * one));
    p.printf(" {}", cfg_sum(6 * one));               # 6*3 = 18
    p.printf(" {}", limit_trips(3 * one));           # 24
    p.println("");

    ret 0;
}
