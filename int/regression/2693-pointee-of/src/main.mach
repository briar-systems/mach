# regression pin for #2693: a reflection walk follows a reference field
#
# `$is_pointer(f.type)` detected a reference and the walk stopped there, because
# there was no way to ask what a typed reference points at. every
# reference-following derive - deep equality, owning clone, a formatter that
# renders a `str` - was blocked on that one question.
#
# every value printed here is read THROUGH a reference, so a `$pointee_of` that
# resolved to the wrong type reports a different number rather than failing to
# compile. the two-pointee record is the case a memoized answer gets wrong: the
# node is per-iteration, and the first field's pointee is a stale answer for the
# second that compiles cleanly.

use std.runtime;
use p: std.print;
use std.types.string.str;

rec Leaf  { a: i64; b: i64; c: i64; }
rec Small { m: i64; }

rec One   { tag: i64; leaf: *Leaf; }
rec Two   { pl: *Leaf; ps: *Small; }

# sums a record's scalars, reading a reference field through its pointee
fun sum_through[T](v: *T) i64 {
    var total: i64 = 0;
    $each f in $fields(T) {
        $if ($is_pointer(f.type)) {
            $each g in $fields($pointee_of(f.type)) {
                total = total + (@(v.[f])).[g];
            }
        }
        $or { total = total + v.[f]; }
    }
    ret total;
}

# counts the fields of each reference field's pointee, packed one decimal digit
# per field so two DIFFERENT pointees cannot report the same number
fun pointee_widths[T](v: *T) i64 {
    var acc: i64 = 0;
    $each f in $fields(T) {
        $if ($is_pointer(f.type)) {
            var n: i64 = 0;
            $each g in $fields($pointee_of(f.type)) { n = n + 1; }
            acc = acc * 10 + n;
        }
        $or { }
    }
    ret acc;
}

#[symbol("main")]
pub fun main(argc: i64, argv: **u8) i64 {
    var leaf: Leaf;
    leaf.a = 1; leaf.b = 20; leaf.c = 300;
    var small: Small;
    small.m = 4000;

    var one: One;
    one.tag = 50000; one.leaf = ?leaf;
    p.printf("one sum: {}\n", sum_through[One](?one));

    var two: Two;
    two.pl = ?leaf; two.ps = ?small;
    p.printf("two sum: {}\n", sum_through[Two](?two));
    p.printf("two pointee widths: {}\n", pointee_widths[Two](?two));

    # a change through the reference is visible to the walk, so the walk really
    # dereferences rather than folding a constant
    leaf.b = 21;
    p.printf("one sum after write: {}\n", sum_through[One](?one));

    # one level, not all of them
    p.printf("pointee of **Leaf is a reference: {}\n", $size_of($pointee_of(**Leaf)));
    p.printf("pointee of *Leaf: {}\n", $size_of($pointee_of(*Leaf)));
    p.printf("pointee name: {}\n", $type_name($pointee_of(*Leaf)));

    # `str` is `*char`, which is why a `str` field was refused with the rest
    p.printf("pointee of str: {}\n", $type_name($pointee_of(str)));

    ret 0;
}
