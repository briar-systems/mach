# the VALUE half of the constant pool (#2248, #2700)
#
# The sibling `surface/const-pool` case asserts that constants are pooled and
# deduplicated; nothing there looks at a number. This case asserts that every
# pooled constant still IS the constant - a pool that returns the wrong entry is a
# miscompile, and a wrong entry is exactly the thing that looks right in a listing.
#
# EVERY observable here is a BIT PATTERN, not float text. A truncation, a sign
# dropped, a neighbouring entry returned, or a four-byte load off an eight-byte
# entry all produce a plausible float that prints as something close to right;
# printed as hex none of them survives.
#
# The constants are chosen so a wrong answer is loud. No 0 and no 1. Every value
# is irregular in its own bit pattern and no two of them are near each other, with
# one deliberate exception: `A` and `B` differ in a single bit, which is what
# catches an interning key that compares less than the whole image.

use std.runtime;
use std.types.size.usize;
use p: std.print;

# an opaque input the constant folders cannot see through, so every arithmetic
# below is a genuine runtime operation against a materialized constant rather than
# a folded literal
var SEED: f64 = 2.0;
var SEED32: f32 = 2.0;

# one bit apart: 0x3FF8000000000000 and 0x3FF8000000000001
val A: f64 = 1.5;
val B: f64 = 1.5000000000000002;

fun b64(f: f64) u64 { ret f:~u64; }
fun b32(f: f32) u32 { ret f:~u32; }

fun show64(name: *u8, f: f64) { p.printlnf("{}={:x}", name, b64(f)); }
fun show32(name: *u8, f: f32) { p.printlnf("{}={:x}", name, b32(f)::u64); }

# a constant moved straight into a register, which is the pool's simplest consumer
#[noinline]
#[scalar]
fun pick(which: i64) f64 {
    if (which == 0) { ret 0.1; }
    if (which == 1) { ret 3.14159265358979; }
    if (which == 2) { ret 2.718281828459045; }
    if (which == 3) { ret -0.0; }
    ret 1.7976931348623157e308;
}

# a constant folded into the operation that reads it, which on x86-64 is a memory
# operand rather than a register load. the two paths must agree
#[noinline]
#[scalar]
fun scale(x: f64, which: i64) f64 {
    if (which == 0) { ret x * 0.1; }
    if (which == 1) { ret x * 3.14159265358979; }
    if (which == 2) { ret x * 2.718281828459045; }
    if (which == 3) { ret x * -0.0; }
    ret x * 1.7976931348623157e308;
}

# the same constant at many uses in one function: they share one entry, and every
# one of them must still read it
#[noinline]
#[scalar]
fun repeated(x: f64) f64 {
    ret x * 0.1 - x * 0.1 + 0.1 * 0.1 + 0.1;
}

# two constants one bit apart, in one function. a key comparing a prefix, a hash,
# or a truncated image merges them, and this difference goes to zero
#[noinline]
#[scalar]
fun one_bit_apart(x: f64) f64 {
    ret x * B - x * A;
}

# the cheap-constant path the cost rule declines to pool, beside the pooled one, so
# a rule that started pooling everything (or stopped pooling anything) still has to
# produce these numbers
#[noinline]
#[scalar]
fun cheap_and_pooled(x: f64) f64 {
    ret (x + 0.0) * 2.0 + x * 0.1;
}

# the f32 side. a float literal reaches the back end as an f64 pattern plus a
# narrowing convert, so these exercise the pooled f64 entry feeding a single-
# precision operation - a four-byte load off that entry would read the low half of
# a double and print as garbage
#[noinline]
#[scalar]
fun scale32(x: f32) f32 {
    ret x * 0.1::f32 + 3.14159265::f32;
}

# negation of a pooled negative zero: `-(-0.0)` is +0.0 and `-0.0 * 1.0` stays
# negative, which no float comparison can tell apart
#[noinline]
#[scalar]
fun neg_of_negzero(x: f64) f64 {
    ret -(x * -0.0);
}

#[symbol("main")]
fun main(argc: usize, argv: **u8) i64 {
    val s: f64 = SEED;

    show64("pick.0", pick(0));
    show64("pick.1", pick(1));
    show64("pick.2", pick(2));
    show64("pick.negzero", pick(3));
    show64("pick.max", pick(4));

    show64("scale.0", scale(s, 0));
    show64("scale.1", scale(s, 1));
    show64("scale.2", scale(s, 2));
    show64("scale.negzero", scale(s, 3));

    show64("repeated", repeated(s));
    show64("one.bit.apart", one_bit_apart(s));
    show64("cheap.and.pooled", cheap_and_pooled(s));
    show32("scale32", scale32(SEED32));
    show64("neg.of.negzero", neg_of_negzero(s));

    # the register path and the folded path must produce the same product for the
    # same constant: `x * K` and `x * pick(K)` differ only in how K was materialized
    var agree: i64 = 1;
    var i: i64 = 0;
    for (i < 4) {
        if (scale(s, i) != s * pick(i)) { agree = 0; }
        i = i + 1;
    }
    p.printlnf("paths.agree={}", agree);

    ret 0;
}
