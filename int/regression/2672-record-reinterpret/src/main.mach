# regression pin for #2672: a `:~` reinterpret involving a record compiles, and
# moves the right bytes
#
# The sema size check read every `rec` and `uni` as 0 bytes, so it rejected every
# reinterpret involving one in either operand position, while `$size_of` on the same
# type answered correctly. Two paths to a type's size disagreed; the check now uses
# the one `$size_of` and the middle end both use.
#
# EVERY OBSERVABLE HERE IS A BYTE PATTERN, not a successful compile. The defect was a
# compile-time rejection, so a case asserting only "it builds" would pass against a
# version that accepts the cast and then moves the wrong bytes - which is exactly the
# neighbouring defect (#2670) this class of cast is subject to. The `$size_of` rows
# pin the agreement that was broken: the two sizes must be the same number.
#
# NOT here, deliberately: a reinterpret CROSSING the value/aggregate boundary
# (`rec One :~ i64`, or `i64 :~ rec One`). Those are #2670 - an aggregate is an
# address in the IR and a scalar is a value, and `OP_BITCAST` does not distinguish
# them, so one direction returns a stack address and the other faults. This case
# covers aggregate-to-aggregate only, which is correct today. The crossing rows
# belong here once #2670 lands.

use std.runtime;
use std.types.size.usize;
use p: std.print;

rec Pair { a: i64; b: i64; }
rec Odd  { a: i64; b: u8; }
uni U    { a: i64; b: f64; }
rec Inner { a: i64; }
rec Outer { i: Inner; j: i64; }
rec Box[T] { v: T; }

# the check and `$size_of` must agree; disagreeing is the whole defect
pub val SZ_PAIR:  u64 = $size_of(Pair);
pub val SZ_ODD:   u64 = $size_of(Odd);
pub val SZ_U:     u64 = $size_of(U);
pub val SZ_OUTER: u64 = $size_of(Outer);

fun to_bytes(x: Pair) [16]u8 { ret x:~[16]u8; }
fun of_bytes(b: [16]u8) Pair { ret b:~Pair; }
fun uni_bytes(u: U) [8]u8 { ret u:~[8]u8; }
fun outer_bytes(o: Outer) [16]u8 { ret o:~[16]u8; }
fun box_bytes(b: Box[i64]) [8]u8 { ret b:~[8]u8; }

# a cast written BEFORE the record is declared: the size must not depend on
# declaration order, which is why the measurement forces layout rather than reading
# whatever has been reached so far
fun early(l: Late) [8]u8 { ret l:~[8]u8; }
rec Late { a: i64; }

#[symbol("main")]
fun main(argc: usize, argv: **u8) i64 {
    p.printlnf("size.pair={}", SZ_PAIR);
    p.printlnf("size.odd={}", SZ_ODD);
    p.printlnf("size.uni={}", SZ_U);
    p.printlnf("size.outer={}", SZ_OUTER);

    # record -> byte array: every lane of the image is the byte that was stored
    var q: Pair;
    q.a = 0x0706050403020100;
    q.b = 0x0f0e0d0c0b0a0908;
    val img: [16]u8 = to_bytes(q);
    var i: i64 = 0;
    var ok: i64 = 1;
    for (i < 16) {
        if (img[i]::i64 != i) { ok = 0; }
        i = i + 1;
    }
    p.printlnf("pair.to_bytes.ascending={}", ok);
    p.printlnf("pair.to_bytes.b3={}", img[3]::i64);
    p.printlnf("pair.to_bytes.b8={}", img[8]::i64);

    # and back again: the round trip is the identity on both fields
    val back: Pair = of_bytes(img);
    p.printlnf("pair.roundtrip.a={}", back.a - q.a);
    p.printlnf("pair.roundtrip.b={}", back.b - q.b);

    # a union reinterpreted through its widest member
    var u: U;
    u.a = 0x0807060504030201;
    val ub: [8]u8 = uni_bytes(u);
    p.printlnf("uni.b0={}", ub[0]::i64);
    p.printlnf("uni.b7={}", ub[7]::i64);

    # a nested record: the image is the flattened field bytes, not a pointer
    var o: Outer;
    o.i.a = 0x0706050403020100;
    o.j   = 0x0f0e0d0c0b0a0908;
    val ob: [16]u8 = outer_bytes(o);
    p.printlnf("outer.b0={}", ob[0]::i64);
    p.printlnf("outer.b15={}", ob[15]::i64);

    # a generic instance sizes and reinterprets like the record it instantiates
    var bx: Box[i64];
    bx.v = 0x0807060504030201;
    val bb: [8]u8 = box_bytes(bx);
    p.printlnf("box.b0={}", bb[0]::i64);

    var lt: Late;
    lt.a = 0x0807060504030201;
    val lb: [8]u8 = early(lt);
    p.printlnf("late.b0={}", lb[0]::i64);

    ret 0;
}
