# a constant index outside a statically known length is refused before any target
# sees it, and the in-bounds neighbour of each is not

def Buf: [4]i32;

rec Box[T] { xs: [8]T; }

rec Nest { inner: [3]i32; }

fun plain() i32 {
    var xs: [4]i32;
    ret xs[3] + xs[0] + xs[9];
}

fun boundary() i32 {
    var xs: [4]i32;
    ret xs[4];
}

fun low() i32 {
    var xs: [4]i32;
    ret xs[-1];
}

fun alias() i32 {
    var b: Buf;
    ret b[3] + b[4];
}

fun generic() i64 {
    var b: Box[i64];
    ret b.xs[7] + b.xs[8];
}

fun nested() i32 {
    var v: Nest;
    ret v.inner[2] + v.inner[3];
}

fun grid() i32 {
    var g: [2][3]i32;
    ret g[1][2] + g[1][3];
}

fun secret(s: ^[4]i32) ^i32 {
    ret s[6];
}

fun lane(v: u32x4) u32 {
    ret v[3] + v[4];
}

# a runtime index and a pointer carry no decidable bound, and stay accepted
fun dynamic(i: u64, p: *i32) i32 {
    var xs: [4]i32;
    ret xs[i] + p[99];
}

#[symbol("main")]
fun main() i32 { ret 0; }
