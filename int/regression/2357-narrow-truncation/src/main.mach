# regression pin for #2357: a narrow value's declared width at an input-sensitive consumer
#
# `mir.ALU_MIN_WIDTH` computes a sub-word ALU op at the ALU floor and leaves the
# register bits above the declared width undefined, requiring every consumer that
# needs the narrow value to re-narrow it. an operation is input-sensitive exactly
# when its low N result bits depend on operand bits above N: the right shifts, the
# divides, and the comparisons. only the divides and the comparisons were enrolled,
# so `(0 - a) >> 7` at u8 shifted a full 0xFFFFFFFF and read 255 where the u8 answer
# is 1 - silently, and differently in debug and release once `algebraic` deleted the
# `& 0xFF` workaround.
#
# the case pins three things. the SHIFTS that were broken, unsigned and signed, at
# both narrow widths and at a constant and a runtime count. the narrow IMMEDIATE
# operand, which reaches the backend carrying its width-masked bits rather than its
# value (i8 -56 arrives as 200) and was miscompiling the divides too. and the
# boundaries that were ALREADY CORRECT - store, call argument, return, widening cast,
# comparison, divide, and every width-preserving ALU op - so a later change cannot
# quietly regress what this defect never touched.
#
# every operand is derived from argc so nothing folds at comptime. riscv64 and
# aarch64 have no narrow ALU at all and must extend explicitly, so the case runs on
# all three machine ISAs, in both profiles: release and debug disagreeing was the
# defect's loudest symptom, and their agreement here is the proof it is gone.

use std.runtime;
use std.types.size.usize;
use p: std.print;

# the issue's five reproducers verbatim
fun shr_after_sub_u8(a: u8)   u8  { ret (0 - a) >> 7; }
fun shr_after_sub_u16(a: u16) u16 { ret (0 - a) >> 15; }
fun shl_then_shr_u8(a: u8)    u8  { ret (a << 1) >> 1; }
fun explicit_cast_u8(a: u8)   u8  { ret ((0 - a)::u8) >> 7; }
fun explicit_mask_u8(a: u8)   u8  { ret ((0 - a) & 0xFF) >> 7; }

# a u16 shape that genuinely overflows its width (16384 << 1 still fits in u16 and
# would pass either way)
fun shl_then_shr_u16(a: u16) u16 { ret (a << 1) >> 1; }

# every other producer that can overflow the narrow width, feeding a logical shift right
fun mul_shr_u8(a: u8) u8 { ret (a * 3) >> 1; }
fun add_shr_u8(a: u8) u8 { ret (a + 200) >> 4; }
fun not_shr_u8(a: u8) u8 { ret (~a) >> 4; }
fun var_shr_u8(a: u8, n: u8) u8 { ret (0 - a) >> n; }

# the signed side: an ARITHMETIC shift right needs sign extension where the logical
# one needs zero extension. the issue's `(0 - a) >> bits-1` shape hides this - a
# width-4 subtract that does not overflow the narrow width leaves a naturally
# sign-extended register - so these overflow it instead.
fun shl_then_sar_i8(a: i8)   i8  { ret (a << 1) >> 1; }
fun shl_then_sar_i16(a: i16) i16 { ret (a << 1) >> 1; }
fun mul_sar_i8(a: i8) i8 { ret (a * 3) >> 1; }
fun var_sar_i8(a: i8, n: u8) i8 { ret (a << 1) >> n; }

# a narrow CONSTANT as the shifted / divided value: it arrives width-masked, so
# widening its raw bits computes on 200 where the source said -56
fun const_sar_i8(n: u8) i8 { ret (-56::i8) >> n; }
fun const_shr_u8(n: u8) u8 { ret (200::u8) >> n; }
fun const_div_i8(d: i8) i8 { ret (-56::i8) / d; }
fun const_rem_i8(d: i8) i8 { ret (-56::i8) % d; }

# ALREADY CORRECT: a left shift and the width-preserving ALU ops are exact on a
# dirty operand - their low N result bits depend only on the low N operand bits
fun shl_after_sub_u8(a: u8) u8 { ret (0 - a) << 1; }
fun and_after_shl_u8(a: u8) u8 { ret (a << 1) & 0x0F; }
fun add_after_shl_u8(a: u8) u8 { ret (a << 1) + 1; }
fun mul_after_shl_u8(a: u8) u8 { ret (a << 1) * 3; }

# ALREADY CORRECT: the comparisons re-narrow through the per-ISA narrow_cmp_source
fun lt_after_shl_u8(a: u8) u8 { if ((a << 1) < 4::u8)  { ret 1; } ret 0; }
fun lt_after_shl_i8(a: i8) u8 { if ((a << 1) < 0::i8)  { ret 1; } ret 0; }
fun eq_after_shl_u8(a: u8) u8 { if ((a << 1) == 0::u8) { ret 1; } ret 0; }

# ALREADY CORRECT: the divides promote both operands
fun div_after_shl_u8(a: u8) u8 { ret (a << 1) / 3; }
fun rem_after_shl_u8(a: u8) u8 { ret (a << 1) % 7; }
fun div_after_shl_i8(a: i8) i8 { ret (a << 1) / 3; }

# ALREADY CORRECT: the value is truncated where it crosses a boundary
pub var g8: u8 = 0;
fun sink_u8(x: u8) u8 { ret x; }
fun store_after_shl_u8(a: u8)   u8  { g8 = a << 1; ret g8; }
fun callarg_after_shl_u8(a: u8) u8  { ret sink_u8(a << 1); }
fun widen_after_shl_u8(a: u8)   u64 { ret (a << 1)::u64; }
fun widen_after_shl_i8(a: i8)   i64 { ret (a << 1)::i64; }

#[symbol("main")]
fun main(argc: usize, argv: **u8) i64 {
    val one:    u8  = argc::u8;
    val one16:  u16 = argc::u16;
    val v255:   u8  = (argc * 255)::u8;
    val v100:   u8  = (argc * 100)::u8;
    val v128:   u8  = (argc * 128)::u8;
    val v40000: u16 = (argc * 40000)::u16;
    val s64:    i8  = (argc * 64)::i8;
    val s100:   i8  = (argc * 100)::i8;
    val s16384: i16 = (argc * 16384)::i16;
    val n1:     u8  = argc::u8;
    val n7:     u8  = (argc * 7)::u8;

    p.printlnf("shr_after_sub_u8={}",  shr_after_sub_u8(one)::i64);      # 1
    p.printlnf("shr_after_sub_u16={}", shr_after_sub_u16(one16)::i64);   # 1
    p.printlnf("shl_then_shr_u8={}",   shl_then_shr_u8(v255)::i64);      # 127
    p.printlnf("explicit_cast_u8={}",  explicit_cast_u8(one)::i64);      # 1
    p.printlnf("explicit_mask_u8={}",  explicit_mask_u8(one)::i64);      # 1
    p.printlnf("shl_then_shr_u16={}",  shl_then_shr_u16(v40000)::i64);   # 7232

    p.printlnf("mul_shr_u8={}", mul_shr_u8(v100)::i64);                  # 22
    p.printlnf("add_shr_u8={}", add_shr_u8(v100)::i64);                  # 2
    p.printlnf("not_shr_u8={}", not_shr_u8(one)::i64);                   # 15
    p.printlnf("var_shr_u8={}", var_shr_u8(one, n7)::i64);               # 1

    p.printlnf("shl_then_sar_i8={}",  shl_then_sar_i8(s64)::i64);        # -64
    p.printlnf("shl_then_sar_i16={}", shl_then_sar_i16(s16384)::i64);    # -16384
    p.printlnf("mul_sar_i8={}",       mul_sar_i8(s100)::i64);            # 22
    p.printlnf("var_sar_i8={}",       var_sar_i8(s64, n1)::i64);         # -64

    p.printlnf("const_sar_i8={}", const_sar_i8(n1)::i64);                # -28
    p.printlnf("const_shr_u8={}", const_shr_u8(n1)::i64);                # 100
    p.printlnf("const_div_i8={}", const_div_i8((argc * 2)::i8)::i64);    # -28
    p.printlnf("const_rem_i8={}", const_rem_i8((argc * 3)::i8)::i64);    # -2

    p.printlnf("shl_after_sub_u8={}", shl_after_sub_u8(one)::i64);       # 254
    p.printlnf("and_after_shl_u8={}", and_after_shl_u8(v255)::i64);      # 14
    p.printlnf("add_after_shl_u8={}", add_after_shl_u8(v255)::i64);      # 255
    p.printlnf("mul_after_shl_u8={}", mul_after_shl_u8(v255)::i64);      # 250

    p.printlnf("lt_after_shl_u8={}", lt_after_shl_u8(v255)::i64);        # 0
    p.printlnf("lt_after_shl_i8={}", lt_after_shl_i8(s64)::i64);         # 1
    p.printlnf("eq_after_shl_u8={}", eq_after_shl_u8(v128)::i64);        # 1

    p.printlnf("div_after_shl_u8={}", div_after_shl_u8(v255)::i64);      # 84
    p.printlnf("rem_after_shl_u8={}", rem_after_shl_u8(v255)::i64);      # 2
    p.printlnf("div_after_shl_i8={}", div_after_shl_i8(s64)::i64);       # -42

    p.printlnf("store_after_shl_u8={}",   store_after_shl_u8(v255)::i64);   # 254
    p.printlnf("callarg_after_shl_u8={}", callarg_after_shl_u8(v255)::i64); # 254
    p.printlnf("widen_after_shl_u8={}",   widen_after_shl_u8(v255)::i64);   # 254
    p.printlnf("widen_after_shl_i8={}",   widen_after_shl_i8(s64)::i64);    # -128
    ret 0;
}
