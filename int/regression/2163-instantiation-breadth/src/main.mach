# regression pin for #2163: a family that branches, which a depth bound cannot see
#
# `spread[T]` names TWO strictly larger instances of itself, so the family grows
# 2^depth wide while every chain stays shallow: at the depth limit alone this is
# still four billion instances against a linear-scan dedup, i.e. a hang. The
# breadth limit is what refuses it, and it is refused on the instance COUNT - a
# different diagnostic from the depth case, on purpose.

fun spread[T]() {
    spread[*T]();
    spread[[2]T]();
}

fun main() i64 {
    spread[u32]();
    ret 0;
}
