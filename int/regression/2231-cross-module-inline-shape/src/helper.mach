# the dependency module of the call-shape case: four cross-module bodies whose only
# difference is the decorator on them
#
# Deliberately minimal. The sibling `2231-cross-module-inline-asm` case owns the VALUE
# half and carries the realistic atomic bodies; this one owns the SHAPE half, where the
# only thing that must be legible is which decorator produced which verdict. Every body
# here is therefore as small as it can be while still being a call the compiler could
# choose to leave in.

# an asm-bearing `#[inline]` body: the shape `std.sync.atomic` has, and the one this
# issue is named for. it must vanish from its caller.
#[inline]
pub fun bump_asm(ptr: *i64) i64 {
    var old: i64 = 0;
    $if ($mach.build.arch == $mach.arch.x86_64) {
        asm x86_64 {
            mov rax, 1
            mov rcx, {ptr}
            lock xadd [rcx], rax
            mov {old}, rax
        }
    }
    $or ($mach.build.arch == $mach.arch.aarch64) {
        asm aarch64 {
            ldr x12, {ptr}
        1:
            ldaxr x9, [x12]
            add x10, x9, 1
            stlxr w11, x10, [x12]
            cbnz w11, 1b
            str x9, {old}
            dmb ish
        }
    }
    $or ($mach.build.arch == $mach.arch.riscv64) {
        asm riscv64 {
            ld a0, {ptr}
            li a1, 1
            amoadd.d.aqrl a2, a1, (a0)
            sd a2, {old}
        }
    }
    $or {
        $error("2231-cross-module-inline-shape: unsupported architecture");
    }
    ret old;
}

# an `#[inline]` body with no asm, so a regression that breaks only the asm-payload
# clone is distinguishable from one that breaks the cross-module flow itself.
#[inline]
pub fun bump_plain(ptr: *i64) i64 {
    val old: i64 = @ptr;
    @ptr = old + 1;
    ret old;
}

# `#[noinline]` is an author's explicit opt-out and must survive the new meaning
# `#[inline]` acquired. its call stays.
#[noinline]
pub fun bump_noinline(ptr: *i64) i64 {
    val old: i64 = @ptr;
    @ptr = old + 1;
    ret old;
}

# undecorated: the flow is opt-IN. this body must NOT cross the module boundary, or the
# lowered-surface firewall would be carrying every dependency body into every importer
# and an incremental build would re-lower the world on any edit.
pub fun bump_undecorated(ptr: *i64) i64 {
    val old: i64 = @ptr;
    @ptr = old + 1;
    ret old;
}
