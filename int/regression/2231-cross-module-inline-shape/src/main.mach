# 2231-cross-module-inline-shape regression case
#
# The EMITTED-SHAPE half of #2231: a cross-module `#[inline]` callee leaves no call
# behind, and a `#[noinline]` or undecorated one still costs exactly one.
#
# WHY THIS CASE EXISTS SEPARATELY FROM ITS EXEC SIBLING. Inlining is by definition
# value-preserving, so `2231-cross-module-inline-asm` - which checks every value at both
# profiles on all three ISAs - is exactly as green against a compiler that has stopped
# inlining across module boundaries as against one that does it. The feature is only
# visible in the number of calls left, so that is what this case observes.
#
# EACH FUNCTION BELOW ISOLATES ONE DECORATOR, one call each, so the golden reads as a
# truth table rather than a total. `calls=0` is the feature; the two `calls=1` lines are
# the contract's other direction, and they are the reason the observable is a count
# instead of a boolean - "inlined everything in reach" must fail here, not pass.
#
# Release only. The inline pass is an optimisation and the debug pipeline does not run
# it, so a debug golden would assert `calls=1` everywhere and say nothing about #2231.

use std.runtime;
use p: std.print;
use h: case.helper;

fun via_inline_asm(ptr: *i64) i64 { ret h.bump_asm(ptr); }

fun via_inline_plain(ptr: *i64) i64 { ret h.bump_plain(ptr); }

fun via_noinline(ptr: *i64) i64 { ret h.bump_noinline(ptr); }

fun via_undecorated(ptr: *i64) i64 { ret h.bump_undecorated(ptr); }

#[symbol("main")]
fun main() i64 {
    var c: i64 = 0;
    val a: i64 = via_inline_asm(?c);
    val b: i64 = via_inline_plain(?c);
    val d: i64 = via_noinline(?c);
    val e: i64 = via_undecorated(?c);
    p.printlnf("a={} b={} d={} e={} c={}", a, b, d, e, c);
    ret 0;
}
