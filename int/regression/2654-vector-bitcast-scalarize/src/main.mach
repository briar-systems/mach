# a `:~` reinterpret between two vector types, through scalarization (#2654)
#
# The signed-select idiom is the reason this construct exists: signed and float
# vectors have no bitwise operators, so `(mask & a) | (~mask & b)` is expressed by
# reinterpreting the operands through the matching unsigned type and reinterpreting
# the result back. Every operator in it scalarizes per lane; the reinterprets do
# not, because both sides are the same 16 bytes and only the lane shape is renamed.
# Left unhandled they reached the riscv64 backend still vector-typed and were
# refused as a missing 128-bit vector feature.
#
# Lanes are read with a constant index. A vector -> array reinterpret would print
# them more compactly and is deliberately not used: that form crashes at runtime on
# both SIMD-capable legs, which is a separate defect from this one.

use std.runtime;
use p: std.print;
use std.simd.shuffle.splat_u8x16;
use std.simd.shuffle.splat_i8x16;
use std.simd.shuffle.splat_i16x8;
use std.simd.shuffle.splat_u32x4;

# the signed select idiom verbatim: reinterpret in, blend, reinterpret out
fun select_i8x16(mask: u8x16, a: i8x16, b: i8x16) i8x16 {
    ret ((mask & a:~u8x16) | (~mask & b:~u8x16)):~i8x16;
}

# the same shape one lane width up, so a fix keyed to a single lane count shows
fun select_i16x8(mask: u16x8, a: i16x8, b: i16x8) i16x8 {
    ret ((mask & a:~u16x8) | (~mask & b:~u16x8)):~i16x8;
}

# a reinterpret that RESHAPES the lane count rather than only their signedness. the
# byte image is unchanged, so a u32 lane reads back as four repeated u8 lanes
fun reshape(v: u8x16) u32x4 {
    ret v:~u32x4;
}

# the reverse direction, so the pair is not only tested one way
fun unshape(v: u32x4) u8x16 {
    ret v:~u8x16;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val ones:  u8x16 = splat_u8x16(255);
    val zeros: u8x16 = splat_u8x16(0);
    val a: i8x16 = splat_i8x16(-128);
    val b: i8x16 = splat_i8x16(127);

    # an all-ones mask takes every lane of a, an all-zeros mask every lane of b
    val pick_a: i8x16 = select_i8x16(ones,  a, b);
    val pick_b: i8x16 = select_i8x16(zeros, a, b);
    p.printlnf("i8x16 {} {} {} {}", pick_a[0]::i64, pick_a[15]::i64,
                                    pick_b[0]::i64, pick_b[15]::i64);

    val ones16:  u16x8 = splat_u8x16(255):~u16x8;
    val zeros16: u16x8 = splat_u8x16(0):~u16x8;
    val a16: i16x8 = splat_i16x8(-32768);
    val b16: i16x8 = splat_i16x8(32767);
    val pick_a16: i16x8 = select_i16x8(ones16,  a16, b16);
    val pick_b16: i16x8 = select_i16x8(zeros16, a16, b16);
    p.printlnf("i16x8 {} {} {} {}", pick_a16[0]::i64, pick_a16[7]::i64,
                                    pick_b16[0]::i64, pick_b16[7]::i64);

    # 0xAB in every byte reads as 0xABABABAB in every u32 lane, on either endianness
    val bytes: u8x16 = splat_u8x16(0xAB);
    val words: u32x4 = reshape(bytes);
    p.printlnf("u32x4 {:x} {:x}", words[0]::i64, words[3]::i64);

    # and back: 0x01010101 per word is 0x01 per byte
    val back: u8x16 = unshape(splat_u32x4(0x01010101));
    p.printlnf("u8x16 {:x} {:x}", back[0]::i64, back[15]::i64);

    ret 0;
}
