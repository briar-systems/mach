# regression pin for #2254: a pack-tailed function's statements outside its
# `$each`, re-typed per monomorphized instance.
#
# the `$each` body is re-typed per element at monomorphization; the statements
# around it were typed once, against the raw generic parameter, and their types
# live in the same shared table the unroll reads back. two halves of that slot
# are observable at run time rather than as a diagnostic, so they are pinned by
# execution: an aggregate `T` local returned from inside the unroll (refused
# outright once the return type was substituted and the local's was not, and
# before that truncated to pointer width), and a `$type_of` gate over such a
# local (folded against the template parameter, so every instantiation silently
# selected the fallback arm).

use std.runtime;
use std.types.size.usize;
use p: std.print;

rec Box { a: u32; b: u32; c: u32; d: u32; }

# the local is declared outside the `$each` and returned from inside it.
fun mk[T](seed: T, va: ...) T {
    var out: T = seed;
    $each a in va { ret out; }
    ret out;
}

# the mirror, with the raw type on the assignment's left rather than on a `ret`.
fun copy_in[T](seed: T, va: ...) T {
    var out: T;
    $each a in va { out = seed; }
    ret out;
}

# a comptime type gate over the enclosing local, one arm per instantiation.
fun pick[T](seed: T, va: ...) u32 {
    var out: T   = seed;
    var r:   u32 = 0;
    $each a in va {
        $if ($type_of(out) == u32) { r = r + 1; }
        $or ($type_of(out) == u64) { r = r + 2; }
        $or                        { r = r + 9; }
    }
    ret r;
}

#[symbol("main")]
fun main(argc: usize, argv: **u8) i64 {
    var b: Box;
    b.a = 11;
    b.b = 22;
    b.c = 33;
    b.d = 44;

    val one: u32 = 1;

    val r: Box = mk[Box](b, one);
    p.printlnf("mk={} {} {} {}", r.a, r.b, r.c, r.d);

    val c: Box = copy_in[Box](b, one);
    p.printlnf("copy={} {} {} {}", c.a, c.b, c.c, c.d);

    val u: u32 = 5;
    val w: u64 = 5;
    p.printlnf("pick32={}", pick[u32](u, one));
    p.printlnf("pick64={}", pick[u64](w, one));
    ret 0;
}
