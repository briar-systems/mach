# regression pin for #2812: a CONSTANT-FOLDED integer source to an integer-to-float
# conversion is refused by the riscv64 and arm64 encoders.
#
# #2777 first hit this through `me.pass.constfold`, the MIR-level optimizer pass that
# only runs at opt >= 1 - its repro summed a value at runtime and only the release
# profile's optimizer could prove the sum constant, so `debug` was silent there. The
# straight-line arithmetic below is provably constant from the moment the IR builder
# lowers it (confirmed with `--emit-ir`: `si_to_fp f64 100: i8` is already an
# immediate operand with no optimization pass run at all), so THIS case reaches
# MIR_SI_TO_FP / MIR_UI_TO_FP with an immediate source at every profile, `debug`
# included - a stronger pin than #2777's own repro, not a narrower one, and proof the
# defect was never actually tied to `-O2`, only to whichever path first proves a
# source constant. riscv64's `fcvt.{s,d}.{w,l}[u]` and arm64's SCVTF / UCVTF have no
# immediate form - both call `req_gpr` on the integer source and refuse it, so the
# build failed to COMPILE at all (not a wrong answer) on those two legs. x86-64 never
# noticed: it resolves the source through `emit_gp_load_ext`, which happens to
# materialize an immediate as a side effect of code nothing wrote for that reason.
#
# The fix states the constraint once, in the shared MIR contract
# (`mir.operand_requires_reg`), and `mir.lower`'s generic path moves any constant
# landing in such a slot into a fresh vreg before selection - the same treatment a
# symbol operand already gets there. This case exists to keep that constraint honest:
# it must fail to even LINK on unpatched riscv64/arm64, at every profile, and must
# print correct values on every leg once it does.
#
# COVERING THE CLASS, not the one shape #2777 happened to hit (an i64 source to f64).
# Both opcodes (MIR_SI_TO_FP and MIR_UI_TO_FP), both destination widths (f32 and f64),
# and four source widths per signedness (i8/i16/i32/i64, u8/u16/u32/u64) - the sub-word
# sources (1 and 2 bytes) each take a DIFFERENT branch in both encoders (a dedicated
# byte mask vs. a shift-pair) than the 4/8-byte sources do, so a fix that only
# materialized the common case could still leave either alone. The unsigned constants
# are chosen with their top bit set (u32 above 2^31, u64 above 2^63) so a UI_TO_FP
# wired to the signed conversion path by mistake would read back negative.
#
# Every constant is built from two `val`s combined by ordinary arithmetic rather than
# written as a single literal, so this pins the SHAPE (an immediate operand reaching a
# conversion the encoder has no immediate form for) rather than one specific literal
# an unrelated front-end special case might handle differently.
#
# every observable is a BIT PATTERN, target-independent, not float text.
#
# x86-64 OUTPUT MOVES, deliberately, and every conversion here gains exactly one
# instruction for it. Before the fix, `emit_gp_load_ext` received the MIR_OP_IMM
# directly and could bake the already sign/zero-extended value straight into R11 in
# one instruction (`movq $0x64, %r11`). After the fix, lowering has already moved the
# constant into a fresh, regalloc-assigned vreg before the encoder ever runs - and R11
# (`x64.SCRATCH_REG`) is reserved, excluded from general allocation, so the encoder
# can never receive the value already sitting there. It must copy from wherever
# regalloc put it (`movb $0x64, %al` / `movsbq %al, %r11` for a byte source; a
# same-width `mov` into a scratch GPR then a copy into R11 for 4/8-byte sources - see
# the PR for the full pre/post disassembly of every width in this case). Runtime
# output is bit-identical either way, checked against hand-computed IEEE-754 patterns
# above, not eyeballed. The old one-instruction path was the same accidental
# correctness this whole fix exists to remove - x86-64 happened to receive a shape two
# other backends could not encode at all - so trading it for one cold-path register
# move, in exchange for all three backends going through the same width-correct path,
# is the fix reaching exactly as far as it should, not further.

use std.runtime;
use std.types.size.usize;
use p: std.print;

fun si8_f64()  f64 { val a: i8  = 27;    val b: i8  = 127;    ret (b - a)::f64; }   # 100
fun si16_f64() f64 { val a: i16 = 2000;  val b: i16 = 766;    ret (b - a)::f64; }   # -1234
fun si32_f64() f64 { val a: i32 = 4;     val b: i32 = 7;      ret (a * b - 8)::f64; }   # 20
fun si64_f64() f64 { val a: i64 = 100000000000; val b: i64 = 23456789012; ret (a + b)::f64; }   # 123456789012

fun ui8_f64()  f64 { val a: u8  = 50;    val b: u8  = 150;    ret (a + b)::f64; }   # 200
fun ui16_f64() f64 { val a: u16 = 59000; val b: u16 = 1000;   ret (a + b)::f64; }   # 60000
fun ui32_f64() f64 { val a: u32 = 3000000000; val b: u32 = 1000000000; ret (a + b)::f64; }   # 4000000000
fun ui64_f64() f64 { val a: u64 = 9000000000000000000; val b: u64 = 9000000000000000000; ret (a + b)::f64; }   # 18000000000000000000

# the same two opcodes converting to the OTHER destination width (f32), so a fix
# keyed on `dst_w == 8` alone does not pass.
fun si32_f32() f32 { val a: i32 = 15; val b: i32 = 5; ret (a * b)::f32; }   # 75
fun ui32_f32() f32 { val a: u32 = 3000000000; val b: u32 = 1000000000; ret (a + b)::f32; }   # 4000000000, rounded

fun b64(f: f64) u64 { ret f:~u64; }
fun b32(f: f32) u32 { ret f:~u32; }

fun show64(name: *u8, f: f64) { p.printlnf("{}={:x}", name, b64(f)); }
fun show32(name: *u8, f: f32) { p.printlnf("{}={:x}", name, b32(f)::u64); }

#[symbol("main")]
fun main(argc: usize, argv: **u8) i64 {
    show64("si8",  si8_f64());
    show64("si16", si16_f64());
    show64("si32", si32_f64());
    show64("si64", si64_f64());
    show64("ui8",  ui8_f64());
    show64("ui16", ui16_f64());
    show64("ui32", ui32_f64());
    show64("ui64", ui64_f64());
    show32("si32f32", si32_f32());
    show32("ui32f32", ui32_f32());
    ret 0;
}
