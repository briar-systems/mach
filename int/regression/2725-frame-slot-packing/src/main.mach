# regression pin for #2725: a stack slot is placed at the FIRST address below the
# watermark that satisfies its own alignment
#
# `frame.place_slot` rounded a descending watermark with the ASCENDING idiom,
# `(base - mask) & ~mask`. Descending, clearing the low bits already moves away from
# what is above, so the `- mask` had nothing to correct and fired unconditionally:
# every slot whose base was already aligned lost a whole alignment unit. An 8-byte
# 8-aligned local occupied 16 bytes and every frame on every target was up to twice
# the size it needed to be.
#
# It is invisible to correctness - nothing overlapped, every offset stayed aligned,
# every access stayed in range - so a suite that only runs programs cannot see it.
# What this case observes is the SPACING of the slots themselves, read from the
# addresses at run time, which is the fact that moved.
#
# `pack` is the measurement: eight `i64` locals whose addresses are taken must span
# exactly 64 bytes. On the old rule they spanned 128.
#
# `mixed` is the correctness half, and it is where a packing change can go wrong.
# Tighter packing is exactly what turns a latent off-by-one into a live overwrite, so
# every local carries a value and a sentinel neighbour, and each address is checked
# against its OWN alignment. A frame of uniform `i64` would pass under several wrong
# rules; the alignments here run 1, 2, 4, 8, 16 and 32.

use std.runtime;
use std.types.size.usize;
use p: std.print;

#[align(32)]
rec Over { a: i64; b: i64; }

# the span of eight addressed 8-byte locals. 64 under the correct rule, 128 under the
# one #2725 fixed. the addresses are read at run time rather than predicted, so this
# measures the emitted frame rather than restating the layout rule.
fun pack() i64 {
    var a0: i64 = 0; var a1: i64 = 1; var a2: i64 = 2; var a3: i64 = 3;
    var a4: i64 = 4; var a5: i64 = 5; var a6: i64 = 6; var a7: i64 = 7;

    var ps: [8]usize;
    ps[0] = (?a0)::usize; ps[1] = (?a1)::usize;
    ps[2] = (?a2)::usize; ps[3] = (?a3)::usize;
    ps[4] = (?a4)::usize; ps[5] = (?a5)::usize;
    ps[6] = (?a6)::usize; ps[7] = (?a7)::usize;

    var lo: usize = ps[0];
    var hi: usize = ps[0];
    var i: usize = 1;
    for (i < 8) {
        if (ps[i] < lo) { lo = ps[i]; }
        if (ps[i] > hi) { hi = ps[i]; }
        i = i + 1;
    }

    # every local must still hold what it was given: a wrong offset is a silent
    # overwrite of a neighbour, and only reading them back catches that.
    if (a0 != 0 || a1 != 1 || a2 != 2 || a3 != 3) { ret -1; }
    if (a4 != 4 || a5 != 5 || a6 != 6 || a7 != 7) { ret -2; }

    ret (hi - lo + 8)::i64;
}

# alignment variety in one frame. each local's address must be a multiple of its own
# alignment, no two may overlap, and each must survive its neighbours being written.
fun mixed(seed: i64) i64 {
    var b0: u8   = (seed + 1)::u8;
    var s0: i64  = 0x7000;
    var h0: u16  = (seed + 2)::u16;
    var s1: i64  = 0x7001;
    var w0: u32  = (seed + 3)::u32;
    var s2: i64  = 0x7002;
    var q0: i64  = seed + 4;
    var s3: i64  = 0x7003;
    var v0: u32x4;
    var s4: i64  = 0x7004;
    var o0: Over;
    var s5: i64  = 0x7005;

    o0.a = seed + 5;
    o0.b = seed + 6;

    var addrs: [6]usize;
    var sizes: [6]usize;
    var wants: [6]usize;
    addrs[0] = (?b0)::usize; sizes[0] = 1;  wants[0] = 1;
    addrs[1] = (?h0)::usize; sizes[1] = 2;  wants[1] = 2;
    addrs[2] = (?w0)::usize; sizes[2] = 4;  wants[2] = 4;
    addrs[3] = (?q0)::usize; sizes[3] = 8;  wants[3] = 8;
    addrs[4] = (?v0)::usize; sizes[4] = 16; wants[4] = 16;
    addrs[5] = (?o0)::usize; sizes[5] = 32; wants[5] = 32;

    # each address is a multiple of its own alignment. an off-by-one in the OTHER
    # direction packs just as tightly and fails here. the over-aligned record is
    # checked at its declared 32: the frame pointer only ever carried the ABI's 16, so
    # this used to be checked at 16 and #2735 is the prologue realignment that made the
    # declared number the true one.
    var i: usize = 0;
    for (i < 6) {
        if ((addrs[i] & (wants[i] - 1)) != 0) { ret -10 - i::i64; }
        i = i + 1;
    }

    # no two overlap.
    var k: usize = 0;
    for (k < 6) {
        var n: usize = 0;
        for (n < 6) {
            if (n != k && addrs[k] < addrs[n] + sizes[n] && addrs[n] < addrs[k] + sizes[k]) {
                ret -20 - k::i64;
            }
            n = n + 1;
        }
        k = k + 1;
    }

    # the sentinels, and every value read back.
    if (s0 != 0x7000) { ret -30; }
    if (s1 != 0x7001) { ret -31; }
    if (s2 != 0x7002) { ret -32; }
    if (s3 != 0x7003) { ret -33; }
    if (s4 != 0x7004) { ret -34; }
    if (s5 != 0x7005) { ret -35; }
    if (b0 != (seed + 1)::u8)  { ret -40; }
    if (h0 != (seed + 2)::u16) { ret -41; }
    if (w0 != (seed + 3)::u32) { ret -42; }
    if (q0 != seed + 4)        { ret -43; }
    if (o0.a != seed + 5)      { ret -44; }
    if (o0.b != seed + 6)      { ret -45; }

    ret b0::i64 + h0::i64 + w0::i64 + q0 + o0.a + o0.b;
}

#[symbol("main")]
fun main(argc: usize, argv: **u8) i64 {
    p.printlnf("pack={}", pack());
    p.printlnf("mixed={}", mixed(3));
    ret 0;
}
