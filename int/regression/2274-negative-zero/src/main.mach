# regression pin for #2274: negative zero survives every path to a constant
#
# IEEE-754 unary negation is a sign-bit flip and is exact for every operand, zeros
# included, so `-0.0` must be 0x8000000000000000 (0x80000000 as an f32). Both
# constant folders spelled negation as `0.0 - x`, which is `+0.0` for either zero
# under round-to-nearest, so every folded `-0.0` silently became positive zero.
#
# EVERY observable here is a BIT PATTERN. `-0.0 == 0.0` is true in IEEE, so a check
# written with `==` passes while the bug is fully present and asserts nothing. The
# last two lines pin that equality and the additive-identity property that make the
# constant worth having.
#
# the golden is target-independent: bit patterns, not float text.

use std.runtime;
use std.types.size.usize;
use p: std.print;

# an opaque +0.0: a mutable global the constant folders cannot see through, so
# `-ZERO` is a genuine runtime negate rather than another folded constant
var ZERO: f64 = 0.0;
var ZERO32: f32 = 0.0;
var ONE: f64 = 1.0;

pub val MOD_PUB: f64 = -0.0;
val MOD_PRIV: f64 = -0.0;
pub val MOD_PUB32: f32 = -0.0;

val ARR: [2]f64 = [2]f64{ -0.0, 0.0 };
val ARR32: [2]f32 = [2]f32{ -0.0, 0.0 };

rec Pair { a: f64; b: f32; }
val REC: Pair = Pair{ a: -0.0, b: -0.0 };

val FOLD_PAREN: f64 = -(0.0);
val FOLD_TWICE: f64 = -(-0.0);
val FOLD_SUB: f64 = 0.0 - 0.0;

fun b64(f: f64) u64 { ret f:~u64; }
fun b32(f: f32) u32 { ret f:~u32; }

fun show64(name: *u8, f: f64) { p.printlnf("{}={:x}", name, b64(f)); }
fun show32(name: *u8, f: f32) { p.printlnf("{}={:x}", name, b32(f)::u64); }

#[symbol("main")]
fun main(argc: usize, argv: **u8) i64 {
    # literal forms, folded in the IR constant folder
    val lit: f64 = -0.0;
    var lit_var: f64 = -0.0;
    show64("f64.lit", lit);
    show64("f64.var", lit_var);

    # literal forms, folded in the comptime evaluator (never reach the IR pass)
    show64("f64.mod.pub", MOD_PUB);
    show64("f64.mod.priv", MOD_PRIV);
    show64("f64.arr.neg", ARR[0]);
    show64("f64.arr.pos", ARR[1]);
    show64("f64.rec", REC.a);
    show64("f64.fold.paren", FOLD_PAREN);

    # the issue's second spelling: negating a local `var` holding +0.0. mem2reg
    # promotes the slot to a constant, so this reaches the SAME constant folder as
    # the literal -- it is not a backend negate and was never a second defect
    var px: f64 = 0.0;
    show64("f64.promoted", -px);
    var px32: f32 = 0.0;
    show32("f32.promoted", -px32);

    # a genuine runtime negate: an opaque global the folders cannot see through,
    # and a computed zero. this is the backend FNEG, correct before the fix -- the
    # line pins that the fix did not disturb it
    show64("f64.rt.neg", -ZERO);
    show64("f64.rt.computed", -(ONE - 1.0));

    # negating a negative zero is positive zero, at comptime and at runtime
    show64("f64.fold.twice", FOLD_TWICE);
    show64("f64.rt.twice", -(-ZERO));

    # `0.0 - 0.0` is POSITIVE zero: subtraction is not negation, and the fix must
    # not make it one
    show64("f64.fold.sub", FOLD_SUB);

    # f32, every folded form plus the runtime negate
    val lit32: f32 = -0.0;
    show32("f32.lit", lit32);
    show32("f32.mod.pub", MOD_PUB32);
    show32("f32.arr.neg", ARR32[0]);
    show32("f32.arr.pos", ARR32[1]);
    show32("f32.rec", REC.b);
    show32("f32.rt.neg", -ZERO32);

    # width conversions carry the sign through
    show32("f32.from.f64", lit::f32);
    show64("f64.from.f32", lit32::f64);

    # nonzero negation is untouched
    show64("f64.neg.1p5", -1.5);
    show32("f32.neg.1p5", -1.5);

    # the two zeros compare EQUAL -- this is why a `==` test proves nothing
    var eq: i64 = 0;
    if (lit == 0.0) { eq = 1; }
    p.printlnf("eq={}", eq);

    # -0.0 is the exact additive identity: `x + (-0.0)` is x for every x, where
    # `(-0.0) + (+0.0)` is +0.0 and loses the sign
    show64("f64.id.pos", 3.5 + lit);
    show64("f64.id.neg", lit + lit);
    show64("f64.id.lost", lit + 0.0);

    ret 0;
}
