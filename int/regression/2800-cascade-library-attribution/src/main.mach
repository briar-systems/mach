# the consumer writes its own import and pins it to a logical library name that
# only the dependency's exported [link.m] carries (#2800)

use std.runtime;
use std.print;
use std.types.size.usize;

#[library("mathlib")]
ext fun cbrt(x: f64) f64;

#[symbol("main")]
fun main(argc: usize, argv: **u8) i64 {
    print.printlnf("cbrt={}", cbrt(27.0)::i64);
    ret 0;
}
