# regression pin for #2749: a LOOP-CARRIED vector value through an operator the
# target has no packed form for
#
# The gap expansion (#2726) replaces one vector operator with per-lane scalar work and
# an assembled vector, then points that operator's USES at the assembled value. It
# rewrote those uses one block at a time, immediately after expanding that block's
# body - which is correct for every use that follows its definition, and wrong for the
# one that does not. A loop header's phi names the value the LATCH defines, so its
# back-edge operand is a forward reference no block order removes.
#
# The result was a silent wrong ANSWER, not a crash. The phi kept naming the deleted
# multiply, MIR lowering turned the phi edge into a copy from a vreg nothing defines,
# and the accumulator came out holding whatever that register happened to be. Measured
# on `dev`, `linux-x86_64` printed the MULTIPLIER where the product belonged:
#
#     loop 5 2 3 2      (x86-64, wrong)
#     loop 75 4 63 4    (aarch64, right)
#
# aarch64 was right for a reason that has nothing to do with the bug: NEON has
# `MUL.4s`, so nothing expands there at all. That divergence is the whole shape of it
# - the defect is invisible on the target whose ISA happens to be complete, and every
# straight-line vector case in the suite passed on both.
#
# WHY A LOOP AND A NON-PACKED OPERATOR TOGETHER. Either alone is fine. `i32x4 * i32x4`
# is the pair that reaches it on x86-64 (SSE2 has no PMULLD; PMULLD is SSE4.1) and on
# riscv64 (no vector unit), while aarch64 packs it - so the same source exercises the
# expansion on two legs and the packed form on the third, and all three must print the
# same numbers. That equality is the assertion.
#
# EVERY LANE IS CHECKED AND EVERY LANE DIFFERS. A test that summed the lanes, or used
# the same value in each, would pass against the broken compiler on at least one of
# them: the wrong answer was `b`, and `b`'s lanes are as real as the product's.

use std.runtime;
use std.types.size.usize;
use std.types.string.str;
use p: std.print;

# the shape the bug lived in: an accumulator carried across a back edge through an
# operator with no packed form.
fun powv(a: i32x4, b: i32x4, n: i32) i32x4 {
    var acc: i32x4 = a;
    var i: i32 = 0;
    for (i < n) {
        acc = acc * b;
        i = i + 1;
    }
    ret acc;
}

# the same operator OUTSIDE a loop, which was always right, so a regression that
# broke the straight-line case is told apart from one that broke the carried case.
fun flat(a: i32x4, b: i32x4) i32x4 { ret a * b; }

# a second carried value beside the first, so a fix that repaired one phi by
# accident rather than the substitution in general does not pass. `sum` uses `+`,
# which every target packs, so this also pins that the expansion left the packed
# operator's own carried value alone.
fun mixed(a: i32x4, b: i32x4, n: i32) i32x4 {
    var prod: i32x4 = a;
    var sum: i32x4 = b;
    var i: i32 = 0;
    for (i < n) {
        prod = prod * b;
        sum = sum + a;
        i = i + 1;
    }
    ret prod - sum;
}

# a nested loop, where the inner accumulator's phi is reached from a block the outer
# loop's expansion also rewrote.
fun nested(a: i32x4, b: i32x4, n: i32) i32x4 {
    var acc: i32x4 = a;
    var i: i32 = 0;
    for (i < n) {
        var j: i32 = 0;
        for (j < n) {
            acc = acc * b;
            j = j + 1;
        }
        i = i + 1;
    }
    ret acc;
}

# 16-bit lanes, whose multiply x86-64 DOES pack (PMULLW) while riscv64 still
# scalarizes: the same source over a different realization split, so the equality
# across legs is asserted at two different packed/expanded boundaries.
fun powv16(a: i16x8, b: i16x8, n: i32) i16x8 {
    var acc: i16x8 = a;
    var i: i32 = 0;
    for (i < n) {
        acc = acc * b;
        i = i + 1;
    }
    ret acc;
}

fun v4(x0: i32, x1: i32, x2: i32, x3: i32) i32x4 {
    var v: i32x4;
    v[0] = x0; v[1] = x1; v[2] = x2; v[3] = x3;
    ret v;
}

fun show(tag: str, v: i32x4) {
    p.printlnf("{} {} {} {} {}", tag, v[0]::i64, v[1]::i64, v[2]::i64, v[3]::i64);
}

#[symbol("main")]
fun main(argc: usize, argv: **u8) i64 {
    val a: i32x4 = v4(3, 1, 7, 2);
    val b: i32x4 = v4(5, 2, 3, 4);

    show("flat", flat(a, b));
    show("powv0", powv(a, b, 0));
    show("powv1", powv(a, b, 1));
    show("powv2", powv(a, b, 2));
    show("mixed", mixed(a, b, 2));
    show("nested", nested(a, b, 2));

    var c: i16x8;
    var d: i16x8;
    c[0] = 1; c[1] = 2; c[2] = 3; c[3] = 4; c[4] = 5; c[5] = 6; c[6] = 7; c[7] = 8;
    d[0] = 2; d[1] = 3; d[2] = 1; d[3] = 2; d[4] = 3; d[5] = 1; d[6] = 2; d[7] = 3;
    val e: i16x8 = powv16(c, d, 2);
    p.printlnf("powv16 {} {} {} {} {} {} {} {}",
               e[0]::i64, e[1]::i64, e[2]::i64, e[3]::i64,
               e[4]::i64, e[5]::i64, e[6]::i64, e[7]::i64);
    ret 0;
}
