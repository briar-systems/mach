# the shape #2800 was reported as: an import pinned to a logical name the link
# provides as a static input, naming a symbol that archive does not define. the
# reporter's real fault was a misspelled entry point, which the old message hid
# behind a false claim that the library was not in the link at all.

use std.runtime;
use std.print;
use std.types.size.usize;

#[library("provider-lib")]
ext fun provider_valu() i32;

#[symbol("main")]
fun main(argc: usize, argv: **u8) i64 {
    print.printlnf("provider={}", provider_valu());
    ret 0;
}
