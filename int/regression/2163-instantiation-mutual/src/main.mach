# regression pin for #2163: mutual recursion between two generic families
#
# `ping[T]` names `pong[*T]` names `ping[**T]`. Mutual recursion at a FIXED
# argument terminates on the worklist's own dedup - the second `ping[T]` is a
# name it already holds - so what diverges here is the growing argument, and the
# chain the diagnostic names alternates between the two families.

fun ping[T]() {
    pong[*T]();
}

fun pong[T]() {
    ping[*T]();
}

fun main() i64 {
    ping[u32]();
    ret 0;
}
