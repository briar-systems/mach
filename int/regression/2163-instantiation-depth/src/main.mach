# regression pin for #2163: a generic that instantiates itself at a growing type
# argument is refused, not chased forever
#
# `deepen[T]` names `deepen[*T]`, so every instantiation is a new one and the
# monomorphizer's name dedup never fires. Before the depth limit this hung the
# compiler outright (the shipped v4.2.2 seed still does): the worklist grew until
# the process died, and its dedup is a linear scan, so it grew quadratically.
#
# The observable is the diagnostic, and it must name the CHAIN: a bare "limit
# exceeded" would not tell the author which family diverged.

fun deepen[T]() {
    deepen[*T]();
}

fun main() i64 {
    deepen[u32]();
    ret 0;
}
