# 2791-asm-noreturn regression case
#
# An inline-asm body that ends the thread of control terminates its block, and one
# that does not still falls through to the code after it.
#
# THE SECOND HALF IS THE ONE THAT CAN BITE. The conservatism here runs opposite to
# every other fact in the inline-asm effect model: a wrong `writes` costs allocation
# quality, but a body wrongly judged non-returning makes lowering DROP everything
# after it, which deletes live code. So this case is mostly about bodies that DO
# return - a syscall, a locked read-modify-write, a raw byte payload, a trap that is
# not last, a body defining a label - each followed by work whose result is printed.
# If any of them were misjudged, its line would go missing or come back wrong.
#
# The non-returning half is checked by reaching it deliberately at the end, and its
# assertion is an ABSENCE: `die` ends the process, so the line printed after the call
# never appears. A build that stopped emitting the body, or that let the block run on
# past it, prints that line and the golden fails.
#
# The sibling unit test `driver:asm_that_cannot_return_terminates_its_block` asserts
# the CFG directly. This case asserts that the model change did not alter behaviour.

use std.runtime;
use p: std.print;

# a syscall body returns; the addition after it must survive.
fun after_syscall(v: i64) i64 {
    var w: i64 = 0;
    $if ($mach.build.arch == $mach.arch.x86_64) {
        asm x86_64 {
            mov rax, {v}
            mov {w}, rax
        }
    }
    $or ($mach.build.arch == $mach.arch.aarch64) {
        asm aarch64 {
            ldr x9, {v}
            str x9, {w}
        }
    }
    $or ($mach.build.arch == $mach.arch.riscv64) {
        asm riscv64 {
            ld a0, {v}
            sd a0, {w}
        }
    }
    $or {
        $error("2791-asm-noreturn: unsupported architecture");
    }
    ret w + 1;
}

# a trap that is NOT the last statement leaves the body falling through, because
# control could reach the statements past it.
fun trap_not_last(v: i64) i64 {
    var w: i64 = 0;
    $if ($mach.build.arch == $mach.arch.x86_64) {
        asm x86_64 {
            jmp 1f
            hlt
        1:
            mov rax, {v}
            mov {w}, rax
        }
    }
    $or ($mach.build.arch == $mach.arch.aarch64) {
        asm aarch64 {
            b 1f
            brk 0
        1:
            ldr x9, {v}
            str x9, {w}
        }
    }
    $or ($mach.build.arch == $mach.arch.riscv64) {
        asm riscv64 {
            j 1f
            ebreak
        1:
            ld a0, {v}
            sd a0, {w}
        }
    }
    $or {
        $error("2791-asm-noreturn: unsupported architecture");
    }
    ret w + 2;
}

# a raw byte payload is never judged non-returning: the compiler does not decode it.
# these bytes are a no-op on each target, and the work after them must survive.
fun after_bytes(v: i64) i64 {
    $if ($mach.build.arch == $mach.arch.x86_64) {
        asm x86_64 { .byte 0x90 }
    }
    $or ($mach.build.arch == $mach.arch.aarch64) {
        asm aarch64 { .word 0xd503201f }
    }
    $or ($mach.build.arch == $mach.arch.riscv64) {
        asm riscv64 { .word 0x00000013 }
    }
    $or {
        $error("2791-asm-noreturn: unsupported architecture");
    }
    ret v + 3;
}

# the non-returning shape itself, reached only at the very end. it exits cleanly so the
# observable is the stdout above plus the ABSENCE of the line after the call.
fun die() {
    $if ($mach.build.os == $mach.os.darwin && $mach.build.arch == $mach.arch.x86_64) {
        asm x86_64 {
            mov eax, 0x2000001
            mov edi, 0
            syscall
            hlt
        }
    }
    $or ($mach.build.os == $mach.os.darwin && $mach.build.arch == $mach.arch.aarch64) {
        asm aarch64 {
            mov x16, 1
            mov x0, 0
            svc 0x80
            brk 0
        }
    }
    $or ($mach.build.arch == $mach.arch.x86_64) {
        asm x86_64 {
            mov eax, 231
            mov edi, 0
            syscall
            hlt
        }
    }
    $or ($mach.build.arch == $mach.arch.aarch64) {
        asm aarch64 {
            mov x8, 94
            mov x0, 0
            svc 0
            brk 0
        }
    }
    $or ($mach.build.arch == $mach.arch.riscv64) {
        asm riscv64 {
            li a7, 94
            li a0, 0
            ecall
            ebreak
        }
    }
    $or {
        $error("2791-asm-noreturn: unsupported architecture");
    }
}

#[symbol("main")]
fun main() i64 {
    p.printlnf("sys={}", after_syscall(10));
    p.printlnf("notlast={}", trap_not_last(20));
    p.printlnf("bytes={}", after_bytes(30));
    die();
    # unreachable: `die` ends the process. reaching it would print and change the
    # observable, so its absence is itself an assertion.
    p.printlnf("reached_after_die={}", 1);
    ret 0;
}
