# regression pin for #2536: a program can ask a value how long it is
#
# `$size_of` took a type, and a binding's type has no spelling -- `val LOGO: [_]u8`
# really is a concrete `[19]u8` that cannot be written. so an `#[embed]` could be
# indexed and passed around and never iterated, because the length the compiler
# already knew was unreachable from source.
#
# every length here is different, and none of them is 4. an element count, a byte
# count, a lane count and a hardcoded constant all coincide on a length-4 `u8`
# array, which is exactly why nothing here is one.

use std.runtime;
use p: std.print;

rec Pt { x: i64; y: i64; }

val SEVEN: [7]u8  = [7]u8{1, 2, 3, 4, 5, 6, 7};
val THREE: [3]i64 = [3]i64{10, 20, 30};
val FIVE:  [5]Pt  = [5]Pt{Pt{x: 1, y: 2}, Pt{x: 3, y: 4}, Pt{x: 5, y: 6}, Pt{x: 7, y: 8}, Pt{x: 9, y: 10}};

# a length folded from another binding's length, in a TYPE position
val COPY: [$length_of(THREE)]i64 = [3]i64{7, 8, 9};

# the motivating case: the length is inferred from the file and never written
#[embed("assets/blob.bin")]
val BLOB: [_]u8;

# iterating a binding whose length has no spelling, which is the whole point
fun sum_blob() u64 {
    var total: u64 = 0;
    var i:     u64 = 0;
    for (i < $length_of(BLOB)) {
        total = total + BLOB[i]::u64;
        i     = i + 1;
    }
    ret total;
}

# a parameter is a binding too, and its length comes from the declaration
fun sum_five(v: [5]Pt) i64 {
    var total: i64 = 0;
    var i:     u64 = 0;
    for (i < $length_of(v)) {
        total = total + v[i].x + v[i].y;
        i     = i + 1;
    }
    ret total;
}

#[symbol("main")]
pub fun main(argc: i64, argv: **u8) i64 {
    # ELEMENTS AND BYTES, side by side. they agree only on the `u8` array, which is
    # the coincidence that would hide a conflated implementation.
    p.printf("SEVEN {} {}\n", $length_of(SEVEN), $size_of(SEVEN));
    p.printf("THREE {} {}\n", $length_of(THREE), $size_of(THREE));
    p.printf("FIVE {} {}\n",  $length_of(FIVE),  $size_of(FIVE));
    p.printf("COPY {} {}\n",  $length_of(COPY),  $size_of(COPY));
    p.printf("BLOB {} {}\n",  $length_of(BLOB),  $size_of(BLOB));

    # a type operand still works, and a vector's length is its lane count
    p.printf("TYPE {} {}\n", $length_of([13]u32), $size_of([13]u32));
    p.printf("LANES {} {}\n", $length_of(u8x16), $size_of(u8x16));
    p.printf("LANES {} {}\n", $length_of(f64x2), $size_of(f64x2));

    p.printf("blob sum {}\n", sum_blob());
    p.printf("five sum {}\n", sum_five(FIVE));

    var total: i64 = 0;
    var i: u64 = 0;
    for (i < $length_of(COPY)) { total = total + COPY[i]; i = i + 1; }
    p.printf("copy sum {}\n", total);
    ret 0;
}
