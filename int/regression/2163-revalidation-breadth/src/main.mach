# regression pin for #2163: the re-validation drain's breadth, which its depth
# bound cannot see
#
# `spread[T]` re-validates into TWO strictly larger instances of itself, so the
# recorded set grows 2^depth while every chain stays far inside the depth bound.
# The worklist dedups by a linear scan over (origin, decl, args), so this is
# quadratic on top of exponential. The count limit is what refuses it, and the
# `^` is what routes the family to this engine at all (see the depth case).

fun spread[T](x: ^u32) {
    spread[*T](x);
    spread[[2]T](x);
}

fun main() i64 {
    var s: ^u32 = 1;
    spread[u32](s);
    ret 0;
}
