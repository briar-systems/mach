# regression pin for #2689: an inline-asm `{name}` slot's reach
#
# a `{name}` was addressed frame-pointer-relative. slots sit BELOW the frame pointer, so
# the displacement is negative, and aarch64's scaled imm12 form is unsigned-only - the
# whole reach was the unscaled imm9's -256. these locals are 16 bytes apart, so the
# seventeenth bound slot in a function landed at -272 and the build was REFUSED:
#
#   encode: inline-asm ldr/str offset 272 is out of range for both immediate forms
#
# the fix measures a `{name}` from the STACK pointer, with the frame phase laying
# asm-bound slots at the bottom of the slot region - the end the stack pointer sits at -
# so the displacement is positive, small, and independent of how deep the frame is.
#
# the case runs both sides of the old line. `edge` is sixteen bound slots, the last count
# that built before the fix, and must still produce the same answer; `deep` is forty in a
# frame with a thousand ordinary words under them, which did not build at all. the
# sentinels are the point: an out-of-reach offset is a BUILD failure, but a wrongly based
# one is a silent write to a neighbouring slot, and only a neighbour that checks its own
# value catches that.

use std.runtime;
use std.types.size.usize;
use p: std.print;

fun edge(seed: i64) i64 {

    # each `a` is bound by an asm block; each `g` is an ordinary local carrying a
    # sentinel, declared between them so it neighbours one in the laid-out frame. a
    # `{name}` resolved to a wrong address lands on a neighbour, so the sentinels are
    # what turns a wrong address into a visible failure rather than a right answer.
    var a0: i64 = seed + 0;
    var g0: i64 = 0x7000 + 0;
    var a1: i64 = seed + 1;
    var g1: i64 = 0x7000 + 1;
    var a2: i64 = seed + 2;
    var g2: i64 = 0x7000 + 2;
    var a3: i64 = seed + 3;
    var g3: i64 = 0x7000 + 3;
    var a4: i64 = seed + 4;
    var g4: i64 = 0x7000 + 4;
    var a5: i64 = seed + 5;
    var g5: i64 = 0x7000 + 5;
    var a6: i64 = seed + 6;
    var g6: i64 = 0x7000 + 6;
    var a7: i64 = seed + 7;
    var g7: i64 = 0x7000 + 7;
    var a8: i64 = seed + 8;
    var g8: i64 = 0x7000 + 8;
    var a9: i64 = seed + 9;
    var g9: i64 = 0x7000 + 9;
    var a10: i64 = seed + 10;
    var g10: i64 = 0x7000 + 10;
    var a11: i64 = seed + 11;
    var g11: i64 = 0x7000 + 11;
    var a12: i64 = seed + 12;
    var g12: i64 = 0x7000 + 12;
    var a13: i64 = seed + 13;
    var g13: i64 = 0x7000 + 13;
    var a14: i64 = seed + 14;
    var g14: i64 = 0x7000 + 14;
    var a15: i64 = seed + 15;
    var g15: i64 = 0x7000 + 15;

    $if ($mach.build.arch == $mach.arch.x86_64) {
        asm x86_64 {
            mov rax, {a0}
            add rax, 1
            mov {a0}, rax
        }
    }
    $or ($mach.build.arch == $mach.arch.aarch64) {
        asm aarch64 {
            ldr x9, {a0}
            add x9, x9, 1
            str x9, {a0}
        }
    }
    $or ($mach.build.arch == $mach.arch.riscv64) {
        asm riscv64 {
            ld t0, {a0}
            addi t0, t0, 1
            sd t0, {a0}
        }
    }
    $if ($mach.build.arch == $mach.arch.x86_64) {
        asm x86_64 {
            mov rax, {a1}
            add rax, 1
            mov {a1}, rax
        }
    }
    $or ($mach.build.arch == $mach.arch.aarch64) {
        asm aarch64 {
            ldr x9, {a1}
            add x9, x9, 1
            str x9, {a1}
        }
    }
    $or ($mach.build.arch == $mach.arch.riscv64) {
        asm riscv64 {
            ld t0, {a1}
            addi t0, t0, 1
            sd t0, {a1}
        }
    }
    $if ($mach.build.arch == $mach.arch.x86_64) {
        asm x86_64 {
            mov rax, {a2}
            add rax, 1
            mov {a2}, rax
        }
    }
    $or ($mach.build.arch == $mach.arch.aarch64) {
        asm aarch64 {
            ldr x9, {a2}
            add x9, x9, 1
            str x9, {a2}
        }
    }
    $or ($mach.build.arch == $mach.arch.riscv64) {
        asm riscv64 {
            ld t0, {a2}
            addi t0, t0, 1
            sd t0, {a2}
        }
    }
    $if ($mach.build.arch == $mach.arch.x86_64) {
        asm x86_64 {
            mov rax, {a3}
            add rax, 1
            mov {a3}, rax
        }
    }
    $or ($mach.build.arch == $mach.arch.aarch64) {
        asm aarch64 {
            ldr x9, {a3}
            add x9, x9, 1
            str x9, {a3}
        }
    }
    $or ($mach.build.arch == $mach.arch.riscv64) {
        asm riscv64 {
            ld t0, {a3}
            addi t0, t0, 1
            sd t0, {a3}
        }
    }
    $if ($mach.build.arch == $mach.arch.x86_64) {
        asm x86_64 {
            mov rax, {a4}
            add rax, 1
            mov {a4}, rax
        }
    }
    $or ($mach.build.arch == $mach.arch.aarch64) {
        asm aarch64 {
            ldr x9, {a4}
            add x9, x9, 1
            str x9, {a4}
        }
    }
    $or ($mach.build.arch == $mach.arch.riscv64) {
        asm riscv64 {
            ld t0, {a4}
            addi t0, t0, 1
            sd t0, {a4}
        }
    }
    $if ($mach.build.arch == $mach.arch.x86_64) {
        asm x86_64 {
            mov rax, {a5}
            add rax, 1
            mov {a5}, rax
        }
    }
    $or ($mach.build.arch == $mach.arch.aarch64) {
        asm aarch64 {
            ldr x9, {a5}
            add x9, x9, 1
            str x9, {a5}
        }
    }
    $or ($mach.build.arch == $mach.arch.riscv64) {
        asm riscv64 {
            ld t0, {a5}
            addi t0, t0, 1
            sd t0, {a5}
        }
    }
    $if ($mach.build.arch == $mach.arch.x86_64) {
        asm x86_64 {
            mov rax, {a6}
            add rax, 1
            mov {a6}, rax
        }
    }
    $or ($mach.build.arch == $mach.arch.aarch64) {
        asm aarch64 {
            ldr x9, {a6}
            add x9, x9, 1
            str x9, {a6}
        }
    }
    $or ($mach.build.arch == $mach.arch.riscv64) {
        asm riscv64 {
            ld t0, {a6}
            addi t0, t0, 1
            sd t0, {a6}
        }
    }
    $if ($mach.build.arch == $mach.arch.x86_64) {
        asm x86_64 {
            mov rax, {a7}
            add rax, 1
            mov {a7}, rax
        }
    }
    $or ($mach.build.arch == $mach.arch.aarch64) {
        asm aarch64 {
            ldr x9, {a7}
            add x9, x9, 1
            str x9, {a7}
        }
    }
    $or ($mach.build.arch == $mach.arch.riscv64) {
        asm riscv64 {
            ld t0, {a7}
            addi t0, t0, 1
            sd t0, {a7}
        }
    }
    $if ($mach.build.arch == $mach.arch.x86_64) {
        asm x86_64 {
            mov rax, {a8}
            add rax, 1
            mov {a8}, rax
        }
    }
    $or ($mach.build.arch == $mach.arch.aarch64) {
        asm aarch64 {
            ldr x9, {a8}
            add x9, x9, 1
            str x9, {a8}
        }
    }
    $or ($mach.build.arch == $mach.arch.riscv64) {
        asm riscv64 {
            ld t0, {a8}
            addi t0, t0, 1
            sd t0, {a8}
        }
    }
    $if ($mach.build.arch == $mach.arch.x86_64) {
        asm x86_64 {
            mov rax, {a9}
            add rax, 1
            mov {a9}, rax
        }
    }
    $or ($mach.build.arch == $mach.arch.aarch64) {
        asm aarch64 {
            ldr x9, {a9}
            add x9, x9, 1
            str x9, {a9}
        }
    }
    $or ($mach.build.arch == $mach.arch.riscv64) {
        asm riscv64 {
            ld t0, {a9}
            addi t0, t0, 1
            sd t0, {a9}
        }
    }
    $if ($mach.build.arch == $mach.arch.x86_64) {
        asm x86_64 {
            mov rax, {a10}
            add rax, 1
            mov {a10}, rax
        }
    }
    $or ($mach.build.arch == $mach.arch.aarch64) {
        asm aarch64 {
            ldr x9, {a10}
            add x9, x9, 1
            str x9, {a10}
        }
    }
    $or ($mach.build.arch == $mach.arch.riscv64) {
        asm riscv64 {
            ld t0, {a10}
            addi t0, t0, 1
            sd t0, {a10}
        }
    }
    $if ($mach.build.arch == $mach.arch.x86_64) {
        asm x86_64 {
            mov rax, {a11}
            add rax, 1
            mov {a11}, rax
        }
    }
    $or ($mach.build.arch == $mach.arch.aarch64) {
        asm aarch64 {
            ldr x9, {a11}
            add x9, x9, 1
            str x9, {a11}
        }
    }
    $or ($mach.build.arch == $mach.arch.riscv64) {
        asm riscv64 {
            ld t0, {a11}
            addi t0, t0, 1
            sd t0, {a11}
        }
    }
    $if ($mach.build.arch == $mach.arch.x86_64) {
        asm x86_64 {
            mov rax, {a12}
            add rax, 1
            mov {a12}, rax
        }
    }
    $or ($mach.build.arch == $mach.arch.aarch64) {
        asm aarch64 {
            ldr x9, {a12}
            add x9, x9, 1
            str x9, {a12}
        }
    }
    $or ($mach.build.arch == $mach.arch.riscv64) {
        asm riscv64 {
            ld t0, {a12}
            addi t0, t0, 1
            sd t0, {a12}
        }
    }
    $if ($mach.build.arch == $mach.arch.x86_64) {
        asm x86_64 {
            mov rax, {a13}
            add rax, 1
            mov {a13}, rax
        }
    }
    $or ($mach.build.arch == $mach.arch.aarch64) {
        asm aarch64 {
            ldr x9, {a13}
            add x9, x9, 1
            str x9, {a13}
        }
    }
    $or ($mach.build.arch == $mach.arch.riscv64) {
        asm riscv64 {
            ld t0, {a13}
            addi t0, t0, 1
            sd t0, {a13}
        }
    }
    $if ($mach.build.arch == $mach.arch.x86_64) {
        asm x86_64 {
            mov rax, {a14}
            add rax, 1
            mov {a14}, rax
        }
    }
    $or ($mach.build.arch == $mach.arch.aarch64) {
        asm aarch64 {
            ldr x9, {a14}
            add x9, x9, 1
            str x9, {a14}
        }
    }
    $or ($mach.build.arch == $mach.arch.riscv64) {
        asm riscv64 {
            ld t0, {a14}
            addi t0, t0, 1
            sd t0, {a14}
        }
    }
    $if ($mach.build.arch == $mach.arch.x86_64) {
        asm x86_64 {
            mov rax, {a15}
            add rax, 1
            mov {a15}, rax
        }
    }
    $or ($mach.build.arch == $mach.arch.aarch64) {
        asm aarch64 {
            ldr x9, {a15}
            add x9, x9, 1
            str x9, {a15}
        }
    }
    $or ($mach.build.arch == $mach.arch.riscv64) {
        asm riscv64 {
            ld t0, {a15}
            addi t0, t0, 1
            sd t0, {a15}
        }
    }

    var sum: i64 = 0;
    if (a0 != seed + 0 + 1) { ret -1; }
    if (g0 != 0x7000 + 0)   { ret -2; }
    sum = sum + a0;
    if (a1 != seed + 1 + 1) { ret -1; }
    if (g1 != 0x7000 + 1)   { ret -2; }
    sum = sum + a1;
    if (a2 != seed + 2 + 1) { ret -1; }
    if (g2 != 0x7000 + 2)   { ret -2; }
    sum = sum + a2;
    if (a3 != seed + 3 + 1) { ret -1; }
    if (g3 != 0x7000 + 3)   { ret -2; }
    sum = sum + a3;
    if (a4 != seed + 4 + 1) { ret -1; }
    if (g4 != 0x7000 + 4)   { ret -2; }
    sum = sum + a4;
    if (a5 != seed + 5 + 1) { ret -1; }
    if (g5 != 0x7000 + 5)   { ret -2; }
    sum = sum + a5;
    if (a6 != seed + 6 + 1) { ret -1; }
    if (g6 != 0x7000 + 6)   { ret -2; }
    sum = sum + a6;
    if (a7 != seed + 7 + 1) { ret -1; }
    if (g7 != 0x7000 + 7)   { ret -2; }
    sum = sum + a7;
    if (a8 != seed + 8 + 1) { ret -1; }
    if (g8 != 0x7000 + 8)   { ret -2; }
    sum = sum + a8;
    if (a9 != seed + 9 + 1) { ret -1; }
    if (g9 != 0x7000 + 9)   { ret -2; }
    sum = sum + a9;
    if (a10 != seed + 10 + 1) { ret -1; }
    if (g10 != 0x7000 + 10)   { ret -2; }
    sum = sum + a10;
    if (a11 != seed + 11 + 1) { ret -1; }
    if (g11 != 0x7000 + 11)   { ret -2; }
    sum = sum + a11;
    if (a12 != seed + 12 + 1) { ret -1; }
    if (g12 != 0x7000 + 12)   { ret -2; }
    sum = sum + a12;
    if (a13 != seed + 13 + 1) { ret -1; }
    if (g13 != 0x7000 + 13)   { ret -2; }
    sum = sum + a13;
    if (a14 != seed + 14 + 1) { ret -1; }
    if (g14 != 0x7000 + 14)   { ret -2; }
    sum = sum + a14;
    if (a15 != seed + 15 + 1) { ret -1; }
    if (g15 != 0x7000 + 15)   { ret -2; }
    sum = sum + a15;
    ret sum;
}

fun deep(seed: i64) i64 {
    # a deep ordinary frame under the bound slots. before #2689 the bound slots sat
    # nearest the frame pointer to stay in reach, so this alone did not break them -
    # what broke them was the COUNT of bound slots below. it is here so the case also
    # pins the property the fix is really about: reach independent of frame size.
    var pad: [1000]i64;
    var pi: usize = 0;
    for (pi < 1000) { pad[pi] = 0x5A5A0000 + pi::i64; pi = pi + 1; }

    # each `a` is bound by an asm block; each `g` is an ordinary local carrying a
    # sentinel, declared between them so it neighbours one in the laid-out frame. a
    # `{name}` resolved to a wrong address lands on a neighbour, so the sentinels are
    # what turns a wrong address into a visible failure rather than a right answer.
    var a0: i64 = seed + 0;
    var g0: i64 = 0x7000 + 0;
    var a1: i64 = seed + 1;
    var g1: i64 = 0x7000 + 1;
    var a2: i64 = seed + 2;
    var g2: i64 = 0x7000 + 2;
    var a3: i64 = seed + 3;
    var g3: i64 = 0x7000 + 3;
    var a4: i64 = seed + 4;
    var g4: i64 = 0x7000 + 4;
    var a5: i64 = seed + 5;
    var g5: i64 = 0x7000 + 5;
    var a6: i64 = seed + 6;
    var g6: i64 = 0x7000 + 6;
    var a7: i64 = seed + 7;
    var g7: i64 = 0x7000 + 7;
    var a8: i64 = seed + 8;
    var g8: i64 = 0x7000 + 8;
    var a9: i64 = seed + 9;
    var g9: i64 = 0x7000 + 9;
    var a10: i64 = seed + 10;
    var g10: i64 = 0x7000 + 10;
    var a11: i64 = seed + 11;
    var g11: i64 = 0x7000 + 11;
    var a12: i64 = seed + 12;
    var g12: i64 = 0x7000 + 12;
    var a13: i64 = seed + 13;
    var g13: i64 = 0x7000 + 13;
    var a14: i64 = seed + 14;
    var g14: i64 = 0x7000 + 14;
    var a15: i64 = seed + 15;
    var g15: i64 = 0x7000 + 15;
    var a16: i64 = seed + 16;
    var g16: i64 = 0x7000 + 16;
    var a17: i64 = seed + 17;
    var g17: i64 = 0x7000 + 17;
    var a18: i64 = seed + 18;
    var g18: i64 = 0x7000 + 18;
    var a19: i64 = seed + 19;
    var g19: i64 = 0x7000 + 19;
    var a20: i64 = seed + 20;
    var g20: i64 = 0x7000 + 20;
    var a21: i64 = seed + 21;
    var g21: i64 = 0x7000 + 21;
    var a22: i64 = seed + 22;
    var g22: i64 = 0x7000 + 22;
    var a23: i64 = seed + 23;
    var g23: i64 = 0x7000 + 23;
    var a24: i64 = seed + 24;
    var g24: i64 = 0x7000 + 24;
    var a25: i64 = seed + 25;
    var g25: i64 = 0x7000 + 25;
    var a26: i64 = seed + 26;
    var g26: i64 = 0x7000 + 26;
    var a27: i64 = seed + 27;
    var g27: i64 = 0x7000 + 27;
    var a28: i64 = seed + 28;
    var g28: i64 = 0x7000 + 28;
    var a29: i64 = seed + 29;
    var g29: i64 = 0x7000 + 29;
    var a30: i64 = seed + 30;
    var g30: i64 = 0x7000 + 30;
    var a31: i64 = seed + 31;
    var g31: i64 = 0x7000 + 31;
    var a32: i64 = seed + 32;
    var g32: i64 = 0x7000 + 32;
    var a33: i64 = seed + 33;
    var g33: i64 = 0x7000 + 33;
    var a34: i64 = seed + 34;
    var g34: i64 = 0x7000 + 34;
    var a35: i64 = seed + 35;
    var g35: i64 = 0x7000 + 35;
    var a36: i64 = seed + 36;
    var g36: i64 = 0x7000 + 36;
    var a37: i64 = seed + 37;
    var g37: i64 = 0x7000 + 37;
    var a38: i64 = seed + 38;
    var g38: i64 = 0x7000 + 38;
    var a39: i64 = seed + 39;
    var g39: i64 = 0x7000 + 39;

    $if ($mach.build.arch == $mach.arch.x86_64) {
        asm x86_64 {
            mov rax, {a0}
            add rax, 1
            mov {a0}, rax
        }
    }
    $or ($mach.build.arch == $mach.arch.aarch64) {
        asm aarch64 {
            ldr x9, {a0}
            add x9, x9, 1
            str x9, {a0}
        }
    }
    $or ($mach.build.arch == $mach.arch.riscv64) {
        asm riscv64 {
            ld t0, {a0}
            addi t0, t0, 1
            sd t0, {a0}
        }
    }
    $if ($mach.build.arch == $mach.arch.x86_64) {
        asm x86_64 {
            mov rax, {a1}
            add rax, 1
            mov {a1}, rax
        }
    }
    $or ($mach.build.arch == $mach.arch.aarch64) {
        asm aarch64 {
            ldr x9, {a1}
            add x9, x9, 1
            str x9, {a1}
        }
    }
    $or ($mach.build.arch == $mach.arch.riscv64) {
        asm riscv64 {
            ld t0, {a1}
            addi t0, t0, 1
            sd t0, {a1}
        }
    }
    $if ($mach.build.arch == $mach.arch.x86_64) {
        asm x86_64 {
            mov rax, {a2}
            add rax, 1
            mov {a2}, rax
        }
    }
    $or ($mach.build.arch == $mach.arch.aarch64) {
        asm aarch64 {
            ldr x9, {a2}
            add x9, x9, 1
            str x9, {a2}
        }
    }
    $or ($mach.build.arch == $mach.arch.riscv64) {
        asm riscv64 {
            ld t0, {a2}
            addi t0, t0, 1
            sd t0, {a2}
        }
    }
    $if ($mach.build.arch == $mach.arch.x86_64) {
        asm x86_64 {
            mov rax, {a3}
            add rax, 1
            mov {a3}, rax
        }
    }
    $or ($mach.build.arch == $mach.arch.aarch64) {
        asm aarch64 {
            ldr x9, {a3}
            add x9, x9, 1
            str x9, {a3}
        }
    }
    $or ($mach.build.arch == $mach.arch.riscv64) {
        asm riscv64 {
            ld t0, {a3}
            addi t0, t0, 1
            sd t0, {a3}
        }
    }
    $if ($mach.build.arch == $mach.arch.x86_64) {
        asm x86_64 {
            mov rax, {a4}
            add rax, 1
            mov {a4}, rax
        }
    }
    $or ($mach.build.arch == $mach.arch.aarch64) {
        asm aarch64 {
            ldr x9, {a4}
            add x9, x9, 1
            str x9, {a4}
        }
    }
    $or ($mach.build.arch == $mach.arch.riscv64) {
        asm riscv64 {
            ld t0, {a4}
            addi t0, t0, 1
            sd t0, {a4}
        }
    }
    $if ($mach.build.arch == $mach.arch.x86_64) {
        asm x86_64 {
            mov rax, {a5}
            add rax, 1
            mov {a5}, rax
        }
    }
    $or ($mach.build.arch == $mach.arch.aarch64) {
        asm aarch64 {
            ldr x9, {a5}
            add x9, x9, 1
            str x9, {a5}
        }
    }
    $or ($mach.build.arch == $mach.arch.riscv64) {
        asm riscv64 {
            ld t0, {a5}
            addi t0, t0, 1
            sd t0, {a5}
