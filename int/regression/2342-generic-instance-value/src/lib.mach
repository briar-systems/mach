# a second module, so the cross-module (SYM_IMPORTED) leg of both readings is
# exercised: a generic named as a value through an import, and an imported array
# indexed by a NAME - the shape whose bracket reads as both a type-argument list
# and a subscript, and which the value-position predicate must still call a
# subscript.
#
# `first` and `second` share one signature and disagree on every input, so a table
# holding both instances distinguishes reaching the right instance from merely
# reaching a function of the right type.

pub fun first[T](a: T, b: T) T { ret a; }

pub fun second[T](a: T, b: T) T { ret b; }

pub val ARR: [4]i64 = [4]i64{100, 200, 300, 400};
