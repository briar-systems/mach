# regression pin for #2342: a generic instance named as a VALUE.
#
# before this, type arguments were spellable only in callee position - `f[i64](x)`
# parsed, but `f[i64]` in a value slot was read as the index expression `f[i64]`
# and died in resolve on `i64` as an unresolved identifier. so a generic could not
# be stored in a function pointer, passed as a callback, returned, or put in a
# table, and `?f[i64]` was not an address of anything.
#
# every row below is a value-position spelling. the printed answers are the point:
# a value form that reached the WRONG instance (or the bare template) would still
# link and still print, so identity is checked by calling through the value and
# comparing against the call form's answer, and by comparing addresses.
#
# the last three rows are the other direction - ordinary subscripts whose payload
# also reads as a type-argument list. they are here because the value form makes
# EVERY bracket in the language run the two probes, so the reading that was always
# a subscript must still be one, including through an import.

use std.runtime;
use std.types.size.usize;
use p: std.print;
use case2342.lib;

fun ident[T](s: T) T { ret s; }

fun apply(f: fun(i64) i64, x: i64) i64 { ret f(x); }

# an instance returned from a non-generic function: the value crosses a call
# boundary before it is called.
fun pick() fun(i64) i64 { ret ident[i64]; }

# an instance selected from a table of them, so the value is stored in memory
# rather than living in a register for its whole life. the two entries disagree on
# every input, so a table that reached one instance twice is visible.
fun from_table(which: usize, a: i64, b: i64) i64 {
    val tbl: [2]fun(i64, i64) i64 = [2]fun(i64, i64) i64{lib.first[i64], lib.second[i64]};
    ret tbl[which](a, b);
}

#[symbol("main")]
fun main(argc: usize, argv: **u8) i64 {
    # stored in a binding of the instantiated signature, then called through it.
    val f: fun(i64) i64 = ident[i64];
    p.printlnf("stored={} call={}", f(7), ident[i64](7));

    # a DIFFERENT instantiation of the same template, named the same way: the two
    # values must be distinct functions, which a template-reaching lowering would
    # collapse.
    val g: fun(u32) u32 = ident[u32];
    p.printlnf("other={}", g(9::u32));

    # passed as a callback argument.
    p.printlnf("passed={}", apply(ident[i64], 11));

    # returned from a function, then called.
    val r: fun(i64) i64 = pick();
    p.printlnf("returned={}", r(13));

    # through an import: the generic is declared in another module.
    val t: fun(i64, i64) i64 = lib.second[i64];
    p.printlnf("imported={} call={}", t(21, 22), lib.second[i64](21, 22));

    # from a table in memory, both entries.
    p.printlnf("table={} {}", from_table(0, 5, 6), from_table(1, 5, 6));

    # `?f[i64]` is the address of the INSTANCE. it must equal the address the
    # binding holds, and must differ from another instantiation's address.
    val a: ptr = ?ident[i64];
    val b: ptr = ?ident[u32];
    p.printlnf("addr_nonnil={} addr_same={} addr_distinct={}",
               a != nil, a == f::ptr, a != b);

    # ---- the subscript reading, unchanged ----

    val i: usize = 2;
    val arr: [4]i64 = [4]i64{10, 20, 30, 40};
    p.printlnf("index_local={}", arr[i]);
    p.printlnf("index_imported={}", lib.ARR[i]);

    # a subscript whose object is a POINTER and whose payload is a bare name.
    val q: *i64 = ?arr[0];
    p.printlnf("index_ptr={}", q[i]);
    ret 0;
}
