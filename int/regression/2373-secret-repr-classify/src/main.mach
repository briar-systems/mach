# regression pin for #2373: a `^` secret type's machine shape
#
# `scalar_bits` / `is_signed_type` / `is_float_type` answer questions about a type's
# REPRESENTATION, and secrecy has none - `^T` lowers to exactly `T`'s machine shape.
# all three read `prim_desc` off the raw TypeId, and a secret type's kind is
# TYPE_SECRET, a wrapper, so every PrimDesc field came back as the zero value: width
# 0, unsigned, class none.
#
# that was wrong in two directions, and the case pins both against their PUBLIC
# TWINS - every secret row is stated beside the identical public expression, so a
# regression shows up as the two disagreeing rather than as a number someone has to
# recompute.
#
#   SIGNEDNESS drives opcode selection. a signed secret shift or comparison was
#   emitted in its unsigned form (`shr_u` for `shr_s`, `cmp_lt_u` for `cmp_lt_s`).
#   this needs no dirty operand - it was wrong on every input, in both profiles.
#
#   WIDTH drives the cast arms. with both sides reading 0 bits, neither the widen nor
#   the narrow arm of `lower_cast` fired and every secret-to-secret `::` fell through
#   to a width-changing `bitcast` - malformed IR that `--verify-ir` does not reject.
#
# THE CAST ROWS NEED A DIRTY SOURCE. a bitcast of an already-clean operand yields the
# right answer by luck, so the widening rows are fed from `dirty8`, whose `<< 1` at
# `^u8` leaves residue above bit 7 under the ALU_MIN_WIDTH contract (#2357). before
# the fix the widened value read UNINITIALIZED register bits - 3166064638 in debug,
# 510 in release - so a single passing run proved less than usual here.
#
# not covered because sema rejects them before lowering: a secret branch condition, a
# secret divide / remainder, and any float op on a secret are all refused by the
# constant-time gates, so `is_float_type` has no reachable secret caller.

use std.runtime;
use std.types.size.usize;
use p: std.print;

# --- signedness: opcode selection, no dirty operand needed ---
#[oblivious] fun sar_s32(a: ^i32) ^i32 { ret a >> 4; }
#[oblivious] fun sar_s16(a: ^i16) ^i16 { ret a >> 2; }
#[oblivious] fun sar_s8(a: ^i8)   ^i8  { ret a >> 2; }
#[oblivious] fun shr_u32(a: ^u32) ^u32 { ret a >> 4; }
#[oblivious] fun lt_s(a: ^i32, b: ^i32) ^u8 { ret (a < b)::^u8; }
#[oblivious] fun le_s(a: ^i32, b: ^i32) ^u8 { ret (a <= b)::^u8; }
#[oblivious] fun lt_u(a: ^u32, b: ^u32) ^u8 { ret (a < b)::^u8; }

fun sar_p32(a: i32) i32 { ret a >> 4; }
fun sar_p16(a: i16) i16 { ret a >> 2; }
fun sar_p8(a: i8)   i8  { ret a >> 2; }
fun shr_p32(a: u32) u32 { ret a >> 4; }
fun lt_ps(a: i32, b: i32) u8 { ret (a < b)::u8; }
fun le_ps(a: i32, b: i32) u8 { ret (a <= b)::u8; }
fun lt_pu(a: u32, b: u32) u8 { ret (a < b)::u8; }

# --- width: cast arm selection, fed a dirty source ---
#[oblivious] fun dirty8(a: ^u8) ^u8 { ret a << 1; }
#[oblivious] fun widen_su(x: ^u8)  ^u32 { ret x::^u32; }
#[oblivious] fun widen_ss(x: ^i8)  ^i32 { ret x::^i32; }
#[oblivious] fun widen_s16(x: ^u16) ^u64 { ret x::^u64; }
#[oblivious] fun narrow_s(x: ^u32) ^u8  { ret x::^u8; }
#[oblivious] fun narrow_s16(x: ^u32) ^u16 { ret x::^u16; }

fun dirty8_p(a: u8) u8 { ret a << 1; }
fun widen_pu(x: u8)  u32 { ret x::u32; }
fun widen_ps(x: i8)  i32 { ret x::i32; }
fun widen_p16(x: u16) u64 { ret x::u64; }
fun narrow_p(x: u32) u8  { ret x::u8; }
fun narrow_p16(x: u32) u16 { ret x::u16; }

# a widened secret that is then computed on above its source width - the crypto.ct
# shape, and the one the widening exists to make safe
#[oblivious] fun is_zero_s(x: ^u8) ^u8 { val w: ^u32 = x::^u32; ret ((w - 1) >> 31)::^u8; }
fun is_zero_p(x: u8) u8 { val w: u32 = x::u32; ret ((w - 1) >> 31)::u8; }

# --- a secret reached through a GENERIC instance ---
#
# #2302 stopped lowering generic template bodies, where every `T` had collapsed to
# an opaque pointer-width slot; classification now runs only over substituted
# instances. sema rejects arithmetic on a bare `T` outright ("incompatible operand
# types `T` and `i64`"), so a template body can never reach these classifiers with
# an un-substituted parameter - the reachable shape is a generic instantiated over a
# secret, whose CONCRETE substituted type drives classification at the use site.
# every row here was wrong before the fix, including the one that reaches the value
# through a generic call rather than a field.
pub rec Box[T] { v: T; }
fun unbox[T](b: Box[T]) T { ret b.v; }

#[oblivious] fun box_shr_s(b: Box[^i32]) ^i32 { ret b.v >> 4; }
#[oblivious] fun box_lt_s(b: Box[^i32], c: Box[^i32]) ^u8 { ret (b.v < c.v)::^u8; }
#[oblivious] fun via_unbox_s(b: Box[^i32]) ^i32 { ret unbox[^i32](b) >> 4; }
#[oblivious] fun box_dirty_s(b: Box[^u8]) ^u8 { ret b.v << 1; }
#[oblivious] fun box_widen_s(x: ^u8) ^u32 { ret x::^u32; }

fun box_shr_p(b: Box[i32]) i32 { ret b.v >> 4; }
fun box_lt_p(b: Box[i32], c: Box[i32]) u8 { ret (b.v < c.v)::u8; }
fun via_unbox_p(b: Box[i32]) i32 { ret unbox[i32](b) >> 4; }
fun box_dirty_p(b: Box[u8]) u8 { ret b.v << 1; }
fun box_widen_p(x: u8) u32 { ret x::u32; }

#[symbol("main")]
fun main(argc: usize, argv: **u8) i64 {
    val neg32: i32 = (0 - argc)::i32 * 64;      # -64
    val neg16: i16 = (0 - argc)::i16 * 64;      # -64
    val neg8:  i8  = (0 - argc)::i8 * 64;       # -64
    val big32: u32 = argc::u32 * 4000000000;    # 4000000000
    val one32: i32 = argc::i32;                 # 1
    val v255:  u8  = (argc * 255)::u8;          # 255
    val v128:  u8  = (argc * 128)::u8;          # 128
    val v40k:  u16 = (argc * 40000)::u16;       # 40000
    val u300:  u32 = argc::u32 * 300;           # 300

    p.printlnf("sar32  public={} secret={}", sar_p32(neg32)::i64, (sar_s32(neg32):^)::i64);
    p.printlnf("sar16  public={} secret={}", sar_p16(neg16)::i64, (sar_s16(neg16):^)::i64);
    p.printlnf("sar8   public={} secret={}", sar_p8(neg8)::i64,   (sar_s8(neg8):^)::i64);
    p.printlnf("shr32  public={} secret={}", shr_p32(big32)::i64, (shr_u32(big32):^)::i64);
    p.printlnf("lt_s   public={} secret={}", lt_ps(neg32, one32)::i64, (lt_s(neg32, one32):^)::i64);
    p.printlnf("le_s   public={} secret={}", le_ps(neg32, one32)::i64, (le_s(neg32, one32):^)::i64);
    p.printlnf("lt_u   public={} secret={}", lt_pu(big32, 1)::i64, (lt_u(big32, argc::u32):^)::i64);

    p.printlnf("widen_u   public={} secret={}", widen_pu(dirty8_p(v255))::i64, (widen_su(dirty8(v255)):^)::i64);
    p.printlnf("widen_u0  public={} secret={}", widen_pu(dirty8_p(v128))::i64, (widen_su(dirty8(v128)):^)::i64);
    p.printlnf("widen_s   public={} secret={}", widen_ps(neg8)::i64, (widen_ss(neg8):^)::i64);
    p.printlnf("widen_16  public={} secret={}", widen_p16(v40k)::i64, (widen_s16(v40k):^)::i64);
    p.printlnf("narrow_8  public={} secret={}", narrow_p(u300)::i64, (narrow_s(u300):^)::i64);
    p.printlnf("narrow_16 public={} secret={}", narrow_p16(big32)::i64, (narrow_s16(big32):^)::i64);

    p.printlnf("is_zero0  public={} secret={}", is_zero_p(dirty8_p(v128))::i64, (is_zero_s(dirty8(v128)):^)::i64);
    p.printlnf("is_zero1  public={} secret={}", is_zero_p(dirty8_p(v255))::i64, (is_zero_s(dirty8(v255)):^)::i64);

    var sn: Box[^i32]; sn.v = neg32;
    var so: Box[^i32]; so.v = one32;
    var pn: Box[i32];  pn.v = neg32;
    var po: Box[i32];  po.v = one32;
    var sf: Box[^u8];  sf.v = v255;
    var pf: Box[u8];   pf.v = v255;

    p.printlnf("box_shr   public={} secret={}", box_shr_p(pn)::i64, (box_shr_s(sn):^)::i64);
    p.printlnf("box_lt    public={} secret={}", box_lt_p(pn, po)::i64, (box_lt_s(sn, so):^)::i64);
    p.printlnf("via_unbox public={} secret={}", via_unbox_p(pn)::i64, (via_unbox_s(sn):^)::i64);
    p.printlnf("box_widen public={} secret={}", box_widen_p(box_dirty_p(pf))::i64, (box_widen_s(box_dirty_s(sf)):^)::i64);
    ret 0;
}
