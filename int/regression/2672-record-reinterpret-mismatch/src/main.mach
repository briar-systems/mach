# a record reinterpret whose sizes genuinely differ is still refused, and the
# diagnostic names the measured size rather than 0
rec Pair { a: i64; b: i64; }
rec Empty { }

# 16 bytes into 8: refused, and the message must say 16 rather than 0
fun narrow(p: Pair) i64 { ret p:~i64; }

# an empty record has no bits to reinterpret, so it stays refused - the one shape
# the old 0-byte reading got right for the wrong reason
fun empty(e: Empty) i64 { ret e:~i64; }

#[symbol("main")]
fun main() i32 { ret 0; }
