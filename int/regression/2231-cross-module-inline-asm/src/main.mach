# 2231-cross-module-inline-asm regression case
#
# A dependency's `#[inline]` body flows into an importer's IR and is inlined there, so
# a cross-module atomic costs its instruction sequence and not a call as well (#2231).
#
# TWO OBSERVABLES, AND NEITHER REPLACES THE OTHER. This file's stdout is the VALUE
# half: every operation must return exactly what it returned when it was a call, at
# both profiles and on all three ISAs, because an inline that changes an answer is a
# miscompile and an inline that changes an ORDERING would show up here as a wrong
# accumulated total. The sibling `run: inline-calls` observable is the SHAPE half, and
# it is the one with teeth for the feature itself: a compiler that quietly stopped
# inlining across the boundary computes every value below correctly and this file
# alone would stay green against it, which is precisely the defect class this repo
# keeps finding.
#
# The `sum` totals are hand-computable and are stated in `expect.txt`'s derivation.

use std.runtime;
use p: std.print;
use c: case.counter;

# the observed function: every call in its body is to a cross-module `#[inline]`
# callee, so after the flow lands it contains no call at all.
fun mixed(iters: i64) i64 {
    var a: i64 = 0;
    var d: i64 = 0;
    var acc: i64 = 0;
    var i: i64 = 0;
    for (i < iters) {
        c.astore(?a, i);
        acc = acc + c.aload(?a);
        acc = acc + c.afetch_add(?d, 2);
        acc = acc + c.adouble(i);
        i = i + 1;
    }
    ret acc + d;
}

# the opt-out half, kept in its own function so the shape observable can report the
# two verdicts separately rather than folding them into one number.
fun opted_out(iters: i64) i64 {
    var a: i64 = 7;
    var acc: i64 = 0;
    var i: i64 = 0;
    for (i < iters) {
        acc = acc + c.aexchange_noinline(?a, i);
        acc = acc + c.aplain_add(?a, 1);
        i = i + 1;
    }
    ret acc + a;
}

#[symbol("main")]
fun main() i64 {
    p.printlnf("mixed0={}", mixed(0));
    p.printlnf("mixed1={}", mixed(1));
    p.printlnf("mixed5={}", mixed(5));
    p.printlnf("out0={}", opted_out(0));
    p.printlnf("out1={}", opted_out(1));
    p.printlnf("out5={}", opted_out(5));
    p.printlnf("pos={} neg={}", c.is_positive(3), c.is_positive(0 - 3));
    ret 0;
}
