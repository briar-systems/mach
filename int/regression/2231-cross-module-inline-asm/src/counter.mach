# a dependency module holding `#[inline]` atomic-shaped bodies, each per-arch inline asm
#
# THE CASE IS THE MODULE BOUNDARY. These are deliberately declared here and used from
# `main.mach`, because a same-module callee has been inlinable since the asm payload
# rides across a clone, and it is the CROSS-module reach that #2231 is about: every
# caller of `std.sync.atomic` is in another module, so a same-module case would report
# a feature the atomics do not get.
#
# The bodies mirror `std.sync.atomic`'s in shape (a `{name}`-bound pointer staged into
# a scratch register, a locked / exclusive read-modify-write, a `{name}`-bound result)
# rather than calling it, so the case pins the compiler's behaviour and does not
# silently start passing or failing when a released mach-std changes.

use std.types.bool.bool;

#[inline]
pub fun aload(ptr: *i64) i64 {
    var result: i64 = 0;
    $if ($mach.build.arch == $mach.arch.x86_64) {
        asm x86_64 {
            mov rcx, {ptr}
            mov rax, [rcx]
            mov {result}, rax
        }
    }
    $or ($mach.build.arch == $mach.arch.aarch64) {
        asm aarch64 {
            ldr x12, {ptr}
            ldar x9, [x12]
            str x9, {result}
        }
    }
    $or ($mach.build.arch == $mach.arch.riscv64) {
        asm riscv64 {
            ld a0, {ptr}
            fence
            ld a1, 0(a0)
            fence
            sd a1, {result}
        }
    }
    $or {
        $error("2231-cross-module-inline-asm: unsupported architecture");
    }
    ret result;
}

#[inline]
pub fun astore(ptr: *i64, v: i64) {
    $if ($mach.build.arch == $mach.arch.x86_64) {
        asm x86_64 {
            mov rax, {v}
            mov rcx, {ptr}
            xchg [rcx], rax
        }
    }
    $or ($mach.build.arch == $mach.arch.aarch64) {
        asm aarch64 {
            ldr x12, {ptr}
            ldr x9, {v}
            stlr x9, [x12]
        }
    }
    $or ($mach.build.arch == $mach.arch.riscv64) {
        asm riscv64 {
            ld a0, {ptr}
            ld a1, {v}
            amoswap.d.aqrl zero, a1, (a0)
        }
    }
    $or {
        $error("2231-cross-module-inline-asm: unsupported architecture");
    }
}

#[inline]
pub fun afetch_add(ptr: *i64, v: i64) i64 {
    var old: i64 = 0;
    $if ($mach.build.arch == $mach.arch.x86_64) {
        asm x86_64 {
            mov rax, {v}
            mov rcx, {ptr}
            lock xadd [rcx], rax
            mov {old}, rax
        }
    }
    $or ($mach.build.arch == $mach.arch.aarch64) {
        asm aarch64 {
            ldr x12, {ptr}
            ldr x14, {v}
        1:
            ldaxr x9, [x12]
            add x10, x9, x14
            stlxr w11, x10, [x12]
            cbnz w11, 1b
            str x9, {old}
            dmb ish
        }
    }
    $or ($mach.build.arch == $mach.arch.riscv64) {
        asm riscv64 {
            ld a0, {ptr}
            ld a1, {v}
            amoadd.d.aqrl a2, a1, (a0)
            sd a2, {old}
        }
    }
    $or {
        $error("2231-cross-module-inline-asm: unsupported architecture");
    }
    ret old;
}

# a `#[noinline]` sibling of the same shape. the decorator is the author's opt-out and
# it must keep working after `#[inline]` gained a cross-module meaning, so this one
# stays a call in the observable while its neighbours vanish.
#[noinline]
pub fun aexchange_noinline(ptr: *i64, v: i64) i64 {
    var old: i64 = 0;
    $if ($mach.build.arch == $mach.arch.x86_64) {
        asm x86_64 {
            mov rax, {v}
            mov rcx, {ptr}
            xchg [rcx], rax
            mov {old}, rax
        }
    }
    $or ($mach.build.arch == $mach.arch.aarch64) {
        asm aarch64 {
            ldr x12, {ptr}
            ldr x14, {v}
        1:
            ldaxr x9, [x12]
            stlxr w11, x14, [x12]
            cbnz w11, 1b
            str x9, {old}
            dmb ish
        }
    }
    $or ($mach.build.arch == $mach.arch.riscv64) {
        asm riscv64 {
            ld a0, {ptr}
            ld a1, {v}
            amoswap.d.aqrl a2, a1, (a0)
            sd a2, {old}
        }
    }
    $or {
        $error("2231-cross-module-inline-asm: unsupported architecture");
    }
    ret old;
}

# a plain (undecorated) cross-module body, to pin that the flow is opt-IN. nothing
# about this one asks to cross the boundary, so it must stay a call: if it inlined,
# `#[inline]` would not be a contract and every dependency body would be flowing into
# every importer, which is the incremental-build cost the lowered-surface firewall
# exists to avoid.
pub fun aplain_add(ptr: *i64, v: i64) i64 {
    val old: i64 = @ptr;
    @ptr = old + v;
    ret old;
}

# an `#[inline]` body with no asm at all, so the case does not conflate two facts: the
# cross-module flow is what `#[inline]` buys, and carrying an asm payload across the
# clone is a separate mechanism. this one exercises the flow alone.
#[inline]
pub fun adouble(v: i64) i64 {
    ret v + v;
}

#[inline]
pub fun is_positive(v: i64) bool {
    ret v > 0;
}
