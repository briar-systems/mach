#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    p.printlnf("forward_3={}", forward_3());
    p.printlnf("backward_3={}", backward_3());
    p.printlnf("self_3={}", self_3());
    p.printlnf("forward_65={}", forward_65());
    p.printlnf("backward_65={}", backward_65());
    p.printlnf("self_65={}", self_65());
    p.printlnf("forward_257={}", forward_257());
    p.printlnf("backward_257={}", backward_257());
    p.printlnf("self_257={}", self_257());
    ret 0;
}
