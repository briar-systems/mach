use std.runtime;
use std.types.size.usize;
use p: std.print;

rec Bytes3 { bytes: [3]u8; }
#[noinline]
fun forward_3() i64 {
    var data: [5]u8;
    var i: usize = 0;
    for (i < 5) { data[i] = (i % 251)::u8; i = i + 1; }
    val source: *Bytes3 = (?data[0])::*Bytes3;
    val destination: *Bytes3 = (?data[1])::*Bytes3;
    @destination = @source;
    i = 0;
    for (i < 5) {
        var expected: u8 = (i % 251)::u8;
        if (i >= 1 && i < 4) { expected = ((i - 1 + 0) % 251)::u8; }
        if (data[i] != expected) { ret i::i64 + 1; }
        i = i + 1;
    }
    ret 0;
}

#[noinline]
fun backward_3() i64 {
    var data: [5]u8;
    var i: usize = 0;
    for (i < 5) { data[i] = (i % 251)::u8; i = i + 1; }
    val source: *Bytes3 = (?data[1])::*Bytes3;
    val destination: *Bytes3 = (?data[0])::*Bytes3;
    @destination = @source;
    i = 0;
    for (i < 5) {
        var expected: u8 = (i % 251)::u8;
        if (i >= 0 && i < 3) { expected = ((i - 0 + 1) % 251)::u8; }
        if (data[i] != expected) { ret i::i64 + 1; }
        i = i + 1;
    }
    ret 0;
}

#[noinline]
fun self_3() i64 {
    var data: [5]u8;
    var i: usize = 0;
    for (i < 5) { data[i] = (i % 251)::u8; i = i + 1; }
    val source: *Bytes3 = (?data[1])::*Bytes3;
    val destination: *Bytes3 = (?data[1])::*Bytes3;
    @destination = @source;
    i = 0;
    for (i < 5) {
        var expected: u8 = (i % 251)::u8;
        if (i >= 1 && i < 4) { expected = ((i - 1 + 1) % 251)::u8; }
        if (data[i] != expected) { ret i::i64 + 1; }
        i = i + 1;
    }
    ret 0;
}

