# how a command reports: diagnostics, failures, the build readout and test results
#
# a command's `Report` writes to stderr as human text or, under `--report json` or `--report lines`,
# one record a line closed by a summary record. a `Readout` renders the engine's and the
# test runner's events as they arrive, by the readout contract (doc/language/readout.md).

use mach.base.fail;
use mach.base.growth;
use mach.report.testrun;
use std.allocator.page;
use fs: std.filesystem;
use std.text.string.str_dup;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use types_path: std.types.path;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_is_empty;
use std.types.string.str_len;
use std.types.string.str_starts_with;

use A: std.allocator;
use std.allocator.arena;
use chrono_duration: std.chrono.duration;
use std.chrono.time;
use collections_vector: std.collections.vector;
use std.collections.vector.Vector;
use std_format: std.format;
use io_writer:  std.io.writer;
use std.print;
use std.process.env;
use std.sync.condition;
use std.sync.mutex;
use sync_thread:  std.sync.thread;
use types_string: std.types.string;

use mach.base.diagnostic;
use mach.base.diagnostic.annotation;
use diagnostic_kind: mach.base.diagnostic.kind;
use mach.base.duration;
use base_source: mach.base.source;
use mach.build.outcome;
use mach.cli.exit;
use mach.host.interrupt;
use mach.package.report;
use mach.report.layout;
use mach.report.readout;
use mach.report.record;
use std.terminal;

val MAX_SPAN_LINES: usize = 10;

val EXCERPT_WIDTH: usize = 120;
val EXCERPT_LEAD:  usize = 40;
val EXCERPT_MARK:  str   = "...";

# the part of a source line a snippet shows, at most EXCERPT_WIDTH bytes of it
# ---
# start:     the first byte shown
# end:       the byte past the last one shown
# cut_left:  bytes before start were cut, marked with EXCERPT_MARK
# cut_right: bytes past end were cut, marked with EXCERPT_MARK
rec Excerpt {
    start:     usize;
    end:       usize;
    cut_left:  bool;
    cut_right: bool;
}

# the bytes of a source line a diagnostic's span covers
# ---
# from: the first byte marked
# to:   the byte past the last one marked
rec MarkRange {
    from: usize;
    to:   usize;
}

# the part of the line `b` the span from `off` to `end` covers, an end that falls outside the
# line taken at the line's own edge
fun mark_range(b: base_source.Span, off: usize, end: usize) MarkRange {
    val bs: usize = b.offset;
    val be: usize = base_source.span_end(b);
    var r:  MarkRange;
    r.from = bs;
    if (off > bs && off <= be) { r.from = off; }
    r.to = be;
    if (end >= bs && end <= be) { r.to = end; }
    if (r.to < r.from)          { r.to = r.from; }
    ret r;
}

# the window of the line `b` a snippet shows: the whole line when it fits EXCERPT_WIDTH, otherwise
# a window that starts EXCERPT_LEAD bytes before the mark `m` where it can
fun excerpt_of(b: base_source.Span, m: MarkRange) Excerpt {
    val bs: usize = b.offset;
    val be: usize = base_source.span_end(b);
    var x:  Excerpt;
    x.start     = bs;
    x.end       = be;
    x.cut_left  = false;
    x.cut_right = false;
    if (be - bs <= EXCERPT_WIDTH) { ret x; }
    var ws: usize = bs;
    if (m.from > bs + EXCERPT_LEAD) { ws = m.from - EXCERPT_LEAD; }
    var we: usize = ws + EXCERPT_WIDTH;
    if (we > be) {
        we = be;
        if (we - bs > EXCERPT_WIDTH) { ws = we - EXCERPT_WIDTH; }
        or                           { ws = bs; }
    }
    x.start     = ws;
    x.end       = we;
    x.cut_left  = ws > bs;
    x.cut_right = we < be;
    ret x;
}

# render every diagnostic of a store through a command's report: as text, counted into the
# report's errors and warnings, or a record each under json
# ---
# r:       the command's report
# sources: the SourceMap that locates each diagnostic
# list:    the diagnostics, in order
pub fun report_store(r: *Report, sources: *base_source.SourceMap, list: *diagnostic.DiagnosticStore) {
    if (r.format == FORMAT_HUMAN) {
        render_store(r, sources, list);
        ret;
    }
    render_store_records(r, sources, list, report_paths(r));
}

# render every diagnostic of a store as text on the report's stream, a blank line owed after
# each, counting each into the report's errors and warnings
fun render_store(r: *Report, sources: *base_source.SourceMap, list: *diagnostic.DiagnosticStore) {
    val total: usize = diagnostic.len(list);
    var i:     usize = 0;
    for (i < total) {
        val d: *diagnostic.Diagnostic = ?list.items.data[i];
        render(?r.w, sources, d);
        count_record(r, d);
        owe_blank(r);
        i = i + 1;
    }
}

# a located span of one source file, clamped to its text
# ---
# sf:     the file
# off:    the span's first byte
# end:    the byte past its last
# line_s: the line of its first byte
# line_e: the line of its last byte
# col_s:  the column of its first byte
rec Frame {
    sf:     *base_source.SourceFile;
    off:    usize;
    end:    usize;
    line_s: usize;
    line_e: usize;
    col_s:  usize;
}

# the frame of `loc` in `sources`, none when the map is nil or does not hold its file
fun locate(sources: *base_source.SourceMap, loc: base_source.Location) opt[Frame] {
    if (sources == nil) { ret opt[Frame].none{}; }
    val opt_file: opt[*base_source.SourceFile] = base_source.get(sources, loc.file);
    if (sel opt_file.none) { ret opt[Frame].none{}; }
    val sf: *base_source.SourceFile = opt_file.some;

    val text_len: usize = str_len(sf.text);

    var off: usize = loc.span.offset;
    if (off > text_len) { off = text_len; }
    var end: usize = loc.span.offset + loc.span.len;
    if (end > text_len) { end = text_len; }
    if (end < off)      { end = off; }

    val start_pos: base_source.Position = base_source.position(sf, off);
    var last:      usize                = off;
    if (end > off) { last = end - 1; }
    val end_pos: base_source.Position = base_source.position(sf, last);

    var f: Frame;
    f.sf     = sf;
    f.off    = off;
    f.end    = end;
    f.line_s = start_pos.line;
    f.line_e = end_pos.line;
    f.col_s  = start_pos.col;
    ret opt[Frame].some{f};
}

fun render(out: *io_writer.Writer, sources: *base_source.SourceMap, d: *diagnostic.Diagnostic) {
    emit_headline(out, d.kind, d.message);

    val opt_pf: opt[Frame] = locate(sources, d.loc);
    val w:      usize      = gutter_width(sources, d, opt_pf);

    var framed: bool = false;
    if (sel opt_pf.some) {
        var pf: Frame = opt_pf.some;
        emit_frame(out, ?pf, w, "^", nil);
        framed = true;
    }

    var i: usize = 0;
    for (i < d.related.len) {
        val rel:    *annotation.Related = ?d.related.data[i];
        val opt_rf: opt[Frame]          = locate(sources, rel.loc);
        if (sel opt_rf.some) {
            var rf: Frame = opt_rf.some;
            emit_frame(out, ?rf, w, "-", rel.label);
            framed = true;
        }
        i = i + 1;
    }

    emit_trailer(out, sources, d, framed, w);
}

fun gutter_width(sources: *base_source.SourceMap, d: *diagnostic.Diagnostic, opt_pf: opt[Frame]) usize {
    var w: usize = 1;
    if (sel opt_pf.some) { w = decimal_width(opt_pf.some.line_e); }

    var i: usize = 0;
    for (i < d.related.len) {
        val opt_rf: opt[Frame] = locate(sources, d.related.data[i].loc);
        if (sel opt_rf.some) {
            val rw: usize = decimal_width(opt_rf.some.line_e);
            if (rw > w) { w = rw; }
        }
        i = i + 1;
    }
    ret w;
}

fun emit_frame(out: *io_writer.Writer, f: *Frame, w: usize, head: str, label: str) {
    emit_loc(out, w, f.sf.path, f.line_s, f.col_s, label);
    emit_snippet(out, f.sf, w, f.line_s, f.line_e, f.off, f.end, head);
}

fun emit_trailer(out: *io_writer.Writer, sources: *base_source.SourceMap, d: *diagnostic.Diagnostic, framed: bool, w: usize) {
    if (!has_trailer(sources, d)) { ret; }

    var indent: usize = 2;
    if (framed) { indent = w + 1; }

    var i: usize = 0;
    for (i < d.related.len) {
        val rel:        *annotation.Related = ?d.related.data[i];
        val opt_locate: opt[Frame]          = locate(sources, rel.loc);
        if (rel.label != nil && sel opt_locate.none) {
            emit_tagged(out, "note", rel.label, indent);
        }
        i = i + 1;
    }

    var c: usize = 0;
    for (c < d.children.len) {
        val child: *diagnostic.Child = ?d.children.data[c];
        if (child.kind == diagnostic.CHILD_HELP) { emit_tagged(out, "help", child.text, indent); }
        or                                       { emit_tagged(out, "note", child.text, indent); }
        c = c + 1;
    }
}

fun has_trailer(sources: *base_source.SourceMap, d: *diagnostic.Diagnostic) bool {
    if (d.children.len > 0) { ret true; }

    var i: usize = 0;
    for (i < d.related.len) {
        val opt_locate: opt[Frame] = locate(sources, d.related.data[i].loc);
        if (d.related.data[i].label != nil && sel opt_locate.none) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun emit_snippet(out: *io_writer.Writer, sf: *base_source.SourceFile, w: usize, line_s: usize, line_e: usize, off: usize, end: usize, head: str) {
    if (line_e <= line_s) {
        emit_source_line(out, sf, w, line_s, off, end);
        emit_underline(out, sf, w, line_s, off, end, head);
        ret;
    }

    if (line_e - line_s + 1 <= MAX_SPAN_LINES) {
        var l: usize = line_s;
        for (l <= line_e) {
            emit_source_line(out, sf, w, l, off, end);
            if (l == line_s) { emit_underline(out, sf, w, l, off, end, head); }
            or               { emit_underline(out, sf, w, l, off, end, "-"); }
            l = l + 1;
        }
        ret;
    }

    emit_source_line(out, sf, w, line_s, off, end);
    emit_underline(out, sf, w, line_s, off, end, head);
    emit_elision(out, w);
    emit_source_line(out, sf, w, line_e, off, end);
    emit_underline(out, sf, w, line_e, off, end, "-");
}

fun emit_source_line(out: *io_writer.Writer, sf: *base_source.SourceFile, w: usize, line: usize, off: usize, end: usize) {
    val opt_bounds: opt[base_source.Span] = base_source.line_bounds(sf, line);
    if (sel opt_bounds.none) { ret; }
    val b: base_source.Span = opt_bounds.some;
    val x: Excerpt          = excerpt_of(b, mark_range(b, off, end));

    emit_gutter_num(out, w, line);
    if (x.cut_left) { std_format.write_str(out, EXCERPT_MARK); }
    if (x.end > x.start) {
        std_format.write_bytes(out, ?sf.text[x.start], x.end - x.start);
    }
    if (x.cut_right) { std_format.write_str(out, EXCERPT_MARK); }
    std_format.write_str(out, "\n");
}

fun emit_underline(out: *io_writer.Writer, sf: *base_source.SourceFile, w: usize, line: usize, off: usize, end: usize, glyph: str) {
    val opt_bounds: opt[base_source.Span] = base_source.line_bounds(sf, line);
    if (sel opt_bounds.none) { ret; }
    val b:         base_source.Span = opt_bounds.some;
    val m:         MarkRange        = mark_range(b, off, end);
    val x:         Excerpt          = excerpt_of(b, m);
    val mark_from: usize            = m.from;
    var mark_to:   usize            = m.to;
    if (mark_to > x.end) { mark_to = x.end; }

    emit_gutter_bar(out, w);

    if (x.cut_left) { emit_spaces(out, str_len(EXCERPT_MARK)); }
    var i: usize = x.start;
    for (i < mark_from) {
        if (sf.text[i] == '\t') { std_format.write_str(out, "\t"); }
        or                      { std_format.write_str(out, " "); }
        i = i + 1;
    }

    var n: usize = mark_to - mark_from;
    if (n == 0) { n = 1; }
    var j: usize = 0;
    for (j < n) {
        std_format.write_str(out, glyph);
        j = j + 1;
    }
    std_format.write_str(out, "\n");
}

# `@ path:line:col` and the place's label, the `@` in the gutter's bar column
fun emit_loc(out: *io_writer.Writer, w: usize, path: str, line: usize, col: usize, label: str) {
    emit_spaces(out, w + 1);
    std_format.write_str(out, "@ ");
    std_format.write_str(out, path);
    std_format.write_str(out, ":");
    std_format.write_u64(out, line::u64);
    std_format.write_str(out, ":");
    std_format.write_u64(out, col::u64);
    if (label != nil) {
        std_format.write_str(out, " ");
        std_format.write_str(out, label);
    }
    std_format.write_str(out, "\n");
}

fun emit_elision(out: *io_writer.Writer, w: usize) {
    emit_spaces(out, w);
    std_format.write_str(out, " | ...\n");
}

fun emit_gutter_num(out: *io_writer.Writer, w: usize, line: usize) {
    emit_spaces(out, w - decimal_width(line));
    std_format.write_u64(out, line::u64);
    std_format.write_str(out, " | ");
}

fun emit_gutter_bar(out: *io_writer.Writer, w: usize) {
    emit_spaces(out, w);
    std_format.write_str(out, " | ");
}

# `note text` at `indent`, each further line of the text beneath its first
fun emit_tagged(out: *io_writer.Writer, tag: str, text: str, indent: usize) {
    emit_spaces(out, indent);
    std_format.write_str(out, tag);
    std_format.write_str(out, " ");
    val n:   usize = str_len(text);
    var seg: usize = 0;
    var i:   usize = 0;
    for (i < n) {
        if (text[i] == '\n') {
            std_format.write_bytes(out, ?text[seg], i - seg + 1);
            emit_spaces(out, indent + str_len(tag) + 1);
            seg = i + 1;
        }
        i = i + 1;
    }
    std_format.write_bytes(out, ?text[seg], n - seg);
    std_format.write_newline(out);
}

# the kind's severity, then its key where it names one: `warning[vector.scalarize] `
fun emit_lead(out: *io_writer.Writer, k: diagnostic_kind.Kind) {
    std_format.write_str(out, severity_name(k));
    val key: str = diagnostic_kind.key_of(k);
    if (key != nil) {
        std_format.write_str(out, "[");
        std_format.write_str(out, key);
        std_format.write_str(out, "]");
    }
    std_format.write_str(out, " ");
}

fun emit_headline(out: *io_writer.Writer, k: diagnostic_kind.Kind, message: str) {
    emit_lead(out, k);
    std_format.write_str(out, message);
    std_format.write_newline(out);
}

fun emit_spaces(out: *io_writer.Writer, n: usize) {
    var i: usize = 0;
    for (i < n) {
        std_format.write_str(out, " ");
        i = i + 1;
    }
}

fun decimal_width(n: usize) usize {
    var digits: [std_format.DECIMAL_MAX]u8;
    ret std_format.put_u64(?digits[0], n::u64);
}

# the severity a kind's row declares, as the headline and a record name it
fun severity_name(k: diagnostic_kind.Kind) str {
    if (diagnostic_kind.is_error(k)) { ret "error"; }
    if (diagnostic_kind.is_note(k))  { ret "note"; }
    ret "warning";
}

fun stderr_writer() io_writer.Writer {
    ret fs.writer(fs.STDERR);
}

# a carried failure, rendered as the diagnostic it reads as: its headline, the snippet at its
# place and its related places. a reported failure writes nothing, its diagnostics having been
# rendered already
fun render_fail_w(w: *io_writer.Writer, sources: *base_source.SourceMap, f: *fail.Fail) i64 {
    if (sel f.reported) { ret exit.of(@f); }
    var fx: annotation.Fix;
    var d:  diagnostic.Diagnostic = failure_view(f, diagnostic.ORIGIN_NONE, ?fx);
    render(w, sources, ?d);
    ret exit.of(@f);
}

# the diagnostic a carried failure reads as: its kind, text and origin, at its place, naming its
# related places and its fix. the view borrows them from the failure, its fix through `fix`,
# which must outlive it
fun failure_view(f: *fail.Fail, origin: diagnostic.Origin, fix: *annotation.Fix) diagnostic.Diagnostic {
    var d: diagnostic.Diagnostic;
    d.kind    = fail.kind_of(@f);
    d.origin  = origin;
    d.loc     = base_source.location_nil();
    d.message = fail.describe(@f);
    val opt_placed: opt[base_source.Location] = fail.place_of(@f);
    if (sel opt_placed.some) { d.loc = opt_placed.some; }
    d.children = collections_vector.init[diagnostic.Child](nil);
    d.related  = fail.related_of(@f);
    d.fixes    = collections_vector.init[annotation.Fix](nil);
    val opt_fixed: opt[annotation.Fix] = fail.fix_of(@f);
    if (sel opt_fixed.some) {
        @fix         = opt_fixed.some;
        d.fixes.data = fix;
        d.fixes.len  = 1;
        d.fixes.cap  = 1;
    }
    ret d;
}

# print a Fail to stderr as the diagnostic it reads as, and map it to an exit code
# a reported Fail prints nothing, its diagnostics having been rendered already
# ---
# sources: the source map the failure's places are in, nil when it can point at none
# f:       the Fail
# ret:     the exit code `exit.of` maps the failure to
pub fun render_fail(sources: *base_source.SourceMap, f: *fail.Fail) i64 {
    var w: io_writer.Writer = stderr_writer();
    ret render_fail_w(?w, sources, f);
}

# render_fail for a failure built in place
# ---
# sources: the source map the failure's places are in, nil when it can point at none
# f:       the Fail
# ret:     the exit code `exit.of` maps the failure to
pub fun refuse(sources: *base_source.SourceMap, f: fail.Fail) i64 {
    ret render_fail(sources, ?f);
}

fun package_said(ctx: ptr, v: layout.Verb, texts: *str, n: usize) {
    val r: *Report = ctx::*Report;
    if (results_shown(r)) { said_row(out(r), v, texts, n); }
}

fun package_note(ctx: ptr, text: str) {
    report_note(ctx::*Report, diagnostic_kind.DEP_NOTE, text);
}

fun package_fault(ctx: ptr, f: fail.Fail) {
    val code: i64 = report_fail(ctx::*Report, f, diagnostic.ORIGIN_NONE);
}

# what the dependency work calls a fetch from a remote, on the live line and in the log
pub val FETCH_LABEL: str = "fetch";

# a fetch began: the live line names its remote, under the stage the command opened over its
# fetches, and under a stage of the fetch's own when it opened none
fun package_fetching(ctx: ptr, url: str, done: u32, total: u32, staged: bool) {
    val r: *Report = ctx::*Report;
    if (!staged) { live_begin(r, FETCH_LABEL); }
    live_reached(r, done, total, url);
}

# a fetch ended: under -vv an item line of the command's stage when it opened one, and under -v
# a stage line of its own when it opened none
fun package_fetched(ctx: ptr, url: str, d: chrono_duration.Duration, staged: bool) {
    val r: *Report = ctx::*Report;
    if (staged) {
        log_item(r, FETCH_LABEL, d, url);
        ret;
    }
    live_end(r);
    log_stage(r, FETCH_LABEL, d, url);
}

# where a dependency command reports: result lines on standard output, notes and failures, the
# ones the command goes on past too, through the command's report, and each fetch on the live
# line and in the log
# ---
# a:   owns the report's effect notes
# r:   the command's report, in the format `--report` selected
# ret: the report, released with `report.dnit`
pub fun dependency_report(a: *A.Allocator, r: *Report) report.Report {
    ret report.init(a, r::ptr, report.Sink{said: package_said, note: package_note, fault: package_fault, fetching: package_fetching, fetched: package_fetched});
}

# show how a dependency command ended: its failure, then a note for each change it made
# before failing
# ---
# rep:     the report the command used
# outcome: how it ended
# ret:     exit.OK, or the code `exit.of` maps the failure to
pub fun dependency_outcome(rep: *report.Report, outcome: err[fail.Fail]) i64 {
    if (sel outcome.ok) { ret exit.OK; }
    val code: i64   = report_fail(rep.ctx::*Report, outcome.err, diagnostic.ORIGIN_NONE);
    var i:    usize = 0;
    for (i < rep.effects.len) {
        report_note(rep.ctx::*Report, diagnostic_kind.DEP_EFFECT, rep.effects.data[i]);
        i = i + 1;
    }
    ret code;
}

# map a build outcome's severity to the process exit code
# ---
# bo:  the outcome
# ret: the shared exit code of the severity; a severity outside the catalog
# is an internal failure written to `w` naming the catalog and the tag
fun outcome_code_w(w: *io_writer.Writer, bo: *outcome.BuildOutcome) i64 {
    if (bo.severity == outcome.BUILD_OK)          { ret exit.OK; }
    if (bo.severity == outcome.BUILD_USER)        { ret exit.USER; }
    if (bo.severity == outcome.BUILD_INTERNAL)    { ret exit.INTERNAL; }
    if (bo.severity == outcome.BUILD_ENVIRONMENT) { ret exit.ENVIRONMENT; }
    std_format.format(w, "error[{}] unknown BuildSeverity tag {}\n", diagnostic_kind.key_of(diagnostic_kind.COMPILER_INTERNAL), bo.severity);
    ret exit.INTERNAL;
}

# map a build outcome's severity to the process exit code, an unknown severity reported to stderr
# ---
# bo:  the outcome
# ret: the shared exit code of the severity, exit.INTERNAL for one outside the catalog
pub fun outcome_code(bo: *outcome.BuildOutcome) i64 {
    var w: io_writer.Writer = stderr_writer();
    ret outcome_code_w(?w, bo);
}

# a log line's label column, a time column, and the lead of a fact beneath a log line
val LABEL_W:    usize = 11;
val TIME_W:     usize = 6;
val FACT_LEAD:  usize = 28;
val FACT_KEY_W: usize = 12;
# the lead of a log line in place of its stamp, as the live line carries it
val STAMP_W: usize = 9;

# the recap's columns: its label, count and time, and the bar it scales to the largest row
val RECAP_LABEL_W: usize = 12;
val RECAP_COUNT_W: usize = 6;
val RECAP_TIME_W:  usize = 8;
# a cell of the module time table
val CELL_W: usize = 8;

# the mark of a recap row whose time is summed over worker threads, explained once beneath it
val SUMMED_MARK: str = "*";

# the label a growing cycle's line carries
val GROWTH_LABEL: str = "instantiate";

# what a plan of units shows on each result line: the units' artifact, target and profile, which
# of them differ between units, and the widest of each. a column shows on a result line only
# when the units differ in it, the artifact always
pub rec Shape {
    units:   usize;
    first:   [SHAPE_COLUMNS]str;
    differs: [SHAPE_COLUMNS]bool;
    widths:  [SHAPE_COLUMNS]usize;
}

val SHAPE_COLUMNS:  usize = 3;
val SHAPE_ARTIFACT: usize = 0;
val SHAPE_TARGET:   usize = 1;
val SHAPE_PROFILE:  usize = 2;

# an empty plan shape in place
pub fun shape_init(s: *Shape) {
    s.units = 0;
    var c: usize = 0;
    for (c < SHAPE_COLUMNS) {
        s.first[c]   = nil;
        s.differs[c] = false;
        s.widths[c]  = 0;
        c            = c + 1;
    }
}

# one unit of the plan, each of its names borrowed for the call
pub fun shape_unit(s: *Shape, artifact: str, target: str, profile: str) {
    var names: [SHAPE_COLUMNS]str = [SHAPE_COLUMNS]str{artifact, target, profile};
    var c:     usize              = 0;
    for (c < SHAPE_COLUMNS) {
        val name: str = names[c];
        if (s.units == 0)                                                { s.first[c] = name; }
        or (!str_equals(text_or_empty(s.first[c]), text_or_empty(name))) { s.differs[c] = true; }
        val l: usize = str_len(text_or_empty(name));
        if (l > s.widths[c]) { s.widths[c] = l; }
        c = c + 1;
    }
    s.units = s.units + 1;
}

fun text_or_empty(s: str) str {
    if (s == nil) { ret ""; }
    ret s;
}

# one recap row, gathered over every close of its phase: its count, time, the most threads its
# time is summed over and its slowest item
rec Row {
    seen:            bool;
    count:           u32;
    elapsed:         chrono_duration.Duration;
    threads:         u32;
    slowest:         str;
    slowest_elapsed: chrono_duration.Duration;
}

# one module under -vv: the time each part of its codegen took, and its counters, those it posted `has`
rec ModuleRow {
    name:   str;
    times:  [readout.PHASE_COUNT]chrono_duration.Duration;
    values: [readout.COUNTER_COUNT]u64;
    has:    [readout.COUNTER_COUNT]bool;
}

# every command's build and test events rendered the moment each arrives: the renderer of the
# readout contract (doc/language/readout.md). result lines go to stdout, the same at every
# level; log lines, items, facts and diagnostics go to stderr as they happen, and a terminal
# shows the live line beneath them. the records modes write each diagnostic and failure as a
# record, and under -v each unit, phase row, item, fact and counter
# ---
# sink:     what the engine and the test runner are given; its ctx is this record, which must not move
# r:        the command's report
# shape:    the plan's units, which the result lines' columns follow
# quiet:    `--quiet`, which leaves out the result lines
# unit:     the unit the events now arriving belong to
# errors:   the errors the unit reported, its warnings in `warnings`
# rows:     the unit's recap, by phase
# a:        the arena what is held lives in, nil until something is
# modules:  each module's codegen times and counters under -vv, the last one met at `last`
# counts:   the unit's counter totals, those `held`
# run:      the running test run's results, from its run_start to its run_end, `count` of them
# finished: how many of them have finished
# mod_w:    a module line's module column, and `tests_w` its count column
pub rec Readout {
    sink:     readout.Sink;
    r:        *Report;
    shape:    Shape;
    quiet:    bool;
    unit:     readout.Unit;
    errors:   u32;
    warnings: u32;
    rows:     [readout.PHASE_COUNT]Row;
    a:        *A.Allocator;
    modules:  Vector[ModuleRow];
    last:     usize;
    counts:   [readout.COUNTER_COUNT]u64;
    held:     [readout.COUNTER_COUNT]bool;
    run:      *readout.TestResult;
    count:    u32;
    finished: u32;
    mod_w:    usize;
    tests_w:  usize;
}

# start rendering a command's events to r, at the level and quietness its command line set
# ---
# rd:    the renderer, initialised in place since its sink points at it
# r:     the command's report
# shape: the plan's units
pub fun readout_begin(rd: *Readout, r: *Report, shape: *Shape) {
    rd.sink.ctx      = rd::ptr;
    rd.sink.on_event = readout_on_event;
    rd.sink.level    = r.level;
    rd.sink.live     = nil;
    rd.r             = r;
    rd.shape         = @shape;
    rd.quiet         = r.quiet;
    rd.unit          = readout.Unit{artifact: shape.first[SHAPE_ARTIFACT], target: shape.first[SHAPE_TARGET], profile: shape.first[SHAPE_PROFILE], verb: nil};
    rd.a             = nil;
    rd.modules       = collections_vector.init[ModuleRow](nil);
    rd.run           = nil;
    rd.count         = 0;
    rd.finished      = 0;
    unit_reset(rd);
    if (r.format == FORMAT_HUMAN && !r.quiet && live_start(r)) { rd.sink.live = ?r.live; }
}

# the unit a test run that follows belongs to, which its result lines name; each name borrowed
# until the run ends
pub fun readout_unit(rd: *Readout, artifact: str, target: str, profile: str) {
    rd.unit = readout.Unit{artifact: artifact, target: target, profile: profile, verb: nil};
}

# close a plan's rendering: the live line goes
pub fun readout_end(rd: *Readout) {
    live_stop(rd.r);
}

# forget what the last unit held
fun unit_reset(rd: *Readout) {
    rd.errors   = 0;
    rd.warnings = 0;
    var p: usize = 0;
    for (p < readout.PHASE_COUNT) {
        rd.rows[p] = Row{seen: false, count: 0, elapsed: 0, threads: 0, slowest: nil, slowest_elapsed: 0};
        p          = p + 1;
    }
    var c: usize = 0;
    for (c < readout.COUNTER_COUNT) {
        rd.counts[c] = 0;
        rd.held[c]   = false;
        c            = c + 1;
    }
    rd.modules.len = 0;
    rd.last        = 0;
}

fun readout_on_event(ctx: ptr, ev: *readout.Event) {
    val rd: *Readout = ctx::*Readout;
    if (rd.r.format != FORMAT_HUMAN) { readout_records(rd, ev); }
    or                               { readout_human(rd, ev); }
}

fun readout_human(rd: *Readout, ev: *readout.Event) {
    if (sel ev.unit) {
        unit_reset(rd);
        rd.unit = ev.unit;
    }
    or (sel ev.phase)     { phase_shown(rd, ?ev.phase); }
    or (sel ev.item)      { item_shown(rd, ?ev.item); }
    or (sel ev.tally)     { tally_held(rd, ?ev.tally); }
    or (sel ev.fact)      { fact_w(?rd.r.w, ev.fact.key, ev.fact.value); }
    or (sel ev.growth)    { growth_w(rd, ?ev.growth); }
    or (sel ev.summary)   { summary_shown(rd, ?ev.summary); }
    or (sel ev.reported)  { reported_shown(rd, ?ev.reported); }
    or (sel ev.failure)   { failure_shown(rd, ?ev.failure); }
    or (sel ev.run_start) { run_begin(rd, ?ev.run_start); }
    or (sel ev.test_end)  { test_shown(rd, ev.test_end.at); }
    or (sel ev.run_end)   { run_close(rd, ?ev.run_end); }
}

# the arena the renderer keeps what it holds in, the report's, armed on first use; nil, with
# the refusal kept by the report, when it cannot be made
fun held_alloc(rd: *Readout) *A.Allocator {
    if (rd.a != nil)               { ret rd.a; }
    if (report_paths(rd.r) == nil) { ret nil; }
    rd.a       = ?rd.r.a;
    rd.modules = collections_vector.init[ModuleRow](rd.a);
    ret rd.a;
}

# a copy of s in the renderer's arena, s itself when it cannot be kept
fun kept(rd: *Readout, s: str) str {
    if (s == nil)              { ret nil; }
    if (held_alloc(rd) == nil) { ret s; }
    val res_copy: res[str, A.Error] = str_dup(rd.a, s);
    if (sel res_copy.err) {
        refused(rd.r, fail.refused(res_copy.err));
        ret s;
    }
    ret res_copy.ok;
}

# a log line's lead: the time since the command began, the label, under an item indented, and
# the time, each in its column; what follows is the caller's
fun log_head(rd: *Readout, item: bool, label: str, time: str) {
    log_lead(rd.r, item, label, time);
}

# a log line's lead on the report's stream: the time since the command began, the label, under an
# item indented, and the time, each in its column
fun log_lead(r: *Report, item: bool, label: str, time: str) {
    val w: *io_writer.Writer = ?r.w;
    stamp_w(w, readout.elapsed(r.origin));
    var used: usize = str_len(label);
    if (item) {
        std_format.write_str(w, "  ");
        used = used + 2;
    }
    std_format.write_str(w, label);
    if (used < LABEL_W) { layout.spaces(w, LABEL_W - used); }
    right_w(w, time, TIME_W);
}

# `[  0.07] `: a duration in seconds to two places, right-aligned in its brackets
fun stamp_w(w: *io_writer.Writer, d: chrono_duration.Duration) {
    var cs: u64 = 0;
    if (d > 0) { cs = (d::u64 + 5000000) / 10000000; }
    var t:  layout.Text;
    var tw: io_writer.Writer = layout.text_writer(?t);
    std_format.format(?tw, "{}.", cs / 100);
    if (cs % 100 < 10) { std_format.write_str(?tw, "0"); }
    std_format.format(?tw, "{}", cs % 100);
    val s: str = layout.text_end(?t);
    std_format.write_str(w, "[");
    right_w(w, s, STAMP_W - 3);
    std_format.write_str(w, "] ");
}

# s right-aligned in `width`, spaces alone for nil
fun right_w(w: *io_writer.Writer, s: str, width: usize) {
    var l: usize = 0;
    if (s != nil)  { l = str_len(s); }
    if (l < width) { layout.spaces(w, width - l); }
    if (s != nil)  { std_format.write_str(w, s); }
}

# s left-aligned in `width`; the padding is written only for a cell that has text after it
fun left_w(w: *io_writer.Writer, s: str, width: usize) {
    std_format.write_str(w, s);
    val l: usize = str_len(s);
    if (l < width) { layout.spaces(w, width - l); }
}

# `  N noun` after a line's columns, nothing for a count of zero
fun counted_w(w: *io_writer.Writer, n: u64, one: str, many: str) {
    if (n == 0) { ret; }
    std_format.format(w, "  {} {}", n, layout.noun(n, one, many));
}

# a phase row closed: its time joins the recap, and a phase with a row of its own gets its log
# line under -v, one that processed nothing only where its detail says so
fun phase_shown(rd: *Readout, ev: *readout.PhaseEnd) {
    val row: *Row = ?rd.rows[ev.phase];
    row.seen    = true;
    row.count   = row.count + ev.count;
    row.elapsed = row.elapsed + ev.elapsed;
    if (ev.threads > row.threads) { row.threads = ev.threads; }
    if (ev.slowest != nil && (row.slowest == nil || ev.slowest_elapsed > row.slowest_elapsed)) {
        row.slowest         = kept(rd, ev.slowest);
        row.slowest_elapsed = ev.slowest_elapsed;
    }
    if (rd.sink.level < readout.LEVEL_PHASES)              { ret; }
    if (readout.parent_of(ev.phase) != readout.PHASE_NONE) { ret; }
    if (ev.count == 0 && !readout.shows_zero(ev.phase))    { ret; }
    val w:  *io_writer.Writer = ?rd.r.w;
    var dt: layout.Text;
    log_head(rd, false, readout.label_of(ev.phase), layout.duration(?dt, ev.elapsed));
    val detail: readout.Detail = readout.detail_of(ev.phase);
    if (detail == readout.DETAIL_TARGET) {
        std_format.format(w, "  {}", text_or_empty(rd.unit.target));
        if (!str_is_empty(text_or_empty(rd.unit.profile))) { std_format.format(w, " {}", rd.unit.profile); }
    }
    or (detail == readout.DETAIL_REUSED) {
        if (ev.count == 0) { std_format.write_str(w, "  none reused"); }
        or                 { std_format.format(w, "  {} reused", ev.count::u64); }
    }
    or (detail == readout.DETAIL_SIZE && ev.sized) {
        var st: layout.Text;
        std_format.format(w, "  {}", layout.size(?st, ev.bytes));
    }
    or (detail == readout.DETAIL_SIZE && ev.count == 0) { std_format.write_str(w, "  up to date"); }
    or                                                  { std_format.format(w, "  {} {}", ev.count::u64, readout.noun_of(ev.noun, ev.count::u64)); }
    counted_w(w, ev.errors::u64, "error", "errors");
    counted_w(w, ev.warnings::u64, "warning", "warnings");
    counted_w(w, ev.dropped::u64, "target-gated", "target-gated");
    std_format.write_newline(w);
}

# an item: under -vv a phase with a row of its own shows it as its own line; a part of codegen
# adds its time to its module's, and the module's write, its last part, shows the module's codegen
# time on one line
fun item_shown(rd: *Readout, ev: *readout.Item) {
    if (readout.parent_of(ev.phase) == readout.PHASE_NONE) {
        var dt: layout.Text;
        log_head(rd, true, readout.label_of(ev.phase), layout.duration(?dt, ev.elapsed));
        if (ev.name != nil) { std_format.format(?rd.r.w, "  {}", ev.name); }
        std_format.write_newline(?rd.r.w);
        ret;
    }
    val m: *ModuleRow = module_row(rd, ev.name);
    if (m == nil) { ret; }
    m.times[ev.phase] = m.times[ev.phase] + ev.elapsed;
    if (ev.phase != readout.WRITE) { ret; }
    var total: chrono_duration.Duration = 0;
    var p:     usize                    = 0;
    for (p < readout.PHASE_COUNT) {
        total = total + m.times[p];
        p     = p + 1;
    }
    var dt: layout.Text;
    log_head(rd, true, readout.label_of(readout.parent_of(ev.phase)), layout.duration(?dt, total));
    std_format.format(?rd.r.w, "  {}\n", m.name);
}

# the row of module `name`, made on first sight; nil when it cannot be kept
fun module_row(rd: *Readout, name: str) *ModuleRow {
    if (name == nil || held_alloc(rd) == nil) { ret nil; }
    # a module's parts arrive together, so the last row met is most often the one asked for
    if (rd.last < rd.modules.len && str_equals(rd.modules.data[rd.last].name, name)) { ret ?rd.modules.data[rd.last]; }
    var i: usize = 0;
    for (i < rd.modules.len && !str_equals(rd.modules.data[i].name, name)) { i = i + 1; }
    if (i == rd.modules.len) {
        var m: ModuleRow;
        m.name = kept(rd, name);
        var p: usize = 0;
        for (p < readout.PHASE_COUNT) {
            m.times[p] = 0;
            p          = p + 1;
        }
        var c: usize = 0;
        for (c < readout.COUNTER_COUNT) {
            m.values[c] = 0;
            m.has[c]    = false;
            c           = c + 1;
        }
        val res_pushed: res[usize, A.Error] = collections_vector.push[ModuleRow](?rd.modules, m);
        if (sel res_pushed.err) {
            refused(rd.r, fail.refused(res_pushed.err));
            ret nil;
        }
    }
    rd.last = i;
    ret ?rd.modules.data[i];
}

# a counter's value: the unit's total, held for the code and memory lines, or one module's, held
# for the counter table under -vv
fun tally_held(rd: *Readout, ev: *readout.Tally) {
    if (ev.name == nil) {
        rd.counts[ev.counter] = ev.value;
        rd.held[ev.counter]   = true;
        ret;
    }
    val m: *ModuleRow = module_row(rd, ev.name);
    if (m == nil) { ret; }
    m.values[ev.counter] = ev.value;
    m.has[ev.counter]    = true;
}

# one of the target's facts beneath its log line: its key in a column, then its value
fun fact_w(w: *io_writer.Writer, key: str, value: str) {
    layout.spaces(w, FACT_LEAD);
    left_w(w, key, FACT_KEY_W);
    std_format.format(w, "{}\n", value);
}

# a growing cycle of instances as it expands, written at once so a runaway expansion shows
# while it runs
fun growth_w(rd: *Readout, ev: *readout.Growth) {
    log_head(rd, false, GROWTH_LABEL, nil);
    std_format.format(?rd.r.w, "  growing cycle {} in {}: {} {} so far\n", ev.members, ev.module, ev.instances::u64, layout.noun(ev.instances::u64, "instance", "instances"));
}

# a diagnostic, rendered the moment the unit settled it, a blank line owed after it
fun reported_shown(rd: *Readout, ev: *readout.Reported) {
    render(?rd.r.w, ev.sources, ev.diag);
    count_record(rd.r, ev.diag);
    if (diagnostic.is_error(ev.diag))           { rd.errors = rd.errors + 1; }
    or (!diagnostic_kind.is_note(ev.diag.kind)) { rd.warnings = rd.warnings + 1; }
    owe_blank(rd.r);
}

# a failure that reached no store, rendered as the diagnostic it reads as
fun failure_shown(rd: *Readout, ev: *readout.Failure) {
    if (sel ev.fail.reported) { ret; }
    val code: i64 = report_failure(rd.r, ev.fail, ev.origin);
    rd.errors = rd.errors + 1;
    owe_blank(rd.r);
}

# whether a unit found everything current: it compiled nothing and wrote nothing
fun unchanged(ev: *readout.Summary) bool {
    ret ev.closed == readout.CLOSED_BUILT && ev.compiled == 0 && !ev.written;
}

# a unit's close: under -vv its recap, then its result line. a test build's dispatcher has none,
# the run that follows closing it
fun summary_shown(rd: *Readout, ev: *readout.Summary) {
    if (ev.closed == readout.CLOSED_TESTS)               { ret; }
    if (ev.rows && rd.sink.level >= readout.LEVEL_ITEMS) { recap_w(rd, ?rd.r.w, ev); }
    if (rd.quiet)                                        { ret; }
    val w:    *io_writer.Writer = out(rd.r);
    var verb: layout.Verb       = layout.BUILT;
    if (ev.closed == readout.CLOSED_FAILED)  { verb = layout.FAILED; }
    or (ev.closed == readout.CLOSED_CHECKED) { verb = layout.CHECKED; }
    or (unchanged(ev))                       { verb = layout.UNCHANGED; }
    result_lead(rd, w, verb);
    counted_w(w, rd.errors::u64, "error", "errors");
    counted_w(w, rd.warnings::u64, "warning", "warnings");
    result_time(rd, w, ev.total);
    if (verb != layout.FAILED && verb != layout.CHECKED && ev.out != nil) { std_format.format(w, "  {}", shown_path(ev.out)); }
    std_format.write_newline(w);
}

# a result line's verb, then the unit's artifact and, where the plan's units differ in them, its
# target and profile, each padded to the plan's widest when the plan holds more than one unit
fun result_lead(rd: *Readout, w: *io_writer.Writer, verb: layout.Verb) {
    layout.said(w, verb);
    var names: [SHAPE_COLUMNS]str = [SHAPE_COLUMNS]str{rd.unit.artifact, rd.unit.target, rd.unit.profile};
    val many:  bool               = rd.shape.units > 1;
    var c:     usize              = 0;
    for (c < SHAPE_COLUMNS) {
        if (c == SHAPE_ARTIFACT || rd.shape.differs[c]) {
            if (c != SHAPE_ARTIFACT)         { std_format.write_str(w, "  "); }
            if (many && rd.shape.differs[c]) { left_w(w, text_or_empty(names[c]), rd.shape.widths[c]); }
            or                               { std_format.write_str(w, text_or_empty(names[c])); }
        }
        c = c + 1;
    }
}

# a result line's time, right-aligned when the plan holds more than one unit, so the units' lines line up
fun result_time(rd: *Readout, w: *io_writer.Writer, d: chrono_duration.Duration) {
    var dt:   layout.Text;
    val time: str = layout.duration(?dt, d);
    std_format.write_str(w, "  ");
    if (rd.shape.units > 1) { right_w(w, time, TIME_W); }
    or                      { std_format.write_str(w, time); }
}

# a path as a result line shows it, without a leading `./`
pub fun shown_path(p: str) str {
    if (str_starts_with(p, "./")) { ret (p::usize + 2)::str; }
    ret p;
}

# the unit's recap under -vv, each block after a blank line: a row a phase with its count, time
# and bar, the parts of a phase indented beneath it, then `other` and `total` and the legend of
# the summed mark; the code and memory lines; each module's codegen times; each module's counters
fun recap_w(rd: *Readout, w: *io_writer.Writer, sum: *readout.Summary) {
    var most:    chrono_duration.Duration = sum.other;
    var threads: u32                      = 0;
    var mixed:   bool                     = false;
    var p:       usize                    = 0;
    for (p < readout.PHASE_COUNT) {
        val row: *Row = ?rd.rows[p];
        p = p + 1;
        if (!row.seen || row.elapsed <= 0) { cnt; }
        if (row.elapsed > most)            { most = row.elapsed; }
        if (row.threads > 1) {
            if (threads != 0 && threads != row.threads) { mixed = true; }
            if (row.threads > threads)                  { threads = row.threads; }
        }
    }
    std_format.write_newline(w);
    left_w(w, "stage", RECAP_LABEL_W);
    right_w(w, "count", RECAP_COUNT_W);
    layout.spaces(w, 2);
    right_w(w, "time", RECAP_TIME_W + 1);
    std_format.write_newline(w);
    p = 0;
    for (p < readout.PHASE_COUNT) {
        val row: *Row = ?rd.rows[p];
        if (row.seen && row.elapsed > 0) { recap_row_w(w, p::readout.Phase, row, most); }
        p = p + 1;
    }
    recap_total_w(w, "other", sum.other);
    recap_total_w(w, "total", sum.total);
    if (threads > 0) {
        if (mixed) { std_format.format(w, "{} summed over up to {} threads\n", SUMMED_MARK, threads::u64); }
        or         { std_format.format(w, "{} summed over {} threads\n", SUMMED_MARK, threads::u64); }
    }
    counter_lines(rd, w);
    module_times(rd, w);
    module_counters(rd, w);
    std_format.write_newline(w);
}

# one recap row: its label, its count, blank when zero or for a row whose count is not a count
# of what it processed, its time and mark, its bar, and its slowest item when it had several
fun recap_row_w(w: *io_writer.Writer, ph: readout.Phase, row: *Row, most: chrono_duration.Duration) {
    var label: usize = str_len(readout.label_of(ph));
    if (readout.parent_of(ph) != readout.PHASE_NONE) {
        std_format.write_str(w, "  ");
        label = label + 2;
    }
    std_format.write_str(w, readout.label_of(ph));
    if (label < RECAP_LABEL_W) { layout.spaces(w, RECAP_LABEL_W - label); }
    var ct:    layout.Text;
    var count: str = nil;
    if (row.count > 0 && readout.detail_of(ph) != readout.DETAIL_REUSED) { count = layout.count(?ct, row.count::u64); }
    right_w(w, count, RECAP_COUNT_W);
    layout.spaces(w, 2);
    var dt: layout.Text;
    right_w(w, layout.duration(?dt, row.elapsed), RECAP_TIME_W);
    if (row.threads > 1) { std_format.write_str(w, SUMMED_MARK); }
    or                   { std_format.write_str(w, " "); }
    layout.spaces(w, 2);
    var bt:  layout.Text;
    val bar: str = layout.bar_text(?bt, layout.bar_length(row.elapsed::u64, most::u64));
    if (row.count > 1 && row.slowest != nil) {
        left_w(w, bar, layout.BAR);
        var st: layout.Text;
        std_format.format(w, "  slowest {} {}", row.slowest, layout.duration(?st, row.slowest_elapsed));
    }
    or { std_format.write_str(w, bar); }
    std_format.write_newline(w);
}

fun recap_total_w(w: *io_writer.Writer, label: str, d: chrono_duration.Duration) {
    left_w(w, label, RECAP_LABEL_W);
    layout.spaces(w, RECAP_COUNT_W + 2);
    var dt: layout.Text;
    right_w(w, layout.duration(?dt, d), RECAP_TIME_W);
    std_format.write_newline(w);
}

# a counter's value as a person reads it: a size for a count of bytes, else grouped digits
fun counter_text(t: *layout.Text, c: readout.Counter, value: u64) str {
    if (readout.counter_bytes(c)) { ret layout.size(t, value); }
    ret layout.grouped(t, value);
}

# the counter totals as two lines, after a blank line: what the code came to, and what building
# it took of memory. a total of zero is not shown
fun counter_lines(rd: *Readout, w: *io_writer.Writer) {
    var code: bool  = false;
    var c:    usize = 0;
    for (c < readout.COUNTER_COUNT) {
        if (rd.held[c] && rd.counts[c] > 0 && readout.counter_group(c::readout.Counter) == readout.GROUP_CODE) { code = true; }
        c = c + 1;
    }
    val peak:   bool = rd.held[readout.HEAP_PEAK] && rd.counts[readout.HEAP_PEAK] > 0;
    val bytes:  bool = rd.held[readout.ALLOCATED_BYTES] && rd.counts[readout.ALLOCATED_BYTES] > 0;
    val blocks: bool = rd.held[readout.ALLOCATED_BLOCKS] && rd.counts[readout.ALLOCATED_BLOCKS] > 0;
    if (!code && !peak && !bytes && !blocks) { ret; }
    std_format.write_newline(w);
    if (code) {
        std_format.write_str(w, "code  ");
        c = 0;
        for (c < readout.COUNTER_COUNT) {
            if (rd.held[c] && rd.counts[c] > 0 && readout.counter_group(c::readout.Counter) == readout.GROUP_CODE) {
                var t: layout.Text;
                std_format.format(w, "  {} {}", counter_text(?t, c::readout.Counter, rd.counts[c]), readout.counter_word(c::readout.Counter, rd.counts[c]));
            }
            c = c + 1;
        }
        std_format.write_newline(w);
    }
    if (peak || bytes || blocks) {
        std_format.write_str(w, "memory");
        var pt: layout.Text;
        var at: layout.Text;
        var kt: layout.Text;
        if (peak)  { std_format.format(w, "  {} peak", layout.size(?pt, rd.counts[readout.HEAP_PEAK])); }
        if (bytes) { std_format.format(w, "  {} allocated", layout.size(?at, rd.counts[readout.ALLOCATED_BYTES])); }
        val nblocks: u64 = rd.counts[readout.ALLOCATED_BLOCKS];
        val wblocks: str = readout.counter_word(readout.ALLOCATED_BLOCKS, nblocks);
        if (bytes && blocks) { std_format.format(w, " in {} {}", layout.grouped(?kt, nblocks), wblocks); }
        or (blocks)          { std_format.format(w, "  {} {}", layout.grouped(?kt, nblocks), wblocks); }
        std_format.write_newline(w);
    }
}

# the module column of the -vv tables: wide enough for the longest module and two spaces
fun module_width(rd: *Readout) usize {
    var w: usize = str_len("module");
    var i: usize = 0;
    for (i < rd.modules.len) {
        val l: usize = str_len(rd.modules.data[i].name);
        if (l > w) { w = l; }
        i = i + 1;
    }
    ret w + 2;
}

# whether the module row's time of phase p is shown: a part of codegen some module spent time in
fun times_shown(rd: *Readout, p: usize) bool {
    if (readout.parent_of(p::readout.Phase) == readout.PHASE_NONE) { ret false; }
    var i: usize = 0;
    for (i < rd.modules.len) {
        if (rd.modules.data[i].times[p] > 0) { ret true; }
        i = i + 1;
    }
    ret false;
}

# each module's codegen under -vv, after a blank line: a row a module in the order codegen wrote
# them, a column a part of codegen any module spent time in, and the module's total
fun module_times(rd: *Readout, w: *io_writer.Writer) {
    var any: bool  = false;
    var p:   usize = 0;
    for (p < readout.PHASE_COUNT) {
        if (times_shown(rd, p)) { any = true; }
        p = p + 1;
    }
    if (!any) { ret; }
    val mw: usize = module_width(rd);
    std_format.write_newline(w);
    left_w(w, "module", mw);
    p = 0;
    for (p < readout.PHASE_COUNT) {
        if (times_shown(rd, p)) { right_w(w, readout.label_of(p::readout.Phase), CELL_W); }
        p = p + 1;
    }
    right_w(w, "total", CELL_W);
    std_format.write_newline(w);
    var i: usize = 0;
    for (i < rd.modules.len) {
        val m: *ModuleRow = ?rd.modules.data[i];
        i = i + 1;
        left_w(w, m.name, mw);
        var total: chrono_duration.Duration = 0;
        var owed:  usize                    = 0;
        p = 0;
        for (p < readout.PHASE_COUNT) {
            if (times_shown(rd, p)) {
                total = total + m.times[p];
                if (m.times[p] > 0) {
                    var dt: layout.Text;
                    layout.spaces(w, owed);
                    owed = 0;
                    right_w(w, layout.duration(?dt, m.times[p]), CELL_W);
                }
                or { owed = owed + CELL_W; }
            }
            p = p + 1;
        }
        if (total > 0) {
            var tt: layout.Text;
            layout.spaces(w, owed);
            right_w(w, layout.duration(?tt, total), CELL_W);
        }
        std_format.write_newline(w);
    }
}

# each module's counters under -vv, after a blank line: a row a module, a column a counter any
# module posted a value other than zero for, headed by the counter's head
fun module_counters(rd: *Readout, w: *io_writer.Writer) {
    var widths: [readout.COUNTER_COUNT]usize;
    var any:    bool  = false;
    var c:      usize = 0;
    for (c < readout.COUNTER_COUNT) {
        widths[c] = 0;
        var i: usize = 0;
        for (i < rd.modules.len) {
            val m: *ModuleRow = ?rd.modules.data[i];
            i = i + 1;
            if (!m.has[c] || m.values[c] == 0) { cnt; }
            var t: layout.Text;
            val l: usize = str_len(counter_text(?t, c::readout.Counter, m.values[c]));
            if (widths[c] == 0) { widths[c] = str_len(readout.counter_head(c::readout.Counter)); }
            if (l > widths[c])  { widths[c] = l; }
        }
        if (widths[c] > 0) {
            widths[c] = widths[c] + 2;
            any       = true;
        }
        c = c + 1;
    }
    if (!any) { ret; }
    val mw: usize = module_width(rd);
    std_format.write_newline(w);
    left_w(w, "module", mw);
    c = 0;
    for (c < readout.COUNTER_COUNT) {
        if (widths[c] > 0) { right_w(w, readout.counter_head(c::readout.Counter), widths[c]); }
        c = c + 1;
    }
    std_format.write_newline(w);
    var i: usize = 0;
    for (i < rd.modules.len) {
        val m: *ModuleRow = ?rd.modules.data[i];
        i = i + 1;
        std_format.write_str(w, m.name);
        var owed: usize = 0;
        if (str_len(m.name) < mw) { owed = mw - str_len(m.name); }
        c = 0;
        for (c < readout.COUNTER_COUNT) {
            if (widths[c] > 0) {
                if (m.has[c] && m.values[c] > 0) {
                    var t: layout.Text;
                    layout.spaces(w, owed);
                    owed = 0;
                    right_w(w, counter_text(?t, c::readout.Counter, m.values[c]), widths[c]);
                }
                or { owed = owed + widths[c]; }
            }
            c = c + 1;
        }
        std_format.write_newline(w);
    }
}

# the records member: a record for each event, each written as its event arrives. under -v
# every unit opens with a unit record naming its artifact, target and profile, and its summary
# writes the `other` phase record; every unit that built keeps its `built` line for the
# closing summary record
fun readout_records(rd: *Readout, ev: *readout.Event) {
    val r: *Report = rd.r;
    if (sel ev.failure) {
        if (!sel ev.failure.fail.reported) { val code: i64 = report_failure(r, ev.failure.fail, ev.failure.origin); }
    }
    or (sel ev.reported) {
        render_record(r, ev.reported.sources, report_paths(r), ev.reported.diag);
        count_record(r, ev.reported.diag);
    }
    or (sel ev.unit) {
        if (rd.sink.level >= readout.LEVEL_PHASES) { unit_record(r, ?ev.unit); }
    }
    or (sel ev.phase)     { phase_record(r, ?ev.phase); }
    or (sel ev.item)      { item_record(r, ?ev.item); }
    or (sel ev.tally)     { tally_record(r, ?ev.tally); }
    or (sel ev.fact)      { fact_record(r, ?ev.fact); }
    or (sel ev.growth)    { growth_record(r, ?ev.growth); }
    or (sel ev.summary)   { summary_record(r, ?ev.summary); }
    or (sel ev.run_start) { run_start_record(r, ?ev.run_start); }
    or (sel ev.test_end)  { report_test(r, ?ev.test_end.tests[ev.test_end.at]); }
    or (sel ev.run_end)   { run_end_record(r, ?ev.run_end); }
}

# a duration as the integer microseconds a record carries
fun micros(d: chrono_duration.Duration) i64 {
    ret chrono_duration.duration_nsec(d) / 1000;
}

fun unit_record(r: *Report, ev: *readout.Unit) {
    var o: record.Record;
    record.begin(?r.w, enc(r), ?o, "unit");
    record.text(?o, "verb", ev.verb);
    record.text(?o, "artifact", ev.artifact);
    if (!str_is_empty(ev.target))  { record.text(?o, "target", ev.target); }
    if (!str_is_empty(ev.profile)) { record.text(?o, "profile", ev.profile); }
    record.end(?o);
}

fun phase_record(r: *Report, ev: *readout.PhaseEnd) {
    val noun: str = readout.noun_of(ev.noun, ev.count::u64);
    var o:    record.Record;
    record.begin(?r.w, enc(r), ?o, "phase");
    record.text(?o, "name", readout.label_of(ev.phase));
    val parent: readout.Phase = readout.parent_of(ev.phase);
    if (parent != readout.PHASE_NONE) { record.text(?o, "parent", readout.label_of(parent)); }
    record.int(?o, "count", ev.count::i64);
    record.text(?o, "unit", noun);
    record.int(?o, "time_us", micros(ev.elapsed));
    if (ev.threads > 1) { record.int(?o, "threads", ev.threads::i64); }
    if (ev.dropped > 0) { record.int(?o, "dropped", ev.dropped::i64); }
    if (ev.sized)       { record.int(?o, "bytes", ev.bytes::i64); }
    if (ev.slowest != nil) {
        record.text(?o, "slowest", ev.slowest);
        record.int(?o, "slowest_us", micros(ev.slowest_elapsed));
    }
    record.end(?o);
}

fun item_record(r: *Report, ev: *readout.Item) {
    var o: record.Record;
    record.begin(?r.w, enc(r), ?o, "phase_item");
    record.text(?o, "phase", readout.label_of(ev.phase));
    record.text(?o, "name", ev.name);
    record.int(?o, "time_us", micros(ev.elapsed));
    record.end(?o);
}

# a counter's value: a module's, named by it, or the unit's total, with no name
fun tally_record(r: *Report, ev: *readout.Tally) {
    var o: record.Record;
    record.begin(?r.w, enc(r), ?o, "counter");
    record.text(?o, "counter", readout.counter_label(ev.counter));
    if (ev.name != nil) { record.text(?o, "name", ev.name); }
    record.int(?o, "value", ev.value::i64);
    record.end(?o);
}

# one fact of the unit's target, by its key
fun fact_record(r: *Report, ev: *readout.Fact) {
    var o: record.Record;
    record.begin(?r.w, enc(r), ?o, "fact");
    record.text(?o, "key", ev.key);
    record.text(?o, "value", ev.value);
    record.end(?o);
}

fun growth_record(r: *Report, ev: *readout.Growth) {
    var o: record.Record;
    record.begin(?r.w, enc(r), ?o, "growth");
    record.text(?o, "module", ev.module);
    record.text(?o, "members", ev.members);
    record.int(?o, "instances", ev.instances::i64);
    record.end(?o);
}

# a unit's summary: under -v its `other` row as a phase record without a count, and the
# `built` line of a unit that built, kept for the closing summary record
fun summary_record(r: *Report, ev: *readout.Summary) {
    if (ev.rows) {
        var o: record.Record;
        record.begin(?r.w, enc(r), ?o, "phase");
        record.text(?o, "name", "other");
        record.int(?o, "time_us", micros(ev.other));
        record.end(?o);
    }
    if (ev.closed == readout.CLOSED_BUILT || ev.closed == readout.CLOSED_TESTS) { report_built(r, ev); }
}

# a test run starts: its module lines' columns are measured from its modules and their counts,
# and the live line shows it
fun run_begin(rd: *Readout, ev: *readout.RunStart) {
    rd.run      = ev.tests;
    rd.count    = ev.count;
    rd.finished = 0;
    rd.mod_w    = 0;
    rd.tests_w  = 0;
    var first: u32 = 0;
    for (first < ev.count) {
        val last: u32   = module_last(rd, first);
        val ml:   usize = str_len(ev.tests[first].art.module);
        if (ml > rd.mod_w) { rd.mod_w = ml; }
        var t:  layout.Text;
        var tw: io_writer.Writer = layout.text_writer(?t);
        std_format.format(?tw, "{} {}", (last - first + 1)::u64, layout.noun((last - first + 1)::u64, "test", "tests"));
        val cl: usize = str_len(layout.text_end(?t));
        if (cl > rd.tests_w) { rd.tests_w = cl; }
        first = last + 1;
    }
    readout.live_stage(rd.sink.live, RUN_LABEL, readout.sample());
    readout.live_reach(rd.sink.live, 0, ev.count, nil);
}

val RUN_LABEL: str = "run";

# the last test of the module whose tests start at `first`, its tests running together
fun module_last(rd: *Readout, first: u32) u32 {
    var last: u32 = first;
    for (last + 1 < rd.count && str_equals(rd.run[last + 1].art.module, rd.run[first].art.module)) { last = last + 1; }
    ret last;
}

# a finished test, in the order the tests finish: under -vv its own line, a failure as its
# diagnostic at once, and its module's line once every test of the module has finished, so a
# slow test holds back only its own module
fun test_shown(rd: *Readout, at: u32) {
    val t: *readout.TestResult = ?rd.run[at];
    rd.finished = rd.finished + 1;
    live_test(rd, t);
    if (rd.sink.level >= readout.LEVEL_ITEMS) {
        var dt: layout.Text;
        log_head(rd, true, RUN_LABEL, layout.duration(?dt, t.elapsed));
        std_format.format(?rd.r.w, "  {}", t.art.name);
        if (failure(?t.result))                   { std_format.write_str(?rd.r.w, "  failed"); }
        or (t.result.kind == testrun.RESULT_SKIP) { std_format.write_str(?rd.r.w, "  skipped"); }
        std_format.write_newline(?rd.r.w);
        if (!failure(?t.result)) { captured_w(?rd.r.w, t, FACT_LEAD); }
    }
    if (failure(?t.result)) { test_failed_w(rd, t); }
    var first: u32 = at;
    for (first > 0 && str_equals(rd.run[first - 1].art.module, t.art.module)) { first = first - 1; }
    val last: u32 = module_last(rd, first);
    var j:    u32 = first;
    for (j <= last) {
        if (!rd.run[j].done) { ret; }
        j = j + 1;
    }
    module_line_w(rd, first, last);
}

# a test as the live line names it, `module#test`
fun live_test(rd: *Readout, t: *readout.TestResult) {
    readout.live_reach(rd.sink.live, rd.finished, rd.count, t.art.name::str);
}

# a module's line: passed, failed when any of its tests failed, skipped when every test was; its
# count, how many failed, timed out and were skipped, and its slowest test's time, the tests
# having run side by side
fun module_line_w(rd: *Readout, first: u32, last: u32) {
    if (rd.quiet) { ret; }
    val tests:     *readout.TestResult      = rd.run;
    var failed:    u32                      = 0;
    var skipped:   u32                      = 0;
    var timed_out: u32                      = 0;
    var slowest:   chrono_duration.Duration = 0;
    var j:         u32                      = first;
    for (j <= last) {
        if (failure(?tests[j].result))                   { failed = failed + 1; }
        or (tests[j].result.kind == testrun.RESULT_SKIP) { skipped = skipped + 1; }
        if (timed_out_result(?tests[j].result))          { timed_out = timed_out + 1; }
        if (tests[j].elapsed > slowest)                  { slowest = tests[j].elapsed; }
        j = j + 1;
    }
    val n:    u32               = last - first + 1;
    val w:    *io_writer.Writer = out(rd.r);
    var verb: layout.Verb       = layout.PASSED;
    if (failed > 0)   { verb = layout.FAILED; }
    or (skipped == n) { verb = layout.SKIPPED; }
    layout.said(w, verb);
    left_w(w, tests[first].art.module, rd.mod_w);
    var ct: layout.Text;
    var cw: io_writer.Writer = layout.text_writer(?ct);
    std_format.format(?cw, "{} {}", n::u64, layout.noun(n::u64, "test", "tests"));
    std_format.write_str(w, "  ");
    left_w(w, layout.text_end(?ct), rd.tests_w);
    tests_counted_w(w, failed, timed_out, skipped);
    var dt: layout.Text;
    std_format.format(w, "  {}\n", layout.duration(?dt, slowest));
}

# `  N failed  N timed out  N skipped`, each only when nonzero
fun tests_counted_w(w: *io_writer.Writer, failed: u32, timed_out: u32, skipped: u32) {
    if (failed > 0)    { std_format.format(w, "  {} failed", failed::u64); }
    if (timed_out > 0) { std_format.format(w, "  {} timed out", timed_out::u64); }
    if (skipped > 0)   { std_format.format(w, "  {} skipped", skipped::u64); }
}

fun timed_out_result(r: *testrun.GateResult) bool {
    ret r.kind == testrun.RESULT_RESOURCE_EXHAUSTION && r.cause == testrun.CAUSE_ORACLE_TIMEOUT;
}

# a failed test as the diagnostic it is: what it did, at its declaration, its captured output and
# how to rerun it alone, a blank line owed after it
fun test_failed_w(rd: *Readout, t: *readout.TestResult) {
    val a: *A.Allocator = held_alloc(rd);
    if (a == nil) { ret; }
    var reason:      layout.Text;
    val res_message: res[str, std_format.FormatError] = std_format.sprint(a, "test {} {}", own_name(t.art), reason_text(?reason, t));
    if (sel res_message.err) {
        refused(rd.r, fail.format_refused(res_message.err));
        ret;
    }
    var map: base_source.SourceMap = base_source.init(a);
    fin { base_source.dnit(?map); }
    var d: diagnostic.Diagnostic;
    d.kind     = diagnostic_kind.TEST_FAILED;
    d.origin   = diagnostic.ORIGIN_TEST;
    d.loc      = declared_at(a, ?map, t.art);
    d.message  = res_message.ok;
    d.children = collections_vector.init[diagnostic.Child](a);
    d.related  = collections_vector.init[annotation.Related](nil);
    d.fixes    = collections_vector.init[annotation.Fix](nil);
    val output: str = output_text(a, t);
    if (output != nil) { note_child(rd, ?d, output); }
    if (t.truncated && t.log != nil) {
        val res_whole: res[str, std_format.FormatError] = std_format.sprint(a, "the whole output is in {}", t.log);
        if (sel res_whole.ok) { note_child(rd, ?d, res_whole.ok); }
    }
    var exe: str = t.art.exe::str;
    if (t.launch != nil) { exe = t.launch; }
    val res_rerun: res[str, std_format.FormatError] = std_format.sprint(a, "rerun it alone with {} {}", exe, t.art.idx::u64);
    if (sel res_rerun.ok) { note_child(rd, ?d, res_rerun.ok); }
    render(?rd.r.w, ?map, ?d);
    owe_blank(rd.r);
}

# a test's own name, its qualified name past the module and `#`
fun own_name(art: *testrun.TestArtifact) str {
    val name: str   = art.name::str;
    val n:    usize = str_len(name);
    var i:    usize = n;
    for (i > 0 && name[i - 1] != '#') { i = i - 1; }
    ret (?name[i])::str;
}

fun note_child(rd: *Readout, d: *diagnostic.Diagnostic, text: str) {
    val res_pushed: res[usize, A.Error] = collections_vector.push[diagnostic.Child](?d.children, diagnostic.Child{kind: diagnostic.CHILD_NOTE, text: text});
    if (sel res_pushed.err) { refused(rd.r, fail.refused(res_pushed.err)); }
}

# what a failed test did, as its diagnostic says it
fun reason_text(t: *layout.Text, r: *readout.TestResult) str {
    var w:  io_writer.Writer    = layout.text_writer(t);
    val gr: *testrun.GateResult = ?r.result;
    if (timed_out_result(gr)) {
        val d: duration.Text = duration.text(r.bound);
        std_format.format(?w, "timed out after {}{}", d.n, d.unit);
    }
    or (gr.kind == testrun.RESULT_SEMANTIC_MISMATCH && gr.cause == testrun.CAUSE_ORACLE_EXIT)               { std_format.format(?w, "exited with {}", r.code::i64); }
    or (gr.kind == testrun.RESULT_SEMANTIC_MISMATCH && gr.cause == testrun.CAUSE_ORACLE_SIGNAL)             { std_format.format(?w, "was stopped by signal {}", r.code::i64); }
    or (gr.kind == testrun.RESULT_INFRASTRUCTURE_FAILURE && gr.cause == testrun.CAUSE_ORACLE_SPAWN_FAILURE) { std_format.write_str(?w, "could not be launched"); }
    or (gr.kind == testrun.RESULT_INFRASTRUCTURE_FAILURE && gr.cause == testrun.CAUSE_ORACLE_CAPTURE)       { std_format.write_str(?w, "ran, and its output could not be captured"); }
    or (gr.kind == testrun.RESULT_INFRASTRUCTURE_FAILURE && gr.cause == testrun.CAUSE_INVALID_TERMINAL)     { std_format.write_str(?w, "could not be judged, its runner failed"); }
    or                                                                                                      { std_format.write_str(?w, "failed"); }
    ret layout.text_end(t);
}

# where a test is declared: its `test` and name on its line, read from its file; nil where the
# file cannot be read or holds no such line, and the diagnostic then names no place
fun declared_at(a: *A.Allocator, map: *base_source.SourceMap, art: *testrun.TestArtifact) base_source.Location {
    val none: base_source.Location = base_source.location_nil();
    if (art.file == nil || art.line == 0) { ret none; }
    val res_text: res[str, fs.FsError] = fs.read_string(a, art.file::types_path.Path);
    if (sel res_text.err) { ret none; }
    val res_added: res[base_source.FileId, base_source.Error] = base_source.add(map, art.file::str, res_text.ok);
    if (sel res_added.err) { ret none; }
    val opt_file: opt[*base_source.SourceFile] = base_source.get(map, res_added.ok);
    if (sel opt_file.none) { ret none; }
    val sf:        *base_source.SourceFile = opt_file.some;
    val opt_start: opt[usize]              = base_source.line_start(sf, art.line::usize);
    if (sel opt_start.none) { ret none; }
    val text: str   = sf.text;
    val len:  usize = str_len(text);
    var from: usize = opt_start.some;
    for (from < len && (text[from] == ' ' || text[from] == '\t')) { from = from + 1; }
    var end: usize = from;
    for (end < len && text[end] != ' ' && text[end] != '\t' && text[end] != '\n') { end = end + 1; }
    for (end < len && (text[end] == ' ' || text[end] == '\t')) { end = end + 1; }
    for (end < len && name_byte(text[end])) { end = end + 1; }
    if (end == from) { ret none; }
    ret base_source.location(res_added.ok, base_source.span_between(from, end));
}

fun name_byte(c: u8) bool {
    ret (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_';
}

# a failed test's captured output as its note says it, `output:` and each line beneath; nil
# when it printed nothing
fun output_text(a: *A.Allocator, t: *readout.TestResult) str {
    if (t.out == nil || t.out_len == 0) { ret nil; }
    var n: usize = t.out_len;
    for (n > 0 && (t.out[n - 1] == '\n' || t.out[n - 1] == '\r')) { n = n - 1; }
    if (n == 0) { ret nil; }
    val lead:     str               = "output:\n";
    val res_text: res[*u8, A.Error] = A.allocate[u8](a, str_len(lead) + n + 1);
    if (sel res_text.err) { ret nil; }
    val buf: *u8   = res_text.ok;
    var at:  usize = 0;
    var i:   usize = 0;
    for (lead[i] != 0) {
        buf[at] = lead[i];
        at      = at + 1;
        i       = i + 1;
    }
    i = 0;
    for (i < n) {
        buf[at] = t.out[i];
        at      = at + 1;
        i       = i + 1;
    }
    buf[at] = 0;
    ret buf::str;
}

# a passing test's captured output under -vv, each line indented by `indent`
fun captured_w(w: *io_writer.Writer, t: *readout.TestResult, indent: usize) {
    if (t.out == nil || t.out_len == 0) { ret; }
    var i:   usize = 0;
    var seg: usize = 0;
    for (i < t.out_len) {
        if (t.out[i] == '\n') {
            layout.spaces(w, indent);
            std_format.write_bytes(w, (t.out::usize + seg)::*u8, i - seg + 1);
            seg = i + 1;
        }
        i = i + 1;
    }
    if (seg < t.out_len) {
        layout.spaces(w, indent);
        std_format.write_bytes(w, (t.out::usize + seg)::*u8, t.out_len - seg);
        std_format.write_newline(w);
    }
}

# the run's close: the live line goes, under -v its log line, then its result line: passed or
# failed with the count, how many failed, timed out and were skipped, and the time since the
# command began
fun run_close(rd: *Readout, ev: *readout.RunEnd) {
    readout.live_close(rd.sink.live);
    if (rd.sink.level >= readout.LEVEL_PHASES) {
        var dt: layout.Text;
        log_head(rd, false, RUN_LABEL, layout.duration(?dt, ev.wall));
        std_format.format(?rd.r.w, "  {} {}", ev.count::u64, layout.noun(ev.count::u64, "test", "tests"));
        tests_counted_w(?rd.r.w, ev.failed, ev.timed_out, ev.skipped);
        std_format.write_newline(?rd.r.w);
    }
    rd.run   = nil;
    rd.count = 0;
    if (rd.quiet) { ret; }
    val w:    *io_writer.Writer = out(rd.r);
    var verb: layout.Verb       = layout.PASSED;
    if (ev.failed > 0) { verb = layout.FAILED; }
    result_lead(rd, w, verb);
    std_format.format(w, "  {} {}", ev.count::u64, layout.noun(ev.count::u64, "test", "tests"));
    tests_counted_w(w, ev.failed, ev.timed_out, ev.skipped);
    result_time(rd, w, readout.elapsed(rd.r.origin));
    std_format.write_newline(w);
}

fun run_start_record(r: *Report, ev: *readout.RunStart) {
    var o: record.Record;
    record.begin(?r.w, enc(r), ?o, "run_start");
    record.int(?o, "tests", ev.count::i64);
    record.end(?o);
}

fun run_end_record(r: *Report, ev: *readout.RunEnd) {
    var o: record.Record;
    record.begin(?r.w, enc(r), ?o, "run_end");
    record.int(?o, "passed", ev.passed::i64);
    record.int(?o, "failed", ev.failed::i64);
    record.int(?o, "skipped", ev.skipped::i64);
    record.int(?o, "total", ev.count::i64);
    record.int(?o, "duration_ns", chrono_duration.duration_nsec(ev.wall));
    record.int(?o, "mismatch", ev.tally.semantic_mismatch::i64);
    record.int(?o, "infrastructure_failure", ev.tally.infrastructure_failure::i64);
    record.int(?o, "resource_exhaustion", ev.tally.resource_exhaustion::i64);
    record.int(?o, "timed_out", ev.timed_out::i64);
    val opt_origin: opt[str] = diagnostic.origin_name(diagnostic.ORIGIN_TEST);
    if (sel opt_origin.some) { record.text(?o, "origin", opt_origin.some); }
    record.end(?o);
}

# the live line's period: how often the drawer redraws it, which is also how long a stage runs
# before it shows
val LIVE_PERIOD: chrono_duration.Duration = 50000000;

# the most bytes of the live line kept
val LIVE_LINE: usize = 320;

# the width a terminal is taken to have when COLUMNS names none
val LIVE_COLUMNS: usize = 80;

# whether stderr is a terminal the live line can be drawn on, one whose TERM is set and not `dumb`
fun live_capable() bool {
    if (!terminal.is_terminal(2)) { ret false; }
    var buf:     [64]u8;
    val res_get: res[opt[usize], env.EnvError] = env.get("TERM", ?buf[0], 64);
    if (sel res_get.err) { ret false; }
    val opt_len: opt[usize] = res_get.ok;
    if (sel opt_len.none)   { ret false; }
    if (opt_len.some >= 64) { ret true; }
    ret opt_len.some > 0 && !str_equals((?buf[0])::str, "dumb");
}

# the terminal's width as COLUMNS gives it, LIVE_COLUMNS when it gives none
fun live_width() usize {
    var buf:     [16]u8;
    val res_get: res[opt[usize], env.EnvError] = env.get("COLUMNS", ?buf[0], 16);
    if (sel res_get.err) { ret LIVE_COLUMNS; }
    val opt_len: opt[usize] = res_get.ok;
    if (sel opt_len.none)                        { ret LIVE_COLUMNS; }
    if (opt_len.some == 0 || opt_len.some >= 16) { ret LIVE_COLUMNS; }
    var n: usize = 0;
    var i: usize = 0;
    for (i < opt_len.some) {
        if (buf[i] < '0' || buf[i] > '9') { ret LIVE_COLUMNS; }
        n = n * 10 + (buf[i] - '0')::usize;
        i = i + 1;
    }
    if (n < 2) { ret LIVE_COLUMNS; }
    ret n;
}

# start drawing the live line from the report's slot, on a thread of its own; a report already
# drawing goes on
# ---
# r:   the command's report
# ret: whether the live line is drawn, false where stderr is no terminal or the thread is refused
fun live_start(r: *Report) bool {
    if (r.drawing)       { ret true; }
    if (!live_capable()) { ret false; }
    readout.live_init(?r.live);
    r.stop      = false;
    r.width     = live_width();
    r.out_tty   = terminal.is_terminal(1);
    r.shown_len = 0;
    val err_spawned: sync_thread.Operation = sync_thread.spawn_with(drawer_main, r::*u8, ?r.drawer);
    if (sel err_spawned.err) { ret false; }
    r.drawing = true;
    ret true;
}

# stop drawing the live line and erase it
fun live_stop(r: *Report) {
    if (!r.drawing) { ret; }
    mutex.lock(?r.lock);
    r.stop = true;
    condition.signal(?r.wake);
    mutex.unlock(?r.lock);
    val err_joined: sync_thread.Operation = sync_thread.join(?r.drawer);
    mutex.lock(?r.lock);
    live_erase(r);
    mutex.unlock(?r.lock);
    readout.live_close(?r.live);
    r.drawing = false;
}

# the readout level and quietness the command line asked for
# ---
# r:     the command's report
# level: LEVEL_RESULTS to LEVEL_ITEMS, as `-v` and `-vv` set it
# quiet: `--quiet`
pub fun report_level(r: *Report, level: u8, quiet: bool) {
    r.level = level;
    r.quiet = quiet;
}

# whether a command's result lines are written: human text without `--quiet`
pub fun results_shown(r: *Report) bool {
    ret r.format == FORMAT_HUMAN && !r.quiet;
}

# a stage of a command that is not a build closed: under -v its log line, `[t] label  time  detail`
# ---
# r:      the command's report
# label:  the stage, a word of at most LABEL_W bytes
# d:      the time it took
# detail: what it did, as `2 files`
pub fun log_stage(r: *Report, label: str, d: chrono_duration.Duration, detail: str) {
    if (r.format != FORMAT_HUMAN || r.level < readout.LEVEL_PHASES) { ret; }
    var dt: layout.Text;
    log_lead(r, false, label, layout.duration(?dt, d));
    if (detail != nil) { std_format.format(?r.w, "  {}", detail); }
    std_format.write_newline(?r.w);
}

# one item of a stage finished: under -vv its line, `[t]   label  time  name`
# ---
# r:     the command's report
# label: the stage it belongs to
# d:     the time it took
# name:  what it was
pub fun log_item(r: *Report, label: str, d: chrono_duration.Duration, name: str) {
    if (r.format != FORMAT_HUMAN || r.level < readout.LEVEL_ITEMS) { ret; }
    var dt: layout.Text;
    log_lead(r, true, label, layout.duration(?dt, d));
    if (name != nil) { std_format.format(?r.w, "  {}", name); }
    std_format.write_newline(?r.w);
}

# the live line shows the stage `label` running from now, on a terminal and without `--quiet`
# ---
# r:     the command's report
# label: the stage, which must outlive it
pub fun live_begin(r: *Report, label: str) {
    if (r.format != FORMAT_HUMAN || r.quiet || !live_start(r)) { ret; }
    readout.live_stage(?r.live, label, readout.sample());
}

# the running stage has done `done` of `total` and reached `name`, 0 of 0 for a stage that
# counts nothing
pub fun live_reached(r: *Report, done: u32, total: u32, name: str) {
    if (!r.drawing) { ret; }
    readout.live_reach(?r.live, done, total, name);
}

# nothing runs now, and the live line goes
pub fun live_end(r: *Report) {
    if (!r.drawing) { ret; }
    readout.live_close(?r.live);
    mutex.lock(?r.lock);
    live_erase(r);
    mutex.unlock(?r.lock);
}

# a blank line is owed after a block: written before whatever is written next on either stream,
# dropped when nothing is
fun owe_blank(r: *Report) {
    mutex.lock(?r.lock);
    r.owed = true;
    mutex.unlock(?r.lock);
}

# the drawer: every LIVE_PERIOD, the live line as the slot stands, until the report stops it
fun drawer_main(arg: *u8) {
    val r: *Report = arg::*Report;
    mutex.lock(?r.lock);
    for (!r.stop) {
        val res_now: time.InstantClock = time.instant();
        if (sel res_now.err) { brk; }
        val status: condition.WaitStatus = condition.wait_until(?r.wake, ?r.lock, time.instant_add(res_now.ok, LIVE_PERIOD));
        if (sel status.invalid || sel status.failed) { brk; }
        if (!r.stop)                                 { live_draw(r); }
    }
    mutex.unlock(?r.lock);
}

# draw the live line where the cursor stands at the start of a line, the report's lock held: the
# stage, its time so far, its count and what it reached last, in a log line's columns with the
# stamp left blank, cut to the terminal's width
fun live_draw(r: *Report) {
    if (interrupt.taken()) {
        live_erase(r);
        ret;
    }
    if (!r.err_bare || (r.out_tty && !r.out_bare)) { ret; }
    var v: readout.LiveView;
    if (!readout.live_view(?r.live, ?v)) {
        live_erase(r);
        ret;
    }
    var l:  Line;
    var lw: io_writer.Writer = line_writer(?l);
    layout.spaces(?lw, STAMP_W);
    left_w(?lw, v.label, LABEL_W);
    var dt: layout.Text;
    right_w(?lw, layout.duration(?dt, v.elapsed), TIME_W);
    if (v.total > 0) { std_format.format(?lw, "  {}/{}", v.done::u64, v.total::u64); }
    # a path drops its leading `./`, as a result line's does
    var from: usize = 0;
    if (v.name_len > 2 && v.name[0] == '.' && v.name[1] == '/') { from = 2; }
    if (v.name_len > from) {
        std_format.write_str(?lw, "  ");
        std_format.write_bytes(?lw, ?v.name[from], v.name_len - from);
    }
    var n: usize = l.len;
    if (n > r.width - 1)                                             { n = r.width - 1; }
    if (n == r.shown_len && bytes_same(?r.shown[0], ?l.bytes[0], n)) { ret; }
    var host: io_writer.Writer = stderr_writer();
    std_format.write_str(?host, "\r");
    std_format.write_bytes(?host, ?l.bytes[0], n);
    if (r.shown_len > n) { layout.spaces(?host, r.shown_len - n); }
    std_format.write_str(?host, "\r");
    var i: usize = 0;
    for (i < n) {
        r.shown[i] = l.bytes[i];
        i          = i + 1;
    }
    r.shown_len = n;
}

fun bytes_same(a: *u8, b: *u8, n: usize) bool {
    var i: usize = 0;
    for (i < n) {
        if (a[i] != b[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# erase the live line where one is drawn, the report's lock held
fun live_erase(r: *Report) {
    if (r.shown_len == 0) { ret; }
    var host: io_writer.Writer = stderr_writer();
    std_format.write_str(?host, "\r");
    layout.spaces(?host, r.shown_len);
    std_format.write_str(?host, "\r");
    r.shown_len = 0;
}

# make way for a write, the report's lock held: the live line erased, then a blank line owed
# written
fun make_way(r: *Report) {
    live_erase(r);
    if (!r.owed) { ret; }
    r.owed = false;
    var host: io_writer.Writer = stderr_writer();
    std_format.write_str(?host, "\n");
    r.err_bare = true;
}

# a line built in place, cut at LIVE_LINE bytes
rec Line {
    bytes: [LIVE_LINE]u8;
    len:   usize;
}

# a writer appending to l, which starts empty
fun line_writer(l: *Line) io_writer.Writer {
    l.len = 0;
    ret io_writer.Writer{ctx: l::ptr, fn_write: line_write};
}

fun line_write(ctx: ptr, buf: *u8, len: usize) res[usize, io_writer.WriteError] {
    val l: *Line = ctx::*Line;
    var i: usize = 0;
    for (i < len && l.len < LIVE_LINE) {
        l.bytes[l.len] = buf[i];
        l.len          = l.len + 1;
        i              = i + 1;
    }
    ret res[usize, io_writer.WriteError].ok{len};
}

# whether a result is a failure: anything but a pass or a skip
fun failure(r: *testrun.GateResult) bool {
    ret r.kind != testrun.RESULT_PASS && r.kind != testrun.RESULT_SKIP;
}

# the outcome a test record names: `pass`, `skip`, `exit`, `signal`, `spawn`,
# `timeout`, or `other`
fun result_name(r: *testrun.GateResult) *u8 {
    if (r.kind == testrun.RESULT_PASS)                                                                    { ret "pass"; }
    if (r.kind == testrun.RESULT_SKIP)                                                                    { ret "skip"; }
    if (r.kind == testrun.RESULT_SEMANTIC_MISMATCH && r.cause == testrun.CAUSE_ORACLE_EXIT)               { ret "exit"; }
    if (r.kind == testrun.RESULT_SEMANTIC_MISMATCH && r.cause == testrun.CAUSE_ORACLE_SIGNAL)             { ret "signal"; }
    if (r.kind == testrun.RESULT_INFRASTRUCTURE_FAILURE && r.cause == testrun.CAUSE_ORACLE_SPAWN_FAILURE) { ret "spawn"; }
    if (r.kind == testrun.RESULT_RESOURCE_EXHAUSTION && r.cause == testrun.CAUSE_ORACLE_TIMEOUT)          { ret "timeout"; }
    ret "other";
}

# whether a result kept output worth pointing at
pub fun has_capture(r: *testrun.GateResult) bool {
    if (r.kind == testrun.RESULT_SEMANTIC_MISMATCH)   { ret true; }
    if (r.kind == testrun.RESULT_RESOURCE_EXHAUSTION) { ret true; }
    ret r.kind == testrun.RESULT_INFRASTRUCTURE_FAILURE && r.cause != testrun.CAUSE_ORACLE_SPAWN_FAILURE;
}

# how a command reports to stderr: `--report human`, the default, or the records in one of
# their two encodings, `--report json` or `--report lines`
pub def Format: u8;

pub val FORMAT_HUMAN: Format = 0;
val     FORMAT_JSON:  Format = 1;
val     FORMAT_LINES: Format = 2;

# the format a `--report` value names
# ---
# name: the value
# ret:  the format, or none for a name outside `human`, `json` and `lines`
pub fun format_named(name: str) opt[Format] {
    if (str_equals(name, "human")) { ret opt[Format].some{FORMAT_HUMAN}; }
    if (str_equals(name, "json"))  { ret opt[Format].some{FORMAT_JSON}; }
    if (str_equals(name, "lines")) { ret opt[Format].some{FORMAT_LINES}; }
    ret opt[Format].none{};
}

# the encoding a records report writes
fun enc(r: *Report) record.Encoding {
    if (r.format == FORMAT_LINES) { ret record.LINES; }
    ret record.JSON;
}

# whether the report writes records rather than human text
pub fun is_records(r: *Report) bool {
    ret r.format != FORMAT_HUMAN;
}

# how a build-shaped command reports to stderr, and what it has reported. under
# json every line it writes is a record and `report_dnit` ends the run with the
# summary record, whose counts are the severities of the records before it
# ---
# format:   human text or json records
# w:        where the report is written, stderr
# root:     the project root as the command resolved it, nil until then; a json
#           record names a file inside it relative to it
# errors:   the error records written
# warnings: the warning records written
# made:     whether the arena record paths are built in, and the base they are
#           measured from, have been made; they are on first use
# built:    under json, each unit's `built` line, which the summary record carries
# out:      stdout as the command writes it, its first refused write kept as the
#           report's refusal
pub rec Report {
    format:   Format;
    w:        io_writer.Writer;
    root:     str;
    errors:   usize;
    warnings: usize;
    notes:    usize;
    made:     bool;
    backing:  A.Allocator;
    ar:       arena.Arena;
    a:        A.Allocator;
    pb:       PathBase;
    built:    Vector[Built];
    # the texts a failure's locations name, nil while the command holds none
    sources: *base_source.SourceMap;
    # the first refusal met while writing, which fails the report at its close
    refusal: opt[fail.Fail];
    out:     io_writer.Writer;
    # when the command began, which a log line's stamp and a run's time count from
    origin: readout.Instant;
    # the readout level `-v` and `-vv` set, and `--quiet`, which leaves out the result lines
    level: u8;
    quiet: bool;
    # the console both streams share with the live line: `lock` serialises their writes and the
    # drawer, `err_bare` and `out_bare` say the last byte written to stderr, and to stdout where
    # it is the terminal, ended a line, and `owed` that a blank line is owed before the next write
    lock:     mutex.Mutex;
    err_bare: bool;
    out_bare: bool;
    out_tty:  bool;
    owed:     bool;
    # the live line: the slot the engine writes, whether the drawer runs and is told to stop,
    # what wakes it, its thread, the terminal's width and the line on screen, none when shown_len is 0
    live:      readout.Live;
    drawing:   bool;
    stop:      bool;
    wake:      condition.Condition;
    drawer:    sync_thread.Thread;
    width:     usize;
    shown:     [LIVE_LINE]u8;
    shown_len: usize;
}

# a unit's `built` line as the summary record keeps it: the output, nil when it wrote none, its modules,
# its size when it is one file, and the unit's wall time
rec Built {
    out:      str;
    modules:  u32;
    rebuilt:  u32;
    bytes:    usize;
    has_size: bool;
    total:    chrono_duration.Duration;
}

# start a report in place; it holds its own arena, so it stays where it was made
# until `report_dnit`
# ---
# r:      the report
# format: the format the command writes
pub fun report_init(r: *Report, format: Format) {
    r.format    = format;
    r.w         = io_writer.Writer{ctx: r::ptr, fn_write: stderr_write};
    r.root      = nil;
    r.errors    = 0;
    r.warnings  = 0;
    r.notes     = 0;
    r.made      = false;
    r.built     = collections_vector.init[Built](nil);
    r.refusal   = opt[fail.Fail].none{};
    r.sources   = nil;
    r.out       = io_writer.Writer{ctx: r::ptr, fn_write: stdout_write};
    r.origin    = readout.sample();
    r.level     = readout.LEVEL_RESULTS;
    r.quiet     = false;
    r.lock      = mutex.make();
    r.err_bare  = true;
    r.out_bare  = true;
    r.out_tty   = false;
    r.owed      = false;
    r.drawing   = false;
    r.stop      = false;
    r.wake      = condition.make();
    r.width     = LIVE_COLUMNS;
    r.shown_len = 0;
    readout.live_init(?r.live);
}

# what a refused write to stdout is reported as
val STDOUT_OP: fail.Op = fail.Op{verb: "write", role: "standard output"};

# a command's write to stderr, which carries its diagnostics. a command an interrupt stopped
# reports that and nothing else: what its operations make of being stopped is not written
fun stderr_write(ctx: ptr, buf: *u8, len: usize) res[usize, io_writer.WriteError] {
    if (interrupt.taken()) { ret res[usize, io_writer.WriteError].ok{len}; }
    val r: *Report = ctx::*Report;
    mutex.lock(?r.lock);
    make_way(r);
    var host:        io_writer.Writer                 = stderr_writer();
    val res_written: res[usize, io_writer.WriteError] = io_writer.write(?host, buf, len);
    if (len > 0) { r.err_bare = buf[len - 1] == '\n'; }
    mutex.unlock(?r.lock);
    ret res_written;
}

# a command's write to stdout: a refusal is kept as the report's, which fails it at its close.
# nothing more is written once an interrupt stopped the command
fun stdout_write(ctx: ptr, buf: *u8, len: usize) res[usize, io_writer.WriteError] {
    if (interrupt.taken()) { ret res[usize, io_writer.WriteError].ok{len}; }
    val r: *Report = ctx::*Report;
    mutex.lock(?r.lock);
    make_way(r);
    var host:        io_writer.Writer                 = fs.writer(fs.STDOUT);
    val res_written: res[usize, io_writer.WriteError] = io_writer.write(?host, buf, len);
    if (len > 0) { r.out_bare = buf[len - 1] == '\n'; }
    mutex.unlock(?r.lock);
    if (sel res_written.err) {
        if (sel r.refusal.none && report_paths(r) != nil) { refused(r, fail.refusal(?r.a, diagnostic_kind.OUTPUT_WRITE, STDOUT_OP, fail.Cause.write{res_written.err})); }
    }
    ret res_written;
}

# where a command writes its output, stdout through the report, so a refused write fails the
# command as the system's
pub fun out(r: *Report) *io_writer.Writer {
    ret ?r.out;
}

# keeps the first refusal the report meets while writing
fun refused(r: *Report, f: fail.Fail) {
    val first: bool = sel r.refusal.none;
    if (first) { r.refusal = opt[fail.Fail].some{f}; }
}

# the base record paths are measured from, over the report's arena; nil, with the
# refusal kept, when the arena cannot be made, and a record then names each file
# as it was given
fun report_paths(r: *Report) *PathBase {
    if (r.made) { ret ?r.pb; }
    val err_made: err[A.Error] = page.make(?r.backing);
    if (sel err_made.err) {
        refused(r, fail.refused(err_made.err));
        ret nil;
    }
    val err_opened: err[A.Error] = arena.init(?r.ar, ?r.backing, 0);
    if (sel err_opened.err) {
        refused(r, fail.refused(err_opened.err));
        ret nil;
    }
    val err_armed: err[A.Error] = arena.allocator(?r.a, ?r.ar);
    if (sel err_armed.err) {
        arena.dnit(?r.ar);
        refused(r, fail.refused(err_armed.err));
        ret nil;
    }
    r.made = true;
    var root: str = r.root;
    if (root == nil) { root = "."; }
    r.pb = path_base(?r.a, root);
    ret ?r.pb;
}

# keep a unit's `built` line for the summary record; the output path, nil when the unit wrote
# none, is copied into the report's arena, and a line the arena refuses is kept as the report's
# refusal, which fails it at its close
fun report_built(r: *Report, ev: *readout.Summary) {
    if (report_paths(r) == nil) { ret; }
    if (r.built.a == nil)       { r.built = collections_vector.init[Built](?r.a); }
    var out: str = nil;
    if (ev.out != nil) {
        val res_out: res[str, A.Error] = str_dup(?r.a, ev.out);
        if (sel res_out.err) {
            refused(r, fail.refused(res_out.err));
            ret;
        }
        out = res_out.ok;
    }
    val res_kept: res[usize, A.Error] = collections_vector.push[Built](?r.built, Built{out: out, modules: ev.modules, rebuilt: ev.compiled, bytes: ev.bytes, has_size: ev.has_size, total: ev.total});
    if (sel res_kept.err) { refused(r, fail.refused(res_kept.err)); }
}

# a record the interrupt silenced was not written, so it is not counted
fun count_record(r: *Report, d: *diagnostic.Diagnostic) {
    if (interrupt.taken())               { ret; }
    if (diagnostic.is_error(d))          { r.errors = r.errors + 1; }
    or (diagnostic_kind.is_note(d.kind)) { r.notes = r.notes + 1; }
    or                                   { r.warnings = r.warnings + 1; }
}

# report a note of kind `k`, which points at nothing: `note text` in human text, or a
# diagnostic record of note severity under json
# ---
# r:    the command's report
# k:    the note's kind, a row of note level
# text: what the note says
pub fun report_note(r: *Report, k: diagnostic_kind.Kind, text: str) {
    if (r.format == FORMAT_HUMAN) {
        std_format.write_str(?r.w, "note ");
        std_format.write_str(?r.w, text);
        std_format.write_newline(?r.w);
        ret;
    }
    note_record(r, k, text);
}

# report what a command did as a result line in human text, and as the note record of kind
# `k` saying `text` under the records modes
# ---
# r:      the command's report
# k:      the note's kind, a row of note level
# v:      the verb of the result line
# texts:  what it acted on, then its details on the line, `n` of them
# n:      how many texts
# detail: a note after it, nil for none
# text:   the note record's message
pub fun report_said(r: *Report, k: diagnostic_kind.Kind, v: layout.Verb, texts: *str, n: usize, detail: str, text: str) {
    if (r.format == FORMAT_HUMAN) {
        if (!r.quiet)      { said_row(out(r), v, texts, n); }
        if (detail != nil) { report_note(r, k, detail); }
        ret;
    }
    note_record(r, k, text);
}

# a result line on w: its verb in the gutter, then `n` texts parted by GAP
pub fun said_row(w: *io_writer.Writer, v: layout.Verb, texts: *str, n: usize) {
    said_cells(w, v, texts, n);
    std_format.write_newline(w);
}

# the same result line left open, for a detail the caller ends it with
pub fun said_cells(w: *io_writer.Writer, v: layout.Verb, texts: *str, n: usize) {
    var cols: [8]layout.Column;
    var i:    usize = 0;
    for (i < n && i < 8) {
        cols[i] = layout.Column{width: 0, align: layout.LEFT, gap: layout.GAP};
        i       = i + 1;
    }
    cols[0].gap = 0;
    layout.said(w, v);
    layout.cells(w, ?cols[0], texts, n);
}

fun note_record(r: *Report, k: diagnostic_kind.Kind, text: str) {
    var d: diagnostic.Diagnostic;
    d.kind    = k;
    d.loc     = base_source.location_nil();
    d.message = text;
    render_record(r, r.sources, report_paths(r), ?d);
    count_record(r, ?d);
}

# report a carried failure as the diagnostic it reads as, in text or as a diagnostic record
# under json. a reported failure writes nothing, its diagnostics having been rendered already
# ---
# r:      the command's report
# f:      the failure
# origin: the phase it is reported under; ORIGIN_NONE for the command line itself
# ret:    the exit code `exit.of` maps the failure to
pub fun report_fail(r: *Report, f: fail.Fail, origin: diagnostic.Origin) i64 {
    var fv: fail.Fail = f;
    ret report_failure(r, ?fv, origin);
}

fun report_failure(r: *Report, f: *fail.Fail, origin: diagnostic.Origin) i64 {
    if (r.format == FORMAT_HUMAN) {
        if (!sel f.reported && !interrupt.taken()) { r.errors = r.errors + 1; }
        ret render_fail_w(?r.w, r.sources, f);
    }
    if (!sel f.reported) {
        var fx: annotation.Fix;
        var d:  diagnostic.Diagnostic = failure_view(f, origin, ?fx);
        render_record(r, r.sources, report_paths(r), ?d);
        count_record(r, ?d);
    }
    ret exit.of(@f);
}

# one test's result as a record under json; human text writes nothing here,
# the runner's own readout carrying it
# ---
# r: the command's report
# t: the finished test
fun report_test(r: *Report, t: *readout.TestResult) {
    if (r.format == FORMAT_HUMAN) { ret; }
    val art: *testrun.TestArtifact = t.art;
    var o:   record.Record;
    record.begin(?r.w, enc(r), ?o, "test");
    test_identity(r, ?o, art);
    record.text(?o, "outcome", result_name(?t.result));
    record.int(?o, "code", t.code::i64);
    record.int(?o, "timeout_ns", chrono_duration.duration_nsec(t.bound));
    record.int(?o, "duration_ns", chrono_duration.duration_nsec(t.elapsed));
    record.text(?o, "exe", art.exe);
    if (has_capture(?t.result)) { record.text_or_null(?o, "output", t.log); }
    or                          { record.null(?o, "output"); }
    val opt_origin: opt[str] = diagnostic.origin_name(diagnostic.ORIGIN_TEST);
    if (sel opt_origin.some) { record.text(?o, "origin", opt_origin.some); }
    record.end(?o);
}

# the members that name a test in its test and case records, its file relative to the project
fun test_identity(r: *Report, o: *record.Record, art: *testrun.TestArtifact) {
    val file: str = record_path(report_paths(r), art.file);
    record.text(o, "name", art.name);
    record.text(o, "module", art.module);
    record.text(o, "file", file);
    record.int(o, "line", art.line::i64);
    record.int(o, "index", art.idx::i64);
    record.text_or_null(o, "target", art.target);
    record.text_or_null(o, "profile", art.profile);
}

# one collected test as a record under json, as `mach test --list` lists it; human text
# writes nothing here
# ---
# r:   the command's report
# art: the test
pub fun report_case(r: *Report, art: *testrun.TestArtifact) {
    if (r.format == FORMAT_HUMAN) { ret; }
    var o: record.Record;
    record.begin(?r.w, enc(r), ?o, "case");
    test_identity(r, ?o, art);
    record.text(?o, "object", art.object);
    record.end(?o);
}

# a (target, profile) whose tests were built and not run, as a record under json; human text
# writes nothing here
# ---
# r:       the command's report
# target:  the declared target name
# profile: the profile name
# reason:  why its tests did not run
pub fun report_skip(r: *Report, target: str, profile: str, reason: str) {
    if (r.format == FORMAT_HUMAN) { ret; }
    var o: record.Record;
    record.begin(?r.w, enc(r), ?o, "skip");
    record.text(?o, "target", target);
    record.text(?o, "profile", profile);
    record.text(?o, "reason", reason);
    record.end(?o);
}

# end the run: a refusal kept while it ran, such as a refused write to stdout,
# reported, then under json the summary record, the last line the command
# writes; the report's arena is released either way. a command an interrupt
# stopped ends with the one line report_interrupted writes instead
# ---
# r:    the command's report
# code: the exit code the command returns
# ret:  the worse of code and the kept refusal's
pub fun report_dnit(r: *Report, code: i64) i64 {
    live_stop(r);
    if (interrupt.taken()) {
        report_interrupted(r, code);
        report_release(r);
        ret code;
    }
    var closing: i64 = code;
    if (r.made) {
        if (sel r.pb.refusal.some) { refused(r, r.pb.refusal.some); }
    }
    if (sel r.refusal.some) { closing = exit.worst(closing, report_fail(r, r.refusal.some, diagnostic.ORIGIN_NONE)); }
    if (r.format != FORMAT_HUMAN) {
        var o: record.Record;
        record.begin(?r.w, enc(r), ?o, "summary");
        record.int(?o, "errors", r.errors::i64);
        record.int(?o, "warnings", r.warnings::i64);
        record.int(?o, "notes", r.notes::i64);
        if (closing == exit.OK) { record.text(?o, "outcome", "success"); }
        or                      { record.text(?o, "outcome", "failure"); }
        record.int(?o, "exit_code", closing);
        if (r.built.len > 0) { summary_built(?o, r); }
        record.end(?o);
    }
    report_release(r);
    ret closing;
}

# the one line a command an interrupt stopped ends with, past the silence the interrupt set:
# `interrupted by <event>`, or under json the summary record with the outcome `interrupted`
fun report_interrupted(r: *Report, code: i64) {
    var w: io_writer.Writer = stderr_writer();
    if (r.format == FORMAT_HUMAN) {
        std_format.format(?w, "interrupted by {}\n", interrupt.name());
        ret;
    }
    var o: record.Record;
    record.begin(?w, enc(r), ?o, "summary");
    record.int(?o, "errors", r.errors::i64);
    record.int(?o, "warnings", r.warnings::i64);
    record.int(?o, "notes", r.notes::i64);
    record.text(?o, "outcome", "interrupted");
    record.text(?o, "event", interrupt.name());
    record.int(?o, "exit_code", code);
    record.end(?o);
}

# release the report's arena
fun report_release(r: *Report) {
    if (!r.made) { ret; }
    arena.dnit(?r.ar);
    r.made  = false;
    r.built = collections_vector.init[Built](nil);
}

# the summary record's `built` lines: `time_us`, every unit's wall time added,
# and `built`, one object per line with its `out`, `modules`, `bytes` when the
# line shows a size, and `time_us`
fun summary_built(o: *record.Record, r: *Report) {
    var total: chrono_duration.Duration = 0;
    var i:     usize                    = 0;
    for (i < r.built.len) {
        total = total + r.built.data[i].total;
        i     = i + 1;
    }
    record.int(o, "time_us", micros(total));
    var arr: record.List;
    record.list_begin(o, "built", ?arr);
    i = 0;
    for (i < r.built.len) {
        val b:  *Built = ?r.built.data[i];
        var bo: record.Record;
        record.list_record_begin(?arr, ?bo);
        if (b.out != nil) { record.text(?bo, "out", b.out); }
        record.int(?bo, "modules", b.modules::i64);
        record.int(?bo, "rebuilt", b.rebuilt::i64);
        if (b.has_size) { record.int(?bo, "bytes", b.bytes::i64); }
        record.int(?bo, "time_us", micros(b.total));
        record.nested_end(?bo);
        i = i + 1;
    }
    record.list_end(?arr);
}

# where record paths are measured from: the working directory a relative
# source path is spelled against, and the project root resolved against it
# a path the base could not measure is named as it was given, and the refusal is
# kept, which fails the report at its close
rec PathBase {
    a:       *A.Allocator;
    cwd:     str;
    root:    str;
    refusal: opt[fail.Fail];
}

fun path_base(a: *A.Allocator, root: str) PathBase {
    var pb: PathBase;
    pb.a       = a;
    pb.cwd     = nil;
    pb.root    = nil;
    pb.refusal = opt[fail.Fail].none{};
    val res_cwd: res[types_string.OwnedString, env.EnvError] = env.current_dir(a);
    if (sel res_cwd.err) { pb.refusal = opt[fail.Fail].some{fail.refusal(a, diagnostic_kind.FS_CURRENT_DIR, fail.Op{verb: "read", role: "the working directory"}, fail.Cause.env{res_cwd.err})}; }
    if (sel res_cwd.ok)  { pb.cwd = res_cwd.ok.data; }
    pb.root = absolute(?pb, root);
    ret pb;
}

# a path resolved against the working directory and cleaned; nil, with the
# refusal kept, when the allocator refuses
fun absolute(pb: *PathBase, p: str) str {
    var full: str = p;
    if (pb.cwd != nil) {
        val res_joined: res[types_path.Path, A.Error] = types_path.resolve(pb.a, pb.cwd, p);
        if (sel res_joined.err) {
            path_refused(pb, res_joined.err);
            ret nil;
        }
        full = res_joined.ok;
    }
    val res_cleaned: res[types_path.Path, A.Error] = types_path.clean(pb.a, full);
    if (sel res_cleaned.err) {
        path_refused(pb, res_cleaned.err);
        ret nil;
    }
    ret res_cleaned.ok;
}

fun path_refused(pb: *PathBase, e: A.Error) {
    val first: bool = sel pb.refusal.none;
    if (first) { pb.refusal = opt[fail.Fail].some{fail.refused(e)}; }
}

# the path a record names a source file by: relative to the project root for a
# file inside it, otherwise absolute; as given when there is no base, whose
# refusal the report keeps
fun record_path(pb: *PathBase, p: str) str {
    if (pb == nil) { ret p; }
    val full: str = absolute(pb, p);
    if (full == nil || pb.root == nil) { ret p; }
    val rl: usize = str_len(pb.root);
    if (rl == 0 || !str_starts_with(full, pb.root)) { ret full; }
    if (types_path.is_separator(pb.root[rl - 1]))   { ret (?full[rl])::str; }
    if (full[rl] == 0)                              { ret "."; }
    if (types_path.is_separator(full[rl]))          { ret (?full[rl + 1])::str; }
    ret full;
}

# a located span's members: `file`, 1-based `line` and `column` of its first
# byte, `end_line` and `end_column` of the position just past its last byte,
# columns counted in UTF-8 bytes, and the 0-based `byte_start` and exclusive
# `byte_end`
fun put_span(o: *record.Record, pb: *PathBase, f: *Frame) {
    val end_pos: base_source.Position = base_source.position(f.sf, f.end);
    record.text(o, "file", record_path(pb, f.sf.path));
    record.int(o, "line", f.line_s::i64);
    record.int(o, "column", f.col_s::i64);
    record.int(o, "end_line", end_pos.line::i64);
    record.int(o, "end_column", end_pos.col::i64);
    record.int(o, "byte_start", f.off::i64);
    record.int(o, "byte_end", f.end::i64);
}

# one diagnostic as one NDJSON record, members in the order the schema
# documents them
fun render_record(r: *Report, sources: *base_source.SourceMap, pb: *PathBase, d: *diagnostic.Diagnostic) {
    var o: record.Record;
    record.begin(?r.w, enc(r), ?o, "diagnostic");

    record.text(?o, "severity", severity_name(d.kind));
    record.text_or_null(?o, "code", diagnostic_kind.key_of(d.kind));
    record.text(?o, "message", d.message);
    val opt_origin: opt[str] = diagnostic.origin_name(d.origin);
    if (sel opt_origin.some) { record.text(?o, "origin", opt_origin.some); }

    put_primary(?o, sources, pb, d.loc);
    put_related(?o, sources, pb, ?d.related);

    # a related site mach cannot locate stands as a note, as the text shows it
    var notes: record.List;
    record.list_begin(?o, "notes", ?notes);
    var i: usize = 0;
    for (i < d.related.len) {
        val rel:    *annotation.Related = ?d.related.data[i];
        val opt_rf: opt[Frame]          = locate(sources, rel.loc);
        if (rel.label != nil && sel opt_rf.none) { record.list_text(?notes, rel.label); }
        i = i + 1;
    }
    i = 0;
    for (i < d.children.len) {
        if (d.children.data[i].kind != diagnostic.CHILD_HELP) { record.list_text(?notes, d.children.data[i].text); }
        i = i + 1;
    }
    record.list_end(?notes);

    var help: record.List;
    record.list_begin(?o, "help", ?help);
    i = 0;
    for (i < d.children.len) {
        if (d.children.data[i].kind == diagnostic.CHILD_HELP) { record.list_text(?help, d.children.data[i].text); }
        i = i + 1;
    }
    record.list_end(?help);

    put_fixes(?o, sources, pb, d.fixes.data, d.fixes.len);
    record.end(?o);
}

# a record's `primary`: the span `loc` names, null when it names none `sources` holds
fun put_primary(o: *record.Record, sources: *base_source.SourceMap, pb: *PathBase, loc: base_source.Location) {
    val opt_pf: opt[Frame] = locate(sources, loc);
    if (sel opt_pf.none) {
        record.null(o, "primary");
        ret;
    }
    var pf:   Frame = opt_pf.some;
    var prim: record.Record;
    record.nested_begin(o, "primary", ?prim);
    put_span(?prim, pb, ?pf);
    record.nested_end(?prim);
}

# a record's `related`: each related place `sources` holds, with its label
fun put_related(o: *record.Record, sources: *base_source.SourceMap, pb: *PathBase, also: *Vector[annotation.Related]) {
    var related: record.List;
    record.list_begin(o, "related", ?related);
    var i: usize = 0;
    for (i < also.len) {
        val rel:    *annotation.Related = ?also.data[i];
        val opt_rf: opt[Frame]          = locate(sources, rel.loc);
        if (sel opt_rf.some) {
            var rf: Frame = opt_rf.some;
            var ro: record.Record;
            record.list_record_begin(?related, ?ro);
            put_span(?ro, pb, ?rf);
            record.text_or_null(?ro, "label", rel.label);
            record.nested_end(?ro);
        }
        i = i + 1;
    }
    record.list_end(?related);
}

# a record's `fixes`: the `n` fixes at `fixes`, each edit `sources` locates
fun put_fixes(o: *record.Record, sources: *base_source.SourceMap, pb: *PathBase, fixes: *annotation.Fix, n: usize) {
    var array: record.List;
    record.list_begin(o, "fixes", ?array);
    var i: usize = 0;
    for (i < n) {
        val fx: *annotation.Fix = ?fixes[i];
        var fo: record.Record;
        record.list_record_begin(?array, ?fo);
        record.text(?fo, "label", fx.label);
        var edits: record.List;
        record.list_begin(?fo, "edits", ?edits);
        var e: usize = 0;
        for (e < fx.edits.len) {
            val ed:     *annotation.Edit = ?fx.edits.data[e];
            val opt_ef: opt[Frame]       = locate(sources, ed.loc);
            if (sel opt_ef.some) {
                var ef: Frame = opt_ef.some;
                var eo: record.Record;
                record.list_record_begin(?edits, ?eo);
                put_span(?eo, pb, ?ef);
                record.text(?eo, "replacement", ed.replacement);
                record.nested_end(?eo);
            }
            e = e + 1;
        }
        record.list_end(?edits);
        record.nested_end(?fo);
        i = i + 1;
    }
    record.list_end(?array);
}

fun render_store_records(r: *Report, sources: *base_source.SourceMap, list: *diagnostic.DiagnosticStore, pb: *PathBase) {
    var i: usize = 0;
    for (i < diagnostic.len(list)) {
        val d: *diagnostic.Diagnostic = ?list.items.data[i];
        render_record(r, sources, pb, d);
        count_record(r, d);
        i = i + 1;
    }
}
