val MAX_SPAN_LINES: usize = 10;

val EXCERPT_WIDTH: usize = 120;
val EXCERPT_LEAD:  usize = 40;
val EXCERPT_MARK:  str   = "...";

rec Excerpt {
    start:     usize;
    end:       usize;
    cut_left:  bool;
    cut_right: bool;
}

rec MarkRange {
    from: usize;
    to:   usize;
}

fun mark_range(b: lang_source.LineSpan, off: usize, end: usize) MarkRange {
    var r: MarkRange;
    r.from = b.start;
    if (off > b.start && off <= b.end) { r.from = off; }
    r.to = b.end;
    if (end >= b.start && end <= b.end) { r.to = end; }
    if (r.to < r.from)                  { r.to = r.from; }
    ret r;
}

fun excerpt_of(b: lang_source.LineSpan, m: MarkRange) Excerpt {
    var x: Excerpt;
    x.start     = b.start;
    x.end       = b.end;
    x.cut_left  = false;
    x.cut_right = false;
    if (b.end - b.start <= EXCERPT_WIDTH) { ret x; }
    var ws: usize = b.start;
    if (m.from > b.start + EXCERPT_LEAD) { ws = m.from - EXCERPT_LEAD; }
    var we: usize = ws + EXCERPT_WIDTH;
    if (we > b.end) {
        we = b.end;
        if (we - b.start > EXCERPT_WIDTH) { ws = we - EXCERPT_WIDTH; }
        or                                { ws = b.start; }
    }
    x.start     = ws;
    x.end       = we;
    x.cut_left  = ws > b.start;
    x.cut_right = we < b.end;
    ret x;
}

# render every diagnostic of a store to a writer, then an "N errors / M warnings" line
# ---
# out:  the destination
# s:    the session whose SourceMap locates each diagnostic
# list: the diagnostics, rendered in order; nothing is written when it is empty
pub fun flush(out: *io_writer.Writer, s: *session.Session, list: *diagnostic.DiagnosticStore) {
    flush_sources(out, ?s.sources, list);
}

# render every diagnostic of a store to a writer, then an "N errors / M warnings" line
# ---
# out:     the destination
# sources: the SourceMap that locates each diagnostic
# list:    the diagnostics, rendered in order; nothing is written when it is empty
pub fun flush_sources(out: *io_writer.Writer, sources: *lang_source.SourceMap, list: *diagnostic.DiagnosticStore) {
    var tally: Tally;
    render_store(out, sources, list, ?tally);
    if (tally.rendered > 0) {
        std_format.write_str(out, "\n");
        emit_summary(out, tally.errors, tally.warnings);
    }
}

# what one summary line stands for: every error and warning rendered above it,
# whichever store or failure record it came from
rec Tally {
    errors:   usize;
    warnings: usize;
    rendered: usize;
}

fun render_store(out: *io_writer.Writer, sources: *lang_source.SourceMap, list: *diagnostic.DiagnosticStore, tally: *Tally) {
    val total: usize = diagnostic.len(list);
    var i:     usize = 0;
    for (i < total) {
        val d: *diagnostic.Diagnostic = ?list.items.data[i];

        if (i > 0) { std_format.write_str(out, "\n"); }
        render(out, sources, d);

        if (d.severity == diagnostic.SEVERITY_ERROR)   { tally.errors = tally.errors + 1; }
        or (d.severity == diagnostic.SEVERITY_WARNING) { tally.warnings = tally.warnings + 1; }

        i = i + 1;
    }
    tally.rendered = tally.rendered + total;
}

rec Frame {
    sf:     *lang_source.SourceFile;
    off:    usize;
    end:    usize;
    line_s: usize;
    line_e: usize;
    col_s:  usize;
}

fun locate(sources: *lang_source.SourceMap, loc: diagnostic.Location) opt[Frame] {
    val opt_file: opt[*lang_source.SourceFile] = lang_source.get(sources, loc.file_id);
    if (sel opt_file.none) { ret opt[Frame].none{}; }
    val sf: *lang_source.SourceFile = opt_file.some;

    val text_len: usize = str_len(sf.text);

    var off: usize = loc.span.offset;
    if (off > text_len) { off = text_len; }
    var end: usize = loc.span.offset + loc.span.len;
    if (end > text_len) { end = text_len; }
    if (end < off)      { end = off; }

    val start_pos: lang_source.Position = lang_source.position(sf, off);
    var last:      usize                = off;
    if (end > off) { last = end - 1; }
    val end_pos: lang_source.Position = lang_source.position(sf, last);

    var f: Frame;
    f.sf     = sf;
    f.off    = off;
    f.end    = end;
    f.line_s = start_pos.line;
    f.line_e = end_pos.line;
    f.col_s  = start_pos.col;
    ret opt[Frame].some{f};
}

fun render(out: *io_writer.Writer, sources: *lang_source.SourceMap, d: *diagnostic.Diagnostic) {
    emit_headline(out, d.severity, d.kind, d.message);

    val opt_pf: opt[Frame] = locate(sources, d.loc);
    val w:      usize      = gutter_width(sources, d, opt_pf);

    var framed: bool = false;
    if (sel opt_pf.some) {
        var pf: Frame = opt_pf.some;
        emit_frame(out, ?pf, w, "^", nil);
        framed = true;
    }

    var i: usize = 0;
    for (i < d.related.len) {
        val rel:    *diagnostic.Related = ?d.related.data[i];
        val opt_rf: opt[Frame]          = locate(sources, rel.loc);
        if (sel opt_rf.some) {
            if (framed) { emit_bar(out, w); }
            var rf: Frame = opt_rf.some;
            emit_frame(out, ?rf, w, "-", rel.label);
            framed = true;
        }
        i = i + 1;
    }

    emit_trailer(out, sources, d, framed, w);
}

fun gutter_width(sources: *lang_source.SourceMap, d: *diagnostic.Diagnostic, opt_pf: opt[Frame]) usize {
    var w: usize = 1;
    if (sel opt_pf.some) { w = decimal_width(opt_pf.some.line_e); }

    var i: usize = 0;
    for (i < d.related.len) {
        val opt_rf: opt[Frame] = locate(sources, d.related.data[i].loc);
        if (sel opt_rf.some) {
            val rw: usize = decimal_width(opt_rf.some.line_e);
            if (rw > w) { w = rw; }
        }
        i = i + 1;
    }
    ret w;
}

fun emit_frame(out: *io_writer.Writer, f: *Frame, w: usize, head: str, label: str) {
    emit_loc(out, w, f.sf.path, f.line_s, f.col_s);
    emit_bar(out, w);
    emit_snippet(out, f.sf, w, f.line_s, f.line_e, f.off, f.end, head, label);
}

fun emit_trailer(out: *io_writer.Writer, sources: *lang_source.SourceMap, d: *diagnostic.Diagnostic, framed: bool, w: usize) {
    if (!has_trailer(sources, d)) { ret; }

    var indent: usize = 2;
    if (framed) {
        emit_bar(out, w);
        indent = w + 1;
    }

    var i: usize = 0;
    for (i < d.related.len) {
        val rel:      *diagnostic.Related = ?d.related.data[i];
        val locate_r: opt[Frame]          = locate(sources, rel.loc);
        if (rel.label != nil && sel locate_r.none) {
            emit_tagged(out, "note", rel.label, indent);
        }
        i = i + 1;
    }

    var c: usize = 0;
    for (c < d.children.len) {
        val child: *diagnostic.Child = ?d.children.data[c];
        if (child.kind == diagnostic.CHILD_HELP) { emit_tagged(out, "help", child.text, indent); }
        or                                       { emit_tagged(out, "note", child.text, indent); }
        c = c + 1;
    }

    var f: usize = 0;
    for (f < d.fixes.len) {
        emit_fix(out, sources, w, ?d.fixes.data[f], indent);
        f = f + 1;
    }
}

fun emit_fix(out: *io_writer.Writer, sources: *lang_source.SourceMap, w: usize, fx: *diagnostic.Fix, indent: usize) {
    emit_tagged(out, "fix", fx.label, indent);
    var e: usize = 0;
    for (e < fx.edits.len) {
        val ed:     *diagnostic.Edit = ?fx.edits.data[e];
        val opt_ef: opt[Frame]       = locate(sources, ed.loc);
        if (sel opt_ef.some) {
            var ef: Frame = opt_ef.some;
            emit_loc(out, w, ef.sf.path, ef.line_s, ef.col_s);
        }
        emit_spaces(out, indent + 2);
        std_format.write_str(out, "-> replace with `");
        std_format.write_str(out, ed.replacement);
        std_format.write_str(out, "`\n");
        e = e + 1;
    }
}

fun has_trailer(sources: *lang_source.SourceMap, d: *diagnostic.Diagnostic) bool {
    if (d.children.len > 0 || d.fixes.len > 0) { ret true; }

    var i: usize = 0;
    for (i < d.related.len) {
        val locate_r: opt[Frame] = locate(sources, d.related.data[i].loc);
        if (d.related.data[i].label != nil && sel locate_r.none) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun emit_snippet(out: *io_writer.Writer, sf: *lang_source.SourceFile, w: usize, line_s: usize, line_e: usize, off: usize, end: usize, head: str, label: str) {
    if (line_e <= line_s) {
        emit_source_line(out, sf, w, line_s, off, end);
        emit_underline(out, sf, w, line_s, off, end, head, label);
        ret;
    }

    if (line_e - line_s + 1 <= MAX_SPAN_LINES) {
        var l: usize = line_s;
        for (l <= line_e) {
            emit_source_line(out, sf, w, l, off, end);
            if (l == line_s) { emit_underline(out, sf, w, l, off, end, head, nil); }
            or (l == line_e) { emit_underline(out, sf, w, l, off, end, "-", label); }
            or               { emit_underline(out, sf, w, l, off, end, "-", nil); }
            l = l + 1;
        }
        ret;
    }

    emit_source_line(out, sf, w, line_s, off, end);
    emit_underline(out, sf, w, line_s, off, end, head, nil);
    emit_elision(out, w);
    emit_source_line(out, sf, w, line_e, off, end);
    emit_underline(out, sf, w, line_e, off, end, "-", label);
}

fun emit_source_line(out: *io_writer.Writer, sf: *lang_source.SourceFile, w: usize, line: usize, off: usize, end: usize) {
    val opt_bounds: opt[lang_source.LineSpan] = lang_source.line_bounds(sf, line);
    if (sel opt_bounds.none) { ret; }
    val b: lang_source.LineSpan = opt_bounds.some;
    val x: Excerpt              = excerpt_of(b, mark_range(b, off, end));

    emit_gutter_num(out, w, line);
    if (x.cut_left) { std_format.write_str(out, EXCERPT_MARK); }
    if (x.end > x.start) {
        std_format.write_bytes(out, ?sf.text[x.start], x.end - x.start);
    }
    if (x.cut_right) { std_format.write_str(out, EXCERPT_MARK); }
    std_format.write_str(out, "\n");
}

fun emit_underline(out: *io_writer.Writer, sf: *lang_source.SourceFile, w: usize, line: usize, off: usize, end: usize, glyph: str, label: str) {
    val opt_bounds: opt[lang_source.LineSpan] = lang_source.line_bounds(sf, line);
    if (sel opt_bounds.none) { ret; }
    val b:         lang_source.LineSpan = opt_bounds.some;
    val m:         MarkRange            = mark_range(b, off, end);
    val x:         Excerpt              = excerpt_of(b, m);
    val mark_from: usize                = m.from;
    var mark_to:   usize                = m.to;
    if (mark_to > x.end) { mark_to = x.end; }

    emit_gutter_bar(out, w);

    if (x.cut_left) { emit_spaces(out, str_len(EXCERPT_MARK)); }
    var i: usize = x.start;
    for (i < mark_from) {
        if (sf.text[i] == '\t') { std_format.write_str(out, "\t"); }
        or                      { std_format.write_str(out, " "); }
        i = i + 1;
    }

    var n: usize = mark_to - mark_from;
    if (n == 0) { n = 1; }
    var j: usize = 0;
    for (j < n) {
        std_format.write_str(out, glyph);
        j = j + 1;
    }
    if (label != nil) {
        std_format.write_str(out, " ");
        std_format.write_str(out, label);
    }
    std_format.write_str(out, "\n");
}

fun emit_loc(out: *io_writer.Writer, w: usize, path: str, line: usize, col: usize) {
    emit_spaces(out, w);
    std_format.write_str(out, "--> ");
    std_format.write_str(out, path);
    std_format.write_str(out, ":");
    std_format.write_u64(out, line::u64);
    std_format.write_str(out, ":");
    std_format.write_u64(out, col::u64);
    std_format.write_str(out, "\n");
}

fun emit_bar(out: *io_writer.Writer, w: usize) {
    emit_spaces(out, w);
    std_format.write_str(out, " |\n");
}

fun emit_elision(out: *io_writer.Writer, w: usize) {
    emit_spaces(out, w);
    std_format.write_str(out, " | ...\n");
}

fun emit_gutter_num(out: *io_writer.Writer, w: usize, line: usize) {
    emit_spaces(out, w - decimal_width(line));
    std_format.write_u64(out, line::u64);
    std_format.write_str(out, " | ");
}

fun emit_gutter_bar(out: *io_writer.Writer, w: usize) {
    emit_spaces(out, w);
    std_format.write_str(out, " | ");
}

fun emit_tagged(out: *io_writer.Writer, tag: str, text: str, indent: usize) {
    emit_spaces(out, indent);
    std_format.write_str(out, "= ");
    std_format.write_str(out, tag);
    std_format.write_str(out, ": ");
    std_format.write_str(out, text);
    std_format.write_newline(out);
}

fun emit_summary(out: *io_writer.Writer, errors: usize, warnings: usize) {
    std_format.write_u64(out, errors::u64);
    if (errors == 1) { std_format.write_str(out, " error"); }
    or               { std_format.write_str(out, " errors"); }
    std_format.write_str(out, " / ");
    std_format.write_u64(out, warnings::u64);
    if (warnings == 1) { std_format.write_str(out, " warning"); }
    or                 { std_format.write_str(out, " warnings"); }
    std_format.write_str(out, "\n");
}

# the severity, then the kind's key where the diagnostic names one: `warning[vector.scalarize]: `
fun emit_lead(out: *io_writer.Writer, severity: diagnostic.Severity, k: diagnostic_kind.Kind) {
    val label: opt[str] = severity_label(severity);
    if (sel label.none) {
        std_format.format(out, "error[{}]: unknown Severity tag {}: ", diagnostic_kind.key_of(diagnostic_kind.COMPILER_INTERNAL), severity);
        ret;
    }
    std_format.write_str(out, label.some);
    val key: str = diagnostic_kind.key_of(k);
    if (key != nil) {
        std_format.write_str(out, "[");
        std_format.write_str(out, key);
        std_format.write_str(out, "]");
    }
    std_format.write_str(out, ": ");
}

fun emit_headline(out: *io_writer.Writer, severity: diagnostic.Severity, k: diagnostic_kind.Kind, message: str) {
    emit_lead(out, severity, k);
    std_format.write_str(out, message);
    std_format.write_newline(out);
}

# write the lead of an error of kind `k` to stderr, `error[<key>]: `, for a
# command that prints the rest of the message itself
pub fun headline_lead(k: diagnostic_kind.Kind) {
    var w: io_writer.Writer = stderr_writer();
    emit_lead(?w, diagnostic.SEVERITY_ERROR, k);
}

fun emit_spaces(out: *io_writer.Writer, n: usize) {
    var i: usize = 0;
    for (i < n) {
        std_format.write_str(out, " ");
        i = i + 1;
    }
}

fun decimal_width(n: usize) usize {
    var w: usize = 1;
    var v: usize = n;
    for (v >= 10) {
        w = w + 1;
        v = v / 10;
    }
    ret w;
}

# the headline lead of a severity; absent for a tag outside the catalog
fun severity_label(severity: diagnostic.Severity) opt[str] {
    if (severity == diagnostic.SEVERITY_ERROR)   { ret opt[str].some{"error"}; }
    if (severity == diagnostic.SEVERITY_WARNING) { ret opt[str].some{"warning"}; }
    if (severity == diagnostic.SEVERITY_INFO)    { ret opt[str].some{"info"}; }
    if (severity == diagnostic.SEVERITY_HELP)    { ret opt[str].some{"help"}; }
    ret opt[str].none{};
}

#[testing]
pub rec MemSink {
    buf: *u8;
    cap: usize;
    len: usize;
}

#[testing]
fun mem_sink_write(ctx: ptr, buf: *u8, len: usize) res[usize, io_writer.WriteError] {
    val s: *MemSink = ctx::*MemSink;
    var i: usize    = 0;
    for (i < len && s.len < s.cap) {
        s.buf[s.len] = buf[i];
        s.len        = s.len + 1;
        i            = i + 1;
    }
    ret res[usize, io_writer.WriteError].ok{i};
}

#[testing]
pub fun mem_writer(w: *io_writer.Writer, s: *MemSink, buf: *u8, cap: usize) {
    s.buf     = buf;
    s.cap     = cap;
    s.len     = 0;
    w.ctx     = s::ptr;
    w.f_write = mem_sink_write;
}

#[testing]
fun sink_match_at(s: *MemSink, i: usize, want: str, wl: usize) bool {
    var j: usize = 0;
    for (j < wl && s.buf[i + j] == want[j]) { j = j + 1; }
    if (j == wl) { ret true; }
    ret false;
}

#[testing]
fun sink_contains(s: *MemSink, want: str) bool {
    val wl: usize = str_len(want);
    if (wl == 0)    { ret true; }
    if (wl > s.len) { ret false; }
    var i: usize = 0;
    for (i + wl <= s.len) {
        if (sink_match_at(s, i, want, wl)) { ret true; }
        i = i + 1;
    }
    ret false;
}

#[testing]
fun sink_count(s: *MemSink, want: str) usize {
    val wl: usize = str_len(want);
    if (wl == 0 || wl > s.len) { ret 0; }
    var count: usize = 0;
    var i:     usize = 0;
    for (i + wl <= s.len) {
        if (sink_match_at(s, i, want, wl)) {
            count = count + 1;
            i     = i + wl;
        }
        or { i = i + 1; }
    }
    ret count;
}

#[testing]
fun line_span(sf: *lang_source.SourceFile, line: usize) token.Span {
    var sp: token.Span;
    sp.offset = 0;
    sp.len    = 0;
    val found: opt[lang_source.LineSpan] = lang_source.line_bounds(sf, line);
    if (sel found.none) { ret sp; }
    val b: lang_source.LineSpan = found.some;
    sp.offset = b.start;
    sp.len    = b.end - b.start;
    ret sp;
}

test render__long_line_is_windowed_around_the_span {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_s: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel res_s.err) { ret 1; }
    var s: session.Session = res_s.ok;

    var text: [402]u8;
    var i:    usize = 0;
    for (i < 400) {
        text[i] = 'a' + ((i / 10) % 26)::u8;
        i       = i + 1;
    }
    text[400] = '\n';
    text[401] = 0;
    val res_fid: res[lang_source.FileId, fail.Fail] = session.load_source(?s, "t.mach", (?text[0])::str);
    if (sel res_fid.err) {
        session.dnit(?s);
        ret 1;
    }
    val fid: lang_source.FileId = res_fid.ok;

    var list: diagnostic.DiagnosticStore = diagnostic.store_init(?alloc);
    var sp:   token.Span;
    sp.offset = 200;
    sp.len    = 4;
    diagnostic.error(?list, diagnostic_kind.SECRET_NOT_OBLIVIOUS, fid, sp, "here");

    var buf:  [2048]u8;
    var sink: MemSink;
    var w:    io_writer.Writer;
    mem_writer(?w, ?sink, ?buf[0], 2048);
    flush(?w, ?s, ?list);

    var code: i32 = 0;
    if (!sink_contains(?sink, "--> t.mach:1:201")) { code = 1; }
    if (!sink_contains(?sink, " | ...qqqqqqqqqq")) { code = 2; }
    if (!sink_contains(?sink, "...\n"))            { code = 3; }
    if (sink_contains(?sink, "| aaaaaaaaaa"))      { code = 4; }
    if (!sink_contains(?sink, "^^^^\n"))           { code = 5; }
    if (sink_count(?sink, "...") != 2)             { code = 6; }

    diagnostic.store_dnit(?list);
    session.dnit(?s);
    ret code;
}

test render__separator_bar_and_unified_gutter {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_s: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel res_s.err) { ret 1; }
    var s: session.Session = res_s.ok;

    val res_fid: res[lang_source.FileId, fail.Fail] = session.load_source(?s, "t.mach",
        "line 01\nline 02\nline 03\nline 04\nline 05\nline 06\nline 07\nline 08\nline 09\nline 10\nline 11\nline 12\n");
    if (sel res_fid.err) {
        session.dnit(?s);
        ret 1;
    }
    val fid: lang_source.FileId = res_fid.ok;

    val opt_sf: opt[*lang_source.SourceFile] = lang_source.get(?s.sources, fid);
    if (sel opt_sf.none) {
        session.dnit(?s);
        ret 1;
    }
    val sf: *lang_source.SourceFile = opt_sf.some;

    var list: diagnostic.DiagnosticStore = diagnostic.store_init(?alloc);
    diagnostic.error(?list, diagnostic_kind.SECRET_NOT_OBLIVIOUS, fid, line_span(sf, 9), "primary here");
    val last_id_r: opt[diagnostic.DiagnosticId] = diagnostic.last_id(?list);
    if (sel last_id_r.none) { ret 99; }
    val last_a: diagnostic.DiagnosticId = last_id_r.some;
    diagnostic.attach_related_committed(?list, last_a, fid, line_span(sf, 12), "secondary here");

    var buf:  [1024]u8;
    var sink: MemSink;
    var w:    io_writer.Writer;
    mem_writer(?w, ?sink, ?buf[0], 1024);
    flush(?w, ?s, ?list);

    var code: i32 = 0;
    if (sink_count(?sink, "--> ") != 2)                  { code = 1; }
    if (!sink_contains(?sink, " 9 | line 09"))           { code = 1; }
    if (!sink_contains(?sink, "12 | line 12"))           { code = 1; }
    if (!sink_contains(?sink, "   |\n  --> t.mach:12:")) { code = 1; }

    diagnostic.store_dnit(?list);
    session.dnit(?s);
    ret code;
}

test render__an_unresolvable_location_degrades {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_s: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel res_s.err) { ret 1; }
    var s: session.Session = res_s.ok;

    val res_fid: res[lang_source.FileId, fail.Fail] = session.load_source(?s, "t.mach", "alpha\nbeta\ngamma\n");
    if (sel res_fid.err) {
        session.dnit(?s);
        ret 1;
    }
    val fid: lang_source.FileId = res_fid.ok;

    val opt_sf: opt[*lang_source.SourceFile] = lang_source.get(?s.sources, fid);
    if (sel opt_sf.none) {
        session.dnit(?s);
        ret 1;
    }
    val sf: *lang_source.SourceFile = opt_sf.some;

    val bad_fid: lang_source.FileId         = 4242;
    var list:    diagnostic.DiagnosticStore = diagnostic.store_init(?alloc);
    diagnostic.error(?list, diagnostic_kind.SECRET_NOT_OBLIVIOUS, fid, line_span(sf, 2), "primary msg");
    val last_id_r: opt[diagnostic.DiagnosticId] = diagnostic.last_id(?list);
    if (sel last_id_r.none) { ret 99; }
    val last_b: diagnostic.DiagnosticId = last_id_r.some;
    diagnostic.attach_related_committed(?list, last_b, bad_fid, line_span(sf, 2), "defined here");

    var buf:  [512]u8;
    var sink: MemSink;
    var w:    io_writer.Writer;
    mem_writer(?w, ?sink, ?buf[0], 512);
    flush(?w, ?s, ?list);

    var code: i32 = 0;
    if (sink_count(?sink, "--> ") != 1)                { code = 1; }
    if (!sink_contains(?sink, "= note: defined here")) { code = 1; }
    diagnostic.store_dnit(?list);

    # an unresolvable primary still renders its headline and the related frame
    var list2: diagnostic.DiagnosticStore = diagnostic.store_init(?alloc);
    diagnostic.error(?list2, diagnostic_kind.SECRET_NOT_OBLIVIOUS, bad_fid, line_span(sf, 2), "primary msg");
    val last_id_r2: opt[diagnostic.DiagnosticId] = diagnostic.last_id(?list2);
    if (sel last_id_r2.none) { ret 99; }
    diagnostic.attach_related_committed(?list2, last_id_r2.some, fid, line_span(sf, 3), "look here");
    var buf2:  [512]u8;
    var sink2: MemSink;
    var w2:    io_writer.Writer;
    mem_writer(?w2, ?sink2, ?buf2[0], 512);
    flush(?w2, ?s, ?list2);
    if (!sink_contains(?sink2, "error[secret.not_oblivious]: primary msg")) { code = 2; }
    if (sink_count(?sink2, "--> ") != 1)                                    { code = 2; }
    if (!sink_contains(?sink2, "--> t.mach:3:"))                            { code = 2; }
    if (!sink_contains(?sink2, "gamma"))                                    { code = 2; }
    if (!sink_contains(?sink2, "look here"))                                { code = 2; }
    diagnostic.store_dnit(?list2);
    session.dnit(?s);
    ret code;
}

test render__help_and_a_multi_edit_fix_render_a_location_per_edit {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_s: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel res_s.err) { ret 1; }
    var s: session.Session = res_s.ok;

    val res_fid: res[lang_source.FileId, fail.Fail] = session.load_source(?s, "t.mach", "alpha\nbeta\ngamma\n");
    if (sel res_fid.err) {
        session.dnit(?s);
        ret 1;
    }
    val fid: lang_source.FileId = res_fid.ok;

    val opt_sf: opt[*lang_source.SourceFile] = lang_source.get(?s.sources, fid);
    if (sel opt_sf.none) {
        session.dnit(?s);
        ret 1;
    }
    val sf: *lang_source.SourceFile = opt_sf.some;

    var list: diagnostic.DiagnosticStore = diagnostic.store_init(?alloc);
    val head: token.Span                 = line_span(sf, 1);
    val tail: token.Span                 = line_span(sf, 3);

    val b_r: res[diagnostic.DiagnosticBuilder, fail.Fail] = diagnostic.builder_init(?alloc, diagnostic_kind.SECRET_NOT_OBLIVIOUS, fid, line_span(sf, 2), "cast the value to `i64`");
    if (sel b_r.err) {
        session.dnit(?s);
        diagnostic.store_dnit(?list);
        ret 1;
    }
    var b: diagnostic.DiagnosticBuilder = b_r.ok;
    diagnostic.attach_help(?b, "the operands differ in width");
    val fix_r: res[diagnostic.FixId, fail.Fail] = diagnostic.attach_fix(?b, "cast the value to `i64`", fid, head, "(");
    if (sel fix_r.err) {
        diagnostic.builder_dnit(?b);
        session.dnit(?s);
        diagnostic.store_dnit(?list);
        ret 1;
    }
    val fix:               diagnostic.FixId = fix_r.ok;
    val attach_fix_edit_r: err[fail.Fail]   = diagnostic.attach_fix_edit(?b, fix, fid, tail, ")::i64");
    if (sel attach_fix_edit_r.err) {
        diagnostic.builder_dnit(?b);
        session.dnit(?s);
        diagnostic.store_dnit(?list);
        ret 1;
    }
    val commit_r: res[opt[diagnostic.DiagnosticId], fail.Fail] = diagnostic.commit(?b, ?list);
    if (sel commit_r.err) {
        diagnostic.builder_dnit(?b);
        session.dnit(?s);
        diagnostic.store_dnit(?list);
        ret 1;
    }

    var buf:  [512]u8;
    var sink: MemSink;
    var w:    io_writer.Writer;
    mem_writer(?w, ?sink, ?buf[0], 512);
    flush(?w, ?s, ?list);

    var code: i32 = 0;
    if (!sink_contains(?sink, "= help: the operands differ in width")) { code = 1; }
    if (!sink_contains(?sink, "= fix: cast the value to `i64`"))       { code = 1; }
    if (!sink_contains(?sink, "-> replace with `(`"))                  { code = 1; }
    if (!sink_contains(?sink, "-> replace with `)::i64`"))             { code = 1; }
    if (!sink_contains(?sink, "--> t.mach:1:"))                        { code = 1; }
    if (!sink_contains(?sink, "--> t.mach:3:"))                        { code = 1; }

    diagnostic.store_dnit(?list);
    session.dnit(?s);
    ret code;
}

fun stderr_writer() io_writer.Writer {
    ret fs.writer(fs.STDERR);
}

fun render_fail_w(w: *io_writer.Writer, f: *outcome.Fail) i64 {
    if (sel f.reported) { ret exit.of(@f); }
    emit_headline(w, diagnostic.SEVERITY_ERROR, outcome.kind_of(@f), outcome.describe(@f));
    val at: opt[outcome.Place] = outcome.place_of(@f);
    if (sel at.some) { emit_loc(w, 1, at.some.path, at.some.line, at.some.col); }
    val also: outcome.Related = outcome.related_of(@f);
    var i:    usize           = 0;
    for (i < also.count) {
        val rel: *outcome.Place = ?also.items[i];
        if (rel.path != nil) { emit_loc(w, 1, rel.path, rel.line, rel.col); }
        i = i + 1;
    }
    ret exit.of(@f);
}

# print a Fail to stderr as "error[<key>]: <message>", followed by the
# " --> <file>:<line>:<column>" it points at when it names one and one such
# line for each related place it names, and map it to an exit code
# a reported Fail prints nothing, its diagnostics having been rendered already
# ---
# f:   the Fail
# ret: the exit code `exit.of` maps the failure to
pub fun render_fail(f: *outcome.Fail) i64 {
    var w: io_writer.Writer = stderr_writer();
    ret render_fail_w(?w, f);
}

# render_fail for a failure built in place
# ---
# f:   the Fail
# ret: the exit code `exit.of` maps the failure to
pub fun refuse(f: outcome.Fail) i64 {
    ret render_fail(?f);
}

# map a build outcome's severity to the process exit code
# ---
# bo:  the outcome
# ret: the shared exit code of the severity; a severity outside the catalog
# is an internal failure written to `w` naming the catalog and the tag
fun outcome_code_w(w: *io_writer.Writer, bo: *outcome.BuildOutcome) i64 {
    if (bo.severity == outcome.BUILD_OK)          { ret exit.OK; }
    if (bo.severity == outcome.BUILD_USER)        { ret exit.USER; }
    if (bo.severity == outcome.BUILD_INTERNAL)    { ret exit.INTERNAL; }
    if (bo.severity == outcome.BUILD_ENVIRONMENT) { ret exit.ENVIRONMENT; }
    std_format.format(w, "error[{}]: unknown BuildSeverity tag {}\n", diagnostic_kind.key_of(diagnostic_kind.COMPILER_INTERNAL), bo.severity);
    ret exit.INTERNAL;
}

pub fun outcome_code(bo: *outcome.BuildOutcome) i64 {
    var w: io_writer.Writer = stderr_writer();
    ret outcome_code_w(?w, bo);
}

fun sink_unit_w(w: *io_writer.Writer, units: usize, quiet: bool, artifact: str, target: str, verb: str, has_artifact: bool) {
    if (quiet)      { ret; }
    if (units <= 1) { ret; }
    std_format.write_str(w, verb);
    std_format.write_str(w, " ");
    if (has_artifact) { std_format.write_str(w, artifact); }
    or                { std_format.write_str(w, "project"); }
    if (!str_empty(target)) {
        std_format.write_str(w, " (");
        std_format.write_str(w, target);
        std_format.write_str(w, ")");
    }
    std_format.write_str(w, "\n");
}

fun build_unit_count(bo: *outcome.BuildOutcome) usize {
    var total: usize = 0;
    var i:     usize = 0;
    for (i < bo.events.len) {
        if (sel bo.events.data[i].unit) { total = total + 1; }
        i = i + 1;
    }
    ret total;
}

# one summary line closes the whole outcome: a failure record printed as its own
# `error:` line (an encoder or rules refusal that reached no store) counts in
# it beside every store's diagnostics, so the tally never reads `0 errors`
# above a nonzero exit (#3617)
fun render_outcome_w(w: *io_writer.Writer, bo: *outcome.BuildOutcome, quiet: bool) {
    val units: usize = build_unit_count(bo);
    var tally: Tally;
    var i:     usize = 0;
    for (i < bo.events.len) {
        val ev: *outcome.BuildEvent = ?bo.events.data[i];
        if (sel ev.unit) {
            sink_unit_w(w, units, quiet, ev.unit.artifact, ev.unit.target, ev.unit.verb, ev.unit.has_artifact);
        }
        or (sel ev.fail) {
            if (!sel ev.fail.fail.reported) {
                tally.errors   = tally.errors + 1;
                tally.rendered = tally.rendered + 1;
            }
            render_fail_w(w, ?ev.fail.fail);
        }
        or (sel ev.diagnostics) {
            render_store(w, ev.diagnostics.sources, ev.diagnostics.diags, ?tally);
        }
        i = i + 1;
    }
    if (tally.rendered > 0) {
        std_format.write_str(w, "\n");
        emit_summary(w, tally.errors, tally.warnings);
    }
}

# render a build outcome's events to stderr in order. human text renders unit
# banners, failures, diagnostics and the closing tally; json renders each
# diagnostic and each failure as one record
# ---
# r:     the command's report
# bo:    the outcome
# quiet: suppress the "building <artifact> (<target>)" banner, which prints only when the
#        outcome has more than one unit
pub fun report_outcome(r: *Report, bo: *outcome.BuildOutcome, quiet: bool) {
    if (r.format == FORMAT_JSON) { render_outcome_json(r, bo); }
    or                           { render_outcome_w(?r.w, bo, quiet); }
}

# how a command writes its diagnostics to stderr: `--diagnostics=human`, the
# default, or `--diagnostics=json`
pub def Format: u8;

pub val FORMAT_HUMAN: Format = 0;
pub val FORMAT_JSON:  Format = 1;

# the format a `--diagnostics` value names
# ---
# name: the value
# ret:  the format, or none for a name outside `human` and `json`
pub fun format_named(name: str) opt[Format] {
    if (str_equals(name, "human")) { ret opt[Format].some{FORMAT_HUMAN}; }
    if (str_equals(name, "json"))  { ret opt[Format].some{FORMAT_JSON}; }
    ret opt[Format].none{};
}

# how a build-shaped command reports to stderr, and what it has reported. under
# json every line it writes is a record and `report_close` ends the run with the
# summary record, whose counts are the severities of the records before it
# ---
# format:   human text or json records
# w:        where the report is written, stderr
# root:     the project root as the command resolved it, nil until then; a json
#           record names a file inside it relative to it
# errors:   the error records written
# warnings: the warning records written
# notes:    the note records written
# made:     whether the arena record paths are built in, and the base they are
#           measured from, have been made; they are on first use
pub rec Report {
    format:   Format;
    w:        io_writer.Writer;
    root:     str;
    errors:   usize;
    warnings: usize;
    notes:    usize;
    made:     bool;
    backing:  A.Allocator;
    ar:       arena.Arena;
    a:        A.Allocator;
    pb:       PathBase;
}

# start a report in place; it holds its own arena, so it stays where it was made
# until `report_close`
# ---
# r:      the report
# format: the format the command writes
pub fun report_init(r: *Report, format: Format) {
    r.format   = format;
    r.w        = stderr_writer();
    r.root     = nil;
    r.errors   = 0;
    r.warnings = 0;
    r.notes    = 0;
    r.made     = false;
}

# the base record paths are measured from, over the report's arena; nil when
# the arena cannot be made
fun report_paths(r: *Report) *PathBase {
    if (r.made) { ret ?r.pb; }
    val made: err[A.Error] = page.make(?r.backing);
    if (sel made.err) { ret nil; }
    val opened: err[A.Error] = arena.init(?r.ar, ?r.backing, 0);
    if (sel opened.err) { ret nil; }
    val armed: err[A.Error] = arena.make(?r.a, ?r.ar);
    if (sel armed.err) {
        arena.dnit(?r.ar);
        ret nil;
    }
    r.made = true;
    var root: str = r.root;
    if (root == nil) { root = "."; }
    r.pb = path_base(?r.a, root);
    ret ?r.pb;
}

fun count_record(r: *Report, severity: diagnostic.Severity) {
    if (severity == diagnostic.SEVERITY_WARNING)                                      { r.warnings = r.warnings + 1; }
    or (severity == diagnostic.SEVERITY_INFO || severity == diagnostic.SEVERITY_HELP) { r.notes = r.notes + 1; }
    or                                                                                { r.errors = r.errors + 1; }
}

# report a failure raised outside a diagnostic store: `error[<key>]: <message>`
# as text, or a failure record under json. a reported failure writes nothing,
# its diagnostics having been rendered already
# ---
# r:      the command's report
# f:      the failure
# origin: the phase it is reported under; ORIGIN_NONE for the command line itself
# ret:    the exit code `exit.of` maps the failure to
pub fun report_fail(r: *Report, f: outcome.Fail, origin: diagnostic.Origin) i64 {
    var fv: outcome.Fail = f;
    ret report_failure(r, ?fv, origin);
}

fun report_failure(r: *Report, f: *outcome.Fail, origin: diagnostic.Origin) i64 {
    if (r.format != FORMAT_JSON) { ret render_fail_w(?r.w, f); }
    if (!sel f.reported) {
        render_failure_record(?r.w, report_paths(r), f, origin);
        r.errors = r.errors + 1;
    }
    ret exit.of(@f);
}

# one test's result as a record under json; human text writes nothing here,
# the runner's own readout carrying it
# ---
# r:      the command's report
# art:    the test
# result: its outcome, a kind `mach test --format json` reports
# code:   its exit code
pub fun report_test(r: *Report, art: *outcome.TestArtifact, result: str, code: i64) {
    if (r.format != FORMAT_JSON) { ret; }
    var file: str       = art.file;
    val pb:   *PathBase = report_paths(r);
    if (pb != nil) { file = record_path(pb, art.file); }
    var o: json.Object;
    json.object_begin(?r.w, ?o);
    json.field_i64(?o, "schema", SCHEMA_VERSION);
    json.field_str(?o, "record", "test");
    json.field_str(?o, "name", art.name);
    json.field_str(?o, "module", art.module);
    json.field_str(?o, "file", file);
    json.field_i64(?o, "line", art.line::i64);
    json.field_str(?o, "outcome", result);
    json.field_i64(?o, "code", code);
    val origin: opt[str] = diagnostic.origin_name(diagnostic.ORIGIN_TEST);
    if (sel origin.some) { json.field_str(?o, "origin", origin.some); }
    json.object_end(?o);
}

# end the run: under json the summary record, the last line the command writes;
# the report's arena is released either way
# ---
# r:    the command's report
# code: the exit code the command returns
# ret:  code
pub fun report_close(r: *Report, code: i64) i64 {
    if (r.format == FORMAT_JSON) {
        var o: json.Object;
        json.object_begin(?r.w, ?o);
        json.field_i64(?o, "schema", SCHEMA_VERSION);
        json.field_str(?o, "record", "summary");
        json.field_i64(?o, "errors", r.errors::i64);
        json.field_i64(?o, "warnings", r.warnings::i64);
        json.field_i64(?o, "notes", r.notes::i64);
        if (code == exit.OK) { json.field_str(?o, "outcome", "success"); }
        or                   { json.field_str(?o, "outcome", "failure"); }
        json.field_i64(?o, "exit_code", code);
        json.object_end(?o);
    }
    if (r.made) {
        arena.dnit(?r.ar);
        r.made = false;
    }
    ret code;
}

# the version every json record carries in `schema`. adding a field, a record
# type or a value of an enumerated field keeps it; changing or removing one
# bumps it (doc/language/diagnostics-json.md)
val SCHEMA_VERSION: i64 = 1;

# where record paths are measured from: the working directory a relative
# source path is spelled against, and the project root resolved against it
rec PathBase {
    a:    *A.Allocator;
    cwd:  str;
    root: str;
}

fun path_base(a: *A.Allocator, root: str) PathBase {
    var pb: PathBase;
    pb.a    = a;
    pb.cwd  = nil;
    pb.root = nil;
    val cwd_r: res[types_string.OwnedString, env.EnvError] = env.current_dir(a);
    if (sel cwd_r.ok) { pb.cwd = cwd_r.ok.data; }
    pb.root = absolute(?pb, root);
    ret pb;
}

# a path resolved against the working directory and cleaned; nil when the
# allocator refuses
fun absolute(pb: *PathBase, p: str) str {
    var full: str = p;
    if (pb.cwd != nil) {
        val joined: res[types_path.Path, A.Error] = types_path.resolve(pb.a, pb.cwd, p);
        if (sel joined.err) { ret nil; }
        full = joined.ok;
    }
    val cleaned: res[types_path.Path, A.Error] = types_path.clean(pb.a, full);
    if (sel cleaned.err) { ret nil; }
    ret cleaned.ok;
}

# the path a record names a source file by: relative to the project root for a
# file inside it, otherwise absolute
fun record_path(pb: *PathBase, p: str) str {
    val full: str = absolute(pb, p);
    if (full == nil || pb.root == nil) { ret p; }
    val rl: usize = str_len(pb.root);
    if (rl == 0 || !str_starts_with(full, pb.root)) { ret full; }
    if (types_path.is_separator(pb.root[rl - 1]))   { ret (?full[rl])::str; }
    if (full[rl] == 0)                              { ret "."; }
    if (types_path.is_separator(full[rl]))          { ret (?full[rl + 1])::str; }
    ret full;
}

# the severity a record names: `error`, `warning`, or `note` for the
# informational severities; absent for a tag outside the catalog
fun severity_record_name(severity: diagnostic.Severity) opt[str] {
    if (severity == diagnostic.SEVERITY_ERROR)   { ret opt[str].some{"error"}; }
    if (severity == diagnostic.SEVERITY_WARNING) { ret opt[str].some{"warning"}; }
    if (severity == diagnostic.SEVERITY_INFO)    { ret opt[str].some{"note"}; }
    if (severity == diagnostic.SEVERITY_HELP)    { ret opt[str].some{"note"}; }
    ret opt[str].none{};
}

# a located span's members: `file`, 1-based `line` and `column` of its first
# byte, `end_line` and `end_column` of the position just past its last byte,
# columns counted in UTF-8 bytes, and the 0-based `byte_start` and exclusive
# `byte_end`
fun put_span(o: *json.Object, pb: *PathBase, f: *Frame) {
    val end_pos: lang_source.Position = lang_source.position(f.sf, f.end);
    json.field_str(o, "file", record_path(pb, f.sf.path));
    json.field_i64(o, "line", f.line_s::i64);
    json.field_i64(o, "column", f.col_s::i64);
    json.field_i64(o, "end_line", end_pos.line::i64);
    json.field_i64(o, "end_column", end_pos.col::i64);
    json.field_i64(o, "byte_start", f.off::i64);
    json.field_i64(o, "byte_end", f.end::i64);
}

# a failure's place as a span's members, as `put_span` writes them
fun put_place(o: *json.Object, pb: *PathBase, at: *outcome.Place) {
    var file: str = at.path;
    if (pb != nil) { file = record_path(pb, at.path); }
    json.field_str(o, "file", file);
    json.field_i64(o, "line", at.line::i64);
    json.field_i64(o, "column", at.col::i64);
    json.field_i64(o, "end_line", at.end_line::i64);
    json.field_i64(o, "end_column", at.end_col::i64);
    json.field_i64(o, "byte_start", at.start::i64);
    json.field_i64(o, "byte_end", at.end::i64);
}

fun put_text_element(arr: *json.Array, text: str) {
    if (!arr.first) { std_format.write_str(arr.w, ","); }
    arr.first = false;
    json.write_json_string(arr.w, text);
}

# one diagnostic as one NDJSON record, members in the order the schema
# documents them
fun render_record(w: *io_writer.Writer, sources: *lang_source.SourceMap, pb: *PathBase, d: *diagnostic.Diagnostic) {
    var o: json.Object;
    json.object_begin(w, ?o);
    json.field_i64(?o, "schema", SCHEMA_VERSION);
    json.field_str(?o, "record", "diagnostic");

    var message: str      = d.message;
    var code:    str      = diagnostic_kind.key_of(d.kind);
    val sev:     opt[str] = severity_record_name(d.severity);
    if (sel sev.some) { json.field_str(?o, "severity", sev.some); }
    or {
        # a severity outside the catalog is a defect, reported as the human text reports it
        json.field_str(?o, "severity", "error");
        code = diagnostic_kind.key_of(diagnostic_kind.COMPILER_INTERNAL);
        val said: res[str, std_format.FormatError] = std_format.sprint(pb.a, "unknown Severity tag {}: {}", d.severity, d.message);
        if (sel said.ok) { message = said.ok; }
    }
    json.field_str_or_null(?o, "code", code);
    json.field_str(?o, "message", message);
    val origin: opt[str] = diagnostic.origin_name(d.origin);
    if (sel origin.some) { json.field_str(?o, "origin", origin.some); }

    val opt_pf: opt[Frame] = locate(sources, d.loc);
    if (sel opt_pf.some) {
        var pf:   Frame = opt_pf.some;
        var prim: json.Object;
        json.field_object_begin(?o, "primary", ?prim);
        put_span(?prim, pb, ?pf);
        json.object_end_value(?prim);
    }
    or { json.field_null(?o, "primary"); }

    var related: json.Array;
    json.field_array_begin(?o, "related", ?related);
    var i: usize = 0;
    for (i < d.related.len) {
        val rel:    *diagnostic.Related = ?d.related.data[i];
        val opt_rf: opt[Frame]          = locate(sources, rel.loc);
        if (sel opt_rf.some) {
            var rf: Frame = opt_rf.some;
            var ro: json.Object;
            json.array_object_begin(?related, ?ro);
            put_span(?ro, pb, ?rf);
            json.field_str_or_null(?ro, "label", rel.label);
            json.object_end_value(?ro);
        }
        i = i + 1;
    }
    json.array_end(?related);

    # a related site mach cannot locate stands as a note, as the text shows it
    var notes: json.Array;
    json.field_array_begin(?o, "notes", ?notes);
    i = 0;
    for (i < d.related.len) {
        val rel:    *diagnostic.Related = ?d.related.data[i];
        val opt_rf: opt[Frame]          = locate(sources, rel.loc);
        if (rel.label != nil && sel opt_rf.none) { put_text_element(?notes, rel.label); }
        i = i + 1;
    }
    i = 0;
    for (i < d.children.len) {
        if (d.children.data[i].kind != diagnostic.CHILD_HELP) { put_text_element(?notes, d.children.data[i].text); }
        i = i + 1;
    }
    json.array_end(?notes);

    var help: json.Array;
    json.field_array_begin(?o, "help", ?help);
    i = 0;
    for (i < d.children.len) {
        if (d.children.data[i].kind == diagnostic.CHILD_HELP) { put_text_element(?help, d.children.data[i].text); }
        i = i + 1;
    }
    json.array_end(?help);

    var fixes: json.Array;
    json.field_array_begin(?o, "fixes", ?fixes);
    i = 0;
    for (i < d.fixes.len) {
        val fx: *diagnostic.Fix = ?d.fixes.data[i];
        var fo: json.Object;
        json.array_object_begin(?fixes, ?fo);
        json.field_str(?fo, "label", fx.label);
        var edits: json.Array;
        json.field_array_begin(?fo, "edits", ?edits);
        var e: usize = 0;
        for (e < fx.edits.len) {
            val ed:     *diagnostic.Edit = ?fx.edits.data[e];
            val opt_ef: opt[Frame]       = locate(sources, ed.loc);
            if (sel opt_ef.some) {
                var ef: Frame = opt_ef.some;
                var eo: json.Object;
                json.array_object_begin(?edits, ?eo);
                put_span(?eo, pb, ?ef);
                json.field_str(?eo, "replacement", ed.replacement);
                json.object_end_value(?eo);
            }
            e = e + 1;
        }
        json.array_end(?edits);
        json.object_end_value(?fo);
        i = i + 1;
    }
    json.array_end(?fixes);
    json.object_end(?o);
}

fun render_store_json(r: *Report, sources: *lang_source.SourceMap, list: *diagnostic.DiagnosticStore, pb: *PathBase) {
    var i: usize = 0;
    for (i < diagnostic.len(list)) {
        val d: *diagnostic.Diagnostic = ?list.items.data[i];
        render_record(?r.w, sources, pb, d);
        count_record(r, d.severity);
        i = i + 1;
    }
}

# a failure outside every store as a record: the members of a diagnostic
# record, its primary the place in the file that caused it when it names one
# and its related the other places it names, each without a label
fun render_failure_record(w: *io_writer.Writer, pb: *PathBase, f: *outcome.Fail, origin: diagnostic.Origin) {
    var o: json.Object;
    json.object_begin(w, ?o);
    json.field_i64(?o, "schema", SCHEMA_VERSION);
    json.field_str(?o, "record", "failure");
    json.field_str(?o, "severity", "error");
    json.field_str_or_null(?o, "code", diagnostic_kind.key_of(outcome.kind_of(@f)));
    json.field_str(?o, "message", outcome.describe(@f));
    val named: opt[str] = diagnostic.origin_name(origin);
    if (sel named.some) { json.field_str(?o, "origin", named.some); }
    val at: opt[outcome.Place] = outcome.place_of(@f);
    if (sel at.some) {
        var place: outcome.Place = at.some;
        var prim:  json.Object;
        json.field_object_begin(?o, "primary", ?prim);
        put_place(?prim, pb, ?place);
        json.object_end_value(?prim);
    }
    or { json.field_null(?o, "primary"); }
    var related: json.Array;
    json.field_array_begin(?o, "related", ?related);
    val also: outcome.Related = outcome.related_of(@f);
    var i:    usize           = 0;
    for (i < also.count) {
        val rel: *outcome.Place = ?also.items[i];
        if (rel.path != nil) {
            var ro: json.Object;
            json.array_object_begin(?related, ?ro);
            put_place(?ro, pb, rel);
            json.field_null(?ro, "label");
            json.object_end_value(?ro);
        }
        i = i + 1;
    }
    json.array_end(?related);
    var notes: json.Array;
    json.field_array_begin(?o, "notes", ?notes);
    json.array_end(?notes);
    var help: json.Array;
    json.field_array_begin(?o, "help", ?help);
    json.array_end(?help);
    var fixes: json.Array;
    json.field_array_begin(?o, "fixes", ?fixes);
    json.array_end(?fixes);
    json.object_end(?o);
}

# the json rendering of an outcome: every diagnostic and every failure as a
# record in event order; banners and the closing tally are human rendering only
fun render_outcome_json(r: *Report, bo: *outcome.BuildOutcome) {
    val pb: *PathBase = report_paths(r);
    if (pb == nil) {
        var oom: outcome.Fail = outcome.internal("out of memory");
        report_failure(r, ?oom, diagnostic.ORIGIN_NONE);
        ret;
    }
    var i: usize = 0;
    for (i < bo.events.len) {
        val ev: *outcome.BuildEvent = ?bo.events.data[i];
        if (sel ev.fail)        { report_failure(r, ?ev.fail.fail, ev.fail.origin); }
        or (sel ev.diagnostics) { render_store_json(r, ev.diagnostics.sources, ev.diagnostics.diags, pb); }
        i = i + 1;
    }
}

test render_fail__classifies_exit_code_and_suppresses_reported_output {
    var buf:  [256]u8;
    var sink: MemSink;
    var w:    io_writer.Writer;
    mem_writer(?w, ?sink, ?buf[0], 256);

    var rf: outcome.Fail = outcome.reported();
    if (render_fail_w(?w, ?rf) != 1) { ret 1; }
    if (sink.len != 0)               { ret 2; }

    var uf: outcome.Fail = outcome.user(diagnostic_kind.TOML_MALFORMED, "bad input");
    if (render_fail_w(?w, ?uf) != 1)                               { ret 3; }
    if (!sink_contains(?sink, "error[toml.malformed]: bad input")) { ret 4; }

    var buf2:  [256]u8;
    var sink2: MemSink;
    var w2:    io_writer.Writer;
    mem_writer(?w2, ?sink2, ?buf2[0], 256);
    var iv: outcome.Fail = outcome.internal("boom");
    if (render_fail_w(?w2, ?iv) != 2)                             { ret 5; }
    if (!sink_contains(?sink2, "error[compiler.internal]: boom")) { ret 6; }

    var buf3:  [256]u8;
    var sink3: MemSink;
    var w3:    io_writer.Writer;
    mem_writer(?w3, ?sink3, ?buf3[0], 256);
    var ev: outcome.Fail = outcome.environment(diagnostic_kind.TOML_MALFORMED, "disk full");
    if (render_fail_w(?w3, ?ev) != 3)                               { ret 7; }
    if (!sink_contains(?sink3, "error[toml.malformed]: disk full")) { ret 8; }

    ret 0;
}

# an allocation refusal met by the driver stays an internal failure (exit 2),
# never an environmental one (exit 3): the C4 decisions of #3226 (PR #3283)
test regression__an_allocation_refusal_met_by_the_driver_exits_internal {
    var buf:  [256]u8;
    var sink: MemSink;
    var w:    io_writer.Writer;
    mem_writer(?w, ?sink, ?buf[0], 256);
    var refused: outcome.Fail = outcome.refused(A.Error.exhausted{});
    if (!sel refused.internal)                                            { ret 1; }
    if (render_fail_w(?w, ?refused) != 2)                                 { ret 2; }
    if (!sink_contains(?sink, "error[compiler.internal]: out of memory")) { ret 3; }
    var bo: outcome.BuildOutcome;
    bo.severity = outcome.severity_of(?refused);
    if (outcome_code(?bo) != 2) { ret 4; }
    ret 0;
}

test outcome_code__maps_every_closed_severity {
    var ok_bo: outcome.BuildOutcome;
    ok_bo.severity = outcome.BUILD_OK;
    if (outcome_code(?ok_bo) != 0) { ret 1; }

    var user_bo: outcome.BuildOutcome;
    user_bo.severity = outcome.BUILD_USER;
    if (outcome_code(?user_bo) != 1) { ret 2; }

    var internal_bo: outcome.BuildOutcome;
    internal_bo.severity = outcome.BUILD_INTERNAL;
    if (outcome_code(?internal_bo) != 2) { ret 3; }

    var env_bo: outcome.BuildOutcome;
    env_bo.severity = outcome.BUILD_ENVIRONMENT;
    if (outcome_code(?env_bo) != 3) { ret 4; }

    var buf:  [256]u8;
    var sink: MemSink;
    var w:    io_writer.Writer;
    mem_writer(?w, ?sink, ?buf[0], 256);
    var unknown_bo: outcome.BuildOutcome;
    unknown_bo.severity = 255::outcome.BuildSeverity;
    if (outcome_code_w(?w, ?unknown_bo) != 2)                                             { ret 5; }
    if (!sink_contains(?sink, "error[compiler.internal]: unknown BuildSeverity tag 255")) { ret 6; }
    ret 0;
}

test sink_unit__shown_only_for_many_units_and_never_when_quiet {
    var buf:  [256]u8;
    var sink: MemSink;
    var w:    io_writer.Writer;
    mem_writer(?w, ?sink, ?buf[0], 256);

    sink_unit_w(?w, 1, false, "app", "linux", "building", true);
    if (sink.len != 0) { ret 1; }
    sink_unit_w(?w, 2, true, "app", "linux", "building", true);
    if (sink.len != 0) { ret 1; }

    sink_unit_w(?w, 2, false, "app", "linux", "building", true);
    if (!sink_contains(?sink, "building app (linux)\n")) { ret 2; }

    var buf2:  [256]u8;
    var sink2: MemSink;
    var w2:    io_writer.Writer;
    mem_writer(?w2, ?sink2, ?buf2[0], 256);
    sink_unit_w(?w2, 2, false, "app", "", "building", false);
    if (!sink_contains(?sink2, "building project\n")) { ret 3; }

    ret 0;
}

test render_outcome_w__consumes_owned_events_in_order {
    var a: A.Allocator;
    page.make(?a);
    var bo: outcome.BuildOutcome = outcome.outcome_init(?a);
    var f:  outcome.Fail         = outcome.user(diagnostic_kind.TOML_MALFORMED, "bad input");

    if (lang_alloc.refused(outcome.record_unit(?bo, "app", "linux", "building", true))) {
        outcome.outcome_dnit(?bo);
        ret 1;
    }
    if (lang_alloc.refused(outcome.record_unit(?bo, "lib", "", "building", true))) {
        outcome.outcome_dnit(?bo);
        ret 1;
    }
    if (lang_alloc.refused(outcome.record_fail(?bo, ?f, diagnostic.ORIGIN_BUILD))) {
        outcome.outcome_dnit(?bo);
        ret 1;
    }

    var buf:  [512]u8;
    var sink: MemSink;
    var w:    io_writer.Writer;
    mem_writer(?w, ?sink, ?buf[0], 512);
    render_outcome_w(?w, ?bo, false);

    var bad: i32 = 0;
    if (!sink_contains(?sink, "building app (linux)\n"))             { bad = 1; }
    if (!sink_contains(?sink, "building lib\n"))                     { bad = 1; }
    if (!sink_contains(?sink, "error[toml.malformed]: bad input\n")) { bad = 1; }

    outcome.outcome_dnit(?bo);
    ret bad;
}

# a refusal that reached no store (an encoder or rules refusal is an internal
# failure record, printed as its own `error:` line) counts in the one summary
# beside the stores' diagnostics: `1 error / 1 warning`, never `0 errors / 1
# warning` above exit 2 (#3617)
test regression__the_tally_counts_a_failure_record_beside_the_stores {
    var a: A.Allocator;
    page.make(?a);
    val session_r: res[session.Session, fail.Fail] = session.init(?a);
    if (sel session_r.err) { ret 1; }
    var s: session.Session = session_r.ok;
    fin { session.dnit(?s); }

    val file_r: res[lang_source.FileId, fail.Fail] = session.load_source(?s, "mach.toml", "[project]\n");
    if (sel file_r.err) { ret 1; }
    val fid:    lang_source.FileId           = file_r.ok;
    val file_o: opt[*lang_source.SourceFile] = lang_source.get(?s.sources, fid);
    if (sel file_o.none) { ret 1; }
    val warned: err[fail.Fail] = diagnostic.warning(?s.diags, diagnostic_kind.IMPORT_UNUSED, fid, line_span(file_o.some, 1), "states no compiler range");
    if (sel warned.err) { ret 1; }

    var bo: outcome.BuildOutcome = outcome.outcome_init(?a);
    fin { outcome.outcome_dnit(?bo); }
    var f: outcome.Fail = outcome.internal("encode: RISC-V instruction is not admitted on riscv32");
    if (lang_alloc.refused(outcome.record_fail(?bo, ?f, diagnostic.ORIGIN_BUILD))) { ret 1; }
    outcome.fold_fail(?bo, ?f);
    val recorded: err[outcome.Fail] = outcome.record_diagnostics(?bo, ?s.sources, ?s.diags);
    if (sel recorded.err) { ret 1; }

    var buf:  [1024]u8;
    var sink: MemSink;
    var w:    io_writer.Writer;
    mem_writer(?w, ?sink, ?buf[0], 1024);
    render_outcome_w(?w, ?bo, false);

    var bad: i32 = 0;
    if (!sink_contains(?sink, "error[compiler.internal]: encode: RISC-V instruction is not admitted on riscv32\n")) { bad = 2; }
    if (!sink_contains(?sink, "warning[import.unused]: states no compiler range"))                                  { bad = 3; }
    if (!sink_contains(?sink, "\n1 error / 1 warning\n"))                                                           { bad = 4; }
    if (sink_contains(?sink, "0 errors"))                                                                           { bad = 5; }
    if (outcome_code_w(?w, ?bo) != 2)                                                                               { bad = 6; }

    # a reported failure's error is already on a store, so it is not counted twice
    var reported: outcome.BuildOutcome = outcome.outcome_init(?a);
    fin { outcome.outcome_dnit(?reported); }
    var rf: outcome.Fail = outcome.reported();
    if (lang_alloc.refused(outcome.record_fail(?reported, ?rf, diagnostic.ORIGIN_BUILD))) { ret 1; }
    val again: err[outcome.Fail] = outcome.record_diagnostics(?reported, ?s.sources, ?s.diags);
    if (sel again.err) { ret 1; }
    var buf2:  [1024]u8;
    var sink2: MemSink;
    var w2:    io_writer.Writer;
    mem_writer(?w2, ?sink2, ?buf2[0], 1024);
    render_outcome_w(?w2, ?reported, false);
    if (!sink_contains(?sink2, "\n0 errors / 1 warning\n")) { bad = 7; }
    ret bad;
}

test render_outcome_w__diagnostics_survive_session_teardown {
    var a: A.Allocator;
    page.make(?a);
    val session_r: res[session.Session, fail.Fail] = session.init(?a);
    if (sel session_r.err) { ret 1; }
    var s: session.Session = session_r.ok;

    val file_r: res[lang_source.FileId, fail.Fail] = session.load_source(?s, "owned.mach", "bad value\n");
    if (sel file_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val fid:    lang_source.FileId           = file_r.ok;
    val file_o: opt[*lang_source.SourceFile] = lang_source.get(?s.sources, fid);
    if (sel file_o.none) {
        session.dnit(?s);
        ret 1;
    }
    val sf:      *lang_source.SourceFile = file_o.some;
    val error_r: err[fail.Fail]          = diagnostic.error(?s.diags, diagnostic_kind.SECRET_NOT_OBLIVIOUS, fid, line_span(sf, 1), "owned diagnostic");
    if (sel error_r.err) {
        session.dnit(?s);
        ret 1;
    }

    var bo:       outcome.BuildOutcome = outcome.outcome_init(?a);
    val recorded: err[outcome.Fail]    = outcome.record_diagnostics(?bo, ?s.sources, ?s.diags);
    if (sel recorded.err) {
        outcome.outcome_dnit(?bo);
        session.dnit(?s);
        ret 1;
    }
    session.dnit(?s);

    var buf:  [512]u8;
    var sink: MemSink;
    var w:    io_writer.Writer;
    mem_writer(?w, ?sink, ?buf[0], 512);
    render_outcome_w(?w, ?bo, false);

    var bad: i32 = 0;
    if (!sink_contains(?sink, "owned diagnostic")) { bad = 1; }
    if (!sink_contains(?sink, "owned.mach:1:1"))   { bad = 1; }
    if (!sink_contains(?sink, "1 | bad value"))    { bad = 1; }
    outcome.outcome_dnit(?bo);
    ret bad;
}

# a scratch project holding one source file; the caller removes the root
#[testing]
fun t_scaffold(a: *A.Allocator, manifest_text: str, source_text: str) res[str, fail.Fail] {
    val tf_r: res[fs.TempFile, fs.FsError] = fs.temp_create(a, "mach_cli_diag_codegen");
    if (sel tf_r.err) { ret res[str, fail.Fail].err{fail.fs_refused(tf_r.err)}; }
    var tf:    fs.TempFile       = tf_r.ok;
    val dup_r: res[str, A.Error] = str_dup(a, fs.temp_path(?tf));
    fs.temp_close_and_remove(?tf);
    if (sel dup_r.err) { ret res[str, fail.Fail].err{fail.refused(dup_r.err)}; }
    val root: str = dup_r.ok;

    val made: err[fs.FsError] = fs.create_dir_all(a, root, 0o755);
    if (sel made.err) { ret res[str, fail.Fail].err{fail.fs_refused(made.err)}; }
    val src_dir_r: res[str, A.Error] = types_path.join(a, root, "src");
    if (sel src_dir_r.err) { ret res[str, fail.Fail].err{fail.refused(src_dir_r.err)}; }
    val made_src: err[fs.FsError] = fs.create_dir_all(a, src_dir_r.ok, 0o755);
    if (sel made_src.err) { ret res[str, fail.Fail].err{fail.fs_refused(made_src.err)}; }

    val manifest_path_r: res[str, A.Error] = types_path.join(a, root, "mach.toml");
    if (sel manifest_path_r.err) { ret res[str, fail.Fail].err{fail.refused(manifest_path_r.err)}; }
    val wrote_manifest: err[fs.FsError] = fs.write_bytes(manifest_path_r.ok, manifest_text::*u8, str_len(manifest_text), 0o644);
    if (sel wrote_manifest.err) { ret res[str, fail.Fail].err{fail.fs_refused(wrote_manifest.err)}; }
    val source_path_r: res[str, A.Error] = types_path.join(a, src_dir_r.ok, "main.mach");
    if (sel source_path_r.err) { ret res[str, fail.Fail].err{fail.refused(source_path_r.err)}; }
    val wrote_source: err[fs.FsError] = fs.write_bytes(source_path_r.ok, source_text::*u8, str_len(source_text), 0o644);
    if (sel wrote_source.err) { ret res[str, fail.Fail].err{fail.fs_refused(wrote_source.err)}; }
    ret res[str, fail.Fail].ok{root};
}

# the tally counts a diagnostic the back half raised: an `#[oblivious]` function
# whose inline asm branches on a loaded secret word is refused by codegen, and
# the refusal is one located error on the store, so the rendered outcome ends
# `1 error / 0 warnings` and the exit code is the user's, not `0 errors` beside
# a nonzero exit (#3656)
test regression__the_tally_counts_a_codegen_rejection {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }

    val manifest_text: str = "[project]\nmach = \">=5\"\nid = \"ctdiag\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.linux]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[profile.debug]\ndefault = true\nopt = 0\ndebug = false\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n\n[artifact.ctdiag]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/ctdiag\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
    val source_text:   str = "#[oblivious]\nfun f(k: *^u64) ^u64 {\n    var r: ^u64 = @k;\n    asm x86_64 {\n        mov rax, {r}\n        inc rax\n        je 1f\n    1:\n        nop\n    }\n    ret r;\n}\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n";

    val root_r: res[str, fail.Fail] = t_scaffold(?a, manifest_text, source_text);
    if (sel root_r.err) { ret 2; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?a, root); }

    val session_r: res[session.Session, fail.Fail] = session.init(?a);
    if (sel session_r.err) { ret 3; }
    var s: session.Session = session_r.ok;
    fin { session.dnit(?s); }
    val registered: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel registered.err) { ret 4; }

    var pick: manifest.Selection;
    pick.target       = "linux";
    pick.profile      = "";
    pick.artifact     = "";
    pick.want_lib     = false;
    pick.has_artifact = false;
    val project_r: res[project.Project, outcome.Fail] = driver.build_project(?s, root, ?pick);
    if (sel project_r.err) { ret 5; }
    var p: project.Project = project_r.ok;
    fin { project.dnit_project(?p); }

    val checked: err[outcome.Fail] = driver.run_sema_pass(?p);
    if (sel checked.err) { ret 6; }
    val lowered: err[outcome.Fail] = driver.run_lower_pass(?p);
    if (sel lowered.err) { ret 7; }
    val generated: err[outcome.Fail] = driver.run_codegen_pass(?p);
    if (sel generated.ok) { ret 8; }
    var failure: outcome.Fail = generated.err;

    # the outcome the engine would hand the renderer: the failure, then the
    # session's diagnostics
    var bo: outcome.BuildOutcome = outcome.outcome_init(?a);
    fin { outcome.outcome_dnit(?bo); }
    val failed: err[A.Error] = outcome.record_fail(?bo, ?failure, diagnostic.ORIGIN_BUILD);
    if (sel failed.err) { ret 9; }
    outcome.fold_fail(?bo, ?failure);
    val recorded: err[outcome.Fail] = outcome.record_diagnostics(?bo, ?s.sources, ?s.diags);
    if (sel recorded.err) { ret 10; }

    var buf:  [4096]u8;
    var sink: MemSink;
    var w:    io_writer.Writer;
    mem_writer(?w, ?sink, ?buf[0], 4096);
    render_outcome_w(?w, ?bo, false);

    var bad: i32 = 0;
    if (!sink_contains(?sink, "error[secret.branch]: #[oblivious] function `ctdiag.main.f` branches on a secret value")) { bad = 11; }
    if (!sink_contains(?sink, "main.mach:4:5"))                                                                          { bad = 12; }
    if (!sink_contains(?sink, "\n1 error / 0 warnings\n"))                                                               { bad = 13; }
    if (sink_contains(?sink, "0 errors"))                                                                                { bad = 14; }
    if (outcome_code_w(?w, ?bo) != 1)                                                                                    { bad = 15; }
    ret bad;
}

# the tally counts a refusal the optimizer raised one layer above codegen: under
# `simd = "require"` a 32-bit lane vector multiply scalarizes on x86-64's SSE2
# baseline, the pipeline refuses it as one located error on the store, and the
# rendered outcome ends `1 error / 0 warnings` beside the user's exit code (#3664)
test render_outcome_w__the_tally_counts_a_simd_require_rejection {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }

    val manifest_text: str = "[project]\nmach = \">=5\"\nid = \"ctsimd\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.linux]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[profile.debug]\ndefault = true\nopt = 0\ndebug = false\nsimd = \"require\"\nvectorize = false\nfloat_reassoc = false\n\n[artifact.ctsimd]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/ctsimd\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
    # the 8-bit lane multiply is the cell the x86-64 baseline still scalarizes
    # (32- and 64-bit lanes pack through the pmuludq sequences since #3739)
    val source_text: str = "fun kernel(a: u8x16, b: u8x16) u8x16 {\n    ret a * b;\n}\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n";

    val root_r: res[str, fail.Fail] = t_scaffold(?a, manifest_text, source_text);
    if (sel root_r.err) { ret 2; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?a, root); }

    val session_r: res[session.Session, fail.Fail] = session.init(?a);
    if (sel session_r.err) { ret 3; }
    var s: session.Session = session_r.ok;
    fin { session.dnit(?s); }
    val registered: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel registered.err) { ret 4; }

    var pick: manifest.Selection;
    pick.target       = "linux";
    pick.profile      = "";
    pick.artifact     = "";
    pick.want_lib     = false;
    pick.has_artifact = false;
    # the driver's default request stands in for the composed one, so the
    # profile's lever is set on the request the way the cli composes it
    var req: request.BuildRequest = request.defaults();
    req.project_root = root;
    req.simd         = manifest.SIMD_REQUIRE;
    req.vectorize    = false;
    val project_r: res[project.Project, outcome.Fail] = driver.build_project_sel_req(?s, root, ?pick, ?req);
    if (sel project_r.err) { ret 5; }
    var p: project.Project = project_r.ok;
    fin { project.dnit_project(?p); }

    val checked: err[outcome.Fail] = driver.run_sema_pass(?p);
    if (sel checked.err) { ret 6; }
    val lowered: err[outcome.Fail] = driver.run_lower_pass(?p);
    if (sel lowered.ok) { ret 7; }
    var failure: outcome.Fail = lowered.err;
    if (!outcome.is_reported(failure)) { ret 8; }

    var bo: outcome.BuildOutcome = outcome.outcome_init(?a);
    fin { outcome.outcome_dnit(?bo); }
    val failed: err[A.Error] = outcome.record_fail(?bo, ?failure, diagnostic.ORIGIN_BUILD);
    if (sel failed.err) { ret 9; }
    outcome.fold_fail(?bo, ?failure);
    val recorded: err[outcome.Fail] = outcome.record_diagnostics(?bo, ?s.sources, ?s.diags);
    if (sel recorded.err) { ret 10; }

    var buf:  [4096]u8;
    var sink: MemSink;
    var w:    io_writer.Writer;
    mem_writer(?w, ?sink, ?buf[0], 4096);
    render_outcome_w(?w, ?bo, false);

    var bad: i32 = 0;
    if (!sink_contains(?sink, "error[vector.scalarize_refused]: simd = \"require\": vector multiply on 16 lanes of 8-bit integers in 'ctsimd.main.kernel' would scalarize on x86_64: no packed form for it at any extension")) { bad = 11; }
    if (!sink_contains(?sink, "main.mach:2:9"))                                                                                                                                                                                { bad = 12; }
    if (!sink_contains(?sink, "\n1 error / 0 warnings\n"))                                                                                                                                                                     { bad = 13; }
    if (sink_contains(?sink, "0 errors"))                                                                                                                                                                                      { bad = 14; }
    if (outcome_code_w(?w, ?bo) != 1)                                                                                                                                                                                          { bad = 15; }
    ret bad;
}

# the diagnostics a scratch project for the target `target_keys` spells reports
# through lowering whose text holds `needle`, built under the profile keys
# `profile_keys` adds; a module type checking rejects is not lowered, and -1 is
# a build that fails any other way. the request takes the profile's levers as
# the cli composes them
#[testing]
fun t_allowed_warnings(target_keys: str, profile_keys: str, main_text: str, lib_text: str, needle: str) i32 {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret -1; }

    val head:       str                              = "[project]\nmach = \">=5\"\nid = \"ctallow\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.t]\n";
    val profile:    str                              = "\n[profile.debug]\ndefault = true\nopt = 0\ndebug = false\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n";
    val tail:       str                              = "\n[artifact.ctallow]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/ctallow\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
    val manifest_r: res[str, std_format.FormatError] = std_format.sprint(?a, "{}{}{}{}{}", head, target_keys, profile, profile_keys, tail);
    if (sel manifest_r.err) { ret -1; }
    val root_r: res[str, fail.Fail] = t_scaffold(?a, manifest_r.ok, main_text);
    if (sel root_r.err) { ret -1; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?a, root); }
    val lib_path_r: res[str, A.Error] = types_path.join(?a, root, "src/lib.mach");
    if (sel lib_path_r.err) { ret -1; }
    val wrote_lib: err[fs.FsError] = fs.write_bytes(lib_path_r.ok, lib_text::*u8, str_len(lib_text), 0o644);
    if (sel wrote_lib.err) { ret -1; }

    val session_r: res[session.Session, fail.Fail] = session.init(?a);
    if (sel session_r.err) { ret -1; }
    var s: session.Session = session_r.ok;
    fin { session.dnit(?s); }
    val registered: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel registered.err) { ret -1; }

    val m_r: res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, root);
    if (sel m_r.err) { ret -1; }
    var m: manifest.Manifest = m_r.ok;
    fin { manifest.dnit(?m, ?a); }
    val pf_r: res[manifest.ResolvedProfile, outcome.Fail] = manifest.resolve_profile(?a, ?s.interner, ?m, "");
    if (sel pf_r.err) { ret -1; }

    var pick: manifest.Selection;
    pick.target       = "t";
    pick.profile      = "";
    pick.artifact     = "";
    pick.want_lib     = false;
    pick.has_artifact = false;
    var req: request.BuildRequest = request.defaults();
    req.project_root = root;
    req.vectorize    = false;
    req.allow        = pf_r.ok.allow;
    val project_r: res[project.Project, outcome.Fail] = driver.build_project_sel_req(?s, root, ?pick, ?req);
    if (sel project_r.err) { ret -1; }
    var p: project.Project = project_r.ok;
    fin { project.dnit_project(?p); }
    val checked: err[outcome.Fail] = driver.run_sema_pass(?p);
    if (sel checked.err) {
        if (!outcome.is_reported(checked.err)) { ret -1; }
    }
    or {
        val lowered: err[outcome.Fail] = driver.run_lower_pass(?p);
        if (sel lowered.err) { ret -1; }
    }

    var found: i32   = 0;
    var i:     usize = 0;
    for (i < diagnostic.len(?s.diags)) {
        val d: *diagnostic.Diagnostic = ?s.diags.items.data[i];
        if (str_contains(d.message, needle)) { found = found + 1; }
        i = i + 1;
    }
    ret found;
}

#[testing]
fun t_cat(a: *A.Allocator, x: str, y: str, z: str) str {
    val joined: res[str, std_format.FormatError] = std_format.sprint(a, "{}{}{}", x, y, z);
    if (sel joined.err) { ret ""; }
    ret joined.ok;
}

# a profile's `allow` silences a warning kind by its key or its family and no
# other: the unused import and the inexact float literal warn until their key
# is listed, and listing another key leaves the import's standing (#3812, #4065)
test allow__a_listed_warning_kind_is_not_reported {
    val main_text: str = "use ctallow.lib.f;\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n";
    val lib_text:  str = "pub fun f() i32 { ret 1; }\n";
    if (t_allowed_warnings(T_X86_64, "", main_text, lib_text, "unused import") != 1)                                { ret 1; }
    if (t_allowed_warnings(T_X86_64, "allow = [\"import.unused\"]\n", main_text, lib_text, "unused import") != 0)   { ret 2; }
    if (t_allowed_warnings(T_X86_64, "allow = [\"decl.deprecated\"]\n", main_text, lib_text, "unused import") != 1) { ret 3; }
    val float_text: str = "#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { val x: f32 = 3.14159265358979; ret 0; }\n";
    if (t_allowed_warnings(T_X86_64, "", float_text, lib_text, "not exact") != 1)                      { ret 4; }
    if (t_allowed_warnings(T_X86_64, "allow = [\"float\"]\n", float_text, lib_text, "not exact") != 0) { ret 5; }
    ret 0;
}

# `#[expect]` acknowledges the warnings it names inside its own declaration, a
# `test` block included, and no other: an expected key nothing raises warns
# when the source alone decides it, stays quiet when the build decides it, and
# an unknown key, an error key, a repeat, a second `#[expect]` and a placement
# outside a declaration it may stand on are refused (#4065)
test expect__acknowledges_named_warnings_inside_its_declaration {
    var a: A.Allocator;
    page.make(?a);
    val lib_text: str = "pub fun f() i32 { ret 1; }\n";
    val main:     str = "#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n";
    val g:        str = "fun g() f32 { val x: f32 = 3.14159265358979; ret x; }\n";
    val h:        str = "fun h() i32 { ret 0; }\n";
    val unmet:    str = "`#[expect]` names";
    val placed:   str = "`expect` applies only to fun, rec, uni, tag, val, var and test";
    var texts:    [11]str;
    var needs:    [11]str;
    var want:     [11]i32;
    # expected on the fun itself, on a sibling, and on a test block
    texts[0] = t_cat(?a, "#[expect(\"float.inexact\")]\n", g, main);
    needs[0] = "not exact";
    want[0]  = 0;
    texts[1] = t_cat(?a, g, "#[expect(\"float\")]\n", t_cat(?a, h, main, ""));
    needs[1] = "not exact";
    want[1]  = 1;
    texts[2] = t_cat(?a, "#[expect(\"float.inexact\")]\n", "test t { val x: f32 = 3.14159265358979; ret 0; }\n", main);
    needs[2] = "not exact";
    want[2]  = 0;
    # an unmet key warns for a kind the source alone decides, and not for one the build decides
    texts[3]  = t_cat(?a, "#[expect(\"float.inexact\")]\n", h, main);
    needs[3]  = unmet;
    want[3]   = 1;
    texts[4]  = t_cat(?a, "#[expect(\"vector.scalarize\")]\n", h, main);
    needs[4]  = unmet;
    want[4]   = 0;
    texts[5]  = t_cat(?a, "#[expect(\"no.such\")]\n", h, main);
    needs[5]  = "`no.such` is not a warning key";
    want[5]   = 1;
    texts[6]  = t_cat(?a, "#[expect(\"secret.not_oblivious\")]\n", h, main);
    needs[6]  = "names an error, and an error is never acknowledged";
    want[6]   = 1;
    texts[7]  = t_cat(?a, "#[expect(\"float\", \"float\")]\n", h, main);
    needs[7]  = "`expect` names `float` twice";
    want[7]   = 1;
    texts[8]  = t_cat(?a, "#[expect(\"float\")]\n#[expect(\"doc\")]\n", h, main);
    needs[8]  = "`expect` may appear only once";
    want[8]   = 1;
    texts[9]  = t_cat(?a, "#[expect(\"import.unused\")]\n", "use ctallow.lib.f;\n", main);
    needs[9]  = placed;
    want[9]   = 1;
    texts[10] = t_cat(?a, "#[expect(\"float.inexact\")]\n", "def D: f32;\n", main);
    needs[10] = placed;
    want[10]  = 1;
    var i: usize = 0;
    for (i < 11) {
        if (t_allowed_warnings(T_X86_64, "", texts[i], lib_text, needs[i]) != want[i]) { ret (i + 1)::i32; }
        i = i + 1;
    }
    # an expected warning is acknowledged though `allow` silences its key too
    if (t_allowed_warnings(T_X86_64, "allow = [\"float\"]\n", texts[0], lib_text, unmet) != 0) { ret 20; }
    ret 0;
}

#[testing]
val T_X86_64: str = "isa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n";

#[testing]
val T_AARCH64: str = "isa = \"aarch64\"\nos = \"linux\"\nabi = \"aapcs64\"\n";

# an operation that falls back to scalar code warns once at its site, not once
# per lane, naming the operation, its lanes and the target, and saying so when
# no extension would pack it: integer vector division on x86_64 and the 64-bit
# lane multiply on aarch64. `allow = ["vector.scalarize"]` silences it, and so
# does `#[expect("vector.scalarize")]` on the function (#3788, #4065)
test scalarize__a_fallback_warns_once_at_its_site {
    val lib_text:   str = "pub fun f() i32 { ret 1; }\n";
    val main_div:   str = "fun kernel(a: i32x4, b: i32x4) i32x4 {\n    ret a / b;\n}\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n";
    val main_mul:   str = "fun kernel(a: i64x2, b: i64x2) i64x2 {\n    ret a * b;\n}\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n";
    val div_expect: str = "#[expect(\"vector.scalarize\")]\nfun kernel(a: i32x4, b: i32x4) i32x4 {\n    ret a / b;\n}\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n";
    val div_text:   str = "vector divide on 4 lanes of 32-bit integers in 'ctallow.main.kernel' scalarizes on x86_64: no packed form for it at any extension";
    val mul_text:   str = "vector multiply on 2 lanes of 64-bit integers in 'ctallow.main.kernel' scalarizes on aarch64: no packed form for it at any extension";
    if (t_allowed_warnings(T_X86_64, "", main_div, lib_text, "scalarizes on") != 1)                                 { ret 1; }
    if (t_allowed_warnings(T_X86_64, "", main_div, lib_text, div_text) != 1)                                        { ret 2; }
    if (t_allowed_warnings(T_X86_64, "allow = [\"vector.scalarize\"]\n", main_div, lib_text, "scalarizes on") != 0) { ret 3; }
    if (t_allowed_warnings(T_AARCH64, "", main_mul, lib_text, "scalarizes on") != 1)                                { ret 4; }
    if (t_allowed_warnings(T_AARCH64, "", main_mul, lib_text, mul_text) != 1)                                       { ret 5; }
    if (t_allowed_warnings(T_AARCH64, "allow = [\"vector\"]\n", main_mul, lib_text, "scalarizes on") != 0)          { ret 6; }
    if (t_allowed_warnings(T_X86_64, "", div_expect, lib_text, "scalarizes on") != 0)                               { ret 7; }
    ret 0;
}

# a declared extension moves the lowering, not the legality: the same kernel
# under `extensions = ["sse41"]` passes the require judgement and its text
# carries pmulld (66 0F 38 40), which the baseline object never holds: there
# the same cell is the pmuludq sequence (#3737, #3739)
#[testing]
fun t_text_has_pmulld(p: *project.Project) bool {
    var mid: u32 = 0;
    for (mid < project.module_count(p)) {
        val m: *project.ModuleEntry = project.module_at(p, mid);
        if (m.object_image != nil) {
            var si: u32 = 0;
            for (si < m.object_image.section_count) {
                val sec: *target_of.Section = ?m.object_image.sections[si];
                var i:   u32                = 0;
                for (i + 4 < sec.len) {
                    if (sec.bytes[i] == 0x66 && sec.bytes[i + 1] == 0x0F && sec.bytes[i + 2] == 0x38 && sec.bytes[i + 3] == 0x40)                                      { ret true; }
                    if (sec.bytes[i] == 0x66 && (sec.bytes[i + 1] & 0xF0) == 0x40 && sec.bytes[i + 2] == 0x0F && sec.bytes[i + 3] == 0x38 && sec.bytes[i + 4] == 0x40) { ret true; }
                    i = i + 1;
                }
                si = si + 1;
            }
        }
        mid = mid + 1;
    }
    ret false;
}

test simd_require__a_declared_extension_lowers_the_cell_packed {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }

    val manifest_text: str = "[project]\nmach = \">=5\"\nid = \"ctsimd\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.linux]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\nextensions = [\"sse41\"]\n\n[profile.debug]\ndefault = true\nopt = 0\ndebug = false\nsimd = \"require\"\nvectorize = false\nfloat_reassoc = false\n\n[artifact.ctsimd]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/ctsimd\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
    val source_text:   str = "fun kernel(a: u32x4, b: u32x4) u32x4 {\n    ret a * b;\n}\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n";

    val root_r: res[str, fail.Fail] = t_scaffold(?a, manifest_text, source_text);
    if (sel root_r.err) { ret 2; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?a, root); }

    val session_r: res[session.Session, fail.Fail] = session.init(?a);
    if (sel session_r.err) { ret 3; }
    var s: session.Session = session_r.ok;
    fin { session.dnit(?s); }
    val registered: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel registered.err) { ret 4; }

    var pick: manifest.Selection;
    pick.target       = "linux";
    pick.profile      = "";
    pick.artifact     = "";
    pick.want_lib     = false;
    pick.has_artifact = false;
    var req: request.BuildRequest = request.defaults();
    req.project_root = root;
    req.simd         = manifest.SIMD_REQUIRE;
    req.vectorize    = false;
    val project_r: res[project.Project, outcome.Fail] = driver.build_project_sel_req(?s, root, ?pick, ?req);
    if (sel project_r.err) { ret 5; }
    var p: project.Project = project_r.ok;
    fin { project.dnit_project(?p); }

    val checked: err[outcome.Fail] = driver.run_sema_pass(?p);
    if (sel checked.err) { ret 6; }
    val lowered: err[outcome.Fail] = driver.run_lower_pass(?p);
    if (sel lowered.err) { ret 7; }
    val generated: err[outcome.Fail] = driver.run_codegen_pass(?p);
    if (sel generated.err)      { ret 8; }
    if (!t_text_has_pmulld(?p)) { ret 9; }
    ret 0;
}

# a string value's logical text, decoded into `buf` and terminated; nil when
# the value is not a string or does not fit
#[testing]
fun t_text(v: *json.Value, buf: *u8, cap: usize) str {
    if (!json.value_is_string(v)) { ret nil; }
    val n: res[usize, json.JsonError] = json.value_string_decode(v, buf, cap - 1);
    if (sel n.err)   { ret nil; }
    if (n.ok >= cap) { ret nil; }
    buf[n.ok] = 0;
    ret buf::str;
}

#[testing]
fun t_member(o: *json.Value, key: str) *json.Value {
    val found: opt[*json.Value] = json.value_find(o, key);
    if (sel found.none) { ret nil; }
    ret found.some;
}

#[testing]
fun t_int_at_least(o: *json.Value, key: str, least: i64) bool {
    val v: *json.Value = t_member(o, key);
    ret v != nil && json.value_is_number(v) && !json.value_is_float(v) && json.value_number(v) >= least;
}

#[testing]
fun t_is_string(o: *json.Value, key: str) bool {
    val v: *json.Value = t_member(o, key);
    ret v != nil && json.value_is_string(v);
}

#[testing]
fun t_is_one_of(o: *json.Value, key: str, names: *str, n: usize) bool {
    var buf: [64]u8;
    val v:   *json.Value = t_member(o, key);
    if (v == nil) { ret false; }
    val text: str = t_text(v, ?buf[0], 64);
    if (text == nil) { ret false; }
    var i: usize = 0;
    for (i < n) {
        if (str_equals(text, names[i])) { ret true; }
        i = i + 1;
    }
    ret false;
}

# a span as the schema documents it: a non-empty file, 1-based positions whose
# end is not before the start, and byte offsets in the same order
#[testing]
fun t_valid_span(o: *json.Value) bool {
    if (o == nil || !json.value_is_object(o)) { ret false; }
    val file: *json.Value = t_member(o, "file");
    if (file == nil || !json.value_is_string(file) || file.str_len == 0) { ret false; }
    if (!t_int_at_least(o, "line", 1) || !t_int_at_least(o, "column", 1)
        || !t_int_at_least(o, "end_line", 1) || !t_int_at_least(o, "end_column", 1)
        || !t_int_at_least(o, "byte_start", 0) || !t_int_at_least(o, "byte_end", 0)) { ret false; }
    val line:     i64 = json.value_number(t_member(o, "line"));
    val end_line: i64 = json.value_number(t_member(o, "end_line"));
    if (end_line < line)                                                                                             { ret false; }
    if (end_line == line && json.value_number(t_member(o, "end_column")) < json.value_number(t_member(o, "column"))) { ret false; }
    ret json.value_number(t_member(o, "byte_end")) >= json.value_number(t_member(o, "byte_start"));
}

#[testing]
fun t_string_array(o: *json.Value, key: str) bool {
    val v: *json.Value = t_member(o, key);
    if (v == nil || !json.value_is_array(v)) { ret false; }
    var i: usize = 0;
    for (i < json.value_count(v)) {
        if (!json.value_is_string(?v.children[i])) { ret false; }
        i = i + 1;
    }
    ret true;
}

#[testing]
val T_SEVERITIES: [3]str = [3]str{"error", "warning", "note"};

#[testing]
val T_ORIGINS: [8]str = [8]str{"build", "load", "resolve", "sema", "lower", "codegen", "link", "test"};

# the record type a json line names; nil when it names none
#[testing]
fun t_record_kind(r: *json.Value, buf: *u8, cap: usize) str {
    val kind: *json.Value = t_member(r, "record");
    if (kind == nil) { ret nil; }
    ret t_text(kind, buf, cap);
}

# a diagnostic or failure record as doc/language/diagnostics-json.md documents it
#[testing]
fun t_valid_record(r: *json.Value) bool {
    if (!json.value_is_object(r)) { ret false; }
    val schema: *json.Value = t_member(r, "schema");
    if (schema == nil || !json.value_is_number(schema) || json.value_number(schema) != SCHEMA_VERSION) { ret false; }
    var buf:  [64]u8;
    val kind: str = t_record_kind(r, ?buf[0], 64);
    if (kind == nil) { ret false; }
    val failure: bool = str_equals(kind, "failure");
    if (!failure && !str_equals(kind, "diagnostic"))                                 { ret false; }
    if (!t_is_one_of(r, "severity", ?T_SEVERITIES[0], 3))                            { ret false; }
    if (!t_is_string(r, "code") || !t_is_string(r, "message"))                       { ret false; }
    if (t_member(r, "origin") != nil && !t_is_one_of(r, "origin", ?T_ORIGINS[0], 8)) { ret false; }
    val primary: *json.Value = t_member(r, "primary");
    if (primary == nil || (!json.value_is_null(primary) && !t_valid_span(primary))) { ret false; }
    val related: *json.Value = t_member(r, "related");
    if (related == nil || !json.value_is_array(related)) { ret false; }
    var i: usize = 0;
    for (i < json.value_count(related)) {
        val rel:   *json.Value = ?related.children[i];
        val label: *json.Value = t_member(rel, "label");
        if (!t_valid_span(rel) || label == nil || (!json.value_is_null(label) && !json.value_is_string(label))) { ret false; }
        i = i + 1;
    }
    if (!t_string_array(r, "notes") || !t_string_array(r, "help")) { ret false; }
    val fixes: *json.Value = t_member(r, "fixes");
    if (fixes == nil || !json.value_is_array(fixes)) { ret false; }
    i = 0;
    for (i < json.value_count(fixes)) {
        val fx:    *json.Value = ?fixes.children[i];
        val edits: *json.Value = t_member(fx, "edits");
        if (!t_is_string(fx, "label") || edits == nil || !json.value_is_array(edits)) { ret false; }
        var e: usize = 0;
        for (e < json.value_count(edits)) {
            if (!t_valid_span(?edits.children[e]) || !t_is_string(?edits.children[e], "replacement")) { ret false; }
            e = e + 1;
        }
        i = i + 1;
    }
    ret true;
}

# one line of a rendering: its bytes and where the next line starts
#[testing]
rec TLine {
    at:   usize;
    len:  usize;
    next: usize;
}

#[testing]
fun t_line(s: *MemSink, at: usize) TLine {
    var l: TLine;
    l.at = at;
    var i: usize = at;
    for (i < s.len && s.buf[i] != '\n') { i = i + 1; }
    l.len  = i - at;
    l.next = i + 1;
    ret l;
}

#[testing]
fun t_line_is(s: *MemSink, l: TLine, want: str) bool {
    ret l.len == str_len(want) && sink_match_at(s, l.at, want, l.len);
}

# the text after `marker` on a line, as a terminated copy; nil when the line
# does not hold it
#[testing]
fun t_after(a: *A.Allocator, s: *MemSink, l: TLine, marker: str) str {
    val ml: usize = str_len(marker);
    var i:  usize = l.at;
    for (i + ml <= l.at + l.len) {
        if (sink_match_at(s, i, marker, ml)) {
            val n:   usize             = l.at + l.len - i - ml;
            val buf: res[*u8, A.Error] = A.allocate[u8](a, n + 1);
            if (sel buf.err) { ret nil; }
            var j: usize = 0;
            for (j < n) {
                buf.ok[j] = s.buf[i + ml + j];
                j         = j + 1;
            }
            buf.ok[n] = 0;
            ret buf.ok::str;
        }
        i = i + 1;
    }
    ret nil;
}

#[testing]
fun t_is_headline(s: *MemSink, l: TLine) bool {
    ret sink_match_at(s, l.at, "error[", 6) || sink_match_at(s, l.at, "warning[", 8);
}

# the lines of one diagnostic's human rendering that carry `marker`, in
# order, against the record's strings in `want`
#[testing]
fun t_lines_match(a: *A.Allocator, s: *MemSink, from: usize, to: usize, marker: str, want: *Vector[str]) bool {
    var n:  usize = 0;
    var at: usize = from;
    for (at < to) {
        val l:    TLine = t_line(s, at);
        val text: str   = t_after(a, s, l, marker);
        if (text != nil) {
            if (n >= want.len || !str_equals(text, want.data[n])) { ret false; }
            n = n + 1;
        }
        at = l.next;
    }
    ret n == want.len;
}

#[testing]
fun t_push_text(a: *A.Allocator, into: *Vector[str], v: *json.Value) bool {
    var buf:  [1024]u8;
    val text: str = t_text(v, ?buf[0], 1024);
    if (text == nil) { ret false; }
    val kept: res[str, A.Error] = str_dup(a, text);
    if (sel kept.err) { ret false; }
    val pushed: res[usize, A.Error] = collections_vector.push[str](into, kept.ok);
    ret sel pushed.ok;
}

# `<root>/<file>:<line>:<column>`, the location the text renders for a span
#[testing]
fun t_push_loc(a: *A.Allocator, into: *Vector[str], root: str, span: *json.Value) bool {
    var buf:  [1024]u8;
    val file: str                           = t_text(t_member(span, "file"), ?buf[0], 1024);
    val full: res[types_path.Path, A.Error] = types_path.join(a, root, file);
    if (sel full.err) { ret false; }
    val loc: res[str, std_format.FormatError] = std_format.sprint(a, "{}:{}:{}", full.ok, json.value_number(t_member(span, "line")), json.value_number(t_member(span, "column")));
    if (sel loc.err) { ret false; }
    val pushed: res[usize, A.Error] = collections_vector.push[str](into, loc.ok);
    ret sel pushed.ok;
}

# one record against the human rendering of the same diagnostic, lines
# [from, to): the headline, every location in order, the notes, help and fix
# labels, and each related label beside its frame
#[testing]
fun t_record_matches(a: *A.Allocator, s: *MemSink, from: usize, to: usize, root: str, r: *json.Value) bool {
    var sev_buf:  [16]u8;
    var code_buf: [128]u8;
    var msg_buf:  [1024]u8;
    val headline: res[str, std_format.FormatError] = std_format.sprint(a, "{}[{}]: {}",
        t_text(t_member(r, "severity"), ?sev_buf[0], 16),
        t_text(t_member(r, "code"), ?code_buf[0], 128),
        t_text(t_member(r, "message"), ?msg_buf[0], 1024));
    if (sel headline.err)                            { ret false; }
    if (!t_line_is(s, t_line(s, from), headline.ok)) { ret false; }

    var locs:    Vector[str] = collections_vector.init[str](a);
    val primary: *json.Value = t_member(r, "primary");
    if (!json.value_is_null(primary) && !t_push_loc(a, ?locs, root, primary)) { ret false; }
    val related: *json.Value = t_member(r, "related");
    var i:       usize       = 0;
    for (i < json.value_count(related)) {
        val rel: *json.Value = ?related.children[i];
        if (!t_push_loc(a, ?locs, root, rel)) { ret false; }
        val label: *json.Value = t_member(rel, "label");
        if (json.value_is_string(label)) {
            var lb:    [1024]u8;
            val shown: res[str, std_format.FormatError] = std_format.sprint(a, " {}\n", t_text(label, ?lb[0], 1024));
            if (sel shown.err) { ret false; }
            var j:    usize = from;
            var seen: bool  = false;
            for (j + str_len(shown.ok) <= to && !seen) {
                seen = sink_match_at(s, j, shown.ok, str_len(shown.ok));
                j    = j + 1;
            }
            if (!seen) { ret false; }
        }
        i = i + 1;
    }
    var fix_labels: Vector[str] = collections_vector.init[str](a);
    val fixes:      *json.Value = t_member(r, "fixes");
    i = 0;
    for (i < json.value_count(fixes)) {
        val fx: *json.Value = ?fixes.children[i];
        if (!t_push_text(a, ?fix_labels, t_member(fx, "label"))) { ret false; }
        val edits: *json.Value = t_member(fx, "edits");
        var e:     usize       = 0;
        for (e < json.value_count(edits)) {
            if (!t_push_loc(a, ?locs, root, ?edits.children[e])) { ret false; }
            e = e + 1;
        }
        i = i + 1;
    }
    var notes: Vector[str] = collections_vector.init[str](a);
    var help:  Vector[str] = collections_vector.init[str](a);
    val nv:    *json.Value = t_member(r, "notes");
    val hv:    *json.Value = t_member(r, "help");
    i = 0;
    for (i < json.value_count(nv)) {
        if (!t_push_text(a, ?notes, ?nv.children[i])) { ret false; }
        i = i + 1;
    }
    i = 0;
    for (i < json.value_count(hv)) {
        if (!t_push_text(a, ?help, ?hv.children[i])) { ret false; }
        i = i + 1;
    }
    ret t_lines_match(a, s, from, to, "--> ", ?locs) && t_lines_match(a, s, from, to, "= note: ", ?notes)
        && t_lines_match(a, s, from, to, "= help: ", ?help) && t_lines_match(a, s, from, to, "= fix: ", ?fix_labels);
}

# a record whose primary spans lines and whose related site is another file
#[testing]
fun t_spans_lines_and_files(r: *json.Value) bool {
    val primary: *json.Value = t_member(r, "primary");
    val related: *json.Value = t_member(r, "related");
    if (json.value_is_null(primary) || json.value_count(related) == 0)                                    { ret false; }
    if (json.value_number(t_member(primary, "end_line")) <= json.value_number(t_member(primary, "line"))) { ret false; }
    var pb: [256]u8;
    var rb: [256]u8;
    ret !str_equals(t_text(t_member(primary, "file"), ?pb[0], 256), t_text(t_member(?related.children[0], "file"), ?rb[0], 256));
}

# the scratch project's manifest, its `[project].mach` range `range`
#[testing]
fun t_parity_manifest(a: *A.Allocator, range: str) str {
    ret t_cat(a, "[project]\nmach = \"", range, "\"\nid = \"par\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.linux]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[profile.debug]\ndefault = true\nopt = 0\ndebug = false\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n\n[artifact.par]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/par\"\ntargets = [\"*\"]\nlink = []\nneed = []\n");
}

# a failure record whose primary points into the project's manifest
#[testing]
fun t_located_failure(r: *json.Value) bool {
    var kbuf: [16]u8;
    val kind: str = t_record_kind(r, ?kbuf[0], 16);
    if (kind == nil || !str_equals(kind, "failure")) { ret false; }
    val primary: *json.Value = t_member(r, "primary");
    if (primary == nil || json.value_is_null(primary)) { ret false; }
    var fbuf: [64]u8;
    val file: str = t_text(t_member(primary, "file"), ?fbuf[0], 64);
    ret file != nil && str_equals(file, "mach.toml");
}

# check a scratch project whose manifest states the compiler range `range`
# through type checking, record the project's failure when it has one, add a
# link failure recorded outside every store, render the outcome both ways, and
# hold the records to the text: as many records as headlines, each valid under
# the schema and matching its diagnostic's or failure's text, then one summary
# record whose counts are those records' severities and match the text's
# tally. `want` is the count of records before the link failure's; with
# `spans` one record must span lines and files, and with `located` a failure
# record must point into the manifest. 0 on a match, otherwise the step that
# failed
#[testing]
fun t_parity(range: str, main_text: str, lib_text: str, want: usize, spans: bool, located: bool) i32 {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val manifest_text: str                 = t_parity_manifest(?a, range);
    val root_r:        res[str, fail.Fail] = t_scaffold(?a, manifest_text, main_text);
    if (sel root_r.err) { ret 2; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?a, root); }
    val lib_path_r: res[str, A.Error] = types_path.join(?a, root, "src/lib.mach");
    if (sel lib_path_r.err) { ret 2; }
    val wrote_lib: err[fs.FsError] = fs.write_bytes(lib_path_r.ok, lib_text::*u8, str_len(lib_text), 0o644);
    if (sel wrote_lib.err) { ret 2; }

    val session_r: res[session.Session, fail.Fail] = session.init(?a);
    if (sel session_r.err) { ret 3; }
    var s: session.Session = session_r.ok;
    fin { session.dnit(?s); }
    val registered: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel registered.err) { ret 3; }
    var pick: manifest.Selection;
    pick.target       = "linux";
    pick.profile      = "";
    pick.artifact     = "";
    pick.want_lib     = false;
    pick.has_artifact = false;
    val project_r: res[project.Project, outcome.Fail] = driver.build_project(?s, root, ?pick);
    if (sel project_r.ok) {
        var p: project.Project = project_r.ok;
        driver.run_sema_pass(?p);
        project.dnit_project(?p);
    }

    var bo: outcome.BuildOutcome = outcome.outcome_init(?a);
    fin { outcome.outcome_dnit(?bo); }
    val recorded: err[outcome.Fail] = outcome.record_diagnostics(?bo, ?s.sources, ?s.diags);
    if (sel recorded.err) { ret 4; }
    if (sel project_r.err) {
        var project_fail: outcome.Fail = project_r.err;
        if (lang_alloc.refused(outcome.record_fail(?bo, ?project_fail, diagnostic.ORIGIN_BUILD))) { ret 4; }
        outcome.fold_fail(?bo, ?project_fail);
    }
    var link_fail: outcome.Fail = outcome.user(diagnostic_kind.LINK_ENTRY_MISSING, "entry symbol '_start' is not defined");
    if (lang_alloc.refused(outcome.record_fail(?bo, ?link_fail, diagnostic.ORIGIN_LINK))) { ret 4; }
    outcome.fold_fail(?bo, ?link_fail);

    var hbuf:  [16384]u8;
    var hsink: MemSink;
    var hw:    io_writer.Writer;
    mem_writer(?hw, ?hsink, ?hbuf[0], 16384);
    render_outcome_w(?hw, ?bo, false);
    var jbuf:  [16384]u8;
    var jsink: MemSink;
    var rep:   Report;
    report_init(?rep, FORMAT_JSON);
    mem_writer(?rep.w, ?jsink, ?jbuf[0], 16384);
    rep.root = root;
    report_outcome(?rep, ?bo, false);
    val code: i64 = report_close(?rep, outcome_code_w(?hw, ?bo));
    if (hsink.len >= 16384 || jsink.len >= 16384) { ret 5; }

    var records: usize = 0;
    var errors:  i64   = 0;
    var warns:   i64   = 0;
    var spanned: bool  = false;
    var placed:  bool  = false;
    var summed:  bool  = false;
    var jat:     usize = 0;
    var hat:     usize = 0;
    for (jat < jsink.len) {
        val jl: TLine                           = t_line(?jsink, jat);
        val pr: res[json.Value, json.JsonError] = json.parse(?jsink.buf[jl.at], jl.len, ?a);
        if (sel pr.err) { ret 6; }
        var r:    json.Value = pr.ok;
        var kbuf: [16]u8;
        val kind: str        = t_record_kind(?r, ?kbuf[0], 16);
        if (kind != nil && str_equals(kind, "summary")) {
            if (jl.next < jsink.len || !t_valid_summary(?r, errors, warns, code)) { ret 12; }
            var tbuf:  [64]u8;
            var tsink: MemSink;
            var tw:    io_writer.Writer;
            mem_writer(?tw, ?tsink, ?tbuf[0], 64);
            emit_summary(?tw, errors::usize, warns::usize);
            if (!sink_match_at(?hsink, hsink.len - tsink.len, (?tbuf[0])::str, tsink.len)) { ret 13; }
            summed = true;
            jat    = jl.next;
            cnt;
        }
        if (!t_valid_record(?r)) { ret 7; }
        var sbuf: [16]u8;
        if (str_equals(t_text(t_member(?r, "severity"), ?sbuf[0], 16), "warning")) { warns = warns + 1; }
        or                                                                         { errors = errors + 1; }
        if (spans && t_spans_lines_and_files(?r))                                  { spanned = true; }
        if (located && t_located_failure(?r))                                      { placed = true; }

        for (hat < hsink.len && !t_is_headline(?hsink, t_line(?hsink, hat))) { hat = t_line(?hsink, hat).next; }
        if (hat >= hsink.len) { ret 8; }
        var end: usize = t_line(?hsink, hat).next;
        for (end < hsink.len && !t_is_headline(?hsink, t_line(?hsink, end))) { end = t_line(?hsink, end).next; }
        if (!t_record_matches(?a, ?hsink, hat, end, root, ?r)) { ret (20 + records)::i32; }
        hat     = end;
        records = records + 1;
        jat     = jl.next;
    }
    if (records != want + 1) { ret 9; }
    if (hat < hsink.len)     { ret 10; }
    if (spans && !spanned)   { ret 11; }
    if (located && !placed)  { ret 15; }
    if (!summed)             { ret 14; }
    ret 0;
}

# a summary record as the schema documents it, closing a run of `errors` error
# and `warnings` warning records that exits with `code`
#[testing]
fun t_valid_summary(r: *json.Value, errors: i64, warnings: i64, code: i64) bool {
    val schema: *json.Value = t_member(r, "schema");
    if (schema == nil || json.value_number(schema) != SCHEMA_VERSION)                                { ret false; }
    if (!t_int_at_least(r, "errors", 0) || json.value_number(t_member(r, "errors")) != errors)       { ret false; }
    if (!t_int_at_least(r, "warnings", 0) || json.value_number(t_member(r, "warnings")) != warnings) { ret false; }
    if (!t_int_at_least(r, "notes", 0) || json.value_number(t_member(r, "notes")) != 0)              { ret false; }
    if (!t_int_at_least(r, "exit_code", 0) || json.value_number(t_member(r, "exit_code")) != code)   { ret false; }
    var buf:  [16]u8;
    var want: str = "failure";
    if (code == exit.OK) { want = "success"; }
    ret str_equals(t_text(t_member(r, "outcome"), ?buf[0], 16), want);
}

# a json run as a command wrote it: every line a record, the diagnostic and
# failure records valid under the schema, and the last line the one summary,
# whose counts are theirs and whose exit code is `code`. with `kind` some record
# of that type must name `key` as its code and come from `origin`
# ---
# ret: 0 when the run holds, otherwise the step that failed
#[testing]
pub fun t_json_run(s: *MemSink, code: i64, kind: str, key: str, origin: str) i32 {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    var errors: i64   = 0;
    var warns:  i64   = 0;
    var found:  bool  = kind == nil;
    var summed: bool  = false;
    var at:     usize = 0;
    for (at < s.len) {
        val l:  TLine                           = t_line(s, at);
        val pr: res[json.Value, json.JsonError] = json.parse(?s.buf[l.at], l.len, ?a);
        if (sel pr.err) { ret 2; }
        var r:    json.Value = pr.ok;
        var kbuf: [16]u8;
        val rk:   str        = t_record_kind(?r, ?kbuf[0], 16);
        if (rk == nil || summed) { ret 3; }
        if (str_equals(rk, "summary")) {
            if (!t_valid_summary(?r, errors, warns, code)) { ret 4; }
            summed = true;
        }
        or (!str_equals(rk, "test")) {
            if (!t_valid_record(?r)) { ret 5; }
            var sbuf: [16]u8;
            if (str_equals(t_text(t_member(?r, "severity"), ?sbuf[0], 16), "warning")) { warns = warns + 1; }
            or                                                                         { errors = errors + 1; }
        }
        if (kind != nil && str_equals(rk, kind)) {
            var cbuf: [128]u8;
            var obuf: [16]u8;
            val cv:   *json.Value = t_member(?r, "code");
            val ov:   *json.Value = t_member(?r, "origin");
            if (cv != nil && ov != nil && json.value_is_string(cv) && str_equals(t_text(cv, ?cbuf[0], 128), key)
                && str_equals(t_text(ov, ?obuf[0], 16), origin)) { found = true; }
        }
        at = l.next;
    }
    if (!summed) { ret 6; }
    if (!found)  { ret 7; }
    ret 0;
}

# every diagnostic the text renders is a record with the same severity, code,
# message, locations, labels, notes, help and fixes, and every record is valid
# under the schema: resolve errors carrying help and a fix beside an unused
# import warning, a generic instance's type error whose primary spans two
# lines with its related site in the other file (#3793), and a manifest
# failure pointing at the range in mach.toml that caused it (#3607)
test json__records_match_the_human_rendering {
    val resolve_main: str = "use par.lib.helper;\nuse par.lib.nope;\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 {\n    val x: i32 = helpr(1);\n    ret 0;\n}\n";
    val resolve_lib:  str = "pub fun helper(x: i32) i32 { ret x; }\n";
    val code_a:       i32 = t_parity(">=5", resolve_main, resolve_lib, 3, false, false);
    if (code_a != 0) { ret code_a; }
    val sema_main: str = "use par.lib.g;\nuse par.lib.R;\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 {\n    var r: R;\n    val s: R = g[R](\n        r);\n    ret 0;\n}\n";
    val sema_lib:  str = "pub rec R { a: i32; }\npub fun g[T](x: T) T {\n    ret x + 1;\n}\n";
    val code_b:    i32 = t_parity(">=5", sema_main, sema_lib, 1, true, false);
    if (code_b != 0) { ret 100 + code_b; }
    val code_c: i32 = t_parity("^x", resolve_main, resolve_lib, 1, false, true);
    if (code_c != 0) { ret 200 + code_c; }
    ret 0;
}
