val MAX_SPAN_LINES: usize = 10;

val EXCERPT_WIDTH: usize = 120;
val EXCERPT_LEAD:  usize = 40;
val EXCERPT_MARK:  str   = "...";

rec Excerpt {
    start:     usize;
    end:       usize;
    cut_left:  bool;
    cut_right: bool;
}

rec MarkRange {
    from: usize;
    to:   usize;
}

fun mark_range(b: lang_source.Span, off: usize, end: usize) MarkRange {
    val bs: usize = b.offset;
    val be: usize = lang_source.span_end(b);
    var r:  MarkRange;
    r.from = bs;
    if (off > bs && off <= be) { r.from = off; }
    r.to = be;
    if (end >= bs && end <= be) { r.to = end; }
    if (r.to < r.from)          { r.to = r.from; }
    ret r;
}

fun excerpt_of(b: lang_source.Span, m: MarkRange) Excerpt {
    val bs: usize = b.offset;
    val be: usize = lang_source.span_end(b);
    var x:  Excerpt;
    x.start     = bs;
    x.end       = be;
    x.cut_left  = false;
    x.cut_right = false;
    if (be - bs <= EXCERPT_WIDTH) { ret x; }
    var ws: usize = bs;
    if (m.from > bs + EXCERPT_LEAD) { ws = m.from - EXCERPT_LEAD; }
    var we: usize = ws + EXCERPT_WIDTH;
    if (we > be) {
        we = be;
        if (we - bs > EXCERPT_WIDTH) { ws = we - EXCERPT_WIDTH; }
        or                           { ws = bs; }
    }
    x.start     = ws;
    x.end       = we;
    x.cut_left  = ws > bs;
    x.cut_right = we < be;
    ret x;
}

# render every diagnostic of a store to a writer, then an "N errors / M warnings" line
# ---
# out:  the destination
# s:    the session whose SourceMap locates each diagnostic
# list: the diagnostics, rendered in order; nothing is written when it is empty
pub fun flush(out: *io_writer.Writer, s: *session.Session, list: *diagnostic.DiagnosticStore) {
    flush_sources(out, ?s.sources, list);
}

# render every diagnostic of a store to a writer, then an "N errors / M warnings" line
# ---
# out:     the destination
# sources: the SourceMap that locates each diagnostic
# list:    the diagnostics, rendered in order; nothing is written when it is empty
pub fun flush_sources(out: *io_writer.Writer, sources: *lang_source.SourceMap, list: *diagnostic.DiagnosticStore) {
    var tally: Tally;
    render_store(out, sources, list, ?tally);
    if (tally.rendered > 0) {
        std_format.write_str(out, "\n");
        emit_summary(out, tally.errors, tally.warnings);
    }
}

# what one summary line stands for: every error and warning rendered above it,
# whichever store or failure record it came from
rec Tally {
    errors:   usize;
    warnings: usize;
    rendered: usize;
}

fun render_store(out: *io_writer.Writer, sources: *lang_source.SourceMap, list: *diagnostic.DiagnosticStore, tally: *Tally) {
    val total: usize = diagnostic.len(list);
    var i:     usize = 0;
    for (i < total) {
        val d: *diagnostic.Diagnostic = ?list.items.data[i];

        if (i > 0) { std_format.write_str(out, "\n"); }
        render(out, sources, d);

        if (diagnostic.is_error(d)) { tally.errors = tally.errors + 1; }
        or                          { tally.warnings = tally.warnings + 1; }

        i = i + 1;
    }
    tally.rendered = tally.rendered + total;
}

rec Frame {
    sf:     *lang_source.SourceFile;
    off:    usize;
    end:    usize;
    line_s: usize;
    line_e: usize;
    col_s:  usize;
}

fun locate(sources: *lang_source.SourceMap, loc: lang_source.Location) opt[Frame] {
    val opt_file: opt[*lang_source.SourceFile] = lang_source.get(sources, loc.file);
    if (sel opt_file.none) { ret opt[Frame].none{}; }
    val sf: *lang_source.SourceFile = opt_file.some;

    val text_len: usize = str_len(sf.text);

    var off: usize = loc.span.offset;
    if (off > text_len) { off = text_len; }
    var end: usize = loc.span.offset + loc.span.len;
    if (end > text_len) { end = text_len; }
    if (end < off)      { end = off; }

    val start_pos: lang_source.Position = lang_source.position(sf, off);
    var last:      usize                = off;
    if (end > off) { last = end - 1; }
    val end_pos: lang_source.Position = lang_source.position(sf, last);

    var f: Frame;
    f.sf     = sf;
    f.off    = off;
    f.end    = end;
    f.line_s = start_pos.line;
    f.line_e = end_pos.line;
    f.col_s  = start_pos.col;
    ret opt[Frame].some{f};
}

fun render(out: *io_writer.Writer, sources: *lang_source.SourceMap, d: *diagnostic.Diagnostic) {
    emit_headline(out, d.kind, d.message);

    val opt_pf: opt[Frame] = locate(sources, d.loc);
    val w:      usize      = gutter_width(sources, d, opt_pf);

    var framed: bool = false;
    if (sel opt_pf.some) {
        var pf: Frame = opt_pf.some;
        emit_frame(out, ?pf, w, "^", nil);
        framed = true;
    }

    var i: usize = 0;
    for (i < d.related.len) {
        val rel:    *diagnostic.Related = ?d.related.data[i];
        val opt_rf: opt[Frame]          = locate(sources, rel.loc);
        if (sel opt_rf.some) {
            if (framed) { emit_bar(out, w); }
            var rf: Frame = opt_rf.some;
            emit_frame(out, ?rf, w, "-", rel.label);
            framed = true;
        }
        i = i + 1;
    }

    emit_trailer(out, sources, d, framed, w);
}

fun gutter_width(sources: *lang_source.SourceMap, d: *diagnostic.Diagnostic, opt_pf: opt[Frame]) usize {
    var w: usize = 1;
    if (sel opt_pf.some) { w = decimal_width(opt_pf.some.line_e); }

    var i: usize = 0;
    for (i < d.related.len) {
        val opt_rf: opt[Frame] = locate(sources, d.related.data[i].loc);
        if (sel opt_rf.some) {
            val rw: usize = decimal_width(opt_rf.some.line_e);
            if (rw > w) { w = rw; }
        }
        i = i + 1;
    }
    ret w;
}

fun emit_frame(out: *io_writer.Writer, f: *Frame, w: usize, head: str, label: str) {
    emit_loc(out, w, f.sf.path, f.line_s, f.col_s);
    emit_bar(out, w);
    emit_snippet(out, f.sf, w, f.line_s, f.line_e, f.off, f.end, head, label);
}

fun emit_trailer(out: *io_writer.Writer, sources: *lang_source.SourceMap, d: *diagnostic.Diagnostic, framed: bool, w: usize) {
    if (!has_trailer(sources, d)) { ret; }

    var indent: usize = 2;
    if (framed) {
        emit_bar(out, w);
        indent = w + 1;
    }

    var i: usize = 0;
    for (i < d.related.len) {
        val rel:      *diagnostic.Related = ?d.related.data[i];
        val locate_r: opt[Frame]          = locate(sources, rel.loc);
        if (rel.label != nil && sel locate_r.none) {
            emit_tagged(out, "note", rel.label, indent);
        }
        i = i + 1;
    }

    var c: usize = 0;
    for (c < d.children.len) {
        val child: *diagnostic.Child = ?d.children.data[c];
        if (child.kind == diagnostic.CHILD_HELP) { emit_tagged(out, "help", child.text, indent); }
        or                                       { emit_tagged(out, "note", child.text, indent); }
        c = c + 1;
    }

    var f: usize = 0;
    for (f < d.fixes.len) {
        emit_fix(out, sources, w, ?d.fixes.data[f], indent);
        f = f + 1;
    }
}

fun emit_fix(out: *io_writer.Writer, sources: *lang_source.SourceMap, w: usize, fx: *diagnostic.Fix, indent: usize) {
    emit_tagged(out, "fix", fx.label, indent);
    var e: usize = 0;
    for (e < fx.edits.len) {
        val ed:     *diagnostic.Edit = ?fx.edits.data[e];
        val opt_ef: opt[Frame]       = locate(sources, ed.loc);
        if (sel opt_ef.some) {
            var ef: Frame = opt_ef.some;
            emit_loc(out, w, ef.sf.path, ef.line_s, ef.col_s);
        }
        emit_spaces(out, indent + 2);
        std_format.write_str(out, "-> replace with `");
        std_format.write_str(out, ed.replacement);
        std_format.write_str(out, "`\n");
        e = e + 1;
    }
}

fun has_trailer(sources: *lang_source.SourceMap, d: *diagnostic.Diagnostic) bool {
    if (d.children.len > 0 || d.fixes.len > 0) { ret true; }

    var i: usize = 0;
    for (i < d.related.len) {
        val locate_r: opt[Frame] = locate(sources, d.related.data[i].loc);
        if (d.related.data[i].label != nil && sel locate_r.none) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun emit_snippet(out: *io_writer.Writer, sf: *lang_source.SourceFile, w: usize, line_s: usize, line_e: usize, off: usize, end: usize, head: str, label: str) {
    if (line_e <= line_s) {
        emit_source_line(out, sf, w, line_s, off, end);
        emit_underline(out, sf, w, line_s, off, end, head, label);
        ret;
    }

    if (line_e - line_s + 1 <= MAX_SPAN_LINES) {
        var l: usize = line_s;
        for (l <= line_e) {
            emit_source_line(out, sf, w, l, off, end);
            if (l == line_s) { emit_underline(out, sf, w, l, off, end, head, nil); }
            or (l == line_e) { emit_underline(out, sf, w, l, off, end, "-", label); }
            or               { emit_underline(out, sf, w, l, off, end, "-", nil); }
            l = l + 1;
        }
        ret;
    }

    emit_source_line(out, sf, w, line_s, off, end);
    emit_underline(out, sf, w, line_s, off, end, head, nil);
    emit_elision(out, w);
    emit_source_line(out, sf, w, line_e, off, end);
    emit_underline(out, sf, w, line_e, off, end, "-", label);
}

fun emit_source_line(out: *io_writer.Writer, sf: *lang_source.SourceFile, w: usize, line: usize, off: usize, end: usize) {
    val opt_bounds: opt[lang_source.Span] = lang_source.line_bounds(sf, line);
    if (sel opt_bounds.none) { ret; }
    val b: lang_source.Span = opt_bounds.some;
    val x: Excerpt          = excerpt_of(b, mark_range(b, off, end));

    emit_gutter_num(out, w, line);
    if (x.cut_left) { std_format.write_str(out, EXCERPT_MARK); }
    if (x.end > x.start) {
        std_format.write_bytes(out, ?sf.text[x.start], x.end - x.start);
    }
    if (x.cut_right) { std_format.write_str(out, EXCERPT_MARK); }
    std_format.write_str(out, "\n");
}

fun emit_underline(out: *io_writer.Writer, sf: *lang_source.SourceFile, w: usize, line: usize, off: usize, end: usize, glyph: str, label: str) {
    val opt_bounds: opt[lang_source.Span] = lang_source.line_bounds(sf, line);
    if (sel opt_bounds.none) { ret; }
    val b:         lang_source.Span = opt_bounds.some;
    val m:         MarkRange        = mark_range(b, off, end);
    val x:         Excerpt          = excerpt_of(b, m);
    val mark_from: usize            = m.from;
    var mark_to:   usize            = m.to;
    if (mark_to > x.end) { mark_to = x.end; }

    emit_gutter_bar(out, w);

    if (x.cut_left) { emit_spaces(out, str_len(EXCERPT_MARK)); }
    var i: usize = x.start;
    for (i < mark_from) {
        if (sf.text[i] == '\t') { std_format.write_str(out, "\t"); }
        or                      { std_format.write_str(out, " "); }
        i = i + 1;
    }

    var n: usize = mark_to - mark_from;
    if (n == 0) { n = 1; }
    var j: usize = 0;
    for (j < n) {
        std_format.write_str(out, glyph);
        j = j + 1;
    }
    if (label != nil) {
        std_format.write_str(out, " ");
        std_format.write_str(out, label);
    }
    std_format.write_str(out, "\n");
}

fun emit_loc(out: *io_writer.Writer, w: usize, path: str, line: usize, col: usize) {
    emit_spaces(out, w);
    std_format.write_str(out, "--> ");
    std_format.write_str(out, path);
    std_format.write_str(out, ":");
    std_format.write_u64(out, line::u64);
    std_format.write_str(out, ":");
    std_format.write_u64(out, col::u64);
    std_format.write_str(out, "\n");
}

fun emit_bar(out: *io_writer.Writer, w: usize) {
    emit_spaces(out, w);
    std_format.write_str(out, " |\n");
}

fun emit_elision(out: *io_writer.Writer, w: usize) {
    emit_spaces(out, w);
    std_format.write_str(out, " | ...\n");
}

fun emit_gutter_num(out: *io_writer.Writer, w: usize, line: usize) {
    emit_spaces(out, w - decimal_width(line));
    std_format.write_u64(out, line::u64);
    std_format.write_str(out, " | ");
}

fun emit_gutter_bar(out: *io_writer.Writer, w: usize) {
    emit_spaces(out, w);
    std_format.write_str(out, " | ");
}

fun emit_tagged(out: *io_writer.Writer, tag: str, text: str, indent: usize) {
    emit_spaces(out, indent);
    std_format.write_str(out, "= ");
    std_format.write_str(out, tag);
    std_format.write_str(out, ": ");
    std_format.write_str(out, text);
    std_format.write_newline(out);
}

fun emit_summary(out: *io_writer.Writer, errors: usize, warnings: usize) {
    std_format.write_u64(out, errors::u64);
    if (errors == 1) { std_format.write_str(out, " error"); }
    or               { std_format.write_str(out, " errors"); }
    std_format.write_str(out, " / ");
    std_format.write_u64(out, warnings::u64);
    if (warnings == 1) { std_format.write_str(out, " warning"); }
    or                 { std_format.write_str(out, " warnings"); }
    std_format.write_str(out, "\n");
}

# the kind's severity, then its key where it names one: `warning[vector.scalarize]: `
fun emit_lead(out: *io_writer.Writer, k: diagnostic_kind.Kind) {
    std_format.write_str(out, severity_name(k));
    val key: str = diagnostic_kind.key_of(k);
    if (key != nil) {
        std_format.write_str(out, "[");
        std_format.write_str(out, key);
        std_format.write_str(out, "]");
    }
    std_format.write_str(out, ": ");
}

fun emit_headline(out: *io_writer.Writer, k: diagnostic_kind.Kind, message: str) {
    emit_lead(out, k);
    std_format.write_str(out, message);
    std_format.write_newline(out);
}

fun emit_spaces(out: *io_writer.Writer, n: usize) {
    var i: usize = 0;
    for (i < n) {
        std_format.write_str(out, " ");
        i = i + 1;
    }
}

fun decimal_width(n: usize) usize {
    var digits: [std_format.DECIMAL_MAX]u8;
    ret std_format.put_u64(?digits[0], n::u64);
}

# the severity a kind's row declares, as the headline and a record name it
fun severity_name(k: diagnostic_kind.Kind) str {
    if (diagnostic_kind.is_error(k)) { ret "error"; }
    ret "warning";
}

fun stderr_writer() io_writer.Writer {
    ret fs.writer(fs.STDERR);
}

fun render_fail_w(w: *io_writer.Writer, f: *fail.Fail) i64 {
    if (sel f.reported) { ret exit.of(@f); }
    emit_headline(w, fail.kind_of(@f), fail.describe(@f));
    val at: opt[fail.Place] = fail.place_of(@f);
    if (sel at.some) { emit_loc(w, 1, at.some.path, at.some.start.line, at.some.start.col); }
    val also: fail.Related = fail.related_of(@f);
    var i:    usize        = 0;
    for (i < also.count) {
        val rel: *fail.Place = ?also.items[i];
        if (rel.path != nil) { emit_loc(w, 1, rel.path, rel.start.line, rel.start.col); }
        i = i + 1;
    }
    val fixed: opt[fail.Fix] = fail.fix_of(@f);
    if (sel fixed.some) {
        val fx: fail.Fix = fixed.some;
        emit_tagged(w, "fix", fx.label, 1);
        if (fx.at.path != nil) { emit_loc(w, 1, fx.at.path, fx.at.start.line, fx.at.start.col); }
        emit_spaces(w, 3);
        std_format.write_str(w, "-> replace with `");
        std_format.write_str(w, fx.replacement);
        std_format.write_str(w, "`\n");
    }
    ret exit.of(@f);
}

# print a Fail to stderr as "error[<key>]: <message>", followed by the
# " --> <file>:<line>:<column>" it points at when it names one and one such
# line for each related place it names, and map it to an exit code
# a reported Fail prints nothing, its diagnostics having been rendered already
# ---
# f:   the Fail
# ret: the exit code `exit.of` maps the failure to
pub fun render_fail(f: *fail.Fail) i64 {
    var w: io_writer.Writer = stderr_writer();
    ret render_fail_w(?w, f);
}

# render_fail for a failure built in place
# ---
# f:   the Fail
# ret: the exit code `exit.of` maps the failure to
pub fun refuse(f: fail.Fail) i64 {
    ret render_fail(?f);
}

fun package_line(ctx: ptr, text: str) {
    print.printlnf("{}", text);
}

fun package_note(ctx: ptr, text: str) {
    print.eprintlnf("{}", text);
}

fun package_fault(ctx: ptr, f: fail.Fail) {
    var shown: fail.Fail = f;
    val code:  i64       = render_fail(?shown);
}

# where a dependency command reports: progress on standard output, and notes and failures
# the command goes on past on standard error
# ---
# a:   owns the report's effect notes
# ret: the report, released with `report.dnit`
pub fun dependency_report(a: *A.Allocator) report.Report {
    ret report.init(a, nil, package_line, package_note, package_fault);
}

# show how a dependency command ended: its failure, then a note for each change it made
# before failing
# ---
# rep:     the report the command used
# outcome: how it ended
# ret:     exit.OK, or the code `exit.of` maps the failure to
pub fun dependency_outcome(rep: *report.Report, outcome: err[fail.Fail]) i64 {
    if (sel outcome.ok) { ret exit.OK; }
    val code: i64   = refuse(outcome.err);
    var i:    usize = 0;
    for (i < rep.effects.len) {
        print.eprintlnf("{}", rep.effects.data[i]);
        i = i + 1;
    }
    ret code;
}

# map a build outcome's severity to the process exit code
# ---
# bo:  the outcome
# ret: the shared exit code of the severity; a severity outside the catalog
# is an internal failure written to `w` naming the catalog and the tag
fun outcome_code_w(w: *io_writer.Writer, bo: *outcome.BuildOutcome) i64 {
    if (bo.severity == outcome.BUILD_OK)          { ret exit.OK; }
    if (bo.severity == outcome.BUILD_USER)        { ret exit.USER; }
    if (bo.severity == outcome.BUILD_INTERNAL)    { ret exit.INTERNAL; }
    if (bo.severity == outcome.BUILD_ENVIRONMENT) { ret exit.ENVIRONMENT; }
    std_format.format(w, "error[{}]: unknown BuildSeverity tag {}\n", diagnostic_kind.key_of(diagnostic_kind.COMPILER_INTERNAL), bo.severity);
    ret exit.INTERNAL;
}

pub fun outcome_code(bo: *outcome.BuildOutcome) i64 {
    var w: io_writer.Writer = stderr_writer();
    ret outcome_code_w(?w, bo);
}

fun unit_banner_w(w: *io_writer.Writer, ev: *readout.Unit) {
    std_format.write_str(w, ev.verb);
    std_format.write_str(w, " ");
    std_format.write_str(w, ev.artifact);
    if (!str_empty(ev.target)) {
        std_format.write_str(w, " (");
        std_format.write_str(w, ev.target);
        std_format.write_str(w, ")");
    }
    std_format.write_str(w, "\n");
}

val DUR_CAP: usize = 24;

fun phase_row_w(w: *io_writer.Writer, ev: *readout.PhaseEnd) {
    var dbuf: [DUR_CAP]u8;
    val dstr: str = chrono_duration.format_duration(ev.elapsed, ?dbuf[0], DUR_CAP);
    var noun: str = ev.noun_many;
    if (ev.count == 1) { noun = ev.noun_one; }
    std_format.format(w, "{:<12} {:3} {:<8} {:7}", readout.label_of(ev.phase), ev.count::i64, noun, dstr);
    if (ev.workers > 1) { std_format.format(w, "  ({} threads)", ev.workers::i64); }
    if (ev.dropped > 0) { std_format.format(w, "  ({} target-gated, not carried forward)", ev.dropped::i64); }
    if (ev.slowest != nil) {
        var sbuf: [DUR_CAP]u8;
        val sstr: str = chrono_duration.format_duration(ev.slowest_elapsed, ?sbuf[0], DUR_CAP);
        std_format.format(w, "  (slowest {} {})", ev.slowest, sstr);
    }
    std_format.write_str(w, "\n");
}

fun item_row_w(w: *io_writer.Writer, ev: *readout.Item) {
    var dbuf: [DUR_CAP]u8;
    val dstr: str = chrono_duration.format_duration(ev.elapsed, ?dbuf[0], DUR_CAP);
    std_format.format(w, "  {:<12} {:<32} {:7}\n", readout.label_of(ev.phase), ev.name, dstr);
}

# a growing cycle of instances as it expands, so a runaway expansion shows while it runs
fun growth_row_w(w: *io_writer.Writer, ev: *readout.Growth) {
    var noun: str = "instances";
    if (ev.instances == 1) { noun = "instance"; }
    std_format.format(w, "  {:<12} growing cycle {} in {}: {} {} so far\n", "instantiate", ev.members, ev.module, ev.instances::usize, noun);
}

# split a byte count into the binary magnitude it reads best in and its unit
fun size_split(bytes: usize, unit: *str) i64 {
    val ki: usize = 1024;
    val mi: usize = ki * 1024;
    val gi: usize = mi * 1024;

    if (bytes < ki) {
        @unit = "B";
        ret bytes::i64;
    }
    if (bytes < mi) {
        @unit = "KiB";
        ret ((bytes + ki / 2) / ki)::i64;
    }
    if (bytes < gi) {
        @unit = "MiB";
        ret ((bytes + mi / 2) / mi)::i64;
    }
    @unit = "GiB";
    ret ((bytes + gi / 2) / gi)::i64;
}

fun summary_w(w: *io_writer.Writer, ev: *readout.Summary) {
    var obuf: [DUR_CAP]u8;
    val ostr: str = chrono_duration.format_duration(ev.other, ?obuf[0], DUR_CAP);
    std_format.format(w, "{:<12} {:<12} {:7}\n", "other", "-", ostr);

    var dbuf:  [DUR_CAP]u8;
    val dstr:  str = chrono_duration.format_duration(ev.total, ?dbuf[0], DUR_CAP);
    var mnoun: str = "modules";
    if (ev.modules == 1) { mnoun = "module"; }
    if (ev.has_size) {
        var unit: str = "B";
        val mag:  i64 = size_split(ev.bytes, ?unit);
        std_format.format(w, "built {}  {} {}  {} {}  in {}\n", ev.out, ev.modules::i64, mnoun, mag, unit, dstr);
    }
    or {
        std_format.format(w, "built {}  {} {}  in {}\n", ev.out, ev.modules::i64, mnoun, dstr);
    }
}

# every command's events rendered the moment each arrives: the renderer of the
# readout contract (doc/language/readout.md). the report's stream, stderr,
# carries the build: human text renders unit banners, phase rows, items, the
# unit summary, failures and diagnostics, and readout_close writes the closing
# tally; json renders each diagnostic and failure as a record, and under -v
# each unit, phase row, item and unit summary as unit, phase and phase_item
# records. stdout carries a test run in human text: each test as it finishes, a
# module's roll-up once its last test has, and the closing summary. under json the
# run is also records on the report's stream: run_start, a test record per
# finished test, and run_end
# ---
# sink:   what the engine and the test runner are given; its ctx is this record, which must not move
# r:      the command's report
# units:  the plan's unit count; a banner prints only when it is more than one
# quiet:  `--quiet`, which suppresses the banners
# tally:  the human tally, counted as the events pass
# out:    where a test run renders, stdout
# run:    the running test run's results, from its run_start to its run_end
# count:  how many results run holds
# mod_w:  the module column's width
# name_w: the test column's width
pub rec Readout {
    sink:   readout.Sink;
    r:      *Report;
    units:  usize;
    quiet:  bool;
    tally:  Tally;
    out:    io_writer.Writer;
    run:    *readout.TestResult;
    count:  u32;
    mod_w:  usize;
    name_w: usize;
}

# start rendering a command's events to r, a test run in human text to stdout
# ---
# rd:    the renderer, initialised in place since its sink points at it
# r:     the command's report
# units: the plan's unit count
# quiet: `--quiet`
# level: the readout level the command asked for, LEVEL_RESULTS to LEVEL_ITEMS
pub fun readout_init(rd: *Readout, r: *Report, units: usize, quiet: bool, level: u8) {
    rd.sink.ctx      = rd::ptr;
    rd.sink.on_event = readout_on_event;
    rd.sink.level    = level;
    rd.r             = r;
    rd.units         = units;
    rd.quiet         = quiet;
    rd.tally         = Tally{errors: 0, warnings: 0, rendered: 0};
    rd.out           = fs.writer(fs.STDOUT);
    rd.run           = nil;
    rd.count         = 0;
    rd.mod_w         = 0;
    rd.name_w        = 0;
}

fun readout_on_event(ctx: ptr, ev: *readout.Event) {
    val rd: *Readout = ctx::*Readout;
    if (sel ev.run_start) {
        run_begin(rd, ?ev.run_start);
        if (rd.r.format == FORMAT_JSON) { run_start_record(?rd.r.w, ?ev.run_start); }
        ret;
    }
    if (sel ev.test_end) {
        test_human(rd, ev.test_end.at);
        report_test(rd.r, ?ev.test_end.tests[ev.test_end.at]);
        ret;
    }
    if (sel ev.run_end) {
        run_summary_w(?rd.out, ?ev.run_end);
        if (rd.r.format == FORMAT_JSON) { run_end_record(?rd.r.w, ?ev.run_end); }
        rd.run   = nil;
        rd.count = 0;
        ret;
    }
    if (rd.r.format == FORMAT_JSON) { readout_json(rd, ev); }
    or                              { readout_human(rd, ev); }
}

fun readout_human(rd: *Readout, ev: *readout.Event) {
    val w: *io_writer.Writer = ?rd.r.w;
    if (sel ev.unit) {
        if (!rd.quiet && rd.units > 1) { unit_banner_w(w, ?ev.unit); }
    }
    or (sel ev.phase)   { phase_row_w(w, ?ev.phase); }
    or (sel ev.item)    { item_row_w(w, ?ev.item); }
    or (sel ev.growth)  { growth_row_w(w, ?ev.growth); }
    or (sel ev.summary) { summary_w(w, ?ev.summary); }
    or (sel ev.failure) {
        if (!sel ev.failure.fail.reported) {
            rd.tally.errors   = rd.tally.errors + 1;
            rd.tally.rendered = rd.tally.rendered + 1;
        }
        render_fail_w(w, ev.failure.fail);
    }
    or (sel ev.diagnostics) {
        render_store(w, ev.diagnostics.sources, ev.diagnostics.diags, ?rd.tally);
    }
}

# the json member: a record for each event the human text renders a line for,
# each written as its event arrives. under -v every unit opens with a unit
# record naming its artifact, target and profile, which the text shows only as
# a banner for several units and a header for several profiles
fun readout_json(rd: *Readout, ev: *readout.Event) {
    val r: *Report = rd.r;
    if (sel ev.failure) { report_failure(r, ev.failure.fail, ev.failure.origin); }
    or (sel ev.diagnostics) {
        render_store_json(r, ev.diagnostics.sources, ev.diagnostics.diags, report_paths(r));
    }
    or (sel ev.unit) {
        if (rd.sink.level >= readout.LEVEL_PHASES) { unit_record(?r.w, ?ev.unit); }
    }
    or (sel ev.phase)   { phase_record(?r.w, ?ev.phase); }
    or (sel ev.item)    { item_record(?r.w, ?ev.item); }
    or (sel ev.growth)  { growth_record(?r.w, ?ev.growth); }
    or (sel ev.summary) { summary_record(r, ?ev.summary); }
}

# close a plan's rendering: one summary line under human text closes every
# failure and diagnostic the plan rendered, a failure record printed as its own
# `error:` line (an encoder or rules refusal that reached no store) counted in it
# beside every store's diagnostics, so the tally never reads `0 errors` above a
# nonzero exit. json closes in report_close
pub fun readout_close(rd: *Readout) {
    if (rd.r.format == FORMAT_JSON || rd.tally.rendered == 0) { ret; }
    std_format.write_str(?rd.r.w, "\n");
    emit_summary(?rd.r.w, rd.tally.errors, rd.tally.warnings);
}

# a duration as the integer microseconds a record carries
fun micros(d: chrono_duration.Duration) i64 {
    ret chrono_duration.duration_nsec(d) / 1000;
}

fun unit_record(w: *io_writer.Writer, ev: *readout.Unit) {
    var o: json.Object;
    json.object_begin(w, ?o);
    json.field_i64(?o, "schema", SCHEMA_VERSION);
    json.field_str(?o, "record", "unit");
    json.field_str(?o, "verb", ev.verb);
    json.field_str(?o, "artifact", ev.artifact);
    if (!str_empty(ev.target))  { json.field_str(?o, "target", ev.target); }
    if (!str_empty(ev.profile)) { json.field_str(?o, "profile", ev.profile); }
    json.object_end(?o);
}

fun phase_record(w: *io_writer.Writer, ev: *readout.PhaseEnd) {
    var noun: str = ev.noun_many;
    if (ev.count == 1) { noun = ev.noun_one; }
    var o: json.Object;
    json.object_begin(w, ?o);
    json.field_i64(?o, "schema", SCHEMA_VERSION);
    json.field_str(?o, "record", "phase");
    json.field_str(?o, "name", readout.label_of(ev.phase));
    json.field_i64(?o, "count", ev.count::i64);
    json.field_str(?o, "unit", noun);
    json.field_i64(?o, "time_us", micros(ev.elapsed));
    if (ev.workers > 1) { json.field_i64(?o, "threads", ev.workers::i64); }
    if (ev.dropped > 0) { json.field_i64(?o, "dropped", ev.dropped::i64); }
    if (ev.slowest != nil) {
        json.field_str(?o, "slowest", ev.slowest);
        json.field_i64(?o, "slowest_us", micros(ev.slowest_elapsed));
    }
    json.object_end(?o);
}

fun item_record(w: *io_writer.Writer, ev: *readout.Item) {
    var o: json.Object;
    json.object_begin(w, ?o);
    json.field_i64(?o, "schema", SCHEMA_VERSION);
    json.field_str(?o, "record", "phase_item");
    json.field_str(?o, "phase", readout.label_of(ev.phase));
    json.field_str(?o, "name", ev.name);
    json.field_i64(?o, "time_us", micros(ev.elapsed));
    json.object_end(?o);
}

fun growth_record(w: *io_writer.Writer, ev: *readout.Growth) {
    var o: json.Object;
    json.object_begin(w, ?o);
    json.field_i64(?o, "schema", SCHEMA_VERSION);
    json.field_str(?o, "record", "growth");
    json.field_str(?o, "module", ev.module);
    json.field_str(?o, "members", ev.members);
    json.field_i64(?o, "instances", ev.instances::i64);
    json.object_end(?o);
}

# a unit's summary: its `other` row as a phase record without a count, and its
# `built` line kept for the closing summary record
fun summary_record(r: *Report, ev: *readout.Summary) {
    var o: json.Object;
    json.object_begin(?r.w, ?o);
    json.field_i64(?o, "schema", SCHEMA_VERSION);
    json.field_str(?o, "record", "phase");
    json.field_str(?o, "name", "other");
    json.field_i64(?o, "time_us", micros(ev.other));
    json.object_end(?o);
    report_built(r, ev);
}

# the column widths of a run's human rendering, from its tests' names
fun run_begin(rd: *Readout, ev: *readout.RunStart) {
    rd.run    = ev.tests;
    rd.count  = ev.count;
    rd.mod_w  = 0;
    rd.name_w = 0;
    var i: u32 = 0;
    for (i < ev.count) {
        val ml: usize = str_len(ev.tests[i].art.module);
        val nl: usize = str_len(ev.tests[i].art.name);
        if (ml > rd.mod_w)  { rd.mod_w = ml; }
        if (nl > rd.name_w) { rd.name_w = nl; }
        i = i + 1;
    }
    rd.mod_w  = clamp_width(rd.mod_w, 16, 48);
    rd.name_w = clamp_width(rd.name_w, 24, 72);
}

fun clamp_width(w: usize, least: usize, most: usize) usize {
    var c: usize = w;
    if (c < least) { c = least; }
    if (c > most)  { c = most; }
    ret c + 2;
}

# a finished test in human text, in the order the tests finish: under -v its own
# line, otherwise its module's roll-up once every test of the module's run has
# finished, so a slow test holds back only its own module
fun test_human(rd: *Readout, at: u32) {
    val w: *io_writer.Writer   = ?rd.out;
    val t: *readout.TestResult = ?rd.run[at];
    if (rd.sink.level >= readout.LEVEL_PHASES) {
        test_line_w(w, t, rd.name_w);
        ret;
    }
    val mod_name: str = t.art.module;
    var first:    u32 = at;
    for (first > 0 && str_equals(rd.run[first - 1].art.module, mod_name)) { first = first - 1; }
    var last: u32 = at;
    for (last + 1 < rd.count && str_equals(rd.run[last + 1].art.module, mod_name)) { last = last + 1; }
    var j: u32 = first;
    for (j <= last) {
        if (!rd.run[j].done) { ret; }
        j = j + 1;
    }
    module_run_w(w, rd.run, first, last, rd.mod_w);
}

fun module_run_w(w: *io_writer.Writer, tests: *readout.TestResult, first: u32, last: u32, mod_w: usize) {
    var ok:      u32                      = 0;
    var skipped: u32                      = 0;
    var failed:  u32                      = 0;
    var elapsed: chrono_duration.Duration = 0;
    var j:       u32                      = first;
    for (j <= last) {
        if (tests[j].result.kind == testrun.RESULT_PASS) { ok = ok + 1; }
        or (tests[j].result.kind == testrun.RESULT_SKIP) { skipped = skipped + 1; }
        or                                               { failed = failed + 1; }
        elapsed = elapsed + tests[j].elapsed;
        j       = j + 1;
    }
    col_w(w, tests[first].art.module, mod_w);
    std_format.format(w, "{:4} ok", ok::i64);
    if (skipped > 0) { std_format.format(w, "  {:4} skip", skipped::i64); }
    if (failed > 0)  { std_format.format(w, "  {:4} FAIL", failed::i64); }
    dur_w(w, elapsed);
    std_format.write_str(w, "\n");
    if (failed == 0) { ret; }
    j = first;
    for (j <= last) {
        val t: *readout.TestResult = ?tests[j];
        if (failure(?t.result)) {
            std_format.format(w, "  FAIL  {}  {}:{}  ", t.art.name, t.art.file, t.art.line::i64);
            reason_w(w, t);
            std_format.write_str(w, "\n");
            captured_w(w, t);
            pointers_w(w, t);
        }
        j = j + 1;
    }
}

fun test_line_w(w: *io_writer.Writer, t: *readout.TestResult, name_w: usize) {
    if (!failure(?t.result)) {
        if (t.result.kind == testrun.RESULT_SKIP) { std_format.write_str(w, "skip  "); }
        or                                        { std_format.write_str(w, "ok    "); }
        col_w(w, t.art.name, name_w);
        dur_w(w, t.elapsed);
        std_format.write_str(w, "\n");
        captured_w(w, t);
        ret;
    }
    std_format.write_str(w, "FAIL  ");
    col_w(w, t.art.name, name_w);
    dur_w(w, t.elapsed);
    std_format.write_str(w, "  ");
    reason_w(w, t);
    std_format.format(w, "  {}:{}\n", t.art.file, t.art.line::i64);
    captured_w(w, t);
    pointers_w(w, t);
}

# where a failed test's full output is and how to rerun it alone
fun pointers_w(w: *io_writer.Writer, t: *readout.TestResult) {
    if (t.truncated && t.log != nil) { std_format.format(w, "    full output: {}\n", t.log); }
    std_format.write_str(w, "    rerun: ");
    if (t.launch != nil) { std_format.format(w, "{} {}\n", t.launch, t.art.idx::i64); }
    or                   { std_format.format(w, "{} {}\n", t.art.exe::str, t.art.idx::i64); }
}

fun col_w(w: *io_writer.Writer, s: str, width: usize) {
    std_format.write_str(w, s);
    var pad: usize = 2;
    val l:   usize = str_len(s);
    if (l + 2 < width) { pad = width - l; }
    emit_spaces(w, pad);
}

fun dur_w(w: *io_writer.Writer, elapsed: chrono_duration.Duration) {
    var dbuf: [DUR_CAP]u8;
    val ds:   str   = chrono_duration.format_duration(elapsed, ?dbuf[0], DUR_CAP);
    val l:    usize = str_len(ds);
    std_format.write_str(w, "  ");
    if (l < 7) { emit_spaces(w, 7 - l); }
    std_format.write_str(w, ds);
}

fun reason_w(w: *io_writer.Writer, t: *readout.TestResult) {
    val r: *testrun.GateResult = ?t.result;
    if (r.kind == testrun.RESULT_RESOURCE_EXHAUSTION && r.cause == testrun.CAUSE_ORACLE_TIMEOUT) {
        val d: duration.Text = duration.text(t.bound);
        std_format.format(w, "(timed out after {}{})", d.n, d.unit);
    }
    or (r.kind == testrun.RESULT_SEMANTIC_MISMATCH && r.cause == testrun.CAUSE_ORACLE_EXIT) {
        std_format.format(w, "(exit {})", t.code::i64);
    }
    or (r.kind == testrun.RESULT_SEMANTIC_MISMATCH && r.cause == testrun.CAUSE_ORACLE_SIGNAL) {
        std_format.format(w, "(signal {})", t.code::i64);
    }
    or (r.kind == testrun.RESULT_INFRASTRUCTURE_FAILURE && r.cause == testrun.CAUSE_ORACLE_SPAWN_FAILURE) {
        std_format.write_str(w, "(spawn failed)");
    }
    or (r.kind == testrun.RESULT_INFRASTRUCTURE_FAILURE && r.cause == testrun.CAUSE_ORACLE_CAPTURE) {
        std_format.write_str(w, "(capture failed)");
    }
    or (r.kind == testrun.RESULT_INFRASTRUCTURE_FAILURE && r.cause == testrun.CAUSE_INVALID_TERMINAL) {
        std_format.write_str(w, "(runner failed)");
    }
    or { std_format.write_str(w, "(failed)"); }
}

# a test's captured output, each line indented under it
fun captured_w(w: *io_writer.Writer, t: *readout.TestResult) {
    if (t.out == nil || t.out_len == 0) {
        if (t.truncated) { std_format.write_str(w, "    ... (output truncated)\n"); }
        ret;
    }
    var i:   usize = 0;
    var seg: usize = 0;
    for (i < t.out_len) {
        if (t.out[i] == '\n') {
            std_format.write_str(w, "    ");
            std_format.write_bytes(w, (t.out::usize + seg)::*u8, i - seg + 1);
            seg = i + 1;
        }
        i = i + 1;
    }
    if (seg < t.out_len) {
        std_format.write_str(w, "    ");
        std_format.write_bytes(w, (t.out::usize + seg)::*u8, t.out_len - seg);
        std_format.write_newline(w);
    }
    if (t.truncated) { std_format.write_str(w, "    ... (output truncated)\n"); }
}

# the closing summary: every failure re-listed in collection order, whatever
# order the tests finished in, then the counts
fun run_summary_w(w: *io_writer.Writer, ev: *readout.RunEnd) {
    if (ev.count > 0) { std_format.write_str(w, "\n"); }
    if (ev.failed > 0) {
        std_format.write_str(w, "failures:\n");
        var i: u32 = 0;
        for (i < ev.count) {
            val t: *readout.TestResult = ?ev.tests[i];
            if (failure(?t.result)) {
                std_format.format(w, "  {}  {}:{}  ", t.art.name, t.art.file, t.art.line::i64);
                reason_w(w, t);
                std_format.write_str(w, "\n");
            }
            i = i + 1;
        }
        std_format.write_str(w, "\n");
    }
    var dbuf: [DUR_CAP]u8;
    val ds:   str = chrono_duration.format_duration(ev.wall, ?dbuf[0], DUR_CAP);
    std_format.format(w, "{} passed, {} failed", ev.passed::i64, ev.failed::i64);
    if (ev.timed_out > 0) { std_format.format(w, " ({} timed out)", ev.timed_out::i64); }
    std_format.format(w, ", {} total", ev.count::i64);
    if (ev.skipped > 0) { std_format.format(w, ", {} skipped", ev.skipped::i64); }
    std_format.format(w, "  ({})\n", ds);
    val tally:       *testrun.GateTally = ev.tally;
    val extra_infra: u32                = tally.unsupported_input + tally.tool_unavailable
        + tally.resource_exhaustion + tally.invalid_injection;
    if (extra_infra > 0) {
        std_format.format(w, "  unsupported {}, target unavailable {}, resource exhaustion {}, invalid injection {}\n",
            tally.unsupported_input::i64, tally.tool_unavailable::i64,
            tally.resource_exhaustion::i64, tally.invalid_injection::i64);
    }
}

fun run_start_record(w: *io_writer.Writer, ev: *readout.RunStart) {
    var o: json.Object;
    record_begin(w, ?o, "run_start");
    json.field_i64(?o, "tests", ev.count::i64);
    json.object_end(?o);
}

fun run_end_record(w: *io_writer.Writer, ev: *readout.RunEnd) {
    var o: json.Object;
    record_begin(w, ?o, "run_end");
    json.field_i64(?o, "passed", ev.passed::i64);
    json.field_i64(?o, "failed", ev.failed::i64);
    json.field_i64(?o, "skipped", ev.skipped::i64);
    json.field_i64(?o, "total", ev.count::i64);
    json.field_i64(?o, "duration_ns", chrono_duration.duration_nsec(ev.wall));
    json.field_i64(?o, "mismatch", ev.tally.semantic_mismatch::i64);
    json.field_i64(?o, "unsupported", ev.tally.unsupported_input::i64);
    json.field_i64(?o, "target_unavailable", ev.tally.tool_unavailable::i64);
    json.field_i64(?o, "infrastructure_failure", ev.tally.infrastructure_failure::i64);
    json.field_i64(?o, "resource_exhaustion", ev.tally.resource_exhaustion::i64);
    json.field_i64(?o, "timed_out", ev.timed_out::i64);
    json.field_i64(?o, "invalid_injection", ev.tally.invalid_injection::i64);
    val origin: opt[str] = diagnostic.origin_name(diagnostic.ORIGIN_TEST);
    if (sel origin.some) { json.field_str(?o, "origin", origin.some); }
    json.object_end(?o);
}

# open one record named record on w
fun record_begin(w: *io_writer.Writer, o: *json.Object, record: *u8) {
    json.object_begin(w, o);
    json.field_i64(o, "schema", SCHEMA_VERSION);
    json.field_str(o, "record", record);
}

# whether a result is a failure: anything but a pass or a skip
fun failure(r: *testrun.GateResult) bool {
    ret r.kind != testrun.RESULT_PASS && r.kind != testrun.RESULT_SKIP;
}

# the outcome a test record names: `pass`, `skip`, `exit`, `signal`, `spawn`,
# `timeout`, or `other`
fun result_name(r: *testrun.GateResult) *u8 {
    if (r.kind == testrun.RESULT_PASS)                                                                    { ret "pass"; }
    if (r.kind == testrun.RESULT_SKIP)                                                                    { ret "skip"; }
    if (r.kind == testrun.RESULT_SEMANTIC_MISMATCH && r.cause == testrun.CAUSE_ORACLE_EXIT)               { ret "exit"; }
    if (r.kind == testrun.RESULT_SEMANTIC_MISMATCH && r.cause == testrun.CAUSE_ORACLE_SIGNAL)             { ret "signal"; }
    if (r.kind == testrun.RESULT_INFRASTRUCTURE_FAILURE && r.cause == testrun.CAUSE_ORACLE_SPAWN_FAILURE) { ret "spawn"; }
    if (r.kind == testrun.RESULT_RESOURCE_EXHAUSTION && r.cause == testrun.CAUSE_ORACLE_TIMEOUT)          { ret "timeout"; }
    ret "other";
}

# whether a result kept output worth pointing at
pub fun has_capture(r: *testrun.GateResult) bool {
    if (r.kind == testrun.RESULT_SEMANTIC_MISMATCH)   { ret true; }
    if (r.kind == testrun.RESULT_RESOURCE_EXHAUSTION) { ret true; }
    ret r.kind == testrun.RESULT_INFRASTRUCTURE_FAILURE && r.cause != testrun.CAUSE_ORACLE_SPAWN_FAILURE;
}

# how a command writes its diagnostics to stderr: `--diagnostics=human`, the
# default, or `--diagnostics=json`
pub def Format: u8;

pub val FORMAT_HUMAN: Format = 0;
val     FORMAT_JSON:  Format = 1;

# the format a `--diagnostics` value names
# ---
# name: the value
# ret:  the format, or none for a name outside `human` and `json`
pub fun format_named(name: str) opt[Format] {
    if (str_equals(name, "human")) { ret opt[Format].some{FORMAT_HUMAN}; }
    if (str_equals(name, "json"))  { ret opt[Format].some{FORMAT_JSON}; }
    ret opt[Format].none{};
}

# how a build-shaped command reports to stderr, and what it has reported. under
# json every line it writes is a record and `report_close` ends the run with the
# summary record, whose counts are the severities of the records before it
# ---
# format:   human text or json records
# w:        where the report is written, stderr
# root:     the project root as the command resolved it, nil until then; a json
#           record names a file inside it relative to it
# errors:   the error records written
# warnings: the warning records written
# made:     whether the arena record paths are built in, and the base they are
#           measured from, have been made; they are on first use
# built:    under json, each unit's `built` line, which the summary record carries
pub rec Report {
    format:   Format;
    w:        io_writer.Writer;
    root:     str;
    errors:   usize;
    warnings: usize;
    made:     bool;
    backing:  A.Allocator;
    ar:       arena.Arena;
    a:        A.Allocator;
    pb:       PathBase;
    built:    Vector[Built];
    # the first refusal met while writing, which fails the report at its close
    refusal: opt[fail.Fail];
}

# a unit's `built` line as the summary record keeps it: the output, its modules,
# its size when it is one file, and the unit's wall time
rec Built {
    out:      str;
    modules:  u32;
    bytes:    usize;
    has_size: bool;
    total:    chrono_duration.Duration;
}

# start a report in place; it holds its own arena, so it stays where it was made
# until `report_close`
# ---
# r:      the report
# format: the format the command writes
pub fun report_init(r: *Report, format: Format) {
    r.format   = format;
    r.w        = stderr_writer();
    r.root     = nil;
    r.errors   = 0;
    r.warnings = 0;
    r.made     = false;
    r.built    = collections_vector.init[Built](nil);
    r.refusal  = opt[fail.Fail].none{};
}

# keeps the first refusal the report meets while writing
fun refused(r: *Report, f: fail.Fail) {
    val first: bool = sel r.refusal.none;
    if (first) { r.refusal = opt[fail.Fail].some{f}; }
}

# the base record paths are measured from, over the report's arena; nil, with the
# refusal kept, when the arena cannot be made, and a record then names each file
# as it was given
fun report_paths(r: *Report) *PathBase {
    if (r.made) { ret ?r.pb; }
    val made: err[A.Error] = page.make(?r.backing);
    if (sel made.err) {
        refused(r, fail.refused(made.err));
        ret nil;
    }
    val opened: err[A.Error] = arena.init(?r.ar, ?r.backing, 0);
    if (sel opened.err) {
        refused(r, fail.refused(opened.err));
        ret nil;
    }
    val armed: err[A.Error] = arena.make(?r.a, ?r.ar);
    if (sel armed.err) {
        arena.dnit(?r.ar);
        refused(r, fail.refused(armed.err));
        ret nil;
    }
    r.made = true;
    var root: str = r.root;
    if (root == nil) { root = "."; }
    r.pb = path_base(?r.a, root);
    ret ?r.pb;
}

# keep a unit's `built` line for the summary record; the output path is copied
# into the report's arena, and a line the arena refuses is kept as the report's
# refusal, which fails it at its close
fun report_built(r: *Report, ev: *readout.Summary) {
    if (report_paths(r) == nil) { ret; }
    if (r.built.a == nil)       { r.built = collections_vector.init[Built](?r.a); }
    val out: res[str, A.Error] = str_dup(?r.a, ev.out);
    if (sel out.err) {
        refused(r, fail.refused(out.err));
        ret;
    }
    val kept: res[usize, A.Error] = collections_vector.push[Built](?r.built, Built{out: out.ok, modules: ev.modules, bytes: ev.bytes, has_size: ev.has_size, total: ev.total});
    if (sel kept.err) { refused(r, fail.refused(kept.err)); }
}

fun count_record(r: *Report, d: *diagnostic.Diagnostic) {
    if (diagnostic.is_error(d)) { r.errors = r.errors + 1; }
    or                          { r.warnings = r.warnings + 1; }
}

# report a failure raised outside a diagnostic store: `error[<key>]: <message>`
# as text, or a failure record under json. a reported failure writes nothing,
# its diagnostics having been rendered already
# ---
# r:      the command's report
# f:      the failure
# origin: the phase it is reported under; ORIGIN_NONE for the command line itself
# ret:    the exit code `exit.of` maps the failure to
pub fun report_fail(r: *Report, f: fail.Fail, origin: diagnostic.Origin) i64 {
    var fv: fail.Fail = f;
    ret report_failure(r, ?fv, origin);
}

fun report_failure(r: *Report, f: *fail.Fail, origin: diagnostic.Origin) i64 {
    if (r.format != FORMAT_JSON) { ret render_fail_w(?r.w, f); }
    if (!sel f.reported) {
        render_failure_record(?r.w, report_paths(r), f, origin);
        r.errors = r.errors + 1;
    }
    ret exit.of(@f);
}

# one test's result as a record under json; human text writes nothing here,
# the runner's own readout carrying it
# ---
# r: the command's report
# t: the finished test
fun report_test(r: *Report, t: *readout.TestResult) {
    if (r.format != FORMAT_JSON) { ret; }
    val art: *testrun.TestArtifact = t.art;
    var o:   json.Object;
    record_begin(?r.w, ?o, "test");
    test_identity(r, ?o, art);
    json.field_str(?o, "outcome", result_name(?t.result));
    json.field_i64(?o, "code", t.code::i64);
    json.field_i64(?o, "timeout_ns", chrono_duration.duration_nsec(t.bound));
    json.field_i64(?o, "duration_ns", chrono_duration.duration_nsec(t.elapsed));
    json.field_str(?o, "exe", art.exe);
    if (has_capture(?t.result)) { json.field_str_or_null(?o, "output", t.log); }
    or                          { json.field_null(?o, "output"); }
    val origin: opt[str] = diagnostic.origin_name(diagnostic.ORIGIN_TEST);
    if (sel origin.some) { json.field_str(?o, "origin", origin.some); }
    json.object_end(?o);
}

# the members that name a test in its test and case records, its file relative to the project
fun test_identity(r: *Report, o: *json.Object, art: *testrun.TestArtifact) {
    val file: str = record_path(report_paths(r), art.file);
    json.field_str(o, "name", art.name);
    json.field_str(o, "module", art.module);
    json.field_str(o, "file", file);
    json.field_i64(o, "line", art.line::i64);
    json.field_i64(o, "index", art.idx::i64);
    json.field_str_or_null(o, "target", art.target);
    json.field_str_or_null(o, "profile", art.profile);
}

# one collected test as a record under json, as `mach test --list` lists it; human text
# writes nothing here
# ---
# r:   the command's report
# art: the test
pub fun report_case(r: *Report, art: *testrun.TestArtifact) {
    if (r.format != FORMAT_JSON) { ret; }
    var o: json.Object;
    record_begin(?r.w, ?o, "case");
    test_identity(r, ?o, art);
    json.field_str(?o, "object", art.object);
    json.object_end(?o);
}

# a (target, profile) whose tests were built and not run, as a record under json; human text
# writes nothing here
# ---
# r:       the command's report
# target:  the declared target name
# profile: the profile name
# reason:  why its tests did not run
pub fun report_skip(r: *Report, target: str, profile: str, reason: str) {
    if (r.format != FORMAT_JSON) { ret; }
    var o: json.Object;
    record_begin(?r.w, ?o, "skip");
    json.field_str(?o, "target", target);
    json.field_str(?o, "profile", profile);
    json.field_str(?o, "reason", reason);
    json.object_end(?o);
}

# end the run: under json the summary record, the last line the command writes;
# the report's arena is released either way
# ---
# r:    the command's report
# code: the exit code the command returns
# ret:  code
pub fun report_close(r: *Report, code: i64) i64 {
    var closing: i64 = code;
    if (r.made) {
        if (sel r.pb.refusal.some) { refused(r, r.pb.refusal.some); }
    }
    if (sel r.refusal.some) {
        val failed: i64 = report_fail(r, r.refusal.some, diagnostic.ORIGIN_NONE);
        if (closing == exit.OK) { closing = failed; }
    }
    if (r.format == FORMAT_JSON) {
        var o: json.Object;
        json.object_begin(?r.w, ?o);
        json.field_i64(?o, "schema", SCHEMA_VERSION);
        json.field_str(?o, "record", "summary");
        json.field_i64(?o, "errors", r.errors::i64);
        json.field_i64(?o, "warnings", r.warnings::i64);
        # no kind is informational, so schema 1's notes total is always zero
        json.field_i64(?o, "notes", 0);
        if (closing == exit.OK) { json.field_str(?o, "outcome", "success"); }
        or                      { json.field_str(?o, "outcome", "failure"); }
        json.field_i64(?o, "exit_code", closing);
        if (r.built.len > 0) { summary_built(?o, r); }
        json.object_end(?o);
    }
    if (r.made) {
        arena.dnit(?r.ar);
        r.made  = false;
        r.built = collections_vector.init[Built](nil);
    }
    ret closing;
}

# the summary record's `built` lines: `time_us`, every unit's wall time added,
# and `built`, one object per line with its `out`, `modules`, `bytes` when the
# line shows a size, and `time_us`
fun summary_built(o: *json.Object, r: *Report) {
    var total: chrono_duration.Duration = 0;
    var i:     usize                    = 0;
    for (i < r.built.len) {
        total = total + r.built.data[i].total;
        i     = i + 1;
    }
    json.field_i64(o, "time_us", micros(total));
    var arr: json.Array;
    json.field_array_begin(o, "built", ?arr);
    i = 0;
    for (i < r.built.len) {
        val b:  *Built = ?r.built.data[i];
        var bo: json.Object;
        json.array_object_begin(?arr, ?bo);
        json.field_str(?bo, "out", b.out);
        json.field_i64(?bo, "modules", b.modules::i64);
        if (b.has_size) { json.field_i64(?bo, "bytes", b.bytes::i64); }
        json.field_i64(?bo, "time_us", micros(b.total));
        json.object_end_value(?bo);
        i = i + 1;
    }
    json.array_end(?arr);
}

# the version every json record carries in `schema`. adding a field, a record
# type or a value of an enumerated field keeps it; changing or removing one
# bumps it (doc/language/diagnostics-json.md)
val SCHEMA_VERSION: i64 = 1;

# where record paths are measured from: the working directory a relative
# source path is spelled against, and the project root resolved against it
# a path the base could not measure is named as it was given, and the refusal is
# kept, which fails the report at its close
rec PathBase {
    a:       *A.Allocator;
    cwd:     str;
    root:    str;
    refusal: opt[fail.Fail];
}

fun path_base(a: *A.Allocator, root: str) PathBase {
    var pb: PathBase;
    pb.a       = a;
    pb.cwd     = nil;
    pb.root    = nil;
    pb.refusal = opt[fail.Fail].none{};
    val cwd_r: res[types_string.OwnedString, env.EnvError] = env.current_dir(a);
    if (sel cwd_r.err) { pb.refusal = opt[fail.Fail].some{fail.environment(diagnostic_kind.FS_CURRENT_DIR, fail.env_text(cwd_r.err))}; }
    if (sel cwd_r.ok)  { pb.cwd = cwd_r.ok.data; }
    pb.root = absolute(?pb, root);
    ret pb;
}

# a path resolved against the working directory and cleaned; nil, with the
# refusal kept, when the allocator refuses
fun absolute(pb: *PathBase, p: str) str {
    var full: str = p;
    if (pb.cwd != nil) {
        val joined: res[types_path.Path, A.Error] = types_path.resolve(pb.a, pb.cwd, p);
        if (sel joined.err) {
            path_refused(pb, joined.err);
            ret nil;
        }
        full = joined.ok;
    }
    val cleaned: res[types_path.Path, A.Error] = types_path.clean(pb.a, full);
    if (sel cleaned.err) {
        path_refused(pb, cleaned.err);
        ret nil;
    }
    ret cleaned.ok;
}

fun path_refused(pb: *PathBase, e: A.Error) {
    val first: bool = sel pb.refusal.none;
    if (first) { pb.refusal = opt[fail.Fail].some{fail.refused(e)}; }
}

# the path a record names a source file by: relative to the project root for a
# file inside it, otherwise absolute; as given when there is no base, whose
# refusal the report keeps
fun record_path(pb: *PathBase, p: str) str {
    if (pb == nil) { ret p; }
    val full: str = absolute(pb, p);
    if (full == nil || pb.root == nil) { ret p; }
    val rl: usize = str_len(pb.root);
    if (rl == 0 || !str_starts_with(full, pb.root)) { ret full; }
    if (types_path.is_separator(pb.root[rl - 1]))   { ret (?full[rl])::str; }
    if (full[rl] == 0)                              { ret "."; }
    if (types_path.is_separator(full[rl]))          { ret (?full[rl + 1])::str; }
    ret full;
}

# a located span's members: `file`, 1-based `line` and `column` of its first
# byte, `end_line` and `end_column` of the position just past its last byte,
# columns counted in UTF-8 bytes, and the 0-based `byte_start` and exclusive
# `byte_end`
fun put_span(o: *json.Object, pb: *PathBase, f: *Frame) {
    val end_pos: lang_source.Position = lang_source.position(f.sf, f.end);
    json.field_str(o, "file", record_path(pb, f.sf.path));
    json.field_i64(o, "line", f.line_s::i64);
    json.field_i64(o, "column", f.col_s::i64);
    json.field_i64(o, "end_line", end_pos.line::i64);
    json.field_i64(o, "end_column", end_pos.col::i64);
    json.field_i64(o, "byte_start", f.off::i64);
    json.field_i64(o, "byte_end", f.end::i64);
}

# a failure's place as a span's members, as `put_span` writes them
fun put_place(o: *json.Object, pb: *PathBase, at: *fail.Place) {
    json.field_str(o, "file", record_path(pb, at.path));
    json.field_i64(o, "line", at.start.line::i64);
    json.field_i64(o, "column", at.start.col::i64);
    json.field_i64(o, "end_line", at.end.line::i64);
    json.field_i64(o, "end_column", at.end.col::i64);
    json.field_i64(o, "byte_start", at.span.offset::i64);
    json.field_i64(o, "byte_end", lang_source.span_end(at.span)::i64);
}

fun put_text_element(arr: *json.Array, text: str) {
    if (!arr.first) { std_format.write_str(arr.w, ","); }
    arr.first = false;
    json.write_json_string(arr.w, text);
}

# one diagnostic as one NDJSON record, members in the order the schema
# documents them
fun render_record(w: *io_writer.Writer, sources: *lang_source.SourceMap, pb: *PathBase, d: *diagnostic.Diagnostic) {
    var o: json.Object;
    json.object_begin(w, ?o);
    json.field_i64(?o, "schema", SCHEMA_VERSION);
    json.field_str(?o, "record", "diagnostic");

    json.field_str(?o, "severity", severity_name(d.kind));
    json.field_str_or_null(?o, "code", diagnostic_kind.key_of(d.kind));
    json.field_str(?o, "message", d.message);
    val origin: opt[str] = diagnostic.origin_name(d.origin);
    if (sel origin.some) { json.field_str(?o, "origin", origin.some); }

    val opt_pf: opt[Frame] = locate(sources, d.loc);
    if (sel opt_pf.some) {
        var pf:   Frame = opt_pf.some;
        var prim: json.Object;
        json.field_object_begin(?o, "primary", ?prim);
        put_span(?prim, pb, ?pf);
        json.object_end_value(?prim);
    }
    or { json.field_null(?o, "primary"); }

    var related: json.Array;
    json.field_array_begin(?o, "related", ?related);
    var i: usize = 0;
    for (i < d.related.len) {
        val rel:    *diagnostic.Related = ?d.related.data[i];
        val opt_rf: opt[Frame]          = locate(sources, rel.loc);
        if (sel opt_rf.some) {
            var rf: Frame = opt_rf.some;
            var ro: json.Object;
            json.array_object_begin(?related, ?ro);
            put_span(?ro, pb, ?rf);
            json.field_str_or_null(?ro, "label", rel.label);
            json.object_end_value(?ro);
        }
        i = i + 1;
    }
    json.array_end(?related);

    # a related site mach cannot locate stands as a note, as the text shows it
    var notes: json.Array;
    json.field_array_begin(?o, "notes", ?notes);
    i = 0;
    for (i < d.related.len) {
        val rel:    *diagnostic.Related = ?d.related.data[i];
        val opt_rf: opt[Frame]          = locate(sources, rel.loc);
        if (rel.label != nil && sel opt_rf.none) { put_text_element(?notes, rel.label); }
        i = i + 1;
    }
    i = 0;
    for (i < d.children.len) {
        if (d.children.data[i].kind != diagnostic.CHILD_HELP) { put_text_element(?notes, d.children.data[i].text); }
        i = i + 1;
    }
    json.array_end(?notes);

    var help: json.Array;
    json.field_array_begin(?o, "help", ?help);
    i = 0;
    for (i < d.children.len) {
        if (d.children.data[i].kind == diagnostic.CHILD_HELP) { put_text_element(?help, d.children.data[i].text); }
        i = i + 1;
    }
    json.array_end(?help);

    var fixes: json.Array;
    json.field_array_begin(?o, "fixes", ?fixes);
    i = 0;
    for (i < d.fixes.len) {
        val fx: *diagnostic.Fix = ?d.fixes.data[i];
        var fo: json.Object;
        json.array_object_begin(?fixes, ?fo);
        json.field_str(?fo, "label", fx.label);
        var edits: json.Array;
        json.field_array_begin(?fo, "edits", ?edits);
        var e: usize = 0;
        for (e < fx.edits.len) {
            val ed:     *diagnostic.Edit = ?fx.edits.data[e];
            val opt_ef: opt[Frame]       = locate(sources, ed.loc);
            if (sel opt_ef.some) {
                var ef: Frame = opt_ef.some;
                var eo: json.Object;
                json.array_object_begin(?edits, ?eo);
                put_span(?eo, pb, ?ef);
                json.field_str(?eo, "replacement", ed.replacement);
                json.object_end_value(?eo);
            }
            e = e + 1;
        }
        json.array_end(?edits);
        json.object_end_value(?fo);
        i = i + 1;
    }
    json.array_end(?fixes);
    json.object_end(?o);
}

fun render_store_json(r: *Report, sources: *lang_source.SourceMap, list: *diagnostic.DiagnosticStore, pb: *PathBase) {
    var i: usize = 0;
    for (i < diagnostic.len(list)) {
        val d: *diagnostic.Diagnostic = ?list.items.data[i];
        render_record(?r.w, sources, pb, d);
        count_record(r, d);
        i = i + 1;
    }
}

# a failure outside every store as a record: the members of a diagnostic
# record, its primary the place in the file that caused it when it names one
# and its related the other places it names, each without a label
fun render_failure_record(w: *io_writer.Writer, pb: *PathBase, f: *fail.Fail, origin: diagnostic.Origin) {
    var o: json.Object;
    json.object_begin(w, ?o);
    json.field_i64(?o, "schema", SCHEMA_VERSION);
    json.field_str(?o, "record", "failure");
    json.field_str(?o, "severity", "error");
    json.field_str_or_null(?o, "code", diagnostic_kind.key_of(fail.kind_of(@f)));
    json.field_str(?o, "message", fail.describe(@f));
    val named: opt[str] = diagnostic.origin_name(origin);
    if (sel named.some) { json.field_str(?o, "origin", named.some); }
    val at: opt[fail.Place] = fail.place_of(@f);
    if (sel at.some) {
        var place: fail.Place = at.some;
        var prim:  json.Object;
        json.field_object_begin(?o, "primary", ?prim);
        put_place(?prim, pb, ?place);
        json.object_end_value(?prim);
    }
    or { json.field_null(?o, "primary"); }
    var related: json.Array;
    json.field_array_begin(?o, "related", ?related);
    val also: fail.Related = fail.related_of(@f);
    var i:    usize        = 0;
    for (i < also.count) {
        val rel: *fail.Place = ?also.items[i];
        if (rel.path != nil) {
            var ro: json.Object;
            json.array_object_begin(?related, ?ro);
            put_place(?ro, pb, rel);
            json.field_null(?ro, "label");
            json.object_end_value(?ro);
        }
        i = i + 1;
    }
    json.array_end(?related);
    var notes: json.Array;
    json.field_array_begin(?o, "notes", ?notes);
    json.array_end(?notes);
    var help: json.Array;
    json.field_array_begin(?o, "help", ?help);
    json.array_end(?help);
    var fixes: json.Array;
    json.field_array_begin(?o, "fixes", ?fixes);
    val fixed: opt[fail.Fix] = fail.fix_of(@f);
    if (sel fixed.some) {
        var fx: fail.Fix = fixed.some;
        if (fx.at.path != nil) {
            var fo: json.Object;
            json.array_object_begin(?fixes, ?fo);
            json.field_str(?fo, "label", fx.label);
            var edits: json.Array;
            json.field_array_begin(?fo, "edits", ?edits);
            var eo: json.Object;
            json.array_object_begin(?edits, ?eo);
            put_place(?eo, pb, ?fx.at);
            json.field_str(?eo, "replacement", fx.replacement);
            json.object_end_value(?eo);
            json.array_end(?edits);
            json.object_end_value(?fo);
        }
    }
    json.array_end(?fixes);
    json.object_end(?o);
}
