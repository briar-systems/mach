val MAX_SPAN_LINES: usize = 10;

val EXCERPT_WIDTH: usize = 120;
val EXCERPT_LEAD:  usize = 40;
val EXCERPT_MARK:  str   = "...";

rec Excerpt {
    start:     usize;
    end:       usize;
    cut_left:  bool;
    cut_right: bool;
}

rec MarkRange {
    from: usize;
    to:   usize;
}

fun mark_range(b: source.LineSpan, off: usize, end: usize) MarkRange {
    var r: MarkRange;
    r.from = b.start;
    if (off > b.start && off <= b.end) { r.from = off; }
    r.to = b.end;
    if (end >= b.start && end <= b.end) { r.to = end; }
    if (r.to < r.from)                  { r.to = r.from; }
    ret r;
}

fun excerpt_of(b: source.LineSpan, m: MarkRange) Excerpt {
    var x: Excerpt;
    x.start     = b.start;
    x.end       = b.end;
    x.cut_left  = false;
    x.cut_right = false;
    if (b.end - b.start <= EXCERPT_WIDTH) { ret x; }
    var ws: usize = b.start;
    if (m.from > b.start + EXCERPT_LEAD) { ws = m.from - EXCERPT_LEAD; }
    var we: usize = ws + EXCERPT_WIDTH;
    if (we > b.end) {
        we = b.end;
        if (we - b.start > EXCERPT_WIDTH) { ws = we - EXCERPT_WIDTH; }
        or                                { ws = b.start; }
    }
    x.start     = ws;
    x.end       = we;
    x.cut_left  = ws > b.start;
    x.cut_right = we < b.end;
    ret x;
}

# render every diagnostic of a store to a writer, then an "N errors / M warnings" line
# ---
# out:  the destination
# s:    the session whose SourceMap locates each diagnostic
# list: the diagnostics, rendered in order; nothing is written when it is empty
pub fun flush(out: *writer.Writer, s: *session.Session, list: *diagnostic.DiagnosticStore) {
    flush_sources(out, ?s.sources, list);
}

# render every diagnostic of a store to a writer, then an "N errors / M warnings" line
# ---
# out:     the destination
# sources: the SourceMap that locates each diagnostic
# list:    the diagnostics, rendered in order; nothing is written when it is empty
pub fun flush_sources(out: *writer.Writer, sources: *source.SourceMap, list: *diagnostic.DiagnosticStore) {
    var tally: Tally;
    render_store(out, sources, list, ?tally);
    if (tally.rendered > 0) {
        fmt.write_str(out, "\n");
        emit_summary(out, tally.errors, tally.warnings);
    }
}

# what one summary line stands for: every error and warning rendered above it,
# whichever store or failure record it came from
rec Tally {
    errors:   usize;
    warnings: usize;
    rendered: usize;
}

fun render_store(out: *writer.Writer, sources: *source.SourceMap, list: *diagnostic.DiagnosticStore, tally: *Tally) {
    val total: usize = diagnostic.len(list);
    var i:     usize = 0;
    for (i < total) {
        val d: *diagnostic.Diagnostic = ?list.items.data[i];

        if (i > 0) { fmt.write_str(out, "\n"); }
        render(out, sources, d);

        if (d.severity == diagnostic.SEVERITY_ERROR)   { tally.errors = tally.errors + 1; }
        or (d.severity == diagnostic.SEVERITY_WARNING) { tally.warnings = tally.warnings + 1; }

        i = i + 1;
    }
    tally.rendered = tally.rendered + total;
}

rec Frame {
    sf:     *source.SourceFile;
    off:    usize;
    end:    usize;
    line_s: usize;
    line_e: usize;
    col_s:  usize;
}

fun locate(sources: *source.SourceMap, loc: diagnostic.Location) opt[Frame] {
    val opt_file: opt[*source.SourceFile] = source.get(sources, loc.file_id);
    if (sel opt_file.none) { ret opt[Frame].none{}; }
    val sf: *source.SourceFile = opt_file.some;

    val text_len: usize = str_len(sf.text);

    var off: usize = loc.span.offset;
    if (off > text_len) { off = text_len; }
    var end: usize = loc.span.offset + loc.span.len;
    if (end > text_len) { end = text_len; }
    if (end < off)      { end = off; }

    val start_pos: source.Position = source.position(sf, off);
    var last:      usize           = off;
    if (end > off) { last = end - 1; }
    val end_pos: source.Position = source.position(sf, last);

    var f: Frame;
    f.sf     = sf;
    f.off    = off;
    f.end    = end;
    f.line_s = start_pos.line;
    f.line_e = end_pos.line;
    f.col_s  = start_pos.col;
    ret opt[Frame].some{f};
}

fun render(out: *writer.Writer, sources: *source.SourceMap, d: *diagnostic.Diagnostic) {
    emit_headline(out, d.severity, d.message);

    val opt_pf: opt[Frame] = locate(sources, d.loc);
    val w:      usize      = gutter_width(sources, d, opt_pf);

    var framed: bool = false;
    if (sel opt_pf.some) {
        var pf: Frame = opt_pf.some;
        emit_frame(out, ?pf, w, "^", nil);
        framed = true;
    }

    var i: usize = 0;
    for (i < d.related.len) {
        val rel:    *diagnostic.Related = ?d.related.data[i];
        val opt_rf: opt[Frame]          = locate(sources, rel.loc);
        if (sel opt_rf.some) {
            if (framed) { emit_bar(out, w); }
            var rf: Frame = opt_rf.some;
            emit_frame(out, ?rf, w, "-", rel.label);
            framed = true;
        }
        i = i + 1;
    }

    emit_trailer(out, sources, d, framed, w);
}

fun gutter_width(sources: *source.SourceMap, d: *diagnostic.Diagnostic, opt_pf: opt[Frame]) usize {
    var w: usize = 1;
    if (sel opt_pf.some) { w = decimal_width(opt_pf.some.line_e); }

    var i: usize = 0;
    for (i < d.related.len) {
        val opt_rf: opt[Frame] = locate(sources, d.related.data[i].loc);
        if (sel opt_rf.some) {
            val rw: usize = decimal_width(opt_rf.some.line_e);
            if (rw > w) { w = rw; }
        }
        i = i + 1;
    }
    ret w;
}

fun emit_frame(out: *writer.Writer, f: *Frame, w: usize, head: str, label: str) {
    emit_loc(out, w, f.sf.path, f.line_s, f.col_s);
    emit_bar(out, w);
    emit_snippet(out, f.sf, w, f.line_s, f.line_e, f.off, f.end, head, label);
}

fun emit_trailer(out: *writer.Writer, sources: *source.SourceMap, d: *diagnostic.Diagnostic, framed: bool, w: usize) {
    if (!has_trailer(sources, d)) { ret; }

    var indent: usize = 2;
    if (framed) {
        emit_bar(out, w);
        indent = w + 1;
    }

    var i: usize = 0;
    for (i < d.related.len) {
        val rel:      *diagnostic.Related = ?d.related.data[i];
        val locate_r: opt[Frame]          = locate(sources, rel.loc);
        if (rel.label != nil && sel locate_r.none) {
            emit_tagged(out, "note", rel.label, indent);
        }
        i = i + 1;
    }

    var c: usize = 0;
    for (c < d.children.len) {
        val child: *diagnostic.Child = ?d.children.data[c];
        if (child.kind == diagnostic.CHILD_HELP) { emit_tagged(out, "help", child.text, indent); }
        or                                       { emit_tagged(out, "note", child.text, indent); }
        c = c + 1;
    }

    var f: usize = 0;
    for (f < d.fixes.len) {
        emit_fix(out, sources, w, ?d.fixes.data[f], indent);
        f = f + 1;
    }
}

fun emit_fix(out: *writer.Writer, sources: *source.SourceMap, w: usize, fx: *diagnostic.Fix, indent: usize) {
    emit_tagged(out, "fix", fx.label, indent);
    var e: usize = 0;
    for (e < fx.edits.len) {
        val ed:     *diagnostic.Edit = ?fx.edits.data[e];
        val opt_ef: opt[Frame]       = locate(sources, ed.loc);
        if (sel opt_ef.some) {
            var ef: Frame = opt_ef.some;
            emit_loc(out, w, ef.sf.path, ef.line_s, ef.col_s);
        }
        emit_spaces(out, indent + 2);
        fmt.write_str(out, "-> replace with `");
        fmt.write_str(out, ed.replacement);
        fmt.write_str(out, "`\n");
        e = e + 1;
    }
}

fun has_trailer(sources: *source.SourceMap, d: *diagnostic.Diagnostic) bool {
    if (d.children.len > 0 || d.fixes.len > 0) { ret true; }

    var i: usize = 0;
    for (i < d.related.len) {
        val locate_r: opt[Frame] = locate(sources, d.related.data[i].loc);
        if (d.related.data[i].label != nil && sel locate_r.none) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun emit_snippet(out: *writer.Writer, sf: *source.SourceFile, w: usize, line_s: usize, line_e: usize, off: usize, end: usize, head: str, label: str) {
    if (line_e <= line_s) {
        emit_source_line(out, sf, w, line_s, off, end);
        emit_underline(out, sf, w, line_s, off, end, head, label);
        ret;
    }

    if (line_e - line_s + 1 <= MAX_SPAN_LINES) {
        var l: usize = line_s;
        for (l <= line_e) {
            emit_source_line(out, sf, w, l, off, end);
            if (l == line_s) { emit_underline(out, sf, w, l, off, end, head, nil); }
            or (l == line_e) { emit_underline(out, sf, w, l, off, end, "-", label); }
            or               { emit_underline(out, sf, w, l, off, end, "-", nil); }
            l = l + 1;
        }
        ret;
    }

    emit_source_line(out, sf, w, line_s, off, end);
    emit_underline(out, sf, w, line_s, off, end, head, nil);
    emit_elision(out, w);
    emit_source_line(out, sf, w, line_e, off, end);
    emit_underline(out, sf, w, line_e, off, end, "-", label);
}

fun emit_source_line(out: *writer.Writer, sf: *source.SourceFile, w: usize, line: usize, off: usize, end: usize) {
    val opt_bounds: opt[source.LineSpan] = source.line_bounds(sf, line);
    if (sel opt_bounds.none) { ret; }
    val b: source.LineSpan = opt_bounds.some;
    val x: Excerpt         = excerpt_of(b, mark_range(b, off, end));

    emit_gutter_num(out, w, line);
    if (x.cut_left) { fmt.write_str(out, EXCERPT_MARK); }
    if (x.end > x.start) {
        fmt.write_bytes(out, ?sf.text[x.start], x.end - x.start);
    }
    if (x.cut_right) { fmt.write_str(out, EXCERPT_MARK); }
    fmt.write_str(out, "\n");
}

fun emit_underline(out: *writer.Writer, sf: *source.SourceFile, w: usize, line: usize, off: usize, end: usize, glyph: str, label: str) {
    val opt_bounds: opt[source.LineSpan] = source.line_bounds(sf, line);
    if (sel opt_bounds.none) { ret; }
    val b:         source.LineSpan = opt_bounds.some;
    val m:         MarkRange       = mark_range(b, off, end);
    val x:         Excerpt         = excerpt_of(b, m);
    val mark_from: usize           = m.from;
    var mark_to:   usize           = m.to;
    if (mark_to > x.end) { mark_to = x.end; }

    emit_gutter_bar(out, w);

    if (x.cut_left) { emit_spaces(out, str_len(EXCERPT_MARK)); }
    var i: usize = x.start;
    for (i < mark_from) {
        if (sf.text[i] == '\t') { fmt.write_str(out, "\t"); }
        or                      { fmt.write_str(out, " "); }
        i = i + 1;
    }

    var n: usize = mark_to - mark_from;
    if (n == 0) { n = 1; }
    var j: usize = 0;
    for (j < n) {
        fmt.write_str(out, glyph);
        j = j + 1;
    }
    if (label != nil) {
        fmt.write_str(out, " ");
        fmt.write_str(out, label);
    }
    fmt.write_str(out, "\n");
}

fun emit_loc(out: *writer.Writer, w: usize, path: str, line: usize, col: usize) {
    emit_spaces(out, w);
    fmt.write_str(out, "--> ");
    fmt.write_str(out, path);
    fmt.write_str(out, ":");
    fmt.write_u64(out, line::u64);
    fmt.write_str(out, ":");
    fmt.write_u64(out, col::u64);
    fmt.write_str(out, "\n");
}

fun emit_bar(out: *writer.Writer, w: usize) {
    emit_spaces(out, w);
    fmt.write_str(out, " |\n");
}

fun emit_elision(out: *writer.Writer, w: usize) {
    emit_spaces(out, w);
    fmt.write_str(out, " | ...\n");
}

fun emit_gutter_num(out: *writer.Writer, w: usize, line: usize) {
    emit_spaces(out, w - decimal_width(line));
    fmt.write_u64(out, line::u64);
    fmt.write_str(out, " | ");
}

fun emit_gutter_bar(out: *writer.Writer, w: usize) {
    emit_spaces(out, w);
    fmt.write_str(out, " | ");
}

fun emit_tagged(out: *writer.Writer, tag: str, text: str, indent: usize) {
    emit_spaces(out, indent);
    fmt.write_str(out, "= ");
    fmt.write_str(out, tag);
    fmt.write_str(out, ": ");
    fmt.write_str(out, text);
    fmt.write_newline(out);
}

fun emit_summary(out: *writer.Writer, errors: usize, warnings: usize) {
    fmt.write_u64(out, errors::u64);
    if (errors == 1) { fmt.write_str(out, " error"); }
    or               { fmt.write_str(out, " errors"); }
    fmt.write_str(out, " / ");
    fmt.write_u64(out, warnings::u64);
    if (warnings == 1) { fmt.write_str(out, " warning"); }
    or                 { fmt.write_str(out, " warnings"); }
    fmt.write_str(out, "\n");
}

fun emit_headline(out: *writer.Writer, severity: diagnostic.Severity, message: str) {
    val label: opt[str] = severity_label(severity);
    if (sel label.some) { fmt.write_str(out, label.some); }
    or                  { fmt.format(out, "error: unknown Severity tag {}: ", severity); }
    fmt.write_str(out, message);
    fmt.write_newline(out);
}

fun emit_spaces(out: *writer.Writer, n: usize) {
    var i: usize = 0;
    for (i < n) {
        fmt.write_str(out, " ");
        i = i + 1;
    }
}

fun decimal_width(n: usize) usize {
    var w: usize = 1;
    var v: usize = n;
    for (v >= 10) {
        w = w + 1;
        v = v / 10;
    }
    ret w;
}

# the headline lead of a severity; absent for a tag outside the catalog
fun severity_label(severity: diagnostic.Severity) opt[str] {
    if (severity == diagnostic.SEVERITY_ERROR)   { ret opt[str].some{"error: "}; }
    if (severity == diagnostic.SEVERITY_WARNING) { ret opt[str].some{"warning: "}; }
    if (severity == diagnostic.SEVERITY_INFO)    { ret opt[str].some{"info: "}; }
    if (severity == diagnostic.SEVERITY_HELP)    { ret opt[str].some{"help: "}; }
    ret opt[str].none{};
}

#[testing]
rec MemSink {
    buf: *u8;
    cap: usize;
    len: usize;
}

#[testing]
fun mem_sink_write(ctx: ptr, buf: *u8, len: usize) res[usize, writer.WriteError] {
    val s: *MemSink = ctx::*MemSink;
    var i: usize    = 0;
    for (i < len && s.len < s.cap) {
        s.buf[s.len] = buf[i];
        s.len        = s.len + 1;
        i            = i + 1;
    }
    ret res[usize, writer.WriteError].ok{i};
}

#[testing]
fun mem_writer(w: *writer.Writer, s: *MemSink, buf: *u8, cap: usize) {
    s.buf     = buf;
    s.cap     = cap;
    s.len     = 0;
    w.ctx     = s::ptr;
    w.f_write = mem_sink_write;
}

#[testing]
fun sink_match_at(s: *MemSink, i: usize, want: str, wl: usize) bool {
    var j: usize = 0;
    for (j < wl && s.buf[i + j] == want[j]) { j = j + 1; }
    if (j == wl) { ret true; }
    ret false;
}

#[testing]
fun sink_contains(s: *MemSink, want: str) bool {
    val wl: usize = str_len(want);
    if (wl == 0)    { ret true; }
    if (wl > s.len) { ret false; }
    var i: usize = 0;
    for (i + wl <= s.len) {
        if (sink_match_at(s, i, want, wl)) { ret true; }
        i = i + 1;
    }
    ret false;
}

#[testing]
fun sink_count(s: *MemSink, want: str) usize {
    val wl: usize = str_len(want);
    if (wl == 0 || wl > s.len) { ret 0; }
    var count: usize = 0;
    var i:     usize = 0;
    for (i + wl <= s.len) {
        if (sink_match_at(s, i, want, wl)) {
            count = count + 1;
            i     = i + wl;
        }
        or { i = i + 1; }
    }
    ret count;
}

#[testing]
fun line_span(sf: *source.SourceFile, line: usize) token.Span {
    var sp: token.Span;
    sp.offset = 0;
    sp.len    = 0;
    val found: opt[source.LineSpan] = source.line_bounds(sf, line);
    if (sel found.none) { ret sp; }
    val b: source.LineSpan = found.some;
    sp.offset = b.start;
    sp.len    = b.end - b.start;
    ret sp;
}

test render__long_line_is_windowed_around_the_span {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_s: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel res_s.err) { ret 1; }
    var s: session.Session = res_s.ok;

    var text: [402]u8;
    var i:    usize = 0;
    for (i < 400) {
        text[i] = 'a' + ((i / 10) % 26)::u8;
        i       = i + 1;
    }
    text[400] = '\n';
    text[401] = 0;
    val res_fid: res[source.FileId, fail.Fail] = session.load_source(?s, "t.mach", (?text[0])::str);
    if (sel res_fid.err) {
        session.dnit(?s);
        ret 1;
    }
    val fid: source.FileId = res_fid.ok;

    var list: diagnostic.DiagnosticStore = diagnostic.store_init(?alloc);
    var sp:   token.Span;
    sp.offset = 200;
    sp.len    = 4;
    diagnostic.error(?list, fid, sp, "here");

    var buf:  [2048]u8;
    var sink: MemSink;
    var w:    writer.Writer;
    mem_writer(?w, ?sink, ?buf[0], 2048);
    flush(?w, ?s, ?list);

    var code: i32 = 0;
    if (!sink_contains(?sink, "--> t.mach:1:201")) { code = 1; }
    if (!sink_contains(?sink, " | ...qqqqqqqqqq")) { code = 2; }
    if (!sink_contains(?sink, "...\n"))            { code = 3; }
    if (sink_contains(?sink, "| aaaaaaaaaa"))      { code = 4; }
    if (!sink_contains(?sink, "^^^^\n"))           { code = 5; }
    if (sink_count(?sink, "...") != 2)             { code = 6; }

    diagnostic.store_dnit(?list);
    session.dnit(?s);
    ret code;
}

test render__separator_bar_and_unified_gutter {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_s: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel res_s.err) { ret 1; }
    var s: session.Session = res_s.ok;

    val res_fid: res[source.FileId, fail.Fail] = session.load_source(?s, "t.mach",
        "line 01\nline 02\nline 03\nline 04\nline 05\nline 06\nline 07\nline 08\nline 09\nline 10\nline 11\nline 12\n");
    if (sel res_fid.err) {
        session.dnit(?s);
        ret 1;
    }
    val fid: source.FileId = res_fid.ok;

    val opt_sf: opt[*source.SourceFile] = source.get(?s.sources, fid);
    if (sel opt_sf.none) {
        session.dnit(?s);
        ret 1;
    }
    val sf: *source.SourceFile = opt_sf.some;

    var list: diagnostic.DiagnosticStore = diagnostic.store_init(?alloc);
    diagnostic.error(?list, fid, line_span(sf, 9), "primary here");
    val last_id_r: opt[diagnostic.DiagnosticId] = diagnostic.last_id(?list);
    if (sel last_id_r.none) { ret 99; }
    val last_a: diagnostic.DiagnosticId = last_id_r.some;
    diagnostic.attach_related_committed(?list, last_a, fid, line_span(sf, 12), "secondary here");

    var buf:  [1024]u8;
    var sink: MemSink;
    var w:    writer.Writer;
    mem_writer(?w, ?sink, ?buf[0], 1024);
    flush(?w, ?s, ?list);

    var code: i32 = 0;
    if (sink_count(?sink, "--> ") != 2)                  { code = 1; }
    if (!sink_contains(?sink, " 9 | line 09"))           { code = 1; }
    if (!sink_contains(?sink, "12 | line 12"))           { code = 1; }
    if (!sink_contains(?sink, "   |\n  --> t.mach:12:")) { code = 1; }

    diagnostic.store_dnit(?list);
    session.dnit(?s);
    ret code;
}

test render__an_unresolvable_location_degrades {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_s: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel res_s.err) { ret 1; }
    var s: session.Session = res_s.ok;

    val res_fid: res[source.FileId, fail.Fail] = session.load_source(?s, "t.mach", "alpha\nbeta\ngamma\n");
    if (sel res_fid.err) {
        session.dnit(?s);
        ret 1;
    }
    val fid: source.FileId = res_fid.ok;

    val opt_sf: opt[*source.SourceFile] = source.get(?s.sources, fid);
    if (sel opt_sf.none) {
        session.dnit(?s);
        ret 1;
    }
    val sf: *source.SourceFile = opt_sf.some;

    val bad_fid: source.FileId              = 4242;
    var list:    diagnostic.DiagnosticStore = diagnostic.store_init(?alloc);
    diagnostic.error(?list, fid, line_span(sf, 2), "primary msg");
    val last_id_r: opt[diagnostic.DiagnosticId] = diagnostic.last_id(?list);
    if (sel last_id_r.none) { ret 99; }
    val last_b: diagnostic.DiagnosticId = last_id_r.some;
    diagnostic.attach_related_committed(?list, last_b, bad_fid, line_span(sf, 2), "defined here");

    var buf:  [512]u8;
    var sink: MemSink;
    var w:    writer.Writer;
    mem_writer(?w, ?sink, ?buf[0], 512);
    flush(?w, ?s, ?list);

    var code: i32 = 0;
    if (sink_count(?sink, "--> ") != 1)                { code = 1; }
    if (!sink_contains(?sink, "= note: defined here")) { code = 1; }
    diagnostic.store_dnit(?list);

    # an unresolvable primary still renders its headline and the related frame
    var list2: diagnostic.DiagnosticStore = diagnostic.store_init(?alloc);
    diagnostic.error(?list2, bad_fid, line_span(sf, 2), "primary msg");
    val last_id_r2: opt[diagnostic.DiagnosticId] = diagnostic.last_id(?list2);
    if (sel last_id_r2.none) { ret 99; }
    diagnostic.attach_related_committed(?list2, last_id_r2.some, fid, line_span(sf, 3), "look here");
    var buf2:  [512]u8;
    var sink2: MemSink;
    var w2:    writer.Writer;
    mem_writer(?w2, ?sink2, ?buf2[0], 512);
    flush(?w2, ?s, ?list2);
    if (!sink_contains(?sink2, "error: primary msg")) { code = 2; }
    if (sink_count(?sink2, "--> ") != 1)              { code = 2; }
    if (!sink_contains(?sink2, "--> t.mach:3:"))      { code = 2; }
    if (!sink_contains(?sink2, "gamma"))              { code = 2; }
    if (!sink_contains(?sink2, "look here"))          { code = 2; }
    diagnostic.store_dnit(?list2);
    session.dnit(?s);
    ret code;
}

test render__help_and_a_multi_edit_fix_render_a_location_per_edit {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_s: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel res_s.err) { ret 1; }
    var s: session.Session = res_s.ok;

    val res_fid: res[source.FileId, fail.Fail] = session.load_source(?s, "t.mach", "alpha\nbeta\ngamma\n");
    if (sel res_fid.err) {
        session.dnit(?s);
        ret 1;
    }
    val fid: source.FileId = res_fid.ok;

    val opt_sf: opt[*source.SourceFile] = source.get(?s.sources, fid);
    if (sel opt_sf.none) {
        session.dnit(?s);
        ret 1;
    }
    val sf: *source.SourceFile = opt_sf.some;

    var list: diagnostic.DiagnosticStore = diagnostic.store_init(?alloc);
    val head: token.Span                 = line_span(sf, 1);
    val tail: token.Span                 = line_span(sf, 3);

    val b_r: res[diagnostic.DiagnosticBuilder, fail.Fail] = diagnostic.builder_init(?alloc, diagnostic.SEVERITY_ERROR, fid, line_span(sf, 2), "cast the value to `i64`");
    if (sel b_r.err) {
        session.dnit(?s);
        diagnostic.store_dnit(?list);
        ret 1;
    }
    var b: diagnostic.DiagnosticBuilder = b_r.ok;
    diagnostic.attach_help(?b, "the operands differ in width");
    val fix_r: res[diagnostic.FixId, fail.Fail] = diagnostic.attach_fix(?b, "cast the value to `i64`", fid, head, "(");
    if (sel fix_r.err) {
        diagnostic.builder_dnit(?b);
        session.dnit(?s);
        diagnostic.store_dnit(?list);
        ret 1;
    }
    val fix:               diagnostic.FixId = fix_r.ok;
    val attach_fix_edit_r: err[fail.Fail]   = diagnostic.attach_fix_edit(?b, fix, fid, tail, ")::i64");
    if (sel attach_fix_edit_r.err) {
        diagnostic.builder_dnit(?b);
        session.dnit(?s);
        diagnostic.store_dnit(?list);
        ret 1;
    }
    val commit_r: res[opt[diagnostic.DiagnosticId], fail.Fail] = diagnostic.commit(?b, ?list);
    if (sel commit_r.err) {
        diagnostic.builder_dnit(?b);
        session.dnit(?s);
        diagnostic.store_dnit(?list);
        ret 1;
    }

    var buf:  [512]u8;
    var sink: MemSink;
    var w:    writer.Writer;
    mem_writer(?w, ?sink, ?buf[0], 512);
    flush(?w, ?s, ?list);

    var code: i32 = 0;
    if (!sink_contains(?sink, "= help: the operands differ in width")) { code = 1; }
    if (!sink_contains(?sink, "= fix: cast the value to `i64`"))       { code = 1; }
    if (!sink_contains(?sink, "-> replace with `(`"))                  { code = 1; }
    if (!sink_contains(?sink, "-> replace with `)::i64`"))             { code = 1; }
    if (!sink_contains(?sink, "--> t.mach:1:"))                        { code = 1; }
    if (!sink_contains(?sink, "--> t.mach:3:"))                        { code = 1; }

    diagnostic.store_dnit(?list);
    session.dnit(?s);
    ret code;
}

fun stderr_writer() writer.Writer {
    ret fs.writer(fs.STDERR);
}

fun render_fail_w(w: *writer.Writer, f: *outcome.Fail) i64 {
    if (sel f.reported) { ret exit.of(@f); }
    fmt.write_str(w, "error: ");
    fmt.write_str(w, outcome.describe(@f));
    fmt.write_str(w, "\n");
    ret exit.of(@f);
}

# print a Fail to stderr as "error: <message>" and map it to an exit code
# a reported Fail prints nothing, its diagnostics having been rendered already
# ---
# f:   the Fail
# ret: the exit code `exit.of` maps the failure to
pub fun render_fail(f: *outcome.Fail) i64 {
    var w: writer.Writer = stderr_writer();
    ret render_fail_w(?w, f);
}

# map a build outcome's severity to the process exit code
# ---
# bo:  the outcome
# ret: the shared exit code of the severity; a severity outside the catalog
# is an internal failure written to `w` naming the catalog and the tag
pub fun outcome_code_w(w: *writer.Writer, bo: *outcome.BuildOutcome) i64 {
    if (bo.severity == outcome.BUILD_OK)          { ret exit.OK; }
    if (bo.severity == outcome.BUILD_USER)        { ret exit.USER; }
    if (bo.severity == outcome.BUILD_INTERNAL)    { ret exit.INTERNAL; }
    if (bo.severity == outcome.BUILD_ENVIRONMENT) { ret exit.ENVIRONMENT; }
    fmt.format(w, "error: unknown BuildSeverity tag {}\n", bo.severity);
    ret exit.INTERNAL;
}

pub fun outcome_code(bo: *outcome.BuildOutcome) i64 {
    var w: writer.Writer = stderr_writer();
    ret outcome_code_w(?w, bo);
}

fun sink_unit_w(w: *writer.Writer, units: usize, quiet: bool, artifact: str, target: str, verb: str, has_artifact: bool) {
    if (quiet)      { ret; }
    if (units <= 1) { ret; }
    fmt.write_str(w, verb);
    fmt.write_str(w, " ");
    if (has_artifact) { fmt.write_str(w, artifact); }
    or                { fmt.write_str(w, "project"); }
    if (!str_empty(target)) {
        fmt.write_str(w, " (");
        fmt.write_str(w, target);
        fmt.write_str(w, ")");
    }
    fmt.write_str(w, "\n");
}

fun sink_note_w(w: *writer.Writer, total: u32) {
    if (total == 1) {
        fmt.vformat(w, "note: scalarized {} vector operation with no packed form on this target (simd = \"scalarize\")\n", total::i64);
    }
    or {
        fmt.vformat(w, "note: scalarized {} vector operations with no packed form on this target (simd = \"scalarize\")\n", total::i64);
    }
}

fun build_unit_count(bo: *outcome.BuildOutcome) usize {
    var total: usize = 0;
    var i:     usize = 0;
    for (i < bo.events.len) {
        if (sel bo.events.data[i].unit) { total = total + 1; }
        i = i + 1;
    }
    ret total;
}

# one summary line closes the whole outcome: a failure record printed as its own
# `error:` line (an encoder or rules refusal that reached no store) counts in
# it beside every store's diagnostics, so the tally never reads `0 errors`
# above a nonzero exit (#3617)
fun render_outcome_w(w: *writer.Writer, bo: *outcome.BuildOutcome, quiet: bool) {
    val units: usize = build_unit_count(bo);
    var tally: Tally;
    var i:     usize = 0;
    for (i < bo.events.len) {
        val ev: *outcome.BuildEvent = ?bo.events.data[i];
        if (sel ev.unit) {
            sink_unit_w(w, units, quiet, ev.unit.artifact, ev.unit.target, ev.unit.verb, ev.unit.has_artifact);
        }
        or (sel ev.note) {
            sink_note_w(w, ev.note);
        }
        or (sel ev.fail) {
            if (!sel ev.fail.reported) {
                tally.errors   = tally.errors + 1;
                tally.rendered = tally.rendered + 1;
            }
            render_fail_w(w, ?ev.fail);
        }
        or (sel ev.diagnostics) {
            render_store(w, ev.diagnostics.sources, ev.diagnostics.diags, ?tally);
        }
        i = i + 1;
    }
    if (tally.rendered > 0) {
        fmt.write_str(w, "\n");
        emit_summary(w, tally.errors, tally.warnings);
    }
}

# render a build outcome's events to stderr in order: unit banners, scalarization notes,
# failures, and diagnostics
# ---
# bo:    the outcome
# quiet: suppress the "building <artifact> (<target>)" banner, which prints only when the
#        outcome has more than one unit
pub fun render_outcome(bo: *outcome.BuildOutcome, quiet: bool) {
    var w: writer.Writer = stderr_writer();
    render_outcome_w(?w, bo, quiet);
}

test render_fail__classifies_exit_code_and_suppresses_reported_output {
    var buf:  [256]u8;
    var sink: MemSink;
    var w:    writer.Writer;
    mem_writer(?w, ?sink, ?buf[0], 256);

    var rf: outcome.Fail = outcome.reported();
    if (render_fail_w(?w, ?rf) != 1) { ret 1; }
    if (sink.len != 0)               { ret 2; }

    var uf: outcome.Fail = outcome.user("bad input");
    if (render_fail_w(?w, ?uf) != 1)               { ret 3; }
    if (!sink_contains(?sink, "error: bad input")) { ret 4; }

    var buf2:  [256]u8;
    var sink2: MemSink;
    var w2:    writer.Writer;
    mem_writer(?w2, ?sink2, ?buf2[0], 256);
    var iv: outcome.Fail = outcome.internal("boom");
    if (render_fail_w(?w2, ?iv) != 2)          { ret 5; }
    if (!sink_contains(?sink2, "error: boom")) { ret 6; }

    var buf3:  [256]u8;
    var sink3: MemSink;
    var w3:    writer.Writer;
    mem_writer(?w3, ?sink3, ?buf3[0], 256);
    var ev: outcome.Fail = outcome.environment("disk full");
    if (render_fail_w(?w3, ?ev) != 3)               { ret 7; }
    if (!sink_contains(?sink3, "error: disk full")) { ret 8; }

    ret 0;
}

# an allocation refusal met by the driver stays an internal failure (exit 2),
# never an environmental one (exit 3): the C4 decisions of #3226 (PR #3283)
test regression__an_allocation_refusal_met_by_the_driver_exits_internal {
    var buf:  [256]u8;
    var sink: MemSink;
    var w:    writer.Writer;
    mem_writer(?w, ?sink, ?buf[0], 256);
    var refused: outcome.Fail = outcome.refused(A.Error.exhausted{});
    if (!sel refused.internal)                         { ret 1; }
    if (render_fail_w(?w, ?refused) != 2)              { ret 2; }
    if (!sink_contains(?sink, "error: out of memory")) { ret 3; }
    var bo: outcome.BuildOutcome;
    bo.severity = outcome.severity_of(?refused);
    if (outcome_code(?bo) != 2) { ret 4; }
    ret 0;
}

test outcome_code__maps_every_closed_severity {
    var ok_bo: outcome.BuildOutcome;
    ok_bo.severity = outcome.BUILD_OK;
    if (outcome_code(?ok_bo) != 0) { ret 1; }

    var user_bo: outcome.BuildOutcome;
    user_bo.severity = outcome.BUILD_USER;
    if (outcome_code(?user_bo) != 1) { ret 2; }

    var internal_bo: outcome.BuildOutcome;
    internal_bo.severity = outcome.BUILD_INTERNAL;
    if (outcome_code(?internal_bo) != 2) { ret 3; }

    var env_bo: outcome.BuildOutcome;
    env_bo.severity = outcome.BUILD_ENVIRONMENT;
    if (outcome_code(?env_bo) != 3) { ret 4; }

    var buf:  [256]u8;
    var sink: MemSink;
    var w:    writer.Writer;
    mem_writer(?w, ?sink, ?buf[0], 256);
    var unknown_bo: outcome.BuildOutcome;
    unknown_bo.severity = 255::outcome.BuildSeverity;
    if (outcome_code_w(?w, ?unknown_bo) != 2)                          { ret 5; }
    if (!sink_contains(?sink, "error: unknown BuildSeverity tag 255")) { ret 6; }
    ret 0;
}

test sink_unit__shown_only_for_many_units_and_never_when_quiet {
    var buf:  [256]u8;
    var sink: MemSink;
    var w:    writer.Writer;
    mem_writer(?w, ?sink, ?buf[0], 256);

    sink_unit_w(?w, 1, false, "app", "linux", "building", true);
    if (sink.len != 0) { ret 1; }
    sink_unit_w(?w, 2, true, "app", "linux", "building", true);
    if (sink.len != 0) { ret 1; }

    sink_unit_w(?w, 2, false, "app", "linux", "building", true);
    if (!sink_contains(?sink, "building app (linux)\n")) { ret 2; }

    var buf2:  [256]u8;
    var sink2: MemSink;
    var w2:    writer.Writer;
    mem_writer(?w2, ?sink2, ?buf2[0], 256);
    sink_unit_w(?w2, 2, false, "app", "", "building", false);
    if (!sink_contains(?sink2, "building project\n")) { ret 3; }

    ret 0;
}

test render_outcome_w__consumes_owned_events_in_order {
    var a: A.Allocator;
    page.make(?a);
    var bo: outcome.BuildOutcome = outcome.outcome_init(?a);
    var f:  outcome.Fail         = outcome.user("bad input");

    if (lang_alloc.refused(outcome.record_unit(?bo, "app", "linux", "building", true))) {
        outcome.outcome_dnit(?bo);
        ret 1;
    }
    if (lang_alloc.refused(outcome.record_unit(?bo, "lib", "", "building", true))) {
        outcome.outcome_dnit(?bo);
        ret 1;
    }
    if (lang_alloc.refused(outcome.record_note(?bo, 2))) {
        outcome.outcome_dnit(?bo);
        ret 1;
    }
    if (lang_alloc.refused(outcome.record_fail(?bo, ?f))) {
        outcome.outcome_dnit(?bo);
        ret 1;
    }

    var buf:  [512]u8;
    var sink: MemSink;
    var w:    writer.Writer;
    mem_writer(?w, ?sink, ?buf[0], 512);
    render_outcome_w(?w, ?bo, false);

    var bad: i32 = 0;
    if (!sink_contains(?sink, "building app (linux)\n"))         { bad = 1; }
    if (!sink_contains(?sink, "building lib\n"))                 { bad = 1; }
    if (!sink_contains(?sink, "scalarized 2 vector operations")) { bad = 1; }
    if (!sink_contains(?sink, "error: bad input\n"))             { bad = 1; }

    outcome.outcome_dnit(?bo);
    ret bad;
}

# a refusal that reached no store (an encoder or rules refusal is an internal
# failure record, printed as its own `error:` line) counts in the one summary
# beside the stores' diagnostics: `1 error / 1 warning`, never `0 errors / 1
# warning` above exit 2 (#3617)
test regression__the_tally_counts_a_failure_record_beside_the_stores {
    var a: A.Allocator;
    page.make(?a);
    val session_r: res[session.Session, fail.Fail] = session.init(?a);
    if (sel session_r.err) { ret 1; }
    var s: session.Session = session_r.ok;
    fin { session.dnit(?s); }

    val file_r: res[source.FileId, fail.Fail] = session.load_source(?s, "mach.toml", "[project]\n");
    if (sel file_r.err) { ret 1; }
    val fid:    source.FileId           = file_r.ok;
    val file_o: opt[*source.SourceFile] = source.get(?s.sources, fid);
    if (sel file_o.none) { ret 1; }
    val warned: err[fail.Fail] = diagnostic.warning(?s.diags, dkind.UNUSED_IMPORT, fid, line_span(file_o.some, 1), "states no compiler range");
    if (sel warned.err) { ret 1; }

    var bo: outcome.BuildOutcome = outcome.outcome_init(?a);
    fin { outcome.outcome_dnit(?bo); }
    var f: outcome.Fail = outcome.internal("encode: RISC-V instruction is not admitted on riscv32");
    if (lang_alloc.refused(outcome.record_fail(?bo, ?f))) { ret 1; }
    outcome.fold_fail(?bo, ?f);
    val recorded: err[outcome.Fail] = outcome.record_diagnostics(?bo, ?s.sources, ?s.diags);
    if (sel recorded.err) { ret 1; }

    var buf:  [1024]u8;
    var sink: MemSink;
    var w:    writer.Writer;
    mem_writer(?w, ?sink, ?buf[0], 1024);
    render_outcome_w(?w, ?bo, false);

    var bad: i32 = 0;
    if (!sink_contains(?sink, "error: encode: RISC-V instruction is not admitted on riscv32\n")) { bad = 2; }
    if (!sink_contains(?sink, "states no compiler range"))                                       { bad = 3; }
    if (!sink_contains(?sink, "\n1 error / 1 warning\n"))                                        { bad = 4; }
    if (sink_contains(?sink, "0 errors"))                                                        { bad = 5; }
    if (outcome_code_w(?w, ?bo) != 2)                                                            { bad = 6; }

    # a reported failure's error is already on a store, so it is not counted twice
    var reported: outcome.BuildOutcome = outcome.outcome_init(?a);
    fin { outcome.outcome_dnit(?reported); }
    var rf: outcome.Fail = outcome.reported();
    if (lang_alloc.refused(outcome.record_fail(?reported, ?rf))) { ret 1; }
    val again: err[outcome.Fail] = outcome.record_diagnostics(?reported, ?s.sources, ?s.diags);
    if (sel again.err) { ret 1; }
    var buf2:  [1024]u8;
    var sink2: MemSink;
    var w2:    writer.Writer;
    mem_writer(?w2, ?sink2, ?buf2[0], 1024);
    render_outcome_w(?w2, ?reported, false);
    if (!sink_contains(?sink2, "\n0 errors / 1 warning\n")) { bad = 7; }
    ret bad;
}

test render_outcome_w__diagnostics_survive_session_teardown {
    var a: A.Allocator;
    page.make(?a);
    val session_r: res[session.Session, fail.Fail] = session.init(?a);
    if (sel session_r.err) { ret 1; }
    var s: session.Session = session_r.ok;

    val file_r: res[source.FileId, fail.Fail] = session.load_source(?s, "owned.mach", "bad value\n");
    if (sel file_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val fid:    source.FileId           = file_r.ok;
    val file_o: opt[*source.SourceFile] = source.get(?s.sources, fid);
    if (sel file_o.none) {
        session.dnit(?s);
        ret 1;
    }
    val sf:      *source.SourceFile = file_o.some;
    val error_r: err[fail.Fail]     = diagnostic.error(?s.diags, fid, line_span(sf, 1), "owned diagnostic");
    if (sel error_r.err) {
        session.dnit(?s);
        ret 1;
    }

    var bo:       outcome.BuildOutcome = outcome.outcome_init(?a);
    val recorded: err[outcome.Fail]    = outcome.record_diagnostics(?bo, ?s.sources, ?s.diags);
    if (sel recorded.err) {
        outcome.outcome_dnit(?bo);
        session.dnit(?s);
        ret 1;
    }
    session.dnit(?s);

    var buf:  [512]u8;
    var sink: MemSink;
    var w:    writer.Writer;
    mem_writer(?w, ?sink, ?buf[0], 512);
    render_outcome_w(?w, ?bo, false);

    var bad: i32 = 0;
    if (!sink_contains(?sink, "owned diagnostic")) { bad = 1; }
    if (!sink_contains(?sink, "owned.mach:1:1"))   { bad = 1; }
    if (!sink_contains(?sink, "1 | bad value"))    { bad = 1; }
    outcome.outcome_dnit(?bo);
    ret bad;
}

# a scratch project holding one source file; the caller removes the root
#[testing]
fun t_scaffold(a: *A.Allocator, manifest_text: str, source_text: str) res[str, fail.Fail] {
    val tf_r: res[fs.TempFile, fs.FsError] = fs.temp_create(a, "mach_cli_diag_codegen");
    if (sel tf_r.err) { ret res[str, fail.Fail].err{fail.fs_refused(tf_r.err)}; }
    var tf:    fs.TempFile       = tf_r.ok;
    val dup_r: res[str, A.Error] = str_dup(a, fs.temp_path(?tf));
    fs.temp_close_and_remove(?tf);
    if (sel dup_r.err) { ret res[str, fail.Fail].err{fail.refused(dup_r.err)}; }
    val root: str = dup_r.ok;

    val made: err[fs.FsError] = fs.create_dir_all(a, root, 0o755);
    if (sel made.err) { ret res[str, fail.Fail].err{fail.fs_refused(made.err)}; }
    val src_dir_r: res[str, A.Error] = path.join(a, root, "src");
    if (sel src_dir_r.err) { ret res[str, fail.Fail].err{fail.refused(src_dir_r.err)}; }
    val made_src: err[fs.FsError] = fs.create_dir_all(a, src_dir_r.ok, 0o755);
    if (sel made_src.err) { ret res[str, fail.Fail].err{fail.fs_refused(made_src.err)}; }

    val manifest_path_r: res[str, A.Error] = path.join(a, root, "mach.toml");
    if (sel manifest_path_r.err) { ret res[str, fail.Fail].err{fail.refused(manifest_path_r.err)}; }
    val wrote_manifest: err[fs.FsError] = fs.write_bytes(manifest_path_r.ok, manifest_text::*u8, str_len(manifest_text), 0o644);
    if (sel wrote_manifest.err) { ret res[str, fail.Fail].err{fail.fs_refused(wrote_manifest.err)}; }
    val source_path_r: res[str, A.Error] = path.join(a, src_dir_r.ok, "main.mach");
    if (sel source_path_r.err) { ret res[str, fail.Fail].err{fail.refused(source_path_r.err)}; }
    val wrote_source: err[fs.FsError] = fs.write_bytes(source_path_r.ok, source_text::*u8, str_len(source_text), 0o644);
    if (sel wrote_source.err) { ret res[str, fail.Fail].err{fail.fs_refused(wrote_source.err)}; }
    ret res[str, fail.Fail].ok{root};
}

# the tally counts a diagnostic the back half raised: an `#[oblivious]` function
# whose inline asm branches on a loaded secret word is refused by codegen, and
# the refusal is one located error on the store, so the rendered outcome ends
# `1 error / 0 warnings` and the exit code is the user's, not `0 errors` beside
# a nonzero exit (#3656)
test regression__the_tally_counts_a_codegen_rejection {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }

    val manifest_text: str = "[project]\nmach = \">=5\"\nid = \"ctdiag\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.linux]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[profile.debug]\ndefault = true\nopt = 0\ndebug = false\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n\n[artifact.ctdiag]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/ctdiag\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
    val source_text:   str = "#[oblivious]\nfun f(k: *^u64) ^u64 {\n    var r: ^u64 = @k;\n    asm x86_64 {\n        mov rax, {r}\n        inc rax\n        je 1f\n    1:\n        nop\n    }\n    ret r;\n}\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n";

    val root_r: res[str, fail.Fail] = t_scaffold(?a, manifest_text, source_text);
    if (sel root_r.err) { ret 2; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?a, root); }

    val session_r: res[session.Session, fail.Fail] = session.init(?a);
    if (sel session_r.err) { ret 3; }
    var s: session.Session = session_r.ok;
    fin { session.dnit(?s); }
    val registered: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel registered.err) { ret 4; }

    var pick: manifest.Selection;
    pick.target       = "linux";
    pick.profile      = "";
    pick.artifact     = "";
    pick.want_lib     = false;
    pick.has_artifact = false;
    val project_r: res[project.Project, outcome.Fail] = driver.build_project(?s, root, ?pick);
    if (sel project_r.err) { ret 5; }
    var p: project.Project = project_r.ok;
    fin { project.dnit_project(?p); }

    val checked: err[outcome.Fail] = driver.run_sema_pass(?p);
    if (sel checked.err) { ret 6; }
    val lowered: err[outcome.Fail] = driver.run_lower_pass(?p);
    if (sel lowered.err) { ret 7; }
    val generated: err[outcome.Fail] = driver.run_codegen_pass(?p);
    if (sel generated.ok) { ret 8; }
    var failure: outcome.Fail = generated.err;

    # the outcome the engine would hand the renderer: the failure, then the
    # session's diagnostics
    var bo: outcome.BuildOutcome = outcome.outcome_init(?a);
    fin { outcome.outcome_dnit(?bo); }
    val failed: err[A.Error] = outcome.record_fail(?bo, ?failure);
    if (sel failed.err) { ret 9; }
    outcome.fold_fail(?bo, ?failure);
    val recorded: err[outcome.Fail] = outcome.record_diagnostics(?bo, ?s.sources, ?s.diags);
    if (sel recorded.err) { ret 10; }

    var buf:  [4096]u8;
    var sink: MemSink;
    var w:    writer.Writer;
    mem_writer(?w, ?sink, ?buf[0], 4096);
    render_outcome_w(?w, ?bo, false);

    var bad: i32 = 0;
    if (!sink_contains(?sink, "error: #[oblivious] function `ctdiag.main.f` branches on a secret value")) { bad = 11; }
    if (!sink_contains(?sink, "main.mach:4:5"))                                                           { bad = 12; }
    if (!sink_contains(?sink, "\n1 error / 0 warnings\n"))                                                { bad = 13; }
    if (sink_contains(?sink, "0 errors"))                                                                 { bad = 14; }
    if (outcome_code_w(?w, ?bo) != 1)                                                                     { bad = 15; }
    ret bad;
}

# the tally counts a refusal the optimizer raised one layer above codegen: under
# `simd = "require"` a 32-bit lane vector multiply scalarizes on x86-64's SSE2
# baseline, the pipeline refuses it as one located error on the store, and the
# rendered outcome ends `1 error / 0 warnings` beside the user's exit code (#3664)
test render_outcome_w__the_tally_counts_a_simd_require_rejection {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }

    val manifest_text: str = "[project]\nmach = \">=5\"\nid = \"ctsimd\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.linux]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[profile.debug]\ndefault = true\nopt = 0\ndebug = false\nsimd = \"require\"\nvectorize = false\nfloat_reassoc = false\n\n[artifact.ctsimd]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/ctsimd\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
    # the 8-bit lane multiply is the cell the x86-64 baseline still scalarizes
    # (32- and 64-bit lanes pack through the pmuludq sequences since #3739)
    val source_text: str = "fun kernel(a: u8x16, b: u8x16) u8x16 {\n    ret a * b;\n}\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n";

    val root_r: res[str, fail.Fail] = t_scaffold(?a, manifest_text, source_text);
    if (sel root_r.err) { ret 2; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?a, root); }

    val session_r: res[session.Session, fail.Fail] = session.init(?a);
    if (sel session_r.err) { ret 3; }
    var s: session.Session = session_r.ok;
    fin { session.dnit(?s); }
    val registered: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel registered.err) { ret 4; }

    var pick: manifest.Selection;
    pick.target       = "linux";
    pick.profile      = "";
    pick.artifact     = "";
    pick.want_lib     = false;
    pick.has_artifact = false;
    # the driver's default request stands in for the composed one, so the
    # profile's lever is set on the request the way the cli composes it
    var req: request.BuildRequest = request.defaults();
    req.project_root = root;
    req.simd         = manifest.SIMD_REQUIRE;
    req.vectorize    = false;
    val project_r: res[project.Project, outcome.Fail] = driver.build_project_sel_req(?s, root, ?pick, ?req);
    if (sel project_r.err) { ret 5; }
    var p: project.Project = project_r.ok;
    fin { project.dnit_project(?p); }

    val checked: err[outcome.Fail] = driver.run_sema_pass(?p);
    if (sel checked.err) { ret 6; }
    val lowered: err[outcome.Fail] = driver.run_lower_pass(?p);
    if (sel lowered.ok) { ret 7; }
    var failure: outcome.Fail = lowered.err;
    if (!outcome.is_reported(failure)) { ret 8; }

    var bo: outcome.BuildOutcome = outcome.outcome_init(?a);
    fin { outcome.outcome_dnit(?bo); }
    val failed: err[A.Error] = outcome.record_fail(?bo, ?failure);
    if (sel failed.err) { ret 9; }
    outcome.fold_fail(?bo, ?failure);
    val recorded: err[outcome.Fail] = outcome.record_diagnostics(?bo, ?s.sources, ?s.diags);
    if (sel recorded.err) { ret 10; }

    var buf:  [4096]u8;
    var sink: MemSink;
    var w:    writer.Writer;
    mem_writer(?w, ?sink, ?buf[0], 4096);
    render_outcome_w(?w, ?bo, false);

    var bad: i32 = 0;
    if (!sink_contains(?sink, "error: simd = \"require\": vector multiply on 16 lanes of 8 bits in 'ctsimd.main.kernel' would scalarize on x86_64")) { bad = 11; }
    if (!sink_contains(?sink, "main.mach:2:9"))                                                                                                      { bad = 12; }
    if (!sink_contains(?sink, "\n1 error / 0 warnings\n"))                                                                                           { bad = 13; }
    if (sink_contains(?sink, "0 errors"))                                                                                                            { bad = 14; }
    if (outcome_code_w(?w, ?bo) != 1)                                                                                                                { bad = 15; }
    ret bad;
}

# the warnings a scratch project's sema pass reports whose text holds `needle`,
# built under the profile `profile_keys` declares; -1 when the build fails. the
# request takes the profile's `allow` as the cli composes it
#[testing]
fun t_allowed_warnings(profile_keys: str, main_text: str, lib_text: str, needle: str) i32 {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret -1; }

    val head:       str                       = "[project]\nmach = \">=5\"\nid = \"ctallow\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.linux]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[profile.debug]\ndefault = true\nopt = 0\ndebug = false\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n";
    val tail:       str                       = "\n[artifact.ctallow]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/ctallow\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
    val manifest_r: res[str, fmt.FormatError] = fmt.sprint(?a, "{}{}{}", head, profile_keys, tail);
    if (sel manifest_r.err) { ret -1; }
    val root_r: res[str, fail.Fail] = t_scaffold(?a, manifest_r.ok, main_text);
    if (sel root_r.err) { ret -1; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?a, root); }
    val lib_path_r: res[str, A.Error] = path.join(?a, root, "src/lib.mach");
    if (sel lib_path_r.err) { ret -1; }
    val wrote_lib: err[fs.FsError] = fs.write_bytes(lib_path_r.ok, lib_text::*u8, str_len(lib_text), 0o644);
    if (sel wrote_lib.err) { ret -1; }

    val session_r: res[session.Session, fail.Fail] = session.init(?a);
    if (sel session_r.err) { ret -1; }
    var s: session.Session = session_r.ok;
    fin { session.dnit(?s); }
    val registered: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel registered.err) { ret -1; }

    val m_r: res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, root);
    if (sel m_r.err) { ret -1; }
    var m: manifest.Manifest = m_r.ok;
    fin { manifest.dnit(?m, ?a); }
    val pf_r: res[manifest.ResolvedProfile, outcome.Fail] = manifest.resolve_profile(?a, ?s.interner, ?m, "");
    if (sel pf_r.err) { ret -1; }

    var pick: manifest.Selection;
    pick.target       = "linux";
    pick.profile      = "";
    pick.artifact     = "";
    pick.want_lib     = false;
    pick.has_artifact = false;
    var req: request.BuildRequest = request.defaults();
    req.project_root = root;
    req.allow        = pf_r.ok.allow;
    val project_r: res[project.Project, outcome.Fail] = driver.build_project_sel_req(?s, root, ?pick, ?req);
    if (sel project_r.err) { ret -1; }
    var p: project.Project = project_r.ok;
    fin { project.dnit_project(?p); }
    val checked: err[outcome.Fail] = driver.run_sema_pass(?p);
    if (sel checked.err) { ret -1; }

    var warned: i32   = 0;
    var i:      usize = 0;
    for (i < diagnostic.len(?s.diags)) {
        val d: *diagnostic.Diagnostic = ?s.diags.items.data[i];
        if (d.severity == diagnostic.SEVERITY_WARNING && str_contains(d.message, needle)) { warned = warned + 1; }
        i = i + 1;
    }
    ret warned;
}

# a profile's `allow` silences a warning kind by its name and no other: the
# unused import and the inexact float literal warn until their kind is listed,
# and listing another kind leaves the import's standing (#3812)
test allow__a_listed_warning_kind_is_not_reported {
    val main_text: str = "use ctallow.lib.f;\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n";
    val lib_text:  str = "pub fun f() i32 { ret 1; }\n";
    if (t_allowed_warnings("", main_text, lib_text, "unused import") != 1)                              { ret 1; }
    if (t_allowed_warnings("allow = [\"unused-import\"]\n", main_text, lib_text, "unused import") != 0) { ret 2; }
    if (t_allowed_warnings("allow = [\"deprecated\"]\n", main_text, lib_text, "unused import") != 1)    { ret 3; }
    val float_text: str = "#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { val x: f32 = 3.14159265358979; ret 0; }\n";
    if (t_allowed_warnings("", float_text, lib_text, "not exact") != 1)                                      { ret 4; }
    if (t_allowed_warnings("allow = [\"inexact-float-literal\"]\n", float_text, lib_text, "not exact") != 0) { ret 5; }
    ret 0;
}

# a declared extension moves the lowering, not the legality: the same kernel
# under `extensions = ["sse41"]` passes the require judgement and its text
# carries pmulld (66 0F 38 40), which the baseline object never holds: there
# the same cell is the pmuludq sequence (#3737, #3739)
#[testing]
fun t_text_has_pmulld(p: *project.Project) bool {
    var mid: u32 = 0;
    for (mid < project.module_count(p)) {
        val m: *project.ModuleEntry = project.module_at(p, mid);
        if (m.object_image != nil) {
            var si: u32 = 0;
            for (si < m.object_image.section_count) {
                val sec: *of.Section = ?m.object_image.sections[si];
                var i:   u32         = 0;
                for (i + 4 < sec.len) {
                    if (sec.bytes[i] == 0x66 && sec.bytes[i + 1] == 0x0F && sec.bytes[i + 2] == 0x38 && sec.bytes[i + 3] == 0x40)                                      { ret true; }
                    if (sec.bytes[i] == 0x66 && (sec.bytes[i + 1] & 0xF0) == 0x40 && sec.bytes[i + 2] == 0x0F && sec.bytes[i + 3] == 0x38 && sec.bytes[i + 4] == 0x40) { ret true; }
                    i = i + 1;
                }
                si = si + 1;
            }
        }
        mid = mid + 1;
    }
    ret false;
}

test simd_require__a_declared_extension_lowers_the_cell_packed {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }

    val manifest_text: str = "[project]\nmach = \">=5\"\nid = \"ctsimd\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.linux]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\nextensions = [\"sse41\"]\n\n[profile.debug]\ndefault = true\nopt = 0\ndebug = false\nsimd = \"require\"\nvectorize = false\nfloat_reassoc = false\n\n[artifact.ctsimd]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/ctsimd\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
    val source_text:   str = "fun kernel(a: u32x4, b: u32x4) u32x4 {\n    ret a * b;\n}\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n";

    val root_r: res[str, fail.Fail] = t_scaffold(?a, manifest_text, source_text);
    if (sel root_r.err) { ret 2; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?a, root); }

    val session_r: res[session.Session, fail.Fail] = session.init(?a);
    if (sel session_r.err) { ret 3; }
    var s: session.Session = session_r.ok;
    fin { session.dnit(?s); }
    val registered: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel registered.err) { ret 4; }

    var pick: manifest.Selection;
    pick.target       = "linux";
    pick.profile      = "";
    pick.artifact     = "";
    pick.want_lib     = false;
    pick.has_artifact = false;
    var req: request.BuildRequest = request.defaults();
    req.project_root = root;
    req.simd         = manifest.SIMD_REQUIRE;
    req.vectorize    = false;
    val project_r: res[project.Project, outcome.Fail] = driver.build_project_sel_req(?s, root, ?pick, ?req);
    if (sel project_r.err) { ret 5; }
    var p: project.Project = project_r.ok;
    fin { project.dnit_project(?p); }

    val checked: err[outcome.Fail] = driver.run_sema_pass(?p);
    if (sel checked.err) { ret 6; }
    val lowered: err[outcome.Fail] = driver.run_lower_pass(?p);
    if (sel lowered.err) { ret 7; }
    val generated: err[outcome.Fail] = driver.run_codegen_pass(?p);
    if (sel generated.err)      { ret 8; }
    if (!t_text_has_pmulld(?p)) { ret 9; }
    ret 0;
}
