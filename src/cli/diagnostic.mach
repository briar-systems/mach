# how a command reports: diagnostics, failures, the build readout and test results
#
# a command's `Report` writes to stderr as human text or, under `--report json` or `--report lines`,
# one record a line closed by a summary record. a `Readout` renders the engine's and the
# test runner's events as they arrive, by the readout contract (doc/language/readout.md).

use mach.base.fail;
use mach.base.growth;
use mach.report.testrun;
use std.allocator.page;
use fs: std.filesystem;
use std.text.string.str_dup;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use types_path: std.types.path;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_is_empty;
use std.types.string.str_len;
use std.types.string.str_starts_with;

use A: std.allocator;
use std.allocator.arena;
use chrono_duration:    std.chrono.duration;
use collections_vector: std.collections.vector;
use std.collections.vector.Vector;
use std_format: std.format;
use io_writer:  std.io.writer;
use std.print;
use std.process.env;
use types_string: std.types.string;

use mach.base.diagnostic;
use mach.base.diagnostic.annotation;
use diagnostic_kind: mach.base.diagnostic.kind;
use mach.base.duration;
use base_source: mach.base.source;
use mach.build.outcome;
use mach.cli.exit;
use mach.host.interrupt;
use mach.package.report;
use mach.report.layout;
use mach.report.readout;
use mach.report.record;
use std.terminal;

val MAX_SPAN_LINES: usize = 10;

val EXCERPT_WIDTH: usize = 120;
val EXCERPT_LEAD:  usize = 40;
val EXCERPT_MARK:  str   = "...";

# the part of a source line a snippet shows, at most EXCERPT_WIDTH bytes of it
# ---
# start:     the first byte shown
# end:       the byte past the last one shown
# cut_left:  bytes before start were cut, marked with EXCERPT_MARK
# cut_right: bytes past end were cut, marked with EXCERPT_MARK
rec Excerpt {
    start:     usize;
    end:       usize;
    cut_left:  bool;
    cut_right: bool;
}

# the bytes of a source line a diagnostic's span covers
# ---
# from: the first byte marked
# to:   the byte past the last one marked
rec MarkRange {
    from: usize;
    to:   usize;
}

# the part of the line `b` the span from `off` to `end` covers, an end that falls outside the
# line taken at the line's own edge
fun mark_range(b: base_source.Span, off: usize, end: usize) MarkRange {
    val bs: usize = b.offset;
    val be: usize = base_source.span_end(b);
    var r:  MarkRange;
    r.from = bs;
    if (off > bs && off <= be) { r.from = off; }
    r.to = be;
    if (end >= bs && end <= be) { r.to = end; }
    if (r.to < r.from)          { r.to = r.from; }
    ret r;
}

# the window of the line `b` a snippet shows: the whole line when it fits EXCERPT_WIDTH, otherwise
# a window that starts EXCERPT_LEAD bytes before the mark `m` where it can
fun excerpt_of(b: base_source.Span, m: MarkRange) Excerpt {
    val bs: usize = b.offset;
    val be: usize = base_source.span_end(b);
    var x:  Excerpt;
    x.start     = bs;
    x.end       = be;
    x.cut_left  = false;
    x.cut_right = false;
    if (be - bs <= EXCERPT_WIDTH) { ret x; }
    var ws: usize = bs;
    if (m.from > bs + EXCERPT_LEAD) { ws = m.from - EXCERPT_LEAD; }
    var we: usize = ws + EXCERPT_WIDTH;
    if (we > be) {
        we = be;
        if (we - bs > EXCERPT_WIDTH) { ws = we - EXCERPT_WIDTH; }
        or                           { ws = bs; }
    }
    x.start     = ws;
    x.end       = we;
    x.cut_left  = ws > bs;
    x.cut_right = we < be;
    ret x;
}

# render every diagnostic of a store through a command's report: as text, counted into the
# tally the report closes with, or a record each under json
# ---
# r:       the command's report
# sources: the SourceMap that locates each diagnostic
# list:    the diagnostics, in order
pub fun report_store(r: *Report, sources: *base_source.SourceMap, list: *diagnostic.DiagnosticStore) {
    if (r.format == FORMAT_HUMAN) {
        render_store(r, sources, list);
        ret;
    }
    render_store_records(r, sources, list, report_paths(r));
}

# render every diagnostic of a store as text on the report's stream, a blank line between
# them, counting each into the tally the report closes with
fun render_store(r: *Report, sources: *base_source.SourceMap, list: *diagnostic.DiagnosticStore) {
    val total: usize = diagnostic.len(list);
    var i:     usize = 0;
    for (i < total) {
        val d: *diagnostic.Diagnostic = ?list.items.data[i];
        if (i > 0) { std_format.write_str(?r.w, "\n"); }
        render(?r.w, sources, d);
        count_record(r, d);
        i = i + 1;
    }
}

# a located span of one source file, clamped to its text
# ---
# sf:     the file
# off:    the span's first byte
# end:    the byte past its last
# line_s: the line of its first byte
# line_e: the line of its last byte
# col_s:  the column of its first byte
rec Frame {
    sf:     *base_source.SourceFile;
    off:    usize;
    end:    usize;
    line_s: usize;
    line_e: usize;
    col_s:  usize;
}

# the frame of `loc` in `sources`, none when the map is nil or does not hold its file
fun locate(sources: *base_source.SourceMap, loc: base_source.Location) opt[Frame] {
    if (sources == nil) { ret opt[Frame].none{}; }
    val opt_file: opt[*base_source.SourceFile] = base_source.get(sources, loc.file);
    if (sel opt_file.none) { ret opt[Frame].none{}; }
    val sf: *base_source.SourceFile = opt_file.some;

    val text_len: usize = str_len(sf.text);

    var off: usize = loc.span.offset;
    if (off > text_len) { off = text_len; }
    var end: usize = loc.span.offset + loc.span.len;
    if (end > text_len) { end = text_len; }
    if (end < off)      { end = off; }

    val start_pos: base_source.Position = base_source.position(sf, off);
    var last:      usize                = off;
    if (end > off) { last = end - 1; }
    val end_pos: base_source.Position = base_source.position(sf, last);

    var f: Frame;
    f.sf     = sf;
    f.off    = off;
    f.end    = end;
    f.line_s = start_pos.line;
    f.line_e = end_pos.line;
    f.col_s  = start_pos.col;
    ret opt[Frame].some{f};
}

fun render(out: *io_writer.Writer, sources: *base_source.SourceMap, d: *diagnostic.Diagnostic) {
    emit_headline(out, d.kind, d.message);

    val opt_pf: opt[Frame] = locate(sources, d.loc);
    val w:      usize      = gutter_width(sources, d, opt_pf);

    var framed: bool = false;
    if (sel opt_pf.some) {
        var pf: Frame = opt_pf.some;
        emit_frame(out, ?pf, w, "^", nil);
        framed = true;
    }

    var i: usize = 0;
    for (i < d.related.len) {
        val rel:    *annotation.Related = ?d.related.data[i];
        val opt_rf: opt[Frame]          = locate(sources, rel.loc);
        if (sel opt_rf.some) {
            var rf: Frame = opt_rf.some;
            emit_frame(out, ?rf, w, "-", rel.label);
            framed = true;
        }
        i = i + 1;
    }

    emit_trailer(out, sources, d, framed, w);
}

fun gutter_width(sources: *base_source.SourceMap, d: *diagnostic.Diagnostic, opt_pf: opt[Frame]) usize {
    var w: usize = 1;
    if (sel opt_pf.some) { w = decimal_width(opt_pf.some.line_e); }

    var i: usize = 0;
    for (i < d.related.len) {
        val opt_rf: opt[Frame] = locate(sources, d.related.data[i].loc);
        if (sel opt_rf.some) {
            val rw: usize = decimal_width(opt_rf.some.line_e);
            if (rw > w) { w = rw; }
        }
        i = i + 1;
    }
    ret w;
}

fun emit_frame(out: *io_writer.Writer, f: *Frame, w: usize, head: str, label: str) {
    emit_loc(out, w, f.sf.path, f.line_s, f.col_s, label);
    emit_snippet(out, f.sf, w, f.line_s, f.line_e, f.off, f.end, head);
}

fun emit_trailer(out: *io_writer.Writer, sources: *base_source.SourceMap, d: *diagnostic.Diagnostic, framed: bool, w: usize) {
    if (!has_trailer(sources, d)) { ret; }

    var indent: usize = 2;
    if (framed) { indent = w + 1; }

    var i: usize = 0;
    for (i < d.related.len) {
        val rel:        *annotation.Related = ?d.related.data[i];
        val opt_locate: opt[Frame]          = locate(sources, rel.loc);
        if (rel.label != nil && sel opt_locate.none) {
            emit_tagged(out, "note", rel.label, indent);
        }
        i = i + 1;
    }

    var c: usize = 0;
    for (c < d.children.len) {
        val child: *diagnostic.Child = ?d.children.data[c];
        if (child.kind == diagnostic.CHILD_HELP) { emit_tagged(out, "help", child.text, indent); }
        or                                       { emit_tagged(out, "note", child.text, indent); }
        c = c + 1;
    }
}

fun has_trailer(sources: *base_source.SourceMap, d: *diagnostic.Diagnostic) bool {
    if (d.children.len > 0) { ret true; }

    var i: usize = 0;
    for (i < d.related.len) {
        val opt_locate: opt[Frame] = locate(sources, d.related.data[i].loc);
        if (d.related.data[i].label != nil && sel opt_locate.none) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun emit_snippet(out: *io_writer.Writer, sf: *base_source.SourceFile, w: usize, line_s: usize, line_e: usize, off: usize, end: usize, head: str) {
    if (line_e <= line_s) {
        emit_source_line(out, sf, w, line_s, off, end);
        emit_underline(out, sf, w, line_s, off, end, head);
        ret;
    }

    if (line_e - line_s + 1 <= MAX_SPAN_LINES) {
        var l: usize = line_s;
        for (l <= line_e) {
            emit_source_line(out, sf, w, l, off, end);
            if (l == line_s) { emit_underline(out, sf, w, l, off, end, head); }
            or               { emit_underline(out, sf, w, l, off, end, "-"); }
            l = l + 1;
        }
        ret;
    }

    emit_source_line(out, sf, w, line_s, off, end);
    emit_underline(out, sf, w, line_s, off, end, head);
    emit_elision(out, w);
    emit_source_line(out, sf, w, line_e, off, end);
    emit_underline(out, sf, w, line_e, off, end, "-");
}

fun emit_source_line(out: *io_writer.Writer, sf: *base_source.SourceFile, w: usize, line: usize, off: usize, end: usize) {
    val opt_bounds: opt[base_source.Span] = base_source.line_bounds(sf, line);
    if (sel opt_bounds.none) { ret; }
    val b: base_source.Span = opt_bounds.some;
    val x: Excerpt          = excerpt_of(b, mark_range(b, off, end));

    emit_gutter_num(out, w, line);
    if (x.cut_left) { std_format.write_str(out, EXCERPT_MARK); }
    if (x.end > x.start) {
        std_format.write_bytes(out, ?sf.text[x.start], x.end - x.start);
    }
    if (x.cut_right) { std_format.write_str(out, EXCERPT_MARK); }
    std_format.write_str(out, "\n");
}

fun emit_underline(out: *io_writer.Writer, sf: *base_source.SourceFile, w: usize, line: usize, off: usize, end: usize, glyph: str) {
    val opt_bounds: opt[base_source.Span] = base_source.line_bounds(sf, line);
    if (sel opt_bounds.none) { ret; }
    val b:         base_source.Span = opt_bounds.some;
    val m:         MarkRange        = mark_range(b, off, end);
    val x:         Excerpt          = excerpt_of(b, m);
    val mark_from: usize            = m.from;
    var mark_to:   usize            = m.to;
    if (mark_to > x.end) { mark_to = x.end; }

    emit_gutter_bar(out, w);

    if (x.cut_left) { emit_spaces(out, str_len(EXCERPT_MARK)); }
    var i: usize = x.start;
    for (i < mark_from) {
        if (sf.text[i] == '\t') { std_format.write_str(out, "\t"); }
        or                      { std_format.write_str(out, " "); }
        i = i + 1;
    }

    var n: usize = mark_to - mark_from;
    if (n == 0) { n = 1; }
    var j: usize = 0;
    for (j < n) {
        std_format.write_str(out, glyph);
        j = j + 1;
    }
    std_format.write_str(out, "\n");
}

# `@ path:line:col` and the place's label, the `@` in the gutter's bar column
fun emit_loc(out: *io_writer.Writer, w: usize, path: str, line: usize, col: usize, label: str) {
    emit_spaces(out, w + 1);
    std_format.write_str(out, "@ ");
    std_format.write_str(out, path);
    std_format.write_str(out, ":");
    std_format.write_u64(out, line::u64);
    std_format.write_str(out, ":");
    std_format.write_u64(out, col::u64);
    if (label != nil) {
        std_format.write_str(out, " ");
        std_format.write_str(out, label);
    }
    std_format.write_str(out, "\n");
}

fun emit_elision(out: *io_writer.Writer, w: usize) {
    emit_spaces(out, w);
    std_format.write_str(out, " | ...\n");
}

fun emit_gutter_num(out: *io_writer.Writer, w: usize, line: usize) {
    emit_spaces(out, w - decimal_width(line));
    std_format.write_u64(out, line::u64);
    std_format.write_str(out, " | ");
}

fun emit_gutter_bar(out: *io_writer.Writer, w: usize) {
    emit_spaces(out, w);
    std_format.write_str(out, " | ");
}

fun emit_tagged(out: *io_writer.Writer, tag: str, text: str, indent: usize) {
    emit_spaces(out, indent);
    std_format.write_str(out, tag);
    std_format.write_str(out, " ");
    std_format.write_str(out, text);
    std_format.write_newline(out);
}

fun emit_summary(out: *io_writer.Writer, errors: usize, warnings: usize) {
    std_format.write_u64(out, errors::u64);
    if (errors == 1) { std_format.write_str(out, " error"); }
    or               { std_format.write_str(out, " errors"); }
    std_format.write_str(out, " / ");
    std_format.write_u64(out, warnings::u64);
    if (warnings == 1) { std_format.write_str(out, " warning"); }
    or                 { std_format.write_str(out, " warnings"); }
    std_format.write_str(out, "\n");
}

# the kind's severity, then its key where it names one: `warning[vector.scalarize] `
fun emit_lead(out: *io_writer.Writer, k: diagnostic_kind.Kind) {
    std_format.write_str(out, severity_name(k));
    val key: str = diagnostic_kind.key_of(k);
    if (key != nil) {
        std_format.write_str(out, "[");
        std_format.write_str(out, key);
        std_format.write_str(out, "]");
    }
    std_format.write_str(out, " ");
}

fun emit_headline(out: *io_writer.Writer, k: diagnostic_kind.Kind, message: str) {
    emit_lead(out, k);
    std_format.write_str(out, message);
    std_format.write_newline(out);
}

fun emit_spaces(out: *io_writer.Writer, n: usize) {
    var i: usize = 0;
    for (i < n) {
        std_format.write_str(out, " ");
        i = i + 1;
    }
}

fun decimal_width(n: usize) usize {
    var digits: [std_format.DECIMAL_MAX]u8;
    ret std_format.put_u64(?digits[0], n::u64);
}

# the severity a kind's row declares, as the headline and a record name it
fun severity_name(k: diagnostic_kind.Kind) str {
    if (diagnostic_kind.is_error(k)) { ret "error"; }
    if (diagnostic_kind.is_note(k))  { ret "note"; }
    ret "warning";
}

fun stderr_writer() io_writer.Writer {
    ret fs.writer(fs.STDERR);
}

# a carried failure, rendered as the diagnostic it reads as: its headline, the snippet at its
# place and its related places. a reported failure writes nothing, its diagnostics having been
# rendered already
fun render_fail_w(w: *io_writer.Writer, sources: *base_source.SourceMap, f: *fail.Fail) i64 {
    if (sel f.reported) { ret exit.of(@f); }
    var fx: annotation.Fix;
    var d:  diagnostic.Diagnostic = failure_view(f, diagnostic.ORIGIN_NONE, ?fx);
    render(w, sources, ?d);
    ret exit.of(@f);
}

# the diagnostic a carried failure reads as: its kind, text and origin, at its place, naming its
# related places and its fix. the view borrows them from the failure, its fix through `fix`,
# which must outlive it
fun failure_view(f: *fail.Fail, origin: diagnostic.Origin, fix: *annotation.Fix) diagnostic.Diagnostic {
    var d: diagnostic.Diagnostic;
    d.kind    = fail.kind_of(@f);
    d.origin  = origin;
    d.loc     = base_source.location_nil();
    d.message = fail.describe(@f);
    val opt_placed: opt[base_source.Location] = fail.place_of(@f);
    if (sel opt_placed.some) { d.loc = opt_placed.some; }
    d.children = collections_vector.init[diagnostic.Child](nil);
    d.related  = fail.related_of(@f);
    d.fixes    = collections_vector.init[annotation.Fix](nil);
    val opt_fixed: opt[annotation.Fix] = fail.fix_of(@f);
    if (sel opt_fixed.some) {
        @fix         = opt_fixed.some;
        d.fixes.data = fix;
        d.fixes.len  = 1;
        d.fixes.cap  = 1;
    }
    ret d;
}

# print a Fail to stderr as the diagnostic it reads as, and map it to an exit code
# a reported Fail prints nothing, its diagnostics having been rendered already
# ---
# sources: the source map the failure's places are in, nil when it can point at none
# f:       the Fail
# ret:     the exit code `exit.of` maps the failure to
pub fun render_fail(sources: *base_source.SourceMap, f: *fail.Fail) i64 {
    var w: io_writer.Writer = stderr_writer();
    ret render_fail_w(?w, sources, f);
}

# render_fail for a failure built in place
# ---
# sources: the source map the failure's places are in, nil when it can point at none
# f:       the Fail
# ret:     the exit code `exit.of` maps the failure to
pub fun refuse(sources: *base_source.SourceMap, f: fail.Fail) i64 {
    ret render_fail(sources, ?f);
}

fun package_said(ctx: ptr, v: layout.Verb, texts: *str, n: usize) {
    said_row(out(ctx::*Report), v, texts, n);
}

# a remark of the dependency work, beneath the progress lines it belongs to
fun package_line(ctx: ptr, text: str) {
    val w: *io_writer.Writer = out(ctx::*Report);
    layout.beneath(w);
    std_format.format(w, "{}\n", text);
}

fun package_note(ctx: ptr, text: str) {
    report_note(ctx::*Report, diagnostic_kind.DEP_NOTE, text);
}

fun package_fault(ctx: ptr, f: fail.Fail) {
    val code: i64 = report_fail(ctx::*Report, f, diagnostic.ORIGIN_NONE);
}

# where a dependency command reports: progress on standard output, and notes and failures,
# the ones the command goes on past too, through the command's report
# ---
# a:   owns the report's effect notes
# r:   the command's report, in the format `--report` selected
# ret: the report, released with `report.dnit`
pub fun dependency_report(a: *A.Allocator, r: *Report) report.Report {
    ret report.init(a, r::ptr, package_said, package_line, package_note, package_fault);
}

# show how a dependency command ended: its failure, then a note for each change it made
# before failing
# ---
# rep:     the report the command used
# outcome: how it ended
# ret:     exit.OK, or the code `exit.of` maps the failure to
pub fun dependency_outcome(rep: *report.Report, outcome: err[fail.Fail]) i64 {
    if (sel outcome.ok) { ret exit.OK; }
    val code: i64   = report_fail(rep.ctx::*Report, outcome.err, diagnostic.ORIGIN_NONE);
    var i:    usize = 0;
    for (i < rep.effects.len) {
        report_note(rep.ctx::*Report, diagnostic_kind.DEP_EFFECT, rep.effects.data[i]);
        i = i + 1;
    }
    ret code;
}

# map a build outcome's severity to the process exit code
# ---
# bo:  the outcome
# ret: the shared exit code of the severity; a severity outside the catalog
# is an internal failure written to `w` naming the catalog and the tag
fun outcome_code_w(w: *io_writer.Writer, bo: *outcome.BuildOutcome) i64 {
    if (bo.severity == outcome.BUILD_OK)          { ret exit.OK; }
    if (bo.severity == outcome.BUILD_USER)        { ret exit.USER; }
    if (bo.severity == outcome.BUILD_INTERNAL)    { ret exit.INTERNAL; }
    if (bo.severity == outcome.BUILD_ENVIRONMENT) { ret exit.ENVIRONMENT; }
    std_format.format(w, "error[{}] unknown BuildSeverity tag {}\n", diagnostic_kind.key_of(diagnostic_kind.COMPILER_INTERNAL), bo.severity);
    ret exit.INTERNAL;
}

# map a build outcome's severity to the process exit code, an unknown severity reported to stderr
# ---
# bo:  the outcome
# ret: the shared exit code of the severity, exit.INTERNAL for one outside the catalog
pub fun outcome_code(bo: *outcome.BuildOutcome) i64 {
    var w: io_writer.Writer = stderr_writer();
    ret outcome_code_w(?w, bo);
}

# the -v table's number columns: a row's count and its time
val COUNT_W: usize = 5;
val TIME_W:  usize = 6;

# the row labels the renderer adds to the phase table's: the header's, the unit's unaccounted
# time, its wall time, and a growing cycle's line
val STAGE_LABEL:  str = "stage";
val OTHER_LABEL:  str = "other";
val TOTAL_LABEL:  str = "total";
val GROWTH_LABEL: str = "instantiate";

# the mark of a row whose time is summed over worker threads, explained once beneath the table
val SUMMED_MARK: str = "*";

# the lead of a line under a test failure, past its `FAIL  `
val DETAIL: str = "      ";

# the widest line a live progress line takes, so a terminal never wraps it
val LIVE_WIDTH: usize = 79;

# a row of the -v table, held until the unit closes so its bars scale to the largest: a phase
# row, or with `item` an item of the phase that processed it, `name` naming the item or the
# row's slowest item
rec StageRow {
    item:    bool;
    shown:   bool;
    phase:   readout.Phase;
    count:   u32;
    noun:    readout.Noun;
    elapsed: chrono_duration.Duration;
    threads: u32;
    dropped: u32;
    name:    str;
    slowest: chrono_duration.Duration;
}

# one module's counters under -vv, those it posted `has`
rec ModuleRow {
    name:   str;
    values: [readout.COUNTER_COUNT]u64;
    has:    [readout.COUNTER_COUNT]bool;
}

# a unit's summary held for the one table that closes a selection of several units: what it
# closed, whether it found everything current, and the text of each column, by UnitColumn
rec UnitRow {
    closed:    readout.Closed;
    unchanged: bool;
    cells:     [UNIT_COLUMNS]str;
}

# a column of the units table, and its header
def UnitColumn: usize;

val UNIT_TARGET:   UnitColumn = 0;
val UNIT_ARTIFACT: UnitColumn = 1;
val UNIT_PROFILE:  UnitColumn = 2;
val UNIT_MODULES:  UnitColumn = 3;
val UNIT_SIZE:     UnitColumn = 4;
val UNIT_TIME:     UnitColumn = 5;
val UNIT_COLUMNS:  usize      = 6;

val UNIT_HEADS: [UNIT_COLUMNS]str = [UNIT_COLUMNS]str{"target", "artifact", "profile", "modules", "size", "time"};

fun unit_banner_w(w: *io_writer.Writer, ev: *readout.Unit) {
    var texts: [3]str           = [3]str{ev.target, ev.artifact, ev.profile};
    var cols:  [3]layout.Column = [3]layout.Column{layout.Column{width: 0, align: layout.LEFT, gap: 0}, layout.Column{width: 0, align: layout.LEFT, gap: layout.GAP},
        layout.Column{width: 0, align: layout.LEFT, gap: layout.GAP}};
    std_format.write_newline(w);
    layout.row(w, ?cols[0], ?texts[0], 3);
}

# the arena the renderer keeps what it holds in, the report's, armed on first use; nil, with
# the refusal kept by the report, when it cannot be made
fun held_alloc(rd: *Readout) *A.Allocator {
    if (rd.a != nil)               { ret rd.a; }
    if (report_paths(rd.r) == nil) { ret nil; }
    rd.a       = ?rd.r.a;
    rd.rows    = collections_vector.init[StageRow](rd.a);
    rd.modules = collections_vector.init[ModuleRow](rd.a);
    rd.done    = collections_vector.init[UnitRow](rd.a);
    ret rd.a;
}

# a copy of s in the renderer's arena, s itself when it cannot be kept
fun kept(rd: *Readout, s: str) str {
    if (s == nil) { ret nil; }
    val res_copy: res[str, A.Error] = str_dup(rd.a, s);
    if (sel res_copy.err) {
        refused(rd.r, fail.refused(res_copy.err));
        ret s;
    }
    ret res_copy.ok;
}

fun hold_row(rd: *Readout, row: StageRow) {
    if (held_alloc(rd) == nil) { ret; }
    var r: StageRow = row;
    r.name = kept(rd, row.name);
    val res_pushed: res[usize, A.Error] = collections_vector.push[StageRow](?rd.rows, r);
    if (sel res_pushed.err) { refused(rd.r, fail.refused(res_pushed.err)); }
}

fun phase_held(rd: *Readout, ev: *readout.PhaseEnd) {
    hold_row(rd, StageRow{item: false, shown: false, phase: ev.phase, count: ev.count, noun: ev.noun, elapsed: ev.elapsed, threads: ev.threads,
        dropped: ev.dropped, name: ev.slowest, slowest: ev.slowest_elapsed});
}

fun item_held(rd: *Readout, ev: *readout.Item) {
    hold_row(rd, StageRow{item: true, shown: false, phase: ev.phase, count: 0, noun: 0, elapsed: ev.elapsed, threads: 0, dropped: 0, name: ev.name, slowest: 0});
}

# a counter's value as a person reads it: a size for a count of bytes, else grouped digits
fun counter_text(t: *layout.Text, c: readout.Counter, value: u64) str {
    if (readout.counter_bytes(c)) { ret layout.size(t, value); }
    ret layout.grouped(t, value);
}

# a counter's value: the unit's total, held for the counter lines, or one module's, held for
# the module table under -vv
fun tally_held(rd: *Readout, ev: *readout.Tally) {
    if (ev.name == nil) {
        rd.counts[ev.counter] = ev.value;
        rd.held[ev.counter]   = true;
        rd.holding            = true;
        ret;
    }
    if (held_alloc(rd) == nil) { ret; }
    var i: usize = 0;
    for (i < rd.modules.len && !str_equals(rd.modules.data[i].name, ev.name)) { i = i + 1; }
    if (i == rd.modules.len) {
        var m: ModuleRow;
        m.name = kept(rd, ev.name);
        var c: usize = 0;
        for (c < readout.COUNTER_COUNT) {
            m.has[c] = false;
            c        = c + 1;
        }
        val res_pushed: res[usize, A.Error] = collections_vector.push[ModuleRow](?rd.modules, m);
        if (sel res_pushed.err) {
            refused(rd.r, fail.refused(res_pushed.err));
            ret;
        }
    }
    rd.modules.data[i].values[ev.counter] = ev.value;
    rd.modules.data[i].has[ev.counter]    = true;
}

# the -v table of a unit: a header, each phase row with its bar and, under -vv, its items, the
# `other` and `total` rows when the unit closed, the legend of the summed mark, then the
# counter lines and under -vv the module table. what it held is let go
fun stage_table(rd: *Readout, w: *io_writer.Writer, sum: *readout.Summary) {
    val closing: bool = sum != nil && sum.rows;
    if (rd.rows.len == 0 && !closing && !rd.holding) { ret; }
    var label_w: usize = readout.label_width();
    if (str_len(GROWTH_LABEL) > label_w) { label_w = str_len(GROWTH_LABEL); }
    var cols: [6]layout.Column = [6]layout.Column{
        layout.Column{width: label_w, align: layout.LEFT, gap: 0},
        layout.Column{width: COUNT_W, align: layout.RIGHT, gap: layout.GAP},
        layout.Column{width: readout.noun_width(), align: layout.LEFT, gap: 1},
        layout.Column{width: TIME_W, align: layout.RIGHT, gap: layout.GAP},
        layout.Column{width: 1, align: layout.LEFT, gap: 1},
        layout.Column{width: 0, align: layout.LEFT, gap: layout.GAP},
    };
    var most:    u64   = 0;
    var threads: u32   = 0;
    var mixed:   bool  = false;
    var i:       usize = 0;
    for (i < rd.rows.len) {
        val row: *StageRow = ?rd.rows.data[i];
        i = i + 1;
        if (row.item)                { cnt; }
        if (row.elapsed::u64 > most) { most = row.elapsed::u64; }
        if (row.threads > 1) {
            if (threads != 0 && threads != row.threads) { mixed = true; }
            if (row.threads > threads)                  { threads = row.threads; }
        }
    }
    if (closing && sum.other::u64 > most) { most = sum.other::u64; }
    if (rd.rows.len > 0 || closing) {
        var head: [4]str = [4]str{STAGE_LABEL, "count", nil, "time"};
        layout.row(w, ?cols[0], ?head[0], 4);
    }
    i = 0;
    for (i < rd.rows.len) {
        val row: *StageRow = ?rd.rows.data[i];
        i = i + 1;
        if (row.item) { cnt; }
        stage_row_w(w, ?cols[0], row, most);
        items_w(rd, w, ?cols[0], row.phase);
    }
    items_w(rd, w, ?cols[0], readout.PHASE_NONE);
    if (closing) {
        var ot:    layout.Text;
        var bt:    layout.Text;
        var other: [6]str = [6]str{OTHER_LABEL, nil, nil, layout.duration(?ot, sum.other), nil, layout.bar_text(?bt, layout.bar_length(sum.other::u64, most))};
        layout.row(w, ?cols[0], ?other[0], 6);
        var tt:    layout.Text;
        var total: [4]str = [4]str{TOTAL_LABEL, nil, nil, layout.duration(?tt, sum.total)};
        layout.row(w, ?cols[0], ?total[0], 4);
    }
    if (threads > 0) {
        if (mixed) { std_format.format(w, "{} summed over up to {} threads\n", SUMMED_MARK, threads::u64); }
        or         { std_format.format(w, "{} summed over {} threads\n", SUMMED_MARK, threads::u64); }
    }
    counter_lines(rd, w);
    module_table(rd, w);
    rd.rows.len    = 0;
    rd.modules.len = 0;
}

fun stage_row_w(w: *io_writer.Writer, cols: *layout.Column, row: *StageRow, most: u64) {
    var nt:   layout.Text;
    var dt:   layout.Text;
    var bt:   layout.Text;
    var mark: str = nil;
    if (row.threads > 1) { mark = SUMMED_MARK; }
    var texts: [6]str = [6]str{readout.label_of(row.phase), layout.count(?nt, row.count::u64), readout.noun_of(row.noun, row.count::u64),
        layout.duration(?dt, row.elapsed), mark, layout.bar_text(?bt, layout.bar_length(row.elapsed::u64, most))};
    layout.cells(w, cols, ?texts[0], 6);
    if (row.dropped > 0) { std_format.format(w, "  ({} target-gated, not carried forward)", row.dropped::i64); }
    if (row.name != nil) {
        var st: layout.Text;
        std_format.format(w, "  (slowest {} {})", row.name, layout.duration(?st, row.slowest));
    }
    std_format.write_newline(w);
}

# the items held of `phase`, each its time in the time column and its name after, then marked
# shown; PHASE_NONE shows every item no row took
fun items_w(rd: *Readout, w: *io_writer.Writer, cols: *layout.Column, phase: readout.Phase) {
    var i: usize = 0;
    for (i < rd.rows.len) {
        val it: *StageRow = ?rd.rows.data[i];
        i = i + 1;
        if (!it.item || it.shown)                             { cnt; }
        if (phase != readout.PHASE_NONE && it.phase != phase) { cnt; }
        it.shown = true;
        var dt:    layout.Text;
        var texts: [4]str = [4]str{nil, nil, nil, layout.duration(?dt, it.elapsed)};
        layout.cells(w, cols, ?texts[0], 4);
        layout.aside(w, it.name);
        std_format.write_newline(w);
    }
}

# the counter totals as two lines: what the code came to, and what building it took of memory
fun counter_lines(rd: *Readout, w: *io_writer.Writer) {
    if (!rd.holding) { ret; }
    var code: bool  = false;
    var c:    usize = 0;
    for (c < readout.COUNTER_COUNT) {
        if (rd.held[c] && readout.counter_group(c::readout.Counter) == readout.GROUP_CODE) { code = true; }
        c = c + 1;
    }
    if (code) {
        std_format.write_str(w, "code  ");
        c = 0;
        for (c < readout.COUNTER_COUNT) {
            if (rd.held[c] && readout.counter_group(c::readout.Counter) == readout.GROUP_CODE) {
                var t: layout.Text;
                std_format.format(w, "  {} {}", counter_text(?t, c::readout.Counter, rd.counts[c]), readout.counter_word(c::readout.Counter, rd.counts[c]));
            }
            c = c + 1;
        }
        std_format.write_newline(w);
    }
    val peak:   bool = rd.held[readout.HEAP_PEAK];
    val bytes:  bool = rd.held[readout.ALLOCATED_BYTES];
    val blocks: bool = rd.held[readout.ALLOCATED_BLOCKS];
    if (peak || bytes || blocks) {
        std_format.write_str(w, "memory");
        var pt: layout.Text;
        var at: layout.Text;
        var kt: layout.Text;
        if (peak)  { std_format.format(w, "  {} peak", layout.size(?pt, rd.counts[readout.HEAP_PEAK])); }
        if (bytes) { std_format.format(w, "  {} allocated", layout.size(?at, rd.counts[readout.ALLOCATED_BYTES])); }
        val nblocks: u64 = rd.counts[readout.ALLOCATED_BLOCKS];
        val wblocks: str = readout.counter_word(readout.ALLOCATED_BLOCKS, nblocks);
        if (bytes && blocks) { std_format.format(w, " in {} {}", layout.grouped(?kt, nblocks), wblocks); }
        or (blocks)          { std_format.format(w, "  {} {}", layout.grouped(?kt, nblocks), wblocks); }
        std_format.write_newline(w);
    }
    c = 0;
    for (c < readout.COUNTER_COUNT) {
        rd.held[c] = false;
        c          = c + 1;
    }
    rd.holding = false;
}

# each module's counters under -vv, a row a module and a column a counter any module posted,
# headed by the counters' labels
fun module_table(rd: *Readout, w: *io_writer.Writer) {
    if (rd.modules.len == 0) { ret; }
    var shown: [readout.COUNTER_COUNT]bool;
    var cols:  [readout.COUNTER_COUNT + 1]layout.Column;
    var texts: [readout.COUNTER_COUNT + 1]str;
    cols[0] = layout.Column{width: str_len("module"), align: layout.LEFT, gap: 0};
    var c: usize = 0;
    for (c < readout.COUNTER_COUNT) {
        shown[c]    = false;
        cols[c + 1] = layout.Column{width: str_len(readout.counter_label(c::readout.Counter)), align: layout.RIGHT, gap: layout.GAP};
        c           = c + 1;
    }
    var i: usize = 0;
    for (i < rd.modules.len) {
        val m: *ModuleRow = ?rd.modules.data[i];
        layout.fit(?cols[0], m.name);
        c = 0;
        for (c < readout.COUNTER_COUNT) {
            if (m.has[c]) {
                var t: layout.Text;
                shown[c] = true;
                layout.fit(?cols[c + 1], counter_text(?t, c::readout.Counter, m.values[c]));
            }
            c = c + 1;
        }
        i = i + 1;
    }
    c = 0;
    for (c < readout.COUNTER_COUNT) {
        if (!shown[c]) { cols[c + 1] = layout.Column{width: 0, align: layout.RIGHT, gap: 0}; }
        c = c + 1;
    }
    texts[0] = "module";
    c        = 0;
    for (c < readout.COUNTER_COUNT) {
        texts[c + 1] = nil;
        if (shown[c]) { texts[c + 1] = readout.counter_label(c::readout.Counter); }
        c = c + 1;
    }
    layout.row(w, ?cols[0], ?texts[0], readout.COUNTER_COUNT + 1);
    var vt: [readout.COUNTER_COUNT]layout.Text;
    i = 0;
    for (i < rd.modules.len) {
        val m: *ModuleRow = ?rd.modules.data[i];
        texts[0] = m.name;
        c        = 0;
        for (c < readout.COUNTER_COUNT) {
            texts[c + 1] = nil;
            if (m.has[c]) { texts[c + 1] = counter_text(?vt[c], c::readout.Counter, m.values[c]); }
            c = c + 1;
        }
        layout.row(w, ?cols[0], ?texts[0], readout.COUNTER_COUNT + 1);
        i = i + 1;
    }
}

# a growing cycle of instances as it expands, written at once so a runaway expansion shows
# while it runs
fun growth_row_w(w: *io_writer.Writer, ev: *readout.Growth) {
    std_format.format(w, "{}  growing cycle {} in {}: {} {} so far\n", GROWTH_LABEL, ev.members, ev.module, ev.instances::usize, layout.noun(ev.instances::u64, "instance", "instances"));
}

# whether a unit found everything current: it compiled nothing and wrote nothing
fun unchanged(ev: *readout.Summary) bool {
    ret ev.closed != readout.CLOSED_CHECKED && ev.compiled == 0 && !ev.written;
}

# what a summary says of its modules: all of them when the build compiled every unit, else how
# many of its units it rebuilt
fun modules_text(t: *layout.Text, ev: *readout.Summary) str {
    var noun: str = layout.noun(ev.units::u64, "module", "modules");
    if (ev.units != ev.modules) { noun = layout.noun(ev.units::u64, "object", "objects"); }
    var w: io_writer.Writer = layout.text_writer(t);
    if (ev.compiled == ev.units) { std_format.format(?w, "{} {}", ev.modules::u64, layout.noun(ev.modules::u64, "module", "modules")); }
    or                           { std_format.format(?w, "{} of {} {} rebuilt", ev.compiled::u64, ev.units::u64, noun); }
    ret layout.text_end(t);
}

# a unit's close: under -v its table first; then, alone in its plan, its own progress line, or
# among several, its row of the table the plan closes with. a test build's dispatcher is shown
# only under -v
fun summary_w(rd: *Readout, w: *io_writer.Writer, ev: *readout.Summary) {
    if (ev.rows)                                                                   { stage_table(rd, w, ev); }
    if (rd.quiet)                                                                  { ret; }
    if (ev.closed == readout.CLOSED_TESTS && rd.sink.level < readout.LEVEL_PHASES) { ret; }
    if (rd.units > 1) {
        unit_held(rd, ev);
        ret;
    }
    var dt:   layout.Text;
    val time: str              = layout.duration(?dt, ev.total);
    var line: [3]str           = [3]str{ev.artifact, ev.target, ev.profile};
    var cols: [4]layout.Column = [4]layout.Column{layout.Column{width: 0, align: layout.LEFT, gap: 0}, layout.Column{width: 0, align: layout.LEFT, gap: layout.GAP},
        layout.Column{width: 0, align: layout.LEFT, gap: layout.GAP}, layout.Column{width: 0, align: layout.LEFT, gap: 3}};
    if (ev.closed == readout.CLOSED_CHECKED || unchanged(ev)) {
        if (ev.closed == readout.CLOSED_CHECKED) { layout.said(w, layout.CHECKED); }
        or                                       { layout.said(w, layout.UNCHANGED); }
        var said: [4]str = [4]str{ev.artifact, ev.target, ev.profile, time};
        layout.row(w, ?cols[0], ?said[0], 4);
        ret;
    }
    layout.said(w, layout.BUILT);
    layout.row(w, ?cols[0], ?line[0], 3);
    layout.beneath(w);
    var mt:   layout.Text;
    var st:   layout.Text;
    var size: str = nil;
    if (ev.has_size) { size = layout.size(?st, ev.bytes::u64); }
    var detail: [4]str           = [4]str{ev.out, size, modules_text(?mt, ev), time};
    var dcols:  [4]layout.Column = [4]layout.Column{layout.Column{width: 0, align: layout.LEFT, gap: 0}, layout.Column{width: 0, align: layout.LEFT, gap: 3},
        layout.Column{width: 0, align: layout.LEFT, gap: 3}, layout.Column{width: 0, align: layout.LEFT, gap: 3}};
    layout.row(w, ?dcols[0], ?detail[0], 4);
}

fun unit_held(rd: *Readout, ev: *readout.Summary) {
    if (held_alloc(rd) == nil) { ret; }
    var mt:  layout.Text;
    var st:  layout.Text;
    var dt:  layout.Text;
    var row: UnitRow;
    row.closed               = ev.closed;
    row.unchanged            = unchanged(ev);
    row.cells[UNIT_TARGET]   = kept(rd, ev.target);
    row.cells[UNIT_ARTIFACT] = kept(rd, ev.artifact);
    row.cells[UNIT_PROFILE]  = kept(rd, ev.profile);
    row.cells[UNIT_MODULES]  = nil;
    row.cells[UNIT_SIZE]     = nil;
    row.cells[UNIT_TIME]     = kept(rd, layout.duration(?dt, ev.total));
    if (ev.closed != readout.CLOSED_CHECKED) { row.cells[UNIT_MODULES] = kept(rd, modules_text(?mt, ev)); }
    if (ev.has_size)                         { row.cells[UNIT_SIZE] = kept(rd, layout.size(?st, ev.bytes::u64)); }
    val res_pushed: res[usize, A.Error] = collections_vector.push[UnitRow](?rd.done, row);
    if (sel res_pushed.err) { refused(rd.r, fail.refused(res_pushed.err)); }
}

# the one table a selection of several units closes with, under one verb: checked when every
# unit was a check, unchanged when every unit found everything current, built otherwise. a
# column shows when any unit has text for it, and the profile only when the units differ in it
fun units_table(rd: *Readout, w: *io_writer.Writer) {
    if (rd.a == nil || rd.done.len == 0) { ret; }
    var checked: bool  = true;
    var same:    bool  = true;
    var shown:   [UNIT_COLUMNS]bool;
    var c:       usize = 0;
    for (c < UNIT_COLUMNS) {
        shown[c] = false;
        c        = c + 1;
    }
    var i: usize = 0;
    for (i < rd.done.len) {
        val u: *UnitRow = ?rd.done.data[i];
        if (u.closed != readout.CLOSED_CHECKED) { checked = false; }
        if (!u.unchanged)                       { same = false; }
        c = 0;
        for (c < UNIT_COLUMNS) {
            if (u.cells[c] != nil) { shown[c] = true; }
            c = c + 1;
        }
        i = i + 1;
    }
    shown[UNIT_PROFILE] = false;
    i                   = 1;
    for (i < rd.done.len) {
        if (!str_equals(rd.done.data[i].cells[UNIT_PROFILE], rd.done.data[0].cells[UNIT_PROFILE])) { shown[UNIT_PROFILE] = true; }
        i = i + 1;
    }
    var picked: [UNIT_COLUMNS]UnitColumn;
    var cols:   [UNIT_COLUMNS]layout.Column;
    var texts:  [UNIT_COLUMNS]str;
    var n:      usize = 0;
    c = 0;
    for (c < UNIT_COLUMNS) {
        if (shown[c]) {
            picked[n] = c;
            cols[n]   = layout.Column{width: 0, align: layout.LEFT, gap: layout.GAP};
            if (c == UNIT_SIZE || c == UNIT_TIME) { cols[n].align = layout.RIGHT; }
            layout.fit(?cols[n], UNIT_HEADS[c]);
            texts[n] = UNIT_HEADS[c];
            n        = n + 1;
        }
        c = c + 1;
    }
    cols[0].gap = 0;
    i           = 0;
    for (i < rd.done.len) {
        var k: usize = 0;
        for (k < n) {
            layout.fit(?cols[k], rd.done.data[i].cells[picked[k]]);
            k = k + 1;
        }
        i = i + 1;
    }
    if (checked) { layout.said(w, layout.CHECKED); }
    or (same)    { layout.said(w, layout.UNCHANGED); }
    or           { layout.said(w, layout.BUILT); }
    layout.row(w, ?cols[0], ?texts[0], n);
    i = 0;
    for (i < rd.done.len) {
        var k: usize = 0;
        for (k < n) {
            texts[k] = rd.done.data[i].cells[picked[k]];
            k        = k + 1;
        }
        layout.beneath(w);
        layout.row(w, ?cols[0], ?texts[0], n);
        i = i + 1;
    }
    rd.done.len = 0;
}

# the live progress line, rewritten in place: what the compile has done of its units and the
# last it finished, cut to fit LIVE_WIDTH
fun live_w(rd: *Readout, ev: *readout.Advance) {
    val w: *io_writer.Writer = ?rd.r.w;
    std_format.write_str(w, "\r\x1b[2K");
    layout.said(w, layout.COMPILING);
    var t:  layout.Text;
    var tw: io_writer.Writer = layout.text_writer(?t);
    std_format.format(?tw, "{} of {}", ev.done::u64, ev.total::u64);
    val counted: str = layout.text_end(?t);
    std_format.write_str(w, counted);
    val used: usize = layout.GUTTER + layout.GAP + str_len(counted) + 3;
    if (ev.name != nil && used < LIVE_WIDTH) {
        layout.spaces(w, 3);
        val room: usize = LIVE_WIDTH - used;
        var l:    usize = str_len(ev.name);
        if (l > room) { l = room; }
        std_format.write_bytes(w, ev.name, l);
    }
    rd.shown = true;
}

# clear the live progress line before anything else is written
fun live_clear(rd: *Readout) {
    if (!rd.shown) { ret; }
    std_format.write_str(?rd.r.w, "\r\x1b[2K");
    rd.shown = false;
}

# whether stderr is a terminal that can rewrite a line: a terminal whose TERM is set and not dumb
fun live_capable() bool {
    if (!terminal.is_terminal(2)) { ret false; }
    var buf:     [64]u8;
    val res_get: res[opt[usize], env.EnvError] = env.get("TERM", ?buf[0], 64);
    if (sel res_get.err) { ret false; }
    val opt_len: opt[usize] = res_get.ok;
    if (sel opt_len.none)   { ret false; }
    if (opt_len.some >= 64) { ret true; }
    ret opt_len.some > 0 && !str_equals((?buf[0])::str, "dumb");
}

# every command's events rendered the moment each arrives: the renderer of the
# readout contract (doc/language/readout.md). the report's stream, stderr,
# carries the build: human text renders a unit's progress line or, among several units, the
# table their plan closes with, under -v each unit's table, failures and diagnostics, and
# among several units each unit's first diagnostic or failure follows a line naming the unit,
# and the report counts what is rendered for its closing tally; the records modes write each diagnostic and failure as
# a record, and under -v each unit, phase row, item and counter. stdout carries a test run in
# human text: a module's row once its last test has finished, or each test under -v, then each
# failure once and the verdict. under the records modes the run is also records on the
# report's stream: run_start, a test record per finished test, and run_end
# ---
# sink:    what the engine and the test runner are given; its ctx is this record, which must not move
# r:       the command's report
# units:   the plan's unit count; one table closes a plan of more than one
# quiet:   `--quiet`, which suppresses the progress lines and banners
# cell:    the unit the events now arriving belong to, when `in_cell`
# named:   whether a line naming `cell` has been written
# live:    whether a live progress line is shown, and `shown` whether one is on the terminal now
# a:       the arena what is held lives in, nil until something is
# rows:    the -v table's rows, held until the unit closes
# modules: each module's counters under -vv
# done:    the summaries of a plan of several units
# run:     the running test run's results, from its run_start to its run_end
# count:   how many results run holds
# roll:    a module row's columns: module, time, then the ok, skip and FAIL counts
# line:    a test line's columns under -v: outcome, test, time
# counts:  the counter totals held until the unit's rows close, those `held`
# holding: whether any total is held
pub rec Readout {
    sink:    readout.Sink;
    r:       *Report;
    units:   usize;
    quiet:   bool;
    cell:    readout.Unit;
    in_cell: bool;
    named:   bool;
    live:    bool;
    shown:   bool;
    a:       *A.Allocator;
    rows:    Vector[StageRow];
    modules: Vector[ModuleRow];
    done:    Vector[UnitRow];
    run:     *readout.TestResult;
    count:   u32;
    roll:    [ROLL_COLS]layout.Column;
    line:    [3]layout.Column;
    counts:  [readout.COUNTER_COUNT]u64;
    held:    [readout.COUNTER_COUNT]bool;
    holding: bool;
}

# start rendering a command's events to r, a test run in human text to stdout
# ---
# rd:    the renderer, initialised in place since its sink points at it
# r:     the command's report
# units: the plan's unit count
# quiet: `--quiet`
# level: the readout level the command asked for, LEVEL_RESULTS to LEVEL_ITEMS
pub fun readout_begin(rd: *Readout, r: *Report, units: usize, quiet: bool, level: u8) {
    rd.sink.ctx      = rd::ptr;
    rd.sink.on_event = readout_on_event;
    rd.sink.level    = level;
    rd.r             = r;
    rd.units         = units;
    rd.quiet         = quiet;
    rd.in_cell       = false;
    rd.named         = false;
    rd.live          = r.format == FORMAT_HUMAN && !quiet && live_capable();
    rd.sink.live     = rd.live;
    rd.shown         = false;
    rd.a             = nil;
    rd.rows          = collections_vector.init[StageRow](nil);
    rd.modules       = collections_vector.init[ModuleRow](nil);
    rd.done          = collections_vector.init[UnitRow](nil);
    rd.run           = nil;
    rd.count         = 0;
    rd.holding       = false;
    var c: usize = 0;
    for (c < readout.COUNTER_COUNT) {
        rd.held[c] = false;
        c          = c + 1;
    }
}

fun readout_on_event(ctx: ptr, ev: *readout.Event) {
    val rd: *Readout = ctx::*Readout;
    if (sel ev.advance) {
        if (rd.live) { live_w(rd, ?ev.advance); }
        ret;
    }
    live_clear(rd);
    if (sel ev.run_start) {
        if (rd.r.format == FORMAT_HUMAN) { stage_table(rd, ?rd.r.w, nil); }
        run_begin(rd, ?ev.run_start);
        if (rd.r.format != FORMAT_HUMAN) { run_start_record(rd.r, ?ev.run_start); }
        ret;
    }
    if (sel ev.test_end) {
        test_human(rd, ev.test_end.at);
        report_test(rd.r, ?ev.test_end.tests[ev.test_end.at]);
        ret;
    }
    if (sel ev.run_end) {
        run_summary_w(rd, out(rd.r), ?ev.run_end);
        if (rd.r.format != FORMAT_HUMAN) { run_end_record(rd.r, ?ev.run_end); }
        rd.run   = nil;
        rd.count = 0;
        ret;
    }
    if (rd.r.format != FORMAT_HUMAN) { readout_records(rd, ev); }
    or                               { readout_human(rd, ev); }
}

fun readout_human(rd: *Readout, ev: *readout.Event) {
    val w: *io_writer.Writer = ?rd.r.w;
    # a unit that ends without a summary shows the table it held before what follows
    if (sel ev.unit || sel ev.failure || sel ev.diagnostics) { stage_table(rd, w, nil); }
    if (sel ev.unit) {
        rd.cell    = ev.unit;
        rd.in_cell = true;
        rd.named   = false;
        if (!rd.quiet && rd.sink.level >= readout.LEVEL_PHASES) { cell_named(rd, w); }
    }
    or (sel ev.phase)   { phase_held(rd, ?ev.phase); }
    or (sel ev.item)    { item_held(rd, ?ev.item); }
    or (sel ev.tally)   { tally_held(rd, ?ev.tally); }
    or (sel ev.growth)  { growth_row_w(w, ?ev.growth); }
    or (sel ev.summary) { summary_w(rd, w, ?ev.summary); }
    or (sel ev.failure) {
        if (!sel ev.failure.fail.reported) { cell_named(rd, w); }
        report_failure(rd.r, ev.failure.fail, ev.failure.origin);
    }
    or (sel ev.diagnostics) {
        cell_named(rd, w);
        render_store(rd.r, ev.diagnostics.sources, ev.diagnostics.diags);
    }
}

# among several units, the line naming the unit the events belong to, written once a unit
fun cell_named(rd: *Readout, w: *io_writer.Writer) {
    if (rd.units < 2 || !rd.in_cell || rd.named) { ret; }
    unit_banner_w(w, ?rd.cell);
    rd.named = true;
}

# the records member: a record for each event, each written as its event arrives. under -v
# every unit opens with a unit record naming its artifact, target and profile, and its summary
# writes the `other` phase record; every unit that built keeps its `built` line for the
# closing summary record
fun readout_records(rd: *Readout, ev: *readout.Event) {
    val r: *Report = rd.r;
    if (sel ev.failure) { report_failure(r, ev.failure.fail, ev.failure.origin); }
    or (sel ev.diagnostics) {
        render_store_records(r, ev.diagnostics.sources, ev.diagnostics.diags, report_paths(r));
    }
    or (sel ev.unit) {
        if (rd.sink.level >= readout.LEVEL_PHASES) { unit_record(r, ?ev.unit); }
    }
    or (sel ev.phase)   { phase_record(r, ?ev.phase); }
    or (sel ev.item)    { item_record(r, ?ev.item); }
    or (sel ev.tally)   { tally_record(r, ?ev.tally); }
    or (sel ev.growth)  { growth_record(r, ?ev.growth); }
    or (sel ev.summary) { summary_record(r, ?ev.summary); }
}

# close a plan's rendering: under human text the table a plan of several units closes with.
# the tally of what it rendered closes the report, in report_dnit
pub fun readout_end(rd: *Readout) {
    live_clear(rd);
    if (rd.r.format != FORMAT_HUMAN) { ret; }
    stage_table(rd, ?rd.r.w, nil);
    units_table(rd, ?rd.r.w);
}

# a duration as the integer microseconds a record carries
fun micros(d: chrono_duration.Duration) i64 {
    ret chrono_duration.duration_nsec(d) / 1000;
}

fun unit_record(r: *Report, ev: *readout.Unit) {
    var o: record.Record;
    record.begin(?r.w, enc(r), ?o, "unit");
    record.text(?o, "verb", ev.verb);
    record.text(?o, "artifact", ev.artifact);
    if (!str_is_empty(ev.target))  { record.text(?o, "target", ev.target); }
    if (!str_is_empty(ev.profile)) { record.text(?o, "profile", ev.profile); }
    record.end(?o);
}

fun phase_record(r: *Report, ev: *readout.PhaseEnd) {
    val noun: str = readout.noun_of(ev.noun, ev.count::u64);
    var o:    record.Record;
    record.begin(?r.w, enc(r), ?o, "phase");
    record.text(?o, "name", readout.label_of(ev.phase));
    record.int(?o, "count", ev.count::i64);
    record.text(?o, "unit", noun);
    record.int(?o, "time_us", micros(ev.elapsed));
    if (ev.threads > 1) { record.int(?o, "threads", ev.threads::i64); }
    if (ev.dropped > 0) { record.int(?o, "dropped", ev.dropped::i64); }
    if (ev.slowest != nil) {
        record.text(?o, "slowest", ev.slowest);
        record.int(?o, "slowest_us", micros(ev.slowest_elapsed));
    }
    record.end(?o);
}

fun item_record(r: *Report, ev: *readout.Item) {
    var o: record.Record;
    record.begin(?r.w, enc(r), ?o, "phase_item");
    record.text(?o, "phase", readout.label_of(ev.phase));
    record.text(?o, "name", ev.name);
    record.int(?o, "time_us", micros(ev.elapsed));
    record.end(?o);
}

# a counter's value: a module's, named by it, or the unit's total, with no name
fun tally_record(r: *Report, ev: *readout.Tally) {
    var o: record.Record;
    record.begin(?r.w, enc(r), ?o, "counter");
    record.text(?o, "counter", readout.counter_label(ev.counter));
    if (ev.name != nil) { record.text(?o, "name", ev.name); }
    record.int(?o, "value", ev.value::i64);
    record.end(?o);
}

fun growth_record(r: *Report, ev: *readout.Growth) {
    var o: record.Record;
    record.begin(?r.w, enc(r), ?o, "growth");
    record.text(?o, "module", ev.module);
    record.text(?o, "members", ev.members);
    record.int(?o, "instances", ev.instances::i64);
    record.end(?o);
}

# a unit's summary: under -v its `other` row as a phase record without a count, and the
# `built` line of a unit that built, kept for the closing summary record
fun summary_record(r: *Report, ev: *readout.Summary) {
    if (ev.rows) {
        var o: record.Record;
        record.begin(?r.w, enc(r), ?o, "phase");
        record.text(?o, "name", "other");
        record.int(?o, "time_us", micros(ev.other));
        record.end(?o);
    }
    if (ev.closed != readout.CLOSED_CHECKED) { report_built(r, ev); }
}

# a module roll-up's columns: module, time, and the ok, skip and FAIL counts, each a number and its word
val ROLL_COLS: usize = 8;

# the columns of a run's human rendering, from its tests' names
fun run_begin(rd: *Readout, ev: *readout.RunStart) {
    rd.run   = ev.tests;
    rd.count = ev.count;
    var mod_w:  usize = 0;
    var name_w: usize = 0;
    var i:      u32   = 0;
    for (i < ev.count) {
        val ml: usize = str_len(ev.tests[i].art.module);
        val nl: usize = str_len(ev.tests[i].art.name);
        if (ml > mod_w)  { mod_w = ml; }
        if (nl > name_w) { name_w = nl; }
        i = i + 1;
    }
    rd.roll[0] = layout.Column{width: clamp_width(mod_w, 16, 48), align: layout.LEFT, gap: 0};
    rd.roll[1] = layout.Column{width: TIME_W, align: layout.RIGHT, gap: layout.GAP};
    rd.roll[2] = layout.Column{width: 4, align: layout.RIGHT, gap: layout.GAP};
    rd.roll[3] = layout.Column{width: 2, align: layout.LEFT, gap: 1};
    rd.roll[4] = layout.Column{width: 4, align: layout.RIGHT, gap: layout.GAP};
    rd.roll[5] = layout.Column{width: 4, align: layout.LEFT, gap: 1};
    rd.roll[6] = layout.Column{width: 4, align: layout.RIGHT, gap: layout.GAP};
    rd.roll[7] = layout.Column{width: 4, align: layout.LEFT, gap: 1};
    rd.line[0] = layout.Column{width: 4, align: layout.LEFT, gap: 0};
    rd.line[1] = layout.Column{width: clamp_width(name_w, 24, 72), align: layout.LEFT, gap: layout.GAP};
    rd.line[2] = layout.Column{width: TIME_W, align: layout.RIGHT, gap: layout.GAP};
}

# a column width held between `least` and `most`
fun clamp_width(w: usize, least: usize, most: usize) usize {
    if (w < least) { ret least; }
    if (w > most)  { ret most; }
    ret w;
}

# a finished test in human text, in the order the tests finish: under -v its own
# line, otherwise its module's roll-up once every test of the module's run has
# finished, so a slow test holds back only its own module
fun test_human(rd: *Readout, at: u32) {
    val w: *io_writer.Writer   = out(rd.r);
    val t: *readout.TestResult = ?rd.run[at];
    if (rd.sink.level >= readout.LEVEL_PHASES) {
        test_line_w(rd, w, t);
        ret;
    }
    val mod_name: str = t.art.module;
    var first:    u32 = at;
    for (first > 0 && str_equals(rd.run[first - 1].art.module, mod_name)) { first = first - 1; }
    var last: u32 = at;
    for (last + 1 < rd.count && str_equals(rd.run[last + 1].art.module, mod_name)) { last = last + 1; }
    var j: u32 = first;
    for (j <= last) {
        if (!rd.run[j].done) { ret; }
        j = j + 1;
    }
    module_run_w(rd, w, first, last);
}

# a module's row: its time, then its counts, a skip or FAIL count only when nonzero. its
# failures are shown once, when the run ends
fun module_run_w(rd: *Readout, w: *io_writer.Writer, first: u32, last: u32) {
    val tests:   *readout.TestResult = rd.run;
    var ok:      u32                 = 0;
    var skipped: u32                 = 0;
    var failed:  u32                 = 0;
    var j:       u32                 = first;
    for (j <= last) {
        if (tests[j].result.kind == testrun.RESULT_PASS) { ok = ok + 1; }
        or (tests[j].result.kind == testrun.RESULT_SKIP) { skipped = skipped + 1; }
        or                                               { failed = failed + 1; }
        j = j + 1;
    }
    var dt:    layout.Text;
    var ot:    layout.Text;
    var st:    layout.Text;
    var ft:    layout.Text;
    var texts: [ROLL_COLS]str = [ROLL_COLS]str{tests[first].art.module, layout.duration(?dt, readout.span(tests, first, last)), layout.count(?ot, ok::u64), "ok", nil, nil, nil, nil};
    if (skipped > 0) {
        texts[4] = layout.count(?st, skipped::u64);
        texts[5] = "skip";
    }
    if (failed > 0) {
        texts[6] = layout.count(?ft, failed::u64);
        texts[7] = "FAIL";
    }
    layout.row(w, ?rd.roll[0], ?texts[0], ROLL_COLS);
}

# one test under -v: its outcome, name and time, a passing test's captured output beneath it.
# a failure is shown once, when the run ends
fun test_line_w(rd: *Readout, w: *io_writer.Writer, t: *readout.TestResult) {
    var said: str = "ok";
    if (t.result.kind == testrun.RESULT_SKIP) { said = "skip"; }
    if (failure(?t.result))                   { said = "FAIL"; }
    var dt:    layout.Text;
    var texts: [3]str = [3]str{said, t.art.name, layout.duration(?dt, t.elapsed)};
    layout.row(w, ?rd.line[0], ?texts[0], 3);
    if (!failure(?t.result)) { captured_w(w, t); }
}

# a failed test, once: its name, where it is declared and why, its captured output, where its
# full output is and how to rerun it alone
fun failure_w(w: *io_writer.Writer, t: *readout.TestResult) {
    std_format.format(w, "FAIL  {}  {}:{}  ", t.art.name, t.art.file, t.art.line::i64);
    reason_w(w, t);
    std_format.write_newline(w);
    captured_w(w, t);
    if (t.truncated && t.log != nil) { std_format.format(w, "{}full output: {}\n", DETAIL, t.log); }
    std_format.format(w, "{}rerun: ", DETAIL);
    if (t.launch != nil) { std_format.format(w, "{} {}\n", t.launch, t.art.idx::i64); }
    or                   { std_format.format(w, "{} {}\n", t.art.exe::str, t.art.idx::i64); }
}

fun reason_w(w: *io_writer.Writer, t: *readout.TestResult) {
    val r: *testrun.GateResult = ?t.result;
    if (r.kind == testrun.RESULT_RESOURCE_EXHAUSTION && r.cause == testrun.CAUSE_ORACLE_TIMEOUT) {
        val d: duration.Text = duration.text(t.bound);
        std_format.format(w, "(timed out after {}{})", d.n, d.unit);
    }
    or (r.kind == testrun.RESULT_SEMANTIC_MISMATCH && r.cause == testrun.CAUSE_ORACLE_EXIT) {
        std_format.format(w, "(exit {})", t.code::i64);
    }
    or (r.kind == testrun.RESULT_SEMANTIC_MISMATCH && r.cause == testrun.CAUSE_ORACLE_SIGNAL) {
        std_format.format(w, "(signal {})", t.code::i64);
    }
    or (r.kind == testrun.RESULT_INFRASTRUCTURE_FAILURE && r.cause == testrun.CAUSE_ORACLE_SPAWN_FAILURE) {
        std_format.write_str(w, "(spawn failed)");
    }
    or (r.kind == testrun.RESULT_INFRASTRUCTURE_FAILURE && r.cause == testrun.CAUSE_ORACLE_CAPTURE) {
        std_format.write_str(w, "(capture failed)");
    }
    or (r.kind == testrun.RESULT_INFRASTRUCTURE_FAILURE && r.cause == testrun.CAUSE_INVALID_TERMINAL) {
        std_format.write_str(w, "(runner failed)");
    }
    or { std_format.write_str(w, "(failed)"); }
}

# a test's captured output, each line indented under it
fun captured_w(w: *io_writer.Writer, t: *readout.TestResult) {
    if (t.out == nil || t.out_len == 0) {
        if (t.truncated) { std_format.format(w, "{}... (output truncated)\n", DETAIL); }
        ret;
    }
    var i:   usize = 0;
    var seg: usize = 0;
    for (i < t.out_len) {
        if (t.out[i] == '\n') {
            std_format.write_str(w, DETAIL);
            std_format.write_bytes(w, (t.out::usize + seg)::*u8, i - seg + 1);
            seg = i + 1;
        }
        i = i + 1;
    }
    if (seg < t.out_len) {
        std_format.write_str(w, DETAIL);
        std_format.write_bytes(w, (t.out::usize + seg)::*u8, t.out_len - seg);
        std_format.write_newline(w);
    }
    if (t.truncated) { std_format.format(w, "{}... (output truncated)\n", DETAIL); }
}

# the run's close: each failure once, in collection order whatever order the tests finished
# in, then the verdict in the gutter: passed with the count, or failed with how many of the
# count, those that timed out and those skipped, and the run's wall time
fun run_summary_w(rd: *Readout, w: *io_writer.Writer, ev: *readout.RunEnd) {
    if (ev.failed > 0) {
        std_format.write_newline(w);
        var i: u32 = 0;
        for (i < ev.count) {
            val t: *readout.TestResult = ?ev.tests[i];
            if (failure(?t.result)) { failure_w(w, t); }
            i = i + 1;
        }
    }
    if (ev.count > 0) { std_format.write_newline(w); }
    val tests: str = layout.noun(ev.count::u64, "test", "tests");
    if (ev.failed > 0) {
        layout.said(w, layout.FAILED);
        std_format.format(w, "{} of {} {}", ev.failed::u64, ev.count::u64, tests);
    }
    or {
        layout.said(w, layout.PASSED);
        std_format.format(w, "{} {}", ev.count::u64, tests);
    }
    if (ev.timed_out > 0) { std_format.format(w, " ({} timed out)", ev.timed_out::u64); }
    if (ev.skipped > 0)   { std_format.format(w, ", {} skipped", ev.skipped::u64); }
    var dt: layout.Text;
    std_format.format(w, "   {}\n", layout.duration(?dt, ev.wall));
}

fun run_start_record(r: *Report, ev: *readout.RunStart) {
    var o: record.Record;
    record.begin(?r.w, enc(r), ?o, "run_start");
    record.int(?o, "tests", ev.count::i64);
    record.end(?o);
}

fun run_end_record(r: *Report, ev: *readout.RunEnd) {
    var o: record.Record;
    record.begin(?r.w, enc(r), ?o, "run_end");
    record.int(?o, "passed", ev.passed::i64);
    record.int(?o, "failed", ev.failed::i64);
    record.int(?o, "skipped", ev.skipped::i64);
    record.int(?o, "total", ev.count::i64);
    record.int(?o, "duration_ns", chrono_duration.duration_nsec(ev.wall));
    record.int(?o, "mismatch", ev.tally.semantic_mismatch::i64);
    record.int(?o, "infrastructure_failure", ev.tally.infrastructure_failure::i64);
    record.int(?o, "resource_exhaustion", ev.tally.resource_exhaustion::i64);
    record.int(?o, "timed_out", ev.timed_out::i64);
    val opt_origin: opt[str] = diagnostic.origin_name(diagnostic.ORIGIN_TEST);
    if (sel opt_origin.some) { record.text(?o, "origin", opt_origin.some); }
    record.end(?o);
}

# whether a result is a failure: anything but a pass or a skip
fun failure(r: *testrun.GateResult) bool {
    ret r.kind != testrun.RESULT_PASS && r.kind != testrun.RESULT_SKIP;
}

# the outcome a test record names: `pass`, `skip`, `exit`, `signal`, `spawn`,
# `timeout`, or `other`
fun result_name(r: *testrun.GateResult) *u8 {
    if (r.kind == testrun.RESULT_PASS)                                                                    { ret "pass"; }
    if (r.kind == testrun.RESULT_SKIP)                                                                    { ret "skip"; }
    if (r.kind == testrun.RESULT_SEMANTIC_MISMATCH && r.cause == testrun.CAUSE_ORACLE_EXIT)               { ret "exit"; }
    if (r.kind == testrun.RESULT_SEMANTIC_MISMATCH && r.cause == testrun.CAUSE_ORACLE_SIGNAL)             { ret "signal"; }
    if (r.kind == testrun.RESULT_INFRASTRUCTURE_FAILURE && r.cause == testrun.CAUSE_ORACLE_SPAWN_FAILURE) { ret "spawn"; }
    if (r.kind == testrun.RESULT_RESOURCE_EXHAUSTION && r.cause == testrun.CAUSE_ORACLE_TIMEOUT)          { ret "timeout"; }
    ret "other";
}

# whether a result kept output worth pointing at
pub fun has_capture(r: *testrun.GateResult) bool {
    if (r.kind == testrun.RESULT_SEMANTIC_MISMATCH)   { ret true; }
    if (r.kind == testrun.RESULT_RESOURCE_EXHAUSTION) { ret true; }
    ret r.kind == testrun.RESULT_INFRASTRUCTURE_FAILURE && r.cause != testrun.CAUSE_ORACLE_SPAWN_FAILURE;
}

# how a command reports to stderr: `--report human`, the default, or the records in one of
# their two encodings, `--report json` or `--report lines`
pub def Format: u8;

pub val FORMAT_HUMAN: Format = 0;
val     FORMAT_JSON:  Format = 1;
val     FORMAT_LINES: Format = 2;

# the format a `--report` value names
# ---
# name: the value
# ret:  the format, or none for a name outside `human`, `json` and `lines`
pub fun format_named(name: str) opt[Format] {
    if (str_equals(name, "human")) { ret opt[Format].some{FORMAT_HUMAN}; }
    if (str_equals(name, "json"))  { ret opt[Format].some{FORMAT_JSON}; }
    if (str_equals(name, "lines")) { ret opt[Format].some{FORMAT_LINES}; }
    ret opt[Format].none{};
}

# the encoding a records report writes
fun enc(r: *Report) record.Encoding {
    if (r.format == FORMAT_LINES) { ret record.LINES; }
    ret record.JSON;
}

# whether the report writes records rather than human text
pub fun is_records(r: *Report) bool {
    ret r.format != FORMAT_HUMAN;
}

# how a build-shaped command reports to stderr, and what it has reported. under
# json every line it writes is a record and `report_dnit` ends the run with the
# summary record, whose counts are the severities of the records before it
# ---
# format:   human text or json records
# w:        where the report is written, stderr
# root:     the project root as the command resolved it, nil until then; a json
#           record names a file inside it relative to it
# errors:   the error records written
# warnings: the warning records written
# made:     whether the arena record paths are built in, and the base they are
#           measured from, have been made; they are on first use
# built:    under json, each unit's `built` line, which the summary record carries
# out:      stdout as the command writes it, its first refused write kept as the
#           report's refusal
pub rec Report {
    format:   Format;
    w:        io_writer.Writer;
    root:     str;
    errors:   usize;
    warnings: usize;
    notes:    usize;
    made:     bool;
    backing:  A.Allocator;
    ar:       arena.Arena;
    a:        A.Allocator;
    pb:       PathBase;
    built:    Vector[Built];
    # the texts a failure's locations name, nil while the command holds none
    sources: *base_source.SourceMap;
    # the first refusal met while writing, which fails the report at its close
    refusal: opt[fail.Fail];
    out:     io_writer.Writer;
}

# a unit's `built` line as the summary record keeps it: the output, nil when it wrote none, its modules,
# its size when it is one file, and the unit's wall time
rec Built {
    out:      str;
    modules:  u32;
    rebuilt:  u32;
    bytes:    usize;
    has_size: bool;
    total:    chrono_duration.Duration;
}

# start a report in place; it holds its own arena, so it stays where it was made
# until `report_dnit`
# ---
# r:      the report
# format: the format the command writes
pub fun report_init(r: *Report, format: Format) {
    r.format   = format;
    r.w        = io_writer.Writer{ctx: r::ptr, fn_write: stderr_write};
    r.root     = nil;
    r.errors   = 0;
    r.warnings = 0;
    r.notes    = 0;
    r.made     = false;
    r.built    = collections_vector.init[Built](nil);
    r.refusal  = opt[fail.Fail].none{};
    r.sources  = nil;
    r.out      = io_writer.Writer{ctx: r::ptr, fn_write: stdout_write};
}

# what a refused write to stdout is reported as
val STDOUT_OP: fail.Op = fail.Op{verb: "write", role: "standard output"};

# a command's write to stderr, which carries its diagnostics. a command an interrupt stopped
# reports that and nothing else: what its operations make of being stopped is not written
fun stderr_write(ctx: ptr, buf: *u8, len: usize) res[usize, io_writer.WriteError] {
    if (interrupt.taken()) { ret res[usize, io_writer.WriteError].ok{len}; }
    var host: io_writer.Writer = stderr_writer();
    ret io_writer.write(?host, buf, len);
}

# a command's write to stdout: a refusal is kept as the report's, which fails it at its close.
# nothing more is written once an interrupt stopped the command
fun stdout_write(ctx: ptr, buf: *u8, len: usize) res[usize, io_writer.WriteError] {
    if (interrupt.taken()) { ret res[usize, io_writer.WriteError].ok{len}; }
    val r:           *Report                          = ctx::*Report;
    var host:        io_writer.Writer                 = fs.writer(fs.STDOUT);
    val res_written: res[usize, io_writer.WriteError] = io_writer.write(?host, buf, len);
    if (sel res_written.err) {
        if (sel r.refusal.none && report_paths(r) != nil) { refused(r, fail.refusal(?r.a, diagnostic_kind.OUTPUT_WRITE, STDOUT_OP, fail.Cause.write{res_written.err})); }
    }
    ret res_written;
}

# where a command writes its output, stdout through the report, so a refused write fails the
# command as the system's
pub fun out(r: *Report) *io_writer.Writer {
    ret ?r.out;
}

# keeps the first refusal the report meets while writing
fun refused(r: *Report, f: fail.Fail) {
    val first: bool = sel r.refusal.none;
    if (first) { r.refusal = opt[fail.Fail].some{f}; }
}

# the base record paths are measured from, over the report's arena; nil, with the
# refusal kept, when the arena cannot be made, and a record then names each file
# as it was given
fun report_paths(r: *Report) *PathBase {
    if (r.made) { ret ?r.pb; }
    val err_made: err[A.Error] = page.make(?r.backing);
    if (sel err_made.err) {
        refused(r, fail.refused(err_made.err));
        ret nil;
    }
    val err_opened: err[A.Error] = arena.init(?r.ar, ?r.backing, 0);
    if (sel err_opened.err) {
        refused(r, fail.refused(err_opened.err));
        ret nil;
    }
    val err_armed: err[A.Error] = arena.allocator(?r.a, ?r.ar);
    if (sel err_armed.err) {
        arena.dnit(?r.ar);
        refused(r, fail.refused(err_armed.err));
        ret nil;
    }
    r.made = true;
    var root: str = r.root;
    if (root == nil) { root = "."; }
    r.pb = path_base(?r.a, root);
    ret ?r.pb;
}

# keep a unit's `built` line for the summary record; the output path, nil when the unit wrote
# none, is copied into the report's arena, and a line the arena refuses is kept as the report's
# refusal, which fails it at its close
fun report_built(r: *Report, ev: *readout.Summary) {
    if (report_paths(r) == nil) { ret; }
    if (r.built.a == nil)       { r.built = collections_vector.init[Built](?r.a); }
    var out: str = nil;
    if (ev.out != nil) {
        val res_out: res[str, A.Error] = str_dup(?r.a, ev.out);
        if (sel res_out.err) {
            refused(r, fail.refused(res_out.err));
            ret;
        }
        out = res_out.ok;
    }
    val res_kept: res[usize, A.Error] = collections_vector.push[Built](?r.built, Built{out: out, modules: ev.modules, rebuilt: ev.compiled, bytes: ev.bytes, has_size: ev.has_size, total: ev.total});
    if (sel res_kept.err) { refused(r, fail.refused(res_kept.err)); }
}

# a record the interrupt silenced was not written, so it is not counted
fun count_record(r: *Report, d: *diagnostic.Diagnostic) {
    if (interrupt.taken())               { ret; }
    if (diagnostic.is_error(d))          { r.errors = r.errors + 1; }
    or (diagnostic_kind.is_note(d.kind)) { r.notes = r.notes + 1; }
    or                                   { r.warnings = r.warnings + 1; }
}

# report a note of kind `k`, which points at nothing: `note text` in human text, or a
# diagnostic record of note severity under json
# ---
# r:    the command's report
# k:    the note's kind, a row of note level
# text: what the note says
pub fun report_note(r: *Report, k: diagnostic_kind.Kind, text: str) {
    if (r.format == FORMAT_HUMAN) {
        std_format.write_str(?r.w, "note ");
        std_format.write_str(?r.w, text);
        std_format.write_newline(?r.w);
        ret;
    }
    note_record(r, k, text);
}

# report what a command did as a progress line in human text, and as the note record of kind
# `k` saying `text` under the records modes
# ---
# r:      the command's report
# k:      the note's kind, a row of note level
# v:      the verb of the progress line
# texts:  what it acted on, then its detail on the line, `n` of them
# n:      how many texts
# detail: a line beneath it, nil for none
# text:   the note record's message
pub fun report_said(r: *Report, k: diagnostic_kind.Kind, v: layout.Verb, texts: *str, n: usize, detail: str, text: str) {
    if (r.format == FORMAT_HUMAN) {
        said_row(?r.w, v, texts, n);
        if (detail != nil) {
            layout.beneath(?r.w);
            std_format.write_str(?r.w, detail);
            std_format.write_newline(?r.w);
        }
        ret;
    }
    note_record(r, k, text);
}

# a progress line on w: its verb in the gutter, then `n` texts parted by GAP
pub fun said_row(w: *io_writer.Writer, v: layout.Verb, texts: *str, n: usize) {
    var cols: [8]layout.Column;
    var i:    usize = 0;
    for (i < n && i < 8) {
        cols[i] = layout.Column{width: 0, align: layout.LEFT, gap: layout.GAP};
        i       = i + 1;
    }
    cols[0].gap = 0;
    layout.said(w, v);
    layout.row(w, ?cols[0], texts, n);
}

fun note_record(r: *Report, k: diagnostic_kind.Kind, text: str) {
    var d: diagnostic.Diagnostic;
    d.kind    = k;
    d.loc     = base_source.location_nil();
    d.message = text;
    render_record(r, r.sources, report_paths(r), ?d);
    count_record(r, ?d);
}

# report a carried failure as the diagnostic it reads as, in text or as a diagnostic record
# under json. a reported failure writes nothing, its diagnostics having been rendered already
# ---
# r:      the command's report
# f:      the failure
# origin: the phase it is reported under; ORIGIN_NONE for the command line itself
# ret:    the exit code `exit.of` maps the failure to
pub fun report_fail(r: *Report, f: fail.Fail, origin: diagnostic.Origin) i64 {
    var fv: fail.Fail = f;
    ret report_failure(r, ?fv, origin);
}

fun report_failure(r: *Report, f: *fail.Fail, origin: diagnostic.Origin) i64 {
    if (r.format == FORMAT_HUMAN) {
        if (!sel f.reported && !interrupt.taken()) { r.errors = r.errors + 1; }
        ret render_fail_w(?r.w, r.sources, f);
    }
    if (!sel f.reported) {
        var fx: annotation.Fix;
        var d:  diagnostic.Diagnostic = failure_view(f, origin, ?fx);
        render_record(r, r.sources, report_paths(r), ?d);
        count_record(r, ?d);
    }
    ret exit.of(@f);
}

# one test's result as a record under json; human text writes nothing here,
# the runner's own readout carrying it
# ---
# r: the command's report
# t: the finished test
fun report_test(r: *Report, t: *readout.TestResult) {
    if (r.format == FORMAT_HUMAN) { ret; }
    val art: *testrun.TestArtifact = t.art;
    var o:   record.Record;
    record.begin(?r.w, enc(r), ?o, "test");
    test_identity(r, ?o, art);
    record.text(?o, "outcome", result_name(?t.result));
    record.int(?o, "code", t.code::i64);
    record.int(?o, "timeout_ns", chrono_duration.duration_nsec(t.bound));
    record.int(?o, "duration_ns", chrono_duration.duration_nsec(t.elapsed));
    record.text(?o, "exe", art.exe);
    if (has_capture(?t.result)) { record.text_or_null(?o, "output", t.log); }
    or                          { record.null(?o, "output"); }
    val opt_origin: opt[str] = diagnostic.origin_name(diagnostic.ORIGIN_TEST);
    if (sel opt_origin.some) { record.text(?o, "origin", opt_origin.some); }
    record.end(?o);
}

# the members that name a test in its test and case records, its file relative to the project
fun test_identity(r: *Report, o: *record.Record, art: *testrun.TestArtifact) {
    val file: str = record_path(report_paths(r), art.file);
    record.text(o, "name", art.name);
    record.text(o, "module", art.module);
    record.text(o, "file", file);
    record.int(o, "line", art.line::i64);
    record.int(o, "index", art.idx::i64);
    record.text_or_null(o, "target", art.target);
    record.text_or_null(o, "profile", art.profile);
}

# one collected test as a record under json, as `mach test --list` lists it; human text
# writes nothing here
# ---
# r:   the command's report
# art: the test
pub fun report_case(r: *Report, art: *testrun.TestArtifact) {
    if (r.format == FORMAT_HUMAN) { ret; }
    var o: record.Record;
    record.begin(?r.w, enc(r), ?o, "case");
    test_identity(r, ?o, art);
    record.text(?o, "object", art.object);
    record.end(?o);
}

# a (target, profile) whose tests were built and not run, as a record under json; human text
# writes nothing here
# ---
# r:       the command's report
# target:  the declared target name
# profile: the profile name
# reason:  why its tests did not run
pub fun report_skip(r: *Report, target: str, profile: str, reason: str) {
    if (r.format == FORMAT_HUMAN) { ret; }
    var o: record.Record;
    record.begin(?r.w, enc(r), ?o, "skip");
    record.text(?o, "target", target);
    record.text(?o, "profile", profile);
    record.text(?o, "reason", reason);
    record.end(?o);
}

# end the run: a refusal kept while it ran, such as a refused write to stdout,
# reported, then under json the summary record, the last line the command
# writes; the report's arena is released either way. a command an interrupt
# stopped ends with the one line report_interrupted writes instead
# ---
# r:    the command's report
# code: the exit code the command returns
# ret:  the worse of code and the kept refusal's
pub fun report_dnit(r: *Report, code: i64) i64 {
    if (interrupt.taken()) {
        report_interrupted(r, code);
        report_release(r);
        ret code;
    }
    var closing: i64 = code;
    if (r.made) {
        if (sel r.pb.refusal.some) { refused(r, r.pb.refusal.some); }
    }
    if (sel r.refusal.some) { closing = exit.worst(closing, report_fail(r, r.refusal.some, diagnostic.ORIGIN_NONE)); }
    # one tally closes every error and warning the command rendered, whichever store, failure
    # or phase it came from, so it never reads `0 errors` above a nonzero exit
    if (r.format == FORMAT_HUMAN && r.errors + r.warnings > 0) {
        std_format.write_str(?r.w, "\n");
        emit_summary(?r.w, r.errors, r.warnings);
    }
    if (r.format != FORMAT_HUMAN) {
        var o: record.Record;
        record.begin(?r.w, enc(r), ?o, "summary");
        record.int(?o, "errors", r.errors::i64);
        record.int(?o, "warnings", r.warnings::i64);
        record.int(?o, "notes", r.notes::i64);
        if (closing == exit.OK) { record.text(?o, "outcome", "success"); }
        or                      { record.text(?o, "outcome", "failure"); }
        record.int(?o, "exit_code", closing);
        if (r.built.len > 0) { summary_built(?o, r); }
        record.end(?o);
    }
    report_release(r);
    ret closing;
}

# the one line a command an interrupt stopped ends with, past the silence the interrupt set:
# `interrupted by <event>`, or under json the summary record with the outcome `interrupted`
fun report_interrupted(r: *Report, code: i64) {
    var w: io_writer.Writer = stderr_writer();
    if (r.format == FORMAT_HUMAN) {
        std_format.format(?w, "interrupted by {}\n", interrupt.name());
        ret;
    }
    var o: record.Record;
    record.begin(?w, enc(r), ?o, "summary");
    record.int(?o, "errors", r.errors::i64);
    record.int(?o, "warnings", r.warnings::i64);
    record.int(?o, "notes", r.notes::i64);
    record.text(?o, "outcome", "interrupted");
    record.text(?o, "event", interrupt.name());
    record.int(?o, "exit_code", code);
    record.end(?o);
}

# release the report's arena
fun report_release(r: *Report) {
    if (!r.made) { ret; }
    arena.dnit(?r.ar);
    r.made  = false;
    r.built = collections_vector.init[Built](nil);
}

# the summary record's `built` lines: `time_us`, every unit's wall time added,
# and `built`, one object per line with its `out`, `modules`, `bytes` when the
# line shows a size, and `time_us`
fun summary_built(o: *record.Record, r: *Report) {
    var total: chrono_duration.Duration = 0;
    var i:     usize                    = 0;
    for (i < r.built.len) {
        total = total + r.built.data[i].total;
        i     = i + 1;
    }
    record.int(o, "time_us", micros(total));
    var arr: record.List;
    record.list_begin(o, "built", ?arr);
    i = 0;
    for (i < r.built.len) {
        val b:  *Built = ?r.built.data[i];
        var bo: record.Record;
        record.list_record_begin(?arr, ?bo);
        if (b.out != nil) { record.text(?bo, "out", b.out); }
        record.int(?bo, "modules", b.modules::i64);
        record.int(?bo, "rebuilt", b.rebuilt::i64);
        if (b.has_size) { record.int(?bo, "bytes", b.bytes::i64); }
        record.int(?bo, "time_us", micros(b.total));
        record.nested_end(?bo);
        i = i + 1;
    }
    record.list_end(?arr);
}

# where record paths are measured from: the working directory a relative
# source path is spelled against, and the project root resolved against it
# a path the base could not measure is named as it was given, and the refusal is
# kept, which fails the report at its close
rec PathBase {
    a:       *A.Allocator;
    cwd:     str;
    root:    str;
    refusal: opt[fail.Fail];
}

fun path_base(a: *A.Allocator, root: str) PathBase {
    var pb: PathBase;
    pb.a       = a;
    pb.cwd     = nil;
    pb.root    = nil;
    pb.refusal = opt[fail.Fail].none{};
    val res_cwd: res[types_string.OwnedString, env.EnvError] = env.current_dir(a);
    if (sel res_cwd.err) { pb.refusal = opt[fail.Fail].some{fail.refusal(a, diagnostic_kind.FS_CURRENT_DIR, fail.Op{verb: "read", role: "the working directory"}, fail.Cause.env{res_cwd.err})}; }
    if (sel res_cwd.ok)  { pb.cwd = res_cwd.ok.data; }
    pb.root = absolute(?pb, root);
    ret pb;
}

# a path resolved against the working directory and cleaned; nil, with the
# refusal kept, when the allocator refuses
fun absolute(pb: *PathBase, p: str) str {
    var full: str = p;
    if (pb.cwd != nil) {
        val res_joined: res[types_path.Path, A.Error] = types_path.resolve(pb.a, pb.cwd, p);
        if (sel res_joined.err) {
            path_refused(pb, res_joined.err);
            ret nil;
        }
        full = res_joined.ok;
    }
    val res_cleaned: res[types_path.Path, A.Error] = types_path.clean(pb.a, full);
    if (sel res_cleaned.err) {
        path_refused(pb, res_cleaned.err);
        ret nil;
    }
    ret res_cleaned.ok;
}

fun path_refused(pb: *PathBase, e: A.Error) {
    val first: bool = sel pb.refusal.none;
    if (first) { pb.refusal = opt[fail.Fail].some{fail.refused(e)}; }
}

# the path a record names a source file by: relative to the project root for a
# file inside it, otherwise absolute; as given when there is no base, whose
# refusal the report keeps
fun record_path(pb: *PathBase, p: str) str {
    if (pb == nil) { ret p; }
    val full: str = absolute(pb, p);
    if (full == nil || pb.root == nil) { ret p; }
    val rl: usize = str_len(pb.root);
    if (rl == 0 || !str_starts_with(full, pb.root)) { ret full; }
    if (types_path.is_separator(pb.root[rl - 1]))   { ret (?full[rl])::str; }
    if (full[rl] == 0)                              { ret "."; }
    if (types_path.is_separator(full[rl]))          { ret (?full[rl + 1])::str; }
    ret full;
}

# a located span's members: `file`, 1-based `line` and `column` of its first
# byte, `end_line` and `end_column` of the position just past its last byte,
# columns counted in UTF-8 bytes, and the 0-based `byte_start` and exclusive
# `byte_end`
fun put_span(o: *record.Record, pb: *PathBase, f: *Frame) {
    val end_pos: base_source.Position = base_source.position(f.sf, f.end);
    record.text(o, "file", record_path(pb, f.sf.path));
    record.int(o, "line", f.line_s::i64);
    record.int(o, "column", f.col_s::i64);
    record.int(o, "end_line", end_pos.line::i64);
    record.int(o, "end_column", end_pos.col::i64);
    record.int(o, "byte_start", f.off::i64);
    record.int(o, "byte_end", f.end::i64);
}

# one diagnostic as one NDJSON record, members in the order the schema
# documents them
fun render_record(r: *Report, sources: *base_source.SourceMap, pb: *PathBase, d: *diagnostic.Diagnostic) {
    var o: record.Record;
    record.begin(?r.w, enc(r), ?o, "diagnostic");

    record.text(?o, "severity", severity_name(d.kind));
    record.text_or_null(?o, "code", diagnostic_kind.key_of(d.kind));
    record.text(?o, "message", d.message);
    val opt_origin: opt[str] = diagnostic.origin_name(d.origin);
    if (sel opt_origin.some) { record.text(?o, "origin", opt_origin.some); }

    put_primary(?o, sources, pb, d.loc);
    put_related(?o, sources, pb, ?d.related);

    # a related site mach cannot locate stands as a note, as the text shows it
    var notes: record.List;
    record.list_begin(?o, "notes", ?notes);
    var i: usize = 0;
    for (i < d.related.len) {
        val rel:    *annotation.Related = ?d.related.data[i];
        val opt_rf: opt[Frame]          = locate(sources, rel.loc);
        if (rel.label != nil && sel opt_rf.none) { record.list_text(?notes, rel.label); }
        i = i + 1;
    }
    i = 0;
    for (i < d.children.len) {
        if (d.children.data[i].kind != diagnostic.CHILD_HELP) { record.list_text(?notes, d.children.data[i].text); }
        i = i + 1;
    }
    record.list_end(?notes);

    var help: record.List;
    record.list_begin(?o, "help", ?help);
    i = 0;
    for (i < d.children.len) {
        if (d.children.data[i].kind == diagnostic.CHILD_HELP) { record.list_text(?help, d.children.data[i].text); }
        i = i + 1;
    }
    record.list_end(?help);

    put_fixes(?o, sources, pb, d.fixes.data, d.fixes.len);
    record.end(?o);
}

# a record's `primary`: the span `loc` names, null when it names none `sources` holds
fun put_primary(o: *record.Record, sources: *base_source.SourceMap, pb: *PathBase, loc: base_source.Location) {
    val opt_pf: opt[Frame] = locate(sources, loc);
    if (sel opt_pf.none) {
        record.null(o, "primary");
        ret;
    }
    var pf:   Frame = opt_pf.some;
    var prim: record.Record;
    record.nested_begin(o, "primary", ?prim);
    put_span(?prim, pb, ?pf);
    record.nested_end(?prim);
}

# a record's `related`: each related place `sources` holds, with its label
fun put_related(o: *record.Record, sources: *base_source.SourceMap, pb: *PathBase, also: *Vector[annotation.Related]) {
    var related: record.List;
    record.list_begin(o, "related", ?related);
    var i: usize = 0;
    for (i < also.len) {
        val rel:    *annotation.Related = ?also.data[i];
        val opt_rf: opt[Frame]          = locate(sources, rel.loc);
        if (sel opt_rf.some) {
            var rf: Frame = opt_rf.some;
            var ro: record.Record;
            record.list_record_begin(?related, ?ro);
            put_span(?ro, pb, ?rf);
            record.text_or_null(?ro, "label", rel.label);
            record.nested_end(?ro);
        }
        i = i + 1;
    }
    record.list_end(?related);
}

# a record's `fixes`: the `n` fixes at `fixes`, each edit `sources` locates
fun put_fixes(o: *record.Record, sources: *base_source.SourceMap, pb: *PathBase, fixes: *annotation.Fix, n: usize) {
    var array: record.List;
    record.list_begin(o, "fixes", ?array);
    var i: usize = 0;
    for (i < n) {
        val fx: *annotation.Fix = ?fixes[i];
        var fo: record.Record;
        record.list_record_begin(?array, ?fo);
        record.text(?fo, "label", fx.label);
        var edits: record.List;
        record.list_begin(?fo, "edits", ?edits);
        var e: usize = 0;
        for (e < fx.edits.len) {
            val ed:     *annotation.Edit = ?fx.edits.data[e];
            val opt_ef: opt[Frame]       = locate(sources, ed.loc);
            if (sel opt_ef.some) {
                var ef: Frame = opt_ef.some;
                var eo: record.Record;
                record.list_record_begin(?edits, ?eo);
                put_span(?eo, pb, ?ef);
                record.text(?eo, "replacement", ed.replacement);
                record.nested_end(?eo);
            }
            e = e + 1;
        }
        record.list_end(?edits);
        record.nested_end(?fo);
        i = i + 1;
    }
    record.list_end(?array);
}

fun render_store_records(r: *Report, sources: *base_source.SourceMap, list: *diagnostic.DiagnosticStore, pb: *PathBase) {
    var i: usize = 0;
    for (i < diagnostic.len(list)) {
        val d: *diagnostic.Diagnostic = ?list.items.data[i];
        render_record(r, sources, pb, d);
        count_record(r, d);
        i = i + 1;
    }
}
