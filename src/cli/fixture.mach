use mach.lang.growth;
use std.allocator.page;
use fs:       std.filesystem;
use io_error: std.io.error;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use types_path: std.types.path;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use A:         std.allocator;
use io_writer: std.io.writer;

# a writer into memory that grows to hold whatever is written, and refuses
# every write once `fail` is set and `fail_at` bytes are held
#[testing]
pub rec MemSink {
    a:       A.Allocator;
    buf:     *u8;
    cap:     usize;
    len:     usize;
    fail_at: usize;
    fail:    bool;
}

#[testing]
fun mem_sink_write(ctx: ptr, buf: *u8, len: usize) res[usize, io_writer.WriteError] {
    val s:       *MemSink             = ctx::*MemSink;
    val refused: io_writer.WriteError = io_writer.native_failure(0, io_error.make(io_error.IO, io_error.OP_WRITE));
    if (s.fail && s.len >= s.fail_at) { ret res[usize, io_writer.WriteError].err{refused}; }
    var n: usize = len;
    if (s.fail && s.len + n > s.fail_at) { n = s.fail_at - s.len; }
    # one spare byte keeps room for sink_text's terminator
    val grown: err[A.Error] = growth.reserve_usize[u8](?s.a, ?s.buf, ?s.cap, s.len + n + 1);
    if (sel grown.err) { ret res[usize, io_writer.WriteError].err{refused}; }
    var i: usize = 0;
    for (i < n) {
        s.buf[s.len + i] = buf[i];
        i                = i + 1;
    }
    s.len = s.len + n;
    ret res[usize, io_writer.WriteError].ok{n};
}

# point `w` at `s`, which must not move while `w` writes to it
#[testing]
pub fun mem_writer(w: *io_writer.Writer, s: *MemSink) {
    page.make(?s.a);
    s.buf     = nil;
    s.cap     = 0;
    s.len     = 0;
    s.fail_at = 0;
    s.fail    = false;
    w.ctx     = s::ptr;
    w.f_write = mem_sink_write;
}

#[testing]
pub fun mem_sink_dnit(s: *MemSink) {
    if (s.buf != nil) { A.deallocate[u8](?s.a, s.buf, s.cap); }
    s.buf = nil;
    s.cap = 0;
    s.len = 0;
}

# the text written so far
#[testing]
pub fun sink_text(s: *MemSink) str {
    if (s.buf == nil) { ret ""; }
    s.buf[s.len] = 0;
    ret s.buf::str;
}

# whether want, wl bytes long, is written at i
#[testing]
pub fun sink_match_at(s: *MemSink, i: usize, want: str, wl: usize) bool {
    var j: usize = 0;
    for (j < wl && s.buf[i + j] == want[j]) { j = j + 1; }
    if (j == wl) { ret true; }
    ret false;
}

#[testing]
pub fun sink_contains(s: *MemSink, want: str) bool {
    val wl: usize = str_len(want);
    if (wl == 0)    { ret true; }
    if (wl > s.len) { ret false; }
    var i: usize = 0;
    for (i + wl <= s.len) {
        if (sink_match_at(s, i, want, wl)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# how often want occurs in a memory sink
#[testing]
pub fun sink_count(s: *MemSink, want: str) usize {
    val wl: usize = str_len(want);
    if (wl == 0 || wl > s.len) { ret 0; }
    var count: usize = 0;
    var i:     usize = 0;
    for (i + wl <= s.len) {
        if (sink_match_at(s, i, want, wl)) {
            count = count + 1;
            i     = i + wl;
        }
        or { i = i + 1; }
    }
    ret count;
}

# where want first occurs in a memory sink, or its length when it does not
#[testing]
pub fun sink_index(s: *MemSink, want: str) usize {
    val wl: usize = str_len(want);
    var i:  usize = 0;
    for (i + wl <= s.len) {
        if (sink_match_at(s, i, want, wl)) { ret i; }
        i = i + 1;
    }
    ret s.len;
}

# leaf joined under base, or "" when the join cannot be made
#[testing]
pub fun join(a: *A.Allocator, base: str, leaf: str) str {
    val joined: res[str, A.Error] = types_path.join(a, base, leaf);
    if (sel joined.err) { ret ""; }
    ret joined.ok;
}

# write body to leaf under dir with mode, creating dir first
# ---
# ret: true once written
#[testing]
pub fun write_mode(a: *A.Allocator, dir: str, leaf: str, body: str, mode: i32) bool {
    val made: err[fs.FsError] = fs.create_dir_all(a, dir, 0o755);
    if (sel made.err) { ret false; }
    val written: err[fs.FsError] = fs.write_bytes(join(a, dir, leaf), body::*u8, str_len(body), mode);
    ret sel written.ok;
}

# write_mode with mode 0o644
#[testing]
pub fun write(a: *A.Allocator, dir: str, leaf: str, body: str) bool {
    ret write_mode(a, dir, leaf, body, 0o644);
}

# the text of leaf under dir, or nil when it cannot be read
#[testing]
pub fun read(a: *A.Allocator, dir: str, leaf: str) str {
    val text: res[str, fs.FsError] = fs.read_string(a, join(a, dir, leaf));
    if (sel text.err) { ret nil; }
    ret text.ok;
}
