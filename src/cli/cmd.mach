# length of COMMANDS; the compiler refuses a COMMANDS literal of any other length
pub val COMMANDS_N: usize = 11;
# every command, in the order help lists them. a command is its own file's args.CommandSpec and
# its row here; nothing else registers it
pub val COMMANDS: [COMMANDS_N]*args.CommandSpec = [COMMANDS_N]*args.CommandSpec{
    ?build.COMMAND,
    ?build.CHECK,
    ?run.COMMAND,
    ?cmd_testing.COMMAND,
    ?fmt.COMMAND,
    ?clean.COMMAND,
    ?cmd_dep.COMMAND,
    ?init.COMMAND,
    ?cmd_doc.COMMAND,
    ?info.COMMAND,
    ?help.COMMAND,
};

# length of GLOBALS
val GLOBALS_N: usize = 2;
# the options `mach` takes in place of a command word: `mach --help` is `mach help`, and
# `mach --version` is `mach info --version`
val GLOBALS: [GLOBALS_N]args.Global = [GLOBALS_N]args.Global{
    args.Global{row: ?args.HELP, command: ?help.COMMAND},
    args.Global{row: ?info.VERSION, command: ?info.COMMAND},
};

# the command set argv is read against
# ---
# ret: COMMANDS as a set, which help answers and GLOBALS extends
pub fun commands() args.CommandSet {
    ret args.CommandSet{specs: ?COMMANDS[0], n: COMMANDS_N, help: ?help.COMMAND, globals: ?GLOBALS[0], global_n: GLOBALS_N};
}

fun render_overview(a: *A.Allocator) i64 {
    var out:               io_writer.Writer = fs.writer(fs.STDOUT);
    val render_overview_r: err[fail.Fail]   = help.render_overview(a, commands(), ?out);
    if (sel render_overview_r.err) { ret cli_diagnostic.refuse(render_overview_r.err); }
    ret exit.OK;
}

# the `mach` entry point: route argv to one command and return its exit code. with no arguments
# the overview prints and the code is 1; an unknown command is refused and the overview prints;
# otherwise args.run reports a refusal, renders the page `--help` asks for, or runs the command
# ---
# argc: process argument count
# argv: process arguments, argv[0] the program
# ret:  the exit code: exit.USER for a missing or unknown command, the code `exit.of` maps a
#       failure to set up or read the invocation to, otherwise the command's own code
pub fun dispatch(argc: usize, argv: **u8) i64 {
    var backing: A.Allocator;
    val make_r:  err[A.Error] = page.make(?backing);
    if (sel make_r.err) { ret cli_diagnostic.refuse(fail.refused(make_r.err)); }

    if (argc < 2) {
        val shown: i64 = render_overview(?backing);
        if (shown != exit.OK) { ret shown; }
        ret exit.USER;
    }

    val ir: res[args.ParsedInvocation, fail.Fail] = args.parse_invocation(?backing, commands(), argc, argv);
    if (sel ir.err) { ret cli_diagnostic.refuse(ir.err); }
    var inv: args.ParsedInvocation = ir.ok;
    fin { args.dnit_invocation(?backing, ?inv); }

    if (inv.command == nil) {
        val said: res[str, std_format.FormatError] = std_format.sprint(?backing, "unknown command '{}'", argv[1]::str);
        if (sel said.err) { ret cli_diagnostic.refuse(fail.message("out of memory")); }
        cli_diagnostic.refuse(fail.user(diagnostic_kind.CLI_UNKNOWN_COMMAND, said.ok));
        val shown: i64 = render_overview(?backing);
        if (shown != exit.OK) { ret shown; }
        ret exit.USER;
    }
    ret args.run(?inv, argv);
}

test dispatch__an_unknown_or_missing_command_shows_usage_and_fails {
    var a0: [2]*u8 = [2]*u8{"mach", "bogus"};
    if (dispatch(2, ?a0[0]) != 1) { ret 1; }
    if (dispatch(1, ?a0[0]) != 1) { ret 2; }
    ret 0;
}

test dispatch__typed_info_and_clean_route_through_the_single_parse {
    var a0: [3]*u8;
    a0[0] = "mach";
    a0[1] = "info";
    a0[2] = "--version";
    if (dispatch(3, ?a0[0]) != 0) { ret 1; }

    var a1: [3]*u8;
    a1[0] = "mach";
    a1[1] = "info";
    a1[2] = "targets";
    if (dispatch(3, ?a1[0]) != 0) { ret 1; }

    var a2: [3]*u8;
    a2[0] = "mach";
    a2[1] = "info";
    a2[2] = "--bogus";
    if (dispatch(3, ?a2[0]) != 1) { ret 1; }

    var a3: [3]*u8;
    a3[0] = "mach";
    a3[1] = "clean";
    a3[2] = "--bogus";
    if (dispatch(3, ?a3[0]) != 1) { ret 1; }

    var a4: [3]*u8;
    a4[0] = "mach";
    a4[1] = "clean";
    a4[2] = "/nonexistent-mach-clean-target";
    if (dispatch(3, ?a4[0]) != 1) { ret 1; }

    var a5: [4]*u8;
    a5[0] = "mach";
    a5[1] = "info";
    a5[2] = "targets";
    a5[3] = "extra";
    if (dispatch(4, ?a5[0]) != 1) { ret 1; }

    var a6: [4]*u8;
    a6[0] = "mach";
    a6[1] = "info";
    a6[2] = "--version";
    a6[3] = "targets";
    if (dispatch(4, ?a6[0]) != 1) { ret 1; }

    ret 0;
}

test dispatch__help_requests_never_reach_the_product_handlers {
    var a0: [2]*u8 = [2]*u8{"mach", "-h"};
    if (dispatch(2, ?a0[0]) != 0) { ret 1; }
    a0[1] = "help";
    if (dispatch(2, ?a0[0]) != 0) { ret 2; }
    var a1: [3]*u8 = [3]*u8{"mach", "help", "build"};
    if (dispatch(3, ?a1[0]) != 0) { ret 3; }
    a1[2] = "bogus";
    if (dispatch(3, ?a1[0]) != 1) { ret 4; }
    var a2: [4]*u8 = [4]*u8{"mach", "clean", "/nonexistent-mach-clean-target", "-h"};
    if (dispatch(4, ?a2[0]) != 0) { ret 5; }
    ret 0;
}

# the invocation argv reads as against COMMANDS
#[testing]
fun t_parse(argc: usize, argv: **u8) args.ParsedInvocation {
    var backing: A.Allocator;
    page.make(?backing);
    val ir: res[args.ParsedInvocation, fail.Fail] = args.parse_invocation(?backing, commands(), argc, argv);
    if (sel ir.err) { ret args.ParsedInvocation{argc: 0, commands: commands(), command: nil, action: nil, sep_idx: 0, marks: nil, occ: nil, occ_len: 0, positional_idx: 0, positional_count: 0, positional_idxs: nil, has_positional: false, refusal: opt[fail.Fail].some{ir.err}, environ: nil}; }
    ret ir.ok;
}

# the kind of the refusal argv reads as; NONE when there is none
#[testing]
fun t_refusal(argc: usize, argv: **u8) diagnostic_kind.Kind {
    var inv: args.ParsedInvocation = t_parse(argc, argv);
    if (sel inv.refusal.some) { ret fail.kind_of(inv.refusal.some); }
    ret diagnostic_kind.NONE;
}

# the build arguments argv reads as, none when it is refused
#[testing]
fun t_cli(argc: usize, argv: **u8) opt[request.CliArgs] {
    var backing: A.Allocator;
    page.make(?backing);
    var inv: args.ParsedInvocation = t_parse(argc, argv);
    if (sel inv.refusal.some) { ret opt[request.CliArgs].none{}; }
    val cr: res[request.CliArgs, fail.Fail] = args.build_cli_invocation(?backing, ?inv, argv);
    if (sel cr.err) { ret opt[request.CliArgs].none{}; }
    ret opt[request.CliArgs].some{cr.ok};
}

test commands__the_command_set_is_total_unique_and_unambiguous {
    if (!args.schema_valid(commands())) { ret 1; }
    ret 0;
}

test build_cli_invocation__emit_ir_takes_an_attached_form_and_never_the_next_token {
    var bare: [4]*u8               = [4]*u8{"mach", "build", "--emit-ir", "."};
    val rb:   opt[request.CliArgs] = t_cli(4, ?bare[0]);
    if (sel rb.none)                 { ret 1; }
    if (!rb.some.emit_ir)            { ret 2; }
    if (rb.some.emit_ir_form != nil) { ret 3; }

    var attached: [4]*u8               = [4]*u8{"mach", "build", "--emit-ir=listing", "."};
    val ra:       opt[request.CliArgs] = t_cli(4, ?attached[0]);
    if (sel ra.none)                                       { ret 4; }
    if (!ra.some.emit_ir)                                  { ret 5; }
    if (ra.some.emit_ir_form == nil)                       { ret 6; }
    if (!str_equals(ra.some.emit_ir_form::str, "listing")) { ret 7; }

    # the bare form must leave the following token a positional, not eat it
    var inv: args.ParsedInvocation = t_parse(4, ?bare[0]);
    if (!inv.has_positional || inv.positional_idx != 3 || sel inv.refusal.some) { ret 8; }
    var inva: args.ParsedInvocation = t_parse(4, ?attached[0]);
    if (!inva.has_positional || inva.positional_idx != 3 || sel inva.refusal.some) { ret 9; }
    ret 0;
}

test build_cli_invocation__o0_and_o2_set_the_release_boolean {
    var a0: [4]*u8               = [4]*u8{"mach", "build", "-O0", "."};
    val r0: opt[request.CliArgs] = t_cli(4, ?a0[0]);
    if (sel r0.none)                             { ret 1; }
    if (!r0.some.opt_set || r0.some.opt_release) { ret 2; }
    var a2: [4]*u8               = [4]*u8{"mach", "build", "-O2", "."};
    val r2: opt[request.CliArgs] = t_cli(4, ?a2[0]);
    if (sel r2.none)                              { ret 3; }
    if (!r2.some.opt_set || !r2.some.opt_release) { ret 4; }
    var an: [3]*u8               = [3]*u8{"mach", "build", "."};
    val rn: opt[request.CliArgs] = t_cli(3, ?an[0]);
    if (sel rn.none)     { ret 5; }
    if (rn.some.opt_set) { ret 6; }
    ret 0;
}

test collect_link_inputs__preserves_command_line_order_across_flags_and_bare_paths {
    var backing: A.Allocator;
    val make_r:  err[A.Error] = page.make(?backing);
    if (sel make_r.err) { ret 1; }
    var a:   [8]*u8                = [8]*u8{"mach", "build", ".", "one.o", "-l", "two", "-L", "dir"};
    var inv: args.ParsedInvocation = t_parse(8, ?a[0]);
    if (sel inv.refusal.some) { ret 2; }

    var c:                     request.CliArgs;
    val collect_link_inputs_r: err[fail.Fail] = args.collect_link_inputs(?backing, ?c, ?inv, ?a[0]);
    if (sel collect_link_inputs_r.err) { ret 3; }

    if (c.link_tokens.len != 2)                           { ret 4; }
    if (!str_equals(c.link_tokens.data[0]::str, "one.o")) { ret 5; }
    if (!str_equals(c.link_tokens.data[1]::str, "two"))   { ret 6; }
    if (c.lib_dirs.len != 1)                              { ret 7; }
    if (!str_equals(c.lib_dirs.data[0]::str, "dir"))      { ret 8; }
    ret 0;
}

test parse_invocation__quiet_is_refused_with_verbose {
    var q:  [3]*u8               = [3]*u8{"mach", "test", "-q"};
    val rq: opt[request.CliArgs] = t_cli(3, ?q[0]);
    if (sel rq.none)    { ret 1; }
    if (!rq.some.quiet) { ret 2; }

    var qv: [4]*u8 = [4]*u8{"mach", "test", "--quiet", "-v"};
    if (t_refusal(4, ?qv[0]) != diagnostic_kind.CLI_FLAG_CONFLICT) { ret 3; }
    ret 0;
}

test parse_invocation__an_option_the_command_does_not_accept_is_unknown_by_name {
    var a: [5]*u8 = [5]*u8{"mach", "doc", ".", "--plan", "x"};
    if (t_refusal(5, ?a[0]) != diagnostic_kind.CLI_FLAG_UNKNOWN) { ret 1; }
    a[3] = "--profile";
    a[4] = "nonesuch";
    if (t_refusal(5, ?a[0]) != diagnostic_kind.CLI_FLAG_UNKNOWN) { ret 2; }
    a[3] = "--emit-ir";
    if (t_refusal(4, ?a[0]) != diagnostic_kind.CLI_FLAG_UNKNOWN) { ret 3; }
    a[3] = "-v";
    if (t_refusal(4, ?a[0]) != diagnostic_kind.CLI_FLAG_UNKNOWN) { ret 4; }
    a[3] = "-a";
    a[4] = "b";
    if (t_refusal(5, ?a[0]) != diagnostic_kind.NONE) { ret 5; }
    a[1] = "run";
    a[3] = "--all";
    if (t_refusal(4, ?a[0]) != diagnostic_kind.CLI_FLAG_UNKNOWN) { ret 6; }
    a[3] = "-t";
    a[4] = "x";
    if (t_refusal(5, ?a[0]) != diagnostic_kind.NONE) { ret 7; }
    a[1] = "build";
    a[3] = "-o";
    if (t_refusal(5, ?a[0]) != diagnostic_kind.NONE) { ret 8; }
    a[3] = "-O1";
    if (t_refusal(4, ?a[0]) != diagnostic_kind.CLI_FLAG_UNKNOWN) { ret 9; }
    ret 0;
}

test parse_invocation__build_repeated_link_options_mark_every_occurrence {
    var a:   [8]*u8                = [8]*u8{"mach", "build", "-l", "one", "-l", "two", "-L", "dir"};
    var inv: args.ParsedInvocation = t_parse(8, ?a[0]);
    var i:   usize                 = 2;
    for (i < 8) {
        if (!inv.marks[i]) { ret 1; }
        i = i + 1;
    }
    if (inv.marks[0] || inv.marks[1]) { ret 2; }
    ret 0;
}

test parse_invocation__run_truncates_at_separator_and_forwards_the_rest {
    var a:   [7]*u8                = [7]*u8{"mach", "run", "--target", "linux", "--", "--runner", "wine"};
    var inv: args.ParsedInvocation = t_parse(7, ?a[0]);
    if (!inv.marks[2] || !inv.marks[3])               { ret 1; }
    if (inv.marks[4] || inv.marks[5] || inv.marks[6]) { ret 2; }
    ret 0;
}

test parse_invocation__a_command_without_options_marks_nothing {
    var a: [4]*u8 = [4]*u8{"mach", "clean", "--bogus", "."};
    var c: usize  = 0;
    for (c < 2) {
        if (c == 1) {
            a[1] = "help";
            a[3] = "build";
        }
        var inv: args.ParsedInvocation = t_parse(4, ?a[0]);
        if (inv.marks[2] || inv.marks[3]) { ret 2; }
        c = c + 1;
    }
    ret 0;
}

test parse_invocation__doc_marks_its_own_options_and_leaves_a_build_only_flag_unknown {
    var a:   [6]*u8                = [6]*u8{"mach", "doc", "-o", "docs", "--pie", "."};
    var inv: args.ParsedInvocation = t_parse(6, ?a[0]);
    if (!inv.marks[2] || !inv.marks[3] || inv.marks[4] || inv.marks[5]) { ret 1; }
    if (t_refusal(6, ?a[0]) != diagnostic_kind.CLI_FLAG_UNKNOWN)        { ret 2; }
    ret 0;
}

test parse_invocation__unknown_command_and_unknown_dep_action {
    var a:   [3]*u8                = [3]*u8{"mach", "bogus", "x"};
    var inv: args.ParsedInvocation = t_parse(3, ?a[0]);
    if (inv.command != nil || sel inv.refusal.some) { ret 1; }
    var b:    [3]*u8                = [3]*u8{"mach", "dep", "bogus"};
    var inv2: args.ParsedInvocation = t_parse(3, ?b[0]);
    if (inv2.command != ?cmd_dep.COMMAND || inv2.action != nil)    { ret 2; }
    if (t_refusal(3, ?b[0]) != diagnostic_kind.CLI_UNKNOWN_ACTION) { ret 3; }
    ret 0;
}

# `--no-cache` is the one cache option: `--cache` is unknown everywhere
test cache__no_cache_is_the_one_cache_option {
    var argv: [4]*u8 = [4]*u8{"mach", "build", "project", "--no-cache"};
    var i:    u32    = 0;
    for (i < 2) {
        if (i == 1) { argv[1] = "test"; }
        var inv: args.ParsedInvocation = t_parse(4, ?argv[0]);
        if (sel inv.refusal.some || inv.positional_count != 1 || inv.positional_idx != 2) { ret 3; }
        val c: opt[request.CliArgs] = t_cli(4, ?argv[0]);
        if (sel c.none)       { ret 4; }
        if (!c.some.no_cache) { ret 5; }
        i = i + 1;
    }
    argv[3] = "--cache";
    var names: [3]*u8 = [3]*u8{"build", "test", "run"};
    i = 0;
    for (i < 3) {
        argv[1] = names[i];
        if (t_refusal(4, ?argv[0]) != diagnostic_kind.CLI_FLAG_UNKNOWN) { ret 6 + i::i32; }
        i = i + 1;
    }
    ret 0;
}

test parse_invocation__a_lone_dash_is_a_positional_not_an_unknown_flag {
    var argv: [4]*u8                = [4]*u8{"mach", "fmt", "-", "--check"};
    var inv:  args.ParsedInvocation = t_parse(4, ?argv[0]);
    if (inv.command != ?fmt.COMMAND || inv.positional_count != 1 || inv.positional_idx != 2
        || sel inv.refusal.some) { ret 3; }
    if (util.arg_is_flag("-") || !util.arg_is_flag("--") || !util.arg_is_flag("-o")) { ret 4; }
    ret 0;
}

#[testing]
fun max_line_width(text: str) usize {
    val n:    usize = str_len(text);
    var max:  usize = 0;
    var line: usize = 0;
    var i:    usize = 0;
    for (i < n) {
        if (text[i] == '\n') {
            if (line > max) { max = line; }
            line = 0;
        }
        or { line = line + 1; }
        i = i + 1;
    }
    if (line > max) { max = line; }
    ret max;
}

# the page argv asks for, or none when it asks for no page or names an unknown one
#[testing]
fun t_page(argc: usize, argv: **u8) opt[help.Page] {
    var backing: A.Allocator;
    page.make(?backing);
    var inv: args.ParsedInvocation = t_parse(argc, argv);
    if (inv.command == nil || sel inv.refusal.some)                 { ret opt[help.Page].none{}; }
    if (inv.command != ?help.COMMAND && !args.help_requested(?inv)) { ret opt[help.Page].none{}; }
    val p: res[help.Page, fail.Fail] = help.page_for(?backing, ?inv, argv);
    if (sel p.err) { ret opt[help.Page].none{}; }
    ret opt[help.Page].some{p.ok};
}

# the kind of the failure naming the page argv asks for; NONE when the page is found
#[testing]
fun t_page_refusal(argc: usize, argv: **u8) diagnostic_kind.Kind {
    var backing: A.Allocator;
    page.make(?backing);
    var inv: args.ParsedInvocation = t_parse(argc, argv);
    if (sel inv.refusal.some) { ret fail.kind_of(inv.refusal.some); }
    val p: res[help.Page, fail.Fail] = help.page_for(?backing, ?inv, argv);
    if (sel p.err) { ret fail.kind_of(p.err); }
    ret diagnostic_kind.NONE;
}

#[testing]
fun t_page_is(argc: usize, argv: **u8, command: *args.CommandSpec, action: *args.ActionSpec) bool {
    val p: opt[help.Page] = t_page(argc, argv);
    if (sel p.none) { ret false; }
    ret p.some.command == command && p.some.action == action;
}

#[testing]
fun t_no_page(argc: usize, argv: **u8) bool {
    val p: opt[help.Page] = t_page(argc, argv);
    ret sel p.none;
}

test page_for__every_help_form_names_its_page {
    var a0: [2]*u8 = [2]*u8{"mach", "-h"};
    if (!t_page_is(2, ?a0[0], nil, nil)) { ret 1; }
    a0[1] = "--help";
    if (!t_page_is(2, ?a0[0], nil, nil)) { ret 2; }
    a0[1] = "help";
    if (!t_page_is(2, ?a0[0], nil, nil)) { ret 3; }
    var a1: [3]*u8 = [3]*u8{"mach", "help", "help"};
    if (!t_page_is(3, ?a1[0], nil, nil)) { ret 4; }
    a1[2] = "-h";
    if (!t_page_is(3, ?a1[0], nil, nil)) { ret 5; }

    var i: usize = 0;
    for (i < COMMANDS_N) {
        val command: *args.CommandSpec = COMMANDS[i];
        i = i + 1;
        if (command == ?help.COMMAND) { cnt; }
        a1[1] = "help";
        a1[2] = command.name::*u8;
        if (!t_page_is(3, ?a1[0], command, nil)) { ret 6; }
        a1[1] = command.name::*u8;
        a1[2] = "-h";
        if (!t_page_is(3, ?a1[0], command, nil)) { ret 7; }
        a1[2] = "--help";
        if (!t_page_is(3, ?a1[0], command, nil)) { ret 8; }
        var j: usize = 0;
        for (j < command.alias_n) {
            a1[1] = "help";
            a1[2] = command.aliases[j]::*u8;
            if (!t_page_is(3, ?a1[0], command, nil)) { ret 9; }
            j = j + 1;
        }
    }

    # a help flag anywhere among the command's arguments asks for its page
    var a2: [5]*u8 = [5]*u8{"mach", "build", ".", "--bogus", "-h"};
    if (!t_page_is(5, ?a2[0], ?build.COMMAND, nil)) { ret 10; }
    ret 0;
}

test page_for__help_is_a_flag_never_a_value_or_an_operand {
    var check: [5]*u8                = [5]*u8{"mach", "check", ".", "--target", "help"};
    var inv:   args.ParsedInvocation = t_parse(5, ?check[0]);
    if (inv.command != ?build.CHECK || args.help_requested(?inv) || sel inv.refusal.some) { ret 1; }
    val target: opt[*u8] = args.value(?inv, ?check[0], ?args.TARGET);
    if (sel target.none)                       { ret 2; }
    if (!str_equals(target.some::str, "help")) { ret 2; }
    var filter: [5]*u8 = [5]*u8{"mach", "test", ".", "--filter", "-h"};
    if (!t_no_page(5, ?filter[0])) { ret 3; }
    var init_help: [3]*u8 = [3]*u8{"mach", "init", "help"};
    if (!t_no_page(3, ?init_help[0]) || t_refusal(3, ?init_help[0]) != diagnostic_kind.NONE) { ret 4; }
    var forwarded: [5]*u8 = [5]*u8{"mach", "run", ".", "--", "--help"};
    if (!t_no_page(5, ?forwarded[0]) || t_refusal(5, ?forwarded[0]) != diagnostic_kind.NONE) { ret 5; }
    ret 0;
}

test page_for__an_unknown_command_or_action_is_refused {
    var unknown: [3]*u8 = [3]*u8{"mach", "help", "bogus"};
    if (t_page_refusal(3, ?unknown[0]) != diagnostic_kind.CLI_UNKNOWN_COMMAND) { ret 1; }
    var no_action: [4]*u8 = [4]*u8{"mach", "help", "build", "add"};
    if (t_page_refusal(4, ?no_action[0]) != diagnostic_kind.CLI_OPERAND) { ret 2; }
    var bad_action: [4]*u8 = [4]*u8{"mach", "help", "dep", "bogus"};
    if (t_page_refusal(4, ?bad_action[0]) != diagnostic_kind.CLI_UNKNOWN_ACTION) { ret 3; }
    var local: [4]*u8 = [4]*u8{"mach", "dep", "bogus", "--help"};
    if (t_page_refusal(4, ?local[0]) != diagnostic_kind.CLI_UNKNOWN_ACTION) { ret 4; }
    var extra: [5]*u8 = [5]*u8{"mach", "help", "dep", "add", "x"};
    if (t_page_refusal(5, ?extra[0]) != diagnostic_kind.CLI_OPERAND) { ret 5; }
    var dep: [3]*u8 = [3]*u8{"mach", "dep", "-h"};
    if (!t_page_is(3, ?dep[0], ?cmd_dep.COMMAND, nil)) { ret 6; }
    ret 0;
}

test parse_invocation__version_is_a_global_option_of_info {
    var argv: [2]*u8                = [2]*u8{"mach", "--version"};
    var inv:  args.ParsedInvocation = t_parse(2, ?argv[0]);
    if (inv.command != ?info.COMMAND || sel inv.refusal.some) { ret 1; }
    if (!args.given(?inv, ?info.VERSION))                     { ret 2; }
    if (dispatch(2, ?argv[0]) != 0)                           { ret 3; }
    var dep: [6]*u8 = [6]*u8{"mach", "dep", "add", ".", "x", "--version"};
    if (t_refusal(6, ?dep[0]) != diagnostic_kind.CLI_FLAG_UNKNOWN) { ret 4; }
    ret 0;
}

#[testing]
var action_heading_buf: [64]u8;

# "\n  <name>" for the dep action at i, the line start of that action's heading in the command page
#[testing]
fun heading_of(i: usize) str {
    val name: str   = cmd_dep.COMMAND.actions[i].name;
    val n:    usize = str_len(name);
    action_heading_buf[0] = '\n';
    action_heading_buf[1] = ' ';
    action_heading_buf[2] = ' ';
    var k: usize = 0;
    for (k < n && k < 59) {
        action_heading_buf[3 + k] = name[k];
        k                         = k + 1;
    }
    action_heading_buf[3 + k] = ' ';
    action_heading_buf[4 + k] = 0;
    ret (?action_heading_buf[0])::str;
}

#[testing]
fun index_of(hay: str, from: usize, needle: str) usize {
    val n: usize = str_len(hay);
    var k: usize = from;
    for (k < n) {
        if (str_starts_with((?hay[k])::str, needle)) { ret k; }
        k = k + 1;
    }
    ret n;
}

# every `mach help dep <action>` prints exactly that action's block of `mach help dep`
test render_page__action_pages_are_slices_of_the_command_page {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var page_sink: fixture.MemSink;
    var page_out:  io_writer.Writer;
    fixture.mem_writer(?page_out, ?page_sink);
    fin { fixture.mem_sink_dnit(?page_sink); }
    val paged: err[fail.Fail] = help.render_command_page_at(?alloc, commands(), ?page_out, ?cmd_dep.COMMAND, 100);
    if (sel paged.err) { ret 2; }
    val full: str   = fixture.sink_text(?page_sink);
    val list: usize = index_of(full, 0, "\nactions:\n");
    # the list ends where the page's trailing blank line and exit line begin
    val done: usize = index_of(full, list + 10, "\n\nexit:");
    if (done >= str_len(full)) { ret 3; }

    var out_sink: fixture.MemSink;
    var out:      io_writer.Writer;
    fixture.mem_writer(?out, ?out_sink);
    fin { fixture.mem_sink_dnit(?out_sink); }
    var i: usize = 0;
    for (i < cmd_dep.COMMAND.action_n) {
        val start: usize = index_of(full, list, heading_of(i)) + 1;
        var end:   usize = done + 1;
        if (i + 1 < cmd_dep.COMMAND.action_n)                { end = index_of(full, start, heading_of(i + 1)) + 1; }
        if (start >= done || end > done + 1 || end <= start) { ret 4; }

        val action: *args.ActionSpec = ?cmd_dep.COMMAND.actions[i];
        var argv:   [4]*u8           = [4]*u8{"mach", "help", "dep", action.name::*u8};
        if (!t_page_is(4, ?argv[0], ?cmd_dep.COMMAND, action)) { ret 5; }
        var local: [4]*u8 = [4]*u8{"mach", "dep", action.name::*u8, "-h"};
        if (!t_page_is(4, ?local[0], ?cmd_dep.COMMAND, action)) { ret 7; }

        out_sink.len = 0;
        val rendered: err[fail.Fail] = help.render_action_page_at(?alloc, commands(), ?out, ?cmd_dep.COMMAND, action, 100);
        if (sel rendered.err)            { ret 8; }
        if (out_sink.len != end - start) { ret 9; }
        var k: usize = 0;
        for (k < out_sink.len) {
            if (out_sink.buf[k] != full[start + k]) { ret 10; }
            k = k + 1;
        }
        i = i + 1;
    }
    ret 0;
}

# an action the command lacks is refused with the valid actions
test page_for__an_unknown_action_names_the_actions {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var argv: [4]*u8                    = [4]*u8{"mach", "help", "dep", "bogus"};
    var inv:  args.ParsedInvocation     = t_parse(4, ?argv[0]);
    val p:    res[help.Page, fail.Fail] = help.page_for(?alloc, ?inv, ?argv[0]);
    if (sel p.ok) { ret 2; }
    val said: str = fail.describe(p.err);
    if (!str_starts_with(said, "unknown dep action 'bogus'; the actions are list, ")) { ret 3; }
    var i: usize = 0;
    for (i < cmd_dep.COMMAND.action_n) {
        if (!str_contains(said, cmd_dep.COMMAND.actions[i].name)) { ret 4; }
        i = i + 1;
    }
    ret 0;
}

test render__a_page_carries_its_grammar_and_only_the_rows_its_command_accepts {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var out_sink: fixture.MemSink;
    var out:      io_writer.Writer;
    fixture.mem_writer(?out, ?out_sink);
    fin { fixture.mem_sink_dnit(?out_sink); }

    val build_r: err[fail.Fail] = help.render_command_page_at(?alloc, commands(), ?out, ?build.COMMAND, 100);
    if (sel build_r.err)                                                                               { ret 2; }
    if (!str_contains(fixture.sink_text(?out_sink), "usage: mach build <path> [options] [inputs...]")) { ret 3; }

    out_sink.len = 0;
    val run_r: err[fail.Fail] = help.render_command_page_at(?alloc, commands(), ?out, ?run.COMMAND, 100);
    if (sel run_r.err) { ret 4; }
    val run: str = fixture.sink_text(?out_sink);
    if (!str_contains(run, "-a <pattern>") || str_contains(run, "--all ")) { ret 5; }

    out_sink.len = 0;
    val doc_r: err[fail.Fail] = help.render_command_page_at(?alloc, commands(), ?out, ?cmd_doc.COMMAND, 100);
    if (sel doc_r.err) { ret 6; }
    val doc: str = fixture.sink_text(?out_sink);
    if (str_contains(doc, "--profile") || str_contains(doc, "--pie") || str_contains(doc, "  -v")) { ret 7; }
    ret 0;
}

test render_page__a_failed_write_is_the_environment_and_a_partial_one_stops {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var out_sink: fixture.MemSink;
    var out:      io_writer.Writer;
    fixture.mem_writer(?out, ?out_sink);
    fin { fixture.mem_sink_dnit(?out_sink); }
    val info_page: help.Page = help.Page{command: ?info.COMMAND, action: nil};

    val ok: err[fail.Fail] = help.render_page(?alloc, commands(), ?out, info_page, 100);
    if (sel ok.err || out_sink.len == 0) { ret 2; }

    out_sink.len     = 0;
    out_sink.fail    = true;
    out_sink.fail_at = 0;
    val refused: err[fail.Fail] = help.render_page(?alloc, commands(), ?out, info_page, 100);
    if (sel refused.ok)                           { ret 3; }
    if (exit.of(refused.err) != exit.ENVIRONMENT) { ret 3; }

    out_sink.len     = 0;
    out_sink.fail_at = 10;
    val partial: err[fail.Fail] = help.render_page(?alloc, commands(), ?out, info_page, 100);
    if (sel partial.ok)                           { ret 4; }
    if (exit.of(partial.err) != exit.ENVIRONMENT) { ret 4; }
    if (out_sink.len != 10)                       { ret 5; }
    ret 0;
}

test render_page__allocation_failure_is_internal_and_publishes_nothing {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 3; }
    fin { T.dnit(?t); }
    T.fail_from_ordinal(?t, 1);
    var out_sink: fixture.MemSink;
    var out:      io_writer.Writer;
    fixture.mem_writer(?out, ?out_sink);
    fin { fixture.mem_sink_dnit(?out_sink); }
    val shown: err[fail.Fail] = help.render_page(T.allocator_of(?t), commands(), ?out, help.Page{command: nil, action: nil}, 100);
    if (sel shown.ok)                        { ret 1; }
    if (exit.of(shown.err) != exit.INTERNAL) { ret 1; }
    if (out_sink.len != 0)                   { ret 2; }
    ret 0;
}

test render__respects_narrow_and_wide_layout_widths {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var out_sink: fixture.MemSink;
    var out:      io_writer.Writer;
    fixture.mem_writer(?out, ?out_sink);
    fin { fixture.mem_sink_dnit(?out_sink); }

    var widths: [2]usize;
    widths[0] = 56;
    widths[1] = 120;
    var wi: usize = 0;
    for (wi < 2) {
        var ci: usize = 0;
        for (ci < COMMANDS_N) {
            out_sink.len = 0;
            val render_command_page_at_r: err[fail.Fail] = help.render_command_page_at(?alloc, commands(), ?out, COMMANDS[ci], widths[wi]);
            if (sel render_command_page_at_r.err)                          { ret 2; }
            if (max_line_width(fixture.sink_text(?out_sink)) > widths[wi]) { ret 3; }
            ci = ci + 1;
        }
        out_sink.len = 0;
        val render_overview_at_r: err[fail.Fail] = help.render_overview_at(?alloc, commands(), ?out, widths[wi]);
        if (sel render_overview_at_r.err)                              { ret 4; }
        if (max_line_width(fixture.sink_text(?out_sink)) > widths[wi]) { ret 5; }
        wi = wi + 1;
    }
    ret 0;
}

# every shared exit meaning and every one of the page's own notes is on the page
#[testing]
fun t_exits_listed(text: str, own: *exit.Note, own_n: usize) bool {
    var i: usize = 0;
    for (i < exit.SHARED_N) {
        if (!str_contains(text, exit.SHARED[i].meaning)) { ret false; }
        i = i + 1;
    }
    i = 0;
    for (i < own_n) {
        if (!str_contains(text, own[i].meaning)) { ret false; }
        i = i + 1;
    }
    ret true;
}

test render__every_visible_schema_entry_appears_and_every_rendered_flag_parses {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var out_sink: fixture.MemSink;
    var out:      io_writer.Writer;
    fixture.mem_writer(?out, ?out_sink);
    fin { fixture.mem_sink_dnit(?out_sink); }

    var ci: usize = 0;
    for (ci < COMMANDS_N) {
        val command: *args.CommandSpec = COMMANDS[ci];
        if (command == ?help.COMMAND) {
            ci = ci + 1;
            cnt;
        }

        out_sink.len = 0;
        val render_command_page_at_r: err[fail.Fail] = help.render_command_page_at(?alloc, commands(), ?out, command, 200);
        if (sel render_command_page_at_r.err) { ret 2; }
        val text: str = fixture.sink_text(?out_sink);

        if (!t_exits_listed(text, command.exits, command.exit_n)) { ret 3; }

        var ti: usize = 0;
        for (ti < command.table_n) {
            val table: *args.TableRef = ?command.tables[ti];
            var fj:    usize          = 0;
            for (fj < table.n) {
                if (table.accepted != nil && !table.accepted[fj]) {
                    fj = fj + 1;
                    cnt;
                }
                val flag: *args.FlagSpec = table.rows[fj];
                if (!str_contains(text, flag.name))           { ret 4; }
                if (!args.schema_accepts(command, nil, flag)) { ret 5; }
                fj = fj + 1;
            }
            ti = ti + 1;
        }

        var cj: usize = 0;
        for (cj < command.constraint_n) {
            if (!str_contains(text, command.constraints[cj])) { ret 6; }
            cj = cj + 1;
        }

        if (command.action_n > 0) {
            var ai: usize = 0;
            for (ai < command.action_n) {
                val action: *args.ActionSpec = ?command.actions[ai];
                if (!t_exits_listed(text, action.exits, action.exit_n)) { ret 7; }
                var ati: usize = 0;
                for (ati < action.table_n) {
                    val table: *args.TableRef = ?action.tables[ati];
                    var afj:   usize          = 0;
                    for (afj < table.n) {
                        if (table.accepted != nil && !table.accepted[afj]) {
                            afj = afj + 1;
                            cnt;
                        }
                        val flag: *args.FlagSpec = table.rows[afj];
                        if (!str_contains(text, flag.name))              { ret 8; }
                        if (!args.schema_accepts(command, action, flag)) { ret 9; }
                        afj = afj + 1;
                    }
                    ati = ati + 1;
                }
                var acj: usize = 0;
                for (acj < action.constraint_n) {
                    if (!str_contains(text, action.constraints[acj])) { ret 10; }
                    acj = acj + 1;
                }
                ai = ai + 1;
            }
        }

        ci = ci + 1;
    }
    ret 0;
}
