use std.allocator.page;
use std.filesystem;
use std.io.writer;
use std.print;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_contains;
use std.types.string.str_copy_slice;
use std.types.string.str_len;
use std.collections.vector;
use std.collections.vector.Vector;

use A: std.allocator;
use O: std.types.option;
use R: std.types.result;

use mach.cli.args;
use mach.cli.cmd.build;
use mach.cli.cmd.clean;
use mach.cli.cmd.dep;
use mach.cli.cmd.doc;
use mach.cli.cmd.help;
use mach.cli.cmd.info;
use mach.cli.cmd.init;
use mach.cli.cmd.run;
use mach.cli.cmd.testing;

fun render_help(route: *help.HelpRoute) i64 {
    var backing: A.Allocator;
    if (O.is_some[str](page.make(?backing))) {
        print.eprint("error: failed to initialise allocator\n");
        ret 2;
    }
    var out: writer.Writer = filesystem.writer(filesystem.STDOUT);
    var err: writer.Writer = filesystem.writer(filesystem.STDERR);
    ret help.render_route(?backing, ?out, ?err, route);
}

fun render_overview(a: *A.Allocator) i64 {
    var out: writer.Writer = filesystem.writer(filesystem.STDOUT);
    if (R.is_err[R.Void, str](help.render_overview(a, ?out))) { ret 2; }
    ret 0;
}

# the `mach` entry point: route argv to one command and return its exit code
# help requests are rendered first; with no arguments the overview prints and the code is 1;
# an unknown command prints an error and the overview
# ---
# argc: process argument count
# argv: process arguments, argv[0] the program
# ret: the exit code: 0 success, 1 usage or user error, 2 when the allocator or the
#  invocation could not be set up, otherwise the command's own code
pub fun dispatch(argc: usize, argv: **u8) i64 {
    val route: help.HelpRoute = help.resolve_help_route(argc, argv);
    if (route.kind != help.HELP_ROUTE_NONE) { ret render_help(?route); }

    if (argc < 2) {
        var noarg_alloc: A.Allocator;
        if (O.is_some[str](page.make(?noarg_alloc))) { ret 2; }
        if (render_overview(?noarg_alloc) == 2) { ret 2; }
        ret 1;
    }

    var backing: A.Allocator;
    if (O.is_some[str](page.make(?backing))) {
        print.eprint("error: failed to initialise allocator\n");
        ret 2;
    }
    val ir: R.Result[args.ParsedInvocation, str] = args.parse_invocation(?backing, argc, argv);
    if (R.is_err[args.ParsedInvocation, str](ir)) {
        print.eprint("error: failed to initialise allocator\n");
        ret 2;
    }
    var inv: args.ParsedInvocation = R.unwrap_ok[args.ParsedInvocation, str](ir);

    if (!inv.has_command) {
        val command: str = argv[1]::str;
        print.eprint("error: unknown command '");
        print.eprint(command);
        print.eprint("'\n");
        if (render_overview(?backing) == 2) {
            args.dnit_invocation(?backing, ?inv);
            ret 2;
        }
        args.dnit_invocation(?backing, ?inv);
        ret 1;
    }

    var rc: i64 = 97;
    if (inv.command == args.CMD_INFO)  { rc = info.run_typed(argv, ?inv);    }
    or (inv.command == args.CMD_CLEAN) { rc = clean.run_typed(argv, ?inv);   }
    or (inv.command == args.CMD_BUILD) { rc = build.run_typed(argv, ?inv);   }
    or (inv.command == args.CMD_RUN)   { rc = run.run_typed(argv, ?inv);    }
    or (inv.command == args.CMD_TEST)  { rc = testing.run_typed(argv, ?inv); }
    or (inv.command == args.CMD_DEP)   { rc = dep.run_typed(argv, ?inv);    }
    or (inv.command == args.CMD_INIT)  { rc = init.run_typed(argv, ?inv);   }
    or (inv.command == args.CMD_DOC)   { rc = doc.run_typed(argv, ?inv);    }

    args.dnit_invocation(?backing, ?inv);
    ret rc;
}

test "mach.cli.cmd.dispatch:unknown_command_reports_and_shows_usage" {
    var a0: [2]*u8;
    a0[0] = "mach"; a0[1] = "bogus";
    if (dispatch(2, ?a0[0]) != 1) { ret 1; }
    ret 0;
}

test "mach.cli.cmd.dispatch:no_arguments_shows_usage_and_fails" {
    var a0: [1]*u8;
    a0[0] = "mach";
    if (dispatch(1, ?a0[0]) != 1) { ret 1; }
    ret 0;
}

test "mach.cli.cmd.dispatch:typed_info_and_clean_route_through_the_single_parse" {
    var a0: [3]*u8;
    a0[0] = "mach"; a0[1] = "info"; a0[2] = "--version";
    if (dispatch(3, ?a0[0]) != 0) { ret 1; }

    var a1: [3]*u8;
    a1[0] = "mach"; a1[1] = "info"; a1[2] = "targets";
    if (dispatch(3, ?a1[0]) != 0) { ret 1; }

    var a2: [3]*u8;
    a2[0] = "mach"; a2[1] = "info"; a2[2] = "--bogus";
    if (dispatch(3, ?a2[0]) != 1) { ret 1; }

    var a3: [3]*u8;
    a3[0] = "mach"; a3[1] = "clean"; a3[2] = "--bogus";
    if (dispatch(3, ?a3[0]) != 1) { ret 1; }

    var a4: [3]*u8;
    a4[0] = "mach"; a4[1] = "clean"; a4[2] = "/nonexistent-mach-clean-target";
    if (dispatch(3, ?a4[0]) != 1) { ret 1; }

    var a5: [4]*u8;
    a5[0] = "mach"; a5[1] = "info"; a5[2] = "targets"; a5[3] = "extra";
    if (dispatch(4, ?a5[0]) != 1) { ret 1; }

    var a6: [4]*u8;
    a6[0] = "mach"; a6[1] = "info"; a6[2] = "--version"; a6[3] = "targets";
    if (dispatch(4, ?a6[0]) != 1) { ret 1; }

    ret 0;
}

test "mach.cli.cmd.dispatch:help_routes_never_reach_the_product_handlers" {
    var a0: [2]*u8;
    a0[0] = "mach"; a0[1] = "-h";
    if (dispatch(2, ?a0[0]) != 0) { ret 1; }

    var a1: [2]*u8;
    a1[0] = "mach"; a1[1] = "--help";
    if (dispatch(2, ?a1[0]) != 0) { ret 1; }

    var a2: [2]*u8;
    a2[0] = "mach"; a2[1] = "help";
    if (dispatch(2, ?a2[0]) != 0) { ret 1; }

    var a3: [3]*u8;
    a3[0] = "mach"; a3[1] = "help"; a3[2] = "build";
    if (dispatch(3, ?a3[0]) != 0) { ret 1; }

    var a4: [3]*u8;
    a4[0] = "mach"; a4[1] = "build"; a4[2] = "-h";
    if (dispatch(3, ?a4[0]) != 0) { ret 1; }

    var a5: [3]*u8;
    a5[0] = "mach"; a5[1] = "help"; a5[2] = "bogus";
    if (dispatch(3, ?a5[0]) != 1) { ret 1; }

    var a6: [4]*u8;
    a6[0] = "mach"; a6[1] = "build"; a6[2] = "-h"; a6[3] = "extra";
    if (dispatch(4, ?a6[0]) != 1) { ret 1; }

    ret 0;
}

fun census_join(alloc: *A.Allocator, dir: str, name: str) R.Result[str, str] {
    val dl: usize = str_len(dir);
    val nl: usize = str_len(name);
    val rb: R.Result[*u8, str] = A.allocate[u8](alloc, dl + nl + 2);
    if (R.is_err[*u8, str](rb)) { ret R.err[str, str]("out of memory joining a path"); }
    val buf: *u8 = R.unwrap_ok[*u8, str](rb);

    var i: usize = 0;
    for (i < dl) { buf[i] = dir[i]::u8; i = i + 1; }
    buf[dl] = '/'::u8;
    var j: usize = 0;
    for (j < nl) { buf[dl + 1 + j] = name[j]::u8; j = j + 1; }
    buf[dl + 1 + nl] = 0;
    ret R.ok[str, str](buf::str);
}

fun census_find_root(alloc: *A.Allocator) O.Option[str] {
    var prefix: str = ".";
    var depth: usize = 0;
    for (depth < 8) {
        val rj: R.Result[str, str] = census_join(alloc, prefix, "src/cli/args.mach");
        if (R.is_err[str, str](rj)) { ret O.none[str](); }
        if (filesystem.is_file(R.unwrap_ok[str, str](rj))) { ret O.some[str](prefix); }

        val ru: R.Result[str, str] = census_join(alloc, prefix, "..");
        if (R.is_err[str, str](ru)) { ret O.none[str](); }
        prefix = R.unwrap_ok[str, str](ru);
        depth  = depth + 1;
    }
    ret O.none[str]();
}

val CENSUS_BANNED_N: usize = 4;
val CENSUS_BANNED: [CENSUS_BANNED_N]str = [CENSUS_BANNED_N]str{
    "args.collect_build(",
    "util.arg_index_positional(",
    "util.flag_reject_unknown(",
    "LegacyCommandPayload",
};

val CENSUS_FILE_N: usize = 4;
val CENSUS_FILES: [CENSUS_FILE_N]str = [CENSUS_FILE_N]str{
    "src/cli/cmd/build.mach",
    "src/cli/cmd/testing.mach",
    "src/cli/cmd/init.mach",
    "src/cli/args.mach",
};

val CENSUS_FILE_BANNED_START: [CENSUS_FILE_N]usize = [CENSUS_FILE_N]usize{ 0, 0, 0, 5 };

test "mach.cli.cmd.dispatch:census_typed_commands_never_reparse_argv_after_the_single_pass" {
    var a: A.Allocator;
    if (O.is_some[str](page.make(?a))) { ret 2; }

    val root_o: O.Option[str] = census_find_root(?a);
    if (O.is_none[str](root_o)) {
        print.eprintln("census: cannot locate the source root from the working directory");
        ret 2;
    }
    val root: str = O.unwrap[str](root_o);

    var fi: usize = 0;
    for (fi < CENSUS_FILE_N) {
        val fp_r: R.Result[str, str] = census_join(?a, root, CENSUS_FILES[fi]);
        if (R.is_err[str, str](fp_r)) { ret 2; }
        val fp: str = R.unwrap_ok[str, str](fp_r);

        val rb: R.Result[Vector[u8], str] = filesystem.read_bytes(?a, fp);
        if (R.is_err[Vector[u8], str](rb)) {
            print.eprintlnf("census: cannot read {}", fp);
            ret 2;
        }
        var bytes: Vector[u8] = R.unwrap_ok[Vector[u8], str](rb);
        val text_r: R.Result[str, str] = str_copy_slice(?a, bytes.data::str, 0, bytes.len);
        vector.dnit[u8](?bytes);
        if (R.is_err[str, str](text_r)) { ret 2; }
        val text: str = R.unwrap_ok[str, str](text_r);

        var bi: usize = CENSUS_FILE_BANNED_START[fi];
        for (bi < CENSUS_BANNED_N) {
            if (str_contains(text, CENSUS_BANNED[bi])) {
                print.eprintlnf("census: {} still contains banned pattern '{}'", CENSUS_FILES[fi], CENSUS_BANNED[bi]);
                ret 1;
            }
            bi = bi + 1;
        }
        fi = fi + 1;
    }
    ret 0;
}
