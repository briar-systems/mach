use mach.cli.cmd.testing;

fun render_help(route: *help.HelpRoute) i64 {
    var backing: A.Allocator;
    val make_r:  err[A.Error] = page.make(?backing);
    if (sel make_r.err) {
        print.eprint("error: failed to initialise allocator\n");
        ret 2;
    }
    var out:   writer.Writer = filesystem.writer(filesystem.STDOUT);
    var fault: writer.Writer = filesystem.writer(filesystem.STDERR);
    ret help.render_route(?backing, ?out, ?fault, route);
}

fun render_overview(a: *A.Allocator) i64 {
    var out:               writer.Writer     = filesystem.writer(filesystem.STDOUT);
    val render_overview_r: err[outcome.Fail] = help.render_overview(a, ?out);
    if (sel render_overview_r.err) { ret 2; }
    ret 0;
}

# the `mach` entry point: route argv to one command and return its exit code
# help requests are rendered first; with no arguments the overview prints and the code is 1;
# an unknown command prints an error and the overview
# ---
# argc: process argument count
# argv: process arguments, argv[0] the program
# ret:  the exit code: 0 success, 1 usage or user error, 2 when the allocator or the
#       invocation could not be set up, otherwise the command's own code
pub fun dispatch(argc: usize, argv: **u8) i64 {
    val route: help.HelpRoute = help.resolve_help_route(argc, argv);
    if (route.kind != help.HELP_ROUTE_NONE) { ret render_help(?route); }

    if (argc < 2) {
        var noarg_alloc: A.Allocator;
        val make_r:      err[A.Error] = page.make(?noarg_alloc);
        if (sel make_r.err)                     { ret 2; }
        if (render_overview(?noarg_alloc) == 2) { ret 2; }
        ret 1;
    }

    var backing: A.Allocator;
    val make_r2: err[A.Error] = page.make(?backing);
    if (sel make_r2.err) {
        print.eprint("error: failed to initialise allocator\n");
        ret 2;
    }
    val ir: res[args.ParsedInvocation, outcome.Fail] = args.parse_invocation(?backing, argc, argv);
    if (sel ir.err) {
        print.eprint("error: failed to initialise allocator\n");
        ret 2;
    }
    var inv: args.ParsedInvocation = ir.ok;

    if (!inv.has_command) {
        val command: str = argv[1]::str;
        print.eprint("error: unknown command '");
        print.eprint(command);
        print.eprint("'\n");
        if (render_overview(?backing) == 2) {
            args.dnit_invocation(?backing, ?inv);
            ret 2;
        }
        args.dnit_invocation(?backing, ?inv);
        ret 1;
    }

    var rc: i64 = 97;
    if (inv.command == args.CMD_INFO)  { rc = info.run(argv, ?inv); }
    or (inv.command == args.CMD_CLEAN) { rc = clean.run(argv, ?inv); }
    or (inv.command == args.CMD_BUILD) { rc = build.run(argv, ?inv); }
    or (inv.command == args.CMD_CHECK) { rc = build.check(argv, ?inv); }
    or (inv.command == args.CMD_RUN)   { rc = run.run(argv, ?inv); }
    or (inv.command == args.CMD_TEST)  { rc = testing.run(argv, ?inv); }
    or (inv.command == args.CMD_DEP)   { rc = dep.run(argv, ?inv); }
    or (inv.command == args.CMD_INIT)  { rc = init.run(argv, ?inv); }
    or (inv.command == args.CMD_DOC)   { rc = doc.run(argv, ?inv); }
    or (inv.command == args.CMD_FMT)   { rc = fmt.run(argv, ?inv); }

    args.dnit_invocation(?backing, ?inv);
    ret rc;
}

test "mach.cli.cmd.dispatch:unknown_command_reports_and_shows_usage" {
    var a0: [2]*u8;
    a0[0] = "mach";
    a0[1] = "bogus";
    if (dispatch(2, ?a0[0]) != 1) { ret 1; }
    ret 0;
}

test "mach.cli.cmd.dispatch:no_arguments_shows_usage_and_fails" {
    var a0: [1]*u8;
    a0[0] = "mach";
    if (dispatch(1, ?a0[0]) != 1) { ret 1; }
    ret 0;
}

test "mach.cli.cmd.dispatch:typed_info_and_clean_route_through_the_single_parse" {
    var a0: [3]*u8;
    a0[0] = "mach";
    a0[1] = "info";
    a0[2] = "--version";
    if (dispatch(3, ?a0[0]) != 0) { ret 1; }

    var a1: [3]*u8;
    a1[0] = "mach";
    a1[1] = "info";
    a1[2] = "targets";
    if (dispatch(3, ?a1[0]) != 0) { ret 1; }

    var a2: [3]*u8;
    a2[0] = "mach";
    a2[1] = "info";
    a2[2] = "--bogus";
    if (dispatch(3, ?a2[0]) != 1) { ret 1; }

    var a3: [3]*u8;
    a3[0] = "mach";
    a3[1] = "clean";
    a3[2] = "--bogus";
    if (dispatch(3, ?a3[0]) != 1) { ret 1; }

    var a4: [3]*u8;
    a4[0] = "mach";
    a4[1] = "clean";
    a4[2] = "/nonexistent-mach-clean-target";
    if (dispatch(3, ?a4[0]) != 1) { ret 1; }

    var a5: [4]*u8;
    a5[0] = "mach";
    a5[1] = "info";
    a5[2] = "targets";
    a5[3] = "extra";
    if (dispatch(4, ?a5[0]) != 1) { ret 1; }

    var a6: [4]*u8;
    a6[0] = "mach";
    a6[1] = "info";
    a6[2] = "--version";
    a6[3] = "targets";
    if (dispatch(4, ?a6[0]) != 1) { ret 1; }

    ret 0;
}

test "mach.cli.cmd.dispatch:help_routes_never_reach_the_product_handlers" {
    var a0: [2]*u8;
    a0[0] = "mach";
    a0[1] = "-h";
    if (dispatch(2, ?a0[0]) != 0) { ret 1; }

    var a1: [2]*u8;
    a1[0] = "mach";
    a1[1] = "--help";
    if (dispatch(2, ?a1[0]) != 0) { ret 1; }

    var a2: [2]*u8;
    a2[0] = "mach";
    a2[1] = "help";
    if (dispatch(2, ?a2[0]) != 0) { ret 1; }

    var a3: [3]*u8;
    a3[0] = "mach";
    a3[1] = "help";
    a3[2] = "build";
    if (dispatch(3, ?a3[0]) != 0) { ret 1; }

    var a4: [3]*u8;
    a4[0] = "mach";
    a4[1] = "build";
    a4[2] = "-h";
    if (dispatch(3, ?a4[0]) != 0) { ret 1; }

    var a5: [3]*u8;
    a5[0] = "mach";
    a5[1] = "help";
    a5[2] = "bogus";
    if (dispatch(3, ?a5[0]) != 1) { ret 1; }

    var a6: [4]*u8;
    a6[0] = "mach";
    a6[1] = "build";
    a6[2] = "-h";
    a6[3] = "extra";
    if (dispatch(4, ?a6[0]) != 1) { ret 1; }

    ret 0;
}

fun census_join(alloc: *A.Allocator, dir: str, name: str) res[str, outcome.Fail] {
    val dl: usize             = str_len(dir);
    val nl: usize             = str_len(name);
    val rb: res[*u8, A.Error] = A.allocate[u8](alloc, dl + nl + 2);
    if (sel rb.err) { ret res[str, outcome.Fail].err{outcome.user("out of memory joining a path")}; }
    val buf: *u8 = rb.ok;

    var i: usize = 0;
    for (i < dl) {
        buf[i] = dir[i]::u8;
        i      = i + 1;
    }
    buf[dl] = '/'::u8;
    var j: usize = 0;
    for (j < nl) {
        buf[dl + 1 + j] = name[j]::u8;
        j               = j + 1;
    }
    buf[dl + 1 + nl] = 0;
    ret res[str, outcome.Fail].ok{buf::str};
}

fun census_find_root(alloc: *A.Allocator) opt[str] {
    var prefix: str   = ".";
    var depth:  usize = 0;
    for (depth < 8) {
        val rj: res[str, outcome.Fail] = census_join(alloc, prefix, "src/cli/args.mach");
        if (sel rj.err) { ret opt[str].none{}; }
        val is_file_r: res[bool, io_error.Error] = filesystem.is_file(rj.ok);
        if ((sel is_file_r.ok && is_file_r.ok)) { ret opt[str].some{prefix}; }

        val ru: res[str, outcome.Fail] = census_join(alloc, prefix, "..");
        if (sel ru.err) { ret opt[str].none{}; }
        prefix = ru.ok;
        depth  = depth + 1;
    }
    ret opt[str].none{};
}

val CENSUS_BANNED_N: usize                = 4;
val CENSUS_BANNED:   [CENSUS_BANNED_N]str = [CENSUS_BANNED_N]str{
    "args.collect_build(",
    "util.arg_index_positional(",
    "util.flag_reject_unknown(",
    "LegacyCommandPayload",
};

val CENSUS_FILE_N: usize              = 4;
val CENSUS_FILES:  [CENSUS_FILE_N]str = [CENSUS_FILE_N]str{
    "src/cli/cmd/build.mach",
    "src/cli/cmd/testing.mach",
    "src/cli/cmd/init.mach",
    "src/cli/args.mach",
};

val CENSUS_FILE_BANNED_START: [CENSUS_FILE_N]usize = [CENSUS_FILE_N]usize{0, 0, 0, 5};

test "mach.cli.cmd.dispatch:census_typed_commands_never_reparse_argv_after_the_single_pass" {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 2; }

    val root_o: opt[str] = census_find_root(?a);
    if (sel root_o.none) {
        print.eprintln("census: cannot locate the source root from the working directory");
        ret 2;
    }
    val root: str = root_o.some;

    var fi: usize = 0;
    for (fi < CENSUS_FILE_N) {
        val fp_r: res[str, outcome.Fail] = census_join(?a, root, CENSUS_FILES[fi]);
        if (sel fp_r.err) { ret 2; }
        val fp: str = fp_r.ok;

        val rb: res[Vector[u8], filesystem.FsError] = filesystem.read_bytes(?a, fp);
        if (sel rb.err) {
            print.eprintlnf("census: cannot read {}", fp);
            ret 2;
        }
        var bytes:  Vector[u8]                = rb.ok;
        val text_r: res[str, string.StrError] = str_copy_slice(?a, bytes.data::str, 0, bytes.len);
        vector.dnit[u8](?bytes);
        if (sel text_r.err) { ret 2; }
        val text: str = text_r.ok;

        var bi: usize = CENSUS_FILE_BANNED_START[fi];
        for (bi < CENSUS_BANNED_N) {
            if (str_contains(text, CENSUS_BANNED[bi])) {
                print.eprintlnf("census: {} still contains banned pattern '{}'", CENSUS_FILES[fi], CENSUS_BANNED[bi]);
                ret 1;
            }
            bi = bi + 1;
        }
        fi = fi + 1;
    }
    ret 0;
}
