use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.fail;
use std.allocator.heap;
use std_args:   std.args;
use std_format: std.format;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;

use mach.cli.args;
use mach.cli.cmd.build;
use mach.cli.cmd.clean;
use cmd_dep: mach.cli.cmd.dep;
use cmd_doc: mach.cli.cmd.doc;
use mach.cli.cmd.fmt;
use mach.cli.cmd.help;
use mach.cli.cmd.info;
use mach.cli.cmd.init;
use mach.cli.cmd.migrate;
use mach.cli.cmd.run;
use cmd_testing:    mach.cli.cmd.testing;
use cli_diagnostic: mach.cli.diagnostic;
use mach.cli.exit;
use lang_version: mach.lang.version;

# one command and what runs it
# ---
# spec: the command, as its own file declares it
# run:  the handler the command's invocations run. its ok is the process exit code, and its err
#       the failure the run reports in the code `exit.of` maps it to
rec Registered {
    spec: *std_args.CommandSpec;
    run:  fun(*args.Call) res[i64, fail.Fail];
}

# length of COMMANDS; the compiler refuses a COMMANDS literal of any other length
val COMMANDS_N: usize = 12;
# every command, in the order help lists them. a command is its own file's std_args.CommandSpec
# and its row here; nothing else registers it
val COMMANDS: [COMMANDS_N]Registered = [COMMANDS_N]Registered{
    Registered{spec: ?build.COMMAND, run: build.run},
    Registered{spec: ?build.CHECK, run: build.check},
    Registered{spec: ?run.COMMAND, run: run.run},
    Registered{spec: ?cmd_testing.COMMAND, run: cmd_testing.run},
    Registered{spec: ?fmt.COMMAND, run: fmt.run},
    Registered{spec: ?migrate.COMMAND, run: migrate.run},
    Registered{spec: ?clean.COMMAND, run: clean.run},
    Registered{spec: ?cmd_dep.COMMAND, run: cmd_dep.run},
    Registered{spec: ?init.COMMAND, run: init.run},
    Registered{spec: ?cmd_doc.COMMAND, run: cmd_doc.run},
    Registered{spec: ?info.COMMAND, run: info.run},
    Registered{spec: ?help.COMMAND, run: help.run},
};

# length of GLOBALS
val GLOBALS_N: usize = 2;
# the options `mach` takes in place of a command word: `mach --help` is `mach help`, and
# `mach --version` is `mach info --version`
val GLOBALS: [GLOBALS_N]std_args.Global = [GLOBALS_N]std_args.Global{
    std_args.Global{row: ?args.HELP, command: ?help.COMMAND},
    std_args.Global{row: ?info.VERSION, command: ?info.COMMAND},
};

# what the overview ends with, after the commands: where the rest of the help is, and the programs
# a build runs through, each of which also stands alone
val FOOTER: str = "use 'mach help <command>' or 'mach <command> -h' for detailed usage. a build runs through three programs that also stand alone: mirl compiles each module's IR to machine code, masc encodes and lists that machine code, and mink links the objects into the artifact.";

# the handler that answers an invocation: the help command's for a page, otherwise its command's
fun handler_of(inv: *std_args.Invocation) fun(*args.Call) res[i64, fail.Fail] {
    if (std_args.help_requested(inv)) { ret help.run; }
    var i: usize = 0;
    for (i + 1 < COMMANDS_N && COMMANDS[i].spec != inv.command) { i = i + 1; }
    ret COMMANDS[i].run;
}

# the `mach` entry point: route the arguments to one command and return its exit code. with no
# arguments the overview prints and the code is 1; an unknown command is refused and the overview
# prints; otherwise args.run reports a refusal, renders the page `--help` asks for, or runs the
# command
# ---
# argc: process argument count
# argv: process arguments, argv[0] the program
# ret:  the exit code: exit.USER for a missing or unknown command, the code `exit.of` maps a
#       failure to set up or read the invocation to, otherwise the command's own code
pub fun dispatch(argc: usize, argv: **u8) i64 {
    var src: heap.Source;
    var h:   heap.Heap;
    heap.native_source(?src);
    val begun: err[A.Error] = heap.init(?h, ?src, 0);
    if (sel begun.err) { ret cli_diagnostic.refuse(fail.refused(begun.err)); }
    fin { val freed: err[A.Error] = heap.dnit(?h); }
    var backing: A.Allocator;
    val make_r:  err[A.Error] = heap.make(?backing, ?h);
    if (sel make_r.err) { ret cli_diagnostic.refuse(fail.refused(make_r.err)); }

    val title: res[str, std_format.FormatError] = std_format.sprint(?backing, "mach {} - the Mach compiler", lang_version.MACH_VERSION);
    if (sel title.err) { ret cli_diagnostic.refuse(fail.format_refused(title.err)); }
    var specs: [COMMANDS_N]*std_args.CommandSpec;
    var i:     usize = 0;
    for (i < COMMANDS_N) {
        specs[i] = COMMANDS[i].spec;
        i        = i + 1;
    }
    var set: std_args.CommandSet = std_args.CommandSet{
        program:    "mach",
        title:      title.ok,
        footer:     FOOTER,
        specs:      ?specs[0],
        n:          COMMANDS_N,
        help:       ?help.COMMAND,
        help_flag:  ?args.HELP,
        common:     ?args.HELP_TABLE,
        common_n:   1,
        relations:  ?args.RELATIONS[0],
        relation_n: args.RELATIONS_N,
        removed:    ?args.REMOVED[0],
        removed_n:  args.REMOVED_N,
        exits:      ?exit.SHARED[0],
        exit_n:     exit.SHARED_N,
        globals:    ?GLOBALS[0],
        global_n:   GLOBALS_N
    };

    var inv: std_args.Invocation = std_args.parse(?set, std_args.of(argc, argv), 1);
    if (inv.command != nil) { ret args.run(?backing, ?inv, handler_of(?inv)); }
    if (sel inv.refusal.some) {
        val refused: i64 = cli_diagnostic.refuse(args.refusal(?backing, ?inv));
        if (!(sel inv.refusal.some.unknown_command)) { ret refused; }
    }
    val shown: err[fail.Fail] = help.render(?backing, ?set, help.OVERVIEW);
    if (sel shown.err) { ret cli_diagnostic.refuse(shown.err); }
    ret exit.USER;
}
