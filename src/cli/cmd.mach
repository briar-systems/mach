use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.fail;
use std.allocator.heap;
use std_args: std.args;
use std.collections.slice.Slice;
use std_format: std.format;
use std.print;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;

use mach.cli.args;
use mach.cli.cmd.build;
use mach.cli.cmd.clean;
use cmd_dep: mach.cli.cmd.dep;
use cmd_doc: mach.cli.cmd.doc;
use mach.cli.cmd.fmt;
use mach.cli.cmd.help;
use mach.cli.cmd.info;
use mach.cli.cmd.init;
use mach.cli.cmd.migrate;
use mach.cli.cmd.run;
use cmd_testing:    mach.cli.cmd.testing;
use cli_diagnostic: mach.cli.diagnostic;
use mach.cli.exit;
use lang_version: mach.lang.version;

# one command and what runs it
# ---
# spec:   the command, as its own file declares it
# policy: what mach holds its line to beyond the parse, and what its page adds
# run:    the handler the command's invocations run. its ok is the process exit code, and its err
#         the failure the run reports in the code `exit.of` maps it to
rec Registered {
    spec:   *std_args.Command;
    policy: *args.Policy;
    run:    fun(*args.Call) res[i64, fail.Fail];
}

# length of COMMANDS
val COMMANDS_N: usize = 12;
# every command `mach` takes, in the order help lists them. a command is its own file's
# std_args.Command and policy and its row here; nothing else registers it
val COMMANDS: [COMMANDS_N]Registered = [COMMANDS_N]Registered{
    Registered{spec: ?build.COMMAND, policy: ?build.POLICY, run: build.run},
    Registered{spec: ?build.CHECK, policy: ?build.CHECK_POLICY, run: build.check},
    Registered{spec: ?run.COMMAND, policy: ?run.POLICY, run: run.run},
    Registered{spec: ?cmd_testing.COMMAND, policy: ?cmd_testing.POLICY, run: cmd_testing.run},
    Registered{spec: ?fmt.COMMAND, policy: ?fmt.POLICY, run: fmt.run},
    Registered{spec: ?migrate.COMMAND, policy: ?migrate.POLICY, run: migrate.run},
    Registered{spec: ?clean.COMMAND, policy: ?clean.POLICY, run: clean.run},
    Registered{spec: ?cmd_dep.COMMAND, policy: ?cmd_dep.POLICY, run: cmd_dep.run},
    Registered{spec: ?init.COMMAND, policy: ?init.POLICY, run: init.run},
    Registered{spec: ?cmd_doc.COMMAND, policy: ?cmd_doc.POLICY, run: cmd_doc.run},
    Registered{spec: ?info.COMMAND, policy: ?info.POLICY, run: info.run},
    Registered{spec: ?help.COMMAND, policy: ?help.POLICY, run: help_run},
};

# length of ACTIONS
val ACTIONS_N: usize = 7;
# the commands nested under another, each run by its parent's handler
val ACTIONS: [ACTIONS_N]Registered = [ACTIONS_N]Registered{
    Registered{spec: ?cmd_dep.LIST, policy: ?cmd_dep.POLICY, run: cmd_dep.run},
    Registered{spec: ?cmd_dep.ADD, policy: ?cmd_dep.ADD_POLICY, run: cmd_dep.run},
    Registered{spec: ?cmd_dep.REMOVE, policy: ?cmd_dep.POLICY, run: cmd_dep.run},
    Registered{spec: ?cmd_dep.UPDATE, policy: ?cmd_dep.UPDATE_POLICY, run: cmd_dep.run},
    Registered{spec: ?cmd_dep.PULL, policy: ?cmd_dep.POLICY, run: cmd_dep.run},
    Registered{spec: ?cmd_dep.OUTDATED, policy: ?cmd_dep.POLICY, run: cmd_dep.run},
    Registered{spec: ?cmd_dep.VERIFY, policy: ?cmd_dep.VERIFY_POLICY, run: cmd_dep.run},
};

# the commands `mach` takes, as the root lists them
val SPECS: [COMMANDS_N]*std_args.Command = [COMMANDS_N]*std_args.Command{
    ?build.COMMAND, ?build.CHECK, ?run.COMMAND, ?cmd_testing.COMMAND, ?fmt.COMMAND, ?migrate.COMMAND,
    ?clean.COMMAND, ?cmd_dep.COMMAND, ?init.COMMAND, ?cmd_doc.COMMAND, ?info.COMMAND, ?help.COMMAND,
};

# length of ROOT_FLAGS
val ROOT_FLAGS_N: usize = 3;
# the options `mach` takes in place of a command word: `mach --help` is `mach help`, and
# `mach --version` prints the version alone
val ROOT_FLAGS: [ROOT_FLAGS_N]*std_args.Flag = [ROOT_FLAGS_N]*std_args.Flag{?args.HELP, ?args.VERSION, ?args.DIAGNOSTICS};

# `mach`, the root every command is nested under
val ROOT: std_args.Command = std_args.Command{name: "mach", aliases: args.NO_WORDS, help: "the Mach compiler", usage: "", flags: Slice[*std_args.Flag]{data: ?ROOT_FLAGS[0], size: ROOT_FLAGS_N}, commands: Slice[*std_args.Command]{data: ?SPECS[0], size: COMMANDS_N}, operand_min: 0, operand_max: 0, passthrough: false};

# the root's own policy, for a refusal read against it
val ROOT_POLICY: args.Policy = args.Policy{constraints: args.NO_WORDS, refused: args.NO_FLAGS, refusal: "", conflicts: args.NO_CONFLICTS};

# the registration of a command, nil for the root
fun registered(c: *std_args.Command) *Registered {
    var i: usize = 0;
    for (i < COMMANDS_N) {
        if (COMMANDS[i].spec == c) { ret ?COMMANDS[i]; }
        i = i + 1;
    }
    i = 0;
    for (i < ACTIONS_N) {
        if (ACTIONS[i].spec == c) { ret ?ACTIONS[i]; }
        i = i + 1;
    }
    ret nil;
}

# the overview: the root's page
fun overview() err[fail.Fail] {
    var words: [2]*u8          = [2]*u8{"mach", nil};
    var line:  std_args.Parsed = std_args.parse(?ROOT, std_args.of(1, ?words[0]));
    ret help.page(?line, ?ROOT_POLICY);
}

# the page of the command a parsed line matched, the overview for the root and for `mach help`
fun page_of(line: *std_args.Parsed) err[fail.Fail] {
    val reg: *Registered = registered(line.command);
    if (reg == nil || line.command == ?help.COMMAND) { ret overview(); }
    ret help.page(line, reg.policy);
}

# `mach help [command [action]]`: the overview with no operand, otherwise the page of the command,
# or of its action, the words name
fun help_run(cx: *args.Call) res[i64, fail.Fail] {
    if (cx.inv.command != ?help.COMMAND) {
        val shown: err[fail.Fail] = page_of(cx.inv);
        if (sel shown.err) { ret res[i64, fail.Fail].err{shown.err}; }
        ret res[i64, fail.Fail].ok{exit.OK};
    }
    var words: [4]*u8;
    words[0] = "mach";
    var n: usize = 1;
    for (n < 3) {
        val w: *u8 = args.operand(cx.inv, n - 1);
        if (w == nil) { brk; }
        words[n] = w;
        n        = n + 1;
    }
    words[n] = nil;
    if (n == 1) {
        val shown: err[fail.Fail] = overview();
        if (sel shown.err) { ret res[i64, fail.Fail].err{shown.err}; }
        ret res[i64, fail.Fail].ok{exit.OK};
    }
    var line: std_args.Parsed = std_args.parse(?ROOT, std_args.of(n, ?words[0]));
    if (sel line.refusal.some) {
        if (sel line.refusal.some.unknown_command) { ret res[i64, fail.Fail].err{args.refusal(cx.a, ?line, ?ROOT_POLICY)}; }
    }
    if (line.depth + 1 != n) {
        val said: res[str, std_format.FormatError] = std_format.sprint(cx.a, "'{}' takes no action", words[1]);
        if (sel said.err) { ret res[i64, fail.Fail].err{fail.format_refused(said.err)}; }
        ret res[i64, fail.Fail].err{fail.user(diagnostic_kind.CLI_OPERAND, said.ok)};
    }
    val shown: err[fail.Fail] = page_of(?line);
    if (sel shown.err) { ret res[i64, fail.Fail].err{shown.err}; }
    ret res[i64, fail.Fail].ok{exit.OK};
}

# the `mach` entry point: route the arguments to one command and return its exit code. `--help`
# renders the page of the command it follows in place of running it, whatever else the line is
# refused for but an unknown command, and `--version` before a command prints the version alone.
# with no command the overview prints and the code is 1, and an unknown command is refused with
# the overview after it; otherwise args.run reports a refusal or a refused combination, or runs
# the command
# ---
# argc: process argument count
# argv: process arguments, argv[0] the program
# ret:  the exit code: exit.USER for a missing or unknown command, the code `exit.of` maps a
#       failure to set up or read the line to, otherwise the command's own code
pub fun dispatch(argc: usize, argv: **u8) i64 {
    var src: heap.Source;
    var h:   heap.Heap;
    heap.native_source(?src);
    val begun: err[A.Error] = heap.init(?h, ?src, 0);
    if (sel begun.err) { ret cli_diagnostic.refuse(fail.refused(begun.err)); }
    fin { val freed: err[A.Error] = heap.dnit(?h); }
    var backing: A.Allocator;
    val make_r:  err[A.Error] = heap.make(?backing, ?h);
    if (sel make_r.err) { ret cli_diagnostic.refuse(fail.refused(make_r.err)); }

    var line:    std_args.Parsed = std_args.parse(?ROOT, std_args.of(argc, argv));
    var unknown: bool            = false;
    if (sel line.refusal.some) { unknown = sel line.refusal.some.unknown_command; }
    val reg: *Registered = registered(line.command);

    if (std_args.given(?line, ?args.HELP) && !unknown) { ret args.serve(?line, help_run); }
    if (reg != nil)                                    { ret args.run(?backing, ?line, reg.policy, reg.run); }

    if (sel line.refusal.some) {
        val refused: i64 = cli_diagnostic.refuse(args.refusal(?backing, ?line, ?ROOT_POLICY));
        if (!unknown) { ret refused; }
    }
    or (std_args.given(?line, ?args.VERSION)) {
        print.println(lang_version.MACH_VERSION);
        ret exit.OK;
    }
    val shown: err[fail.Fail] = overview();
    if (sel shown.err) { ret cli_diagnostic.refuse(shown.err); }
    ret exit.USER;
}
