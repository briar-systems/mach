use mach.lang.build.outcome;
use std.allocator.page;
use std.filesystem;
use std.io.writer;
use std.print;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;

use mach.cli.args;
use mach.cli.cmd.build;
use mach.cli.cmd.clean;
use mach.cli.cmd.dep;
use mach.cli.cmd.doc;
use mach.cli.cmd.fmt;
use mach.cli.cmd.help;
use mach.cli.cmd.info;
use mach.cli.cmd.init;
use mach.cli.cmd.run;
use mach.cli.cmd.testing;

fun render_help(route: *help.HelpRoute) i64 {
    var backing: A.Allocator;
    val make_r:  err[A.Error] = page.make(?backing);
    if (sel make_r.err) {
        print.eprint("error: failed to initialise allocator\n");
        ret 2;
    }
    var out:   writer.Writer = filesystem.writer(filesystem.STDOUT);
    var fault: writer.Writer = filesystem.writer(filesystem.STDERR);
    ret help.render_route(?backing, ?out, ?fault, route);
}

fun render_overview(a: *A.Allocator) i64 {
    var out:               writer.Writer     = filesystem.writer(filesystem.STDOUT);
    val render_overview_r: err[outcome.Fail] = help.render_overview(a, ?out);
    if (sel render_overview_r.err) { ret 2; }
    ret 0;
}

# the `mach` entry point: route argv to one command and return its exit code
# help requests are rendered first; with no arguments the overview prints and the code is 1;
# an unknown command prints an error and the overview
# ---
# argc: process argument count
# argv: process arguments, argv[0] the program
# ret:  the exit code: 0 success, 1 usage or user error, 2 when the allocator or the
#       invocation could not be set up, otherwise the command's own code
pub fun dispatch(argc: usize, argv: **u8) i64 {
    val route: help.HelpRoute = help.resolve_help_route(argc, argv);
    if (route.kind != help.HELP_ROUTE_NONE) { ret render_help(?route); }

    if (argc < 2) {
        var noarg_alloc: A.Allocator;
        val make_r:      err[A.Error] = page.make(?noarg_alloc);
        if (sel make_r.err)                     { ret 2; }
        if (render_overview(?noarg_alloc) == 2) { ret 2; }
        ret 1;
    }

    var backing: A.Allocator;
    val make_r2: err[A.Error] = page.make(?backing);
    if (sel make_r2.err) {
        print.eprint("error: failed to initialise allocator\n");
        ret 2;
    }
    val ir: res[args.ParsedInvocation, outcome.Fail] = args.parse_invocation(?backing, argc, argv);
    if (sel ir.err) {
        print.eprint("error: failed to initialise allocator\n");
        ret 2;
    }
    var inv: args.ParsedInvocation = ir.ok;

    if (!inv.has_command) {
        val command: str = argv[1]::str;
        print.eprint("error: unknown command '");
        print.eprint(command);
        print.eprint("'\n");
        if (render_overview(?backing) == 2) {
            args.dnit_invocation(?backing, ?inv);
            ret 2;
        }
        args.dnit_invocation(?backing, ?inv);
        ret 1;
    }

    var rc: i64 = 97;
    if (inv.command == args.CMD_INFO)  { rc = info.run(argv, ?inv); }
    or (inv.command == args.CMD_CLEAN) { rc = clean.run(argv, ?inv); }
    or (inv.command == args.CMD_BUILD) { rc = build.run(argv, ?inv); }
    or (inv.command == args.CMD_CHECK) { rc = build.check(argv, ?inv); }
    or (inv.command == args.CMD_RUN)   { rc = run.run(argv, ?inv); }
    or (inv.command == args.CMD_TEST)  { rc = testing.run(argv, ?inv); }
    or (inv.command == args.CMD_DEP)   { rc = dep.run(argv, ?inv); }
    or (inv.command == args.CMD_INIT)  { rc = init.run(argv, ?inv); }
    or (inv.command == args.CMD_DOC)   { rc = doc.run(argv, ?inv); }
    or (inv.command == args.CMD_FMT)   { rc = fmt.run(argv, ?inv); }

    args.dnit_invocation(?backing, ?inv);
    ret rc;
}

test dispatch__an_unknown_or_missing_command_shows_usage_and_fails {
    var a0: [2]*u8 = [2]*u8{"mach", "bogus"};
    if (dispatch(2, ?a0[0]) != 1) { ret 1; }
    if (dispatch(1, ?a0[0]) != 1) { ret 2; }
    ret 0;
}

test dispatch__typed_info_and_clean_route_through_the_single_parse {
    var a0: [3]*u8;
    a0[0] = "mach";
    a0[1] = "info";
    a0[2] = "--version";
    if (dispatch(3, ?a0[0]) != 0) { ret 1; }

    var a1: [3]*u8;
    a1[0] = "mach";
    a1[1] = "info";
    a1[2] = "targets";
    if (dispatch(3, ?a1[0]) != 0) { ret 1; }

    var a2: [3]*u8;
    a2[0] = "mach";
    a2[1] = "info";
    a2[2] = "--bogus";
    if (dispatch(3, ?a2[0]) != 1) { ret 1; }

    var a3: [3]*u8;
    a3[0] = "mach";
    a3[1] = "clean";
    a3[2] = "--bogus";
    if (dispatch(3, ?a3[0]) != 1) { ret 1; }

    var a4: [3]*u8;
    a4[0] = "mach";
    a4[1] = "clean";
    a4[2] = "/nonexistent-mach-clean-target";
    if (dispatch(3, ?a4[0]) != 1) { ret 1; }

    var a5: [4]*u8;
    a5[0] = "mach";
    a5[1] = "info";
    a5[2] = "targets";
    a5[3] = "extra";
    if (dispatch(4, ?a5[0]) != 1) { ret 1; }

    var a6: [4]*u8;
    a6[0] = "mach";
    a6[1] = "info";
    a6[2] = "--version";
    a6[3] = "targets";
    if (dispatch(4, ?a6[0]) != 1) { ret 1; }

    ret 0;
}

test dispatch__help_routes_never_reach_the_product_handlers {
    var a0: [2]*u8;
    a0[0] = "mach";
    a0[1] = "-h";
    if (dispatch(2, ?a0[0]) != 0) { ret 1; }

    var a1: [2]*u8;
    a1[0] = "mach";
    a1[1] = "--help";
    if (dispatch(2, ?a1[0]) != 0) { ret 1; }

    var a2: [2]*u8;
    a2[0] = "mach";
    a2[1] = "help";
    if (dispatch(2, ?a2[0]) != 0) { ret 1; }

    var a3: [3]*u8;
    a3[0] = "mach";
    a3[1] = "help";
    a3[2] = "build";
    if (dispatch(3, ?a3[0]) != 0) { ret 1; }

    var a4: [3]*u8;
    a4[0] = "mach";
    a4[1] = "build";
    a4[2] = "-h";
    if (dispatch(3, ?a4[0]) != 0) { ret 1; }

    var a5: [3]*u8;
    a5[0] = "mach";
    a5[1] = "help";
    a5[2] = "bogus";
    if (dispatch(3, ?a5[0]) != 1) { ret 1; }

    var a6: [4]*u8;
    a6[0] = "mach";
    a6[1] = "build";
    a6[2] = "-h";
    a6[3] = "extra";
    if (dispatch(4, ?a6[0]) != 1) { ret 1; }

    ret 0;
}
