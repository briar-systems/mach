    FlagSpec{ name: "--pie",         value: "", doc: "emit a position-independent ET_DYN executable", default: "", repeatable: false, conflicts: "", implies: "", alias_of: "" },
    FlagSpec{ name: "--subsystem",   value: "console|gui", doc: "set the environment declared by a Windows executable", default: "artifact subsystem key; inert off Windows", repeatable: false, conflicts: "", implies: "", alias_of: "" },
    FlagSpec{ name: "-g",            value: "", doc: "emit debug information for this build", default: "profile debug key", repeatable: false, conflicts: "", implies: "", alias_of: "" },
    FlagSpec{ name: "--emit-asm",    value: "", doc: "emit per-module .s assembly beside each object", default: "", repeatable: false, conflicts: "", implies: "", alias_of: "" },
    FlagSpec{ name: "--emit-ir",     value: "", doc: "emit per-module .ir SSA text beside each object", default: "", repeatable: false, conflicts: "", implies: "", alias_of: "" },
};

