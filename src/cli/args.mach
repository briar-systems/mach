# the typed options of a build-shaped command: what it reports and selects, and
# what it sets over the profile it builds
# ---
# verbosity: 0, 1 or 2 from `-v` and `-vv`
# quiet:     `--quiet`
# selectors: the `-a`, `-t` and `-p` patterns and `--all`
# overrides: everything else the command sets, typed
# settings:  every `--set`, in argv order
# emits:     the EMIT_KIND_* bits `--emit` names, 0 when it is absent
# entry:     what the command line states of an entry build
pub rec CliArgs {
    verbosity: u8;
    quiet:     bool;
    selectors: manifest.Selectors;
    overrides: request.Overrides;
    settings:  Vector[manifest.Assignment];
    emits:     u8;
    entry:     EntryArgs;
}

# what an entry build's command line states: its entry, source roots, artifact kind, target
# narrowing and the levers its profile takes
# ---
# file:      the entry operand, nil for a project build
# sources:   every `--source` value, `name=dir` as written
# kind:      the `--kind` value, nil when absent
# target:    the `-t` value, the target as `<sys>-<arch>`, nil when absent
# narrowing: the narrowing flags, each as written
# exts:      every `--ext` value, in argv order
# optimize:  the profile an entry build states optimizes
# debug:     the profile an entry build states emits debug information
pub rec EntryArgs {
    file:      str;
    sources:   Vector[str];
    kind:      str;
    target:    str;
    narrowing: driver_entry.Narrowing;
    exts:      Vector[str];
    optimize:  bool;
    debug:     bool;
}

# whether the command line states anything only an entry build takes
# ---
# e:   the entry arguments
# ret: true when a source root, a kind or a narrowing flag is given
pub fun entry_stated(e: *EntryArgs) bool {
    ret e.sources.len > 0 || e.kind != nil || driver_entry.narrowed(?e.narrowing);
}

# one product `--emit` names
# ---
# name: the value `--emit` takes
# bit:  its bit in an emit set
# doc:  what naming it writes, for help
rec EmitKind {
    name: str;
    bit:  u8;
    doc:  str;
}

# masc's listing of each module, beside its object
pub val EMIT_KIND_ASM: u8 = 1;
# mirl's text of each module, beside its object
pub val EMIT_KIND_IR: u8 = 2;
# the objects, with no link
pub val EMIT_KIND_OBJ: u8 = 4;
# the linked artifact
pub val EMIT_KIND_EXE: u8 = 8;

val EMIT_KINDS_N: usize                  = 4;
val EMIT_KINDS:   [EMIT_KINDS_N]EmitKind = [EMIT_KINDS_N]EmitKind{
    EmitKind{name: "asm", bit: EMIT_KIND_ASM, doc: "masc's listing of each module"},
    EmitKind{name: "ir", bit: EMIT_KIND_IR, doc: "mirl's text of each module"},
    EmitKind{name: "obj", bit: EMIT_KIND_OBJ, doc: "the objects, stopping before the link"},
    EmitKind{name: "exe", bit: EMIT_KIND_EXE, doc: "the linked artifact"},
};

# `--emit`'s help text
val EMIT_HELP: str = "write a product of the build, once per --emit: asm for masc's listing and ir for mirl's text of each module, beside its object; obj for the objects alone; exe for the linked artifact, the default when neither obj nor exe is named";

# the refusal of an `--emit` value no product is named by
pub val EMIT_ERROR: str = "--emit expects asm, ir, obj or exe";

# the bit of the product `name` names, 0 for none
fun emit_bit(name: str) u8 {
    var i: usize = 0;
    for (i < EMIT_KINDS_N) {
        if (str_equals(EMIT_KINDS[i].name, name)) { ret EMIT_KINDS[i].bit; }
        i = i + 1;
    }
    ret 0;
}

# `--artifact <pattern>`, `-a`, a selector
pub val ARTIFACT: std_args.Flag = std_args.Flag{long: "artifact", short: 'a', value: "pattern", repeat: true, negatable: false, help: "select [artifact.<name>] entries by name or glob (default: the default selection)"};
# `--target <pattern>`, `-t`, a selector, or an entry build's target
pub val TARGET: std_args.Flag = std_args.Flag{long: "target", short: 't', value: "pattern", repeat: true, negatable: false, help: "select [target.<name>] entries by name or glob, or name an entry build's target as <sys>-<arch> (default: the native target, or the host's for an entry build)"};
# `--profile <pattern>`, `-p`, a selector
pub val PROFILE: std_args.Flag = std_args.Flag{long: "profile", short: 'p', value: "pattern", repeat: true, negatable: false, help: "select [profile.<name>] entries by name or glob (default: the sole or default profile)"};
# `--all`, which fills every selector not given with `*`
pub val ALL: std_args.Flag = std_args.Flag{long: "all", short: 0, value: nil, repeat: false, negatable: false, help: "select every artifact, target and profile that no -a, -t or -p narrows"};
# `-o <path>`, the linked-binary path
pub val OUTPUT: std_args.Flag = std_args.Flag{long: nil, short: 'o', value: "path", repeat: false, negatable: false, help: "write the output to this path: the linked binary of build and test, the output directory of doc"};

# `-v`, once for each build phase's row and twice, as `-vv`, for each module or file as well; what
# each readout level shows is the readout contract, doc/language/readout.md
pub val VERBOSE: std_args.Flag = std_args.Flag{long: nil, short: 'v', value: nil, repeat: true, negatable: false, help: "show each build phase's row as the phase closes; -vv also shows each module or file a phase processed"};
# `--quiet`, `-q`
pub val QUIET: std_args.Flag = std_args.Flag{long: "quiet", short: 'q', value: nil, repeat: false, negatable: false, help: "suppress non-error output"};

# `--set <key=value>`, a manifest key over every table of its section
pub val SET: std_args.Flag = std_args.Flag{long: "set", short: 0, value: "key=value", repeat: true, negatable: false, help: "write the manifest key over every table of its section for this invocation, its value held to every rule the key keeps in mach.toml; it sets platform, base, stack_reserve and stack_commit over each target, and subsystem over each artifact"};
# `--verify`, mach's and mirl's verifiers over every lowered module
pub val VERIFY: std_args.Flag = std_args.Flag{long: "verify", short: 0, value: nil, repeat: false, negatable: false, help: "run the module and code generation verifiers (default: off)"};

# `--optimize`, `-O`, the profile's `optimize = true` for this invocation, and `--no-optimize`,
# its `optimize = false`
pub val OPTIMIZE: std_args.Flag = std_args.Flag{long: "optimize", short: 'O', value: nil, repeat: false, negatable: true, help: "run the optimization pass set, or with --no-optimize only the passes every build runs (default: the profile's optimize key)"};
# `--debug`, the profile's `debug = true` for this invocation, and `--no-debug`, its `debug = false`
pub val DEBUG: std_args.Flag = std_args.Flag{long: "debug", short: 0, value: nil, repeat: false, negatable: true, help: "emit debug information, or with --no-debug none (default: the profile's debug key)"};

# `--source <name=dir>`, a source root of an entry build
pub val SOURCE: std_args.Flag = std_args.Flag{long: "source", short: 0, value: "name=dir", repeat: true, negatable: false, help: "bind the module prefix name to the directory dir in a build of an entry file; the binding whose directory holds the entry names the entry's own package (default: the entry's directory, under the entry's stem)"};
# `--kind <kind>`, the kind of an entry build's artifact
pub val KIND: std_args.Flag = std_args.Flag{long: "kind", short: 0, value: "bin|static|shared", repeat: false, negatable: false, help: "set the kind of an entry build's artifact (default: bin)"};

# `--env <name>`
pub val ENV: std_args.Flag = std_args.Flag{long: "env", short: 0, value: "name", repeat: false, negatable: false, help: "narrow an entry build's target to an environment, by mink's name for it (default: the target's)"};
# `--abi <name>`
pub val ABI: std_args.Flag = std_args.Flag{long: "abi", short: 0, value: "name", repeat: false, negatable: false, help: "narrow an entry build's target to a calling convention, by mink's name for it (default: the target's)"};
# `--isa <selection>`
pub val ISA: std_args.Flag = std_args.Flag{long: "isa", short: 0, value: "selection", repeat: false, negatable: false, help: "narrow an entry build's target to the instruction set its code may use (default: the target's)"};
# `--ext <name>`
pub val EXT: std_args.Flag = std_args.Flag{long: "ext", short: 0, value: "name", repeat: true, negatable: false, help: "add an extension to an entry build's instruction set, once per extension"};
# `--code-model <name>`
pub val CODE_MODEL: std_args.Flag = std_args.Flag{long: "code-model", short: 0, value: "name", repeat: false, negatable: false, help: "narrow an entry build's target to a code model, by its psABI name (default: the target's)"};

# `-w <path>`, the work directory
pub val WORK: std_args.Flag = std_args.Flag{long: nil, short: 'w', value: "path", repeat: false, negatable: false, help: "set the work directory, which [project].work names"};

# `--emit <kind>`, once per product
pub val EMIT: std_args.Flag = std_args.Flag{long: "emit", short: 0, value: "asm|ir|obj|exe", repeat: true, negatable: false, help: EMIT_HELP};

# `--threads <n>`
pub val THREADS: std_args.Flag = std_args.Flag{long: "threads", short: 0, value: "n", repeat: false, negatable: false, help: "set codegen worker threads, and for a test run its concurrent test processes; 1 serialises (default: host CPUs)"};

# `-L <dir>`
pub val LIB_DIR: std_args.Flag = std_args.Flag{long: nil, short: 'L', value: "dir", repeat: true, negatable: false, help: "add a search directory for -l inputs"};
# `-l <name>`
pub val LIB: std_args.Flag = std_args.Flag{long: nil, short: 'l', value: "name", repeat: true, negatable: false, help: "link a named object, archive, or shared library"};

# `--no-cache`. a build reads `obj/` as the object cache by default: a module whose object there
# carries the build's key is reused instead of lowered and generated
pub val NO_CACHE: std_args.Flag = std_args.Flag{long: "no-cache", short: 0, value: nil, repeat: false, negatable: false, help: "force an uncached build: no obj/ reuse and no build-step reuse"};

# `--diagnostics <human|json>`: how diagnostics, failures and a test run's results reach stderr
pub val DIAGNOSTICS: std_args.Flag = std_args.Flag{long: "diagnostics", short: 0, value: "human|json", repeat: false, negatable: false, help: "write diagnostics to stderr as human text or as NDJSON records (default: human)"};

# `--plan`
pub val PLAN: std_args.Flag = std_args.Flag{long: "plan", short: 0, value: nil, repeat: false, negatable: false, help: "print the effective build plan and exit without building"};

# `--help`, `-h`: the invocation asks for its command's page instead of running it, which takes
# precedence over every refusal but an unknown command
pub val HELP: std_args.Flag = std_args.Flag{long: "help", short: 'h', value: nil, repeat: false, negatable: false, help: "show the overview, or a command's page in place of running it"};
# `--version`, the compiler's version alone on one line
pub val VERSION: std_args.Flag = std_args.Flag{long: "version", short: 0, value: nil, repeat: false, negatable: false, help: "print the version alone on one line"};

# `--runner <cmd>`
pub val RUNNER: std_args.Flag = std_args.Flag{long: "runner", short: 0, value: "cmd", repeat: false, negatable: false, help: "execute through a command name or path resolved on PATH, in place of the target's runner (default: the target's runner, else direct execution)"};
# `--timeout <duration>`
pub val TIMEOUT: std_args.Flag = std_args.Flag{long: "timeout", short: 0, value: "duration", repeat: false, negatable: false, help: "terminate a run, or each test process, and its process group after the duration: 30ms, 30s, 5m, 1h (default: unbounded)"};
# `--allow-unrunnable`
pub val ALLOW_UNRUNNABLE: std_args.Flag = std_args.Flag{long: "allow-unrunnable", short: 0, value: nil, repeat: false, negatable: false, help: "exit 0 when nothing selected can run on this host, after building it"};
# `--offline`
pub val OFFLINE: std_args.Flag = std_args.Flag{long: "offline", short: 0, value: nil, repeat: false, negatable: false, help: "resolve from releases already fetched"};

# a spelling an earlier version took, refused by name with what replaced it
# ---
# name: the spelling, `--name` or `-c`
# use:  what to write instead
pub rec Removed {
    name: str;
    use:  str;
}

# row count of REMOVED
pub val REMOVED_N: usize = 20;
# the options a previous major took, each refused by name with what to write instead
pub val REMOVED: [REMOVED_N]Removed = [REMOVED_N]Removed{
    Removed{name: "-g", use: "--debug"},
    Removed{name: "-d", use: "--debug"},
    Removed{name: "-s", use: "--source"},
    Removed{name: "-k", use: "--kind"},
    Removed{name: "-e", use: "--emit"},
    Removed{name: "-O0", use: "--no-optimize"},
    Removed{name: "-O2", use: "-O or --optimize"},
    Removed{name: "--emit-asm", use: "--emit asm"},
    Removed{name: "--emit-ir", use: "--emit ir"},
    Removed{name: "--jobs", use: "--threads"},
    Removed{name: "--pie", use: "the target's system, which sets the executable kind a build links, and so position independence"},
    Removed{name: "--simd", use: "no option in its place: mirl legalizes every vector operation, so a build has no vector mode to choose"},
    Removed{name: "--arch", use: "-t <sys>-<arch>"},
    Removed{name: "--sys", use: "-t <sys>-<arch>"},
    Removed{name: "--of", use: "the target's system, which implies the object format"},
    Removed{name: "--platform", use: "--set platform=<name>"},
    Removed{name: "--subsystem", use: "--set subsystem=<name>"},
    Removed{name: "--base", use: "--set base=<address>"},
    Removed{name: "--stack-reserve", use: "--set stack_reserve=<bytes>"},
    Removed{name: "--stack-commit", use: "--set stack_commit=<bytes>"},
};

# two flags a command refuses together
pub rec Conflict {
    flag:  *std_args.Flag;
    other: *std_args.Flag;
}

# what mach holds a command's line to beyond what std.args parses, and what its page adds
# ---
# summary:     the command's one line in the overview
# exits:       its own exit codes, beside the shared ones
# constraints: the rules its page prints after its options
# refused:     flags it recognizes only to refuse, by refusal
# refusal:     why it refuses them
# conflicts:   pairs of its flags it refuses together
pub rec Policy {
    summary:     str;
    exits:       Slice[exit.Exit];
    constraints: Slice[str];
    refused:     Slice[*std_args.Flag];
    refusal:     str;
    conflicts:   Slice[Conflict];
}

# no words, for a command with no aliases or no constraints
pub val NO_WORDS: Slice[str] = Slice[str]{data: nil, size: 0};
# no commands, for a command nothing is nested under
pub val NO_COMMANDS: Slice[*std_args.Command] = Slice[*std_args.Command]{data: nil, size: 0};
# no flags
pub val NO_FLAGS: Slice[*std_args.Flag] = Slice[*std_args.Flag]{data: nil, size: 0};
# no exit codes of a command's own
pub val NO_EXITS: Slice[exit.Exit] = Slice[exit.Exit]{data: nil, size: 0};
# no conflicts of a command's own
pub val NO_CONFLICTS: Slice[Conflict] = Slice[Conflict]{data: nil, size: 0};

# length of CONFLICTS
val CONFLICTS_N: usize = 1;
# the pairs every command that takes both refuses together
val CONFLICTS: [CONFLICTS_N]Conflict = [CONFLICTS_N]Conflict{
    Conflict{flag: ?VERBOSE, other: ?QUIET},
};

# the rule every selector keeps, which the help of each command with selectors prints
pub val SELECTOR_CONSTRAINT: str = "-a, -t and -p take an exact name, which must be declared, or a glob with * and ?, which must match; an artifact pairs only with the targets its `targets` list supports";

# what dispatch hands a command's handler; dispatch owns every member and outlives the call
# ---
# a:       an arena dispatch releases once the handler returns, for what lives as long as the command
# backing: the heap under a, for what the command frees itself before it returns
# inv:     the parsed command line
# report:  where the command reports a failure it goes on past or that carries an origin, in the
#          format `--diagnostics` selected
# environ: the environment the command runs in, which the processes it starts inherit
pub rec Call {
    a:       *A.Allocator;
    backing: *A.Allocator;
    inv:     *std_args.Parsed;
    report:  *cli_diagnostic.Report;
    environ: exec.Environment;
}

# the operand at a position among a line's operands
# ---
# inv: the parsed line
# n:   the position, 0 the first
# ret: the operand, or nil when there are not that many
pub fun operand(inv: *std_args.Parsed, n: usize) *u8 {
    val o: opt[str] = std_args.operand(inv, n);
    if (sel o.some) { ret o.some; }
    ret nil;
}

# the value a flag was last given
# ---
# inv:  the parsed line
# flag: a flag that takes a value
# ret:  the value, or none when the flag did not occur or occurred without one
pub fun value(inv: *std_args.Parsed, flag: *std_args.Flag) opt[*u8] {
    val v: str = std_args.value(inv, flag);
    if (v != nil) { ret opt[*u8].some{v}; }
    ret opt[*u8].none{};
}

fun value_or_nil(inv: *std_args.Parsed, flag: *std_args.Flag) *u8 {
    ret std_args.value(inv, flag);
}

# every value a flag was given, in argument order
# ---
# a:    backs the vector
# inv:  the parsed line
# flag: the flag
# ret:  the values, empty for a flag the command does not take; err when the vector cannot grow
pub fun values(a: *A.Allocator, inv: *std_args.Parsed, flag: *std_args.Flag) res[Vector[str], fail.Fail] {
    var found: Vector[str]     = collections_vector.init[str](a);
    var w:     std_args.Values = std_args.values(inv, flag);
    for {
        val hit: opt[std_args.Hit] = std_args.next_value(?w);
        if (sel hit.none) { brk; }
        if (hit.some.value != nil) {
            val pushed: res[usize, A.Error] = collections_vector.push[str](?found, hit.some.value);
            if (sel pushed.err) { ret res[Vector[str], fail.Fail].err{fail.refused(pushed.err)}; }
        }
    }
    ret res[Vector[str], fail.Fail].ok{found};
}

# the diagnostics format `--diagnostics <human|json>` selects; human when it is absent
# ---
# inv: the parsed line
# ret: the format, or a user failure for any value but `human` and `json`
fun diagnostics_format(inv: *std_args.Parsed) res[cli_diagnostic.Format, fail.Fail] {
    if (!std_args.given(inv, ?DIAGNOSTICS)) { ret res[cli_diagnostic.Format, fail.Fail].ok{cli_diagnostic.FORMAT_HUMAN}; }
    val v: str = std_args.value(inv, ?DIAGNOSTICS);
    if (v != nil) {
        val named: opt[cli_diagnostic.Format] = cli_diagnostic.format_named(v);
        if (sel named.some) { ret res[cli_diagnostic.Format, fail.Fail].ok{named.some}; }
    }
    ret res[cli_diagnostic.Format, fail.Fail].err{fail.user(diagnostic_kind.CLI_FLAG_VALUE, "--diagnostics expects `human` or `json`")};
}

# how a flag is spelled in a refusal: its long spelling, else its short one
fun flag_name(a: *A.Allocator, f: *std_args.Flag) str {
    if (f.long != nil) {
        val said: res[str, fail.Fail] = fail.format(a, "--{}", f.long);
        if (sel said.ok) { ret said.ok; }
        ret f.long;
    }
    var one: [3]u8;
    one[0] = '-';
    one[1] = f.short;
    one[2] = 0;
    val said: res[str, A.Error] = str_dup_range(a, (?one[0])::str, 0, 2);
    if (sel said.ok) { ret said.ok; }
    ret "a flag";
}

# the option a refused token names: the whole token for a long option, the character for one in a
# short cluster, and the token up to any `=`
fun refused_name(a: *A.Allocator, r: std_args.Refused) str {
    if (r.at > 0) {
        val one: res[str, A.Error] = str_dup_range(a, r.tok, r.at - 1, r.at + 1);
        if (sel one.ok) {
            one.ok[0] = '-';
            ret one.ok;
        }
        ret r.tok;
    }
    val eq: opt[usize] = str_index_char(r.tok, '=');
    if (sel eq.some) {
        val cut: res[str, A.Error] = str_dup_range(a, r.tok, 0, eq.some);
        if (sel cut.ok) { ret cut.ok; }
    }
    ret r.tok;
}

# whether a flag answers to an option name, `--long`, `--no-long` or `-c`
fun spells(f: *std_args.Flag, name: str) bool {
    if (name[0] != '-') { ret false; }
    if (name[1] == '-') {
        if (f.long == nil)                       { ret false; }
        if (str_equals((?name[2])::str, f.long)) { ret true; }
        if (!f.negatable)                        { ret false; }
        ret str_starts_with(name, "--no-") && str_equals((?name[5])::str, f.long);
    }
    ret f.short != 0 && name[1] == f.short && name[2] == 0;
}

# an unknown option, refused by what mach knows of it: a removed spelling names what replaced it,
# and a flag the command recognizes only to refuse says why
fun unknown_option(a: *A.Allocator, policy: *Policy, command: str, r: std_args.Refused) opt[fail.Fail] {
    val whole: str   = refused_name(a, std_args.Refused{idx: r.idx, at: 0, tok: r.tok, depth: r.depth});
    val name:  str   = refused_name(a, r);
    var i:     usize = 0;
    for (i < REMOVED_N) {
        if (str_equals(REMOVED[i].name, whole) || str_equals(REMOVED[i].name, name)) {
            ret opt[fail.Fail].some{fail.formatted_user(a, diagnostic_kind.CLI_FLAG_REMOVED, "option '{}' was removed; use {}", REMOVED[i].name, REMOVED[i].use)};
        }
        i = i + 1;
    }
    i = 0;
    for (i < policy.refused.size) {
        if (spells(policy.refused.data[i], name)) {
            ret opt[fail.Fail].some{fail.formatted_user(a, diagnostic_kind.CLI_FLAG_INAPPLICABLE, "'{}' does not apply to {}: {}", name, command, policy.refusal)};
        }
        i = i + 1;
    }
    ret opt[fail.Fail].none{};
}

# a parsed line's refusal as a failure, in mach's words where mach knows more of the option than
# the parser and the parser's words otherwise
# ---
# a:      owns the text
# inv:    the parsed line, which holds a refusal
# policy: the matched command's policy
# ret:    a user failure of the refusal's kind
pub fun refusal(a: *A.Allocator, inv: *std_args.Parsed, policy: *Policy) fail.Fail {
    if (sel inv.refusal.none) { ret fail.message("a refusal was read from a line that holds none"); }
    val r: std_args.Refusal = inv.refusal.some;
    if (sel r.unknown_flag) {
        val known: opt[fail.Fail] = unknown_option(a, policy, inv.command.name, r.unknown_flag);
        if (sel known.some) { ret known.some; }
    }
    var text:  io_writer.Memory;
    var w:     io_writer.Writer          = io_writer.memory_growing(?text, a);
    val wrote: err[io_writer.WriteError] = std_args.describe(inv, ?w);
    if (sel wrote.err) { ret fail.environment(diagnostic_kind.OUTPUT_WRITE, fail.write_text(wrote.err)); }
    var kind: diagnostic_kind.Kind = diagnostic_kind.CLI_OPERAND;
    if (sel r.unknown_flag)    { kind = diagnostic_kind.CLI_FLAG_UNKNOWN; }
    if (sel r.missing_value)   { kind = diagnostic_kind.CLI_FLAG_VALUE; }
    if (sel r.unknown_command) { kind = diagnostic_kind.CLI_UNKNOWN_COMMAND; }
    ret fail.user(kind, io_writer.memory_text(?text));
}

# the flags the matched command takes that the line gives more than once though they do not
# repeat, and the pairs it refuses together, as a refusal
fun combination(a: *A.Allocator, inv: *std_args.Parsed, policy: *Policy) err[fail.Fail] {
    val flags: Slice[*std_args.Flag] = inv.command.flags;
    var i:     usize                 = 0;
    for (i < flags.size) {
        val f: *std_args.Flag = flags.data[i];
        i = i + 1;
        if (!f.repeat && std_args.occurrences(inv, f) > 1) {
            ret err[fail.Fail].err{fail.formatted_user(a, diagnostic_kind.CLI_FLAG_REPEATED, "'{}' is given more than once", flag_name(a, f))};
        }
    }
    i = 0;
    for (i < CONFLICTS_N + policy.conflicts.size) {
        var c: Conflict;
        if (i < CONFLICTS_N) { c = CONFLICTS[i]; }
        or                   { c = policy.conflicts.data[i - CONFLICTS_N]; }
        i = i + 1;
        if (std_args.given(inv, c.flag) && std_args.given(inv, c.other)) {
            ret err[fail.Fail].err{fail.formatted_user(a, diagnostic_kind.CLI_FLAG_CONFLICT, "'{}' and '{}' cannot be combined", flag_name(a, c.flag), flag_name(a, c.other))};
        }
    }
    ret err[fail.Fail].ok{};
}

# run a parsed line and report how it ended through one report, in the format `--diagnostics`
# selects, human when that format is itself malformed: its refusal when it holds one, then a flag
# combination the command refuses, otherwise the handler, given an arena this call owns. a
# failure the handler returns is reported here
# ---
# a:       owns the refusal's text
# inv:     the parsed line
# policy:  the matched command's policy
# handler: what runs
# ret:     the exit code
pub fun run(a: *A.Allocator, inv: *std_args.Parsed, policy: *Policy, handler: fun(*Call) res[i64, fail.Fail]) i64 {
    var r:      cli_diagnostic.Report;
    val chosen: err[fail.Fail] = open_report(inv, ?r);
    if (sel inv.refusal.some) { ret cli_diagnostic.report_close(?r, cli_diagnostic.report_fail(?r, refusal(a, inv, policy), diagnostic.ORIGIN_NONE)); }
    if (sel chosen.err)       { ret cli_diagnostic.report_close(?r, cli_diagnostic.report_fail(?r, chosen.err, diagnostic.ORIGIN_NONE)); }
    val combined: err[fail.Fail] = combination(a, inv, policy);
    if (sel combined.err) { ret cli_diagnostic.report_close(?r, cli_diagnostic.report_fail(?r, combined.err, diagnostic.ORIGIN_NONE)); }
    ret cli_diagnostic.report_close(?r, call(inv, ?r, handler));
}

# run a handler over a parsed line whatever it is refused for, reporting through one report in
# the format `--diagnostics` selects, as `--help` does in place of the command it follows
# ---
# inv:     the parsed line
# handler: what runs
# ret:     the exit code
pub fun serve(inv: *std_args.Parsed, handler: fun(*Call) res[i64, fail.Fail]) i64 {
    var r:      cli_diagnostic.Report;
    val chosen: err[fail.Fail] = open_report(inv, ?r);
    ret cli_diagnostic.report_close(?r, call(inv, ?r, handler));
}

# open `r` on stderr in the format the line's `--diagnostics` selects, human when it selects
# none or one mach does not write, which is the refusal returned
fun open_report(inv: *std_args.Parsed, r: *cli_diagnostic.Report) err[fail.Fail] {
    var format: cli_diagnostic.Format                 = cli_diagnostic.FORMAT_HUMAN;
    val chosen: res[cli_diagnostic.Format, fail.Fail] = diagnostics_format(inv);
    if (sel chosen.ok) { format = chosen.ok; }
    cli_diagnostic.report_init(r, format);
    r.w = fs.writer(fs.STDERR);
    if (sel chosen.err) { ret err[fail.Fail].err{chosen.err}; }
    ret err[fail.Fail].ok{};
}

fun call(inv: *std_args.Parsed, r: *cli_diagnostic.Report, handler: fun(*Call) res[i64, fail.Fail]) i64 {
    var src: heap.Source;
    var h:   heap.Heap;
    heap.native_source(?src);
    val begun: err[A.Error] = heap.init(?h, ?src, 0);
    if (sel begun.err) { ret cli_diagnostic.report_fail(r, fail.refused(begun.err), diagnostic.ORIGIN_NONE); }
    fin { val freed: err[A.Error] = heap.dnit(?h); }
    var backing: A.Allocator;
    val made:    err[A.Error] = heap.make(?backing, ?h);
    if (sel made.err) { ret cli_diagnostic.report_fail(r, fail.refused(made.err), diagnostic.ORIGIN_NONE); }
    var ar:     arena.Arena;
    val opened: err[A.Error] = arena.init(?ar, ?backing, 0);
    if (sel opened.err) { ret cli_diagnostic.report_fail(r, fail.refused(opened.err), diagnostic.ORIGIN_NONE); }
    fin { arena.dnit(?ar); }
    var a:     A.Allocator;
    val armed: err[A.Error] = arena.make(?a, ?ar);
    if (sel armed.err) { ret cli_diagnostic.report_fail(r, fail.refused(armed.err), diagnostic.ORIGIN_NONE); }
    var cx:  Call                = Call{a: ?a, backing: ?backing, inv: inv, report: r, environ: exec.Environment.inherit{}};
    val ran: res[i64, fail.Fail] = handler(?cx);
    if (sel ran.err) { ret cli_diagnostic.report_fail(r, ran.err, diagnostic.ORIGIN_NONE); }
    ret ran.ok;
}

# the `-a`, `-t` and `-p` patterns and `--all` an invocation was given
# ---
# a:   backs the pattern vectors
# inv: the invocation
# ret: the selectors; err when a vector cannot grow
pub fun collect_selectors(a: *A.Allocator, inv: *std_args.Parsed) res[manifest.Selectors, fail.Fail] {
    var s:         manifest.Selectors          = manifest.selectors_init(a);
    val artifacts: res[Vector[str], fail.Fail] = values(a, inv, ?ARTIFACT);
    if (sel artifacts.err) { ret res[manifest.Selectors, fail.Fail].err{artifacts.err}; }
    s.artifacts = artifacts.ok;
    val targets: res[Vector[str], fail.Fail] = values(a, inv, ?TARGET);
    if (sel targets.err) { ret res[manifest.Selectors, fail.Fail].err{targets.err}; }
    s.targets = targets.ok;
    val profiles: res[Vector[str], fail.Fail] = values(a, inv, ?PROFILE);
    if (sel profiles.err) { ret res[manifest.Selectors, fail.Fail].err{profiles.err}; }
    s.profiles = profiles.ok;
    s.all      = std_args.given(inv, ?ALL);
    ret res[manifest.Selectors, fail.Fail].ok{s};
}

# the decimal worker count of a `--threads` value, from 1 to 65536
fun worker_count(text: str) opt[u32] {
    if (str_len(text) == 0) { ret opt[u32].none{}; }
    var v: u32   = 0;
    var i: usize = 0;
    for (text[i] != 0) {
        if (text[i] < '0' || text[i] > '9') { ret opt[u32].none{}; }
        v = v * 10 + (text[i] - '0')::u32;
        if (v > 65536) { ret opt[u32].none{}; }
        i = i + 1;
    }
    if (v == 0) { ret opt[u32].none{}; }
    ret opt[u32].some{v};
}

# a selection refusal whose unknown value names a path in the working directory,
# restated as the shell's expansion of an unquoted wildcard it almost always is;
# any other failure is returned as given
# ---
# a:         owns the restated message
# selectors: the patterns the command was given
# f:         the failure resolving them
pub fun selection_hint(a: *A.Allocator, selectors: *manifest.Selectors, f: fail.Fail) fail.Fail {
    if (fail.kind_of(f) != diagnostic_kind.SELECTION_UNKNOWN) { ret f; }
    val artifact: fail.Fail = axis_hint(a, "-a", ?selectors.artifacts, f);
    if (fail.kind_of(artifact) != diagnostic_kind.SELECTION_UNKNOWN) { ret artifact; }
    val target: fail.Fail = axis_hint(a, "-t", ?selectors.targets, f);
    if (fail.kind_of(target) != diagnostic_kind.SELECTION_UNKNOWN) { ret target; }
    ret axis_hint(a, "-p", ?selectors.profiles, f);
}

# `selection_hint` over one axis's values
fun axis_hint(a: *A.Allocator, flag: str, values: *Vector[str], f: fail.Fail) fail.Fail {
    val text: str   = fail.describe(f);
    var i:    usize = 0;
    for (i < values.len) {
        val value:  str                 = values.data[i];
        val quoted: res[str, fail.Fail] = fail.format(a, "'{}'", value);
        if (sel quoted.err) { ret quoted.err; }
        if (str_contains(text, quoted.ok)) {
            val exists: res[bool, io_error.Error] = fs.exists(value);
            if (sel exists.ok && exists.ok) {
                ret fail.formatted_user(a, diagnostic_kind.CLI_FLAG_VALUE,
                    "{} '{}' names a path in the current directory: the shell probably expanded an unquoted wildcard; quote the pattern, as in {} '*' ({})",
                    flag, value, flag, text);
            }
        }
        i = i + 1;
    }
    ret f;
}

# the setting of a binary lever: on, off, or the profile's when it is not given
fun lever(inv: *std_args.Parsed, row: *std_args.Flag) request.Lever {
    val read: opt[std_args.Hit] = std_args.latest(inv, row);
    if (sel read.none) { ret request.LEVER_PROFILE; }
    if (read.some.on)  { ret request.LEVER_ON; }
    ret request.LEVER_OFF;
}

# the typed CliArgs of a build-shaped command: verbosity, quiet, the selectors,
# and the overrides, each typed as the request reads it: `-o` and `-w` as raw argument
# pointers or nil, the LEVERS as given, `--threads` as a count or 0 when absent.
# include_deps is false for the command to set, and link_tokens and lib_dirs are
# left empty for collect_link_inputs
# ---
# a:   backs the selector patterns and the name lists
# inv: the invocation
# ret: the arguments; err when a vector cannot grow or a value names nothing its flag takes
pub fun build_cli_invocation(a: *A.Allocator, inv: *std_args.Parsed) res[CliArgs, fail.Fail] {
    var c: CliArgs;

    c.verbosity = 0;
    val spoken: usize = std_args.occurrences(inv, ?VERBOSE);
    if (spoken == 1) { c.verbosity = 1; }
    if (spoken > 1)  { c.verbosity = 2; }
    c.quiet = std_args.given(inv, ?QUIET);

    var o: request.Overrides = request.overrides_init(nil);
    o.verify = std_args.given(inv, ?VERIFY);
    c.emits  = 0;
    val emits: res[Vector[str], fail.Fail] = values(a, inv, ?EMIT);
    if (sel emits.err) { ret res[CliArgs, fail.Fail].err{emits.err}; }
    var ei: usize = 0;
    for (ei < emits.ok.len) {
        val bit: u8 = emit_bit(emits.ok.data[ei]);
        if (bit == 0) { ret res[CliArgs, fail.Fail].err{fail.user(diagnostic_kind.CLI_FLAG_VALUE, EMIT_ERROR)}; }
        c.emits = c.emits | bit;
        ei      = ei + 1;
    }
    o.emit_asm = (c.emits & EMIT_KIND_ASM) != 0;
    o.emit_ir  = (c.emits & EMIT_KIND_IR) != 0;
    o.output   = value_or_nil(inv, ?OUTPUT);
    o.work     = value_or_nil(inv, ?WORK);
    o.optimize = lever(inv, ?OPTIMIZE);
    o.debug    = lever(inv, ?DEBUG);
    val selectors: res[manifest.Selectors, fail.Fail] = collect_selectors(a, inv);
    if (sel selectors.err) { ret res[CliArgs, fail.Fail].err{selectors.err}; }
    c.selectors = selectors.ok;

    val threads: opt[*u8] = value(inv, ?THREADS);
    if (sel threads.some) {
        val counted: opt[u32] = worker_count(threads.some::str);
        if (sel counted.none) { ret res[CliArgs, fail.Fail].err{fail.user(diagnostic_kind.CLI_FLAG_VALUE, "--threads expects a positive integer")}; }
        o.threads = counted.some;
    }
    o.no_cache  = std_args.given(inv, ?NO_CACHE);
    c.overrides = o;
    val settings: res[Vector[manifest.Assignment], fail.Fail] = collect_settings(a, inv);
    if (sel settings.err) { ret res[CliArgs, fail.Fail].err{settings.err}; }
    c.settings = settings.ok;
    val entry: res[EntryArgs, fail.Fail] = collect_entry(a, inv);
    if (sel entry.err) { ret res[CliArgs, fail.Fail].err{entry.err}; }
    c.entry = entry.ok;
    ret res[CliArgs, fail.Fail].ok{c};
}

# every `--set` value split at its first `=`, in argv order
fun collect_settings(a: *A.Allocator, inv: *std_args.Parsed) res[Vector[manifest.Assignment], fail.Fail] {
    var out:     Vector[manifest.Assignment] = collections_vector.init[manifest.Assignment](a);
    val written: res[Vector[str], fail.Fail] = values(a, inv, ?SET);
    if (sel written.err) { ret res[Vector[manifest.Assignment], fail.Fail].err{written.err}; }
    var i: usize = 0;
    for (i < written.ok.len) {
        val text: str        = written.ok.data[i];
        val eq:   opt[usize] = str_index_char(text, '=');
        var at:   usize      = 0;
        if (sel eq.some) { at = eq.some; }
        if (at == 0) {
            ret res[Vector[manifest.Assignment], fail.Fail].err{fail.formatted_user(a, diagnostic_kind.CLI_FLAG_VALUE, "--set '{}' must be written <key>=<value>", text)};
        }
        val key: res[str, A.Error] = str_dup_range(a, text, 0, at);
        if (sel key.err) { ret res[Vector[manifest.Assignment], fail.Fail].err{fail.refused(key.err)}; }
        val pushed: res[usize, A.Error] = collections_vector.push[manifest.Assignment](?out, manifest.Assignment{key: key.ok, value: (?text[at + 1])::str});
        if (sel pushed.err) { ret res[Vector[manifest.Assignment], fail.Fail].err{fail.refused(pushed.err)}; }
        i = i + 1;
    }
    ret res[Vector[manifest.Assignment], fail.Fail].ok{out};
}

# the source roots, kind and narrowing flags an invocation states
fun collect_entry(a: *A.Allocator, inv: *std_args.Parsed) res[EntryArgs, fail.Fail] {
    var e: EntryArgs;
    e.file     = nil;
    e.optimize = false;
    e.debug    = true;
    val sources: res[Vector[str], fail.Fail] = values(a, inv, ?SOURCE);
    if (sel sources.err) { ret res[EntryArgs, fail.Fail].err{sources.err}; }
    e.sources = sources.ok;
    e.kind    = value_or_nil(inv, ?KIND)::str;
    e.target  = nil;
    val exts: res[Vector[str], fail.Fail] = values(a, inv, ?EXT);
    if (sel exts.err) { ret res[EntryArgs, fail.Fail].err{exts.err}; }
    e.exts      = exts.ok;
    e.narrowing = driver_entry.Narrowing{
        env:        value_or_nil(inv, ?ENV)::str,
        abi:        value_or_nil(inv, ?ABI)::str,
        isa:        value_or_nil(inv, ?ISA)::str,
        exts:       e.exts.data,
        ext_count:  e.exts.len,
        code_model: value_or_nil(inv, ?CODE_MODEL)::str,
    };
    ret res[EntryArgs, fail.Fail].ok{e};
}

# fill c.overrides.link_tokens and c.overrides.lib_dirs in command-line order: every `-l` value and every
# operand after the first that input.token_is_path accepts go to link_tokens, every `-L` value to
# lib_dirs. Both vectors are reinitialised with a first
# ---
# a:   allocator for the two vectors
# c:   the arguments to fill
# inv: the invocation
# ret: ok, or err when a push fails
pub fun collect_link_inputs(a: *A.Allocator, c: *CliArgs, inv: *std_args.Parsed) err[fail.Fail] {
    c.overrides.link_tokens = collections_vector.init[*u8](a);
    c.overrides.lib_dirs    = collections_vector.init[*u8](a);

    var w:     std_args.Walk = std_args.walk(inv);
    var first: bool          = true;
    for {
        val step: std_args.Event = std_args.step(?w);
        if (sel step.done) { brk; }
        var into:  *Vector[*u8] = nil;
        var token: *u8          = nil;
        if (sel step.operand) {
            val tok: *u8 = inv.args.argv[step.operand];
            if (!first && input.token_is_path(tok)) {
                into  = ?c.overrides.link_tokens;
                token = tok;
            }
            first = false;
        }
        or (sel step.hit) {
            token = step.hit.value;
            if (step.hit.flag == ?LIB_DIR) { into = ?c.overrides.lib_dirs; }
            or (step.hit.flag == ?LIB)     { into = ?c.overrides.link_tokens; }
        }
        if (into != nil && token != nil) {
            val pushed: res[usize, A.Error] = collections_vector.push[*u8](into, token);
            if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
        }
    }
    ret err[fail.Fail].ok{};
}
