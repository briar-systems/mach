# the typed options of a build-shaped command: what it reports and selects, and
# what it sets over the profile it builds
# ---
# verbosity: 0, 1 or 2 from `-v` and `-vv`
# quiet:     `--quiet`
# selectors: the `-a`, `-t` and `-p` patterns and `--all`
# overrides: everything else the command sets, typed
# emits:     the EMIT_KIND_* bits `-e` names, 0 when it is absent
# entry:     what the command line states of an entry build
pub rec CliArgs {
    verbosity: u8;
    quiet:     bool;
    selectors: manifest.Selectors;
    overrides: request.Overrides;
    emits:     u8;
    entry:     EntryArgs;
}

# what an entry build's command line states: its entry, source roots, artifact kind, target
# and the levers its profile takes
# ---
# file:     the entry operand, nil for a project build
# sources:  every `-s` value, `name=dir` as written
# kind:     the `-k` value, nil when absent
# settings: every target key given, in argv order
# optimize: the profile an entry build states optimizes
# debug:    the profile an entry build states emits debug information
pub rec EntryArgs {
    file:     str;
    sources:  Vector[str];
    kind:     str;
    settings: Vector[driver_entry.TargetSetting];
    optimize: bool;
    debug:    bool;
}

# whether the command line states anything only an entry build takes
# ---
# e:   the entry arguments
# ret: true when a source root, a kind or a target key is given
pub fun entry_stated(e: *EntryArgs) bool {
    ret e.sources.len > 0 || e.kind != nil || e.settings.len > 0;
}

# one product `-e` names
# ---
# name: the value `-e` takes
# bit:  its bit in an emit set
# doc:  what naming it writes, for help
rec EmitKind {
    name: str;
    bit:  u8;
    doc:  str;
}

# masc's listing of each module, beside its object
pub val EMIT_KIND_ASM: u8 = 1;
# mirl's text of each module, beside its object
pub val EMIT_KIND_IR: u8 = 2;
# the objects, with no link
pub val EMIT_KIND_OBJ: u8 = 4;
# the linked artifact
pub val EMIT_KIND_EXE: u8 = 8;

val EMIT_KINDS_N: usize                  = 4;
val EMIT_KINDS:   [EMIT_KINDS_N]EmitKind = [EMIT_KINDS_N]EmitKind{
    EmitKind{name: "asm", bit: EMIT_KIND_ASM, doc: "masc's listing of each module"},
    EmitKind{name: "ir", bit: EMIT_KIND_IR, doc: "mirl's text of each module"},
    EmitKind{name: "obj", bit: EMIT_KIND_OBJ, doc: "the objects, stopping before the link"},
    EmitKind{name: "exe", bit: EMIT_KIND_EXE, doc: "the linked artifact"},
};

# `-e`'s help text
val EMIT_HELP: str = "write a product of the build, once per -e: asm for masc's listing and ir for mirl's text of each module, beside its object; obj for the objects alone; exe for the linked artifact, the default when neither obj nor exe is named";

# the refusal of an `-e` value no product is named by
pub val EMIT_ERROR: str = "-e expects asm, ir, obj or exe";

# the bit of the product `name` names, 0 for none
fun emit_bit(name: str) u8 {
    var i: usize = 0;
    for (i < EMIT_KINDS_N) {
        if (str_equals(EMIT_KINDS[i].name, name)) { ret EMIT_KINDS[i].bit; }
        i = i + 1;
    }
    ret 0;
}

# `--artifact <pattern>`, a selector
val ARTIFACT: std_args.FlagSpec = std_args.FlagSpec{name: "--artifact", value: "pattern", arity: std_args.ARITY_VALUE, doc: "select [artifact.<name>] entries by name or glob", default: "the default selection", negatable: false, occurs: std_args.Occurs.collect{}, alias_of: nil};
# `-a`, the alias of `--artifact`
val ARTIFACT_SHORT: std_args.FlagSpec = std_args.FlagSpec{name: "-a", value: "pattern", arity: std_args.ARITY_VALUE, doc: "select [artifact.<name>] entries by name or glob", default: "", negatable: false, occurs: std_args.Occurs.collect{}, alias_of: ?ARTIFACT};
# `--target <pattern>`, a selector
pub val TARGET: std_args.FlagSpec = std_args.FlagSpec{name: "--target", value: "pattern", arity: std_args.ARITY_VALUE, doc: "select [target.<name>] entries by name or glob", default: "the default target", negatable: false, occurs: std_args.Occurs.collect{}, alias_of: nil};
# `-t`, the alias of `--target`
val TARGET_SHORT: std_args.FlagSpec = std_args.FlagSpec{name: "-t", value: "pattern", arity: std_args.ARITY_VALUE, doc: "select [target.<name>] entries by name or glob", default: "", negatable: false, occurs: std_args.Occurs.collect{}, alias_of: ?TARGET};
# `--profile <pattern>`, a selector
val PROFILE: std_args.FlagSpec = std_args.FlagSpec{name: "--profile", value: "pattern", arity: std_args.ARITY_VALUE, doc: "select [profile.<name>] entries by name or glob", default: "the sole or default profile", negatable: false, occurs: std_args.Occurs.collect{}, alias_of: nil};
# `-p`, the alias of `--profile`
val PROFILE_SHORT: std_args.FlagSpec = std_args.FlagSpec{name: "-p", value: "pattern", arity: std_args.ARITY_VALUE, doc: "select [profile.<name>] entries by name or glob", default: "", negatable: false, occurs: std_args.Occurs.collect{}, alias_of: ?PROFILE};
# `--all`, which fills every selector not given with `*`
pub val ALL: std_args.FlagSpec = std_args.FlagSpec{name: "--all", value: "", arity: std_args.ARITY_FLAG, doc: "select every artifact, target and profile that no -a, -t or -p narrows", default: "", negatable: false, occurs: std_args.Occurs.once{}, alias_of: nil};
# `-o <path>`, the linked-binary path
pub val OUTPUT: std_args.FlagSpec = std_args.FlagSpec{name: "-o", value: "path", arity: std_args.ARITY_VALUE, doc: "override the linked-binary path", default: "", negatable: false, occurs: std_args.Occurs.once{}, alias_of: nil};

# row count of SEL
pub val SEL_N: usize = 8;
# the selection options, consumed by build, check, run, test and doc. each
# selector takes an exact name or a glob and repeats. check hides `-o`, run
# hides `--all`, and doc accepts only `--artifact` and `--target`
pub val SEL: [SEL_N]*std_args.FlagSpec = [SEL_N]*std_args.FlagSpec{?ARTIFACT, ?ARTIFACT_SHORT, ?TARGET, ?TARGET_SHORT, ?PROFILE, ?PROFILE_SHORT, ?ALL, ?OUTPUT};

# `-v`, once for each build phase's row and twice, as `-vv`, for each module or file as well; what
# each readout level shows is the readout contract, doc/language/readout.md
val VERBOSE: std_args.FlagSpec = std_args.FlagSpec{name: "-v", value: "", arity: std_args.ARITY_FLAG, doc: "show each build phase's row as the phase closes; -vv also shows each module or file a phase processed", default: "", negatable: false, occurs: std_args.Occurs.collect{}, alias_of: nil};

# row count of VERBOSITY
pub val VERBOSITY_N: usize = 1;
# the readout levels `-v` and `-vv`, consumed by build, check and test
pub val VERBOSITY: [VERBOSITY_N]*std_args.FlagSpec = [VERBOSITY_N]*std_args.FlagSpec{?VERBOSE};

# `--quiet`
pub val QUIET: std_args.FlagSpec = std_args.FlagSpec{name: "--quiet", value: "", arity: std_args.ARITY_FLAG, doc: "suppress non-error output", default: "", negatable: false, occurs: std_args.Occurs.once{}, alias_of: nil};
# `-q`, the alias of `--quiet`
val QUIET_SHORT: std_args.FlagSpec = std_args.FlagSpec{name: "-q", value: "", arity: std_args.ARITY_FLAG, doc: "suppress non-error output", default: "", negatable: false, occurs: std_args.Occurs.once{}, alias_of: ?QUIET};

# row count of QUIETNESS
pub val QUIETNESS_N: usize = 2;
# `--quiet` and `-q`, consumed by build, check, test, doc, init and every dep action
pub val QUIETNESS: [QUIETNESS_N]*std_args.FlagSpec = [QUIETNESS_N]*std_args.FlagSpec{?QUIET, ?QUIET_SHORT};

# `--subsystem <name>`, a PE subsystem as mink spells it
val SUBSYSTEM: std_args.FlagSpec = std_args.FlagSpec{name: "--subsystem", value: "name", arity: std_args.ARITY_VALUE, doc: "set the environment declared by a Windows executable", default: "artifact subsystem key; inert off Windows", negatable: false, occurs: std_args.Occurs.once{}, alias_of: nil};

# `--verify`, mach's and mirl's verifiers over every lowered module
val VERIFY: std_args.FlagSpec = std_args.FlagSpec{name: "--verify", value: "", arity: std_args.ARITY_FLAG, doc: "run the module and code generation verifiers", default: "off", negatable: false, occurs: std_args.Occurs.once{}, alias_of: nil};

# row count of CGEN
pub val CGEN_N: usize = 2;
# the codegen options, consumed by build, run and test
pub val CGEN: [CGEN_N]*std_args.FlagSpec = [CGEN_N]*std_args.FlagSpec{?SUBSYSTEM, ?VERIFY};

# `--optimize`, the profile's `optimize = true` for this invocation, and `--no-optimize`, its
# `optimize = false`
pub val OPTIMIZE: std_args.FlagSpec = std_args.FlagSpec{name: "--optimize", value: "", arity: std_args.ARITY_FLAG, doc: "run the optimization pass set, or with --no-optimize only the passes every build runs", default: "profile optimize key", negatable: true, occurs: std_args.Occurs.once{}, alias_of: nil};
# `-O`, the alias of `--optimize`
val OPTIMIZE_SHORT: std_args.FlagSpec = std_args.FlagSpec{name: "-O", value: "", arity: std_args.ARITY_FLAG, doc: "run the optimization pass set", default: "", negatable: false, occurs: std_args.Occurs.once{}, alias_of: ?OPTIMIZE};
# `--debug`, the profile's `debug = true` for this invocation, and `--no-debug`, its `debug = false`
pub val DEBUG: std_args.FlagSpec = std_args.FlagSpec{name: "--debug", value: "", arity: std_args.ARITY_FLAG, doc: "emit debug information, or with --no-debug none", default: "profile debug key", negatable: true, occurs: std_args.Occurs.once{}, alias_of: nil};
# `-d`, the alias of `--debug`
val DEBUG_SHORT: std_args.FlagSpec = std_args.FlagSpec{name: "-d", value: "", arity: std_args.ARITY_FLAG, doc: "emit debug information", default: "", negatable: false, occurs: std_args.Occurs.once{}, alias_of: ?DEBUG};
# row count of LEVERS
pub val LEVERS_N: usize = 4;
# the profile levers, each over the selected profile for this invocation only,
# consumed by build and test
pub val LEVERS: [LEVERS_N]*std_args.FlagSpec = [LEVERS_N]*std_args.FlagSpec{?OPTIMIZE, ?OPTIMIZE_SHORT, ?DEBUG, ?DEBUG_SHORT};

# `--source <name=dir>`, a source root of an entry build
pub val SOURCE: std_args.FlagSpec = std_args.FlagSpec{name: "--source", value: "name=dir", arity: std_args.ARITY_VALUE, doc: "bind the module prefix name to the directory dir in a build of an entry file; the binding whose directory holds the entry names the entry's own package", default: "the entry's directory, under the entry's stem", negatable: false, occurs: std_args.Occurs.collect{}, alias_of: nil};
# `-s`, the alias of `--source`
val SOURCE_SHORT: std_args.FlagSpec = std_args.FlagSpec{name: "-s", value: "name=dir", arity: std_args.ARITY_VALUE, doc: "bind the module prefix name to the directory dir in a build of an entry file; the binding whose directory holds the entry names the entry's own package", default: "", negatable: false, occurs: std_args.Occurs.collect{}, alias_of: ?SOURCE};
# `--kind <kind>`, the kind of an entry build's artifact
pub val KIND: std_args.FlagSpec = std_args.FlagSpec{name: "--kind", value: "bin|static|shared", arity: std_args.ARITY_VALUE, doc: "set the kind of an entry build's artifact", default: "bin", negatable: false, occurs: std_args.Occurs.once{}, alias_of: nil};
# `-k`, the alias of `--kind`
val KIND_SHORT: std_args.FlagSpec = std_args.FlagSpec{name: "-k", value: "bin|static|shared", arity: std_args.ARITY_VALUE, doc: "set the kind of an entry build's artifact", default: "", negatable: false, occurs: std_args.Occurs.once{}, alias_of: ?KIND};

# row count of ENTRY
pub val ENTRY_N: usize = 4;
# the source roots and kind of an entry build, consumed by build
pub val ENTRY: [ENTRY_N]*std_args.FlagSpec = [ENTRY_N]*std_args.FlagSpec{?SOURCE, ?SOURCE_SHORT, ?KIND, ?KIND_SHORT};

# `--arch <name>`
val ARCH: std_args.FlagSpec = std_args.FlagSpec{name: "--arch", value: "name", arity: std_args.ARITY_VALUE, doc: "set an entry build's architecture, by mink's name for it", default: "the host's", negatable: false, occurs: std_args.Occurs.once{}, alias_of: nil};
# `--sys <name>`
val SYS: std_args.FlagSpec = std_args.FlagSpec{name: "--sys", value: "name", arity: std_args.ARITY_VALUE, doc: "set an entry build's system, by mink's name for it", default: "the host's", negatable: false, occurs: std_args.Occurs.once{}, alias_of: nil};
# `--abi <name>`
val ABI: std_args.FlagSpec = std_args.FlagSpec{name: "--abi", value: "name", arity: std_args.ARITY_VALUE, doc: "set an entry build's calling convention, by mirl's name for it", default: "the first the owners build for the architecture and system", negatable: false, occurs: std_args.Occurs.once{}, alias_of: nil};
# `--of <name>`
val OF: std_args.FlagSpec = std_args.FlagSpec{name: "--of", value: "name", arity: std_args.ARITY_VALUE, doc: "set an entry build's object format, by mink's name for it", default: "the system's", negatable: false, occurs: std_args.Occurs.once{}, alias_of: nil};
# `--platform <name>`
val PLATFORM: std_args.FlagSpec = std_args.FlagSpec{name: "--platform", value: "name", arity: std_args.ARITY_VALUE, doc: "set an entry build's platform, by mink's name for it", default: "none", negatable: false, occurs: std_args.Occurs.once{}, alias_of: nil};
# `--env <name>`
val ENV: std_args.FlagSpec = std_args.FlagSpec{name: "--env", value: "name", arity: std_args.ARITY_VALUE, doc: "set an entry build's environment, by mink's name for it", default: "the first the owners build for the system", negatable: false, occurs: std_args.Occurs.once{}, alias_of: nil};
# `--isa <selection>`
val ISA: std_args.FlagSpec = std_args.FlagSpec{name: "--isa", value: "selection", arity: std_args.ARITY_VALUE, doc: "set the instruction set an entry build's code may use, as masc selects it", default: "the architecture's baseline", negatable: false, occurs: std_args.Occurs.once{}, alias_of: nil};
# `--ext <name>`
val EXT: std_args.FlagSpec = std_args.FlagSpec{name: "--ext", value: "name", arity: std_args.ARITY_VALUE, doc: "add an extension to an entry build's instruction set, by masc's name for it", default: "", negatable: false, occurs: std_args.Occurs.collect{}, alias_of: nil};
# `--base <address>`
val BASE: std_args.FlagSpec = std_args.FlagSpec{name: "--base", value: "address", arity: std_args.ARITY_VALUE, doc: "set an entry build's image base address, an integer", default: "the format's", negatable: false, occurs: std_args.Occurs.once{}, alias_of: nil};
# `--code-model <name>`
val CODE_MODEL: std_args.FlagSpec = std_args.FlagSpec{name: "--code-model", value: "name", arity: std_args.ARITY_VALUE, doc: "set an entry build's code model, by mirl's psABI name for it", default: "mirl's for the target", negatable: false, occurs: std_args.Occurs.once{}, alias_of: nil};
