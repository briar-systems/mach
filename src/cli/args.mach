# `--no-cache`. a build reads `obj/` as the object cache by default: a module
# whose object there carries the build's key is reused instead of lowered and
# generated
val NO_CACHE: std_args.FlagSpec = std_args.FlagSpec{name: "--no-cache", value: "", arity: std_args.ARITY_FLAG, doc: "force an uncached build: no obj/ reuse and no build-step reuse", default: "object cache on", negatable: false, occurs: std_args.Occurs.once{}, alias_of: nil};

# row count of CACHE
pub val CACHE_N: usize = 1;
# `--no-cache`, consumed by build and test
pub val CACHE: [CACHE_N]*std_args.FlagSpec = [CACHE_N]*std_args.FlagSpec{?NO_CACHE};

# `--diagnostics <human|json>`: how diagnostics, failures and a test run's results reach stderr
val DIAGNOSTICS: std_args.FlagSpec = std_args.FlagSpec{name: "--diagnostics", value: "human|json", arity: std_args.ARITY_VALUE, doc: "write diagnostics to stderr as human text or as NDJSON records", default: "human", negatable: false, occurs: std_args.Occurs.once{}, alias_of: nil};

# row count of DIAG
pub val DIAG_N: usize = 1;
# `--diagnostics`, consumed by build, check and test
pub val DIAG: [DIAG_N]*std_args.FlagSpec = [DIAG_N]*std_args.FlagSpec{?DIAGNOSTICS};

# `--plan`
pub val PLAN: std_args.FlagSpec = std_args.FlagSpec{name: "--plan", value: "", arity: std_args.ARITY_FLAG, doc: "print the effective build plan and exit without building", default: "", negatable: false, occurs: std_args.Occurs.once{}, alias_of: nil};

# row count of PLANS
pub val PLANS_N: usize = 1;
# `--plan`, consumed by build and refused by run
pub val PLANS: [PLANS_N]*std_args.FlagSpec = [PLANS_N]*std_args.FlagSpec{?PLAN};

# `--help`: the invocation asks for its command's page, or its action's, instead of running it.
# it is the set's help flag, so every command accepts it and it takes precedence over every
# refusal but an unknown action
pub val HELP: std_args.FlagSpec = std_args.FlagSpec{name: "--help", value: "", arity: std_args.ARITY_FLAG, doc: "show the overview, or a command's page in place of running it", default: "", negatable: false, occurs: std_args.Occurs.collect{}, alias_of: nil};
# `-h`, the alias of `--help`
val HELP_SHORT: std_args.FlagSpec = std_args.FlagSpec{name: "-h", value: "", arity: std_args.ARITY_FLAG, doc: "show the overview, or a command's page in place of running it", default: "", negatable: false, occurs: std_args.Occurs.collect{}, alias_of: ?HELP};

# row count of HELPS
val HELPS_N: usize = 2;
# `--help` and `-h`
val HELPS: [HELPS_N]*std_args.FlagSpec = [HELPS_N]*std_args.FlagSpec{?HELP, ?HELP_SHORT};
# the table every command accepts before its own
pub val HELP_TABLE: std_args.TableRef = std_args.TableRef{rows: ?HELPS[0], n: HELPS_N, accepted: nil, docs: nil};

# `--runner <cmd>`
pub val RUNNER: std_args.FlagSpec = std_args.FlagSpec{name: "--runner", value: "cmd", arity: std_args.ARITY_VALUE, doc: "execute through a command name or path resolved on PATH, in place of the target's runner", default: "the target's runner, else direct execution", negatable: false, occurs: std_args.Occurs.once{}, alias_of: nil};

# row count of RUNNERS
pub val RUNNERS_N: usize = 1;
# `--runner`, consumed by run and test
pub val RUNNERS: [RUNNERS_N]*std_args.FlagSpec = [RUNNERS_N]*std_args.FlagSpec{?RUNNER};

# `--timeout <duration>`
pub val TIMEOUT: std_args.FlagSpec = std_args.FlagSpec{name: "--timeout", value: "duration", arity: std_args.ARITY_VALUE, doc: "terminate the run and its process group after the duration (30ms, 30s, 5m, 1h)", default: "unbounded", negatable: false, occurs: std_args.Occurs.once{}, alias_of: nil};

# row count of TIMEOUTS
pub val TIMEOUTS_N: usize = 1;
# `--timeout`, consumed by run and test
pub val TIMEOUTS: [TIMEOUTS_N]*std_args.FlagSpec = [TIMEOUTS_N]*std_args.FlagSpec{?TIMEOUT};

# `--allow-unrunnable`
pub val ALLOW_UNRUNNABLE: std_args.FlagSpec = std_args.FlagSpec{name: "--allow-unrunnable", value: "", arity: std_args.ARITY_FLAG, doc: "exit 0 when nothing selected can run on this host, after building it", default: "", negatable: false, occurs: std_args.Occurs.once{}, alias_of: nil};

# row count of ALLOW_UNRUNNABLES
pub val ALLOW_UNRUNNABLES_N: usize = 1;
# `--allow-unrunnable`, consumed by test
pub val ALLOW_UNRUNNABLES: [ALLOW_UNRUNNABLES_N]*std_args.FlagSpec = [ALLOW_UNRUNNABLES_N]*std_args.FlagSpec{?ALLOW_UNRUNNABLE};

# `--offline`
pub val OFFLINE: std_args.FlagSpec = std_args.FlagSpec{name: "--offline", value: "", arity: std_args.ARITY_FLAG, doc: "resolve from releases already fetched", default: "", negatable: false, occurs: std_args.Occurs.once{}, alias_of: nil};

# row count of OFFLINES
pub val OFFLINES_N: usize = 1;
# `--offline`, consumed by the dep actions that resolve releases
pub val OFFLINES: [OFFLINES_N]*std_args.FlagSpec = [OFFLINES_N]*std_args.FlagSpec{?OFFLINE};

# length of RELATIONS
pub val RELATIONS_N: usize = 1;
# the relations among the shared rows, in force in every schema that accepts both rows
pub val RELATIONS: [RELATIONS_N]std_args.Relation = [RELATIONS_N]std_args.Relation{
    std_args.Relation{kind: std_args.RELATION_CONFLICTS, row: ?VERBOSE, other: ?QUIET},
};

# the rule every selector keeps, which the help of each command with selectors prints
pub val SELECTOR_CONSTRAINT: str = "-a, -t and -p take an exact name, which must be declared, or a glob with * and ?, which must match; an artifact pairs only with the targets its `targets` list supports";

# what dispatch hands a command's handler; dispatch owns every member and outlives the call
# ---
# a:       an arena dispatch releases once the handler returns, for what lives as long as the command
# backing: the heap under a, for what the command frees itself before it returns
# inv:     the invocation
# report:  where the command reports a failure it goes on past or that carries an origin, in the
#          format `--diagnostics` selected
# environ: the environment the command runs in, which the processes it starts inherit
pub rec Call {
    a:       *A.Allocator;
    backing: *A.Allocator;
    inv:     *std_args.Invocation;
    report:  *cli_diagnostic.Report;
    environ: exec.Environment;
}

# the operand at a position among an invocation's operands
# ---
# inv: the invocation
# n:   the position, 0 the first
# ret: the operand, or nil when there are not that many
pub fun operand(inv: *std_args.Invocation, n: usize) *u8 {
    val idx: opt[usize] = std_args.operand(inv, n);
    if (sel idx.some) { ret inv.args.argv[idx.some]; }
    ret nil;
}

# the value a row was given, which a row of a schema that does not list it never has
# ---
# inv: the invocation
# row: a canonical row that does not collect
# ret: the value, or none when the row did not occur or occurred without one
pub fun value(inv: *std_args.Invocation, row: *std_args.FlagSpec) opt[*u8] {
    val read: res[str, std_args.Misread] = std_args.value(inv, row);
    if (sel read.ok) {
        if (read.ok != nil) { ret opt[*u8].some{read.ok}; }
    }
    ret opt[*u8].none{};
}

fun value_or_nil(inv: *std_args.Invocation, row: *std_args.FlagSpec) *u8 {
    val v: opt[*u8] = value(inv, row);
    if (sel v.some) { ret v.some; }
    ret nil;
}

# every value a row was given, in argument order
# ---
# a:   backs the vector
# inv: the invocation
# row: a canonical row
# ret: the values, empty for a row its schema does not list; err when the vector cannot grow
pub fun values(a: *A.Allocator, inv: *std_args.Invocation, row: *std_args.FlagSpec) res[Vector[str], fail.Fail] {
    var found: Vector[str]                            = collections_vector.init[str](a);
    val walk:  res[std_args.Values, std_args.Misread] = std_args.values(inv, row);
    if (sel walk.err) { ret res[Vector[str], fail.Fail].ok{found}; }
    var w: std_args.Values = walk.ok;
    for {
        val hit: opt[std_args.Hit] = std_args.next_value(?w);
        if (sel hit.none) { brk; }
        if (hit.some.value != nil) {
            val pushed: res[usize, A.Error] = collections_vector.push[str](?found, hit.some.value);
            if (sel pushed.err) { ret res[Vector[str], fail.Fail].err{fail.refused(pushed.err)}; }
        }
    }
    ret res[Vector[str], fail.Fail].ok{found};
}

# the diagnostics format `--diagnostics <human|json>` selects; human when the command does not take
# the option or it is absent
# ---
# inv: the invocation
# ret: the format, or a user failure for any value but `human` and `json`
fun diagnostics_format(inv: *std_args.Invocation) res[cli_diagnostic.Format, fail.Fail] {
    if (!std_args.occurred(inv, ?DIAGNOSTICS)) { ret res[cli_diagnostic.Format, fail.Fail].ok{cli_diagnostic.FORMAT_HUMAN}; }
    val v: opt[*u8] = value(inv, ?DIAGNOSTICS);
    if (sel v.some) {
        val named: opt[cli_diagnostic.Format] = cli_diagnostic.format_named(v.some::str);
        if (sel named.some) { ret res[cli_diagnostic.Format, fail.Fail].ok{named.some}; }
    }
    ret res[cli_diagnostic.Format, fail.Fail].err{fail.user(diagnostic_kind.CLI_FLAG_VALUE, "--diagnostics expects `human` or `json`")};
}

# the diagnostic kind of a refusal
fun refusal_kind(r: std_args.Refusal) diagnostic_kind.Kind {
    if (sel r.unknown_command) { ret diagnostic_kind.CLI_UNKNOWN_COMMAND; }
    if (sel r.unknown_action)  { ret diagnostic_kind.CLI_UNKNOWN_ACTION; }
    if (sel r.unknown)         { ret diagnostic_kind.CLI_FLAG_UNKNOWN; }
    if (sel r.inapplicable)    { ret diagnostic_kind.CLI_FLAG_INAPPLICABLE; }
    if (sel r.removed)         { ret diagnostic_kind.CLI_FLAG_REMOVED; }
    if (sel r.missing_value)   { ret diagnostic_kind.CLI_FLAG_VALUE; }
    if (sel r.repeated)        { ret diagnostic_kind.CLI_FLAG_REPEATED; }
    if (sel r.relation) {
        if (r.relation.kind == std_args.RELATION_REQUIRES) { ret diagnostic_kind.CLI_FLAG_INAPPLICABLE; }
        ret diagnostic_kind.CLI_FLAG_CONFLICT;
    }
    ret diagnostic_kind.CLI_OPERAND;
}

# the row of REMOVED `tok` gives a value to with `=`, nil when it gives none: the engine matches a
# removed spelling against the whole token
fun removed_with_value(tok: str) *std_args.Removed {
    var i: usize = 0;
    for (i < REMOVED_N) {
        val gone: *std_args.Removed = ?REMOVED[i];
        if (str_starts_with(tok, gone.name) && tok[str_len(gone.name)] == '=') { ret gone; }
        i = i + 1;
    }
    ret nil;
}

# an invocation's refusal as a failure, in the engine's words
# ---
# a:   owns the text
# inv: the invocation
# ret: the failure: a user failure of the refusal's kind, or an internal one for a malformed set
pub fun refusal(a: *A.Allocator, inv: *std_args.Invocation) fail.Fail {
    if (sel inv.refusal.none) { ret fail.message("a refusal was read from an invocation that holds none"); }
    val r: std_args.Refusal = inv.refusal.some;
    if (sel r.unknown) {
        val gone: *std_args.Removed = removed_with_value(r.unknown.tok);
        if (gone != nil) { ret fail.formatted_user(a, diagnostic_kind.CLI_FLAG_REMOVED, "option '{}' was removed; use {}", r.unknown.tok, gone.use); }
    }
    var text:  io_writer.Memory;
    var w:     io_writer.Writer          = io_writer.memory_growing(?text, a);
    val wrote: err[io_writer.WriteError] = std_args.describe(inv, ?w);
    if (sel wrote.err)   { ret fail.environment(diagnostic_kind.OUTPUT_WRITE, fail.write_text(wrote.err)); }
    if (sel r.malformed) { ret fail.message(io_writer.memory_text(?text)); }
    ret fail.user(refusal_kind(r), io_writer.memory_text(?text));
}

# run an invocation and report how it ended through one report, in the format `--diagnostics`
# selects, human when that format is itself malformed: its refusal when it holds one, otherwise
# the handler, given an arena this call owns. a failure the handler returns is reported here
# ---
# a:       owns the refusal's text
# inv:     the invocation; its command is not nil
# handler: what runs
# ret:     the exit code
pub fun run(a: *A.Allocator, inv: *std_args.Invocation, handler: fun(*Call) res[i64, fail.Fail]) i64 {
    var format: cli_diagnostic.Format                 = cli_diagnostic.FORMAT_HUMAN;
    val chosen: res[cli_diagnostic.Format, fail.Fail] = diagnostics_format(inv);
    if (sel chosen.ok) { format = chosen.ok; }
    var r: cli_diagnostic.Report;
    cli_diagnostic.report_init(?r, format);
    r.w = fs.writer(fs.STDERR);
    if (sel inv.refusal.some) { ret cli_diagnostic.report_close(?r, cli_diagnostic.report_fail(?r, refusal(a, inv), diagnostic.ORIGIN_NONE)); }
    if (sel chosen.err)       { ret cli_diagnostic.report_close(?r, cli_diagnostic.report_fail(?r, chosen.err, diagnostic.ORIGIN_NONE)); }
    ret cli_diagnostic.report_close(?r, call(inv, ?r, handler));
}

fun call(inv: *std_args.Invocation, r: *cli_diagnostic.Report, handler: fun(*Call) res[i64, fail.Fail]) i64 {
    var src: heap.Source;
    var h:   heap.Heap;
    heap.native_source(?src);
    val begun: err[A.Error] = heap.init(?h, ?src, 0);
    if (sel begun.err) { ret cli_diagnostic.report_fail(r, fail.refused(begun.err), diagnostic.ORIGIN_NONE); }
    fin { val freed: err[A.Error] = heap.dnit(?h); }
    var backing: A.Allocator;
    val made:    err[A.Error] = heap.make(?backing, ?h);
    if (sel made.err) { ret cli_diagnostic.report_fail(r, fail.refused(made.err), diagnostic.ORIGIN_NONE); }
    var ar:     arena.Arena;
    val opened: err[A.Error] = arena.init(?ar, ?backing, 0);
    if (sel opened.err) { ret cli_diagnostic.report_fail(r, fail.refused(opened.err), diagnostic.ORIGIN_NONE); }
    fin { arena.dnit(?ar); }
    var a:     A.Allocator;
    val armed: err[A.Error] = arena.make(?a, ?ar);
    if (sel armed.err) { ret cli_diagnostic.report_fail(r, fail.refused(armed.err), diagnostic.ORIGIN_NONE); }
    var cx:  Call                = Call{a: ?a, backing: ?backing, inv: inv, report: r, environ: exec.Environment.inherit{}};
    val ran: res[i64, fail.Fail] = handler(?cx);
    if (sel ran.err) { ret cli_diagnostic.report_fail(r, ran.err, diagnostic.ORIGIN_NONE); }
    ret ran.ok;
}

# the `-a`, `-t` and `-p` patterns and `--all` an invocation was given
# ---
# a:   backs the pattern vectors
# inv: the invocation
# ret: the selectors; err when a vector cannot grow
pub fun collect_selectors(a: *A.Allocator, inv: *std_args.Invocation) res[manifest.Selectors, fail.Fail] {
    var s:         manifest.Selectors          = manifest.selectors_init(a);
    val artifacts: res[Vector[str], fail.Fail] = values(a, inv, ?ARTIFACT);
    if (sel artifacts.err) { ret res[manifest.Selectors, fail.Fail].err{artifacts.err}; }
    s.artifacts = artifacts.ok;
    val targets: res[Vector[str], fail.Fail] = values(a, inv, ?TARGET);
    if (sel targets.err) { ret res[manifest.Selectors, fail.Fail].err{targets.err}; }
    s.targets = targets.ok;
    val profiles: res[Vector[str], fail.Fail] = values(a, inv, ?PROFILE);
    if (sel profiles.err) { ret res[manifest.Selectors, fail.Fail].err{profiles.err}; }
    s.profiles = profiles.ok;
    s.all      = std_args.given(inv, ?ALL);
    ret res[manifest.Selectors, fail.Fail].ok{s};
}

# the decimal worker count of a `--threads` value, from 1 to 65536
fun worker_count(text: str) opt[u32] {
    if (str_len(text) == 0) { ret opt[u32].none{}; }
    var v: u32   = 0;
    var i: usize = 0;
    for (text[i] != 0) {
        if (text[i] < '0' || text[i] > '9') { ret opt[u32].none{}; }
        v = v * 10 + (text[i] - '0')::u32;
        if (v > 65536) { ret opt[u32].none{}; }
        i = i + 1;
    }
    if (v == 0) { ret opt[u32].none{}; }
    ret opt[u32].some{v};
}

# a selection refusal whose unknown value names a path in the working directory,
# restated as the shell's expansion of an unquoted wildcard it almost always is;
# any other failure is returned as given
# ---
# a:         owns the restated message
# selectors: the patterns the command was given
# f:         the failure resolving them
pub fun selection_hint(a: *A.Allocator, selectors: *manifest.Selectors, f: fail.Fail) fail.Fail {
    if (fail.kind_of(f) != diagnostic_kind.SELECTION_UNKNOWN) { ret f; }
    val artifact: fail.Fail = axis_hint(a, "-a", ?selectors.artifacts, f);
    if (fail.kind_of(artifact) != diagnostic_kind.SELECTION_UNKNOWN) { ret artifact; }
    val target: fail.Fail = axis_hint(a, "-t", ?selectors.targets, f);
    if (fail.kind_of(target) != diagnostic_kind.SELECTION_UNKNOWN) { ret target; }
    ret axis_hint(a, "-p", ?selectors.profiles, f);
}

# `selection_hint` over one axis's values
fun axis_hint(a: *A.Allocator, flag: str, values: *Vector[str], f: fail.Fail) fail.Fail {
    val text: str   = fail.describe(f);
    var i:    usize = 0;
    for (i < values.len) {
        val value:  str                 = values.data[i];
        val quoted: res[str, fail.Fail] = fail.format(a, "'{}'", value);
        if (sel quoted.err) { ret quoted.err; }
        if (str_contains(text, quoted.ok)) {
            val exists: res[bool, io_error.Error] = fs.exists(value);
            if (sel exists.ok && exists.ok) {
                ret fail.formatted_user(a, diagnostic_kind.CLI_FLAG_VALUE,
                    "{} '{}' names a path in the current directory: the shell probably expanded an unquoted wildcard; quote the pattern, as in {} '*' ({})",
                    flag, value, flag, text);
            }
        }
        i = i + 1;
    }
    ret f;
}

# the setting of a binary lever: on, off, or the profile's when it is not given
fun lever(inv: *std_args.Invocation, row: *std_args.FlagSpec) request.Lever {
    val read: res[opt[std_args.Hit], std_args.Misread] = std_args.latest(inv, row);
    if (sel read.err)     { ret request.LEVER_PROFILE; }
    if (sel read.ok.none) { ret request.LEVER_PROFILE; }
    if (read.ok.some.on)  { ret request.LEVER_ON; }
    ret request.LEVER_OFF;
}

# the typed CliArgs of a build-shaped command: verbosity, quiet, the selectors,
# and the overrides, each typed as the request reads it: `-o` and `-w` as raw argument
# pointers or nil, the LEVERS as given, `--threads` as a count or 0 when absent.
# include_deps is false for the command to set, and link_tokens and lib_dirs are
# left empty for collect_link_inputs
# ---
# a:   backs the selector patterns and the name lists
# inv: the invocation
# ret: the arguments; err when a vector cannot grow or a value names nothing its flag takes
pub fun build_cli_invocation(a: *A.Allocator, inv: *std_args.Invocation) res[CliArgs, fail.Fail] {
    var c: CliArgs;

    c.verbosity = 0;
    val spoken: usize = std_args.occurrences(inv, ?VERBOSE);
    if (spoken == 1) { c.verbosity = 1; }
    if (spoken > 1)  { c.verbosity = 2; }
    c.quiet = std_args.given(inv, ?QUIET);

    var o: request.Overrides = request.overrides_init(nil);
    o.verify = std_args.given(inv, ?VERIFY);
    c.emits  = 0;
    val emits: res[Vector[str], fail.Fail] = values(a, inv, ?EMIT);
    if (sel emits.err) { ret res[CliArgs, fail.Fail].err{emits.err}; }
    var ei: usize = 0;
    for (ei < emits.ok.len) {
        val bit: u8 = emit_bit(emits.ok.data[ei]);
        if (bit == 0) { ret res[CliArgs, fail.Fail].err{fail.user(diagnostic_kind.CLI_FLAG_VALUE, EMIT_ERROR)}; }
        c.emits = c.emits | bit;
        ei      = ei + 1;
    }
    o.emit_asm = (c.emits & EMIT_KIND_ASM) != 0;
    o.emit_ir  = (c.emits & EMIT_KIND_IR) != 0;
    val subsystem: *u8 = value_or_nil(inv, ?SUBSYSTEM);
    if (subsystem != nil) {
        val named: res[*mink_subsystem.Subsystem, str] = manifest.subsystem_named(a, subsystem::str);
        if (sel named.err) { ret res[CliArgs, fail.Fail].err{fail.user_of(diagnostic_kind.CLI_FLAG_VALUE, fail.join(a, "--subsystem: ", named.err))}; }
        o.subsystem = opt[*mink_subsystem.Subsystem].some{named.ok};
    }
    o.output   = value_or_nil(inv, ?OUTPUT);
    o.work     = value_or_nil(inv, ?WORK);
    o.optimize = lever(inv, ?OPTIMIZE);
    o.debug    = lever(inv, ?DEBUG);
    val selectors: res[manifest.Selectors, fail.Fail] = collect_selectors(a, inv);
    if (sel selectors.err) { ret res[CliArgs, fail.Fail].err{selectors.err}; }
    c.selectors = selectors.ok;

    val threads: opt[*u8] = value(inv, ?THREADS);
    if (sel threads.some) {
        val counted: opt[u32] = worker_count(threads.some::str);
        if (sel counted.none) { ret res[CliArgs, fail.Fail].err{fail.user(diagnostic_kind.CLI_FLAG_VALUE, "--threads expects a positive integer")}; }
        o.threads = counted.some;
    }
    o.no_cache  = std_args.given(inv, ?NO_CACHE);
    c.overrides = o;
    val entry: res[EntryArgs, fail.Fail] = collect_entry(a, inv);
    if (sel entry.err) { ret res[CliArgs, fail.Fail].err{entry.err}; }
    c.entry = entry.ok;
    ret res[CliArgs, fail.Fail].ok{c};
}

# push the target setting a row occurrence states, when its row is one of TARGET_KEYS
fun push_setting(a: *A.Allocator, e: *EntryArgs, row: *std_args.FlagSpec, text: str) err[fail.Fail] {
    var k: usize = 0;
    for (k < TARGET_KEYS_N) {
        val t: *TargetKey = ?TARGET_KEYS[k];
        k = k + 1;
        if (row != t.row) { cnt; }
        if (t.integer && !integer_text(text)) {
            ret err[fail.Fail].err{fail.formatted_user(a, diagnostic_kind.CLI_FLAG_VALUE, "{} expects an integer, decimal or 0x hexadecimal", t.row.name)};
        }
        val pushed: res[usize, A.Error] = collections_vector.push[driver_entry.TargetSetting](?e.settings, driver_entry.TargetSetting{key: t.key, value: text, integer: t.integer});
        if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
    }
    ret err[fail.Fail].ok{};
}

# the source roots, kind and target keys an invocation states
fun collect_entry(a: *A.Allocator, inv: *std_args.Invocation) res[EntryArgs, fail.Fail] {
    var e: EntryArgs;
    e.file     = nil;
    e.optimize = false;
    e.debug    = true;
    val sources: res[Vector[str], fail.Fail] = values(a, inv, ?SOURCE);
    if (sel sources.err) { ret res[EntryArgs, fail.Fail].err{sources.err}; }
    e.sources  = sources.ok;
    e.kind     = value_or_nil(inv, ?KIND)::str;
    e.settings = collections_vector.init[driver_entry.TargetSetting](a);
    var w: std_args.Walk = std_args.walk(inv);
    for {
        val step: std_args.Event = std_args.step(?w);
        if (sel step.done) { brk; }
        if (sel step.hit) {
            if (step.hit.value != nil) {
                val pushed: err[fail.Fail] = push_setting(a, ?e, step.hit.flag, step.hit.value);
                if (sel pushed.err) { ret res[EntryArgs, fail.Fail].err{pushed.err}; }
            }
        }
    }
    ret res[EntryArgs, fail.Fail].ok{e};
}

# whether `text` is an integer as a manifest writes one: decimal digits, or 0x and hex digits
fun integer_text(text: str) bool {
    var i:   usize = 0;
    var hex: bool  = false;
    if (str_starts_with(text, "0x")) {
        i   = 2;
        hex = true;
    }
    if (text[i] == 0) { ret false; }
    for (text[i] != 0) {
        val c:     u8   = text[i];
        val digit: bool = c >= '0' && c <= '9';
        val alpha: bool = hex && ((c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F'));
        if (!digit && !alpha) { ret false; }
        i = i + 1;
    }
    ret true;
}

# fill c.overrides.link_tokens and c.overrides.lib_dirs in command-line order: every `-l` value and every
# operand after the first that input.token_is_path accepts go to link_tokens, every `-L` value to
# lib_dirs. Both vectors are reinitialised with a first
# ---
# a:   allocator for the two vectors
# c:   the arguments to fill
# inv: the invocation
# ret: ok, or err when a push fails
pub fun collect_link_inputs(a: *A.Allocator, c: *CliArgs, inv: *std_args.Invocation) err[fail.Fail] {
    c.overrides.link_tokens = collections_vector.init[*u8](a);
    c.overrides.lib_dirs    = collections_vector.init[*u8](a);

    var w:     std_args.Walk = std_args.walk(inv);
    var first: bool          = true;
    for {
        val step: std_args.Event = std_args.step(?w);
        if (sel step.done) { brk; }
        var into:  *Vector[*u8] = nil;
        var token: *u8          = nil;
        if (sel step.operand) {
            val tok: *u8 = inv.args.argv[step.operand];
            if (!first && input.token_is_path(tok)) {
                into  = ?c.overrides.link_tokens;
                token = tok;
            }
            first = false;
        }
        or (sel step.hit) {
            token = step.hit.value;
            if (step.hit.flag == ?LIB_DIR) { into = ?c.overrides.lib_dirs; }
            or (step.hit.flag == ?LIB)     { into = ?c.overrides.link_tokens; }
        }
        if (into != nil && token != nil) {
            val pushed: res[usize, A.Error] = collections_vector.push[*u8](into, token);
            if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
        }
    }
    ret err[fail.Fail].ok{};
}
