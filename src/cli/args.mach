# one command-line option as the schema tables declare it
# ---
# name: the spelling matched against an argv token, such as `--target` or `-o`
# value: help placeholder for the option's value; non-empty means the option takes the next argv token, empty means a bare flag
# doc: one-line help text; schema_valid rejects an empty one
# default: help text for what applies when the option is absent; empty prints nothing
# repeatable: rendered as `repeatable` by help; parse_invocation records every occurrence either way
# conflicts: help text naming what this option cannot be combined with; nothing in this module enforces it
# implies: help text naming the option this one also switches on
# alias_of: the canonical spelling this option is an alias of, which must occur exactly once in the same schema; empty for a canonical option
pub rec FlagSpec {
    name:       str;
    value:      str;
    doc:        str;
    default:    str;
    repeatable: bool;
    conflicts:  str;
    implies:    str;
    alias_of:   str;
}

# row count of SEL
pub val SEL_N: usize = 5;
# the artifact-selection options `--target`, `--profile`, `-o`, `--bin`, `--lib`,
# consumed by build, run, test, and doc; run hides `--lib` and doc hides all but
# `--target` through visibility masks, and both still parse the hidden rows
pub val SEL: [SEL_N]FlagSpec = [SEL_N]FlagSpec{
    FlagSpec{ name: "--target",  value: "name", doc: "select a [target.<name>] entry", default: "", repeatable: false, conflicts: "", implies: "", alias_of: "" },
    FlagSpec{ name: "--profile", value: "name", doc: "select a profile", default: "sole or default profile, otherwise built-in debug", repeatable: false, conflicts: "", implies: "", alias_of: "" },
    FlagSpec{ name: "-o",        value: "path", doc: "override the linked-binary path", default: "", repeatable: false, conflicts: "", implies: "", alias_of: "" },
    FlagSpec{ name: "--bin",     value: "name", doc: "narrow the build to one binary artifact", default: "", repeatable: false, conflicts: "", implies: "", alias_of: "" },
    FlagSpec{ name: "--lib",     value: "name", doc: "narrow the build to one static or shared library artifact", default: "", repeatable: false, conflicts: "", implies: "", alias_of: "" },
};

# row count of RDO
pub val RDO_N: usize = 4;
# the readout options `-v`, `-vv`, `--quiet`, `-q`, consumed by build, test,
# and doc; doc hides `-v` and `-vv`. `-q` is the alias of `--quiet`
pub val RDO: [RDO_N]FlagSpec = [RDO_N]FlagSpec{
    FlagSpec{ name: "-v",      value: "", doc: "show build phase timing or per-test lines", default: "", repeatable: false, conflicts: "", implies: "", alias_of: "" },
    FlagSpec{ name: "-vv",     value: "", doc: "show verbose and per-module, per-file, or passing-test detail", default: "", repeatable: false, conflicts: "", implies: "-v", alias_of: "" },
    FlagSpec{ name: "--quiet", value: "", doc: "suppress non-error output", default: "", repeatable: false, conflicts: "", implies: "", alias_of: "" },
    FlagSpec{ name: "-q",      value: "", doc: "suppress non-error output", default: "", repeatable: false, conflicts: "", implies: "", alias_of: "--quiet" },
};

