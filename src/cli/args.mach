fwd request.CliArgs;

# whether an option is a bare flag, takes the next argv token, or takes a value
# attached to its own token after `=`
pub def OptionArity: u8;
# the option stands alone
pub val ARITY_FLAG: OptionArity = 0;
# the option consumes the next argv token as its value; a long option (`--name`) also takes it
# attached to its own token after `=`
pub val ARITY_VALUE: OptionArity = 1;
# the option carries an optional value in its own token after `=`; it never
# consumes the next one, so `--emit-ir` and `--emit-ir=listing` both parse
pub val ARITY_ATTACHED: OptionArity = 2;

# one command-line option. a row is its own identity: the parser records the
# row an option matched, and a consumer asks for it by address
# ---
# name:       the spelling matched against an argv token, such as `--target` or `-o`
# value:      help placeholder for the option's value; empty for ARITY_FLAG
# arity:      how the option takes its value; the ARITY_* constants
# doc:        one-line help text; schema_valid rejects an empty one
# default:    help text for what applies when the option is absent; empty prints nothing
# repeatable: the option may occur more than once; a second occurrence of any other is refused
# alias_of:   the canonical row this spelling stands for, which the parser records in its
#             place; nil for a canonical row
pub rec FlagSpec {
    name:       str;
    value:      str;
    arity:      OptionArity;
    doc:        str;
    default:    str;
    repeatable: bool;
    alias_of:   *FlagSpec;
}

# `--artifact <pattern>`, a selector
pub val ARTIFACT: FlagSpec = FlagSpec{name: "--artifact", value: "pattern", arity: ARITY_VALUE, doc: "select [artifact.<name>] entries by name or glob", default: "the default selection", repeatable: true, alias_of: nil};
# `-a`, the alias of `--artifact`
val ARTIFACT_SHORT: FlagSpec = FlagSpec{name: "-a", value: "pattern", arity: ARITY_VALUE, doc: "select [artifact.<name>] entries by name or glob", default: "", repeatable: true, alias_of: ?ARTIFACT};
# `--target <pattern>`, a selector
pub val TARGET: FlagSpec = FlagSpec{name: "--target", value: "pattern", arity: ARITY_VALUE, doc: "select [target.<name>] entries by name or glob", default: "the default target", repeatable: true, alias_of: nil};
# `-t`, the alias of `--target`
val TARGET_SHORT: FlagSpec = FlagSpec{name: "-t", value: "pattern", arity: ARITY_VALUE, doc: "select [target.<name>] entries by name or glob", default: "", repeatable: true, alias_of: ?TARGET};
# `--profile <pattern>`, a selector
pub val PROFILE: FlagSpec = FlagSpec{name: "--profile", value: "pattern", arity: ARITY_VALUE, doc: "select [profile.<name>] entries by name or glob", default: "the sole or default profile", repeatable: true, alias_of: nil};
# `-p`, the alias of `--profile`
val PROFILE_SHORT: FlagSpec = FlagSpec{name: "-p", value: "pattern", arity: ARITY_VALUE, doc: "select [profile.<name>] entries by name or glob", default: "", repeatable: true, alias_of: ?PROFILE};
# `--all`, which fills every selector not given with `*`
pub val ALL: FlagSpec = FlagSpec{name: "--all", value: "", arity: ARITY_FLAG, doc: "select every artifact, target and profile that no -a, -t or -p narrows", default: "", repeatable: false, alias_of: nil};
# `-o <path>`, the linked-binary path
pub val OUTPUT: FlagSpec = FlagSpec{name: "-o", value: "path", arity: ARITY_VALUE, doc: "override the linked-binary path", default: "", repeatable: false, alias_of: nil};

# row count of SEL
pub val SEL_N: usize = 8;
# the selection options, consumed by build, check, run, test and doc. each
# selector takes an exact name or a glob and repeats. check hides `-o`, run
# hides `--all`, and doc accepts only `--artifact` and `--target`
pub val SEL: [SEL_N]*FlagSpec = [SEL_N]*FlagSpec{?ARTIFACT, ?ARTIFACT_SHORT, ?TARGET, ?TARGET_SHORT, ?PROFILE, ?PROFILE_SHORT, ?ALL, ?OUTPUT};

# `-v`; what each readout level shows is the readout contract, doc/language/readout.md
pub val VERBOSE: FlagSpec = FlagSpec{name: "-v", value: "", arity: ARITY_FLAG, doc: "show each build phase's row as the phase closes", default: "", repeatable: false, alias_of: nil};
# `-vv`, which implies `-v`
pub val VERBOSE_FULL: FlagSpec = FlagSpec{name: "-vv", value: "", arity: ARITY_FLAG, doc: "also show each module or file a phase processed", default: "", repeatable: false, alias_of: nil};

# row count of VERBOSITY
pub val VERBOSITY_N: usize = 2;
# the readout levels `-v` and `-vv`, consumed by build, check and test
pub val VERBOSITY: [VERBOSITY_N]*FlagSpec = [VERBOSITY_N]*FlagSpec{?VERBOSE, ?VERBOSE_FULL};

# `--quiet`
pub val QUIET: FlagSpec = FlagSpec{name: "--quiet", value: "", arity: ARITY_FLAG, doc: "suppress non-error output", default: "", repeatable: false, alias_of: nil};
# `-q`, the alias of `--quiet`
val QUIET_SHORT: FlagSpec = FlagSpec{name: "-q", value: "", arity: ARITY_FLAG, doc: "suppress non-error output", default: "", repeatable: false, alias_of: ?QUIET};

# row count of QUIETNESS
pub val QUIETNESS_N: usize = 2;
# `--quiet` and `-q`, consumed by build, check, test, doc, init and every dep action
pub val QUIETNESS: [QUIETNESS_N]*FlagSpec = [QUIETNESS_N]*FlagSpec{?QUIET, ?QUIET_SHORT};

# `--pie`
pub val PIE: FlagSpec = FlagSpec{name: "--pie", value: "", arity: ARITY_FLAG, doc: "emit a position-independent ET_DYN executable", default: "", repeatable: false, alias_of: nil};
# `--subsystem <console|gui>`
pub val SUBSYSTEM: FlagSpec = FlagSpec{name: "--subsystem", value: "console|gui", arity: ARITY_VALUE, doc: "set the environment declared by a Windows executable", default: "artifact subsystem key; inert off Windows", repeatable: false, alias_of: nil};
# `-g`
pub val DEBUG_INFO: FlagSpec = FlagSpec{name: "-g", value: "", arity: ARITY_FLAG, doc: "emit debug information for this build", default: "profile debug key", repeatable: false, alias_of: nil};
# `--emit-asm`
pub val EMIT_ASM: FlagSpec = FlagSpec{name: "--emit-asm", value: "", arity: ARITY_FLAG, doc: "emit per-module .s assembly beside each object", default: "", repeatable: false, alias_of: nil};
# `--emit-ir[=form]`, the one attached-value row: bare it writes the ir-debug
# dump, `--emit-ir=<form>` selects a row of printer.IR_FORMS
pub val EMIT_IR: FlagSpec = FlagSpec{name: "--emit-ir", value: "form", arity: ARITY_ATTACHED, doc: ir_printer.IR_FORM_HELP, default: "", repeatable: false, alias_of: nil};

# row count of CGEN
pub val CGEN_N: usize = 5;
# the codegen options, consumed by build and test
pub val CGEN: [CGEN_N]*FlagSpec = [CGEN_N]*FlagSpec{?PIE, ?SUBSYSTEM, ?DEBUG_INFO, ?EMIT_ASM, ?EMIT_IR};

# `-O0`
pub val OPT_DEBUG: FlagSpec = FlagSpec{name: "-O0", value: "", arity: ARITY_FLAG, doc: "force the debug pipeline", default: "profile optimization", repeatable: false, alias_of: nil};
# `-O2`
pub val OPT_RELEASE: FlagSpec = FlagSpec{name: "-O2", value: "", arity: ARITY_FLAG, doc: "select the release pipeline", default: "profile optimization", repeatable: false, alias_of: nil};

# row count of OPT
pub val OPT_N: usize = 2;
# the pipeline overrides `-O0` and `-O2`, consumed by build and test
pub val OPT: [OPT_N]*FlagSpec = [OPT_N]*FlagSpec{?OPT_DEBUG, ?OPT_RELEASE};

# `--emit <kind>`; its help text is request.EMIT_HELP
pub val EMIT: FlagSpec = FlagSpec{name: "--emit", value: "kind", arity: ARITY_VALUE, doc: request.EMIT_HELP, default: "", repeatable: false, alias_of: nil};

# row count of EMITS
pub val EMITS_N: usize = 1;
# `--emit`, consumed by build
pub val EMITS: [EMITS_N]*FlagSpec = [EMITS_N]*FlagSpec{?EMIT};

# `--jobs <n>`
pub val JOBS: FlagSpec = FlagSpec{name: "--jobs", value: "n", arity: ARITY_VALUE, doc: "set codegen worker threads; 1 serialises", default: "host CPUs", repeatable: false, alias_of: nil};

# row count of WORKERS
pub val WORKERS_N: usize = 1;
# `--jobs`, consumed by build and test
pub val WORKERS: [WORKERS_N]*FlagSpec = [WORKERS_N]*FlagSpec{?JOBS};

# `-L <dir>`
pub val LIB_DIR: FlagSpec = FlagSpec{name: "-L", value: "dir", arity: ARITY_VALUE, doc: "add a search directory for -l inputs", default: "", repeatable: true, alias_of: nil};
# `-l <name>`
pub val LIB: FlagSpec = FlagSpec{name: "-l", value: "name", arity: ARITY_VALUE, doc: "link a named object, archive, or shared library", default: "", repeatable: true, alias_of: nil};

# row count of LINKIN
pub val LINKIN_N: usize = 2;
# the repeatable link inputs `-L` and `-l`, consumed by build and test
pub val LINKIN: [LINKIN_N]*FlagSpec = [LINKIN_N]*FlagSpec{?LIB_DIR, ?LIB};

# `--no-cache`. a build reads `obj/` as the object cache by default: a module
# whose object there carries the build's key is reused instead of lowered and
# generated
pub val NO_CACHE: FlagSpec = FlagSpec{name: "--no-cache", value: "", arity: ARITY_FLAG, doc: "force an uncached build: no obj/ reuse and no build-step reuse", default: "object cache on", repeatable: false, alias_of: nil};

# row count of CACHE
pub val CACHE_N: usize = 1;
# `--no-cache`, consumed by build and test
pub val CACHE: [CACHE_N]*FlagSpec = [CACHE_N]*FlagSpec{?NO_CACHE};

# `--diagnostics <human|json>`: how diagnostics, failures and a test run's results reach stderr
pub val DIAGNOSTICS: FlagSpec = FlagSpec{name: "--diagnostics", value: "human|json", arity: ARITY_VALUE, doc: "write diagnostics to stderr as human text or as NDJSON records", default: "human", repeatable: false, alias_of: nil};

# row count of DIAG
pub val DIAG_N: usize = 1;
# `--diagnostics`, consumed by build, check and test
pub val DIAG: [DIAG_N]*FlagSpec = [DIAG_N]*FlagSpec{?DIAGNOSTICS};

# `--plan`
pub val PLAN: FlagSpec = FlagSpec{name: "--plan", value: "", arity: ARITY_FLAG, doc: "print the effective build plan and exit without building", default: "", repeatable: false, alias_of: nil};

# row count of PLANS
pub val PLANS_N: usize = 1;
# `--plan`, consumed by build and refused by run
pub val PLANS: [PLANS_N]*FlagSpec = [PLANS_N]*FlagSpec{?PLAN};

# `--help`: the invocation asks for its command's page, or its action's, instead of running it.
# every schema accepts it without declaring it, and it takes precedence over every refusal
# but an unknown action
pub val HELP: FlagSpec = FlagSpec{name: "--help", value: "", arity: ARITY_FLAG, doc: "show the overview, or a command's page in place of running it", default: "", repeatable: true, alias_of: nil};
# `-h`, the alias of `--help`
val HELP_SHORT: FlagSpec = FlagSpec{name: "-h", value: "", arity: ARITY_FLAG, doc: "show the overview, or a command's page in place of running it", default: "", repeatable: true, alias_of: ?HELP};

# row count of HELPS
pub val HELPS_N: usize = 2;
# `--help` and `-h`
pub val HELPS: [HELPS_N]*FlagSpec = [HELPS_N]*FlagSpec{?HELP, ?HELP_SHORT};
# the table every schema accepts before its own
val HELP_TABLE: TableRef = TableRef{rows: ?HELPS[0], n: HELPS_N, accepted: nil, docs: nil};

# `--runner <cmd>`
pub val RUNNER: FlagSpec = FlagSpec{name: "--runner", value: "cmd", arity: ARITY_VALUE, doc: "execute through a command name or path resolved on PATH", default: "direct execution", repeatable: false, alias_of: nil};

# row count of RUNNERS
pub val RUNNERS_N: usize = 1;
# `--runner`, consumed by run and test
pub val RUNNERS: [RUNNERS_N]*FlagSpec = [RUNNERS_N]*FlagSpec{?RUNNER};

# `--timeout <duration>`
pub val TIMEOUT: FlagSpec = FlagSpec{name: "--timeout", value: "duration", arity: ARITY_VALUE, doc: "terminate the run and its process group after the duration (30ms, 30s, 5m, 1h)", default: "unbounded", repeatable: false, alias_of: nil};

# row count of TIMEOUTS
pub val TIMEOUTS_N: usize = 1;
# `--timeout`, consumed by run and test
pub val TIMEOUTS: [TIMEOUTS_N]*FlagSpec = [TIMEOUTS_N]*FlagSpec{?TIMEOUT};

# `--offline`
pub val OFFLINE: FlagSpec = FlagSpec{name: "--offline", value: "", arity: ARITY_FLAG, doc: "resolve from releases already fetched", default: "", repeatable: false, alias_of: nil};

# row count of OFFLINES
pub val OFFLINES_N: usize = 1;
# `--offline`, consumed by the dep actions that resolve releases
pub val OFFLINES: [OFFLINES_N]*FlagSpec = [OFFLINES_N]*FlagSpec{?OFFLINE};

# one option table as a command or action schema composes it
# ---
# rows:     first entry of the table's row list
# n:        row count of rows
# accepted: per-row acceptance parallel to rows, or nil to accept every row; an unaccepted row is
#           unknown to the parser and absent from help
# docs:     per-row help text parallel to rows that replaces the row's own doc in this schema, or
#           nil; an empty entry keeps the row's doc
pub rec TableRef {
    rows:     **FlagSpec;
    n:        usize;
    accepted: *bool;
    docs:     *str;
}

# how a relation binds its two rows; the RELATION_* constants
pub def RelationKind: u8;
# the two rows cannot both be given
pub val RELATION_CONFLICTS: RelationKind = 0;
# `row` is valid only when `other` is given too
pub val RELATION_REQUIRES: RelationKind = 1;
# giving `row` also gives `other`
pub val RELATION_IMPLIES: RelationKind = 2;

# one constraint between two option rows. the parser enforces it and help
# renders it, from relation_text, so the refusal and the help line are one text
# ---
# kind:  the RELATION_* value
# row:   the canonical row the relation is declared on
# other: the canonical row it names
pub rec Relation {
    kind:  RelationKind;
    row:   *FlagSpec;
    other: *FlagSpec;
}

# length of RELATIONS
pub val RELATIONS_N: usize = 3;
# the relations among the shared rows, in force in every schema that accepts both rows
pub val RELATIONS: [RELATIONS_N]Relation = [RELATIONS_N]Relation{
    Relation{kind: RELATION_IMPLIES, row: ?VERBOSE_FULL, other: ?VERBOSE},
    Relation{kind: RELATION_CONFLICTS, row: ?VERBOSE, other: ?QUIET},
    Relation{kind: RELATION_CONFLICTS, row: ?VERBOSE_FULL, other: ?QUIET},
};

# the rule `-o` keeps wherever it names an output, which each command taking it prints and refuses by
pub val OUTPUT_CONSTRAINT: str = "-o must name a canonical path inside the project root: relative, with no . or .. component";

# the rule every selector keeps, which the help of each command with selectors prints
pub val SELECTOR_CONSTRAINT: str = "-a, -t and -p take an exact name, which must be declared, or a glob with * and ?, which must match; an artifact pairs only with the targets its `targets` list supports";

# the operand_max of a command or action that takes any number of operands
pub val OPERANDS_ANY: usize = 0xffffffff;

# one action of a command, the word after the command's own; help renders every field
# ---
# name:         the action word
# id:           a value the owning command tells its actions apart by; the model does not read it
# grammar:      the argument grammar help appends after the action name, leading space included
# effect:       one-sentence description
# exits:        the action's own exit notes beside exit.SHARED; nil when exit_n is 0
# exit_n:       length of exits
# tables:       the action's own option tables, searched after the command's; nil when table_n is 0
# table_n:      length of tables
# relations:    relations among the action's rows; nil when relation_n is 0
# relation_n:   length of relations
# constraints:  constraint sentences for help beyond the relations; nil when constraint_n is 0
# constraint_n: length of constraints
# operand_min:  fewest operands the action takes
# operand_max:  most operands the action takes; OPERANDS_ANY for no bound
# examples:     example lines for help; nil when example_n is 0
# example_n:    length of examples
pub rec ActionSpec {
    name:         str;
    id:           u8;
    grammar:      str;
    effect:       str;
    exits:        *exit.Note;
    exit_n:       usize;
    tables:       *TableRef;
    table_n:      usize;
    relations:    *Relation;
    relation_n:   usize;
    constraints:  *str;
    constraint_n: usize;
    operand_min:  usize;
    operand_max:  usize;
    examples:     *str;
    example_n:    usize;
}

# one command, as its own file declares it: the whole registration of the
# command, read by the parser, by help and by dispatch
# ---
# name:            the command word at argv[1]
# aliases:         alternative command words; nil when alias_n is 0
# alias_n:         length of aliases
# grammar:         the argument grammar help appends after the name, leading space included
# summary:         one-line description for the overview
# effect:          one-sentence description for the command page
# exits:           the command's own exit notes beside exit.SHARED; nil when exit_n is 0
# exit_n:          length of exits
# terminator:      help text for what follows `--`; empty when the command has none
# tables:          the option tables the command accepts; nil when table_n is 0
# table_n:         length of tables
# refused:         option tables the command recognizes only to refuse as inapplicable; nil when
#                  refused_n is 0
# refused_n:       length of refused
# refusal:         why a refused option does not apply, ending the refusal; empty when refused_n is 0
# relations:       relations among the command's own rows; nil when relation_n is 0
# relation_n:      length of relations
# constraints:     constraint sentences for help beyond the relations; nil when constraint_n is 0
# constraint_n:    length of constraints
# operand_min:     fewest operands the command takes; an action's own bounds apply instead
# operand_max:     most operands the command takes; OPERANDS_ANY for no bound
# truncate_at_sep: stop scanning at the first `--`, so later tokens are neither options nor operands
# actions:         the actions argv[2] names; nil when action_n is 0, and then argv[2] is an argument
# action_n:        length of actions
# examples:        example lines for help; nil when example_n is 0
# example_n:       length of examples
# run:             the handler dispatch calls once argv keeps the schema; its ok is the process
#                  exit code, and its err the failure dispatch reports in the code `exit.of` maps it to
pub rec CommandSpec {
    name:            str;
    aliases:         *str;
    alias_n:         usize;
    grammar:         str;
    summary:         str;
    effect:          str;
    exits:           *exit.Note;
    exit_n:          usize;
    terminator:      str;
    tables:          *TableRef;
    table_n:         usize;
    refused:         *TableRef;
    refused_n:       usize;
    refusal:         str;
    relations:       *Relation;
    relation_n:      usize;
    constraints:     *str;
    constraint_n:    usize;
    operand_min:     usize;
    operand_max:     usize;
    truncate_at_sep: bool;
    actions:         *ActionSpec;
    action_n:        usize;
    examples:        *str;
    example_n:       usize;
    run:             fun(*Call) res[i64, fail.Fail];
}

# what dispatch hands a command's handler; dispatch owns every member and outlives the call
# ---
# a:       an arena dispatch releases once the handler returns, for what lives as long as the command
# backing: the page allocator under a, for what the command frees itself before it returns
# argv:    the full process arguments
# inv:     the parsed invocation
# report:  where the command reports a failure it goes on past or that carries an origin, in the
#          format `--diagnostics` selected
pub rec Call {
    a:       *A.Allocator;
    backing: *A.Allocator;
    argv:    **u8;
    inv:     *ParsedInvocation;
    report:  *cli_diagnostic.Report;
}

# an option given in place of a command word, read as that option given to the command that
# answers it: `mach --version` is `mach info --version`
# ---
# row:     the option's canonical row
# command: the command it is given to, whose schema accepts row and which takes no actions
pub rec Global {
    row:     *FlagSpec;
    command: *CommandSpec;
}

# the commands a command line is read against, in help order
# ---
# specs:    first entry of the command list
# n:        length of specs
# help:     the command that answers a `--help` request, given the invocation that asked; nil
#           when the set answers none, and `--help` then runs the command
# globals:  the options argv[1] may give in place of a command word; nil when global_n is 0
# global_n: length of globals
pub rec CommandSet {
    specs:    **CommandSpec;
    n:        usize;
    help:     *CommandSpec;
    globals:  *Global;
    global_n: usize;
}

# a set of commands that answers no help request and takes no global options
# ---
# specs: first entry of the command list
# n:     length of specs
# ret:   the set
pub fun command_set(specs: **CommandSpec, n: usize) CommandSet {
    ret CommandSet{specs: specs, n: n, help: nil, globals: nil, global_n: 0};
}

# the command whose name or one of whose aliases is name
# ---
# set:  the commands
# name: a command word
# ret:  the command, or nil when none matches
pub fun command_for(set: CommandSet, name: str) *CommandSpec {
    var i: usize = 0;
    for (i < set.n) {
        val command: *CommandSpec = set.specs[i];
        if (str_equals(command.name, name)) { ret command; }
        var j: usize = 0;
        for (j < command.alias_n) {
            if (str_equals(command.aliases[j], name)) { ret command; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret nil;
}

# the action of command named name
# ---
# command: the command
# name:    an action word
# ret:     the action, or nil when the command has none of that name
pub fun action_for(command: *CommandSpec, name: str) *ActionSpec {
    var i: usize = 0;
    for (i < command.action_n) {
        if (str_equals(command.actions[i].name, name)) { ret ?command.actions[i]; }
        i = i + 1;
    }
    ret nil;
}

# the help text of the row at j of a table in its schema: the schema's override, or the row's own
# ---
# t:   the table
# j:   the row index
# ret: the text
pub fun row_doc(t: *TableRef, j: usize) str {
    if (t.docs != nil && str_len(t.docs[j]) > 0) { ret t.docs[j]; }
    ret t.rows[j].doc;
}

fun table_accepts(t: *TableRef, j: usize) bool {
    ret t.accepted == nil || t.accepted[j];
}

fun tables_accept(tables: *TableRef, table_n: usize, row: *FlagSpec) bool {
    var i: usize = 0;
    for (i < table_n) {
        var j: usize = 0;
        for (j < tables[i].n) {
            if (tables[i].rows[j] == row && table_accepts(?tables[i], j)) { ret true; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret false;
}

# whether row is an option of the schema of command and action
# ---
# command: the command
# action:  its action, or nil for the command's own tables alone
# row:     the row
# ret:     true when an accepted table entry is row
pub fun schema_accepts(command: *CommandSpec, action: *ActionSpec, row: *FlagSpec) bool {
    if (tables_accept(command.tables, command.table_n, row)) { ret true; }
    ret action != nil && tables_accept(action.tables, action.table_n, row);
}

# whether one of the shared RELATIONS is in force in the schema of command and action
# ---
# command: the command
# action:  its action, or nil
# rel:     an entry of RELATIONS
# ret:     true when the schema accepts both its rows
pub fun relation_active(command: *CommandSpec, action: *ActionSpec, rel: *Relation) bool {
    ret schema_accepts(command, action, rel.row) && schema_accepts(command, action, rel.other);
}

# the sentence a relation reads as, both in help and in the refusal of an invocation that breaks it
# ---
# a:   owns the text
# rel: the relation
# ret: the text, empty for RELATION_IMPLIES, which nothing breaks
pub fun relation_text(a: *A.Allocator, rel: *Relation) res[str, fail.Fail] {
    var said: res[str, std_format.FormatError] = res[str, std_format.FormatError].ok{""};
    if (rel.kind == RELATION_CONFLICTS) { said = std_format.sprint(a, "{} and {} cannot be combined", rel.row.name, rel.other.name); }
    or (rel.kind == RELATION_REQUIRES)  { said = std_format.sprint(a, "{} is valid only with {}", rel.row.name, rel.other.name); }
    if (sel said.err)                   { ret res[str, fail.Fail].err{fail.message("out of memory")}; }
    ret res[str, fail.Fail].ok{said.ok};
}

fun spelling_count(tables: *TableRef, table_n: usize, name: str) usize {
    var count: usize = 0;
    var i:     usize = 0;
    for (i < table_n) {
        var j: usize = 0;
        for (j < tables[i].n) {
            if (table_accepts(?tables[i], j) && str_equals(tables[i].rows[j].name, name)) { count = count + 1; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret count;
}

fun table_set_valid(tables: *TableRef, table_n: usize) bool {
    if (table_n == 0)  { ret tables == nil; }
    if (tables == nil) { ret false; }
    var i: usize = 0;
    for (i < table_n) {
        val table: *TableRef = ?tables[i];
        if (table.rows == nil || table.n == 0) { ret false; }
        var j: usize = 0;
        for (j < table.n) {
            val row: *FlagSpec = table.rows[j];
            if (row == nil || str_len(row.name) == 0 || str_len(row_doc(table, j)) == 0) { ret false; }
            if ((row.arity == ARITY_FLAG) != (str_len(row.value) == 0))                  { ret false; }
            if (row.alias_of != nil && row.alias_of.alias_of != nil)                     { ret false; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret true;
}

# every accepted spelling of the schema occurs once across the command's and the action's tables,
# and every alias names a row the schema accepts
fun schema_unambiguous(command: *CommandSpec, action: *ActionSpec) bool {
    var group: usize = 0;
    for (group < 2) {
        var current:   *TableRef = command.tables;
        var current_n: usize     = command.table_n;
        if (group == 1) {
            if (action == nil) { ret true; }
            current   = action.tables;
            current_n = action.table_n;
        }
        var i: usize = 0;
        for (i < current_n) {
            var j: usize = 0;
            for (j < current[i].n) {
                if (!table_accepts(?current[i], j)) {
                    j = j + 1;
                    cnt;
                }
                val row:   *FlagSpec = current[i].rows[j];
                var count: usize     = spelling_count(command.tables, command.table_n, row.name);
                if (action != nil)                                                         { count = count + spelling_count(action.tables, action.table_n, row.name); }
                if (count != 1)                                                            { ret false; }
                if (row.alias_of != nil && !schema_accepts(command, action, row.alias_of)) { ret false; }
                j = j + 1;
            }
            i = i + 1;
        }
        group = group + 1;
    }
    ret true;
}

fun relations_valid(command: *CommandSpec, action: *ActionSpec, rels: *Relation, rel_n: usize) bool {
    if ((rel_n == 0) != (rels == nil)) { ret false; }
    var i: usize = 0;
    for (i < rel_n) {
        val rel: *Relation = ?rels[i];
        if (rel.row == rel.other || rel.row.alias_of != nil || rel.other.alias_of != nil)             { ret false; }
        if (!schema_accepts(command, action, rel.row) || !schema_accepts(command, action, rel.other)) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun command_record_valid(command: *CommandSpec) bool {
    if (str_len(command.name) == 0 || str_len(command.summary) == 0
        || str_len(command.effect) == 0) { ret false; }
    if (!exit.notes_valid(command.exits, command.exit_n))                      { ret false; }
    if ((command.alias_n == 0) != (command.aliases == nil))                    { ret false; }
    if ((command.constraint_n == 0) != (command.constraints == nil))           { ret false; }
    if ((command.example_n == 0) != (command.examples == nil))                 { ret false; }
    if ((command.action_n == 0) != (command.actions == nil))                   { ret false; }
    if ((command.refused_n == 0) != (str_len(command.refusal) == 0))           { ret false; }
    if (command.operand_min > command.operand_max)                             { ret false; }
    if (!table_set_valid(command.tables, command.table_n))                     { ret false; }
    if (!table_set_valid(command.refused, command.refused_n))                  { ret false; }
    if (!schema_unambiguous(command, nil))                                     { ret false; }
    if (!relations_valid(command, nil, command.relations, command.relation_n)) { ret false; }
    var i: usize = 0;
    for (i < command.refused_n) {
        var j: usize = 0;
        for (j < command.refused[i].n) {
            if (spelling_count(command.tables, command.table_n, command.refused[i].rows[j].name) != 0) { ret false; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret true;
}

fun action_record_valid(command: *CommandSpec, action: *ActionSpec) bool {
    if (str_len(action.name) == 0 || str_len(action.effect) == 0)  { ret false; }
    if (!exit.notes_valid(action.exits, action.exit_n))            { ret false; }
    if ((action.constraint_n == 0) != (action.constraints == nil)) { ret false; }
    if ((action.example_n == 0) != (action.examples == nil))       { ret false; }
    if (action.operand_min > action.operand_max)                   { ret false; }
    if (!table_set_valid(action.tables, action.table_n))           { ret false; }
    if (!schema_unambiguous(command, action))                      { ret false; }
    ret relations_valid(command, action, action.relations, action.relation_n);
}

fun canonical(row: *FlagSpec) *FlagSpec {
    if (row.alias_of != nil) { ret row.alias_of; }
    ret row;
}

fun tables_row_named(tables: *TableRef, table_n: usize, name: str) *FlagSpec {
    var i: usize = 0;
    for (i < table_n) {
        var j: usize = 0;
        for (j < tables[i].n) {
            if (str_equals(tables[i].rows[j].name, name)) { ret canonical(tables[i].rows[j]); }
            j = j + 1;
        }
        i = i + 1;
    }
    ret nil;
}

# the canonical row the first table of the set spelling name gives it, `--help` before any
# command's; nil when no table spells it
fun set_row_named(set: CommandSet, name: str) *FlagSpec {
    var found: *FlagSpec = tables_row_named(?HELP_TABLE, 1, name);
    var i:     usize     = 0;
    for (found == nil && i < set.n) {
        val command: *CommandSpec = set.specs[i];
        i = i + 1;
        if (command == nil) { cnt; }
        found = tables_row_named(command.tables, command.table_n, name);
        if (found == nil) { found = tables_row_named(command.refused, command.refused_n, name); }
        var k: usize = 0;
        for (found == nil && k < command.action_n) {
            found = tables_row_named(command.actions[k].tables, command.actions[k].table_n, name);
            k     = k + 1;
        }
    }
    ret found;
}

# every row of the tables means what every other row of its spelling across the set means: one
# canonical row stands behind each spelling
fun tables_one_meaning(set: CommandSet, tables: *TableRef, table_n: usize) bool {
    var i: usize = 0;
    for (i < table_n) {
        var j: usize = 0;
        for (j < tables[i].n) {
            val row: *FlagSpec = tables[i].rows[j];
            if (set_row_named(set, row.name) != canonical(row)) { ret false; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret true;
}

fun command_one_meaning(set: CommandSet, command: *CommandSpec) bool {
    if (!tables_one_meaning(set, command.tables, command.table_n))    { ret false; }
    if (!tables_one_meaning(set, command.refused, command.refused_n)) { ret false; }
    var k: usize = 0;
    for (k < command.action_n) {
        if (!tables_one_meaning(set, command.actions[k].tables, command.actions[k].table_n)) { ret false; }
        k = k + 1;
    }
    ret true;
}

fun member_of(set: CommandSet, command: *CommandSpec) bool {
    var i: usize = 0;
    for (i < set.n) {
        if (set.specs[i] == command) { ret true; }
        i = i + 1;
    }
    ret false;
}

# the help command is a member, and each global option is a canonical row its command, a member
# without actions, accepts, spelled by no command word
fun globals_valid(set: CommandSet) bool {
    if (set.help != nil && !member_of(set, set.help)) { ret false; }
    if ((set.global_n == 0) != (set.globals == nil))  { ret false; }
    var i: usize = 0;
    for (i < set.global_n) {
        val g: *Global = ?set.globals[i];
        if (g.row == nil || g.command == nil || g.row.alias_of != nil) { ret false; }
        if (!member_of(set, g.command) || g.command.action_n > 0)      { ret false; }
        if (g.row != ?HELP && !schema_accepts(g.command, nil, g.row))  { ret false; }
        if (command_for(set, g.row.name) != nil)                       { ret false; }
        i = i + 1;
    }
    ret true;
}

# whether a command set is well formed: every command and action has a name and a summary or
# effect, exit notes that keep to exit.notes_valid, and operand bounds in order; each count field is
# zero exactly when its pointer is nil; every option row has a name, a doc in its schema and a
# value placeholder exactly when it takes a value; command names and aliases are unique across the
# set and action names within their command; every spelling occurs once in each schema, with the
# command's tables joined to each action's; every alias names an accepted canonical row; every
# declared relation joins two canonical rows of its schema; no refused row is also accepted; one
# canonical row stands behind each spelling across the whole set, `--help` and `-h` included, so a
# flag of one name means one thing in every command; and the help command and global options keep
# to globals_valid. help refuses to render when this is false
# ---
# set: the commands
# ret: true when every check passes
pub fun schema_valid(set: CommandSet) bool {
    var i: usize = 0;
    for (i < set.n) {
        val command: *CommandSpec = set.specs[i];
        if (command == nil || !command_record_valid(command)) { ret false; }
        if (!command_one_meaning(set, command))               { ret false; }
        if (command_for(set, command.name) != command)        { ret false; }
        var ai: usize = 0;
        for (ai < command.alias_n) {
            if (str_len(command.aliases[ai]) == 0)                { ret false; }
            if (command_for(set, command.aliases[ai]) != command) { ret false; }
            var j: usize = 0;
            for (j < set.n) {
                if (set.specs[j] != command && str_equals(set.specs[j].name, command.aliases[ai])) { ret false; }
                j = j + 1;
            }
            ai = ai + 1;
        }
        var j: usize = i + 1;
        for (j < set.n) {
            if (set.specs[j] == command || str_equals(command.name, set.specs[j].name)) { ret false; }
            j = j + 1;
        }
        var k: usize = 0;
        for (k < command.action_n) {
            val action: *ActionSpec = ?command.actions[k];
            if (!action_record_valid(command, action))      { ret false; }
            if (action_for(command, action.name) != action) { ret false; }
            k = k + 1;
        }
        i = i + 1;
    }
    ret globals_valid(set);
}

# the result of looking one argv token up in a schema
# ---
# row:       the canonical row the token names; nil when it names none
# spelled:   the row whose spelling matched, which is row unless an alias matched
# value_off: byte offset of the attached value inside the token; 0 when the token carried none
rec SchemaHit {
    row:       *FlagSpec;
    spelled:   *FlagSpec;
    value_off: usize;
}

# byte offset of the value inside an attached-value token, or 0 when tok is not
# `name=`-prefixed. An empty value still offsets past the `=`, so `--emit-ir=`
# reaches the form catalog and is refused there by name rather than here
fun attached_value_offset(name: str, tok: str) usize {
    val n: usize = str_len(name);
    if (str_len(tok) <= n) { ret 0; }
    if (tok[n] != '=')     { ret 0; }
    var i: usize = 0;
    for (i < n) {
        if (tok[i] != name[i]) { ret 0; }
        i = i + 1;
    }
    ret n + 1;
}

# whether a row takes its value after `=` in its own token: an attached row, and a long value row
fun takes_attached(row: *FlagSpec) bool {
    if (row.arity == ARITY_ATTACHED) { ret true; }
    ret row.arity == ARITY_VALUE && str_starts_with(row.name, "--");
}

fun scan_tables(tables: *TableRef, table_n: usize, tok: str, hit: *SchemaHit) bool {
    var i: usize = 0;
    for (i < table_n) {
        val tr: *TableRef = ?tables[i];
        var j:  usize     = 0;
        for (j < tr.n) {
            if (!table_accepts(tr, j)) {
                j = j + 1;
                cnt;
            }
            val row: *FlagSpec = tr.rows[j];
            var off: usize     = 0;
            if (takes_attached(row)) { off = attached_value_offset(row.name, tok); }
            if (str_equals(row.name, tok) || off > 0) {
                hit.spelled   = row;
                hit.row       = row;
                hit.value_off = off;
                if (row.alias_of != nil) { hit.row = row.alias_of; }
                ret true;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    ret false;
}

fun schema_lookup(command: *CommandSpec, action: *ActionSpec, tok: str) SchemaHit {
    var hit: SchemaHit;
    hit.row       = nil;
    hit.spelled   = nil;
    hit.value_off = 0;
    if (scan_tables(?HELP_TABLE, 1, tok, ?hit))                  { ret hit; }
    if (scan_tables(command.tables, command.table_n, tok, ?hit)) { ret hit; }
    if (action != nil)                                           { scan_tables(action.tables, action.table_n, tok, ?hit); }
    ret hit;
}

# one recognized option in argv
# ---
# row:       the canonical row the option names, whichever spelling was given
# idx:       argv index of the option token
# has_value: a value token followed within the scanned range, or an ARITY_ATTACHED option carried one after `=`
# value_idx: argv index of the value token, or idx when has_value is false
# value_off: byte offset of the value inside argv[value_idx]; non-zero only for an ARITY_ATTACHED option
pub rec Occurrence {
    row:       *FlagSpec;
    idx:       usize;
    has_value: bool;
    value_idx: usize;
    value_off: usize;
}

# argv read against one command's schema. The three arrays are argc long and owned by the
# invocation; dnit_invocation frees them
# ---
# argc:             length of argv
# commands:         the set the command was looked up in; empty when the command was given directly
# command:          the command argv[1] named, or nil when it named none
# action:           the action argv[2] named, or nil
# sep_idx:          index of the first `--` when the command truncates there, else argc
# marks:            true at every recognized option token and its value token; nil when reading
#                   stopped before scanning
# occ:              recognized options in argv order; nil when reading stopped before scanning
# occ_len:          length of occ in use
# positional_idx:   argv index of the first positional, or argc when none
# positional_count: number of positionals
# positional_idxs:  argv indices of the positionals in order; nil when reading stopped before scanning
# has_positional:   at least one positional
# refusal:          the first way argv breaks the schema, in argv order: a missing or unknown
#                   action, a value option without its value, a repeated option, an unknown or
#                   inapplicable flag, then a broken relation, then an operand count outside the
#                   bounds; none when argv keeps it. dispatch reports it in place of running the
#                   command
# environ:          the environment the command runs in, which the processes it starts inherit
pub rec ParsedInvocation {
    argc:             usize;
    commands:         CommandSet;
    command:          *CommandSpec;
    action:           *ActionSpec;
    sep_idx:          usize;
    marks:            *bool;
    occ:              *Occurrence;
    occ_len:          usize;
    positional_idx:   usize;
    positional_count: usize;
    positional_idxs:  *usize;
    has_positional:   bool;
    refusal:          opt[fail.Fail];
    environ:          **u8;
}

# free the arrays parse_invocation allocated; nil arrays are skipped
# ---
# a:   the allocator parse_invocation was given
# inv: the invocation
pub fun dnit_invocation(a: *A.Allocator, inv: *ParsedInvocation) {
    if (inv.marks != nil)           { A.deallocate[bool](a, inv.marks, inv.argc); }
    if (inv.occ != nil)             { A.deallocate[Occurrence](a, inv.occ, inv.argc); }
    if (inv.positional_idxs != nil) { A.deallocate[usize](a, inv.positional_idxs, inv.argc); }
}

fun invocation_init(argc: usize) ParsedInvocation {
    var inv: ParsedInvocation;
    inv.argc             = argc;
    inv.commands.specs   = nil;
    inv.commands.n       = 0;
    inv.command          = nil;
    inv.action           = nil;
    inv.sep_idx          = argc;
    inv.marks            = nil;
    inv.occ              = nil;
    inv.occ_len          = 0;
    inv.positional_idx   = argc;
    inv.positional_count = 0;
    inv.positional_idxs  = nil;
    inv.has_positional   = false;
    inv.refusal          = opt[fail.Fail].none{};
    inv.environ          = env.environ();
    ret inv;
}

# `mach <command>`, or `mach <command> <action>` once an action is read, as messages name it
fun usage_name(a: *A.Allocator, inv: *ParsedInvocation) str {
    var said: res[str, std_format.FormatError] = std_format.sprint(a, "mach {}", inv.command.name);
    if (inv.action != nil) { said = std_format.sprint(a, "mach {} {}", inv.command.name, inv.action.name); }
    if (sel said.err)      { ret "mach"; }
    ret said.ok;
}

fun refuse_once(inv: *ParsedInvocation, f: fail.Fail) {
    val first: bool = sel inv.refusal.none;
    if (first) { inv.refusal = opt[fail.Fail].some{f}; }
}

fun refuse_said(inv: *ParsedInvocation, k: diagnostic_kind.Kind, said: res[str, std_format.FormatError]) {
    if (sel said.err) {
        refuse_once(inv, fail.message("out of memory"));
        ret;
    }
    refuse_once(inv, fail.user(k, said.ok));
}

# a command's action names, comma separated, as a refusal naming a missing or unknown action lists
# them
# ---
# a:       owns the text
# command: the command
# ret:     the names; what was listed before an allocation failed
pub fun action_list(a: *A.Allocator, command: *CommandSpec) str {
    var text: str   = "";
    var i:    usize = 0;
    for (i < command.action_n) {
        var said: res[str, std_format.FormatError] = std_format.sprint(a, "{}, {}", text, command.actions[i].name);
        if (i == 0)       { said = std_format.sprint(a, "{}", command.actions[i].name); }
        if (sel said.err) { ret text; }
        text = said.ok;
        i    = i + 1;
    }
    ret text;
}

fun refuse_relations(a: *A.Allocator, inv: *ParsedInvocation, rels: *Relation, rel_n: usize, shared: bool) {
    var i: usize = 0;
    for (i < rel_n) {
        val rel: *Relation = ?rels[i];
        if (rel.kind == RELATION_IMPLIES || (shared && !relation_active(inv.command, inv.action, rel))) {
            i = i + 1;
            cnt;
        }
        val both:   bool = occurred(inv, rel.row) && occurred(inv, rel.other);
        val orphan: bool = occurred(inv, rel.row) && !given(inv, rel.other);
        if ((rel.kind == RELATION_CONFLICTS && both) || (rel.kind == RELATION_REQUIRES && orphan)) {
            var k: diagnostic_kind.Kind = diagnostic_kind.CLI_FLAG_CONFLICT;
            if (rel.kind == RELATION_REQUIRES) { k = diagnostic_kind.CLI_FLAG_INAPPLICABLE; }
            val text: res[str, fail.Fail] = relation_text(a, rel);
            if (sel text.ok) { refuse_once(inv, fail.user(k, text.ok)); }
            or               { refuse_once(inv, fail.message("out of memory")); }
            ret;
        }
        i = i + 1;
    }
}

# read argv against one command: the action at argv[2] when the command has actions, then every
# token from the first after the command or action word to the end, or to the first `--` when the
# command truncates there. A recognized option is recorded under its canonical row, and a value
# option claims the next token as its value, or the text after `=` in its own token. Every other
# token starting with `-` is unknown, or inapplicable when the command refuses it; the rest are
# positionals. The first breach of the schema becomes the invocation's refusal, and the scan still
# runs to the end. `--help` withdraws every refusal but an unknown action, since the invocation
# then asks for a page rather than a run
# ---
# a:       allocator for the invocation's three arrays and its refusal text
# command: the command argv[1] named
# argc:    length of argv
# argv:    the argument vector, program name at argv[0]
# ret:     the invocation; err only on allocation failure
pub fun parse_command(a: *A.Allocator, command: *CommandSpec, argc: usize, argv: **u8) res[ParsedInvocation, fail.Fail] {
    ret parse_from(a, command, 2, argc, argv);
}

# parse_command with the command's own arguments starting at argv[first]: 2 after a command word,
# 1 for a global option that stands in for one
fun parse_from(a: *A.Allocator, command: *CommandSpec, first: usize, argc: usize, argv: **u8) res[ParsedInvocation, fail.Fail] {
    var inv: ParsedInvocation = invocation_init(argc);
    inv.command = command;

    var scan_start:     usize = first;
    var action_missing: bool  = false;
    if (command.action_n > 0) {
        if (first >= argc || util.arg_is_flag(argv[first]::str)) { action_missing = true; }
        or {
            inv.action = action_for(command, argv[first]::str);
            if (inv.action == nil) {
                refuse_said(?inv, diagnostic_kind.CLI_UNKNOWN_ACTION, std_format.sprint(a, "unknown {} action '{}'; the actions are {}", command.name, argv[first]::str, action_list(a, command)));
                ret res[ParsedInvocation, fail.Fail].ok{inv};
            }
            scan_start = first + 1;
        }
    }

    var bound: usize = argc;
    if (command.truncate_at_sep) { bound = util.arg_separator_index(argc, argv); }
    inv.sep_idx = bound;

    val rm: res[*bool, A.Error] = A.allocate[bool](a, argc);
    if (sel rm.err) { ret res[ParsedInvocation, fail.Fail].err{fail.refused(rm.err)}; }
    val marks: *bool = rm.ok;
    var mi:    usize = 0;
    for (mi < argc) {
        marks[mi] = false;
        mi        = mi + 1;
    }
    inv.marks = marks;

    val ro: res[*Occurrence, A.Error] = A.allocate[Occurrence](a, argc);
    if (sel ro.err) {
        dnit_invocation(a, ?inv);
        ret res[ParsedInvocation, fail.Fail].err{fail.refused(ro.err)};
    }
    val occ: *Occurrence = ro.ok;
    inv.occ = occ;

    val rp: res[*usize, A.Error] = A.allocate[usize](a, argc);
    if (sel rp.err) {
        dnit_invocation(a, ?inv);
        ret res[ParsedInvocation, fail.Fail].err{fail.refused(rp.err)};
    }
    inv.positional_idxs = rp.ok;

    var i: usize = scan_start;
    for (i < bound) {
        val tok: str       = argv[i]::str;
        val hit: SchemaHit = schema_lookup(command, inv.action, tok);
        if (hit.row == nil) {
            if (util.arg_is_flag(tok)) {
                var refused: SchemaHit;
                refused.row = nil;
                if (scan_tables(command.refused, command.refused_n, tok, ?refused)) {
                    refuse_said(?inv, diagnostic_kind.CLI_FLAG_INAPPLICABLE, std_format.sprint(a, "option '{}' is not applicable to '{}'; {}", tok, command.name, command.refusal));
                }
                or {
                    refuse_said(?inv, diagnostic_kind.CLI_FLAG_UNKNOWN, std_format.sprint(a, "unknown flag '{}' for '{}'", tok, usage_name(a, ?inv)));
                }
            }
            or {
                inv.positional_idxs[inv.positional_count] = i;
                if (!inv.has_positional) {
                    inv.positional_idx = i;
                    inv.has_positional = true;
                }
                inv.positional_count = inv.positional_count + 1;
            }
            i = i + 1;
            cnt;
        }

        if (!hit.row.repeatable && occurred(?inv, hit.row)) {
            refuse_said(?inv, diagnostic_kind.CLI_FLAG_REPEATED, std_format.sprint(a, "option '{}' for '{}' cannot be repeated", tok, usage_name(a, ?inv)));
        }
        marks[i] = true;
        val o: *Occurrence = ?occ[inv.occ_len];
        o.row       = hit.row;
        o.idx       = i;
        o.has_value = false;
        o.value_idx = i;
        o.value_off = 0;
        inv.occ_len = inv.occ_len + 1;
        i           = i + 1;
        if (hit.value_off > 0) {
            o.has_value = true;
            o.value_off = hit.value_off;
            cnt;
        }
        if (hit.spelled.arity == ARITY_VALUE) {
            if (i < bound) {
                marks[i]    = true;
                o.has_value = true;
                o.value_idx = i;
                i           = i + 1;
            }
            or {
                refuse_said(?inv, diagnostic_kind.CLI_FLAG_VALUE, std_format.sprint(a, "option '{}' for '{}' requires a value", tok, usage_name(a, ?inv)));
            }
        }
    }

    if (help_requested(?inv)) {
        inv.refusal = opt[fail.Fail].none{};
        ret res[ParsedInvocation, fail.Fail].ok{inv};
    }
    if (action_missing) {
        inv.refusal = opt[fail.Fail].none{};
        refuse_said(?inv, diagnostic_kind.CLI_OPERAND, std_format.sprint(a, "missing {} action; the actions are {}", command.name, action_list(a, command)));
        ret res[ParsedInvocation, fail.Fail].ok{inv};
    }
    if (sel inv.refusal.some) { ret res[ParsedInvocation, fail.Fail].ok{inv}; }

    refuse_relations(a, ?inv, ?RELATIONS[0], RELATIONS_N, true);
    refuse_relations(a, ?inv, command.relations, command.relation_n, false);
    if (inv.action != nil)    { refuse_relations(a, ?inv, inv.action.relations, inv.action.relation_n, false); }
    if (sel inv.refusal.some) { ret res[ParsedInvocation, fail.Fail].ok{inv}; }

    var operand_min: usize = command.operand_min;
    var operand_max: usize = command.operand_max;
    var grammar:     str   = command.grammar;
    if (inv.action != nil) {
        operand_min = inv.action.operand_min;
        operand_max = inv.action.operand_max;
        grammar     = inv.action.grammar;
    }
    if (inv.positional_count < operand_min || inv.positional_count > operand_max) {
        refuse_said(?inv, diagnostic_kind.CLI_OPERAND, std_format.sprint(a, "usage: {}{}", usage_name(a, ?inv), grammar));
    }
    ret res[ParsedInvocation, fail.Fail].ok{inv};
}

# read argv against the command argv[1] names in a set, as parse_command does. a global option of
# the set at argv[1] reads as that option given to the command it stands in for
# ---
# a:        allocator for the invocation
# commands: the commands to look argv[1] up in
# argc:     length of argv
# argv:     the argument vector, program name at argv[0]
# ret:      the invocation, whose command is nil when argc is below 2 or argv[1] names neither a
#           command nor a global option; err only on allocation failure
pub fun parse_invocation(a: *A.Allocator, commands: CommandSet, argc: usize, argv: **u8) res[ParsedInvocation, fail.Fail] {
    var command: *CommandSpec = nil;
    var first:   usize        = 2;
    if (argc >= 2) { command = command_for(commands, argv[1]::str); }
    if (argc >= 2 && command == nil) {
        command = global_for(commands, argv[1]::str);
        first   = 1;
    }
    if (command == nil) {
        var none: ParsedInvocation = invocation_init(argc);
        none.commands = commands;
        ret res[ParsedInvocation, fail.Fail].ok{none};
    }
    val parsed: res[ParsedInvocation, fail.Fail] = parse_from(a, command, first, argc, argv);
    if (sel parsed.err) { ret parsed; }
    var inv: ParsedInvocation = parsed.ok;
    inv.commands = commands;
    ret res[ParsedInvocation, fail.Fail].ok{inv};
}

# the command a global option of the set spelled tok stands in for, or nil when tok spells none
fun global_for(commands: CommandSet, tok: str) *CommandSpec {
    var i: usize = 0;
    for (i < commands.global_n) {
        val g: *Global = ?commands.globals[i];
        if (schema_lookup(g.command, nil, tok).row == g.row) { ret g.command; }
        i = i + 1;
    }
    ret nil;
}

# whether the invocation asks for a page rather than a run: `--help` or `-h` occurred
# ---
# inv: the parsed invocation
# ret: true when it did
pub fun help_requested(inv: *ParsedInvocation) bool {
    ret occurred(inv, ?HELP);
}

# whether row itself occurred in argv, under any of its spellings
# ---
# inv: the parsed invocation
# row: a canonical row
# ret: true when some occurrence records row
pub fun occurred(inv: *ParsedInvocation, row: *FlagSpec) bool {
    var i: usize = 0;
    for (i < inv.occ_len) {
        if (inv.occ[i].row == row) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun implied_by(inv: *ParsedInvocation, rels: *Relation, rel_n: usize, row: *FlagSpec, shared: bool) bool {
    var i: usize = 0;
    for (i < rel_n) {
        val rel: *Relation = ?rels[i];
        if (rel.kind == RELATION_IMPLIES && rel.other == row && occurred(inv, rel.row)
            && (!shared || relation_active(inv.command, inv.action, rel))) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether row was given: it occurred, or a row that implies it did
# ---
# inv: the parsed invocation
# row: a canonical row
# ret: true when given
pub fun given(inv: *ParsedInvocation, row: *FlagSpec) bool {
    if (occurred(inv, row))                                                         { ret true; }
    if (inv.command == nil)                                                         { ret false; }
    if (implied_by(inv, ?RELATIONS[0], RELATIONS_N, row, true))                     { ret true; }
    if (implied_by(inv, inv.command.relations, inv.command.relation_n, row, false)) { ret true; }
    ret inv.action != nil && implied_by(inv, inv.action.relations, inv.action.relation_n, row, false);
}

# the value row was given; a row that does not repeat has at most one
# ---
# inv:  the parsed invocation
# argv: the argument vector inv was parsed from
# row:  a canonical row
# ret:  the value, or none when row did not occur or occurred without one
pub fun value(inv: *ParsedInvocation, argv: **u8, row: *FlagSpec) opt[*u8] {
    var i: usize = 0;
    for (i < inv.occ_len) {
        val o: *Occurrence = ?inv.occ[i];
        if (o.row == row && o.has_value) { ret opt[*u8].some{?argv[o.value_idx][o.value_off]}; }
        i = i + 1;
    }
    ret opt[*u8].none{};
}

fun value_or_nil(inv: *ParsedInvocation, argv: **u8, row: *FlagSpec) *u8 {
    val v: opt[*u8] = value(inv, argv, row);
    if (sel v.some) { ret v.some; }
    ret nil;
}

# every value row was given, in argv order
# ---
# a:    backs the vector
# inv:  the parsed invocation
# argv: the argument vector inv was parsed from
# row:  a canonical row
# ret:  the values; err when the vector cannot grow
pub fun values(a: *A.Allocator, inv: *ParsedInvocation, argv: **u8, row: *FlagSpec) res[Vector[str], fail.Fail] {
    var found: Vector[str] = collections_vector.init[str](a);
    var i:     usize       = 0;
    for (i < inv.occ_len) {
        val o: *Occurrence = ?inv.occ[i];
        if (o.row == row && o.has_value) {
            val pushed: res[usize, A.Error] = collections_vector.push[str](?found, (?argv[o.value_idx][o.value_off])::str);
            if (sel pushed.err) { ret res[Vector[str], fail.Fail].err{fail.refused(pushed.err)}; }
        }
        i = i + 1;
    }
    ret res[Vector[str], fail.Fail].ok{found};
}

# the diagnostics format `--diagnostics <human|json>` selects; human when the command does not take
# the option or it is absent
# ---
# inv:  the parsed invocation
# argv: the argument vector inv was parsed from
# ret:  the format, or a user failure for any value but `human` and `json`
pub fun diagnostics_format(inv: *ParsedInvocation, argv: **u8) res[cli_diagnostic.Format, fail.Fail] {
    if (!occurred(inv, ?DIAGNOSTICS)) { ret res[cli_diagnostic.Format, fail.Fail].ok{cli_diagnostic.FORMAT_HUMAN}; }
    val v: opt[*u8] = value(inv, argv, ?DIAGNOSTICS);
    if (sel v.some) {
        val named: opt[cli_diagnostic.Format] = cli_diagnostic.format_named(v.some::str);
        if (sel named.some) { ret res[cli_diagnostic.Format, fail.Fail].ok{named.some}; }
    }
    ret res[cli_diagnostic.Format, fail.Fail].err{fail.user(diagnostic_kind.CLI_FLAG_VALUE, "--diagnostics expects `human` or `json`")};
}

# run a parsed invocation and report how it ended through one report, in the format
# `--diagnostics` selects, human when that format is itself malformed: the refusal when argv broke
# the schema; otherwise the handler of the command, or of the set's help command when the
# invocation asks for a page, given an arena this call owns. a failure the handler returns is
# reported here
# ---
# inv:  the parsed invocation; its command is not nil
# argv: the argument vector inv was parsed from
# ret:  the exit code
pub fun run(inv: *ParsedInvocation, argv: **u8) i64 {
    ret run_to(inv, argv, fs.writer(fs.STDERR));
}

# run with the report written to w in place of stderr
# ---
# inv:  the parsed invocation; its command is not nil
# argv: the argument vector inv was parsed from
# w:    where the report is written
# ret:  the exit code
pub fun run_to(inv: *ParsedInvocation, argv: **u8, w: io_writer.Writer) i64 {
    var format: cli_diagnostic.Format                 = cli_diagnostic.FORMAT_HUMAN;
    val chosen: res[cli_diagnostic.Format, fail.Fail] = diagnostics_format(inv, argv);
    if (sel chosen.ok) { format = chosen.ok; }
    var r: cli_diagnostic.Report;
    cli_diagnostic.report_init(?r, format);
    r.w = w;
    if (sel inv.refusal.some) { ret cli_diagnostic.report_close(?r, cli_diagnostic.report_fail(?r, inv.refusal.some, diagnostic.ORIGIN_NONE)); }
    if (sel chosen.err)       { ret cli_diagnostic.report_close(?r, cli_diagnostic.report_fail(?r, chosen.err, diagnostic.ORIGIN_NONE)); }
    var handler: fun(*Call) res[i64, fail.Fail] = inv.command.run;
    if (help_requested(inv) && inv.commands.help != nil) { handler = inv.commands.help.run; }
    ret cli_diagnostic.report_close(?r, call(inv, argv, ?r, handler));
}

# run_to through a handler of the caller's in place of the command's own, for a test that
# substitutes what the command depends on
# ---
# inv:     the parsed invocation, which keeps its schema
# argv:    the argument vector inv was parsed from
# w:       where the report is written
# handler: what runs in place of the command's handler
# ret:     the exit code
pub fun run_as(inv: *ParsedInvocation, argv: **u8, w: io_writer.Writer, handler: fun(*Call) res[i64, fail.Fail]) i64 {
    var r: cli_diagnostic.Report;
    cli_diagnostic.report_init(?r, cli_diagnostic.FORMAT_HUMAN);
    r.w = w;
    ret cli_diagnostic.report_close(?r, call(inv, argv, ?r, handler));
}

fun call(inv: *ParsedInvocation, argv: **u8, r: *cli_diagnostic.Report, handler: fun(*Call) res[i64, fail.Fail]) i64 {
    var backing: A.Allocator;
    val made:    err[A.Error] = page.make(?backing);
    if (sel made.err) { ret cli_diagnostic.report_fail(r, fail.refused(made.err), diagnostic.ORIGIN_NONE); }
    var ar:     arena.Arena;
    val opened: err[A.Error] = arena.init(?ar, ?backing, 0);
    if (sel opened.err) { ret cli_diagnostic.report_fail(r, fail.refused(opened.err), diagnostic.ORIGIN_NONE); }
    fin { arena.dnit(?ar); }
    var a:     A.Allocator;
    val armed: err[A.Error] = arena.make(?a, ?ar);
    if (sel armed.err) { ret cli_diagnostic.report_fail(r, fail.refused(armed.err), diagnostic.ORIGIN_NONE); }
    var cx:  Call                = Call{a: ?a, backing: ?backing, argv: argv, inv: inv, report: r};
    val ran: res[i64, fail.Fail] = handler(?cx);
    if (sel ran.err) { ret cli_diagnostic.report_fail(r, ran.err, diagnostic.ORIGIN_NONE); }
    ret ran.ok;
}

# read argv against one command and run it, as dispatch does once argv[1] has named the command
# ---
# a:       allocator for the invocation
# command: the command
# argc:    length of argv
# argv:    the argument vector, program name at argv[0]
# ret:     the exit code
pub fun invoke(a: *A.Allocator, command: *CommandSpec, argc: usize, argv: **u8) i64 {
    val parsed: res[ParsedInvocation, fail.Fail] = parse_command(a, command, argc, argv);
    if (sel parsed.err) { ret cli_diagnostic.refuse(parsed.err); }
    var inv: ParsedInvocation = parsed.ok;
    fin { dnit_invocation(a, ?inv); }
    ret run(?inv, argv);
}

# the `-a`, `-t` and `-p` patterns and `--all` an invocation was given
# ---
# a:    backs the pattern vectors
# inv:  the parsed invocation
# argv: the argument vector inv was parsed from
# ret:  the selectors; err when a vector cannot grow
pub fun collect_selectors(a: *A.Allocator, inv: *ParsedInvocation, argv: **u8) res[manifest.Selectors, fail.Fail] {
    var s:         manifest.Selectors          = manifest.selectors_init(a);
    val artifacts: res[Vector[str], fail.Fail] = values(a, inv, argv, ?ARTIFACT);
    if (sel artifacts.err) { ret res[manifest.Selectors, fail.Fail].err{artifacts.err}; }
    s.artifacts = artifacts.ok;
    val targets: res[Vector[str], fail.Fail] = values(a, inv, argv, ?TARGET);
    if (sel targets.err) { ret res[manifest.Selectors, fail.Fail].err{targets.err}; }
    s.targets = targets.ok;
    val profiles: res[Vector[str], fail.Fail] = values(a, inv, argv, ?PROFILE);
    if (sel profiles.err) { ret res[manifest.Selectors, fail.Fail].err{profiles.err}; }
    s.profiles = profiles.ok;
    s.all      = given(inv, ?ALL);
    ret res[manifest.Selectors, fail.Fail].ok{s};
}

# the decimal worker count of a `--jobs` value, from 1 to 65536
fun worker_count(text: str) opt[u32] {
    if (str_len(text) == 0) { ret opt[u32].none{}; }
    var v: u32   = 0;
    var i: usize = 0;
    for (text[i] != 0) {
        if (text[i] < '0' || text[i] > '9') { ret opt[u32].none{}; }
        v = v * 10 + (text[i] - '0')::u32;
        if (v > 65536) { ret opt[u32].none{}; }
        i = i + 1;
    }
    if (v == 0) { ret opt[u32].none{}; }
    ret opt[u32].some{v};
}

# a selection refusal whose unknown value names a path in the working directory,
# restated as the shell's expansion of an unquoted wildcard it almost always is;
# any other failure is returned as given
# ---
# a:         owns the restated message
# selectors: the patterns the command was given
# f:         the failure resolving them
pub fun selection_hint(a: *A.Allocator, selectors: *manifest.Selectors, f: fail.Fail) fail.Fail {
    if (fail.kind_of(f) != diagnostic_kind.SELECTION_UNKNOWN) { ret f; }
    val artifact: fail.Fail = axis_hint(a, "-a", ?selectors.artifacts, f);
    if (fail.kind_of(artifact) != diagnostic_kind.SELECTION_UNKNOWN) { ret artifact; }
    val target: fail.Fail = axis_hint(a, "-t", ?selectors.targets, f);
    if (fail.kind_of(target) != diagnostic_kind.SELECTION_UNKNOWN) { ret target; }
    ret axis_hint(a, "-p", ?selectors.profiles, f);
}

# `selection_hint` over one axis's values
fun axis_hint(a: *A.Allocator, flag: str, values: *Vector[str], f: fail.Fail) fail.Fail {
    val text: str   = fail.describe(f);
    var i:    usize = 0;
    for (i < values.len) {
        val value:  str                 = values.data[i];
        val quoted: res[str, fail.Fail] = fail.format(a, "'{}'", value);
        if (sel quoted.err) { ret quoted.err; }
        if (str_contains(text, quoted.ok)) {
            val exists: res[bool, io_error.Error] = fs.exists(value);
            if (sel exists.ok && exists.ok) {
                ret fail.formatted_user(a, diagnostic_kind.CLI_FLAG_VALUE,
                    "{} '{}' names a path in the current directory: the shell probably expanded an unquoted wildcard; quote the pattern, as in {} '*' ({})",
                    flag, value, flag, text);
            }
        }
        i = i + 1;
    }
    ret f;
}

# the typed request.CliArgs of a build-shaped command: verbosity 0, 1, or 2 from `-v` and `-vv`,
# quiet, the CGEN flags, the selectors, `-o` as a raw argv pointer or nil, `--jobs` as a count or 0
# when absent, opt_set and
# opt_release from `-O0` and `-O2` with `-O0` winning when both occur. include_deps is false for
# the command to set, and link_tokens and lib_dirs are left empty for collect_link_inputs
# ---
# a:    backs the selector patterns
# inv:  the parsed invocation
# argv: the argument vector inv was parsed from
# ret:  the arguments; err when a vector cannot grow or `--jobs` is no count
pub fun build_cli_invocation(a: *A.Allocator, inv: *ParsedInvocation, argv: **u8) res[request.CliArgs, fail.Fail] {
    var c: request.CliArgs;

    c.verbosity = 0;
    if (given(inv, ?VERBOSE))      { c.verbosity = 1; }
    if (given(inv, ?VERBOSE_FULL)) { c.verbosity = 2; }
    c.quiet        = given(inv, ?QUIET);
    c.emit_asm     = given(inv, ?EMIT_ASM);
    c.emit_ir      = given(inv, ?EMIT_IR);
    c.emit_ir_form = value_or_nil(inv, argv, ?EMIT_IR);
    c.pie          = given(inv, ?PIE);
    c.g            = given(inv, ?DEBUG_INFO);
    c.subsystem    = value_or_nil(inv, argv, ?SUBSYSTEM);
    c.output       = value_or_nil(inv, argv, ?OUTPUT);
    val selectors: res[manifest.Selectors, fail.Fail] = collect_selectors(a, inv, argv);
    if (sel selectors.err) { ret res[request.CliArgs, fail.Fail].err{selectors.err}; }
    c.selectors = selectors.ok;

    c.opt_set     = false;
    c.opt_release = false;
    if (given(inv, ?OPT_DEBUG)) { c.opt_set = true; }
    or (given(inv, ?OPT_RELEASE)) {
        c.opt_set     = true;
        c.opt_release = true;
    }

    c.jobs = 0;
    val jobs: opt[*u8] = value(inv, argv, ?JOBS);
    if (sel jobs.some) {
        val counted: opt[u32] = worker_count(jobs.some::str);
        if (sel counted.none) { ret res[request.CliArgs, fail.Fail].err{fail.user(diagnostic_kind.CLI_FLAG_VALUE, "--jobs expects a positive integer")}; }
        c.jobs = counted.some;
    }
    c.include_deps = false;
    c.no_cache     = given(inv, ?NO_CACHE);

    c.link_tokens.a    = nil;
    c.link_tokens.data = nil;
    c.link_tokens.len  = 0;
    c.link_tokens.cap  = 0;
    c.lib_dirs.a       = nil;
    c.lib_dirs.data    = nil;
    c.lib_dirs.len     = 0;
    c.lib_dirs.cap     = 0;

    ret res[request.CliArgs, fail.Fail].ok{c};
}

# fill c.link_tokens and c.lib_dirs in command-line order: every `-l` value and every bare
# positional after the first that input.token_is_path accepts go to link_tokens, every `-L`
# value to lib_dirs. Both vectors are reinitialised with a first
# ---
# a:    allocator for the two vectors
# c:    the arguments to fill
# inv:  the parsed invocation
# argv: the argument vector inv was parsed from
# ret:  ok, or err when a push fails
pub fun collect_link_inputs(a: *A.Allocator, c: *request.CliArgs, inv: *ParsedInvocation, argv: **u8) err[fail.Fail] {
    c.link_tokens = collections_vector.init[*u8](a);
    c.lib_dirs    = collections_vector.init[*u8](a);

    var oi: usize = 0;
    var pi: usize = 1;
    for (oi < inv.occ_len || pi < inv.positional_count) {
        if (oi < inv.occ_len) {
            val o:           Occurrence = inv.occ[oi];
            val is_lib_dir:  bool       = o.row == ?LIB_DIR;
            val is_link_tok: bool       = o.row == ?LIB;
            if (!is_lib_dir && !is_link_tok) {
                oi = oi + 1;
                cnt;
            }
            if (pi < inv.positional_count && inv.positional_idxs[pi] < o.idx) {
                val tok: *u8 = argv[inv.positional_idxs[pi]];
                if (input.token_is_path(tok)) {
                    val pr: res[usize, A.Error] = collections_vector.push[*u8](?c.link_tokens, tok);
                    if (sel pr.err) { ret err[fail.Fail].err{fail.refused(pr.err)}; }
                }
                pi = pi + 1;
                cnt;
            }
            if (o.has_value) {
                if (is_lib_dir) {
                    val dr: res[usize, A.Error] = collections_vector.push[*u8](?c.lib_dirs, argv[o.value_idx]);
                    if (sel dr.err) { ret err[fail.Fail].err{fail.refused(dr.err)}; }
                }
                or {
                    val lr: res[usize, A.Error] = collections_vector.push[*u8](?c.link_tokens, argv[o.value_idx]);
                    if (sel lr.err) { ret err[fail.Fail].err{fail.refused(lr.err)}; }
                }
            }
            oi = oi + 1;
            cnt;
        }
        val tok: *u8 = argv[inv.positional_idxs[pi]];
        if (input.token_is_path(tok)) {
            val pr: res[usize, A.Error] = collections_vector.push[*u8](?c.link_tokens, tok);
            if (sel pr.err) { ret err[fail.Fail].err{fail.refused(pr.err)}; }
        }
        pi = pi + 1;
    }
    ret err[fail.Fail].ok{};
}

#[testing]
fun t_run(cx: *Call) res[i64, fail.Fail] {
    ret res[i64, fail.Fail].ok{0};
}

#[testing]
val T_NAME:       FlagSpec     = FlagSpec{name: "--name", value: "id", arity: ARITY_VALUE, doc: "name", default: "", repeatable: false, alias_of: nil};
#[testing]
val T_NAME_SHORT: FlagSpec     = FlagSpec{name: "-n", value: "id", arity: ARITY_VALUE, doc: "name", default: "", repeatable: false, alias_of: ?T_NAME};
#[testing]
val T_MANY:       FlagSpec     = FlagSpec{name: "--many", value: "x", arity: ARITY_VALUE, doc: "many", default: "", repeatable: true, alias_of: nil};
#[testing]
val T_FLAG:       FlagSpec     = FlagSpec{name: "--flag", value: "", arity: ARITY_FLAG, doc: "flag", default: "", repeatable: false, alias_of: nil};
#[testing]
val T_OTHER:      FlagSpec     = FlagSpec{name: "--other", value: "", arity: ARITY_FLAG, doc: "other", default: "", repeatable: false, alias_of: nil};
#[testing]
val T_NEED:       FlagSpec     = FlagSpec{name: "--need", value: "", arity: ARITY_FLAG, doc: "need", default: "", repeatable: false, alias_of: nil};
#[testing]
val T_OWN:        [6]*FlagSpec = [6]*FlagSpec{?T_NAME, ?T_NAME_SHORT, ?T_MANY, ?T_FLAG, ?T_OTHER, ?T_NEED};
#[testing]
val T_TABLES:     [3]TableRef  = [3]TableRef{
    TableRef{rows: ?VERBOSITY[0], n: VERBOSITY_N, accepted: nil, docs: nil},
    TableRef{rows: ?QUIETNESS[0], n: QUIETNESS_N, accepted: nil, docs: nil},
    TableRef{rows: ?T_OWN[0], n: 6, accepted: nil, docs: nil},
};
#[testing]
val T_REFUSED:   [1]TableRef = [1]TableRef{TableRef{rows: ?CGEN[0], n: CGEN_N, accepted: nil, docs: nil}};
#[testing]
val T_RELATIONS: [2]Relation = [2]Relation{
    Relation{kind: RELATION_REQUIRES, row: ?T_NEED, other: ?T_FLAG},
    Relation{kind: RELATION_CONFLICTS, row: ?T_FLAG, other: ?T_OTHER},
};
#[testing]
val T_PROBE:      CommandSpec   = CommandSpec{name: "probe", aliases: nil, alias_n: 0, grammar: " <path> [<path>]", summary: "probe", effect: "probe", exits: nil, exit_n: 0, terminator: "", tables: ?T_TABLES[0], table_n: 3, refused: ?T_REFUSED[0], refused_n: 1, refusal: "probe runs nothing", relations: ?T_RELATIONS[0], relation_n: 2, constraints: nil, constraint_n: 0, operand_min: 1, operand_max: 2, truncate_at_sep: false, actions: nil, action_n: 0, examples: nil, example_n: 0, run: t_run};
#[testing]
val T_ONE_OWN:    [1]*FlagSpec  = [1]*FlagSpec{?T_FLAG};
#[testing]
val T_ONE_TABLES: [1]TableRef   = [1]TableRef{TableRef{rows: ?T_ONE_OWN[0], n: 1, accepted: nil, docs: nil}};
#[testing]
val T_ACTIONS:    [1]ActionSpec = [1]ActionSpec{
    ActionSpec{name: "one", id: 0, grammar: " <path>", effect: "one", exits: nil, exit_n: 0, tables: ?T_ONE_TABLES[0], table_n: 1, relations: nil, relation_n: 0, constraints: nil, constraint_n: 0, operand_min: 1, operand_max: 1, examples: nil, example_n: 0},
};
#[testing]
val T_ACTED:          CommandSpec     = CommandSpec{name: "acted", aliases: nil, alias_n: 0, grammar: " <action>", summary: "acted", effect: "acted", exits: nil, exit_n: 0, terminator: "", tables: ?T_TABLES[0], table_n: 1, refused: nil, refused_n: 0, refusal: "", relations: nil, relation_n: 0, constraints: nil, constraint_n: 0, operand_min: 0, operand_max: OPERANDS_ANY, truncate_at_sep: false, actions: ?T_ACTIONS[0], action_n: 1, examples: nil, example_n: 0, run: t_run};
#[testing]
val T_SPECS:          [2]*CommandSpec = [2]*CommandSpec{?T_PROBE, ?T_ACTED};
#[testing]
val T_GLOBALS:        [1]Global       = [1]Global{Global{row: ?T_FLAG, command: ?T_PROBE}};
#[testing]
val T_SET:            CommandSet      = CommandSet{specs: ?T_SPECS[0], n: 2, help: ?T_ACTED, globals: ?T_GLOBALS[0], global_n: 1};
#[testing]
val T_RENAMED:        FlagSpec        = FlagSpec{name: "--name", value: "id", arity: ARITY_VALUE, doc: "another name", default: "", repeatable: false, alias_of: nil};
#[testing]
val T_RENAMED_OWN:    [1]*FlagSpec    = [1]*FlagSpec{?T_RENAMED};
#[testing]
val T_RENAMED_TABLES: [1]TableRef     = [1]TableRef{TableRef{rows: ?T_RENAMED_OWN[0], n: 1, accepted: nil, docs: nil}};
#[testing]
val T_RENAMING:       CommandSpec     = CommandSpec{name: "renaming", aliases: nil, alias_n: 0, grammar: "", summary: "renaming", effect: "renaming", exits: nil, exit_n: 0, terminator: "", tables: ?T_RENAMED_TABLES[0], table_n: 1, refused: nil, refused_n: 0, refusal: "", relations: nil, relation_n: 0, constraints: nil, constraint_n: 0, operand_min: 0, operand_max: 0, truncate_at_sep: false, actions: nil, action_n: 0, examples: nil, example_n: 0, run: t_run};
#[testing]
val T_HELPING:        FlagSpec        = FlagSpec{name: "-h", value: "", arity: ARITY_FLAG, doc: "a help of its own", default: "", repeatable: false, alias_of: nil};
#[testing]
val T_HELPING_OWN:    [1]*FlagSpec    = [1]*FlagSpec{?T_HELPING};
#[testing]
val T_HELPING_TABLES: [1]TableRef     = [1]TableRef{TableRef{rows: ?T_HELPING_OWN[0], n: 1, accepted: nil, docs: nil}};
#[testing]
val T_HELPFUL:        CommandSpec     = CommandSpec{name: "helpful", aliases: nil, alias_n: 0, grammar: "", summary: "helpful", effect: "helpful", exits: nil, exit_n: 0, terminator: "", tables: ?T_HELPING_TABLES[0], table_n: 1, refused: nil, refused_n: 0, refusal: "", relations: nil, relation_n: 0, constraints: nil, constraint_n: 0, operand_min: 0, operand_max: 0, truncate_at_sep: false, actions: nil, action_n: 0, examples: nil, example_n: 0, run: t_run};
#[testing]
val T_CLASHING:       [2]*CommandSpec = [2]*CommandSpec{?T_PROBE, ?T_RENAMING};
#[testing]
val T_SHADOWING:      [1]*CommandSpec = [1]*CommandSpec{?T_HELPFUL};

# the invocation argv reads as against the probe commands
#[testing]
fun t_parse(argc: usize, argv: **u8) ParsedInvocation {
    var a: A.Allocator;
    page.make(?a);
    val parsed: res[ParsedInvocation, fail.Fail] = parse_invocation(?a, T_SET, argc, argv);
    if (sel parsed.err) { ret invocation_init(0); }
    ret parsed.ok;
}

# the kind of the refusal parsing argv against the probe commands records; NONE when there is none
#[testing]
fun t_refusal(argc: usize, argv: **u8) diagnostic_kind.Kind {
    var a:    A.Allocator;
    val made: err[A.Error] = page.make(?a);
    if (sel made.err) { ret diagnostic_kind.CLI_UNKNOWN_COMMAND; }
    val parsed: res[ParsedInvocation, fail.Fail] = parse_invocation(?a, T_SET, argc, argv);
    if (sel parsed.err) { ret diagnostic_kind.CLI_UNKNOWN_COMMAND; }
    var inv: ParsedInvocation = parsed.ok;
    fin { dnit_invocation(?a, ?inv); }
    if (sel inv.refusal.some) { ret fail.kind_of(inv.refusal.some); }
    ret diagnostic_kind.NONE;
}

test schema_valid__the_probe_commands_are_well_formed {
    if (!schema_valid(T_SET)) { ret 1; }
    ret 0;
}

test parse_invocation__an_alias_is_recorded_as_its_canonical_row {
    var a:    A.Allocator;
    val made: err[A.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var argv:   [4]*u8                           = [4]*u8{"mach", "probe", "-n", "x"};
    var argv2:  [5]*u8                           = [5]*u8{"mach", "probe", "-n", "x", "."};
    val parsed: res[ParsedInvocation, fail.Fail] = parse_command(?a, ?T_PROBE, 5, ?argv2[0]);
    if (sel parsed.err) { ret 2; }
    var inv: ParsedInvocation = parsed.ok;
    fin { dnit_invocation(?a, ?inv); }
    if (sel inv.refusal.some)                                { ret 3; }
    if (inv.occ_len != 1 || inv.occ[0].row != ?T_NAME)       { ret 4; }
    if (!given(?inv, ?T_NAME) || given(?inv, ?T_NAME_SHORT)) { ret 5; }
    val got: opt[*u8] = value(?inv, ?argv2[0], ?T_NAME);
    if (sel got.none)                                          { ret 6; }
    if (!str_equals(got.some::str, "x"))                       { ret 7; }
    if (t_refusal(4, ?argv[0]) != diagnostic_kind.CLI_OPERAND) { ret 8; }
    ret 0;
}

test parse_invocation__a_repeat_or_a_missing_value_is_refused_once_per_row {
    var twice: [7]*u8 = [7]*u8{"mach", "probe", ".", "--name", "a", "-n", "b"};
    if (t_refusal(7, ?twice[0]) != diagnostic_kind.CLI_FLAG_REPEATED) { ret 1; }
    var many: [7]*u8 = [7]*u8{"mach", "probe", ".", "--many", "a", "--many", "b"};
    if (t_refusal(7, ?many[0]) != diagnostic_kind.NONE) { ret 2; }
    var bare: [4]*u8 = [4]*u8{"mach", "probe", ".", "--name"};
    if (t_refusal(4, ?bare[0]) != diagnostic_kind.CLI_FLAG_VALUE) { ret 3; }
    var quiet: [5]*u8 = [5]*u8{"mach", "probe", ".", "--quiet", "-q"};
    if (t_refusal(5, ?quiet[0]) != diagnostic_kind.CLI_FLAG_REPEATED) { ret 4; }
    ret 0;
}

test parse_invocation__an_unknown_flag_and_a_refused_one_are_told_apart {
    var argv: [4]*u8 = [4]*u8{"mach", "probe", ".", "--bogus"};
    if (t_refusal(4, ?argv[0]) != diagnostic_kind.CLI_FLAG_UNKNOWN) { ret 1; }
    argv[3] = "--pie";
    if (t_refusal(4, ?argv[0]) != diagnostic_kind.CLI_FLAG_INAPPLICABLE) { ret 2; }
    argv[3] = "-";
    if (t_refusal(4, ?argv[0]) != diagnostic_kind.NONE) { ret 3; }
    ret 0;
}

test parse_invocation__relations_are_enforced_and_implied_rows_are_given {
    var need: [4]*u8 = [4]*u8{"mach", "probe", ".", "--need"};
    if (t_refusal(4, ?need[0]) != diagnostic_kind.CLI_FLAG_INAPPLICABLE) { ret 1; }
    var met: [5]*u8 = [5]*u8{"mach", "probe", ".", "--need", "--flag"};
    if (t_refusal(5, ?met[0]) != diagnostic_kind.NONE) { ret 2; }
    var both: [5]*u8 = [5]*u8{"mach", "probe", ".", "--other", "--flag"};
    if (t_refusal(5, ?both[0]) != diagnostic_kind.CLI_FLAG_CONFLICT) { ret 3; }
    var loud: [5]*u8 = [5]*u8{"mach", "probe", ".", "-vv", "-q"};
    if (t_refusal(5, ?loud[0]) != diagnostic_kind.CLI_FLAG_CONFLICT) { ret 4; }

    var a:    A.Allocator;
    val made: err[A.Error] = page.make(?a);
    if (sel made.err) { ret 5; }
    val parsed: res[ParsedInvocation, fail.Fail] = parse_command(?a, ?T_PROBE, 4, ?loud[0]);
    if (sel parsed.err) { ret 6; }
    var inv: ParsedInvocation = parsed.ok;
    fin { dnit_invocation(?a, ?inv); }
    if (!given(?inv, ?VERBOSE) || occurred(?inv, ?VERBOSE)) { ret 7; }
    ret 0;
}

test parse_invocation__operand_counts_keep_the_command_or_action_bounds {
    var none: [2]*u8 = [2]*u8{"mach", "probe"};
    if (t_refusal(2, ?none[0]) != diagnostic_kind.CLI_OPERAND) { ret 1; }
    var three: [5]*u8 = [5]*u8{"mach", "probe", "a", "b", "c"};
    if (t_refusal(5, ?three[0]) != diagnostic_kind.CLI_OPERAND) { ret 2; }
    var two: [4]*u8 = [4]*u8{"mach", "probe", "a", "b"};
    if (t_refusal(4, ?two[0]) != diagnostic_kind.NONE) { ret 3; }

    var bare: [2]*u8 = [2]*u8{"mach", "acted"};
    if (t_refusal(2, ?bare[0]) != diagnostic_kind.CLI_OPERAND) { ret 4; }
    var bogus: [4]*u8 = [4]*u8{"mach", "acted", "bogus", "."};
    if (t_refusal(4, ?bogus[0]) != diagnostic_kind.CLI_UNKNOWN_ACTION) { ret 5; }
    var one: [5]*u8 = [5]*u8{"mach", "acted", "one", ".", "--flag"};
    if (t_refusal(5, ?one[0]) != diagnostic_kind.NONE)        { ret 6; }
    if (t_refusal(3, ?one[0]) != diagnostic_kind.CLI_OPERAND) { ret 7; }
    ret 0;
}

test schema_valid__a_spelling_means_one_row_across_the_set {
    if (schema_valid(command_set(?T_CLASHING[0], 2)))  { ret 1; }
    if (schema_valid(command_set(?T_SHADOWING[0], 1))) { ret 2; }
    if (!schema_valid(command_set(?T_CLASHING[0], 1))) { ret 3; }
    ret 0;
}

test parse_invocation__help_withdraws_every_refusal_but_an_unknown_action {
    var flagged: [4]*u8 = [4]*u8{"mach", "probe", "--bogus", "-h"};
    if (t_refusal(4, ?flagged[0]) != diagnostic_kind.NONE) { ret 1; }
    var inv: ParsedInvocation = t_parse(4, ?flagged[0]);
    if (!help_requested(?inv)) { ret 2; }
    var bare: [3]*u8 = [3]*u8{"mach", "acted", "--help"};
    if (t_refusal(3, ?bare[0]) != diagnostic_kind.NONE) { ret 3; }
    var acted: ParsedInvocation = t_parse(3, ?bare[0]);
    if (acted.action != nil || !help_requested(?acted)) { ret 4; }
    var bogus: [4]*u8 = [4]*u8{"mach", "acted", "bogus", "-h"};
    if (t_refusal(4, ?bogus[0]) != diagnostic_kind.CLI_UNKNOWN_ACTION) { ret 5; }
    var valued: [5]*u8           = [5]*u8{"mach", "probe", ".", "--name", "help"};
    var named:  ParsedInvocation = t_parse(5, ?valued[0]);
    if (help_requested(?named) || sel named.refusal.some) { ret 6; }
    var missing: [3]*u8 = [3]*u8{"mach", "acted", "-q"};
    if (t_refusal(3, ?missing[0]) != diagnostic_kind.CLI_OPERAND) { ret 7; }
    ret 0;
}

test parse_invocation__a_long_value_option_takes_its_value_after_equals {
    var argv: [4]*u8           = [4]*u8{"mach", "probe", "--name=x", "."};
    var inv:  ParsedInvocation = t_parse(4, ?argv[0]);
    if (sel inv.refusal.some || inv.positional_count != 1) { ret 1; }
    val got: opt[*u8] = value(?inv, ?argv[0], ?T_NAME);
    if (sel got.none)                    { ret 2; }
    if (!str_equals(got.some::str, "x")) { ret 2; }
    argv[2] = "-n=x";
    if (t_refusal(4, ?argv[0]) != diagnostic_kind.CLI_FLAG_UNKNOWN) { ret 3; }
    ret 0;
}

test parse_invocation__a_global_option_reads_as_given_to_its_command {
    var argv: [3]*u8           = [3]*u8{"mach", "--flag", "."};
    var inv:  ParsedInvocation = t_parse(3, ?argv[0]);
    if (inv.command != ?T_PROBE || sel inv.refusal.some)  { ret 1; }
    if (!given(?inv, ?T_FLAG) || inv.positional_idx != 2) { ret 2; }
    argv[1] = "--other";
    var other: ParsedInvocation = t_parse(3, ?argv[0]);
    if (other.command != nil) { ret 3; }
    ret 0;
}

# an unknown selector value naming a path in the working directory is restated as an
# unquoted wildcard the shell expanded; a value naming no path keeps its refusal
test selection_hint__a_value_naming_a_path_is_an_unquoted_wildcard {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var on_disk: manifest.Selectors = manifest.t_selectors("", "/", "");
    val unknown: fail.Fail          = fail.user(diagnostic_kind.SELECTION_UNKNOWN, "mach.toml: no target named '/' (declared: lin)");
    val hinted:  fail.Fail          = selection_hint(?alloc, ?on_disk, unknown);
    if (fail.kind_of(hinted) != diagnostic_kind.CLI_FLAG_VALUE || !str_contains(fail.describe(hinted), "quote the pattern, as in -t '*'")) { ret 2; }
    var absent: manifest.Selectors = manifest.t_selectors("", "no-such-path-here", "");
    val plain:  fail.Fail          = fail.user(diagnostic_kind.SELECTION_UNKNOWN, "mach.toml: no target named 'no-such-path-here' (declared: lin)");
    if (fail.kind_of(selection_hint(?alloc, ?absent, plain)) != diagnostic_kind.SELECTION_UNKNOWN) { ret 3; }
    ret 0;
}
