val STACK_RESERVE: std_args.FlagSpec = std_args.FlagSpec{name: "--stack-reserve", value: "bytes", arity: std_args.ARITY_VALUE, doc: "set the stack an entry build's image reserves, an integer", default: "the system's", negatable: false, occurs: std_args.Occurs.once{}, alias_of: nil};
# `--stack-commit <bytes>`
val STACK_COMMIT: std_args.FlagSpec = std_args.FlagSpec{name: "--stack-commit", value: "bytes", arity: std_args.ARITY_VALUE, doc: "set the stack an entry build's image commits at start, an integer", default: "the system's", negatable: false, occurs: std_args.Occurs.once{}, alias_of: nil};

# one target key a flag states: the row, the `[target]` key it writes, and whether the key
# takes an integer
rec TargetKey {
    row:     *std_args.FlagSpec;
    key:     str;
    integer: bool;
}

# row count of TARGET_KEYS
val TARGET_KEYS_N: usize = 12;
# every `[target]` key an entry build's command line states, but `runner`, which run and
# test replace with `--runner`
val TARGET_KEYS: [TARGET_KEYS_N]TargetKey = [TARGET_KEYS_N]TargetKey{
    TargetKey{row: ?ARCH, key: "arch", integer: false},
    TargetKey{row: ?SYS, key: "sys", integer: false},
    TargetKey{row: ?ABI, key: "abi", integer: false},
    TargetKey{row: ?OF, key: "of", integer: false},
    TargetKey{row: ?PLATFORM, key: "platform", integer: false},
    TargetKey{row: ?ENV, key: "env", integer: false},
    TargetKey{row: ?ISA, key: "isa", integer: false},
    TargetKey{row: ?EXT, key: "ext", integer: false},
    TargetKey{row: ?CODE_MODEL, key: "code_model", integer: false},
    TargetKey{row: ?BASE, key: "base", integer: true},
    TargetKey{row: ?STACK_RESERVE, key: "stack_reserve", integer: true},
    TargetKey{row: ?STACK_COMMIT, key: "stack_commit", integer: true},
};

# row count of TARGET_FLAGS
pub val TARGET_FLAGS_N: usize = TARGET_KEYS_N;
# the target keys as flags, consumed by build
pub val TARGET_FLAGS: [TARGET_FLAGS_N]*std_args.FlagSpec = [TARGET_FLAGS_N]*std_args.FlagSpec{?ARCH, ?SYS, ?ABI, ?OF, ?PLATFORM, ?ENV, ?ISA, ?EXT, ?CODE_MODEL, ?BASE, ?STACK_RESERVE, ?STACK_COMMIT};

# `-w <path>`, the work directory
val WORK: std_args.FlagSpec = std_args.FlagSpec{name: "-w", value: "path", arity: std_args.ARITY_VALUE, doc: "set the work directory, which [project].work names", default: "", negatable: false, occurs: std_args.Occurs.once{}, alias_of: nil};

# row count of WORKDIR
pub val WORKDIR_N: usize = 1;
# `-w`, consumed by build and test
pub val WORKDIR: [WORKDIR_N]*std_args.FlagSpec = [WORKDIR_N]*std_args.FlagSpec{?WORK};

# row count of REMOVED
pub val REMOVED_N: usize = 8;
# the options a previous major took, each refused by name with what to write instead
pub val REMOVED: [REMOVED_N]std_args.Removed = [REMOVED_N]std_args.Removed{
    std_args.Removed{name: "-g", use: "-d or --debug"},
    std_args.Removed{name: "-O0", use: "--no-optimize"},
    std_args.Removed{name: "-O2", use: "-O or --optimize"},
    std_args.Removed{name: "--emit-asm", use: "-e asm"},
    std_args.Removed{name: "--emit-ir", use: "-e ir"},
    std_args.Removed{name: "--jobs", use: "--threads"},
    std_args.Removed{name: "--pie", use: "the target's system, which sets the executable kind a build links, and so position independence"},
    std_args.Removed{name: "--simd", use: "no option in its place: mirl legalizes every vector operation, so a build has no vector mode to choose"},
};

# `--emit <kind>`, once per product
pub val EMIT: std_args.FlagSpec = std_args.FlagSpec{name: "--emit", value: "asm|ir|obj|exe", arity: std_args.ARITY_VALUE, doc: EMIT_HELP, default: "exe", negatable: false, occurs: std_args.Occurs.collect{}, alias_of: nil};
# `-e`, the alias of `--emit`
val EMIT_SHORT: std_args.FlagSpec = std_args.FlagSpec{name: "-e", value: "asm|ir|obj|exe", arity: std_args.ARITY_VALUE, doc: EMIT_HELP, default: "", negatable: false, occurs: std_args.Occurs.collect{}, alias_of: ?EMIT};

# row count of EMITS
pub val EMITS_N: usize = 2;
# `--emit` and `-e`, consumed by build
pub val EMITS: [EMITS_N]*std_args.FlagSpec = [EMITS_N]*std_args.FlagSpec{?EMIT, ?EMIT_SHORT};

# `--threads <n>`
val THREADS: std_args.FlagSpec = std_args.FlagSpec{name: "--threads", value: "n", arity: std_args.ARITY_VALUE, doc: "set codegen worker threads; 1 serialises", default: "host CPUs", negatable: false, occurs: std_args.Occurs.once{}, alias_of: nil};

# row count of WORKERS
pub val WORKERS_N: usize = 1;
# `--threads`, consumed by build and test
