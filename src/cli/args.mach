# `-L <dir>`
val LIB_DIR: std_args.FlagSpec = std_args.FlagSpec{name: "-L", value: "dir", arity: std_args.ARITY_VALUE, doc: "add a search directory for -l inputs", default: "", negatable: false, occurs: std_args.Occurs.collect{}, alias_of: nil};
# `-l <name>`
pub val LIB: std_args.FlagSpec = std_args.FlagSpec{name: "-l", value: "name", arity: std_args.ARITY_VALUE, doc: "link a named object, archive, or shared library", default: "", negatable: false, occurs: std_args.Occurs.collect{}, alias_of: nil};

# row count of LINKIN
