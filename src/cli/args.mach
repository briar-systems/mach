# one dep action record as DEP_ACTIONS declares it; help renders every field
# ---
# name: the action word after `dep`
# alias_of: the canonical action this one is an alias of, which must itself be canonical; empty for a canonical action
# id: the DepAction value
# grammar: the argument grammar help appends after the action name, leading space included
# effect: one-sentence description
# exits: exit-code description
# tables: the action's own option tables, searched after DEP_SCHEMA; nil when table_n is 0
# table_n: length of tables
# constraints: constraint sentences for help; nil when constraint_n is 0
# constraint_n: length of constraints
# examples: example lines for help; nil when example_n is 0
# example_n: length of examples
pub rec DepActionSpec {
    name:       str;
    alias_of:   str;
    id:         DepAction;
    grammar:    str;
    effect:     str;
    exits:      str;
    tables:     *TableRef;
    table_n:    usize;
    constraints: *str;
    constraint_n: usize;
    examples:   *str;
    example_n:  usize;
}

# the seven dep action records: list, add, remove, update, pull, sync (alias
# of pull), verify. Indexed by search, not by DepAction
pub val DEP_ACTIONS: [DEPACT_N]DepActionSpec = [DEPACT_N]DepActionSpec{
    DepActionSpec{ name: "list", alias_of: "", id: DEPACT_LIST, grammar: "", effect: "list declared dependencies and their state", exits: "0 success, 1 user error, 2 internal error", tables: nil, table_n: 0, constraints: nil, constraint_n: 0, examples: nil, example_n: 0 },
    DepActionSpec{ name: "add", alias_of: "", id: DEPACT_ADD, grammar: " <name> (--git <url> [--ref <ref>] | --path <dir>)", effect: "declare a dependency and realize the dependency tree", exits: "0 success, 1 user error, 2 internal error", tables: ?DEP_ADD_SCHEMA[0], table_n: DEP_ADD_SCHEMA_N, constraints: ?DEP_ADD_CONSTRAINT[0], constraint_n: DEP_ADD_CONSTRAINT_N, examples: nil, example_n: 0 },
    DepActionSpec{ name: "remove", alias_of: "", id: DEPACT_REMOVE, grammar: " <name> [--purge]", effect: "remove a dependency declaration and optionally its directory", exits: "0 success, 1 user error, 2 internal error", tables: ?DEP_REMOVE_SCHEMA[0], table_n: DEP_REMOVE_SCHEMA_N, constraints: nil, constraint_n: 0, examples: nil, example_n: 0 },
    DepActionSpec{ name: "update", alias_of: "", id: DEPACT_UPDATE, grammar: " (<name> | --all)", effect: "advance branch references to current remote tips", exits: "0 success, 1 user error, 2 internal error", tables: ?DEP_UPDATE_SCHEMA[0], table_n: DEP_UPDATE_SCHEMA_N, constraints: ?DEP_UPDATE_CONSTRAINT[0], constraint_n: DEP_UPDATE_CONSTRAINT_N, examples: nil, example_n: 0 },
    DepActionSpec{ name: "pull", alias_of: "", id: DEPACT_PULL, grammar: " [<path>]", effect: "realize the committed dependency closure without changing anything", exits: "0 success, 1 user error, 2 internal error", tables: nil, table_n: 0, constraints: nil, constraint_n: 0, examples: nil, example_n: 0 },
    DepActionSpec{ name: "sync", alias_of: "pull", id: DEPACT_SYNC, grammar: " [<path>]", effect: "deprecated alias for dep pull", exits: "0 success, 1 user error, 2 internal error", tables: nil, table_n: 0, constraints: nil, constraint_n: 0, examples: nil, example_n: 0 },
    DepActionSpec{ name: "verify", alias_of: "", id: DEPACT_VERIFY, grammar: " [<path>]", effect: "check the realized dependency closure against the manifest without changing anything", exits: "0 success, 1 user error, 2 internal error", tables: nil, table_n: 0, constraints: nil, constraint_n: 0, examples: nil, example_n: 0 },
};

# length of BUILD_CONSTRAINT
pub val BUILD_CONSTRAINT_N: usize = 3;
# the constraint sentences help prints for build; the first is enforced by
# build_cli_invocation, the second by selection_from_config, the third by the
# build command
pub val BUILD_CONSTRAINT: [BUILD_CONSTRAINT_N]str = [BUILD_CONSTRAINT_N]str{
    "-v and -vv cannot be combined with --quiet or -q",
    "--bin and --lib cannot be combined",
    "--explain cannot be combined with --quiet or -q",
};

# length of TEST_CONSTRAINT
pub val TEST_CONSTRAINT_N: usize = 2;
# the constraint sentences help prints for test; enforced by
# build_cli_invocation and selection_from_config
pub val TEST_CONSTRAINT: [TEST_CONSTRAINT_N]str = [TEST_CONSTRAINT_N]str{
    "-v and -vv cannot be combined with --quiet or -q",
    "--bin and --lib cannot be combined",
};

# length of INFO_CONSTRAINT
pub val INFO_CONSTRAINT_N: usize = 1;
# the constraint sentence help prints for info; the info command enforces it, this module does not
pub val INFO_CONSTRAINT: [INFO_CONSTRAINT_N]str = [INFO_CONSTRAINT_N]str{
    "--version and targets cannot be combined",
};

# one command record as COMMANDS declares it; parse_invocation reads
# pos_start, truncate_at_sep, has_action, and tables, help renders the rest
# ---
# name: the command word at argv[1]
# aliases: alternative command words; nil when alias_n is 0
# alias_n: length of aliases
# id: the CommandId value
# grammar: the argument grammar help appends after the name, leading space included
# summary: one-line description for the overview
# effect: one-sentence description for the command page
# exits: exit-code description
# terminator: help text for what follows `--`; empty when the command has none
# tables: the option tables the command accepts; nil when table_n is 0
# table_n: length of tables
# constraints: constraint sentences for help; nil when constraint_n is 0
# constraint_n: length of constraints
# pos_start: first argv index parse_invocation scans: 2 after the command word, 3 after a dep action word
# truncate_at_sep: stop scanning at the first `--`, so later tokens are neither options nor positionals
# has_action: argv[2] names a DepAction
# examples: example lines for help; nil when example_n is 0
# example_n: length of examples
pub rec CommandSpec {
    name:             str;
    aliases:          *str;
    alias_n:          usize;
    id:               CommandId;
    grammar:          str;
    summary:          str;
    effect:           str;
    exits:            str;
    terminator:       str;
    tables:           *TableRef;
    table_n:          usize;
    constraints:      *str;
    constraint_n:     usize;
    pos_start:        usize;
    truncate_at_sep:  bool;
    has_action:       bool;
    examples:         *str;
    example_n:        usize;
}

# the nine command records in help order: build, run, test, clean, dep, init,
# doc, info, help. Indexed by search, not by CommandId
pub val COMMANDS: [CMD_N]CommandSpec = [CMD_N]CommandSpec{
    CommandSpec{ name: "build", aliases: nil, alias_n: 0, id: CMD_BUILD, grammar: " <path> [options] [inputs...]", summary: "compile a project", effect: "compile selected project artifacts and produce the requested object or linked outputs", exits: "0 success, 1 user error, 2 internal error", terminator: "", tables: ?BUILD_SCHEMA[0], table_n: BUILD_SCHEMA_N, constraints: ?BUILD_CONSTRAINT[0], constraint_n: BUILD_CONSTRAINT_N, pos_start: 2, truncate_at_sep: false, has_action: false, examples: nil, example_n: 0 },
    CommandSpec{ name: "run", aliases: nil, alias_n: 0, id: CMD_RUN, grammar: " <path> [options] [-- args...]", summary: "execute a built project artifact", effect: "resolve an existing built executable and run it without rebuilding", exits: "the program exit code, 1 user error, 2 internal error, 3 the run exceeded --timeout_seconds", terminator: "arguments after -- are forwarded to the program", tables: ?RUN_SCHEMA[0], table_n: RUN_SCHEMA_N, constraints: nil, constraint_n: 0, pos_start: 2, truncate_at_sep: true, has_action: false, examples: nil, example_n: 0 },
    CommandSpec{ name: "test", aliases: nil, alias_n: 0, id: CMD_TEST, grammar: " <path> [options]", summary: "build and run project tests", effect: "build one test dispatcher and run each selected test in its own process", exits: "0 all passed, 1 failed or user error, 2 internal error", terminator: "", tables: ?TEST_SCHEMA[0], table_n: TEST_SCHEMA_N, constraints: ?TEST_CONSTRAINT[0], constraint_n: TEST_CONSTRAINT_N, pos_start: 2, truncate_at_sep: false, has_action: false, examples: nil, example_n: 0 },
    CommandSpec{ name: "clean", aliases: nil, alias_n: 0, id: CMD_CLEAN, grammar: " <path>", summary: "remove project build output", effect: "remove the output, object, IR, and assembly trees declared by the manifest", exits: "0 success, 1 user error, 2 I/O or internal error", terminator: "", tables: nil, table_n: 0, constraints: nil, constraint_n: 0, pos_start: 2, truncate_at_sep: false, has_action: false, examples: nil, example_n: 0 },
    CommandSpec{ name: "dep", aliases: nil, alias_n: 0, id: CMD_DEP, grammar: " <action> [args] [options]", summary: "manage project dependencies", effect: "inspect or mutate the project dependency tree according to the selected action", exits: "0 success, 1 user error, 2 internal error", terminator: "", tables: ?DEP_SCHEMA[0], table_n: DEP_SCHEMA_N, constraints: nil, constraint_n: 0, pos_start: 3, truncate_at_sep: false, has_action: true, examples: nil, example_n: 0 },
    CommandSpec{ name: "init", aliases: nil, alias_n: 0, id: CMD_INIT, grammar: " [dir] [options]", summary: "scaffold a new project", effect: "create a binary or library project in the selected directory", exits: "0 success, 1 user error, 2 internal error, 3 environmental error", terminator: "", tables: ?INIT_SCHEMA[0], table_n: INIT_SCHEMA_N, constraints: nil, constraint_n: 0, pos_start: 2, truncate_at_sep: false, has_action: false, examples: nil, example_n: 0 },
    CommandSpec{ name: "doc", aliases: nil, alias_n: 0, id: CMD_DOC, grammar: " <path> [options]", summary: "generate reference documentation", effect: "write one Markdown page per module and an index under the selected output directory", exits: "0 success, 1 user error, 2 internal error", terminator: "", tables: ?DOC_SCHEMA[0], table_n: DOC_SCHEMA_N, constraints: nil, constraint_n: 0, pos_start: 2, truncate_at_sep: false, has_action: false, examples: nil, example_n: 0 },
    CommandSpec{ name: "info", aliases: nil, alias_n: 0, id: CMD_INFO, grammar: " [--version | targets]", summary: "show compiler version and capabilities", effect: "print stable line-oriented compiler or target capability information", exits: "0 success, 1 user error, 2 internal error", terminator: "", tables: ?INFO_SCHEMA[0], table_n: INFO_SCHEMA_N, constraints: ?INFO_CONSTRAINT[0], constraint_n: INFO_CONSTRAINT_N, pos_start: 2, truncate_at_sep: false, has_action: false, examples: nil, example_n: 0 },
    CommandSpec{ name: "help", aliases: nil, alias_n: 0, id: CMD_HELP, grammar: " [command]", summary: "show command help", effect: "render the overview or one canonical command page without product effects", exits: "0 success, 1 malformed route, 2 internal error", terminator: "", tables: nil, table_n: 0, constraints: nil, constraint_n: 0, pos_start: 2, truncate_at_sep: false, has_action: false, examples: nil, example_n: 0 },
};

# the CommandId whose record has name as its name or one of its aliases
# ---
# name: a command word
# ret: some id, or none when no record matches
pub fun command_lookup(name: str) O.Option[CommandId] {
    var i: usize = 0;
    for (i < CMD_N) {
        if (str_equals(COMMANDS[i].name, name)) { ret O.some[CommandId](COMMANDS[i].id); }
        var j: usize = 0;
        for (j < COMMANDS[i].alias_n) {
            if (str_equals(COMMANDS[i].aliases[j], name)) { ret O.some[CommandId](COMMANDS[i].id); }
            j = j + 1;
        }
        i = i + 1;
    }
    ret O.none[CommandId]();
}

# the COMMANDS record carrying id
# ---
# id: a CommandId
# ret: the record, or nil when no record carries id (CMD_NONE always)
pub fun command_spec(id: CommandId) *CommandSpec {
    var i: usize = 0;
    for (i < CMD_N) {
        if (COMMANDS[i].id == id) { ret ?COMMANDS[i]; }
        i = i + 1;
    }
    ret nil;
}

# the DepAction whose record has name as its name; aliases are separate records with their own name
# ---
# name: an action word
# ret: some action, or none when no record matches
pub fun dep_action_lookup(name: str) O.Option[DepAction] {
    var i: usize = 0;
    for (i < DEPACT_N) {
        if (str_equals(DEP_ACTIONS[i].name, name)) { ret O.some[DepAction](DEP_ACTIONS[i].id); }
        i = i + 1;
    }
    ret O.none[DepAction]();
}

# the DEP_ACTIONS record carrying id
# ---
# id: a DepAction
# ret: the record, or nil when no record carries id (DEPACT_NONE always)
pub fun dep_action_spec(id: DepAction) *DepActionSpec {
    var i: usize = 0;
    for (i < DEPACT_N) {
        if (DEP_ACTIONS[i].id == id) { ret ?DEP_ACTIONS[i]; }
        i = i + 1;
    }
    ret nil;
}

# the option tables a command and action accept. All four outputs are zeroed
# first; an unknown id leaves them zeroed, and extra is filled only when the
# command has actions, action is not DEPACT_NONE, and action has a record
# ---
# id: the command
# action: the dep action, or DEPACT_NONE
# out: receives the command's tables
# out_n: receives the length of out
# extra: receives the action's own tables
# extra_n: receives the length of extra
pub fun schema_for(id: CommandId, action: DepAction, out: **TableRef, out_n: *usize, extra: **TableRef, extra_n: *usize) {
    @out = nil; @out_n = 0; @extra = nil; @extra_n = 0;
    val command: *CommandSpec = command_spec(id);
    if (command == nil) { ret; }
    @out = command.tables;
    @out_n = command.table_n;
    if (command.has_action && action != DEPACT_NONE) {
        val action_spec: *DepActionSpec = dep_action_spec(action);
        if (action_spec == nil) { ret; }
        @extra = action_spec.tables;
        @extra_n = action_spec.table_n;
    }
}

pub fun table_accepts(t: *TableRef, j: usize) bool {
    ret t.accepted == nil || t.accepted[j];
}

fun table_set_valid(tables: *TableRef, table_n: usize) bool {
    if (table_n == 0) { ret tables == nil; }
    if (tables == nil) { ret false; }
    var i: usize = 0;
    for (i < table_n) {
        val table: TableRef = tables[i];
        if (table.table == nil || table.n == 0) { ret false; }
        var j: usize = 0;
        for (j < table.n) {
            if (str_len(table.table[j].name) == 0 || str_len(table.table[j].doc) == 0) { ret false; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret true;
}

fun spelling_count(tables: *TableRef, table_n: usize, extra: *TableRef, extra_n: usize, name: str) usize {
    var count: usize = 0;
    var i: usize = 0;
    for (i < table_n) {
        var j: usize = 0;
        for (j < tables[i].n) {
            if (table_accepts(?tables[i], j) && str_equals(tables[i].table[j].name, name)) { count = count + 1; }
            j = j + 1;
        }
        i = i + 1;
    }
    i = 0;
    for (i < extra_n) {
        var j: usize = 0;
        for (j < extra[i].n) {
            if (table_accepts(?extra[i], j) && str_equals(extra[i].table[j].name, name)) { count = count + 1; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret count;
}

fun flag_aliases_valid(tables: *TableRef, table_n: usize, extra: *TableRef, extra_n: usize) bool {
    var group: usize = 0;
    for (group < 2) {
        var current: *TableRef = tables;
        var current_n: usize = table_n;
        if (group == 1) { current = extra; current_n = extra_n; }
        var i: usize = 0;
        for (i < current_n) {
            var j: usize = 0;
            for (j < current[i].n) {
                if (!table_accepts(?current[i], j)) { j = j + 1; cnt; }
                val flag: *FlagSpec = ?current[i].table[j];
                if (spelling_count(tables, table_n, extra, extra_n, flag.name) != 1) { ret false; }
                if (str_len(flag.alias_of) > 0
                    && spelling_count(tables, table_n, extra, extra_n, flag.alias_of) != 1) { ret false; }
                j = j + 1;
            }
            i = i + 1;
        }
        group = group + 1;
    }
    ret true;
}

fun command_record_valid(command: *CommandSpec) bool {
    if (str_len(command.name) == 0 || str_len(command.summary) == 0
        || str_len(command.effect) == 0 || str_len(command.exits) == 0) { ret false; }
    if ((command.alias_n == 0) != (command.aliases == nil)) { ret false; }
    if ((command.table_n == 0) != (command.tables == nil)) { ret false; }
    if ((command.constraint_n == 0) != (command.constraints == nil)) { ret false; }
    if ((command.example_n == 0) != (command.examples == nil)) { ret false; }
    ret table_set_valid(command.tables, command.table_n);
}

fun action_record_valid(action: *DepActionSpec) bool {
    if (str_len(action.name) == 0 || str_len(action.effect) == 0 || str_len(action.exits) == 0) { ret false; }
    if ((action.table_n == 0) != (action.tables == nil)) { ret false; }
    if ((action.constraint_n == 0) != (action.constraints == nil)) { ret false; }
    if ((action.example_n == 0) != (action.examples == nil)) { ret false; }
    ret table_set_valid(action.tables, action.table_n);
}

# whether COMMANDS and DEP_ACTIONS are well formed: every record has a name,
# summary or effect, and exits; each count field is zero exactly when its
# pointer is nil; every option row has a name and doc; ids and names are
# unique; every alias resolves to its own record and collides with no name
# or other alias; every option spelling and every alias_of target occurs
# exactly once across a command's tables, and across the dep tables joined
# with each action's tables; the dep record has has_action; an action's
# alias_of names a canonical action. help refuses to render when this is
# false
# ---
# ret: true when every check passes
pub fun schema_valid() bool {
    var i: usize = 0;
    for (i < CMD_N) {
        val command: *CommandSpec = ?COMMANDS[i];
        if (!command_record_valid(command)) { ret false; }
        val lookup: O.Option[CommandId] = command_lookup(command.name);
        if (O.is_none[CommandId](lookup) || O.unwrap[CommandId](lookup) != command.id) { ret false; }
        var j: usize = i + 1;
        for (j < CMD_N) {
            if (command.id == COMMANDS[j].id || str_equals(command.name, COMMANDS[j].name)) { ret false; }
            j = j + 1;
        }
        var ai: usize = 0;
        for (ai < command.alias_n) {
            if (str_len(command.aliases[ai]) == 0) { ret false; }
            val alias_lookup: O.Option[CommandId] = command_lookup(command.aliases[ai]);
            if (O.is_none[CommandId](alias_lookup) || O.unwrap[CommandId](alias_lookup) != command.id) { ret false; }
            var ci: usize = 0;
            for (ci < CMD_N) {
                if (str_equals(command.aliases[ai], COMMANDS[ci].name)) { ret false; }
                var aj: usize = 0;
                for (aj < COMMANDS[ci].alias_n) {
                    if ((ci != i || aj != ai) && str_equals(command.aliases[ai], COMMANDS[ci].aliases[aj])) { ret false; }
                    aj = aj + 1;
                }
                ci = ci + 1;
            }
            ai = ai + 1;
        }
        if (!flag_aliases_valid(command.tables, command.table_n, nil, 0)) { ret false; }
        i = i + 1;
    }

    val dep_command: *CommandSpec = command_spec(CMD_DEP);
    if (dep_command == nil || !dep_command.has_action) { ret false; }
    i = 0;
    for (i < DEPACT_N) {
        val action: *DepActionSpec = ?DEP_ACTIONS[i];
        if (!action_record_valid(action)) { ret false; }
        val lookup: O.Option[DepAction] = dep_action_lookup(action.name);
        if (O.is_none[DepAction](lookup) || O.unwrap[DepAction](lookup) != action.id) { ret false; }
        var j: usize = i + 1;
        for (j < DEPACT_N) {
            if (action.id == DEP_ACTIONS[j].id || str_equals(action.name, DEP_ACTIONS[j].name)) { ret false; }
            j = j + 1;
        }
        if (str_len(action.alias_of) > 0) {
            val target: O.Option[DepAction] = dep_action_lookup(action.alias_of);
            if (O.is_none[DepAction](target) || O.unwrap[DepAction](target) == action.id) { ret false; }
            val target_spec: *DepActionSpec = dep_action_spec(O.unwrap[DepAction](target));
            if (target_spec == nil || str_len(target_spec.alias_of) > 0) { ret false; }
        }
        if (!flag_aliases_valid(dep_command.tables, dep_command.table_n, action.tables, action.table_n)) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the result of looking one argv token up in a schema
# ---
# found: the token names an option of the schema
# arity: ARITY_VALUE when the row has a value placeholder, else ARITY_FLAG; ARITY_FLAG when not found
# key: the row's SemanticKey; 0 when not found
pub rec SchemaHit {
    found: bool;
    arity: OptionArity;
    key:   SemanticKey;
}

fun scan_tables(tabs: *TableRef, tabn: usize, key_base: u32, tok: str, hit: *SchemaHit) bool {
    var i: usize = 0;
    for (i < tabn) {
        val tr: TableRef = tabs[i];
        var j: usize = 0;
        for (j < tr.n) {
            if (!table_accepts(?tr, j)) { j = j + 1; cnt; }
            if (str_equals(tr.table[j].name, tok)) {
                hit.found = true;
                hit.arity = ARITY_FLAG;
                if (str_len(tr.table[j].value) > 0) { hit.arity = ARITY_VALUE; }
                hit.key = key_base + (i::u32 * 100) + j::u32;
                ret true;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    ret false;
}

# look tok up in the tables of id and action, the command's own tables before
# the action's
# ---
# id: the command
# action: the dep action, or DEPACT_NONE to search the command's tables only
# tok: an argv token
# ret: the hit; found false with arity ARITY_FLAG and key 0 when tok is not an option there
pub fun schema_lookup(id: CommandId, action: DepAction, tok: str) SchemaHit {
    var hit: SchemaHit;
    hit.found = false; hit.arity = ARITY_FLAG; hit.key = 0::SemanticKey;

    var tabs: *TableRef = nil; var tabn: usize = 0;
    var ext:  *TableRef = nil; var extn: usize = 0;
    schema_for(id, action, ?tabs, ?tabn, ?ext, ?extn);

    val base: u32 = id::u32 * 1000;
    if (scan_tables(tabs, tabn, base, tok, ?hit)) { ret hit; }
    scan_tables(ext, extn, base + 500, tok, ?hit);
    ret hit;
}

# one recognized option in argv
# ---
# key: the row's SemanticKey
# idx: argv index of the option token
# has_value: a value token followed within the scanned range
# value_idx: argv index of the value token, or idx when has_value is false
pub rec Occurrence {
    key:       SemanticKey;
    idx:       usize;
    has_value: bool;
    value_idx: usize;
}

# argv classified against the command schema by parse_invocation. The three
# arrays are argc long and owned by the invocation; dnit_invocation frees
# them
# ---
# argc: length of argv
# command: the recognized command, or CMD_NONE
# has_command: argv[1] named a command
# action: the recognized dep action, or DEPACT_NONE
# has_action: argv[2] named a dep action
# sep_idx: index of the first `--` when the command truncates there, else argc
# marks: true at every recognized option token and its value token; nil when parsing stopped before scanning
# occ: recognized options in argv order; nil when parsing stopped before scanning
# occ_len: length of occ in use
# positional_idx: argv index of the first positional, or argc when none
# positional_count: number of positionals
# positional_idxs: argv indices of the positionals in order; nil when parsing stopped before scanning
# has_positional: at least one positional
# unknown_idx: argv index of the first unrecognized token that starts with `-`, or argc when none
# has_unknown: at least one unrecognized flag-shaped token
pub rec ParsedInvocation {
    argc:           usize;
    command:        CommandId;
    has_command:    bool;
    action:         DepAction;
    has_action:     bool;
    sep_idx:        usize;
    marks:          *bool;
    occ:            *Occurrence;
    occ_len:        usize;
    positional_idx: usize;
    positional_count: usize;
    positional_idxs: *usize;
    has_positional: bool;
    unknown_idx:    usize;
    has_unknown:    bool;
}

# free the arrays parse_invocation allocated; nil arrays are skipped
# ---
# a: the allocator parse_invocation was given
# inv: the invocation
pub fun dnit_invocation(a: *A.Allocator, inv: *ParsedInvocation) {
    if (inv.marks != nil)           { A.deallocate[bool](a, inv.marks, inv.argc); }
    if (inv.occ   != nil)           { A.deallocate[Occurrence](a, inv.occ, inv.argc); }
    if (inv.positional_idxs != nil) { A.deallocate[usize](a, inv.positional_idxs, inv.argc); }
}

# classify argv against the command schema: recognize the command at argv[1]
# and, for dep, the action at argv[2], then scan from the command's pos_start
# to the end or to the first `--` when the command truncates there. A
# recognized value option claims the next token as its value when one is
# in range. Every other token starting with `-` is unknown; the rest are
# positionals. `-O1` is not in any table and so parses as unknown
# ---
# a: allocator for the invocation's three arrays
# argc: length of argv
# argv: the argument vector, program name at argv[0]
# ret: the invocation. argc below 2, an unrecognized command word, or an unrecognized dep action word return early with has_command or has_action false and every array nil. err on allocation failure, or when the command has no record
pub fun parse_invocation(a: *A.Allocator, argc: usize, argv: **u8) R.Result[ParsedInvocation, str] {
    var inv: ParsedInvocation;
    inv.argc           = argc;
    inv.command        = CMD_NONE;
    inv.has_command     = false;
    inv.action          = DEPACT_NONE;
    inv.has_action       = false;
    inv.sep_idx         = argc;
    inv.marks           = nil;
    inv.occ             = nil;
    inv.occ_len         = 0;
    inv.positional_idx  = argc;
    inv.positional_count = 0;
    inv.positional_idxs = nil;
    inv.has_positional   = false;
    inv.unknown_idx     = argc;
    inv.has_unknown      = false;

    if (argc < 2) { ret R.ok[ParsedInvocation, str](inv); }

    val cmd_o: O.Option[CommandId] = command_lookup(argv[1]::str);
    if (O.is_none[CommandId](cmd_o)) { ret R.ok[ParsedInvocation, str](inv); }
    inv.command     = O.unwrap[CommandId](cmd_o);
    inv.has_command = true;

    val spec: *CommandSpec = command_spec(inv.command);
    if (spec == nil) { ret R.err[ParsedInvocation, str]("cli schema: unreachable command spec"); }

    val scan_start: usize = spec.pos_start;
    if (spec.has_action) {
        if (argc < 3) { ret R.ok[ParsedInvocation, str](inv); }
        val act_o: O.Option[DepAction] = dep_action_lookup(argv[2]::str);
        if (O.is_none[DepAction](act_o)) { ret R.ok[ParsedInvocation, str](inv); }
        inv.action     = O.unwrap[DepAction](act_o);
        inv.has_action = true;
    }

    var bound: usize = argc;
    if (spec.truncate_at_sep) { bound = util.arg_separator_index(argc, argv); }
    inv.sep_idx = bound;

    val rm: R.Result[*bool, str] = A.allocate[bool](a, argc);
    if (R.is_err[*bool, str](rm)) { ret R.err[ParsedInvocation, str](R.unwrap_err[*bool, str](rm)); }
    val marks: *bool = R.unwrap_ok[*bool, str](rm);
    var mi: usize = 0;
    for (mi < argc) { marks[mi] = false; mi = mi + 1; }
    inv.marks = marks;

    val ro: R.Result[*Occurrence, str] = A.allocate[Occurrence](a, argc);
    if (R.is_err[*Occurrence, str](ro)) {
        A.deallocate[bool](a, marks, argc);
        inv.marks = nil;
        ret R.err[ParsedInvocation, str](R.unwrap_err[*Occurrence, str](ro));
    }
    val occ: *Occurrence = R.unwrap_ok[*Occurrence, str](ro);
    inv.occ = occ;

    val rp: R.Result[*usize, str] = A.allocate[usize](a, argc);
    if (R.is_err[*usize, str](rp)) {
        A.deallocate[Occurrence](a, occ, argc);
        A.deallocate[bool](a, marks, argc);
        inv.occ   = nil;
        inv.marks = nil;
        ret R.err[ParsedInvocation, str](R.unwrap_err[*usize, str](rp));
    }
    inv.positional_idxs = R.unwrap_ok[*usize, str](rp);

    var i: usize = scan_start;
    for (i < bound) {
        val hit: SchemaHit = schema_lookup(inv.command, inv.action, argv[i]::str);
        if (!hit.found) { i = i + 1; cnt; }

        marks[i] = true;
        occ[inv.occ_len].key       = hit.key;
        occ[inv.occ_len].idx       = i;
        occ[inv.occ_len].has_value = false;
        occ[inv.occ_len].value_idx = i;
        if (hit.arity == ARITY_VALUE && i + 1 < bound) {
            marks[i + 1]               = true;
            occ[inv.occ_len].has_value = true;
            occ[inv.occ_len].value_idx = i + 1;
            inv.occ_len = inv.occ_len + 1;
            i = i + 2;
            cnt;
        }
        inv.occ_len = inv.occ_len + 1;
        i = i + 1;
    }

    i = scan_start;
    for (i < bound) {
        if (marks[i]) { i = i + 1; cnt; }
        if (util.arg_is_flag(argv[i]::str)) {
            if (!inv.has_unknown) { inv.unknown_idx = i; inv.has_unknown = true; }
        }
        or {
            inv.positional_idxs[inv.positional_count] = i;
            if (!inv.has_positional) { inv.positional_idx = i; inv.has_positional = true; }
            inv.positional_count = inv.positional_count + 1;
        }
        i = i + 1;
    }

    ret R.ok[ParsedInvocation, str](inv);
}

fun occ_flag_hit(inv: *ParsedInvocation, hit: SchemaHit) bool {
    if (!hit.found) { ret false; }
    var i: usize = 0;
    for (i < inv.occ_len) {
        if (inv.occ[i].key == hit.key) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun occ_value_hit(inv: *ParsedInvocation, argv: **u8, hit: SchemaHit) O.Option[*u8] {
    if (!hit.found) { ret O.none[*u8](); }
    var i: usize = 0;
    for (i < inv.occ_len) {
        if (inv.occ[i].key == hit.key && inv.occ[i].has_value) { ret O.some[*u8](argv[inv.occ[i].value_idx]); }
        i = i + 1;
    }
    ret O.none[*u8]();
}

# whether flag occurred, looked up in cmd's own tables only, never an action's
# ---
# cmd: the command
# inv: the parsed invocation
# flag: the option spelling
# ret: true when some occurrence carries the flag's key
pub fun invocation_flag(cmd: CommandId, inv: *ParsedInvocation, flag: str) bool {
    ret occ_flag_hit(inv, schema_lookup(cmd, DEPACT_NONE, flag));
}

# the value of the first occurrence of flag that carried one, looked up in cmd's own tables only
# ---
# cmd: the command
# inv: the parsed invocation
# argv: the argument vector inv was parsed from
# flag: the option spelling
# ret: the value token, or none when the flag is unknown to cmd, absent, or occurred without a value
pub fun invocation_value(cmd: CommandId, inv: *ParsedInvocation, argv: **u8, flag: str) O.Option[*u8] {
    ret occ_value_hit(inv, argv, schema_lookup(cmd, DEPACT_NONE, flag));
}

# the typed request.CliArgs of a build-shaped command: verbosity 0, 1, or 2
# from `-v` and `-vv`, quiet from `--quiet` or `-q`, the CGEN flags, the SEL
# values and `--jobs` as raw argv pointers or nil, opt_set and opt_release
# from `-O0` and `-O2` with `-O0` winning when both occur, include_deps.
# link_tokens and lib_dirs are left empty for collect_link_inputs
# ---
# cmd: the command
# inv: the parsed invocation
# argv: the argument vector inv was parsed from
# ret: the arguments, or err when `-v` or `-vv` is combined with `--quiet` or `-q`
pub fun build_cli_invocation(cmd: CommandId, inv: *ParsedInvocation, argv: **u8) R.Result[request.CliArgs, str] {
    var c: request.CliArgs;

    var verbosity: u8 = 0;
    if (invocation_flag(cmd, inv, "-v"))  { verbosity = 1; }
    if (invocation_flag(cmd, inv, "-vv")) { verbosity = 2; }
    val quiet: bool = invocation_flag(cmd, inv, "--quiet") || invocation_flag(cmd, inv, "-q");
    if (verbosity > 0 && quiet) {
        ret R.err[request.CliArgs, str]("`-v`/`-vv` and `--quiet`/`-q` cannot be combined");
    }

    c.verbosity   = verbosity;
    c.quiet       = quiet;
    c.emit_asm    = invocation_flag(cmd, inv, "--emit-asm");
    c.emit_ir     = invocation_flag(cmd, inv, "--emit-ir");
    c.all_targets = invocation_flag(cmd, inv, "--all-targets");
    c.pie         = invocation_flag(cmd, inv, "--pie");
    c.g           = invocation_flag(cmd, inv, "-g");

    c.subsystem = O.unwrap_or[*u8](invocation_value(cmd, inv, argv, "--subsystem"), nil);
    c.target    = O.unwrap_or[*u8](invocation_value(cmd, inv, argv, "--target"), nil);
    c.output    = O.unwrap_or[*u8](invocation_value(cmd, inv, argv, "-o"), nil);
    c.profile   = O.unwrap_or[*u8](invocation_value(cmd, inv, argv, "--profile"), nil);
    c.bin       = O.unwrap_or[*u8](invocation_value(cmd, inv, argv, "--bin"), nil);
    c.lib       = O.unwrap_or[*u8](invocation_value(cmd, inv, argv, "--lib"), nil);

    c.opt_set     = false;
    c.opt_release = false;
    if (invocation_flag(cmd, inv, "-O0"))      { c.opt_set = true; c.opt_release = false; }
    or (invocation_flag(cmd, inv, "-O2"))      { c.opt_set = true; c.opt_release = true; }

    c.jobs         = O.unwrap_or[*u8](invocation_value(cmd, inv, argv, "--jobs"), nil);
    c.include_deps = invocation_flag(cmd, inv, "--include-deps");

    c.link_tokens.a    = nil;
    c.link_tokens.data = nil;
    c.link_tokens.len  = 0;
    c.link_tokens.cap  = 0;
    c.lib_dirs.a    = nil;
    c.lib_dirs.data = nil;
    c.lib_dirs.len  = 0;
    c.lib_dirs.cap  = 0;

    ret R.ok[request.CliArgs, str](c);
}

# fill c.link_tokens and c.lib_dirs in command-line order: every `-l` value and
# every bare positional after the first that request.is_object_path accepts go
# to link_tokens, every `-L` value to lib_dirs. Both vectors are reinitialised
# with a first
# ---
# a: allocator for the two vectors
# c: the arguments to fill
# cmd: the command
# inv: the parsed invocation
# argv: the argument vector inv was parsed from
# ret: ok, or err when a push fails
pub fun collect_link_inputs(a: *A.Allocator, c: *request.CliArgs, cmd: CommandId, inv: *ParsedInvocation, argv: **u8) R.Result[R.Void, str] {
    c.link_tokens = vector.init[*u8](a);
    c.lib_dirs    = vector.init[*u8](a);

    val l_hit: SchemaHit = schema_lookup(cmd, DEPACT_NONE, "-l");
    val L_hit: SchemaHit = schema_lookup(cmd, DEPACT_NONE, "-L");

    var oi: usize = 0;
    var pi: usize = 1;
    for (oi < inv.occ_len || pi < inv.positional_count) {
        if (oi < inv.occ_len) {
            val o: Occurrence = inv.occ[oi];
            val is_lib_dir:  bool = L_hit.found && o.key == L_hit.key;
            val is_link_tok: bool = l_hit.found && o.key == l_hit.key;
            if (!is_lib_dir && !is_link_tok) { oi = oi + 1; cnt; }
            if (pi < inv.positional_count && inv.positional_idxs[pi] < o.idx) {
                val tok: *u8 = argv[inv.positional_idxs[pi]];
                if (request.is_object_path(tok)) {
                    val pr: R.Result[usize, str] = vector.push[*u8](?c.link_tokens, tok);
                    if (R.is_err[usize, str](pr)) { ret R.err[R.Void, str](R.unwrap_err[usize, str](pr)); }
                }
                pi = pi + 1;
                cnt;
            }
            if (o.has_value) {
                if (is_lib_dir) {
                    val dr: R.Result[usize, str] = vector.push[*u8](?c.lib_dirs, argv[o.value_idx]);
                    if (R.is_err[usize, str](dr)) { ret R.err[R.Void, str](R.unwrap_err[usize, str](dr)); }
                }
                or {
                    val lr: R.Result[usize, str] = vector.push[*u8](?c.link_tokens, argv[o.value_idx]);
                    if (R.is_err[usize, str](lr)) { ret R.err[R.Void, str](R.unwrap_err[usize, str](lr)); }
                }
            }
            oi = oi + 1;
            cnt;
        }
        val tok: *u8 = argv[inv.positional_idxs[pi]];
        if (request.is_object_path(tok)) {
            val pr: R.Result[usize, str] = vector.push[*u8](?c.link_tokens, tok);
            if (R.is_err[usize, str](pr)) { ret R.err[R.Void, str](R.unwrap_err[usize, str](pr)); }
        }
        pi = pi + 1;
    }
    ret R.ok_void[str]();
}

fun profile_selection(config: *request.CliArgs) str {
    var profile_name: *u8 = config.profile;
    if (profile_name == nil) { profile_name = ""; }
    ret profile_name;
}

# derive the manifest Selection from CliArgs: profile, target, and artifact
# as strings that are empty when unset, want_lib when `--lib` was given,
# has_artifact when either `--bin` or `--lib` was
# ---
# config: the arguments
# out_sel: receives the selection
# ret: ok, or err when both `--bin` and `--lib` are set
pub fun selection_from_config(config: *request.CliArgs, out_sel: *manifest.Selection) R.Result[R.Void, str] {
    if (config.bin != nil && config.lib != nil) {
        ret R.err[R.Void, str]("--bin and --lib cannot be combined");
    }
    var target_name: *u8 = config.target;
    if (target_name == nil) { target_name = ""; }
    var artifact_name: *u8  = "";
    var want_lib:      bool = false;
    var has_artifact:  bool = false;
    if (config.bin != nil) { artifact_name = config.bin; has_artifact = true; }
    or (config.lib != nil) { artifact_name = config.lib; want_lib = true; has_artifact = true; }
    out_sel.profile      = profile_selection(config);
    out_sel.target       = target_name;
    out_sel.artifact     = artifact_name;
    out_sel.want_lib     = want_lib;
    out_sel.has_artifact = has_artifact;
    ret R.ok_void[str]();
}

test "mach.cli.config.parse:removed_flags_rejected" {
    var a:  [4]*u8;
    a[0] = "mach"; a[1] = "build"; a[3] = ".";

    var removed: [4]*u8;
    removed[0] = "--release"; removed[1] = "--no-emit-ir"; removed[2] = "--no-emit-asm";
    removed[3] = "-O1";
    var r: usize = 0;
    for (r < 4) {
        a[2] = removed[r];
        if (!ut_unknown_at(4, ?a[0], 2)) { ret 1; }
        r = r + 1;
    }

    var recognized: [2]*u8;
    recognized[0] = "--emit-ir"; recognized[1] = "-O2";
    var k: usize = 0;
    for (k < 2) {
        a[2] = recognized[k];
        if (!ut_unknown_at(4, ?a[0], 4)) { ret 1; }
        k = k + 1;
    }
    ret 0;
}

test "mach.cli.args.OPT:schema_has_two_rows_and_no_o1" {
    if (OPT_N != 2) { ret 1; }
    if (!str_equals(OPT[0].name, "-O0")) { ret 1; }
    if (!str_equals(OPT[1].name, "-O2")) { ret 1; }
    var i: usize = 0;
    for (i < OPT_N) {
        if (str_equals(OPT[i].name, "-O1")) { ret 1; }
        i = i + 1;
    }
    ret 0;
}

test "mach.cli.args.OPT_O1_REMOVED_ERROR:names_both_surviving_spellings" {
    if (!str_contains(OPT_O1_REMOVED_ERROR, "-O0")) { ret 1; }
    if (!str_contains(OPT_O1_REMOVED_ERROR, "-O2")) { ret 1; }
    if (!str_contains(OPT_O1_REMOVED_ERROR, "-O1")) { ret 1; }
    ret 0;
}

fun ut_build_cli(cmd: CommandId, argc: usize, argv: **u8) O.Option[request.CliArgs] {
    var backing: A.Allocator;
    if (O.is_some[str](page.make(?backing))) { ret O.none[request.CliArgs](); }
    val ir: R.Result[ParsedInvocation, str] = parse_invocation(?backing, argc, argv);
    if (R.is_err[ParsedInvocation, str](ir)) { ret O.none[request.CliArgs](); }
    var inv: ParsedInvocation = R.unwrap_ok[ParsedInvocation, str](ir);
    val cr: R.Result[request.CliArgs, str] = build_cli_invocation(cmd, ?inv, argv);
    if (R.is_err[request.CliArgs, str](cr)) { ret O.none[request.CliArgs](); }
    ret O.some[request.CliArgs](R.unwrap_ok[request.CliArgs, str](cr));
}

test "mach.cli.args.build_cli_invocation:o0_and_o2_set_release_boolean_o1_absent" {
    var a0: [4]*u8;
    a0[0] = "mach"; a0[1] = "build"; a0[2] = "-O0"; a0[3] = ".";
    val r0: O.Option[request.CliArgs] = ut_build_cli(CMD_BUILD, 4, ?a0[0]);
    if (O.is_none[request.CliArgs](r0)) { ret 1; }
    val c0: request.CliArgs = O.unwrap[request.CliArgs](r0);
    if (!c0.opt_set)    { ret 1; }
    if (c0.opt_release) { ret 1; }

    var a2: [4]*u8;
    a2[0] = "mach"; a2[1] = "build"; a2[2] = "-O2"; a2[3] = ".";
    val r2: O.Option[request.CliArgs] = ut_build_cli(CMD_BUILD, 4, ?a2[0]);
    if (O.is_none[request.CliArgs](r2)) { ret 1; }
    val c2: request.CliArgs = O.unwrap[request.CliArgs](r2);
    if (!c2.opt_set)     { ret 1; }
    if (!c2.opt_release) { ret 1; }

    var an: [3]*u8;
    an[0] = "mach"; an[1] = "build"; an[2] = ".";
    val rn: O.Option[request.CliArgs] = ut_build_cli(CMD_BUILD, 3, ?an[0]);
    if (O.is_none[request.CliArgs](rn)) { ret 1; }
    if (O.unwrap[request.CliArgs](rn).opt_set) { ret 1; }

    var a1: [4]*u8;
    a1[0] = "mach"; a1[1] = "build"; a1[2] = "-O1"; a1[3] = ".";
    val r1: O.Option[request.CliArgs] = ut_build_cli(CMD_BUILD, 4, ?a1[0]);
    if (O.is_none[request.CliArgs](r1)) { ret 1; }
    if (O.unwrap[request.CliArgs](r1).opt_set) { ret 1; }
    ret 0;
}

test "mach.cli.args.collect_link_inputs:preserves_command_line_order_across_flags_and_bare_paths" {
    var backing: A.Allocator;
    if (O.is_some[str](page.make(?backing))) { ret 1; }

    var a: [8]*u8;
    a[0] = "mach"; a[1] = "build"; a[2] = "."; a[3] = "one.o";
    a[4] = "-l"; a[5] = "two"; a[6] = "-L"; a[7] = "dir";
    val n: usize = 8;

    val ir: R.Result[ParsedInvocation, str] = parse_invocation(?backing, n, ?a[0]);
    if (R.is_err[ParsedInvocation, str](ir)) { ret 1; }
    var inv: ParsedInvocation = R.unwrap_ok[ParsedInvocation, str](ir);

    var c: request.CliArgs;
    if (R.is_err[R.Void, str](collect_link_inputs(?backing, ?c, CMD_BUILD, ?inv, ?a[0]))) { ret 1; }

    if (c.link_tokens.len != 2) { ret 1; }
    if (!str_equals(c.link_tokens.data[0]::str, "one.o")) { ret 1; }
    if (!str_equals(c.link_tokens.data[1]::str, "two"))   { ret 1; }
    if (c.lib_dirs.len != 1) { ret 1; }
    if (!str_equals(c.lib_dirs.data[0]::str, "dir")) { ret 1; }
    ret 0;
}

test "mach.cli.args.build_cli_invocation:quiet_reaches_the_typed_payload_for_test_not_only_build" {
    var q: [3]*u8;
    q[0] = "mach"; q[1] = "test"; q[2] = "--quiet";
    val rq: O.Option[request.CliArgs] = ut_build_cli(CMD_TEST, 3, ?q[0]);
    if (O.is_none[request.CliArgs](rq)) { ret 1; }
    if (!O.unwrap[request.CliArgs](rq).quiet) { ret 1; }

    var qs: [3]*u8;
    qs[0] = "mach"; qs[1] = "test"; qs[2] = "-q";
    val rqs: O.Option[request.CliArgs] = ut_build_cli(CMD_TEST, 3, ?qs[0]);
    if (O.is_none[request.CliArgs](rqs)) { ret 1; }
    if (!O.unwrap[request.CliArgs](rqs).quiet) { ret 1; }
    ret 0;
}

# the typed arguments of mach init
# ---
# has_dir: a positional directory was given
# dir_idx: argv index of that directory
# has_name: `--name` occurred with a value
# name_idx: argv index of the name value
# force: `--force`
# is_lib: `--lib`
# no_deps: `--no-deps`
# no_git: `--no-git`
# quiet: `--quiet` or `-q`
pub rec InitInvocation {
    has_dir:     bool;
    dir_idx:     usize;
    has_name:    bool;
    name_idx:    usize;
    force:       bool;
    is_lib:      bool;
    no_deps:     bool;
    no_git:      bool;
    quiet:       bool;
}

# read the init arguments out of a parsed invocation; the directory is the
# first positional
# ---
# inv: the parsed invocation
# argv: the argument vector inv was parsed from; not read
# ret: the arguments
pub fun build_init_invocation(inv: *ParsedInvocation, argv: **u8) InitInvocation {
    var r: InitInvocation;
    r.has_dir  = inv.has_positional;
    r.dir_idx  = inv.positional_idx;
    r.has_name = false;
    r.name_idx = 0;
    r.force    = invocation_flag(CMD_INIT, inv, "--force");
    r.is_lib   = invocation_flag(CMD_INIT, inv, "--lib");
    r.no_deps  = invocation_flag(CMD_INIT, inv, "--no-deps");
    r.no_git   = invocation_flag(CMD_INIT, inv, "--no-git");
    r.quiet    = invocation_flag(CMD_INIT, inv, "--quiet") || invocation_flag(CMD_INIT, inv, "-q");

    val name_hit: SchemaHit = schema_lookup(CMD_INIT, DEPACT_NONE, "--name");
    var i: usize = 0;
    for (i < inv.occ_len) {
        val o: Occurrence = inv.occ[i];
        if (o.key == name_hit.key && o.has_value) { r.has_name = true; r.name_idx = o.value_idx; }
        i = i + 1;
    }
    ret r;
}

fun ut_new_marks(argc: usize, argv: **u8) R.Result[*bool, str] {
    var backing: A.Allocator;
    if (O.is_some[str](page.make(?backing))) { ret R.err[*bool, str]("alloc"); }
    val ir: R.Result[ParsedInvocation, str] = parse_invocation(?backing, argc, argv);
    if (R.is_err[ParsedInvocation, str](ir)) { ret R.err[*bool, str](R.unwrap_err[ParsedInvocation, str](ir)); }
    val inv: ParsedInvocation = R.unwrap_ok[ParsedInvocation, str](ir);
    ret R.ok[*bool, str](inv.marks);
}

# the removal message for an option that used to exist, so every command refuses it the same way
# ---
# tok: the flag-shaped token
# ret: the message when `tok` names a removed option
pub fun removed_option_message(tok: str) O.Option[str] {
    if (str_equals(tok, "-O1")) { ret O.some[str](OPT_O1_REMOVED_ERROR); }
    ret O.none[str]();
}

# print `error: unknown flag` for the first unrecognized flag-shaped token, or the
# removal message when the token names a removed option
# ---
# inv: the parsed invocation
# argv: the argument vector inv was parsed from
# cmd: the command name printed in the message
# ret: true when an unknown token was reported, false when there was none
pub fun reject_unknown_from_invocation(inv: *ParsedInvocation, argv: **u8, cmd: str) bool {
    if (!inv.has_unknown) { ret false; }
    val tok: str = argv[inv.unknown_idx]::str;
    val removed: O.Option[str] = removed_option_message(tok);
    if (O.is_some[str](removed)) { print.eprintf("error: {}\n", O.unwrap[str](removed)); ret true; }
    print.eprintf("error: unknown flag '{}' for '{}'\n", tok, cmd);
    ret true;
}

# the typed arguments of mach info
# ---
# show_version: `--version` occurred
# show_targets: the sole positional was `targets`
# invalid_verb: a positional other than `targets` was given, or more than one positional
pub rec InfoInvocation {
    show_version: bool;
    show_targets: bool;
    invalid_verb: bool;
}

# read the info arguments out of a parsed invocation
# ---
# inv: the parsed invocation
# argv: the argument vector inv was parsed from
# ret: the arguments; `--version` together with `targets` sets both flags and is left for the command to refuse
pub fun build_info_invocation(inv: *ParsedInvocation, argv: **u8) InfoInvocation {
    var r: InfoInvocation;
    r.show_version = false;
    r.show_targets = false;
    r.invalid_verb = false;

    val version_hit: SchemaHit = schema_lookup(CMD_INFO, DEPACT_NONE, "--version");
    var i: usize = 0;
    for (i < inv.occ_len) {
        if (inv.occ[i].key == version_hit.key) { r.show_version = true; }
        i = i + 1;
    }
    if (inv.has_positional) {
        if (str_equals(argv[inv.positional_idx]::str, "targets")) { r.show_targets = true; }
        or { r.invalid_verb = true; }
    }
    if (inv.positional_count > 1) { r.invalid_verb = true; }
    ret r;
}

# the typed arguments of mach clean
# ---
# has_project: a positional project path was given
# project_idx: argv index of that path
pub rec CleanInvocation {
    has_project: bool;
    project_idx: usize;
}

# read the clean arguments out of a parsed invocation; the project is the first positional
# ---
# inv: the parsed invocation
# ret: the arguments
pub fun build_clean_invocation(inv: *ParsedInvocation) CleanInvocation {
    var r: CleanInvocation;
    r.has_project = inv.has_positional;
    r.project_idx = inv.positional_idx;
    ret r;
}

# the typed arguments of mach doc
# ---
# has_out: `--out` occurred with a value
# out_idx: argv index of the out value
# quiet: `--quiet` or `-q`
# has_project: a positional project path was given
# project_idx: argv index of that path
pub rec DocInvocation {
    has_out:     bool;
    out_idx:     usize;
    quiet:       bool;
    has_project: bool;
    project_idx: usize;
}

# read the doc arguments out of a parsed invocation; the project is the first
# positional, and the last occurrence of a value option wins
# ---
# inv: the parsed invocation
# ret: the arguments
pub fun build_doc_invocation(inv: *ParsedInvocation) DocInvocation {
    var r: DocInvocation;
    r.has_out     = false;
    r.out_idx     = 0;
    r.quiet       = false;
    r.has_project = inv.has_positional;
    r.project_idx = inv.positional_idx;

    val out_hit:    SchemaHit = schema_lookup(CMD_DOC, DEPACT_NONE, "--out");
    val quiet_hit:  SchemaHit = schema_lookup(CMD_DOC, DEPACT_NONE, "--quiet");
    val q_hit:      SchemaHit = schema_lookup(CMD_DOC, DEPACT_NONE, "-q");

    var i: usize = 0;
    for (i < inv.occ_len) {
        val o: Occurrence = inv.occ[i];
        if (o.key == out_hit.key && o.has_value) { r.has_out = true; r.out_idx = o.value_idx; }
        or (o.key == quiet_hit.key) { r.quiet = true; }
        or (o.key == q_hit.key) { r.quiet = true; }
        i = i + 1;
    }
    ret r;
}

# the typed arguments common to every mach dep action
# ---
# has_action: argv[2] named an action
# action: that action, or DEPACT_NONE
# quiet: `--quiet` or `-q`
pub rec DepInvocation {
    has_action: bool;
    action:     DepAction;
    quiet:      bool;
}

# read the dep arguments out of a parsed invocation
# ---
# inv: the parsed invocation
# ret: the arguments
pub fun build_dep_invocation(inv: *ParsedInvocation) DepInvocation {
    var r: DepInvocation;
    r.has_action = inv.has_action;
    r.action     = inv.action;
    r.quiet      = false;

    val quiet_hit: SchemaHit = schema_lookup(CMD_DEP, DEPACT_NONE, "--quiet");
    val q_hit:     SchemaHit = schema_lookup(CMD_DEP, DEPACT_NONE, "-q");
    var i: usize = 0;
    for (i < inv.occ_len) {
        val o: Occurrence = inv.occ[i];
        if (o.key == quiet_hit.key) { r.quiet = true; }
        or (o.key == q_hit.key)     { r.quiet = true; }
        i = i + 1;
    }
    ret r;
}

# the typed arguments of mach run; each value option is an index into argv
# ---
# has_target: `--target` occurred with a value
# target_idx: argv index of the target value
# has_profile: `--profile` occurred with a value
# profile_idx: argv index of the profile value
# has_output: `-o` occurred with a value
# output_idx: argv index of the output value
# output_seen: `-o` occurred at all, with or without a value
# has_bin: `--bin` occurred with a value
# bin_idx: argv index of the bin value
# has_runner: `--runner` occurred with a value
# runner_idx: argv index of the runner value
# has_timeout: `--timeout_seconds` occurred with a value
# timeout_idx: argv index of the timeout value
pub rec RunInvocation {
    has_target:   bool;
    target_idx:   usize;
    has_profile:  bool;
    profile_idx:  usize;
    has_output:   bool;
    output_idx:   usize;
    output_seen:  bool;
    has_bin:      bool;
    bin_idx:      usize;
    has_runner:   bool;
    runner_idx:   usize;
    has_timeout:  bool;
    timeout_idx:  usize;
}

# read the run arguments out of a parsed invocation; the last occurrence of a
# value option wins, and a trailing `-o` without a value sets output_seen only
# ---
# inv: the parsed invocation
# ret: the arguments
pub fun build_run_invocation(inv: *ParsedInvocation) RunInvocation {
    var r: RunInvocation;
    r.has_target  = false; r.target_idx  = 0;
    r.has_profile = false; r.profile_idx = 0;
    r.has_output  = false; r.output_idx  = 0; r.output_seen = false;
    r.has_bin     = false; r.bin_idx     = 0;
    r.has_runner  = false; r.runner_idx  = 0;
    r.has_timeout = false; r.timeout_idx = 0;

    val target_hit:  SchemaHit = schema_lookup(CMD_RUN, DEPACT_NONE, "--target");
    val profile_hit: SchemaHit = schema_lookup(CMD_RUN, DEPACT_NONE, "--profile");
    val output_hit:  SchemaHit = schema_lookup(CMD_RUN, DEPACT_NONE, "-o");
    val bin_hit:     SchemaHit = schema_lookup(CMD_RUN, DEPACT_NONE, "--bin");
    val runner_hit:  SchemaHit = schema_lookup(CMD_RUN, DEPACT_NONE, "--runner");
    val timeout_hit: SchemaHit = schema_lookup(CMD_RUN, DEPACT_NONE, "--timeout_seconds");

    var i: usize = 0;
    for (i < inv.occ_len) {
        val o: Occurrence = inv.occ[i];
        if (o.key == output_hit.key) {
            r.output_seen = true;
            if (o.has_value) { r.has_output = true; r.output_idx = o.value_idx; }
        }
        if (!o.has_value) { i = i + 1; cnt; }
        if (o.key == target_hit.key)       { r.has_target  = true; r.target_idx  = o.value_idx; }
        or (o.key == profile_hit.key)      { r.has_profile = true; r.profile_idx = o.value_idx; }
        or (o.key == bin_hit.key)          { r.has_bin     = true; r.bin_idx     = o.value_idx; }
        or (o.key == runner_hit.key)       { r.has_runner  = true; r.runner_idx  = o.value_idx; }
        or (o.key == timeout_hit.key)      { r.has_timeout = true; r.timeout_idx = o.value_idx; }
        i = i + 1;
    }
    ret r;
}

fun ut_unknown_at(argc: usize, argv: **u8, idx: usize) bool {
    var backing: A.Allocator;
    if (O.is_some[str](page.make(?backing))) { ret false; }
    val ir: R.Result[ParsedInvocation, str] = parse_invocation(?backing, argc, argv);
    if (R.is_err[ParsedInvocation, str](ir)) { ret false; }
    val inv: ParsedInvocation = R.unwrap_ok[ParsedInvocation, str](ir);
    if (idx == argc) { ret !inv.has_unknown; }
    ret inv.has_unknown && inv.unknown_idx == idx;
}

test "mach.cli.args.parse_invocation:an_option_the_command_does_not_accept_is_unknown_by_name" {
    var a: [5]*u8;
    a[0] = "mach"; a[1] = "doc"; a[2] = "."; a[3] = "-o"; a[4] = "x";
    if (!ut_unknown_at(5, ?a[0], 3)) { ret 1; }
    a[3] = "--profile"; a[4] = "nonesuch";
    if (!ut_unknown_at(5, ?a[0], 3)) { ret 2; }
    a[3] = "--emit-ir";
    if (!ut_unknown_at(4, ?a[0], 3)) { ret 3; }
    a[3] = "-v";
    if (!ut_unknown_at(4, ?a[0], 3)) { ret 4; }
    a[3] = "--bin"; a[4] = "b";
    if (!ut_unknown_at(5, ?a[0], 5)) { ret 5; }
    a[1] = "run"; a[3] = "--lib"; a[4] = "x";
    if (!ut_unknown_at(5, ?a[0], 3)) { ret 6; }
    a[3] = "--bin";
    if (!ut_unknown_at(5, ?a[0], 5)) { ret 7; }
    a[1] = "build"; a[3] = "-o"; a[4] = "x";
    if (!ut_unknown_at(5, ?a[0], 5)) { ret 8; }
    if (schema_lookup(CMD_DOC, DEPACT_NONE, "-o").found || !schema_lookup(CMD_BUILD, DEPACT_NONE, "-o").found) { ret 9; }
    ret 0;
}

test "mach.cli.args.reject_unknown:a_removed_option_is_unknown_to_every_command_and_carries_its_removal_message" {
    var a: [4]*u8;
    a[0] = "mach"; a[1] = "build"; a[2] = "-O1"; a[3] = ".";
    if (!ut_unknown_at(4, ?a[0], 2)) { ret 1; }
    a[1] = "test";
    if (!ut_unknown_at(4, ?a[0], 2)) { ret 2; }
    a[1] = "run";
    if (!ut_unknown_at(4, ?a[0], 2)) { ret 3; }
    val msg: O.Option[str] = removed_option_message("-O1");
    if (O.is_none[str](msg) || !str_equals(O.unwrap[str](msg), OPT_O1_REMOVED_ERROR)) { ret 4; }
    if (O.is_some[str](removed_option_message("-O2"))) { ret 5; }
    ret 0;
}

test "mach.cli.args.schema:command_and_action_lookup_round_trips" {
    var i: usize = 0;
    for (i < CMD_N) {
        val got: O.Option[CommandId] = command_lookup(COMMANDS[i].name);
        if (O.is_none[CommandId](got) || O.unwrap[CommandId](got) != COMMANDS[i].id) { ret 1; }
        i = i + 1;
    }
    if (O.is_some[CommandId](command_lookup("bogus"))) { ret 1; }

    i = 0;
    for (i < DEPACT_N) {
        val got: O.Option[DepAction] = dep_action_lookup(DEP_ACTIONS[i].name);
        if (O.is_none[DepAction](got) || O.unwrap[DepAction](got) != DEP_ACTIONS[i].id) { ret 1; }
        i = i + 1;
    }
    if (O.is_some[DepAction](dep_action_lookup("bogus"))) { ret 1; }
    ret 0;
}

test "mach.cli.args.schema:records_are_total_unique_and_unambiguous" {
    if (!schema_valid()) { ret 1; }
    ret 0;
}

test "mach.cli.args.parse_invocation:build_repeated_link_options_mark_every_occurrence" {
    var a: [8]*u8;
    a[0] = "mach"; a[1] = "build"; a[2] = "-l"; a[3] = "one";
    a[4] = "-l";   a[5] = "two";   a[6] = "-L"; a[7] = "dir";
    val n: usize = 8;

    val nr: R.Result[*bool, str] = ut_new_marks(n, ?a[0]);
    if (R.is_err[*bool, str](nr)) { ret 1; }
    val nw: *bool = R.unwrap_ok[*bool, str](nr);
    var i: usize = 2;
    for (i < n) { if (!nw[i]) { ret 1; } i = i + 1; }
    if (nw[0] || nw[1]) { ret 1; }
    ret 0;
}

test "mach.cli.args.parse_invocation:run_truncates_at_separator_and_forwards_the_rest" {
    var a: [7]*u8;
    a[0] = "mach"; a[1] = "run"; a[2] = "--target"; a[3] = "linux";
    a[4] = "--"; a[5] = "--runner"; a[6] = "wine";
    val n: usize = 7;

    val nr: R.Result[*bool, str] = ut_new_marks(n, ?a[0]);
    if (R.is_err[*bool, str](nr)) { ret 1; }
    val nw: *bool = R.unwrap_ok[*bool, str](nr);
    if (!nw[2] || !nw[3]) { ret 1; }
    if (nw[4] || nw[5] || nw[6]) { ret 1; }
    ret 0;
}

test "mach.cli.args.parse_invocation:clean_marks_nothing_every_flag_stays_unmarked" {
    var a: [4]*u8;
    a[0] = "mach"; a[1] = "clean"; a[2] = "--bogus"; a[3] = ".";
    val n: usize = 4;

    val nr: R.Result[*bool, str] = ut_new_marks(n, ?a[0]);
    if (R.is_err[*bool, str](nr)) { ret 1; }
    val nw: *bool = R.unwrap_ok[*bool, str](nr);
    if (nw[2] || nw[3]) { ret 1; }
    ret 0;
}

test "mach.cli.args.parse_invocation:help_marks_nothing" {
    var a: [4]*u8;
    a[0] = "mach"; a[1] = "help"; a[2] = "--bogus"; a[3] = "build";
    val n: usize = 4;

    val nr: R.Result[*bool, str] = ut_new_marks(n, ?a[0]);
    if (R.is_err[*bool, str](nr)) { ret 1; }
    val nw: *bool = R.unwrap_ok[*bool, str](nr);
    if (nw[2] || nw[3]) { ret 1; }
    ret 0;
}

test "mach.cli.args.parse_invocation:doc_marks_its_own_options_and_leaves_a_build_only_flag_unknown" {
    var a: [6]*u8;
    a[0] = "mach"; a[1] = "doc"; a[2] = "--out"; a[3] = "docs";
    a[4] = "--pie"; a[5] = ".";
    val n: usize = 6;

    val nr: R.Result[*bool, str] = ut_new_marks(n, ?a[0]);
    if (R.is_err[*bool, str](nr)) { ret 1; }
    val nw: *bool = R.unwrap_ok[*bool, str](nr);
    if (!nw[2] || !nw[3] || nw[4] || nw[5]) { ret 1; }
    if (!ut_unknown_at(n, ?a[0], 4)) { ret 1; }
    ret 0;
}

test "mach.cli.args.parse_invocation:unknown_command_and_unknown_dep_action_leave_command_unset" {
    var a: [3]*u8;
    a[0] = "mach"; a[1] = "bogus"; a[2] = "x";
    var backing: A.Allocator;
    if (O.is_some[str](page.make(?backing))) { ret 1; }
    val r: R.Result[ParsedInvocation, str] = parse_invocation(?backing, 3, ?a[0]);
    if (R.is_err[ParsedInvocation, str](r)) { ret 1; }
    if (R.unwrap_ok[ParsedInvocation, str](r).has_command) { ret 1; }

    var b: [3]*u8;
    b[0] = "mach"; b[1] = "dep"; b[2] = "bogus";
    val r2: R.Result[ParsedInvocation, str] = parse_invocation(?backing, 3, ?b[0]);
    if (R.is_err[ParsedInvocation, str](r2)) { ret 1; }
    val inv2: ParsedInvocation = R.unwrap_ok[ParsedInvocation, str](r2);
    if (!inv2.has_command || inv2.has_action) { ret 1; }
    ret 0;
}
