# initialise a session, load the manifest, and plan a build for parsed CLI arguments
# ---
# a: allocator for the request
# root: the project root directory
# cli: the parsed arguments
# goal: what to produce, objects or an executable
# ps: out; the session the plan refers to, initialised here; on an error it has already been
#  torn down. any returned failure message is owned by a
# ret: the plan, or a Fail: internal for session or registry setup, user for manifest,
#  selection, and request errors, and whatever plan.plan returns
pub fun plan_invocation(a: *A.Allocator, root: str, cli: *args.CliArgs, goal: request.BuildGoal,
                        ps: *session.Session) R.Result[plan.BuildPlan, outcome.Fail] {
    val res_session: R.Result[session.Session, str] = session.init(a);
    if (R.is_err[session.Session, str](res_session)) {
        ret R.err[plan.BuildPlan, outcome.Fail](outcome.internal("failed to initialise compiler session"));
    }
    @ps = R.unwrap_ok[session.Session, str](res_session);

    val res_register: R.Result[R.Void, str] = driver.setup_registry(?ps.registry);
    if (R.is_err[R.Void, str](res_register)) {
        ret plan_failure(a, ps, outcome.internal(R.unwrap_err[R.Void, str](res_register)));
    }

    val res_manifest: R.Result[manifest.Manifest, str] = driver.load_manifest(ps, root);
    if (R.is_err[manifest.Manifest, str](res_manifest)) {
        val f: outcome.Fail = outcome.user(R.unwrap_err[manifest.Manifest, str](res_manifest));
        ret plan_failure(a, ps, f);
    }
    var m: manifest.Manifest = R.unwrap_ok[manifest.Manifest, str](res_manifest);

    var sel: manifest.Selection;
    val sr: R.Result[R.Void, str] = args.selection_from_config(cli, ?sel);
    if (R.is_err[R.Void, str](sr)) {
        val f: outcome.Fail = outcome.user(R.unwrap_err[R.Void, str](sr));
        ret plan_failure(a, ps, f);
    }

    val res_req: R.Result[request.BuildRequest, outcome.Fail] = request.compose(a, ?ps.interner, ?m, cli, root, goal, ?sel);
    if (R.is_err[request.BuildRequest, outcome.Fail](res_req)) {
        val f: outcome.Fail = R.unwrap_err[request.BuildRequest, outcome.Fail](res_req);
        ret plan_failure(a, ps, f);
    }

    val plan_r: R.Result[plan.BuildPlan, outcome.Fail] = plan.plan(ps.alloc, ?ps.interner, ?ps.registry, ?m,
        R.unwrap_ok[request.BuildRequest, outcome.Fail](res_req));
    if (R.is_err[plan.BuildPlan, outcome.Fail](plan_r)) {
        ret plan_failure(a, ps, R.unwrap_err[plan.BuildPlan, outcome.Fail](plan_r));
    }
    var bp: plan.BuildPlan = R.unwrap_ok[plan.BuildPlan, outcome.Fail](plan_r);
    val configured: R.Result[R.Void, outcome.Fail] = plan.configure(ps, ?m, ?bp);
    if (R.is_err[R.Void, outcome.Fail](configured)) {
        ret plan_failure(a, ps, R.unwrap_err[R.Void, outcome.Fail](configured));
    }
    ret R.ok[plan.BuildPlan, outcome.Fail](bp);
}

fun plan_failure(a: *A.Allocator, ps: *session.Session, failure: outcome.Fail) R.Result[plan.BuildPlan, outcome.Fail] {
    var stable: outcome.Fail = failure;
    if (failure.message != nil) {
        val copied: R.Result[str, str] = str_dup(a, failure.message);
        if (R.is_err[str, str](copied)) { stable = outcome.internal("failed to retain build planning error"); }
        or { stable.message = R.unwrap_ok[str, str](copied); }
    }
    session.dnit(ps);
    ret R.err[plan.BuildPlan, outcome.Fail](stable);
}

# `mach build`: plan and execute a build of the project operand, rendering diagnostics and
# the outcome to stderr. `-O1` is refused before parsing; `--plan` prints the plan and
# stops; `-v` and `-vv` render the phase readout after the build
# ---
# argv: the full process arguments
# inv: the parsed invocation for this command
# ret: 0 success, 1 user error, 2 internal failure, 3 environment failure
pub fun run_typed(argv: **u8, inv: *args.ParsedInvocation) i64 {
    ret run_invocation(argv, inv, args.CMD_BUILD, request.GOAL_EXECUTE);
}

pub fun check_typed(argv: **u8, inv: *args.ParsedInvocation) i64 {
    if (inv.positional_count != 1) {
        val f: outcome.Fail = outcome.user("mach check expects one project path");
        ret cli_diag.render_fail(?f);
    }
    ret run_invocation(argv, inv, args.CMD_CHECK, request.GOAL_CHECK);
}

fun run_invocation(argv: **u8, inv: *args.ParsedInvocation, cmd: args.CommandId,
                   requested_goal: request.BuildGoal) i64 {
    var goal: request.BuildGoal = requested_goal;
    val opt_emit: O.Option[*u8] = args.invocation_value(cmd, inv, argv, "--emit");
    if (O.is_some[*u8](opt_emit)) {
        val kind: str = O.unwrap[*u8](opt_emit)::str;
        val goal_o: O.Option[request.BuildGoal] = request.goal_from_emit_name(kind);
        if (O.is_none[request.BuildGoal](goal_o)) {
            val f: outcome.Fail = outcome.user(request.EMIT_ERROR);
            ret cli_diag.render_fail(?f);
        }
        goal = O.unwrap[request.BuildGoal](goal_o);
    }

    var backing: A.Allocator;
    if (O.is_some[str](page.make(?backing))) {
        val f: outcome.Fail = outcome.internal("failed to initialise allocator");
        ret cli_diag.render_fail(?f);
    }

    val res_config: R.Result[args.CliArgs, str] = args.build_cli_invocation(cmd, inv, argv);
    if (R.is_err[args.CliArgs, str](res_config)) {
        val f: outcome.Fail = outcome.user(R.unwrap_err[args.CliArgs, str](res_config));
        ret cli_diag.render_fail(?f);
    }
    var config: args.CliArgs = R.unwrap_ok[args.CliArgs, str](res_config);
    if (config.bin != nil && config.lib != nil) {
        val f: outcome.Fail = outcome.user("--bin and --lib cannot be combined");
        ret cli_diag.render_fail(?f);
    }

    val explain_only: bool = args.invocation_flag(cmd, inv, "--plan");
    if (quiet_explain_conflict(config.quiet, explain_only)) {
        val f: outcome.Fail = outcome.user("`--plan` and `--quiet`/`-q` cannot be combined");
        ret cli_diag.render_fail(?f);
    }
    var command_name: str = "mach build";
    if (cmd == args.CMD_CHECK) { command_name = "mach check"; }
    if (args.reject_unknown_from_invocation(inv, argv, command_name)) { ret 1; }

    var arg: *u8 = nil;
    if (inv.has_positional) { arg = argv[inv.positional_idx]; }

    val loc_r: R.Result[util.ProjectLocation, str] = util.resolve_project_location(?backing, arg);
    if (R.is_err[util.ProjectLocation, str](loc_r)) {
        val f: outcome.Fail = outcome.user(R.unwrap_err[util.ProjectLocation, str](loc_r));
        ret cli_diag.render_fail(?f);
    }
    val loc: util.ProjectLocation = R.unwrap_ok[util.ProjectLocation, str](loc_r);
    val root: str = loc.root;

    val col_r: R.Result[R.Void, str] = args.collect_link_inputs(?backing, ?config, cmd, inv, argv);
    if (R.is_err[R.Void, str](col_r)) {
        val f: outcome.Fail = outcome.internal(R.unwrap_err[R.Void, str](col_r));
        ret cli_diag.render_fail(?f);
    }

    var menu_ar: arena.Arena;
    if (O.is_some[str](arena.init(?menu_ar, ?backing, 0))) {
        val f: outcome.Fail = outcome.internal("failed to initialise allocator");
        ret cli_diag.render_fail(?f);
    }
    var menu_alloc: A.Allocator;
    if (O.is_some[str](arena.make(?menu_alloc, ?menu_ar))) {
        arena.dnit(?menu_ar);
        val f: outcome.Fail = outcome.internal("failed to initialise allocator");
        ret cli_diag.render_fail(?f);
    }

    var ps: session.Session;
    val plan_r: R.Result[plan.BuildPlan, outcome.Fail] = plan_invocation(?menu_alloc, root, ?config, goal, ?ps);
    if (R.is_err[plan.BuildPlan, outcome.Fail](plan_r)) {
        var f: outcome.Fail = R.unwrap_err[plan.BuildPlan, outcome.Fail](plan_r);
        val c: i64 = cli_diag.render_fail(?f);
        arena.dnit(?menu_ar);
        ret c;
    }
    val bp: plan.BuildPlan = R.unwrap_ok[plan.BuildPlan, outcome.Fail](plan_r);

    if (explain_only) {
        plan.explain(?bp, ?ps.interner);
        session.dnit(?ps);
        arena.dnit(?menu_ar);
        ret 0;
    }

    var pr: readout.Progress;
    var ev: *readout.Progress = nil;
    if (config.verbosity > 0) {
        readout.init(?pr, ?menu_alloc, config.verbosity);
        ev = ?pr;
    }

    val ex_r: R.Result[outcome.BuildOutcome, outcome.Fail] = engine.execute(?bp, ?backing, ?menu_alloc, ev);
    if (ev != nil) {
        readout.render(ev);
        readout.dnit(ev);
    }

    var code: i64 = 0;
    if (R.is_err[outcome.BuildOutcome, outcome.Fail](ex_r)) {
        var f: outcome.Fail = R.unwrap_err[outcome.BuildOutcome, outcome.Fail](ex_r);
        code = cli_diag.render_fail(?f);
    }
    or {
        var bo: outcome.BuildOutcome = R.unwrap_ok[outcome.BuildOutcome, outcome.Fail](ex_r);
        cli_diag.render_outcome(?bo, config.quiet);
        code = cli_diag.outcome_code(?bo);
        outcome.outcome_dnit(?bo);
    }

    session.dnit(?ps);
    arena.dnit(?menu_ar);
    ret code;
}

fun quiet_explain_conflict(quiet: bool, explain_only: bool) bool {
    ret quiet && explain_only;
}

fun t_build(argc: usize, argv: **u8) i64 {
    var a: A.Allocator;
    if (O.is_some[str](page.make(?a))) { ret 2; }
    val ir: R.Result[args.ParsedInvocation, str] = args.parse_invocation(?a, argc, argv);
    if (R.is_err[args.ParsedInvocation, str](ir)) { ret 2; }
    var inv: args.ParsedInvocation = R.unwrap_ok[args.ParsedInvocation, str](ir);
    ret run_typed(argv, ?inv);
}

test "mach.cli.cmd.build.quiet_explain_conflict:only_the_combination_conflicts" {
    if (!quiet_explain_conflict(true, true))  { ret 1; }
    if (quiet_explain_conflict(true, false))  { ret 2; }
    if (quiet_explain_conflict(false, true))  { ret 3; }
    if (quiet_explain_conflict(false, false)) { ret 4; }
    ret 0;
}

test "mach.cli.cmd.build.run_typed:rejects_quiet_combined_with_explain" {
    var argv: [4]*u8;
    argv[0] = "mach"; argv[1] = "build"; argv[2] = "--quiet"; argv[3] = "--plan";
    if (t_build(4, ?argv[0]) != 1) { ret 1; }

    var alias: [4]*u8;
    alias[0] = "mach"; alias[1] = "build"; alias[2] = "-q"; alias[3] = "--plan";
    if (t_build(4, ?alias[0]) != 1) { ret 2; }

    ret 0;
}

fun t_req_join(a: *A.Allocator, base: str, leaf: str) str {
    val r: R.Result[str, str] = path.join(a, base, leaf);
    if (R.is_err[str, str](r)) { ret base; }
    ret R.unwrap_ok[str, str](r);
}

fun t_req_write(a: *A.Allocator, dir: str, name: str, body: str) bool {
    if (O.is_some[str](fs.create_dir_all(a, dir, 0o755))) { ret false; }
    val p: str = t_req_join(a, dir, name);
    ret O.is_none[str](fs.write_bytes(p, body::*u8, str_len(body), 0o644));
}

val T_REQ_MANIFEST: str = "[project]\nid = \"reqfx\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.host]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[target.alt]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[artifact.shader-a]\nkind = \"static\"\nentry = \"shader.mach\"\nout = \"lib/shader-a.a\"\ntargets = [\"alt\"]\nlink = []\nneed = []\n\n[artifact.shader-b]\nkind = \"static\"\nentry = \"shader.mach\"\nout = \"lib/shader-b.a\"\ntargets = [\"alt\"]\nlink = []\nneed = []\n\n[artifact.app]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/app\"\ntargets = [\"host\"]\nlink = []\nneed = [\"artifact.shader-*\"]\n\n[profile.debug]\nvectorize=true\nfloat_reassoc=false\ndefault = true\nopt = 0\ndebug = false\nsimd = \"scalarize\"\n";

val T_REQ_SHADER: str = "pub fun tint(x: u64) u64 { ret x + 3; }\n";

val T_REQ_MAIN: str = "#[embed(\"{artifact.shader-a.out}\")]\nval SHADER: [_]u8;\n\n#[symbol(\"_start\")]\nfun start() {\n    var c: u64 = 1;\n    if (SHADER[0] == 0x21 && SHADER[1] == 0x3C && SHADER[6] == 0x3E && SHADER[7] == 0x0A) { c = 0; }\n    asm x86_64 {\n        mov rax, 60\n        mov rdi, {c}\n        syscall\n    }\n}\n";

fun t_req_exit_code(a: *A.Allocator, exe: str) i64 {
    var child: subprocess.OwnedSubprocess;
    subprocess.init(?child);
    fin {
        if (subprocess.running(?child)) { subprocess.cancel(a, ?child, 0); }
        subprocess.dnit(a, ?child);
    }
    var argv: [2]*u8;
    argv[0] = exe::*u8;
    argv[1] = nil;
    if (R.is_err[R.Void, str](subprocess.spawn(a, ?child, exe, ?argv[0], env.environ()))) {
        ret -1;
    }
    val wr: R.Result[subprocess.SubprocessTerminal, str] = subprocess.wait(a, ?child);
    if (R.is_err[subprocess.SubprocessTerminal, str](wr)) {
        ret -1;
    }
    val term: subprocess.SubprocessTerminal = R.unwrap_ok[subprocess.SubprocessTerminal, str](wr);
    if (term.kind != subprocess.STATE_EXITED) { ret -1; }
    ret term.code::i64;
}

test "mach.cli.cmd.build.run_typed:a_glob_requirement_builds_first_and_the_bin_embeds_its_output" {
    $if ($mach.build.os != $mach.os.linux)      { ret 0; }
    $if ($mach.build.arch != $mach.arch.x86_64) { ret 0; }

    var a: A.Allocator;
    if (O.is_some[str](page.make(?a))) { ret 1; }

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?a, "mach_build_artifact_need");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);
    val root: str = fs.temp_path(?tf);
    fs.temp_close_and_remove(?tf);
    if (O.is_some[str](fs.create_dir_all(?a, root, 0o755))) { ret 1; }

    var bad: i32 = 0;
    if (!t_req_write(?a, root, "mach.toml", T_REQ_MANIFEST)) { bad = 1; }
    val src_dir: str = t_req_join(?a, root, "src");
    if (!t_req_write(?a, src_dir, "shader.mach", T_REQ_SHADER)) { bad = 1; }
    if (!t_req_write(?a, src_dir, "main.mach", T_REQ_MAIN))     { bad = 1; }
    if (bad != 0) { fs.remove_all(?a, root); ret 1; }

    var argv: [5]*u8;
    argv[0] = "mach"::*u8; argv[1] = "build"::*u8; argv[2] = root::*u8;
    argv[3] = "--target"::*u8; argv[4] = "host"::*u8;
    if (t_build(5, ?argv[0]) != 0) { fs.remove_all(?a, root); ret 1; }

    val lib_a: str = t_req_join(?a, root, "out/alt/debug/lib/shader-a.a");
    val lib_b: str = t_req_join(?a, root, "out/alt/debug/lib/shader-b.a");
    val app:   str = t_req_join(?a, root, "out/host/debug/bin/app");
    if (!fs.is_file(lib_a)) { bad = 1; }
    if (!fs.is_file(lib_b)) { bad = 1; }
    if (!fs.is_file(app))   { bad = 1; }
    if (bad != 0) { fs.remove_all(?a, root); ret 1; }

    if (t_req_exit_code(?a, app) != 0) { bad = 1; }

    val out_dir: str = t_req_join(?a, root, "out");
    fs.remove_all(?a, out_dir);
    if (!t_req_write(?a, src_dir, "shader.mach", "pub fun tint(x: u64) u64 { ret nonesuch; }\n")) { bad = 1; }
    if (t_build(5, ?argv[0]) == 0) { bad = 1; }
    if (fs.is_file(app))           { bad = 1; }

    fs.remove_all(?a, root);
    ret bad;
}

test "mach.cli.cmd.build.run_typed:rejects_o1_before_any_side_effect_o0_and_o2_still_build" {
    val toml_body: str = "[project]\nid = \"rem102fx\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out\"\n\n[profile.test]\nvectorize=true\nfloat_reassoc=false\nopt = 0\ndebug = false\nsimd = \"scalarize\"\n\n[artifact.rem102fx]\nkind = \"static\"\nentry = \"lib.mach\"\nout = \"lib/rem102fx.a\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
    val src_body: str = "pub fun value() i64 {\n    ret 42;\n}\n";

    var a: A.Allocator;
    if (O.is_some[str](page.make(?a))) { ret 1; }

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?a, "mach_build_cmd_o1");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);
    val root: str = fs.temp_path(?tf);
    fs.temp_close_and_remove(?tf);
    if (O.is_some[str](fs.create_dir_all(?a, root, 0o755))) { ret 1; }

    val toml_path_r: R.Result[str, str] = path.join(?a, root, "mach.toml");
    if (R.is_err[str, str](toml_path_r)) { ret 1; }
    val toml_path: str = R.unwrap_ok[str, str](toml_path_r);
    if (O.is_some[str](fs.write_bytes(toml_path, toml_body::*u8, str_len(toml_body), 0o644))) { ret 1; }

    val src_dir_r: R.Result[str, str] = path.join(?a, root, "src");
    if (R.is_err[str, str](src_dir_r)) { ret 1; }
    val src_dir: str = R.unwrap_ok[str, str](src_dir_r);
    if (O.is_some[str](fs.create_dir_all(?a, src_dir, 0o755))) { ret 1; }
    val src_path_r: R.Result[str, str] = path.join(?a, src_dir, "lib.mach");
    if (R.is_err[str, str](src_path_r)) { ret 1; }
    val src_path: str = R.unwrap_ok[str, str](src_path_r);
    if (O.is_some[str](fs.write_bytes(src_path, src_body::*u8, str_len(src_body), 0o644))) { ret 1; }

    val out_dir_r: R.Result[str, str] = path.join(?a, root, "out");
    if (R.is_err[str, str](out_dir_r)) { ret 1; }
    val out_dir: str = R.unwrap_ok[str, str](out_dir_r);

    var bad: i32 = 0;

    var argv_o1: [4]*u8;
    argv_o1[0] = "mach"; argv_o1[1] = "build"; argv_o1[2] = "-O1"; argv_o1[3] = root::*u8;
    if (t_build(4, ?argv_o1[0]) != 1) { bad = 1; }
    if (fs.is_dir(out_dir))           { bad = 1; }

    var argv_o0: [4]*u8;
    argv_o0[0] = "mach"; argv_o0[1] = "build"; argv_o0[2] = "-O0"; argv_o0[3] = root::*u8;
    if (t_build(4, ?argv_o0[0]) != 0) { bad = 1; }
    if (!fs.is_dir(out_dir))          { bad = 1; }
    fs.remove_all(?a, out_dir);

    var argv_o2: [4]*u8;
    argv_o2[0] = "mach"; argv_o2[1] = "build"; argv_o2[2] = "-O2"; argv_o2[3] = root::*u8;
    if (t_build(4, ?argv_o2[0]) != 0) { bad = 1; }
    if (!fs.is_dir(out_dir))          { bad = 1; }

    fs.remove_all(?a, root);
    ret bad;
}

fun t_check(argc: usize, argv: **u8) i64 {
    var a: A.Allocator;
    if (O.is_some[str](page.make(?a))) { ret 2; }
    val parsed: R.Result[args.ParsedInvocation, str] = args.parse_invocation(?a, argc, argv);
    if (R.is_err[args.ParsedInvocation, str](parsed)) { ret 2; }
    var inv: args.ParsedInvocation = R.unwrap_ok[args.ParsedInvocation, str](parsed);
    fin { args.dnit_invocation(?a, ?inv); }
    ret check_typed(argv, ?inv);
}

test "mach.cli.cmd.build.check_typed:checks_selected_source_without_building_required_artifacts" {
    var a: A.Allocator;
    if (O.is_some[str](page.make(?a))) { ret 1; }
    val created: R.Result[fs.TempFile, str] = fs.temp_create(?a, "mach_check_source");
    if (R.is_err[fs.TempFile, str](created)) { ret 2; }
    var temporary: fs.TempFile = R.unwrap_ok[fs.TempFile, str](created);
    val root: str = fs.temp_path(?temporary);
    fs.temp_close_and_remove(?temporary);
    fin { fs.remove_all(?a, root); }
    val source: str = t_req_join(?a, root, "src");
    val with_need: R.Result[str, str] = str_replace(?a, T_REQ_MANIFEST,
        "artifact.shader-*", "artifact.shader-*\",\"step.shader-never");
    if (R.is_err[str, str](with_need)) { ret 3; }
    val manifest_with_step: str = plan.join_msg(?a, R.unwrap_ok[str, str](with_need),
        "\n[step.shader-never]\nargv = [\"mach-check-must-not-execute-this-program\"]\nin = []\nout = []\nneed = []\n");
    if (!t_req_write(?a, root, "mach.toml", manifest_with_step)
        || !t_req_write(?a, source, "shader.mach", T_REQ_SHADER)
        || !t_req_write(?a, source, "main.mach", T_REQ_MAIN)) { ret 3; }
    var argv: [5]*u8;
    argv[0] = "mach"; argv[1] = "check"; argv[2] = root::*u8;
    argv[3] = "--target"; argv[4] = "host";
    if (t_check(5, ?argv[0]) != 1) { ret 4; }
    val output: str = t_req_join(?a, root, "out");
    if (fs.is_dir(output)) { ret 5; }
    if (!t_req_write(?a, source, "main.mach", "pub fun selected() u64 { ret 42; }\n")
        || !t_req_write(?a, source, "unselected.mach", "this is deliberately invalid source\n")) { ret 6; }
    if (t_check(5, ?argv[0]) != 0) { ret 7; }
    if (fs.is_dir(output)) { ret 8; }
    if (!t_req_write(?a, source, "main.mach", "pub fun selected() u64 { ret missing_name; }\n")) { ret 9; }
    if (t_check(5, ?argv[0]) != 1) { ret 10; }
    if (fs.is_dir(output)) { ret 11; }
    ret 0;
}

test "mach.cli.cmd.build.check_typed:requires_one_path_and_refuses_output_options" {
    var argv: [5]*u8;
    argv[0] = "mach"; argv[1] = "check"; argv[2] = ".";
    argv[3] = "-o"; argv[4] = "bin/unexpected";
    if (t_check(2, ?argv[0]) != 1) { ret 1; }
    if (t_check(5, ?argv[0]) != 1) { ret 2; }
    argv[3] = "second-project";
    if (t_check(4, ?argv[0]) != 1) { ret 3; }
    ret 0;
}

test "mach.cli.cmd.build.run_typed:plan_does_not_execute_prerequisites_or_read_generated_source" {
    var a: A.Allocator;
    if (O.is_some[str](page.make(?a))) { ret 1; }
    val created: R.Result[fs.TempFile, str] = fs.temp_create(?a, "mach_build_plan");
    if (R.is_err[fs.TempFile, str](created)) { ret 2; }
    var temporary: fs.TempFile = R.unwrap_ok[fs.TempFile, str](created);
    val root: str = fs.temp_path(?temporary);
    fs.temp_close_and_remove(?temporary);
    fin { fs.remove_all(?a, root); }
    val with_need: R.Result[str, str] = str_replace(?a, T_REQ_MANIFEST,
        "artifact.shader-*", "artifact.shader-*\",\"step.shader-never");
    if (R.is_err[str, str](with_need)) { ret 3; }
    val manifest_with_step: str = plan.join_msg(?a, R.unwrap_ok[str, str](with_need),
        "\n[step.shader-never]\nargv = [\"mach-plan-must-not-execute-this-program\"]\nin = []\nout = []\nneed = []\n");
    if (!t_req_write(?a, root, "mach.toml", manifest_with_step)) { ret 3; }
    var argv: [6]*u8;
    argv[0] = "mach"; argv[1] = "build"; argv[2] = root::*u8;
    argv[3] = "--target"; argv[4] = "host"; argv[5] = "--plan";
    if (t_build(6, ?argv[0]) != 0) { ret 4; }
    if (fs.is_dir(t_req_join(?a, root, "out"))) { ret 5; }
    ret 0;
}

fun t_plan(a: *A.Allocator, root: str, ps: *session.Session) R.Result[plan.BuildPlan, outcome.Fail] {
    var cli: args.CliArgs;
    cli.target = "host";
    cli.bin = "app";
    ret plan_invocation(a, root, ?cli, request.GOAL_EXECUTE, ps);
}

test "mach.cli.cmd.build.plan:realized_dependencies_exports_and_cycles_use_shared_configuration" {
    var backing: A.Allocator;
    if (O.is_some[str](page.make(?backing))) { ret 1; }
    var ar: arena.Arena;
    if (O.is_some[str](arena.init(?ar, ?backing, 0))) { ret 1; }
    fin { arena.dnit(?ar); }
    var a: A.Allocator;
    if (O.is_some[str](arena.make(?a, ?ar))) { ret 1; }
    val created: R.Result[fs.TempFile, str] = fs.temp_create(?a, "mach_plan_deps");
    if (R.is_err[fs.TempFile, str](created)) { ret 2; }
    var temporary: fs.TempFile = R.unwrap_ok[fs.TempFile, str](created);
    val root: str = fs.temp_path(?temporary);
    fs.temp_close_and_remove(?temporary);
    fin { fs.remove_all(?a, root); }
    val basic: R.Result[str, str] = str_replace(?a, T_REQ_MANIFEST,
        "need = [\"artifact.shader-*\"]", "need = []");
    if (R.is_err[str, str](basic)) { ret 3; }
    val root_manifest: str = plan.join_msg(?a, R.unwrap_ok[str, str](basic),
        "\n[dep.vendor]\npath = \"../source-must-not-be-read\"\n");
    if (!t_req_write(?a, root, "mach.toml", root_manifest)) { ret 3; }
    var s: session.Session;
    val missing: R.Result[plan.BuildPlan, outcome.Fail] = t_plan(?a, root, ?s);
    if (R.is_ok[plan.BuildPlan, outcome.Fail](missing)) { session.dnit(?s); ret 4; }
    val failure: outcome.Fail = R.unwrap_err[plan.BuildPlan, outcome.Fail](missing);
    if (failure.kind != outcome.FAIL_USER || !str_contains(failure.message, "is not resolved (missing")
        || !str_contains(failure.message, root)) { ret 5; }
    val dep_root: str = t_req_join(?a, root, "dep/vendor");
    if (fs.exists(dep_root) || fs.exists(t_req_join(?a, root, "out"))) { ret 6; }
    val dep_manifest: str = "[project]\nid = \"vendor\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=false\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[artifact.lib]\nkind=\"static\"\nentry=\"public.mach\"\nout=\"lib/vendor.a\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n[link.generated]\nsource=\"local\"\npath=\"{project.out}/vendor.o\"\nos=[\"*\"]\nisa=[\"*\"]\nabi=[\"*\"]\nexport=true\n[step.first]\nargv=[\"mach-plan-must-not-execute-this-program\"]\nin=[]\nout=[]\nneed=[]\n[step.object]\nargv=[\"mach-plan-must-not-execute-this-program\"]\nin=[]\nout=[\"{project.out}/vendor.o\"]\nneed=[\"step.first\"]\n";
    if (!t_req_write(?a, dep_root, "mach.toml", dep_manifest)
        || !t_req_write(?a, t_req_join(?a, dep_root, "src"), "public.mach",
            "this is deliberately invalid Mach source\n")) { ret 7; }
    val ready: R.Result[plan.BuildPlan, outcome.Fail] = t_plan(?a, root, ?s);
    if (R.is_err[plan.BuildPlan, outcome.Fail](ready)) { ret 8; }
    var bp: plan.BuildPlan = R.unwrap_ok[plan.BuildPlan, outcome.Fail](ready);
    var bad: bool = bp.units.len != 1;
    if (!bad) {
        val u: *plan.BuildUnit = ?bp.units.data[0];
        bad = u.dep_steps.len != 2 || u.export_links.len != 1;
        if (!bad) {
            bad = !str_equals(u.dep_steps.data[0], "vendor.first")
                || !str_equals(u.dep_steps.data[1], "vendor.object");
            val link: O.Option[str] = intern.lookup(?s.interner, u.export_links.data[0]);
            bad = bad || O.is_none[str](link);
            if (!bad) { bad = !str_equals(O.unwrap[str](link), "out/host/debug/vendor.o"); }
        }
    }
    session.dnit(?s);
    if (bad) { ret 9; }
    if (fs.exists(t_req_join(?a, root, "out")) || fs.exists(t_req_join(?a, root, ".git"))) { ret 10; }
    val cycle: str = plan.join_msg(?a, dep_manifest,
        "\n[dep.vendor]\npath=\"../source-must-not-be-read\"\n");
    if (!t_req_write(?a, dep_root, "mach.toml", cycle)) { ret 11; }
    val cyclic: R.Result[plan.BuildPlan, outcome.Fail] = t_plan(?a, root, ?s);
    if (R.is_ok[plan.BuildPlan, outcome.Fail](cyclic)) { session.dnit(?s); ret 12; }
    val cycle_failure: outcome.Fail = R.unwrap_err[plan.BuildPlan, outcome.Fail](cyclic);
    if (cycle_failure.kind != outcome.FAIL_USER || !str_contains(cycle_failure.message, "dependency cycle")) { ret 13; }
    if (fs.exists(t_req_join(?a, root, "out"))) { ret 14; }
    ret 0;
}

test "mach.cli.cmd.build.plan:failure_message_outlives_the_session" {
    var a: A.Allocator;
    if (O.is_some[str](page.make(?a))) { ret 1; }
    val initialized: R.Result[session.Session, str] = session.init(?a);
    if (R.is_err[session.Session, str](initialized)) { ret 2; }
    var s: session.Session = R.unwrap_ok[session.Session, str](initialized);
    val copied: R.Result[str, str] = str_dup(s.queries.a, "owned planning failure");
    if (R.is_err[str, str](copied)) { session.dnit(?s); ret 3; }
    s.query_failure_message = R.unwrap_ok[str, str](copied);
    val prior: str = s.query_failure_message;
    val result: R.Result[plan.BuildPlan, outcome.Fail] = plan_failure(?a, ?s, outcome.user(prior));
    if (R.is_ok[plan.BuildPlan, outcome.Fail](result)) { ret 4; }
    val failure: outcome.Fail = R.unwrap_err[plan.BuildPlan, outcome.Fail](result);
    if (failure.message == prior || failure.kind != outcome.FAIL_USER) { ret 5; }
    val valid: bool = str_equals(failure.message, "owned planning failure");
    str_free(?a, failure.message);
    if (!valid) { ret 6; }
    ret 0;
}
