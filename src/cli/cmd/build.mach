val CHECK_TABLES_N: usize = 4;
# the option tables mach check accepts: SEL masked by CHECK_SEL_ACCEPTED, the readout levels and DIAG
val CHECK_TABLES: [CHECK_TABLES_N]args.TableRef = [CHECK_TABLES_N]args.TableRef{
    args.TableRef{rows: ?args.SEL[0], n: args.SEL_N, accepted: ?CHECK_SEL_ACCEPTED[0], docs: nil},
