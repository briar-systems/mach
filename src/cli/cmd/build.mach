# initialise a session, load the manifest, and plan a build for parsed CLI arguments
# ---
# a: allocator for the request
# root: the project root directory
# cli: the parsed arguments
# goal: what to produce, objects or an executable
# configure_deps: also resolve every cell against the realized dependency closure,
#  filling in its exported dependency steps and export link requirements. a build
#  that goes on to execute resolves each cell as it runs it, so only a caller that
#  reports the plan instead of running it asks for this
# ps: out; the session the plan refers to, initialised here; on an error it has already been
#  torn down and the returned failure message is owned by `a`
# ret: the plan, configured against the realized dependency closure, or a Fail:
#  internal for session or registry setup, user for manifest, selection, request
#  and dependency-configuration errors, and whatever plan.plan returns
pub fun plan_invocation(a: *A.Allocator, root: str, cli: *args.CliArgs, goal: request.BuildGoal,
                        configure_deps: bool, ps: *session.Session) R.Result[plan.BuildPlan, outcome.Fail] {
    val res_session: R.Result[session.Session, str] = session.init(a);
    if (R.is_err[session.Session, str](res_session)) {
        ret R.err[plan.BuildPlan, outcome.Fail](outcome.internal("failed to initialise compiler session"));
    }
    @ps = R.unwrap_ok[session.Session, str](res_session);

    val res_register: R.Result[R.Void, str] = driver.setup_registry(?ps.registry);
    if (R.is_err[R.Void, str](res_register)) {
        ret plan_failure(a, ps, outcome.internal(R.unwrap_err[R.Void, str](res_register)));
    }

    val res_manifest: R.Result[manifest.Manifest, str] = driver.load_manifest(ps, root);
    if (R.is_err[manifest.Manifest, str](res_manifest)) {
        ret plan_failure(a, ps, outcome.user(R.unwrap_err[manifest.Manifest, str](res_manifest)));
    }
    var m: manifest.Manifest = R.unwrap_ok[manifest.Manifest, str](res_manifest);

    var pick: manifest.Selection;
    val sr: R.Result[R.Void, str] = args.selection_from_config(cli, ?pick);
    if (R.is_err[R.Void, str](sr)) {
        ret plan_failure(a, ps, outcome.user(R.unwrap_err[R.Void, str](sr)));
    }

    val res_req: R.Result[request.BuildRequest, outcome.Fail] = request.compose(a, ?ps.interner, ?m, cli, root, goal, ?pick);
    if (R.is_err[request.BuildRequest, outcome.Fail](res_req)) {
        ret plan_failure(a, ps, R.unwrap_err[request.BuildRequest, outcome.Fail](res_req));
    }

    val plan_r: R.Result[plan.BuildPlan, outcome.Fail] = plan.plan(ps.alloc, ?ps.interner, ?ps.registry, ?m,
        R.unwrap_ok[request.BuildRequest, outcome.Fail](res_req));
    if (R.is_err[plan.BuildPlan, outcome.Fail](plan_r)) {
        ret plan_failure(a, ps, R.unwrap_err[plan.BuildPlan, outcome.Fail](plan_r));
    }
    var bp: plan.BuildPlan = R.unwrap_ok[plan.BuildPlan, outcome.Fail](plan_r);

    if (configure_deps) {
        val configured: R.Result[R.Void, outcome.Fail] = plan.configure(ps, ?m, ?bp);
        if (R.is_err[R.Void, outcome.Fail](configured)) {
            ret plan_failure(a, ps, R.unwrap_err[R.Void, outcome.Fail](configured));
        }
    }
    ret R.ok[plan.BuildPlan, outcome.Fail](bp);
}

# tear the session down and return a failure whose message outlives it: a message
# the session allocated dies with `session.dnit`, and every caller renders it after
fun plan_failure(a: *A.Allocator, ps: *session.Session, failure: outcome.Fail) R.Result[plan.BuildPlan, outcome.Fail] {
    var stable: outcome.Fail = failure;
    if (failure.message != nil) {
        val copied: R.Result[str, str] = str_dup(a, failure.message);
        if (R.is_err[str, str](copied)) { stable = outcome.internal("failed to retain the build planning error"); }
        or { stable.message = R.unwrap_ok[str, str](copied); }
    }
    session.dnit(ps);
    ret R.err[plan.BuildPlan, outcome.Fail](stable);
}

# `mach build`: plan and execute a build of the project operand, rendering diagnostics and
# the outcome to stderr. `-O1` is refused before parsing; `--plan` prints the effective
# plan and stops without running a generator, a compiler or a linker; `-v` and `-vv`
# render the phase readout after the build
# ---
# argv: the full process arguments
# inv: the parsed invocation for this command
# ret: 0 success, 1 user error, 2 internal failure, 3 environment failure
pub fun run_typed(argv: **u8, inv: *args.ParsedInvocation) i64 {
    ret run_invocation(argv, inv, args.CMD_BUILD, request.GOAL_EXECUTE);
}

# `mach check`: plan the same cells `mach build` would and run each through the
# frontend only, load, resolve and sema, reporting the same diagnostics with the
# same classification. no build step runs, nothing is generated, compiled, linked
# or written, and a generated or embedded input that does not exist yet is an
# error naming it rather than a reason to run the step
# ---
# argv: the full process arguments
# inv: the parsed invocation for this command
# ret: 0 accepted, 1 rejected or user error, 2 internal failure, 3 environment failure
pub fun check_typed(argv: **u8, inv: *args.ParsedInvocation) i64 {
    if (inv.positional_count != 1) {
        val f: outcome.Fail = outcome.user("mach check expects one project path");
        ret cli_diag.render_fail(?f);
    }
    ret run_invocation(argv, inv, args.CMD_CHECK, request.GOAL_CHECK);
}

fun run_invocation(argv: **u8, inv: *args.ParsedInvocation, cmd: args.CommandId,
                   requested_goal: request.BuildGoal) i64 {
    var goal: request.BuildGoal = requested_goal;
    val opt_emit: O.Option[*u8] = args.invocation_value(cmd, inv, argv, "--emit");
    if (O.is_some[*u8](opt_emit)) {
        val kind: str = O.unwrap[*u8](opt_emit)::str;
        val goal_o: O.Option[request.BuildGoal] = request.goal_from_emit_name(kind);
        if (O.is_none[request.BuildGoal](goal_o)) {
            val f: outcome.Fail = outcome.user(request.EMIT_ERROR);
            ret cli_diag.render_fail(?f);
        }
        goal = O.unwrap[request.BuildGoal](goal_o);
    }

    var backing: A.Allocator;
    if (O.is_some[str](page.make(?backing))) {
        val f: outcome.Fail = outcome.internal("failed to initialise allocator");
        ret cli_diag.render_fail(?f);
    }

    val res_config: R.Result[args.CliArgs, str] = args.build_cli_invocation(cmd, inv, argv);
    if (R.is_err[args.CliArgs, str](res_config)) {
        val f: outcome.Fail = outcome.user(R.unwrap_err[args.CliArgs, str](res_config));
        ret cli_diag.render_fail(?f);
    }
    var config: args.CliArgs = R.unwrap_ok[args.CliArgs, str](res_config);
    if (config.bin != nil && config.lib != nil) {
        val f: outcome.Fail = outcome.user("--bin and --lib cannot be combined");
        ret cli_diag.render_fail(?f);
    }

    val plan_only: bool = args.invocation_flag(cmd, inv, "--plan");
    if (quiet_plan_conflict(config.quiet, plan_only)) {
        val f: outcome.Fail = outcome.user("`--plan` and `--quiet`/`-q` cannot be combined");
        ret cli_diag.render_fail(?f);
    }
    var command_name: str = "mach build";
    if (cmd == args.CMD_CHECK) { command_name = "mach check"; }
    if (args.reject_unknown_from_invocation(inv, argv, command_name)) { ret 1; }

    var arg: *u8 = nil;
    if (inv.has_positional) { arg = argv[inv.positional_idx]; }

    val loc_r: R.Result[util.ProjectLocation, str] = util.resolve_project_location(?backing, arg);
    if (R.is_err[util.ProjectLocation, str](loc_r)) {
        val f: outcome.Fail = outcome.user(R.unwrap_err[util.ProjectLocation, str](loc_r));
        ret cli_diag.render_fail(?f);
    }
    val loc: util.ProjectLocation = R.unwrap_ok[util.ProjectLocation, str](loc_r);
    val root: str = loc.root;

    val col_r: R.Result[R.Void, str] = args.collect_link_inputs(?backing, ?config, cmd, inv, argv);
    if (R.is_err[R.Void, str](col_r)) {
        val f: outcome.Fail = outcome.internal(R.unwrap_err[R.Void, str](col_r));
        ret cli_diag.render_fail(?f);
    }

    var menu_ar: arena.Arena;
    if (O.is_some[str](arena.init(?menu_ar, ?backing, 0))) {
        val f: outcome.Fail = outcome.internal("failed to initialise allocator");
        ret cli_diag.render_fail(?f);
    }
    var menu_alloc: A.Allocator;
    if (O.is_some[str](arena.make(?menu_alloc, ?menu_ar))) {
        arena.dnit(?menu_ar);
        val f: outcome.Fail = outcome.internal("failed to initialise allocator");
        ret cli_diag.render_fail(?f);
    }

    var ps: session.Session;
    val plan_r: R.Result[plan.BuildPlan, outcome.Fail] = plan_invocation(?menu_alloc, root, ?config, goal, plan_only, ?ps);
    if (R.is_err[plan.BuildPlan, outcome.Fail](plan_r)) {
        var f: outcome.Fail = R.unwrap_err[plan.BuildPlan, outcome.Fail](plan_r);
        val c: i64 = cli_diag.render_fail(?f);
        arena.dnit(?menu_ar);
        ret c;
    }
    val bp: plan.BuildPlan = R.unwrap_ok[plan.BuildPlan, outcome.Fail](plan_r);

    if (plan_only) {
        val shown: R.Result[R.Void, outcome.Fail] = plan.explain(?menu_alloc, ?bp, ?ps.interner);
        var code: i64 = 0;
        if (R.is_err[R.Void, outcome.Fail](shown)) {
            val failure: outcome.Fail = R.unwrap_err[R.Void, outcome.Fail](shown);
            code = cli_diag.render_fail(?failure);
        }
        session.dnit(?ps);
        arena.dnit(?menu_ar);
        ret code;
    }

    var pr: readout.Progress;
    var ev: *readout.Progress = nil;
    if (config.verbosity > 0) {
        readout.init(?pr, ?menu_alloc, config.verbosity);
        ev = ?pr;
    }

    val ex_r: R.Result[outcome.BuildOutcome, outcome.Fail] = engine.execute(?bp, ?backing, ?menu_alloc, ev);
    if (ev != nil) {
        readout.render(ev);
        readout.dnit(ev);
    }

    var code: i64 = 0;
    if (R.is_err[outcome.BuildOutcome, outcome.Fail](ex_r)) {
        var f: outcome.Fail = R.unwrap_err[outcome.BuildOutcome, outcome.Fail](ex_r);
        code = cli_diag.render_fail(?f);
    }
    or {
        var bo: outcome.BuildOutcome = R.unwrap_ok[outcome.BuildOutcome, outcome.Fail](ex_r);
        cli_diag.render_outcome(?bo, config.quiet);
        code = cli_diag.outcome_code(?bo);
        outcome.outcome_dnit(?bo);
    }

    session.dnit(?ps);
    arena.dnit(?menu_ar);
    ret code;
}

fun quiet_plan_conflict(quiet: bool, plan_only: bool) bool {
    ret quiet && plan_only;
}

fun t_build(argc: usize, argv: **u8) i64 {
    var a: A.Allocator;
    if (O.is_some[str](page.make(?a))) { ret 2; }
    val ir: R.Result[args.ParsedInvocation, str] = args.parse_invocation(?a, argc, argv);
    if (R.is_err[args.ParsedInvocation, str](ir)) { ret 2; }
    var inv: args.ParsedInvocation = R.unwrap_ok[args.ParsedInvocation, str](ir);
    ret run_typed(argv, ?inv);
}

test "mach.cli.cmd.build.quiet_plan_conflict:only_the_combination_conflicts" {
    if (!quiet_plan_conflict(true, true))  { ret 1; }
    if (quiet_plan_conflict(true, false))  { ret 2; }
    if (quiet_plan_conflict(false, true))  { ret 3; }
    if (quiet_plan_conflict(false, false)) { ret 4; }
    ret 0;
}

test "mach.cli.cmd.build.run_typed:rejects_quiet_combined_with_plan" {
    var argv: [4]*u8;
    argv[0] = "mach"; argv[1] = "build"; argv[2] = "--quiet"; argv[3] = "--plan";
    if (t_build(4, ?argv[0]) != 1) { ret 1; }

    var alias: [4]*u8;
    alias[0] = "mach"; alias[1] = "build"; alias[2] = "-q"; alias[3] = "--plan";
    if (t_build(4, ?alias[0]) != 1) { ret 2; }

    ret 0;
}

fun t_req_join(a: *A.Allocator, base: str, leaf: str) str {
    val r: R.Result[str, str] = path.join(a, base, leaf);
    if (R.is_err[str, str](r)) { ret base; }
    ret R.unwrap_ok[str, str](r);
}

fun t_req_write(a: *A.Allocator, dir: str, name: str, body: str) bool {
    if (O.is_some[str](fs.create_dir_all(a, dir, 0o755))) { ret false; }
    val p: str = t_req_join(a, dir, name);
    ret O.is_none[str](fs.write_bytes(p, body::*u8, str_len(body), 0o644));
}

val T_REQ_MANIFEST: str = "[project]\nid = \"reqfx\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.host]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[target.alt]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[artifact.shader-a]\nkind = \"static\"\nentry = \"shader.mach\"\nout = \"lib/shader-a.a\"\ntargets = [\"alt\"]\nlink = []\nneed = []\n\n[artifact.shader-b]\nkind = \"static\"\nentry = \"shader.mach\"\nout = \"lib/shader-b.a\"\ntargets = [\"alt\"]\nlink = []\nneed = []\n\n[artifact.app]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/app\"\ntargets = [\"host\"]\nlink = []\nneed = [\"artifact.shader-*\"]\n\n[profile.debug]\ndefault = true\nopt = 0\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n";

val T_REQ_SHADER: str = "pub fun tint(x: u64) u64 { ret x + 3; }\n";

val T_REQ_MAIN: str = "#[embed(\"{artifact.shader-a.out}\")]\nval SHADER: [_]u8;\n\n#[symbol(\"_start\")]\nfun start() {\n    var c: u64 = 1;\n    if (SHADER[0] == 0x21 && SHADER[1] == 0x3C && SHADER[6] == 0x3E && SHADER[7] == 0x0A) { c = 0; }\n    asm x86_64 {\n        mov rax, 60\n        mov rdi, {c}\n        syscall\n    }\n}\n";

fun t_req_exit_code(a: *A.Allocator, exe: str) i32 {
    var child: subprocess.OwnedSubprocess;
    subprocess.init(?child);
    var argv: [2]*u8;
    argv[0] = exe::*u8;
    argv[1] = nil;
    if (R.is_err[R.Void, str](subprocess.spawn(a, ?child, exe, ?argv[0], env.environ()))) {
        subprocess.dnit(a, ?child);
        ret -1;
    }
    val wr: R.Result[subprocess.SubprocessTerminal, str] = subprocess.wait(a, ?child);
    if (R.is_err[subprocess.SubprocessTerminal, str](wr)) {
        subprocess.dnit(a, ?child);
        ret -1;
    }
    val term: subprocess.SubprocessTerminal = R.unwrap_ok[subprocess.SubprocessTerminal, str](wr);
    subprocess.dnit(a, ?child);
    if (term.kind != subprocess.STATE_EXITED) { ret -1; }
    ret term.code;
}

test "mach.cli.cmd.build.run_typed:a_glob_requirement_builds_first_and_the_bin_embeds_its_output" {
    $if ($mach.build.os != $mach.os.linux)      { ret 0; }
    $if ($mach.build.arch != $mach.arch.x86_64) { ret 0; }

    var a: A.Allocator;
    if (O.is_some[str](page.make(?a))) { ret 1; }

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?a, "mach_build_artifact_need");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);
    val root: str = fs.temp_path(?tf);
    fs.temp_close_and_remove(?tf);
    if (O.is_some[str](fs.create_dir_all(?a, root, 0o755))) { ret 1; }

    var bad: i32 = 0;
    if (!t_req_write(?a, root, "mach.toml", T_REQ_MANIFEST)) { bad = 1; }
    val src_dir: str = t_req_join(?a, root, "src");
    if (!t_req_write(?a, src_dir, "shader.mach", T_REQ_SHADER)) { bad = 1; }
    if (!t_req_write(?a, src_dir, "main.mach", T_REQ_MAIN))     { bad = 1; }
    if (bad != 0) { fs.remove_all(?a, root); ret 1; }

    var argv: [5]*u8;
    argv[0] = "mach"::*u8; argv[1] = "build"::*u8; argv[2] = root::*u8;
    argv[3] = "--target"::*u8; argv[4] = "host"::*u8;
    if (t_build(5, ?argv[0]) != 0) { fs.remove_all(?a, root); ret 1; }

    val lib_a: str = t_req_join(?a, root, "out/alt/debug/lib/shader-a.a");
    val lib_b: str = t_req_join(?a, root, "out/alt/debug/lib/shader-b.a");
    val app:   str = t_req_join(?a, root, "out/host/debug/bin/app");
    if (!fs.is_file(lib_a)) { bad = 1; }
    if (!fs.is_file(lib_b)) { bad = 1; }
    if (!fs.is_file(app))   { bad = 1; }
    if (bad != 0) { fs.remove_all(?a, root); ret 1; }

    if (t_req_exit_code(?a, app) != 0) { bad = 1; }

    val out_dir: str = t_req_join(?a, root, "out");
    fs.remove_all(?a, out_dir);
    if (!t_req_write(?a, src_dir, "shader.mach", "pub fun tint(x: u64) u64 { ret nonesuch; }\n")) { bad = 1; }
    if (t_build(5, ?argv[0]) == 0) { bad = 1; }
    if (fs.is_file(app))           { bad = 1; }

    fs.remove_all(?a, root);
    ret bad;
}

test "mach.cli.cmd.build.run_typed:rejects_o1_before_any_side_effect_o0_and_o2_still_build" {
    val toml_body: str = "[project]\nid = \"rem102fx\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out\"\n\n[profile.test]\nopt = 0\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n\n[artifact.rem102fx]\nkind = \"static\"\nentry = \"lib.mach\"\nout = \"lib/rem102fx.a\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
    val src_body: str = "pub fun value() i64 {\n    ret 42;\n}\n";

    var a: A.Allocator;
    if (O.is_some[str](page.make(?a))) { ret 1; }

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?a, "mach_build_cmd_o1");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);
    val root: str = fs.temp_path(?tf);
    fs.temp_close_and_remove(?tf);
    if (O.is_some[str](fs.create_dir_all(?a, root, 0o755))) { ret 1; }

    val toml_path_r: R.Result[str, str] = path.join(?a, root, "mach.toml");
    if (R.is_err[str, str](toml_path_r)) { ret 1; }
    val toml_path: str = R.unwrap_ok[str, str](toml_path_r);
    if (O.is_some[str](fs.write_bytes(toml_path, toml_body::*u8, str_len(toml_body), 0o644))) { ret 1; }

    val src_dir_r: R.Result[str, str] = path.join(?a, root, "src");
    if (R.is_err[str, str](src_dir_r)) { ret 1; }
    val src_dir: str = R.unwrap_ok[str, str](src_dir_r);
    if (O.is_some[str](fs.create_dir_all(?a, src_dir, 0o755))) { ret 1; }
    val src_path_r: R.Result[str, str] = path.join(?a, src_dir, "lib.mach");
    if (R.is_err[str, str](src_path_r)) { ret 1; }
    val src_path: str = R.unwrap_ok[str, str](src_path_r);
    if (O.is_some[str](fs.write_bytes(src_path, src_body::*u8, str_len(src_body), 0o644))) { ret 1; }

    val out_dir_r: R.Result[str, str] = path.join(?a, root, "out");
    if (R.is_err[str, str](out_dir_r)) { ret 1; }
    val out_dir: str = R.unwrap_ok[str, str](out_dir_r);

    var bad: i32 = 0;

    var argv_o1: [4]*u8;
    argv_o1[0] = "mach"; argv_o1[1] = "build"; argv_o1[2] = "-O1"; argv_o1[3] = root::*u8;
    if (t_build(4, ?argv_o1[0]) != 1) { bad = 1; }
    if (fs.is_dir(out_dir))           { bad = 1; }

    var argv_o0: [4]*u8;
    argv_o0[0] = "mach"; argv_o0[1] = "build"; argv_o0[2] = "-O0"; argv_o0[3] = root::*u8;
    if (t_build(4, ?argv_o0[0]) != 0) { bad = 1; }
    if (!fs.is_dir(out_dir))          { bad = 1; }
    fs.remove_all(?a, out_dir);

    var argv_o2: [4]*u8;
    argv_o2[0] = "mach"; argv_o2[1] = "build"; argv_o2[2] = "-O2"; argv_o2[3] = root::*u8;
    if (t_build(4, ?argv_o2[0]) != 0) { bad = 1; }
    if (!fs.is_dir(out_dir))          { bad = 1; }

    fs.remove_all(?a, root);
    ret bad;
}

fun str_index(s: str, sub: str) usize {
    val at: O.Option[usize] = str_index_of(s, sub);
    if (O.is_none[usize](at)) { ret str_len(s); }
    ret O.unwrap[usize](at);
}

fun t_plan_cli(target: str, artifact: str, all_targets: bool) args.CliArgs {
    var cli: args.CliArgs;
    cli.target      = target;
    cli.bin         = artifact::*u8;
    if (str_empty(artifact)) { cli.bin = nil; }
    cli.all_targets = all_targets;
    ret cli;
}

fun t_text_sink_write(ctx: ptr, buf: *u8, len: usize) res[usize, writer.WriteError] {
    val sink: *Vector[u8] = ctx::*Vector[u8];
    var i: usize = 0;
    for (i < len) {
        val pushed: R.Result[usize, str] = vector.push[u8](sink, buf[i]);
        if (R.is_err[usize, str](pushed)) { ret res[usize, writer.WriteError].err{writer.native_failure(0, io_error.from_code(os.EIO, io_error.OP_WRITE))}; }
        i = i + 1;
    }
    ret res[usize, writer.WriteError].ok{len};
}

fun t_plan_text(a: *A.Allocator, root: str, cli: *args.CliArgs, configure_deps: bool,
                out_text: *str) R.Result[R.Void, outcome.Fail] {
    var ps: session.Session;
    val planned: R.Result[plan.BuildPlan, outcome.Fail] = plan_invocation(a, root, cli,
        request.GOAL_EXECUTE, configure_deps, ?ps);
    if (R.is_err[plan.BuildPlan, outcome.Fail](planned)) {
        ret R.err[R.Void, outcome.Fail](R.unwrap_err[plan.BuildPlan, outcome.Fail](planned));
    }
    var bp: plan.BuildPlan = R.unwrap_ok[plan.BuildPlan, outcome.Fail](planned);

    var sink: Vector[u8] = vector.init[u8](a);
    var w: writer.Writer;
    w.ctx     = (?sink)::ptr;
    w.f_write = t_text_sink_write;
    val rendered: R.Result[R.Void, outcome.Fail] = plan.render(a, ?w, ?bp, ?ps.interner);
    session.dnit(?ps);
    if (R.is_err[R.Void, outcome.Fail](rendered)) { ret rendered; }

    val terminated: R.Result[usize, str] = vector.push[u8](?sink, 0);
    if (R.is_err[usize, str](terminated)) { ret R.err[R.Void, outcome.Fail](outcome.internal("out of memory")); }
    @out_text = sink.data::str;
    ret R.ok_void[outcome.Fail]();
}

val T_PLAN_MANIFEST: str = "[project]\nid = \"planfx\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.host]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[target.win]\nisa = \"x86_64\"\nos = \"windows\"\nabi = \"win64\"\n\n[artifact.support]\nkind = \"static\"\nentry = \"support.mach\"\nout = \"lib/libsupport{artifact.suffix}\"\ntargets = [\"*\"]\nlink = []\nneed = []\n\n[artifact.app]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/app{artifact.suffix}\"\ntargets = [\"*\"]\nlink = []\nneed = [\"artifact.support\", \"step.generate\"]\n\n[step.generate]\nargv = [\"sh\", \"-c\", \"printf generated > {project.out}/generated.txt\"]\nin = []\nout = [\"{project.out}/generated.txt\"]\nneed = [\"step.prepare\"]\n\n[step.prepare]\nargv = [\"sh\", \"-c\", \"printf prepared > {project.out}/prepared.txt\"]\nin = []\nout = [\"{project.out}/prepared.txt\"]\nneed = []\n\n[profile.debug]\ndefault = true\nopt = 0\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n";

val T_PLAN_SUPPORT: str = "pub fun tint(x: u64) u64 { ret x + 3; }\n";

val T_PLAN_MAIN: str = "#[symbol(\"_start\")]\nfun start() {\n    asm x86_64 {\n        mov rax, 60\n        mov rdi, 0\n        syscall\n    }\n}\n";

fun t_plan_scaffold(a: *A.Allocator, manifest_text: str, out_root: *str) bool {
    val created: R.Result[fs.TempFile, str] = fs.temp_create(a, "mach_plan_case");
    if (R.is_err[fs.TempFile, str](created)) { ret false; }
    var temporary: fs.TempFile = R.unwrap_ok[fs.TempFile, str](created);
    val root: str = fs.temp_path(?temporary);
    fs.temp_close_and_remove(?temporary);
    if (O.is_some[str](fs.create_dir_all(a, root, 0o755))) { ret false; }
    @out_root = root;
    if (!t_req_write(a, root, "mach.toml", manifest_text)) { ret false; }
    val src: str = t_req_join(a, root, "src");
    if (!t_req_write(a, src, "support.mach", T_PLAN_SUPPORT)) { ret false; }
    ret t_req_write(a, src, "main.mach", T_PLAN_MAIN);
}

test "mach.cli.cmd.build.plan:displays_the_selection_the_build_produces_and_executes_nothing" {
    $if ($mach.build.os != $mach.os.linux)      { ret 0; }
    $if ($mach.build.arch != $mach.arch.x86_64) { ret 0; }
    var a: A.Allocator;
    if (O.is_some[str](page.make(?a))) { ret 1; }
    var root: str = "";
    if (!t_plan_scaffold(?a, T_PLAN_MANIFEST, ?root)) { ret 2; }
    fin { fs.remove_all(?a, root); }

    var cli: args.CliArgs = t_plan_cli("", "", true);
    var text: str = "";
    val rendered: R.Result[R.Void, outcome.Fail] = t_plan_text(?a, root, ?cli, true, ?text);
    if (R.is_err[R.Void, outcome.Fail](rendered)) { ret 3; }

    # every declared cell, its entry, its derived suffix and its prerequisite order
    if (!str_contains(text, "project: planfx")) { ret 4; }
    if (!str_contains(text, "units:   4"))      { ret 5; }
    if (!str_contains(text, "  entry   main.mach"))    { ret 6; }
    if (!str_contains(text, "  entry   support.mach")) { ret 7; }
    if (!str_contains(text, "/out/host/debug/bin/app\n"))     { ret 8; }
    if (!str_contains(text, "/out/win/debug/bin/app.exe\n"))  { ret 9; }
    if (!str_contains(text, "/out/host/debug/lib/libsupport.a\n"))   { ret 10; }
    if (!str_contains(text, "/out/win/debug/lib/libsupport.lib\n")) { ret 11; }
    if (!str_contains(text, "  need    artifact support"))   { ret 12; }
    if (!str_contains(text, "  step    project prepare"))    { ret 13; }
    if (!str_contains(text, "  step    project generate"))   { ret 14; }
    if (str_index(text, "  step    project prepare") > str_index(text, "  step    project generate")) { ret 15; }
    if (!str_contains(text, "generated bytes are unresolved")) { ret 16; }
    if (!str_contains(text, "it does not claim the link succeeds")) { ret 17; }
    if (str_contains(text, "not configured against the dependency closure")) { ret 18; }

    # nothing ran: no step output, no object, IR or assembly tree, no artifact
    if (fs.exists(t_req_join(?a, root, "out"))) { ret 19; }

    # the build that follows produces exactly the paths the plan named
    var argv: [5]*u8;
    argv[0] = "mach"::*u8; argv[1] = "build"::*u8; argv[2] = root::*u8;
    argv[3] = "--target"::*u8; argv[4] = "host"::*u8;
    if (t_build(5, ?argv[0]) != 0) { ret 20; }
    if (!fs.is_file(t_req_join(?a, root, "out/host/debug/bin/app")))          { ret 21; }
    if (!fs.is_file(t_req_join(?a, root, "out/host/debug/lib/libsupport.a"))) { ret 22; }
    if (!fs.is_file(t_req_join(?a, root, "out/host/debug/generated.txt")))    { ret 23; }
    if (!fs.is_file(t_req_join(?a, root, "out/host/debug/prepared.txt")))     { ret 24; }
    ret 0;
}

test "mach.cli.cmd.build.plan:an_unconfigured_plan_does_not_claim_an_empty_dependency_closure" {
    var a: A.Allocator;
    if (O.is_some[str](page.make(?a))) { ret 1; }
    var root: str = "";
    if (!t_plan_scaffold(?a, T_PLAN_MANIFEST, ?root)) { ret 2; }
    fin { fs.remove_all(?a, root); }
    var cli: args.CliArgs = t_plan_cli("host", "app", false);
    var text: str = "";
    if (R.is_err[R.Void, outcome.Fail](t_plan_text(?a, root, ?cli, false, ?text))) { ret 3; }
    if (!str_contains(text, "not configured against the dependency closure")) { ret 4; }
    if (fs.exists(t_req_join(?a, root, "out"))) { ret 5; }
    ret 0;
}

test "mach.cli.cmd.build.plan:dependency_prerequisites_missing_realizations_and_cycles_use_the_shared_service" {
    var a: A.Allocator;
    if (O.is_some[str](page.make(?a))) { ret 1; }
    var root: str = "";
    val with_dep: str = plan.join_msg(?a, T_PLAN_MANIFEST, "\n[dep.vendor]\npath = \"../source-must-not-be-read\"\n");
    if (!t_plan_scaffold(?a, with_dep, ?root)) { ret 2; }
    fin { fs.remove_all(?a, root); }
    var cli: args.CliArgs = t_plan_cli("host", "app", false);
    var text: str = "";

    # a dependency that is not realized fails planning exactly as a build fails it
    val missing: R.Result[R.Void, outcome.Fail] = t_plan_text(?a, root, ?cli, true, ?text);
    if (R.is_ok[R.Void, outcome.Fail](missing)) { ret 3; }
    var failure: outcome.Fail = R.unwrap_err[R.Void, outcome.Fail](missing);
    if (failure.kind != outcome.FAIL_USER) { ret 4; }
    if (!str_contains(failure.message, "is not resolved (missing")) { ret 5; }
    if (fs.exists(t_req_join(?a, root, "dep/vendor")) || fs.exists(t_req_join(?a, root, "out"))) { ret 6; }

    # the same realized dependency's exported steps and link requirements, in order
    val dep_root: str = t_req_join(?a, root, "dep/vendor");
    val dep_manifest: str = "[project]\nid = \"vendor\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out\"\n[profile.debug]\ndefault = true\nopt = 0\ndebug = false\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n[artifact.vendor]\nkind = \"static\"\ndefault = true\nentry = \"public.mach\"\nout = \"lib/vendor.a\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[link.generated]\nsource = \"local\"\npath = \"{project.out}/vendor.o\"\nos = [\"*\"]\nisa = [\"*\"]\nabi = [\"*\"]\nexport = true\n[step.first]\nargv = [\"sh\", \"-c\", \"printf ran > {project.out}/dep-first.txt\"]\nin = []\nout = [\"{project.out}/dep-first.txt\"]\nneed = []\n[step.object]\nargv = [\"sh\", \"-c\", \"printf ran > {project.out}/vendor.o\"]\nin = []\nout = [\"{project.out}/vendor.o\"]\nneed = [\"step.first\"]\n";
    if (!t_req_write(?a, dep_root, "mach.toml", dep_manifest)) { ret 7; }
    if (!t_req_write(?a, t_req_join(?a, dep_root, "src"), "public.mach", "this is deliberately not Mach source\n")) { ret 8; }

    if (R.is_err[R.Void, outcome.Fail](t_plan_text(?a, root, ?cli, true, ?text))) { ret 9; }
    if (!str_contains(text, "  step    dependency vendor.first"))  { ret 10; }
    if (!str_contains(text, "  step    dependency vendor.object")) { ret 11; }
    if (str_index(text, "vendor.first") > str_index(text, "vendor.object")) { ret 12; }
    if (!str_contains(text, "  link    dependency export "))       { ret 13; }
    if (!str_contains(text, "vendor.o"))                           { ret 14; }
    # the dependency's exported steps precede the project's own
    if (str_index(text, "  step    dependency vendor.object") > str_index(text, "  step    project prepare")) { ret 15; }
    # neither the dependency's steps nor the project's ran, and its source was never read
    if (fs.exists(t_req_join(?a, root, "out")) || fs.exists(t_req_join(?a, dep_root, "out"))) { ret 16; }

    # a dependency cycle is the shared service's diagnostic, not a planner-local one
    val cyclic: str = plan.join_msg(?a, dep_manifest, "\n[dep.planfx]\npath = \"../..\"\n");
    if (!t_req_write(?a, dep_root, "mach.toml", cyclic)) { ret 17; }
    val cycle: R.Result[R.Void, outcome.Fail] = t_plan_text(?a, root, ?cli, true, ?text);
    if (R.is_ok[R.Void, outcome.Fail](cycle)) { ret 18; }
    failure = R.unwrap_err[R.Void, outcome.Fail](cycle);
    if (failure.kind != outcome.FAIL_USER) { ret 19; }
    if (fs.exists(t_req_join(?a, root, "out"))) { ret 20; }

    # an invalid root manifest is the manifest diagnostic, reported before any cell
    if (!t_req_write(?a, root, "mach.toml", "[project]\nid = \"planfx\"\n")) { ret 21; }
    val invalid: R.Result[R.Void, outcome.Fail] = t_plan_text(?a, root, ?cli, true, ?text);
    if (R.is_ok[R.Void, outcome.Fail](invalid)) { ret 22; }
    failure = R.unwrap_err[R.Void, outcome.Fail](invalid);
    if (failure.kind != outcome.FAIL_USER || !str_contains(failure.message, "mach.toml:")) { ret 23; }
    ret 0;
}

test "mach.cli.cmd.build.plan_failure:the_message_outlives_the_session_it_came_from" {
    var a: A.Allocator;
    if (O.is_some[str](page.make(?a))) { ret 1; }
    val initialized: R.Result[session.Session, str] = session.init(?a);
    if (R.is_err[session.Session, str](initialized)) { ret 2; }
    var s: session.Session = R.unwrap_ok[session.Session, str](initialized);
    val copied: R.Result[str, str] = str_dup(s.alloc, "owned planning failure");
    if (R.is_err[str, str](copied)) { session.dnit(?s); ret 3; }
    val session_owned: str = R.unwrap_ok[str, str](copied);
    val result: R.Result[plan.BuildPlan, outcome.Fail] = plan_failure(?a, ?s, outcome.user(session_owned));
    if (R.is_ok[plan.BuildPlan, outcome.Fail](result)) { ret 4; }
    val failure: outcome.Fail = R.unwrap_err[plan.BuildPlan, outcome.Fail](result);
    if (failure.message == session_owned || failure.kind != outcome.FAIL_USER) { ret 5; }
    val intact: bool = str_equals(failure.message, "owned planning failure");
    str_free(?a, failure.message);
    if (!intact) { ret 6; }
    ret 0;
}

test "mach.cli.cmd.build.run_typed:plan_prints_every_cell_and_writes_nothing" {
    var a: A.Allocator;
    if (O.is_some[str](page.make(?a))) { ret 1; }
    var root: str = "";
    if (!t_plan_scaffold(?a, T_PLAN_MANIFEST, ?root)) { ret 2; }
    fin { fs.remove_all(?a, root); }
    var argv: [5]*u8;
    argv[0] = "mach"::*u8; argv[1] = "build"::*u8; argv[2] = root::*u8;
    argv[3] = "--all-targets"::*u8; argv[4] = "--plan"::*u8;
    if (t_build(5, ?argv[0]) != 0) { ret 3; }
    if (fs.exists(t_req_join(?a, root, "out"))) { ret 4; }
    val listed: R.Result[Vector[str], str] = fs.read_dir(?a, root);
    if (R.is_err[Vector[str], str](listed)) { ret 5; }
    var names: Vector[str] = R.unwrap_ok[Vector[str], str](listed);
    var i: usize = 0;
    for (i < names.len) {
        val entry: str = names.data[i];
        if (!str_equals(entry, ".") && !str_equals(entry, "..") && !str_equals(entry, "mach.toml") && !str_equals(entry, "src")) { ret 6; }
        i = i + 1;
    }
    ret 0;
}

fun t_check(argc: usize, argv: **u8) i64 {
    var a: A.Allocator;
    if (O.is_some[str](page.make(?a))) { ret 2; }
    val parsed: R.Result[args.ParsedInvocation, str] = args.parse_invocation(?a, argc, argv);
    if (R.is_err[args.ParsedInvocation, str](parsed)) { ret 2; }
    var inv: args.ParsedInvocation = R.unwrap_ok[args.ParsedInvocation, str](parsed);
    ret check_typed(argv, ?inv);
}

fun t_root_holds_only_sources(a: *A.Allocator, root: str) bool {
    val listed: R.Result[Vector[str], str] = fs.read_dir(a, root);
    if (R.is_err[Vector[str], str](listed)) { ret false; }
    var names: Vector[str] = R.unwrap_ok[Vector[str], str](listed);
    var i: usize = 0;
    for (i < names.len) {
        val entry: str = names.data[i];
        if (!str_equals(entry, ".") && !str_equals(entry, "..") && !str_equals(entry, "mach.toml")
            && !str_equals(entry, "src") && !str_equals(entry, "dep")) { ret false; }
        i = i + 1;
    }
    ret true;
}

val T_CHECK_MAIN_OK: str = "use planfx.support;\n\n#[symbol(\"_start\")]\nfun start() {\n    val t: u64 = support.tint(1);\n    asm x86_64 {\n        mov rax, 60\n        mov rdi, {t}\n        syscall\n    }\n}\n";

test "mach.cli.cmd.build.check_typed:checks_the_selected_graph_and_runs_no_step" {
    var a: A.Allocator;
    if (O.is_some[str](page.make(?a))) { ret 1; }
    var root: str = "";
    if (!t_plan_scaffold(?a, T_PLAN_MANIFEST, ?root)) { ret 2; }
    fin { fs.remove_all(?a, root); }
    val src: str = t_req_join(?a, root, "src");
    if (!t_req_write(?a, src, "main.mach", T_CHECK_MAIN_OK)) { ret 3; }
    if (!t_req_write(?a, src, "unselected.mach", "this file is never imported and is deliberately not Mach\n")) { ret 4; }

    var argv: [5]*u8;
    argv[0] = "mach"::*u8; argv[1] = "check"::*u8; argv[2] = root::*u8;
    argv[3] = "--target"::*u8; argv[4] = "host"::*u8;

    # accepted: both artifacts on the target, the reachable graph only; the two
    # steps app needs never ran and nothing was written
    if (t_check(5, ?argv[0]) != 0) { ret 5; }
    if (fs.exists(t_req_join(?a, root, "out")) || !t_root_holds_only_sources(?a, root)) { ret 6; }

    # rejected by sema: a name that does not resolve in the selected entry
    if (!t_req_write(?a, src, "main.mach", "use planfx.support;\nfun start() u64 { ret support.absent(1); }\n")) { ret 7; }
    if (t_check(5, ?argv[0]) != 1) { ret 8; }
    if (fs.exists(t_req_join(?a, root, "out"))) { ret 9; }

    # rejected by the parser
    if (!t_req_write(?a, src, "main.mach", "fun start( {\n")) { ret 10; }
    if (t_check(5, ?argv[0]) != 1) { ret 11; }

    # rejected by resolution: an import of a module that does not exist
    if (!t_req_write(?a, src, "main.mach", "use planfx.generated;\nfun start() u64 { ret 0; }\n")) { ret 12; }
    if (t_check(5, ?argv[0]) != 1) { ret 13; }

    # narrowing to the library artifact leaves the broken binary entry unread
    var narrowed: [7]*u8;
    narrowed[0] = "mach"::*u8; narrowed[1] = "check"::*u8; narrowed[2] = root::*u8;
    narrowed[3] = "--target"::*u8; narrowed[4] = "host"::*u8; narrowed[5] = "--lib"::*u8; narrowed[6] = "support"::*u8;
    if (t_check(7, ?narrowed[0]) != 0) { ret 14; }
    narrowed[5] = "--bin"::*u8; narrowed[6] = "app"::*u8;
    if (t_check(7, ?narrowed[0]) != 1) { ret 15; }

    # a malformed manifest is a user error before any source is read
    if (!t_req_write(?a, root, "mach.toml", "[project]\nid = \"planfx\"\n")) { ret 16; }
    if (t_check(5, ?argv[0]) != 1) { ret 17; }
    if (fs.exists(t_req_join(?a, root, "out"))) { ret 18; }
    ret 0;
}

test "mach.cli.cmd.build.check_typed:a_missing_generated_input_is_reported_not_produced" {
    $if ($mach.build.os != $mach.os.linux)      { ret 0; }
    $if ($mach.build.arch != $mach.arch.x86_64) { ret 0; }
    var a: A.Allocator;
    if (O.is_some[str](page.make(?a))) { ret 1; }
    val created: R.Result[fs.TempFile, str] = fs.temp_create(?a, "mach_check_generated");
    if (R.is_err[fs.TempFile, str](created)) { ret 2; }
    var temporary: fs.TempFile = R.unwrap_ok[fs.TempFile, str](created);
    val root: str = fs.temp_path(?temporary);
    fs.temp_close_and_remove(?temporary);
    fin { fs.remove_all(?a, root); }
    val src: str = t_req_join(?a, root, "src");
    if (!t_req_write(?a, root, "mach.toml", T_REQ_MANIFEST)
        || !t_req_write(?a, src, "shader.mach", T_REQ_SHADER)
        || !t_req_write(?a, src, "main.mach", T_REQ_MAIN)) { ret 3; }

    # main embeds the output of the required artifact shader-a, which only a build produces
    var argv: [5]*u8;
    argv[0] = "mach"::*u8; argv[1] = "check"::*u8; argv[2] = root::*u8;
    argv[3] = "--target"::*u8; argv[4] = "host"::*u8;
    if (t_check(5, ?argv[0]) != 1) { ret 4; }
    if (fs.exists(t_req_join(?a, root, "out"))) { ret 5; }

    # the build produces it, and the same check then accepts the same source
    var build_argv: [5]*u8;
    build_argv[0] = "mach"::*u8; build_argv[1] = "build"::*u8; build_argv[2] = root::*u8;
    build_argv[3] = "--target"::*u8; build_argv[4] = "host"::*u8;
    if (t_build(5, ?build_argv[0]) != 0) { ret 6; }
    if (!fs.is_file(t_req_join(?a, root, "out/alt/debug/lib/shader-a.a"))) { ret 7; }
    if (t_check(5, ?argv[0]) != 0) { ret 8; }
    ret 0;
}

test "mach.cli.cmd.build.check_typed:requires_one_path_and_refuses_output_options" {
    var argv: [5]*u8;
    argv[0] = "mach"::*u8; argv[1] = "check"::*u8; argv[2] = "."::*u8;
    argv[3] = "-o"::*u8; argv[4] = "bin/unexpected"::*u8;
    if (t_check(2, ?argv[0]) != 1) { ret 1; }
    if (t_check(5, ?argv[0]) != 1) { ret 2; }
    argv[3] = "--emit-ir"::*u8;
    if (t_check(4, ?argv[0]) != 1) { ret 3; }
    argv[3] = "second-project"::*u8;
    if (t_check(4, ?argv[0]) != 1) { ret 4; }
    ret 0;
}

test "mach.cli.cmd.build.check:the_outcome_carries_located_diagnostics_and_a_typed_classification" {
    var a: A.Allocator;
    if (O.is_some[str](page.make(?a))) { ret 1; }
    var root: str = "";
    if (!t_plan_scaffold(?a, T_PLAN_MANIFEST, ?root)) { ret 2; }
    fin { fs.remove_all(?a, root); }
    val src: str = t_req_join(?a, root, "src");
    if (!t_req_write(?a, src, "main.mach", "use planfx.support;\nfun start() u64 { ret support.absent(1); }\n")) { ret 3; }

    var cli: args.CliArgs = t_plan_cli("host", "app", false);
    var ps: session.Session;
    val planned: R.Result[plan.BuildPlan, outcome.Fail] = plan_invocation(?a, root, ?cli, request.GOAL_CHECK, false, ?ps);
    if (R.is_err[plan.BuildPlan, outcome.Fail](planned)) { ret 4; }
    var bp: plan.BuildPlan = R.unwrap_ok[plan.BuildPlan, outcome.Fail](planned);
    fin { session.dnit(?ps); }
    # the selected binary and the artifact it requires are both checked, neither built
    if (bp.units.len != 2) { ret 5; }
    var ui: usize = 0;
    for (ui < bp.units.len) {
        val unit: *plan.BuildUnit = ?bp.units.data[ui];
        if (unit.goal != request.GOAL_CHECK) { ret 6; }
        if (unit.phases.len != 2 || unit.phases.data[0] != plan.PH_LOAD || unit.phases.data[1] != plan.PH_SEMA) { ret 6; }
        if (!str_empty(unit.out_path)) { ret 7; }
        ui = ui + 1;
    }

    var oa: A.Allocator;
    if (O.is_some[str](page.make(?oa))) { ret 8; }
    val executed: R.Result[outcome.BuildOutcome, outcome.Fail] = engine.execute(?bp, ?a, ?oa, nil);
    if (R.is_err[outcome.BuildOutcome, outcome.Fail](executed)) { ret 9; }
    var bo: outcome.BuildOutcome = R.unwrap_ok[outcome.BuildOutcome, outcome.Fail](executed);
    fin { outcome.outcome_dnit(?bo); }
    if (bo.severity != outcome.BUILD_USER) { ret 10; }
    if (cli_diag.outcome_code(?bo) != 1) { ret 11; }
    if (bo.artifacts.len != 0) { ret 12; }

    var located: bool = false;
    var i: usize = 0;
    for (i < bo.events.len) {
        val ev: *outcome.BuildEvent = ?bo.events.data[i];
        if (ev.kind == outcome.BUILD_EVENT_DIAGNOSTICS) {
            val diags: *diagnostic.DiagnosticStore = ev.data.diagnostics.diags;
            var j: usize = 0;
            for (j < diagnostic.len(diags)) {
                val d: *diagnostic.Diagnostic = ?diags.items.data[j];
                if (d.severity == diagnostic.SEVERITY_ERROR && d.loc.file_id != source.FILE_NIL && d.loc.span.len > 0) { located = true; }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    if (!located) { ret 13; }
    if (fs.exists(t_req_join(?a, root, "out"))) { ret 14; }
    ret 0;
}
