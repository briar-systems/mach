# `mach check`
pub val CHECK: args.CommandSpec = args.CommandSpec{name: "check", aliases: nil, alias_n: 0, grammar: " <path> [options]", summary: "check project source without building", effect: "parse, resolve and type-check the source reachable from the selected artifacts through the frontend; no build step runs and nothing is generated, compiled, linked or written", exits: ?CHECK_EXITS[0], exit_n: CHECK_EXITS_N, terminator: "", tables: ?CHECK_TABLES[0], table_n: CHECK_TABLES_N, refused: nil, refused_n: 0, refusal: "", relations: nil, relation_n: 0, constraints: ?CHECK_CONSTRAINTS[0], constraint_n: CHECK_CONSTRAINTS_N, operand_min: 1, operand_max: 1, truncate_at_sep: false, actions: nil, action_n: 0, examples: nil, example_n: 0, run: check};

# a command's selection, planned: the cells the selectors resolved to, and one
# plan per selected profile in the order the cells name them
# ---
# cells: the resolved (artifact, target, profile) cells
# plans: one plan per profile; each plans that profile's cells
pub rec Planned {
    cells: Vector[manifest.Cell];
    plans: Vector[build_plan.BuildPlan];
}

# initialise a session, load the manifest, resolve the selectors and plan a
# build of every resolved cell, one plan per profile
# ---
# a:              allocator for the request
# root:           the project root directory
# cli:            the parsed arguments
# goal:           what to produce, objects or the finished artifact
# mode:           how an artifact axis given no pattern is filled without `--all`
# configure_deps: also resolve every cell against the realized dependency closure,
#                 filling in its exported dependency steps and export link requirements. a build
#                 that goes on to execute resolves each cell as it runs it, so only a caller that
#                 reports the plan instead of running it asks for this
# ps:             out; the session the plans refer to, initialised here; on an error it has already been
#                 torn down and the returned failure message is owned by `a`
# ret:            the plans, or a Fail: internal for session or registry setup, user for manifest,
#                 selection, request and dependency-configuration errors, `-o` over several cells,
#                 and whatever planning returns
pub fun plan_invocation(a: *A.Allocator, root: str, cli: *args.CliArgs, goal: request.BuildGoal,
    mode: manifest.ArtifactDefault, configure_deps: bool, ps: *session.Session) res[Planned, fail.Fail] {
    val res_session: res[session.Session, fail.Fail] = toolchain.session_init(a);
    if (sel res_session.err) {
        ret res[Planned, fail.Fail].err{fail.message("failed to initialise compiler session")};
    }
    @ps = res_session.ok;

    val res_manifest: res[manifest.Manifest, fail.Fail] = driver.load_manifest(ps, root);
    if (sel res_manifest.err) {
        ret plan_failure(a, ps, res_manifest.err);
    }
    var m: manifest.Manifest = res_manifest.ok;
    if (cli.work != nil) {
        val worked: err[fail.Fail] = request.work_apply(?ps.interner, cli.work::str, ?m);
        if (sel worked.err) { ret plan_failure(a, ps, worked.err); }
    }

    val resolved: res[Vector[manifest.Cell], fail.Fail] = manifest.resolve_cells(ps.alloc, ?ps.interner, ?m, ?cli.selectors, mode);
    if (sel resolved.err) {
        ret plan_failure(a, ps, args.selection_hint(ps.alloc, ?cli.selectors, resolved.err));
    }
    var planned: Planned;
    planned.cells = resolved.ok;
    planned.plans = collections_vector.init[build_plan.BuildPlan](ps.alloc);
    if (cli.output != nil && planned.cells.len != 1) {
        ret plan_failure(a, ps, manifest.single_selection_fail(ps.alloc, diagnostic_kind.OUTPUT_AMBIGUOUS, "-o names one output", ?planned.cells));
    }

    var first: usize = 0;
    for (first < planned.cells.len) {
        val profile: str                   = planned.cells.data[first].profile;
        var group:   Vector[manifest.Cell] = collections_vector.init[manifest.Cell](ps.alloc);
        var next:    usize                 = first;
        for (next < planned.cells.len && str_equals(planned.cells.data[next].profile, profile)) {
            collections_vector.push[manifest.Cell](?group, planned.cells.data[next]);
            next = next + 1;
        }
        first = next;

        val res_req: res[request.BuildRequest, fail.Fail] = request.compose(a, ?ps.interner, ?m, cli, root, goal, profile);
        if (sel res_req.err) {
            ret plan_failure(a, ps, res_req.err);
        }
        val res_register: res[*lang_target.TargetRegistry, fail.Fail] = toolchain.registry();
        if (sel res_register.err) {
            ret plan_failure(a, ps, res_register.err);
        }
        val plan_r: res[build_plan.BuildPlan, fail.Fail] = build_plan.plan_cells(ps.alloc, ?ps.interner, res_register.ok, ?m,
            res_req.ok, ?group);
        if (sel plan_r.err) {
            ret plan_failure(a, ps, plan_r.err);
        }
        var bp: build_plan.BuildPlan = plan_r.ok;

        val required: err[fail.Fail] = build_plan.plan_dependency_requirements(ps, ?m, ?bp);
        if (sel required.err) {
            ret plan_failure(a, ps, required.err);
        }

        if (configure_deps) {
            val configured: err[fail.Fail] = build_plan.configure(ps, ?m, ?bp);
            if (sel configured.err) {
                ret plan_failure(a, ps, configured.err);
            }
        }
        val pushed: res[usize, A.Error] = collections_vector.push[build_plan.BuildPlan](?planned.plans, bp);
        if (sel pushed.err) {
            ret plan_failure(a, ps, fail.refused(pushed.err));
        }
    }
    val disjoint: err[fail.Fail] = build_plan.check_plan_outputs(ps.alloc, ?planned.plans);
    if (sel disjoint.err) {
        ret plan_failure(a, ps, disjoint.err);
    }
    ret res[Planned, fail.Fail].ok{planned};
}

# a build that changes its profile names where its artifacts go: with neither
# `-o` nor `-w` it would write them over the profile's own, and with `-w` alone
# every artifact it writes must sit in the work directory `-w` moves
fun overrides_placed(a: *A.Allocator, cli: *args.CliArgs, planned: *Planned) err[fail.Fail] {
    if (cli.output != nil) { ret err[fail.Fail].ok{}; }
    var pi: usize = 0;
    for (pi < planned.plans.len) {
        val bp: *build_plan.BuildPlan = ?planned.plans.data[pi];
        pi = pi + 1;
        if (!bp.request.overrides) { cnt; }
        if (cli.work == nil) {
            ret err[fail.Fail].err{fail.user(diagnostic_kind.CLI_FLAG_CONFLICT, OVERRIDE_REFUSAL)};
        }
        var ui: usize = 0;
        for (ui < bp.units.len) {
            val u: *build_plan.BuildUnit = ?bp.units.data[ui];
            ui = ui + 1;
            if (str_empty(u.out_path) || build_plan.under_dir(u.out_path, u.out_dir)) { cnt; }
            ret err[fail.Fail].err{fail.formatted_user(a, diagnostic_kind.CLI_FLAG_CONFLICT,
                "these options would write a differently configured build over the profile's existing artifacts: '{}' is written outside the work directory, so -w does not move it; name its path with -o", u.out_path)};
        }
    }
    ret err[fail.Fail].ok{};
}

val OVERRIDE_REFUSAL: str = "these options would write a differently configured build over the profile's existing artifacts; name an artifact path with -o or a work directory with -w";

# name the profile a plan builds before its progress lines, when a selection
# spans several profiles and the report is for a person
# ---
# r:       the report
# planned: the planned selection
# bp:      the plan about to run
# quiet:   `--quiet`
pub fun announce_profile(r: *cli_diagnostic.Report, planned: *Planned, bp: *build_plan.BuildPlan, quiet: bool) {
    if (quiet || planned.plans.len < 2 || r.format != cli_diagnostic.FORMAT_HUMAN) { ret; }
    std_format.write_str(?r.w, "profile ");
    std_format.write_str(?r.w, bp.request.profile);
    std_format.write_str(?r.w, ":\n");
}

# tear the session down and return a failure whose message outlives it: a message
# the session allocated dies with `session.dnit`, and every caller renders it after
fun plan_failure(a: *A.Allocator, ps: *session.Session, failure: fail.Fail) res[Planned, fail.Fail] {
    var stable: fail.Fail               = fail.message("failed to retain the build planning error");
    val kept:   res[fail.Fail, A.Error] = fail.retain(a, failure);
    if (sel kept.ok) { stable = kept.ok; }
    session.dnit(ps);
    ret res[Planned, fail.Fail].err{stable};
}

# `mach build`: plan and execute a build of the project operand, rendering diagnostics to
# stderr as each unit reports them. `--plan` prints the
# effective plan and stops without running a generator, a compiler or a linker; `-v` adds
# each phase row as the phase finishes, and `-vv` each module or file as it finishes
# ---
# cx:  the call
# ret: 0 success, 1 user error, 2 internal failure, 3 environment failure; every failure is
#      reported on the call's report with the phase it came from
pub fun run(cx: *args.Call) res[i64, fail.Fail] {
    ret res[i64, fail.Fail].ok{run_reported(cx, request.GOAL_ARTIFACT)};
}

# `mach check`: plan the same cells `mach build` would and run each through the
# frontend only, load, resolve and sema, reporting the same diagnostics with the
# same classification. no build step runs, nothing is generated, compiled, linked
# or written, and a generated or embedded input that does not exist yet is an
# error naming it rather than a reason to run the step
# ---
# cx:  the call
# ret: 0 accepted, 1 rejected or user error, 2 internal failure, 3 environment failure
pub fun check(cx: *args.Call) res[i64, fail.Fail] {
    ret res[i64, fail.Fail].ok{run_reported(cx, request.GOAL_CHECK)};
}

fun run_reported(cx: *args.Call, requested_goal: request.BuildGoal) i64 {
    val r:        *cli_diagnostic.Report = cx.report;
    val inv:      *args.ParsedInvocation = cx.inv;
    val argv:     **u8                   = cx.argv;
    var goal:     request.BuildGoal      = requested_goal;
    val opt_emit: opt[*u8]               = args.value(inv, argv, ?args.EMIT);
    if (sel opt_emit.some) {
        val kind:   str                    = opt_emit.some::str;
        val goal_o: opt[request.BuildGoal] = request.goal_from_emit_name(kind);
        if (sel goal_o.none) {
            ret cli_diagnostic.report_fail(r, fail.user(diagnostic_kind.CLI_FLAG_VALUE, request.EMIT_ERROR), diagnostic.ORIGIN_NONE);
        }
        goal = goal_o.some;
    }

    val res_config: res[args.CliArgs, fail.Fail] = args.build_cli_invocation(cx.a, inv, argv);
    if (sel res_config.err) { ret cli_diagnostic.report_fail(r, res_config.err, diagnostic.ORIGIN_NONE); }
    var config: args.CliArgs = res_config.ok;

    val plan_only: bool = args.given(inv, ?args.PLAN);

    var arg: *u8 = nil;
    if (inv.has_positional) { arg = argv[inv.positional_idx]; }

    val loc_r: res[util.ProjectLocation, fail.Fail] = util.resolve_project_location(cx.a, arg);
    if (sel loc_r.err) { ret cli_diagnostic.report_fail(r, loc_r.err, diagnostic.ORIGIN_NONE); }
    val loc:  util.ProjectLocation = loc_r.ok;
    val root: str                  = loc.root;
    r.root = root;

    val col_r: err[fail.Fail] = args.collect_link_inputs(cx.a, ?config, inv, argv);
    if (sel col_r.err) { ret cli_diagnostic.report_fail(r, col_r.err, diagnostic.ORIGIN_NONE); }

    var ps:     session.Session;
    val plan_r: res[Planned, fail.Fail] = plan_invocation(cx.a, root, ?config, goal,
        manifest.ARTIFACT_DEFAULT_SET, plan_only, ?ps);
    if (sel plan_r.err) { ret cli_diagnostic.report_fail(r, plan_r.err, diagnostic.ORIGIN_BUILD); }
    fin { session.dnit(?ps); }
    var planned: Planned = plan_r.ok;
    if (goal != request.GOAL_CHECK && !plan_only) {
        val placed: err[fail.Fail] = overrides_placed(cx.a, ?config, ?planned);
        if (sel placed.err) { ret cli_diagnostic.report_fail(r, placed.err, diagnostic.ORIGIN_NONE); }
    }

    # every plan runs, as every cell of one plan does; the worst outcome is the exit
    var code: i64   = exit.OK;
    var pi:   usize = 0;
    for (pi < planned.plans.len) {
        val bp: *build_plan.BuildPlan = ?planned.plans.data[pi];
        pi = pi + 1;
        if (plan_only) {
            val shown: err[fail.Fail] = build_plan.explain(cx.a, bp, ?ps.interner);
            if (sel shown.err) { ret cli_diagnostic.report_fail(r, shown.err, diagnostic.ORIGIN_BUILD); }
            cnt;
        }

        announce_profile(r, ?planned, bp, config.quiet);
        var rd: cli_diagnostic.Readout;
        cli_diagnostic.readout_init(?rd, r, bp.units.len, config.quiet, config.verbosity);
        val ex_r: res[outcome.BuildOutcome, fail.Fail] = engine.execute(bp, cx.backing, cx.a, ?rd.sink);
        cli_diagnostic.readout_close(?rd);
        if (sel ex_r.err) { ret cli_diagnostic.report_fail(r, ex_r.err, diagnostic.ORIGIN_BUILD); }
        var bo: outcome.BuildOutcome = ex_r.ok;
        code = exit.worst(code, cli_diagnostic.outcome_code(?bo));
        outcome.outcome_dnit(?bo);
    }
    ret code;
}

#[testing]
fun t_build(argc: usize, argv: **u8) i64 {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 2; }
    ret args.invoke(?a, ?COMMAND, argc, argv);
}

#[testing]
val T_REQ_MANIFEST: str = "[project]\nmach = \">=5\"\nid = \"reqfx\"\nversion = \"0.0.0\"\nsrc = \"src\"\nwork = \"out/{target.name}/{profile.name}\"\n\n[target.host]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[target.alt]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[artifact.shader-a]\nkind = \"static\"\nentry = \"shader.mach\"\nout = \"{project.work}/lib/shader-a.a\"\ntargets = [\"alt\"]\nlink = []\nneed = []\n\n[artifact.shader-b]\nkind = \"static\"\nentry = \"shader.mach\"\nout = \"{project.work}/lib/shader-b.a\"\ntargets = [\"alt\"]\nlink = []\nneed = []\n\n[artifact.app]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"{project.work}/bin/app\"\ntargets = [\"host\"]\nlink = []\nneed = [\"artifact.shader-*\"]\n\n[profile.debug]\ndefault = true\noptimize = false\ndebug = false\nsimd = \"scalarize\"\n";

#[testing]
val T_REQ_SHADER: str = "pub fun tint(x: u64) u64 { ret x + 3; }\n";

#[testing]
val T_REQ_MAIN: str = "#[embed(\"{artifact.shader-a.out}\")]\nval SHADER: [_]u8;\n\n#[symbol(\"_start\")]\nfun start() {\n    var c: u64 = 1;\n    if (SHADER[0] == 0x21 && SHADER[1] == 0x3C && SHADER[6] == 0x3E && SHADER[7] == 0x0A) { c = 0; }\n    asm x86_64 {\n        mov rax, 60\n        mov rdi, {c}\n        syscall\n    }\n}\n";

#[testing]
fun t_req_exit_code(a: *A.Allocator, exe: str) i32 {
    var child: subprocess.OwnedSubprocess;
    subprocess.init(?child);
    var argv: [2]*u8;
    argv[0] = exe::*u8;
    argv[1] = nil;
    val spawn_r: err[subprocess.Error] = subprocess.spawn(a, ?child, exe, ?argv[0], exec.Environment.inherit{}, subprocess.spawn_options());
    if (sel spawn_r.err) {
        subprocess.dnit(a, ?child);
        ret -1;
    }
    val wr: res[subprocess.SubprocessTerminal, subprocess.Error] = subprocess.wait(a, ?child);
    if (sel wr.err) {
        subprocess.dnit(a, ?child);
        ret -1;
    }
    val term: subprocess.SubprocessTerminal = wr.ok;
    subprocess.dnit(a, ?child);
    if (term.kind != subprocess.STATE_EXITED) { ret -1; }
    ret term.code;
}

test run__a_glob_requirement_builds_first_and_the_bin_embeds_its_output {
    $if ($mach.build.os != $mach.os.linux)      { ret 0; }
    $if ($mach.build.arch != $mach.arch.x86_64) { ret 0; }

    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }

    val tf_r: res[fs.TempFile, fs.FsError] = fs.temp_create(?a, "mach_build_artifact_need");
    if (sel tf_r.err) { ret 1; }
    var tf:   fs.TempFile = tf_r.ok;
    val root: str         = fs.temp_path(?tf);
    fs.temp_close_and_remove(?tf);
    val create_dir_all_r: err[fs.FsError] = fs.create_dir_all(?a, root, 0o755);
    if (sel create_dir_all_r.err) { ret 1; }

    var bad: i32 = 0;
    if (!fixture.write(?a, root, "mach.toml", T_REQ_MANIFEST)) { bad = 1; }
    val src_dir: str = fixture.join(?a, root, "src");
    if (!fixture.write(?a, src_dir, "shader.mach", T_REQ_SHADER)) { bad = 1; }
    if (!fixture.write(?a, src_dir, "main.mach", T_REQ_MAIN))     { bad = 1; }
    if (bad != 0) {
        fs.remove_all(?a, root);
        ret 1;
    }

    var argv: [5]*u8;
    argv[0] = "mach"::*u8;
    argv[1] = "build"::*u8;
    argv[2] = root::*u8;
    argv[3] = "--target"::*u8;
    argv[4] = "host"::*u8;
    if (t_build(5, ?argv[0]) != 0) {
        fs.remove_all(?a, root);
        ret 1;
    }

    val lib_a:     str                       = fixture.join(?a, root, "out/alt/debug/lib/shader-a.a");
    val lib_b:     str                       = fixture.join(?a, root, "out/alt/debug/lib/shader-b.a");
    val app:       str                       = fixture.join(?a, root, "out/host/debug/bin/app");
    val is_file_r: res[bool, io_error.Error] = fs.is_file(lib_a);
    if (sel is_file_r.err)                   { ret 99; }
    if (!(sel is_file_r.ok && is_file_r.ok)) { bad = 1; }
    val is_file_r2: res[bool, io_error.Error] = fs.is_file(lib_b);
    if (sel is_file_r2.err)                    { ret 99; }
    if (!(sel is_file_r2.ok && is_file_r2.ok)) { bad = 1; }
    val is_file_r3: res[bool, io_error.Error] = fs.is_file(app);
    if (sel is_file_r3.err)                    { ret 99; }
    if (!(sel is_file_r3.ok && is_file_r3.ok)) { bad = 1; }
    if (bad != 0) {
        fs.remove_all(?a, root);
        ret 1;
    }

    if (t_req_exit_code(?a, app) != 0) { bad = 1; }

    val out_dir: str = fixture.join(?a, root, "out");
    fs.remove_all(?a, out_dir);
    if (!fixture.write(?a, src_dir, "shader.mach", "pub fun tint(x: u64) u64 { ret nonesuch; }\n")) { bad = 1; }
    if (t_build(5, ?argv[0]) == 0)                                                                  { bad = 1; }
    val is_file_r4: res[bool, io_error.Error] = fs.is_file(app);
    if (sel is_file_r4.err)                   { ret 99; }
    if ((sel is_file_r4.ok && is_file_r4.ok)) { bad = 1; }

    fs.remove_all(?a, root);
    ret bad;
}

#[testing]
val T_JSON_MANIFEST: str = "[project]\nmach = \">=5\"\nid = \"jr\"\nversion = \"0.0.0\"\nsrc = \"src\"\nwork = \"out/{target.name}/{profile.name}\"\n\n[target.linux]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[profile.debug]\ndefault = true\noptimize = false\ndebug = false\nsimd = \"scalarize\"\n\n[artifact.jr]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"{project.work}/bin/jr\"\ntargets = [\"*\"]\nlink = []\n";

# `mach <verb> <root> --diagnostics=json` over a scratch project whose manifest is
# T_JSON_MANIFEST with `need` and `extra` after it, its records written to `sink`;
# 0 when the run holds under cli_diagnostic.t_json_run with the exit code and the record
# it names, otherwise the step that failed
# the build or check command a test's verb names
#[testing]
fun t_verb(verb: str) *args.CommandSpec {
    if (str_equals(verb, "check")) { ret ?CHECK; }
    ret ?COMMAND;
}

#[testing]
fun t_json_build(verb: str, need: str, extra: str, code: i64, kind: str, key: str, origin: str) i32 {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 100; }
    val root: str = t_scratch_project(?a, need, extra);
    if (root == nil) { ret 100; }
    fin { fs.remove_all(?a, root); }

    var argv: [4]*u8;
    argv[0] = "mach"::*u8;
    argv[1] = verb::*u8;
    argv[2] = root::*u8;
    argv[3] = "--diagnostics=json"::*u8;
    val ir: res[args.ParsedInvocation, fail.Fail] = args.parse_command(?a, t_verb(verb), 4, ?argv[0]);
    if (sel ir.err) { ret 101; }
    var inv: args.ParsedInvocation = ir.ok;

    var sink: io_writer.Memory;
    var w:    io_writer.Writer;
    fixture.mem_writer(?w, ?sink);
    fin { io_writer.memory_dnit(?sink); }
    val got: i64 = args.run_to(?inv, ?argv[0], w);
    if (sink.len >= 8192) { ret 102; }
    if (got != code)      { ret 103; }
    ret cli_diagnostic.t_json_run(?sink, code, kind, key, origin);
}

# a scratch project in a fresh temporary directory whose manifest is
# T_JSON_MANIFEST with `need` and `extra` after it, and whose bin returns 0
# ---
# ret: the project root, the caller's to remove; nil when it could not be written
#[testing]
fun t_scratch_project(a: *A.Allocator, need: str, extra: str) str {
    val tf_r: res[fs.TempFile, fs.FsError] = fs.temp_create(a, "mach_build_json");
    if (sel tf_r.err) { ret nil; }
    var tf:   fs.TempFile = tf_r.ok;
    val root: str         = fs.temp_path(?tf);
    fs.temp_close_and_remove(?tf);
    var written:  bool                            = false;
    val manifest: res[str, types_string.StrError] = str_join(a, T_JSON_MANIFEST, need, extra);
    if (sel manifest.ok) {
        written = fixture.write(a, root, "mach.toml", manifest.ok) && fixture.write(a, fixture.join(a, root, "src"), "main.mach",
            "#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 {\n    ret 0;\n}\n");
    }
    if (!written) {
        fs.remove_all(a, root);
        ret nil;
    }
    ret root;
}

# `--plan` with `--quiet` is refused as a flag conflict before anything is
# planned, on a project that plans cleanly without `--quiet`
test run__rejects_quiet_combined_with_plan {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val root: str = t_scratch_project(?a, "need = []\n", "");
    if (root == nil) { ret 1; }
    fin { fs.remove_all(?a, root); }

    # the target is named so the plan does not depend on the host
    var argv: [7]*u8;
    argv[0] = "mach"::*u8;
    argv[1] = "build"::*u8;
    argv[2] = root::*u8;
    argv[3] = "-t"::*u8;
    argv[4] = "linux"::*u8;
    argv[5] = "--plan"::*u8;
    argv[6] = "--quiet"::*u8;
    var n: usize = 6;
    for (n <= 7) {
        val ir: res[args.ParsedInvocation, fail.Fail] = args.parse_command(?a, ?COMMAND, n, ?argv[0]);
        if (sel ir.err) { ret 2; }
        var inv:        args.ParsedInvocation = ir.ok;
        var conflicted: bool                  = false;
        if (sel inv.refusal.some)  { conflicted = fail.kind_of(inv.refusal.some) == diagnostic_kind.CLI_FLAG_CONFLICT; }
        if (n == 7 && !conflicted) { ret 5; }
        if (n == 6) {
            if (conflicted) { ret 4; }
            var sink: io_writer.Memory;
            var w:    io_writer.Writer;
            fixture.mem_writer(?w, ?sink);
            val got: i64 = args.run_to(?inv, ?argv[0], w);
            io_writer.memory_dnit(?sink);
            if (got != exit.OK) { ret 4; }
        }
        n = n + 1;
    }
    ret 0;
}

# under json every failure a build raises outside the diagnostic store is one
# record carrying its code and the phase it came from, and every run ends with
# one summary whose counts match the records before it
test json__failures_are_records_and_a_summary_closes_every_run {
    $if ($mach.build.os != $mach.os.linux)      { ret 0; }
    $if ($mach.build.arch != $mach.arch.x86_64) { ret 0; }
    val clean: i32 = t_json_build("check", "need = []\n", "", 0, nil, nil, nil);
    if (clean != 0) { ret clean; }
    # nothing supplies `_start` without a startup library
    val link: i32 = t_json_build("build", "need = []\n", "", 1, "failure", "link.entry_missing", "link");
    if (link != 0) { ret 10 + link; }
    val step: i32 = t_json_build("build", "need = [\"step.boom\"]\n", "\n[step.boom]\nargv = [\"false\"]\nin = []\nout = []\nneed = []\n",
        1, "failure", "step.exit", "build");
    if (step != 0) { ret 20 + step; }
    val manifest: i32 = t_json_build("build", "need = []\n", "\n[profile.release]\n", 1, "failure", "manifest.missing_required", "build");
    if (manifest != 0) { ret 30 + manifest; }
    val dep: i32 = t_json_build("build", "need = []\n", "\n[dep.gone]\npath = \"../nowhere\"\n", 1, "failure", "dep.unrealized", "build");
    if (dep != 0) { ret 40 + dep; }
    ret 0;
}

# `mach <verb> <root> <flags...> --diagnostics=json` over a scratch project with
# `extra` after its manifest, held to cli_diagnostic.t_json_run with exit `code`;
# `has` must occur in its records and `lacks`, when not nil, must not
#[testing]
fun t_json_readout(verb: str, flags: *str, n: usize, extra: str, code: i64, has: str, lacks: str) i32 {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 100; }
    val root: str = t_scratch_project(?a, "need = []\n", extra);
    if (root == nil) { ret 100; }
    fin { fs.remove_all(?a, root); }

    var argv: [8]*u8;
    argv[0] = "mach"::*u8;
    argv[1] = verb::*u8;
    argv[2] = root::*u8;
    var i: usize = 0;
    for (i < n) {
        argv[3 + i] = flags[i]::*u8;
        i           = i + 1;
    }
    argv[3 + n] = "--diagnostics=json"::*u8;
    val ir: res[args.ParsedInvocation, fail.Fail] = args.parse_command(?a, t_verb(verb), 4 + n, ?argv[0]);
    if (sel ir.err) { ret 101; }
    var inv: args.ParsedInvocation = ir.ok;

    var sink: io_writer.Memory;
    var w:    io_writer.Writer;
    fixture.mem_writer(?w, ?sink);
    fin { io_writer.memory_dnit(?sink); }
    val got: i64 = args.run_to(?inv, ?argv[0], w);
    if (got != code) { ret 103; }
    val held: i32 = cli_diagnostic.t_json_run(?sink, code, nil, nil, nil);
    if (held != 0)                                            { ret held; }
    if (fixture.sink_count(?sink, has) == 0)                  { ret 104; }
    if (lacks != nil && fixture.sink_count(?sink, lacks) > 0) { ret 105; }
    ret 0;
}

# `-v` and `-vv` are accepted beside `--diagnostics=json` and the readout comes
# out as records: a phase record per row under -v and no item, a phase_item
# record per module under -vv, and a built unit's line in the summary record
test json__v_and_vv_write_the_readout_as_records {
    $if ($mach.build.os != $mach.os.linux)      { ret 0; }
    $if ($mach.build.arch != $mach.arch.x86_64) { ret 0; }
    var v:    [1]str = [1]str{"-v"};
    val rows: i32    = t_json_readout("check", ?v[0], 1, "", 0, "{\"schema\":1,\"record\":\"phase\",\"name\":\"sema\",\"count\":", "\"record\":\"phase_item\"");
    if (rows != 0) { ret rows; }
    var vv:    [1]str = [1]str{"-vv"};
    val items: i32    = t_json_readout("check", ?vv[0], 1, "", 0, "{\"schema\":1,\"record\":\"phase_item\",\"phase\":\"load\",\"name\":", nil);
    if (items != 0) { ret 10 + items; }
    val lib:   str    = "\n[artifact.lib]\nkind = \"static\"\nentry = \"main.mach\"\nout = \"{project.work}/lib/libjr{artifact.suffix}\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
    var built: [3]str = [3]str{"-v", "-a", "lib"};
    val sum:   i32    = t_json_readout("build", ?built[0], 3, lib, 0, "\"exit_code\":0,\"time_us\":", nil);
    if (sum != 0) { ret 20 + sum; }
    ret 0;
}

#[testing]
fun str_index(s: str, sub: str) usize {
    val at: opt[usize] = str_index_of(s, sub);
    if (sel at.none) { ret str_len(s); }
    ret at.some;
}

# the arguments of `-t <target> -a <artifact>`, either left out when empty, with `--all` when all
#[testing]
fun t_plan_cli(a: *A.Allocator, target: str, artifact: str, all: bool) args.CliArgs {
    var cli: args.CliArgs;
    cli.selectors     = manifest.selectors_init(a);
    cli.selectors.all = all;
    if (!str_empty(target))   { collections_vector.push[str](?cli.selectors.targets, target); }
    if (!str_empty(artifact)) { collections_vector.push[str](?cli.selectors.artifacts, artifact); }
    ret cli;
}

#[testing]
fun t_plan_text(a: *A.Allocator, root: str, cli: *args.CliArgs, configure_deps: bool,
    out_text: *str) err[fail.Fail] {
    var ps:      session.Session;
    val planned: res[Planned, fail.Fail] = plan_invocation(a, root, cli,
        request.GOAL_ARTIFACT, manifest.ARTIFACT_DEFAULT_SET, configure_deps, ?ps);
    if (sel planned.err) {
        ret err[fail.Fail].err{planned.err};
    }
    var bp: build_plan.BuildPlan = planned.ok.plans.data[0];

    var sink: io_writer.Memory;
    var w:    io_writer.Writer;
    fixture.mem_writer(?w, ?sink);
    val rendered: err[fail.Fail] = build_plan.render(a, ?w, ?bp, ?ps.interner);
    session.dnit(?ps);
    if (sel rendered.err) { ret rendered; }
    @out_text = io_writer.memory_text(?sink);
    ret err[fail.Fail].ok{};
}

#[testing]
val T_PLAN_MANIFEST: str = "[project]\nmach = \">=5\"\nid = \"planfx\"\nversion = \"0.0.0\"\nsrc = \"src\"\nwork = \"out/{target.name}/{profile.name}\"\n\n[target.host]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[target.win]\nisa = \"x86_64\"\nos = \"windows\"\nabi = \"win64\"\n\n[artifact.support]\nkind = \"static\"\nentry = \"support.mach\"\nout = \"{project.work}/lib/libsupport{artifact.suffix}\"\ntargets = [\"*\"]\nlink = []\nneed = []\n\n[artifact.app]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"{project.work}/bin/app{artifact.suffix}\"\ntargets = [\"*\"]\nlink = []\nneed = [\"artifact.support\", \"step.generate\"]\n\n[step.generate]\nargv = [\"sh\", \"-c\", \"printf generated > {project.work}/generated.txt\"]\nin = []\nout = [\"{project.work}/generated.txt\"]\nneed = [\"step.prepare\"]\n\n[step.prepare]\nargv = [\"sh\", \"-c\", \"printf prepared > {project.work}/prepared.txt\"]\nin = []\nout = [\"{project.work}/prepared.txt\"]\nneed = []\n\n[profile.debug]\ndefault = true\noptimize = false\ndebug = false\nsimd = \"scalarize\"\n";

#[testing]
val T_PLAN_SUPPORT: str = "pub fun tint(x: u64) u64 { ret x + 3; }\n";

#[testing]
val T_PLAN_MAIN: str = "#[symbol(\"_start\")]\nfun start() {\n    asm x86_64 {\n        mov rax, 60\n        mov rdi, 0\n        syscall\n    }\n}\n";

#[testing]
fun t_plan_scaffold(a: *A.Allocator, manifest_text: str, out_root: *str) bool {
    val created: res[fs.TempFile, fs.FsError] = fs.temp_create(a, "mach_plan_case");
    if (sel created.err) { ret false; }
    var temporary: fs.TempFile = created.ok;
    val root:      str         = fs.temp_path(?temporary);
    fs.temp_close_and_remove(?temporary);
    val create_dir_all_r: err[fs.FsError] = fs.create_dir_all(a, root, 0o755);
    if (sel create_dir_all_r.err) { ret false; }
    @out_root = root;
    if (!fixture.write(a, root, "mach.toml", manifest_text)) { ret false; }
    val src: str = fixture.join(a, root, "src");
    if (!fixture.write(a, src, "support.mach", T_PLAN_SUPPORT)) { ret false; }
    ret fixture.write(a, src, "main.mach", T_PLAN_MAIN);
}

test plan__displays_the_selection_the_build_produces_and_executes_nothing {
    $if ($mach.build.os != $mach.os.linux)      { ret 0; }
    $if ($mach.build.arch != $mach.arch.x86_64) { ret 0; }
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    var root: str = "";
    if (!t_plan_scaffold(?a, T_PLAN_MANIFEST, ?root)) { ret 2; }
    fin { fs.remove_all(?a, root); }

    var cli:      args.CliArgs   = t_plan_cli(?a, "", "", true);
    var text:     str            = "";
    val rendered: err[fail.Fail] = t_plan_text(?a, root, ?cli, true, ?text);
    if (sel rendered.err) { ret 3; }

    # every declared cell, its entry, its derived suffix and its prerequisite order
    if (!str_contains(text, "project: planfx"))                                                       { ret 4; }
    if (!str_contains(text, "units:   4"))                                                            { ret 5; }
    if (!str_contains(text, "  entry   main.mach"))                                                   { ret 6; }
    if (!str_contains(text, "  entry   support.mach"))                                                { ret 7; }
    if (!str_contains(text, "/out/host/debug/bin/app\n"))                                             { ret 8; }
    if (!str_contains(text, "/out/win/debug/bin/app.exe\n"))                                          { ret 9; }
    if (!str_contains(text, "/out/host/debug/lib/libsupport.a\n"))                                    { ret 10; }
    if (!str_contains(text, "/out/win/debug/lib/libsupport.lib\n"))                                   { ret 11; }
    if (!str_contains(text, "  need    artifact support"))                                            { ret 12; }
    if (!str_contains(text, "  step    project prepare"))                                             { ret 13; }
    if (!str_contains(text, "  step    project generate"))                                            { ret 14; }
    if (str_index(text, "  step    project prepare") > str_index(text, "  step    project generate")) { ret 15; }
    if (!str_contains(text, "generated bytes are unresolved"))                                        { ret 16; }
    if (!str_contains(text, "it does not claim the link succeeds"))                                   { ret 17; }
    if (str_contains(text, "not configured against the dependency closure"))                          { ret 18; }

    # nothing ran: no step output, no object, IR or assembly tree, no artifact
    val exists_r: res[bool, io_error.Error] = fs.exists(fixture.join(?a, root, "out"));
    if (sel exists_r.err)                 { ret 99; }
    if ((sel exists_r.ok && exists_r.ok)) { ret 19; }

    # the build that follows produces exactly the paths the plan named
    var argv: [5]*u8;
    argv[0] = "mach"::*u8;
    argv[1] = "build"::*u8;
    argv[2] = root::*u8;
    argv[3] = "--target"::*u8;
    argv[4] = "host"::*u8;
    if (t_build(5, ?argv[0]) != 0) { ret 20; }
    val is_file_r: res[bool, io_error.Error] = fs.is_file(fixture.join(?a, root, "out/host/debug/bin/app"));
    if (sel is_file_r.err)                   { ret 99; }
    if (!(sel is_file_r.ok && is_file_r.ok)) { ret 21; }
    val is_file_r2: res[bool, io_error.Error] = fs.is_file(fixture.join(?a, root, "out/host/debug/lib/libsupport.a"));
    if (sel is_file_r2.err)                    { ret 99; }
    if (!(sel is_file_r2.ok && is_file_r2.ok)) { ret 22; }
    val is_file_r3: res[bool, io_error.Error] = fs.is_file(fixture.join(?a, root, "out/host/debug/generated.txt"));
    if (sel is_file_r3.err)                    { ret 99; }
    if (!(sel is_file_r3.ok && is_file_r3.ok)) { ret 23; }
    val is_file_r4: res[bool, io_error.Error] = fs.is_file(fixture.join(?a, root, "out/host/debug/prepared.txt"));
    if (sel is_file_r4.err)                    { ret 99; }
    if (!(sel is_file_r4.ok && is_file_r4.ok)) { ret 24; }
    ret 0;
}

test plan__an_unconfigured_plan_does_not_claim_an_empty_dependency_closure {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    var root: str = "";
    if (!t_plan_scaffold(?a, T_PLAN_MANIFEST, ?root)) { ret 2; }
    fin { fs.remove_all(?a, root); }
    var cli:           args.CliArgs   = t_plan_cli(?a, "host", "app", false);
    var text:          str            = "";
    val t_plan_text_r: err[fail.Fail] = t_plan_text(?a, root, ?cli, false, ?text);
    if (sel t_plan_text_r.err)                                                { ret 3; }
    if (!str_contains(text, "not configured against the dependency closure")) { ret 4; }
    val exists_r: res[bool, io_error.Error] = fs.exists(fixture.join(?a, root, "out"));
    if (sel exists_r.err)                 { ret 99; }
    if ((sel exists_r.ok && exists_r.ok)) { ret 5; }
    ret 0;
}

# a build or test request reads and publishes the object cache unless
# `--no-cache` forces an uncached build, and a check never does
test plan__the_object_cache_is_on_by_default_off_under_no_cache_and_for_check {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    var root: str = "";
    if (!t_plan_scaffold(?a, T_PLAN_MANIFEST, ?root)) { ret 2; }
    fin { fs.remove_all(?a, root); }
    var goals: [3]request.BuildGoal = [3]request.BuildGoal{request.GOAL_ARTIFACT, request.GOAL_TESTS, request.GOAL_CHECK};
    var i:     usize                = 0;
    for (i < 6) {
        var cli: args.CliArgs = t_plan_cli(?a, "host", "app", false);
        cli.no_cache = i >= 3;
        var ps:      session.Session;
        val planned: res[Planned, fail.Fail] = plan_invocation(?a, root, ?cli, goals[i % 3], manifest.ARTIFACT_DEFAULT_SET, false, ?ps);
        if (sel planned.err) { ret 3; }
        val cached: bool = planned.ok.plans.data[0].request.object_cache;
        session.dnit(?ps);
        if (cached != (i < 2)) { ret 4 + i::i32; }
        i = i + 1;
    }
    ret 0;
}

test plan__dependency_prerequisites_missing_realizations_and_cycles_use_the_shared_service {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    var root:     str                 = "";
    val with_dep: res[str, fail.Fail] = build_plan.join_msg(?a, T_PLAN_MANIFEST, "\n[dep.vendor]\npath = \"../source-must-not-be-read\"\n");
    if (sel with_dep.err)                         { ret 2; }
    if (!t_plan_scaffold(?a, with_dep.ok, ?root)) { ret 2; }
    fin { fs.remove_all(?a, root); }
    var cli:  args.CliArgs = t_plan_cli(?a, "host", "app", false);
    var text: str          = "";

    # a missing dependency fails planning exactly as a build fails it
    val missing: err[fail.Fail] = t_plan_text(?a, root, ?cli, true, ?text);
    if (sel missing.ok) { ret 3; }
    val failure: fail.Fail = missing.err;
    if (!sel failure.user)                                                              { ret 4; }
    if (!str_contains(fail.describe(failure), "is missing: nothing is checked out at")) { ret 5; }
    val exists_r:  res[bool, io_error.Error] = fs.exists(fixture.join(?a, root, "dep/vendor"));
    val exists_r2: res[bool, io_error.Error] = fs.exists(fixture.join(?a, root, "out"));
    if ((sel exists_r.ok && exists_r.ok))   { ret 6; }
    if ((sel exists_r2.ok && exists_r2.ok)) { ret 6; }

    # the same realized dependency's exported steps and link requirements, in order
    val dep_root:     str = fixture.join(?a, root, "dep/vendor");
    val dep_manifest: str = "[project]\nmach=\">=5\"\nid = \"vendor\"\nversion = \"0.0.0\"\nsrc = \"src\"\nwork = \"out\"\n[profile.debug]\ndefault = true\noptimize = false\ndebug = false\nsimd = \"scalarize\"\n[artifact.vendor]\nkind = \"static\"\ndefault = true\nentry = \"public.mach\"\nout = \"{project.work}/lib/vendor.a\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[link.generated]\nsource = \"local\"\npath = \"{project.work}/vendor.o\"\nos = [\"*\"]\nisa = [\"*\"]\nabi = [\"*\"]\nexport = true\n[step.first]\nargv = [\"sh\", \"-c\", \"printf ran > {project.work}/dep-first.txt\"]\nin = []\nout = [\"{project.work}/dep-first.txt\"]\nneed = []\n[step.object]\nargv = [\"sh\", \"-c\", \"printf ran > {project.work}/vendor.o\"]\nin = []\nout = [\"{project.work}/vendor.o\"]\nneed = [\"step.first\"]\n";
    if (!fixture.write(?a, dep_root, "mach.toml", dep_manifest))                                                        { ret 7; }
    if (!fixture.write(?a, fixture.join(?a, dep_root, "src"), "public.mach", "this is deliberately not Mach source\n")) { ret 8; }

    val t_plan_text_r: err[fail.Fail] = t_plan_text(?a, root, ?cli, true, ?text);
    if (sel t_plan_text_r.err)                                              { ret 9; }
    if (!str_contains(text, "  step    dependency vendor.first"))           { ret 10; }
    if (!str_contains(text, "  step    dependency vendor.object"))          { ret 11; }
    if (str_index(text, "vendor.first") > str_index(text, "vendor.object")) { ret 12; }
    if (!str_contains(text, "  link    dependency export "))                { ret 13; }
    if (!str_contains(text, "vendor.o"))                                    { ret 14; }
    # the dependency's exported steps precede the project's own
    if (str_index(text, "  step    dependency vendor.object") > str_index(text, "  step    project prepare")) { ret 15; }
    # neither the dependency's steps nor the project's ran, and its source was never read
    val exists_r3: res[bool, io_error.Error] = fs.exists(fixture.join(?a, root, "out"));
    val exists_r4: res[bool, io_error.Error] = fs.exists(fixture.join(?a, dep_root, "out"));
    if ((sel exists_r3.ok && exists_r3.ok)) { ret 16; }
    if ((sel exists_r4.ok && exists_r4.ok)) { ret 16; }

    # a dependency cycle is the shared service's diagnostic, not a planner-local one
    val cyclic: res[str, fail.Fail] = build_plan.join_msg(?a, dep_manifest, "\n[dep.planfx]\npath = \"../..\"\n");
    if (sel cyclic.err)                                       { ret 17; }
    if (!fixture.write(?a, dep_root, "mach.toml", cyclic.ok)) { ret 17; }
    val cycle: err[fail.Fail] = t_plan_text(?a, root, ?cli, true, ?text);
    if (sel cycle.ok) { ret 18; }
    val cycle_failure: fail.Fail = cycle.err;
    if (!sel cycle_failure.user) { ret 19; }
    val exists_r5: res[bool, io_error.Error] = fs.exists(fixture.join(?a, root, "out"));
    if (sel exists_r5.err)                  { ret 99; }
    if ((sel exists_r5.ok && exists_r5.ok)) { ret 20; }

    # an invalid root manifest is the manifest diagnostic, reported before any cell
    if (!fixture.write(?a, root, "mach.toml", "[project]\nmach = \">=5\"\nid = \"planfx\"\n")) { ret 21; }
    val invalid: err[fail.Fail] = t_plan_text(?a, root, ?cli, true, ?text);
    if (sel invalid.ok) { ret 22; }
    val invalid_failure: fail.Fail = invalid.err;
    if (!sel invalid_failure.user)                                   { ret 23; }
    if (!str_contains(fail.describe(invalid_failure), "mach.toml:")) { ret 23; }
    ret 0;
}

test plan_failure__the_message_outlives_the_session_it_came_from {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val initialized: res[session.Session, fail.Fail] = toolchain.session_init(?a);
    if (sel initialized.err) { ret 2; }
    var s:      session.Session   = initialized.ok;
    val copied: res[str, A.Error] = str_dup(s.alloc, "owned planning failure");
    if (sel copied.err) {
        session.dnit(?s);
        ret 3;
    }
    val session_owned: str                     = copied.ok;
    val result:        res[Planned, fail.Fail] = plan_failure(?a, ?s, fail.user(diagnostic_kind.ARTIFACT_NO_OUTPUT, session_owned));
    if (sel result.ok) { ret 4; }
    val failure: fail.Fail = result.err;
    if (fail.describe(failure) == session_owned) { ret 5; }
    if (!sel failure.user)                       { ret 5; }
    val intact: bool = str_equals(fail.describe(failure), "owned planning failure");
    fail.dnit(?a, failure);
    if (!intact) { ret 6; }
    ret 0;
}

#[testing]
fun t_check(argc: usize, argv: **u8) i64 {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 2; }
    ret args.invoke(?a, ?CHECK, argc, argv);
}

#[testing]
fun t_root_holds_only_sources(a: *A.Allocator, root: str) bool {
    val listed: res[Vector[str], fs.FsError] = fs.read_dir(a, root);
    if (sel listed.err) { ret false; }
    var names: Vector[str] = listed.ok;
    var i:     usize       = 0;
    for (i < names.len) {
        val entry: str = names.data[i];
        if (!str_equals(entry, ".") && !str_equals(entry, "..") && !str_equals(entry, "mach.toml")
            && !str_equals(entry, "src") && !str_equals(entry, "dep")) { ret false; }
        i = i + 1;
    }
    ret true;
}

#[testing]
val T_CHECK_MAIN_OK: str = "use planfx.support;\n\n#[symbol(\"_start\")]\nfun start() {\n    val t: u64 = support.tint(1);\n    asm x86_64 {\n        mov rax, 60\n        mov rdi, {t}\n        syscall\n    }\n}\n";

test check__checks_the_selected_graph_and_runs_no_step {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    var root: str = "";
    if (!t_plan_scaffold(?a, T_PLAN_MANIFEST, ?root)) { ret 2; }
    fin { fs.remove_all(?a, root); }
    val src: str = fixture.join(?a, root, "src");
    if (!fixture.write(?a, src, "main.mach", T_CHECK_MAIN_OK))                                                    { ret 3; }
    if (!fixture.write(?a, src, "unselected.mach", "this file is never imported and is deliberately not Mach\n")) { ret 4; }

    var argv: [5]*u8;
    argv[0] = "mach"::*u8;
    argv[1] = "check"::*u8;
    argv[2] = root::*u8;
    argv[3] = "--target"::*u8;
    argv[4] = "host"::*u8;

    # accepted: both artifacts on the target, the reachable graph only; the two
    # steps app needs never ran and nothing was written
    if (t_check(5, ?argv[0]) != 0) { ret 5; }
    val exists_r: res[bool, io_error.Error] = fs.exists(fixture.join(?a, root, "out"));
    if (sel exists_r.err)                     { ret 99; }
    if ((sel exists_r.ok && exists_r.ok))     { ret 6; }
    if (!t_root_holds_only_sources(?a, root)) { ret 6; }

    # rejected by sema: a name that does not resolve in the selected entry
    if (!fixture.write(?a, src, "main.mach", "use planfx.support;\nfun start() u64 { ret support.absent(1); }\n")) { ret 7; }
    if (t_check(5, ?argv[0]) != 1)                                                                                 { ret 8; }
    val exists_r2: res[bool, io_error.Error] = fs.exists(fixture.join(?a, root, "out"));
    if (sel exists_r2.err)                  { ret 99; }
    if ((sel exists_r2.ok && exists_r2.ok)) { ret 9; }

    # rejected by the parser
    if (!fixture.write(?a, src, "main.mach", "fun start( {\n")) { ret 10; }
    if (t_check(5, ?argv[0]) != 1)                              { ret 11; }

    # rejected by resolution: an import of a module that does not exist
    if (!fixture.write(?a, src, "main.mach", "use planfx.generated;\nfun start() u64 { ret 0; }\n")) { ret 12; }
    if (t_check(5, ?argv[0]) != 1)                                                                   { ret 13; }

    # narrowing to the library artifact leaves the broken binary entry unread
    var narrowed: [7]*u8;
    narrowed[0] = "mach"::*u8;
    narrowed[1] = "check"::*u8;
    narrowed[2] = root::*u8;
    narrowed[3] = "--target"::*u8;
    narrowed[4] = "host"::*u8;
    narrowed[5] = "-a"::*u8;
    narrowed[6] = "support"::*u8;
    if (t_check(7, ?narrowed[0]) != 0) { ret 14; }
    narrowed[6] = "app"::*u8;
    if (t_check(7, ?narrowed[0]) != 1) { ret 15; }

    # a malformed manifest is a user error before any source is read
    if (!fixture.write(?a, root, "mach.toml", "[project]\nmach = \">=5\"\nid = \"planfx\"\n")) { ret 16; }
    if (t_check(5, ?argv[0]) != 1)                                                             { ret 17; }
    val exists_r3: res[bool, io_error.Error] = fs.exists(fixture.join(?a, root, "out"));
    if (sel exists_r3.err)                  { ret 99; }
    if ((sel exists_r3.ok && exists_r3.ok)) { ret 18; }
    ret 0;
}

test check__a_missing_generated_input_is_reported_not_produced {
    $if ($mach.build.os != $mach.os.linux)      { ret 0; }
    $if ($mach.build.arch != $mach.arch.x86_64) { ret 0; }
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val created: res[fs.TempFile, fs.FsError] = fs.temp_create(?a, "mach_check_generated");
    if (sel created.err) { ret 2; }
    var temporary: fs.TempFile = created.ok;
    val root:      str         = fs.temp_path(?temporary);
    fs.temp_close_and_remove(?temporary);
    fin { fs.remove_all(?a, root); }
    val src: str = fixture.join(?a, root, "src");
    if (!fixture.write(?a, root, "mach.toml", T_REQ_MANIFEST)
        || !fixture.write(?a, src, "shader.mach", T_REQ_SHADER)
        || !fixture.write(?a, src, "main.mach", T_REQ_MAIN)) { ret 3; }

    # main embeds the output of the required artifact shader-a, which only a build produces
    var argv: [5]*u8;
    argv[0] = "mach"::*u8;
    argv[1] = "check"::*u8;
    argv[2] = root::*u8;
    argv[3] = "--target"::*u8;
    argv[4] = "host"::*u8;
    if (t_check(5, ?argv[0]) != 1) { ret 4; }
    val exists_r: res[bool, io_error.Error] = fs.exists(fixture.join(?a, root, "out"));
    if (sel exists_r.err)                 { ret 99; }
    if ((sel exists_r.ok && exists_r.ok)) { ret 5; }

    # the build produces it, and the same check then accepts the same source
    var build_argv: [5]*u8;
    build_argv[0] = "mach"::*u8;
    build_argv[1] = "build"::*u8;
    build_argv[2] = root::*u8;
    build_argv[3] = "--target"::*u8;
    build_argv[4] = "host"::*u8;
    if (t_build(5, ?build_argv[0]) != 0) { ret 6; }
    val is_file_r: res[bool, io_error.Error] = fs.is_file(fixture.join(?a, root, "out/alt/debug/lib/shader-a.a"));
    if (sel is_file_r.err)                   { ret 99; }
    if (!(sel is_file_r.ok && is_file_r.ok)) { ret 7; }
    if (t_check(5, ?argv[0]) != 0)           { ret 8; }
    ret 0;
}

test check__an_unbuilt_required_artifact_is_named_and_every_cell_reads_as_checked {
    $if ($mach.build.os != $mach.os.linux)      { ret 0; }
    $if ($mach.build.arch != $mach.arch.x86_64) { ret 0; }
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val created: res[fs.TempFile, fs.FsError] = fs.temp_create(?a, "mach_check_required_named");
    if (sel created.err) { ret 2; }
    var temporary: fs.TempFile = created.ok;
    val root:      str         = fs.temp_path(?temporary);
    fs.temp_close_and_remove(?temporary);
    fin { fs.remove_all(?a, root); }
    val src: str = fixture.join(?a, root, "src");
    if (!fixture.write(?a, root, "mach.toml", T_REQ_MANIFEST)
        || !fixture.write(?a, src, "shader.mach", T_REQ_SHADER)
        || !fixture.write(?a, src, "main.mach", T_REQ_MAIN)) { ret 3; }

    var cli:     args.CliArgs            = t_plan_cli(?a, "host", "app", false);
    var ps:      session.Session;
    val planned: res[Planned, fail.Fail] = plan_invocation(?a, root, ?cli, request.GOAL_CHECK, manifest.ARTIFACT_DEFAULT_SET, false, ?ps);
    if (sel planned.err) { ret 4; }
    var bp: build_plan.BuildPlan = planned.ok.plans.data[0];
    fin { session.dnit(?ps); }

    var oa:      A.Allocator;
    val make_r2: err[A.Error] = page.make(?oa);
    if (sel make_r2.err) { ret 5; }
    var rd: readout.Recording;
    readout.recording_init(?rd, ?oa, readout.LEVEL_RESULTS);
    fin { readout.recording_dnit(?rd); }
    val executed: res[outcome.BuildOutcome, fail.Fail] = engine.execute(?bp, ?a, ?oa, ?rd.sink);
    if (sel executed.err) { ret 6; }
    var bo: outcome.BuildOutcome = executed.ok;
    fin { outcome.outcome_dnit(?bo); }

    # no cell of a check is built, so none of them announces itself as built
    var i: usize = 0;
    for (i < rd.verbs.len) {
        if (!str_equals(rd.verbs.data[i], "checking")) { ret 7; }
        i = i + 1;
    }
    var named: bool = false;
    i = 0;
    for (i < rd.diagnostics.len) {
        val d: *readout.RecordedDiagnostic = ?rd.diagnostics.data[i];
        if (diagnostic_kind.is_error(d.kind)
            && str_contains(d.message, "the output of required artifact `shader-a`")
            && str_contains(d.message, "build the project first")) { named = true; }
        i = i + 1;
    }
    if (rd.verbs.len < 2) { ret 8; }
    if (!named)           { ret 9; }
    ret 0;
}

test check__requires_one_path_and_refuses_output_options {
    var argv: [5]*u8;
    argv[0] = "mach"::*u8;
    argv[1] = "check"::*u8;
    argv[2] = "."::*u8;
    argv[3] = "-o"::*u8;
    argv[4] = "bin/unexpected"::*u8;
    if (t_check(2, ?argv[0]) != 1) { ret 1; }
    if (t_check(5, ?argv[0]) != 1) { ret 2; }
    argv[3] = "--emit-ir"::*u8;
    if (t_check(4, ?argv[0]) != 1) { ret 3; }
    argv[3] = "second-project"::*u8;
    if (t_check(4, ?argv[0]) != 1) { ret 4; }
    ret 0;
}

test check__the_outcome_carries_located_diagnostics_and_a_typed_classification {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    var root: str = "";
    if (!t_plan_scaffold(?a, T_PLAN_MANIFEST, ?root)) { ret 2; }
    fin { fs.remove_all(?a, root); }
    val src: str = fixture.join(?a, root, "src");
    if (!fixture.write(?a, src, "main.mach", "use planfx.support;\nfun start() u64 { ret support.absent(1); }\n")) { ret 3; }

    var cli:     args.CliArgs            = t_plan_cli(?a, "host", "app", false);
    var ps:      session.Session;
    val planned: res[Planned, fail.Fail] = plan_invocation(?a, root, ?cli, request.GOAL_CHECK, manifest.ARTIFACT_DEFAULT_SET, false, ?ps);
    if (sel planned.err) { ret 4; }
    var bp: build_plan.BuildPlan = planned.ok.plans.data[0];
    fin { session.dnit(?ps); }
    # the selected binary and the artifact it requires are both checked, neither built
    if (bp.units.len != 2) { ret 5; }
    var ui: usize = 0;
    for (ui < bp.units.len) {
        val unit: *build_plan.BuildUnit = ?bp.units.data[ui];
        if (unit.goal != request.GOAL_CHECK)                                                                                { ret 6; }
        if (unit.phases.len != 2 || unit.phases.data[0] != build_plan.PH_LOAD || unit.phases.data[1] != build_plan.PH_SEMA) { ret 6; }
        if (!str_empty(unit.out_path))                                                                                      { ret 7; }
        ui = ui + 1;
    }

    var oa:      A.Allocator;
    val make_r2: err[A.Error] = page.make(?oa);
    if (sel make_r2.err) { ret 8; }
    var rd: readout.Recording;
    readout.recording_init(?rd, ?oa, readout.LEVEL_RESULTS);
    fin { readout.recording_dnit(?rd); }
    val executed: res[outcome.BuildOutcome, fail.Fail] = engine.execute(?bp, ?a, ?oa, ?rd.sink);
    if (sel executed.err) { ret 9; }
    var bo: outcome.BuildOutcome = executed.ok;
    fin { outcome.outcome_dnit(?bo); }
    if (bo.severity != outcome.BUILD_USER)     { ret 10; }
    if (cli_diagnostic.outcome_code(?bo) != 1) { ret 11; }
    if (bo.artifacts.len != 0)                 { ret 12; }

    var located: bool  = false;
    var i:       usize = 0;
    for (i < rd.diagnostics.len) {
        val d: *readout.RecordedDiagnostic = ?rd.diagnostics.data[i];
        if (diagnostic_kind.is_error(d.kind) && d.located) { located = true; }
        i = i + 1;
    }
    if (!located) { ret 13; }
    val exists_r: res[bool, io_error.Error] = fs.exists(fixture.join(?a, root, "out"));
    if (sel exists_r.err)                 { ret 99; }
    if ((sel exists_r.ok && exists_r.ok)) { ret 14; }
    ret 0;
}

# `-o` names one output, so a selection resolving to several cells is refused
# before anything is planned, naming each; one artifact on one target takes it
test plan_invocation__o_needs_the_selection_to_be_one_cell {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    var root: str = "";
    if (!t_plan_scaffold(?a, T_PLAN_MANIFEST, ?root)) { ret 2; }
    fin { fs.remove_all(?a, root); }
    var cli: args.CliArgs = t_plan_cli(?a, "*", "app", false);
    cli.output = "bin/app";
    var ps:   session.Session;
    val many: res[Planned, fail.Fail] = plan_invocation(?a, root, ?cli, request.GOAL_ARTIFACT, manifest.ARTIFACT_DEFAULT_SET, false, ?ps);
    if (sel many.ok)                                                                       { ret 3; }
    if (fail.kind_of(many.err) != diagnostic_kind.OUTPUT_AMBIGUOUS)                        { ret 4; }
    if (!str_contains(fail.describe(many.err), "app on host (debug), app on win (debug)")) { ret 5; }
    cli        = t_plan_cli(?a, "host", "app", false);
    cli.output = "bin/app";
    val one: res[Planned, fail.Fail] = plan_invocation(?a, root, ?cli, request.GOAL_ARTIFACT, manifest.ARTIFACT_DEFAULT_SET, false, ?ps);
    if (sel one.err) { ret 6; }
    session.dnit(?ps);
    ret 0;
}

# a build whose levers change its profile names where its artifacts go: -o, or
# a -w that moves every artifact it writes. one that leaves the profile as it is
# needs neither
test overrides_placed__an_overriding_build_names_where_its_artifacts_go {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    var root: str = "";
    if (!t_plan_scaffold(?a, T_PLAN_MANIFEST, ?root)) { ret 2; }
    fin { fs.remove_all(?a, root); }
    var outputs: [4]*u8           = [4]*u8{nil, nil, "bin/app", nil};
    var works:   [4]*u8           = [4]*u8{nil, nil, nil, "out/optimized"};
    var levers:  [4]request.Lever = [4]request.Lever{request.LEVER_PROFILE, request.LEVER_ON, request.LEVER_ON, request.LEVER_ON};
    var refused: [4]bool          = [4]bool{false, true, false, false};
    var i:       usize            = 0;
    for (i < 4) {
        var cli: args.CliArgs = t_plan_cli(?a, "host", "app", false);
        cli.optimize = levers[i];
        cli.output   = outputs[i];
        cli.work     = works[i];
        var ps:      session.Session;
        val planned: res[Planned, fail.Fail] = plan_invocation(?a, root, ?cli, request.GOAL_ARTIFACT, manifest.ARTIFACT_DEFAULT_SET, false, ?ps);
        if (sel planned.err) { ret (10 + i)::i32; }
        var p:      Planned        = planned.ok;
        val placed: err[fail.Fail] = overrides_placed(?a, ?cli, ?p);
        session.dnit(?ps);
        if (refused[i] != sel placed.err) { ret (20 + i)::i32; }
        if (sel placed.err) {
            if (!str_contains(fail.describe(placed.err), "name an artifact path with -o or a work directory with -w")) { ret (30 + i)::i32; }
        }
        i = i + 1;
    }
    ret 0;
}

#[testing]
val T_NOGIT_MANIFEST: str = "[project]\nmach = \">=5\"\nid = \"nogit\"\nversion = \"0.0.0\"\nsrc = \"src\"\nwork = \"out/{target.name}/{profile.name}\"\n\n[target.host]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[artifact.app]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"{project.work}/bin/app\"\ntargets = [\"host\"]\nlink = []\nneed = []\n\n[profile.debug]\ndefault = true\noptimize = false\ndebug = false\nsimd = \"scalarize\"\n\n[dep.nogitlib]\ngit = \"https://example.invalid/nogitlib.git\"\nref = \"branch/main\"\n";

#[testing]
val T_NOGIT_LIB_MANIFEST: str = "[project]\nmach = \">=5\"\nid = \"nogitlib\"\nversion = \"0.0.0\"\nsrc = \"src\"\nwork = \"out/{target.name}/{profile.name}\"\n[profile.debug]\noptimize = false\ndebug = false\nsimd = \"scalarize\"\n\n[artifact.lib]\nkind = \"static\"\nentry = \"lib.mach\"\nout = \"{project.work}/lib/l\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";

#[testing]
val T_NOGIT_MAIN: str = "use nogitlib.lib;\n\n#[symbol(\"_start\")]\nfun start() {\n    val c: u64 = lib.code();\n    asm x86_64 {\n        mov rax, 60\n        mov rdi, {c}\n        syscall\n    }\n}\n";

# run git in `dir` with a fixed identity, so a commit needs no user configuration
#[testing]
fun t_git_ok(a: *A.Allocator, dir: str, args: *str, count: usize) bool {
    val program: res[str, fail.Fail] = host.program_resolve(a, "git");
    if (sel program.err) { ret false; }
    var argv: [12]*u8;
    if (count > 4) { ret false; }
    argv[0] = program.ok::*u8;
    argv[1] = "-C"::*u8;
    argv[2] = dir::*u8;
    argv[3] = "-c"::*u8;
    argv[4] = "user.name=mach-test"::*u8;
    argv[5] = "-c"::*u8;
    argv[6] = "user.email=mach-test@example.invalid"::*u8;
    var i: usize = 0;
    for (i < count) {
        argv[7 + i] = args[i]::*u8;
        i           = i + 1;
    }
    argv[7 + count] = nil;
    val ran: res[exec.ExitStatus, exec.Error] = exec.run(program.ok, ?argv[0], exec.Environment.inherit{});
    if (sel ran.err) { ret false; }
    val status: exec.ExitStatus = ran.ok;
    ret exec.exited(status) && exec.code(status) == 0;
}

# `mach build` of a project whose dependency is a git checkout runs no git process: the
# build only locates each dependency and reads its manifest. PATH is pointed at
# a stand-in git that records every run, so any git the build spawns is caught
test build__a_checked_out_dependency_runs_no_git {
    $if ($mach.build.os != $mach.os.linux)      { ret 0; }
    $if ($mach.build.arch != $mach.arch.x86_64) { ret 0; }
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val created: res[fs.TempFile, fs.FsError] = fs.temp_create(?a, "mach_build_no_git");
    if (sel created.err) { ret 2; }
    var temporary: fs.TempFile = created.ok;
    val root:      str         = fs.temp_path(?temporary);
    fs.temp_close_and_remove(?temporary);
    fin { fs.remove_all(?a, root); }
    val dep: str = fixture.join(?a, root, "dep/nogitlib");
    if (!fixture.write(?a, root, "mach.toml", T_NOGIT_MANIFEST)
        || !fixture.write(?a, fixture.join(?a, root, "src"), "main.mach", T_NOGIT_MAIN)
        || !fixture.write(?a, dep, "mach.toml", T_NOGIT_LIB_MANIFEST)
        || !fixture.write(?a, fixture.join(?a, dep, "src"), "lib.mach", "pub fun code() u64 { ret 0; }\n")) { ret 3; }
    var init:   [2]str = [2]str{"init", "-q"};
    var add:    [2]str = [2]str{"add", "-A"};
    var commit: [4]str = [4]str{"commit", "-q", "-m", "checked out"};
    if (!t_git_ok(?a, dep, ?init[0], 2) || !t_git_ok(?a, dep, ?add[0], 2) || !t_git_ok(?a, dep, ?commit[0], 4)) { ret 4; }

    val fake_dir: str                              = fixture.join(?a, root, "fakebin");
    val marker:   str                              = fixture.join(?a, root, "git-ran");
    val script:   res[str, std_format.FormatError] = std_format.sprint(?a, "#!/bin/sh\necho \"$*\" >> '{}'\nexit 1\n", marker);
    if (sel script.err) { ret 5; }
    val created_dir: err[fs.FsError] = fs.create_dir_all(?a, fake_dir, 0o755);
    if (sel created_dir.err) { ret 5; }
    val fake_git: str             = fixture.join(?a, fake_dir, "git");
    val written:  err[fs.FsError] = fs.write_bytes(fake_git, script.ok::*u8, str_len(script.ok), 0o755);
    if (sel written.err) { ret 5; }
    val path_entry: res[str, std_format.FormatError] = std_format.sprint(?a, "PATH={}", fake_dir);
    if (sel path_entry.err) { ret 6; }

    # the build resolves git through PATH from the native capture, which an inheriting child
    # is handed as it is, so the entry is swapped there
    val envp: **u8  = env.environ_native()::ptr::**u8;
    var at:   usize = 0;
    for (envp[at] != nil && !str_starts_with(envp[at]::str, "PATH=")) { at = at + 1; }
    if (envp[at] == nil) { ret 6; }
    val inherited: *u8 = envp[at];
    envp[at] = path_entry.ok::*u8;
    fin { envp[at] = inherited; }
    val resolved: res[str, fail.Fail] = host.program_resolve(?a, "git");
    if (!(sel resolved.ok && str_equals(resolved.ok, fake_git))) { ret 7; }

    var argv: [3]*u8;
    argv[0] = "mach"::*u8;
    argv[1] = "build"::*u8;
    argv[2] = root::*u8;
    if (t_build(3, ?argv[0]) != 0) { ret 8; }
    val ran: res[bool, io_error.Error] = fs.exists(marker);
    if (!(sel ran.ok && !ran.ok)) { ret 9; }
    ret 0;
}
