# length of BUILD_FLAGS
val BUILD_FLAGS_N: usize = 28;
# the flags mach build takes
val BUILD_FLAGS: [BUILD_FLAGS_N]*std_args.Flag = [BUILD_FLAGS_N]*std_args.Flag{
    ?args.HELP, ?args.DIAGNOSTICS, ?args.ARTIFACT, ?args.TARGET, ?args.PROFILE, ?args.ALL, ?args.OUTPUT,
    ?args.VERBOSE, ?args.QUIET, ?args.SET, ?args.VERIFY, ?args.OPTIMIZE, ?args.DEBUG, ?args.WORK, ?args.EMIT,
    ?args.SOURCE, ?args.KIND, ?args.LINKAGE, ?args.ENV, ?args.ABI, ?args.ISA, ?args.EXT, ?args.CODE_MODEL,
    ?args.THREADS, ?args.LIB_DIR, ?args.LIB, ?args.NO_CACHE, ?args.PLAN,
};

# length of BUILD_CONFLICTS
val BUILD_CONFLICTS_N: usize = 1;
# `--plan` prints a plan, which `--quiet` would suppress
val BUILD_CONFLICTS: [BUILD_CONFLICTS_N]args.Conflict = [BUILD_CONFLICTS_N]args.Conflict{
    args.Conflict{flag: ?args.PLAN, other: ?args.QUIET},
};

# length of BUILD_CONSTRAINTS
val BUILD_CONSTRAINTS_N: usize = 6;
# the constraint sentences help prints for build; the first is enforced by
# manifest.resolve_cells, the second, the fourth, the fifth and the sixth by the build command,
# the third by the build plan's output path
val BUILD_CONSTRAINTS: [BUILD_CONSTRAINTS_N]str = [BUILD_CONSTRAINTS_N]str{
    args.SELECTOR_CONSTRAINT,
    "-o requires the selection to resolve to exactly one (artifact, target, profile)",
    manifest.OUTPUT_CONSTRAINT,
    OVERRIDE_CONSTRAINT,
    ENTRY_ONLY,
    ENTRY_SELECTS_NOTHING,
};

# the rule the entry options keep, which build prints and refuses by
val ENTRY_ONLY: str = "--source, --kind, --linkage and the narrowing flags state a build of an entry file, a .mach operand; a project declares its sources, kinds, linkages and targets in mach.toml, and -t selects a declared target";

# the rule an entry build keeps, which build prints and refuses by
val ENTRY_SELECTS_NOTHING: str = "a build of an entry file states one artifact for one target with no profile, so -a, -p and --all select nothing in it, and -t names its one target as <sys>-<arch>, the host's when left out";

# the rule a build that overrides its profile keeps, which build prints and refuses by
val OVERRIDE_CONSTRAINT: str = "a lever that changes the selected profile requires -o or -w, so the differently configured build does not overwrite the profile's own artifacts";

# `mach build`
pub val COMMAND: std_args.Command = std_args.Command{name: "build", aliases: args.NO_WORDS, help: "compile a project or one entry file", usage: "<path|entry.mach> [inputs...]", flags: Slice[*std_args.Flag]{data: ?BUILD_FLAGS[0], size: BUILD_FLAGS_N}, commands: args.NO_COMMANDS, operand_min: 0, operand_max: std_args.OPERANDS_ANY, passthrough: false};
# what mach holds `mach build` to beyond the parse
pub val POLICY: args.Policy = args.Policy{constraints: Slice[str]{data: ?BUILD_CONSTRAINTS[0], size: BUILD_CONSTRAINTS_N}, refused: args.NO_FLAGS, refusal: "", conflicts: Slice[args.Conflict]{data: ?BUILD_CONFLICTS[0], size: BUILD_CONFLICTS_N}};

# length of CHECK_FLAGS
val CHECK_FLAGS_N: usize = 8;
# the flags mach check takes: the selectors but `-o`, since nothing is written, and the readout
val CHECK_FLAGS: [CHECK_FLAGS_N]*std_args.Flag = [CHECK_FLAGS_N]*std_args.Flag{
    ?args.HELP, ?args.DIAGNOSTICS, ?args.ARTIFACT, ?args.TARGET, ?args.PROFILE, ?args.ALL, ?args.VERBOSE, ?args.QUIET,
};

# length of CHECK_CONSTRAINTS
val CHECK_CONSTRAINTS_N: usize = 1;
# the constraint sentences help prints for check
val CHECK_CONSTRAINTS: [CHECK_CONSTRAINTS_N]str = [CHECK_CONSTRAINTS_N]str{
    args.SELECTOR_CONSTRAINT,
};

# `mach check`
pub val CHECK: std_args.Command = std_args.Command{name: "check", aliases: args.NO_WORDS, help: "check project source without building", usage: "<path>", flags: Slice[*std_args.Flag]{data: ?CHECK_FLAGS[0], size: CHECK_FLAGS_N}, commands: args.NO_COMMANDS, operand_min: 1, operand_max: 1, passthrough: false};
# what mach holds `mach check` to beyond the parse
pub val CHECK_POLICY: args.Policy = args.Policy{constraints: Slice[str]{data: ?CHECK_CONSTRAINTS[0], size: CHECK_CONSTRAINTS_N}, refused: args.NO_FLAGS, refusal: "", conflicts: args.NO_CONFLICTS};

# a command's selection, planned: the cells the selectors resolved to, and one
# plan per selected profile in the order the cells name them
# ---
# manifest: the root manifest the plans were made from, in the planning session
# cells:    the resolved (artifact, target, profile) cells
# plans:    one plan per profile; each plans that profile's cells
pub rec Planned {
    manifest: *manifest.Manifest;
    cells:    Vector[manifest.Cell];
    plans:    Vector[build_plan.BuildPlan];
}

# initialise a session, load the manifest, resolve the selectors and plan a
# build of every resolved cell, one plan per profile
# ---
# a:              allocator for the request
# root:           the project root directory
# cli:            the parsed arguments
# goal:           what to produce, objects or the finished artifact
# mode:           how an artifact axis given no pattern is filled without `--all`
# configure_deps: also resolve every cell against the realized dependency closure,
#                 filling in its exported dependency steps and export link requirements. a build
#                 that goes on to execute resolves each cell as it runs it, so only a caller that
#                 reports the plan instead of running it asks for this
# ps:             out; the session the plans refer to, initialised here; on an error it has already been
#                 torn down and the returned failure message is owned by `a`
# ret:            the plans, or a Fail: internal for session or registry setup, user for manifest,
#                 selection, request and dependency-configuration errors, `-o` over several cells,
#                 and whatever planning returns
pub fun plan_invocation(a: *A.Allocator, root: str, cli: *args.CliArgs, goal: request.BuildGoal,
    mode: manifest.ArtifactDefault, configure_deps: bool, ps: *session.Session) res[Planned, fail.Fail] {
    val res_session: res[session.Session, fail.Fail] = toolchain.session_init(a);
    if (sel res_session.err) { ret res[Planned, fail.Fail].err{fail.prefixed(a, "failed to initialise compiler session: ", res_session.err)}; }
    @ps = res_session.ok;

    # the plans borrow the manifest, so it lives in the session they run in
    var res_manifest: res[manifest.Manifest, fail.Fail];
    if (cli.entry.file != nil) { res_manifest = entry_manifest(ps, cli); }
    or                         { res_manifest = driver.load_manifest(ps, root); }
    if (sel res_manifest.err) {
        ret plan_failure(a, ps, res_manifest.err);
    }
    val held: res[*manifest.Manifest, A.Error] = A.allocate[manifest.Manifest](ps.alloc, 1);
    if (sel held.err) { ret plan_failure(a, ps, fail.refused(held.err)); }
    val m: *manifest.Manifest = held.ok;
    @m = res_manifest.ok;
    if (cli.overrides.work != nil) {
        val worked: err[fail.Fail] = request.work_apply(?ps.interner, cli.overrides.work::str, m);
        if (sel worked.err) { ret plan_failure(a, ps, worked.err); }
    }
    val set: err[fail.Fail] = manifest.apply(ps.build_alloc, ?ps.interner, m, cli.settings.data, cli.settings.len);
    if (sel set.err) { ret plan_failure(a, ps, set.err); }
    # the target an entry build's command line states is the one it builds, host or not
    if (cli.entry.file != nil && m.target_count == 1) {
        val named: res[usize, A.Error] = collections_vector.push[str](?cli.selectors.targets, intern.text(?ps.interner, m.targets[0].name));
        if (sel named.err) { ret plan_failure(a, ps, fail.refused(named.err)); }
    }

    val selected: res[Planned, fail.Fail] = plan_selection(a, ps, m, root, cli, goal, mode, configure_deps,
        driver_closure.UNREALIZED_REFUSED);
    if (sel selected.err) {
        ret plan_failure(a, ps, selected.err);
    }
    var planned:  Planned        = selected.ok;
    val disjoint: err[fail.Fail] = build_plan.check_plan_outputs(ps.alloc, ?planned.plans);
    if (sel disjoint.err) {
        ret plan_failure(a, ps, disjoint.err);
    }
    ret res[Planned, fail.Fail].ok{planned};
}

# resolve the selectors against a loaded manifest and plan every resolved cell,
# one plan per profile. plans of different profiles are not checked against
# each other: a caller that runs them all checks they write disjoint outputs
# ---
# a:          allocator for the requests
# ps:         the session the manifest was loaded in; owns the plans
# m:          the root manifest
# unrealized: what a dependency nothing is realized for is
# ret:        the plans; err from selection, a request, planning or dependency configuration
pub fun plan_selection(a: *A.Allocator, ps: *session.Session, m: *manifest.Manifest, root: str, cli: *args.CliArgs,
    goal: request.BuildGoal, mode: manifest.ArtifactDefault, configure_deps: bool,
    unrealized: driver_closure.Unrealized) res[Planned, fail.Fail] {
    val resolved: res[Vector[manifest.Cell], fail.Fail] = manifest.resolve_cells(ps.alloc, ?ps.interner, m, ?cli.selectors, mode);
    if (sel resolved.err) {
        ret res[Planned, fail.Fail].err{args.selection_hint(ps.alloc, ?cli.selectors, resolved.err)};
    }
    var planned: Planned;
    planned.manifest = m;
    planned.cells    = resolved.ok;
    planned.plans    = collections_vector.init[build_plan.BuildPlan](ps.alloc);
    if (cli.overrides.output != nil && planned.cells.len != 1) {
        ret res[Planned, fail.Fail].err{manifest.single_selection_fail(ps.alloc, diagnostic_kind.OUTPUT_AMBIGUOUS, "-o names one output", ?planned.cells)};
    }

    var first: usize = 0;
    for (first < planned.cells.len) {
        val profile: str                   = planned.cells.data[first].profile;
        var group:   Vector[manifest.Cell] = collections_vector.init[manifest.Cell](ps.alloc);
        var next:    usize                 = first;
        for (next < planned.cells.len && str_equals(planned.cells.data[next].profile, profile)) {
            collections_vector.push[manifest.Cell](?group, planned.cells.data[next]);
            next = next + 1;
        }
        first = next;

        val res_req: res[request.BuildRequest, fail.Fail] = request.compose(a, ?ps.interner, m, ?cli.overrides, root, goal, profile);
        if (sel res_req.err) {
            ret res[Planned, fail.Fail].err{res_req.err};
        }
        val plan_r: res[build_plan.BuildPlan, fail.Fail] = build_plan.plan_cells(ps.alloc, ?ps.interner, m,
            res_req.ok, ?group);
        if (sel plan_r.err) {
            ret res[Planned, fail.Fail].err{plan_r.err};
        }
        var bp: build_plan.BuildPlan = plan_r.ok;

        val required: err[fail.Fail] = build_plan.plan_dependency_requirements(ps, ?bp, unrealized);
        if (sel required.err) {
            ret res[Planned, fail.Fail].err{required.err};
        }

        if (configure_deps) {
            val configured: err[fail.Fail] = build_plan.configure(ps, ?bp);
            if (sel configured.err) {
                ret res[Planned, fail.Fail].err{configured.err};
            }
        }
        val pushed: res[usize, A.Error] = collections_vector.push[build_plan.BuildPlan](?planned.plans, bp);
        if (sel pushed.err) {
            ret res[Planned, fail.Fail].err{fail.refused(pushed.err)};
        }
    }
    ret res[Planned, fail.Fail].ok{planned};
}

# an entry build of `file`: it selects nothing, `-t` names its target, and the levers set the
# profile it states rather than override one, so the build writes where the entry build always does
fun entry_build(config: *args.CliArgs, file: str) err[fail.Fail] {
    val s: *manifest.Selectors = ?config.selectors;
    if (s.artifacts.len > 0 || s.targets.len > 1 || s.profiles.len > 0 || s.all) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.CLI_FLAG_INAPPLICABLE, ENTRY_SELECTS_NOTHING)};
    }
    # `-t` names the entry build's target rather than select a declared one
    if (s.targets.len == 1) {
        config.entry.target = s.targets.data[0];
        s.targets.len       = 0;
    }
    config.entry.file         = file;
    config.entry.optimize     = config.overrides.optimize == request.LEVER_ON;
    config.entry.debug        = config.overrides.debug != request.LEVER_OFF;
    config.overrides.optimize = request.LEVER_PROFILE;
    config.overrides.debug    = request.LEVER_PROFILE;
    ret err[fail.Fail].ok{};
}

# the project an entry build's command line states
fun entry_manifest(ps: *session.Session, cli: *args.CliArgs) res[manifest.Manifest, fail.Fail] {
    var kind: str = cli.entry.kind;
    if (kind == nil) { kind = "bin"; }
    var er: driver_entry.EntryRequest = driver_entry.EntryRequest{
        entry:        cli.entry.file,
        kind:         kind,
        linkage:      cli.entry.linkage,
        sources:      cli.entry.sources.data,
        source_count: cli.entry.sources.len,
        target:       cli.entry.target,
        narrowing:    cli.entry.narrowing,
        optimize:     cli.entry.optimize,
        debug:        cli.entry.debug,
    };
    ret driver_entry.entry_manifest(ps, ?er);
}

# a build that changes its profile names where its artifacts go: with neither
# `-o` nor `-w` it would write them over the profile's own, and with `-w` alone
# every artifact it writes must sit in the work directory `-w` moves
fun overrides_placed(a: *A.Allocator, cli: *args.CliArgs, planned: *Planned) err[fail.Fail] {
    if (cli.overrides.output != nil) { ret err[fail.Fail].ok{}; }
    var pi: usize = 0;
    for (pi < planned.plans.len) {
        val bp: *build_plan.BuildPlan = ?planned.plans.data[pi];
        pi = pi + 1;
        if (!bp.request.overrides) { cnt; }
        if (cli.overrides.work == nil) {
            ret err[fail.Fail].err{fail.user(diagnostic_kind.CLI_FLAG_CONFLICT, OVERRIDE_REFUSAL)};
        }
        var ui: usize = 0;
        for (ui < bp.units.len) {
            val u: *build_plan.BuildUnit = ?bp.units.data[ui];
            ui = ui + 1;
            if (str_empty(u.out_path) || build_plan.under_dir(u.out_path, u.out_dir)) { cnt; }
            ret err[fail.Fail].err{fail.formatted_user(a, diagnostic_kind.CLI_FLAG_CONFLICT,
                "these options would write a differently configured build over the profile's existing artifacts: '{}' is written outside the work directory, so -w does not move it; name its path with -o", u.out_path)};
        }
    }
    ret err[fail.Fail].ok{};
}

val OVERRIDE_REFUSAL: str = "these options would write a differently configured build over the profile's existing artifacts; name an artifact path with -o or a work directory with -w";

# name the profile a plan builds before its progress lines, when a selection
# spans several profiles and the report is for a person
# ---
# r:       the report
# planned: the planned selection
# bp:      the plan about to run
# quiet:   `--quiet`
pub fun announce_profile(r: *cli_diagnostic.Report, planned: *Planned, bp: *build_plan.BuildPlan, quiet: bool) {
    if (quiet || planned.plans.len < 2 || r.format != cli_diagnostic.FORMAT_HUMAN) { ret; }
    std_format.write_str(?r.w, "profile ");
    std_format.write_str(?r.w, bp.request.profile);
    std_format.write_str(?r.w, ":\n");
}

# tear the session down and return a failure whose message outlives it: a message
# the session allocated dies with `session.dnit`, and every caller renders it after
fun plan_failure(a: *A.Allocator, ps: *session.Session, failure: fail.Fail) res[Planned, fail.Fail] {
    var stable: fail.Fail               = fail.message("failed to retain the build planning error");
    val kept:   res[fail.Fail, A.Error] = fail.retain(a, failure);
    if (sel kept.ok) { stable = kept.ok; }
    session.dnit(ps);
    ret res[Planned, fail.Fail].err{stable};
}

# `mach build`: plan and execute a build of the project operand, rendering diagnostics to
# stderr as each unit reports them. `--plan` prints the
# effective plan and stops without running a generator, a compiler or a linker; `-v` adds
# each phase row as the phase finishes, and `-vv` each module or file as it finishes
# ---
# cx:  the call
# ret: 0 success, 1 user error, 2 internal failure, 3 environment failure; every failure is
#      reported on the call's report with the phase it came from
pub fun run(cx: *args.Call) res[i64, fail.Fail] {
    ret res[i64, fail.Fail].ok{run_reported(cx, request.GOAL_ARTIFACT)};
}

# `mach check`: plan the same cells `mach build` would and run each through the
# frontend only, load, resolve and sema, reporting the same diagnostics with the
# same classification. no build step runs, nothing is generated, compiled, linked
# or written, and a generated or embedded input that does not exist yet is an
# error naming it rather than a reason to run the step
# ---
# cx:  the call
# ret: 0 accepted, 1 rejected or user error, 2 internal failure, 3 environment failure
pub fun check(cx: *args.Call) res[i64, fail.Fail] {
    ret res[i64, fail.Fail].ok{run_reported(cx, request.GOAL_CHECK)};
}

fun run_reported(cx: *args.Call, requested_goal: request.BuildGoal) i64 {
    val r:    *cli_diagnostic.Report = cx.report;
    val inv:  *std_args.Parsed       = cx.inv;
    var goal: request.BuildGoal      = requested_goal;

    val res_config: res[args.CliArgs, fail.Fail] = args.build_cli_invocation(cx.a, inv);
    if (sel res_config.err) { ret cli_diagnostic.report_fail(r, res_config.err, diagnostic.ORIGIN_NONE); }
    var config: args.CliArgs = res_config.ok;
    # `-e obj` without `-e exe` stops at the objects; asm and ir ride on either goal
    val stops: bool = (config.emits & args.EMIT_KIND_OBJ) != 0 && (config.emits & args.EMIT_KIND_EXE) == 0;
    if (goal == request.GOAL_ARTIFACT && stops) { goal = request.GOAL_OBJECTS; }

    val plan_only: bool = std_args.given(inv, ?args.PLAN);

    val arg: *u8 = args.operand(inv, 0);

    var root: str = nil;
    if (arg != nil && types_string.str_ends_with(arg::str, ".mach")) {
        val placed: err[fail.Fail] = entry_build(?config, arg::str);
        if (sel placed.err) { ret cli_diagnostic.report_fail(r, placed.err, diagnostic.ORIGIN_NONE); }
        root = ".";
    }
    or {
        if (args.entry_stated(?config.entry)) { ret cli_diagnostic.report_fail(r, fail.user(diagnostic_kind.CLI_FLAG_INAPPLICABLE, ENTRY_ONLY), diagnostic.ORIGIN_NONE); }
        val loc_r: res[util.ProjectLocation, fail.Fail] = util.resolve_project_location(cx.a, arg);
        if (sel loc_r.err) { ret cli_diagnostic.report_fail(r, loc_r.err, diagnostic.ORIGIN_NONE); }
        root = loc_r.ok.root;
    }
    r.root = root;

    val col_r: err[fail.Fail] = args.collect_link_inputs(cx.a, ?config, inv);
    if (sel col_r.err) { ret cli_diagnostic.report_fail(r, col_r.err, diagnostic.ORIGIN_NONE); }

    var ps:     session.Session;
    val plan_r: res[Planned, fail.Fail] = plan_invocation(cx.a, root, ?config, goal,
        manifest.ARTIFACT_DEFAULT_SET, plan_only, ?ps);
    if (sel plan_r.err) { ret cli_diagnostic.report_fail(r, plan_r.err, diagnostic.ORIGIN_BUILD); }
    fin { session.dnit(?ps); }
    var planned: Planned = plan_r.ok;
    if (goal != request.GOAL_CHECK && !plan_only) {
        val placed: err[fail.Fail] = overrides_placed(cx.a, ?config, ?planned);
        if (sel placed.err) { ret cli_diagnostic.report_fail(r, placed.err, diagnostic.ORIGIN_NONE); }
    }

    # every plan runs, as every cell of one plan does; the worst outcome is the exit
    var code: i64   = exit.OK;
    var pi:   usize = 0;
    for (pi < planned.plans.len) {
        val bp: *build_plan.BuildPlan = ?planned.plans.data[pi];
        pi = pi + 1;
        if (plan_only) {
            val shown: err[fail.Fail] = build_plan.explain(cx.a, bp, ?ps.interner);
            if (sel shown.err) { ret cli_diagnostic.report_fail(r, shown.err, diagnostic.ORIGIN_BUILD); }
            cnt;
        }

        announce_profile(r, ?planned, bp, config.quiet);
        var rd: cli_diagnostic.Readout;
        cli_diagnostic.readout_init(?rd, r, bp.units.len, config.quiet, config.verbosity);
        val ex_r: res[outcome.BuildOutcome, fail.Fail] = engine.execute(bp, cx.backing, cx.a, ?rd.sink);
        cli_diagnostic.readout_close(?rd);
        if (sel ex_r.err) { ret cli_diagnostic.report_fail(r, ex_r.err, diagnostic.ORIGIN_BUILD); }
        var bo: outcome.BuildOutcome = ex_r.ok;
        code = exit.worst(code, cli_diagnostic.outcome_code(?bo));
        outcome.outcome_dnit(?bo);
    }
    ret code;
}
