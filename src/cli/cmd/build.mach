# initialise a session, load the manifest, and plan a build for parsed CLI arguments
# ---
# a: allocator for the request
# root: the project root directory
# cli: the parsed arguments
# goal: what to produce, objects or an executable
# configure_deps: also resolve every cell against the realized dependency closure,
#  filling in its exported dependency steps and export link requirements. a build
#  that goes on to execute resolves each cell as it runs it, so only a caller that
#  reports the plan instead of running it asks for this
# ps: out; the session the plan refers to, initialised here; on an error it has already been
#  torn down and the returned failure message is owned by `a`
# ret: the plan, configured against the realized dependency closure, or a Fail:
#  internal for session or registry setup, user for manifest, selection, request
#  and dependency-configuration errors, and whatever plan.plan returns
pub fun plan_invocation(a: *A.Allocator, root: str, cli: *args.CliArgs, goal: request.BuildGoal,
                        configure_deps: bool, ps: *session.Session) res[plan.BuildPlan, outcome.Fail] {
    val res_session: res[session.Session, fail.Fail] = session.init_typed(a);
    if (sel res_session.err) {
        ret res[plan.BuildPlan, outcome.Fail].err{outcome.internal("failed to initialise compiler session")};
    }
    @ps = res_session.ok;

    val res_register: err[outcome.Fail] = driver.setup_registry(?ps.registry);
    if (sel res_register.err) {
        ret plan_failure(a, ps, res_register.err);
    }

    val res_manifest: res[manifest.Manifest, outcome.Fail] = driver.load_manifest(ps, root);
    if (sel res_manifest.err) {
        ret plan_failure(a, ps, res_manifest.err);
    }
    var m: manifest.Manifest = res_manifest.ok;

    var pick: manifest.Selection;
    val sr: err[outcome.Fail] = args.selection_from_config(cli, ?pick);
    if (sel sr.err) {
        ret plan_failure(a, ps, sr.err);
    }

    val res_req: res[request.BuildRequest, outcome.Fail] = request.compose(a, ?ps.interner, ?m, cli, root, goal, ?pick);
    if (sel res_req.err) {
        ret plan_failure(a, ps, res_req.err);
    }

    val plan_r: res[plan.BuildPlan, outcome.Fail] = plan.plan(ps.alloc, ?ps.interner, ?ps.registry, ?m,
        res_req.ok);
    if (sel plan_r.err) {
        ret plan_failure(a, ps, plan_r.err);
    }
    var bp: plan.BuildPlan = plan_r.ok;

    if (configure_deps) {
        val configured: err[outcome.Fail] = plan.configure(ps, ?m, ?bp);
        if (sel configured.err) {
            ret plan_failure(a, ps, configured.err);
        }
    }
    ret res[plan.BuildPlan, outcome.Fail].ok{bp};
}

# tear the session down and return a failure whose message outlives it: a message
# the session allocated dies with `session.dnit`, and every caller renders it after
fun plan_failure(a: *A.Allocator, ps: *session.Session, failure: outcome.Fail) res[plan.BuildPlan, outcome.Fail] {
    var stable: outcome.Fail = failure;
    val carried: opt[str] = outcome.text(failure);
    if (sel carried.some) {
        val copied: res[str, A.Error] = str_dup(a, carried.some);
        if (sel copied.err) { stable = outcome.internal("failed to retain the build planning error"); }
        if (sel copied.ok) { stable = outcome.with_text(failure, copied.ok); }
    }
    session.dnit(ps);
    ret res[plan.BuildPlan, outcome.Fail].err{stable};
}

# `mach build`: plan and execute a build of the project operand, rendering diagnostics and
# the outcome to stderr. `-O1` is refused before parsing; `--plan` prints the effective
# plan and stops without running a generator, a compiler or a linker; `-v` and `-vv`
# render the phase readout after the build
# ---
# argv: the full process arguments
# inv: the parsed invocation for this command
# ret: 0 success, 1 user error, 2 internal failure, 3 environment failure
pub fun run_typed(argv: **u8, inv: *args.ParsedInvocation) i64 {
    ret run_invocation(argv, inv, args.CMD_BUILD, request.GOAL_EXECUTE);
}

# `mach check`: plan the same cells `mach build` would and run each through the
# frontend only, load, resolve and sema, reporting the same diagnostics with the
# same classification. no build step runs, nothing is generated, compiled, linked
# or written, and a generated or embedded input that does not exist yet is an
# error naming it rather than a reason to run the step
# ---
# argv: the full process arguments
# inv: the parsed invocation for this command
# ret: 0 accepted, 1 rejected or user error, 2 internal failure, 3 environment failure
pub fun check_typed(argv: **u8, inv: *args.ParsedInvocation) i64 {
    if (inv.positional_count != 1) {
        val f: outcome.Fail = outcome.user("mach check expects one project path");
        ret cli_diag.render_fail(?f);
    }
    ret run_invocation(argv, inv, args.CMD_CHECK, request.GOAL_CHECK);
}

fun run_invocation(argv: **u8, inv: *args.ParsedInvocation, cmd: args.CommandId,
                   requested_goal: request.BuildGoal) i64 {
    var goal: request.BuildGoal = requested_goal;
    val opt_emit: opt[*u8] = args.invocation_value(cmd, inv, argv, "--emit");
    if (sel opt_emit.some) {
        val kind: str = opt_emit.some::str;
        val goal_o: opt[request.BuildGoal] = request.goal_from_emit_name(kind);
        if (sel goal_o.none) {
            val f: outcome.Fail = outcome.user(request.EMIT_ERROR);
            ret cli_diag.render_fail(?f);
        }
        goal = goal_o.some;
    }

    var backing: A.Allocator;
    val make_r: err[A.Error] = page.make(?backing);
    if (sel make_r.err) {
        val f: outcome.Fail = outcome.internal("failed to initialise allocator");
        ret cli_diag.render_fail(?f);
    }

    val res_config: res[args.CliArgs, outcome.Fail] = args.build_cli_invocation(cmd, inv, argv);
    if (sel res_config.err) {
        val f: outcome.Fail = res_config.err;
        ret cli_diag.render_fail(?f);
    }
    var config: args.CliArgs = res_config.ok;
    if (config.bin != nil && config.lib != nil) {
        val f: outcome.Fail = outcome.user("--bin and --lib cannot be combined");
        ret cli_diag.render_fail(?f);
    }

    val plan_only: bool = args.invocation_flag(cmd, inv, "--plan");
    if (quiet_plan_conflict(config.quiet, plan_only)) {
        val f: outcome.Fail = outcome.user("`--plan` and `--quiet`/`-q` cannot be combined");
        ret cli_diag.render_fail(?f);
    }
    var command_name: str = "mach build";
    if (cmd == args.CMD_CHECK) { command_name = "mach check"; }
    if (args.reject_unknown_from_invocation(inv, argv, command_name)) { ret 1; }

    var arg: *u8 = nil;
    if (inv.has_positional) { arg = argv[inv.positional_idx]; }

    val loc_r: res[util.ProjectLocation, outcome.Fail] = util.resolve_project_location(?backing, arg);
    if (sel loc_r.err) {
        val f: outcome.Fail = loc_r.err;
        ret cli_diag.render_fail(?f);
    }
    val loc: util.ProjectLocation = loc_r.ok;
    val root: str = loc.root;

    val col_r: err[outcome.Fail] = args.collect_link_inputs(?backing, ?config, cmd, inv, argv);
    if (sel col_r.err) {
        val f: outcome.Fail = col_r.err;
        ret cli_diag.render_fail(?f);
    }

    var menu_ar: arena.Arena;
    val init_r: err[A.Error] = arena.init(?menu_ar, ?backing, 0);
    if (sel init_r.err) {
        val f: outcome.Fail = outcome.internal("failed to initialise allocator");
        ret cli_diag.render_fail(?f);
    }
    var menu_alloc: A.Allocator;
    val make_r2: err[A.Error] = arena.make(?menu_alloc, ?menu_ar);
    if (sel make_r2.err) {
        arena.dnit(?menu_ar);
        val f: outcome.Fail = outcome.internal("failed to initialise allocator");
        ret cli_diag.render_fail(?f);
    }

    var ps: session.Session;
    val plan_r: res[plan.BuildPlan, outcome.Fail] = plan_invocation(?menu_alloc, root, ?config, goal, plan_only, ?ps);
    if (sel plan_r.err) {
        var f: outcome.Fail = plan_r.err;
        val c: i64 = cli_diag.render_fail(?f);
        arena.dnit(?menu_ar);
        ret c;
    }
    val bp: plan.BuildPlan = plan_r.ok;

    if (plan_only) {
        val shown: err[outcome.Fail] = plan.explain(?menu_alloc, ?bp, ?ps.interner);
        var code: i64 = 0;
        if (sel shown.err) {
            val failure: outcome.Fail = shown.err;
            code = cli_diag.render_fail(?failure);
        }
        session.dnit(?ps);
        arena.dnit(?menu_ar);
        ret code;
    }

    var pr: readout.Progress;
    var ev: *readout.Progress = nil;
    if (config.verbosity > 0) {
        readout.init(?pr, ?menu_alloc, config.verbosity);
        ev = ?pr;
    }

    val ex_r: res[outcome.BuildOutcome, outcome.Fail] = engine.execute(?bp, ?backing, ?menu_alloc, ev);
    if (ev != nil) {
        readout.render(ev);
        readout.dnit(ev);
    }

    var code: i64 = 0;
    if (sel ex_r.err) {
        var f: outcome.Fail = ex_r.err;
        code = cli_diag.render_fail(?f);
    }
    if (sel ex_r.ok) {
        var bo: outcome.BuildOutcome = ex_r.ok;
        cli_diag.render_outcome(?bo, config.quiet);
        code = cli_diag.outcome_code(?bo);
        outcome.outcome_dnit(?bo);
    }

    session.dnit(?ps);
    arena.dnit(?menu_ar);
    ret code;
}

fun quiet_plan_conflict(quiet: bool, plan_only: bool) bool {
    ret quiet && plan_only;
}

fun t_build(argc: usize, argv: **u8) i64 {
    var a: A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 2; }
    val ir: res[args.ParsedInvocation, outcome.Fail] = args.parse_invocation(?a, argc, argv);
    if (sel ir.err) { ret 2; }
    var inv: args.ParsedInvocation = ir.ok;
    ret run_typed(argv, ?inv);
}

test "mach.cli.cmd.build.quiet_plan_conflict:only_the_combination_conflicts" {
    if (!quiet_plan_conflict(true, true))  { ret 1; }
    if (quiet_plan_conflict(true, false))  { ret 2; }
    if (quiet_plan_conflict(false, true))  { ret 3; }
    if (quiet_plan_conflict(false, false)) { ret 4; }
    ret 0;
}

test "mach.cli.cmd.build.run_typed:rejects_quiet_combined_with_plan" {
    var argv: [4]*u8;
    argv[0] = "mach"; argv[1] = "build"; argv[2] = "--quiet"; argv[3] = "--plan";
    if (t_build(4, ?argv[0]) != 1) { ret 1; }

    var alias: [4]*u8;
    alias[0] = "mach"; alias[1] = "build"; alias[2] = "-q"; alias[3] = "--plan";
    if (t_build(4, ?alias[0]) != 1) { ret 2; }

    ret 0;
}

fun t_req_join(a: *A.Allocator, base: str, leaf: str) str {
    val r: res[str, A.Error] = path.join(a, base, leaf);
    if (sel r.err) { ret base; }
    ret r.ok;
}

fun t_req_write(a: *A.Allocator, dir: str, name: str, body: str) bool {
    val create_dir_all_r: err[fs.FsError] = fs.create_dir_all(a, dir, 0o755);
    if (sel create_dir_all_r.err) { ret false; }
    val p: str = t_req_join(a, dir, name);
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(p, body::*u8, str_len(body), 0o644);
    ret sel write_bytes_r.ok;
}

val T_REQ_MANIFEST: str = "[project]\nid = \"reqfx\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.host]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[target.alt]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[artifact.shader-a]\nkind = \"static\"\nentry = \"shader.mach\"\nout = \"lib/shader-a.a\"\ntargets = [\"alt\"]\nlink = []\nneed = []\n\n[artifact.shader-b]\nkind = \"static\"\nentry = \"shader.mach\"\nout = \"lib/shader-b.a\"\ntargets = [\"alt\"]\nlink = []\nneed = []\n\n[artifact.app]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/app\"\ntargets = [\"host\"]\nlink = []\nneed = [\"artifact.shader-*\"]\n\n[profile.debug]\ndefault = true\nopt = 0\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n";

val T_REQ_SHADER: str = "pub fun tint(x: u64) u64 { ret x + 3; }\n";

val T_REQ_MAIN: str = "#[embed(\"{artifact.shader-a.out}\")]\nval SHADER: [_]u8;\n\n#[symbol(\"_start\")]\nfun start() {\n    var c: u64 = 1;\n    if (SHADER[0] == 0x21 && SHADER[1] == 0x3C && SHADER[6] == 0x3E && SHADER[7] == 0x0A) { c = 0; }\n    asm x86_64 {\n        mov rax, 60\n        mov rdi, {c}\n        syscall\n    }\n}\n";

fun t_req_exit_code(a: *A.Allocator, exe: str) i32 {
    var child: subprocess.OwnedSubprocess;
    subprocess.init(?child);
    var argv: [2]*u8;
    argv[0] = exe::*u8;
    argv[1] = nil;
    val spawn_r: err[subprocess.Error] = subprocess.spawn(a, ?child, exe, ?argv[0], env.environ());
    if (sel spawn_r.err) {
        subprocess.dnit(a, ?child);
        ret -1;
    }
    val wr: res[subprocess.SubprocessTerminal, subprocess.Error] = subprocess.wait(a, ?child);
    if (sel wr.err) {
        subprocess.dnit(a, ?child);
        ret -1;
    }
    val term: subprocess.SubprocessTerminal = wr.ok;
    subprocess.dnit(a, ?child);
    if (term.kind != subprocess.STATE_EXITED) { ret -1; }
    ret term.code;
}

test "mach.cli.cmd.build.run_typed:a_glob_requirement_builds_first_and_the_bin_embeds_its_output" {
    $if ($mach.build.os != $mach.os.linux)      { ret 0; }
    $if ($mach.build.arch != $mach.arch.x86_64) { ret 0; }

    var a: A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }

    val tf_r: res[fs.TempFile, fs.FsError] = fs.temp_create(?a, "mach_build_artifact_need");
    if (sel tf_r.err) { ret 1; }
    var tf: fs.TempFile = tf_r.ok;
    val root: str = fs.temp_path(?tf);
    fs.temp_close_and_remove(?tf);
    val create_dir_all_r: err[fs.FsError] = fs.create_dir_all(?a, root, 0o755);
    if (sel create_dir_all_r.err) { ret 1; }

    var bad: i32 = 0;
    if (!t_req_write(?a, root, "mach.toml", T_REQ_MANIFEST)) { bad = 1; }
    val src_dir: str = t_req_join(?a, root, "src");
    if (!t_req_write(?a, src_dir, "shader.mach", T_REQ_SHADER)) { bad = 1; }
    if (!t_req_write(?a, src_dir, "main.mach", T_REQ_MAIN))     { bad = 1; }
    if (bad != 0) { fs.remove_all(?a, root); ret 1; }

    var argv: [5]*u8;
    argv[0] = "mach"::*u8; argv[1] = "build"::*u8; argv[2] = root::*u8;
    argv[3] = "--target"::*u8; argv[4] = "host"::*u8;
    if (t_build(5, ?argv[0]) != 0) { fs.remove_all(?a, root); ret 1; }

    val lib_a: str = t_req_join(?a, root, "out/alt/debug/lib/shader-a.a");
    val lib_b: str = t_req_join(?a, root, "out/alt/debug/lib/shader-b.a");
    val app:   str = t_req_join(?a, root, "out/host/debug/bin/app");
    val is_file_r: res[bool, io_error.Error] = fs.is_file(lib_a);
    if (sel is_file_r.err) { ret 99; }
    if (!(sel is_file_r.ok && is_file_r.ok)) { bad = 1; }
    val is_file_r2: res[bool, io_error.Error] = fs.is_file(lib_b);
    if (sel is_file_r2.err) { ret 99; }
    if (!(sel is_file_r2.ok && is_file_r2.ok)) { bad = 1; }
    val is_file_r3: res[bool, io_error.Error] = fs.is_file(app);
    if (sel is_file_r3.err) { ret 99; }
    if (!(sel is_file_r3.ok && is_file_r3.ok))   { bad = 1; }
    if (bad != 0) { fs.remove_all(?a, root); ret 1; }

    if (t_req_exit_code(?a, app) != 0) { bad = 1; }

    val out_dir: str = t_req_join(?a, root, "out");
    fs.remove_all(?a, out_dir);
    if (!t_req_write(?a, src_dir, "shader.mach", "pub fun tint(x: u64) u64 { ret nonesuch; }\n")) { bad = 1; }
    if (t_build(5, ?argv[0]) == 0) { bad = 1; }
    val is_file_r4: res[bool, io_error.Error] = fs.is_file(app);
    if (sel is_file_r4.err) { ret 99; }
    if ((sel is_file_r4.ok && is_file_r4.ok))           { bad = 1; }

    fs.remove_all(?a, root);
    ret bad;
}

test "mach.cli.cmd.build.run_typed:rejects_o1_before_any_side_effect_o0_and_o2_still_build" {
    val toml_body: str = "[project]\nid = \"rem102fx\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out\"\n\n[profile.test]\nopt = 0\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n\n[artifact.rem102fx]\nkind = \"static\"\nentry = \"lib.mach\"\nout = \"lib/rem102fx.a\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
    val src_body: str = "pub fun value() i64 {\n    ret 42;\n}\n";

    var a: A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }

    val tf_r: res[fs.TempFile, fs.FsError] = fs.temp_create(?a, "mach_build_cmd_o1");
    if (sel tf_r.err) { ret 1; }
    var tf: fs.TempFile = tf_r.ok;
    val root: str = fs.temp_path(?tf);
    fs.temp_close_and_remove(?tf);
    val create_dir_all_r: err[fs.FsError] = fs.create_dir_all(?a, root, 0o755);
    if (sel create_dir_all_r.err) { ret 1; }

    val toml_path_r: res[str, A.Error] = path.join(?a, root, "mach.toml");
    if (sel toml_path_r.err) { ret 1; }
    val toml_path: str = toml_path_r.ok;
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(toml_path, toml_body::*u8, str_len(toml_body), 0o644);
    if (sel write_bytes_r.err) { ret 1; }

    val src_dir_r: res[str, A.Error] = path.join(?a, root, "src");
    if (sel src_dir_r.err) { ret 1; }
    val src_dir: str = src_dir_r.ok;
    val create_dir_all_r2: err[fs.FsError] = fs.create_dir_all(?a, src_dir, 0o755);
    if (sel create_dir_all_r2.err) { ret 1; }
    val src_path_r: res[str, A.Error] = path.join(?a, src_dir, "lib.mach");
    if (sel src_path_r.err) { ret 1; }
    val src_path: str = src_path_r.ok;
    val write_bytes_r2: err[fs.FsError] = fs.write_bytes(src_path, src_body::*u8, str_len(src_body), 0o644);
    if (sel write_bytes_r2.err) { ret 1; }

    val out_dir_r: res[str, A.Error] = path.join(?a, root, "out");
    if (sel out_dir_r.err) { ret 1; }
    val out_dir: str = out_dir_r.ok;

    var bad: i32 = 0;

    var argv_o1: [4]*u8;
    argv_o1[0] = "mach"; argv_o1[1] = "build"; argv_o1[2] = "-O1"; argv_o1[3] = root::*u8;
    if (t_build(4, ?argv_o1[0]) != 1) { bad = 1; }
    val is_dir_r: res[bool, io_error.Error] = fs.is_dir(out_dir);
    if (sel is_dir_r.err) { ret 99; }
    if ((sel is_dir_r.ok && is_dir_r.ok))           { bad = 1; }

    var argv_o0: [4]*u8;
    argv_o0[0] = "mach"; argv_o0[1] = "build"; argv_o0[2] = "-O0"; argv_o0[3] = root::*u8;
    if (t_build(4, ?argv_o0[0]) != 0) { bad = 1; }
    val is_dir_r2: res[bool, io_error.Error] = fs.is_dir(out_dir);
    if (sel is_dir_r2.err) { ret 99; }
    if (!(sel is_dir_r2.ok && is_dir_r2.ok))          { bad = 1; }
    fs.remove_all(?a, out_dir);

    var argv_o2: [4]*u8;
    argv_o2[0] = "mach"; argv_o2[1] = "build"; argv_o2[2] = "-O2"; argv_o2[3] = root::*u8;
    if (t_build(4, ?argv_o2[0]) != 0) { bad = 1; }
    val is_dir_r3: res[bool, io_error.Error] = fs.is_dir(out_dir);
    if (sel is_dir_r3.err) { ret 99; }
    if (!(sel is_dir_r3.ok && is_dir_r3.ok))          { bad = 1; }

    fs.remove_all(?a, root);
    ret bad;
}

fun str_index(s: str, sub: str) usize {
    val at: opt[usize] = str_index_of(s, sub);
    if (sel at.none) { ret str_len(s); }
    ret at.some;
}

fun t_plan_cli(target: str, artifact: str, all_targets: bool) args.CliArgs {
    var cli: args.CliArgs;
    cli.target      = target;
    cli.bin         = artifact::*u8;
    if (str_empty(artifact)) { cli.bin = nil; }
    cli.all_targets = all_targets;
    ret cli;
}

fun t_text_sink_write(ctx: ptr, buf: *u8, len: usize) res[usize, writer.WriteError] {
    val sink: *Vector[u8] = ctx::*Vector[u8];
    var i: usize = 0;
    for (i < len) {
        val pushed: res[usize, A.Error] = vector.push[u8](sink, buf[i]);
        if (sel pushed.err) { ret res[usize, writer.WriteError].err{writer.native_failure(0, io_error.from_code(os.EIO, io_error.OP_WRITE))}; }
        i = i + 1;
    }
    ret res[usize, writer.WriteError].ok{len};
}

fun t_plan_text(a: *A.Allocator, root: str, cli: *args.CliArgs, configure_deps: bool,
                out_text: *str) err[outcome.Fail] {
    var ps: session.Session;
    val planned: res[plan.BuildPlan, outcome.Fail] = plan_invocation(a, root, cli,
        request.GOAL_EXECUTE, configure_deps, ?ps);
    if (sel planned.err) {
        ret err[outcome.Fail].err{planned.err};
    }
    var bp: plan.BuildPlan = planned.ok;

    var sink: Vector[u8] = vector.init[u8](a);
    var w: writer.Writer;
    w.ctx     = (?sink)::ptr;
    w.f_write = t_text_sink_write;
    val rendered: err[outcome.Fail] = plan.render(a, ?w, ?bp, ?ps.interner);
    session.dnit(?ps);
    if (sel rendered.err) { ret rendered; }

    val terminated: res[usize, A.Error] = vector.push[u8](?sink, 0);
    if (sel terminated.err) { ret err[outcome.Fail].err{outcome.refused(terminated.err)}; }
    @out_text = sink.data::str;
    ret err[outcome.Fail].ok{};
}

val T_PLAN_MANIFEST: str = "[project]\nid = \"planfx\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.host]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[target.win]\nisa = \"x86_64\"\nos = \"windows\"\nabi = \"win64\"\n\n[artifact.support]\nkind = \"static\"\nentry = \"support.mach\"\nout = \"lib/libsupport{artifact.suffix}\"\ntargets = [\"*\"]\nlink = []\nneed = []\n\n[artifact.app]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/app{artifact.suffix}\"\ntargets = [\"*\"]\nlink = []\nneed = [\"artifact.support\", \"step.generate\"]\n\n[step.generate]\nargv = [\"sh\", \"-c\", \"printf generated > {project.out}/generated.txt\"]\nin = []\nout = [\"{project.out}/generated.txt\"]\nneed = [\"step.prepare\"]\n\n[step.prepare]\nargv = [\"sh\", \"-c\", \"printf prepared > {project.out}/prepared.txt\"]\nin = []\nout = [\"{project.out}/prepared.txt\"]\nneed = []\n\n[profile.debug]\ndefault = true\nopt = 0\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n";

val T_PLAN_SUPPORT: str = "pub fun tint(x: u64) u64 { ret x + 3; }\n";

val T_PLAN_MAIN: str = "#[symbol(\"_start\")]\nfun start() {\n    asm x86_64 {\n        mov rax, 60\n        mov rdi, 0\n        syscall\n    }\n}\n";

fun t_plan_scaffold(a: *A.Allocator, manifest_text: str, out_root: *str) bool {
    val created: res[fs.TempFile, fs.FsError] = fs.temp_create(a, "mach_plan_case");
    if (sel created.err) { ret false; }
    var temporary: fs.TempFile = created.ok;
    val root: str = fs.temp_path(?temporary);
    fs.temp_close_and_remove(?temporary);
    val create_dir_all_r: err[fs.FsError] = fs.create_dir_all(a, root, 0o755);
    if (sel create_dir_all_r.err) { ret false; }
    @out_root = root;
    if (!t_req_write(a, root, "mach.toml", manifest_text)) { ret false; }
    val src: str = t_req_join(a, root, "src");
    if (!t_req_write(a, src, "support.mach", T_PLAN_SUPPORT)) { ret false; }
    ret t_req_write(a, src, "main.mach", T_PLAN_MAIN);
}

test "mach.cli.cmd.build.plan:displays_the_selection_the_build_produces_and_executes_nothing" {
    $if ($mach.build.os != $mach.os.linux)      { ret 0; }
    $if ($mach.build.arch != $mach.arch.x86_64) { ret 0; }
    var a: A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    var root: str = "";
    if (!t_plan_scaffold(?a, T_PLAN_MANIFEST, ?root)) { ret 2; }
    fin { fs.remove_all(?a, root); }

    var cli: args.CliArgs = t_plan_cli("", "", true);
    var text: str = "";
    val rendered: err[outcome.Fail] = t_plan_text(?a, root, ?cli, true, ?text);
    if (sel rendered.err) { ret 3; }

    # every declared cell, its entry, its derived suffix and its prerequisite order
    if (!str_contains(text, "project: planfx")) { ret 4; }
    if (!str_contains(text, "units:   4"))      { ret 5; }
    if (!str_contains(text, "  entry   main.mach"))    { ret 6; }
    if (!str_contains(text, "  entry   support.mach")) { ret 7; }
    if (!str_contains(text, "/out/host/debug/bin/app\n"))     { ret 8; }
    if (!str_contains(text, "/out/win/debug/bin/app.exe\n"))  { ret 9; }
    if (!str_contains(text, "/out/host/debug/lib/libsupport.a\n"))   { ret 10; }
    if (!str_contains(text, "/out/win/debug/lib/libsupport.lib\n")) { ret 11; }
    if (!str_contains(text, "  need    artifact support"))   { ret 12; }
    if (!str_contains(text, "  step    project prepare"))    { ret 13; }
    if (!str_contains(text, "  step    project generate"))   { ret 14; }
    if (str_index(text, "  step    project prepare") > str_index(text, "  step    project generate")) { ret 15; }
    if (!str_contains(text, "generated bytes are unresolved")) { ret 16; }
    if (!str_contains(text, "it does not claim the link succeeds")) { ret 17; }
    if (str_contains(text, "not configured against the dependency closure")) { ret 18; }

    # nothing ran: no step output, no object, IR or assembly tree, no artifact
    val exists_r: res[bool, io_error.Error] = fs.exists(t_req_join(?a, root, "out"));
    if (sel exists_r.err) { ret 99; }
    if ((sel exists_r.ok && exists_r.ok)) { ret 19; }

    # the build that follows produces exactly the paths the plan named
    var argv: [5]*u8;
    argv[0] = "mach"::*u8; argv[1] = "build"::*u8; argv[2] = root::*u8;
    argv[3] = "--target"::*u8; argv[4] = "host"::*u8;
    if (t_build(5, ?argv[0]) != 0) { ret 20; }
    val is_file_r: res[bool, io_error.Error] = fs.is_file(t_req_join(?a, root, "out/host/debug/bin/app"));
    if (sel is_file_r.err) { ret 99; }
    if (!(sel is_file_r.ok && is_file_r.ok))          { ret 21; }
    val is_file_r2: res[bool, io_error.Error] = fs.is_file(t_req_join(?a, root, "out/host/debug/lib/libsupport.a"));
    if (sel is_file_r2.err) { ret 99; }
    if (!(sel is_file_r2.ok && is_file_r2.ok)) { ret 22; }
    val is_file_r3: res[bool, io_error.Error] = fs.is_file(t_req_join(?a, root, "out/host/debug/generated.txt"));
    if (sel is_file_r3.err) { ret 99; }
    if (!(sel is_file_r3.ok && is_file_r3.ok))    { ret 23; }
    val is_file_r4: res[bool, io_error.Error] = fs.is_file(t_req_join(?a, root, "out/host/debug/prepared.txt"));
    if (sel is_file_r4.err) { ret 99; }
    if (!(sel is_file_r4.ok && is_file_r4.ok))     { ret 24; }
    ret 0;
}

test "mach.cli.cmd.build.plan:an_unconfigured_plan_does_not_claim_an_empty_dependency_closure" {
    var a: A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    var root: str = "";
