val FILE_MODE: i32 = 420;

rec DocStats {
    modules: u32;
    entries: u32;
}

fun wr(w: *io_writer.Writer, s: *u8) {
    io_writer.write_all(w, s, str_len(s));
}

fun wr_n(w: *io_writer.Writer, s: *u8, len: usize) {
    if (len == 0) { ret; }
    io_writer.write_all(w, s, len);
}

fun line_end(s: *u8, pos: usize) usize {
    var i: usize = pos;
    for (s[i] != 0 && s[i] != '\n') { i = i + 1; }
    ret i;
}

fun first_nonspace(s: *u8, pos: usize) usize {
    var i: usize = pos;
    for (s[i] == ' ' || s[i] == '\t') { i = i + 1; }
    ret i;
}

fun starts_with(s: *u8, pos: usize, lit: *u8) bool {
    var i: usize = 0;
    for (lit[i] != 0) {
        if (s[pos + i] != lit[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun next_line(s: *u8, pos: usize) usize {
    val e: usize = line_end(s, pos);
    if (s[e] == 0) { ret e; }
    ret e + 1;
}

fun skip_decorators(s: *u8, pos: usize) usize {
    var i:  usize = pos;
    var go: bool  = true;
    for (go) {
        for (s[i] == ' ' || s[i] == '\t' || s[i] == '\n' || s[i] == '\r') { i = i + 1; }
        if (s[i] == '#' && s[i + 1] == '[') {
            i = i + 2;
            var depth: i64 = 1;
            for (depth > 0 && s[i] != 0) {
                if (s[i] == '[') { depth = depth + 1; }
                or (s[i] == ']') { depth = depth - 1; }
                i = i + 1;
            }
        }
        or {
            go = false;
        }
    }
    ret i;
}

fun write_span_stripped(w: *io_writer.Writer, source: str, span: lang_source.Span) {
    val s:   *u8   = source::*u8;
    val end: usize = span.offset + span.len;

    var i:     usize = span.offset;
    var first: bool  = true;
    for (i < end) {
        if (!first) {
            for (i < end && (s[i] == ' ' || s[i] == '\t')) { i = i + 1; }
            if (i < end && s[i] == '#') { i = i + 1; }
            if (i < end && s[i] == ' ') { i = i + 1; }
        }
        first = false;

        var le: usize = i;
        for (le < end && s[le] != '\n') { le = le + 1; }
        wr_n(w, ?s[i], le - i);
        if (le < end) { wr(w, "\n"); }

        i = le;
        if (i < end && s[i] == '\n') { i = i + 1; }
    }
}

fun write_doc(w: *io_writer.Writer, source: str, doc: lang_source.Span) {
    if (doc.len == 0) { ret; }

    val summary: lang_source.Span = fe_doc.summary_span(source, doc);
    if (summary.len > 0) {
        write_span_stripped(w, source, summary);
        wr(w, "\n");
    }

    var it:    fe_doc.DocComponentIter = fe_doc.component_iter(source, doc);
    var c:     fe_doc.DocComponent;
    var first: bool                    = true;
    for (fe_doc.component_next(?it, ?c)) {
        if (first) {
            wr(w, "\n");
            first = false;
        }
        write_span_stripped(w, source, c.name_span);
        if (c.desc_span.len > 0) {
            wr(w, ": ");
            write_span_stripped(w, source, c.desc_span);
        }
        or {
            wr(w, ":");
        }
        wr(w, "\n");
    }
    wr(w, "\n");
}

fun write_signature(w: *io_writer.Writer, s: *u8, pos: usize, keep_braces: bool) usize {
    wr(w, "```mach\n");
    val base_indent: usize = first_nonspace(s, pos) - pos;
    var line:        usize = pos;
    var depth:       i64   = 0;
    var brace_depth: i64   = 0;
    var done:        bool  = false;
    for (!done && s[line] != 0) {
        val e:     usize = line_end(s, line);
        var begin: usize = first_nonspace(s, line);
        if (keep_braces && line != pos) {
            if (begin < e && begin >= line + base_indent) {
                begin = line + base_indent;
            }
        }

        var i:         usize = begin;
        var cut:       usize = e;
        var saw_brace: bool  = false;
        for (i < e) {
            val c: u8 = s[i];
            if (c == '#') {
                i = e;
                cnt;
            }
            if (c == '(' || c == '[') { depth = depth + 1; }
            or (c == ')' || c == ']') { depth = depth - 1; }
            or (keep_braces && depth == 0 && c == '{') {
                brace_depth = brace_depth + 1;
            }
            or (keep_braces && depth == 0 && c == '}') {
                brace_depth = brace_depth - 1;
                if (brace_depth <= 0) {
                    cut  = i + 1;
                    done = true;
                    i    = e;
                    cnt;
                }
            }
            or (!keep_braces && depth == 0 && c == ';') {
                cut  = i;
                done = true;
                i    = e;
                cnt;
            }
            or (!keep_braces && depth == 0 && c == '{') {
                cut       = i;
                saw_brace = true;
                done      = true;
                i         = e;
                cnt;
            }
            i = i + 1;
        }

        var trimmed: usize = cut;
        for (trimmed > begin && (s[trimmed - 1] == ' ' || s[trimmed - 1] == '\t')) {
            trimmed = trimmed - 1;
        }
        wr_n(w, ?s[begin], trimmed - begin);
        if (saw_brace) { wr(w, ";"); }
        wr(w, "\n");
        line = next_line(s, line);
    }
    wr(w, "```\n\n");
    ret line;
}

fun write_heading(w: *io_writer.Writer, s: *u8, pos: usize) {
    var begin: usize = first_nonspace(s, pos);
    if (starts_with(s, begin, "pub ")) { begin = begin + 4; }
    begin = first_nonspace(s, begin);

    val e:    usize = line_end(s, begin);
    var stop: usize = begin;
    var i:    usize = begin;
    for (i < e) {
        val c: u8 = s[i];
        if (c == '(' || c == '[' || c == ':' || c == '=' || c == '{' || c == ';') {
            i = e;
            cnt;
        }
        if (c != ' ' && c != '\t') { stop = i + 1; }
        i = i + 1;
    }
    wr_n(w, ?s[begin], stop - begin);
}

fun document_decl(w: *io_writer.Writer, source: str, d: *ast_decl.Decl) {
    val s:   *u8   = source::*u8;
    val sig: usize = skip_decorators(s, d.span.offset);

    wr(w, "## ");
    write_heading(w, s, sig);
    wr(w, "\n\n");

    write_signature(w, s, sig, d.kind == ast_decl.DECL_KIND_TAG);
    write_doc(w, source, d.doc);
}

# a `fwd` has no signature of its own: its page entry names the declaration it
# forwards and links the page that documents it
fun document_fwd(w: *io_writer.Writer, page: *PageCtx, did: ast_id.DeclId, d: *ast_decl.Decl) {
    val s:   *u8   = page.source::*u8;
    val sig: usize = skip_decorators(s, d.span.offset);

    wr(w, "## ");
    write_heading(w, s, sig);
    wr(w, "\n\n");

    write_signature(w, s, sig, false);
    write_forwarded(w, page, did);
    write_doc(w, page.source, d.doc);
}

fun write_forwarded(w: *io_writer.Writer, page: *PageCtx, did: ast_id.DeclId) {
    val rr: *resolve.ResolveResult = page.resolved;
    if (rr == nil || page.p == nil || did::u32 >= rr.decl_count) { ret; }
    val sid: resolve.SymbolId = rr.decl_symbol[ast_id.decl_index(did)];
    if (resolve.symbol_is_nil(sid)) { ret; }
    val sym:    *resolve.Symbol = ?rr.symbols[resolve.symbol_index(sid)];
    val whole:  bool            = sym.kind == resolve.SYM_USE;
    var target: u32             = sym.origin::u32;
    if (whole)                                 { target = sym.slot; }
    if (target >= driver.module_count(page.p)) { ret; }
    val tm:    *driver.ModuleEntry = driver.module_at(page.p, target);
    val tfqn:  opt[str]            = intern.get(?page.p.s.interner, tm.fqn);
    val canon: opt[str]            = intern.get(?page.p.s.interner, sym.canon);
    if (sel tfqn.none) { ret; }
    var name: str = "";
    if (!whole) {
        if (sel canon.none) { ret; }
        name = leaf_of(canon.some);
    }

    val linked: bool = driver.module_in_current_project(page.p, tm.fqn);
    wr(w, "forwards ");
    if (linked) { wr(w, "["); }
    wr(w, "`");
    wr(w, tfqn.some);
    if (!whole) {
        wr(w, ".");
        wr(w, name);
    }
    wr(w, "`");
    if (linked) {
        wr(w, "](");
        write_page_link(w, page.fqn::str, tfqn.some);
        val keyword: str = heading_keyword(sym.kind);
        if (!whole && keyword != nil) {
            wr(w, "#");
            wr(w, keyword);
            wr(w, "-");
            write_anchor(w, name);
        }
        wr(w, ")");
    }
    wr(w, "\n\n");
}

# the page of module `to` relative to the page of module `from`: the pages sit
# at their dotted paths, so the directories both share are stepped over
fun write_page_link(w: *io_writer.Writer, from: str, to: str) {
    var shared: usize = 0;
    var i:      usize = 0;
    for (from[i] != 0 && from[i] == to[i]) {
        if (from[i] == '.') { shared = i + 1; }
        i = i + 1;
    }
    var j: usize = shared;
    for (from[j] != 0) {
        if (from[j] == '.') { wr(w, "../"); }
        j = j + 1;
    }
    var k: usize = shared;
    for (to[k] != 0) {
        if (to[k] == '.') { wr(w, "/"); }
        or                { wr_n(w, ?to[k], 1); }
        k = k + 1;
    }
    wr(w, ".md");
}

# the last segment of a dotted path
fun leaf_of(dotted: str) str {
    var start: usize = 0;
    var i:     usize = 0;
    for (dotted[i] != 0) {
        if (dotted[i] == '.') { start = i + 1; }
        i = i + 1;
    }
    ret (?dotted[start])::str;
}

# the keyword a declaration's page heading opens with, nil for a kind no page heads
fun heading_keyword(k: resolve.SymKind) str {
    if (k == resolve.SYM_FUN) { ret "fun"; }
    if (k == resolve.SYM_REC) { ret "rec"; }
    if (k == resolve.SYM_UNI) { ret "uni"; }
    if (k == resolve.SYM_TAG) { ret "tag"; }
    if (k == resolve.SYM_DEF) { ret "def"; }
    if (k == resolve.SYM_VAL) { ret "val"; }
    if (k == resolve.SYM_VAR) { ret "var"; }
    ret nil;
}

# a heading's anchor as markdown renderers derive it: lowercase, `_` and `-` kept
fun write_anchor(w: *io_writer.Writer, name: str) {
    var i: usize = 0;
    for (name[i] != 0) {
        var c: u8 = name[i];
        if (c >= 'A' && c <= 'Z') { c = c + 32; }
        wr_n(w, ?c, 1);
        i = i + 1;
    }
}

fun document_decls(w: *io_writer.Writer, page: *PageCtx, start: u32, len: u32) i64 {
    val a:          *ast.Ast = page.a;
    val source:     str      = page.source;
    var documented: i64      = 0;
    var i:          u32      = 0;
    for (i < len) {
        val did:   ast_id.DeclId       = a.decl_ids[start + i];
        val opt_d: opt[*ast_decl.Decl] = ast.get_decl(a, did);
        if (sel opt_d.some) {
            val d: *ast_decl.Decl = opt_d.some;
            if (d.kind == ast_decl.DECL_KIND_COMPTIME_IF) {
                val ci: *ast_decl.DeclComptimeIf = ?d.data.comptime_if;
                var ii: u32                      = 0;
                for (ii < ci.branches_len) {
                    val br: *ast_decl.ComptimeBranch = ?a.comptime_branches[ci.branches_start + ii];
                    documented = documented + document_decls(w, page, br.body_start, br.body_len);
                    ii         = ii + 1;
                }
            }
            or (d.kind == ast_decl.DECL_KIND_FWD && !resolve.declaration_testing(a, did)) {
                document_fwd(w, page, did, d);
                documented = documented + 1;
            }
            or ((d.flags & ast_decl.DECL_FLAG_PUB) != 0 && !resolve.declaration_testing(a, did)) {
                document_decl(w, source, d);
                documented = documented + 1;
            }
        }
        i = i + 1;
    }
    ret documented;
}

# a writer that remembers a failure
#
# the page helpers write through `wr`, which cannot report anything: a write is
# one statement among many, deep inside the declaration walk, and threading a
# result out of every one of them would say the same thing eight times. so the
# failure is latched here instead, at the one seam every write already passes
# through, and the callback asks once at the end.
rec CheckedSink {
    inner:  *io_writer.Writer;
    failed: bool;
}

fun checked_write(ctx: ptr, buf: *u8, len: usize) res[usize, io_writer.WriteError] {
    val s: *CheckedSink                     = ctx::*CheckedSink;
    val r: res[usize, io_writer.WriteError] = s.inner.f_write(s.inner.ctx, buf, len);
    if (sel r.err) { s.failed = true; }
    ret r;
}

fun checked_writer(s: *CheckedSink, inner: *io_writer.Writer) io_writer.Writer {
    s.inner  = inner;
    s.failed = false;
    var w: io_writer.Writer;
    w.ctx     = s::ptr;
    w.f_write = checked_write;
    ret w;
}

# p and resolved name what a `fwd` forwards; a page without them lists the
# `fwd` unlinked
rec PageCtx {
    a:          *ast.Ast;
    source:     str;
    fqn:        *u8;
    p:          *driver.Project;
    resolved:   *resolve.ResolveResult;
    documented: i64;
}

# the module docstring whole: its summary and every paragraph after it
fun write_module_doc(w: *io_writer.Writer, source: str, doc: lang_source.Span) {
    var body: lang_source.Span = doc;
    var skip: usize            = 0;
    if (skip < body.len && source[body.offset + skip] == '#') { skip = skip + 1; }
    if (skip < body.len && source[body.offset + skip] == ' ') { skip = skip + 1; }
    body.offset = body.offset + skip;
    body.len    = body.len - skip;
    write_span_stripped(w, source, body);
    wr(w, "\n\n");
}

fun write_page(ctx: *PageCtx, dst: *io_writer.Writer) err[io_writer.WriteError] {
    var sink: CheckedSink;
    var cw:   io_writer.Writer  = checked_writer(?sink, dst);
    val w:    *io_writer.Writer = ?cw;

    wr(w, "# ");
    wr(w, ctx.fqn);
    wr(w, "\n\n");

    val opt_module: opt[*ast_module.Module] = ast.get_module(ctx.a, ctx.a.root_module);
    if (sel opt_module.some) {
        val m: *ast_module.Module = opt_module.some;
        if (m.doc.len > 0) {
            write_module_doc(w, ctx.source, m.doc);
        }
        ctx.documented = document_decls(w, ctx, m.decls_start, m.decls_len);
    }

    if (sink.failed) { ret err[io_writer.WriteError].err{io_writer.WriteError.stalled{0}}; }
    ret err[io_writer.WriteError].ok{};
}

# a generated page is a build product: written in place, regenerated by the
# next `mach doc`
fun publish_page[C](alloc: *A.Allocator, out_path: str, ctx: *C,
    write_cb: fun(*C, *io_writer.Writer) err[io_writer.WriteError]) err[fail.Fail] {
    ret output.writer[C](nil, alloc, out_path, ctx, write_cb, FILE_MODE, "write");
}

# the number of documented entities on the page written for one module
fun document_module(alloc: *A.Allocator, out_path: *u8, fqn: *u8, p: *driver.Project, m: *driver.ModuleEntry, source: str) res[i64, fail.Fail] {
    val ensure_parents_r: err[fail.Fail] = util.ensure_parents(alloc, out_path::str);
    if (sel ensure_parents_r.err) { ret res[i64, fail.Fail].err{ensure_parents_r.err}; }

    var ctx: PageCtx;
    ctx.a          = m.a;
    ctx.source     = source;
    ctx.fqn        = fqn;
    ctx.p          = p;
    ctx.resolved   = m.resolve_result;
    ctx.documented = 0;

    val published: err[fail.Fail] = publish_page[PageCtx](alloc, out_path::str, ?ctx, write_page);
    if (sel published.err) { ret res[i64, fail.Fail].err{published.err}; }
    ret res[i64, fail.Fail].ok{ctx.documented};
}

rec IndexCtx {
    alloc:   *A.Allocator;
    p:       *driver.Project;
    doc_dir: str;
    stats:   *DocStats;
    failed:  bool;
    failure: fail.Fail;
}

fun write_index(ctx: *IndexCtx, dst: *io_writer.Writer) err[io_writer.WriteError] {
    val alloc:   *A.Allocator    = ctx.alloc;
    val p:       *driver.Project = ctx.p;
    val doc_dir: str             = ctx.doc_dir;
    val stats:   *DocStats       = ctx.stats;

    var sink: CheckedSink;
    var cw:   io_writer.Writer  = checked_writer(?sink, dst);
    val iw:   *io_writer.Writer = ?cw;

    wr(iw, "# API reference\n\n");
    wr(iw, "generated by `mach doc` from source doc-comments.\n\n");

    var i: u32 = 0;
    for (i < driver.module_count(p)) {
        val m: *driver.ModuleEntry = driver.module_at(p, i);

        # a dependency's reference is that dependency's to generate: only the
        # root project's own modules get a page and an index row
        if (!driver.module_in_current_project(p, m.fqn)) {
            i = i + 1;
            cnt;
        }
        val opt_fqn: opt[str] = intern.get(?p.s.interner, m.fqn);
        if (sel opt_fqn.none) {
            i = i + 1;
            cnt;
        }
        val fqn: *u8 = opt_fqn.some::*u8;

        val opt_source: opt[*lang_source.SourceFile] = lang_source.get(?p.s.sources, m.file_id);
        if (sel opt_source.none) {
            i = i + 1;
            cnt;
        }
        val source: str = opt_source.some.text;

        val rel_r: res[str, types_string.StrError] = str_replace(alloc, fqn::str, ".", "/");
        if (sel rel_r.err) {
            i = i + 1;
            cnt;
        }
        val rel:    str               = rel_r.ok;
        val base_r: res[str, A.Error] = types_path.join(alloc, doc_dir, rel);
        if (sel base_r.err) {
            i = i + 1;
            cnt;
        }
        val page_r: res[str, types_string.StrError] = str_join(alloc, base_r.ok, ".md");
        if (sel page_r.err) {
            i = i + 1;
            cnt;
        }
        val page_path: str = page_r.ok;

        val documented_r: res[i64, fail.Fail] = document_module(alloc, page_path, fqn, p, m, source);
        if (sel documented_r.err) {
            ctx.failed  = true;
            ctx.failure = documented_r.err;
            val said: res[str, std_format.FormatError] = std_format.sprint(alloc, "failed to write page for {}: {}", fqn::str, fail.describe(documented_r.err));
            if (sel said.ok) { ctx.failure = fail.with_text(documented_r.err, said.ok); }
            ret err[io_writer.WriteError].err{io_writer.WriteError.stalled{0}};
        }
        val documented: i64 = documented_r.ok;

        wr(iw, "- [");
        wr(iw, fqn);
        wr(iw, "](");
        wr(iw, rel);
        wr(iw, ".md)\n");

        stats.modules = stats.modules + 1;
        stats.entries = stats.entries + documented::u32;
        i             = i + 1;
    }

    if (sink.failed) { ret err[io_writer.WriteError].err{io_writer.WriteError.stalled{0}}; }
    ret err[io_writer.WriteError].ok{};
}

# write every page of the project's own modules under doc_dir, then the index naming them
# ---
# alloc:   owns the paths and the failure's text
# p:       the built project
# doc_dir: the output directory, created when missing
# stats:   counts what was documented
# ret:     ok, or the first failure: a directory that cannot be created, a page or the index
#          that cannot be written
fun generate(alloc: *A.Allocator, p: *driver.Project, doc_dir: str, stats: *DocStats) err[fail.Fail] {
    val create_dir_all_r: err[fs.FsError] = fs.create_dir_all(alloc, doc_dir, 0o755);
    if (sel create_dir_all_r.err) {
        val said: res[str, std_format.FormatError] = std_format.sprint(alloc, "could not create output directory: {}", fail.fs_text(create_dir_all_r.err));
        if (sel said.err) { ret err[fail.Fail].err{fail.message("out of memory")}; }
        ret err[fail.Fail].err{fail.environment(diagnostic_kind.FS_CREATE, said.ok)};
    }

    val idx_r: res[str, A.Error] = types_path.join(alloc, doc_dir, "README.md");
    if (sel idx_r.err) { ret err[fail.Fail].err{fail.refused(idx_r.err)}; }
    val index_path: str = idx_r.ok;

    var ctx: IndexCtx;
    ctx.alloc   = alloc;
    ctx.p       = p;
    ctx.doc_dir = doc_dir;
    ctx.stats   = stats;
    ctx.failed  = false;

    # the index names the pages, so it is published after them and only when
    # every one of them landed: a reader never follows a link to a missing page
    val published: err[fail.Fail] = publish_page[IndexCtx](alloc, index_path, ?ctx, write_index);
    if (sel published.err) {
        if (ctx.failed) { ret err[fail.Fail].err{ctx.failure}; }
        val said: res[str, std_format.FormatError] = std_format.sprint(alloc, "could not publish the documentation index: {}", fail.describe(published.err));
        if (sel said.err) { ret published; }
        ret err[fail.Fail].err{fail.with_text(published.err, said.ok)};
    }
    ret err[fail.Fail].ok{};
}

# what `-o` names for doc
val OUTPUT_DOCS: [args.SEL_N]str = [args.SEL_N]str{"", "", "", "", "", "", "", "set the output directory, inside the project root"};

# SEL rows doc accepts: `--artifact`, `-a`, `--target`, `-t`, since doc renders one artifact, and
# `-o`, the output directory
val SEL_ACCEPTED: [args.SEL_N]bool = [args.SEL_N]bool{true, true, true, true, false, false, false, true};

# length of TABLES
val TABLES_N: usize = 2;
# the option tables mach doc accepts: SEL masked by SEL_ACCEPTED, and `--quiet`
val TABLES: [TABLES_N]args.TableRef = [TABLES_N]args.TableRef{
    args.TableRef{rows: ?args.SEL[0], n: args.SEL_N, accepted: ?SEL_ACCEPTED[0], docs: ?OUTPUT_DOCS[0]},
    args.TableRef{rows: ?args.QUIETNESS[0], n: args.QUIETNESS_N, accepted: nil, docs: nil},
};

# length of CONSTRAINTS
val CONSTRAINTS_N: usize = 3;
# the constraint sentences help prints for doc; the last two are enforced by the doc command
val CONSTRAINTS: [CONSTRAINTS_N]str = [CONSTRAINTS_N]str{
    args.SELECTOR_CONSTRAINT,
    "the selection must resolve to exactly one (artifact, target)",
    args.OUTPUT_CONSTRAINT,
};

# `mach doc`
pub val COMMAND: args.CommandSpec = args.CommandSpec{name: "doc", aliases: nil, alias_n: 0, grammar: " <path> [options]", summary: "generate reference documentation", effect: "write one Markdown page per module and an index under the selected output directory", exits: nil, exit_n: 0, terminator: "", tables: ?TABLES[0], table_n: TABLES_N, refused: nil, refused_n: 0, refusal: "", relations: nil, relation_n: 0, constraints: ?CONSTRAINTS[0], constraint_n: CONSTRAINTS_N, operand_min: 0, operand_max: args.OPERANDS_ANY, truncate_at_sep: false, actions: nil, action_n: 0, examples: nil, example_n: 0, run: run};

# `mach doc`: build the project's module graph and write one Markdown page per module plus
# an index. pages go to `<root>/doc/<module path>.md`, or under `-o <dir>` inside the project
# root, with a README.md index. a page opens with the module docstring, and every `pub`
# declaration and `fwd` is rendered, documented or not, a `fwd` with what it forwards. a summary
# line prints unless `--quiet`
# ---
# cx:  the call
# ret: exit.OK, or the failure: a user one for a project, manifest or output path error, an
#      internal one for an allocator, session or registry failure, an environment one for a write
pub fun run(cx: *args.Call) res[i64, fail.Fail] {
    val inv:   *args.ParsedInvocation = cx.inv;
    val argv:  **u8                   = cx.argv;
    val alloc: *A.Allocator           = cx.a;

    var leaf:      str      = "doc";
    val out_given: opt[*u8] = args.value(inv, argv, ?args.OUTPUT);
    if (sel out_given.some)              { leaf = out_given.some::str; }
    if (!manifest.is_project_path(leaf)) { ret res[i64, fail.Fail].err{fail.user(diagnostic_kind.OUTPUT_PATH_INVALID, args.OUTPUT_CONSTRAINT)}; }

    val config_r: res[request.CliArgs, fail.Fail] = args.build_cli_invocation(alloc, inv, argv);
    if (sel config_r.err) { ret res[i64, fail.Fail].err{config_r.err}; }
    var config: request.CliArgs = config_r.ok;

    var arg: *u8 = nil;
    if (inv.has_positional) { arg = argv[inv.positional_idx]; }

    val loc_r: res[util.ProjectLocation, fail.Fail] = util.resolve_project_location(alloc, arg);
    if (sel loc_r.err) { ret res[i64, fail.Fail].err{loc_r.err}; }
    val root: str = loc_r.ok.root;

    val res_session: res[session.Session, fail.Fail] = toolchain.session_init(alloc);
    if (sel res_session.err) { ret res[i64, fail.Fail].err{fail.message("failed to initialise compiler session")}; }
    var s: session.Session = res_session.ok;
    fin { session.dnit(?s); }

    val res_project: res[driver.Project, fail.Fail] = driver.build_project(?s, root, ?config.selectors);
    if (diagnostic.len(?s.diags) > 0) {
        var err_w: io_writer.Writer = fs.writer(fs.STDERR);
        cli_diagnostic.flush(?err_w, ?s, ?s.diags);
    }
    if (sel res_project.err) { ret res[i64, fail.Fail].err{args.selection_hint(alloc, ?config.selectors, res_project.err)}; }
    var p: driver.Project = res_project.ok;
    fin { driver.dnit_project(?p); }

    val doc_r: res[str, A.Error] = types_path.join(alloc, root, leaf);
    if (sel doc_r.err) { ret res[i64, fail.Fail].err{fail.refused(doc_r.err)}; }
    val doc_dir: str = doc_r.ok;

    var stats: DocStats;
    stats.modules = 0;
    stats.entries = 0;
    val generated: err[fail.Fail] = generate(alloc, ?p, doc_dir, ?stats);
    if (sel generated.err) { ret res[i64, fail.Fail].err{generated.err}; }

    if (!args.given(inv, ?args.QUIET)) {
        print.print("documented ");
        print.u64(stats.entries::u64);
        print.print(" public entities across ");
        print.u64(stats.modules::u64);
        print.print(" modules -> ");
        print.print(doc_dir);
        print.print("\n");
    }
    ret res[i64, fail.Fail].ok{exit.OK};
}

#[testing]
fun t_doc_span(s: str) lang_source.Span {
    var sp: lang_source.Span;
    sp.offset = 0;
    sp.len    = types_string.str_len(s);
    ret sp;
}

#[testing]
fun t_render_eq(source: str, doc: lang_source.Span, expect: str) bool {
    var sk: fixture.MemSink;
    var w:  io_writer.Writer;
    fixture.mem_writer(?w, ?sk);
    fin { fixture.mem_sink_dnit(?sk); }
    write_doc(?w, source, doc);
    ret str_equals(fixture.sink_text(?sk), expect);
}

#[testing]
fun t_sig_eq(source: str, expect: str, is_tag: bool) bool {
    var sk: fixture.MemSink;
    var w:  io_writer.Writer;
    fixture.mem_writer(?w, ?sk);
    fin { fixture.mem_sink_dnit(?sk); }
    write_signature(?w, source::*u8, 0, is_tag);
    ret str_equals(fixture.sink_text(?sk), expect);
}

#[testing]
fun t_at(source: str, off: usize, lit: str) bool {
    ret types_string.str_region_equals(source, off, types_string.str_len(lit), lit);
}

test write_doc__renders_the_summary_components_and_their_wrapping {
    val full: str = "# sum two integers\n# ---\n# a: first addend\n# b: second addend\n# ret: the sum";
    if (!t_render_eq(full, t_doc_span(full),
        "sum two integers\n\na: first addend\nb: second addend\nret: the sum\n\n")) { ret 1; }
    val summary: str = "# yield the CPU to other threads";
    if (!t_render_eq(summary, t_doc_span(summary), "yield the CPU to other threads\n\n")) { ret 2; }
    var empty: lang_source.Span;
    empty.offset = 0;
    empty.len    = 0;
    if (!t_render_eq("", empty, "")) { ret 3; }
    val wrapped: str = "# wrapped\n# ---\n# a: long line\n#    wraps here\n# b: short";
    if (!t_render_eq(wrapped, t_doc_span(wrapped),
        "wrapped\n\na: long line\n   wraps here\nb: short\n\n")) { ret 4; }
    ret 0;
}

test skip_decorators__steps_over_own_line_inline_and_repeated_decorators {
    val own: str = "#[symbol(\"_start\")]\npub fun entry() i64 { ret 0; }";
    if (!t_at(own, skip_decorators(own::*u8, 0), "pub fun")) { ret 1; }

    val inl: str = "#[inline] pub fun g() {}";
    if (!t_at(inl, skip_decorators(inl::*u8, 0), "pub fun")) { ret 1; }

    val many: str = "#[a] #[b(1)]\nrec R { x: u8; }";
    if (!t_at(many, skip_decorators(many::*u8, 0), "rec R")) { ret 1; }

    val none: str = "pub val X: i64 = 0;";
    if (skip_decorators(none::*u8, 0) != 0) { ret 1; }
    ret 0;
}

test write_signature__keeps_a_tag_body_and_cuts_a_fun_at_its_brace {
    val tag: str = "pub tag Option[T]: u8 {\n    none;\n    some: T;\n}";
    if (!t_sig_eq(tag, "```mach\npub tag Option[T]: u8 {\n    none;\n    some: T;\n}\n```\n\n", true)) { ret 1; }
    val line: str = "pub tag Pair[A, B]: u8 { empty; first: A; second: B; }";
    if (!t_sig_eq(line, "```mach\npub tag Pair[A, B]: u8 { empty; first: A; second: B; }\n```\n\n", true)) { ret 2; }
    if (!t_sig_eq("pub fun answer() i32 { ret 42; }", "```mach\npub fun answer() i32;\n```\n\n", false))   { ret 3; }
    ret 0;
}

#[testing]
fun t_scratch_project(alloc: *A.Allocator, root_buf: *u8) bool {
    val tf_r: res[fs.TempFile, fs.FsError] = fs.temp_create(alloc, "mach_doc_test");
    if (sel tf_r.err) { ret false; }
    var tf:   fs.TempFile = tf_r.ok;
    val tp:   *u8         = fs.temp_path(?tf)::*u8;
    val tlen: usize       = str_len(tp);
    val fits: bool        = tlen + 1 <= 4096;
    if (fits) {
        var j: usize = 0;
        for (j < tlen) {
            root_buf[j] = tp[j];
            j           = j + 1;
        }
        root_buf[tlen] = 0;
    }
    fs.temp_close_and_remove(?tf);
    if (!fits) { ret false; }
    ret t_project_files(alloc, root_buf::str);
}

# the scratch project's manifest and entry under `root`, which may be a
# relative spelling
#[testing]
fun t_project_files(alloc: *A.Allocator, root: str) bool {
    val src_dir:          str             = fixture.join(alloc, root, "src");
    val create_dir_all_r: err[fs.FsError] = fs.create_dir_all(alloc, root, 493);
    if (sel create_dir_all_r.err) { ret false; }
    val create_dir_all_r2: err[fs.FsError] = fs.create_dir_all(alloc, src_dir, 493);
    if (sel create_dir_all_r2.err) { ret false; }

    val manifest_text: str             = on_host("[project]\nmach = \">=5\"\nid = \"doctest\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.linux]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[profile.debug]\nopt = 0\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n\n[artifact.doctest]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"{project.out}/bin/doctest\"\ntargets = [\"*\"]\nlink = []\nneed = []\n");
    val main_text:     str             = "fun main() i32 { ret 0; }\n";
    val mf:            str             = fixture.join(alloc, root, util.PROJECT_CONFIG_NAME);
    val mn:            str             = fixture.join(alloc, src_dir, "main.mach");
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(mf, manifest_text::*u8, str_len(manifest_text::*u8), 420);
    if (sel write_bytes_r.err) { ret false; }
    val write_bytes_r2: err[fs.FsError] = fs.write_bytes(mn, main_text::*u8, str_len(main_text::*u8), 420);
    if (sel write_bytes_r2.err) { ret false; }
    ret true;
}

#[testing]
fun t_doc_run(argc: usize, argv: **u8) i64 {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 2; }
    ret args.invoke(?a, ?COMMAND, argc, argv);
}

#[testing]
fun t_scratch_two_artifacts(alloc: *A.Allocator, root_buf: *u8) bool {
    if (!t_scratch_project(alloc, root_buf)) { ret false; }
    val root:          str             = root_buf::str;
    val manifest_text: str             = "[project]\nmach = \">=5\"\nid = \"doctest\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.linux]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[target.windows]\nisa = \"x86_64\"\nos = \"windows\"\nabi = \"win64\"\n\n[profile.debug]\nopt = 0\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n\n[artifact.a]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"{project.out}/bin/a\"\ntargets = [\"linux\"]\nlink = []\nneed = []\n\n[artifact.b]\nkind = \"bin\"\nentry = \"win.mach\"\nout = \"{project.out}/bin/b.exe\"\ntargets = [\"windows\"]\nlink = []\nneed = []\n";
    val win_text:      str             = "fun main() i32 { ret 1; }\n";
    val mf:            str             = fixture.join(alloc, root, util.PROJECT_CONFIG_NAME);
    val wn:            str             = fixture.join(alloc, fixture.join(alloc, root, "src"), "win.mach");
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(mf, manifest_text::*u8, str_len(manifest_text::*u8), 420);
    if (sel write_bytes_r.err) { ret false; }
    val write_bytes_r2: err[fs.FsError] = fs.write_bytes(wn, win_text::*u8, str_len(win_text::*u8), 420);
    if (sel write_bytes_r2.err) { ret false; }
    ret true;
}

test run__selects_the_artifact_for_the_target_like_build_and_renders_exactly_one {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var root: [4096]u8;
    if (!t_scratch_two_artifacts(?alloc, ?root[0])) {
        fs.remove_all(?alloc, ?root[0]);
        ret 1;
    }
    var bad: i32 = 0;

    var av: [9]*u8;
    av[0] = "mach"::*u8;
    av[1] = "doc"::*u8;
    av[2] = ?root[0];
    av[3] = "--quiet"::*u8;

    av[4] = "--target"::*u8;
    av[5] = "linux"::*u8;
    if (t_doc_run(6, ?av[0]) != 0) { bad = 1; }
    av[5] = "windows"::*u8;
    if (t_doc_run(6, ?av[0]) != 0) { bad = 2; }

    av[4] = "-a"::*u8;
    av[5] = "b"::*u8;
    av[6] = "-t"::*u8;
    av[7] = "windows"::*u8;
    if (t_doc_run(8, ?av[0]) != 0) { bad = 3; }
    av[5] = "a"::*u8;
    if (t_doc_run(8, ?av[0]) != 1) { bad = 4; }
    av[5] = "nonesuch"::*u8;
    if (t_doc_run(8, ?av[0]) != 1) { bad = 5; }

    # a glob over both artifacts on every target names two, and doc renders one
    av[4] = "-a"::*u8;
    av[5] = "*"::*u8;
    av[6] = "-t"::*u8;
    av[7] = "*"::*u8;
    if (t_doc_run(8, ?av[0]) != 1) { bad = 6; }

    fs.remove_all(?alloc, ?root[0]);
    ret bad;
}

# `mach doc` over several artifacts with
# none marked default is refused, never served by table order
test build_project__several_artifacts_without_a_default_are_refused {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var root: [4096]u8;
    if (!t_scratch_project(?alloc, ?root[0])) {
        fs.remove_all(?alloc, ?root[0]);
        ret 1;
    }
    val manifest_text: str             = on_host("[project]\nmach = \">=5\"\nid = \"doctest\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.linux]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[profile.debug]\nopt = 0\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n\n[artifact.first]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"{project.out}/bin/first\"\ntargets = [\"*\"]\nlink = []\nneed = []\n\n[artifact.second]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"{project.out}/bin/second\"\ntargets = [\"*\"]\nlink = []\nneed = []\n");
    val mf:            str             = fixture.join(?alloc, ?root[0], util.PROJECT_CONFIG_NAME);
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(mf, manifest_text::*u8, str_len(manifest_text::*u8), 420);
    if (sel write_bytes_r.err) {
        fs.remove_all(?alloc, ?root[0]);
        ret 1;
    }

    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) {
        fs.remove_all(?alloc, ?root[0]);
        ret 1;
    }
    var s:    session.Session                = sr.ok;
    var pick: manifest.Selectors             = manifest.t_selectors("", "linux", "");
    val pr:   res[driver.Project, fail.Fail] = driver.build_project(?s, ?root[0], ?pick);
    var bad:  i32                            = 0;
    if (sel pr.ok) {
        var p: driver.Project = pr.ok;
        driver.dnit_project(?p);
        bad = 1;
    }
    if (sel pr.err) {
        if (!str_contains(fail.describe(pr.err), "several artifacts support the selected target and none is marked `default = true`")) { bad = 2; }
    }
    session.dnit(?s);
    fs.remove_all(?alloc, ?root[0]);
    ret bad;
}

# a scratch project whose entry imports a module of a path dependency
# realized at dep/local
#[testing]
fun t_scratch_project_with_dep(alloc: *A.Allocator, root_buf: *u8) bool {
    if (!t_scratch_project(alloc, root_buf)) { ret false; }
    val root:    str             = root_buf::str;
    val dep_dir: str             = fixture.join(alloc, root, "dep/local");
    val made:    err[fs.FsError] = fs.create_dir_all(alloc, fixture.join(alloc, dep_dir, "src"), 493);
    if (sel made.err) { ret false; }
    val dep_manifest:   str             = "[project]\nmach=\">=5\"\nid = \"local\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out\"\n\n[profile.debug]\ndefault = true\nopt = 0\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n";
    val dep_lib:        str             = "# a documented dependency function\npub fun hello() i32 { ret 1; }\n";
    val wrote_manifest: err[fs.FsError] = fs.write_bytes(fixture.join(alloc, dep_dir, util.PROJECT_CONFIG_NAME), dep_manifest::*u8, str_len(dep_manifest), 420);
    val wrote_lib:      err[fs.FsError] = fs.write_bytes(fixture.join(alloc, dep_dir, "src/lib.mach"), dep_lib::*u8, str_len(dep_lib), 420);
    if (sel wrote_manifest.err || sel wrote_lib.err) { ret false; }
    # the path is escaped as the manifest writer escapes it, so a host
    # spelling with backslashes reparses as written
    val escaped: res[str, A.Error] = toml.escape(alloc, dep_dir);
    if (sel escaped.err) { ret false; }
    val table_r: res[str, types_string.StrError] = str_join(alloc, "\n[dep.local]\npath = \"", escaped.ok);
    if (sel table_r.err) { ret false; }
    val table: res[str, types_string.StrError] = str_join(alloc, table_r.ok, "\"\n");
    if (sel table.err) { ret false; }
    val mf:       str                  = fixture.join(alloc, root, util.PROJECT_CONFIG_NAME);
    val manifest: res[str, fs.FsError] = fs.read_string(alloc, mf);
    if (sel manifest.err) { ret false; }
    val extended: res[str, types_string.StrError] = str_join(alloc, manifest.ok, table.ok);
    if (sel extended.err) { ret false; }
    val rewrote: err[fs.FsError] = fs.write_bytes(mf, extended.ok::*u8, str_len(extended.ok), 420);
    if (sel rewrote.err) { ret false; }
    val main_text:    str             = "use local.lib;\n\n# the documented entry\npub fun main() i32 { ret lib.hello() - 1; }\n";
    val rewrote_main: err[fs.FsError] = fs.write_bytes(fixture.join(alloc, root, "src/main.mach"), main_text::*u8, str_len(main_text), 420);
    ret sel rewrote_main.ok;
}

test run__documents_only_the_root_projects_modules {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var root: [4096]u8;
    if (!t_scratch_project_with_dep(?alloc, ?root[0])) {
        fs.remove_all(?alloc, ?root[0]);
        ret 1;
    }
    fin { fs.remove_all(?alloc, ?root[0]); }
    var av: [4]*u8;
    av[0] = "mach"::*u8;
    av[1] = "doc"::*u8;
    av[2] = ?root[0];
    av[3] = "--quiet"::*u8;
    if (t_doc_run(4, ?av[0]) != 0) { ret 2; }
    val pages: str = fixture.join(?alloc, (?root[0])::str, "doc");
    # the root's page is present and the dependency's is absent
    val own_r: res[bool, io_error.Error] = fs.is_file(fixture.join(?alloc, pages, "doctest/main.md"));
    if (!(sel own_r.ok && own_r.ok)) { ret 3; }
    val dep_page_r: res[bool, io_error.Error] = fs.exists(fixture.join(?alloc, pages, "local/lib.md"));
    val dep_dir_r:  res[bool, io_error.Error] = fs.exists(fixture.join(?alloc, pages, "local"));
    if ((sel dep_page_r.ok && dep_page_r.ok) || (sel dep_dir_r.ok && dep_dir_r.ok)) { ret 4; }
    # the index lists the root's module and no dependency row
    val index_r: res[str, fs.FsError] = fs.read_string(?alloc, fixture.join(?alloc, pages, "README.md"));
    if (sel index_r.err)                                                             { ret 5; }
    if (!str_contains(index_r.ok, "[doctest.main](doctest/main.md)"))                { ret 6; }
    if (str_contains(index_r.ok, "local.lib") || str_contains(index_r.ok, "local/")) { ret 7; }
    ret 0;
}

test run__a_relative_out_is_project_rooted_and_an_absolute_out_is_refused {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var root: [4096]u8;
    if (!t_scratch_project(?alloc, ?root[0])) {
        fs.remove_all(?alloc, ?root[0]);
        ret 1;
    }
    fin { fs.remove_all(?alloc, ?root[0]); }

    var av: [6]*u8 = [6]*u8{"mach", "doc", ?root[0], "--quiet", "-o", "pages"};
    if (t_doc_run(6, ?av[0]) != 0) { ret 2; }
    val exists_r: res[bool, io_error.Error] = fs.exists(fixture.join(?alloc, fixture.join(?alloc, ?root[0], "pages"), "README.md"));
    if (!(sel exists_r.ok && exists_r.ok)) { ret 3; }

    av[5] = fixture.join(?alloc, ?root[0], "elsewhere")::*u8;
    if (t_doc_run(6, ?av[0]) != exit.USER) { ret 4; }
    val absent_r: res[bool, io_error.Error] = fs.exists(av[5]::str);
    if (!(sel absent_r.ok && !absent_r.ok)) { ret 5; }
    av[5] = "../pages";
    if (t_doc_run(6, ?av[0]) != exit.USER) { ret 6; }
    ret 0;
}

test generate__creates_missing_output_dirs {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }

    val tf_r: res[fs.TempFile, fs.FsError] = fs.temp_create(?alloc, "mach_doc_test");
    if (sel tf_r.err) { ret 1; }
    var tf:   fs.TempFile = tf_r.ok;
    var root: [4096]u8;
    val tp:   *u8         = fs.temp_path(?tf)::*u8;
    val tlen: usize       = str_len(tp);
    val fits: bool        = tlen + 1 <= 4096;
    if (fits) {
        var j: usize = 0;
        for (j < tlen) {
            root[j] = tp[j];
            j       = j + 1;
        }
        root[tlen] = 0;
    }
    fs.temp_close_and_remove(?tf);
    if (!fits) { ret 1; }

    var bad:              i32             = 0;
    val src_dir:          str             = fixture.join(?alloc, ?root[0], "src");
    val create_dir_all_r: err[fs.FsError] = fs.create_dir_all(?alloc, ?root[0], 493);
    if (sel create_dir_all_r.err) { bad = 1; }
    val create_dir_all_r2: err[fs.FsError] = fs.create_dir_all(?alloc, src_dir, 493);
    if (sel create_dir_all_r2.err) { bad = 1; }

    val manifest_text: str             = on_host("[project]\nmach = \">=5\"\nid = \"doctest\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.linux]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[profile.debug]\nopt = 0\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n\n[artifact.doctest]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"{project.out}/bin/doctest\"\ntargets = [\"*\"]\nlink = []\nneed = []\n");
    val main_text:     str             = "fun main() i32 { ret 0; }\n\n# a documented helper\npub fun answer() i32 { ret 42; }\n";
    val mf:            str             = fixture.join(?alloc, ?root[0], util.PROJECT_CONFIG_NAME);
    val mn:            str             = fixture.join(?alloc, src_dir, "main.mach");
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(mf, manifest_text::*u8, str_len(manifest_text::*u8), 420);
    if (sel write_bytes_r.err) { bad = 1; }
    val write_bytes_r2: err[fs.FsError] = fs.write_bytes(mn, main_text::*u8, str_len(main_text::*u8), 420);
    if (sel write_bytes_r2.err) { bad = 1; }

    if (bad != 0) {
        fs.remove_all(?alloc, ?root[0]);
        ret 1;
    }

    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) {
        fs.remove_all(?alloc, ?root[0]);
        ret 1;
    }
    var s: session.Session = sr.ok;

    var pick: manifest.Selectors             = manifest.t_selectors("", "linux", "");
    val pr:   res[driver.Project, fail.Fail] = driver.build_project(?s, ?root[0], ?pick);
    if (sel pr.err) {
        session.dnit(?s);
        fs.remove_all(?alloc, ?root[0]);
        ret 1;
    }
    var p: driver.Project = pr.ok;

    val doc_dir: str = fixture.join(?alloc, (?root[0])::str, "doc");

    var stats: DocStats;
    stats.modules = 0;
    stats.entries = 0;
    val generated: err[fail.Fail] = generate(?alloc, ?p, doc_dir, ?stats);
    if (sel generated.err) { bad = 1; }
    val is_dir_r: res[bool, io_error.Error] = fs.is_dir(doc_dir);
    if (sel is_dir_r.err)                  { ret 99; }
    if (!(sel is_dir_r.ok && is_dir_r.ok)) { bad = 1; }

    val readme:    str                       = fixture.join(?alloc, doc_dir, "README.md");
    val is_file_r: res[bool, io_error.Error] = fs.is_file(readme);
    if (sel is_file_r.err)                   { ret 99; }
    if (!(sel is_file_r.ok && is_file_r.ok)) { bad = 1; }

    # the index is published whole, so existence is not the property: a
    # truncated or empty index is exactly what a partial write would leave
    val idx_r: res[str, fs.FsError] = fs.read_string(?alloc, readme);
    if (sel idx_r.err) { bad = 1; }
    if (sel idx_r.ok) {
        val idx: str = idx_r.ok;
        if (!str_contains(idx, "# API reference"))                   { bad = 1; }
        if (!str_contains(idx, "- [doctest.main](doctest/main.md)")) { bad = 1; }
    }

    # and the page it links to holds the declaration it was generated for
    val pagep:  str                  = fixture.join(?alloc, doc_dir, "doctest/main.md");
    val page_r: res[str, fs.FsError] = fs.read_string(?alloc, pagep);
    if (sel page_r.err) { bad = 1; }
    if (sel page_r.ok) {
        val pg: str = page_r.ok;
        if (!str_contains(pg, "# doctest.main"))      { bad = 1; }
        if (!str_contains(pg, "a documented helper")) { bad = 1; }
    }

    driver.dnit_project(?p);
    session.dnit(?s);
    fs.remove_all(?alloc, ?root[0]);
    ret bad;
}

# a write that fails deep in the page walk is not silently dropped: `wr` cannot
# report it, so the sink latches it and the callback reports it once
test write_page__a_failed_write_fails_the_callback {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }

    var empty:    ast.Ast = ast.init(?alloc, lang_source.FILE_NIL);
    var refusing: fixture.MemSink;
    var failing:  io_writer.Writer;
    fixture.mem_writer(?failing, ?refusing);
    refusing.fail = true;

    var ctx: PageCtx;
    ctx.a          = ?empty;
    ctx.source     = "";
    ctx.fqn        = "m"::*u8;
    ctx.p          = nil;
    ctx.resolved   = nil;
    ctx.documented = 0;

    val r: err[io_writer.WriteError] = write_page(?ctx, ?failing);
    if (sel r.ok) { ret 1; }
    ret 0;
}

# generates the documentation of a one-module scratch project and returns its page, or nil
#[testing]
fun t_document_main(alloc: *A.Allocator, main_text: str) str {
    ret t_document_beside(alloc, main_text, nil, nil);
}

# generates the documentation of a scratch project whose main module sits beside
# one more, `other_name` under src, and returns the main module's page, or nil
#[testing]
fun t_document_beside(alloc: *A.Allocator, main_text: str, other_name: str, other_text: str) str {
    var root: [4096]u8;
    if (!t_scratch_project(alloc, ?root[0])) { ret nil; }
    fin { fs.remove_all(alloc, ?root[0]); }
    val mn:      str             = fixture.join(alloc, fixture.join(alloc, ?root[0], "src"), "main.mach");
    val written: err[fs.FsError] = fs.write_bytes(mn, main_text::*u8, str_len(main_text), 420);
    if (sel written.err) { ret nil; }
    if (other_name != nil) {
        val on:    str             = fixture.join(alloc, fixture.join(alloc, ?root[0], "src"), other_name);
        val other: err[fs.FsError] = fs.write_bytes(on, other_text::*u8, str_len(other_text), 420);
        if (sel other.err) { ret nil; }
    }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(alloc);
    if (sel sr.err) { ret nil; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var pick: manifest.Selectors             = manifest.t_selectors("", "linux", "");
    val pr:   res[driver.Project, fail.Fail] = driver.build_project(?s, ?root[0], ?pick);
    if (sel pr.err) { ret nil; }
    var p: driver.Project = pr.ok;
    fin { driver.dnit_project(?p); }
    val doc_dir:   str            = fixture.join(alloc, (?root[0])::str, "doc");
    var stats:     DocStats       = DocStats{modules: 0, entries: 0};
    val generated: err[fail.Fail] = generate(alloc, ?p, doc_dir, ?stats);
    if (sel generated.err) { ret nil; }
    val page_r: res[str, fs.FsError] = fs.read_string(alloc, fixture.join(alloc, doc_dir, "doctest/main.md"));
    if (sel page_r.err) { ret nil; }
    ret page_r.ok;
}

test generate__documents_a_public_generic_tag_and_omits_testing_declarations {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val pg: str = t_document_main(?alloc, "# optional value container\n# ---\n# [T]: payload element type\n# none: empty alternative\n# some: value alternative\npub tag Option[T]: u8 {\n    none;\n    some: T;\n}\n# shipped helper\npub fun shipped() i32 { ret 0; }\n# fixture helper\n#[testing]\npub fun fixture_fun() i32 { ret 1; }\n#[testing]\npub rec FixtureRec { n: i32; }\n$if ($mach.build.pointer_width == 8) {\n    #[testing]\n    pub val fixture_val: i32 = 2;\n}\nfun main() i32 { ret 0; }\n");
    if (pg == nil)                                                                              { ret 2; }
    if (!str_contains(pg, "# doctest.main"))                                                    { ret 3; }
    if (!str_contains(pg, "## tag Option"))                                                     { ret 4; }
    if (!str_contains(pg, "```mach\npub tag Option[T]: u8 {\n    none;\n    some: T;\n}\n```")) { ret 5; }
    if (!str_contains(pg, "optional value container"))                                          { ret 6; }
    if (!str_contains(pg, "[T]: payload element type"))                                         { ret 7; }
    if (!str_contains(pg, "none: empty alternative"))                                           { ret 8; }
    if (!str_contains(pg, "some: value alternative"))                                           { ret 9; }
    if (!str_contains(pg, "## fun shipped"))                                                    { ret 10; }
    if (str_contains(pg, "fixture") || str_contains(pg, "Fixture"))                             { ret 11; }
    ret 0;
}

# a surface of `fwd` declarations shows its module docstring and names what
# each one forwards, linked to the page that documents it
test generate__documents_a_module_docstring_and_what_each_fwd_forwards {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val pg: str = t_document_beside(?alloc,
        "# the doctest surface\n#\n# a second paragraph.\n\nuse doctest.api;\n\nfwd api.compile;\n# the kind, renamed\nfwd kind: api.Kind;\nfwd surface: doctest.api;\n\nfun main() i32 { ret 0; }\n",
        "api.mach", "# the api\n\n# compile a pattern\npub fun compile() i32 { ret 0; }\n\npub def Kind: u8;\n");
    if (pg == nil)                                                                                { ret 2; }
    if (!str_contains(pg, "# doctest.main\n\nthe doctest surface\n\na second paragraph.\n\n"))    { ret 3; }
    if (!str_contains(pg, "## fwd api.compile\n\n```mach\nfwd api.compile\n```\n"))               { ret 4; }
    if (!str_contains(pg, "forwards [`doctest.api.compile`](api.md#fun-compile)"))                { ret 5; }
    if (!str_contains(pg, "## fwd kind"))                                                         { ret 6; }
    if (!str_contains(pg, "forwards [`doctest.api.Kind`](api.md#def-kind)\n\nthe kind, renamed")) { ret 7; }
    if (!str_contains(pg, "forwards [`doctest.api`](api.md)"))                                    { ret 8; }
    ret 0;
}
