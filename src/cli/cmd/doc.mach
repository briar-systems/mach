# `mach doc`: the project's reference, every module some artifact reaches, written by
# the documentation generator (`mach.tool.doc`) into `doc/<project id>/`
use std_args: std.args;
use std.collections.slice.Slice;
use std_format: std.format;
use std.types.bool.false;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;

use mach.base.diagnostic;
use diagnostic_kind: mach.base.diagnostic.kind;
use mach.base.fail;
use mach.cli.args;
use cli_diagnostic: mach.cli.diagnostic;
use mach.cli.exit;
use mach.cli.util;
use mach.compile;
use compile_frontend: mach.compile.frontend;
use mach.compile.project;
use manifest_model:  mach.manifest.model;
use manifest_schema: mach.manifest.schema;
use manifest_select: mach.manifest.select;
use report_phase:    mach.report.phase;
use mach.session;
use tool_doc: mach.tool.doc;

# `-o <dir>`, the directory the reference's directory is made in
val OUTPUT: std_args.Flag = std_args.Flag{long: "output", short: 'o', value: "dir", repeat: false, negatable: false, help: "write the reference under <dir>/<project id> (default: doc)"};
# `-t <pattern>`, the one target name resolution follows
val TARGET: std_args.Flag = std_args.Flag{long: "target", short: 't', value: "pattern", repeat: false, negatable: false, help: "the target whose name resolution the reference follows: a name or glob of the manifest's targets naming one (default: the host's)"};

# length of FLAGS
val FLAGS_N: usize = 5;
# the flags mach doc takes
val FLAGS: [FLAGS_N]*std_args.Flag = [FLAGS_N]*std_args.Flag{?args.HELP, ?args.DIAGNOSTICS, ?TARGET, ?OUTPUT, ?args.QUIET};

# length of REFUSED
val REFUSED_N: usize = 1;
# the selector doc recognizes only to refuse, since one run documents every artifact
val REFUSED: [REFUSED_N]*std_args.Flag = [REFUSED_N]*std_args.Flag{?args.ARTIFACT};

# `mach doc`
pub val COMMAND: std_args.Command = std_args.Command{name: "doc", aliases: args.NO_WORDS, help: "write the project's reference documentation", usage: "<path>", flags: Slice[*std_args.Flag]{data: ?FLAGS[0], size: FLAGS_N}, commands: args.NO_COMMANDS, operand_min: 0, operand_max: 1, passthrough: false};
# what mach holds `mach doc` to beyond the parse
pub val POLICY: args.Policy = args.Policy{refused: Slice[*std_args.Flag]{data: ?REFUSED[0], size: REFUSED_N}, refusal: "doc documents every artifact in one run", conflicts: args.NO_CONFLICTS};

# the project at `root` through its resolution, over the union of its artifacts on the one
# target `selectors` names: a rejected load or resolution refuses, since doc renders only a
# project that resolved
fun analyze(s: *session.Session, root: str, m: *manifest_model.Manifest, selectors: *manifest_select.Selectors) res[project.Project, fail.Fail] {
    var an: compile.Analysis = compile.Analysis{
        root:  root, manifest: m, selection: selectors, roots: project.ROOT_UNION, files: nil, file_count: 0,
        phase: compile.FRONTEND_RESOLVE
    };
    val res_analyzed: res[project.Project, fail.Fail] = compile.analyze(s, ?an);
    if (sel res_analyzed.err) { ret res_analyzed; }
    var p:      project.Project          = res_analyzed.ok;
    val status: report_phase.PhaseStatus = compile_frontend.frontend_status(?p);
    if (!sel status.kind.accepted) {
        project.dnit_project(?p);
        ret res[project.Project, fail.Fail].err{report_phase.phase_failure(status)};
    }
    ret res[project.Project, fail.Fail].ok{p};
}

# `mach doc`: load and resolve every module the project's artifacts reach, then write one
# page per module, one per directory and the project's page under `<root>/doc/<project id>/`,
# or under `-o <dir>` inside the project root, removing what that directory holds that the
# run did not write. a summary line prints unless `--quiet`
# ---
# cx:  the call
# ret: exit.OK, or the failure: a user one for a project, manifest, selection or output path
#      error, an internal one for an allocator or session failure, an environment one for a
#      read, write or removal
pub fun run(cx: *args.Call) res[i64, fail.Fail] {
    val inv:   *std_args.Parsed = cx.inv;
    val alloc: *A.Allocator     = cx.a;

    var leaf:          str      = "doc";
    val opt_out_given: opt[*u8] = args.value(inv, ?OUTPUT);
    if (sel opt_out_given.some)                 { leaf = opt_out_given.some::str; }
    if (!manifest_schema.is_project_path(leaf)) { ret res[i64, fail.Fail].err{fail.user(diagnostic_kind.OUTPUT_PATH_INVALID, manifest_schema.OUTPUT_CONSTRAINT)}; }

    var target:     str      = "";
    val opt_target: opt[*u8] = args.value(inv, ?TARGET);
    if (sel opt_target.some) { target = opt_target.some::str; }
    val res_selectors: res[manifest_select.Selectors, fail.Fail] = manifest_select.selectors_of(alloc, "", target, "");
    if (sel res_selectors.err) { ret res[i64, fail.Fail].err{res_selectors.err}; }
    var selectors: manifest_select.Selectors = res_selectors.ok;
    fin { manifest_select.selectors_dnit(?selectors); }

    val res_loc: res[util.ProjectLocation, fail.Fail] = util.resolve_project_location(alloc, args.operand(inv, 0));
    if (sel res_loc.err) { ret res[i64, fail.Fail].err{res_loc.err}; }
    val root: str = res_loc.ok.root;

    val res_session: res[session.Session, fail.Fail] = session.init_in(alloc, cx.sources);
    if (sel res_session.err) { ret res[i64, fail.Fail].err{fail.prefixed(alloc, "failed to initialise compiler session: ", res_session.err)}; }
    var s: session.Session = res_session.ok;
    fin { session.dnit(?s); }

    val res_manifest: res[manifest_model.Manifest, fail.Fail] = compile.load_manifest(?s, root);
    if (sel res_manifest.err) { ret res[i64, fail.Fail].err{res_manifest.err}; }
    var m: manifest_model.Manifest = res_manifest.ok;
    fin { manifest_model.dnit(?m, s.build_alloc); }

    val res_project: res[project.Project, fail.Fail] = analyze(?s, root, ?m, ?selectors);
    if (diagnostic.len(?s.diags) > 0) { cli_diagnostic.report_store(cx.report, s.sources, ?s.diags); }
    if (sel res_project.err)          { ret res[i64, fail.Fail].err{args.selection_hint(alloc, ?selectors, res_project.err)}; }
    var p: project.Project = res_project.ok;
    fin { project.dnit_project(?p); }

    var outcome:       tool_doc.Outcome;
    val err_generated: err[fail.Fail] = tool_doc.generate(alloc, ?p, ?m, root, leaf, ?outcome);
    if (sel err_generated.err) { ret res[i64, fail.Fail].err{err_generated.err}; }

    if (!std_args.given(inv, ?args.QUIET)) {
        std_format.format(cli_diagnostic.out(cx.report), "documented {} modules in {} pages ({} written, {} removed) -> {}\n",
            outcome.modules::u64, outcome.pages::u64, outcome.changed::u64, outcome.removed::u64, outcome.dir);
    }
    ret res[i64, fail.Fail].ok{exit.OK};
}
