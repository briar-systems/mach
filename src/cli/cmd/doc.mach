use mach.lang.publication;

val FILE_MODE: i32 = 420;

rec DocStats {
    modules: u32;
    entries: u32;
}

fun wr(w: *writer.Writer, s: *u8) {
    writer.write_all(w, s, str_len(s));
}

fun wr_n(w: *writer.Writer, s: *u8, len: usize) {
    if (len == 0) { ret; }
    writer.write_all(w, s, len);
}

fun line_end(s: *u8, pos: usize) usize {
    var i: usize = pos;
    for (s[i] != 0 && s[i] != '\n') { i = i + 1; }
    ret i;
}

fun first_nonspace(s: *u8, pos: usize) usize {
    var i: usize = pos;
    for (s[i] == ' ' || s[i] == '\t') { i = i + 1; }
    ret i;
}

fun starts_with(s: *u8, pos: usize, lit: *u8) bool {
    var i: usize = 0;
    for (lit[i] != 0) {
        if (s[pos + i] != lit[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun next_line(s: *u8, pos: usize) usize {
    val e: usize = line_end(s, pos);
    if (s[e] == 0) { ret e; }
    ret e + 1;
}

fun skip_decorators(s: *u8, pos: usize) usize {
    var i:  usize = pos;
    var go: bool  = true;
    for (go) {
        for (s[i] == ' ' || s[i] == '\t' || s[i] == '\n' || s[i] == '\r') { i = i + 1; }
        if (s[i] == '#' && s[i + 1] == '[') {
            i = i + 2;
            var depth: i64 = 1;
            for (depth > 0 && s[i] != 0) {
                if (s[i] == '[') { depth = depth + 1; }
                or (s[i] == ']') { depth = depth - 1; }
                i = i + 1;
            }
        }
        or {
            go = false;
        }
    }
    ret i;
}

fun write_span_stripped(w: *writer.Writer, source: str, span: token.Span) {
    val s:   *u8   = source::*u8;
    val end: usize = span.offset + span.len;

    var i:     usize = span.offset;
    var first: bool  = true;
    for (i < end) {
        if (!first) {
            for (i < end && (s[i] == ' ' || s[i] == '\t')) { i = i + 1; }
            if (i < end && s[i] == '#') { i = i + 1; }
            if (i < end && s[i] == ' ') { i = i + 1; }
        }
        first = false;

        var le: usize = i;
        for (le < end && s[le] != '\n') { le = le + 1; }
        wr_n(w, ?s[i], le - i);
        if (le < end) { wr(w, "\n"); }

        i = le;
        if (i < end && s[i] == '\n') { i = i + 1; }
    }
}

fun write_doc(w: *writer.Writer, source: str, doc: token.Span) {
    if (doc.len == 0) { ret; }

    val summary: token.Span = fdoc.summary_span(source, doc);
    if (summary.len > 0) {
        write_span_stripped(w, source, summary);
        wr(w, "\n");
    }

    var it:    fdoc.DocComponentIter = fdoc.component_iter(source, doc);
    var c:     fdoc.DocComponent;
    var first: bool = true;
    for (fdoc.component_next(?it, ?c)) {
        if (first) {
            wr(w, "\n");
            first = false;
        }
        write_span_stripped(w, source, c.name_span);
        if (c.desc_span.len > 0) {
            wr(w, ": ");
            write_span_stripped(w, source, c.desc_span);
        }
        or {
            wr(w, ":");
        }
        wr(w, "\n");
    }
    wr(w, "\n");
}

fun write_signature(w: *writer.Writer, s: *u8, pos: usize, keep_braces: bool) usize {
    wr(w, "```mach\n");
    val base_indent: usize = first_nonspace(s, pos) - pos;
    var line:  usize = pos;
    var depth: i64   = 0;
    var brace_depth: i64 = 0;
    var done:  bool  = false;
    for (!done && s[line] != 0) {
        val e:     usize = line_end(s, line);
        var begin: usize = first_nonspace(s, line);
        if (keep_braces && line != pos) {
            if (begin < e && begin >= line + base_indent) {
                begin = line + base_indent;
            }
        }

        var i:         usize = begin;
        var cut:       usize = e;
        var saw_brace: bool  = false;
        for (i < e) {
            val c: u8 = s[i];
            if (c == '#') { i = e; cnt; }
            if (c == '(' || c == '[')   { depth = depth + 1; }
            or (c == ')' || c == ']')   { depth = depth - 1; }
            or (keep_braces && depth == 0 && c == '{') {
                brace_depth = brace_depth + 1;
            }
            or (keep_braces && depth == 0 && c == '}') {
                brace_depth = brace_depth - 1;
                if (brace_depth <= 0) {
                    cut = i + 1;
                    done = true;
                    i = e;
                    cnt;
                }
            }
            or (!keep_braces && depth == 0 && c == ';') { cut = i; done = true; i = e; cnt; }
            or (!keep_braces && depth == 0 && c == '{') { cut = i; saw_brace = true; done = true; i = e; cnt; }
            i = i + 1;
        }

        var trimmed: usize = cut;
        for (trimmed > begin && (s[trimmed - 1] == ' ' || s[trimmed - 1] == '\t')) {
            trimmed = trimmed - 1;
        }
        wr_n(w, ?s[begin], trimmed - begin);
        if (saw_brace) { wr(w, ";"); }
        wr(w, "\n");
        line = next_line(s, line);
    }
    wr(w, "```\n\n");
    ret line;
}

fun write_heading(w: *writer.Writer, s: *u8, pos: usize) {
    var begin: usize = first_nonspace(s, pos);
    if (starts_with(s, begin, "pub ")) { begin = begin + 4; }
    begin = first_nonspace(s, begin);

    val e:    usize = line_end(s, begin);
    var stop: usize = begin;
    var i:    usize = begin;
    for (i < e) {
        val c: u8 = s[i];
        if (c == '(' || c == '[' || c == ':' || c == '=' || c == '{' || c == ';') { i = e; cnt; }
        if (c != ' ' && c != '\t')                                                { stop = i + 1; }
        i = i + 1;
    }
    wr_n(w, ?s[begin], stop - begin);
}

fun document_decl(w: *writer.Writer, source: str, d: *decl.Decl) {
    val s:   *u8   = source::*u8;
    val sig: usize = skip_decorators(s, d.span.offset);

    wr(w, "## ");
    write_heading(w, s, sig);
    wr(w, "\n\n");

    write_signature(w, s, sig, d.kind == decl.DECL_KIND_TAG);
    write_doc(w, source, d.doc);
}

fun document_decls(w: *writer.Writer, a: *ast.Ast, source: str, start: u32, len: u32) i64 {
    var documented: i64 = 0;
    var i:          u32 = 0;
    for (i < len) {
        val did:   id.DeclId            = a.decl_ids[start + i];
        val opt_d: opt[*decl.Decl] = ast.get_decl(a, did);
        if (sel opt_d.some) {
            val d: *decl.Decl = opt_d.some;
            if (d.kind == decl.DECL_KIND_COMPTIME_IF) {
                val ci: *decl.DeclComptimeIf = ?d.data.comptime_if;
                var ii: u32 = 0;
                for (ii < ci.branches_len) {
                    val br: *decl.ComptimeBranch = ?a.comptime_branches[ci.branches_start + ii];
                    documented = documented + document_decls(w, a, source, br.body_start, br.body_len);
                    ii = ii + 1;
                }
            }
            or ((d.flags & decl.DECL_FLAG_PUB) != 0) {
                document_decl(w, source, d);
                documented = documented + 1;
            }
        }
        i = i + 1;
    }
    ret documented;
}

# a writer that remembers a failure
#
# the page helpers write through `wr`, which cannot report anything: a write is
# one statement among many, deep inside the declaration walk, and threading a
# result out of every one of them would say the same thing eight times. so the
# failure is latched here instead, at the one seam every write already passes
# through, and the callback asks once at the end.
rec CheckedSink {
    inner:  *writer.Writer;
    failed: bool;
}

fun checked_write(ctx: ptr, buf: *u8, len: usize) res[usize, writer.WriteError] {
    val s: *CheckedSink = ctx::*CheckedSink;
    val r: res[usize, writer.WriteError] = s.inner.f_write(s.inner.ctx, buf, len);
    if (sel r.err) { s.failed = true; }
    ret r;
}

fun checked_writer(s: *CheckedSink, inner: *writer.Writer) writer.Writer {
    s.inner  = inner;
    s.failed = false;
    var w: writer.Writer;
    w.ctx     = s::ptr;
    w.f_write = checked_write;
    ret w;
}

rec PageCtx {
    a:          *ast.Ast;
    source:     str;
    fqn:        *u8;
    documented: i64;
}

fun write_page(ctx: *PageCtx, dst: *writer.Writer) err[writer.WriteError] {
    var sink: CheckedSink;
    var cw: writer.Writer = checked_writer(?sink, dst);
    val w: *writer.Writer = ?cw;

    wr(w, "# ");
    wr(w, ctx.fqn);
    wr(w, "\n\n");

    val opt_module: opt[*module.Module] = ast.get_module(ctx.a, ctx.a.root_module);
    if (sel opt_module.some) {
        val m: *module.Module = opt_module.some;
        ctx.documented = document_decls(w, ctx.a, ctx.source, m.decls_start, m.decls_len);
    }

    if (sink.failed) { ret err[writer.WriteError].err{writer.WriteError.stalled{0}}; }
    ret err[writer.WriteError].ok{};
}

# publish one page whole: a reader never sees a partially generated page, and a
# crash leaves the previous one intact rather than a truncated replacement
fun publish_page[C](alloc: *A.Allocator, out_path: str, ctx: *C,
                    write_cb: fun(*C, *writer.Writer) err[writer.WriteError]) bool {
    val writer_r: err[outcome.Fail] = publication.writer[C](nil, alloc, out_path, ctx, write_cb, FILE_MODE,
        publication.REPLACE, publication.PARENTS_EXIST, "write", "the page could not be published");
    ret sel writer_r.ok;
}

fun document_module(alloc: *A.Allocator, out_path: *u8, fqn: *u8, a: *ast.Ast, source: str) i64 {
    val ensure_parents_r: err[outcome.Fail] = util.ensure_parents(alloc, out_path::str);
    if (sel ensure_parents_r.err) { ret -1; }

    var ctx: PageCtx;
    ctx.a          = a;
    ctx.source     = source;
    ctx.fqn        = fqn;
    ctx.documented = 0;

    if (!publish_page[PageCtx](alloc, out_path::str, ?ctx, write_page)) { ret -1; }
    ret ctx.documented;
}

rec IndexCtx {
    alloc:   *A.Allocator;
    p:       *driver.Project;
    api_dir: str;
    stats:   *DocStats;
    failed:  bool;
}

fun write_index(ctx: *IndexCtx, dst: *writer.Writer) err[writer.WriteError] {
    val alloc: *A.Allocator = ctx.alloc;
    val p: *driver.Project = ctx.p;
    val api_dir: str = ctx.api_dir;
    val stats: *DocStats = ctx.stats;

    var sink: CheckedSink;
    var cw: writer.Writer = checked_writer(?sink, dst);
    val iw: *writer.Writer = ?cw;

    wr(iw, "# API reference\n\n");
    wr(iw, "generated by `mach doc` from source doc-comments.\n\n");

    var i: u32 = 0;
    for (i < p.module_len) {
        val m: *driver.ModuleEntry = ?p.modules[i];

        val opt_fqn: opt[str] = intern.lookup(?p.s.interner, m.fqn);
        if (sel opt_fqn.none) { i = i + 1; cnt; }
        val fqn: *u8 = opt_fqn.some::*u8;

        val opt_source: opt[*src.SourceFile] = src.get(?p.s.sources, m.file_id);
        if (sel opt_source.none) { i = i + 1; cnt; }
        val source: str = opt_source.some.text;

        val rel_r: res[str, string.StrError] = str_replace(alloc, fqn::str, ".", "/");
        if (sel rel_r.err) { i = i + 1; cnt; }
        val rel: str = rel_r.ok;
        val base_r: res[str, A.Error] = path.join(alloc, api_dir, rel);
        if (sel base_r.err) { i = i + 1; cnt; }
        val page_r: res[str, string.StrError] = str_join(alloc, base_r.ok, ".md");
        if (sel page_r.err) { i = i + 1; cnt; }
        val page_path: str = page_r.ok;

        val documented: i64 = document_module(alloc, page_path, fqn, m.a, source);
        if (documented < 0) {
            print.eprint("error: failed to write page for ");
            print.eprint(fqn::str);
            print.eprint("\n");
            ctx.failed = true;
            ret err[writer.WriteError].err{writer.WriteError.stalled{0}};
        }

        wr(iw, "- [");
        wr(iw, fqn);
        wr(iw, "](");
        wr(iw, rel);
        wr(iw, ".md)\n");

        stats.modules = stats.modules + 1;
        stats.entries = stats.entries + documented::u32;
        i = i + 1;
    }

    if (sink.failed) { ret err[writer.WriteError].err{writer.WriteError.stalled{0}}; }
    ret err[writer.WriteError].ok{};
}

fun generate(alloc: *A.Allocator, p: *driver.Project, api_dir: str, stats: *DocStats) i64 {
    val create_dir_all_r: err[fs.FsError] = fs.create_dir_all(alloc, api_dir, 0o755);
    if (sel create_dir_all_r.err) {
        print.eprint("error: could not create output directory\n");
        ret 2;
    }

    val idx_r: res[str, A.Error] = path.join(alloc, api_dir, "README.md");
    if (sel idx_r.err) { ret 2; }
    val index_path: str = idx_r.ok;

    var ctx: IndexCtx;
    ctx.alloc   = alloc;
    ctx.p       = p;
    ctx.api_dir = api_dir;
    ctx.stats   = stats;
    ctx.failed  = false;

    # the index names the pages, so it is published after them and only when
    # every one of them landed: a reader never follows a link to a missing page
    if (!publish_page[IndexCtx](alloc, index_path, ?ctx, write_index)) {
        if (ctx.failed) { ret 2; }
        print.eprint("error: could not publish the documentation index\n");
        ret 2;
    }
    ret 0;
}

# `mach doc`: build the project's module graph and write one Markdown page per module plus
# an index. pages go to `<root>/doc/api/<module path>.md`, or under `--out <dir>` relative
# to the root, with a README.md index; every `pub` declaration is rendered, documented or
# not. a summary line prints unless `--quiet`
# ---
# argv: the full process arguments
# inv: the parsed invocation for this command
# ret: 0 success, 1 project or manifest error, 2 allocator, session, registry, or write failure
pub fun run(argv: **u8, inv: *args.ParsedInvocation) i64 {
    if (args.reject_unknown_from_invocation(inv, argv, "mach doc")) { ret 1; }
    val parsed: args.DocInvocation = args.build_doc_invocation(inv);
    val config_r: res[request.CliArgs, outcome.Fail] = args.build_cli_invocation(args.CMD_DOC, inv, argv);
    if (sel config_r.err) {
        print.eprint("error: ");
        print.eprint(outcome.describe(config_r.err));
        print.eprint("\n");
        ret 1;
    }
    var config: request.CliArgs = config_r.ok;
    var pick: manifest.Selection;
    val sel_r: err[outcome.Fail] = args.selection_from_config(?config, ?pick);
    if (sel sel_r.err) {
        print.eprint("error: ");
        print.eprint(outcome.describe(sel_r.err));
        print.eprint("\n");
        ret 1;
    }

    var backing: A.Allocator;
    val make_r: err[A.Error] = page.make(?backing);
    if (sel make_r.err) {
        print.eprint("error: failed to initialise allocator\n");
        ret 2;
    }
    var ar: arena.Arena;
    val init_r: err[A.Error] = arena.init(?ar, ?backing, 0);
    if (sel init_r.err) {
        print.eprint("error: failed to initialise allocator\n");
        ret 2;
    }
    var alloc: A.Allocator;
    val make_r2: err[A.Error] = arena.make(?alloc, ?ar);
    if (sel make_r2.err) {
        arena.dnit(?ar);
        print.eprint("error: failed to initialise allocator\n");
        ret 2;
    }

    var arg: *u8 = nil;
    if (parsed.has_project) { arg = argv[parsed.project_idx]; }

    val loc_r: res[util.ProjectLocation, outcome.Fail] = util.resolve_project_location(?alloc, arg);
    if (sel loc_r.err) {
        print.eprint("error: ");
        print.eprint(outcome.describe(loc_r.err));
        print.eprint("\n");
        arena.dnit(?ar);
        ret 1;
    }
    val loc: util.ProjectLocation = loc_r.ok;
    val root: str = loc.root;

    val res_session: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel res_session.err) {
        print.eprint("error: failed to initialise compiler session\n");
        arena.dnit(?ar);
        ret 2;
    }
    var s: session.Session = res_session.ok;

    val res_register: err[outcome.Fail] = driver.setup_registry(?s.registry);
    if (sel res_register.err) {
        print.eprint("error: failed to register targets\n");
        session.dnit(?s);
        arena.dnit(?ar);
        ret 2;
    }

    val res_project: res[driver.Project, outcome.Fail] = driver.build_project(?s, root, ?pick);
    if (diagnostic.len(?s.diags) > 0) {
        var err_w: writer.Writer = fs.writer(fs.STDERR);
        cli_diag.flush(?err_w, ?s, ?s.diags);
    }
    if (sel res_project.err) {
        var f: outcome.Fail = res_project.err;
        val code: i64 = cli_diag.render_fail(?f);
        session.dnit(?s);
        arena.dnit(?ar);
        ret code;
    }
    var p: driver.Project = res_project.ok;

    var leaf: str = "doc/api";
    if (parsed.has_out) { leaf = argv[parsed.out_idx]::str; }
    var api_r: res[str, A.Error] = path.join(?alloc, root, leaf);
    if (path.is_abs(leaf)) { api_r = path.clone(?alloc, leaf); }
    if (sel api_r.err) {
        print.eprint("error: out of memory\n");
        session.dnit(?s);
        arena.dnit(?ar);
        ret 2;
    }
    val api_dir: str = api_r.ok;

    var stats: DocStats;
    stats.modules = 0;
    stats.entries = 0;

    val code: i64 = generate(?alloc, ?p, api_dir, ?stats);

    if (code == 0 && !parsed.quiet) {
        print.print("documented ");
        print.u64(stats.entries::u64);
        print.print(" public entities across ");
        print.u64(stats.modules::u64);
        print.print(" modules -> ");
        print.print(api_dir);
        print.print("\n");
    }

    driver.dnit_project(?p);
    session.dnit(?s);
    arena.dnit(?ar);
    ret code;
}

rec Sink {
    buf: *u8;
    cap: usize;
    len: usize;
}

fun sink_write(ctx: ptr, buf: *u8, len: usize) res[usize, writer.WriteError] {
    val sk: *Sink = ctx::*Sink;
    var i: usize = 0;
    for (i < len && sk.len < sk.cap) {
        sk.buf[sk.len] = buf[i];
        sk.len = sk.len + 1;
        i = i + 1;
    }
    ret res[usize, writer.WriteError].ok{len};
}

fun t_doc_span(s: str) token.Span {
    var sp: token.Span;
    sp.offset = 0;
    sp.len    = string.str_len(s);
    ret sp;
}

fun t_render_eq(source: str, doc: token.Span, expect: str) bool {
    var buf: [512]u8;
    var sk:  Sink;
    sk.buf = ?buf[0];
    sk.cap = 512;
    sk.len = 0;

    val ctx: *Sink = ?sk;
    var w: writer.Writer;
    w.ctx      = ctx::ptr;
    w.f_write = sink_write;

    write_doc(?w, source, doc);

    if (sk.len != string.str_len(expect)) { ret false; }
    val e: *u8 = expect::*u8;
    var i: usize = 0;
    for (i < sk.len) {
        if (buf[i] != e[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun t_sig_eq(source: str, expect: str, is_tag: bool) bool {
    var buf: [512]u8;
    var sk:  Sink;
    sk.buf = ?buf[0];
    sk.cap = 512;
    sk.len = 0;

    val ctx: *Sink = ?sk;
    var w: writer.Writer;
    w.ctx     = ctx::ptr;
    w.f_write = sink_write;

    write_signature(?w, source::*u8, 0, is_tag);

    if (sk.len != string.str_len(expect)) { ret false; }
    val e: *u8 = expect::*u8;
    var i: usize = 0;
    for (i < sk.len) {
        if (buf[i] != e[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun t_at(source: str, off: usize, lit: str) bool {
    ret string.str_region_equals(source, off, string.str_len(lit), lit);
}

test "mach.cli.cmd.doc.write_doc:summary_then_components" {
    val source: str = "# sum two integers\n# ---\n# a: first addend\n# b: second addend\n# ret: the sum";
    if (!t_render_eq(source, t_doc_span(source),
        "sum two integers\n\na: first addend\nb: second addend\nret: the sum\n\n")) { ret 1; }
    ret 0;
}

test "mach.cli.cmd.doc.write_doc:summary_only" {
    val source: str = "# yield the CPU to other threads";
    if (!t_render_eq(source, t_doc_span(source), "yield the CPU to other threads\n\n")) { ret 1; }
    ret 0;
}

test "mach.cli.cmd.doc.write_doc:empty_span" {
    var doc: token.Span;
    doc.offset = 0;
    doc.len    = 0;
    if (!t_render_eq("", doc, "")) { ret 1; }
    ret 0;
}

test "mach.cli.cmd.doc.write_doc:wrapped_component" {
    val source: str = "# wrapped\n# ---\n# a: long line\n#    wraps here\n# b: short";
    if (!t_render_eq(source, t_doc_span(source),
        "wrapped\n\na: long line\n   wraps here\nb: short\n\n")) { ret 1; }
    ret 0;
}

test "mach.cli.cmd.doc.skip_decorators" {
    val own: str = "#[symbol(\"_start\")]\npub fun entry() i64 { ret 0; }";
    if (!t_at(own, skip_decorators(own::*u8, 0), "pub fun")) { ret 1; }

    val inl: str = "#[inline] pub fun g() {}";
    if (!t_at(inl, skip_decorators(inl::*u8, 0), "pub fun")) { ret 1; }

    val many: str = "#[a] #[b(1)]\nrec R { x: u8; }";
    if (!t_at(many, skip_decorators(many::*u8, 0), "rec R")) { ret 1; }

    val none: str = "pub val X: i64 = 0;";
    if (skip_decorators(none::*u8, 0) != 0) { ret 1; }
    ret 0;
}

test "mach.cli.cmd.doc.write_signature:tag_generic_with_payload_and_payloadless_cases" {
    val source: str = "pub tag Option[T]: u8 {\n    none;\n    some: T;\n}";
    val expect: str = "```mach\npub tag Option[T]: u8 {\n    none;\n    some: T;\n}\n```\n\n";
    if (!t_sig_eq(source, expect, true)) { ret 1; }
    ret 0;
}

test "mach.cli.cmd.doc.write_signature:tag_distinct_err_with_payload" {
