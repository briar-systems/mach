use src: mach.lang.source;
use mach.lang.target;
use mach.lang.publication;

val FILE_MODE: i32 = 420;

rec DocStats {
    modules: u32;
    entries: u32;
}

fun wr(w: *writer.Writer, s: *u8) {
    writer.write_all(w, s, str_len(s));
}

fun wr_n(w: *writer.Writer, s: *u8, len: usize) {
    if (len == 0) { ret; }
    writer.write_all(w, s, len);
}

fun line_end(s: *u8, pos: usize) usize {
    var i: usize = pos;
    for (s[i] != 0 && s[i] != '\n') { i = i + 1; }
    ret i;
}

fun first_nonspace(s: *u8, pos: usize) usize {
    var i: usize = pos;
    for (s[i] == ' ' || s[i] == '\t') { i = i + 1; }
    ret i;
}

fun starts_with(s: *u8, pos: usize, lit: *u8) bool {
    var i: usize = 0;
    for (lit[i] != 0) {
        if (s[pos + i] != lit[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun next_line(s: *u8, pos: usize) usize {
    val e: usize = line_end(s, pos);
    if (s[e] == 0) { ret e; }
    ret e + 1;
}

fun skip_decorators(s: *u8, pos: usize) usize {
    var i:  usize = pos;
    var go: bool  = true;
    for (go) {
        for (s[i] == ' ' || s[i] == '\t' || s[i] == '\n' || s[i] == '\r') { i = i + 1; }
        if (s[i] == '#' && s[i + 1] == '[') {
            i = i + 2;
            var depth: i64 = 1;
            for (depth > 0 && s[i] != 0) {
                if (s[i] == '[') { depth = depth + 1; }
                or (s[i] == ']') { depth = depth - 1; }
                i = i + 1;
            }
        }
        or {
            go = false;
        }
    }
    ret i;
}

fun write_span_stripped(w: *writer.Writer, source: str, span: token.Span) {
    val s:   *u8   = source::*u8;
    val end: usize = span.offset + span.len;

    var i:     usize = span.offset;
    var first: bool  = true;
    for (i < end) {
        if (!first) {
            for (i < end && (s[i] == ' ' || s[i] == '\t')) { i = i + 1; }
            if (i < end && s[i] == '#') { i = i + 1; }
            if (i < end && s[i] == ' ') { i = i + 1; }
        }
        first = false;

        var le: usize = i;
        for (le < end && s[le] != '\n') { le = le + 1; }
        wr_n(w, ?s[i], le - i);
        if (le < end) { wr(w, "\n"); }

        i = le;
        if (i < end && s[i] == '\n') { i = i + 1; }
    }
}

fun write_doc(w: *writer.Writer, source: str, doc: token.Span) {
    if (doc.len == 0) { ret; }

    val summary: token.Span = fdoc.summary_span(source, doc);
    if (summary.len > 0) {
        write_span_stripped(w, source, summary);
        wr(w, "\n");
    }

    var it:    fdoc.DocComponentIter = fdoc.component_iter(source, doc);
    var c:     fdoc.DocComponent;
    var first: bool = true;
    for (fdoc.component_next(?it, ?c)) {
        if (first) {
            wr(w, "\n");
            first = false;
        }
        write_span_stripped(w, source, c.name_span);
        if (c.desc_span.len > 0) {
            wr(w, ": ");
            write_span_stripped(w, source, c.desc_span);
        }
        or {
            wr(w, ":");
        }
        wr(w, "\n");
    }
    wr(w, "\n");
}

fun write_signature(w: *writer.Writer, s: *u8, pos: usize) usize {
    wr(w, "```mach\n");
    var line:  usize = pos;
    var depth: i64   = 0;
    var done:  bool  = false;
    for (!done && s[line] != 0) {
        val e:     usize = line_end(s, line);
        val begin: usize = first_nonspace(s, line);

        var i:         usize = begin;
        var cut:       usize = e;
        var saw_brace: bool  = false;
        for (i < e) {
            val c: u8 = s[i];
            if (c == '(' || c == '[')   { depth = depth + 1; }
            or (c == ')' || c == ']')   { depth = depth - 1; }
            or (depth == 0 && c == ';') { cut = i; done = true; i = e; cnt; }
            or (depth == 0 && c == '{') { cut = i; saw_brace = true; done = true; i = e; cnt; }
            i = i + 1;
        }

        var trimmed: usize = cut;
        for (trimmed > begin && (s[trimmed - 1] == ' ' || s[trimmed - 1] == '\t')) {
            trimmed = trimmed - 1;
        }
        wr_n(w, ?s[begin], trimmed - begin);
        if (saw_brace) { wr(w, ";"); }
        wr(w, "\n");
        line = next_line(s, line);
    }
    wr(w, "```\n\n");
    ret line;
}

fun write_heading(w: *writer.Writer, s: *u8, pos: usize) {
    var begin: usize = first_nonspace(s, pos);
    if (starts_with(s, begin, "pub ")) { begin = begin + 4; }
    begin = first_nonspace(s, begin);

    val e:    usize = line_end(s, begin);
    var stop: usize = begin;
    var i:    usize = begin;
    for (i < e) {
        val c: u8 = s[i];
        if (c == '(' || c == '[' || c == ':' || c == '=' || c == '{' || c == ';') { i = e; cnt; }
        if (c != ' ' && c != '\t')                                                { stop = i + 1; }
        i = i + 1;
    }
    wr_n(w, ?s[begin], stop - begin);
}

fun document_decl(w: *writer.Writer, source: str, d: *decl.Decl) {
    val s:   *u8   = source::*u8;
    val sig: usize = skip_decorators(s, d.span.offset);

    wr(w, "## ");
    write_heading(w, s, sig);
    wr(w, "\n\n");

    write_signature(w, s, sig);
    write_doc(w, source, d.doc);
}

fun document_decls(w: *writer.Writer, a: *ast.Ast, source: str, start: u32, len: u32) i64 {
    var documented: i64 = 0;
    var i:          u32 = 0;
    for (i < len) {
        val did:   id.DeclId            = a.decl_ids[start + i];
        val opt_d: O.Option[*decl.Decl] = ast.get_decl(a, did);
        if (O.is_some[*decl.Decl](opt_d)) {
            val d: *decl.Decl = O.unwrap[*decl.Decl](opt_d);
            if (d.kind == decl.DECL_KIND_COMPTIME_IF) {
                val ci: *decl.DeclComptimeIf = ?d.data.comptime_if;
                var ii: u32 = 0;
                for (ii < ci.branches_len) {
                    val br: *decl.ComptimeBranch = ?a.comptime_branches[ci.branches_start + ii];
                    documented = documented + document_decls(w, a, source, br.body_start, br.body_len);
                    ii = ii + 1;
                }
            }
            or ((d.flags & decl.DECL_FLAG_PUB) != 0) {
                document_decl(w, source, d);
                documented = documented + 1;
            }
        }
        i = i + 1;
    }
    ret documented;
}

# a writer that remembers a failure
#
# the page helpers write through `wr`, which cannot report anything: a write is
# one statement among many, deep inside the declaration walk, and threading a
# result out of every one of them would say the same thing eight times. so the
# failure is latched here instead, at the one seam every write already passes
# through, and the callback asks once at the end.
rec CheckedSink {
    inner:  *writer.Writer;
    failed: bool;
}

fun checked_write(ctx: ptr, buf: *u8, len: usize) R.Result[usize, str] {
    val s: *CheckedSink = ctx::*CheckedSink;
    val r: R.Result[usize, str] = writer.write(s.inner, buf, len);
    if (R.is_err[usize, str](r)) { s.failed = true; }
    ret r;
}

fun checked_writer(s: *CheckedSink, inner: *writer.Writer) writer.Writer {
    s.inner  = inner;
    s.failed = false;
    var w: writer.Writer;
    w.ctx     = s::ptr;
    w.f_write = checked_write;
    ret w;
}

rec PageCtx {
    a:          *ast.Ast;
    source:     str;
    fqn:        *u8;
    documented: i64;
}

fun write_page(ctx: *PageCtx, dst: *writer.Writer) R.Result[R.Void, str] {
    var sink: CheckedSink;
    var cw: writer.Writer = checked_writer(?sink, dst);
    val w: *writer.Writer = ?cw;

    wr(w, "# ");
    wr(w, ctx.fqn);
    wr(w, "\n\n");

    val opt_module: O.Option[*module.Module] = ast.get_module(ctx.a, ctx.a.root_module);
    if (O.is_some[*module.Module](opt_module)) {
        val m: *module.Module = O.unwrap[*module.Module](opt_module);
        ctx.documented = document_decls(w, ctx.a, ctx.source, m.decls_start, m.decls_len);
    }

    if (sink.failed) { ret R.err[R.Void, str]("failed to write the documentation page"); }
    ret R.ok_void[str]();
}

# publish one page whole: a reader never sees a partially generated page, and a
# crash leaves the previous one intact rather than a truncated replacement
fun publish_page[C](alloc: *A.Allocator, out_path: str, ctx: *C,
                    write_cb: fun(*C, *writer.Writer) R.Result[R.Void, str]) bool {
    ret R.is_ok[R.Void, str](publication.writer[C](nil, alloc, out_path, ctx, write_cb, FILE_MODE,
        publication.REPLACE, publication.PARENTS_EXIST, "write", "the page could not be published"));
}

fun document_module(alloc: *A.Allocator, out_path: *u8, fqn: *u8, a: *ast.Ast, source: str) i64 {
    if (O.is_some[str](util.ensure_parents(alloc, out_path::str))) { ret -1; }

    var ctx: PageCtx;
    ctx.a          = a;
    ctx.source     = source;
    ctx.fqn        = fqn;
    ctx.documented = 0;

    if (!publish_page[PageCtx](alloc, out_path::str, ?ctx, write_page)) { ret -1; }
    ret ctx.documented;
}

rec IndexCtx {
    alloc:   *A.Allocator;
    p:       *driver.Project;
    api_dir: str;
    stats:   *DocStats;
    failed:  bool;
}

fun write_index(ctx: *IndexCtx, dst: *writer.Writer) R.Result[R.Void, str] {
    val alloc: *A.Allocator = ctx.alloc;
    val p: *driver.Project = ctx.p;
    val api_dir: str = ctx.api_dir;
    val stats: *DocStats = ctx.stats;

    var sink: CheckedSink;
    var cw: writer.Writer = checked_writer(?sink, dst);
    val iw: *writer.Writer = ?cw;

    wr(iw, "# API reference\n\n");
    wr(iw, "generated by `mach doc` from source doc-comments.\n\n");

    var i: u32 = 0;
    for (i < p.module_len) {
        val m: *driver.ModuleEntry = ?p.modules[i];

        val opt_fqn: O.Option[str] = intern.lookup(?p.s.interner, m.fqn);
        if (O.is_none[str](opt_fqn)) { i = i + 1; cnt; }
        val fqn: *u8 = O.unwrap[str](opt_fqn)::*u8;

        val opt_source: O.Option[*src.SourceFile] = src.get(?p.s.sources, m.file_id);
        if (O.is_none[*src.SourceFile](opt_source)) { i = i + 1; cnt; }
        val source: str = O.unwrap[*src.SourceFile](opt_source).text;

        val rel_r: R.Result[str, str] = str_replace(alloc, fqn::str, ".", "/");
        if (R.is_err[str, str](rel_r)) { i = i + 1; cnt; }
        val rel: str = R.unwrap_ok[str, str](rel_r);
        val base_r: R.Result[str, str] = path.join(alloc, api_dir, rel);
        if (R.is_err[str, str](base_r)) { i = i + 1; cnt; }
        val page_r: R.Result[str, str] = str_join(alloc, R.unwrap_ok[str, str](base_r), ".md");
        if (R.is_err[str, str](page_r)) { i = i + 1; cnt; }
        val page_path: str = R.unwrap_ok[str, str](page_r);

        val documented: i64 = document_module(alloc, page_path, fqn, m.a, source);
        if (documented < 0) {
            print.eprint("error: failed to write page for ");
            print.eprint(fqn::str);
            print.eprint("\n");
            ctx.failed = true;
            ret R.err[R.Void, str]("failed to write a documentation page");
        }

        wr(iw, "- [");
        wr(iw, fqn);
        wr(iw, "](");
        wr(iw, rel);
        wr(iw, ".md)\n");

        stats.modules = stats.modules + 1;
        stats.entries = stats.entries + documented::u32;
        i = i + 1;
    }

    if (sink.failed) { ret R.err[R.Void, str]("failed to write the documentation index"); }
    ret R.ok_void[str]();
}

fun generate(alloc: *A.Allocator, p: *driver.Project, api_dir: str, stats: *DocStats) i64 {
    if (O.is_some[str](fs.create_dir_all(alloc, api_dir, 0o755))) {
        print.eprint("error: could not create output directory\n");
        ret 2;
    }

    val idx_r: R.Result[str, str] = path.join(alloc, api_dir, "README.md");
    if (R.is_err[str, str](idx_r)) { ret 2; }
    val index_path: str = R.unwrap_ok[str, str](idx_r);

    var ctx: IndexCtx;
    ctx.alloc   = alloc;
    ctx.p       = p;
    ctx.api_dir = api_dir;
    ctx.stats   = stats;
    ctx.failed  = false;

    # the index names the pages, so it is published after them and only when
    # every one of them landed: a reader never follows a link to a missing page
    if (!publish_page[IndexCtx](alloc, index_path, ?ctx, write_index)) {
        if (ctx.failed) { ret 2; }
        print.eprint("error: could not publish the documentation index\n");
        ret 2;
    }
    ret 0;
}

# `mach doc`: build the project's module graph and write one Markdown page per module plus
# an index. pages go to `<root>/doc/api/<module path>.md`, or under `--out <dir>` relative
# to the root, with a README.md index; every `pub` declaration is rendered, documented or
# not. a summary line prints unless `--quiet`
# ---
# argv: the full process arguments
# inv: the parsed invocation for this command
# ret: 0 success, 1 project or manifest error, 2 allocator, session, registry, or write failure
pub fun run_typed(argv: **u8, inv: *args.ParsedInvocation) i64 {
    if (args.reject_unknown_from_invocation(inv, argv, "mach doc")) { ret 1; }
    val parsed: args.DocInvocation = args.build_doc_invocation(inv);
    val config_r: R.Result[request.CliArgs, str] = args.build_cli_invocation(args.CMD_DOC, inv, argv);
    if (R.is_err[request.CliArgs, str](config_r)) {
        print.eprint("error: ");
        print.eprint(R.unwrap_err[request.CliArgs, str](config_r));
        print.eprint("\n");
        ret 1;
    }
    var config: request.CliArgs = R.unwrap_ok[request.CliArgs, str](config_r);
    var sel: manifest.Selection;
    val sel_r: R.Result[R.Void, str] = args.selection_from_config(?config, ?sel);
    if (R.is_err[R.Void, str](sel_r)) {
        print.eprint("error: ");
        print.eprint(R.unwrap_err[R.Void, str](sel_r));
        print.eprint("\n");
        ret 1;
    }

    var backing: A.Allocator;
    if (O.is_some[str](page.make(?backing))) {
        print.eprint("error: failed to initialise allocator\n");
        ret 2;
    }
    var ar: arena.Arena;
    if (O.is_some[str](arena.init(?ar, ?backing, 0))) {
        print.eprint("error: failed to initialise allocator\n");
        ret 2;
    }
    var alloc: A.Allocator;
    if (O.is_some[str](arena.make(?alloc, ?ar))) {
        arena.dnit(?ar);
        print.eprint("error: failed to initialise allocator\n");
        ret 2;
    }

    var arg: *u8 = nil;
    if (parsed.has_project) { arg = argv[parsed.project_idx]; }

    val loc_r: R.Result[util.ProjectLocation, str] = util.resolve_project_location(?alloc, arg);
    if (R.is_err[util.ProjectLocation, str](loc_r)) {
        print.eprint("error: ");
        print.eprint(R.unwrap_err[util.ProjectLocation, str](loc_r));
        print.eprint("\n");
        arena.dnit(?ar);
        ret 1;
    }
    val loc: util.ProjectLocation = R.unwrap_ok[util.ProjectLocation, str](loc_r);
    val root: str = loc.root;

    val res_session: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](res_session)) {
        print.eprint("error: failed to initialise compiler session\n");
        arena.dnit(?ar);
        ret 2;
    }
    var s: session.Session = R.unwrap_ok[session.Session, str](res_session);

    val res_register: R.Result[R.Void, str] = driver.setup_registry(?s.registry);
    if (R.is_err[R.Void, str](res_register)) {
        print.eprint("error: failed to register targets\n");
        session.dnit(?s);
        arena.dnit(?ar);
        ret 2;
    }

    val res_project: R.Result[driver.Project, outcome.Fail] = driver.build_project(?s, root, ?sel);
    if (diagnostic.len(?s.diags) > 0) {
        var err_w: writer.Writer = fs.writer(fs.STDERR);
        cli_diag.flush(?err_w, ?s, ?s.diags);
    }
    if (R.is_err[driver.Project, outcome.Fail](res_project)) {
        var f: outcome.Fail = R.unwrap_err[driver.Project, outcome.Fail](res_project);
        val code: i64 = cli_diag.render_fail(?f);
        session.dnit(?s);
        arena.dnit(?ar);
        ret code;
    }
    var p: driver.Project = R.unwrap_ok[driver.Project, outcome.Fail](res_project);

    var leaf: str = "doc/api";
    if (parsed.has_out) { leaf = argv[parsed.out_idx]::str; }
    var api_r: R.Result[str, str] = path.join(?alloc, root, leaf);
    if (path.is_abs(leaf)) { api_r = path.clone(?alloc, leaf); }
    if (R.is_err[str, str](api_r)) {
        print.eprint("error: out of memory\n");
        session.dnit(?s);
        arena.dnit(?ar);
        ret 2;
    }
    val api_dir: str = R.unwrap_ok[str, str](api_r);

    var stats: DocStats;
    stats.modules = 0;
    stats.entries = 0;

    val code: i64 = generate(?alloc, ?p, api_dir, ?stats);

    if (code == 0 && !parsed.quiet) {
        print.print("documented ");
        print.u64(stats.entries::u64);
        print.print(" public entities across ");
        print.u64(stats.modules::u64);
        print.print(" modules -> ");
        print.print(api_dir);
        print.print("\n");
    }

    driver.dnit_project(?p);
    session.dnit(?s);
    arena.dnit(?ar);
    ret code;
}

rec Sink {
    buf: *u8;
    cap: usize;
    len: usize;
}

fun sink_write(ctx: ptr, buf: *u8, len: usize) R.Result[usize, str] {
    val sk: *Sink = ctx::*Sink;
    var i: usize = 0;
    for (i < len && sk.len < sk.cap) {
        sk.buf[sk.len] = buf[i];
        sk.len = sk.len + 1;
        i = i + 1;
    }
    ret R.ok[usize, str](len);
}

fun t_doc_span(s: str) token.Span {
    var sp: token.Span;
    sp.offset = 0;
    sp.len    = string.str_len(s);
    ret sp;
}

fun t_render_eq(source: str, doc: token.Span, expect: str) bool {
    var buf: [512]u8;
    var sk:  Sink;
    sk.buf = ?buf[0];
    sk.cap = 512;
    sk.len = 0;

    val ctx: *Sink = ?sk;
    var w: writer.Writer;
    w.ctx      = ctx::ptr;
    w.f_write = sink_write;

    write_doc(?w, source, doc);

    if (sk.len != string.str_len(expect)) { ret false; }
    val e: *u8 = expect::*u8;
    var i: usize = 0;
    for (i < sk.len) {
        if (buf[i] != e[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun t_at(source: str, off: usize, lit: str) bool {
    ret string.str_region_equals(source, off, string.str_len(lit), lit);
}

test "mach.cli.cmd.doc.write_doc:summary_then_components" {
    val source: str = "# sum two integers\n# ---\n# a: first addend\n# b: second addend\n# ret: the sum";
    if (!t_render_eq(source, t_doc_span(source),
        "sum two integers\n\na: first addend\nb: second addend\nret: the sum\n\n")) { ret 1; }
    ret 0;
}

test "mach.cli.cmd.doc.write_doc:summary_only" {
    val source: str = "# yield the CPU to other threads";
    if (!t_render_eq(source, t_doc_span(source), "yield the CPU to other threads\n\n")) { ret 1; }
    ret 0;
}

test "mach.cli.cmd.doc.write_doc:empty_span" {
    var doc: token.Span;
    doc.offset = 0;
    doc.len    = 0;
    if (!t_render_eq("", doc, "")) { ret 1; }
    ret 0;
}

test "mach.cli.cmd.doc.write_doc:wrapped_component" {
    val source: str = "# wrapped\n# ---\n# a: long line\n#    wraps here\n# b: short";
    if (!t_render_eq(source, t_doc_span(source),
        "wrapped\n\na: long line\n   wraps here\nb: short\n\n")) { ret 1; }
    ret 0;
}

test "mach.cli.cmd.doc.skip_decorators" {
    val own: str = "#[symbol(\"_start\")]\npub fun entry() i64 { ret 0; }";
    if (!t_at(own, skip_decorators(own::*u8, 0), "pub fun")) { ret 1; }

    val inl: str = "#[inline] pub fun g() {}";
    if (!t_at(inl, skip_decorators(inl::*u8, 0), "pub fun")) { ret 1; }

    val many: str = "#[a] #[b(1)]\nrec R { x: u8; }";
    if (!t_at(many, skip_decorators(many::*u8, 0), "rec R")) { ret 1; }

    val none: str = "pub val X: i64 = 0;";
    if (skip_decorators(none::*u8, 0) != 0) { ret 1; }
    ret 0;
}

fun t_scratch_project(alloc: *A.Allocator, root_buf: *u8) bool {
    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(alloc, "mach_doc_test");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret false; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);
    val tp:   *u8   = fs.temp_path(?tf)::*u8;
    val tlen: usize = str_len(tp);
    val fits: bool  = tlen + 1 <= 4096;
    if (fits) {
        var j: usize = 0;
        for (j < tlen) { root_buf[j] = tp[j]; j = j + 1; }
        root_buf[tlen] = 0;
    }
    fs.temp_close_and_remove(?tf);
    if (!fits) { ret false; }

    val root: str = root_buf::str;
    val src_dir: str = t_join(alloc, root, "src");
    if (O.is_some[str](fs.create_dir_all(alloc, root, 493)))    { ret false; }
    if (O.is_some[str](fs.create_dir_all(alloc, src_dir, 493))) { ret false; }

    val manifest_text: str = "[project]\nid = \"doctest\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.linux]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[profile.debug]\nopt = 0\ndebug = false\nsimd = \"scalarize\"\n\n[artifact.doctest]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/doctest\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
    val main_text: str = "fun main() i32 { ret 0; }\n";
    val mf: str = t_join(alloc, root, util.PROJECT_CONFIG_NAME);
    val mn: str = t_join(alloc, src_dir, "main.mach");
    if (O.is_some[str](fs.write_bytes(mf, manifest_text::*u8, str_len(manifest_text::*u8), 420))) { ret false; }
    if (O.is_some[str](fs.write_bytes(mn, main_text::*u8, str_len(main_text::*u8), 420)))         { ret false; }
    ret true;
}

test "mach.cli.cmd.doc.run_typed:unknown_flag_is_rejected_but_the_same_project_alone_succeeds" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    var root: [4096]u8;
    if (!t_scratch_project(?alloc, ?root[0])) { fs.remove_all(?alloc, ?root[0]); ret 1; }

    var av_ok: [3]*u8;
    av_ok[0] = "mach"::*u8; av_ok[1] = "doc"::*u8; av_ok[2] = ?root[0];
    var a_ok: A.Allocator;
    if (O.is_some[str](page.make(?a_ok))) { fs.remove_all(?alloc, ?root[0]); ret 1; }
    val ir_ok: R.Result[args.ParsedInvocation, str] = args.parse_invocation(?a_ok, 3, ?av_ok[0]);
    if (R.is_err[args.ParsedInvocation, str](ir_ok)) { fs.remove_all(?alloc, ?root[0]); ret 1; }
    var inv_ok: args.ParsedInvocation = R.unwrap_ok[args.ParsedInvocation, str](ir_ok);
    val rc_ok: i64 = run_typed(?av_ok[0], ?inv_ok);
    if (rc_ok != 0) { fs.remove_all(?alloc, ?root[0]); ret 1; }

    var av_bad: [4]*u8;
    av_bad[0] = "mach"::*u8; av_bad[1] = "doc"::*u8; av_bad[2] = ?root[0]; av_bad[3] = "--bogus"::*u8;
    var a_bad: A.Allocator;
    if (O.is_some[str](page.make(?a_bad))) { fs.remove_all(?alloc, ?root[0]); ret 1; }
    val ir_bad: R.Result[args.ParsedInvocation, str] = args.parse_invocation(?a_bad, 4, ?av_bad[0]);
    if (R.is_err[args.ParsedInvocation, str](ir_bad)) { fs.remove_all(?alloc, ?root[0]); ret 1; }
    var inv_bad: args.ParsedInvocation = R.unwrap_ok[args.ParsedInvocation, str](ir_bad);
    val rc_bad: i64 = run_typed(?av_bad[0], ?inv_bad);

    fs.remove_all(?alloc, ?root[0]);
    if (rc_bad != 1) { ret 1; }
    ret 0;
}

fun t_doc_run(argc: usize, argv: **u8) i64 {
    var a: A.Allocator;
    if (O.is_some[str](page.make(?a))) { ret 2; }
    val ir: R.Result[args.ParsedInvocation, str] = args.parse_invocation(?a, argc, argv);
    if (R.is_err[args.ParsedInvocation, str](ir)) { ret 2; }
    var inv: args.ParsedInvocation = R.unwrap_ok[args.ParsedInvocation, str](ir);
    ret run_typed(argv, ?inv);
}

fun t_scratch_two_artifacts(alloc: *A.Allocator, root_buf: *u8) bool {
    if (!t_scratch_project(alloc, root_buf)) { ret false; }
    val root: str = root_buf::str;
    val manifest_text: str = "[project]\nid = \"doctest\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.linux]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[target.windows]\nisa = \"x86_64\"\nos = \"windows\"\nabi = \"win64\"\n\n[profile.debug]\nopt = 0\ndebug = false\nsimd = \"scalarize\"\n\n[artifact.a]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/a\"\ntargets = [\"linux\"]\nlink = []\nneed = []\n\n[artifact.b]\nkind = \"bin\"\nentry = \"win.mach\"\nout = \"bin/b.exe\"\ntargets = [\"windows\"]\nlink = []\nneed = []\n";
    val win_text: str = "fun main() i32 { ret 1; }\n";
    val mf: str = t_join(alloc, root, util.PROJECT_CONFIG_NAME);
    val wn: str = t_join(alloc, t_join(alloc, root, "src"), "win.mach");
    if (O.is_some[str](fs.write_bytes(mf, manifest_text::*u8, str_len(manifest_text::*u8), 420))) { ret false; }
    if (O.is_some[str](fs.write_bytes(wn, win_text::*u8, str_len(win_text::*u8), 420)))           { ret false; }
    ret true;
}

test "mach.cli.cmd.doc.run_typed:selects_the_artifact_for_the_target_like_build_and_takes_bin_and_lib" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    var root: [4096]u8;
    if (!t_scratch_two_artifacts(?alloc, ?root[0])) { fs.remove_all(?alloc, ?root[0]); ret 1; }
    var bad: i32 = 0;

    var av: [9]*u8;
    av[0] = "mach"::*u8; av[1] = "doc"::*u8; av[2] = ?root[0]; av[3] = "--quiet"::*u8;

    av[4] = "--target"::*u8; av[5] = "linux"::*u8;
    if (t_doc_run(6, ?av[0]) != 0) { bad = 1; }
    av[5] = "windows"::*u8;
    if (t_doc_run(6, ?av[0]) != 0) { bad = 2; }

    av[4] = "--bin"::*u8; av[5] = "b"::*u8; av[6] = "--target"::*u8; av[7] = "windows"::*u8;
    if (t_doc_run(8, ?av[0]) != 0) { bad = 3; }
    av[5] = "a"::*u8;
    if (t_doc_run(8, ?av[0]) != 1) { bad = 4; }
    av[5] = "nonesuch"::*u8;
    if (t_doc_run(8, ?av[0]) != 1) { bad = 5; }

    av[4] = "--bin"::*u8; av[5] = "a"::*u8; av[6] = "--lib"::*u8; av[7] = "a"::*u8;
    if (t_doc_run(8, ?av[0]) != 1) { bad = 6; }

    fs.remove_all(?alloc, ?root[0]);
    ret bad;
}

test "mach.cli.cmd.doc.build_project:the_first_declared_fallback_records_the_deprecation_warning" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    var root: [4096]u8;
    if (!t_scratch_project(?alloc, ?root[0])) { fs.remove_all(?alloc, ?root[0]); ret 1; }
    val manifest_text: str = "[project]\nid = \"doctest\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.linux]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[profile.debug]\nopt = 0\ndebug = false\nsimd = \"scalarize\"\n\n[artifact.first]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/first\"\ntargets = [\"*\"]\nlink = []\nneed = []\n\n[artifact.second]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/second\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
    val mf: str = t_join(?alloc, ?root[0], util.PROJECT_CONFIG_NAME);
    if (O.is_some[str](fs.write_bytes(mf, manifest_text::*u8, str_len(manifest_text::*u8), 420))) { fs.remove_all(?alloc, ?root[0]); ret 1; }

    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { fs.remove_all(?alloc, ?root[0]); ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    if (R.is_err[R.Void, str](driver.setup_registry(?s.registry))) {
        session.dnit(?s); fs.remove_all(?alloc, ?root[0]); ret 1;
    }
    var sel: manifest.Selection;
    sel.target = "linux"; sel.profile = ""; sel.artifact = ""; sel.want_lib = false; sel.has_artifact = false; sel.legacy_default = false;
    val pr: R.Result[driver.Project, outcome.Fail] = driver.build_project(?s, ?root[0], ?sel);
    var bad: i32 = 0;
    if (R.is_err[driver.Project, outcome.Fail](pr)) { bad = 1; }
    or {
        var p: driver.Project = R.unwrap_ok[driver.Project, outcome.Fail](pr);
        var seen: bool = false;
        var i: usize = 0;
        for (i < diagnostic.len(?s.diags)) {
            val d: *diagnostic.Diagnostic = ?s.diags.items.data[i];
            if (d.severity == diagnostic.SEVERITY_WARNING
                && str_contains(d.message, "several artifacts are declared and none is marked `default = true`")) { seen = true; }
            i = i + 1;
        }
        if (!seen) { bad = 2; }
        driver.dnit_project(?p);
    }
    session.dnit(?s);
    fs.remove_all(?alloc, ?root[0]);
    ret bad;
}

test "mach.cli.cmd.doc.run_typed:a_relative_out_is_project_rooted_and_an_absolute_out_is_used_as_given" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    var root: [4096]u8;
    if (!t_scratch_project(?alloc, ?root[0])) { fs.remove_all(?alloc, ?root[0]); ret 1; }
    var elsewhere: [4096]u8;
    if (!t_scratch_project(?alloc, ?elsewhere[0])) { fs.remove_all(?alloc, ?root[0]); fs.remove_all(?alloc, ?elsewhere[0]); ret 1; }
    var bad: i32 = 0;

    var av: [6]*u8;
    av[0] = "mach"::*u8; av[1] = "doc"::*u8; av[2] = ?root[0]; av[3] = "--quiet"::*u8; av[4] = "--out"::*u8; av[5] = "pages"::*u8;
    if (t_doc_run(6, ?av[0]) != 0) { bad = 1; }
    if (!fs.exists(t_join(?alloc, t_join(?alloc, ?root[0], "pages"), "README.md"))) { bad = 2; }

    val abs_out: str = t_join(?alloc, ?elsewhere[0], "api");
    av[5] = abs_out::*u8;
    if (t_doc_run(6, ?av[0]) != 0) { bad = 3; }
    if (!fs.exists(t_join(?alloc, abs_out, "README.md"))) { bad = 4; }
    if (fs.exists(t_join(?alloc, ?root[0], abs_out))) { bad = 5; }

    fs.remove_all(?alloc, ?root[0]);
    fs.remove_all(?alloc, ?elsewhere[0]);
    ret bad;
}

test "mach.cli.cmd.doc.generate:creates_missing_output_dirs" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "mach_doc_test");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);
    var root: [4096]u8;
    val tp:   *u8   = fs.temp_path(?tf)::*u8;
    val tlen: usize = str_len(tp);
    val fits: bool  = tlen + 1 <= 4096;
    if (fits) {
        var j: usize = 0;
        for (j < tlen) { root[j] = tp[j]; j = j + 1; }
        root[tlen] = 0;
    }
    fs.temp_close_and_remove(?tf);
    if (!fits) { ret 1; }

    var bad: i32 = 0;
    val src_dir: str = t_join(?alloc, ?root[0], "src");
    if (O.is_some[str](fs.create_dir_all(?alloc, ?root[0], 493))) { bad = 1; }
    if (O.is_some[str](fs.create_dir_all(?alloc, src_dir, 493)))                 { bad = 1; }

    val manifest_text: str = "[project]\nid = \"doctest\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.linux]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[profile.debug]\nopt = 0\ndebug = false\nsimd = \"scalarize\"\n\n[artifact.doctest]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/doctest\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
    val main_text: str = "fun main() i32 { ret 0; }\n\n# a documented helper\npub fun answer() i32 { ret 42; }\n";
    val mf: str = t_join(?alloc, ?root[0], util.PROJECT_CONFIG_NAME);
    val mn: str = t_join(?alloc, src_dir, "main.mach");
    if (O.is_some[str](fs.write_bytes(mf, manifest_text::*u8, str_len(manifest_text::*u8), 420))) { bad = 1; }
    if (O.is_some[str](fs.write_bytes(mn, main_text::*u8, str_len(main_text::*u8), 420)))         { bad = 1; }

    if (bad != 0) { fs.remove_all(?alloc, ?root[0]); ret 1; }

    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { fs.remove_all(?alloc, ?root[0]); ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    if (R.is_err[R.Void, str](driver.setup_registry(?s.registry))) {
        session.dnit(?s); fs.remove_all(?alloc, ?root[0]); ret 1;
    }

    var sel: manifest.Selection;
    sel.target = "linux"; sel.profile = ""; sel.artifact = ""; sel.want_lib = false; sel.has_artifact = false; sel.legacy_default = false;
    val pr: R.Result[driver.Project, outcome.Fail] = driver.build_project(?s, ?root[0], ?sel);
    if (R.is_err[driver.Project, outcome.Fail](pr)) {
        session.dnit(?s); fs.remove_all(?alloc, ?root[0]); ret 1;
    }
    var p: driver.Project = R.unwrap_ok[driver.Project, outcome.Fail](pr);

    val api_dir: str = t_join(?alloc, (?root[0])::str, "doc/api");

    var stats: DocStats;
    stats.modules = 0;
    stats.entries = 0;
    if (generate(?alloc, ?p, api_dir, ?stats) != 0) { bad = 1; }
    if (!fs.is_dir(api_dir)) { bad = 1; }

    val readme: str = t_join(?alloc, api_dir, "README.md");
    if (!fs.is_file(readme)) { bad = 1; }

    # the index is published whole, so existence is not the property: a
    # truncated or empty index is exactly what a partial write would leave
    val idx_r: R.Result[str, str] = fs.read_string(?alloc, readme);
    if (R.is_err[str, str](idx_r)) { bad = 1; }
    or {
        val idx: str = R.unwrap_ok[str, str](idx_r);
        if (!str_contains(idx, "# API reference"))          { bad = 1; }
        if (!str_contains(idx, "- [doctest.main](doctest/main.md)")) { bad = 1; }
    }

    # and the page it links to holds the declaration it was generated for
    val pagep: str = t_join(?alloc, api_dir, "doctest/main.md");
    val page_r: R.Result[str, str] = fs.read_string(?alloc, pagep);
    if (R.is_err[str, str](page_r)) { bad = 1; }
    or {
        val pg: str = R.unwrap_ok[str, str](page_r);
        if (!str_contains(pg, "# doctest.main"))            { bad = 1; }
        if (!str_contains(pg, "a documented helper"))       { bad = 1; }
    }

    driver.dnit_project(?p);
    session.dnit(?s);
    fs.remove_all(?alloc, ?root[0]);
    ret bad;
}

fun t_join(a: *A.Allocator, base: str, leaf: str) str {
    val r: R.Result[str, str] = path.join(a, base, leaf);
    if (R.is_err[str, str](r)) { ret base; }
    ret R.unwrap_ok[str, str](r);
}

fun t_failing_write(ctx: ptr, buf: *u8, len: usize) R.Result[usize, str] {
    ret R.err[usize, str]("injected write failure");
}

fun t_failing_writer() writer.Writer {
    var w: writer.Writer;
    w.ctx     = nil;
    w.f_write = t_failing_write;
    ret w;
}

fun t_always_fails(ctx: *PageCtx, w: *writer.Writer) R.Result[R.Void, str] {
    ret R.err[R.Void, str]("injected page failure");
}

# a write that fails deep in the page walk is not silently dropped: `wr` cannot
# report it, so the sink latches it and the callback reports it once
test "mach.cli.cmd.doc.write_page:a_failed_write_fails_the_callback" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }

    var empty: ast.Ast = ast.init(?alloc, 0::src.FileId);
    var failing: writer.Writer = t_failing_writer();

    var ctx: PageCtx;
    ctx.a          = ?empty;
    ctx.source     = "";
    ctx.fqn        = "m"::*u8;
    ctx.documented = 0;

    val r: R.Result[R.Void, str] = write_page(?ctx, ?failing);
    if (R.is_ok[R.Void, str](r)) { ret 1; }
    ret 0;
}

# and a callback that reports a failure publishes nothing: the transaction
# aborts, so the destination keeps whatever it held before
test "mach.cli.cmd.doc.publish_page:a_failed_callback_leaves_the_destination_alone" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "mach_doc_publish");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);
    val dir: str = t_join(?alloc, fs.temp_path(?tf), "");
    fs.temp_close_and_remove(?tf);
    if (O.is_some[str](fs.create_dir_all(?alloc, dir, 493))) { ret 1; }

    var bad: i32 = 0;

    # an existing page the failed publication must not disturb
    val kept: str = t_join(?alloc, dir, "kept.md");
    val prior: str = "# previous\n";
    if (O.is_some[str](fs.write_bytes(kept, prior::*u8, str_len(prior), 420))) { bad = 1; }

    var empty: ast.Ast = ast.init(?alloc, 0::src.FileId);
    var ctx: PageCtx;
    ctx.a          = ?empty;
    ctx.source     = "";
    ctx.fqn        = "m"::*u8;
    ctx.documented = 0;

    if (bad == 0 && publish_page[PageCtx](?alloc, kept, ?ctx, t_always_fails)) { bad = 2; }

    # the previous content is still there, whole
    if (bad == 0) {
        val back_r: R.Result[str, str] = fs.read_string(?alloc, kept);
        if (R.is_err[str, str](back_r)) { bad = 3; }
        or (!str_equals(R.unwrap_ok[str, str](back_r), prior)) { bad = 4; }
    }

    # a destination that did not exist stays absent rather than appearing empty
    if (bad == 0) {
        val fresh: str = t_join(?alloc, dir, "fresh.md");
        if (publish_page[PageCtx](?alloc, fresh, ?ctx, t_always_fails)) { bad = 5; }
        or (fs.exists(fresh)) { bad = 6; }
    }

    fs.remove_all(?alloc, dir);
    ret bad;
}
