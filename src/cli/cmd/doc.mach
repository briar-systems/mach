    ret 0;
}

test "mach.cli.cmd.doc.write_signature:fun_cuts_brace" {
    val source: str = "pub fun answer() i32 { ret 42; }";
    val expect: str = "```mach\npub fun answer() i32;\n```\n\n";
    if (!t_sig_eq(source, expect, false)) { ret 1; }
    ret 0;
}

fun t_scratch_project(alloc: *A.Allocator, root_buf: *u8) bool {
    val tf_r: res[fs.TempFile, fs.FsError] = fs.temp_create(alloc, "mach_doc_test");
    if (sel tf_r.err) { ret false; }
    var tf: fs.TempFile = tf_r.ok;
    val tp:   *u8   = fs.temp_path(?tf)::*u8;
    val tlen: usize = str_len(tp);
    val fits: bool  = tlen + 1 <= 4096;
    if (fits) {
        var j: usize = 0;
        for (j < tlen) { root_buf[j] = tp[j]; j = j + 1; }
        root_buf[tlen] = 0;
    }
    fs.temp_close_and_remove(?tf);
    if (!fits) { ret false; }

    val root: str = root_buf::str;
    val src_dir: str = t_join(alloc, root, "src");
    val create_dir_all_r: err[fs.FsError] = fs.create_dir_all(alloc, root, 493);
    if (sel create_dir_all_r.err)    { ret false; }
    val create_dir_all_r2: err[fs.FsError] = fs.create_dir_all(alloc, src_dir, 493);
    if (sel create_dir_all_r2.err) { ret false; }

    val manifest_text: str = "[project]\nid = \"doctest\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.linux]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[profile.debug]\nopt = 0\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n\n[artifact.doctest]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/doctest\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
    val main_text: str = "fun main() i32 { ret 0; }\n";
    val mf: str = t_join(alloc, root, util.PROJECT_CONFIG_NAME);
    val mn: str = t_join(alloc, src_dir, "main.mach");
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(mf, manifest_text::*u8, str_len(manifest_text::*u8), 420);
    if (sel write_bytes_r.err) { ret false; }
    val write_bytes_r2: err[fs.FsError] = fs.write_bytes(mn, main_text::*u8, str_len(main_text::*u8), 420);
    if (sel write_bytes_r2.err)         { ret false; }
    ret true;
}

test "mach.cli.cmd.doc.run:unknown_flag_is_rejected_but_the_same_project_alone_succeeds" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var root: [4096]u8;
    if (!t_scratch_project(?alloc, ?root[0])) { fs.remove_all(?alloc, ?root[0]); ret 1; }

    var av_ok: [3]*u8;
    av_ok[0] = "mach"::*u8; av_ok[1] = "doc"::*u8; av_ok[2] = ?root[0];
    var a_ok: A.Allocator;
    val make_r2: err[A.Error] = page.make(?a_ok);
    if (sel make_r2.err) { fs.remove_all(?alloc, ?root[0]); ret 1; }
    val ir_ok: res[args.ParsedInvocation, outcome.Fail] = args.parse_invocation(?a_ok, 3, ?av_ok[0]);
    if (sel ir_ok.err) { fs.remove_all(?alloc, ?root[0]); ret 1; }
    var inv_ok: args.ParsedInvocation = ir_ok.ok;
    val rc_ok: i64 = run(?av_ok[0], ?inv_ok);
    if (rc_ok != 0) { fs.remove_all(?alloc, ?root[0]); ret 1; }

    var av_bad: [4]*u8;
    av_bad[0] = "mach"::*u8; av_bad[1] = "doc"::*u8; av_bad[2] = ?root[0]; av_bad[3] = "--bogus"::*u8;
    var a_bad: A.Allocator;
    val make_r3: err[A.Error] = page.make(?a_bad);
    if (sel make_r3.err) { fs.remove_all(?alloc, ?root[0]); ret 1; }
    val ir_bad: res[args.ParsedInvocation, outcome.Fail] = args.parse_invocation(?a_bad, 4, ?av_bad[0]);
    if (sel ir_bad.err) { fs.remove_all(?alloc, ?root[0]); ret 1; }
    var inv_bad: args.ParsedInvocation = ir_bad.ok;
    val rc_bad: i64 = run(?av_bad[0], ?inv_bad);

    fs.remove_all(?alloc, ?root[0]);
    if (rc_bad != 1) { ret 1; }
    ret 0;
}

fun t_doc_run(argc: usize, argv: **u8) i64 {
    var a: A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 2; }
    val ir: res[args.ParsedInvocation, outcome.Fail] = args.parse_invocation(?a, argc, argv);
    if (sel ir.err) { ret 2; }
    var inv: args.ParsedInvocation = ir.ok;
    ret run(argv, ?inv);
}

fun t_scratch_two_artifacts(alloc: *A.Allocator, root_buf: *u8) bool {
    if (!t_scratch_project(alloc, root_buf)) { ret false; }
    val root: str = root_buf::str;
    val manifest_text: str = "[project]\nid = \"doctest\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.linux]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[target.windows]\nisa = \"x86_64\"\nos = \"windows\"\nabi = \"win64\"\n\n[profile.debug]\nopt = 0\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n\n[artifact.a]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/a\"\ntargets = [\"linux\"]\nlink = []\nneed = []\n\n[artifact.b]\nkind = \"bin\"\nentry = \"win.mach\"\nout = \"bin/b.exe\"\ntargets = [\"windows\"]\nlink = []\nneed = []\n";
    val win_text: str = "fun main() i32 { ret 1; }\n";
    val mf: str = t_join(alloc, root, util.PROJECT_CONFIG_NAME);
    val wn: str = t_join(alloc, t_join(alloc, root, "src"), "win.mach");
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(mf, manifest_text::*u8, str_len(manifest_text::*u8), 420);
    if (sel write_bytes_r.err) { ret false; }
    val write_bytes_r2: err[fs.FsError] = fs.write_bytes(wn, win_text::*u8, str_len(win_text::*u8), 420);
    if (sel write_bytes_r2.err)           { ret false; }
    ret true;
}

test "mach.cli.cmd.doc.run:selects_the_artifact_for_the_target_like_build_and_takes_bin_and_lib" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var root: [4096]u8;
    if (!t_scratch_two_artifacts(?alloc, ?root[0])) { fs.remove_all(?alloc, ?root[0]); ret 1; }
    var bad: i32 = 0;

    var av: [9]*u8;
    av[0] = "mach"::*u8; av[1] = "doc"::*u8; av[2] = ?root[0]; av[3] = "--quiet"::*u8;

    av[4] = "--target"::*u8; av[5] = "linux"::*u8;
    if (t_doc_run(6, ?av[0]) != 0) { bad = 1; }
    av[5] = "windows"::*u8;
    if (t_doc_run(6, ?av[0]) != 0) { bad = 2; }

    av[4] = "--bin"::*u8; av[5] = "b"::*u8; av[6] = "--target"::*u8; av[7] = "windows"::*u8;
    if (t_doc_run(8, ?av[0]) != 0) { bad = 3; }
    av[5] = "a"::*u8;
    if (t_doc_run(8, ?av[0]) != 1) { bad = 4; }
    av[5] = "nonesuch"::*u8;
    if (t_doc_run(8, ?av[0]) != 1) { bad = 5; }

    av[4] = "--bin"::*u8; av[5] = "a"::*u8; av[6] = "--lib"::*u8; av[7] = "a"::*u8;
    if (t_doc_run(8, ?av[0]) != 1) { bad = 6; }

    fs.remove_all(?alloc, ?root[0]);
    ret bad;
}

test "mach.cli.cmd.doc.build_project:the_first_declared_fallback_records_the_deprecation_warning" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var root: [4096]u8;
    if (!t_scratch_project(?alloc, ?root[0])) { fs.remove_all(?alloc, ?root[0]); ret 1; }
    val manifest_text: str = "[project]\nid = \"doctest\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.linux]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[profile.debug]\nopt = 0\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n\n[artifact.first]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/first\"\ntargets = [\"*\"]\nlink = []\nneed = []\n\n[artifact.second]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/second\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
    val mf: str = t_join(?alloc, ?root[0], util.PROJECT_CONFIG_NAME);
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(mf, manifest_text::*u8, str_len(manifest_text::*u8), 420);
    if (sel write_bytes_r.err) { fs.remove_all(?alloc, ?root[0]); ret 1; }

    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { fs.remove_all(?alloc, ?root[0]); ret 1; }
    var s: session.Session = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(?s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s); fs.remove_all(?alloc, ?root[0]); ret 1;
    }
    var pick: manifest.Selection;
    pick.target = "linux"; pick.profile = ""; pick.artifact = ""; pick.want_lib = false; pick.has_artifact = false; pick.legacy_default = false;
    val pr: res[driver.Project, outcome.Fail] = driver.build_project(?s, ?root[0], ?pick);
    var bad: i32 = 0;
    if (sel pr.err) { bad = 1; }
    if (sel pr.ok) {
        var p: driver.Project = pr.ok;
        var seen: bool = false;
        var i: usize = 0;
        for (i < diagnostic.len(?s.diags)) {
            val d: *diagnostic.Diagnostic = ?s.diags.items.data[i];
            if (d.severity == diagnostic.SEVERITY_WARNING
                && str_contains(d.message, "several artifacts are declared and none is marked `default = true`")) { seen = true; }
            i = i + 1;
        }
        if (!seen) { bad = 2; }
        driver.dnit_project(?p);
    }
    session.dnit(?s);
    fs.remove_all(?alloc, ?root[0]);
    ret bad;
}

test "mach.cli.cmd.doc.run:a_relative_out_is_project_rooted_and_an_absolute_out_is_used_as_given" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var root: [4096]u8;
    if (!t_scratch_project(?alloc, ?root[0])) { fs.remove_all(?alloc, ?root[0]); ret 1; }
    var elsewhere: [4096]u8;
    if (!t_scratch_project(?alloc, ?elsewhere[0])) { fs.remove_all(?alloc, ?root[0]); fs.remove_all(?alloc, ?elsewhere[0]); ret 1; }
    var bad: i32 = 0;

    var av: [6]*u8;
    av[0] = "mach"::*u8; av[1] = "doc"::*u8; av[2] = ?root[0]; av[3] = "--quiet"::*u8; av[4] = "--out"::*u8; av[5] = "pages"::*u8;
    if (t_doc_run(6, ?av[0]) != 0) { bad = 1; }
    val exists_r: res[bool, io_error.Error] = fs.exists(t_join(?alloc, t_join(?alloc, ?root[0], "pages"), "README.md"));
    if (sel exists_r.err) { ret 99; }
    if (!(sel exists_r.ok && exists_r.ok)) { bad = 2; }

    val abs_out: str = t_join(?alloc, ?elsewhere[0], "api");
    av[5] = abs_out::*u8;
    if (t_doc_run(6, ?av[0]) != 0) { bad = 3; }
    val exists_r2: res[bool, io_error.Error] = fs.exists(t_join(?alloc, abs_out, "README.md"));
    if (sel exists_r2.err) { ret 99; }
    if (!(sel exists_r2.ok && exists_r2.ok)) { bad = 4; }
    val exists_r3: res[bool, io_error.Error] = fs.exists(t_join(?alloc, ?root[0], abs_out));
    if (sel exists_r3.err) { ret 99; }
    if ((sel exists_r3.ok && exists_r3.ok)) { bad = 5; }

    fs.remove_all(?alloc, ?root[0]);
    fs.remove_all(?alloc, ?elsewhere[0]);
    ret bad;
}

test "mach.cli.cmd.doc.generate:creates_missing_output_dirs" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }

    val tf_r: res[fs.TempFile, fs.FsError] = fs.temp_create(?alloc, "mach_doc_test");
    if (sel tf_r.err) { ret 1; }
    var tf: fs.TempFile = tf_r.ok;
    var root: [4096]u8;
    val tp:   *u8   = fs.temp_path(?tf)::*u8;
    val tlen: usize = str_len(tp);
    val fits: bool  = tlen + 1 <= 4096;
    if (fits) {
        var j: usize = 0;
        for (j < tlen) { root[j] = tp[j]; j = j + 1; }
        root[tlen] = 0;
    }
    fs.temp_close_and_remove(?tf);
    if (!fits) { ret 1; }

    var bad: i32 = 0;
    val src_dir: str = t_join(?alloc, ?root[0], "src");
    val create_dir_all_r: err[fs.FsError] = fs.create_dir_all(?alloc, ?root[0], 493);
    if (sel create_dir_all_r.err) { bad = 1; }
    val create_dir_all_r2: err[fs.FsError] = fs.create_dir_all(?alloc, src_dir, 493);
    if (sel create_dir_all_r2.err)                 { bad = 1; }

    val manifest_text: str = "[project]\nid = \"doctest\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.linux]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[profile.debug]\nopt = 0\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n\n[artifact.doctest]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/doctest\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
    val main_text: str = "fun main() i32 { ret 0; }\n\n# a documented helper\npub fun answer() i32 { ret 42; }\n";
    val mf: str = t_join(?alloc, ?root[0], util.PROJECT_CONFIG_NAME);
    val mn: str = t_join(?alloc, src_dir, "main.mach");
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(mf, manifest_text::*u8, str_len(manifest_text::*u8), 420);
    if (sel write_bytes_r.err) { bad = 1; }
    val write_bytes_r2: err[fs.FsError] = fs.write_bytes(mn, main_text::*u8, str_len(main_text::*u8), 420);
    if (sel write_bytes_r2.err)         { bad = 1; }

    if (bad != 0) { fs.remove_all(?alloc, ?root[0]); ret 1; }

    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { fs.remove_all(?alloc, ?root[0]); ret 1; }
    var s: session.Session = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(?s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s); fs.remove_all(?alloc, ?root[0]); ret 1;
    }

    var pick: manifest.Selection;
    pick.target = "linux"; pick.profile = ""; pick.artifact = ""; pick.want_lib = false; pick.has_artifact = false; pick.legacy_default = false;
    val pr: res[driver.Project, outcome.Fail] = driver.build_project(?s, ?root[0], ?pick);
    if (sel pr.err) {
        session.dnit(?s); fs.remove_all(?alloc, ?root[0]); ret 1;
    }
    var p: driver.Project = pr.ok;

    val api_dir: str = t_join(?alloc, (?root[0])::str, "doc/api");

    var stats: DocStats;
    stats.modules = 0;
    stats.entries = 0;
    if (generate(?alloc, ?p, api_dir, ?stats) != 0) { bad = 1; }
    val is_dir_r: res[bool, io_error.Error] = fs.is_dir(api_dir);
    if (sel is_dir_r.err) { ret 99; }
    if (!(sel is_dir_r.ok && is_dir_r.ok)) { bad = 1; }

    val readme: str = t_join(?alloc, api_dir, "README.md");
    val is_file_r: res[bool, io_error.Error] = fs.is_file(readme);
    if (sel is_file_r.err) { ret 99; }
    if (!(sel is_file_r.ok && is_file_r.ok)) { bad = 1; }

    # the index is published whole, so existence is not the property: a
    # truncated or empty index is exactly what a partial write would leave
    val idx_r: res[str, fs.FsError] = fs.read_string(?alloc, readme);
    if (sel idx_r.err) { bad = 1; }
    if (sel idx_r.ok) {
        val idx: str = idx_r.ok;
        if (!str_contains(idx, "# API reference"))          { bad = 1; }
        if (!str_contains(idx, "- [doctest.main](doctest/main.md)")) { bad = 1; }
    }

    # and the page it links to holds the declaration it was generated for
    val pagep: str = t_join(?alloc, api_dir, "doctest/main.md");
    val page_r: res[str, fs.FsError] = fs.read_string(?alloc, pagep);
    if (sel page_r.err) { bad = 1; }
    if (sel page_r.ok) {
        val pg: str = page_r.ok;
        if (!str_contains(pg, "# doctest.main"))            { bad = 1; }
        if (!str_contains(pg, "a documented helper"))       { bad = 1; }
    }

    driver.dnit_project(?p);
    session.dnit(?s);
    fs.remove_all(?alloc, ?root[0]);
    ret bad;
}

fun t_join(a: *A.Allocator, base: str, leaf: str) str {
    val r: res[str, A.Error] = path.join(a, base, leaf);
    if (sel r.err) { ret base; }
    ret r.ok;
}

fun t_failing_write(ctx: ptr, buf: *u8, len: usize) res[usize, writer.WriteError] {
    ret res[usize, writer.WriteError].err{writer.native_failure(0, io_error.from_code(os.EIO, io_error.OP_WRITE))};
}

fun t_failing_writer() writer.Writer {
    var w: writer.Writer;
    w.ctx     = nil;
    w.f_write = t_failing_write;
    ret w;
}

fun t_always_fails(ctx: *PageCtx, w: *writer.Writer) err[writer.WriteError] {
    ret err[writer.WriteError].err{writer.WriteError.stalled{0}};
}

# a write that fails deep in the page walk is not silently dropped: `wr` cannot
# report it, so the sink latches it and the callback reports it once
test "mach.cli.cmd.doc.write_page:a_failed_write_fails_the_callback" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }

    var empty: ast.Ast = ast.init(?alloc, 0::src.FileId);
    var failing: writer.Writer = t_failing_writer();

    var ctx: PageCtx;
    ctx.a          = ?empty;
    ctx.source     = "";
    ctx.fqn        = "m"::*u8;
    ctx.documented = 0;

    val r: err[writer.WriteError] = write_page(?ctx, ?failing);
    if (sel r.ok) { ret 1; }
    ret 0;
}

# and a callback that reports a failure publishes nothing: the transaction
# aborts, so the destination keeps whatever it held before
test "mach.cli.cmd.doc.publish_page:a_failed_callback_leaves_the_destination_alone" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }

    val tf_r: res[fs.TempFile, fs.FsError] = fs.temp_create(?alloc, "mach_doc_publish");
    if (sel tf_r.err) { ret 1; }
    var tf: fs.TempFile = tf_r.ok;
    val dir: str = t_join(?alloc, fs.temp_path(?tf), "");
    fs.temp_close_and_remove(?tf);
    val create_dir_all_r: err[fs.FsError] = fs.create_dir_all(?alloc, dir, 493);
    if (sel create_dir_all_r.err) { ret 1; }

    var bad: i32 = 0;

    # an existing page the failed publication must not disturb
    val kept: str = t_join(?alloc, dir, "kept.md");
    val prior: str = "# previous\n";
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(kept, prior::*u8, str_len(prior), 420);
    if (sel write_bytes_r.err) { bad = 1; }

    var empty: ast.Ast = ast.init(?alloc, 0::src.FileId);
    var ctx: PageCtx;
    ctx.a          = ?empty;
    ctx.source     = "";
    ctx.fqn        = "m"::*u8;
    ctx.documented = 0;

    if (bad == 0 && publish_page[PageCtx](?alloc, kept, ?ctx, t_always_fails)) { bad = 2; }

    # the previous content is still there, whole
    if (bad == 0) {
        val back_r: res[str, fs.FsError] = fs.read_string(?alloc, kept);
        if (sel back_r.err) { ret 99; }
        if (!str_equals(back_r.ok, prior)) { bad = 4; }
    }

    # a destination that did not exist stays absent rather than appearing empty
    if (bad == 0) {
        val fresh: str = t_join(?alloc, dir, "fresh.md");
        if (publish_page[PageCtx](?alloc, fresh, ?ctx, t_always_fails)) { bad = 5; }
        or {
            val exists_r: res[bool, io_error.Error] = fs.exists(fresh);
            if (sel exists_r.ok && exists_r.ok) { bad = 6; }
        }
    }

    fs.remove_all(?alloc, dir);
    ret bad;
}

test "mach.cli.cmd.doc.generate:documents_public_generic_tag" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }

    val tf_r: res[fs.TempFile, fs.FsError] = fs.temp_create(?alloc, "mach_doc_test");
    if (sel tf_r.err) { ret 1; }
    var tf: fs.TempFile = tf_r.ok;
    var root: [4096]u8;
    val tp:   *u8   = fs.temp_path(?tf)::*u8;
    val tlen: usize = str_len(tp);
    val fits: bool  = tlen + 1 <= 4096;
    if (fits) {
        var j: usize = 0;
        for (j < tlen) { root[j] = tp[j]; j = j + 1; }
        root[tlen] = 0;
    }
    fs.temp_close_and_remove(?tf);
    if (!fits) { ret 1; }

    var bad: i32 = 0;
    val src_dir: str = t_join(?alloc, ?root[0], "src");
    val create_dir_all_r: err[fs.FsError] = fs.create_dir_all(?alloc, ?root[0], 493);
    if (sel create_dir_all_r.err) { bad = 1; }
    val create_dir_all_r2: err[fs.FsError] = fs.create_dir_all(?alloc, src_dir, 493);
    if (sel create_dir_all_r2.err)  { bad = 1; }

    val manifest_text: str = "[project]\nid = \"doctest\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.linux]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[profile.debug]\nvectorize=true\nfloat_reassoc=false\nopt = 0\ndebug = false\nsimd = \"scalarize\"\n\n[artifact.doctest]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/doctest\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
    val main_text: str = "# optional value container\n# ---\n# [T]: payload element type\n# none: empty alternative\n# some: value alternative\npub tag Option[T]: u8 {\n    none;\n    some: T;\n}\n\nfun main() i32 { ret 0; }\n";
    val mf: str = t_join(?alloc, ?root[0], util.PROJECT_CONFIG_NAME);
    val mn: str = t_join(?alloc, src_dir, "main.mach");
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(mf, manifest_text::*u8, str_len(manifest_text::*u8), 420);
    if (sel write_bytes_r.err) { bad = 1; }
    val write_bytes_r2: err[fs.FsError] = fs.write_bytes(mn, main_text::*u8, str_len(main_text::*u8), 420);
    if (sel write_bytes_r2.err)         { bad = 1; }

    if (bad != 0) { fs.remove_all(?alloc, ?root[0]); ret 1; }

    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { fs.remove_all(?alloc, ?root[0]); ret 1; }
    var s: session.Session = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(?s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s); fs.remove_all(?alloc, ?root[0]); ret 1;
    }

    var pick: manifest.Selection;
    pick.target = "linux"; pick.profile = ""; pick.artifact = ""; pick.want_lib = false; pick.has_artifact = false;
    val pr: res[driver.Project, outcome.Fail] = driver.build_project(?s, ?root[0], ?pick);
    if (sel pr.err) {
        session.dnit(?s); fs.remove_all(?alloc, ?root[0]); ret 1;
    }
    var p: driver.Project = pr.ok;

    val api_dir: str = t_join(?alloc, (?root[0])::str, "doc/api");

    var stats: DocStats;
    stats.modules = 0;
    stats.entries = 0;
    if (generate(?alloc, ?p, api_dir, ?stats) != 0) { bad = 1; }

    val pagep: str = t_join(?alloc, api_dir, "doctest/main.md");
    val page_r: res[str, fs.FsError] = fs.read_string(?alloc, pagep);
    if (sel page_r.err) { bad = 1; }
    if (sel page_r.ok) {
        val pg: str = page_r.ok;
        if (!str_contains(pg, "# doctest.main"))                  { bad = 1; }
        if (!str_contains(pg, "## tag Option"))                   { bad = 1; }
        if (!str_contains(pg, "```mach\npub tag Option[T]: u8 {\n    none;\n    some: T;\n}\n```")) { bad = 1; }
        if (!str_contains(pg, "optional value container"))        { bad = 1; }
        if (!str_contains(pg, "[T]: payload element type"))       { bad = 1; }
        if (!str_contains(pg, "none: empty alternative"))         { bad = 1; }
        if (!str_contains(pg, "some: value alternative"))         { bad = 1; }
    }

    driver.dnit_project(?p);
    session.dnit(?s);
    fs.remove_all(?alloc, ?root[0]);
    ret bad;
}
