# `mach doc`: the project's reference, every module its source root holds, written by
# the documentation generator (`mach.tool.doc`) into `doc/<project id>/`
use std_args:        std.args;
use chrono_duration: std.chrono.duration;
use std.collections.slice.Slice;
use std_format: std.format;
use io_writer:  std.io.writer;
use std.types.bool.false;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;

use mach.base.diagnostic;
use diagnostic_kind: mach.base.diagnostic.kind;
use mach.base.fail;
use mach.base.intern;
use mach.cli.args;
use cli_diagnostic: mach.cli.diagnostic;
use mach.cli.exit;
use mach.cli.util;
use mach.compile;
use manifest_model:  mach.manifest.model;
use manifest_schema: mach.manifest.schema;
use mach.report.layout;
use mach.report.readout;
use mach.session;
use tool_doc: mach.tool.doc;

# `-o <dir>`, the directory the reference's directory is made in
val OUTPUT: std_args.Flag = std_args.Flag{long: "output", short: 'o', value: "dir", repeat: false, negatable: false, help: "write the reference under <dir>/<project id> (default: doc)"};
# length of FLAGS
val FLAGS_N: usize = 5;
# the flags mach doc takes
val FLAGS: [FLAGS_N]*std_args.Flag = [FLAGS_N]*std_args.Flag{?args.HELP, ?args.REPORT, ?OUTPUT, ?args.VERBOSE, ?args.QUIET};

# length of REFUSED
val REFUSED_N: usize = 2;
# the selectors doc recognizes only to refuse, since the reference is the source tree's
val REFUSED: [REFUSED_N]*std_args.Flag = [REFUSED_N]*std_args.Flag{?args.ARTIFACT, ?args.TARGET};

# `mach doc`
pub val COMMAND: std_args.Command = std_args.Command{name: "doc", aliases: args.NO_WORDS, help: "write the project's reference documentation", usage: "<path>", flags: Slice[*std_args.Flag]{data: ?FLAGS[0], size: FLAGS_N}, commands: args.NO_COMMANDS, operand_min: 0, operand_max: 1, passthrough: false};
# what mach holds `mach doc` to beyond the parse
pub val POLICY: args.Policy = args.Policy{refused: Slice[*std_args.Flag]{data: ?REFUSED[0], size: REFUSED_N}, refusal: "doc documents every source file, for no artifact or target", conflicts: args.NO_CONFLICTS};

# `mach doc`: parse every source file under the project's source root and write one page
# per module that declares anything, one per directory and the project's page under
# `<root>/doc/<project id>/`, or under `-o <dir>` inside the project root, removing what
# that directory holds that the run did not write. under -v each stage logs its line, and a
# result closes the run unless `--quiet`
# ---
# cx:  the call
# ret: exit.OK, or the failure: a user one for a project, manifest, output path or file that
#      does not parse, an internal one for an allocator or session failure, an environment
#      one for a read, write or removal
pub fun run(cx: *args.Call) res[i64, fail.Fail] {
    val inv:   *std_args.Parsed = cx.inv;
    val alloc: *A.Allocator     = cx.a;
    val began: readout.Instant  = readout.sample();

    var leaf:          str      = "doc";
    val opt_out_given: opt[*u8] = args.value(inv, ?OUTPUT);
    if (sel opt_out_given.some)                 { leaf = opt_out_given.some::str; }
    if (!manifest_schema.is_project_path(leaf)) { ret res[i64, fail.Fail].err{fail.user(diagnostic_kind.OUTPUT_PATH_INVALID, manifest_schema.OUTPUT_CONSTRAINT)}; }

    val res_loc: res[util.ProjectLocation, fail.Fail] = util.resolve_project_location(alloc, args.operand(inv, 0));
    if (sel res_loc.err) { ret res[i64, fail.Fail].err{res_loc.err}; }
    val root: str = res_loc.ok.root;

    val res_session: res[session.Session, fail.Fail] = session.init_in(alloc, cx.sources);
    if (sel res_session.err) { ret res[i64, fail.Fail].err{fail.prefixed(alloc, "cannot start the compiler session", res_session.err)}; }
    var s: session.Session = res_session.ok;
    fin { session.dnit(?s); }

    val res_manifest: res[manifest_model.Manifest, fail.Fail] = compile.load_manifest(?s, root);
    if (sel res_manifest.err) { ret res[i64, fail.Fail].err{res_manifest.err}; }
    var m: manifest_model.Manifest = res_manifest.ok;
    fin { manifest_model.dnit(?m, s.build_alloc); }

    var diags: diagnostic.DiagnosticStore = diagnostic.store_init(alloc);
    fin { diagnostic.store_dnit(?diags); }
    var outcome:       tool_doc.Outcome;
    val err_generated: err[fail.Fail] = tool_doc.generate(alloc, cx.sources, ?diags, s.interner, ?m, root, leaf, ?outcome);
    val id:            str            = intern.text(s.interner, m.id);
    var t:             layout.Text;
    cli_diagnostic.log_stage(cx.report, "load", outcome.loading, counted(?t, outcome.files, "module", "modules"));
    if (diagnostic.len(?diags) > 0) { cli_diagnostic.report_store(cx.report, cx.sources, ?diags); }
    if (sel err_generated.err) {
        if (fail.is_reported(err_generated.err) && cli_diagnostic.results_shown(cx.report)) {
            var dt:     layout.Text;
            var fields: [2]layout.Field = [2]layout.Field{layout.Field{key: "errors", value: layout.nonzero(?t, diagnostic.error_count(?diags)::u64)},
                layout.Field{key: "time", value: layout.duration(?dt, readout.elapsed(began))}};
            layout.result(cli_diagnostic.out(cx.report), layout.FAILED, id, ?fields[0], 2);
        }
        ret res[i64, fail.Fail].err{err_generated.err};
    }
    cli_diagnostic.log_stage(cx.report, "sema", outcome.building, counted(?t, outcome.modules, "module", "modules"));
    cli_diagnostic.log_stage(cx.report, "write", outcome.writing, counted(?t, outcome.pages, "page", "pages"));
    if (cli_diagnostic.results_shown(cx.report)) { result_w(cli_diagnostic.out(cx.report), id, ?outcome, readout.elapsed(began)); }
    ret res[i64, fail.Fail].ok{exit.OK};
}

# the run's result: documented with what it read, wrote and removed, or unchanged when every page
# was current and nothing was removed. a count that equals the pages, or is zero, drops out
fun result_w(w: *io_writer.Writer, id: str, o: *tool_doc.Outcome, took: chrono_duration.Duration) {
    var verb: layout.Verb = layout.DOCUMENTED;
    if (o.changed == 0 && o.removed == 0) { verb = layout.UNCHANGED; }
    var ft:      layout.Text;
    var pt:      layout.Text;
    var ct:      layout.Text;
    var rt:      layout.Text;
    var dt:      layout.Text;
    var sources: str = nil;
    var written: str = nil;
    if (verb == layout.DOCUMENTED) { sources = layout.count(?ft, o.files::u64); }
    if (o.changed != o.pages)      { written = layout.nonzero(?ct, o.changed::u64); }
    var fields: [6]layout.Field = [6]layout.Field{
        layout.Field{key: "sources", value: sources},
        layout.Field{key: "pages", value: layout.count(?pt, o.pages::u64)},
        layout.Field{key: "written", value: written},
        layout.Field{key: "removed", value: layout.nonzero(?rt, o.removed::u64)},
        layout.Field{key: "time", value: layout.duration(?dt, took)},
        layout.Field{key: "output", value: cli_diagnostic.shown_path(o.dir)},
    };
    layout.result(w, verb, id, ?fields[0], 6);
}

# `n one` or `n many` in `t`
fun counted(t: *layout.Text, n: u32, one: str, many: str) str {
    var tw: io_writer.Writer = layout.text_writer(t);
    std_format.format(?tw, "{} {}", n::u64, layout.noun(n::u64, one, many));
    ret layout.text_end(t);
}
