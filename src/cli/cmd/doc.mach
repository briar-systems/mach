    val expect: str = "```mach\npub tag Err[E]: u8 {\n    err: E;\n    ok;\n}\n```\n\n";
    if (!t_sig_eq(source, expect, true)) { ret 1; }
    ret 0;
}

test "mach.cli.cmd.doc.write_signature:tag_single_line" {
    val source: str = "pub tag Pair[A, B]: u8 { empty; first: A; second: B; }";
    val expect: str = "```mach\npub tag Pair[A, B]: u8 { empty; first: A; second: B; }\n```\n\n";
