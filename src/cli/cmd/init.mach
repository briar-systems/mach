    val dest_r: res[str, A.Error] = path.join(?alloc, root, "proj");
    if (sel dest_r.err) { ret 99; }
    val dest: str = dest_r.ok;
    val create_dir_r: err[io_error.Error] = fs.create_dir(dest, 0o755);
    if (sel create_dir_r.err) { fs.remove_all(?alloc, root); str_free(?alloc, root); ret 1; }
    val sentinel_r: res[str, A.Error] = path.join(?alloc, dest, "sentinel.txt");
    if (sel sentinel_r.err) { ret 99; }
    val sentinel: str = sentinel_r.ok;
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(sentinel, "mine"::*u8, 4::usize, 0o644);
    if (sel write_bytes_r.err) { fs.remove_all(?alloc, root); str_free(?alloc, root); ret 1; }

    var argv: [6]*u8;
