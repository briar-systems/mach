    val toml_r: R.Result[str, str] = path.join(?alloc, root, "mach.toml");
    val toml: str = R.unwrap_ok[str, str](toml_r);
    if (O.is_some[str](fs.write_bytes(toml, "original"::*u8, 8::usize, 0o644))) { bad = 1; }
    val src_dir_r: R.Result[str, str] = path.join(?alloc, root, "src");
    if (O.is_some[str](fs.create_dir(R.unwrap_ok[str, str](src_dir_r), 0o755))) { bad = 1; }
    val entry_path_r: R.Result[str, str] = path.join(?alloc, root, "src/root.mach");
    val entry_path: str = R.unwrap_ok[str, str](entry_path_r);
    if (O.is_some[str](fs.write_bytes(entry_path, "orig-src"::*u8, 8::usize, 0o644))) { bad = 1; }

    val cap_r: R.Result[txn.Root, str] = open_root(root, "");
    var cap: txn.Root = R.unwrap_ok[txn.Root, str](cap_r);
    val src_cap_r: R.Result[txn.Root, str] = open_root(root, "src");
    var src_cap: txn.Root = R.unwrap_ok[txn.Root, str](src_cap_r);

    var prior: txn.EntryProbe = R.unwrap_ok[txn.EntryProbe, str](probe_entry(?cap, "mach.toml"));
    var entry_prior: txn.EntryProbe = R.unwrap_ok[txn.EntryProbe, str](probe_entry(?src_cap, "root.mach"));
    val root_id: txn.Identity = R.unwrap_ok[txn.Identity, str](root_identity_of(?cap));

    val prep_r: R.Result[txn.Transaction, str] = stage_absent(?alloc, ?cap, "mach.toml", "fresh"::*u8, 5::usize);
    var pf: txn.Transaction = R.unwrap_ok[txn.Transaction, str](prep_r);
    val new_id: txn.Identity = R.unwrap_ok[txn.Identity, str](staged_identity_of(?pf));

    val entry_prep_r: R.Result[txn.Transaction, str] = stage_absent(?alloc, ?src_cap, "root.mach", "new-src"::*u8, 7::usize);
    var entry_pf: txn.Transaction = R.unwrap_ok[txn.Transaction, str](entry_prep_r);
    val entry_new: txn.Identity = R.unwrap_ok[txn.Identity, str](staged_identity_of(?entry_pf));

    if (R.is_err[R.Void, str](journal_create(?alloc, ?cap, root_id, prior, new_id, entry_prior, entry_new, false, false))) { bad = 1; }

    if (O.is_some[str](rename_entry(?src_cap, "root.mach", BACKUP_ENTRY_BIN))) { bad = 1; }
    if (O.is_some[str](commit_absent(?entry_pf))) { bad = 1; }
    if (O.is_some[str](rename_entry(?cap, "mach.toml", BACKUP_MANIFEST))) { bad = 1; }
    if (O.is_some[str](commit_absent(?pf))) { bad = 1; }

    val rec_r: R.Result[i32, str] = recover_existing(?alloc, root, "", ?cap);
    if (R.is_err[i32, str](rec_r) || R.unwrap_ok[i32, str](rec_r) != RECOVER_COMPLETED) { bad = 1; }

    val kept: O.Option[str] = t_read_file(?alloc, toml);
    if (O.is_none[str](kept) || !str_equals(O.unwrap[str](kept), "fresh")) { bad = 1; }
    val kept_entry: O.Option[str] = t_read_file(?alloc, entry_path);
    if (O.is_none[str](kept_entry) || !str_equals(O.unwrap[str](kept_entry), "new-src")) { bad = 1; }
    if (fs.exists(sfmt_join(?alloc, root, BACKUP_MANIFEST))) { bad = 1; }
    if (fs.exists(sfmt_join(?alloc, root, JOURNAL_LEAF))) { bad = 1; }
    if (fs.exists(sfmt_join(?alloc, sfmt_join(?alloc, root, "src"), BACKUP_ENTRY_BIN))) { bad = 1; }

    txn.root_dnit(?src_cap);
    txn.root_dnit(?cap);
    fs.remove_all(?alloc, root);
    str_free(?alloc, root);
    ret bad;
}

test "mach.cli.cmd.init.recover_existing:with_no_journal_is_a_no_op" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val root_r: R.Result[str, str] = t_scratch_dir(?alloc, "mach_init_recover_clean");
    if (R.is_err[str, str](root_r)) { ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);
    var bad: i32 = 0;

    val cap_r: R.Result[txn.Root, str] = open_root(root, "");
    var cap: txn.Root = R.unwrap_ok[txn.Root, str](cap_r);

    val rec_r: R.Result[i32, str] = recover_existing(?alloc, root, "", ?cap);
    if (R.is_err[i32, str](rec_r) || R.unwrap_ok[i32, str](rec_r) != RECOVER_CLEAN) { bad = 1; }

    txn.root_dnit(?cap);
    fs.remove_all(?alloc, root);
    str_free(?alloc, root);
    ret bad;
}

test "mach.cli.cmd.init.recover_existing:manifest_done_without_entry_done_is_recovery_required" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val root_r: R.Result[str, str] = t_scratch_dir(?alloc, "mach_init_recover_inconsistent");
    if (R.is_err[str, str](root_r)) { ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);
    var bad: i32 = 0;

    val toml_r: R.Result[str, str] = path.join(?alloc, root, "mach.toml");
    val toml: str = R.unwrap_ok[str, str](toml_r);
    if (O.is_some[str](fs.write_bytes(toml, "original"::*u8, 8::usize, 0o644))) { bad = 1; }

    val cap_r: R.Result[txn.Root, str] = open_root(root, "");
    var cap: txn.Root = R.unwrap_ok[txn.Root, str](cap_r);

    var prior: txn.EntryProbe = R.unwrap_ok[txn.EntryProbe, str](probe_entry(?cap, "mach.toml"));
    var empty_entry: txn.EntryProbe;
    var zero_id: txn.Identity;
    val root_id: txn.Identity = R.unwrap_ok[txn.Identity, str](root_identity_of(?cap));

    val prep_r: R.Result[txn.Transaction, str] = stage_absent(?alloc, ?cap, "mach.toml", "fresh"::*u8, 5::usize);
    var pf: txn.Transaction = R.unwrap_ok[txn.Transaction, str](prep_r);
    val new_id: txn.Identity = R.unwrap_ok[txn.Identity, str](staged_identity_of(?pf));

    if (R.is_err[R.Void, str](journal_create(?alloc, ?cap, root_id, prior, new_id, empty_entry, zero_id, false, false))) { bad = 1; }

    if (O.is_some[str](rename_entry(?cap, "mach.toml", BACKUP_MANIFEST))) { bad = 1; }
    if (O.is_some[str](commit_absent(?pf))) { bad = 1; }

    val rec_r: R.Result[i32, str] = recover_existing(?alloc, root, "", ?cap);
    if (R.is_ok[i32, str](rec_r)) { bad = 1; }

    txn.root_dnit(?cap);
    fs.remove_all(?alloc, root);
    str_free(?alloc, root);
    ret bad;
}

test "mach.cli.cmd.init.recover_existing:rollback_deletes_a_freshly_committed_output_that_never_existed_before" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val root_r: R.Result[str, str] = t_scratch_dir(?alloc, "mach_init_recover_undo_fresh");
    if (R.is_err[str, str](root_r)) { ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);
    var bad: i32 = 0;

    val src_dir_r: R.Result[str, str] = path.join(?alloc, root, "src");
    if (O.is_some[str](fs.create_dir(R.unwrap_ok[str, str](src_dir_r), 0o755))) { bad = 1; }

    val cap_r: R.Result[txn.Root, str] = open_root(root, "");
    var cap: txn.Root = R.unwrap_ok[txn.Root, str](cap_r);
    val src_cap_r: R.Result[txn.Root, str] = open_root(root, "src");
    var src_cap: txn.Root = R.unwrap_ok[txn.Root, str](src_cap_r);

    var manifest_prior: txn.EntryProbe = R.unwrap_ok[txn.EntryProbe, str](probe_entry(?cap, "mach.toml"));
    var entry_prior: txn.EntryProbe = R.unwrap_ok[txn.EntryProbe, str](probe_entry(?src_cap, "root.mach"));
    val root_id: txn.Identity = R.unwrap_ok[txn.Identity, str](root_identity_of(?cap));

    val manifest_prep_r: R.Result[txn.Transaction, str] = stage_absent(?alloc, ?cap, "mach.toml", "fresh"::*u8, 5::usize);
    var manifest_pf: txn.Transaction = R.unwrap_ok[txn.Transaction, str](manifest_prep_r);
    val manifest_new: txn.Identity = R.unwrap_ok[txn.Identity, str](staged_identity_of(?manifest_pf));

    val entry_prep_r: R.Result[txn.Transaction, str] = stage_absent(?alloc, ?src_cap, "root.mach", "new-src"::*u8, 7::usize);
    var entry_pf: txn.Transaction = R.unwrap_ok[txn.Transaction, str](entry_prep_r);
    val entry_new: txn.Identity = R.unwrap_ok[txn.Identity, str](staged_identity_of(?entry_pf));

    if (R.is_err[R.Void, str](journal_create(?alloc, ?cap, root_id, manifest_prior, manifest_new, entry_prior, entry_new, false, false))) { bad = 1; }

    if (O.is_some[str](commit_absent(?entry_pf))) { bad = 1; }
    txn.abort(?manifest_pf);

    val rec_r: R.Result[i32, str] = recover_existing(?alloc, root, "", ?cap);
    if (R.is_err[i32, str](rec_r) || R.unwrap_ok[i32, str](rec_r) != RECOVER_ROLLED_BACK) { bad = 1; }

    val entry_path_r: R.Result[str, str] = path.join(?alloc, root, "src/root.mach");
    if (fs.exists(R.unwrap_ok[str, str](entry_path_r))) { bad = 1; }
    val toml_r: R.Result[str, str] = path.join(?alloc, root, "mach.toml");
    if (fs.exists(R.unwrap_ok[str, str](toml_r))) { bad = 1; }
    if (fs.exists(sfmt_join(?alloc, root, JOURNAL_LEAF))) { bad = 1; }

    txn.root_dnit(?src_cap);
    txn.root_dnit(?cap);
    fs.remove_all(?alloc, root);
    str_free(?alloc, root);
    ret bad;
}


test "mach.cli.cmd.init.under_remainder:allocation_failure_cannot_drop_the_destination_prefix" {
    var state: fixed.FixedState;
    var alloc: A.Allocator;
    var storage: [128]u8;
    if (O.is_some[*u8](fixed.make(?alloc, ?state, ?storage[0], 0))) { ret 1; }
    val refused: R.Result[str, str] = under_remainder(?alloc, "nested/project", "mach.toml");
    if (R.is_ok[str, str](refused)) { ret 2; }
    if (O.is_some[*u8](fixed.make(?alloc, ?state, ?storage[0], 128))) { ret 3; }
    val planned: R.Result[str, str] = under_remainder(?alloc, "nested/project", "mach.toml");
    if (R.is_err[str, str](planned)) { ret 4; }
    if (!str_equals(R.unwrap_ok[str, str](planned), "nested/project/mach.toml")) { ret 5; }
    val leaf: R.Result[str, str] = under_remainder(?alloc, "", "mach.toml");
    if (R.is_err[str, str](leaf)) { ret 6; }
    if (!str_equals(R.unwrap_ok[str, str](leaf), "mach.toml")) { ret 7; }
    ret 0;
}
