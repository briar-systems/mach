test "mach.cli.cmd.init.run_typed:a_destination_that_already_exists_before_the_call_routes_to_the_existing_branch" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val root_r: R.Result[str, str] = t_scratch_dir(?alloc, "mach_init_preexisting");
    if (R.is_err[str, str](root_r)) { ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);

    val dest_r: R.Result[str, str] = path.join(?alloc, root, "proj");
    val dest: str = R.unwrap_ok[str, str](dest_r);
    if (O.is_some[str](fs.create_dir(dest, 0o755))) { fs.remove_all(?alloc, root); str_free(?alloc, root); ret 1; }
    val sentinel_r: R.Result[str, str] = path.join(?alloc, dest, "sentinel.txt");
    val sentinel: str = R.unwrap_ok[str, str](sentinel_r);
    if (O.is_some[str](fs.write_bytes(sentinel, "mine"::*u8, 4::usize, 0o644))) { fs.remove_all(?alloc, root); str_free(?alloc, root); ret 1; }

    var argv: [6]*u8;
    argv[0] = "mach"; argv[1] = "init"; argv[2] = dest::*u8; argv[3] = "--name"; argv[4] = "proj"::*u8; argv[5] = "--no-deps"::*u8;

    val rc: i64 = t_init(6, ?argv[0]);

    var bad: i32 = 0;
    if (rc != 0) { bad = 1; }
    if (!fs.exists(sentinel)) { bad = 1; }
    val toml_r: R.Result[str, str] = path.join(?alloc, dest, "mach.toml");
    if (!fs.exists(R.unwrap_ok[str, str](toml_r))) { bad = 1; }

    fs.remove_all(?alloc, root);
    str_free(?alloc, root);
    ret bad;
}

