test "mach.cli.cmd.init.run:an_absolute_or_slash_terminated_destination_names_the_project_after_its_last_component" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val root_r: res[str, outcome.Fail] = t_scratch_dir(?alloc, "mach_init_absid");
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    var bad: i32 = 0;

    val join_r: res[str, A.Error] = path.join(?alloc, root, "absproj");
    if (sel join_r.err) { ret 99; }
    val abs_dest: str = join_r.ok;
    var argv: [4]*u8;
    argv[0] = "mach"; argv[1] = "init"; argv[2] = abs_dest::*u8; argv[3] = "--no-deps"::*u8;
    if (t_init(4, ?argv[0]) != 0) { bad = 1; }
    val join_r2: res[str, A.Error] = path.join(?alloc, abs_dest, "mach.toml");
    if (sel join_r2.err) { ret 99; }
    val abs_toml: str = join_r2.ok;
    val abs_text: res[str, fs.FsError] = fs.read_string(?alloc, abs_toml);
    if (!(sel abs_text.ok && str_contains(abs_text.ok, "id = \"absproj\""))) { bad = 1; }

    val join_r3: res[str, A.Error] = path.join(?alloc, root, "slashproj/");
    if (sel join_r3.err) { ret 99; }
    val slash_dest: str = join_r3.ok;
    argv[2] = slash_dest::*u8;
    if (t_init(4, ?argv[0]) != 0) { bad = 1; }
    val join_r4: res[str, A.Error] = path.join(?alloc, slash_dest, "mach.toml");
    if (sel join_r4.err) { ret 99; }
    val slash_toml: str = join_r4.ok;
    val slash_text: res[str, fs.FsError] = fs.read_string(?alloc, slash_toml);
    if (!(sel slash_text.ok && str_contains(slash_text.ok, "id = \"slashproj\""))) { bad = 1; }

    fs.remove_all(?alloc, root);
    str_free(?alloc, root);
    ret bad;
}

