    ret 0;
}

fun t_scratch_dir(alloc: *A.Allocator, prefix: str) res[str, outcome.Fail] {
    val tf_r: res[fs.TempFile, fs.FsError] = fs.temp_create(alloc, prefix);
    if (sel tf_r.err) { ret res[str, outcome.Fail].err{outcome.user(outcome.fs_text(tf_r.err))}; }
    var tf:     fs.TempFile               = tf_r.ok;
    val root_r: res[str, string.StrError] = str_copy_slice(alloc, fs.temp_path(?tf), 0, str_len(fs.temp_path(?tf)));
    fs.temp_close_and_remove(?tf);
    if (sel root_r.err) { ret res[str, outcome.Fail].err{outcome.user(outcome.str_text(root_r.err))}; }
    val root:         str                 = root_r.ok;
    val create_dir_r: err[io_error.Error] = fs.create_dir(root, 0o755);
    if (sel create_dir_r.err) { ret res[str, outcome.Fail].err{outcome.user("cannot create scratch root")}; }
    ret res[str, outcome.Fail].ok{root};
}

# an owned copy of the text inside the last "run `...`" span, or "" when there is none
fun t_backticked(a: *A.Allocator, msg: str) str {
    val n:     usize = str_len(msg);
    var start: usize = n;
    var i:     usize = 0;
    for (i + 5 < n) {
        if (str_starts_with((?msg[i])::str, "run `")) { start = i + 5; }
        i = i + 1;
    }
    var end: usize = start;
    for (end < n && msg[end] != '`') { end = end + 1; }
    if (end >= n) { ret ""; }
    val copy: res[str, A.Error] = str_dup_range(a, msg, start, end - start);
    if (sel copy.err) { ret ""; }
    ret copy.ok;
}

# split owned text in place at spaces into a nil-terminated argv of at most max words
fun t_split_words(text: str, argv: **u8, max: usize) usize {
    val p:     *u8   = text::*u8;
    var n:     usize = 0;
    var i:     usize = 0;
    var fresh: bool  = true;
    for (p[i] != 0) {
        if (p[i] == ' ') {
            p[i]  = 0;
            fresh = true;
        }
        or {
            if (fresh) {
                if (n == max) { ret 0; }
                argv[n] = ?p[i];
                n       = n + 1;
            }
            fresh = false;
        }
        i = i + 1;
    }
    argv[n] = nil;
    ret n;
}

fun t_read_file(alloc: *A.Allocator, path: str) opt[str] {
    val rb: res[Vector[u8], fs.FsError] = fs.read_bytes(alloc, path);
    if (sel rb.err) { ret opt[str].none{}; }
    var v:  Vector[u8]                = rb.ok;
    val rr: res[str, string.StrError] = str_copy_slice(alloc, v.data::str, 0, v.len);
    vector.dnit[u8](?v);
    if (sel rr.err) { ret opt[str].none{}; }
    ret opt[str].some{rr.ok};
}

