test "mach.cli.cmd.init.recover_existing:mid_swap_backup_restores_the_original_owned_output" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val root_r: R.Result[str, str] = t_scratch_dir(?alloc, "mach_init_recover_rollback");
    if (R.is_err[str, str](root_r)) { ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);
    var bad: i32 = 0;

    val toml_r: R.Result[str, str] = path.join(?alloc, root, "mach.toml");
    val toml: str = R.unwrap_ok[str, str](toml_r);
    if (O.is_some[str](fs.write_bytes(toml, "original"::*u8, 8::usize, 0o644))) { bad = 1; }

    var cap: InitDirectory;
    fin { directory_close(?cap); }
    val cap_r: R.Result[R.Void, str] = open_root(?cap, ?alloc, root, "");

    var prior: InitEntry = R.unwrap_ok[InitEntry, str](probe_entry(?cap, "mach.toml"));
    var empty_entry: InitEntry;
    var zero_id: txn.Identity;
    val root_id: txn.Identity = R.unwrap_ok[txn.Identity, str](root_identity_of(?cap));

    var pf: txn.Transaction;
    var pf_live: bool = false;
    fin { if (pf_live) { txn.abort(?pf); } }
    val prep_r: R.Result[R.Void, str] = stage_owned(?pf, ?alloc, ?cap, "mach.toml", "fresh"::*u8, 5::usize);
    pf_live = R.is_ok[R.Void, str](prep_r);
    if (!pf_live) { ret 1; }

    val new_id: txn.Identity = R.unwrap_ok[txn.Identity, str](staged_identity_of(?pf));

    if (R.is_err[R.Void, str](journal_create(?alloc, ?cap, nil, root_id, prior, new_id, empty_entry, zero_id, false, false))) { bad = 1; }

    txn.abort(?pf); pf_live = false;
    if (O.is_some[str](rename_entry(?cap, "mach.toml", BACKUP_MANIFEST))) { bad = 1; }

    val rec_r: R.Result[i32, str] = recover_existing(?alloc, ?cap);
    if (R.is_err[i32, str](rec_r) || R.unwrap_ok[i32, str](rec_r) != RECOVER_ROLLED_BACK) { bad = 1; }

    val restored: O.Option[str] = t_read_file(?alloc, toml);
    if (O.is_none[str](restored) || !str_equals(O.unwrap[str](restored), "original")) { bad = 1; }
    if (fs.exists(sfmt_join(?alloc, root, BACKUP_MANIFEST))) { bad = 1; }
    if (fs.exists(sfmt_join(?alloc, root, JOURNAL_LEAF))) { bad = 1; }

    directory_close(?cap);
    fs.remove_all(?alloc, root);
    str_free(?alloc, root);
    ret bad;
}

test "mach.cli.cmd.init.recover_existing:completed_swap_finishes_cleanup_and_keeps_the_new_content" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val root_r: R.Result[str, str] = t_scratch_dir(?alloc, "mach_init_recover_complete");
    if (R.is_err[str, str](root_r)) { ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);
    var bad: i32 = 0;

    val toml_r: R.Result[str, str] = path.join(?alloc, root, "mach.toml");
    val toml: str = R.unwrap_ok[str, str](toml_r);
    if (O.is_some[str](fs.write_bytes(toml, "original"::*u8, 8::usize, 0o644))) { bad = 1; }
    val src_dir_r: R.Result[str, str] = path.join(?alloc, root, "src");
    if (O.is_some[str](fs.create_dir(R.unwrap_ok[str, str](src_dir_r), 0o755))) { bad = 1; }
    val entry_path_r: R.Result[str, str] = path.join(?alloc, root, "src/root.mach");
    val entry_path: str = R.unwrap_ok[str, str](entry_path_r);
    if (O.is_some[str](fs.write_bytes(entry_path, "orig-src"::*u8, 8::usize, 0o644))) { bad = 1; }

    var cap: InitDirectory;
    fin { directory_close(?cap); }
    val cap_r: R.Result[R.Void, str] = open_root(?cap, ?alloc, root, "");

    var src_cap: InitDirectory;
    fin { directory_close(?src_cap); }
    val src_cap_r: R.Result[R.Void, str] = open_src_cap(?src_cap, ?alloc, ?cap);

    var prior: InitEntry = R.unwrap_ok[InitEntry, str](probe_entry(?cap, "mach.toml"));
    var entry_prior: InitEntry = R.unwrap_ok[InitEntry, str](probe_entry(?src_cap, "root.mach"));
    val root_id: txn.Identity = R.unwrap_ok[txn.Identity, str](root_identity_of(?cap));

    var pf: txn.Transaction;
    var pf_live: bool = false;
    fin { if (pf_live) { txn.abort(?pf); } }
    val prep_r: R.Result[R.Void, str] = stage_owned(?pf, ?alloc, ?cap, "mach.toml", "fresh"::*u8, 5::usize);
    pf_live = R.is_ok[R.Void, str](prep_r);
    if (!pf_live) { ret 1; }

    val new_id: txn.Identity = R.unwrap_ok[txn.Identity, str](staged_identity_of(?pf));

    var entry_pf: txn.Transaction;
    var entry_pf_live: bool = false;
    fin { if (entry_pf_live) { txn.abort(?entry_pf); } }
    val entry_prep_r: R.Result[R.Void, str] = stage_owned(?entry_pf, ?alloc, ?src_cap, "root.mach", "new-src"::*u8, 7::usize);
    entry_pf_live = R.is_ok[R.Void, str](entry_prep_r);
    if (!entry_pf_live) { ret 1; }

    val entry_new: txn.Identity = R.unwrap_ok[txn.Identity, str](staged_identity_of(?entry_pf));

    var source_identity: txn.Identity = R.unwrap_ok[txn.Identity, str](root_identity_of(?src_cap));
    if (R.is_err[R.Void, str](journal_create(?alloc, ?cap, ?source_identity, root_id, prior, new_id, entry_prior, entry_new, false, false))) { bad = 1; }

    if (O.is_some[str](commit_owned(?alloc, ?src_cap, ?entry_pf, ?entry_pf_live, BACKUP_ENTRY_BIN))) { bad = 1; }
    if (O.is_some[str](commit_owned(?alloc, ?cap, ?pf, ?pf_live, BACKUP_MANIFEST))) { bad = 1; }

    directory_close(?src_cap);
    val rec_r: R.Result[i32, str] = recover_existing(?alloc, ?cap);
    if (R.is_err[i32, str](rec_r) || R.unwrap_ok[i32, str](rec_r) != RECOVER_COMPLETED) { bad = 1; }

    val kept: O.Option[str] = t_read_file(?alloc, toml);
    if (O.is_none[str](kept) || !str_equals(O.unwrap[str](kept), "fresh")) { bad = 1; }
    val kept_entry: O.Option[str] = t_read_file(?alloc, entry_path);
    if (O.is_none[str](kept_entry) || !str_equals(O.unwrap[str](kept_entry), "new-src")) { bad = 1; }
    if (fs.exists(sfmt_join(?alloc, root, BACKUP_MANIFEST))) { bad = 1; }
    if (fs.exists(sfmt_join(?alloc, root, JOURNAL_LEAF))) { bad = 1; }
    if (fs.exists(sfmt_join(?alloc, sfmt_join(?alloc, root, "src"), BACKUP_ENTRY_BIN))) { bad = 1; }

    directory_close(?src_cap);
    directory_close(?cap);
    fs.remove_all(?alloc, root);
    str_free(?alloc, root);
    ret bad;
}

