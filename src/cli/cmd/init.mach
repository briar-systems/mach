    if (!str_equals(scaffold_abi(?reg, "linux",   isa.ARCH_X86_64), "sysv64")) { ret 1; }
    if (!str_equals(scaffold_abi(?reg, "windows", isa.ARCH_X86_64), "win64"))  { ret 1; }
    if (!str_equals(scaffold_abi(?reg, "darwin",  isa.ARCH_X86_64), "sysv64")) { ret 1; }
    ret 0;
}

