    val root_r: R.Result[str, str] = t_scratch_dir(?alloc, "mach_init_existing");
    if (R.is_err[str, str](root_r)) { ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);

    var argv: [6]*u8;
    argv[0] = "mach"; argv[1] = "init"; argv[2] = root::*u8; argv[3] = "--name"; argv[4] = "existingproj"::*u8; argv[5] = "--no-deps"::*u8;

    val rc: i64 = t_init(6, ?argv[0]);

    var bad: i32 = 0;
    if (rc != 0) { bad = 1; }
    val toml_r: R.Result[str, str] = path.join(?alloc, root, "mach.toml");
    if (!fs.exists(R.unwrap_ok[str, str](toml_r))) { bad = 1; }
    val src_r: R.Result[str, str] = path.join(?alloc, root, "src/root.mach");
    if (!fs.exists(R.unwrap_ok[str, str](src_r))) { bad = 1; }

    fs.remove_all(?alloc, root);
    str_free(?alloc, root);
    ret bad;
}

