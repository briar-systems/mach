    ret bad;
}

test "mach.cli.cmd.init.recover_existing:mid_swap_backup_restores_the_original_owned_output" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val root_r: res[str, outcome.Fail] = t_scratch_dir(?alloc, "mach_init_recover_rollback");
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    var bad: i32 = 0;

    val toml_r: res[str, A.Error] = path.join(?alloc, root, "mach.toml");
    if (sel toml_r.err) { ret 99; }
    val toml: str = toml_r.ok;
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(toml, "original"::*u8, 8::usize, 0o644);
    if (sel write_bytes_r.err) { bad = 1; }

    var cap: InitDirectory;
    fin { directory_close(?cap); }
    val cap_r: err[outcome.Fail] = open_root(?cap, ?alloc, root, "");

    val probe_entry_r: res[InitEntry, outcome.Fail] = probe_entry(?cap, "mach.toml");
    if (sel probe_entry_r.err) { ret 99; }
    var prior: InitEntry = probe_entry_r.ok;
    var empty_entry: InitEntry;
    var zero_id: txn.Identity;
    val root_identity_of_r: res[txn.Identity, outcome.Fail] = root_identity_of(?cap);
    if (sel root_identity_of_r.err) { ret 99; }
    val root_id: txn.Identity = root_identity_of_r.ok;

    var pf: txn.Transaction;
    var pf_live: bool = false;
    fin { if (pf_live) { txn.abort(?pf); } }
    val prep_r: err[outcome.Fail] = stage_owned(?pf, ?alloc, ?cap, "mach.toml", "fresh"::*u8, 5::usize);
    pf_live = sel prep_r.ok;
    if (!pf_live) { ret 1; }

    val staged_identity_of_r: res[txn.Identity, outcome.Fail] = staged_identity_of(?pf);
    if (sel staged_identity_of_r.err) { ret 99; }
    val new_id: txn.Identity = staged_identity_of_r.ok;

    val journal_create_r: err[outcome.Fail] = journal_create(?alloc, ?cap, nil, root_id, prior, new_id, empty_entry, zero_id, false, false);
    if (sel journal_create_r.err) { bad = 1; }

    txn.abort(?pf); pf_live = false;
    val rename_entry_r: err[outcome.Fail] = rename_entry(?cap, "mach.toml", BACKUP_MANIFEST);
    if (sel rename_entry_r.err) { bad = 1; }

    val rec_r: res[i32, outcome.Fail] = recover_existing(?alloc, ?cap);
    if (sel rec_r.err) { ret 99; }
    if (!(sel rec_r.ok && rec_r.ok == RECOVER_ROLLED_BACK)) { bad = 1; }

    val restored: opt[str] = t_read_file(?alloc, toml);
    if (!(sel restored.some && str_equals(restored.some, "original"))) { bad = 1; }
    val exists_r: res[bool, io_error.Error] = fs.exists(sfmt_join(?alloc, root, BACKUP_MANIFEST));
    if (sel exists_r.err) { ret 99; }
    if ((sel exists_r.ok && exists_r.ok)) { bad = 1; }
    val exists_r2: res[bool, io_error.Error] = fs.exists(sfmt_join(?alloc, root, JOURNAL_LEAF));
    if (sel exists_r2.err) { ret 99; }
    if ((sel exists_r2.ok && exists_r2.ok)) { bad = 1; }

    directory_close(?cap);
    fs.remove_all(?alloc, root);
    str_free(?alloc, root);
    ret bad;
}

test "mach.cli.cmd.init.recover_existing:completed_swap_finishes_cleanup_and_keeps_the_new_content" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val root_r: res[str, outcome.Fail] = t_scratch_dir(?alloc, "mach_init_recover_complete");
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    var bad: i32 = 0;

    val toml_r: res[str, A.Error] = path.join(?alloc, root, "mach.toml");
    if (sel toml_r.err) { ret 99; }
    val toml: str = toml_r.ok;
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(toml, "original"::*u8, 8::usize, 0o644);
    if (sel write_bytes_r.err) { bad = 1; }
    val src_dir_r: res[str, A.Error] = path.join(?alloc, root, "src");
    if (sel src_dir_r.err) { ret 99; }
    val create_dir_r: err[io_error.Error] = fs.create_dir(src_dir_r.ok, 0o755);
    if (sel create_dir_r.err) { bad = 1; }
    val entry_path_r: res[str, A.Error] = path.join(?alloc, root, "src/root.mach");
    if (sel entry_path_r.err) { ret 99; }
    val entry_path: str = entry_path_r.ok;
    val write_bytes_r2: err[fs.FsError] = fs.write_bytes(entry_path, "orig-src"::*u8, 8::usize, 0o644);
    if (sel write_bytes_r2.err) { bad = 1; }

    var cap: InitDirectory;
    fin { directory_close(?cap); }
    val cap_r: err[outcome.Fail] = open_root(?cap, ?alloc, root, "");

    var src_cap: InitDirectory;
    fin { directory_close(?src_cap); }
    val src_cap_r: err[outcome.Fail] = open_src_cap(?src_cap, ?alloc, ?cap);

    val probe_entry_r: res[InitEntry, outcome.Fail] = probe_entry(?cap, "mach.toml");
    if (sel probe_entry_r.err) { ret 99; }
    var prior: InitEntry = probe_entry_r.ok;
    val probe_entry_r2: res[InitEntry, outcome.Fail] = probe_entry(?src_cap, "root.mach");
    if (sel probe_entry_r2.err) { ret 99; }
    var entry_prior: InitEntry = probe_entry_r2.ok;
    val root_identity_of_r: res[txn.Identity, outcome.Fail] = root_identity_of(?cap);
    if (sel root_identity_of_r.err) { ret 99; }
    val root_id: txn.Identity = root_identity_of_r.ok;

    var pf: txn.Transaction;
    var pf_live: bool = false;
    fin { if (pf_live) { txn.abort(?pf); } }
    val prep_r: err[outcome.Fail] = stage_owned(?pf, ?alloc, ?cap, "mach.toml", "fresh"::*u8, 5::usize);
    pf_live = sel prep_r.ok;
    if (!pf_live) { ret 1; }

    val staged_identity_of_r: res[txn.Identity, outcome.Fail] = staged_identity_of(?pf);
    if (sel staged_identity_of_r.err) { ret 99; }
    val new_id: txn.Identity = staged_identity_of_r.ok;

    var entry_pf: txn.Transaction;
    var entry_pf_live: bool = false;
    fin { if (entry_pf_live) { txn.abort(?entry_pf); } }
    val entry_prep_r: err[outcome.Fail] = stage_owned(?entry_pf, ?alloc, ?src_cap, "root.mach", "new-src"::*u8, 7::usize);
    entry_pf_live = sel entry_prep_r.ok;
    if (!entry_pf_live) { ret 1; }

    val staged_identity_of_r2: res[txn.Identity, outcome.Fail] = staged_identity_of(?entry_pf);
    if (sel staged_identity_of_r2.err) { ret 99; }
    val entry_new: txn.Identity = staged_identity_of_r2.ok;

    val root_identity_of_r2: res[txn.Identity, outcome.Fail] = root_identity_of(?src_cap);
    if (sel root_identity_of_r2.err) { ret 99; }
    var source_identity: txn.Identity = root_identity_of_r2.ok;
    val journal_create_r: err[outcome.Fail] = journal_create(?alloc, ?cap, ?source_identity, root_id, prior, new_id, entry_prior, entry_new, false, false);
    if (sel journal_create_r.err) { bad = 1; }

    val commit_owned_r: err[outcome.Fail] = commit_owned(?alloc, ?src_cap, ?entry_pf, ?entry_pf_live, BACKUP_ENTRY_BIN);
    if (sel commit_owned_r.err) { bad = 1; }
    val commit_owned_r2: err[outcome.Fail] = commit_owned(?alloc, ?cap, ?pf, ?pf_live, BACKUP_MANIFEST);
    if (sel commit_owned_r2.err) { bad = 1; }

    directory_close(?src_cap);
    val rec_r: res[i32, outcome.Fail] = recover_existing(?alloc, ?cap);
    if (sel rec_r.err) { ret 99; }
    if (!(sel rec_r.ok && rec_r.ok == RECOVER_COMPLETED)) { bad = 1; }

    val kept: opt[str] = t_read_file(?alloc, toml);
    if (!(sel kept.some && str_equals(kept.some, "fresh"))) { bad = 1; }
    val kept_entry: opt[str] = t_read_file(?alloc, entry_path);
    if (!(sel kept_entry.some && str_equals(kept_entry.some, "new-src"))) { bad = 1; }
    val exists_r: res[bool, io_error.Error] = fs.exists(sfmt_join(?alloc, root, BACKUP_MANIFEST));
    if (sel exists_r.err) { ret 99; }
    if ((sel exists_r.ok && exists_r.ok)) { bad = 1; }
    val exists_r2: res[bool, io_error.Error] = fs.exists(sfmt_join(?alloc, root, JOURNAL_LEAF));
    if (sel exists_r2.err) { ret 99; }
    if ((sel exists_r2.ok && exists_r2.ok)) { bad = 1; }
    val exists_r3: res[bool, io_error.Error] = fs.exists(sfmt_join(?alloc, sfmt_join(?alloc, root, "src"), BACKUP_ENTRY_BIN));
    if (sel exists_r3.err) { ret 99; }
    if ((sel exists_r3.ok && exists_r3.ok)) { bad = 1; }

    directory_close(?src_cap);
    directory_close(?cap);
    fs.remove_all(?alloc, root);
    str_free(?alloc, root);
    ret bad;
}

