    val rc: i64 = t_init(6, ?argv[0]);

    var bad: i32 = 0;
    if (rc != 0) { bad = 1; }
    val exists_r: res[bool, io_error.Error] = fs.exists(sentinel);
    if (sel exists_r.err) { ret 99; }
    if (!(sel exists_r.ok && exists_r.ok)) { bad = 1; }
    val toml_r: res[str, A.Error] = path.join(?alloc, dest, "mach.toml");
    if (sel toml_r.err) { ret 99; }
    val exists_r2: res[bool, io_error.Error] = fs.exists(toml_r.ok);
    if (sel exists_r2.err) { ret 99; }
    if (!(sel exists_r2.ok && exists_r2.ok)) { bad = 1; }

    fs.remove_all(?alloc, root);
    str_free(?alloc, root);
    ret bad;
}

