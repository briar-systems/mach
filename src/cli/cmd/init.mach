val DIR_MODE:  i32 = 493;
val FILE_MODE: i32 = 420;

# `--name <id>`
val NAME: args.FlagSpec = args.FlagSpec{name: "--name", value: "id", arity: args.ARITY_VALUE, doc: "set the project identifier", default: "directory name", repeatable: false, alias_of: nil};
# `--force`
val FORCE: args.FlagSpec = args.FlagSpec{name: "--force", value: "", arity: args.ARITY_FLAG, doc: "scaffold even when mach.toml or src already exists", default: "", repeatable: false, alias_of: nil};
# `--lib`
val LIB: args.FlagSpec = args.FlagSpec{name: "--lib", value: "", arity: args.ARITY_FLAG, doc: "use the library project layout", default: "binary project layout", repeatable: false, alias_of: nil};
# `--no-deps`
val NO_DEPS: args.FlagSpec = args.FlagSpec{name: "--no-deps", value: "", arity: args.ARITY_FLAG, doc: "resolve and declare the dependencies without checking them out (resolving still needs the network)", default: "", repeatable: false, alias_of: nil};
# `--no-git`
val NO_GIT: args.FlagSpec = args.FlagSpec{name: "--no-git", value: "", arity: args.ARITY_FLAG, doc: "skip Git initialization and realize dependencies as plain checkouts", default: "", repeatable: false, alias_of: nil};

# row count of OWN
val OWN_N: usize = 5;
# the options only mach init accepts
val OWN: [OWN_N]*args.FlagSpec = [OWN_N]*args.FlagSpec{?NAME, ?FORCE, ?LIB, ?NO_DEPS, ?NO_GIT};

# length of TABLES
val TABLES_N: usize = 2;
# the option tables mach init accepts: its own and `--quiet`
val TABLES: [TABLES_N]args.TableRef = [TABLES_N]args.TableRef{
    args.TableRef{rows: ?OWN[0], n: OWN_N, accepted: nil, docs: nil},
    args.TableRef{rows: ?args.QUIETNESS[0], n: args.QUIETNESS_N, accepted: nil, docs: nil},
};

# `mach init`
pub val COMMAND: args.CommandSpec = args.CommandSpec{name: "init", aliases: nil, alias_n: 0, grammar: " [dir] [options]", summary: "scaffold a new project", effect: "create a binary or library project in the selected directory and add std at the caret range of the newest release that admits this compiler", exits: nil, exit_n: 0, terminator: "", tables: ?TABLES[0], table_n: TABLES_N, refused: nil, refused_n: 0, refusal: "", relations: nil, relation_n: 0, constraints: nil, constraint_n: 0, operand_min: 0, operand_max: args.OPERANDS_ANY, truncate_at_sep: false, actions: nil, action_n: 0, examples: nil, example_n: 0, run: run};

# `mach init`: scaffold a project. the positional names the directory (default the working
# directory) and, unless `--name` is given, the project id, which must be a portable
# identifier. an absent directory is created whole; an existing one is filled in, and
# `--force` allows overwriting mach.toml and the entry file. `--lib` writes src/lib.mach
# and a static artifact instead of src/main.mach and binary artifacts. the std dependency
# is then added at the caret range of the release resolution picks and checked out, unless
# `--no-deps`, which still resolves the range (so needs the network) but skips the checkout.
# `--quiet` silences progress
# ---
# cx:  the call
# ret: exit.OK, or the failure: a user one for an invalid id or a refused overwrite, otherwise the
#      std dependency's own class when it could not be added
pub fun run(cx: *args.Call) res[i64, fail.Fail] {
    ret run_with(cx, ?SCAFFOLD_DEPS[0], SCAFFOLD_DEP_COUNT);
}

# `run` over an explicit scaffold dependency set
fun run_with(cx: *args.Call, deps: *ScaffoldDep, dep_count: usize) res[i64, fail.Fail] {
    val inv:     *args.ParsedInvocation = cx.inv;
    val a:       *A.Allocator           = cx.a;
    val force:   bool                   = args.given(inv, ?FORCE);
    val is_lib:  bool                   = args.given(inv, ?LIB);
    val no_deps: bool                   = args.given(inv, ?NO_DEPS);
    val no_git:  bool                   = args.given(inv, ?NO_GIT);
    val quiet:   bool                   = args.given(inv, ?args.QUIET);

    val cwd_r: res[types_string.OwnedString, env.EnvError] = env.current_dir(a);
    if (sel cwd_r.err) {
        val said: res[str, std_format.FormatError] = std_format.sprint(a, "failed to read the working directory: {}", fail.env_text(cwd_r.err));
        if (sel said.err) { ret res[i64, fail.Fail].err{fail.message("out of memory")}; }
        ret res[i64, fail.Fail].err{fail.environment(diagnostic_kind.FS_CURRENT_DIR, said.ok)};
    }
    var cwd_owned: types_string.OwnedString = cwd_r.ok;
    val cwd:       str                      = cwd_owned.data;

    var dir: *u8 = cwd;
    if (inv.has_positional) { dir = cx.argv[inv.positional_idx]; }

    val id_r: res[str, fail.Fail] = default_project_id(a, cwd, dir::str);
    if (sel id_r.err) { ret res[i64, fail.Fail].err{id_r.err}; }
    var id:    *u8      = id_r.ok;
    val named: opt[*u8] = args.value(inv, cx.argv, ?NAME);
    if (sel named.some) { id = named.some; }

    if (!manifest.is_valid_id(id::str)) {
        ret res[i64, fail.Fail].err{fail.formatted_user(a, diagnostic_kind.PROJECT_INVALID_ID, "'{}' is not a valid project id: a project id may contain only letters, digits, '_', or '-' (no '.', '/', or spaces); pass a valid name as the argument or with --name <name>", id::str)};
    }

    var entry_leaf:  *u8 = "main.mach";
    var entry_label: *u8 = "src/main.mach";
    if (is_lib) {
        entry_leaf  = "lib.mach";
        entry_label = "src/lib.mach";
    }

    val dest_r: res[str, fail.Fail] = destination_path(a, cwd, dir::str);
    if (sel dest_r.err) { ret res[i64, fail.Fail].err{dest_r.err}; }
    val dest:       str            = dest_r.ok;
    val scaffolded: err[fail.Fail] = scaffold(a, dest, id, is_lib, entry_leaf, entry_label, force, quiet);
    if (sel scaffolded.err) { ret res[i64, fail.Fail].err{scaffolded.err}; }
    ret dependency_stage(cx.report, a, dest, no_deps, no_git, quiet, deps, dep_count, inv.environ);
}

#[testing]
fun t_run_without_deps(cx: *args.Call) res[i64, fail.Fail] {
    cx.inv.environ = git.t_file_transport_environ();
    ret run_with(cx, nil, 0);
}

# dependency_stage quietly over one dependency through the file transport, its failure reported
#[testing]
fun t_stage(a: *A.Allocator, root: str, no_deps: bool, deps: *ScaffoldDep) i64 {
    var r: cli_diagnostic.Report;
    cli_diagnostic.report_init(?r, cli_diagnostic.FORMAT_HUMAN);
    val got: res[i64, fail.Fail] = dependency_stage(?r, a, root, no_deps, false, true, deps, 1, git.t_file_transport_environ());
    if (sel got.err) { ret cli_diagnostic.report_fail(?r, got.err, diagnostic.ORIGIN_NONE); }
    ret got.ok;
}

#[testing]
fun t_init(argc: usize, argv: **u8) i64 {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 2; }
    val ir: res[args.ParsedInvocation, fail.Fail] = args.parse_command(?a, ?COMMAND, argc, argv);
    if (sel ir.err) { ret 2; }
    var inv: args.ParsedInvocation = ir.ok;
    if (sel inv.refusal.some) { ret args.run(?inv, argv); }
    ret args.run_as(?inv, argv, fs.writer(fs.STDERR), t_run_without_deps);
}

# a dependency every scaffold declares; it is added like `mach dep add <path> <id> --git <git>`,
# at the caret range of the release resolution picks for the running compiler
rec ScaffoldDep {
    id:  str;
    git: str;
}

val SCAFFOLD_DEP_COUNT: usize          = 1;
val SCAFFOLD_DEPS:      [1]ScaffoldDep = [1]ScaffoldDep{
    ScaffoldDep{id: "std", git: "https://github.com/briar-systems/mach-std"}
};

fun dependency_stage(r: *cli_diagnostic.Report, a: *A.Allocator, root: str, no_deps: bool, no_git: bool, quiet: bool, deps: *ScaffoldDep,
    dep_count: usize, environ: **u8) res[i64, fail.Fail] {
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(a);
    if (sel sr.err) { ret res[i64, fail.Fail].err{fail.message("failed to initialize project setup")}; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    s.environ = environ;
    if (!no_git) {
        val started: err[fail.Fail] = package_edit.start(?s, root);
        if (sel started.err) { ret res[i64, fail.Fail].err{started.err}; }
    }
    var i: usize = 0;
    for (i < dep_count) {
        val dep: ScaffoldDep = deps[i];
        i = i + 1;
        var rep:   report.Report = cli_diagnostic.dependency_report(a);
        val added: i64                   = cli_diagnostic.dependency_outcome(?rep, package_edit.add_release(?s, a, root, dep.id, dep.git, quiet, !no_deps, ?rep));
        report.dnit(?rep);
        if (added != exit.OK) {
            var msg_r: res[str, std_format.FormatError];
            if (no_deps) {
                msg_r = std_format.sprint(a,
                    "dependency '{}' has no resolved release; --no-deps skips only the checkout, resolving its range still needs the network. run `mach dep add <path> {} --git {}` for project '{}' once connected",
                    dep.id, dep.id, dep.git, root);
            }
            or {
                msg_r = std_format.sprint(a,
                    "dependency '{}' could not be added; run `mach dep add <path> {} --git {}` for project '{}' once the problem above is fixed", dep.id, dep.id, dep.git, root);
            }
            var said: str = "a declared dependency could not be added";
            if (sel msg_r.ok) { said = msg_r.ok; }
            # the failure reported above carries the class, and so the exit code
            cli_diagnostic.report_fail(r, fail.user(diagnostic_kind.DEP_ADD, said), diagnostic.ORIGIN_NONE);
            ret res[i64, fail.Fail].ok{added};
        }
        if (quiet) { cnt; }
        if (no_deps) {
            val hint: res[str, fail.Fail] = no_deps_hint(a, root, dep.id);
            if (sel hint.err) { ret res[i64, fail.Fail].err{hint.err}; }
            print.eprintlnf("{}", hint.ok);
        }
        or { print.eprintlnf("realized dependency '{}'", dep.id); }
    }
    ret res[i64, fail.Fail].ok{exit.OK};
}

# what --no-deps prints for a dependency it declared: the command that pins it, which is the
# one `mach dep pull` names when it refuses an unpinned version selection
fun no_deps_hint(a: *A.Allocator, root: str, id: str) res[str, fail.Fail] {
    val command: res[str, fail.Fail] = package_closure.pin_command(a, root, id);
    if (sel command.err) { ret command; }
    ret fail.format(a, "declared dependency '{}' without a checkout; run `{}` to pin and realize it", id, command.ok);
}

# the destination, rooted at the working directory and cleaned
fun destination_path(alloc: *A.Allocator, cwd: str, dir: str) res[str, fail.Fail] {
    val joined: res[str, A.Error] = types_path.resolve(alloc, cwd, dir);
    if (sel joined.err) { ret res[str, fail.Fail].err{fail.refused(joined.err)}; }
    val cleaned: res[str, A.Error] = types_path.clean(alloc, joined.ok);
    str_free(alloc, joined.ok);
    if (sel cleaned.err) { ret res[str, fail.Fail].err{fail.refused(cleaned.err)}; }
    ret res[str, fail.Fail].ok{cleaned.ok};
}

val ENTRY_ABSENT:  u8 = 0;
val ENTRY_REGULAR: u8 = 1;
val ENTRY_DIR:     u8 = 2;
val ENTRY_OTHER:   u8 = 3;

fun probe(alloc: *A.Allocator, dest: str, rel: str) res[u8, fail.Fail] {
    val joined: res[str, A.Error] = types_path.join(alloc, dest, rel);
    if (sel joined.err) { ret res[u8, fail.Fail].err{fail.refused(joined.err)}; }
    val name: str = joined.ok;
    fin { str_free(alloc, name); }
    var st:     system_os.stat_t;
    val probed: i64 = system_os.stat_path(system_os.working_dir(), name, ?st, system_os.AT_SYMLINK_NOFOLLOW);
    if (system_os.error_kind(probed) == io_error.NOT_FOUND) { ret res[u8, fail.Fail].ok{ENTRY_ABSENT}; }
    if (probed < 0)                                         { ret res[u8, fail.Fail].err{fail.environment(diagnostic_kind.FS_STAT, system_os.error_message(probed))}; }
    val kind: u32 = native.stat_mode(?st) & system_os.S_IFMT;
    if (kind == system_os.S_IFREG) { ret res[u8, fail.Fail].ok{ENTRY_REGULAR}; }
    if (kind == system_os.S_IFDIR) { ret res[u8, fail.Fail].ok{ENTRY_DIR}; }
    ret res[u8, fail.Fail].ok{ENTRY_OTHER};
}

# write one scaffold file through a sibling temporary and rename, so a
# forced overwrite of an existing file is whole or not at all
fun emit(alloc: *A.Allocator, dest: str, rel: str, text: str) err[fail.Fail] {
    val joined: res[str, A.Error] = types_path.join(alloc, dest, rel);
    if (sel joined.err) { ret err[fail.Fail].err{fail.refused(joined.err)}; }
    val name: str = joined.ok;
    fin { str_free(alloc, name); }
    ret output.replace(alloc, name, text::*u8, str_len(text), FILE_MODE);
}

fun exists_fail(a: *A.Allocator, label: *u8) fail.Fail {
    ret fail.formatted_user(a, diagnostic_kind.PROJECT_FILE_EXISTS, "'{}' already exists (use --force to replace it)", label::str);
}

fun not_regular_fail(a: *A.Allocator, label: *u8) fail.Fail {
    ret fail.formatted_user(a, diagnostic_kind.PROJECT_FILE_KIND, "'{}' exists and is not a regular file", label::str);
}

# an existing manifest or entry is refused without --force; every refusal
# comes before the first write, so a refused init changes nothing
fun scaffold_checked(a: *A.Allocator, dest: str, id: *u8, is_lib: bool, entry_leaf: *u8,
    entry_label: *u8, force: bool) res[i64, fail.Fail] {
    val existing: res[u8, fail.Fail] = probe(a, dest, "");
    if (sel existing.err) { ret res[i64, fail.Fail].err{existing.err}; }
    if (existing.ok == ENTRY_REGULAR || existing.ok == ENTRY_OTHER) {
        ret res[i64, fail.Fail].err{fail.user(diagnostic_kind.PROJECT_FILE_KIND, "the destination exists and is not a directory")};
    }
    if (existing.ok == ENTRY_DIR) {
        val manifest_r: res[u8, fail.Fail] = probe(a, dest, util.PROJECT_CONFIG_NAME);
        if (sel manifest_r.err) { ret res[i64, fail.Fail].err{manifest_r.err}; }
        if (manifest_r.ok == ENTRY_DIR || manifest_r.ok == ENTRY_OTHER) {
            ret res[i64, fail.Fail].err{not_regular_fail(a, util.PROJECT_CONFIG_NAME)};
        }
        if (manifest_r.ok == ENTRY_REGULAR && !force) {
            ret res[i64, fail.Fail].err{exists_fail(a, util.PROJECT_CONFIG_NAME)};
        }
        val source_r: res[u8, fail.Fail] = probe(a, dest, "src");
        if (sel source_r.err) { ret res[i64, fail.Fail].err{source_r.err}; }
        if (source_r.ok == ENTRY_REGULAR || source_r.ok == ENTRY_OTHER) {
            ret res[i64, fail.Fail].err{fail.user(diagnostic_kind.PROJECT_FILE_KIND, "'src' exists and is not a directory")};
        }
        val entry_r: res[u8, fail.Fail] = probe(a, dest, entry_label::str);
        if (sel entry_r.err) { ret res[i64, fail.Fail].err{entry_r.err}; }
        if (entry_r.ok == ENTRY_DIR || entry_r.ok == ENTRY_OTHER) {
            ret res[i64, fail.Fail].err{not_regular_fail(a, entry_label)};
        }
        if (entry_r.ok == ENTRY_REGULAR && !force) {
            ret res[i64, fail.Fail].err{exists_fail(a, entry_label)};
        }
    }
    val text_r: res[str, fail.Fail] = build_manifest_text(a, id, is_lib, lang_target.host_arch_id());
    if (sel text_r.err) { ret res[i64, fail.Fail].err{text_r.err}; }
    val text: str = text_r.ok;
    fin { str_free(a, text); }
    val src_r: res[str, A.Error] = types_path.join(a, dest, "src");
    if (sel src_r.err) { ret res[i64, fail.Fail].err{fail.refused(src_r.err)}; }
    val src: str = src_r.ok;
    fin { str_free(a, src); }
    val made: err[fs.FsError] = fs.create_dir_all(a, src, DIR_MODE);
    if (sel made.err) { ret res[i64, fail.Fail].err{fail.environment(diagnostic_kind.FS_CREATE, fail.fs_text(made.err))}; }
    val manifest_written: err[fail.Fail] = emit(a, dest, util.PROJECT_CONFIG_NAME, text);
    if (sel manifest_written.err) { ret res[i64, fail.Fail].err{manifest_written.err}; }
    val entry_written: err[fail.Fail] = emit(a, dest, entry_label::str, source_template(is_lib)::str);
    if (sel entry_written.err) { ret res[i64, fail.Fail].err{entry_written.err}; }
    ret res[i64, fail.Fail].ok{exit.OK};
}

fun scaffold(a: *A.Allocator, dest: str, id: *u8, is_lib: bool, entry_leaf: *u8,
    entry_label: *u8, force: bool, quiet: bool) err[fail.Fail] {
    val result: res[i64, fail.Fail] = scaffold_checked(a, dest, id, is_lib, entry_leaf, entry_label, force);
    if (sel result.err) { ret err[fail.Fail].err{result.err}; }
    if (!quiet) {
        print.eprint("created project '");
        print.eprint(id::str);
        print.eprint("'\n");
    }
    ret err[fail.Fail].ok{};
}

fun build_manifest_text(alloc: *A.Allocator, id: *u8, is_lib: bool, arch_id: u32) res[str, fail.Fail] {
    var buf: textbuild.TextBuilder = textbuild.tb_init(alloc);
    fin { textbuild.tb_dnit(?buf); }

    buf_put(?buf, "[project]\n");
    buf_put(?buf, "id = \"");
    buf_put(?buf, id);
    buf_put(?buf, "\"\n");
    buf_put(?buf, "version = \"0.1.0\"\n");
    val caret: res[str, std_format.FormatError] = driver_closure.running_mach_range_floor(alloc);
    if (sel caret.err) { ret res[str, fail.Fail].err{fail.message(fail.format_text(caret.err))}; }
    buf_put(?buf, "mach = \"");
    buf_put(?buf, caret.ok::*u8);
    buf_put(?buf, "\"\n");
    str_free(alloc, caret.ok);
    buf_put(?buf, "src = \"src\"\n");
    buf_put(?buf, "work = \"out/{target.name}/{profile.name}\"\n");
    buf_put(?buf, "\n");

    val reg_made: res[*lang_target.TargetRegistry, fail.Fail] = toolchain.registry();
    if (sel reg_made.err) { ret res[str, fail.Fail].err{fail.with_text(reg_made.err, "failed to register targets")}; }
    val reg:     *lang_target.TargetRegistry = reg_made.ok;
    var oses:    Vector[u32]                 = collections_vector.init[u32](alloc);
    val emitted: err[fail.Fail]              = emit_targets(?buf, reg, arch_id, ?oses);
    if (sel emitted.err) { ret res[str, fail.Fail].err{emitted.err}; }
    emit_artifacts(?buf, id, is_lib, ?oses);
    if (!is_lib) { emit_system_links(?buf, ?oses); }

    buf_put(?buf, "[profile.debug]\n");
    buf_put(?buf, "default = true\n");
    buf_put(?buf, "optimize = false\n");
    buf_put(?buf, "debug = true\n");
    buf_put(?buf, "simd = \"scalarize\"\n");
    buf_put(?buf, "\n");
    buf_put(?buf, "[profile.release]\n");
    buf_put(?buf, "optimize = true\n");
    buf_put(?buf, "debug = false\n");
    buf_put(?buf, "simd = \"scalarize\"\n");
    buf_put(?buf, "\n");

    val made: res[str, textbuild.Error] = textbuild.tb_finish(?buf);
    if (sel made.err) { ret res[str, fail.Fail].err{fail.message(textbuild.text(made.err))}; }
    ret res[str, fail.Fail].ok{made.ok};
}

fun emit_artifacts(b: *textbuild.TextBuilder, id: *u8, is_lib: bool, oses: *Vector[u32]) {
    buf_put(b, "[artifact.");
    buf_put(b, id);
    if (is_lib) {
        buf_put(b, "]\nkind = \"static\"\nentry = \"lib.mach\"\nout = \"{project.work}/lib/lib");
    }
    or {
        buf_put(b, "]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"{project.work}/bin/");
    }
    buf_put(b, id);
    buf_put(b, "{artifact.suffix}\"\ntargets = [\"*\"]\n");
    if (!is_lib) {
        var listed: usize = 0;
        var i:      usize = 0;
        for (i < oses.len) {
            val library: str = catalog_os.system_library(oses.data[i]);
            i = i + 1;
            if (str_empty(library)) { cnt; }
            if (listed == 0)        { buf_put(b, "link = ["); }
            or                      { buf_put(b, ", "); }
            buf_put(b, "\"");
            buf_put_stem(b, library);
            buf_put(b, "\"");
            listed = listed + 1;
        }
        if (listed > 0) { buf_put(b, "]\n"); }
    }
    # a library's public entry is only ever an explicitly exported artifact
    if (is_lib) { buf_put(b, "export = true\n"); }
    buf_put(b, "\n");
}

# a [link.<stem>] table for the system library of each scaffolded os that has one, bound to
# that os
fun emit_system_links(b: *textbuild.TextBuilder, oses: *Vector[u32]) {
    var i: usize = 0;
    for (i < oses.len) {
        val os_id:   u32 = oses.data[i];
        val library: str = catalog_os.system_library(os_id);
        i = i + 1;
        if (str_empty(library)) { cnt; }
        buf_put(b, "[link.");
        buf_put_stem(b, library);
        buf_put(b, "]\nsource = \"system\"\nname = \"");
        buf_put(b, library::*u8);
        buf_put(b, "\"\nos = [\"");
        buf_put(b, catalog_os.name_for(os_id)::*u8);
        buf_put(b, "\"]\nisa = [\"*\"]\nabi = [\"*\"]\n\n");
    }
}

# a library's name up to its first '.', the key its link table goes by
fun buf_put_stem(b: *textbuild.TextBuilder, library: str) {
    var one: [2]u8;
    one[1] = 0;
    var n: usize = 0;
    for (library[n] != 0 && library[n] != '.') {
        one[0] = library[n];
        textbuild.tb_append(b, (?one[0])::str);
        n = n + 1;
    }
}

val BIN_SOURCE_TEMPLATE: str = "use std.print;\nuse std.runtime;\n\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i64 {\n    print.println(\"Hello, World!\");\n    ret 0;\n}\n";

fun source_template(is_lib: bool) *u8 {
    if (is_lib) { ret ""; }
    ret BIN_SOURCE_TEMPLATE::*u8;
}

# a failed append poisons the builder, which tb_finish reports
fun buf_put(b: *textbuild.TextBuilder, s: *u8) {
    textbuild.tb_append(b, s::str);
}

fun default_project_id(a: *A.Allocator, cwd: str, dir: str) res[str, fail.Fail] {
    val abs_r: res[str, A.Error] = types_path.resolve(a, cwd, dir);
    if (sel abs_r.err) { ret res[str, fail.Fail].err{fail.refused(abs_r.err)}; }
    val clean_r: res[str, A.Error] = types_path.clean(a, abs_r.ok);
    if (sel clean_r.err) { ret res[str, fail.Fail].err{fail.refused(clean_r.err)}; }
    ret res[str, fail.Fail].ok{types_path.filename(clean_r.ok)};
}

# a target for each hosted os, in catalog order, whose native abi for the isa the registry
# composes; oses receives the os of each target written
fun emit_targets(b: *textbuild.TextBuilder, reg: *lang_target.TargetRegistry, arch_id: u32, oses: *Vector[u32]) err[fail.Fail] {
    var i: usize = 0;
    for (i < catalog_os.count()) {
        val os_name: str = catalog_os.name_at(i);
        val os_id:   u32 = catalog_os.id_for(os_name);
        i = i + 1;
        if (!catalog_os.is_hosted(os_id)) { cnt; }
        val written: res[bool, fail.Fail] = emit_target(b, reg, os_name::*u8, arch_id);
        if (sel written.err) { ret err[fail.Fail].err{written.err}; }
        if (!written.ok)     { cnt; }
        val pushed: res[usize, A.Error] = collections_vector.push[u32](oses, os_id);
        if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
    }
    ret err[fail.Fail].ok{};
}

# whether a target for the os was written: false where the os has no native abi for the isa
fun emit_target(b: *textbuild.TextBuilder, reg: *lang_target.TargetRegistry, os_name: *u8, arch_id: u32) res[bool, fail.Fail] {
    val abi_r: res[opt[str], fail.Fail] = scaffold_abi(reg, os_name::str, arch_id);
    if (sel abi_r.err)     { ret res[bool, fail.Fail].err{abi_r.err}; }
    if (sel abi_r.ok.none) { ret res[bool, fail.Fail].ok{false}; }
    val abi_name: str = abi_r.ok.some;
    val isa_name: str = catalog_arch.name_for(arch_id);
    buf_put(b, "[target.");
    buf_put(b, os_name);
    buf_put(b, "-");
    buf_put(b, isa_name::*u8);
    buf_put(b, "]\n");
    buf_put(b, "isa = \"");
    buf_put(b, isa_name::*u8);
    buf_put(b, "\"\n");
    buf_put(b, "os  = \"");
    buf_put(b, os_name);
    buf_put(b, "\"\n");
    buf_put(b, "abi = \"");
    buf_put(b, abi_name::*u8);
    buf_put(b, "\"\n");
    buf_put(b, "\n");
    ret res[bool, fail.Fail].ok{true};
}

# the abi init scaffolds for the system and isa, none where the pair has no
# native abi or the registry refuses the tuple
fun scaffold_abi(reg: *lang_target.TargetRegistry, os_name: str, arch_id: u32) res[opt[str], fail.Fail] {
    val os_opt: opt[*lang_target_os.OsVTable] = target_registry.find[lang_target_os.OsVTable](?reg.os, os_name);
    if (sel os_opt.none) { ret res[opt[str], fail.Fail].ok{opt[str].none{}}; }
    val abi_name: str = lang_target_os.native_abi_for(os_opt.some, arch_id);
    if (str_empty(abi_name)) { ret res[opt[str], fail.Fail].ok{opt[str].none{}}; }
    val select_r: res[lang_target.Binding, fail.Fail] = lang_target.select(reg, catalog_arch.name_for(arch_id), os_name, abi_name);
    if (sel select_r.err) {
        if (fail.is_message(select_r.err)) { ret res[opt[str], fail.Fail].err{select_r.err}; }
        ret res[opt[str], fail.Fail].ok{opt[str].none{}};
    }
    ret res[opt[str], fail.Fail].ok{opt[str].some{abi_name}};
}

#[testing]
fun t_scaffold_abi_is(reg: *lang_target.TargetRegistry, os_name: str, arch_id: u32, want: str) bool {
    val r: res[opt[str], fail.Fail] = scaffold_abi(reg, os_name, arch_id);
    if (sel r.err)     { ret false; }
    if (sel r.ok.none) { ret str_empty(want); }
    ret str_equals(r.ok.some, want);
}

#[testing]
fun t_manifest_from_text(a: *A.Allocator, itn: *intern.Interner, text: str) opt[manifest.Manifest] {
    val tr: res[manifest.Doc, fail.Fail] = manifest.doc_parse(a, manifest.MANIFEST_FILE, text);
    if (sel tr.err) { ret opt[manifest.Manifest].none{}; }
    var doc: manifest.Doc                      = tr.ok;
    val mr:  res[manifest.Manifest, fail.Fail] = manifest.parse(a, itn, ?doc);
    manifest.doc_dnit(a, ?doc);
    if (sel mr.err) { ret opt[manifest.Manifest].none{}; }
    ret opt[manifest.Manifest].some{mr.ok};
}

#[testing]
fun t_scaffold_plan_units(a: *A.Allocator, id: *u8, is_lib: bool, arch_id: u32) i64 {
    val text_r: res[str, fail.Fail] = build_manifest_text(a, id, is_lib, arch_id);
    if (sel text_r.err) { ret -1; }
    val text: str = text_r.ok;

    var itn:   intern.Interner        = intern.init(a);
    val opt_m: opt[manifest.Manifest] = t_manifest_from_text(a, ?itn, text);
    if (sel opt_m.none) { ret -1; }
    var m: manifest.Manifest = opt_m.some;

    val reg_made: res[*lang_target.TargetRegistry, fail.Fail] = toolchain.registry();
    if (sel reg_made.err) { ret -1; }
    val reg: *lang_target.TargetRegistry = reg_made.ok;

    var rq: request.BuildRequest = request.defaults();
    rq.project_root = "/scaftest";
    rq.target       = "*";

    val pr: res[build_plan.BuildPlan, fail.Fail] = build_plan.plan(a, ?itn, reg, ?m, rq);
    if (sel pr.err) { ret -1; }
    val bp: build_plan.BuildPlan = pr.ok;
    ret bp.units.len::i64;
}

# both scaffolds parse and plan, and write no line that states nothing: an empty
# link or need list, or export = false
test build_manifest_text__both_scaffolds_parse_and_plan_for_every_host_arch {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var form: usize = 0;
    for (form < 2) {
        val is_lib: bool = form == 1;
        if (t_scaffold_plan_units(?alloc, "scaftest", is_lib, catalog_arch.X86_64) != 3)  { ret 2; }
        if (t_scaffold_plan_units(?alloc, "scaftest", is_lib, catalog_arch.AARCH64) != 2) { ret 3; }
        if (t_scaffold_plan_units(?alloc, "scaftest", is_lib, catalog_arch.RISCV64) != 1) { ret 4; }
        val text_r: res[str, fail.Fail] = build_manifest_text(?alloc, "scaftest", is_lib, catalog_arch.X86_64);
        if (sel text_r.err)                                                                                                            { ret 5; }
        if (str_contains(text_r.ok, "link = []") || str_contains(text_r.ok, "need = []") || str_contains(text_r.ok, "export = false")) { ret 6; }
        form = form + 1;
    }
    ret 0;
}

#[testing]
fun t_scaffold_profile_complete(itn: *intern.Interner, m: *manifest.Manifest, name: str, want_optimize: bool,
    want_debug: bool, want_default: bool) bool {
    var i: u32 = 0;
    for (i < m.profile_count) {
        val pf: *manifest.ProfileDef = ?m.profiles[i];
        val pn: opt[str]             = intern.get(itn, pf.name);
        if (sel pn.some && str_equals(pn.some, name)) {
            ret pf.optimize == want_optimize && pf.debug == want_debug && pf.simd == manifest.SIMD_SCALARIZE
                && pf.pass.count == 0 && pf.skip.count == 0 && pf.relax.count == 0 && pf.is_default == want_default;
        }
        i = i + 1;
    }
    ret false;
}

test build_manifest_text__scaffold_profiles_are_complete_and_one_is_default {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var forms: [2]bool;
    forms[0] = false;
    forms[1] = true;
    var fi: usize = 0;
    for (fi < 2) {
        val text_r: res[str, fail.Fail] = build_manifest_text(?alloc, "scaftest", forms[fi], catalog_arch.X86_64);
        if (sel text_r.err) { ret 2; }
        var itn:   intern.Interner        = intern.init(?alloc);
        val opt_m: opt[manifest.Manifest] = t_manifest_from_text(?alloc, ?itn, text_r.ok);
        if (sel opt_m.none) { ret 3; }
        var m: manifest.Manifest = opt_m.some;
        if (m.profile_count != 2)                                                  { ret 4; }
        if (!t_scaffold_profile_complete(?itn, ?m, "debug", false, true, true))    { ret 5; }
        if (!t_scaffold_profile_complete(?itn, ?m, "release", true, false, false)) { ret 6; }
        val omitted: res[manifest.ResolvedProfile, fail.Fail] = manifest.resolve_profile(?alloc, ?itn, ?m, "");
        if (sel omitted.err) { ret 7; }
        val rp: manifest.ResolvedProfile = omitted.ok;
        val rn: opt[str]                 = intern.get(?itn, rp.name);
        if (sel rn.none)                   { ret 8; }
        if (!str_equals(rn.some, "debug")) { ret 8; }
        fi = fi + 1;
    }
    ret 0;
}

test build_manifest_text__bin_scaffold_names_one_artifact_with_the_target_suffix {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val text_r: res[str, fail.Fail] = build_manifest_text(?alloc, "scaftest", false, catalog_arch.X86_64);
    if (sel text_r.err) { ret 2; }
    var itn:   intern.Interner        = intern.init(?alloc);
    val opt_m: opt[manifest.Manifest] = t_manifest_from_text(?alloc, ?itn, text_r.ok);
    if (sel opt_m.none) { ret 3; }
    var m: manifest.Manifest = opt_m.some;
    if (m.artifact_count != 1) { ret 4; }

    val reg_made: res[*lang_target.TargetRegistry, fail.Fail] = toolchain.registry();
    if (sel reg_made.err) { ret 5; }
    val reg: *lang_target.TargetRegistry = reg_made.ok;
    var rq:  request.BuildRequest        = request.defaults();
    rq.project_root = "/scaftest";
    rq.target       = "*";
    val pr: res[build_plan.BuildPlan, fail.Fail] = build_plan.plan(?alloc, ?itn, reg, ?m, rq);
    if (sel pr.err) { ret 6; }
    val bp: build_plan.BuildPlan = pr.ok;
    if (bp.units.len != 3) { ret 7; }
    var seen_exe: u32   = 0;
    var i:        usize = 0;
    for (i < bp.units.len) {
        val u: *build_plan.BuildUnit = ?bp.units.data[i];
        if (!str_equals(u.sel_artifact, "scaftest")) { ret 8; }
        val windows: bool = str_contains(u.out_path, "/windows-x86_64/");
        val exe:     bool = str_ends_with(u.out_path, "/bin/scaftest.exe");
        if (windows != exe)                                      { ret 9; }
        if (!exe && !str_ends_with(u.out_path, "/bin/scaftest")) { ret 10; }
        if (exe)                                                 { seen_exe = seen_exe + 1; }
        i = i + 1;
    }
    if (seen_exe != 1) { ret 11; }
    ret 0;
}

# a scaffolded source passes `mach fmt --check` as written
#[testing]
fun t_is_fmt_canonical(a: *A.Allocator, text: str) bool {
    var diags: diagnostic.DiagnosticStore = diagnostic.store_init(a);
    fin { diagnostic.store_dnit(?diags); }
    val formatted: res[str, fail.Fail] = fe_format.format_source(a, text, lang_source.FILE_NIL, ?diags);
    if (sel formatted.err) { ret false; }
    val same: bool = str_equals(formatted.ok, text);
    str_free(a, formatted.ok);
    ret same;
}

test source_template__lib_is_empty_and_both_are_fmt_canonical {
    if (!str_empty(source_template(true)::str)) { ret 1; }
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err)                                           { ret 1; }
    if (!t_is_fmt_canonical(?alloc, source_template(false)::str)) { ret 2; }
    if (!t_is_fmt_canonical(?alloc, source_template(true)::str))  { ret 3; }
    ret 0;
}

test build_manifest_text__states_the_compiler_range_and_leaves_dependencies_to_dep_add {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val text_r: res[str, fail.Fail] = build_manifest_text(?alloc, "scaftest", false, catalog_arch.X86_64);
    if (sel text_r.err) { ret 2; }
    val text: str = text_r.ok;
    if (str_contains(text, "[dep.")) { ret 3; }
    var itn:   intern.Interner        = intern.init(?alloc);
    val opt_m: opt[manifest.Manifest] = t_manifest_from_text(?alloc, ?itn, text);
    if (sel opt_m.none) { ret 4; }
    val m:      manifest.Manifest = opt_m.some;
    val mach_r: opt[str]          = intern.get(?itn, m.mach);
    if (sel mach_r.none) { ret 5; }
    val floor: res[str, std_format.FormatError] = driver_closure.running_mach_range_floor(?alloc);
    if (sel floor.err)                      { ret 6; }
    if (!str_equals(mach_r.some, floor.ok)) { ret 7; }
    # every 5.x compiler writes the key's own floor, never its own minor
    if (str_starts_with(lang_version.MACH_VERSION, "5.") && !str_equals(mach_r.some, "^5.3")) { ret 7; }
    if (m.dep_count != 0)                                                                     { ret 8; }
    ret 0;
}

#[testing]
fun t_git_in(a: *A.Allocator, dir: str, c1: str, c2: str, c3: str) bool {
    val gr: res[str, fail.Fail] = host.program_resolve(a, "git");
    if (sel gr.err) { ret false; }
    var av: [7]*u8;
    av[0] = gr.ok::*u8;
    av[1] = "-C"::*u8;
    av[2] = dir::*u8;
    var k: usize = 3;
    if (!str_empty(c1)) {
        av[k] = c1::*u8;
        k     = k + 1;
    }
    if (!str_empty(c2)) {
        av[k] = c2::*u8;
        k     = k + 1;
    }
    if (!str_empty(c3)) {
        av[k] = c3::*u8;
        k     = k + 1;
    }
    av[k] = nil;
    val rr: res[exec.ExitStatus, exec.Error] = exec.run(gr.ok, ?av[0], nil);
    if (sel rr.err) { ret false; }
    ret exec.exited(rr.ok) && exec.code(rr.ok) == 0;
}

# one tagged release of a fixture std whose manifest needs `mach_range`
#[testing]
fun t_std_release(a: *A.Allocator, dir: str, version: str, mach_range: str) bool {
    val body: res[str, std_format.FormatError] = std_format.sprint(a,
        "[project]\nid = \"std\"\nversion = \"{}\"\nmach = \"{}\"\nsrc = \"src\"\nwork = \"out\"\n[profile.debug]\noptimize = false\ndebug = false\nsimd = \"scalarize\"\n", version, mach_range);
    if (sel body.err) { ret false; }
    val file: str             = sfmt_join(a, dir, "mach.toml");
    val wr:   err[fs.FsError] = fs.write_bytes(file, body.ok::*u8, str_len(body.ok), 0o644);
    if (sel wr.err)                              { ret false; }
    if (!t_git_in(a, dir, "add", "-A", ""))      { ret false; }
    if (!t_git_in(a, dir, "commit", "-qm", "x")) { ret false; }
    val tag: res[str, std_format.FormatError] = std_format.sprint(a, "v{}", version);
    if (sel tag.err) { ret false; }
    ret t_git_in(a, dir, "tag", tag.ok, "");
}

# init adds std at the caret of the highest release whose [project].mach admits the running
# compiler, not a branch
test run__std_is_added_at_the_release_the_running_compiler_resolves {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }

    val std_r: res[str, fail.Fail] = t_scratch_dir(?a, "mach_init_fixture_std");
    if (sel std_r.err) { ret 2; }
    val std_dir: str = std_r.ok;
    fin { fs.remove_all(?a, std_dir); }
    val src_dir: str             = sfmt_join(?a, std_dir, "src");
    val made:    err[fs.FsError] = fs.create_dir_all(?a, src_dir, 0o755);
    if (sel made.err) { ret 3; }
    val lib:  str             = sfmt_join(?a, std_dir, "src/lib.mach");
    val body: str             = "pub fun hello() i32 { ret 1; }\n";
    val lw:   err[fs.FsError] = fs.write_bytes(lib, body::*u8, str_len(body), 0o644);
    if (sel lw.err)                                            { ret 3; }
    if (!t_git_in(?a, std_dir, "init", "-q", ""))              { ret 4; }
    if (!t_git_in(?a, std_dir, "config", "user.email", "t@t")) { ret 4; }
    if (!t_git_in(?a, std_dir, "config", "user.name", "t"))    { ret 4; }
    if (!t_std_release(?a, std_dir, "1.0.0", ">=5"))           { ret 5; }
    if (!t_std_release(?a, std_dir, "1.1.0", ">=5"))           { ret 5; }
    if (!t_std_release(?a, std_dir, "2.0.0", ">=99"))          { ret 5; }

    val root_r: res[str, fail.Fail] = t_scratch_dir(?a, "mach_init_std_range");
    if (sel root_r.err) { ret 6; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?a, root); }
    var argv: [6]*u8 = [6]*u8{"mach", "init", root::*u8, "--name", "rangeinit", "--no-deps"};
    if (t_init(6, ?argv[0]) != 0) { ret 7; }

    var deps: [1]ScaffoldDep = [1]ScaffoldDep{ScaffoldDep{id: "std", git: std_dir}};
    if (t_stage(?a, root, false, ?deps[0]) != 0) { ret 8; }
    val text: opt[str] = t_read_file(?a, sfmt_join(?a, root, "mach.toml"));
    if (sel text.none)                                    { ret 9; }
    if (!str_contains(text.some, "[dep.std]"))            { ret 10; }
    if (!str_contains(text.some, "version = \"^1.1.0\"")) { ret 11; }
    if (str_contains(text.some, "branch/"))               { ret 12; }
    val tagged: res[str, fail.Fail] = t_release_of(?a, root);
    if (sel tagged.err) { ret 13; }
    fin { str_free(?a, tagged.ok); }
    if (!str_equals(tagged.ok, "1.1.0")) { ret 14; }
    ret 0;
}

# --no-deps still resolves and writes the range but checks nothing out, and an unreachable
# source is a failure rather than a silently unpinned declaration
test run__no_deps_resolves_the_range_without_a_checkout {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }

    val std_r: res[str, fail.Fail] = t_scratch_dir(?a, "mach_init_nodeps_std");
    if (sel std_r.err) { ret 2; }
    val std_dir: str = std_r.ok;
    fin { fs.remove_all(?a, std_dir); }
    val made: err[fs.FsError] = fs.create_dir_all(?a, sfmt_join(?a, std_dir, "src"), 0o755);
    if (sel made.err) { ret 3; }
    val body: str             = "pub fun hello() i32 { ret 1; }\n";
    val lw:   err[fs.FsError] = fs.write_bytes(sfmt_join(?a, std_dir, "src/lib.mach"), body::*u8, str_len(body), 0o644);
    if (sel lw.err)                                            { ret 3; }
    if (!t_git_in(?a, std_dir, "init", "-q", ""))              { ret 4; }
    if (!t_git_in(?a, std_dir, "config", "user.email", "t@t")) { ret 4; }
    if (!t_git_in(?a, std_dir, "config", "user.name", "t"))    { ret 4; }
    if (!t_std_release(?a, std_dir, "1.0.0", ">=5"))           { ret 5; }
    if (!t_std_release(?a, std_dir, "2.0.0", ">=99"))          { ret 5; }

    val root_r: res[str, fail.Fail] = t_scratch_dir(?a, "mach_init_nodeps_root");
    if (sel root_r.err) { ret 6; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?a, root); }
    var argv: [6]*u8 = [6]*u8{"mach", "init", root::*u8, "--name", "nodepsinit", "--no-deps"};
    if (t_init(6, ?argv[0]) != 0) { ret 7; }

    var deps: [1]ScaffoldDep = [1]ScaffoldDep{ScaffoldDep{id: "std", git: std_dir}};
    if (t_stage(?a, root, true, ?deps[0]) != 0) { ret 8; }
    val text: opt[str] = t_read_file(?a, sfmt_join(?a, root, "mach.toml"));
    if (sel text.none)                                    { ret 9; }
    if (!str_contains(text.some, "version = \"^1.0.0\"")) { ret 10; }
    val checkout: res[bool, io_error.Error] = fs.exists(sfmt_join(?a, root, "dep/std"));
    if (sel checkout.err) { ret 11; }
    if (checkout.ok)      { ret 12; }

    # the hint names the command pull's refusal names, and that command realizes the release
    val hint:    res[str, fail.Fail] = no_deps_hint(?a, root, "std");
    val refusal: res[str, fail.Fail] = package_closure.unpinned_refusal(?a, root, "std", "^1.0.0");
    if (sel hint.err)    { ret 18; }
    if (sel refusal.err) { ret 18; }
    val hinted:  str = t_backticked(?a, hint.ok);
    val refused: str = t_backticked(?a, refusal.ok);
    if (str_empty(hinted) || !str_equals(hinted, refused))               { ret 18; }
    if (cmd_dep.t_pull(root, true, git.t_file_transport_environ()) != 1) { ret 19; }
    var words: [8]*u8;
    val n:     usize = t_split_words(hinted, ?words[0], 7);
    if (n != 5) { ret 20; }
    val parsed: res[args.ParsedInvocation, fail.Fail] = args.parse_command(?a, ?cmd_dep.COMMAND, n, ?words[0]);
    if (sel parsed.err) { ret 21; }
    var inv: args.ParsedInvocation = parsed.ok;
    if (sel inv.refusal.some) { ret 21; }
    inv.environ = git.t_file_transport_environ();
    if (args.run(?inv, ?words[0]) != 0) { ret 22; }
    val pinned: res[str, fail.Fail] = t_release_of(?a, root);
    if (sel pinned.err) { ret 23; }
    fin { str_free(?a, pinned.ok); }
    if (!str_equals(pinned.ok, "1.0.0"))                                 { ret 24; }
    if (cmd_dep.t_pull(root, true, git.t_file_transport_environ()) != 0) { ret 25; }

    val bare_r: res[str, fail.Fail] = t_scratch_dir(?a, "mach_init_nodeps_unreachable");
    if (sel bare_r.err) { ret 13; }
    val bare: str = bare_r.ok;
    fin { fs.remove_all(?a, bare); }
    argv[2] = bare::*u8;
    if (t_init(6, ?argv[0]) != 0) { ret 14; }
    var gone: [1]ScaffoldDep = [1]ScaffoldDep{ScaffoldDep{id: "std", git: sfmt_join(?a, std_dir, "absent")}};
    if (t_stage(?a, bare, true, ?gone[0]) == 0) { ret 15; }
    val kept: opt[str] = t_read_file(?a, sfmt_join(?a, bare, "mach.toml"));
    if (sel kept.none)                        { ret 16; }
    if (str_contains(kept.some, "[dep.std]")) { ret 17; }
    ret 0;
}

#[testing]
fun t_release_of(a: *A.Allocator, root: str) res[str, fail.Fail] {
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(a);
    if (sel sr.err) { ret res[str, fail.Fail].err{fail.message("session")}; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    ret git_checkout.release_at_head(?s, sfmt_join(a, root, "dep/std"));
}

#[testing]
fun t_source_parses(alloc: *A.Allocator, text: str) bool {
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(alloc);
    if (sel sr.err) { ret false; }
    var s:  session.Session      = sr.ok;
    var es: editor.EditorSession = editor.init(?s);

    val open_r: res[lang_source.FileId, fail.Fail] = editor.open(?es, "/mach-init-standalone-parse-check/entry.mach", text);
    if (sel open_r.err) {
        editor.dnit(?es);
        session.dnit(?s);
        ret false;
    }
    val fid: lang_source.FileId = open_r.ok;

    var req:      editor.AnalysisRequest                = editor.analysis_request(fid, editor.PHASE_PARSE);
    val analyzed: res[editor.AnalysisResult, fail.Fail] = editor.analyze(?es, ?req);
    var ok:       bool                                  = false;
    if (sel analyzed.ok) {
        var result: editor.AnalysisResult = analyzed.ok;
        ok = sel result.status.kind.accepted && !diagnostic.has_errors(result.diagnostics);
        editor.analysis_dnit(?result);
    }
    if (sel analyzed.err) {
        var failure: fail.Fail = analyzed.err;
        editor.fail_dnit(?es, ?failure);
    }

    val dnit_r2: err[fail.Fail] = editor.dnit(?es);
    session.dnit(?s);
    ret ok;
}

#[testing]
fun t_entry_parses(alloc: *A.Allocator, dest: str, entry_rel: str) bool {
    val p_r: res[str, A.Error] = types_path.join(alloc, dest, entry_rel);
    if (sel p_r.err) { ret false; }
    val p:        str      = p_r.ok;
    val text_opt: opt[str] = t_read_file(alloc, p);
    str_free(alloc, p);
    if (sel text_opt.none) { ret false; }
    ret t_source_parses(alloc, text_opt.some);
}

test run__the_scaffolded_sources_parse {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val root_r: res[str, fail.Fail] = t_scratch_dir(?alloc, "mach_init_e2e");
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    fin {
        fs.remove_all(?alloc, root);
        str_free(?alloc, root);
    }
    val bin:      str    = sfmt_join(?alloc, root, "bin");
    var bin_argv: [6]*u8 = [6]*u8{"mach", "init", bin::*u8, "--name", "proj", "--no-deps"};
    if (t_init(6, ?bin_argv[0]) != 0)                  { ret 2; }
    if (!t_entry_parses(?alloc, bin, "src/main.mach")) { ret 3; }
    val lib:      str    = sfmt_join(?alloc, root, "lib");
    var lib_argv: [7]*u8 = [7]*u8{"mach", "init", lib::*u8, "--name", "proj", "--lib", "--no-deps"};
    if (t_init(7, ?lib_argv[0]) != 0)                 { ret 4; }
    if (!t_entry_parses(?alloc, lib, "src/lib.mach")) { ret 5; }
    ret 0;
}

test scaffold_abi__derives_the_abi_of_each_arch_and_skips_unsupported_systems {
    val reg_made: res[*lang_target.TargetRegistry, fail.Fail] = toolchain.registry();
    if (sel reg_made.err) { ret 1; }
    val reg: *lang_target.TargetRegistry = reg_made.ok;
    if (!t_scaffold_abi_is(reg, "linux", catalog_arch.X86_64, "sysv64"))    { ret 2; }
    if (!t_scaffold_abi_is(reg, "windows", catalog_arch.X86_64, "win64"))   { ret 3; }
    if (!t_scaffold_abi_is(reg, "darwin", catalog_arch.AARCH64, "aapcs64")) { ret 4; }
    if (!t_scaffold_abi_is(reg, "windows", catalog_arch.AARCH64, ""))       { ret 5; }
    if (!t_scaffold_abi_is(reg, "linux", catalog_arch.RISCV64, "lp64d"))    { ret 6; }
    if (!t_scaffold_abi_is(reg, "darwin", catalog_arch.RISCV64, ""))        { ret 7; }
    ret 0;
}

#[testing]
fun t_scratch_dir(alloc: *A.Allocator, prefix: str) res[str, fail.Fail] {
    val tf_r: res[fs.TempFile, fs.FsError] = fs.temp_create(alloc, prefix);
    if (sel tf_r.err) { ret res[str, fail.Fail].err{fail.user(diagnostic_kind.FS_TEMP, fail.fs_text(tf_r.err))}; }
    var tf:     fs.TempFile                     = tf_r.ok;
    val root_r: res[str, types_string.StrError] = str_copy_slice(alloc, fs.temp_path(?tf), 0, str_len(fs.temp_path(?tf)));
    fs.temp_close_and_remove(?tf);
    if (sel root_r.err) { ret res[str, fail.Fail].err{fail.message(fail.str_text(root_r.err))}; }
    val root:         str                 = root_r.ok;
    val create_dir_r: err[io_error.Error] = fs.create_dir(root, 0o755);
    if (sel create_dir_r.err) { ret res[str, fail.Fail].err{fail.user(diagnostic_kind.FS_CREATE, "cannot create scratch root")}; }
    ret res[str, fail.Fail].ok{root};
}

# an owned copy of the text inside the last "run `...`" span, or "" when there is none
#[testing]
fun t_backticked(a: *A.Allocator, msg: str) str {
    val n:     usize = str_len(msg);
    var start: usize = n;
    var i:     usize = 0;
    for (i + 5 < n) {
        if (str_starts_with((?msg[i])::str, "run `")) { start = i + 5; }
        i = i + 1;
    }
    var end: usize = start;
    for (end < n && msg[end] != '`') { end = end + 1; }
    if (end >= n) { ret ""; }
    val copy: res[str, A.Error] = str_dup_range(a, msg, start, end - start);
    if (sel copy.err) { ret ""; }
    ret copy.ok;
}

# split owned text in place at spaces into a nil-terminated argv of at most max words
#[testing]
fun t_split_words(text: str, argv: **u8, max: usize) usize {
    val p:     *u8   = text::*u8;
    var n:     usize = 0;
    var i:     usize = 0;
    var fresh: bool  = true;
    for (p[i] != 0) {
        if (p[i] == ' ') {
            p[i]  = 0;
            fresh = true;
        }
        or {
            if (fresh) {
                if (n == max) { ret 0; }
                argv[n] = ?p[i];
                n       = n + 1;
            }
            fresh = false;
        }
        i = i + 1;
    }
    argv[n] = nil;
    ret n;
}

#[testing]
fun t_read_file(alloc: *A.Allocator, path: str) opt[str] {
    val rb: res[Vector[u8], fs.FsError] = fs.read_bytes(alloc, path);
    if (sel rb.err) { ret opt[str].none{}; }
    var v:  Vector[u8]                      = rb.ok;
    val rr: res[str, types_string.StrError] = str_copy_slice(alloc, v.data::str, 0, v.len);
    collections_vector.dnit[u8](?v);
    if (sel rr.err) { ret opt[str].none{}; }
    ret opt[str].some{rr.ok};
}

test default_project_id__is_the_final_component_of_the_resolved_destination {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var bad: i32 = 0;

    var dirs: [6]str;
    dirs[0] = "p1";
    dirs[1] = "p1/";
    dirs[2] = "./p1";
    dirs[3] = "/tmp/other/p1";
    dirs[4] = ".";
    dirs[5] = "a/../b";
    var want: [6]str;
    want[0] = "p1";
    want[1] = "p1";
    want[2] = "p1";
    want[3] = "p1";
    want[4] = "x";
    want[5] = "b";
    var i: usize = 0;
    for (i < 6) {
        val r: res[str, fail.Fail] = default_project_id(?alloc, "/home/x", dirs[i]);
        if (!(sel r.ok && str_equals(r.ok, want[i]))) { bad = 1; }
        i = i + 1;
    }
    ret bad;
}

test run__a_destination_that_already_exists_before_the_call_routes_to_the_existing_branch {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val root_r: res[str, fail.Fail] = t_scratch_dir(?alloc, "mach_init_preexisting");
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;

    val dest_r: res[str, A.Error] = types_path.join(?alloc, root, "proj");
    if (sel dest_r.err) { ret 99; }
    val dest:         str                 = dest_r.ok;
    val create_dir_r: err[io_error.Error] = fs.create_dir(dest, 0o755);
    if (sel create_dir_r.err) {
        fs.remove_all(?alloc, root);
        str_free(?alloc, root);
        ret 1;
    }
    val sentinel_r: res[str, A.Error] = types_path.join(?alloc, dest, "sentinel.txt");
    if (sel sentinel_r.err) { ret 99; }
    val sentinel:      str             = sentinel_r.ok;
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(sentinel, "mine"::*u8, 4::usize, 0o644);
    if (sel write_bytes_r.err) {
        fs.remove_all(?alloc, root);
        str_free(?alloc, root);
        ret 1;
    }

    var argv: [6]*u8;
    argv[0] = "mach";
    argv[1] = "init";
    argv[2] = dest::*u8;
    argv[3] = "--name";
    argv[4] = "proj"::*u8;
    argv[5] = "--no-deps"::*u8;

    val rc: i64 = t_init(6, ?argv[0]);

    var bad: i32 = 0;
    if (rc != 0) { bad = 1; }
    val exists_r: res[bool, io_error.Error] = fs.exists(sentinel);
    if (sel exists_r.err)                  { ret 99; }
    if (!(sel exists_r.ok && exists_r.ok)) { bad = 1; }
    val toml_r: res[str, A.Error] = types_path.join(?alloc, dest, "mach.toml");
    if (sel toml_r.err) { ret 99; }
    val exists_r2: res[bool, io_error.Error] = fs.exists(toml_r.ok);
    if (sel exists_r2.err)                   { ret 99; }
    if (!(sel exists_r2.ok && exists_r2.ok)) { bad = 1; }

    fs.remove_all(?alloc, root);
    str_free(?alloc, root);
    ret bad;
}

