}

test "mach.cli.cmd.init.run_typed:an_absolute_or_slash_terminated_destination_names_the_project_after_its_last_component" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val root_r: R.Result[str, str] = t_scratch_dir(?alloc, "mach_init_absid");
    if (R.is_err[str, str](root_r)) { ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);
    var bad: i32 = 0;

    val abs_dest: str = R.unwrap_ok[str, str](path.join(?alloc, root, "absproj"));
    var argv: [4]*u8;
    argv[0] = "mach"; argv[1] = "init"; argv[2] = abs_dest::*u8; argv[3] = "--no-deps"::*u8;
    if (t_init(4, ?argv[0]) != 0) { bad = 1; }
    val abs_toml: str = R.unwrap_ok[str, str](path.join(?alloc, abs_dest, "mach.toml"));
    val abs_text: R.Result[str, str] = fs.read_string(?alloc, abs_toml);
    if (R.is_err[str, str](abs_text) || !str_contains(R.unwrap_ok[str, str](abs_text), "id = \"absproj\"")) { bad = 1; }

    val slash_dest: str = R.unwrap_ok[str, str](path.join(?alloc, root, "slashproj/"));
    argv[2] = slash_dest::*u8;
    if (t_init(4, ?argv[0]) != 0) { bad = 1; }
    val slash_toml: str = R.unwrap_ok[str, str](path.join(?alloc, slash_dest, "mach.toml"));
    val slash_text: R.Result[str, str] = fs.read_string(?alloc, slash_toml);
    if (R.is_err[str, str](slash_text) || !str_contains(R.unwrap_ok[str, str](slash_text), "id = \"slashproj\"")) { bad = 1; }

    fs.remove_all(?alloc, root);
    str_free(?alloc, root);
    ret bad;
}

