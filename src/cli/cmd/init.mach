    var want: [6]str;
    want[0] = "p1"; want[1] = "p1"; want[2] = "p1"; want[3] = "p1"; want[4] = "x"; want[5] = "b";
    var i: usize = 0;
    for (i < 6) {
        val r: res[str, outcome.Fail] = default_project_id(?alloc, "/home/x", dirs[i]);
