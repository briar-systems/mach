val DIR_MODE:  i32 = 493;
val FILE_MODE: i32 = 420;

rec Buf {
    ptr: *u8;
    cap: usize;
    len: usize;
    ok:  bool;
}

# `mach init`: scaffold a project. the positional names the directory (default the working
# directory) and, unless `--name` is given, the project id, which must be a portable
# identifier. an absent directory is created whole; an existing one is filled in, and
# `--force` allows overwriting mach.toml and the entry file. `--lib` writes src/lib.mach
# and a static artifact instead of src/root.mach and binary artifacts. the std dependency
# is then realized as a git submodule unless `--no-deps`; `--quiet` silences progress
# ---
# argv: the full process arguments
# inv: the parsed invocation for this command
# ret: 0 success, 1 an invalid id, a refused overwrite, or a failed publish, 2 allocator or
#  filesystem failure, 3 the std dependency could not be realized
pub fun run_typed(argv: **u8, inv: *args.ParsedInvocation) i64 {
    if (args.reject_unknown_from_invocation(inv, argv, "mach init")) { ret 1; }
    val parsed: args.InitInvocation = args.build_init_invocation(inv, argv);
    val force:   bool = parsed.force;
    val is_lib:  bool = parsed.is_lib;
    val no_deps: bool = parsed.no_deps;
    val no_git: bool = parsed.no_git;
    val quiet:   bool = parsed.quiet;

    var backing: A.Allocator;
    if (O.is_some[str](page.make(?backing))) {
        print.eprint("error: failed to initialise allocator\n");
        ret 2;
    }
    var ar: arena.Arena;
    if (O.is_some[str](arena.init(?ar, ?backing, 0))) {
        print.eprint("error: failed to initialise allocator\n");
        ret 2;
    }
    var a: A.Allocator;
    if (O.is_some[str](arena.make(?a, ?ar))) {
        arena.dnit(?ar);
        print.eprint("error: failed to initialise allocator\n");
        ret 2;
    }

    val cwd_r: R.Result[str, str] = env.current_dir(?a);
    if (R.is_err[str, str](cwd_r)) {
        print.eprint("error: failed to read the working directory\n");
        arena.dnit(?ar);
        ret 2;
    }
    val cwd: str = R.unwrap_ok[str, str](cwd_r);

    var dir: *u8 = cwd;
    if (parsed.has_dir) { dir = argv[parsed.dir_idx]; }

    val id_r: R.Result[str, str] = default_project_id(?a, cwd, dir::str);
    if (R.is_err[str, str](id_r)) {
        print.eprint("error: out of memory\n");
        arena.dnit(?ar);
        ret 2;
    }
    var id: *u8 = R.unwrap_ok[str, str](id_r);
    if (parsed.has_name) { id = argv[parsed.name_idx]; }

    if (!manifest.is_valid_id(id::str)) {
        print.eprint("error: '");
        print.eprint(id::str);
        print.eprint("' is not a valid project id\n");
        print.eprint("       a project id may contain only letters, digits, '_', or '-' (no '.', '/', or spaces)\n");
        print.eprint("       pass a valid name as the argument or with --name <name>\n");
        arena.dnit(?ar);
        ret 1;
    }

    var entry_leaf:  *u8 = "root.mach";
    var entry_label: *u8 = "src/root.mach";
    if (is_lib) {
        entry_leaf  = "lib.mach";
        entry_label = "src/lib.mach";
    }

    val split_r: R.Result[DestSplit, str] = split_for_discovery(?a, cwd, dir::str);
    if (R.is_err[DestSplit, str](split_r)) {
        print.eprint("error: out of memory\n");
        arena.dnit(?ar);
        ret 2;
    }
    var split: DestSplit = R.unwrap_ok[DestSplit, str](split_r);
    if (path.is_abs(dir::str)) {
        val anchored: O.Option[txn.Error] = anchor_absolute_parent(?a, ?split);
        if (O.is_some[txn.Error](anchored)) {
            print.eprintlnf("error: {}", txn_msg(O.unwrap[txn.Error](anchored)));
            arena.dnit(?ar);
            ret 2;
        }
    }

    var mp: txn.Descent;
    val disc_r: R.Result[bool, txn.Error] =
        txn.descend(?mp, ?a, split.root, split.dest_rel);
    if (R.is_err[bool, txn.Error](disc_r)) {
        print.eprint("error: ");
        print.eprint(txn.error_message(R.unwrap_err[bool, txn.Error](disc_r)));
        print.eprint("\n");
        arena.dnit(?ar);
        ret 1;
    }
    val missing: bool = R.unwrap_ok[bool, txn.Error](disc_r);

    val dest_root_r: R.Result[str, str] = path.join(?a, split.root, split.dest_rel);
    if (R.is_err[str, str](dest_root_r)) {
        if (missing) {
            val closed: O.Option[txn.Error] = txn.descent_dnit(?a, ?mp);
            if (O.is_some[txn.Error](closed)) { print.eprint("error: "); print.eprint(txn_msg(O.unwrap[txn.Error](closed))); print.eprint("\n"); }
        }
        print.eprint("error: out of memory\n");
        arena.dnit(?ar);
        ret 2;
    }
    val dest_root: str = R.unwrap_ok[str, str](dest_root_r);

    if (missing) {
        val code: i64 = run_absent_branch(?a, ?mp, id, is_lib, entry_label, quiet);
        if (code == 0) {
            val dep_code: i64 = dependency_stage(?a, dest_root, no_deps, no_git, quiet);
            arena.dnit(?ar);
            ret dep_code;
        }
        arena.dnit(?ar);
        ret code;
    }

    val code: i64 = run_existing_branch(?a, split.root, split.dest_rel, id, is_lib, entry_leaf, entry_label, force, quiet);
    if (code == 0) {
        val dep_code: i64 = dependency_stage(?a, dest_root, no_deps, no_git, quiet);
        arena.dnit(?ar);
        ret dep_code;
    }
    arena.dnit(?ar);
    ret code;
}

fun t_init(argc: usize, argv: **u8) i64 {
    var a: A.Allocator;
    if (O.is_some[str](page.make(?a))) { ret 2; }
    val ir: R.Result[args.ParsedInvocation, str] = args.parse_invocation(?a, argc, argv);
    if (R.is_err[args.ParsedInvocation, str](ir)) { ret 2; }
    var inv: args.ParsedInvocation = R.unwrap_ok[args.ParsedInvocation, str](ir);
    ret run_typed(argv, ?inv);
}

rec ScaffoldDep {
    id:  str;
    git: str;
    ref: str;
}

val SCAFFOLD_DEP_COUNT: usize = 1;
val SCAFFOLD_DEPS: [1]ScaffoldDep = [1]ScaffoldDep{
    ScaffoldDep{ id: "std", git: "https://github.com/briar-systems/mach-std", ref: "branch/main" }
};

fun dependency_stage(a: *A.Allocator, root: str, no_deps: bool, no_git: bool, quiet: bool) i64 {
    val sr: R.Result[session.Session, str] = session.init(a);
    if (R.is_err[session.Session, str](sr)) {
        val fail: outcome.Fail = outcome.internal("failed to initialize project setup");
        ret cli_diag.render_fail(?fail);
    }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    fin { session.dnit(?s); }
    var mode: u8 = ddep.REALIZE_NESTED;
    if (!no_git) {
        val initialized: R.Result[R.Void, str] = ddep.initialize_repository(?s, root);
        if (R.is_err[R.Void, str](initialized)) {
            val fail: outcome.Fail = outcome.environment(R.unwrap_err[R.Void, str](initialized));
            ret cli_diag.render_fail(?fail);
        }
        val selected: R.Result[u8, str] = ddep.realization_mode(?s, root);
        if (R.is_err[u8, str](selected)) {
            val fail: outcome.Fail = outcome.environment(R.unwrap_err[u8, str](selected));
            ret cli_diag.render_fail(?fail);
        }
        mode = R.unwrap_ok[u8, str](selected);
    }
    if (no_deps) {
        if (!quiet) { print.eprint("dependencies declared but not realized; run `mach dep pull` to realize them\n"); }
        ret 0;
    }
    var i: usize = 0;
    for (i < SCAFFOLD_DEP_COUNT) {
        val dep: ScaffoldDep = SCAFFOLD_DEPS[i];
        val realized: R.Result[R.Void, str] = ddep.realize_git_dependency(?s, root, dep.id, dep.git, dep.ref, mode);
        if (R.is_err[R.Void, str](realized)) {
            val msg_r: R.Result[str, str] = format.sprint(a,
                "dependency '{}' could not be realized: {}", dep.id, R.unwrap_err[R.Void, str](realized));
            if (R.is_err[str, str](msg_r)) {
                val fail: outcome.Fail = outcome.environment("a declared dependency could not be realized");
                ret cli_diag.render_fail(?fail);
            }
            val fail: outcome.Fail = outcome.environment(R.unwrap_ok[str, str](msg_r));
            ret cli_diag.render_fail(?fail);
        }
        if (!quiet) { print.eprintlnf("realized dependency '{}'", dep.id); }
        i = i + 1;
    }
    ret 0;
}

rec DestSplit {
    root:     str;
    dest_rel: str;
}

fun split_for_discovery(alloc: *A.Allocator, cwd: str, dir: str) R.Result[DestSplit, str] {
    val cleaned_r: R.Result[str, str] = path.clean(alloc, dir);
    if (R.is_err[str, str](cleaned_r)) { ret R.err[DestSplit, str](R.unwrap_err[str, str](cleaned_r)); }
    val cleaned: str = R.unwrap_ok[str, str](cleaned_r);
    fin { str_free(alloc, cleaned); }

    var root_source: str = cwd;
    var root_len: usize = str_len(cwd);
    var relative_start: usize = 0;
    val cleaned_len: usize = str_len(cleaned);
    if (path.is_abs(cleaned)) {
        root_source = cleaned;
        root_len = path.root(cleaned).len;
        relative_start = root_len;
        for (relative_start < cleaned_len && path.is_separator(cleaned[relative_start])) {
            relative_start = relative_start + 1;
        }
    }
    or (str_equals(cleaned, ".")) { relative_start = cleaned_len; }

    val root_r: R.Result[str, str] = str_copy_slice(alloc, root_source, 0, root_len);
    if (R.is_err[str, str](root_r)) { ret R.err[DestSplit, str](R.unwrap_err[str, str](root_r)); }
    var ds: DestSplit;
    ds.root = R.unwrap_ok[str, str](root_r);
    val relative_r: R.Result[str, str] = str_copy_slice(alloc, cleaned, relative_start, cleaned_len - relative_start);
    if (R.is_err[str, str](relative_r)) {
        str_free(alloc, ds.root);
        ret R.err[DestSplit, str](R.unwrap_err[str, str](relative_r));
    }
    ds.dest_rel = R.unwrap_ok[str, str](relative_r);
    var i: usize = 0;
    for (ds.dest_rel[i] != 0) {
        if (path.is_separator(ds.dest_rel[i])) { ds.dest_rel[i] = '/'; }
        i = i + 1;
    }
    ret R.ok[DestSplit, str](ds);
}

fun anchor_absolute_parent(alloc: *A.Allocator, split: *DestSplit) O.Option[txn.Error] {
    val n: usize = str_len(split.dest_rel);
    if (n == 0) { ret O.none[txn.Error](); }
    var cut: usize = n;
    for (cut > 0 && split.dest_rel[cut - 1] != '/'::u8) { cut = cut - 1; }
    var parent_end: usize = 0;
    if (cut > 0) { parent_end = cut - 1; }
    for (parent_end > 0) {
        val prefix_r: R.Result[str, str] = str_copy_slice(alloc, split.dest_rel, 0, parent_end);
        if (R.is_err[str, str](prefix_r)) { ret O.some[txn.Error](txn.error(txn.MEMORY, txn.OP_ROOT_OPEN)); }
        val prefix: str = R.unwrap_ok[str, str](prefix_r);
        val parent_r: R.Result[str, str] = path.join(alloc, split.root, prefix);
        str_free(alloc, prefix);
        if (R.is_err[str, str](parent_r)) { ret O.some[txn.Error](txn.error(txn.MEMORY, txn.OP_ROOT_OPEN)); }
        val parent: str = R.unwrap_ok[str, str](parent_r);
        var probe: txn.Root;
        val opened: O.Option[txn.Error] = txn.root_open(?probe, parent, "");
        if (O.is_none[txn.Error](opened)) {
            val closed: O.Option[txn.Error] = txn.root_dnit(?probe);
            if (O.is_some[txn.Error](closed)) { str_free(alloc, parent); ret closed; }
            var start: usize = parent_end;
            if (start < n && split.dest_rel[start] == '/'::u8) { start = start + 1; }
            val suffix_r: R.Result[str, str] = str_copy_slice(alloc, split.dest_rel, start, n - start);
            if (R.is_err[str, str](suffix_r)) {
                str_free(alloc, parent);
                ret O.some[txn.Error](txn.error(txn.MEMORY, txn.OP_ROOT_OPEN));
            }
            str_free(alloc, split.root);
            str_free(alloc, split.dest_rel);
            split.root = parent;
            split.dest_rel = R.unwrap_ok[str, str](suffix_r);
            ret O.none[txn.Error]();
        }
        str_free(alloc, parent);
        val error: txn.Error = O.unwrap[txn.Error](opened);
        if (error.kind != txn.IO || error.code != os.ENOENT) { ret opened; }
        cut = parent_end;
        for (cut > 0 && split.dest_rel[cut - 1] != '/'::u8) { cut = cut - 1; }
        parent_end = 0;
        if (cut > 0) { parent_end = cut - 1; }
    }
    ret O.none[txn.Error]();
}

# place an inventory path under the part of the destination that is missing
#
# the transaction publishes one component, so when the destination is several
# levels below the deepest existing directory, everything the scaffold contains
# has to be addressed relative to that one component rather than to the
# destination itself.
fun under_remainder(a: *A.Allocator, remainder: str, rel: str) R.Result[str, str] {
    if (str_empty(remainder)) { ret str_copy_slice(a, rel, 0, str_len(rel)); }
    ret format.sprint(a, "{}/{}", remainder, rel);
}

fun run_absent_branch(a: *A.Allocator, mp: *txn.Descent, id: *u8, is_lib: bool,
                      entry_label: *u8, quiet: bool) i64 {
    var guard: txn.Lock;
    var claim: txn.Claim;
    var failure: O.Option[txn.Error] = txn.lock(?guard, ?mp.root);
    if (O.is_none[txn.Error](failure)) {
        val recovered: R.Result[usize, txn.Error] = txn.recover(a, ?guard, "");
        if (R.is_err[usize, txn.Error](recovered)) { failure = O.some[txn.Error](R.unwrap_err[usize, txn.Error](recovered)); }
    }
    if (O.is_none[txn.Error](failure)) { failure = txn.claim(?claim, a, ?guard, mp.first_missing); }
    var code: i64 = 2;
    if (O.is_none[txn.Error](failure)) { code = run_absent_scaffold(a, mp, ?claim, id, is_lib, entry_label, quiet); }
    val released: O.Option[txn.Error] = txn.release_claim(?claim);
    if (O.is_none[txn.Error](failure)) { failure = released; }
    val unlocked: O.Option[txn.Error] = txn.unlock(?guard);
    if (O.is_none[txn.Error](failure)) { failure = unlocked; }
    val closed: O.Option[txn.Error] = txn.descent_dnit(a, mp);
    if (O.is_none[txn.Error](failure)) { failure = closed; }
    if (O.is_some[txn.Error](failure)) { print.eprint("error: "); print.eprint(txn_msg(O.unwrap[txn.Error](failure))); print.eprint("\n"); ret 2; }
    ret code;
}

fun run_absent_scaffold(a: *A.Allocator, mp: *txn.Descent, claim: *txn.Claim, id: *u8, is_lib: bool,
                      entry_label: *u8, quiet: bool) i64 {
    val text_r: R.Result[str, str] = build_manifest_text(a, id, is_lib, target.host_arch_id());
    if (R.is_err[str, str](text_r)) {
        print.eprint("error: failed to build mach.toml\n");
        ret 2;
    }
    val text: str = R.unwrap_ok[str, str](text_r);
    fin { str_free(a, text); }

    val manifest_rel_r: R.Result[str, str] = under_remainder(a, mp.remainder, "mach.toml");
    if (R.is_err[str, str](manifest_rel_r)) {
        print.eprint("error: cannot plan mach.toml path\n");
        ret 2;
    }
    val manifest_rel: str = R.unwrap_ok[str, str](manifest_rel_r);
    fin { str_free(a, manifest_rel); }
    val entry_rel_r: R.Result[str, str] = under_remainder(a, mp.remainder, entry_label::str);
    if (R.is_err[str, str](entry_rel_r)) {
        print.eprint("error: cannot plan source entry path\n");
        ret 2;
    }
    val entry_rel: str = R.unwrap_ok[str, str](entry_rel_r);
    fin { str_free(a, entry_rel); }

    var inv: txn.Inventory = txn.inventory_init(a);
    val push1: O.Option[txn.Error] = txn.inventory_push(?inv,
        txn.entry_file(manifest_rel, text::*u8, str_len(text), FILE_MODE));
    if (O.is_some[txn.Error](push1)) {
        print.eprint("error: internal: cannot plan mach.toml\n");
        txn.inventory_dnit(?inv);
        ret 2;
    }

    val src_text: str = source_template(is_lib)::str;
    val push2: O.Option[txn.Error] = txn.inventory_push(?inv,
        txn.entry_file(entry_rel, src_text::*u8, str_len(src_text), FILE_MODE));
    if (O.is_some[txn.Error](push2)) {
        print.eprint("error: internal: cannot plan ");
        print.eprint(entry_label);
        print.eprint("\n");
        txn.inventory_dnit(?inv);
        ret 2;
    }

    # the whole missing chain is staged privately and appears with one rename,
    # so a reader never sees a scaffold that is half written
    val published: R.Result[R.Void, str] = publication.subtree(a, claim, ?inv, DIR_MODE);
    txn.inventory_dnit(?inv);
    if (R.is_err[R.Void, str](published)) {
        print.eprint("error: ");
        print.eprint(R.unwrap_err[R.Void, str](published));
        print.eprint("\n");
        ret 1;
    }

    if (!quiet) {
        print.eprint("created project '");
        print.eprint(id::str);
        print.eprint("'\n");
    }
    ret 0;
}

val JOURNAL_LEAF:     str = ".machinit.journal";
val BACKUP_MANIFEST:  str = ".machinit.mach.toml.backup";
val BACKUP_ENTRY_BIN: str = ".machinit.root.mach.backup";
val BACKUP_ENTRY_LIB: str = ".machinit.lib.mach.backup";

val INIT_JOURNAL_MAGIC: u32 = 0x494e4954;

rec InitJournal {
    magic: u32;
    root: txn.Identity;
    source_present: bool;
    source: txn.Identity;
    manifest_had_identity: bool;
    manifest_prior: txn.Identity;
    manifest_new: txn.Identity;
    entry_is_lib: bool;
    entry_had_identity: bool;
    entry_prior: txn.Identity;
    entry_new: txn.Identity;
    src_dir_created: bool;
}

val RECOVER_CLEAN:       i32 = 0;
val RECOVER_ROLLED_BACK: i32 = 1;
val RECOVER_COMPLETED:   i32 = 2;

fun entry_backup_leaf(is_lib: bool) str {
    if (is_lib) { ret BACKUP_ENTRY_LIB; }
    ret BACKUP_ENTRY_BIN;
}

# init formats the transaction layer's closed error kind at its command boundary
fun txn_msg(e: txn.Error) str {
    ret txn.error_message(e);
}

rec InitDirectory {
    root: txn.Root;
    guard: txn.Lock;
    names: [4]str;
    claims: [4]txn.Claim;
}

rec InitEntry {
    present: bool;
    is_regular: bool;
    is_directory: bool;
    identity: txn.Identity;
}

fun directory_close(cap: *InitDirectory) O.Option[str] {
    var failure: O.Option[txn.Error];
    var i: usize = 4;
    for (i > 0) {
        i = i - 1;
        val released: O.Option[txn.Error] = txn.release_claim(?cap.claims[i]);
        if (O.is_none[txn.Error](failure)) { failure = released; }
    }
    val unlocked: O.Option[txn.Error] = txn.unlock(?cap.guard);
    if (O.is_none[txn.Error](failure)) { failure = unlocked; }
    val closed: O.Option[txn.Error] = txn.root_dnit(?cap.root);
    if (O.is_none[txn.Error](failure)) { failure = closed; }
    if (O.is_some[txn.Error](failure)) { ret O.some[str](txn_msg(O.unwrap[txn.Error](failure))); }
    ret O.none[str]();
}

fun directory_admit(cap: *InitDirectory, a: *A.Allocator, source: bool) R.Result[R.Void, str] {
    val locked: O.Option[txn.Error] = txn.lock(?cap.guard, ?cap.root);
    if (O.is_some[txn.Error](locked)) { ret R.err[R.Void, str](txn_msg(O.unwrap[txn.Error](locked))); }
    val recovered: R.Result[usize, txn.Error] = txn.recover(a, ?cap.guard, "");
    if (R.is_err[usize, txn.Error](recovered)) { ret R.err[R.Void, str](txn_msg(R.unwrap_err[usize, txn.Error](recovered))); }
    if (source) {
        cap.names[0] = "root.mach";
        cap.names[1] = BACKUP_ENTRY_BIN;
        cap.names[2] = "lib.mach";
        cap.names[3] = BACKUP_ENTRY_LIB;
    } or {
        cap.names[0] = util.PROJECT_CONFIG_NAME;
        cap.names[1] = BACKUP_MANIFEST;
        cap.names[2] = JOURNAL_LEAF;
        cap.names[3] = "src";
    }
    var i: usize = 0;
    for (i < 4) {
        val reserved: O.Option[txn.Error] = txn.claim(?cap.claims[i], a, ?cap.guard, cap.names[i]);
        if (O.is_some[txn.Error](reserved)) { ret R.err[R.Void, str](txn_msg(O.unwrap[txn.Error](reserved))); }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

fun destination(cap: *InitDirectory, leaf: str) *txn.Claim {
    var i: usize = 0;
    for (i < 4) {
        if (str_equals(cap.names[i], leaf)) { ret ?cap.claims[i]; }
        i = i + 1;
    }
    ret nil;
}

fun open_root(out: *InitDirectory, a: *A.Allocator, root: str, rel: str) R.Result[R.Void, str] {
    val opened: O.Option[txn.Error] = txn.root_open(?out.root, root, rel);
    if (O.is_some[txn.Error](opened)) { ret R.err[R.Void, str](txn_msg(O.unwrap[txn.Error](opened))); }
    ret directory_admit(out, a, false);
}

fun open_src_cap(out: *InitDirectory, a: *A.Allocator, parent: *InitDirectory) R.Result[R.Void, str] {
    val opened: O.Option[txn.Error] = txn.root_open_child(?out.root, ?parent.root, "src");
    if (O.is_some[txn.Error](opened)) { ret R.err[R.Void, str](txn_msg(O.unwrap[txn.Error](opened))); }
    ret directory_admit(out, a, true);
}

fun probe_entry(cap: *InitDirectory, leaf: str) R.Result[InitEntry, str] {
    val observed: R.Result[txn.EntryProbe, txn.Error] = txn.entry_probe(?cap.root, leaf);
    if (R.is_err[txn.EntryProbe, txn.Error](observed)) {
        ret R.err[InitEntry, str](txn_msg(R.unwrap_err[txn.EntryProbe, txn.Error](observed)));
    }
    val probe: txn.EntryProbe = R.unwrap_ok[txn.EntryProbe, txn.Error](observed);
    var result: InitEntry;
    result.present = probe.present;
    result.is_regular = probe.is_regular;
    result.is_directory = probe.is_directory;
    if (probe.present) {
        val identified: R.Result[O.Option[txn.Identity], txn.Error] = txn.entry_identity(?cap.root, leaf);
        if (R.is_err[O.Option[txn.Identity], txn.Error](identified)) {
            ret R.err[InitEntry, str](txn_msg(R.unwrap_err[O.Option[txn.Identity], txn.Error](identified)));
        }
        val identity: O.Option[txn.Identity] = R.unwrap_ok[O.Option[txn.Identity], txn.Error](identified);
        if (O.is_none[txn.Identity](identity)) { ret R.err[InitEntry, str]("init entry disappeared during inspection"); }
        result.identity = O.unwrap[txn.Identity](identity);
    }
    ret R.ok[InitEntry, str](result);
}

fun rename_entry(cap: *InitDirectory, from: str, to: str) O.Option[str] {
    val e: O.Option[txn.Error] = txn.entry_rename(destination(cap, from), destination(cap, to));
    if (O.is_none[txn.Error](e)) { ret O.none[str](); }
    ret O.some[str](txn_msg(O.unwrap[txn.Error](e)));
}

fun unlink_entry(cap: *InitDirectory, leaf: str) O.Option[str] {
    val e: O.Option[txn.Error] = txn.entry_unlink(destination(cap, leaf));
    if (O.is_none[txn.Error](e)) { ret O.none[str](); }
    ret O.some[str](txn_msg(O.unwrap[txn.Error](e)));
}

fun stage_owned(out: *txn.Transaction, a: *A.Allocator, cap: *InitDirectory, leaf: str,
                data: *u8, len: usize) R.Result[R.Void, str] {
    var options: txn.PrepareOptions;
    options.precondition = txn.PRE_SAME_OBJECT;
    options.prior_access = txn.READ_AUTHORIZED;
    options.durability = txn.durability_none();
    val prepared: O.Option[txn.Error] = txn.prepare_bytes(out, a, destination(cap, leaf), data, len, FILE_MODE, false, options);
    if (O.is_some[txn.Error](prepared)) { ret R.err[R.Void, str](txn_msg(O.unwrap[txn.Error](prepared))); }
    ret R.ok_void[str]();
}

fun stage_source(out: *txn.Transaction, a: *A.Allocator, cap: *InitDirectory,
                 leaf: str, data: *u8, len: usize) R.Result[R.Void, str] {
    var inventory: txn.Inventory = txn.inventory_init(a);
    fin { txn.inventory_dnit(?inventory); }
    val added: O.Option[txn.Error] = txn.inventory_push(?inventory, txn.entry_file(leaf, data, len, FILE_MODE));
    if (O.is_some[txn.Error](added)) { ret R.err[R.Void, str](txn_msg(O.unwrap[txn.Error](added))); }
    var options: txn.PrepareOptions;
    options.precondition = txn.PRE_ABSENT;
    options.durability = txn.durability_none();
    val prepared: O.Option[txn.Error] = txn.prepare_subtree(out, a,
        destination(cap, "src"), ?inventory, DIR_MODE, options);
    if (O.is_some[txn.Error](prepared)) { ret R.err[R.Void, str](txn_msg(O.unwrap[txn.Error](prepared))); }
    ret R.ok_void[str]();
}

fun rmdir_entry(cap: *InitDirectory, leaf: str) O.Option[str] {
    val e: O.Option[txn.Error] = txn.entry_rmdir_if_empty(destination(cap, leaf));
    if (O.is_none[txn.Error](e)) { ret O.none[str](); }
    ret O.some[str](txn_msg(O.unwrap[txn.Error](e)));
}

fun root_identity_of(cap: *InitDirectory) R.Result[txn.Identity, str] {
    val r: R.Result[txn.Identity, txn.Error] = txn.root_identity(?cap.root);
    if (R.is_err[txn.Identity, txn.Error](r)) { ret R.err[txn.Identity, str](txn_msg(R.unwrap_err[txn.Identity, txn.Error](r))); }
    ret R.ok[txn.Identity, str](R.unwrap_ok[txn.Identity, txn.Error](r));
}

fun staged_identity_of(t: *txn.Transaction) R.Result[txn.Identity, str] {
    val r: R.Result[txn.Identity, txn.Error] = txn.transaction_staged_identity(t);
    if (R.is_err[txn.Identity, txn.Error](r)) { ret R.err[txn.Identity, str](txn_msg(R.unwrap_err[txn.Identity, txn.Error](r))); }
    ret R.ok[txn.Identity, str](R.unwrap_ok[txn.Identity, txn.Error](r));
}

fun journal_read(root_cap: *InitDirectory) R.Result[O.Option[InitJournal], str] {
    var j: InitJournal;
    val jsize: usize = $size_of(InitJournal);
    val read_r: R.Result[O.Option[usize], txn.Error] =
        txn.entry_read_all(?root_cap.root, JOURNAL_LEAF, (?j)::*u8, jsize);
    if (R.is_err[O.Option[usize], txn.Error](read_r)) {
        ret R.err[O.Option[InitJournal], str](txn_msg(R.unwrap_err[O.Option[usize], txn.Error](read_r)));
    }
    val got: O.Option[usize] = R.unwrap_ok[O.Option[usize], txn.Error](read_r);
    if (O.is_none[usize](got)) { ret R.ok[O.Option[InitJournal], str](O.none[InitJournal]()); }
    if (O.unwrap[usize](got) != jsize) { ret R.err[O.Option[InitJournal], str]("init journal has an unexpected size"); }
    if (j.magic != INIT_JOURNAL_MAGIC) {
        ret R.err[O.Option[InitJournal], str]("init journal has an invalid signature");
    }
    ret R.ok[O.Option[InitJournal], str](O.some[InitJournal](j));
}

fun journal_create(a: *A.Allocator, root_cap: *InitDirectory, source_identity: *txn.Identity,
                   root_id: txn.Identity, manifest_probe: InitEntry, manifest_new: txn.Identity,
                   entry_probe: InitEntry, entry_new: txn.Identity,
                   is_lib: bool, src_dir_created: bool) R.Result[R.Void, str] {
    var j: InitJournal;
    j.magic = INIT_JOURNAL_MAGIC;
    j.root = root_id;
    if (source_identity != nil) {
        j.source_present = true;
        j.source = source_identity[0];
    }
    j.manifest_had_identity = manifest_probe.present;
    j.manifest_prior = manifest_probe.identity;
    j.manifest_new = manifest_new;
    j.entry_is_lib = is_lib;
    j.entry_had_identity = entry_probe.present;
    j.entry_prior = entry_probe.identity;
    j.entry_new = entry_new;
    j.src_dir_created = src_dir_created;
    ret publication.bytes_at(nil, a, destination(root_cap, JOURNAL_LEAF), JOURNAL_LEAF,
        (?j)::*u8, $size_of(InitJournal), FILE_MODE, publication.CREATE,
        "write", "the init journal could not be published", nil);
}

fun commit_owned(a: *A.Allocator, cap: *InitDirectory, pf: *txn.Transaction,
                 live: *bool, backup_leaf: str) O.Option[str] {
    val result: txn.BackupOutcome = txn.commit_with_backup(pf, destination(cap, backup_leaf));
    if (result.consumed) { live[0] = false; }
    if (result.staging_residue != nil) {
        print.eprint("error: init staging cleanup left ");
        print.eprint(result.staging_residue);
        print.eprint(" for locked startup recovery\n");
        str_free(a, result.staging_residue);
    }
    if (O.is_some[txn.Error](result.cleanup_failure)) {
        print.eprint("error: "); print.eprint(txn_msg(O.unwrap[txn.Error](result.cleanup_failure))); print.eprint("\n");
    }
    if (O.is_some[txn.Error](result.failure)) { ret O.some[str](txn_msg(O.unwrap[txn.Error](result.failure))); }
    if (O.is_some[txn.Error](result.cleanup_failure)) { ret O.some[str](txn_msg(O.unwrap[txn.Error](result.cleanup_failure))); }
    if (!result.consumed || !result.published) { ret O.some[str]("init file commit did not publish its prepared content"); }
    ret O.none[str]();
}

fun resolve_rollback(cap: *InitDirectory,
                     final_leaf: str, backup_leaf: str, had_identity_before: bool) O.Option[str] {
    val probe_r: R.Result[InitEntry, str] = probe_entry(cap, backup_leaf);
    if (R.is_err[InitEntry, str](probe_r)) { ret O.some[str](R.unwrap_err[InitEntry, str](probe_r)); }
    val probe: InitEntry = R.unwrap_ok[InitEntry, str](probe_r);
    if (probe.present) { ret rename_entry(cap, backup_leaf, final_leaf); }
    if (!had_identity_before) { ret unlink_entry(cap, final_leaf); }
    ret O.none[str]();
}

fun resolve_commit_cleanup(cap: *InitDirectory, backup_leaf: str) O.Option[str] {
    ret unlink_entry(cap, backup_leaf);
}

fun finish_committed_cleanup(root_cap: *InitDirectory,
                            src_cap: *InitDirectory, entry_backup: str) O.Option[str] {
    var failure: O.Option[str] = resolve_commit_cleanup(root_cap, BACKUP_MANIFEST);
    if (O.is_none[str](failure) && entry_backup != nil) { failure = resolve_commit_cleanup(src_cap, entry_backup); }
    if (O.is_none[str](failure)) { failure = directory_close(src_cap); }
    if (O.is_none[str](failure)) { failure = unlink_entry(root_cap, JOURNAL_LEAF); }
    ret failure;
}

val OUTPUT_ORIGINAL: i32 = 0;
val OUTPUT_DONE:     i32 = 1;
val OUTPUT_ANOMALY:  i32 = -1;

fun classify_output(current: InitEntry, had_identity: bool,
                    prior: txn.Identity, new_id: txn.Identity) i32 {
    if (!current.present) { ret OUTPUT_ORIGINAL; }
    if (!current.is_regular) { ret OUTPUT_ANOMALY; }
    if (txn.identity_equal(current.identity, new_id)) { ret OUTPUT_DONE; }
    if (had_identity && txn.identity_equal(current.identity, prior)) { ret OUTPUT_ORIGINAL; }
    ret OUTPUT_ANOMALY;
}

fun recovery_backup(cap: *InitDirectory, leaf: str, had_prior: bool,
                    prior: txn.Identity) R.Result[bool, str] {
    val observed: R.Result[InitEntry, str] = probe_entry(cap, leaf);
    if (R.is_err[InitEntry, str](observed)) { ret R.err[bool, str](R.unwrap_err[InitEntry, str](observed)); }
    val backup: InitEntry = R.unwrap_ok[InitEntry, str](observed);
    if (!backup.present) { ret R.ok[bool, str](false); }
    if (!had_prior || !backup.is_regular || !txn.identity_equal(backup.identity, prior)) {
        ret R.err[bool, str]("init backup is not the recorded original file");
    }
    ret R.ok[bool, str](true);
}

fun recover_existing_in(a: *A.Allocator, root_cap: *InitDirectory, src_cap: *InitDirectory) R.Result[i32, str] {
    val jr: R.Result[O.Option[InitJournal], str] = journal_read(root_cap);
    if (R.is_err[O.Option[InitJournal], str](jr)) { ret R.err[i32, str](R.unwrap_err[O.Option[InitJournal], str](jr)); }
    val jo: O.Option[InitJournal] = R.unwrap_ok[O.Option[InitJournal], str](jr);
    if (O.is_none[InitJournal](jo)) { ret R.ok[i32, str](RECOVER_CLEAN); }
    val j: InitJournal = O.unwrap[InitJournal](jo);
    val root_id_r: R.Result[txn.Identity, str] = root_identity_of(root_cap);
    if (R.is_err[txn.Identity, str](root_id_r)) { ret R.err[i32, str](R.unwrap_err[txn.Identity, str](root_id_r)); }
    if (!txn.identity_equal(R.unwrap_ok[txn.Identity, str](root_id_r), j.root)) {
        ret R.err[i32, str]("init journal does not match its destination root");
    }
    val manifest_now_r: R.Result[InitEntry, str] = probe_entry(root_cap, util.PROJECT_CONFIG_NAME);
    if (R.is_err[InitEntry, str](manifest_now_r)) { ret R.err[i32, str](R.unwrap_err[InitEntry, str](manifest_now_r)); }
    val manifest_now: InitEntry = R.unwrap_ok[InitEntry, str](manifest_now_r);
    val manifest_class: i32 = classify_output(manifest_now, j.manifest_had_identity, j.manifest_prior, j.manifest_new);
    if (manifest_class == OUTPUT_ANOMALY) { ret R.err[i32, str]("init journal: mach.toml is neither the original nor the staged replacement"); }
    val manifest_backup: R.Result[bool, str] = recovery_backup(root_cap, BACKUP_MANIFEST, j.manifest_had_identity, j.manifest_prior);
    if (R.is_err[bool, str](manifest_backup)) { ret R.err[i32, str](R.unwrap_err[bool, str](manifest_backup)); }
    if (!manifest_now.present && j.manifest_had_identity && !R.unwrap_ok[bool, str](manifest_backup)) {
        ret R.err[i32, str]("init journal: original mach.toml and its backup are missing");
    }
    val src_now_r: R.Result[InitEntry, str] = probe_entry(root_cap, "src");
    if (R.is_err[InitEntry, str](src_now_r)) { ret R.err[i32, str](R.unwrap_err[InitEntry, str](src_now_r)); }
    val src_now: InitEntry = R.unwrap_ok[InitEntry, str](src_now_r);
    if (src_now.present && !src_now.is_directory) { ret R.err[i32, str]("init journal: src is no longer a directory"); }
    if (!src_now.present && j.entry_had_identity) { ret R.err[i32, str]("init journal: src is missing for an original entry"); }
    if (src_now.present && (!j.source_present || !txn.identity_equal(src_now.identity, j.source))) {
        ret R.err[i32, str]("init journal: src is not the recorded source directory");
    }
    val entry_leaf: str = if_str(j.entry_is_lib, "lib.mach", "root.mach");
    val entry_backup: str = entry_backup_leaf(j.entry_is_lib);
    var entry_class: i32 = OUTPUT_ORIGINAL;
    var entry_present: bool = false;
    if (j.src_dir_created && j.entry_had_identity) { ret R.err[i32, str]("init journal records an original entry in a newly created source tree"); }
    if (src_now.present) {
        if (j.src_dir_created) {
            val opened: O.Option[txn.Error] = txn.root_open_child(?src_cap.root, ?root_cap.root, "src");
            if (O.is_some[txn.Error](opened)) { ret R.err[i32, str](txn_msg(O.unwrap[txn.Error](opened))); }
        } or {
            val opened: R.Result[R.Void, str] = open_src_cap(src_cap, a, root_cap);
            if (R.is_err[R.Void, str](opened)) { ret R.err[i32, str](R.unwrap_err[R.Void, str](opened)); }
        }
        val held: R.Result[txn.Identity, str] = root_identity_of(src_cap);
        if (R.is_err[txn.Identity, str](held)) { ret R.err[i32, str](R.unwrap_err[txn.Identity, str](held)); }
        if (!txn.identity_equal(R.unwrap_ok[txn.Identity, str](held), j.source)) {
            ret R.err[i32, str]("init journal: src changed while opening its recovery root");
        }
        val entry_now_r: R.Result[InitEntry, str] = probe_entry(src_cap, entry_leaf);
        if (R.is_err[InitEntry, str](entry_now_r)) { ret R.err[i32, str](R.unwrap_err[InitEntry, str](entry_now_r)); }
        val entry_now: InitEntry = R.unwrap_ok[InitEntry, str](entry_now_r);
        entry_present = entry_now.present;
        entry_class = classify_output(entry_now, j.entry_had_identity, j.entry_prior, j.entry_new);
        if (!j.src_dir_created) {
            val backup: R.Result[bool, str] = recovery_backup(src_cap, entry_backup, j.entry_had_identity, j.entry_prior);
            if (R.is_err[bool, str](backup)) { ret R.err[i32, str](R.unwrap_err[bool, str](backup)); }
            if (!entry_now.present && j.entry_had_identity && !R.unwrap_ok[bool, str](backup)) {
                ret R.err[i32, str]("init journal: original entry file and its backup are missing");
            }
        }
    }
    if (entry_class == OUTPUT_ANOMALY) { ret R.err[i32, str]("init journal: the selected entry file is neither the original nor the staged replacement"); }
    if (manifest_class == OUTPUT_DONE) {
        if (entry_class != OUTPUT_DONE) { ret R.err[i32, str]("init journal: mach.toml committed but the entry file did not"); }
        var backup: str = nil;
        if (!j.src_dir_created) { backup = entry_backup; }
        val cleanup: O.Option[str] = finish_committed_cleanup(root_cap, src_cap, backup);
        if (O.is_some[str](cleanup)) { ret R.err[i32, str](O.unwrap[str](cleanup)); }
        ret R.ok[i32, str](RECOVER_COMPLETED);
    }
    var failure: O.Option[str] = resolve_rollback(root_cap, util.PROJECT_CONFIG_NAME, BACKUP_MANIFEST, j.manifest_had_identity);
    if (O.is_none[str](failure) && src_now.present) {
        if (j.src_dir_created) {
            if (entry_present) {
                val removed: R.Result[usize, txn.Error] = txn.root_remove_tree(destination(root_cap, "src"), entry_leaf);
                if (R.is_err[usize, txn.Error](removed)) { failure = O.some[str](txn_msg(R.unwrap_err[usize, txn.Error](removed))); }
            }
        } or { failure = resolve_rollback(src_cap, entry_leaf, entry_backup, j.entry_had_identity); }
    }
    if (O.is_none[str](failure)) { failure = directory_close(src_cap); }
    if (O.is_none[str](failure) && j.src_dir_created) { failure = rmdir_entry(root_cap, "src"); }
    if (O.is_none[str](failure)) { failure = unlink_entry(root_cap, JOURNAL_LEAF); }
    if (O.is_some[str](failure)) { ret R.err[i32, str](O.unwrap[str](failure)); }
    ret R.ok[i32, str](RECOVER_ROLLED_BACK);
}

fun recover_existing(a: *A.Allocator, root_cap: *InitDirectory) R.Result[i32, str] {
    var source: InitDirectory;
    val result: R.Result[i32, str] = recover_existing_in(a, root_cap, ?source);
    val closed: O.Option[str] = directory_close(?source);
    if (R.is_err[i32, str](result)) {
        if (O.is_some[str](closed)) { print.eprintlnf("error: init recovery cleanup: {}", O.unwrap[str](closed)); }
        ret result;
    }
    if (O.is_some[str](closed)) { ret R.err[i32, str](O.unwrap[str](closed)); }
    ret result;
}

fun if_str(cond: bool, when_true: str, when_false: str) str {
    if (cond) { ret when_true; }
    ret when_false;
}

fun refuse_exists(label: *u8) {
    print.eprint("error: ");
    print.eprint(label);
    print.eprint(" already exists (use --force to overwrite)\n");
}

fun refuse_not_regular(label: *u8) {
    print.eprint("error: ");
    print.eprint(label);
    print.eprint(" exists and is not a regular file\n");
}

rec InitOperation {
    root: InitDirectory;
    source: InitDirectory;
    manifest: txn.Transaction;
    entry: txn.Transaction;
    manifest_live: bool;
    entry_live: bool;
}

fun operation_close(operation: *InitOperation) O.Option[str] {
    var failure: O.Option[str];
    if (operation.entry_live) {
        val aborted: O.Option[txn.Error] = txn.abort(?operation.entry);
        operation.entry_live = false;
        if (O.is_some[txn.Error](aborted)) { failure = O.some[str](txn_msg(O.unwrap[txn.Error](aborted))); }
    }
    if (operation.manifest_live) {
        val aborted: O.Option[txn.Error] = txn.abort(?operation.manifest);
        operation.manifest_live = false;
        if (O.is_none[str](failure) && O.is_some[txn.Error](aborted)) { failure = O.some[str](txn_msg(O.unwrap[txn.Error](aborted))); }
    }
    val source_closed: O.Option[str] = directory_close(?operation.source);
    if (O.is_none[str](failure)) { failure = source_closed; }
    val root_closed: O.Option[str] = directory_close(?operation.root);
    if (O.is_none[str](failure)) { failure = root_closed; }
    ret failure;
}

fun run_existing_in(a: *A.Allocator, operation: *InitOperation, root: str, dir_rel: str,
                    id: *u8, is_lib: bool, entry_leaf: *u8, entry_label: *u8, force: bool) R.Result[i32, str] {
    val cap: *InitDirectory = ?operation.root;
    val src: *InitDirectory = ?operation.source;
    val opened: R.Result[R.Void, str] = open_root(cap, a, root, dir_rel);
    if (R.is_err[R.Void, str](opened)) { ret R.err[i32, str](R.unwrap_err[R.Void, str](opened)); }
    val recovered: R.Result[i32, str] = recover_existing(a, cap);
    if (R.is_err[i32, str](recovered)) { ret recovered; }
    val manifest_r: R.Result[InitEntry, str] = probe_entry(cap, util.PROJECT_CONFIG_NAME);
    if (R.is_err[InitEntry, str](manifest_r)) { ret R.err[i32, str](R.unwrap_err[InitEntry, str](manifest_r)); }
    var manifest_probe: InitEntry = R.unwrap_ok[InitEntry, str](manifest_r);
    if (manifest_probe.present && !manifest_probe.is_regular) { refuse_not_regular(util.PROJECT_CONFIG_NAME); ret R.ok[i32, str](1); }
    if (manifest_probe.present && !force) { refuse_exists(util.PROJECT_CONFIG_NAME); ret R.ok[i32, str](1); }
    val source_r: R.Result[InitEntry, str] = probe_entry(cap, "src");
    if (R.is_err[InitEntry, str](source_r)) { ret R.err[i32, str](R.unwrap_err[InitEntry, str](source_r)); }
    val source_probe: InitEntry = R.unwrap_ok[InitEntry, str](source_r);
    if (source_probe.present && !source_probe.is_directory) { ret R.err[i32, str]("'src' exists and is not a directory"); }
    var entry_probe: InitEntry;
    if (source_probe.present) {
        val source_opened: R.Result[R.Void, str] = open_src_cap(src, a, cap);
        if (R.is_err[R.Void, str](source_opened)) { ret R.err[i32, str](R.unwrap_err[R.Void, str](source_opened)); }
        val entry_r: R.Result[InitEntry, str] = probe_entry(src, entry_leaf::str);
        if (R.is_err[InitEntry, str](entry_r)) { ret R.err[i32, str](R.unwrap_err[InitEntry, str](entry_r)); }
        entry_probe = R.unwrap_ok[InitEntry, str](entry_r);
    }
    if (entry_probe.present && !entry_probe.is_regular) { refuse_not_regular(entry_label); ret R.ok[i32, str](1); }
    if (entry_probe.present && !force) { refuse_exists(entry_label); ret R.ok[i32, str](1); }
    val backup_r: R.Result[InitEntry, str] = probe_entry(cap, BACKUP_MANIFEST);
    if (R.is_err[InitEntry, str](backup_r)) { ret R.err[i32, str](R.unwrap_err[InitEntry, str](backup_r)); }
    if (R.unwrap_ok[InitEntry, str](backup_r).present) { ret R.err[i32, str]("init manifest backup exists without a recovery journal"); }
    if (source_probe.present) {
        val entry_backup_r: R.Result[InitEntry, str] = probe_entry(src, entry_backup_leaf(is_lib));
        if (R.is_err[InitEntry, str](entry_backup_r)) { ret R.err[i32, str](R.unwrap_err[InitEntry, str](entry_backup_r)); }
        if (R.unwrap_ok[InitEntry, str](entry_backup_r).present) { ret R.err[i32, str]("init entry backup exists without a recovery journal"); }
    }
    val text_r: R.Result[str, str] = build_manifest_text(a, id, is_lib, target.host_arch_id());
    if (R.is_err[str, str](text_r)) { ret R.err[i32, str](R.unwrap_err[str, str](text_r)); }
    val text: str = R.unwrap_ok[str, str](text_r);
    fin { str_free(a, text); }
    val manifest_prepared: R.Result[R.Void, str] = stage_owned(?operation.manifest, a, cap,
        util.PROJECT_CONFIG_NAME, text::*u8, str_len(text));
    if (R.is_err[R.Void, str](manifest_prepared)) { ret R.err[i32, str](R.unwrap_err[R.Void, str](manifest_prepared)); }
    operation.manifest_live = true;
    val source_text: str = source_template(is_lib)::str;
    var source_identity: txn.Identity;
    var entry_identity: txn.Identity;
    if (source_probe.present) {
        val entry_prepared: R.Result[R.Void, str] = stage_owned(?operation.entry, a, src,
            entry_leaf::str, source_text::*u8, str_len(source_text));
        if (R.is_err[R.Void, str](entry_prepared)) { ret R.err[i32, str](R.unwrap_err[R.Void, str](entry_prepared)); }
        operation.entry_live = true;
        val source_id: R.Result[txn.Identity, str] = root_identity_of(src);
        if (R.is_err[txn.Identity, str](source_id)) { ret R.err[i32, str](R.unwrap_err[txn.Identity, str](source_id)); }
        source_identity = R.unwrap_ok[txn.Identity, str](source_id);
        val entry_id: R.Result[txn.Identity, str] = staged_identity_of(?operation.entry);
        if (R.is_err[txn.Identity, str](entry_id)) { ret R.err[i32, str](R.unwrap_err[txn.Identity, str](entry_id)); }
        entry_identity = R.unwrap_ok[txn.Identity, str](entry_id);
        var prior: txn.Identity;
        val had_prior: bool = txn.transaction_prior_identity(?operation.entry, ?prior);
        if (had_prior != entry_probe.present || (had_prior && !txn.identity_equal(prior, entry_probe.identity))) {
            ret R.err[i32, str]("init entry changed after overwrite validation");
        }
        entry_probe.identity = prior;
    } or {
        val prepared: R.Result[R.Void, str] = stage_source(?operation.entry, a, cap,
            entry_leaf::str, source_text::*u8, str_len(source_text));
        if (R.is_err[R.Void, str](prepared)) { ret R.err[i32, str](R.unwrap_err[R.Void, str](prepared)); }
        operation.entry_live = true;
        val source_id: R.Result[txn.Identity, str] = staged_identity_of(?operation.entry);
        if (R.is_err[txn.Identity, str](source_id)) { ret R.err[i32, str](R.unwrap_err[txn.Identity, str](source_id)); }
        source_identity = R.unwrap_ok[txn.Identity, str](source_id);
        val entry_id: R.Result[txn.Identity, txn.Error] = txn.transaction_staged_child_identity(?operation.entry, entry_leaf::str);
        if (R.is_err[txn.Identity, txn.Error](entry_id)) { ret R.err[i32, str](txn_msg(R.unwrap_err[txn.Identity, txn.Error](entry_id))); }
        entry_identity = R.unwrap_ok[txn.Identity, txn.Error](entry_id);
    }
    var manifest_prior: txn.Identity;
    val manifest_had: bool = txn.transaction_prior_identity(?operation.manifest, ?manifest_prior);
    if (manifest_had != manifest_probe.present || (manifest_had && !txn.identity_equal(manifest_prior, manifest_probe.identity))) {
        ret R.err[i32, str]("init manifest changed after overwrite validation");
    }
    manifest_probe.identity = manifest_prior;
    val root_id: R.Result[txn.Identity, str] = root_identity_of(cap);
    if (R.is_err[txn.Identity, str](root_id)) { ret R.err[i32, str](R.unwrap_err[txn.Identity, str](root_id)); }
    val manifest_new: R.Result[txn.Identity, str] = staged_identity_of(?operation.manifest);
    if (R.is_err[txn.Identity, str](manifest_new)) { ret R.err[i32, str](R.unwrap_err[txn.Identity, str](manifest_new)); }
    val journal: R.Result[R.Void, str] = journal_create(a, cap, ?source_identity, R.unwrap_ok[txn.Identity, str](root_id),
        manifest_probe, R.unwrap_ok[txn.Identity, str](manifest_new), entry_probe,
        entry_identity, is_lib, !source_probe.present);
    if (R.is_err[R.Void, str](journal)) { ret R.err[i32, str](R.unwrap_err[R.Void, str](journal)); }
    if (source_probe.present) {
        val entry_committed: O.Option[str] = commit_owned(a, src, ?operation.entry, ?operation.entry_live, entry_backup_leaf(is_lib));
        if (O.is_some[str](entry_committed)) { ret R.err[i32, str](O.unwrap[str](entry_committed)); }
    } or {
        val source_committed: R.Result[txn.Outcome, txn.Error] = txn.commit(?operation.entry);
        operation.entry_live = false;
        if (R.is_err[txn.Outcome, txn.Error](source_committed)) { ret R.err[i32, str](txn_msg(R.unwrap_err[txn.Outcome, txn.Error](source_committed))); }
    }
    val manifest_committed: O.Option[str] = commit_owned(a, cap, ?operation.manifest, ?operation.manifest_live, BACKUP_MANIFEST);
    if (O.is_some[str](manifest_committed)) { ret R.err[i32, str](O.unwrap[str](manifest_committed)); }
    var backup: str = nil;
    if (source_probe.present) { backup = entry_backup_leaf(is_lib); }
    val cleanup: O.Option[str] = finish_committed_cleanup(cap, src, backup);
    if (O.is_some[str](cleanup)) { ret R.err[i32, str](O.unwrap[str](cleanup)); }
    ret R.ok[i32, str](0);
}

fun run_existing_branch(a: *A.Allocator, root: str, dir_rel: str, id: *u8, is_lib: bool,
                        entry_leaf: *u8, entry_label: *u8, force: bool, quiet: bool) i64 {
    var operation: InitOperation;
    var result: R.Result[i32, str] = run_existing_in(a, ?operation, root, dir_rel, id,
        is_lib, entry_leaf, entry_label, force);
    val closed: O.Option[str] = operation_close(?operation);
    if (O.is_some[str](closed)) {
        if (R.is_ok[i32, str](result)) { result = R.err[i32, str](O.unwrap[str](closed)); }
        or { print.eprint("error: "); print.eprint(O.unwrap[str](closed)); print.eprint("\n"); }
    }
    if (R.is_err[i32, str](result)) {
        print.eprint("error: "); print.eprint(R.unwrap_err[i32, str](result));
        print.eprint(" (any init journal is retained for recovery on retry)\n");
        ret 2;
    }
    val code: i32 = R.unwrap_ok[i32, str](result);
    if (code == 0 && !quiet) { print.eprint("created project '"); print.eprint(id::str); print.eprint("'\n"); }
    ret code::i64;
}

fun build_manifest_text(alloc: *A.Allocator, id: *u8, is_lib: bool, arch_id: u32) R.Result[str, str] {
    var storage: [4096]u8;
    var buf: Buf;
    buf.ptr = ?storage[0];
    buf.cap = 4096;
    buf.len = 0;
    buf.ok  = true;

    buf_put(?buf, "[project]\n");
    buf_put(?buf, "id = \"");
    buf_put(?buf, id);
    buf_put(?buf, "\"\n");
    buf_put(?buf, "version = \"0.1.0\"\n");
    buf_put(?buf, "src = \"src\"\n");
    buf_put(?buf, "out = \"out/{target.name}/{profile.name}\"\n");
    buf_put(?buf, "\n");

    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    if (R.is_err[R.Void, str](driver.setup_registry(?reg))) { ret R.err[str, str]("failed to register targets"); }
    emit_targets(?buf, ?reg, arch_id);
    emit_artifacts(?buf, ?reg, arch_id, id, is_lib);
    if (!is_lib && !str_empty(scaffold_abi(?reg, "windows", arch_id))) {
        buf_put(?buf, "[link.kernel32]\nsource = \"system\"\nname = \"kernel32.dll\"\nos = [\"windows\"]\nisa = [\"*\"]\nabi = [\"*\"]\nexport = false\n\n");
    }

    buf_put(?buf, "[profile.debug]\n");
    buf_put(?buf, "default = true\n");
    buf_put(?buf, "opt = 0\n");
    buf_put(?buf, "debug = true\n");
    buf_put(?buf, "simd = \"scalarize\"\n");
    buf_put(?buf, "vectorize = false\n");
    buf_put(?buf, "\n");
    buf_put(?buf, "[profile.release]\n");
    buf_put(?buf, "opt = 2\n");
    buf_put(?buf, "debug = false\n");
    buf_put(?buf, "simd = \"scalarize\"\n");
    buf_put(?buf, "vectorize = true\n");
    buf_put(?buf, "\n");

    var di: usize = 0;
    for (di < SCAFFOLD_DEP_COUNT) {
        val dep: ScaffoldDep = SCAFFOLD_DEPS[di];
        buf_put(?buf, "[dep.");
        buf_put(?buf, dep.id::*u8);
        buf_put(?buf, "]\n");
        buf_put(?buf, "git = \"");
        buf_put(?buf, dep.git::*u8);
        buf_put(?buf, "\"\n");
        buf_put(?buf, "ref = \"");
        buf_put(?buf, dep.ref::*u8);
        buf_put(?buf, "\"\n");
        di = di + 1;
    }

    if (!buf.ok) { ret R.err[str, str]("mach.toml scaffold exceeds the scratch buffer"); }
    ret str_copy_slice(alloc, buf.ptr::str, 0, buf.len);
}

fun scaffold_of_name(reg: *target.TargetRegistry, os_name: str, arch_id: u32) R.Result[of.ArtifactName, str] {
    val abi_name: str = scaffold_abi(reg, os_name, arch_id);
    if (str_empty(abi_name)) { ret R.err[of.ArtifactName, str]("scaffold: no naming target"); }
    val tgt_r: R.Result[resolved.Target, str] = target.select(reg, isa.arch_name_for(arch_id), os_name, abi_name);
    if (R.is_err[resolved.Target, str](tgt_r)) { ret R.err[of.ArtifactName, str](R.unwrap_err[resolved.Target, str](tgt_r)); }
    var tgt: resolved.Target = R.unwrap_ok[resolved.Target, str](tgt_r);
    ret target.artifact_naming(?tgt, of.ARTIFACT_EXECUTABLE);
}

fun emit_artifacts(b: *Buf, reg: *target.TargetRegistry, arch_id: u32,
                   id: *u8, is_lib: bool) {
    if (is_lib) {
        val lib_r: R.Result[resolved.Target, str] = target.select(reg, isa.arch_name_for(arch_id), "linux", scaffold_abi(reg, "linux", arch_id));
        var prefix: str = "lib";
        var suffix: str = ".a";
        if (R.is_ok[resolved.Target, str](lib_r)) {
            var tgt: resolved.Target = R.unwrap_ok[resolved.Target, str](lib_r);
            val an_r: R.Result[of.ArtifactName, str] = target.artifact_naming(?tgt, of.ARTIFACT_STATIC_LIB);
            if (R.is_ok[of.ArtifactName, str](an_r)) {
                val an: of.ArtifactName = R.unwrap_ok[of.ArtifactName, str](an_r);
                prefix = an.prefix;
                suffix = an.suffix;
            }
        }
        buf_put(b, "[artifact.");
        buf_put(b, id);
        buf_put(b, "]\nkind = \"static\"\nentry = \"lib.mach\"\nout = \"lib/");
        buf_put(b, prefix::*u8);
        buf_put(b, id);
        buf_put(b, suffix::*u8);
        buf_put(b, "\"\ntargets = [\"*\"]\nlink = []\nneed = []\n\n");
        ret;
    }

    emit_binary_artifact(b, reg, arch_id, id, false);
    if (!str_empty(scaffold_abi(reg, "windows", arch_id))) {
        emit_binary_artifact(b, reg, arch_id, id, true);
    }
}

fun emit_binary_artifact(b: *Buf, reg: *target.TargetRegistry, arch_id: u32,
                         id: *u8, windows: bool) {
    var os_name: str = "linux";
    if (windows) { os_name = "windows"; }
    var suffix: str = "";
    val an_r: R.Result[of.ArtifactName, str] = scaffold_of_name(reg, os_name, arch_id);
    if (R.is_ok[of.ArtifactName, str](an_r)) { suffix = R.unwrap_ok[of.ArtifactName, str](an_r).suffix; }

    buf_put(b, "[artifact.");
    buf_put(b, id);
    if (windows) { buf_put(b, "-windows"); }
    buf_put(b, "]\nkind = \"bin\"\nentry = \"root.mach\"\nout = \"bin/");
    buf_put(b, id);
    buf_put(b, suffix::*u8);
    buf_put(b, "\"\ntargets = [");
    emit_artifact_targets(b, reg, arch_id, windows);
    if (windows) { buf_put(b, "]\nlink = [\"kernel32\"]\nneed = []\n\n"); }
    or            { buf_put(b, "]\nlink = []\nneed = []\n\n"); }
}

fun emit_artifact_targets(b: *Buf, reg: *target.TargetRegistry,
                          arch_id: u32, windows: bool) {
    var wrote: bool = false;
    emit_artifact_target(b, reg, "linux", arch_id, windows, ?wrote);
    emit_artifact_target(b, reg, "windows", arch_id, windows, ?wrote);
    emit_artifact_target(b, reg, "darwin", arch_id, windows, ?wrote);
}

fun emit_artifact_target(b: *Buf, reg: *target.TargetRegistry, os_name: *u8,
                         arch_id: u32, windows: bool, wrote: *bool) {
    val is_windows: bool = str_equals(os_name::str, "windows");
    if (is_windows != windows || str_empty(scaffold_abi(reg, os_name::str, arch_id))) { ret; }
    if (@wrote) { buf_put(b, ", "); }
    buf_put(b, "\"");
    buf_put(b, os_name);
    buf_put(b, "-");
    buf_put(b, isa.arch_name_for(arch_id)::*u8);
    buf_put(b, "\"");
    @wrote = true;
}

val BIN_SOURCE_TEMPLATE: str = "use std.runtime;\nuse print: std.print;\n\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i64 {\n    print.println(\"Hello, World!\");\n    ret 0;\n}\n";

fun source_template(is_lib: bool) *u8 {
    if (is_lib) { ret ""; }
    ret BIN_SOURCE_TEMPLATE::*u8;
}

fun buf_put(b: *Buf, s: *u8) {
    if (!b.ok) { ret; }
    val n: usize = str_len(s);
    if (b.len + n > b.cap) {
        b.ok = false;
        ret;
    }
    var i: usize = 0;
    for (i < n) {
        b.ptr[b.len + i] = s[i];
        i = i + 1;
    }
    b.len = b.len + n;
}

fun default_project_id(a: *A.Allocator, cwd: str, dir: str) R.Result[str, str] {
    val abs_r: R.Result[str, str] = path.resolve(a, cwd, dir);
    if (R.is_err[str, str](abs_r)) { ret abs_r; }
    val clean_r: R.Result[str, str] = path.clean(a, R.unwrap_ok[str, str](abs_r));
    if (R.is_err[str, str](clean_r)) { ret clean_r; }
    ret R.ok[str, str](path.filename(R.unwrap_ok[str, str](clean_r)));
}

fun emit_targets(b: *Buf, reg: *target.TargetRegistry, arch_id: u32) {
    emit_target(b, reg, "linux",   arch_id);
    emit_target(b, reg, "windows", arch_id);
    emit_target(b, reg, "darwin",  arch_id);
}

fun emit_target(b: *Buf, reg: *target.TargetRegistry, os_name: *u8, arch_id: u32) {
    val abi_name: str = scaffold_abi(reg, os_name::str, arch_id);
    if (str_empty(abi_name)) { ret; }
    val isa_name: str = isa.arch_name_for(arch_id);
    buf_put(b, "[target.");
    buf_put(b, os_name);
    buf_put(b, "-");
    buf_put(b, isa_name::*u8);
    buf_put(b, "]\n");
    buf_put(b, "isa = \"");
    buf_put(b, isa_name::*u8);
    buf_put(b, "\"\n");
    buf_put(b, "os  = \"");
    buf_put(b, os_name);
    buf_put(b, "\"\n");
    buf_put(b, "abi = \"");
    buf_put(b, abi_name::*u8);
    buf_put(b, "\"\n");
    buf_put(b, "\n");
}

fun scaffold_abi(reg: *target.TargetRegistry, os_name: str, arch_id: u32) str {
    val os_opt: O.Option[*tos.OsVTable] = tos.lookup(?reg.os, os_name);
    if (O.is_none[*tos.OsVTable](os_opt)) { ret ""; }
    val abi_name: str = tos.native_abi_for(O.unwrap[*tos.OsVTable](os_opt), arch_id);
    if (str_empty(abi_name)) { ret ""; }
    if (R.is_err[target.Target, str](target.select(reg, isa.arch_name_for(arch_id), os_name, abi_name))) { ret ""; }
    ret abi_name;
}

test "mach.cli.cmd.init.emit_artifacts:extension_split" {
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    if (R.is_err[R.Void, str](driver.setup_registry(?reg))) { ret 1; }

    var bin_storage: [1024]u8;
    var bin: Buf;
    bin.ptr = ?bin_storage[0]; bin.cap = 1024; bin.len = 0; bin.ok = true;
    emit_artifacts(?bin, ?reg, isa.ARCH_X86_64, "demo", false);
    if (!bin.ok || bin.len >= bin.cap) { ret 1; }
    bin.ptr[bin.len] = 0;
    val want_bin: str = "[artifact.demo]\nkind = \"bin\"\nentry = \"root.mach\"\nout = \"bin/demo\"\ntargets = [\"linux-x86_64\", \"darwin-x86_64\"]\nlink = []\nneed = []\n\n[artifact.demo-windows]\nkind = \"bin\"\nentry = \"root.mach\"\nout = \"bin/demo.exe\"\ntargets = [\"windows-x86_64\"]\nlink = [\"kernel32\"]\nneed = []\n\n";
    if (!str_equals(bin.ptr::str, want_bin)) { ret 1; }

    var lib_storage: [512]u8;
    var lib: Buf;
    lib.ptr = ?lib_storage[0]; lib.cap = 512; lib.len = 0; lib.ok = true;
    emit_artifacts(?lib, ?reg, isa.ARCH_X86_64, "demo", true);
    if (!lib.ok || lib.len >= lib.cap) { ret 1; }
    lib.ptr[lib.len] = 0;
    val want_lib: str = "[artifact.demo]\nkind = \"static\"\nentry = \"lib.mach\"\nout = \"lib/libdemo.a\"\ntargets = [\"*\"]\nlink = []\nneed = []\n\n";
    if (!str_equals(lib.ptr::str, want_lib)) { ret 1; }
    ret 0;
}

fun t_manifest_from_text(a: *A.Allocator, itn: *intern.Interner, text: str) O.Option[manifest.Manifest] {
    val tr: R.Result[toml.Table, str] = toml.parse(a, text);
    if (R.is_err[toml.Table, str](tr)) { ret O.none[manifest.Manifest](); }
    var t: toml.Table = R.unwrap_ok[toml.Table, str](tr);
    val mr: R.Result[manifest.Manifest, str] = manifest.parse(a, itn, ?t, true);
    toml.dnit(a, ?t);
    if (R.is_err[manifest.Manifest, str](mr)) { ret O.none[manifest.Manifest](); }
    ret O.some[manifest.Manifest](R.unwrap_ok[manifest.Manifest, str](mr));
}

fun t_scaffold_plan_units(a: *A.Allocator, id: *u8, is_lib: bool, arch_id: u32) i64 {
    val text_r: R.Result[str, str] = build_manifest_text(a, id, is_lib, arch_id);
    if (R.is_err[str, str](text_r)) { ret -1; }
    val text: str = R.unwrap_ok[str, str](text_r);

    var itn: intern.Interner = intern.init(a);
    val opt_m: O.Option[manifest.Manifest] = t_manifest_from_text(a, ?itn, text);
    if (O.is_none[manifest.Manifest](opt_m)) { ret -1; }
    var m: manifest.Manifest = O.unwrap[manifest.Manifest](opt_m);

    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    if (R.is_err[R.Void, str](driver.setup_registry(?reg))) { ret -1; }

    var rq: request.BuildRequest = request.defaults();
    rq.project_root = "/scaftest";
    rq.all_targets  = true;

    val pr: R.Result[plan.BuildPlan, outcome.Fail] = plan.plan(a, ?itn, ?reg, ?m, rq);
    if (R.is_err[plan.BuildPlan, outcome.Fail](pr)) { ret -1; }
    val bp: plan.BuildPlan = R.unwrap_ok[plan.BuildPlan, outcome.Fail](pr);
    ret bp.units.len::i64;
}

test "mach.cli.cmd.init.build_manifest_text:bin_scaffold_parses_and_plans_for_every_host_arch" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }

    if (t_scaffold_plan_units(?alloc, "scaftest", false, isa.ARCH_X86_64)  != 3) { ret 1; }
    if (t_scaffold_plan_units(?alloc, "scaftest", false, isa.ARCH_AARCH64) != 2) { ret 1; }
    if (t_scaffold_plan_units(?alloc, "scaftest", false, isa.ARCH_RISCV64) != 1) { ret 1; }
    ret 0;
}

test "mach.cli.cmd.init.build_manifest_text:lib_scaffold_parses_and_plans_for_every_host_arch" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }

    if (t_scaffold_plan_units(?alloc, "scaftest", true, isa.ARCH_X86_64)  != 3) { ret 1; }
    if (t_scaffold_plan_units(?alloc, "scaftest", true, isa.ARCH_AARCH64) != 2) { ret 1; }
    if (t_scaffold_plan_units(?alloc, "scaftest", true, isa.ARCH_RISCV64) != 1) { ret 1; }
    ret 0;
}

test "mach.cli.cmd.init.source_template:lib_is_empty_bin_declares_std_runtime" {
    if (!str_empty(source_template(true)::str)) { ret 1; }

    val bin: str = source_template(false)::str;
    if (str_empty(bin)) { ret 1; }
    if (!str_contains(bin, "std.runtime")) { ret 1; }
    if (str_contains(bin, "_start")) { ret 1; }
    if (str_contains(bin, "mainCRTStartup")) { ret 1; }
    if (str_contains(bin, "ExitProcess")) { ret 1; }
    if (str_contains(bin, "asm ")) { ret 1; }
    ret 0;
}

test "mach.cli.cmd.init.build_manifest_text:declares_dep_std" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }

    val text_r: R.Result[str, str] = build_manifest_text(?alloc, "scaftest", false, isa.ARCH_X86_64);
    if (R.is_err[str, str](text_r)) { ret 1; }
    val text: str = R.unwrap_ok[str, str](text_r);
    if (!str_contains(text, "[dep.std]")) { ret 1; }

    var itn: intern.Interner = intern.init(?alloc);
    val opt_m: O.Option[manifest.Manifest] = t_manifest_from_text(?alloc, ?itn, text);
    if (O.is_none[manifest.Manifest](opt_m)) { ret 1; }
    val m: manifest.Manifest = O.unwrap[manifest.Manifest](opt_m);

    if (m.dep_count != 1) { ret 1; }
    val name_opt: O.Option[str] = intern.lookup(?itn, m.deps[0].name);
    if (O.is_none[str](name_opt) || !str_equals(O.unwrap[str](name_opt), "std")) { ret 1; }
    val git_opt: O.Option[str] = intern.lookup(?itn, m.deps[0].git);
    if (O.is_none[str](git_opt) || !str_equals(O.unwrap[str](git_opt), "https://github.com/briar-systems/mach-std")) { ret 1; }
    val ref_opt: O.Option[str] = intern.lookup(?itn, m.deps[0].ref);
    if (O.is_none[str](ref_opt) || !str_equals(O.unwrap[str](ref_opt), "branch/main")) { ret 1; }
    ret 0;
}

fun t_source_parses(alloc: *A.Allocator, text: str) bool {
    val sr: R.Result[session.Session, str] = session.init(alloc);
    if (R.is_err[session.Session, str](sr)) { ret false; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    var es: editor.EditorSession = editor.init(?s);

    val open_r: R.Result[source.FileId, str] = editor.open(?es, "/mach-init-standalone-parse-check/entry.mach", text);
    if (R.is_err[source.FileId, str](open_r)) { editor.dnit(?es); session.dnit(?s); ret false; }
    val fid: source.FileId = R.unwrap_ok[source.FileId, str](open_r);

    val parse_r: R.Result[*ast.Ast, str] = editor.parse(?es, fid);
    var ok: bool = true;
    if (R.is_err[*ast.Ast, str](parse_r)) { ok = false; }

    val diag_r: R.Result[*diagnostic.DiagnosticStore, str] = editor.diagnostics(?es, fid);
    if (R.is_err[*diagnostic.DiagnosticStore, str](diag_r)) { ok = false; }
    or {
        if (diagnostic.has_errors(R.unwrap_ok[*diagnostic.DiagnosticStore, str](diag_r))) { ok = false; }
    }

    editor.dnit(?es);
    session.dnit(?s);
    ret ok;
}

fun t_entry_parses(alloc: *A.Allocator, dest: str, entry_rel: str) bool {
    val p_r: R.Result[str, str] = path.join(alloc, dest, entry_rel);
    if (R.is_err[str, str](p_r)) { ret false; }
    val p: str = R.unwrap_ok[str, str](p_r);
    val text_opt: O.Option[str] = t_read_file(alloc, p);
    str_free(alloc, p);
    if (O.is_none[str](text_opt)) { ret false; }
    ret t_source_parses(alloc, O.unwrap[str](text_opt));
}

