test "mach.cli.cmd.init.run_typed:force_replaces_owned_outputs_and_leaves_an_unowned_neighbor_byte_identical" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val root_r: R.Result[str, str] = t_scratch_dir(?alloc, "mach_init_force");
    if (R.is_err[str, str](root_r)) { ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);
    var bad: i32 = 0;

    val toml_r: R.Result[str, str] = path.join(?alloc, root, "mach.toml");
    val toml: str = R.unwrap_ok[str, str](toml_r);
    if (O.is_some[str](fs.write_bytes(toml, "stale"::*u8, 5::usize, 0o644))) { bad = 1; }
    val src_dir_r: R.Result[str, str] = path.join(?alloc, root, "src");
    if (O.is_some[str](fs.create_dir(R.unwrap_ok[str, str](src_dir_r), 0o755))) { bad = 1; }
    val entry_r: R.Result[str, str] = path.join(?alloc, root, "src/root.mach");
    val entry: str = R.unwrap_ok[str, str](entry_r);
    if (O.is_some[str](fs.write_bytes(entry, "stale-source"::*u8, 12::usize, 0o644))) { bad = 1; }
    val neighbor_r: R.Result[str, str] = path.join(?alloc, root, "src/mine.mach");
    val neighbor: str = R.unwrap_ok[str, str](neighbor_r);
    if (O.is_some[str](fs.write_bytes(neighbor, "user-owned"::*u8, 10::usize, 0o644))) { bad = 1; }
    val readme_r: R.Result[str, str] = path.join(?alloc, root, "README.md");
    val readme: str = R.unwrap_ok[str, str](readme_r);
    if (O.is_some[str](fs.write_bytes(readme, "hello"::*u8, 5::usize, 0o644))) { bad = 1; }

    var argv: [7]*u8;
    argv[0] = "mach"; argv[1] = "init"; argv[2] = root::*u8; argv[3] = "--name"; argv[4] = "forced"::*u8; argv[5] = "--force"::*u8; argv[6] = "--no-deps"::*u8;

    val rc: i64 = t_init(7, ?argv[0]);
    if (rc != 0) { bad = 1; }

    val new_toml: O.Option[str] = t_read_file(?alloc, toml);
    if (O.is_none[str](new_toml) || str_equals(O.unwrap[str](new_toml), "stale")) { bad = 1; }
    val new_entry: O.Option[str] = t_read_file(?alloc, entry);
    if (O.is_none[str](new_entry) || str_equals(O.unwrap[str](new_entry), "stale-source")) { bad = 1; }
    val kept_neighbor: O.Option[str] = t_read_file(?alloc, neighbor);
    if (O.is_none[str](kept_neighbor) || !str_equals(O.unwrap[str](kept_neighbor), "user-owned")) { bad = 1; }
    val kept_readme: O.Option[str] = t_read_file(?alloc, readme);
    if (O.is_none[str](kept_readme) || !str_equals(O.unwrap[str](kept_readme), "hello")) { bad = 1; }

    var jname: str = sfmt_join(?alloc, root, JOURNAL_LEAF);
    if (fs.exists(jname)) { bad = 1; }
    var bname: str = sfmt_join(?alloc, root, BACKUP_MANIFEST);
    if (fs.exists(bname)) { bad = 1; }

    fs.remove_all(?alloc, root);
    str_free(?alloc, root);
    ret bad;
}

fun sfmt_join(alloc: *A.Allocator, root: str, leaf: str) str {
    val r: R.Result[str, str] = path.join(alloc, root, leaf);
    if (R.is_err[str, str](r)) { ret ""; }
    ret R.unwrap_ok[str, str](r);
}

