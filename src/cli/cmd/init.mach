val DIR_MODE:  i32 = 493;
val FILE_MODE: i32 = 420;

rec Buf {
    ptr: *u8;
    cap: usize;
    len: usize;
    ok:  bool;
}

# `mach init`: scaffold a project. the positional names the directory (default the working
# directory) and, unless `--name` is given, the project id, which must be a portable
# identifier. an absent directory is created whole; an existing one is filled in, and
# `--force` allows overwriting mach.toml and the entry file. `--lib` writes src/lib.mach
# and a static artifact instead of src/root.mach and binary artifacts. the std dependency
# is then realized as a git submodule unless `--no-deps`; `--quiet` silences progress
# ---
# argv: the full process arguments
# inv: the parsed invocation for this command
# ret: 0 success, 1 an invalid id, a refused overwrite, or a failed publish, 2 allocator or
#  filesystem failure, 3 the std dependency could not be realized
pub fun run(argv: **u8, inv: *args.ParsedInvocation) i64 {
    if (args.reject_unknown_from_invocation(inv, argv, "mach init")) { ret 1; }
    val parsed: args.InitInvocation = args.build_init_invocation(inv, argv);
    val force:   bool = parsed.force;
    val is_lib:  bool = parsed.is_lib;
    val no_deps: bool = parsed.no_deps;
    val no_git: bool = parsed.no_git;
    val quiet:   bool = parsed.quiet;

    var backing: A.Allocator;
    val make_r: err[A.Error] = page.make(?backing);
    if (sel make_r.err) {
        print.eprint("error: failed to initialise allocator\n");
        ret 2;
    }
    var ar: arena.Arena;
    val init_r: err[A.Error] = arena.init(?ar, ?backing, 0);
    if (sel init_r.err) {
        print.eprint("error: failed to initialise allocator\n");
        ret 2;
    }
    var a: A.Allocator;
    val make_r2: err[A.Error] = arena.make(?a, ?ar);
    if (sel make_r2.err) {
        arena.dnit(?ar);
        print.eprint("error: failed to initialise allocator\n");
        ret 2;
    }

    val cwd_r: res[string.OwnedString, env.EnvError] = env.current_dir(?a);
    if (sel cwd_r.err) {
        print.eprint("error: failed to read the working directory\n");
        arena.dnit(?ar);
        ret 2;
    }
    var cwd_owned: string.OwnedString = cwd_r.ok;
    val cwd: str = cwd_owned.data;

    var dir: *u8 = cwd;
    if (parsed.has_dir) { dir = argv[parsed.dir_idx]; }

    val id_r: res[str, outcome.Fail] = default_project_id(?a, cwd, dir::str);
    if (sel id_r.err) {
        print.eprint("error: out of memory\n");
        arena.dnit(?ar);
        ret 2;
    }
    var id: *u8 = id_r.ok;
    if (parsed.has_name) { id = argv[parsed.name_idx]; }

    if (!manifest.is_valid_id(id::str)) {
        print.eprint("error: '");
        print.eprint(id::str);
        print.eprint("' is not a valid project id\n");
        print.eprint("       a project id may contain only letters, digits, '_', or '-' (no '.', '/', or spaces)\n");
        print.eprint("       pass a valid name as the argument or with --name <name>\n");
        arena.dnit(?ar);
        ret 1;
    }

    var entry_leaf:  *u8 = "root.mach";
    var entry_label: *u8 = "src/root.mach";
    if (is_lib) {
        entry_leaf  = "lib.mach";
        entry_label = "src/lib.mach";
    }

    val split_r: res[DestSplit, outcome.Fail] = split_for_discovery(?a, cwd, dir::str);
    if (sel split_r.err) {
        print.eprint("error: out of memory\n");
        arena.dnit(?ar);
        ret 2;
    }
    var split: DestSplit = split_r.ok;
    if (path.is_abs(dir::str)) {
        val anchored: err[txn.Error] = anchor_absolute_parent(?a, ?split);
        if (sel anchored.err) {
            print.eprintlnf("error: {}", txn_msg(anchored.err));
            arena.dnit(?ar);
            ret 2;
        }
    }

    var mp: txn.Descent;
    val disc_r: res[bool, txn.Error] = txn.descend(?mp, ?a, split.root, split.dest_rel);
    if (sel disc_r.err) {
        print.eprint("error: ");
        print.eprint(txn.error_message(disc_r.err));
        print.eprint("\n");
        arena.dnit(?ar);
        ret 1;
    }
    val missing: bool = disc_r.ok;

    val dest_root_r: res[str, A.Error] = path.join(?a, split.root, split.dest_rel);
    if (sel dest_root_r.err) {
        if (missing) {
            val closed: err[txn.Error] = txn.descent_dnit(?a, ?mp);
            if (sel closed.err) { print.eprint("error: "); print.eprint(txn_msg(closed.err)); print.eprint("\n"); }
        }
        print.eprint("error: out of memory\n");
        arena.dnit(?ar);
        ret 2;
    }
    val dest_root: str = dest_root_r.ok;

    if (missing) {
        val code: i64 = run_absent_branch(?a, ?mp, id, is_lib, entry_label, quiet);
        if (code == 0) {
            val dep_code: i64 = dependency_stage(?a, dest_root, no_deps, no_git, quiet);
            arena.dnit(?ar);
            ret dep_code;
        }
        arena.dnit(?ar);
        ret code;
    }

    val code: i64 = run_existing_branch(?a, split.root, split.dest_rel, id, is_lib, entry_leaf, entry_label, force, quiet);
    if (code == 0) {
        val dep_code: i64 = dependency_stage(?a, dest_root, no_deps, no_git, quiet);
        arena.dnit(?ar);
        ret dep_code;
    }
    arena.dnit(?ar);
    ret code;
}

fun t_init(argc: usize, argv: **u8) i64 {
    var a: A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 2; }
    val ir: res[args.ParsedInvocation, outcome.Fail] = args.parse_invocation(?a, argc, argv);
    if (sel ir.err) { ret 2; }
    var inv: args.ParsedInvocation = ir.ok;
    ret run(argv, ?inv);
}

rec ScaffoldDep {
    id:  str;
    git: str;
    ref: str;
}

val SCAFFOLD_DEP_COUNT: usize = 1;
val SCAFFOLD_DEPS: [1]ScaffoldDep = [1]ScaffoldDep{
    ScaffoldDep{ id: "std", git: "https://github.com/briar-systems/mach-std", ref: "branch/main" }
};

fun dependency_stage(a: *A.Allocator, root: str, no_deps: bool, no_git: bool, quiet: bool) i64 {
    val sr: res[session.Session, fail.Fail] = session.init(a);
    if (sel sr.err) {
        val fail: outcome.Fail = outcome.internal("failed to initialize project setup");
        ret cli_diag.render_fail(?fail);
    }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var mode: u8 = ddep.REALIZE_NESTED;
    if (!no_git) {
        val initialized: err[outcome.Fail] = ddep.initialize_repository(?s, root);
        if (sel initialized.err) {
            val fail: outcome.Fail = initialized.err;
            ret cli_diag.render_fail(?fail);
        }
        val selected: res[u8, outcome.Fail] = ddep.realization_mode(?s, root);
        if (sel selected.err) {
            val fail: outcome.Fail = selected.err;
            ret cli_diag.render_fail(?fail);
        }
        mode = selected.ok;
    }
    if (no_deps) {
        if (!quiet) {
            print.eprint("dependencies declared but not realized; run `mach dep pull <path>` for project '");
            print.eprint(root);
            print.eprint("'\n");
        }
        ret 0;
    }
    var i: usize = 0;
    for (i < SCAFFOLD_DEP_COUNT) {
        val dep: ScaffoldDep = SCAFFOLD_DEPS[i];
        val realized: err[outcome.Fail] = ddep.realize_git_dependency(?s, root, dep.id, dep.git, dep.ref, mode);
        if (sel realized.err) {
            val msg_r: res[str, format.FormatError] = format.sprint(a,
                "dependency '{}' could not be realized: {}", dep.id, outcome.describe(realized.err));
            if (sel msg_r.err) {
                val fail: outcome.Fail = outcome.environment("a declared dependency could not be realized");
                ret cli_diag.render_fail(?fail);
            }
            val fail: outcome.Fail = outcome.environment(msg_r.ok);
            ret cli_diag.render_fail(?fail);
        }
        if (!quiet) { print.eprintlnf("realized dependency '{}'", dep.id); }
        i = i + 1;
    }
    ret 0;
}

rec DestSplit {
    root:     str;
    dest_rel: str;
}

fun split_for_discovery(alloc: *A.Allocator, cwd: str, dir: str) res[DestSplit, outcome.Fail] {
    val cleaned_r: res[str, A.Error] = path.clean(alloc, dir);
    if (sel cleaned_r.err) { ret res[DestSplit, outcome.Fail].err{outcome.refused(cleaned_r.err)}; }
    val cleaned: str = cleaned_r.ok;
    fin { str_free(alloc, cleaned); }

    var root_source: str = cwd;
    var root_len: usize = str_len(cwd);
    var relative_start: usize = 0;
    val cleaned_len: usize = str_len(cleaned);
    if (path.is_abs(cleaned)) {
        root_source = cleaned;
        root_len = path.root(cleaned).len;
        relative_start = root_len;
        for (relative_start < cleaned_len && path.is_separator(cleaned[relative_start])) {
            relative_start = relative_start + 1;
        }
    }
    or (str_equals(cleaned, ".")) { relative_start = cleaned_len; }

    val root_r: res[str, string.StrError] = str_copy_slice(alloc, root_source, 0, root_len);
    if (sel root_r.err) { ret res[DestSplit, outcome.Fail].err{outcome.user(outcome.str_text(root_r.err))}; }
    var ds: DestSplit;
    ds.root = root_r.ok;
    val relative_r: res[str, string.StrError] = str_copy_slice(alloc, cleaned, relative_start, cleaned_len - relative_start);
    if (sel relative_r.err) {
        str_free(alloc, ds.root);
        ret res[DestSplit, outcome.Fail].err{outcome.user(outcome.str_text(relative_r.err))};
    }
    ds.dest_rel = relative_r.ok;
    var i: usize = 0;
    for (ds.dest_rel[i] != 0) {
        if (path.is_separator(ds.dest_rel[i])) { ds.dest_rel[i] = '/'; }
        i = i + 1;
    }
    ret res[DestSplit, outcome.Fail].ok{ds};
}

fun anchor_absolute_parent(alloc: *A.Allocator, split: *DestSplit) err[txn.Error] {
    val n: usize = str_len(split.dest_rel);
    if (n == 0) { ret err[txn.Error].ok{}; }
    var cut: usize = n;
    for (cut > 0 && split.dest_rel[cut - 1] != '/'::u8) { cut = cut - 1; }
    var parent_end: usize = 0;
    if (cut > 0) { parent_end = cut - 1; }
    for (parent_end > 0) {
        val prefix_r: res[str, string.StrError] = str_copy_slice(alloc, split.dest_rel, 0, parent_end);
        if (sel prefix_r.err) { ret err[txn.Error].err{txn.error(txn.MEMORY, txn.OP_ROOT_OPEN)}; }
        val prefix: str = prefix_r.ok;
        val parent_r: res[str, A.Error] = path.join(alloc, split.root, prefix);
        str_free(alloc, prefix);
        if (sel parent_r.err) { ret err[txn.Error].err{txn.error(txn.MEMORY, txn.OP_ROOT_OPEN)}; }
        val parent: str = parent_r.ok;
        var probe: txn.Root;
        val opened: err[txn.Error] = txn.root_open(?probe, parent, "");
        if (sel opened.ok) {
            val closed: err[txn.Error] = txn.root_dnit(?probe);
            if (sel closed.err) { str_free(alloc, parent); ret closed; }
            var start: usize = parent_end;
            if (start < n && split.dest_rel[start] == '/'::u8) { start = start + 1; }
            val suffix_r: res[str, string.StrError] = str_copy_slice(alloc, split.dest_rel, start, n - start);
            if (sel suffix_r.err) {
                str_free(alloc, parent);
                ret err[txn.Error].err{txn.error(txn.MEMORY, txn.OP_ROOT_OPEN)};
            }
            str_free(alloc, split.root);
            str_free(alloc, split.dest_rel);
            split.root = parent;
            split.dest_rel = suffix_r.ok;
            ret err[txn.Error].ok{};
        }
        str_free(alloc, parent);
        val error: txn.Error = opened.err;
        if (error.kind != txn.IO || error.code != os.ENOENT) { ret opened; }
        cut = parent_end;
        for (cut > 0 && split.dest_rel[cut - 1] != '/'::u8) { cut = cut - 1; }
        parent_end = 0;
        if (cut > 0) { parent_end = cut - 1; }
    }
    ret err[txn.Error].ok{};
}

# place an inventory path under the part of the destination that is missing
#
# the transaction publishes one component, so when the destination is several
# levels below the deepest existing directory, everything the scaffold contains
# has to be addressed relative to that one component rather than to the
# destination itself.
fun under_remainder(a: *A.Allocator, remainder: str, rel: str) res[str, outcome.Fail] {
    if (str_empty(remainder)) {
        val str_copy_slice_r: res[str, string.StrError] = str_copy_slice(a, rel, 0, str_len(rel));
        if (sel str_copy_slice_r.err) { ret res[str, outcome.Fail].err{outcome.user(outcome.str_text(str_copy_slice_r.err))}; }
        ret res[str, outcome.Fail].ok{str_copy_slice_r.ok};
    }
    val sprint_r: res[str, format.FormatError] = format.sprint(a, "{}/{}", remainder, rel);
    if (sel sprint_r.err) { ret res[str, outcome.Fail].err{outcome.user(outcome.format_text(sprint_r.err))}; }
    ret res[str, outcome.Fail].ok{sprint_r.ok};
}

fun run_absent_branch(a: *A.Allocator, mp: *txn.Descent, id: *u8, is_lib: bool,
                      entry_label: *u8, quiet: bool) i64 {
    var guard: txn.Lock;
    var claim: txn.Claim;
    var failure: err[txn.Error] = txn.lock(?guard, ?mp.root);
    val locked: bool = sel failure.ok;
    if (locked) {
        val recovered: res[usize, txn.Error] = txn.recover(a, ?guard, "");
        if (sel recovered.err) { failure = err[txn.Error].err{recovered.err}; }
    }
    val failure_ok: bool = sel failure.ok;
    if (failure_ok) { failure = txn.claim(?claim, a, ?guard, mp.first_missing); }
    var code: i64 = 2;
    if (sel failure.ok) { code = run_absent_scaffold(a, mp, ?claim, id, is_lib, entry_label, quiet); }
    val released: err[txn.Error] = txn.release_claim(?claim);
    val first_released: bool = sel failure.ok;
    if (first_released) { failure = released; }
    val unlocked: err[txn.Error] = txn.unlock(?guard);
    val first_unlocked: bool = sel failure.ok;
    if (first_unlocked) { failure = unlocked; }
    val closed: err[txn.Error] = txn.descent_dnit(a, mp);
    val first_closed: bool = sel failure.ok;
    if (first_closed) { failure = closed; }
    if (sel failure.err) { print.eprint("error: "); print.eprint(txn_msg(failure.err)); print.eprint("\n"); ret 2; }
    ret code;
}

fun run_absent_scaffold(a: *A.Allocator, mp: *txn.Descent, claim: *txn.Claim, id: *u8, is_lib: bool,
                      entry_label: *u8, quiet: bool) i64 {
    val text_r: res[str, outcome.Fail] = build_manifest_text(a, id, is_lib, target.host_arch_id());
    if (sel text_r.err) {
        print.eprint("error: failed to build mach.toml\n");
        ret 2;
    }
    val text: str = text_r.ok;
    fin { str_free(a, text); }

    val manifest_rel_r: res[str, outcome.Fail] = under_remainder(a, mp.remainder, "mach.toml");
    if (sel manifest_rel_r.err) {
        print.eprint("error: cannot plan mach.toml path\n");
        ret 2;
    }
    val manifest_rel: str = manifest_rel_r.ok;
    fin { str_free(a, manifest_rel); }
    val entry_rel_r: res[str, outcome.Fail] = under_remainder(a, mp.remainder, entry_label::str);
    if (sel entry_rel_r.err) {
        print.eprint("error: cannot plan source entry path\n");
        ret 2;
    }
    val entry_rel: str = entry_rel_r.ok;
    fin { str_free(a, entry_rel); }

    var inv: txn.Inventory = txn.inventory_init(a);
    val push1: err[txn.Error] = txn.inventory_push(?inv,
        txn.entry_file(manifest_rel, text::*u8, str_len(text), FILE_MODE));
    if (sel push1.err) {
        print.eprint("error: internal: cannot plan mach.toml\n");
        txn.inventory_dnit(?inv);
        ret 2;
    }

    val src_text: str = source_template(is_lib)::str;
    val push2: err[txn.Error] = txn.inventory_push(?inv,
        txn.entry_file(entry_rel, src_text::*u8, str_len(src_text), FILE_MODE));
    if (sel push2.err) {
        print.eprint("error: internal: cannot plan ");
        print.eprint(entry_label);
        print.eprint("\n");
        txn.inventory_dnit(?inv);
        ret 2;
    }

    # the whole missing chain is staged privately and appears with one rename,
    # so a reader never sees a scaffold that is half written
    val published: err[outcome.Fail] = publication.subtree(a, claim, ?inv, DIR_MODE);
    txn.inventory_dnit(?inv);
    if (sel published.err) {
        print.eprint("error: ");
        print.eprint(outcome.describe(published.err));
        print.eprint("\n");
        ret 1;
    }

    if (!quiet) {
        print.eprint("created project '");
        print.eprint(id::str);
        print.eprint("'\n");
    }
    ret 0;
}

val JOURNAL_LEAF:     str = ".machinit.journal";
val BACKUP_MANIFEST:  str = ".machinit.mach.toml.backup";
val BACKUP_ENTRY_BIN: str = ".machinit.root.mach.backup";
val BACKUP_ENTRY_LIB: str = ".machinit.lib.mach.backup";

val INIT_JOURNAL_MAGIC: u32 = 0x494e4954;

rec InitJournal {
    magic: u32;
    root: txn.Identity;
    source_present: bool;
    source: txn.Identity;
    manifest_had_identity: bool;
    manifest_prior: txn.Identity;
    manifest_new: txn.Identity;
    entry_is_lib: bool;
    entry_had_identity: bool;
    entry_prior: txn.Identity;
    entry_new: txn.Identity;
    src_dir_created: bool;
}

val RECOVER_CLEAN:       i32 = 0;
val RECOVER_ROLLED_BACK: i32 = 1;
val RECOVER_COMPLETED:   i32 = 2;

fun entry_backup_leaf(is_lib: bool) str {
    if (is_lib) { ret BACKUP_ENTRY_LIB; }
    ret BACKUP_ENTRY_BIN;
}

# init formats the transaction layer's closed error kind at its command boundary
fun txn_msg(e: txn.Error) str {
    ret txn.error_message(e);
}

rec InitDirectory {
    root: txn.Root;
    guard: txn.Lock;
    names: [4]str;
    claims: [4]txn.Claim;
}

rec InitEntry {
    present: bool;
    is_regular: bool;
    is_directory: bool;
    identity: txn.Identity;
}

fun directory_close(cap: *InitDirectory) err[outcome.Fail] {
    var failure: err[txn.Error] = err[txn.Error].ok{};
    var i: usize = 4;
    for (i > 0) {
        i = i - 1;
        val released: err[txn.Error] = txn.release_claim(?cap.claims[i]);
        val first_released: bool = sel failure.ok;
        if (first_released) { failure = released; }
    }
    val unlocked: err[txn.Error] = txn.unlock(?cap.guard);
    val first_unlocked: bool = sel failure.ok;
    if (first_unlocked) { failure = unlocked; }
    val closed: err[txn.Error] = txn.root_dnit(?cap.root);
    val first_closed: bool = sel failure.ok;
    if (first_closed) { failure = closed; }
    if (sel failure.err) { ret err[outcome.Fail].err{outcome.user(txn_msg(failure.err))}; }
    ret err[outcome.Fail].ok{};
}

fun directory_admit(cap: *InitDirectory, a: *A.Allocator, source: bool) err[outcome.Fail] {
    val locked: err[txn.Error] = txn.lock(?cap.guard, ?cap.root);
    if (sel locked.err) { ret err[outcome.Fail].err{outcome.user(txn_msg(locked.err))}; }
    val recovered: res[usize, txn.Error] = txn.recover(a, ?cap.guard, "");
    if (sel recovered.err) { ret err[outcome.Fail].err{outcome.user(txn_msg(recovered.err))}; }
    if (source) {
        cap.names[0] = "root.mach";
        cap.names[1] = BACKUP_ENTRY_BIN;
        cap.names[2] = "lib.mach";
        cap.names[3] = BACKUP_ENTRY_LIB;
    } or {
        cap.names[0] = util.PROJECT_CONFIG_NAME;
        cap.names[1] = BACKUP_MANIFEST;
        cap.names[2] = JOURNAL_LEAF;
        cap.names[3] = "src";
    }
    var i: usize = 0;
    for (i < 4) {
        val reserved: err[txn.Error] = txn.claim(?cap.claims[i], a, ?cap.guard, cap.names[i]);
        if (sel reserved.err) { ret err[outcome.Fail].err{outcome.user(txn_msg(reserved.err))}; }
        i = i + 1;
    }
    ret err[outcome.Fail].ok{};
}

fun destination(cap: *InitDirectory, leaf: str) *txn.Claim {
    var i: usize = 0;
    for (i < 4) {
        if (str_equals(cap.names[i], leaf)) { ret ?cap.claims[i]; }
        i = i + 1;
    }
    ret nil;
}

fun open_root(out: *InitDirectory, a: *A.Allocator, root: str, rel: str) err[outcome.Fail] {
    val opened: err[txn.Error] = txn.root_open(?out.root, root, rel);
    if (sel opened.err) { ret err[outcome.Fail].err{outcome.user(txn_msg(opened.err))}; }
    ret directory_admit(out, a, false);
}

fun open_src_cap(out: *InitDirectory, a: *A.Allocator, parent: *InitDirectory) err[outcome.Fail] {
    val opened: err[txn.Error] = txn.root_open_child(?out.root, ?parent.root, "src");
    if (sel opened.err) { ret err[outcome.Fail].err{outcome.user(txn_msg(opened.err))}; }
    ret directory_admit(out, a, true);
}

fun probe_entry(cap: *InitDirectory, leaf: str) res[InitEntry, outcome.Fail] {
    val observed: res[txn.EntryProbe, txn.Error] = txn.entry_probe(?cap.root, leaf);
    if (sel observed.err) {
        ret res[InitEntry, outcome.Fail].err{outcome.user(txn_msg(observed.err))};
    }
    val probe: txn.EntryProbe = observed.ok;
    var result: InitEntry;
    result.present = probe.present;
    result.is_regular = probe.is_regular;
    result.is_directory = probe.is_directory;
    if (probe.present) {
        val identified: res[opt[txn.Identity], txn.Error] = txn.entry_identity(?cap.root, leaf);
        if (sel identified.err) {
            ret res[InitEntry, outcome.Fail].err{outcome.user(txn_msg(identified.err))};
        }
        val identity: opt[txn.Identity] = identified.ok;
        if (sel identity.none) { ret res[InitEntry, outcome.Fail].err{outcome.user("init entry disappeared during inspection")}; }
        result.identity = identity.some;
    }
    ret res[InitEntry, outcome.Fail].ok{result};
}

fun rename_entry(cap: *InitDirectory, from: str, to: str) err[outcome.Fail] {
    val e: err[txn.Error] = txn.entry_rename(destination(cap, from), destination(cap, to));
    if (sel e.ok) { ret err[outcome.Fail].ok{}; }
    ret err[outcome.Fail].err{outcome.user(txn_msg(e.err))};
}

fun unlink_entry(cap: *InitDirectory, leaf: str) err[outcome.Fail] {
    val e: err[txn.Error] = txn.entry_unlink(destination(cap, leaf));
    if (sel e.ok) { ret err[outcome.Fail].ok{}; }
    ret err[outcome.Fail].err{outcome.user(txn_msg(e.err))};
}

fun stage_owned(out: *txn.Transaction, a: *A.Allocator, cap: *InitDirectory, leaf: str,
                data: *u8, len: usize) err[outcome.Fail] {
    var options: txn.PrepareOptions;
    options.precondition = txn.PRE_SAME_OBJECT;
    options.prior_access = txn.READ_AUTHORIZED;
    options.durability = txn.durability_none();
    val prepared: err[txn.Error] = txn.prepare_bytes(out, a, destination(cap, leaf), data, len, FILE_MODE, false, options);
    if (sel prepared.err) { ret err[outcome.Fail].err{outcome.user(txn_msg(prepared.err))}; }
    ret err[outcome.Fail].ok{};
}

fun stage_source(out: *txn.Transaction, a: *A.Allocator, cap: *InitDirectory,
                 leaf: str, data: *u8, len: usize) err[outcome.Fail] {
    var inventory: txn.Inventory = txn.inventory_init(a);
    fin { txn.inventory_dnit(?inventory); }
    val added: err[txn.Error] = txn.inventory_push(?inventory, txn.entry_file(leaf, data, len, FILE_MODE));
    if (sel added.err) { ret err[outcome.Fail].err{outcome.user(txn_msg(added.err))}; }
    var options: txn.PrepareOptions;
    options.precondition = txn.PRE_ABSENT;
    options.durability = txn.durability_none();
    val prepared: err[txn.Error] = txn.prepare_subtree(out, a,
        destination(cap, "src"), ?inventory, DIR_MODE, options);
    if (sel prepared.err) { ret err[outcome.Fail].err{outcome.user(txn_msg(prepared.err))}; }
    ret err[outcome.Fail].ok{};
}

fun rmdir_entry(cap: *InitDirectory, leaf: str) err[outcome.Fail] {
    val e: err[txn.Error] = txn.entry_rmdir_if_empty(destination(cap, leaf));
    if (sel e.ok) { ret err[outcome.Fail].ok{}; }
    ret err[outcome.Fail].err{outcome.user(txn_msg(e.err))};
}

fun root_identity_of(cap: *InitDirectory) res[txn.Identity, outcome.Fail] {
    val r: res[txn.Identity, txn.Error] = txn.root_identity(?cap.root);
    if (sel r.err) { ret res[txn.Identity, outcome.Fail].err{outcome.user(txn_msg(r.err))}; }
    ret res[txn.Identity, outcome.Fail].ok{r.ok};
}

fun staged_identity_of(t: *txn.Transaction) res[txn.Identity, outcome.Fail] {
    val r: res[txn.Identity, txn.Error] = txn.transaction_staged_identity(t);
    if (sel r.err) { ret res[txn.Identity, outcome.Fail].err{outcome.user(txn_msg(r.err))}; }
    ret res[txn.Identity, outcome.Fail].ok{r.ok};
}

fun journal_read(root_cap: *InitDirectory) res[opt[InitJournal], outcome.Fail] {
    var j: InitJournal;
    val jsize: usize = $size_of(InitJournal);
    val read_r: res[opt[usize], txn.Error] = txn.entry_read_all(?root_cap.root, JOURNAL_LEAF, (?j)::*u8, jsize);
    if (sel read_r.err) {
        ret res[opt[InitJournal], outcome.Fail].err{outcome.user(txn_msg(read_r.err))};
    }
    val got: opt[usize] = read_r.ok;
    if (sel got.none) { ret res[opt[InitJournal], outcome.Fail].ok{opt[InitJournal].none{}}; }
    if (got.some != jsize) { ret res[opt[InitJournal], outcome.Fail].err{outcome.user("init journal has an unexpected size")}; }
    if (j.magic != INIT_JOURNAL_MAGIC) {
        ret res[opt[InitJournal], outcome.Fail].err{outcome.user("init journal has an invalid signature")};
    }
    ret res[opt[InitJournal], outcome.Fail].ok{opt[InitJournal].some{j}};
}

fun journal_create(a: *A.Allocator, root_cap: *InitDirectory, source_identity: *txn.Identity,
                   root_id: txn.Identity, manifest_probe: InitEntry, manifest_new: txn.Identity,
                   entry_probe: InitEntry, entry_new: txn.Identity,
                   is_lib: bool, src_dir_created: bool) err[outcome.Fail] {
    var j: InitJournal;
    j.magic = INIT_JOURNAL_MAGIC;
    j.root = root_id;
    if (source_identity != nil) {
        j.source_present = true;
        j.source = source_identity[0];
    }
    j.manifest_had_identity = manifest_probe.present;
    j.manifest_prior = manifest_probe.identity;
    j.manifest_new = manifest_new;
    j.entry_is_lib = is_lib;
    j.entry_had_identity = entry_probe.present;
    j.entry_prior = entry_probe.identity;
    j.entry_new = entry_new;
    j.src_dir_created = src_dir_created;
    ret publication.bytes_at(nil, a, destination(root_cap, JOURNAL_LEAF), JOURNAL_LEAF,
        (?j)::*u8, $size_of(InitJournal), FILE_MODE, publication.CREATE,
        "write", "the init journal could not be published", nil);
}

fun commit_owned(a: *A.Allocator, cap: *InitDirectory, pf: *txn.Transaction,
                 live: *bool, backup_leaf: str) err[outcome.Fail] {
    val result: txn.BackupOutcome = txn.commit_with_backup(pf, destination(cap, backup_leaf));
    if (result.consumed) { live[0] = false; }
    if (result.staging_residue != nil) {
        print.eprint("error: init staging cleanup left ");
        print.eprint(result.staging_residue);
        print.eprint(" for locked startup recovery\n");
        str_free(a, result.staging_residue);
    }
    if (sel result.cleanup_failure.err) {
        print.eprint("error: "); print.eprint(txn_msg(result.cleanup_failure.err)); print.eprint("\n");
    }
    if (sel result.failure.err) { ret err[outcome.Fail].err{outcome.user(txn_msg(result.failure.err))}; }
    if (sel result.cleanup_failure.err) { ret err[outcome.Fail].err{outcome.user(txn_msg(result.cleanup_failure.err))}; }
    if (!result.consumed || !result.published) { ret err[outcome.Fail].err{outcome.user("init file commit did not publish its prepared content")}; }
    ret err[outcome.Fail].ok{};
}

fun resolve_rollback(cap: *InitDirectory,
                     final_leaf: str, backup_leaf: str, had_identity_before: bool) err[outcome.Fail] {
    val probe_r: res[InitEntry, outcome.Fail] = probe_entry(cap, backup_leaf);
    if (sel probe_r.err) { ret err[outcome.Fail].err{probe_r.err}; }
    val probe: InitEntry = probe_r.ok;
    if (probe.present) { ret rename_entry(cap, backup_leaf, final_leaf); }
    if (!had_identity_before) { ret unlink_entry(cap, final_leaf); }
    ret err[outcome.Fail].ok{};
}

fun resolve_commit_cleanup(cap: *InitDirectory, backup_leaf: str) err[outcome.Fail] {
    ret unlink_entry(cap, backup_leaf);
}

fun finish_committed_cleanup(root_cap: *InitDirectory,
                            src_cap: *InitDirectory, entry_backup: str) err[outcome.Fail] {
    var failure: err[outcome.Fail] = resolve_commit_cleanup(root_cap, BACKUP_MANIFEST);
    if (sel failure.ok && entry_backup != nil) { failure = resolve_commit_cleanup(src_cap, entry_backup); }
    val failure_ok: bool = sel failure.ok;
    if (failure_ok) { failure = directory_close(src_cap); }
    val failure_ok2: bool = sel failure.ok;
    if (failure_ok2) { failure = unlink_entry(root_cap, JOURNAL_LEAF); }
    ret failure;
}

val OUTPUT_ORIGINAL: i32 = 0;
val OUTPUT_DONE:     i32 = 1;
val OUTPUT_ANOMALY:  i32 = -1;

fun classify_output(current: InitEntry, had_identity: bool,
                    prior: txn.Identity, new_id: txn.Identity) i32 {
    if (!current.present) { ret OUTPUT_ORIGINAL; }
    if (!current.is_regular) { ret OUTPUT_ANOMALY; }
    if (txn.identity_equal(current.identity, new_id)) { ret OUTPUT_DONE; }
    if (had_identity && txn.identity_equal(current.identity, prior)) { ret OUTPUT_ORIGINAL; }
    ret OUTPUT_ANOMALY;
}

fun recovery_backup(cap: *InitDirectory, leaf: str, had_prior: bool,
                    prior: txn.Identity) res[bool, outcome.Fail] {
    val observed: res[InitEntry, outcome.Fail] = probe_entry(cap, leaf);
    if (sel observed.err) { ret res[bool, outcome.Fail].err{observed.err}; }
    val backup: InitEntry = observed.ok;
    if (!backup.present) { ret res[bool, outcome.Fail].ok{false}; }
    if (!had_prior || !backup.is_regular || !txn.identity_equal(backup.identity, prior)) {
        ret res[bool, outcome.Fail].err{outcome.user("init backup is not the recorded original file")};
    }
    ret res[bool, outcome.Fail].ok{true};
}

fun recover_existing_in(a: *A.Allocator, root_cap: *InitDirectory, src_cap: *InitDirectory) res[i32, outcome.Fail] {
    val jr: res[opt[InitJournal], outcome.Fail] = journal_read(root_cap);
    if (sel jr.err) { ret res[i32, outcome.Fail].err{jr.err}; }
    val jo: opt[InitJournal] = jr.ok;
    if (sel jo.none) { ret res[i32, outcome.Fail].ok{RECOVER_CLEAN}; }
    val j: InitJournal = jo.some;
    val root_id_r: res[txn.Identity, outcome.Fail] = root_identity_of(root_cap);
    if (sel root_id_r.err) { ret res[i32, outcome.Fail].err{root_id_r.err}; }
    if (!txn.identity_equal(root_id_r.ok, j.root)) {
        ret res[i32, outcome.Fail].err{outcome.user("init journal does not match its destination root")};
    }
    val manifest_now_r: res[InitEntry, outcome.Fail] = probe_entry(root_cap, util.PROJECT_CONFIG_NAME);
    if (sel manifest_now_r.err) { ret res[i32, outcome.Fail].err{manifest_now_r.err}; }
    val manifest_now: InitEntry = manifest_now_r.ok;
    val manifest_class: i32 = classify_output(manifest_now, j.manifest_had_identity, j.manifest_prior, j.manifest_new);
    if (manifest_class == OUTPUT_ANOMALY) { ret res[i32, outcome.Fail].err{outcome.user("init journal: mach.toml is neither the original nor the staged replacement")}; }
    val manifest_backup: res[bool, outcome.Fail] = recovery_backup(root_cap, BACKUP_MANIFEST, j.manifest_had_identity, j.manifest_prior);
    if (sel manifest_backup.err) { ret res[i32, outcome.Fail].err{manifest_backup.err}; }
    if (!manifest_now.present && j.manifest_had_identity && !manifest_backup.ok) {
        ret res[i32, outcome.Fail].err{outcome.user("init journal: original mach.toml and its backup are missing")};
    }
    val src_now_r: res[InitEntry, outcome.Fail] = probe_entry(root_cap, "src");
    if (sel src_now_r.err) { ret res[i32, outcome.Fail].err{src_now_r.err}; }
    val src_now: InitEntry = src_now_r.ok;
    if (src_now.present && !src_now.is_directory) { ret res[i32, outcome.Fail].err{outcome.user("init journal: src is no longer a directory")}; }
    if (!src_now.present && j.entry_had_identity) { ret res[i32, outcome.Fail].err{outcome.user("init journal: src is missing for an original entry")}; }
    if (src_now.present && (!j.source_present || !txn.identity_equal(src_now.identity, j.source))) {
        ret res[i32, outcome.Fail].err{outcome.user("init journal: src is not the recorded source directory")};
    }
    val entry_leaf: str = if_str(j.entry_is_lib, "lib.mach", "root.mach");
    val entry_backup: str = entry_backup_leaf(j.entry_is_lib);
    var entry_class: i32 = OUTPUT_ORIGINAL;
    var entry_present: bool = false;
    if (j.src_dir_created && j.entry_had_identity) { ret res[i32, outcome.Fail].err{outcome.user("init journal records an original entry in a newly created source tree")}; }
    if (src_now.present) {
        if (j.src_dir_created) {
            val opened: err[txn.Error] = txn.root_open_child(?src_cap.root, ?root_cap.root, "src");
            if (sel opened.err) { ret res[i32, outcome.Fail].err{outcome.user(txn_msg(opened.err))}; }
        } or {
            val opened: err[outcome.Fail] = open_src_cap(src_cap, a, root_cap);
            if (sel opened.err) { ret res[i32, outcome.Fail].err{opened.err}; }
        }
        val held: res[txn.Identity, outcome.Fail] = root_identity_of(src_cap);
        if (sel held.err) { ret res[i32, outcome.Fail].err{held.err}; }
        if (!txn.identity_equal(held.ok, j.source)) {
            ret res[i32, outcome.Fail].err{outcome.user("init journal: src changed while opening its recovery root")};
        }
        val entry_now_r: res[InitEntry, outcome.Fail] = probe_entry(src_cap, entry_leaf);
        if (sel entry_now_r.err) { ret res[i32, outcome.Fail].err{entry_now_r.err}; }
        val entry_now: InitEntry = entry_now_r.ok;
        entry_present = entry_now.present;
        entry_class = classify_output(entry_now, j.entry_had_identity, j.entry_prior, j.entry_new);
        if (!j.src_dir_created) {
            val backup: res[bool, outcome.Fail] = recovery_backup(src_cap, entry_backup, j.entry_had_identity, j.entry_prior);
            if (sel backup.err) { ret res[i32, outcome.Fail].err{backup.err}; }
            if (!entry_now.present && j.entry_had_identity && !backup.ok) {
                ret res[i32, outcome.Fail].err{outcome.user("init journal: original entry file and its backup are missing")};
            }
        }
    }
    if (entry_class == OUTPUT_ANOMALY) { ret res[i32, outcome.Fail].err{outcome.user("init journal: the selected entry file is neither the original nor the staged replacement")}; }
    if (manifest_class == OUTPUT_DONE) {
        if (entry_class != OUTPUT_DONE) { ret res[i32, outcome.Fail].err{outcome.user("init journal: mach.toml committed but the entry file did not")}; }
        var backup: str = nil;
        if (!j.src_dir_created) { backup = entry_backup; }
        val cleanup: err[outcome.Fail] = finish_committed_cleanup(root_cap, src_cap, backup);
        if (sel cleanup.err) { ret res[i32, outcome.Fail].err{cleanup.err}; }
        ret res[i32, outcome.Fail].ok{RECOVER_COMPLETED};
    }
    var failure: err[outcome.Fail] = resolve_rollback(root_cap, util.PROJECT_CONFIG_NAME, BACKUP_MANIFEST, j.manifest_had_identity);
    if (sel failure.ok && src_now.present) {
        if (j.src_dir_created) {
            if (entry_present) {
                val removed: res[usize, txn.Error] = txn.root_remove_tree(destination(root_cap, "src"), entry_leaf);
                if (sel removed.err) { failure = err[outcome.Fail].err{outcome.user(txn_msg(removed.err))}; }
            }
        } or { failure = resolve_rollback(src_cap, entry_leaf, entry_backup, j.entry_had_identity); }
    }
    val failure_ok: bool = sel failure.ok;
    if (failure_ok) { failure = directory_close(src_cap); }
    if (sel failure.ok && j.src_dir_created) { failure = rmdir_entry(root_cap, "src"); }
    val failure_ok2: bool = sel failure.ok;
    if (failure_ok2) { failure = unlink_entry(root_cap, JOURNAL_LEAF); }
    if (sel failure.err) { ret res[i32, outcome.Fail].err{failure.err}; }
    ret res[i32, outcome.Fail].ok{RECOVER_ROLLED_BACK};
}

fun recover_existing(a: *A.Allocator, root_cap: *InitDirectory) res[i32, outcome.Fail] {
    var source: InitDirectory;
    val result: res[i32, outcome.Fail] = recover_existing_in(a, root_cap, ?source);
    val closed: err[outcome.Fail] = directory_close(?source);
    if (sel result.err) {
        if (sel closed.err) { print.eprintlnf("error: init recovery cleanup: {}", outcome.describe(closed.err)); }
        ret result;
    }
    if (sel closed.err) { ret res[i32, outcome.Fail].err{closed.err}; }
    ret result;
}

fun if_str(cond: bool, when_true: str, when_false: str) str {
    if (cond) { ret when_true; }
    ret when_false;
}

fun refuse_exists(label: *u8) {
    print.eprint("error: ");
    print.eprint(label);
    print.eprint(" already exists (use --force to overwrite)\n");
}

fun refuse_not_regular(label: *u8) {
    print.eprint("error: ");
    print.eprint(label);
    print.eprint(" exists and is not a regular file\n");
}

rec InitOperation {
    root: InitDirectory;
    source: InitDirectory;
    manifest: txn.Transaction;
    entry: txn.Transaction;
    manifest_live: bool;
    entry_live: bool;
}

fun operation_close(operation: *InitOperation) err[outcome.Fail] {
    var failure: err[outcome.Fail] = err[outcome.Fail].ok{};
    if (operation.entry_live) {
        val aborted: err[txn.Error] = txn.abort(?operation.entry);
        operation.entry_live = false;
        if (sel aborted.err) { failure = err[outcome.Fail].err{outcome.user(txn_msg(aborted.err))}; }
    }
    if (operation.manifest_live) {
        val aborted: err[txn.Error] = txn.abort(?operation.manifest);
        operation.manifest_live = false;
        if (sel aborted.err) {
            val failure_ok: bool = sel failure.ok;
            if (failure_ok) { failure = err[outcome.Fail].err{outcome.user(txn_msg(aborted.err))}; } }
    }
    val source_closed: err[outcome.Fail] = directory_close(?operation.source);
    val first_source_closed: bool = sel failure.ok;
    if (first_source_closed) { failure = source_closed; }
    val root_closed: err[outcome.Fail] = directory_close(?operation.root);
    val first_root_closed: bool = sel failure.ok;
    if (first_root_closed) { failure = root_closed; }
    ret failure;
}

fun run_existing_in(a: *A.Allocator, operation: *InitOperation, root: str, dir_rel: str,
                    id: *u8, is_lib: bool, entry_leaf: *u8, entry_label: *u8, force: bool) res[i32, outcome.Fail] {
    val cap: *InitDirectory = ?operation.root;
    val src: *InitDirectory = ?operation.source;
    val opened: err[outcome.Fail] = open_root(cap, a, root, dir_rel);
    if (sel opened.err) { ret res[i32, outcome.Fail].err{opened.err}; }
    val recovered: res[i32, outcome.Fail] = recover_existing(a, cap);
    if (sel recovered.err) { ret recovered; }
    val manifest_r: res[InitEntry, outcome.Fail] = probe_entry(cap, util.PROJECT_CONFIG_NAME);
    if (sel manifest_r.err) { ret res[i32, outcome.Fail].err{manifest_r.err}; }
    var manifest_probe: InitEntry = manifest_r.ok;
    if (manifest_probe.present && !manifest_probe.is_regular) { refuse_not_regular(util.PROJECT_CONFIG_NAME); ret res[i32, outcome.Fail].ok{1}; }
    if (manifest_probe.present && !force) { refuse_exists(util.PROJECT_CONFIG_NAME); ret res[i32, outcome.Fail].ok{1}; }
    val source_r: res[InitEntry, outcome.Fail] = probe_entry(cap, "src");
    if (sel source_r.err) { ret res[i32, outcome.Fail].err{source_r.err}; }
    val source_probe: InitEntry = source_r.ok;
    if (source_probe.present && !source_probe.is_directory) { ret res[i32, outcome.Fail].err{outcome.user("'src' exists and is not a directory")}; }
    var entry_probe: InitEntry;
    if (source_probe.present) {
        val source_opened: err[outcome.Fail] = open_src_cap(src, a, cap);
        if (sel source_opened.err) { ret res[i32, outcome.Fail].err{source_opened.err}; }
        val entry_r: res[InitEntry, outcome.Fail] = probe_entry(src, entry_leaf::str);
        if (sel entry_r.err) { ret res[i32, outcome.Fail].err{entry_r.err}; }
        entry_probe = entry_r.ok;
    }
    if (entry_probe.present && !entry_probe.is_regular) { refuse_not_regular(entry_label); ret res[i32, outcome.Fail].ok{1}; }
    if (entry_probe.present && !force) { refuse_exists(entry_label); ret res[i32, outcome.Fail].ok{1}; }
    val backup_r: res[InitEntry, outcome.Fail] = probe_entry(cap, BACKUP_MANIFEST);
    if (sel backup_r.err) { ret res[i32, outcome.Fail].err{backup_r.err}; }
    if (backup_r.ok.present) { ret res[i32, outcome.Fail].err{outcome.user("init manifest backup exists without a recovery journal")}; }
    if (source_probe.present) {
        val entry_backup_r: res[InitEntry, outcome.Fail] = probe_entry(src, entry_backup_leaf(is_lib));
        if (sel entry_backup_r.err) { ret res[i32, outcome.Fail].err{entry_backup_r.err}; }
        if (entry_backup_r.ok.present) { ret res[i32, outcome.Fail].err{outcome.user("init entry backup exists without a recovery journal")}; }
    }
    val text_r: res[str, outcome.Fail] = build_manifest_text(a, id, is_lib, target.host_arch_id());
    if (sel text_r.err) { ret res[i32, outcome.Fail].err{text_r.err}; }
    val text: str = text_r.ok;
    fin { str_free(a, text); }
    val manifest_prepared: err[outcome.Fail] = stage_owned(?operation.manifest, a, cap,
        util.PROJECT_CONFIG_NAME, text::*u8, str_len(text));
    if (sel manifest_prepared.err) { ret res[i32, outcome.Fail].err{manifest_prepared.err}; }
    operation.manifest_live = true;
    val source_text: str = source_template(is_lib)::str;
    var source_identity: txn.Identity;
    var entry_identity: txn.Identity;
    if (source_probe.present) {
        val entry_prepared: err[outcome.Fail] = stage_owned(?operation.entry, a, src,
            entry_leaf::str, source_text::*u8, str_len(source_text));
        if (sel entry_prepared.err) { ret res[i32, outcome.Fail].err{entry_prepared.err}; }
        operation.entry_live = true;
        val source_id: res[txn.Identity, outcome.Fail] = root_identity_of(src);
        if (sel source_id.err) { ret res[i32, outcome.Fail].err{source_id.err}; }
        source_identity = source_id.ok;
        val entry_id: res[txn.Identity, outcome.Fail] = staged_identity_of(?operation.entry);
        if (sel entry_id.err) { ret res[i32, outcome.Fail].err{entry_id.err}; }
        entry_identity = entry_id.ok;
        var prior: txn.Identity;
        val had_prior: bool = txn.transaction_prior_identity(?operation.entry, ?prior);
        if (had_prior != entry_probe.present || (had_prior && !txn.identity_equal(prior, entry_probe.identity))) {
            ret res[i32, outcome.Fail].err{outcome.user("init entry changed after overwrite validation")};
        }
        entry_probe.identity = prior;
    } or {
        val prepared: err[outcome.Fail] = stage_source(?operation.entry, a, cap,
            entry_leaf::str, source_text::*u8, str_len(source_text));
        if (sel prepared.err) { ret res[i32, outcome.Fail].err{prepared.err}; }
        operation.entry_live = true;
        val source_id: res[txn.Identity, outcome.Fail] = staged_identity_of(?operation.entry);
        if (sel source_id.err) { ret res[i32, outcome.Fail].err{source_id.err}; }
        source_identity = source_id.ok;
        val entry_id: res[txn.Identity, txn.Error] = txn.transaction_staged_child_identity(?operation.entry, entry_leaf::str);
        if (sel entry_id.err) { ret res[i32, outcome.Fail].err{outcome.user(txn_msg(entry_id.err))}; }
        entry_identity = entry_id.ok;
    }
    var manifest_prior: txn.Identity;
    val manifest_had: bool = txn.transaction_prior_identity(?operation.manifest, ?manifest_prior);
    if (manifest_had != manifest_probe.present || (manifest_had && !txn.identity_equal(manifest_prior, manifest_probe.identity))) {
        ret res[i32, outcome.Fail].err{outcome.user("init manifest changed after overwrite validation")};
    }
    manifest_probe.identity = manifest_prior;
    val root_id: res[txn.Identity, outcome.Fail] = root_identity_of(cap);
    if (sel root_id.err) { ret res[i32, outcome.Fail].err{root_id.err}; }
    val manifest_new: res[txn.Identity, outcome.Fail] = staged_identity_of(?operation.manifest);
    if (sel manifest_new.err) { ret res[i32, outcome.Fail].err{manifest_new.err}; }
    val journal: err[outcome.Fail] = journal_create(a, cap, ?source_identity, root_id.ok,
        manifest_probe, manifest_new.ok, entry_probe,
        entry_identity, is_lib, !source_probe.present);
    if (sel journal.err) { ret res[i32, outcome.Fail].err{journal.err}; }
    if (source_probe.present) {
        val entry_committed: err[outcome.Fail] = commit_owned(a, src, ?operation.entry, ?operation.entry_live, entry_backup_leaf(is_lib));
        if (sel entry_committed.err) { ret res[i32, outcome.Fail].err{entry_committed.err}; }
    } or {
        val source_committed: res[txn.Outcome, txn.Error] = txn.commit(?operation.entry);
        operation.entry_live = false;
        if (sel source_committed.err) { ret res[i32, outcome.Fail].err{outcome.user(txn_msg(source_committed.err))}; }
    }
    val manifest_committed: err[outcome.Fail] = commit_owned(a, cap, ?operation.manifest, ?operation.manifest_live, BACKUP_MANIFEST);
    if (sel manifest_committed.err) { ret res[i32, outcome.Fail].err{manifest_committed.err}; }
    var backup: str = nil;
    if (source_probe.present) { backup = entry_backup_leaf(is_lib); }
    val cleanup: err[outcome.Fail] = finish_committed_cleanup(cap, src, backup);
    if (sel cleanup.err) { ret res[i32, outcome.Fail].err{cleanup.err}; }
    ret res[i32, outcome.Fail].ok{0};
}

fun run_existing_branch(a: *A.Allocator, root: str, dir_rel: str, id: *u8, is_lib: bool,
                        entry_leaf: *u8, entry_label: *u8, force: bool, quiet: bool) i64 {
    var operation: InitOperation;
    var result: res[i32, outcome.Fail] = run_existing_in(a, ?operation, root, dir_rel, id,
        is_lib, entry_leaf, entry_label, force);
    val closed: err[outcome.Fail] = operation_close(?operation);
    if (sel closed.err) {
        val result_ok: bool = sel result.ok;
        if (result_ok) { result = res[i32, outcome.Fail].err{closed.err}; }
        if (sel result.err) { print.eprint("error: "); print.eprint(outcome.describe(closed.err)); print.eprint("\n"); }
    }
    if (sel result.err) {
        print.eprint("error: "); print.eprint(outcome.describe(result.err));
        print.eprint(" (any init journal is retained for recovery on retry)\n");
        ret 2;
    }
    val code: i32 = result.ok;
    if (code == 0 && !quiet) { print.eprint("created project '"); print.eprint(id::str); print.eprint("'\n"); }
    ret code::i64;
}

fun build_manifest_text(alloc: *A.Allocator, id: *u8, is_lib: bool, arch_id: u32) res[str, outcome.Fail] {
    var storage: [4096]u8;
    var buf: Buf;
    buf.ptr = ?storage[0];
    buf.cap = 4096;
    buf.len = 0;
    buf.ok  = true;

    buf_put(?buf, "[project]\n");
    buf_put(?buf, "id = \"");
    buf_put(?buf, id);
    buf_put(?buf, "\"\n");
    buf_put(?buf, "version = \"0.1.0\"\n");
    buf_put(?buf, "src = \"src\"\n");
    buf_put(?buf, "out = \"out/{target.name}/{profile.name}\"\n");
    buf_put(?buf, "\n");

    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(?reg);
    if (sel setup_registry_r.err) { ret res[str, outcome.Fail].err{outcome.user("failed to register targets")}; }
    emit_targets(?buf, ?reg, arch_id);
    emit_artifacts(?buf, ?reg, arch_id, id, is_lib);
    if (!is_lib && !str_empty(scaffold_abi(?reg, "windows", arch_id))) {
        buf_put(?buf, "[link.kernel32]\nsource = \"system\"\nname = \"kernel32.dll\"\nos = [\"windows\"]\nisa = [\"*\"]\nabi = [\"*\"]\nexport = false\n\n");
    }

    buf_put(?buf, "[profile.debug]\n");
    buf_put(?buf, "default = true\n");
    buf_put(?buf, "opt = 0\n");
    buf_put(?buf, "debug = true\n");
    buf_put(?buf, "simd = \"scalarize\"\n");
    buf_put(?buf, "vectorize = false\n");
    buf_put(?buf, "float_reassoc = false\n");
    buf_put(?buf, "\n");
    buf_put(?buf, "[profile.release]\n");
    buf_put(?buf, "opt = 2\n");
    buf_put(?buf, "debug = false\n");
    buf_put(?buf, "simd = \"scalarize\"\n");
    buf_put(?buf, "vectorize = true\n");
    buf_put(?buf, "float_reassoc = false\n");
    buf_put(?buf, "\n");

    var di: usize = 0;
    for (di < SCAFFOLD_DEP_COUNT) {
        val dep: ScaffoldDep = SCAFFOLD_DEPS[di];
        buf_put(?buf, "[dep.");
        buf_put(?buf, dep.id::*u8);
        buf_put(?buf, "]\n");
        buf_put(?buf, "git = \"");
        buf_put(?buf, dep.git::*u8);
        buf_put(?buf, "\"\n");
        buf_put(?buf, "ref = \"");
        buf_put(?buf, dep.ref::*u8);
        buf_put(?buf, "\"\n");
        di = di + 1;
    }

    if (!buf.ok) { ret res[str, outcome.Fail].err{outcome.user("mach.toml scaffold exceeds the scratch buffer")}; }
    val str_copy_slice_r: res[str, string.StrError] = str_copy_slice(alloc, buf.ptr::str, 0, buf.len);
    if (sel str_copy_slice_r.err) { ret res[str, outcome.Fail].err{outcome.user(outcome.str_text(str_copy_slice_r.err))}; }
    ret res[str, outcome.Fail].ok{str_copy_slice_r.ok};
}

fun emit_artifacts(b: *Buf, reg: *target.TargetRegistry, arch_id: u32,
                   id: *u8, is_lib: bool) {
    buf_put(b, "[artifact.");
    buf_put(b, id);
    if (is_lib) {
        buf_put(b, "]\nkind = \"static\"\nentry = \"lib.mach\"\nout = \"lib/lib");
    } or {
        buf_put(b, "]\nkind = \"bin\"\nentry = \"root.mach\"\nout = \"bin/");
    }
    buf_put(b, id);
    buf_put(b, "{artifact.suffix}\"\ntargets = [\"*\"]\n");
    if (!is_lib && !str_empty(scaffold_abi(reg, "windows", arch_id))) {
        buf_put(b, "link = [\"kernel32\"]\n");
    } or { buf_put(b, "link = []\n"); }
    buf_put(b, "need = []\n");
    # a library's public entry is only ever an explicitly defaulted artifact
    if (is_lib) { buf_put(b, "default = true\n"); }
    buf_put(b, "\n");
}

val BIN_SOURCE_TEMPLATE: str = "use std.runtime;\nuse print: std.print;\n\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i64 {\n    print.println(\"Hello, World!\");\n    ret 0;\n}\n";

fun source_template(is_lib: bool) *u8 {
    if (is_lib) { ret ""; }
    ret BIN_SOURCE_TEMPLATE::*u8;
}

fun buf_put(b: *Buf, s: *u8) {
    if (!b.ok) { ret; }
    val n: usize = str_len(s);
    if (b.len + n > b.cap) {
        b.ok = false;
        ret;
    }
    var i: usize = 0;
    for (i < n) {
        b.ptr[b.len + i] = s[i];
        i = i + 1;
    }
    b.len = b.len + n;
}

fun default_project_id(a: *A.Allocator, cwd: str, dir: str) res[str, outcome.Fail] {
    val abs_r: res[str, A.Error] = path.resolve(a, cwd, dir);
    if (sel abs_r.err) { ret res[str, outcome.Fail].err{outcome.refused(abs_r.err)}; }
    val clean_r: res[str, A.Error] = path.clean(a, abs_r.ok);
    if (sel clean_r.err) { ret res[str, outcome.Fail].err{outcome.refused(clean_r.err)}; }
    ret res[str, outcome.Fail].ok{path.filename(clean_r.ok)};
}

fun emit_targets(b: *Buf, reg: *target.TargetRegistry, arch_id: u32) {
    emit_target(b, reg, "linux",   arch_id);
    emit_target(b, reg, "windows", arch_id);
    emit_target(b, reg, "darwin",  arch_id);
}

fun emit_target(b: *Buf, reg: *target.TargetRegistry, os_name: *u8, arch_id: u32) {
    val abi_name: str = scaffold_abi(reg, os_name::str, arch_id);
    if (str_empty(abi_name)) { ret; }
    val isa_name: str = isa.arch_name_for(arch_id);
    buf_put(b, "[target.");
    buf_put(b, os_name);
    buf_put(b, "-");
    buf_put(b, isa_name::*u8);
    buf_put(b, "]\n");
    buf_put(b, "isa = \"");
    buf_put(b, isa_name::*u8);
    buf_put(b, "\"\n");
    buf_put(b, "os  = \"");
    buf_put(b, os_name);
    buf_put(b, "\"\n");
    buf_put(b, "abi = \"");
    buf_put(b, abi_name::*u8);
    buf_put(b, "\"\n");
    buf_put(b, "\n");
}

fun scaffold_abi(reg: *target.TargetRegistry, os_name: str, arch_id: u32) str {
    val os_opt: opt[*tos.OsVTable] = tos.lookup(?reg.os, os_name);
    if (sel os_opt.none) { ret ""; }
    val abi_name: str = tos.native_abi_for(os_opt.some, arch_id);
    if (str_empty(abi_name)) { ret ""; }
    val select_r: res[target.Target, fail.Fail] = target.select(reg, isa.arch_name_for(arch_id), os_name, abi_name);
    if (sel select_r.err) { ret ""; }
    ret abi_name;
}

test "mach.cli.cmd.init.emit_artifacts:one_identity_with_target_suffix" {
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(?reg);
    if (sel setup_registry_r.err) { ret 1; }

    var bin_storage: [1024]u8;
    var bin: Buf;
    bin.ptr = ?bin_storage[0]; bin.cap = 1024; bin.len = 0; bin.ok = true;
    emit_artifacts(?bin, ?reg, isa.ARCH_X86_64, "demo", false);
    if (!bin.ok || bin.len >= bin.cap) { ret 1; }
    bin.ptr[bin.len] = 0;
    val want_bin: str = "[artifact.demo]\nkind = \"bin\"\nentry = \"root.mach\"\nout = \"bin/demo{artifact.suffix}\"\ntargets = [\"*\"]\nlink = [\"kernel32\"]\nneed = []\n\n";
    if (!str_equals(bin.ptr::str, want_bin)) { ret 1; }

    var lib_storage: [512]u8;
    var lib: Buf;
    lib.ptr = ?lib_storage[0]; lib.cap = 512; lib.len = 0; lib.ok = true;
    emit_artifacts(?lib, ?reg, isa.ARCH_X86_64, "demo", true);
    if (!lib.ok || lib.len >= lib.cap) { ret 1; }
    lib.ptr[lib.len] = 0;
    val want_lib: str = "[artifact.demo]\nkind = \"static\"\nentry = \"lib.mach\"\nout = \"lib/libdemo{artifact.suffix}\"\ntargets = [\"*\"]\nlink = []\nneed = []\ndefault = true\n\n";
    if (!str_equals(lib.ptr::str, want_lib)) { ret 1; }
    ret 0;
}

fun t_manifest_from_text(a: *A.Allocator, itn: *intern.Interner, text: str) opt[manifest.Manifest] {
    val tr: res[toml.Table, toml.TomlError] = toml.parse(a, text);
    if (sel tr.err) { ret opt[manifest.Manifest].none{}; }
    var t: toml.Table = tr.ok;
    val mr: res[manifest.Manifest, outcome.Fail] = manifest.parse(a, itn, ?t, true);
    toml.dnit(a, ?t);
    if (sel mr.err) { ret opt[manifest.Manifest].none{}; }
    ret opt[manifest.Manifest].some{mr.ok};
}

fun t_scaffold_plan_units(a: *A.Allocator, id: *u8, is_lib: bool, arch_id: u32) i64 {
    val text_r: res[str, outcome.Fail] = build_manifest_text(a, id, is_lib, arch_id);
    if (sel text_r.err) { ret -1; }
    val text: str = text_r.ok;

    var itn: intern.Interner = intern.init(a);
    val opt_m: opt[manifest.Manifest] = t_manifest_from_text(a, ?itn, text);
    if (sel opt_m.none) { ret -1; }
    var m: manifest.Manifest = opt_m.some;

    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(?reg);
    if (sel setup_registry_r.err) { ret -1; }

    var rq: request.BuildRequest = request.defaults();
    rq.project_root = "/scaftest";
    rq.all_targets  = true;

    val pr: res[plan.BuildPlan, outcome.Fail] = plan.plan(a, ?itn, ?reg, ?m, rq);
    if (sel pr.err) { ret -1; }
    val bp: plan.BuildPlan = pr.ok;
    ret bp.units.len::i64;
}

test "mach.cli.cmd.init.build_manifest_text:bin_scaffold_parses_and_plans_for_every_host_arch" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }

    if (t_scaffold_plan_units(?alloc, "scaftest", false, isa.ARCH_X86_64)  != 3) { ret 1; }
    if (t_scaffold_plan_units(?alloc, "scaftest", false, isa.ARCH_AARCH64) != 2) { ret 1; }
    if (t_scaffold_plan_units(?alloc, "scaftest", false, isa.ARCH_RISCV64) != 1) { ret 1; }
    ret 0;
}

fun t_scaffold_profile_complete(itn: *intern.Interner, m: *manifest.Manifest, name: str, want_opt: manifest.MOpt,
                                want_debug: bool, want_vectorize: bool, want_default: bool) bool {
    var i: u32 = 0;
    for (i < m.profile_count) {
        val pf: *manifest.ProfileDef = ?m.profiles[i];
        val pn: opt[str] = intern.lookup(itn, pf.name);
        if (sel pn.some && str_equals(pn.some, name)) {
            ret pf.opt == want_opt && pf.debug == want_debug && pf.simd == manifest.SIMD_SCALARIZE
                && pf.vectorize == want_vectorize && !pf.float_reassoc && pf.is_default == want_default;
        }
        i = i + 1;
    }
    ret false;
}

test "mach.cli.cmd.init.build_manifest_text:scaffold_profiles_are_complete_and_one_is_default" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var forms: [2]bool; forms[0] = false; forms[1] = true;
    var fi: usize = 0;
    for (fi < 2) {
        val text_r: res[str, outcome.Fail] = build_manifest_text(?alloc, "scaftest", forms[fi], isa.ARCH_X86_64);
        if (sel text_r.err) { ret 2; }
        var itn: intern.Interner = intern.init(?alloc);
        val opt_m: opt[manifest.Manifest] = t_manifest_from_text(?alloc, ?itn, text_r.ok);
        if (sel opt_m.none) { ret 3; }
        var m: manifest.Manifest = opt_m.some;
        if (m.profile_count != 2) { ret 4; }
        if (!t_scaffold_profile_complete(?itn, ?m, "debug", manifest.MOPT_DEBUG, true, false, true)) { ret 5; }
        if (!t_scaffold_profile_complete(?itn, ?m, "release", manifest.MOPT_RELEASE, false, true, false)) { ret 6; }
        val omitted: res[manifest.ResolvedProfile, outcome.Fail] = manifest.resolve_profile(?alloc, ?itn, ?m, "");
        if (sel omitted.err) { ret 7; }
        val rp: manifest.ResolvedProfile = omitted.ok;
        val rn: opt[str] = intern.lookup(?itn, rp.name);
        if (sel rn.none) { ret 8; }
        if (!str_equals(rn.some, "debug")) { ret 8; }
        fi = fi + 1;
    }
    ret 0;
}

test "mach.cli.cmd.init.build_manifest_text:bin_scaffold_names_one_artifact_with_the_target_suffix" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val text_r: res[str, outcome.Fail] = build_manifest_text(?alloc, "scaftest", false, isa.ARCH_X86_64);
    if (sel text_r.err) { ret 2; }
    var itn: intern.Interner = intern.init(?alloc);
    val opt_m: opt[manifest.Manifest] = t_manifest_from_text(?alloc, ?itn, text_r.ok);
    if (sel opt_m.none) { ret 3; }
    var m: manifest.Manifest = opt_m.some;
    if (m.artifact_count != 1) { ret 4; }

    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(?reg);
    if (sel setup_registry_r.err) { ret 5; }
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = "/scaftest";
    rq.all_targets  = true;
    val pr: res[plan.BuildPlan, outcome.Fail] = plan.plan(?alloc, ?itn, ?reg, ?m, rq);
    if (sel pr.err) { ret 6; }
    val bp: plan.BuildPlan = pr.ok;
    if (bp.units.len != 3) { ret 7; }
    var seen_exe: u32 = 0;
    var i: usize = 0;
    for (i < bp.units.len) {
        val u: *plan.BuildUnit = ?bp.units.data[i];
        if (!str_equals(u.sel_artifact, "scaftest")) { ret 8; }
        val windows: bool = str_contains(u.out_path, "/windows-x86_64/");
        val exe: bool = str_ends_with(u.out_path, "/bin/scaftest.exe");
        if (windows != exe) { ret 9; }
        if (!exe && !str_ends_with(u.out_path, "/bin/scaftest")) { ret 10; }
        if (exe) { seen_exe = seen_exe + 1; }
        i = i + 1;
    }
    if (seen_exe != 1) { ret 11; }
    ret 0;
}

test "mach.cli.cmd.init.build_manifest_text:lib_scaffold_parses_and_plans_for_every_host_arch" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }

    if (t_scaffold_plan_units(?alloc, "scaftest", true, isa.ARCH_X86_64)  != 3) { ret 1; }
    if (t_scaffold_plan_units(?alloc, "scaftest", true, isa.ARCH_AARCH64) != 2) { ret 1; }
    if (t_scaffold_plan_units(?alloc, "scaftest", true, isa.ARCH_RISCV64) != 1) { ret 1; }
    ret 0;
}

test "mach.cli.cmd.init.source_template:lib_is_empty_bin_declares_std_runtime" {
    if (!str_empty(source_template(true)::str)) { ret 1; }

    val bin: str = source_template(false)::str;
    if (str_empty(bin)) { ret 1; }
    if (!str_contains(bin, "std.runtime")) { ret 1; }
    if (str_contains(bin, "_start")) { ret 1; }
    if (str_contains(bin, "mainCRTStartup")) { ret 1; }
    if (str_contains(bin, "ExitProcess")) { ret 1; }
    if (str_contains(bin, "asm ")) { ret 1; }
    ret 0;
}

test "mach.cli.cmd.init.build_manifest_text:declares_dep_std" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }

    val text_r: res[str, outcome.Fail] = build_manifest_text(?alloc, "scaftest", false, isa.ARCH_X86_64);
    if (sel text_r.err) { ret 1; }
    val text: str = text_r.ok;
    if (!str_contains(text, "[dep.std]")) { ret 1; }

    var itn: intern.Interner = intern.init(?alloc);
    val opt_m: opt[manifest.Manifest] = t_manifest_from_text(?alloc, ?itn, text);
    if (sel opt_m.none) { ret 1; }
    val m: manifest.Manifest = opt_m.some;

    if (m.dep_count != 1) { ret 1; }
    val name_opt: opt[str] = intern.lookup(?itn, m.deps[0].name);
    if (sel name_opt.none) { ret 1; }
    if (!str_equals(name_opt.some, "std")) { ret 1; }
    val git_opt: opt[str] = intern.lookup(?itn, m.deps[0].git);
    if (sel git_opt.none) { ret 1; }
    if (!str_equals(git_opt.some, "https://github.com/briar-systems/mach-std")) { ret 1; }
    val ref_opt: opt[str] = intern.lookup(?itn, m.deps[0].ref);
    if (sel ref_opt.none) { ret 1; }
    if (!str_equals(ref_opt.some, "branch/main")) { ret 1; }
    ret 0;
}

fun t_source_parses(alloc: *A.Allocator, text: str) bool {
    val sr: res[session.Session, fail.Fail] = session.init(alloc);
    if (sel sr.err) { ret false; }
    var s: session.Session = sr.ok;
    var es: editor.EditorSession = editor.init(?s);

    val open_r: res[source.FileId, fail.Fail] = editor.open(?es, "/mach-init-standalone-parse-check/entry.mach", text);
    if (sel open_r.err) { editor.dnit(?es); session.dnit(?s); ret false; }
    val fid: source.FileId = open_r.ok;

    var req: editor.AnalysisRequest = editor.analysis_request(fid, editor.PHASE_PARSE);
    val analyzed: res[editor.AnalysisResult, outcome.Fail] = editor.analyze(?es, ?req);
    var ok: bool = false;
    if (sel analyzed.ok) {
        var result: editor.AnalysisResult = analyzed.ok;
        ok = sel result.status.kind.accepted && !diagnostic.has_errors(result.diagnostics);
        editor.analysis_dnit(?result);
    }
    if (sel analyzed.err) {
        var failure: outcome.Fail = analyzed.err;
        editor.fail_dnit(?es, ?failure);
    }

    val dnit_r2: err[fail.Fail] = editor.dnit(?es);
    session.dnit(?s);
    ret ok;
}

fun t_entry_parses(alloc: *A.Allocator, dest: str, entry_rel: str) bool {
    val p_r: res[str, A.Error] = path.join(alloc, dest, entry_rel);
    if (sel p_r.err) { ret false; }
    val p: str = p_r.ok;
    val text_opt: opt[str] = t_read_file(alloc, p);
    str_free(alloc, p);
    if (sel text_opt.none) { ret false; }
    ret t_source_parses(alloc, text_opt.some);
}

