# the project directory holds the manifest and the source tree and nothing else
#[testing]
fun t_scaffold_leaves_only_sources(existing: bool) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val root_r: res[str, fail.Fail] = t_scratch_dir(?alloc, "mach_init_control_home");
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    fin {
        fs.remove_all(?alloc, root);
        str_free(?alloc, root);
    }
    var dest: str = root;
    if (!existing) {
        val nested: res[str, A.Error] = types_path.join(?alloc, root, "fresh");
        if (sel nested.err) { ret 2; }
        dest = nested.ok;
    }
    var argv: [6]*u8;
    argv[0] = "mach";
    argv[1] = "init";
    argv[2] = dest::*u8;
    argv[3] = "--name";
    argv[4] = "homedproj"::*u8;
    argv[5] = "--no-deps"::*u8;
    if (t_init(6, ?argv[0]) != 0) { ret 3; }
    val src_r: res[str, A.Error] = types_path.join(?alloc, dest, "src/main.mach");
    if (sel src_r.err) { ret 4; }
    val exists_r: res[bool, io_error.Error] = fs.exists(src_r.ok);
    if (!(sel exists_r.ok && exists_r.ok)) { ret 5; }
    # the scaffold is the manifest and the source tree, nothing else
    val names: [4]str = [4]str{"out", "mach.toml.tmp", "src/main.mach.tmp", ".mach-txn-lock"};
    var i:     usize  = 0;
    for (i < 4) {
        val stray: res[bool, io_error.Error] = fs.exists(sfmt_join(?alloc, dest, names[i]));
        if (sel stray.ok && stray.ok) { ret 6; }
        i = i + 1;
    }
    ret 0;
}

test run__an_existing_or_absent_destination_receives_only_the_scaffold {
    val existing: i32 = t_scaffold_leaves_only_sources(true);
    if (existing != 0) { ret existing; }
    ret t_scaffold_leaves_only_sources(false);
}

test run__refuses_an_owned_output_without_force_and_leaves_it_byte_identical {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val root_r: res[str, fail.Fail] = t_scratch_dir(?alloc, "mach_init_refuse");
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    var bad:  i32 = 0;

    val toml_r: res[str, A.Error] = types_path.join(?alloc, root, "mach.toml");
    if (sel toml_r.err) { ret 99; }
    val toml:          str             = toml_r.ok;
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(toml, "mine"::*u8, 4::usize, 0o644);
    if (sel write_bytes_r.err) { bad = 1; }

    var argv: [5]*u8;
    argv[0] = "mach";
    argv[1] = "init";
    argv[2] = root::*u8;
    argv[3] = "--name";
    argv[4] = "refused"::*u8;

    val rc: i64 = t_init(5, ?argv[0]);
    if (rc != 1) { bad = 1; }
    val kept: opt[str] = t_read_file(?alloc, toml);
    if (!(sel kept.some && str_equals(kept.some, "mine"))) { bad = 1; }
    val src_r: res[str, A.Error] = types_path.join(?alloc, root, "src");
    if (sel src_r.err) { ret 99; }
    val exists_r: res[bool, io_error.Error] = fs.exists(src_r.ok);
    if (sel exists_r.err)                 { ret 99; }
    if ((sel exists_r.ok && exists_r.ok)) { bad = 1; }

    fs.remove_all(?alloc, root);
    str_free(?alloc, root);
    ret bad;
}

test run__force_replaces_owned_outputs_and_leaves_an_unowned_neighbor_byte_identical {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val root_r: res[str, fail.Fail] = t_scratch_dir(?alloc, "mach_init_force");
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    var bad:  i32 = 0;

    val toml_r: res[str, A.Error] = types_path.join(?alloc, root, "mach.toml");
    if (sel toml_r.err) { ret 99; }
    val toml:          str             = toml_r.ok;
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(toml, "stale"::*u8, 5::usize, 0o644);
    if (sel write_bytes_r.err) { bad = 1; }
    val src_dir_r: res[str, A.Error] = types_path.join(?alloc, root, "src");
    if (sel src_dir_r.err) { ret 99; }
    val create_dir_r: err[io_error.Error] = fs.create_dir(src_dir_r.ok, 0o755);
    if (sel create_dir_r.err) { bad = 1; }
    val entry_r: res[str, A.Error] = types_path.join(?alloc, root, "src/main.mach");
    if (sel entry_r.err) { ret 99; }
    val entry:          str             = entry_r.ok;
    val write_bytes_r2: err[fs.FsError] = fs.write_bytes(entry, "stale-source"::*u8, 12::usize, 0o644);
    if (sel write_bytes_r2.err) { bad = 1; }
    val neighbor_r: res[str, A.Error] = types_path.join(?alloc, root, "src/mine.mach");
    if (sel neighbor_r.err) { ret 99; }
    val neighbor:       str             = neighbor_r.ok;
    val write_bytes_r3: err[fs.FsError] = fs.write_bytes(neighbor, "user-owned"::*u8, 10::usize, 0o644);
    if (sel write_bytes_r3.err) { bad = 1; }
    val readme_r: res[str, A.Error] = types_path.join(?alloc, root, "README.md");
    if (sel readme_r.err) { ret 99; }
    val readme:         str             = readme_r.ok;
    val write_bytes_r4: err[fs.FsError] = fs.write_bytes(readme, "hello"::*u8, 5::usize, 0o644);
    if (sel write_bytes_r4.err) { bad = 1; }

    var argv: [7]*u8;
    argv[0] = "mach";
    argv[1] = "init";
    argv[2] = root::*u8;
    argv[3] = "--name";
    argv[4] = "forced"::*u8;
    argv[5] = "--force"::*u8;
    argv[6] = "--no-deps"::*u8;

    val rc: i64 = t_init(7, ?argv[0]);
    if (rc != 0) { bad = 1; }

    val new_toml: opt[str] = t_read_file(?alloc, toml);
    if (!(sel new_toml.some && !(str_equals(new_toml.some, "stale")))) { bad = 1; }
    val new_entry: opt[str] = t_read_file(?alloc, entry);
    if (!(sel new_entry.some && !(str_equals(new_entry.some, "stale-source")))) { bad = 1; }
    val kept_neighbor: opt[str] = t_read_file(?alloc, neighbor);
    if (!(sel kept_neighbor.some && str_equals(kept_neighbor.some, "user-owned"))) { bad = 1; }
    val kept_readme: opt[str] = t_read_file(?alloc, readme);
    if (!(sel kept_readme.some && str_equals(kept_readme.some, "hello"))) { bad = 1; }

    val exists_r: res[bool, io_error.Error] = fs.exists(sfmt_join(?alloc, root, "mach.toml.tmp"));
    if (sel exists_r.err)                 { ret 99; }
    if ((sel exists_r.ok && exists_r.ok)) { bad = 1; }

    fs.remove_all(?alloc, root);
    str_free(?alloc, root);
    ret bad;
}

#[testing]
fun sfmt_join(alloc: *A.Allocator, root: str, leaf: str) str {
    val r: res[str, A.Error] = types_path.join(alloc, root, leaf);
    if (sel r.err) { ret ""; }
    ret r.ok;
}

test run__refuses_a_non_regular_owned_output {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val root_r: res[str, fail.Fail] = t_scratch_dir(?alloc, "mach_init_nonregular");
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    var bad:  i32 = 0;

    val toml_r: res[str, A.Error] = types_path.join(?alloc, root, "mach.toml");
    if (sel toml_r.err) { ret 99; }
    val create_dir_r: err[io_error.Error] = fs.create_dir(toml_r.ok, 0o755);
    if (sel create_dir_r.err) { bad = 1; }

    var argv: [6]*u8;
    argv[0] = "mach";
    argv[1] = "init";
    argv[2] = root::*u8;
    argv[3] = "--name";
    argv[4] = "x"::*u8;
    argv[5] = "--force"::*u8;

    val rc: i64 = t_init(6, ?argv[0]);
    if (rc == 0) { bad = 1; }
    val exists_r: res[bool, io_error.Error] = fs.exists(toml_r.ok);
    if (sel exists_r.err)                  { ret 99; }
    if (!(sel exists_r.ok && exists_r.ok)) { bad = 1; }

    fs.remove_all(?alloc, root);
    str_free(?alloc, root);
    ret bad;
}

test run__absolute_ancestor_aliases_preserve_final_destination_refusal {
    var backing: A.Allocator;
    val make_r:  err[A.Error] = page.make(?backing);
    if (sel make_r.err) { ret 1; }
    var ar:     arena.Arena;
    val init_r: err[A.Error] = arena.init(?ar, ?backing, 0);
    if (sel init_r.err) { ret 2; }
    fin { arena.dnit(?ar); }
    var alloc:   A.Allocator;
    val make_r2: err[A.Error] = arena.make(?alloc, ?ar);
    if (sel make_r2.err) { ret 3; }
    val root_r: res[str, fail.Fail] = t_scratch_dir(?alloc, "mach_init_native_anchor");
    if (sel root_r.err) { ret 4; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?alloc, root); }
    val physical:     str                 = sfmt_join(?alloc, root, "physical");
    val alias:        str                 = sfmt_join(?alloc, root, "alias");
    val create_dir_r: err[io_error.Error] = fs.create_dir(physical, DIR_MODE);
    if (sel create_dir_r.err) { ret 5; }
    val symlink_r: err[io_error.Error] = fs.symlink(physical, alias);
    if (sel symlink_r.err) { ret 6; }
    var argv: [6]*u8 = [6]*u8{"mach", "init", nil, "--name", "anchor_project", "--no-deps"};
    argv[2] = sfmt_join(?alloc, alias, "nested/project");
    if (t_init(6, ?argv[0]) != 0) { ret 7; }
    val exists_r:  res[bool, io_error.Error] = fs.exists(sfmt_join(?alloc, physical, "nested/project/mach.toml"));
    val exists_r2: res[bool, io_error.Error] = fs.exists(sfmt_join(?alloc, physical, "nested/project/src/main.mach"));
    if (!(sel exists_r.ok && exists_r.ok))   { ret 8; }
    if (!(sel exists_r2.ok && exists_r2.ok)) { ret 8; }
    val existing:      str                 = sfmt_join(?alloc, physical, "existing");
    val create_dir_r2: err[io_error.Error] = fs.create_dir(existing, DIR_MODE);
    if (sel create_dir_r2.err) { ret 9; }
    argv[2] = sfmt_join(?alloc, alias, "existing");
    if (t_init(6, ?argv[0]) != 0) { ret 10; }
    val exists_r3: res[bool, io_error.Error] = fs.exists(sfmt_join(?alloc, existing, "mach.toml"));
    if (sel exists_r3.err)                   { ret 99; }
    if (!(sel exists_r3.ok && exists_r3.ok)) { ret 11; }
    val neighbor:      str                 = sfmt_join(?alloc, root, "neighbor");
    val create_dir_r3: err[io_error.Error] = fs.create_dir(neighbor, DIR_MODE);
    if (sel create_dir_r3.err) { ret 12; }
    val marker:        str             = sfmt_join(?alloc, neighbor, "marker");
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(marker, "untouched"::*u8, 9, FILE_MODE);
    if (sel write_bytes_r.err) { ret 13; }
    val redirect:   str                 = sfmt_join(?alloc, physical, "redirect");
    val symlink_r2: err[io_error.Error] = fs.symlink(neighbor, redirect);
    if (sel symlink_r2.err) { ret 14; }
    argv[2] = sfmt_join(?alloc, alias, "redirect");
    if (t_init(6, ?argv[0]) == 0) { ret 15; }
    val exists_r4: res[bool, io_error.Error] = fs.exists(sfmt_join(?alloc, neighbor, "mach.toml"));
    if (sel exists_r4.err)                  { ret 99; }
    if ((sel exists_r4.ok && exists_r4.ok)) { ret 16; }
    val kept: opt[str] = t_read_file(?alloc, marker);
    if (sel kept.none)                       { ret 17; }
    if (!str_equals(kept.some, "untouched")) { ret 17; }
    ret 0;
}

#[testing]
fun t_init_git_boundary(no_git: bool, existing: bool) i32 {
    var backing: A.Allocator;
    val make_r:  err[A.Error] = page.make(?backing);
    if (sel make_r.err) { ret 1; }
    var ar:     arena.Arena;
    val init_r: err[A.Error] = arena.init(?ar, ?backing, 0);
    if (sel init_r.err) { ret 2; }
    fin { arena.dnit(?ar); }
    var a:       A.Allocator;
    val make_r2: err[A.Error] = arena.make(?a, ?ar);
    if (sel make_r2.err) { ret 3; }
    val root_r: res[str, fail.Fail] = t_scratch_dir(?a, "mach_init_git_boundary");
    if (sel root_r.err) { ret 4; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?a, root); }
    val git_path:      str = sfmt_join(?a, root, ".git");
    val head_path:     str = sfmt_join(?a, root, ".git/HEAD");
    val config_path:   str = sfmt_join(?a, root, ".git/config");
    var head_before:   str = "";
    var config_before: str = "";
    if (existing) {
        val created: res[session.Session, fail.Fail] = toolchain.session_init(?a);
        if (sel created.err) { ret 5; }
        var s: session.Session = created.ok;
        fin { session.dnit(?s); }
        val initialize_repository_r: err[fail.Fail] = git_gitlink.begin(?s, root);
        if (sel initialize_repository_r.err) { ret 6; }
        val head:   opt[str] = t_read_file(?a, head_path);
        val config: opt[str] = t_read_file(?a, config_path);
        if (sel head.none)   { ret 7; }
        if (sel config.none) { ret 7; }
        head_before   = head.some;
        config_before = config.some;
    }
    var argv: [7]*u8 = [7]*u8{"mach", "init", root::*u8, "--name", "git_boundary", "--no-deps", "--no-git"};
    var argc: usize  = 6;
    if (no_git)                      { argc = 7; }
    if (t_init(argc, ?argv[0]) != 0) { ret 8; }
    val exists_r:  res[bool, io_error.Error] = fs.exists(sfmt_join(?a, root, "mach.toml"));
    val exists_r2: res[bool, io_error.Error] = fs.exists(sfmt_join(?a, root, "src/main.mach"));
    if (!(sel exists_r.ok && exists_r.ok))   { ret 9; }
    if (!(sel exists_r2.ok && exists_r2.ok)) { ret 9; }
    val exists_r3: res[bool, io_error.Error] = fs.exists(git_path);
    if (sel exists_r3.err)                                           { ret 99; }
    if ((sel exists_r3.ok && exists_r3.ok) != (!no_git || existing)) { ret 10; }
    val exists_r4: res[bool, io_error.Error] = fs.exists(sfmt_join(?a, root, ".git/index"));
    val exists_r5: res[bool, io_error.Error] = fs.exists(sfmt_join(?a, root, ".gitmodules"));
    if ((sel exists_r4.ok && exists_r4.ok)) { ret 11; }
    if ((sel exists_r5.ok && exists_r5.ok)) { ret 11; }
    if (existing) {
        val head:   opt[str] = t_read_file(?a, head_path);
        val config: opt[str] = t_read_file(?a, config_path);
        if (sel head.none)                                                                  { ret 12; }
        if (sel config.none)                                                                { ret 12; }
        if (!str_equals(head_before, head.some) || !str_equals(config_before, config.some)) { ret 13; }
    }
    ret 0;
}

test git_boundary__no_git_scaffolds_without_registration {
    ret t_init_git_boundary(true, false);
}

test git_boundary__explicit_initialization_does_not_stage_files {
    ret t_init_git_boundary(false, false);
}

test git_boundary__existing_repository_head_and_config_are_unchanged {
    ret t_init_git_boundary(false, true);
}
