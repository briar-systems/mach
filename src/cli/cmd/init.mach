val DIR_MODE:  i32 = 493;
val FILE_MODE: i32 = 420;

rec Buf {
    ptr: *u8;
    cap: usize;
    len: usize;
    ok:  bool;
}

# `mach init`: scaffold a project. the positional names the directory (default the working
# directory) and, unless `--name` is given, the project id, which must be a portable
# identifier. an absent directory is created whole; an existing one is filled in, and
# `--force` allows overwriting mach.toml and the entry file. `--lib` writes src/lib.mach
# and a static artifact instead of src/root.mach and binary artifacts. the std dependency
# is then realized as a git submodule unless `--no-deps`; `--quiet` silences progress
# ---
# argv: the full process arguments
# inv: the parsed invocation for this command
# ret: 0 success, 1 an invalid id, a refused overwrite, or a failed publish, 2 allocator or
#  filesystem failure, 3 the std dependency could not be realized
pub fun run_typed(argv: **u8, inv: *args.ParsedInvocation) i64 {
    if (args.reject_unknown_from_invocation(inv, argv, "mach init")) { ret 1; }
    val parsed: args.InitInvocation = args.build_init_invocation(inv, argv);
    val force:   bool = parsed.force;
    val is_lib:  bool = parsed.is_lib;
    val no_deps: bool = parsed.no_deps;
    val quiet:   bool = parsed.quiet;

    var backing: A.Allocator;
    if (O.is_some[str](page.make(?backing))) {
        print.eprint("error: failed to initialise allocator\n");
        ret 2;
    }
    var ar: arena.Arena;
    if (O.is_some[str](arena.init(?ar, ?backing, 0))) {
        print.eprint("error: failed to initialise allocator\n");
        ret 2;
    }
    var a: A.Allocator;
    if (O.is_some[str](arena.make(?a, ?ar))) {
        arena.dnit(?ar);
        print.eprint("error: failed to initialise allocator\n");
        ret 2;
    }

    val cwd_r: R.Result[str, str] = env.current_dir(?a);
    if (R.is_err[str, str](cwd_r)) {
        print.eprint("error: failed to read the working directory\n");
        arena.dnit(?ar);
        ret 2;
    }
    val cwd: str = R.unwrap_ok[str, str](cwd_r);

    var dir: *u8 = cwd;
    if (parsed.has_dir) { dir = argv[parsed.dir_idx]; }

    val id_r: R.Result[str, str] = default_project_id(?a, cwd, dir::str);
    if (R.is_err[str, str](id_r)) {
        print.eprint("error: out of memory\n");
        arena.dnit(?ar);
        ret 2;
    }
    var id: *u8 = R.unwrap_ok[str, str](id_r);
    if (parsed.has_name) { id = argv[parsed.name_idx]; }

    if (!manifest.is_valid_id(id::str)) {
        print.eprint("error: '");
        print.eprint(id::str);
        print.eprint("' is not a valid project id\n");
        print.eprint("       a project id may contain only letters, digits, '_', or '-' (no '.', '/', or spaces)\n");
        print.eprint("       pass a valid name as the argument or with --name <name>\n");
        arena.dnit(?ar);
        ret 1;
    }

    var entry_leaf:  *u8 = "root.mach";
    var entry_label: *u8 = "src/root.mach";
    if (is_lib) {
        entry_leaf  = "lib.mach";
        entry_label = "src/lib.mach";
    }

    val split_r: R.Result[DestSplit, str] = split_for_discovery(?a, cwd, dir::str);
    if (R.is_err[DestSplit, str](split_r)) {
        print.eprint("error: out of memory\n");
        arena.dnit(?ar);
        ret 2;
    }
    val split: DestSplit = R.unwrap_ok[DestSplit, str](split_r);

    val disc_r: R.Result[O.Option[txn.Descent], txn.Error] =
        txn.descend(?a, split.root, split.dest_rel);
    if (R.is_err[O.Option[txn.Descent], txn.Error](disc_r)) {
        print.eprint("error: ");
        print.eprint(txn.error_message(R.unwrap_err[O.Option[txn.Descent], txn.Error](disc_r)));
        print.eprint("\n");
        arena.dnit(?ar);
        ret 1;
    }
    val disc: O.Option[txn.Descent] = R.unwrap_ok[O.Option[txn.Descent], txn.Error](disc_r);

    val dest_root_r: R.Result[str, str] = path.join(?a, split.root, split.dest_rel);
    if (R.is_err[str, str](dest_root_r)) {
        print.eprint("error: out of memory\n");
        arena.dnit(?ar);
        ret 2;
    }
    val dest_root: str = R.unwrap_ok[str, str](dest_root_r);

    if (O.is_some[txn.Descent](disc)) {
        var mp: txn.Descent = O.unwrap[txn.Descent](disc);
        val code: i64 = run_absent_branch(?a, ?mp, id, is_lib, entry_label, quiet);
        if (code == 0) {
            val dep_code: i64 = dependency_stage(?a, dest_root, no_deps, quiet);
            arena.dnit(?ar);
            ret dep_code;
        }
        arena.dnit(?ar);
        ret code;
    }

    val code: i64 = run_existing_branch(?a, split.root, split.dest_rel, id, is_lib, entry_leaf, entry_label, force, quiet);
    if (code == 0) {
        val dep_code: i64 = dependency_stage(?a, dest_root, no_deps, quiet);
        arena.dnit(?ar);
        ret dep_code;
    }
    arena.dnit(?ar);
    ret code;
}

fun t_init(argc: usize, argv: **u8) i64 {
    var a: A.Allocator;
    if (O.is_some[str](page.make(?a))) { ret 2; }
    val ir: R.Result[args.ParsedInvocation, str] = args.parse_invocation(?a, argc, argv);
    if (R.is_err[args.ParsedInvocation, str](ir)) { ret 2; }
    var inv: args.ParsedInvocation = R.unwrap_ok[args.ParsedInvocation, str](ir);
    ret run_typed(argv, ?inv);
}

rec ScaffoldDep {
    id:  str;
    git: str;
    ref: str;
}

val SCAFFOLD_DEP_COUNT: usize = 1;
val SCAFFOLD_DEPS: [1]ScaffoldDep = [1]ScaffoldDep{
    ScaffoldDep{ id: "std", git: "https://github.com/briar-systems/mach-std", ref: "branch/main" }
};

fun dependency_stage(a: *A.Allocator, root: str, no_deps: bool, quiet: bool) i64 {
    if (no_deps) {
        if (!quiet) {
            print.eprint("dependencies declared but not realized; run `mach dep pull` to realize them\n");
        }
        ret 0;
    }
    ret realize_declared_deps(a, root, quiet);
}

fun realize_declared_deps(a: *A.Allocator, root: str, quiet: bool) i64 {
    val sr: R.Result[session.Session, str] = session.init(a);
    if (R.is_err[session.Session, str](sr)) {
        val fail: outcome.Fail = outcome.internal("failed to initialize dependency realization");
        ret cli_diag.render_fail(?fail);
    }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    var i: usize = 0;
    for (i < SCAFFOLD_DEP_COUNT) {
        val dep: ScaffoldDep = SCAFFOLD_DEPS[i];
        val real_r: R.Result[R.Void, str] = ddep.realize_git_submodule(?s, root, dep.id, dep.git, dep.ref);
        if (R.is_err[R.Void, str](real_r)) {
            val msg_r: R.Result[str, str] = format.sprint(a,
                "dependency '{}' could not be realized: {}", dep.id, R.unwrap_err[R.Void, str](real_r));
            session.dnit(?s);
            if (R.is_err[str, str](msg_r)) {
                val fail: outcome.Fail = outcome.environment("a declared dependency could not be realized");
                ret cli_diag.render_fail(?fail);
            }
            val fail: outcome.Fail = outcome.environment(R.unwrap_ok[str, str](msg_r));
            ret cli_diag.render_fail(?fail);
        }
        if (!quiet) {
            print.eprint("realized dependency '");
            print.eprint(dep.id);
            print.eprint("'\n");
        }
        i = i + 1;
    }

    session.dnit(?s);
    ret 0;
}

rec DestSplit {
    root:     str;
    dest_rel: str;
}

fun split_for_discovery(alloc: *A.Allocator, cwd: str, dir: str) R.Result[DestSplit, str] {
    val cleaned_r: R.Result[str, str] = path.clean(alloc, dir);
    if (R.is_err[str, str](cleaned_r)) { ret R.err[DestSplit, str](R.unwrap_err[str, str](cleaned_r)); }
    val cleaned: str = R.unwrap_ok[str, str](cleaned_r);
    fin { str_free(alloc, cleaned); }

    var root_source: str = cwd;
    var root_len: usize = str_len(cwd);
    var relative_start: usize = 0;
    val cleaned_len: usize = str_len(cleaned);
    if (path.is_abs(cleaned)) {
        root_source = cleaned;
        root_len = path.root(cleaned).len;
        relative_start = root_len;
        for (relative_start < cleaned_len && path.is_separator(cleaned[relative_start])) {
            relative_start = relative_start + 1;
        }
    }
    or (str_equals(cleaned, ".")) { relative_start = cleaned_len; }

    val root_r: R.Result[str, str] = str_copy_slice(alloc, root_source, 0, root_len);
    if (R.is_err[str, str](root_r)) { ret R.err[DestSplit, str](R.unwrap_err[str, str](root_r)); }
    var ds: DestSplit;
    ds.root = R.unwrap_ok[str, str](root_r);
    val relative_r: R.Result[str, str] = str_copy_slice(alloc, cleaned, relative_start, cleaned_len - relative_start);
    if (R.is_err[str, str](relative_r)) {
        str_free(alloc, ds.root);
        ret R.err[DestSplit, str](R.unwrap_err[str, str](relative_r));
    }
    ds.dest_rel = R.unwrap_ok[str, str](relative_r);
    var i: usize = 0;
    for (ds.dest_rel[i] != 0) {
        if (path.is_separator(ds.dest_rel[i])) { ds.dest_rel[i] = '/'; }
        i = i + 1;
    }
    ret R.ok[DestSplit, str](ds);
}

# place an inventory path under the part of the destination that is missing
#
# the transaction publishes one component, so when the destination is several
# levels below the deepest existing directory, everything the scaffold contains
# has to be addressed relative to that one component rather than to the
# destination itself.
fun under_remainder(a: *A.Allocator, remainder: str, rel: str) R.Result[str, str] {
    if (str_empty(remainder)) { ret str_copy_slice(a, rel, 0, str_len(rel)); }
    ret format.sprint(a, "{}/{}", remainder, rel);
}

fun run_absent_branch(a: *A.Allocator, mp: *txn.Descent, id: *u8, is_lib: bool,
                      entry_label: *u8, quiet: bool) i64 {
    val text_r: R.Result[str, str] = build_manifest_text(a, id, is_lib, target.host_arch_id());
    if (R.is_err[str, str](text_r)) {
        print.eprint("error: failed to build mach.toml\n");
        txn.descent_dnit(a, mp);
        ret 2;
    }
    val text: str = R.unwrap_ok[str, str](text_r);

    val manifest_rel_r: R.Result[str, str] = under_remainder(a, mp.remainder, "mach.toml");
    if (R.is_err[str, str](manifest_rel_r)) {
        print.eprint("error: cannot plan mach.toml path\n");
        txn.descent_dnit(a, mp);
        ret 2;
    }
    val manifest_rel: str = R.unwrap_ok[str, str](manifest_rel_r);
    fin { str_free(a, manifest_rel); }
    val entry_rel_r: R.Result[str, str] = under_remainder(a, mp.remainder, entry_label::str);
    if (R.is_err[str, str](entry_rel_r)) {
        print.eprint("error: cannot plan source entry path\n");
        txn.descent_dnit(a, mp);
        ret 2;
    }
    val entry_rel: str = R.unwrap_ok[str, str](entry_rel_r);
    fin { str_free(a, entry_rel); }

    var inv: txn.Inventory = txn.inventory_init(a);
    val push1: O.Option[txn.Error] = txn.inventory_push(?inv,
        txn.entry_file(manifest_rel, text::*u8, str_len(text), FILE_MODE));
    if (O.is_some[txn.Error](push1)) {
        print.eprint("error: internal: cannot plan mach.toml\n");
        txn.inventory_dnit(?inv);
        txn.descent_dnit(a, mp);
        ret 2;
    }

    val src_text: str = source_template(is_lib)::str;
    val push2: O.Option[txn.Error] = txn.inventory_push(?inv,
        txn.entry_file(entry_rel, src_text::*u8, str_len(src_text), FILE_MODE));
    if (O.is_some[txn.Error](push2)) {
        print.eprint("error: internal: cannot plan ");
        print.eprint(entry_label);
        print.eprint("\n");
        txn.inventory_dnit(?inv);
        txn.descent_dnit(a, mp);
        ret 2;
    }

    # the whole missing chain is staged privately and appears with one rename,
    # so a reader never sees a scaffold that is half written
    val published: R.Result[R.Void, str] = publication.subtree(a, mp, ?inv, DIR_MODE);
    txn.inventory_dnit(?inv);
    txn.descent_dnit(a, mp);
    if (R.is_err[R.Void, str](published)) {
        print.eprint("error: ");
        print.eprint(R.unwrap_err[R.Void, str](published));
        print.eprint("\n");
        ret 1;
    }

    if (!quiet) {
        print.eprint("created project '");
        print.eprint(id::str);
        print.eprint("'\n");
    }
    ret 0;
}

val JOURNAL_LEAF:     str = ".machinit.journal";
val BACKUP_MANIFEST:  str = ".machinit.mach.toml.backup";
val BACKUP_ENTRY_BIN: str = ".machinit.root.mach.backup";
val BACKUP_ENTRY_LIB: str = ".machinit.lib.mach.backup";

val INIT_JOURNAL_MAGIC: u32 = 0x494e4954;

rec InitJournal {
    magic:                 u32;
    root_device:            u64;
    root_file:              u64;
    manifest_had_identity:  bool;
    manifest_prior_device:  u64;
    manifest_prior_file:    u64;
    manifest_new_device:    u64;
    manifest_new_file:      u64;
    entry_is_lib:           bool;
    entry_had_identity:     bool;
    entry_prior_device:     u64;
    entry_prior_file:       u64;
    entry_new_device:       u64;
    entry_new_file:         u64;
    src_dir_created:        bool;
}

val RECOVER_CLEAN:       i32 = 0;
val RECOVER_ROLLED_BACK: i32 = 1;
val RECOVER_COMPLETED:   i32 = 2;

fun entry_backup_leaf(is_lib: bool) str {
    if (is_lib) { ret BACKUP_ENTRY_LIB; }
    ret BACKUP_ENTRY_BIN;
}

# init reports failures as display strings, and the transaction layer reports a
# closed error kind. these adapters convert at that one boundary rather than
# threading two error types through every helper below.
fun txn_msg(e: txn.Error) str {
    ret txn.error_message(e);
}

fun open_root(root: str, rel: str) R.Result[txn.Root, str] {
    val r: R.Result[txn.Root, txn.Error] = txn.root_open(root, rel);
    if (R.is_err[txn.Root, txn.Error](r)) {
        ret R.err[txn.Root, str](txn_msg(R.unwrap_err[txn.Root, txn.Error](r)));
    }
    ret R.ok[txn.Root, str](R.unwrap_ok[txn.Root, txn.Error](r));
}

fun probe_entry(cap: *txn.Root, leaf: str) R.Result[txn.EntryProbe, str] {
    val r: R.Result[txn.EntryProbe, txn.Error] = txn.entry_probe(cap, leaf);
    if (R.is_err[txn.EntryProbe, txn.Error](r)) {
        ret R.err[txn.EntryProbe, str](txn_msg(R.unwrap_err[txn.EntryProbe, txn.Error](r)));
    }
    ret R.ok[txn.EntryProbe, str](R.unwrap_ok[txn.EntryProbe, txn.Error](r));
}

fun rename_entry(cap: *txn.Root, from: str, to: str) O.Option[str] {
    val e: O.Option[txn.Error] = txn.entry_rename(cap, from, to);
    if (O.is_none[txn.Error](e)) { ret O.none[str](); }
    ret O.some[str](txn_msg(O.unwrap[txn.Error](e)));
}

fun unlink_entry(cap: *txn.Root, leaf: str) O.Option[str] {
    val e: O.Option[txn.Error] = txn.entry_unlink(cap, leaf);
    if (O.is_none[txn.Error](e)) { ret O.none[str](); }
    ret O.some[str](txn_msg(O.unwrap[txn.Error](e)));
}

fun stage_absent(a: *A.Allocator, cap: *txn.Root, leaf: str,
                 data: *u8, len: usize) R.Result[txn.Transaction, str] {
    val r: R.Result[txn.Transaction, txn.Error] =
        txn.prepare_bytes(a, cap, leaf, data, len, FILE_MODE, false);
    if (R.is_err[txn.Transaction, txn.Error](r)) {
        ret R.err[txn.Transaction, str](txn_msg(R.unwrap_err[txn.Transaction, txn.Error](r)));
    }
    ret R.ok[txn.Transaction, str](R.unwrap_ok[txn.Transaction, txn.Error](r));
}

fun commit_absent(t: *txn.Transaction) O.Option[str] {
    val r: R.Result[txn.Outcome, txn.Error] =
        txn.commit(t, txn.PRE_ABSENT_AT_COMMIT, txn.durability_none());
    if (R.is_err[txn.Outcome, txn.Error](r)) {
        ret O.some[str](txn_msg(R.unwrap_err[txn.Outcome, txn.Error](r)));
    }
    ret O.none[str]();
}

fun rmdir_entry(cap: *txn.Root, leaf: str) O.Option[str] {
    val e: O.Option[txn.Error] = txn.entry_rmdir_if_empty(cap, leaf);
    if (O.is_none[txn.Error](e)) { ret O.none[str](); }
    ret O.some[str](txn_msg(O.unwrap[txn.Error](e)));
}

fun make_dir_entry(cap: *txn.Root, leaf: str, mode: i32) R.Result[bool, str] {
    val r: R.Result[bool, txn.Error] = txn.entry_make_dir(cap, leaf, mode);
    if (R.is_err[bool, txn.Error](r)) {
        ret R.err[bool, str](txn_msg(R.unwrap_err[bool, txn.Error](r)));
    }
    ret R.ok[bool, str](R.unwrap_ok[bool, txn.Error](r));
}

fun root_identity_of(cap: *txn.Root) R.Result[txn.Identity, str] {
    val r: R.Result[txn.Identity, txn.Error] = txn.root_identity(cap);
    if (R.is_err[txn.Identity, txn.Error](r)) {
        ret R.err[txn.Identity, str](txn_msg(R.unwrap_err[txn.Identity, txn.Error](r)));
    }
    ret R.ok[txn.Identity, str](R.unwrap_ok[txn.Identity, txn.Error](r));
}

fun staged_identity_of(t: *txn.Transaction) R.Result[txn.Identity, str] {
    val r: R.Result[txn.Identity, txn.Error] = txn.transaction_staged_identity(t);
    if (R.is_err[txn.Identity, txn.Error](r)) {
        ret R.err[txn.Identity, str](txn_msg(R.unwrap_err[txn.Identity, txn.Error](r)));
    }
    ret R.ok[txn.Identity, str](R.unwrap_ok[txn.Identity, txn.Error](r));
}

fun sweep_root(a: *A.Allocator, cap: *txn.Root) {
    txn.recover(a, cap, "");
}

fun src_dir_rel(a: *A.Allocator, dir_rel: str) R.Result[str, str] {
    if (str_empty(dir_rel)) { ret str_copy_slice(a, "src", 0, 3); }
    ret format.sprint(a, "{}/src", dir_rel);
}

fun open_src_cap(a: *A.Allocator, root: str, dir_rel: str) R.Result[txn.Root, str] {
    val rel_r: R.Result[str, str] = src_dir_rel(a, dir_rel);
    if (R.is_err[str, str](rel_r)) { ret R.err[txn.Root, str](R.unwrap_err[str, str](rel_r)); }
    ret open_root(root, R.unwrap_ok[str, str](rel_r));
}

fun journal_read(a: *A.Allocator, root_cap: *txn.Root) R.Result[O.Option[InitJournal], str] {
    var j: InitJournal;
    val jsize: usize = $size_of(InitJournal);
    val read_r: R.Result[O.Option[usize], txn.Error] =
        txn.entry_read_all(root_cap, JOURNAL_LEAF, (?j)::*u8, jsize);
    if (R.is_err[O.Option[usize], txn.Error](read_r)) {
        ret R.err[O.Option[InitJournal], str](txn_msg(R.unwrap_err[O.Option[usize], txn.Error](read_r)));
    }
    val got: O.Option[usize] = R.unwrap_ok[O.Option[usize], txn.Error](read_r);
    if (O.is_none[usize](got)) { ret R.ok[O.Option[InitJournal], str](O.none[InitJournal]()); }
    if (O.unwrap[usize](got) != jsize) { ret R.err[O.Option[InitJournal], str]("init journal has an unexpected size"); }
    if (j.magic != INIT_JOURNAL_MAGIC) {
        ret R.err[O.Option[InitJournal], str]("init journal has an invalid signature");
    }
    ret R.ok[O.Option[InitJournal], str](O.some[InitJournal](j));
}

fun journal_create(a: *A.Allocator, root_cap: *txn.Root, root_id: txn.Identity,
                   manifest_probe: txn.EntryProbe, manifest_new: txn.Identity,
                   entry_probe: txn.EntryProbe, entry_new: txn.Identity,
                   is_lib: bool, src_dir_created: bool) R.Result[R.Void, str] {
    var j: InitJournal;
    j.magic                 = INIT_JOURNAL_MAGIC;
    j.root_device             = root_id.device;
    j.root_file               = root_id.file;
    j.manifest_had_identity   = manifest_probe.present;
    j.manifest_prior_device   = manifest_probe.identity.device;
    j.manifest_prior_file     = manifest_probe.identity.file;
    j.manifest_new_device     = manifest_new.device;
    j.manifest_new_file       = manifest_new.file;
    j.entry_is_lib            = is_lib;
    j.entry_had_identity      = entry_probe.present;
    j.entry_prior_device      = entry_probe.identity.device;
    j.entry_prior_file        = entry_probe.identity.file;
    j.entry_new_device        = entry_new.device;
    j.entry_new_file          = entry_new.file;
    j.src_dir_created         = src_dir_created;

    ret publication.bytes_at(nil, a, root_cap, JOURNAL_LEAF, JOURNAL_LEAF, (?j)::*u8, $size_of(InitJournal),
                             FILE_MODE, publication.CREATE, "write", "the init journal could not be published", nil);
}

fun stage_owned(a: *A.Allocator, cap: *txn.Root, leaf: str,
                data: *u8, len: usize) R.Result[txn.Transaction, str] {
    ret stage_absent(a, cap, leaf, data, len);
}

fun commit_owned(a: *A.Allocator, cap: *txn.Root, pf: *txn.Transaction,
                 had_identity: bool, final_leaf: str, backup_leaf: str) O.Option[str] {
    if (had_identity) {
        val mv: O.Option[str] = rename_entry(cap, final_leaf, backup_leaf);
        if (O.is_some[str](mv)) {
            txn.abort(pf);
            ret mv;
        }
    }
    ret commit_absent(pf);
}

fun resolve_rollback(a: *A.Allocator, cap: *txn.Root,
                     final_leaf: str, backup_leaf: str, had_identity_before: bool) O.Option[str] {
    val probe_r: R.Result[txn.EntryProbe, str] = probe_entry(cap, backup_leaf);
    if (R.is_err[txn.EntryProbe, str](probe_r)) { ret O.some[str](R.unwrap_err[txn.EntryProbe, str](probe_r)); }
    val probe: txn.EntryProbe = R.unwrap_ok[txn.EntryProbe, str](probe_r);
    if (probe.present) { ret rename_entry(cap, backup_leaf, final_leaf); }
    if (!had_identity_before) { ret unlink_entry(cap, final_leaf); }
    ret O.none[str]();
}

fun resolve_commit_cleanup(a: *A.Allocator, cap: *txn.Root, backup_leaf: str) O.Option[str] {
    ret unlink_entry(cap, backup_leaf);
}

val OUTPUT_ORIGINAL: i32 = 0;
val OUTPUT_DONE:     i32 = 1;
val OUTPUT_ANOMALY:  i32 = -1;

fun classify_output(current: txn.EntryProbe, had_identity: bool,
                    prior: txn.Identity, new_id: txn.Identity) i32 {
    if (!current.present) { ret OUTPUT_ORIGINAL; }
    if (!current.is_regular) { ret OUTPUT_ANOMALY; }
    if (txn.identity_equal(current.identity, new_id)) { ret OUTPUT_DONE; }
    if (had_identity && txn.identity_equal(current.identity, prior)) { ret OUTPUT_ORIGINAL; }
    ret OUTPUT_ANOMALY;
}

fun recover_existing(a: *A.Allocator, root: str, dir_rel: str, root_cap: *txn.Root) R.Result[i32, str] {
    val jr: R.Result[O.Option[InitJournal], str] = journal_read(a, root_cap);
    if (R.is_err[O.Option[InitJournal], str](jr)) { ret R.err[i32, str](R.unwrap_err[O.Option[InitJournal], str](jr)); }
    val jo: O.Option[InitJournal] = R.unwrap_ok[O.Option[InitJournal], str](jr);
    if (O.is_none[InitJournal](jo)) { ret R.ok[i32, str](RECOVER_CLEAN); }
    val j: InitJournal = O.unwrap[InitJournal](jo);

    val root_id_r: R.Result[txn.Identity, str] = root_identity_of(root_cap);
    if (R.is_err[txn.Identity, str](root_id_r)) { ret R.err[i32, str](R.unwrap_err[txn.Identity, str](root_id_r)); }
    val root_id: txn.Identity = R.unwrap_ok[txn.Identity, str](root_id_r);
    if (root_id.device != j.root_device || root_id.file != j.root_file) {
        ret R.err[i32, str]("init journal does not match its destination root");
    }

    val manifest_now_r: R.Result[txn.EntryProbe, str] = probe_entry(root_cap, util.PROJECT_CONFIG_NAME);
    if (R.is_err[txn.EntryProbe, str](manifest_now_r)) { ret R.err[i32, str](R.unwrap_err[txn.EntryProbe, str](manifest_now_r)); }
    val manifest_now: txn.EntryProbe = R.unwrap_ok[txn.EntryProbe, str](manifest_now_r);
    val manifest_prior: txn.Identity = txn.Identity{device: j.manifest_prior_device, file: j.manifest_prior_file};
    val manifest_new:   txn.Identity = txn.Identity{device: j.manifest_new_device,   file: j.manifest_new_file};
    val manifest_class: i32 = classify_output(manifest_now, j.manifest_had_identity, manifest_prior, manifest_new);
    if (manifest_class == OUTPUT_ANOMALY) { ret R.err[i32, str]("init journal: mach.toml is neither the original nor the staged replacement"); }

    val entry_leaf: str = if_str(j.entry_is_lib, "lib.mach", "root.mach");
    val entry_backup: str = entry_backup_leaf(j.entry_is_lib);
    val entry_prior: txn.Identity = txn.Identity{device: j.entry_prior_device, file: j.entry_prior_file};
    val entry_new:   txn.Identity = txn.Identity{device: j.entry_new_device,   file: j.entry_new_file};

    val src_now_r: R.Result[txn.EntryProbe, str] = probe_entry(root_cap, "src");
    if (R.is_err[txn.EntryProbe, str](src_now_r)) { ret R.err[i32, str](R.unwrap_err[txn.EntryProbe, str](src_now_r)); }
    val src_now: txn.EntryProbe = R.unwrap_ok[txn.EntryProbe, str](src_now_r);

    var have_src_cap: bool = false;
    var src_cap: txn.Root;
    var entry_class: i32 = OUTPUT_ORIGINAL;
    if (src_now.present && src_now.is_directory) {
        val src_cap_r: R.Result[txn.Root, str] = open_src_cap(a, root, dir_rel);
        if (R.is_err[txn.Root, str](src_cap_r)) { ret R.err[i32, str](R.unwrap_err[txn.Root, str](src_cap_r)); }
        src_cap = R.unwrap_ok[txn.Root, str](src_cap_r);
        have_src_cap = true;

        val entry_now_r: R.Result[txn.EntryProbe, str] = probe_entry(?src_cap, entry_leaf);
        if (R.is_err[txn.EntryProbe, str](entry_now_r)) { txn.root_dnit(?src_cap); ret R.err[i32, str](R.unwrap_err[txn.EntryProbe, str](entry_now_r)); }
        val entry_now: txn.EntryProbe = R.unwrap_ok[txn.EntryProbe, str](entry_now_r);
        entry_class = classify_output(entry_now, j.entry_had_identity, entry_prior, entry_new);
    }
    if (entry_class == OUTPUT_ANOMALY) {
        if (have_src_cap) { txn.root_dnit(?src_cap); }
        ret R.err[i32, str]("init journal: the selected entry file is neither the original nor the staged replacement");
    }

    val overall_done: bool = manifest_class == OUTPUT_DONE;
    if (overall_done && entry_class != OUTPUT_DONE) {
        if (have_src_cap) { txn.root_dnit(?src_cap); }
        ret R.err[i32, str]("init journal: mach.toml committed but the entry file did not");
    }

    if (overall_done) {
        resolve_commit_cleanup(a, root_cap, BACKUP_MANIFEST);
        if (have_src_cap) {
            resolve_commit_cleanup(a, ?src_cap, entry_backup);
            sweep_root(a, ?src_cap);
            txn.root_dnit(?src_cap);
        }
        sweep_root(a, root_cap);
        unlink_entry(root_cap, JOURNAL_LEAF);
        ret R.ok[i32, str](RECOVER_COMPLETED);
    }

    resolve_rollback(a, root_cap, util.PROJECT_CONFIG_NAME, BACKUP_MANIFEST, j.manifest_had_identity);
    if (have_src_cap) {
        resolve_rollback(a, ?src_cap, entry_leaf, entry_backup, j.entry_had_identity);
        sweep_root(a, ?src_cap);
        txn.root_dnit(?src_cap);
    }
    if (j.src_dir_created) { rmdir_entry(root_cap, "src"); }
    sweep_root(a, root_cap);
    unlink_entry(root_cap, JOURNAL_LEAF);
    ret R.ok[i32, str](RECOVER_ROLLED_BACK);
}

fun if_str(cond: bool, when_true: str, when_false: str) str {
    if (cond) { ret when_true; }
    ret when_false;
}

fun refuse_exists(label: *u8) {
    print.eprint("error: ");
    print.eprint(label);
    print.eprint(" already exists (use --force to overwrite)\n");
}

fun refuse_not_regular(label: *u8) {
    print.eprint("error: ");
    print.eprint(label);
    print.eprint(" exists and is not a regular file\n");
}

fun run_existing_branch(a: *A.Allocator, root: str, dir_rel: str, id: *u8, is_lib: bool,
                        entry_leaf: *u8, entry_label: *u8, force: bool, quiet: bool) i64 {
    val cap_r: R.Result[txn.Root, str] = open_root(root, dir_rel);
    if (R.is_err[txn.Root, str](cap_r)) {
        print.eprint("error: ");
        print.eprint(R.unwrap_err[txn.Root, str](cap_r));
        print.eprint("\n");
        ret 2;
    }
    var root_cap: txn.Root = R.unwrap_ok[txn.Root, str](cap_r);

    val recover_r: R.Result[i32, str] = recover_existing(a, root, dir_rel, ?root_cap);
    if (R.is_err[i32, str](recover_r)) {
        print.eprint("error: ");
        print.eprint(R.unwrap_err[i32, str](recover_r));
        print.eprint(" (recovery required; inspect the destination before retrying)\n");
        txn.root_dnit(?root_cap);
        ret 2;
    }

    val manifest_probe_r: R.Result[txn.EntryProbe, str] = probe_entry(?root_cap, util.PROJECT_CONFIG_NAME);
    if (R.is_err[txn.EntryProbe, str](manifest_probe_r)) {
        print.eprint("error: "); print.eprint(R.unwrap_err[txn.EntryProbe, str](manifest_probe_r)); print.eprint("\n");
        txn.root_dnit(?root_cap);
        ret 2;
    }
    val manifest_probe: txn.EntryProbe = R.unwrap_ok[txn.EntryProbe, str](manifest_probe_r);
    if (manifest_probe.present && !manifest_probe.is_regular) {
        refuse_not_regular(util.PROJECT_CONFIG_NAME);
        txn.root_dnit(?root_cap);
        ret 1;
    }
    if (manifest_probe.present && !force) {
        refuse_exists(util.PROJECT_CONFIG_NAME);
        txn.root_dnit(?root_cap);
        ret 1;
    }

    val src_probe_r: R.Result[txn.EntryProbe, str] = probe_entry(?root_cap, "src");
    if (R.is_err[txn.EntryProbe, str](src_probe_r)) {
        print.eprint("error: "); print.eprint(R.unwrap_err[txn.EntryProbe, str](src_probe_r)); print.eprint("\n");
        txn.root_dnit(?root_cap);
        ret 2;
    }
    val src_probe: txn.EntryProbe = R.unwrap_ok[txn.EntryProbe, str](src_probe_r);
    if (src_probe.present && !src_probe.is_directory) {
        print.eprint("error: 'src' exists and is not a directory\n");
        txn.root_dnit(?root_cap);
        ret 1;
    }

    var entry_probe: txn.EntryProbe;
    var have_src_cap: bool = false;
    var src_cap: txn.Root;
    if (src_probe.present) {
        val src_cap_r: R.Result[txn.Root, str] = open_src_cap(a, root, dir_rel);
        if (R.is_err[txn.Root, str](src_cap_r)) {
            print.eprint("error: "); print.eprint(R.unwrap_err[txn.Root, str](src_cap_r)); print.eprint("\n");
            txn.root_dnit(?root_cap);
            ret 2;
        }
        src_cap = R.unwrap_ok[txn.Root, str](src_cap_r);
        have_src_cap = true;

        val entry_probe_r: R.Result[txn.EntryProbe, str] = probe_entry(?src_cap, entry_leaf::str);
        if (R.is_err[txn.EntryProbe, str](entry_probe_r)) {
            print.eprint("error: "); print.eprint(R.unwrap_err[txn.EntryProbe, str](entry_probe_r)); print.eprint("\n");
            txn.root_dnit(?src_cap); txn.root_dnit(?root_cap);
            ret 2;
        }
        entry_probe = R.unwrap_ok[txn.EntryProbe, str](entry_probe_r);
    }
    if (entry_probe.present && !entry_probe.is_regular) {
        refuse_not_regular(entry_label);
        if (have_src_cap) { txn.root_dnit(?src_cap); }
        txn.root_dnit(?root_cap);
        ret 1;
    }
    if (entry_probe.present && !force) {
        refuse_exists(entry_label);
        if (have_src_cap) { txn.root_dnit(?src_cap); }
        txn.root_dnit(?root_cap);
        ret 1;
    }

    val root_id_r: R.Result[txn.Identity, str] = root_identity_of(?root_cap);
    if (R.is_err[txn.Identity, str](root_id_r)) {
        print.eprint("error: "); print.eprint(R.unwrap_err[txn.Identity, str](root_id_r)); print.eprint("\n");
        if (have_src_cap) { txn.root_dnit(?src_cap); }
        txn.root_dnit(?root_cap);
        ret 2;
    }
    val root_id: txn.Identity = R.unwrap_ok[txn.Identity, str](root_id_r);

    val manifest_text_r: R.Result[str, str] = build_manifest_text(a, id, is_lib, target.host_arch_id());
    if (R.is_err[str, str](manifest_text_r)) {
        print.eprint("error: failed to build mach.toml\n");
        if (have_src_cap) { txn.root_dnit(?src_cap); }
        txn.root_dnit(?root_cap);
        ret 2;
    }
    val manifest_text: str = R.unwrap_ok[str, str](manifest_text_r);
    val manifest_prep_r: R.Result[txn.Transaction, str] = stage_owned(a, ?root_cap, util.PROJECT_CONFIG_NAME, manifest_text::*u8, str_len(manifest_text));
    if (R.is_err[txn.Transaction, str](manifest_prep_r)) {
        print.eprint("error: "); print.eprint(R.unwrap_err[txn.Transaction, str](manifest_prep_r)); print.eprint("\n");
        if (have_src_cap) { txn.root_dnit(?src_cap); }
        txn.root_dnit(?root_cap);
        ret 2;
    }
    var manifest_pf: txn.Transaction = R.unwrap_ok[txn.Transaction, str](manifest_prep_r);
    val manifest_new_r: R.Result[txn.Identity, str] = staged_identity_of(?manifest_pf);
    if (R.is_err[txn.Identity, str](manifest_new_r)) {
        print.eprint("error: "); print.eprint(R.unwrap_err[txn.Identity, str](manifest_new_r)); print.eprint("\n");
        txn.abort(?manifest_pf);
        if (have_src_cap) { txn.root_dnit(?src_cap); }
        txn.root_dnit(?root_cap);
        ret 2;
    }
    val manifest_new: txn.Identity = R.unwrap_ok[txn.Identity, str](manifest_new_r);

    val will_create_src: bool = !src_probe.present;
    val src_text: str = source_template(is_lib)::str;

    if (will_create_src) {
        val created_r: R.Result[bool, str] = make_dir_entry(?root_cap, "src", DIR_MODE);
        if (R.is_err[bool, str](created_r)) {
            txn.abort(?manifest_pf);
            txn.root_dnit(?root_cap);
            print.eprint("error: "); print.eprint(R.unwrap_err[bool, str](created_r)); print.eprint("\n");
            ret 2;
        }
        val src_cap_r: R.Result[txn.Root, str] = open_src_cap(a, root, dir_rel);
        if (R.is_err[txn.Root, str](src_cap_r)) {
            txn.abort(?manifest_pf);
            rmdir_entry(?root_cap, "src");
            txn.root_dnit(?root_cap);
            print.eprint("error: "); print.eprint(R.unwrap_err[txn.Root, str](src_cap_r)); print.eprint("\n");
            ret 2;
        }
        src_cap = R.unwrap_ok[txn.Root, str](src_cap_r);
        have_src_cap = true;
    }

    val entry_prep_r: R.Result[txn.Transaction, str] = stage_owned(a, ?src_cap, entry_leaf::str, src_text::*u8, str_len(src_text));
    if (R.is_err[txn.Transaction, str](entry_prep_r)) {
        txn.abort(?manifest_pf);
        if (will_create_src) { rmdir_entry(?root_cap, "src"); }
        txn.root_dnit(?src_cap); txn.root_dnit(?root_cap);
        print.eprint("error: "); print.eprint(R.unwrap_err[txn.Transaction, str](entry_prep_r)); print.eprint("\n");
        ret 2;
    }
    var entry_pf: txn.Transaction = R.unwrap_ok[txn.Transaction, str](entry_prep_r);
    val entry_new_r: R.Result[txn.Identity, str] = staged_identity_of(?entry_pf);
    if (R.is_err[txn.Identity, str](entry_new_r)) {
        txn.abort(?entry_pf); txn.abort(?manifest_pf);
        if (will_create_src) { rmdir_entry(?root_cap, "src"); }
        txn.root_dnit(?src_cap); txn.root_dnit(?root_cap);
        print.eprint("error: "); print.eprint(R.unwrap_err[txn.Identity, str](entry_new_r)); print.eprint("\n");
        ret 2;
    }
    val entry_new: txn.Identity = R.unwrap_ok[txn.Identity, str](entry_new_r);

    val journal_r: R.Result[R.Void, str] = journal_create(a, ?root_cap, root_id,
        manifest_probe, manifest_new, entry_probe, entry_new, is_lib, will_create_src);
    if (R.is_err[R.Void, str](journal_r)) {
        txn.abort(?entry_pf); txn.abort(?manifest_pf);
        if (will_create_src) { rmdir_entry(?root_cap, "src"); }
        txn.root_dnit(?src_cap); txn.root_dnit(?root_cap);
        print.eprint("error: "); print.eprint(R.unwrap_err[R.Void, str](journal_r)); print.eprint("\n");
        ret 2;
    }

    val entry_backup: str = entry_backup_leaf(is_lib);
    val entry_commit_err: O.Option[str] = commit_owned(a, ?src_cap, ?entry_pf, entry_probe.present, entry_leaf::str, entry_backup);
    if (O.is_some[str](entry_commit_err)) {
        print.eprint("error: "); print.eprint(O.unwrap[str](entry_commit_err)); print.eprint("\n");
        recover_existing(a, root, dir_rel, ?root_cap);
        txn.root_dnit(?src_cap); txn.root_dnit(?root_cap);
        ret 2;
    }

    val manifest_commit_err: O.Option[str] = commit_owned(a, ?root_cap, ?manifest_pf, manifest_probe.present, util.PROJECT_CONFIG_NAME, BACKUP_MANIFEST);
    if (O.is_some[str](manifest_commit_err)) {
        print.eprint("error: "); print.eprint(O.unwrap[str](manifest_commit_err)); print.eprint("\n");
        recover_existing(a, root, dir_rel, ?root_cap);
        txn.root_dnit(?src_cap); txn.root_dnit(?root_cap);
        ret 2;
    }

    resolve_commit_cleanup(a, ?src_cap, entry_backup);
    resolve_commit_cleanup(a, ?root_cap, BACKUP_MANIFEST);
    sweep_root(a, ?src_cap);
    sweep_root(a, ?root_cap);
    unlink_entry(?root_cap, JOURNAL_LEAF);

    txn.root_dnit(?src_cap);
    txn.root_dnit(?root_cap);

    if (!quiet) {
        print.eprint("created project '");
        print.eprint(id::str);
        print.eprint("'\n");
    }
    ret 0;
}

fun build_manifest_text(alloc: *A.Allocator, id: *u8, is_lib: bool, arch_id: u32) R.Result[str, str] {
    var storage: [4096]u8;
    var buf: Buf;
    buf.ptr = ?storage[0];
    buf.cap = 4096;
    buf.len = 0;
    buf.ok  = true;

    buf_put(?buf, "[project]\n");
    buf_put(?buf, "id = \"");
    buf_put(?buf, id);
    buf_put(?buf, "\"\n");
    buf_put(?buf, "version = \"0.1.0\"\n");
    buf_put(?buf, "src = \"src\"\n");
    buf_put(?buf, "out = \"out/{target.name}/{profile.name}\"\n");
    buf_put(?buf, "\n");

    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    if (R.is_err[R.Void, str](driver.setup_registry(?reg))) { ret R.err[str, str]("failed to register targets"); }
    emit_targets(?buf, ?reg, arch_id);
    emit_artifacts(?buf, ?reg, arch_id, id, is_lib);
    if (!is_lib && !str_empty(scaffold_abi(?reg, "windows", arch_id))) {
        buf_put(?buf, "[link.kernel32]\nsource = \"system\"\nname = \"kernel32.dll\"\nos = [\"windows\"]\nisa = [\"*\"]\nabi = [\"*\"]\nexport = false\n\n");
    }

    buf_put(?buf, "[profile.debug]\n");
    buf_put(?buf, "default = true\n");
    buf_put(?buf, "opt = 0\n");
    buf_put(?buf, "debug = true\n");
    buf_put(?buf, "simd = \"scalarize\"\n");
    buf_put(?buf, "vectorize = false\n");
    buf_put(?buf, "\n");
    buf_put(?buf, "[profile.release]\n");
    buf_put(?buf, "opt = 2\n");
    buf_put(?buf, "debug = false\n");
    buf_put(?buf, "simd = \"scalarize\"\n");
    buf_put(?buf, "vectorize = true\n");
    buf_put(?buf, "\n");

    var di: usize = 0;
    for (di < SCAFFOLD_DEP_COUNT) {
        val dep: ScaffoldDep = SCAFFOLD_DEPS[di];
        buf_put(?buf, "[dep.");
        buf_put(?buf, dep.id::*u8);
        buf_put(?buf, "]\n");
        buf_put(?buf, "git = \"");
        buf_put(?buf, dep.git::*u8);
        buf_put(?buf, "\"\n");
        buf_put(?buf, "ref = \"");
        buf_put(?buf, dep.ref::*u8);
        buf_put(?buf, "\"\n");
        di = di + 1;
    }

    if (!buf.ok) { ret R.err[str, str]("mach.toml scaffold exceeds the scratch buffer"); }
    ret str_copy_slice(alloc, buf.ptr::str, 0, buf.len);
}

fun scaffold_of_name(reg: *target.TargetRegistry, os_name: str, arch_id: u32) R.Result[of.ArtifactName, str] {
    val abi_name: str = scaffold_abi(reg, os_name, arch_id);
    if (str_empty(abi_name)) { ret R.err[of.ArtifactName, str]("scaffold: no naming target"); }
    val tgt_r: R.Result[resolved.Target, str] = target.select(reg, isa.arch_name_for(arch_id), os_name, abi_name);
    if (R.is_err[resolved.Target, str](tgt_r)) { ret R.err[of.ArtifactName, str](R.unwrap_err[resolved.Target, str](tgt_r)); }
    var tgt: resolved.Target = R.unwrap_ok[resolved.Target, str](tgt_r);
    ret target.artifact_naming(?tgt, of.ARTIFACT_EXECUTABLE);
}

fun emit_artifacts(b: *Buf, reg: *target.TargetRegistry, arch_id: u32,
                   id: *u8, is_lib: bool) {
    if (is_lib) {
        val lib_r: R.Result[resolved.Target, str] = target.select(reg, isa.arch_name_for(arch_id), "linux", scaffold_abi(reg, "linux", arch_id));
        var prefix: str = "lib";
        var suffix: str = ".a";
        if (R.is_ok[resolved.Target, str](lib_r)) {
            var tgt: resolved.Target = R.unwrap_ok[resolved.Target, str](lib_r);
            val an_r: R.Result[of.ArtifactName, str] = target.artifact_naming(?tgt, of.ARTIFACT_STATIC_LIB);
            if (R.is_ok[of.ArtifactName, str](an_r)) {
                val an: of.ArtifactName = R.unwrap_ok[of.ArtifactName, str](an_r);
                prefix = an.prefix;
                suffix = an.suffix;
            }
        }
        buf_put(b, "[artifact.");
        buf_put(b, id);
        buf_put(b, "]\nkind = \"static\"\nentry = \"lib.mach\"\nout = \"lib/");
        buf_put(b, prefix::*u8);
        buf_put(b, id);
        buf_put(b, suffix::*u8);
        buf_put(b, "\"\ntargets = [\"*\"]\nlink = []\nneed = []\n\n");
        ret;
    }

    emit_binary_artifact(b, reg, arch_id, id, false);
    if (!str_empty(scaffold_abi(reg, "windows", arch_id))) {
        emit_binary_artifact(b, reg, arch_id, id, true);
    }
}

fun emit_binary_artifact(b: *Buf, reg: *target.TargetRegistry, arch_id: u32,
                         id: *u8, windows: bool) {
    var os_name: str = "linux";
    if (windows) { os_name = "windows"; }
    var suffix: str = "";
    val an_r: R.Result[of.ArtifactName, str] = scaffold_of_name(reg, os_name, arch_id);
    if (R.is_ok[of.ArtifactName, str](an_r)) { suffix = R.unwrap_ok[of.ArtifactName, str](an_r).suffix; }

    buf_put(b, "[artifact.");
    buf_put(b, id);
    if (windows) { buf_put(b, "-windows"); }
    buf_put(b, "]\nkind = \"bin\"\nentry = \"root.mach\"\nout = \"bin/");
    buf_put(b, id);
    buf_put(b, suffix::*u8);
    buf_put(b, "\"\ntargets = [");
    emit_artifact_targets(b, reg, arch_id, windows);
    if (windows) { buf_put(b, "]\nlink = [\"kernel32\"]\nneed = []\n\n"); }
    or            { buf_put(b, "]\nlink = []\nneed = []\n\n"); }
}

fun emit_artifact_targets(b: *Buf, reg: *target.TargetRegistry,
                          arch_id: u32, windows: bool) {
    var wrote: bool = false;
    emit_artifact_target(b, reg, "linux", arch_id, windows, ?wrote);
    emit_artifact_target(b, reg, "windows", arch_id, windows, ?wrote);
    emit_artifact_target(b, reg, "darwin", arch_id, windows, ?wrote);
}

fun emit_artifact_target(b: *Buf, reg: *target.TargetRegistry, os_name: *u8,
                         arch_id: u32, windows: bool, wrote: *bool) {
    val is_windows: bool = str_equals(os_name::str, "windows");
    if (is_windows != windows || str_empty(scaffold_abi(reg, os_name::str, arch_id))) { ret; }
    if (@wrote) { buf_put(b, ", "); }
    buf_put(b, "\"");
    buf_put(b, os_name);
    buf_put(b, "-");
    buf_put(b, isa.arch_name_for(arch_id)::*u8);
    buf_put(b, "\"");
    @wrote = true;
}

val BIN_SOURCE_TEMPLATE: str = "use std.runtime;\nuse print: std.print;\n\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i64 {\n    print.println(\"Hello, World!\");\n    ret 0;\n}\n";

fun source_template(is_lib: bool) *u8 {
    if (is_lib) { ret ""; }
    ret BIN_SOURCE_TEMPLATE::*u8;
}

fun buf_put(b: *Buf, s: *u8) {
    if (!b.ok) { ret; }
    val n: usize = str_len(s);
    if (b.len + n > b.cap) {
        b.ok = false;
        ret;
    }
    var i: usize = 0;
    for (i < n) {
        b.ptr[b.len + i] = s[i];
        i = i + 1;
    }
    b.len = b.len + n;
}

fun default_project_id(a: *A.Allocator, cwd: str, dir: str) R.Result[str, str] {
    val abs_r: R.Result[str, str] = path.resolve(a, cwd, dir);
    if (R.is_err[str, str](abs_r)) { ret abs_r; }
    val clean_r: R.Result[str, str] = path.clean(a, R.unwrap_ok[str, str](abs_r));
    if (R.is_err[str, str](clean_r)) { ret clean_r; }
    ret R.ok[str, str](path.filename(R.unwrap_ok[str, str](clean_r)));
}

fun emit_targets(b: *Buf, reg: *target.TargetRegistry, arch_id: u32) {
    emit_target(b, reg, "linux",   arch_id);
    emit_target(b, reg, "windows", arch_id);
    emit_target(b, reg, "darwin",  arch_id);
}

fun emit_target(b: *Buf, reg: *target.TargetRegistry, os_name: *u8, arch_id: u32) {
    val abi_name: str = scaffold_abi(reg, os_name::str, arch_id);
    if (str_empty(abi_name)) { ret; }
    val isa_name: str = isa.arch_name_for(arch_id);
    buf_put(b, "[target.");
    buf_put(b, os_name);
    buf_put(b, "-");
    buf_put(b, isa_name::*u8);
    buf_put(b, "]\n");
    buf_put(b, "isa = \"");
    buf_put(b, isa_name::*u8);
    buf_put(b, "\"\n");
    buf_put(b, "os  = \"");
    buf_put(b, os_name);
    buf_put(b, "\"\n");
    buf_put(b, "abi = \"");
    buf_put(b, abi_name::*u8);
    buf_put(b, "\"\n");
    buf_put(b, "\n");
}

fun scaffold_abi(reg: *target.TargetRegistry, os_name: str, arch_id: u32) str {
    val os_opt: O.Option[*tos.OsVTable] = tos.lookup(?reg.os, os_name);
    if (O.is_none[*tos.OsVTable](os_opt)) { ret ""; }
    val abi_name: str = tos.native_abi_for(O.unwrap[*tos.OsVTable](os_opt), arch_id);
    if (str_empty(abi_name)) { ret ""; }
    if (R.is_err[target.Target, str](target.select(reg, isa.arch_name_for(arch_id), os_name, abi_name))) { ret ""; }
    ret abi_name;
}

test "mach.cli.cmd.init.emit_artifacts:extension_split" {
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    if (R.is_err[R.Void, str](driver.setup_registry(?reg))) { ret 1; }

    var bin_storage: [1024]u8;
    var bin: Buf;
    bin.ptr = ?bin_storage[0]; bin.cap = 1024; bin.len = 0; bin.ok = true;
    emit_artifacts(?bin, ?reg, isa.ARCH_X86_64, "demo", false);
    if (!bin.ok || bin.len >= bin.cap) { ret 1; }
    bin.ptr[bin.len] = 0;
    val want_bin: str = "[artifact.demo]\nkind = \"bin\"\nentry = \"root.mach\"\nout = \"bin/demo\"\ntargets = [\"linux-x86_64\", \"darwin-x86_64\"]\nlink = []\nneed = []\n\n[artifact.demo-windows]\nkind = \"bin\"\nentry = \"root.mach\"\nout = \"bin/demo.exe\"\ntargets = [\"windows-x86_64\"]\nlink = [\"kernel32\"]\nneed = []\n\n";
    if (!str_equals(bin.ptr::str, want_bin)) { ret 1; }

    var lib_storage: [512]u8;
    var lib: Buf;
    lib.ptr = ?lib_storage[0]; lib.cap = 512; lib.len = 0; lib.ok = true;
    emit_artifacts(?lib, ?reg, isa.ARCH_X86_64, "demo", true);
    if (!lib.ok || lib.len >= lib.cap) { ret 1; }
    lib.ptr[lib.len] = 0;
    val want_lib: str = "[artifact.demo]\nkind = \"static\"\nentry = \"lib.mach\"\nout = \"lib/libdemo.a\"\ntargets = [\"*\"]\nlink = []\nneed = []\n\n";
    if (!str_equals(lib.ptr::str, want_lib)) { ret 1; }
    ret 0;
}

fun t_manifest_from_text(a: *A.Allocator, itn: *intern.Interner, text: str) O.Option[manifest.Manifest] {
    val tr: R.Result[toml.Table, str] = toml.parse(a, text);
    if (R.is_err[toml.Table, str](tr)) { ret O.none[manifest.Manifest](); }
    var t: toml.Table = R.unwrap_ok[toml.Table, str](tr);
    val mr: R.Result[manifest.Manifest, str] = manifest.parse(a, itn, ?t, true);
    toml.dnit(a, ?t);
    if (R.is_err[manifest.Manifest, str](mr)) { ret O.none[manifest.Manifest](); }
    ret O.some[manifest.Manifest](R.unwrap_ok[manifest.Manifest, str](mr));
}

fun t_scaffold_plan_units(a: *A.Allocator, id: *u8, is_lib: bool, arch_id: u32) i64 {
    val text_r: R.Result[str, str] = build_manifest_text(a, id, is_lib, arch_id);
    if (R.is_err[str, str](text_r)) { ret -1; }
    val text: str = R.unwrap_ok[str, str](text_r);

    var itn: intern.Interner = intern.init(a);
    val opt_m: O.Option[manifest.Manifest] = t_manifest_from_text(a, ?itn, text);
    if (O.is_none[manifest.Manifest](opt_m)) { ret -1; }
    var m: manifest.Manifest = O.unwrap[manifest.Manifest](opt_m);

    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    if (R.is_err[R.Void, str](driver.setup_registry(?reg))) { ret -1; }

    var rq: request.BuildRequest = request.defaults();
    rq.project_root = "/scaftest";
    rq.all_targets  = true;

    val pr: R.Result[plan.BuildPlan, outcome.Fail] = plan.plan(a, ?itn, ?reg, ?m, rq);
    if (R.is_err[plan.BuildPlan, outcome.Fail](pr)) { ret -1; }
    val bp: plan.BuildPlan = R.unwrap_ok[plan.BuildPlan, outcome.Fail](pr);
    ret bp.units.len::i64;
}

test "mach.cli.cmd.init.build_manifest_text:bin_scaffold_parses_and_plans_for_every_host_arch" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }

    if (t_scaffold_plan_units(?alloc, "scaftest", false, isa.ARCH_X86_64)  != 3) { ret 1; }
    if (t_scaffold_plan_units(?alloc, "scaftest", false, isa.ARCH_AARCH64) != 2) { ret 1; }
    if (t_scaffold_plan_units(?alloc, "scaftest", false, isa.ARCH_RISCV64) != 1) { ret 1; }
    ret 0;
}

