test "mach.cli.cmd.init.run:refuses_an_owned_output_without_force_and_leaves_it_byte_identical" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val root_r: res[str, outcome.Fail] = t_scratch_dir(?alloc, "mach_init_refuse");
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    var bad: i32 = 0;

    val toml_r: res[str, A.Error] = path.join(?alloc, root, "mach.toml");
    if (sel toml_r.err) { ret 99; }
    val toml: str = toml_r.ok;
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(toml, "mine"::*u8, 4::usize, 0o644);
    if (sel write_bytes_r.err) { bad = 1; }

    var argv: [5]*u8;
    argv[0] = "mach"; argv[1] = "init"; argv[2] = root::*u8; argv[3] = "--name"; argv[4] = "refused"::*u8;

    val rc: i64 = t_init(5, ?argv[0]);
    if (rc != 1) { bad = 1; }
    val kept: opt[str] = t_read_file(?alloc, toml);
    if (!(sel kept.some && str_equals(kept.some, "mine"))) { bad = 1; }
    val src_r: res[str, A.Error] = path.join(?alloc, root, "src");
    if (sel src_r.err) { ret 99; }
    val exists_r: res[bool, io_error.Error] = fs.exists(src_r.ok);
    if (sel exists_r.err) { ret 99; }
    if ((sel exists_r.ok && exists_r.ok)) { bad = 1; }

    fs.remove_all(?alloc, root);
    str_free(?alloc, root);
    ret bad;
}

test "mach.cli.cmd.init.run:force_replaces_owned_outputs_and_leaves_an_unowned_neighbor_byte_identical" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val root_r: res[str, outcome.Fail] = t_scratch_dir(?alloc, "mach_init_force");
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    var bad: i32 = 0;

    val toml_r: res[str, A.Error] = path.join(?alloc, root, "mach.toml");
    if (sel toml_r.err) { ret 99; }
    val toml: str = toml_r.ok;
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(toml, "stale"::*u8, 5::usize, 0o644);
    if (sel write_bytes_r.err) { bad = 1; }
    val src_dir_r: res[str, A.Error] = path.join(?alloc, root, "src");
    if (sel src_dir_r.err) { ret 99; }
    val create_dir_r: err[io_error.Error] = fs.create_dir(src_dir_r.ok, 0o755);
    if (sel create_dir_r.err) { bad = 1; }
    val entry_r: res[str, A.Error] = path.join(?alloc, root, "src/root.mach");
    if (sel entry_r.err) { ret 99; }
    val entry: str = entry_r.ok;
    val write_bytes_r2: err[fs.FsError] = fs.write_bytes(entry, "stale-source"::*u8, 12::usize, 0o644);
    if (sel write_bytes_r2.err) { bad = 1; }
    val neighbor_r: res[str, A.Error] = path.join(?alloc, root, "src/mine.mach");
    if (sel neighbor_r.err) { ret 99; }
    val neighbor: str = neighbor_r.ok;
    val write_bytes_r3: err[fs.FsError] = fs.write_bytes(neighbor, "user-owned"::*u8, 10::usize, 0o644);
    if (sel write_bytes_r3.err) { bad = 1; }
    val readme_r: res[str, A.Error] = path.join(?alloc, root, "README.md");
    if (sel readme_r.err) { ret 99; }
    val readme: str = readme_r.ok;
    val write_bytes_r4: err[fs.FsError] = fs.write_bytes(readme, "hello"::*u8, 5::usize, 0o644);
    if (sel write_bytes_r4.err) { bad = 1; }

    var argv: [7]*u8;
    argv[0] = "mach"; argv[1] = "init"; argv[2] = root::*u8; argv[3] = "--name"; argv[4] = "forced"::*u8; argv[5] = "--force"::*u8; argv[6] = "--no-deps"::*u8;

    val rc: i64 = t_init(7, ?argv[0]);
    if (rc != 0) { bad = 1; }

    val new_toml: opt[str] = t_read_file(?alloc, toml);
    if (!(sel new_toml.some && !(str_equals(new_toml.some, "stale")))) { bad = 1; }
    val new_entry: opt[str] = t_read_file(?alloc, entry);
    if (!(sel new_entry.some && !(str_equals(new_entry.some, "stale-source")))) { bad = 1; }
    val kept_neighbor: opt[str] = t_read_file(?alloc, neighbor);
    if (!(sel kept_neighbor.some && str_equals(kept_neighbor.some, "user-owned"))) { bad = 1; }
    val kept_readme: opt[str] = t_read_file(?alloc, readme);
    if (!(sel kept_readme.some && str_equals(kept_readme.some, "hello"))) { bad = 1; }

    var jname: str = sfmt_join(?alloc, root, JOURNAL_LEAF);
    val exists_r: res[bool, io_error.Error] = fs.exists(jname);
    if (sel exists_r.err) { ret 99; }
    if ((sel exists_r.ok && exists_r.ok)) { bad = 1; }
    var bname: str = sfmt_join(?alloc, root, BACKUP_MANIFEST);
    val exists_r2: res[bool, io_error.Error] = fs.exists(bname);
    if (sel exists_r2.err) { ret 99; }
    if ((sel exists_r2.ok && exists_r2.ok)) { bad = 1; }

    fs.remove_all(?alloc, root);
    str_free(?alloc, root);
    ret bad;
}

fun sfmt_join(alloc: *A.Allocator, root: str, leaf: str) str {
    val r: res[str, A.Error] = path.join(alloc, root, leaf);
    if (sel r.err) { ret ""; }
    ret r.ok;
}

