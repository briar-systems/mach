    if (sel make_r.err) { ret 1; }

    if (t_scaffold_plan_units(?alloc, "scaftest", true, isa.ARCH_X86_64) != 3)  { ret 1; }
    if (t_scaffold_plan_units(?alloc, "scaftest", true, isa.ARCH_AARCH64) != 2) { ret 1; }
    if (t_scaffold_plan_units(?alloc, "scaftest", true, isa.ARCH_RISCV64) != 1) { ret 1; }
    ret 0;
}

test "mach.cli.cmd.init.source_template:lib_is_empty_bin_declares_std_runtime" {
    if (!str_empty(source_template(true)::str)) { ret 1; }

    val bin: str = source_template(false)::str;
    if (str_empty(bin))                      { ret 1; }
    if (!str_contains(bin, "std.runtime"))   { ret 1; }
    if (str_contains(bin, "_start"))         { ret 1; }
    if (str_contains(bin, "mainCRTStartup")) { ret 1; }
    if (str_contains(bin, "ExitProcess"))    { ret 1; }
    if (str_contains(bin, "asm "))           { ret 1; }
    ret 0;
}

# a scaffolded source passes `mach fmt --check` as written (#3817)
fun t_is_fmt_canonical(a: *A.Allocator, text: str) bool {
    var diags: diagnostic.DiagnosticStore = diagnostic.store_init(a);
    fin { diagnostic.store_dnit(?diags); }
    val formatted: res[str, fail.Fail] = mfmt.format_source(a, text, 0, ?diags);
    if (sel formatted.err) { ret false; }
    val same: bool = str_equals(formatted.ok, text);
    str_free(a, formatted.ok);
    ret same;
}

test "mach.cli.cmd.init.source_template:every_template_is_fmt_canonical" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err)                                           { ret 1; }
    if (!t_is_fmt_canonical(?alloc, source_template(false)::str)) { ret 2; }
    if (!t_is_fmt_canonical(?alloc, source_template(true)::str))  { ret 3; }
    ret 0;
}

test "mach.cli.cmd.init.build_manifest_text:states_the_compiler_range_and_leaves_dependencies_to_dep_add" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val text_r: res[str, outcome.Fail] = build_manifest_text(?alloc, "scaftest", false, isa.ARCH_X86_64);
    if (sel text_r.err) { ret 2; }
    val text: str = text_r.ok;
    if (str_contains(text, "[dep.")) { ret 3; }
    var itn:   intern.Interner        = intern.init(?alloc);
    val opt_m: opt[manifest.Manifest] = t_manifest_from_text(?alloc, ?itn, text);
    if (sel opt_m.none) { ret 4; }
    val m:      manifest.Manifest = opt_m.some;
    val mach_r: opt[str]          = intern.lookup(?itn, m.mach);
    if (sel mach_r.none) { ret 5; }
    val floor: res[str, format.FormatError] = ddep.running_mach_range_floor(?alloc);
    if (sel floor.err)                      { ret 6; }
    if (!str_equals(mach_r.some, floor.ok)) { ret 7; }
    # every 5.x compiler writes the key's own floor, never its own minor (#3572)
    if (str_starts_with(compiler.MACH_VERSION, "5.") && !str_equals(mach_r.some, "^5.3")) { ret 7; }
    if (m.dep_count != 0)                                                                 { ret 8; }
    ret 0;
}

fun t_git_in(a: *A.Allocator, dir: str, c1: str, c2: str, c3: str) bool {
    val gr: res[str, exec.Error] = exec.resolve(a, "git");
    if (sel gr.err) { ret false; }
    var av: [7]*u8;
    av[0] = gr.ok::*u8;
    av[1] = "-C"::*u8;
    av[2] = dir::*u8;
    var k: usize = 3;
    if (!str_empty(c1)) {
        av[k] = c1::*u8;
        k     = k + 1;
    }
    if (!str_empty(c2)) {
        av[k] = c2::*u8;
        k     = k + 1;
    }
    if (!str_empty(c3)) {
        av[k] = c3::*u8;
        k     = k + 1;
    }
    av[k] = nil;
    val rr: res[exec.ExitStatus, exec.Error] = exec.run(gr.ok, ?av[0], nil);
    if (sel rr.err) { ret false; }
    ret exec.exited(rr.ok) && exec.code(rr.ok) == 0;
}

# one tagged release of a fixture std whose manifest needs `mach_range`
fun t_std_release(a: *A.Allocator, dir: str, version: str, mach_range: str) bool {
    val body: res[str, format.FormatError] = format.sprint(a,
        "[project]\nid = \"std\"\nversion = \"{}\"\nmach = \"{}\"\nsrc = \"src\"\nout = \"out\"\n", version, mach_range);
    if (sel body.err) { ret false; }
    val file: str             = sfmt_join(a, dir, "mach.toml");
    val wr:   err[fs.FsError] = fs.write_bytes(file, body.ok::*u8, str_len(body.ok), 0o644);
    if (sel wr.err)                              { ret false; }
    if (!t_git_in(a, dir, "add", "-A", ""))      { ret false; }
    if (!t_git_in(a, dir, "commit", "-qm", "x")) { ret false; }
    val tag: res[str, format.FormatError] = format.sprint(a, "v{}", version);
    if (sel tag.err) { ret false; }
    ret t_git_in(a, dir, "tag", tag.ok, "");
}

# init adds std at the caret of the highest release whose [project].mach admits the running
# compiler, not a branch (#3504)
test "mach.cli.cmd.init.run:std_is_added_at_the_release_the_running_compiler_resolves" {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    var env: [4]*u8;
    env[0] = "GIT_CONFIG_COUNT=1"::*u8;
    env[1] = "GIT_CONFIG_KEY_0=protocol.file.allow"::*u8;
    env[2] = "GIT_CONFIG_VALUE_0=always"::*u8;
    env[3] = nil;
    ddep.set_git_config_env(?env[0]);
    fin { ddep.set_git_config_env(nil); }

    val std_r: res[str, outcome.Fail] = t_scratch_dir(?a, "mach_init_fixture_std");
    if (sel std_r.err) { ret 2; }
    val std_dir: str = std_r.ok;
    fin { fs.remove_all(?a, std_dir); }
    val src_dir: str             = sfmt_join(?a, std_dir, "src");
    val made:    err[fs.FsError] = fs.create_dir_all(?a, src_dir, 0o755);
    if (sel made.err) { ret 3; }
    val lib:  str             = sfmt_join(?a, std_dir, "src/lib.mach");
    val body: str             = "pub fun hello() i32 { ret 1; }\n";
    val lw:   err[fs.FsError] = fs.write_bytes(lib, body::*u8, str_len(body), 0o644);
    if (sel lw.err)                                            { ret 3; }
    if (!t_git_in(?a, std_dir, "init", "-q", ""))              { ret 4; }
    if (!t_git_in(?a, std_dir, "config", "user.email", "t@t")) { ret 4; }
    if (!t_git_in(?a, std_dir, "config", "user.name", "t"))    { ret 4; }
    if (!t_std_release(?a, std_dir, "1.0.0", ">=5"))           { ret 5; }
    if (!t_std_release(?a, std_dir, "1.1.0", ">=5"))           { ret 5; }
    if (!t_std_release(?a, std_dir, "2.0.0", ">=99"))          { ret 5; }

    val root_r: res[str, outcome.Fail] = t_scratch_dir(?a, "mach_init_std_range");
    if (sel root_r.err) { ret 6; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?a, root); }
    var argv: [6]*u8 = [6]*u8{"mach", "init", root::*u8, "--name", "rangeinit", "--no-deps"};
    if (t_init(6, ?argv[0]) != 0) { ret 7; }

    var deps: [1]ScaffoldDep = [1]ScaffoldDep{ScaffoldDep{id: "std", git: std_dir}};
    if (dependency_stage(?a, root, false, false, true, ?deps[0], 1) != 0) { ret 8; }
    val text: opt[str] = t_read_file(?a, sfmt_join(?a, root, "mach.toml"));
    if (sel text.none)                                    { ret 9; }
    if (!str_contains(text.some, "[dep.std]"))            { ret 10; }
    if (!str_contains(text.some, "version = \"^1.1.0\"")) { ret 11; }
    if (str_contains(text.some, "branch/"))               { ret 12; }
    val tagged: res[str, outcome.Fail] = t_release_of(?a, root);
    if (sel tagged.err)                  { ret 13; }
    if (!str_equals(tagged.ok, "1.1.0")) { ret 14; }
    ret 0;
}

# --no-deps still resolves and writes the range but checks nothing out, and an unreachable
# source is a failure rather than a silently unpinned declaration (#3504)
test "mach.cli.cmd.init.run:no_deps_resolves_the_range_without_a_checkout" {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    var env: [4]*u8;
    env[0] = "GIT_CONFIG_COUNT=1"::*u8;
    env[1] = "GIT_CONFIG_KEY_0=protocol.file.allow"::*u8;
    env[2] = "GIT_CONFIG_VALUE_0=always"::*u8;
    env[3] = nil;
    ddep.set_git_config_env(?env[0]);
    fin { ddep.set_git_config_env(nil); }

    val std_r: res[str, outcome.Fail] = t_scratch_dir(?a, "mach_init_nodeps_std");
    if (sel std_r.err) { ret 2; }
    val std_dir: str = std_r.ok;
    fin { fs.remove_all(?a, std_dir); }
    val made: err[fs.FsError] = fs.create_dir_all(?a, sfmt_join(?a, std_dir, "src"), 0o755);
    if (sel made.err) { ret 3; }
    val body: str             = "pub fun hello() i32 { ret 1; }\n";
    val lw:   err[fs.FsError] = fs.write_bytes(sfmt_join(?a, std_dir, "src/lib.mach"), body::*u8, str_len(body), 0o644);
    if (sel lw.err)                                            { ret 3; }
    if (!t_git_in(?a, std_dir, "init", "-q", ""))              { ret 4; }
    if (!t_git_in(?a, std_dir, "config", "user.email", "t@t")) { ret 4; }
    if (!t_git_in(?a, std_dir, "config", "user.name", "t"))    { ret 4; }
    if (!t_std_release(?a, std_dir, "1.0.0", ">=5"))           { ret 5; }
    if (!t_std_release(?a, std_dir, "2.0.0", ">=99"))          { ret 5; }

    val root_r: res[str, outcome.Fail] = t_scratch_dir(?a, "mach_init_nodeps_root");
    if (sel root_r.err) { ret 6; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?a, root); }
    var argv: [6]*u8 = [6]*u8{"mach", "init", root::*u8, "--name", "nodepsinit", "--no-deps"};
    if (t_init(6, ?argv[0]) != 0) { ret 7; }

    var deps: [1]ScaffoldDep = [1]ScaffoldDep{ScaffoldDep{id: "std", git: std_dir}};
    if (dependency_stage(?a, root, true, false, true, ?deps[0], 1) != 0) { ret 8; }
    val text: opt[str] = t_read_file(?a, sfmt_join(?a, root, "mach.toml"));
    if (sel text.none)                                    { ret 9; }
    if (!str_contains(text.some, "version = \"^1.0.0\"")) { ret 10; }
    val checkout: res[bool, io_error.Error] = fs.exists(sfmt_join(?a, root, "dep/std"));
    if (sel checkout.err) { ret 11; }
    if (checkout.ok)      { ret 12; }

    # the hint names the command pull's refusal names, and that command realizes the release (#3580)
    val hinted:  str = t_backticked(?a, no_deps_hint(?a, root, "std"));
    val refused: str = t_backticked(?a, cdep.unpinned_refusal(?a, root, "std", "^1.0.0"));
    if (str_empty(hinted) || !str_equals(hinted, refused)) { ret 18; }
    if (cdep.pull_project(root, true) != 1)                { ret 19; }
    var words: [8]*u8;
    val n:     usize = t_split_words(hinted, ?words[0], 7);
    if (n != 5) { ret 20; }
    val parsed: res[args.ParsedInvocation, outcome.Fail] = args.parse_invocation(?a, n, ?words[0]);
    if (sel parsed.err) { ret 21; }
    var inv: args.ParsedInvocation = parsed.ok;
    if (cdep.run(?words[0], ?inv) != 0) { ret 22; }
    val pinned: res[str, outcome.Fail] = t_release_of(?a, root);
    if (sel pinned.err)                     { ret 23; }
    if (!str_equals(pinned.ok, "1.0.0"))    { ret 24; }
    if (cdep.pull_project(root, true) != 0) { ret 25; }

    val bare_r: res[str, outcome.Fail] = t_scratch_dir(?a, "mach_init_nodeps_unreachable");
    if (sel bare_r.err) { ret 13; }
    val bare: str = bare_r.ok;
    fin { fs.remove_all(?a, bare); }
    argv[2] = bare::*u8;
    if (t_init(6, ?argv[0]) != 0) { ret 14; }
    var gone: [1]ScaffoldDep = [1]ScaffoldDep{ScaffoldDep{id: "std", git: sfmt_join(?a, std_dir, "absent")}};
    if (dependency_stage(?a, bare, true, false, true, ?gone[0], 1) == 0) { ret 15; }
    val kept: opt[str] = t_read_file(?a, sfmt_join(?a, bare, "mach.toml"));
    if (sel kept.none)                        { ret 16; }
    if (str_contains(kept.some, "[dep.std]")) { ret 17; }
    ret 0;
}

fun t_release_of(a: *A.Allocator, root: str) res[str, outcome.Fail] {
    val sr: res[session.Session, fail.Fail] = session.init(a);
    if (sel sr.err) { ret res[str, outcome.Fail].err{outcome.internal("session")}; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    ret ddep.release_at_head(?s, sfmt_join(a, root, "dep/std"));
}

fun t_source_parses(alloc: *A.Allocator, text: str) bool {
    val sr: res[session.Session, fail.Fail] = session.init(alloc);
    if (sel sr.err) { ret false; }
    var s:  session.Session      = sr.ok;
    var es: editor.EditorSession = editor.init(?s);

    val open_r: res[source.FileId, fail.Fail] = editor.open(?es, "/mach-init-standalone-parse-check/entry.mach", text);
    if (sel open_r.err) {
        editor.dnit(?es);
        session.dnit(?s);
        ret false;
    }
    val fid: source.FileId = open_r.ok;

    var req:      editor.AnalysisRequest                   = editor.analysis_request(fid, editor.PHASE_PARSE);
    val analyzed: res[editor.AnalysisResult, outcome.Fail] = editor.analyze(?es, ?req);
    var ok:       bool                                     = false;
    if (sel analyzed.ok) {
        var result: editor.AnalysisResult = analyzed.ok;
        ok = sel result.status.kind.accepted && !diagnostic.has_errors(result.diagnostics);
        editor.analysis_dnit(?result);
    }
    if (sel analyzed.err) {
        var failure: outcome.Fail = analyzed.err;
        editor.fail_dnit(?es, ?failure);
    }

    val dnit_r2: err[fail.Fail] = editor.dnit(?es);
    session.dnit(?s);
    ret ok;
}

fun t_entry_parses(alloc: *A.Allocator, dest: str, entry_rel: str) bool {
    val p_r: res[str, A.Error] = path.join(alloc, dest, entry_rel);
    if (sel p_r.err) { ret false; }
    val p:        str      = p_r.ok;
    val text_opt: opt[str] = t_read_file(alloc, p);
    str_free(alloc, p);
    if (sel text_opt.none) { ret false; }
    ret t_source_parses(alloc, text_opt.some);
}

