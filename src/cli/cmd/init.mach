# `mach init`, which scaffolds a project: its manifest, entry file and std dependency
#
# the entry is `src/bin/main.mach` with a bin artifact, or under `--lib`
# `src/lib/<id>.mach` with a static artifact. std is declared at the caret range of the
# release resolution picks for the running compiler, which is resolved before anything is
# written, so a project is made whole or not at all, and is then checked out. `--no-deps`
# declares no dependency and reads nothing from the network. a project made in a git
# repository ignores its work directory.

use std_args: std.args;
use std.collections.slice.Slice;
use fs:         std.filesystem;
use std_format: std.format;
use io_error:   std.io.error;
use std.process.env;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use types_path: std.types.path;
use std.types.result.res;
use std.types.size.usize;
use types_string: std.types.string;
use std.types.string.str;
use std.types.string.str_len;

use A: std.allocator;

use mach.base.diagnostic;
use diagnostic_kind: mach.base.diagnostic.kind;
use mach.base.fail;
use mach.base.textbuild;
use mach.cli.args;
use cli_diagnostic: mach.cli.diagnostic;
use mach.cli.exit;
use compile_closure: mach.compile.closure;
use mach.host.output;
use manifest_edit:   mach.manifest.edit;
use manifest_load:   mach.manifest.load;
use manifest_schema: mach.manifest.schema;
use package_closure: mach.package.closure;
use package_edit:    mach.package.edit;
use mach.package.git;
use mach.package.report;
use mach.session;
use mach.target.resolved;
use mink_fail:   mink.base.fail;
use mink_target: mink.catalog.target;
use std.filesystem.native;
use std.process.exec;
use system_os: std.system.os;

val DIR_MODE:  i32 = 493;
val FILE_MODE: i32 = 420;

# `--name <id>`
val NAME: std_args.Flag = std_args.Flag{long: "name", short: 0, value: "id", repeat: false, negatable: false, help: "set the project identifier (default: the directory name)"};
# `--force`
val FORCE: std_args.Flag = std_args.Flag{long: "force", short: 0, value: nil, repeat: false, negatable: false, help: "scaffold over an existing mach.toml or src"};
# `--lib`
val LIB: std_args.Flag = std_args.Flag{long: "lib", short: 0, value: nil, repeat: false, negatable: false, help: "make a library project"};
# `--no-deps`
val NO_DEPS: std_args.Flag = std_args.Flag{long: "no-deps", short: 0, value: nil, repeat: false, negatable: false, help: "declare no dependency, so nothing is read from the network"};
# `--no-git`
val NO_GIT: std_args.Flag = std_args.Flag{long: "no-git", short: 0, value: nil, repeat: false, negatable: false, help: "skip Git initialization"};

# length of FLAGS
val FLAGS_N: usize = 8;
# the flags mach init takes
val FLAGS: [FLAGS_N]*std_args.Flag = [FLAGS_N]*std_args.Flag{?args.HELP, ?args.DIAGNOSTICS, ?NAME, ?FORCE, ?LIB, ?NO_DEPS, ?NO_GIT, ?args.QUIET};

# `mach init`
pub val COMMAND: std_args.Command = std_args.Command{name: "init", aliases: args.NO_WORDS, help: "create a project", usage: "[dir]", flags: Slice[*std_args.Flag]{data: ?FLAGS[0], size: FLAGS_N}, commands: args.NO_COMMANDS, operand_min: 0, operand_max: std_args.OPERANDS_ANY, passthrough: false};
# what mach holds `mach init` to beyond the parse
pub val POLICY: args.Policy = args.Policy{refused: args.NO_FLAGS, refusal: "", conflicts: args.NO_CONFLICTS};

# `mach init`: scaffold a project. the positional names the directory (default the working
# directory) and, unless `--name` is given, the project id: the directory's name, with each '-'
# written as '_' where the name is not a project id as written. an absent directory is created
# whole; an existing one is filled in, and `--force` allows overwriting mach.toml and the entry
# file. the entry is src/bin/main.mach and a bin artifact, or with `--lib` src/lib/<id>.mach and
# a static artifact. the std dependency's range is resolved before anything is written, and the
# release is checked out once the project is. `--no-deps` declares no dependency and reads nothing
# from the network. in git mode the project is made a repository unless it stands in one, and a
# `.gitignore` naming its work directory is written where none is. `--quiet` silences progress
# ---
# cx:  the call
# ret: exit.OK, or the failure: a user one for an invalid id or a refused overwrite, otherwise the
#      class of the failure that resolving, initializing git or checking out met
pub fun run(cx: *args.Call) res[i64, fail.Fail] {
    ret run_with(cx, ?SCAFFOLD_DEPS[0], SCAFFOLD_DEP_COUNT);
}

# `run` over an explicit scaffold dependency set
fun run_with(cx: *args.Call, deps: *ScaffoldDep, dep_count: usize) res[i64, fail.Fail] {
    val inv:     *std_args.Parsed = cx.inv;
    val a:       *A.Allocator     = cx.a;
    val force:   bool             = std_args.given(inv, ?FORCE);
    val is_lib:  bool             = std_args.given(inv, ?LIB);
    val no_deps: bool             = std_args.given(inv, ?NO_DEPS);
    val no_git:  bool             = std_args.given(inv, ?NO_GIT);
    val quiet:   bool             = std_args.given(inv, ?args.QUIET);

    val res_cwd: res[types_string.OwnedString, env.EnvError] = env.current_dir(a);
    if (sel res_cwd.err) { ret res[i64, fail.Fail].err{fail.refusal(a, diagnostic_kind.FS_CURRENT_DIR, fail.Op{verb: "read", role: "the working directory"}, fail.Cause.env{res_cwd.err})}; }
    var cwd_owned: types_string.OwnedString = res_cwd.ok;
    val cwd:       str                      = cwd_owned.data;

    var dir:       *u8 = cwd;
    var shown:     str = ".";
    val named_dir: *u8 = args.operand(inv, 0);
    if (named_dir != nil) {
        dir   = named_dir;
        shown = named_dir::str;
    }

    val res_named: res[Named, fail.Fail] = project_named(a, cwd, dir::str, args.value(inv, ?NAME));
    if (sel res_named.err) { ret res[i64, fail.Fail].err{res_named.err}; }
    val named: Named = res_named.ok;

    val res_entry: res[Entry, fail.Fail] = entry_of(a, named.id, is_lib);
    if (sel res_entry.err) { ret res[i64, fail.Fail].err{res_entry.err}; }
    var entry: Entry = res_entry.ok;

    val res_dest: res[str, fail.Fail] = destination_path(a, cwd, dir::str);
    if (sel res_dest.err) { ret res[i64, fail.Fail].err{res_dest.err}; }
    val dest:        str                  = res_dest.ok;
    val res_ignored: res[bool, fail.Fail] = scaffold_checked(a, dest, ?entry, force);
    if (sel res_ignored.err) { ret res[i64, fail.Fail].err{res_ignored.err}; }
    val ignore: bool = !no_git && res_ignored.ok;

    val res_text: res[str, fail.Fail] = build_manifest_text(a, named.id, is_lib, entry.path);
    if (sel res_text.err) { ret res[i64, fail.Fail].err{res_text.err}; }
    var text: str = res_text.ok;

    val res_init_in: res[session.Session, fail.Fail] = session.init_in(a, cx.report.sources);
    if (sel res_init_in.err) { ret res[i64, fail.Fail].err{res_init_in.err}; }
    var s: session.Session = res_init_in.ok;
    fin { session.dnit(?s); }
    s.environ = cx.environ;

    # every dependency is resolved before anything is written, so a failure leaves nothing behind
    var i: usize = 0;
    for (!no_deps && i < dep_count) {
        val dep: *ScaffoldDep = ?deps[i];
        i = i + 1;
        var spec:      manifest_edit.DepTableSpec = manifest_edit.DepTableSpec{name: dep.id, source: manifest_edit.DEP_SOURCE_GIT, value: dep.git, ref: "", version: ""};
        var rep:       report.Report              = cli_diagnostic.dependency_report(a, cx.report);
        val res_range: res[str, fail.Fail]        = package_edit.release_range(?s, a, dest, text, ?spec, quiet, ?rep);
        if (sel res_range.err) {
            val code: i64 = cli_diagnostic.dependency_outcome(?rep, err[fail.Fail].err{res_range.err});
            report.dnit(?rep);
            val res_hint: res[str, fail.Fail] = dep_hint(a, shown, dep);
            if (sel res_hint.err) { ret res[i64, fail.Fail].err{res_hint.err}; }
            val res_said: res[str, fail.Fail] = diagnostic.format(a,
                "project '{}' was not created, as no release of '{}' could be chosen. `mach init {} --no-deps` creates it, and then `{}` names a branch to take {} from",
                named.id, dep.id, shown, res_hint.ok, dep.id);
            if (sel res_said.err) { ret res[i64, fail.Fail].err{res_said.err}; }
            cli_diagnostic.report_fail(cx.report, fail.user(diagnostic_kind.DEP_ADD, res_said.ok), diagnostic.ORIGIN_NONE);
            ret res[i64, fail.Fail].ok{code};
        }
        report.dnit(?rep);
        spec.version = res_range.ok;
        val res_declared: res[str, fail.Fail] = manifest_edit.dep_table_add(a, text, ?spec);
        if (sel res_declared.err) { ret res[i64, fail.Fail].err{res_declared.err}; }
        text = res_declared.ok;
    }

    val err_written: err[fail.Fail] = scaffold_write(a, dest, text, is_lib, ?entry, ignore);
    if (sel err_written.err) { ret res[i64, fail.Fail].err{err_written.err}; }
    if (!quiet) {
        val res_created: res[str, fail.Fail] = created_note(a, ?named, no_deps && !is_lib, shown, ?entry, deps, dep_count);
        if (sel res_created.err) { ret res[i64, fail.Fail].err{res_created.err}; }
        cli_diagnostic.report_note(cx.report, diagnostic_kind.PROJECT_CREATED, res_created.ok);
    }

    if (!no_git) {
        val err_started: err[fail.Fail] = package_edit.start(?s, dest);
        if (sel err_started.err) {
            val code:     i64                 = cli_diagnostic.report_fail(cx.report, err_started.err, diagnostic.ORIGIN_NONE);
            val res_said: res[str, fail.Fail] = diagnostic.format(a, "project '{}' is complete, and no git repository was made for it", named.id);
            if (sel res_said.err) { ret res[i64, fail.Fail].err{res_said.err}; }
            cli_diagnostic.report_note(cx.report, diagnostic_kind.PROJECT_CREATED, res_said.ok);
            ret res[i64, fail.Fail].ok{code};
        }
    }
    if (no_deps) { ret res[i64, fail.Fail].ok{exit.OK}; }
    i = 0;
    for (i < dep_count) {
        val dep: *ScaffoldDep = ?deps[i];
        i = i + 1;
        var rep:   report.Report = cli_diagnostic.dependency_report(a, cx.report);
        val moved: i64           = cli_diagnostic.dependency_outcome(?rep, package_edit.update(?s, a, dest, false, dep.id, quiet, false, false, ?rep));
        report.dnit(?rep);
        if (moved != exit.OK) {
            val res_command: res[str, fail.Fail] = package_closure.pin_command(a, dest, dep.id);
            if (sel res_command.err) { ret res[i64, fail.Fail].err{res_command.err}; }
            val res_said: res[str, fail.Fail] = diagnostic.format(a,
                "project '{}' is complete and declares dependency '{}', which is not checked out. `{}` checks it out once the failure above is fixed", named.id, dep.id, res_command.ok);
            if (sel res_said.err) { ret res[i64, fail.Fail].err{res_said.err}; }
            # the failure reported above carries the class, and so the exit code
            cli_diagnostic.report_fail(cx.report, fail.user(diagnostic_kind.DEP_ADD, res_said.ok), diagnostic.ORIGIN_NONE);
            ret res[i64, fail.Fail].ok{moved};
        }
        if (quiet) { cnt; }
        val res_realized: res[str, fail.Fail] = diagnostic.format(a, "realized dependency '{}'", dep.id);
        if (sel res_realized.err) { ret res[i64, fail.Fail].err{res_realized.err}; }
        cli_diagnostic.report_note(cx.report, diagnostic_kind.DEP_REALIZED, res_realized.ok);
    }
    ret res[i64, fail.Fail].ok{exit.OK};
}

# the source directory a scaffold's manifest names
val SRC_DIR: str = "src";

# where a scaffold's entry lives, each path `/`-separated as a manifest spells it
# ---
# dir:   the directory holding it, under the project root
# path:  its path under the source directory, the artifact's `entry`
# label: its path under the project root
rec Entry {
    dir:   str;
    path:  str;
    label: str;
}

# the entry of a scaffold: src/bin/main.mach for a program, src/lib/<id>.mach for a library
fun entry_of(a: *A.Allocator, id: str, is_lib: bool) res[Entry, fail.Fail] {
    var res_path: res[str, std_format.FormatError] = std_format.sprint(a, "bin/main.mach");
    if (is_lib)           { res_path = std_format.sprint(a, "lib/{}.mach", id); }
    if (sel res_path.err) { ret res[Entry, fail.Fail].err{fail.format_refused(res_path.err)}; }
    var res_dir: res[str, std_format.FormatError] = std_format.sprint(a, "{}/bin", SRC_DIR);
    if (is_lib)          { res_dir = std_format.sprint(a, "{}/lib", SRC_DIR); }
    if (sel res_dir.err) { ret res[Entry, fail.Fail].err{fail.format_refused(res_dir.err)}; }
    val res_label: res[str, std_format.FormatError] = std_format.sprint(a, "{}/{}", SRC_DIR, res_path.ok);
    if (sel res_label.err) { ret res[Entry, fail.Fail].err{fail.format_refused(res_label.err)}; }
    ret res[Entry, fail.Fail].ok{Entry{dir: res_dir.ok, path: res_path.ok, label: res_label.ok}};
}

# a dependency every scaffold declares; it is added like `mach dep add <path> <id> --git <git>`,
# at the caret range of the release resolution picks for the running compiler
rec ScaffoldDep {
    id:  str;
    git: str;
}

val SCAFFOLD_DEP_COUNT: usize          = 1;
val SCAFFOLD_DEPS:      [1]ScaffoldDep = [1]ScaffoldDep{
    ScaffoldDep{id: "std", git: "https://github.com/briar-systems/mach-std"}
};

# a project's id, and the name of the directory it was made from when that name is not one
# ---
# id:   the project id
# from: the directory's name the id was made from, nil when the id is the name as written or
#       `--name` gave it
rec Named {
    id:   str;
    from: str;
}

# the project id: the one `--name` gives, else the destination's name, where each '-' is written
# as '_' when the name as written is not a project id, as a repository's name often is not
fun project_named(a: *A.Allocator, cwd: str, dir: str, opt_given: opt[*u8]) res[Named, fail.Fail] {
    if (sel opt_given.some) {
        val given: str = opt_given.some::str;
        if (manifest_schema.is_project_id(given)) { ret res[Named, fail.Fail].ok{Named{id: given, from: nil}}; }
        ret res[Named, fail.Fail].err{fail.formatted_user(a, diagnostic_kind.PROJECT_INVALID_ID, "--name '{}' is not a project id. {}", given, manifest_schema.PROJECT_ID_RULE)};
    }
    val res_base: res[str, fail.Fail] = default_project_id(a, cwd, dir);
    if (sel res_base.err) { ret res[Named, fail.Fail].err{res_base.err}; }
    val base: str = res_base.ok;
    if (manifest_schema.is_project_id(base)) { ret res[Named, fail.Fail].ok{Named{id: base, from: nil}}; }
    val res_copied: res[str, types_string.StrError] = types_string.str_copy_slice(a, base, 0, str_len(base));
    if (sel res_copied.err) { ret res[Named, fail.Fail].err{fail.str_refused(res_copied.err)}; }
    val made: *u8   = res_copied.ok::*u8;
    var k:    usize = 0;
    for (made[k] != 0) {
        if (made[k] == '-') { made[k] = '_'; }
        k = k + 1;
    }
    if (manifest_schema.is_project_id(made::str)) { ret res[Named, fail.Fail].ok{Named{id: made::str, from: base}}; }
    ret res[Named, fail.Fail].err{fail.formatted_user(a, diagnostic_kind.PROJECT_INVALID_ID,
        "the directory name '{}' cannot be made a project id. {}. name the project with --name <id>", base, manifest_schema.PROJECT_ID_RULE)};
}

# what `mach init` says of the project it wrote: its id and where the id came from, and when
# `undeclared` (a program made under `--no-deps`) that its entry uses dependencies it does not
# declare, with the command that declares each
fun created_note(a: *A.Allocator, named: *Named, undeclared: bool, root: str, entry: *Entry, deps: *ScaffoldDep, dep_count: usize) res[str, fail.Fail] {
    var res_said: res[str, fail.Fail] = diagnostic.format(a, "created project '{}'", named.id);
    if (named.from != nil) {
        res_said = diagnostic.format(a, "created project '{}', the directory name '{}' with each '-' written as '_', since a project id holds no '-'", named.id, named.from);
    }
    if (sel res_said.err) { ret res_said; }
    if (!undeclared)      { ret res_said; }
    var said: str   = res_said.ok;
    var i:    usize = 0;
    for (i < dep_count) {
        val res_hint: res[str, fail.Fail] = dep_hint(a, root, ?deps[i]);
        if (sel res_hint.err) { ret res_hint; }
        val res_more: res[str, fail.Fail] = diagnostic.format(a, "{}. {} uses {}, which it does not declare. `{}` declares it", said, entry.label, deps[i].id, res_hint.ok);
        if (sel res_more.err) { ret res_more; }
        said = res_more.ok;
        i    = i + 1;
    }
    ret res[str, fail.Fail].ok{said};
}

# the command that declares `dep` from a branch of its repository, the way to name a source
# while no release works with this compiler
fun dep_hint(a: *A.Allocator, root: str, dep: *ScaffoldDep) res[str, fail.Fail] {
    ret diagnostic.format(a, "mach dep add {} {} --git {} --ref branch/<name>", root, dep.id, dep.git);
}

# the destination, rooted at the working directory and cleaned
fun destination_path(alloc: *A.Allocator, cwd: str, dir: str) res[str, fail.Fail] {
    val res_joined: res[str, A.Error] = types_path.resolve(alloc, cwd, dir);
    if (sel res_joined.err) { ret res[str, fail.Fail].err{fail.refused(res_joined.err)}; }
    val res_cleaned: res[str, A.Error] = types_path.clean(alloc, res_joined.ok);
    str_free(alloc, res_joined.ok);
    if (sel res_cleaned.err) { ret res[str, fail.Fail].err{fail.refused(res_cleaned.err)}; }
    ret res[str, fail.Fail].ok{res_cleaned.ok};
}

val ENTRY_ABSENT:  u8 = 0;
val ENTRY_REGULAR: u8 = 1;
val ENTRY_DIR:     u8 = 2;
val ENTRY_OTHER:   u8 = 3;

fun probe(alloc: *A.Allocator, dest: str, rel: str) res[u8, fail.Fail] {
    val res_joined: res[str, A.Error] = types_path.join(alloc, dest, rel);
    if (sel res_joined.err) { ret res[u8, fail.Fail].err{fail.refused(res_joined.err)}; }
    val name: str = res_joined.ok;
    fin { str_free(alloc, name); }
    var st:     system_os.stat_t;
    val probed: i64 = system_os.stat_path(system_os.working_dir(), name, ?st, system_os.AT_SYMLINK_NOFOLLOW);
    if (system_os.error_kind(probed) == io_error.NOT_FOUND) { ret res[u8, fail.Fail].ok{ENTRY_ABSENT}; }
    if (probed < 0)                                         { ret res[u8, fail.Fail].err{fail.refusal(alloc, diagnostic_kind.FS_STAT, fail.Op{verb: "inspect", path: name}, fail.Cause.native{probed})}; }
    val kind: u32 = native.stat_mode(?st) & system_os.S_IFMT;
    if (kind == system_os.S_IFREG) { ret res[u8, fail.Fail].ok{ENTRY_REGULAR}; }
    if (kind == system_os.S_IFDIR) { ret res[u8, fail.Fail].ok{ENTRY_DIR}; }
    ret res[u8, fail.Fail].ok{ENTRY_OTHER};
}

# write one scaffold file through a sibling temporary and rename, so a
# forced overwrite of an existing file is whole or not at all
fun emit(alloc: *A.Allocator, dest: str, rel: str, text: str) err[fail.Fail] {
    val res_joined: res[str, A.Error] = types_path.join(alloc, dest, rel);
    if (sel res_joined.err) { ret err[fail.Fail].err{fail.refused(res_joined.err)}; }
    val name: str = res_joined.ok;
    fin { str_free(alloc, name); }
    ret output.replace(alloc, name, text::*u8, str_len(text), FILE_MODE);
}

fun not_dir_fail(a: *A.Allocator, label: str) fail.Fail {
    ret fail.formatted_user(a, diagnostic_kind.PROJECT_FILE_KIND, "'{}' exists and is not a directory", label);
}

fun exists_fail(a: *A.Allocator, label: *u8) fail.Fail {
    ret fail.formatted_user(a, diagnostic_kind.PROJECT_FILE_EXISTS, "'{}' already exists. --force replaces it", label::str);
}

fun not_regular_fail(a: *A.Allocator, label: *u8) fail.Fail {
    ret fail.formatted_user(a, diagnostic_kind.PROJECT_FILE_KIND, "'{}' exists and is not a regular file", label::str);
}

# an existing manifest or entry is refused without --force. every refusal comes before the first
# write, so a refused init changes nothing
# ---
# ret: whether the destination holds no `.gitignore`, which a project made in git mode gains
fun scaffold_checked(a: *A.Allocator, dest: str, entry: *Entry, force: bool) res[bool, fail.Fail] {
    val res_existing: res[u8, fail.Fail] = probe(a, dest, "");
    if (sel res_existing.err) { ret res[bool, fail.Fail].err{res_existing.err}; }
    if (res_existing.ok == ENTRY_REGULAR || res_existing.ok == ENTRY_OTHER) {
        ret res[bool, fail.Fail].err{fail.user(diagnostic_kind.PROJECT_FILE_KIND, "the destination exists and is not a directory")};
    }
    if (res_existing.ok == ENTRY_ABSENT) { ret res[bool, fail.Fail].ok{true}; }
    val res_manifest: res[u8, fail.Fail] = probe(a, dest, manifest_load.MANIFEST_FILE);
    if (sel res_manifest.err) { ret res[bool, fail.Fail].err{res_manifest.err}; }
    if (res_manifest.ok == ENTRY_DIR || res_manifest.ok == ENTRY_OTHER) {
        ret res[bool, fail.Fail].err{not_regular_fail(a, manifest_load.MANIFEST_FILE)};
    }
    if (res_manifest.ok == ENTRY_REGULAR && !force) {
        ret res[bool, fail.Fail].err{exists_fail(a, manifest_load.MANIFEST_FILE)};
    }
    val res_source: res[u8, fail.Fail] = probe(a, dest, SRC_DIR);
    if (sel res_source.err) { ret res[bool, fail.Fail].err{res_source.err}; }
    if (res_source.ok == ENTRY_REGULAR || res_source.ok == ENTRY_OTHER) {
        ret res[bool, fail.Fail].err{not_dir_fail(a, SRC_DIR)};
    }
    val res_dir: res[u8, fail.Fail] = probe(a, dest, entry.dir);
    if (sel res_dir.err) { ret res[bool, fail.Fail].err{res_dir.err}; }
    if (res_dir.ok == ENTRY_REGULAR || res_dir.ok == ENTRY_OTHER) {
        ret res[bool, fail.Fail].err{not_dir_fail(a, entry.dir)};
    }
    val res_entry: res[u8, fail.Fail] = probe(a, dest, entry.label);
    if (sel res_entry.err) { ret res[bool, fail.Fail].err{res_entry.err}; }
    if (res_entry.ok == ENTRY_DIR || res_entry.ok == ENTRY_OTHER) {
        ret res[bool, fail.Fail].err{not_regular_fail(a, entry.label)};
    }
    if (res_entry.ok == ENTRY_REGULAR && !force) {
        ret res[bool, fail.Fail].err{exists_fail(a, entry.label)};
    }
    val res_ignore: res[u8, fail.Fail] = probe(a, dest, GITIGNORE);
    if (sel res_ignore.err) { ret res[bool, fail.Fail].err{res_ignore.err}; }
    ret res[bool, fail.Fail].ok{res_ignore.ok == ENTRY_ABSENT};
}

# the ignore file a project made in git mode gains, which names the directory every build writes
# under. dep/ is left to git, as each checkout there is a submodule its pin records
val GITIGNORE: str = ".gitignore";

# the directory a scaffold's work directory stands in
val WORK_DIR: str = "out";

# write the project: its manifest `text`, its entry, and the ignore file when `ignore`
fun scaffold_write(a: *A.Allocator, dest: str, text: str, is_lib: bool, entry: *Entry, ignore: bool) err[fail.Fail] {
    val res_dir: res[str, A.Error] = types_path.join(a, dest, entry.dir);
    if (sel res_dir.err) { ret err[fail.Fail].err{fail.refused(res_dir.err)}; }
    val dir: str = res_dir.ok;
    fin { str_free(a, dir); }
    val err_made: err[fs.FsError] = fs.create_dir_all(a, dir, DIR_MODE);
    if (sel err_made.err) { ret err[fail.Fail].err{fail.refusal(a, diagnostic_kind.FS_CREATE, fail.Op{verb: "create directory", path: dir}, fail.Cause.fs{err_made.err})}; }
    val err_manifest_written: err[fail.Fail] = emit(a, dest, manifest_load.MANIFEST_FILE, text);
    if (sel err_manifest_written.err) { ret err_manifest_written; }
    val err_entry_written: err[fail.Fail] = emit(a, dest, entry.label, source_template(is_lib));
    if (sel err_entry_written.err) { ret err_entry_written; }
    if (!ignore)                   { ret err[fail.Fail].ok{}; }
    val res_ignored: res[str, fail.Fail] = diagnostic.join(a, "/", WORK_DIR, "/\n");
    if (sel res_ignored.err) { ret err[fail.Fail].err{res_ignored.err}; }
    ret emit(a, dest, GITIGNORE, res_ignored.ok);
}

# the targets a scaffold declares, as `mach info targets` spells them: the hosted platforms the
# toolchain ships to. mink's catalog states every other part of each
val TARGET_COUNT: usize             = 6;
val TARGETS:      [TARGET_COUNT]str = [TARGET_COUNT]str{"linux-x86_64", "linux-aarch64", "linux-riscv64", "darwin-x86_64", "darwin-aarch64", "windows-x86_64"};

fun build_manifest_text(a: *A.Allocator, id: str, is_lib: bool, entry: str) res[str, fail.Fail] {
    var buf: textbuild.TextBuilder = textbuild.tb_init(a);
    fin { textbuild.tb_dnit(?buf); }

    val res_caret: res[str, std_format.FormatError] = compile_closure.running_mach_range_floor(a);
    if (sel res_caret.err) { ret res[str, fail.Fail].err{fail.message(fail.format_text(res_caret.err))}; }
    buf_put(?buf, "[project]\n");
    put_string(?buf, "id", id);
    put_string(?buf, "version", "0.1.0");
    put_string(?buf, "mach", res_caret.ok);
    put_string(?buf, "src", SRC_DIR);
    val res_work: res[str, fail.Fail] = diagnostic.join(a, WORK_DIR, "/{target.name}/{profile.name}");
    if (sel res_work.err) { ret res[str, fail.Fail].err{res_work.err}; }
    put_string(?buf, "work", res_work.ok);
    str_free(a, res_caret.ok);

    var i: usize = 0;
    for (i < TARGET_COUNT) {
        val err_emitted: err[fail.Fail] = emit_target(a, ?buf, TARGETS[i]);
        if (sel err_emitted.err) { ret res[str, fail.Fail].err{err_emitted.err}; }
        i = i + 1;
    }

    var kind:    str                              = "bin";
    var res_out: res[str, std_format.FormatError] = std_format.sprint(a, "{{project.work}}/bin/{}{{artifact.suffix}}", id);
    if (is_lib) {
        kind    = "static";
        res_out = std_format.sprint(a, "{{project.work}}/lib/lib{}{{artifact.suffix}}", id);
    }
    if (sel res_out.err) { ret res[str, fail.Fail].err{fail.format_refused(res_out.err)}; }
    buf_put(?buf, "\n[artifact.");
    buf_put(?buf, id::*u8);
    buf_put(?buf, "]\n");
    put_string(?buf, "kind", kind);
    put_string(?buf, "entry", entry);
    put_string(?buf, "out", res_out.ok);
    str_free(a, res_out.ok);
    buf_put(?buf, "targets = [\"*\"]\n");
    # the scaffolded library is the one the project ships prebuilt
    if (is_lib) { buf_put(?buf, "export = true\n"); }

    buf_put(?buf, "\n[profile.debug]\n");
    buf_put(?buf, "default = true\n");
    buf_put(?buf, "optimize = false\n");
    buf_put(?buf, "debug = true\n");
    buf_put(?buf, "simd = \"scalarize\"\n");
    buf_put(?buf, "\n[profile.release]\n");
    buf_put(?buf, "optimize = true\n");
    buf_put(?buf, "debug = false\n");
    buf_put(?buf, "simd = \"scalarize\"\n");

    val res_made: res[str, textbuild.Error] = textbuild.tb_finish(?buf);
    if (sel res_made.err) { ret res[str, fail.Fail].err{fail.message(textbuild.text(res_made.err))}; }
    ret res[str, fail.Fail].ok{res_made.ok};
}

# a `[target.<spelling>]` table stating every part mink's catalog resolves the spelling to by
# default but the instruction set, which a hosted system's floor supplies when it is left out
fun emit_target(a: *A.Allocator, b: *textbuild.TextBuilder, spelling: str) err[fail.Fail] {
    val res_spec: res[mink_target.Spec, mink_fail.Fail] = mink_target.parse(spelling);
    if (sel res_spec.err) { ret err[fail.Fail].err{resolved.refused(a, diagnostic_kind.TARGET_UNSUPPORTED, res_spec.err)}; }
    var n:           mink_target.Narrowing                  = mink_target.UNNARROWED;
    val res_resolve: res[resolved.Target, resolved.Refused] = resolved.resolve(a, res_spec.ok, ?n, resolved.Image{base: 0, stack_reserve: 0, stack_commit: 0});
    if (sel res_resolve.err) { ret err[fail.Fail].err{res_resolve.err.why}; }
    var target: resolved.Target     = res_resolve.ok;
    val m:      *mink_target.Target = ?target.target;
    buf_put(b, "\n[target.");
    buf_put(b, spelling::*u8);
    buf_put(b, "]\n");
    put_string(b, "arch", m.arch.name);
    put_string(b, "sys ", m.sys.name);
    if (sel m.env.some) { put_string(b, "env ", m.env.some.name); }
    put_string(b, "abi ", resolved.abi_name(?target));
    ret err[fail.Fail].ok{};
}

# `<key> = "<value>"` and a newline, the value a TOML basic string
fun put_string(b: *textbuild.TextBuilder, key: str, value: str) {
    textbuild.tb_append(b, key);
    textbuild.tb_append(b, " = ");
    manifest_schema.toml_string(b, value);
    textbuild.tb_append(b, "\n");
}

fun source_template(is_lib: bool) str {
    if (is_lib) { ret ""; }
    ret BIN_SOURCE_TEMPLATE;
}

val BIN_SOURCE_TEMPLATE: str = "use std.print;\nuse std.runtime;\n\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i64 {\n    print.println(\"Hello, World!\");\n    ret 0;\n}\n";

# a failed append poisons the builder, which tb_finish reports
fun buf_put(b: *textbuild.TextBuilder, s: *u8) {
    textbuild.tb_append(b, s::str);
}

fun default_project_id(a: *A.Allocator, cwd: str, dir: str) res[str, fail.Fail] {
    val res_abs: res[str, A.Error] = types_path.resolve(a, cwd, dir);
    if (sel res_abs.err) { ret res[str, fail.Fail].err{fail.refused(res_abs.err)}; }
    val res_clean: res[str, A.Error] = types_path.clean(a, res_abs.ok);
    if (sel res_clean.err) { ret res[str, fail.Fail].err{fail.refused(res_clean.err)}; }
    ret res[str, fail.Fail].ok{types_path.filename(res_clean.ok)};
}
