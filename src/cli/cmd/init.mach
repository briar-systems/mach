val DIR_MODE:  i32 = 493;
val FILE_MODE: i32 = 420;

# `--name <id>`
val NAME: std_args.Flag = std_args.Flag{long: "name", short: 0, value: "id", repeat: false, negatable: false, help: "set the project identifier (default: the directory name)"};
# `--force`
val FORCE: std_args.Flag = std_args.Flag{long: "force", short: 0, value: nil, repeat: false, negatable: false, help: "scaffold over an existing mach.toml or src"};
# `--lib`
val LIB: std_args.Flag = std_args.Flag{long: "lib", short: 0, value: nil, repeat: false, negatable: false, help: "make a library project"};
# `--no-deps`
val NO_DEPS: std_args.Flag = std_args.Flag{long: "no-deps", short: 0, value: nil, repeat: false, negatable: false, help: "declare dependencies without checking them out"};
# `--no-git`
val NO_GIT: std_args.Flag = std_args.Flag{long: "no-git", short: 0, value: nil, repeat: false, negatable: false, help: "skip Git initialization"};

# length of FLAGS
val FLAGS_N: usize = 8;
# the flags mach init takes
val FLAGS: [FLAGS_N]*std_args.Flag = [FLAGS_N]*std_args.Flag{?args.HELP, ?args.DIAGNOSTICS, ?NAME, ?FORCE, ?LIB, ?NO_DEPS, ?NO_GIT, ?args.QUIET};

# `mach init`
pub val COMMAND: std_args.Command = std_args.Command{name: "init", aliases: args.NO_WORDS, help: "create a project", usage: "[dir]", flags: Slice[*std_args.Flag]{data: ?FLAGS[0], size: FLAGS_N}, commands: args.NO_COMMANDS, operand_min: 0, operand_max: std_args.OPERANDS_ANY, passthrough: false};
# what mach holds `mach init` to beyond the parse
pub val POLICY: args.Policy = args.Policy{refused: args.NO_FLAGS, refusal: "", conflicts: args.NO_CONFLICTS};

# `mach init`: scaffold a project. the positional names the directory (default the working
# directory) and, unless `--name` is given, the project id, which must be a portable
# identifier. an absent directory is created whole; an existing one is filled in, and
# `--force` allows overwriting mach.toml and the entry file. the entry is src/bin/main.mach and
# a bin artifact, or with `--lib` src/lib/<id>.mach and a static artifact. the std dependency
# is then added at the caret range of the release resolution picks and checked out, unless
# `--no-deps`, which still resolves the range (so needs the network) but skips the checkout.
# `--quiet` silences progress
# ---
# cx:  the call
# ret: exit.OK, or the failure: a user one for an invalid id or a refused overwrite, otherwise the
#      std dependency's own class when it could not be added
pub fun run(cx: *args.Call) res[i64, fail.Fail] {
    ret run_with(cx, ?SCAFFOLD_DEPS[0], SCAFFOLD_DEP_COUNT);
}

# `run` over an explicit scaffold dependency set
fun run_with(cx: *args.Call, deps: *ScaffoldDep, dep_count: usize) res[i64, fail.Fail] {
    val inv:     *std_args.Parsed = cx.inv;
    val a:       *A.Allocator     = cx.a;
    val force:   bool             = std_args.given(inv, ?FORCE);
    val is_lib:  bool             = std_args.given(inv, ?LIB);
    val no_deps: bool             = std_args.given(inv, ?NO_DEPS);
    val no_git:  bool             = std_args.given(inv, ?NO_GIT);
    val quiet:   bool             = std_args.given(inv, ?args.QUIET);

    val cwd_r: res[types_string.OwnedString, env.EnvError] = env.current_dir(a);
    if (sel cwd_r.err) { ret res[i64, fail.Fail].err{fail.refusal(a, diagnostic_kind.FS_CURRENT_DIR, fail.Op{verb: "read", role: "the working directory"}, fail.Cause.env{cwd_r.err})}; }
    var cwd_owned: types_string.OwnedString = cwd_r.ok;
    val cwd:       str                      = cwd_owned.data;

    var dir:       *u8 = cwd;
    val named_dir: *u8 = args.operand(inv, 0);
    if (named_dir != nil) { dir = named_dir; }

    val id_r: res[str, fail.Fail] = default_project_id(a, cwd, dir::str);
    if (sel id_r.err) { ret res[i64, fail.Fail].err{id_r.err}; }
    var id:    *u8      = id_r.ok;
    val named: opt[*u8] = args.value(inv, ?NAME);
    if (sel named.some) { id = named.some; }

    if (!manifest_schema.is_valid_id(id::str)) {
        ret res[i64, fail.Fail].err{fail.formatted_user(a, diagnostic_kind.PROJECT_INVALID_ID, "'{}' is not a valid project id: a project id may contain only letters, digits, '_', or '-' (no '.', '/', or spaces); pass a valid name as the argument or with --name <name>", id::str)};
    }

    val entry_r: res[Entry, fail.Fail] = entry_of(a, id::str, is_lib);
    if (sel entry_r.err) { ret res[i64, fail.Fail].err{entry_r.err}; }
    var entry: Entry = entry_r.ok;

    val dest_r: res[str, fail.Fail] = destination_path(a, cwd, dir::str);
    if (sel dest_r.err) { ret res[i64, fail.Fail].err{dest_r.err}; }
    val dest:       str            = dest_r.ok;
    val scaffolded: err[fail.Fail] = scaffold(a, dest, id, is_lib, ?entry, force, quiet);
    if (sel scaffolded.err) { ret res[i64, fail.Fail].err{scaffolded.err}; }
    ret dependency_stage(cx.report, a, dest, no_deps, no_git, quiet, deps, dep_count, cx.environ);
}

# the source directory a scaffold's manifest names
val SRC_DIR: str = "src";

# where a scaffold's entry lives, each path `/`-separated as a manifest spells it
# ---
# dir:   the directory holding it, under the project root
# path:  its path under the source directory, the artifact's `entry`
# label: its path under the project root
rec Entry {
    dir:   str;
    path:  str;
    label: str;
}

# the entry of a scaffold: src/bin/main.mach for a program, src/lib/<id>.mach for a library
fun entry_of(a: *A.Allocator, id: str, is_lib: bool) res[Entry, fail.Fail] {
    var path: res[str, std_format.FormatError] = std_format.sprint(a, "bin/main.mach");
    if (is_lib)       { path = std_format.sprint(a, "lib/{}.mach", id); }
    if (sel path.err) { ret res[Entry, fail.Fail].err{fail.format_refused(path.err)}; }
    var dir: res[str, std_format.FormatError] = std_format.sprint(a, "{}/bin", SRC_DIR);
    if (is_lib)      { dir = std_format.sprint(a, "{}/lib", SRC_DIR); }
    if (sel dir.err) { ret res[Entry, fail.Fail].err{fail.format_refused(dir.err)}; }
    val label: res[str, std_format.FormatError] = std_format.sprint(a, "{}/{}", SRC_DIR, path.ok);
    if (sel label.err) { ret res[Entry, fail.Fail].err{fail.format_refused(label.err)}; }
    ret res[Entry, fail.Fail].ok{Entry{dir: dir.ok, path: path.ok, label: label.ok}};
}

# a dependency every scaffold declares; it is added like `mach dep add <path> <id> --git <git>`,
# at the caret range of the release resolution picks for the running compiler
rec ScaffoldDep {
    id:  str;
    git: str;
}

val SCAFFOLD_DEP_COUNT: usize          = 1;
val SCAFFOLD_DEPS:      [1]ScaffoldDep = [1]ScaffoldDep{
    ScaffoldDep{id: "std", git: "https://github.com/briar-systems/mach-std"}
};

fun dependency_stage(r: *cli_diagnostic.Report, a: *A.Allocator, root: str, no_deps: bool, no_git: bool, quiet: bool, deps: *ScaffoldDep,
    dep_count: usize, environ: exec.Environment) res[i64, fail.Fail] {
    val sr: res[session.Session, fail.Fail] = session.init_in(a, r.sources);
    if (sel sr.err) { ret res[i64, fail.Fail].err{fail.prefixed(a, "failed to initialize project setup: ", sr.err)}; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    s.environ = environ;
    if (!no_git) {
        val started: err[fail.Fail] = package_edit.start(?s, root);
        if (sel started.err) { ret res[i64, fail.Fail].err{started.err}; }
    }
    var i: usize = 0;
    for (i < dep_count) {
        val dep: ScaffoldDep = deps[i];
        i = i + 1;
        var rep:   report.Report = cli_diagnostic.dependency_report(a, s.sources);
        val added: i64           = cli_diagnostic.dependency_outcome(?rep, package_edit.add_release(?s, a, root, dep.id, dep.git, quiet, !no_deps, ?rep));
        report.dnit(?rep);
        if (added != exit.OK) {
            var msg_r: res[str, std_format.FormatError];
            if (no_deps) {
                msg_r = std_format.sprint(a,
                    "dependency '{}' has no resolved release; --no-deps skips only the checkout, resolving its range still needs the network. run `mach dep add <path> {} --git {}` for project '{}' once connected",
                    dep.id, dep.id, dep.git, root);
            }
            or {
                msg_r = std_format.sprint(a,
                    "dependency '{}' could not be added; run `mach dep add <path> {} --git {}` for project '{}' once the problem above is fixed", dep.id, dep.id, dep.git, root);
            }
            var said: str = "a declared dependency could not be added";
            if (sel msg_r.ok) { said = msg_r.ok; }
            # the failure reported above carries the class, and so the exit code
            cli_diagnostic.report_fail(r, fail.user(diagnostic_kind.DEP_ADD, said), diagnostic.ORIGIN_NONE);
            ret res[i64, fail.Fail].ok{added};
        }
        if (quiet) { cnt; }
        if (no_deps) {
            val hint: res[str, fail.Fail] = no_deps_hint(a, root, dep.id);
            if (sel hint.err) { ret res[i64, fail.Fail].err{hint.err}; }
            print.eprintlnf("{}", hint.ok);
        }
        or { print.eprintlnf("realized dependency '{}'", dep.id); }
    }
    ret res[i64, fail.Fail].ok{exit.OK};
}

# what --no-deps prints for a dependency it declared: the command that pins it, which is the
# one `mach dep pull` names when it refuses an unpinned version selection
fun no_deps_hint(a: *A.Allocator, root: str, id: str) res[str, fail.Fail] {
    val command: res[str, fail.Fail] = package_closure.pin_command(a, root, id);
    if (sel command.err) { ret command; }
    ret diagnostic.format(a, "declared dependency '{}' without a checkout; run `{}` to pin and realize it", id, command.ok);
}

# the destination, rooted at the working directory and cleaned
fun destination_path(alloc: *A.Allocator, cwd: str, dir: str) res[str, fail.Fail] {
    val joined: res[str, A.Error] = types_path.resolve(alloc, cwd, dir);
    if (sel joined.err) { ret res[str, fail.Fail].err{fail.refused(joined.err)}; }
    val cleaned: res[str, A.Error] = types_path.clean(alloc, joined.ok);
    str_free(alloc, joined.ok);
    if (sel cleaned.err) { ret res[str, fail.Fail].err{fail.refused(cleaned.err)}; }
    ret res[str, fail.Fail].ok{cleaned.ok};
}

val ENTRY_ABSENT:  u8 = 0;
val ENTRY_REGULAR: u8 = 1;
val ENTRY_DIR:     u8 = 2;
val ENTRY_OTHER:   u8 = 3;

fun probe(alloc: *A.Allocator, dest: str, rel: str) res[u8, fail.Fail] {
    val joined: res[str, A.Error] = types_path.join(alloc, dest, rel);
    if (sel joined.err) { ret res[u8, fail.Fail].err{fail.refused(joined.err)}; }
    val name: str = joined.ok;
    fin { str_free(alloc, name); }
    var st:     system_os.stat_t;
    val probed: i64 = system_os.stat_path(system_os.working_dir(), name, ?st, system_os.AT_SYMLINK_NOFOLLOW);
    if (system_os.error_kind(probed) == io_error.NOT_FOUND) { ret res[u8, fail.Fail].ok{ENTRY_ABSENT}; }
    if (probed < 0)                                         { ret res[u8, fail.Fail].err{fail.refusal(alloc, diagnostic_kind.FS_STAT, fail.Op{verb: "inspect", path: name}, fail.Cause.native{probed})}; }
    val kind: u32 = native.stat_mode(?st) & system_os.S_IFMT;
    if (kind == system_os.S_IFREG) { ret res[u8, fail.Fail].ok{ENTRY_REGULAR}; }
    if (kind == system_os.S_IFDIR) { ret res[u8, fail.Fail].ok{ENTRY_DIR}; }
    ret res[u8, fail.Fail].ok{ENTRY_OTHER};
}

# write one scaffold file through a sibling temporary and rename, so a
# forced overwrite of an existing file is whole or not at all
fun emit(alloc: *A.Allocator, dest: str, rel: str, text: str) err[fail.Fail] {
    val joined: res[str, A.Error] = types_path.join(alloc, dest, rel);
    if (sel joined.err) { ret err[fail.Fail].err{fail.refused(joined.err)}; }
    val name: str = joined.ok;
    fin { str_free(alloc, name); }
    ret output.replace(alloc, name, text::*u8, str_len(text), FILE_MODE);
}

fun not_dir_fail(a: *A.Allocator, label: str) fail.Fail {
    ret fail.formatted_user(a, diagnostic_kind.PROJECT_FILE_KIND, "'{}' exists and is not a directory", label);
}

fun exists_fail(a: *A.Allocator, label: *u8) fail.Fail {
    ret fail.formatted_user(a, diagnostic_kind.PROJECT_FILE_EXISTS, "'{}' already exists (use --force to replace it)", label::str);
}

fun not_regular_fail(a: *A.Allocator, label: *u8) fail.Fail {
    ret fail.formatted_user(a, diagnostic_kind.PROJECT_FILE_KIND, "'{}' exists and is not a regular file", label::str);
}

# an existing manifest or entry is refused without --force; every refusal
# comes before the first write, so a refused init changes nothing
fun scaffold_checked(a: *A.Allocator, dest: str, id: *u8, is_lib: bool, entry: *Entry, force: bool) res[i64, fail.Fail] {
    val existing: res[u8, fail.Fail] = probe(a, dest, "");
    if (sel existing.err) { ret res[i64, fail.Fail].err{existing.err}; }
    if (existing.ok == ENTRY_REGULAR || existing.ok == ENTRY_OTHER) {
        ret res[i64, fail.Fail].err{fail.user(diagnostic_kind.PROJECT_FILE_KIND, "the destination exists and is not a directory")};
    }
    if (existing.ok == ENTRY_DIR) {
        val manifest_r: res[u8, fail.Fail] = probe(a, dest, manifest_load.MANIFEST_FILE);
        if (sel manifest_r.err) { ret res[i64, fail.Fail].err{manifest_r.err}; }
        if (manifest_r.ok == ENTRY_DIR || manifest_r.ok == ENTRY_OTHER) {
            ret res[i64, fail.Fail].err{not_regular_fail(a, manifest_load.MANIFEST_FILE)};
        }
        if (manifest_r.ok == ENTRY_REGULAR && !force) {
            ret res[i64, fail.Fail].err{exists_fail(a, manifest_load.MANIFEST_FILE)};
        }
        val source_r: res[u8, fail.Fail] = probe(a, dest, SRC_DIR);
        if (sel source_r.err) { ret res[i64, fail.Fail].err{source_r.err}; }
        if (source_r.ok == ENTRY_REGULAR || source_r.ok == ENTRY_OTHER) {
            ret res[i64, fail.Fail].err{not_dir_fail(a, SRC_DIR)};
        }
        val dir_r: res[u8, fail.Fail] = probe(a, dest, entry.dir);
        if (sel dir_r.err) { ret res[i64, fail.Fail].err{dir_r.err}; }
        if (dir_r.ok == ENTRY_REGULAR || dir_r.ok == ENTRY_OTHER) {
            ret res[i64, fail.Fail].err{not_dir_fail(a, entry.dir)};
        }
        val entry_r: res[u8, fail.Fail] = probe(a, dest, entry.label);
        if (sel entry_r.err) { ret res[i64, fail.Fail].err{entry_r.err}; }
        if (entry_r.ok == ENTRY_DIR || entry_r.ok == ENTRY_OTHER) {
            ret res[i64, fail.Fail].err{not_regular_fail(a, entry.label)};
        }
        if (entry_r.ok == ENTRY_REGULAR && !force) {
            ret res[i64, fail.Fail].err{exists_fail(a, entry.label)};
        }
    }
    val text_r: res[str, fail.Fail] = build_manifest_text(a, id::str, is_lib, entry.path);
    if (sel text_r.err) { ret res[i64, fail.Fail].err{text_r.err}; }
    val text: str = text_r.ok;
    fin { str_free(a, text); }
    val dir_r: res[str, A.Error] = types_path.join(a, dest, entry.dir);
    if (sel dir_r.err) { ret res[i64, fail.Fail].err{fail.refused(dir_r.err)}; }
    val dir: str = dir_r.ok;
    fin { str_free(a, dir); }
    val made: err[fs.FsError] = fs.create_dir_all(a, dir, DIR_MODE);
    if (sel made.err) { ret res[i64, fail.Fail].err{fail.refusal(a, diagnostic_kind.FS_CREATE, fail.Op{verb: "create directory", path: dir}, fail.Cause.fs{made.err})}; }
    val manifest_written: err[fail.Fail] = emit(a, dest, manifest_load.MANIFEST_FILE, text);
    if (sel manifest_written.err) { ret res[i64, fail.Fail].err{manifest_written.err}; }
    val entry_written: err[fail.Fail] = emit(a, dest, entry.label, source_template(is_lib));
    if (sel entry_written.err) { ret res[i64, fail.Fail].err{entry_written.err}; }
    ret res[i64, fail.Fail].ok{exit.OK};
}

fun scaffold(a: *A.Allocator, dest: str, id: *u8, is_lib: bool, entry: *Entry, force: bool, quiet: bool) err[fail.Fail] {
    val result: res[i64, fail.Fail] = scaffold_checked(a, dest, id, is_lib, entry, force);
    if (sel result.err) { ret err[fail.Fail].err{result.err}; }
    if (!quiet) {
        print.eprint("created project '");
        print.eprint(id::str);
        print.eprint("'\n");
    }
    ret err[fail.Fail].ok{};
}

# the targets a scaffold declares, as `mach info targets` spells them: the hosted platforms the
# toolchain ships to. mink's catalog states every other part of each
val TARGET_COUNT: usize             = 6;
val TARGETS:      [TARGET_COUNT]str = [TARGET_COUNT]str{"linux-x86_64", "linux-aarch64", "linux-riscv64", "darwin-x86_64", "darwin-aarch64", "windows-x86_64"};

fun build_manifest_text(a: *A.Allocator, id: str, is_lib: bool, entry: str) res[str, fail.Fail] {
    var buf: textbuild.TextBuilder = textbuild.tb_init(a);
    fin { textbuild.tb_dnit(?buf); }

    val caret: res[str, std_format.FormatError] = driver_closure.running_mach_range_floor(a);
    if (sel caret.err) { ret res[str, fail.Fail].err{fail.message(fail.format_text(caret.err))}; }
    buf_put(?buf, "[project]\n");
    put_string(?buf, "id", id);
    put_string(?buf, "version", "0.1.0");
    put_string(?buf, "mach", caret.ok);
    put_string(?buf, "src", SRC_DIR);
    put_string(?buf, "work", "out/{target.name}/{profile.name}");
    str_free(a, caret.ok);

    var i: usize = 0;
    for (i < TARGET_COUNT) {
        val emitted: err[fail.Fail] = emit_target(a, ?buf, TARGETS[i]);
        if (sel emitted.err) { ret res[str, fail.Fail].err{emitted.err}; }
        i = i + 1;
    }

    var kind: str                              = "bin";
    var out:  res[str, std_format.FormatError] = std_format.sprint(a, "{{project.work}}/bin/{}{{artifact.suffix}}", id);
    if (is_lib) {
        kind = "static";
        out  = std_format.sprint(a, "{{project.work}}/lib/lib{}{{artifact.suffix}}", id);
    }
    if (sel out.err) { ret res[str, fail.Fail].err{fail.format_refused(out.err)}; }
    buf_put(?buf, "\n[artifact.");
    buf_put(?buf, id::*u8);
    buf_put(?buf, "]\n");
    put_string(?buf, "kind", kind);
    put_string(?buf, "entry", entry);
    put_string(?buf, "out", out.ok);
    str_free(a, out.ok);
    buf_put(?buf, "targets = [\"*\"]\n");
    # the scaffolded library is the one the project ships prebuilt
    if (is_lib) { buf_put(?buf, "export = true\n"); }

    buf_put(?buf, "\n[profile.debug]\n");
    buf_put(?buf, "default = true\n");
    buf_put(?buf, "optimize = false\n");
    buf_put(?buf, "debug = true\n");
    buf_put(?buf, "simd = \"scalarize\"\n");
    buf_put(?buf, "\n[profile.release]\n");
    buf_put(?buf, "optimize = true\n");
    buf_put(?buf, "debug = false\n");
    buf_put(?buf, "simd = \"scalarize\"\n");

    val made: res[str, textbuild.Error] = textbuild.tb_finish(?buf);
    if (sel made.err) { ret res[str, fail.Fail].err{fail.message(textbuild.text(made.err))}; }
    ret res[str, fail.Fail].ok{made.ok};
}

# a `[target.<spelling>]` table stating every part mink's catalog resolves the spelling to by
# default, the instruction set its host's floor
fun emit_target(a: *A.Allocator, b: *textbuild.TextBuilder, spelling: str) err[fail.Fail] {
    val spec: res[mink_target.Spec, mink_fail.Fail] = mink_target.parse(spelling);
    if (sel spec.err) { ret err[fail.Fail].err{resolved.refused(a, diagnostic_kind.TARGET_UNSUPPORTED, spec.err)}; }
    var n: mink_target.Narrowing                  = mink_target.UNNARROWED;
    val t: res[resolved.Target, resolved.Refused] = resolved.resolve(a, spec.ok, ?n, resolved.Image{base: 0, stack_reserve: 0, stack_commit: 0});
    if (sel t.err) { ret err[fail.Fail].err{t.err.why}; }
    var target: resolved.Target     = t.ok;
    val m:      *mink_target.Target = ?target.target;
    buf_put(b, "\n[target.");
    buf_put(b, spelling::*u8);
    buf_put(b, "]\n");
    put_string(b, "arch", m.arch.name);
    put_string(b, "isa ", resolved.isa(?target));
    put_string(b, "sys ", m.sys.name);
    if (sel m.env.some) { put_string(b, "env ", m.env.some.name); }
    put_string(b, "abi ", resolved.abi_name(?target));
    ret err[fail.Fail].ok{};
}

# `<key> = "<value>"` and a newline, the value a TOML basic string
fun put_string(b: *textbuild.TextBuilder, key: str, value: str) {
    textbuild.tb_append(b, key);
    textbuild.tb_append(b, " = ");
    manifest_schema.toml_string(b, value);
    textbuild.tb_append(b, "\n");
}

fun source_template(is_lib: bool) str {
    if (is_lib) { ret ""; }
    ret BIN_SOURCE_TEMPLATE;
}

val BIN_SOURCE_TEMPLATE: str = "use std.print;\nuse std.runtime;\n\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i64 {\n    print.println(\"Hello, World!\");\n    ret 0;\n}\n";

# a failed append poisons the builder, which tb_finish reports
fun buf_put(b: *textbuild.TextBuilder, s: *u8) {
    textbuild.tb_append(b, s::str);
}

fun default_project_id(a: *A.Allocator, cwd: str, dir: str) res[str, fail.Fail] {
    val abs_r: res[str, A.Error] = types_path.resolve(a, cwd, dir);
    if (sel abs_r.err) { ret res[str, fail.Fail].err{fail.refused(abs_r.err)}; }
    val clean_r: res[str, A.Error] = types_path.clean(a, abs_r.ok);
    if (sel clean_r.err) { ret res[str, fail.Fail].err{fail.refused(clean_r.err)}; }
    ret res[str, fail.Fail].ok{types_path.filename(clean_r.ok)};
}
