    if (str_empty(scaffold_abi(?reg, "linux", isa.ARCH_AARCH64))) { ret 1; }
    if (str_empty(scaffold_abi(?reg, "linux", isa.ARCH_RISCV64))) { ret 1; }
    ret 0;
}

fun t_scratch_dir(alloc: *A.Allocator, prefix: str) res[str, outcome.Fail] {
    val tf_r: res[fs.TempFile, fs.FsError] = fs.temp_create(alloc, prefix);
    if (sel tf_r.err) { ret res[str, outcome.Fail].err{outcome.user(outcome.fs_text(tf_r.err))}; }
    var tf: fs.TempFile = tf_r.ok;
    val root_r: res[str, string.StrError] = str_copy_slice(alloc, fs.temp_path(?tf), 0, str_len(fs.temp_path(?tf)));
    fs.temp_close_and_remove(?tf);
    if (sel root_r.err) { ret res[str, outcome.Fail].err{outcome.user(outcome.str_text(root_r.err))}; }
    val root: str = root_r.ok;
    val create_dir_r: err[io_error.Error] = fs.create_dir(root, 0o755);
    if (sel create_dir_r.err) { ret res[str, outcome.Fail].err{outcome.user("cannot create scratch root")}; }
    ret res[str, outcome.Fail].ok{root};
}

fun t_read_file(alloc: *A.Allocator, path: str) opt[str] {
    val rb: res[Vector[u8], fs.FsError] = fs.read_bytes(alloc, path);
    if (sel rb.err) { ret opt[str].none{}; }
    var v: Vector[u8] = rb.ok;
    val rr: res[str, string.StrError] = str_copy_slice(alloc, v.data::str, 0, v.len);
    vector.dnit[u8](?v);
    if (sel rr.err) { ret opt[str].none{}; }
    ret opt[str].some{rr.ok};
}

test "mach.cli.cmd.init.split_for_discovery:relative_stays_under_cwd_absolute_uses_filesystem_root" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var bad: i32 = 0;

    val rel_r: res[DestSplit, outcome.Fail] = split_for_discovery(?alloc, "/home/x", "myproj");
    if (sel rel_r.err) { bad = 1; }
    if (sel rel_r.ok) {
        val ds: DestSplit = rel_r.ok;
        fin { str_free(?alloc, ds.root); str_free(?alloc, ds.dest_rel); }
        if (!str_equals(ds.root, "/home/x") || !str_equals(ds.dest_rel, "myproj")) { bad = 1; }
    }

    val dotrel_r: res[DestSplit, outcome.Fail] = split_for_discovery(?alloc, "/home/x", "./myproj");
    if (sel dotrel_r.err) { bad = 1; }
    if (sel dotrel_r.ok) {
        val ds: DestSplit = dotrel_r.ok;
        fin { str_free(?alloc, ds.root); str_free(?alloc, ds.dest_rel); }
        if (!str_equals(ds.dest_rel, "myproj")) { bad = 1; }
    }

    val abs_r: res[DestSplit, outcome.Fail] = split_for_discovery(?alloc, "/home/x", "/tmp/other/myproj");
    if (sel abs_r.err) { bad = 1; }
    if (sel abs_r.ok) {
        val ds: DestSplit = abs_r.ok;
        fin { str_free(?alloc, ds.root); str_free(?alloc, ds.dest_rel); }
        var expected_root: str = "/";
        $if ($mach.build.os == $mach.os.windows) { expected_root = "\\"; }
        if (!str_equals(ds.root, expected_root) || !str_equals(ds.dest_rel, "tmp/other/myproj")) { bad = 1; }
    }

    val dot_r: res[DestSplit, outcome.Fail] = split_for_discovery(?alloc, "/home/x", ".");
    if (sel dot_r.err) { bad = 1; }
    if (sel dot_r.ok) {
        val ds: DestSplit = dot_r.ok;
        fin { str_free(?alloc, ds.root); str_free(?alloc, ds.dest_rel); }
        if (!str_empty(ds.dest_rel) && !str_equals(ds.dest_rel, ".")) { bad = 1; }
    }

    ret bad;
}

test "mach.cli.cmd.init.split_for_discovery:native_roots_and_canonical_relative_components" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var cwd: str = "/work";
    var root: str = "/";
    $if ($mach.build.os == $mach.os.windows) { cwd = "C:\\work"; root = "\\"; }
    var inputs: [9]str;
    var roots: [9]str;
    var relatives: [9]str;
    inputs[0] = "nested/./proj"; roots[0] = cwd; relatives[0] = "nested/proj";
    inputs[1] = "."; roots[1] = cwd; relatives[1] = "";
    inputs[2] = "/"; roots[2] = root; relatives[2] = "";
    var count: usize = 3;
    $if ($mach.build.os == $mach.os.windows) {
        inputs[3] = "D:\\nested\\proj"; roots[3] = "D:\\"; relatives[3] = "nested/proj";
        inputs[4] = "D:/nested/../proj"; roots[4] = "D:\\"; relatives[4] = "proj";
        inputs[5] = "\\\\server\\share\\nested\\proj"; roots[5] = "\\\\server\\share"; relatives[5] = "nested/proj";
        inputs[6] = "D:\\"; roots[6] = "D:\\"; relatives[6] = "";
        inputs[7] = "nested\\child/../proj"; roots[7] = cwd; relatives[7] = "nested/proj";
        inputs[8] = "//server/share"; roots[8] = "\\\\server\\share"; relatives[8] = "";
        count = 9;
    }
    var i: usize = 0;
    for (i < count) {
        val r: res[DestSplit, outcome.Fail] = split_for_discovery(?alloc, cwd, inputs[i]);
        if (sel r.err) { ret 2; }
        val ds: DestSplit = r.ok;
        fin { str_free(?alloc, ds.root); str_free(?alloc, ds.dest_rel); }
        if (!str_equals(ds.root, roots[i])) { ret 10 + i::i32; }
        if (!str_equals(ds.dest_rel, relatives[i])) { ret 30 + i::i32; }
        i = i + 1;
    }
    ret 0;
}

