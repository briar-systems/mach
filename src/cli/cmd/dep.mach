test update__the_roots_exact_selector_repins_an_identity_realized_at_a_dependencys_commit {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val fix_b: str = t_tagged_b(?a);
    if (str_empty(fix_b)) { ret 1; }
    val fix_a: str = t_requirer_of_b(?a, "mach_dep_fix_a", "a", fix_b, "branch/main", true);
    if (str_empty(fix_a)) { ret 1; }
    val proj: str = t_root_repo(?a, "mach_dep_update_root", t_dep_table(?a, "a", fix_a));
    if (str_empty(proj)) { ret 1; }
    var bad: i32 = 0;
    if (pull_project(proj, true, git.t_file_transport_environ()) != 0) { bad = 1; }
    if (bad == 0 && !t_commit_all(?a, proj))                           { bad = 2; }
    var s:    session.Session;
    var mode: u8 = 0;
    if (!t_session_and_mode(?a, proj, ?s, ?mode)) { ret 1; }
    val dep_b_r: res[str, A.Error] = types_path.join(?a, proj, "dep/b");
    if (sel dep_b_r.err) { ret 1; }
    val dep_b:    str                 = dep_b_r.ok;
    val before_r: res[str, fail.Fail] = git_checkout.revision(?s, dep_b);
    if (sel before_r.err) { ret 99; }
    val override_r: res[str, std_format.FormatError] = std_format.sprint(?a,
        "[project]\nmach = \">=5\"\nid = \"root\"\nversion = \"0.1.0\"\nsrc = \"src\"\nout = \"out\"\n\n[target.host]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[artifact.root]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/root\"\ntargets = [\"*\"]\nlink = []\nneed = []\n{}{}\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n",
        t_dep_table(?a, "a", fix_a), t_dep_table_ref(?a, "b", fix_b, "tag/v1.0.0"));
    if (sel override_r.err)                                      { ret 1; }
    if (bad == 0 && !t_write(?a, proj, MANIFEST, override_r.ok)) { bad = 4; }
    var v1: str = "";
    if (bad == 0 && !t_git3(?a, dep_b, "checkout", "-q", "v1.0.0", "", "")) { bad = 5; }
    if (bad == 0) {
        val v1_r: res[str, fail.Fail] = git_checkout.revision(?s, dep_b);
        if (sel v1_r.err) { bad = 5; }
        if (sel v1_r.ok)  { v1 = v1_r.ok; }
    }
    if (bad == 0 && !t_git3(?a, dep_b, "checkout", "-q", "main", "", "")) { bad = 5; }
    if (bad == 0 && sel before_r.ok && str_equals(v1, before_r.ok))       { bad = 5; }
    if (bad == 0) {
        var edit:  package_edit.Edit;
        val txn_r: err[fail.Fail] = t_begin(?edit, ?a, proj);
        if (sel txn_r.err) { bad = 6; }
        if (sel txn_r.ok) {
            var upd_closure: Vector[package_closure.Request] = collections_vector.init[package_closure.Request](?a);
            val applied:     i64                             = t_update(?s, ?a, proj, mode, false, "b"::*u8, true, false, false, ?upd_closure, nil);
            if (t_finish(?edit, applied) != 0) { bad = 7; }
        }
    }
    if (bad == 0) {
        val after_r: res[str, fail.Fail] = git_checkout.revision(?s, dep_b);
        if (sel after_r.err)                                 { ret 99; }
        if (!(sel after_r.ok && str_equals(after_r.ok, v1))) { bad = 8; }
        val staged_r: res[opt[str], fail.Fail] = git_gitlink.read(?s, proj, "b");
        if (sel staged_r.err) { bad = 9; }
        if (sel staged_r.ok) {
            if (sel staged_r.ok.none) { bad = 9; }
            if (sel staged_r.ok.some) {
                if (sel after_r.ok && !str_equals(staged_r.ok.some, after_r.ok)) { bad = 9; }
            }
        }
        if (verify_project(proj, false, git.t_file_transport_environ()) != 0) { bad = 10; }
    }
    session.dnit(?s);
    fs.remove_all(?a, proj);
    fs.remove_all(?a, fix_a);
    fs.remove_all(?a, fix_b);
    ret bad;
}

# the refusal verify reports for a project, or "" when it verifies
#[testing]
fun t_verify_refusal(a: *A.Allocator, root: str) str {
    var s:    session.Session;
    var mode: u8 = 0;
    if (!t_session_and_mode(a, root, ?s, ?mode)) { ret ""; }
    fin { session.dnit(?s); }
    val vr: err[fail.Fail] = package_verify.dependencies(?s, root, false, nil);
    if (sel vr.ok) { ret ""; }
    ret package_closure.own(a, fail.describe(vr.err));
}

# run the `mach dep update ...` remedy a refusal names, with `<path>` as root
#[testing]
fun t_run_remedy(a: *A.Allocator, refusal: str, root: str) i64 {
    val at: opt[str] = str_find(refusal, "run `mach dep update ");
    if (sel at.none) { ret -1; }
    var buf:   [128]u8;
    var av:    [8]*u8;
    var n:     usize = 0;
    var k:     usize = 0;
    val src:   str   = (?at.some[5])::str;
    var fresh: bool  = true;
    for (src[k] != 0 && src[k] != '`' && k < 127) {
        if (src[k] == ' ') {
            buf[k] = 0;
            fresh  = true;
        }
        or {
            buf[k] = src[k];
            if (fresh) {
                if (n == 8) { ret -1; }
                av[n] = ?buf[k];
                n     = n + 1;
                fresh = false;
            }
        }
        k = k + 1;
    }
    buf[k] = 0;
    if (n != 5 || !str_equals(av[3]::str, "<path>")) { ret -1; }
    av[3] = root::*u8;
    ret t_dep_cli(a, n, ?av[0]);
}

test update__the_remedy_verify_prints_for_a_stale_transitive_checkout_repins_it {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val fix_b: str = t_tagged_b(?a);
    if (str_empty(fix_b)) { ret 2; }
    fin { fs.remove_all(?a, fix_b); }
    val fix_a: str = t_requirer_of_b(?a, "mach_dep_fix_a", "a", fix_b, "tag/v1.0.0", false);
    if (str_empty(fix_a)) { ret 3; }
    fin { fs.remove_all(?a, fix_a); }
    val proj: str = t_root_repo(?a, "mach_dep_remedy_root", t_dep_table(?a, "a", fix_a));
    if (str_empty(proj)) { ret 4; }
    fin { fs.remove_all(?a, proj); }
    if (pull_project(proj, true, git.t_file_transport_environ()) != 0 || !t_commit_all(?a, proj)) { ret 5; }
    val pinned: str = t_head_under(?a, proj, "dep/b");
    if (str_empty(pinned)) { ret 6; }
    val dep_b: str = t_join_owned(?a, proj, "dep/b");
    if (!t_git3(?a, dep_b, "checkout", "-q", "v2.0.0", "", "")) { ret 7; }
    if (!t_git3(?a, proj, "add", "dep/b", "", "", ""))          { ret 7; }
    val refusal: str = t_verify_refusal(?a, proj);
    if (!t_contains(refusal, "exact ref 'tag/v1.0.0' required by root -> a -> b")) { ret 8; }
    if (!t_contains(refusal, "run `mach dep update <path> b`"))                    { ret 9; }
    if (t_run_remedy(?a, refusal, proj) != 0)                                      { ret 10; }
    if (!str_equals(t_head_under(?a, proj, "dep/b"), pinned))                      { ret 11; }
    if (verify_project(proj, false, git.t_file_transport_environ()) != 0)          { ret 12; }
    ret 0;
}

test update__a_root_declared_name_moves_only_its_selector_and_all_keeps_an_exact_pin {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val fix_b: str = t_tagged_b(?a);
    if (str_empty(fix_b)) { ret 2; }
    fin { fs.remove_all(?a, fix_b); }
    val fix_a: str = t_requirer_of_b(?a, "mach_dep_fix_a", "a", fix_b, "tag/v1.0.0", false);
    if (str_empty(fix_a)) { ret 3; }
    fin { fs.remove_all(?a, fix_a); }
    val proj: str = t_root_repo(?a, "mach_dep_update_declared", t_dep_table(?a, "a", fix_a));
    if (str_empty(proj)) { ret 4; }
    fin { fs.remove_all(?a, proj); }
    if (pull_project(proj, true, git.t_file_transport_environ()) != 0 || !t_commit_all(?a, proj)) { ret 5; }
    val a_before: str = t_head_under(?a, proj, "dep/a");
    val b_before: str = t_head_under(?a, proj, "dep/b");
    if (str_empty(a_before) || str_empty(b_before)) { ret 6; }

    if (!t_write(?a, fix_a, "NEWS", "second\n") || !t_commit_all(?a, fix_a)) { ret 7; }
    if (t_dep_cli_edit(?a, "update", proj, "a", "") != 0)                    { ret 8; }
    val a_named: str = t_head_under(?a, proj, "dep/a");
    if (str_empty(a_named) || str_equals(a_named, a_before))              { ret 9; }
    if (!str_equals(t_head_under(?a, proj, "dep/b"), b_before))           { ret 10; }
    if (verify_project(proj, false, git.t_file_transport_environ()) != 0) { ret 11; }

    if (!t_write(?a, fix_a, "NEWS", "third\n") || !t_commit_all(?a, fix_a)) { ret 12; }
    var av: [6]*u8;
    av[0] = "mach"::*u8;
    av[1] = "dep"::*u8;
    av[2] = "update"::*u8;
    av[3] = proj::*u8;
    av[4] = "--all"::*u8;
    av[5] = "--quiet"::*u8;
    if (t_dep_cli(?a, 6, ?av[0]) != 0) { ret 13; }
    val a_all: str = t_head_under(?a, proj, "dep/a");
    if (str_empty(a_all) || str_equals(a_all, a_named))                   { ret 14; }
    if (!str_equals(t_head_under(?a, proj, "dep/b"), b_before))           { ret 15; }
    if (verify_project(proj, false, git.t_file_transport_environ()) != 0) { ret 16; }
    ret 0;
}

# a requirer that moves its exact selector of b is resolved against b's manifest at the commit
# it now names, not the stale checkout, and `--all` moves the transitive pin there
test update__a_moved_transitive_selector_resolves_from_the_commit_it_names {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val vb: str = t_released(?a);
    if (str_empty(vb)) { ret 2; }
    fin { fs.remove_all(?a, vb); }
    val fix_b: str = t_package_repo(?a, "mach_dep_moved_b", "b", t_dep_table_range(?a, "vb", vb, "<1.1"));
    if (str_empty(fix_b)) { ret 3; }
    fin { fs.remove_all(?a, fix_b); }
    val old_b:      str                 = t_head_under(?a, fix_b, ".");
    val b_manifest: res[str, fail.Fail] = t_read_under(?a, fix_b, MANIFEST);
    if (str_empty(old_b))                                                                                                 { ret 4; }
    if (sel b_manifest.err)                                                                                               { ret 4; }
    if (!t_write(?a, fix_b, MANIFEST, str_replace_first(?a, b_manifest.ok, "<1.1", ">=1.1")) || !t_commit_all(?a, fix_b)) { ret 5; }
    val new_b: str = t_head_under(?a, fix_b, ".");
    if (str_empty(new_b)) { ret 6; }

    val selects: res[str, std_format.FormatError] = std_format.sprint(?a, "commit/{}", old_b);
    if (sel selects.err) { ret 7; }
    val tables: res[str, std_format.FormatError] = std_format.sprint(?a, "{}{}",
        t_dep_table_ref(?a, "b", fix_b, selects.ok), t_dep_table_range(?a, "vb", vb, "=1.0.0"));
    if (sel tables.err) { ret 8; }
    val req: str = t_package_repo(?a, "mach_dep_moved_req", "req", tables.ok);
    if (str_empty(req)) { ret 9; }
    fin { fs.remove_all(?a, req); }
    val root: str = t_root_repo(?a, "mach_dep_moved_root", t_dep_table_path(?a, "req", req));
    if (str_empty(root)) { ret 10; }
    fin { fs.remove_all(?a, root); }
    var up: [3]str = [3]str{"update", root, "--all"};
    if (t_dep_cli_args(?a, ?up[0], 3) != 0 || !t_commit_all(?a, root)) { ret 11; }
    if (!str_equals(t_head_under(?a, root, "dep/b"), old_b))           { ret 12; }

    # the requirer now selects the commit whose manifest admits vb 1.1.0
    val req_manifest: res[str, fail.Fail] = t_read_under(?a, req, MANIFEST);
    if (sel req_manifest.err) { ret 13; }
    val moved: str = str_replace_first(?a, str_replace_first(?a, req_manifest.ok, old_b, new_b), "=1.0.0", "=1.1.0");
    if (!t_write(?a, req, MANIFEST, moved))                               { ret 14; }
    if (t_dep_cli_args(?a, ?up[0], 3) != 0)                               { ret 15; }
    if (!str_equals(t_head_under(?a, root, "dep/b"), new_b))              { ret 16; }
    if (!t_release_is(?a, root, "dep/vb", "1.1.0"))                       { ret 17; }
    if (verify_project(root, false, git.t_file_transport_environ()) != 0) { ret 18; }
    ret 0;
}

test update__a_name_outside_the_closure_is_refused {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val fix_b: str = t_tagged_b(?a);
    if (str_empty(fix_b)) { ret 2; }
    fin { fs.remove_all(?a, fix_b); }
    val fix_a: str = t_requirer_of_b(?a, "mach_dep_fix_a", "a", fix_b, "tag/v1.0.0", false);
    if (str_empty(fix_a)) { ret 3; }
    fin { fs.remove_all(?a, fix_a); }
    val proj: str = t_root_repo(?a, "mach_dep_update_outside", t_dep_table(?a, "a", fix_a));
    if (str_empty(proj)) { ret 4; }
    fin { fs.remove_all(?a, proj); }
    if (pull_project(proj, true, git.t_file_transport_environ()) != 0 || !t_commit_all(?a, proj)) { ret 5; }
    val before_r: res[str, fail.Fail] = t_read_under(?a, proj, MANIFEST);
    if (sel before_r.err) { ret 6; }
    # a stray directory under dep/ does not put its name in the closure
    val ghost: str             = t_join_owned(?a, proj, "dep/ghost");
    val mkdir: err[fs.FsError] = fs.create_dir_all(?a, ghost, 0o755);
    if (sel mkdir.err)                                        { ret 7; }
    if (t_dep_cli_edit(?a, "update", proj, "nope", "") != 1)  { ret 8; }
    if (t_dep_cli_edit(?a, "update", proj, "ghost", "") != 1) { ret 9; }
    val after_r: res[str, fail.Fail] = t_read_under(?a, proj, MANIFEST);
    if (sel after_r.err)                      { ret 10; }
    if (!str_equals(before_r.ok, after_r.ok)) { ret 11; }
    ret 0;
}

#[testing]
fun t_head_under(a: *A.Allocator, root: str, rel: str) str {
    var s:    session.Session;
    var mode: u8 = 0;
    if (!t_session_and_mode(a, root, ?s, ?mode)) { ret ""; }
    fin { session.dnit(?s); }
    val head_r: res[str, fail.Fail] = git_checkout.revision(?s, t_join_owned(a, root, rel));
    if (sel head_r.err) { ret ""; }
    ret package_closure.own(a, head_r.ok);
}

test add__a_discovered_clash_retains_native_changes_and_releases_the_manifest_editor {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val fix_b: str = t_tagged_b(?a);
    if (str_empty(fix_b)) { ret 1; }
    val fix_a: str = t_requirer_of_b(?a, "mach_dep_fix_a", "a", fix_b, "tag/v1.0.0", false);
    if (str_empty(fix_a)) { ret 1; }
    val fix_c: str = t_requirer_of_b(?a, "mach_dep_fix_c", "c", fix_b, "tag/v2.0.0", false);
    if (str_empty(fix_c)) { ret 1; }
    val proj: str = t_root_repo(?a, "mach_dep_clash_root", t_dep_table(?a, "a", fix_a));
    if (str_empty(proj)) { ret 1; }
    var bad: i32 = 0;
    if (pull_project(proj, true, git.t_file_transport_environ()) != 0) { bad = 1; }
    if (bad == 0 && !t_commit_all(?a, proj))                           { bad = 2; }
    var s:    session.Session;
    var mode: u8 = 0;
    if (!t_session_and_mode(?a, proj, ?s, ?mode)) { ret 1; }
    var spec: manifest.DepTableSpec;
    spec.name   = "c";
    spec.source = manifest.DEP_SOURCE_GIT;
    spec.value  = fix_c;
    spec.ref    = "branch/main";
    val before: TxnSnapshot = t_snapshot(?s, ?a, proj, "c");
    var edit:   package_edit.Edit;
    if (bad == 0) {
        val begun: err[fail.Fail] = t_begin(?edit, ?a, proj);
        if (sel begun.err) {
            t_finish(?edit, 1);
            bad = 3;
        }
        if (sel begun.ok) {
            val applied: i64 = t_apply(?edit, ?s, ?a, proj, mode, ?spec, "c", true, false, true, true, false, nil);
            if (t_finish(?edit, applied) == 0) { bad = 3; }
        }
    }
    val after: TxnSnapshot = t_snapshot(?s, ?a, proj, "c");
    if (bad == 0 && (!after.realized || !str_equals(before.manifest_text, after.manifest_text))) { bad = 4; }
    if (bad == 0) {
        val begun: err[fail.Fail] = t_begin(?edit, ?a, proj);
        if (sel begun.err) {
            t_finish(?edit, 1);
            bad = 5;
        }
        if (sel begun.ok) {
            if (t_finish(?edit, 0) != 0) { bad = 5; }
        }
    }
    if (bad == 0 && !t_contains(after.pin, "dep/c"))              { bad = 6; }
    if (bad == 0 && !t_exists_under(?a, proj, "dep/a/mach.toml")) { bad = 7; }
    session.dnit(?s);
    fs.remove_all(?a, proj);
    fs.remove_all(?a, fix_a);
    fs.remove_all(?a, fix_c);
    fs.remove_all(?a, fix_b);
    ret bad;
}

# the build refusal text of a dependency-shaped failure, or "" when the build succeeds
#[testing]
fun t_build_refusal(s: *session.Session, root: str) str {
    val setup_registry_r: err[fail.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) { ret ""; }
    var pick: manifest.Selection;
    pick.target       = "";
    pick.profile      = "";
    pick.artifact     = "";
    pick.want_lib     = false;
    pick.has_artifact = false;
    val pr: res[project.Project, fail.Fail] = driver.build_project_sel(s, root, ?pick);
    if (sel pr.err) { ret fail.describe(pr.err); }
    var p: project.Project = pr.ok;
    project.dnit_project(?p);
    ret "";
}

# a realized dep/<id>/dep/<x>/ is refused by verify, while git's empty gitlink
# directory passes; the build reads the root's dep/ and builds either
test verify__a_nested_realization_is_refused_and_an_empty_gitlink_directory_is_not {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val fix_b: str = t_tagged_b(?a);
    if (str_empty(fix_b)) { ret 1; }
    val fix_a: str = t_requirer_of_b(?a, "mach_dep_fix_a", "a", fix_b, "branch/main", true);
    if (str_empty(fix_a)) { ret 1; }
    val proj: str = t_root_repo(?a, "mach_dep_nested_root", "");
    if (str_empty(proj)) { ret 1; }
    var s:    session.Session;
    var mode: u8 = 0;
    if (!t_session_and_mode(?a, proj, ?s, ?mode)) { ret 1; }
    var bad:  i32 = 0;
    var spec: manifest.DepTableSpec;
    spec.name   = "a";
    spec.source = manifest.DEP_SOURCE_GIT;
    spec.value  = fix_a;
    spec.ref    = "branch/main";
    var edit:  package_edit.Edit;
    val txn_r: err[fail.Fail] = t_begin(?edit, ?a, proj);
    if (sel txn_r.err) { bad = 1; }
    if (sel txn_r.ok) {
        val applied: i64 = t_apply(?edit, ?s, ?a, proj, mode, ?spec, "a", true, false, true, true, false, nil);
        if (t_finish(?edit, applied) != 0) { bad = 2; }
    }
    # the consumed dependency's own gitlink is an empty directory: not a realization
    if (bad == 0 && !t_exists_under(?a, proj, "dep/a/dep/b"))                         { bad = 3; }
    if (bad == 0 && t_exists_under(?a, proj, "dep/a/dep/b/mach.toml"))                { bad = 4; }
    if (bad == 0 && verify_project(proj, false, git.t_file_transport_environ()) != 0) { bad = 5; }
    if (bad == 0) {
        val nested_dir: str = t_join_owned(?a, proj, "dep/a/dep/b");
        if (!t_write(?a, nested_dir, MANIFEST, "[project]\nmach = \">=5\"\nid = \"b\"\nversion = \"0.1.0\"\nsrc = \"src\"\nout = \"out\"\n[profile.debug]\nopt = 0\ndebug = false\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n")) { bad = 6; }
    }
    if (bad == 0 && verify_project(proj, false, git.t_file_transport_environ()) == 0) { bad = 7; }
    if (bad == 0) {
        val refusal: str = t_verify_refusal(?a, proj);
        if (!t_contains(refusal, "dep/a/dep/b is a nested realization"))                            { bad = 8; }
        if (!t_contains(refusal, "a dependency's own dep/ is never realized, so delete dep/a/dep")) { bad = 9; }
        if (!t_build_ok(?s, proj))                                                                  { bad = 13; }
    }
    if (bad == 0) {
        val removed: err[io_error.Error] = fs.remove_file(t_join_owned(?a, proj, "dep/a/dep/b/mach.toml"));
        if (sel removed.err) { bad = 10; }
    }
    if (bad == 0 && verify_project(proj, false, git.t_file_transport_environ()) != 0) { bad = 11; }
    if (bad == 0 && !t_build_ok(?s, proj))                                            { bad = 12; }
    session.dnit(?s);
    fs.remove_all(?a, proj);
    fs.remove_all(?a, fix_a);
    fs.remove_all(?a, fix_b);
    ret bad;
}

# a dep key that is not the project's id is refused by pull and verify, naming the
# one-name rule; the build reads what exists
test pull__an_alias_key_is_refused_naming_the_one_name_rule {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val source: str = t_scratch(?a, "mach_dep_alias_source");
    if (str_empty(source)) { ret 2; }
    fin { fs.remove_all(?a, source); }
    if (!t_write(?a, source, MANIFEST, "[project]\nmach = \">=5\"\nid = \"local\"\nversion = \"0.1.0\"\nsrc = \"src\"\nout = \"out\"\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n") || !t_lib_module(?a, source)) { ret 3; }
    val table: str = t_dep_table_path(?a, "alias", source);
    if (str_empty(table)) { ret 4; }
    val root: str = t_root_repo(?a, "mach_dep_alias_root", table);
    if (str_empty(root)) { ret 5; }
    fin { fs.remove_all(?a, root); }
    var s:    session.Session;
    var mode: u8 = 0;
    if (!t_session_and_mode(?a, root, ?s, ?mode)) { ret 6; }
    fin { session.dnit(?s); }
    if (pull_project(root, true, git.t_file_transport_environ()) == 0) { ret 7; }
    # pull rolled the refused realization back; a hand-realized dep/alias is refused
    # by verify all the same
    val realized: str             = t_join_owned(?a, root, "dep/alias");
    val mkdir_r:  err[fs.FsError] = fs.create_dir_all(?a, realized, 0o755);
    if (sel mkdir_r.err)                                                                                                                                                                                                                                                                                                                                                                                     { ret 8; }
    if (!t_write(?a, realized, MANIFEST, "[project]\nmach = \">=5\"\nid = \"local\"\nversion = \"0.1.0\"\nsrc = \"src\"\nout = \"out\"\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n") || !t_lib_module(?a, realized)) { ret 8; }
    if (verify_project(root, false, git.t_file_transport_environ()) == 0)                                                                                                                                                                                                                                                                                                                                    { ret 9; }
    val refusal: str = t_verify_refusal(?a, root);
    if (!t_contains(refusal, "[dep.alias] realizes project 'local': the manifest key, the directory under dep/, and the project id are one name")) { ret 10; }
    if (!t_contains(refusal, "rename the table to [dep.local] and the directory to dep/local"))                                                    { ret 11; }
    ret 0;
}

#[testing]
fun t_read_under(a: *A.Allocator, root: str, rel: str) res[str, fail.Fail] {
    val joined: res[str, A.Error] = types_path.join(a, root, rel);
    if (sel joined.err) { ret res[str, fail.Fail].err{fail.refused(joined.err)}; }
    val full: str = joined.ok;
    fin { str_free(a, full); }
    val read_string_r: res[str, fs.FsError] = fs.read_string(a, full);
    if (sel read_string_r.err) { ret res[str, fail.Fail].err{fail.user(diagnostic_kind.FS_READ, fail.fs_text(read_string_r.err))}; }
    ret res[str, fail.Fail].ok{read_string_r.ok};
}

#[testing]
fun t_project_history_unchanged(s: *session.Session, a: *A.Allocator, root: str,
    head: str, head_ref: str, head_log: str, branch_log: str, staged_user: str) bool {
    val actual_head_r: res[str, fail.Fail] = git_checkout.revision(s, root);
    if (sel actual_head_r.err) { ret false; }
    val actual_head: str = actual_head_r.ok;
    fin { str_free(a, actual_head); }
    if (!str_equals(head, actual_head)) { ret false; }
    val actual_ref_r: res[str, fail.Fail] = t_read_under(a, root, ".git/HEAD");
    if (sel actual_ref_r.err) { ret false; }
    val actual_ref: str = actual_ref_r.ok;
    fin { str_free(a, actual_ref); }
    if (!str_equals(head_ref, actual_ref)) { ret false; }
    val actual_log_r: res[str, fail.Fail] = t_read_under(a, root, ".git/logs/HEAD");
    if (sel actual_log_r.err) { ret false; }
    val actual_log: str = actual_log_r.ok;
    fin { str_free(a, actual_log); }
    if (!str_equals(head_log, actual_log)) { ret false; }
    val branch_r: res[str, fail.Fail] = t_read_under(a, root, ".git/logs/refs/heads/main");
    if (sel branch_r.err) { ret false; }
    val actual_branch: str = branch_r.ok;
    fin { str_free(a, actual_branch); }
    if (!str_equals(branch_log, actual_branch)) { ret false; }
    val actual_stage_r: res[str, fail.Fail] = git_gitlink.staged_paths(s, root, "user-history");
    if (sel actual_stage_r.err) { ret false; }
    val actual_stage: str = actual_stage_r.ok;
    fin { str_free(a, actual_stage); }
    if (!str_equals(staged_user, actual_stage)) { ret false; }
    val work_r: res[str, fail.Fail] = t_read_under(a, root, "user-history");
    if (sel work_r.err) { ret false; }
    val work: str = work_r.ok;
    fin { str_free(a, work); }
    ret str_equals(work, "unstaged user data\n");
}

test remove__native_lock_failure_and_success_preserve_checkout_and_project_history {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val fixture: str = t_package_repo(?a, "mach_dep_remove_source", "x", "");
    if (str_empty(fixture)) { ret 2; }
    fin { fs.remove_all(?a, fixture); }
    val root: str = t_root_repo(?a, "mach_dep_remove_root", "");
    if (str_empty(root)) { ret 3; }
    fin { fs.remove_all(?a, root); }
    if (!t_write(?a, root, "user-history", "committed user data\n") || !t_commit_all(?a, root)) { ret 4; }
    if (!t_write(?a, root, "user-history", "staged user data\n") ||
        !t_git3(?a, root, "add", "--", "user-history", "", "") ||
        !t_write(?a, root, "user-history", "unstaged user data\n")) { ret 5; }
    var s:    session.Session;
    var mode: u8 = 0;
    if (!t_session_and_mode(?a, root, ?s, ?mode)) { ret 6; }
    fin { session.dnit(?s); }
    val head_r: res[str, fail.Fail] = git_checkout.revision(?s, root);
    if (sel head_r.err) { ret 7; }
    val head: str = head_r.ok;
    fin { str_free(?a, head); }
    val ref_r:    res[str, fail.Fail] = t_read_under(?a, root, ".git/HEAD");
    val log_r:    res[str, fail.Fail] = t_read_under(?a, root, ".git/logs/HEAD");
    val branch_r: res[str, fail.Fail] = t_read_under(?a, root, ".git/logs/refs/heads/main");
    val staged_r: res[str, fail.Fail] = git_gitlink.staged_paths(?s, root, "user-history");
    if (sel ref_r.err)    { ret 20; }
    if (sel log_r.err)    { ret 20; }
    if (sel branch_r.err) { ret 20; }
    if (sel staged_r.err) { ret 20; }
    val head_ref:    str = ref_r.ok;
    val head_log:    str = log_r.ok;
    val branch_log:  str = branch_r.ok;
    val staged_user: str = staged_r.ok;
    fin {
        str_free(?a, head_ref);
        str_free(?a, head_log);
        str_free(?a, branch_log);
        str_free(?a, staged_user);
    }
    if (str_empty(head_ref) || str_empty(head_log) || str_empty(branch_log) || str_empty(staged_user)) { ret 21; }
    var spec: manifest.DepTableSpec;
    spec.name   = "x";
    spec.source = manifest.DEP_SOURCE_GIT;
    spec.value  = fixture;
    spec.ref    = "branch/main";
    var edit: package_edit.Edit;
    var av:   [10]*u8;
    av[0] = "mach"::*u8;
    av[1] = "dep"::*u8;
    av[2] = "add"::*u8;
    av[3] = root::*u8;
    av[4] = "x"::*u8;
    av[5] = "--git"::*u8;
    av[6] = fixture::*u8;
    av[7] = "--ref"::*u8;
    av[8] = "branch/main"::*u8;
    av[9] = "--quiet"::*u8;
    if (t_dep_cli(?a, 10, ?av[0]) != 0)                                                                { ret 23; }
    if (!t_project_history_unchanged(?s, ?a, root, head, head_ref, head_log, branch_log, staged_user)) { ret 24; }
    val added_state: TxnSnapshot = t_snapshot(?s, ?a, root, "x");
    if (!t_contains(added_state.manifest_text, "[dep.x]") || !t_contains(added_state.pin, "dep/x")) { ret 25; }
    if (!t_write(?a, fixture, "NEWS", "new dependency revision\n") || !t_commit_all(?a, fixture))   { ret 26; }
    av[2] = "update"::*u8;
    av[5] = "--quiet"::*u8;
    if (t_dep_cli(?a, 6, ?av[0]) != 0)                                                                 { ret 28; }
    if (!t_project_history_unchanged(?s, ?a, root, head, head_ref, head_log, branch_log, staged_user)) { ret 29; }
    val before: TxnSnapshot = t_snapshot(?s, ?a, root, "x");
    if (str_equals(added_state.pin, before.pin))                         { ret 30; }
    if (!t_write(?a, root, "dep/x/user-work", "untracked work stays\n")) { ret 31; }
    if (!t_write(?a, root, ".git/index.lock", "foreign native owner\n")) { ret 8; }
    val edit_begin_r: err[fail.Fail] = t_begin(?edit, ?a, root);
    if (sel edit_begin_r.err) {
        t_finish(?edit, 1);
        ret 9;
    }
    val refused: i64 = t_apply(?edit, ?s, ?a, root, mode, ?spec, "x", false, false, true, true, false, nil);
    if (t_finish(?edit, refused) == 0) { ret 10; }
    val after: TxnSnapshot = t_snapshot(?s, ?a, root, "x");
    if (!t_snapshot_equal(?before, ?after) || !t_exists_under(?a, root, "dep/x/user-work")) { ret 11; }
    val lock_r: res[str, A.Error] = types_path.join(?a, root, ".git/index.lock");
    if (sel lock_r.err) { ret 12; }
    val lock_path: str  = lock_r.ok;
    var present:   bool = false;
    if (!str_equals(t_read_or_empty(?a, lock_path, ?present), "foreign native owner\n")) { ret 13; }
    val remove_file_r: err[io_error.Error] = fs.remove_file(lock_path);
    if (sel remove_file_r.err) { ret 14; }
    av[2] = "remove"::*u8;
    if (t_dep_cli(?a, 6, ?av[0]) != 0) { ret 16; }
    val finished: TxnSnapshot = t_snapshot(?s, ?a, root, "x");
    if (t_contains(finished.manifest_text, "[dep.x]") || t_contains(finished.pin, "dep/x"))            { ret 17; }
    if (!t_exists_under(?a, root, "dep/x/user-work") || !t_exists_under(?a, root, "dep/x/.git"))       { ret 18; }
    if (!t_project_history_unchanged(?s, ?a, root, head, head_ref, head_log, branch_log, staged_user)) { ret 19; }
    ret 0;
}

test update__checkout_refusal_preserves_user_edits_and_late_failure_keeps_completed_checkout {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val fixture: str = t_tagged_b(?a);
    if (str_empty(fixture)) { ret 2; }
    fin { fs.remove_all(?a, fixture); }
    val root: str = t_root_repo(?a, "mach_dep_update_native", t_dep_table_ref(?a, "b", fixture, "tag/v1.0.0"));
    if (str_empty(root)) { ret 3; }
    fin { fs.remove_all(?a, root); }
    if (pull_project(root, true, git.t_file_transport_environ()) != 0 || !t_commit_all(?a, root)) { ret 4; }
    var s:    session.Session;
    var mode: u8 = 0;
    if (!t_session_and_mode(?a, root, ?s, ?mode)) { ret 5; }
    fin { session.dnit(?s); }
    val dep_r: res[str, fail.Fail] = package.dep_full_of(?a, root, "b");
    if (sel dep_r.err) { ret 6; }
    val dep:        str                 = dep_r.ok;
    val original_r: res[str, fail.Fail] = git_checkout.revision(?s, dep);
    if (sel original_r.err) { ret 7; }
    val original: str = original_r.ok;
    val source:   str = package_closure.concat3(?a, "[project]\nmach = \">=5\"\nid = \"root\"\nversion = \"0.1.0\"\nsrc = \"src\"\nout = \"out\"\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n", "", t_dep_table_ref(?a, "b", fixture, "tag/v2.0.0"));
    if (!t_write(?a, root, MANIFEST, source) || !t_write(?a, dep, "NEWS", "untracked user content\n")) { ret 8; }
    val before:       TxnSnapshot    = t_snapshot(?s, ?a, root, "b");
    var edit:         package_edit.Edit;
    val edit_begin_r: err[fail.Fail] = t_begin(?edit, ?a, root);
    if (sel edit_begin_r.err) {
        t_finish(?edit, 1);
        ret 9;
    }
    var upd_closure: Vector[package_closure.Request] = collections_vector.init[package_closure.Request](?a);
    val refused:     i64                             = t_update(?s, ?a, root, mode, false, "b", true, false, false, ?upd_closure, nil);
    if (t_finish(?edit, refused) != 3) { ret 10; }
    val after: TxnSnapshot = t_snapshot(?s, ?a, root, "b");
    if (!t_snapshot_equal(?before, ?after)) { ret 11; }
    val news_r: res[str, A.Error] = types_path.join(?a, dep, "NEWS");
    if (sel news_r.err) { ret 12; }
    val news:    str  = news_r.ok;
    var present: bool = false;
    if (!str_equals(t_read_or_empty(?a, news, ?present), "untracked user content\n")) { ret 13; }
    val remove_file_r: err[io_error.Error] = fs.remove_file(news);
    if (sel remove_file_r.err) { ret 14; }
    val edit_begin_r2: err[fail.Fail] = t_begin(?edit, ?a, root);
    if (sel edit_begin_r2.err) {
        t_finish(?edit, 1);
        ret 15;
    }
    var late_closure: Vector[package_closure.Request] = collections_vector.init[package_closure.Request](?a);
    # a failure once the checkout moved, before its pin is recorded, keeps the checkout and the old pin
    var refused_pin: Refusal = t_refuse(T_PIN_RECORDED, 0, fail.environment(diagnostic_kind.GIT_COMMAND, "the pin is refused"));
    val late:        i64     = t_update(?s, ?a, root, mode, false, "b", true, false, false, ?late_closure, ?refused_pin);
    if (t_finish(?edit, late) != exit.ENVIRONMENT) { ret 16; }
    val changed_r: res[str, fail.Fail] = git_checkout.revision(?s, dep);
    if (sel changed_r.err)                  { ret 17; }
    if (str_equals(original, changed_r.ok)) { ret 17; }
    val completed: TxnSnapshot = t_snapshot(?s, ?a, root, "b");
    if (!str_equals(before.pin, completed.pin) || !str_equals(before.manifest_text, completed.manifest_text)) { ret 18; }
    ret 0;
}

test path__unstaged_filesystem_dependency_builds_without_source_git {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val source: str = t_scratch(?a, "mach_dep_path_source");
    if (str_empty(source)) { ret 2; }
    fin { fs.remove_all(?a, source); }
    if (!t_write(?a, source, MANIFEST, "[project]\nmach = \">=5\"\nid = \"local\"\nversion = \"0.1.0\"\nsrc = \"src\"\nout = \"out\"\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n") || !t_lib_module(?a, source)) { ret 3; }
    val root: str = t_root_repo(?a, "mach_dep_path_root", "");
    if (str_empty(root)) { ret 4; }
    fin { fs.remove_all(?a, root); }
    var s:    session.Session;
    var mode: u8 = 0;
    if (!t_session_and_mode(?a, root, ?s, ?mode)) { ret 5; }
    fin { session.dnit(?s); }
    var spec: manifest.DepTableSpec;
    spec.name   = "local";
    spec.source = manifest.DEP_SOURCE_PATH;
    spec.value  = source;
    var edit:         package_edit.Edit;
    val edit_begin_r: err[fail.Fail] = t_begin(?edit, ?a, root);
    if (sel edit_begin_r.err) {
        t_finish(?edit, 1);
        ret 6;
    }
    val applied: i64 = t_apply(?edit, ?s, ?a, root, mode, ?spec, "local", true, false, true, true, false, nil);
    if (t_finish(?edit, applied) != 0) { ret 7; }
    val staged: res[str, fail.Fail] = git_gitlink.staged_paths(?s, root, "dep/local");
    if (sel staged.err)                                                                            { ret 8; }
    if (!str_empty(staged.ok))                                                                     { ret 8; }
    if (verify_project(root, false, git.t_file_transport_environ()) != 0 || !t_build_ok(?s, root)) { ret 9; }
    if (t_exists_under(?a, source, ".git") || t_exists_under(?a, root, "dep/local/.git"))          { ret 10; }
    val copied_r: res[str, fail.Fail] = package.dep_full_of(?a, root, "local");
    if (sel copied_r.err) { ret 11; }
    val copied: str = copied_r.ok;
    fin { str_free(?a, copied); }
    val remove_all_r: err[fs.FsError] = fs.remove_all(?a, copied);
    if (sel remove_all_r.err) { ret 12; }
    var reqs: Vector[package_closure.Request] = collections_vector.init[package_closure.Request](?a);
    fin { package_closure.free_requests(?a, ?reqs); }
    if (t_realize(?s, ?a, root, ?reqs, true, false, false, nil, nil) != 0)                         { ret 13; }
    if (verify_project(root, false, git.t_file_transport_environ()) != 0 || !t_build_ok(?s, root)) { ret 14; }
    ret 0;
}

#[testing]
fun t_read_is(a: *A.Allocator, root: str, rel: str, want: str) bool {
    val got: res[str, fail.Fail] = t_read_under(a, root, rel);
    if (sel got.err) { ret false; }
    ret str_equals(got.ok, want);
}

#[testing]
fun t_path_source(a: *A.Allocator, prefix: str, lib: str) str {
    val dir: str = t_scratch(a, prefix);
    if (str_empty(dir))                                                                                                                                                                                                                        { ret ""; }
    if (!t_write(a, dir, MANIFEST, "[project]\nmach = \">=5\"\nid = \"local\"\nversion = \"0.1.0\"\nsrc = \"src\"\nout = \"out\"\n[profile.debug]\nopt = 0\ndebug = false\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n")) { ret ""; }
    if (!t_lib_module(a, dir))                                                                                                                                                                                                                 { ret ""; }
    if (!t_write(a, dir, "src/lib.mach", lib))                                                                                                                                                                                                 { ret ""; }
    ret dir;
}

# a pulled root whose path dependency `local` is realized from `source`
#[testing]
fun t_pulled_path_root(a: *A.Allocator, prefix: str, source: str) str {
    val root: str = t_root_repo(a, prefix, t_dep_table_path(a, "local", source));
    if (str_empty(root))                                               { ret ""; }
    if (pull_project(root, true, git.t_file_transport_environ()) != 0) { ret ""; }
    if (!t_exists_under(a, root, "dep/local/src/lib.mach"))            { ret ""; }
    ret root;
}

# a path dependency has no pin, so every pull syncs its copy with the declared source:
# an edited source file reaches the copy over a local edit to it, and a file deleted from the
# source is gone from the copy, so a pull is a sync, not an overlay
test pull__a_path_dependency_copy_syncs_with_its_source {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val source: str = t_path_source(?a, "mach_dep_sync_edit_source", "pub fun v() i32 { ret 1; }\n");
    if (str_empty(source)) { ret 2; }
    fin { fs.remove_all(?a, source); }
    val root: str = t_pulled_path_root(?a, "mach_dep_sync_edit_root", source);
    if (str_empty(root)) { ret 3; }
    fin { fs.remove_all(?a, root); }
    if (!t_write(?a, source, "gone.txt", "soon deleted\n"))                                                               { ret 4; }
    if (pull_project(root, true, git.t_file_transport_environ()) != 0 || !t_exists_under(?a, root, "dep/local/gone.txt")) { ret 4; }
    val gone_r: res[str, A.Error] = types_path.join(?a, source, "gone.txt");
    if (sel gone_r.err) { ret 4; }
    val unlinked: err[io_error.Error] = fs.remove_file(gone_r.ok);
    if (sel unlinked.err)                                                                { ret 4; }
    if (!t_write(?a, source, "src/lib.mach", "pub fun v() i32 { ret 11; }\n"))           { ret 4; }
    if (!t_write(?a, root, "dep/local/src/lib.mach", "# edited in the copy\n"))          { ret 4; }
    if (pull_project(root, true, git.t_file_transport_environ()) != 0)                   { ret 5; }
    if (!t_read_is(?a, root, "dep/local/src/lib.mach", "pub fun v() i32 { ret 11; }\n")) { ret 6; }
    if (t_exists_under(?a, root, "dep/local/gone.txt"))                                  { ret 7; }
    ret 0;
}

# a changed `path` realizes the new source, and nothing only the old one had survives
test pull__a_changed_path_realizes_the_new_source {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val first: str = t_path_source(?a, "mach_dep_sync_first", "pub fun v() i32 { ret 1; }\n");
    if (str_empty(first)) { ret 2; }
    fin { fs.remove_all(?a, first); }
    if (!t_write(?a, first, "only_first.txt", "first\n")) { ret 2; }
    val second: str = t_path_source(?a, "mach_dep_sync_second", "pub fun v() i32 { ret 2; }\n");
    if (str_empty(second)) { ret 2; }
    fin { fs.remove_all(?a, second); }
    if (!t_write(?a, second, "only_second.txt", "second\n")) { ret 2; }
    val root: str = t_pulled_path_root(?a, "mach_dep_sync_path_root", first);
    if (str_empty(root)) { ret 3; }
    fin { fs.remove_all(?a, root); }
    if (!t_write(?a, root, MANIFEST, t_root_manifest(?a, t_dep_table_path(?a, "local", second)))) { ret 4; }
    if (pull_project(root, true, git.t_file_transport_environ()) != 0)                            { ret 5; }
    if (!t_read_is(?a, root, "dep/local/src/lib.mach", "pub fun v() i32 { ret 2; }\n"))           { ret 6; }
    if (!t_exists_under(?a, root, "dep/local/only_second.txt"))                                   { ret 7; }
    if (t_exists_under(?a, root, "dep/local/only_first.txt"))                                     { ret 8; }
    if (verify_project(root, false, git.t_file_transport_environ()) != 0)                         { ret 9; }
    ret 0;
}

# a symlinked path dependency slot is refused and left alone, never synced through
test pull__a_symlinked_path_dependency_slot_is_refused {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val source: str = t_path_source(?a, "mach_dep_link_source", "pub fun v() i32 { ret 1; }\n");
    if (str_empty(source)) { ret 2; }
    fin { fs.remove_all(?a, source); }
    val elsewhere: str = t_scratch(?a, "mach_dep_link_target");
    if (str_empty(elsewhere)) { ret 2; }
    fin { fs.remove_all(?a, elsewhere); }
    if (!t_write(?a, elsewhere, "kept.txt", "untouched\n")) { ret 2; }
    val root: str = t_root_repo(?a, "mach_dep_link_root", t_dep_table_path(?a, "local", source));
    if (str_empty(root)) { ret 3; }
    fin { fs.remove_all(?a, root); }
    val dep_r: res[str, A.Error] = types_path.join(?a, root, "dep");
    if (sel dep_r.err) { ret 4; }
    val made: err[fs.FsError] = fs.create_dir_all(?a, dep_r.ok, 0o755);
    if (sel made.err) { ret 4; }
    val slot_r: res[str, A.Error] = types_path.join(?a, root, "dep/local");
    if (sel slot_r.err) { ret 4; }
    val linked: err[io_error.Error] = fs.symlink(elsewhere, slot_r.ok);
    if (sel linked.err)                                                { ret 4; }
    if (pull_project(root, true, git.t_file_transport_environ()) != 1) { ret 5; }
    val still: res[bool, io_error.Error] = fs.is_symlink(slot_r.ok);
    if (!(sel still.ok && still.ok))                          { ret 6; }
    if (t_exists_under(?a, elsewhere, "mach.toml"))           { ret 7; }
    if (!t_read_is(?a, elsewhere, "kept.txt", "untouched\n")) { ret 8; }
    ret 0;
}

#[testing]
fun t_dep_cli_edit(a: *A.Allocator, action: str, root: str, name: str, url: str) i64 {
    var av: [10]*u8;
    av[0] = "mach"::*u8;
    av[1] = "dep"::*u8;
    av[2] = action::*u8;
    av[3] = root::*u8;
    av[4] = name::*u8;
    av[5] = "--quiet"::*u8;
    if (str_empty(url)) {
        av[6] = nil;
        ret t_dep_cli(a, 6, ?av[0]);
    }
    av[6] = "--git"::*u8;
    av[7] = url::*u8;
    av[8] = "--ref"::*u8;
    av[9] = "branch/main"::*u8;
    ret t_dep_cli(a, 10, ?av[0]);
}

# a deleted checkout with a staged gitlink is initialized again, with or without its .gitmodules entry,
# and an existing checkout is fetched to a moved gitlink's commit
test pull__a_deleted_checkout_with_a_staged_gitlink_is_initialized_again {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val fixture: str = t_package_repo(?a, "mach_dep_slot_source", "x", "");
    if (str_empty(fixture)) { ret 2; }
    fin { fs.remove_all(?a, fixture); }
    val root: str = t_root_repo(?a, "mach_dep_slot_root", t_dep_table(?a, "x", fixture));
    if (str_empty(root)) { ret 3; }
    fin { fs.remove_all(?a, root); }
    if (pull_project(root, true, git.t_file_transport_environ()) != 0 || verify_project(root, false, git.t_file_transport_environ()) != 0) { ret 4; }

    val checkout_r: res[str, A.Error] = types_path.join(?a, root, "dep/x");
    if (sel checkout_r.err) { ret 5; }
    val checkout: str = checkout_r.ok;
    fs.remove_all(?a, checkout);
    if (pull_project(root, true, git.t_file_transport_environ()) != 0)    { ret 6; }
    if (!t_exists_under(?a, root, "dep/x/mach.toml"))                     { ret 7; }
    if (verify_project(root, false, git.t_file_transport_environ()) != 0) { ret 8; }

    if (!t_git3(?a, root, "config", "-f", ".gitmodules", "--remove-section", "submodule.dep/x")) { ret 9; }
    if (!t_git3(?a, root, "add", "--", ".gitmodules", "", ""))                                   { ret 9; }
    fs.remove_all(?a, checkout);
    if (pull_project(root, true, git.t_file_transport_environ()) != 0)    { ret 10; }
    if (!t_exists_under(?a, root, "dep/x/mach.toml"))                     { ret 11; }
    if (verify_project(root, false, git.t_file_transport_environ()) != 0) { ret 12; }

    fs.remove_all(?a, checkout);
    var s:    session.Session;
    var mode: u8 = 0;
    if (!t_session_and_mode(?a, root, ?s, ?mode)) { ret 13; }
    fin { session.dnit(?s); }
    var upd_closure: Vector[package_closure.Request] = collections_vector.init[package_closure.Request](?a);
    if (t_update(?s, ?a, root, mode, false, "x"::*u8, true, false, false, ?upd_closure, nil) != 0) { ret 14; }
    if (verify_project(root, false, git.t_file_transport_environ()) != 0)                          { ret 15; }

    # the gitlink moves to a commit the existing checkout never fetched: pull fetches it
    if (!t_write(?a, fixture, "src/lib.mach", "pub fun hello() i32 { ret 2; }\n")) { ret 16; }
    if (!t_commit_all(?a, fixture))                                                { ret 16; }
    val moved_r: res[str, fail.Fail] = git_checkout.revision(?s, fixture);
    if (sel moved_r.err) { ret 17; }
    val moved:  str                              = moved_r.ok;
    val info_r: res[str, std_format.FormatError] = std_format.sprint(?a, "160000,{},dep/x", moved);
    if (sel info_r.err)                                                      { ret 17; }
    if (!t_git3(?a, root, "update-index", "--cacheinfo", info_r.ok, "", "")) { ret 18; }
    # offline fetches nothing, so the missing pin is a keyed refusal naming it
    if (t_offline_realized(?s, root, mode, fixture, "branch/main", moved) != 0) { ret 19; }
    # nor does it initialize a missing checkout from a module store that lacks the pin
    fs.remove_all(?a, checkout);
    if (t_offline_realized(?s, root, mode, fixture, "branch/main", moved) != 0) { ret 20; }
    if (pull_project(root, true, git.t_file_transport_environ()) != 0)          { ret 21; }
    if (!str_equals(t_head_under(?a, root, "dep/x"), moved))                    { ret 22; }
    if (verify_project(root, false, git.t_file_transport_environ()) != 0)       { ret 23; }
    # a store that holds the pin initializes the checkout offline
    fs.remove_all(?a, checkout);
    if (t_offline_realized(?s, root, mode, fixture, "branch/main", moved) != 1) { ret 24; }
    if (!str_equals(t_head_under(?a, root, "dep/x"), moved))                    { ret 25; }
    ret 0;
}

# realize dep/x at `ref` offline: 1 when it initialized the checkout, 0 when it refused with a
# keyed refusal naming the dependency and `named` (its pin, selector or source), 2 otherwise
#[testing]
fun t_offline_realized(s: *session.Session, root: str, mode: u8, url: str, ref: str, named: str) i64 {
    var quiet: package_report.Report = package_report.discard(s.build_alloc);
    fin { package_report.dnit(?quiet); }
    val observed: res[git_checkout.Slot, fail.Fail] = git_checkout.observe_slot(s, root, "x", mode);
    if (sel observed.err) { ret 2; }
    var slot: git_checkout.Slot = observed.ok;
    fin { git_checkout.slot_dnit(s.build_alloc, ?slot); }
    val r: res[u8, fail.Fail] = git_checkout.realize_slot(s, root, "x", url, ref, mode, ?slot, true, ?quiet);
    if (sel r.ok) {
        if (r.ok == package_source.REALIZED_INITIALIZED) { ret 1; }
        ret 2;
    }
    if (fail.kind_of(r.err) != diagnostic_kind.DEP_OFFLINE) { ret 2; }
    if (!t_contains(fail.describe(r.err), "'x'"))           { ret 2; }
    if (!t_contains(fail.describe(r.err), named))           { ret 2; }
    ret 0;
}

test pull__an_unregistered_checkout_is_adopted_when_clean_and_refused_when_dirty {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val fixture: str = t_package_repo(?a, "mach_dep_adopt_source", "x", "");
    if (str_empty(fixture)) { ret 2; }
    fin { fs.remove_all(?a, fixture); }
    val root: str = t_root_repo(?a, "mach_dep_adopt_root", t_dep_table(?a, "x", fixture));
    if (str_empty(root)) { ret 3; }
    fin { fs.remove_all(?a, root); }
    if (!t_git3(?a, root, "clone", "-q", fixture, "dep/x", ""))    { ret 4; }
    if (!t_write(?a, root, "dep/x/scratch", "work in progress\n")) { ret 5; }

    if (pull_project(root, true, git.t_file_transport_environ()) != 1) { ret 6; }
    if (!t_exists_under(?a, root, "dep/x/scratch"))                    { ret 7; }
    if (t_exists_under(?a, root, ".gitmodules"))                       { ret 8; }

    val scratch_r: res[str, A.Error] = types_path.join(?a, root, "dep/x/scratch");
    if (sel scratch_r.err) { ret 9; }
    fs.remove_all(?a, scratch_r.ok);
    if (pull_project(root, true, git.t_file_transport_environ()) != 0)    { ret 10; }
    if (verify_project(root, false, git.t_file_transport_environ()) != 0) { ret 11; }
    ret 0;
}

test add__after_remove_the_retained_checkout_or_module_store_is_reused {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val fixture: str = t_package_repo(?a, "mach_dep_readd_source", "x", "");
    if (str_empty(fixture)) { ret 2; }
    fin { fs.remove_all(?a, fixture); }
    val root: str = t_root_repo(?a, "mach_dep_readd_root", "");
    if (str_empty(root)) { ret 3; }
    fin { fs.remove_all(?a, root); }

    if (t_dep_cli_edit(?a, "add", root, "x", fixture) != 0)               { ret 4; }
    if (t_dep_cli_edit(?a, "remove", root, "x", "") != 0)                 { ret 5; }
    if (!t_exists_under(?a, root, "dep/x/mach.toml"))                     { ret 6; }
    if (t_dep_cli_edit(?a, "add", root, "x", fixture) != 0)               { ret 7; }
    if (verify_project(root, false, git.t_file_transport_environ()) != 0) { ret 8; }

    # offline re-adds over the retained checkout and never fetches the commit published since
    if (t_dep_cli_edit(?a, "remove", root, "x", "") != 0) { ret 9; }
    val held: str = t_head_under(?a, root, "dep/x");
    if (!t_write(?a, fixture, "src/lib.mach", "pub fun hello() i32 { ret 2; }\n")) { ret 9; }
    if (!t_commit_all(?a, fixture))                                                { ret 9; }
    var s:    session.Session;
    var mode: u8 = 0;
    if (!t_session_and_mode(?a, root, ?s, ?mode)) { ret 9; }
    fin { session.dnit(?s); }
    if (t_offline_realized(?s, root, mode, fixture, "tag/v9", "tag/v9") != 0) { ret 9; }
    var off: [9]str = [9]str{"add", root, "x", "--git", fixture, "--ref", "branch/main", "--offline", "--quiet"};
    if (t_dep_cli_args(?a, ?off[0], 9) != 0)                              { ret 9; }
    if (!str_equals(t_head_under(?a, root, "dep/x"), held))               { ret 9; }
    if (verify_project(root, false, git.t_file_transport_environ()) != 0) { ret 9; }

    # and over the module store git retained for a removed checkout
    if (t_dep_cli_edit(?a, "remove", root, "x", "") != 0) { ret 10; }
    val checkout_r: res[str, A.Error] = types_path.join(?a, root, "dep/x");
    if (sel checkout_r.err) { ret 10; }
    fs.remove_all(?a, checkout_r.ok);
    if (!t_exists_under(?a, root, ".git/modules/dep/x"))                  { ret 11; }
    if (t_dep_cli_args(?a, ?off[0], 9) != 0)                              { ret 12; }
    if (!str_equals(t_head_under(?a, root, "dep/x"), held))               { ret 12; }
    if (verify_project(root, false, git.t_file_transport_environ()) != 0) { ret 13; }

    # with neither, offline clones nothing
    if (t_dep_cli_edit(?a, "remove", root, "x", "") != 0) { ret 14; }
    fs.remove_all(?a, checkout_r.ok);
    fs.remove_all(?a, t_join_owned(?a, root, ".git/modules/dep/x"));
    if (t_offline_realized(?s, root, mode, fixture, "branch/main", fixture) != 0) { ret 15; }
    if (t_dep_cli_args(?a, ?off[0], 9) != 1)                                      { ret 16; }
    if (t_exists_under(?a, root, "dep/x"))                                        { ret 17; }
    ret 0;
}

# a package repository whose manifest names each version it is tagged with; `mach_range` is
# the [project].mach of the release tagged `blocked` ("" for none)
#[testing]
fun t_release(a: *A.Allocator, dir: str, id: str, version: str, mach_range: str) bool {
    var mach_line: str = "";
    if (!str_empty(mach_range)) {
        val l: res[str, std_format.FormatError] = std_format.sprint(a, "mach = \"{}\"\n", mach_range);
        if (sel l.err) { ret false; }
        mach_line = l.ok;
    }
    val body_r: res[str, std_format.FormatError] = std_format.sprint(a,
        "[project]\nid = \"{}\"\nversion = \"{}\"\n{}src = \"src\"\nout = \"out\"\n[profile.debug]\nopt = 0\ndebug = false\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n", id, version, mach_line);
    if (sel body_r.err)                        { ret false; }
    if (!t_write(a, dir, MANIFEST, body_r.ok)) { ret false; }
    if (!t_commit_all(a, dir))                 { ret false; }
    val tag_r: res[str, std_format.FormatError] = std_format.sprint(a, "v{}", version);
    if (sel tag_r.err) { ret false; }
    ret t_git3(a, dir, "tag", tag_r.ok, "", "", "");
}

# a release of `id` depending on `dep_id` at `dep_url` by `ref` or by the range `version`;
# the table goes through the manifest writer so a host path lands escaped
#[testing]
fun t_release_with_dep(a: *A.Allocator, dir: str, id: str, version: str, dep_id: str, dep_url: str, ref: str, range: str) bool {
    var spec: manifest.DepTableSpec;
    spec.name    = dep_id;
    spec.source  = manifest.DEP_SOURCE_GIT;
    spec.value   = dep_url;
    spec.ref     = ref;
    spec.version = range;
    val table: res[str, fail.Fail] = manifest.manifest_add_dep_table(a, "", ?spec);
    if (sel table.err) { ret false; }
    val body_r: res[str, std_format.FormatError] = std_format.sprint(a,
        "[project]\nid = \"{}\"\nversion = \"{}\"\nsrc = \"src\"\nout = \"out\"\n[profile.debug]\nopt = 0\ndebug = false\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n{}", id, version, table.ok);
    if (sel body_r.err)                        { ret false; }
    if (!t_write(a, dir, MANIFEST, body_r.ok)) { ret false; }
    if (!t_commit_all(a, dir))                 { ret false; }
    val tag_r: res[str, std_format.FormatError] = std_format.sprint(a, "v{}", version);
    if (sel tag_r.err) { ret false; }
    ret t_git3(a, dir, "tag", tag_r.ok, "", "", "");
}

#[testing]
fun t_released(a: *A.Allocator) str {
    val dir: str = t_scratch(a, "mach_dep_releases");
    if (str_empty(dir))                            { ret ""; }
    if (!t_lib_module(a, dir))                     { ret ""; }
    if (!t_init_repo(a, dir))                      { ret ""; }
    if (!t_release(a, dir, "vb", "1.0.0", ""))     { ret ""; }
    if (!t_release(a, dir, "vb", "1.1.0", ">=5"))  { ret ""; }
    if (!t_release(a, dir, "vb", "2.0.0", ">=99")) { ret ""; }
    ret dir;
}

#[testing]
fun t_release_is(a: *A.Allocator, root: str, id: str, want: str) bool {
    var s:    session.Session;
    var mode: u8 = 0;
    if (!t_session_and_mode(a, root, ?s, ?mode)) { ret false; }
    fin { session.dnit(?s); }
    val at: res[str, fail.Fail] = git_checkout.release_at_head(?s, t_join_owned(a, root, id));
    if (sel at.err) { ret false; }
    val same: bool = str_equals(at.ok, want);
    str_free(s.build_alloc, at.ok);
    ret same;
}

#[testing]
fun t_dep_cli_args(a: *A.Allocator, words: *str, n: usize) i64 {
    var av: [12]*u8;
    av[0] = "mach"::*u8;
    av[1] = "dep"::*u8;
    var i: usize = 0;
    for (i < n) {
        av[2 + i] = words[i]::*u8;
        i         = i + 1;
    }
    av[2 + n] = nil;
    ret t_dep_cli(a, 2 + n, ?av[0]);
}

# dep add writes the caret of the release resolution picks, update moves within the range,
# --lowest selects the floor, outdated reports, and a range nothing satisfies is explained
test version__add_update_lowest_and_outdated_resolve_release_ranges {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val fix: str = t_released(?a);
    if (str_empty(fix)) { ret 2; }
    fin { fs.remove_all(?a, fix); }
    val root: str = t_root_repo(?a, "mach_dep_version_root", "");
    if (str_empty(root)) { ret 3; }
    fin { fs.remove_all(?a, root); }
    val dep_vb: str = t_join_owned(?a, root, "dep/vb");

    # 2.0.0 needs a newer compiler, so add picks 1.1.0 and writes ^1.1.0
    var add: [6]str = [6]str{"add", root, "vb", "--git", fix, "--quiet"};
    if (t_dep_cli_args(?a, ?add[0], 6) != 0) { ret 4; }
    val manifest_text: res[str, fs.FsError] = fs.read_string(?a, t_join_owned(?a, root, MANIFEST));
    if (sel manifest_text.err)                                            { ret 5; }
    if (!str_contains(manifest_text.ok, "version = \"^1.1.0\""))          { ret 6; }
    if (!t_release_is(?a, root, "dep/vb", "1.1.0"))                       { ret 7; }
    if (verify_project(root, false, git.t_file_transport_environ()) != 0) { ret 8; }

    # a new compatible release is taken by update
    if (!t_release(?a, fix, "vb", "1.2.0", "")) { ret 9; }
    var up: [4]str = [4]str{"update", root, "vb", "--quiet"};
    if (t_dep_cli_args(?a, ?up[0], 4) != 0)         { ret 10; }
    if (!t_release_is(?a, root, "dep/vb", "1.2.0")) { ret 11; }

    # the lowest release the range accepts
    var low: [5]str = [5]str{"update", root, "--all", "--lowest", "--quiet"};
    if (t_dep_cli_args(?a, ?low[0], 5) != 0)        { ret 12; }
    if (!t_release_is(?a, root, "dep/vb", "1.1.0")) { ret 13; }

    # offline resolution reads the tags the checkout already has
    var off: [5]str = [5]str{"update", root, "vb", "--offline", "--quiet"};
    if (t_dep_cli_args(?a, ?off[0], 5) != 0)        { ret 14; }
    if (!t_release_is(?a, root, "dep/vb", "1.2.0")) { ret 15; }

    var out: [2]str = [2]str{"outdated", root};
    if (t_dep_cli_args(?a, ?out[0], 2) != 0) { ret 16; }

    # a range nothing satisfies leaves the checkout where it is
    val mt:     str = t_join_owned(?a, root, MANIFEST);
    val raised: str = str_replace_first(?a, manifest_text.ok, "version = \"^1.1.0\"", "version = \"^3\"");
    if (!t_write(?a, root, MANIFEST, raised))       { ret 17; }
    if (t_dep_cli_args(?a, ?up[0], 4) != 1)         { ret 18; }
    if (!t_release_is(?a, root, "dep/vb", "1.2.0")) { ret 19; }
    ret 0;
}

# whether `mach dep list` gives `id` the state `want`
#[testing]
fun t_listed_state(a: *A.Allocator, root: str, id: str, want: str) bool {
    var s:    session.Session;
    var mode: u8 = 0;
    if (!t_session_and_mode(a, root, ?s, ?mode)) { ret false; }
    fin { session.dnit(?s); }
    var lines: Vector[str] = collections_vector.init[str](a);
    if (t_list(?s, a, root, ?lines) != 0) { ret false; }
    val lead: res[str, std_format.FormatError] = std_format.sprint(a, "  {}  ", id);
    val tail: res[str, std_format.FormatError] = std_format.sprint(a, "  {}", want);
    if (sel lead.err) { ret false; }
    if (sel tail.err) { ret false; }
    var i: usize = 0;
    for (i < lines.len) {
        val line: str = lines.data[i];
        i = i + 1;
        if (!str_starts_with(line, lead.ok)) { cnt; }
        val n: usize = str_len(line);
        val m: usize = str_len(tail.ok);
        ret n >= m && str_equals((?line[n - m])::str, tail.ok);
    }
    ret false;
}

# the pin is the recorded gitlink: update re-pins into a range raised past it in one run even
# when the checkout drifted to the release resolution picks, and list names a pin its range
# excludes
test version__update_repins_past_the_recorded_gitlink_and_list_names_an_out_of_range_pin {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val fix: str = t_scratch(?a, "mach_dep_repin_releases");
    if (str_empty(fix)) { ret 2; }
    fin { fs.remove_all(?a, fix); }
    if (!t_lib_module(?a, fix) || !t_init_repo(?a, fix)) { ret 3; }
    if (!t_release(?a, fix, "vb", "1.0.0", ""))          { ret 4; }
    if (!t_release(?a, fix, "vb", "2.0.0", ""))          { ret 5; }
    if (!t_release(?a, fix, "vb", "2.1.0", ""))          { ret 6; }
    val root: str = t_root_repo(?a, "mach_dep_repin_root", "");
    if (str_empty(root)) { ret 7; }
    fin { fs.remove_all(?a, root); }
    val dep_vb: str = t_join_owned(?a, root, "dep/vb");

    var add: [8]str = [8]str{"add", root, "vb", "--git", fix, "--version", "^1.0", "--quiet"};
    if (t_dep_cli_args(?a, ?add[0], 8) != 0)         { ret 8; }
    if (!t_commit_all(?a, root))                     { ret 9; }
    if (!t_release_is(?a, root, "dep/vb", "1.0.0"))  { ret 10; }
    if (!t_listed_state(?a, root, "vb", "realized")) { ret 11; }

    # the range is raised past the pin, and the checkout drifts by hand to the release update picks
    val manifest_text: res[str, fs.FsError] = fs.read_string(?a, t_join_owned(?a, root, MANIFEST));
    if (sel manifest_text.err)                                                                         { ret 12; }
    if (!t_write(?a, root, MANIFEST, str_replace_first(?a, manifest_text.ok, "\"^1.0\"", "\"^2.0\""))) { ret 13; }
    if (!t_listed_state(?a, root, "vb", "out of range (the pinned release 1.0.0 is outside ^2.0)"))    { ret 14; }
    if (!t_git3(?a, dep_vb, "checkout", "-q", "--detach", "v2.1.0", ""))                               { ret 15; }
    if (!t_listed_state(?a, root, "vb", "out of range (the pinned release 1.0.0 is outside ^2.0)"))    { ret 16; }
    var up: [4]str = [4]str{"update", root, "vb", "--quiet"};
    if (t_dep_cli_args(?a, ?up[0], 4) != 0)                                                    { ret 17; }
    if (!t_release_is(?a, root, "dep/vb", "2.1.0"))                                            { ret 18; }
    if (!str_equals(t_staged_gitlink_under(?a, root, "vb"), t_head_under(?a, root, "dep/vb"))) { ret 19; }
    if (!t_listed_state(?a, root, "vb", "realized"))                                           { ret 20; }
    if (verify_project(root, false, git.t_file_transport_environ()) != 0)                      { ret 21; }
    if (!t_commit_all(?a, root))                                                               { ret 22; }

    # a checkout drifted from its gitlink inside the range: one update pins the newest release
    if (!t_release(?a, fix, "vb", "2.2.0", ""))                                                { ret 23; }
    if (!t_git3(?a, dep_vb, "fetch", "-q", "--tags", "origin", ""))                            { ret 24; }
    if (!t_git3(?a, dep_vb, "checkout", "-q", "--detach", "v2.2.0", ""))                       { ret 25; }
    if (t_dep_cli_args(?a, ?up[0], 4) != 0)                                                    { ret 26; }
    if (!t_release_is(?a, root, "dep/vb", "2.2.0"))                                            { ret 27; }
    if (!str_equals(t_staged_gitlink_under(?a, root, "vb"), t_head_under(?a, root, "dep/vb"))) { ret 28; }
    if (verify_project(root, false, git.t_file_transport_environ()) != 0)                      { ret 29; }

    # a range lowered below the pin is named by list, whatever the checkout holds
    if (!t_write(?a, root, MANIFEST, manifest_text.ok))                                             { ret 30; }
    if (!t_git3(?a, dep_vb, "checkout", "-q", "--detach", "v1.0.0", ""))                            { ret 31; }
    if (!t_listed_state(?a, root, "vb", "out of range (the pinned release 2.2.0 is outside ^1.0)")) { ret 32; }
    ret 0;
}

#[testing]
fun str_replace_first(a: *A.Allocator, hay: str, needle: str, with: str) str {
    val at: opt[str] = str_find(hay, needle);
    if (sel at.none) { ret hay; }
    val offset: usize             = (at.some::usize - hay::usize);
    val head:   res[str, A.Error] = str_dup_range(a, hay, 0, offset);
    if (sel head.err) { ret hay; }
    val joined: res[str, std_format.FormatError] = std_format.sprint(a, "{}{}{}", head.ok, with, (?hay[offset + str_len(needle)])::str);
    if (sel joined.err) { ret hay; }
    ret joined.ok;
}

# a release's own version range is resolved with the root's, and a release selecting a
# dependency by branch is refused as unreproducible
test version__transitive_ranges_resolve_and_branch_selecting_releases_are_refused {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val vb: str = t_released(?a);
    if (str_empty(vb)) { ret 2; }
    fin { fs.remove_all(?a, vb); }
    val va: str = t_scratch(?a, "mach_dep_requirer");
    if (str_empty(va)) { ret 3; }
    fin { fs.remove_all(?a, va); }
    if (!t_lib_module(?a, va) || !t_init_repo(?a, va))                           { ret 3; }
    if (!t_release_with_dep(?a, va, "va", "1.0.0", "vb", vb, "", "~1.0"))        { ret 4; }
    if (!t_release_with_dep(?a, va, "va", "1.1.0", "vb", vb, "branch/main", "")) { ret 5; }
    val root: str = t_root_repo(?a, "mach_dep_transitive_root", "");
    if (str_empty(root)) { ret 6; }
    fin { fs.remove_all(?a, root); }

    # va 1.1.0 selects vb by branch, so a range reaching it is refused; ~1.0 selects va 1.0.0, whose ~1.0 selects vb 1.0.0
    var add:   [8]str = [8]str{"add", root, "va", "--git", va, "--version", ">=1", "--quiet"};
    val added: i64    = t_dep_cli_args(?a, ?add[0], 8);
    if (added != 1) { ret 7; }
    var add_old: [8]str = [8]str{"add", root, "va", "--git", va, "--version", "~1.0", "--quiet"};
    if (t_dep_cli_args(?a, ?add_old[0], 8) != 0)                          { ret 8; }
    if (!t_release_is(?a, root, "dep/va", "1.0.0"))                       { ret 9; }
    if (!t_release_is(?a, root, "dep/vb", "1.0.0"))                       { ret 10; }
    if (verify_project(root, false, git.t_file_transport_environ()) != 0) { ret 11; }
    ret 0;
}

# a package `id` selecting vb by the range `^1` from `fix_vb`, with a committed
# gitlink for it at `tag`; never a release itself, so it is reached by ref or path
#[testing]
fun t_requirer_of_vb(a: *A.Allocator, prefix: str, id: str, fix_vb: str, tag: str) str {
    ret t_requirer_of_vb_at(a, prefix, id, fix_vb, tag, "^1");
}

# a package `id` declaring vb by `range`, its own gitlink for vb at `tag`
#[testing]
fun t_requirer_of_vb_at(a: *A.Allocator, prefix: str, id: str, fix_vb: str, tag: str, range: str) str {
    val table: str = t_dep_table_range(a, "vb", fix_vb, range);
    if (str_empty(table)) { ret ""; }
    val dir: str = t_package_repo(a, prefix, id, table);
    if (str_empty(dir))                                                                    { ret ""; }
    if (!t_git_submodule_add(a, dir, fix_vb, "dep/vb"))                                    { ret ""; }
    if (!t_git3(a, t_join_owned(a, dir, "dep/vb"), "checkout", "-q", "--detach", tag, "")) { ret ""; }
    if (!t_commit_all(a, dir))                                                             { ret ""; }
    ret dir;
}

# the closure contract for a range a dependency declares, with the dependency
# reached by `table` (a git ref or a path): `update --all` pins the range's
# highest release under the root, `add` seeds it from the dependency's own
# committed gitlink, a root declaration overrides it, and the "no pin yet"
# hint of a pull names a command that succeeds
#[testing]
fun t_transitive_range_through(a: *A.Allocator, prefix: str, vb: str, p_table: str, add_words: *str, add_n: usize) i32 {
    # --all: the highest release the range admits, under the root's dep/
    val all_root: str = t_root_repo(a, prefix, p_table);
    if (str_empty(all_root)) { ret 20; }
    fin { fs.remove_all(a, all_root); }
    var up: [3]str = [3]str{"update", all_root, "--all"};
    if (t_dep_cli_args(a, ?up[0], 3) != 0)                                    { ret 21; }
    if (!t_exists_under(a, all_root, "dep/vb/mach.toml"))                     { ret 22; }
    if (!t_release_is(a, all_root, "dep/vb", "1.1.0"))                        { ret 23; }
    if (verify_project(all_root, false, git.t_file_transport_environ()) != 0) { ret 24; }

    # add: the dependency's gitlink seeds the range, and a later --all moves it
    val add_root: str = t_root_repo(a, prefix, "");
    if (str_empty(add_root)) { ret 30; }
    fin { fs.remove_all(a, add_root); }
    add_words[1] = add_root;
    if (t_dep_cli_args(a, add_words, add_n) != 0)                             { ret 31; }
    if (!t_release_is(a, add_root, "dep/vb", "1.0.0"))                        { ret 32; }
    if (verify_project(add_root, false, git.t_file_transport_environ()) != 0) { ret 33; }
    var up2: [3]str = [3]str{"update", add_root, "--all"};
    if (t_dep_cli_args(a, ?up2[0], 3) != 0)            { ret 34; }
    if (!t_release_is(a, add_root, "dep/vb", "1.1.0")) { ret 35; }

    # the root's own declaration of vb overrides the dependency's range
    val over_table: res[str, std_format.FormatError] = std_format.sprint(a, "{}{}", p_table, t_dep_table_ref(a, "vb", vb, "tag/v2.0.0"));
    if (sel over_table.err) { ret 40; }
    val over_root: str = t_root_repo(a, prefix, over_table.ok);
    if (str_empty(over_root)) { ret 41; }
    fin { fs.remove_all(a, over_root); }
    var up3: [3]str = [3]str{"update", over_root, "--all"};
    if (t_dep_cli_args(a, ?up3[0], 3) != 0)             { ret 42; }
    if (!t_release_is(a, over_root, "dep/vb", "2.0.0")) { ret 43; }

    # pull refuses the unpinned range and names update <root> vb, which succeeds
    val pull_root: str = t_root_repo(a, prefix, p_table);
    if (str_empty(pull_root)) { ret 50; }
    fin { fs.remove_all(a, pull_root); }
    if (pull_project(pull_root, true, git.t_file_transport_environ()) != 1) { ret 51; }
    var one: [3]str = [3]str{"update", pull_root, "vb"};
    if (t_dep_cli_args(a, ?one[0], 3) != 0)                                 { ret 52; }
    if (!t_exists_under(a, pull_root, "dep/vb/mach.toml"))                  { ret 53; }
    if (pull_project(pull_root, true, git.t_file_transport_environ()) != 0) { ret 54; }
    ret 0;
}

test version__a_range_declared_by_a_git_dependency_resolves_from_its_gitlink {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val vb: str = t_released(?a);
    if (str_empty(vb)) { ret 2; }
    fin { fs.remove_all(?a, vb); }
    val p: str = t_requirer_of_vb(?a, "mach_dep_git_requirer", "p", vb, "v1.0.0");
    if (str_empty(p)) { ret 3; }
    fin { fs.remove_all(?a, p); }
    var add: [8]str = [8]str{"add", "", "p", "--git", p, "--ref", "branch/main", "--quiet"};
    ret t_transitive_range_through(?a, "mach_dep_git_edge_root", vb, t_dep_table(?a, "p", p), ?add[0], 8);
}

test version__a_range_declared_by_a_path_dependency_resolves_from_its_gitlink {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val vb: str = t_released(?a);
    if (str_empty(vb)) { ret 2; }
    fin { fs.remove_all(?a, vb); }
    val p: str = t_requirer_of_vb(?a, "mach_dep_path_requirer", "p", vb, "v1.0.0");
    if (str_empty(p)) { ret 3; }
    fin { fs.remove_all(?a, p); }
    var add: [6]str = [6]str{"add", "", "p", "--path", p, "--quiet"};
    ret t_transitive_range_through(?a, "mach_dep_path_edge_root", vb, t_dep_table_path(?a, "p", p), ?add[0], 6);
}

# the resolution's refusal for `root`, or "" when it resolves
#[testing]
fun t_resolution_refusal(a: *A.Allocator, root: str) str {
    val notes: Vector[str] = t_notes_of(a, root, false);
    if (notes.len == 0) { ret ""; }
    ret notes.data[0];
}

# every range declared for one identity takes part in its resolution, whichever
# requirer declares it: two path dependencies' ranges on vb intersect, disjoint
# ranges are refused naming each requirer by its chain with the root's remedy,
# and a root range narrows the same way
test version__every_requirer_range_on_one_identity_takes_part_in_resolution {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val vb: str = t_released(?a);
    if (str_empty(vb)) { ret 2; }
    fin { fs.remove_all(?a, vb); }
    val p: str = t_requirer_of_vb_at(?a, "mach_dep_ranges_p", "p", vb, "v1.0.0", "^1");
    if (str_empty(p)) { ret 3; }
    fin { fs.remove_all(?a, p); }
    val q: str = t_requirer_of_vb_at(?a, "mach_dep_ranges_q", "q", vb, "v1.1.0", ">=1.1");
    if (str_empty(q)) { ret 4; }
    fin { fs.remove_all(?a, q); }
    val n: str = t_requirer_of_vb_at(?a, "mach_dep_ranges_n", "n", vb, "v1.0.0", "<1.1");
    if (str_empty(n)) { ret 5; }
    fin { fs.remove_all(?a, n); }
    val q_table: str = t_dep_table_path(?a, "q", q);

    # overlapping: the highest release inside the intersection, and verify agrees
    val both: res[str, std_format.FormatError] = std_format.sprint(?a, "{}{}", t_dep_table_path(?a, "p", p), q_table);
    if (sel both.err) { ret 10; }
    val both_root: str = t_root_repo(?a, "mach_dep_ranges_both", both.ok);
    if (str_empty(both_root)) { ret 11; }
    fin { fs.remove_all(?a, both_root); }
    var up: [3]str = [3]str{"update", both_root, "--all"};
    if (t_dep_cli_args(?a, ?up[0], 3) != 0)                                    { ret 12; }
    if (!t_release_is(?a, both_root, "dep/vb", "1.1.0"))                       { ret 13; }
    if (verify_project(both_root, false, git.t_file_transport_environ()) != 0) { ret 14; }

    # disjoint: refused, each range named by the chain that declared it
    val apart: res[str, std_format.FormatError] = std_format.sprint(?a, "{}{}", t_dep_table_path(?a, "n", n), q_table);
    if (sel apart.err) { ret 20; }
    val apart_root: str = t_root_repo(?a, "mach_dep_ranges_apart", apart.ok);
    if (str_empty(apart_root)) { ret 21; }
    fin { fs.remove_all(?a, apart_root); }
    var up2: [3]str = [3]str{"update", apart_root, "--all"};
    if (t_dep_cli_args(?a, ?up2[0], 3) == 0)                { ret 22; }
    if (t_exists_under(?a, apart_root, "dep/vb/mach.toml")) { ret 23; }
    val refusal: str = t_resolution_refusal(?a, apart_root);
    if (!t_contains(refusal, "root -> n requires vb <1.1"))                        { ret 24; }
    if (!t_contains(refusal, "root -> q requires vb >=1.1"))                       { ret 25; }
    if (!t_contains(refusal, "the root decides by declaring the identity itself")) { ret 26; }
    if (!t_contains(refusal, "[dep.vb]"))                                          { ret 27; }

    # a root range narrows with the dependencies' ranges: disjoint is refused
    # naming the root, and an overlap picks inside it
    val narrow: res[str, std_format.FormatError] = std_format.sprint(?a, "{}{}", t_dep_table_range(?a, "vb", vb, "<1.1"), q_table);
    if (sel narrow.err) { ret 30; }
    val narrow_root: str = t_root_repo(?a, "mach_dep_ranges_narrow", narrow.ok);
    if (str_empty(narrow_root)) { ret 31; }
    fin { fs.remove_all(?a, narrow_root); }
    var up3: [3]str = [3]str{"update", narrow_root, "--all"};
    if (t_dep_cli_args(?a, ?up3[0], 3) == 0) { ret 32; }
    val root_refusal: str = t_resolution_refusal(?a, narrow_root);
    if (!t_contains(root_refusal, "root requires vb <1.1"))       { ret 33; }
    if (!t_contains(root_refusal, "root -> q requires vb >=1.1")) { ret 34; }
    val wide: res[str, std_format.FormatError] = std_format.sprint(?a, "{}{}", t_dep_table_range(?a, "vb", vb, "^1"), q_table);
    if (sel wide.err) { ret 40; }
    val wide_root: str = t_root_repo(?a, "mach_dep_ranges_wide", wide.ok);
    if (str_empty(wide_root)) { ret 41; }
    fin { fs.remove_all(?a, wide_root); }
    var up4: [3]str = [3]str{"update", wide_root, "--all"};
    if (t_dep_cli_args(?a, ?up4[0], 3) != 0)                                   { ret 42; }
    if (!t_release_is(?a, wide_root, "dep/vb", "1.1.0"))                       { ret 43; }
    if (verify_project(wide_root, false, git.t_file_transport_environ()) != 0) { ret 44; }
    ret 0;
}

#[testing]
fun t_refusal_has(a: *A.Allocator, root: str, n1: str, n2: str) bool {
    val r: str = t_verify_refusal(a, root);
    ret !str_empty(r) && t_contains(r, n1) && t_contains(r, n2);
}

# verify holds a version selection to a release tag inside every requirer's range, offline,
# and a release selecting a dependency by branch is refused with its chain
test verify__version_pins_are_checked_against_every_range {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val fix: str = t_released(?a);
    if (str_empty(fix)) { ret 2; }
    fin { fs.remove_all(?a, fix); }
    if (!t_release(?a, fix, "vb", "1.2.0", "")) { ret 3; }
    val root: str = t_root_repo(?a, "mach_dep_verify_range_root", "");
    if (str_empty(root)) { ret 4; }
    fin { fs.remove_all(?a, root); }

    # in range
    var add: [8]str = [8]str{"add", root, "vb", "--git", fix, "--version", "~1.1", "--quiet"};
    if (t_dep_cli_args(?a, ?add[0], 8) != 0)                              { ret 5; }
    if (!t_release_is(?a, root, "dep/vb", "1.1.0"))                       { ret 6; }
    if (verify_project(root, false, git.t_file_transport_environ()) != 0) { ret 7; }

    # outside the range, with a remedy that re-pins it
    val text: res[str, fs.FsError] = fs.read_string(?a, t_join_owned(?a, root, MANIFEST));
    if (sel text.err) { ret 8; }
    val raised: str = str_replace_first(?a, text.ok, "version = \"~1.1\"", "version = \"^1.2\"");
    if (!t_write(?a, root, MANIFEST, raised))                                           { ret 9; }
    if (!t_refusal_has(?a, root, "requires version '^1.2'", "pinned release is 1.1.0")) { ret 10; }
    if (t_run_remedy(?a, t_verify_refusal(?a, root), root) != 0)                        { ret 11; }
    if (!t_release_is(?a, root, "dep/vb", "1.2.0"))                                     { ret 12; }
    if (verify_project(root, false, git.t_file_transport_environ()) != 0)               { ret 13; }

    # a pin no release tag names
    if (!t_write(?a, fix, "NEWS", "untagged\n") || !t_commit_all(?a, fix)) { ret 14; }
    val dep_vb: str = t_join_owned(?a, root, "dep/vb");
    if (!t_git3(?a, dep_vb, "fetch", "-q", "origin", "main", ""))                                    { ret 15; }
    if (!t_git3(?a, dep_vb, "checkout", "-q", "FETCH_HEAD", "", ""))                                 { ret 16; }
    if (!t_git3(?a, root, "add", "dep/vb", "", "", ""))                                              { ret 17; }
    if (!t_refusal_has(?a, root, "requires version '^1.2'", "no release tag in its checkout names")) { ret 18; }

    # a checkout with no tags, as a shallow clone has, cannot say its release, and pull fetches them
    if (!t_git3(?a, dep_vb, "checkout", "-q", "v1.2.0", "", ""))               { ret 27; }
    if (!t_git3(?a, root, "add", "dep/vb", "", "", ""))                        { ret 28; }
    if (!t_git3(?a, dep_vb, "tag", "-d", "v1.0.0", "v1.1.0", "v1.2.0"))        { ret 29; }
    if (!t_git3(?a, dep_vb, "tag", "-d", "v2.0.0", "", ""))                    { ret 30; }
    if (!t_refusal_has(?a, root, "requires version '^1.2'", "cannot be read")) { ret 31; }
    if (pull_project(root, true, git.t_file_transport_environ()) != 0)         { ret 32; }
    if (verify_project(root, false, git.t_file_transport_environ()) != 0)      { ret 33; }

    # --release holds the root itself to release selectors
    if (!t_git3(?a, dep_vb, "checkout", "-q", "v1.2.0", "", ""))         { ret 19; }
    if (!t_git3(?a, root, "add", "dep/vb", "", "", ""))                  { ret 20; }
    if (verify_project(root, true, git.t_file_transport_environ()) != 0) { ret 21; }
    val floating: str = str_replace_first(?a, raised, "version = \"^1.2\"", "ref = \"branch/main\"");
    if (!t_write(?a, root, MANIFEST, floating))                           { ret 22; }
    if (verify_project(root, false, git.t_file_transport_environ()) != 0) { ret 23; }
    if (verify_project(root, true, git.t_file_transport_environ()) != 1)  { ret 24; }
    var s:    session.Session;
    var mode: u8 = 0;
    if (!t_session_and_mode(?a, root, ?s, ?mode)) { ret 25; }
    val vr:  err[fail.Fail] = package_verify.dependencies(?s, root, true, nil);
    var why: str            = "";
    if (sel vr.err) { why = package_closure.own(?a, fail.describe(vr.err)); }
    session.dnit(?s);
    if (!t_contains(why, "project 'root'") || !t_contains(why, "[dep.vb] by ref = \"branch/main\"")) { ret 26; }
    ret 0;
}

# a release reached by `tag/` or a range whose manifest selects by branch is refused by
# verify, naming the chain and the line; a development selection above it may float
test verify__a_release_selecting_a_branch_is_refused_with_its_chain {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val vb: str = t_released(?a);
    if (str_empty(vb)) { ret 2; }
    fin { fs.remove_all(?a, vb); }
    if (!t_release(?a, vb, "vb", "2.1.0", "")) { ret 2; }
    val va: str = t_scratch(?a, "mach_dep_floating_release");
    if (str_empty(va)) { ret 3; }
    fin { fs.remove_all(?a, va); }
    if (!t_lib_module(?a, va) || !t_init_repo(?a, va))                           { ret 3; }
    if (!t_release_with_dep(?a, va, "va", "1.1.0", "vb", vb, "branch/main", "")) { ret 4; }

    # by branch, the development chain floats freely
    val dev_root: str = t_root_repo(?a, "mach_dep_floating_dev", t_dep_table(?a, "va", va));
    if (str_empty(dev_root)) { ret 5; }
    fin { fs.remove_all(?a, dev_root); }
    if (pull_project(dev_root, true, git.t_file_transport_environ()) != 0)    { ret 6; }
    if (!t_commit_all(?a, dev_root))                                          { ret 7; }
    if (verify_project(dev_root, false, git.t_file_transport_environ()) != 0) { ret 8; }

    # by tag, the release is refused
    val rel_root: str = t_root_repo(?a, "mach_dep_floating_rel", t_dep_table_ref(?a, "va", va, "tag/v1.1.0"));
    if (str_empty(rel_root)) { ret 9; }
    fin { fs.remove_all(?a, rel_root); }
    if (pull_project(rel_root, true, git.t_file_transport_environ()) != 0 || !t_commit_all(?a, rel_root))                    { ret 10; }
    if (!t_refusal_has(?a, rel_root, "root -> va is a release (ref = \"tag/v1.1.0\")", "[dep.vb] by ref = \"branch/main\"")) { ret 11; }
    if (!t_refusal_has(?a, rel_root, "declare [dep.vb] in your root manifest", "have the dependency cut a release"))         { ret 12; }

    # a root that declares vb selects it itself, by tag, branch or path, so the release is allowed
    var own_vb: [3]str = [3]str{t_dep_table_ref(?a, "vb", vb, "tag/v2.1.0"), t_dep_table_ref(?a, "vb", vb, "branch/main"), t_dep_table_path(?a, "vb", vb)};
    var k:      usize  = 0;
    for (k < 3) {
        val extra: res[str, std_format.FormatError] = std_format.sprint(?a, "{}{}", t_dep_table_ref(?a, "va", va, "tag/v1.1.0"), own_vb[k]);
        if (sel extra.err) { ret 13; }
        val over_root: str = t_root_repo(?a, "mach_dep_floating_over", extra.ok);
        if (str_empty(over_root)) { ret 14; }
        val pulled: i64 = pull_project(over_root, true, git.t_file_transport_environ());
        var rc:     i32 = 0;
        if (pulled != 0 || !t_commit_all(?a, over_root)) { rc = 20; }
        or (!str_empty(t_verify_refusal(?a, over_root))) { rc = 30; }
        fs.remove_all(?a, over_root);
        if (rc != 0) { ret rc + k::i32; }
        k = k + 1;
    }
    ret 0;
}

# resolution holds a candidate release to the same rule, and a root declaration lifts it
test version__a_release_selecting_a_branch_the_root_declares_resolves {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val vb: str = t_released(?a);
    if (str_empty(vb)) { ret 2; }
    fin { fs.remove_all(?a, vb); }
    val va: str = t_scratch(?a, "mach_dep_resolve_floating_release");
    if (str_empty(va)) { ret 3; }
    fin { fs.remove_all(?a, va); }
    if (!t_lib_module(?a, va) || !t_init_repo(?a, va))                           { ret 3; }
    if (!t_release_with_dep(?a, va, "va", "1.0.0", "vb", vb, "branch/main", "")) { ret 4; }

    val bare: str = t_root_repo(?a, "mach_dep_resolve_floating_bare", "");
    if (str_empty(bare)) { ret 5; }
    fin { fs.remove_all(?a, bare); }
    var refused: Vector[str] = t_notes_of_added(?a, bare, va);
    if (!t_any_note(?refused, "selects dependency 'vb' by branch/main"))                       { ret 6; }
    if (!t_any_note(?refused, "declare [dep.vb] in your root manifest to select it yourself")) { ret 7; }

    val owning: str = t_root_repo(?a, "mach_dep_resolve_floating_own", t_dep_table_ref(?a, "vb", vb, "tag/v1.1.0"));
    if (str_empty(owning)) { ret 8; }
    fin { fs.remove_all(?a, owning); }
    var add: [8]str = [8]str{"add", owning, "va", "--git", va, "--version", "^1", "--quiet"};
    if (t_dep_cli_args(?a, ?add[0], 8) != 0)                                { ret 9; }
    if (verify_project(owning, false, git.t_file_transport_environ()) != 0) { ret 10; }
    ret 0;
}

# the resolution notes, or its refusal, for a root that would add va by range
#[testing]
fun t_notes_of_added(a: *A.Allocator, root: str, va: str) Vector[str] {
    val text: res[str, fs.FsError] = fs.read_string(a, t_join_owned(a, root, MANIFEST));
    var none: Vector[str]          = collections_vector.init[str](a);
    if (sel text.err) { ret none; }
    var spec: manifest.DepTableSpec;
    spec.name    = "va";
    spec.source  = manifest.DEP_SOURCE_GIT;
    spec.value   = va;
    spec.ref     = "";
    spec.version = "^1";
    val with_a: res[str, fail.Fail] = manifest.manifest_add_dep_table(a, text.ok, ?spec);
    if (sel with_a.err)                         { ret none; }
    if (!t_write(a, root, MANIFEST, with_a.ok)) { ret none; }
    ret t_notes_of(a, root, false);
}

# verify names a requirer selector the root's `ref` replaced, and stays quiet without one
test verify__a_root_override_of_a_requirer_selector_is_noted {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val vb: str = t_released(?a);
    if (str_empty(vb)) { ret 2; }
    fin { fs.remove_all(?a, vb); }
    val va: str = t_scratch(?a, "mach_dep_verify_override_requirer");
    if (str_empty(va)) { ret 3; }
    fin { fs.remove_all(?a, va); }
    if (!t_lib_module(?a, va) || !t_init_repo(?a, va))                    { ret 3; }
    if (!t_release_with_dep(?a, va, "va", "1.0.0", "vb", vb, "", "~1.0")) { ret 4; }
    # vc asks for exactly what the root will declare, so its edge is not an override
    val vc: str = t_scratch(?a, "mach_dep_verify_override_agreeing");
    if (str_empty(vc)) { ret 3; }
    fin { fs.remove_all(?a, vc); }
    if (!t_lib_module(?a, vc) || !t_init_repo(?a, vc))                          { ret 3; }
    if (!t_release_with_dep(?a, vc, "vc", "1.0.0", "vb", vb, "tag/v1.0.0", "")) { ret 4; }
    val root: str = t_root_repo(?a, "mach_dep_verify_override_root", "");
    if (str_empty(root)) { ret 5; }
    fin { fs.remove_all(?a, root); }
    var add_a: [8]str = [8]str{"add", root, "va", "--git", va, "--version", "^1", "--quiet"};
    if (t_dep_cli_args(?a, ?add_a[0], 8) != 0) { ret 6; }

    var quiet: Vector[str] = t_override_notes(?a, root);
    if (quiet.len != 0) { ret 7; }

    # a root range intersects with the requirer's instead of replacing it
    var ranged: [8]str = [8]str{"add", root, "vb", "--git", vb, "--version", "^1", "--quiet"};
    if (t_dep_cli_args(?a, ?ranged[0], 8) != 0) { ret 14; }
    var narrowed: Vector[str] = t_override_notes(?a, root);
    if (narrowed.len != 0) { ret 15; }
    var drop_b: [4]str = [4]str{"remove", root, "vb", "--quiet"};
    if (t_dep_cli_args(?a, ?drop_b[0], 4) != 0) { ret 16; }

    var add_b: [8]str = [8]str{"add", root, "vb", "--git", vb, "--ref", "tag/v1.0.0", "--quiet"};
    if (t_dep_cli_args(?a, ?add_b[0], 8) != 0) { ret 8; }
    var add_c: [8]str = [8]str{"add", root, "vc", "--git", vc, "--version", "^1", "--quiet"};
    if (t_dep_cli_args(?a, ?add_c[0], 8) != 0) { ret 17; }
    var noted: Vector[str] = t_override_notes(?a, root);
    if (noted.len != 1)                                                                                    { ret 9; }
    if (!t_any_note(?noted, "note: dependency 'vb': the root declares ref = \"tag/v1.0.0\", overriding ")) { ret 10; }
    if (!t_any_note(?noted, "-> va -> vb which requires version = \"~1.0\""))                              { ret 11; }
    if (!t_any_note(?noted, "nothing checks that 'vb' supports the root's selection"))                     { ret 12; }
    if (verify_project(root, false, git.t_file_transport_environ()) != 0)                                  { ret 13; }
    ret 0;
}

# the override notes `mach dep verify` prints for a project; a verify failure is the only entry
#[testing]
fun t_override_notes(a: *A.Allocator, root: str) Vector[str] {
    var out:  Vector[str] = collections_vector.init[str](a);
    var s:    session.Session;
    var mode: u8          = 0;
    if (!t_session_and_mode(a, root, ?s, ?mode)) { ret out; }
    fin { session.dnit(?s); }
    var overrides: Vector[package_verify.RootOverride] = collections_vector.init[package_verify.RootOverride](a);
    fin { collections_vector.dnit[package_verify.RootOverride](?overrides); }
    val vr: err[fail.Fail] = package_verify.dependencies(?s, root, false, ?overrides);
    if (sel vr.err) {
        collections_vector.push[str](?out, package_closure.own(a, fail.describe(vr.err)));
        ret out;
    }
    var i: usize = 0;
    for (i < overrides.len) {
        val text: res[str, fail.Fail] = package_verify.root_override_text(?s, ?overrides.data[i]);
        i = i + 1;
        if (sel text.err) { cnt; }
        collections_vector.push[str](?out, package_closure.own(a, text.ok));
        str_free(s.build_alloc, text.ok);
    }
    ret out;
}

#[testing]
fun t_notes_of(a: *A.Allocator, root: str, offline: bool) Vector[str] {
    var none: Vector[str] = collections_vector.init[str](a);
    var s:    session.Session;
    var mode: u8          = 0;
    if (!t_session_and_mode(a, root, ?s, ?mode)) { ret none; }
    fin { session.dnit(?s); }
    val mt: res[manifest.Doc, fail.Fail] = package_closure.parse_file(a, t_join_owned(a, root, MANIFEST));
    if (sel mt.err) { ret none; }
    var table: manifest.Doc                       = mt.ok;
    var walk:  package_closure.Walk               = package_closure.Walk{offline: offline, all: false, name: nil};
    val r:     res[resolve.Resolution, fail.Fail] = t_versions(?s, a, root, ?table, false, false, nil, true, ?walk);
    if (sel r.err) {
        collections_vector.push[str](?none, package_closure.own(a, fail.describe(r.err)));
        ret none;
    }
    ret r.ok.notes;
}

#[testing]
fun t_any_note(notes: *Vector[str], needle: str) bool {
    var i: usize = 0;
    for (i < notes.len) {
        if (t_contains(notes.data[i], needle)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# a release tagged before `[project].id` existed, whose manifest still names the project by `name`
#[testing]
fun t_release_before_id(a: *A.Allocator, dir: str, version: str) bool {
    val body_r: res[str, std_format.FormatError] = std_format.sprint(a, "[project]\nname = \"vg\"\nversion = \"{}\"\nsrc = \"src\"\nout = \"out\"\n", version);
    if (sel body_r.err)                        { ret false; }
    if (!t_write(a, dir, MANIFEST, body_r.ok)) { ret false; }
    if (!t_commit_all(a, dir))                 { ret false; }
    val tag_r: res[str, std_format.FormatError] = std_format.sprint(a, "v{}", version);
    if (sel tag_r.err) { ret false; }
    ret t_git3(a, dir, "tag", tag_r.ok, "", "", "");
}

# add with no --version names the version conflict when no release fits, and a release whose
# manifest does not load is set aside as no candidate, never reported as the project's own
# mach.toml
test version__add_reports_the_conflict_past_releases_that_are_no_candidate {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val vs: str = t_scratch(?a, "mach_dep_conflict_std");
    if (str_empty(vs)) { ret 2; }
    fin { fs.remove_all(?a, vs); }
    if (!t_lib_module(?a, vs) || !t_init_repo(?a, vs))                                  { ret 3; }
    if (!t_release(?a, vs, "vs", "6.0.0", "") || !t_release(?a, vs, "vs", "8.0.0", "")) { ret 4; }
    val vg: str = t_scratch(?a, "mach_dep_conflict_gl");
    if (str_empty(vg)) { ret 5; }
    fin { fs.remove_all(?a, vg); }
    if (!t_lib_module(?a, vg) || !t_init_repo(?a, vg))                                  { ret 6; }
    if (!t_release_before_id(?a, vg, "0.1.0") || !t_release_before_id(?a, vg, "0.2.0")) { ret 7; }
    if (!t_release_with_dep(?a, vg, "vg", "0.3.0", "vs", vs, "", "^6.0"))               { ret 8; }
    if (!t_release_with_dep(?a, vg, "vg", "0.4.0", "vs", vs, "", "^6.0"))               { ret 9; }
    val root: str = t_root_repo(?a, "mach_dep_conflict_root", t_dep_table_range(?a, "vs", vs, "^8.0.0"));
    if (str_empty(root)) { ret 10; }
    fin { fs.remove_all(?a, root); }
    val before: res[str, fs.FsError] = fs.read_string(?a, t_join_owned(?a, root, MANIFEST));
    if (sel before.err) { ret 11; }

    # every release that loads needs vs ^6, so add is refused and changes nothing
    var add: [6]str = [6]str{"add", root, "vg", "--git", vg, "--quiet"};
    if (t_dep_cli_args(?a, ?add[0], 6) != 1)          { ret 12; }
    if (!t_read_is(?a, root, MANIFEST, before.ok))    { ret 13; }
    if (t_exists_under(?a, root, "dep/vg/mach.toml")) { ret 14; }
    # the refusal is the resolution add runs over its probe range
    val probe: res[str, std_format.FormatError] = std_format.sprint(?a, "{}{}", before.ok, t_dep_table_range(?a, "vg", vg, ">=0.0.0"));
    if (sel probe.err)                          { ret 15; }
    if (!t_write(?a, root, MANIFEST, probe.ok)) { ret 16; }
    val refusal: str = t_resolution_refusal(?a, root);
    if (!t_write(?a, root, MANIFEST, before.ok))                                                                           { ret 17; }
    if (!t_contains(refusal, "no set of releases satisfies every requirement"))                                            { ret 18; }
    if (!t_contains(refusal, "root requires vs ^8.0.0"))                                                                   { ret 19; }
    if (!t_contains(refusal, "vg 0.4.0 requires vs ^6.0") || !t_contains(refusal, "vg 0.3.0 requires vs ^6.0"))            { ret 20; }
    if (!t_contains(refusal, "vg 0.1.0 is not a candidate: its mach.toml does not load: unknown key 'name' in [project]")) { ret 21; }
    if (t_contains(refusal, "mach.toml: unknown key"))                                                                     { ret 22; }

    # a release that fits is picked past a newer one that is no candidate
    if (!t_release_with_dep(?a, vg, "vg", "0.5.0", "vs", vs, "", "^8.0")) { ret 23; }
    if (!t_release_before_id(?a, vg, "0.6.0"))                            { ret 24; }
    if (t_dep_cli_args(?a, ?add[0], 6) != 0)                              { ret 25; }
    val added: res[str, fs.FsError] = fs.read_string(?a, t_join_owned(?a, root, MANIFEST));
    if (sel added.err)                                   { ret 26; }
    if (!str_contains(added.ok, "version = \"^0.5.0\"")) { ret 27; }
    if (!t_release_is(?a, root, "dep/vg", "0.5.0"))      { ret 28; }
    ret 0;
}

# add --offline resolves from the releases already fetched, and an identity it has no
# releases for is refused by name without touching the manifest
test version__add_offline_resolves_from_fetched_releases {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val vb: str = t_released(?a);
    if (str_empty(vb)) { ret 2; }
    fin { fs.remove_all(?a, vb); }
    val vd: str = t_released(?a);
    if (str_empty(vd)) { ret 2; }
    fin { fs.remove_all(?a, vd); }
    val root: str = t_root_repo(?a, "mach_dep_add_offline_root", "");
    if (str_empty(root)) { ret 3; }
    fin { fs.remove_all(?a, root); }
    val mt: str = t_join_owned(?a, root, MANIFEST);

    # fetch vb's releases, then drop the declaration and keep the checkout
    var add: [6]str = [6]str{"add", root, "vb", "--git", vb, "--quiet"};
    if (t_dep_cli_args(?a, ?add[0], 6) != 0)        { ret 4; }
    if (!t_release_is(?a, root, "dep/vb", "1.1.0")) { ret 5; }
    var rm: [4]str = [4]str{"remove", root, "vb", "--quiet"};
    if (t_dep_cli_args(?a, ?rm[0], 4) != 0)            { ret 6; }
    if (!t_exists_under(?a, root, "dep/vb/mach.toml")) { ret 7; }

    # a release published since is invisible offline
    if (!t_release(?a, vb, "vb", "1.2.0", "")) { ret 8; }
    var off: [7]str = [7]str{"add", root, "vb", "--git", vb, "--offline", "--quiet"};
    if (t_dep_cli_args(?a, ?off[0], 7) != 0) { ret 9; }
    val text: res[str, fs.FsError] = fs.read_string(?a, mt);
    if (sel text.err)                                   { ret 10; }
    if (!str_contains(text.ok, "version = \"^1.1.0\"")) { ret 11; }
    if (!t_release_is(?a, root, "dep/vb", "1.1.0"))     { ret 12; }
    # nor is it fetched into the retained checkout
    if (t_git3(?a, t_join_owned(?a, root, "dep/vb"), "rev-parse", "--verify", "--quiet", "refs/tags/v1.2.0", "")) { ret 12; }

    # an identity with no fetched releases is refused and nothing is declared or checked out
    var none: [7]str = [7]str{"add", root, "vd", "--git", vd, "--offline", "--quiet"};
    if (t_dep_cli_args(?a, ?none[0], 7) != 1) { ret 13; }
    val kept: res[str, fs.FsError] = fs.read_string(?a, mt);
    if (sel kept.err)                       { ret 14; }
    if (!str_equals(kept.ok, text.ok))      { ret 15; }
    if (t_exists_under(?a, root, "dep/vd")) { ret 16; }

    # the refusal add prints names the identity and the missing checkout
    var spec: manifest.DepTableSpec;
    spec.name    = "vd";
    spec.source  = manifest.DEP_SOURCE_GIT;
    spec.value   = vd;
    spec.ref     = "";
    spec.version = "^1";
    val with_vd: res[str, fail.Fail] = manifest.manifest_add_dep_table(?a, text.ok, ?spec);
    if (sel with_vd.err)                          { ret 17; }
    if (!t_write(?a, root, MANIFEST, with_vd.ok)) { ret 18; }
    var refusal: Vector[str] = t_notes_of(?a, root, true);
    if (!t_any_note(?refusal, "requires vd, and the releases of vd cannot be listed: offline: no local checkout of")) { ret 19; }
    if (!t_write(?a, root, MANIFEST, text.ok))                                                                        { ret 20; }

    # online, the same add takes the release the offline one could not see
    if (t_dep_cli_args(?a, ?rm[0], 4) != 0)         { ret 21; }
    if (t_dep_cli_args(?a, ?add[0], 6) != 0)        { ret 22; }
    if (!t_release_is(?a, root, "dep/vb", "1.2.0")) { ret 23; }
    ret 0;
}

# a root `ref` overriding a release's range is named, and an --offline resolution says so
test version__overrides_and_offline_resolution_are_reported {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val vb: str = t_released(?a);
    if (str_empty(vb)) { ret 2; }
    fin { fs.remove_all(?a, vb); }
    val va: str = t_scratch(?a, "mach_dep_override_requirer");
    if (str_empty(va)) { ret 3; }
    fin { fs.remove_all(?a, va); }
    if (!t_lib_module(?a, va) || !t_init_repo(?a, va))                    { ret 3; }
    if (!t_release_with_dep(?a, va, "va", "1.0.0", "vb", vb, "", "~1.0")) { ret 4; }

    # no override and online: nothing to say
    val root: str = t_root_repo(?a, "mach_dep_override_root", "");
    if (str_empty(root)) { ret 5; }
    fin { fs.remove_all(?a, root); }
    var add: [8]str = [8]str{"add", root, "va", "--git", va, "--version", "^1", "--quiet"};
    if (t_dep_cli_args(?a, ?add[0], 8) != 0) { ret 6; }
    var plain: Vector[str] = t_notes_of(?a, root, false);
    if (plain.len != 0) { ret 7; }

    # offline
    var off: Vector[str] = t_notes_of(?a, root, true);
    if (!t_any_note(?off, "resolving from releases already fetched (--offline)")) { ret 8; }

    # the root pins vb by branch, overriding va's ~1.0
    val text: res[str, fs.FsError] = fs.read_string(?a, t_join_owned(?a, root, MANIFEST));
    if (sel text.err) { ret 9; }
    val with_b: res[str, std_format.FormatError] = std_format.sprint(?a, "{}{}", text.ok, t_dep_table_ref(?a, "vb", vb, "branch/main"));
    if (sel with_b.err)                          { ret 10; }
    if (!t_write(?a, root, MANIFEST, with_b.ok)) { ret 11; }
    var over: Vector[str] = t_notes_of(?a, root, false);
    if (!t_any_note(?over, "root declares vb by ref \"branch/main\", overriding root -> va 1.0.0 requires vb ~1.0")) { ret 12; }
    if (t_any_note(?over, "--offline"))                                                                              { ret 13; }
    ret 0;
}

# a path dependency `id` whose manifest declares `table`, a requirement the root may override
#[testing]
fun t_requiring_source(a: *A.Allocator, prefix: str, id: str, table: str) str {
    val dir: str = t_scratch(a, prefix);
    if (str_empty(dir)) { ret ""; }
    val body_r: res[str, std_format.FormatError] = std_format.sprint(a,
        "[project]\nid = \"{}\"\nversion = \"0.1.0\"\nsrc = \"src\"\nout = \"out\"\n[profile.debug]\nopt = 0\ndebug = false\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n{}", id, table);
    if (sel body_r.err)                        { ret ""; }
    if (!t_write(a, dir, MANIFEST, body_r.ok)) { ret ""; }
    if (!t_lib_module(a, dir))                 { ret ""; }
    ret dir;
}

# whether `w` records that it overrode `chain`, which asked for `asked`
#[testing]
fun t_overrode(w: *package_closure.Request, chain: str, asked: str) bool {
    var k: usize = 0;
    for (k < w.overrode.len) {
        if (str_equals(w.overrode.data[k].chain, chain) && str_equals(w.overrode.data[k].asked, asked)) { ret true; }
        k = k + 1;
    }
    ret false;
}

#[testing]
fun t_any_line(lines: *Vector[str], want: str) bool {
    var i: usize = 0;
    for (i < lines.len) {
        if (str_equals(lines.data[i], want)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# pull, update and list name every requirement a root selection overrides: a dependency whose
# range the root's older pin falls below, and one asking for another ref; one asking for the
# root's own ref is no override
test pull__pull_update_and_list_name_each_requirement_a_root_selection_overrides {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val vb: str = t_released(?a);
    if (str_empty(vb)) { ret 2; }
    fin { fs.remove_all(?a, vb); }
    val older: str = t_requiring_source(?a, "mach_dep_note_older", "older", t_dep_table_range(?a, "vb", vb, "^1.1"));
    if (str_empty(older)) { ret 3; }
    fin { fs.remove_all(?a, older); }
    val refd: str = t_requiring_source(?a, "mach_dep_note_refd", "refd", t_dep_table_ref(?a, "vb", vb, "tag/v1.1.0"));
    if (str_empty(refd)) { ret 3; }
    fin { fs.remove_all(?a, refd); }
    val agree: str = t_requiring_source(?a, "mach_dep_note_agree", "agree", t_dep_table_ref(?a, "vb", vb, "tag/v1.0.0"));
    if (str_empty(agree)) { ret 3; }
    fin { fs.remove_all(?a, agree); }
    val tables: res[str, std_format.FormatError] = std_format.sprint(?a, "{}{}{}{}", t_dep_table_ref(?a, "vb", vb, "tag/v1.0.0"),
        t_dep_table_path(?a, "older", older), t_dep_table_path(?a, "refd", refd), t_dep_table_path(?a, "agree", agree));
    if (sel tables.err) { ret 4; }
    val root: str = t_root_repo(?a, "mach_dep_note_root", tables.ok);
    if (str_empty(root)) { ret 4; }
    fin { fs.remove_all(?a, root); }
    var s:    session.Session;
    var mode: u8 = 0;
    if (!t_session_and_mode(?a, root, ?s, ?mode)) { ret 5; }
    fin { session.dnit(?s); }

    # pull
    var pulled: Vector[package_closure.Request] = collections_vector.init[package_closure.Request](?a);
    if (t_realize(?s, ?a, root, ?pulled, true, false, false, nil, nil) != 0) { ret 6; }
    val at: i64 = package_closure.index(?pulled, "vb");
    if (at < 0) { ret 7; }
    val won: *package_closure.Request = ?pulled.data[at::usize];
    if (won.overrode.len != 2)                                          { ret 8; }
    if (!t_overrode(won, "root -> older -> vb", "version = \"^1.1\""))  { ret 9; }
    if (!t_overrode(won, "root -> refd -> vb", "ref = \"tag/v1.1.0\"")) { ret 10; }
    val note: res[str, fail.Fail] = package.override_note(?a, won.id, won.decl, won.overrode.data[0].chain, won.overrode.data[0].asked);
    if (sel note.err)                                                                                                                                                                                                    { ret 11; }
    if (!str_equals(note.ok, "note: dependency 'vb': the root declares ref = \"tag/v1.0.0\", overriding root -> older -> vb which requires version = \"^1.1\"; nothing checks that 'vb' supports the root's selection")) { ret 12; }

    # update
    var edit: package_edit.Edit;
    val txn:  err[fail.Fail] = t_begin(?edit, ?a, root);
    if (sel txn.err) {
        t_finish(?edit, 1);
        ret 13;
    }
    var updated: Vector[package_closure.Request] = collections_vector.init[package_closure.Request](?a);
    val applied: i64                             = t_update(?s, ?a, root, mode, true, nil, true, false, false, ?updated, nil);
    if (t_finish(?edit, applied) != 0) { ret 14; }
    val up: i64 = package_closure.index(?updated, "vb");
    if (up < 0) { ret 15; }
    val upd: *package_closure.Request = ?updated.data[up::usize];
    if (upd.overrode.len != 2)                                          { ret 16; }
    if (!t_overrode(upd, "root -> older -> vb", "version = \"^1.1\""))  { ret 17; }
    if (!t_overrode(upd, "root -> refd -> vb", "ref = \"tag/v1.1.0\"")) { ret 18; }

    # list
    var lines: Vector[str] = collections_vector.init[str](?a);
    if (t_list(?s, ?a, root, ?lines) != 0)                                                            { ret 19; }
    if (!t_any_line(?lines, "    overrides root -> older -> vb, which requires version = \"^1.1\""))  { ret 20; }
    if (!t_any_line(?lines, "    overrides root -> refd -> vb, which requires ref = \"tag/v1.1.0\"")) { ret 21; }
    var overrides: usize = 0;
    var i:         usize = 0;
    for (i < lines.len) {
        if (str_starts_with(lines.data[i], "    overrides ")) { overrides = overrides + 1; }
        i = i + 1;
    }
    if (overrides != 2) { ret 22; }
    val vb_line: res[str, std_format.FormatError] = std_format.sprint(?a, "  vb  git={}  ref=tag/v1.0.0  pin=", vb);
    if (sel vb_line.err) { ret 23; }
    var listed: bool = false;
    i = 0;
    for (i < lines.len) {
        if (str_starts_with(lines.data[i], vb_line.ok) && t_contains(lines.data[i], "  realized")) { listed = true; }
        i = i + 1;
    }
    if (!listed) { ret 24; }
    ret 0;
}

# verify refuses a checkout that left its recorded gitlink, and a gitlink outside the root's own
# selection, each naming the `mach dep` command that fixes it; the build's refusal of the same
# two is asserted in mach.lang.driver:dep_git_checkout_uses_parent_gitlink_authority
test verify__drift_from_the_gitlink_or_the_selection_is_refused_naming_the_fix {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val vb: str = t_released(?a);
    if (str_empty(vb)) { ret 2; }
    fin { fs.remove_all(?a, vb); }
    val root: str = t_root_repo(?a, "mach_dep_drift_root", t_dep_table_ref(?a, "vb", vb, "tag/v1.0.0"));
    if (str_empty(root)) { ret 3; }
    fin { fs.remove_all(?a, root); }
    if (pull_project(root, true, git.t_file_transport_environ()) != 0) { ret 4; }
    if (!t_commit_all(?a, root))                                       { ret 4; }
    if (!str_empty(t_verify_refusal(?a, root)))                        { ret 5; }
    val dep_vb: str = t_join_owned(?a, root, "dep/vb");

    # the checkout moved and the gitlink did not: pull restores the recorded pin
    if (!t_git3(?a, dep_vb, "checkout", "-q", "v1.1.0", "", "")) { ret 7; }
    val left: str = t_verify_refusal(?a, root);
    if (!t_contains(left, "dependency 'vb': the checkout is at "))     { ret 8; }
    if (!t_contains(left, "but the recorded gitlink is "))             { ret 9; }
    if (!t_contains(left, "run `mach dep pull <path>` for project"))   { ret 10; }
    if (pull_project(root, true, git.t_file_transport_environ()) != 0) { ret 13; }
    if (!str_empty(t_verify_refusal(?a, root)))                        { ret 14; }

    # the gitlink moved outside `tag/v1.0.0`: pull keeps it, update re-pins it
    if (!t_git3(?a, dep_vb, "checkout", "-q", "v1.1.0", "", "")) { ret 15; }
    if (!t_git3(?a, root, "add", "dep/vb", "", "", ""))          { ret 15; }
    val outside: str = t_verify_refusal(?a, root);
    if (!t_contains(outside, "dependency 'vb': exact ref 'tag/v1.0.0' required by root -> vb resolves to ")) { ret 16; }
    if (!t_contains(outside, "run `mach dep update <path> vb` for project"))                                 { ret 17; }
    if (!t_contains(outside, "to re-pin it to the root's selection"))                                        { ret 18; }
    if (pull_project(root, true, git.t_file_transport_environ()) != 0)                                       { ret 21; }
    if (str_empty(t_verify_refusal(?a, root)))                                                               { ret 22; }
    if (t_run_remedy(?a, outside, root) != 0)                                                                { ret 23; }
    if (!str_empty(t_verify_refusal(?a, root)))                                                              { ret 24; }
    ret 0;
}

# a build never realizes a dependency: on a fresh clone, where dep/vb is the empty directory Git
# leaves for an uninitialized gitlink, it refuses naming `mach dep pull` and leaves dep/ as it
# found it
test pull__a_build_refuses_an_unrealized_dependency_and_realizes_nothing {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val vb: str = t_released(?a);
    if (str_empty(vb)) { ret 2; }
    fin { fs.remove_all(?a, vb); }
    val proj: str = t_root_repo(?a, "mach_dep_unrealized_src", t_dep_table_ref(?a, "vb", vb, "tag/v1.0.0"));
    if (str_empty(proj)) { ret 3; }
    fin { fs.remove_all(?a, proj); }
    if (pull_project(proj, true, git.t_file_transport_environ()) != 0) { ret 4; }
    if (!t_commit_all(?a, proj))                                       { ret 4; }
    val clone: str = t_scratch(?a, "mach_dep_unrealized_dst");
    if (str_empty(clone)) { ret 5; }
    fin { fs.remove_all(?a, clone); }
    var av: [6]*u8;
    av[0] = ""::*u8;
    av[1] = "clone"::*u8;
    av[2] = "-q"::*u8;
    av[3] = proj::*u8;
    av[4] = clone::*u8;
    av[5] = nil;
    if (!t_git(?a, ?av[0]))                       { ret 6; }
    if (!t_exists_under(?a, clone, "dep/vb"))     { ret 7; }
    if (t_exists_under(?a, clone, "dep/vb/.git")) { ret 7; }
    var s:    session.Session;
    var mode: u8 = 0;
    if (!t_session_and_mode(?a, clone, ?s, ?mode)) { ret 8; }
    fin { session.dnit(?s); }

    val placeholder: str = t_build_refusal(?s, clone);
    if (!t_contains(placeholder, "dependency 'vb' is missing")) { ret 9; }
    if (!t_contains(placeholder, "run `mach dep pull "))        { ret 10; }
    if (t_exists_under(?a, clone, "dep/vb/.git"))               { ret 11; }
    if (t_exists_under(?a, clone, "dep/vb/mach.toml"))          { ret 12; }

    if (!t_git3(?a, clone, "config", "protocol.file.allow", "always", "", "")) { ret 17; }
    if (pull_project(clone, true, git.t_file_transport_environ()) != 0)        { ret 18; }
    if (!str_empty(t_build_refusal(?s, clone)))                                { ret 19; }
    ret 0;
}

# pull and update report whether each path copy was refreshed from its source or reused as it
# stood
test pull__a_path_copy_reports_whether_it_was_refreshed_or_reused {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val source: str = t_path_source(?a, "mach_dep_copy_report_source", "pub fun v() i32 { ret 1; }\n");
    if (str_empty(source)) { ret 2; }
    fin { fs.remove_all(?a, source); }
    val root: str = t_root_repo(?a, "mach_dep_copy_report_root", t_dep_table_path(?a, "local", source));
    if (str_empty(root)) { ret 3; }
    fin { fs.remove_all(?a, root); }
    var s:    session.Session;
    var mode: u8 = 0;
    if (!t_session_and_mode(?a, root, ?s, ?mode)) { ret 4; }
    fin { session.dnit(?s); }

    var first: Vector[package_closure.Request] = collections_vector.init[package_closure.Request](?a);
    if (t_realize(?s, ?a, root, ?first, true, false, false, nil, nil) != 0)                                 { ret 5; }
    if (first.data[package_closure.index(?first, "local")::usize].copied != package_closure.COPY_REFRESHED) { ret 6; }
    var again: Vector[package_closure.Request] = collections_vector.init[package_closure.Request](?a);
    if (t_realize(?s, ?a, root, ?again, true, false, false, nil, nil) != 0)                              { ret 7; }
    if (again.data[package_closure.index(?again, "local")::usize].copied != package_closure.COPY_REUSED) { ret 8; }

    if (!t_write(?a, source, "src/lib.mach", "pub fun v() i32 { ret 2; }\n")) { ret 9; }
    var edit: package_edit.Edit;
    val txn:  err[fail.Fail] = t_begin(?edit, ?a, root);
    if (sel txn.err) {
        t_finish(?edit, 1);
        ret 10;
    }
    var updated: Vector[package_closure.Request] = collections_vector.init[package_closure.Request](?a);
    if (t_finish(?edit, t_update(?s, ?a, root, mode, true, nil, true, false, false, ?updated, nil)) != 0)       { ret 11; }
    if (updated.data[package_closure.index(?updated, "local")::usize].copied != package_closure.COPY_REFRESHED) { ret 12; }
    if (!t_read_is(?a, root, "dep/local/src/lib.mach", "pub fun v() i32 { ret 2; }\n"))                         { ret 13; }
    val again_txn: err[fail.Fail] = t_begin(?edit, ?a, root);
    if (sel again_txn.err) {
        t_finish(?edit, 1);
        ret 14;
    }
    var unchanged: Vector[package_closure.Request] = collections_vector.init[package_closure.Request](?a);
    if (t_finish(?edit, t_update(?s, ?a, root, mode, true, nil, true, false, false, ?unchanged, nil)) != 0)      { ret 15; }
    if (unchanged.data[package_closure.index(?unchanged, "local")::usize].copied != package_closure.COPY_REUSED) { ret 16; }
    ret 0;
}
