val MANIFEST: str = manifest.MANIFEST_FILE;

# which action argv[2] named, as ActionSpec.id carries it
def Action: u8;
# `mach dep list`
val ACTION_LIST: Action = 0;
# `mach dep add`
val ACTION_ADD: Action = 1;
# `mach dep remove`
val ACTION_REMOVE: Action = 2;
# `mach dep update`
val ACTION_UPDATE: Action = 3;
# `mach dep pull`
val ACTION_PULL: Action = 4;
# `mach dep verify`
val ACTION_VERIFY: Action = 5;
# `mach dep outdated`
val ACTION_OUTDATED: Action = 6;

# `--git <url>`
val GIT: args.FlagSpec = args.FlagSpec{name: "--git", value: "url", arity: args.ARITY_VALUE, doc: "use a Git URL source", default: "", repeatable: false, alias_of: nil};
# `--path <dir>`
val PATH: args.FlagSpec = args.FlagSpec{name: "--path", value: "dir", arity: args.ARITY_VALUE, doc: "use a local path source", default: "", repeatable: false, alias_of: nil};
# `--ref <ref>`
val REF: args.FlagSpec = args.FlagSpec{name: "--ref", value: "branch/<n>|tag/<n>|commit/<n>", arity: args.ARITY_VALUE, doc: "select a Git reference", default: "", repeatable: false, alias_of: nil};
# `--range <range>`
val RANGE: args.FlagSpec = args.FlagSpec{name: "--range", value: "range", arity: args.ARITY_VALUE, doc: "select releases in a version range", default: "^ of the highest compatible release", repeatable: false, alias_of: nil};
# `--purge`
val PURGE: args.FlagSpec = args.FlagSpec{name: "--purge", value: "", arity: args.ARITY_FLAG, doc: "also delete the dependency directory", default: "", repeatable: false, alias_of: nil};
# `--lowest`
val LOWEST: args.FlagSpec = args.FlagSpec{name: "--lowest", value: "", arity: args.ARITY_FLAG, doc: "select the lowest release every range accepts", default: "", repeatable: false, alias_of: nil};
# `--release`
val RELEASE: args.FlagSpec = args.FlagSpec{name: "--release", value: "", arity: args.ARITY_FLAG, doc: "also require every dependency of the project itself to be selected by `version` or an exact `tag/`", default: "", repeatable: false, alias_of: nil};

# what `--quiet` suppresses for a dep action
val QUIETNESS_DOCS: [args.QUIETNESS_N]str = [args.QUIETNESS_N]str{"suppress routine output", "suppress routine output"};
# what `--offline` does for dep outdated
val OUTDATED_OFFLINE_DOCS: [args.OFFLINES_N]str = [args.OFFLINES_N]str{"report from releases already fetched"};

# length of TABLES
val TABLES_N: usize = 1;
# the option tables every dep action accepts; an action's own come from ACTIONS
val TABLES: [TABLES_N]args.TableRef = [TABLES_N]args.TableRef{
    args.TableRef{rows: ?args.QUIETNESS[0], n: args.QUIETNESS_N, accepted: nil, docs: ?QUIETNESS_DOCS[0]},
};

# row count of ADD_OWN
val ADD_OWN_N: usize = 4;
# the sources and selections of dep add
val ADD_OWN: [ADD_OWN_N]*args.FlagSpec = [ADD_OWN_N]*args.FlagSpec{?GIT, ?PATH, ?REF, ?RANGE};
# length of ADD_TABLES
val ADD_TABLES_N: usize = 2;
# the option tables of dep add
val ADD_TABLES: [ADD_TABLES_N]args.TableRef = [ADD_TABLES_N]args.TableRef{
    args.TableRef{rows: ?ADD_OWN[0], n: ADD_OWN_N, accepted: nil, docs: nil},
    args.TableRef{rows: ?args.OFFLINES[0], n: args.OFFLINES_N, accepted: nil, docs: nil},
};
# length of ADD_RELATIONS
val ADD_RELATIONS_N: usize = 6;
# a dependency has one source, and a reference or a range selects only a Git one
val ADD_RELATIONS: [ADD_RELATIONS_N]args.Relation = [ADD_RELATIONS_N]args.Relation{
    args.Relation{kind: args.RELATION_CONFLICTS, row: ?GIT, other: ?PATH},
    args.Relation{kind: args.RELATION_CONFLICTS, row: ?PATH, other: ?REF},
    args.Relation{kind: args.RELATION_CONFLICTS, row: ?PATH, other: ?RANGE},
    args.Relation{kind: args.RELATION_CONFLICTS, row: ?REF, other: ?RANGE},
    args.Relation{kind: args.RELATION_REQUIRES, row: ?REF, other: ?GIT},
    args.Relation{kind: args.RELATION_REQUIRES, row: ?RANGE, other: ?GIT},
};
# length of ADD_CONSTRAINTS
val ADD_CONSTRAINTS_N: usize = 1;
# the constraint help prints for dep add beside its relations; the dep command enforces it
val ADD_CONSTRAINTS: [ADD_CONSTRAINTS_N]str = [ADD_CONSTRAINTS_N]str{
    "exactly one of --git or --path is required",
};

# row count of REMOVE_OWN
val REMOVE_OWN_N: usize = 1;
# the options of dep remove
val REMOVE_OWN: [REMOVE_OWN_N]*args.FlagSpec = [REMOVE_OWN_N]*args.FlagSpec{?PURGE};
# length of REMOVE_TABLES
val REMOVE_TABLES_N: usize = 1;
# the option tables of dep remove
val REMOVE_TABLES: [REMOVE_TABLES_N]args.TableRef = [REMOVE_TABLES_N]args.TableRef{
    args.TableRef{rows: ?REMOVE_OWN[0], n: REMOVE_OWN_N, accepted: nil, docs: nil},
};

# row count of UPDATE_OWN
val UPDATE_OWN_N: usize = 1;
# the options only dep update accepts
val UPDATE_OWN: [UPDATE_OWN_N]*args.FlagSpec = [UPDATE_OWN_N]*args.FlagSpec{?LOWEST};
# SEL rows dep update accepts: `--all`, every dependency where a name would select one
val UPDATE_SEL_ACCEPTED: [args.SEL_N]bool = [args.SEL_N]bool{false, false, false, false, false, false, true, false};
# what `--all` selects for dep update
val UPDATE_SEL_DOCS: [args.SEL_N]str = [args.SEL_N]str{"", "", "", "", "", "", "update every declared dependency", ""};
# length of UPDATE_TABLES
val UPDATE_TABLES_N: usize = 3;
# the option tables of dep update
val UPDATE_TABLES: [UPDATE_TABLES_N]args.TableRef = [UPDATE_TABLES_N]args.TableRef{
    args.TableRef{rows: ?args.SEL[0], n: args.SEL_N, accepted: ?UPDATE_SEL_ACCEPTED[0], docs: ?UPDATE_SEL_DOCS[0]},
    args.TableRef{rows: ?UPDATE_OWN[0], n: UPDATE_OWN_N, accepted: nil, docs: nil},
    args.TableRef{rows: ?args.OFFLINES[0], n: args.OFFLINES_N, accepted: nil, docs: nil},
};
# length of UPDATE_CONSTRAINTS
val UPDATE_CONSTRAINTS_N: usize = 1;
# the constraint help prints for dep update; the dep command enforces it
val UPDATE_CONSTRAINTS: [UPDATE_CONSTRAINTS_N]str = [UPDATE_CONSTRAINTS_N]str{
    "a dependency name and --all cannot be combined",
};

# length of OUTDATED_TABLES
val OUTDATED_TABLES_N: usize = 1;
# the option tables of dep outdated
val OUTDATED_TABLES: [OUTDATED_TABLES_N]args.TableRef = [OUTDATED_TABLES_N]args.TableRef{
    args.TableRef{rows: ?args.OFFLINES[0], n: args.OFFLINES_N, accepted: nil, docs: ?OUTDATED_OFFLINE_DOCS[0]},
};

# row count of VERIFY_OWN
val VERIFY_OWN_N: usize = 1;
# the options of dep verify
val VERIFY_OWN: [VERIFY_OWN_N]*args.FlagSpec = [VERIFY_OWN_N]*args.FlagSpec{?RELEASE};
# length of VERIFY_TABLES
val VERIFY_TABLES_N: usize = 1;
# the option tables of dep verify
val VERIFY_TABLES: [VERIFY_TABLES_N]args.TableRef = [VERIFY_TABLES_N]args.TableRef{
    args.TableRef{rows: ?VERIFY_OWN[0], n: VERIFY_OWN_N, accepted: nil, docs: nil},
};
# length of VERIFY_EXITS
val VERIFY_EXITS_N: usize = 1;
# the exit codes dep verify documents beside exit.SHARED
val VERIFY_EXITS: [VERIFY_EXITS_N]exit.Note = [VERIFY_EXITS_N]exit.Note{
    exit.Note{code: exit.USER, meaning: "a realized closure that does not match the manifest"},
};

# length of ACTIONS
val ACTIONS_N: usize = 7;
# the dep actions in help order
val ACTIONS: [ACTIONS_N]args.ActionSpec = [ACTIONS_N]args.ActionSpec{
    args.ActionSpec{name: "list", id: ACTION_LIST, grammar: " <path>", effect: "list declared dependencies and their state", exits: nil, exit_n: 0, tables: nil, table_n: 0, relations: nil, relation_n: 0, constraints: nil, constraint_n: 0, operand_min: 1, operand_max: 1, examples: nil, example_n: 0},
    args.ActionSpec{name: "add", id: ACTION_ADD, grammar: " <path> <name> (--git <url> [--ref <ref> | --range <range>] | --path <dir>) [--offline]", effect: "declare a dependency and realize the dependency tree", exits: nil, exit_n: 0, tables: ?ADD_TABLES[0], table_n: ADD_TABLES_N, relations: ?ADD_RELATIONS[0], relation_n: ADD_RELATIONS_N, constraints: ?ADD_CONSTRAINTS[0], constraint_n: ADD_CONSTRAINTS_N, operand_min: 2, operand_max: 2, examples: nil, example_n: 0},
    args.ActionSpec{name: "remove", id: ACTION_REMOVE, grammar: " <path> <name> [--purge]", effect: "remove a dependency declaration and optionally its directory", exits: nil, exit_n: 0, tables: ?REMOVE_TABLES[0], table_n: REMOVE_TABLES_N, relations: nil, relation_n: 0, constraints: nil, constraint_n: 0, operand_min: 2, operand_max: 2, examples: nil, example_n: 0},
    args.ActionSpec{name: "update", id: ACTION_UPDATE, grammar: " <path> (<name> | --all) [--lowest] [--offline]", effect: "recopy path dependencies from their sources (as pull does, since a path dependency has no pin to move), advance branch references, and resolve version ranges to the releases they select", exits: nil, exit_n: 0, tables: ?UPDATE_TABLES[0], table_n: UPDATE_TABLES_N, relations: nil, relation_n: 0, constraints: ?UPDATE_CONSTRAINTS[0], constraint_n: UPDATE_CONSTRAINTS_N, operand_min: 1, operand_max: 2, examples: nil, example_n: 0},
    args.ActionSpec{name: "pull", id: ACTION_PULL, grammar: " <path>", effect: "realize declared dependencies without advancing revisions; a path dependency is recopied from its source, overwriting local edits under dep/, as update does", exits: nil, exit_n: 0, tables: nil, table_n: 0, relations: nil, relation_n: 0, constraints: nil, constraint_n: 0, operand_min: 1, operand_max: 1, examples: nil, example_n: 0},
    args.ActionSpec{name: "outdated", id: ACTION_OUTDATED, grammar: " <path> [--offline]", effect: "report each version-selected dependency's pinned, highest compatible and latest release", exits: nil, exit_n: 0, tables: ?OUTDATED_TABLES[0], table_n: OUTDATED_TABLES_N, relations: nil, relation_n: 0, constraints: nil, constraint_n: 0, operand_min: 1, operand_max: 1, examples: nil, example_n: 0},
    args.ActionSpec{name: "verify", id: ACTION_VERIFY, grammar: " <path> [--release]", effect: "check the realized dependency closure against the manifest without changing anything", exits: ?VERIFY_EXITS[0], exit_n: VERIFY_EXITS_N, tables: ?VERIFY_TABLES[0], table_n: VERIFY_TABLES_N, relations: nil, relation_n: 0, constraints: nil, constraint_n: 0, operand_min: 1, operand_max: 1, examples: nil, example_n: 0},
};

# `mach dep`
pub val COMMAND: args.CommandSpec = args.CommandSpec{name: "dep", aliases: nil, alias_n: 0, grammar: " <action> [args] [options]", summary: "manage project dependencies", effect: "inspect or mutate the project dependency tree according to the selected action", exits: nil, exit_n: 0, terminator: "", tables: ?TABLES[0], table_n: TABLES_N, refused: nil, refused_n: 0, refusal: "", relations: nil, relation_n: 0, constraints: nil, constraint_n: 0, operand_min: 0, operand_max: args.OPERANDS_ANY, truncate_at_sep: false, actions: ?ACTIONS[0], action_n: ACTIONS_N, examples: nil, example_n: 0, run: run};

# the dep options an invocation was given
# ---
# quiet:   `--quiet`
# all:     `--all`
# purge:   `--purge`
# lowest:  `--lowest`
# offline: `--offline`
# release: `--release`
# git:     the `--git` url
# path:    the `--path` directory
# ref:     the `--ref` reference
# range:   the `--range` range
rec Options {
    quiet:   bool;
    all:     bool;
    purge:   bool;
    lowest:  bool;
    offline: bool;
    release: bool;
    git:     opt[*u8];
    path:    opt[*u8];
    ref:     opt[*u8];
    range:   opt[*u8];
}

fun options_of(inv: *args.ParsedInvocation, argv: **u8) Options {
    ret Options{
        quiet:  args.given(inv, ?args.QUIET), all: args.given(inv, ?args.ALL), purge: args.given(inv, ?PURGE),
        lowest: args.given(inv, ?LOWEST), offline: args.given(inv, ?args.OFFLINE), release: args.given(inv, ?RELEASE),
        git:    args.value(inv, argv, ?GIT), path: args.value(inv, argv, ?PATH), ref: args.value(inv, argv, ?REF),
        range:  args.value(inv, argv, ?RANGE)
    };
}

# `mach dep`: route to one action: list, add, remove, update, pull, verify or outdated, each a
# command over the dependency manager (mach.lang.package) that renders what it reports
# ---
# cx:  the call, its action read and its operands counted
# ret: exit.OK, the code `exit.of` maps the action's rendered failure to, or the failure that
#      kept the action from starting
pub fun run(cx: *args.Call) res[i64, fail.Fail] {
    val inv:    *args.ParsedInvocation = cx.inv;
    var parsed: Options                = options_of(inv, cx.argv);
    val action: Action                 = inv.action.id;

    val project: *u8                                  = cx.argv[inv.positional_idx];
    val loc_r:   res[util.ProjectLocation, fail.Fail] = util.resolve_project_location(cx.a, project::str);
    if (sel loc_r.err) {
        val said: res[str, std_format.FormatError] = std_format.sprint(cx.a, "mach dep {} project '{}': {}", inv.action.name, project::str, fail.describe(loc_r.err));
        if (sel said.err) { ret res[i64, fail.Fail].err{loc_r.err}; }
        ret res[i64, fail.Fail].err{fail.owning(fail.with_text(loc_r.err, said.ok))};
    }
    val root: str = loc_r.ok.root;
    var name: *u8 = nil;
    if (inv.positional_count == 2) { name = cx.argv[inv.positional_idxs[1]]; }

    val a:       *A.Allocator     = cx.a;
    val environ: exec.Environment = inv.environ;
    if (action == ACTION_LIST)     { ret dep_list(a, root, environ); }
    if (action == ACTION_ADD)      { ret dep_add(a, root, name, ?parsed, environ); }
    if (action == ACTION_REMOVE)   { ret dep_remove(a, root, name, ?parsed, environ); }
    if (action == ACTION_UPDATE)   { ret dep_update(a, root, name, ?parsed, environ); }
    if (action == ACTION_PULL)     { ret pull_project(a, root, parsed.quiet, environ); }
    if (action == ACTION_OUTDATED) { ret dep_outdated(a, root, parsed.offline, environ); }
    ret verify_project(a, root, parsed.release, environ);
}

# a session for a dependency action, running git in environ
fun dep_session(a: *A.Allocator, environ: exec.Environment) res[session.Session, fail.Fail] {
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(a);
    if (sel sr.err) { ret res[session.Session, fail.Fail].err{fail.prefixed(a, "failed to initialise a session: ", sr.err)}; }
    var s: session.Session = sr.ok;
    s.environ = environ;
    ret res[session.Session, fail.Fail].ok{s};
}

# `mach dep pull`: realize the dependency closure of a project (package_pull.project_closure)
# ---
# a:       owns what the pull allocates
# root:    the project root directory
# quiet:   suppress progress lines
# environ: the environment git runs in
# ret:     exit.OK when realized, the code `exit.of` maps the rendered failure to, or the failure
#          that kept the pull from starting
fun pull_project(a: *A.Allocator, root: str, quiet: bool, environ: exec.Environment) res[i64, fail.Fail] {
    val sr: res[session.Session, fail.Fail] = dep_session(a, environ);
    if (sel sr.err) { ret res[i64, fail.Fail].err{sr.err}; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var rep: report.Report = cli_diagnostic.dependency_report(a);
    fin { report.dnit(?rep); }
    ret res[i64, fail.Fail].ok{cli_diagnostic.dependency_outcome(?rep, package_pull.project_closure(?s, a, root, quiet, ?rep))};
}

# `mach dep verify`: check that every dependency of a project is realized and consistent
# without changing anything (package_verify.project_closure); prints "ok" on success
# ---
# a:       owns what the check allocates
# root:    the project root directory
# release: also refuse a root dependency selected by a branch, a commit or a path
# environ: the environment git runs in
# ret:     exit.OK when verified, exit.USER for a directory outside the closure, otherwise the
#          code `exit.of` maps the rendered failure to, or the failure that kept it from starting
fun verify_project(a: *A.Allocator, root: str, release: bool, environ: exec.Environment) res[i64, fail.Fail] {
    val sr: res[session.Session, fail.Fail] = dep_session(a, environ);
    if (sel sr.err) { ret res[i64, fail.Fail].err{sr.err}; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var rep: report.Report = cli_diagnostic.dependency_report(a);
    fin { report.dnit(?rep); }
    val rc: i64 = cli_diagnostic.dependency_outcome(?rep, package_verify.project_closure(?s, a, root, release, ?rep));
    if (rc == exit.OK) { print.print("ok\n"); }
    ret res[i64, fail.Fail].ok{rc};
}

# `mach dep outdated`: each version-selected identity's pinned release, the highest this
# compiler and every range accept, and the highest release published
fun dep_outdated(a: *A.Allocator, root: str, offline: bool, environ: exec.Environment) res[i64, fail.Fail] {
    val sr: res[session.Session, fail.Fail] = dep_session(a, environ);
    if (sel sr.err) { ret res[i64, fail.Fail].err{sr.err}; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var rep: report.Report = cli_diagnostic.dependency_report(a);
    fin { report.dnit(?rep); }
    val opened: res[package_closure.Operation, fail.Fail] = package_closure.open(?s, a, root, ?rep);
    if (sel opened.err) { ret res[i64, fail.Fail].err{opened.err}; }
    var op: package_closure.Operation = opened.ok;
    fin { package_closure.close(?op); }
    val mt_path_r: res[str, A.Error] = types_path.join(a, root, MANIFEST);
    if (sel mt_path_r.err) { ret res[i64, fail.Fail].err{fail.refused(mt_path_r.err)}; }
    val mt_r: res[manifest.Doc, fail.Fail] = package_closure.parse_file(a, mt_path_r.ok);
    if (sel mt_r.err) { ret res[i64, fail.Fail].err{mt_r.err}; }
    var mt:       manifest.Doc                             = mt_r.ok;
    val computed: res[package_resolve.Outdated, fail.Fail] = package_resolve.outdated(?op, ?mt, offline);
    if (sel computed.err) { ret res[i64, fail.Fail].ok{cli_diagnostic.dependency_outcome(?rep, err[fail.Fail].err{computed.err})}; }
    var shown: package_resolve.Outdated = computed.ok;
    var i:     usize                    = 0;
    for (i < shown.notes.len) {
        print.printlnf("{}", shown.notes.data[i]);
        i = i + 1;
    }
    if (!shown.ranged) {
        print.print("no dependency selects releases by version\n");
        ret res[i64, fail.Fail].ok{exit.OK};
    }
    print.print("dependency  pinned  compatible  latest\n");
    i = 0;
    for (i < shown.rows.len) {
        val row: *package_resolve.OutdatedRow = ?shown.rows.data[i];
        i = i + 1;
        var note: str = "";
        if (!str_equals(row.latest, row.compatible)) { note = "  (held back: a range excludes the newer release, or it needs a newer compiler)"; }
        print.printlnf("{}  {}  {}  {}{}", row.id, row.pinned, row.compatible, row.latest, note);
    }
    ret res[i64, fail.Fail].ok{exit.OK};
}

# the refusal of a dependency name that is no portable identifier
fun invalid_name() res[i64, fail.Fail] {
    ret res[i64, fail.Fail].err{fail.user(diagnostic_kind.MANIFEST_INVALID_NAME, "dependency name must be a portable identifier (letters, digits, '_', '-')")};
}

fun dep_update(a: *A.Allocator, root: str, name: *u8, parsed: *Options, environ: exec.Environment) res[i64, fail.Fail] {
    val all: bool = parsed.all;
    if (!all && name == nil)                             { ret res[i64, fail.Fail].err{fail.user(diagnostic_kind.CLI_OPERAND, "usage: mach dep update <path> (<name> | --all)")}; }
    if (all && name != nil)                              { ret res[i64, fail.Fail].err{fail.user(diagnostic_kind.CLI_FLAG_CONFLICT, "give a name or --all, not both")}; }
    if (name != nil && !manifest.is_valid_id(name::str)) { ret invalid_name(); }

    val sr: res[session.Session, fail.Fail] = dep_session(a, environ);
    if (sel sr.err) { ret res[i64, fail.Fail].err{sr.err}; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var rep: report.Report = cli_diagnostic.dependency_report(a);
    fin { report.dnit(?rep); }
    ret res[i64, fail.Fail].ok{cli_diagnostic.dependency_outcome(?rep, package_edit.update(?s, a, root, all, name::str, parsed.quiet, parsed.lowest, parsed.offline, ?rep))};
}

fun dep_add(a: *A.Allocator, root: str, name: *u8, parsed: *Options, environ: exec.Environment) res[i64, fail.Fail] {
    val opt_git:  opt[*u8] = parsed.git;
    val opt_path: opt[*u8] = parsed.path;
    val opt_ref:  opt[*u8] = parsed.ref;
    val opt_ver:  opt[*u8] = parsed.range;
    val has_git:  bool     = sel opt_git.some;
    val has_path: bool     = sel opt_path.some;
    if (!has_git && !has_path) {
        ret res[i64, fail.Fail].err{fail.user(diagnostic_kind.DEP_SOURCE_COUNT, "give exactly one source: --git <url> or --path <dir>")};
    }
    if (!manifest.is_valid_id(name::str)) { ret invalid_name(); }

    var spec: manifest.DepTableSpec;
    spec.name = name::str;
    if (has_git) {
        spec.source  = manifest.DEP_SOURCE_GIT;
        spec.value   = opt_value(opt_git)::str;
        spec.ref     = opt_value(opt_ref)::str;
        spec.version = opt_value(opt_ver)::str;
        if (spec.ref == nil)     { spec.ref = ""; }
        if (spec.version == nil) { spec.version = ""; }
    }
    or {
        spec.source  = manifest.DEP_SOURCE_PATH;
        spec.value   = opt_value(opt_path)::str;
        spec.ref     = "";
        spec.version = "";
    }
    ret mutate_manifest(a, root, ?spec, name::str, true, false, parsed.quiet, true, parsed.offline, environ);
}

fun dep_remove(a: *A.Allocator, root: str, name: *u8, parsed: *Options, environ: exec.Environment) res[i64, fail.Fail] {
    if (!manifest.is_valid_id(name::str)) { ret invalid_name(); }
    var spec: manifest.DepTableSpec;
    spec.name   = name::str;
    spec.source = manifest.DEP_SOURCE_PATH;
    spec.value  = "";
    spec.ref    = "";
    ret mutate_manifest(a, root, ?spec, name::str, false, parsed.purge, parsed.quiet, true, false, environ);
}

fun mutate_manifest(a: *A.Allocator, root: str, spec: *manifest.DepTableSpec, name: str, adding: bool, purge: bool,
    quiet: bool, realize: bool, offline: bool, environ: exec.Environment) res[i64, fail.Fail] {
    val sr: res[session.Session, fail.Fail] = dep_session(a, environ);
    if (sel sr.err) { ret res[i64, fail.Fail].err{sr.err}; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var rep: report.Report = cli_diagnostic.dependency_report(a);
    fin { report.dnit(?rep); }
    ret res[i64, fail.Fail].ok{cli_diagnostic.dependency_outcome(?rep, package_edit.change(?s, a, root, spec, name, adding, purge, quiet, realize, offline, ?rep))};
}

fun dep_list(a: *A.Allocator, root: str, environ: exec.Environment) res[i64, fail.Fail] {
    val sr: res[session.Session, fail.Fail] = dep_session(a, environ);
    if (sel sr.err) { ret res[i64, fail.Fail].err{sr.err}; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var rep: report.Report = cli_diagnostic.dependency_report(a);
    fin { report.dnit(?rep); }
    val opened: res[package_closure.Operation, fail.Fail] = package_closure.open(?s, a, root, ?rep);
    if (sel opened.err) { ret res[i64, fail.Fail].err{opened.err}; }
    var op: package_closure.Operation = opened.ok;
    fin { package_closure.close(?op); }
    var lines: Vector[str] = collections_vector.init[str](a);
    val rc:    i64         = cli_diagnostic.dependency_outcome(?rep, package_list.lines(?op, ?lines));
    var i:     usize       = 0;
    for (i < lines.len) {
        print.printlnf("{}", lines.data[i]);
        i = i + 1;
    }
    ret res[i64, fail.Fail].ok{rc};
}

fun opt_value(found: opt[*u8]) *u8 {
    if (sel found.none) { ret ""; }
    ret found.some;
}
