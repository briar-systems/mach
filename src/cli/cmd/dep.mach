fun t_git(a: *A.Allocator, argv: **u8) bool {
    val gr: R.Result[str, str] = exec.resolve(a, "git");
    if (R.is_err[str, str](gr)) { ret false; }
    val git: str = R.unwrap_ok[str, str](gr);
    argv[0] = git::*u8;
    val rr: R.Result[exec.ExitStatus, str] = exec.run(git, argv, nil);
    if (R.is_err[exec.ExitStatus, str](rr)) { ret false; }
    val st: exec.ExitStatus = R.unwrap_ok[exec.ExitStatus, str](rr);
    ret exec.exited(st) && exec.code(st) == 0;
}

fun t_git3(a: *A.Allocator, dir: str, c1: str, c2: str, c3: str, c4: str, c5: str) bool {
    var av: [9]*u8;
    av[0] = ""::*u8;
    av[1] = "-C"::*u8;
    av[2] = dir::*u8;
    var k: usize = 3;
    if (!str_empty(c1)) { av[k] = c1::*u8; k = k + 1; }
    if (!str_empty(c2)) { av[k] = c2::*u8; k = k + 1; }
    if (!str_empty(c3)) { av[k] = c3::*u8; k = k + 1; }
    if (!str_empty(c4)) { av[k] = c4::*u8; k = k + 1; }
    if (!str_empty(c5)) { av[k] = c5::*u8; k = k + 1; }
    av[k] = nil;
    ret t_git(a, ?av[0]);
}

fun t_scratch(a: *A.Allocator, prefix: str) str {
    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(a, prefix);
    if (R.is_err[fs.TempFile, str](tf_r)) { ret ""; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);
    val p: str = own(a, fs.temp_path(?tf));
    fs.temp_close_and_remove(?tf);
    if (O.is_some[str](fs.create_dir_all(a, p, 0o755))) { ret ""; }
    ret p;
}

fun t_write(a: *A.Allocator, dir: str, leaf: str, body: str) bool {
    val p_r: R.Result[str, str] = path.join(a, dir, leaf);
    if (R.is_err[str, str](p_r)) { ret false; }
    val p: str = R.unwrap_ok[str, str](p_r);
    ret O.is_none[str](fs.write_bytes(p, body::*u8, str_len(body), 0o644));
}

fun t_init_repo(a: *A.Allocator, dir: str) bool {
    if (!t_git3(a, dir, "init", "-b", "main", "", "")) { ret false; }
    if (!t_git3(a, dir, "config", "user.email", "t@t", "", "")) { ret false; }
    if (!t_git3(a, dir, "config", "user.name", "t", "", "")) { ret false; }
    ret t_git3(a, dir, "config", "protocol.file.allow", "always", "", "");
}

fun t_commit_all(a: *A.Allocator, dir: str) bool {
    if (!t_git3(a, dir, "add", "-A", "", "", "")) { ret false; }
    ret t_git3(a, dir, "commit", "-qm", "x", "", "");
}

fun t_package_repo(a: *A.Allocator, prefix: str, id: str, extra: str) str {
    val dir: str = t_scratch(a, prefix);
    if (str_empty(dir)) { ret ""; }
    val body_r: R.Result[str, str] = format.sprint(a,
        "[project]\nid = \"{}\"\nversion = \"0.1.0\"\nsrc = \"src\"\nout = \"out\"\n{}", id, extra);
    if (R.is_err[str, str](body_r)) { ret ""; }
    if (!t_write(a, dir, MANIFEST, R.unwrap_ok[str, str](body_r))) { ret ""; }
    if (!t_lib_module(a, dir)) { ret ""; }
    if (!t_init_repo(a, dir)) { ret ""; }
    if (!t_commit_all(a, dir)) { ret ""; }
    ret dir;
}

fun t_lib_module(a: *A.Allocator, dir: str) bool {
    val src_r: R.Result[str, str] = path.join(a, dir, "src");
    if (R.is_err[str, str](src_r)) { ret false; }
    if (O.is_some[str](fs.create_dir_all(a, R.unwrap_ok[str, str](src_r), 0o755))) { ret false; }
    ret t_write(a, dir, "src/lib.mach", "pub fun hello() i32 { ret 1; }\n");
}

fun t_dep_table(a: *A.Allocator, name: str, url: str) str {
    ret t_dep_table_ref(a, name, url, "branch/main");
}

fun t_dep_verify_cli(a: *A.Allocator, root: str) i64 {
    var av: [4]*u8;
    av[0] = "mach"::*u8;
    av[1] = "dep"::*u8;
    av[2] = "verify"::*u8;
    av[3] = root::*u8;
    val ir: R.Result[args.ParsedInvocation, str] = args.parse_invocation(a, 4, ?av[0]);
    if (R.is_err[args.ParsedInvocation, str](ir)) { ret -1; }
    var inv: args.ParsedInvocation = R.unwrap_ok[args.ParsedInvocation, str](ir);
    if (!inv.has_action || inv.action != args.DEPACT_VERIFY) { ret -1; }
    ret run_typed(?av[0], ?inv);
}

fun t_exists_under(a: *A.Allocator, root: str, rel: str) bool {
    val p_r: R.Result[str, str] = path.join(a, root, rel);
    if (R.is_err[str, str](p_r)) { ret false; }
    ret fs.exists(R.unwrap_ok[str, str](p_r));
}

test "mach.cli.cmd.dep.closure:three_packages_land_flat_under_the_root" {
    var a: A.Allocator;
    if (O.is_some[str](page.make(?a))) { ret 1; }

    val fix_b: str = t_package_repo(?a, "mach_dep_fix_b", "b", "");
    if (str_empty(fix_b)) { ret 1; }
    val fix_a: str = t_package_repo(?a, "mach_dep_fix_a", "a", t_dep_table(?a, "b", fix_b));
    if (str_empty(fix_a)) { ret 1; }

    val outer: str = t_scratch(?a, "mach_dep_outer");
    if (str_empty(outer)) { ret 1; }
    if (!t_write(?a, outer, "README", "outer\n") || !t_init_repo(?a, outer) || !t_commit_all(?a, outer)) { ret 1; }

    val proj_r: R.Result[str, str] = path.join(?a, outer, "cases/one");
    if (R.is_err[str, str](proj_r)) { ret 1; }
    val proj: str = R.unwrap_ok[str, str](proj_r);
    if (O.is_some[str](fs.create_dir_all(?a, proj, 0o755))) { ret 1; }
    val root_body_r: R.Result[str, str] = format.sprint(?a,
        "[project]\nid = \"root\"\nversion = \"0.1.0\"\nsrc = \"src\"\nout = \"out\"\n{}", t_dep_table(?a, "a", fix_a));
    if (R.is_err[str, str](root_body_r)) { ret 1; }
    if (!t_write(?a, proj, MANIFEST, R.unwrap_ok[str, str](root_body_r))) { ret 1; }

    var bad: i32 = 0;
    if (pull_project(proj, true) != 0) { bad = 1; }
    if (!t_exists_under(?a, proj, "dep/a/mach.toml")) { bad = 1; }
    if (!t_exists_under(?a, proj, "dep/b/mach.toml")) { bad = 1; }
    if (t_exists_under(?a, proj, "dep/a/dep")) { bad = 1; }
    if (t_dep_verify_cli(?a, proj) != 0) { bad = 1; }

    val b_dir_r: R.Result[str, str] = path.join(?a, proj, "dep/b");
    if (R.is_ok[str, str](b_dir_r)) { fs.remove_all(?a, R.unwrap_ok[str, str](b_dir_r)); }
    if (t_dep_verify_cli(?a, proj) != 1) { bad = 1; }

    fs.remove_all(?a, outer);
    fs.remove_all(?a, fix_a);
    fs.remove_all(?a, fix_b);
    ret bad;
}

test "mach.cli.cmd.dep.closure:one_identity_two_selections_names_both_chains" {
    var a: A.Allocator;
    if (O.is_some[str](page.make(?a))) { ret 1; }

    val fix_b1: str = t_package_repo(?a, "mach_dep_b1", "b", "");
    val fix_b2: str = t_package_repo(?a, "mach_dep_b2", "b", "");
    if (str_empty(fix_b1) || str_empty(fix_b2)) { ret 1; }
    val fix_a: str = t_package_repo(?a, "mach_dep_ca", "a", t_dep_table(?a, "b", fix_b1));
    val fix_c: str = t_package_repo(?a, "mach_dep_cc", "c", t_dep_table(?a, "b", fix_b2));
    if (str_empty(fix_a) || str_empty(fix_c)) { ret 1; }

    val outer: str = t_scratch(?a, "mach_dep_outer2");
    if (str_empty(outer)) { ret 1; }
    if (!t_write(?a, outer, "README", "outer\n") || !t_init_repo(?a, outer) || !t_commit_all(?a, outer)) { ret 1; }
    val proj_r: R.Result[str, str] = path.join(?a, outer, "cases/two");
    if (R.is_err[str, str](proj_r)) { ret 1; }
    val proj: str = R.unwrap_ok[str, str](proj_r);
    if (O.is_some[str](fs.create_dir_all(?a, proj, 0o755))) { ret 1; }
    val body_r: R.Result[str, str] = format.sprint(?a,
        "[project]\nid = \"root\"\nversion = \"0.1.0\"\nsrc = \"src\"\nout = \"out\"\n{}{}",
        t_dep_table(?a, "a", fix_a), t_dep_table(?a, "c", fix_c));
    if (R.is_err[str, str](body_r)) { ret 1; }
    if (!t_write(?a, proj, MANIFEST, R.unwrap_ok[str, str](body_r))) { ret 1; }

    var bad: i32 = 0;
    if (pull_project(proj, true) == 0) { bad = 1; }

    var reqs: Vector[DepReq] = vector.init[DepReq](?a);
    var x: DepReq;
    x.id = "b"; x.url = fix_b1; x.src_path = ""; x.ref = "branch/main";
    x.chain = "root -> a -> b"; x.root_decl = false; x.is_git = true;
    var y: DepReq;
    y.id = "b"; y.url = fix_b2; y.src_path = ""; y.ref = "branch/main";
    y.chain = "root -> c -> b"; y.root_decl = false; y.is_git = true;
    val text: str = conflict_text(?a, ?y, ?x, ?y);
    if (!t_contains(text, "root -> a -> b")) { bad = 1; }
    if (!t_contains(text, "root -> c -> b")) { bad = 1; }
    if (!t_contains(text, "[dep.b]")) { bad = 1; }
    if (!t_contains(text, fix_b2)) { bad = 1; }

    fs.remove_all(?a, outer);
    fs.remove_all(?a, fix_a);
    fs.remove_all(?a, fix_c);
    fs.remove_all(?a, fix_b1);
    fs.remove_all(?a, fix_b2);
    ret bad;
}

fun t_contains(hay: str, needle: str) bool {
    val hn: usize = str_len(hay);
    val nn: usize = str_len(needle);
    if (nn == 0) { ret true; }
    if (nn > hn) { ret false; }
    var i: usize = 0;
    for (i + nn <= hn) {
        var j: usize = 0;
        for (j < nn && hay[i + j] == needle[j]) { j = j + 1; }
        if (j == nn) { ret true; }
        i = i + 1;
    }
    ret false;
}

rec TxnSnapshot {
    manifest_text: str;
    gm_present:    bool;
    gm_text:       str;
    pin:           str;
    realized:      bool;
}

fun t_read_or_empty(a: *A.Allocator, p: str, present: *bool) str {
    @present = fs.exists(p);
    if (!present[0]) { ret ""; }
    val r: R.Result[str, str] = fs.read_string(a, p);
    if (R.is_err[str, str](r)) { ret ""; }
    ret R.unwrap_ok[str, str](r);
}

fun t_snapshot(s: *session.Session, a: *A.Allocator, root: str, id: str) TxnSnapshot {
    var snap: TxnSnapshot;
    var present: bool = false;
    val mt_r: R.Result[str, str] = path.join(a, root, MANIFEST);
    snap.manifest_text = t_read_or_empty(a, R.unwrap_ok[str, str](mt_r), ?present);
    val gm_r: R.Result[str, str] = path.join(a, root, ".gitmodules");
    snap.gm_text = t_read_or_empty(a, R.unwrap_ok[str, str](gm_r), ?snap.gm_present);
    snap.pin = "";
    val pin_r: R.Result[str, str] = deps.staged_paths(s, root, "dep");
    if (R.is_ok[str, str](pin_r)) { snap.pin = R.unwrap_ok[str, str](pin_r); }
    val dep_r: R.Result[str, str] = deps.dep_full_of(a, root, id);
    snap.realized = R.is_ok[str, str](dep_r) && fs.exists(R.unwrap_ok[str, str](dep_r));
    ret snap;
}

fun t_snapshot_equal(x: *TxnSnapshot, y: *TxnSnapshot) bool {
    if (!str_equals(x.manifest_text, y.manifest_text)) { ret false; }
    if (x.gm_present != y.gm_present) { ret false; }
    if (!str_equals(x.gm_text, y.gm_text)) { ret false; }
    if (!str_equals(x.pin, y.pin)) { ret false; }
    if (x.realized != y.realized) { ret false; }
    ret true;
}

fun t_mutation_rolls_back(s: *session.Session, a: *A.Allocator, root: str, mode: u8,
                          spec: *manifest.DepTableSpec, name: str, fail_after: i32) bool {
    val before: TxnSnapshot = t_snapshot(s, a, root, name);
    var txn: deps.DepTxn;
    val txn_r: R.Result[R.Void, str] = deps.txn_begin(?txn, s, root, mode, "test");
    if (R.is_err[R.Void, str](txn_r)) { ret false; }

    val rc: i64 = mutate_apply(?txn, s, a, root, mode, spec, name, true, false, true, fail_after);
    if (rc == 0) { deps.txn_commit(s, ?txn); ret false; }
    val rolled: O.Option[str] = deps.txn_rollback(s, ?txn);
    if (O.is_some[str](rolled)) {
        print.eprintlnf("dependency rollback failed: {}", O.unwrap[str](rolled));
        deps.txn_commit(s, ?txn);
        ret false;
    }
    val after: TxnSnapshot = t_snapshot(s, a, root, name);
    ret t_snapshot_equal(?before, ?after);
}

test "mach.cli.cmd.dep.txn:a_failure_between_any_two_writes_leaves_all_three_unchanged" {
    var a: A.Allocator;
    if (O.is_some[str](page.make(?a))) { ret 1; }

    val fix: str = t_scratch(?a, "mach_dep_txn_fix");
    if (str_empty(fix)) { ret 1; }
    if (!t_write(?a, fix, MANIFEST, "[project]\nid = \"x\"\nversion = \"0.1.0\"\nsrc = \"src\"\nout = \"out\"\n")) { ret 1; }

    if (!t_lib_module(?a, fix)) { ret 1; }
    val root: str = t_scratch(?a, "mach_dep_txn_root");
    if (str_empty(root)) { ret 1; }
    if (!t_write(?a, root, MANIFEST, "[project]\nid = \"root\"\nversion = \"0.1.0\"\nsrc = \"src\"\nout = \"out\"\n")) { ret 1; }
    if (!t_init_repo(?a, root) || !t_commit_all(?a, root)) { ret 1; }

    val sr: R.Result[session.Session, str] = session.init(?a);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    val mode_r: R.Result[u8, str] = deps.realization_mode(?s, root);
    if (R.is_err[u8, str](mode_r)) { session.dnit(?s); ret 1; }
    val mode: u8 = R.unwrap_ok[u8, str](mode_r);
    if (mode != deps.REALIZE_REPO_ROOT) { session.dnit(?s); ret 1; }

    var spec: manifest.DepTableSpec;
    spec.name   = "x";
    spec.source = manifest.DEP_SOURCE_PATH;
    spec.value  = fix;
    spec.ref    = "";

    var bad: i32 = 0;
    var held: deps.DepTxn;
    val held_r: R.Result[R.Void, str] = deps.txn_begin(?held, ?s, root, mode, "first");
    if (R.is_err[R.Void, str](held_r)) { bad = 10; }
    or {
        var second: deps.DepTxn;
        val second_r: R.Result[R.Void, str] = deps.txn_begin(?second, ?s, root, mode, "second");
        if (R.is_ok[R.Void, str](second_r)) { deps.txn_commit(?s, ?second); bad = 11; }
        deps.txn_commit(?s, ?held);
    }
    if (bad != 0) { session.dnit(?s); fs.remove_all(?a, root); fs.remove_all(?a, fix); ret bad; }

    if (!t_mutation_rolls_back(?s, ?a, root, mode, ?spec, "x", 1)) { bad = 1; }
    if (!t_mutation_rolls_back(?s, ?a, root, mode, ?spec, "x", 2)) { bad = 2; }
    if (!t_mutation_rolls_back(?s, ?a, root, mode, ?spec, "x", 3)) { bad = 3; }

    if (bad == 0) {
        var txn: deps.DepTxn;
        val txn_r: R.Result[R.Void, str] = deps.txn_begin(?txn, ?s, root, mode, "test");
        if (R.is_err[R.Void, str](txn_r)) { bad = 4; }
        or {
            if (mutate_apply(?txn, ?s, ?a, root, mode, ?spec, "x", true, false, true, 0) != 0) { bad = 5; }
            deps.txn_commit(?s, ?txn);
        }
    }

    if (bad == 0) {
        if (!t_exists_under(?a, root, "dep/x/mach.toml")) { bad = 6; }
        val staged_r: R.Result[str, str] = deps.staged_paths(?s, root, "dep");
        if (R.is_err[str, str](staged_r) || str_empty(R.unwrap_ok[str, str](staged_r))) { bad = 8; }
        if (verify_project(root) != 0) { bad = 9; }
    }

    session.dnit(?s);
    fs.remove_all(?a, root);
    fs.remove_all(?a, fix);
    ret bad;
}

test "mach.cli.cmd.dep.run_typed:verify_action_reaches_verification" {
    var a: A.Allocator;
    if (O.is_some[str](page.make(?a))) { ret 1; }

    val outer: str = t_scratch(?a, "mach_dep_verify_outer");
    if (str_empty(outer)) { ret 1; }
    if (!t_write(?a, outer, "README", "outer\n") || !t_init_repo(?a, outer) || !t_commit_all(?a, outer)) { ret 1; }
    val proj_r: R.Result[str, str] = path.join(?a, outer, "cases/v");
    if (R.is_err[str, str](proj_r)) { ret 1; }
    val proj: str = R.unwrap_ok[str, str](proj_r);
    if (O.is_some[str](fs.create_dir_all(?a, proj, 0o755))) { ret 1; }
    if (!t_write(?a, proj, MANIFEST, "[project]\nid = \"v\"\nversion = \"0.1.0\"\nsrc = \"src\"\nout = \"out\"\n")) { ret 1; }

    var bad: i32 = 0;
    if (t_dep_verify_cli(?a, proj) != 0) { bad = 3; }

    if (bad == 0) {
        val stray_r: R.Result[str, str] = path.join(?a, proj, "dep/ghost");
        if (R.is_ok[str, str](stray_r)) {
            val stray: str = R.unwrap_ok[str, str](stray_r);
            if (O.is_some[str](fs.create_dir_all(?a, stray, 0o755))) { bad = 4; }
        }
        if (t_dep_verify_cli(?a, proj) != 1) { bad = 6; }
    }

    fs.remove_all(?a, outer);
    ret bad;
}

fun t_allow_file_transport(env: **u8) {
    env[0] = "GIT_CONFIG_COUNT=1"::*u8;
    env[1] = "GIT_CONFIG_KEY_0=protocol.file.allow"::*u8;
    env[2] = "GIT_CONFIG_VALUE_0=always"::*u8;
    env[3] = nil;
    deps.set_git_config_env(env);
}

fun t_git_submodule_add(a: *A.Allocator, dir: str, url: str, rel: str) bool {
    var av: [9]*u8;
    av[0] = ""::*u8; av[1] = "-C"::*u8; av[2] = dir::*u8; av[3] = "-c"::*u8; av[4] = "protocol.file.allow=always"::*u8;
    av[5] = "submodule"::*u8; av[6] = "add"::*u8; av[7] = url::*u8; av[8] = rel::*u8;
    var full: [10]*u8;
    var i: usize = 0;
    for (i < 9) { full[i] = av[i]; i = i + 1; }
    full[9] = nil;
    ret t_git(a, ?full[0]);
}

fun t_root_repo(a: *A.Allocator, prefix: str, extra: str) str {
    val dir: str = t_scratch(a, prefix);
    if (str_empty(dir)) { ret ""; }
    val body_r: R.Result[str, str] = format.sprint(a,
        "[project]\nid = \"root\"\nversion = \"0.1.0\"\nsrc = \"src\"\nout = \"out\"\n\n[target.host]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[artifact.root]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/root\"\ntargets = [\"*\"]\nlink = []\nneed = []\n{}", extra);
    if (R.is_err[str, str](body_r)) { ret ""; }
    if (!t_write(a, dir, MANIFEST, R.unwrap_ok[str, str](body_r))) { ret ""; }
    val src_r: R.Result[str, str] = path.join(a, dir, "src");
    if (R.is_err[str, str](src_r)) { ret ""; }
    if (O.is_some[str](fs.create_dir_all(a, R.unwrap_ok[str, str](src_r), 0o755))) { ret ""; }
    if (!t_write(a, dir, "src/main.mach", "fun main() i32 { ret 0; }\n")) { ret ""; }
    if (!t_init_repo(a, dir)) { ret ""; }
    if (!t_commit_all(a, dir)) { ret ""; }
    ret dir;
}

fun t_tagged_b(a: *A.Allocator) str {
    val fix_b: str = t_package_repo(a, "mach_dep_fix_b", "b", "");
    if (str_empty(fix_b)) { ret ""; }
    if (!t_git3(a, fix_b, "tag", "v1.0.0", "", "", "")) { ret ""; }
    if (!t_write(a, fix_b, "NEWS", "second\n") || !t_commit_all(a, fix_b)) { ret ""; }
    if (!t_git3(a, fix_b, "tag", "v2.0.0", "", "", "")) { ret ""; }
    ret fix_b;
}

fun t_requirer_of_b(a: *A.Allocator, prefix: str, id: str, fix_b: str, ref: str, with_gitlink: bool) str {
    val table: str = t_dep_table_ref(a, "b", fix_b, ref);
    if (str_empty(table)) { ret ""; }
    val dir: str = t_package_repo(a, prefix, id, table);
    if (str_empty(dir)) { ret ""; }
    if (with_gitlink) {
        if (!t_git_submodule_add(a, dir, fix_b, "dep/b")) { ret ""; }
        if (!t_commit_all(a, dir)) { ret ""; }
    }
    ret dir;
}

fun t_dep_table_ref(a: *A.Allocator, name: str, url: str, ref: str) str {
    var spec: manifest.DepTableSpec;
    spec.name = name;
    spec.source = manifest.DEP_SOURCE_GIT;
    spec.value = url;
    spec.ref = ref;
    val r: R.Result[str, str] = manifest.manifest_add_dep_table(a, "", ?spec);
    if (R.is_err[str, str](r)) { ret ""; }
    ret R.unwrap_ok[str, str](r);
}

fun t_session_and_mode(a: *A.Allocator, root: str, s: *session.Session, mode: *u8) bool {
    val sr: R.Result[session.Session, str] = session.init(a);
    if (R.is_err[session.Session, str](sr)) { ret false; }
    @s = R.unwrap_ok[session.Session, str](sr);
    val mode_r: R.Result[u8, str] = deps.realization_mode(s, root);
    if (R.is_err[u8, str](mode_r)) { session.dnit(s); ret false; }
    @mode = R.unwrap_ok[u8, str](mode_r);
    ret true;
}

fun t_build_ok(s: *session.Session, root: str) bool {
    if (R.is_err[R.Void, str](driver.setup_registry(?s.registry))) { ret false; }
    var sel: manifest.Selection;
    sel.target = ""; sel.profile = ""; sel.artifact = ""; sel.want_lib = false; sel.has_artifact = false; sel.legacy_default = false;
    val pr: R.Result[project.Project, outcome.Fail] = driver.build_project_sel(s, root, ?sel);
    if (R.is_err[project.Project, outcome.Fail](pr)) {
        val f: outcome.Fail = R.unwrap_err[project.Project, outcome.Fail](pr);
        if (f.message != nil) { print.eprint("build: "); print.eprint(f.message); print.eprint("\n"); }
        ret false;
    }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);
    project.dnit_project(?p);
    ret true;
}

test "mach.cli.cmd.dep.pull:a_fresh_clone_initializes_the_committed_gitlinks_in_place" {
    var a: A.Allocator;
    if (O.is_some[str](page.make(?a))) { ret 1; }
    var git_env: [4]*u8;
    t_allow_file_transport(?git_env[0]);
    fin { deps.set_git_config_env(nil); }
    val fix_b: str = t_tagged_b(?a);
    if (str_empty(fix_b)) { ret 1; }
    val fix_a: str = t_requirer_of_b(?a, "mach_dep_fix_a", "a", fix_b, "branch/main", true);
    if (str_empty(fix_a)) { ret 1; }
    val proj: str = t_root_repo(?a, "mach_dep_clone_src", t_dep_table(?a, "a", fix_a));
    if (str_empty(proj)) { ret 1; }
    var bad: i32 = 0;
    if (pull_project(proj, true) != 0) { bad = 1; }
    if (!t_commit_all(?a, proj)) { bad = 2; }
    val clone: str = t_scratch(?a, "mach_dep_clone_dst");
    if (str_empty(clone)) { ret 1; }
    var av: [6]*u8;
    av[0] = ""::*u8; av[1] = "clone"::*u8; av[2] = "-q"::*u8; av[3] = proj::*u8; av[4] = clone::*u8; av[5] = nil;
    if (bad == 0 && !t_git(?a, ?av[0])) { bad = 3; }
    if (bad == 0 && !t_git3(?a, clone, "config", "protocol.file.allow", "always", "", "")) { bad = 4; }
    if (bad == 0 && !t_exists_under(?a, clone, "dep/a")) { bad = 5; }
    if (bad == 0 && t_exists_under(?a, clone, "dep/a/.git")) { bad = 6; }
    if (bad == 0 && pull_project(clone, true) != 0) { bad = 7; }
    if (bad == 0 && !t_exists_under(?a, clone, "dep/a/mach.toml")) { bad = 8; }
    if (bad == 0 && !t_exists_under(?a, clone, "dep/b/mach.toml")) { bad = 9; }
    if (bad == 0 && verify_project(clone) != 0) { bad = 10; }
    fs.remove_all(?a, clone);
    fs.remove_all(?a, proj);
    fs.remove_all(?a, fix_a);
    fs.remove_all(?a, fix_b);
    ret bad;
}

test "mach.cli.cmd.dep.add:a_dependency_with_its_own_committed_gitlink_lands_flat_and_the_root_builds" {
    var a: A.Allocator;
    if (O.is_some[str](page.make(?a))) { ret 1; }
    var git_env: [4]*u8;
    t_allow_file_transport(?git_env[0]);
    fin { deps.set_git_config_env(nil); }
    val fix_b: str = t_tagged_b(?a);
    if (str_empty(fix_b)) { ret 1; }
    val fix_a: str = t_requirer_of_b(?a, "mach_dep_fix_a", "a", fix_b, "branch/main", true);
    if (str_empty(fix_a)) { ret 1; }
    val proj: str = t_root_repo(?a, "mach_dep_add_root", "");
    if (str_empty(proj)) { ret 1; }
    var s: session.Session;
    var mode: u8 = 0;
    if (!t_session_and_mode(?a, proj, ?s, ?mode)) { ret 1; }
    var bad: i32 = 0;
    var spec: manifest.DepTableSpec;
    spec.name = "a"; spec.source = manifest.DEP_SOURCE_GIT; spec.value = fix_a; spec.ref = "branch/main";
    var txn: deps.DepTxn;
    val txn_r: R.Result[R.Void, str] = deps.txn_begin(?txn, ?s, proj, mode, "test");
    if (R.is_err[R.Void, str](txn_r)) { bad = 1; }
    or {
        if (mutate_apply(?txn, ?s, ?a, proj, mode, ?spec, "a", true, false, true, 0) != 0) { bad = 2; deps.txn_rollback(?s, ?txn); deps.txn_commit(?s, ?txn); }
        or { deps.txn_commit(?s, ?txn); }
    }
    if (bad == 0 && !t_exists_under(?a, proj, "dep/a/mach.toml")) { bad = 3; }
    if (bad == 0 && !t_exists_under(?a, proj, "dep/b/mach.toml")) { bad = 4; }
    if (bad == 0 && verify_project(proj) != 0) { bad = 5; }
    if (bad == 0 && !t_build_ok(?s, proj)) { bad = 6; }
    session.dnit(?s);
    fs.remove_all(?a, proj);
    fs.remove_all(?a, fix_a);
    fs.remove_all(?a, fix_b);
    ret bad;
}

test "mach.cli.cmd.dep.verify:a_requirers_exact_selector_is_checked_against_the_gitlink_unless_the_root_overrides" {
    var a: A.Allocator;
    if (O.is_some[str](page.make(?a))) { ret 1; }
    var git_env: [4]*u8;
    t_allow_file_transport(?git_env[0]);
    fin { deps.set_git_config_env(nil); }
    val fix_b: str = t_tagged_b(?a);
    if (str_empty(fix_b)) { ret 1; }
    val fix_a: str = t_requirer_of_b(?a, "mach_dep_fix_a", "a", fix_b, "tag/v1.0.0", false);
    if (str_empty(fix_a)) { ret 1; }
    val proj: str = t_root_repo(?a, "mach_dep_verify_root", t_dep_table(?a, "a", fix_a));
    if (str_empty(proj)) { ret 1; }
    var bad: i32 = 0;
    if (pull_project(proj, true) != 0) { bad = 1; }
    if (bad == 0 && !t_commit_all(?a, proj)) { bad = 2; }
    if (bad == 0 && verify_project(proj) != 0) { bad = 3; }
    val dep_b_r: R.Result[str, str] = path.join(?a, proj, "dep/b");
    if (R.is_err[str, str](dep_b_r)) { ret 1; }
    val dep_b: str = R.unwrap_ok[str, str](dep_b_r);
    if (bad == 0 && !t_git3(?a, dep_b, "checkout", "-q", "v2.0.0", "", "")) { bad = 4; }
    if (bad == 0 && !t_git3(?a, proj, "add", "dep/b", "", "", "")) { bad = 5; }
    if (bad == 0 && verify_project(proj) == 0) { bad = 6; }
    val head: str = "[project]\nid = \"root\"\nversion = \"0.1.0\"\nsrc = \"src\"\nout = \"out\"\n\n[target.host]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[artifact.root]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/root\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
    val override_r: R.Result[str, str] = format.sprint(?a, "{}{}{}", head, t_dep_table(?a, "a", fix_a), t_dep_table_ref(?a, "b", fix_b, "branch/main"));
    if (R.is_err[str, str](override_r)) { ret 1; }
    if (bad == 0 && !t_write(?a, proj, MANIFEST, R.unwrap_ok[str, str](override_r))) { bad = 7; }
    if (bad == 0 && verify_project(proj) != 0) { bad = 8; }
    fs.remove_all(?a, proj);
    fs.remove_all(?a, fix_a);
    fs.remove_all(?a, fix_b);
    ret bad;
}

