test "mach.cli.cmd.dep.update:the_roots_exact_selector_repins_an_identity_realized_at_a_dependencys_commit" {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    var git_env: [4]*u8;
    t_allow_file_transport(?git_env[0]);
    fin { deps.set_git_config_env(nil); }
    val fix_b: str = t_tagged_b(?a);
    if (str_empty(fix_b)) { ret 1; }
    val fix_a: str = t_requirer_of_b(?a, "mach_dep_fix_a", "a", fix_b, "branch/main", true);
    if (str_empty(fix_a)) { ret 1; }
    val proj: str = t_root_repo(?a, "mach_dep_update_root", t_dep_table(?a, "a", fix_a));
    if (str_empty(proj)) { ret 1; }
    var bad: i32 = 0;
    if (pull_project(proj, true) != 0)       { bad = 1; }
    if (bad == 0 && !t_commit_all(?a, proj)) { bad = 2; }
    var s:    session.Session;
    var mode: u8 = 0;
    if (!t_session_and_mode(?a, proj, ?s, ?mode)) { ret 1; }
    val dep_b_r: res[str, A.Error] = path.join(?a, proj, "dep/b");
    if (sel dep_b_r.err) { ret 1; }
    val dep_b:    str                    = dep_b_r.ok;
    val before_r: res[str, outcome.Fail] = deps.checkout_head(?s, dep_b);
    if (sel before_r.err) { ret 99; }
    val override_r: res[str, format.FormatError] = format.sprint(?a,
        "[project]\nid = \"root\"\nversion = \"0.1.0\"\nsrc = \"src\"\nout = \"out\"\n\n[target.host]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[artifact.root]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/root\"\ntargets = [\"*\"]\nlink = []\nneed = []\n{}{}\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n",
        t_dep_table(?a, "a", fix_a), t_dep_table_ref(?a, "b", fix_b, "tag/v1.0.0"));
    if (sel override_r.err)                                      { ret 1; }
    if (bad == 0 && !t_write(?a, proj, MANIFEST, override_r.ok)) { bad = 4; }
    var v1: str = "";
    if (bad == 0 && !t_git3(?a, dep_b, "checkout", "-q", "v1.0.0", "", "")) { bad = 5; }
    if (bad == 0) {
        val v1_r: res[str, outcome.Fail] = deps.checkout_head(?s, dep_b);
        if (sel v1_r.err) { bad = 5; }
        if (sel v1_r.ok)  { v1 = v1_r.ok; }
    }
    if (bad == 0 && !t_git3(?a, dep_b, "checkout", "-q", "main", "", "")) { bad = 5; }
    if (bad == 0 && sel before_r.ok && str_equals(v1, before_r.ok))       { bad = 5; }
    if (bad == 0) {
        var edit:  ManifestEdit;
        val txn_r: err[outcome.Fail] = edit_begin(?edit, ?a, proj);
        if (sel txn_r.err) { bad = 6; }
        if (sel txn_r.ok) {
            val applied: i64 = update_apply(?s, ?a, proj, mode, false, "b"::*u8, true, 0);
            if (edit_finish(?edit, applied) != 0) { bad = 7; }
        }
    }
    if (bad == 0) {
        val after_r: res[str, outcome.Fail] = deps.checkout_head(?s, dep_b);
        if (sel after_r.err)                                 { ret 99; }
        if (!(sel after_r.ok && str_equals(after_r.ok, v1))) { bad = 8; }
        val staged_r: res[opt[str], outcome.Fail] = deps.staged_gitlink(?s, proj, "b");
        if (sel staged_r.err) { bad = 9; }
        if (sel staged_r.ok) {
            if (sel staged_r.ok.none) { bad = 9; }
            if (sel staged_r.ok.some) {
                if (sel after_r.ok && !str_equals(staged_r.ok.some, after_r.ok)) { bad = 9; }
            }
        }
        if (verify_project(proj) != 0) { bad = 10; }
    }
    session.dnit(?s);
    fs.remove_all(?a, proj);
    fs.remove_all(?a, fix_a);
    fs.remove_all(?a, fix_b);
    ret bad;
}

test "mach.cli.cmd.dep.add:a_discovered_clash_retains_native_changes_and_releases_the_manifest_editor" {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    var git_env: [4]*u8;
    t_allow_file_transport(?git_env[0]);
    fin { deps.set_git_config_env(nil); }
    val fix_b: str = t_tagged_b(?a);
    if (str_empty(fix_b)) { ret 1; }
    val fix_a: str = t_requirer_of_b(?a, "mach_dep_fix_a", "a", fix_b, "tag/v1.0.0", false);
    if (str_empty(fix_a)) { ret 1; }
    val fix_c: str = t_requirer_of_b(?a, "mach_dep_fix_c", "c", fix_b, "tag/v2.0.0", false);
    if (str_empty(fix_c)) { ret 1; }
    val proj: str = t_root_repo(?a, "mach_dep_clash_root", t_dep_table(?a, "a", fix_a));
    if (str_empty(proj)) { ret 1; }
    var bad: i32 = 0;
    if (pull_project(proj, true) != 0)       { bad = 1; }
    if (bad == 0 && !t_commit_all(?a, proj)) { bad = 2; }
    var s:    session.Session;
    var mode: u8 = 0;
    if (!t_session_and_mode(?a, proj, ?s, ?mode)) { ret 1; }
    var spec: manifest.DepTableSpec;
    spec.name   = "c";
    spec.source = manifest.DEP_SOURCE_GIT;
    spec.value  = fix_c;
    spec.ref    = "branch/main";
    val before: TxnSnapshot = t_snapshot(?s, ?a, proj, "c");
    var edit:   ManifestEdit;
    if (bad == 0) {
        val begun: err[outcome.Fail] = edit_begin(?edit, ?a, proj);
        if (sel begun.err) {
            edit_finish(?edit, 1);
            bad = 3;
        }
        if (sel begun.ok) {
            val applied: i64 = mutate_apply(?edit, ?s, ?a, proj, mode, ?spec, "c", true, false, true, 0);
            if (edit_finish(?edit, applied) == 0) { bad = 3; }
        }
    }
    val after: TxnSnapshot = t_snapshot(?s, ?a, proj, "c");
    if (bad == 0 && (!after.realized || !str_equals(before.manifest_text, after.manifest_text))) { bad = 4; }
    if (bad == 0) {
        val begun: err[outcome.Fail] = edit_begin(?edit, ?a, proj);
        if (sel begun.err) {
            edit_finish(?edit, 1);
            bad = 5;
        }
        if (sel begun.ok) {
            if (edit_finish(?edit, 0) != 0) { bad = 5; }
        }
    }
    if (bad == 0 && !t_contains(after.pin, "dep/c"))              { bad = 6; }
    if (bad == 0 && !t_exists_under(?a, proj, "dep/a/mach.toml")) { bad = 7; }
    session.dnit(?s);
    fs.remove_all(?a, proj);
    fs.remove_all(?a, fix_a);
    fs.remove_all(?a, fix_c);
    fs.remove_all(?a, fix_b);
    ret bad;
}

# the build refusal text of a dependency-shaped failure, or "" when the build succeeds
fun t_build_refusal(s: *session.Session, root: str) str {
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) { ret ""; }
    var pick: manifest.Selection;
    pick.target       = "";
    pick.profile      = "";
    pick.artifact     = "";
    pick.want_lib     = false;
    pick.has_artifact = false;
    val pr: res[project.Project, outcome.Fail] = driver.build_project_sel(s, root, ?pick);
    if (sel pr.err) { ret outcome.describe(pr.err); }
    var p: project.Project = pr.ok;
    project.dnit_project(?p);
    ret "";
}

# intentional removal test (#3226, #3112): a root mach.lock is refused by verify,
# pull and the build, never noted and ignored
test "mach.cli.cmd.dep.pull_and_verify:a_stale_lock_file_is_refused_naming_the_removal" {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val root: str = t_root_repo(?a, "mach_dep_lockfile", "");
    if (str_empty(root)) { ret 1; }
    val absent: err[outcome.Fail] = deps.refuse_stale_lock(?a, root);
    if (sel absent.err) {
        fs.remove_all(?a, root);
        ret 2;
    }
    if (!t_write(?a, root, "mach.lock", "[[dep]]\n")) {
        fs.remove_all(?a, root);
        ret 1;
    }
    val present: err[outcome.Fail] = deps.refuse_stale_lock(?a, root);
    if (sel present.ok) {
        fs.remove_all(?a, root);
        ret 3;
    }
    if (sel present.err) {
        if (!t_contains(outcome.describe(present.err), "mach.lock was removed in 5.0.0")) {
            fs.remove_all(?a, root);
            ret 4;
        }
    }
    if (verify_project(root) == 0) {
        fs.remove_all(?a, root);
        ret 5;
    }
    if (pull_project(root, true) == 0) {
        fs.remove_all(?a, root);
        ret 6;
    }
    var s:    session.Session;
    var mode: u8 = 0;
    if (!t_session_and_mode(?a, root, ?s, ?mode)) {
        fs.remove_all(?a, root);
        ret 1;
    }
    val refusal: str = t_build_refusal(?s, root);
    if (!t_contains(refusal, "mach.lock was removed in 5.0.0")) {
        session.dnit(?s);
        fs.remove_all(?a, root);
        ret 7;
    }
    session.dnit(?s);
    val removed: err[io_error.Error] = fs.remove_file(t_join_owned(?a, root, "mach.lock"));
    if (sel removed.err) {
        fs.remove_all(?a, root);
        ret 1;
    }
    if (verify_project(root) != 0) {
        fs.remove_all(?a, root);
        ret 8;
    }
    fs.remove_all(?a, root);
    ret 0;
}

# intentional removal test (#3226, #3112): a realized dep/<id>/dep/<x>/ is refused
# by verify and by the build, while git's empty gitlink directory passes
test "mach.cli.cmd.dep.verify:a_nested_realization_is_refused_and_an_empty_gitlink_directory_is_not" {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    var git_env: [4]*u8;
    t_allow_file_transport(?git_env[0]);
    fin { deps.set_git_config_env(nil); }
    val fix_b: str = t_tagged_b(?a);
    if (str_empty(fix_b)) { ret 1; }
    val fix_a: str = t_requirer_of_b(?a, "mach_dep_fix_a", "a", fix_b, "branch/main", true);
    if (str_empty(fix_a)) { ret 1; }
    val proj: str = t_root_repo(?a, "mach_dep_nested_root", "");
    if (str_empty(proj)) { ret 1; }
    var s:    session.Session;
    var mode: u8 = 0;
    if (!t_session_and_mode(?a, proj, ?s, ?mode)) { ret 1; }
    var bad:  i32 = 0;
    var spec: manifest.DepTableSpec;
    spec.name   = "a";
    spec.source = manifest.DEP_SOURCE_GIT;
    spec.value  = fix_a;
    spec.ref    = "branch/main";
    var edit:  ManifestEdit;
    val txn_r: err[outcome.Fail] = edit_begin(?edit, ?a, proj);
    if (sel txn_r.err) { bad = 1; }
    if (sel txn_r.ok) {
        val applied: i64 = mutate_apply(?edit, ?s, ?a, proj, mode, ?spec, "a", true, false, true, 0);
        if (edit_finish(?edit, applied) != 0) { bad = 2; }
    }
    # the consumed dependency's own gitlink is an empty directory: not a realization
    if (bad == 0 && !t_exists_under(?a, proj, "dep/a/dep/b"))          { bad = 3; }
    if (bad == 0 && t_exists_under(?a, proj, "dep/a/dep/b/mach.toml")) { bad = 4; }
    if (bad == 0 && verify_project(proj) != 0)                         { bad = 5; }
    if (bad == 0) {
        val nested_dir: str = t_join_owned(?a, proj, "dep/a/dep/b");
        if (!t_write(?a, nested_dir, MANIFEST, "[project]\nid = \"b\"\nversion = \"0.1.0\"\nsrc = \"src\"\nout = \"out\"\n")) { bad = 6; }
    }
    if (bad == 0 && verify_project(proj) == 0) { bad = 7; }
    if (bad == 0) {
        val refusal: str = t_build_refusal(?s, proj);
        if (!t_contains(refusal, "dep/a/dep/b is a nested realization")) { bad = 8; }
        if (!t_contains(refusal, "removed in 5.0.0"))                    { bad = 9; }
    }
    if (bad == 0) {
        val removed: err[io_error.Error] = fs.remove_file(t_join_owned(?a, proj, "dep/a/dep/b/mach.toml"));
        if (sel removed.err) { bad = 10; }
    }
    if (bad == 0 && verify_project(proj) != 0) { bad = 11; }
    if (bad == 0 && !t_build_ok(?s, proj))     { bad = 12; }
    session.dnit(?s);
    fs.remove_all(?a, proj);
    fs.remove_all(?a, fix_a);
    fs.remove_all(?a, fix_b);
    ret bad;
}

# intentional removal test (#3226, #3112): an alias key is refused by pull,
# verify and the build, naming the removal and the one-name rule
test "mach.cli.cmd.dep.pull:an_alias_key_is_refused_naming_the_removal" {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val source: str = t_scratch(?a, "mach_dep_alias_source");
    if (str_empty(source)) { ret 2; }
    fin { fs.remove_all(?a, source); }
    if (!t_write(?a, source, MANIFEST, "[project]\nid = \"local\"\nversion = \"0.1.0\"\nsrc = \"src\"\nout = \"out\"\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n") || !t_lib_module(?a, source)) { ret 3; }
    val table: str = t_dep_table_path(?a, "alias", source);
    if (str_empty(table)) { ret 4; }
    val root: str = t_root_repo(?a, "mach_dep_alias_root", table);
    if (str_empty(root)) { ret 5; }
    fin { fs.remove_all(?a, root); }
    var s:    session.Session;
    var mode: u8 = 0;
    if (!t_session_and_mode(?a, root, ?s, ?mode)) { ret 6; }
    fin { session.dnit(?s); }
    if (pull_project(root, true) == 0) { ret 7; }
    # pull rolled the refused realization back; a hand-realized dep/alias is refused
    # by verify and by the build all the same
    val realized: str             = t_join_owned(?a, root, "dep/alias");
    val mkdir_r:  err[fs.FsError] = fs.create_dir_all(?a, realized, 0o755);
    if (sel mkdir_r.err)                                                                                                                                                                                                                                                                                                                                                                     { ret 8; }
    if (!t_write(?a, realized, MANIFEST, "[project]\nid = \"local\"\nversion = \"0.1.0\"\nsrc = \"src\"\nout = \"out\"\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n") || !t_lib_module(?a, realized)) { ret 8; }
    if (verify_project(root) == 0)                                                                                                                                                                                                                                                                                                                                                           { ret 9; }
    val refusal: str = t_build_refusal(?s, root);
    if (!t_contains(refusal, "[dep.alias] realizes project 'local'; alias keys were removed in 5.0.0")) { ret 10; }
    if (!t_contains(refusal, "rename the table to [dep.local] and the directory to dep/local"))         { ret 11; }
    ret 0;
}

test "mach.cli.cmd.dep: generated dependency fixtures preserve TOML string values" {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val url:  str = "C:\\Users\\fixture\\quoted\" repo";
    val ref:  str = "branch/quoted\"\\line\nnext\tpart";
    val text: str = t_dep_table_ref(?a, "fixture", url, ref);
    if (str_empty(text)) { ret 2; }
    fin { str_free(?a, text); }
    val parsed: res[toml.Table, toml.TomlError] = toml.parse(?a, text);
    if (sel parsed.err) { ret 3; }
    var table: toml.Table = parsed.ok;
    fin { toml.dnit(?a, ?table); }
    if (!str_equals(key_text(?table, "dep.fixture.git"), url)) { ret 4; }
    if (!str_equals(key_text(?table, "dep.fixture.ref"), ref)) { ret 5; }
    ret 0;
}

test "mach.cli.cmd.dep.edit:final_storage_refuses_copies_and_releases_manifest_coordination" {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val root: str = t_root_repo(?a, "mach_dep_manifest_owner", "");
    if (str_empty(root)) { ret 2; }
    fin { fs.remove_all(?a, root); }
    var owner:        ManifestEdit;
    val edit_begin_r: err[outcome.Fail] = edit_begin(?owner, ?a, root);
    if (sel edit_begin_r.err) {
        edit_finish(?owner, 1);
        ret 3;
    }
    var copied: ManifestEdit = owner;
    if (edit_finish(?copied, 0) == 0) {
        edit_finish(?owner, 0);
        ret 4;
    }
    var second:  ManifestEdit;
    val blocked: err[outcome.Fail] = edit_begin(?second, ?a, root);
    edit_finish(?second, 0);
    if (sel blocked.ok) {
        edit_finish(?owner, 0);
        ret 5;
    }
    if (edit_finish(?owner, 0) != 0) { ret 6; }
    val edit_begin_r2: err[outcome.Fail] = edit_begin(?second, ?a, root);
    if (sel edit_begin_r2.err) {
        edit_finish(?second, 1);
        ret 7;
    }
    if (edit_finish(?second, 0) != 0) { ret 8; }
    ret 0;
}

fun t_read_under(a: *A.Allocator, root: str, rel: str) res[str, outcome.Fail] {
    val joined: res[str, A.Error] = path.join(a, root, rel);
    if (sel joined.err) { ret res[str, outcome.Fail].err{outcome.refused(joined.err)}; }
    val full: str = joined.ok;
    fin { str_free(a, full); }
    val read_string_r: res[str, fs.FsError] = fs.read_string(a, full);
    if (sel read_string_r.err) { ret res[str, outcome.Fail].err{outcome.user(outcome.fs_text(read_string_r.err))}; }
    ret res[str, outcome.Fail].ok{read_string_r.ok};
}

fun t_project_history_unchanged(s: *session.Session, a: *A.Allocator, root: str,
    head: str, head_ref: str, head_log: str, branch_log: str, staged_user: str) bool {
    val actual_head_r: res[str, outcome.Fail] = deps.checkout_head(s, root);
    if (sel actual_head_r.err) { ret false; }
    val actual_head: str = actual_head_r.ok;
    fin { str_free(a, actual_head); }
    if (!str_equals(head, actual_head)) { ret false; }
    val actual_ref_r: res[str, outcome.Fail] = t_read_under(a, root, ".git/HEAD");
    if (sel actual_ref_r.err) { ret false; }
    val actual_ref: str = actual_ref_r.ok;
    fin { str_free(a, actual_ref); }
    if (!str_equals(head_ref, actual_ref)) { ret false; }
    val actual_log_r: res[str, outcome.Fail] = t_read_under(a, root, ".git/logs/HEAD");
    if (sel actual_log_r.err) { ret false; }
    val actual_log: str = actual_log_r.ok;
    fin { str_free(a, actual_log); }
    if (!str_equals(head_log, actual_log)) { ret false; }
    val branch_r: res[str, outcome.Fail] = t_read_under(a, root, ".git/logs/refs/heads/main");
    if (sel branch_r.err) { ret false; }
    val actual_branch: str = branch_r.ok;
    fin { str_free(a, actual_branch); }
    if (!str_equals(branch_log, actual_branch)) { ret false; }
    val actual_stage_r: res[str, outcome.Fail] = deps.staged_paths(s, root, "user-history");
    if (sel actual_stage_r.err) { ret false; }
    val actual_stage: str = actual_stage_r.ok;
    fin { str_free(a, actual_stage); }
    if (!str_equals(staged_user, actual_stage)) { ret false; }
    val work_r: res[str, outcome.Fail] = t_read_under(a, root, "user-history");
    if (sel work_r.err) { ret false; }
    val work: str = work_r.ok;
    fin { str_free(a, work); }
    ret str_equals(work, "unstaged user data\n");
}

test "mach.cli.cmd.dep.remove:native_lock_failure_and_success_preserve_checkout_and_project_history" {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    var git_env: [4]*u8;
    t_allow_file_transport(?git_env[0]);
    fin { deps.set_git_config_env(nil); }
    val fixture: str = t_package_repo(?a, "mach_dep_remove_source", "x", "");
    if (str_empty(fixture)) { ret 2; }
    fin { fs.remove_all(?a, fixture); }
    val root: str = t_root_repo(?a, "mach_dep_remove_root", "");
    if (str_empty(root)) { ret 3; }
    fin { fs.remove_all(?a, root); }
    if (!t_write(?a, root, "user-history", "committed user data\n") || !t_commit_all(?a, root)) { ret 4; }
    if (!t_write(?a, root, "user-history", "staged user data\n") ||
        !t_git3(?a, root, "add", "--", "user-history", "", "") ||
        !t_write(?a, root, "user-history", "unstaged user data\n")) { ret 5; }
    var s:    session.Session;
    var mode: u8 = 0;
    if (!t_session_and_mode(?a, root, ?s, ?mode)) { ret 6; }
    fin { session.dnit(?s); }
    val head_r: res[str, outcome.Fail] = deps.checkout_head(?s, root);
    if (sel head_r.err) { ret 7; }
    val head: str = head_r.ok;
    fin { str_free(?a, head); }
    val ref_r:    res[str, outcome.Fail] = t_read_under(?a, root, ".git/HEAD");
    val log_r:    res[str, outcome.Fail] = t_read_under(?a, root, ".git/logs/HEAD");
    val branch_r: res[str, outcome.Fail] = t_read_under(?a, root, ".git/logs/refs/heads/main");
    val staged_r: res[str, outcome.Fail] = deps.staged_paths(?s, root, "user-history");
    if (sel ref_r.err)    { ret 20; }
    if (sel log_r.err)    { ret 20; }
    if (sel branch_r.err) { ret 20; }
    if (sel staged_r.err) { ret 20; }
    val head_ref:    str = ref_r.ok;
    val head_log:    str = log_r.ok;
    val branch_log:  str = branch_r.ok;
    val staged_user: str = staged_r.ok;
    fin {
        str_free(?a, head_ref);
        str_free(?a, head_log);
        str_free(?a, branch_log);
        str_free(?a, staged_user);
    }
    if (str_empty(head_ref) || str_empty(head_log) || str_empty(branch_log) || str_empty(staged_user)) { ret 21; }
    var spec: manifest.DepTableSpec;
    spec.name   = "x";
    spec.source = manifest.DEP_SOURCE_GIT;
    spec.value  = fixture;
    spec.ref    = "branch/main";
    var edit: ManifestEdit;
    var av:   [10]*u8;
    av[0] = "mach"::*u8;
    av[1] = "dep"::*u8;
    av[2] = "add"::*u8;
    av[3] = root::*u8;
    av[4] = "x"::*u8;
    av[5] = "--git"::*u8;
    av[6] = fixture::*u8;
    av[7] = "--ref"::*u8;
    av[8] = "branch/main"::*u8;
    av[9] = "--quiet"::*u8;
    if (t_dep_cli(?a, 10, ?av[0]) != 0)                                                                { ret 23; }
    if (!t_project_history_unchanged(?s, ?a, root, head, head_ref, head_log, branch_log, staged_user)) { ret 24; }
    val added_state: TxnSnapshot = t_snapshot(?s, ?a, root, "x");
    if (!t_contains(added_state.manifest_text, "[dep.x]") || !t_contains(added_state.pin, "dep/x")) { ret 25; }
    if (!t_write(?a, fixture, "NEWS", "new dependency revision\n") || !t_commit_all(?a, fixture))   { ret 26; }
    av[2] = "update"::*u8;
    av[5] = "--quiet"::*u8;
    if (t_dep_cli(?a, 6, ?av[0]) != 0)                                                                 { ret 28; }
    if (!t_project_history_unchanged(?s, ?a, root, head, head_ref, head_log, branch_log, staged_user)) { ret 29; }
    val before: TxnSnapshot = t_snapshot(?s, ?a, root, "x");
    if (str_equals(added_state.pin, before.pin))                         { ret 30; }
    if (!t_write(?a, root, "dep/x/user-work", "untracked work stays\n")) { ret 31; }
    if (!t_write(?a, root, ".git/index.lock", "foreign native owner\n")) { ret 8; }
    val edit_begin_r: err[outcome.Fail] = edit_begin(?edit, ?a, root);
    if (sel edit_begin_r.err) {
        edit_finish(?edit, 1);
        ret 9;
    }
    val refused: i64 = mutate_apply(?edit, ?s, ?a, root, mode, ?spec, "x", false, false, true, 0);
    if (edit_finish(?edit, refused) == 0) { ret 10; }
    val after: TxnSnapshot = t_snapshot(?s, ?a, root, "x");
    if (!t_snapshot_equal(?before, ?after) || !t_exists_under(?a, root, "dep/x/user-work")) { ret 11; }
    val lock_r: res[str, A.Error] = path.join(?a, root, ".git/index.lock");
    if (sel lock_r.err) { ret 12; }
    val lock_path: str  = lock_r.ok;
    var present:   bool = false;
    if (!str_equals(t_read_or_empty(?a, lock_path, ?present), "foreign native owner\n")) { ret 13; }
    val remove_file_r: err[io_error.Error] = fs.remove_file(lock_path);
    if (sel remove_file_r.err) { ret 14; }
    av[2] = "remove"::*u8;
    if (t_dep_cli(?a, 6, ?av[0]) != 0) { ret 16; }
    val finished: TxnSnapshot = t_snapshot(?s, ?a, root, "x");
    if (t_contains(finished.manifest_text, "[dep.x]") || t_contains(finished.pin, "dep/x"))            { ret 17; }
    if (!t_exists_under(?a, root, "dep/x/user-work") || !t_exists_under(?a, root, "dep/x/.git"))       { ret 18; }
    if (!t_project_history_unchanged(?s, ?a, root, head, head_ref, head_log, branch_log, staged_user)) { ret 19; }
    ret 0;
}

test "mach.cli.cmd.dep.update:checkout_refusal_preserves_user_edits_and_late_failure_keeps_completed_checkout" {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    var git_env: [4]*u8;
    t_allow_file_transport(?git_env[0]);
    fin { deps.set_git_config_env(nil); }
    val fixture: str = t_tagged_b(?a);
    if (str_empty(fixture)) { ret 2; }
    fin { fs.remove_all(?a, fixture); }
    val root: str = t_root_repo(?a, "mach_dep_update_native", t_dep_table_ref(?a, "b", fixture, "tag/v1.0.0"));
    if (str_empty(root)) { ret 3; }
    fin { fs.remove_all(?a, root); }
    if (pull_project(root, true) != 0 || !t_commit_all(?a, root)) { ret 4; }
    var s:    session.Session;
    var mode: u8 = 0;
    if (!t_session_and_mode(?a, root, ?s, ?mode)) { ret 5; }
    fin { session.dnit(?s); }
    val dep_r: res[str, outcome.Fail] = deps.dep_full_of(?a, root, "b");
    if (sel dep_r.err) { ret 6; }
    val dep:        str                    = dep_r.ok;
    val original_r: res[str, outcome.Fail] = deps.checkout_head(?s, dep);
    if (sel original_r.err) { ret 7; }
    val original: str = original_r.ok;
    val source:   str = concat3(?a, "[project]\nid = \"root\"\nversion = \"0.1.0\"\nsrc = \"src\"\nout = \"out\"\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n", "", t_dep_table_ref(?a, "b", fixture, "tag/v2.0.0"));
    if (!t_write(?a, root, MANIFEST, source) || !t_write(?a, dep, "NEWS", "untracked user content\n")) { ret 8; }
    val before:       TxnSnapshot       = t_snapshot(?s, ?a, root, "b");
    var edit:         ManifestEdit;
    val edit_begin_r: err[outcome.Fail] = edit_begin(?edit, ?a, root);
    if (sel edit_begin_r.err) {
        edit_finish(?edit, 1);
        ret 9;
    }
    val refused: i64 = update_apply(?s, ?a, root, mode, false, "b", true, 0);
    if (edit_finish(?edit, refused) != 3) { ret 10; }
    val after: TxnSnapshot = t_snapshot(?s, ?a, root, "b");
    if (!t_snapshot_equal(?before, ?after)) { ret 11; }
    val news_r: res[str, A.Error] = path.join(?a, dep, "NEWS");
    if (sel news_r.err) { ret 12; }
    val news:    str  = news_r.ok;
    var present: bool = false;
    if (!str_equals(t_read_or_empty(?a, news, ?present), "untracked user content\n")) { ret 13; }
    val remove_file_r: err[io_error.Error] = fs.remove_file(news);
    if (sel remove_file_r.err) { ret 14; }
    val edit_begin_r2: err[outcome.Fail] = edit_begin(?edit, ?a, root);
    if (sel edit_begin_r2.err) {
        edit_finish(?edit, 1);
        ret 15;
    }
    val late: i64 = update_apply(?s, ?a, root, mode, false, "b", true, 1);
    if (edit_finish(?edit, late) != 1) { ret 16; }
    val changed_r: res[str, outcome.Fail] = deps.checkout_head(?s, dep);
    if (sel changed_r.err)                  { ret 17; }
    if (str_equals(original, changed_r.ok)) { ret 17; }
    val completed: TxnSnapshot = t_snapshot(?s, ?a, root, "b");
    if (!str_equals(before.pin, completed.pin) || !str_equals(before.manifest_text, completed.manifest_text)) { ret 18; }
    ret 0;
}

test "mach.cli.cmd.dep.path:unstaged_filesystem_dependency_builds_without_source_git" {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val source: str = t_scratch(?a, "mach_dep_path_source");
    if (str_empty(source)) { ret 2; }
    fin { fs.remove_all(?a, source); }
    if (!t_write(?a, source, MANIFEST, "[project]\nid = \"local\"\nversion = \"0.1.0\"\nsrc = \"src\"\nout = \"out\"\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n") || !t_lib_module(?a, source)) { ret 3; }
    val root: str = t_root_repo(?a, "mach_dep_path_root", "");
    if (str_empty(root)) { ret 4; }
    fin { fs.remove_all(?a, root); }
    var s:    session.Session;
    var mode: u8 = 0;
    if (!t_session_and_mode(?a, root, ?s, ?mode)) { ret 5; }
    fin { session.dnit(?s); }
    var spec: manifest.DepTableSpec;
    spec.name   = "local";
    spec.source = manifest.DEP_SOURCE_PATH;
    spec.value  = source;
    var edit:         ManifestEdit;
    val edit_begin_r: err[outcome.Fail] = edit_begin(?edit, ?a, root);
    if (sel edit_begin_r.err) {
        edit_finish(?edit, 1);
        ret 6;
    }
    val applied: i64 = mutate_apply(?edit, ?s, ?a, root, mode, ?spec, "local", true, false, true, 0);
    if (edit_finish(?edit, applied) != 0) { ret 7; }
    val staged: res[str, outcome.Fail] = deps.staged_paths(?s, root, "dep/local");
    if (sel staged.err)                                                                   { ret 8; }
    if (!str_empty(staged.ok))                                                            { ret 8; }
    if (verify_project(root) != 0 || !t_build_ok(?s, root))                               { ret 9; }
    if (t_exists_under(?a, source, ".git") || t_exists_under(?a, root, "dep/local/.git")) { ret 10; }
    val copied_r: res[str, outcome.Fail] = deps.dep_full_of(?a, root, "local");
    if (sel copied_r.err) { ret 11; }
    val copied: str = copied_r.ok;
    fin { str_free(?a, copied); }
    val remove_all_r: err[fs.FsError] = fs.remove_all(?a, copied);
    if (sel remove_all_r.err) { ret 12; }
    var reqs: Vector[DepReq] = vector.init[DepReq](?a);
    fin { free_requests(?a, ?reqs); }
    if (realize_closure(?s, ?a, root, ?reqs, true, false, nil) != 0) { ret 13; }
    if (verify_project(root) != 0 || !t_build_ok(?s, root))          { ret 14; }
    ret 0;
}
