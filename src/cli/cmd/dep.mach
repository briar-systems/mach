# `mach dep` and its actions: list, add, remove, update, pull, outdated and verify
#
# each action's flags are read here and its work is the package manager's (mach.package).

use diagnostic_kind: mach.base.diagnostic.kind;
use mach.base.fail;
use std_args: std.args;
use std.collections.slice.Slice;
use collections_vector: std.collections.vector;
use std.collections.vector.Vector;
use std_format: std.format;
use io_writer:  std.io.writer;
use std.process.exec;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use types_path: std.types.path;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use A: std.allocator;

use mach.cli.args;
use cli_diagnostic: mach.cli.diagnostic;
use mach.cli.exit;
use mach.cli.util;
use mach.compile.project;
use manifest_edit:   mach.manifest.edit;
use manifest_load:   mach.manifest.load;
use manifest_schema: mach.manifest.schema;
use package_closure: mach.package.closure;
use package_edit:    mach.package.edit;
use mach.package.git;
use package_list: mach.package.list;
use package_pull: mach.package.pull;
use mach.package.report;
use package_resolve: mach.package.resolve;
use package_verify:  mach.package.verify;
use mach.report.layout;
use mach.report.readout;
use mach.session;

val MANIFEST: str = manifest_load.MANIFEST_FILE;

# `--git <url>`
val GIT: std_args.Flag = std_args.Flag{long: "git", short: 0, value: "url", repeat: false, negatable: false, help: "use a Git URL source"};
# `--path <dir>`
val PATH: std_args.Flag = std_args.Flag{long: "path", short: 0, value: "dir", repeat: false, negatable: false, help: "use a local path source"};
# `--ref <ref>`
val REF: std_args.Flag = std_args.Flag{long: "ref", short: 0, value: "branch/<n>|tag/<n>|commit/<n>", repeat: false, negatable: false, help: "select a Git reference"};
# `--range <range>`
val RANGE: std_args.Flag = std_args.Flag{long: "range", short: 0, value: "range", repeat: false, negatable: false, help: "select releases in a version range (default: ^ of the newest compatible)"};
# `--purge`
val PURGE: std_args.Flag = std_args.Flag{long: "purge", short: 0, value: nil, repeat: false, negatable: false, help: "also delete the dependency directory"};
# `--lowest`
val LOWEST: std_args.Flag = std_args.Flag{long: "lowest", short: 0, value: nil, repeat: false, negatable: false, help: "select the lowest release every range accepts"};
# `--release`
val RELEASE: std_args.Flag = std_args.Flag{long: "release", short: 0, value: nil, repeat: false, negatable: false, help: "also require every dependency to select a release"};
# `--all`, every declared dependency where a name would select one
val ALL_DEPS: std_args.Flag = std_args.Flag{long: "all", short: 0, value: nil, repeat: false, negatable: false, help: "update every declared dependency"};

# the flags every dep action takes
val PLAIN_FLAGS: [3]*std_args.Flag = [3]*std_args.Flag{?args.HELP, ?args.REPORT, ?args.QUIET};

# the flags of pull, which fetches
val PULL_FLAGS: [4]*std_args.Flag = [4]*std_args.Flag{?args.HELP, ?args.REPORT, ?args.VERBOSE, ?args.QUIET};
# the flags of dep add
val ADD_FLAGS: [9]*std_args.Flag = [9]*std_args.Flag{?args.HELP, ?args.REPORT, ?args.VERBOSE, ?args.QUIET, ?GIT, ?PATH, ?REF, ?RANGE, ?args.OFFLINE};
# the flags of dep remove
val REMOVE_FLAGS: [4]*std_args.Flag = [4]*std_args.Flag{?args.HELP, ?args.REPORT, ?args.QUIET, ?PURGE};
# the flags of dep update
val UPDATE_FLAGS: [7]*std_args.Flag = [7]*std_args.Flag{?args.HELP, ?args.REPORT, ?args.VERBOSE, ?args.QUIET, ?ALL_DEPS, ?LOWEST, ?args.OFFLINE};
# the flags of dep outdated
val OUTDATED_FLAGS: [5]*std_args.Flag = [5]*std_args.Flag{?args.HELP, ?args.REPORT, ?args.VERBOSE, ?args.QUIET, ?args.OFFLINE};
# the flags of dep verify
val VERIFY_FLAGS: [4]*std_args.Flag = [4]*std_args.Flag{?args.HELP, ?args.REPORT, ?args.QUIET, ?RELEASE};

# length of ADD_CONFLICTS
val ADD_CONFLICTS_N: usize = 4;
# a dependency has one source, and a reference or a range selects only a Git one
val ADD_CONFLICTS: [ADD_CONFLICTS_N]args.Conflict = [ADD_CONFLICTS_N]args.Conflict{
    args.Conflict{flag: ?GIT, other: ?PATH},
    args.Conflict{flag: ?PATH, other: ?REF},
    args.Conflict{flag: ?PATH, other: ?RANGE},
    args.Conflict{flag: ?REF, other: ?RANGE},
};
# `mach dep list`
pub val LIST: std_args.Command = std_args.Command{name: "list", aliases: args.NO_WORDS, help: "list declared dependencies and their state", usage: "<path>", flags: Slice[*std_args.Flag]{data: ?PLAIN_FLAGS[0], size: 3}, commands: args.NO_COMMANDS, operand_min: 1, operand_max: 1, passthrough: false};
# `mach dep add`
pub val ADD: std_args.Command = std_args.Command{name: "add", aliases: args.NO_WORDS, help: "declare a dependency", usage: "<path> <name> (--git <url> [--ref <ref> | --range <range>] | --path <dir>)", flags: Slice[*std_args.Flag]{data: ?ADD_FLAGS[0], size: 9}, commands: args.NO_COMMANDS, operand_min: 2, operand_max: 2, passthrough: false};
# `mach dep remove`
pub val REMOVE: std_args.Command = std_args.Command{name: "remove", aliases: args.NO_WORDS, help: "remove a dependency", usage: "<path> <name>", flags: Slice[*std_args.Flag]{data: ?REMOVE_FLAGS[0], size: 4}, commands: args.NO_COMMANDS, operand_min: 2, operand_max: 2, passthrough: false};
# `mach dep update`
pub val UPDATE: std_args.Command = std_args.Command{name: "update", aliases: args.NO_WORDS, help: "advance dependencies to their newest selected revisions", usage: "<path> (<name> | --all)", flags: Slice[*std_args.Flag]{data: ?UPDATE_FLAGS[0], size: 7}, commands: args.NO_COMMANDS, operand_min: 1, operand_max: 2, passthrough: false};
# `mach dep pull`
pub val PULL: std_args.Command = std_args.Command{name: "pull", aliases: args.NO_WORDS, help: "realize dependencies at their pinned revisions", usage: "<path>", flags: Slice[*std_args.Flag]{data: ?PULL_FLAGS[0], size: 4}, commands: args.NO_COMMANDS, operand_min: 1, operand_max: 1, passthrough: false};
# `mach dep outdated`
pub val OUTDATED: std_args.Command = std_args.Command{name: "outdated", aliases: args.NO_WORDS, help: "report pinned, compatible and latest releases", usage: "<path>", flags: Slice[*std_args.Flag]{data: ?OUTDATED_FLAGS[0], size: 5}, commands: args.NO_COMMANDS, operand_min: 1, operand_max: 1, passthrough: false};
# `mach dep verify`
pub val VERIFY: std_args.Command = std_args.Command{name: "verify", aliases: args.NO_WORDS, help: "check the realized dependencies against the manifest", usage: "<path>", flags: Slice[*std_args.Flag]{data: ?VERIFY_FLAGS[0], size: 4}, commands: args.NO_COMMANDS, operand_min: 1, operand_max: 1, passthrough: false};

# what mach holds `mach dep add` to beyond the parse
pub val ADD_POLICY: args.Policy = args.Policy{refused: args.NO_FLAGS, refusal: "", conflicts: Slice[args.Conflict]{data: ?ADD_CONFLICTS[0], size: ADD_CONFLICTS_N}};
# what mach holds `mach dep update` to beyond the parse
pub val UPDATE_POLICY: args.Policy = args.Policy{refused: args.NO_FLAGS, refusal: "", conflicts: args.NO_CONFLICTS};
# what mach holds `mach dep verify` to beyond the parse
pub val VERIFY_POLICY: args.Policy = args.Policy{refused: args.NO_FLAGS, refusal: "", conflicts: args.NO_CONFLICTS};
# what mach holds `mach dep` and its other actions to beyond the parse
pub val POLICY: args.Policy = args.Policy{refused: args.NO_FLAGS, refusal: "", conflicts: args.NO_CONFLICTS};

# length of ACTIONS
val ACTIONS_N: usize = 7;
# the dep actions in help order
val ACTIONS: [ACTIONS_N]*std_args.Command = [ACTIONS_N]*std_args.Command{?LIST, ?ADD, ?REMOVE, ?UPDATE, ?PULL, ?OUTDATED, ?VERIFY};

# `mach dep`
pub val COMMAND: std_args.Command = std_args.Command{name: "dep", aliases: args.NO_WORDS, help: "manage project dependencies", usage: "", flags: Slice[*std_args.Flag]{data: ?PLAIN_FLAGS[0], size: 3}, commands: Slice[*std_args.Command]{data: ?ACTIONS[0], size: ACTIONS_N}, operand_min: 0, operand_max: 0, passthrough: false};

# the dep options an invocation was given
# ---
# quiet:   `--quiet`
# all:     `--all`
# purge:   `--purge`
# lowest:  `--lowest`
# offline: `--offline`
# release: `--release`
# git:     the `--git` url
# path:    the `--path` directory
# ref:     the `--ref` reference
# range:   the `--range` range
rec Options {
    quiet:   bool;
    all:     bool;
    purge:   bool;
    lowest:  bool;
    offline: bool;
    release: bool;
    git:     opt[*u8];
    path:    opt[*u8];
    ref:     opt[*u8];
    range:   opt[*u8];
}

fun options_of(inv: *std_args.Parsed) Options {
    ret Options{
        quiet:  std_args.given(inv, ?args.QUIET), all: std_args.given(inv, ?ALL_DEPS), purge: std_args.given(inv, ?PURGE),
        lowest: std_args.given(inv, ?LOWEST), offline: std_args.given(inv, ?args.OFFLINE), release: std_args.given(inv, ?RELEASE),
        git:    args.value(inv, ?GIT), path: args.value(inv, ?PATH), ref: args.value(inv, ?REF),
        range:  args.value(inv, ?RANGE)
    };
}

# `mach dep`: route to one action: list, add, remove, update, pull, verify or outdated, each a
# command over the dependency manager (mach.package) that renders what it reports
# ---
# cx:  the call, its action read and its operands counted
# ret: exit.OK, the code `exit.of` maps the action's rendered failure to, or the failure that
#      kept the action from starting
pub fun run(cx: *args.Call) res[i64, fail.Fail] {
    val inv:    *std_args.Parsed  = cx.inv;
    var parsed: Options           = options_of(inv);
    val action: *std_args.Command = inv.command;
    if (action == ?COMMAND) {
        ret res[i64, fail.Fail].err{fail.user(diagnostic_kind.CLI_UNKNOWN_ACTION, "mach dep needs an action, one of list, add, remove, update, pull, outdated or verify")};
    }

    val project: *u8                                  = args.operand(inv, 0);
    val res_loc: res[util.ProjectLocation, fail.Fail] = util.resolve_project_location(cx.a, project::str);
    if (sel res_loc.err) {
        val res_said: res[str, std_format.FormatError] = std_format.sprint(cx.a, "mach dep {} cannot find project '{}' ({})", action.name, project::str, fail.describe(res_loc.err));
        if (sel res_said.err) { ret res[i64, fail.Fail].err{res_loc.err}; }
        ret res[i64, fail.Fail].err{fail.owning(fail.with_text(res_loc.err, res_said.ok))};
    }
    val root: str = res_loc.ok.root;
    val name: *u8 = args.operand(inv, 1);

    val a:       *A.Allocator           = cx.a;
    val environ: exec.Environment       = cx.environ;
    val r:       *cli_diagnostic.Report = cx.report;
    if (action == ?LIST)     { ret dep_list(a, r, root, environ); }
    if (action == ?ADD)      { ret dep_add(a, r, root, name, ?parsed, environ); }
    if (action == ?REMOVE)   { ret dep_remove(a, r, root, name, ?parsed, environ); }
    if (action == ?UPDATE)   { ret dep_update(a, r, root, name, ?parsed, environ); }
    if (action == ?PULL)     { ret pull_project(a, r, root, parsed.quiet, environ); }
    if (action == ?OUTDATED) { ret dep_outdated(a, r, root, parsed.offline, environ); }
    ret verify_project(a, r, root, parsed.release, environ);
}

# a session for a dependency action, running git in environ
fun dep_session(a: *A.Allocator, r: *cli_diagnostic.Report, environ: exec.Environment) res[session.Session, fail.Fail] {
    val res_init_in: res[session.Session, fail.Fail] = session.init_in(a, r.sources);
    if (sel res_init_in.err) { ret res[session.Session, fail.Fail].err{fail.prefixed(a, "cannot start a session", res_init_in.err)}; }
    var s: session.Session = res_init_in.ok;
    s.environ = environ;
    ret res[session.Session, fail.Fail].ok{s};
}

# `mach dep pull`: realize the dependency closure of a project (package_pull.project_closure)
# ---
# a:       owns what the pull allocates
# root:    the project root directory
# quiet:   suppress result lines
# environ: the environment git runs in
# ret:     exit.OK when realized, the code `exit.of` maps the rendered failure to, or the failure
#          that kept the pull from starting
fun pull_project(a: *A.Allocator, r: *cli_diagnostic.Report, root: str, quiet: bool, environ: exec.Environment) res[i64, fail.Fail] {
    val res_dep_session: res[session.Session, fail.Fail] = dep_session(a, r, environ);
    if (sel res_dep_session.err) { ret res[i64, fail.Fail].err{res_dep_session.err}; }
    var s: session.Session = res_dep_session.ok;
    fin { session.dnit(?s); }
    var rep: report.Report = cli_diagnostic.dependency_report(a, r);
    fin { report.dnit(?rep); }
    ret res[i64, fail.Fail].ok{cli_diagnostic.dependency_outcome(?rep, package_pull.project_closure(?s, a, root, quiet, ?rep))};
}

# `mach dep verify`: check that every dependency of a project is realized and consistent
# without changing anything (package_verify.project_closure); prints "ok" on success
# ---
# a:       owns what the check allocates
# root:    the project root directory
# release: also refuse a root dependency selected by a branch, a commit or a path
# environ: the environment git runs in
# ret:     exit.OK when verified, exit.USER for a directory outside the closure, otherwise the
#          code `exit.of` maps the rendered failure to, or the failure that kept it from starting
fun verify_project(a: *A.Allocator, r: *cli_diagnostic.Report, root: str, release: bool, environ: exec.Environment) res[i64, fail.Fail] {
    val res_dep_session: res[session.Session, fail.Fail] = dep_session(a, r, environ);
    if (sel res_dep_session.err) { ret res[i64, fail.Fail].err{res_dep_session.err}; }
    var s: session.Session = res_dep_session.ok;
    fin { session.dnit(?s); }
    var rep: report.Report = cli_diagnostic.dependency_report(a, r);
    fin { report.dnit(?rep); }
    val rc: i64 = cli_diagnostic.dependency_outcome(?rep, package_verify.project_closure(?s, a, root, release, ?rep));
    if (rc == exit.OK) {
        var texts: [1]str = [1]str{root};
        cli_diagnostic.said_row(cli_diagnostic.out(r), layout.VERIFIED, ?texts[0], 1);
    }
    ret res[i64, fail.Fail].ok{rc};
}

# `mach dep outdated`: each version-selected identity's pinned release, the highest this
# compiler and every range accept, and the highest release published
fun dep_outdated(a: *A.Allocator, r: *cli_diagnostic.Report, root: str, offline: bool, environ: exec.Environment) res[i64, fail.Fail] {
    val res_dep_session: res[session.Session, fail.Fail] = dep_session(a, r, environ);
    if (sel res_dep_session.err) { ret res[i64, fail.Fail].err{res_dep_session.err}; }
    var s: session.Session = res_dep_session.ok;
    fin { session.dnit(?s); }
    var rep: report.Report = cli_diagnostic.dependency_report(a, r);
    fin { report.dnit(?rep); }
    val res_mt_path: res[str, A.Error] = types_path.join(a, root, MANIFEST);
    if (sel res_mt_path.err) { ret res[i64, fail.Fail].err{fail.refused(res_mt_path.err)}; }
    val res_parse_file: res[manifest_load.Doc, fail.Fail] = package_closure.parse_file(a, r.sources, res_mt_path.ok);
    if (sel res_parse_file.err) { ret res[i64, fail.Fail].err{res_parse_file.err}; }
    var mt:         manifest_load.Doc                         = res_parse_file.ok;
    val res_opened: res[package_closure.Operation, fail.Fail] = package_closure.init(?s, a, root, ?rep);
    if (sel res_opened.err) { ret res[i64, fail.Fail].err{res_opened.err}; }
    var op: package_closure.Operation = res_opened.ok;
    # each remote's releases are fetched as the walk finds it, so the live line counts none
    report.stage(?rep, 0);
    cli_diagnostic.live_begin(r, cli_diagnostic.FETCH_LABEL);
    val began:        readout.Instant                          = readout.sample();
    val res_computed: res[package_resolve.Outdated, fail.Fail] = package_resolve.outdated(?op, ?mt, offline);
    cli_diagnostic.live_end(r);
    if (rep.fetches != 0) {
        var t:  layout.Text;
        var tw: io_writer.Writer = layout.text_writer(?t);
        std_format.format(?tw, "{} {}", rep.fetches::u64, layout.noun(rep.fetches::u64, "source", "sources"));
        cli_diagnostic.log_stage(r, cli_diagnostic.FETCH_LABEL, readout.elapsed(began), layout.text_end(?t));
    }
    if (sel res_computed.err) { ret res[i64, fail.Fail].ok{cli_diagnostic.dependency_outcome(?rep, package_closure.ended(?op, err[fail.Fail].err{res_computed.err}))}; }
    val err_ended: err[fail.Fail] = package_closure.dnit(?op);
    if (sel err_ended.err) { ret res[i64, fail.Fail].ok{cli_diagnostic.dependency_outcome(?rep, err_ended)}; }
    var shown: package_resolve.Outdated = res_computed.ok;
    var i:     usize                    = 0;
    for (i < shown.notes.len) {
        report.note(?rep, shown.notes.data[i]);
        i = i + 1;
    }
    if (!shown.ranged) {
        std_format.write_str(cli_diagnostic.out(r), "no dependency selects releases by version\n");
        ret res[i64, fail.Fail].ok{exit.OK};
    }
    # each column as wide as its widest cell, the header's among them
    val w:      *io_writer.Writer = cli_diagnostic.out(r);
    var header: [4]str            = [4]str{"dependency", "pinned", "compatible", "latest"};
    var cols:   [4]layout.Column;
    var k:      usize             = 0;
    for (k < 4) {
        cols[k] = layout.Column{width: 0, align: layout.LEFT, gap: layout.GAP};
        layout.fit(?cols[k], header[k]);
        k = k + 1;
    }
    cols[0].gap = 0;
    i           = 0;
    for (i < shown.rows.len) {
        val row: *package_resolve.OutdatedRow = ?shown.rows.data[i];
        layout.fit(?cols[0], row.id);
        layout.fit(?cols[1], row.pinned);
        layout.fit(?cols[2], row.compatible);
        layout.fit(?cols[3], row.latest);
        i = i + 1;
    }
    layout.row(w, ?cols[0], ?header[0], 4);
    i = 0;
    for (i < shown.rows.len) {
        val row: *package_resolve.OutdatedRow = ?shown.rows.data[i];
        i = i + 1;
        var texts: [4]str = [4]str{row.id, row.pinned, row.compatible, row.latest};
        layout.cells(w, ?cols[0], ?texts[0], 4);
        if (!str_equals(row.latest, row.compatible)) { layout.aside(w, "(held back: a range excludes the newer release, or it needs a newer compiler)"); }
        std_format.write_newline(w);
    }
    ret res[i64, fail.Fail].ok{exit.OK};
}

# the refusal of a dependency name that is no portable identifier, which `mach dep remove` takes
# so that it can remove a table whose name is no project id
fun invalid_name() res[i64, fail.Fail] {
    ret res[i64, fail.Fail].err{fail.user(diagnostic_kind.MANIFEST_INVALID_NAME, "dependency name must be a portable identifier (letters, digits, '_', '-')")};
}

# the refusal of a dependency name that is no project id, as the manifest refuses it
fun not_project_id(a: *A.Allocator, name: *u8) res[i64, fail.Fail] {
    ret res[i64, fail.Fail].err{manifest_schema.dep_name_refused(a, name::str)};
}

# `mach dep update`: move one named root-declared or transitive identity, or every one under
# `--all`, its range resolved to the lowest admitted release under `--lowest` (package_edit.update)
fun dep_update(a: *A.Allocator, r: *cli_diagnostic.Report, root: str, name: *u8, parsed: *Options, environ: exec.Environment) res[i64, fail.Fail] {
    val all: bool = parsed.all;
    if (!all && name == nil)                                      { ret res[i64, fail.Fail].err{fail.user(diagnostic_kind.CLI_OPERAND, "mach dep update needs <path> and then a <name> or --all")}; }
    if (all && name != nil)                                       { ret res[i64, fail.Fail].err{fail.user(diagnostic_kind.CLI_FLAG_CONFLICT, "give a name or --all, not both")}; }
    if (name != nil && !manifest_schema.is_project_id(name::str)) { ret not_project_id(a, name); }

    val res_dep_session: res[session.Session, fail.Fail] = dep_session(a, r, environ);
    if (sel res_dep_session.err) { ret res[i64, fail.Fail].err{res_dep_session.err}; }
    var s: session.Session = res_dep_session.ok;
    fin { session.dnit(?s); }
    var rep: report.Report = cli_diagnostic.dependency_report(a, r);
    fin { report.dnit(?rep); }
    val res_opened: res[package_closure.Operation, fail.Fail] = package_closure.init(?s, a, root, ?rep);
    if (sel res_opened.err) { ret res[i64, fail.Fail].err{res_opened.err}; }
    var op:      package_closure.Operation = res_opened.ok;
    val err_run: err[fail.Fail]            = package_edit.update(?op, all, name::str, parsed.quiet, parsed.lowest, parsed.offline);
    ret res[i64, fail.Fail].ok{cli_diagnostic.dependency_outcome(?rep, package_closure.ended(?op, err_run))};
}

# `mach dep add`: declare the dependency `name` with its one `--git` or `--path` source, then
# realize it
fun dep_add(a: *A.Allocator, r: *cli_diagnostic.Report, root: str, name: *u8, parsed: *Options, environ: exec.Environment) res[i64, fail.Fail] {
    val opt_git:  opt[*u8] = parsed.git;
    val opt_path: opt[*u8] = parsed.path;
    val opt_ref:  opt[*u8] = parsed.ref;
    val opt_ver:  opt[*u8] = parsed.range;
    val has_git:  bool     = sel opt_git.some;
    val has_path: bool     = sel opt_path.some;
    if (!has_git && !has_path) {
        ret res[i64, fail.Fail].err{fail.user(diagnostic_kind.DEP_SOURCE_COUNT, "give exactly one source, --git <url> or --path <dir>")};
    }
    if (!manifest_schema.is_project_id(name::str)) { ret not_project_id(a, name); }

    var spec: manifest_edit.DepTableSpec;
    spec.name = name::str;
    if (has_git) {
        spec.source  = manifest_edit.DEP_SOURCE_GIT;
        spec.value   = opt_value(opt_git)::str;
        spec.ref     = opt_value(opt_ref)::str;
        spec.version = opt_value(opt_ver)::str;
        if (spec.ref == nil)     { spec.ref = ""; }
        if (spec.version == nil) { spec.version = ""; }
    }
    or {
        spec.source  = manifest_edit.DEP_SOURCE_PATH;
        spec.value   = opt_value(opt_path)::str;
        spec.ref     = "";
        spec.version = "";
    }
    ret mutate_manifest(a, r, root, ?spec, name::str, true, false, parsed.quiet, true, parsed.offline, environ);
}

# `mach dep remove`: drop the dependency table `name`, its directory too under `--purge`
fun dep_remove(a: *A.Allocator, r: *cli_diagnostic.Report, root: str, name: *u8, parsed: *Options, environ: exec.Environment) res[i64, fail.Fail] {
    if (!manifest_schema.is_valid_id(name::str)) { ret invalid_name(); }
    var spec: manifest_edit.DepTableSpec;
    spec.name   = name::str;
    spec.source = manifest_edit.DEP_SOURCE_PATH;
    spec.value  = "";
    spec.ref    = "";
    ret mutate_manifest(a, r, root, ?spec, name::str, false, parsed.purge, parsed.quiet, true, false, environ);
}

# change the manifest's dependency table `spec` names through the package manager
# (package_edit.change) and render how it ended
# ---
# adding:  add the table rather than remove it
# purge:   also delete the dependency directory of a removed table
# quiet:   suppress result lines
# realize: realize the closure after the change
# offline: fetch nothing
# ret:     the code dependency_outcome gives, or the failure that kept the change from starting
fun mutate_manifest(a: *A.Allocator, r: *cli_diagnostic.Report, root: str, spec: *manifest_edit.DepTableSpec, name: str, adding: bool, purge: bool,
    quiet: bool, realize: bool, offline: bool, environ: exec.Environment) res[i64, fail.Fail] {
    val res_dep_session: res[session.Session, fail.Fail] = dep_session(a, r, environ);
    if (sel res_dep_session.err) { ret res[i64, fail.Fail].err{res_dep_session.err}; }
    var s: session.Session = res_dep_session.ok;
    fin { session.dnit(?s); }
    var rep: report.Report = cli_diagnostic.dependency_report(a, r);
    fin { report.dnit(?rep); }
    val res_opened: res[package_closure.Operation, fail.Fail] = package_closure.init(?s, a, root, ?rep);
    if (sel res_opened.err) { ret res[i64, fail.Fail].err{res_opened.err}; }
    var op:      package_closure.Operation = res_opened.ok;
    val err_run: err[fail.Fail]            = package_edit.change(?op, spec, name, adding, purge, quiet, realize, offline);
    ret res[i64, fail.Fail].ok{cli_diagnostic.dependency_outcome(?rep, package_closure.ended(?op, err_run))};
}

# `mach dep list`: a line on stdout for each declared dependency with its source and state, and
# one for each requirement it overrides
fun dep_list(a: *A.Allocator, r: *cli_diagnostic.Report, root: str, environ: exec.Environment) res[i64, fail.Fail] {
    val res_dep_session: res[session.Session, fail.Fail] = dep_session(a, r, environ);
    if (sel res_dep_session.err) { ret res[i64, fail.Fail].err{res_dep_session.err}; }
    var s: session.Session = res_dep_session.ok;
    fin { session.dnit(?s); }
    var rep: report.Report = cli_diagnostic.dependency_report(a, r);
    fin { report.dnit(?rep); }
    val res_opened: res[package_closure.Operation, fail.Fail] = package_closure.init(?s, a, root, ?rep);
    if (sel res_opened.err) { ret res[i64, fail.Fail].err{res_opened.err}; }
    var op:   package_closure.Operation = res_opened.ok;
    var rows: Vector[package_list.Row]  = collections_vector.init[package_list.Row](a);
    val rc:   i64                       = cli_diagnostic.dependency_outcome(?rep, package_closure.ended(?op, package_list.lines(?op, ?rows)));
    if (rc == exit.OK && rows.len == 0) {
        std_format.write_str(cli_diagnostic.out(r), "no dependencies\n");
        ret res[i64, fail.Fail].ok{rc};
    }
    # a name column as wide as the widest name, and a requirement it overrides under what is listed of it
    var cols: [2]layout.Column = [2]layout.Column{layout.Column{width: 0, align: layout.LEFT, gap: layout.GAP}, layout.Column{width: 0, align: layout.LEFT, gap: layout.GAP}};
    var i:    usize            = 0;
    for (i < rows.len) {
        layout.fit(?cols[0], rows.data[i].name);
        i = i + 1;
    }
    i = 0;
    for (i < rows.len) {
        var texts: [2]str = [2]str{rows.data[i].name, rows.data[i].text};
        layout.row(cli_diagnostic.out(r), ?cols[0], ?texts[0], 2);
        i = i + 1;
    }
    ret res[i64, fail.Fail].ok{rc};
}

# the value a flag was given, "" when it was not
fun opt_value(found: opt[*u8]) *u8 {
    if (sel found.none) { ret ""; }
    ret found.some;
}
