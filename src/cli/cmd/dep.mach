use mach.lang.driver.deps;
use mach.lang.publication;

val MANIFEST: str = manifest.MANIFEST_FILE;

rec DepReq {
    id:        str;
    url:       str;
    src_path:  str;
    ref:       str;
    chain:     str;
    root_decl: bool;
    is_git:    bool;
    effect:    str;
}

# `mach dep`: route to one action: list, add, remove, update, pull, verify, or the
# deprecated sync, which runs pull after a note
# ---
# argv: the full process arguments
# inv: the parsed invocation for this command
# ret: 0 success, 1 missing or unknown action, unknown flag, or a failed action, 2 setup failure
pub fun run_typed(argv: **u8, inv: *args.ParsedInvocation) i64 {
    if (!inv.has_action) {
        if (inv.argc < 3) {
            print.eprint("error: missing dep action\n");
            print.eprint("usage: mach dep <pull|verify|update|add|remove|list>\n");
            ret 1;
        }
        print.eprint("error: unknown dep action '");
        print.eprint(argv[2]::str);
        print.eprint("'\n");
        print.eprint("usage: mach dep <pull|verify|update|add|remove|list>\n");
        ret 1;
    }

    val parsed: args.DepInvocation = args.build_dep_invocation(inv);
    val argc:   usize              = inv.argc;

    if (parsed.action == args.DEPACT_LIST) {
        if (args.reject_unknown_from_invocation(inv, argv, "mach dep list")) { ret 1; }
        ret dep_list();
    }
    if (parsed.action == args.DEPACT_ADD) {
        if (args.reject_unknown_from_invocation(inv, argv, "mach dep add")) { ret 1; }
        ret dep_add(argc, argv);
    }
    if (parsed.action == args.DEPACT_REMOVE) {
        if (args.reject_unknown_from_invocation(inv, argv, "mach dep remove")) { ret 1; }
        ret dep_remove(argc, argv);
    }
    if (parsed.action == args.DEPACT_UPDATE) {
        if (args.reject_unknown_from_invocation(inv, argv, "mach dep update")) { ret 1; }
        ret dep_update(argc, argv);
    }
    if (parsed.action == args.DEPACT_PULL) {
        if (args.reject_unknown_from_invocation(inv, argv, "mach dep pull")) { ret 1; }
        ret pull_action_typed(argv, inv, parsed.quiet);
    }
    if (parsed.action == args.DEPACT_VERIFY) {
        if (args.reject_unknown_from_invocation(inv, argv, "mach dep verify")) { ret 1; }
        ret verify_action_typed(argv, inv);
    }
    if (parsed.action == args.DEPACT_SYNC) {
        if (args.reject_unknown_from_invocation(inv, argv, "mach dep sync")) { ret 1; }
        print.eprint("note: `mach dep sync` is deprecated; use `mach dep pull`\n");
        ret pull_action_typed(argv, inv, parsed.quiet);
    }

    print.eprint("error: unknown dep action '");
    print.eprint(argv[2]::str);
    print.eprint("'\n");
    print.eprint("usage: mach dep <pull|verify|update|add|remove|list>\n");
    ret 1;
}

fun pull_action_typed(argv: **u8, inv: *args.ParsedInvocation, quiet: bool) i64 {
    var a: A.Allocator;
    if (O.is_some[str](page.make(?a))) { err_line("failed to initialise allocator"); ret 2; }

    var arg: str = ".";
    if (inv.has_positional) { arg = argv[inv.positional_idx]::str; }

    val loc_r: R.Result[util.ProjectLocation, str] = util.resolve_project_location(?a, arg);
    if (R.is_err[util.ProjectLocation, str](loc_r)) {
        err_line(R.unwrap_err[util.ProjectLocation, str](loc_r));
        ret 1;
    }
    ret pull_project(R.unwrap_ok[util.ProjectLocation, str](loc_r).root, quiet);
}

fun verify_action_typed(argv: **u8, inv: *args.ParsedInvocation) i64 {
    var a: A.Allocator;
    if (O.is_some[str](page.make(?a))) { err_line("failed to initialise allocator"); ret 2; }

    var arg: str = ".";
    if (inv.has_positional) { arg = argv[inv.positional_idx]::str; }

    val loc_r: R.Result[util.ProjectLocation, str] = util.resolve_project_location(?a, arg);
    if (R.is_err[util.ProjectLocation, str](loc_r)) {
        err_line(R.unwrap_err[util.ProjectLocation, str](loc_r));
        ret 1;
    }
    ret verify_project(R.unwrap_ok[util.ProjectLocation, str](loc_r).root);
}

# realize the dependency closure of a project: clone or link every declared dependency
# transitively, check each realized manifest's project id against its declared name, and
# report realized directories under dep/ that are no longer in the closure
# ---
# root: the project root directory
# quiet: suppress progress lines
# ret: 0 realized, 1 a manifest, resolution, identity, or checkout error (printed), 2 the
#  allocator or session could not be initialised
pub fun pull_project(root: str, quiet: bool) i64 {
    var a: A.Allocator;
    if (O.is_some[str](page.make(?a))) { err_line("failed to initialise allocator"); ret 2; }
    val sr: R.Result[session.Session, str] = session.init(?a);
    if (R.is_err[session.Session, str](sr)) { err_line("failed to initialise a session"); ret 2; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    var reqs: Vector[DepReq] = vector.init[DepReq](?a);
    fin { free_requests(?a, ?reqs); }
    val rc: i64 = realize_closure(?s, ?a, root, ?reqs, quiet, false, nil);
    session.dnit(?s);
    ret rc;
}

# check that every dependency of a project is realized and consistent without changing
# anything; prints "ok" on success. a project root that is not a repository root is noted
# and verified from the realized checkouts. a realized directory under dep/ outside the
# closure is an error here, where pull reports and retains it
# ---
# root: the project root directory
# ret: 0 verified, 1 a mismatch or error (printed), 2 the allocator or session could not be
#  initialised
pub fun verify_project(root: str) i64 {
    var a: A.Allocator;
    if (O.is_some[str](page.make(?a))) { err_line("failed to initialise allocator"); ret 2; }
    val sr: R.Result[session.Session, str] = session.init(?a);
    if (R.is_err[session.Session, str](sr)) { err_line("failed to initialise a session"); ret 2; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);


    var reqs: Vector[DepReq] = vector.init[DepReq](?a);
    fin { free_requests(?a, ?reqs); }
    var rc: i64 = realize_closure(?s, ?a, root, ?reqs, true, true, nil);
    if (rc == 0 && reqs.len > 0) {
        val vr: R.Result[R.Void, str] = driver.verify_dependencies(?s, root);
        if (R.is_err[R.Void, str](vr)) { err_line(R.unwrap_err[R.Void, str](vr)); rc = 1; }
    }
    session.dnit(?s);
    deps.print_stale_lock_note(?a, root);
    if (rc == 0) { print.print("ok\n"); }
    ret rc;
}

fun realize_closure(s: *session.Session, a: *A.Allocator, root: str, reqs: *Vector[DepReq],
                    quiet: bool, verify_only: bool, candidate: *toml.Table) i64 {
    val mode_r: R.Result[u8, str] = deps.realization_mode(s, root);
    if (R.is_err[u8, str](mode_r)) { err_line(R.unwrap_err[u8, str](mode_r)); ret 1; }
    val mode: u8 = R.unwrap_ok[u8, str](mode_r);

    var guard: txn.Root;
    val guard_r: R.Result[bool, str] = dep_root_for(?guard, root);
    if (R.is_err[bool, str](guard_r)) { err_line(R.unwrap_err[bool, str](guard_r)); ret 1; }
    val closed: O.Option[txn.Error] = txn.root_dnit(?guard);
    if (O.is_some[txn.Error](closed)) { err_line(txn.error_message(O.unwrap[txn.Error](closed))); ret 1; }

    var parsed: toml.Table;
    var mt: *toml.Table = candidate;
    if (mt == nil) {
        val mt_path_r: R.Result[str, str] = path.join(a, root, MANIFEST);
        if (R.is_err[str, str](mt_path_r)) { ret err_oom(); }
        val mt_path: str = R.unwrap_ok[str, str](mt_path_r);
        fin { str_free(a, mt_path); }
        val mt_r: R.Result[toml.Table, str] = parse_file(a, mt_path);
        if (R.is_err[toml.Table, str](mt_r)) { err_line(R.unwrap_err[toml.Table, str](mt_r)); ret 1; }
        parsed = R.unwrap_ok[toml.Table, str](mt_r);
        mt = ?parsed;
    }
    fin { if (candidate == nil) { toml.dnit(a, ?parsed); } }
    var complete: bool = false;
    fin { if (!complete) { report_dep_effects(reqs); } }

    var root_id: str = toml.get_str(mt, "project.id");
    if (str_empty(root_id)) { root_id = "(project)"; }

    val seed_r: R.Result[R.Void, str] = enqueue(a, reqs, root, mt, root_id, true);
    if (R.is_err[R.Void, str](seed_r)) { err_line(R.unwrap_err[R.Void, str](seed_r)); ret 1; }
    if (!quiet) { deps.print_stale_lock_note(a, root); }
    if (reqs.len == 0) {
        if (!quiet) { print.print("no dependencies\n"); }
        complete = true;
        ret report_strays(a, root, reqs, verify_only);
    }

    var i: usize = 0;
    for (i < reqs.len) {
        if (!verify_only) {
            val rc: i64 = ensure_realized(s, a, root, ?reqs.data[i], mode, quiet);
            if (rc != 0) { ret rc; }
        }
        val dep_full_r: R.Result[str, str] = deps.dep_full_of(a, root, reqs.data[i].id);
        if (R.is_err[str, str](dep_full_r)) { ret err_oom(); }
        val dep_full: str = R.unwrap_ok[str, str](dep_full_r);
        fin { str_free(a, dep_full); }
        if (!fs.is_dir(dep_full)) {
            print.eprint("error: dependency '");
            print.eprint(reqs.data[i].id);
            print.eprint("' is not realized at ");
            print.eprint(dep_full);
            print.eprint("\n");
            ret 1;
        }
        val sub_path_r: R.Result[str, str] = path.join(a, dep_full, MANIFEST);
        if (R.is_err[str, str](sub_path_r)) { ret err_oom(); }
        val sub_path: str = R.unwrap_ok[str, str](sub_path_r);
        fin { str_free(a, sub_path); }
        val sub_r: R.Result[toml.Table, str] = parse_file(a, sub_path);
        if (R.is_err[toml.Table, str](sub_r)) { err_line(R.unwrap_err[toml.Table, str](sub_r)); ret 1; }
        var sub: toml.Table = R.unwrap_ok[toml.Table, str](sub_r);
        fin { toml.dnit(a, ?sub); }

        val declared: str = toml.get_str(?sub, "project.id");
        val ident: R.Result[R.Void, str] = deps.check_dep_identity(s, reqs.data[i].id, declared, verify_only);
        if (R.is_err[R.Void, str](ident)) { err_line(R.unwrap_err[R.Void, str](ident)); ret 1; }

        val child_r: R.Result[R.Void, str] = enqueue(a, reqs, dep_full, ?sub, reqs.data[i].chain, false);
        if (R.is_err[R.Void, str](child_r)) { err_line(R.unwrap_err[R.Void, str](child_r)); ret 1; }
        i = i + 1;
    }
    val result: i64 = report_strays(a, root, reqs, verify_only);
    complete = result == 0;
    ret result;
}

fun report_strays(a: *A.Allocator, root: str, reqs: *Vector[DepReq], verify_only: bool) i64 {
    val ids_r: R.Result[Vector[str], str] = deps.realized_ids(a, root);
    if (R.is_err[Vector[str], str](ids_r)) { err_line(R.unwrap_err[Vector[str], str](ids_r)); ret 3; }
    var ids: Vector[str] = R.unwrap_ok[Vector[str], str](ids_r);
    var i: usize = 0;
    var rc: i64 = 0;
    for (i < ids.len) {
        if (req_index(reqs, ids.data[i]) < 0) {
            if (verify_only) {
                print.eprint("error: dep/");
                print.eprint(ids.data[i]);
                print.eprint(" is not in the dependency closure\n");
                rc = 1;
            }
            or {
                print.eprintlnf("note: dep/{} is outside the dependency closure; directory retained for explicit removal", ids.data[i]);
            }
        }
        i = i + 1;
    }
    ret rc;
}

fun ensure_realized(s: *session.Session, a: *A.Allocator, root: str, r: *DepReq,
                    mode: u8, quiet: bool) i64 {
    val dep_full_r: R.Result[str, str] = deps.dep_full_of(a, root, r.id);
    if (R.is_err[str, str](dep_full_r)) { ret err_oom(); }
    val dep_full: str = R.unwrap_ok[str, str](dep_full_r);
    fin { str_free(a, dep_full); }

    if (fs.is_symlink(dep_full)) { err_line("dependency checkout is a symlink; existing entry retained"); ret 1; }
    if (fs.exists(dep_full) && r.is_git && mode == deps.REALIZE_REPO_ROOT && !deps.own_work_tree(a, dep_full)) {
        val staged_r: R.Result[O.Option[str], str] = deps.staged_gitlink(s, root, r.id);
        if (R.is_err[O.Option[str], str](staged_r)) { err_line(R.unwrap_err[O.Option[str], str](staged_r)); ret 3; }
        val recorded: O.Option[str] = R.unwrap_ok[O.Option[str], str](staged_r);
        fin { if (O.is_some[str](recorded)) { str_free(a, O.unwrap[str](recorded)); } }
        if (O.is_some[str](recorded)) {
            val ir: R.Result[R.Void, str] = deps.initialize_git_submodule(s, root, r.id);
            if (R.is_err[R.Void, str](ir)) { err_line(R.unwrap_err[R.Void, str](ir)); ret 3; }
            r.effect = "initialized the recorded gitlink";
            if (!quiet) {
                print.print("realized ");
                print.print(r.id);
                print.print(" @ ");
                print.print(head_text(s, dep_full));
                print.print(" (initialized the committed gitlink)\n");
            }
            ret 0;
        }
        val entries_r: R.Result[Vector[str], str] = fs.read_dir(a, dep_full);
        if (R.is_err[Vector[str], str](entries_r)) { err_line(R.unwrap_err[Vector[str], str](entries_r)); ret 3; }
        var entries: Vector[str] = R.unwrap_ok[Vector[str], str](entries_r);
        fin {
            var i: usize = 0;
            for (i < entries.len) { str_free(a, entries.data[i]); i = i + 1; }
            vector.dnit[str](?entries);
        }
        if (entries.len != 0) {
            print.eprint("error: dep/");
            print.eprint(r.id);
            print.eprint(" exists but is neither a checkout of its own nor an empty gitlink placeholder; move it aside and run `mach dep pull` again\n");
            ret 1;
        }
        err_line("dependency directory exists without a recorded gitlink; existing directory retained");
        ret 1;
    }

    if (!fs.exists(dep_full)) {
        if (!r.is_git) {
            val pr: R.Result[R.Void, str] = deps.realize_path_dependency(s, root, r.id, r.src_path, mode);
            if (R.is_err[R.Void, str](pr)) { err_line(R.unwrap_err[R.Void, str](pr)); ret 1; }
            r.effect = "copied the local dependency source";
            if (!quiet) {
                print.print("realized ");
                print.print(r.id);
                print.print(" from ");
                print.print(r.src_path);
                print.print("\n");
            }
            ret 0;
        }
        val rr: R.Result[R.Void, str] = deps.realize_git_dependency(s, root, r.id, r.url, r.ref, mode);
        if (R.is_err[R.Void, str](rr)) {
            err_line(R.unwrap_err[R.Void, str](rr));
            ret 3;
        }
        r.effect = "realized the Git dependency";
        if (!quiet) {
            print.print("realized ");
            print.print(r.id);
            print.print(" @ ");
            print.print(head_text(s, dep_full));
            print.print("\n");
        }
        ret 0;
    }

    if (!r.is_git || mode != deps.REALIZE_REPO_ROOT) { ret 0; }

    val staged_r: R.Result[O.Option[str], str] = deps.staged_gitlink(s, root, r.id);
    if (R.is_err[O.Option[str], str](staged_r)) { err_line(R.unwrap_err[O.Option[str], str](staged_r)); ret 3; }
    val staged_o: O.Option[str] = R.unwrap_ok[O.Option[str], str](staged_r);
    if (O.is_none[str](staged_o)) { ret 0; }
    val staged: str = O.unwrap[str](staged_o);
    fin { str_free(a, staged); }
    val head_r: R.Result[str, str] = deps.checkout_head(s, dep_full);
    if (R.is_err[str, str](head_r)) { err_line(R.unwrap_err[str, str](head_r)); ret 3; }
    val head: str = R.unwrap_ok[str, str](head_r);
    fin { str_free(a, head); }
    if (str_equals(head, staged)) { ret 0; }
    val co: R.Result[R.Void, str] = deps.checkout_commit(s, dep_full, staged);
    if (R.is_err[R.Void, str](co)) { err_line(R.unwrap_err[R.Void, str](co)); ret 3; }
    r.effect = "checked out the recorded pin";
    if (!quiet) {
        print.print("restored ");
        print.print(r.id);
        print.print(" to the recorded pin ");
        print.print(staged);
        print.print("\n");
    }
    ret 0;
}

fun head_text(s: *session.Session, dep_full: str) str {
    val r: R.Result[str, str] = deps.checkout_head(s, dep_full);
    if (R.is_err[str, str](r)) { ret "(unknown)"; }
    ret R.unwrap_ok[str, str](r);
}

fun req_index(reqs: *Vector[DepReq], id: str) i64 {
    var i: usize = 0;
    for (i < reqs.len) {
        if (str_equals(reqs.data[i].id, id)) { ret i::i64; }
        i = i + 1;
    }
    ret -1;
}

fun free_request(a: *A.Allocator, request: *DepReq) {
    str_free(a, request.id);
    str_free(a, request.url);
    str_free(a, request.src_path);
    str_free(a, request.ref);
    str_free(a, request.chain);
}

fun free_requests(a: *A.Allocator, requests: *Vector[DepReq]) {
    var i: usize = 0;
    for (i < requests.len) { free_request(a, ?requests.data[i]); i = i + 1; }
    vector.dnit[DepReq](requests);
}

fun enqueue(a: *A.Allocator, reqs: *Vector[DepReq], manifest_dir: str, mt: *toml.Table,
            chain: str, root_decl: bool) R.Result[R.Void, str] {
    val deps_t: *toml.Table = toml.get_table(mt, "dep");
    if (deps_t == nil) { ret R.ok_void[str](); }
    val n: usize = toml.table_len(deps_t);
    var i: usize = 0;
    for (i < n) {
        val key:   str         = toml.table_key(deps_t, i);
        val value: *toml.Value = toml.table_value(deps_t, i);
        i = i + 1;
        if (value == nil || value.tag != toml.TYPE_TABLE) {
            ret R.err[R.Void, str](concat3(a, "[dep.", key, "] is not a table"));
        }
        if (!manifest.is_valid_id(key)) {
            ret R.err[R.Void, str](concat3(a, "dependency name '", key, "' must be a portable identifier (letters, digits, '_', '-')"));
        }
        val git_src:  str  = toml.get_str(?value.data.table, "git");
        val path_src: str  = toml.get_str(?value.data.table, "path");
        val has_git:  bool = !str_empty(git_src);
        val has_path: bool = !str_empty(path_src);
        if (has_git == has_path) {
            ret R.err[R.Void, str](concat3(a, "[dep.", key, "] needs exactly one source key: 'git' or 'path'"));
        }

        var r: DepReq;
        var retained: bool = false;
        fin { if (!retained) { free_request(a, ?r); } }
        r.id        = own(a, key);
        if (r.id == nil) { ret R.err[R.Void, str]("out of memory"); }
        r.root_decl = root_decl;
        r.is_git    = has_git;
        if (has_git) {
            r.url = own(a, git_src);
            r.ref = own(a, toml.get_str(?value.data.table, "ref"));
            if (r.url == nil || r.ref == nil) { ret R.err[R.Void, str]("out of memory"); }
        }
        or {
            if (path.is_abs(path_src)) {
                r.src_path = own(a, path_src);
                if (r.src_path == nil) { ret R.err[R.Void, str]("out of memory"); }
            }
            or {
                val joined: R.Result[str, str] = path.join(a, manifest_dir, path_src);
                if (R.is_err[str, str](joined)) { ret R.err[R.Void, str]("out of memory"); }
                r.src_path = R.unwrap_ok[str, str](joined);
            }
        }
        val chain_r: R.Result[str, str] = format.sprint(a, "{} -> {}", chain, key);
        if (R.is_err[str, str](chain_r)) { ret R.err[R.Void, str]("out of memory"); }
        r.chain = R.unwrap_ok[str, str](chain_r);

        val existing: i64 = req_index(reqs, r.id);
        if (existing >= 0) {
            val e: *DepReq = ?reqs.data[existing::usize];
            if (e.root_decl) { cnt; }
            if (selection_agrees(e, ?r)) { cnt; }
            ret R.err[R.Void, str](conflict_text(a, ?r, e, ?r));
        }
        val pushed: R.Result[usize, str] = vector.push[DepReq](reqs, r);
        if (R.is_err[usize, str](pushed)) { ret R.err[R.Void, str]("out of memory"); }
        retained = true;
    }
    ret R.ok_void[str]();
}

fun selection_agrees(x: *DepReq, y: *DepReq) bool {
    if (x.is_git != y.is_git) { ret false; }
    if (x.is_git) { ret str_equals(x.url, y.url) && str_equals(x.ref, y.ref); }
    ret str_equals(x.src_path, y.src_path);
}

fun selection_text(a: *A.Allocator, r: *DepReq) str {
    if (r.is_git) {
        val t: R.Result[str, str] = format.sprint(a, "git {} @ {}", r.url, r.ref);
        if (R.is_err[str, str](t)) { ret r.url; }
        ret R.unwrap_ok[str, str](t);
    }
    val t2: R.Result[str, str] = format.sprint(a, "path {}", r.src_path);
    if (R.is_err[str, str](t2)) { ret r.src_path; }
    ret R.unwrap_ok[str, str](t2);
}

fun conflict_text(a: *A.Allocator, subject: *DepReq, x: *DepReq, y: *DepReq) str {
    var decl: str = "";
    if (subject.is_git) {
        val d: R.Result[str, str] = format.sprint(a,
            "[dep.{}]\n    git = \"{}\"\n    ref = \"{}\"", subject.id, subject.url, subject.ref);
        if (R.is_ok[str, str](d)) { decl = R.unwrap_ok[str, str](d); }
    }
    or {
        val d: R.Result[str, str] = format.sprint(a,
            "[dep.{}]\n    path = \"{}\"", subject.id, subject.src_path);
        if (R.is_ok[str, str](d)) { decl = R.unwrap_ok[str, str](d); }
    }
    val msg: R.Result[str, str] = format.sprint(a,
        "dependency conflict: project id '{}' is reached with two different selections:\n    {} requires {}\n    {} requires {}\n  the root decides by declaring the identity itself, for example:\n    {}",
        subject.id, x.chain, selection_text(a, x), y.chain, selection_text(a, y), decl);
    if (R.is_err[str, str](msg)) { ret "dependency conflict: one project id resolves to two different selections"; }
    ret R.unwrap_ok[str, str](msg);
}

fun dep_update(argc: usize, argv: **u8) i64 {
    val all: bool = util.flag_exists(argc, argv, "--all");
    var name: *u8 = nil;
    var i: usize = 3;
    for (i < argc) {
        if (argv[i][0] != '-'::u8) { name = argv[i]; i = argc; }
        or                        { i = i + 1; }
    }
    if (!all && name == nil) { err_line("usage: mach dep update <name> | --all"); ret 1; }
    if (all && name != nil)  { err_line("give a name or --all, not both"); ret 1; }
    if (name != nil && !manifest.is_valid_id(name::str)) {
        err_line("dependency name must be a portable identifier (letters, digits, '_', '-')");
        ret 1;
    }
    val quiet: bool = arg_quiet(argc, argv);

    var a: A.Allocator;
    if (O.is_some[str](page.make(?a))) { err_line("failed to initialise allocator"); ret 2; }
    val loc_r: R.Result[util.ProjectLocation, str] = util.resolve_project_location(?a, ".");
    if (R.is_err[util.ProjectLocation, str](loc_r)) { err_line(R.unwrap_err[util.ProjectLocation, str](loc_r)); ret 1; }
    val root: str = R.unwrap_ok[util.ProjectLocation, str](loc_r).root;

    val sr: R.Result[session.Session, str] = session.init(?a);
    if (R.is_err[session.Session, str](sr)) { err_line("failed to initialise a session"); ret 2; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    val mode_r: R.Result[u8, str] = deps.realization_mode(?s, root);
    if (R.is_err[u8, str](mode_r)) { err_line(R.unwrap_err[u8, str](mode_r)); session.dnit(?s); ret 1; }
    val mode: u8 = R.unwrap_ok[u8, str](mode_r);

    var edit: ManifestEdit;
    val txn_r: R.Result[R.Void, str] = edit_begin(?edit, ?a, root);
    if (R.is_err[R.Void, str](txn_r)) { err_line(R.unwrap_err[R.Void, str](txn_r)); val failed: i64 = edit_finish(?edit, 1); session.dnit(?s); ret failed; }


    val rc: i64 = update_apply(?s, ?a, root, mode, all, name, quiet, 0);
    val finished: i64 = edit_finish(?edit, rc);
    session.dnit(?s);
    ret finished;
}

rec ManifestEdit {
    root: txn.Root;
    guard: txn.Lock;
    destination: txn.Claim;
}

fun edit_begin(edit: *ManifestEdit, a: *A.Allocator, root: str) R.Result[R.Void, str] {
    val opened: O.Option[txn.Error] = txn.root_open(?edit.root, root, "");
    if (O.is_some[txn.Error](opened)) { ret R.err[R.Void, str](txn.error_message(O.unwrap[txn.Error](opened))); }
    val locked: O.Option[txn.Error] = txn.lock(?edit.guard, ?edit.root);
    if (O.is_some[txn.Error](locked)) { ret R.err[R.Void, str](txn.error_message(O.unwrap[txn.Error](locked))); }
    val recovered: R.Result[usize, txn.Error] = txn.recover(a, ?edit.guard, "");
    if (R.is_err[usize, txn.Error](recovered)) { ret R.err[R.Void, str](txn.error_message(R.unwrap_err[usize, txn.Error](recovered))); }
    val reserved: O.Option[txn.Error] = txn.claim(?edit.destination, a, ?edit.guard, MANIFEST);
    if (O.is_some[txn.Error](reserved)) { ret R.err[R.Void, str](txn.error_message(O.unwrap[txn.Error](reserved))); }
    val observed: R.Result[txn.EntryProbe, txn.Error] = txn.entry_probe(?edit.root, "dep");
    if (R.is_err[txn.EntryProbe, txn.Error](observed)) { ret R.err[R.Void, str](txn.error_message(R.unwrap_err[txn.EntryProbe, txn.Error](observed))); }
    val dependency_root: txn.EntryProbe = R.unwrap_ok[txn.EntryProbe, txn.Error](observed);
    if (dependency_root.present && !dependency_root.is_directory) { ret R.err[R.Void, str]("dependency root must be a physical directory; existing entry retained"); }
    ret R.ok_void[str]();
}

fun edit_finish(edit: *ManifestEdit, code: i64) i64 {
    var errors: [3]O.Option[txn.Error];
    errors[0] = txn.release_claim(?edit.destination);
    errors[1] = txn.unlock(?edit.guard);
    errors[2] = txn.root_dnit(?edit.root);
    var result: i64 = code;
    var i: usize = 0;
    for (i < 3) {
        if (O.is_some[txn.Error](errors[i])) {
            err_line(txn.error_message(O.unwrap[txn.Error](errors[i])));
            if (result == 0) { result = 3; }
        }
        i = i + 1;
    }
    ret result;
}

fun report_dep_effects(reqs: *Vector[DepReq]) {
    var i: usize = 0;
    for (i < reqs.len) {
        if (!str_empty(reqs.data[i].effect)) {
            print.eprintlnf("note: dep/{}: {} before this failure; state retained", reqs.data[i].id, reqs.data[i].effect);
        }
        i = i + 1;
    }
}

fun update_apply(s: *session.Session, a: *A.Allocator, root: str, mode: u8, all: bool,
                 name: *u8, quiet: bool, fail_after: i32) i64 {
    val mt_path_r: R.Result[str, str] = path.join(a, root, MANIFEST);
    if (R.is_err[str, str](mt_path_r)) { ret err_oom(); }
    val mt_r: R.Result[toml.Table, str] = parse_file(a, R.unwrap_ok[str, str](mt_path_r));
    if (R.is_err[toml.Table, str](mt_r)) { err_line(R.unwrap_err[toml.Table, str](mt_r)); ret 1; }
    var mt: toml.Table = R.unwrap_ok[toml.Table, str](mt_r);

    var reqs: Vector[DepReq] = vector.init[DepReq](a);
    fin { free_requests(a, ?reqs); }
    var root_id: str = toml.get_str(?mt, "project.id");
    if (str_empty(root_id)) { root_id = "(project)"; }
    val seed_r: R.Result[R.Void, str] = enqueue(a, ?reqs, root, ?mt, root_id, true);
    if (R.is_err[R.Void, str](seed_r)) { err_line(R.unwrap_err[R.Void, str](seed_r)); ret 1; }

    var known: Vector[DepReq] = vector.init[DepReq](a);
    fin { free_requests(a, ?known); }
    val preflight: R.Result[R.Void, str] = preflight_closure(s, a, root, ?mt, ?known, false);
    if (R.is_err[R.Void, str](preflight)) { err_line(R.unwrap_err[R.Void, str](preflight)); ret 1; }
    var complete: bool = false;
    fin { if (!complete) { report_dep_effects(?reqs); } }

    var matched: bool = false;
    var i: usize = 0;
    for (i < reqs.len) {
        val r: *DepReq = ?reqs.data[i];
        i = i + 1;
        if (!all && (name == nil || !str_equals(r.id, name::str))) { cnt; }
        matched = true;

        val dep_full_r: R.Result[str, str] = deps.dep_full_of(a, root, r.id);
        if (R.is_err[str, str](dep_full_r)) { ret err_oom(); }
        val dep_full: str = R.unwrap_ok[str, str](dep_full_r);

        if (!r.is_git) {
            val pr: R.Result[R.Void, str] = deps.realize_path_dependency(s, root, r.id, r.src_path, mode);
            if (R.is_err[R.Void, str](pr)) { err_line(R.unwrap_err[R.Void, str](pr)); ret 1; }
            r.effect = "copied the local source";
            if (!quiet) { print.print(r.id); print.print(": copied from "); print.print(r.src_path); print.print("\n"); }
            cnt;
        }

        if (!fs.exists(dep_full)) {
            val rr: R.Result[R.Void, str] = deps.realize_git_dependency(s, root, r.id, r.url, r.ref, mode);
            if (R.is_err[R.Void, str](rr)) { err_line(R.unwrap_err[R.Void, str](rr)); ret 3; }
            r.effect = "realized the Git dependency";
            if (!quiet) { print.print(r.id); print.print(": realized @ "); print.print(head_text(s, dep_full)); print.print("\n"); }
            cnt;
        }

        val old: str = head_text(s, dep_full);
        val exact: bool = !ref_advanceable(r.ref);
        val fr: R.Result[R.Void, str] = deps.fetch_and_checkout(s, dep_full, r.ref);
        if (R.is_err[R.Void, str](fr)) { err_line(R.unwrap_err[R.Void, str](fr)); ret 3; }
        r.effect = "fetched and checked out the requested selector";
        if (fail_after == 1) { err_line("injected dependency checkout failure"); ret 1; }
        if (mode == deps.REALIZE_REPO_ROOT) {
            val st: R.Result[R.Void, str] = deps.stage_dependency(s, root, r.id);
            if (R.is_err[R.Void, str](st)) { err_line(R.unwrap_err[R.Void, str](st)); ret 2; }
        }
        if (mode == deps.REALIZE_REPO_ROOT) { r.effect = "checked out and staged the requested selector"; }
        if (fail_after == 2) { err_line("injected dependency staging failure"); ret 1; }
        val fresh: str = head_text(s, dep_full);
        if (!quiet) {
            print.print(r.id); print.print(": ");
            if (exact && str_equals(old, fresh)) { print.print(old); print.print(" (exact selector, already pinned)\n"); }
            or {
                print.print(old); print.print(" -> "); print.print(fresh);
                if (exact) { print.print(" (pinned to the exact selector)\n"); } or { print.print("\n"); }
            }
        }
    }

    if (!all && !matched) {
        print.eprint("error: no dependency '");
        print.eprint(name::str);
        print.eprint("' in the manifest\n");
        ret 1;
    }

    var closure: Vector[DepReq] = vector.init[DepReq](a);
    fin { free_requests(a, ?closure); }
    val rc: i64 = realize_closure(s, a, root, ?closure, quiet, false, nil);
    if (rc != 0) { ret rc; }
    if (fail_after == 3) { err_line("injected dependency closure failure"); ret 1; }
    complete = true;
    ret 0;
}

fun ref_advanceable(ref: str) bool {
    if (str_empty(ref))                  { ret true; }
    if (str_starts_with(ref, "branch/")) { ret true; }
    if (str_starts_with(ref, "tag/"))    { ret false; }
    if (str_starts_with(ref, "commit/")) { ret false; }
    ret true;
}

fun dep_add_source_valid(has_git: bool, has_path: bool, has_ref: bool) bool {
    ret has_git != has_path && (!has_ref || has_git);
}

fun dep_add(argc: usize, argv: **u8) i64 {
    if (argc < 4 || argv[3][0] == '-'::u8) {
        err_line("usage: mach dep add <name> --git <url> [--ref <r>] | --path <dir>");
        ret 1;
    }
    val name:     *u8           = argv[3];
    val opt_git:  O.Option[*u8] = util.flag_value(argc, argv, "--git");
    val opt_path: O.Option[*u8] = util.flag_value(argc, argv, "--path");
    val opt_ref:  O.Option[*u8] = util.flag_value(argc, argv, "--ref");
    val has_git:  bool = O.is_some[*u8](opt_git);
    val has_path: bool = O.is_some[*u8](opt_path);
    val has_ref:  bool = O.is_some[*u8](opt_ref);
    if (!dep_add_source_valid(has_git, has_path, has_ref)) {
        if (has_path && has_ref && !has_git) { err_line("--ref applies only to --git dependencies"); ret 1; }
        err_line("give exactly one source: --git <url> or --path <dir>");
        ret 1;
    }
    if (!manifest.is_valid_id(name::str)) {
        err_line("dependency name must be a portable identifier (letters, digits, '_', '-')");
        ret 1;
    }
    val quiet: bool = arg_quiet(argc, argv);

    var spec: manifest.DepTableSpec;
    spec.name = name::str;
    if (has_git) {
        spec.source = manifest.DEP_SOURCE_GIT;
        spec.value  = opt_value(opt_git)::str;
        spec.ref    = opt_value(opt_ref)::str;
    }
    or {
        spec.source = manifest.DEP_SOURCE_PATH;
        spec.value  = opt_value(opt_path)::str;
        spec.ref    = "";
    }
    ret mutate_manifest(?spec, name::str, true, false, quiet, 0);
}

fun dep_remove(argc: usize, argv: **u8) i64 {
    if (argc < 4) { err_line("usage: mach dep remove <name> [--purge]"); ret 1; }
    val name:  *u8  = argv[3];
    val purge: bool = util.flag_exists(argc, argv, "--purge");
    val quiet: bool = arg_quiet(argc, argv);
    if (!manifest.is_valid_id(name::str)) {
        err_line("dependency name must be a portable identifier (letters, digits, '_', '-')");
        ret 1;
    }
    var spec: manifest.DepTableSpec;
    spec.name   = name::str;
    spec.source = manifest.DEP_SOURCE_PATH;
    spec.value  = "";
    spec.ref    = "";
    ret mutate_manifest(?spec, name::str, false, purge, quiet, 0);
}

fun mutate_manifest(spec: *manifest.DepTableSpec, name: str, adding: bool, purge: bool,
                    quiet: bool, fail_after: i32) i64 {
    var a: A.Allocator;
    if (O.is_some[str](page.make(?a))) { err_line("failed to initialise allocator"); ret 2; }
    val loc_r: R.Result[util.ProjectLocation, str] = util.resolve_project_location(?a, ".");
    if (R.is_err[util.ProjectLocation, str](loc_r)) { err_line(R.unwrap_err[util.ProjectLocation, str](loc_r)); ret 1; }
    val root: str = R.unwrap_ok[util.ProjectLocation, str](loc_r).root;

    val sr: R.Result[session.Session, str] = session.init(?a);
    if (R.is_err[session.Session, str](sr)) { err_line("failed to initialise a session"); ret 2; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    val mode_r: R.Result[u8, str] = deps.realization_mode(?s, root);
    if (R.is_err[u8, str](mode_r)) { err_line(R.unwrap_err[u8, str](mode_r)); session.dnit(?s); ret 1; }
    val mode: u8 = R.unwrap_ok[u8, str](mode_r);

    var edit: ManifestEdit;
    val txn_r: R.Result[R.Void, str] = edit_begin(?edit, ?a, root);
    if (R.is_err[R.Void, str](txn_r)) { err_line(R.unwrap_err[R.Void, str](txn_r)); val failed: i64 = edit_finish(?edit, 1); session.dnit(?s); ret failed; }


    val rc: i64 = mutate_apply(?edit, ?s, ?a, root, mode, spec, name, adding, purge, quiet, fail_after);
    val finished: i64 = edit_finish(?edit, rc);
    session.dnit(?s);
    ret finished;
}

fun preflight_closure(s: *session.Session, a: *A.Allocator, root: str, table: *toml.Table,
                      reqs: *Vector[DepReq], inspect_git: bool) R.Result[R.Void, str] {
    val checked: R.Result[manifest.Manifest, str] = manifest.parse(a, ?s.interner, table, false);
    if (R.is_err[manifest.Manifest, str](checked)) { ret R.err[R.Void, str](R.unwrap_err[manifest.Manifest, str](checked)); }
    var parsed: manifest.Manifest = R.unwrap_ok[manifest.Manifest, str](checked);
    manifest.dnit(?parsed, a);
    var root_id: str = toml.get_str(table, "project.id");
    if (str_empty(root_id)) { root_id = "(project)"; }
    val seeded: R.Result[R.Void, str] = enqueue(a, reqs, root, table, root_id, true);
    if (R.is_err[R.Void, str](seeded)) { ret seeded; }
    var i: usize = 0;
    for (i < reqs.len) {
        val request: DepReq = reqs.data[i];
        i = i + 1;
        var source: str = request.src_path;
        if (request.is_git) {
            if (!inspect_git) { cnt; }
            val joined: R.Result[str, str] = deps.dep_full_of(a, root, request.id);
            if (R.is_err[str, str](joined)) { ret R.err[R.Void, str](R.unwrap_err[str, str](joined)); }
            source = R.unwrap_ok[str, str](joined);
            if (!deps.own_work_tree(a, source)) { str_free(a, source); cnt; }
        }
        fin { if (request.is_git) { str_free(a, source); } }
        val file_r: R.Result[str, str] = path.join(a, source, MANIFEST);
        if (R.is_err[str, str](file_r)) { ret R.err[R.Void, str](R.unwrap_err[str, str](file_r)); }
        val file: str = R.unwrap_ok[str, str](file_r);
        fin { str_free(a, file); }
        val read: R.Result[toml.Table, str] = parse_file(a, file);
        if (R.is_err[toml.Table, str](read)) { ret R.err[R.Void, str](R.unwrap_err[toml.Table, str](read)); }
        var dependency: toml.Table = R.unwrap_ok[toml.Table, str](read);
        fin { toml.dnit(a, ?dependency); }
        val identity: R.Result[R.Void, str] = deps.check_dep_identity(s, request.id, toml.get_str(?dependency, "project.id"), true);
        if (R.is_err[R.Void, str](identity)) { ret identity; }
        val more: R.Result[R.Void, str] = enqueue(a, reqs, source, ?dependency, request.chain, false);
        if (R.is_err[R.Void, str](more)) { ret more; }
    }
    ret R.ok_void[str]();
}

fun mutate_apply(edit: *ManifestEdit, s: *session.Session, a: *A.Allocator, root: str, mode: u8,
                 spec: *manifest.DepTableSpec, name: str, adding: bool, purge: bool,
                 quiet: bool, fail_after: i32) i64 {
    val mt_path_r: R.Result[str, str] = path.join(a, root, MANIFEST);
    if (R.is_err[str, str](mt_path_r)) { ret err_oom(); }
    val mt_path: str = R.unwrap_ok[str, str](mt_path_r);
    fin { str_free(a, mt_path); }

    val source_r: R.Result[str, str] = fs.read_string(a, mt_path);
    if (R.is_err[str, str](source_r)) { err_line(R.unwrap_err[str, str](source_r)); ret 1; }
    val source: str = R.unwrap_ok[str, str](source_r);
    fin { str_free(a, source); }

    var candidate_r: R.Result[str, str];
    if (adding) { candidate_r = manifest.manifest_add_dep_table(a, source, spec); }
    or          { candidate_r = manifest.manifest_remove_dep_table(a, source, name); }
    if (R.is_err[str, str](candidate_r)) { err_line(R.unwrap_err[str, str](candidate_r)); ret 1; }
    val candidate: str = R.unwrap_ok[str, str](candidate_r);
    fin { str_free(a, candidate); }

    val table_r: R.Result[toml.Table, str] = toml.parse(a, candidate);
    if (R.is_err[toml.Table, str](table_r)) { err_line(R.unwrap_err[toml.Table, str](table_r)); ret 1; }
    var table: toml.Table = R.unwrap_ok[toml.Table, str](table_r);
    fin { toml.dnit(a, ?table); }
    var known: Vector[DepReq] = vector.init[DepReq](a);
    fin { free_requests(a, ?known); }
    val preflight: R.Result[R.Void, str] = preflight_closure(s, a, root, ?table, ?known, true);
    if (R.is_err[R.Void, str](preflight)) { err_line(R.unwrap_err[R.Void, str](preflight)); ret 1; }
    val still_required: bool = !adding && req_index(?known, name) >= 0;
    if (still_required && purge) { err_line("dependency is still required by the closure; cannot purge its checkout"); ret 1; }
    var removing_git: bool = false;
    if (!adding) {
        val original_r: R.Result[toml.Table, str] = toml.parse(a, source);
        if (R.is_err[toml.Table, str](original_r)) { err_line(R.unwrap_err[toml.Table, str](original_r)); ret 1; }
        var original: toml.Table = R.unwrap_ok[toml.Table, str](original_r);
        val declarations: *toml.Table = toml.get_table(?original, "dep");
        val declaration: *toml.Table = toml.get_table(declarations, name);
        removing_git = !str_empty(toml.get_str(declaration, "git"));
        toml.dnit(a, ?original);
    }
    if (adding) {
        val destination_r: R.Result[str, str] = deps.dep_full_of(a, root, name);
        if (R.is_err[str, str](destination_r)) { ret err_oom(); }
        val destination: str = R.unwrap_ok[str, str](destination_r);
        fin { str_free(a, destination); }
        if (fs.exists(destination) || fs.is_symlink(destination)) {
            err_line("dependency destination already exists; existing checkout retained"); ret 1;
        }
    }
    if (fail_after == 1) { err_line("injected dependency preflight failure"); ret 1; }
    var completed: str = nil;
    var success: bool = false;
    fin {
        if (!success && completed != nil) {
            print.eprintlnf("note: dep/{}: {} before this failure; inspect Git and mach.toml before retrying", name, completed);
        }
    }

    if (!adding) {
        if (!still_required && removing_git) {
            val ur: R.Result[R.Void, str] = deps.remove_dependency_index(s, root, name, mode);
            if (R.is_err[R.Void, str](ur)) { err_line(R.unwrap_err[R.Void, str](ur)); ret 3; }
            if (mode == deps.REALIZE_REPO_ROOT) { completed = "removed the dependency registration; checkout retained"; }
        }
        if (purge) {
            var destination: txn.Claim;
            val reserved: O.Option[txn.Error] = txn.claim(?destination, a, ?edit.guard, "dep");
            if (O.is_some[txn.Error](reserved)) { err_line(txn.error_message(O.unwrap[txn.Error](reserved))); ret 3; }
            val removed: R.Result[usize, txn.Error] = txn.root_remove_tree(?destination, name);
            val released: O.Option[txn.Error] = txn.release_claim(?destination);
            if (R.is_err[usize, txn.Error](removed)) {
                err_line(txn.error_message(R.unwrap_err[usize, txn.Error](removed)));
                if (O.is_some[txn.Error](released)) { err_line(txn.error_message(O.unwrap[txn.Error](released))); }
                ret 3;
            }
            completed = "removed the dependency registration and purged its checkout";
            if (O.is_some[txn.Error](released)) { err_line(txn.error_message(O.unwrap[txn.Error](released))); ret 3; }
        }
    }
    or (spec.source == manifest.DEP_SOURCE_PATH) {
        var src: str = spec.value;
        if (!path.is_abs(src)) {
            val j: R.Result[str, str] = path.join(a, root, spec.value);
            if (R.is_err[str, str](j)) { ret err_oom(); }
            src = R.unwrap_ok[str, str](j);
        }
        val pr: R.Result[R.Void, str] = deps.realize_path_dependency(s, root, name, src, mode);
        if (R.is_err[R.Void, str](pr)) { err_line(R.unwrap_err[R.Void, str](pr)); ret 1; }
        completed = "copied the local source";
    }
    or {
        val rr: R.Result[R.Void, str] = deps.realize_git_dependency(s, root, name, spec.value, spec.ref, mode);
        if (R.is_err[R.Void, str](rr)) { err_line(R.unwrap_err[R.Void, str](rr)); ret 3; }
        completed = "realized the Git dependency";
        if (mode == deps.REALIZE_REPO_ROOT) { completed = "realized and staged the Git dependency"; }
    }
    if (fail_after == 2) { err_line("injected dependency realization failure"); ret 1; }

    var closure: Vector[DepReq] = vector.init[DepReq](a);
    fin { free_requests(a, ?closure); }
    val rc: i64 = realize_closure(s, a, root, ?closure, quiet, false, ?table);
    if (rc != 0) { ret rc; }
    if (fail_after == 3) { err_line("injected dependency publication failure"); report_dep_effects(?closure); ret 1; }
    val w: R.Result[R.Void, str] = publication.bytes_at(nil, a, ?edit.destination, mt_path, candidate::*u8, str_len(candidate), 0o644, publication.REPLACE,
        "dep: cannot publish the project manifest", "dep: could not publish the project manifest", nil);
    if (R.is_err[R.Void, str](w)) {
        err_line(R.unwrap_err[R.Void, str](w));
        err_line("inspect mach.toml: publication can report an error after replacing the file");
        report_dep_effects(?closure);
        ret 3;
    }
    success = true;

    if (!quiet) {
        if (adding) { print.print("added [dep."); }
        or          { print.print("removed [dep."); }
        print.print(name);
        print.print("]\n");
    }
    ret 0;
}

fun dep_list() i64 {
    var a: A.Allocator;
    if (O.is_some[str](page.make(?a))) { err_line("failed to initialise allocator"); ret 2; }
    val loc_r: R.Result[util.ProjectLocation, str] = util.resolve_project_location(?a, ".");
    if (R.is_err[util.ProjectLocation, str](loc_r)) { err_line(R.unwrap_err[util.ProjectLocation, str](loc_r)); ret 1; }
    val root: str = R.unwrap_ok[util.ProjectLocation, str](loc_r).root;

    val mt_path_r: R.Result[str, str] = path.join(?a, root, MANIFEST);
    if (R.is_err[str, str](mt_path_r)) { ret err_oom(); }
    val mt_r: R.Result[toml.Table, str] = parse_file(?a, R.unwrap_ok[str, str](mt_path_r));
    if (R.is_err[toml.Table, str](mt_r)) { err_line(R.unwrap_err[toml.Table, str](mt_r)); ret 1; }
    var mt: toml.Table = R.unwrap_ok[toml.Table, str](mt_r);

    val deps_t: *toml.Table = toml.get_table(?mt, "dep");
    if (deps_t == nil || toml.table_len(deps_t) == 0) { print.print("no dependencies\n"); ret 0; }

    val sr: R.Result[session.Session, str] = session.init(?a);
    if (R.is_err[session.Session, str](sr)) { err_line("failed to initialise a session"); ret 2; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    val n: usize = toml.table_len(deps_t);
    var i: usize = 0;
    for (i < n) {
        val key:   str         = toml.table_key(deps_t, i);
        val value: *toml.Value = toml.table_value(deps_t, i);
        i = i + 1;
        print.print("  ");
        print.print(key);
        if (value == nil || value.tag != toml.TYPE_TABLE) { print.print("  (invalid)\n"); cnt; }
        val git_src:  str = toml.get_str(?value.data.table, "git");
        val path_src: str = toml.get_str(?value.data.table, "path");
        val full_r: R.Result[str, str] = deps.dep_full_of(?a, root, key);
        var state: str = "missing";
        if (R.is_ok[str, str](full_r)) {
            val full: str = R.unwrap_ok[str, str](full_r);
            if (fs.is_dir(full)) { state = "realized"; }
        }
        if (!str_empty(git_src)) {
            print.print("  git=");
            print.print(git_src);
            val ref: str = toml.get_str(?value.data.table, "ref");
            if (!str_empty(ref)) { print.print("  ref="); print.print(ref); }
            val staged_r: R.Result[O.Option[str], str] = deps.staged_gitlink(?s, root, key);
            if (R.is_ok[O.Option[str], str](staged_r)) {
                val staged_o: O.Option[str] = R.unwrap_ok[O.Option[str], str](staged_r);
                if (O.is_some[str](staged_o)) { print.print("  pin="); print.print(O.unwrap[str](staged_o)); }
            }
        }
        or {
            print.print("  path=");
            print.print(path_src);
        }
        print.print("  ");
        print.print(state);
        print.print("\n");
    }
    session.dnit(?s);
    ret 0;
}

fun err_line(msg: str) {
    print.eprint("error: ");
    print.eprint(msg);
    print.eprint("\n");
}

fun err_oom() i64 {
    err_line("out of memory");
    ret 2;
}

fun dep_root_for(out: *txn.Root, root: str) R.Result[bool, str] {
    val r: O.Option[txn.Error] = txn.root_open(out, root, "dep");
    if (O.is_none[txn.Error](r)) { ret R.ok[bool, str](true); }
    val e: txn.Error = O.unwrap[txn.Error](r);
    if (e.kind == txn.CONTAINMENT) {
        ret R.err[bool, str]("dependency root 'dep' escapes the project root or is reached through a symlink");
    }
    if (e.kind == txn.IO && e.code == os.ENOENT) { ret R.ok[bool, str](false); }
    ret R.err[bool, str](txn.error_message(e));
}

fun purge_dependency_dir(a: *A.Allocator, root: str, name: str) R.Result[usize, str] {
    if (!manifest.is_project_path(name)) { ret R.err[usize, str]("dependency removal requires a canonical path beneath dep"); }
    var dr: txn.Root;
    val guard_r: O.Option[txn.Error] = txn.root_open(?dr, root, "");
    if (O.is_some[txn.Error](guard_r)) { ret R.err[usize, str](txn.error_message(O.unwrap[txn.Error](guard_r))); }
    var held: txn.Lock;
    var destination: txn.Claim;
    val removed: R.Result[usize, str] = purge_claimed(a, ?dr, ?held, ?destination, name);
    val released: O.Option[txn.Error] = txn.release_claim(?destination);
    val unlocked: O.Option[txn.Error] = txn.unlock(?held);
    val closed: O.Option[txn.Error] = txn.root_dnit(?dr);
    if (R.is_err[usize, str](removed)) { ret removed; }
    if (O.is_some[txn.Error](released)) { ret R.err[usize, str](txn.error_message(O.unwrap[txn.Error](released))); }
    if (O.is_some[txn.Error](unlocked)) { ret R.err[usize, str](txn.error_message(O.unwrap[txn.Error](unlocked))); }
    if (O.is_some[txn.Error](closed)) { ret R.err[usize, str](txn.error_message(O.unwrap[txn.Error](closed))); }
    ret removed;
}

fun purge_claimed(a: *A.Allocator, root: *txn.Root, held: *txn.Lock, destination: *txn.Claim, name: str) R.Result[usize, str] {
    val observed: R.Result[txn.EntryProbe, txn.Error] = txn.entry_probe(root, "dep");
    if (R.is_err[txn.EntryProbe, txn.Error](observed)) { ret R.err[usize, str](txn.error_message(R.unwrap_err[txn.EntryProbe, txn.Error](observed))); }
    val dep: txn.EntryProbe = R.unwrap_ok[txn.EntryProbe, txn.Error](observed);
    if (!dep.present) { ret R.ok[usize, str](0); }
    if (!dep.is_directory) { ret R.err[usize, str]("dependency root 'dep' escapes the project root or is reached through a symlink"); }
    val locked: O.Option[txn.Error] = txn.lock(held, root);
    if (O.is_some[txn.Error](locked)) { ret R.err[usize, str](txn.error_message(O.unwrap[txn.Error](locked))); }
    val recovered: R.Result[usize, txn.Error] = txn.recover(a, held, "");
    if (R.is_err[usize, txn.Error](recovered)) { ret R.err[usize, str](txn.error_message(R.unwrap_err[usize, txn.Error](recovered))); }
    val claimed: O.Option[txn.Error] = txn.claim(destination, a, held, "dep");
    if (O.is_some[txn.Error](claimed)) { ret R.err[usize, str](txn.error_message(O.unwrap[txn.Error](claimed))); }
    val rr: R.Result[usize, txn.Error] = txn.root_remove_tree(destination, name);
    if (R.is_err[usize, txn.Error](rr)) {
        val e: txn.Error = R.unwrap_err[usize, txn.Error](rr);
        if (e.kind == txn.CONTAINMENT) { ret R.err[usize, str]("dependency directory escapes the dependency root or is reached through a symlink; nothing was removed"); }
        ret R.err[usize, str](txn.error_message(e));
    }
    ret R.ok[usize, str](R.unwrap_ok[usize, txn.Error](rr));
}

fun arg_quiet(argc: usize, argv: **u8) bool {
    ret util.flag_exists(argc, argv, "--quiet") || util.flag_exists(argc, argv, "-q");
}

fun opt_value(opt: O.Option[*u8]) *u8 {
    if (O.is_none[*u8](opt)) { ret ""; }
    ret O.unwrap[*u8](opt);
}

fun parse_file(a: *A.Allocator, p: str) R.Result[toml.Table, str] {
    val res_bytes: R.Result[Vector[u8], str] = fs.read_bytes(a, p);
    if (R.is_err[Vector[u8], str](res_bytes)) { ret R.err[toml.Table, str](concat3(a, "cannot read ", p, "")); }
    var bytes: Vector[u8] = R.unwrap_ok[Vector[u8], str](res_bytes);
    val source_r: R.Result[R.Void, str] = manifest.validate_source_bytes(bytes.data, bytes.len);
    if (R.is_err[R.Void, str](source_r)) {
        vector.dnit[u8](?bytes);
        ret R.err[toml.Table, str](R.unwrap_err[R.Void, str](source_r));
    }
    val reserve_r: R.Result[usize, str] = vector.reserve[u8](?bytes, 1);
    if (R.is_err[usize, str](reserve_r)) {
        vector.dnit[u8](?bytes);
        ret R.err[toml.Table, str](R.unwrap_err[usize, str](reserve_r));
    }
    bytes.data[bytes.len] = 0;
    val res_parse: R.Result[toml.Table, str] = toml.parse(a, bytes.data::str);
    vector.dnit[u8](?bytes);
    if (R.is_err[toml.Table, str](res_parse)) { ret R.err[toml.Table, str](concat3(a, p, ": ", R.unwrap_err[toml.Table, str](res_parse))); }
    ret res_parse;
}

fun own(a: *A.Allocator, s: str) str {
    val res_dup: R.Result[str, str] = str_dup(a, s);
    if (R.is_err[str, str](res_dup)) { ret nil; }
    ret R.unwrap_ok[str, str](res_dup);
}

fun concat3(a: *A.Allocator, s1: str, s2: str, s3: str) str {
    val r: R.Result[str, str] = format.sprint(a, "{}{}{}", s1, s2, s3);
    if (R.is_err[str, str](r)) { ret s2; }
    ret R.unwrap_ok[str, str](r);
}

test "mach.cli.cmd.dep.dep_add_source_valid:requires_one_source_and_ref_only_with_git" {
    if (!dep_add_source_valid(true, false, false)) { ret 1; }
    if (!dep_add_source_valid(true, false, true))  { ret 2; }
    if (!dep_add_source_valid(false, true, false)) { ret 3; }
    if (dep_add_source_valid(false, true, true))   { ret 4; }
    if (dep_add_source_valid(false, false, false)) { ret 5; }
    if (dep_add_source_valid(true, true, false))   { ret 6; }
    ret 0;
}

test "mach.cli.cmd.dep.ref_advanceable" {
    if (!ref_advanceable("branch/main")) { ret 1; }
    if (ref_advanceable("tag/v1"))       { ret 2; }
    if (ref_advanceable("commit/abc"))   { ret 3; }
    if (!ref_advanceable(""))            { ret 4; }
    ret 0;
}

test "mach.cli.cmd.dep.dep_root_for:refuses_symlinked_dep_directory" {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    var a: A.Allocator;
    if (O.is_some[str](page.make(?a))) { ret 1; }

    val res_temp: R.Result[fs.TempFile, str] = fs.temp_create(?a, "mach_test_dep_root_escape");
    if (R.is_err[fs.TempFile, str](res_temp)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](res_temp);
    val root: str = fs.temp_path(?tf);
    fs.temp_close_and_remove(?tf);

    val proj:    str = concat3(?a, root, "/", "proj");
    val outside: str = concat3(?a, root, "/", "outside");
    if (O.is_some[str](fs.create_dir_all(?a, proj, 0o755)) || O.is_some[str](fs.create_dir_all(?a, outside, 0o755))) {
        fs.remove_all(?a, root);
        ret 1;
    }
    val link: str = concat3(?a, proj, "/", "dep");
    if (O.is_some[str](fs.symlink(outside, link))) { fs.remove_all(?a, root); ret 1; }

    var cap: txn.Root;
    val res_dep_root: R.Result[bool, str] = dep_root_for(?cap, proj);
    val bad: bool = R.is_ok[bool, str](res_dep_root);
    txn.root_dnit(?cap);
    val purge_r: R.Result[usize, str] = purge_dependency_dir(?a, proj, "anything");
    val purge_ok: bool = R.is_ok[usize, str](purge_r);
    val outside_kept: bool = fs.exists(outside);
    fs.remove_all(?a, root);
    if (bad || purge_ok || !outside_kept) { ret 1; }
    ret 0;
}

test "mach.cli.cmd.dep.purge_dependency_dir:removes_only_a_contained_name_and_refuses_dotdot" {
    var a: A.Allocator;
    if (O.is_some[str](page.make(?a))) { ret 1; }
    val res_temp: R.Result[fs.TempFile, str] = fs.temp_create(?a, "mach_test_dep_purge");
    if (R.is_err[fs.TempFile, str](res_temp)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](res_temp);
    val root: str = fs.temp_path(?tf);
    fs.temp_close_and_remove(?tf);

    val proj:    str = concat3(?a, root, "/", "proj");
    val outside: str = concat3(?a, root, "/", "outside");
    val depdir:  str = concat3(?a, proj, "/", "dep");
    val libx:    str = concat3(?a, depdir, "/", "libx");
    if (O.is_some[str](fs.create_dir_all(?a, libx, 0o755)) || O.is_some[str](fs.create_dir_all(?a, outside, 0o755))) { fs.remove_all(?a, root); ret 1; }
    val inner: str = concat3(?a, libx, "/", "file.mach");
    val sentinel: str = concat3(?a, outside, "/", "sentinel");
    if (O.is_some[str](fs.write_bytes(inner, "x"::*u8, 1, 0o644)) || O.is_some[str](fs.write_bytes(sentinel, "s"::*u8, 1, 0o644))) { fs.remove_all(?a, root); ret 1; }

    var bad: i32 = 0;
    val dd: R.Result[usize, str] = purge_dependency_dir(?a, proj, "../../outside");
    if (R.is_ok[usize, str](dd) || !fs.exists(sentinel)) { bad = 1; }
    val dot: R.Result[usize, str] = purge_dependency_dir(?a, proj, ".");
    if (R.is_ok[usize, str](dot) || !fs.exists(inner)) { bad = 1; }
    val missing: R.Result[usize, str] = purge_dependency_dir(?a, proj, "never");
    if (R.is_err[usize, str](missing) || R.unwrap_ok[usize, str](missing) != 0) { bad = 1; }
    val ok: R.Result[usize, str] = purge_dependency_dir(?a, proj, "libx");
    if (R.is_err[usize, str](ok) || R.unwrap_ok[usize, str](ok) == 0 || fs.exists(libx) || !fs.exists(depdir)) { bad = 1; }

    val nodep: str = concat3(?a, root, "/", "nodep");
    if (O.is_some[str](fs.create_dir_all(?a, nodep, 0o755))) { fs.remove_all(?a, root); ret 1; }
    val absent: R.Result[usize, str] = purge_dependency_dir(?a, nodep, "libx");
    if (R.is_err[usize, str](absent) || R.unwrap_ok[usize, str](absent) != 0) { bad = 1; }

    fs.remove_all(?a, root);
    ret bad;
}

test "mach.cli.cmd.dep.run:plain_project_realizes_and_builds_without_parent_git" {
    var a: A.Allocator;
    if (O.is_some[str](page.make(?a))) { ret 1; }
    var git_env: [4]*u8;
    t_allow_file_transport(?git_env[0]);
    fin { deps.set_git_config_env(nil); }
    val fixture: str = t_package_repo(?a, "mach_dep_plain_source", "libx", "");
    if (str_empty(fixture)) { ret 2; }
    fin { fs.remove_all(?a, fixture); }
    val root: str = t_root_repo(?a, "mach_dep_plain_root", t_dep_table(?a, "libx", fixture));
    if (str_empty(root)) { ret 3; }
    fin { fs.remove_all(?a, root); }
    val marker_r: R.Result[str, str] = path.join(?a, root, ".git");
    if (R.is_err[str, str](marker_r)) { ret 4; }
    val marker: str = R.unwrap_ok[str, str](marker_r);
    if (O.is_some[str](fs.remove_all(?a, marker))) { ret 5; }
    if (pull_project(root, true) != 0) { ret 6; }
    if (fs.exists(marker) || !t_exists_under(?a, root, "dep/libx/.git")) { ret 7; }
    if (verify_project(root) != 0) { ret 8; }
    var s: session.Session;
    var mode: u8 = 0;
    if (!t_session_and_mode(?a, root, ?s, ?mode)) { ret 9; }
    fin { session.dnit(?s); }
    if (mode != deps.REALIZE_NESTED || !t_build_ok(?s, root)) { ret 10; }
    if (fs.exists(marker)) { ret 11; }
    ret 0;
}

