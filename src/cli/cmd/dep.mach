}

test "mach.cli.cmd.dep.dep_root_for:refuses_symlinked_dep_directory" {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    var a: A.Allocator;
    if (O.is_some[str](page.make(?a))) { ret 1; }

    val res_temp: R.Result[fs.TempFile, str] = fs.temp_create(?a, "mach_test_dep_root_escape");
    if (R.is_err[fs.TempFile, str](res_temp)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](res_temp);
    val root: str = fs.temp_path(?tf);
    fs.temp_close_and_remove(?tf);

    val proj:    str = concat3(?a, root, "/", "proj");
    val outside: str = concat3(?a, root, "/", "outside");
    if (O.is_some[str](fs.create_dir_all(?a, proj, 0o755)) || O.is_some[str](fs.create_dir_all(?a, outside, 0o755))) {
        fs.remove_all(?a, root);
        ret 1;
    }
    val link: str = concat3(?a, proj, "/", "dep");
    if (O.is_some[str](fs.symlink(outside, link))) { fs.remove_all(?a, root); ret 1; }

    var cap: txn.Root;
    val res_dep_root: R.Result[bool, str] = dep_root_for(?cap, proj);
    val bad: bool = R.is_ok[bool, str](res_dep_root);
    txn.root_dnit(?cap);
    val purge_r: R.Result[usize, str] = purge_dependency_dir(?a, proj, "anything");
    val purge_ok: bool = R.is_ok[usize, str](purge_r);
    val outside_kept: bool = fs.exists(outside);
    fs.remove_all(?a, root);
    if (bad || purge_ok || !outside_kept) { ret 1; }
    ret 0;
}

test "mach.cli.cmd.dep.purge_dependency_dir:removes_only_a_contained_name_and_refuses_dotdot" {
    var a: A.Allocator;
    if (O.is_some[str](page.make(?a))) { ret 1; }
    val res_temp: R.Result[fs.TempFile, str] = fs.temp_create(?a, "mach_test_dep_purge");
    if (R.is_err[fs.TempFile, str](res_temp)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](res_temp);
    val root: str = fs.temp_path(?tf);
    fs.temp_close_and_remove(?tf);

    val proj:    str = concat3(?a, root, "/", "proj");
    val outside: str = concat3(?a, root, "/", "outside");
    val depdir:  str = concat3(?a, proj, "/", "dep");
    val libx:    str = concat3(?a, depdir, "/", "libx");
    if (O.is_some[str](fs.create_dir_all(?a, libx, 0o755)) || O.is_some[str](fs.create_dir_all(?a, outside, 0o755))) { fs.remove_all(?a, root); ret 1; }
    val inner: str = concat3(?a, libx, "/", "file.mach");
    val sentinel: str = concat3(?a, outside, "/", "sentinel");
    if (O.is_some[str](fs.write_bytes(inner, "x"::*u8, 1, 0o644)) || O.is_some[str](fs.write_bytes(sentinel, "s"::*u8, 1, 0o644))) { fs.remove_all(?a, root); ret 1; }

    var bad: i32 = 0;
    val dd: R.Result[usize, str] = purge_dependency_dir(?a, proj, "../../outside");
    if (R.is_ok[usize, str](dd) || !fs.exists(sentinel)) { bad = 1; }
    val dot: R.Result[usize, str] = purge_dependency_dir(?a, proj, ".");
    if (R.is_ok[usize, str](dot) || !fs.exists(inner)) { bad = 1; }
    val missing: R.Result[usize, str] = purge_dependency_dir(?a, proj, "never");
    if (R.is_err[usize, str](missing) || R.unwrap_ok[usize, str](missing) != 0) { bad = 1; }
    val ok: R.Result[usize, str] = purge_dependency_dir(?a, proj, "libx");
    if (R.is_err[usize, str](ok) || R.unwrap_ok[usize, str](ok) == 0 || fs.exists(libx) || !fs.exists(depdir)) { bad = 1; }

    val nodep: str = concat3(?a, root, "/", "nodep");
    if (O.is_some[str](fs.create_dir_all(?a, nodep, 0o755))) { fs.remove_all(?a, root); ret 1; }
    val absent: R.Result[usize, str] = purge_dependency_dir(?a, nodep, "libx");
    if (R.is_err[usize, str](absent) || R.unwrap_ok[usize, str](absent) != 0) { bad = 1; }

    fs.remove_all(?a, root);
    ret bad;
}

test "mach.cli.cmd.dep.run:pull_outside_a_repository_is_refused" {
    var a: A.Allocator;
    if (O.is_some[str](page.make(?a))) { ret 1; }

    val res_temp: R.Result[fs.TempFile, str] = fs.temp_create(?a, "mach_test_pull_norepo");
