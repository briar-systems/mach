test "mach.cli.cmd.dep.update:the_roots_exact_selector_repins_an_identity_realized_at_a_dependencys_commit" {
    var a: A.Allocator;
    if (O.is_some[str](page.make(?a))) { ret 1; }
    var git_env: [4]*u8;
    t_allow_file_transport(?git_env[0]);
    fin { deps.set_git_config_env(nil); }
    val fix_b: str = t_tagged_b(?a);
    if (str_empty(fix_b)) { ret 1; }
    val fix_a: str = t_requirer_of_b(?a, "mach_dep_fix_a", "a", fix_b, "branch/main", true);
    if (str_empty(fix_a)) { ret 1; }
    val proj: str = t_root_repo(?a, "mach_dep_update_root", t_dep_table(?a, "a", fix_a));
    if (str_empty(proj)) { ret 1; }
    var bad: i32 = 0;
    if (pull_project(proj, true) != 0) { bad = 1; }
    if (bad == 0 && !t_commit_all(?a, proj)) { bad = 2; }
    var s: session.Session;
    var mode: u8 = 0;
    if (!t_session_and_mode(?a, proj, ?s, ?mode)) { ret 1; }
    val dep_b_r: R.Result[str, str] = path.join(?a, proj, "dep/b");
    if (R.is_err[str, str](dep_b_r)) { ret 1; }
    val dep_b: str = R.unwrap_ok[str, str](dep_b_r);
    val before_r: R.Result[str, str] = deps.checkout_head(?s, dep_b);
    if (R.is_err[str, str](before_r)) { bad = 3; }
    val override_r: R.Result[str, str] = format.sprint(?a,
        "[project]\nid = \"root\"\nversion = \"0.1.0\"\nsrc = \"src\"\nout = \"out\"\n\n[target.host]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[artifact.root]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/root\"\ntargets = [\"*\"]\nlink = []\nneed = []\n{}{}",
        t_dep_table(?a, "a", fix_a), t_dep_table_ref(?a, "b", fix_b, "tag/v1.0.0"));
    if (R.is_err[str, str](override_r)) { ret 1; }
    if (bad == 0 && !t_write(?a, proj, MANIFEST, R.unwrap_ok[str, str](override_r))) { bad = 4; }
    var v1: str = "";
    if (bad == 0 && !t_git3(?a, dep_b, "checkout", "-q", "v1.0.0", "", "")) { bad = 5; }
    if (bad == 0) {
        val v1_r: R.Result[str, str] = deps.checkout_head(?s, dep_b);
        if (R.is_err[str, str](v1_r)) { bad = 5; } or { v1 = R.unwrap_ok[str, str](v1_r); }
    }
    if (bad == 0 && !t_git3(?a, dep_b, "checkout", "-q", "main", "", "")) { bad = 5; }
    if (bad == 0 && R.is_ok[str, str](before_r) && str_equals(v1, R.unwrap_ok[str, str](before_r))) { bad = 5; }
    if (bad == 0) {
        var txn: deps.DepTxn;
        val txn_r: R.Result[R.Void, str] = deps.txn_begin(?txn, ?s, proj, mode, "test");
        if (R.is_err[R.Void, str](txn_r)) { bad = 6; }
        or {
            if (update_apply(?s, ?a, proj, mode, false, "b"::*u8, true, 0) != 0) { bad = 7; deps.txn_rollback(?s, ?txn); deps.txn_commit(?s, ?txn); }
            or { deps.txn_commit(?s, ?txn); }
        }
    }
    if (bad == 0) {
        val after_r: R.Result[str, str] = deps.checkout_head(?s, dep_b);
        if (R.is_err[str, str](after_r) || !str_equals(R.unwrap_ok[str, str](after_r), v1)) { bad = 8; }
        val staged_r: R.Result[O.Option[str], str] = deps.staged_gitlink(?s, proj, "b");
        if (R.is_err[O.Option[str], str](staged_r) || O.is_none[str](R.unwrap_ok[O.Option[str], str](staged_r))
            || (R.is_ok[str, str](after_r) && !str_equals(O.unwrap[str](R.unwrap_ok[O.Option[str], str](staged_r)), R.unwrap_ok[str, str](after_r)))) { bad = 9; }
        if (verify_project(proj) != 0) { bad = 10; }
    }
    session.dnit(?s);
    fs.remove_all(?a, proj);
    fs.remove_all(?a, fix_a);
    fs.remove_all(?a, fix_b);
    ret bad;
}

test "mach.cli.cmd.dep.add:a_clash_restores_the_index_and_tree_and_releases_both_coordinators" {
    var a: A.Allocator;
    if (O.is_some[str](page.make(?a))) { ret 1; }
    var git_env: [4]*u8;
    t_allow_file_transport(?git_env[0]);
    fin { deps.set_git_config_env(nil); }
    val fix_b: str = t_tagged_b(?a);
    if (str_empty(fix_b)) { ret 1; }
    val fix_a: str = t_requirer_of_b(?a, "mach_dep_fix_a", "a", fix_b, "tag/v1.0.0", false);
    if (str_empty(fix_a)) { ret 1; }
    val fix_c: str = t_requirer_of_b(?a, "mach_dep_fix_c", "c", fix_b, "tag/v2.0.0", false);
    if (str_empty(fix_c)) { ret 1; }
    val proj: str = t_root_repo(?a, "mach_dep_clash_root", t_dep_table(?a, "a", fix_a));
    if (str_empty(proj)) { ret 1; }
    var bad: i32 = 0;
    if (pull_project(proj, true) != 0) { bad = 1; }
    if (bad == 0 && !t_commit_all(?a, proj)) { bad = 2; }
    var s: session.Session;
    var mode: u8 = 0;
    if (!t_session_and_mode(?a, proj, ?s, ?mode)) { ret 1; }
    var spec: manifest.DepTableSpec;
    spec.name = "c"; spec.source = manifest.DEP_SOURCE_GIT; spec.value = fix_c; spec.ref = "branch/main";
    if (bad == 0 && !t_mutation_rolls_back(?s, ?a, proj, mode, ?spec, "c", 0)) { bad = 3; }
    if (bad == 0 && t_exists_under(?a, proj, "dep/c")) { bad = 4; }
    if (bad == 0) {
        var retry: deps.DepTxn;
        val begun: R.Result[R.Void, str] = deps.txn_begin(?retry, ?s, proj, mode, "retry");
        if (R.is_err[R.Void, str](begun)) { bad = 5; }
        or { if (O.is_some[str](deps.txn_commit(?s, ?retry))) { bad = 5; } }
    }
    val staged_r: R.Result[str, str] = deps.staged_paths(?s, proj, "dep");
    if (bad == 0 && (R.is_err[str, str](staged_r) || t_contains(R.unwrap_ok[str, str](staged_r), "dep/c"))) { bad = 6; }
    if (bad == 0 && verify_project(proj) != 0) { bad = 7; }
    session.dnit(?s);
    fs.remove_all(?a, proj);
    fs.remove_all(?a, fix_a);
    fs.remove_all(?a, fix_c);
    fs.remove_all(?a, fix_b);
    ret bad;
}

test "mach.cli.cmd.dep.pull_and_verify:a_stale_lock_file_is_noted_not_read" {
    var a: A.Allocator;
    if (O.is_some[str](page.make(?a))) { ret 1; }
    val root: str = t_scratch(?a, "mach_dep_lockfile");
    if (str_empty(root)) { ret 1; }
    if (O.is_some[str](deps.stale_lock_note(?a, root))) { fs.remove_all(?a, root); ret 1; }
    if (!t_write(?a, root, "mach.lock", "[[dep]]\n")) { fs.remove_all(?a, root); ret 1; }
    val note: O.Option[str] = deps.stale_lock_note(?a, root);
    if (O.is_none[str](note)) { fs.remove_all(?a, root); ret 2; }
    if (!t_contains(O.unwrap[str](note), "5.0.0") || !t_contains(O.unwrap[str](note), "not read")) { fs.remove_all(?a, root); ret 3; }
    if (!t_write(?a, root, MANIFEST, "[project]\nid = \"root\"\nversion = \"0.1.0\"\nsrc = \"src\"\nout = \"out\"\n")) { fs.remove_all(?a, root); ret 1; }
    if (!t_init_repo(?a, root) || !t_commit_all(?a, root)) { fs.remove_all(?a, root); ret 1; }
    val before_verify: usize = deps.stale_lock_notes_printed;
    val vrc: i64 = verify_project(root);
    if (vrc != 0)                                              { fs.remove_all(?a, root); ret 4; }
    if (deps.stale_lock_notes_printed != before_verify + 1)    { fs.remove_all(?a, root); ret 5; }
    val before_pull: usize = deps.stale_lock_notes_printed;
    val prc: i64 = pull_project(root, false);
    if (prc != 0)                                              { fs.remove_all(?a, root); ret 6; }
    if (deps.stale_lock_notes_printed != before_pull + 1)      { fs.remove_all(?a, root); ret 7; }
    val before_quiet: usize = deps.stale_lock_notes_printed;
    if (pull_project(root, true) != 0 || deps.stale_lock_notes_printed != before_quiet) { fs.remove_all(?a, root); ret 8; }
    fs.remove_all(?a, root);
    ret 0;
}


test "mach.cli.cmd.dep: generated dependency fixtures preserve TOML string values" {
    var a: A.Allocator;
    if (O.is_some[str](page.make(?a))) { ret 1; }
    val url: str = "C:\\Users\\fixture\\quoted\" repo";
    val ref: str = "branch/quoted\"\\line\nnext\tpart";
    val text: str = t_dep_table_ref(?a, "fixture", url, ref);
    if (str_empty(text)) { ret 2; }
    fin { str_free(?a, text); }
    val parsed: R.Result[toml.Table, str] = toml.parse(?a, text);
    if (R.is_err[toml.Table, str](parsed)) { ret 3; }
    var table: toml.Table = R.unwrap_ok[toml.Table, str](parsed);
    fin { toml.dnit(?a, ?table); }
    if (!str_equals(toml.get_str(?table, "dep.fixture.git"), url)) { ret 4; }
    if (!str_equals(toml.get_str(?table, "dep.fixture.ref"), ref)) { ret 5; }
    ret 0;
}


test "mach.cli.cmd.dep.txn:final_storage_refuses_copies_and_snapshot_failure_releases_the_guard" {
    var a: A.Allocator;
    if (O.is_some[str](page.make(?a))) { ret 1; }
    val root: str = t_scratch(?a, "mach_dep_txn_owner");
    if (str_empty(root)) { ret 2; }
    fin { fs.remove_all(?a, root); }
    if (!t_write(?a, root, MANIFEST, "[project]\nid = \"root\"\nversion = \"0.1.0\"\nsrc = \"src\"\nout = \"out\"\n")) { ret 3; }
    if (!t_init_repo(?a, root) || !t_commit_all(?a, root)) { ret 4; }
    val sr: R.Result[session.Session, str] = session.init(?a);
    if (R.is_err[session.Session, str](sr)) { ret 5; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    fin { session.dnit(?s); }
    val gm_r: R.Result[str, str] = path.join(?a, root, ".gitmodules");
    if (R.is_err[str, str](gm_r)) { ret 6; }
    val gm: str = R.unwrap_ok[str, str](gm_r);
    fin { str_free(?a, gm); }
    if (O.is_some[str](fs.create_dir(gm, 0o755))) { ret 7; }
    var owner: deps.DepTxn;
    val blocked: R.Result[R.Void, str] = deps.txn_begin(?owner, ?s, root, deps.REALIZE_REPO_ROOT, "blocked snapshot");
    if (R.is_ok[R.Void, str](blocked)) { deps.txn_commit(?s, ?owner); ret 8; }
    if (O.is_some[str](fs.remove_all(?a, gm))) { ret 9; }
    val begun: R.Result[R.Void, str] = deps.txn_begin(?owner, ?s, root, deps.REALIZE_REPO_ROOT, "owner");
    if (R.is_err[R.Void, str](begun)) { ret 10; }
    fin { deps.txn_commit(?s, ?owner); }
    var copied: deps.DepTxn = owner;
    if (O.is_none[str](deps.txn_commit(?s, ?copied))) { ret 11; }
    var second: deps.DepTxn;
    val conflict: R.Result[R.Void, str] = deps.txn_begin(?second, ?s, root, deps.REALIZE_REPO_ROOT, "conflict");
    if (R.is_ok[R.Void, str](conflict)) { deps.txn_commit(?s, ?second); ret 12; }
    if (O.is_some[str](deps.txn_commit(?s, ?owner))) { ret 13; }
    val reopened: R.Result[R.Void, str] = deps.txn_begin(?owner, ?s, root, deps.REALIZE_REPO_ROOT, "reopened");
    if (R.is_err[R.Void, str](reopened)) { ret 14; }
    val manifest_r: R.Result[str, str] = path.join(?a, root, MANIFEST);
    if (R.is_err[str, str](manifest_r)) { ret 15; }
    val manifest_path: str = R.unwrap_ok[str, str](manifest_r);
    fin { str_free(?a, manifest_path); }
    if (O.is_some[str](fs.remove_file(manifest_path)) || O.is_some[str](fs.create_dir(manifest_path, 0o755))) { ret 16; }
    if (O.is_none[str](deps.txn_rollback(?s, ?owner))) { ret 17; }
    val retained: R.Result[R.Void, str] = deps.txn_begin(?second, ?s, root, deps.REALIZE_REPO_ROOT, "rollback retained");
    if (R.is_ok[R.Void, str](retained)) { deps.txn_commit(?s, ?second); ret 18; }
    if (O.is_some[str](fs.remove_all(?a, manifest_path))) { ret 19; }
    if (O.is_some[str](deps.txn_rollback(?s, ?owner))) { ret 20; }
    val restored: R.Result[str, str] = fs.read_string(?a, manifest_path);
    if (R.is_err[str, str](restored)) { ret 21; }
    val content: str = R.unwrap_ok[str, str](restored);
    fin { str_free(?a, content); }
    if (!str_contains(content, "id = \"root\"")) { ret 22; }
    ret 0;
}
