val MANIFEST: str = manifest.MANIFEST_FILE;

rec DepReq {
    id:        str;
    url:       str;
    src_path:  str;
    ref:       str;
    version:   str;
    chain:     str;
    root_decl: bool;
    is_git:    bool;
    effect:    str;
}

# `mach dep`: route to one action: list, add, remove, update, pull, verify, or the
# deprecated sync, which runs pull after a note
# ---
# argv: the full process arguments
# inv:  the parsed invocation for this command
# ret:  0 success, 1 missing or unknown action, unknown flag, or a failed action, 2 setup failure
pub fun run(argv: **u8, inv: *args.ParsedInvocation) i64 {
    if (!inv.has_action) {
        if (inv.argc < 3) {
            print.eprint("error: missing dep action\n");
            print.eprint("usage: mach dep <pull|verify|update|outdated|add|remove|list>\n");
            ret 1;
        }
        print.eprint("error: unknown dep action '");
        print.eprint(argv[2]::str);
        print.eprint("'\n");
        print.eprint("usage: mach dep <pull|verify|update|outdated|add|remove|list>\n");
        ret 1;
    }

    var parsed: args.DepInvocation = args.build_dep_invocation(inv, argv);
    if (args.reject_unknown_from_invocation(inv, argv, "mach dep")) { ret 1; }
    if (parsed.missing_value_idx != inv.argc) {
        print.eprintf("error: option '{}' for 'mach dep {}' requires a value\n",
            argv[parsed.missing_value_idx]::str, argv[2]::str);
        ret 1;
    }
    if (parsed.duplicate_value_idx != inv.argc) {
        print.eprintf("error: option '{}' for 'mach dep {}' cannot be repeated\n",
            argv[parsed.duplicate_value_idx]::str, argv[2]::str);
        ret 1;
    }
    val spec: *args.DepActionSpec = args.dep_action_spec(parsed.action);
    if (spec == nil) {
        err_line("unknown dep action");
        ret 1;
    }
    var maximum: usize = 1;
    if (parsed.action == args.DEPACT_ADD || parsed.action == args.DEPACT_REMOVE ||
        parsed.action == args.DEPACT_UPDATE) { maximum = 2; }
    if (parsed.operand_count == 0 || parsed.operand_count > maximum ||
        ((parsed.action == args.DEPACT_ADD || parsed.action == args.DEPACT_REMOVE) &&
        parsed.operand_count != 2)) {
        print.eprint("usage: mach dep ");
        print.eprint(spec.name);
        print.eprint(spec.grammar);
        print.eprint("\n");
        ret 1;
    }

    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) {
        err_line("failed to initialise allocator");
        ret 2;
    }
    val loc_r: res[util.ProjectLocation, outcome.Fail] = util.resolve_project_location(?a, argv[parsed.project_idx]::str);
    if (sel loc_r.err) {
        print.eprintf("error: mach dep {} project '{}': {}\n", spec.name,
            argv[parsed.project_idx]::str, outcome.describe(loc_r.err));
        ret 1;
    }
    var location: util.ProjectLocation = loc_r.ok;
    fin { util.dnit_project_location(?a, ?location); }
    val root: str = location.root;
    var name: *u8 = nil;
    if (parsed.operand_count == 2) { name = argv[parsed.name_idx]; }

    if (parsed.action == args.DEPACT_LIST)     { ret dep_list(root); }
    if (parsed.action == args.DEPACT_ADD)      { ret dep_add(root, name, ?parsed); }
    if (parsed.action == args.DEPACT_REMOVE)   { ret dep_remove(root, name, ?parsed); }
    if (parsed.action == args.DEPACT_UPDATE)   { ret dep_update(root, name, ?parsed); }
    if (parsed.action == args.DEPACT_PULL)     { ret pull_project(root, parsed.quiet); }
    if (parsed.action == args.DEPACT_OUTDATED) { ret dep_outdated(root, parsed.offline); }
    if (parsed.action == args.DEPACT_VERIFY)   { ret verify_project(root, parsed.release); }
    err_line("unknown dep action");
    ret 1;
}

# realize the dependency closure of a project: clone or link every declared dependency
# transitively, check each realized manifest's project id against its declared name, and
# report realized directories under dep/ that are no longer in the closure
# ---
# root:  the project root directory
# quiet: suppress progress lines
# ret:   0 realized, 1 a manifest, resolution, identity, or checkout error (printed), 2 the
#        allocator or session could not be initialised
pub fun pull_project(root: str, quiet: bool) i64 {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) {
        err_line("failed to initialise allocator");
        ret 2;
    }
    val sr: res[session.Session, fail.Fail] = session.init(?a);
    if (sel sr.err) {
        err_line("failed to initialise a session");
        ret 2;
    }
    var s: session.Session = sr.ok;

    var reqs: Vector[DepReq] = vector.init[DepReq](?a);
    fin { free_requests(?a, ?reqs); }
    val rc: i64 = realize_closure(?s, ?a, root, ?reqs, quiet, false, nil, nil);
    session.dnit(?s);
    ret rc;
}

# check that every dependency of a project is realized and consistent without changing
# anything; prints "ok" on success. a project root that is not a repository root is noted
# and verified from the realized checkouts. a realized directory under dep/ outside the
# closure is an error here, where pull reports and retains it
# ---
# root:    the project root directory
# release: also refuse a root dependency selected by a branch, a commit or a path
# ret:     0 verified, 1 a mismatch or error (printed), 2 the allocator or session could not
#          be initialised
pub fun verify_project(root: str, release: bool) i64 {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) {
        err_line("failed to initialise allocator");
        ret 2;
    }
    val sr: res[session.Session, fail.Fail] = session.init(?a);
    if (sel sr.err) {
        err_line("failed to initialise a session");
        ret 2;
    }
    var s: session.Session = sr.ok;

    var reqs: Vector[DepReq] = vector.init[DepReq](?a);
    fin { free_requests(?a, ?reqs); }
    var overrides: Vector[deps.RootOverride] = vector.init[deps.RootOverride](?a);
    fin { vector.dnit[deps.RootOverride](?overrides); }
    var rc: i64 = realize_closure(?s, ?a, root, ?reqs, true, true, nil, nil);
    if (rc == 0) {
        val vr: err[outcome.Fail] = driver.verify_dependencies(?s, root, release, ?overrides);
        if (sel vr.err) {
            err_line(outcome.describe(vr.err));
            rc = 1;
        }
    }
    if (rc == 0) { rc = print_overrides(?s, ?overrides); }
    session.dnit(?s);
    if (rc == 0) { print.print("ok\n"); }
    ret rc;
}

fun print_overrides(s: *session.Session, overrides: *Vector[deps.RootOverride]) i64 {
    var i: usize = 0;
    for (i < overrides.len) {
        val text: res[str, outcome.Fail] = deps.root_override_text(s, ?overrides.data[i]);
        i = i + 1;
        if (sel text.err) {
            err_line(outcome.describe(text.err));
            ret 2;
        }
        print.printlnf("{}", text.ok);
        str_free(s.build_alloc, text.ok);
    }
    ret 0;
}

fun realize_closure(s: *session.Session, a: *A.Allocator, root: str, reqs: *Vector[DepReq],
    quiet: bool, verify_only: bool, candidate: *toml.Table, picks: *Vector[resolver.Choice]) i64 {
    val mode_r: res[u8, outcome.Fail] = deps.realization_mode(s, root);
    if (sel mode_r.err) {
        err_line(outcome.describe(mode_r.err));
        ret 1;
    }
    val mode: u8 = mode_r.ok;

    val guard_r: res[bool, outcome.Fail] = dep_root_check(root);
    if (sel guard_r.err) {
        err_line(outcome.describe(guard_r.err));
        ret 1;
    }

    var parsed: toml.Table;
    var mt:     *toml.Table = candidate;
    if (mt == nil) {
        val mt_path_r: res[str, A.Error] = path.join(a, root, MANIFEST);
        if (sel mt_path_r.err) { ret err_oom(); }
        val mt_path: str = mt_path_r.ok;
        fin { str_free(a, mt_path); }
        val mt_r: res[toml.Table, outcome.Fail] = parse_file(a, mt_path);
        if (sel mt_r.err) {
            err_line(outcome.describe(mt_r.err));
            ret 1;
        }
        parsed = mt_r.ok;
        mt     = ?parsed;
    }
    fin {
        if (candidate == nil) { toml.dnit(a, ?parsed); }
    }
    var complete: bool = false;
    fin {
        if (!complete) { report_dep_effects(reqs); }
    }

    var root_id: str = key_text(mt, "project.id");
    if (str_empty(root_id)) { root_id = "(project)"; }

    val seed_r: err[outcome.Fail] = enqueue(a, reqs, root, mt, root_id, true);
    if (sel seed_r.err) {
        err_line(outcome.describe(seed_r.err));
        ret 1;
    }
    apply_picks(a, reqs, picks);
    if (reqs.len == 0) {
        if (!quiet) { print.print("no dependencies\n"); }
        complete = true;
        ret report_strays(a, root, reqs, verify_only);
    }

    var i: usize = 0;
    for (i < reqs.len) {
        if (!verify_only) {
            val rc: i64 = ensure_realized(s, a, root, ?reqs.data[i], mode, quiet);
            if (rc != 0) { ret rc; }
        }
        val dep_full_r: res[str, outcome.Fail] = deps.dep_full_of(a, root, reqs.data[i].id);
        if (sel dep_full_r.err) { ret err_oom(); }
        val dep_full: str = dep_full_r.ok;
        fin { str_free(a, dep_full); }
        val is_dir_r: res[bool, io_error.Error] = fs.is_dir(dep_full);
        if (sel is_dir_r.err) {
            print.eprint("error: dependency '");
            print.eprint(reqs.data[i].id);
            print.eprint("' is not realized at ");
            print.eprint(dep_full);
            print.eprint("\n");
            ret 1;
        }
        if (!(is_dir_r.ok)) {
            print.eprint("error: dependency '");
            print.eprint(reqs.data[i].id);
            print.eprint("' is not realized at ");
            print.eprint(dep_full);
            print.eprint("\n");
            ret 1;
        }
        val sub_path_r: res[str, A.Error] = path.join(a, dep_full, MANIFEST);
        if (sel sub_path_r.err) { ret err_oom(); }
        val sub_path: str = sub_path_r.ok;
        fin { str_free(a, sub_path); }
        val sub_r: res[toml.Table, outcome.Fail] = parse_file(a, sub_path);
        if (sel sub_r.err) {
            err_line(outcome.describe(sub_r.err));
            ret 1;
        }
        var sub: toml.Table = sub_r.ok;
        fin { toml.dnit(a, ?sub); }

        val declared: str               = key_text(?sub, "project.id");
        val ident:    err[outcome.Fail] = deps.check_dep_identity(s, reqs.data[i].id, declared);
        if (sel ident.err) {
            err_line(outcome.describe(ident.err));
            ret 1;
        }
        val nested: err[outcome.Fail] = deps.refuse_nested_realization(s, reqs.data[i].id, dep_full);
        if (sel nested.err) {
            err_line(outcome.describe(nested.err));
            ret 1;
        }

        val child_r: err[outcome.Fail] = enqueue(a, reqs, dep_full, ?sub, reqs.data[i].chain, false);
        if (sel child_r.err) {
            err_line(outcome.describe(child_r.err));
            ret 1;
        }
        apply_picks(a, reqs, picks);
        i = i + 1;
    }
    val result: i64 = report_strays(a, root, reqs, verify_only);
    complete = result == 0;
    ret result;
}

fun report_strays(a: *A.Allocator, root: str, reqs: *Vector[DepReq], verify_only: bool) i64 {
    val ids_r: res[Vector[str], outcome.Fail] = deps.realized_ids(a, root);
    if (sel ids_r.err) {
        err_line(outcome.describe(ids_r.err));
        ret 3;
    }
    var ids: Vector[str] = ids_r.ok;
    var i:   usize       = 0;
    var rc:  i64         = 0;
    for (i < ids.len) {
        if (req_index(reqs, ids.data[i]) < 0) {
            if (verify_only) {
                print.eprint("error: dep/");
                print.eprint(ids.data[i]);
                print.eprint(" is not in the dependency closure\n");
                rc = 1;
            }
            or {
                print.eprintlnf("note: dep/{} is outside the dependency closure; directory retained for explicit removal", ids.data[i]);
            }
        }
        i = i + 1;
    }
    ret rc;
}

fun ensure_realized(s: *session.Session, a: *A.Allocator, root: str, r: *DepReq,
    mode: u8, quiet: bool) i64 {
    if (r.is_git && is_ranged(r) && str_empty(r.ref)) {
        val full: res[str, outcome.Fail] = deps.dep_full_of(a, root, r.id);
        if (sel full.err) { ret err_oom(); }
        val present: res[bool, io_error.Error] = fs.exists(full.ok);
        str_free(a, full.ok);
        if (!(sel present.ok && present.ok)) {
            print.eprintlnf("error: dependency '{}' selects releases by `version = \"{}\"` and has no pin yet; run `mach dep update {} {}`", r.id, r.version, root, r.id);
            ret 1;
        }
    }
    if (r.is_git) {
        var effect: u8 = deps.REALIZED_NOTHING;
        ret realize_git_request(s, a, root, r, mode, false, quiet, ?effect);
    }
    val dep_full_r: res[str, outcome.Fail] = deps.dep_full_of(a, root, r.id);
    if (sel dep_full_r.err) { ret err_oom(); }
    val dep_full: str = dep_full_r.ok;
    fin { str_free(a, dep_full); }

    val is_symlink_r: res[bool, io_error.Error] = fs.is_symlink(dep_full);
    if ((sel is_symlink_r.ok && is_symlink_r.ok)) {
        err_line("dependency checkout is a symlink; existing entry retained");
        ret 1;
    }
    val exists_r: res[bool, io_error.Error] = fs.exists(dep_full);
    if ((sel exists_r.ok && exists_r.ok)) { ret 0; }
    val pr: err[outcome.Fail] = deps.realize_path_dependency(s, root, r.id, r.src_path, mode);
    if (sel pr.err) {
        err_line(outcome.describe(pr.err));
        ret 1;
    }
    r.effect = "copied the local dependency source";
    if (!quiet) {
        print.print("realized ");
        print.print(r.id);
        print.print(" from ");
        print.print(r.src_path);
        print.print("\n");
    }
    ret 0;
}

# realize a git dependency's slot and report what changed; `accept` is add taking an existing checkout
fun realize_git_request(s: *session.Session, a: *A.Allocator, root: str, r: *DepReq,
    mode: u8, accept: bool, quiet: bool, effect: *u8) i64 {
    val observed: res[deps.GitSlot, outcome.Fail] = deps.observe_git_slot(s, root, r.id, mode);
    if (sel observed.err) {
        err_line(outcome.describe(observed.err));
        ret 3;
    }
    var slot: deps.GitSlot = observed.ok;
    fin { deps.git_slot_dnit(s.build_alloc, ?slot); }
    val refused: err[outcome.Fail] = deps.refuse_git_slot(s, root, r.id, mode, ?slot, accept);
    if (sel refused.err) {
        err_line(outcome.describe(refused.err));
        ret 1;
    }
    val realized: res[u8, outcome.Fail] = deps.realize_git_slot(s, root, r.id, r.url, r.ref, mode, ?slot);
    if (sel realized.err) {
        err_line(outcome.describe(realized.err));
        ret 3;
    }
    @effect = realized.ok;
    if (realized.ok == deps.REALIZED_NOTHING) { ret 0; }

    val dep_full_r: res[str, outcome.Fail] = deps.dep_full_of(a, root, r.id);
    if (sel dep_full_r.err) { ret err_oom(); }
    val dep_full: str = dep_full_r.ok;
    fin { str_free(a, dep_full); }
    var note: str = "";
    if (realized.ok == deps.REALIZED_INITIALIZED) {
        r.effect = "initialized the recorded gitlink";
        note     = " (initialized the committed gitlink)";
    }
    or (realized.ok == deps.REALIZED_PINNED) {
        r.effect = "checked out the recorded pin";
        note     = " (restored to the recorded pin)";
    }
    or (realized.ok == deps.REALIZED_REGISTERED) {
        r.effect = "registered the recorded gitlink in .gitmodules";
        note     = " (registered the recorded gitlink)";
    }
    or (realized.ok == deps.REALIZED_ADOPTED) {
        r.effect = "registered and staged the existing checkout";
        note     = " (registered the existing checkout)";
    }
    or          { r.effect = "realized the Git dependency"; }
    if (!quiet) { print.printlnf("realized {} @ {}{}", r.id, head_text(s, dep_full), note); }
    ret 0;
}

fun head_text(s: *session.Session, dep_full: str) str {
    val r: res[str, outcome.Fail] = deps.checkout_head(s, dep_full);
    if (sel r.err) { ret "(unknown)"; }
    ret r.ok;
}

fun req_index(reqs: *Vector[DepReq], id: str) i64 {
    var i: usize = 0;
    for (i < reqs.len) {
        if (str_equals(reqs.data[i].id, id)) { ret i::i64; }
        i = i + 1;
    }
    ret -1;
}

fun free_request(a: *A.Allocator, request: *DepReq) {
    str_free(a, request.id);
    str_free(a, request.url);
    str_free(a, request.src_path);
    str_free(a, request.ref);
    if (request.version != nil) { str_free(a, request.version); }
    str_free(a, request.chain);
}

fun free_requests(a: *A.Allocator, requests: *Vector[DepReq]) {
    var i: usize = 0;
    for (i < requests.len) {
        free_request(a, ?requests.data[i]);
        i = i + 1;
    }
    vector.dnit[DepReq](requests);
}

fun enqueue(a: *A.Allocator, reqs: *Vector[DepReq], manifest_dir: str, mt: *toml.Table,
    chain: str, root_decl: bool) err[outcome.Fail] {
    val deps_t_o: opt[*toml.Table] = toml.get_table(mt, "dep");
    if (sel deps_t_o.none) { ret err[outcome.Fail].ok{}; }
    val deps_t: *toml.Table = deps_t_o.some;
    val n:      usize       = toml.table_len(deps_t);
    var i:      usize       = 0;
    for (i < n) {
        val key_o: opt[str] = toml.table_key(deps_t, i);
        if (sel key_o.none) { brk; }
        val key:     str              = key_o.some;
        val value_o: opt[*toml.Value] = toml.table_value(deps_t, i);
        if (sel value_o.none) { brk; }
        val value: *toml.Value = value_o.some;
        i = i + 1;
        if (value.tag != toml.TYPE_TABLE) {
            ret err[outcome.Fail].err{outcome.user(concat3(a, "[dep.", key, "] is not a table"))};
        }
        if (!manifest.is_valid_id(key)) {
            ret err[outcome.Fail].err{outcome.user(concat3(a, "dependency name '", key, "' must be a portable identifier (letters, digits, '_', '-')"))};
        }
        val git_src:  str  = key_text(?value.data.table, "git");
        val path_src: str  = key_text(?value.data.table, "path");
        val has_git:  bool = !str_empty(git_src);
        val has_path: bool = !str_empty(path_src);
        if (has_git == has_path) {
            ret err[outcome.Fail].err{outcome.user(concat3(a, "[dep.", key, "] needs exactly one source key: 'git' or 'path'"))};
        }

        var r:        DepReq;
        var retained: bool = false;
        fin {
            if (!retained) { free_request(a, ?r); }
        }
        r.id = own(a, key);
        if (r.id == nil) { ret err[outcome.Fail].err{outcome.user("out of memory")}; }
        r.root_decl = root_decl;
        r.is_git    = has_git;
        if (has_git) {
            r.url     = own(a, git_src);
            r.ref     = own(a, key_text(?value.data.table, "ref"));
            r.version = own(a, key_text(?value.data.table, "version"));
            if (r.url == nil || r.ref == nil || r.version == nil) { ret err[outcome.Fail].err{outcome.user("out of memory")}; }
        }
        or {
            if (path.is_abs(path_src)) {
                r.src_path = own(a, path_src);
                if (r.src_path == nil) { ret err[outcome.Fail].err{outcome.user("out of memory")}; }
            }
            or {
                val joined: res[str, A.Error] = path.join(a, manifest_dir, path_src);
                if (sel joined.err) { ret err[outcome.Fail].err{outcome.refused(joined.err)}; }
                r.src_path = joined.ok;
            }
        }
        val chain_r: res[str, format.FormatError] = format.sprint(a, "{} -> {}", chain, key);
        if (sel chain_r.err) { ret err[outcome.Fail].err{outcome.user("out of memory")}; }
        r.chain = chain_r.ok;

        val existing: i64 = req_index(reqs, r.id);
        if (existing >= 0) {
            val e: *DepReq = ?reqs.data[existing::usize];
            if (e.root_decl)             { cnt; }
            if (selection_agrees(e, ?r)) { cnt; }
            ret err[outcome.Fail].err{outcome.user(conflict_text(a, ?r, e, ?r))};
        }
        val pushed: res[usize, A.Error] = vector.push[DepReq](reqs, r);
        if (sel pushed.err) { ret err[outcome.Fail].err{outcome.refused(pushed.err)}; }
        retained = true;
    }
    ret err[outcome.Fail].ok{};
}

fun pick_index(picks: *Vector[resolver.Choice], id: str) i64 {
    var i: usize = 0;
    for (i < picks.len) {
        if (str_equals(picks.data[i].id, id)) { ret i::i64; }
        i = i + 1;
    }
    ret -1;
}

fun is_ranged(r: *DepReq) bool {
    ret r.version != nil && !str_empty(r.version);
}

# a version-selected request realizes the release resolution chose for it
fun apply_picks(a: *A.Allocator, reqs: *Vector[DepReq], picks: *Vector[resolver.Choice]) {
    if (picks == nil) { ret; }
    var i: usize = 0;
    for (i < reqs.len) {
        val r: *DepReq = ?reqs.data[i];
        i = i + 1;
        if (!r.is_git || !is_ranged(r) || !str_empty(r.ref)) { cnt; }
        var k: usize = 0;
        for (k < picks.len) {
            if (str_equals(picks.data[k].id, r.id)) {
                val tag: res[str, format.FormatError] = format.sprint(a, "tag/{}", picks.data[k].tag);
                if (sel tag.ok) {
                    str_free(a, r.ref);
                    r.ref = tag.ok;
                }
            }
            k = k + 1;
        }
    }
}

# notes are the lines a command prints unless --quiet: an --offline resolution, and each
# requirement a root `ref` or `path` overrides
rec Resolution {
    picks:  Vector[resolver.Choice];
    ranged: bool;
    notes:  Vector[str];
}

fun print_notes(r: *Resolution) {
    var i: usize = 0;
    for (i < r.notes.len) {
        print.printlnf("{}", r.notes.data[i]);
        i = i + 1;
    }
}

# resolve every identity the root reaches through a version range. locks keep each realized
# version-selected checkout where it is unless `unlocked` names it or `lock` is false
fun resolve_versions(s: *session.Session, a: *A.Allocator, root: str, table: *toml.Table,
    lowest: bool, offline: bool, lock: bool, unlocked: str) res[Resolution, outcome.Fail] {
    var out:    Resolution                           = Resolution{picks: vector.init[resolver.Choice](a), ranged: false, notes: vector.init[str](a)};
    val parsed: res[manifest.Manifest, outcome.Fail] = manifest.parse(a, ?s.interner, table, false);
    if (sel parsed.err) { ret res[Resolution, outcome.Fail].err{parsed.err}; }
    var m: manifest.Manifest = parsed.ok;
    fin { manifest.dnit(?m, a); }
    var needs:    Vector[resolver.Need]                 = vector.init[resolver.Need](a);
    var fixed:    Vector[str]                           = vector.init[str](a);
    var fixed_by: Vector[str]                           = vector.init[str](a);
    var locks:    Vector[resolver.Lock]                 = vector.init[resolver.Lock](a);
    val gc_r:     res[deps.GitCandidates, outcome.Fail] = deps.git_candidates_init(s, offline, "");
    if (sel gc_r.err) { ret res[Resolution, outcome.Fail].err{gc_r.err}; }
    var gc: deps.GitCandidates = gc_r.ok;
    fin { deps.git_candidates_dnit(?gc); }
    gc.local_root = root;
    var i: u32 = 0;
    for (i < m.dep_count) {
        val d:    *manifest.DepDef = ?m.deps[i];
        val name: str              = intern_str(s, d.name);
        i = i + 1;
        if (d.version == intern.STR_NIL) {
            vector.push[str](?fixed, name);
            var by: res[str, format.FormatError];
            if (d.git == intern.STR_NIL) { by = format.sprint(a, "path \"{}\"", intern_str(s, d.path)); }
            or                           { by = format.sprint(a, "ref \"{}\"", intern_str(s, d.ref)); }
            if (sel by.err)              { ret res[Resolution, outcome.Fail].err{outcome.user(outcome.format_text(by.err))}; }
            vector.push[str](?fixed_by, by.ok);
            cnt;
        }
        val url: str = intern_str(s, d.git);
        vector.push[resolver.Need](?needs, resolver.Need{id: name, url: url, range: intern_str(s, d.version)});
        val full: res[str, outcome.Fail] = deps.dep_full_of(a, root, name);
        if (sel full.ok) {
            val noted: err[outcome.Fail] = deps.git_candidates_add_local(?gc, url, full.ok);
            if (sel noted.err) { ret res[Resolution, outcome.Fail].err{noted.err}; }
        }
    }
    if (needs.len == 0) { ret res[Resolution, outcome.Fail].ok{out}; }
    out.ranged = true;
    if (offline) { vector.push[str](?out.notes, "resolving from releases already fetched (--offline)"); }
    if (lock) {
        val ids: res[Vector[str], outcome.Fail] = deps.realized_ids(a, root);
        if (sel ids.ok) {
            var j: usize = 0;
            for (j < ids.ok.len) {
                val id: str = ids.ok.data[j];
                j = j + 1;
                if (unlocked != nil && str_equals(id, unlocked)) { cnt; }
                val full: res[str, outcome.Fail] = deps.dep_full_of(a, root, id);
                if (sel full.err) { cnt; }
                val at: res[str, outcome.Fail] = deps.release_at_head(s, full.ok);
                if (sel at.ok) {
                    if (!str_empty(at.ok)) { vector.push[resolver.Lock](?locks, resolver.Lock{id: id, version: at.ok}); }
                }
            }
        }
    }
    var root_id: str = key_text(table, "project.id");
    if (str_empty(root_id)) { root_id = "(project)"; }
    var problem: resolver.Problem = resolver.Problem{root: root_id, needs: needs.data, need_count: needs.len::u32,
        fixed: fixed.data, fixed_count: fixed.len::u32, compiler: version.MACH_VERSION, lowest: lowest,
        locks: locks.data, lock_count: locks.len::u32};
    var src:    cand.CandidateSource                       = deps.git_candidate_source(?gc);
    val solved: res[Vector[resolver.Choice], outcome.Fail] = resolver.resolve(a, ?src, deps.release_needs, (?gc)::ptr, ?problem);
    if (sel solved.err) { ret res[Resolution, outcome.Fail].err{solved.err}; }
    out.picks = solved.ok;
    if (fixed.len > 0) {
        val noted: err[outcome.Fail] = note_overrides(a, ?gc, root_id, ?out.picks, ?fixed, ?fixed_by, ?out.notes);
        if (sel noted.err) { ret res[Resolution, outcome.Fail].err{noted.err}; }
    }
    ret res[Resolution, outcome.Fail].ok{out};
}

# name every requirement of a chosen release that a root `ref` or `path` overrides (#3496 section 4)
fun note_overrides(a: *A.Allocator, gc: *deps.GitCandidates, root_id: str, picks: *Vector[resolver.Choice],
    fixed: *Vector[str], fixed_by: *Vector[str], notes: *Vector[str]) err[outcome.Fail] {
    var i: usize = 0;
    for (i < picks.len) {
        val pick: *resolver.Choice = ?picks.data[i];
        i = i + 1;
        val v: res[range.Version, str] = range.parse_version(pick.version);
        if (sel v.err) { ret err[outcome.Fail].err{outcome.user(v.err)}; }
        var rel: cand.Release          = cand.Release{version: v.ok, text: pick.version, tag: pick.tag, commit: pick.commit};
        var rn:  resolver.ReleaseNeeds = resolver.ReleaseNeeds{mach: "", needs: vector.init[resolver.Need](a)};
        val got: err[outcome.Fail]     = deps.release_needs(gc::ptr, pick.id, pick.url, ?rel, ?rn);
        if (sel got.err) { ret got; }
        var k: usize = 0;
        for (k < rn.needs.len) {
            val need: *resolver.Need = ?rn.needs.data[k];
            k = k + 1;
            var f: usize = 0;
            for (f < fixed.len) {
                if (str_equals(fixed.data[f], need.id)) {
                    val line: res[str, format.FormatError] = format.sprint(a, "{} declares {} by {}, overriding {} -> {} {} requires {} {}",
                        root_id, need.id, fixed_by.data[f], root_id, pick.id, pick.version, need.id, need.range);
                    if (sel line.err) { ret err[outcome.Fail].err{outcome.user(outcome.format_text(line.err))}; }
                    vector.push[str](notes, line.ok);
                }
                f = f + 1;
            }
        }
    }
    ret err[outcome.Fail].ok{};
}

fun intern_str(s: *session.Session, id: intern.StrId) str {
    if (id == intern.STR_NIL) { ret ""; }
    val t: opt[str] = intern.lookup(?s.interner, id);
    if (sel t.some) { ret t.some; }
    ret "";
}

# move every chosen release's slot to its tag: a missing slot is realized, and one pinned elsewhere is checked out and staged
fun realize_picks(s: *session.Session, a: *A.Allocator, root: str, mode: u8, picks: *Vector[resolver.Choice], quiet: bool) i64 {
    var i: usize = 0;
    for (i < picks.len) {
        val pick: *resolver.Choice = ?picks.data[i];
        i = i + 1;
        val full_r: res[str, outcome.Fail] = deps.dep_full_of(a, root, pick.id);
        if (sel full_r.err) { ret err_oom(); }
        val full:  str                          = full_r.ok;
        val ref_r: res[str, format.FormatError] = format.sprint(a, "tag/{}", pick.tag);
        if (sel ref_r.err) { ret err_oom(); }
        var request: DepReq = DepReq{id: pick.id, url: pick.url, src_path: "", ref: ref_r.ok, version: "", chain: "",
            root_decl: false, is_git: true, effect: ""};
        val present: res[bool, io_error.Error] = fs.exists(full);
        if (!(sel present.ok && present.ok)) {
            var realized: u8  = deps.REALIZED_NOTHING;
            val rc:       i64 = realize_git_request(s, a, root, ?request, mode, false, quiet, ?realized);
            if (rc != 0) { ret rc; }
            cnt;
        }
        val now: res[str, outcome.Fail] = deps.release_at_head(s, full);
        if (sel now.ok) {
            if (str_equals(now.ok, pick.version)) { cnt; }
        }
        val fr: err[outcome.Fail] = deps.fetch_and_checkout(s, full, request.ref);
        if (sel fr.err) {
            err_line(outcome.describe(fr.err));
            ret 3;
        }
        if (mode == deps.REALIZE_REPO_ROOT) {
            val st: err[outcome.Fail] = deps.stage_dependency(s, root, pick.id);
            if (sel st.err) {
                err_line(outcome.describe(st.err));
                ret 2;
            }
        }
        if (!quiet) { print.printlnf("{}: {} (release {})", pick.id, pick.tag, pick.version); }
    }
    ret 0;
}

# each version-selected identity's pinned release, the highest this compiler and every range
# accept, and the highest release published
pub fun dep_outdated(root: str, offline: bool) i64 {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) {
        err_line("failed to initialise allocator");
        ret 2;
    }
    val sr: res[session.Session, fail.Fail] = session.init(?a);
    if (sel sr.err) {
        err_line("failed to initialise a session");
        ret 2;
    }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    val mt_path_r: res[str, A.Error] = path.join(?a, root, MANIFEST);
    if (sel mt_path_r.err) { ret err_oom(); }
    val mt_r: res[toml.Table, outcome.Fail] = parse_file(?a, mt_path_r.ok);
    if (sel mt_r.err) {
        err_line(outcome.describe(mt_r.err));
        ret 1;
    }
    var mt:       toml.Table                    = mt_r.ok;
    val resolved: res[Resolution, outcome.Fail] = resolve_versions(?s, ?a, root, ?mt, false, offline, false, nil);
    if (sel resolved.err) {
        err_line(outcome.describe(resolved.err));
        ret 1;
    }
    var outdated_notes: Resolution = resolved.ok;
    print_notes(?outdated_notes);
    var picks: Vector[resolver.Choice] = resolved.ok.picks;
    if (!resolved.ok.ranged) {
        print.print("no dependency selects releases by version\n");
        ret 0;
    }
    val gc_r: res[deps.GitCandidates, outcome.Fail] = deps.git_candidates_init(?s, offline, "");
    if (sel gc_r.err) {
        err_line(outcome.describe(gc_r.err));
        ret 1;
    }
    var gc: deps.GitCandidates = gc_r.ok;
    fin { deps.git_candidates_dnit(?gc); }
    var src: cand.CandidateSource = deps.git_candidate_source(?gc);
    print.print("dependency  pinned  compatible  latest\n");
    var i: usize = 0;
    for (i < picks.len) {
        val pick: *resolver.Choice = ?picks.data[i];
        i = i + 1;
        var pinned: str                    = "-";
        val full:   res[str, outcome.Fail] = deps.dep_full_of(?a, root, pick.id);
        if (sel full.ok) {
            if (offline) { deps.git_candidates_add_local(?gc, pick.url, full.ok); }
            val at: res[str, outcome.Fail] = deps.release_at_head(?s, full.ok);
            if (sel at.ok) {
                if (!str_empty(at.ok)) { pinned = at.ok; }
            }
        }
        var list:   Vector[cand.Release] = vector.init[cand.Release](?a);
        var latest: str                  = pick.version;
        val listed: err[outcome.Fail]    = src.releases(src.ctx, pick.url, ?list);
        if (sel listed.ok) {
            var best: range.Version = list.data[0].version;
            var k:    usize         = 0;
            for (k < list.len) {
                val v: *range.Version = ?list.data[k].version;
                if (v.pre_len == 0 && (str_equals(latest, pick.version) || range.compare(v, ?best) > 0)) {
                    if (range.compare(v, ?best) >= 0 || k == 0) {
                        best   = @v;
                        latest = list.data[k].text;
                    }
                }
                k = k + 1;
            }
        }
        var note: str = "";
        if (!str_equals(latest, pick.version)) { note = "  (held back: a range excludes the newer release, or it needs a newer compiler)"; }
        print.printlnf("{}  {}  {}  {}{}", pick.id, pinned, pick.version, latest, note);
    }
    ret 0;
}

fun selection_agrees(x: *DepReq, y: *DepReq) bool {
    if (x.is_git != y.is_git) { ret false; }
    # two version ranges are reconciled by resolution, not by equality
    if (x.is_git && is_ranged(x) && is_ranged(y)) { ret str_equals(x.url, y.url); }
    if (x.is_git)                                 { ret str_equals(x.url, y.url) && str_equals(x.ref, y.ref); }
    ret str_equals(x.src_path, y.src_path);
}

fun selection_text(a: *A.Allocator, r: *DepReq) str {
    if (r.is_git) {
        val t: res[str, format.FormatError] = format.sprint(a, "git {} @ {}", r.url, r.ref);
        if (sel t.err) { ret r.url; }
        ret t.ok;
    }
    val t2: res[str, format.FormatError] = format.sprint(a, "path {}", r.src_path);
    if (sel t2.err) { ret r.src_path; }
    ret t2.ok;
}

# the example table is valid TOML as printed: values are escaped as the
# manifest writer would write them
fun conflict_text(a: *A.Allocator, subject: *DepReq, x: *DepReq, y: *DepReq) str {
    var decl: str = "";
    if (subject.is_git) {
        val url_r: res[str, outcome.Fail] = manifest.toml_escape_value(a, subject.url);
        val ref_r: res[str, outcome.Fail] = manifest.toml_escape_value(a, subject.ref);
        if (sel url_r.ok) {
            if (sel ref_r.ok) {
                val d: res[str, format.FormatError] = format.sprint(a,
                    "[dep.{}]\n    git = \"{}\"\n    ref = \"{}\"", subject.id, url_r.ok, ref_r.ok);
                if (sel d.ok) { decl = d.ok; }
            }
        }
    }
    or {
        val path_r: res[str, outcome.Fail] = manifest.toml_escape_value(a, subject.src_path);
        if (sel path_r.ok) {
            val d: res[str, format.FormatError] = format.sprint(a,
                "[dep.{}]\n    path = \"{}\"", subject.id, path_r.ok);
            if (sel d.ok) { decl = d.ok; }
        }
    }
    val msg: res[str, format.FormatError] = format.sprint(a,
        "dependency conflict: project id '{}' is reached with two different selections:\n    {} requires {}\n    {} requires {}\n  the root decides by declaring the identity itself, for example:\n    {}",
        subject.id, x.chain, selection_text(a, x), y.chain, selection_text(a, y), decl);
    if (sel msg.err) { ret "dependency conflict: one project id resolves to two different selections"; }
    ret msg.ok;
}

fun dep_update(root: str, name: *u8, parsed: *args.DepInvocation) i64 {
    val all: bool = parsed.all;
    if (!all && name == nil) {
        err_line("usage: mach dep update <path> (<name> | --all)");
        ret 1;
    }
    if (all && name != nil) {
        err_line("give a name or --all, not both");
        ret 1;
    }
    if (name != nil && !manifest.is_valid_id(name::str)) {
        err_line("dependency name must be a portable identifier (letters, digits, '_', '-')");
        ret 1;
    }
    val quiet: bool = parsed.quiet;

    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) {
        err_line("failed to initialise allocator");
        ret 2;
    }

    val sr: res[session.Session, fail.Fail] = session.init(?a);
    if (sel sr.err) {
        err_line("failed to initialise a session");
        ret 2;
    }
    var s: session.Session = sr.ok;

    val mode_r: res[u8, outcome.Fail] = deps.realization_mode(?s, root);
    if (sel mode_r.err) {
        err_line(outcome.describe(mode_r.err));
        session.dnit(?s);
        ret 1;
    }
    val mode: u8 = mode_r.ok;

    var edit:  ManifestEdit;
    val txn_r: err[outcome.Fail] = edit_begin(?edit, ?a, root);
    if (sel txn_r.err) {
        err_line(outcome.describe(txn_r.err));
        val failed: i64 = edit_finish(?edit, 1);
        session.dnit(?s);
        ret failed;
    }

    val rc:       i64 = update_apply(?s, ?a, root, mode, all, name, quiet, 0, parsed.lowest, parsed.offline);
    val finished: i64 = edit_finish(?edit, rc);
    session.dnit(?s);
    ret finished;
}

# the project root held open for the edit: the manifest is replaced through
# a sibling temporary and the dependency root is reached through it
rec ManifestEdit {
    root_fd: usize;
}

fun edit_begin(edit: *ManifestEdit, a: *A.Allocator, root: str) err[outcome.Fail] {
    edit.root_fd = os.INVALID_HANDLE;
    val opened: i64 = remove.open_path(root, ?edit.root_fd);
    if (opened < 0) { ret err[outcome.Fail].err{outcome.user(os.error_message(opened))}; }
    val root_r: res[bool, outcome.Fail] = deps.check_dep_root(root);
    if (sel root_r.err) { ret err[outcome.Fail].err{root_r.err}; }
    ret err[outcome.Fail].ok{};
}

fun edit_finish(edit: *ManifestEdit, code: i64) i64 {
    if (edit.root_fd == os.INVALID_HANDLE) { ret code; }
    val closed: i64 = os.close(edit.root_fd);
    edit.root_fd = os.INVALID_HANDLE;
    if (closed < 0) {
        err_line(os.error_message(closed));
        if (code == 0) { ret 3; }
    }
    ret code;
}

fun report_dep_effects(reqs: *Vector[DepReq]) {
    var i: usize = 0;
    for (i < reqs.len) {
        if (!str_empty(reqs.data[i].effect)) {
            print.eprintlnf("note: dep/{}: {} before this failure; state retained", reqs.data[i].id, reqs.data[i].effect);
        }
        i = i + 1;
    }
}

fun update_apply(s: *session.Session, a: *A.Allocator, root: str, mode: u8, all: bool,
    name: *u8, quiet: bool, fail_after: i32, lowest: bool, offline: bool) i64 {
    val mt_path_r: res[str, A.Error] = path.join(a, root, MANIFEST);
    if (sel mt_path_r.err) { ret err_oom(); }
    val mt_r: res[toml.Table, outcome.Fail] = parse_file(a, mt_path_r.ok);
    if (sel mt_r.err) {
        err_line(outcome.describe(mt_r.err));
        ret 1;
    }
    var mt: toml.Table = mt_r.ok;

    var reqs: Vector[DepReq] = vector.init[DepReq](a);
    fin { free_requests(a, ?reqs); }
    var root_id: str = key_text(?mt, "project.id");
    if (str_empty(root_id)) { root_id = "(project)"; }
    val seed_r: err[outcome.Fail] = enqueue(a, ?reqs, root, ?mt, root_id, true);
    if (sel seed_r.err) {
        err_line(outcome.describe(seed_r.err));
        ret 1;
    }

    # a name the root does not declare is looked up in the realized closure
    val transitive: bool           = !all && req_index(?reqs, name::str) < 0;
    var known:      Vector[DepReq] = vector.init[DepReq](a);
    fin { free_requests(a, ?known); }
    val preflight: err[outcome.Fail] = preflight_closure(s, a, root, ?mt, ?known, transitive);
    if (sel preflight.err) {
        err_line(outcome.describe(preflight.err));
        ret 1;
    }
    # version ranges resolve together; naming one unlocks only that identity
    var unlocked: str = nil;
    if (!all) { unlocked = name::str; }
    val resolved: res[Resolution, outcome.Fail] = resolve_versions(s, a, root, ?mt, lowest, offline, !all, unlocked);
    if (sel resolved.err) {
        err_line(outcome.describe(resolved.err));
        ret 1;
    }
    var update_notes: Resolution = resolved.ok;
    if (!quiet) { print_notes(?update_notes); }
    var picks:   Vector[resolver.Choice] = resolved.ok.picks;
    val picked:  bool                    = !all && pick_index(?picks, name::str) >= 0;
    var targets: *Vector[DepReq]         = ?reqs;
    if (transitive && !picked) {
        if (req_index(?known, name::str) < 0) {
            print.eprintlnf("error: dependency '{}' is not in the dependency closure", name::str);
            ret 1;
        }
        targets = ?known;
    }
    var complete: bool = false;
    fin {
        if (!complete) { report_dep_effects(targets); }
    }

    var i: usize = 0;
    for (i < targets.len) {
        val r: *DepReq = ?targets.data[i];
        i = i + 1;
        if (!all && !str_equals(r.id, name::str)) { cnt; }
        if (r.is_git && is_ranged(r))             { cnt; }

        val dep_full_r: res[str, outcome.Fail] = deps.dep_full_of(a, root, r.id);
        if (sel dep_full_r.err) { ret err_oom(); }
        val dep_full: str = dep_full_r.ok;

        if (!r.is_git) {
            val pr: err[outcome.Fail] = deps.realize_path_dependency(s, root, r.id, r.src_path, mode);
            if (sel pr.err) {
                err_line(outcome.describe(pr.err));
                ret 1;
            }
            r.effect = "copied the local source";
            if (!quiet) {
                print.print(r.id);
                print.print(": copied from ");
                print.print(r.src_path);
                print.print("\n");
            }
            cnt;
        }

        # a slot realized at the selector just now has nothing to advance
        var realized: u8  = deps.REALIZED_NOTHING;
        val slot_rc:  i64 = realize_git_request(s, a, root, r, mode, false, quiet, ?realized);
        if (slot_rc != 0)                                                          { ret slot_rc; }
        if (realized == deps.REALIZED_CLONED || realized == deps.REALIZED_ADOPTED) { cnt; }

        val old:   str               = head_text(s, dep_full);
        val exact: bool              = !ref_advanceable(r.ref);
        val fr:    err[outcome.Fail] = deps.fetch_and_checkout(s, dep_full, r.ref);
        if (sel fr.err) {
            err_line(outcome.describe(fr.err));
            ret 3;
        }
        r.effect = "fetched and checked out the requested selector";
        if (fail_after == 1) {
            err_line("injected dependency checkout failure");
            ret 1;
        }
        if (mode == deps.REALIZE_REPO_ROOT) {
            val st: err[outcome.Fail] = deps.stage_dependency(s, root, r.id);
            if (sel st.err) {
                err_line(outcome.describe(st.err));
                ret 2;
            }
        }
        if (mode == deps.REALIZE_REPO_ROOT) { r.effect = "checked out and staged the requested selector"; }
        if (fail_after == 2) {
            err_line("injected dependency staging failure");
            ret 1;
        }
        val fresh: str = head_text(s, dep_full);
        if (!quiet) {
            print.print(r.id);
            print.print(": ");
            if (exact && str_equals(old, fresh)) {
                print.print(old);
                print.print(" (exact selector, already pinned)\n");
            }
            or {
                print.print(old);
                print.print(" -> ");
                print.print(fresh);
                if (exact) { print.print(" (pinned to the exact selector)\n"); }
                or         { print.print("\n"); }
            }
        }
    }

    val moved: i64 = realize_picks(s, a, root, mode, ?picks, quiet);
    if (moved != 0) { ret moved; }

    var closure: Vector[DepReq] = vector.init[DepReq](a);
    fin { free_requests(a, ?closure); }
    val rc: i64 = realize_closure(s, a, root, ?closure, quiet, false, nil, ?picks);
    if (rc != 0) { ret rc; }
    if (fail_after == 3) {
        err_line("injected dependency closure failure");
        ret 1;
    }
    complete = true;
    ret 0;
}

fun ref_advanceable(ref: str) bool {
    if (str_empty(ref))                  { ret true; }
    if (str_starts_with(ref, "branch/")) { ret true; }
    if (str_starts_with(ref, "tag/"))    { ret false; }
    if (str_starts_with(ref, "commit/")) { ret false; }
    ret true;
}

fun dep_add_source_valid(has_git: bool, has_path: bool, has_ref: bool) bool {
    ret has_git != has_path && (!has_ref || has_git);
}

fun dep_add(root: str, name: *u8, parsed: *args.DepInvocation) i64 {
    val opt_git:  opt[*u8] = parsed.git;
    val opt_path: opt[*u8] = parsed.path;
    val opt_ref:  opt[*u8] = parsed.ref;
    val opt_ver:  opt[*u8] = parsed.version;
    val has_git:  bool     = sel opt_git.some;
    val has_path: bool     = sel opt_path.some;
    val has_ref:  bool     = sel opt_ref.some;
    val has_ver:  bool     = sel opt_ver.some;
    if (has_ref && has_ver) {
        err_line("give --ref or --version, not both");
        ret 1;
    }
    if (has_ver && !has_git) {
        err_line("--version applies only to --git dependencies");
        ret 1;
    }
    if (!dep_add_source_valid(has_git, has_path, has_ref)) {
        if (has_path && has_ref && !has_git) {
            err_line("--ref applies only to --git dependencies");
            ret 1;
        }
        err_line("give exactly one source: --git <url> or --path <dir>");
        ret 1;
    }
    if (!manifest.is_valid_id(name::str)) {
        err_line("dependency name must be a portable identifier (letters, digits, '_', '-')");
        ret 1;
    }
    val quiet: bool = parsed.quiet;

    var spec: manifest.DepTableSpec;
    spec.name = name::str;
    if (has_git) {
        spec.source  = manifest.DEP_SOURCE_GIT;
        spec.value   = opt_value(opt_git)::str;
        spec.ref     = opt_value(opt_ref)::str;
        spec.version = opt_value(opt_ver)::str;
        if (spec.ref == nil)     { spec.ref = ""; }
        if (spec.version == nil) { spec.version = ""; }
    }
    or {
        spec.source  = manifest.DEP_SOURCE_PATH;
        spec.value   = opt_value(opt_path)::str;
        spec.ref     = "";
        spec.version = "";
    }
    ret mutate_manifest(root, ?spec, name::str, true, false, quiet, 0);
}

fun dep_remove(root: str, name: *u8, parsed: *args.DepInvocation) i64 {
    val purge: bool = parsed.purge;
    val quiet: bool = parsed.quiet;
    if (!manifest.is_valid_id(name::str)) {
        err_line("dependency name must be a portable identifier (letters, digits, '_', '-')");
        ret 1;
    }
    var spec: manifest.DepTableSpec;
    spec.name   = name::str;
    spec.source = manifest.DEP_SOURCE_PATH;
    spec.value  = "";
    spec.ref    = "";
    ret mutate_manifest(root, ?spec, name::str, false, purge, quiet, 0);
}

fun mutate_manifest(root: str, spec: *manifest.DepTableSpec, name: str, adding: bool, purge: bool,
    quiet: bool, fail_after: i32) i64 {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) {
        err_line("failed to initialise allocator");
        ret 2;
    }

    val sr: res[session.Session, fail.Fail] = session.init(?a);
    if (sel sr.err) {
        err_line("failed to initialise a session");
        ret 2;
    }
    var s: session.Session = sr.ok;

    val mode_r: res[u8, outcome.Fail] = deps.realization_mode(?s, root);
    if (sel mode_r.err) {
        err_line(outcome.describe(mode_r.err));
        session.dnit(?s);
        ret 1;
    }
    val mode: u8 = mode_r.ok;

    var edit:  ManifestEdit;
    val txn_r: err[outcome.Fail] = edit_begin(?edit, ?a, root);
    if (sel txn_r.err) {
        err_line(outcome.describe(txn_r.err));
        val failed: i64 = edit_finish(?edit, 1);
        session.dnit(?s);
        ret failed;
    }

    val rc:       i64 = mutate_apply(?edit, ?s, ?a, root, mode, spec, name, adding, purge, quiet, fail_after);
    val finished: i64 = edit_finish(?edit, rc);
    session.dnit(?s);
    ret finished;
}

fun preflight_closure(s: *session.Session, a: *A.Allocator, root: str, table: *toml.Table,
    reqs: *Vector[DepReq], inspect_git: bool) err[outcome.Fail] {
    val checked: res[manifest.Manifest, outcome.Fail] = manifest.parse(a, ?s.interner, table, false);
    if (sel checked.err) { ret err[outcome.Fail].err{checked.err}; }
    var parsed: manifest.Manifest = checked.ok;
    manifest.dnit(?parsed, a);
    var root_id: str = key_text(table, "project.id");
    if (str_empty(root_id)) { root_id = "(project)"; }
    val seeded: err[outcome.Fail] = enqueue(a, reqs, root, table, root_id, true);
    if (sel seeded.err) { ret seeded; }
    var i: usize = 0;
    for (i < reqs.len) {
        val request: DepReq = reqs.data[i];
        i = i + 1;
        var source: str = request.src_path;
        if (request.is_git) {
            if (!inspect_git) { cnt; }
            val joined: res[str, outcome.Fail] = deps.dep_full_of(a, root, request.id);
            if (sel joined.err) { ret err[outcome.Fail].err{joined.err}; }
            source = joined.ok;
            if (!deps.own_work_tree(a, source)) {
                str_free(a, source);
                cnt;
            }
        }
        fin {
            if (request.is_git) { str_free(a, source); }
        }
        val file_r: res[str, A.Error] = path.join(a, source, MANIFEST);
        if (sel file_r.err) { ret err[outcome.Fail].err{outcome.refused(file_r.err)}; }
        val file: str = file_r.ok;
        fin { str_free(a, file); }
        val read: res[toml.Table, outcome.Fail] = parse_file(a, file);
        if (sel read.err) { ret err[outcome.Fail].err{read.err}; }
        var dependency: toml.Table = read.ok;
        fin { toml.dnit(a, ?dependency); }
        val identity: err[outcome.Fail] = deps.check_dep_identity(s, request.id, key_text(?dependency, "project.id"));
        if (sel identity.err) { ret identity; }
        val more: err[outcome.Fail] = enqueue(a, reqs, source, ?dependency, request.chain, false);
        if (sel more.err) { ret more; }
    }
    ret err[outcome.Fail].ok{};
}

fun mutate_apply(edit: *ManifestEdit, s: *session.Session, a: *A.Allocator, root: str, mode: u8,
    spec: *manifest.DepTableSpec, name: str, adding: bool, purge: bool,
    quiet: bool, fail_after: i32) i64 {
    val mt_path_r: res[str, A.Error] = path.join(a, root, MANIFEST);
    if (sel mt_path_r.err) { ret err_oom(); }
    val mt_path: str = mt_path_r.ok;
    fin { str_free(a, mt_path); }

    val source_r: res[str, fs.FsError] = fs.read_string(a, mt_path);
    if (sel source_r.err) {
        err_line(outcome.fs_text(source_r.err));
        ret 1;
    }
    val source: str = source_r.ok;
    fin { str_free(a, source); }

    # a git dependency added without a selector takes the caret range of the release resolution picks
    val choose_range: bool = adding && spec.source == manifest.DEP_SOURCE_GIT && str_empty(spec.ref)
        && (spec.version == nil || str_empty(spec.version));
    if (choose_range) {
        spec.version = ">=0.0.0";
        val probe_r: res[str, outcome.Fail] = manifest.manifest_add_dep_table(a, source, spec);
        if (sel probe_r.err) {
            err_line(outcome.describe(probe_r.err));
            ret 1;
        }
        val probe_t: res[toml.Table, toml.TomlError] = toml.parse(a, probe_r.ok);
        if (sel probe_t.err) {
            err_line(outcome.toml_text(probe_t.err));
            ret 1;
        }
        var probe:  toml.Table                    = probe_t.ok;
        val chosen: res[Resolution, outcome.Fail] = resolve_versions(s, a, root, ?probe, false, false, true, name);
        toml.dnit(a, ?probe);
        if (sel chosen.err) {
            err_line(outcome.describe(chosen.err));
            ret 1;
        }
        val at: i64 = pick_index(?chosen.ok.picks, name);
        if (at < 0) {
            err_line("resolution chose no release for the new dependency");
            ret 1;
        }
        val caret: res[str, format.FormatError] = format.sprint(a, "^{}", chosen.ok.picks.data[at::usize].version);
        if (sel caret.err) { ret err_oom(); }
        spec.version = caret.ok;
    }

    var candidate_r: res[str, outcome.Fail];
    if (adding) { candidate_r = manifest.manifest_add_dep_table(a, source, spec); }
    or          { candidate_r = manifest.manifest_remove_dep_table(a, source, name); }
    if (sel candidate_r.err) {
        err_line(outcome.describe(candidate_r.err));
        ret 1;
    }
    val candidate: str = candidate_r.ok;
    fin { str_free(a, candidate); }

    val table_r: res[toml.Table, toml.TomlError] = toml.parse(a, candidate);
    if (sel table_r.err) {
        err_line(outcome.toml_text(table_r.err));
        ret 1;
    }
    var table: toml.Table = table_r.ok;
    fin { toml.dnit(a, ?table); }
    var known: Vector[DepReq] = vector.init[DepReq](a);
    fin { free_requests(a, ?known); }
    val preflight: err[outcome.Fail] = preflight_closure(s, a, root, ?table, ?known, true);
    if (sel preflight.err) {
        err_line(outcome.describe(preflight.err));
        ret 1;
    }
    val resolved: res[Resolution, outcome.Fail] = resolve_versions(s, a, root, ?table, false, false, true, name);
    if (sel resolved.err) {
        err_line(outcome.describe(resolved.err));
        ret 1;
    }
    var add_notes: Resolution = resolved.ok;
    if (!quiet) { print_notes(?add_notes); }
    var picks:          Vector[resolver.Choice] = resolved.ok.picks;
    val still_required: bool                    = !adding && req_index(?known, name) >= 0;
    if (still_required && purge) {
        err_line("dependency is still required by the closure; cannot purge its checkout");
        ret 1;
    }
    var removing_git: bool = false;
    if (!adding) {
        val original_r: res[toml.Table, toml.TomlError] = toml.parse(a, source);
        if (sel original_r.err) {
            err_line(outcome.toml_text(original_r.err));
            ret 1;
        }
        var original:     toml.Table       = original_r.ok;
        val declarations: opt[*toml.Table] = toml.get_table(?original, "dep");
        if (sel declarations.some) {
            val declaration: opt[*toml.Table] = toml.get_table(declarations.some, name);
            if (sel declaration.some) { removing_git = !str_empty(key_text(declaration.some, "git")); }
        }
        toml.dnit(a, ?original);
    }
    if (adding && spec.source == manifest.DEP_SOURCE_PATH) {
        val destination_r: res[str, outcome.Fail] = deps.dep_full_of(a, root, name);
        if (sel destination_r.err) { ret err_oom(); }
        val destination: str = destination_r.ok;
        fin { str_free(a, destination); }
        val exists_r:     res[bool, io_error.Error] = fs.exists(destination);
        val is_symlink_r: res[bool, io_error.Error] = fs.is_symlink(destination);
        if ((sel exists_r.ok && exists_r.ok)) {
            err_line("dependency destination already exists; existing checkout retained");
            ret 1;
        }
        if ((sel is_symlink_r.ok && is_symlink_r.ok)) {
            err_line("dependency destination already exists; existing checkout retained");
            ret 1;
        }
    }
    if (fail_after == 1) {
        err_line("injected dependency preflight failure");
        ret 1;
    }
    var completed: str  = nil;
    var success:   bool = false;
    fin {
        if (!success && completed != nil) {
            print.eprintlnf("note: dep/{}: {} before this failure; inspect Git and mach.toml before retrying", name, completed);
        }
    }

    if (!adding) {
        if (!still_required && removing_git) {
            val ur: err[outcome.Fail] = deps.remove_dependency_index(s, root, name, mode);
            if (sel ur.err) {
                err_line(outcome.describe(ur.err));
                ret 3;
            }
            if (mode == deps.REALIZE_REPO_ROOT) { completed = "removed the dependency registration; checkout retained"; }
        }
        if (purge) {
            val removed: res[usize, outcome.Fail] = purge_beneath(edit.root_fd, name);
            if (sel removed.err) {
                err_line(outcome.describe(removed.err));
                ret 3;
            }
            completed = "removed the dependency registration and purged its checkout";
        }
    }
    or (spec.source == manifest.DEP_SOURCE_PATH) {
        var src: str = spec.value;
        if (!path.is_abs(src)) {
            val j: res[str, A.Error] = path.join(a, root, spec.value);
            if (sel j.err) { ret err_oom(); }
            src = j.ok;
        }
        val pr: err[outcome.Fail] = deps.realize_path_dependency(s, root, name, src, mode);
        if (sel pr.err) {
            err_line(outcome.describe(pr.err));
            ret 1;
        }
        completed = "copied the local source";
    }
    or (spec.version != nil && !str_empty(spec.version)) {
        val placed: i64 = realize_picks(s, a, root, mode, ?picks, quiet);
        if (placed != 0) { ret placed; }
        completed = "realized the selected release";
    }
    or {
        var request: DepReq;
        request.version   = "";
        request.id        = name;
        request.url       = spec.value;
        request.src_path  = "";
        request.ref       = spec.ref;
        request.chain     = "";
        request.root_decl = true;
        request.is_git    = true;
        request.effect    = "";
        var realized: u8  = deps.REALIZED_NOTHING;
        val slot_rc:  i64 = realize_git_request(s, a, root, ?request, mode, true, quiet, ?realized);
        if (!str_empty(request.effect)) { completed = request.effect; }
        if (slot_rc != 0)               { ret slot_rc; }
    }
    if (fail_after == 2) {
        err_line("injected dependency realization failure");
        ret 1;
    }

    var closure: Vector[DepReq] = vector.init[DepReq](a);
    fin { free_requests(a, ?closure); }
    val rc: i64 = realize_closure(s, a, root, ?closure, quiet, false, ?table, ?picks);
    if (rc != 0) { ret rc; }
    if (fail_after == 3) {
        err_line("injected dependency publication failure");
        report_dep_effects(?closure);
        ret 1;
    }
    val w: err[outcome.Fail] = output.replace(a, mt_path, candidate::*u8, str_len(candidate), 0o644);
    if (sel w.err) {
        err_line(outcome.describe(w.err));
        report_dep_effects(?closure);
        ret 3;
    }
    success = true;

    if (!quiet) {
        if (adding) { print.print("added [dep."); }
        or          { print.print("removed [dep."); }
        print.print(name);
        print.print("]\n");
    }
    ret 0;
}

fun dep_list(root: str) i64 {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) {
        err_line("failed to initialise allocator");
        ret 2;
    }

    val mt_path_r: res[str, A.Error] = path.join(?a, root, MANIFEST);
    if (sel mt_path_r.err) { ret err_oom(); }
    val mt_r: res[toml.Table, outcome.Fail] = parse_file(?a, mt_path_r.ok);
    if (sel mt_r.err) {
        err_line(outcome.describe(mt_r.err));
        ret 1;
    }
    var mt: toml.Table = mt_r.ok;

    val deps_t_o: opt[*toml.Table] = toml.get_table(?mt, "dep");
    if (sel deps_t_o.none) {
        print.print("no dependencies\n");
        ret 0;
    }
    val deps_t: *toml.Table = deps_t_o.some;
    if (toml.table_len(deps_t) == 0) {
        print.print("no dependencies\n");
        ret 0;
    }

    val sr: res[session.Session, fail.Fail] = session.init(?a);
    if (sel sr.err) {
        err_line("failed to initialise a session");
        ret 2;
    }
    var s: session.Session = sr.ok;

    val n: usize = toml.table_len(deps_t);
    var i: usize = 0;
    for (i < n) {
        val key_o: opt[str] = toml.table_key(deps_t, i);
        if (sel key_o.none) { brk; }
        val key:     str              = key_o.some;
        val value_o: opt[*toml.Value] = toml.table_value(deps_t, i);
        if (sel value_o.none) { brk; }
        val value: *toml.Value = value_o.some;
        i = i + 1;
        print.print("  ");
        print.print(key);
        if (value.tag != toml.TYPE_TABLE) {
            print.print("  (invalid)\n");
            cnt;
        }
        val git_src:  str                    = key_text(?value.data.table, "git");
        val path_src: str                    = key_text(?value.data.table, "path");
        val full_r:   res[str, outcome.Fail] = deps.dep_full_of(?a, root, key);
        var state:    str                    = "missing";
        if (sel full_r.ok) {
            val full:     str                       = full_r.ok;
            val is_dir_r: res[bool, io_error.Error] = fs.is_dir(full);
            if ((sel is_dir_r.ok && is_dir_r.ok)) { state = "realized"; }
        }
        if (!str_empty(git_src)) {
            print.print("  git=");
            print.print(git_src);
            val ref: str = key_text(?value.data.table, "ref");
            if (!str_empty(ref)) {
                print.print("  ref=");
                print.print(ref);
            }
            val staged_r: res[opt[str], outcome.Fail] = deps.staged_gitlink(?s, root, key);
            if (sel staged_r.ok) {
                val staged_o: opt[str] = staged_r.ok;
                if (sel staged_o.some) {
                    print.print("  pin=");
                    print.print(staged_o.some);
                }
            }
        }
        or {
            print.print("  path=");
            print.print(path_src);
        }
        print.print("  ");
        print.print(state);
        print.print("\n");
    }
    session.dnit(?s);
    ret 0;
}

fun err_line(msg: str) {
    print.eprint("error: ");
    print.eprint(msg);
    print.eprint("\n");
}

fun err_oom() i64 {
    err_line("out of memory");
    ret 2;
}

# true when `dep` beneath the project root is a real directory, false when
# it is absent; a symlink or other entry is refused
fun dep_root_check(root: str) res[bool, outcome.Fail] {
    ret deps.check_dep_root(root);
}

fun purge_dependency_dir(a: *A.Allocator, root: str, name: str) res[usize, outcome.Fail] {
    if (!manifest.is_project_path(name)) { ret res[usize, outcome.Fail].err{outcome.user("dependency removal requires a canonical path beneath dep")}; }
    var root_fd: usize = os.INVALID_HANDLE;
    val opened:  i64   = remove.open_path(root, ?root_fd);
    if (opened < 0) { ret res[usize, outcome.Fail].err{outcome.user(os.error_message(opened))}; }
    fin { os.close(root_fd); }
    ret purge_beneath(root_fd, name);
}

fun purge_beneath(root_fd: usize, name: str) res[usize, outcome.Fail] {
    var fd:     usize = os.INVALID_HANDLE;
    val opened: i64   = remove.open_dir(root_fd, "dep", ?fd);
    if (os.error_kind(opened) == io_error.NOT_FOUND) { ret res[usize, outcome.Fail].ok{0}; }
    if (opened < 0)                                  { ret res[usize, outcome.Fail].err{outcome.user(deps.DEP_ROOT_REFUSED)}; }
    fin { os.close(fd); }
    val rr: remove.Removal = remove.relative(fd, name);
    if (rr.failed) {
        if (rr.containment) { ret res[usize, outcome.Fail].err{outcome.user("dependency directory escapes the dependency root or is reached through a symlink; nothing was removed")}; }
        ret res[usize, outcome.Fail].err{outcome.user(remove.message(rr))};
    }
    ret res[usize, outcome.Fail].ok{rr.removed};
}

# a string key as the dependency commands read it: absent reads as empty
fun key_text(t: *toml.Table, key: str) str {
    val s: opt[str] = toml.get_str(t, key);
    if (sel s.some) { ret s.some; }
    ret "";
}

fun opt_value(found: opt[*u8]) *u8 {
    if (sel found.none) { ret ""; }
    ret found.some;
}

fun parse_file(a: *A.Allocator, p: str) res[toml.Table, outcome.Fail] {
    val res_bytes: res[Vector[u8], fs.FsError] = fs.read_bytes(a, p);
    if (sel res_bytes.err) { ret res[toml.Table, outcome.Fail].err{outcome.user(concat3(a, "cannot read ", p, ""))}; }
    var bytes:    Vector[u8]        = res_bytes.ok;
    val source_r: err[outcome.Fail] = manifest.validate_source_bytes(bytes.data, bytes.len);
    if (sel source_r.err) {
        vector.dnit[u8](?bytes);
        ret res[toml.Table, outcome.Fail].err{source_r.err};
    }
    val reserve_r: res[usize, A.Error] = vector.reserve[u8](?bytes, 1);
    if (sel reserve_r.err) {
        vector.dnit[u8](?bytes);
        ret res[toml.Table, outcome.Fail].err{outcome.refused(reserve_r.err)};
    }
    bytes.data[bytes.len] = 0;
    val res_parse: res[toml.Table, toml.TomlError] = toml.parse(a, bytes.data::str);
    vector.dnit[u8](?bytes);
    if (sel res_parse.err) { ret res[toml.Table, outcome.Fail].err{outcome.user(concat3(a, p, ": ", outcome.toml_text(res_parse.err)))}; }
    if (sel res_parse.err) { ret res[toml.Table, outcome.Fail].err{outcome.user(outcome.toml_text(res_parse.err))}; }
    ret res[toml.Table, outcome.Fail].ok{res_parse.ok};
}

fun own(a: *A.Allocator, s: str) str {
    val res_dup: res[str, A.Error] = str_dup(a, s);
    if (sel res_dup.err) { ret nil; }
    ret res_dup.ok;
}

fun concat3(a: *A.Allocator, s1: str, s2: str, s3: str) str {
    val r: res[str, format.FormatError] = format.sprint(a, "{}{}{}", s1, s2, s3);
    if (sel r.err) { ret s2; }
    ret r.ok;
}

# a refusal carries no native code, and a purge it stops is still an error
test "mach.cli.cmd.dep.purge_beneath:a_removal_refusal_is_an_error" {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val created: res[fixture.Output, outcome.Fail] = fixture.create(?a, "mach-dep-refusal");
    if (sel created.err) { ret 2; }
    var owner: fixture.Output = created.ok;
    fin { fixture.dnit(?owner); }
    var root: usize = os.INVALID_HANDLE;
    if (remove.open_path(owner.directory, ?root) < 0) { ret 3; }
    fin { os.close(root); }
    if (os.make_dir(root, "dep", 0o700) < 0 || os.make_dir(root, "dep/kept", 0o700) < 0) { ret 4; }
    val long: str = remove.t_component(?a, 256);
    if (long == nil) { ret 5; }
    val too_long: res[usize, outcome.Fail] = purge_beneath(root, long);
    if (!sel too_long.err) { ret 6; }
    val trailing: res[usize, outcome.Fail] = purge_beneath(root, "kept/");
    if (sel trailing.ok) { ret 7; }
    val kept: res[usize, outcome.Fail] = purge_beneath(root, "kept");
    if (!(sel kept.ok && kept.ok > 0)) { ret 8; }
    ret 0;
}

test "mach.cli.cmd.dep.dep_add_source_valid:requires_one_source_and_ref_only_with_git" {
    if (!dep_add_source_valid(true, false, false)) { ret 1; }
    if (!dep_add_source_valid(true, false, true))  { ret 2; }
    if (!dep_add_source_valid(false, true, false)) { ret 3; }
    if (dep_add_source_valid(false, true, true))   { ret 4; }
    if (dep_add_source_valid(false, false, false)) { ret 5; }
    if (dep_add_source_valid(true, true, false))   { ret 6; }
    ret 0;
}

test "mach.cli.cmd.dep.ref_advanceable" {
    if (!ref_advanceable("branch/main")) { ret 1; }
    if (ref_advanceable("tag/v1"))       { ret 2; }
    if (ref_advanceable("commit/abc"))   { ret 3; }
    if (!ref_advanceable(""))            { ret 4; }
    ret 0;
}

test "mach.cli.cmd.dep.dep_root_for:refuses_symlinked_dep_directory" {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }

    val res_temp: res[fs.TempFile, fs.FsError] = fs.temp_create(?a, "mach_test_dep_root_escape");
    if (sel res_temp.err) { ret 1; }
    var tf:   fs.TempFile = res_temp.ok;
    val root: str         = fs.temp_path(?tf);
    fs.temp_close_and_remove(?tf);

    val proj:              str             = concat3(?a, root, "/", "proj");
    val outside:           str             = concat3(?a, root, "/", "outside");
    val create_dir_all_r2: err[fs.FsError] = fs.create_dir_all(?a, proj, 0o755);
    val create_dir_all_r:  err[fs.FsError] = fs.create_dir_all(?a, outside, 0o755);
    if (sel create_dir_all_r2.err) {
        fs.remove_all(?a, root);
        ret 1;
    }
    if (sel create_dir_all_r.err) {
        fs.remove_all(?a, root);
        ret 1;
    }
    val link:      str                 = concat3(?a, proj, "/", "dep");
    val symlink_r: err[io_error.Error] = fs.symlink(outside, link);
    if (sel symlink_r.err) {
        fs.remove_all(?a, root);
        ret 1;
    }

    val res_dep_root: res[bool, outcome.Fail]   = dep_root_check(proj);
    val bad:          bool                      = sel res_dep_root.ok;
    val purge_r:      res[usize, outcome.Fail]  = purge_dependency_dir(?a, proj, "anything");
    val purge_ok:     bool                      = sel purge_r.ok;
    val exists_r:     res[bool, io_error.Error] = fs.exists(outside);
    if (sel exists_r.err) { ret 99; }
    val outside_kept: bool = (sel exists_r.ok && exists_r.ok);
    fs.remove_all(?a, root);
    if (bad || purge_ok || !outside_kept) { ret 1; }
    ret 0;
}

test "mach.cli.cmd.dep.purge_dependency_dir:removes_only_a_contained_name_and_refuses_dotdot" {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val res_temp: res[fs.TempFile, fs.FsError] = fs.temp_create(?a, "mach_test_dep_purge");
    if (sel res_temp.err) { ret 1; }
    var tf:   fs.TempFile = res_temp.ok;
    val root: str         = fs.temp_path(?tf);
    fs.temp_close_and_remove(?tf);

    val proj:              str             = concat3(?a, root, "/", "proj");
    val outside:           str             = concat3(?a, root, "/", "outside");
    val depdir:            str             = concat3(?a, proj, "/", "dep");
    val libx:              str             = concat3(?a, depdir, "/", "libx");
    val create_dir_all_r2: err[fs.FsError] = fs.create_dir_all(?a, libx, 0o755);
    val create_dir_all_r:  err[fs.FsError] = fs.create_dir_all(?a, outside, 0o755);
    if (sel create_dir_all_r2.err) {
        fs.remove_all(?a, root);
        ret 1;
    }
    if (sel create_dir_all_r.err) {
        fs.remove_all(?a, root);
        ret 1;
    }
    val inner:          str             = concat3(?a, libx, "/", "file.mach");
    val sentinel:       str             = concat3(?a, outside, "/", "sentinel");
    val write_bytes_r2: err[fs.FsError] = fs.write_bytes(inner, "x"::*u8, 1, 0o644);
    val write_bytes_r:  err[fs.FsError] = fs.write_bytes(sentinel, "s"::*u8, 1, 0o644);
    if (sel write_bytes_r2.err) {
        fs.remove_all(?a, root);
        ret 1;
    }
    if (sel write_bytes_r.err) {
        fs.remove_all(?a, root);
        ret 1;
    }

    var bad:      i32                       = 0;
    val dd:       res[usize, outcome.Fail]  = purge_dependency_dir(?a, proj, "../../outside");
    val exists_r: res[bool, io_error.Error] = fs.exists(sentinel);
    if (sel exists_r.err)                               { ret 99; }
    if (sel dd.ok || !(sel exists_r.ok && exists_r.ok)) { bad = 1; }
    val dot:       res[usize, outcome.Fail]  = purge_dependency_dir(?a, proj, ".");
    val exists_r2: res[bool, io_error.Error] = fs.exists(inner);
    if (sel exists_r2.err)                                 { ret 99; }
    if (sel dot.ok || !(sel exists_r2.ok && exists_r2.ok)) { bad = 1; }
    val missing: res[usize, outcome.Fail] = purge_dependency_dir(?a, proj, "never");
    if (!(sel missing.ok && missing.ok == 0)) { bad = 1; }
    val ok:        res[usize, outcome.Fail]  = purge_dependency_dir(?a, proj, "libx");
    val exists_r3: res[bool, io_error.Error] = fs.exists(libx);
    val exists_r4: res[bool, io_error.Error] = fs.exists(depdir);
    if (!(sel ok.ok && ok.ok != 0))          { bad = 1; }
    if (sel exists_r3.ok && exists_r3.ok)    { bad = 1; }
    if (!(sel exists_r4.ok && exists_r4.ok)) { bad = 1; }

    val nodep:             str             = concat3(?a, root, "/", "nodep");
    val create_dir_all_r3: err[fs.FsError] = fs.create_dir_all(?a, nodep, 0o755);
    if (sel create_dir_all_r3.err) {
        fs.remove_all(?a, root);
        ret 1;
    }
    val absent: res[usize, outcome.Fail] = purge_dependency_dir(?a, nodep, "libx");
    if (!(sel absent.ok && absent.ok == 0)) { bad = 1; }

    fs.remove_all(?a, root);
    ret bad;
}

test "mach.cli.cmd.dep.run:plain_project_realizes_and_builds_without_parent_git" {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    var git_env: [4]*u8;
    t_allow_file_transport(?git_env[0]);
    fin { deps.set_git_config_env(nil); }
    val fixture: str = t_package_repo(?a, "mach_dep_plain_source", "libx", "");
    if (str_empty(fixture)) { ret 2; }
    fin { fs.remove_all(?a, fixture); }
    val root: str = t_root_repo(?a, "mach_dep_plain_root", t_dep_table(?a, "libx", fixture));
    if (str_empty(root)) { ret 3; }
    fin { fs.remove_all(?a, root); }
    val marker_r: res[str, A.Error] = path.join(?a, root, ".git");
    if (sel marker_r.err) { ret 4; }
    val marker:       str             = marker_r.ok;
    val remove_all_r: err[fs.FsError] = fs.remove_all(?a, marker);
    if (sel remove_all_r.err)          { ret 5; }
    if (pull_project(root, true) != 0) { ret 6; }
    val exists_r: res[bool, io_error.Error] = fs.exists(marker);
    if (sel exists_r.err)                           { ret 99; }
    if ((sel exists_r.ok && exists_r.ok))           { ret 7; }
    if (!t_exists_under(?a, root, "dep/libx/.git")) { ret 7; }
    if (verify_project(root, false) != 0)           { ret 8; }
    var s:    session.Session;
    var mode: u8 = 0;
    if (!t_session_and_mode(?a, root, ?s, ?mode)) { ret 9; }
    fin { session.dnit(?s); }
    if (mode != deps.REALIZE_NESTED || !t_build_ok(?s, root)) { ret 10; }
    val exists_r2: res[bool, io_error.Error] = fs.exists(marker);
    if (sel exists_r2.err)                  { ret 99; }
    if ((sel exists_r2.ok && exists_r2.ok)) { ret 11; }
    ret 0;
}

