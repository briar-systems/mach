test "mach.cli.cmd.dep.update:the_roots_exact_selector_repins_an_identity_realized_at_a_dependencys_commit" {
    var a: A.Allocator;
    if (O.is_some[str](page.make(?a))) { ret 1; }
    var git_env: [4]*u8;
    t_allow_file_transport(?git_env[0]);
    fin { deps.set_git_config_env(nil); }
    val fix_b: str = t_tagged_b(?a);
    if (str_empty(fix_b)) { ret 1; }
    val fix_a: str = t_requirer_of_b(?a, "mach_dep_fix_a", "a", fix_b, "branch/main", true);
    if (str_empty(fix_a)) { ret 1; }
    val proj: str = t_root_repo(?a, "mach_dep_update_root", t_dep_table(?a, "a", fix_a));
    if (str_empty(proj)) { ret 1; }
    var bad: i32 = 0;
    if (pull_project(proj, true) != 0) { bad = 1; }
    if (bad == 0 && !t_commit_all(?a, proj)) { bad = 2; }
    var s: session.Session;
    var mode: u8 = 0;
    if (!t_session_and_mode(?a, proj, ?s, ?mode)) { ret 1; }
    val dep_b_r: R.Result[str, str] = path.join(?a, proj, "dep/b");
    if (R.is_err[str, str](dep_b_r)) { ret 1; }
    val dep_b: str = R.unwrap_ok[str, str](dep_b_r);
    val before_r: R.Result[str, str] = deps.checkout_head(?s, dep_b);
    if (R.is_err[str, str](before_r)) { bad = 3; }
    val override_r: R.Result[str, str] = format.sprint(?a,
        "[project]\nid = \"root\"\nversion = \"0.1.0\"\nsrc = \"src\"\nout = \"out\"\n\n[target.host]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[artifact.root]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/root\"\ntargets = [\"*\"]\nlink = []\nneed = []\n{}{}",
        t_dep_table(?a, "a", fix_a), t_dep_table_ref(?a, "b", fix_b, "tag/v1.0.0"));
    if (R.is_err[str, str](override_r)) { ret 1; }
    if (bad == 0 && !t_write(?a, proj, MANIFEST, R.unwrap_ok[str, str](override_r))) { bad = 4; }
    var v1: str = "";
    if (bad == 0 && !t_git3(?a, dep_b, "checkout", "-q", "v1.0.0", "", "")) { bad = 5; }
    if (bad == 0) {
        val v1_r: R.Result[str, str] = deps.checkout_head(?s, dep_b);
        if (R.is_err[str, str](v1_r)) { bad = 5; } or { v1 = R.unwrap_ok[str, str](v1_r); }
    }
    if (bad == 0 && !t_git3(?a, dep_b, "checkout", "-q", "main", "", "")) { bad = 5; }
    if (bad == 0 && R.is_ok[str, str](before_r) && str_equals(v1, R.unwrap_ok[str, str](before_r))) { bad = 5; }
    if (bad == 0) {
        var edit: ManifestEdit;
        val txn_r: R.Result[R.Void, str] = edit_begin(?edit, ?a, proj);
        if (R.is_err[R.Void, str](txn_r)) { bad = 6; }
        or {
            val applied: i64 = update_apply(?s, ?a, proj, mode, false, "b"::*u8, true, 0);
            if (edit_finish(?edit, applied) != 0) { bad = 7; }
        }
    }
    if (bad == 0) {
        val after_r: R.Result[str, str] = deps.checkout_head(?s, dep_b);
        if (R.is_err[str, str](after_r) || !str_equals(R.unwrap_ok[str, str](after_r), v1)) { bad = 8; }
        val staged_r: R.Result[O.Option[str], str] = deps.staged_gitlink(?s, proj, "b");
        if (R.is_err[O.Option[str], str](staged_r) || O.is_none[str](R.unwrap_ok[O.Option[str], str](staged_r))
            || (R.is_ok[str, str](after_r) && !str_equals(O.unwrap[str](R.unwrap_ok[O.Option[str], str](staged_r)), R.unwrap_ok[str, str](after_r)))) { bad = 9; }
        if (verify_project(proj) != 0) { bad = 10; }
    }
    session.dnit(?s);
    fs.remove_all(?a, proj);
    fs.remove_all(?a, fix_a);
    fs.remove_all(?a, fix_b);
    ret bad;
}

test "mach.cli.cmd.dep.add:a_discovered_clash_retains_native_changes_and_releases_the_manifest_editor" {
    var a: A.Allocator;
    if (O.is_some[str](page.make(?a))) { ret 1; }
    var git_env: [4]*u8;
    t_allow_file_transport(?git_env[0]);
    fin { deps.set_git_config_env(nil); }
    val fix_b: str = t_tagged_b(?a);
    if (str_empty(fix_b)) { ret 1; }
    val fix_a: str = t_requirer_of_b(?a, "mach_dep_fix_a", "a", fix_b, "tag/v1.0.0", false);
    if (str_empty(fix_a)) { ret 1; }
    val fix_c: str = t_requirer_of_b(?a, "mach_dep_fix_c", "c", fix_b, "tag/v2.0.0", false);
    if (str_empty(fix_c)) { ret 1; }
    val proj: str = t_root_repo(?a, "mach_dep_clash_root", t_dep_table(?a, "a", fix_a));
    if (str_empty(proj)) { ret 1; }
    var bad: i32 = 0;
    if (pull_project(proj, true) != 0) { bad = 1; }
    if (bad == 0 && !t_commit_all(?a, proj)) { bad = 2; }
    var s: session.Session;
    var mode: u8 = 0;
    if (!t_session_and_mode(?a, proj, ?s, ?mode)) { ret 1; }
    var spec: manifest.DepTableSpec;
    spec.name = "c"; spec.source = manifest.DEP_SOURCE_GIT; spec.value = fix_c; spec.ref = "branch/main";
    val before: TxnSnapshot = t_snapshot(?s, ?a, proj, "c");
    var edit: ManifestEdit;
    if (bad == 0) {
        val begun: R.Result[R.Void, str] = edit_begin(?edit, ?a, proj);
        if (R.is_err[R.Void, str](begun)) { edit_finish(?edit, 1); bad = 3; }
        or {
            val applied: i64 = mutate_apply(?edit, ?s, ?a, proj, mode, ?spec, "c", true, false, true, 0);
            if (edit_finish(?edit, applied) == 0) { bad = 3; }
        }
    }
    val after: TxnSnapshot = t_snapshot(?s, ?a, proj, "c");
    if (bad == 0 && (!after.realized || !str_equals(before.manifest_text, after.manifest_text))) { bad = 4; }
    if (bad == 0) {
        val begun: R.Result[R.Void, str] = edit_begin(?edit, ?a, proj);
        if (R.is_err[R.Void, str](begun)) { edit_finish(?edit, 1); bad = 5; }
        or { if (edit_finish(?edit, 0) != 0) { bad = 5; } }
    }
    if (bad == 0 && !t_contains(after.pin, "dep/c")) { bad = 6; }
    if (bad == 0 && !t_exists_under(?a, proj, "dep/a/mach.toml")) { bad = 7; }
    session.dnit(?s);
    fs.remove_all(?a, proj);
    fs.remove_all(?a, fix_a);
    fs.remove_all(?a, fix_c);
    fs.remove_all(?a, fix_b);
    ret bad;
}

test "mach.cli.cmd.dep.pull_and_verify:a_stale_lock_file_is_noted_not_read" {
    var a: A.Allocator;
    if (O.is_some[str](page.make(?a))) { ret 1; }
    val root: str = t_scratch(?a, "mach_dep_lockfile");
    if (str_empty(root)) { ret 1; }
    if (O.is_some[str](deps.stale_lock_note(?a, root))) { fs.remove_all(?a, root); ret 1; }
    if (!t_write(?a, root, "mach.lock", "[[dep]]\n")) { fs.remove_all(?a, root); ret 1; }
    val note: O.Option[str] = deps.stale_lock_note(?a, root);
    if (O.is_none[str](note)) { fs.remove_all(?a, root); ret 2; }
    if (!t_contains(O.unwrap[str](note), "5.0.0") || !t_contains(O.unwrap[str](note), "not read")) { fs.remove_all(?a, root); ret 3; }
    if (!t_write(?a, root, MANIFEST, "[project]\nid = \"root\"\nversion = \"0.1.0\"\nsrc = \"src\"\nout = \"out\"\n")) { fs.remove_all(?a, root); ret 1; }
    if (!t_init_repo(?a, root) || !t_commit_all(?a, root)) { fs.remove_all(?a, root); ret 1; }
    val before_verify: usize = deps.stale_lock_notes_printed;
    val vrc: i64 = verify_project(root);
    if (vrc != 0)                                              { fs.remove_all(?a, root); ret 4; }
    if (deps.stale_lock_notes_printed != before_verify + 1)    { fs.remove_all(?a, root); ret 5; }
    val before_pull: usize = deps.stale_lock_notes_printed;
    val prc: i64 = pull_project(root, false);
    if (prc != 0)                                              { fs.remove_all(?a, root); ret 6; }
    if (deps.stale_lock_notes_printed != before_pull + 1)      { fs.remove_all(?a, root); ret 7; }
    val before_quiet: usize = deps.stale_lock_notes_printed;
    if (pull_project(root, true) != 0 || deps.stale_lock_notes_printed != before_quiet) { fs.remove_all(?a, root); ret 8; }
    fs.remove_all(?a, root);
    ret 0;
}


test "mach.cli.cmd.dep: generated dependency fixtures preserve TOML string values" {
    var a: A.Allocator;
    if (O.is_some[str](page.make(?a))) { ret 1; }
    val url: str = "C:\\Users\\fixture\\quoted\" repo";
    val ref: str = "branch/quoted\"\\line\nnext\tpart";
    val text: str = t_dep_table_ref(?a, "fixture", url, ref);
    if (str_empty(text)) { ret 2; }
    fin { str_free(?a, text); }
    val parsed: R.Result[toml.Table, str] = toml.parse(?a, text);
    if (R.is_err[toml.Table, str](parsed)) { ret 3; }
    var table: toml.Table = R.unwrap_ok[toml.Table, str](parsed);
    fin { toml.dnit(?a, ?table); }
    if (!str_equals(toml.get_str(?table, "dep.fixture.git"), url)) { ret 4; }
    if (!str_equals(toml.get_str(?table, "dep.fixture.ref"), ref)) { ret 5; }
    ret 0;
}


test "mach.cli.cmd.dep.edit:final_storage_refuses_copies_and_releases_manifest_coordination" {
    var a: A.Allocator;
    if (O.is_some[str](page.make(?a))) { ret 1; }
    val root: str = t_root_repo(?a, "mach_dep_manifest_owner", "");
    if (str_empty(root)) { ret 2; }
    fin { fs.remove_all(?a, root); }
    var owner: ManifestEdit;
    if (R.is_err[R.Void, str](edit_begin(?owner, ?a, root))) { edit_finish(?owner, 1); ret 3; }
    var copied: ManifestEdit = owner;
    if (edit_finish(?copied, 0) == 0) { edit_finish(?owner, 0); ret 4; }
    var second: ManifestEdit;
    val blocked: R.Result[R.Void, str] = edit_begin(?second, ?a, root);
    edit_finish(?second, 0);
    if (R.is_ok[R.Void, str](blocked)) { edit_finish(?owner, 0); ret 5; }
    if (edit_finish(?owner, 0) != 0) { ret 6; }
    if (R.is_err[R.Void, str](edit_begin(?second, ?a, root))) { edit_finish(?second, 1); ret 7; }
    if (edit_finish(?second, 0) != 0) { ret 8; }
    ret 0;
}

test "mach.cli.cmd.dep.remove:native_lock_failure_and_success_preserve_checkout_and_project_history" {
    var a: A.Allocator;
    if (O.is_some[str](page.make(?a))) { ret 1; }
    var git_env: [4]*u8;
    t_allow_file_transport(?git_env[0]);
    fin { deps.set_git_config_env(nil); }
    val fixture: str = t_package_repo(?a, "mach_dep_remove_source", "x", "");
    if (str_empty(fixture)) { ret 2; }
    fin { fs.remove_all(?a, fixture); }
    val root: str = t_root_repo(?a, "mach_dep_remove_root", t_dep_table(?a, "x", fixture));
    if (str_empty(root)) { ret 3; }
    fin { fs.remove_all(?a, root); }
    if (pull_project(root, true) != 0 || !t_commit_all(?a, root)) { ret 4; }
    if (!t_write(?a, root, "dep/x/user-work", "untracked work stays\n")) { ret 5; }
    var s: session.Session;
    var mode: u8 = 0;
    if (!t_session_and_mode(?a, root, ?s, ?mode)) { ret 6; }
    fin { session.dnit(?s); }
    val before: TxnSnapshot = t_snapshot(?s, ?a, root, "x");
    val head_r: R.Result[str, str] = deps.checkout_head(?s, root);
    if (R.is_err[str, str](head_r)) { ret 7; }
    val head: str = R.unwrap_ok[str, str](head_r);
    var spec: manifest.DepTableSpec;
    spec.name = "x";
    if (!t_write(?a, root, ".git/index.lock", "foreign native owner\n")) { ret 8; }
    var edit: ManifestEdit;
    if (R.is_err[R.Void, str](edit_begin(?edit, ?a, root))) { edit_finish(?edit, 1); ret 9; }
    val refused: i64 = mutate_apply(?edit, ?s, ?a, root, mode, ?spec, "x", false, false, true, 0);
    if (edit_finish(?edit, refused) == 0) { ret 10; }
    val after: TxnSnapshot = t_snapshot(?s, ?a, root, "x");
    if (!t_snapshot_equal(?before, ?after) || !t_exists_under(?a, root, "dep/x/user-work")) { ret 11; }
    val lock_r: R.Result[str, str] = path.join(?a, root, ".git/index.lock");
    if (R.is_err[str, str](lock_r)) { ret 12; }
    val lock_path: str = R.unwrap_ok[str, str](lock_r);
    var present: bool = false;
    if (!str_equals(t_read_or_empty(?a, lock_path, ?present), "foreign native owner\n")) { ret 13; }
    if (O.is_some[str](fs.remove_file(lock_path))) { ret 14; }
    if (R.is_err[R.Void, str](edit_begin(?edit, ?a, root))) { edit_finish(?edit, 1); ret 15; }
    val removed: i64 = mutate_apply(?edit, ?s, ?a, root, mode, ?spec, "x", false, false, true, 0);
    if (edit_finish(?edit, removed) != 0) { ret 16; }
    val finished: TxnSnapshot = t_snapshot(?s, ?a, root, "x");
    if (t_contains(finished.manifest_text, "[dep.x]") || t_contains(finished.pin, "dep/x")) { ret 17; }
    if (!t_exists_under(?a, root, "dep/x/user-work") || !t_exists_under(?a, root, "dep/x/.git")) { ret 18; }
    val unchanged_r: R.Result[str, str] = deps.checkout_head(?s, root);
    if (R.is_err[str, str](unchanged_r) || !str_equals(head, R.unwrap_ok[str, str](unchanged_r))) { ret 19; }
    ret 0;
}

test "mach.cli.cmd.dep.update:checkout_refusal_preserves_user_edits_and_late_failure_keeps_completed_checkout" {
    var a: A.Allocator;
    if (O.is_some[str](page.make(?a))) { ret 1; }
    var git_env: [4]*u8;
    t_allow_file_transport(?git_env[0]);
    fin { deps.set_git_config_env(nil); }
    val fixture: str = t_tagged_b(?a);
    if (str_empty(fixture)) { ret 2; }
    fin { fs.remove_all(?a, fixture); }
    val root: str = t_root_repo(?a, "mach_dep_update_native", t_dep_table_ref(?a, "b", fixture, "tag/v1.0.0"));
    if (str_empty(root)) { ret 3; }
    fin { fs.remove_all(?a, root); }
    if (pull_project(root, true) != 0 || !t_commit_all(?a, root)) { ret 4; }
    var s: session.Session;
    var mode: u8 = 0;
    if (!t_session_and_mode(?a, root, ?s, ?mode)) { ret 5; }
    fin { session.dnit(?s); }
    val dep_r: R.Result[str, str] = deps.dep_full_of(?a, root, "b");
    if (R.is_err[str, str](dep_r)) { ret 6; }
    val dep: str = R.unwrap_ok[str, str](dep_r);
    val original_r: R.Result[str, str] = deps.checkout_head(?s, dep);
    if (R.is_err[str, str](original_r)) { ret 7; }
    val original: str = R.unwrap_ok[str, str](original_r);
    val source: str = concat3(?a, "[project]\nid = \"root\"\nversion = \"0.1.0\"\nsrc = \"src\"\nout = \"out\"\n", "", t_dep_table_ref(?a, "b", fixture, "tag/v2.0.0"));
    if (!t_write(?a, root, MANIFEST, source) || !t_write(?a, dep, "NEWS", "untracked user content\n")) { ret 8; }
    val before: TxnSnapshot = t_snapshot(?s, ?a, root, "b");
    var edit: ManifestEdit;
    if (R.is_err[R.Void, str](edit_begin(?edit, ?a, root))) { edit_finish(?edit, 1); ret 9; }
    val refused: i64 = update_apply(?s, ?a, root, mode, false, "b", true, 0);
    if (edit_finish(?edit, refused) != 3) { ret 10; }
    val after: TxnSnapshot = t_snapshot(?s, ?a, root, "b");
    if (!t_snapshot_equal(?before, ?after)) { ret 11; }
    val news_r: R.Result[str, str] = path.join(?a, dep, "NEWS");
    if (R.is_err[str, str](news_r)) { ret 12; }
    val news: str = R.unwrap_ok[str, str](news_r);
    var present: bool = false;
    if (!str_equals(t_read_or_empty(?a, news, ?present), "untracked user content\n")) { ret 13; }
    if (O.is_some[str](fs.remove_file(news))) { ret 14; }
    if (R.is_err[R.Void, str](edit_begin(?edit, ?a, root))) { edit_finish(?edit, 1); ret 15; }
    val late: i64 = update_apply(?s, ?a, root, mode, false, "b", true, 1);
    if (edit_finish(?edit, late) != 1) { ret 16; }
    val changed_r: R.Result[str, str] = deps.checkout_head(?s, dep);
    if (R.is_err[str, str](changed_r) || str_equals(original, R.unwrap_ok[str, str](changed_r))) { ret 17; }
    val completed: TxnSnapshot = t_snapshot(?s, ?a, root, "b");
    if (!str_equals(before.pin, completed.pin) || !str_equals(before.manifest_text, completed.manifest_text)) { ret 18; }
    ret 0;
}

test "mach.cli.cmd.dep.path:unstaged_filesystem_dependency_builds_without_source_git" {
    var a: A.Allocator;
    if (O.is_some[str](page.make(?a))) { ret 1; }
    val source: str = t_scratch(?a, "mach_dep_path_source");
    if (str_empty(source)) { ret 2; }
    fin { fs.remove_all(?a, source); }
    if (!t_write(?a, source, MANIFEST, "[project]\nid = \"local\"\nversion = \"0.1.0\"\nsrc = \"src\"\nout = \"out\"\n") || !t_lib_module(?a, source)) { ret 3; }
    val root: str = t_root_repo(?a, "mach_dep_path_root", "");
    if (str_empty(root)) { ret 4; }
    fin { fs.remove_all(?a, root); }
    var s: session.Session;
    var mode: u8 = 0;
    if (!t_session_and_mode(?a, root, ?s, ?mode)) { ret 5; }
    fin { session.dnit(?s); }
    var spec: manifest.DepTableSpec;
    spec.name = "local"; spec.source = manifest.DEP_SOURCE_PATH; spec.value = source;
    var edit: ManifestEdit;
    if (R.is_err[R.Void, str](edit_begin(?edit, ?a, root))) { edit_finish(?edit, 1); ret 6; }
    val applied: i64 = mutate_apply(?edit, ?s, ?a, root, mode, ?spec, "local", true, false, true, 0);
    if (edit_finish(?edit, applied) != 0) { ret 7; }
    val staged: R.Result[str, str] = deps.staged_paths(?s, root, "dep/local");
    if (R.is_err[str, str](staged) || !str_empty(R.unwrap_ok[str, str](staged))) { ret 8; }
    if (verify_project(root) != 0 || !t_build_ok(?s, root)) { ret 9; }
    if (t_exists_under(?a, source, ".git") || t_exists_under(?a, root, "dep/local/.git")) { ret 10; }
    val copied_r: R.Result[str, str] = deps.dep_full_of(?a, root, "local");
    if (R.is_err[str, str](copied_r)) { ret 11; }
    val copied: str = R.unwrap_ok[str, str](copied_r);
    fin { str_free(?a, copied); }
    if (O.is_some[str](fs.remove_all(?a, copied))) { ret 12; }
    var reqs: Vector[DepReq] = vector.init[DepReq](?a);
    fin { free_requests(?a, ?reqs); }
    if (realize_closure(?s, ?a, root, ?reqs, true, false, nil) != 0) { ret 13; }
    if (verify_project(root) != 0 || !t_build_ok(?s, root)) { ret 14; }
    ret 0;
}
