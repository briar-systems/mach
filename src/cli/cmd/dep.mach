test "mach.cli.cmd.dep.update:the_roots_exact_selector_repins_an_identity_realized_at_a_dependencys_commit" {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    var git_env: [4]*u8;
    t_allow_file_transport(?git_env[0]);
    fin { deps.set_git_config_env(nil); }
    val fix_b: str = t_tagged_b(?a);
    if (str_empty(fix_b)) { ret 1; }
    val fix_a: str = t_requirer_of_b(?a, "mach_dep_fix_a", "a", fix_b, "branch/main", true);
    if (str_empty(fix_a)) { ret 1; }
    val proj: str = t_root_repo(?a, "mach_dep_update_root", t_dep_table(?a, "a", fix_a));
    if (str_empty(proj)) { ret 1; }
    var bad: i32 = 0;
    if (pull_project(proj, true) != 0)       { bad = 1; }
    if (bad == 0 && !t_commit_all(?a, proj)) { bad = 2; }
    var s:    session.Session;
    var mode: u8 = 0;
    if (!t_session_and_mode(?a, proj, ?s, ?mode)) { ret 1; }
    val dep_b_r: res[str, A.Error] = path.join(?a, proj, "dep/b");
    if (sel dep_b_r.err) { ret 1; }
    val dep_b:    str                    = dep_b_r.ok;
    val before_r: res[str, outcome.Fail] = deps.checkout_head(?s, dep_b);
    if (sel before_r.err) { ret 99; }
    val override_r: res[str, format.FormatError] = format.sprint(?a,
        "[project]\nid = \"root\"\nversion = \"0.1.0\"\nsrc = \"src\"\nout = \"out\"\n\n[target.host]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[artifact.root]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/root\"\ntargets = [\"*\"]\nlink = []\nneed = []\n{}{}\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n",
        t_dep_table(?a, "a", fix_a), t_dep_table_ref(?a, "b", fix_b, "tag/v1.0.0"));
    if (sel override_r.err)                                      { ret 1; }
    if (bad == 0 && !t_write(?a, proj, MANIFEST, override_r.ok)) { bad = 4; }
    var v1: str = "";
    if (bad == 0 && !t_git3(?a, dep_b, "checkout", "-q", "v1.0.0", "", "")) { bad = 5; }
    if (bad == 0) {
        val v1_r: res[str, outcome.Fail] = deps.checkout_head(?s, dep_b);
        if (sel v1_r.err) { bad = 5; }
        if (sel v1_r.ok)  { v1 = v1_r.ok; }
    }
    if (bad == 0 && !t_git3(?a, dep_b, "checkout", "-q", "main", "", "")) { bad = 5; }
    if (bad == 0 && sel before_r.ok && str_equals(v1, before_r.ok))       { bad = 5; }
    if (bad == 0) {
        var edit:  ManifestEdit;
        val txn_r: err[outcome.Fail] = edit_begin(?edit, ?a, proj);
        if (sel txn_r.err) { bad = 6; }
        if (sel txn_r.ok) {
            val applied: i64 = update_apply(?s, ?a, proj, mode, false, "b"::*u8, true, 0, false, false);
            if (edit_finish(?edit, applied) != 0) { bad = 7; }
        }
    }
    if (bad == 0) {
        val after_r: res[str, outcome.Fail] = deps.checkout_head(?s, dep_b);
        if (sel after_r.err)                                 { ret 99; }
        if (!(sel after_r.ok && str_equals(after_r.ok, v1))) { bad = 8; }
        val staged_r: res[opt[str], outcome.Fail] = deps.staged_gitlink(?s, proj, "b");
        if (sel staged_r.err) { bad = 9; }
        if (sel staged_r.ok) {
            if (sel staged_r.ok.none) { bad = 9; }
            if (sel staged_r.ok.some) {
                if (sel after_r.ok && !str_equals(staged_r.ok.some, after_r.ok)) { bad = 9; }
            }
        }
        if (verify_project(proj, false) != 0) { bad = 10; }
    }
    session.dnit(?s);
    fs.remove_all(?a, proj);
    fs.remove_all(?a, fix_a);
    fs.remove_all(?a, fix_b);
    ret bad;
}

# the refusal verify reports for a project, or "" when it verifies
fun t_verify_refusal(a: *A.Allocator, root: str) str {
    var s:    session.Session;
    var mode: u8 = 0;
    if (!t_session_and_mode(a, root, ?s, ?mode)) { ret ""; }
    fin { session.dnit(?s); }
    val vr: err[outcome.Fail] = driver.verify_dependencies(?s, root, false, nil);
    if (sel vr.ok) { ret ""; }
    ret own(a, outcome.describe(vr.err));
}

# run the `mach dep update ...` remedy a refusal names, with `<path>` as root
fun t_run_remedy(a: *A.Allocator, refusal: str, root: str) i64 {
    val at: opt[str] = str_find(refusal, "run `mach dep update ");
    if (sel at.none) { ret -1; }
    var buf:   [128]u8;
    var av:    [8]*u8;
    var n:     usize = 0;
    var k:     usize = 0;
    val src:   str   = (?at.some[5])::str;
    var fresh: bool  = true;
    for (src[k] != 0 && src[k] != '`' && k < 127) {
        if (src[k] == ' ') {
            buf[k] = 0;
            fresh  = true;
        }
        or {
            buf[k] = src[k];
            if (fresh) {
                if (n == 8) { ret -1; }
                av[n] = ?buf[k];
                n     = n + 1;
                fresh = false;
            }
        }
        k = k + 1;
    }
    buf[k] = 0;
    if (n != 5 || !str_equals(av[3]::str, "<path>")) { ret -1; }
    av[3] = root::*u8;
    ret t_dep_cli(a, n, ?av[0]);
}

test "mach.cli.cmd.dep.update:the_remedy_verify_prints_for_a_stale_transitive_checkout_repins_it" {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    var git_env: [4]*u8;
    t_allow_file_transport(?git_env[0]);
    fin { deps.set_git_config_env(nil); }
    val fix_b: str = t_tagged_b(?a);
    if (str_empty(fix_b)) { ret 2; }
    fin { fs.remove_all(?a, fix_b); }
    val fix_a: str = t_requirer_of_b(?a, "mach_dep_fix_a", "a", fix_b, "tag/v1.0.0", false);
    if (str_empty(fix_a)) { ret 3; }
    fin { fs.remove_all(?a, fix_a); }
    val proj: str = t_root_repo(?a, "mach_dep_remedy_root", t_dep_table(?a, "a", fix_a));
    if (str_empty(proj)) { ret 4; }
    fin { fs.remove_all(?a, proj); }
    if (pull_project(proj, true) != 0 || !t_commit_all(?a, proj)) { ret 5; }
    val pinned: str = t_head_under(?a, proj, "dep/b");
    if (str_empty(pinned)) { ret 6; }
    val dep_b: str = t_join_owned(?a, proj, "dep/b");
    if (!t_git3(?a, dep_b, "checkout", "-q", "v2.0.0", "", "")) { ret 7; }
    if (!t_git3(?a, proj, "add", "dep/b", "", "", ""))          { ret 7; }
    val refusal: str = t_verify_refusal(?a, proj);
    if (!t_contains(refusal, "exact ref 'tag/v1.0.0' required by root -> a -> b")) { ret 8; }
    if (!t_contains(refusal, "run `mach dep update <path> b`"))                    { ret 9; }
    if (t_run_remedy(?a, refusal, proj) != 0)                                      { ret 10; }
    if (!str_equals(t_head_under(?a, proj, "dep/b"), pinned))                      { ret 11; }
    if (verify_project(proj, false) != 0)                                          { ret 12; }
    ret 0;
}

test "mach.cli.cmd.dep.update:a_root_declared_name_and_all_advance_only_the_roots_selectors" {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    var git_env: [4]*u8;
    t_allow_file_transport(?git_env[0]);
    fin { deps.set_git_config_env(nil); }
    val fix_b: str = t_tagged_b(?a);
    if (str_empty(fix_b)) { ret 2; }
    fin { fs.remove_all(?a, fix_b); }
    val fix_a: str = t_requirer_of_b(?a, "mach_dep_fix_a", "a", fix_b, "tag/v1.0.0", false);
    if (str_empty(fix_a)) { ret 3; }
    fin { fs.remove_all(?a, fix_a); }
    val proj: str = t_root_repo(?a, "mach_dep_update_declared", t_dep_table(?a, "a", fix_a));
    if (str_empty(proj)) { ret 4; }
    fin { fs.remove_all(?a, proj); }
    if (pull_project(proj, true) != 0 || !t_commit_all(?a, proj)) { ret 5; }
    val a_before: str = t_head_under(?a, proj, "dep/a");
    val b_before: str = t_head_under(?a, proj, "dep/b");
    if (str_empty(a_before) || str_empty(b_before)) { ret 6; }

    if (!t_write(?a, fix_a, "NEWS", "second\n") || !t_commit_all(?a, fix_a)) { ret 7; }
    if (t_dep_cli_edit(?a, "update", proj, "a", "") != 0)                    { ret 8; }
    val a_named: str = t_head_under(?a, proj, "dep/a");
    if (str_empty(a_named) || str_equals(a_named, a_before))    { ret 9; }
    if (!str_equals(t_head_under(?a, proj, "dep/b"), b_before)) { ret 10; }
    if (verify_project(proj, false) != 0)                       { ret 11; }

    if (!t_write(?a, fix_a, "NEWS", "third\n") || !t_commit_all(?a, fix_a)) { ret 12; }
    var av: [6]*u8;
    av[0] = "mach"::*u8;
    av[1] = "dep"::*u8;
    av[2] = "update"::*u8;
    av[3] = proj::*u8;
    av[4] = "--all"::*u8;
    av[5] = "--quiet"::*u8;
    if (t_dep_cli(?a, 6, ?av[0]) != 0) { ret 13; }
    val a_all: str = t_head_under(?a, proj, "dep/a");
    if (str_empty(a_all) || str_equals(a_all, a_named))         { ret 14; }
    if (!str_equals(t_head_under(?a, proj, "dep/b"), b_before)) { ret 15; }
    if (verify_project(proj, false) != 0)                       { ret 16; }
    ret 0;
}

test "mach.cli.cmd.dep.update:a_name_outside_the_closure_is_refused" {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    var git_env: [4]*u8;
    t_allow_file_transport(?git_env[0]);
    fin { deps.set_git_config_env(nil); }
    val fix_b: str = t_tagged_b(?a);
    if (str_empty(fix_b)) { ret 2; }
    fin { fs.remove_all(?a, fix_b); }
    val fix_a: str = t_requirer_of_b(?a, "mach_dep_fix_a", "a", fix_b, "tag/v1.0.0", false);
    if (str_empty(fix_a)) { ret 3; }
    fin { fs.remove_all(?a, fix_a); }
    val proj: str = t_root_repo(?a, "mach_dep_update_outside", t_dep_table(?a, "a", fix_a));
    if (str_empty(proj)) { ret 4; }
    fin { fs.remove_all(?a, proj); }
    if (pull_project(proj, true) != 0 || !t_commit_all(?a, proj)) { ret 5; }
    val before_r: res[str, outcome.Fail] = t_read_under(?a, proj, MANIFEST);
    if (sel before_r.err) { ret 6; }
    # a stray directory under dep/ does not put its name in the closure
    val ghost: str             = t_join_owned(?a, proj, "dep/ghost");
    val mkdir: err[fs.FsError] = fs.create_dir_all(?a, ghost, 0o755);
    if (sel mkdir.err)                                        { ret 7; }
    if (t_dep_cli_edit(?a, "update", proj, "nope", "") != 1)  { ret 8; }
    if (t_dep_cli_edit(?a, "update", proj, "ghost", "") != 1) { ret 9; }
    val after_r: res[str, outcome.Fail] = t_read_under(?a, proj, MANIFEST);
    if (sel after_r.err)                      { ret 10; }
    if (!str_equals(before_r.ok, after_r.ok)) { ret 11; }
    ret 0;
}

fun t_head_under(a: *A.Allocator, root: str, rel: str) str {
    var s:    session.Session;
    var mode: u8 = 0;
    if (!t_session_and_mode(a, root, ?s, ?mode)) { ret ""; }
    fin { session.dnit(?s); }
    val head_r: res[str, outcome.Fail] = deps.checkout_head(?s, t_join_owned(a, root, rel));
    if (sel head_r.err) { ret ""; }
    ret own(a, head_r.ok);
}

test "mach.cli.cmd.dep.add:a_discovered_clash_retains_native_changes_and_releases_the_manifest_editor" {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    var git_env: [4]*u8;
    t_allow_file_transport(?git_env[0]);
    fin { deps.set_git_config_env(nil); }
    val fix_b: str = t_tagged_b(?a);
    if (str_empty(fix_b)) { ret 1; }
    val fix_a: str = t_requirer_of_b(?a, "mach_dep_fix_a", "a", fix_b, "tag/v1.0.0", false);
    if (str_empty(fix_a)) { ret 1; }
    val fix_c: str = t_requirer_of_b(?a, "mach_dep_fix_c", "c", fix_b, "tag/v2.0.0", false);
    if (str_empty(fix_c)) { ret 1; }
    val proj: str = t_root_repo(?a, "mach_dep_clash_root", t_dep_table(?a, "a", fix_a));
    if (str_empty(proj)) { ret 1; }
    var bad: i32 = 0;
    if (pull_project(proj, true) != 0)       { bad = 1; }
    if (bad == 0 && !t_commit_all(?a, proj)) { bad = 2; }
    var s:    session.Session;
    var mode: u8 = 0;
    if (!t_session_and_mode(?a, proj, ?s, ?mode)) { ret 1; }
    var spec: manifest.DepTableSpec;
    spec.name   = "c";
    spec.source = manifest.DEP_SOURCE_GIT;
    spec.value  = fix_c;
    spec.ref    = "branch/main";
    val before: TxnSnapshot = t_snapshot(?s, ?a, proj, "c");
    var edit:   ManifestEdit;
    if (bad == 0) {
        val begun: err[outcome.Fail] = edit_begin(?edit, ?a, proj);
        if (sel begun.err) {
            edit_finish(?edit, 1);
            bad = 3;
        }
        if (sel begun.ok) {
            val applied: i64 = mutate_apply(?edit, ?s, ?a, proj, mode, ?spec, "c", true, false, true, 0);
            if (edit_finish(?edit, applied) == 0) { bad = 3; }
        }
    }
    val after: TxnSnapshot = t_snapshot(?s, ?a, proj, "c");
    if (bad == 0 && (!after.realized || !str_equals(before.manifest_text, after.manifest_text))) { bad = 4; }
    if (bad == 0) {
        val begun: err[outcome.Fail] = edit_begin(?edit, ?a, proj);
        if (sel begun.err) {
            edit_finish(?edit, 1);
            bad = 5;
        }
        if (sel begun.ok) {
            if (edit_finish(?edit, 0) != 0) { bad = 5; }
        }
    }
    if (bad == 0 && !t_contains(after.pin, "dep/c"))              { bad = 6; }
    if (bad == 0 && !t_exists_under(?a, proj, "dep/a/mach.toml")) { bad = 7; }
    session.dnit(?s);
    fs.remove_all(?a, proj);
    fs.remove_all(?a, fix_a);
    fs.remove_all(?a, fix_c);
    fs.remove_all(?a, fix_b);
    ret bad;
}

# the build refusal text of a dependency-shaped failure, or "" when the build succeeds
fun t_build_refusal(s: *session.Session, root: str) str {
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) { ret ""; }
    var pick: manifest.Selection;
    pick.target       = "";
    pick.profile      = "";
    pick.artifact     = "";
    pick.want_lib     = false;
    pick.has_artifact = false;
    val pr: res[project.Project, outcome.Fail] = driver.build_project_sel(s, root, ?pick);
    if (sel pr.err) { ret outcome.describe(pr.err); }
    var p: project.Project = pr.ok;
    project.dnit_project(?p);
    ret "";
}

# a `mach.lock` in the project root is an unrelated file: verify, pull and the
# build never read it
test "mach.cli.cmd.dep.pull_and_verify:a_lock_file_in_the_root_is_ignored" {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val root: str = t_root_repo(?a, "mach_dep_lockfile", "");
    if (str_empty(root)) { ret 1; }
    if (!t_write(?a, root, "mach.lock", "[[dep]]\n")) {
        fs.remove_all(?a, root);
        ret 1;
    }
    if (verify_project(root, false) != 0) {
        fs.remove_all(?a, root);
        ret 2;
    }
    if (pull_project(root, true) != 0) {
        fs.remove_all(?a, root);
        ret 3;
    }
    var s:    session.Session;
    var mode: u8 = 0;
    if (!t_session_and_mode(?a, root, ?s, ?mode)) {
        fs.remove_all(?a, root);
        ret 1;
    }
    val refusal: str = t_build_refusal(?s, root);
    session.dnit(?s);
    fs.remove_all(?a, root);
    if (!str_empty(refusal)) { ret 4; }
    ret 0;
}

# a realized dep/<id>/dep/<x>/ is refused by verify and by the build, while
# git's empty gitlink directory passes
test "mach.cli.cmd.dep.verify:a_nested_realization_is_refused_and_an_empty_gitlink_directory_is_not" {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    var git_env: [4]*u8;
    t_allow_file_transport(?git_env[0]);
    fin { deps.set_git_config_env(nil); }
    val fix_b: str = t_tagged_b(?a);
    if (str_empty(fix_b)) { ret 1; }
    val fix_a: str = t_requirer_of_b(?a, "mach_dep_fix_a", "a", fix_b, "branch/main", true);
    if (str_empty(fix_a)) { ret 1; }
    val proj: str = t_root_repo(?a, "mach_dep_nested_root", "");
    if (str_empty(proj)) { ret 1; }
    var s:    session.Session;
    var mode: u8 = 0;
    if (!t_session_and_mode(?a, proj, ?s, ?mode)) { ret 1; }
    var bad:  i32 = 0;
    var spec: manifest.DepTableSpec;
    spec.name   = "a";
    spec.source = manifest.DEP_SOURCE_GIT;
    spec.value  = fix_a;
    spec.ref    = "branch/main";
    var edit:  ManifestEdit;
    val txn_r: err[outcome.Fail] = edit_begin(?edit, ?a, proj);
    if (sel txn_r.err) { bad = 1; }
    if (sel txn_r.ok) {
        val applied: i64 = mutate_apply(?edit, ?s, ?a, proj, mode, ?spec, "a", true, false, true, 0);
        if (edit_finish(?edit, applied) != 0) { bad = 2; }
    }
    # the consumed dependency's own gitlink is an empty directory: not a realization
    if (bad == 0 && !t_exists_under(?a, proj, "dep/a/dep/b"))          { bad = 3; }
    if (bad == 0 && t_exists_under(?a, proj, "dep/a/dep/b/mach.toml")) { bad = 4; }
    if (bad == 0 && verify_project(proj, false) != 0)                  { bad = 5; }
    if (bad == 0) {
        val nested_dir: str = t_join_owned(?a, proj, "dep/a/dep/b");
        if (!t_write(?a, nested_dir, MANIFEST, "[project]\nid = \"b\"\nversion = \"0.1.0\"\nsrc = \"src\"\nout = \"out\"\n")) { bad = 6; }
    }
    if (bad == 0 && verify_project(proj, false) == 0) { bad = 7; }
    if (bad == 0) {
        val refusal: str = t_build_refusal(?s, proj);
        if (!t_contains(refusal, "dep/a/dep/b is a nested realization"))                            { bad = 8; }
        if (!t_contains(refusal, "a dependency's own dep/ is never realized, so delete dep/a/dep")) { bad = 9; }
    }
    if (bad == 0) {
        val removed: err[io_error.Error] = fs.remove_file(t_join_owned(?a, proj, "dep/a/dep/b/mach.toml"));
        if (sel removed.err) { bad = 10; }
    }
    if (bad == 0 && verify_project(proj, false) != 0) { bad = 11; }
    if (bad == 0 && !t_build_ok(?s, proj))            { bad = 12; }
    session.dnit(?s);
    fs.remove_all(?a, proj);
    fs.remove_all(?a, fix_a);
    fs.remove_all(?a, fix_b);
    ret bad;
}

# a dep key that is not the project's id is refused by pull, verify and the
# build, naming the one-name rule
test "mach.cli.cmd.dep.pull:an_alias_key_is_refused_naming_the_one_name_rule" {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val source: str = t_scratch(?a, "mach_dep_alias_source");
    if (str_empty(source)) { ret 2; }
    fin { fs.remove_all(?a, source); }
    if (!t_write(?a, source, MANIFEST, "[project]\nid = \"local\"\nversion = \"0.1.0\"\nsrc = \"src\"\nout = \"out\"\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n") || !t_lib_module(?a, source)) { ret 3; }
    val table: str = t_dep_table_path(?a, "alias", source);
    if (str_empty(table)) { ret 4; }
    val root: str = t_root_repo(?a, "mach_dep_alias_root", table);
    if (str_empty(root)) { ret 5; }
    fin { fs.remove_all(?a, root); }
    var s:    session.Session;
    var mode: u8 = 0;
    if (!t_session_and_mode(?a, root, ?s, ?mode)) { ret 6; }
    fin { session.dnit(?s); }
    if (pull_project(root, true) == 0) { ret 7; }
    # pull rolled the refused realization back; a hand-realized dep/alias is refused
    # by verify and by the build all the same
    val realized: str             = t_join_owned(?a, root, "dep/alias");
    val mkdir_r:  err[fs.FsError] = fs.create_dir_all(?a, realized, 0o755);
    if (sel mkdir_r.err)                                                                                                                                                                                                                                                                                                                                                                     { ret 8; }
    if (!t_write(?a, realized, MANIFEST, "[project]\nid = \"local\"\nversion = \"0.1.0\"\nsrc = \"src\"\nout = \"out\"\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n") || !t_lib_module(?a, realized)) { ret 8; }
    if (verify_project(root, false) == 0)                                                                                                                                                                                                                                                                                                                                                    { ret 9; }
    val refusal: str = t_build_refusal(?s, root);
    if (!t_contains(refusal, "[dep.alias] realizes project 'local': the manifest key, the directory under dep/, and the project id are one name")) { ret 10; }
    if (!t_contains(refusal, "rename the table to [dep.local] and the directory to dep/local"))                                                    { ret 11; }
    ret 0;
}

test "mach.cli.cmd.dep: generated dependency fixtures preserve TOML string values" {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val url:  str = "C:\\Users\\fixture\\quoted\" repo";
    val ref:  str = "branch/quoted\"\\line\nnext\tpart";
    val text: str = t_dep_table_ref(?a, "fixture", url, ref);
    if (str_empty(text)) { ret 2; }
    fin { str_free(?a, text); }
    val parsed: res[toml.Table, toml.TomlError] = toml.parse(?a, text);
    if (sel parsed.err) { ret 3; }
    var table: toml.Table = parsed.ok;
    fin { toml.dnit(?a, ?table); }
    if (!str_equals(key_text(?table, "dep.fixture.git"), url)) { ret 4; }
    if (!str_equals(key_text(?table, "dep.fixture.ref"), ref)) { ret 5; }
    ret 0;
}

fun t_read_under(a: *A.Allocator, root: str, rel: str) res[str, outcome.Fail] {
    val joined: res[str, A.Error] = path.join(a, root, rel);
    if (sel joined.err) { ret res[str, outcome.Fail].err{outcome.refused(joined.err)}; }
    val full: str = joined.ok;
    fin { str_free(a, full); }
    val read_string_r: res[str, fs.FsError] = fs.read_string(a, full);
    if (sel read_string_r.err) { ret res[str, outcome.Fail].err{outcome.user(outcome.fs_text(read_string_r.err))}; }
    ret res[str, outcome.Fail].ok{read_string_r.ok};
}

fun t_project_history_unchanged(s: *session.Session, a: *A.Allocator, root: str,
    head: str, head_ref: str, head_log: str, branch_log: str, staged_user: str) bool {
    val actual_head_r: res[str, outcome.Fail] = deps.checkout_head(s, root);
    if (sel actual_head_r.err) { ret false; }
    val actual_head: str = actual_head_r.ok;
    fin { str_free(a, actual_head); }
    if (!str_equals(head, actual_head)) { ret false; }
    val actual_ref_r: res[str, outcome.Fail] = t_read_under(a, root, ".git/HEAD");
    if (sel actual_ref_r.err) { ret false; }
    val actual_ref: str = actual_ref_r.ok;
    fin { str_free(a, actual_ref); }
    if (!str_equals(head_ref, actual_ref)) { ret false; }
    val actual_log_r: res[str, outcome.Fail] = t_read_under(a, root, ".git/logs/HEAD");
    if (sel actual_log_r.err) { ret false; }
    val actual_log: str = actual_log_r.ok;
    fin { str_free(a, actual_log); }
    if (!str_equals(head_log, actual_log)) { ret false; }
    val branch_r: res[str, outcome.Fail] = t_read_under(a, root, ".git/logs/refs/heads/main");
    if (sel branch_r.err) { ret false; }
    val actual_branch: str = branch_r.ok;
    fin { str_free(a, actual_branch); }
    if (!str_equals(branch_log, actual_branch)) { ret false; }
    val actual_stage_r: res[str, outcome.Fail] = deps.staged_paths(s, root, "user-history");
    if (sel actual_stage_r.err) { ret false; }
    val actual_stage: str = actual_stage_r.ok;
    fin { str_free(a, actual_stage); }
    if (!str_equals(staged_user, actual_stage)) { ret false; }
    val work_r: res[str, outcome.Fail] = t_read_under(a, root, "user-history");
    if (sel work_r.err) { ret false; }
    val work: str = work_r.ok;
    fin { str_free(a, work); }
    ret str_equals(work, "unstaged user data\n");
}

test "mach.cli.cmd.dep.remove:native_lock_failure_and_success_preserve_checkout_and_project_history" {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    var git_env: [4]*u8;
    t_allow_file_transport(?git_env[0]);
    fin { deps.set_git_config_env(nil); }
    val fixture: str = t_package_repo(?a, "mach_dep_remove_source", "x", "");
    if (str_empty(fixture)) { ret 2; }
    fin { fs.remove_all(?a, fixture); }
    val root: str = t_root_repo(?a, "mach_dep_remove_root", "");
    if (str_empty(root)) { ret 3; }
    fin { fs.remove_all(?a, root); }
    if (!t_write(?a, root, "user-history", "committed user data\n") || !t_commit_all(?a, root)) { ret 4; }
    if (!t_write(?a, root, "user-history", "staged user data\n") ||
        !t_git3(?a, root, "add", "--", "user-history", "", "") ||
        !t_write(?a, root, "user-history", "unstaged user data\n")) { ret 5; }
    var s:    session.Session;
    var mode: u8 = 0;
    if (!t_session_and_mode(?a, root, ?s, ?mode)) { ret 6; }
    fin { session.dnit(?s); }
    val head_r: res[str, outcome.Fail] = deps.checkout_head(?s, root);
    if (sel head_r.err) { ret 7; }
    val head: str = head_r.ok;
    fin { str_free(?a, head); }
    val ref_r:    res[str, outcome.Fail] = t_read_under(?a, root, ".git/HEAD");
    val log_r:    res[str, outcome.Fail] = t_read_under(?a, root, ".git/logs/HEAD");
    val branch_r: res[str, outcome.Fail] = t_read_under(?a, root, ".git/logs/refs/heads/main");
    val staged_r: res[str, outcome.Fail] = deps.staged_paths(?s, root, "user-history");
    if (sel ref_r.err)    { ret 20; }
    if (sel log_r.err)    { ret 20; }
    if (sel branch_r.err) { ret 20; }
    if (sel staged_r.err) { ret 20; }
    val head_ref:    str = ref_r.ok;
    val head_log:    str = log_r.ok;
    val branch_log:  str = branch_r.ok;
    val staged_user: str = staged_r.ok;
    fin {
        str_free(?a, head_ref);
        str_free(?a, head_log);
        str_free(?a, branch_log);
        str_free(?a, staged_user);
    }
    if (str_empty(head_ref) || str_empty(head_log) || str_empty(branch_log) || str_empty(staged_user)) { ret 21; }
    var spec: manifest.DepTableSpec;
    spec.name   = "x";
    spec.source = manifest.DEP_SOURCE_GIT;
    spec.value  = fixture;
    spec.ref    = "branch/main";
    var edit: ManifestEdit;
    var av:   [10]*u8;
    av[0] = "mach"::*u8;
    av[1] = "dep"::*u8;
    av[2] = "add"::*u8;
    av[3] = root::*u8;
    av[4] = "x"::*u8;
    av[5] = "--git"::*u8;
    av[6] = fixture::*u8;
    av[7] = "--ref"::*u8;
    av[8] = "branch/main"::*u8;
    av[9] = "--quiet"::*u8;
    if (t_dep_cli(?a, 10, ?av[0]) != 0)                                                                { ret 23; }
    if (!t_project_history_unchanged(?s, ?a, root, head, head_ref, head_log, branch_log, staged_user)) { ret 24; }
    val added_state: TxnSnapshot = t_snapshot(?s, ?a, root, "x");
    if (!t_contains(added_state.manifest_text, "[dep.x]") || !t_contains(added_state.pin, "dep/x")) { ret 25; }
    if (!t_write(?a, fixture, "NEWS", "new dependency revision\n") || !t_commit_all(?a, fixture))   { ret 26; }
    av[2] = "update"::*u8;
    av[5] = "--quiet"::*u8;
    if (t_dep_cli(?a, 6, ?av[0]) != 0)                                                                 { ret 28; }
    if (!t_project_history_unchanged(?s, ?a, root, head, head_ref, head_log, branch_log, staged_user)) { ret 29; }
    val before: TxnSnapshot = t_snapshot(?s, ?a, root, "x");
    if (str_equals(added_state.pin, before.pin))                         { ret 30; }
    if (!t_write(?a, root, "dep/x/user-work", "untracked work stays\n")) { ret 31; }
    if (!t_write(?a, root, ".git/index.lock", "foreign native owner\n")) { ret 8; }
    val edit_begin_r: err[outcome.Fail] = edit_begin(?edit, ?a, root);
    if (sel edit_begin_r.err) {
        edit_finish(?edit, 1);
        ret 9;
    }
    val refused: i64 = mutate_apply(?edit, ?s, ?a, root, mode, ?spec, "x", false, false, true, 0);
    if (edit_finish(?edit, refused) == 0) { ret 10; }
    val after: TxnSnapshot = t_snapshot(?s, ?a, root, "x");
    if (!t_snapshot_equal(?before, ?after) || !t_exists_under(?a, root, "dep/x/user-work")) { ret 11; }
    val lock_r: res[str, A.Error] = path.join(?a, root, ".git/index.lock");
    if (sel lock_r.err) { ret 12; }
    val lock_path: str  = lock_r.ok;
    var present:   bool = false;
    if (!str_equals(t_read_or_empty(?a, lock_path, ?present), "foreign native owner\n")) { ret 13; }
    val remove_file_r: err[io_error.Error] = fs.remove_file(lock_path);
    if (sel remove_file_r.err) { ret 14; }
    av[2] = "remove"::*u8;
    if (t_dep_cli(?a, 6, ?av[0]) != 0) { ret 16; }
    val finished: TxnSnapshot = t_snapshot(?s, ?a, root, "x");
    if (t_contains(finished.manifest_text, "[dep.x]") || t_contains(finished.pin, "dep/x"))            { ret 17; }
    if (!t_exists_under(?a, root, "dep/x/user-work") || !t_exists_under(?a, root, "dep/x/.git"))       { ret 18; }
    if (!t_project_history_unchanged(?s, ?a, root, head, head_ref, head_log, branch_log, staged_user)) { ret 19; }
    ret 0;
}

test "mach.cli.cmd.dep.update:checkout_refusal_preserves_user_edits_and_late_failure_keeps_completed_checkout" {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    var git_env: [4]*u8;
    t_allow_file_transport(?git_env[0]);
    fin { deps.set_git_config_env(nil); }
    val fixture: str = t_tagged_b(?a);
    if (str_empty(fixture)) { ret 2; }
    fin { fs.remove_all(?a, fixture); }
    val root: str = t_root_repo(?a, "mach_dep_update_native", t_dep_table_ref(?a, "b", fixture, "tag/v1.0.0"));
    if (str_empty(root)) { ret 3; }
    fin { fs.remove_all(?a, root); }
    if (pull_project(root, true) != 0 || !t_commit_all(?a, root)) { ret 4; }
    var s:    session.Session;
    var mode: u8 = 0;
    if (!t_session_and_mode(?a, root, ?s, ?mode)) { ret 5; }
    fin { session.dnit(?s); }
    val dep_r: res[str, outcome.Fail] = deps.dep_full_of(?a, root, "b");
    if (sel dep_r.err) { ret 6; }
    val dep:        str                    = dep_r.ok;
    val original_r: res[str, outcome.Fail] = deps.checkout_head(?s, dep);
    if (sel original_r.err) { ret 7; }
    val original: str = original_r.ok;
    val source:   str = concat3(?a, "[project]\nid = \"root\"\nversion = \"0.1.0\"\nsrc = \"src\"\nout = \"out\"\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n", "", t_dep_table_ref(?a, "b", fixture, "tag/v2.0.0"));
    if (!t_write(?a, root, MANIFEST, source) || !t_write(?a, dep, "NEWS", "untracked user content\n")) { ret 8; }
    val before:       TxnSnapshot       = t_snapshot(?s, ?a, root, "b");
    var edit:         ManifestEdit;
    val edit_begin_r: err[outcome.Fail] = edit_begin(?edit, ?a, root);
    if (sel edit_begin_r.err) {
        edit_finish(?edit, 1);
        ret 9;
    }
    val refused: i64 = update_apply(?s, ?a, root, mode, false, "b", true, 0, false, false);
    if (edit_finish(?edit, refused) != 3) { ret 10; }
    val after: TxnSnapshot = t_snapshot(?s, ?a, root, "b");
    if (!t_snapshot_equal(?before, ?after)) { ret 11; }
    val news_r: res[str, A.Error] = path.join(?a, dep, "NEWS");
    if (sel news_r.err) { ret 12; }
    val news:    str  = news_r.ok;
    var present: bool = false;
    if (!str_equals(t_read_or_empty(?a, news, ?present), "untracked user content\n")) { ret 13; }
    val remove_file_r: err[io_error.Error] = fs.remove_file(news);
    if (sel remove_file_r.err) { ret 14; }
    val edit_begin_r2: err[outcome.Fail] = edit_begin(?edit, ?a, root);
    if (sel edit_begin_r2.err) {
        edit_finish(?edit, 1);
        ret 15;
    }
    val late: i64 = update_apply(?s, ?a, root, mode, false, "b", true, 1, false, false);
    if (edit_finish(?edit, late) != 1) { ret 16; }
    val changed_r: res[str, outcome.Fail] = deps.checkout_head(?s, dep);
    if (sel changed_r.err)                  { ret 17; }
    if (str_equals(original, changed_r.ok)) { ret 17; }
    val completed: TxnSnapshot = t_snapshot(?s, ?a, root, "b");
    if (!str_equals(before.pin, completed.pin) || !str_equals(before.manifest_text, completed.manifest_text)) { ret 18; }
    ret 0;
}

test "mach.cli.cmd.dep.path:unstaged_filesystem_dependency_builds_without_source_git" {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val source: str = t_scratch(?a, "mach_dep_path_source");
    if (str_empty(source)) { ret 2; }
    fin { fs.remove_all(?a, source); }
    if (!t_write(?a, source, MANIFEST, "[project]\nid = \"local\"\nversion = \"0.1.0\"\nsrc = \"src\"\nout = \"out\"\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n") || !t_lib_module(?a, source)) { ret 3; }
    val root: str = t_root_repo(?a, "mach_dep_path_root", "");
    if (str_empty(root)) { ret 4; }
    fin { fs.remove_all(?a, root); }
    var s:    session.Session;
    var mode: u8 = 0;
    if (!t_session_and_mode(?a, root, ?s, ?mode)) { ret 5; }
    fin { session.dnit(?s); }
    var spec: manifest.DepTableSpec;
    spec.name   = "local";
    spec.source = manifest.DEP_SOURCE_PATH;
    spec.value  = source;
    var edit:         ManifestEdit;
    val edit_begin_r: err[outcome.Fail] = edit_begin(?edit, ?a, root);
    if (sel edit_begin_r.err) {
        edit_finish(?edit, 1);
        ret 6;
    }
    val applied: i64 = mutate_apply(?edit, ?s, ?a, root, mode, ?spec, "local", true, false, true, 0);
    if (edit_finish(?edit, applied) != 0) { ret 7; }
    val staged: res[str, outcome.Fail] = deps.staged_paths(?s, root, "dep/local");
    if (sel staged.err)                                                                   { ret 8; }
    if (!str_empty(staged.ok))                                                            { ret 8; }
    if (verify_project(root, false) != 0 || !t_build_ok(?s, root))                        { ret 9; }
    if (t_exists_under(?a, source, ".git") || t_exists_under(?a, root, "dep/local/.git")) { ret 10; }
    val copied_r: res[str, outcome.Fail] = deps.dep_full_of(?a, root, "local");
    if (sel copied_r.err) { ret 11; }
    val copied: str = copied_r.ok;
    fin { str_free(?a, copied); }
    val remove_all_r: err[fs.FsError] = fs.remove_all(?a, copied);
    if (sel remove_all_r.err) { ret 12; }
    var reqs: Vector[DepReq] = vector.init[DepReq](?a);
    fin { free_requests(?a, ?reqs); }
    if (realize_closure(?s, ?a, root, ?reqs, true, false, nil, nil) != 0) { ret 13; }
    if (verify_project(root, false) != 0 || !t_build_ok(?s, root))        { ret 14; }
    ret 0;
}

fun t_dep_cli_edit(a: *A.Allocator, action: str, root: str, name: str, url: str) i64 {
    var av: [10]*u8;
    av[0] = "mach"::*u8;
    av[1] = "dep"::*u8;
    av[2] = action::*u8;
    av[3] = root::*u8;
    av[4] = name::*u8;
    av[5] = "--quiet"::*u8;
    if (str_empty(url)) {
        av[6] = nil;
        ret t_dep_cli(a, 6, ?av[0]);
    }
    av[6] = "--git"::*u8;
    av[7] = url::*u8;
    av[8] = "--ref"::*u8;
    av[9] = "branch/main"::*u8;
    ret t_dep_cli(a, 10, ?av[0]);
}

# a deleted checkout with a staged gitlink is initialized again, with or without its .gitmodules entry
test "mach.cli.cmd.dep.pull:a_deleted_checkout_with_a_staged_gitlink_is_initialized_again" {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    var git_env: [4]*u8;
    t_allow_file_transport(?git_env[0]);
    fin { deps.set_git_config_env(nil); }
    val fixture: str = t_package_repo(?a, "mach_dep_slot_source", "x", "");
    if (str_empty(fixture)) { ret 2; }
    fin { fs.remove_all(?a, fixture); }
    val root: str = t_root_repo(?a, "mach_dep_slot_root", t_dep_table(?a, "x", fixture));
    if (str_empty(root)) { ret 3; }
    fin { fs.remove_all(?a, root); }
    if (pull_project(root, true) != 0 || verify_project(root, false) != 0) { ret 4; }

    val checkout_r: res[str, A.Error] = path.join(?a, root, "dep/x");
    if (sel checkout_r.err) { ret 5; }
    val checkout: str = checkout_r.ok;
    fs.remove_all(?a, checkout);
    if (pull_project(root, true) != 0)                { ret 6; }
    if (!t_exists_under(?a, root, "dep/x/mach.toml")) { ret 7; }
    if (verify_project(root, false) != 0)             { ret 8; }

    if (!t_git3(?a, root, "config", "-f", ".gitmodules", "--remove-section", "submodule.dep/x")) { ret 9; }
    if (!t_git3(?a, root, "add", "--", ".gitmodules", "", ""))                                   { ret 9; }
    fs.remove_all(?a, checkout);
    if (pull_project(root, true) != 0)                { ret 10; }
    if (!t_exists_under(?a, root, "dep/x/mach.toml")) { ret 11; }
    if (verify_project(root, false) != 0)             { ret 12; }

    fs.remove_all(?a, checkout);
    var s:    session.Session;
    var mode: u8 = 0;
    if (!t_session_and_mode(?a, root, ?s, ?mode)) { ret 13; }
    fin { session.dnit(?s); }
    if (update_apply(?s, ?a, root, mode, false, "x"::*u8, true, 0, false, false) != 0) { ret 14; }
    if (verify_project(root, false) != 0)                                              { ret 15; }
    ret 0;
}

test "mach.cli.cmd.dep.pull:an_unregistered_checkout_is_adopted_when_clean_and_refused_when_dirty" {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    var git_env: [4]*u8;
    t_allow_file_transport(?git_env[0]);
    fin { deps.set_git_config_env(nil); }
    val fixture: str = t_package_repo(?a, "mach_dep_adopt_source", "x", "");
    if (str_empty(fixture)) { ret 2; }
    fin { fs.remove_all(?a, fixture); }
    val root: str = t_root_repo(?a, "mach_dep_adopt_root", t_dep_table(?a, "x", fixture));
    if (str_empty(root)) { ret 3; }
    fin { fs.remove_all(?a, root); }
    if (!t_git3(?a, root, "clone", "-q", fixture, "dep/x", ""))    { ret 4; }
    if (!t_write(?a, root, "dep/x/scratch", "work in progress\n")) { ret 5; }

    if (pull_project(root, true) != 1)              { ret 6; }
    if (!t_exists_under(?a, root, "dep/x/scratch")) { ret 7; }
    if (t_exists_under(?a, root, ".gitmodules"))    { ret 8; }

    val scratch_r: res[str, A.Error] = path.join(?a, root, "dep/x/scratch");
    if (sel scratch_r.err) { ret 9; }
    fs.remove_all(?a, scratch_r.ok);
    if (pull_project(root, true) != 0)    { ret 10; }
    if (verify_project(root, false) != 0) { ret 11; }
    ret 0;
}

test "mach.cli.cmd.dep.add:after_remove_the_retained_checkout_or_module_store_is_reused" {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    var git_env: [4]*u8;
    t_allow_file_transport(?git_env[0]);
    fin { deps.set_git_config_env(nil); }
    val fixture: str = t_package_repo(?a, "mach_dep_readd_source", "x", "");
    if (str_empty(fixture)) { ret 2; }
    fin { fs.remove_all(?a, fixture); }
    val root: str = t_root_repo(?a, "mach_dep_readd_root", "");
    if (str_empty(root)) { ret 3; }
    fin { fs.remove_all(?a, root); }

    if (t_dep_cli_edit(?a, "add", root, "x", fixture) != 0) { ret 4; }
    if (t_dep_cli_edit(?a, "remove", root, "x", "") != 0)   { ret 5; }
    if (!t_exists_under(?a, root, "dep/x/mach.toml"))       { ret 6; }
    if (t_dep_cli_edit(?a, "add", root, "x", fixture) != 0) { ret 7; }
    if (verify_project(root, false) != 0)                   { ret 8; }

    if (t_dep_cli_edit(?a, "remove", root, "x", "") != 0) { ret 9; }
    val checkout_r: res[str, A.Error] = path.join(?a, root, "dep/x");
    if (sel checkout_r.err) { ret 10; }
    fs.remove_all(?a, checkout_r.ok);
    if (!t_exists_under(?a, root, ".git/modules/dep/x"))    { ret 11; }
    if (t_dep_cli_edit(?a, "add", root, "x", fixture) != 0) { ret 12; }
    if (verify_project(root, false) != 0)                   { ret 13; }
    ret 0;
}

# a package repository whose manifest names each version it is tagged with; `mach_range` is
# the [project].mach of the release tagged `blocked` ("" for none)
fun t_release(a: *A.Allocator, dir: str, id: str, version: str, mach_range: str) bool {
    var mach_line: str = "";
    if (!str_empty(mach_range)) {
        val l: res[str, format.FormatError] = format.sprint(a, "mach = \"{}\"\n", mach_range);
        if (sel l.err) { ret false; }
        mach_line = l.ok;
    }
    val body_r: res[str, format.FormatError] = format.sprint(a,
        "[project]\nid = \"{}\"\nversion = \"{}\"\n{}src = \"src\"\nout = \"out\"\n", id, version, mach_line);
    if (sel body_r.err)                        { ret false; }
    if (!t_write(a, dir, MANIFEST, body_r.ok)) { ret false; }
    if (!t_commit_all(a, dir))                 { ret false; }
    val tag_r: res[str, format.FormatError] = format.sprint(a, "v{}", version);
    if (sel tag_r.err) { ret false; }
    ret t_git3(a, dir, "tag", tag_r.ok, "", "", "");
}

# a release of `id` depending on `dep_id` at `dep_url` by `ref` or by the range `version`;
# the table goes through the manifest writer so a host path lands escaped
fun t_release_with_dep(a: *A.Allocator, dir: str, id: str, version: str, dep_id: str, dep_url: str, ref: str, range: str) bool {
    var spec: manifest.DepTableSpec;
    spec.name    = dep_id;
    spec.source  = manifest.DEP_SOURCE_GIT;
    spec.value   = dep_url;
    spec.ref     = ref;
    spec.version = range;
    val table: res[str, outcome.Fail] = manifest.manifest_add_dep_table(a, "", ?spec);
    if (sel table.err) { ret false; }
    val body_r: res[str, format.FormatError] = format.sprint(a,
        "[project]\nid = \"{}\"\nversion = \"{}\"\nsrc = \"src\"\nout = \"out\"\n{}", id, version, table.ok);
    if (sel body_r.err)                        { ret false; }
    if (!t_write(a, dir, MANIFEST, body_r.ok)) { ret false; }
    if (!t_commit_all(a, dir))                 { ret false; }
    val tag_r: res[str, format.FormatError] = format.sprint(a, "v{}", version);
    if (sel tag_r.err) { ret false; }
    ret t_git3(a, dir, "tag", tag_r.ok, "", "", "");
}

fun t_released(a: *A.Allocator) str {
    val dir: str = t_scratch(a, "mach_dep_releases");
    if (str_empty(dir))                            { ret ""; }
    if (!t_lib_module(a, dir))                     { ret ""; }
    if (!t_init_repo(a, dir))                      { ret ""; }
    if (!t_release(a, dir, "vb", "1.0.0", ""))     { ret ""; }
    if (!t_release(a, dir, "vb", "1.1.0", ">=5"))  { ret ""; }
    if (!t_release(a, dir, "vb", "2.0.0", ">=99")) { ret ""; }
    ret dir;
}

fun t_release_under(a: *A.Allocator, root: str, id: str) str {
    var s:    session.Session;
    var mode: u8 = 0;
    if (!t_session_and_mode(a, root, ?s, ?mode)) { ret "?"; }
    fin { session.dnit(?s); }
    val at: res[str, outcome.Fail] = deps.release_at_head(?s, t_join_owned(a, root, id));
    if (sel at.err) { ret "?"; }
    ret own(a, at.ok);
}

fun t_dep_cli_args(a: *A.Allocator, words: *str, n: usize) i64 {
    var av: [12]*u8;
    av[0] = "mach"::*u8;
    av[1] = "dep"::*u8;
    var i: usize = 0;
    for (i < n) {
        av[2 + i] = words[i]::*u8;
        i         = i + 1;
    }
    av[2 + n] = nil;
    ret t_dep_cli(a, 2 + n, ?av[0]);
}

# dep add writes the caret of the release resolution picks, update moves within the range,
# --lowest selects the floor, outdated reports, and a range nothing satisfies is explained (#3502)
test "mach.cli.cmd.dep.version:add_update_lowest_and_outdated_resolve_release_ranges" {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    var git_env: [4]*u8;
    t_allow_file_transport(?git_env[0]);
    fin { deps.set_git_config_env(nil); }
    val fix: str = t_released(?a);
    if (str_empty(fix)) { ret 2; }
    fin { fs.remove_all(?a, fix); }
    val root: str = t_root_repo(?a, "mach_dep_version_root", "");
    if (str_empty(root)) { ret 3; }
    fin { fs.remove_all(?a, root); }
    val dep_vb: str = t_join_owned(?a, root, "dep/vb");

    # 2.0.0 needs a newer compiler, so add picks 1.1.0 and writes ^1.1.0
    var add: [6]str = [6]str{"add", root, "vb", "--git", fix, "--quiet"};
    if (t_dep_cli_args(?a, ?add[0], 6) != 0) { ret 4; }
    val manifest_text: res[str, fs.FsError] = fs.read_string(?a, t_join_owned(?a, root, MANIFEST));
    if (sel manifest_text.err)                                     { ret 5; }
    if (!str_contains(manifest_text.ok, "version = \"^1.1.0\""))   { ret 6; }
    if (!str_equals(t_release_under(?a, root, "dep/vb"), "1.1.0")) { ret 7; }
    if (verify_project(root, false) != 0)                          { ret 8; }

    # a new compatible release is taken by update
    if (!t_release(?a, fix, "vb", "1.2.0", "")) { ret 9; }
    var up: [4]str = [4]str{"update", root, "vb", "--quiet"};
    if (t_dep_cli_args(?a, ?up[0], 4) != 0)                        { ret 10; }
    if (!str_equals(t_release_under(?a, root, "dep/vb"), "1.2.0")) { ret 11; }

    # the lowest release the range accepts
    var low: [5]str = [5]str{"update", root, "--all", "--lowest", "--quiet"};
    if (t_dep_cli_args(?a, ?low[0], 5) != 0)                       { ret 12; }
    if (!str_equals(t_release_under(?a, root, "dep/vb"), "1.1.0")) { ret 13; }

    # offline resolution reads the tags the checkout already has
    var off: [5]str = [5]str{"update", root, "vb", "--offline", "--quiet"};
    if (t_dep_cli_args(?a, ?off[0], 5) != 0)                       { ret 14; }
    if (!str_equals(t_release_under(?a, root, "dep/vb"), "1.2.0")) { ret 15; }

    var out: [2]str = [2]str{"outdated", root};
    if (t_dep_cli_args(?a, ?out[0], 2) != 0) { ret 16; }

    # a range nothing satisfies leaves the checkout where it is
    val mt:     str = t_join_owned(?a, root, MANIFEST);
    val raised: str = str_replace_first(?a, manifest_text.ok, "version = \"^1.1.0\"", "version = \"^3\"");
    if (!t_write(?a, root, MANIFEST, raised))                      { ret 17; }
    if (t_dep_cli_args(?a, ?up[0], 4) != 1)                        { ret 18; }
    if (!str_equals(t_release_under(?a, root, "dep/vb"), "1.2.0")) { ret 19; }
    ret 0;
}

fun str_replace_first(a: *A.Allocator, hay: str, needle: str, with: str) str {
    val at: opt[str] = str_find(hay, needle);
    if (sel at.none) { ret hay; }
    val offset: usize             = (at.some::usize - hay::usize);
    val head:   res[str, A.Error] = str_dup_range(a, hay, 0, offset);
    if (sel head.err) { ret hay; }
    val joined: res[str, format.FormatError] = format.sprint(a, "{}{}{}", head.ok, with, (?hay[offset + str_len(needle)])::str);
    if (sel joined.err) { ret hay; }
    ret joined.ok;
}

# a release's own version range is resolved with the root's, and a release selecting a
# dependency by branch is refused as unreproducible (#3502, #3496 section 7)
test "mach.cli.cmd.dep.version:transitive_ranges_resolve_and_branch_selecting_releases_are_refused" {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    var git_env: [4]*u8;
    t_allow_file_transport(?git_env[0]);
    fin { deps.set_git_config_env(nil); }
    val vb: str = t_released(?a);
    if (str_empty(vb)) { ret 2; }
    fin { fs.remove_all(?a, vb); }
    val va: str = t_scratch(?a, "mach_dep_requirer");
    if (str_empty(va)) { ret 3; }
    fin { fs.remove_all(?a, va); }
    if (!t_lib_module(?a, va) || !t_init_repo(?a, va))                           { ret 3; }
    if (!t_release_with_dep(?a, va, "va", "1.0.0", "vb", vb, "", "~1.0"))        { ret 4; }
    if (!t_release_with_dep(?a, va, "va", "1.1.0", "vb", vb, "branch/main", "")) { ret 5; }
    val root: str = t_root_repo(?a, "mach_dep_transitive_root", "");
    if (str_empty(root)) { ret 6; }
    fin { fs.remove_all(?a, root); }

    # va 1.1.0 selects vb by branch, so a range reaching it is refused; ~1.0 selects va 1.0.0, whose ~1.0 selects vb 1.0.0
    var add:   [8]str = [8]str{"add", root, "va", "--git", va, "--version", ">=1", "--quiet"};
    val added: i64    = t_dep_cli_args(?a, ?add[0], 8);
    if (added != 1) { ret 7; }
    var add_old: [8]str = [8]str{"add", root, "va", "--git", va, "--version", "~1.0", "--quiet"};
    if (t_dep_cli_args(?a, ?add_old[0], 8) != 0)                   { ret 8; }
    if (!str_equals(t_release_under(?a, root, "dep/va"), "1.0.0")) { ret 9; }
    if (!str_equals(t_release_under(?a, root, "dep/vb"), "1.0.0")) { ret 10; }
    if (verify_project(root, false) != 0)                          { ret 11; }
    ret 0;
}

fun t_refusal_has(a: *A.Allocator, root: str, n1: str, n2: str) bool {
    val r: str = t_verify_refusal(a, root);
    ret !str_empty(r) && t_contains(r, n1) && t_contains(r, n2);
}

# verify holds a version selection to a release tag inside every requirer's range, offline,
# and a release selecting a dependency by branch is refused with its chain (#3503)
test "mach.cli.cmd.dep.verify:version_pins_are_checked_against_every_range" {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    var git_env: [4]*u8;
    t_allow_file_transport(?git_env[0]);
    fin { deps.set_git_config_env(nil); }
    val fix: str = t_released(?a);
    if (str_empty(fix)) { ret 2; }
    fin { fs.remove_all(?a, fix); }
    if (!t_release(?a, fix, "vb", "1.2.0", "")) { ret 3; }
    val root: str = t_root_repo(?a, "mach_dep_verify_range_root", "");
    if (str_empty(root)) { ret 4; }
    fin { fs.remove_all(?a, root); }

    # in range
    var add: [8]str = [8]str{"add", root, "vb", "--git", fix, "--version", "~1.1", "--quiet"};
    if (t_dep_cli_args(?a, ?add[0], 8) != 0)                       { ret 5; }
    if (!str_equals(t_release_under(?a, root, "dep/vb"), "1.1.0")) { ret 6; }
    if (verify_project(root, false) != 0)                          { ret 7; }

    # outside the range, with a remedy that re-pins it
    val text: res[str, fs.FsError] = fs.read_string(?a, t_join_owned(?a, root, MANIFEST));
    if (sel text.err) { ret 8; }
    val raised: str = str_replace_first(?a, text.ok, "version = \"~1.1\"", "version = \"^1.2\"");
    if (!t_write(?a, root, MANIFEST, raised))                                           { ret 9; }
    if (!t_refusal_has(?a, root, "requires version '^1.2'", "pinned release is 1.1.0")) { ret 10; }
    if (t_run_remedy(?a, t_verify_refusal(?a, root), root) != 0)                        { ret 11; }
    if (!str_equals(t_release_under(?a, root, "dep/vb"), "1.2.0"))                      { ret 12; }
    if (verify_project(root, false) != 0)                                               { ret 13; }

    # a pin no release tag names
    if (!t_write(?a, fix, "NEWS", "untagged\n") || !t_commit_all(?a, fix)) { ret 14; }
    val dep_vb: str = t_join_owned(?a, root, "dep/vb");
    if (!t_git3(?a, dep_vb, "fetch", "-q", "origin", "main", ""))                      { ret 15; }
    if (!t_git3(?a, dep_vb, "checkout", "-q", "FETCH_HEAD", "", ""))                   { ret 16; }
    if (!t_git3(?a, root, "add", "dep/vb", "", "", ""))                                { ret 17; }
    if (!t_refusal_has(?a, root, "requires version '^1.2'", "carries no release tag")) { ret 18; }

    # --release holds the root itself to release selectors
    if (!t_git3(?a, dep_vb, "checkout", "-q", "v1.2.0", "", "")) { ret 19; }
    if (!t_git3(?a, root, "add", "dep/vb", "", "", ""))          { ret 20; }
    if (verify_project(root, true) != 0)                         { ret 21; }
    val floating: str = str_replace_first(?a, raised, "version = \"^1.2\"", "ref = \"branch/main\"");
    if (!t_write(?a, root, MANIFEST, floating)) { ret 22; }
    if (verify_project(root, false) != 0)       { ret 23; }
    if (verify_project(root, true) != 1)        { ret 24; }
    var s:    session.Session;
    var mode: u8 = 0;
    if (!t_session_and_mode(?a, root, ?s, ?mode)) { ret 25; }
    val vr:  err[outcome.Fail] = driver.verify_dependencies(?s, root, true, nil);
    var why: str               = "";
    if (sel vr.err) { why = own(?a, outcome.describe(vr.err)); }
    session.dnit(?s);
    if (!t_contains(why, "project 'root'") || !t_contains(why, "[dep.vb] by ref = \"branch/main\"")) { ret 26; }
    ret 0;
}

# a release reached by `tag/` or a range whose manifest selects by branch is refused by
# verify and every build, naming the chain and the line; a development selection above it may float (#3503)
test "mach.cli.cmd.dep.verify:a_release_selecting_a_branch_is_refused_with_its_chain" {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    var git_env: [4]*u8;
    t_allow_file_transport(?git_env[0]);
    fin { deps.set_git_config_env(nil); }
    val vb: str = t_released(?a);
    if (str_empty(vb)) { ret 2; }
    fin { fs.remove_all(?a, vb); }
    if (!t_release(?a, vb, "vb", "2.1.0", "")) { ret 2; }
    val va: str = t_scratch(?a, "mach_dep_floating_release");
    if (str_empty(va)) { ret 3; }
    fin { fs.remove_all(?a, va); }
    if (!t_lib_module(?a, va) || !t_init_repo(?a, va))                           { ret 3; }
    if (!t_release_with_dep(?a, va, "va", "1.1.0", "vb", vb, "branch/main", "")) { ret 4; }

    # by branch, the development chain floats freely
    val dev_root: str = t_root_repo(?a, "mach_dep_floating_dev", t_dep_table(?a, "va", va));
    if (str_empty(dev_root)) { ret 5; }
    fin { fs.remove_all(?a, dev_root); }
    if (pull_project(dev_root, true) != 0)    { ret 6; }
    if (!t_commit_all(?a, dev_root))          { ret 7; }
    if (verify_project(dev_root, false) != 0) { ret 8; }

    # by tag, the release is refused
    val rel_root: str = t_root_repo(?a, "mach_dep_floating_rel", t_dep_table_ref(?a, "va", va, "tag/v1.1.0"));
    if (str_empty(rel_root)) { ret 9; }
    fin { fs.remove_all(?a, rel_root); }
    if (pull_project(rel_root, true) != 0 || !t_commit_all(?a, rel_root))                                                    { ret 10; }
    if (!t_refusal_has(?a, rel_root, "root -> va is a release (ref = \"tag/v1.1.0\")", "[dep.vb] by ref = \"branch/main\"")) { ret 11; }
    ret 0;
}

# verify names a requirer selector the root's `ref` replaced, and stays quiet without one (#3548)
test "mach.cli.cmd.dep.verify:a_root_override_of_a_requirer_selector_is_noted" {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    var git_env: [4]*u8;
    t_allow_file_transport(?git_env[0]);
    fin { deps.set_git_config_env(nil); }
    val vb: str = t_released(?a);
    if (str_empty(vb)) { ret 2; }
    fin { fs.remove_all(?a, vb); }
    val va: str = t_scratch(?a, "mach_dep_verify_override_requirer");
    if (str_empty(va)) { ret 3; }
    fin { fs.remove_all(?a, va); }
    if (!t_lib_module(?a, va) || !t_init_repo(?a, va))                    { ret 3; }
    if (!t_release_with_dep(?a, va, "va", "1.0.0", "vb", vb, "", "~1.0")) { ret 4; }
    val root: str = t_root_repo(?a, "mach_dep_verify_override_root", "");
    if (str_empty(root)) { ret 5; }
    fin { fs.remove_all(?a, root); }
    var add_a: [8]str = [8]str{"add", root, "va", "--git", va, "--version", "^1", "--quiet"};
    if (t_dep_cli_args(?a, ?add_a[0], 8) != 0) { ret 6; }

    var quiet: Vector[str] = t_override_notes(?a, root);
    if (quiet.len != 0) { ret 7; }

    # a root range intersects with the requirer's instead of replacing it
    var ranged: [8]str = [8]str{"add", root, "vb", "--git", vb, "--version", "^1", "--quiet"};
    if (t_dep_cli_args(?a, ?ranged[0], 8) != 0) { ret 14; }
    var narrowed: Vector[str] = t_override_notes(?a, root);
    if (narrowed.len != 0) { ret 15; }
    var drop_b: [4]str = [4]str{"remove", root, "vb", "--quiet"};
    if (t_dep_cli_args(?a, ?drop_b[0], 4) != 0) { ret 16; }

    var add_b: [8]str = [8]str{"add", root, "vb", "--git", vb, "--ref", "tag/v1.0.0", "--quiet"};
    if (t_dep_cli_args(?a, ?add_b[0], 8) != 0) { ret 8; }
    var noted: Vector[str] = t_override_notes(?a, root);
    if (noted.len != 1) { ret 9; }
    if (!t_any_note(?noted, "note: dependency 'vb': the root declares ref = \"tag/v1.0.0\", overriding ")) { ret 10; }
    if (!t_any_note(?noted, "-> va -> vb which requires version = \"~1.0\""))                           { ret 11; }
    if (!t_any_note(?noted, "nothing checks that 'vb' supports the root's selection"))                   { ret 12; }
    if (verify_project(root, false) != 0)                                                                 { ret 13; }
    ret 0;
}

# the override notes `mach dep verify` prints for a project; a verify failure is the only entry
fun t_override_notes(a: *A.Allocator, root: str) Vector[str] {
    var out:  Vector[str] = vector.init[str](a);
    var s:    session.Session;
    var mode: u8          = 0;
    if (!t_session_and_mode(a, root, ?s, ?mode)) { ret out; }
    fin { session.dnit(?s); }
    var overrides: Vector[deps.RootOverride] = vector.init[deps.RootOverride](a);
    fin { vector.dnit[deps.RootOverride](?overrides); }
    val vr: err[outcome.Fail] = driver.verify_dependencies(?s, root, false, ?overrides);
    if (sel vr.err) {
        vector.push[str](?out, own(a, outcome.describe(vr.err)));
        ret out;
    }
    var i: usize = 0;
    for (i < overrides.len) {
        val text: res[str, outcome.Fail] = deps.root_override_text(?s, ?overrides.data[i]);
        i = i + 1;
        if (sel text.err) { cnt; }
        vector.push[str](?out, own(a, text.ok));
        str_free(s.build_alloc, text.ok);
    }
    ret out;
}

fun t_notes_of(a: *A.Allocator, root: str, offline: bool) Vector[str] {
    var none: Vector[str] = vector.init[str](a);
    var s:    session.Session;
    var mode: u8          = 0;
    if (!t_session_and_mode(a, root, ?s, ?mode)) { ret none; }
    fin { session.dnit(?s); }
    val mt: res[toml.Table, outcome.Fail] = parse_file(a, t_join_owned(a, root, MANIFEST));
    if (sel mt.err) { ret none; }
    var table: toml.Table                    = mt.ok;
    val r:     res[Resolution, outcome.Fail] = resolve_versions(?s, a, root, ?table, false, offline, false, nil);
    if (sel r.err) {
        vector.push[str](?none, own(a, outcome.describe(r.err)));
        ret none;
    }
    ret r.ok.notes;
}

fun t_any_note(notes: *Vector[str], needle: str) bool {
    var i: usize = 0;
    for (i < notes.len) {
        if (t_contains(notes.data[i], needle)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# a root `ref` overriding a release's range is named, and an --offline resolution says so (#3529)
test "mach.cli.cmd.dep.version:overrides_and_offline_resolution_are_reported" {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    var git_env: [4]*u8;
    t_allow_file_transport(?git_env[0]);
    fin { deps.set_git_config_env(nil); }
    val vb: str = t_released(?a);
    if (str_empty(vb)) { ret 2; }
    fin { fs.remove_all(?a, vb); }
    val va: str = t_scratch(?a, "mach_dep_override_requirer");
    if (str_empty(va)) { ret 3; }
    fin { fs.remove_all(?a, va); }
    if (!t_lib_module(?a, va) || !t_init_repo(?a, va))                    { ret 3; }
    if (!t_release_with_dep(?a, va, "va", "1.0.0", "vb", vb, "", "~1.0")) { ret 4; }

    # no override and online: nothing to say
    val root: str = t_root_repo(?a, "mach_dep_override_root", "");
    if (str_empty(root)) { ret 5; }
    fin { fs.remove_all(?a, root); }
    var add: [8]str = [8]str{"add", root, "va", "--git", va, "--version", "^1", "--quiet"};
    if (t_dep_cli_args(?a, ?add[0], 8) != 0) { ret 6; }
    var plain: Vector[str] = t_notes_of(?a, root, false);
    if (plain.len != 0) { ret 7; }

    # offline
    var off: Vector[str] = t_notes_of(?a, root, true);
    if (!t_any_note(?off, "resolving from releases already fetched (--offline)")) { ret 8; }

    # the root pins vb by branch, overriding va's ~1.0
    val text: res[str, fs.FsError] = fs.read_string(?a, t_join_owned(?a, root, MANIFEST));
    if (sel text.err) { ret 9; }
    val with_b: res[str, format.FormatError] = format.sprint(?a, "{}{}", text.ok, t_dep_table_ref(?a, "vb", vb, "branch/main"));
    if (sel with_b.err)                          { ret 10; }
    if (!t_write(?a, root, MANIFEST, with_b.ok)) { ret 11; }
    var over: Vector[str] = t_notes_of(?a, root, false);
    if (!t_any_note(?over, "root declares vb by ref \"branch/main\", overriding root -> va 1.0.0 requires vb ~1.0")) { ret 12; }
    if (t_any_note(?over, "--offline"))                                                                              { ret 13; }
    ret 0;
}
