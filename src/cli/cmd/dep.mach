use mach.lang.session;

val MANIFEST: str = manifest_load.MANIFEST_FILE;

# `--git <url>`
val GIT: std_args.Flag = std_args.Flag{long: "git", short: 0, value: "url", repeat: false, negatable: false, help: "use a Git URL source"};
# `--path <dir>`
val PATH: std_args.Flag = std_args.Flag{long: "path", short: 0, value: "dir", repeat: false, negatable: false, help: "use a local path source"};
# `--ref <ref>`
val REF: std_args.Flag = std_args.Flag{long: "ref", short: 0, value: "branch/<n>|tag/<n>|commit/<n>", repeat: false, negatable: false, help: "select a Git reference"};
# `--range <range>`
val RANGE: std_args.Flag = std_args.Flag{long: "range", short: 0, value: "range", repeat: false, negatable: false, help: "select releases in a version range (default: ^ of the newest compatible)"};
# `--purge`
val PURGE: std_args.Flag = std_args.Flag{long: "purge", short: 0, value: nil, repeat: false, negatable: false, help: "also delete the dependency directory"};
# `--lowest`
val LOWEST: std_args.Flag = std_args.Flag{long: "lowest", short: 0, value: nil, repeat: false, negatable: false, help: "select the lowest release every range accepts"};
# `--release`
val RELEASE: std_args.Flag = std_args.Flag{long: "release", short: 0, value: nil, repeat: false, negatable: false, help: "also require every dependency to select a release"};
# `--all`, every declared dependency where a name would select one
val ALL_DEPS: std_args.Flag = std_args.Flag{long: "all", short: 0, value: nil, repeat: false, negatable: false, help: "update every declared dependency"};

# the flags every dep action takes
val PLAIN_FLAGS: [3]*std_args.Flag = [3]*std_args.Flag{?args.HELP, ?args.DIAGNOSTICS, ?args.QUIET};
# the flags of dep add
val ADD_FLAGS: [8]*std_args.Flag = [8]*std_args.Flag{?args.HELP, ?args.DIAGNOSTICS, ?args.QUIET, ?GIT, ?PATH, ?REF, ?RANGE, ?args.OFFLINE};
# the flags of dep remove
val REMOVE_FLAGS: [4]*std_args.Flag = [4]*std_args.Flag{?args.HELP, ?args.DIAGNOSTICS, ?args.QUIET, ?PURGE};
# the flags of dep update
val UPDATE_FLAGS: [6]*std_args.Flag = [6]*std_args.Flag{?args.HELP, ?args.DIAGNOSTICS, ?args.QUIET, ?ALL_DEPS, ?LOWEST, ?args.OFFLINE};
# the flags of dep outdated
val OUTDATED_FLAGS: [4]*std_args.Flag = [4]*std_args.Flag{?args.HELP, ?args.DIAGNOSTICS, ?args.QUIET, ?args.OFFLINE};
# the flags of dep verify
val VERIFY_FLAGS: [4]*std_args.Flag = [4]*std_args.Flag{?args.HELP, ?args.DIAGNOSTICS, ?args.QUIET, ?RELEASE};

# length of ADD_CONFLICTS
val ADD_CONFLICTS_N: usize = 4;
# a dependency has one source, and a reference or a range selects only a Git one
val ADD_CONFLICTS: [ADD_CONFLICTS_N]args.Conflict = [ADD_CONFLICTS_N]args.Conflict{
    args.Conflict{flag: ?GIT, other: ?PATH},
    args.Conflict{flag: ?PATH, other: ?REF},
    args.Conflict{flag: ?PATH, other: ?RANGE},
    args.Conflict{flag: ?REF, other: ?RANGE},
};
# `mach dep list`
pub val LIST: std_args.Command = std_args.Command{name: "list", aliases: args.NO_WORDS, help: "list declared dependencies and their state", usage: "<path>", flags: Slice[*std_args.Flag]{data: ?PLAIN_FLAGS[0], size: 3}, commands: args.NO_COMMANDS, operand_min: 1, operand_max: 1, passthrough: false};
# `mach dep add`
pub val ADD: std_args.Command = std_args.Command{name: "add", aliases: args.NO_WORDS, help: "declare a dependency", usage: "<path> <name> (--git <url> [--ref <ref> | --range <range>] | --path <dir>)", flags: Slice[*std_args.Flag]{data: ?ADD_FLAGS[0], size: 8}, commands: args.NO_COMMANDS, operand_min: 2, operand_max: 2, passthrough: false};
# `mach dep remove`
pub val REMOVE: std_args.Command = std_args.Command{name: "remove", aliases: args.NO_WORDS, help: "remove a dependency", usage: "<path> <name>", flags: Slice[*std_args.Flag]{data: ?REMOVE_FLAGS[0], size: 4}, commands: args.NO_COMMANDS, operand_min: 2, operand_max: 2, passthrough: false};
# `mach dep update`
pub val UPDATE: std_args.Command = std_args.Command{name: "update", aliases: args.NO_WORDS, help: "advance dependencies to their newest selected revisions", usage: "<path> (<name> | --all)", flags: Slice[*std_args.Flag]{data: ?UPDATE_FLAGS[0], size: 6}, commands: args.NO_COMMANDS, operand_min: 1, operand_max: 2, passthrough: false};
# `mach dep pull`
pub val PULL: std_args.Command = std_args.Command{name: "pull", aliases: args.NO_WORDS, help: "realize dependencies at their pinned revisions", usage: "<path>", flags: Slice[*std_args.Flag]{data: ?PLAIN_FLAGS[0], size: 3}, commands: args.NO_COMMANDS, operand_min: 1, operand_max: 1, passthrough: false};
# `mach dep outdated`
pub val OUTDATED: std_args.Command = std_args.Command{name: "outdated", aliases: args.NO_WORDS, help: "report pinned, compatible and latest releases", usage: "<path>", flags: Slice[*std_args.Flag]{data: ?OUTDATED_FLAGS[0], size: 4}, commands: args.NO_COMMANDS, operand_min: 1, operand_max: 1, passthrough: false};
# `mach dep verify`
pub val VERIFY: std_args.Command = std_args.Command{name: "verify", aliases: args.NO_WORDS, help: "check the realized dependencies against the manifest", usage: "<path>", flags: Slice[*std_args.Flag]{data: ?VERIFY_FLAGS[0], size: 4}, commands: args.NO_COMMANDS, operand_min: 1, operand_max: 1, passthrough: false};

# what mach holds `mach dep add` to beyond the parse
pub val ADD_POLICY: args.Policy = args.Policy{refused: args.NO_FLAGS, refusal: "", conflicts: Slice[args.Conflict]{data: ?ADD_CONFLICTS[0], size: ADD_CONFLICTS_N}};
# what mach holds `mach dep update` to beyond the parse
pub val UPDATE_POLICY: args.Policy = args.Policy{refused: args.NO_FLAGS, refusal: "", conflicts: args.NO_CONFLICTS};
# what mach holds `mach dep verify` to beyond the parse
pub val VERIFY_POLICY: args.Policy = args.Policy{refused: args.NO_FLAGS, refusal: "", conflicts: args.NO_CONFLICTS};
# what mach holds `mach dep` and its other actions to beyond the parse
pub val POLICY: args.Policy = args.Policy{refused: args.NO_FLAGS, refusal: "", conflicts: args.NO_CONFLICTS};

# length of ACTIONS
val ACTIONS_N: usize = 7;
# the dep actions in help order
val ACTIONS: [ACTIONS_N]*std_args.Command = [ACTIONS_N]*std_args.Command{?LIST, ?ADD, ?REMOVE, ?UPDATE, ?PULL, ?OUTDATED, ?VERIFY};

# `mach dep`
pub val COMMAND: std_args.Command = std_args.Command{name: "dep", aliases: args.NO_WORDS, help: "manage project dependencies", usage: "", flags: Slice[*std_args.Flag]{data: ?PLAIN_FLAGS[0], size: 3}, commands: Slice[*std_args.Command]{data: ?ACTIONS[0], size: ACTIONS_N}, operand_min: 0, operand_max: 0, passthrough: false};

# the dep options an invocation was given
# ---
# quiet:   `--quiet`
# all:     `--all`
# purge:   `--purge`
# lowest:  `--lowest`
# offline: `--offline`
# release: `--release`
# git:     the `--git` url
# path:    the `--path` directory
# ref:     the `--ref` reference
# range:   the `--range` range
rec Options {
    quiet:   bool;
    all:     bool;
    purge:   bool;
    lowest:  bool;
    offline: bool;
    release: bool;
    git:     opt[*u8];
    path:    opt[*u8];
    ref:     opt[*u8];
    range:   opt[*u8];
}

fun options_of(inv: *std_args.Parsed) Options {
    ret Options{
        quiet:  std_args.given(inv, ?args.QUIET), all: std_args.given(inv, ?ALL_DEPS), purge: std_args.given(inv, ?PURGE),
        lowest: std_args.given(inv, ?LOWEST), offline: std_args.given(inv, ?args.OFFLINE), release: std_args.given(inv, ?RELEASE),
        git:    args.value(inv, ?GIT), path: args.value(inv, ?PATH), ref: args.value(inv, ?REF),
        range:  args.value(inv, ?RANGE)
    };
}

# `mach dep`: route to one action: list, add, remove, update, pull, verify or outdated, each a
# command over the dependency manager (mach.lang.package) that renders what it reports
# ---
# cx:  the call, its action read and its operands counted
# ret: exit.OK, the code `exit.of` maps the action's rendered failure to, or the failure that
#      kept the action from starting
pub fun run(cx: *args.Call) res[i64, fail.Fail] {
    val inv:    *std_args.Parsed  = cx.inv;
    var parsed: Options           = options_of(inv);
    val action: *std_args.Command = inv.command;
    if (action == ?COMMAND) {
        ret res[i64, fail.Fail].err{fail.user(diagnostic_kind.CLI_UNKNOWN_ACTION, "mach dep takes an action: list, add, remove, update, pull, outdated or verify")};
    }

    val project: *u8                                  = args.operand(inv, 0);
    val loc_r:   res[util.ProjectLocation, fail.Fail] = util.resolve_project_location(cx.a, project::str);
    if (sel loc_r.err) {
        val said: res[str, std_format.FormatError] = std_format.sprint(cx.a, "mach dep {} project '{}': {}", action.name, project::str, fail.describe(loc_r.err));
        if (sel said.err) { ret res[i64, fail.Fail].err{loc_r.err}; }
        ret res[i64, fail.Fail].err{fail.owning(fail.with_text(loc_r.err, said.ok))};
    }
    val root: str = loc_r.ok.root;
    val name: *u8 = args.operand(inv, 1);

    val a:       *A.Allocator           = cx.a;
    val environ: exec.Environment       = cx.environ;
    val r:       *cli_diagnostic.Report = cx.report;
    if (action == ?LIST)     { ret dep_list(a, r, root, environ); }
    if (action == ?ADD)      { ret dep_add(a, r, root, name, ?parsed, environ); }
    if (action == ?REMOVE)   { ret dep_remove(a, r, root, name, ?parsed, environ); }
    if (action == ?UPDATE)   { ret dep_update(a, r, root, name, ?parsed, environ); }
    if (action == ?PULL)     { ret pull_project(a, r, root, parsed.quiet, environ); }
    if (action == ?OUTDATED) { ret dep_outdated(a, r, root, parsed.offline, environ); }
    ret verify_project(a, r, root, parsed.release, environ);
}

# a session for a dependency action, running git in environ
fun dep_session(a: *A.Allocator, r: *cli_diagnostic.Report, environ: exec.Environment) res[session.Session, fail.Fail] {
    val sr: res[session.Session, fail.Fail] = session.init_in(a, r.sources);
    if (sel sr.err) { ret res[session.Session, fail.Fail].err{fail.prefixed(a, "failed to initialise a session: ", sr.err)}; }
    var s: session.Session = sr.ok;
    s.environ = environ;
    ret res[session.Session, fail.Fail].ok{s};
}

# `mach dep pull`: realize the dependency closure of a project (package_pull.project_closure)
# ---
# a:       owns what the pull allocates
# root:    the project root directory
# quiet:   suppress progress lines
# environ: the environment git runs in
# ret:     exit.OK when realized, the code `exit.of` maps the rendered failure to, or the failure
#          that kept the pull from starting
fun pull_project(a: *A.Allocator, r: *cli_diagnostic.Report, root: str, quiet: bool, environ: exec.Environment) res[i64, fail.Fail] {
    val sr: res[session.Session, fail.Fail] = dep_session(a, r, environ);
    if (sel sr.err) { ret res[i64, fail.Fail].err{sr.err}; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var rep: report.Report = cli_diagnostic.dependency_report(a, r);
    fin { report.dnit(?rep); }
    ret res[i64, fail.Fail].ok{cli_diagnostic.dependency_outcome(?rep, package_pull.project_closure(?s, a, root, quiet, ?rep))};
}

# `mach dep verify`: check that every dependency of a project is realized and consistent
# without changing anything (package_verify.project_closure); prints "ok" on success
# ---
# a:       owns what the check allocates
# root:    the project root directory
# release: also refuse a root dependency selected by a branch, a commit or a path
# environ: the environment git runs in
# ret:     exit.OK when verified, exit.USER for a directory outside the closure, otherwise the
#          code `exit.of` maps the rendered failure to, or the failure that kept it from starting
fun verify_project(a: *A.Allocator, r: *cli_diagnostic.Report, root: str, release: bool, environ: exec.Environment) res[i64, fail.Fail] {
    val sr: res[session.Session, fail.Fail] = dep_session(a, r, environ);
    if (sel sr.err) { ret res[i64, fail.Fail].err{sr.err}; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var rep: report.Report = cli_diagnostic.dependency_report(a, r);
    fin { report.dnit(?rep); }
    val rc: i64 = cli_diagnostic.dependency_outcome(?rep, package_verify.project_closure(?s, a, root, release, ?rep));
    if (rc == exit.OK) { print.print("ok\n"); }
    ret res[i64, fail.Fail].ok{rc};
}

# `mach dep outdated`: each version-selected identity's pinned release, the highest this
# compiler and every range accept, and the highest release published
fun dep_outdated(a: *A.Allocator, r: *cli_diagnostic.Report, root: str, offline: bool, environ: exec.Environment) res[i64, fail.Fail] {
    val sr: res[session.Session, fail.Fail] = dep_session(a, r, environ);
    if (sel sr.err) { ret res[i64, fail.Fail].err{sr.err}; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var rep: report.Report = cli_diagnostic.dependency_report(a, r);
    fin { report.dnit(?rep); }
    val opened: res[package_closure.Operation, fail.Fail] = package_closure.open(?s, a, root, ?rep);
    if (sel opened.err) { ret res[i64, fail.Fail].err{opened.err}; }
    var op: package_closure.Operation = opened.ok;
    fin { package_closure.close(?op); }
    val mt_path_r: res[str, A.Error] = types_path.join(a, root, MANIFEST);
    if (sel mt_path_r.err) { ret res[i64, fail.Fail].err{fail.refused(mt_path_r.err)}; }
    val mt_r: res[manifest_load.Doc, fail.Fail] = package_closure.parse_file(a, r.sources, mt_path_r.ok);
    if (sel mt_r.err) { ret res[i64, fail.Fail].err{mt_r.err}; }
    var mt:       manifest_load.Doc                        = mt_r.ok;
    val computed: res[package_resolve.Outdated, fail.Fail] = package_resolve.outdated(?op, ?mt, offline);
    if (sel computed.err) { ret res[i64, fail.Fail].ok{cli_diagnostic.dependency_outcome(?rep, err[fail.Fail].err{computed.err})}; }
    var shown: package_resolve.Outdated = computed.ok;
    var i:     usize                    = 0;
    for (i < shown.notes.len) {
        print.printlnf("{}", shown.notes.data[i]);
        i = i + 1;
    }
    if (!shown.ranged) {
        print.print("no dependency selects releases by version\n");
        ret res[i64, fail.Fail].ok{exit.OK};
    }
    print.print("dependency  pinned  compatible  latest\n");
    i = 0;
    for (i < shown.rows.len) {
        val row: *package_resolve.OutdatedRow = ?shown.rows.data[i];
        i = i + 1;
        var note: str = "";
        if (!str_equals(row.latest, row.compatible)) { note = "  (held back: a range excludes the newer release, or it needs a newer compiler)"; }
        print.printlnf("{}  {}  {}  {}{}", row.id, row.pinned, row.compatible, row.latest, note);
    }
    ret res[i64, fail.Fail].ok{exit.OK};
}

# the refusal of a dependency name that is no portable identifier
fun invalid_name() res[i64, fail.Fail] {
    ret res[i64, fail.Fail].err{fail.user(diagnostic_kind.MANIFEST_INVALID_NAME, "dependency name must be a portable identifier (letters, digits, '_', '-')")};
}

fun dep_update(a: *A.Allocator, r: *cli_diagnostic.Report, root: str, name: *u8, parsed: *Options, environ: exec.Environment) res[i64, fail.Fail] {
    val all: bool = parsed.all;
    if (!all && name == nil)                                    { ret res[i64, fail.Fail].err{fail.user(diagnostic_kind.CLI_OPERAND, "usage: mach dep update <path> (<name> | --all)")}; }
    if (all && name != nil)                                     { ret res[i64, fail.Fail].err{fail.user(diagnostic_kind.CLI_FLAG_CONFLICT, "give a name or --all, not both")}; }
    if (name != nil && !manifest_schema.is_valid_id(name::str)) { ret invalid_name(); }

    val sr: res[session.Session, fail.Fail] = dep_session(a, r, environ);
    if (sel sr.err) { ret res[i64, fail.Fail].err{sr.err}; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var rep: report.Report = cli_diagnostic.dependency_report(a, r);
    fin { report.dnit(?rep); }
    ret res[i64, fail.Fail].ok{cli_diagnostic.dependency_outcome(?rep, package_edit.update(?s, a, root, all, name::str, parsed.quiet, parsed.lowest, parsed.offline, ?rep))};
}

fun dep_add(a: *A.Allocator, r: *cli_diagnostic.Report, root: str, name: *u8, parsed: *Options, environ: exec.Environment) res[i64, fail.Fail] {
    val opt_git:  opt[*u8] = parsed.git;
    val opt_path: opt[*u8] = parsed.path;
    val opt_ref:  opt[*u8] = parsed.ref;
    val opt_ver:  opt[*u8] = parsed.range;
    val has_git:  bool     = sel opt_git.some;
    val has_path: bool     = sel opt_path.some;
    if (!has_git && !has_path) {
        ret res[i64, fail.Fail].err{fail.user(diagnostic_kind.DEP_SOURCE_COUNT, "give exactly one source: --git <url> or --path <dir>")};
    }
    if (!manifest_schema.is_valid_id(name::str)) { ret invalid_name(); }

    var spec: manifest_edit.DepTableSpec;
    spec.name = name::str;
    if (has_git) {
        spec.source  = manifest_edit.DEP_SOURCE_GIT;
        spec.value   = opt_value(opt_git)::str;
        spec.ref     = opt_value(opt_ref)::str;
        spec.version = opt_value(opt_ver)::str;
        if (spec.ref == nil)     { spec.ref = ""; }
        if (spec.version == nil) { spec.version = ""; }
    }
    or {
        spec.source  = manifest_edit.DEP_SOURCE_PATH;
        spec.value   = opt_value(opt_path)::str;
        spec.ref     = "";
        spec.version = "";
    }
    ret mutate_manifest(a, r, root, ?spec, name::str, true, false, parsed.quiet, true, parsed.offline, environ);
}

fun dep_remove(a: *A.Allocator, r: *cli_diagnostic.Report, root: str, name: *u8, parsed: *Options, environ: exec.Environment) res[i64, fail.Fail] {
    if (!manifest_schema.is_valid_id(name::str)) { ret invalid_name(); }
    var spec: manifest_edit.DepTableSpec;
    spec.name   = name::str;
    spec.source = manifest_edit.DEP_SOURCE_PATH;
    spec.value  = "";
    spec.ref    = "";
    ret mutate_manifest(a, r, root, ?spec, name::str, false, parsed.purge, parsed.quiet, true, false, environ);
}

fun mutate_manifest(a: *A.Allocator, r: *cli_diagnostic.Report, root: str, spec: *manifest_edit.DepTableSpec, name: str, adding: bool, purge: bool,
    quiet: bool, realize: bool, offline: bool, environ: exec.Environment) res[i64, fail.Fail] {
    val sr: res[session.Session, fail.Fail] = dep_session(a, r, environ);
    if (sel sr.err) { ret res[i64, fail.Fail].err{sr.err}; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var rep: report.Report = cli_diagnostic.dependency_report(a, r);
    fin { report.dnit(?rep); }
    ret res[i64, fail.Fail].ok{cli_diagnostic.dependency_outcome(?rep, package_edit.change(?s, a, root, spec, name, adding, purge, quiet, realize, offline, ?rep))};
}

fun dep_list(a: *A.Allocator, r: *cli_diagnostic.Report, root: str, environ: exec.Environment) res[i64, fail.Fail] {
    val sr: res[session.Session, fail.Fail] = dep_session(a, r, environ);
    if (sel sr.err) { ret res[i64, fail.Fail].err{sr.err}; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var rep: report.Report = cli_diagnostic.dependency_report(a, r);
    fin { report.dnit(?rep); }
    val opened: res[package_closure.Operation, fail.Fail] = package_closure.open(?s, a, root, ?rep);
    if (sel opened.err) { ret res[i64, fail.Fail].err{opened.err}; }
    var op: package_closure.Operation = opened.ok;
    fin { package_closure.close(?op); }
    var lines: Vector[str] = collections_vector.init[str](a);
    val rc:    i64         = cli_diagnostic.dependency_outcome(?rep, package_list.lines(?op, ?lines));
    var i:     usize       = 0;
    for (i < lines.len) {
        print.printlnf("{}", lines.data[i]);
        i = i + 1;
    }
    ret res[i64, fail.Fail].ok{rc};
}

fun opt_value(found: opt[*u8]) *u8 {
    if (sel found.none) { ret ""; }
    ret found.some;
}
