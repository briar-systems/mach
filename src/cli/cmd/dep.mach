val MANIFEST: str = manifest.MANIFEST_FILE;

# `mach dep`: route to one action: list, add, remove, update, pull, verify or outdated, each a
# command over the dependency manager (mach.lang.package) that renders what it reports
# ---
# argv: the full process arguments
# inv:  the parsed invocation for this command
# ret:  exit.OK, exit.USER for a malformed invocation, or the code `exit.of` maps the
#       action's printed failure to
pub fun run(argv: **u8, inv: *args.ParsedInvocation) i64 {
    if (!inv.has_action) {
        if (inv.argc < 3) {
            cli_diagnostic.headline_lead(diagnostic_kind.CLI_OPERAND);
            print.eprint("missing dep action\n");
            print.eprint("usage: mach dep <pull|verify|update|outdated|add|remove|list>\n");
            ret exit.USER;
        }
        cli_diagnostic.headline_lead(diagnostic_kind.CLI_UNKNOWN_ACTION);
        print.eprint("unknown dep action '");
        print.eprint(argv[2]::str);
        print.eprint("'\n");
        print.eprint("usage: mach dep <pull|verify|update|outdated|add|remove|list>\n");
        ret exit.USER;
    }

    var parsed: args.DepInvocation = args.build_dep_invocation(inv, argv);
    if (args.reject_unknown_from_invocation(inv, argv, "mach dep")) { ret exit.USER; }
    if (parsed.missing_value_idx != inv.argc) {
        cli_diagnostic.headline_lead(diagnostic_kind.CLI_FLAG_VALUE);
        print.eprintf("option '{}' for 'mach dep {}' requires a value\n",
            argv[parsed.missing_value_idx]::str, argv[2]::str);
        ret exit.USER;
    }
    if (parsed.duplicate_value_idx != inv.argc) {
        cli_diagnostic.headline_lead(diagnostic_kind.CLI_FLAG_REPEATED);
        print.eprintf("option '{}' for 'mach dep {}' cannot be repeated\n",
            argv[parsed.duplicate_value_idx]::str, argv[2]::str);
        ret exit.USER;
    }
    val spec: *args.DepActionSpec = args.dep_action_spec(parsed.action);
    if (spec == nil) { ret cli_diagnostic.refuse(fail.user(diagnostic_kind.CLI_UNKNOWN_ACTION, "unknown dep action")); }
    var maximum: usize = 1;
    if (parsed.action == args.DEPACT_ADD || parsed.action == args.DEPACT_REMOVE ||
        parsed.action == args.DEPACT_UPDATE) { maximum = 2; }
    if (parsed.operand_count == 0 || parsed.operand_count > maximum ||
        ((parsed.action == args.DEPACT_ADD || parsed.action == args.DEPACT_REMOVE) &&
        parsed.operand_count != 2)) {
        print.eprint("usage: mach dep ");
        print.eprint(spec.name);
        print.eprint(spec.grammar);
        print.eprint("\n");
        ret exit.USER;
    }

    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret cli_diagnostic.refuse(fail.message("failed to initialise allocator")); }
    val loc_r: res[util.ProjectLocation, fail.Fail] = util.resolve_project_location(?a, argv[parsed.project_idx]::str);
    if (sel loc_r.err) {
        cli_diagnostic.headline_lead(fail.kind_of(loc_r.err));
        print.eprintf("mach dep {} project '{}': {}\n", spec.name,
            argv[parsed.project_idx]::str, fail.describe(loc_r.err));
        ret exit.of(loc_r.err);
    }
    var location: util.ProjectLocation = loc_r.ok;
    fin { util.dnit_project_location(?a, ?location); }
    val root: str = location.root;
    var name: *u8 = nil;
    if (parsed.operand_count == 2) { name = argv[parsed.name_idx]; }

    val environ: **u8 = inv.environ;
    if (parsed.action == args.DEPACT_LIST)     { ret dep_list(root, environ); }
    if (parsed.action == args.DEPACT_ADD)      { ret dep_add(root, name, ?parsed, environ); }
    if (parsed.action == args.DEPACT_REMOVE)   { ret dep_remove(root, name, ?parsed, environ); }
    if (parsed.action == args.DEPACT_UPDATE)   { ret dep_update(root, name, ?parsed, environ); }
    if (parsed.action == args.DEPACT_PULL)     { ret pull_project(root, parsed.quiet, environ); }
    if (parsed.action == args.DEPACT_OUTDATED) { ret dep_outdated(root, parsed.offline, environ); }
    if (parsed.action == args.DEPACT_VERIFY)   { ret verify_project(root, parsed.release, environ); }
    ret cli_diagnostic.refuse(fail.user(diagnostic_kind.CLI_UNKNOWN_ACTION, "unknown dep action"));
}

# `mach dep pull`: realize the dependency closure of a project (package_closure.pull)
# ---
# root:    the project root directory
# quiet:   suppress progress lines
# environ: the environment git runs in
# ret:     exit.OK when realized, otherwise the code `exit.of` maps the printed failure to
pub fun pull_project(root: str, quiet: bool, environ: **u8) i64 {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret cli_diagnostic.refuse(fail.message("failed to initialise allocator")); }
    val sr: res[session.Session, fail.Fail] = session.init(?a);
    if (sel sr.err) { ret cli_diagnostic.refuse(fail.message("failed to initialise a session")); }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    s.environ = environ;
    var rep: package_report.Report = cli_diagnostic.dependency_report(?a);
    fin { package_report.dnit(?rep); }
    ret cli_diagnostic.dependency_outcome(?rep, package_closure.pull(?s, ?a, root, quiet, ?rep));
}

# `mach dep verify`: check that every dependency of a project is realized and consistent
# without changing anything (package_verify.project_closure); prints "ok" on success
# ---
# root:    the project root directory
# release: also refuse a root dependency selected by a branch, a commit or a path
# environ: the environment git runs in
# ret:     exit.OK when verified, exit.USER for a directory outside the closure, otherwise the
#          code `exit.of` maps the printed failure to
fun verify_project(root: str, release: bool, environ: **u8) i64 {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret cli_diagnostic.refuse(fail.message("failed to initialise allocator")); }
    val sr: res[session.Session, fail.Fail] = session.init(?a);
    if (sel sr.err) { ret cli_diagnostic.refuse(fail.message("failed to initialise a session")); }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    s.environ = environ;
    var rep: package_report.Report = cli_diagnostic.dependency_report(?a);
    fin { package_report.dnit(?rep); }
    val rc: i64 = cli_diagnostic.dependency_outcome(?rep, package_verify.project_closure(?s, ?a, root, release, ?rep));
    if (rc == exit.OK) { print.print("ok\n"); }
    ret rc;
}

# `mach dep outdated`: each version-selected identity's pinned release, the highest this
# compiler and every range accept, and the highest release published
fun dep_outdated(root: str, offline: bool, environ: **u8) i64 {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret cli_diagnostic.refuse(fail.message("failed to initialise allocator")); }
    val sr: res[session.Session, fail.Fail] = session.init(?a);
    if (sel sr.err) { ret cli_diagnostic.refuse(fail.message("failed to initialise a session")); }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    s.environ = environ;
    var rep: package_report.Report = cli_diagnostic.dependency_report(?a);
    fin { package_report.dnit(?rep); }
    val opened: res[package_closure.Operation, fail.Fail] = package_closure.open(?s, ?a, root, ?rep);
    if (sel opened.err) { ret cli_diagnostic.refuse(opened.err); }
    var op: package_closure.Operation = opened.ok;
    fin { package_closure.close(?op); }
    val mt_path_r: res[str, A.Error] = types_path.join(?a, root, MANIFEST);
    if (sel mt_path_r.err) { ret cli_diagnostic.refuse(package_closure.oom()); }
    val mt_r: res[manifest.Doc, fail.Fail] = package_closure.parse_file(?a, mt_path_r.ok);
    if (sel mt_r.err) { ret cli_diagnostic.refuse(mt_r.err); }
    var mt:       manifest.Doc                     = mt_r.ok;
    val computed: res[resolve.Outdated, fail.Fail] = resolve.outdated(?op, ?mt, offline);
    if (sel computed.err) { ret cli_diagnostic.dependency_outcome(?rep, err[fail.Fail].err{computed.err}); }
    var shown: resolve.Outdated = computed.ok;
    var i:     usize            = 0;
    for (i < shown.notes.len) {
        print.printlnf("{}", shown.notes.data[i]);
        i = i + 1;
    }
    if (!shown.ranged) {
        print.print("no dependency selects releases by version\n");
        ret exit.OK;
    }
    print.print("dependency  pinned  compatible  latest\n");
    i = 0;
    for (i < shown.rows.len) {
        val row: *resolve.OutdatedRow = ?shown.rows.data[i];
        i = i + 1;
        var note: str = "";
        if (!str_equals(row.latest, row.compatible)) { note = "  (held back: a range excludes the newer release, or it needs a newer compiler)"; }
        print.printlnf("{}  {}  {}  {}{}", row.id, row.pinned, row.compatible, row.latest, note);
    }
    ret exit.OK;
}

fun dep_update(root: str, name: *u8, parsed: *args.DepInvocation, environ: **u8) i64 {
    val all: bool = parsed.all;
    if (!all && name == nil)                             { ret cli_diagnostic.refuse(fail.user(diagnostic_kind.CLI_OPERAND, "usage: mach dep update <path> (<name> | --all)")); }
    if (all && name != nil)                              { ret cli_diagnostic.refuse(fail.user(diagnostic_kind.CLI_FLAG_CONFLICT, "give a name or --all, not both")); }
    if (name != nil && !manifest.is_valid_id(name::str)) { ret cli_diagnostic.refuse(fail.user(diagnostic_kind.MANIFEST_INVALID_NAME, "dependency name must be a portable identifier (letters, digits, '_', '-')")); }

    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret cli_diagnostic.refuse(fail.message("failed to initialise allocator")); }
    val sr: res[session.Session, fail.Fail] = session.init(?a);
    if (sel sr.err) { ret cli_diagnostic.refuse(fail.message("failed to initialise a session")); }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    s.environ = environ;
    var rep: package_report.Report = cli_diagnostic.dependency_report(?a);
    fin { package_report.dnit(?rep); }
    ret cli_diagnostic.dependency_outcome(?rep, package_edit.update(?s, ?a, root, all, name::str, parsed.quiet, parsed.lowest, parsed.offline, ?rep));
}

fun dep_add_source_valid(has_git: bool, has_path: bool, has_ref: bool) bool {
    ret has_git != has_path && (!has_ref || has_git);
}

fun dep_add(root: str, name: *u8, parsed: *args.DepInvocation, environ: **u8) i64 {
    val opt_git:  opt[*u8] = parsed.git;
    val opt_path: opt[*u8] = parsed.path;
    val opt_ref:  opt[*u8] = parsed.ref;
    val opt_ver:  opt[*u8] = parsed.version;
    val has_git:  bool     = sel opt_git.some;
    val has_path: bool     = sel opt_path.some;
    val has_ref:  bool     = sel opt_ref.some;
    val has_ver:  bool     = sel opt_ver.some;
    if (has_ref && has_ver)  { ret cli_diagnostic.refuse(fail.user(diagnostic_kind.CLI_FLAG_CONFLICT, "give --ref or --version, not both")); }
    if (has_ver && !has_git) { ret cli_diagnostic.refuse(fail.user(diagnostic_kind.CLI_FLAG_INAPPLICABLE, "--version applies only to --git dependencies")); }
    if (!dep_add_source_valid(has_git, has_path, has_ref)) {
        if (has_path && has_ref && !has_git) { ret cli_diagnostic.refuse(fail.user(diagnostic_kind.CLI_FLAG_INAPPLICABLE, "--ref applies only to --git dependencies")); }
        ret cli_diagnostic.refuse(fail.user(diagnostic_kind.DEP_SOURCE_COUNT, "give exactly one source: --git <url> or --path <dir>"));
    }
    if (!manifest.is_valid_id(name::str)) { ret cli_diagnostic.refuse(fail.user(diagnostic_kind.MANIFEST_INVALID_NAME, "dependency name must be a portable identifier (letters, digits, '_', '-')")); }

    var spec: manifest.DepTableSpec;
    spec.name = name::str;
    if (has_git) {
        spec.source  = manifest.DEP_SOURCE_GIT;
        spec.value   = opt_value(opt_git)::str;
        spec.ref     = opt_value(opt_ref)::str;
        spec.version = opt_value(opt_ver)::str;
        if (spec.ref == nil)     { spec.ref = ""; }
        if (spec.version == nil) { spec.version = ""; }
    }
    or {
        spec.source  = manifest.DEP_SOURCE_PATH;
        spec.value   = opt_value(opt_path)::str;
        spec.ref     = "";
        spec.version = "";
    }
    ret mutate_manifest(root, ?spec, name::str, true, false, parsed.quiet, true, parsed.offline, environ);
}

fun dep_remove(root: str, name: *u8, parsed: *args.DepInvocation, environ: **u8) i64 {
    if (!manifest.is_valid_id(name::str)) { ret cli_diagnostic.refuse(fail.user(diagnostic_kind.MANIFEST_INVALID_NAME, "dependency name must be a portable identifier (letters, digits, '_', '-')")); }
    var spec: manifest.DepTableSpec;
    spec.name   = name::str;
    spec.source = manifest.DEP_SOURCE_PATH;
    spec.value  = "";
    spec.ref    = "";
    ret mutate_manifest(root, ?spec, name::str, false, parsed.purge, parsed.quiet, true, false, environ);
}

fun mutate_manifest(root: str, spec: *manifest.DepTableSpec, name: str, adding: bool, purge: bool,
    quiet: bool, realize: bool, offline: bool, environ: **u8) i64 {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret cli_diagnostic.refuse(fail.message("failed to initialise allocator")); }
    val sr: res[session.Session, fail.Fail] = session.init(?a);
    if (sel sr.err) { ret cli_diagnostic.refuse(fail.message("failed to initialise a session")); }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    s.environ = environ;
    var rep: package_report.Report = cli_diagnostic.dependency_report(?a);
    fin { package_report.dnit(?rep); }
    ret cli_diagnostic.dependency_outcome(?rep, package_edit.change(?s, ?a, root, spec, name, adding, purge, quiet, realize, offline, ?rep));
}

fun dep_list(root: str, environ: **u8) i64 {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret cli_diagnostic.refuse(fail.message("failed to initialise allocator")); }
    val sr: res[session.Session, fail.Fail] = session.init(?a);
    if (sel sr.err) { ret cli_diagnostic.refuse(fail.message("failed to initialise a session")); }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    s.environ = environ;
    var rep: package_report.Report = cli_diagnostic.dependency_report(?a);
    fin { package_report.dnit(?rep); }
    val opened: res[package_closure.Operation, fail.Fail] = package_closure.open(?s, ?a, root, ?rep);
    if (sel opened.err) { ret cli_diagnostic.refuse(opened.err); }
    var op: package_closure.Operation = opened.ok;
    fin { package_closure.close(?op); }
    var lines: Vector[str] = collections_vector.init[str](?a);
    val rc:    i64         = cli_diagnostic.dependency_outcome(?rep, package_list.lines(?op, ?lines));
    var i:     usize       = 0;
    for (i < lines.len) {
        print.printlnf("{}", lines.data[i]);
        i = i + 1;
    }
    ret rc;
}

fun opt_value(found: opt[*u8]) *u8 {
    if (sel found.none) { ret ""; }
    ret found.some;
}

# the dependency commands' exit code for how an engine operation ended, rendered as the
# command renders it
#[testing]
fun t_code(rep: *package_report.Report, r: err[fail.Fail]) i64 {
    ret cli_diagnostic.dependency_outcome(rep, r);
}

#[testing]
fun t_begin(edit: *package_edit.Edit, a: *A.Allocator, root: str) err[fail.Fail] {
    ret package_edit.begin(edit, root);
}

# close the edit as a command does after its work ended with `code`
#[testing]
fun t_finish(edit: *package_edit.Edit, code: i64) i64 {
    val closed: err[fail.Fail] = package_edit.finish(edit);
    if (sel closed.err) {
        val failed: i64 = cli_diagnostic.refuse(closed.err);
        if (code == exit.OK) { ret failed; }
    }
    ret code;
}

# a test makes one step of an engine operation fail by substituting the operation's source and
# pin members: the named call is refused once `passes` of it went through, and every other call
# is the member's own
#[testing]
val T_ACQUIRE:      u8 = 1;
#[testing]
val T_HYDRATE:      u8 = 2;
#[testing]
val T_PIN_MODE:     u8 = 3;
#[testing]
val T_PIN_RECORDED: u8 = 4;

#[testing]
rec Refusal {
    call:      u8;
    passes:    u32;
    failure:   fail.Fail;
    checkouts: package_source.Checkouts;
    pins:      package_pin.Pin;
}

# the refusal the substituted calls consult, since the member's own context is what they receive
#[testing]
var t_refusal: *Refusal = nil;

#[testing]
fun t_refuse(call: u8, passes: u32, failure: fail.Fail) Refusal {
    ret Refusal{call: call, passes: passes, failure: failure};
}

#[testing]
fun t_substitute(op: *package_closure.Operation, refusal: *Refusal) {
    t_refusal = refusal;
    if (refusal == nil) { ret; }
    refusal.checkouts    = op.checkouts;
    refusal.pins         = op.pins;
    op.checkouts.acquire = t_refusing_acquire;
    op.checkouts.hydrate = t_refusing_hydrate;
    op.pins.mode         = t_refusing_pin_mode;
    op.pins.recorded     = t_refusing_pin_recorded;
}

#[testing]
fun t_refused(call: u8) bool {
    if (t_refusal == nil || t_refusal.call != call) { ret false; }
    if (t_refusal.passes > 0) {
        t_refusal.passes = t_refusal.passes - 1;
        ret false;
    }
    ret true;
}

#[testing]
fun t_refusing_acquire(ctx: ptr, q: *package_source.Acquisition) res[u8, fail.Fail] {
    if (t_refused(T_ACQUIRE)) { ret res[u8, fail.Fail].err{t_refusal.failure}; }
    ret t_refusal.checkouts.acquire(ctx, q);
}

#[testing]
fun t_refusing_hydrate(ctx: ptr, root: str, id: str, dir: str, selector: str, ranged: bool, offline: bool) res[bool, fail.Fail] {
    if (t_refused(T_HYDRATE)) { ret res[bool, fail.Fail].err{t_refusal.failure}; }
    ret t_refusal.checkouts.hydrate(ctx, root, id, dir, selector, ranged, offline);
}

#[testing]
fun t_refusing_pin_mode(ctx: ptr, root: str) res[u8, fail.Fail] {
    if (t_refused(T_PIN_MODE)) { ret res[u8, fail.Fail].err{t_refusal.failure}; }
    ret t_refusal.pins.mode(ctx, root);
}

#[testing]
fun t_refusing_pin_recorded(ctx: ptr, root: str, id: str, mode: u8) res[bool, fail.Fail] {
    if (t_refused(T_PIN_RECORDED)) { ret res[bool, fail.Fail].err{t_refusal.failure}; }
    ret t_refusal.pins.recorded(ctx, root, id, mode);
}

# an add or remove within an open edit, with one step refused when `refusal` names one
#[testing]
fun t_apply(edit: *package_edit.Edit, s: *session.Session, a: *A.Allocator, root: str, mode: u8,
    spec: *manifest.DepTableSpec, name: str, adding: bool, purge: bool,
    quiet: bool, realize: bool, offline: bool, refusal: *Refusal) i64 {
    var rep: package_report.Report = cli_diagnostic.dependency_report(a);
    fin { package_report.dnit(?rep); }
    val opened: res[package_closure.Operation, fail.Fail] = package_closure.open(s, a, root, ?rep);
    if (sel opened.err) { ret t_code(?rep, err[fail.Fail].err{opened.err}); }
    var op: package_closure.Operation = opened.ok;
    fin { package_closure.close(?op); }
    t_substitute(?op, refusal);
    ret t_code(?rep, package_edit.apply(edit, ?op, mode, spec, name, adding, purge, quiet, realize, offline));
}

# an update, with one step refused when `refusal` names one
#[testing]
fun t_update(s: *session.Session, a: *A.Allocator, root: str, mode: u8, all: bool,
    name: *u8, quiet: bool, lowest: bool, offline: bool, closure: *Vector[package_closure.Request], refusal: *Refusal) i64 {
    var rep: package_report.Report = cli_diagnostic.dependency_report(a);
    fin { package_report.dnit(?rep); }
    val opened: res[package_closure.Operation, fail.Fail] = package_closure.open(s, a, root, ?rep);
    if (sel opened.err) { ret t_code(?rep, err[fail.Fail].err{opened.err}); }
    var op: package_closure.Operation = opened.ok;
    fin { package_closure.close(?op); }
    t_substitute(?op, refusal);
    ret t_code(?rep, package_edit.update_apply(?op, mode, all, name::str, quiet, lowest, offline, closure));
}

#[testing]
fun t_realize(s: *session.Session, a: *A.Allocator, root: str, reqs: *Vector[package_closure.Request],
    quiet: bool, offline: bool, verify_only: bool, candidate: *toml.Table, picks: *Vector[resolver.Choice]) i64 {
    var rep: package_report.Report = cli_diagnostic.dependency_report(a);
    fin { package_report.dnit(?rep); }
    val opened: res[package_closure.Operation, fail.Fail] = package_closure.open(s, a, root, ?rep);
    if (sel opened.err) { ret t_code(?rep, err[fail.Fail].err{opened.err}); }
    var op: package_closure.Operation = opened.ok;
    fin { package_closure.close(?op); }
    ret t_code(?rep, package_closure.realize(?op, reqs, quiet, offline, verify_only, candidate, picks));
}

#[testing]
fun t_list(s: *session.Session, a: *A.Allocator, root: str, out: *Vector[str]) i64 {
    var rep: package_report.Report = cli_diagnostic.dependency_report(a);
    fin { package_report.dnit(?rep); }
    val opened: res[package_closure.Operation, fail.Fail] = package_closure.open(s, a, root, ?rep);
    if (sel opened.err) { ret t_code(?rep, err[fail.Fail].err{opened.err}); }
    var op: package_closure.Operation = opened.ok;
    fin { package_closure.close(?op); }
    ret t_code(?rep, package_list.lines(?op, out));
}

#[testing]
fun t_versions(s: *session.Session, a: *A.Allocator, root: str, doc: *manifest.Doc, lowest: bool, lock: bool,
    unlocked: str, root_notes: bool, walk: *package_closure.Walk) res[resolve.Resolution, fail.Fail] {
    var rep: package_report.Report = cli_diagnostic.dependency_report(a);
    fin { package_report.dnit(?rep); }
    val opened: res[package_closure.Operation, fail.Fail] = package_closure.open(s, a, root, ?rep);
    if (sel opened.err) { ret res[resolve.Resolution, fail.Fail].err{opened.err}; }
    var op: package_closure.Operation = opened.ok;
    fin { package_closure.close(?op); }
    ret resolve.versions(?op, doc, lowest, lock, unlocked, root_notes, walk);
}

test run__plain_project_realizes_and_builds_without_parent_git {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val fixture: str = t_package_repo(?a, "mach_dep_plain_source", "libx", "");
    if (str_empty(fixture)) { ret 2; }
    fin { fs.remove_all(?a, fixture); }
    val root: str = t_root_repo(?a, "mach_dep_plain_root", t_dep_table(?a, "libx", fixture));
    if (str_empty(root)) { ret 3; }
    fin { fs.remove_all(?a, root); }
    val marker_r: res[str, A.Error] = types_path.join(?a, root, ".git");
    if (sel marker_r.err) { ret 4; }
    val marker:       str             = marker_r.ok;
    val remove_all_r: err[fs.FsError] = fs.remove_all(?a, marker);
    if (sel remove_all_r.err)                                          { ret 5; }
    if (pull_project(root, true, git.t_file_transport_environ()) != 0) { ret 6; }
    val exists_r: res[bool, io_error.Error] = fs.exists(marker);
    if (sel exists_r.err)                                                 { ret 99; }
    if ((sel exists_r.ok && exists_r.ok))                                 { ret 7; }
    if (!t_exists_under(?a, root, "dep/libx/.git"))                       { ret 7; }
    if (verify_project(root, false, git.t_file_transport_environ()) != 0) { ret 8; }
    var s:    session.Session;
    var mode: u8 = 0;
    if (!t_session_and_mode(?a, root, ?s, ?mode)) { ret 9; }
    fin { session.dnit(?s); }
    if (mode != package_pin.SUBPROJECT || !t_build_ok(?s, root)) { ret 10; }
    val exists_r2: res[bool, io_error.Error] = fs.exists(marker);
    if (sel exists_r2.err)                  { ret 99; }
    if ((sel exists_r2.ok && exists_r2.ok)) { ret 11; }
    ret 0;
}

test run__a_missing_or_unknown_action_reports_and_fails {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    var av: [3]*u8 = [3]*u8{"mach", "dep", "frobnicate"};
    var n:  usize  = 2;
    for (n <= 3) {
        val ir: res[args.ParsedInvocation, fail.Fail] = args.parse_invocation(?a, n, ?av[0]);
        if (sel ir.err) { ret 2; }
        var inv: args.ParsedInvocation = ir.ok;
        if (run(?av[0], ?inv) != 1) { ret 3; }
        n = n + 1;
    }
    ret 0;
}

#[testing]
fun t_git(a: *A.Allocator, argv: **u8) bool {
    val gr: res[str, exec.Error] = exec.resolve(a, "git");
    if (sel gr.err) { ret false; }
    val git: str = gr.ok;
    argv[0] = git::*u8;
    val rr: res[exec.ExitStatus, exec.Error] = exec.run(git, argv, nil);
    if (sel rr.err) { ret false; }
    val st: exec.ExitStatus = rr.ok;
    ret exec.exited(st) && exec.code(st) == 0;
}

#[testing]
fun t_git3(a: *A.Allocator, dir: str, c1: str, c2: str, c3: str, c4: str, c5: str) bool {
    var av: [9]*u8;
    av[0] = ""::*u8;
    av[1] = "-C"::*u8;
    av[2] = dir::*u8;
    var k: usize = 3;
    if (!str_empty(c1)) {
        av[k] = c1::*u8;
        k     = k + 1;
    }
    if (!str_empty(c2)) {
        av[k] = c2::*u8;
        k     = k + 1;
    }
    if (!str_empty(c3)) {
        av[k] = c3::*u8;
        k     = k + 1;
    }
    if (!str_empty(c4)) {
        av[k] = c4::*u8;
        k     = k + 1;
    }
    if (!str_empty(c5)) {
        av[k] = c5::*u8;
        k     = k + 1;
    }
    av[k] = nil;
    ret t_git(a, ?av[0]);
}

#[testing]
fun t_scratch(a: *A.Allocator, prefix: str) str {
    val tf_r: res[fs.TempFile, fs.FsError] = fs.temp_create(a, prefix);
    if (sel tf_r.err) { ret ""; }
    var tf: fs.TempFile = tf_r.ok;
    val p:  str         = package_closure.own(a, fs.temp_path(?tf));
    fs.temp_close_and_remove(?tf);
    val create_dir_all_r: err[fs.FsError] = fs.create_dir_all(a, p, 0o755);
    if (sel create_dir_all_r.err) { ret ""; }
    ret p;
}

#[testing]
fun t_write(a: *A.Allocator, dir: str, leaf: str, body: str) bool {
    val p_r: res[str, A.Error] = types_path.join(a, dir, leaf);
    if (sel p_r.err) { ret false; }
    val p:             str             = p_r.ok;
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(p, body::*u8, str_len(body), 0o644);
    ret sel write_bytes_r.ok;
}

#[testing]
fun t_init_repo(a: *A.Allocator, dir: str) bool {
    if (!t_git3(a, dir, "init", "-b", "main", "", ""))          { ret false; }
    if (!t_git3(a, dir, "config", "user.email", "t@t", "", "")) { ret false; }
    if (!t_git3(a, dir, "config", "user.name", "t", "", ""))    { ret false; }
    ret t_git3(a, dir, "config", "protocol.file.allow", "always", "", "");
}

#[testing]
fun t_commit_all(a: *A.Allocator, dir: str) bool {
    if (!t_git3(a, dir, "add", "-A", "", "", "")) { ret false; }
    ret t_git3(a, dir, "commit", "-qm", "x", "", "");
}

#[testing]
fun t_package_repo(a: *A.Allocator, prefix: str, id: str, extra: str) str {
    val dir: str = t_scratch(a, prefix);
    if (str_empty(dir)) { ret ""; }
    val body_r: res[str, std_format.FormatError] = std_format.sprint(a,
        "[project]\nmach = \">=5\"\nid = \"{}\"\nversion = \"0.1.0\"\nsrc = \"src\"\nout = \"out\"\n{}\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n", id, extra);
    if (sel body_r.err)                        { ret ""; }
    if (!t_write(a, dir, MANIFEST, body_r.ok)) { ret ""; }
    if (!t_lib_module(a, dir))                 { ret ""; }
    if (!t_init_repo(a, dir))                  { ret ""; }
    if (!t_commit_all(a, dir))                 { ret ""; }
    ret dir;
}

#[testing]
fun t_lib_module(a: *A.Allocator, dir: str) bool {
    val src_r: res[str, A.Error] = types_path.join(a, dir, "src");
    if (sel src_r.err) { ret false; }
    val create_dir_all_r: err[fs.FsError] = fs.create_dir_all(a, src_r.ok, 0o755);
    if (sel create_dir_all_r.err) { ret false; }
    ret t_write(a, dir, "src/lib.mach", "pub fun hello() i32 { ret 1; }\n");
}

#[testing]
fun t_dep_table(a: *A.Allocator, name: str, url: str) str {
    ret t_dep_table_ref(a, name, url, "branch/main");
}

# a path table through the manifest writer, so a host path with backslashes
# lands escaped
#[testing]
fun t_dep_table_path(a: *A.Allocator, name: str, dir: str) str {
    var spec: manifest.DepTableSpec;
    spec.name   = name;
    spec.source = manifest.DEP_SOURCE_PATH;
    spec.value  = dir;
    spec.ref    = "";
    val r: res[str, fail.Fail] = manifest.manifest_add_dep_table(a, "", ?spec);
    if (sel r.err) { ret ""; }
    ret r.ok;
}

#[testing]
fun t_dep_cli(a: *A.Allocator, argc: usize, argv: **u8) i64 {
    val parsed: res[args.ParsedInvocation, fail.Fail] = args.parse_invocation(a, argc, argv);
    if (sel parsed.err) { ret -1; }
    var invocation: args.ParsedInvocation = parsed.ok;
    fin { args.dnit_invocation(a, ?invocation); }
    invocation.environ = git.t_file_transport_environ();
    ret run(argv, ?invocation);
}

# pull and update both sync a path copy with its source, since it has no pin to move
test project__all_actions_select_the_explicit_project_and_sync_path_copies {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val root: str = t_root_repo(?a, "mach_dep_cli_project", "");
    if (str_empty(root)) { ret 2; }
    fin { fs.remove_all(?a, root); }
    val source: str = t_package_repo(?a, "mach_dep_cli_source", "widget", "");
    if (str_empty(source)) { ret 3; }
    fin { fs.remove_all(?a, source); }
    if (!t_write(?a, source, "NEWS", "original\n")) { ret 4; }
    var av: [8]*u8;
    av[0] = "mach"::*u8;
    av[1] = "dep"::*u8;
    av[2] = "add"::*u8;
    av[3] = root::*u8;
    av[4] = "widget"::*u8;
    av[5] = "--path"::*u8;
    av[6] = source::*u8;
    av[7] = "--quiet"::*u8;
    if (t_dep_cli(?a, 8, ?av[0]) != 0)                { ret 5; }
    if (!t_exists_under(?a, root, "dep/widget/NEWS")) { ret 6; }
    if (t_exists_under(?a, root, "dep/widget/.git"))  { ret 7; }
    if (!t_write(?a, source, "NEWS", "updated\n"))    { ret 8; }

    av[2] = "pull"::*u8;
    av[4] = "--quiet"::*u8;
    if (t_dep_cli(?a, 5, ?av[0]) != 0) { ret 9; }
    val pulled_r: res[str, fail.Fail] = t_read_under(?a, root, "dep/widget/NEWS");
    if (sel pulled_r.err) { ret 10; }
    val pulled: str = pulled_r.ok;
    fin { str_free(?a, pulled); }
    if (!str_equals(pulled, "updated\n"))        { ret 11; }
    if (!t_write(?a, source, "NEWS", "third\n")) { ret 11; }

    av[2] = "update"::*u8;
    av[4] = "widget"::*u8;
    av[5] = "--quiet"::*u8;
    if (t_dep_cli(?a, 6, ?av[0]) != 0) { ret 12; }
    val updated_r: res[str, fail.Fail] = t_read_under(?a, root, "dep/widget/NEWS");
    if (sel updated_r.err) { ret 13; }
    val updated: str = updated_r.ok;
    fin { str_free(?a, updated); }
    if (!str_equals(updated, "third\n")) { ret 14; }
    av[2] = "verify"::*u8;
    if (t_dep_cli(?a, 4, ?av[0]) != 0) { ret 15; }
    av[2] = "list"::*u8;
    if (t_dep_cli(?a, 4, ?av[0]) != 0) { ret 16; }
    av[2] = "remove"::*u8;
    av[4] = "widget"::*u8;
    av[5] = "--purge"::*u8;
    if (t_dep_cli(?a, 6, ?av[0]) != 0)          { ret 17; }
    if (t_exists_under(?a, root, "dep/widget")) { ret 18; }
    val manifest_r: res[str, fail.Fail] = t_read_under(?a, root, MANIFEST);
    if (sel manifest_r.err) { ret 19; }
    val text: str = manifest_r.ok;
    fin { str_free(?a, text); }
    if (str_contains(text, "[dep.widget]")) { ret 20; }
    ret 0;
}

test project__missing_extra_and_invalid_project_operands_are_refused {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val root: str = t_root_repo(?a, "mach_dep_cli_invalid", "");
    if (str_empty(root)) { ret 2; }
    fin { fs.remove_all(?a, root); }
    val actions: [6]str = [6]str{"list", "pull", "verify", "update", "add", "remove"};
    var av:      [7]*u8;
    av[0] = "mach"::*u8;
    av[1] = "dep"::*u8;
    var i: usize = 0;
    for (i < 6) {
        av[2] = actions[i]::*u8;
        if (t_dep_cli(?a, 3, ?av[0]) != 1) { ret 3; }
        av[3] = root::*u8;
        av[4] = "widget"::*u8;
        av[5] = "extra"::*u8;
        av[6] = "unexpected"::*u8;
        if (t_dep_cli(?a, 7, ?av[0]) != 1) { ret 4; }
        av[3] = "/nonexistent_mach_dep_project"::*u8;
        var count: usize = 4;
        if (i >= 3)                            { count = 5; }
        if (t_dep_cli(?a, count, ?av[0]) != 1) { ret 5; }
        i = i + 1;
    }
    av[2] = "update"::*u8;
    av[3] = root::*u8;
    av[4] = "widget"::*u8;
    av[5] = "--all"::*u8;
    if (t_dep_cli(?a, 6, ?av[0]) != 1) { ret 6; }
    av[2] = "pull"::*u8;
    if (t_dep_cli(?a, 5, ?av[0]) != 1) { ret 7; }
    ret 0;
}

test project__malformed_source_options_do_not_publish_a_declaration {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val root: str = t_root_repo(?a, "mach_dep_cli_options", "");
    if (str_empty(root)) { ret 2; }
    fin { fs.remove_all(?a, root); }
    val source: str = t_package_repo(?a, "mach_dep_cli_option_source", "widget", "");
    if (str_empty(source)) { ret 3; }
    fin { fs.remove_all(?a, source); }
    val before_r: res[str, fail.Fail] = t_read_under(?a, root, MANIFEST);
    if (sel before_r.err) { ret 4; }
    val before: str = before_r.ok;
    fin { str_free(?a, before); }
    var av: [11]*u8;
    av[0] = "mach"::*u8;
    av[1] = "dep"::*u8;
    av[2] = "add"::*u8;
    av[3] = root::*u8;
    av[4] = "widget"::*u8;
    av[5] = "--path"::*u8;
    av[6] = source::*u8;
    av[7] = "--ref"::*u8;
    if (t_dep_cli(?a, 8, ?av[0]) != 1) { ret 5; }
    av[7] = "--git"::*u8;
    if (t_dep_cli(?a, 8, ?av[0]) != 1) { ret 6; }
    av[7] = "--path"::*u8;
    av[8] = source::*u8;
    if (t_dep_cli(?a, 9, ?av[0]) != 1) { ret 7; }
    av[5] = "--git"::*u8;
    av[7] = "--git"::*u8;
    if (t_dep_cli(?a, 9, ?av[0]) != 1) { ret 8; }
    av[7]  = "--ref"::*u8;
    av[8]  = "branch/main"::*u8;
    av[9]  = "--ref"::*u8;
    av[10] = "branch/main"::*u8;
    if (t_dep_cli(?a, 11, ?av[0]) != 1) { ret 9; }
    val after_r: res[str, fail.Fail] = t_read_under(?a, root, MANIFEST);
    if (sel after_r.err) { ret 10; }
    val after: str = after_r.ok;
    fin { str_free(?a, after); }
    if (!str_equals(before, after) || t_exists_under(?a, root, "dep/widget")) { ret 11; }
    ret 0;
}

#[testing]
fun t_dep_verify_cli(a: *A.Allocator, root: str) i64 {
    var av: [4]*u8;
    av[0] = "mach"::*u8;
    av[1] = "dep"::*u8;
    av[2] = "verify"::*u8;
    av[3] = root::*u8;
    val ir: res[args.ParsedInvocation, fail.Fail] = args.parse_invocation(a, 4, ?av[0]);
    if (sel ir.err) { ret -1; }
    var inv: args.ParsedInvocation = ir.ok;
    if (!inv.has_action || inv.action != args.DEPACT_VERIFY) { ret -1; }
    inv.environ = git.t_file_transport_environ();
    ret run(?av[0], ?inv);
}

#[testing]
fun t_join_owned(a: *A.Allocator, root: str, rel: str) str {
    val p_r: res[str, A.Error] = types_path.join(a, root, rel);
    if (sel p_r.err) { ret ""; }
    ret p_r.ok;
}

#[testing]
fun t_exists_under(a: *A.Allocator, root: str, rel: str) bool {
    val p_r: res[str, A.Error] = types_path.join(a, root, rel);
    if (sel p_r.err) { ret false; }
    val exists_r: res[bool, io_error.Error] = fs.exists(p_r.ok);
    if (sel exists_r.err) { ret false; }
    ret (sel exists_r.ok && exists_r.ok);
}

test closure__three_packages_land_flat_under_the_root {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }

    val fix_b: str = t_package_repo(?a, "mach_dep_fix_b", "b", "");
    if (str_empty(fix_b)) { ret 1; }
    val fix_a: str = t_package_repo(?a, "mach_dep_fix_a", "a", t_dep_table(?a, "b", fix_b));
    if (str_empty(fix_a)) { ret 1; }

    val outer: str = t_scratch(?a, "mach_dep_outer");
    if (str_empty(outer))                                                                                { ret 1; }
    if (!t_write(?a, outer, "README", "outer\n") || !t_init_repo(?a, outer) || !t_commit_all(?a, outer)) { ret 1; }

    val proj_r: res[str, A.Error] = types_path.join(?a, outer, "cases/one");
    if (sel proj_r.err) { ret 1; }
    val proj:             str             = proj_r.ok;
    val create_dir_all_r: err[fs.FsError] = fs.create_dir_all(?a, proj, 0o755);
    if (sel create_dir_all_r.err) { ret 1; }
    val root_body_r: res[str, std_format.FormatError] = std_format.sprint(?a,
        "[project]\nmach = \">=5\"\nid = \"root\"\nversion = \"0.1.0\"\nsrc = \"src\"\nout = \"out\"\n{}\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n", t_dep_table(?a, "a", fix_a));
    if (sel root_body_r.err)                          { ret 1; }
    if (!t_write(?a, proj, MANIFEST, root_body_r.ok)) { ret 1; }

    var bad: i32 = 0;
    if (pull_project(proj, true, git.t_file_transport_environ()) != 0) { bad = 1; }
    if (!t_exists_under(?a, proj, "dep/a/mach.toml"))                  { bad = 1; }
    if (!t_exists_under(?a, proj, "dep/b/mach.toml"))                  { bad = 1; }
    if (t_exists_under(?a, proj, "dep/a/dep"))                         { bad = 1; }
    if (t_dep_verify_cli(?a, proj) != 0)                               { bad = 1; }

    val b_dir_r: res[str, A.Error] = types_path.join(?a, proj, "dep/b");
    if (sel b_dir_r.ok)                  { fs.remove_all(?a, b_dir_r.ok); }
    if (t_dep_verify_cli(?a, proj) != 1) { bad = 1; }

    fs.remove_all(?a, outer);
    fs.remove_all(?a, fix_a);
    fs.remove_all(?a, fix_b);
    ret bad;
}

test closure__one_identity_two_selections_names_both_chains {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }

    val fix_b1: str = t_package_repo(?a, "mach_dep_b1", "b", "");
    val fix_b2: str = t_package_repo(?a, "mach_dep_b2", "b", "");
    if (str_empty(fix_b1) || str_empty(fix_b2)) { ret 1; }
    val fix_a: str = t_package_repo(?a, "mach_dep_ca", "a", t_dep_table(?a, "b", fix_b1));
    val fix_c: str = t_package_repo(?a, "mach_dep_cc", "c", t_dep_table(?a, "b", fix_b2));
    if (str_empty(fix_a) || str_empty(fix_c)) { ret 1; }

    val outer: str = t_scratch(?a, "mach_dep_outer2");
    if (str_empty(outer))                                                                                { ret 1; }
    if (!t_write(?a, outer, "README", "outer\n") || !t_init_repo(?a, outer) || !t_commit_all(?a, outer)) { ret 1; }
    val proj_r: res[str, A.Error] = types_path.join(?a, outer, "cases/two");
    if (sel proj_r.err) { ret 1; }
    val proj:             str             = proj_r.ok;
    val create_dir_all_r: err[fs.FsError] = fs.create_dir_all(?a, proj, 0o755);
    if (sel create_dir_all_r.err) { ret 1; }
    val body_r: res[str, std_format.FormatError] = std_format.sprint(?a,
        "[project]\nmach = \">=5\"\nid = \"root\"\nversion = \"0.1.0\"\nsrc = \"src\"\nout = \"out\"\n{}{}\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n",
        t_dep_table(?a, "a", fix_a), t_dep_table(?a, "c", fix_c));
    if (sel body_r.err)                          { ret 1; }
    if (!t_write(?a, proj, MANIFEST, body_r.ok)) { ret 1; }

    var bad: i32 = 0;
    if (pull_project(proj, true, git.t_file_transport_environ()) == 0) { bad = 1; }

    var reqs: Vector[package_closure.Request] = collections_vector.init[package_closure.Request](?a);
    fin { package_closure.free_requests(?a, ?reqs); }
    var x: package_closure.Request;
    x.id        = "b";
    x.url       = fix_b1;
    x.src_path  = "";
    x.ref       = "branch/main";
    x.chain     = "root -> a -> b";
    x.root_decl = false;
    x.is_git    = true;
    var y: package_closure.Request;
    y.id        = "b";
    y.url       = fix_b2;
    y.src_path  = "";
    y.ref       = "branch/main";
    y.chain     = "root -> c -> b";
    y.root_decl = false;
    y.is_git    = true;
    val text: str = t_conflict_text(?a, ?y, ?x, ?y);
    if (!t_contains(text, "root -> a -> b")) { bad = 1; }
    if (!t_contains(text, "root -> c -> b")) { bad = 1; }
    if (!t_contains(text, "[dep.b]"))        { bad = 1; }
    if (!t_contains(text, fix_b2))           { bad = 1; }
    # the example table is valid TOML for a host path with backslashes and quotes
    var w: package_closure.Request;
    w.id        = "b";
    w.url       = "C:\\Users\\fixture\\quoted\" repo";
    w.src_path  = "";
    w.ref       = "branch/main";
    w.chain     = "root -> c -> b";
    w.root_decl = false;
    w.is_git    = true;
    val win_text: str = t_conflict_text(?a, ?w, ?x, ?w);
    if (!t_contains(win_text, "git = \"C:\\\\Users\\\\fixture\\\\quoted\\\" repo\"")) { bad = 2; }
    w.url      = "";
    w.src_path = "C:\\Users\\fixture\\local";
    w.is_git   = false;
    val win_path: str = t_conflict_text(?a, ?w, ?x, ?w);
    if (!t_contains(win_path, "path = \"C:\\\\Users\\\\fixture\\\\local\"")) { bad = 3; }

    fs.remove_all(?a, outer);
    fs.remove_all(?a, fix_a);
    fs.remove_all(?a, fix_c);
    fs.remove_all(?a, fix_b1);
    fs.remove_all(?a, fix_b2);
    ret bad;
}

#[testing]
fun t_conflict_text(a: *A.Allocator, subject: *package_closure.Request, x: *package_closure.Request, y: *package_closure.Request) str {
    val r: res[str, fail.Fail] = package_closure.conflict_text(a, subject, x, y);
    if (sel r.err) { ret ""; }
    ret r.ok;
}

#[testing]
fun t_contains(hay: str, needle: str) bool {
    val hn: usize = str_len(hay);
    val nn: usize = str_len(needle);
    if (nn == 0) { ret true; }
    if (nn > hn) { ret false; }
    var i: usize = 0;
    for (i + nn <= hn) {
        var j: usize = 0;
        for (j < nn && hay[i + j] == needle[j]) { j = j + 1; }
        if (j == nn) { ret true; }
        i = i + 1;
    }
    ret false;
}

#[testing]
rec TxnSnapshot {
    manifest_text: str;
    gm_present:    bool;
    gm_text:       str;
    pin:           str;
    realized:      bool;
}

#[testing]
fun t_read_or_empty(a: *A.Allocator, p: str, present: *bool) str {
    val exists_r: res[bool, io_error.Error] = fs.exists(p);
    @present = (sel exists_r.ok && exists_r.ok);
    if (!present[0]) { ret ""; }
    val r: res[str, fs.FsError] = fs.read_string(a, p);
    if (sel r.err) { ret ""; }
    ret r.ok;
}

#[testing]
fun t_snapshot(s: *session.Session, a: *A.Allocator, root: str, id: str) TxnSnapshot {
    var snap:    TxnSnapshot;
    var present: bool              = false;
    val mt_r:    res[str, A.Error] = types_path.join(a, root, MANIFEST);
    snap.manifest_text = "";
    if (sel mt_r.ok) { snap.manifest_text = t_read_or_empty(a, mt_r.ok, ?present); }
    val gm_r: res[str, A.Error] = types_path.join(a, root, ".gitmodules");
    snap.gm_text = "";
    if (sel gm_r.ok) { snap.gm_text = t_read_or_empty(a, gm_r.ok, ?snap.gm_present); }
    snap.pin = "";
    val pin_r: res[str, fail.Fail] = git_gitlink.staged_paths(s, root, "dep");
    if (sel pin_r.ok) { snap.pin = pin_r.ok; }
    val dep_r: res[str, fail.Fail] = package.dep_full_of(a, root, id);
    snap.realized = false;
    if (sel dep_r.ok) {
        val exists_r: res[bool, io_error.Error] = fs.exists(dep_r.ok);
        snap.realized = sel exists_r.ok && exists_r.ok;
    }
    ret snap;
}

#[testing]
fun t_snapshot_equal(x: *TxnSnapshot, y: *TxnSnapshot) bool {
    if (!str_equals(x.manifest_text, y.manifest_text)) { ret false; }
    if (x.gm_present != y.gm_present)                  { ret false; }
    if (!str_equals(x.gm_text, y.gm_text))             { ret false; }
    if (!str_equals(x.pin, y.pin))                     { ret false; }
    if (x.realized != y.realized)                      { ret false; }
    ret true;
}

test add__preflight_and_late_failure_preserve_user_work_and_report_effects {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val fixture: str = t_package_repo(?a, "mach_dep_native_source", "x", "");
    if (str_empty(fixture)) { ret 2; }
    fin { fs.remove_all(?a, fixture); }
    val root: str = t_root_repo(?a, "mach_dep_native_root", "");
    if (str_empty(root)) { ret 3; }
    fin { fs.remove_all(?a, root); }
    if (!t_write(?a, root, "user-note", "keep this untracked file\n")) { ret 4; }
    var s:    session.Session;
    var mode: u8 = 0;
    if (!t_session_and_mode(?a, root, ?s, ?mode)) { ret 5; }
    fin { session.dnit(?s); }
    var spec: manifest.DepTableSpec;
    spec.name   = "x";
    spec.source = manifest.DEP_SOURCE_GIT;
    spec.value  = fixture;
    spec.ref    = "branch/main";
    val before: TxnSnapshot    = t_snapshot(?s, ?a, root, "x");
    var edit:   package_edit.Edit;
    val begun:  err[fail.Fail] = t_begin(?edit, ?a, root);
    if (sel begun.err) {
        t_finish(?edit, 1);
        ret 6;
    }
    # a refusal to check the new dependency out leaves the project as it was
    var refused_checkout: Refusal = t_refuse(T_ACQUIRE, 0, fail.user(diagnostic_kind.DEP_UNREALIZED, "the checkout is refused"));
    val preflight:        i64     = t_apply(?edit, ?s, ?a, root, mode, ?spec, "x", true, false, true, true, false, ?refused_checkout);
    if (t_finish(?edit, preflight) != 1) { ret 7; }
    val unchanged: TxnSnapshot = t_snapshot(?s, ?a, root, "x");
    if (!t_snapshot_equal(?before, ?unchanged)) { ret 8; }
    val edit_begin_r: err[fail.Fail] = t_begin(?edit, ?a, root);
    if (sel edit_begin_r.err) {
        t_finish(?edit, 1);
        ret 9;
    }
    # a failure once the new dependency is checked out, before the closure is pulled, keeps the
    # checkout and its pin and leaves the manifest unpublished
    var refused_pull: Refusal = t_refuse(T_PIN_MODE, 0, fail.environment(diagnostic_kind.GIT_COMMAND, "the pull is refused"));
    val failed:       i64     = t_apply(?edit, ?s, ?a, root, mode, ?spec, "x", true, false, true, true, false, ?refused_pull);
    if (t_finish(?edit, failed) != exit.ENVIRONMENT) { ret 10; }
    val after: TxnSnapshot = t_snapshot(?s, ?a, root, "x");
    if (!str_equals(before.manifest_text, after.manifest_text))                  { ret 11; }
    if (!after.realized || !after.gm_present || !t_contains(after.pin, "dep/x")) { ret 12; }
    if (!t_exists_under(?a, root, "user-note"))                                  { ret 13; }
    # a failure at the last step of the closure pull leaves the manifest unpublished
    val edit_begin_r3: err[fail.Fail] = t_begin(?edit, ?a, root);
    if (sel edit_begin_r3.err) {
        t_finish(?edit, 1);
        ret 18;
    }
    var refused_hydrate: Refusal = t_refuse(T_HYDRATE, 0, fail.environment(diagnostic_kind.GIT_COMMAND, "the fetch is refused"));
    val unpublished:     i64     = t_apply(?edit, ?s, ?a, root, mode, ?spec, "x", true, false, true, true, false, ?refused_hydrate);
    if (t_finish(?edit, unpublished) != exit.ENVIRONMENT) { ret 19; }
    val held: TxnSnapshot = t_snapshot(?s, ?a, root, "x");
    if (!str_equals(before.manifest_text, held.manifest_text))                     { ret 20; }
    if (!held.realized || !t_contains(held.pin, "dep/x"))                          { ret 21; }
    if (!t_write(?a, root, "dep/x/user-edit", "retained after a refused retry\n")) { ret 14; }
    val edit_begin_r2: err[fail.Fail] = t_begin(?edit, ?a, root);
    if (sel edit_begin_r2.err) {
        t_finish(?edit, 1);
        ret 15;
    }
    val retry: i64 = t_apply(?edit, ?s, ?a, root, mode, ?spec, "x", true, false, true, true, false, nil);
    if (t_finish(?edit, retry) == 0)                  { ret 16; }
    if (!t_exists_under(?a, root, "dep/x/user-edit")) { ret 17; }
    ret 0;
}

test run__verify_action_reaches_verification {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }

    val outer: str = t_scratch(?a, "mach_dep_verify_outer");
    if (str_empty(outer))                                                                                { ret 1; }
    if (!t_write(?a, outer, "README", "outer\n") || !t_init_repo(?a, outer) || !t_commit_all(?a, outer)) { ret 1; }
    val proj_r: res[str, A.Error] = types_path.join(?a, outer, "cases/v");
    if (sel proj_r.err) { ret 1; }
    val proj:             str             = proj_r.ok;
    val create_dir_all_r: err[fs.FsError] = fs.create_dir_all(?a, proj, 0o755);
    if (sel create_dir_all_r.err)                                                                                                                                                                                                                                                                                                                                     { ret 1; }
    if (!t_write(?a, proj, MANIFEST, "[project]\nmach = \">=5\"\nid = \"v\"\nversion = \"0.1.0\"\nsrc = \"src\"\nout = \"out\"\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n")) { ret 1; }

    var bad: i32 = 0;
    if (t_dep_verify_cli(?a, proj) != 0) { bad = 3; }

    # a file, or a directory no project id can name, is not a dependency slot
    if (bad == 0) {
        val odd_r: res[str, A.Error] = types_path.join(?a, proj, "dep/.cache");
        if (sel odd_r.err) { bad = 7; }
        if (sel odd_r.ok) {
            val made: err[fs.FsError] = fs.create_dir_all(?a, odd_r.ok, 0o755);
            if (sel made.err) { bad = 7; }
        }
        if (bad == 0 && !t_write(?a, proj, "dep/.DS_Store", "finder\n"))       { bad = 8; }
        if (bad == 0 && !t_write(?a, proj, "dep/notes", "not a dependency\n")) { bad = 8; }
        if (bad == 0 && t_dep_verify_cli(?a, proj) != 0)                       { bad = 9; }
    }

    if (bad == 0) {
        val stray_r: res[str, A.Error] = types_path.join(?a, proj, "dep/ghost");
        if (sel stray_r.ok) {
            val stray:             str             = stray_r.ok;
            val create_dir_all_r2: err[fs.FsError] = fs.create_dir_all(?a, stray, 0o755);
            if (sel create_dir_all_r2.err) { bad = 4; }
        }
        if (t_dep_verify_cli(?a, proj) != 1) { bad = 6; }
    }

    fs.remove_all(?a, outer);
    ret bad;
}

#[testing]
fun t_git_submodule_add(a: *A.Allocator, dir: str, url: str, rel: str) bool {
    var av: [9]*u8;
    av[0] = ""::*u8;
    av[1] = "-C"::*u8;
    av[2] = dir::*u8;
    av[3] = "-c"::*u8;
    av[4] = "protocol.file.allow=always"::*u8;
    av[5] = "submodule"::*u8;
    av[6] = "add"::*u8;
    av[7] = url::*u8;
    av[8] = rel::*u8;
    var full: [10]*u8;
    var i:    usize = 0;
    for (i < 9) {
        full[i] = av[i];
        i       = i + 1;
    }
    full[9] = nil;
    ret t_git(a, ?full[0]);
}

# the root manifest t_root_repo writes, with `extra` in place of its dependency tables
#[testing]
fun t_root_manifest(a: *A.Allocator, extra: str) str {
    val body_r: res[str, std_format.FormatError] = std_format.sprint(a,
        "[project]\nmach = \">=5\"\nid = \"root\"\nversion = \"0.1.0\"\nsrc = \"src\"\nout = \"out\"\n\n[target.host]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[artifact.root]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/root\"\ntargets = [\"*\"]\nlink = []\nneed = []\n{}\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n", extra);
    if (sel body_r.err) { ret ""; }
    ret on_host(body_r.ok);
}

#[testing]
fun t_root_repo(a: *A.Allocator, prefix: str, extra: str) str {
    val dir: str = t_scratch(a, prefix);
    if (str_empty(dir))                                        { ret ""; }
    if (!t_write(a, dir, MANIFEST, t_root_manifest(a, extra))) { ret ""; }
    val src_r: res[str, A.Error] = types_path.join(a, dir, "src");
    if (sel src_r.err) { ret ""; }
    val create_dir_all_r: err[fs.FsError] = fs.create_dir_all(a, src_r.ok, 0o755);
    if (sel create_dir_all_r.err)                                         { ret ""; }
    if (!t_write(a, dir, "src/main.mach", "fun main() i32 { ret 0; }\n")) { ret ""; }
    if (!t_init_repo(a, dir))                                             { ret ""; }
    if (!t_commit_all(a, dir))                                            { ret ""; }
    ret dir;
}

#[testing]
fun t_tagged_b(a: *A.Allocator) str {
    val fix_b: str = t_package_repo(a, "mach_dep_fix_b", "b", "");
    if (str_empty(fix_b))                                                  { ret ""; }
    if (!t_git3(a, fix_b, "tag", "v1.0.0", "", "", ""))                    { ret ""; }
    if (!t_write(a, fix_b, "NEWS", "second\n") || !t_commit_all(a, fix_b)) { ret ""; }
    if (!t_git3(a, fix_b, "tag", "v2.0.0", "", "", ""))                    { ret ""; }
    ret fix_b;
}

#[testing]
fun t_requirer_of_b(a: *A.Allocator, prefix: str, id: str, fix_b: str, ref: str, with_gitlink: bool) str {
    val table: str = t_dep_table_ref(a, "b", fix_b, ref);
    if (str_empty(table)) { ret ""; }
    val dir: str = t_package_repo(a, prefix, id, table);
    if (str_empty(dir)) { ret ""; }
    if (with_gitlink) {
        if (!t_git_submodule_add(a, dir, fix_b, "dep/b")) { ret ""; }
        if (!t_commit_all(a, dir))                        { ret ""; }
    }
    ret dir;
}

#[testing]
fun t_dep_table_ref(a: *A.Allocator, name: str, url: str, ref: str) str {
    var spec: manifest.DepTableSpec;
    spec.name   = name;
    spec.source = manifest.DEP_SOURCE_GIT;
    spec.value  = url;
    spec.ref    = ref;
    val r: res[str, fail.Fail] = manifest.manifest_add_dep_table(a, "", ?spec);
    if (sel r.err) { ret ""; }
    ret r.ok;
}

#[testing]
fun t_session_and_mode(a: *A.Allocator, root: str, s: *session.Session, mode: *u8) bool {
    val sr: res[session.Session, fail.Fail] = session.init(a);
    if (sel sr.err) { ret false; }
    @s        = sr.ok;
    s.environ = git.t_file_transport_environ();
    val mode_r: res[u8, fail.Fail] = git_gitlink.recording_mode(s, root);
    if (sel mode_r.err) {
        session.dnit(s);
        ret false;
    }
    @mode = mode_r.ok;
    ret true;
}

#[testing]
fun t_build_ok(s: *session.Session, root: str) bool {
    val setup_registry_r: err[fail.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) { ret false; }
    var pick: manifest.Selection;
    pick.target       = "";
    pick.profile      = "";
    pick.artifact     = "";
    pick.want_lib     = false;
    pick.has_artifact = false;
    val pr: res[project.Project, fail.Fail] = driver.build_project_sel(s, root, ?pick);
    if (sel pr.err) {
        val f: fail.Fail = pr.err;
        if (fail.describe(f) != nil) {
            print.eprint("build: ");
            print.eprint(fail.describe(f));
            print.eprint("\n");
        }
        ret false;
    }
    var p: project.Project = pr.ok;
    project.dnit_project(?p);
    ret true;
}

test pull__a_fresh_clone_initializes_the_committed_gitlinks_in_place {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val fix_b: str = t_tagged_b(?a);
    if (str_empty(fix_b)) { ret 1; }
    val fix_a: str = t_requirer_of_b(?a, "mach_dep_fix_a", "a", fix_b, "branch/main", true);
    if (str_empty(fix_a)) { ret 1; }
    val proj: str = t_root_repo(?a, "mach_dep_clone_src", t_dep_table(?a, "a", fix_a));
    if (str_empty(proj)) { ret 1; }
    var bad: i32 = 0;
    if (pull_project(proj, true, git.t_file_transport_environ()) != 0) { bad = 1; }
    if (!t_commit_all(?a, proj))                                       { bad = 2; }
    val clone: str = t_scratch(?a, "mach_dep_clone_dst");
    if (str_empty(clone)) { ret 1; }
    var av: [6]*u8;
    av[0] = ""::*u8;
    av[1] = "clone"::*u8;
    av[2] = "-q"::*u8;
    av[3] = proj::*u8;
    av[4] = clone::*u8;
    av[5] = nil;
    if (bad == 0 && !t_git(?a, ?av[0]))                                                    { bad = 3; }
    if (bad == 0 && !t_git3(?a, clone, "config", "protocol.file.allow", "always", "", "")) { bad = 4; }
    if (bad == 0 && !t_exists_under(?a, clone, "dep/a"))                                   { bad = 5; }
    if (bad == 0 && t_exists_under(?a, clone, "dep/a/.git"))                               { bad = 6; }
    if (bad == 0 && pull_project(clone, true, git.t_file_transport_environ()) != 0)        { bad = 7; }
    if (bad == 0 && !t_exists_under(?a, clone, "dep/a/mach.toml"))                         { bad = 8; }
    if (bad == 0 && !t_exists_under(?a, clone, "dep/b/mach.toml"))                         { bad = 9; }
    if (bad == 0 && verify_project(clone, false, git.t_file_transport_environ()) != 0)     { bad = 10; }
    fs.remove_all(?a, clone);
    fs.remove_all(?a, proj);
    fs.remove_all(?a, fix_a);
    fs.remove_all(?a, fix_b);
    ret bad;
}

# a dependency table selecting releases by `range`, through the manifest writer
#[testing]
fun t_dep_table_range(a: *A.Allocator, name: str, url: str, range: str) str {
    var spec: manifest.DepTableSpec;
    spec.name    = name;
    spec.source  = manifest.DEP_SOURCE_GIT;
    spec.value   = url;
    spec.ref     = "";
    spec.version = range;
    val r: res[str, fail.Fail] = manifest.manifest_add_dep_table(a, "", ?spec);
    if (sel r.err) { ret ""; }
    ret r.ok;
}

# a subproject of `proj` at `rel`: a package manifest carrying `extra`, and a
# committed gitlink for `id` at `rel`/dep/`id` checked out at `tag` of `url`
#[testing]
fun t_subproject_with_gitlink(a: *A.Allocator, proj: str, rel: str, id: str, extra: str, url: str, tag: str) bool {
    val sub:   str               = t_join_owned(a, proj, rel);
    val src_r: res[str, A.Error] = types_path.join(a, sub, "src");
    if (sel src_r.err) { ret false; }
    val made: err[fs.FsError] = fs.create_dir_all(a, src_r.ok, 0o755);
    if (sel made.err) { ret false; }
    val body_r: res[str, std_format.FormatError] = std_format.sprint(a,
        "[project]\nmach = \">=5\"\nid = \"consumer\"\nversion = \"0.1.0\"\nsrc = \"src\"\nout = \"out\"\n[profile.debug]\nopt = 0\ndebug = false\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n{}\n", extra);
    if (sel body_r.err)                                                       { ret false; }
    if (!t_write(a, sub, MANIFEST, body_r.ok))                                { ret false; }
    if (!t_write(a, sub, "src/lib.mach", "pub fun hello() i32 { ret 1; }\n")) { ret false; }
    val link_r: res[str, std_format.FormatError] = std_format.sprint(a, "{}/dep/{}", rel, id);
    if (sel link_r.err)                                                                      { ret false; }
    if (!t_git_submodule_add(a, proj, url, link_r.ok))                                       { ret false; }
    if (!t_git3(a, t_join_owned(a, proj, link_r.ok), "checkout", "-q", "--detach", tag, "")) { ret false; }
    ret t_commit_all(a, proj);
}

# the object id the index of the repository enclosing `root` records for dep/`id`, or ""
#[testing]
fun t_staged_gitlink_under(a: *A.Allocator, root: str, id: str) str {
    var s:    session.Session;
    var mode: u8 = 0;
    if (!t_session_and_mode(a, root, ?s, ?mode)) { ret ""; }
    fin { session.dnit(?s); }
    val link: res[opt[str], fail.Fail] = git_gitlink.read(?s, root, id);
    if (sel link.err) { ret ""; }
    val staged: opt[str] = link.ok;
    if (sel staged.none) { ret ""; }
    ret package_closure.own(a, staged.some);
}

# a subproject's committed gitlink is the pin of its range declaration exactly as
# the root's is: on a fresh clone, `pull <subproject>` initializes the gitlink at
# its recorded commit rather than cloning the source's default branch
test pull__a_subprojects_committed_gitlink_pins_its_range_declaration {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val fix: str = t_released(?a);
    if (str_empty(fix)) { ret 1; }
    val proj: str = t_root_repo(?a, "mach_dep_sub_src", "");
    if (str_empty(proj)) { ret 1; }
    val table: str = t_dep_table_range(?a, "vb", fix, "^1");
    if (str_empty(table))                                                                  { ret 1; }
    if (!t_subproject_with_gitlink(?a, proj, "test/consumer", "vb", table, fix, "v1.0.0")) { ret 1; }
    val pinned: str = t_head_under(?a, proj, "test/consumer/dep/vb");
    val latest: str = t_head_under(?a, fix, "");
    if (str_empty(pinned) || str_empty(latest) || str_equals(pinned, latest)) { ret 1; }

    val clone: str = t_scratch(?a, "mach_dep_sub_dst");
    if (str_empty(clone)) { ret 1; }
    var av: [6]*u8;
    av[0] = ""::*u8;
    av[1] = "clone"::*u8;
    av[2] = "-q"::*u8;
    av[3] = proj::*u8;
    av[4] = clone::*u8;
    av[5] = nil;
    var bad: i32 = 0;
    if (!t_git(?a, ?av[0]))                                                                { bad = 2; }
    if (bad == 0 && !t_git3(?a, clone, "config", "protocol.file.allow", "always", "", "")) { bad = 3; }
    if (bad == 0 && !t_exists_under(?a, clone, "test/consumer/dep/vb"))                    { bad = 4; }
    if (bad == 0 && t_exists_under(?a, clone, "test/consumer/dep/vb/.git"))                { bad = 5; }
    val sub: str = t_join_owned(?a, clone, "test/consumer");
    if (bad == 0 && pull_project(sub, true, git.t_file_transport_environ()) != 0)         { bad = 6; }
    if (bad == 0 && !t_exists_under(?a, clone, "test/consumer/dep/vb/mach.toml"))         { bad = 7; }
    if (bad == 0 && !str_equals(t_head_under(?a, clone, "test/consumer/dep/vb"), pinned)) { bad = 8; }
    if (bad == 0 && !t_release_is(?a, sub, "dep/vb", "1.0.0"))                            { bad = 9; }
    # a second pull finds the pin realized and changes nothing
    if (bad == 0 && pull_project(sub, true, git.t_file_transport_environ()) != 0)         { bad = 10; }
    if (bad == 0 && !str_equals(t_head_under(?a, clone, "test/consumer/dep/vb"), pinned)) { bad = 11; }
    # update moves the pin: the range's highest release is checked out and the
    # subproject's gitlink is staged at it in the enclosing repository
    var up: [4]str = [4]str{"update", sub, "vb", "--quiet"};
    if (bad == 0 && t_dep_cli_args(?a, ?up[0], 4) != 0)        { bad = 12; }
    if (bad == 0 && !t_release_is(?a, sub, "dep/vb", "1.1.0")) { bad = 13; }
    val moved: str = t_head_under(?a, clone, "test/consumer/dep/vb");
    if (bad == 0 && (str_empty(moved) || str_equals(moved, pinned)))           { bad = 14; }
    if (bad == 0 && !str_equals(t_staged_gitlink_under(?a, sub, "vb"), moved)) { bad = 15; }
    fs.remove_all(?a, clone);
    fs.remove_all(?a, proj);
    fs.remove_all(?a, fix);
    ret bad;
}

test add__a_dependency_with_its_own_committed_gitlink_lands_flat_and_the_root_builds {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val fix_b: str = t_tagged_b(?a);
    if (str_empty(fix_b)) { ret 1; }
    val fix_a: str = t_requirer_of_b(?a, "mach_dep_fix_a", "a", fix_b, "branch/main", true);
    if (str_empty(fix_a)) { ret 1; }
    val proj: str = t_root_repo(?a, "mach_dep_add_root", "");
    if (str_empty(proj)) { ret 1; }
    var s:    session.Session;
    var mode: u8 = 0;
    if (!t_session_and_mode(?a, proj, ?s, ?mode)) { ret 1; }
    var bad:  i32 = 0;
    var spec: manifest.DepTableSpec;
    spec.name   = "a";
    spec.source = manifest.DEP_SOURCE_GIT;
    spec.value  = fix_a;
    spec.ref    = "branch/main";
    var edit:  package_edit.Edit;
    val txn_r: err[fail.Fail] = t_begin(?edit, ?a, proj);
    if (sel txn_r.err) { bad = 1; }
    if (sel txn_r.ok) {
        val applied: i64 = t_apply(?edit, ?s, ?a, proj, mode, ?spec, "a", true, false, true, true, false, nil);
        if (t_finish(?edit, applied) != 0) { bad = 2; }
    }
    if (bad == 0 && !t_exists_under(?a, proj, "dep/a/mach.toml"))                     { bad = 3; }
    if (bad == 0 && !t_exists_under(?a, proj, "dep/b/mach.toml"))                     { bad = 4; }
    if (bad == 0 && verify_project(proj, false, git.t_file_transport_environ()) != 0) { bad = 5; }
    if (bad == 0 && !t_build_ok(?s, proj))                                            { bad = 6; }
    session.dnit(?s);
    fs.remove_all(?a, proj);
    fs.remove_all(?a, fix_a);
    fs.remove_all(?a, fix_b);
    ret bad;
}

test verify__a_requirers_exact_selector_is_checked_against_the_gitlink_unless_the_root_overrides {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val fix_b: str = t_tagged_b(?a);
    if (str_empty(fix_b)) { ret 1; }
    val fix_a: str = t_requirer_of_b(?a, "mach_dep_fix_a", "a", fix_b, "tag/v1.0.0", false);
    if (str_empty(fix_a)) { ret 1; }
    val proj: str = t_root_repo(?a, "mach_dep_verify_root", t_dep_table(?a, "a", fix_a));
    if (str_empty(proj)) { ret 1; }
    var bad: i32 = 0;
    if (pull_project(proj, true, git.t_file_transport_environ()) != 0)                { bad = 1; }
    if (bad == 0 && !t_commit_all(?a, proj))                                          { bad = 2; }
    if (bad == 0 && verify_project(proj, false, git.t_file_transport_environ()) != 0) { bad = 3; }
    val dep_b_r: res[str, A.Error] = types_path.join(?a, proj, "dep/b");
    if (sel dep_b_r.err) { ret 1; }
    val dep_b: str = dep_b_r.ok;
    if (bad == 0 && !t_git3(?a, dep_b, "checkout", "-q", "v2.0.0", "", ""))           { bad = 4; }
    if (bad == 0 && !t_git3(?a, proj, "add", "dep/b", "", "", ""))                    { bad = 5; }
    if (bad == 0 && verify_project(proj, false, git.t_file_transport_environ()) == 0) { bad = 6; }
    val head:       str                              = on_host("[project]\nmach = \">=5\"\nid = \"root\"\nversion = \"0.1.0\"\nsrc = \"src\"\nout = \"out\"\n\n[target.host]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[artifact.root]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/root\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n");
    val override_r: res[str, std_format.FormatError] = std_format.sprint(?a, "{}{}{}", head, t_dep_table(?a, "a", fix_a), t_dep_table_ref(?a, "b", fix_b, "branch/main"));
    if (sel override_r.err)                                                           { ret 1; }
    if (bad == 0 && !t_write(?a, proj, MANIFEST, on_host(override_r.ok)))             { bad = 7; }
    if (bad == 0 && verify_project(proj, false, git.t_file_transport_environ()) != 0) { bad = 8; }
    fs.remove_all(?a, proj);
    fs.remove_all(?a, fix_a);
    fs.remove_all(?a, fix_b);
    ret bad;
}

