use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.fail;
use std_args: std.args;
use std.collections.slice.Slice;
use collections_vector: std.collections.vector;
use std.collections.vector.Vector;
use std_format: std.format;
use std.print;
use std.process.exec;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use types_path: std.types.path;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use A: std.allocator;

use mach.cli.args;
use cli_diagnostic: mach.cli.diagnostic;
use mach.cli.exit;
use mach.cli.util;
use mach.lang.driver.project;
use manifest_edit:   mach.lang.manifest.edit;
use manifest_load:   mach.lang.manifest.load;
use manifest_schema: mach.lang.manifest.schema;
