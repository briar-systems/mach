# `mach info`: the version and the host target, or with `targets` every target a build can be made
# for, as a page for a person or, under `--report json` and `--report lines`, as the `host` and
# `target` records (doc/language/report-records.md)

use diagnostic_kind: mach.base.diagnostic.kind;
use mach.base.fail;
use std_args: std.args;
use std.collections.slice.Slice;
use std_format: std.format;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_is_empty;
use std.types.string.str_len;

use A: std.allocator;
use std.collections.vector;
use std.collections.vector.Vector;

use mach.base.textbuild;
use base_version: mach.base.version;
use mach.cli.args;
use cli_diagnostic: mach.cli.diagnostic;
use mach.cli.exit;
use manifest_target: mach.manifest.target;
use mach.report.record;
use mach_target: mach.target;
use mach.target.assembled;
use mach.target.resolved;
use mink_fail: mink.base.fail;
use mink.base.vectors;
use mink_target: mink.catalog.target;

# length of FLAGS
val FLAGS_N: usize = 2;
# the flags mach info takes
val FLAGS: [FLAGS_N]*std_args.Flag = [FLAGS_N]*std_args.Flag{?args.HELP, ?args.REPORT};

# `mach info`
pub val COMMAND: std_args.Command = std_args.Command{name: "info", aliases: args.NO_WORDS, help: "show the host target, or every target", usage: "[targets]", flags: Slice[*std_args.Flag]{data: ?FLAGS[0], size: FLAGS_N}, commands: args.NO_COMMANDS, operand_min: 0, operand_max: 1, passthrough: false};
# what mach holds `mach info` to beyond the parse
pub val POLICY: args.Policy = args.Policy{refused: args.NO_FLAGS, refusal: "", conflicts: args.NO_CONFLICTS};

# `mach info`: print "mach <version>" and the host target this binary resolves for the
# machine it runs on, or with the verb `targets` every target a build can be made for; any other
# verb is an error. under `--report json` and `--report lines` the page is a `host` record and
# the listing a `target` record a row, in place of the text
# ---
# cx:  the call
# ret: exit.OK, or a user failure for a usage error, or a host resolution failure
pub fun run(cx: *args.Call) res[i64, fail.Fail] {
    val operand:      *u8  = args.operand(cx.inv, 0);
    val show_targets: bool = operand != nil && str_equals(operand::str, "targets");
    if (operand != nil && !show_targets) {
        ret res[i64, fail.Fail].err{fail.user(diagnostic_kind.CLI_OPERAND, "expected 'targets' as the sole info verb")};
    }
    var err_shown: err[fail.Fail] = err[fail.Fail].ok{};
    if (show_targets)      { err_shown = targets(cx); }
    or                     { err_shown = host(cx); }
    if (sel err_shown.err) { ret res[i64, fail.Fail].err{err_shown.err}; }
    ret res[i64, fail.Fail].ok{exit.OK};
}

# `mach info`: the version and the target the host request resolves to, as the page or as a
# `host` record
fun host(cx: *args.Call) err[fail.Fail] {
    val res_host: res[resolved.Target, fail.Fail] = mach_target.host(cx.a);
    if (sel res_host.err) { ret err[fail.Fail].err{res_host.err}; }
    var t:        resolved.Target     = res_host.ok;
    val res_name: res[str, fail.Fail] = manifest_target.tuple_of(cx.a, t.target.sys.name, t.target.arch.name);
    if (sel res_name.err) { ret err[fail.Fail].err{res_name.err}; }
    if (cli_diagnostic.is_records(cx.report)) {
        host_record(cx.report, ?t, res_name.ok);
        ret err[fail.Fail].ok{};
    }
    val res_text: res[str, fail.Fail] = render_host(cx.a, ?t, res_name.ok);
    if (sel res_text.err) { ret err[fail.Fail].err{res_text.err}; }
    std_format.write_str(cli_diagnostic.out(cx.report), res_text.ok);
    ret err[fail.Fail].ok{};
}

# `mach info targets`: every target a build can be made for, as the table or as a `target`
# record a row. the table is written once the listing is released, so a refusal leaves none
fun targets(cx: *args.Call) err[fail.Fail] {
    var specs:        Vector[mink_target.Spec] = vector.init[mink_target.Spec](cx.a);
    val res_table:    res[str, fail.Fail]      = listing(cx, ?specs);
    val err_released: err[mink_fail.Fail]      = vectors.dnit[mink_target.Spec](?specs);
    if (sel res_table.err)    { ret err[fail.Fail].err{res_table.err}; }
    if (sel err_released.err) { ret err[fail.Fail].err{resolved.refusal(cx.a, err_released.err)}; }
    if (res_table.ok != nil)  { std_format.write_str(cli_diagnostic.out(cx.report), res_table.ok); }
    ret err[fail.Fail].ok{};
}

# the targets a build can be made for, gathered into `specs`: their table, or nil where a
# records report took a `target` record each in its place
fun listing(cx: *args.Call, specs: *Vector[mink_target.Spec]) res[str, fail.Fail] {
    val err_gathered: err[fail.Fail] = buildable(cx.a, specs);
    if (sel err_gathered.err)                  { ret res[str, fail.Fail].err{err_gathered.err}; }
    if (!cli_diagnostic.is_records(cx.report)) { ret render_targets(cx.a, specs); }
    val err_written: err[fail.Fail] = target_records(cx.report, cx.a, specs);
    if (sel err_written.err) { ret res[str, fail.Fail].err{err_written.err}; }
    ret res[str, fail.Fail].ok{nil};
}

# every target a build can be made for, appended to `specs`: the rows mink's catalog spells, less
# each no build can be made for, which stays in the catalog and out of the listing
fun buildable(a: *A.Allocator, specs: *Vector[mink_target.Spec]) err[fail.Fail] {
    val err_listed: err[mink_fail.Fail] = mink_target.list(specs);
    if (sel err_listed.err) { ret err[fail.Fail].err{resolved.refusal(a, err_listed.err)}; }
    var kept: usize = 0;
    var j:    usize = 0;
    for (j < specs.len) {
        if (assembled.carried(a, specs.data[j])) {
            specs.data[kept] = specs.data[j];
            kept             = kept + 1;
        }
        j = j + 1;
    }
    specs.len = kept;
    ret err[fail.Fail].ok{};
}

fun append(b: *textbuild.TextBuilder, s: str) {
    val err_tb_append: err[textbuild.Error] = textbuild.tb_append(b, s);
}

fun finish(b: *textbuild.TextBuilder) res[str, fail.Fail] {
    val res_tb_finish: res[str, textbuild.Error] = textbuild.tb_finish(b);
    if (sel res_tb_finish.err) {
        textbuild.tb_dnit(b);
        ret res[str, fail.Fail].err{fail.message("info: failed to build output")};
    }
    ret res[str, fail.Fail].ok{res_tb_finish.ok};
}

# the width of `mach info`'s key column, the widest key and the gap past it
val KEY_W: usize = 12;

# one line of the `mach info` page: its key in the key column, then its value
fun fact_line(b: *textbuild.TextBuilder, key: str, value: str) {
    append(b, key);
    pad(b, str_len(key), KEY_W - 2);
    append(b, value);
    append(b, "\n");
}

# the `mach info` page: the version and the resolved host target `t`, named `name`, one part per
# line, every value taken from the target the host request resolves to
fun render_host(a: *A.Allocator, t: *resolved.Target, name: str) res[str, fail.Fail] {
    var b: textbuild.TextBuilder = textbuild.tb_init(a);
    fact_line(?b, "mach", base_version.MACH_VERSION);
    fact_line(?b, "host", name);
    var facts: [resolved.FACT_COUNT]resolved.Fact;
    resolved.facts(t, ?facts[0]);
    var i: usize = 0;
    for (i < resolved.FACT_COUNT) {
        fact_line(?b, facts[i].key, facts[i].value);
        i = i + 1;
    }
    ret finish(?b);
}

# `s`, nil where it is empty, as the resolved target spells a part it has none of
fun stated(s: str) str {
    if (str_is_empty(s)) { ret nil; }
    ret s;
}

# the resolved host target `t`, named `name`, as a `host` record: the version, then each part
# of the target, null where it has none
fun host_record(r: *cli_diagnostic.Report, t: *resolved.Target, name: str) {
    val m:   *mink_target.Target = ?t.target;
    var env: str                 = nil;
    if (sel m.env.some) { env = m.env.some.name; }
    var code_model: str = nil;
    if (sel m.code_model.some) { code_model = m.code_model.some.name; }
    var linkage: str = nil;
    if (sel m.linkage.some) { linkage = m.linkage.some.name; }
    var o: record.Record;
    cli_diagnostic.record_open(r, ?o, "host");
    record.text(?o, "mach", base_version.MACH_VERSION);
    record.text(?o, "name", name);
    record.text(?o, "sys", m.sys.name);
    record.text(?o, "arch", m.arch.name);
    record.text_or_null(?o, "env", env);
    record.text_or_null(?o, "abi", stated(resolved.abi_name(t)));
    record.text_or_null(?o, "isa", stated(resolved.isa(t)));
    record.text_or_null(?o, "code_model", code_model);
    record.text_or_null(?o, "linkage", linkage);
    record.text(?o, "object", m.format.name);
    record.end(?o);
}

# the parts a target accepts that `mach info targets` lists, and the header of each one's column
val PART_N:    usize       = 4;
val PART_KEYS: [PART_N]str = [PART_N]str{"env", "abi", "code_model", "linkage"};

# the columns `mach info targets` heads besides the parts: the target, and the note a target carries
val TARGET_HEAD: str = "target";
val NOTE_HEAD:   str = "note";

# the choices `spec` accepts for the part at `k` of PART_KEYS, the names joined by
# commas, the default first and marked `*`, and `none` for the hosts that state no environment.
# a linkage depends on the environment, so it is listed for each the target accepts, in the
# environment column's order, as `env:` and its linkages, unprefixed for the hosts with none
fun choices(a: *A.Allocator, spec: mink_target.Spec, k: usize) str {
    var b: textbuild.TextBuilder = textbuild.tb_init(a);
    if (k == 3) { linkages(?b, spec); }
    or {
        var part: mink_target.Part = mink_target.Part.env{};
        if (k == 1)                                              { part = mink_target.Part.abi{}; }
        if (k == 2)                                              { part = mink_target.Part.code_model{}; }
        if (names(?b, spec, ?mink_target.UNNARROWED, part) == 0) { append(?b, "-"); }
    }
    val res_made: res[str, textbuild.Error] = textbuild.tb_finish(?b);
    if (sel res_made.err) { ret "-"; }
    ret res_made.ok;
}

# whether a target can take the environment `c`: one a flag spells, or the hosts with none where
# they are the default, the ones resolve takes with none named
fun takable(c: mink_target.Choice) bool {
    ret c.name != nil || c.default;
}

# the linkages `spec` accepts under each environment a target of it can take, a group a space
# apart
fun linkages(b: *textbuild.TextBuilder, spec: mink_target.Spec) {
    var groups: usize = 0;
    var i:      usize = 0;
    for {
        val opt_accepted: opt[mink_target.Choice] = mink_target.accepted(spec, ?mink_target.UNNARROWED, mink_target.Part.env{}, i);
        if (sel opt_accepted.none) { brk; }
        i = i + 1;
        if (!takable(opt_accepted.some)) { cnt; }
        var n: mink_target.Narrowing = mink_target.UNNARROWED;
        n.env  = opt_accepted.some.name;
        groups = groups + env_linkages(b, spec, ?n, groups);
    }
    if (groups == 0) { append(b, "-"); }
}

# how the linkages of an environment are listed. the linkage follows the convention named where
# the environment's hosts differ by calling convention and none is the default, so there each
# convention lists its own, unless every one accepts the same
# ---
# first: a narrowing the linkages read under, where they are listed once
# abis:  how many conventions list their own, 0 where the linkages are listed once
rec Grouping {
    first: mink_target.Narrowing;
    abis:  usize;
}

# how the linkages `spec` accepts under the environment `n` narrows to are listed
fun grouping(spec: mink_target.Spec, n: *mink_target.Narrowing) Grouping {
    var g:    Grouping = Grouping{first: @n, abis: 0};
    var abis: usize    = 0;
    var same: bool     = true;
    if (count(spec, n, mink_target.Part.linkage{}) == 0) {
        for {
            val opt_accepted: opt[mink_target.Choice] = mink_target.accepted(spec, n, mink_target.Part.abi{}, abis);
            if (sel opt_accepted.none) { brk; }
            var m: mink_target.Narrowing = @n;
            m.abi = opt_accepted.some.name;
            if (abis == 0)                                                     { g.first = m; }
            or (!same_choices(spec, ?g.first, ?m, mink_target.Part.linkage{})) { same = false; }
            abis = abis + 1;
        }
    }
    if (!same) { g.abis = abis; }
    ret g;
}

# the group of linkages `spec` accepts under the environment `n` narrows to, as `env:` and the
# linkages, unprefixed for the hosts with none, or where each convention lists its own a group
# for each as `env/abi:`, with `none` for the hosts with no environment. `before` counts the
# groups already written; answers how many it wrote
fun env_linkages(b: *textbuild.TextBuilder, spec: mink_target.Spec, n: *mink_target.Narrowing, before: usize) usize {
    var g: Grouping = grouping(spec, n);
    if (g.abis == 0) {
        group(b, n.env, nil, before);
        if (names(b, spec, ?g.first, mink_target.Part.linkage{}) == 0) { append(b, "-"); }
        ret 1;
    }
    var k: usize = 0;
    for (k < g.abis) {
        val opt_accepted: opt[mink_target.Choice] = mink_target.accepted(spec, n, mink_target.Part.abi{}, k);
        if (sel opt_accepted.none) { brk; }
        var m: mink_target.Narrowing = @n;
        m.abi = opt_accepted.some.name;
        group(b, n.env, m.abi, before + k);
        if (names(b, spec, ?m, mink_target.Part.linkage{}) == 0) { append(b, "-"); }
        k = k + 1;
    }
    ret k;
}

# the label of a group of linkages: `env:`, `env/abi:` or `none/abi:` for the hosts with no
# environment, and none for those hosts with no convention named
fun group(b: *textbuild.TextBuilder, env: str, abi: str, before: usize) {
    if (before > 0)               { append(b, " "); }
    if (env == nil && abi == nil) { ret; }
    if (env == nil)               { append(b, "none"); }
    or                            { append(b, env); }
    if (abi != nil) {
        append(b, "/");
        append(b, abi);
    }
    append(b, ":");
}

# how many choices `spec` accepts for `part` under `n`
fun count(spec: mink_target.Spec, n: *mink_target.Narrowing, part: mink_target.Part) usize {
    var i: usize = 0;
    for {
        val opt_accepted: opt[mink_target.Choice] = mink_target.accepted(spec, n, part, i);
        if (sel opt_accepted.none) { ret i; }
        i = i + 1;
    }
    ret i;
}

# whether `spec` accepts the same choices for `part`, in the same order and with the same
# default, under `x` and `y`
fun same_choices(spec: mink_target.Spec, x: *mink_target.Narrowing, y: *mink_target.Narrowing, part: mink_target.Part) bool {
    var i: usize = 0;
    for {
        val opt_accepted:      opt[mink_target.Choice] = mink_target.accepted(spec, x, part, i);
        val opt_accepted_spec: opt[mink_target.Choice] = mink_target.accepted(spec, y, part, i);
        if (sel opt_accepted.none || sel opt_accepted_spec.none) { ret sel opt_accepted.none && sel opt_accepted_spec.none; }
        if (sel opt_accepted.some) {
            if (sel opt_accepted_spec.some) {
                if (opt_accepted.some.default != opt_accepted_spec.some.default)      { ret false; }
                if (!str_equals(opt_accepted.some.name, opt_accepted_spec.some.name)) { ret false; }
            }
        }
        i = i + 1;
    }
    ret false;
}

# the choices `spec` accepts for `part` under `n`, joined by commas, the default first and marked
# `*`, and `none` for the hosts that state no environment. answers how many it wrote
fun names(b: *textbuild.TextBuilder, spec: mink_target.Spec, n: *mink_target.Narrowing, part: mink_target.Part) usize {
    var i: usize = 0;
    for {
        val opt_accepted: opt[mink_target.Choice] = mink_target.accepted(spec, n, part, i);
        if (sel opt_accepted.none)         { brk; }
        if (i > 0)                         { append(b, ","); }
        if (opt_accepted.some.default)     { append(b, "*"); }
        if (opt_accepted.some.name == nil) { append(b, "none"); }
        or                                 { append(b, opt_accepted.some.name); }
        i = i + 1;
    }
    ret i;
}

# spaces after a cell of `written` bytes out to `width` and two more, the gap between columns
fun pad(b: *textbuild.TextBuilder, written: usize, width: usize) {
    var k: usize = written;
    for (k < width + 2) {
        append(b, " ");
        k = k + 1;
    }
}

# the `mach info targets` listing of `specs`: a header row, then each target one per line as
# `-t` takes it, then the environments, calling conventions, code models and executable linkages
# it accepts as mink's catalog states them, each column padded to its widest value, and the note
# `needs --isa` beside each whose system bounds the machine not at all
fun render_targets(a: *A.Allocator, specs: *Vector[mink_target.Spec]) res[str, fail.Fail] {
    val n:         usize              = specs.len;
    val res_cells: res[*str, A.Error] = A.allocate[str](a, n * PART_N + 1);
    if (sel res_cells.err) { ret res[str, fail.Fail].err{fail.refused(res_cells.err)}; }
    val cells:  *str              = res_cells.ok;
    var widths: [PART_N + 1]usize = [PART_N + 1]usize{str_len(TARGET_HEAD), 0, 0, 0, 0};
    var noted:  bool              = false;
    var h:      usize             = 0;
    for (h < PART_N) {
        widths[h + 1] = str_len(PART_KEYS[h]);
        h             = h + 1;
    }
    var i: usize = 0;
    for (i < n) {
        val s:   mink_target.Spec = specs.data[i];
        val len: usize            = str_len(s.sys.name) + 1 + str_len(s.arch.name);
        if (len > widths[0]) { widths[0] = len; }
        var k: usize = 0;
        for (k < PART_N) {
            val c: str = choices(a, s, k);
            cells[i * PART_N + k] = c;
            if (str_len(c) > widths[k + 1]) { widths[k + 1] = str_len(c); }
            k = k + 1;
        }
        if (mink_target.needs_isa(s)) { noted = true; }
        i = i + 1;
    }
    var b: textbuild.TextBuilder = textbuild.tb_init(a);
    append(?b, TARGET_HEAD);
    pad(?b, str_len(TARGET_HEAD), widths[0]);
    h = 0;
    for (h < PART_N) {
        append(?b, PART_KEYS[h]);
        if (h < PART_N - 1 || noted) { pad(?b, str_len(PART_KEYS[h]), widths[h + 1]); }
        h = h + 1;
    }
    if (noted) { append(?b, NOTE_HEAD); }
    append(?b, "\n");
    i = 0;
    for (i < n) {
        val s: mink_target.Spec = specs.data[i];
        append(?b, s.sys.name);
        append(?b, "-");
        append(?b, s.arch.name);
        pad(?b, str_len(s.sys.name) + 1 + str_len(s.arch.name), widths[0]);
        var k: usize = 0;
        for (k < PART_N) {
            val c: str = cells[i * PART_N + k];
            append(?b, c);
            if (k < PART_N - 1 || mink_target.needs_isa(s)) { pad(?b, str_len(c), widths[k + 1]); }
            k = k + 1;
        }
        if (mink_target.needs_isa(s)) { append(?b, "needs --isa"); }
        append(?b, "\n");
        i = i + 1;
    }
    ret finish(?b);
}

# the members a choice opens with: whether the target takes it when it names none, then its
# name, null for the hosts that state no environment
fun choice_fields(o: *record.Record, c: mink_target.Choice) {
    record.flag(o, "default", c.default);
    record.text_or_null(o, "name", c.name);
}

# each choice `spec` accepts for `part` under `n`, an element of `l`
# ---
# under: the convention the choices hold under, written as each one's `abi`, nil for whatever
#        the convention; none for a part listed apart from any convention
fun elements(l: *record.List, spec: mink_target.Spec, n: *mink_target.Narrowing, part: mink_target.Part, under: opt[str]) {
    var i: usize = 0;
    for {
        val opt_accepted: opt[mink_target.Choice] = mink_target.accepted(spec, n, part, i);
        if (sel opt_accepted.none) { brk; }
        var c: record.Record;
        record.list_record_begin(l, ?c);
        choice_fields(?c, opt_accepted.some);
        if (sel under.some) { record.text_or_null(?c, "abi", under.some); }
        record.nested_end(?c);
        i = i + 1;
    }
}

# the list `key` of `o`: each choice `spec` accepts for `part` with nothing narrowed
fun choice_list(o: *record.Record, key: str, spec: mink_target.Spec, part: mink_target.Part) {
    var l: record.List;
    record.list_begin(o, key, ?l);
    elements(?l, spec, ?mink_target.UNNARROWED, part, opt[str].none{});
    record.list_end(?l);
}

# the linkages `spec` accepts under the environment `n` narrows to, elements of `l`: listed once
# with a null `abi`, or where each convention lists its own, under each naming it
fun linkage_elements(l: *record.List, spec: mink_target.Spec, n: *mink_target.Narrowing) {
    var g: Grouping = grouping(spec, n);
    if (g.abis == 0) {
        elements(l, spec, ?g.first, mink_target.Part.linkage{}, opt[str].some{nil});
        ret;
    }
    var k: usize = 0;
    for (k < g.abis) {
        val opt_accepted: opt[mink_target.Choice] = mink_target.accepted(spec, n, mink_target.Part.abi{}, k);
        if (sel opt_accepted.none) { brk; }
        var m: mink_target.Narrowing = @n;
        m.abi = opt_accepted.some.name;
        elements(l, spec, ?m, mink_target.Part.linkage{}, opt[str].some{m.abi});
        k = k + 1;
    }
}

# one row of the catalog as a `target` record: its name as `-t` takes it, its system and
# architecture, each environment a target of it can take with the linkages it accepts there, its
# calling conventions and code models, and whether a target spelled so names its instruction set
fun target_record(r: *cli_diagnostic.Report, a: *A.Allocator, spec: mink_target.Spec) err[fail.Fail] {
    val res_name: res[str, fail.Fail] = manifest_target.tuple_of(a, spec.sys.name, spec.arch.name);
    if (sel res_name.err) { ret err[fail.Fail].err{res_name.err}; }
    var o: record.Record;
    cli_diagnostic.record_open(r, ?o, "target");
    record.text(?o, "name", res_name.ok);
    record.text(?o, "sys", spec.sys.name);
    record.text(?o, "arch", spec.arch.name);
    var envs: record.List;
    record.list_begin(?o, "envs", ?envs);
    var i: usize = 0;
    for {
        val opt_accepted: opt[mink_target.Choice] = mink_target.accepted(spec, ?mink_target.UNNARROWED, mink_target.Part.env{}, i);
        if (sel opt_accepted.none) { brk; }
        i = i + 1;
        if (!takable(opt_accepted.some)) { cnt; }
        var n: mink_target.Narrowing = mink_target.UNNARROWED;
        n.env = opt_accepted.some.name;
        var env: record.Record;
        record.list_record_begin(?envs, ?env);
        choice_fields(?env, opt_accepted.some);
        var links: record.List;
        record.list_begin(?env, "linkages", ?links);
        linkage_elements(?links, spec, ?n);
        record.list_end(?links);
        record.nested_end(?env);
    }
    record.list_end(?envs);
    choice_list(?o, "abis", spec, mink_target.Part.abi{});
    choice_list(?o, "code_models", spec, mink_target.Part.code_model{});
    record.flag(?o, "needs_isa", mink_target.needs_isa(spec));
    record.end(?o);
    ret err[fail.Fail].ok{};
}

# every target of `specs` as a `target` record, in the listing's order
fun target_records(r: *cli_diagnostic.Report, a: *A.Allocator, specs: *Vector[mink_target.Spec]) err[fail.Fail] {
    var i: usize = 0;
    for (i < specs.len) {
        val err_written: err[fail.Fail] = target_record(r, a, specs.data[i]);
        if (sel err_written.err) { ret err_written; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}
