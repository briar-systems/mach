use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.fail;
use std_args: std.args;
use std.print;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;

use A:                  std.allocator;
use collections_vector: std.collections.vector;
use std.collections.vector.Vector;

use mach.cli.args;
use mach.cli.exit;
use lang_target: mach.lang.target;
use mach.lang.target.resolved;
use mach.lang.textbuild;
use lang_version: mach.lang.version;

# `--version`, which `mach --version` gives in place of a command word
pub val VERSION: std_args.FlagSpec = std_args.FlagSpec{name: "--version", value: "", arity: std_args.ARITY_FLAG, doc: "print the version string alone on one line", default: "", negatable: false, occurs: std_args.Occurs.once{}, alias_of: nil};

# row count of OWN
val OWN_N: usize = 1;
# the options mach info accepts
val OWN: [OWN_N]*std_args.FlagSpec = [OWN_N]*std_args.FlagSpec{?VERSION};

# length of TABLES
val TABLES_N: usize = 1;
# the option tables mach info accepts
val TABLES: [TABLES_N]std_args.TableRef = [TABLES_N]std_args.TableRef{
    std_args.TableRef{rows: ?OWN[0], n: OWN_N, accepted: nil, docs: nil},
};

# length of CONSTRAINTS
val CONSTRAINTS_N: usize = 1;
# the constraint sentence help prints for info; the info command enforces it
val CONSTRAINTS: [CONSTRAINTS_N]str = [CONSTRAINTS_N]str{
    "--version and a verb cannot be combined",
};

# `mach info`
pub val COMMAND: std_args.CommandSpec = std_args.CommandSpec{name: "info", id: 0, aliases: nil, alias_n: 0, grammar: " [--version | targets]", summary: "show the compiler version and host target, or every supported target", effect: "print the version and the resolved host target one dimension per line, or with targets every (sys, arch, isa, env, abi, object) tuple the owners build one full line each", exits: nil, exit_n: 0, terminator: "", tables: ?TABLES[0], table_n: TABLES_N, refused: nil, refused_n: 0, refusal: "", relations: nil, relation_n: 0, constraints: ?CONSTRAINTS[0], constraint_n: CONSTRAINTS_N, operand_min: 0, operand_max: 1, truncate_at_sep: false, actions: nil, action_n: 0, examples: nil, example_n: 0};

# `mach info`: print "mach <version>" and the host target this binary resolves for the
# machine it runs on. `--version` prints the version alone; the verb `targets` prints
# every target the owners build, one full tuple per line; combining
# `--version` with a verb, or any other verb, is an error
# ---
# cx:  the call
# ret: exit.OK, or a user failure for a usage error, or a host resolution failure
pub fun run(cx: *args.Call) res[i64, fail.Fail] {
    val inv:          *std_args.Invocation = cx.inv;
    val operand:      *u8                    = args.operand(inv, 0);
    val show_version: bool                   = std_args.given(inv, ?VERSION);
    val show_targets: bool                   = operand != nil && str_equals(operand::str, "targets");
    if (operand != nil && !show_targets) {
        ret res[i64, fail.Fail].err{fail.user(diagnostic_kind.CLI_OPERAND, "expected 'targets' as the sole info verb")};
    }
    if (show_version && operand != nil) {
        ret res[i64, fail.Fail].err{fail.user(diagnostic_kind.CLI_FLAG_CONFLICT, "--version and a verb cannot be combined")};
    }

    if (show_version) {
        print.println(lang_version.MACH_VERSION);
        ret res[i64, fail.Fail].ok{exit.OK};
    }

    var text: res[str, fail.Fail] = res[str, fail.Fail].err{fail.message("")};
    if (show_targets) { text = render_targets(cx.a); }
    or                { text = render_host(cx.a); }
    if (sel text.err) { ret res[i64, fail.Fail].err{text.err}; }
    print.print(text.ok);
    ret res[i64, fail.Fail].ok{exit.OK};
}

fun append(b: *textbuild.TextBuilder, s: str) {
    val r: err[textbuild.Error] = textbuild.tb_append(b, s);
}

fun finish(b: *textbuild.TextBuilder) res[str, fail.Fail] {
    val r: res[str, textbuild.Error] = textbuild.tb_finish(b);
    if (sel r.err) {
        textbuild.tb_dnit(b);
        ret res[str, fail.Fail].err{fail.message("info: failed to build output")};
    }
    ret res[str, fail.Fail].ok{r.ok};
}

# the `mach info` page: the version and the resolved host target, one dimension
# per line, every value taken from the target the host request resolves to
fun render_host(a: *A.Allocator) res[str, fail.Fail] {
    var req: lang_target.TargetRequest       = lang_target.host_request();
    val t_r: res[resolved.Target, fail.Fail] = lang_target.resolve(a, ?req);
    if (sel t_r.err) { ret res[str, fail.Fail].err{t_r.err}; }
    var t: resolved.Target       = t_r.ok;
    var b: textbuild.TextBuilder = textbuild.tb_init(a);
    append(?b, "mach ");
    append(?b, lang_version.MACH_VERSION);
    append(?b, "\nhost: ");
    append(?b, t.sys.name);
    append(?b, "-");
    append(?b, t.arch.name);
    append(?b, "\nisa: ");
    append(?b, t.isa);
    append(?b, "\nsys: ");
    append(?b, t.sys.name);
    append(?b, "\nabi: ");
    append(?b, t.abi);
    append(?b, "\nobject: ");
    append(?b, t.format.name);
    append(?b, "\n");
    ret finish(?b);
}

fun env_name(c: *lang_target.Cell) str {
    if (sel c.env.some) { ret c.env.some.name; }
    ret "none";
}

fun max_len(cur: usize, s: str) usize {
    val n: usize = str_len(s);
    if (n > cur) { ret n; }
    ret cur;
}

fun pad(b: *textbuild.TextBuilder, written: usize, width: usize) {
    var i: usize = written;
    for (i < width + 2) {
        append(b, " ");
        i = i + 1;
    }
}

fun column(b: *textbuild.TextBuilder, key: str, value: str, width: usize, last: bool) {
    append(b, key);
    append(b, "=");
    append(b, value);
    if (!last) { pad(b, str_len(key) + 1 + str_len(value), str_len(key) + 1 + width); }
}

# the `mach info targets` listing: one line per target the owners build, the
# `<sys>-<arch>` name then `key=value` for every dimension, each column padded to
# the widest value it holds over the whole listing
fun render_targets(a: *A.Allocator) res[str, fail.Fail] {
    var cells: Vector[lang_target.Cell] = collections_vector.init[lang_target.Cell](a);
    fin { collections_vector.dnit[lang_target.Cell](?cells); }
    val listed: err[fail.Fail] = lang_target.cells(a, ?cells);
    if (sel listed.err) { ret res[str, fail.Fail].err{listed.err}; }

    var w_name: usize = 0;
    var w_isa:  usize = 0;
    var w_os:   usize = 0;
    var w_env:  usize = 0;
    var w_abi:  usize = 0;
    var i:      usize = 0;
    for (i < cells.len) {
        val c:        *lang_target.Cell = ?cells.data[i];
        val name_len: usize             = str_len(c.sys.name) + 1 + str_len(c.arch.name);
        if (name_len > w_name) { w_name = name_len; }
        w_isa = max_len(w_isa, c.isa);
        w_os  = max_len(w_os, c.sys.name);
        w_env = max_len(w_env, env_name(c));
        w_abi = max_len(w_abi, c.abi);
        i     = i + 1;
    }

    var b: textbuild.TextBuilder = textbuild.tb_init(a);
    i = 0;
    for (i < cells.len) {
        val c: *lang_target.Cell = ?cells.data[i];
        append(?b, c.sys.name);
        append(?b, "-");
        append(?b, c.arch.name);
        pad(?b, str_len(c.sys.name) + 1 + str_len(c.arch.name), w_name);
        column(?b, "isa", c.isa, w_isa, false);
        column(?b, "sys", c.sys.name, w_os, false);
        column(?b, "env", env_name(c), w_env, false);
        column(?b, "abi", c.abi, w_abi, false);
        column(?b, "object", c.format.name, 0, true);
        append(?b, "\n");
        i = i + 1;
    }
    ret finish(?b);
}
