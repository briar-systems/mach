use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.fail;
use std.allocator.page;
use std.print;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;

use A: std.allocator;

use mach.cli.args;
use cli_diagnostic: mach.cli.diagnostic;
use mach.cli.exit;
use mach.lang.driver;
use mach.lang.driver.toolchain;
use lang_target: mach.lang.target;
use mach.lang.target.abi;
use catalog_arch: mach.lang.target.catalog.arch;
use mach.lang.target.isa;
use target_model:    mach.lang.target.model;
use target_of:       mach.lang.target.of;
use lang_target_os:  mach.lang.target.os;
use target_registry: mach.lang.target.registry;
use mach.lang.target.tuple;
use mach.lang.textbuild;
use lang_version: mach.lang.version;

# `--version`, which `mach --version` gives in place of a command word
pub val VERSION: args.FlagSpec = args.FlagSpec{name: "--version", value: "", arity: args.ARITY_FLAG, doc: "print the version string alone on one line", default: "", repeatable: false, alias_of: nil};

# row count of OWN
val OWN_N: usize = 1;
# the options mach info accepts
val OWN: [OWN_N]*args.FlagSpec = [OWN_N]*args.FlagSpec{?VERSION};

# length of TABLES
val TABLES_N: usize = 1;
# the option tables mach info accepts
val TABLES: [TABLES_N]args.TableRef = [TABLES_N]args.TableRef{
    args.TableRef{rows: ?OWN[0], n: OWN_N, accepted: nil, docs: nil},
};

# length of CONSTRAINTS
val CONSTRAINTS_N: usize = 1;
# the constraint sentence help prints for info; the info command enforces it
val CONSTRAINTS: [CONSTRAINTS_N]str = [CONSTRAINTS_N]str{
    "--version and a verb cannot be combined",
};

# `mach info`
pub val COMMAND: args.CommandSpec = args.CommandSpec{name: "info", aliases: nil, alias_n: 0, grammar: " [--version | targets]", summary: "show the compiler version and host target, or every supported target", effect: "print the version and the resolved host target one dimension per line, or with targets every supported (os, isa, abi, object) tuple one full line each", exits: nil, exit_n: 0, terminator: "", tables: ?TABLES[0], table_n: TABLES_N, refused: nil, refused_n: 0, refusal: "", relations: nil, relation_n: 0, constraints: ?CONSTRAINTS[0], constraint_n: CONSTRAINTS_N, operand_min: 0, operand_max: 1, truncate_at_sep: false, actions: nil, action_n: 0, examples: nil, example_n: 0, run: run};

# `mach info`: print "mach <version>" and the host target this binary resolves for the
# machine it runs on. `--version` prints the version alone; the verb `targets` prints
# every target the registries compose end-to-end, one full tuple per line; combining
# `--version` with a verb, or any other verb, is an error
# ---
# cx:  the call
# ret: exit.OK, or a user failure for a usage error, or a target registration or host resolution
#      failure
pub fun run(cx: *args.Call) res[i64, fail.Fail] {
    val inv:          *args.ParsedInvocation = cx.inv;
    val show_version: bool                   = args.given(inv, ?VERSION);
    val show_targets: bool                   = inv.has_positional && str_equals(cx.argv[inv.positional_idx]::str, "targets");
    if (inv.has_positional && !show_targets) {
        ret res[i64, fail.Fail].err{fail.user(diagnostic_kind.CLI_OPERAND, "expected 'targets' as the sole info verb")};
    }
    if (show_version && inv.has_positional) {
        ret res[i64, fail.Fail].err{fail.user(diagnostic_kind.CLI_FLAG_CONFLICT, "--version and a verb cannot be combined")};
    }

    if (show_version) {
        print.println(lang_version.MACH_VERSION);
        ret res[i64, fail.Fail].ok{exit.OK};
    }

    val reg_made: res[*lang_target.TargetRegistry, fail.Fail] = toolchain.registry();
    if (sel reg_made.err) { ret res[i64, fail.Fail].err{reg_made.err}; }
    val reg: *lang_target.TargetRegistry = reg_made.ok;

    var text: res[str, fail.Fail] = res[str, fail.Fail].err{fail.message("")};
    if (show_targets) { text = render_targets(cx.a, reg); }
    or                { text = render_host(cx.a, reg); }
    if (sel text.err) { ret res[i64, fail.Fail].err{text.err}; }
    print.print(text.ok);
    ret res[i64, fail.Fail].ok{exit.OK};
}

fun append(b: *textbuild.TextBuilder, s: str) {
    val r: err[textbuild.Error] = textbuild.tb_append(b, s);
}

fun finish(b: *textbuild.TextBuilder) res[str, fail.Fail] {
    val r: res[str, textbuild.Error] = textbuild.tb_finish(b);
    if (sel r.err) {
        textbuild.tb_dnit(b);
        ret res[str, fail.Fail].err{fail.message("info: failed to build output")};
    }
    ret res[str, fail.Fail].ok{r.ok};
}

# the `mach info` page: the version and the resolved host target, one dimension
# per line, every value taken from the target the host request resolves to
fun render_host(a: *A.Allocator, reg: *lang_target.TargetRegistry) res[str, fail.Fail] {
    var req: lang_target.TargetRequest           = lang_target.host_request();
    val t_r: res[lang_target.Binding, fail.Fail] = lang_target.resolve(reg, ?req);
    if (sel t_r.err) { ret res[str, fail.Fail].err{t_r.err}; }
    ret render_host_target(a, ?t_r.ok);
}

fun render_host_target(a: *A.Allocator, t: *lang_target.Binding) res[str, fail.Fail] {
    var buf: [64]u8;
    var b:   textbuild.TextBuilder = textbuild.tb_init(a);
    append(?b, "mach ");
    append(?b, lang_version.MACH_VERSION);
    append(?b, "\nhost: ");
    append(?b, t.os.name);
    append(?b, "-");
    append(?b, catalog_arch.name_for(t.target.arch_id));
    append(?b, "\nisa: ");
    append(?b, lang_target.selection_spelling(t.isa, ?t.target.model, ?buf[0], 64));
    append(?b, "\nos: ");
    append(?b, t.os.name);
    append(?b, "\nabi: ");
    append(?b, t.abi.name);
    append(?b, "\nobject: ");
    append(?b, t.of.name);
    append(?b, "\n");
    ret finish(?b);
}

# one accepted cell of the target matrix: the four registered vtables and the
# isa spelled as its selection
rec Cell {
    os:       *lang_target_os.OsVTable;
    arch:     *isa.IsaVTable;
    abi:      *abi.AbiVTable;
    of:       *target_of.OfVTable;
    isa_name: [32]u8;
}

# every cell target.registered_tuple_capability accepts, in registry order:
# os outermost, then isa, abi, object format. the array is a's to free with cap
fun collect_cells(a: *A.Allocator, reg: *lang_target.TargetRegistry, cap: *usize) res[*Cell, fail.Fail] {
    val os_len:  usize = reg.os.count::usize;
    val isa_len: usize = reg.isa.count::usize;
    val abi_len: usize = reg.abi.count::usize;
    val of_len:  usize = reg.of.count::usize;
    @cap = os_len * isa_len * abi_len * of_len;
    val cells_r: res[*Cell, A.Error] = A.allocate[Cell](a, @cap);
    if (sel cells_r.err) { ret res[*Cell, fail.Fail].err{fail.message("info: failed to allocate the target matrix")}; }
    val cells: *Cell = cells_r.ok;
    var n:     usize = 0;
    var oi:    usize = 0;
    for (oi < os_len) {
        val os_r: opt[*lang_target_os.OsVTable] = target_registry.at[lang_target_os.OsVTable](?reg.os, oi::u32);
        if (sel os_r.none) { brk; }
        var ii: usize = 0;
        for (ii < isa_len) {
            val isa_r: opt[*isa.IsaVTable] = target_registry.at[isa.IsaVTable](?reg.isa, ii::u32);
            if (sel isa_r.none) { brk; }
            var ai: usize = 0;
            for (ai < abi_len) {
                val abi_r: opt[*abi.AbiVTable] = target_registry.at[abi.AbiVTable](?reg.abi, ai::u32);
                if (sel abi_r.none) { brk; }
                var fi: usize = 0;
                for (fi < of_len) {
                    val of_r: opt[*target_of.OfVTable] = target_registry.at[target_of.OfVTable](?reg.of, fi::u32);
                    if (sel of_r.none) { brk; }
                    if (lang_target.registered_tuple_capability(os_r.some, isa_r.some, abi_r.some, of_r.some) == tuple.OK) {
                        cells[n].os   = os_r.some;
                        cells[n].arch = isa_r.some;
                        cells[n].abi  = abi_r.some;
                        cells[n].of   = of_r.some;
                        var model:    target_model.Machine;
                        val selected: isa.IsaVTable = lang_target.registered_selection(os_r.some, isa_r.some, abi_r.some, ?model);
                        lang_target.selection_spelling(?selected, ?model, ?cells[n].isa_name[0], 32);
                        n = n + 1;
                    }
                    fi = fi + 1;
                }
                ai = ai + 1;
            }
            ii = ii + 1;
        }
        oi = oi + 1;
    }
    var i: usize = n;
    for (i < @cap) {
        cells[i].os = nil;
        i           = i + 1;
    }
    ret res[*Cell, fail.Fail].ok{cells};
}

fun cell_isa(c: *Cell) str {
    ret (?c.isa_name[0])::str;
}

fun max_len(cur: usize, s: str) usize {
    val n: usize = str_len(s);
    if (n > cur) { ret n; }
    ret cur;
}

fun pad(b: *textbuild.TextBuilder, written: usize, width: usize) {
    var i: usize = written;
    for (i < width + 2) {
        append(b, " ");
        i = i + 1;
    }
}

fun column(b: *textbuild.TextBuilder, key: str, value: str, width: usize, last: bool) {
    append(b, key);
    append(b, "=");
    append(b, value);
    if (!last) { pad(b, str_len(key) + 1 + str_len(value), str_len(key) + 1 + width); }
}

# the `mach info targets` listing: one line per accepted cell, the `<os>-<isa>`
# name then `key=value` for every dimension, each column padded to the widest
# value it holds over the whole listing
fun render_targets(a: *A.Allocator, reg: *lang_target.TargetRegistry) res[str, fail.Fail] {
    var cap:     usize                 = 0;
    val cells_r: res[*Cell, fail.Fail] = collect_cells(a, reg, ?cap);
    if (sel cells_r.err) { ret res[str, fail.Fail].err{cells_r.err}; }
    val cells: *Cell = cells_r.ok;
    fin { A.deallocate[Cell](a, cells, cap); }

    var w_name: usize = 0;
    var w_isa:  usize = 0;
    var w_os:   usize = 0;
    var w_abi:  usize = 0;
    var i:      usize = 0;
    for (i < cap && cells[i].os != nil) {
        val name_len: usize = str_len(cells[i].os.name) + 1 + str_len(cells[i].arch.name);
        if (name_len > w_name) { w_name = name_len; }
        w_isa = max_len(w_isa, cell_isa(?cells[i]));
        w_os  = max_len(w_os, cells[i].os.name);
        w_abi = max_len(w_abi, cells[i].abi.name);
        i     = i + 1;
    }

    var b: textbuild.TextBuilder = textbuild.tb_init(a);
    i = 0;
    for (i < cap && cells[i].os != nil) {
        val c: *Cell = ?cells[i];
        append(?b, c.os.name);
        append(?b, "-");
        append(?b, c.arch.name);
        pad(?b, str_len(c.os.name) + 1 + str_len(c.arch.name), w_name);
        column(?b, "isa", cell_isa(c), w_isa, false);
        column(?b, "os", c.os.name, w_os, false);
        column(?b, "abi", c.abi.name, w_abi, false);
        column(?b, "object", c.of.name, 0, true);
        append(?b, "\n");
        i = i + 1;
    }
    ret finish(?b);
}
