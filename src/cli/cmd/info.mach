use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.fail;
use std_args: std.args;
use std.collections.slice.Slice;
use std_format: std.format;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;

use A: std.allocator;
use std.collections.vector;
use std.collections.vector.Vector;

use mach.cli.args;
use cli_diagnostic: mach.cli.diagnostic;
use mach.cli.exit;
use lang_target: mach.lang.target;
use mach.lang.target.resolved;
use mach.lang.textbuild;
use lang_version: mach.lang.version;
use mink_fail:    mink.base.fail;
use mink.base.vectors;
use mink_target: mink.catalog.target;

# length of FLAGS
val FLAGS_N: usize = 2;
# the flags mach info takes
val FLAGS: [FLAGS_N]*std_args.Flag = [FLAGS_N]*std_args.Flag{?args.HELP, ?args.DIAGNOSTICS};

# `mach info`
pub val COMMAND: std_args.Command = std_args.Command{name: "info", aliases: args.NO_WORDS, help: "show the host target, or every target", usage: "[targets]", flags: Slice[*std_args.Flag]{data: ?FLAGS[0], size: FLAGS_N}, commands: args.NO_COMMANDS, operand_min: 0, operand_max: 1, passthrough: false};
# what mach holds `mach info` to beyond the parse
pub val POLICY: args.Policy = args.Policy{refused: args.NO_FLAGS, refusal: "", conflicts: args.NO_CONFLICTS};

# `mach info`: print "mach <version>" and the host target this binary resolves for the
# machine it runs on, or with the verb `targets` every target mink's catalog spells; any other
# verb is an error
# ---
# cx:  the call
# ret: exit.OK, or a user failure for a usage error, or a host resolution failure
pub fun run(cx: *args.Call) res[i64, fail.Fail] {
    val operand:      *u8  = args.operand(cx.inv, 0);
    val show_targets: bool = operand != nil && str_equals(operand::str, "targets");
    if (operand != nil && !show_targets) {
        ret res[i64, fail.Fail].err{fail.user(diagnostic_kind.CLI_OPERAND, "expected 'targets' as the sole info verb")};
    }
    var text: res[str, fail.Fail] = res[str, fail.Fail].err{fail.message("")};
    if (show_targets) { text = render_targets(cx.a); }
    or                { text = render_host(cx.a); }
    if (sel text.err) { ret res[i64, fail.Fail].err{text.err}; }
    std_format.write_str(cli_diagnostic.out(cx.report), text.ok);
    ret res[i64, fail.Fail].ok{exit.OK};
}

fun append(b: *textbuild.TextBuilder, s: str) {
    val r: err[textbuild.Error] = textbuild.tb_append(b, s);
}

fun finish(b: *textbuild.TextBuilder) res[str, fail.Fail] {
    val r: res[str, textbuild.Error] = textbuild.tb_finish(b);
    if (sel r.err) {
        textbuild.tb_dnit(b);
        ret res[str, fail.Fail].err{fail.message("info: failed to build output")};
    }
    ret res[str, fail.Fail].ok{r.ok};
}

# the `mach info` page: the version and the resolved host target, one dimension
# per line, every value taken from the target the host request resolves to
fun render_host(a: *A.Allocator) res[str, fail.Fail] {
    val t_r: res[resolved.Target, fail.Fail] = lang_target.host(a);
    if (sel t_r.err) { ret res[str, fail.Fail].err{t_r.err}; }
    var t: resolved.Target       = t_r.ok;
    val m: *mink_target.Target   = ?t.target;
    var b: textbuild.TextBuilder = textbuild.tb_init(a);
    append(?b, "mach ");
    append(?b, lang_version.MACH_VERSION);
    append(?b, "\nhost: ");
    append(?b, m.sys.name);
    append(?b, "-");
    append(?b, m.arch.name);
    append(?b, "\nisa: ");
    append(?b, resolved.isa(?t));
    append(?b, "\nsys: ");
    append(?b, m.sys.name);
    append(?b, "\nenv: ");
    if (sel m.env.some) { append(?b, m.env.some.name); }
    or                  { append(?b, "none"); }
    append(?b, "\nabi: ");
    append(?b, resolved.abi_name(?t));
    append(?b, "\ncode_model: ");
    if (sel m.code_model.some) { append(?b, m.code_model.some.name); }
    or                         { append(?b, "-"); }
    append(?b, "\nlinkage: ");
    if (sel m.linkage.some) { append(?b, m.linkage.some.name); }
    or                      { append(?b, "-"); }
    append(?b, "\nobject: ");
    append(?b, m.format.name);
    append(?b, "\n");
    ret finish(?b);
}

# the parts a target accepts that `mach info targets` lists, and the key each is listed under
val PART_N:    usize       = 4;
val PART_KEYS: [PART_N]str = [PART_N]str{"env", "abi", "code_model", "linkage"};

# the choices `spec` accepts for the part at `k` of PART_KEYS, as `key=` and the names joined by
# commas, the default first and marked `*`, and `none` for the hosts that state no environment.
# a linkage depends on the environment, so it is listed for each the target accepts, in the
# environment column's order, as `env:` and its linkages, unprefixed for the hosts with none
fun choices(a: *A.Allocator, spec: mink_target.Spec, k: usize) str {
    var b: textbuild.TextBuilder = textbuild.tb_init(a);
    append(?b, PART_KEYS[k]);
    append(?b, "=");
    if (k == 3) { linkages(?b, spec); }
    or {
        var part: mink_target.Part = mink_target.Part.env{};
        if (k == 1)                                              { part = mink_target.Part.abi{}; }
        if (k == 2)                                              { part = mink_target.Part.code_model{}; }
        if (names(?b, spec, ?mink_target.UNNARROWED, part) == 0) { append(?b, "-"); }
    }
    val made: res[str, textbuild.Error] = textbuild.tb_finish(?b);
    if (sel made.err) { ret "-"; }
    ret made.ok;
}

# the linkages `spec` accepts under each environment it accepts, a group a space apart. the hosts
# with no environment are the ones resolve takes with none named, so their group is listed only
# where they are the default
fun linkages(b: *textbuild.TextBuilder, spec: mink_target.Spec) {
    var groups: usize = 0;
    var i:      usize = 0;
    for {
        val e: opt[mink_target.Choice] = mink_target.accepted(spec, ?mink_target.UNNARROWED, mink_target.Part.env{}, i);
        if (sel e.none) { brk; }
        i = i + 1;
        if (e.some.name == nil && !e.some.default) { cnt; }
        var n: mink_target.Narrowing = mink_target.UNNARROWED;
        n.env  = e.some.name;
        groups = groups + env_linkages(b, spec, ?n, groups);
    }
    if (groups == 0) { append(b, "-"); }
}

# the group of linkages `spec` accepts under the environment `n` narrows to, as `env:` and the
# linkages, unprefixed for the hosts with none. where the environment's hosts differ by calling
# convention and none is the default, the linkage follows the convention named, so a group is
# listed for each as `env/abi:`, with `none` for the hosts with no environment, unless every
# convention accepts the same. `before` counts the groups already written; answers how many it
# wrote
fun env_linkages(b: *textbuild.TextBuilder, spec: mink_target.Spec, n: *mink_target.Narrowing, before: usize) usize {
    var first: mink_target.Narrowing = @n;
    var abis:  usize                 = 0;
    var same:  bool                  = true;
    if (count(spec, n, mink_target.Part.linkage{}) == 0) {
        for {
            val c: opt[mink_target.Choice] = mink_target.accepted(spec, n, mink_target.Part.abi{}, abis);
            if (sel c.none) { brk; }
            var m: mink_target.Narrowing = @n;
            m.abi = c.some.name;
            if (abis == 0)                                                   { first = m; }
            or (!same_choices(spec, ?first, ?m, mink_target.Part.linkage{})) { same = false; }
            abis = abis + 1;
        }
    }
    if (same) {
        group(b, n.env, nil, before);
        if (names(b, spec, ?first, mink_target.Part.linkage{}) == 0) { append(b, "-"); }
        ret 1;
    }
    var k: usize = 0;
    for (k < abis) {
        val c: opt[mink_target.Choice] = mink_target.accepted(spec, n, mink_target.Part.abi{}, k);
        if (sel c.none) { brk; }
        var m: mink_target.Narrowing = @n;
        m.abi = c.some.name;
        group(b, n.env, m.abi, before + k);
        if (names(b, spec, ?m, mink_target.Part.linkage{}) == 0) { append(b, "-"); }
        k = k + 1;
    }
    ret k;
}

# the label of a group of linkages: `env:`, `env/abi:` or `none/abi:` for the hosts with no
# environment, and none for those hosts with no convention named
fun group(b: *textbuild.TextBuilder, env: str, abi: str, before: usize) {
    if (before > 0)               { append(b, " "); }
    if (env == nil && abi == nil) { ret; }
    if (env == nil)               { append(b, "none"); }
    or                            { append(b, env); }
    if (abi != nil) {
        append(b, "/");
        append(b, abi);
    }
    append(b, ":");
}

# how many choices `spec` accepts for `part` under `n`
fun count(spec: mink_target.Spec, n: *mink_target.Narrowing, part: mink_target.Part) usize {
    var i: usize = 0;
    for {
        val c: opt[mink_target.Choice] = mink_target.accepted(spec, n, part, i);
        if (sel c.none) { ret i; }
        i = i + 1;
    }
    ret i;
}

# whether `spec` accepts the same choices for `part`, in the same order and with the same
# default, under `x` and `y`
fun same_choices(spec: mink_target.Spec, x: *mink_target.Narrowing, y: *mink_target.Narrowing, part: mink_target.Part) bool {
    var i: usize = 0;
    for {
        val p: opt[mink_target.Choice] = mink_target.accepted(spec, x, part, i);
        val q: opt[mink_target.Choice] = mink_target.accepted(spec, y, part, i);
        if (sel p.none || sel q.none) { ret sel p.none && sel q.none; }
        if (sel p.some) {
            if (sel q.some) {
                if (p.some.default != q.some.default)      { ret false; }
                if (!str_equals(p.some.name, q.some.name)) { ret false; }
            }
        }
        i = i + 1;
    }
    ret false;
}

# the choices `spec` accepts for `part` under `n`, joined by commas, the default first and marked
# `*`, and `none` for the hosts that state no environment. answers how many it wrote
fun names(b: *textbuild.TextBuilder, spec: mink_target.Spec, n: *mink_target.Narrowing, part: mink_target.Part) usize {
    var i: usize = 0;
    for {
        val c: opt[mink_target.Choice] = mink_target.accepted(spec, n, part, i);
        if (sel c.none)         { brk; }
        if (i > 0)              { append(b, ","); }
        if (c.some.default)     { append(b, "*"); }
        if (c.some.name == nil) { append(b, "none"); }
        or                      { append(b, c.some.name); }
        i = i + 1;
    }
    ret i;
}

fun pad(b: *textbuild.TextBuilder, written: usize, width: usize) {
    var k: usize = written;
    for (k < width + 2) {
        append(b, " ");
        k = k + 1;
    }
}

# the `mach info targets` listing: every target mink's catalog spells, one per line as `-t`
# takes it, then the environments, calling conventions, code models and executable linkages it
# accepts as mink's catalog states them, each column padded to its widest value, and
# `needs --isa` beside each whose system bounds the machine not at all
fun render_targets(a: *A.Allocator) res[str, fail.Fail] {
    var specs:  Vector[mink_target.Spec] = vector.init[mink_target.Spec](a);
    val listed: err[mink_fail.Fail]      = mink_target.list(?specs);
    if (sel listed.err) {
        val dropped: err[mink_fail.Fail] = vectors.release[mink_target.Spec](?specs);
        ret res[str, fail.Fail].err{resolved.refusal(a, listed.err)};
    }
    val n:       usize              = specs.len;
    val cells_r: res[*str, A.Error] = A.allocate[str](a, n * PART_N + 1);
    if (sel cells_r.err) {
        val dropped: err[mink_fail.Fail] = vectors.release[mink_target.Spec](?specs);
        ret res[str, fail.Fail].err{fail.refused(cells_r.err)};
    }
    val cells:  *str              = cells_r.ok;
    var widths: [PART_N + 1]usize = [PART_N + 1]usize{0, 0, 0, 0, 0};
    var i:      usize             = 0;
    for (i < n) {
        val s:   mink_target.Spec = specs.data[i];
        val len: usize            = str_len(s.sys.name) + 1 + str_len(s.arch.name);
        if (len > widths[0]) { widths[0] = len; }
        var k: usize = 0;
        for (k < PART_N) {
            val c: str = choices(a, s, k);
            cells[i * PART_N + k] = c;
            if (str_len(c) > widths[k + 1]) { widths[k + 1] = str_len(c); }
            k = k + 1;
        }
        i = i + 1;
    }
    var b: textbuild.TextBuilder = textbuild.tb_init(a);
    i = 0;
    for (i < n) {
        val s: mink_target.Spec = specs.data[i];
        append(?b, s.sys.name);
        append(?b, "-");
        append(?b, s.arch.name);
        pad(?b, str_len(s.sys.name) + 1 + str_len(s.arch.name), widths[0]);
        var k: usize = 0;
        for (k < PART_N) {
            val c: str = cells[i * PART_N + k];
            append(?b, c);
            if (k < PART_N - 1 || mink_target.needs_isa(s)) { pad(?b, str_len(c), widths[k + 1]); }
            k = k + 1;
        }
        if (mink_target.needs_isa(s)) { append(?b, "needs --isa"); }
        append(?b, "\n");
        i = i + 1;
    }
    val released: err[mink_fail.Fail] = vectors.release[mink_target.Spec](?specs);
    if (sel released.err) {
        textbuild.tb_dnit(?b);
        ret res[str, fail.Fail].err{resolved.refusal(a, released.err)};
    }
    ret finish(?b);
}
