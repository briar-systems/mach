use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.fail;
use std_args: std.args;
use std.collections.slice.Slice;
use std.print;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;

use A: std.allocator;

use mach.cli.args;
use mach.cli.exit;
use lang_target: mach.lang.target;
use target_host: mach.lang.target.host;
use mach.lang.target.resolved;
use mach.lang.textbuild;
use lang_version: mach.lang.version;
use mink_fail:    mink.base.fail;
use mink.base.table;
use mink.base.table.Table;
use mink_target: mink.catalog.target;

# length of FLAGS
val FLAGS_N: usize = 2;
# the flags mach info takes
val FLAGS: [FLAGS_N]*std_args.Flag = [FLAGS_N]*std_args.Flag{?args.HELP, ?args.DIAGNOSTICS};

# `mach info`
pub val COMMAND: std_args.Command = std_args.Command{name: "info", aliases: args.NO_WORDS, help: "print the version and the resolved host target one dimension per line, or with targets every target mink's catalog spells, one per line as -t takes it, with the environments, calling conventions and code models it accepts, its default first and marked *, and marking those that need --isa", usage: "[targets]", flags: Slice[*std_args.Flag]{data: ?FLAGS[0], size: FLAGS_N}, commands: args.NO_COMMANDS, operand_min: 0, operand_max: 1, passthrough: false};
# what mach holds `mach info` to beyond the parse
pub val POLICY: args.Policy = args.Policy{summary: "show the compiler version and host target, or every supported target", exits: args.NO_EXITS, constraints: args.NO_WORDS, refused: args.NO_FLAGS, refusal: "", conflicts: args.NO_CONFLICTS};

# `mach info`: print "mach <version>" and the host target this binary resolves for the
# machine it runs on, or with the verb `targets` every target mink's catalog spells; any other
# verb is an error
# ---
# cx:  the call
# ret: exit.OK, or a user failure for a usage error, or a host resolution failure
pub fun run(cx: *args.Call) res[i64, fail.Fail] {
    val operand:      *u8  = args.operand(cx.inv, 0);
    val show_targets: bool = operand != nil && str_equals(operand::str, "targets");
    if (operand != nil && !show_targets) {
        ret res[i64, fail.Fail].err{fail.user(diagnostic_kind.CLI_OPERAND, "expected 'targets' as the sole info verb")};
    }
    var text: res[str, fail.Fail] = res[str, fail.Fail].err{fail.message("")};
    if (show_targets) { text = render_targets(cx.a); }
    or                { text = render_host(cx.a); }
    if (sel text.err) { ret res[i64, fail.Fail].err{text.err}; }
    print.print(text.ok);
    ret res[i64, fail.Fail].ok{exit.OK};
}

fun append(b: *textbuild.TextBuilder, s: str) {
    val r: err[textbuild.Error] = textbuild.tb_append(b, s);
}

fun finish(b: *textbuild.TextBuilder) res[str, fail.Fail] {
    val r: res[str, textbuild.Error] = textbuild.tb_finish(b);
    if (sel r.err) {
        textbuild.tb_dnit(b);
        ret res[str, fail.Fail].err{fail.message("info: failed to build output")};
    }
    ret res[str, fail.Fail].ok{r.ok};
}

# the `mach info` page: the version and the resolved host target, one dimension
# per line, every value taken from the target the host request resolves to
fun render_host(a: *A.Allocator) res[str, fail.Fail] {
    var req: lang_target.TargetRequest       = lang_target.host_request();
    val t_r: res[resolved.Target, fail.Fail] = lang_target.resolve(a, ?req);
    if (sel t_r.err) { ret res[str, fail.Fail].err{t_r.err}; }
    var t: resolved.Target       = t_r.ok;
    var b: textbuild.TextBuilder = textbuild.tb_init(a);
    append(?b, "mach ");
    append(?b, lang_version.MACH_VERSION);
    append(?b, "\nhost: ");
    append(?b, t.sys.name);
    append(?b, "-");
    append(?b, t.arch.name);
    append(?b, "\nisa: ");
    append(?b, t.isa);
    append(?b, "\nsys: ");
    append(?b, t.sys.name);
    append(?b, "\nabi: ");
    append(?b, t.abi);
    append(?b, "\nobject: ");
    append(?b, t.format.name);
    append(?b, "\n");
    ret finish(?b);
}

# the parts a target accepts that `mach info targets` lists, and the key each is listed under
val PART_KEYS: [3]str = [3]str{"env", "abi", "code_model"};

# the choices `spec` accepts for the part at `k` of PART_KEYS, as `key=` and the names joined by
# commas, the default first and marked `*`, and `none` for the hosts that state no environment
fun choices(a: *A.Allocator, spec: mink_target.Spec, k: usize) str {
    var part: mink_target.Part = mink_target.Part.env{};
    if (k == 1) { part = mink_target.Part.abi{}; }
    if (k == 2) { part = mink_target.Part.code_model{}; }
    var b: textbuild.TextBuilder = textbuild.tb_init(a);
    append(?b, PART_KEYS[k]);
    append(?b, "=");
    var i: usize = 0;
    for {
        val c: opt[mink_target.Choice] = mink_target.accepted(spec, part, i);
        if (sel c.none)         { brk; }
        if (i > 0)              { append(?b, ","); }
        if (c.some.default)     { append(?b, "*"); }
        if (c.some.name == nil) { append(?b, "none"); }
        or                      { append(?b, c.some.name); }
        i = i + 1;
    }
    if (i == 0) { append(?b, "-"); }
    val made: res[str, textbuild.Error] = textbuild.tb_finish(?b);
    if (sel made.err) { ret "-"; }
    ret made.ok;
}

fun pad(b: *textbuild.TextBuilder, written: usize, width: usize) {
    var k: usize = written;
    for (k < width + 2) {
        append(b, " ");
        k = k + 1;
    }
}

# the `mach info targets` listing: every target mink's catalog spells, one per line as `-t`
# takes it, then the environments, calling conventions and code models it accepts as mink's
# catalog states them, each column padded to its widest value, and `needs --isa` beside each
# whose system bounds the machine not at all
fun render_targets(a: *A.Allocator) res[str, fail.Fail] {
    var specs:  Table[mink_target.Spec] = table.make[mink_target.Spec](a);
    val listed: err[mink_fail.Fail]     = mink_target.list(?specs);
    if (sel listed.err) {
        val dropped: err[mink_fail.Fail] = table.release[mink_target.Spec](?specs);
        ret res[str, fail.Fail].err{target_host.refusal(a, listed.err)};
    }
    val n:       usize              = table.count[mink_target.Spec](?specs);
    val cells_r: res[*str, A.Error] = A.allocate[str](a, n * 3 + 1);
    if (sel cells_r.err) {
        val dropped: err[mink_fail.Fail] = table.release[mink_target.Spec](?specs);
        ret res[str, fail.Fail].err{fail.refused(cells_r.err)};
    }
    val cells:  *str     = cells_r.ok;
    var widths: [4]usize = [4]usize{0, 0, 0, 0};
    var i:      usize    = 0;
    for (i < n) {
        val s:   mink_target.Spec = @table.at[mink_target.Spec](?specs, table.nth[mink_target.Spec](i));
        val len: usize            = str_len(s.sys.name) + 1 + str_len(s.arch.name);
        if (len > widths[0]) { widths[0] = len; }
        var k: usize = 0;
        for (k < 3) {
            val c: str = choices(a, s, k);
            cells[i * 3 + k] = c;
            if (str_len(c) > widths[k + 1]) { widths[k + 1] = str_len(c); }
            k = k + 1;
        }
        i = i + 1;
    }
    var b: textbuild.TextBuilder = textbuild.tb_init(a);
    i = 0;
    for (i < n) {
        val s: mink_target.Spec = @table.at[mink_target.Spec](?specs, table.nth[mink_target.Spec](i));
        append(?b, s.sys.name);
        append(?b, "-");
        append(?b, s.arch.name);
        pad(?b, str_len(s.sys.name) + 1 + str_len(s.arch.name), widths[0]);
        var k: usize = 0;
        for (k < 3) {
            val c: str = cells[i * 3 + k];
            append(?b, c);
            if (k < 2 || mink_target.needs_isa(s)) { pad(?b, str_len(c), widths[k + 1]); }
            k = k + 1;
        }
        if (mink_target.needs_isa(s)) { append(?b, "needs --isa"); }
        append(?b, "\n");
        i = i + 1;
    }
    val released: err[mink_fail.Fail] = table.release[mink_target.Spec](?specs);
    if (sel released.err) {
        textbuild.tb_dnit(?b);
        ret res[str, fail.Fail].err{target_host.refusal(a, released.err)};
    }
    ret finish(?b);
}
