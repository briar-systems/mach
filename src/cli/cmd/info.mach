use mach.lang.build.outcome;
use mach.lang.fail;
use std.allocator.page;
use std.print;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_contains;
use std.types.string.str_equals;
use std.types.string.str_len;

use A: std.allocator;

use mach.cli.args;
use mach.lang.driver;
use mach.lang.target;
use mach.lang.target.abi;
use mach.lang.target.isa;
use mach.lang.target.of;
use mach.lang.target.os;
use mach.lang.textbuild;
use mach.lang.version;

# `mach info`: print "mach <version>" and the host target this binary resolves for the
# machine it runs on. `--version` prints the version alone; the verb `targets` prints
# every target the registries compose end-to-end, one full tuple per line; combining
# the two, or any other verb, is an error
# ---
# argv: the full process arguments
# inv:  the parsed invocation for this command
# ret:  0 success, 1 usage error, 2 target registration or host resolution failure
pub fun run(argv: **u8, inv: *args.ParsedInvocation) i64 {
    if (args.reject_unknown_from_invocation(inv, argv, "mach info")) { ret 1; }
    val parsed: args.InfoInvocation = args.build_info_invocation(inv, argv);

    if (parsed.invalid_verb) {
        print.eprint("error: expected 'targets' as the sole info verb\n");
        ret 1;
    }
    if (parsed.show_version && parsed.show_targets) {
        print.eprint("error: --version and targets cannot be combined\n");
        ret 1;
    }

    if (parsed.show_version) {
        print.println(version.MACH_VERSION);
        ret 0;
    }

    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val res_register_all: err[outcome.Fail] = driver.setup_registry(?reg);
    if (sel res_register_all.err) {
        print.eprint("error: ");
        print.eprintln(outcome.describe(res_register_all.err));
        ret 2;
    }

    var alloc:   A.Allocator;
    val r_alloc: err[A.Error] = page.make(?alloc);
    if (sel r_alloc.err) {
        print.eprint("error: info: allocator unavailable\n");
        ret 2;
    }

    var text: res[str, fail.Fail] = res[str, fail.Fail].err{fail.message("")};
    if (parsed.show_targets) { text = render_targets(?alloc, ?reg); }
    or                       { text = render_host(?alloc, ?reg); }
    if (sel text.err) {
        print.eprint("error: ");
        print.eprintln(fail.describe(text.err));
        ret 2;
    }
    print.print(text.ok);
    ret 0;
}

fun append(b: *textbuild.TextBuilder, s: str) {
    val r: err[textbuild.Error] = textbuild.tb_append(b, s);
}

fun finish(b: *textbuild.TextBuilder) res[str, fail.Fail] {
    val r: res[str, textbuild.Error] = textbuild.tb_finish(b);
    if (sel r.err) {
        textbuild.tb_dnit(b);
        ret res[str, fail.Fail].err{fail.message("info: failed to build output")};
    }
    ret res[str, fail.Fail].ok{r.ok};
}

# the `mach info` page: the version and the resolved host target, one dimension
# per line, every value taken from the target the host request resolves to
pub fun render_host(a: *A.Allocator, reg: *target.TargetRegistry) res[str, fail.Fail] {
    var req: target.TargetRequest          = target.host_request();
    val t_r: res[target.Target, fail.Fail] = target.resolve(reg, ?req);
    if (sel t_r.err) { ret res[str, fail.Fail].err{t_r.err}; }
    ret render_host_target(a, ?t_r.ok);
}

fun render_host_target(a: *A.Allocator, t: *target.Target) res[str, fail.Fail] {
    var buf: [64]u8;
    var b:   textbuild.TextBuilder = textbuild.tb_init(a);
    append(?b, "mach ");
    append(?b, version.MACH_VERSION);
    append(?b, "\nhost: ");
    append(?b, t.os.name);
    append(?b, "-");
    append(?b, isa.arch_name_for(t.arch_id));
    append(?b, "\nisa: ");
    append(?b, target.selection_spelling(t.isa, ?buf[0], 64));
    append(?b, "\nos: ");
    append(?b, t.os.name);
    append(?b, "\nabi: ");
    append(?b, t.abi.name);
    append(?b, "\nobject: ");
    append(?b, t.of.name);
    append(?b, "\n");
    ret finish(?b);
}

# one accepted cell of the target matrix: the four registered vtables and the
# isa spelled as its selection
rec Cell {
    os:       *os.OsVTable;
    arch:     *isa.IsaVTable;
    abi:      *abi.AbiVTable;
    of:       *of.OfVTable;
    isa_name: [32]u8;
}

# every cell target.registered_tuple_capability accepts, in registry order:
# os outermost, then isa, abi, object format. the array is a's to free with cap
fun collect_cells(a: *A.Allocator, reg: *target.TargetRegistry, cap: *usize) res[*Cell, fail.Fail] {
    val os_len:  usize = os.registered_count(?reg.os)::usize;
    val isa_len: usize = isa.registered_count(?reg.isa)::usize;
    val abi_len: usize = abi.registered_count(?reg.abi)::usize;
    val of_len:  usize = of.registered_count(?reg.of)::usize;
    @cap = os_len * isa_len * abi_len * of_len;
    val cells_r: res[*Cell, A.Error] = A.allocate[Cell](a, @cap);
    if (sel cells_r.err) { ret res[*Cell, fail.Fail].err{fail.message("info: failed to allocate the target matrix")}; }
    val cells: *Cell = cells_r.ok;
    var n:     usize = 0;
    var oi:    usize = 0;
    for (oi < os_len) {
        val os_r: opt[*os.OsVTable] = os.registered(?reg.os, oi::u32);
        if (sel os_r.none) { brk; }
        var ii: usize = 0;
        for (ii < isa_len) {
            val isa_r: opt[*isa.IsaVTable] = isa.registered(?reg.isa, ii::u32);
            if (sel isa_r.none) { brk; }
            var ai: usize = 0;
            for (ai < abi_len) {
                val abi_r: opt[*abi.AbiVTable] = abi.registered(?reg.abi, ai::u32);
                if (sel abi_r.none) { brk; }
                var fi: usize = 0;
                for (fi < of_len) {
                    val of_r: opt[*of.OfVTable] = of.registered(?reg.of, fi::u32);
                    if (sel of_r.none) { brk; }
                    if (target.registered_tuple_capability(os_r.some, isa_r.some, abi_r.some, of_r.some) == target.TUPLE_OK) {
                        cells[n].os   = os_r.some;
                        cells[n].arch = isa_r.some;
                        cells[n].abi  = abi_r.some;
                        cells[n].of   = of_r.some;
                        var model:    isa.MachineModel;
                        val selected: isa.IsaVTable = target.registered_selection(isa_r.some, ?model);
                        target.selection_spelling(?selected, ?cells[n].isa_name[0], 32);
                        n = n + 1;
                    }
                    fi = fi + 1;
                }
                ai = ai + 1;
            }
            ii = ii + 1;
        }
        oi = oi + 1;
    }
    var i: usize = n;
    for (i < @cap) {
        cells[i].os = nil;
        i           = i + 1;
    }
    ret res[*Cell, fail.Fail].ok{cells};
}

fun cell_isa(c: *Cell) str {
    ret (?c.isa_name[0])::str;
}

fun max_len(cur: usize, s: str) usize {
    val n: usize = str_len(s);
    if (n > cur) { ret n; }
    ret cur;
}

fun pad(b: *textbuild.TextBuilder, written: usize, width: usize) {
    var i: usize = written;
    for (i < width + 2) {
        append(b, " ");
        i = i + 1;
    }
}

fun column(b: *textbuild.TextBuilder, key: str, value: str, width: usize, last: bool) {
    append(b, key);
    append(b, "=");
    append(b, value);
    if (!last) { pad(b, str_len(key) + 1 + str_len(value), str_len(key) + 1 + width); }
}

# the `mach info targets` listing: one line per accepted cell, the `<os>-<isa>`
# name then `key=value` for every dimension, each column padded to the widest
# value it holds over the whole listing
pub fun render_targets(a: *A.Allocator, reg: *target.TargetRegistry) res[str, fail.Fail] {
    var cap:     usize                 = 0;
    val cells_r: res[*Cell, fail.Fail] = collect_cells(a, reg, ?cap);
    if (sel cells_r.err) { ret res[str, fail.Fail].err{cells_r.err}; }
    val cells: *Cell = cells_r.ok;
    fin { A.deallocate[Cell](a, cells, cap); }

    var w_name: usize = 0;
    var w_isa:  usize = 0;
    var w_os:   usize = 0;
    var w_abi:  usize = 0;
    var i:      usize = 0;
    for (i < cap && cells[i].os != nil) {
        val name_len: usize = str_len(cells[i].os.name) + 1 + str_len(cells[i].arch.name);
        if (name_len > w_name) { w_name = name_len; }
        w_isa = max_len(w_isa, cell_isa(?cells[i]));
        w_os  = max_len(w_os, cells[i].os.name);
        w_abi = max_len(w_abi, cells[i].abi.name);
        i     = i + 1;
    }

    var b: textbuild.TextBuilder = textbuild.tb_init(a);
    i = 0;
    for (i < cap && cells[i].os != nil) {
        val c: *Cell = ?cells[i];
        append(?b, c.os.name);
        append(?b, "-");
        append(?b, c.arch.name);
        pad(?b, str_len(c.os.name) + 1 + str_len(c.arch.name), w_name);
        column(?b, "isa", cell_isa(c), w_isa, false);
        column(?b, "os", c.os.name, w_os, false);
        column(?b, "abi", c.abi.name, w_abi, false);
        column(?b, "object", c.of.name, 0, true);
        append(?b, "\n");
        i = i + 1;
    }
    ret finish(?b);
}

fun t_registry(reg: *target.TargetRegistry) bool {
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(reg);
    ret sel setup_registry_r.ok;
}

fun t_line_count(text: str) usize {
    var n:   usize = 0;
    var i:   usize = 0;
    val len: usize = str_len(text);
    for (i < len) {
        if (text[i] == '\n') { n = n + 1; }
        i = i + 1;
    }
    ret n;
}

test "mach.cli.cmd.info.render_targets:matches_the_registries_and_composition" {
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    if (!t_registry(?reg)) { ret 99; }
    var alloc:   A.Allocator;
    val r_alloc: err[A.Error] = page.make(?alloc);
    if (sel r_alloc.err) { ret 99; }

    val text_r: res[str, fail.Fail] = render_targets(?alloc, ?reg);
    if (sel text_r.err) { ret 98; }
    val text: str = text_r.ok;

    var accepted: usize = 0;
    var oi:       u32   = 0;
    val os_len:   u32   = os.registered_count(?reg.os);
    for (oi < os_len) {
        val os_r: opt[*os.OsVTable] = os.registered(?reg.os, oi);
        if (sel os_r.none) { ret 97; }
        var ii:      u32 = 0;
        val isa_len: u32 = isa.registered_count(?reg.isa);
        for (ii < isa_len) {
            val isa_r: opt[*isa.IsaVTable] = isa.registered(?reg.isa, ii);
            if (sel isa_r.none) { ret 97; }
            var ai:      u32 = 0;
            val abi_len: u32 = abi.registered_count(?reg.abi);
            for (ai < abi_len) {
                val abi_r: opt[*abi.AbiVTable] = abi.registered(?reg.abi, ai);
                if (sel abi_r.none) { ret 97; }
                var fi:     u32 = 0;
                val of_len: u32 = of.registered_count(?reg.of);
                for (fi < of_len) {
                    val of_r: opt[*of.OfVTable] = of.registered(?reg.of, fi);
                    if (sel of_r.none) { ret 97; }
                    val os_vt:  *os.OsVTable   = os_r.some;
                    val isa_vt: *isa.IsaVTable = isa_r.some;
                    val abi_vt: *abi.AbiVTable = abi_r.some;
                    val of_vt:  *of.OfVTable   = of_r.some;

                    var model:    isa.MachineModel;
                    val selected: isa.IsaVTable = target.registered_selection(isa_vt, ?model);
                    val ok:       bool          = target.tuple_capability(os_vt, ?selected, abi_vt, of_vt) == target.TUPLE_OK;

                    val t_r: res[target.Target, fail.Fail] = target.select_of(?reg, isa_vt.name, os_vt.name, abi_vt.name, of_vt.name);
                    if (ok != sel t_r.ok) { ret 1; }

                    var lb:  [128]u8;
                    var off: usize = 0;
                    off     = t_put(?lb[0], 128, off, os_vt.name);
                    off     = t_put(?lb[0], 128, off, "-");
                    off     = t_put(?lb[0], 128, off, isa_vt.name);
                    off     = t_put(?lb[0], 128, off, " ");
                    lb[off] = 0;
                    var vb: [32]u8;
                    var kb: [256]u8;
                    var ko: usize = 0;
                    ko     = t_put(?kb[0], 256, ko, "isa=");
                    ko     = t_put(?kb[0], 256, ko, target.selection_spelling(?selected, ?vb[0], 32));
                    ko     = t_put(?kb[0], 256, ko, " ");
                    kb[ko] = 0;
                    var ob: [64]u8;
                    var oo: usize = 0;
                    oo     = t_put(?ob[0], 64, oo, "os=");
                    oo     = t_put(?ob[0], 64, oo, os_vt.name);
                    oo     = t_put(?ob[0], 64, oo, " ");
                    ob[oo] = 0;
                    var ab: [64]u8;
                    var ao: usize = 0;
                    ao     = t_put(?ab[0], 64, ao, "abi=");
                    ao     = t_put(?ab[0], 64, ao, abi_vt.name);
                    ao     = t_put(?ab[0], 64, ao, " ");
                    ab[ao] = 0;
                    var fb: [64]u8;
                    var fo: usize = 0;
                    fo     = t_put(?fb[0], 64, fo, "object=");
                    fo     = t_put(?fb[0], 64, fo, of_vt.name);
                    fo     = t_put(?fb[0], 64, fo, "\n");
                    fb[fo] = 0;
                    val listed: bool = t_has_line(text, (?lb[0])::str, (?kb[0])::str, (?ob[0])::str, (?ab[0])::str, (?fb[0])::str);
                    if (listed != ok) { ret 2; }
                    if (ok)           { accepted = accepted + 1; }
                    fi = fi + 1;
                }
                ai = ai + 1;
            }
            ii = ii + 1;
        }
        oi = oi + 1;
    }
    if (accepted == 0)                  { ret 3; }
    if (t_line_count(text) != accepted) { ret 4; }
    ret 0;
}

fun t_put(buf: *u8, cap: usize, off: usize, s: str) usize {
    var i: usize = 0;
    val n: usize = str_len(s);
    var o: usize = off;
    for (i < n && o < cap - 1) {
        buf[o] = s[i];
        o      = o + 1;
        i      = i + 1;
    }
    ret o;
}

# whether some line of text starts with head and then carries the four
# `key=value ` fields in order, each followed by its padding
fun t_has_line(text: str, head: str, f1: str, f2: str, f3: str, f4: str) bool {
    val len:   usize = str_len(text);
    var start: usize = 0;
    for (start < len) {
        var end: usize = start;
        for (end < len && text[end] != '\n') { end = end + 1; }
        if (t_line_matches(text, start, end + 1, head, f1, f2, f3, f4)) { ret true; }
        start = end + 1;
    }
    ret false;
}

fun t_line_matches(text: str, start: usize, end: usize, head: str, f1: str, f2: str, f3: str, f4: str) bool {
    var at: usize = start;
    if (!t_take(text, ?at, end, head)) { ret false; }
    t_skip_spaces(text, ?at, end);
    if (!t_take(text, ?at, end, f1)) { ret false; }
    t_skip_spaces(text, ?at, end);
    if (!t_take(text, ?at, end, f2)) { ret false; }
    t_skip_spaces(text, ?at, end);
    if (!t_take(text, ?at, end, f3)) { ret false; }
    t_skip_spaces(text, ?at, end);
    if (!t_take(text, ?at, end, f4)) { ret false; }
    ret at == end;
}

fun t_take(text: str, at: *usize, end: usize, s: str) bool {
    val n: usize = str_len(s);
    if (@at + n > end) { ret false; }
    var i: usize = 0;
    for (i < n) {
        if (text[@at + i] != s[i]) { ret false; }
        i = i + 1;
    }
    @at = @at + n;
    ret true;
}

fun t_skip_spaces(text: str, at: *usize, end: usize) {
    for (@at < end && text[@at] == ' ') { @at = @at + 1; }
}

test "mach.cli.cmd.info.render_targets:columns_align_on_the_widest_value" {
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    if (!t_registry(?reg)) { ret 99; }
    var alloc:   A.Allocator;
    val r_alloc: err[A.Error] = page.make(?alloc);
    if (sel r_alloc.err) { ret 99; }
    val text_r: res[str, fail.Fail] = render_targets(?alloc, ?reg);
    if (sel text_r.err) { ret 98; }
    val text: str = text_r.ok;

    # every line places `isa=`, `os=`, `abi=` and `object=` at one column each
    var col_isa: usize = 0;
    var col_os:  usize = 0;
    var col_abi: usize = 0;
    var col_of:  usize = 0;
    val len:     usize = str_len(text);
    var start:   usize = 0;
    var lines:   usize = 0;
    for (start < len) {
        var end: usize = start;
        for (end < len && text[end] != '\n') { end = end + 1; }
        val ci: usize = t_field_col(text, start, end, " isa=");
        val co: usize = t_field_col(text, start, end, " os=");
        val ca: usize = t_field_col(text, start, end, " abi=");
        val cf: usize = t_field_col(text, start, end, " object=");
        if (ci == 0 || co == 0 || ca == 0 || cf == 0) { ret 1; }
        if (lines == 0) {
            col_isa = ci;
            col_os  = co;
            col_abi = ca;
            col_of  = cf;
        }
        if (ci != col_isa || co != col_os || ca != col_abi || cf != col_of) { ret 2; }
        if (text[end - 1] == ' ')                                           { ret 3; }
        lines = lines + 1;
        start = end + 1;
    }
    if (lines < 2) { ret 4; }
    ret 0;
}

fun t_field_col(text: str, start: usize, end: usize, marker: str) usize {
    val n: usize = str_len(marker);
    var i: usize = start;
    for (i + n <= end) {
        var j: usize = 0;
        for (j < n && text[i + j] == marker[j]) { j = j + 1; }
        if (j == n) { ret i - start + 1; }
        i = i + 1;
    }
    ret 0;
}

test "mach.cli.cmd.info.render_host:prints_the_resolved_host_tuple" {
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    if (!t_registry(?reg)) { ret 99; }
    var alloc:   A.Allocator;
    val r_alloc: err[A.Error] = page.make(?alloc);
    if (sel r_alloc.err) { ret 99; }
    val text_r: res[str, fail.Fail] = render_host(?alloc, ?reg);
    if (sel text_r.err) { ret 98; }
    val text: str = text_r.ok;

    var vb: [64]u8;
    var vo: usize = 0;
    vo     = t_put(?vb[0], 64, vo, "mach ");
    vo     = t_put(?vb[0], 64, vo, version.MACH_VERSION);
    vo     = t_put(?vb[0], 64, vo, "\nhost: ");
    vb[vo] = 0;
    if (!t_starts_with(text, (?vb[0])::str)) { ret 1; }
    if (t_line_count(text) != 6)             { ret 2; }

    var req: target.TargetRequest          = target.host_request();
    val t_r: res[target.Target, fail.Fail] = target.resolve(?reg, ?req);
    if (sel t_r.err) { ret 3; }
    val t: target.Target = t_r.ok;
    if (!t_has_field(text, "host: ", t.os.name, "-", isa.arch_name_for(t.arch_id))) { ret 4; }
    if (!t_has_field(text, "os: ", t.os.name, "", ""))                              { ret 5; }
    if (!t_has_field(text, "abi: ", t.abi.name, "", ""))                            { ret 6; }
    if (!t_has_field(text, "object: ", t.of.name, "", ""))                          { ret 7; }
    var sb: [64]u8;
    if (!t_has_field(text, "isa: ", target.selection_spelling(t.isa, ?sb[0], 64), "", "")) { ret 8; }

    $if ($mach.build.os == $mach.os.linux && $mach.build.arch == $mach.arch.x86_64) {
        if (!str_contains(text, "\nhost: linux-x86_64\n")) { ret 10; }
        if (!str_contains(text, "\nisa: x86_64\n"))        { ret 11; }
        if (!str_contains(text, "\nos: linux\n"))          { ret 12; }
        if (!str_contains(text, "\nabi: sysv64\n"))        { ret 13; }
        if (!str_contains(text, "\nobject: elf\n"))        { ret 14; }
    }
    $or ($mach.build.os == $mach.os.linux && $mach.build.arch == $mach.arch.aarch64) {
        if (!str_contains(text, "\nabi: aapcs64\n")) { ret 13; }
        if (!str_contains(text, "\nobject: elf\n"))  { ret 14; }
    }
    $or ($mach.build.os == $mach.os.windows) {
        if (!str_contains(text, "\nabi: win64\n"))   { ret 13; }
        if (!str_contains(text, "\nobject: coff\n")) { ret 14; }
    }
    $or ($mach.build.os == $mach.os.darwin) {
        if (!str_contains(text, "\nobject: macho\n")) { ret 14; }
    }
    ret 0;
}

fun t_starts_with(text: str, prefix: str) bool {
    var at: usize = 0;
    ret t_take(text, ?at, str_len(text), prefix);
}

fun t_has_field(text: str, key: str, a: str, b: str, c: str) bool {
    var lb: [128]u8;
    var o:  usize = 0;
    o     = t_put(?lb[0], 128, o, "\n");
    o     = t_put(?lb[0], 128, o, key);
    o     = t_put(?lb[0], 128, o, a);
    o     = t_put(?lb[0], 128, o, b);
    o     = t_put(?lb[0], 128, o, c);
    o     = t_put(?lb[0], 128, o, "\n");
    lb[o] = 0;
    ret str_contains(text, (?lb[0])::str);
}

test "mach.cli.cmd.info.render_targets:lists_the_host_tuple_and_spells_riscv_selections" {
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    if (!t_registry(?reg)) { ret 99; }
    var alloc:   A.Allocator;
    val r_alloc: err[A.Error] = page.make(?alloc);
    if (sel r_alloc.err) { ret 99; }
    val text_r: res[str, fail.Fail] = render_targets(?alloc, ?reg);
    if (sel text_r.err) { ret 98; }
    val text: str = text_r.ok;

    var req: target.TargetRequest          = target.host_request();
    val t_r: res[target.Target, fail.Fail] = target.resolve(?reg, ?req);
    if (sel t_r.err) { ret 1; }
    val t:  target.Target = t_r.ok;
    var hb: [128]u8;
    var ho: usize         = 0;
    ho     = t_put(?hb[0], 128, ho, t.os.name);
    ho     = t_put(?hb[0], 128, ho, "-");
    ho     = t_put(?hb[0], 128, ho, isa.arch_name_for(t.arch_id));
    ho     = t_put(?hb[0], 128, ho, " ");
    hb[ho] = 0;
    if (!str_contains(text, (?hb[0])::str)) { ret 2; }

    # the riscv rows carry the extension string the registered name selects, and
    # only the calling conventions that selection can carry
    if (!str_contains(text, "freestanding-riscv32"))       { ret 3; }
    if (!str_contains(text, "isa=rv32imac"))               { ret 4; }
    if (!str_contains(text, "isa=rv64gc"))                 { ret 5; }
    if (str_contains(text, "isa=riscv32"))                 { ret 6; }
    if (t_row(text, "freestanding-riscv32", "abi=ilp32f")) { ret 7; }
    if (t_row(text, "freestanding-riscv32", "abi=ilp32d")) { ret 8; }
    if (!t_row(text, "freestanding-riscv32", "abi=ilp32")) { ret 9; }
    if (!t_row(text, "linux-riscv64", "abi=lp64d"))        { ret 10; }
    if (!t_row(text, "freestanding-x86_64", "object=raw")) { ret 11; }
    if (!t_row(text, "freestanding-x86_64", "object=elf")) { ret 12; }
    if (t_row(text, "windows-aarch64", ""))                { ret 13; }
    ret 0;
}

# whether some line begins with head and contains field
fun t_row(text: str, head: str, field: str) bool {
    val len:   usize = str_len(text);
    var start: usize = 0;
    for (start < len) {
        var end: usize = start;
        for (end < len && text[end] != '\n') { end = end + 1; }
        var at: usize = start;
        if (t_take(text, ?at, end, head) && at < end && text[at] == ' ') {
            if (str_len(field) == 0 || t_field_col(text, start, end, field) != 0) { ret true; }
        }
        start = end + 1;
    }
    ret false;
}
