use std.print;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.string.str;

use O: std.types.option;
use R: std.types.result;

use mach.cli.args;
use mach.lang.driver;
use mach.lang.target;
use mach.lang.target.abi;
use mach.lang.target.isa;
use mach.lang.target.of;
use mach.lang.target.os;
use mach.lang.version;

# `mach info`: print "mach <version>", the host os and arch, and every registered target's
# capabilities. `--version` prints the version alone; the verb `targets` prints the target
# matrix; combining the two, or any other verb, is an error
# ---
# argv: the full process arguments
# inv: the parsed invocation for this command
# ret: 0 success, 1 usage error, 2 target registration failure
pub fun run_typed(argv: **u8, inv: *args.ParsedInvocation) i64 {
    if (args.reject_unknown_from_invocation(inv, argv, "mach info")) { ret 1; }
    val parsed: args.InfoInvocation = args.build_info_invocation(inv, argv);

    if (parsed.invalid_verb) {
        print.eprint("error: expected 'targets' as the sole info verb\n");
        ret 1;
    }
    if (parsed.show_version && parsed.show_targets) {
        print.eprint("error: --version and targets cannot be combined\n");
        ret 1;
    }

    if (parsed.show_version) {
        print.println(version.MACH_VERSION);
        ret 0;
    }

    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val res_register_all: R.Result[R.Void, str] = driver.setup_registry(?reg);
    if (R.is_err[R.Void, str](res_register_all)) {
        print.eprint("error: ");
        print.eprintln(R.unwrap_err[R.Void, str](res_register_all));
        ret 2;
    }

    if (parsed.show_targets) {
        print_targets(?reg);
        ret 0;
    }

    print.print("mach ");
    print.println(version.MACH_VERSION);

    print.print("host: ");
    print.print(host_os_name());
    print.print("/");
    print.println(host_arch_name());

    print_capabilities(?reg);
    ret 0;
}

fun host_os_name() str {
    $if ($mach.build.os == $mach.os.linux)   { ret "linux"; }
    $or ($mach.build.os == $mach.os.darwin)  { ret "darwin"; }
    $or ($mach.build.os == $mach.os.windows) { ret "windows"; }
    $or                                      { ret "unknown"; }
}

fun host_arch_name() str {
    $if ($mach.build.arch == $mach.arch.x86_64)  { ret "x86_64"; }
    $or ($mach.build.arch == $mach.arch.aarch64) { ret "aarch64"; }
    $or ($mach.build.arch == $mach.arch.riscv64) { ret "riscv64"; }
    $or                                          { ret "unknown"; }
}

fun print_capabilities(reg: *target.TargetRegistry) {
    print_isa(?reg.isa);
    print_os(?reg.os);
    print_abi(?reg.abi);
    print_of(?reg.of);
}

fun print_isa(reg: *isa.IsaRegistry) {
    print.print("isa:");
    var i:   u32 = 0;
    val len: u32 = isa.registered_count(reg);
    for (i < len) {
        val vt: *isa.IsaVTable = O.unwrap[*isa.IsaVTable](isa.registered(reg, i));
        print.print(" ");
        print.print(vt.name);
        i = i + 1;
    }
    print.print("\n");
}

fun print_os(reg: *os.OsRegistry) {
    print.print("os:");
    var i:   u32 = 0;
    val len: u32 = os.registered_count(reg);
    for (i < len) {
        val vt: *os.OsVTable = O.unwrap[*os.OsVTable](os.registered(reg, i));
        print.print(" ");
        print.print(vt.name);
        i = i + 1;
    }
    print.print("\n");
}

fun print_abi(reg: *abi.AbiRegistry) {
    print.print("abi:");
    var i:   u32 = 0;
    val len: u32 = abi.registered_count(reg);
    for (i < len) {
        val vt: *abi.AbiVTable = O.unwrap[*abi.AbiVTable](abi.registered(reg, i));
        print.print(" ");
        print.print(vt.name);
        i = i + 1;
    }
    print.print("\n");
}

fun print_of(reg: *of.OfRegistry) {
    print.print("object:");
    var i:   u32 = 0;
    val len: u32 = of.registered_count(reg);
    for (i < len) {
        val vt: *of.OfVTable = O.unwrap[*of.OfVTable](of.registered(reg, i));
        print.print(" ");
        print.print(vt.name);
        i = i + 1;
    }
    print.print("\n");
}

fun print_targets(reg: *target.TargetRegistry) {
    var oi:     u32 = 0;
    val os_len: u32 = os.registered_count(?reg.os);
    for (oi < os_len) {
        val os_vt: *os.OsVTable = O.unwrap[*os.OsVTable](os.registered(?reg.os, oi));
        var ii:      u32 = 0;
        val isa_len: u32 = isa.registered_count(?reg.isa);
        for (ii < isa_len) {
            val isa_vt: *isa.IsaVTable = O.unwrap[*isa.IsaVTable](isa.registered(?reg.isa, ii));
            if (os_isa_supported(reg, os_vt, isa_vt)) {
                print.print(os_vt.name);
                print.print("-");
                print.print(isa_vt.name);
                print.print("\n");
            }
            ii = ii + 1;
        }
        oi = oi + 1;
    }
}

fun os_isa_supported(reg: *target.TargetRegistry, os_vt: *os.OsVTable, isa_vt: *isa.IsaVTable) bool {
    var fi:     u32 = 0;
    val of_len: u32 = of.registered_count(?reg.of);
    for (fi < of_len) {
        val of_vt: *of.OfVTable = O.unwrap[*of.OfVTable](of.registered(?reg.of, fi));
        var ai:      u32 = 0;
        val abi_len: u32 = abi.registered_count(?reg.abi);
        for (ai < abi_len) {
            val abi_vt: *abi.AbiVTable = O.unwrap[*abi.AbiVTable](abi.registered(?reg.abi, ai));
            if (target.tuple_capability(os_vt, isa_vt, abi_vt, of_vt) == target.TUPLE_OK) { ret true; }
            ai = ai + 1;
        }
        fi = fi + 1;
    }
    ret false;
}

test "mach.cli.cmd.info.print_targets:advertised_tuples_compose_by_default" {
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    if (R.is_err[R.Void, str](driver.setup_registry(?reg))) { ret 1; }

    var advertised: u32 = 0;
    var oi:     u32 = 0;
    val os_len: u32 = os.registered_count(?reg.os);
    for (oi < os_len) {
        val os_vt: *os.OsVTable = O.unwrap[*os.OsVTable](os.registered(?reg.os, oi));
        var ii:      u32 = 0;
        val isa_len: u32 = isa.registered_count(?reg.isa);
        for (ii < isa_len) {
            val isa_vt: *isa.IsaVTable = O.unwrap[*isa.IsaVTable](isa.registered(?reg.isa, ii));
            if (os_isa_supported(?reg, os_vt, isa_vt)) {
                advertised = advertised + 1;

                var composed: bool = false;
                var ai:      u32   = 0;
                val abi_len: u32   = abi.registered_count(?reg.abi);
                for (ai < abi_len) {
                    val abi_vt: *abi.AbiVTable = O.unwrap[*abi.AbiVTable](abi.registered(?reg.abi, ai));
                    val r: R.Result[target.Target, str] = target.select(?reg, isa_vt.name, os_vt.name, abi_vt.name);
                    if (R.is_ok[target.Target, str](r)) { composed = true; }
                    ai = ai + 1;
                }
                if (!composed) { ret 1; }
            }
            ii = ii + 1;
        }
        oi = oi + 1;
    }

    if (advertised == 0) { ret 1; }
    ret 0;
}
