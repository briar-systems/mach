use mach.lang.fail;
use std_args:        std.args;
use chrono_duration: std.chrono.duration;
use fs:              std.filesystem;
use std_format:      std.format;
use io_error:        std.io.error;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;

use mach.cli.args;
use mach.cli.cmd.build;
use cli_diagnostic: mach.cli.diagnostic;
use mach.cli.exit;
use mach.cli.util;
use mach.lang.diagnostic;
use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.driver;
use mach.lang.driver.config;
use mach.lang.driver.toolchain;
use mach.lang.duration;
use mach.lang.host;
use mach.lang.manifest;
use mach.lang.manifest.runner;
use mach.lang.subprocess;
use lang_target: mach.lang.target;

# SEL rows run accepts: every row but `--all`, since run executes one artifact
val SEL_ACCEPTED: [args.SEL_N]bool = [args.SEL_N]bool{true, true, true, true, true, true, false, true};

# length of TABLES
val TABLES_N: usize = 3;
# the option tables mach run accepts: SEL masked by SEL_ACCEPTED, `--runner` and `--timeout`
val TABLES: [TABLES_N]std_args.TableRef = [TABLES_N]std_args.TableRef{
    std_args.TableRef{rows: ?args.SEL[0], n: args.SEL_N, accepted: ?SEL_ACCEPTED[0], docs: nil},
    std_args.TableRef{rows: ?args.RUNNERS[0], n: args.RUNNERS_N, accepted: nil, docs: nil},
    std_args.TableRef{rows: ?args.TIMEOUTS[0], n: args.TIMEOUTS_N, accepted: nil, docs: nil},
};

# length of REFUSED
val REFUSED_N: usize = 10;
# the build options run recognizes only to refuse, since it builds nothing
val REFUSED: [REFUSED_N]std_args.TableRef = [REFUSED_N]std_args.TableRef{
    std_args.TableRef{rows: ?args.VERBOSITY[0], n: args.VERBOSITY_N, accepted: nil, docs: nil},
    std_args.TableRef{rows: ?args.QUIETNESS[0], n: args.QUIETNESS_N, accepted: nil, docs: nil},
    std_args.TableRef{rows: ?args.CGEN[0], n: args.CGEN_N, accepted: nil, docs: nil},
    std_args.TableRef{rows: ?args.LEVERS[0], n: args.LEVERS_N, accepted: nil, docs: nil},
    std_args.TableRef{rows: ?args.WORKDIR[0], n: args.WORKDIR_N, accepted: nil, docs: nil},
    std_args.TableRef{rows: ?args.EMITS[0], n: args.EMITS_N, accepted: nil, docs: nil},
    std_args.TableRef{rows: ?args.WORKERS[0], n: args.WORKERS_N, accepted: nil, docs: nil},
    std_args.TableRef{rows: ?args.LINKIN[0], n: args.LINKIN_N, accepted: nil, docs: nil},
    std_args.TableRef{rows: ?args.CACHE[0], n: args.CACHE_N, accepted: nil, docs: nil},
    std_args.TableRef{rows: ?args.PLANS[0], n: args.PLANS_N, accepted: nil, docs: nil},
};

# length of CONSTRAINTS
val CONSTRAINTS_N: usize = 2;
# the constraint sentences help prints for run; the second is enforced by the run command
val CONSTRAINTS: [CONSTRAINTS_N]str = [CONSTRAINTS_N]str{
    args.SELECTOR_CONSTRAINT,
    "the selection must resolve to exactly one (artifact, target, profile)",
};

# length of EXITS
val EXITS_N: usize = 2;
# the exit codes run documents beside exit.SHARED
val EXITS: [EXITS_N]std_args.Exit = [EXITS_N]std_args.Exit{
    std_args.Exit{code: std_args.PASSTHROUGH, meaning: "the program's own exit code, or 128 plus the signal number when a signal ended it"},
    std_args.Exit{code: exit.TIMEOUT, meaning: "the program exceeded --timeout and its process group was terminated"},
};

# `mach run`
pub val COMMAND: std_args.CommandSpec = std_args.CommandSpec{name: "run", id: 0, aliases: nil, alias_n: 0, grammar: " <path> [options] [-- args...]", summary: "execute a built project artifact", effect: "resolve an existing built executable and run it without rebuilding", exits: ?EXITS[0], exit_n: EXITS_N, terminator: "arguments after -- are forwarded to the program", tables: ?TABLES[0], table_n: TABLES_N, refused: ?REFUSED[0], refused_n: REFUSED_N, refusal: "run executes an existing artifact", relations: nil, relation_n: 0, constraints: ?CONSTRAINTS[0], constraint_n: CONSTRAINTS_N, operand_min: 0, operand_max: std_args.OPERANDS_ANY, truncate_at_sep: true, actions: nil, action_n: 0, examples: nil, example_n: 0};

# `mach run`: execute the project's already-built binary, forwarding the arguments after
# `--` to it. a target that declares a `runner` launches the expanded runner followed by
# the arguments instead, and `--runner <cmd>` replaces it for this run with
# `<cmd> <binary> <args>`; a target that is not the host's and has neither is refused.
# `--timeout <duration>` runs the program in its own process group and terminates it
# after the duration
# ---
# cx:  the call
# ret: the program's exit code; 128 plus the signal number when it was killed by a signal;
#      exit.TIMEOUT when the timeout expired; otherwise mach's own failure: a user failure for a
#      usage error or an artifact that is missing or that the system refuses to execute (a
#      malformed image fails the spawn on windows), an environment failure for a wait, an
#      internal one out of memory
pub fun run(cx: *args.Call) res[i64, fail.Fail] {
    val inv:   *std_args.Invocation = cx.inv;
    val argv:  **u8                 = inv.args.argv;
    val alloc: *A.Allocator         = cx.a;
    val sep:   usize                = std_args.separator(inv);

    val timeout_given: opt[*u8]                 = args.value(inv, ?args.TIMEOUT);
    var timeout:       chrono_duration.Duration = 0;
    var timeout_text:  str                      = "";
    if (sel timeout_given.some) {
        timeout_text = timeout_given.some::str;
        val tv: opt[chrono_duration.Duration] = duration.parse(timeout_given.some);
        if (sel tv.none) { ret refused(alloc, diagnostic_kind.CLI_FLAG_VALUE, std_format.sprint(alloc, "--timeout expects {}", duration.FORMS)); }
        timeout = tv.some;
    }
    var output:       *u8      = nil;
    val output_given: opt[*u8] = args.value(inv, ?args.OUTPUT);
    if (sel output_given.some) { output = output_given.some; }

    val arg: *u8 = args.operand(inv, 0);

    val loc_r: res[util.ProjectLocation, fail.Fail] = util.resolve_project_location(alloc, arg);
    if (sel loc_r.err) { ret res[i64, fail.Fail].err{loc_r.err}; }
    val root: str = loc_r.ok.root;

    val selectors_r: res[manifest.Selectors, fail.Fail] = args.collect_selectors(alloc, inv);
    if (sel selectors_r.err) { ret res[i64, fail.Fail].err{selectors_r.err}; }
    var selectors: manifest.Selectors = selectors_r.ok;

    val res_ra: res[config.RunArtifact, fail.Fail] = driver.resolve_run_artifact(alloc, root, ?selectors, output);
    if (sel res_ra.err) { ret res[i64, fail.Fail].err{args.selection_hint(alloc, ?selectors, res_ra.err)}; }
    val ra:          config.RunArtifact = res_ra.ok;
    val output_path: str                = ra.path;

    val is_file_r: res[bool, io_error.Error] = fs.is_file(output_path);
    if (!(sel is_file_r.ok && is_file_r.ok)) {
        ret refused(alloc, diagnostic_kind.ARTIFACT_NOT_BUILT, std_format.sprint(alloc, "no built artifact at '{}'; run `mach build` first", output_path));
    }

    var launcher:     runner.Runner = ra.runner;
    val runner_given: opt[*u8]      = args.value(inv, ?args.RUNNER);
    if (sel runner_given.some) {
        val name:       *u8                 = runner_given.some;
        val res_runner: res[*u8, fail.Fail] = host.program_resolve(alloc, name);
        if (sel res_runner.err) {
            val said: res[str, std_format.FormatError] = std_format.sprint(alloc, "--runner '{}': {}", name::str, fail.describe(res_runner.err));
            if (sel said.err) { ret res[i64, fail.Fail].err{fail.format_refused(said.err)}; }
            ret res[i64, fail.Fail].err{fail.owning(fail.with_text(res_runner.err, said.ok))};
        }
        launcher = runner.overriding(res_runner.ok, ra.target_name);
    }
    or (!runner.given(?launcher)) {
        if (!ra.host_runnable) {
            ret refused(alloc, diagnostic_kind.TARGET_NOT_RUNNABLE, std_format.sprint(alloc,
                "target '{}' is not runnable on this host and declares no execution command; declare `runner` in [target.{}] or pass --runner", ra.target_name, ra.target_name));
        }
        val executable_r: res[str, fail.Fail] = host.program_resolve(alloc, output_path);
        if (sel executable_r.err) {
            ret refused(alloc, diagnostic_kind.ARTIFACT_NOT_EXECUTABLE, std_format.sprint(alloc, "built artifact '{}' is not executable", output_path));
        }
        str_free(alloc, executable_r.ok);
    }

    var fwd_len: usize = 0;
    if (sep < inv.args.argc) { fwd_len = inv.args.argc - sep - 1; }

    val through: bool = runner.given(?launcher);
    var fwd:     **u8 = nil;
    if (fwd_len > 0) { fwd = ?argv[sep + 1]; }
    var cmd: runner.Command;
    if (through) {
        val made: res[runner.Command, fail.Fail] = runner.command(alloc, ?launcher, output_path, fwd, fwd_len);
        if (sel made.err) { ret res[i64, fail.Fail].err{made.err}; }
        cmd = made.ok;
    }
    or {
        val res_child_argv: res[**u8, A.Error] = A.allocate[*u8](alloc, fwd_len + 2);
        if (sel res_child_argv.err) { ret res[i64, fail.Fail].err{fail.refused(res_child_argv.err)}; }
        cmd         = runner.Command{argv: res_child_argv.ok, len: fwd_len + 1, lead: 1};
        cmd.argv[0] = output_path;
        var i: usize = 0;
        for (i < fwd_len) {
            cmd.argv[1 + i] = fwd[i];
            i               = i + 1;
        }
        cmd.argv[1 + fwd_len] = nil;
    }
    val child_argv: **u8 = cmd.argv;
    val exe:        *u8  = cmd.argv[0];

    var child: subprocess.OwnedSubprocess;
    subprocess.init(?child);
    fin { subprocess.dnit(alloc, ?child); }
    var options: subprocess.SpawnOptions = subprocess.spawn_options();
    options.grouped = timeout > 0;
    if (timeout > 0) {
        val bounded: err[subprocess.Error] = subprocess.bound(?child, timeout);
        if (sel bounded.err) { ret res[i64, fail.Fail].err{subprocess.refusal(alloc, diagnostic_kind.PROCESS_WAIT, bounded.err)}; }
    }
    val res_spawn: err[subprocess.Error] = subprocess.spawn(alloc, ?child, exe::str, child_argv, cx.environ, options);
    if (sel res_spawn.err) {
        if (through) { ret res[i64, fail.Fail].err{fail.user(diagnostic_kind.PROCESS_SPAWN, "failed to execute the runner")}; }
        ret res[i64, fail.Fail].err{fail.user(diagnostic_kind.PROCESS_SPAWN, "failed to execute the built binary")};
    }

    var res_wait: res[subprocess.SubprocessTerminal, fail.Fail];
    if (timeout > 0) {
        val wr: res[*subprocess.OwnedSubprocess, subprocess.Error] = subprocess.wait_any(alloc, ?child, 1, nil, nil);
        if (sel wr.err) {
            res_wait = res[subprocess.SubprocessTerminal, fail.Fail].err{subprocess.refusal(alloc, diagnostic_kind.PROCESS_WAIT, wr.err)};
        }
        if (sel wr.ok) { res_wait = res[subprocess.SubprocessTerminal, fail.Fail].ok{child.terminal}; }
    }
    or {
        val waited: res[subprocess.SubprocessTerminal, subprocess.Error] = subprocess.wait(alloc, ?child);
        if (sel waited.err) { res_wait = res[subprocess.SubprocessTerminal, fail.Fail].err{subprocess.refusal(alloc, diagnostic_kind.PROCESS_WAIT, waited.err)}; }
        if (sel waited.ok)  { res_wait = res[subprocess.SubprocessTerminal, fail.Fail].ok{waited.ok}; }
    }
    if (sel res_wait.err) {
        val said:        res[str, std_format.FormatError] = std_format.sprint(alloc, "failed to wait for the executed process: {}", fail.describe(res_wait.err));
        var waited_fail: fail.Fail                        = res_wait.err;
        if (sel said.ok)                 { waited_fail = fail.owning(fail.with_text(res_wait.err, said.ok)); }
        if (!subprocess.running(?child)) { ret res[i64, fail.Fail].err{waited_fail}; }
        val cancelled: res[subprocess.SubprocessTerminal, subprocess.Error] = subprocess.cancel(alloc, ?child, 0);
        if (sel cancelled.err) { ret res[i64, fail.Fail].err{fail.with_secondary(alloc, waited_fail, subprocess.refusal(alloc, diagnostic_kind.PROCESS_WAIT, cancelled.err))}; }
        ret res[i64, fail.Fail].err{waited_fail};
    }
    val expired:  bool                          = subprocess.expired(?child);
    val terminal: subprocess.SubprocessTerminal = res_wait.ok;

    if (expired) {
        val said: res[str, std_format.FormatError] = std_format.sprint(alloc, "the program exceeded --timeout {} and its process group was terminated", timeout_text);
        if (sel said.ok) { cli_diagnostic.report_fail(cx.report, fail.user(diagnostic_kind.PROCESS_TIMEOUT, said.ok), diagnostic.ORIGIN_NONE); }
        ret res[i64, fail.Fail].ok{exit.TIMEOUT};
    }
    if (terminal.kind == subprocess.STATE_EXITED)   { ret res[i64, fail.Fail].ok{terminal.code::i64}; }
    if (terminal.kind == subprocess.STATE_SIGNALED) { ret res[i64, fail.Fail].ok{128 + terminal.code::i64}; }
    ret res[i64, fail.Fail].err{fail.environment(diagnostic_kind.PROCESS_NO_STATUS, "the executed process ended without an exit status or a signal")};
}

# a user failure of kind k with the formatted text, or the refusal to format it
fun refused(a: *A.Allocator, k: diagnostic_kind.Kind, said: res[str, std_format.FormatError]) res[i64, fail.Fail] {
    if (sel said.err) { ret res[i64, fail.Fail].err{fail.format_refused(said.err)}; }
    ret res[i64, fail.Fail].err{fail.user(k, said.ok)};
}
