use std.types.canonical.res;
use std.types.canonical.opt;
use std.types.canonical.err;
use io_error: std.io.error;
use outcome: mach.lang.build.outcome;
use arena: std.allocator.arena;
use page: std.allocator.page;
use vector: std.collections.vector;
use std.collections.vector.Vector;
use fs: std.filesystem;
use print: std.print;
use env: std.process.env;
use exec: std.process.exec;
use format: std.format;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use path: std.types.path;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;

use A: std.allocator;

use mach.cli.args;
use mach.cli.cmd.build;
use mach.cli.util;
use mach.lang.driver;
use dcfg: mach.lang.driver.config;
use mach.lang.manifest;
use mach.subprocess;

# `mach run`: execute the project's already-built binary, forwarding the arguments after
# `--` to it. `--emit` and build-only options are refused; `--runner <cmd>` executes
# `<cmd> <binary> <args>` instead, which is required when the target is not runnable on
# this host; `--timeout_seconds <n>` runs the program in its own process group and
# terminates it after n seconds
# ---
# argv: the full process arguments
# inv: the parsed invocation for this command
# ret: the program's exit code; 128 plus the signal number when it was killed by a signal;
#  3 when the timeout expired; 1 for a usage error, a missing or non-executable artifact,
#  or a spawn or wait failure; 2 out of memory
pub fun run_typed(argv: **u8, inv: *args.ParsedInvocation) i64 {
    val sep: usize = inv.sep_idx;

    val opt_emit: opt[str] = util.flag_value(sep, argv, "--emit");
    if (sel opt_emit.some) {
        print.eprint("error: 'mach run' does not support --emit\n");
        ret 1;
    }

    var backing: A.Allocator;
    val make_r: err[A.Error] = page.make(?backing);
    if (sel make_r.err) {
        print.eprint("error: failed to initialise allocator\n");
        ret 2;
    }
    var ar: arena.Arena;
    val init_r: err[A.Error] = arena.init(?ar, ?backing, 0);
    if (sel init_r.err) {
        print.eprint("error: failed to initialise allocator\n");
        ret 2;
    }
    var alloc: A.Allocator;
    val make_r2: err[A.Error] = arena.make(?alloc, ?ar);
    if (sel make_r2.err) {
        arena.dnit(?ar);
        print.eprint("error: failed to initialise allocator\n");
        ret 2;
    }

    val parsed: args.RunInvocation = args.build_run_invocation(inv);

    val inert: opt[*u8] = reject_inert(sep, argv, inv.marks);
    if (sel inert.some) {
        print.eprintf("error: option '{}' is not applicable to 'run'; run executes an existing artifact\n",
            inert.some::str);
        arena.dnit(?ar);
        ret 1;
    }
    if (args.reject_unknown_from_invocation(inv, argv, "mach run")) {
        arena.dnit(?ar);
        ret 1;
    }

    if (parsed.output_seen && !parsed.has_output) {
        print.eprint("error: -o requires a value\n");
        arena.dnit(?ar);
        ret 1;
    }

    var timeout_seconds: i64 = 0;
    if (parsed.has_timeout) {
        timeout_seconds = parse_seconds(argv[parsed.timeout_idx]);
        if (timeout_seconds < 1) {
            print.eprint("error: --timeout_seconds expects a positive integer number of seconds\n");
            arena.dnit(?ar);
            ret 1;
        }
    }
    var output: *u8 = nil;
    if (parsed.has_output) { output = argv[parsed.output_idx]; }

    val pix: usize = inv.positional_idx;
    var arg: *u8 = nil;
    if (inv.has_positional && pix < sep) { arg = argv[pix]; }

    val loc_r: res[util.ProjectLocation, outcome.Fail] = util.resolve_project_location(?alloc, arg);
    if (sel loc_r.err) {
        print.eprint("error: ");
        print.eprint(outcome.describe(loc_r.err));
        print.eprint("\n");
        arena.dnit(?ar);
        ret 1;
    }
    val loc: util.ProjectLocation = loc_r.ok;
    val root: str = loc.root;

    var pick: manifest.Selection;
    var target_name: *u8 = "";
    if (parsed.has_target) { target_name = argv[parsed.target_idx]; }
    var profile_name: *u8 = "";
    if (parsed.has_profile) { profile_name = argv[parsed.profile_idx]; }
    var artifact_name: *u8  = "";
    var has_artifact:  bool = false;
    if (parsed.has_bin) { artifact_name = argv[parsed.bin_idx]; has_artifact = true; }
    pick.profile      = profile_name::str;
    pick.target       = target_name::str;
    pick.artifact     = artifact_name::str;
    pick.want_lib     = false;
    pick.has_artifact = has_artifact;

    val res_ra: res[dcfg.RunArtifact, outcome.Fail] = driver.resolve_run_artifact(?alloc, root, ?pick, output);
    if (sel res_ra.err) {
        print.eprint("error: ");
        print.eprint(outcome.describe(res_ra.err));
        print.eprint("\n");
        arena.dnit(?ar);
        ret 1;
    }
    val ra: dcfg.RunArtifact = res_ra.ok;
    val output_path: str = ra.path;

    val is_file_r: res[bool, io_error.Error] = fs.is_file(output_path);
    if (sel is_file_r.err) {
        print.eprint("error: no built artifact at '");
        print.eprint(output_path);
        print.eprint("'; run `mach build` first\n");
        arena.dnit(?ar);
        ret 1;
    }
    if (!(is_file_r.ok)) {
        print.eprint("error: no built artifact at '");
        print.eprint(output_path);
        print.eprint("'; run `mach build` first\n");
        arena.dnit(?ar);
        ret 1;
    }

    var runner: *u8 = nil;
    if (parsed.has_runner) {
        val name: *u8 = argv[parsed.runner_idx];
        val res_runner: res[*u8, outcome.Fail] = util.resolve_cmd(?alloc, name);
        if (sel res_runner.err) {
            print.eprint("error: --runner '");
            print.eprint(name::str);
            print.eprint("': ");
            print.eprint(outcome.describe(res_runner.err));
            print.eprint("\n");
            arena.dnit(?ar);
            ret 1;
        }
        runner = res_runner.ok;
    }
    or {
        if (!ra.host_runnable) {
            print.eprintf("error: target '{}' is not runnable on this host; pass --runner\n", ra.target_name);
            arena.dnit(?ar);
            ret 1;
        }
        val executable_r: res[str, outcome.Fail] = util.resolve_cmd(?alloc, output_path);
        if (sel executable_r.err) {
            print.eprint("error: built artifact '");
            print.eprint(output_path);
            print.eprint("' is not executable\n");
            arena.dnit(?ar);
            ret 1;
        }
        str_free(?alloc, executable_r.ok);
    }

    var fwd_len: usize = 0;
    if (sep < inv.argc) { fwd_len = inv.argc - sep - 1; }

    var lead: usize = 0;
    if (runner != nil) { lead = 1; }

    val child_len: usize = lead + 1 + fwd_len + 1;
    val res_child_argv: res[**u8, A.Error] = A.allocate[*u8](?alloc, child_len);
    if (sel res_child_argv.err) {
        print.eprint("error: out of memory\n");
        arena.dnit(?ar);
        ret 2;
    }
    val child_argv: **u8 = res_child_argv.ok;

    if (runner != nil) { child_argv[0] = runner; }
    child_argv[lead] = output_path;
    var i: usize = 0;
    for (i < fwd_len) {
        child_argv[lead + 1 + i] = argv[sep + 1 + i];
        i = i + 1;
    }
    child_argv[lead + 1 + fwd_len] = nil;

    var exe: *u8 = output_path;
    if (runner != nil) { exe = runner; }

    var child: subprocess.OwnedSubprocess;
    subprocess.init(?child);
    var res_spawn: err[subprocess.Error];
    if (timeout_seconds > 0) {
        res_spawn = subprocess.spawn_grouped(?alloc, ?child, exe::str, child_argv, env.environ());
    }
    or {
        res_spawn = subprocess.spawn(?alloc, ?child, exe::str, child_argv, env.environ());
    }
    if (sel res_spawn.err) {
        if (runner != nil) { print.eprint("error: failed to execute the runner\n"); }
        or                 { print.eprint("error: failed to execute the built binary\n"); }
        arena.dnit(?ar);
        ret 1;
    }

    var res_wait: res[subprocess.SubprocessTerminal, outcome.Fail];
    if (timeout_seconds > 0) {
        subprocess.bound_seconds(?child, timeout_seconds);
        val wr: res[*subprocess.OwnedSubprocess, subprocess.Error] = subprocess.wait_any(?alloc, ?child, 1, nil, nil);
        if (sel wr.err) {
            res_wait = res[subprocess.SubprocessTerminal, outcome.Fail].err{outcome.user(subprocess.text(?alloc, wr.err))};
        }
        if (sel wr.ok) { res_wait = res[subprocess.SubprocessTerminal, outcome.Fail].ok{child.terminal}; }
    }
    or {
        val waited: res[subprocess.SubprocessTerminal, subprocess.Error] = subprocess.wait(?alloc, ?child);
        if (sel waited.err) { res_wait = res[subprocess.SubprocessTerminal, outcome.Fail].err{outcome.user(subprocess.text(?alloc, waited.err))}; }
        if (sel waited.ok) { res_wait = res[subprocess.SubprocessTerminal, outcome.Fail].ok{waited.ok}; }
    }
    if (sel res_wait.err) {
        print.eprint("error: failed to wait for the executed process\n");
        subprocess.cancel(?alloc, ?child, 0);
        subprocess.dnit(?alloc, ?child);
        arena.dnit(?ar);
        ret 1;
    }
    val expired: bool = subprocess.expired(?child);
    val terminal: subprocess.SubprocessTerminal =
        res_wait.ok;
    subprocess.dnit(?alloc, ?child);
    arena.dnit(?ar);

    if (expired) {
        print.eprintf("error: the program exceeded --timeout_seconds {} and its process group was terminated\n",
            timeout_seconds);
        ret 3;
    }
    if (terminal.kind == subprocess.STATE_EXITED) {
        ret terminal.code::i64;
    }
    if (terminal.kind == subprocess.STATE_SIGNALED) {
        ret 128 + terminal.code::i64;
    }
    ret 1;
}

fun parse_seconds(s: *u8) i64 {
    if (s == nil || s[0] == 0) { ret -1; }
    var v: i64 = 0;
    var i: usize = 0;
    for (s[i] != 0) {
        if (s[i] < '0' || s[i] > '9') { ret -1; }
        v = v * 10 + (s[i] - '0')::i64;
        if (v > 65536) { ret -1; }
        i = i + 1;
    }
    ret v;
}

fun o_missing_value(sep: usize, argv: **u8, output: *u8) bool {
    ret util.flag_exists(sep, argv, "-o") && output == nil;
}

fun t_run(argc: usize, argv: **u8) i64 {
    var a: A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 2; }
    val ir: res[args.ParsedInvocation, outcome.Fail] = args.parse_invocation(?a, argc, argv);
    if (sel ir.err) { ret 2; }
    var inv: args.ParsedInvocation = ir.ok;
    fin { args.dnit_invocation(?a, ?inv); }
    ret run_typed(argv, ?inv);
}

fun reject_inert(sep: usize, argv: **u8, marks: *bool) opt[*u8] {
    var i: usize = 2;
    for (i < sep) {
        if (!marks[i]) {
            val tok: *u8 = argv[i];
            if (args.flag_in_table(tok, ?args.RDO[0], args.RDO_N)
                || args.flag_in_table(tok, ?args.CGEN[0], args.CGEN_N)
                || args.flag_in_table(tok, ?args.OPT[0], args.OPT_N)) {
                ret opt[*u8].some{tok};
            }
        }
        i = i + 1;
    }
    ret opt[*u8].none{};
}

fun t_rejects_alone(tok: *u8) bool {
    var argv: [3]*u8;
    argv[0] = "mach"; argv[1] = "run"; argv[2] = tok;
    var marks: [3]bool;
    marks[0] = false; marks[1] = false; marks[2] = false;
    val reject_inert_r: opt[*u8] = reject_inert(3, ?argv[0], ?marks[0]);
    if (sel reject_inert_r.none) { ret false; }
    ret sel reject_inert_r.some;
}

test "mach.cli.cmd.run.reject_inert:every_readout_codegen_and_opt_spelling_rejected" {
    var bad: i32 = 0;

    var i: usize = 0;
    for (i < args.RDO_N) {
        if (!t_rejects_alone(args.RDO[i].name::*u8)) { bad = 1; }
        i = i + 1;
    }
    i = 0;
    for (i < args.CGEN_N) {
        if (!t_rejects_alone(args.CGEN[i].name::*u8)) { bad = 1; }
        i = i + 1;
    }
    i = 0;
    for (i < args.OPT_N) {
        if (!t_rejects_alone(args.OPT[i].name::*u8)) { bad = 1; }
        i = i + 1;
    }

    ret bad;
}

test "mach.cli.cmd.run.reject_inert:run_selectors_and_runner_are_never_rejected" {
    var argv: [7]*u8;
    argv[0] = "mach"; argv[1] = "run"; argv[2] = "--target"; argv[3] = "linux-x86_64";
    argv[4] = "--profile"; argv[5] = "--runner"; argv[6] = "wine";
    var a: A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val ir: res[args.ParsedInvocation, outcome.Fail] = args.parse_invocation(?a, 7, ?argv[0]);
    if (sel ir.err) { ret 1; }
    val inv: args.ParsedInvocation = ir.ok;

    val reject_inert_r: opt[*u8] = reject_inert(7, ?argv[0], inv.marks);
    if (sel reject_inert_r.some) { ret 1; }
    ret 0;
}

test "mach.cli.cmd.run.reject_inert:subsystem_value_never_reclassified" {
    var argv: [4]*u8;
    argv[0] = "mach"; argv[1] = "run"; argv[2] = "--subsystem"; argv[3] = "console";
    var marks: [4]bool;
    var i: usize = 0;
    for (i < 4) { marks[i] = false; i = i + 1; }

    val r: opt[*u8] = reject_inert(4, ?argv[0], ?marks[0]);
    if (sel r.none) { ret 1; }
    if (!str_equals(r.some::str, "--subsystem")) { ret 2; }
    ret 0;
}

test "mach.cli.cmd.run.reject_inert:first_offending_token_in_input_order" {
    var argv: [6]*u8;
    argv[0] = "mach"; argv[1] = "run"; argv[2] = "."; argv[3] = "-g";
    argv[4] = "--pie"; argv[5] = "-v";
    var marks: [6]bool;
    var i: usize = 0;
    for (i < 6) { marks[i] = false; i = i + 1; }

    val r: opt[*u8] = reject_inert(6, ?argv[0], ?marks[0]);
    if (sel r.none) { ret 1; }
    if (!str_equals(r.some::str, "-g")) { ret 2; }
    ret 0;
}

test "mach.cli.cmd.run.reject_inert:post_separator_tokens_stay_opaque" {
    var argv: [5]*u8;
    argv[0] = "mach"; argv[1] = "run"; argv[2] = "."; argv[3] = "--"; argv[4] = "-v";
    val sep: usize = util.arg_separator_index(5, ?argv[0]);
    var marks: [5]bool;
    var i: usize = 0;
    for (i < 5) { marks[i] = false; i = i + 1; }

    val reject_inert_r: opt[*u8] = reject_inert(sep, ?argv[0], ?marks[0]);
    if (sel reject_inert_r.some) { ret 1; }
    ret 0;
}

test "mach.cli.cmd.run.run:rejects_every_inert_option_before_effects" {
    var bad: i32 = 0;

    var alone: [3]*u8;
    alone[0] = "mach"; alone[1] = "run"; alone[2] = "-g";
    if (t_run(3, ?alone[0]) != 1) { bad = 1; }

    var with_project: [4]*u8;
    with_project[0] = "mach"; with_project[1] = "run"; with_project[2] = "."; with_project[3] = "--emit-ir";
    if (t_run(4, ?with_project[0]) != 1) { bad = 1; }

    var subsystem_value: [4]*u8;
    subsystem_value[0] = "mach"; subsystem_value[1] = "run"; subsystem_value[2] = "--subsystem"; subsystem_value[3] = "console";
    if (t_run(4, ?subsystem_value[0]) != 1) { bad = 1; }

    var duplicate: [5]*u8;
    duplicate[0] = "mach"; duplicate[1] = "run"; duplicate[2] = "-v"; duplicate[3] = "."; duplicate[4] = "-vv";
    if (t_run(5, ?duplicate[0]) != 1) { bad = 1; }

    ret bad;
}

test "mach.cli.cmd.run.o_missing_value:distinguishes_absent_from_valueless" {
    var argv_absent: [2]*u8;
    argv_absent[0] = "mach"; argv_absent[1] = "run";
    if (o_missing_value(2, ?argv_absent[0], nil)) { ret 1; }

    var argv_present: [3]*u8;
    argv_present[0] = "mach"; argv_present[1] = "run"; argv_present[2] = "-o";
    if (!o_missing_value(3, ?argv_present[0], nil)) { ret 2; }

    var argv_valued: [4]*u8;
    argv_valued[0] = "mach"; argv_valued[1] = "run"; argv_valued[2] = "-o"; argv_valued[3] = "out/bin";
    if (o_missing_value(4, ?argv_valued[0], argv_valued[3])) { ret 3; }
    ret 0;
}

fun t_scratch_runnable(a: *A.Allocator, root_buf: *u8) bool {
    val tf_r: res[fs.TempFile, fs.FsError] = fs.temp_create(a, "mach_run_cmd_smoke");
    if (sel tf_r.err) { ret false; }
    var tf: fs.TempFile = tf_r.ok;
    val tp:   *u8   = fs.temp_path(?tf)::*u8;
    val tlen: usize = str_len(tp);
    val fits: bool  = tlen + 1 <= 4096;
    if (fits) {
        var j: usize = 0;
        for (j < tlen) { root_buf[j] = tp[j]; j = j + 1; }
        root_buf[tlen] = 0;
    }
    fs.temp_close_and_remove(?tf);
    if (!fits) { ret false; }

    val root: str = root_buf::str;
    var executable: str = "true";
    var basename: str = "runsmoke";
    $if ($mach.build.os == $mach.os.windows) { basename = "runsmoke.exe"; }
    val body_r: res[str, format.FormatError] = format.sprint(a, "[project]\nid = \"runsmoke\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out\"\n\n[profile.run]\ndefault = true\nopt = 0\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n\n[artifact.runsmoke]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/{}\"\ntargets = [\"*\"]\nlink = []\nneed = []\n", basename);
    if (sel body_r.err) { ret false; }
    val body: str = body_r.ok;
    fin { str_free(a, body); }
    val create_dir_all_r: err[fs.FsError] = fs.create_dir_all(a, root, 0o755);
    if (sel create_dir_all_r.err) { ret false; }
    val toml_path_r: res[path.Path, A.Error] = path.join(a, root, "mach.toml");
    if (sel toml_path_r.err) { ret false; }
    val toml_path: str = toml_path_r.ok;
    fin { str_free(a, toml_path); }
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(toml_path, body::*u8, str_len(body), 0o644);
    if (sel write_bytes_r.err) { ret false; }

    val bin_dir_r: res[path.Path, A.Error] = path.join(a, root, "out/bin");
    if (sel bin_dir_r.err) { ret false; }
    val bin_dir: str = bin_dir_r.ok;
    fin { str_free(a, bin_dir); }
    val create_dir_all_r2: err[fs.FsError] = fs.create_dir_all(a, bin_dir, 0o755);
    if (sel create_dir_all_r2.err) { ret false; }
    val bin_path_r: res[path.Path, A.Error] = path.join(a, bin_dir, basename);
    if (sel bin_path_r.err) { ret false; }
    val bin_path: str = bin_path_r.ok;
    fin { str_free(a, bin_path); }

    $if ($mach.build.os == $mach.os.windows) {
        val source_dir_r: res[path.Path, A.Error] = path.join(a, root, "src");
        if (sel source_dir_r.err) { ret false; }
        val source_dir: str = source_dir_r.ok;
        fin { str_free(a, source_dir); }
        val create_dir_all_r3: err[fs.FsError] = fs.create_dir_all(a, source_dir, 0o755);
        if (sel create_dir_all_r3.err) { ret false; }
        val source_path_r: res[path.Path, A.Error] = path.join(a, source_dir, "main.mach");
        if (sel source_path_r.err) { ret false; }
        val source_path: str = source_path_r.ok;
        fin { str_free(a, source_path); }
        val source: str = "#[symbol(\"mainCRTStartup\")]\nfun start() i32 { ret 0; }\n";
        val write_bytes_r2: err[fs.FsError] = fs.write_bytes(source_path, source, str_len(source), 0o644);
        if (sel write_bytes_r2.err) { ret false; }
        var av: [3]*u8;
        av[0] = "mach"; av[1] = "build"; av[2] = root::*u8;
        val inv_r: res[args.ParsedInvocation, outcome.Fail] = args.parse_invocation(a, 3, ?av[0]);
        if (sel inv_r.err) { ret false; }
        var inv: args.ParsedInvocation = inv_r.ok;
        fin { args.dnit_invocation(a, ?inv); }
        ret build.run_typed(?av[0], ?inv) == 0;
    }

    val program_r: res[str, exec.Error] = exec.resolve(a, executable);
    if (sel program_r.err) { ret false; }
    val program: str = program_r.ok;
    val res_bytes: res[Vector[u8], fs.FsError] = fs.read_bytes(a, program);
    str_free(a, program);
    if (sel res_bytes.err) { ret false; }
    var bytes: Vector[u8] = res_bytes.ok;
    val write_bytes_r3: err[fs.FsError] = fs.write_bytes(bin_path, bytes.data, bytes.len, 0o755);
    if (sel write_bytes_r3.err) { vector.dnit[u8](?bytes); ret false; }
    vector.dnit[u8](?bytes);
    ret true;
}

fun t_run_scratch(root: *u8) i64 {
    var av: [3]*u8;
    av[0] = "mach"; av[1] = "run"; av[2] = root;
    ret t_run(3, ?av[0]);
}

test "mach.cli.cmd.run.run:lib_is_not_a_run_option_but_the_same_project_alone_succeeds" {
    var a: A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    var root: [4096]u8;
    if (!t_scratch_runnable(?a, ?root[0])) { fs.remove_all(?a, ?root[0]); ret 1; }

    val rc_ok: i64 = t_run_scratch(?root[0]);
    if (rc_ok != 0) { fs.remove_all(?a, ?root[0]); ret 1; }

    var av_bad: [7]*u8;
    av_bad[0] = "mach"::*u8; av_bad[1] = "run"::*u8; av_bad[2] = ?root[0];
    av_bad[3] = "--bin"::*u8; av_bad[4] = "x"::*u8; av_bad[5] = "--lib"::*u8; av_bad[6] = "y"::*u8;
    val rc_bad: i64 = t_run(7, ?av_bad[0]);

    fs.remove_all(?a, ?root[0]);
    if (rc_bad != 1) { ret 1; }
    ret 0;
}

test "mach.cli.cmd.run.run:o_present_with_no_value_is_rejected_but_the_same_project_alone_succeeds" {
    var a: A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    var root: [4096]u8;
    if (!t_scratch_runnable(?a, ?root[0])) { fs.remove_all(?a, ?root[0]); ret 1; }

    val rc_ok: i64 = t_run_scratch(?root[0]);
    if (rc_ok != 0) { fs.remove_all(?a, ?root[0]); ret 1; }

    var av_bad: [4]*u8;
    av_bad[0] = "mach"::*u8; av_bad[1] = "run"::*u8; av_bad[2] = ?root[0]; av_bad[3] = "-o"::*u8;
    val rc_bad: i64 = t_run(4, ?av_bad[0]);

    fs.remove_all(?a, ?root[0]);
    if (rc_bad != 1) { ret 1; }
    ret 0;
}

test "mach.cli.cmd.run.run:rejects_a_library_only_selection_before_launch" {
    val body: str = "[project]\nid = \"runlibonly\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out\"\n\n[artifact.runlibonly]\nkind = \"static\"\nentry = \"src/lib.mach\"\nout = \"lib/runlibonly.a\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n";
    var a: A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }

    val tf_r: res[fs.TempFile, fs.FsError] = fs.temp_create(?a, "mach_run_cmd_lib");
    if (sel tf_r.err) { ret 1; }
    var tf: fs.TempFile = tf_r.ok;
    val root: str = fs.temp_path(?tf);
    fs.temp_close_and_remove(?tf);
    val create_dir_all_r: err[fs.FsError] = fs.create_dir_all(?a, root, 0o755);
    if (sel create_dir_all_r.err) { ret 1; }
    val toml_path_r: res[str, A.Error] = path.join(?a, root, "mach.toml");
    if (sel toml_path_r.err) { ret 1; }
    val toml_path: str = toml_path_r.ok;
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(toml_path, body::*u8, str_len(body), 0o644);
    if (sel write_bytes_r.err) { ret 1; }

    var argv: [3]*u8;
    argv[0] = "mach"; argv[1] = "run"; argv[2] = root::*u8;

    val rc: i64 = t_run(3, ?argv[0]);
    fs.remove_all(?a, root);
    if (rc != 1) { ret 1; }
    ret 0;
}

test "mach.cli.cmd.run.run:rejects_a_foreign_target_without_a_runner" {
    val body: str = "[project]\nid = \"runforeign\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out\"\n\n[target.windows]\nisa = \"x86_64\"\nos = \"windows\"\nabi = \"win64\"\n\n[artifact.runforeign]\nkind = \"bin\"\nentry = \"src/main.mach\"\nout = \"bin/runforeign.exe\"\ntargets = [\"windows\"]\nlink = []\nneed = []\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n";
    var a: A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }

    val tf_r: res[fs.TempFile, fs.FsError] = fs.temp_create(?a, "mach_run_cmd_foreign");
    if (sel tf_r.err) { ret 1; }
    var tf: fs.TempFile = tf_r.ok;
    val root: str = fs.temp_path(?tf);
    fs.temp_close_and_remove(?tf);
    val create_dir_all_r: err[fs.FsError] = fs.create_dir_all(?a, root, 0o755);
    if (sel create_dir_all_r.err) { ret 1; }
    val toml_path_r: res[str, A.Error] = path.join(?a, root, "mach.toml");
    if (sel toml_path_r.err) { ret 1; }
    val toml_path: str = toml_path_r.ok;
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(toml_path, body::*u8, str_len(body), 0o644);
    if (sel write_bytes_r.err) { ret 1; }

    val bin_dir_r: res[str, A.Error] = path.join(?a, root, "out/bin");
    if (sel bin_dir_r.err) { ret 1; }
    val bin_dir: str = bin_dir_r.ok;
    val create_dir_all_r2: err[fs.FsError] = fs.create_dir_all(?a, bin_dir, 0o755);
    if (sel create_dir_all_r2.err) { ret 1; }
    val bin_path_r: res[str, A.Error] = path.join(?a, bin_dir, "runforeign.exe");
    if (sel bin_path_r.err) { ret 1; }
    val bin_path: str = bin_path_r.ok;
    val write_bytes_r2: err[fs.FsError] = fs.write_bytes(bin_path, "MZ"::*u8, 2, 0o755);
    if (sel write_bytes_r2.err) { ret 1; }

    var argv: [5]*u8;
    argv[0] = "mach"; argv[1] = "run"; argv[2] = root::*u8; argv[3] = "--target"; argv[4] = "windows"::*u8;

    val rc: i64 = t_run(5, ?argv[0]);
    fs.remove_all(?a, root);
    if (rc != 1) { ret 1; }
    ret 0;
}

test "mach.cli.cmd.run.run:rejects_a_host_target_artifact_missing_execute_permission" {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    val body: str = "[project]\nid = \"runnoexec\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out\"\n\n[artifact.runnoexec]\nkind = \"bin\"\nentry = \"src/main.mach\"\nout = \"bin/runnoexec\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n";
    var a: A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }

    val tf_r: res[fs.TempFile, fs.FsError] = fs.temp_create(?a, "mach_run_cmd_noexec");
    if (sel tf_r.err) { ret 1; }
    var tf: fs.TempFile = tf_r.ok;
    val root: str = fs.temp_path(?tf);
    fs.temp_close_and_remove(?tf);
    val create_dir_all_r: err[fs.FsError] = fs.create_dir_all(?a, root, 0o755);
    if (sel create_dir_all_r.err) { ret 1; }
    val toml_path_r: res[str, A.Error] = path.join(?a, root, "mach.toml");
    if (sel toml_path_r.err) { ret 1; }
    val toml_path: str = toml_path_r.ok;
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(toml_path, body::*u8, str_len(body), 0o644);
    if (sel write_bytes_r.err) { ret 1; }

    val bin_dir_r: res[str, A.Error] = path.join(?a, root, "out/bin");
    if (sel bin_dir_r.err) { ret 1; }
    val bin_dir: str = bin_dir_r.ok;
    val create_dir_all_r2: err[fs.FsError] = fs.create_dir_all(?a, bin_dir, 0o755);
    if (sel create_dir_all_r2.err) { ret 1; }
    val bin_path_r: res[str, A.Error] = path.join(?a, bin_dir, "runnoexec");
    if (sel bin_path_r.err) { ret 1; }
    val bin_path: str = bin_path_r.ok;
    val write_bytes_r2: err[fs.FsError] = fs.write_bytes(bin_path, "not executable"::*u8, 14, 0o644);
    if (sel write_bytes_r2.err) { ret 1; }

    var argv: [3]*u8;
    argv[0] = "mach"; argv[1] = "run"; argv[2] = root::*u8;

    val rc: i64 = t_run(3, ?argv[0]);
    fs.remove_all(?a, root);
    if (rc != 1) { ret 1; }
    ret 0;
}

test "mach.cli.cmd.run.run:native_execution_rejects_mode_denial_and_malformed_images" {
    var a: A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    var root: [4096]u8;
    if (!t_scratch_runnable(?a, ?root[0])) { fs.remove_all(?a, ?root[0]); ret 1; }
    fin { fs.remove_all(?a, ?root[0]); }
    if (t_run_scratch(?root[0]) != 0) { ret 2; }

    var leaf: str = "out/bin/runsmoke";
    $if ($mach.build.os == $mach.os.windows) { leaf = "out/bin/runsmoke.exe"; }
    val filename_r: res[path.Path, A.Error] = path.join(?a, ?root[0], leaf);
    if (sel filename_r.err) { ret 3; }
    val filename: str = filename_r.ok;
    fin { str_free(?a, filename); }

    val image_r: res[Vector[u8], fs.FsError] = fs.read_bytes(?a, filename);
    if (sel image_r.err) { ret 4; }
    var image: Vector[u8] = image_r.ok;
    fin { vector.dnit[u8](?image); }
    $if ($mach.build.os != $mach.os.windows) {
        val remove_file_r: err[io_error.Error] = fs.remove_file(filename);
        if (sel remove_file_r.err) { ret 4; }
        val write_bytes_r: err[fs.FsError] = fs.write_bytes(filename, image.data, image.len, 0o644);
        if (sel write_bytes_r.err) { ret 4; }
        if (t_run_scratch(?root[0]) != 1) { ret 5; }
    }

    val remove_file_r2: err[io_error.Error] = fs.remove_file(filename);
    if (sel remove_file_r2.err) { ret 6; }
    val malformed: str = "not a native executable image\n";
    val write_bytes_r2: err[fs.FsError] = fs.write_bytes(filename, malformed, str_len(malformed), 0o755);
    if (sel write_bytes_r2.err) { ret 7; }
    var rejected: i64 = 127;
    $if ($mach.build.os == $mach.os.windows) { rejected = 1; }
    if (t_run_scratch(?root[0]) != rejected) { ret 8; }
    ret 0;
}
