# SEL rows run accepts: every row but `--all`, since run executes one artifact
val SEL_ACCEPTED: [args.SEL_N]bool = [args.SEL_N]bool{true, true, true, true, true, true, false, true};

# length of TABLES
val TABLES_N: usize = 3;
# the option tables mach run accepts: SEL masked by SEL_ACCEPTED, `--runner` and `--timeout`
val TABLES: [TABLES_N]args.TableRef = [TABLES_N]args.TableRef{
    args.TableRef{rows: ?args.SEL[0], n: args.SEL_N, accepted: ?SEL_ACCEPTED[0], docs: nil},
    args.TableRef{rows: ?args.RUNNERS[0], n: args.RUNNERS_N, accepted: nil, docs: nil},
    args.TableRef{rows: ?args.TIMEOUTS[0], n: args.TIMEOUTS_N, accepted: nil, docs: nil},
};

# length of REFUSED
val REFUSED_N: usize = 10;
# the build options run recognizes only to refuse, since it builds nothing
val REFUSED: [REFUSED_N]args.TableRef = [REFUSED_N]args.TableRef{
    args.TableRef{rows: ?args.VERBOSITY[0], n: args.VERBOSITY_N, accepted: nil, docs: nil},
    args.TableRef{rows: ?args.QUIETNESS[0], n: args.QUIETNESS_N, accepted: nil, docs: nil},
    args.TableRef{rows: ?args.CGEN[0], n: args.CGEN_N, accepted: nil, docs: nil},
    args.TableRef{rows: ?args.OPT[0], n: args.OPT_N, accepted: nil, docs: nil},
    args.TableRef{rows: ?args.EMITS[0], n: args.EMITS_N, accepted: nil, docs: nil},
    args.TableRef{rows: ?args.WORKERS[0], n: args.WORKERS_N, accepted: nil, docs: nil},
    args.TableRef{rows: ?args.LINKIN[0], n: args.LINKIN_N, accepted: nil, docs: nil},
    args.TableRef{rows: ?args.CACHE[0], n: args.CACHE_N, accepted: nil, docs: nil},
    args.TableRef{rows: ?args.DIAG[0], n: args.DIAG_N, accepted: nil, docs: nil},
    args.TableRef{rows: ?args.PLANS[0], n: args.PLANS_N, accepted: nil, docs: nil},
};

# length of CONSTRAINTS
val CONSTRAINTS_N: usize = 2;
# the constraint sentences help prints for run; the second is enforced by the run command
val CONSTRAINTS: [CONSTRAINTS_N]str = [CONSTRAINTS_N]str{
    args.SELECTOR_CONSTRAINT,
    "the selection must resolve to exactly one (artifact, target, profile)",
};

# length of EXITS
val EXITS_N: usize = 2;
# the exit codes run documents beside exit.SHARED
val EXITS: [EXITS_N]exit.Note = [EXITS_N]exit.Note{
    exit.Note{code: exit.PASSTHROUGH, meaning: "the program's own exit code, or 128 plus the signal number when a signal ended it"},
    exit.Note{code: exit.TIMEOUT, meaning: "the program exceeded --timeout and its process group was terminated"},
};

# `mach run`
pub val COMMAND: args.CommandSpec = args.CommandSpec{name: "run", aliases: nil, alias_n: 0, grammar: " <path> [options] [-- args...]", summary: "execute a built project artifact", effect: "resolve an existing built executable and run it without rebuilding", exits: ?EXITS[0], exit_n: EXITS_N, terminator: "arguments after -- are forwarded to the program", tables: ?TABLES[0], table_n: TABLES_N, refused: ?REFUSED[0], refused_n: REFUSED_N, refusal: "run executes an existing artifact", relations: nil, relation_n: 0, constraints: ?CONSTRAINTS[0], constraint_n: CONSTRAINTS_N, operand_min: 0, operand_max: args.OPERANDS_ANY, truncate_at_sep: true, actions: nil, action_n: 0, examples: nil, example_n: 0, run: run};

# `mach run`: execute the project's already-built binary, forwarding the arguments after
# `--` to it; `--runner <cmd>` executes
# `<cmd> <binary> <args>` instead, which is required when the target is not runnable on
# this host; `--timeout <duration>` runs the program in its own process group and
# terminates it after the duration
# ---
# cx:  the call
# ret: the program's exit code; 128 plus the signal number when it was killed by a signal;
#      exit.TIMEOUT when the timeout expired; otherwise mach's own failure: a user failure for a
#      usage error or an artifact that is missing or that the system refuses to execute (a
#      malformed image fails the spawn on windows), an environment failure for a wait, an
#      internal one out of memory
pub fun run(cx: *args.Call) res[i64, fail.Fail] {
    val inv:   *args.ParsedInvocation = cx.inv;
    val argv:  **u8                   = cx.argv;
    val alloc: *A.Allocator           = cx.a;
    val sep:   usize                  = inv.sep_idx;

    val timeout_given: opt[*u8]                 = args.value(inv, argv, ?args.TIMEOUT);
    var timeout:       chrono_duration.Duration = 0;
    var timeout_text:  str                      = "";
    if (sel timeout_given.some) {
        timeout_text = timeout_given.some::str;
        val tv: opt[chrono_duration.Duration] = duration.parse(timeout_given.some);
        if (sel tv.none) { ret refused(alloc, diagnostic_kind.CLI_FLAG_VALUE, std_format.sprint(alloc, "--timeout expects {}", duration.FORMS)); }
        timeout = tv.some;
    }
    var output:       *u8      = nil;
    val output_given: opt[*u8] = args.value(inv, argv, ?args.OUTPUT);
    if (sel output_given.some) { output = output_given.some; }

    val pix: usize = inv.positional_idx;
    var arg: *u8   = nil;
    if (inv.has_positional && pix < sep) { arg = argv[pix]; }

    val loc_r: res[util.ProjectLocation, fail.Fail] = util.resolve_project_location(alloc, arg);
    if (sel loc_r.err) { ret res[i64, fail.Fail].err{loc_r.err}; }
    val root: str = loc_r.ok.root;

    val selectors_r: res[manifest.Selectors, fail.Fail] = args.collect_selectors(alloc, inv, argv);
    if (sel selectors_r.err) { ret res[i64, fail.Fail].err{selectors_r.err}; }
    var selectors: manifest.Selectors = selectors_r.ok;

    val reg_made: res[*lang_target.TargetRegistry, fail.Fail] = toolchain.registry();
    if (sel reg_made.err) { ret res[i64, fail.Fail].err{reg_made.err}; }
    val reg:    *lang_target.TargetRegistry        = reg_made.ok;
    val res_ra: res[config.RunArtifact, fail.Fail] = driver.resolve_run_artifact(alloc, reg, root, ?selectors, output);
    if (sel res_ra.err) { ret res[i64, fail.Fail].err{args.selection_hint(alloc, ?selectors, res_ra.err)}; }
    val ra:          config.RunArtifact = res_ra.ok;
    val output_path: str                = ra.path;

    val is_file_r: res[bool, io_error.Error] = fs.is_file(output_path);
    if (!(sel is_file_r.ok && is_file_r.ok)) {
        ret refused(alloc, diagnostic_kind.ARTIFACT_NOT_BUILT, std_format.sprint(alloc, "no built artifact at '{}'; run `mach build` first", output_path));
    }

    var runner:       *u8      = nil;
    val runner_given: opt[*u8] = args.value(inv, argv, ?args.RUNNER);
    if (sel runner_given.some) {
        val name:       *u8                 = runner_given.some;
        val res_runner: res[*u8, fail.Fail] = host.program_resolve(alloc, name);
        if (sel res_runner.err) {
            val said: res[str, std_format.FormatError] = std_format.sprint(alloc, "--runner '{}': {}", name::str, fail.describe(res_runner.err));
            if (sel said.err) { ret res[i64, fail.Fail].err{fail.message("out of memory")}; }
            ret res[i64, fail.Fail].err{fail.with_text(res_runner.err, said.ok)};
        }
        runner = res_runner.ok;
    }
    or {
        if (!ra.host_runnable) {
            ret refused(alloc, diagnostic_kind.TARGET_NOT_RUNNABLE, std_format.sprint(alloc, "target '{}' is not runnable on this host; pass --runner", ra.target_name));
        }
        val executable_r: res[str, fail.Fail] = host.program_resolve(alloc, output_path);
        if (sel executable_r.err) {
            ret refused(alloc, diagnostic_kind.ARTIFACT_NOT_EXECUTABLE, std_format.sprint(alloc, "built artifact '{}' is not executable", output_path));
        }
        str_free(alloc, executable_r.ok);
    }

    var fwd_len: usize = 0;
    if (sep < inv.argc) { fwd_len = inv.argc - sep - 1; }

    var lead: usize = 0;
    if (runner != nil) { lead = 1; }

    val child_len:      usize              = lead + 1 + fwd_len + 1;
    val res_child_argv: res[**u8, A.Error] = A.allocate[*u8](alloc, child_len);
    if (sel res_child_argv.err) { ret res[i64, fail.Fail].err{fail.refused(res_child_argv.err)}; }
    val child_argv: **u8 = res_child_argv.ok;

    if (runner != nil) { child_argv[0] = runner; }
    child_argv[lead] = output_path;
    var i: usize = 0;
    for (i < fwd_len) {
        child_argv[lead + 1 + i] = argv[sep + 1 + i];
        i                        = i + 1;
    }
    child_argv[lead + 1 + fwd_len] = nil;

    var exe: *u8 = output_path;
    if (runner != nil) { exe = runner; }

    var child: subprocess.OwnedSubprocess;
    subprocess.init(?child);
    var options: subprocess.SpawnOptions = subprocess.spawn_options();
    options.grouped = timeout > 0;
    val res_spawn: err[subprocess.Error] = subprocess.spawn(alloc, ?child, exe::str, child_argv, inv.environ, options);
    if (sel res_spawn.err) {
        if (runner != nil) { ret res[i64, fail.Fail].err{fail.user(diagnostic_kind.PROCESS_SPAWN, "failed to execute the runner")}; }
        ret res[i64, fail.Fail].err{fail.user(diagnostic_kind.PROCESS_SPAWN, "failed to execute the built binary")};
    }

    var res_wait: res[subprocess.SubprocessTerminal, fail.Fail];
    if (timeout > 0) {
        subprocess.bound(?child, timeout);
        val wr: res[*subprocess.OwnedSubprocess, subprocess.Error] = subprocess.wait_any(alloc, ?child, 1, nil, nil);
        if (sel wr.err) {
            res_wait = res[subprocess.SubprocessTerminal, fail.Fail].err{fail.environment(diagnostic_kind.PROCESS_WAIT, subprocess.text(alloc, wr.err))};
        }
        if (sel wr.ok) { res_wait = res[subprocess.SubprocessTerminal, fail.Fail].ok{child.terminal}; }
    }
    or {
        val waited: res[subprocess.SubprocessTerminal, subprocess.Error] = subprocess.wait(alloc, ?child);
        if (sel waited.err) { res_wait = res[subprocess.SubprocessTerminal, fail.Fail].err{fail.environment(diagnostic_kind.PROCESS_WAIT, subprocess.text(alloc, waited.err))}; }
        if (sel waited.ok)  { res_wait = res[subprocess.SubprocessTerminal, fail.Fail].ok{waited.ok}; }
    }
    if (sel res_wait.err) {
        subprocess.cancel(alloc, ?child, 0);
        subprocess.dnit(alloc, ?child);
        val said: res[str, std_format.FormatError] = std_format.sprint(alloc, "failed to wait for the executed process: {}", fail.describe(res_wait.err));
        if (sel said.err) { ret res[i64, fail.Fail].err{res_wait.err}; }
        ret res[i64, fail.Fail].err{fail.with_text(res_wait.err, said.ok)};
    }
    val expired:  bool                          = subprocess.expired(?child);
    val terminal: subprocess.SubprocessTerminal = res_wait.ok;
    subprocess.dnit(alloc, ?child);

    if (expired) {
        val said: res[str, std_format.FormatError] = std_format.sprint(alloc, "the program exceeded --timeout {} and its process group was terminated", timeout_text);
        if (sel said.ok) { cli_diagnostic.report_fail(cx.report, fail.user(diagnostic_kind.PROCESS_TIMEOUT, said.ok), diagnostic.ORIGIN_NONE); }
        ret res[i64, fail.Fail].ok{exit.TIMEOUT};
    }
    if (terminal.kind == subprocess.STATE_EXITED)   { ret res[i64, fail.Fail].ok{terminal.code::i64}; }
    if (terminal.kind == subprocess.STATE_SIGNALED) { ret res[i64, fail.Fail].ok{128 + terminal.code::i64}; }
    ret res[i64, fail.Fail].err{fail.environment(diagnostic_kind.PROCESS_NO_STATUS, "the executed process ended without an exit status or a signal")};
}

# a user failure of kind k with the formatted text, or out of memory when it could not be formatted
fun refused(a: *A.Allocator, k: diagnostic_kind.Kind, said: res[str, std_format.FormatError]) res[i64, fail.Fail] {
    if (sel said.err) { ret res[i64, fail.Fail].err{fail.message("out of memory")}; }
    ret res[i64, fail.Fail].err{fail.user(k, said.ok)};
}

#[testing]
fun t_run(argc: usize, argv: **u8) i64 {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 2; }
    ret args.invoke(?a, ?COMMAND, argc, argv);
}

# the kind of the refusal reading argv as `mach run` records; NONE when there is none
#[testing]
fun t_run_refusal(argc: usize, argv: **u8) diagnostic_kind.Kind {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret diagnostic_kind.CLI_UNKNOWN_COMMAND; }
    val ir: res[args.ParsedInvocation, fail.Fail] = args.parse_command(?a, ?COMMAND, argc, argv);
    if (sel ir.err) { ret diagnostic_kind.CLI_UNKNOWN_COMMAND; }
    var inv: args.ParsedInvocation = ir.ok;
    fin { args.dnit_invocation(?a, ?inv); }
    if (sel inv.refusal.some) { ret fail.kind_of(inv.refusal.some); }
    ret diagnostic_kind.NONE;
}

# run's selectors and `--runner` are its own options, every build option is refused as
# inapplicable, `--all` is unknown, and nothing after `--` is read
test run__build_options_are_inapplicable_and_its_own_parse {
    var own: [9]*u8 = [9]*u8{"mach", "run", ".", "-t", "linux-x86_64", "-p", "debug", "--runner", "wine"};
    if (t_run_refusal(9, ?own[0]) != diagnostic_kind.NONE) { ret 1; }
    var build_only: [5]*u8 = [5]*u8{"mach", "run", ".", "--jobs", "4"};
    var spellings:  [6]str = [6]str{"--jobs", "-L", "--no-cache", "--emit", "-g", "--diagnostics=json"};
    var i:          usize  = 0;
    for (i < 6) {
        build_only[3] = spellings[i]::*u8;
        if (t_run_refusal(5, ?build_only[0]) != diagnostic_kind.CLI_FLAG_INAPPLICABLE) { ret 2 + i::i32; }
        i = i + 1;
    }
    var all: [4]*u8 = [4]*u8{"mach", "run", ".", "--all"};
    if (t_run_refusal(4, ?all[0]) != diagnostic_kind.CLI_FLAG_UNKNOWN) { ret 10; }
    var forwarded: [5]*u8 = [5]*u8{"mach", "run", ".", "--", "--emit"};
    if (t_run_refusal(5, ?forwarded[0]) != diagnostic_kind.NONE) { ret 11; }
    ret 0;
}

test run__rejects_every_inert_option_before_effects {
    var bad: i32 = 0;

    var alone: [3]*u8;
    alone[0] = "mach";
    alone[1] = "run";
    alone[2] = "-g";
    if (t_run(3, ?alone[0]) != 1) { bad = 1; }

    var with_project: [4]*u8;
    with_project[0] = "mach";
    with_project[1] = "run";
    with_project[2] = ".";
    with_project[3] = "--emit-ir";
    if (t_run(4, ?with_project[0]) != 1) { bad = 1; }

    var duplicate: [5]*u8;
    duplicate[0] = "mach";
    duplicate[1] = "run";
    duplicate[2] = "-v";
    duplicate[3] = ".";
    duplicate[4] = "-vv";
    if (t_run(5, ?duplicate[0]) != 1) { bad = 1; }

    ret bad;
}

#[testing]
fun t_scratch_runnable(a: *A.Allocator, root_buf: *u8) bool {
    val tf_r: res[fs.TempFile, fs.FsError] = fs.temp_create(a, "mach_run_cmd_smoke");
    if (sel tf_r.err) { ret false; }
    var tf:   fs.TempFile = tf_r.ok;
    val tp:   *u8         = fs.temp_path(?tf)::*u8;
    val tlen: usize       = str_len(tp);
    val fits: bool        = tlen + 1 <= 4096;
    if (fits) {
        var j: usize = 0;
        for (j < tlen) {
            root_buf[j] = tp[j];
            j           = j + 1;
        }
        root_buf[tlen] = 0;
    }
    fs.temp_close_and_remove(?tf);
    if (!fits) { ret false; }

    val root:       str = root_buf::str;
    var executable: str = "true";
    var basename:   str = "runsmoke";
    $if ($mach.build.os == $mach.os.windows) { basename = "runsmoke.exe"; }
    val body_r: res[str, std_format.FormatError] = std_format.sprint(a, "[project]\nmach = \">=5\"\nid = \"runsmoke\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out\"\n\n[profile.run]\ndefault = true\nopt = 0\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n\n[artifact.runsmoke]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"{{project.out}}/bin/{}\"\ntargets = [\"*\"]\nlink = []\nneed = []\n", basename);
    if (sel body_r.err) { ret false; }
    val body: str = body_r.ok;
    fin { str_free(a, body); }
    val create_dir_all_r: err[fs.FsError] = fs.create_dir_all(a, root, 0o755);
    if (sel create_dir_all_r.err) { ret false; }
    val toml_path_r: res[types_path.Path, A.Error] = types_path.join(a, root, "mach.toml");
    if (sel toml_path_r.err) { ret false; }
    val toml_path: str = toml_path_r.ok;
    fin { str_free(a, toml_path); }
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(toml_path, body::*u8, str_len(body), 0o644);
    if (sel write_bytes_r.err) { ret false; }

    val bin_dir_r: res[types_path.Path, A.Error] = types_path.join(a, root, "out/bin");
    if (sel bin_dir_r.err) { ret false; }
    val bin_dir: str = bin_dir_r.ok;
    fin { str_free(a, bin_dir); }
    val create_dir_all_r2: err[fs.FsError] = fs.create_dir_all(a, bin_dir, 0o755);
    if (sel create_dir_all_r2.err) { ret false; }
    val bin_path_r: res[types_path.Path, A.Error] = types_path.join(a, bin_dir, basename);
    if (sel bin_path_r.err) { ret false; }
    val bin_path: str = bin_path_r.ok;
    fin { str_free(a, bin_path); }

    $if ($mach.build.os == $mach.os.windows) {
        val source_dir_r: res[types_path.Path, A.Error] = types_path.join(a, root, "src");
        if (sel source_dir_r.err) { ret false; }
        val source_dir: str = source_dir_r.ok;
        fin { str_free(a, source_dir); }
        val create_dir_all_r3: err[fs.FsError] = fs.create_dir_all(a, source_dir, 0o755);
        if (sel create_dir_all_r3.err) { ret false; }
        val source_path_r: res[types_path.Path, A.Error] = types_path.join(a, source_dir, "main.mach");
        if (sel source_path_r.err) { ret false; }
        val source_path: str = source_path_r.ok;
        fin { str_free(a, source_path); }
        val source:         str             = "#[symbol(\"mainCRTStartup\")]\nfun start() i32 { ret 0; }\n";
        val write_bytes_r2: err[fs.FsError] = fs.write_bytes(source_path, source, str_len(source), 0o644);
        if (sel write_bytes_r2.err) { ret false; }
        var av: [3]*u8;
        av[0] = "mach";
        av[1] = "build";
        av[2] = root::*u8;
        ret args.invoke(a, ?build.COMMAND, 3, ?av[0]) == 0;
    }

    val program_r: res[str, fail.Fail] = host.program_resolve(a, executable);
    if (sel program_r.err) { ret false; }
    val program:   str                         = program_r.ok;
    val res_bytes: res[Vector[u8], fs.FsError] = fs.read_bytes(a, program);
    str_free(a, program);
    if (sel res_bytes.err) { ret false; }
    var bytes:          Vector[u8]      = res_bytes.ok;
    val write_bytes_r3: err[fs.FsError] = fs.write_bytes(bin_path, bytes.data, bytes.len, 0o755);
    if (sel write_bytes_r3.err) {
        collections_vector.dnit[u8](?bytes);
        ret false;
    }
    collections_vector.dnit[u8](?bytes);
    ret true;
}

#[testing]
fun t_run_scratch(root: *u8) i64 {
    var av: [3]*u8;
    av[0] = "mach";
    av[1] = "run";
    av[2] = root;
    ret t_run(3, ?av[0]);
}

test run__o_with_no_value_is_rejected_where_the_same_project_runs {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    var root: [4096]u8;
    if (!t_scratch_runnable(?a, ?root[0])) {
        fs.remove_all(?a, ?root[0]);
        ret 1;
    }

    val rc_ok: i64 = t_run_scratch(?root[0]);
    if (rc_ok != 0) {
        fs.remove_all(?a, ?root[0]);
        ret 1;
    }

    var av_bad: [4]*u8;
    av_bad[0] = "mach"::*u8;
    av_bad[1] = "run"::*u8;
    av_bad[2] = ?root[0];
    av_bad[3] = "-o"::*u8;
    val rc_bad: i64 = t_run(4, ?av_bad[0]);

    fs.remove_all(?a, ?root[0]);
    if (rc_bad != 1) { ret 1; }
    ret 0;
}

test run__rejects_a_library_only_selection_before_launch {
    val body:   str          = "[project]\nmach = \">=5\"\nid = \"runlibonly\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out\"\n\n[artifact.runlibonly]\nkind = \"static\"\nentry = \"src/lib.mach\"\nout = \"{project.out}/lib/runlibonly.a\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n";
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }

    val tf_r: res[fs.TempFile, fs.FsError] = fs.temp_create(?a, "mach_run_cmd_lib");
    if (sel tf_r.err) { ret 1; }
    var tf:   fs.TempFile = tf_r.ok;
    val root: str         = fs.temp_path(?tf);
    fs.temp_close_and_remove(?tf);
    val create_dir_all_r: err[fs.FsError] = fs.create_dir_all(?a, root, 0o755);
    if (sel create_dir_all_r.err) { ret 1; }
    val toml_path_r: res[str, A.Error] = types_path.join(?a, root, "mach.toml");
    if (sel toml_path_r.err) { ret 1; }
    val toml_path:     str             = toml_path_r.ok;
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(toml_path, body::*u8, str_len(body), 0o644);
    if (sel write_bytes_r.err) { ret 1; }

    var argv: [3]*u8;
    argv[0] = "mach";
    argv[1] = "run";
    argv[2] = root::*u8;

    val rc: i64 = t_run(3, ?argv[0]);
    fs.remove_all(?a, root);
    if (rc != 1) { ret 1; }
    ret 0;
}

test run__rejects_a_foreign_target_without_a_runner {
    val body:   str          = "[project]\nmach = \">=5\"\nid = \"runforeign\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out\"\n\n[target.windows]\nisa = \"x86_64\"\nos = \"windows\"\nabi = \"win64\"\n\n[artifact.runforeign]\nkind = \"bin\"\nentry = \"src/main.mach\"\nout = \"{project.out}/bin/runforeign.exe\"\ntargets = [\"windows\"]\nlink = []\nneed = []\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n";
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }

    val tf_r: res[fs.TempFile, fs.FsError] = fs.temp_create(?a, "mach_run_cmd_foreign");
    if (sel tf_r.err) { ret 1; }
    var tf:   fs.TempFile = tf_r.ok;
    val root: str         = fs.temp_path(?tf);
    fs.temp_close_and_remove(?tf);
    val create_dir_all_r: err[fs.FsError] = fs.create_dir_all(?a, root, 0o755);
    if (sel create_dir_all_r.err) { ret 1; }
    val toml_path_r: res[str, A.Error] = types_path.join(?a, root, "mach.toml");
    if (sel toml_path_r.err) { ret 1; }
    val toml_path:     str             = toml_path_r.ok;
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(toml_path, body::*u8, str_len(body), 0o644);
    if (sel write_bytes_r.err) { ret 1; }

    val bin_dir_r: res[str, A.Error] = types_path.join(?a, root, "out/bin");
    if (sel bin_dir_r.err) { ret 1; }
    val bin_dir:           str             = bin_dir_r.ok;
    val create_dir_all_r2: err[fs.FsError] = fs.create_dir_all(?a, bin_dir, 0o755);
    if (sel create_dir_all_r2.err) { ret 1; }
    val bin_path_r: res[str, A.Error] = types_path.join(?a, bin_dir, "runforeign.exe");
    if (sel bin_path_r.err) { ret 1; }
    val bin_path:       str             = bin_path_r.ok;
    val write_bytes_r2: err[fs.FsError] = fs.write_bytes(bin_path, "MZ"::*u8, 2, 0o755);
    if (sel write_bytes_r2.err) { ret 1; }

    var argv: [5]*u8;
    argv[0] = "mach";
    argv[1] = "run";
    argv[2] = root::*u8;
    argv[3] = "-t";
    argv[4] = "windows"::*u8;

    val rc: i64 = t_run(5, ?argv[0]);
    fs.remove_all(?a, root);
    if (rc != 1) { ret 1; }
    ret 0;
}

test run__native_execution_runs_and_rejects_mode_denial_and_malformed_images {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    var root: [4096]u8;
    if (!t_scratch_runnable(?a, ?root[0])) {
        fs.remove_all(?a, ?root[0]);
        ret 1;
    }
    fin { fs.remove_all(?a, ?root[0]); }
    if (t_run_scratch(?root[0]) != 0) { ret 2; }

    var leaf: str = "out/bin/runsmoke";
    $if ($mach.build.os == $mach.os.windows) { leaf = "out/bin/runsmoke.exe"; }
    val filename_r: res[types_path.Path, A.Error] = types_path.join(?a, ?root[0], leaf);
    if (sel filename_r.err) { ret 3; }
    val filename: str = filename_r.ok;
    fin { str_free(?a, filename); }

    val image_r: res[Vector[u8], fs.FsError] = fs.read_bytes(?a, filename);
    if (sel image_r.err) { ret 4; }
    var image: Vector[u8] = image_r.ok;
    fin { collections_vector.dnit[u8](?image); }
    $if ($mach.build.os != $mach.os.windows) {
        val remove_file_r: err[io_error.Error] = fs.remove_file(filename);
        if (sel remove_file_r.err) { ret 4; }
        val write_bytes_r: err[fs.FsError] = fs.write_bytes(filename, image.data, image.len, 0o644);
        if (sel write_bytes_r.err)        { ret 4; }
        if (t_run_scratch(?root[0]) != 1) { ret 5; }
    }

    val remove_file_r2: err[io_error.Error] = fs.remove_file(filename);
    if (sel remove_file_r2.err) { ret 6; }
    val malformed:      str             = "not a native executable image\n";
    val write_bytes_r2: err[fs.FsError] = fs.write_bytes(filename, malformed, str_len(malformed), 0o755);
    if (sel write_bytes_r2.err) { ret 7; }
    var rejected: i64 = 127;
    $if ($mach.build.os == $mach.os.windows) { rejected = 1; }
    if (t_run_scratch(?root[0]) != rejected) { ret 8; }
    ret 0;
}
