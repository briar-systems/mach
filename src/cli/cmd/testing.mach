use std.allocator.arena;
use std.allocator.page;
use std.print;
use std.process.env;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.path;
use std.types.string.str_contains;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.text.string.str_dup;
use std.text.string.str_free;

use A:   std.allocator;
use O:   std.types.option;
use R:   std.types.result;
use fmt: std.format;
use fs:  std.filesystem;
use sys: std.system.os;
use std.io.writer;
use tm:  std.chrono.time;
use du:  std.chrono.duration;

use mach.cli.cmd.build;
use mach.cli.util;
use mach.cli.args;
use cli_diag: mach.cli.diagnostic;
use std.data.json;
use mach.lang.build.engine;
use mach.lang.build.plan;
use mach.lang.build.outcome;
use mach.lang.build.request;
use btest: mach.lang.build.testing;
use mach.lang.session;
use mach.lang.validation;
use mach.subprocess;
use cnc: std.sync.cancel;
use std.process.events;

val SCHEMA_VERSION: i64 = 1;

val CAP_OUTPUT: usize = 65536;

rec Outcome {
    art:       *outcome.TestArtifact;
    done:      bool;
    result:    validation.ValidationGateResult;
    code:      i32;
    elapsed:   du.Duration;
    out:       *u8;
    out_len:   usize;
    truncated: bool;
    bound:     i64;
}

# `mach test`: build the project's test dispatcher and run the collected tests. `-O1` and
# `--emit` are refused; `--list` prints the collected tests and stops; `--format json`
# writes the machine-readable event stream; `--filter`, `--runner`, `--timeout_seconds`,
# and `--jobs` shape the run
# ---
# argv: the full process arguments
# inv: the parsed invocation for this command
# ret: 0 every test passed, 1 a usage error, a build user error, or at least one failed
#  test, 2 an internal or infrastructure failure or out of memory, 3 an environment
#  failure during the build
pub fun run_typed(argv: **u8, inv: *args.ParsedInvocation) i64 {
    val cmd: args.CommandId = args.CMD_TEST;

    if (util.flag_exists(inv.argc, argv, "--emit")) {
        print.eprint("error: --emit is not applicable to 'test'; test always builds its internal test dispatcher\n");
        ret 1;
    }

    val res_cfg: R.Result[args.CliArgs, str] = args.build_cli_invocation(cmd, inv, argv);
    if (R.is_err[args.CliArgs, str](res_cfg)) {
        print.eprint("error: ");
        print.eprint(R.unwrap_err[args.CliArgs, str](res_cfg));
        print.eprint("\n");
        ret 1;
    }
    var config: args.CliArgs = R.unwrap_ok[args.CliArgs, str](res_cfg);

    val list:       bool          = args.invocation_flag(cmd, inv, "--list");
    val opt_format: O.Option[*u8] = args.invocation_value(cmd, inv, argv, "--format");
    val opt_filter: O.Option[*u8] = args.invocation_value(cmd, inv, argv, "--filter");
    val opt_runner: O.Option[*u8] = args.invocation_value(cmd, inv, argv, "--runner");
    val opt_timeout: O.Option[*u8] = args.invocation_value(cmd, inv, argv, "--timeout_seconds");
    if (args.reject_unknown_from_invocation(inv, argv, "mach test")) { ret 1; }

    val level: u8 = config.verbosity;

    var json_out: bool = false;
    if (O.is_some[*u8](opt_format)) {
        val fv: str = O.unwrap[*u8](opt_format)::str;
        if (str_equals(fv, "json"))  { json_out = true; }
        or (str_equals(fv, "human")) { json_out = false; }
        or {
            print.eprint("error: --format expects 'human' or 'json'\n");
            ret 1;
        }
    }

    var timeout_seconds: i64 = 0;
    if (O.is_some[*u8](opt_timeout)) {
        val tv: i64 = parse_count(O.unwrap[*u8](opt_timeout));
        if (tv < 1) {
            print.eprint("error: --timeout_seconds expects a positive integer number of seconds\n");
            ret 1;
        }
        timeout_seconds = tv;
    }

    var jobs: u32 = 1;
    if (config.jobs != nil) {
        val jv: i64 = parse_count(config.jobs);
        if (jv < 1) {
            print.eprint("error: --jobs expects a positive integer\n");
            ret 1;
        }
        jobs = jv::u32;
    }
    or {
        val nc: i64 = sys.cpu_count();
        if (nc > 1) { jobs = nc::u32; }
    }

    var backing: A.Allocator;
    if (O.is_some[str](page.make(?backing))) {
        print.eprint("error: failed to initialise allocator\n");
        ret 2;
    }
    var ar: arena.Arena;
    if (O.is_some[str](arena.init(?ar, ?backing, 0))) {
        print.eprint("error: failed to initialise allocator\n");
        ret 2;
    }
    var a: A.Allocator;
    if (O.is_some[str](arena.make(?a, ?ar))) {
        arena.dnit(?ar);
        print.eprint("error: failed to initialise allocator\n");
        ret 2;
    }

    var root_arg: *u8 = nil;
    if (inv.has_positional) { root_arg = argv[inv.positional_idx]; }

    val loc_r: R.Result[util.ProjectLocation, str] = util.resolve_project_location(?a, root_arg);
    if (R.is_err[util.ProjectLocation, str](loc_r)) {
        print.eprint("error: ");
        print.eprint(R.unwrap_err[util.ProjectLocation, str](loc_r));
        print.eprint("\n");
        arena.dnit(?ar);
        ret 1;
    }
    val loc: util.ProjectLocation = R.unwrap_ok[util.ProjectLocation, str](loc_r);
    val root: str = loc.root;

    val col_r: R.Result[R.Void, str] = args.collect_link_inputs(?a, ?config, cmd, inv, argv);
    if (R.is_err[R.Void, str](col_r)) {
        print.eprint("error: ");
        print.eprint(R.unwrap_err[R.Void, str](col_r));
        print.eprint("\n");
        arena.dnit(?ar);
        ret 2;
    }

    var goal: request.BuildGoal = request.GOAL_TESTS;
    if (list) { goal = request.GOAL_TEST_LIST; }

    var ps: session.Session;
    val plan_r: R.Result[plan.BuildPlan, outcome.Fail] = build.plan_invocation(?a, root, ?config, goal, ?ps);
    if (R.is_err[plan.BuildPlan, outcome.Fail](plan_r)) {
        var pf: outcome.Fail = R.unwrap_err[plan.BuildPlan, outcome.Fail](plan_r);
        val pc: i64 = cli_diag.render_fail(?pf);
        arena.dnit(?ar);
        ret pc;
    }
    val bp: plan.BuildPlan = R.unwrap_ok[plan.BuildPlan, outcome.Fail](plan_r);

    val ex_r: R.Result[outcome.BuildOutcome, outcome.Fail] = engine.execute(?bp, ?backing, ?a, nil);
    session.dnit(?ps);
    if (R.is_err[outcome.BuildOutcome, outcome.Fail](ex_r)) {
        var xf: outcome.Fail = R.unwrap_err[outcome.BuildOutcome, outcome.Fail](ex_r);
        val xc: i64 = cli_diag.render_fail(?xf);
        arena.dnit(?ar);
        ret xc;
    }
    var bo: outcome.BuildOutcome = R.unwrap_ok[outcome.BuildOutcome, outcome.Fail](ex_r);
    cli_diag.render_outcome(?bo, config.quiet);
    if (bo.severity != outcome.BUILD_OK) {
        val bc: i64 = cli_diag.outcome_code(?bo);
        arena.dnit(?ar);
        ret bc;
    }
    val built_tests: *outcome.TestArtifact = bo.tests.data;
    val built_len:   u32                   = bo.tests.len::u32;

    if (bo.tests_skipped > 0) { report_skipped(bo.tests_skipped); }

    var filter: *u8 = nil;
    if (O.is_some[*u8](opt_filter)) { filter = O.unwrap[*u8](opt_filter); }

    if (list) {
        var lw: writer.Writer;
        if (json_out) { lw = fs.writer(fs.STDOUT); }
        var i: u32 = 0;
        for (i < built_len) {
            if (filter_matches(?built_tests[i], filter)) {
                if (json_out) { emit_list_case(?lw, ?built_tests[i]); }
                or {
                    artifact_report(?built_tests[i]);
                    print.print("\n");
                }
            }
            i = i + 1;
        }
        arena.dnit(?ar);
        ret 0;
    }

    var selected: *outcome.TestArtifact = nil;
    var sel_len:  u32 = 0;
    if (built_len > 0) {
        val res_sel: R.Result[*outcome.TestArtifact, str] = A.allocate[outcome.TestArtifact](?a, built_len::usize);
        if (R.is_err[*outcome.TestArtifact, str](res_sel)) {
            arena.dnit(?ar);
            print.eprint("error: out of memory\n");
            ret 2;
        }
        selected = R.unwrap_ok[*outcome.TestArtifact, str](res_sel);
        var i: u32 = 0;
        for (i < built_len) {
            if (filter_matches(?built_tests[i], filter)) {
                selected[sel_len] = built_tests[i];
                sel_len = sel_len + 1;
            }
            i = i + 1;
        }
    }

    var runner: *u8 = nil;
    if (O.is_some[*u8](opt_runner)) {
        val name: *u8 = O.unwrap[*u8](opt_runner);
        val res_resolve: R.Result[*u8, str] = util.resolve_cmd(?a, name);
        if (R.is_err[*u8, str](res_resolve)) {
            arena.dnit(?ar);
            print.eprint("error: --runner '");
            print.eprint(name::str);
            print.eprint("': ");
            print.eprint(R.unwrap_err[*u8, str](res_resolve));
            print.eprint("\n");
            ret 2;
        }
        runner = R.unwrap_ok[*u8, str](res_resolve);
    }

    if (sel_len == 0) {
        var empty_tally: outcome.GateTally = outcome.gate_tally_init(?a);
        if (json_out) {
            var jc: JsonCtx;
            json_ctx_init(?jc, ?a, nil);
            json_start(?jc, nil, 0);
            json_summary(?jc, nil, 0, 0, 0, 0, ?empty_tally);
        }
        or { print.print("0 passed, 0 failed, 0 total  (0ms)\n"); }
        arena.dnit(?ar);
        ret 0;
    }

    val res_out: R.Result[*Outcome, str] = A.allocate[Outcome](?a, sel_len::usize);
    if (R.is_err[*Outcome, str](res_out)) {
        arena.dnit(?ar);
        print.eprint("error: out of memory\n");
        ret 2;
    }
    val outcomes: *Outcome = R.unwrap_ok[*Outcome, str](res_out);

    val ld_r: R.Result[str, str] = capture_log_dir(?a, selected[0].exe);
    if (R.is_err[str, str](ld_r)) {
        arena.dnit(?ar);
        print.eprint("error: could not derive the test log directory\n");
        ret 2;
    }
    val log_dir: str = R.unwrap_ok[str, str](ld_r);
    wipe_logs(?a, log_dir, built_len);

    var code: i64 = 0;
    if (json_out) {
        var jc: JsonCtx;
        json_ctx_init(?jc, ?a, log_dir);
        code = execute_rendered[JsonCtx](?a, selected, sel_len, runner, outcomes, level, jobs,
                                         log_dir, false, timeout_seconds, ?jc, json_start, json_test,
                                         json_summary);
    }
    or {
        var hc: HumanCtx;
        val mod_w:   usize = module_col_width(selected, sel_len);
        val label_w: usize = label_col_width(selected, sel_len);
        human_ctx_init(?a, ?hc, level, mod_w, label_w, runner, log_dir);
        code = execute_rendered[HumanCtx](?a, selected, sel_len, runner, outcomes, level, jobs,
                                          log_dir, true, timeout_seconds, ?hc, human_start, human_test,
                                          human_summary);
    }
    arena.dnit(?ar);
    ret code;
}

fun exit_code(failed: u32, tally: *outcome.GateTally) i64 {
    if (tally.infrastructure_failure > 0) { ret 2; }
    if (failed > 0)                       { ret 1; }
    ret 0;
}

fun count_timed_out(outcomes: *Outcome, len: u32) u32 {
    var t: u32 = 0;
    var i: u32 = 0;
    for (i < len) {
        if (outcomes[i].result.kind == validation.RESULT_RESOURCE_EXHAUSTION
            && outcomes[i].result.cause == validation.CAUSE_ORACLE_TIMEOUT) { t = t + 1; }
        i = i + 1;
    }
    ret t;
}

fun build_gate_tally(gt: *outcome.GateTally, a: *A.Allocator, outcomes: *Outcome, n: u32) {
    var i: u32 = 0;
    for (i < n) {
        outcome.record_gate(gt, a, outcomes[i].result);
        i = i + 1;
    }
}

fun execute_rendered[T](a: *A.Allocator, arts: *outcome.TestArtifact, n: u32, runner: *u8,
                        outcomes: *Outcome, level: u8, jobs: u32, log_dir: *u8,
                        want_bytes: bool, timeout_seconds: i64, ctx: *T,
                        fn_start: fun(*T, *outcome.TestArtifact, u32),
                        fn_test: fun(*T, *Outcome, *outcome.TestArtifact, u32),
                        fn_summary: fun(*T, *Outcome, u32, u32, u32, du.Duration,
                                        *outcome.GateTally)) i64 {
    val run_start: tm.Time = tm.monotonic();
    fn_start(ctx, arts, n);
    execute_and_render[T](a, arts, n, runner, outcomes, level, jobs, log_dir, want_bytes,
                          timeout_seconds, ctx, fn_test);
    val wall: du.Duration = tm.time_sub(tm.monotonic(), run_start);

    val failed: u32 = count_failed(outcomes, n);
    val passed: u32 = n - failed;
    var tally: outcome.GateTally = outcome.gate_tally_init(a);
    build_gate_tally(?tally, a, outcomes, n);
    fn_summary(ctx, outcomes, n, passed, failed, wall, ?tally);
    ret exit_code(failed, ?tally);
}

rec Slot {
    active: bool;
    art:   *outcome.TestArtifact;
    idx:   u32;
    start: tm.Time;
}

fun execute_and_render[T](a: *A.Allocator, arts: *outcome.TestArtifact, n: u32, runner: *u8,
                          outcomes: *Outcome, level: u8, jobs: u32, log_dir: *u8,
                          want_bytes: bool, timeout_seconds: i64, ctx: *T,
                          fn_test: fun(*T, *Outcome, *outcome.TestArtifact, u32)) {
    var i: u32 = 0;
    for (i < n) { outcomes[i].done = false; i = i + 1; }

    var window: u32 = jobs;
    if (window < 1) { window = 1; }
    if (window > n) { window = n; }

    val res_processes: R.Result[*subprocess.OwnedSubprocess, str] =
        A.allocate[subprocess.OwnedSubprocess](a, n::usize);
    val res_slots: R.Result[*Slot, str] = A.allocate[Slot](a, window::usize);
    if (R.is_err[*subprocess.OwnedSubprocess, str](res_processes)
        || R.is_err[*Slot, str](res_slots)) {
        print.eprint("error: out of memory\n");
        i = 0;
        for (i < n) {
            outcomes[i].art       = ?arts[i];
            outcomes[i].done      = true;
            outcomes[i].result    = btest.classify_setup_failure();
            outcomes[i].code      = 0;
            outcomes[i].elapsed   = 0;
            outcomes[i].out       = nil;
            outcomes[i].out_len   = 0;
            outcomes[i].truncated = false;
            outcomes[i].bound     = 0;
            i = i + 1;
        }
        i = 0;
        for (i < n) { fn_test(ctx, outcomes, arts, i); i = i + 1; }
        ret;
    }
    val processes: *subprocess.OwnedSubprocess =
        R.unwrap_ok[*subprocess.OwnedSubprocess, str](res_processes);
    val slots: *Slot = R.unwrap_ok[*Slot, str](res_slots);
    i = 0;
    for (i < n) { subprocess.init(?processes[i]); i = i + 1; }
    i = 0;
    for (i < window) { slots[i].active = false; i = i + 1; }

    var scope: cnc.Scope;
    cnc.make_root(?scope, false, tm.Time{sec: 0, nsec: 0});
    var source: events.Source;
    var has_source: bool = events.make(?source) == 0;
    var interrupt_source: *events.Source = nil;
    if (has_source) { interrupt_source = ?source; }

    var spawned:  u32 = 0;
    var done:     u32 = 0;
    var inflight: u32 = 0;

    for (done < n) {
        for (inflight < window && spawned < n) {
            val idx: u32 = spawned;
            spawned = spawned + 1;
            val spawn_fail: O.Option[validation.ValidationGateResult] =
                spawn_one(a, processes, slots, window, ?arts[idx], idx, runner, log_dir,
                          timeout_seconds);
            if (O.is_none[validation.ValidationGateResult](spawn_fail)) {
                inflight = inflight + 1;
            }
            or {
                outcomes[idx].art       = ?arts[idx];
                outcomes[idx].done      = true;
                outcomes[idx].result    = O.unwrap[validation.ValidationGateResult](spawn_fail);
                outcomes[idx].code      = 0;
                outcomes[idx].elapsed   = 0;
                outcomes[idx].out       = nil;
                outcomes[idx].out_len   = 0;
                outcomes[idx].truncated = false;
                outcomes[idx].bound     = 0;
                done = done + 1;
                fn_test(ctx, outcomes, arts, idx);
            }
        }

        if (inflight > 0) {
            val wr: R.Result[*subprocess.OwnedSubprocess, str] =
                subprocess.wait_any(a, processes, n, ?scope, interrupt_source);
            if (R.is_err[*subprocess.OwnedSubprocess, str](wr)) {
                print.eprint("error: waiting for test children failed\n");
                var sx: u32 = 0;
                for (sx < window) {
                    if (slots[sx].active) {
                        val eidx: u32 = slots[sx].idx;
                        var cleaned: bool = false;
                        val one: R.Result[subprocess.SubprocessTerminal, str] =
                            subprocess.wait(a, ?processes[eidx]);
                        if (R.is_ok[subprocess.SubprocessTerminal, str](one)) { cleaned = true; }
                        or {
                            val canceled: R.Result[subprocess.SubprocessTerminal, str] =
                                subprocess.cancel(a, ?processes[eidx], 0);
                            if (R.is_ok[subprocess.SubprocessTerminal, str](canceled)) { cleaned = true; }
                        }
                        if (cleaned) {
                            finalize_slot(a, ?processes[eidx], ?slots[sx], outcomes,
                                          level, want_bytes, log_dir);
                        }
                        or {
                            subprocess.abandon_capture(?processes[eidx]);
                            subprocess.dnit(a, ?processes[eidx]);
                            outcomes[eidx].art       = slots[sx].art;
                            outcomes[eidx].done      = true;
                            outcomes[eidx].result    = btest.classify_wait_failure();
                            outcomes[eidx].code      = 0;
                            outcomes[eidx].elapsed   = 0;
                            outcomes[eidx].out       = nil;
                            outcomes[eidx].out_len   = 0;
                            outcomes[eidx].truncated = false;
                            outcomes[eidx].bound     = 0;
                        }
                        slots[sx].active = false;
                        inflight = inflight - 1;
                        done = done + 1;
                        fn_test(ctx, outcomes, arts, eidx);
                    }
                    sx = sx + 1;
                }
            }
            or {
                val reaped: *subprocess.OwnedSubprocess =
                    R.unwrap_ok[*subprocess.OwnedSubprocess, str](wr);
                var sx: u32 = 0;
                for (sx < window) {
                    if (slots[sx].active) {
                        val fidx: u32 = slots[sx].idx;
                        if (?processes[fidx] == reaped) {
                            finalize_slot(a, ?processes[fidx], ?slots[sx], outcomes,
                                          level, want_bytes, log_dir);
                            slots[sx].active = false;
                            inflight = inflight - 1;
                            done = done + 1;
                            fn_test(ctx, outcomes, arts, fidx);
                            brk;
                        }
                    }
                    sx = sx + 1;
                }
            }
        }
    }

    if (has_source) { events.close(?source); }
    cnc.destroy(?scope);
}

rec HumanCtx {
    a:       *A.Allocator;
    level:   u8;
    mod_w:   usize;
    label_w: usize;
    runner:  *u8;
    log_dir: *u8;
    n:       u32;
    cursor:  u32;
    first:   u32;
}

rec JsonCtx {
    a:       *A.Allocator;
    log_dir: *u8;
    n:       u32;
    w:       writer.Writer;
}

fun human_ctx_init(a: *A.Allocator, hc: *HumanCtx, level: u8, mod_w: usize, label_w: usize,
                   runner: *u8, log_dir: *u8) {
    hc.a       = a;
    hc.level   = level;
    hc.mod_w   = mod_w;
    hc.label_w = label_w;
    hc.runner  = runner;
    hc.log_dir = log_dir;
    hc.n       = 0;
    hc.cursor  = 0;
    hc.first   = 0;
}

fun human_start(hc: *HumanCtx, arts: *outcome.TestArtifact, n: u32) {
    hc.n      = n;
    hc.cursor = 0;
    hc.first  = 0;
}

fun human_test(hc: *HumanCtx, outcomes: *Outcome, arts: *outcome.TestArtifact, idx: u32) {
    for (hc.cursor < hc.n && outcomes[hc.cursor].done) {
        val c: u32 = hc.cursor;
        val mod_name: str = arts[c].module;
        if (hc.level > 0 && c == hc.first) { print.printf("{}\n", mod_name); }
        if (hc.level > 0) { print_verbose_test(hc.a, ?outcomes[c], hc.label_w, hc.runner, hc.log_dir); }
        val last_of_module: bool = c + 1 == hc.n
            || !str_equals(arts[c + 1].module, mod_name);
        if (last_of_module) {
            if (hc.level == 0) { render_module_run(hc.a, outcomes, hc.first, c, mod_name, hc.mod_w, hc.runner, hc.log_dir); }
            hc.first = c + 1;
        }
        hc.cursor = c + 1;
    }
}

fun human_summary(hc: *HumanCtx, outcomes: *Outcome, n: u32, passed: u32, failed: u32,
                  wall: du.Duration, tally: *outcome.GateTally) {
    render_summary(outcomes, n, passed, failed, wall, tally);
}

fun json_ctx_init(jc: *JsonCtx, a: *A.Allocator, log_dir: *u8) {
    jc.a       = a;
    jc.log_dir = log_dir;
    jc.n       = 0;
    jc.w = fs.writer(fs.STDOUT);
}

fun json_event_begin(w: *writer.Writer, o: *json.Object, event: *u8) {
    json.object_begin(w, o);
    json.field_i64(o, "schema", SCHEMA_VERSION);
    json.field_str(o, "event", event);
}

fun json_start(jc: *JsonCtx, arts: *outcome.TestArtifact, n: u32) {
    jc.n = n;
    var o: json.Object;
    json_event_begin(?jc.w, ?o, "run_start");
    json.field_i64(?o, "tests", n::i64);
    json.object_end(?o);
}

fun json_test(jc: *JsonCtx, outcomes: *Outcome, arts: *outcome.TestArtifact, idx: u32) {
    val o0:  *Outcome              = ?outcomes[idx];
    val art: *outcome.TestArtifact = ?arts[idx];
    var o: json.Object;
    json_event_begin(?jc.w, ?o, "test");
    json.field_str(?o, "label", art.label);
    json.field_str(?o, "module", art.module);
    json.field_str(?o, "file", art.file);
    json.field_i64(?o, "line", art.line::i64);
    json.field_str(?o, "kind", result_name(?o0.result));
    json.field_i64(?o, "code", o0.code::i64);
    json.field_i64(?o, "timeout_seconds", o0.bound);
    json.field_i64(?o, "duration_ns", du.duration_nsec(o0.elapsed));
    json.field_i64(?o, "index", art.idx::i64);
    json.field_str(?o, "exe", art.exe);
    if (has_capture(?o0.result)) {
        json.field_str_or_null(?o, "output", json_output_ref(jc, art.idx));
    }
    or {
        json.field_str_or_null(?o, "output", nil);
    }
    json.object_end(?o);
}

fun json_summary(jc: *JsonCtx, outcomes: *Outcome, n: u32, passed: u32, failed: u32,
                 wall: du.Duration, tally: *outcome.GateTally) {
    var o: json.Object;
    json_event_begin(?jc.w, ?o, "summary");
    json.field_i64(?o, "passed", passed::i64);
    json.field_i64(?o, "failed", failed::i64);
    json.field_i64(?o, "total", n::i64);
    json.field_i64(?o, "duration_ns", du.duration_nsec(wall));
    json.field_i64(?o, "mismatch", tally.semantic_mismatch::i64);
    json.field_i64(?o, "unsupported", tally.unsupported_input::i64);
    json.field_i64(?o, "target_unavailable", tally.tool_unavailable::i64);
    json.field_i64(?o, "infrastructure_failure", tally.infrastructure_failure::i64);
    json.field_i64(?o, "resource_exhaustion", tally.resource_exhaustion::i64);
    json.field_i64(?o, "timed_out", count_timed_out(outcomes, n)::i64);
    json.field_i64(?o, "invalid_injection", tally.invalid_injection::i64);
    json.object_end(?o);
}

fun json_output_ref(jc: *JsonCtx, idx: u32) *u8 {
    val r: R.Result[str, str] = log_path(jc.a, jc.log_dir, idx);
    if (R.is_err[str, str](r)) { ret nil; }
    ret R.unwrap_ok[str, str](r);
}

fun emit_list_case(w: *writer.Writer, art: *outcome.TestArtifact) {
    var o: json.Object;
    json_event_begin(w, ?o, "case");
    json.field_str(?o, "label", art.label);
    json.field_str(?o, "module", art.module);
    json.field_str(?o, "file", art.file);
    json.field_i64(?o, "line", art.line::i64);
    json.field_i64(?o, "index", art.idx::i64);
    json.object_end(?o);
}

fun result_name(r: *validation.ValidationGateResult) *u8 {
    if (r.kind == validation.RESULT_PASS) { ret "pass"; }
    if (r.kind == validation.RESULT_SEMANTIC_MISMATCH && r.cause == validation.CAUSE_ORACLE_EXIT)   { ret "exit"; }
    if (r.kind == validation.RESULT_SEMANTIC_MISMATCH && r.cause == validation.CAUSE_ORACLE_SIGNAL) { ret "signal"; }
    if (r.kind == validation.RESULT_INFRASTRUCTURE_FAILURE && r.cause == validation.CAUSE_ORACLE_SPAWN_FAILURE) { ret "spawn"; }
    if (r.kind == validation.RESULT_RESOURCE_EXHAUSTION && r.cause == validation.CAUSE_ORACLE_TIMEOUT) { ret "timeout"; }
    ret "other";
}

fun has_capture(r: *validation.ValidationGateResult) bool {
    if (r.kind == validation.RESULT_SEMANTIC_MISMATCH) { ret true; }
    if (r.kind == validation.RESULT_RESOURCE_EXHAUSTION) { ret true; }
    ret r.kind == validation.RESULT_INFRASTRUCTURE_FAILURE && r.cause != validation.CAUSE_ORACLE_SPAWN_FAILURE;
}

fun spawn_one(a: *A.Allocator, processes: *subprocess.OwnedSubprocess, slots: *Slot,
              window: u32, art: *outcome.TestArtifact, idx: u32, runner: *u8,
              log_dir: *u8, timeout_seconds: i64) O.Option[validation.ValidationGateResult] {
    var s: u32 = 0;
    for (s < window && slots[s].active) { s = s + 1; }
    if (s == window) { ret O.some[validation.ValidationGateResult](btest.classify_setup_failure()); }

    val lp_r: R.Result[str, str] = log_path(a, log_dir, art.idx);
    if (R.is_err[str, str](lp_r)) { ret O.some[validation.ValidationGateResult](btest.classify_setup_failure()); }
    val lp: str = R.unwrap_ok[str, str](lp_r);

    var ibuf: [16]u8;
    write_index(?ibuf[0], 16, art.idx);

    var child_argv: [4]*u8;
    if (runner != nil) {
        child_argv[0] = runner;
        child_argv[1] = art.exe;
        child_argv[2] = ?ibuf[0];
        child_argv[3] = nil;
    }
    or {
        child_argv[0] = art.exe;
        child_argv[1] = ?ibuf[0];
        child_argv[2] = nil;
    }

    val start: tm.Time = tm.monotonic();
    val res_c: R.Result[R.Void, str] = subprocess.spawn_captured_grouped(
        a, ?processes[idx], child_argv[0], ?child_argv[0], env.environ(), lp, CAP_OUTPUT);
    if (R.is_err[R.Void, str](res_c)) {
        val term: subprocess.SubprocessTerminal = processes[idx].terminal;
        var empty_cap: subprocess.CaptureIoResult;
        empty_cap.bytes        = 0;
        empty_cap.truncated    = false;
        empty_cap.short_read   = false;
        empty_cap.read_failed  = false;
        empty_cap.write_failed = false;
        empty_cap.close_failed = false;
        empty_cap.closed       = false;
        empty_cap.owned        = false;
        val result: validation.ValidationGateResult = btest.classify_subprocess(?term, false, true, ?empty_cap);
        subprocess.dnit(a, ?processes[idx]);
        fs.remove_file(?lp[0]);
        ret O.some[validation.ValidationGateResult](result);
    }

    if (timeout_seconds > 0) { subprocess.bound_seconds(?processes[idx], timeout_seconds); }

    slots[s].active = true;
    slots[s].art   = art;
    slots[s].idx   = idx;
    slots[s].start = start;
    ret O.none[validation.ValidationGateResult]();
}

fun finalize_slot(a: *A.Allocator, process: *subprocess.OwnedSubprocess, slot: *Slot,
                  outcomes: *Outcome, level: u8, want_bytes: bool, log_dir: *u8) {
    var o: Outcome;
    o.art       = slot.art;
    o.done      = true;
    o.code      = 0;
    o.out       = nil;
    o.out_len   = 0;
    o.truncated = false;
    o.elapsed   = tm.time_sub(tm.monotonic(), slot.start);

    val provisional_pass: bool = process.terminal.kind == subprocess.STATE_EXITED && process.terminal.code == 0;
    var retain: bool = want_bytes;
    if (provisional_pass && level < 2) { retain = false; }

    val capture_r: R.Result[subprocess.CaptureIoResult, str] = subprocess.finish_capture(a, process, retain);
    var cap_ok: bool = R.is_ok[subprocess.CaptureIoResult, str](capture_r);
    var capture: subprocess.CaptureIoResult;
    capture.bytes        = 0;
    capture.truncated    = false;
    capture.short_read    = false;
    capture.read_failed   = false;
    capture.write_failed  = false;
    capture.close_failed  = false;
    capture.closed        = false;
    capture.owned         = false;
    if (cap_ok) {
        capture = R.unwrap_ok[subprocess.CaptureIoResult, str](capture_r);
        if (retain) {
            o.out = subprocess.capture_bytes(process, ?o.out_len);
            o.truncated = capture.truncated;
        }
    }

    o.bound  = 0;
    if (subprocess.expired(process)) { o.bound = process.timeout_seconds; }
    o.result = btest.classify_subprocess(?process.terminal, subprocess.expired(process), cap_ok, ?capture);
    if (o.result.kind == validation.RESULT_SEMANTIC_MISMATCH) { o.code = process.terminal.code; }

    subprocess.dnit(a, process);
    if (o.result.kind == validation.RESULT_PASS) {
        val lp_r: R.Result[str, str] = log_path(a, log_dir, slot.art.idx);
        if (R.is_ok[str, str](lp_r)) { fs.remove_file(R.unwrap_ok[str, str](lp_r)); }
    }
    outcomes[slot.idx] = o;
}

fun render_module_run(a: *A.Allocator, outcomes: *Outcome, first: u32, last: u32, mod_name: str, mod_w: usize,
                      runner: *u8, log_dir: *u8) {
    var ok:      u32 = 0;
    var fail:    u32 = 0;
    var elapsed: du.Duration = 0;
    var j: u32 = first;
    for (j <= last) {
        if (outcomes[j].result.kind == validation.RESULT_PASS) { ok = ok + 1; }
        or                                                     { fail = fail + 1; }
        elapsed = elapsed + outcomes[j].elapsed;
        j = j + 1;
    }

    print_rollup(mod_name, ok, fail, elapsed, mod_w);
    if (fail > 0) {
        j = first;
        for (j <= last) {
            if (outcomes[j].result.kind != validation.RESULT_PASS) { print_fail_detail(a, ?outcomes[j], runner, log_dir); }
            j = j + 1;
        }
    }
}

fun module_col_width(arts: *outcome.TestArtifact, n: u32) usize {
    var w: usize = 0;
    var i: u32 = 0;
    for (i < n) {
        val l: usize = str_len(arts[i].module);
        if (l > w) { w = l; }
        i = i + 1;
    }
    if (w < 16) { w = 16; }
    if (w > 48) { w = 48; }
    ret w + 2;
}

fun label_col_width(arts: *outcome.TestArtifact, n: u32) usize {
    var w: usize = 0;
    var i: u32 = 0;
    for (i < n) {
        val l: usize = str_len(arts[i].label);
        if (l > w) { w = l; }
        i = i + 1;
    }
    if (w < 24) { w = 24; }
    if (w > 72) { w = 72; }
    ret w + 2;
}

fun print_col(s: str, width: usize) {
    print.print(s);
    var pad: usize = 2;
    val l: usize = str_len(s);
    if (l + 2 < width) { pad = width - l; }
    var i: usize = 0;
    for (i < pad) { print.print(" "); i = i + 1; }
}

fun print_dur(elapsed: du.Duration) {
    var dbuf: [24]u8;
    val ds: str = du.format_duration(elapsed, ?dbuf[0], 24::usize);
    val l: usize = str_len(ds);
    print.print("  ");
    var i: usize = l;
    for (i < 7) { print.print(" "); i = i + 1; }
    print.print(ds);
}

fun print_rollup(mod_name: str, ok: u32, fail: u32, elapsed: du.Duration, mod_w: usize) {
    print_col(mod_name, mod_w);
    if (fail > 0) { print.printf("{:4} ok  {:4} FAIL", ok::i64, fail::i64); }
    or           { print.printf("{:4} ok", ok::i64); }
    print_dur(elapsed);
    print.print("\n");
}

fun print_fail_detail(a: *A.Allocator, o: *Outcome, runner: *u8, log_dir: *u8) {
    val label: str = o.art.label;
    print.printf("  FAIL  {}  {}:{}  ", label, o.art.file, o.art.line::i64);
    print_reason(o);
    print.print("\n");
    print_captured(o);
    print_fail_pointers(a, o, runner, log_dir);
}

fun print_fail_pointers(a: *A.Allocator, o: *Outcome, runner: *u8, log_dir: *u8) {
    if (o.truncated) {
        val lp_r: R.Result[str, str] = log_path(a, log_dir, o.art.idx);
        if (R.is_ok[str, str](lp_r)) {
            print.printf("    full output: {}\n", R.unwrap_ok[str, str](lp_r));
        }
    }
    print.print("    rerun: ");
    if (runner != nil) {
        print.print(runner::str);
        print.print(" ");
    }
    print.print(o.art.exe::str);
    print.print(" ");
    print.u64(o.art.idx::u64);
    print.print("\n");
}

fun print_verbose_test(a: *A.Allocator, o: *Outcome, label_w: usize, runner: *u8, log_dir: *u8) {
    val label: str = o.art.label;
    if (o.result.kind == validation.RESULT_PASS) {
        print.print("  ok    ");
        print_col(label, label_w);
        print_dur(o.elapsed);
        print.print("\n");
        print_captured(o);
    }
    or {
        print.print("  FAIL  ");
        print_col(label, label_w);
        print_dur(o.elapsed);
        print.print("  ");
        print_reason(o);
        print.printf("  {}:{}\n", o.art.file, o.art.line::i64);
        print_captured(o);
        print_fail_pointers(a, o, runner, log_dir);
    }
}

fun print_reason(o: *Outcome) {
    if (o.result.kind == validation.RESULT_RESOURCE_EXHAUSTION && o.result.cause == validation.CAUSE_ORACLE_TIMEOUT) {
        print.printf("(timed out after {}s)", o.bound);
    }
    or (o.result.kind == validation.RESULT_SEMANTIC_MISMATCH && o.result.cause == validation.CAUSE_ORACLE_EXIT) {
        print.printf("(exit {})", o.code::i64);
    }
    or (o.result.kind == validation.RESULT_SEMANTIC_MISMATCH && o.result.cause == validation.CAUSE_ORACLE_SIGNAL) {
        print.printf("(signal {})", o.code::i64);
    }
    or (o.result.kind == validation.RESULT_INFRASTRUCTURE_FAILURE && o.result.cause == validation.CAUSE_ORACLE_SPAWN_FAILURE) {
        print.print("(spawn failed)");
    }
    or (o.result.kind == validation.RESULT_INFRASTRUCTURE_FAILURE && o.result.cause == validation.CAUSE_ORACLE_CAPTURE) {
        print.print("(capture failed)");
    }
    or (o.result.kind == validation.RESULT_INFRASTRUCTURE_FAILURE && o.result.cause == validation.CAUSE_INVALID_TERMINAL) {
        print.print("(runner failed)");
    }
    or                         { print.print("(failed)"); }
}

fun print_captured(o: *Outcome) {
    if (o.out == nil || o.out_len == 0) {
        if (o.truncated) { print.print("    ... (output truncated)\n"); }
        ret;
    }

    var w: writer.Writer;
    w = fs.writer(fs.STDOUT);

    var i:   usize = 0;
    var seg: usize = 0;
    for (i < o.out_len) {
        if (o.out[i] == '\n') {
            fmt.write_str(?w, "    ");
            fmt.write_bytes(?w, (o.out::usize + seg)::*u8, i - seg + 1::usize);
            seg = i + 1::usize;
        }
        i = i + 1;
    }
    if (seg < o.out_len) {
        fmt.write_str(?w, "    ");
        fmt.write_bytes(?w, (o.out::usize + seg)::*u8, o.out_len - seg);
        fmt.write_newline(?w);
    }
    if (o.truncated) { fmt.write_str(?w, "    ... (output truncated)\n"); }
}

fun render_summary(outcomes: *Outcome, len: u32, passed: u32, failed: u32, wall: du.Duration, tally: *outcome.GateTally) {
    print.print("\n");

    if (failed > 0) {
        print.print("failures:\n");
        var i: u32 = 0;
        for (i < len) {
            if (outcomes[i].result.kind != validation.RESULT_PASS) {
                print.printf("  {}  {}:{}  ",
                    outcomes[i].art.label,
                    outcomes[i].art.file,
                    outcomes[i].art.line::i64);
                print_reason(?outcomes[i]);
                print.print("\n");
            }
            i = i + 1;
        }
        print.print("\n");
    }

    var dbuf: [24]u8;
    val ds: str = du.format_duration(wall, ?dbuf[0], 24::usize);
    val timed_out: u32 = count_timed_out(outcomes, len);
    if (timed_out > 0) {
        print.printf("{} passed, {} failed ({} timed out), {} total  ({})\n",
            passed::i64, failed::i64, timed_out::i64, len::i64, ds);
    }
    or {
        print.printf("{} passed, {} failed, {} total  ({})\n", passed::i64, failed::i64, len::i64, ds);
    }

    val extra_infra: u32 = tally.unsupported_input + tally.tool_unavailable
        + tally.resource_exhaustion + tally.invalid_injection;
    if (extra_infra > 0) {
        print.printf("  unsupported {}, target unavailable {}, resource exhaustion {}, invalid injection {}\n",
            tally.unsupported_input::i64, tally.tool_unavailable::i64,
            tally.resource_exhaustion::i64, tally.invalid_injection::i64);
    }
}

fun count_failed(outcomes: *Outcome, len: u32) u32 {
    var f: u32 = 0;
    var i: u32 = 0;
    for (i < len) {
        if (outcomes[i].result.kind != validation.RESULT_PASS) { f = f + 1; }
        i = i + 1;
    }
    ret f;
}

fun artifact_report(art: *outcome.TestArtifact) {
    print.print(art.label::str);
    print.print(" ");
    print.print(art.file::str);
    print.print(":");
    print.u64(art.line::u64);
}

fun filter_matches(art: *outcome.TestArtifact, filter: *u8) bool {
    if (filter == nil) { ret true; }
    ret str_contains(art.label, filter);
}

fun report_skipped(n: u32) {
    var buf: [16]u8;
    write_index(?buf[0], 16, n);
    print.eprint("note: skipped ");
    print.eprint(?buf[0]);
    if (n == 1) { print.eprint(" target-gated module\n"); }
    or          { print.eprint(" target-gated modules\n"); }
}

fun write_index(buf: *u8, cap: usize, n: u32) {
    var tmp: [16]u8;
    var t:   usize = 0;
    var v:   u32   = n;
    if (v == 0) { tmp[0] = '0'; t = 1; }
    for (v > 0) { tmp[t] = (v % 10)::u8 + '0'; v = v / 10; t = t + 1; }
    var k: usize = 0;
    for (k < t && k + 1 < cap) { buf[k] = tmp[t - 1 - k]; k = k + 1; }
    buf[k] = 0;
}

fun parse_count(s: *u8) i64 {
    if (s == nil || s[0] == 0) { ret -1; }
    var v: i64 = 0;
    var i: usize = 0;
    for (s[i] != 0) {
        if (s[i] < '0' || s[i] > '9') { ret -1; }
        v = v * 10 + (s[i] - '0')::i64;
        if (v > 65536) { ret -1; }
        i = i + 1;
    }
    ret v;
}

fun capture_log_dir(a: *A.Allocator, exe: *u8) R.Result[str, str] {
    val dir_r: R.Result[str, str] = path.parent(a, exe::str);
    if (R.is_err[str, str](dir_r)) { ret dir_r; }
    ret path.join(a, R.unwrap_ok[str, str](dir_r), "log");
}

fun log_path(a: *A.Allocator, log_dir: *u8, idx: u32) R.Result[str, str] {
    var leaf: [24]u8;
    write_index(?leaf[0], 16, idx);
    var k: usize = str_len(?leaf[0]);
    leaf[k]     = '.';
    leaf[k + 1] = 'l';
    leaf[k + 2] = 'o';
    leaf[k + 3] = 'g';
    leaf[k + 4] = 0;
    ret path.join(a, log_dir::str, (?leaf[0])::str);
}

fun wipe_logs(a: *A.Allocator, log_dir: *u8, total: u32) {
    var idx: u32 = 0;
    for (idx < total) {
        val lp_r: R.Result[str, str] = log_path(a, log_dir, idx);
        if (R.is_ok[str, str](lp_r)) {
            val lp: str = R.unwrap_ok[str, str](lp_r);
            if (idx == 0) { util.ensure_parents(a, lp); }
            fs.remove_file(lp);
        }
        idx = idx + 1;
    }
}

fun t_outcome(kind: validation.ValidationGateResultKind, cause: validation.ValidationCause) Outcome {
    var art: outcome.TestArtifact;
    art.module = "m";
    art.label  = "l";
    art.file   = "f.mach";
    art.line   = 1;
    art.exe    = nil;
    art.idx    = 0;

    var o: Outcome;
    o.art       = ?art;
    o.done      = true;
    o.result    = validation.gate_result(kind, cause, nil);
    o.code      = 0;
    o.elapsed   = 0;
    o.out       = nil;
    o.out_len   = 0;
    o.truncated = false;
    o.bound     = 0;
    ret o;
}

test "mach.cli.cmd.testing.result_name_and_has_capture:cover_every_classified_shape" {
    var bad: i32 = 0;

    var pass: Outcome = t_outcome(validation.RESULT_PASS, validation.CAUSE_PASS);
    if (!str_equals(result_name(?pass.result), "pass"))   { bad = 1; }
    if (has_capture(?pass.result))                        { bad = 1; }

    var ex: Outcome = t_outcome(validation.RESULT_SEMANTIC_MISMATCH, validation.CAUSE_ORACLE_EXIT);
    if (!str_equals(result_name(?ex.result), "exit"))     { bad = 1; }
    if (!has_capture(?ex.result))                         { bad = 1; }

    var sig: Outcome = t_outcome(validation.RESULT_SEMANTIC_MISMATCH, validation.CAUSE_ORACLE_SIGNAL);
    if (!str_equals(result_name(?sig.result), "signal"))  { bad = 1; }
    if (!has_capture(?sig.result))                        { bad = 1; }

    var spawn: Outcome = t_outcome(validation.RESULT_INFRASTRUCTURE_FAILURE, validation.CAUSE_ORACLE_SPAWN_FAILURE);
    if (!str_equals(result_name(?spawn.result), "spawn")) { bad = 1; }
    if (has_capture(?spawn.result))                       { bad = 1; }

    var cap: Outcome = t_outcome(validation.RESULT_INFRASTRUCTURE_FAILURE, validation.CAUSE_ORACLE_CAPTURE);
    if (!str_equals(result_name(?cap.result), "other"))   { bad = 1; }
    if (!has_capture(?cap.result))                        { bad = 1; }

    var wait: Outcome = t_outcome(validation.RESULT_INFRASTRUCTURE_FAILURE, validation.CAUSE_INVALID_TERMINAL);
    if (!str_equals(result_name(?wait.result), "other"))  { bad = 1; }
    if (!has_capture(?wait.result))                       { bad = 1; }

    var late: Outcome = t_outcome(validation.RESULT_RESOURCE_EXHAUSTION, validation.CAUSE_ORACLE_TIMEOUT);
    if (!str_equals(result_name(?late.result), "timeout")) { bad = 1; }
    if (!has_capture(?late.result))                        { bad = 1; }

    ret bad;
}

test "mach.cli.cmd.testing.count_failed_and_build_gate_tally:only_pass_counts_as_passing" {
    var a: A.Allocator;
    page.make(?a);

    var outcomes: [3]Outcome;
    outcomes[0] = t_outcome(validation.RESULT_PASS, validation.CAUSE_PASS);
    outcomes[1] = t_outcome(validation.RESULT_SEMANTIC_MISMATCH, validation.CAUSE_ORACLE_EXIT);
    outcomes[2] = t_outcome(validation.RESULT_TOOL_UNAVAILABLE, validation.CAUSE_TOOL_UNAVAILABLE);

    if (count_failed(?outcomes[0], 3) != 2) { ret 1; }

    var gt: outcome.GateTally = outcome.gate_tally_init(?a);
    build_gate_tally(?gt, ?a, ?outcomes[0], 3);

    var bad: i32 = 0;
    if (gt.pass != 1)              { bad = 1; }
    or (gt.semantic_mismatch != 1) { bad = 1; }
    or (gt.tool_unavailable != 1)  { bad = 1; }
    or (outcome.gate_tally_total(?gt) != 3) { bad = 1; }

    outcome.gate_tally_dnit(?gt);
    ret bad;
}

test "mach.cli.cmd.testing.exit_code:infrastructure_failure_dominates_ordinary_test_failure" {
    var a: A.Allocator;
    page.make(?a);

    var clean: outcome.GateTally = outcome.gate_tally_init(?a);
    if (exit_code(0, ?clean) != 0) { ret 1; }
    outcome.gate_tally_dnit(?clean);

    var only_failed: outcome.GateTally = outcome.gate_tally_init(?a);
    if (exit_code(3, ?only_failed) != 1) { ret 2; }
    outcome.gate_tally_dnit(?only_failed);

    var infra: outcome.GateTally = outcome.gate_tally_init(?a);
    if (R.is_err[R.Void, str](outcome.record_gate(?infra, ?a,
        validation.gate_result(validation.RESULT_INFRASTRUCTURE_FAILURE, validation.CAUSE_ORACLE_CAPTURE, nil)))) { ret 3; }
    if (exit_code(0, ?infra) != 2) { ret 4; }
    if (exit_code(5, ?infra) != 2) { ret 5; }
    outcome.gate_tally_dnit(?infra);

    ret 0;
}

fun t_test(argc: usize, argv: **u8) i64 {
    var a: A.Allocator;
    if (O.is_some[str](page.make(?a))) { ret 2; }
    val ir: R.Result[args.ParsedInvocation, str] = args.parse_invocation(?a, argc, argv);
    if (R.is_err[args.ParsedInvocation, str](ir)) { ret 2; }
    var inv: args.ParsedInvocation = R.unwrap_ok[args.ParsedInvocation, str](ir);
    ret run_typed(argv, ?inv);
}

test "mach.cli.cmd.testing.run_typed:rejects_emit_before_effects_for_every_value_shape_and_position" {
    var bad: i32 = 0;

    var no_value: [3]*u8;
    no_value[0] = "mach"; no_value[1] = "test"; no_value[2] = "--emit";
    if (t_test(3, ?no_value[0]) != 1) { bad = 1; }

    var with_obj: [4]*u8;
    with_obj[0] = "mach"; with_obj[1] = "test"; with_obj[2] = "--emit"; with_obj[3] = "obj";
    if (t_test(4, ?with_obj[0]) != 1) { bad = 1; }

    var with_exe: [4]*u8;
    with_exe[0] = "mach"; with_exe[1] = "test"; with_exe[2] = "--emit"; with_exe[3] = "exe";
    if (t_test(4, ?with_exe[0]) != 1) { bad = 1; }

    var arbitrary: [4]*u8;
    arbitrary[0] = "mach"; arbitrary[1] = "test"; arbitrary[2] = "--emit"; arbitrary[3] = "bogus";
    if (t_test(4, ?arbitrary[0]) != 1) { bad = 1; }

    var duplicate: [5]*u8;
    duplicate[0] = "mach"; duplicate[1] = "test"; duplicate[2] = "--emit";
    duplicate[3] = "obj"; duplicate[4] = "--emit";
    if (t_test(5, ?duplicate[0]) != 1) { bad = 1; }

    var positional_adjacent: [4]*u8;
    positional_adjacent[0] = "mach"; positional_adjacent[1] = "test";
    positional_adjacent[2] = "."; positional_adjacent[3] = "--emit";
    if (t_test(4, ?positional_adjacent[0]) != 1) { bad = 1; }

    var trailing_conflict: [6]*u8;
    trailing_conflict[0] = "mach"; trailing_conflict[1] = "test"; trailing_conflict[2] = "--list";
    trailing_conflict[3] = "--filter"; trailing_conflict[4] = "foo"; trailing_conflict[5] = "--emit";
    if (t_test(6, ?trailing_conflict[0]) != 1) { bad = 1; }

    ret bad;
}

test "mach.cli.cmd.testing.run_typed:rejects_o1_before_any_side_effect_at_every_position" {
    var bad: i32 = 0;

    var alone: [3]*u8;
    alone[0] = "mach"; alone[1] = "test"; alone[2] = "-O1";
    if (t_test(3, ?alone[0]) != 1) { bad = 1; }

    var with_project: [4]*u8;
    with_project[0] = "mach"; with_project[1] = "test"; with_project[2] = "-O1";
    with_project[3] = "/definitely/not/a/real/rem102-project";
    if (t_test(4, ?with_project[0]) != 1) { bad = 1; }

    var trailing: [4]*u8;
    trailing[0] = "mach"; trailing[1] = "test";
    trailing[2] = "/definitely/not/a/real/rem102-project"; trailing[3] = "-O1";
    if (t_test(4, ?trailing[0]) != 1) { bad = 1; }

    var duplicate: [4]*u8;
    duplicate[0] = "mach"; duplicate[1] = "test"; duplicate[2] = "-O1"; duplicate[3] = "-O1";
    if (t_test(4, ?duplicate[0]) != 1) { bad = 1; }

    var with_o2: [4]*u8;
    with_o2[0] = "mach"; with_o2[1] = "test"; with_o2[2] = "-O1"; with_o2[3] = "-O2";
    if (t_test(4, ?with_o2[0]) != 1) { bad = 1; }

    ret bad;
}

fun t_temp_name(a: *A.Allocator) str {
    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(a, "mach_test_timeout");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret ""; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);
    val dup_r: R.Result[str, str] = str_dup(a, fs.temp_path(?tf));
    fs.temp_close_and_remove(?tf);
    if (R.is_err[str, str](dup_r)) { ret ""; }
    ret R.unwrap_ok[str, str](dup_r);
}

rec TimeoutProbe {
    script:  str;
    log_dir: str;
    marker:  str;
    outcome: Outcome;
}

fun t_probe_free(a: *A.Allocator, pr: *TimeoutProbe) {
    if (str_len(pr.script) > 0)  { fs.remove_file(pr.script);  str_free(a, pr.script); }
    if (str_len(pr.log_dir) > 0) { fs.remove_all(a, pr.log_dir); str_free(a, pr.log_dir); }
    if (str_len(pr.marker) > 0)  { fs.remove_file(pr.marker);  str_free(a, pr.marker); }
    pr.script  = "";
    pr.log_dir = "";
    pr.marker  = "";
}

# runs one test process through the real spawn, wait and finalize chain
fun t_run_one_bounded(a: *A.Allocator, body: str, timeout_seconds: i64, pr: *TimeoutProbe) i32 {
    pr.script  = t_temp_name(a);
    pr.log_dir = t_temp_name(a);
    if (str_len(pr.script) == 0 || str_len(pr.log_dir) == 0) { ret 1; }
    if (O.is_some[str](fs.write_bytes(pr.script, body::*u8, str_len(body), 0o600))) { ret 2; }
    if (O.is_some[str](fs.create_dir(pr.log_dir, 0o700))) { ret 3; }

    var art: outcome.TestArtifact;
    art.module = "mach.timeout.probe";
    art.label  = "probe";
    art.file   = "probe.mach";
    art.line   = 1;
    art.exe    = pr.script::*u8;
    art.idx    = 0;

    var process: subprocess.OwnedSubprocess;
    subprocess.init(?process);
    var slot: Slot;
    slot.active = false;

    val spawn_fail: O.Option[validation.ValidationGateResult] =
        spawn_one(a, ?process, ?slot, 1, ?art, 0, "/bin/sh"::*u8, pr.log_dir::*u8, timeout_seconds);
    if (O.is_some[validation.ValidationGateResult](spawn_fail)) { ret 4; }

    val wr: R.Result[*subprocess.OwnedSubprocess, str] =
        subprocess.wait_any(a, ?process, 1, nil, nil);
    if (R.is_err[*subprocess.OwnedSubprocess, str](wr)) {
        subprocess.cancel(a, ?process, 0);
        subprocess.dnit(a, ?process);
        ret 5;
    }
    var outcomes: [1]Outcome;
    finalize_slot(a, ?process, ?slot, ?outcomes[0], 0, true, pr.log_dir::*u8);
    pr.outcome = outcomes[0];
    ret 0;
}

test "mach.cli.cmd.testing:a_test_past_its_bound_is_timed_out_and_its_grandchild_dies_with_it" {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    var a: A.Allocator;
    if (O.is_some[str](page.make(?a))) { ret 1; }

    var pr: TimeoutProbe;
    pr.script = ""; pr.log_dir = ""; pr.marker = "";
    pr.marker = t_temp_name(?a);
    if (str_len(pr.marker) == 0) { ret 2; }

    val body: str = sfmt_probe(?a, pr.marker);
    if (str_len(body) == 0) { t_probe_free(?a, ?pr); ret 3; }
    val setup: i32 = t_run_one_bounded(?a, body, 1, ?pr);
    str_free(?a, body);
    var bad: i32 = 0;
    if (setup != 0) { bad = 10 + setup; }
    or {
        val o: *Outcome = ?pr.outcome;
        if (o.result.kind != validation.RESULT_RESOURCE_EXHAUSTION) { bad = 4; }
        or (o.result.cause != validation.CAUSE_ORACLE_TIMEOUT)      { bad = 5; }
        or (o.bound != 1)                                           { bad = 6; }
        or (!str_equals(result_name(?o.result), "timeout"))         { bad = 7; }
        or {
            var one: [1]Outcome;
            one[0] = @o;
            if (count_timed_out(?one[0], 1) != 1) { bad = 8; }
            or (count_failed(?one[0], 1) != 1)    { bad = 9; }
            or {
                var tally: outcome.GateTally = outcome.gate_tally_init(?a);
                build_gate_tally(?tally, ?a, ?one[0], 1);
                if (exit_code(1, ?tally) != 1) { bad = 20; }
                outcome.gate_tally_dnit(?tally);
            }
        }
        # the grandchild outlives its bound by 2s; if the group was not
        # terminated it wakes and publishes the marker
        if (bad == 0) {
            sys.sleep(du.SECOND * 3);
            if (fs.exists(pr.marker)) { bad = 21; }
        }
    }
    t_probe_free(?a, ?pr);
    ret bad;
}

fun sfmt_probe(a: *A.Allocator, marker: str) str {
    val r: R.Result[str, str] = fmt.sprint(a, "(sleep 2; echo alive > {}) &\nsleep 30\n", marker);
    if (R.is_err[str, str](r)) { ret ""; }
    ret R.unwrap_ok[str, str](r);
}

test "mach.cli.cmd.testing:an_unbounded_test_that_sleeps_briefly_still_passes" {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    var a: A.Allocator;
    if (O.is_some[str](page.make(?a))) { ret 1; }

    var pr: TimeoutProbe;
    pr.script = ""; pr.log_dir = ""; pr.marker = "";
    val setup: i32 = t_run_one_bounded(?a, "sleep 1\nexit 0\n", 0, ?pr);
    var bad: i32 = 0;
    if (setup != 0) { bad = 10 + setup; }
    or {
        val o: *Outcome = ?pr.outcome;
        if (o.result.kind != validation.RESULT_PASS) { bad = 2; }
        or (o.bound != 0)                            { bad = 3; }
        or {
            var one: [1]Outcome;
            one[0] = @o;
            if (count_timed_out(?one[0], 1) != 0) { bad = 4; }
            or {
                var tally: outcome.GateTally = outcome.gate_tally_init(?a);
                build_gate_tally(?tally, ?a, ?one[0], 1);
                if (exit_code(0, ?tally) != 0) { bad = 5; }
                outcome.gate_tally_dnit(?tally);
            }
        }
    }
    t_probe_free(?a, ?pr);
    ret bad;
}

test "mach.cli.cmd.testing:a_test_that_beats_its_bound_keeps_its_own_outcome" {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    var a: A.Allocator;
    if (O.is_some[str](page.make(?a))) { ret 1; }

    var pr: TimeoutProbe;
    pr.script = ""; pr.log_dir = ""; pr.marker = "";
    val setup: i32 = t_run_one_bounded(?a, "exit 4\n", 30, ?pr);
    var bad: i32 = 0;
    if (setup != 0) { bad = 10 + setup; }
    or {
        val o: *Outcome = ?pr.outcome;
        if (o.result.kind != validation.RESULT_SEMANTIC_MISMATCH) { bad = 2; }
        or (o.result.cause != validation.CAUSE_ORACLE_EXIT)       { bad = 3; }
        or (o.code != 4)                                          { bad = 4; }
        or (o.bound != 0)                                         { bad = 5; }
    }
    t_probe_free(?a, ?pr);
    ret bad;
}
