val SCHEMA_VERSION: i64 = 2;

val CAP_OUTPUT: usize = 65536;

rec Outcome {
    art:       *outcome.TestArtifact;
    done:      bool;
    result:    validation.ValidationGateResult;
    code:      i32;
    elapsed:   du.Duration;
    out:       *u8;
    out_len:   usize;
    truncated: bool;
    bound:     du.Duration;
}

# `mach test`: build the project's test dispatcher and run the collected tests. `-O1` and
# `--emit` are refused; `--list` prints the collected tests and stops; `--format json`
# writes the machine-readable event stream; `--filter`, `--runner`, `--timeout`,
# and `--jobs` shape the run; `-o` names the dispatcher binary the way `mach build -o`
# names a built one, inside the project root, so runs in one tree with different `-o`
# do not collide
# ---
# argv: the full process arguments
# inv:  the parsed invocation for this command
# ret:  exit.OK when every test passed, exit.USER for at least one failed test, exit.INTERNAL
#       for an infrastructure failure, otherwise the code `exit.of` maps the printed failure to
pub fun run(argv: **u8, inv: *args.ParsedInvocation) i64 {
    val cmd: args.CommandId = args.CMD_TEST;

    if (util.flag_exists(inv.argc, argv, "--emit")) {
        ret cli_diag.refuse(outcome.user("--emit is not applicable to 'test'; test always builds its internal test dispatcher"));
    }

    val res_cfg: res[args.CliArgs, outcome.Fail] = args.build_cli_invocation(cmd, inv, argv);
    if (sel res_cfg.err) { ret cli_diag.refuse(res_cfg.err); }
    var config: args.CliArgs = res_cfg.ok;

    val list:        bool     = args.invocation_flag(cmd, inv, "--list");
    val opt_format:  opt[*u8] = args.invocation_value(cmd, inv, argv, "--format");
    val opt_filter:  opt[*u8] = args.invocation_value(cmd, inv, argv, "--filter");
    val opt_runner:  opt[*u8] = args.invocation_value(cmd, inv, argv, "--runner");
    val opt_timeout: opt[*u8] = args.invocation_value(cmd, inv, argv, "--timeout");
    if (args.reject_unknown_from_invocation(inv, argv, "mach test")) { ret exit.USER; }

    val level: u8 = config.verbosity;

    var json_out: bool = false;
    if (sel opt_format.some) {
        val fv: str = opt_format.some::str;
        if (str_equals(fv, "json"))  { json_out = true; }
        or (str_equals(fv, "human")) { json_out = false; }
        or {
            ret cli_diag.refuse(outcome.user("--format expects 'human' or 'json'"));
        }
    }

    var timeout: du.Duration = 0;
    if (sel opt_timeout.some) {
        val tv: opt[du.Duration] = duration.parse(opt_timeout.some);
        if (sel tv.none) {
            print.eprintf("error: --timeout expects {}\n", duration.FORMS);
            ret exit.USER;
        }
        timeout = tv.some;
    }

    var jobs: u32 = 1;
    if (config.jobs != nil) {
        val jv: i64 = parse_count(config.jobs);
        if (jv < 1) {
            ret cli_diag.refuse(outcome.user("--jobs expects a positive integer"));
        }
        jobs = jv::u32;
    }
    or {
        val nc: i64 = sys.cpu_count();
        if (nc > 1) { jobs = nc::u32; }
    }

    var backing: A.Allocator;
    val make_r:  err[A.Error] = page.make(?backing);
    if (sel make_r.err) { ret cli_diag.refuse(outcome.refused(make_r.err)); }
    var ar:     arena.Arena;
    val init_r: err[A.Error] = arena.init(?ar, ?backing, 0);
    if (sel init_r.err) { ret cli_diag.refuse(outcome.refused(init_r.err)); }
    var a:       A.Allocator;
    val make_r2: err[A.Error] = arena.make(?a, ?ar);
    if (sel make_r2.err) {
        arena.dnit(?ar);
        ret cli_diag.refuse(outcome.refused(make_r2.err));
    }

    var root_arg: *u8 = nil;
    if (inv.has_positional) { root_arg = argv[inv.positional_idx]; }

    val loc_r: res[util.ProjectLocation, outcome.Fail] = util.resolve_project_location(?a, root_arg);
    if (sel loc_r.err) {
        val lc: i64 = cli_diag.refuse(loc_r.err);
        arena.dnit(?ar);
        ret lc;
    }
    val loc:  util.ProjectLocation = loc_r.ok;
    val root: str                  = loc.root;

    val col_r: err[outcome.Fail] = args.collect_link_inputs(?a, ?config, cmd, inv, argv);
    if (sel col_r.err) {
        val cc: i64 = cli_diag.refuse(col_r.err);
        arena.dnit(?ar);
        ret cc;
    }

    var goal: request.BuildGoal = request.GOAL_TESTS;
    if (list) { goal = request.GOAL_TEST_LIST; }

    var ps:     session.Session;
    val plan_r: res[plan.BuildPlan, outcome.Fail] = build.plan_invocation(?a, root, ?config, goal, false, ?ps);
    if (sel plan_r.err) {
        var pf: outcome.Fail = plan_r.err;
        val pc: i64          = cli_diag.render_fail(?pf);
        arena.dnit(?ar);
        ret pc;
    }
    var bp: plan.BuildPlan = plan_r.ok;
    # the filter selects the tests the dispatcher is linked over
    if (sel opt_filter.some) { bp.request.test_filter = opt_filter.some::str; }

    var pr: readout.Progress;
    var ev: *readout.Progress = nil;
    if (level > 0) {
        readout.init(?pr, ?a, level);
        ev = ?pr;
    }

    val ex_r: res[outcome.BuildOutcome, outcome.Fail] = engine.execute(?bp, ?backing, ?a, ev);
    if (ev != nil) {
        readout.render(ev);
        readout.dnit(ev);
    }
    session.dnit(?ps);
    if (sel ex_r.err) {
        var xf: outcome.Fail = ex_r.err;
        val xc: i64          = cli_diag.render_fail(?xf);
        arena.dnit(?ar);
        ret xc;
    }
    var bo: outcome.BuildOutcome = ex_r.ok;
    cli_diag.render_outcome(?bo, config.quiet);
    if (bo.severity != outcome.BUILD_OK) {
        val bc: i64 = cli_diag.outcome_code(?bo);
        arena.dnit(?ar);
        ret bc;
    }
    val selected: *outcome.TestArtifact = bo.tests.data;
    val sel_len:  u32                   = bo.tests.len::u32;

    if (list) {
        var lw: writer.Writer;
        if (json_out) { lw = fs.writer(fs.STDOUT); }
        var i: u32 = 0;
        for (i < sel_len) {
            if (json_out) { emit_list_case(?lw, ?selected[i]); }
            or {
                artifact_report(?selected[i]);
                print.print("\n");
            }
            i = i + 1;
        }
        arena.dnit(?ar);
        ret exit.OK;
    }

    var runner: *u8 = nil;
    if (sel opt_runner.some) {
        val name:        *u8                    = opt_runner.some;
        val res_resolve: res[*u8, outcome.Fail] = util.resolve_cmd(?a, name);
        if (sel res_resolve.err) {
            arena.dnit(?ar);
            print.eprint("error: --runner '");
            print.eprint(name::str);
            print.eprint("': ");
            print.eprint(outcome.describe(res_resolve.err));
            print.eprint("\n");
            ret exit.of(res_resolve.err);
        }
        runner = res_resolve.ok;
    }

    if (sel_len == 0) {
        var empty_tally: outcome.GateTally = outcome.gate_tally_init(?a);
        if (json_out) {
            var jc: JsonCtx;
            json_ctx_init(?jc, ?a, nil);
            json_start(?jc, nil, 0);
            json_summary(?jc, nil, 0, 0, 0, 0, ?empty_tally);
        }
        or { print.print("0 passed, 0 failed, 0 total  (0ms)\n"); }
        arena.dnit(?ar);
        ret exit.OK;
    }

    val res_out: res[*Outcome, A.Error] = A.allocate[Outcome](?a, sel_len::usize);
    if (sel res_out.err) {
        arena.dnit(?ar);
        ret cli_diag.refuse(outcome.refused(res_out.err));
    }
    val outcomes: *Outcome = res_out.ok;

    val ld_r: res[str, outcome.Fail] = capture_log_dir(?a, selected[0].exe);
    if (sel ld_r.err) {
        arena.dnit(?ar);
        print.eprintlnf("error: could not derive the test log directory: {}", outcome.describe(ld_r.err));
        ret exit.of(ld_r.err);
    }
    val log_dir:  str               = ld_r.ok;
    val prepared: err[outcome.Fail] = prepare_logs(?a, log_dir, sel_len);
    if (sel prepared.err) {
        val lc: i64 = cli_diag.refuse(prepared.err);
        arena.dnit(?ar);
        ret lc;
    }

    var code: i64 = exit.OK;
    if (json_out) {
        var jc: JsonCtx;
        json_ctx_init(?jc, ?a, log_dir);
        code = execute_rendered[JsonCtx](?a, selected, sel_len, runner, outcomes, level, jobs,
            log_dir, false, timeout, ?jc, json_start, json_test,
            json_summary);
    }
    or {
        var hc:     HumanCtx;
        val mod_w:  usize = module_col_width(selected, sel_len);
        val name_w: usize = name_col_width(selected, sel_len);
        human_ctx_init(?a, ?hc, level, mod_w, name_w, runner, log_dir);
        code = execute_rendered[HumanCtx](?a, selected, sel_len, runner, outcomes, level, jobs,
            log_dir, true, timeout, ?hc, human_start, human_test,
            human_summary);
    }
    arena.dnit(?ar);
    ret code;
}

fun exit_code(failed: u32, tally: *outcome.GateTally) i64 {
    if (tally.infrastructure_failure > 0) { ret exit.INTERNAL; }
    if (failed > 0)                       { ret exit.USER; }
    ret exit.OK;
}

fun count_timed_out(outcomes: *Outcome, len: u32) u32 {
    var t: u32 = 0;
    var i: u32 = 0;
    for (i < len) {
        if (outcomes[i].result.kind == validation.RESULT_RESOURCE_EXHAUSTION
            && outcomes[i].result.cause == validation.CAUSE_ORACLE_TIMEOUT) { t = t + 1; }
        i = i + 1;
    }
    ret t;
}

fun build_gate_tally(gt: *outcome.GateTally, a: *A.Allocator, outcomes: *Outcome, n: u32) {
    var i: u32 = 0;
    for (i < n) {
        outcome.record_gate(gt, a, outcomes[i].result);
        i = i + 1;
    }
}

fun execute_rendered[T](a: *A.Allocator, arts: *outcome.TestArtifact, n: u32, runner: *u8,
    outcomes: *Outcome, level: u8, jobs: u32, log_dir: *u8,
    want_bytes: bool, timeout: du.Duration, ctx: *T,
    fn_start: fun(*T, *outcome.TestArtifact, u32),
    fn_test: fun(*T, *Outcome, *outcome.TestArtifact, u32),
    fn_summary: fun(*T, *Outcome, u32, u32, u32, du.Duration,
    *outcome.GateTally)) i64 {
    val run_start: readout.Instant = readout.sample();
    fn_start(ctx, arts, n);
    execute_and_render[T](a, arts, n, runner, outcomes, level, jobs, log_dir, want_bytes,
        timeout, ctx, fn_test);
    val wall: du.Duration = readout.elapsed(run_start);

    val failed: u32               = count_failed(outcomes, n);
    val passed: u32               = n - failed;
    var tally:  outcome.GateTally = outcome.gate_tally_init(a);
    build_gate_tally(?tally, a, outcomes, n);
    fn_summary(ctx, outcomes, n, passed, failed, wall, ?tally);
    ret exit_code(failed, ?tally);
}

rec Slot {
    active: bool;
    art:    *outcome.TestArtifact;
    idx:    u32;
    start:  readout.Instant;
}

# every test renders as a setup failure when the run's own storage was refused
fun render_exhausted[T](arts: *outcome.TestArtifact, n: u32, outcomes: *Outcome, ctx: *T,
    fn_test: fun(*T, *Outcome, *outcome.TestArtifact, u32)) {
    print.eprint("error: out of memory\n");
    var i: u32 = 0;
    for (i < n) {
        outcomes[i].art       = ?arts[i];
        outcomes[i].done      = true;
        outcomes[i].result    = btest.classify_setup_failure();
        outcomes[i].code      = 0;
        outcomes[i].elapsed   = 0;
        outcomes[i].out       = nil;
        outcomes[i].out_len   = 0;
        outcomes[i].truncated = false;
        outcomes[i].bound     = 0;
        i                     = i + 1;
    }
    i = 0;
    for (i < n) {
        fn_test(ctx, outcomes, arts, i);
        i = i + 1;
    }
}

fun execute_and_render[T](a: *A.Allocator, arts: *outcome.TestArtifact, n: u32, runner: *u8,
    outcomes: *Outcome, level: u8, jobs: u32, log_dir: *u8,
    want_bytes: bool, timeout: du.Duration, ctx: *T,
    fn_test: fun(*T, *Outcome, *outcome.TestArtifact, u32)) {
    var i: u32 = 0;
    for (i < n) {
        outcomes[i].done = false;
        i                = i + 1;
    }

    var window: u32 = jobs;
    if (window < 1) { window = 1; }
    if (window > n) { window = n; }

    val res_processes: res[*subprocess.OwnedSubprocess, A.Error] = A.allocate[subprocess.OwnedSubprocess](a, n::usize);
    if (sel res_processes.err) {
        render_exhausted[T](arts, n, outcomes, ctx, fn_test);
        ret;
    }
    val processes: *subprocess.OwnedSubprocess = res_processes.ok;
    val res_slots: res[*Slot, A.Error]         = A.allocate[Slot](a, window::usize);
    if (sel res_slots.err) {
        A.deallocate[subprocess.OwnedSubprocess](a, processes, n::usize);
        render_exhausted[T](arts, n, outcomes, ctx, fn_test);
        ret;
    }
    val slots: *Slot = res_slots.ok;
    i = 0;
    for (i < n) {
        subprocess.init(?processes[i]);
        i = i + 1;
    }
    i = 0;
    for (i < window) {
        slots[i].active = false;
        i               = i + 1;
    }

    var scope: cnc.Scope;
    cnc.make_root(?scope, opt[tm.Instant].none{});
    var source:           events.Source;
    val made_source:      err[io_error.Error] = events.make(?source);
    var has_source:       bool                = sel made_source.ok;
    var interrupt_source: *events.Source      = nil;
    if (has_source) { interrupt_source = ?source; }

    var spawned:  u32 = 0;
    var done:     u32 = 0;
    var inflight: u32 = 0;

    for (done < n) {
        for (inflight < window && spawned < n) {
            val idx: u32 = spawned;
            spawned = spawned + 1;
            val spawn_fail: opt[validation.ValidationGateResult] = spawn_one(a, processes, slots, window, ?arts[idx], idx, runner, log_dir,
                timeout);
            if (sel spawn_fail.none) {
                inflight = inflight + 1;
            }
            if (sel spawn_fail.some) {
                outcomes[idx].art       = ?arts[idx];
                outcomes[idx].done      = true;
                outcomes[idx].result    = spawn_fail.some;
                outcomes[idx].code      = 0;
                outcomes[idx].elapsed   = 0;
                outcomes[idx].out       = nil;
                outcomes[idx].out_len   = 0;
                outcomes[idx].truncated = false;
                outcomes[idx].bound     = 0;
                done                    = done + 1;
                fn_test(ctx, outcomes, arts, idx);
            }
        }

        if (inflight > 0) {
            val wr: res[*subprocess.OwnedSubprocess, subprocess.Error] = subprocess.wait_any(a, processes, n, ?scope, interrupt_source);
            if (sel wr.err) {
                print.eprint("error: waiting for test children failed\n");
                var sx: u32 = 0;
                for (sx < window) {
                    if (slots[sx].active) {
                        val eidx:    u32                                                  = slots[sx].idx;
                        var cleaned: bool                                                 = false;
                        val one:     res[subprocess.SubprocessTerminal, subprocess.Error] = subprocess.wait(a, ?processes[eidx]);
                        if (sel one.ok) { cleaned = true; }
                        if (sel one.err) {
                            val canceled: res[subprocess.SubprocessTerminal, subprocess.Error] = subprocess.cancel(a, ?processes[eidx], 0);
                            if (sel canceled.ok) { cleaned = true; }
                        }
                        if (cleaned) {
                            finalize_slot(a, ?processes[eidx], ?slots[sx], outcomes,
                                level, want_bytes, log_dir);
                        }
                        or {
                            subprocess.abandon_capture(?processes[eidx]);
                            subprocess.dnit(a, ?processes[eidx]);
                            outcomes[eidx].art       = slots[sx].art;
                            outcomes[eidx].done      = true;
                            outcomes[eidx].result    = btest.classify_wait_failure();
                            outcomes[eidx].code      = 0;
                            outcomes[eidx].elapsed   = 0;
                            outcomes[eidx].out       = nil;
                            outcomes[eidx].out_len   = 0;
                            outcomes[eidx].truncated = false;
                            outcomes[eidx].bound     = 0;
                        }
                        slots[sx].active = false;
                        inflight         = inflight - 1;
                        done             = done + 1;
                        fn_test(ctx, outcomes, arts, eidx);
                    }
                    sx = sx + 1;
                }
            }
            if (sel wr.ok) {
                val reaped: *subprocess.OwnedSubprocess =
                    wr.ok;
                var sx: u32 = 0;
                for (sx < window) {
                    if (slots[sx].active) {
                        val fidx: u32 = slots[sx].idx;
                        if (?processes[fidx] == reaped) {
                            finalize_slot(a, ?processes[fidx], ?slots[sx], outcomes,
                                level, want_bytes, log_dir);
                            slots[sx].active = false;
                            inflight         = inflight - 1;
                            done             = done + 1;
                            fn_test(ctx, outcomes, arts, fidx);
                            brk;
                        }
                    }
                    sx = sx + 1;
                }
            }
        }
    }

    if (has_source) { events.close(?source); }
    cnc.destroy(?scope);
}

rec HumanCtx {
    a:       *A.Allocator;
    level:   u8;
    mod_w:   usize;
    name_w:  usize;
    runner:  *u8;
    log_dir: *u8;
    n:       u32;
    cursor:  u32;
    first:   u32;
}

rec JsonCtx {
    a:       *A.Allocator;
    log_dir: *u8;
    n:       u32;
    w:       writer.Writer;
}

fun human_ctx_init(a: *A.Allocator, hc: *HumanCtx, level: u8, mod_w: usize, name_w: usize,
    runner: *u8, log_dir: *u8) {
    hc.a       = a;
    hc.level   = level;
    hc.mod_w   = mod_w;
    hc.name_w  = name_w;
    hc.runner  = runner;
    hc.log_dir = log_dir;
    hc.n       = 0;
    hc.cursor  = 0;
    hc.first   = 0;
}

fun human_start(hc: *HumanCtx, arts: *outcome.TestArtifact, n: u32) {
    hc.n      = n;
    hc.cursor = 0;
    hc.first  = 0;
}

fun human_test(hc: *HumanCtx, outcomes: *Outcome, arts: *outcome.TestArtifact, idx: u32) {
    for (hc.cursor < hc.n && outcomes[hc.cursor].done) {
        val c:        u32 = hc.cursor;
        val mod_name: str = arts[c].module;
        if (hc.level > 0 && c == hc.first) { print.printf("{}\n", mod_name); }
        if (hc.level > 0)                  { print_verbose_test(hc.a, ?outcomes[c], hc.name_w, hc.runner, hc.log_dir); }
        val last_of_module: bool = c + 1 == hc.n
            || !str_equals(arts[c + 1].module, mod_name);
        if (last_of_module) {
            if (hc.level == 0) { render_module_run(hc.a, outcomes, hc.first, c, mod_name, hc.mod_w, hc.runner, hc.log_dir); }
            hc.first = c + 1;
        }
        hc.cursor = c + 1;
    }
}

fun human_summary(hc: *HumanCtx, outcomes: *Outcome, n: u32, passed: u32, failed: u32,
    wall: du.Duration, tally: *outcome.GateTally) {
    render_summary(outcomes, n, passed, failed, wall, tally);
}

fun json_ctx_init(jc: *JsonCtx, a: *A.Allocator, log_dir: *u8) {
    jc.a       = a;
    jc.log_dir = log_dir;
    jc.n       = 0;
    jc.w       = fs.writer(fs.STDOUT);
}

fun json_event_begin(w: *writer.Writer, o: *json.Object, event: *u8) {
    json.object_begin(w, o);
    json.field_i64(o, "schema", SCHEMA_VERSION);
    json.field_str(o, "event", event);
}

fun json_start(jc: *JsonCtx, arts: *outcome.TestArtifact, n: u32) {
    jc.n = n;
    var o: json.Object;
    json_event_begin(?jc.w, ?o, "run_start");
    json.field_i64(?o, "tests", n::i64);
    json.object_end(?o);
}

fun json_test(jc: *JsonCtx, outcomes: *Outcome, arts: *outcome.TestArtifact, idx: u32) {
    val o0:  *Outcome              = ?outcomes[idx];
    val art: *outcome.TestArtifact = ?arts[idx];
    var o:   json.Object;
    json_event_begin(?jc.w, ?o, "test");
    json.field_str(?o, "name", art.name);
    json.field_str(?o, "module", art.module);
    json.field_str(?o, "file", art.file);
    json.field_i64(?o, "line", art.line::i64);
    json.field_str(?o, "kind", result_name(?o0.result));
    json.field_i64(?o, "code", o0.code::i64);
    json.field_i64(?o, "timeout_ns", du.duration_nsec(o0.bound));
    json.field_i64(?o, "duration_ns", du.duration_nsec(o0.elapsed));
    json.field_i64(?o, "index", art.idx::i64);
    json.field_str(?o, "exe", art.exe);
    if (has_capture(?o0.result)) {
        json.field_str_or_null(?o, "output", json_output_ref(jc, art.idx));
    }
    or {
        json.field_str_or_null(?o, "output", nil);
    }
    json.object_end(?o);
}

fun json_summary(jc: *JsonCtx, outcomes: *Outcome, n: u32, passed: u32, failed: u32,
    wall: du.Duration, tally: *outcome.GateTally) {
    var o: json.Object;
    json_event_begin(?jc.w, ?o, "summary");
    json.field_i64(?o, "passed", passed::i64);
    json.field_i64(?o, "failed", failed::i64);
    json.field_i64(?o, "total", n::i64);
    json.field_i64(?o, "duration_ns", du.duration_nsec(wall));
    json.field_i64(?o, "mismatch", tally.semantic_mismatch::i64);
    json.field_i64(?o, "unsupported", tally.unsupported_input::i64);
    json.field_i64(?o, "target_unavailable", tally.tool_unavailable::i64);
    json.field_i64(?o, "infrastructure_failure", tally.infrastructure_failure::i64);
    json.field_i64(?o, "resource_exhaustion", tally.resource_exhaustion::i64);
    json.field_i64(?o, "timed_out", count_timed_out(outcomes, n)::i64);
    json.field_i64(?o, "invalid_injection", tally.invalid_injection::i64);
    json.object_end(?o);
}

fun json_output_ref(jc: *JsonCtx, idx: u32) *u8 {
    val r: res[str, outcome.Fail] = log_path(jc.a, jc.log_dir, idx);
    if (sel r.err) { ret nil; }
    ret r.ok;
}

fun emit_list_case(w: *writer.Writer, art: *outcome.TestArtifact) {
    var o: json.Object;
    json_event_begin(w, ?o, "case");
    json.field_str(?o, "name", art.name);
    json.field_str(?o, "module", art.module);
    json.field_str(?o, "file", art.file);
    json.field_i64(?o, "line", art.line::i64);
    json.field_str(?o, "object", art.object);
    json.field_i64(?o, "index", art.idx::i64);
    json.object_end(?o);
}

fun result_name(r: *validation.ValidationGateResult) *u8 {
    if (r.kind == validation.RESULT_PASS)                                                                       { ret "pass"; }
    if (r.kind == validation.RESULT_SEMANTIC_MISMATCH && r.cause == validation.CAUSE_ORACLE_EXIT)               { ret "exit"; }
    if (r.kind == validation.RESULT_SEMANTIC_MISMATCH && r.cause == validation.CAUSE_ORACLE_SIGNAL)             { ret "signal"; }
    if (r.kind == validation.RESULT_INFRASTRUCTURE_FAILURE && r.cause == validation.CAUSE_ORACLE_SPAWN_FAILURE) { ret "spawn"; }
    if (r.kind == validation.RESULT_RESOURCE_EXHAUSTION && r.cause == validation.CAUSE_ORACLE_TIMEOUT)          { ret "timeout"; }
    ret "other";
}

fun has_capture(r: *validation.ValidationGateResult) bool {
    if (r.kind == validation.RESULT_SEMANTIC_MISMATCH)   { ret true; }
    if (r.kind == validation.RESULT_RESOURCE_EXHAUSTION) { ret true; }
    ret r.kind == validation.RESULT_INFRASTRUCTURE_FAILURE && r.cause != validation.CAUSE_ORACLE_SPAWN_FAILURE;
}

fun spawn_one(a: *A.Allocator, processes: *subprocess.OwnedSubprocess, slots: *Slot,
    window: u32, art: *outcome.TestArtifact, idx: u32, runner: *u8,
    log_dir: *u8, timeout: du.Duration) opt[validation.ValidationGateResult] {
    var s: u32 = 0;
    for (s < window && slots[s].active) { s = s + 1; }
    if (s == window) { ret opt[validation.ValidationGateResult].some{btest.classify_setup_failure()}; }

    val lp_r: res[str, outcome.Fail] = log_path(a, log_dir, art.idx);
    if (sel lp_r.err) { ret opt[validation.ValidationGateResult].some{btest.classify_setup_failure()}; }
    val lp: str = lp_r.ok;

    var ibuf: [16]u8;
    write_index(?ibuf[0], 16, art.idx);

    var child_argv: [4]*u8;
    if (runner != nil) {
        child_argv[0] = runner;
        child_argv[1] = art.exe;
        child_argv[2] = ?ibuf[0];
        child_argv[3] = nil;
    }
    or {
        child_argv[0] = art.exe;
        child_argv[1] = ?ibuf[0];
        child_argv[2] = nil;
    }

    val start: readout.Instant       = readout.sample();
    val res_c: err[subprocess.Error] = subprocess.spawn_captured_grouped(
        a, ?processes[idx], child_argv[0], ?child_argv[0], env.environ(), lp, CAP_OUTPUT);
    if (sel res_c.err) {
        val term:      subprocess.SubprocessTerminal = processes[idx].terminal;
        var empty_cap: subprocess.CaptureIoResult;
        empty_cap.bytes        = 0;
        empty_cap.truncated    = false;
        empty_cap.short_read   = false;
        empty_cap.read_failed  = false;
        empty_cap.write_failed = false;
        empty_cap.close_failed = false;
        empty_cap.closed       = false;
        empty_cap.owned        = false;
        val result: validation.ValidationGateResult = btest.classify_subprocess(?term, false, true, ?empty_cap);
        subprocess.dnit(a, ?processes[idx]);
        fs.remove_file(?lp[0]);
        ret opt[validation.ValidationGateResult].some{result};
    }

    if (timeout > 0) { subprocess.bound(?processes[idx], timeout); }

    slots[s].active = true;
    slots[s].art    = art;
    slots[s].idx    = idx;
    slots[s].start  = start;
    ret opt[validation.ValidationGateResult].none{};
}

fun finalize_slot(a: *A.Allocator, process: *subprocess.OwnedSubprocess, slot: *Slot,
    outcomes: *Outcome, level: u8, want_bytes: bool, log_dir: *u8) {
    var o: Outcome;
    o.art       = slot.art;
    o.done      = true;
    o.code      = 0;
    o.out       = nil;
    o.out_len   = 0;
    o.truncated = false;
    o.elapsed   = readout.elapsed(slot.start);

    val provisional_pass: bool = process.terminal.kind == subprocess.STATE_EXITED && process.terminal.code == 0;
    var retain:           bool = want_bytes;
    if (provisional_pass && level < 2) { retain = false; }

    val capture_r: res[subprocess.CaptureIoResult, subprocess.Error] = subprocess.finish_capture(a, process, retain);
    var cap_ok:    bool                                              = sel capture_r.ok;
    var capture:   subprocess.CaptureIoResult;
    capture.bytes        = 0;
    capture.truncated    = false;
    capture.short_read   = false;
    capture.read_failed  = false;
    capture.write_failed = false;
    capture.close_failed = false;
    capture.closed       = false;
    capture.owned        = false;
    if (sel capture_r.ok) {
        capture = capture_r.ok;
        if (retain) {
            o.out       = subprocess.capture_bytes(process, ?o.out_len);
            o.truncated = capture.truncated;
        }
    }

    o.bound = 0;
    if (subprocess.expired(process)) { o.bound = process.timeout; }
    o.result = btest.classify_subprocess(?process.terminal, subprocess.expired(process), cap_ok, ?capture);
    if (o.result.kind == validation.RESULT_SEMANTIC_MISMATCH) { o.code = process.terminal.code; }

    subprocess.dnit(a, process);
    if (o.result.kind == validation.RESULT_PASS) {
        val lp_r: res[str, outcome.Fail] = log_path(a, log_dir, slot.art.idx);
        if (sel lp_r.ok) { fs.remove_file(lp_r.ok); }
    }
    outcomes[slot.idx] = o;
}

fun render_module_run(a: *A.Allocator, outcomes: *Outcome, first: u32, last: u32, mod_name: str, mod_w: usize,
    runner: *u8, log_dir: *u8) {
    var ok:      u32         = 0;
    var fail:    u32         = 0;
    var elapsed: du.Duration = 0;
    var j:       u32         = first;
    for (j <= last) {
        if (outcomes[j].result.kind == validation.RESULT_PASS) { ok = ok + 1; }
        or                                                     { fail = fail + 1; }
        elapsed = elapsed + outcomes[j].elapsed;
        j       = j + 1;
    }

    print_rollup(mod_name, ok, fail, elapsed, mod_w);
    if (fail > 0) {
        j = first;
        for (j <= last) {
            if (outcomes[j].result.kind != validation.RESULT_PASS) { print_fail_detail(a, ?outcomes[j], runner, log_dir); }
            j = j + 1;
        }
    }
}

fun module_col_width(arts: *outcome.TestArtifact, n: u32) usize {
    var w: usize = 0;
    var i: u32   = 0;
    for (i < n) {
        val l: usize = str_len(arts[i].module);
        if (l > w) { w = l; }
        i = i + 1;
    }
    if (w < 16) { w = 16; }
    if (w > 48) { w = 48; }
    ret w + 2;
}

fun name_col_width(arts: *outcome.TestArtifact, n: u32) usize {
    var w: usize = 0;
    var i: u32   = 0;
    for (i < n) {
        val l: usize = str_len(arts[i].name);
        if (l > w) { w = l; }
        i = i + 1;
    }
    if (w < 24) { w = 24; }
    if (w > 72) { w = 72; }
    ret w + 2;
}

fun print_col(s: str, width: usize) {
    print.print(s);
    var pad: usize = 2;
    val l:   usize = str_len(s);
    if (l + 2 < width) { pad = width - l; }
    var i: usize = 0;
    for (i < pad) {
        print.print(" ");
        i = i + 1;
    }
}

fun print_dur(elapsed: du.Duration) {
    var dbuf: [24]u8;
    val ds:   str   = du.format_duration(elapsed, ?dbuf[0], 24::usize);
    val l:    usize = str_len(ds);
    print.print("  ");
    var i: usize = l;
    for (i < 7) {
        print.print(" ");
        i = i + 1;
    }
    print.print(ds);
}

fun print_rollup(mod_name: str, ok: u32, fail: u32, elapsed: du.Duration, mod_w: usize) {
    print_col(mod_name, mod_w);
    if (fail > 0) { print.printf("{:4} ok  {:4} FAIL", ok::i64, fail::i64); }
    or            { print.printf("{:4} ok", ok::i64); }
    print_dur(elapsed);
    print.print("\n");
}

fun print_fail_detail(a: *A.Allocator, o: *Outcome, runner: *u8, log_dir: *u8) {
    val name: str = o.art.name;
    print.printf("  FAIL  {}  {}:{}  ", name, o.art.file, o.art.line::i64);
    print_reason(o);
    print.print("\n");
    print_captured(o);
    print_fail_pointers(a, o, runner, log_dir);
}

fun print_fail_pointers(a: *A.Allocator, o: *Outcome, runner: *u8, log_dir: *u8) {
    if (o.truncated) {
        val lp_r: res[str, outcome.Fail] = log_path(a, log_dir, o.art.idx);
        if (sel lp_r.ok) {
            print.printf("    full output: {}\n", lp_r.ok);
        }
    }
    print.print("    rerun: ");
    if (runner != nil) {
        print.print(runner::str);
        print.print(" ");
    }
    print.print(o.art.exe::str);
    print.print(" ");
    print.u64(o.art.idx::u64);
    print.print("\n");
}

fun print_verbose_test(a: *A.Allocator, o: *Outcome, name_w: usize, runner: *u8, log_dir: *u8) {
    val name: str = o.art.name;
    if (o.result.kind == validation.RESULT_PASS) {
        print.print("  ok    ");
        print_col(name, name_w);
        print_dur(o.elapsed);
        print.print("\n");
        print_captured(o);
    }
    or {
        print.print("  FAIL  ");
        print_col(name, name_w);
        print_dur(o.elapsed);
        print.print("  ");
        print_reason(o);
        print.printf("  {}:{}\n", o.art.file, o.art.line::i64);
        print_captured(o);
        print_fail_pointers(a, o, runner, log_dir);
    }
}

fun print_reason(o: *Outcome) {
    if (o.result.kind == validation.RESULT_RESOURCE_EXHAUSTION && o.result.cause == validation.CAUSE_ORACLE_TIMEOUT) {
        val t: duration.Text = duration.text(o.bound);
        print.printf("(timed out after {}{})", t.n, t.unit);
    }
    or (o.result.kind == validation.RESULT_SEMANTIC_MISMATCH && o.result.cause == validation.CAUSE_ORACLE_EXIT) {
        print.printf("(exit {})", o.code::i64);
    }
    or (o.result.kind == validation.RESULT_SEMANTIC_MISMATCH && o.result.cause == validation.CAUSE_ORACLE_SIGNAL) {
        print.printf("(signal {})", o.code::i64);
    }
    or (o.result.kind == validation.RESULT_INFRASTRUCTURE_FAILURE && o.result.cause == validation.CAUSE_ORACLE_SPAWN_FAILURE) {
        print.print("(spawn failed)");
    }
    or (o.result.kind == validation.RESULT_INFRASTRUCTURE_FAILURE && o.result.cause == validation.CAUSE_ORACLE_CAPTURE) {
        print.print("(capture failed)");
    }
    or (o.result.kind == validation.RESULT_INFRASTRUCTURE_FAILURE && o.result.cause == validation.CAUSE_INVALID_TERMINAL) {
        print.print("(runner failed)");
    }
    or { print.print("(failed)"); }
}

fun print_captured(o: *Outcome) {
    if (o.out == nil || o.out_len == 0) {
        if (o.truncated) { print.print("    ... (output truncated)\n"); }
        ret;
    }

    var w: writer.Writer;
    w = fs.writer(fs.STDOUT);

    var i:   usize = 0;
    var seg: usize = 0;
    for (i < o.out_len) {
        if (o.out[i] == '\n') {
            fmt.write_str(?w, "    ");
            fmt.write_bytes(?w, (o.out::usize + seg)::*u8, i - seg + 1::usize);
            seg = i + 1::usize;
        }
        i = i + 1;
    }
    if (seg < o.out_len) {
        fmt.write_str(?w, "    ");
        fmt.write_bytes(?w, (o.out::usize + seg)::*u8, o.out_len - seg);
        fmt.write_newline(?w);
    }
    if (o.truncated) { fmt.write_str(?w, "    ... (output truncated)\n"); }
}

fun render_summary(outcomes: *Outcome, len: u32, passed: u32, failed: u32, wall: du.Duration, tally: *outcome.GateTally) {
    print.print("\n");

    if (failed > 0) {
        print.print("failures:\n");
        var i: u32 = 0;
        for (i < len) {
            if (outcomes[i].result.kind != validation.RESULT_PASS) {
                print.printf("  {}  {}:{}  ",
                    outcomes[i].art.name,
                    outcomes[i].art.file,
                    outcomes[i].art.line::i64);
                print_reason(?outcomes[i]);
                print.print("\n");
            }
            i = i + 1;
        }
        print.print("\n");
    }

    var dbuf:      [24]u8;
    val ds:        str = du.format_duration(wall, ?dbuf[0], 24::usize);
    val timed_out: u32 = count_timed_out(outcomes, len);
    if (timed_out > 0) {
        print.printf("{} passed, {} failed ({} timed out), {} total  ({})\n",
            passed::i64, failed::i64, timed_out::i64, len::i64, ds);
    }
    or {
        print.printf("{} passed, {} failed, {} total  ({})\n", passed::i64, failed::i64, len::i64, ds);
    }

    val extra_infra: u32 = tally.unsupported_input + tally.tool_unavailable
        + tally.resource_exhaustion + tally.invalid_injection;
    if (extra_infra > 0) {
        print.printf("  unsupported {}, target unavailable {}, resource exhaustion {}, invalid injection {}\n",
            tally.unsupported_input::i64, tally.tool_unavailable::i64,
            tally.resource_exhaustion::i64, tally.invalid_injection::i64);
    }
}

fun count_failed(outcomes: *Outcome, len: u32) u32 {
    var f: u32 = 0;
    var i: u32 = 0;
    for (i < len) {
        if (outcomes[i].result.kind != validation.RESULT_PASS) { f = f + 1; }
        i = i + 1;
    }
    ret f;
}

# a listed test: its qualified name and the test object that holds it
fun artifact_report(art: *outcome.TestArtifact) {
    print.print(art.name::str);
    print.print(" ");
    print.print(art.object::str);
}

fun write_index(buf: *u8, cap: usize, n: u32) {
    var tmp: [16]u8;
    var t:   usize = 0;
    var v:   u32   = n;
    if (v == 0) {
        tmp[0] = '0';
        t      = 1;
    }
    for (v > 0) {
        tmp[t] = (v % 10)::u8 + '0';
        v      = v / 10;
        t      = t + 1;
    }
    var k: usize = 0;
    for (k < t && k + 1 < cap) {
        buf[k] = tmp[t - 1 - k];
        k      = k + 1;
    }
    buf[k] = 0;
}

fun parse_count(s: *u8) i64 {
    if (s == nil || s[0] == 0) { ret -1; }
    var v: i64   = 0;
    var i: usize = 0;
    for (s[i] != 0) {
        if (s[i] < '0' || s[i] > '9') { ret -1; }
        v = v * 10 + (s[i] - '0')::i64;
        if (v > 65536) { ret -1; }
        i = i + 1;
    }
    ret v;
}

fun capture_log_dir(a: *A.Allocator, exe: *u8) res[str, outcome.Fail] {
    val dir_r: res[str, A.Error] = path.parent(a, exe::str);
    if (sel dir_r.err) { ret res[str, outcome.Fail].err{outcome.refused(dir_r.err)}; }
    val join_r: res[path.Path, A.Error] = path.join(a, dir_r.ok, "log");
    if (sel join_r.err) { ret res[str, outcome.Fail].err{outcome.refused(join_r.err)}; }
    ret res[str, outcome.Fail].ok{join_r.ok};
}

fun log_path(a: *A.Allocator, log_dir: *u8, idx: u32) res[str, outcome.Fail] {
    var leaf: [24]u8;
    write_index(?leaf[0], 16, idx);
    var k: usize = str_len(?leaf[0]);
    leaf[k]     = '.';
    leaf[k + 1] = 'l';
    leaf[k + 2] = 'o';
    leaf[k + 3] = 'g';
    leaf[k + 4] = 0;
    val join_r: res[path.Path, A.Error] = path.join(a, log_dir::str, (?leaf[0])::str);
    if (sel join_r.err) { ret res[str, outcome.Fail].err{outcome.refused(join_r.err)}; }
    ret res[str, outcome.Fail].ok{join_r.ok};
}

# the log directory, which the build owns beside the dispatcher, exists and
# holds no log from an earlier run
fun prepare_logs(a: *A.Allocator, log_dir: *u8, total: u32) err[outcome.Fail] {
    val owner_r: res[str, A.Error] = path.parent(a, log_dir::str);
    if (sel owner_r.err) { ret err[outcome.Fail].err{outcome.refused(owner_r.err)}; }
    val made: err[outcome.Fail] = output.directory(a, owner_r.ok, log_dir::str);
    str_free(a, owner_r.ok);
    if (sel made.err) { ret made; }
    var idx: u32 = 0;
    for (idx < total) {
        val lp_r: res[str, outcome.Fail] = log_path(a, log_dir, idx);
        if (sel lp_r.ok) { fs.remove_file(lp_r.ok); }
        idx = idx + 1;
    }
    ret err[outcome.Fail].ok{};
}

#[testing]
fun t_outcome(kind: validation.ValidationGateResultKind, cause: validation.ValidationCause) Outcome {
    var art: outcome.TestArtifact;
    art.module = "m";
    art.name   = "l";
    art.file   = "f.mach";
    art.line   = 1;
    art.exe    = nil;
    art.idx    = 0;

    var o: Outcome;
    o.art       = ?art;
    o.done      = true;
    o.result    = validation.gate_result(kind, cause, nil);
    o.code      = 0;
    o.elapsed   = 0;
    o.out       = nil;
    o.out_len   = 0;
    o.truncated = false;
    o.bound     = 0;
    ret o;
}

test result_name_and_has_capture__cover_every_classified_shape {
    var bad: i32 = 0;

    var pass: Outcome = t_outcome(validation.RESULT_PASS, validation.CAUSE_PASS);
    if (!str_equals(result_name(?pass.result), "pass")) { bad = 1; }
    if (has_capture(?pass.result))                      { bad = 1; }

    var ex: Outcome = t_outcome(validation.RESULT_SEMANTIC_MISMATCH, validation.CAUSE_ORACLE_EXIT);
    if (!str_equals(result_name(?ex.result), "exit")) { bad = 1; }
    if (!has_capture(?ex.result))                     { bad = 1; }

    var sig: Outcome = t_outcome(validation.RESULT_SEMANTIC_MISMATCH, validation.CAUSE_ORACLE_SIGNAL);
    if (!str_equals(result_name(?sig.result), "signal")) { bad = 1; }
    if (!has_capture(?sig.result))                       { bad = 1; }

    var spawn: Outcome = t_outcome(validation.RESULT_INFRASTRUCTURE_FAILURE, validation.CAUSE_ORACLE_SPAWN_FAILURE);
    if (!str_equals(result_name(?spawn.result), "spawn")) { bad = 1; }
    if (has_capture(?spawn.result))                       { bad = 1; }

    var cap: Outcome = t_outcome(validation.RESULT_INFRASTRUCTURE_FAILURE, validation.CAUSE_ORACLE_CAPTURE);
    if (!str_equals(result_name(?cap.result), "other")) { bad = 1; }
    if (!has_capture(?cap.result))                      { bad = 1; }

    var wait: Outcome = t_outcome(validation.RESULT_INFRASTRUCTURE_FAILURE, validation.CAUSE_INVALID_TERMINAL);
    if (!str_equals(result_name(?wait.result), "other")) { bad = 1; }
    if (!has_capture(?wait.result))                      { bad = 1; }

    var late: Outcome = t_outcome(validation.RESULT_RESOURCE_EXHAUSTION, validation.CAUSE_ORACLE_TIMEOUT);
    if (!str_equals(result_name(?late.result), "timeout")) { bad = 1; }
    if (!has_capture(?late.result))                        { bad = 1; }

    ret bad;
}

test count_failed_and_build_gate_tally__only_pass_counts_as_passing {
    var a: A.Allocator;
    page.make(?a);

    var outcomes: [3]Outcome;
    outcomes[0] = t_outcome(validation.RESULT_PASS, validation.CAUSE_PASS);
    outcomes[1] = t_outcome(validation.RESULT_SEMANTIC_MISMATCH, validation.CAUSE_ORACLE_EXIT);
    outcomes[2] = t_outcome(validation.RESULT_TOOL_UNAVAILABLE, validation.CAUSE_TOOL_UNAVAILABLE);

    if (count_failed(?outcomes[0], 3) != 2) { ret 1; }

    var gt: outcome.GateTally = outcome.gate_tally_init(?a);
    build_gate_tally(?gt, ?a, ?outcomes[0], 3);

    var bad: i32 = 0;
    if (gt.pass != 1)                       { bad = 1; }
    or (gt.semantic_mismatch != 1)          { bad = 1; }
    or (gt.tool_unavailable != 1)           { bad = 1; }
    or (outcome.gate_tally_total(?gt) != 3) { bad = 1; }

    outcome.gate_tally_dnit(?gt);
    ret bad;
}

test exit_code__infrastructure_failure_dominates_ordinary_test_failure {
    var a: A.Allocator;
    page.make(?a);

    var clean: outcome.GateTally = outcome.gate_tally_init(?a);
    if (exit_code(0, ?clean) != 0) { ret 1; }
    outcome.gate_tally_dnit(?clean);

    var only_failed: outcome.GateTally = outcome.gate_tally_init(?a);
    if (exit_code(3, ?only_failed) != 1) { ret 2; }
    outcome.gate_tally_dnit(?only_failed);

    var infra: outcome.GateTally = outcome.gate_tally_init(?a);
    if (alloc.refused(outcome.record_gate(?infra, ?a,
        validation.gate_result(validation.RESULT_INFRASTRUCTURE_FAILURE, validation.CAUSE_ORACLE_CAPTURE, nil)))) { ret 3; }
    if (exit_code(0, ?infra) != 2) { ret 4; }
    if (exit_code(5, ?infra) != 2) { ret 5; }
    outcome.gate_tally_dnit(?infra);

    ret 0;
}

#[testing]
fun t_test(argc: usize, argv: **u8) i64 {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 2; }
    val ir: res[args.ParsedInvocation, outcome.Fail] = args.parse_invocation(?a, argc, argv);
    if (sel ir.err) { ret 2; }
    var inv: args.ParsedInvocation = ir.ok;
    ret run(argv, ?inv);
}

test run__rejects_emit_before_effects {
    var no_value: [3]*u8 = [3]*u8{"mach", "test", "--emit"};
    if (t_test(3, ?no_value[0]) != 1) { ret 1; }
    var with_value: [5]*u8 = [5]*u8{"mach", "test", ".", "--emit", "obj"};
    if (t_test(5, ?with_value[0]) != 1) { ret 2; }
    ret 0;
}

#[testing]
fun t_temp_name(a: *A.Allocator) str {
    val tf_r: res[fs.TempFile, fs.FsError] = fs.temp_create(a, "mach_test_timeout");
    if (sel tf_r.err) { ret ""; }
    var tf:    fs.TempFile       = tf_r.ok;
    val dup_r: res[str, A.Error] = str_dup(a, fs.temp_path(?tf));
    fs.temp_close_and_remove(?tf);
    if (sel dup_r.err) { ret ""; }
    ret dup_r.ok;
}

#[testing]
rec TimeoutProbe {
    script:  str;
    log_dir: str;
    outcome: Outcome;
}

#[testing]
fun t_probe_free(a: *A.Allocator, pr: *TimeoutProbe) {
    if (str_len(pr.script) > 0) {
        fs.remove_file(pr.script);
        str_free(a, pr.script);
    }
    if (str_len(pr.log_dir) > 0) {
        fs.remove_all(a, pr.log_dir);
        str_free(a, pr.log_dir);
    }
    pr.script  = "";
    pr.log_dir = "";
}

# runs one test process through the real spawn, wait and finalize chain
#[testing]
fun t_run_one_bounded(a: *A.Allocator, body: str, timeout: du.Duration, pr: *TimeoutProbe) i32 {
    pr.script  = t_temp_name(a);
    pr.log_dir = t_temp_name(a);
    if (str_len(pr.script) == 0 || str_len(pr.log_dir) == 0) { ret 1; }
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(pr.script, body::*u8, str_len(body), 0o600);
    if (sel write_bytes_r.err) { ret 2; }
    val create_dir_r: err[io_error.Error] = fs.create_dir(pr.log_dir, 0o700);
    if (sel create_dir_r.err) { ret 3; }

    var art: outcome.TestArtifact;
    art.module = "mach.timeout.probe";
    art.name   = "probe";
    art.file   = "probe.mach";
    art.line   = 1;
    art.exe    = pr.script::*u8;
    art.idx    = 0;

    var process: subprocess.OwnedSubprocess;
    subprocess.init(?process);
    var slot: Slot;
    slot.active = false;

    val spawn_fail: opt[validation.ValidationGateResult] = spawn_one(a, ?process, ?slot, 1, ?art, 0, "/bin/sh"::*u8, pr.log_dir::*u8, timeout);
    if (sel spawn_fail.some) { ret 4; }

    val wr: res[*subprocess.OwnedSubprocess, subprocess.Error] = subprocess.wait_any(a, ?process, 1, nil, nil);
    if (sel wr.err) {
        subprocess.cancel(a, ?process, 0);
        subprocess.dnit(a, ?process);
        ret 5;
    }
    var outcomes: [1]Outcome;
    finalize_slot(a, ?process, ?slot, ?outcomes[0], 0, true, pr.log_dir::*u8);
    pr.outcome = outcomes[0];
    ret 0;
}

test run_one__a_test_past_its_bound_is_timed_out {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }

    var pr: TimeoutProbe;
    pr.script  = "";
    pr.log_dir = "";
    val setup: i32 = t_run_one_bounded(?a, "sleep 30\n", du.SECOND, ?pr);
    var bad:   i32 = 0;
    if (setup != 0) { bad = 10 + setup; }
    or {
        val o: *Outcome = ?pr.outcome;
        if (o.result.kind != validation.RESULT_RESOURCE_EXHAUSTION) { bad = 4; }
        or (o.result.cause != validation.CAUSE_ORACLE_TIMEOUT)      { bad = 5; }
        or (o.bound != du.SECOND)                                   { bad = 6; }
        or (!str_equals(result_name(?o.result), "timeout"))         { bad = 7; }
        or {
            var one: [1]Outcome;
            one[0] = @o;
            if (count_timed_out(?one[0], 1) != 1) { bad = 8; }
            or (count_failed(?one[0], 1) != 1)    { bad = 9; }
            or {
                var tally: outcome.GateTally = outcome.gate_tally_init(?a);
                build_gate_tally(?tally, ?a, ?one[0], 1);
                if (exit_code(1, ?tally) != 1) { bad = 20; }
                outcome.gate_tally_dnit(?tally);
            }
        }
    }
    t_probe_free(?a, ?pr);
    ret bad;
}

test run_one__an_unbounded_test_that_sleeps_briefly_still_passes {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }

    var pr: TimeoutProbe;
    pr.script  = "";
    pr.log_dir = "";
    val setup: i32 = t_run_one_bounded(?a, "sleep 1\nexit 0\n", 0, ?pr);
    var bad:   i32 = 0;
    if (setup != 0) { bad = 10 + setup; }
    or {
        val o: *Outcome = ?pr.outcome;
        if (o.result.kind != validation.RESULT_PASS) { bad = 2; }
        or (o.bound != 0)                            { bad = 3; }
        or {
            var one: [1]Outcome;
            one[0] = @o;
            if (count_timed_out(?one[0], 1) != 0) { bad = 4; }
            or {
                var tally: outcome.GateTally = outcome.gate_tally_init(?a);
                build_gate_tally(?tally, ?a, ?one[0], 1);
                if (exit_code(0, ?tally) != 0) { bad = 5; }
                outcome.gate_tally_dnit(?tally);
            }
        }
    }
    t_probe_free(?a, ?pr);
    ret bad;
}

test run_one__a_test_that_beats_its_bound_keeps_its_own_outcome {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }

    var pr: TimeoutProbe;
    pr.script  = "";
    pr.log_dir = "";
    val setup: i32 = t_run_one_bounded(?a, "exit 4\n", du.SECOND * 30, ?pr);
    var bad:   i32 = 0;
    if (setup != 0) { bad = 10 + setup; }
    or {
        val o: *Outcome = ?pr.outcome;
        if (o.result.kind != validation.RESULT_SEMANTIC_MISMATCH) { bad = 2; }
        or (o.result.cause != validation.CAUSE_ORACLE_EXIT)       { bad = 3; }
        or (o.code != 4)                                          { bad = 4; }
        or (o.bound != 0)                                         { bad = 5; }
    }
    t_probe_free(?a, ?pr);
    ret bad;
}
