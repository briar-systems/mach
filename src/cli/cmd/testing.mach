val CAP_OUTPUT: usize = 65536;

# `mach test`: build the project's test dispatcher and run the collected tests. `-O1` and
# `--emit` are refused; `--list` prints the collected tests and stops; `--format json`
# writes the machine-readable event stream; `--filter`, `--runner`, `--timeout`,
# and `--jobs` shape the run; `-o` names the dispatcher binary the way `mach build -o`
# names a built one, inside the project root, so runs in one tree with different `-o`
# do not collide
# ---
# argv: the full process arguments
# inv:  the parsed invocation for this command
# ret:  exit.OK when every test passed, exit.USER for at least one failed test, exit.INTERNAL
#       for an infrastructure failure, otherwise the code `exit.of` maps the printed failure to
pub fun run(argv: **u8, inv: *args.ParsedInvocation) i64 {
    val format_r: res[cli_diagnostic.Format, fail.Fail] = args.diagnostics_format(args.CMD_TEST, inv, argv);
    if (sel format_r.err) { ret cli_diagnostic.refuse(format_r.err); }
    var r: cli_diagnostic.Report;
    cli_diagnostic.report_init(?r, format_r.ok);
    ret cli_diagnostic.report_close(?r, run_reported(?r, argv, inv));
}

fun run_reported(r: *cli_diagnostic.Report, argv: **u8, inv: *args.ParsedInvocation) i64 {
    val cmd: args.CommandId = args.CMD_TEST;

    if (util.flag_exists(inv.argc, argv, "--emit")) {
        ret cli_diagnostic.report_fail(r, fail.user(diagnostic_kind.CLI_FLAG_INAPPLICABLE, "--emit is not applicable to 'test'; test always builds its internal test dispatcher"), diagnostic.ORIGIN_NONE);
    }

    var backing: A.Allocator;
    val make_r:  err[A.Error] = page.make(?backing);
    if (sel make_r.err) { ret cli_diagnostic.report_fail(r, fail.refused(make_r.err), diagnostic.ORIGIN_NONE); }
    var ar:     arena.Arena;
    val init_r: err[A.Error] = arena.init(?ar, ?backing, 0);
    if (sel init_r.err) { ret cli_diagnostic.report_fail(r, fail.refused(init_r.err), diagnostic.ORIGIN_NONE); }
    fin { arena.dnit(?ar); }
    var a:       A.Allocator;
    val make_r2: err[A.Error] = arena.make(?a, ?ar);
    if (sel make_r2.err) { ret cli_diagnostic.report_fail(r, fail.refused(make_r2.err), diagnostic.ORIGIN_NONE); }

    val res_cfg: res[args.CliArgs, fail.Fail] = args.build_cli_invocation(?a, cmd, inv, argv);
    if (sel res_cfg.err) { ret cli_diagnostic.report_fail(r, res_cfg.err, diagnostic.ORIGIN_NONE); }
    var config: args.CliArgs = res_cfg.ok;

    val list:        bool           = args.invocation_flag(cmd, inv, "--list");
    val opt_format:  opt[*u8]       = args.invocation_value(cmd, inv, argv, "--format");
    val opt_filter:  opt[*u8]       = args.invocation_value(cmd, inv, argv, "--filter");
    val opt_runner:  opt[*u8]       = args.invocation_value(cmd, inv, argv, "--runner");
    val opt_timeout: opt[*u8]       = args.invocation_value(cmd, inv, argv, "--timeout");
    val unknown:     opt[fail.Fail] = args.unknown_flag(?a, inv, argv, "mach test");
    if (sel unknown.some) { ret cli_diagnostic.report_fail(r, unknown.some, diagnostic.ORIGIN_NONE); }

    val level: u8 = config.verbosity;

    var json_out: bool = false;
    if (sel opt_format.some) {
        val fv: str = opt_format.some::str;
        if (str_equals(fv, "json"))  { json_out = true; }
        or (str_equals(fv, "human")) { json_out = false; }
        or {
            ret cli_diagnostic.report_fail(r, fail.user(diagnostic_kind.CLI_FLAG_VALUE, "--format expects 'human' or 'json'"), diagnostic.ORIGIN_NONE);
        }
    }

    var timeout: chrono_duration.Duration = 0;
    if (sel opt_timeout.some) {
        val tv: opt[chrono_duration.Duration] = duration.parse(opt_timeout.some);
        if (sel tv.none) {
            val said: res[str, std_format.FormatError] = std_format.sprint(?a, "--timeout expects {}", duration.FORMS);
            if (sel said.err) { ret cli_diagnostic.report_fail(r, fail.message("out of memory"), diagnostic.ORIGIN_NONE); }
            ret cli_diagnostic.report_fail(r, fail.user(diagnostic_kind.CLI_FLAG_VALUE, said.ok), diagnostic.ORIGIN_NONE);
        }
        timeout = tv.some;
    }

    var jobs: u32 = 1;
    if (config.jobs != nil) {
        val jv: i64 = parse_count(config.jobs);
        if (jv < 1) {
            ret cli_diagnostic.report_fail(r, fail.user(diagnostic_kind.CLI_FLAG_VALUE, "--jobs expects a positive integer"), diagnostic.ORIGIN_NONE);
        }
        jobs = jv::u32;
    }
    or {
        val nc: i64 = system_os.cpu_count();
        if (nc > 1) { jobs = nc::u32; }
    }

    var root_arg: *u8 = nil;
    if (inv.has_positional) { root_arg = argv[inv.positional_idx]; }

    val loc_r: res[util.ProjectLocation, fail.Fail] = util.resolve_project_location(?a, root_arg);
    if (sel loc_r.err) { ret cli_diagnostic.report_fail(r, loc_r.err, diagnostic.ORIGIN_NONE); }
    val loc:  util.ProjectLocation = loc_r.ok;
    val root: str                  = loc.root;
    r.root = root;

    val col_r: err[fail.Fail] = args.collect_link_inputs(?a, ?config, cmd, inv, argv);
    if (sel col_r.err) { ret cli_diagnostic.report_fail(r, col_r.err, diagnostic.ORIGIN_NONE); }

    var goal: request.BuildGoal = request.GOAL_TESTS;
    if (list) { goal = request.GOAL_TEST_LIST; }

    var ps:     session.Session;
    val plan_r: res[build.Planned, fail.Fail] = build.plan_invocation(?a, root, ?config, goal,
        manifest.ARTIFACT_DEFAULT_ONE, false, ?ps);
    if (sel plan_r.err) { ret cli_diagnostic.report_fail(r, plan_r.err, diagnostic.ORIGIN_BUILD); }
    var planned: build.Planned = plan_r.ok;
    if (sel opt_runner.some && planned.cells.len != 1) {
        val msg: str = manifest.single_selection_msg(?a, "--runner launches the tests of one selection", ?planned.cells);
        session.dnit(?ps);
        ret cli_diagnostic.report_fail(r, fail.user(diagnostic_kind.SELECTION_AMBIGUOUS, msg), diagnostic.ORIGIN_NONE);
    }

    # every selected combination is built before any test runs, and none runs
    # when one failed to build
    var collected: Vector[outcome.TestArtifact] = collections_vector.init[outcome.TestArtifact](?a);
    var built:     i64                          = exit.OK;
    var pi:        usize                        = 0;
    for (pi < planned.plans.len) {
        val bp: *build_plan.BuildPlan = ?planned.plans.data[pi];
        pi = pi + 1;
        # the filter selects the tests the dispatcher is linked over
        if (sel opt_filter.some) { bp.request.test_filter = opt_filter.some::str; }

        build.announce_profile(r, ?planned, bp, config.quiet);
        var rd: cli_diagnostic.Readout;
        cli_diagnostic.readout_init(?rd, r, bp.units.len, config.quiet, level);
        val ex_r: res[outcome.BuildOutcome, fail.Fail] = engine.execute(bp, ?backing, ?a, ?rd.sink);
        cli_diagnostic.readout_close(?rd);
        if (sel ex_r.err) {
            session.dnit(?ps);
            ret cli_diagnostic.report_fail(r, ex_r.err, diagnostic.ORIGIN_BUILD);
        }
        var bo: outcome.BuildOutcome = ex_r.ok;
        if (bo.severity != outcome.BUILD_OK) {
            built = exit.worst(built, cli_diagnostic.outcome_code(?bo));
            cnt;
        }
        var ti: usize = 0;
        for (ti < bo.tests.len) {
            val pushed: res[usize, A.Error] = collections_vector.push[outcome.TestArtifact](?collected, bo.tests.data[ti]);
            if (sel pushed.err) {
                session.dnit(?ps);
                ret cli_diagnostic.report_fail(r, fail.refused(pushed.err), diagnostic.ORIGIN_TEST);
            }
            ti = ti + 1;
        }
    }
    session.dnit(?ps);
    if (built != exit.OK) { ret built; }

    var groups: Vector[Group] = group_cells(?a, ?planned.cells);
    val many:   bool          = groups.len > 1;

    if (list) {
        var lw: io_writer.Writer;
        if (json_out) { lw = fs.writer(fs.STDOUT); }
        var gi: usize = 0;
        for (gi < groups.len) {
            val g:   *Group                       = ?groups.data[gi];
            var run: Vector[outcome.TestArtifact] = group_tests(?a, g, ?collected);
            if (many && !json_out) { print.printf("{} ({}):\n", g.target, g.profile); }
            var i: usize = 0;
            for (i < run.len) {
                if (json_out) { emit_list_case(?lw, ?run.data[i]); }
                or {
                    artifact_report(?run.data[i]);
                    print.print("\n");
                }
                i = i + 1;
            }
            gi = gi + 1;
        }
        ret exit.OK;
    }

    var runner: *u8 = nil;
    if (sel opt_runner.some) {
        val name:        *u8                 = opt_runner.some;
        val res_resolve: res[*u8, fail.Fail] = util.resolve_cmd(?a, name);
        if (sel res_resolve.err) {
            val said: res[str, std_format.FormatError] = std_format.sprint(?a, "--runner '{}': {}", name::str, fail.describe(res_resolve.err));
            if (sel said.err) { ret cli_diagnostic.report_fail(r, fail.message("out of memory"), diagnostic.ORIGIN_TEST); }
            ret cli_diagnostic.report_fail(r, fail.with_text(res_resolve.err, said.ok), diagnostic.ORIGIN_TEST);
        }
        runner = res_resolve.ok;
    }

    # a (target, profile) whose programs the host cannot run is built and not run;
    # only --runner, over a single selection, launches it anyway
    var code:     i64   = exit.OK;
    var executed: u32   = 0;
    var gi:       usize = 0;
    for (gi < groups.len) {
        val g: *Group = ?groups.data[gi];
        gi = gi + 1;
        if (!g.native && runner == nil) {
            report_skip(?a, g, json_out);
            cnt;
        }
        executed = executed + 1;
        if (many && !json_out) { print.printf("{} ({}):\n", g.target, g.profile); }
        var run: Vector[outcome.TestArtifact] = group_tests(?a, g, ?collected);
        code = exit.worst(code, run_group(?a, r, ?run, runner, level, jobs, timeout, json_out));
    }
    if (executed == 0) {
        val said: res[str, std_format.FormatError] = std_format.sprint(?a,
            "nothing was runnable on this host ({}): every selected target's os or isa differs from the host's, so its tests were built and not run; select a target native to this host with -t, or pass --runner for a single selection",
            manifest.host_tuple(?a));
        if (sel said.err) { ret cli_diagnostic.report_fail(r, fail.message("out of memory"), diagnostic.ORIGIN_TEST); }
        ret cli_diagnostic.report_fail(r, fail.user(diagnostic_kind.TARGET_NOT_RUNNABLE, said.ok), diagnostic.ORIGIN_TEST);
    }
    ret code;
}

# the tests of one (target, profile), from every artifact the selection built there
# ---
# target:  the declared target name
# profile: the profile name
# native:  the target's os and isa are the host's
rec Group {
    target:  str;
    profile: str;
    native:  bool;
}

# the (target, profile) pairs the cells cover, in cell order
fun group_cells(a: *A.Allocator, cells: *Vector[manifest.Cell]) Vector[Group] {
    var groups: Vector[Group] = collections_vector.init[Group](a);
    var i:      usize         = 0;
    for (i < cells.len) {
        val c:    *manifest.Cell = ?cells.data[i];
        var seen: bool           = false;
        var j:    usize          = 0;
        for (j < groups.len) {
            if (str_equals(groups.data[j].target, c.target_name) && str_equals(groups.data[j].profile, c.profile)) { seen = true; }
            j = j + 1;
        }
        if (!seen) { collections_vector.push[Group](?groups, Group{target: c.target_name, profile: c.profile, native: c.native}); }
        i = i + 1;
    }
    ret groups;
}

# the group's tests, each qualified name once: a test several selected artifacts
# reach runs from the first artifact's dispatcher
fun group_tests(a: *A.Allocator, g: *Group, tests: *Vector[outcome.TestArtifact]) Vector[outcome.TestArtifact] {
    var run: Vector[outcome.TestArtifact] = collections_vector.init[outcome.TestArtifact](a);
    var i:   usize                        = 0;
    for (i < tests.len) {
        val t: *outcome.TestArtifact = ?tests.data[i];
        if (str_equals(t.target::str, g.target) && str_equals(t.profile::str, g.profile)) {
            var dup: bool  = false;
            var j:   usize = 0;
            for (j < run.len) {
                if (str_equals(run.data[j].name::str, t.name::str)) { dup = true; }
                j = j + 1;
            }
            if (!dup) { collections_vector.push[outcome.TestArtifact](?run, @t); }
        }
        i = i + 1;
    }
    ret run;
}

# one line naming a (target, profile) that was built and not run, and why
fun report_skip(a: *A.Allocator, g: *Group, json_out: bool) {
    if (json_out) {
        var w: io_writer.Writer = fs.writer(fs.STDOUT);
        var o: json.Object;
        cli_diagnostic.event_begin(?w, ?o, "skip");
        json.field_str(?o, "target", g.target::*u8);
        json.field_str(?o, "profile", g.profile::*u8);
        json.field_str(?o, "reason", "not native to this host");
        json.object_end(?o);
        ret;
    }
    print.printf("skip  {} ({}): not native to this host ({}); built, not run\n",
        g.target, g.profile, manifest.host_tuple(a));
}

# run one (target, profile)'s tests, each reported to the run's renderer as it
# finishes, and close the run with its summary
# ---
# ret: exit.OK when every test passed, exit.USER for a failed test, exit.INTERNAL
#      for an infrastructure failure
fun run_group(a: *A.Allocator, r: *cli_diagnostic.Report, tests: *Vector[outcome.TestArtifact], runner: *u8,
    level: u8, jobs: u32, timeout: chrono_duration.Duration, json_out: bool) i64 {
    var rd: cli_diagnostic.Readout;
    cli_diagnostic.readout_init(?rd, r, 1, false, level);
    if (json_out) { rd.stream = cli_diagnostic.FORMAT_JSON; }

    val arts: *outcome.TestArtifact = tests.data;
    val n:    u32                   = tests.len::u32;
    if (n == 0) {
        var empty_tally: outcome.GateTally = outcome.gate_tally_init(a);
        readout.run_start(?rd.sink, nil, 0, runner::str);
        readout.run_end(?rd.sink, readout.RunEnd{tests: nil, count: 0, passed: 0, failed: 0, timed_out: 0, wall: 0, tally: ?empty_tally});
        ret exit.OK;
    }

    val res_out: res[*readout.TestResult, A.Error] = A.allocate[readout.TestResult](a, n::usize);
    if (sel res_out.err) { ret cli_diagnostic.report_fail(r, fail.refused(res_out.err), diagnostic.ORIGIN_TEST); }
    val results: *readout.TestResult = res_out.ok;

    val ld_r: res[str, fail.Fail] = capture_log_dir(a, arts[0].exe);
    if (sel ld_r.err) {
        val said: res[str, std_format.FormatError] = std_format.sprint(a, "could not derive the test log directory: {}", fail.describe(ld_r.err));
        if (sel said.err) { ret cli_diagnostic.report_fail(r, fail.message("out of memory"), diagnostic.ORIGIN_TEST); }
        ret cli_diagnostic.report_fail(r, fail.with_text(ld_r.err, said.ok), diagnostic.ORIGIN_TEST);
    }
    val log_dir:  str            = ld_r.ok;
    val prepared: err[fail.Fail] = prepare_logs(a, log_dir, n);
    if (sel prepared.err) { ret cli_diagnostic.report_fail(r, prepared.err, diagnostic.ORIGIN_TEST); }

    var i: u32 = 0;
    for (i < n) {
        settle(?results[i], ?arts[i], validation.gate_result(validation.RESULT_PASS, validation.CAUSE_PASS, nil));
        results[i].done = false;
        results[i].log  = nil;
        val lp_r: res[str, fail.Fail] = log_path(a, log_dir, i);
        if (sel lp_r.ok) { results[i].log = lp_r.ok; }
        i = i + 1;
    }

    val run_start: readout.Instant = readout.sample();
    readout.run_start(?rd.sink, results, n, runner::str);
    execute(a, r, ?rd.sink, results, n, runner, level, jobs, !json_out, timeout);
    val wall: chrono_duration.Duration = readout.elapsed(run_start);

    val failed: u32               = count_failed(results, n);
    var tally:  outcome.GateTally = outcome.gate_tally_init(a);
    build_gate_tally(?tally, a, results, n);
    readout.run_end(?rd.sink, readout.RunEnd{tests: results, count: n, passed: n - failed, failed: failed,
        timed_out: count_timed_out(results, n), wall: wall, tally: ?tally});
    ret exit_code(failed, ?tally);
}

fun exit_code(failed: u32, tally: *outcome.GateTally) i64 {
    if (tally.infrastructure_failure > 0) { ret exit.INTERNAL; }
    if (failed > 0)                       { ret exit.USER; }
    ret exit.OK;
}

fun count_timed_out(results: *readout.TestResult, len: u32) u32 {
    var t: u32 = 0;
    var i: u32 = 0;
    for (i < len) {
        if (results[i].result.kind == validation.RESULT_RESOURCE_EXHAUSTION
            && results[i].result.cause == validation.CAUSE_ORACLE_TIMEOUT) { t = t + 1; }
        i = i + 1;
    }
    ret t;
}

fun build_gate_tally(gt: *outcome.GateTally, a: *A.Allocator, results: *readout.TestResult, n: u32) {
    var i: u32 = 0;
    for (i < n) {
        outcome.record_gate(gt, a, results[i].result);
        i = i + 1;
    }
}

rec Slot {
    active: bool;
    idx:    u32;
    start:  readout.Instant;
}

# a test that finished without running: result is why, and its log is kept
fun settle(t: *readout.TestResult, art: *outcome.TestArtifact, result: validation.ValidationGateResult) {
    t.art       = art;
    t.done      = true;
    t.result    = result;
    t.code      = 0;
    t.elapsed   = 0;
    t.bound     = 0;
    t.out       = nil;
    t.out_len   = 0;
    t.truncated = false;
}

# every test not yet finished settles as a setup failure when the run's own
# storage was refused, each reported as it settles
fun settle_exhausted(r: *cli_diagnostic.Report, sink: *readout.Sink, results: *readout.TestResult, n: u32) {
    cli_diagnostic.report_fail(r, fail.message("out of memory"), diagnostic.ORIGIN_TEST);
    var i: u32 = 0;
    for (i < n) {
        settle(?results[i], results[i].art, build_testing.classify_setup_failure());
        readout.test_end(sink, results, i);
        i = i + 1;
    }
}

# run every test, up to jobs at once, and report each to sink the moment it is
# reaped, in the order the tests finish
fun execute(a: *A.Allocator, r: *cli_diagnostic.Report, sink: *readout.Sink, results: *readout.TestResult, n: u32,
    runner: *u8, level: u8, jobs: u32, want_bytes: bool, timeout: chrono_duration.Duration) {
    var window: u32 = jobs;
    if (window < 1) { window = 1; }
    if (window > n) { window = n; }

    val res_processes: res[*subprocess.OwnedSubprocess, A.Error] = A.allocate[subprocess.OwnedSubprocess](a, n::usize);
    if (sel res_processes.err) {
        settle_exhausted(r, sink, results, n);
        ret;
    }
    val processes: *subprocess.OwnedSubprocess = res_processes.ok;
    val res_slots: res[*Slot, A.Error]         = A.allocate[Slot](a, window::usize);
    if (sel res_slots.err) {
        A.deallocate[subprocess.OwnedSubprocess](a, processes, n::usize);
        settle_exhausted(r, sink, results, n);
        ret;
    }
    val slots: *Slot = res_slots.ok;
    var i:     u32   = 0;
    for (i < n) {
        subprocess.init(?processes[i]);
        i = i + 1;
    }
    i = 0;
    for (i < window) {
        slots[i].active = false;
        i               = i + 1;
    }

    var scope: sync_cancel.Scope;
    sync_cancel.make_root(?scope, opt[time.Instant].none{});
    var source:           events.Source;
    val made_source:      err[io_error.Error] = events.make(?source);
    var has_source:       bool                = sel made_source.ok;
    var interrupt_source: *events.Source      = nil;
    if (has_source) { interrupt_source = ?source; }

    var spawned:  u32 = 0;
    var done:     u32 = 0;
    var inflight: u32 = 0;

    for (done < n) {
        for (inflight < window && spawned < n) {
            val idx: u32 = spawned;
            spawned = spawned + 1;
            val spawn_fail: opt[validation.ValidationGateResult] = spawn_one(a, processes, slots, window, ?results[idx], idx, runner,
                timeout);
            if (sel spawn_fail.none) {
                inflight = inflight + 1;
            }
            if (sel spawn_fail.some) {
                settle(?results[idx], results[idx].art, spawn_fail.some);
                done = done + 1;
                readout.test_end(sink, results, idx);
            }
        }

        if (inflight > 0) {
            val wr: res[*subprocess.OwnedSubprocess, subprocess.Error] = subprocess.wait_any(a, processes, n, ?scope, interrupt_source);
            if (sel wr.err) {
                cli_diagnostic.report_fail(r, fail.environment(diagnostic_kind.PROCESS_WAIT, "waiting for test children failed"), diagnostic.ORIGIN_TEST);
                var sx: u32 = 0;
                for (sx < window) {
                    if (slots[sx].active) {
                        val eidx:    u32                                                  = slots[sx].idx;
                        var cleaned: bool                                                 = false;
                        val one:     res[subprocess.SubprocessTerminal, subprocess.Error] = subprocess.wait(a, ?processes[eidx]);
                        if (sel one.ok) { cleaned = true; }
                        if (sel one.err) {
                            val canceled: res[subprocess.SubprocessTerminal, subprocess.Error] = subprocess.cancel(a, ?processes[eidx], 0);
                            if (sel canceled.ok) { cleaned = true; }
                        }
                        if (cleaned) { finalize_slot(a, ?processes[eidx], ?slots[sx], results, level, want_bytes); }
                        or {
                            subprocess.abandon_capture(?processes[eidx]);
                            subprocess.dnit(a, ?processes[eidx]);
                            settle(?results[eidx], results[eidx].art, build_testing.classify_wait_failure());
                        }
                        slots[sx].active = false;
                        inflight         = inflight - 1;
                        done             = done + 1;
                        readout.test_end(sink, results, eidx);
                    }
                    sx = sx + 1;
                }
            }
            if (sel wr.ok) {
                val reaped: *subprocess.OwnedSubprocess = wr.ok;
                var sx:     u32                         = 0;
                for (sx < window) {
                    if (slots[sx].active) {
                        val fidx: u32 = slots[sx].idx;
                        if (?processes[fidx] == reaped) {
                            finalize_slot(a, ?processes[fidx], ?slots[sx], results, level, want_bytes);
                            slots[sx].active = false;
                            inflight         = inflight - 1;
                            done             = done + 1;
                            readout.test_end(sink, results, fidx);
                            brk;
                        }
                    }
                    sx = sx + 1;
                }
            }
        }
    }

    if (has_source) { events.close(?source); }
    sync_cancel.destroy(?scope);
}

fun emit_list_case(w: *io_writer.Writer, art: *outcome.TestArtifact) {
    var o: json.Object;
    cli_diagnostic.event_begin(w, ?o, "case");
    json.field_str(?o, "name", art.name);
    json.field_str(?o, "module", art.module);
    json.field_str(?o, "file", art.file);
    json.field_i64(?o, "line", art.line::i64);
    json.field_str(?o, "object", art.object);
    json.field_i64(?o, "index", art.idx::i64);
    json.field_str_or_null(?o, "target", art.target);
    json.field_str_or_null(?o, "profile", art.profile);
    json.object_end(?o);
}

# spawn the test at position idx into a free slot, its output captured to its log
# ---
# ret: none when it is running, otherwise the result it settles with
fun spawn_one(a: *A.Allocator, processes: *subprocess.OwnedSubprocess, slots: *Slot,
    window: u32, t: *readout.TestResult, idx: u32, runner: *u8,
    timeout: chrono_duration.Duration) opt[validation.ValidationGateResult] {
    var s: u32 = 0;
    for (s < window && slots[s].active) { s = s + 1; }
    if (s == window || t.log == nil) { ret opt[validation.ValidationGateResult].some{build_testing.classify_setup_failure()}; }
    val art: *outcome.TestArtifact = t.art;

    var ibuf: [16]u8;
    write_index(?ibuf[0], 16, art.idx);

    var child_argv: [4]*u8;
    if (runner != nil) {
        child_argv[0] = runner;
        child_argv[1] = art.exe;
        child_argv[2] = ?ibuf[0];
        child_argv[3] = nil;
    }
    or {
        child_argv[0] = art.exe;
        child_argv[1] = ?ibuf[0];
        child_argv[2] = nil;
    }

    var options: subprocess.SpawnOptions = subprocess.spawn_options();
    options.grouped        = true;
    options.capture        = t.log;
    options.capture_stderr = true;
    options.capture_limit  = CAP_OUTPUT;
    val start: readout.Instant       = readout.sample();
    val res_c: err[subprocess.Error] = subprocess.spawn(
        a, ?processes[idx], child_argv[0], ?child_argv[0], env.environ(), options);
    if (sel res_c.err) {
        val term:      subprocess.SubprocessTerminal = processes[idx].terminal;
        var empty_cap: subprocess.CaptureIoResult;
        empty_cap.bytes        = 0;
        empty_cap.truncated    = false;
        empty_cap.short_read   = false;
        empty_cap.read_failed  = false;
        empty_cap.write_failed = false;
        empty_cap.close_failed = false;
        empty_cap.closed       = false;
        empty_cap.owned        = false;
        val result: validation.ValidationGateResult = build_testing.classify_subprocess(?term, false, true, ?empty_cap);
        subprocess.dnit(a, ?processes[idx]);
        fs.remove_file(t.log);
        ret opt[validation.ValidationGateResult].some{result};
    }

    if (timeout > 0) { subprocess.bound(?processes[idx], timeout); }

    slots[s].active = true;
    slots[s].idx    = idx;
    slots[s].start  = start;
    ret opt[validation.ValidationGateResult].none{};
}

# fill a reaped test's result from its process; a passing test's log is removed
fun finalize_slot(a: *A.Allocator, process: *subprocess.OwnedSubprocess, slot: *Slot,
    results: *readout.TestResult, level: u8, want_bytes: bool) {
    val t: *readout.TestResult = ?results[slot.idx];
    t.done      = true;
    t.code      = 0;
    t.out       = nil;
    t.out_len   = 0;
    t.truncated = false;
    t.elapsed   = readout.elapsed(slot.start);

    val provisional_pass: bool = process.terminal.kind == subprocess.STATE_EXITED && process.terminal.code == 0;
    var retain:           bool = want_bytes;
    if (provisional_pass && level < readout.LEVEL_ITEMS) { retain = false; }

    val capture_r: res[subprocess.CaptureIoResult, subprocess.Error] = subprocess.finish_capture(a, process, retain);
    var cap_ok:    bool                                              = sel capture_r.ok;
    var capture:   subprocess.CaptureIoResult;
    capture.bytes        = 0;
    capture.truncated    = false;
    capture.short_read   = false;
    capture.read_failed  = false;
    capture.write_failed = false;
    capture.close_failed = false;
    capture.closed       = false;
    capture.owned        = false;
    if (sel capture_r.ok) {
        capture = capture_r.ok;
        if (retain) {
            t.out       = subprocess.capture_bytes(process, ?t.out_len);
            t.truncated = capture.truncated;
        }
    }

    t.bound = 0;
    if (subprocess.expired(process)) { t.bound = process.timeout; }
    t.result = build_testing.classify_subprocess(?process.terminal, subprocess.expired(process), cap_ok, ?capture);
    if (t.result.kind == validation.RESULT_SEMANTIC_MISMATCH) { t.code = process.terminal.code; }

    subprocess.dnit(a, process);
    if (t.result.kind == validation.RESULT_PASS && t.log != nil) { fs.remove_file(t.log); }
}

fun count_failed(results: *readout.TestResult, len: u32) u32 {
    var f: u32 = 0;
    var i: u32 = 0;
    for (i < len) {
        if (results[i].result.kind != validation.RESULT_PASS) { f = f + 1; }
        i = i + 1;
    }
    ret f;
}

# a listed test: its qualified name and the test object that holds it
fun artifact_report(art: *outcome.TestArtifact) {
    print.print(art.name::str);
    print.print(" ");
    print.print(art.object::str);
}

fun write_index(buf: *u8, cap: usize, n: u32) {
    var digits: [std_format.DECIMAL_MAX]u8;
    val t:      usize = std_format.put_u64(?digits[0], n::u64);
    var k:      usize = 0;
    for (k < t && k + 1 < cap) {
        buf[k] = digits[k];
        k      = k + 1;
    }
    buf[k] = 0;
}

fun parse_count(s: *u8) i64 {
    if (s == nil || s[0] == 0) { ret -1; }
    var v: i64   = 0;
    var i: usize = 0;
    for (s[i] != 0) {
        if (s[i] < '0' || s[i] > '9') { ret -1; }
        v = v * 10 + (s[i] - '0')::i64;
        if (v > 65536) { ret -1; }
        i = i + 1;
    }
    ret v;
}

fun capture_log_dir(a: *A.Allocator, exe: *u8) res[str, fail.Fail] {
    val dir_r: res[str, A.Error] = types_path.parent(a, exe::str);
    if (sel dir_r.err) { ret res[str, fail.Fail].err{fail.refused(dir_r.err)}; }
    val join_r: res[types_path.Path, A.Error] = types_path.join(a, dir_r.ok, "log");
    if (sel join_r.err) { ret res[str, fail.Fail].err{fail.refused(join_r.err)}; }
    ret res[str, fail.Fail].ok{join_r.ok};
}

fun log_path(a: *A.Allocator, log_dir: *u8, idx: u32) res[str, fail.Fail] {
    var leaf: [24]u8;
    write_index(?leaf[0], 16, idx);
    var k: usize = str_len(?leaf[0]);
    leaf[k]     = '.';
    leaf[k + 1] = 'l';
    leaf[k + 2] = 'o';
    leaf[k + 3] = 'g';
    leaf[k + 4] = 0;
    val join_r: res[types_path.Path, A.Error] = types_path.join(a, log_dir::str, (?leaf[0])::str);
    if (sel join_r.err) { ret res[str, fail.Fail].err{fail.refused(join_r.err)}; }
    ret res[str, fail.Fail].ok{join_r.ok};
}

# the log directory, which the build owns beside the dispatcher, exists and
# holds no log from an earlier run
fun prepare_logs(a: *A.Allocator, log_dir: *u8, total: u32) err[fail.Fail] {
    val owner_r: res[str, A.Error] = types_path.parent(a, log_dir::str);
    if (sel owner_r.err) { ret err[fail.Fail].err{fail.refused(owner_r.err)}; }
    val made: err[fail.Fail] = output.directory(a, owner_r.ok, log_dir::str);
    str_free(a, owner_r.ok);
    if (sel made.err) { ret made; }
    var idx: u32 = 0;
    for (idx < total) {
        val lp_r: res[str, fail.Fail] = log_path(a, log_dir, idx);
        if (sel lp_r.ok) { fs.remove_file(lp_r.ok); }
        idx = idx + 1;
    }
    ret err[fail.Fail].ok{};
}

#[testing]
fun t_outcome(kind: validation.ValidationGateResultKind, cause: validation.ValidationCause) readout.TestResult {
    var o: readout.TestResult;
    settle(?o, nil, validation.gate_result(kind, cause, nil));
    o.log = nil;
    ret o;
}

test count_failed_and_build_gate_tally__only_pass_counts_as_passing {
    var a: A.Allocator;
    page.make(?a);

    var results: [3]readout.TestResult;
    results[0] = t_outcome(validation.RESULT_PASS, validation.CAUSE_PASS);
    results[1] = t_outcome(validation.RESULT_SEMANTIC_MISMATCH, validation.CAUSE_ORACLE_EXIT);
    results[2] = t_outcome(validation.RESULT_TOOL_UNAVAILABLE, validation.CAUSE_TOOL_UNAVAILABLE);

    if (count_failed(?results[0], 3) != 2) { ret 1; }

    var gt: outcome.GateTally = outcome.gate_tally_init(?a);
    build_gate_tally(?gt, ?a, ?results[0], 3);

    var bad: i32 = 0;
    if (gt.pass != 1)                       { bad = 1; }
    or (gt.semantic_mismatch != 1)          { bad = 1; }
    or (gt.tool_unavailable != 1)           { bad = 1; }
    or (outcome.gate_tally_total(?gt) != 3) { bad = 1; }

    outcome.gate_tally_dnit(?gt);
    ret bad;
}

test exit_code__infrastructure_failure_dominates_ordinary_test_failure {
    var a: A.Allocator;
    page.make(?a);

    var clean: outcome.GateTally = outcome.gate_tally_init(?a);
    if (exit_code(0, ?clean) != 0) { ret 1; }
    outcome.gate_tally_dnit(?clean);

    var only_failed: outcome.GateTally = outcome.gate_tally_init(?a);
    if (exit_code(3, ?only_failed) != 1) { ret 2; }
    outcome.gate_tally_dnit(?only_failed);

    var infra: outcome.GateTally = outcome.gate_tally_init(?a);
    if (lang_alloc.refused(outcome.record_gate(?infra, ?a,
        validation.gate_result(validation.RESULT_INFRASTRUCTURE_FAILURE, validation.CAUSE_ORACLE_CAPTURE, nil)))) { ret 3; }
    if (exit_code(0, ?infra) != 2) { ret 4; }
    if (exit_code(5, ?infra) != 2) { ret 5; }
    outcome.gate_tally_dnit(?infra);

    ret 0;
}

#[testing]
fun t_test(argc: usize, argv: **u8) i64 {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 2; }
    val ir: res[args.ParsedInvocation, fail.Fail] = args.parse_invocation(?a, argc, argv);
    if (sel ir.err) { ret 2; }
    var inv: args.ParsedInvocation = ir.ok;
    ret run(argv, ?inv);
}

test run__rejects_emit_before_effects {
    var no_value: [3]*u8 = [3]*u8{"mach", "test", "--emit"};
    if (t_test(3, ?no_value[0]) != 1) { ret 1; }
    var with_value: [5]*u8 = [5]*u8{"mach", "test", ".", "--emit", "obj"};
    if (t_test(5, ?with_value[0]) != 1) { ret 2; }
    ret 0;
}

#[testing]
fun t_temp_name(a: *A.Allocator) str {
    val tf_r: res[fs.TempFile, fs.FsError] = fs.temp_create(a, "mach_test_timeout");
    if (sel tf_r.err) { ret ""; }
    var tf:    fs.TempFile       = tf_r.ok;
    val dup_r: res[str, A.Error] = str_dup(a, fs.temp_path(?tf));
    fs.temp_close_and_remove(?tf);
    if (sel dup_r.err) { ret ""; }
    ret dup_r.ok;
}

#[testing]
rec TimeoutProbe {
    script:  str;
    log_dir: str;
    outcome: readout.TestResult;
}

#[testing]
fun t_probe_free(a: *A.Allocator, pr: *TimeoutProbe) {
    if (str_len(pr.script) > 0) {
        fs.remove_file(pr.script);
        str_free(a, pr.script);
    }
    if (str_len(pr.log_dir) > 0) {
        fs.remove_all(a, pr.log_dir);
        str_free(a, pr.log_dir);
    }
    pr.script  = "";
    pr.log_dir = "";
}

# runs one test process through the real spawn, wait and finalize chain
#[testing]
fun t_run_one_bounded(a: *A.Allocator, body: str, timeout: chrono_duration.Duration, pr: *TimeoutProbe) i32 {
    pr.script  = t_temp_name(a);
    pr.log_dir = t_temp_name(a);
    if (str_len(pr.script) == 0 || str_len(pr.log_dir) == 0) { ret 1; }
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(pr.script, body::*u8, str_len(body), 0o600);
    if (sel write_bytes_r.err) { ret 2; }
    val create_dir_r: err[io_error.Error] = fs.create_dir(pr.log_dir, 0o700);
    if (sel create_dir_r.err) { ret 3; }

    var art: outcome.TestArtifact;
    art.module = "mach.timeout.probe";
    art.name   = "probe";
    art.file   = "probe.mach";
    art.line   = 1;
    art.exe    = pr.script::*u8;
    art.idx    = 0;

    var results: [1]readout.TestResult;
    settle(?results[0], ?art, validation.gate_result(validation.RESULT_PASS, validation.CAUSE_PASS, nil));
    results[0].done = false;
    val lp_r: res[str, fail.Fail] = log_path(a, pr.log_dir::*u8, 0);
    if (sel lp_r.err) { ret 3; }
    results[0].log = lp_r.ok;

    var process: subprocess.OwnedSubprocess;
    subprocess.init(?process);
    var slot: Slot;
    slot.active = false;

    val spawn_fail: opt[validation.ValidationGateResult] = spawn_one(a, ?process, ?slot, 1, ?results[0], 0, "/bin/sh"::*u8, timeout);
    if (sel spawn_fail.some) { ret 4; }

    val wr: res[*subprocess.OwnedSubprocess, subprocess.Error] = subprocess.wait_any(a, ?process, 1, nil, nil);
    if (sel wr.err) {
        subprocess.cancel(a, ?process, 0);
        subprocess.dnit(a, ?process);
        ret 5;
    }
    finalize_slot(a, ?process, ?slot, ?results[0], 0, true);
    pr.outcome = results[0];
    ret 0;
}

test run_one__a_test_past_its_bound_is_timed_out {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }

    var pr: TimeoutProbe;
    pr.script  = "";
    pr.log_dir = "";
    val setup: i32 = t_run_one_bounded(?a, "sleep 30\n", chrono_duration.SECOND, ?pr);
    var bad:   i32 = 0;
    if (setup != 0) { bad = 10 + setup; }
    or {
        val o: *readout.TestResult = ?pr.outcome;
        if (o.result.kind != validation.RESULT_RESOURCE_EXHAUSTION)        { bad = 4; }
        or (o.result.cause != validation.CAUSE_ORACLE_TIMEOUT)             { bad = 5; }
        or (o.bound != chrono_duration.SECOND)                             { bad = 6; }
        or (!str_equals(cli_diagnostic.result_name(?o.result), "timeout")) { bad = 7; }
        or {
            var one: [1]readout.TestResult;
            one[0] = @o;
            if (count_timed_out(?one[0], 1) != 1) { bad = 8; }
            or (count_failed(?one[0], 1) != 1)    { bad = 9; }
            or {
                var tally: outcome.GateTally = outcome.gate_tally_init(?a);
                build_gate_tally(?tally, ?a, ?one[0], 1);
                if (exit_code(1, ?tally) != 1) { bad = 20; }
                outcome.gate_tally_dnit(?tally);
            }
        }
    }
    t_probe_free(?a, ?pr);
    ret bad;
}

test run_one__an_unbounded_test_that_sleeps_briefly_still_passes {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }

    var pr: TimeoutProbe;
    pr.script  = "";
    pr.log_dir = "";
    val setup: i32 = t_run_one_bounded(?a, "sleep 1\nexit 0\n", 0, ?pr);
    var bad:   i32 = 0;
    if (setup != 0) { bad = 10 + setup; }
    or {
        val o: *readout.TestResult = ?pr.outcome;
        if (o.result.kind != validation.RESULT_PASS) { bad = 2; }
        or (o.bound != 0)                            { bad = 3; }
        or {
            var one: [1]readout.TestResult;
            one[0] = @o;
            if (count_timed_out(?one[0], 1) != 0) { bad = 4; }
            or {
                var tally: outcome.GateTally = outcome.gate_tally_init(?a);
                build_gate_tally(?tally, ?a, ?one[0], 1);
                if (exit_code(0, ?tally) != 0) { bad = 5; }
                outcome.gate_tally_dnit(?tally);
            }
        }
    }
    t_probe_free(?a, ?pr);
    ret bad;
}

test run_one__a_test_that_beats_its_bound_keeps_its_own_outcome {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }

    var pr: TimeoutProbe;
    pr.script  = "";
    pr.log_dir = "";
    val setup: i32 = t_run_one_bounded(?a, "exit 4\n", chrono_duration.SECOND * 30, ?pr);
    var bad:   i32 = 0;
    if (setup != 0) { bad = 10 + setup; }
    or {
        val o: *readout.TestResult = ?pr.outcome;
        if (o.result.kind != validation.RESULT_SEMANTIC_MISMATCH) { bad = 2; }
        or (o.result.cause != validation.CAUSE_ORACLE_EXIT)       { bad = 3; }
        or (o.code != 4)                                          { bad = 4; }
        or (o.bound != 0)                                         { bad = 5; }
    }
    t_probe_free(?a, ?pr);
    ret bad;
}

#[testing]
val T_SKIP_MANIFEST: str = "[project]\nmach = \">=5\"\nid = \"skipfx\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.here]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[target.away]\nisa = \"x86_64\"\nos = \"windows\"\nabi = \"win64\"\n\n[profile.debug]\ndefault = true\nopt = 0\ndebug = false\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n\n[artifact.lib]\nkind = \"static\"\nentry = \"lib.mach\"\nout = \"lib/lib{artifact.suffix}\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";

# the dispatcher's startup on either target, with no std: linux enters main
# directly, windows is only ever built
#[testing]
val T_SKIP_LIB: str = "$if ($mach.build.os == $mach.os.windows) {\n    #[symbol(\"mainCRTStartup\")]\n    pub fun start() i32 { ret 0; }\n}\n$or {\n    #[symbol(\"_start\")]\n    pub fun start() {\n        asm x86_64 {\n            mov rax, rsp\n            mov rdi, [rax]\n            lea rsi, [rax+8]\n            and rsp, -16\n            call main\n            mov rdi, rax\n            mov rax, 60\n            syscall\n        }\n    }\n}\n\ntest one { ret 0; }\n";

# `mach test <root> <extra...> --diagnostics=json` over the records it writes:
# 0 when the run holds under cli_diagnostic.t_json_run with exit `code` and, when `key`
# is not nil, a failure record naming it from origin `test`
#[testing]
fun t_json_test(root: str, extra: *str, n: usize, code: i64, key: str) i32 {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 100; }
    var argv: [8]*u8;
    argv[0] = "mach";
    argv[1] = "test";
    argv[2] = root::*u8;
    var i: usize = 0;
    for (i < n) {
        argv[3 + i] = extra[i]::*u8;
        i           = i + 1;
    }
    argv[3 + n] = "--diagnostics=json";
    val ir: res[args.ParsedInvocation, fail.Fail] = args.parse_invocation(?a, 4 + n, ?argv[0]);
    if (sel ir.err) { ret 101; }
    var inv: args.ParsedInvocation = ir.ok;

    var sink: cli_diagnostic.MemSink;
    var r:    cli_diagnostic.Report;
    cli_diagnostic.report_init(?r, cli_diagnostic.FORMAT_JSON);
    cli_diagnostic.mem_writer(?r.w, ?sink);
    fin { cli_diagnostic.mem_sink_dnit(?sink); }
    val got: i64 = cli_diagnostic.report_close(?r, run_reported(?r, ?argv[0], ?inv));
    if (sink.len >= 8192) { ret 102; }
    if (got != code)      { ret 103; }
    if (key == nil)       { ret cli_diagnostic.t_json_run(?sink, code, nil, nil, nil); }
    ret cli_diagnostic.t_json_run(?sink, code, "failure", key, "test");
}

# every selected (target, profile) is built, and only one the host runs natively
# runs: the foreign one is skipped, a run that executes nothing exits 1 instead of
# passing empty, and --runner needs the selection to be one cell
test run__a_foreign_target_is_built_skipped_and_never_a_green_empty_run {
    $if ($mach.build.os != $mach.os.linux)      { ret 0; }
    $if ($mach.build.arch != $mach.arch.x86_64) { ret 0; }
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val tf_r: res[fs.TempFile, fs.FsError] = fs.temp_create(?a, "mach_test_skip");
    if (sel tf_r.err) { ret 1; }
    var tf:   fs.TempFile = tf_r.ok;
    val root: str         = fs.temp_path(?tf);
    fs.temp_close_and_remove(?tf);
    fin { fs.remove_all(?a, root); }
    val src_r: res[str, A.Error] = types_path.join(?a, root, "src");
    if (sel src_r.err) { ret 1; }
    val made: err[fs.FsError] = fs.create_dir_all(?a, src_r.ok, 0o755);
    if (sel made.err) { ret 1; }
    val mp: res[str, A.Error] = types_path.join(?a, root, "mach.toml");
    if (sel mp.err) { ret 1; }
    val lp: res[str, A.Error] = types_path.join(?a, src_r.ok, "lib.mach");
    if (sel lp.err) { ret 1; }
    val wm: err[fs.FsError] = fs.write_bytes(mp.ok, T_SKIP_MANIFEST, str_len(T_SKIP_MANIFEST), 0o644);
    if (sel wm.err) { ret 1; }
    val wl: err[fs.FsError] = fs.write_bytes(lp.ok, T_SKIP_LIB, str_len(T_SKIP_LIB), 0o644);
    if (sel wl.err) { ret 1; }

    var every: [2]str = [2]str{"-t", "*"};
    val both:  i32    = t_json_test(root, ?every[0], 2, 0, nil);
    if (both != 0) { ret 10 + both; }
    var away: [2]str = [2]str{"-t", "away"};
    val none: i32    = t_json_test(root, ?away[0], 2, 1, "target.not_runnable");
    if (none != 0) { ret 20 + none; }
    var runner: [4]str = [4]str{"-t", "*", "--runner", "true"};
    val two:    i32    = t_json_test(root, ?runner[0], 4, 1, nil);
    if (two != 0) { ret 30 + two; }
    ret 0;
}
