use std_args: std.args;
use std.collections.slice.Slice;
use collections_vector: std.collections.vector;
use std.collections.vector.Vector;
use std.print;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;

use A:               std.allocator;
use chrono_duration: std.chrono.duration;
use std_format:      std.format;

use mach.cli.args;
use mach.cli.cmd.build;
use cli_diagnostic: mach.cli.diagnostic;
use mach.cli.exit;
use mach.cli.util;
use mach.lang.build.engine;
use mach.lang.build.outcome;
use build_plan:   mach.lang.build.plan;
use testing_pool: mach.lang.build.testing.pool;
use mach.lang.diagnostic;
use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.driver.request;
use mach.lang.duration;
use mach.lang.fail;
use mach.lang.host;
use mach.lang.manifest;
use mach.lang.manifest.runner;
use mach.lang.session;
use mach.lang.testrun;

# `--filter <substr>`
val FILTER: std_args.Flag = std_args.Flag{long: "filter", short: 0, value: "substr", repeat: false, negatable: false, help: "run only tests whose qualified name contains the substring"};
# `--include-deps`
val INCLUDE_DEPS: std_args.Flag = std_args.Flag{long: "include-deps", short: 0, value: nil, repeat: false, negatable: false, help: "also run tests declared in dependency modules"};
# `--list`
val LIST: std_args.Flag = std_args.Flag{long: "list", short: 0, value: nil, repeat: false, negatable: false, help: "list the collected tests and exit"};

# length of FLAGS
val FLAGS_N: usize = 24;
# the flags mach test takes
val FLAGS: [FLAGS_N]*std_args.Flag = [FLAGS_N]*std_args.Flag{
    ?args.HELP, ?args.DIAGNOSTICS, ?args.ARTIFACT, ?args.TARGET, ?args.PROFILE, ?args.ALL, ?args.OUTPUT,
    ?args.VERBOSE, ?args.QUIET, ?args.SET, ?args.VERIFY, ?args.OPTIMIZE, ?args.DEBUG, ?args.WORK,
    ?args.LIB_DIR, ?args.LIB, ?args.NO_CACHE, ?args.THREADS, ?FILTER, ?INCLUDE_DEPS, ?LIST,
    ?args.RUNNER, ?args.TIMEOUT, ?args.ALLOW_UNRUNNABLE,
};

# length of REFUSED
val REFUSED_N: usize = 1;
# the build options test recognizes only to refuse
val REFUSED: [REFUSED_N]*std_args.Flag = [REFUSED_N]*std_args.Flag{?args.EMIT};

# length of CONSTRAINTS
val CONSTRAINTS_N: usize = 3;
# the constraint sentences help prints for test; enforced by
# manifest.resolve_cells and the test command
val CONSTRAINTS: [CONSTRAINTS_N]str = [CONSTRAINTS_N]str{
    args.SELECTOR_CONSTRAINT,
    "-o and --runner require the selection to resolve to exactly one (artifact, target, profile)",
    "every selected combination is built; its tests run when the target is the host's, declares a runner or --runner is given, and a run that executes none exits 1 unless --allow-unrunnable is given",
};

# length of EXITS
val EXITS_N: usize = 1;
# the exit codes test documents beside exit.SHARED
val EXITS: [EXITS_N]exit.Exit = [EXITS_N]exit.Exit{
    exit.Exit{code: exit.USER, meaning: "a test that failed, was killed by a signal, or timed out"},
};

# `mach test`
pub val COMMAND: std_args.Command = std_args.Command{name: "test", aliases: args.NO_WORDS, help: "build a test dispatcher for every selected (artifact, target, profile) and run each collected test once per (target, profile), in its own process", usage: "<path>", flags: Slice[*std_args.Flag]{data: ?FLAGS[0], size: FLAGS_N}, commands: args.NO_COMMANDS, operand_min: 0, operand_max: std_args.OPERANDS_ANY, passthrough: false};
# what mach holds `mach test` to beyond the parse
pub val POLICY: args.Policy = args.Policy{summary: "build and run project tests", exits: Slice[exit.Exit]{data: ?EXITS[0], size: EXITS_N}, constraints: Slice[str]{data: ?CONSTRAINTS[0], size: CONSTRAINTS_N}, refused: Slice[*std_args.Flag]{data: ?REFUSED[0], size: REFUSED_N}, refusal: "test always builds its internal test dispatcher", conflicts: args.NO_CONFLICTS};

# `mach test`: build the project's test dispatcher and run the collected tests. `--emit` is
# refused; `--list` prints the collected tests and stops; `--diagnostics json` adds the run's
# records to the report; `--filter`, `--runner`, `--timeout`, and `--threads` shape the run; `-o`
# names the dispatcher binary the way `mach build -o` names a built one, inside the project
# root, so runs in one tree with different `-o` do not collide
# ---
# cx:  the call
# ret: exit.OK when every test passed, exit.USER for at least one failed test, exit.INTERNAL for
#      an infrastructure failure, otherwise the code `exit.of` maps the reported failure to
pub fun run(cx: *args.Call) res[i64, fail.Fail] {
    ret res[i64, fail.Fail].ok{run_reported(cx)};
}

fun run_reported(cx: *args.Call) i64 {
    val r:   *cli_diagnostic.Report = cx.report;
    val inv: *std_args.Parsed       = cx.inv;
    val a:   *A.Allocator           = cx.a;

    val res_cfg: res[args.CliArgs, fail.Fail] = args.build_cli_invocation(a, inv);
    if (sel res_cfg.err) { ret cli_diagnostic.report_fail(r, res_cfg.err, diagnostic.ORIGIN_NONE); }
    var config: args.CliArgs = res_cfg.ok;
    config.overrides.include_deps = std_args.given(inv, ?INCLUDE_DEPS);

    val list:        bool     = std_args.given(inv, ?LIST);
    val allow_none:  bool     = std_args.given(inv, ?args.ALLOW_UNRUNNABLE);
    val opt_filter:  opt[*u8] = args.value(inv, ?FILTER);
    val opt_runner:  opt[*u8] = args.value(inv, ?args.RUNNER);
    val opt_timeout: opt[*u8] = args.value(inv, ?args.TIMEOUT);

    val level: u8 = config.verbosity;

    var timeout: chrono_duration.Duration = 0;
    if (sel opt_timeout.some) {
        val tv: opt[chrono_duration.Duration] = duration.parse(opt_timeout.some);
        if (sel tv.none) {
            val said: res[str, std_format.FormatError] = std_format.sprint(a, "--timeout expects {}", duration.FORMS);
            if (sel said.err) { ret cli_diagnostic.report_fail(r, fail.format_refused(said.err), diagnostic.ORIGIN_NONE); }
            ret cli_diagnostic.report_fail(r, fail.user(diagnostic_kind.CLI_FLAG_VALUE, said.ok), diagnostic.ORIGIN_NONE);
        }
        timeout = tv.some;
    }

    val threads: u32 = request.workers(config.overrides.threads);

    val root_arg: *u8 = args.operand(inv, 0);

    val loc_r: res[util.ProjectLocation, fail.Fail] = util.resolve_project_location(a, root_arg);
    if (sel loc_r.err) { ret cli_diagnostic.report_fail(r, loc_r.err, diagnostic.ORIGIN_NONE); }
    val loc:  util.ProjectLocation = loc_r.ok;
    val root: str                  = loc.root;
    r.root = root;

    val col_r: err[fail.Fail] = args.collect_link_inputs(a, ?config, inv);
    if (sel col_r.err) { ret cli_diagnostic.report_fail(r, col_r.err, diagnostic.ORIGIN_NONE); }

    var goal: request.BuildGoal = request.GOAL_TESTS;
    if (list) { goal = request.GOAL_TEST_LIST; }

    var ps:     session.Session;
    val plan_r: res[build.Planned, fail.Fail] = build.plan_invocation(a, root, ?config, goal,
        manifest.ARTIFACT_DEFAULT_ONE, false, ?ps);
    if (sel plan_r.err) { ret cli_diagnostic.report_fail(r, plan_r.err, diagnostic.ORIGIN_BUILD); }
    var planned: build.Planned = plan_r.ok;

    var groups: Vector[Group] = group_cells(a, ?planned.cells);
    val many:   bool          = groups.len > 1;

    # every selected combination is built before any test runs, and none runs
    # when one failed to build
    var collected: Vector[testrun.TestArtifact] = collections_vector.init[testrun.TestArtifact](a);
    var built:     i64                          = exit.OK;
    {
        fin { session.dnit(?ps); }
        if (sel opt_runner.some && planned.cells.len != 1) {
            val refused: fail.Fail = manifest.single_selection_fail(a, diagnostic_kind.SELECTION_AMBIGUOUS, "--runner launches the tests of one selection", ?planned.cells);
            ret cli_diagnostic.report_fail(r, refused, diagnostic.ORIGIN_NONE);
        }

        var pi: usize = 0;
        for (pi < planned.plans.len) {
            val bp: *build_plan.BuildPlan = ?planned.plans.data[pi];
            pi = pi + 1;
            # the filter selects the tests the dispatcher is linked over
            if (sel opt_filter.some) { bp.request.test_filter = opt_filter.some::str; }

            build.announce_profile(r, ?planned, bp, config.quiet);
            var rd: cli_diagnostic.Readout;
            cli_diagnostic.readout_init(?rd, r, bp.units.len, config.quiet, level);
            val ex_r: res[outcome.BuildOutcome, fail.Fail] = engine.execute(bp, cx.backing, a, ?rd.sink);
            cli_diagnostic.readout_close(?rd);
            if (sel ex_r.err) { ret cli_diagnostic.report_fail(r, ex_r.err, diagnostic.ORIGIN_BUILD); }
            var bo: outcome.BuildOutcome = ex_r.ok;
            if (bo.severity != outcome.BUILD_OK) {
                built = exit.worst(built, cli_diagnostic.outcome_code(?bo));
                cnt;
            }
            var ti: usize = 0;
            for (ti < bo.tests.len) {
                val pushed: res[usize, A.Error] = collections_vector.push[testrun.TestArtifact](?collected, bo.tests.data[ti]);
                if (sel pushed.err) { ret cli_diagnostic.report_fail(r, fail.refused(pushed.err), diagnostic.ORIGIN_TEST); }
                ti = ti + 1;
            }
        }
        val declared: err[fail.Fail] = declare_runners(a, ?planned, ?groups);
        if (sel declared.err) { ret cli_diagnostic.report_fail(r, declared.err, diagnostic.ORIGIN_TEST); }
    }
    if (built != exit.OK) { ret built; }

    if (list) {
        var gi: usize = 0;
        for (gi < groups.len) {
            val g:   *Group                       = ?groups.data[gi];
            var run: Vector[testrun.TestArtifact] = group_tests(a, g, ?collected);
            if (many) { print.printf("{} ({}):\n", g.target, g.profile); }
            var i: usize = 0;
            for (i < run.len) {
                cli_diagnostic.report_case(r, ?run.data[i]);
                artifact_report(?run.data[i]);
                print.print("\n");
                i = i + 1;
            }
            gi = gi + 1;
        }
        ret exit.OK;
    }

    if (sel opt_runner.some) {
        val name:        *u8                 = opt_runner.some;
        val res_resolve: res[*u8, fail.Fail] = host.program_resolve(a, name);
        if (sel res_resolve.err) {
            val said: res[str, std_format.FormatError] = std_format.sprint(a, "--runner '{}': {}", name::str, fail.describe(res_resolve.err));
            if (sel said.err) { ret cli_diagnostic.report_fail(r, fail.format_refused(said.err), diagnostic.ORIGIN_TEST); }
            ret cli_diagnostic.report_fail(r, fail.owning(fail.with_text(res_resolve.err, said.ok)), diagnostic.ORIGIN_TEST);
        }
        val g: *Group = ?groups.data[0];
        g.runner = runner.overriding(res_resolve.ok, g.target);
    }

    # a (target, profile) whose programs the host cannot run is built and not run
    # unless its target declares a runner, or --runner over a single selection
    # launches it
    var code:     i64   = exit.OK;
    var executed: u32   = 0;
    var gi:       usize = 0;
    for (gi < groups.len) {
        val g: *Group = ?groups.data[gi];
        gi = gi + 1;
        val through: bool = runner.given(?g.runner);
        if (!g.native && !through) {
            report_skip(a, r, g);
            cnt;
        }
        executed = executed + 1;
        if (many) { print.printf("{} ({}):\n", g.target, g.profile); }
        var run: Vector[testrun.TestArtifact] = group_tests(a, g, ?collected);
        if (through && run.len > 0) {
            # a runner that names no program refuses the group once, not once per test
            var index: *u8                            = "0";
            var probe: res[runner.Command, fail.Fail] = runner.command(a, ?g.runner, run.data[0].exe::str, ?index, 1);
            if (sel probe.err) {
                code = exit.worst(code, cli_diagnostic.report_fail(r, probe.err, diagnostic.ORIGIN_TEST));
                cnt;
            }
            runner.command_free(a, ?probe.ok);
        }
        var launcher: *runner.Runner = nil;
        if (through) { launcher = ?g.runner; }
        code = exit.worst(code, run_group(a, r, ?run, launcher, level, threads, timeout));
    }
    if (executed == 0 && !allow_none) {
        val host: res[str, fail.Fail] = manifest.host_tuple(a);
        if (sel host.err) { ret cli_diagnostic.report_fail(r, host.err, diagnostic.ORIGIN_TEST); }
        val said: res[str, std_format.FormatError] = std_format.sprint(a,
            "nothing was runnable on this host ({}): every selected target's os or isa differs from the host's and it declares no runner, so its tests were built and not run; select a target native to this host with -t, declare `runner` in its [target], or pass --runner for a single selection",
            host.ok);
        if (sel said.err) { ret cli_diagnostic.report_fail(r, fail.format_refused(said.err), diagnostic.ORIGIN_TEST); }
        ret cli_diagnostic.report_fail(r, fail.user(diagnostic_kind.TARGET_NOT_RUNNABLE, said.ok), diagnostic.ORIGIN_TEST);
    }
    ret code;
}

# the tests of one (target, profile), from every artifact the selection built there
# ---
# target:  the declared target name
# profile: the profile name
# native:  the target's os and isa are the host's
# runner:  what the group's tests are launched through, none to run themselves
rec Group {
    target:  str;
    profile: str;
    native:  bool;
    runner:  runner.Runner;
}

# the (target, profile) pairs the cells cover, in cell order
fun group_cells(a: *A.Allocator, cells: *Vector[manifest.Cell]) Vector[Group] {
    var groups: Vector[Group] = collections_vector.init[Group](a);
    var i:      usize         = 0;
    for (i < cells.len) {
        val c:    *manifest.Cell = ?cells.data[i];
        var seen: bool           = false;
        var j:    usize          = 0;
        for (j < groups.len) {
            if (str_equals(groups.data[j].target, c.target_name) && str_equals(groups.data[j].profile, c.profile)) { seen = true; }
            j = j + 1;
        }
        if (!seen) { collections_vector.push[Group](?groups, Group{target: c.target_name, profile: c.profile, native: c.native, runner: runner.none()}); }
        i = i + 1;
    }
    ret groups;
}

# each group's runner, the one its target declares in the root manifest, with
# `{project.work}` the work directory the plans resolved for the group
fun declare_runners(a: *A.Allocator, planned: *build.Planned, groups: *Vector[Group]) err[fail.Fail] {
    var gi: usize = 0;
    for (gi < groups.len) {
        val g: *Group = ?groups.data[gi];
        gi = gi + 1;
        var pi: usize = 0;
        for (pi < planned.plans.len) {
            val bp: *build_plan.BuildPlan = ?planned.plans.data[pi];
            pi = pi + 1;
            var ui: usize = 0;
            for (ui < bp.units.len) {
                val u: *build_plan.BuildUnit = ?bp.units.data[ui];
                ui = ui + 1;
                if (str_len(u.owner) != 0 || !str_equals(u.sel_target, g.target) || !str_equals(u.profile, g.profile)) { cnt; }
                val t:        *manifest.TargetDef           = manifest.find_target_by_name(bp.names, planned.manifest, g.target);
                val declared: res[runner.Runner, fail.Fail] = runner.declared(a, bp.names, t, g.profile, u.out_dir);
                if (sel declared.err) { ret err[fail.Fail].err{declared.err}; }
                g.runner = declared.ok;
                brk;
            }
        }
    }
    ret err[fail.Fail].ok{};
}

# the group's tests, each qualified name once: a test several selected artifacts
# reach runs from the first artifact's dispatcher
fun group_tests(a: *A.Allocator, g: *Group, tests: *Vector[testrun.TestArtifact]) Vector[testrun.TestArtifact] {
    var run: Vector[testrun.TestArtifact] = collections_vector.init[testrun.TestArtifact](a);
    var i:   usize                        = 0;
    for (i < tests.len) {
        val t: *testrun.TestArtifact = ?tests.data[i];
        if (str_equals(t.target::str, g.target) && str_equals(t.profile::str, g.profile)) {
            var dup: bool  = false;
            var j:   usize = 0;
            for (j < run.len) {
                if (str_equals(run.data[j].name::str, t.name::str)) { dup = true; }
                j = j + 1;
            }
            if (!dup) { collections_vector.push[testrun.TestArtifact](?run, @t); }
        }
        i = i + 1;
    }
    ret run;
}

# one line naming a (target, profile) that was built and not run, and why, and its record
fun report_skip(a: *A.Allocator, r: *cli_diagnostic.Report, g: *Group) {
    cli_diagnostic.report_skip(r, g.target, g.profile, "not native to this host");
    val host: res[str, fail.Fail] = manifest.host_tuple(a);
    if (sel host.err) {
        print.printf("skip  {} ({}): not native to this host; built, not run\n", g.target, g.profile);
        ret;
    }
    print.printf("skip  {} ({}): not native to this host ({}); built, not run\n", g.target, g.profile, host.ok);
}

# run one (target, profile)'s tests through the pool, each rendered as it
# finishes, and close the run with its summary
# ---
# ret: exit.OK when every test passed, exit.USER for a failed test, exit.INTERNAL
#      for an infrastructure failure
fun run_group(a: *A.Allocator, r: *cli_diagnostic.Report, tests: *Vector[testrun.TestArtifact], launcher: *runner.Runner,
    level: u8, threads: u32, timeout: chrono_duration.Duration) i64 {
    var rd: cli_diagnostic.Readout;
    cli_diagnostic.readout_init(?rd, r, 1, false, level);

    var config: testing_pool.Config                 = testing_pool.Config{runner: launcher, threads: threads, timeout: timeout, level: level, bytes: true};
    val ran:    res[testing_pool.Counts, fail.Fail] = testing_pool.run(a, ?rd.sink, tests.data, tests.len::u32, ?config);
    if (sel ran.err) { ret cli_diagnostic.report_fail(r, ran.err, diagnostic.ORIGIN_TEST); }
    ret exit_code(ran.ok);
}

fun exit_code(counts: testing_pool.Counts) i64 {
    if (counts.infrastructure > 0) { ret exit.INTERNAL; }
    if (counts.failed > 0)         { ret exit.USER; }
    ret exit.OK;
}

# a listed test: its qualified name and the test object that holds it
fun artifact_report(art: *testrun.TestArtifact) {
    print.print(art.name::str);
    print.print(" ");
    print.print(art.object::str);
}
