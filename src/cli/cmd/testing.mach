# `mach test`, which builds the selection's test dispatchers and runs their tests
#
# tests are run by target and profile through the test pool, launched through the runner
# a target declares. a target and profile whose tests cannot run here, or a finished-module
# target, which links no test executable, are built and reported as not run, and `--list`
# prints the collected tests and stops.

use std_args: std.args;
use std.collections.slice.Slice;
use collections_vector: std.collections.vector;
use std.collections.vector.Vector;
use std.text.string.str_dup;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;

use A:               std.allocator;
use chrono_duration: std.chrono.duration;
use std_format:      std.format;
use io_writer:       std.io.writer;

use mach.base.diagnostic;
use diagnostic_kind: mach.base.diagnostic.kind;
use mach.base.duration;
use mach.base.fail;
use mach.base.intern;
use mach.build.engine;
use mach.build.outcome;
use build_plan:   mach.build.plan;
use testing_pool: mach.build.testing.pool;
use mach.cli.args;
use mach.cli.cmd.build;
use cli_diagnostic: mach.cli.diagnostic;
use mach.cli.exit;
use mach.cli.util;
use mach.compile.request;
use mach.host;
use manifest_model: mach.manifest.model;
use mach.manifest.runner;
use manifest_select: mach.manifest.select;
use manifest_target: mach.manifest.target;
use mach.report.layout;
use mach.report.testrun;
use mach.session;

# `--filter <substr>`
val FILTER: std_args.Flag = std_args.Flag{long: "filter", short: 0, value: "substr", repeat: false, negatable: false, help: "run only tests whose name contains the substring"};
# `--include-deps`
val INCLUDE_DEPS: std_args.Flag = std_args.Flag{long: "include-deps", short: 0, value: nil, repeat: false, negatable: false, help: "also run dependencies' tests"};
# `--list`
val LIST: std_args.Flag = std_args.Flag{long: "list", short: 0, value: nil, repeat: false, negatable: false, help: "list the tests without running them"};
# `--timeout <duration>`, each test's bound
val TIMEOUT: std_args.Flag = std_args.Flag{long: "timeout", short: 0, value: "duration", repeat: false, negatable: false, help: "stop each test after a duration such as 30s (default: 60s)"};
# the bound each test runs under when `--timeout` is not given
val TIMEOUT_DEFAULT: chrono_duration.Duration = 60 * chrono_duration.SECOND;

# length of FLAGS
val FLAGS_N: usize = 26;
# the flags mach test takes
val FLAGS: [FLAGS_N]*std_args.Flag = [FLAGS_N]*std_args.Flag{
    ?args.HELP, ?args.REPORT, ?args.ARTIFACT, ?args.TARGET, ?args.PROFILE, ?args.ALL, ?args.OUTPUT,
    ?args.VERBOSE, ?args.QUIET, ?args.SET, ?args.VERIFY, ?args.OPTIMIZE, ?args.DEBUG, ?args.WORK,
    ?args.LIB_DIR, ?args.FRAMEWORK_DIR, ?args.LIB, ?args.NO_CACHE, ?args.THREADS, ?FILTER, ?INCLUDE_DEPS, ?LIST,
    ?args.RUNNER, ?TIMEOUT, ?args.ALLOW_UNRUNNABLE, ?args.DEP_WARNINGS,
};

# length of REFUSED
val REFUSED_N: usize = 1;
# the build options test recognizes only to refuse
val REFUSED: [REFUSED_N]*std_args.Flag = [REFUSED_N]*std_args.Flag{?args.EMIT};

# `mach test`
pub val COMMAND: std_args.Command = std_args.Command{name: "test", aliases: args.NO_WORDS, help: "build and run project tests", usage: "<path> [inputs...]", flags: Slice[*std_args.Flag]{data: ?FLAGS[0], size: FLAGS_N}, commands: args.NO_COMMANDS, operand_min: 0, operand_max: std_args.OPERANDS_ANY, passthrough: false};
# what mach holds `mach test` to beyond the parse
pub val POLICY: args.Policy = args.Policy{refused: Slice[*std_args.Flag]{data: ?REFUSED[0], size: REFUSED_N}, refusal: "test always builds its internal test dispatcher", conflicts: args.NO_CONFLICTS};

# `mach test`: build the project's test dispatcher and run the collected tests. `--emit` is
# refused; `--list` prints the collected tests and stops; `--report json` or `--report lines` adds the run's
# records to the report; `--filter`, `--runner`, `--timeout` (each test's bound, TIMEOUT_DEFAULT
# when not given), and `--threads` shape the run; `-o`
# names the dispatcher binary the way `mach build -o` names a built one, inside the project
# root, so runs in one tree with different `-o` do not collide
# ---
# cx:  the call
# ret: exit.OK when every test passed, exit.USER for at least one failed test, exit.INTERNAL for
#      an infrastructure failure, otherwise the code `exit.of` maps the reported failure to
pub fun run(cx: *args.Call) res[i64, fail.Fail] {
    ret res[i64, fail.Fail].ok{run_reported(cx)};
}

# the body of `mach test`: build every selected (target, profile), then list or run each group's
# tests, reporting every failure on the call's report
# ---
# cx:  the call
# ret: the code `run` documents
fun run_reported(cx: *args.Call) i64 {
    val r:   *cli_diagnostic.Report = cx.report;
    val inv: *std_args.Parsed       = cx.inv;
    val a:   *A.Allocator           = cx.a;

    val res_cfg: res[args.CliArgs, fail.Fail] = args.build_cli_invocation(a, inv);
    if (sel res_cfg.err) { ret cli_diagnostic.report_fail(r, res_cfg.err, diagnostic.ORIGIN_NONE); }
    var config: args.CliArgs = res_cfg.ok;
    config.overrides.include_deps = std_args.given(inv, ?INCLUDE_DEPS);

    val list:        bool     = std_args.given(inv, ?LIST);
    val allow_none:  bool     = std_args.given(inv, ?args.ALLOW_UNRUNNABLE);
    val opt_filter:  opt[*u8] = args.value(inv, ?FILTER);
    val opt_runner:  opt[*u8] = args.value(inv, ?args.RUNNER);
    val opt_timeout: opt[*u8] = args.value(inv, ?TIMEOUT);

    val level: u8 = config.verbosity;

    var timeout: chrono_duration.Duration = TIMEOUT_DEFAULT;
    if (sel opt_timeout.some) {
        val opt_parse: opt[chrono_duration.Duration] = duration.parse(opt_timeout.some);
        if (sel opt_parse.none) {
            val res_said: res[str, std_format.FormatError] = std_format.sprint(a, "--timeout expects {}", duration.FORMS);
            if (sel res_said.err) { ret cli_diagnostic.report_fail(r, fail.format_refused(res_said.err), diagnostic.ORIGIN_NONE); }
            ret cli_diagnostic.report_fail(r, fail.user(diagnostic_kind.CLI_FLAG_VALUE, res_said.ok), diagnostic.ORIGIN_NONE);
        }
        timeout = opt_parse.some;
    }

    val threads: u32 = request.workers(config.overrides.threads);

    val root_arg: *u8 = args.operand(inv, 0);

    val res_loc: res[util.ProjectLocation, fail.Fail] = util.resolve_project_location(a, root_arg);
    if (sel res_loc.err) { ret cli_diagnostic.report_fail(r, res_loc.err, diagnostic.ORIGIN_NONE); }
    val loc:  util.ProjectLocation = res_loc.ok;
    val root: str                  = loc.root;
    r.root = root;

    val err_col: err[fail.Fail] = args.collect_link_inputs(a, ?config, inv);
    if (sel err_col.err) { ret cli_diagnostic.report_fail(r, err_col.err, diagnostic.ORIGIN_NONE); }

    var goal: request.BuildGoal = request.GOAL_TESTS;
    if (list) { goal = request.GOAL_TEST_LIST; }

    var ps:       session.Session;
    val res_plan: res[build.Planned, fail.Fail] = build.plan_invocation(a, root, ?config, goal,
        manifest_select.ARTIFACT_DEFAULT_ONE, false, r.sources, ?ps);
    if (sel res_plan.err) { ret cli_diagnostic.report_fail(r, res_plan.err, diagnostic.ORIGIN_BUILD); }
    var planned: build.Planned = res_plan.ok;

    # every selected combination is built before any test runs, and none runs
    # when one failed to build
    var groups:    Vector[Group];
    var collected: Vector[testrun.TestArtifact] = collections_vector.init[testrun.TestArtifact](a);
    var built:     i64                          = exit.OK;
    {
        fin { session.dnit(?ps); }
        val res_groups: res[Vector[Group], A.Error] = group_cells(a, ?planned);
        if (sel res_groups.err) { ret cli_diagnostic.report_fail(r, fail.refused(res_groups.err), diagnostic.ORIGIN_TEST); }
        groups = res_groups.ok;
        if (sel opt_runner.some && planned.cells.len != 1) {
            val refused: fail.Fail = manifest_select.single_selection_fail(a, diagnostic_kind.SELECTION_AMBIGUOUS, "--runner launches the tests of one selection", ?planned.cells);
            ret cli_diagnostic.report_fail(r, refused, diagnostic.ORIGIN_NONE);
        }
        if (sel opt_runner.some && groups.data[0].built_only) {
            val res_said: res[str, std_format.FormatError] = std_format.sprint(a, "--runner launches a test executable, and target '{}' is a finished-module target, which links none", groups.data[0].target);
            if (sel res_said.err) { ret cli_diagnostic.report_fail(r, fail.format_refused(res_said.err), diagnostic.ORIGIN_NONE); }
            ret cli_diagnostic.report_fail(r, fail.user(diagnostic_kind.TARGET_OUTPUT_UNSUPPORTED, res_said.ok), diagnostic.ORIGIN_NONE);
        }

        var pi: usize = 0;
        var rd: cli_diagnostic.Readout;
        cli_diagnostic.readout_begin(?rd, r);
        for (pi < planned.plans.len) {
            val bp: *build_plan.BuildPlan = ?planned.plans.data[pi];
            pi = pi + 1;
            # the filter selects the tests the dispatcher is linked over
            if (sel opt_filter.some) { bp.request.test_filter = opt_filter.some::str; }

            val res_execute: res[outcome.BuildOutcome, fail.Fail] = engine.execute(bp, cx.backing, cx.spans, a, ?rd.sink);
            if (sel res_execute.err) {
                cli_diagnostic.readout_end(?rd);
                ret cli_diagnostic.report_fail(r, res_execute.err, diagnostic.ORIGIN_BUILD);
            }
            var bo: outcome.BuildOutcome = res_execute.ok;
            if (bo.severity != outcome.BUILD_OK) {
                built = exit.worst(built, cli_diagnostic.outcome_code(?bo));
                cnt;
            }
            var ti: usize = 0;
            for (ti < bo.tests.len) {
                val res_pushed: res[usize, A.Error] = collections_vector.push[testrun.TestArtifact](?collected, bo.tests.data[ti]);
                if (sel res_pushed.err) {
                    cli_diagnostic.readout_end(?rd);
                    ret cli_diagnostic.report_fail(r, fail.refused(res_pushed.err), diagnostic.ORIGIN_TEST);
                }
                ti = ti + 1;
            }
        }
        cli_diagnostic.readout_end(?rd);
        val err_declared: err[fail.Fail] = declare_runners(a, ?planned, ?groups);
        if (sel err_declared.err) { ret cli_diagnostic.report_fail(r, err_declared.err, diagnostic.ORIGIN_TEST); }
    }
    if (built != exit.OK) { ret built; }
    val many: bool = groups.len > 1;

    if (list) {
        var gi: usize = 0;
        for (gi < groups.len) {
            val g: *Group = ?groups.data[gi];
            gi = gi + 1;
            if (g.built_only) {
                report_skip(a, r, g, "checked, not listed");
                cnt;
            }
            var run: Vector[testrun.TestArtifact] = group_tests(a, g, ?collected);
            if (many) { std_format.format(cli_diagnostic.out(r), "{} ({}):\n", g.target, g.profile); }
            # a name column as wide as the group's widest name, then the object
            var cols: [2]layout.Column = [2]layout.Column{layout.Column{width: 0, align: layout.LEFT, gap: 0}, layout.Column{width: 0, align: layout.LEFT, gap: layout.GAP}};
            var i:    usize            = 0;
            for (i < run.len) {
                layout.fit(?cols[0], run.data[i].name::str);
                i = i + 1;
            }
            i = 0;
            for (i < run.len) {
                cli_diagnostic.report_case(r, ?run.data[i]);
                artifact_report(r, ?cols[0], ?run.data[i]);
                i = i + 1;
            }
        }
        ret exit.OK;
    }

    if (sel opt_runner.some) {
        val name:        *u8                 = opt_runner.some;
        val res_resolve: res[*u8, fail.Fail] = host.program_resolve(a, name);
        if (sel res_resolve.err) {
            val res_said: res[str, std_format.FormatError] = std_format.sprint(a, "--runner '{}' cannot be used ({})", name::str, fail.describe(res_resolve.err));
            if (sel res_said.err) { ret cli_diagnostic.report_fail(r, fail.format_refused(res_said.err), diagnostic.ORIGIN_TEST); }
            ret cli_diagnostic.report_fail(r, fail.owning(fail.with_text(res_resolve.err, res_said.ok)), diagnostic.ORIGIN_TEST);
        }
        val g: *Group = ?groups.data[0];
        g.runner = runner.overriding(res_resolve.ok, g.target);
    }

    # a (target, profile) whose programs the host cannot run is built and not run
    # unless its target declares a runner, or --runner over a single selection
    # launches it. a finished-module target links no test executable and is never run
    var code:     i64   = exit.OK;
    var executed: u32   = 0;
    var runnable: u32   = 0;
    var gi:       usize = 0;
    var rd:       cli_diagnostic.Readout;
    cli_diagnostic.readout_begin(?rd, r);
    for (gi < groups.len) {
        val g: *Group = ?groups.data[gi];
        gi = gi + 1;
        if (g.built_only) {
            report_skip(a, r, g, "built, not run");
            cnt;
        }
        runnable = runnable + 1;
        val through: bool = runner.given(?g.runner);
        if (!g.native && !through) {
            report_skip(a, r, g, "built, not run");
            cnt;
        }
        executed = executed + 1;
        var run: Vector[testrun.TestArtifact] = group_tests(a, g, ?collected);
        if (through && run.len > 0) {
            # a runner that names no program refuses the group once, not once per test
            var index:     *u8                            = "0";
            var res_probe: res[runner.Command, fail.Fail] = runner.command(a, ?g.runner, run.data[0].exe::str, ?index, 1);
            if (sel res_probe.err) {
                code = exit.worst(code, cli_diagnostic.report_fail(r, res_probe.err, diagnostic.ORIGIN_TEST));
                cnt;
            }
            runner.command_dnit(a, ?res_probe.ok);
        }
        var launcher: *runner.Runner = nil;
        if (through) { launcher = ?g.runner; }
        cli_diagnostic.readout_unit(?rd, g.artifact, g.target, g.profile);
        code = exit.worst(code, run_group(a, r, ?rd, ?run, launcher, level, threads, timeout));
    }
    cli_diagnostic.readout_end(?rd);
    if (executed == 0 && runnable == 0 && !allow_none) {
        ret cli_diagnostic.report_fail(r, fail.user(diagnostic_kind.TARGET_NOT_RUNNABLE, "every selected target is a finished-module target, which links no test executable, so the selection was built and no test ran. select an artifact on a target that links executables"), diagnostic.ORIGIN_TEST);
    }
    if (executed == 0 && !allow_none) {
        val res_host: res[str, fail.Fail] = manifest_target.host_tuple(a);
        if (sel res_host.err) { ret cli_diagnostic.report_fail(r, res_host.err, diagnostic.ORIGIN_TEST); }
        val res_said: res[str, std_format.FormatError] = std_format.sprint(a,
            "nothing selected runs on this host ({}), so the tests were built and not run. select a target native to this host with -t, declare `runner` in its [target], or pass --runner for a single selection",
            res_host.ok);
        if (sel res_said.err) { ret cli_diagnostic.report_fail(r, fail.format_refused(res_said.err), diagnostic.ORIGIN_TEST); }
        ret cli_diagnostic.report_fail(r, fail.user(diagnostic_kind.TARGET_NOT_RUNNABLE, res_said.ok), diagnostic.ORIGIN_TEST);
    }
    ret code;
}

# the tests of one (target, profile), from every artifact the selection built there
# ---
# artifact:   the artifact whose tests it holds, as its result names it
# target:     the declared target name
# profile:    the profile name
# native:     the target's os and isa are the host's
# runner:     what the group's tests are launched through, none to run themselves
# built_only: the target is a finished-module one, which links no test executable, so its
#             cells were built as their artifacts and no test of theirs runs
rec Group {
    artifact:   str;
    target:     str;
    profile:    str;
    native:     bool;
    runner:     runner.Runner;
    built_only: bool;
}

# the (target, profile) pairs the planned cells cover, in cell order, each group owning its names
# in `a` so they outlive the session the cells were planned in
fun group_cells(a: *A.Allocator, planned: *build.Planned) res[Vector[Group], A.Error] {
    val cells:  *Vector[manifest_select.Cell] = ?planned.cells;
    var groups: Vector[Group]                 = collections_vector.init[Group](a);
    var i:      usize                         = 0;
    for (i < cells.len) {
        val c:    *manifest_select.Cell = ?cells.data[i];
        var seen: bool                  = false;
        var j:    usize                 = 0;
        for (j < groups.len) {
            if (str_equals(groups.data[j].target, c.target_name) && str_equals(groups.data[j].profile, c.profile)) { seen = true; }
            j = j + 1;
        }
        i = i + 1;
        if (seen) { cnt; }
        val res_artifact: res[str, A.Error] = str_dup(a, c.artifact);
        if (sel res_artifact.err) { ret res[Vector[Group], A.Error].err{res_artifact.err}; }
        val res_target: res[str, A.Error] = str_dup(a, c.target_name);
        if (sel res_target.err) { ret res[Vector[Group], A.Error].err{res_target.err}; }
        val res_profile: res[str, A.Error] = str_dup(a, c.profile);
        if (sel res_profile.err) { ret res[Vector[Group], A.Error].err{res_profile.err}; }
        val built_only: bool                = planned_built_only(planned, c.target_name, c.profile);
        val res_pushed: res[usize, A.Error] = collections_vector.push[Group](?groups, Group{artifact: res_artifact.ok, target: res_target.ok, profile: res_profile.ok, native: c.native, runner: runner.none(), built_only: built_only});
        if (sel res_pushed.err) { ret res[Vector[Group], A.Error].err{res_pushed.err}; }
    }
    ret res[Vector[Group], A.Error].ok{groups};
}

# whether the root's cells on `target` for `profile` were planned built only, as every cell on a
# finished-module target is
fun planned_built_only(planned: *build.Planned, target: str, profile: str) bool {
    var pi: usize = 0;
    for (pi < planned.plans.len) {
        val bp: *build_plan.BuildPlan = ?planned.plans.data[pi];
        pi = pi + 1;
        var ui: usize = 0;
        for (ui < bp.units.len) {
            val u: *build_plan.BuildUnit = ?bp.units.data[ui];
            ui = ui + 1;
            if (u.is_required || !root_unit_on(bp, u, target, profile)) { cnt; }
            ret u.built_only;
        }
    }
    ret false;
}

# each group's runner, the one its target declares in the root manifest, with
# `{project.work}` the work directory the plans resolved for the group
fun declare_runners(a: *A.Allocator, planned: *build.Planned, groups: *Vector[Group]) err[fail.Fail] {
    var gi: usize = 0;
    for (gi < groups.len) {
        val g: *Group = ?groups.data[gi];
        gi = gi + 1;
        var pi: usize = 0;
        for (pi < planned.plans.len) {
            val bp: *build_plan.BuildPlan = ?planned.plans.data[pi];
            pi = pi + 1;
            var ui: usize = 0;
            for (ui < bp.units.len) {
                val u: *build_plan.BuildUnit = ?bp.units.data[ui];
                ui = ui + 1;
                if (!root_unit_on(bp, u, g.target, g.profile)) { cnt; }
                val t:            *manifest_model.TargetDef     = manifest_target.find_target_by_name(bp.names, planned.manifest, g.target);
                val res_declared: res[runner.Runner, fail.Fail] = runner.declared(a, bp.names, t, g.profile, u.out_dir);
                if (sel res_declared.err) { ret err[fail.Fail].err{res_declared.err}; }
                g.runner = res_declared.ok;
                brk;
            }
        }
    }
    ret err[fail.Fail].ok{};
}

# whether `u` is a cell of the root manifest on the declared target `target` for `profile`, by the
# target it resolved to, since a cell planned on its artifact's default target names none
fun root_unit_on(bp: *build_plan.BuildPlan, u: *build_plan.BuildUnit, target: str, profile: str) bool {
    if (str_len(u.owner) != 0 || !str_equals(u.profile, profile)) { ret false; }
    val opt_name: opt[str] = intern.get(bp.names, u.target_entry.name);
    ret sel opt_name.some && str_equals(opt_name.some, target);
}

# the group's tests, each qualified name once: a test several selected artifacts
# reach runs from the first artifact's dispatcher
fun group_tests(a: *A.Allocator, g: *Group, tests: *Vector[testrun.TestArtifact]) Vector[testrun.TestArtifact] {
    var run: Vector[testrun.TestArtifact] = collections_vector.init[testrun.TestArtifact](a);
    var i:   usize                        = 0;
    for (i < tests.len) {
        val t: *testrun.TestArtifact = ?tests.data[i];
        if (str_equals(t.target::str, g.target) && str_equals(t.profile::str, g.profile)) {
            var dup: bool  = false;
            var j:   usize = 0;
            for (j < run.len) {
                if (str_equals(run.data[j].name::str, t.name::str)) { dup = true; }
                j = j + 1;
            }
            if (!dup) { collections_vector.push[testrun.TestArtifact](?run, @t); }
        }
        i = i + 1;
    }
    ret run;
}

# the result naming a (target, profile) whose tests did not run, why, the host for a target foreign
# to it, and what was done instead, and its record
fun report_skip(a: *A.Allocator, r: *cli_diagnostic.Report, g: *Group, done: str) {
    var reason: str = FINISHED_REASON;
    var host:   str = nil;
    if (!g.built_only) {
        reason = FOREIGN_REASON;
        val res_host: res[str, fail.Fail] = manifest_target.host_tuple(a);
        if (sel res_host.ok) { host = res_host.ok; }
    }
    cli_diagnostic.report_skip(r, g.target, g.profile, reason);
    if (!cli_diagnostic.results_shown(r)) { ret; }
    var tv:     layout.Value;
    var fields: [4]layout.Field = [4]layout.Field{
        layout.Field{key: "target", value: layout.target(?tv, g.target, g.profile)},
        layout.Field{key: "reason", value: reason},
        layout.Field{key: "host", value: host},
        layout.Field{key: "instead", value: done},
    };
    layout.result(cli_diagnostic.out(r), layout.SKIPPED, g.artifact, ?fields[0], 4);
}

# why a target that is not the host's runs no tests without a runner
val FOREIGN_REASON: str = "not native to this host";

# why a finished-module target's tests do not run
val FINISHED_REASON: str = "a finished-module target links no test executable";

# run one (target, profile)'s tests through the pool under the command's readout, each rendered
# as it finishes, and close the run with its summary
# ---
# ret: exit.OK when every test passed, exit.USER for a failed test, exit.INTERNAL
#      for an infrastructure failure
fun run_group(a: *A.Allocator, r: *cli_diagnostic.Report, rd: *cli_diagnostic.Readout, tests: *Vector[testrun.TestArtifact], launcher: *runner.Runner,
    level: u8, threads: u32, timeout: chrono_duration.Duration) i64 {
    var config:  testing_pool.Config                 = testing_pool.Config{runner: launcher, threads: threads, timeout: timeout, level: level, bytes: true};
    val res_ran: res[testing_pool.Counts, fail.Fail] = testing_pool.run(a, ?rd.sink, tests.data, tests.len::u32, ?config);
    if (sel res_ran.err) { ret cli_diagnostic.report_fail(r, res_ran.err, diagnostic.ORIGIN_TEST); }
    ret exit_code(res_ran.ok);
}

# the exit code of a group's counts: exit.INTERNAL for an infrastructure failure, exit.USER for a
# failed test, otherwise exit.OK
fun exit_code(counts: testing_pool.Counts) i64 {
    if (counts.infrastructure > 0) { ret exit.INTERNAL; }
    if (counts.failed > 0)         { ret exit.USER; }
    ret exit.OK;
}

# a listed test on its own line: its qualified name and the test object that holds it
fun artifact_report(r: *cli_diagnostic.Report, cols: *layout.Column, art: *testrun.TestArtifact) {
    var texts: [2]str = [2]str{art.name::str, art.object::str};
    layout.row(cli_diagnostic.out(r), cols, ?texts[0], 2);
}
