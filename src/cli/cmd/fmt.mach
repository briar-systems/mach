use std.allocator.arena;
use std.allocator.page;
use std.collections.sort;
use std.collections.vector;
use std.collections.vector.Vector;
use std.data.toml;
use fs: std.filesystem;
use std.filesystem.native;
use std.format;
use io_error: std.io.error;
use std.io.writer;
use std.print;
use identities: std.system.file_identity;
use std.system.os;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.path;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.StrError;
use std.types.string.str;
use std.types.string.str_copy_slice;
use std.types.string.str_ends_with;
use std.types.string.str_equals;
use std.types.string.str_join;
use std.types.string.str_len;
use std.types.string.str_replace;

$if ($mach.build.os == $mach.os.linux)  { use nofollow: std.system.os.linux; }
$or ($mach.build.os == $mach.os.darwin) { use nofollow: std.system.os.darwin; }

use A: std.allocator;

use mach.cli.args;
use cli_diag: mach.cli.diagnostic;
use mach.cli.util;
use mach.lang.build.outcome;
use mach.lang.diagnostic;
use mach.lang.fail;
use formatter: mach.lang.format;
use mach.lang.intern;
use mach.lang.manifest;
use mach.lang.output.remove;
use mach.lang.source;

# `mach fmt`: the project's own source in the one canonical layout
# ---
# visited:   source files read
# differing: files whose layout is not canonical (rewritten, or listed by --check)
# malformed: files that do not parse; each was reported and left unchanged
pub rec Report {
    visited:   usize;
    differing: usize;
    malformed: usize;
}

# the deepest source directory nesting the walk follows
val MAX_DEPTH: usize = 256;

# how the operand names its input
# ---
# stream:  `-`, the source arrives on stdin
# source:  one source file, formatted with no manifest read
# project: a directory holding a mach.toml, or the mach.toml itself
pub def Operand: u8;
pub val OPERAND_STREAM:  Operand = 0;
pub val OPERAND_SOURCE:  Operand = 1;
pub val OPERAND_PROJECT: Operand = 2;

# the operand spelling that names stdin
pub val STREAM_OPERAND: str = "-";
# how diagnostics and the check listing name the stream
pub val STREAM_NAME: str = "<stdin>";

# where the canonical text of one input goes
# ---
# file:   replace the input file in place and name it on stdout
# stream: write the canonical text to stdout, whether or not it differs
# name:   write no source; name the input on stdout when its layout differs
pub def Sink: u8;
pub val SINK_FILE:   Sink = 0;
pub val SINK_STREAM: Sink = 1;
pub val SINK_NAME:   Sink = 2;

# one input's destination; SINK_FILE reads dirfd, leaf and mode, SINK_STREAM
# reads stream, and SINK_NAME reads none of them
# ---
# sink:   which of the three destinations receives the canonical text
# dirfd:  the directory holding the input file
# leaf:   the input file's name within that directory
# mode:   the input file's permission bits, carried onto the replacement
# stream: the descriptor the canonical text is written to
rec Destination {
    sink:   Sink;
    dirfd:  usize;
    leaf:   str;
    mode:   i32;
    stream: usize;
}

# a destination for an input with no file behind it, writing to `stream`
fun detached(sink: Sink, stream: usize) Destination {
    ret Destination{sink: sink, dirfd: os.INVALID_HANDLE, leaf: nil, mode: 0, stream: stream};
}

# the sink one invocation writes through: --check never writes source, a stream
# operand always writes its text, and every other operand rewrites in place
fun sink_for(kind: Operand, check: bool) Sink {
    if (check)                  { ret SINK_NAME; }
    if (kind == OPERAND_STREAM) { ret SINK_STREAM; }
    ret SINK_FILE;
}

fun environment(a: *A.Allocator, name: str, detail: str) outcome.Fail {
    val text: res[str, format.FormatError] = format.sprint(a, "{}: {}", name, detail);
    if (sel text.err) { ret outcome.environment(detail); }
    ret outcome.environment(text.ok);
}

fun os_failure(a: *A.Allocator, name: str, code: i64) outcome.Fail {
    ret environment(a, name, os.error_message(code));
}

fun finish_dir(a: *A.Allocator, fd: usize, name: str, result: err[outcome.Fail]) err[outcome.Fail] {
    val closed: i64 = os.close(fd);
    if (closed < 0) {
        if (sel result.err) { ret result; }
        ret err[outcome.Fail].err{os_failure(a, name, closed)};
    }
    ret result;
}

# open a regular file under a directory without following a symlink at the leaf
fun open_file(a: *A.Allocator, dirfd: usize, leaf: str, name: str, out: *usize) err[outcome.Fail] {
    var info:    os.stat_t;
    val checked: i64 = os.stat_path(dirfd, leaf, ?info, os.AT_SYMLINK_NOFOLLOW);
    if (checked < 0) { ret err[outcome.Fail].err{os_failure(a, name, checked)}; }
    if ((native.stat_mode(?info) & os.S_IFMT) != os.S_IFREG) {
        ret err[outcome.Fail].err{environment(a, name, "source must be a regular file")};
    }
    var flags: i32 = os.O_RDONLY;
    $if ($mach.build.os == $mach.os.linux || $mach.build.os == $mach.os.darwin) {
        flags = flags | nofollow.O_NOFOLLOW | nofollow.O_NONBLOCK;
    }
    val opened: i64 = os.open(dirfd, leaf, flags, 0, out);
    if (opened < 0) { ret err[outcome.Fail].err{os_failure(a, name, opened)}; }
    ret err[outcome.Fail].ok{};
}

# the whole file as one nul-terminated string; a nul byte inside is refused
# since the formatter reads its input as a nul-terminated string
fun read_text(a: *A.Allocator, fd: usize, name: str) res[str, outcome.Fail] {
    var bytes: Vector[u8] = vector.init[u8](a);
    fin { vector.dnit[u8](?bytes); }
    var chunk: [4096]u8;
    for {
        val count: i64 = os.read(fd, ?chunk[0], 4096);
        if (count < 0)  { ret res[str, outcome.Fail].err{os_failure(a, name, count)}; }
        if (count == 0) { brk; }
        val room: res[usize, A.Error] = vector.reserve[u8](?bytes, count::usize);
        if (sel room.err) { ret res[str, outcome.Fail].err{outcome.refused(room.err)}; }
        var i: usize = 0;
        for (i < count::usize) {
            if (chunk[i] == 0) { ret res[str, outcome.Fail].err{environment(a, name, "source contains a nul byte")}; }
            bytes.data[bytes.len] = chunk[i];
            bytes.len             = bytes.len + 1;
            i                     = i + 1;
        }
    }
    val copied: res[str, StrError] = str_copy_slice(a, bytes.data::str, 0, bytes.len);
    if (sel copied.err) { ret res[str, outcome.Fail].err{outcome.user(outcome.str_text(copied.err))}; }
    ret res[str, outcome.Fail].ok{copied.ok};
}

# render the file's diagnostics the way every command does, located by path,
# line and column through a source map holding this one file
fun report_malformed(a: *A.Allocator, name: str, text: str, diags: *diagnostic.DiagnosticStore) err[outcome.Fail] {
    var sources: source.SourceMap = source.init(a);
    fin { source.dnit(?sources); }
    val added: res[source.FileId, fail.Fail] = source.add(?sources, name, text);
    if (sel added.err) { ret err[outcome.Fail].err{outcome.from_fail(added.err)}; }
    var w: writer.Writer = fs.writer(fs.STDERR);
    cli_diag.flush_sources(?w, ?sources, diags);
    ret err[outcome.Fail].ok{};
}

# every byte of `text` to one descriptor, or the first native refusal
fun write_all(fd: usize, text: str) i64 {
    val len:     usize = str_len(text);
    var written: usize = 0;
    for (written < len) {
        val n: i64 = os.write(fd, (text::usize + written)::*u8, len - written);
        if (n < 0) { ret n; }
        written = written + n::usize;
    }
    ret 0;
}

# the canonical text is written to `<leaf>.tmp` beside the source and renamed
# over it, so an interrupted rewrite leaves the original whole
fun replace_source(a: *A.Allocator, dirfd: usize, leaf: str, name: str, text: str, mode: i32) err[outcome.Fail] {
    val tmp_r: res[str, StrError] = str_join(a, leaf, ".tmp");
    if (sel tmp_r.err) { ret err[outcome.Fail].err{outcome.user(outcome.str_text(tmp_r.err))}; }
    val tmp: str = tmp_r.ok;
    fin { str_free(a, tmp); }
    var flags: i32 = os.O_CREAT | os.O_TRUNC | os.O_WRONLY;
    $if ($mach.build.os == $mach.os.linux || $mach.build.os == $mach.os.darwin) { flags = flags | nofollow.O_NOFOLLOW; }
    var fd:     usize = os.INVALID_HANDLE;
    val opened: i64   = os.open(dirfd, tmp, flags, mode, ?fd);
    if (opened < 0) { ret err[outcome.Fail].err{os_failure(a, name, opened)}; }
    var failure: i64 = write_all(fd, text);
    $if ($mach.build.os == $mach.os.linux || $mach.build.os == $mach.os.darwin) {
        if (failure == 0) { failure = os.set_mode(fd, mode); }
    }
    val closed: i64 = os.close(fd);
    if (failure == 0 && closed < 0) { failure = closed; }
    if (failure == 0)               { failure = os.rename(dirfd, tmp, dirfd, leaf); }
    if (failure < 0) {
        os.unlink(dirfd, tmp, 0);
        ret err[outcome.Fail].err{os_failure(a, name, failure)};
    }
    ret err[outcome.Fail].ok{};
}

# hand one input's canonical text to its destination. SINK_STREAM writes every
# time, since a stream operand owes its caller the source whether or not the
# layout moved; the other two sinks act only on a difference
fun emit(a: *A.Allocator, dest: *Destination, name: str, output: str, differs: bool) err[outcome.Fail] {
    if (dest.sink == SINK_STREAM) {
        val failure: i64 = write_all(dest.stream, output);
        if (failure < 0) { ret err[outcome.Fail].err{os_failure(a, name, failure)}; }
        ret err[outcome.Fail].ok{};
    }
    if (!differs) { ret err[outcome.Fail].ok{}; }
    if (dest.sink == SINK_NAME) {
        print.println(name);
        ret err[outcome.Fail].ok{};
    }
    val replaced: err[outcome.Fail] = replace_source(a, dest.dirfd, dest.leaf, name, output, dest.mode);
    if (sel replaced.err) { ret replaced; }
    print.println(name);
    ret err[outcome.Fail].ok{};
}

# the one path every operand takes: named text in, canonical text to the
# destination, a malformed input reported against its own name and counted
fun format_text(a: *A.Allocator, name: str, text: str, dest: *Destination, report: *Report) err[outcome.Fail] {
    report.visited = report.visited + 1;
    var diags: diagnostic.DiagnosticStore = diagnostic.store_init(a);
    fin { diagnostic.store_dnit(?diags); }
    val formatted: res[str, fail.Fail] = formatter.format_source(a, text, 1, ?diags);
    if (sel formatted.err) {
        if (fail.is_reported(formatted.err)) {
            report.malformed = report.malformed + 1;
            ret report_malformed(a, name, text, ?diags);
        }
        ret err[outcome.Fail].err{outcome.from_fail(formatted.err)};
    }
    val output: str = formatted.ok;
    fin { str_free(a, output); }
    val differs: bool = !str_equals(text, output);
    if (differs) { report.differing = report.differing + 1; }
    ret emit(a, dest, name, output, differs);
}

# format one open file; the replacement carries the original's permission bits
fun format_open_file(a: *A.Allocator, fd: usize, dirfd: usize, leaf: str, name: str, sink: Sink, report: *Report) err[outcome.Fail] {
    var info:    os.stat_t;
    val checked: i64 = os.stat(fd, ?info);
    if (checked < 0) { ret err[outcome.Fail].err{os_failure(a, name, checked)}; }
    if ((native.stat_mode(?info) & os.S_IFMT) != os.S_IFREG) {
        ret err[outcome.Fail].err{environment(a, name, "source must be a regular file")};
    }
    val read: res[str, outcome.Fail] = read_text(a, fd, name);
    if (sel read.err) { ret err[outcome.Fail].err{read.err}; }
    val text: str = read.ok;
    fin { str_free(a, text); }
    var dest: Destination = Destination{sink: sink, dirfd: dirfd, leaf: leaf, mode: (native.stat_mode(?info) & 0o7777)::i32, stream: os.INVALID_HANDLE};
    ret format_text(a, name, text, ?dest, report);
}

fun format_file(backing: *A.Allocator, dirfd: usize, leaf: str, name: str, sink: Sink, report: *Report) err[outcome.Fail] {
    var ar:     arena.Arena;
    val init_r: err[A.Error] = arena.init(?ar, backing, 0);
    if (sel init_r.err) { ret err[outcome.Fail].err{outcome.refused(init_r.err)}; }
    fin { arena.dnit(?ar); }
    var a:      A.Allocator;
    val make_r: err[A.Error] = arena.make(?a, ?ar);
    if (sel make_r.err) { ret err[outcome.Fail].err{outcome.refused(make_r.err)}; }
    var fd:     usize             = os.INVALID_HANDLE;
    val opened: err[outcome.Fail] = open_file(?a, dirfd, leaf, name, ?fd);
    if (sel opened.err) { ret opened; }
    var result: err[outcome.Fail] = format_open_file(?a, fd, dirfd, leaf, name, sink, report);
    val closed: i64               = os.close(fd);
    if (closed < 0 && sel result.ok) { result = err[outcome.Fail].err{os_failure(?a, name, closed)}; }
    ret result;
}

fun visit(a: *A.Allocator, dirfd: usize, leaf: str, name: str, sink: Sink, depth: usize, report: *Report) err[outcome.Fail] {
    var info:   os.stat_t;
    val probed: i64 = os.stat_path(dirfd, leaf, ?info, os.AT_SYMLINK_NOFOLLOW);
    if (probed < 0) { ret err[outcome.Fail].err{os_failure(a, name, probed)}; }
    val kind: u32 = native.stat_mode(?info) & os.S_IFMT;
    if (kind == os.S_IFDIR) {
        var child:  usize = os.INVALID_HANDLE;
        val opened: i64   = remove.open_dir(dirfd, leaf, ?child);
        if (opened < 0) { ret err[outcome.Fail].err{os_failure(a, name, opened)}; }
        ret finish_dir(a, child, name, walk(a, child, name, sink, depth + 1, report));
    }
    if (kind != os.S_IFREG) {
        ret err[outcome.Fail].err{environment(a, name, "symlinks and other non-regular source entries are refused")};
    }
    if (!str_ends_with(leaf, ".mach")) { ret err[outcome.Fail].ok{}; }
    ret format_file(a, dirfd, leaf, name, sink, report);
}

fun name_compare(a: *str, b: *str) i64 {
    val left:  str   = @a;
    val right: str   = @b;
    var i:     usize = 0;
    for (true) {
        val l: u8 = left[i];
        val r: u8 = right[i];
        if (l != r) {
            if (l < r) { ret -1; }
            ret 1;
        }
        if (l == 0) { ret 0; }
        i = i + 1;
    }
    ret 0;
}

# every entry of one directory in name order
fun walk(a: *A.Allocator, dirfd: usize, name: str, sink: Sink, depth: usize, report: *Report) err[outcome.Fail] {
    if (depth >= MAX_DEPTH) { ret err[outcome.Fail].err{environment(a, name, "source directory nesting exceeds 256")}; }
    var names: Vector[str] = vector.init[str](a);
    fin {
        var i: usize = 0;
        for (i < names.len) {
            str_free(a, names.data[i]);
            i = i + 1;
        }
        vector.dnit[str](?names);
    }
    var cursor:      os.DirectoryCursor     = os.DirectoryCursor{};
    val initialized: os.DirectoryInitResult = os.directory_init(?cursor, dirfd);
    var result:      err[outcome.Fail]      = err[outcome.Fail].ok{};
    if (initialized.code < 0) { result = err[outcome.Fail].err{os_failure(a, name, initialized.code)}; }
    or {
        for {
            var entry: os.DirectoryEntry;
            val next:  i64 = os.directory_next(?cursor, ?entry);
            if (next < 0) {
                result = err[outcome.Fail].err{os_failure(a, name, next)};
                brk;
            }
            if (next == 0)                                                   { brk; }
            if (str_equals(entry.name, ".") || str_equals(entry.name, "..")) { cnt; }
            val copied: res[str, StrError] = str_copy_slice(a, entry.name, 0, entry.length);
            if (sel copied.err) {
                result = err[outcome.Fail].err{outcome.user(outcome.str_text(copied.err))};
                brk;
            }
            val leaf:   str                 = copied.ok;
            val pushed: res[usize, A.Error] = vector.push[str](?names, leaf);
            if (sel pushed.err) {
                str_free(a, leaf);
                result = err[outcome.Fail].err{outcome.refused(pushed.err)};
                brk;
            }
        }
        val closed: i64 = os.directory_close(?cursor);
        if (closed < 0 && sel result.ok) { result = err[outcome.Fail].err{os_failure(a, name, closed)}; }
    }
    val listed: bool = sel result.ok;
    if (listed) {
        sort.sort_by[str](names.data, names.len, name_compare);
        var i: usize = 0;
        for (i < names.len) {
            val joined: res[str, A.Error] = path.join(a, name, names.data[i]);
            if (sel joined.err) {
                result = err[outcome.Fail].err{outcome.refused(joined.err)};
                brk;
            }
            val display: str = joined.ok;
            result = visit(a, dirfd, names.data[i], display, sink, depth, report);
            str_free(a, display);
            if (sel result.err) { brk; }
            i = i + 1;
        }
    }
    ret result;
}

# descend the manifest's source path one component at a time through held
# directory capabilities, so a symlinked component is refused rather than
# followed; the first component is compared against the dependency tree's
# identity so an alias of `dep` cannot be selected as the source
fun source_walk(a: *A.Allocator, dirfd: usize, rel: str, start: usize, name: str, sink: Sink, depth: usize, exclude: *identities.Identity, report: *Report) err[outcome.Fail] {
    if (depth >= MAX_DEPTH) { ret err[outcome.Fail].err{environment(a, name, "source directory nesting exceeds 256")}; }
    var end:    usize = start;
    val length: usize = str_len(rel);
    for (end < length && rel[end] != '/') { end = end + 1; }
    val copied: res[str, StrError] = str_copy_slice(a, rel, start, end - start);
    if (sel copied.err) { ret err[outcome.Fail].err{outcome.user(outcome.str_text(copied.err))}; }
    val leaf: str = copied.ok;
    fin { str_free(a, leaf); }
    var child:  usize = os.INVALID_HANDLE;
    val opened: i64   = remove.open_dir(dirfd, leaf, ?child);
    if (opened < 0) { ret err[outcome.Fail].err{os_failure(a, name, opened)}; }
    if (exclude != nil) {
        var identity:   identities.Identity;
        val identified: i64 = os.file_identity(child, ?identity);
        if (identified < 0) {
            ret finish_dir(a, child, name, err[outcome.Fail].err{os_failure(a, name, identified)});
        }
        if (identities.equal(@exclude, identity)) {
            ret finish_dir(a, child, name, err[outcome.Fail].err{outcome.user("project source cannot be the dependency tree")});
        }
    }
    var result: err[outcome.Fail] = err[outcome.Fail].ok{};
    if (end == length) { result = walk(a, child, name, sink, 0, report); }
    or                 { result = source_walk(a, child, rel, end + 1, name, sink, depth + 1, nil, report); }
    ret finish_dir(a, child, name, result);
}

# the manifest's `project.src`, cleaned, relative to the project root. only the
# `[project]` table is read, so formatting never needs a build profile
fun source_dir(a: *A.Allocator, manifest_path: str) res[str, outcome.Fail] {
    val bytes_r: res[Vector[u8], fs.FsError] = fs.read_bytes(a, manifest_path);
    if (sel bytes_r.err) {
        ret res[str, outcome.Fail].err{environment(a, manifest_path, outcome.fs_text(bytes_r.err))};
    }
    var bytes: Vector[u8] = bytes_r.ok;
    fin { vector.dnit[u8](?bytes); }
    val source_r: err[outcome.Fail] = manifest.validate_source_bytes(bytes.data, bytes.len);
    if (sel source_r.err) { ret res[str, outcome.Fail].err{source_r.err}; }
    val room: res[usize, A.Error] = vector.reserve[u8](?bytes, 1);
    if (sel room.err) { ret res[str, outcome.Fail].err{outcome.refused(room.err)}; }
    bytes.data[bytes.len] = 0;
    val tbl_r: res[toml.Table, toml.TomlError] = toml.parse(a, bytes.data::str);
    if (sel tbl_r.err) {
        ret res[str, outcome.Fail].err{outcome.user(outcome.toml_text(tbl_r.err))};
    }
    var tbl: toml.Table = tbl_r.ok;
    fin { toml.dnit(a, ?tbl); }
    var itn: intern.Interner = intern.init(a);
    fin { intern.dnit(?itn); }
    var m: manifest.Manifest = manifest.empty();
    fin { manifest.dnit(?m, a); }
    val parsed: err[outcome.Fail] = manifest.parse_project(a, ?itn, ?tbl, ?m);
    if (sel parsed.err) { ret res[str, outcome.Fail].err{parsed.err}; }
    val found: opt[str] = intern.lookup(?itn, m.src);
    if (sel found.none) { ret res[str, outcome.Fail].err{outcome.internal("the manifest's source directory is not interned")}; }
    val cleaned: res[str, A.Error] = path.clean(a, found.some);
    if (sel cleaned.err) { ret res[str, outcome.Fail].err{outcome.refused(cleaned.err)}; }
    ret res[str, outcome.Fail].ok{cleaned.ok};
}

# the dependency tree is identified through the root so the walk can never
# select it
fun walk_project(a: *A.Allocator, backing: *A.Allocator, root: usize, rel: str, sink: Sink, report: *Report) err[outcome.Fail] {
    var dep_fd:     usize         = os.INVALID_HANDLE;
    val dependency: i64           = remove.open_dir(root, "dep", ?dep_fd);
    val missing:    io_error.Kind = os.error_kind(dependency);
    if (missing == io_error.NOT_FOUND || missing == io_error.NOT_DIRECTORY) { ret source_walk(backing, root, rel, 0, rel, sink, 0, nil, report); }
    if (dependency < 0)                                                     { ret err[outcome.Fail].err{os_failure(a, "dep", dependency)}; }
    var result:     err[outcome.Fail] = err[outcome.Fail].ok{};
    var excluded:   identities.Identity;
    val identified: i64               = os.file_identity(dep_fd, ?excluded);
    if (identified < 0) { result = err[outcome.Fail].err{os_failure(a, "dep", identified)}; }
    or                  { result = source_walk(backing, root, rel, 0, rel, sink, 0, ?excluded, report); }
    ret finish_dir(a, dep_fd, "dep", result);
}

# format or check one project: the manifest names the source directory, the
# dependency tree is identified so it can never be selected, and the walk
# visits only the source tree
pub fun format_project(a: *A.Allocator, backing: *A.Allocator, project_root: str, manifest_path: str, sink: Sink) res[Report, outcome.Fail] {
    var report: Report                 = Report{visited: 0, differing: 0, malformed: 0};
    val rel_r:  res[str, outcome.Fail] = source_dir(a, manifest_path);
    if (sel rel_r.err) { ret res[Report, outcome.Fail].err{rel_r.err}; }
    val rel: str = rel_r.ok;
    fin { str_free(a, rel); }
    var root:   usize = os.INVALID_HANDLE;
    val opened: i64   = remove.open_path(project_root, ?root);
    if (opened < 0) { ret res[Report, outcome.Fail].err{os_failure(a, project_root, opened)}; }
    var result: err[outcome.Fail] = walk_project(a, backing, root, rel, sink, ?report);
    result = finish_dir(a, root, project_root, result);
    if (sel result.err) { ret res[Report, outcome.Fail].err{result.err}; }
    ret res[Report, outcome.Fail].ok{report};
}

# format one source file named directly, with no manifest read: the file's own
# directory is opened so the leaf is handled exactly as the project walk handles it
pub fun format_one_file(a: *A.Allocator, backing: *A.Allocator, operand: str, sink: Sink) res[Report, outcome.Fail] {
    var report: Report = Report{visited: 0, differing: 0, malformed: 0};
    val leaf:   str    = path.filename(operand);
    if (leaf == nil || str_equals(leaf, "")) {
        ret res[Report, outcome.Fail].err{outcome.user("mach fmt: the source operand names no file")};
    }
    val parent_r: res[str, A.Error] = path.parent(a, operand);
    if (sel parent_r.err) { ret res[Report, outcome.Fail].err{outcome.refused(parent_r.err)}; }
    val parent: str = parent_r.ok;
    fin { str_free(a, parent); }
    var dirfd:  usize = os.INVALID_HANDLE;
    val opened: i64   = remove.open_path(parent, ?dirfd);
    if (opened < 0) { ret res[Report, outcome.Fail].err{os_failure(a, parent, opened)}; }
    var result: err[outcome.Fail] = format_file(backing, dirfd, leaf, operand, sink, ?report);
    result = finish_dir(a, dirfd, parent, result);
    if (sel result.err) { ret res[Report, outcome.Fail].err{result.err}; }
    ret res[Report, outcome.Fail].ok{report};
}

# format the source arriving on one descriptor onto another; nothing on disk is
# read or written, so no manifest is involved at any point. the descriptors are
# parameters rather than the process streams so the caller owns that binding
pub fun format_stream(a: *A.Allocator, in_fd: usize, out_fd: usize, sink: Sink) res[Report, outcome.Fail] {
    var report: Report                 = Report{visited: 0, differing: 0, malformed: 0};
    val read:   res[str, outcome.Fail] = read_text(a, in_fd, STREAM_NAME);
    if (sel read.err) { ret res[Report, outcome.Fail].err{read.err}; }
    val text: str = read.ok;
    fin { str_free(a, text); }
    var dest:   Destination       = detached(sink, out_fd);
    val result: err[outcome.Fail] = format_text(a, STREAM_NAME, text, ?dest, ?report);
    if (sel result.err) { ret res[Report, outcome.Fail].err{result.err}; }
    ret res[Report, outcome.Fail].ok{report};
}

# which form the operand takes. `-` is the stream; a directory, or a file named
# mach.toml, is a project; any other existing file is a single source
pub fun classify(operand: str) res[Operand, outcome.Fail] {
    if (operand == nil) {
        ret res[Operand, outcome.Fail].err{outcome.user("mach fmt expects one operand: a project path, a source file, or '-' for stdin")};
    }
    if (str_equals(operand, STREAM_OPERAND)) { ret res[Operand, outcome.Fail].ok{OPERAND_STREAM}; }
    val is_dir: res[bool, io_error.Error] = fs.is_dir(operand);
    if (sel is_dir.ok && is_dir.ok) { ret res[Operand, outcome.Fail].ok{OPERAND_PROJECT}; }
    val is_file: res[bool, io_error.Error] = fs.is_file(operand);
    if (sel is_file.ok && is_file.ok) {
        if (str_equals(path.filename(operand), util.PROJECT_CONFIG_NAME)) { ret res[Operand, outcome.Fail].ok{OPERAND_PROJECT}; }
        ret res[Operand, outcome.Fail].ok{OPERAND_SOURCE};
    }
    ret res[Operand, outcome.Fail].err{outcome.user("mach fmt operand is not a directory, a file, or '-' for stdin")};
}

fun run_project(a: *A.Allocator, backing: *A.Allocator, operand: str, sink: Sink) res[Report, outcome.Fail] {
    val loc_r: res[util.ProjectLocation, outcome.Fail] = util.resolve_project_location(a, operand);
    if (sel loc_r.err) { ret res[Report, outcome.Fail].err{loc_r.err}; }
    val loc: util.ProjectLocation = loc_r.ok;
    ret format_project(a, backing, loc.root, loc.manifest, sink);
}

# `mach fmt <path>|<file>|- [--check]`
# ---
# argv: the full process arguments
# inv:  the parsed invocation for this command
# ret:  0 every input is canonical (or was made so), 1 an input differs under
#       --check, an input is malformed, or the invocation is a user error, 2 internal
#       failure, 3 filesystem failure
pub fun run(argv: **u8, inv: *args.ParsedInvocation) i64 {
    if (args.reject_unknown_from_invocation(inv, argv, "mach fmt")) { ret 1; }
    if (inv.positional_count != 1) {
        val f: outcome.Fail = outcome.user("mach fmt expects one operand: a project path, a source file, or '-' for stdin");
        ret cli_diag.render_fail(?f);
    }
    var backing: A.Allocator;
    val make_r:  err[A.Error] = page.make(?backing);
    if (sel make_r.err) {
        val f: outcome.Fail = outcome.internal("failed to initialise allocator");
        ret cli_diag.render_fail(?f);
    }
    var ar:     arena.Arena;
    val init_r: err[A.Error] = arena.init(?ar, ?backing, 0);
    if (sel init_r.err) {
        val f: outcome.Fail = outcome.internal("failed to initialise allocator");
        ret cli_diag.render_fail(?f);
    }
    fin { arena.dnit(?ar); }
    var a:       A.Allocator;
    val make_r2: err[A.Error] = arena.make(?a, ?ar);
    if (sel make_r2.err) {
        val f: outcome.Fail = outcome.internal("failed to initialise allocator");
        ret cli_diag.render_fail(?f);
    }
    val operand: str                        = argv[inv.positional_idx];
    val kind_r:  res[Operand, outcome.Fail] = classify(operand);
    if (sel kind_r.err) {
        val f: outcome.Fail = kind_r.err;
        ret cli_diag.render_fail(?f);
    }
    val kind:     Operand                   = kind_r.ok;
    val check:    bool                      = args.invocation_flag(args.CMD_FMT, inv, "--check");
    val sink:     Sink                      = sink_for(kind, check);
    var report_r: res[Report, outcome.Fail] = res[Report, outcome.Fail].ok{Report{visited: 0, differing: 0, malformed: 0}};
    if (kind == OPERAND_STREAM) { report_r = format_stream(?a, fs.STDIN.handle.value, fs.STDOUT.handle.value, sink); }
    or (kind == OPERAND_SOURCE) { report_r = format_one_file(?a, ?backing, operand, sink); }
    or                          { report_r = run_project(?a, ?backing, operand, sink); }
    if (sel report_r.err) {
        val f: outcome.Fail = report_r.err;
        ret cli_diag.render_fail(?f);
    }
    val report: Report = report_r.ok;
    if (report.malformed != 0)          { ret 1; }
    if (check && report.differing != 0) { ret 1; }
    ret 0;
}

use fixture: mach.lang.output.testing;

fun t_write(a: *A.Allocator, root: str, rel: str, text: str, mode: i32) bool {
    val joined: res[str, A.Error] = path.join(a, root, rel);
    if (sel joined.err) { ret false; }
    val name: str = joined.ok;
    fin { str_free(a, name); }
    val written: err[fs.FsError] = fs.write_bytes(name, text, str_len(text), mode);
    ret sel written.ok;
}

fun t_same(a: *A.Allocator, root: str, rel: str, expected: str) bool {
    val joined: res[str, A.Error] = path.join(a, root, rel);
    if (sel joined.err) { ret false; }
    val name: str = joined.ok;
    fin { str_free(a, name); }
    val read: res[str, fs.FsError] = fs.read_string(a, name);
    if (sel read.err) { ret false; }
    val text: str = read.ok;
    fin { str_free(a, text); }
    ret str_equals(text, expected);
}

fun t_run(a: *A.Allocator, root: str, check: bool) i64 {
    var argv:  [4]*u8 = [4]*u8{"mach", "fmt", root, "--check"};
    var count: usize  = 3;
    if (check) { count = 4; }
    val parsed: res[args.ParsedInvocation, outcome.Fail] = args.parse_invocation(a, count, ?argv[0]);
    if (sel parsed.err) { ret 2; }
    var inv: args.ParsedInvocation = parsed.ok;
    fin { args.dnit_invocation(a, ?inv); }
    ret run(?argv[0], ?inv);
}

# open a directory beneath a fixture root, or os.INVALID_HANDLE
fun t_dir(root: str, rel: str) usize {
    var dir:    usize = os.INVALID_HANDLE;
    val opened: i64   = remove.open_path(root, ?dir);
    if (opened < 0)          { ret os.INVALID_HANDLE; }
    if (str_equals(rel, "")) { ret dir; }
    var child:   usize = os.INVALID_HANDLE;
    val entered: i64   = remove.open_dir(dir, rel, ?child);
    os.close(dir);
    if (entered < 0) { ret os.INVALID_HANDLE; }
    ret child;
}

val T_MANIFEST: str = "[project]\nid=\"fmtfixture\"\nversion=\"0.0.0\"\nsrc=\"src\"\nout=\"out\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n[artifact.main]\nkind=\"bin\"\nentry=\"src/main.mach\"\nout=\"bin/main{artifact.suffix}\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n";

test "mach.cli.cmd.fmt:check_is_read_only_and_formatting_preserves_modes_and_excludes_dependencies" {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val created: res[fixture.Output, outcome.Fail] = fixture.create(?a, "mach-fmt");
    if (sel created.err) { ret 2; }
    var owner: fixture.Output = created.ok;
    fin { fixture.dnit(?owner); }
    val root: usize = t_dir(owner.directory, "");
    if (root == os.INVALID_HANDLE) { ret 3; }
    fin { os.close(root); }
    if (os.make_dir(root, "src", 0o700) < 0 || os.make_dir(root, "dep", 0o700) < 0) { ret 4; }
    val src: usize = t_dir(owner.directory, "src");
    if (src == os.INVALID_HANDLE) { ret 6; }
    fin { os.close(src); }
    if (os.make_dir(src, "nested", 0o700) < 0) { ret 4; }
    val original:  str = "fun main()i32{ret 0;}";
    val canonical: str = "fun main() i32 {\n    ret 0;\n}\n";
    if (!t_write(?a, owner.directory, "mach.toml", T_MANIFEST, 0o600)
        || !t_write(?a, owner.directory, "src/main.mach", original, 0o751)
        || !t_write(?a, owner.directory, "src/nested/leaf.mach", canonical, 0o600)
        || !t_write(?a, owner.directory, "src/notes.txt", original, 0o600)
        || !t_write(?a, owner.directory, "dep/untouched.mach", "fun broken(", 0o600)) { ret 5; }
    $if ($mach.build.os == $mach.os.linux || $mach.build.os == $mach.os.darwin) {
        var mode_fd: usize             = os.INVALID_HANDLE;
        val opened:  err[outcome.Fail] = open_file(?a, src, "main.mach", "main.mach", ?mode_fd);
        if (sel opened.err) { ret 16; }
        val changed: i64 = os.set_mode(mode_fd, 0o774);
        val closed:  i64 = os.close(mode_fd);
        if (changed < 0 || closed < 0) { ret 17; }
    }
    var before: os.stat_t;
    if (os.stat_path(src, "main.mach", ?before, os.AT_SYMLINK_NOFOLLOW) < 0)                                { ret 7; }
    if (t_run(?a, owner.directory, true) != 1 || !t_same(?a, owner.directory, "src/main.mach", original))   { ret 8; }
    if (t_run(?a, owner.directory, false) != 0 || !t_same(?a, owner.directory, "src/main.mach", canonical)) { ret 10; }
    if (t_exists(?a, owner.directory, "src/main.mach.tmp"))                                                 { ret 9; }
    var after: os.stat_t;
    if (os.stat_path(src, "main.mach", ?after, os.AT_SYMLINK_NOFOLLOW) < 0
        || (native.stat_mode(?before) & 0o7777) != (native.stat_mode(?after) & 0o7777)) { ret 11; }
    if (t_run(?a, owner.directory, true) != 0 || t_run(?a, owner.directory, false) != 0) { ret 12; }
    if (!t_same(?a, owner.directory, "dep/untouched.mach", "fun broken(")
        || !t_same(?a, owner.directory, "src/notes.txt", original)
        || !t_same(?a, owner.directory, "src/nested/leaf.mach", canonical)
        || !t_same(?a, owner.directory, "mach.toml", T_MANIFEST)) { ret 13; }
    if (!t_write(?a, owner.directory, "src/main.mach", "fun broken(", 0o600))                                   { ret 14; }
    if (t_run(?a, owner.directory, false) != 1 || !t_same(?a, owner.directory, "src/main.mach", "fun broken(")) { ret 15; }
    if (t_run(?a, owner.directory, true) != 1 || !t_same(?a, owner.directory, "src/main.mach", "fun broken("))  { ret 18; }
    ret 0;
}

fun t_read_tree(a: *A.Allocator, root: str, out: *Vector[u8]) bool {
    val entries: [4]str = [4]str{"mach.toml", "src/main.mach", "src/nested/leaf.mach", "src/notes.txt"};
    var i:       usize  = 0;
    for (i < 4) {
        val joined: res[str, A.Error] = path.join(a, root, entries[i]);
        if (sel joined.err) { ret false; }
        val name: str = joined.ok;
        fin { str_free(a, name); }
        val read: res[Vector[u8], fs.FsError] = fs.read_bytes(a, name);
        if (sel read.err) { ret false; }
        var bytes: Vector[u8] = read.ok;
        fin { vector.dnit[u8](?bytes); }
        var b: usize = 0;
        for (b < bytes.len) {
            val pushed: res[usize, A.Error] = vector.push[u8](out, bytes.data[b]);
            if (sel pushed.err) { ret false; }
            b = b + 1;
        }
        val mark: res[usize, A.Error] = vector.push[u8](out, 0);
        if (sel mark.err) { ret false; }
        i = i + 1;
    }
    ret true;
}

test "mach.cli.cmd.fmt:check_leaves_every_byte_of_the_tree_in_place" {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val created: res[fixture.Output, outcome.Fail] = fixture.create(?a, "mach-fmt-check");
    if (sel created.err) { ret 2; }
    var owner: fixture.Output = created.ok;
    fin { fixture.dnit(?owner); }
    val root: usize = t_dir(owner.directory, "");
    if (root == os.INVALID_HANDLE) { ret 3; }
    fin { os.close(root); }
    if (os.make_dir(root, "src", 0o700) < 0) { ret 4; }
    val src: usize = t_dir(owner.directory, "src");
    if (src == os.INVALID_HANDLE) { ret 12; }
    fin { os.close(src); }
    if (os.make_dir(src, "nested", 0o700) < 0) { ret 4; }
    if (!t_write(?a, owner.directory, "mach.toml", T_MANIFEST, 0o600)
        || !t_write(?a, owner.directory, "src/main.mach", "fun main()i32{ret 0;}", 0o600)
        || !t_write(?a, owner.directory, "src/nested/leaf.mach", "fun f(){ # note\n}", 0o600)
        || !t_write(?a, owner.directory, "src/notes.txt", "fun main()i32{ret 0;}", 0o600)) { ret 5; }
    var before: Vector[u8] = vector.init[u8](?a);
    fin { vector.dnit[u8](?before); }
    if (!t_read_tree(?a, owner.directory, ?before)) { ret 6; }
    if (t_run(?a, owner.directory, true) != 1)      { ret 7; }
    var after: Vector[u8] = vector.init[u8](?a);
    fin { vector.dnit[u8](?after); }
    if (!t_read_tree(?a, owner.directory, ?after)) { ret 8; }
    if (before.len != after.len)                   { ret 9; }
    var i: usize = 0;
    for (i < before.len) {
        if (before.data[i] != after.data[i]) { ret 10; }
        i = i + 1;
    }
    ret 0;
}

fun t_exists(a: *A.Allocator, root: str, rel: str) bool {
    val joined: res[str, A.Error] = path.join(a, root, rel);
    if (sel joined.err) { ret false; }
    val name: str = joined.ok;
    fin { str_free(a, name); }
    var st: os.stat_t;
    ret os.stat_path(os.working_dir(), name, ?st, os.AT_SYMLINK_NOFOLLOW) >= 0;
}

test "mach.cli.cmd.fmt:a_rewrite_leaves_nothing_but_sources" {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val created: res[fixture.Output, outcome.Fail] = fixture.create(?a, "mach-fmt-home");
    if (sel created.err) { ret 2; }
    var owner: fixture.Output = created.ok;
    fin { fixture.dnit(?owner); }
    if (fs_failed(fs.create_dir_all(?a, sfmt_join(?a, owner.directory, "src/nested"), 0o700))) { ret 3; }
    if (!t_write(?a, owner.directory, "mach.toml", T_MANIFEST, 0o600)
        || !t_write(?a, owner.directory, "src/main.mach", "fun main()i32{ret 0;}", 0o600)
        || !t_write(?a, owner.directory, "src/nested/leaf.mach", "fun f(){ # note\n}", 0o600)) { ret 7; }
    if (t_run(?a, owner.directory, true) != 1 || t_exists(?a, owner.directory, "out")) { ret 8; }
    if (t_run(?a, owner.directory, false) != 0)                                        { ret 9; }
    if (t_exists(?a, owner.directory, "out")
        || t_exists(?a, owner.directory, "src/main.mach.tmp")
        || t_exists(?a, owner.directory, "src/nested/leaf.mach.tmp")) { ret 11; }
    if (t_run(?a, owner.directory, false) != 0) { ret 13; }
    val relative: str = "./mach_fmt_relative_home";
    fs.remove_all(?a, relative);
    fin { fs.remove_all(?a, relative); }
    if (fs_failed(fs.create_dir_all(?a, "./mach_fmt_relative_home/src/nested", 0o700))) { ret 14; }
    if (!t_write(?a, relative, "mach.toml", T_MANIFEST, 0o600)
        || !t_write(?a, relative, "src/main.mach", "fun main()i32{ret 0;}", 0o600)
        || !t_write(?a, relative, "src/nested/leaf.mach", "fun f(){ # note\n}", 0o600)) { ret 15; }
    if (t_run(?a, relative, false) != 0 || t_exists(?a, relative, "out")) { ret 16; }
    ret 0;
}

fun sfmt_join(a: *A.Allocator, root: str, rel: str) str {
    val joined: res[str, A.Error] = path.join(a, root, rel);
    if (sel joined.err) { ret ""; }
    ret joined.ok;
}

fun fs_failed(r: err[fs.FsError]) bool {
    ret sel r.err;
}

test "mach.cli.cmd.fmt:rejects_symlink_source_without_rewriting_its_target" {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val created: res[fixture.Output, outcome.Fail] = fixture.create(?a, "mach-fmt-link");
    if (sel created.err) { ret 2; }
    var owner: fixture.Output = created.ok;
    fin { fixture.dnit(?owner); }
    val joined: res[str, A.Error] = path.join(?a, owner.directory, "src");
    if (sel joined.err) { ret 3; }
    val src: str = joined.ok;
    fin { str_free(?a, src); }
    val made: err[io_error.Error] = fs.create_dir(src, 0o700);
    if (sel made.err || !t_write(?a, owner.directory, "mach.toml", T_MANIFEST, 0o600)
        || !t_write(?a, owner.directory, "outside.mach", "fun main()i32{ret 0;}", 0o600)) { ret 4; }
    val link_r: res[str, A.Error] = path.join(?a, src, "main.mach");
    if (sel link_r.err) { ret 5; }
    val link: str = link_r.ok;
    fin { str_free(?a, link); }
    val linked: err[io_error.Error] = fs.symlink("../outside.mach", link);
    if (sel linked.err)                                                                  { ret 6; }
    if (t_run(?a, owner.directory, true) != 3 || t_run(?a, owner.directory, false) != 3) { ret 7; }
    if (!t_same(?a, owner.directory, "outside.mach", "fun main()i32{ret 0;}"))           { ret 8; }
    val unlinked: err[io_error.Error] = fs.remove_file(link);
    if (sel unlinked.err) { ret 9; }
    val removed: err[fs.FsError] = fs.remove_all(?a, src);
    if (sel removed.err) { ret 9; }
    val aliased: err[io_error.Error] = fs.symlink(".", src);
    if (sel aliased.err)                       { ret 10; }
    if (t_run(?a, owner.directory, true) != 3) { ret 11; }
    ret 0;
}

test "mach.cli.cmd.fmt:source_aliases_cannot_select_the_dependency_directory" {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val created: res[fixture.Output, outcome.Fail] = fixture.create(?a, "mach-fmt-dep");
    if (sel created.err) { ret 2; }
    var owner: fixture.Output = created.ok;
    fin { fixture.dnit(?owner); }
    val root: usize = t_dir(owner.directory, "");
    if (root == os.INVALID_HANDLE) { ret 3; }
    fin { os.close(root); }
    var source_setting: str = "src=\"dep\"";
    $if ($mach.build.os == $mach.os.windows)                                                 { source_setting = "src=\"DEP\""; }
    if (os.make_dir(root, "dep", 0o700) < 0)                                                 { ret 4; }
    if (!t_write(?a, owner.directory, "dep/untouched.mach", "fun main()i32{ret 0;}", 0o600)) { ret 6; }
    val invalid_r: res[str, StrError] = str_replace(?a, T_MANIFEST, "src=\"src\"", source_setting);
    if (sel invalid_r.err) { ret 7; }
    val invalid: str = invalid_r.ok;
    fin { str_free(?a, invalid); }
    if (!t_write(?a, owner.directory, "mach.toml", invalid, 0o600)
        || t_run(?a, owner.directory, true) != 1 || t_run(?a, owner.directory, false) != 1) { ret 8; }
    if (!t_same(?a, owner.directory, "dep/untouched.mach", "fun main()i32{ret 0;}")) { ret 9; }
    ret 0;
}

# a manifest with no [profile.*] table: everything mach fmt reads, nothing a
# build would need
val T_BARE_MANIFEST: str = "[project]\nid=\"fmtbare\"\nversion=\"0.0.0\"\nsrc=\"src\"\nout=\"out\"\n";

fun t_open(a: *A.Allocator, root: str, rel: str, flags: i32, mode: i32) usize {
    val joined: res[str, A.Error] = path.join(a, root, rel);
    if (sel joined.err) { ret os.INVALID_HANDLE; }
    val name: str = joined.ok;
    fin { str_free(a, name); }
    var handle: usize = os.INVALID_HANDLE;
    val opened: i64   = os.open(os.working_dir(), name, flags, mode, ?handle);
    if (opened < 0) { ret os.INVALID_HANDLE; }
    ret handle;
}

fun t_text(a: *A.Allocator, root: str, rel: str) str {
    val joined: res[str, A.Error] = path.join(a, root, rel);
    if (sel joined.err) { ret nil; }
    val name: str = joined.ok;
    fin { str_free(a, name); }
    val read: res[str, fs.FsError] = fs.read_string(a, name);
    if (sel read.err) { ret nil; }
    ret read.ok;
}

# format `input` through the descriptor pair and answer the resulting report,
# leaving the canonical text in `out_rel`
fun t_stream(a: *A.Allocator, root: str, input: str, out_rel: str, sink: Sink, report: *Report) bool {
    if (!t_write(a, root, "stream.in", input, 0o600)) { ret false; }
    if (!t_write(a, root, out_rel, "", 0o600))        { ret false; }
    val in_fd: usize = t_open(a, root, "stream.in", os.O_RDONLY, 0);
    if (in_fd == os.INVALID_HANDLE) { ret false; }
    fin { os.close(in_fd); }
    val out_fd: usize = t_open(a, root, out_rel, os.O_CREAT | os.O_TRUNC | os.O_WRONLY, 0o600);
    if (out_fd == os.INVALID_HANDLE) { ret false; }
    val formatted: res[Report, outcome.Fail] = format_stream(a, in_fd, out_fd, sink);
    os.close(out_fd);
    if (sel formatted.err) { ret false; }
    @report = formatted.ok;
    ret true;
}

test "mach.cli.cmd.fmt:a_file_operand_formats_only_that_file_with_no_manifest" {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val created: res[fixture.Output, outcome.Fail] = fixture.create(?a, "mach-fmt-file");
    if (sel created.err) { ret 2; }
    var owner: fixture.Output = created.ok;
    fin { fixture.dnit(?owner); }
    val original:  str = "fun main()i32{ret 0;}";
    val canonical: str = "fun main() i32 {\n    ret 0;\n}\n";
    if (!t_write(?a, owner.directory, "lone.mach", original, 0o600)
        || !t_write(?a, owner.directory, "sibling.mach", original, 0o600)) { ret 3; }
    val operand: str = sfmt_join(?a, owner.directory, "lone.mach");
    if (t_exists(?a, owner.directory, "mach.toml"))                                                 { ret 4; }
    if (t_run(?a, operand, true) != 1 || !t_same(?a, owner.directory, "lone.mach", original))       { ret 5; }
    if (t_run(?a, operand, false) != 0 || !t_same(?a, owner.directory, "lone.mach", canonical))     { ret 6; }
    if (!t_same(?a, owner.directory, "sibling.mach", original))                                     { ret 7; }
    if (t_exists(?a, owner.directory, "lone.mach.tmp"))                                             { ret 8; }
    if (t_run(?a, operand, true) != 0 || t_run(?a, operand, false) != 0)                            { ret 9; }
    if (!t_write(?a, owner.directory, "lone.mach", "fun broken(", 0o600))                           { ret 10; }
    if (t_run(?a, operand, false) != 1 || !t_same(?a, owner.directory, "lone.mach", "fun broken(")) { ret 11; }
    ret 0;
}

test "mach.cli.cmd.fmt:a_project_without_a_profile_table_formats" {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val created: res[fixture.Output, outcome.Fail] = fixture.create(?a, "mach-fmt-bare");
    if (sel created.err) { ret 2; }
    var owner: fixture.Output = created.ok;
    fin { fixture.dnit(?owner); }
    if (fs_failed(fs.create_dir_all(?a, sfmt_join(?a, owner.directory, "src"), 0o700))) { ret 3; }
    val canonical: str = "fun main() i32 {\n    ret 0;\n}\n";
    if (!t_write(?a, owner.directory, "mach.toml", T_BARE_MANIFEST, 0o600)
        || !t_write(?a, owner.directory, "src/main.mach", "fun main()i32{ret 0;}", 0o600)) { ret 4; }
    if (t_run(?a, owner.directory, true) != 1) { ret 5; }
    if (t_run(?a, owner.directory, false) != 0
        || !t_same(?a, owner.directory, "src/main.mach", canonical)) { ret 6; }
    if (t_run(?a, owner.directory, true) != 0) { ret 7; }
    ret 0;
}

test "mach.cli.cmd.fmt:a_stream_formats_to_its_descriptor_exactly_as_a_project_file" {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val created: res[fixture.Output, outcome.Fail] = fixture.create(?a, "mach-fmt-stream");
    if (sel created.err) { ret 2; }
    var owner: fixture.Output = created.ok;
    fin { fixture.dnit(?owner); }
    val original: str = "fun main()i32{ret 0;}";
    var report:   Report;
    if (!t_stream(?a, owner.directory, original, "stream.out", SINK_STREAM, ?report)) { ret 3; }
    if (report.visited != 1 || report.differing != 1 || report.malformed != 0)        { ret 4; }
    val streamed: str = t_text(?a, owner.directory, "stream.out");
    if (streamed == nil)                                                                { ret 5; }
    if (fs_failed(fs.create_dir_all(?a, sfmt_join(?a, owner.directory, "src"), 0o700))) { ret 6; }
    if (!t_write(?a, owner.directory, "mach.toml", T_MANIFEST, 0o600)
        || !t_write(?a, owner.directory, "src/main.mach", original, 0o600)) { ret 7; }
    if (t_run(?a, owner.directory, false) != 0) { ret 8; }
    val on_disk: str = t_text(?a, owner.directory, "src/main.mach");
    if (on_disk == nil || !str_equals(streamed, on_disk)) { ret 9; }
    var canonical_report: Report;
    if (!t_stream(?a, owner.directory, streamed, "again.out", SINK_STREAM, ?canonical_report)) { ret 10; }
    if (canonical_report.differing != 0)                                                       { ret 11; }
    if (!t_same(?a, owner.directory, "again.out", streamed))                                   { ret 12; }
    var empty_report: Report;
    if (!t_stream(?a, owner.directory, "", "empty.out", SINK_STREAM, ?empty_report)) { ret 13; }
    if (empty_report.differing != 0 || empty_report.malformed != 0)                  { ret 14; }
    if (!t_same(?a, owner.directory, "empty.out", ""))                               { ret 15; }
    ret 0;
}

test "mach.cli.cmd.fmt:a_stream_under_check_and_a_malformed_stream_write_no_source" {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val created: res[fixture.Output, outcome.Fail] = fixture.create(?a, "mach-fmt-stream-check");
    if (sel created.err) { ret 2; }
    var owner: fixture.Output = created.ok;
    fin { fixture.dnit(?owner); }
    var differing: Report;
    if (!t_stream(?a, owner.directory, "fun main()i32{ret 0;}", "check.out", SINK_NAME, ?differing)) { ret 3; }
    if (differing.differing != 1 || !t_same(?a, owner.directory, "check.out", ""))                   { ret 4; }
    var canonical: Report;
    if (!t_stream(?a, owner.directory, "fun main() i32 {\n    ret 0;\n}\n", "clean.out", SINK_NAME, ?canonical)) { ret 5; }
    if (canonical.differing != 0 || !t_same(?a, owner.directory, "clean.out", ""))                               { ret 6; }
    var malformed: Report;
    if (!t_stream(?a, owner.directory, "fun broken(", "bad.out", SINK_STREAM, ?malformed)) { ret 7; }
    if (malformed.malformed != 1 || malformed.differing != 0)                              { ret 8; }
    if (!t_same(?a, owner.directory, "bad.out", ""))                                       { ret 9; }
    ret 0;
}

# the classified operand, or 255 when classification refused it
fun t_kind(classified: res[Operand, outcome.Fail]) Operand {
    if (sel classified.err) { ret 255; }
    ret classified.ok;
}

test "mach.cli.cmd.fmt:classify_separates_the_stream_the_project_and_a_lone_source" {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val created: res[fixture.Output, outcome.Fail] = fixture.create(?a, "mach-fmt-classify");
    if (sel created.err) { ret 2; }
    var owner: fixture.Output = created.ok;
    fin { fixture.dnit(?owner); }
    if (!t_write(?a, owner.directory, "mach.toml", T_BARE_MANIFEST, 0o600)
        || !t_write(?a, owner.directory, "lone.mach", "fun f() {}\n", 0o600)) { ret 3; }
    if (t_kind(classify("-")) != OPERAND_STREAM)                                          { ret 4; }
    if (t_kind(classify(owner.directory)) != OPERAND_PROJECT)                             { ret 5; }
    if (t_kind(classify(sfmt_join(?a, owner.directory, "mach.toml"))) != OPERAND_PROJECT) { ret 6; }
    if (t_kind(classify(sfmt_join(?a, owner.directory, "lone.mach"))) != OPERAND_SOURCE)  { ret 7; }
    val missing: res[Operand, outcome.Fail] = classify(sfmt_join(?a, owner.directory, "absent.mach"));
    if (sel missing.ok) { ret 8; }
    val none: res[Operand, outcome.Fail] = classify(nil);
    if (sel none.ok) { ret 9; }
    ret 0;
}
