use fs:        std.filesystem;
use io_error:  std.io.error;
use io_writer: std.io.writer;
use std.types.bool.bool;
use std.types.bool.false;

use std.types.error.err;
use types_path: std.types.path;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use A: std.allocator;

use mach.cli.args;
use mach.cli.exit;
use mach.cli.rewrite;
use mach.cli.util;
use mach.lang.diagnostic;
use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.fail;
use fe_format:   mach.lang.fe.format;
use lang_source: mach.lang.source;

# how the operand names its input
# ---
# stream:  `-`, the source arrives on stdin
# source:  one source file, formatted with no manifest read
# project: a directory holding a mach.toml, or the mach.toml itself
pub def Operand: u8;
val OPERAND_STREAM:  Operand = 0;
val OPERAND_SOURCE:  Operand = 1;
val OPERAND_PROJECT: Operand = 2;

# the operand spelling that names stdin
val STREAM_OPERAND: str = "-";

# the sink one invocation writes through: --check never writes source, a stream
# operand always writes its text, and every other operand rewrites in place
fun sink_for(kind: Operand, check: bool) rewrite.Sink {
    if (check)                  { ret rewrite.SINK_NAME; }
    if (kind == OPERAND_STREAM) { ret rewrite.SINK_STREAM; }
    ret rewrite.SINK_FILE;
}

# a source's text in the one canonical layout
fun canonical(a: *A.Allocator, text: str, diags: *diagnostic.DiagnosticStore) res[str, fail.Fail] {
    ret fe_format.format_source(a, text, lang_source.file_id(1), diags);
}

# which form the operand takes. `-` is the stream; a directory, or a file named
# mach.toml, is a project; any other existing file is a single source
pub fun classify(operand: str) res[Operand, fail.Fail] {
    if (operand == nil) {
        ret res[Operand, fail.Fail].err{fail.user(diagnostic_kind.CLI_OPERAND, "mach fmt expects one operand: a project path, a source file, or '-' for stdin")};
    }
    if (str_equals(operand, STREAM_OPERAND)) { ret res[Operand, fail.Fail].ok{OPERAND_STREAM}; }
    val is_dir: res[bool, io_error.Error] = fs.is_dir(operand);
    if (sel is_dir.ok && is_dir.ok) { ret res[Operand, fail.Fail].ok{OPERAND_PROJECT}; }
    val is_file: res[bool, io_error.Error] = fs.is_file(operand);
    if (sel is_file.ok && is_file.ok) {
        if (str_equals(types_path.filename(operand), util.PROJECT_CONFIG_NAME)) { ret res[Operand, fail.Fail].ok{OPERAND_PROJECT}; }
        ret res[Operand, fail.Fail].ok{OPERAND_SOURCE};
    }
    ret res[Operand, fail.Fail].err{fail.user(diagnostic_kind.CLI_OPERAND, "mach fmt operand is not a directory, a file, or '-' for stdin")};
}

fun run_project(a: *A.Allocator, backing: *A.Allocator, operand: str, sink: rewrite.Sink, report: *rewrite.Report) err[fail.Fail] {
    val loc_r: res[util.ProjectLocation, fail.Fail] = util.resolve_project_location(a, operand);
    if (sel loc_r.err) { ret err[fail.Fail].err{loc_r.err}; }
    val loc: util.ProjectLocation = loc_r.ok;
    ret rewrite.project(a, backing, loc.root, loc.manifest, sink, report);
}

# row count of OWN
val OWN_N: usize = 1;
# the options mach fmt accepts
val OWN: [OWN_N]*args.FlagSpec = [OWN_N]*args.FlagSpec{?rewrite.CHECK};

# length of TABLES
val TABLES_N: usize = 1;
# the option tables mach fmt accepts
val TABLES: [TABLES_N]args.TableRef = [TABLES_N]args.TableRef{
    args.TableRef{rows: ?OWN[0], n: OWN_N, accepted: nil, docs: nil},
};

# length of EXITS
val EXITS_N: usize = 1;
# the exit codes fmt documents beside exit.SHARED
val EXITS: [EXITS_N]exit.Note = [EXITS_N]exit.Note{
    exit.Note{code: exit.USER, meaning: "a malformed input, or in check mode an input whose layout differs"},
};

# `mach fmt`
pub val COMMAND: args.CommandSpec = args.CommandSpec{name: "fmt", aliases: nil, alias_n: 0, grammar: " <path>|<file>|- [--check]", summary: "format source in the canonical layout", effect: "a directory or mach.toml operand rewrites that project's own source files in the one canonical layout, reading only [project].src so no build profile is needed; any other file operand rewrites that one file with no manifest read; '-' reads source from stdin and writes its canonical layout to stdout. with --check nothing is written and every input whose layout differs is named on stdout. dependencies are never visited or fetched", exits: ?EXITS[0], exit_n: EXITS_N, terminator: "", tables: ?TABLES[0], table_n: TABLES_N, refused: nil, refused_n: 0, refusal: "", relations: nil, relation_n: 0, constraints: nil, constraint_n: 0, operand_min: 1, operand_max: 1, truncate_at_sep: false, actions: nil, action_n: 0, examples: nil, example_n: 0, run: run};

# `mach fmt <path>|<file>|- [--check]`
# ---
# cx:  the call
# ret: exit.OK when every input is canonical (or was made so), exit.USER when an input differs
#      under --check or is malformed, otherwise the failure
pub fun run(cx: *args.Call) res[i64, fail.Fail] {
    val operand: str                     = cx.argv[cx.inv.positional_idx];
    val kind_r:  res[Operand, fail.Fail] = classify(operand);
    if (sel kind_r.err) { ret res[i64, fail.Fail].err{kind_r.err}; }
    val kind:        Operand          = kind_r.ok;
    val check:       bool             = args.given(cx.inv, ?rewrite.CHECK);
    val sink:        rewrite.Sink     = sink_for(kind, check);
    var diagnostics: io_writer.Writer = fs.writer(fs.STDERR);
    var report:      rewrite.Report   = rewrite.report(?diagnostics, canonical);
    var done:        err[fail.Fail]   = err[fail.Fail].ok{};
    if (kind == OPERAND_STREAM)         { done = rewrite.stream(cx.a, fs.STDIN.handle.value, fs.STDOUT.handle.value, sink, ?report); }
    or (kind == OPERAND_SOURCE)         { done = rewrite.file(cx.a, cx.backing, operand, sink, ?report); }
    or                                  { done = run_project(cx.a, cx.backing, operand, sink, ?report); }
    if (sel done.err)                   { ret res[i64, fail.Fail].err{done.err}; }
    if (report.malformed != 0)          { ret res[i64, fail.Fail].ok{exit.USER}; }
    if (check && report.differing != 0) { ret res[i64, fail.Fail].ok{exit.USER}; }
    ret res[i64, fail.Fail].ok{exit.OK};
}
