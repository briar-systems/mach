use std.allocator.page;
use std.io.writer;
use std.process.env;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_contains;
use std.types.string.str_equals;
use std.types.string.str_len;

use A: std.allocator;
use O: std.types.option;
use R: std.types.result;

use mach.cli.args;
use mach.lang.textbuild;
use mach.lang.version;

val DEFAULT_WIDTH: usize = 100;
val MIN_WIDTH:     usize = 56;
val FLAG_COL:      usize = 24;

# what a help request resolved to
pub def HelpRouteKind: u8;
# argv is not a help request
pub val HELP_ROUTE_NONE:      HelpRouteKind = 0;
# the command overview
pub val HELP_ROUTE_OVERVIEW:  HelpRouteKind = 1;
# one command's page
pub val HELP_ROUTE_COMMAND:   HelpRouteKind = 2;
# a help request that names an unknown command or has the wrong shape
pub val HELP_ROUTE_MALFORMED: HelpRouteKind = 3;

# where a help request routes
# ---
# kind: the HELP_ROUTE_* value
# command: the command whose page to render, for HELP_ROUTE_COMMAND
# token: the unknown command word, for HELP_ROUTE_MALFORMED; empty when the shape itself was wrong
pub rec HelpRoute {
    kind:    HelpRouteKind;
    command: args.CommandId;
    token:   str;
}

fun is_help_token(s: str) bool {
    ret str_equals(s, "-h") || str_equals(s, "--help");
}

# decide whether argv is a help request and which page it wants
# `mach help`, `mach -h`, `mach --help`, and `mach help help` route to the overview;
# `mach help <cmd>` and `mach <cmd> -h|--help` to the command page. a help word with extra
# arguments, an unknown command followed by a help token, or a help token anywhere else
# among the arguments is malformed; tokens after `--` are not inspected for commands that
# truncate at the separator. fewer than two arguments is not a help request
# ---
# argc: process argument count
# argv: process arguments, argv[0] the program
# ret: the route; HELP_ROUTE_NONE when argv is not a help request
pub fun resolve_help_route(argc: usize, argv: **u8) HelpRoute {
    var r: HelpRoute;
    r.kind    = HELP_ROUTE_NONE;
    r.command = args.CMD_NONE;
    r.token   = "";

    if (argc < 2) { ret r; }

    val first: str = argv[1]::str;
    if (str_equals(first, "help")) {
        if (argc == 2) { r.kind = HELP_ROUTE_OVERVIEW; ret r; }
        if (argc == 3) {
            val second: str = argv[2]::str;
            if (is_help_token(second) || str_equals(second, "help")) {
                r.kind = HELP_ROUTE_OVERVIEW;
                ret r;
            }
            val cmd_o: O.Option[args.CommandId] = args.command_lookup(second);
            if (O.is_some[args.CommandId](cmd_o)) {
                r.kind    = HELP_ROUTE_COMMAND;
                r.command = O.unwrap[args.CommandId](cmd_o);
                ret r;
            }
            r.kind  = HELP_ROUTE_MALFORMED;
            r.token = second;
            ret r;
        }
        r.kind = HELP_ROUTE_MALFORMED;
        ret r;
    }

    if (is_help_token(first)) {
        if (argc == 2) { r.kind = HELP_ROUTE_OVERVIEW; ret r; }
        r.kind = HELP_ROUTE_MALFORMED;
        ret r;
    }

    val cmd_o: O.Option[args.CommandId] = args.command_lookup(first);
    if (O.is_none[args.CommandId](cmd_o)) {
        if (argc == 3 && is_help_token(argv[2]::str)) {
            r.kind  = HELP_ROUTE_MALFORMED;
            r.token = first;
            ret r;
        }
    }
    or (argc >= 3 && is_help_token(argv[2]::str)) {
        if (argc == 3) {
            r.kind    = HELP_ROUTE_COMMAND;
            r.command = O.unwrap[args.CommandId](cmd_o);
            ret r;
        }
        r.kind = HELP_ROUTE_MALFORMED;
        ret r;
    }

    var bound: usize = argc;
    if (O.is_some[args.CommandId](cmd_o)) {
        val command: *args.CommandSpec = args.command_spec(O.unwrap[args.CommandId](cmd_o));
        if (command != nil && command.truncate_at_sep) {
            var sep: usize = 2;
            for (sep < argc) {
                if (str_equals(argv[sep]::str, "--")) { bound = sep; sep = argc; cnt; }
                sep = sep + 1;
            }
        }
    }
    var i: usize = 1;
    for (i < bound) {
        val token: str = argv[i]::str;
        if (str_equals(token, "help") || is_help_token(token)) {
            r.kind = HELP_ROUTE_MALFORMED;
            ret r;
        }
        i = i + 1;
    }
    ret r;
}

fun append(b: *textbuild.TextBuilder, s: str) bool {
    ret R.is_ok[R.Void, str](textbuild.tb_append(b, s));
}

fun append_spaces(b: *textbuild.TextBuilder, n: usize) bool {
    var i: usize = 0;
    for (i < n) {
        if (!append(b, " ")) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun append_range(b: *textbuild.TextBuilder, s: str, start: usize, end: usize) bool {
    var one: [2]u8;
    one[1] = 0;
    var i: usize = start;
    for (i < end) {
        one[0] = s[i];
        if (!append(b, (?one[0])::str)) { ret false; }
        i = i + 1;
    }
    ret true;
}

rec WrapState {
    col:          usize;
    continuation: usize;
    width:        usize;
    has_text:     bool;
}

fun wrap_append(b: *textbuild.TextBuilder, state: *WrapState, text: str) bool {
    val n: usize = str_len(text);
    var i: usize = 0;
    for (i < n) {
        for (i < n && (text[i] == ' ' || text[i] == '\t' || text[i] == '\n' || text[i] == '\r')) { i = i + 1; }
        if (i >= n) { ret true; }
        val start: usize = i;
        for (i < n && text[i] != ' ' && text[i] != '\t' && text[i] != '\n' && text[i] != '\r') { i = i + 1; }
        val word_len: usize = i - start;
        var need: usize = word_len;
        if (state.has_text) { need = need + 1; }
        if (state.has_text && state.col + need > state.width) {
            if (!append(b, "\n") || !append_spaces(b, state.continuation)) { ret false; }
            state.col = state.continuation;
            state.has_text = false;
        }
        if (state.has_text) {
            if (!append(b, " ")) { ret false; }
            state.col = state.col + 1;
        }
        if (!append_range(b, text, start, i)) { ret false; }
        state.col = state.col + word_len;
        state.has_text = true;
    }
    ret true;
}

fun wrap_finish(b: *textbuild.TextBuilder) bool {
    ret append(b, "\n");
}

fun normalized_width(width: usize) usize {
    if (width < MIN_WIDTH) { ret MIN_WIDTH; }
    if (width > 240) { ret 240; }
    ret width;
}

fun terminal_width() usize {
    var buf: [16]u8;
    val n: i64 = env.get("COLUMNS", ?buf[0], 16);
    if (n <= 0 || n >= 16) { ret DEFAULT_WIDTH; }
    var width: usize = 0;
    var i: usize = 0;
    for (i < n::usize) {
        if (buf[i] < '0' || buf[i] > '9') { ret DEFAULT_WIDTH; }
        width = width * 10 + (buf[i] - '0')::usize;
        i = i + 1;
    }
    ret normalized_width(width);
}

fun render_option_meta(b: *textbuild.TextBuilder, indent: str, label: str, value: str, width: usize) bool {
    if (!append(b, indent) || !append(b, "  ") || !append(b, label)) { ret false; }
    var state: WrapState;
    state.col = str_len(indent) + 2 + str_len(label);
    state.continuation = str_len(indent) + 4;
    state.width = width;
    state.has_text = str_len(label) > 0;
    if (!wrap_append(b, ?state, value)) { ret false; }
    ret wrap_finish(b);
}

fun render_option(b: *textbuild.TextBuilder, flag: *args.FlagSpec, indent: str, width: usize) bool {
    if (!append(b, indent) || !append(b, flag.name)) { ret false; }
    var label_width: usize = str_len(indent) + str_len(flag.name);
    if (str_len(flag.value) > 0) {
        if (!append(b, " <") || !append(b, flag.value) || !append(b, ">")) { ret false; }
        label_width = label_width + str_len(flag.value) + 3;
    }
    var description_col: usize = FLAG_COL + str_len(indent) - 2;
    if (description_col + 12 > width) { description_col = str_len(indent) + 4; }
    if (label_width < description_col) {
        if (!append_spaces(b, description_col - label_width)) { ret false; }
    }
    or {
        if (!append(b, "\n") || !append_spaces(b, description_col)) { ret false; }
    }
    var state: WrapState;
    state.col = description_col;
    state.continuation = description_col;
    state.width = width;
    state.has_text = false;
    if (!wrap_append(b, ?state, flag.doc) || !wrap_finish(b)) { ret false; }
    if (str_len(flag.default) > 0) {
        if (!render_option_meta(b, indent, "default:", flag.default, width)) { ret false; }
    }
    if (flag.repeatable && !render_option_meta(b, indent, "", "repeatable", width)) { ret false; }
    if (str_len(flag.conflicts) > 0) {
        if (!render_option_meta(b, indent, "conflicts:", flag.conflicts, width)) { ret false; }
    }
    if (str_len(flag.implies) > 0) {
        if (!render_option_meta(b, indent, "implies:", flag.implies, width)) { ret false; }
    }
    if (str_len(flag.alias_of) > 0) {
        if (!render_option_meta(b, indent, "alias of:", flag.alias_of, width)) { ret false; }
    }
    ret true;
}

fun render_tables(b: *textbuild.TextBuilder, tables: *args.TableRef, table_n: usize, indent: str, width: usize) bool {
    var i: usize = 0;
    for (i < table_n) {
        val table: args.TableRef = tables[i];
        var j: usize = 0;
        for (j < table.n) {
            if (table.accepted != nil && !table.accepted[j]) { j = j + 1; cnt; }
            if (!render_option(b, ?table.table[j], indent, width)) { ret false; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret true;
}

fun render_aliases(b: *textbuild.TextBuilder, aliases: *str, alias_n: usize) bool {
    if (alias_n == 0) { ret true; }
    if (!append(b, "aliases:\n")) { ret false; }
    var i: usize = 0;
    for (i < alias_n) {
        if (!append(b, "  ") || !append(b, aliases[i]) || !append(b, "\n")) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun render_examples(b: *textbuild.TextBuilder, examples: *str, example_n: usize, indent: str, width: usize) bool {
    if (example_n == 0) { ret true; }
    if (!append(b, "\n") || !append(b, indent) || !append(b, "examples:\n")) { ret false; }
    var i: usize = 0;
    for (i < example_n) {
        if (!append(b, indent) || !append(b, "  ")) { ret false; }
        var state: WrapState;
        state.col = str_len(indent) + 2;
        state.continuation = state.col;
        state.width = width;
        state.has_text = false;
        if (!wrap_append(b, ?state, examples[i]) || !wrap_finish(b)) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun render_constraints(b: *textbuild.TextBuilder, constraints: *str, constraint_n: usize, indent: str, width: usize) bool {
    if (constraint_n == 0) { ret true; }
    if (!append(b, "\n") || !append(b, indent) || !append(b, "constraints:\n")) { ret false; }
    var i: usize = 0;
    for (i < constraint_n) {
        if (!append(b, indent) || !append(b, "  ")) { ret false; }
        var state: WrapState;
        state.col = str_len(indent) + 2;
        state.continuation = state.col;
        state.width = width;
        state.has_text = false;
        if (!wrap_append(b, ?state, constraints[i]) || !wrap_finish(b)) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun render_overview_body(b: *textbuild.TextBuilder, width: usize) bool {
    if (!append(b, "mach ") || !append(b, version.MACH_VERSION) || !append(b, " - the Mach compiler\n\n")) { ret false; }
    if (!append(b, "usage: mach <command> [options]\n\ncommands:\n")) { ret false; }
    var i: usize = 0;
    for (i < args.CMD_N) {
        val command: *args.CommandSpec = ?args.COMMANDS[i];
        if (!append(b, "  ") || !append(b, command.name)) { ret false; }
        val label_width: usize = 2 + str_len(command.name);
        if (label_width < 12 && !append_spaces(b, 12 - label_width)) { ret false; }
        if (label_width >= 12 && !append(b, "\n            ")) { ret false; }
        var state: WrapState;
        state.col = 12;
        state.continuation = 12;
        state.width = width;
        state.has_text = false;
        if (!wrap_append(b, ?state, command.summary)) { ret false; }
        if (command.alias_n > 0) {
            if (!wrap_append(b, ?state, "(aliases:")) { ret false; }
            var j: usize = 0;
            for (j < command.alias_n) {
                if (!wrap_append(b, ?state, command.aliases[j])) { ret false; }
                j = j + 1;
            }
            if (!wrap_append(b, ?state, ")")) { ret false; }
        }
        if (!wrap_finish(b)) { ret false; }
        i = i + 1;
    }
    if (!append(b, "\n")) { ret false; }
    var footer: WrapState;
    footer.col = 0;
    footer.continuation = 0;
    footer.width = width;
    footer.has_text = false;
    ret wrap_append(b, ?footer, "use 'mach help <command>' or 'mach <command> -h' for detailed usage.")
        && wrap_finish(b);
}

fun render_actions(b: *textbuild.TextBuilder, width: usize) bool {
    if (!append(b, "\nactions:\n")) { ret false; }
    var i: usize = 0;
    for (i < args.DEPACT_N) {
        val action: *args.DepActionSpec = ?args.DEP_ACTIONS[i];
        if (!append(b, "  ")) { ret false; }
        var heading: WrapState;
        heading.col = 2;
        heading.continuation = 4;
        heading.width = width;
        heading.has_text = false;
        if (!wrap_append(b, ?heading, action.name) || !wrap_append(b, ?heading, action.grammar)
            || !wrap_finish(b) || !append(b, "    ")) { ret false; }
        var effect: WrapState;
        effect.col = 4;
        effect.continuation = 4;
        effect.width = width;
        effect.has_text = false;
        if (!wrap_append(b, ?effect, action.effect)) { ret false; }
        if (str_len(action.alias_of) > 0) {
            if (!wrap_finish(b) || !append(b, "    alias of: ")) { ret false; }
            var alias_state: WrapState;
            alias_state.col = 14;
            alias_state.continuation = 4;
            alias_state.width = width;
            alias_state.has_text = false;
            if (!wrap_append(b, ?alias_state, action.alias_of)) { ret false; }
        }
        if (!wrap_finish(b) || !append(b, "    exit:")) { ret false; }
        var exits: WrapState;
        exits.col = 9;
        exits.continuation = 10;
        exits.width = width;
        exits.has_text = true;
        if (!wrap_append(b, ?exits, action.exits) || !wrap_finish(b)) { ret false; }
        if (action.table_n > 0) {
            if (!append(b, "    options:\n") || !render_tables(b, action.tables, action.table_n, "      ", width)) { ret false; }
        }
        if (!render_constraints(b, action.constraints, action.constraint_n, "    ", width)) { ret false; }
        if (!render_examples(b, action.examples, action.example_n, "    ", width)) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun render_command_body(b: *textbuild.TextBuilder, id: args.CommandId, width: usize) bool {
    val command: *args.CommandSpec = args.command_spec(id);
    if (command == nil) { ret false; }
    if (command.id == args.CMD_HELP) { ret render_overview_body(b, width); }
    if (!append(b, "usage: mach")) { ret false; }
    var usage: WrapState;
    usage.col = 11;
    usage.continuation = 2;
    usage.width = width;
    usage.has_text = true;
    if (!wrap_append(b, ?usage, command.name) || !wrap_append(b, ?usage, command.grammar)
        || !wrap_finish(b) || !append(b, "\n")) { ret false; }
    if (!render_aliases(b, command.aliases, command.alias_n)) { ret false; }
    if (!append(b, "effect:")) { ret false; }
    var effect: WrapState;
    effect.col = 7;
    effect.continuation = 8;
    effect.width = width;
    effect.has_text = true;
    if (!wrap_append(b, ?effect, command.effect) || !wrap_finish(b)) { ret false; }
    if (str_len(command.terminator) > 0) {
        if (!append(b, "terminator:")) { ret false; }
        var terminator: WrapState;
        terminator.col = 11;
        terminator.continuation = 12;
        terminator.width = width;
        terminator.has_text = true;
        if (!wrap_append(b, ?terminator, command.terminator) || !wrap_finish(b)) { ret false; }
    }
    if (command.table_n > 0) {
        if (!append(b, "\noptions:\n") || !render_tables(b, command.tables, command.table_n, "  ", width)) { ret false; }
    }
    if (!render_constraints(b, command.constraints, command.constraint_n, "", width)) { ret false; }
    if (command.has_action && !render_actions(b, width)) { ret false; }
    if (!render_examples(b, command.examples, command.example_n, "", width)) { ret false; }
    if (!append(b, "\nexit:")) { ret false; }
    var exits: WrapState;
    exits.col = 5;
    exits.continuation = 6;
    exits.width = width;
    exits.has_text = true;
    ret wrap_append(b, ?exits, command.exits) && wrap_finish(b);
}

fun publish(b: *textbuild.TextBuilder, out: *writer.Writer) R.Result[R.Void, str] {
    if (textbuild.tb_failed(b)) {
        textbuild.tb_dnit(b);
        ret R.err[R.Void, str]("help: failed to build output");
    }
    val err: O.Option[str] = writer.write_all(out, b.data, b.len);
    textbuild.tb_dnit(b);
    if (O.is_some[str](err)) { ret R.err[R.Void, str](O.unwrap[str](err)); }
    ret R.ok_void[str]();
}

# write the command overview wrapped to a width
# ---
# a: allocator for the text buffer
# out: the destination
# requested_width: columns; clamped to the range 56 to 240
# ret: ok, or an error when the command schema is invalid, the buffer could not be built,
#  or the write failed
pub fun render_overview_at(a: *A.Allocator, out: *writer.Writer, requested_width: usize) R.Result[R.Void, str] {
    if (!args.schema_valid()) { ret R.err[R.Void, str]("help: invalid command schema"); }
    val width: usize = normalized_width(requested_width);
    var b: textbuild.TextBuilder = textbuild.tb_init(a);
    render_overview_body(?b, width);
    ret publish(?b, out);
}

# write the command overview at the terminal width read from COLUMNS, 100 when unset or
# not a number
# ---
# a: allocator for the text buffer
# out: the destination
# ret: as render_overview_at
pub fun render_overview(a: *A.Allocator, out: *writer.Writer) R.Result[R.Void, str] {
    ret render_overview_at(a, out, terminal_width());
}

# write one command's help page wrapped to a width
# ---
# a: allocator for the text buffer
# out: the destination
# id: the command; an id with no record is an error
# requested_width: columns; clamped to the range 56 to 240
# ret: ok, or an error when the command schema is invalid, the command is unknown, the
#  buffer could not be built, or the write failed
pub fun render_command_page_at(a: *A.Allocator, out: *writer.Writer, id: args.CommandId,
                               requested_width: usize) R.Result[R.Void, str] {
    if (!args.schema_valid()) { ret R.err[R.Void, str]("help: invalid command schema"); }
    val width: usize = normalized_width(requested_width);
    var b: textbuild.TextBuilder = textbuild.tb_init(a);
    if (!render_command_body(?b, id, width)) {
        if (!textbuild.tb_failed(?b)) {
            textbuild.tb_dnit(?b);
            ret R.err[R.Void, str]("help: unknown command page");
        }
    }
    ret publish(?b, out);
}

# write one command's help page at the terminal width read from COLUMNS, 100 when unset or
# not a number
# ---
# a: allocator for the text buffer
# out: the destination
# id: the command
# ret: as render_command_page_at
pub fun render_command_page(a: *A.Allocator, out: *writer.Writer, id: args.CommandId) R.Result[R.Void, str] {
    ret render_command_page_at(a, out, id, terminal_width());
}

fun render_malformed(a: *A.Allocator, err: *writer.Writer, route: *HelpRoute) R.Result[R.Void, str] {
    var b: textbuild.TextBuilder = textbuild.tb_init(a);
    if (str_len(route.token) > 0) {
        append(?b, "error: unknown command '");
        append(?b, route.token);
        append(?b, "'\n");
    }
    or {
        append(?b, "error: malformed help request\n");
    }
    ret publish(?b, err);
}

# render a resolved help route
# ---
# a: allocator for the text buffer
# out: overview and command pages go here
# err: malformed-request errors go here
# route: from resolve_help_route
# ret: 0 for a rendered page, 1 for a malformed request or HELP_ROUTE_NONE, 2 when rendering failed
pub fun render_route(a: *A.Allocator, out: *writer.Writer, err: *writer.Writer, route: *HelpRoute) i64 {
    if (route.kind == HELP_ROUTE_OVERVIEW) {
        if (R.is_err[R.Void, str](render_overview(a, out))) { ret 2; }
        ret 0;
    }
    if (route.kind == HELP_ROUTE_COMMAND) {
        if (R.is_err[R.Void, str](render_command_page(a, out, route.command))) { ret 2; }
        ret 0;
    }
    if (route.kind == HELP_ROUTE_MALFORMED) {
        if (R.is_err[R.Void, str](render_malformed(a, err, route))) { ret 2; }
        ret 1;
    }
    ret 1;
}

rec MemSink {
    buf:      *u8;
    cap:      usize;
    len:      usize;
    fail_at:  usize;
    fail:     bool;
}

fun mem_write(ctx: ptr, buf: *u8, len: usize) R.Result[usize, str] {
    val sink: *MemSink = ctx::*MemSink;
    if (sink.fail && sink.len >= sink.fail_at) { ret R.err[usize, str]("injected writer failure"); }
    var n: usize = len;
    if (sink.fail && sink.len + n > sink.fail_at) { n = sink.fail_at - sink.len; }
    if (sink.len + n > sink.cap) { ret R.err[usize, str]("test sink full"); }
    var i: usize = 0;
    for (i < n) { sink.buf[sink.len + i] = buf[i]; i = i + 1; }
    sink.len = sink.len + n;
    ret R.ok[usize, str](n);
}

fun mem_writer(w: *writer.Writer, sink: *MemSink, buf: *u8, cap: usize) {
    sink.buf = buf; sink.cap = cap; sink.len = 0; sink.fail_at = 0; sink.fail = false;
    w.ctx = sink::ptr; w.f_write = mem_write;
}

fun sink_text(sink: *MemSink) str {
    sink.buf[sink.len] = 0;
    ret sink.buf::str;
}

fun max_line_width(text: str) usize {
    val n: usize = str_len(text);
    var max: usize = 0;
    var line: usize = 0;
    var i: usize = 0;
    for (i < n) {
        if (text[i] == '\n') {
            if (line > max) { max = line; }
            line = 0;
        }
        or { line = line + 1; }
        i = i + 1;
    }
    if (line > max) { max = line; }
    ret max;
}

fun fail_allocate(ctx: ptr, size: usize, align: usize) O.Option[ptr] { ret O.none[ptr](); }
fun fail_reallocate(ctx: ptr, p: ptr, old_size: usize, new_size: usize, align: usize) O.Option[ptr] { ret O.none[ptr](); }
fun fail_deallocate(ctx: ptr, p: ptr, size: usize, align: usize) i64 { ret 0; }

test "mach.cli.cmd.help.resolve_help_route:accepts_only_exact_help_forms" {
    var a0: [2]*u8; a0[0] = "mach"; a0[1] = "-h";
    if (resolve_help_route(2, ?a0[0]).kind != HELP_ROUTE_OVERVIEW) { ret 1; }
    a0[1] = "--help";
    if (resolve_help_route(2, ?a0[0]).kind != HELP_ROUTE_OVERVIEW) { ret 2; }
    a0[1] = "help";
    if (resolve_help_route(2, ?a0[0]).kind != HELP_ROUTE_OVERVIEW) { ret 3; }

    var a1: [3]*u8; a1[0] = "mach"; a1[1] = "help"; a1[2] = "-h";
    if (resolve_help_route(3, ?a1[0]).kind != HELP_ROUTE_OVERVIEW) { ret 4; }
    a1[2] = "--help";
    if (resolve_help_route(3, ?a1[0]).kind != HELP_ROUTE_OVERVIEW) { ret 5; }
    a1[2] = "help";
    if (resolve_help_route(3, ?a1[0]).kind != HELP_ROUTE_OVERVIEW) { ret 6; }
    a1[2] = "build";
    val command_route: HelpRoute = resolve_help_route(3, ?a1[0]);
    if (command_route.kind != HELP_ROUTE_COMMAND || command_route.command != args.CMD_BUILD) { ret 7; }

    a1[1] = "test"; a1[2] = "--help";
    val local_route: HelpRoute = resolve_help_route(3, ?a1[0]);
    if (local_route.kind != HELP_ROUTE_COMMAND || local_route.command != args.CMD_TEST) { ret 8; }

    var i: usize = 0;
    for (i < args.CMD_N) {
        val command: *args.CommandSpec = ?args.COMMANDS[i];
        if (command.id == args.CMD_HELP) { i = i + 1; cnt; }
        a1[1] = "help"; a1[2] = command.name::*u8;
        val named: HelpRoute = resolve_help_route(3, ?a1[0]);
        if (named.kind != HELP_ROUTE_COMMAND || named.command != command.id) { ret 9; }
        a1[1] = command.name::*u8; a1[2] = "-h";
        val short: HelpRoute = resolve_help_route(3, ?a1[0]);
        if (short.kind != HELP_ROUTE_COMMAND || short.command != command.id) { ret 10; }
        a1[2] = "--help";
        val long: HelpRoute = resolve_help_route(3, ?a1[0]);
        if (long.kind != HELP_ROUTE_COMMAND || long.command != command.id) { ret 11; }
        var j: usize = 0;
        for (j < command.alias_n) {
            a1[1] = "help"; a1[2] = command.aliases[j]::*u8;
            val alias_named: HelpRoute = resolve_help_route(3, ?a1[0]);
            if (alias_named.kind != HELP_ROUTE_COMMAND || alias_named.command != command.id) { ret 12; }
            a1[1] = command.aliases[j]::*u8; a1[2] = "--help";
            val alias_local: HelpRoute = resolve_help_route(3, ?a1[0]);
            if (alias_local.kind != HELP_ROUTE_COMMAND || alias_local.command != command.id) { ret 13; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret 0;
}

test "mach.cli.cmd.help.resolve_help_route:rejects_unknown_duplicate_and_extra_forms" {
    var a0: [3]*u8; a0[0] = "mach"; a0[1] = "help"; a0[2] = "bogus";
    val unknown: HelpRoute = resolve_help_route(3, ?a0[0]);
    if (unknown.kind != HELP_ROUTE_MALFORMED || !str_equals(unknown.token, "bogus")) { ret 1; }

    var a1: [4]*u8; a1[0] = "mach"; a1[1] = "build"; a1[2] = "-h"; a1[3] = "--help";
    if (resolve_help_route(4, ?a1[0]).kind != HELP_ROUTE_MALFORMED) { ret 2; }
    a1[1] = "help"; a1[2] = "build"; a1[3] = "extra";
    if (resolve_help_route(4, ?a1[0]).kind != HELP_ROUTE_MALFORMED) { ret 3; }

    var a2: [4]*u8; a2[0] = "mach"; a2[1] = "build"; a2[2] = "."; a2[3] = "-h";
    if (resolve_help_route(4, ?a2[0]).kind != HELP_ROUTE_MALFORMED) { ret 4; }

    var a3: [3]*u8; a3[0] = "mach"; a3[1] = "bogus"; a3[2] = "--help";
    val unknown_local: HelpRoute = resolve_help_route(3, ?a3[0]);
    if (unknown_local.kind != HELP_ROUTE_MALFORMED || !str_equals(unknown_local.token, "bogus")) { ret 5; }

    a1[1] = "build"; a1[2] = "--target"; a1[3] = "-h";
    if (resolve_help_route(4, ?a1[0]).kind != HELP_ROUTE_MALFORMED) { ret 6; }
    a1[1] = "build"; a1[2] = "--quiet"; a1[3] = "--help";
    if (resolve_help_route(4, ?a1[0]).kind != HELP_ROUTE_MALFORMED) { ret 7; }
    a1[1] = "init"; a1[2] = "help"; a1[3] = "extra";
    if (resolve_help_route(4, ?a1[0]).kind != HELP_ROUTE_MALFORMED) { ret 8; }

    var forwarded: [4]*u8; forwarded[0] = "mach"; forwarded[1] = "run"; forwarded[2] = "--"; forwarded[3] = "--help";
    if (resolve_help_route(4, ?forwarded[0]).kind != HELP_ROUTE_NONE) { ret 9; }
    ret 0;
}

test "mach.cli.cmd.help.render:overview_and_pages_come_from_schema_order" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    var out_buf: [32768]u8; var out_sink: MemSink; var out: writer.Writer;
    mem_writer(?out, ?out_sink, ?out_buf[0], 32767);
    if (R.is_err[R.Void, str](render_overview(?alloc, ?out))) { ret 2; }
    val overview: str = sink_text(?out_sink);
    if (!str_contains(overview, "  build     compile a project")) { ret 3; }
    if (!str_contains(overview, "  help      show command help")) { ret 4; }

    out_sink.len = 0;
    if (R.is_err[R.Void, str](render_command_page(?alloc, ?out, args.CMD_BUILD))) { ret 5; }
    val build: str = sink_text(?out_sink);
    if (!str_contains(build, "usage: mach build <path> [options] [inputs...]")) { ret 6; }
    if (!str_contains(build, "--profile <name>")) { ret 7; }
    if (!str_contains(build, "default: sole or default profile")) { ret 8; }
    if (!str_contains(build, "--bin <name>")) { ret 9; }
    if (!str_contains(build, "--bin and --lib cannot be combined")) { ret 10; }
    if (!str_contains(build, "-L <dir>")) { ret 11; }
    if (!str_contains(build, "repeatable")) { ret 12; }

    out_sink.len = 0;
    if (R.is_err[R.Void, str](render_command_page(?alloc, ?out, args.CMD_DEP))) { ret 13; }
    val dep: str = sink_text(?out_sink);
    if (!str_contains(dep, "add <name> (--git <url> [--ref <ref>] | --path <dir>)")) { ret 14; }
    if (!str_contains(dep, "--git <url>")) { ret 15; }
    if (!str_contains(dep, "--purge")) { ret 16; }
    if (!str_contains(dep, "--all")) { ret 17; }
    if (!str_contains(dep, "sync [<path>]")) { ret 18; }

    out_sink.len = 0;
    if (R.is_err[R.Void, str](render_command_page(?alloc, ?out, args.CMD_RUN))) { ret 19; }
    val run: str = sink_text(?out_sink);
    if (!str_contains(run, "--bin <name>") || str_contains(run, "--lib <name>")) { ret 20; }

    out_sink.len = 0;
    if (R.is_err[R.Void, str](render_command_page(?alloc, ?out, args.CMD_DOC))) { ret 21; }
    val doc: str = sink_text(?out_sink);
    if (!str_contains(doc, "--target <name>") || !str_contains(doc, "--out <dir>")) { ret 22; }
    if (str_contains(doc, "--profile") || str_contains(doc, "--pie") || str_contains(doc, "  -v")) { ret 23; }

    out_sink.len = 0;
    if (R.is_err[R.Void, str](render_command_page(?alloc, ?out, args.CMD_INFO))) { ret 24; }
    val info: str = sink_text(?out_sink);
    if (!str_contains(info, "--version and targets cannot be combined")) { ret 25; }

    out_sink.len = 0;
    if (R.is_err[R.Void, str](render_command_page(?alloc, ?out, args.CMD_DEP))) { ret 26; }
    if (!str_contains(sink_text(?out_sink), "\n      --git <url>")) { ret 27; }

    var i: usize = 0;
    for (i < args.CMD_N) {
        out_sink.len = 0;
        if (R.is_err[R.Void, str](render_command_page(?alloc, ?out, args.COMMANDS[i].id))) { ret 28; }
        if (out_sink.len == 0) { ret 29; }
        i = i + 1;
    }
    ret 0;
}

test "mach.cli.cmd.help.render_route:separates_stdout_stderr_and_exit_classes" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    var out_buf: [32768]u8; var err_buf: [1024]u8;
    var out_sink: MemSink; var err_sink: MemSink; var out: writer.Writer; var err: writer.Writer;
    mem_writer(?out, ?out_sink, ?out_buf[0], 32767);
    mem_writer(?err, ?err_sink, ?err_buf[0], 1023);

    var ok: HelpRoute; ok.kind = HELP_ROUTE_COMMAND; ok.command = args.CMD_INFO; ok.token = "";
    if (render_route(?alloc, ?out, ?err, ?ok) != 0) { ret 2; }
    if (out_sink.len == 0 || err_sink.len != 0) { ret 3; }

    out_sink.len = 0; err_sink.len = 0;
    var bad: HelpRoute; bad.kind = HELP_ROUTE_MALFORMED; bad.command = args.CMD_NONE; bad.token = "bogus";
    if (render_route(?alloc, ?out, ?err, ?bad) != 1) { ret 4; }
    if (out_sink.len != 0) { ret 5; }
    if (!str_equals(sink_text(?err_sink), "error: unknown command 'bogus'\n")) { ret 6; }

    out_sink.len = 0; err_sink.len = 0; out_sink.fail = true; out_sink.fail_at = 0;
    if (render_route(?alloc, ?out, ?err, ?ok) != 2) { ret 7; }

    out_sink.len = 0; err_sink.len = 0; out_sink.fail = true; out_sink.fail_at = 10;
    if (render_route(?alloc, ?out, ?err, ?ok) != 2) { ret 8; }
    if (out_sink.len != 10 || err_sink.len != 0) { ret 9; }

    out_sink.len = 0; err_sink.len = 0; out_sink.fail = false; err_sink.fail = true; err_sink.fail_at = 5;
    if (render_route(?alloc, ?out, ?err, ?bad) != 2) { ret 10; }
    if (out_sink.len != 0 || err_sink.len != 5) { ret 11; }
    ret 0;
}

test "mach.cli.cmd.help.render_route:allocation_failure_is_internal_and_publishes_nothing" {
    var alloc: A.Allocator;
    alloc.ctx = nil; alloc.fn_allocate = fail_allocate; alloc.fn_reallocate = fail_reallocate; alloc.fn_deallocate = fail_deallocate;
    var out_buf: [128]u8; var err_buf: [128]u8;
    var out_sink: MemSink; var err_sink: MemSink; var out: writer.Writer; var err: writer.Writer;
    mem_writer(?out, ?out_sink, ?out_buf[0], 127);
    mem_writer(?err, ?err_sink, ?err_buf[0], 127);
    var route: HelpRoute; route.kind = HELP_ROUTE_OVERVIEW; route.command = args.CMD_NONE; route.token = "";
    if (render_route(?alloc, ?out, ?err, ?route) != 2) { ret 1; }
    if (out_sink.len != 0 || err_sink.len != 0) { ret 2; }
    ret 0;
}

test "mach.cli.cmd.help.render:respects_narrow_and_wide_layout_widths" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    var out_buf: [65536]u8; var out_sink: MemSink; var out: writer.Writer;
    mem_writer(?out, ?out_sink, ?out_buf[0], 65535);

    var widths: [2]usize;
    widths[0] = 56;
    widths[1] = 120;
    var wi: usize = 0;
    for (wi < 2) {
        var ci: usize = 0;
        for (ci < args.CMD_N) {
            out_sink.len = 0;
            if (R.is_err[R.Void, str](render_command_page_at(?alloc, ?out, args.COMMANDS[ci].id, widths[wi]))) { ret 2; }
            if (max_line_width(sink_text(?out_sink)) > widths[wi]) { ret 3; }
            ci = ci + 1;
        }
        out_sink.len = 0;
        if (R.is_err[R.Void, str](render_overview_at(?alloc, ?out, widths[wi]))) { ret 4; }
        if (max_line_width(sink_text(?out_sink)) > widths[wi]) { ret 5; }
        wi = wi + 1;
    }
    ret 0;
}

test "mach.cli.cmd.help.render:every_visible_schema_entry_appears_and_every_rendered_flag_parses" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    var out_buf: [65536]u8; var out_sink: MemSink; var out: writer.Writer;
    mem_writer(?out, ?out_sink, ?out_buf[0], 65535);

    var ci: usize = 0;
    for (ci < args.CMD_N) {
        val command: *args.CommandSpec = ?args.COMMANDS[ci];
        if (command.id == args.CMD_HELP) { ci = ci + 1; cnt; }

        out_sink.len = 0;
        if (R.is_err[R.Void, str](render_command_page_at(?alloc, ?out, command.id, 200))) { ret 2; }
        val text: str = sink_text(?out_sink);

        if (!str_contains(text, command.exits)) { ret 3; }

        var ti: usize = 0;
        for (ti < command.table_n) {
            val table: args.TableRef = command.tables[ti];
            var fj: usize = 0;
            for (fj < table.n) {
                if (table.accepted != nil && !table.accepted[fj]) { fj = fj + 1; cnt; }
                val flag: args.FlagSpec = table.table[fj];
                if (!str_contains(text, flag.name)) { ret 4; }
                if (!args.schema_lookup(command.id, args.DEPACT_NONE, flag.name).found) { ret 5; }
                fj = fj + 1;
            }
            ti = ti + 1;
        }

        var cj: usize = 0;
        for (cj < command.constraint_n) {
            if (!str_contains(text, command.constraints[cj])) { ret 6; }
            cj = cj + 1;
        }

        if (command.has_action) {
            var ai: usize = 0;
            for (ai < args.DEPACT_N) {
                val action: *args.DepActionSpec = ?args.DEP_ACTIONS[ai];
                if (!str_contains(text, action.exits)) { ret 7; }
                var ati: usize = 0;
                for (ati < action.table_n) {
                    val table: args.TableRef = action.tables[ati];
                    var afj: usize = 0;
                    for (afj < table.n) {
                        if (table.accepted != nil && !table.accepted[afj]) { afj = afj + 1; cnt; }
                        val flag: args.FlagSpec = table.table[afj];
                        if (!str_contains(text, flag.name)) { ret 8; }
                        if (!args.schema_lookup(command.id, action.id, flag.name).found) { ret 9; }
                        afj = afj + 1;
                    }
                    ati = ati + 1;
                }
                var acj: usize = 0;
                for (acj < action.constraint_n) {
                    if (!str_contains(text, action.constraints[acj])) { ret 10; }
                    acj = acj + 1;
                }
                ai = ai + 1;
            }
        }

        ci = ci + 1;
    }
    ret 0;
}
