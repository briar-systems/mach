use mach.lang.fail;
use fs:         std.filesystem;
use std_format: std.format;
use io_writer:  std.io.writer;
use std.process.env;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use A: std.allocator;

use mach.cli.args;
use mach.cli.exit;
use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.textbuild;
use lang_version: mach.lang.version;

val DEFAULT_WIDTH: usize = 100;
val MIN_WIDTH:     usize = 56;
val FLAG_COL:      usize = 24;
val EXIT_COL:      usize = 5;

# `mach help`, and the page any command renders for `--help`
pub val COMMAND: args.CommandSpec = args.CommandSpec{name: "help", aliases: nil, alias_n: 0, grammar: " [command [action]]", summary: "show command help", effect: "render the overview, one command's page or one action's block without product effects", exits: nil, exit_n: 0, terminator: "", tables: nil, table_n: 0, refused: nil, refused_n: 0, refusal: "", relations: nil, relation_n: 0, constraints: nil, constraint_n: 0, operand_min: 0, operand_max: 2, truncate_at_sep: false, actions: nil, action_n: 0, examples: nil, example_n: 0, run: run};

# a page help renders
# ---
# command: the command whose page it is, or nil for the overview
# action:  the action whose block it is, or nil for the whole page
pub rec Page {
    command: *args.CommandSpec;
    action:  *args.ActionSpec;
}

# the page `mach help [command [action]]` names: the overview with no operand or `help`, a command's
# page, or one action's block of a command that takes actions
fun named_page(a: *A.Allocator, inv: *args.ParsedInvocation, argv: **u8) res[Page, fail.Fail] {
    var p: Page = Page{command: nil, action: nil};
    if (inv.positional_count == 0) { ret res[Page, fail.Fail].ok{p}; }
    val word: str = argv[inv.positional_idxs[0]]::str;
    p.command = args.command_for(inv.commands, word);
    if (p.command == nil) {
        val said: res[str, std_format.FormatError] = std_format.sprint(a, "unknown command '{}'", word);
        if (sel said.err) { ret res[Page, fail.Fail].err{fail.format_refused(said.err)}; }
        ret res[Page, fail.Fail].err{fail.user(diagnostic_kind.CLI_UNKNOWN_COMMAND, said.ok)};
    }
    if (p.command == ?COMMAND)     { p.command = nil; }
    if (inv.positional_count == 1) { ret res[Page, fail.Fail].ok{p}; }
    val action_word: str = argv[inv.positional_idxs[1]]::str;
    if (p.command == nil || p.command.action_n == 0) {
        val said: res[str, std_format.FormatError] = std_format.sprint(a, "'{}' takes no action", word);
        if (sel said.err) { ret res[Page, fail.Fail].err{fail.format_refused(said.err)}; }
        ret res[Page, fail.Fail].err{fail.user(diagnostic_kind.CLI_OPERAND, said.ok)};
    }
    p.action = args.action_for(p.command, action_word);
    if (p.action == nil) {
        val listed: res[str, std_format.FormatError] = args.action_list(a, p.command);
        if (sel listed.err) { ret res[Page, fail.Fail].err{fail.format_refused(listed.err)}; }
        val said: res[str, std_format.FormatError] = std_format.sprint(a, "unknown {} action '{}'; the actions are {}", p.command.name, action_word, listed.ok);
        if (sel said.err) { ret res[Page, fail.Fail].err{fail.format_refused(said.err)}; }
        ret res[Page, fail.Fail].err{fail.user(diagnostic_kind.CLI_UNKNOWN_ACTION, said.ok)};
    }
    ret res[Page, fail.Fail].ok{p};
}

# the page an invocation asks for: what `mach help` names, or the page of the command or action
# that was given `--help`
# ---
# a:    owns a refusal's text
# inv:  the parsed invocation
# argv: the argument vector inv was parsed from
# ret:  the page, or a user failure naming an unknown command or action
pub fun page_for(a: *A.Allocator, inv: *args.ParsedInvocation, argv: **u8) res[Page, fail.Fail] {
    if (inv.command == ?COMMAND) { ret named_page(a, inv, argv); }
    ret res[Page, fail.Fail].ok{Page{command: inv.command, action: inv.action}};
}

# `mach help`, and every command's `--help`: render the page the invocation asks for on stdout
# ---
# cx:  the call
# ret: exit.OK once the page is written, or the failure naming an unknown command or action, or
#      the write that failed
pub fun run(cx: *args.Call) res[i64, fail.Fail] {
    val picked: res[Page, fail.Fail] = page_for(cx.a, cx.inv, cx.argv);
    if (sel picked.err) { ret res[i64, fail.Fail].err{picked.err}; }
    var out:      io_writer.Writer = fs.writer(fs.STDOUT);
    var rendered: err[fail.Fail]   = render_page(cx.a, cx.inv.commands, ?out, picked.ok, terminal_width());
    if (sel rendered.err) { ret res[i64, fail.Fail].err{rendered.err}; }
    ret res[i64, fail.Fail].ok{exit.OK};
}

# write one page wrapped to a width
# ---
# a:        allocator for the text buffer
# commands: the commands the page belongs to
# out:      the destination
# p:        the page
# width:    columns; clamped to the range 56 to 240
# ret:      as render_overview_at, render_command_page_at and render_action_page_at
pub fun render_page(a: *A.Allocator, commands: args.CommandSet, out: *io_writer.Writer, p: Page, width: usize) err[fail.Fail] {
    if (p.command == nil) { ret render_overview_at(a, commands, out, width); }
    if (p.action == nil)  { ret render_command_page_at(a, commands, out, p.command, width); }
    ret render_action_page_at(a, commands, out, p.command, p.action, width);
}

# each render appends to the builder, which keeps its first refusal for `publish` to report
fun append(b: *textbuild.TextBuilder, s: str) {
    textbuild.tb_append(b, s);
}

fun append_spaces(b: *textbuild.TextBuilder, n: usize) {
    var i: usize = 0;
    for (i < n) {
        append(b, " ");
        i = i + 1;
    }
}

fun append_range(b: *textbuild.TextBuilder, s: str, start: usize, end: usize) {
    var one: [2]u8;
    one[1] = 0;
    var i: usize = start;
    for (i < end) {
        one[0] = s[i];
        append(b, (?one[0])::str);
        i = i + 1;
    }
}

rec WrapState {
    col:          usize;
    continuation: usize;
    width:        usize;
    has_text:     bool;
}

fun wrap_append(b: *textbuild.TextBuilder, state: *WrapState, text: str) {
    val n: usize = str_len(text);
    var i: usize = 0;
    for (i < n) {
        for (i < n && (text[i] == ' ' || text[i] == '\t' || text[i] == '\n' || text[i] == '\r')) { i = i + 1; }
        if (i >= n) { ret; }
        val start: usize = i;
        for (i < n && text[i] != ' ' && text[i] != '\t' && text[i] != '\n' && text[i] != '\r') { i = i + 1; }
        wrap_word(b, state, text, start, i, "");
    }
}

# the word at start to end of text with suffix stuck to it, as a comma is, on this line when
# both fit and on the next otherwise
fun wrap_word(b: *textbuild.TextBuilder, state: *WrapState, text: str, start: usize, end: usize, suffix: str) {
    val word_len: usize = end - start + str_len(suffix);
    var need:     usize = word_len;
    if (state.has_text) { need = need + 1; }
    if (state.has_text && state.col + need > state.width) {
        append(b, "\n");
        append_spaces(b, state.continuation);
        state.col      = state.continuation;
        state.has_text = false;
    }
    if (state.has_text) {
        append(b, " ");
        state.col = state.col + 1;
    }
    append_range(b, text, start, end);
    append(b, suffix);
    state.col      = state.col + word_len;
    state.has_text = true;
}

fun wrap_finish(b: *textbuild.TextBuilder) {
    append(b, "\n");
}

fun normalized_width(width: usize) usize {
    if (width < MIN_WIDTH) { ret MIN_WIDTH; }
    if (width > 240)       { ret 240; }
    ret width;
}

fun terminal_width() usize {
    var buf:  [16]u8;
    val read: res[opt[usize], env.EnvError] = env.get("COLUMNS", ?buf[0], 16);
    if (sel read.err)     { ret DEFAULT_WIDTH; }
    if (sel read.ok.none) { ret DEFAULT_WIDTH; }
    val n: usize = read.ok.some;
    if (n == 0 || n >= 16) { ret DEFAULT_WIDTH; }
    var width: usize = 0;
    var i:     usize = 0;
    for (i < n) {
        if (buf[i] < '0' || buf[i] > '9') { ret DEFAULT_WIDTH; }
        width = width * 10 + (buf[i] - '0')::usize;
        i     = i + 1;
    }
    ret normalized_width(width);
}

# where a page's relations come from: the command page, or one action's block
# ---
# command: the command
# action:  the action whose block is rendered, or nil for the command page
rec Scope {
    command: *args.CommandSpec;
    action:  *args.ActionSpec;
}

# whether a shared relation belongs to a scope: in force on the command page, or in force in the
# action's schema only
fun shared_in_scope(scope: *Scope, rel: *args.Relation) bool {
    if (scope.action == nil) { ret args.relation_active(scope.command, nil, rel); }
    ret args.relation_active(scope.command, scope.action, rel) && !args.relation_active(scope.command, nil, rel);
}

# the relation at i of the scope's relations, shared ones first; nil past the end or for a shared
# relation the scope does not hold
fun scope_relation(scope: *Scope, i: usize) *args.Relation {
    if (i < args.RELATIONS_N) {
        val shared: *args.Relation = ?args.RELATIONS[i];
        if (shared_in_scope(scope, shared)) { ret shared; }
        ret nil;
    }
    val j: usize = i - args.RELATIONS_N;
    if (scope.action == nil) {
        if (j < scope.command.relation_n) { ret ?scope.command.relations[j]; }
        ret nil;
    }
    if (j < scope.action.relation_n) { ret ?scope.action.relations[j]; }
    ret nil;
}

fun scope_relation_n(scope: *Scope) usize {
    if (scope.action == nil) { ret args.RELATIONS_N + scope.command.relation_n; }
    ret args.RELATIONS_N + scope.action.relation_n;
}

# the row a relation of kind at i of the scope binds row to, or nil. a conflict binds both ways, a
# requirement and an implication only from their own row
fun related_at(scope: *Scope, i: usize, row: *args.FlagSpec, kind: args.RelationKind) *args.FlagSpec {
    val rel: *args.Relation = scope_relation(scope, i);
    if (rel == nil || rel.kind != kind)                      { ret nil; }
    if (rel.row == row)                                      { ret rel.other; }
    if (kind == args.RELATION_CONFLICTS && rel.other == row) { ret rel.row; }
    ret nil;
}

fun render_option_lead(b: *textbuild.TextBuilder, state: *WrapState, indent: str, label: str, width: usize) {
    append(b, indent);
    append(b, "  ");
    append(b, label);
    state.col          = str_len(indent) + 2 + str_len(label);
    state.continuation = str_len(indent) + 4;
    state.width        = width;
    state.has_text     = str_len(label) > 0;
}

fun render_option_meta(b: *textbuild.TextBuilder, indent: str, label: str, value: str, width: usize) {
    var state: WrapState;
    render_option_lead(b, ?state, indent, label, width);
    wrap_append(b, ?state, value);
    wrap_finish(b);
}

# the rows a relation of kind binds row to in a scope, after label and joined with ", "; nothing
# when none
fun render_related(b: *textbuild.TextBuilder, scope: *Scope, row: *args.FlagSpec, kind: args.RelationKind, label: str, indent: str, width: usize) {
    var state: WrapState;
    var held:  *args.FlagSpec = nil;
    var i:     usize          = 0;
    for (i < scope_relation_n(scope)) {
        val other: *args.FlagSpec = related_at(scope, i, row, kind);
        i = i + 1;
        if (other == nil) { cnt; }
        if (held == nil)  { render_option_lead(b, ?state, indent, label, width); }
        or                { wrap_word(b, ?state, held.name, 0, str_len(held.name), ","); }
        held = other;
    }
    if (held != nil) {
        wrap_word(b, ?state, held.name, 0, str_len(held.name), "");
        wrap_finish(b);
    }
}

fun render_option(b: *textbuild.TextBuilder, scope: *Scope, table: *args.TableRef, j: usize, indent: str, width: usize) {
    val flag: *args.FlagSpec = table.rows[j];
    append(b, indent);
    append(b, flag.name);
    var label_width: usize = str_len(indent) + str_len(flag.name);
    if (flag.arity == args.ARITY_ATTACHED) {
        append(b, "[=");
        append(b, flag.value);
        append(b, "]");
        label_width = label_width + str_len(flag.value) + 3;
    }
    or (str_len(flag.value) > 0) {
        append(b, " <");
        append(b, flag.value);
        append(b, ">");
        label_width = label_width + str_len(flag.value) + 3;
    }
    var description_col: usize = FLAG_COL + str_len(indent) - 2;
    if (description_col + 12 > width)  { description_col = str_len(indent) + 4; }
    if (label_width < description_col) { append_spaces(b, description_col - label_width); }
    or {
        append(b, "\n");
        append_spaces(b, description_col);
    }
    var state: WrapState;
    state.col          = description_col;
    state.continuation = description_col;
    state.width        = width;
    state.has_text     = false;
    wrap_append(b, ?state, args.row_doc(table, j));
    wrap_finish(b);
    if (str_len(flag.default) > 0) { render_option_meta(b, indent, "default:", flag.default, width); }
    if (flag.repeatable)           { render_option_meta(b, indent, "", "repeatable", width); }
    render_related(b, scope, flag, args.RELATION_CONFLICTS, "conflicts:", indent, width);
    render_related(b, scope, flag, args.RELATION_REQUIRES, "requires:", indent, width);
    render_related(b, scope, flag, args.RELATION_IMPLIES, "implies:", indent, width);
    if (flag.alias_of != nil) { render_option_meta(b, indent, "alias of:", flag.alias_of.name, width); }
}

fun render_tables(b: *textbuild.TextBuilder, scope: *Scope, tables: *args.TableRef, table_n: usize, indent: str, width: usize) {
    var i: usize = 0;
    for (i < table_n) {
        val table: *args.TableRef = ?tables[i];
        var j:     usize          = 0;
        for (j < table.n) {
            if (table.accepted == nil || table.accepted[j]) { render_option(b, scope, table, j, indent, width); }
            j = j + 1;
        }
        i = i + 1;
    }
}

fun render_aliases(b: *textbuild.TextBuilder, aliases: *str, alias_n: usize) {
    if (alias_n == 0) { ret; }
    append(b, "aliases:\n");
    var i: usize = 0;
    for (i < alias_n) {
        append(b, "  ");
        append(b, aliases[i]);
        append(b, "\n");
        i = i + 1;
    }
}

fun render_examples(b: *textbuild.TextBuilder, examples: *str, example_n: usize, indent: str, width: usize) {
    if (example_n == 0) { ret; }
    append(b, "\n");
    append(b, indent);
    append(b, "examples:\n");
    var i: usize = 0;
    for (i < example_n) {
        append(b, indent);
        append(b, "  ");
        var state: WrapState;
        state.col          = str_len(indent) + 2;
        state.continuation = state.col;
        state.width        = width;
        state.has_text     = false;
        wrap_append(b, ?state, examples[i]);
        wrap_finish(b);
        i = i + 1;
    }
}

fun render_constraint_lead(b: *textbuild.TextBuilder, state: *WrapState, heading: *bool, indent: str, width: usize) {
    if (!@heading) {
        append(b, "\n");
        append(b, indent);
        append(b, "constraints:\n");
        @heading = true;
    }
    append(b, indent);
    append(b, "  ");
    state.col          = str_len(indent) + 2;
    state.continuation = state.col;
    state.width        = width;
    state.has_text     = false;
}

# the constraints of a scope: the sentence of each relation that can be broken, which is the text
# a refusal of it prints, then the scope's own sentences
fun render_constraints(b: *textbuild.TextBuilder, scope: *Scope, constraints: *str, constraint_n: usize, indent: str, width: usize) {
    var heading: bool  = false;
    var state:   WrapState;
    var i:       usize = 0;
    for (i < scope_relation_n(scope)) {
        val rel: *args.Relation = scope_relation(scope, i);
        i = i + 1;
        if (rel == nil) { cnt; }
        val said: args.Sentence = args.relation_sentence(rel);
        if (str_len(said.row) == 0) { cnt; }
        render_constraint_lead(b, ?state, ?heading, indent, width);
        wrap_append(b, ?state, said.row);
        wrap_append(b, ?state, said.joint);
        wrap_append(b, ?state, said.other);
        wrap_append(b, ?state, said.tail);
        wrap_finish(b);
    }
    var c: usize = 0;
    for (c < constraint_n) {
        val text: str = constraints[c];
        c = c + 1;
        if (str_len(text) == 0) { cnt; }
        render_constraint_lead(b, ?state, ?heading, indent, width);
        wrap_append(b, ?state, text);
        wrap_finish(b);
    }
}

# one entry of the overview's list: its name in the label column, then its text wrapped
fun render_listed(b: *textbuild.TextBuilder, state: *WrapState, name: str, width: usize) {
    append(b, "  ");
    append(b, name);
    val label_width: usize = 2 + str_len(name);
    if (label_width < 12) { append_spaces(b, 12 - label_width); }
    or                    { append(b, "\n            "); }
    state.col          = 12;
    state.continuation = 12;
    state.width        = width;
    state.has_text     = false;
}

fun render_overview_body(b: *textbuild.TextBuilder, commands: args.CommandSet, width: usize) {
    append(b, "mach ");
    append(b, lang_version.MACH_VERSION);
    append(b, " - the Mach compiler\n\n");
    append(b, "usage: mach <command> [options]\n\ncommands:\n");
    var i: usize = 0;
    for (i < commands.n) {
        val command: *args.CommandSpec = commands.specs[i];
        var state:   WrapState;
        render_listed(b, ?state, command.name, width);
        wrap_append(b, ?state, command.summary);
        if (command.alias_n > 0) {
            wrap_append(b, ?state, "(aliases:");
            var j: usize = 0;
            for (j < command.alias_n) {
                wrap_append(b, ?state, command.aliases[j]);
                j = j + 1;
            }
            wrap_append(b, ?state, ")");
        }
        wrap_finish(b);
        i = i + 1;
    }
    if (commands.global_n > 0) { append(b, "\noptions:\n"); }
    var g: usize = 0;
    for (g < commands.global_n) {
        val row:   *args.FlagSpec = commands.globals[g].row;
        var state: WrapState;
        render_listed(b, ?state, row.name, width);
        wrap_append(b, ?state, row.doc);
        wrap_finish(b);
        g = g + 1;
    }
    append(b, "\n");
    var footer: WrapState;
    footer.col          = 0;
    footer.continuation = 0;
    footer.width        = width;
    footer.has_text     = false;
    wrap_append(b, ?footer, "use 'mach help <command>' or 'mach <command> -h' for detailed usage.");
    wrap_finish(b);
    append(b, "\n");
    var toolchain: WrapState;
    toolchain.col          = 0;
    toolchain.continuation = 0;
    toolchain.width        = width;
    toolchain.has_text     = false;
    wrap_append(b, ?toolchain, TOOLCHAIN_NOTE);
    wrap_finish(b);
}

# the programs a build runs through, each of which also stands alone
val TOOLCHAIN_NOTE: str = "a build runs through three programs that also stand alone: mirl compiles each module's IR to machine code, masc encodes and lists that machine code, and mink links the objects into the artifact.";

fun render_actions(b: *textbuild.TextBuilder, command: *args.CommandSpec, width: usize) {
    append(b, "\nactions:\n");
    var i: usize = 0;
    for (i < command.action_n) {
        render_action(b, command, ?command.actions[i], width);
        i = i + 1;
    }
}

# one action's block, as the command page lists it and as `mach help <cmd> <action>` prints it
fun render_action(b: *textbuild.TextBuilder, command: *args.CommandSpec, action: *args.ActionSpec, width: usize) {
    var scope: Scope = Scope{command: command, action: action};
    append(b, "  ");
    var heading: WrapState;
    heading.col          = 2;
    heading.continuation = 4;
    heading.width        = width;
    heading.has_text     = false;
    wrap_append(b, ?heading, action.name);
    wrap_append(b, ?heading, action.grammar);
    wrap_finish(b);
    append(b, "    ");
    var effect: WrapState;
    effect.col          = 4;
    effect.continuation = 4;
    effect.width        = width;
    effect.has_text     = false;
    wrap_append(b, ?effect, action.effect);
    wrap_finish(b);
    append(b, "    exit:\n");
    render_exits(b, action.exits, action.exit_n, "      ", width);
    if (action.table_n > 0) {
        append(b, "    options:\n");
        render_tables(b, ?scope, action.tables, action.table_n, "      ", width);
    }
    render_constraints(b, ?scope, action.constraints, action.constraint_n, "    ", width);
    render_examples(b, action.examples, action.example_n, "    ", width);
}

fun render_command_body(b: *textbuild.TextBuilder, commands: args.CommandSet, command: *args.CommandSpec, width: usize) {
    if (command == ?COMMAND) {
        render_overview_body(b, commands, width);
        ret;
    }
    append(b, "usage: mach");
    var scope: Scope = Scope{command: command, action: nil};
    var usage: WrapState;
    usage.col          = 11;
    usage.continuation = 2;
    usage.width        = width;
    usage.has_text     = true;
    wrap_append(b, ?usage, command.name);
    wrap_append(b, ?usage, command.grammar);
    wrap_finish(b);
    append(b, "\n");
    render_aliases(b, command.aliases, command.alias_n);
    append(b, "effect:");
    var effect: WrapState;
    effect.col          = 7;
    effect.continuation = 8;
    effect.width        = width;
    effect.has_text     = true;
    wrap_append(b, ?effect, command.effect);
    wrap_finish(b);
    if (str_len(command.terminator) > 0) {
        append(b, "terminator:");
        var terminator: WrapState;
        terminator.col          = 11;
        terminator.continuation = 12;
        terminator.width        = width;
        terminator.has_text     = true;
        wrap_append(b, ?terminator, command.terminator);
        wrap_finish(b);
    }
    if (command.table_n > 0) {
        append(b, "\noptions:\n");
        render_tables(b, ?scope, command.tables, command.table_n, "  ", width);
    }
    render_constraints(b, ?scope, command.constraints, command.constraint_n, "", width);
    if (command.action_n > 0) { render_actions(b, command, width); }
    render_examples(b, command.examples, command.example_n, "", width);
    append(b, "\nexit:\n");
    render_exits(b, command.exits, command.exit_n, "  ", width);
}

# one exit row: the code, or `any` for the codes a command forwards, then its meaning
# and, when a command refines a shared code, `or` and the refinement
fun render_exit_row(b: *textbuild.TextBuilder, code: i64, meaning: str, refinement: str, indent: str, width: usize) {
    var label: [std_format.DECIMAL_MAX + 1]u8;
    var n:     usize = 0;
    if (code == exit.PASSTHROUGH) {
        label[0] = 'a';
        label[1] = 'n';
        label[2] = 'y';
        n        = 3;
    }
    or { n = std_format.put_i64(?label[0], code); }
    label[n] = 0;
    append(b, indent);
    append(b, (?label[0])::str);
    append_spaces(b, EXIT_COL - n);
    var row: WrapState;
    row.col          = str_len(indent) + EXIT_COL;
    row.continuation = row.col;
    row.width        = width;
    row.has_text     = false;
    wrap_append(b, ?row, meaning);
    if (str_len(refinement) > 0) {
        wrap_append(b, ?row, "or");
        wrap_append(b, ?row, refinement);
    }
    wrap_finish(b);
}

# the exit rows of a page: a forwarded code first, then exit.SHARED with the command's
# refinements, then the command's own codes
fun render_exits(b: *textbuild.TextBuilder, own: *exit.Note, own_n: usize, indent: str, width: usize) {
    var i: usize = 0;
    for (i < own_n) {
        if (own[i].code == exit.PASSTHROUGH) { render_exit_row(b, own[i].code, own[i].meaning, "", indent, width); }
        i = i + 1;
    }
    var si: usize = 0;
    for (si < exit.SHARED_N) {
        val shared:     *exit.Note = ?exit.SHARED[si];
        var refinement: str        = "";
        var j:          usize      = 0;
        for (j < own_n) {
            if (own[j].code == shared.code) { refinement = own[j].meaning; }
            j = j + 1;
        }
        render_exit_row(b, shared.code, shared.meaning, refinement, indent, width);
        si = si + 1;
    }
    i = 0;
    for (i < own_n) {
        val code: i64 = own[i].code;
        if (code != exit.PASSTHROUGH && !exit.shared(code)) { render_exit_row(b, code, own[i].meaning, "", indent, width); }
        i = i + 1;
    }
}

fun publish(b: *textbuild.TextBuilder, out: *io_writer.Writer) err[fail.Fail] {
    fin { textbuild.tb_dnit(b); }
    val built: err[textbuild.Error] = textbuild.tb_fault(b);
    if (sel built.err) { ret err[fail.Fail].err{fail.message(textbuild.text(built.err))}; }
    val fault: err[io_writer.WriteError] = io_writer.write_all(out, b.data, b.len);
    if (sel fault.err) { ret err[fail.Fail].err{fail.environment(diagnostic_kind.OUTPUT_WRITE, fail.write_text(fault.err))}; }
    ret err[fail.Fail].ok{};
}

# write the command overview wrapped to a width
# ---
# a:               allocator for the text buffer
# commands:        the commands to list
# out:             the destination
# requested_width: columns; clamped to the range 56 to 240
# ret:             ok, or an error when the command set is invalid, the buffer could not be built,
#                  or the write failed
pub fun render_overview_at(a: *A.Allocator, commands: args.CommandSet, out: *io_writer.Writer, requested_width: usize) err[fail.Fail] {
    if (!args.schema_valid(commands)) { ret err[fail.Fail].err{fail.message("help: invalid command schema")}; }
    val width: usize                 = normalized_width(requested_width);
    var b:     textbuild.TextBuilder = textbuild.tb_init(a);
    render_overview_body(?b, commands, width);
    ret publish(?b, out);
}

# write the command overview at the terminal width read from COLUMNS, 100 when unset or
# not a number
# ---
# a:        allocator for the text buffer
# commands: the commands to list
# out:      the destination
# ret:      as render_overview_at
pub fun render_overview(a: *A.Allocator, commands: args.CommandSet, out: *io_writer.Writer) err[fail.Fail] {
    ret render_overview_at(a, commands, out, terminal_width());
}

# write one command's help page wrapped to a width
# ---
# a:               allocator for the text buffer
# commands:        the commands the page belongs to
# out:             the destination
# command:         the command
# requested_width: columns; clamped to the range 56 to 240
# ret:             ok, or an error when the command set is invalid, the buffer could not be built,
#                  or the write failed
pub fun render_command_page_at(a: *A.Allocator, commands: args.CommandSet, out: *io_writer.Writer, command: *args.CommandSpec,
    requested_width: usize) err[fail.Fail] {
    if (!args.schema_valid(commands)) { ret err[fail.Fail].err{fail.message("help: invalid command schema")}; }
    val width: usize                 = normalized_width(requested_width);
    var b:     textbuild.TextBuilder = textbuild.tb_init(a);
    render_command_body(?b, commands, command, width);
    ret publish(?b, out);
}

# write one action's block wrapped to a width
# ---
# a:               allocator for the text buffer
# commands:        the commands the action's command belongs to
# out:             the destination
# command:         the command
# action:          one of its actions
# requested_width: columns; clamped to the range 56 to 240
# ret:             ok, or an error when the command set is invalid, the buffer could not be built,
#                  or the write failed
pub fun render_action_page_at(a: *A.Allocator, commands: args.CommandSet, out: *io_writer.Writer, command: *args.CommandSpec,
    action: *args.ActionSpec, requested_width: usize) err[fail.Fail] {
    if (!args.schema_valid(commands)) { ret err[fail.Fail].err{fail.message("help: invalid command schema")}; }
    var b: textbuild.TextBuilder = textbuild.tb_init(a);
    render_action(?b, command, action, normalized_width(requested_width));
    ret publish(?b, out);
}
