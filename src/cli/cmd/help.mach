use mach.lang.fail;
use std_args: std.args;
use std_help: std.args.help;
use std.collections.slice.Slice;
use fs:        std.filesystem;
use io_writer: std.io.writer;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use mach.cli.args;
use diagnostic_kind: mach.lang.diagnostic.kind;

# bytes a page is staged in on its way to stdout
val PAGE_BUFFER: usize = 4096;

# length of FLAGS
val FLAGS_N: usize = 2;
# the flags mach help takes
val FLAGS: [FLAGS_N]*std_args.Flag = [FLAGS_N]*std_args.Flag{?args.HELP, ?args.DIAGNOSTICS};

# `mach help`, and the page any command renders for `--help`
pub val COMMAND: std_args.Command = std_args.Command{name: "help", aliases: args.NO_WORDS, help: "show help for a command", usage: "[command [action]]", flags: Slice[*std_args.Flag]{data: ?FLAGS[0], size: FLAGS_N}, commands: args.NO_COMMANDS, operand_min: 0, operand_max: 2, passthrough: false};
# what mach holds `mach help` to beyond the parse
pub val POLICY: args.Policy = args.Policy{constraints: args.NO_WORDS, refused: args.NO_FLAGS, refusal: "", conflicts: args.NO_CONFLICTS};

# the page writer: stdout, staged through a buffer
rec Page {
    out:    io_writer.Writer;
    staged: io_writer.Buffered;
    bytes:  [PAGE_BUFFER]u8;
    w:      io_writer.Writer;
}

fun open(p: *Page) {
    p.out = fs.writer(fs.STDOUT);
    p.w   = io_writer.buffered(?p.staged, ?p.out, ?p.bytes[0], PAGE_BUFFER);
}

fun put(p: *Page, s: str) {
    val wrote: err[io_writer.WriteError] = io_writer.write_str(?p.w, s);
}

fun close(p: *Page) err[fail.Fail] {
    val flushed: err[io_writer.WriteError] = io_writer.flush(?p.staged);
    if (sel flushed.err) { ret err[fail.Fail].err{fail.environment(diagnostic_kind.OUTPUT_WRITE, fail.write_text(flushed.err))}; }
    ret err[fail.Fail].ok{};
}

# the columns a page wraps its prose to: the terminal's, held to what std.args' page holds it to
fun columns() usize {
    var cols: usize = std_help.terminal_width();
    if (cols < 56)  { cols = 56; }
    if (cols > 240) { cols = 240; }
    ret cols;
}

# `text` broken at spaces into lines no wider than `cols`, each line after the first indented to
# `indent`, the first starting at column `at`, a word wider than a line alone on its own
fun wrapped(p: *Page, text: str, at: usize, indent: usize, cols: usize) {
    val n:     usize = str_len(text);
    var col:   usize = at;
    var fresh: bool  = true;
    var i:     usize = 0;
    for (i < n) {
        var j: usize = i;
        for (j < n && text[j] != ' ') { j = j + 1; }
        val word: usize = j - i;
        if (!fresh && col + 1 + word > cols) {
            put(p, "\n");
            col = 0;
            for (col < indent) {
                put(p, " ");
                col = col + 1;
            }
        }
        or (!fresh) {
            put(p, " ");
            col = col + 1;
        }
        fresh = false;
        var k: usize = i;
        for (k < j) {
            put_byte(p, text[k]);
            k = k + 1;
        }
        col = col + word;
        i   = j;
        for (i < n && text[i] == ' ') { i = i + 1; }
    }
    put(p, "\n");
}

fun put_byte(p: *Page, c: u8) {
    var one: [2]u8 = [2]u8{c, 0};
    put(p, (?one[0])::str);
}

# write the page of the command a parsed line matched to stdout: std.args' page of its usage,
# text, nested commands and flags, then the rules mach holds it to. the root's page is the overview
# ---
# line:   a parsed line whose command is the page's
# policy: the command's policy
# ret:    ok, or the write that failed
pub fun page(line: *std_args.Parsed, policy: *args.Policy) err[fail.Fail] {
    var p: Page;
    open(?p);
    val done: err[io_writer.WriteError] = std_help.render(line, ?p.w, std_help.terminal_width());
    if (sel done.err) { ret err[fail.Fail].err{fail.environment(diagnostic_kind.OUTPUT_WRITE, fail.write_text(done.err))}; }
    if (policy.constraints.size > 0) {
        put(?p, "\nconstraints:\n");
        var i: usize = 0;
        for (i < policy.constraints.size) {
            put(?p, "  ");
            wrapped(?p, policy.constraints.data[i], 2, 4, columns());
            i = i + 1;
        }
    }
    ret close(?p);
}
