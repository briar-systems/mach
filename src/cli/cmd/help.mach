use mach.lang.fail;
use std_args:   std.args;
use std_help:   std.args.help;
use fs:         std.filesystem;
use std_format: std.format;
use io_writer:  std.io.writer;
use std.types.bool.false;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;

use mach.cli.args;
use mach.cli.exit;
use diagnostic_kind: mach.lang.diagnostic.kind;

# bytes a page is staged in on its way to stdout
val PAGE_BUFFER: usize = 4096;

# `mach help`, and the page any command renders for `--help`
pub val COMMAND: std_args.CommandSpec = std_args.CommandSpec{name: "help", id: 0, aliases: nil, alias_n: 0, grammar: " [command [action]]", summary: "show command help", effect: "render the overview, one command's page or one action's block without product effects", exits: nil, exit_n: 0, terminator: "", tables: nil, table_n: 0, refused: nil, refused_n: 0, refusal: "", relations: nil, relation_n: 0, constraints: nil, constraint_n: 0, operand_min: 0, operand_max: 2, truncate_at_sep: false, actions: nil, action_n: 0, examples: nil, example_n: 0};

# the overview's page
pub val OVERVIEW: std_help.Page = std_help.Page{command: nil, action: nil};

# a command's action names, comma separated
fun action_list(a: *A.Allocator, command: *std_args.CommandSpec) res[str, std_format.FormatError] {
    var text: str   = "";
    var i:    usize = 0;
    for (i < command.action_n) {
        var said: res[str, std_format.FormatError] = std_format.sprint(a, "{}, {}", text, command.actions[i].name);
        if (i == 0)       { said = std_format.sprint(a, "{}", command.actions[i].name); }
        if (sel said.err) { ret said; }
        text = said.ok;
        i    = i + 1;
    }
    ret res[str, std_format.FormatError].ok{text};
}

# the page `mach help [command [action]]` names: the overview with no operand or `help`, a command's
# page, or one action's block of a command that takes actions
fun named_page(a: *A.Allocator, inv: *std_args.Invocation) res[std_help.Page, fail.Fail] {
    var p:    std_help.Page = OVERVIEW;
    val word: str           = args.operand(inv, 0);
    if (word == nil) { ret res[std_help.Page, fail.Fail].ok{p}; }
    p.command = std_args.command_for(inv.set, word);
    if (p.command == nil) {
        val said: res[str, std_format.FormatError] = std_format.sprint(a, "unknown command '{}'", word);
        if (sel said.err) { ret res[std_help.Page, fail.Fail].err{fail.format_refused(said.err)}; }
        ret res[std_help.Page, fail.Fail].err{fail.user(diagnostic_kind.CLI_UNKNOWN_COMMAND, said.ok)};
    }
    if (p.command == ?COMMAND) { p.command = nil; }
    val action_word: str = args.operand(inv, 1);
    if (action_word == nil) { ret res[std_help.Page, fail.Fail].ok{p}; }
    if (p.command == nil || p.command.action_n == 0) {
        val said: res[str, std_format.FormatError] = std_format.sprint(a, "'{}' takes no action", word);
        if (sel said.err) { ret res[std_help.Page, fail.Fail].err{fail.format_refused(said.err)}; }
        ret res[std_help.Page, fail.Fail].err{fail.user(diagnostic_kind.CLI_OPERAND, said.ok)};
    }
    p.action = std_args.action_for(p.command, action_word);
    if (p.action == nil) {
        val listed: res[str, std_format.FormatError] = action_list(a, p.command);
        if (sel listed.err) { ret res[std_help.Page, fail.Fail].err{fail.format_refused(listed.err)}; }
        val said: res[str, std_format.FormatError] = std_format.sprint(a, "unknown {} action '{}'; the actions are {}", p.command.name, action_word, listed.ok);
        if (sel said.err) { ret res[std_help.Page, fail.Fail].err{fail.format_refused(said.err)}; }
        ret res[std_help.Page, fail.Fail].err{fail.user(diagnostic_kind.CLI_UNKNOWN_ACTION, said.ok)};
    }
    ret res[std_help.Page, fail.Fail].ok{p};
}

# write a page of a set to stdout at the width COLUMNS names
# ---
# a:   owns the failure's text
# set: the commands
# p:   the page
# ret: ok, or an internal failure for a malformed set, or the write that failed
pub fun render(a: *A.Allocator, set: *std_args.CommandSet, p: std_help.Page) err[fail.Fail] {
    var out:    io_writer.Writer        = fs.writer(fs.STDOUT);
    var staged: io_writer.Buffered;
    var bytes:  [PAGE_BUFFER]u8;
    var w:      io_writer.Writer        = io_writer.buffered(?staged, ?out, ?bytes[0], PAGE_BUFFER);
    val done:   err[std_help.HelpError] = std_help.render(set, ?w, p, std_help.terminal_width());
    if (sel done.err) {
        if (sel done.err.malformed) {
            ret err[fail.Fail].err{fail.message_of(fail.join(a, "help: malformed command set: ", done.err.malformed.why))};
        }
        ret err[fail.Fail].err{fail.environment(diagnostic_kind.OUTPUT_WRITE, fail.write_text(done.err.write))};
    }
    val flushed: err[io_writer.WriteError] = io_writer.flush(?staged);
    if (sel flushed.err) { ret err[fail.Fail].err{fail.environment(diagnostic_kind.OUTPUT_WRITE, fail.write_text(flushed.err))}; }
    ret err[fail.Fail].ok{};
}

# `mach help`, and every command's `--help`: render the page the invocation asks for on stdout:
# what `mach help` names, or the page of the command or action that was given `--help`
# ---
# cx:  the call
# ret: exit.OK once the page is written, or the failure naming an unknown command or action, or
#      the write that failed
pub fun run(cx: *args.Call) res[i64, fail.Fail] {
    var page: std_help.Page = std_help.page_of(cx.inv);
    if (cx.inv.command == ?COMMAND) {
        val picked: res[std_help.Page, fail.Fail] = named_page(cx.a, cx.inv);
        if (sel picked.err) { ret res[i64, fail.Fail].err{picked.err}; }
        page = picked.ok;
    }
    val rendered: err[fail.Fail] = render(cx.a, cx.inv.set, page);
    if (sel rendered.err) { ret res[i64, fail.Fail].err{rendered.err}; }
    ret res[i64, fail.Fail].ok{exit.OK};
}
