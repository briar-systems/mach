use mach.lang.fail;
use std_args: std.args;
use std_help: std.args.help;
use std.collections.slice.Slice;
use fs:         std.filesystem;
use std_format: std.format;
use io_writer:  std.io.writer;
use std.types.bool.false;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use A: std.allocator;

use mach.cli.args;
use mach.cli.exit;
use diagnostic_kind: mach.lang.diagnostic.kind;

# bytes a page is staged in on its way to stdout
val PAGE_BUFFER: usize = 4096;

# the column a row's text starts at in the overview and in mach's own sections of a page
val TEXT_COL: usize = 24;

# length of FLAGS
val FLAGS_N: usize = 2;
# the flags mach help takes
val FLAGS: [FLAGS_N]*std_args.Flag = [FLAGS_N]*std_args.Flag{?args.HELP, ?args.DIAGNOSTICS};

# `mach help`, and the page any command renders for `--help`
pub val COMMAND: std_args.Command = std_args.Command{name: "help", aliases: args.NO_WORDS, help: "render the overview, one command's page or one action's page without product effects", usage: "[command [action]]", flags: Slice[*std_args.Flag]{data: ?FLAGS[0], size: FLAGS_N}, commands: args.NO_COMMANDS, operand_min: 0, operand_max: 2, passthrough: false};
# what mach holds `mach help` to beyond the parse
pub val POLICY: args.Policy = args.Policy{summary: "show command help", exits: args.NO_EXITS, constraints: args.NO_WORDS, refused: args.NO_FLAGS, refusal: "", conflicts: args.NO_CONFLICTS};

# one command the overview lists
# ---
# name:    the command word
# summary: its one line
pub rec Row {
    name:    str;
    summary: str;
}

# the page writer: stdout, staged through a buffer
rec Page {
    out:    io_writer.Writer;
    staged: io_writer.Buffered;
    bytes:  [PAGE_BUFFER]u8;
    w:      io_writer.Writer;
}

fun open(p: *Page) {
    p.out = fs.writer(fs.STDOUT);
    p.w   = io_writer.buffered(?p.staged, ?p.out, ?p.bytes[0], PAGE_BUFFER);
}

fun put(p: *Page, s: str) {
    val wrote: err[io_writer.WriteError] = io_writer.write_str(?p.w, s);
}

fun close(p: *Page) err[fail.Fail] {
    val flushed: err[io_writer.WriteError] = io_writer.flush(?p.staged);
    if (sel flushed.err) { ret err[fail.Fail].err{fail.environment(diagnostic_kind.OUTPUT_WRITE, fail.write_text(flushed.err))}; }
    ret err[fail.Fail].ok{};
}

# `label`, then `text` from TEXT_COL, on the next line when the label reaches it
fun row(p: *Page, label: str, text: str) {
    put(p, "  ");
    put(p, label);
    var col: usize = 2 + str_len(label);
    if (col >= TEXT_COL) {
        put(p, "\n");
        col = 0;
    }
    for (col < TEXT_COL) {
        put(p, " ");
        col = col + 1;
    }
    put(p, text);
    put(p, "\n");
}

# the columns a page wraps its prose to: the terminal's, held to what std.args' page holds it to
fun columns() usize {
    var cols: usize = std_help.terminal_width();
    if (cols < 56)  { cols = 56; }
    if (cols > 240) { cols = 240; }
    ret cols;
}

# `text` broken at spaces into lines no wider than `cols`, each line after the first indented to
# `indent`, the first starting at column `at`
fun wrapped(p: *Page, text: str, at: usize, indent: usize, cols: usize) {
    val n:   usize = str_len(text);
    var col: usize = at;
    var i:   usize = 0;
    for (i < n) {
        var j: usize = i;
        for (j < n && text[j] != ' ') { j = j + 1; }
        val word: usize = j - i;
        if (col > indent && col + 1 + word > cols) {
            put(p, "\n");
            col = 0;
            for (col < indent) {
                put(p, " ");
                col = col + 1;
            }
        }
        or (col > indent) {
            put(p, " ");
            col = col + 1;
        }
        var k: usize = i;
        for (k < j) {
            put_byte(p, text[k]);
            k = k + 1;
        }
        col = col + word;
        i   = j;
        for (i < n && text[i] == ' ') { i = i + 1; }
    }
    put(p, "\n");
}

fun put_byte(p: *Page, c: u8) {
    var one: [2]u8 = [2]u8{c, 0};
    put(p, (?one[0])::str);
}

# the exit codes every command shares, then a command's own
fun exits(a: *A.Allocator, p: *Page, own: Slice[exit.Exit]) {
    put(p, "\nexit codes:\n");
    var i: usize = 0;
    for (i < exit.SHARED_N + own.size) {
        var e: exit.Exit;
        if (i < exit.SHARED_N) { e = exit.SHARED[i]; }
        or                     { e = own.data[i - exit.SHARED_N]; }
        i = i + 1;
        var code: str = "*";
        if (e.code != exit.PASSTHROUGH) {
            val said: res[str, std_format.FormatError] = std_format.sprint(a, "{}", e.code);
            if (sel said.ok) { code = said.ok; }
        }
        row(p, code, e.meaning);
    }
}

# write the page of the command a parsed line matched to stdout: std.args' page of its usage,
# text, nested commands and flags, then the rules mach holds it to and its exit codes
# ---
# a:      owns the exit codes' text
# line:   a parsed line whose command is the page's
# policy: the command's policy
# ret:    ok, or the write that failed
pub fun page(a: *A.Allocator, line: *std_args.Parsed, policy: *args.Policy) err[fail.Fail] {
    var p: Page;
    open(?p);
    val done: err[io_writer.WriteError] = std_help.render(line, ?p.w, std_help.terminal_width());
    if (sel done.err) { ret err[fail.Fail].err{fail.environment(diagnostic_kind.OUTPUT_WRITE, fail.write_text(done.err))}; }
    if (policy.constraints.size > 0) {
        put(?p, "\nconstraints:\n");
        var i: usize = 0;
        for (i < policy.constraints.size) {
            put(?p, "  ");
            wrapped(?p, policy.constraints.data[i], 2, 4, columns());
            i = i + 1;
        }
    }
    exits(a, ?p, policy.exits);
    ret close(?p);
}

# the flag a page names, `-c, --long <value>`
fun flag_label(a: *A.Allocator, f: *std_args.Flag) str {
    var cluster: [5]u8 = [5]u8{' ', ' ', ' ', ' ', 0};
    if (f.short != 0) {
        cluster[0] = '-';
        cluster[1] = f.short;
        cluster[2] = ',';
    }
    val short: str = (?cluster[0])::str;
    var value: str = "";
    if (std_args.takes_value(f)) {
        val v: res[str, std_format.FormatError] = std_format.sprint(a, " <{}>", f.value);
        if (sel v.ok) { value = v.ok; }
    }
    val said: res[str, std_format.FormatError] = std_format.sprint(a, "{}--{}{}", short, f.long, value);
    if (sel said.ok) { ret said.ok; }
    ret f.long;
}

# write the overview to stdout: the title, every command with its summary, the options `mach`
# takes in place of a command, what follows, and the exit codes
# ---
# a:      owns the text
# title:  the first line
# root:   the root command, whose flags are listed
# rows:   the commands, in order
# footer: the text after them
# ret:    ok, or the write that failed
pub fun overview(a: *A.Allocator, title: str, root: *std_args.Command, rows: Slice[Row], footer: str) err[fail.Fail] {
    var p: Page;
    open(?p);
    put(?p, title);
    put(?p, "\n\nusage: mach <command> [options]\n\ncommands:\n");
    var i: usize = 0;
    for (i < rows.size) {
        row(?p, rows.data[i].name, rows.data[i].summary);
        i = i + 1;
    }
    put(?p, "\noptions:\n");
    i = 0;
    for (i < root.flags.size) {
        val f: *std_args.Flag = root.flags.data[i];
        row(?p, flag_label(a, f), f.help);
        i = i + 1;
    }
    put(?p, "\n");
    wrapped(?p, footer, 0, 0, columns());
    exits(a, ?p, args.NO_EXITS);
    ret close(?p);
}
