use mach.lang.fail;
use fs:         std.filesystem;
use std_format: std.format;
use io_writer:  std.io.writer;
use std.process.env;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use A: std.allocator;

use mach.cli.args;
use mach.cli.exit;
use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.textbuild;
use lang_version: mach.lang.version;

val DEFAULT_WIDTH: usize = 100;
val MIN_WIDTH:     usize = 56;
val FLAG_COL:      usize = 24;
val EXIT_COL:      usize = 5;

# `mach help`, and the page any command renders for `--help`
pub val COMMAND: args.CommandSpec = args.CommandSpec{name: "help", aliases: nil, alias_n: 0, grammar: " [command [action]]", summary: "show command help", effect: "render the overview, one command's page or one action's block without product effects", exits: nil, exit_n: 0, terminator: "", tables: nil, table_n: 0, refused: nil, refused_n: 0, refusal: "", relations: nil, relation_n: 0, constraints: nil, constraint_n: 0, operand_min: 0, operand_max: 2, truncate_at_sep: false, actions: nil, action_n: 0, examples: nil, example_n: 0, run: run};

# a page help renders
# ---
# command: the command whose page it is, or nil for the overview
# action:  the action whose block it is, or nil for the whole page
pub rec Page {
    command: *args.CommandSpec;
    action:  *args.ActionSpec;
}

# the page `mach help [command [action]]` names: the overview with no operand or `help`, a command's
# page, or one action's block of a command that takes actions
fun named_page(a: *A.Allocator, inv: *args.ParsedInvocation, argv: **u8) res[Page, fail.Fail] {
    var p: Page = Page{command: nil, action: nil};
    if (inv.positional_count == 0) { ret res[Page, fail.Fail].ok{p}; }
    val word: str = argv[inv.positional_idxs[0]]::str;
    p.command = args.command_for(inv.commands, word);
    if (p.command == nil) {
        val said: res[str, std_format.FormatError] = std_format.sprint(a, "unknown command '{}'", word);
        if (sel said.err) { ret res[Page, fail.Fail].err{fail.message("out of memory")}; }
        ret res[Page, fail.Fail].err{fail.user(diagnostic_kind.CLI_UNKNOWN_COMMAND, said.ok)};
    }
    if (p.command == ?COMMAND)     { p.command = nil; }
    if (inv.positional_count == 1) { ret res[Page, fail.Fail].ok{p}; }
    val action_word: str = argv[inv.positional_idxs[1]]::str;
    if (p.command == nil || p.command.action_n == 0) {
        val said: res[str, std_format.FormatError] = std_format.sprint(a, "'{}' takes no action", word);
        if (sel said.err) { ret res[Page, fail.Fail].err{fail.message("out of memory")}; }
        ret res[Page, fail.Fail].err{fail.user(diagnostic_kind.CLI_OPERAND, said.ok)};
    }
    p.action = args.action_for(p.command, action_word);
    if (p.action == nil) {
        val said: res[str, std_format.FormatError] = std_format.sprint(a, "unknown {} action '{}'; the actions are {}", p.command.name, action_word, args.action_list(a, p.command));
        if (sel said.err) { ret res[Page, fail.Fail].err{fail.message("out of memory")}; }
        ret res[Page, fail.Fail].err{fail.user(diagnostic_kind.CLI_UNKNOWN_ACTION, said.ok)};
    }
    ret res[Page, fail.Fail].ok{p};
}

# the page an invocation asks for: what `mach help` names, or the page of the command or action
# that was given `--help`
# ---
# a:    owns a refusal's text
# inv:  the parsed invocation
# argv: the argument vector inv was parsed from
# ret:  the page, or a user failure naming an unknown command or action
pub fun page_for(a: *A.Allocator, inv: *args.ParsedInvocation, argv: **u8) res[Page, fail.Fail] {
    if (inv.command == ?COMMAND) { ret named_page(a, inv, argv); }
    ret res[Page, fail.Fail].ok{Page{command: inv.command, action: inv.action}};
}

# `mach help`, and every command's `--help`: render the page the invocation asks for on stdout
# ---
# cx:  the call
# ret: exit.OK once the page is written, or the failure naming an unknown command or action, or
#      the write that failed
pub fun run(cx: *args.Call) res[i64, fail.Fail] {
    val picked: res[Page, fail.Fail] = page_for(cx.a, cx.inv, cx.argv);
    if (sel picked.err) { ret res[i64, fail.Fail].err{picked.err}; }
    var out:      io_writer.Writer = fs.writer(fs.STDOUT);
    var rendered: err[fail.Fail]   = render_page(cx.a, cx.inv.commands, ?out, picked.ok, terminal_width());
    if (sel rendered.err) { ret res[i64, fail.Fail].err{rendered.err}; }
    ret res[i64, fail.Fail].ok{exit.OK};
}

# write one page wrapped to a width
# ---
# a:        allocator for the text buffer
# commands: the commands the page belongs to
# out:      the destination
# p:        the page
# width:    columns; clamped to the range 56 to 240
# ret:      as render_overview_at, render_command_page_at and render_action_page_at
pub fun render_page(a: *A.Allocator, commands: args.CommandSet, out: *io_writer.Writer, p: Page, width: usize) err[fail.Fail] {
    if (p.command == nil) { ret render_overview_at(a, commands, out, width); }
    if (p.action == nil)  { ret render_command_page_at(a, commands, out, p.command, width); }
    ret render_action_page_at(a, commands, out, p.command, p.action, width);
}

fun append(b: *textbuild.TextBuilder, s: str) bool {
    val tb_append_r: err[textbuild.Error] = textbuild.tb_append(b, s);
    ret sel tb_append_r.ok;
}

fun append_spaces(b: *textbuild.TextBuilder, n: usize) bool {
    var i: usize = 0;
    for (i < n) {
        if (!append(b, " ")) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun append_range(b: *textbuild.TextBuilder, s: str, start: usize, end: usize) bool {
    var one: [2]u8;
    one[1] = 0;
    var i: usize = start;
    for (i < end) {
        one[0] = s[i];
        if (!append(b, (?one[0])::str)) { ret false; }
        i = i + 1;
    }
    ret true;
}

rec WrapState {
    col:          usize;
    continuation: usize;
    width:        usize;
    has_text:     bool;
}

fun wrap_append(b: *textbuild.TextBuilder, state: *WrapState, text: str) bool {
    val n: usize = str_len(text);
    var i: usize = 0;
    for (i < n) {
        for (i < n && (text[i] == ' ' || text[i] == '\t' || text[i] == '\n' || text[i] == '\r')) { i = i + 1; }
        if (i >= n) { ret true; }
        val start: usize = i;
        for (i < n && text[i] != ' ' && text[i] != '\t' && text[i] != '\n' && text[i] != '\r') { i = i + 1; }
        val word_len: usize = i - start;
        var need:     usize = word_len;
        if (state.has_text) { need = need + 1; }
        if (state.has_text && state.col + need > state.width) {
            if (!append(b, "\n") || !append_spaces(b, state.continuation)) { ret false; }
            state.col      = state.continuation;
            state.has_text = false;
        }
        if (state.has_text) {
            if (!append(b, " ")) { ret false; }
            state.col = state.col + 1;
        }
        if (!append_range(b, text, start, i)) { ret false; }
        state.col      = state.col + word_len;
        state.has_text = true;
    }
    ret true;
}

fun wrap_finish(b: *textbuild.TextBuilder) bool {
    ret append(b, "\n");
}

fun normalized_width(width: usize) usize {
    if (width < MIN_WIDTH) { ret MIN_WIDTH; }
    if (width > 240)       { ret 240; }
    ret width;
}

fun terminal_width() usize {
    var buf:  [16]u8;
    val read: res[opt[usize], env.EnvError] = env.get("COLUMNS", ?buf[0], 16);
    if (sel read.err)     { ret DEFAULT_WIDTH; }
    if (sel read.ok.none) { ret DEFAULT_WIDTH; }
    val n: usize = read.ok.some;
    if (n == 0 || n >= 16) { ret DEFAULT_WIDTH; }
    var width: usize = 0;
    var i:     usize = 0;
    for (i < n) {
        if (buf[i] < '0' || buf[i] > '9') { ret DEFAULT_WIDTH; }
        width = width * 10 + (buf[i] - '0')::usize;
        i     = i + 1;
    }
    ret normalized_width(width);
}

# where a page's relations come from: the command page, or one action's block
# ---
# command: the command
# action:  the action whose block is rendered, or nil for the command page
rec Scope {
    command: *args.CommandSpec;
    action:  *args.ActionSpec;
}

# whether a shared relation belongs to a scope: in force on the command page, or in force in the
# action's schema only
fun shared_in_scope(scope: *Scope, rel: *args.Relation) bool {
    if (scope.action == nil) { ret args.relation_active(scope.command, nil, rel); }
    ret args.relation_active(scope.command, scope.action, rel) && !args.relation_active(scope.command, nil, rel);
}

# the relation at i of the scope's relations, shared ones first; nil past the end or for a shared
# relation the scope does not hold
fun scope_relation(scope: *Scope, i: usize) *args.Relation {
    if (i < args.RELATIONS_N) {
        val shared: *args.Relation = ?args.RELATIONS[i];
        if (shared_in_scope(scope, shared)) { ret shared; }
        ret nil;
    }
    val j: usize = i - args.RELATIONS_N;
    if (scope.action == nil) {
        if (j < scope.command.relation_n) { ret ?scope.command.relations[j]; }
        ret nil;
    }
    if (j < scope.action.relation_n) { ret ?scope.action.relations[j]; }
    ret nil;
}

fun scope_relation_n(scope: *Scope) usize {
    if (scope.action == nil) { ret args.RELATIONS_N + scope.command.relation_n; }
    ret args.RELATIONS_N + scope.action.relation_n;
}

# the rows a relation of kind binds row to in a scope, joined with ", "; empty when none. a
# conflict binds both ways, a requirement and an implication only from their own row
fun related(b: *textbuild.TextBuilder, scope: *Scope, row: *args.FlagSpec, kind: args.RelationKind) str {
    var text: str   = "";
    var i:    usize = 0;
    for (i < scope_relation_n(scope)) {
        val rel: *args.Relation = scope_relation(scope, i);
        i = i + 1;
        if (rel == nil || rel.kind != kind) { cnt; }
        var other: *args.FlagSpec = nil;
        if (rel.row == row)                                      { other = rel.other; }
        or (kind == args.RELATION_CONFLICTS && rel.other == row) { other = rel.row; }
        if (other == nil)                                        { cnt; }
        var said: res[str, std_format.FormatError] = std_format.sprint(b.alloc, "{}, {}", text, other.name);
        if (str_len(text) == 0) { said = std_format.sprint(b.alloc, "{}", other.name); }
        if (sel said.err) {
            b.failed = true;
            ret text;
        }
        text = said.ok;
    }
    ret text;
}

fun render_option_meta(b: *textbuild.TextBuilder, indent: str, label: str, value: str, width: usize) bool {
    if (!append(b, indent) || !append(b, "  ") || !append(b, label)) { ret false; }
    var state: WrapState;
    state.col          = str_len(indent) + 2 + str_len(label);
    state.continuation = str_len(indent) + 4;
    state.width        = width;
    state.has_text     = str_len(label) > 0;
    if (!wrap_append(b, ?state, value)) { ret false; }
    ret wrap_finish(b);
}

fun render_related(b: *textbuild.TextBuilder, scope: *Scope, row: *args.FlagSpec, kind: args.RelationKind, label: str, indent: str, width: usize) bool {
    val names: str = related(b, scope, row, kind);
    if (str_len(names) == 0) { ret !b.failed; }
    ret render_option_meta(b, indent, label, names, width);
}

fun render_option(b: *textbuild.TextBuilder, scope: *Scope, table: *args.TableRef, j: usize, indent: str, width: usize) bool {
    val flag: *args.FlagSpec = table.rows[j];
    if (!append(b, indent) || !append(b, flag.name)) { ret false; }
    var label_width: usize = str_len(indent) + str_len(flag.name);
    if (flag.arity == args.ARITY_ATTACHED) {
        if (!append(b, "[=") || !append(b, flag.value) || !append(b, "]")) { ret false; }
        label_width = label_width + str_len(flag.value) + 3;
    }
    or (str_len(flag.value) > 0) {
        if (!append(b, " <") || !append(b, flag.value) || !append(b, ">")) { ret false; }
        label_width = label_width + str_len(flag.value) + 3;
    }
    var description_col: usize = FLAG_COL + str_len(indent) - 2;
    if (description_col + 12 > width) { description_col = str_len(indent) + 4; }
    if (label_width < description_col) {
        if (!append_spaces(b, description_col - label_width)) { ret false; }
    }
    or {
        if (!append(b, "\n") || !append_spaces(b, description_col)) { ret false; }
    }
    var state: WrapState;
    state.col          = description_col;
    state.continuation = description_col;
    state.width        = width;
    state.has_text     = false;
    if (!wrap_append(b, ?state, args.row_doc(table, j)) || !wrap_finish(b)) { ret false; }
    if (str_len(flag.default) > 0) {
        if (!render_option_meta(b, indent, "default:", flag.default, width)) { ret false; }
    }
    if (flag.repeatable && !render_option_meta(b, indent, "", "repeatable", width))            { ret false; }
    if (!render_related(b, scope, flag, args.RELATION_CONFLICTS, "conflicts:", indent, width)) { ret false; }
    if (!render_related(b, scope, flag, args.RELATION_REQUIRES, "requires:", indent, width))   { ret false; }
    if (!render_related(b, scope, flag, args.RELATION_IMPLIES, "implies:", indent, width))     { ret false; }
    if (flag.alias_of != nil) {
        if (!render_option_meta(b, indent, "alias of:", flag.alias_of.name, width)) { ret false; }
    }
    ret true;
}

fun render_tables(b: *textbuild.TextBuilder, scope: *Scope, tables: *args.TableRef, table_n: usize, indent: str, width: usize) bool {
    var i: usize = 0;
    for (i < table_n) {
        val table: *args.TableRef = ?tables[i];
        var j:     usize          = 0;
        for (j < table.n) {
            if (table.accepted != nil && !table.accepted[j]) {
                j = j + 1;
                cnt;
            }
            if (!render_option(b, scope, table, j, indent, width)) { ret false; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret true;
}

fun render_aliases(b: *textbuild.TextBuilder, aliases: *str, alias_n: usize) bool {
    if (alias_n == 0)             { ret true; }
    if (!append(b, "aliases:\n")) { ret false; }
    var i: usize = 0;
    for (i < alias_n) {
        if (!append(b, "  ") || !append(b, aliases[i]) || !append(b, "\n")) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun render_examples(b: *textbuild.TextBuilder, examples: *str, example_n: usize, indent: str, width: usize) bool {
    if (example_n == 0)                                                      { ret true; }
    if (!append(b, "\n") || !append(b, indent) || !append(b, "examples:\n")) { ret false; }
    var i: usize = 0;
    for (i < example_n) {
        if (!append(b, indent) || !append(b, "  ")) { ret false; }
        var state: WrapState;
        state.col          = str_len(indent) + 2;
        state.continuation = state.col;
        state.width        = width;
        state.has_text     = false;
        if (!wrap_append(b, ?state, examples[i]) || !wrap_finish(b)) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun render_constraint(b: *textbuild.TextBuilder, text: str, indent: str, width: usize) bool {
    if (!append(b, indent) || !append(b, "  ")) { ret false; }
    var state: WrapState;
    state.col          = str_len(indent) + 2;
    state.continuation = state.col;
    state.width        = width;
    state.has_text     = false;
    ret wrap_append(b, ?state, text) && wrap_finish(b);
}

# the constraints of a scope: the sentence of each relation that can be broken, which is the text
# a refusal of it prints, then the scope's own sentences
fun render_constraints(b: *textbuild.TextBuilder, scope: *Scope, constraints: *str, constraint_n: usize, indent: str, width: usize) bool {
    var heading: bool  = false;
    var i:       usize = 0;
    for (i < scope_relation_n(scope) + constraint_n) {
        var text: str = "";
        if (i < scope_relation_n(scope)) {
            val rel: *args.Relation = scope_relation(scope, i);
            if (rel != nil) {
                val said: res[str, fail.Fail] = args.relation_text(b.alloc, rel);
                if (sel said.err) { ret false; }
                text = said.ok;
            }
        }
        or { text = constraints[i - scope_relation_n(scope)]; }
        i = i + 1;
        if (str_len(text) == 0) { cnt; }
        if (!heading) {
            if (!append(b, "\n") || !append(b, indent) || !append(b, "constraints:\n")) { ret false; }
            heading = true;
        }
        if (!render_constraint(b, text, indent, width)) { ret false; }
    }
    ret true;
}

fun render_overview_body(b: *textbuild.TextBuilder, commands: args.CommandSet, width: usize) bool {
    if (!append(b, "mach ") || !append(b, lang_version.MACH_VERSION) || !append(b, " - the Mach compiler\n\n")) { ret false; }
    if (!append(b, "usage: mach <command> [options]\n\ncommands:\n"))                                           { ret false; }
    var i: usize = 0;
    for (i < commands.n) {
        val command: *args.CommandSpec = commands.specs[i];
        if (!append(b, "  ") || !append(b, command.name)) { ret false; }
        val label_width: usize = 2 + str_len(command.name);
        if (label_width < 12 && !append_spaces(b, 12 - label_width)) { ret false; }
        if (label_width >= 12 && !append(b, "\n            "))       { ret false; }
        var state: WrapState;
        state.col          = 12;
        state.continuation = 12;
        state.width        = width;
        state.has_text     = false;
        if (!wrap_append(b, ?state, command.summary)) { ret false; }
        if (command.alias_n > 0) {
            if (!wrap_append(b, ?state, "(aliases:")) { ret false; }
            var j: usize = 0;
            for (j < command.alias_n) {
                if (!wrap_append(b, ?state, command.aliases[j])) { ret false; }
                j = j + 1;
            }
            if (!wrap_append(b, ?state, ")")) { ret false; }
        }
        if (!wrap_finish(b)) { ret false; }
        i = i + 1;
    }
    if (commands.global_n > 0 && !append(b, "\noptions:\n")) { ret false; }
    var g: usize = 0;
    for (g < commands.global_n) {
        val row: *args.FlagSpec = commands.globals[g].row;
        if (!append(b, "  ") || !append(b, row.name)) { ret false; }
        val label_width: usize = 2 + str_len(row.name);
        if (label_width < 12 && !append_spaces(b, 12 - label_width)) { ret false; }
        if (label_width >= 12 && !append(b, "\n            "))       { ret false; }
        var state: WrapState;
        state.col          = 12;
        state.continuation = 12;
        state.width        = width;
        state.has_text     = false;
        if (!wrap_append(b, ?state, row.doc) || !wrap_finish(b)) { ret false; }
        g = g + 1;
    }
    if (!append(b, "\n")) { ret false; }
    var footer: WrapState;
    footer.col          = 0;
    footer.continuation = 0;
    footer.width        = width;
    footer.has_text     = false;
    ret wrap_append(b, ?footer, "use 'mach help <command>' or 'mach <command> -h' for detailed usage.")
        && wrap_finish(b);
}

fun render_actions(b: *textbuild.TextBuilder, command: *args.CommandSpec, width: usize) bool {
    if (!append(b, "\nactions:\n")) { ret false; }
    var i: usize = 0;
    for (i < command.action_n) {
        if (!render_action(b, command, ?command.actions[i], width)) { ret false; }
        i = i + 1;
    }
    ret true;
}

# one action's block, as the command page lists it and as `mach help <cmd> <action>` prints it
fun render_action(b: *textbuild.TextBuilder, command: *args.CommandSpec, action: *args.ActionSpec, width: usize) bool {
    var scope: Scope = Scope{command: command, action: action};
    if (!append(b, "  ")) { ret false; }
    var heading: WrapState;
    heading.col          = 2;
    heading.continuation = 4;
    heading.width        = width;
    heading.has_text     = false;
    if (!wrap_append(b, ?heading, action.name) || !wrap_append(b, ?heading, action.grammar)
        || !wrap_finish(b) || !append(b, "    ")) { ret false; }
    var effect: WrapState;
    effect.col          = 4;
    effect.continuation = 4;
    effect.width        = width;
    effect.has_text     = false;
    if (!wrap_append(b, ?effect, action.effect))                        { ret false; }
    if (!wrap_finish(b) || !append(b, "    exit:\n"))                   { ret false; }
    if (!render_exits(b, action.exits, action.exit_n, "      ", width)) { ret false; }
    if (action.table_n > 0) {
        if (!append(b, "    options:\n") || !render_tables(b, ?scope, action.tables, action.table_n, "      ", width)) { ret false; }
    }
    if (!render_constraints(b, ?scope, action.constraints, action.constraint_n, "    ", width)) { ret false; }
    if (!render_examples(b, action.examples, action.example_n, "    ", width))                  { ret false; }
    ret true;
}

fun render_command_body(b: *textbuild.TextBuilder, commands: args.CommandSet, command: *args.CommandSpec, width: usize) bool {
    if (command == ?COMMAND)       { ret render_overview_body(b, commands, width); }
    if (!append(b, "usage: mach")) { ret false; }
    var scope: Scope = Scope{command: command, action: nil};
    var usage: WrapState;
    usage.col          = 11;
    usage.continuation = 2;
    usage.width        = width;
    usage.has_text     = true;
    if (!wrap_append(b, ?usage, command.name) || !wrap_append(b, ?usage, command.grammar)
        || !wrap_finish(b) || !append(b, "\n")) { ret false; }
    if (!render_aliases(b, command.aliases, command.alias_n)) { ret false; }
    if (!append(b, "effect:"))                                { ret false; }
    var effect: WrapState;
    effect.col          = 7;
    effect.continuation = 8;
    effect.width        = width;
    effect.has_text     = true;
    if (!wrap_append(b, ?effect, command.effect) || !wrap_finish(b)) { ret false; }
    if (str_len(command.terminator) > 0) {
        if (!append(b, "terminator:")) { ret false; }
        var terminator: WrapState;
        terminator.col          = 11;
        terminator.continuation = 12;
        terminator.width        = width;
        terminator.has_text     = true;
        if (!wrap_append(b, ?terminator, command.terminator) || !wrap_finish(b)) { ret false; }
    }
    if (command.table_n > 0) {
        if (!append(b, "\noptions:\n") || !render_tables(b, ?scope, command.tables, command.table_n, "  ", width)) { ret false; }
    }
    if (!render_constraints(b, ?scope, command.constraints, command.constraint_n, "", width)) { ret false; }
    if (command.action_n > 0 && !render_actions(b, command, width))                           { ret false; }
    if (!render_examples(b, command.examples, command.example_n, "", width))                  { ret false; }
    if (!append(b, "\nexit:\n"))                                                              { ret false; }
    ret render_exits(b, command.exits, command.exit_n, "  ", width);
}

# one exit row: the code, or `any` for the codes a command forwards, then its meaning
# and, when a command refines a shared code, `or` and the refinement
fun render_exit_row(b: *textbuild.TextBuilder, code: i64, meaning: str, refinement: str, indent: str, width: usize) bool {
    var label: [std_format.DECIMAL_MAX + 1]u8;
    var n:     usize = 0;
    if (code == exit.PASSTHROUGH) {
        label[0] = 'a';
        label[1] = 'n';
        label[2] = 'y';
        n        = 3;
    }
    or { n = std_format.put_i64(?label[0], code); }
    label[n] = 0;
    if (!append(b, indent) || !append(b, (?label[0])::str) || !append_spaces(b, EXIT_COL - n)) { ret false; }
    var row: WrapState;
    row.col          = str_len(indent) + EXIT_COL;
    row.continuation = row.col;
    row.width        = width;
    row.has_text     = false;
    if (!wrap_append(b, ?row, meaning))                                                                { ret false; }
    if (str_len(refinement) > 0 && (!wrap_append(b, ?row, "or") || !wrap_append(b, ?row, refinement))) { ret false; }
    ret wrap_finish(b);
}

# the exit rows of a page: a forwarded code first, then exit.SHARED with the command's
# refinements, then the command's own codes
fun render_exits(b: *textbuild.TextBuilder, own: *exit.Note, own_n: usize, indent: str, width: usize) bool {
    var i: usize = 0;
    for (i < own_n) {
        if (own[i].code == exit.PASSTHROUGH && !render_exit_row(b, own[i].code, own[i].meaning, "", indent, width)) { ret false; }
        i = i + 1;
    }
    var si: usize = 0;
    for (si < exit.SHARED_N) {
        val shared:     *exit.Note = ?exit.SHARED[si];
        var refinement: str        = "";
        var j:          usize      = 0;
        for (j < own_n) {
            if (own[j].code == shared.code) { refinement = own[j].meaning; }
            j = j + 1;
        }
        if (!render_exit_row(b, shared.code, shared.meaning, refinement, indent, width)) { ret false; }
        si = si + 1;
    }
    i = 0;
    for (i < own_n) {
        val code: i64 = own[i].code;
        if (code != exit.PASSTHROUGH && !exit.shared(code) && !render_exit_row(b, code, own[i].meaning, "", indent, width)) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun publish(b: *textbuild.TextBuilder, out: *io_writer.Writer) err[fail.Fail] {
    if (textbuild.tb_failed(b)) {
        textbuild.tb_dnit(b);
        ret err[fail.Fail].err{fail.message("help: failed to build output")};
    }
    val fault: err[io_writer.WriteError] = io_writer.write_all(out, b.data, b.len);
    textbuild.tb_dnit(b);
    if (sel fault.err) { ret err[fail.Fail].err{fail.environment(diagnostic_kind.OUTPUT_WRITE, fail.write_text(fault.err))}; }
    ret err[fail.Fail].ok{};
}

# write the command overview wrapped to a width
# ---
# a:               allocator for the text buffer
# commands:        the commands to list
# out:             the destination
# requested_width: columns; clamped to the range 56 to 240
# ret:             ok, or an error when the command set is invalid, the buffer could not be built,
#                  or the write failed
pub fun render_overview_at(a: *A.Allocator, commands: args.CommandSet, out: *io_writer.Writer, requested_width: usize) err[fail.Fail] {
    if (!args.schema_valid(commands)) { ret err[fail.Fail].err{fail.message("help: invalid command schema")}; }
    val width: usize                 = normalized_width(requested_width);
    var b:     textbuild.TextBuilder = textbuild.tb_init(a);
    render_overview_body(?b, commands, width);
    ret publish(?b, out);
}

# write the command overview at the terminal width read from COLUMNS, 100 when unset or
# not a number
# ---
# a:        allocator for the text buffer
# commands: the commands to list
# out:      the destination
# ret:      as render_overview_at
pub fun render_overview(a: *A.Allocator, commands: args.CommandSet, out: *io_writer.Writer) err[fail.Fail] {
    ret render_overview_at(a, commands, out, terminal_width());
}

# write one command's help page wrapped to a width
# ---
# a:               allocator for the text buffer
# commands:        the commands the page belongs to
# out:             the destination
# command:         the command
# requested_width: columns; clamped to the range 56 to 240
# ret:             ok, or an error when the command set is invalid, the buffer could not be built,
#                  or the write failed
pub fun render_command_page_at(a: *A.Allocator, commands: args.CommandSet, out: *io_writer.Writer, command: *args.CommandSpec,
    requested_width: usize) err[fail.Fail] {
    if (!args.schema_valid(commands)) { ret err[fail.Fail].err{fail.message("help: invalid command schema")}; }
    val width: usize                 = normalized_width(requested_width);
    var b:     textbuild.TextBuilder = textbuild.tb_init(a);
    render_command_body(?b, commands, command, width);
    ret publish(?b, out);
}

# write one action's block wrapped to a width
# ---
# a:               allocator for the text buffer
# commands:        the commands the action's command belongs to
# out:             the destination
# command:         the command
# action:          one of its actions
# requested_width: columns; clamped to the range 56 to 240
# ret:             ok, or an error when the command set is invalid, the buffer could not be built,
#                  or the write failed
pub fun render_action_page_at(a: *A.Allocator, commands: args.CommandSet, out: *io_writer.Writer, command: *args.CommandSpec,
    action: *args.ActionSpec, requested_width: usize) err[fail.Fail] {
    if (!args.schema_valid(commands)) { ret err[fail.Fail].err{fail.message("help: invalid command schema")}; }
    var b: textbuild.TextBuilder = textbuild.tb_init(a);
    render_action(?b, command, action, normalized_width(requested_width));
    ret publish(?b, out);
}
