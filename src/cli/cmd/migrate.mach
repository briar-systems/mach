# `mach migrate`, which rewrites a project's manifest and source to this major's spelling
#
# a script that may run mach beside the source, and a step whose `argv` runs mach, is read
# for removed options, and every script and step for the step environment 6 set, which are
# reported and never rewritten. under `--check` nothing is written.

use std_args: std.args;
use std.collections.slice.Slice;
use std.collections.sort;
use collections_vector: std.collections.vector;
use std.collections.vector.Vector;
use fs:         std.filesystem;
use std_format: std.format;
use io_error:   std.io.error;
use io_writer:  std.io.writer;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.StrError;
use std.types.string.str;
use std.types.string.str_compare;
use std.types.string.str_copy_slice;
use std.types.string.str_ends_with;
use std.types.string.str_equals;
use std.types.string.str_is_empty;
use std.types.string.str_len;
use std.types.string.str_region_equals;
use std.types.string.str_starts_with;
use std.types.view.View;
use toml_lookup: toml.lookup;
use toml_value:  toml.value;

use A: std.allocator;

use mach.base.diagnostic;
use diagnostic_kind: mach.base.diagnostic.kind;
use mach.base.fail;
use base_source: mach.base.source;
use mach.cli.args;
use cli_diagnostic: mach.cli.diagnostic;
use mach.cli.exit;
use mach.cli.rewrite;
use mach.cli.util;
use compile_closure: mach.compile.closure;
use mach.front.transition;
use mach.host.listing;
use manifest_load: mach.manifest.load;
use mach.manifest.schema;
use manifest_target: mach.manifest.target;
use mach.report.layout;
use mach.tool.migrate;
use mink_fail:     mink.base.fail;
use macho_library: mink.format.macho.neutral.library;

# a manifest's text in this major's spelling
fun keyed(a: *A.Allocator, text: str, diags: *diagnostic.DiagnosticStore, context: ptr) res[str, fail.Fail] {
    ret migrate.manifest(a, text);
}

# a source's text in this major's spelling
fun spelled(a: *A.Allocator, text: str, diags: *diagnostic.DiagnosticStore, context: ptr) res[str, fail.Fail] {
    ret migrate.source(a, text, diags, context::*Vector[migrate.Dependency]);
}

# a script is a file that may run a build beside the source, read for removed options. it is
# reported, never rewritten: what it runs is its author's. a file is a script by its name, its
# suffix, its place among the CI workflows, or a `#!` line on an executable file
val SCRIPT_NAME_COUNT:   usize                    = 3;
val SCRIPT_NAMES:        [SCRIPT_NAME_COUNT]str   = [SCRIPT_NAME_COUNT]str{"Makefile", "makefile", "GNUmakefile"};
val SCRIPT_SUFFIX_COUNT: usize                    = 6;
val SCRIPT_SUFFIXES:     [SCRIPT_SUFFIX_COUNT]str = [SCRIPT_SUFFIX_COUNT]str{".sh", ".bash", ".mk", ".ps1", ".bat", ".cmd"};
val WORKFLOWS:           str                      = ".github/workflows/";

# the deepest directory nesting the search for scripts follows
val SCRIPT_DEPTH: usize = 64;

# where a project's directories stand, relative to its root, as the migration leaves its manifest
# ---
# id:   the project's id, which the closing line names
# src:  the source directory, which holds no script
# work: the leading directories of the work directory, which hold only what builds write; nil
#       when the work directory starts with a variable
rec Dirs {
    id:   str;
    src:  str;
    work: str;
}

# whether `word` stands in `text` from `start` to `end`, at a word's edges
fun names_in(text: str, start: usize, end: usize, word: str) bool {
    ret migrate.word_in(text, start, end, word) != end;
}

# a cursor over a script's text from `at` to `end`, `line` the line `at` stands on
rec Scan {
    text: str;
    at:   usize;
    end:  usize;
    line: usize;
}

# one word of a script: its bytes from `at` for `len`, and the line it starts on
rec Word {
    at:   usize;
    len:  usize;
    line: usize;
}

fun is_blank(c: u8) bool {
    ret c == ' ' || c == '\t' || c == '\r';
}

# whether the byte at `i` ends a word: a blank, a line break, or a byte that separates commands
fun word_ends(s: *Scan, i: usize) bool {
    val c: u8 = s.text[i];
    if (is_blank(c) || c == '\n' || c == ';' || c == '(' || c == ')' || c == '`' || c == '|') { ret true; }
    ret c == '&' && i + 1 < s.end && s.text[i + 1] == '&';
}

# the next word of the simple command at the cursor into `w`; false when the command ends there,
# the cursor then past what ended it: `&&`, `||`, `|`, `;`, `(`, `)`, a backquote, or a line break
# no `\` continues. a `#` where a word would start comments out the rest of the line
fun next_word(s: *Scan, w: *Word) bool {
    for (s.at < s.end) {
        val c: u8 = s.text[s.at];
        if (is_blank(c)) { s.at = s.at + 1; }
        or (c == '\\' && s.at + 1 < s.end && s.text[s.at + 1] == '\n') {
            s.at   = s.at + 2;
            s.line = s.line + 1;
        }
        or (c == '\\' && s.at + 2 < s.end && s.text[s.at + 1] == '\r' && s.text[s.at + 2] == '\n') {
            s.at   = s.at + 3;
            s.line = s.line + 1;
        }
        or { brk; }
    }
    if (s.at >= s.end) { ret false; }
    val c: u8 = s.text[s.at];
    if (c == '#') {
        for (s.at < s.end && s.text[s.at] != '\n') { s.at = s.at + 1; }
        ret false;
    }
    if (c == '\n') {
        s.at   = s.at + 1;
        s.line = s.line + 1;
        ret false;
    }
    if (c == '&' || c == '|') {
        s.at = s.at + 1;
        if (s.at < s.end && s.text[s.at] == c) { s.at = s.at + 1; }
        ret false;
    }
    if (word_ends(s, s.at)) {
        s.at = s.at + 1;
        ret false;
    }
    w.at   = s.at;
    w.line = s.line;
    var quote: u8 = 0;
    for (s.at < s.end) {
        val b: u8 = s.text[s.at];
        if (quote != 0) {
            if (b == quote) { quote = 0; }
            or (b == '\n')  { s.line = s.line + 1; }
            s.at = s.at + 1;
            cnt;
        }
        if (b == '$' && s.at + 2 < s.end && s.text[s.at + 1] == '{' && s.text[s.at + 2] == '{') {
            expression_skip(s);
            cnt;
        }
        if (b == '"' || b == '\'') {
            quote = b;
            s.at  = s.at + 1;
            cnt;
        }
        if (b == '\\') {
            # a continued line ends the word, and any other escape is part of it
            if (s.at + 1 < s.end && s.text[s.at + 1] == '\n')                             { brk; }
            if (s.at + 2 < s.end && s.text[s.at + 1] == '\r' && s.text[s.at + 2] == '\n') { brk; }
            s.at = s.at + 2;
            if (s.at > s.end) { s.at = s.end; }
            cnt;
        }
        if (word_ends(s, s.at)) { brk; }
        s.at = s.at + 1;
    }
    w.len = s.at - w.at;
    ret true;
}

# move the cursor past the workflow expression `${{ ... }}` it stands at, which the runner
# replaces before the shell reads the line, so what it holds is part of the word it stands in.
# a quote in it opens or closes one of its strings, and `''` in a string stands for a quote
fun expression_skip(s: *Scan) {
    s.at = s.at + 3;
    var quoted: bool = false;
    for (s.at < s.end) {
        val b: u8 = s.text[s.at];
        if (b == '\n') { s.line = s.line + 1; }
        if (b == '\'') { quoted = !quoted; }
        or (!quoted && b == '}' && s.at + 1 < s.end && s.text[s.at + 1] == '}') {
            s.at = s.at + 2;
            ret;
        }
        s.at = s.at + 1;
    }
}

# the bytes of `w` inside one pair of quotes around the whole word, if it has them
fun unquoted(text: str, w: Word) Word {
    if (w.len < 2) { ret w; }
    val q: u8 = text[w.at];
    if ((q != '"' && q != '\'') || text[w.at + w.len - 1] != q) { ret w; }
    ret Word{at: w.at + 1, len: w.len - 2, line: w.line};
}

fun word_is(text: str, w: Word, s: str) bool {
    ret w.len == str_len(s) && str_region_equals(text, w.at, w.len, s);
}

# whether `w` is the option `name`, alone or with its value after `=`
fun word_option(text: str, w: Word, name: str) bool {
    val n: usize = str_len(name);
    if (w.len < n || !str_region_equals(text, w.at, n, name)) { ret false; }
    ret w.len == n || text[w.at + n] == '=';
}

# whether `w`, a word in a command's place, names mach: `mach`, a path ending in `/mach`, or
# `$MACH` or `${MACH}`, any of them quoted, after the `@`, `-` and `+` a make recipe may lead with
fun runs_mach_word(text: str, word: Word) bool {
    var w: Word = unquoted(text, word);
    for (w.len > 1 && (text[w.at] == '@' || text[w.at] == '-' || text[w.at] == '+')) {
        w.at  = w.at + 1;
        w.len = w.len - 1;
    }
    if (word_is(text, w, "mach") || word_is(text, w, "$MACH") || word_is(text, w, "${MACH}")) { ret true; }
    ret w.len > 5 && str_region_equals(text, w.at + w.len - 5, 5, "/mach");
}

# whether `w` stands before a command's word without being it: an assignment to a variable, or
# a workflow step's `-` and `run:`
fun command_prefix(text: str, w: Word) bool {
    if (word_is(text, w, "-") || word_is(text, w, "run:")) { ret true; }
    var i: usize = 0;
    for (i < w.len) {
        val c: u8 = text[w.at + i];
        if (c == '=')                                                                                  { ret i > 0; }
        if (!((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_')) { ret false; }
        i = i + 1;
    }
    ret false;
}

# each removed option the word `option` of a mach invocation in `name` is, located on `line`.
# `path` is the invocation's leading words after `mach`, which a row for one command is held to
fun removed_report(out: *io_writer.Writer, name: str, text: str, option: Word, line: usize, path: str) {
    var i: usize = 0;
    for (i < args.REMOVED_N) {
        val removed: *args.Removed = ?args.REMOVED[i];
        i = i + 1;
        if (args.removed_in(removed, path) && word_option(text, option, removed.name)) {
            std_format.format(out, "{}:{}: option '{}' is not allowed. use {}\n", name, line, removed.name, removed.use);
        }
    }
}

# each removed option a string of a workflow expression `${{ ... }}` in the word `w` is, since
# the runner writes the string into the command in the expression's place
fun expression_report(out: *io_writer.Writer, name: str, text: str, w: Word, path: str) {
    val end:    usize = w.at + w.len;
    var i:      usize = w.at;
    var inside: bool  = false;
    for (i < end) {
        if (!inside) {
            if (i + 2 < end && text[i] == '$' && text[i + 1] == '{' && text[i + 2] == '{') {
                inside = true;
                i      = i + 3;
                cnt;
            }
            i = i + 1;
            cnt;
        }
        if (text[i] == '}' && i + 1 < end && text[i + 1] == '}') {
            inside = false;
            i      = i + 2;
            cnt;
        }
        if (text[i] == '\'') {
            var close: usize = i + 1;
            for (close < end && text[close] != '\'') { close = close + 1; }
            removed_report(out, name, text, Word{at: i + 1, len: close - i - 1, line: w.line}, w.line, path);
            i = close + 1;
            cnt;
        }
        i = i + 1;
    }
}

# each removed option a mach invocation in the script `name` writes, from `at` to `end` of its
# text, located on its own line. only the words of the simple command whose command word names
# mach are read, so another program's options are never taken for mach's, and a row for one
# command only in an invocation of that command. a workflow's `run: '...'` is read inside its
# quotes, and each string of a `${{ ... }}` expression as a word of the command it stands in
fun script_report(out: *io_writer.Writer, a: *A.Allocator, name: str, text: str, at: usize, end: usize, line: usize) {
    var s: Scan = Scan{text: text, at: at, end: end, line: line};
    for (s.at < s.end) {
        var w:       Word;
        var placed:  bool             = false;
        var runs:    bool             = false;
        var after:   bool             = false;
        var leading: bool             = true;
        var path:    str              = "";
        var lead:    io_writer.Memory;
        var lw:      io_writer.Writer = io_writer.memory_growing(?lead, a);
        fin { io_writer.memory_dnit(?lead); }
        for (next_word(?s, ?w)) {
            if (!placed) {
                if (after) {
                    val inner: Word = unquoted(text, w);
                    if (inner.len != w.len) {
                        script_report(out, a, name, text, inner.at, inner.at + inner.len, w.line);
                        cnt;
                    }
                }
                after = word_is(text, w, "run:");
                if (command_prefix(text, w)) { cnt; }
                placed = true;
                runs   = runs_mach_word(text, w);
                cnt;
            }
            if (!runs) { cnt; }
            val option: Word = unquoted(text, w);
            if (leading) {
                # the words before the first option name the command
                if (option.len > 0 && text[option.at] != '-') {
                    if (lead.len != 0) { io_writer.write_str(?lw, " "); }
                    io_writer.write_all(?lw, ?text[option.at], option.len);
                    cnt;
                }
                leading = false;
                path    = io_writer.memory_text(?lead);
            }
            removed_report(out, name, text, option, w.line, path);
            expression_report(out, name, text, w, path);
        }
    }
}

# a step environment variable 6 set, and the name 7 sets it by
# ---
# from: the name 6 set
# to:   the name 7 sets
rec Renamed {
    from: str;
    to:   str;
}

# row count of VARIABLES
val VARIABLES_N: usize = 2;
# the step environment variables 6 set that 7 names otherwise
val VARIABLES: [VARIABLES_N]Renamed = [VARIABLES_N]Renamed{
    Renamed{from: "MACH_TARGET_ISA", to: "MACH_TARGET_ARCH"},
    Renamed{from: "MACH_TARGET_OS", to: "MACH_TARGET_SYS"},
};

# whether `c` can stand in a variable's name
fun name_byte(c: u8) bool {
    ret (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_';
}

# each step environment variable 6 set that `name` reads from `at` to `end` of `text`, located on
# its line. it is found wherever it stands with no byte of a name on either side, as `$X`, `${X:-}`,
# `%X%` or `$env:X` write it, since a script or a step reads its environment anywhere
fun variables_report(out: *io_writer.Writer, name: str, text: str, at: usize, end: usize) {
    var i: usize = at;
    for (i < end) {
        var step: usize = 1;
        var r:    usize = 0;
        for (r < VARIABLES_N) {
            val renamed: *Renamed = ?VARIABLES[r];
            val len:     usize    = str_len(renamed.from);
            r = r + 1;
            if (i + len > end || !str_region_equals(text, i, len, renamed.from)) { cnt; }
            if (i > at && name_byte(text[i - 1]))                                { cnt; }
            if (i + len < end && name_byte(text[i + len]))                       { cnt; }
            std_format.format(out, "{}:{}: {} is not set by a build step. use {}\n", name, line_of(text, i), renamed.from, renamed.to);
            step = len;
        }
        i = i + step;
    }
}

# whether the file at `rel`, its name `leaf`, is a script by its name, suffix or place
fun script_named(rel: str, leaf: str) bool {
    var i: usize = 0;
    for (i < SCRIPT_NAME_COUNT) {
        if (str_equals(leaf, SCRIPT_NAMES[i])) { ret true; }
        i = i + 1;
    }
    i = 0;
    for (i < SCRIPT_SUFFIX_COUNT) {
        if (str_ends_with(leaf, SCRIPT_SUFFIXES[i])) { ret true; }
        i = i + 1;
    }
    ret str_starts_with(rel, WORKFLOWS) && (str_ends_with(leaf, ".yml") || str_ends_with(leaf, ".yaml"));
}

# each script under the directory `rel` of the project at `root`, `rel` empty for the root itself,
# reported. dep/, the source and the work directory hold no script of the project's, a `.git`
# directory none at all, and a link is not followed
fun scripts_in(out: *io_writer.Writer, a: *A.Allocator, root: str, rel: str, dirs: *Dirs, depth: usize) err[fail.Fail] {
    if (depth >= SCRIPT_DEPTH) { ret err[fail.Fail].err{fail.formatted_user(a, diagnostic_kind.SOURCE_NESTING_DEPTH, "'{}' is nested more than 64 directories deep in the search for scripts", rel)}; }
    var dir: str = root;
    if (!str_is_empty(rel)) {
        val res_joined: res[str, fail.Fail] = diagnostic.join(a, root, "/", rel);
        if (sel res_joined.err) { ret err[fail.Fail].err{res_joined.err}; }
        dir = res_joined.ok;
    }
    fin {
        if (dir != root) { str_free(a, dir); }
    }
    val res_listed: res[Vector[fs.Listed], fs.FsError] = fs.read_dir(a, dir);
    if (sel res_listed.err) { ret err[fail.Fail].err{fail.refusal(a, diagnostic_kind.FS_READ, fail.Op{verb: "list", path: dir}, fail.Cause.fs{res_listed.err})}; }
    var entries: Vector[fs.Listed] = res_listed.ok;
    fin { fs.listed_dnit(?entries); }
    val res_names: res[Vector[str], fail.Fail] = listing.names(a, dir, ?entries);
    if (sel res_names.err) { ret err[fail.Fail].err{res_names.err}; }
    var names: Vector[str] = res_names.ok;
    fin { collections_vector.dnit[str](?names); }
    sort.sort_by[str](names.data, names.len, by_name);
    var i: usize = 0;
    for (i < names.len) {
        val leaf: str = names.data[i];
        i = i + 1;
        var child: str = leaf;
        if (!str_is_empty(rel)) {
            val res_joined: res[str, fail.Fail] = diagnostic.join(a, rel, "/", leaf);
            if (sel res_joined.err) { ret err[fail.Fail].err{res_joined.err}; }
            child = res_joined.ok;
        }
        fin {
            if (child != leaf) { str_free(a, child); }
        }
        val res_path: res[str, fail.Fail] = diagnostic.join(a, root, "/", child);
        if (sel res_path.err) { ret err[fail.Fail].err{res_path.err}; }
        fin { str_free(a, res_path.ok); }
        val res_meta: res[fs.Metadata, io_error.Error] = fs.metadata_link(res_path.ok);
        if (sel res_meta.err) { ret err[fail.Fail].err{fail.refusal(a, diagnostic_kind.FS_STAT, fail.Op{verb: "inspect", path: res_path.ok}, fail.Cause.io{res_meta.err})}; }
        if (fs.meta_is_dir(?res_meta.ok)) {
            if (str_equals(leaf, ".git") || str_equals(child, "dep") || str_equals(child, dirs.src)) { cnt; }
            if (dirs.work != nil && str_equals(child, dirs.work))                                    { cnt; }
            val err_inner: err[fail.Fail] = scripts_in(out, a, root, child, dirs, depth + 1);
            if (sel err_inner.err) { ret err_inner; }
            cnt;
        }
        if (!fs.meta_is_file(?res_meta.ok)) { cnt; }
        val named:      bool = script_named(child, leaf);
        val executable: bool = (res_meta.ok.mode & 0o111) != 0;
        if (!named && !executable) { cnt; }
        val opt_read: opt[str] = rewrite.text_of(a, res_path.ok);
        if (sel opt_read.none) { cnt; }
        if (named || str_starts_with(opt_read.some, "#!")) {
            script_report(out, a, child, opt_read.some, 0, str_len(opt_read.some), 1);
            variables_report(out, child, opt_read.some, 0, str_len(opt_read.some));
        }
        str_free(a, opt_read.some);
    }
    ret err[fail.Fail].ok{};
}

fun by_name(x: *str, y: *str) i64 {
    ret str_compare(@x, @y);
}

# the leading words of the mach invocation the step `argv` writes, after the word that names
# mach and before its first option, into `w`: the items after an item that is mach, or the words
# after mach within one item, as an item `sh -c` runs writes them
fun step_path(w: *io_writer.Writer, text: str, argv: *toml_value.Array) {
    var found: bool  = false;
    var wrote: bool  = false;
    var k:     usize = 0;
    for (k < toml_lookup.array_len(argv)) {
        val opt_arg: opt[*toml_value.Value] = toml_lookup.array_get(argv, k);
        k = k + 1;
        if (sel opt_arg.none) { cnt; }
        val item: Word = unquoted(text, Word{at: opt_arg.some.span.at, len: opt_arg.some.span.len, line: 0});
        if (found) {
            if (item.len == 0 || text[item.at] == '-') { ret; }
            if (wrote)                                 { io_writer.write_str(w, " "); }
            io_writer.write_all(w, ?text[item.at], item.len);
            wrote = true;
            cnt;
        }
        if (runs_mach_word(text, item)) {
            found = true;
            cnt;
        }
        if (!names_in(text, item.at, item.at + item.len, "mach")) { cnt; }
        var s:    Scan = Scan{text: text, at: item.at, end: item.at + item.len, line: 0};
        var word: Word;
        var runs: bool = false;
        for (s.at < s.end) {
            for (next_word(?s, ?word)) {
                val option: Word = unquoted(text, word);
                if (!runs) {
                    runs = runs_mach_word(text, word);
                    cnt;
                }
                if (option.len == 0 || text[option.at] == '-') { ret; }
                if (wrote)                                     { io_writer.write_str(w, " "); }
                io_writer.write_all(w, ?text[option.at], option.len);
                wrote = true;
            }
            if (runs) { ret; }
        }
    }
}

# each removed option the `argv` of a step that runs mach writes, and each step environment
# variable 6 set that a step's `argv` or `env` reads, located in the manifest `doc`. an option the
# migration rewrites in a step is not one
fun step_report(out: *io_writer.Writer, a: *A.Allocator, doc: *manifest_load.Doc) {
    val opt_steps: opt[*toml_value.Table] = toml_lookup.get_table(?doc.table, "step");
    if (sel opt_steps.none) { ret; }
    var s: usize = 0;
    for (s < toml_lookup.table_len(opt_steps.some)) {
        val opt_step: opt[*toml_value.Value] = toml_lookup.table_value(opt_steps.some, s);
        s = s + 1;
        if (sel opt_step.none)                          { cnt; }
        if (opt_step.some.tag != toml_value.TYPE_TABLE) { cnt; }
        val opt_env: opt[*toml_value.Value] = toml_lookup.get(?opt_step.some.data.table, "env");
        if (sel opt_env.some) {
            val env: *toml_value.Value = opt_env.some;
            var e:   usize             = 0;
            for (env.tag == toml_value.TYPE_TABLE && e < toml_lookup.table_len(?env.data.table)) {
                val opt_value: opt[*toml_value.Value] = toml_lookup.table_value(?env.data.table, e);
                e = e + 1;
                if (sel opt_value.none) { cnt; }
                variables_report(out, manifest_load.MANIFEST_FILE, doc.text, opt_value.some.span.at, opt_value.some.span.at + opt_value.some.span.len);
            }
        }
        val opt_argv: opt[*toml_value.Value] = toml_lookup.get(?opt_step.some.data.table, "argv");
        if (sel opt_argv.none)                          { cnt; }
        if (opt_argv.some.tag != toml_value.TYPE_ARRAY) { cnt; }
        val runs: bool             = migrate.runs_mach(doc.text, ?opt_argv.some.data.array);
        var lead: io_writer.Memory;
        var lw:   io_writer.Writer = io_writer.memory_growing(?lead, a);
        fin { io_writer.memory_dnit(?lead); }
        step_path(?lw, doc.text, ?opt_argv.some.data.array);
        val path: str   = io_writer.memory_text(?lead);
        var k:    usize = 0;
        for (k < toml_lookup.array_len(?opt_argv.some.data.array)) {
            val opt_arg: opt[*toml_value.Value] = toml_lookup.array_get(?opt_argv.some.data.array, k);
            k = k + 1;
            if (sel opt_arg.none) { cnt; }
            val end: usize = opt_arg.some.span.at + opt_arg.some.span.len;
            variables_report(out, manifest_load.MANIFEST_FILE, doc.text, opt_arg.some.span.at, end);
            if (!runs) { cnt; }
            var i: usize = 0;
            for (i < args.REMOVED_N) {
                val removed: *args.Removed = ?args.REMOVED[i];
                i = i + 1;
                if (step_rewrites(removed.name))                                  { cnt; }
                if (!args.removed_in(removed, path))                              { cnt; }
                if (!names_in(doc.text, opt_arg.some.span.at, end, removed.name)) { cnt; }
                std_format.format(out, "{}:{}: option '{}' is not allowed. use {}\n", manifest_load.MANIFEST_FILE, line_of(doc.text, opt_arg.some.span.at), removed.name, removed.use);
            }
        }
    }
}

# each removed key the manifest `doc` writes that no rewrite migrates, located: what replaces it
# is its author's decision, and the manifest is refused until it is made
fun leftover_report(out: *io_writer.Writer, a: *A.Allocator, doc: *manifest_load.Doc) res[usize, fail.Fail] {
    var left: Vector[schema.Leftover] = collections_vector.init[schema.Leftover](a);
    fin { collections_vector.dnit[schema.Leftover](?left); }
    val err_found: err[A.Error] = schema.leftovers(?doc.table, ?left);
    if (sel err_found.err) { ret res[usize, fail.Fail].err{fail.refused(err_found.err)}; }
    var i: usize = 0;
    for (i < left.len) {
        val k:    *schema.Leftover = ?left.data[i];
        val line: usize            = line_of(doc.text, k.at.at);
        i = i + 1;
        if (str_is_empty(k.name)) { std_format.format(out, "{}:{}: [{}].{} is not allowed, and no rewrite replaces it. {}\n", manifest_load.MANIFEST_FILE, line, k.section, k.key, k.note); }
        or                        { std_format.format(out, "{}:{}: [{}.{}].{} is not allowed, and no rewrite replaces it. {}\n", manifest_load.MANIFEST_FILE, line, k.section, k.name, k.key, k.note); }
    }
    ret res[usize, fail.Fail].ok{left.len};
}

# each retired spir-v device feature name the manifest `doc` lists in a target's `ext` that
# names no capability, located, which the rewrite removes
fun dropped_ext_report(out: *io_writer.Writer, a: *A.Allocator, doc: *manifest_load.Doc) err[fail.Fail] {
    var dropped: Vector[manifest_target.DroppedExt] = collections_vector.init[manifest_target.DroppedExt](a);
    fin { collections_vector.dnit[manifest_target.DroppedExt](?dropped); }
    val err_found: err[A.Error] = manifest_target.dropped_extensions(?doc.table, ?dropped);
    if (sel err_found.err) { ret err[fail.Fail].err{fail.refused(err_found.err)}; }
    var i: usize = 0;
    for (i < dropped.len) {
        val d: *manifest_target.DroppedExt = ?dropped.data[i];
        i = i + 1;
        std_format.format(out, "{}:{}: [target.{}].ext entry \"{}\" names no capability, so the rewrite removes it\n", manifest_load.MANIFEST_FILE, line_of(doc.text, d.at.at), d.target, d.name);
    }
    ret err[fail.Fail].ok{};
}

# the string value of `key` in `t`, nil when it holds none
fun string_at(t: *toml_value.Table, key: str) str {
    val v: *toml_value.Value = toml_lookup.table_find(t, key);
    if (v == nil || v.tag != toml_value.TYPE_STRING) { ret nil; }
    ret v.data.string;
}

# whether the array of strings `key` of `t` holds `want`
fun lists(t: *toml_value.Table, key: str, want: str) bool {
    val v: *toml_value.Value = toml_lookup.table_find(t, key);
    if (v == nil || v.tag != toml_value.TYPE_ARRAY || want == nil) { ret false; }
    var i: usize = 0;
    for (i < toml_lookup.array_len(?v.data.array)) {
        val opt_item: opt[*toml_value.Value] = toml_lookup.array_get(?v.data.array, i);
        i = i + 1;
        if (sel opt_item.none)                                                                          { cnt; }
        if (opt_item.some.tag == toml_value.TYPE_STRING && str_equals(opt_item.some.data.string, want)) { ret true; }
    }
    ret false;
}

# whether the filter `key` of `t`, an array with "*" for any, admits `want`
fun admits(t: *toml_value.Table, key: str, want: str) bool {
    ret want != nil && (lists(t, key, "*") || lists(t, key, want));
}

# whether an artifact of `artifacts` builds for the target `target` and links the entry `entry`
fun linked_on(artifacts: *toml_value.Table, target: str, entry: str) bool {
    var k: usize = 0;
    for (k < toml_lookup.table_len(artifacts)) {
        val opt_artifact: opt[*toml_value.Value] = toml_lookup.table_value(artifacts, k);
        k = k + 1;
        if (sel opt_artifact.none)                                                                                           { cnt; }
        if (opt_artifact.some.tag != toml_value.TYPE_TABLE)                                                                  { cnt; }
        if (admits(?opt_artifact.some.data.table, "targets", target) && lists(?opt_artifact.some.data.table, "link", entry)) { ret true; }
    }
    ret false;
}

# the line the key of the entry `name` under `section` of the manifest `doc` stands on, 0 when it has none
fun entry_line(doc: *manifest_load.Doc, section: str, name: str) usize {
    val opt_section: opt[*toml_value.Table] = toml_lookup.get_table(?doc.table, section);
    if (sel opt_section.none) { ret 0; }
    val v: *toml_value.Value = toml_lookup.table_find(opt_section.some, name);
    if (v == nil) { ret 0; }
    ret line_of(doc.text, v.key.at);
}

# each system library 6 found through the host's directories that 7 links only once its
# author writes what 6 found, located in `doc` and read from the manifest as the migration
# leaves it, `moved`: a linux target with no `env` that an artifact links a system library on,
# since 7 searches a system's libraries only through the target's environment, and a darwin
# shared system library named by no install name, since 7 links it from its claim by the name
# the entry writes where 6 read the install name from the file it found
fun library_report(out: *io_writer.Writer, doc: *manifest_load.Doc, moved: *manifest_load.Doc) usize {
    val opt_targets:   opt[*toml_value.Table] = toml_lookup.get_table(?moved.table, "target");
    val opt_artifacts: opt[*toml_value.Table] = toml_lookup.get_table(?moved.table, "artifact");
    val opt_links:     opt[*toml_value.Table] = toml_lookup.get_table(?moved.table, "link");
    if (sel opt_targets.none)   { ret 0; }
    if (sel opt_artifacts.none) { ret 0; }
    if (sel opt_links.none)     { ret 0; }
    var reported: usize = 0;
    var j:        usize = 0;
    for (j < toml_lookup.table_len(opt_links.some)) {
        val opt_entry:  opt[str]               = toml_lookup.table_key(opt_links.some, j);
        val opt_linked: opt[*toml_value.Value] = toml_lookup.table_value(opt_links.some, j);
        j = j + 1;
        if (sel opt_entry.none)                           { cnt; }
        if (sel opt_linked.none)                          { cnt; }
        if (opt_linked.some.tag != toml_value.TYPE_TABLE) { cnt; }
        val l:      *toml_value.Table = ?opt_linked.some.data.table;
        val source: str               = string_at(l, "source");
        val name:   str               = string_at(l, "name");
        if (source == nil || name == nil || !str_equals(source, "system")) { cnt; }
        val kind:       str   = string_at(l, "kind");
        val shared:     bool  = kind == nil || str_equals(kind, "shared");
        var named_once: bool  = false;
        var t:          usize = 0;
        for (t < toml_lookup.table_len(opt_targets.some)) {
            val opt_target: opt[str]               = toml_lookup.table_key(opt_targets.some, t);
            val opt_stated: opt[*toml_value.Value] = toml_lookup.table_value(opt_targets.some, t);
            t = t + 1;
            if (sel opt_target.none)                          { cnt; }
            if (sel opt_stated.none)                          { cnt; }
            if (opt_stated.some.tag != toml_value.TYPE_TABLE) { cnt; }
            val tt:  *toml_value.Table = ?opt_stated.some.data.table;
            val sys: str               = string_at(tt, "sys");
            if (sys == nil)                                                                                                     { cnt; }
            if (!admits(l, "sys", sys) || !admits(l, "arch", string_at(tt, "arch")) || !admits(l, "abi", string_at(tt, "abi"))) { cnt; }
            if (!linked_on(opt_artifacts.some, opt_target.some, opt_entry.some))                                                { cnt; }
            if (str_equals(sys, "linux") && string_at(tt, "env") == nil) {
                std_format.format(out, "{}:{}: [target.{}] states no env, and [link.{}] links a system library on it. 6 found it as the gnu environment does, and 7 finds a system library only through the target's environment. write `env = \"gnu\"`, under which a bin links pie unless its `linkage` says otherwise\n", manifest_load.MANIFEST_FILE, entry_line(doc, "target", opt_target.some), opt_target.some, opt_entry.some);
                reported = reported + 1;
            }
            if (str_equals(sys, "darwin") && shared && !named_once) {
                named_once = true;
                val err_named: err[mink_fail.Fail] = macho_library.install_named(View{data: name::*u8, len: str_len(name)});
                if (sel err_named.err) {
                    std_format.format(out, "{}:{}: [link.{}] names the darwin library '{}' by no install name. 6 found its file and linked it by the install name the file states, and 7 links it from its claim by the name written. write its install name, as `@rpath/lib{}.dylib` or an absolute path\n", manifest_load.MANIFEST_FILE, entry_line(doc, "link", opt_entry.some), opt_entry.some, name, name);
                    reported = reported + 1;
                }
            }
        }
    }
    ret reported;
}

# each default library of the manifest `doc` when it has several, located: 6 made every one the
# export surface, and 7 exports the one its author marks
fun default_report(out: *io_writer.Writer, doc: *manifest_load.Doc) {
    val opt_artifacts: opt[*toml_value.Table] = toml_lookup.get_table(?doc.table, "artifact");
    if (sel opt_artifacts.none)                             { ret; }
    if (migrate.export_candidates(opt_artifacts.some) <= 1) { ret; }
    var i: usize = 0;
    for (i < toml_lookup.table_len(opt_artifacts.some)) {
        val opt_name: opt[str]               = toml_lookup.table_key(opt_artifacts.some, i);
        val opt_row:  opt[*toml_value.Value] = toml_lookup.table_value(opt_artifacts.some, i);
        i = i + 1;
        if (sel opt_name.none)                                  { cnt; }
        if (sel opt_row.none)                                   { cnt; }
        if (opt_row.some.tag != toml_value.TYPE_TABLE)          { cnt; }
        if (!migrate.default_library(?opt_row.some.data.table)) { cnt; }
        std_format.format(out, "{}:{}: [artifact.{}] is one of several default libraries, which 6 made the export surface. 7 exports one library, so mark the one whose need consumers build `export = true`\n", manifest_load.MANIFEST_FILE, entry_line(doc, "artifact", opt_name.some), opt_name.some);
    }
}

# each bin of the manifest `doc` that lists a spir-v target beside another, located, which no
# one kind builds and the manifest check refuses
fun module_report(out: *io_writer.Writer, doc: *manifest_load.Doc) usize {
    val opt_artifacts: opt[*toml_value.Table] = toml_lookup.get_table(?doc.table, "artifact");
    if (sel opt_artifacts.none) { ret 0; }
    var reported: usize = 0;
    var i:        usize = 0;
    for (i < toml_lookup.table_len(opt_artifacts.some)) {
        val opt_name: opt[str]               = toml_lookup.table_key(opt_artifacts.some, i);
        val opt_row:  opt[*toml_value.Value] = toml_lookup.table_value(opt_artifacts.some, i);
        i = i + 1;
        if (sel opt_name.none)                                          { cnt; }
        if (sel opt_row.none)                                           { cnt; }
        if (opt_row.some.tag != toml_value.TYPE_TABLE)                  { cnt; }
        if (!migrate.spirv_mixed(?doc.table, ?opt_row.some.data.table)) { cnt; }
        std_format.format(out, "{}:{}: [artifact.{}] is a bin for a spirv target and another target. a spirv target builds a module, so write a separate kind = \"module\" artifact for the spirv target\n", manifest_load.MANIFEST_FILE, entry_line(doc, "artifact", opt_name.some), opt_name.some);
        reported = reported + 1;
    }
    ret reported;
}

# whether the migration rewrites the option `name` in a step's `argv`
fun step_rewrites(name: str) bool {
    var f: usize = 0;
    for (f < transition.FLAG_COUNT) {
        if (str_equals(transition.flag_at(f).from, name)) { ret true; }
        f = f + 1;
    }
    ret false;
}

# the line of `text` the byte `at` stands on, from 1
fun line_of(text: str, at: usize) usize {
    var line: usize = 1;
    var i:    usize = 0;
    for (i < at) {
        if (text[i] == '\n') { line = line + 1; }
        i = i + 1;
    }
    ret line;
}

# each dependency the root project does not migrate: dep/ does not hold it, it stands on the
# previous major, or it stands on a major older still, which an earlier mach migrates first
fun dependency_report(out: *io_writer.Writer, deps: *Vector[migrate.Dependency]) {
    var i: usize = 0;
    for (i < deps.len) {
        val d: *migrate.Dependency = ?deps.data[i];
        i = i + 1;
        if (d.range == nil)                              { std_format.format(out, "dependency '{}' was not read, as dep/ holds no manifest for it\n", d.id); }
        or (migrate.on_previous_major(d.range))          { std_format.format(out, "dependency '{}' requires mach {}, the previous major. it migrates as its own project\n", d.id, d.range); }
        or (!compile_closure.compiler_admitted(d.range)) { std_format.format(out, "dependency '{}' requires mach {}, which this mach does not accept and which is not the previous major. it migrates with an earlier mach first\n", d.id, d.range); }
    }
}

# the project's directories, read from its manifest as the migration leaves it, so a check
# reads the source a migrated manifest names. the names no rule rewrites, `[project].id` and
# each `[dep]` key, are checked here, where the manifest writes them, before anything is
# written, so a name this major refuses, as one holding '-', stops the run with the manifest
# and the source both as they were
fun migrated_dirs(a: *A.Allocator, sources: *base_source.SourceMap, manifest_path: str) res[Dirs, fail.Fail] {
    val res_doc: res[manifest_load.Doc, fail.Fail] = manifest_load.doc_read(a, sources, manifest_path);
    if (sel res_doc.err) { ret res[Dirs, fail.Fail].err{res_doc.err}; }
    var doc: manifest_load.Doc = res_doc.ok;
    fin { manifest_load.doc_dnit(a, ?doc); }
    val written: *toml_value.Value = schema.written_value(?doc.table, "project");
    if (written != nil && written.tag == toml_value.TYPE_TABLE) {
        val id: *toml_value.Value = schema.written_value(?written.data.table, "id");
        if (id != nil && id.tag == toml_value.TYPE_STRING && !schema.is_project_id(id.data.string)) {
            val refused: fail.Fail = schema.project_id_refused(a, id.data.string);
            ret res[Dirs, fail.Fail].err{fail.at(refused, base_source.location(doc.file, base_source.span(id.span.at, id.span.len)))};
        }
    }
    val err_deps: err[fail.Fail] = schema.section_check(a, ?doc.table, "dep");
    if (sel err_deps.err) { ret res[Dirs, fail.Fail].err{fail.placed(err_deps.err, doc.file)}; }
    val res_text: res[str, fail.Fail] = migrate.manifest(a, doc.text);
    if (sel res_text.err) { ret res[Dirs, fail.Fail].err{res_text.err}; }
    fin { str_free(a, res_text.ok); }
    val res_moved: res[manifest_load.Doc, fail.Fail] = manifest_load.doc_parse(a, sources, manifest_path, res_text.ok);
    if (sel res_moved.err) { ret res[Dirs, fail.Fail].err{res_moved.err}; }
    var moved: manifest_load.Doc = res_moved.ok;
    fin { manifest_load.doc_dnit(a, ?moved); }
    val res_project: res[rewrite.Project, fail.Fail] = rewrite.project_of(a, ?moved);
    if (sel res_project.err) { ret res[Dirs, fail.Fail].err{res_project.err}; }
    var dirs:     Dirs     = Dirs{id: res_project.ok.id, src: res_project.ok.src, work: nil};
    val opt_work: opt[str] = toml_lookup.get_str(?moved.table, "project.work");
    if (sel opt_work.none) { ret res[Dirs, fail.Fail].ok{dirs}; }
    # the directories before the first variable, which no expansion moves
    var cut: usize = 0;
    var i:   usize = 0;
    for (opt_work.some[i] != 0 && opt_work.some[i] != '{') {
        if (opt_work.some[i] == '/') { cut = i; }
        i = i + 1;
    }
    if (opt_work.some[i] == 0) { cut = i; }
    if (cut == 0)              { ret res[Dirs, fail.Fail].ok{dirs}; }
    val res_lead: res[str, StrError] = str_copy_slice(a, opt_work.some, 0, cut);
    if (sel res_lead.err) { ret res[Dirs, fail.Fail].err{fail.str_refused(res_lead.err)}; }
    dirs.work = res_lead.ok;
    ret res[Dirs, fail.Fail].ok{dirs};
}

# length of FLAGS
val FLAGS_N: usize = 5;
# the flags mach migrate takes
val FLAGS: [FLAGS_N]*std_args.Flag = [FLAGS_N]*std_args.Flag{?args.HELP, ?args.REPORT, ?args.VERBOSE, ?args.QUIET, ?rewrite.CHECK};

# `mach migrate`
pub val COMMAND: std_args.Command = std_args.Command{name: "migrate", aliases: args.NO_WORDS, help: "rewrite a project into this major's spelling", usage: "<path>", flags: Slice[*std_args.Flag]{data: ?FLAGS[0], size: FLAGS_N}, commands: args.NO_COMMANDS, operand_min: 0, operand_max: 1, passthrough: false};
# what mach holds `mach migrate` to beyond the parse
pub val POLICY: args.Policy = args.Policy{refused: args.NO_FLAGS, refusal: "", conflicts: args.NO_CONFLICTS};

# `mach migrate <path> [--check]`
# ---
# cx:  the call
# ret: exit.OK when the project is in this major's spelling (or was made so), exit.USER when a
#      file would change under --check, or in either mode when the manifest still writes a
#      removed key no rewrite migrates, links a system library 6 found that it does not yet say
#      how 7 finds, writes a bin for a spir-v target and another, or a source could not be read
#      as one or holds a bare use the rewrite left; a script's or a step's removed option is
#      reported and fails nothing. otherwise the failure, with nothing written when the migrated
#      manifest's `[project]` or `[dep]` is refused
pub fun run(cx: *args.Call) res[i64, fail.Fail] {
    val arg:     *u8                                  = args.operand(cx.inv, 0);
    val res_loc: res[util.ProjectLocation, fail.Fail] = util.resolve_project_location(cx.a, arg);
    if (sel res_loc.err) { ret res[i64, fail.Fail].err{res_loc.err}; }
    val loc:   util.ProjectLocation = res_loc.ok;
    val check: bool                 = std_args.given(cx.inv, ?rewrite.CHECK);
    var sink:  rewrite.Sink         = rewrite.SINK_FILE;
    if (check) { sink = rewrite.SINK_DIFF; }
    val res_dirs: res[Dirs, fail.Fail] = migrated_dirs(cx.a, cx.sources, loc.manifest);
    if (sel res_dirs.err) { ret res[i64, fail.Fail].err{res_dirs.err}; }
    var dirs: Dirs = res_dirs.ok;
    fin {
        str_free(cx.a, dirs.id);
        str_free(cx.a, dirs.src);
        if (dirs.work != nil) { str_free(cx.a, dirs.work); }
    }
    # one pass over the manifest, then the source, each with its own transform
    var pass: rewrite.Report = rewrite.report(cx.a, cx.report, cx.sources, keyed, STAGE);
    pass.heading = migrate.table_heading;
    pass.verb    = layout.MIGRATED;
    pass.subject = dirs.id;
    val err_manifested: err[fail.Fail] = rewrite.file(cx.a, cx.backing, loc.manifest, sink, ?pass);
    if (sel err_manifested.err) { ret closed(?pass, err_manifested.err); }
    var deps: Vector[migrate.Dependency] = collections_vector.init[migrate.Dependency](cx.a);
    fin { collections_vector.dnit[migrate.Dependency](?deps); }
    val res_doc: res[manifest_load.Doc, fail.Fail] = manifest_load.doc_read(cx.a, cx.sources, loc.manifest);
    if (sel res_doc.err) { ret closed(?pass, res_doc.err); }
    var doc: manifest_load.Doc = res_doc.ok;
    fin { manifest_load.doc_dnit(cx.a, ?doc); }
    val err_read: err[fail.Fail] = migrate.dependencies(cx.a, cx.sources, loc.root, doc.text, ?deps);
    if (sel err_read.err) { ret closed(?pass, err_read.err); }
    pass.transform = spelled;
    pass.context   = (?deps)::ptr;
    pass.heading   = nil;
    val err_walked: err[fail.Fail] = rewrite.tree(cx.a, cx.backing, loc.root, dirs.src, sink, ?pass);
    rewrite.close(?pass);
    if (sel err_walked.err) { ret res[i64, fail.Fail].err{err_walked.err}; }
    val res_stated: res[usize, fail.Fail] = leftover_report(cli_diagnostic.out(cx.report), cx.a, ?doc);
    if (sel res_stated.err) { ret res[i64, fail.Fail].err{res_stated.err}; }
    val err_dropped: err[fail.Fail] = dropped_ext_report(cli_diagnostic.out(cx.report), cx.a, ?doc);
    if (sel err_dropped.err) { ret res[i64, fail.Fail].err{err_dropped.err}; }
    val res_text: res[str, fail.Fail] = migrate.manifest(cx.a, doc.text);
    if (sel res_text.err) { ret res[i64, fail.Fail].err{res_text.err}; }
    fin { str_free(cx.a, res_text.ok); }
    val res_moved: res[manifest_load.Doc, fail.Fail] = manifest_load.doc_parse(cx.a, cx.sources, loc.manifest, res_text.ok);
    if (sel res_moved.err) { ret res[i64, fail.Fail].err{res_moved.err}; }
    var moved: manifest_load.Doc = res_moved.ok;
    fin { manifest_load.doc_dnit(cx.a, ?moved); }
    val libraries: usize = library_report(cli_diagnostic.out(cx.report), ?doc, ?moved);
    val modules:   usize = module_report(cli_diagnostic.out(cx.report), ?doc);
    default_report(cli_diagnostic.out(cx.report), ?doc);
    step_report(cli_diagnostic.out(cx.report), cx.a, ?doc);
    val err_searched: err[fail.Fail] = scripts_in(cli_diagnostic.out(cx.report), cx.a, loc.root, "", ?dirs, 0);
    if (sel err_searched.err) { ret res[i64, fail.Fail].err{err_searched.err}; }
    dependency_report(cli_diagnostic.out(cx.report), ?deps);
    # a key no rewrite migrates, a source the rewrite left a bare use in, or a bin for spir-v and
    # another target leaves a project the reader refuses, and a system library 6 found and 7 is
    # not told how to find leaves one the link refuses
    val faulted: bool = res_stated.ok + libraries + modules + pass.flagged != 0;
    rewrite.result(?pass, check, faulted, sink);
    if (faulted || pass.malformed != 0) { ret res[i64, fail.Fail].ok{exit.USER}; }
    if (check && pass.differing != 0)   { ret res[i64, fail.Fail].ok{exit.USER}; }
    ret res[i64, fail.Fail].ok{exit.OK};
}

# what migrate calls its pass in the log line and the live line
val STAGE: str = "migrate";

# the pass closed early by the failure `f`, which the command returns
fun closed(pass: *rewrite.Report, f: fail.Fail) res[i64, fail.Fail] {
    rewrite.close(pass);
    ret res[i64, fail.Fail].err{f};
}
