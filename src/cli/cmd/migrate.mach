use collections_vector: std.collections.vector;
use std.collections.vector.Vector;
use fs:        std.filesystem;
use io_writer: std.io.writer;
use std.print;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;

use mach.cli.args;
use mach.cli.exit;
use mach.cli.rewrite;
use mach.cli.util;
use mach.lang.diagnostic;
use mach.lang.fail;
use mach.lang.fe.transition;
use mach.lang.manifest;
use mach.lang.migrate;

# a manifest's text in this major's spelling
fun keyed(a: *A.Allocator, text: str, diags: *diagnostic.DiagnosticStore, context: ptr) res[str, fail.Fail] {
    ret migrate.manifest(a, text);
}

# a source's text in this major's spelling
fun spelled(a: *A.Allocator, text: str, diags: *diagnostic.DiagnosticStore, context: ptr) res[str, fail.Fail] {
    ret migrate.source(a, text, context::*Vector[migrate.Dependency]);
}

# the files that run a build beside the source, read for removed options. a script is
# reported, never rewritten: what it runs is its author's
val SCRIPT_COUNT: usize             = 6;
val SCRIPTS:      [SCRIPT_COUNT]str = [SCRIPT_COUNT]str{"Makefile", "makefile", "GNUmakefile", "build.sh", ".github/workflows/ci.yml", ".github/workflows/cd.yml"};

# whether `word` stands in the line of `text` from `start` to `end`, at a word's edges
fun line_names(text: str, start: usize, end: usize, word: str) bool {
    ret migrate.word_in(text, start, end, word) != end;
}

# each removed option a line of the script `name` runs `mach` with, located
fun script_report(a: *A.Allocator, root: str, name: str) res[usize, fail.Fail] {
    val path: res[str, fail.Fail] = fail.join(a, root, "/", name);
    if (sel path.err) { ret res[usize, fail.Fail].err{path.err}; }
    val read: opt[str] = rewrite.text_of(a, path.ok);
    if (sel read.none) { ret res[usize, fail.Fail].ok{0}; }
    val text: str   = read.some;
    var at:   usize = 0;
    var line: usize = 1;
    var hits: usize = 0;
    for (text[at] != 0) {
        var end: usize = at;
        for (text[end] != 0 && text[end] != '\n') { end = end + 1; }
        if (line_names(text, at, end, "mach")) {
            var i: usize = 0;
            for (i < args.removed_count()) {
                if (line_names(text, at, end, args.removed_name(i))) {
                    print.printlnf("{}:{}: option '{}' was removed; {}", name, line, args.removed_name(i), args.removed_replacement(i));
                    hits = hits + 1;
                }
                i = i + 1;
            }
            var f: usize = 0;
            for (f < transition.FLAG_COUNT) {
                val row: *transition.Flag = transition.flag_at(f);
                f = f + 1;
                if (line_names(text, at, end, row.from)) {
                    print.printlnf("{}:{}: option '{}' is '{}' since v7", name, line, row.from, row.to);
                    hits = hits + 1;
                }
            }
        }
        at = end;
        if (text[at] == '\n') { at = at + 1; }
        line = line + 1;
    }
    ret res[usize, fail.Fail].ok{hits};
}

# each dependency the root project does not migrate: dep/ does not hold it, or it stands
# on the previous major
fun dependency_report(deps: *Vector[migrate.Dependency]) {
    var i: usize = 0;
    for (i < deps.len) {
        val d: *migrate.Dependency = ?deps.data[i];
        i = i + 1;
        if (d.range == nil)                     { print.printlnf("dependency '{}': dep/ holds no manifest for it, so it was not read", d.id); }
        or (migrate.on_previous_major(d.range)) { print.printlnf("dependency '{}' is on mach {}, the previous major; it migrates as its own project", d.id, d.range); }
    }
}

# the project's source directory, read from its manifest as the migration
# leaves it, so a check reads the source a migrated manifest names
fun migrated_source(a: *A.Allocator, manifest_path: str) res[str, fail.Fail] {
    val doc_r: res[manifest.Doc, fail.Fail] = manifest.doc_read(a, manifest_path);
    if (sel doc_r.err) { ret res[str, fail.Fail].err{doc_r.err}; }
    var doc: manifest.Doc = doc_r.ok;
    fin { manifest.doc_dnit(a, ?doc); }
    val text: res[str, fail.Fail] = migrate.manifest(a, doc.text);
    if (sel text.err) { ret res[str, fail.Fail].err{text.err}; }
    fin { str_free(a, text.ok); }
    val moved_r: res[manifest.Doc, fail.Fail] = manifest.doc_parse(a, manifest_path, text.ok);
    if (sel moved_r.err) { ret res[str, fail.Fail].err{moved_r.err}; }
    var moved: manifest.Doc = moved_r.ok;
    fin { manifest.doc_dnit(a, ?moved); }
    ret rewrite.source_dir_of(a, ?moved);
}

# row count of OWN
val OWN_N: usize = 1;
# the options mach migrate accepts
val OWN: [OWN_N]*args.FlagSpec = [OWN_N]*args.FlagSpec{?rewrite.CHECK};

# length of TABLES
val TABLES_N: usize = 1;
# the option tables mach migrate accepts
val TABLES: [TABLES_N]args.TableRef = [TABLES_N]args.TableRef{
    args.TableRef{rows: ?OWN[0], n: OWN_N, accepted: nil, docs: nil},
};

# length of EXITS
val EXITS_N: usize = 1;
# the exit codes migrate documents beside exit.SHARED
val EXITS: [EXITS_N]exit.Note = [EXITS_N]exit.Note{
    exit.Note{code: exit.USER, meaning: "in check mode a file the migration would change"},
};

# `mach migrate`
pub val COMMAND: args.CommandSpec = args.CommandSpec{name: "migrate", aliases: nil, alias_n: 0, grammar: " <path> [--check]", summary: "rewrite a project written for the previous major into this one's spelling", effect: "rewrite the project's mach.toml, then every source file under its [project].src, into this major's spelling: each manifest key, template variable, comptime path and decorator the previous major named and this one renamed or retired with a mechanical rewrite. each `asm` head, truth alias and bare use of a project too. comments and strings in source are left as written. with --check nothing is written and every change is printed as a diff. a script that runs mach with a removed option is reported, never rewritten. dependencies are never visited; each migrates as its own project, and one still on the previous major is reported", exits: ?EXITS[0], exit_n: EXITS_N, terminator: "", tables: ?TABLES[0], table_n: TABLES_N, refused: nil, refused_n: 0, refusal: "", relations: nil, relation_n: 0, constraints: nil, constraint_n: 0, operand_min: 0, operand_max: 1, truncate_at_sep: false, actions: nil, action_n: 0, examples: nil, example_n: 0, run: run};

# `mach migrate [<path>] [--check]`
# ---
# cx:  the call
# ret: exit.OK when the project is in this major's spelling (or was made so), exit.USER when a
#      file would change under --check, otherwise the failure
pub fun run(cx: *args.Call) res[i64, fail.Fail] {
    var arg: *u8 = nil;
    if (cx.inv.has_positional) { arg = cx.argv[cx.inv.positional_idx]; }
    val loc_r: res[util.ProjectLocation, fail.Fail] = util.resolve_project_location(cx.a, arg);
    if (sel loc_r.err) { ret res[i64, fail.Fail].err{loc_r.err}; }
    val loc:         util.ProjectLocation = loc_r.ok;
    val check:       bool                 = args.given(cx.inv, ?rewrite.CHECK);
    var sink:        rewrite.Sink         = rewrite.SINK_FILE;
    var diagnostics: io_writer.Writer     = fs.writer(fs.STDERR);
    if (check) { sink = rewrite.SINK_DIFF; }
    var keys:       rewrite.Report = rewrite.report(?diagnostics, keyed);
    val manifested: err[fail.Fail] = rewrite.file(cx.a, cx.backing, loc.manifest, sink, ?keys);
    if (sel manifested.err) { ret res[i64, fail.Fail].err{manifested.err}; }
    val rel_r: res[str, fail.Fail] = migrated_source(cx.a, loc.manifest);
    if (sel rel_r.err) { ret res[i64, fail.Fail].err{rel_r.err}; }
    val rel: str = rel_r.ok;
    fin { str_free(cx.a, rel); }
    var deps: Vector[migrate.Dependency] = collections_vector.init[migrate.Dependency](cx.a);
    fin { collections_vector.dnit[migrate.Dependency](?deps); }
    val doc_r: res[manifest.Doc, fail.Fail] = manifest.doc_read(cx.a, loc.manifest);
    if (sel doc_r.err) { ret res[i64, fail.Fail].err{doc_r.err}; }
    var doc: manifest.Doc = doc_r.ok;
    fin { manifest.doc_dnit(cx.a, ?doc); }
    val read: err[fail.Fail] = migrate.dependencies(cx.a, loc.root, doc.text, ?deps);
    if (sel read.err) { ret res[i64, fail.Fail].err{read.err}; }
    var sources: rewrite.Report = rewrite.report(?diagnostics, spelled);
    sources.context = (?deps)::ptr;
    val walked: err[fail.Fail] = rewrite.tree(cx.a, cx.backing, loc.root, rel, sink, ?sources);
    if (sel walked.err) { ret res[i64, fail.Fail].err{walked.err}; }
    var s: usize = 0;
    for (s < SCRIPT_COUNT) {
        val reported: res[usize, fail.Fail] = script_report(cx.a, loc.root, SCRIPTS[s]);
        if (sel reported.err) { ret res[i64, fail.Fail].err{reported.err}; }
        s = s + 1;
    }
    dependency_report(?deps);
    if (check && keys.differing + sources.differing != 0) { ret res[i64, fail.Fail].ok{exit.USER}; }
    ret res[i64, fail.Fail].ok{exit.OK};
}
