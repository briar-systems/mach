# `mach clean`, which removes every path a build of every cell of the project writes
#
# the paths come from planning the project as `mach build --all` plans it. they are
# removed inside the project root, and a path that escapes it or crosses a symlink is
# refused.

use mach.base.fail;
use std_args: std.args;
use std.collections.slice.Slice;
use std.collections.sort;
use collections_vector: std.collections.vector;
use std.collections.vector.Vector;
use std_format: std.format;
use io_error:   std.io.error;
use io_writer:  std.io.writer;
use system_os:  std.system.os;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use types_string: std.types.string;
use std.types.string.str;
use std.types.string.str_compare;
use std.types.string.str_copy;
use std.types.string.str_copy_slice;
use std.types.string.str_equals;
use std.types.string.str_is_empty;
use std.types.string.str_len;
use std.types.string.str_starts_with;

use A: std.allocator;

use mach.base.diagnostic;
use diagnostic_kind: mach.base.diagnostic.kind;
use mach.base.intern;
use base_source: mach.base.source;
use build_plan:  mach.build.plan;
use mach.cli.args;
use mach.cli.cmd.build;
use cli_diagnostic: mach.cli.diagnostic;
use mach.cli.exit;
use mach.cli.util;
use mach.compile;
use compile_closure: mach.compile.closure;
use mach.compile.request;
use mach.host.output.layout;
use mach.host.output.remove;
use manifest_model:  mach.manifest.model;
use manifest_schema: mach.manifest.schema;
use manifest_select: mach.manifest.select;
use report_layout:   mach.report.layout;
use mach.report.readout;
use mach.session;

# what a clean entry names
def EntryKind: u8;

# a directory tree
val ENTRY_DIR: EntryKind = 0;
# a single file
val ENTRY_FILE: EntryKind = 1;

# one path `mach clean` removes
# ---
# rel:  the path relative to the project root, as the manifest templates expand it
# kind: ENTRY_DIR or ENTRY_FILE
# gone: whether the run removed it
rec CleanEntry {
    rel:  str;
    kind: EntryKind;
    gone: bool;
}

# length of FLAGS
val FLAGS_N: usize = 4;
# the flags mach clean takes
val FLAGS: [FLAGS_N]*std_args.Flag = [FLAGS_N]*std_args.Flag{?args.HELP, ?args.REPORT, ?args.VERBOSE, ?args.QUIET};

# `mach clean`
pub val COMMAND: std_args.Command = std_args.Command{name: "clean", aliases: args.NO_WORDS, help: "remove project build output", usage: "<path>", flags: Slice[*std_args.Flag]{data: ?FLAGS[0], size: FLAGS_N}, commands: args.NO_COMMANDS, operand_min: 0, operand_max: std_args.OPERANDS_ANY, passthrough: false};

# what the log line and the live line call removing
val STAGE: str = "remove";
# what mach holds `mach clean` to beyond the parse
pub val POLICY: args.Policy = args.Policy{refused: args.NO_FLAGS, refusal: "", conflicts: args.NO_CONFLICTS};

# `mach clean`: remove every path a build of every cell writes, as the build
# plans it: each artifact's output and the object, IR, assembly, test, cache,
# staging and dependency trees beneath each cell's work directory, dependency
# requirement cells included; a dependency never realized was never built, so
# it adds no cell. they are sorted, collapsed under their ancestors,
# and removed inside the project root; a path that escapes the root or crosses a symlink is refused. a missing path is
# not an error. each path removed has its result line once all are tried, and a run that removed
# nothing says the project is unchanged
# ---
# cx:  the call
# ret: exit.OK, or the shared code of the failure: exit.USER for a manifest error or an escaping
#      target, exit.INTERNAL for an allocator failure, exit.ENVIRONMENT for a read or removal
#      failure; a removal that fails is reported and the rest are still attempted
pub fun run(cx: *args.Call) res[i64, fail.Fail] {
    val arg:     *u8                                  = args.operand(cx.inv, 0);
    val res_loc: res[util.ProjectLocation, fail.Fail] = util.resolve_project_location(cx.a, arg);
    if (sel res_loc.err) { ret res[i64, fail.Fail].err{res_loc.err}; }
    ret res[i64, fail.Fail].ok{clean_project(cx.report, cx.a, res_loc.ok.root)};
}

fun clean_project(r: *cli_diagnostic.Report, a: *A.Allocator, root: *u8) i64 {
    var id: str = nil;
    fin {
        if (id != nil) { str_free(a, id); }
    }
    val res_plan: res[Vector[CleanEntry], fail.Fail] = build_clean_plan(a, root::str, r.sources, ?id);
    if (sel res_plan.err) { ret cli_diagnostic.report_fail(r, res_plan.err, diagnostic.ORIGIN_NONE); }
    var plan: Vector[CleanEntry] = res_plan.ok;
    fin { collections_vector.dnit[CleanEntry](?plan); }
    cli_diagnostic.live_begin(r, STAGE);
    val began:   readout.Instant = readout.sample();
    var removed: usize           = 0;
    var failed:  usize           = 0;
    val code:    i64             = execute_plan(r, a, root::str, plan.data, plan.len, ?removed, ?failed);
    cli_diagnostic.live_end(r);
    var t: report_layout.Text;
    cli_diagnostic.log_stage(r, STAGE, readout.elapsed(began), paths_text(?t, removed));
    if (!cli_diagnostic.results_shown(r)) { ret code; }
    val w: *io_writer.Writer = cli_diagnostic.out(r);
    var i: usize             = 0;
    for (i < plan.len) {
        if (plan.data[i].gone) { cli_diagnostic.said_row(w, report_layout.REMOVED, ?plan.data[i].rel, 1); }
        i = i + 1;
    }
    if (code != exit.OK) {
        report_layout.said(w, report_layout.FAILED);
        std_format.write_str(w, id);
        if (failed != 0) { std_format.format(w, "  {} of {} not removed", failed::u64, paths_text(?t, removed + failed)); }
        std_format.write_newline(w);
    }
    or (removed == 0) {
        report_layout.said(w, report_layout.UNCHANGED);
        std_format.format(w, "{}  no build output\n", id);
    }
    ret code;
}

# `n path` or `n paths`, `none` for zero, in `t`
fun paths_text(t: *report_layout.Text, n: usize) str {
    var w: io_writer.Writer = report_layout.text_writer(t);
    if (n == 0) { std_format.write_str(?w, "none"); }
    or (n == 1) { std_format.write_str(?w, "1 path"); }
    or          { std_format.format(?w, "{} paths", n::u64); }
    ret report_layout.text_end(t);
}

# every path a build of the project writes, relative to `root`: each cell is
# planned as `mach build --all` plans it, one plan per profile, and each
# planned unit names its artifact and the trees the build owns beneath its
# work directory. the planning session is torn down before this returns
# ---
# a:   owns the entries and a refusal
# ret: the entries, sorted and collapsed under their ancestors; err from
#      loading the manifest or planning
fun build_clean_plan(a: *A.Allocator, root: str, sources: *base_source.SourceMap, id: *str) res[Vector[CleanEntry], fail.Fail] {
    val res_made: res[session.Session, fail.Fail] = session.init_in(a, sources);
    if (sel res_made.err) { ret res[Vector[CleanEntry], fail.Fail].err{res_made.err}; }
    var ps:          session.Session                    = res_made.ok;
    val res_written: res[Vector[CleanEntry], fail.Fail] = planned_entries(a, ?ps, root, id);
    if (sel res_written.ok) {
        session.dnit(?ps);
        ret res_written;
    }
    var kept:     fail.Fail               = fail.message("failed to retain the clean planning error");
    val res_held: res[fail.Fail, A.Error] = fail.retain(a, res_written.err);
    if (sel res_held.ok) { kept = res_held.ok; }
    session.dnit(?ps);
    ret res[Vector[CleanEntry], fail.Fail].err{kept};
}

fun planned_entries(a: *A.Allocator, ps: *session.Session, root: str, id: *str) res[Vector[CleanEntry], fail.Fail] {
    val res_loaded: res[manifest_model.Manifest, fail.Fail] = compile.load_manifest(ps, root);
    if (sel res_loaded.err) { ret res[Vector[CleanEntry], fail.Fail].err{res_loaded.err}; }
    var m:      manifest_model.Manifest         = res_loaded.ok;
    val res_id: res[str, types_string.StrError] = str_copy(a, intern.text(ps.interner, m.id));
    if (sel res_id.err) { ret res[Vector[CleanEntry], fail.Fail].err{fail.message(fail.str_text(res_id.err))}; }
    @id = res_id.ok;
    var cli: args.CliArgs;
    cli.verbosity     = 0;
    cli.quiet         = true;
    cli.overrides     = request.overrides_init(ps.alloc);
    cli.selectors     = manifest_select.selectors_init(ps.alloc);
    cli.selectors.all = true;
    # a dependency never realized was never built, so it adds no cell
    val res_planned: res[build.Planned, fail.Fail] = build.plan_selection(ps.alloc, ps, ?m, root, ?cli,
        request.GOAL_ARTIFACT, manifest_select.ARTIFACT_DEFAULT_SET, false, compile_closure.UNREALIZED_UNBUILT);
    if (sel res_planned.err) { ret res[Vector[CleanEntry], fail.Fail].err{res_planned.err}; }
    val planned: build.Planned = res_planned.ok;

    var raw: Vector[CleanEntry] = collections_vector.init[CleanEntry](a);
    fin { collections_vector.dnit[CleanEntry](?raw); }
    var pi: usize = 0;
    for (pi < planned.plans.len) {
        val bp: *build_plan.BuildPlan = ?planned.plans.data[pi];
        var ui: usize                 = 0;
        for (ui < bp.units.len) {
            val unit:      *build_plan.BuildUnit = ?bp.units.data[ui];
            val err_wrote: err[fail.Fail]        = push_unit(a, ps.alloc, root, ?raw, unit);
            if (sel err_wrote.err) { ret res[Vector[CleanEntry], fail.Fail].err{err_wrote.err}; }
            ui = ui + 1;
        }
        pi = pi + 1;
    }
    ret normalize_and_collapse(a, ?raw);
}

# a unit's artifact and every tree the build owns beneath its work directory
fun push_unit(a: *A.Allocator, scratch: *A.Allocator, root: str, raw: *Vector[CleanEntry], u: *build_plan.BuildUnit) err[fail.Fail] {
    val err_artifact: err[fail.Fail] = push_written(a, root, raw, u.out_path, ENTRY_FILE);
    if (sel err_artifact.err) { ret err_artifact; }
    var t: u32 = 0;
    for (t < layout.TREE_COUNT) {
        val res_tree: res[str, fail.Fail] = layout.under(scratch, u.out_dir, layout.TREES[t]);
        if (sel res_tree.err) { ret err[fail.Fail].err{res_tree.err}; }
        val err_pushed: err[fail.Fail] = push_written(a, root, raw, res_tree.ok, ENTRY_DIR);
        if (sel err_pushed.err) { ret err_pushed; }
        t = t + 1;
    }
    ret err[fail.Fail].ok{};
}

# `path`, which the build placed beneath `root`, as the root-relative entry clean removes
fun push_written(a: *A.Allocator, root: str, v: *Vector[CleanEntry], path: str, kind: EntryKind) err[fail.Fail] {
    if (str_is_empty(path)) { ret err[fail.Fail].ok{}; }
    var start: usize = str_len(root);
    if (start > 0 && root[start - 1] != '/'::u8) { start = start + 1; }
    val n: usize = str_len(path);
    if (n <= start || !str_starts_with(path, root) || path[start - 1] != '/'::u8) {
        ret err[fail.Fail].err{fail.formatted_user(a, diagnostic_kind.CLEAN_PATH_INVALID, "clean target '{}' is not beneath the project root", path)};
    }
    val res_rel: res[str, types_string.StrError] = str_copy_slice(a, path, start, n - start);
    if (sel res_rel.err) { ret err[fail.Fail].err{fail.message(fail.str_text(res_rel.err))}; }
    ret push_entry(v, res_rel.ok, kind);
}

fun push_entry(v: *Vector[CleanEntry], rel: str, kind: EntryKind) err[fail.Fail] {
    if (str_is_empty(rel)) { ret err[fail.Fail].ok{}; }
    var e: CleanEntry;
    e.rel  = rel;
    e.kind = kind;
    e.gone = false;
    val res_collections_vector_pushed: res[usize, A.Error] = collections_vector.push[CleanEntry](v, e);
    if (sel res_collections_vector_pushed.err) { ret err[fail.Fail].err{fail.refused(res_collections_vector_pushed.err)}; }
    ret err[fail.Fail].ok{};
}

fun cmp_entry(x: *CleanEntry, y: *CleanEntry) i64 {
    ret str_compare(x.rel, y.rel);
}

fun is_ancestor(anc: str, cand: str) bool {
    val al: usize = str_len(anc);
    val cl: usize = str_len(cand);
    if (al >= cl)                    { ret false; }
    if (!str_starts_with(cand, anc)) { ret false; }
    ret cand[al] == '/'::u8;
}

# the entries sorted by path with duplicates and every entry beneath a directory entry dropped,
# in a new vector owned by `a`
fun normalize_and_collapse(a: *A.Allocator, raw: *Vector[CleanEntry]) res[Vector[CleanEntry], fail.Fail] {
    var out: Vector[CleanEntry] = collections_vector.init[CleanEntry](a);
    if (raw.len == 0) { ret res[Vector[CleanEntry], fail.Fail].ok{out}; }

    sort.sort_by[CleanEntry](raw.data, raw.len, cmp_entry);

    var i: usize = 0;
    for (i < raw.len) {
        val cur: CleanEntry = raw.data[i];
        if (out.len > 0) {
            val last: CleanEntry = out.data[out.len - 1];
            if (str_equals(cur.rel, last.rel)) {
                i = i + 1;
                cnt;
            }
            if (last.kind == ENTRY_DIR && is_ancestor(last.rel, cur.rel)) {
                i = i + 1;
                cnt;
            }
        }
        val res_out_pushed: res[usize, A.Error] = collections_vector.push[CleanEntry](?out, cur);
        if (sel res_out_pushed.err) {
            collections_vector.dnit[CleanEntry](?out);
            ret res[Vector[CleanEntry], fail.Fail].err{fail.refused(res_out_pushed.err)};
        }
        i = i + 1;
    }
    ret res[Vector[CleanEntry], fail.Fail].ok{out};
}

# every target is validated as a canonical path beneath the project root
# before anything is removed, so a refused entry leaves the plan untouched
fun check_plan(entries: *CleanEntry, count: usize) err[fail.Fail] {
    var i: usize = 0;
    for (i < count) {
        if (!manifest_schema.is_project_path(entries[i].rel)) { ret err[fail.Fail].err{fail.user(diagnostic_kind.CLEAN_PATH_INVALID, "clean target is not a canonical path beneath the project root")}; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# check every entry, then remove each beneath the project root, counting what was removed
# ---
# r:       the report each failure goes to
# a:       owns the failures' text
# root:    the project root
# entries: the sorted, collapsed entries
# count:   how many entries
# removed: counts each path removed
# failed:  counts each path a removal refused
# ret:     exit.OK, or the worst code of the failures reported
fun execute_plan(r: *cli_diagnostic.Report, a: *A.Allocator, root: str, entries: *CleanEntry, count: usize, removed: *usize, failed: *usize) i64 {
    val err_checked: err[fail.Fail] = check_plan(entries, count);
    if (sel err_checked.err) {
        val res_text: res[str, fail.Fail] = diagnostic.format(a, "cannot reserve the paths to clean ({})", fail.describe(err_checked.err));
        if (sel res_text.err) { ret cli_diagnostic.report_fail(r, res_text.err, diagnostic.ORIGIN_NONE); }
        ret cli_diagnostic.report_fail(r, fail.owning(fail.with_text(err_checked.err, res_text.ok)), diagnostic.ORIGIN_NONE);
    }
    var root_fd: usize = system_os.INVALID_HANDLE;
    val opened:  i64   = remove.open_path(root, ?root_fd);
    if (opened < 0) { ret cli_diagnostic.report_fail(r, fail.refusal(a, diagnostic_kind.FS_OPEN, fail.Op{verb: "open", role: "the project root", path: root}, fail.Cause.native{opened}), diagnostic.ORIGIN_NONE); }
    # a directory opened read-only loses nothing to a refused close
    fin { system_os.close(root_fd); }
    var code: i64   = exit.OK;
    var i:    usize = 0;
    for (i < count) {
        cli_diagnostic.live_reached(r, i::u32, count::u32, entries[i].rel);
        code = execute_entry(r, a, root_fd, ?entries[i], removed, failed, code);
        i    = i + 1;
    }
    ret code;
}

# remove one entry under the open root, a missing one skipped and a failure reported and counted
# ---
# ret: `code`, or the worse of it and the code of the failure this entry reported
fun execute_entry(r: *cli_diagnostic.Report, a: *A.Allocator, root_fd: usize, e: *CleanEntry, removed: *usize, failed: *usize, code: i64) i64 {
    val rr: remove.Removal = remove.relative(root_fd, e.rel);
    if (rr.failed) {
        if (rr.kind == io_error.NOT_FOUND && !rr.containment) { ret code; }
        @failed = @failed + 1;
        if (rr.containment) {
            val res_text: res[str, fail.Fail] = diagnostic.format(a, "cannot remove '{}' ({})", e.rel, remove.message(rr));
            ret exit.worst(code, cli_diagnostic.report_fail(r, remove.with_cleanup(a, fail.user_of(diagnostic_kind.FS_REMOVE, res_text), rr, e.rel), diagnostic.ORIGIN_NONE));
        }
        ret exit.worst(code, cli_diagnostic.report_fail(r, remove.refusal(a, diagnostic_kind.FS_REMOVE, fail.Op{verb: "remove", role: "the clean target", path: e.rel}, rr), diagnostic.ORIGIN_NONE));
    }
    if (rr.removed == 0) { ret code; }
    e.gone   = true;
    @removed = @removed + 1;
    ret code;
}
