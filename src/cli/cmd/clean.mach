use mach.lang.alloc;
use mach.lang.build.outcome;
use std.allocator.arena;
use std.allocator.page;
use std.collections.sort;
use std.collections.vector;
use std.collections.vector.Vector;
use fs:       std.filesystem;
use io_error: std.io.error;
use std.print;
use std.system.os;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.path;
use std.types.result.res;
use std.types.size.usize;
use std.types.string;
use std.types.string.str;
use std.types.string.str_compare;
use std.types.string.str_copy_slice;
use std.types.string.str_empty;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.string.str_starts_with;

use A: std.allocator;
use std.data.toml;
use std.format;

use mach.cli.args;
use mach.cli.util;
use mach.lang.driver.registry.setup_registry;
use mach.lang.intern;
use mach.lang.manifest;
use mach.lang.output.remove;
use fixture: mach.lang.output.testing;
use mach.lang.target;

# what a clean entry names
pub def EntryKind: u8;

# a directory tree
pub val ENTRY_DIR: EntryKind = 0;
# a single file
pub val ENTRY_FILE: EntryKind = 1;

# one path `mach clean` removes
# ---
# rel:  the path relative to the project root, as the manifest templates expand it
# kind: ENTRY_DIR or ENTRY_FILE
pub rec CleanEntry {
    rel:  str;
    kind: EntryKind;
}

# `mach clean`: remove every output path the manifest can produce for every declared target
# and profile. the obj, ir, asm, and test roots and the binary path of each artifact cell
# are collected, sorted, collapsed under their ancestors, and removed inside the project
# root; a path that escapes the root or crosses a symlink is refused. a missing path is
# not an error; "nothing to clean" prints when nothing was removed
# ---
# argv: the full process arguments
# inv:  the parsed invocation for this command
# ret:  0 success, 1 manifest error, 2 allocator, read, or removal failure
pub fun run(argv: **u8, inv: *args.ParsedInvocation) i64 {
    if (args.reject_unknown_from_invocation(inv, argv, "mach clean")) { ret 1; }
    val parsed: args.CleanInvocation = args.build_clean_invocation(inv);

    var backing: A.Allocator;
    val make_r:  err[A.Error] = page.make(?backing);
    if (sel make_r.err) {
        print.eprintln("error: failed to initialise allocator");
        ret 2;
    }
    var ar:     arena.Arena;
    val init_r: err[A.Error] = arena.init(?ar, ?backing, 0);
    if (sel init_r.err) {
        print.eprintln("error: failed to initialise allocator");
        ret 2;
    }
    var a:       A.Allocator;
    val make_r2: err[A.Error] = arena.make(?a, ?ar);
    if (sel make_r2.err) {
        arena.dnit(?ar);
        print.eprintln("error: failed to initialise allocator");
        ret 2;
    }

    var arg: *u8 = nil;
    if (parsed.has_project) { arg = argv[parsed.project_idx]; }

    val loc_r: res[util.ProjectLocation, outcome.Fail] = util.resolve_project_location(?a, arg);
    if (sel loc_r.err) {
        print.eprint("error: ");
        print.eprint(outcome.describe(loc_r.err));
        print.eprint("\n");
        arena.dnit(?ar);
        ret 1;
    }
    val loc: util.ProjectLocation = loc_r.ok;

    val code: i64 = clean_project(?a, loc.root);
    arena.dnit(?ar);
    ret code;
}

fun clean_project(a: *A.Allocator, root: *u8) i64 {
    val mp_r: res[str, A.Error] = path.join(a, root, util.PROJECT_CONFIG_NAME);
    if (sel mp_r.err) {
        print.eprint("error: ");
        print.eprintln(alloc.text(mp_r.err));
        ret 2;
    }
    val manifest_path: str = mp_r.ok;

    val bytes_r: res[Vector[u8], fs.FsError] = fs.read_bytes(a, manifest_path);
    if (sel bytes_r.err) {
        print.eprint("error: cannot read '");
        print.eprint(manifest_path);
        print.eprintln("'");
        ret 2;
    }

    var bytes:    Vector[u8]        = bytes_r.ok;
    val source_r: err[outcome.Fail] = manifest.validate_source_bytes(bytes.data, bytes.len);
    if (sel source_r.err) {
        print.eprint("error: ");
        print.eprintln(outcome.describe(source_r.err));
        vector.dnit[u8](?bytes);
        ret 1;
    }
    val reserve_r: res[usize, A.Error] = vector.reserve[u8](?bytes, 1);
    if (sel reserve_r.err) {
        vector.dnit[u8](?bytes);
        ret 2;
    }
    bytes.data[bytes.len] = 0;
    val tbl_r: res[toml.Table, toml.TomlError] = toml.parse(a, bytes.data::str);
    vector.dnit[u8](?bytes);
    if (sel tbl_r.err) {
        print.eprint("error: mach.toml: ");
        print.eprintln(outcome.toml_text(tbl_r.err));
        ret 1;
    }
    var tbl: toml.Table = tbl_r.ok;

    var itn:   intern.Interner                      = intern.init(a);
    val man_r: res[manifest.Manifest, outcome.Fail] = manifest.parse(a, ?itn, ?tbl, true);
    if (sel man_r.err) {
        print.eprint("error: mach.toml: ");
        print.eprintln(outcome.describe(man_r.err));
        ret 1;
    }
    var m: manifest.Manifest = man_r.ok;

    val plan_r: res[Vector[CleanEntry], outcome.Fail] = build_clean_plan(a, ?itn, ?m, root::str);
    if (sel plan_r.err) {
        print.eprint("error: ");
        print.eprintln(outcome.describe(plan_r.err));
        manifest.dnit(?m, a);
        ret 1;
    }
    var plan: Vector[CleanEntry] = plan_r.ok;

    var removed: usize = 0;
    val code:    i64   = execute_plan(a, root::str, plan.data, plan.len, ?removed);
    vector.dnit[CleanEntry](?plan);

    if (removed == 0 && code == 0) { print.println("nothing to clean"); }

    manifest.dnit(?m, a);
    ret code;
}

fun target_selectors(a: *A.Allocator, itn: *intern.Interner, m: *manifest.Manifest) res[Vector[str], outcome.Fail] {
    var v: Vector[str] = vector.init[str](a);
    if (m.target_count == 0) {
        val pr: res[usize, A.Error] = vector.push[str](?v, "");
        if (sel pr.err) { ret res[Vector[str], outcome.Fail].err{outcome.refused(pr.err)}; }
        ret res[Vector[str], outcome.Fail].ok{v};
    }
    var i: u32 = 0;
    for (i < m.target_count) {
        val found: opt[str] = intern.lookup(itn, m.targets[i].name);
        if (sel found.some) {
            val pr: res[usize, A.Error] = vector.push[str](?v, found.some);
            if (sel pr.err) { ret res[Vector[str], outcome.Fail].err{outcome.refused(pr.err)}; }
        }
        i = i + 1;
    }
    ret res[Vector[str], outcome.Fail].ok{v};
}

fun profile_selectors(a: *A.Allocator, itn: *intern.Interner, m: *manifest.Manifest) res[Vector[str], outcome.Fail] {
    var v: Vector[str] = vector.init[str](a);
    var i: u32         = 0;
    for (i < m.profile_count) {
        val found: opt[str] = intern.lookup(itn, m.profiles[i].name);
        if (sel found.some) {
            val pr: res[usize, A.Error] = vector.push[str](?v, found.some);
            if (sel pr.err) { ret res[Vector[str], outcome.Fail].err{outcome.refused(pr.err)}; }
        }
        i = i + 1;
    }
    ret res[Vector[str], outcome.Fail].ok{v};
}

fun push_entry(v: *Vector[CleanEntry], rel: str, kind: EntryKind) err[outcome.Fail] {
    if (str_empty(rel)) { ret err[outcome.Fail].ok{}; }
    var e: CleanEntry;
    e.rel  = rel;
    e.kind = kind;
    val pr: res[usize, A.Error] = vector.push[CleanEntry](v, e);
    if (sel pr.err) { ret err[outcome.Fail].err{outcome.refused(pr.err)}; }
    ret err[outcome.Fail].ok{};
}

fun push_id_entry(itn: *intern.Interner, v: *Vector[CleanEntry], id: intern.StrId, kind: EntryKind) err[outcome.Fail] {
    val found: opt[str] = intern.lookup(itn, id);
    if (sel found.none) { ret err[outcome.Fail].ok{}; }
    ret push_entry(v, found.some, kind);
}

fun push_test_root_entry(a: *A.Allocator, itn: *intern.Interner, v: *Vector[CleanEntry], id: intern.StrId) err[outcome.Fail] {
    val found: opt[str] = intern.lookup(itn, id);
    if (sel found.none) { ret err[outcome.Fail].ok{}; }
    val tmpl: str = found.some;

    val n:        usize = str_len(tmpl);
    var last_sep: i64   = -1;
    var i:        usize = 0;
    for (i < n) {
        if (tmpl[i] == '/'::u8) { last_sep = i::i64; }
        i = i + 1;
    }
    if (last_sep < 0) { ret err[outcome.Fail].ok{}; }

    val parent_r: res[str, string.StrError] = str_copy_slice(a, tmpl, 0, last_sep::usize);
    if (sel parent_r.err) { ret err[outcome.Fail].err{outcome.user(outcome.str_text(parent_r.err))}; }
    ret push_entry(v, parent_r.ok, ENTRY_DIR);
}

# the dependency artifact home beside the cell's object root: every requirement a
# dependency's default library carries writes under it, so it is this cell's output
# as much as `obj/` is
fun push_dependency_home(a: *A.Allocator, itn: *intern.Interner, v: *Vector[CleanEntry], obj_root: intern.StrId) err[outcome.Fail] {
    val found: opt[str] = intern.lookup(itn, obj_root);
    if (sel found.none) { ret err[outcome.Fail].ok{}; }
    val tmpl:     str   = found.some;
    val n:        usize = str_len(tmpl);
    var last_sep: i64   = -1;
    var i:        usize = 0;
    for (i < n) {
        if (tmpl[i] == '/'::u8) { last_sep = i::i64; }
        i = i + 1;
    }
    if (last_sep < 0) { ret err[outcome.Fail].ok{}; }
    val parent_r: res[str, string.StrError] = str_copy_slice(a, tmpl, 0, last_sep::usize);
    if (sel parent_r.err) { ret err[outcome.Fail].err{outcome.user(outcome.str_text(parent_r.err))}; }
    val home_r: res[str, format.FormatError] = format.sprint(a, "{}/{}", parent_r.ok, manifest.DEPENDENCY_ARTIFACT_DIR);
    if (sel home_r.err) { ret err[outcome.Fail].err{outcome.user(outcome.format_text(home_r.err))}; }
    ret push_entry(v, home_r.ok, ENTRY_DIR);
}

fun build_clean_plan(a: *A.Allocator, itn: *intern.Interner, m: *manifest.Manifest, root: str) res[Vector[CleanEntry], outcome.Fail] {
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val ready: err[outcome.Fail] = setup_registry(?reg);
    if (sel ready.err) { ret res[Vector[CleanEntry], outcome.Fail].err{ready.err}; }

    var raw: Vector[CleanEntry] = vector.init[CleanEntry](a);

    val targets_r: res[Vector[str], outcome.Fail] = target_selectors(a, itn, m);
    if (sel targets_r.err) { ret res[Vector[CleanEntry], outcome.Fail].err{targets_r.err}; }
    var targets: Vector[str] = targets_r.ok;

    val profiles_r: res[Vector[str], outcome.Fail] = profile_selectors(a, itn, m);
    if (sel profiles_r.err) { ret res[Vector[CleanEntry], outcome.Fail].err{profiles_r.err}; }
    var profiles: Vector[str] = profiles_r.ok;

    var ti: usize = 0;
    for (ti < targets.len) {
        val tname: str   = targets.data[ti];
        var pi:    usize = 0;
        for (pi < profiles.len) {
            val pname: str               = profiles.data[pi];
            val fault: err[outcome.Fail] = plan_cells_for(a, itn, ?reg, m, tname, pname, ?raw);
            if (sel fault.err) { ret res[Vector[CleanEntry], outcome.Fail].err{fault.err}; }
            pi = pi + 1;
        }
        ti = ti + 1;
    }

    var pdi: usize = 0;
    for (pdi < profiles.len) {
        val fault: err[outcome.Fail] = plan_dependency_cells_for(a, itn, ?reg, m, root, profiles.data[pdi], ?raw);
        if (sel fault.err) { ret res[Vector[CleanEntry], outcome.Fail].err{fault.err}; }
        pdi = pdi + 1;
    }

    val collapsed_r: res[Vector[CleanEntry], outcome.Fail] = normalize_and_collapse(a, ?raw);
    vector.dnit[CleanEntry](?raw);
    ret collapsed_r;
}

fun plan_cells_for(a: *A.Allocator, itn: *intern.Interner, reg: *target.TargetRegistry, m: *manifest.Manifest,
    tname: str, pname: str, raw: *Vector[CleanEntry]) err[outcome.Fail] {
    var target_id:      intern.StrId = intern.STR_NIL;
    var have_target_id: bool         = false;
    if (m.target_count > 0) {
        val tid_r: res[intern.StrId, A.Error] = intern.intern(itn, tname);
        if (sel tid_r.err) { ret err[outcome.Fail].err{outcome.refused(tid_r.err)}; }
        target_id      = tid_r.ok;
        have_target_id = true;
    }

    var ai: u32 = 0;
    for (ai < m.artifact_count) {
        val art: *manifest.ArtifactDef = ?m.artifacts[ai];

        if (have_target_id && !manifest.artifact_supports_target(itn, art, target_id)) {
            ai = ai + 1;
            cnt;
        }

        val name_opt: opt[str] = intern.lookup(itn, art.name);
        if (sel name_opt.none) {
            ai = ai + 1;
            cnt;
        }

        var pick: manifest.Selection;
        pick.target       = tname;
        pick.profile      = pname;
        pick.artifact     = name_opt.some;
        pick.want_lib     = art.is_lib;
        pick.has_artifact = true;

        val ur: res[manifest.BuildUnit, outcome.Fail] = manifest.resolve_build_unit(a, itn, reg, m, pick);
        if (sel ur.err) {
            if (!have_target_id) {
                ai = ai + 1;
                cnt;
            }
            ret err[outcome.Fail].err{ur.err};
        }
        val bu: manifest.BuildUnit = ur.ok;

        var fault: err[outcome.Fail] = push_id_entry(itn, raw, bu.obj_root, ENTRY_DIR);
        if (sel fault.err) { ret err[outcome.Fail].err{fault.err}; }
        val home_fault: err[outcome.Fail] = push_dependency_home(a, itn, raw, bu.obj_root);
        if (sel home_fault.err) { ret err[outcome.Fail].err{home_fault.err}; }
        val fault2: err[outcome.Fail] = push_id_entry(itn, raw, bu.ir_root, ENTRY_DIR);
        if (sel fault2.err) { ret err[outcome.Fail].err{fault2.err}; }
        val fault3: err[outcome.Fail] = push_id_entry(itn, raw, bu.asm_root, ENTRY_DIR);
        if (sel fault3.err) { ret err[outcome.Fail].err{fault3.err}; }
        val fault4: err[outcome.Fail] = push_test_root_entry(a, itn, raw, bu.test_root);
        if (sel fault4.err) { ret err[outcome.Fail].err{fault4.err}; }
        val fault5: err[outcome.Fail] = push_id_entry(itn, raw, bu.bin_path, ENTRY_FILE);
        if (sel fault5.err) { ret err[outcome.Fail].err{fault5.err}; }

        ai = ai + 1;
    }
    ret err[outcome.Fail].ok{};
}

# the cells a dependency's default library artifacts require write under the root's
# out expanded with the dependency's own target, which the root never names. the
# realized dependency manifests are read for those target names only: no
# verification, no network, and a slot without a readable manifest is skipped
fun plan_dependency_cells_for(a: *A.Allocator, itn: *intern.Interner, reg: *target.TargetRegistry,
    m: *manifest.Manifest, root: str, pname: str, raw: *Vector[CleanEntry]) err[outcome.Fail] {
    if (m.dep_count == 0) { ret err[outcome.Fail].ok{}; }
    val dep_dir_r: res[str, A.Error] = path.join(a, root, "dep");
    if (sel dep_dir_r.err) { ret err[outcome.Fail].err{outcome.refused(dep_dir_r.err)}; }
    val dep_dir: str = dep_dir_r.ok;

    val listed: res[Vector[str], fs.FsError] = fs.read_dir(a, dep_dir);
    if (sel listed.err) { ret err[outcome.Fail].ok{}; }
    var names: Vector[str] = listed.ok;

    var i: usize = 0;
    for (i < names.len) {
        val slot_r: res[str, A.Error] = path.join(a, dep_dir, names.data[i]);
        if (sel slot_r.err) { ret err[outcome.Fail].err{outcome.refused(slot_r.err)}; }
        val manifest_r: res[str, A.Error] = path.join(a, slot_r.ok, manifest.MANIFEST_FILE);
        if (sel manifest_r.err) { ret err[outcome.Fail].err{outcome.refused(manifest_r.err)}; }
        val dm_r: res[manifest.Manifest, outcome.Fail] = read_dependency_manifest(a, itn, manifest_r.ok);
        if (sel dm_r.ok) {
            var dm:    manifest.Manifest = dm_r.ok;
            var scope: manifest.Scope    = manifest.dependency_scope(m, ?dm);
            var ai:    u32               = 0;
            for (ai < dm.artifact_count) {
                val ra: *manifest.ArtifactDef = ?dm.artifacts[ai];
                if (manifest.default_library_requires(itn, ?dm, ra)) {
                    val rname:         opt[str] = intern.lookup(itn, ra.name);
                    var artifact_name: str      = "";
                    if (sel rname.some) { artifact_name = rname.some; }
                    var ti: u32 = 0;
                    for (ti < dm.target_count) {
                        val tname:       opt[str] = intern.lookup(itn, dm.targets[ti].name);
                        var target_name: str      = "";
                        if (sel tname.some) { target_name = tname.some; }
                        if (!str_empty(artifact_name) && !str_empty(target_name)
                            && manifest.artifact_supports_target(itn, ra, dm.targets[ti].name)) {
                            var pick: manifest.Selection;
                            pick.target       = target_name;
                            pick.profile      = pname;
                            pick.artifact     = artifact_name;
                            pick.want_lib     = ra.is_lib;
                            pick.has_artifact = true;
                            val ur:    res[manifest.BuildUnit, outcome.Fail] = manifest.resolve_scoped_build_unit(a, itn, reg, ?scope, pick);
                            val fault: err[outcome.Fail]                     = push_dependency_cell(a, itn, raw, ur);
                            if (sel fault.err) { ret fault; }
                        }
                        ti = ti + 1;
                    }
                }
                ai = ai + 1;
            }
            manifest.dnit(?dm, a);
        }
        i = i + 1;
    }
    ret err[outcome.Fail].ok{};
}

# the object root and dependency home of one resolved dependency cell; a cell that
# does not resolve names no output to remove
fun push_dependency_cell(a: *A.Allocator, itn: *intern.Interner, raw: *Vector[CleanEntry],
    ur: res[manifest.BuildUnit, outcome.Fail]) err[outcome.Fail] {
    if (sel ur.err) { ret err[outcome.Fail].ok{}; }
    val bu:    manifest.BuildUnit = ur.ok;
    val fault: err[outcome.Fail]  = push_id_entry(itn, raw, bu.obj_root, ENTRY_DIR);
    if (sel fault.err) { ret fault; }
    ret push_dependency_home(a, itn, raw, bu.obj_root);
}

fun read_dependency_manifest(a: *A.Allocator, itn: *intern.Interner, manifest_path: str) res[manifest.Manifest, outcome.Fail] {
    val bytes_r: res[Vector[u8], fs.FsError] = fs.read_bytes(a, manifest_path);
    if (sel bytes_r.err) { ret res[manifest.Manifest, outcome.Fail].err{outcome.user("dependency manifest is unreadable")}; }
    var bytes:     Vector[u8]          = bytes_r.ok;
    val reserve_r: res[usize, A.Error] = vector.reserve[u8](?bytes, 1);
    if (sel reserve_r.err) {
        vector.dnit[u8](?bytes);
        ret res[manifest.Manifest, outcome.Fail].err{outcome.refused(reserve_r.err)};
    }
    bytes.data[bytes.len] = 0;
    val tbl_r: res[toml.Table, toml.TomlError] = toml.parse(a, bytes.data::str);
    vector.dnit[u8](?bytes);
    if (sel tbl_r.err) { ret res[manifest.Manifest, outcome.Fail].err{outcome.user(outcome.toml_text(tbl_r.err))}; }
    var tbl:    toml.Table                           = tbl_r.ok;
    val parsed: res[manifest.Manifest, outcome.Fail] = manifest.parse(a, itn, ?tbl, false);
    toml.dnit(a, ?tbl);
    ret parsed;
}

fun cmp_entry(x: *CleanEntry, y: *CleanEntry) i64 {
    ret str_compare(x.rel, y.rel);
}

fun is_ancestor(anc: str, cand: str) bool {
    val al: usize = str_len(anc);
    val cl: usize = str_len(cand);
    if (al >= cl)                    { ret false; }
    if (!str_starts_with(cand, anc)) { ret false; }
    ret cand[al] == '/'::u8;
}

fun normalize_and_collapse(a: *A.Allocator, raw: *Vector[CleanEntry]) res[Vector[CleanEntry], outcome.Fail] {
    var out: Vector[CleanEntry] = vector.init[CleanEntry](a);
    if (raw.len == 0) { ret res[Vector[CleanEntry], outcome.Fail].ok{out}; }

    sort.sort_by[CleanEntry](raw.data, raw.len, cmp_entry);

    var i: usize = 0;
    for (i < raw.len) {
        val cur: CleanEntry = raw.data[i];
        if (out.len > 0) {
            val last: CleanEntry = out.data[out.len - 1];
            if (str_equals(cur.rel, last.rel)) {
                i = i + 1;
                cnt;
            }
            if (last.kind == ENTRY_DIR && is_ancestor(last.rel, cur.rel)) {
                i = i + 1;
                cnt;
            }
        }
        val pr: res[usize, A.Error] = vector.push[CleanEntry](?out, cur);
        if (sel pr.err) {
            vector.dnit[CleanEntry](?out);
            ret res[Vector[CleanEntry], outcome.Fail].err{outcome.refused(pr.err)};
        }
        i = i + 1;
    }
    ret res[Vector[CleanEntry], outcome.Fail].ok{out};
}

# every target is validated as a canonical path beneath the project root
# before anything is removed, so a refused entry leaves the plan untouched
fun check_plan(entries: *CleanEntry, count: usize) err[outcome.Fail] {
    var i: usize = 0;
    for (i < count) {
        if (!manifest.is_project_path(entries[i].rel)) { ret err[outcome.Fail].err{outcome.user("clean target is not a canonical path beneath the project root")}; }
        i = i + 1;
    }
    ret err[outcome.Fail].ok{};
}

fun execute_plan(a: *A.Allocator, root: str, entries: *CleanEntry, count: usize, removed: *usize) i64 {
    val checked: err[outcome.Fail] = check_plan(entries, count);
    if (sel checked.err) {
        print.eprint("error: cannot reserve clean targets: ");
        print.eprintln(outcome.describe(checked.err));
        ret 2;
    }
    var root_fd: usize = os.INVALID_HANDLE;
    val opened:  i64   = remove.open_path(root, ?root_fd);
    if (opened < 0) {
        print.eprint("error: cannot open the project root: ");
        print.eprintln(os.error_message(opened));
        ret 2;
    }
    fin { os.close(root_fd); }
    var code: i64   = 0;
    var i:    usize = 0;
    for (i < count) {
        code = execute_entry(root_fd, ?entries[i], removed, code);
        i    = i + 1;
    }
    ret code;
}

fun execute_entry(root_fd: usize, e: *CleanEntry, removed: *usize, code: i64) i64 {
    val rr: remove.Removal = remove.relative(root_fd, e.rel);
    if (rr.failed) {
        if (rr.kind == io_error.NOT_FOUND && !rr.containment) { ret code; }
        print.eprint("error: cannot remove clean target '");
        print.eprint(e.rel);
        print.eprint("': ");
        print.eprintln(remove.message(rr));
        ret 2;
    }
    if (rr.removed == 0) { ret code; }

    print.print("removed ");
    print.println(e.rel);
    @removed = @removed + 1;
    ret code;
}

# a refusal carries no native code, and a clean target it stops is still an error
test "mach.cli.cmd.clean.execute_entry:a_removal_refusal_is_an_error" {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val created: res[fixture.Output, outcome.Fail] = fixture.create(?a, "mach-clean-refusal");
    if (sel created.err) { ret 2; }
    var owner: fixture.Output = created.ok;
    fin { fixture.dnit(?owner); }
    var root: usize = os.INVALID_HANDLE;
    if (remove.open_path(owner.directory, ?root) < 0) { ret 3; }
    fin { os.close(root); }
    if (os.make_dir(root, "kept", 0o700) < 0) { ret 4; }
    val long: str = remove.t_component(?a, 256);
    if (long == nil) { ret 5; }
    var removed:  usize      = 0;
    var too_long: CleanEntry = CleanEntry{rel: long};
    if (execute_entry(root, ?too_long, ?removed, 0) != 2) { ret 6; }
    var trailing: CleanEntry = CleanEntry{rel: "kept/"};
    if (execute_entry(root, ?trailing, ?removed, 0) != 2) { ret 7; }
    var absent: CleanEntry = CleanEntry{rel: "absent"};
    if (execute_entry(root, ?absent, ?removed, 0) != 0 || removed != 0) { ret 8; }
    var kept: CleanEntry = CleanEntry{rel: "kept"};
    if (execute_entry(root, ?kept, ?removed, 0) != 0 || removed != 1) { ret 9; }
    ret 0;
}

test "mach.cli.cmd.clean.clean_project:refuses_symlink_ancestor_escape" {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }

    val tf_r: res[fs.TempFile, fs.FsError] = fs.temp_create(?a, "mach_clean_escape");
    if (sel tf_r.err) { ret 1; }
    var tf:     fs.TempFile               = tf_r.ok;
    val base_r: res[str, string.StrError] = str_copy_slice(?a, fs.temp_path(?tf), 0, str_len(fs.temp_path(?tf)));
    fs.temp_close_and_remove(?tf);
    if (sel base_r.err) { ret 1; }
    val base: str = base_r.ok;

    val root_r: res[str, A.Error] = path.join(?a, base, "proj");
    if (sel root_r.err) { ret 1; }
    val root:      str               = root_r.ok;
    val outside_r: res[str, A.Error] = path.join(?a, base, "outside");
    if (sel outside_r.err) { ret 1; }
    val outside:     str               = outside_r.ok;
    val outside_x_r: res[str, A.Error] = path.join(?a, outside, "x");
    if (sel outside_x_r.err) { ret 1; }
    val outside_x: str = outside_x_r.ok;

    val create_dir_all_r2: err[fs.FsError] = fs.create_dir_all(?a, root, 0o755);
    if (sel create_dir_all_r2.err) { ret 1; }
    val create_dir_all_r: err[fs.FsError] = fs.create_dir_all(?a, outside_x, 0o755);
    if (sel create_dir_all_r.err) { ret 1; }

    val sentinel_r: res[str, A.Error] = path.join(?a, outside_x, "sentinel");
    if (sel sentinel_r.err) { ret 1; }
    val sentinel:      str             = sentinel_r.ok;
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(sentinel, "s"::*u8, 1, 0o600);
    if (sel write_bytes_r.err) { ret 1; }

    val toml_path_r: res[str, A.Error] = path.join(?a, root, "mach.toml");
    if (sel toml_path_r.err) { ret 1; }
    val toml_path:      str             = toml_path_r.ok;
    val body:           str             = "[project]\nmach = \">=5\"\nid = \"escapetest\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out\"\n\n[artifact.escapetest]\nkind = \"bin\"\nentry = \"src/main.mach\"\nout = \"x\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n";
    val write_bytes_r2: err[fs.FsError] = fs.write_bytes(toml_path, body::*u8, str_len(body), 0o644);
    if (sel write_bytes_r2.err) { ret 1; }

    val link_r: res[str, A.Error] = path.join(?a, root, "out");
    if (sel link_r.err) { ret 1; }
    val link:      str                 = link_r.ok;
    val symlink_r: err[io_error.Error] = fs.symlink(outside, link);
    if (sel symlink_r.err) { ret 1; }

    val rc:       i64                       = clean_project(?a, root::*u8);
    val exists_r: res[bool, io_error.Error] = fs.exists(sentinel);
    if (sel exists_r.err) { ret 99; }
    val survived: bool = (sel exists_r.ok && exists_r.ok);

    fs.remove_file(link);
    fs.remove_all(?a, root);
    fs.remove_all(?a, outside);

    if (rc == 0)   { ret 1; }
    if (!survived) { ret 2; }
    ret 0;
}

test "mach.cli.cmd.clean.is_ancestor:segment_boundary_not_string_prefix" {
    var bad: i32 = 0;
    if (!is_ancestor("out", "out/x"))   { bad = 1; }
    if (!is_ancestor("out", "out/x/y")) { bad = 1; }
    if (is_ancestor("out", "out2/x"))   { bad = 1; }
    if (is_ancestor("out", "out"))      { bad = 1; }
    if (is_ancestor("out/x", "out"))    { bad = 1; }
    if (is_ancestor("", "out"))         { bad = 1; }
    ret bad;
}

test "mach.cli.cmd.clean.normalize_and_collapse:dedups_and_collapses_descendants_only_under_a_dir_ancestor" {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }

    var raw: Vector[CleanEntry] = vector.init[CleanEntry](?a);
    push_entry(?raw, "out/x/obj", ENTRY_DIR);
    push_entry(?raw, "out/x/obj", ENTRY_DIR);
    push_entry(?raw, "out/x/obj/leftover", ENTRY_DIR);
    push_entry(?raw, "out/x/ir", ENTRY_DIR);
    push_entry(?raw, "out/x/bin/name", ENTRY_FILE);
    push_entry(?raw, "out/x/bin/name/nested", ENTRY_DIR);
    push_entry(?raw, "out/y/obj", ENTRY_DIR);

    val out_r: res[Vector[CleanEntry], outcome.Fail] = normalize_and_collapse(?a, ?raw);
    if (sel out_r.err) { ret 1; }
    val out: Vector[CleanEntry] = out_r.ok;

    if (out.len != 5) { ret 2; }

    var saw_obj_leftover: bool  = false;
    var saw_bin_nested:   bool  = false;
    var i:                usize = 0;
    for (i < out.len) {
        if (str_equals(out.data[i].rel, "out/x/obj/leftover"))    { saw_obj_leftover = true; }
        if (str_equals(out.data[i].rel, "out/x/bin/name/nested")) { saw_bin_nested = true; }
        i = i + 1;
    }
    if (saw_obj_leftover) { ret 3; }
    if (!saw_bin_nested)  { ret 4; }
    ret 0;
}

test "mach.cli.cmd.clean.execute_entry:removes_declared_root_and_leaves_a_near_miss_neighbour" {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }

    val tf_r: res[fs.TempFile, fs.FsError] = fs.temp_create(?a, "mach_clean_precision");
    if (sel tf_r.err) { ret 1; }
    var tf:   fs.TempFile = tf_r.ok;
    val root: str         = fs.temp_path(?tf);
    fs.temp_close_and_remove(?tf);
    val create_dir_all_r: err[fs.FsError] = fs.create_dir_all(?a, root, 0o755);
    if (sel create_dir_all_r.err) { ret 1; }

    val declared_r: res[str, A.Error] = path.join(?a, root, "out");
    if (sel declared_r.err) { ret 1; }
    val declared:          str             = declared_r.ok;
    val create_dir_all_r2: err[fs.FsError] = fs.create_dir_all(?a, declared, 0o755);
    if (sel create_dir_all_r2.err) { ret 1; }

    val near_miss_r: res[str, A.Error] = path.join(?a, root, "out-user-data");
    if (sel near_miss_r.err) { ret 1; }
    val near_miss:         str             = near_miss_r.ok;
    val create_dir_all_r3: err[fs.FsError] = fs.create_dir_all(?a, near_miss, 0o755);
    if (sel create_dir_all_r3.err) { ret 1; }
    val near_miss_file_r: res[str, A.Error] = path.join(?a, near_miss, "keep.txt");
    if (sel near_miss_file_r.err) { ret 1; }
    val near_miss_file: str             = near_miss_file_r.ok;
    val write_bytes_r:  err[fs.FsError] = fs.write_bytes(near_miss_file, "keep"::*u8, 4, 0o600);
    if (sel write_bytes_r.err) { ret 1; }

    var removed: usize = 0;
    var e:       CleanEntry;
    e.rel  = "out";
    e.kind = ENTRY_DIR;
    val code: i64 = execute_plan(?a, root, ?e, 1, ?removed);

    var bad: i32 = 0;
    if (code != 0)    { bad = 1; }
    if (removed != 1) { bad = 1; }
    val exists_r: res[bool, io_error.Error] = fs.exists(declared);
    if (sel exists_r.err)                 { ret 99; }
    if ((sel exists_r.ok && exists_r.ok)) { bad = 1; }
    val exists_r2: res[bool, io_error.Error] = fs.exists(near_miss_file);
    if (sel exists_r2.err)                   { ret 99; }
    if (!(sel exists_r2.ok && exists_r2.ok)) { bad = 1; }

    fs.remove_all(?a, root);
    ret bad;
}

test "mach.cli.cmd.clean.build_clean_plan:dynamic_first_out_template_still_cleans" {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }

    val tf_r: res[fs.TempFile, fs.FsError] = fs.temp_create(?a, "mach_clean_dynfirst");
    if (sel tf_r.err) { ret 1; }
    var tf:   fs.TempFile = tf_r.ok;
    val root: str         = fs.temp_path(?tf);
    fs.temp_close_and_remove(?tf);
    val create_dir_all_r: err[fs.FsError] = fs.create_dir_all(?a, root, 0o755);
    if (sel create_dir_all_r.err) { ret 1; }

    val toml_path_r: res[str, A.Error] = path.join(?a, root, "mach.toml");
    if (sel toml_path_r.err) { ret 1; }
    val toml_path:     str             = toml_path_r.ok;
    val body:          str             = "[project]\nmach = \">=5\"\nid = \"dynfirst\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"{target.name}-out\"\n\n[artifact.dynfirst]\nkind = \"bin\"\nentry = \"src/main.mach\"\nout = \"bin/name\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n";
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(toml_path, body::*u8, str_len(body), 0o644);
    if (sel write_bytes_r.err) { ret 1; }

    val out_dir_r: res[str, A.Error] = path.join(?a, root, "native-out");
    if (sel out_dir_r.err) { ret 1; }
    val out_dir:   str               = out_dir_r.ok;
    val obj_dir_r: res[str, A.Error] = path.join(?a, out_dir, "obj");
    if (sel obj_dir_r.err) { ret 1; }
    val obj_dir:           str             = obj_dir_r.ok;
    val create_dir_all_r2: err[fs.FsError] = fs.create_dir_all(?a, obj_dir, 0o755);
    if (sel create_dir_all_r2.err) { ret 1; }

    val rc: i64 = clean_project(?a, root::*u8);

    var bad: i32 = 0;
    if (rc != 0) { bad = 1; }
    val exists_r: res[bool, io_error.Error] = fs.exists(obj_dir);
    if (sel exists_r.err)                 { ret 99; }
    if ((sel exists_r.ok && exists_r.ok)) { bad = 1; }

    fs.remove_all(?a, root);
    ret bad;
}

test "mach.cli.cmd.clean.build_clean_plan:unsupported_target_artifact_pairs_are_skipped_not_errored" {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }

    val tf_r: res[fs.TempFile, fs.FsError] = fs.temp_create(?a, "mach_clean_multitarget");
    if (sel tf_r.err) { ret 1; }
    var tf:   fs.TempFile = tf_r.ok;
    val root: str         = fs.temp_path(?tf);
    fs.temp_close_and_remove(?tf);
    val create_dir_all_r: err[fs.FsError] = fs.create_dir_all(?a, root, 0o755);
    if (sel create_dir_all_r.err) { ret 1; }

    val toml_path_r: res[str, A.Error] = path.join(?a, root, "mach.toml");
    if (sel toml_path_r.err) { ret 1; }
    val toml_path:     str             = toml_path_r.ok;
    val body:          str             = "[project]\nmach = \">=5\"\nid = \"multitarget\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}\"\n\n[target.linux]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[target.windows]\nisa = \"x86_64\"\nos = \"windows\"\nabi = \"win64\"\n\n[artifact.linuxonly]\nkind = \"bin\"\nentry = \"src/main.mach\"\nout = \"bin/name\"\ntargets = [\"linux\"]\nlink = []\nneed = []\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n";
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(toml_path, body::*u8, str_len(body), 0o644);
    if (sel write_bytes_r.err) { ret 1; }

    val linux_obj_r: res[str, A.Error] = path.join(?a, root, "out/linux/obj");
    if (sel linux_obj_r.err) { ret 1; }
    val linux_obj:         str             = linux_obj_r.ok;
    val create_dir_all_r2: err[fs.FsError] = fs.create_dir_all(?a, linux_obj, 0o755);
    if (sel create_dir_all_r2.err) { ret 1; }

    val windows_dir_r: res[str, A.Error] = path.join(?a, root, "out/windows");
    if (sel windows_dir_r.err) { ret 1; }
    val windows_dir: str = windows_dir_r.ok;

    val rc: i64 = clean_project(?a, root::*u8);

    var bad: i32 = 0;
    if (rc != 0) { bad = 1; }
    val exists_r: res[bool, io_error.Error] = fs.exists(linux_obj);
    if (sel exists_r.err)                 { ret 99; }
    if ((sel exists_r.ok && exists_r.ok)) { bad = 1; }
    val exists_r2: res[bool, io_error.Error] = fs.exists(windows_dir);
    if (sel exists_r2.err)                  { ret 99; }
    if ((sel exists_r2.ok && exists_r2.ok)) { bad = 1; }

    fs.remove_all(?a, root);
    ret bad;
}

test "mach.cli.cmd.clean.execute_entry:a_dotdot_target_is_refused_through_the_root_capability" {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val tf_r: res[fs.TempFile, fs.FsError] = fs.temp_create(?a, "mach_clean_dotdot");
    if (sel tf_r.err) { ret 1; }
    var tf:     fs.TempFile               = tf_r.ok;
    val base_r: res[str, string.StrError] = str_copy_slice(?a, fs.temp_path(?tf), 0, str_len(fs.temp_path(?tf)));
    fs.temp_close_and_remove(?tf);
    if (sel base_r.err) { ret 1; }
    val base:      str               = base_r.ok;
    val root_r:    res[str, A.Error] = path.join(?a, base, "proj");
    val outside_r: res[str, A.Error] = path.join(?a, base, "outside");
    if (sel root_r.err)    { ret 1; }
    if (sel outside_r.err) { ret 1; }
    val root:              str             = root_r.ok;
    val outside:           str             = outside_r.ok;
    val create_dir_all_r2: err[fs.FsError] = fs.create_dir_all(?a, root, 0o755);
    if (sel create_dir_all_r2.err) { ret 1; }
    val create_dir_all_r: err[fs.FsError] = fs.create_dir_all(?a, outside, 0o755);
    if (sel create_dir_all_r.err) { ret 1; }
    val sentinel_r: res[str, A.Error] = path.join(?a, outside, "sentinel");
    if (sel sentinel_r.err) { ret 1; }
    val sentinel:      str             = sentinel_r.ok;
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(sentinel, "s"::*u8, 1, 0o600);
    if (sel write_bytes_r.err) { ret 1; }

    var removed: usize = 0;
    var e:       CleanEntry;
    e.rel  = "../outside";
    e.kind = ENTRY_DIR;
    val code: i64 = execute_plan(?a, root, ?e, 1, ?removed);
    var f:    CleanEntry;
    f.rel  = "../outside/sentinel";
    f.kind = ENTRY_FILE;
    val code_file: i64                       = execute_plan(?a, root, ?f, 1, ?removed);
    val exists_r:  res[bool, io_error.Error] = fs.exists(sentinel);
    if (sel exists_r.err) { ret 99; }
    val survived: bool = (sel exists_r.ok && exists_r.ok);
    fs.remove_all(?a, base);
    if (code != 2 || code_file != 2) { ret 1; }
    if (removed != 0)                { ret 1; }
    if (!survived)                   { ret 2; }
    ret 0;
}

test "mach.cli.cmd.clean:refuses_the_whole_plan_before_deleting_anything" {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val temp_r: res[fs.TempFile, fs.FsError] = fs.temp_create(?a, "mach_clean_claims");
    if (sel temp_r.err) { ret 2; }
    var temp:   fs.TempFile               = temp_r.ok;
    val root_r: res[str, string.StrError] = str_copy_slice(?a, fs.temp_path(?temp), 0, str_len(fs.temp_path(?temp)));
    val closed: err[io_error.Error]       = fs.temp_close_and_remove(?temp);
    str_free(?a, fs.temp_path(?temp));
    if (sel closed.err) { ret 3; }
    if (sel root_r.err) { ret 3; }
    val root: str = root_r.ok;
    fin {
        fs.remove_all(?a, root);
        str_free(?a, root);
    }
    val left_r: res[str, A.Error] = path.join(?a, root, "out/a");
    if (sel left_r.err) { ret 4; }
    val left: str = left_r.ok;
    fin { str_free(?a, left); }
    val right_r: res[str, A.Error] = path.join(?a, root, "out/b");
    if (sel right_r.err) { ret 5; }
    val right: str = right_r.ok;
    fin { str_free(?a, right); }
    val create_dir_all_r2: err[fs.FsError] = fs.create_dir_all(?a, left, 0o755);
    if (sel create_dir_all_r2.err) { ret 6; }
    val create_dir_all_r: err[fs.FsError] = fs.create_dir_all(?a, right, 0o755);
    if (sel create_dir_all_r.err) { ret 6; }
    var entries: [2]CleanEntry;
    entries[0] = CleanEntry{rel: "out/a", kind: ENTRY_DIR};
    entries[1] = CleanEntry{rel: "../outside", kind: ENTRY_DIR};
    var removed:  usize                     = 0;
    val exists_r: res[bool, io_error.Error] = fs.exists(left);
    if (execute_plan(?a, root, ?entries[0], 2, ?removed) != 2) { ret 7; }
    if (removed != 0)                                          { ret 7; }
    if (!(sel exists_r.ok && exists_r.ok))                     { ret 7; }
    entries[1].rel = "out/b";
    if (execute_plan(?a, root, ?entries[0], 2, ?removed) != 0 || removed != 2) { ret 12; }
    val exists_r4: res[bool, io_error.Error] = fs.exists(left);
    val exists_r5: res[bool, io_error.Error] = fs.exists(right);
    if ((sel exists_r4.ok && exists_r4.ok)) { ret 13; }
    if ((sel exists_r5.ok && exists_r5.ok)) { ret 13; }
    ret 0;
}
