# a ticker on a thread of its own: every period it takes the owner's lock and calls `tick`, until
# it is stopped. what `tick` reads is the owner's, guarded by that lock

use chrono_duration: std.chrono.duration;
use std.chrono.time;
use std.sync.condition;
use std.sync.mutex;
use sync_thread: std.sync.thread;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;

# a running ticker, which must not move while it runs
# ---
# lock:   the owner's lock, held around each tick
# period: the time between ticks
# tick:   what runs each period, the lock held
# ctx:    what `tick` is passed
# stop:   the ticker was told to stop, guarded by `lock`
# wake:   signalled to end the wait between ticks early
# thread: the thread it runs on
pub rec Ticker {
    lock:   *mutex.Mutex;
    period: chrono_duration.Duration;
    tick:   fun(ptr);
    ctx:    ptr;
    stop:   bool;
    wake:   condition.Condition;
    thread: sync_thread.Thread;
}

# start `tick(ctx)` every `period` under `lock`, which the caller does not hold
# ---
# ret: whether it runs, false when the host refused the thread
pub fun start(t: *Ticker, lock: *mutex.Mutex, period: chrono_duration.Duration, tick: fun(ptr), ctx: ptr) bool {
    @t = Ticker{lock: lock, period: period, tick: tick, ctx: ctx, stop: false, wake: condition.make()};
    val err_spawned: sync_thread.Operation = sync_thread.spawn_with(run, t::*u8, ?t.thread);
    ret !sel err_spawned.err;
}

# stop a started ticker, returning once its thread has ended. the caller does not hold the lock
pub fun stop(t: *Ticker) {
    mutex.lock(t.lock);
    t.stop = true;
    condition.signal(?t.wake);
    mutex.unlock(t.lock);
    val err_joined: sync_thread.Operation = sync_thread.join(?t.thread);
}

fun run(arg: *u8) {
    val t: *Ticker = arg::*Ticker;
    mutex.lock(t.lock);
    for (!t.stop) {
        val res_now: time.InstantClock = time.instant();
        if (sel res_now.err) { brk; }
        val status: condition.WaitStatus = condition.wait_until(?t.wake, t.lock, time.instant_add(res_now.ok, t.period));
        if (sel status.invalid || sel status.failed) { brk; }
        if (!t.stop)                                 { t.tick(t.ctx); }
    }
    mutex.unlock(t.lock);
}
