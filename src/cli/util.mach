use A: std.allocator;
use O: std.types.option;
use R: std.types.result;

use std.allocator.arena;
use std.allocator.page;
use fs: std.filesystem;
use std.print;
use std.process.env;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_contains_char;
use std.types.string.str_copy;
use std.types.string.str_copy_slice;
use std.types.string.str_empty;
use std.types.string.str_equals;
use std.types.string.str_join;
use std.types.string.str_len;
use std.types.path;
use std.types.path.Path;
use std.system.os;
use std.text.string.str_free;

use mach.lang.manifest;

val DIR_MODE: i32 = 0o0755;

# the manifest file name, "mach.toml"
pub val PROJECT_CONFIG_NAME: str = manifest.MANIFEST_FILE;

# whether a flag occurs anywhere in argv
# ---
# argc: number of entries
# argv: the arguments
# flag: the exact spelling to find
# ret: true on an exact match
pub fun flag_exists(argc: usize, argv: *str, flag: str) bool {
    var i: usize = 0;
    for (i < argc) {
        if (str_equals(argv[i], flag)) {
            ret true;
        }
        i = i + 1;
    }

    ret false;
}

# the value following the first occurrence of a flag
# ---
# argc: number of entries
# argv: the arguments
# flag: the exact spelling to find
# ret: the argument after the first match; none when the flag is absent or is the last argument
pub fun flag_value(argc: usize, argv: *str, flag: str) O.Option[str] {
    var i: usize = 0;
    for (i < argc) {
        if (str_equals(argv[i], flag)) {
            if (i + 1 < argc) {
                ret O.some[str](argv[i + 1]);
            }

            ret O.none[str]();
        }

        i = i + 1;
    }

    ret O.none[str]();
}

# find every occurrence of a flag and mark its index
# ---
# marks: one bool per argv entry, set true at each occurrence; nil to only test presence
# argc: number of entries
# argv: the arguments
# flag: the exact spelling to find
# ret: true when the flag occurred at least once
pub fun flag_mark(marks: *bool, argc: usize, argv: *str, flag: str) bool {
    var found: bool  = false;
    var i:     usize = 0;
    for (i < argc) {
        if (str_equals(argv[i], flag)) {
            found = true;
            if (marks != nil) { marks[i] = true; }
        }

        i = i + 1;
    }

    ret found;
}

# find every occurrence of a value flag, mark each flag and its following argument, and
# return the first value
# ---
# marks: one bool per argv entry; the flag and the argument after it are marked; nil to skip marking
# argc: number of entries
# argv: the arguments
# flag: the exact spelling to find
# ret: the argument after the first occurrence that has one; none when the flag is absent or
#  every occurrence is last
pub fun flag_mark_value(marks: *bool, argc: usize, argv: *str, flag: str) O.Option[str] {
    var value: O.Option[str] = O.none[str]();
    var i:     usize         = 0;
    for (i < argc) {
        if (str_equals(argv[i], flag)) {
            if (marks != nil) { marks[i] = true; }

            if (i + 1 < argc) {
                if (marks != nil) {
                    marks[i + 1] = true;
                }

                if (O.is_none[str](value)) {
                    value = O.some[str](argv[i + 1]);
                }
            }
        }

        i = i + 1;
    }

    ret value;
}

# whether an argument starts with '-'; nil is not a flag
# ---
# s: the argument
# ret: true for a leading '-'
pub fun arg_is_flag(s: str) bool {
    ret s != nil && s[0] == '-';
}

# the index of the first "--" at or after argv[1]
# ---
# argc: number of entries
# argv: the arguments
# ret: the index, or argc when there is none
pub fun arg_separator_index(argc: usize, argv: *str) usize {
    var i: usize = 1;
    for (i < argc) {
        if (str_equals(argv[i], "--")) { ret i; }
        i = i + 1;
    }
    ret argc;
}

# the first unmarked argument at or after start that is not a flag
# ---
# argc: number of entries
# argv: the arguments
# marks: one bool per argv entry, true where an option or its value sits
# start: first index to inspect
# ret: the index, or argc when there is none
pub fun arg_index_positional(argc: usize, argv: *str, marks: *bool, start: usize) usize {
    var i: usize = start;
    for (i < argc) {
        val a: str = argv[i];

        if (marks[i]) {
            i = i + 1;
            cnt;
        }

        if (!arg_is_flag(a)) {
            ret i;
        }

        i = i + 1;
    }

    ret argc;
}

# print "error: unknown flag" for the first unmarked flag at or after start
# ---
# argc: number of entries
# argv: the arguments
# marks: one bool per argv entry, true where an option or its value sits
# start: first index to inspect
# cmd: the command name printed in the message
# ret: true when an unknown flag was found and reported
pub fun flag_reject_unknown(argc: usize, argv: *str, marks: *bool, start: usize, cmd: str) bool {
    var i: usize = start;
    for (i < argc) {
        if (!marks[i] && arg_is_flag(argv[i])) {
            print.eprintf("error: unknown flag '{}' for '{}'\n", argv[i], cmd);
            ret true;
        }

        i = i + 1;
    }

    ret false;
}

# how the project operand was given
pub def OperandClass: u8;
# a directory containing mach.toml
pub val OPERAND_DIRECTORY: OperandClass = 0;
# the path of the mach.toml itself
pub val OPERAND_MANIFEST:  OperandClass = 1;

# a resolved project operand; every string is owned and freed by dnit_project_location
# ---
# root: the project directory
# manifest: the path of its mach.toml
# display: the operand as the user typed it
# class: OPERAND_DIRECTORY or OPERAND_MANIFEST
pub rec ProjectLocation {
    root:     Path;
    manifest: Path;
    display:  str;
    class:    OperandClass;
}

# free the three strings of a location; nil strings are skipped
# ---
# a: the allocator resolve_project_location was given
# loc: the location
pub fun dnit_project_location(a: *A.Allocator, loc: *ProjectLocation) {
    if (loc.root != nil)     { A.deallocate[u8](a, loc.root, str_len(loc.root) + 1); }
    if (loc.manifest != nil) { A.deallocate[u8](a, loc.manifest, str_len(loc.manifest) + 1); }
    if (loc.display != nil)  { str_free(a, loc.display); }
}

fun resolve_directory_operand(a: *A.Allocator, arg: str, display: str) R.Result[ProjectLocation, str] {
    val mp_r: R.Result[Path, str] = path.join(a, arg, PROJECT_CONFIG_NAME);
    if (R.is_err[Path, str](mp_r)) { str_free(a, display); ret R.err[ProjectLocation, str](R.unwrap_err[Path, str](mp_r)); }
    val mp: Path = R.unwrap_ok[Path, str](mp_r);

    if (!fs.is_file(mp)) {
        A.deallocate[u8](a, mp, str_len(mp) + 1);
        str_free(a, display);
        ret R.err[ProjectLocation, str]("no mach.toml in the project directory");
    }

    val root_r: R.Result[Path, str] = path.clone(a, arg);
    if (R.is_err[Path, str](root_r)) {
        A.deallocate[u8](a, mp, str_len(mp) + 1);
        str_free(a, display);
        ret R.err[ProjectLocation, str](R.unwrap_err[Path, str](root_r));
    }

    var loc: ProjectLocation;
    loc.root     = R.unwrap_ok[Path, str](root_r);
    loc.manifest = mp;
    loc.display  = display;
    loc.class    = OPERAND_DIRECTORY;
    ret R.ok[ProjectLocation, str](loc);
}

fun resolve_manifest_operand(a: *A.Allocator, arg: str, display: str) R.Result[ProjectLocation, str] {
    if (!str_equals(path.filename(arg), PROJECT_CONFIG_NAME)) {
        str_free(a, display);
        ret R.err[ProjectLocation, str]("project file must be named mach.toml");
    }

    val root_r: R.Result[Path, str] = path.parent(a, arg);
    if (R.is_err[Path, str](root_r)) { str_free(a, display); ret R.err[ProjectLocation, str](R.unwrap_err[Path, str](root_r)); }
    val root: Path = R.unwrap_ok[Path, str](root_r);

    val mp_r: R.Result[Path, str] = path.clone(a, arg);
    if (R.is_err[Path, str](mp_r)) {
        A.deallocate[u8](a, root, str_len(root) + 1);
        str_free(a, display);
        ret R.err[ProjectLocation, str](R.unwrap_err[Path, str](mp_r));
    }

    var loc: ProjectLocation;
    loc.root     = root;
    loc.manifest = R.unwrap_ok[Path, str](mp_r);
    loc.display  = display;
    loc.class    = OPERAND_MANIFEST;
    ret R.ok[ProjectLocation, str](loc);
}

# turn a project operand into a root directory and a manifest path
# a directory operand must contain mach.toml; a file operand must itself be named mach.toml,
# and its parent becomes the root
# ---
# a: allocator for the returned strings
# arg: the operand; nil is an error asking for a path
# ret: the location, freed with dnit_project_location, or a message naming what was wrong
pub fun resolve_project_location(a: *A.Allocator, arg: str) R.Result[ProjectLocation, str] {
    if (arg == nil) {
        ret R.err[ProjectLocation, str]("missing project path; pass a project directory, e.g. '.'");
    }

    val display_r: R.Result[str, str] = str_copy(a, arg);
    if (R.is_err[str, str](display_r)) { ret R.err[ProjectLocation, str](R.unwrap_err[str, str](display_r)); }
    val display: str = R.unwrap_ok[str, str](display_r);

    if (fs.is_dir(arg))  { ret resolve_directory_operand(a, arg, display); }
    if (fs.is_file(arg)) { ret resolve_manifest_operand(a, arg, display); }

    str_free(a, display);
    ret R.err[ProjectLocation, str]("project path is not a directory or a mach.toml file");
}

# create a directory with mode 0755 when it does not exist; not recursive
# ---
# p: the directory path
# ret: true when the directory exists afterwards
pub fun ensure_dir(p: str) bool {
    if (fs.is_dir(p)) { ret true; }
    ret O.is_none[str](fs.create_dir(p, DIR_MODE));
}

# create every missing ancestor of a path with mode 0755; the path itself is not created
# ---
# a: allocator for the parent path
# p: the path whose parents are wanted
# ret: none on success, or the parent computation or creation error
pub fun ensure_parents(a: *A.Allocator, p: str) O.Option[str] {
    val pr: R.Result[Path, str] = path.parent(a, p);
    if (R.is_err[Path, str](pr)) { ret O.some[str](R.unwrap_err[Path, str](pr)); }
    ret fs.create_dir_all(a, R.unwrap_ok[Path, str](pr), DIR_MODE);
}

val EXEC_CAND_MAX: usize = 16;

fun is_executable(p: str) bool {
    $if ($mach.build.os == $mach.os.windows) {
        ret true;
    }
    $or {
        ret os.access(os.AT_FDCWD, p, 1, 0) >= 0;
    }
}

fun resolve_direct(a: *A.Allocator, name: str) R.Result[str, str] {
    if (!fs.is_file(name)) { ret R.err[str, str]("direct command path does not exist or is not a regular file"); }
    if (!is_executable(name)) { ret R.err[str, str]("direct command path is not executable"); }
    ret str_copy(a, name);
}

# locate an executable the way a shell would: a name with a path separator is used directly
# and must be an existing executable file; any other name is searched on PATH
# ---
# a: allocator for the returned path
# name: the program name or path
# ret: the resolved path, owned by the caller; "PATH unset", "not found on PATH", or the
#  direct-path error
pub fun resolve_cmd(a: *A.Allocator, name: str) R.Result[str, str] {
    if (path.has_separator(name)) { ret resolve_direct(a, name); }

    val paths_r: R.Result[str, str] = env.value(a, "PATH");
    if (R.is_err[str, str](paths_r)) { ret R.err[str, str]("PATH unset"); }
    val paths: str = R.unwrap_ok[str, str](paths_r);
    val out: R.Result[str, str] = resolve_cmd_in(a, name, paths);
    A.deallocate[u8](a, paths, str_len(paths) + 1);
    ret out;
}

# locate an executable through an explicit search list
# on windows the list separator is ';' and a name without a '.' is tried with each PATHEXT
# extension (default .COM;.EXE;.BAT;.CMD); elsewhere the separator is ':' and the name is
# tried as given. a name with a path separator is used directly, as in resolve_cmd
# ---
# a: allocator for the returned path
# name: the program name or path
# search: the separator-joined directories; empty segments are skipped
# ret: the first existing executable candidate, owned by the caller; "empty program name",
#  "not found on PATH", or the direct-path error
pub fun resolve_cmd_in(a: *A.Allocator, name: str, search: str) R.Result[str, str] {
    if (str_empty(name)) { ret R.err[str, str]("empty program name"); }
    if (path.has_separator(name)) { ret resolve_direct(a, name); }

    var list_sep: u8 = ':';
    $if ($mach.build.os == $mach.os.windows) {
        list_sep = ';';
    }

    var cand: [EXEC_CAND_MAX]str;
    var ncand: usize = 1;
    cand[0] = name;
    var owned_cands: bool = false;

    $if ($mach.build.os == $mach.os.windows) {
        if (!str_contains_char(name, '.')) {
            var exts: str = "";
            var own_exts: bool = false;
            val exts_r: R.Result[str, str] = env.value(a, "PATHEXT");
            if (R.is_ok[str, str](exts_r)) { exts = R.unwrap_ok[str, str](exts_r); own_exts = true; }
            if (str_empty(exts)) {
                if (own_exts) { A.deallocate[u8](a, exts, str_len(exts) + 1); }
                val d_r: R.Result[str, str] = str_copy(a, ".COM;.EXE;.BAT;.CMD");
                if (R.is_err[str, str](d_r)) { ret R.err[str, str]("out of memory"); }
                exts = R.unwrap_ok[str, str](d_r);
                own_exts = true;
            }
            val elen: usize = str_len(exts);
            ncand = 0;
            owned_cands = true;
            var e: usize = 0;
            for (e < elen && ncand < EXEC_CAND_MAX) {
                val estart: usize = e;
                for (e < elen && exts[e] != ';') { e = e + 1; }
                val eseg: usize = e - estart;
                if (e < elen) { exts[e] = 0; }
                e = e + 1;
                if (eseg == 0) { cnt; }
                val j_r: R.Result[str, str] = str_join(a, name, (?exts[estart])::str);
                if (R.is_ok[str, str](j_r)) { cand[ncand] = R.unwrap_ok[str, str](j_r); ncand = ncand + 1; }
            }
            if (own_exts) { A.deallocate[u8](a, exts, elen + 1); }
        }
    }

    val slen: usize = str_len(search);
    var found: str = "";
    var i: usize = 0;
    for (i < slen && str_empty(found)) {
        val start: usize = i;
        for (i < slen && search[i] != list_sep) { i = i + 1; }
        val seg_len: usize = i - start;
        i = i + 1;
        if (seg_len == 0) { cnt; }

        val dir_r: R.Result[str, str] = str_copy_slice(a, search, start, seg_len);
        if (R.is_err[str, str](dir_r)) { cnt; }
        val dir: str = R.unwrap_ok[str, str](dir_r);

        var c: usize = 0;
        for (c < ncand) {
            val cand_r: R.Result[Path, str] = path.join(a, dir, cand[c]);
            if (R.is_ok[Path, str](cand_r)) {
                val full: str = R.unwrap_ok[Path, str](cand_r);
                if (fs.is_file(full) && is_executable(full)) { found = full; brk; }
                A.deallocate[u8](a, full, str_len(full) + 1);
            }
            c = c + 1;
        }
        A.deallocate[u8](a, dir, seg_len + 1);
    }

    if (owned_cands) {
        var k: usize = 0;
        for (k < ncand) { A.deallocate[u8](a, cand[k], str_len(cand[k]) + 1); k = k + 1; }
    }

    if (str_empty(found)) { ret R.err[str, str]("not found on PATH"); }
    ret R.ok[str, str](found);
}

test "mach.cli.util.arg_separator_index:boundary_as_argc" {
    var argv: [4]*u8;
    argv[0] = "mach"; argv[1] = "run"; argv[2] = "--"; argv[3] = "x";
    if (arg_separator_index(4, ?argv[0]) != 2) { ret 1; }

    var bare: [2]*u8;
    bare[0] = "mach"; bare[1] = "build";
    if (arg_separator_index(2, ?bare[0]) != 2) { ret 1; }
    ret 0;
}

test "mach.cli.util.arg_index_positional:skips_marked" {
    var a: [4]*u8;
    a[0] = "mach"; a[1] = "init"; a[2] = "--name"; a[3] = "myproj";
    var ma: [4]bool;
    ma[0] = false; ma[1] = false; ma[2] = true; ma[3] = true;
    if (arg_index_positional(4, ?a[0], ?ma[0], 2) != 4) { ret 1; }

    var b: [5]*u8;
    b[0] = "mach"; b[1] = "init"; b[2] = "mydir"; b[3] = "--name"; b[4] = "x";
    var mb: [5]bool;
    mb[0] = false; mb[1] = false; mb[2] = false; mb[3] = true; mb[4] = true;
    if (arg_index_positional(5, ?b[0], ?mb[0], 2) != 2) { ret 1; }
    ret 0;
}

test "mach.cli.util.flag_mark:records_every_occurrence" {
    var argv: [4]*u8;
    argv[0] = "mach"; argv[1] = "build"; argv[2] = "-v"; argv[3] = "-v";
    var marks: [4]bool;
    var i: usize = 0;
    for (i < 4) { marks[i] = false; i = i + 1; }

    if (!flag_mark(?marks[0], 4, ?argv[0], "-v")) { ret 1; }
    if (!marks[2] || !marks[3])                   { ret 1; }
    if (marks[0] || marks[1])                     { ret 1; }
    if (flag_mark(?marks[0], 4, ?argv[0], "-q"))  { ret 1; }
    if (!flag_mark(nil, 4, ?argv[0], "-v"))       { ret 1; }
    ret 0;
}

test "mach.cli.util.flag_mark_value:marks_pairs_returns_first" {
    var argv: [6]*u8;
    argv[0] = "mach"; argv[1] = "build"; argv[2] = "-l"; argv[3] = "a";
    argv[4] = "-l";   argv[5] = "b";
    var marks: [6]bool;
    var i: usize = 0;
    for (i < 6) { marks[i] = false; i = i + 1; }

    val v: O.Option[*u8] = flag_mark_value(?marks[0], 6, ?argv[0], "-l");
    if (O.is_none[*u8](v))                                { ret 1; }
    if (!str_equals(O.unwrap[*u8](v)::str, "a"))          { ret 1; }
    if (!marks[2] || !marks[3] || !marks[4] || !marks[5]) { ret 1; }
    if (marks[0] || marks[1])                             { ret 1; }
    ret 0;
}

test "mach.cli.util.flag_reject_unknown:first_unmarked_flag" {
    var a: [4]*u8;
    a[0] = "mach"; a[1] = "build"; a[2] = "--bogus"; a[3] = ".";
    var ma: [4]bool;
    var i: usize = 0;
    for (i < 4) { ma[i] = false; i = i + 1; }
    if (!flag_reject_unknown(4, ?a[0], ?ma[0], 2, "mach build")) { ret 1; }

    ma[2] = true;
    if (flag_reject_unknown(4, ?a[0], ?ma[0], 2, "mach build")) { ret 1; }
    ret 0;
}

test "mach.cli.util.resolve_project_location:directory_and_canonical_manifest_are_one_identity" {
    var backing: A.Allocator;
    if (O.is_some[str](page.make(?backing))) { ret 1; }

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?backing, "mach_rpr_test");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);
    val dir: str = fs.temp_path(?tf);
    fs.temp_close_and_remove(?tf);

    if (O.is_some[str](fs.create_dir_all(?backing, dir, 493))) { ret 1; }

    var bad: i32 = 0;

    if (R.is_ok[ProjectLocation, str](resolve_project_location(?backing, dir))) { bad = 1; }

    val mf_r: R.Result[Path, str] = path.join(?backing, dir, PROJECT_CONFIG_NAME);
    if (R.is_err[Path, str](mf_r)) { bad = 1; }
    val mf: Path = R.unwrap_ok[Path, str](mf_r);
    if (O.is_some[str](fs.write_bytes(mf, "[project]\n", 10, 420))) { bad = 1; }

    val rr: R.Result[ProjectLocation, str] = resolve_project_location(?backing, dir);
    if (R.is_err[ProjectLocation, str](rr)) { bad = 1; }
    or {
        var loc: ProjectLocation = R.unwrap_ok[ProjectLocation, str](rr);
        if (!str_equals(loc.root, dir))         { bad = 1; }
        if (loc.root::usize == dir::usize)      { bad = 1; }
        if (!str_equals(loc.manifest, mf))      { bad = 1; }
        if (!str_equals(loc.display, dir))      { bad = 1; }
        if (loc.display::usize == dir::usize)   { bad = 1; }
        if (loc.class != OPERAND_DIRECTORY)     { bad = 1; }
        dnit_project_location(?backing, ?loc);
    }

    val rm: R.Result[ProjectLocation, str] = resolve_project_location(?backing, mf);
    if (R.is_err[ProjectLocation, str](rm)) { bad = 1; }
    or {
        var loc: ProjectLocation = R.unwrap_ok[ProjectLocation, str](rm);
        if (!str_equals(loc.root, dir))     { bad = 1; }
        if (!str_equals(loc.manifest, mf))  { bad = 1; }
        if (!str_equals(loc.display, mf))   { bad = 1; }
        if (loc.class != OPERAND_MANIFEST)  { bad = 1; }
        dnit_project_location(?backing, ?loc);
    }

    val other_r: R.Result[Path, str] = path.join(?backing, dir, "notes.txt");
    val other: Path = R.unwrap_ok[Path, str](other_r);
    if (O.is_some[str](fs.write_bytes(other, "x", 1, 420))) { bad = 1; }
    if (R.is_ok[ProjectLocation, str](resolve_project_location(?backing, other))) { bad = 1; }

    if (R.is_ok[ProjectLocation, str](resolve_project_location(?backing, "/nonexistent_mach_rpr"))) { bad = 1; }
    if (R.is_ok[ProjectLocation, str](resolve_project_location(?backing, nil)))                     { bad = 1; }

    fs.remove_all(?backing, dir);
    ret bad;
}

test "mach.cli.util.ensure_parents:creates_missing_levels" {
    var backing: A.Allocator;
    if (O.is_some[str](page.make(?backing))) { ret 1; }

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?backing, "mach_ep_test");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);
    val base: str = fs.temp_path(?tf);
    fs.temp_close_and_remove(?tf);
    if (O.is_some[str](fs.create_dir_all(?backing, base, 493))) { ret 1; }

    var bad: i32 = 0;

    val deep_r: R.Result[Path, str] = path.join(?backing, base, "a/b/c/file.txt");
    if (R.is_err[Path, str](deep_r)) { bad = 1; }
    val deep: Path = R.unwrap_ok[Path, str](deep_r);

    if (O.is_some[str](ensure_parents(?backing, deep))) { bad = 1; }
    val parent_r: R.Result[Path, str] = path.parent(?backing, deep);
    if (R.is_err[Path, str](parent_r))                          { bad = 1; }
    or (!fs.is_dir(R.unwrap_ok[Path, str](parent_r)))           { bad = 1; }
    if (O.is_some[str](ensure_parents(?backing, deep)))         { bad = 1; }

    fs.remove_all(?backing, base);
    ret bad;
}

test "mach.cli.util.resolve_cmd:refuses_a_direct_path_that_does_not_exist" {
    var backing: A.Allocator;
    if (O.is_some[str](page.make(?backing))) { ret 1; }

    val r: R.Result[str, str] = resolve_cmd(?backing, "./definitely/not/a/real-cmd");
    if (R.is_ok[str, str](r)) { ret 1; }
    ret 0;
}

test "mach.cli.util.resolve_cmd:refuses_a_direct_path_that_is_a_directory" {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    var backing: A.Allocator;
    if (O.is_some[str](page.make(?backing))) { ret 1; }

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?backing, "mach_resolve_cmd_dir");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);
    val p: str = fs.temp_path(?tf);
    fs.temp_close_and_remove(?tf);
    var bad: i32 = 0;
    if (O.is_some[str](fs.create_dir(p, 0o755))) { bad = 1; }

    val r: R.Result[str, str] = resolve_cmd(?backing, p);
    if (R.is_ok[str, str](r)) { bad = 1; }

    fs.remove_dir(p);
    ret bad;
}

test "mach.cli.util.resolve_cmd:refuses_a_direct_path_that_is_not_executable" {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    var backing: A.Allocator;
    if (O.is_some[str](page.make(?backing))) { ret 1; }

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?backing, "mach_resolve_cmd_noexec");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);
    val p: str = fs.temp_path(?tf);
    fs.temp_close_and_remove(?tf);
    var bad: i32 = 0;
    if (O.is_some[str](fs.write_bytes(p, "x"::*u8, 1::usize, 0o644))) { bad = 1; }

    val r: R.Result[str, str] = resolve_cmd(?backing, p);
    if (R.is_ok[str, str](r)) { bad = 1; }

    fs.remove_file(p);
    ret bad;
}

test "mach.cli.util.resolve_cmd:accepts_an_executable_direct_path_and_owns_the_result" {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    var backing: A.Allocator;
    if (O.is_some[str](page.make(?backing))) { ret 1; }

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?backing, "mach_resolve_cmd_exec");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);
    val p: str = fs.temp_path(?tf);
    fs.temp_close_and_remove(?tf);
    var bad: i32 = 0;
    if (O.is_some[str](fs.write_bytes(p, "#!/bin/sh\n"::*u8, 10::usize, 0o755))) { bad = 1; }

    val r: R.Result[str, str] = resolve_cmd(?backing, p);
    if (R.is_err[str, str](r)) { bad = 1; }
    or {
        val out: str = R.unwrap_ok[str, str](r);
        if (!str_equals(out, p)) { bad = 1; }
        if (out::usize == p::usize) { bad = 1; }
    }

    fs.remove_file(p);
    ret bad;
}

test "mach.cli.util.resolve_cmd_in:a_nonexecutable_earlier_directory_does_not_shadow_a_later_executable_one" {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    var backing: A.Allocator;
    if (O.is_some[str](page.make(?backing))) { ret 1; }

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?backing, "mach_resolve_cmd_shadow");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);
    val root_r: R.Result[str, str] = str_copy(?backing, fs.temp_path(?tf));
    fs.temp_close_and_remove(?tf);
    if (R.is_err[str, str](root_r)) { ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);
    var bad: i32 = 0;

    val dir1_r: R.Result[Path, str] = path.join(?backing, root, "d1");
    val dir2_r: R.Result[Path, str] = path.join(?backing, root, "d2");
    if (R.is_err[Path, str](dir1_r) || R.is_err[Path, str](dir2_r)) { ret 1; }
    val dir1: str = R.unwrap_ok[Path, str](dir1_r);
    val dir2: str = R.unwrap_ok[Path, str](dir2_r);
    if (O.is_some[str](fs.create_dir_all(?backing, dir1, 0o755))
        || O.is_some[str](fs.create_dir_all(?backing, dir2, 0o755))) { bad = 1; }

    val bad_tool_r: R.Result[Path, str] = path.join(?backing, dir1, "tool");
    val good_tool_r: R.Result[Path, str] = path.join(?backing, dir2, "tool");
    if (R.is_err[Path, str](bad_tool_r) || R.is_err[Path, str](good_tool_r)) { bad = 1; }
    val bad_tool: str = R.unwrap_ok[Path, str](bad_tool_r);
    val good_tool: str = R.unwrap_ok[Path, str](good_tool_r);
    if (O.is_some[str](fs.write_bytes(bad_tool, "x"::*u8, 1::usize, 0o644))) { bad = 1; }
    if (O.is_some[str](fs.write_bytes(good_tool, "#!/bin/sh\n"::*u8, 10::usize, 0o755))) { bad = 1; }

    val search_r: R.Result[str, str] = str_join(?backing, dir1, ":"::str, dir2);
    if (R.is_err[str, str](search_r)) { bad = 1; }
    or {
        val r: R.Result[str, str] = resolve_cmd_in(?backing, "tool"::str, R.unwrap_ok[str, str](search_r));
        if (R.is_err[str, str](r)) { bad = 1; }
        or (!str_equals(R.unwrap_ok[str, str](r), good_tool)) { bad = 1; }
    }

    fs.remove_all(?backing, root);
    ret bad;
}
