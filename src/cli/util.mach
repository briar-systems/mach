use mach.lang.fail;
use A:        std.allocator;
use io_error: std.io.error;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;

use fs: std.filesystem;
use std.types.bool.bool;
use types_path: std.types.path;
use std.types.path.Path;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;

use diagnostic_kind: mach.lang.diagnostic.kind;
use manifest_load:   mach.lang.manifest.load;

val DIR_MODE: i32 = 0o0755;

# the manifest file name, "mach.toml"

# a resolved project operand; every string is owned and freed by dnit_project_location
# ---
# root:     the project directory
# manifest: the path of its mach.toml
pub rec ProjectLocation {
    root:     Path;
    manifest: Path;
}

# free the two strings of a location; nil strings are skipped
# ---
# a:   the allocator resolve_project_location was given
# loc: the location
fun dnit_project_location(a: *A.Allocator, loc: *ProjectLocation) {
    if (loc.root != nil)     { A.deallocate[u8](a, loc.root, str_len(loc.root) + 1); }
    if (loc.manifest != nil) { A.deallocate[u8](a, loc.manifest, str_len(loc.manifest) + 1); }
}

fun resolve_directory_operand(a: *A.Allocator, arg: str) res[ProjectLocation, fail.Fail] {
    val mp_r: res[Path, A.Error] = types_path.join(a, arg, manifest_load.MANIFEST_FILE);
    if (sel mp_r.err) {
        ret res[ProjectLocation, fail.Fail].err{fail.refused(mp_r.err)};
    }
    val mp:     Path = mp_r.ok;
    var handed: bool = false;
    fin {
        if (!handed) { A.deallocate[u8](a, mp, str_len(mp) + 1); }
    }

    val is_file_r: res[bool, io_error.Error] = fs.is_file(mp);
    if (sel is_file_r.err) {
        ret res[ProjectLocation, fail.Fail].err{fail.user(diagnostic_kind.PROJECT_NO_MANIFEST, "no mach.toml in the project directory")};
    }
    if (!(is_file_r.ok)) {
        ret res[ProjectLocation, fail.Fail].err{fail.user(diagnostic_kind.PROJECT_NO_MANIFEST, "no mach.toml in the project directory")};
    }

    val root_r: res[Path, A.Error] = types_path.clone(a, arg);
    if (sel root_r.err) {
        ret res[ProjectLocation, fail.Fail].err{fail.refused(root_r.err)};
    }

    var loc: ProjectLocation;
    loc.root     = root_r.ok;
    loc.manifest = mp;
    handed       = true;
    ret res[ProjectLocation, fail.Fail].ok{loc};
}

fun resolve_manifest_operand(a: *A.Allocator, arg: str) res[ProjectLocation, fail.Fail] {
    if (!str_equals(types_path.filename(arg), manifest_load.MANIFEST_FILE)) {
        ret res[ProjectLocation, fail.Fail].err{fail.user(diagnostic_kind.PROJECT_MANIFEST_NAME, "project file must be named mach.toml")};
    }

    val root_r: res[Path, A.Error] = types_path.parent(a, arg);
    if (sel root_r.err) {
        ret res[ProjectLocation, fail.Fail].err{fail.refused(root_r.err)};
    }
    val root: Path = root_r.ok;

    val mp_r: res[Path, A.Error] = types_path.clone(a, arg);
    if (sel mp_r.err) {
        A.deallocate[u8](a, root, str_len(root) + 1);
        ret res[ProjectLocation, fail.Fail].err{fail.refused(mp_r.err)};
    }

    var loc: ProjectLocation;
    loc.root     = root;
    loc.manifest = mp_r.ok;
    ret res[ProjectLocation, fail.Fail].ok{loc};
}

# turn a project operand into a root directory and a manifest path
# a directory operand must contain mach.toml; a file operand must itself be named mach.toml,
# and its parent becomes the root
# ---
# a:   allocator for the returned strings
# arg: the operand; nil is an error asking for a path
# ret: the location, freed with dnit_project_location, or a message naming what was wrong
pub fun resolve_project_location(a: *A.Allocator, arg: str) res[ProjectLocation, fail.Fail] {
    if (arg == nil) {
        ret res[ProjectLocation, fail.Fail].err{fail.user(diagnostic_kind.CLI_OPERAND, "missing project path; pass a project directory, e.g. '.'")};
    }

    val is_dir_r: res[bool, io_error.Error] = fs.is_dir(arg);
    if ((sel is_dir_r.ok && is_dir_r.ok)) { ret resolve_directory_operand(a, arg); }
    val is_file_r: res[bool, io_error.Error] = fs.is_file(arg);
    if ((sel is_file_r.ok && is_file_r.ok)) { ret resolve_manifest_operand(a, arg); }

    ret res[ProjectLocation, fail.Fail].err{fail.user(diagnostic_kind.PROJECT_PATH_INVALID, "project path is not a directory or a mach.toml file")};
}

# create every missing ancestor of a path with mode 0755; the path itself is not created
# ---
# a:   allocator for the parent path
# p:   the path whose parents are wanted
# ret: none on success, or the parent computation or creation error
pub fun ensure_parents(a: *A.Allocator, p: str) err[fail.Fail] {
    val pr: res[Path, A.Error] = types_path.parent(a, p);
    if (sel pr.err) { ret err[fail.Fail].err{fail.refused(pr.err)}; }
    val create_dir_all_r: err[fs.FsError] = fs.create_dir_all(a, pr.ok, DIR_MODE);
    if (sel create_dir_all_r.err) { ret err[fail.Fail].err{fail.environment(diagnostic_kind.FS_CREATE, fail.fs_text(create_dir_all_r.err))}; }
    ret err[fail.Fail].ok{};
}
