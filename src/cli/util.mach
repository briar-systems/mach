use mach.lang.build.outcome;
use A:        std.allocator;
use io_error: std.io.error;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.string;

use std.allocator.arena;
use std.allocator.page;
use fs: std.filesystem;
use std.process.env;
use std.system.os;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.path;
use std.types.path.Path;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_contains_char;
use std.types.string.str_copy;
use std.types.string.str_copy_slice;
use std.types.string.str_empty;
use std.types.string.str_equals;
use std.types.string.str_join;
use std.types.string.str_len;

use mach.lang.manifest;

val DIR_MODE: i32 = 0o0755;

# the manifest file name, "mach.toml"
pub val PROJECT_CONFIG_NAME: str = manifest.MANIFEST_FILE;

# whether a flag occurs anywhere in argv
# ---
# argc: number of entries
# argv: the arguments
# flag: the exact spelling to find
# ret:  true on an exact match
pub fun flag_exists(argc: usize, argv: *str, flag: str) bool {
    var i: usize = 0;
    for (i < argc) {
        if (str_equals(argv[i], flag)) {
            ret true;
        }
        i = i + 1;
    }

    ret false;
}

# the value following the first occurrence of a flag
# ---
# argc: number of entries
# argv: the arguments
# flag: the exact spelling to find
# ret:  the argument after the first match; none when the flag is absent or is the last argument
pub fun flag_value(argc: usize, argv: *str, flag: str) opt[str] {
    var i: usize = 0;
    for (i < argc) {
        if (str_equals(argv[i], flag)) {
            if (i + 1 < argc) {
                ret opt[str].some{argv[i + 1]};
            }

            ret opt[str].none{};
        }

        i = i + 1;
    }

    ret opt[str].none{};
}

# whether an argument starts with '-'; nil is not a flag, and a lone '-' is the
# conventional name of the standard stream rather than an option
# ---
# s:   the argument
# ret: true for a leading '-' followed by anything
pub fun arg_is_flag(s: str) bool {
    ret s != nil && s[0] == '-' && s[1] != 0;
}

# the index of the first "--" at or after argv[1]
# ---
# argc: number of entries
# argv: the arguments
# ret:  the index, or argc when there is none
pub fun arg_separator_index(argc: usize, argv: *str) usize {
    var i: usize = 1;
    for (i < argc) {
        if (str_equals(argv[i], "--")) { ret i; }
        i = i + 1;
    }
    ret argc;
}

# how the project operand was given
pub def OperandClass: u8;
# a directory containing mach.toml
pub val OPERAND_DIRECTORY: OperandClass = 0;
# the path of the mach.toml itself
pub val OPERAND_MANIFEST: OperandClass = 1;

# a resolved project operand; every string is owned and freed by dnit_project_location
# ---
# root:     the project directory
# manifest: the path of its mach.toml
# display:  the operand as the user typed it
# class:    OPERAND_DIRECTORY or OPERAND_MANIFEST
pub rec ProjectLocation {
    root:     Path;
    manifest: Path;
    display:  str;
    class:    OperandClass;
}

# free the three strings of a location; nil strings are skipped
# ---
# a:   the allocator resolve_project_location was given
# loc: the location
pub fun dnit_project_location(a: *A.Allocator, loc: *ProjectLocation) {
    if (loc.root != nil)     { A.deallocate[u8](a, loc.root, str_len(loc.root) + 1); }
    if (loc.manifest != nil) { A.deallocate[u8](a, loc.manifest, str_len(loc.manifest) + 1); }
    if (loc.display != nil)  { str_free(a, loc.display); }
}

fun resolve_directory_operand(a: *A.Allocator, arg: str, display: str) res[ProjectLocation, outcome.Fail] {
    val mp_r: res[Path, A.Error] = path.join(a, arg, PROJECT_CONFIG_NAME);
    if (sel mp_r.err) {
        str_free(a, display);
        ret res[ProjectLocation, outcome.Fail].err{outcome.refused(mp_r.err)};
    }
    val mp: Path = mp_r.ok;

    val is_file_r: res[bool, io_error.Error] = fs.is_file(mp);
    if (sel is_file_r.err) {
        A.deallocate[u8](a, mp, str_len(mp) + 1);
        str_free(a, display);
        ret res[ProjectLocation, outcome.Fail].err{outcome.user("no mach.toml in the project directory")};
    }
    if (!(is_file_r.ok)) {
        A.deallocate[u8](a, mp, str_len(mp) + 1);
        str_free(a, display);
        ret res[ProjectLocation, outcome.Fail].err{outcome.user("no mach.toml in the project directory")};
    }

    val root_r: res[Path, A.Error] = path.clone(a, arg);
    if (sel root_r.err) {
        A.deallocate[u8](a, mp, str_len(mp) + 1);
        str_free(a, display);
        ret res[ProjectLocation, outcome.Fail].err{outcome.refused(root_r.err)};
    }

    var loc: ProjectLocation;
    loc.root     = root_r.ok;
    loc.manifest = mp;
    loc.display  = display;
    loc.class    = OPERAND_DIRECTORY;
    ret res[ProjectLocation, outcome.Fail].ok{loc};
}

fun resolve_manifest_operand(a: *A.Allocator, arg: str, display: str) res[ProjectLocation, outcome.Fail] {
    if (!str_equals(path.filename(arg), PROJECT_CONFIG_NAME)) {
        str_free(a, display);
        ret res[ProjectLocation, outcome.Fail].err{outcome.user("project file must be named mach.toml")};
    }

    val root_r: res[Path, A.Error] = path.parent(a, arg);
    if (sel root_r.err) {
        str_free(a, display);
        ret res[ProjectLocation, outcome.Fail].err{outcome.refused(root_r.err)};
    }
    val root: Path = root_r.ok;

    val mp_r: res[Path, A.Error] = path.clone(a, arg);
    if (sel mp_r.err) {
        A.deallocate[u8](a, root, str_len(root) + 1);
        str_free(a, display);
        ret res[ProjectLocation, outcome.Fail].err{outcome.refused(mp_r.err)};
    }

    var loc: ProjectLocation;
    loc.root     = root;
    loc.manifest = mp_r.ok;
    loc.display  = display;
    loc.class    = OPERAND_MANIFEST;
    ret res[ProjectLocation, outcome.Fail].ok{loc};
}

# turn a project operand into a root directory and a manifest path
# a directory operand must contain mach.toml; a file operand must itself be named mach.toml,
# and its parent becomes the root
# ---
# a:   allocator for the returned strings
# arg: the operand; nil is an error asking for a path
# ret: the location, freed with dnit_project_location, or a message naming what was wrong
pub fun resolve_project_location(a: *A.Allocator, arg: str) res[ProjectLocation, outcome.Fail] {
    if (arg == nil) {
        ret res[ProjectLocation, outcome.Fail].err{outcome.user("missing project path; pass a project directory, e.g. '.'")};
    }

    val display_r: res[str, string.StrError] = str_copy(a, arg);
    if (sel display_r.err) { ret res[ProjectLocation, outcome.Fail].err{outcome.internal(outcome.str_text(display_r.err))}; }
    val display: str = display_r.ok;

    val is_dir_r: res[bool, io_error.Error] = fs.is_dir(arg);
    if ((sel is_dir_r.ok && is_dir_r.ok)) { ret resolve_directory_operand(a, arg, display); }
    val is_file_r: res[bool, io_error.Error] = fs.is_file(arg);
    if ((sel is_file_r.ok && is_file_r.ok)) { ret resolve_manifest_operand(a, arg, display); }

    str_free(a, display);
    ret res[ProjectLocation, outcome.Fail].err{outcome.user("project path is not a directory or a mach.toml file")};
}

# create every missing ancestor of a path with mode 0755; the path itself is not created
# ---
# a:   allocator for the parent path
# p:   the path whose parents are wanted
# ret: none on success, or the parent computation or creation error
pub fun ensure_parents(a: *A.Allocator, p: str) err[outcome.Fail] {
    val pr: res[Path, A.Error] = path.parent(a, p);
    if (sel pr.err) { ret err[outcome.Fail].err{outcome.refused(pr.err)}; }
    val create_dir_all_r: err[fs.FsError] = fs.create_dir_all(a, pr.ok, DIR_MODE);
    if (sel create_dir_all_r.err) { ret err[outcome.Fail].err{outcome.environment(outcome.fs_text(create_dir_all_r.err))}; }
    ret err[outcome.Fail].ok{};
}

val EXEC_CAND_MAX: usize = 16;

fun is_executable(p: str) bool {
    $if ($mach.build.os == $mach.os.windows) {
        ret true;
    }
    $or {
        ret os.access(os.working_dir(), p, 1, 0) >= 0;
    }
}

fun resolve_direct(a: *A.Allocator, name: str) res[str, outcome.Fail] {
    val is_file_r: res[bool, io_error.Error] = fs.is_file(name);
    if (!(sel is_file_r.ok && is_file_r.ok)) { ret res[str, outcome.Fail].err{outcome.user("direct command path does not exist or is not a regular file")}; }
    if (!is_executable(name))                { ret res[str, outcome.Fail].err{outcome.user("direct command path is not executable")}; }
    val str_copy_r: res[str, string.StrError] = str_copy(a, name);
    if (sel str_copy_r.err) { ret res[str, outcome.Fail].err{outcome.internal(outcome.str_text(str_copy_r.err))}; }
    ret res[str, outcome.Fail].ok{str_copy_r.ok};
}

# locate an executable the way a shell would: a name with a path separator is used directly
# and must be an existing executable file; any other name is searched on PATH
# ---
# a:    allocator for the returned path
# name: the program name or path
# ret:  the resolved path, owned by the caller; "PATH unset", "not found on PATH", or the
#       direct-path error
pub fun resolve_cmd(a: *A.Allocator, name: str) res[str, outcome.Fail] {
    if (path.has_separator(name)) { ret resolve_direct(a, name); }

    val paths_r: res[opt[string.OwnedString], env.EnvError] = env.value(a, "PATH");
    if (sel paths_r.err)     { ret res[str, outcome.Fail].err{outcome.environment(outcome.env_text(paths_r.err))}; }
    if (sel paths_r.ok.none) { ret res[str, outcome.Fail].err{outcome.user("PATH unset")}; }
    var paths: string.OwnedString     = paths_r.ok.some;
    val out:   res[str, outcome.Fail] = resolve_cmd_in(a, name, paths.data);
    string.owned_release(?paths);
    ret out;
}

# locate an executable through an explicit search list
# on windows the list separator is ';' and a name without a '.' is tried with each PATHEXT
# extension (default .COM;.EXE;.BAT;.CMD); elsewhere the separator is ':' and the name is
# tried as given. a name with a path separator is used directly, as in resolve_cmd
# ---
# a:      allocator for the returned path
# name:   the program name or path
# search: the separator-joined directories; empty segments are skipped
# ret:    the first existing executable candidate, owned by the caller; "empty program name",
#         "not found on PATH", or the direct-path error
pub fun resolve_cmd_in(a: *A.Allocator, name: str, search: str) res[str, outcome.Fail] {
    if (str_empty(name))          { ret res[str, outcome.Fail].err{outcome.user("empty program name")}; }
    if (path.has_separator(name)) { ret resolve_direct(a, name); }

    var list_sep: u8 = ':';
    $if ($mach.build.os == $mach.os.windows) {
        list_sep = ';';
    }

    var cand:  [EXEC_CAND_MAX]str;
    var ncand: usize = 1;
    cand[0] = name;
    var owned_cands: bool = false;

    $if ($mach.build.os == $mach.os.windows) {
        if (!str_contains_char(name, '.')) {
            var exts:     str                                        = "";
            var own_exts: bool                                       = false;
            var from_env: opt[string.OwnedString]                    = opt[string.OwnedString].none{};
            val exts_r:   res[opt[string.OwnedString], env.EnvError] = env.value(a, "PATHEXT");
            if (sel exts_r.ok) {
                if (sel exts_r.ok.some) {
                    from_env = exts_r.ok;
                    exts     = exts_r.ok.some.data;
                }
            }
            if (str_empty(exts)) {
                val unused: opt[string.OwnedString] = from_env;
                from_env = opt[string.OwnedString].none{};
                if (sel unused.some) {
                    var released: string.OwnedString = unused.some;
                    string.owned_release(?released);
                }
                val d_r: res[str, string.StrError] = str_copy(a, ".COM;.EXE;.BAT;.CMD");
                if (sel d_r.err) { ret res[str, outcome.Fail].err{outcome.internal("out of memory")}; }
                exts     = d_r.ok;
                own_exts = true;
            }
            val elen: usize = str_len(exts);
            ncand       = 0;
            owned_cands = true;
            var e: usize = 0;
            for (e < elen && ncand < EXEC_CAND_MAX) {
                val estart: usize = e;
                for (e < elen && exts[e] != ';') { e = e + 1; }
                val eseg: usize = e - estart;
                if (e < elen) { exts[e] = 0; }
                e = e + 1;
                if (eseg == 0) { cnt; }
                val j_r: res[str, string.StrError] = str_join(a, name, (?exts[estart])::str);
                if (sel j_r.ok) {
                    cand[ncand] = j_r.ok;
                    ncand       = ncand + 1;
                }
            }
            if (own_exts)          { A.deallocate[u8](a, exts, elen + 1); }
            if (sel from_env.some) { string.owned_release(?from_env.some); }
        }
    }

    val slen:  usize = str_len(search);
    var found: str   = "";
    var i:     usize = 0;
    for (i < slen && str_empty(found)) {
        val start: usize = i;
        for (i < slen && search[i] != list_sep) { i = i + 1; }
        val seg_len: usize = i - start;
        i = i + 1;
        if (seg_len == 0) { cnt; }

        val dir_r: res[str, string.StrError] = str_copy_slice(a, search, start, seg_len);
        if (sel dir_r.err) { cnt; }
        val dir: str = dir_r.ok;

        var c: usize = 0;
        for (c < ncand) {
            val cand_r: res[Path, A.Error] = path.join(a, dir, cand[c]);
            if (sel cand_r.ok) {
                val full:      str                       = cand_r.ok;
                val is_file_r: res[bool, io_error.Error] = fs.is_file(full);
                if ((sel is_file_r.ok && is_file_r.ok) && is_executable(full)) {
                    found = full;
                    brk;
                }
                A.deallocate[u8](a, full, str_len(full) + 1);
            }
            c = c + 1;
        }
        A.deallocate[u8](a, dir, seg_len + 1);
    }

    if (owned_cands) {
        var k: usize = 0;
        for (k < ncand) {
            A.deallocate[u8](a, cand[k], str_len(cand[k]) + 1);
            k = k + 1;
        }
    }

    if (str_empty(found)) { ret res[str, outcome.Fail].err{outcome.user("not found on PATH")}; }
    ret res[str, outcome.Fail].ok{found};
}

test resolve_project_location__directory_and_canonical_manifest_are_one_identity {
    var backing: A.Allocator;
    val make_r:  err[A.Error] = page.make(?backing);
    if (sel make_r.err) { ret 1; }

    val tf_r: res[fs.TempFile, fs.FsError] = fs.temp_create(?backing, "mach_rpr_test");
    if (sel tf_r.err) { ret 1; }
    var tf:  fs.TempFile = tf_r.ok;
    val dir: str         = fs.temp_path(?tf);
    fs.temp_close_and_remove(?tf);

    val create_dir_all_r: err[fs.FsError] = fs.create_dir_all(?backing, dir, 493);
    if (sel create_dir_all_r.err) { ret 1; }

    var bad: i32 = 0;

    val resolve_project_location_r: res[ProjectLocation, outcome.Fail] = resolve_project_location(?backing, dir);
    if (sel resolve_project_location_r.ok) { bad = 1; }

    val mf_r: res[Path, A.Error] = path.join(?backing, dir, PROJECT_CONFIG_NAME);
    if (sel mf_r.err) { ret 99; }
    val mf:            Path            = mf_r.ok;
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(mf, "[project]\n", 10, 420);
    if (sel write_bytes_r.err) { bad = 1; }

    val rr: res[ProjectLocation, outcome.Fail] = resolve_project_location(?backing, dir);
    if (sel rr.err) { bad = 1; }
    if (sel rr.ok) {
        var loc: ProjectLocation = rr.ok;
        if (!str_equals(loc.root, dir))       { bad = 1; }
        if (loc.root::usize == dir::usize)    { bad = 1; }
        if (!str_equals(loc.manifest, mf))    { bad = 1; }
        if (!str_equals(loc.display, dir))    { bad = 1; }
        if (loc.display::usize == dir::usize) { bad = 1; }
        if (loc.class != OPERAND_DIRECTORY)   { bad = 1; }
        dnit_project_location(?backing, ?loc);
    }

    val rm: res[ProjectLocation, outcome.Fail] = resolve_project_location(?backing, mf);
    if (sel rm.err) { bad = 1; }
    if (sel rm.ok) {
        var loc: ProjectLocation = rm.ok;
        if (!str_equals(loc.root, dir))    { bad = 1; }
        if (!str_equals(loc.manifest, mf)) { bad = 1; }
        if (!str_equals(loc.display, mf))  { bad = 1; }
        if (loc.class != OPERAND_MANIFEST) { bad = 1; }
        dnit_project_location(?backing, ?loc);
    }

    val other_r: res[Path, A.Error] = path.join(?backing, dir, "notes.txt");
    if (sel other_r.err) { ret 99; }
    val other:          Path            = other_r.ok;
    val write_bytes_r2: err[fs.FsError] = fs.write_bytes(other, "x", 1, 420);
    if (sel write_bytes_r2.err) { bad = 1; }
    val resolve_project_location_r2: res[ProjectLocation, outcome.Fail] = resolve_project_location(?backing, other);
    if (sel resolve_project_location_r2.ok) { bad = 1; }

    val resolve_project_location_r3: res[ProjectLocation, outcome.Fail] = resolve_project_location(?backing, "/nonexistent_mach_rpr");
    if (sel resolve_project_location_r3.ok) { bad = 1; }
    val resolve_project_location_r4: res[ProjectLocation, outcome.Fail] = resolve_project_location(?backing, nil);
    if (sel resolve_project_location_r4.ok) { bad = 1; }

    fs.remove_all(?backing, dir);
    ret bad;
}

test resolve_cmd__a_direct_path_must_be_an_executable_file_and_the_result_is_owned {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    var backing: A.Allocator;
    val make_r:  err[A.Error] = page.make(?backing);
    if (sel make_r.err) { ret 1; }

    val tf_r: res[fs.TempFile, fs.FsError] = fs.temp_create(?backing, "mach_resolve_cmd_exec");
    if (sel tf_r.err) { ret 1; }
    var tf: fs.TempFile = tf_r.ok;
    val p:  str         = fs.temp_path(?tf);
    fs.temp_close_and_remove(?tf);
    var bad:           i32             = 0;
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(p, "#!/bin/sh\n"::*u8, 10::usize, 0o644);
    if (sel write_bytes_r.err) { bad = 1; }

    val missing_r: res[str, outcome.Fail] = resolve_cmd(?backing, "./definitely/not/a/real-cmd");
    if (sel missing_r.ok) { bad = 2; }

    val dir_r: res[Path, A.Error] = path.parent(?backing, p);
    if (sel dir_r.err) { ret 99; }
    val as_dir_r: res[str, outcome.Fail] = resolve_cmd(?backing, dir_r.ok);
    if (sel as_dir_r.ok) { bad = 3; }

    val noexec_r: res[str, outcome.Fail] = resolve_cmd(?backing, p);
    if (sel noexec_r.ok)                                     { bad = 4; }
    if (os.set_mode_at(os.working_dir(), p::*u8, 0o755) < 0) { bad = 5; }

    val r: res[str, outcome.Fail] = resolve_cmd(?backing, p);
    if (sel r.err) { bad = 1; }
    if (sel r.ok) {
        val out: str = r.ok;
        if (!str_equals(out, p))    { bad = 1; }
        if (out::usize == p::usize) { bad = 1; }
    }

    fs.remove_file(p);
    ret bad;
}

test resolve_cmd_in__a_nonexecutable_earlier_directory_does_not_shadow_a_later_executable_one {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    var backing: A.Allocator;
    val make_r:  err[A.Error] = page.make(?backing);
    if (sel make_r.err) { ret 1; }

    val tf_r: res[fs.TempFile, fs.FsError] = fs.temp_create(?backing, "mach_resolve_cmd_shadow");
    if (sel tf_r.err) { ret 1; }
    var tf:     fs.TempFile               = tf_r.ok;
    val root_r: res[str, string.StrError] = str_copy(?backing, fs.temp_path(?tf));
    fs.temp_close_and_remove(?tf);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    var bad:  i32 = 0;

    val dir1_r: res[Path, A.Error] = path.join(?backing, root, "d1");
    val dir2_r: res[Path, A.Error] = path.join(?backing, root, "d2");
    if (sel dir1_r.err) { ret 1; }
    if (sel dir2_r.err) { ret 1; }
    val dir1:              str             = dir1_r.ok;
    val dir2:              str             = dir2_r.ok;
    val create_dir_all_r2: err[fs.FsError] = fs.create_dir_all(?backing, dir1, 0o755);
    val create_dir_all_r:  err[fs.FsError] = fs.create_dir_all(?backing, dir2, 0o755);
    if (sel create_dir_all_r2.err
        || sel create_dir_all_r.err) { bad = 1; }

    val bad_tool_r:  res[Path, A.Error] = path.join(?backing, dir1, "tool");
    val good_tool_r: res[Path, A.Error] = path.join(?backing, dir2, "tool");
    if (sel bad_tool_r.err)  { ret 99; }
    if (sel good_tool_r.err) { ret 99; }
    val bad_tool:      str             = bad_tool_r.ok;
    val good_tool:     str             = good_tool_r.ok;
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(bad_tool, "x"::*u8, 1::usize, 0o644);
    if (sel write_bytes_r.err) { bad = 1; }
    val write_bytes_r2: err[fs.FsError] = fs.write_bytes(good_tool, "#!/bin/sh\n"::*u8, 10::usize, 0o755);
    if (sel write_bytes_r2.err) { bad = 1; }

    val search_r: res[str, string.StrError] = str_join(?backing, dir1, ":"::str, dir2);
    if (sel search_r.err) { bad = 1; }
    if (sel search_r.ok) {
        val r: res[str, outcome.Fail] = resolve_cmd_in(?backing, "tool"::str, search_r.ok);
        if (!(sel r.ok && str_equals(r.ok, good_tool))) { bad = 1; }
    }

    fs.remove_all(?backing, root);
    ret bad;
}
