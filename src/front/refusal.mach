# a module refused by a module-scope `$error`. a module in which one fires is refused and
# reports each that fired and nothing else, and a module that imports a refused module,
# directly or through others, is not analysed and reports nothing
use mach.base.fail;
use A:                  std.allocator;
use collections_vector: std.collections.vector;
use std.types.bool.bool;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

pub def State: u8;

pub val NONE: State = 0;
# a module-scope `$error` fired in the module
pub val OWN: State = 1;
# a module it imports is refused
pub val IMPORTED: State = 2;

# why a module is refused, if it is
# ---
# state: NONE, OWN or IMPORTED
# sites: where each module-scope `$error` that fired begins in the module's file, for OWN
pub rec Refusal {
    state: State;
    sites: collections_vector.Vector[u32];
}

# an unrefused module's state, with an empty site list
# ---
# a:   allocator the site list grows from
# ret: a refusal in state NONE, released with `dnit`
pub fun init(a: *A.Allocator) Refusal {
    ret Refusal{state: NONE, sites: collections_vector.init[u32](a)};
}

# free the site list and return the state to NONE
# ---
# r: refusal to release
pub fun dnit(r: *Refusal) {
    collections_vector.dnit[u32](?r.sites);
    r.state = NONE;
}

# whether the module is refused for any reason
# ---
# r:   refusal to test
# ret: true when the state is OWN or IMPORTED
pub fun is_refused(r: *Refusal) bool {
    ret r.state != NONE;
}

# a module-scope `$error` that fired at `offset`
pub fun fired(r: *Refusal, offset: usize) err[fail.Fail] {
    r.state = OWN;
    val res_pushed: res[usize, A.Error] = collections_vector.push[u32](?r.sites, offset::u32);
    if (sel res_pushed.err) { ret err[fail.Fail].err{fail.refused(res_pushed.err)}; }
    ret err[fail.Fail].ok{};
}

# an owned copy of `from`, from `a`
pub fun copy(from: *Refusal, a: *A.Allocator) res[Refusal, fail.Fail] {
    var out: Refusal = init(a);
    out.state = from.state;
    var i: usize = 0;
    for (i < from.sites.len) {
        val res_pushed: res[usize, A.Error] = collections_vector.push[u32](?out.sites, from.sites.data[i]);
        if (sel res_pushed.err) {
            dnit(?out);
            ret res[Refusal, fail.Fail].err{fail.refused(res_pushed.err)};
        }
        i = i + 1;
    }
    ret res[Refusal, fail.Fail].ok{out};
}
