# the declaration nodes of the syntax tree, with typed names, tag cases and decorators

use std.types.bool.bool;

use base_source: mach.base.source;
use ast_id:      mach.front.ast.id;

pub def DeclKind: u8;

pub val DECL_KIND_USE:                DeclKind = 0;
pub val DECL_KIND_FWD:                DeclKind = 1;
pub val DECL_KIND_FUN:                DeclKind = 2;
pub val DECL_KIND_REC:                DeclKind = 3;
pub val DECL_KIND_VAL:                DeclKind = 4;
pub val DECL_KIND_VAR:                DeclKind = 5;
pub val DECL_KIND_DEF:                DeclKind = 6;
pub val DECL_KIND_TEST:               DeclKind = 7;
pub val DECL_KIND_COMPTIME_IF:        DeclKind = 8;
pub val DECL_KIND_COMPTIME_DIRECTIVE: DeclKind = 9;
pub val DECL_KIND_UNI:                DeclKind = 10;
pub val DECL_KIND_TAG:                DeclKind = 11;
pub val DECL_KIND_ERROR:              DeclKind = 255;

pub val DECL_FLAG_PUB: u8 = 1;
pub val DECL_FLAG_EXT: u8 = 2;

# a name with its type syntax: one parameter or one field
# ---
# name:     the span of the name
# ty:       its type syntax
# comptime: whether a parameter is written `$name`, so its argument is a comptime value
pub rec TypedName {
    name:     base_source.Span;
    ty:       ast_id.TypeId;
    comptime: bool;
}

# a `use` import
# ---
# alias: the span of the written alias, empty when none is written
# path:  the span of the imported path
pub rec DeclUse {
    alias: base_source.Span;
    path:  base_source.Span;
}

# a `fwd` re-export
# ---
# alias: the span of the written alias, empty when none is written
# path:  the span of the re-exported path
pub rec DeclFwd {
    alias: base_source.Span;
    path:  base_source.Span;
}

# a `fun` or `ext fun` declaration
# ---
# name:           the span of the function name
# generics_start: first generic parameter in the generic name table
# generics_len:   how many generic parameters
# params_start:   first parameter in the typed name table
# params_len:     how many parameters
# return_type:    the return type syntax, TYPE_NIL when none is written
# body:           the body block, STMT_NIL for a declaration with no body
# c_variadic:     whether an `ext fun` ends in a C `...`
pub rec DeclFun {
    name:           base_source.Span;
    generics_start: u32;
    generics_len:   u32;
    params_start:   u32;
    params_len:     u32;
    return_type:    ast_id.TypeId;
    body:           ast_id.StmtId;
    c_variadic:     bool;
}

# a `rec` declaration
# ---
# name:           the span of the record name
# generics_start: first generic parameter in the generic name table
# generics_len:   how many generic parameters
# fields_start:   first field in the typed name table
# fields_len:     how many fields
pub rec DeclRec {
    name:           base_source.Span;
    generics_start: u32;
    generics_len:   u32;
    fields_start:   u32;
    fields_len:     u32;
}

# a `uni` declaration
# ---
# name:           the span of the union name
# generics_start: first generic parameter in the generic name table
# generics_len:   how many generic parameters
# fields_start:   first field in the typed name table
# fields_len:     how many fields
pub rec DeclUni {
    name:           base_source.Span;
    generics_start: u32;
    generics_len:   u32;
    fields_start:   u32;
    fields_len:     u32;
}

# one case of a `tag`
# ---
# name:             the span of the case name
# payload:          the payload type syntax, TYPE_NIL for a case with none
# decorators_start: first decorator on the case in the decorator table
# decorators_len:   how many decorators
pub rec TagCase {
    name:             base_source.Span;
    payload:          ast_id.TypeId;
    decorators_start: u32;
    decorators_len:   u32;
}

# a `tag` declaration
# ---
# name:           the span of the tag name
# generics_start: first generic parameter in the generic name table
# generics_len:   how many generic parameters
# cases_start:    first case in the tag case table
# cases_len:      how many cases
# disc:           the discriminator type syntax
pub rec DeclTag {
    name:           base_source.Span;
    generics_start: u32;
    generics_len:   u32;
    cases_start:    u32;
    cases_len:      u32;
    disc:           ast_id.TypeId;
}

# a `val` or `var` binding, top-level or local
# ---
# name: the span of the bound name
# ty:   its type syntax
# init: the initializer, EXPR_NIL when none is written
pub rec DeclBind {
    name: base_source.Span;
    ty:   ast_id.TypeId;
    init: ast_id.ExprId;
}

# a `def` type alias
# ---
# name: the span of the alias name
# ty:   the aliased type syntax
pub rec DeclDef {
    name: base_source.Span;
    ty:   ast_id.TypeId;
}

# a `test` declaration
# ---
# name: the span of the test name
# body: the body block
pub rec DeclTest {
    name: base_source.Span;
    body: ast_id.StmtId;
}

# one arm of a `$if` chain, shared by declaration and statement chains
# ---
# cond:       the condition, EXPR_NIL for a bare `$or`
# body_start: first body item, in the declaration id table for a declaration chain and the statement id table for a statement chain
# body_len:   how many body items
pub rec ComptimeBranch {
    cond:       ast_id.ExprId;
    body_start: u32;
    body_len:   u32;
}

# a top-level `$if` chain
# ---
# branches_start: first arm in the comptime branch table
# branches_len:   how many arms
pub rec DeclComptimeIf {
    branches_start: u32;
    branches_len:   u32;
}

# a top-level comptime directive statement such as `$error(...)`
# ---
# target: the directive expression
pub rec DeclComptimeDirective {
    target: ast_id.ExprId;
}

# `#[name(args)]`, all of which `span` covers; `id` is the decorator registry's id the
# name spells, decoded once by the parser, and 0 when it spells none
pub rec Decorator {
    span:       base_source.Span;
    name:       base_source.Span;
    id:         u8;
    args_start: u32;
    args_len:   u32;
}

# one declaration node
# ---
# span:             the whole declaration
# kind:             which DECL_KIND_ the declaration is, which names the active `data` field
# flags:            DECL_FLAG_PUB and DECL_FLAG_EXT bits
# doc:              the docstring above the declaration, empty when there is none
# decorators_start: first decorator in the decorator table
# decorators_len:   how many decorators
# data:             the payload of the declaration's kind
pub rec Decl {
    span:             base_source.Span;
    kind:             DeclKind;
    flags:            u8;
    doc:              base_source.Span;
    decorators_start: u32;
    decorators_len:   u32;
    data:             uni {
        use_: DeclUse;
        fwd_: DeclFwd;
        fun_: DeclFun;
        rec_: DeclRec;
        uni_: DeclUni;
        tag_: DeclTag;
        bind: DeclBind;
        def_: DeclDef;
        test_: DeclTest;
        comptime_if: DeclComptimeIf;
        comptime_directive: DeclComptimeDirective;
    };
}
