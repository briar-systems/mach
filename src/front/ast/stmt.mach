# the statement nodes of the syntax tree

use base_source: mach.base.source;
use ast_id:      mach.front.ast.id;

pub def StmtKind: u8;

pub val STMT_KIND_EXPR:               StmtKind = 0;
pub val STMT_KIND_BLOCK:              StmtKind = 1;
pub val STMT_KIND_IF:                 StmtKind = 2;
pub val STMT_KIND_FOR:                StmtKind = 3;
pub val STMT_KIND_RET:                StmtKind = 4;
pub val STMT_KIND_BRK:                StmtKind = 5;
pub val STMT_KIND_CNT:                StmtKind = 6;
pub val STMT_KIND_FIN:                StmtKind = 7;
pub val STMT_KIND_DECL:               StmtKind = 8;
pub val STMT_KIND_ASM:                StmtKind = 9;
pub val STMT_KIND_COMPTIME_IF:        StmtKind = 10;
pub val STMT_KIND_COMPTIME_EACH:      StmtKind = 11;
pub val STMT_KIND_COMPTIME_DIRECTIVE: StmtKind = 12;
pub val STMT_KIND_ERROR:              StmtKind = 255;

# an expression statement
# ---
# expr: the expression
pub rec StmtExpr {
    expr: ast_id.ExprId;
}

# a braced block
# ---
# stmts_start: first statement in the statement id table
# stmts_len:   how many statements
pub rec StmtBlock {
    stmts_start: u32;
    stmts_len:   u32;
}

# an `if` or an `or (cond)` arm
# ---
# cond:       the condition
# then_block: the arm's block, STMT_NIL when the parse found none
# else_block: the next `or (cond)` arm as an if statement, a block for a bare `or`, STMT_NIL when the chain ends
pub rec StmtIf {
    cond:       ast_id.ExprId;
    then_block: ast_id.StmtId;
    else_block: ast_id.StmtId;
}

# a `for` loop
# ---
# cond: the condition, EXPR_NIL for a bare `for`
# body: the body block
pub rec StmtFor {
    cond: ast_id.ExprId;
    body: ast_id.StmtId;
}

# a `ret` statement
# ---
# value: the returned value, EXPR_NIL for a bare `ret`
pub rec StmtRet {
    value: ast_id.ExprId;
}

# a `fin` cleanup
# ---
# body: the cleanup block
pub rec StmtFin {
    body: ast_id.StmtId;
}

# a local `val` or `var`
# ---
# decl: the declaration node of the binding
pub rec StmtDecl {
    decl: ast_id.DeclId;
}

# head: the text between `asm` and the body's `{`, masc's selection handed over unchanged
pub rec StmtAsm {
    head: base_source.Span;
    body: base_source.Span;
}

# a `$if` chain inside a function body
# ---
# branches_start: first arm in the comptime branch table
# branches_len:   how many arms
pub rec StmtComptimeIf {
    branches_start: u32;
    branches_len:   u32;
}

# a `$each` loop
# ---
# var_name:   the span of the loop variable
# seq:        the sequence expression it walks
# body_start: first body statement in the statement id table
# body_len:   how many body statements
pub rec StmtComptimeEach {
    var_name:   base_source.Span;
    seq:        ast_id.ExprId;
    body_start: u32;
    body_len:   u32;
}

# a comptime directive statement such as `$error(...)`
# ---
# target: the directive expression
pub rec StmtComptimeDirective {
    target: ast_id.ExprId;
}

# one statement node
# ---
# span: the whole statement
# kind: which STMT_KIND_ the statement is, which names the active `data` field
# data: the payload of the statement's kind
pub rec Stmt {
    span: base_source.Span;
    kind: StmtKind;
    data: uni {
        expr: StmtExpr;
        block: StmtBlock;
        if_: StmtIf;
        for_: StmtFor;
        ret_: StmtRet;
        fin_: StmtFin;
        decl: StmtDecl;
        asm_: StmtAsm;
        comptime_if: StmtComptimeIf;
        comptime_each: StmtComptimeEach;
        comptime_directive: StmtComptimeDirective;
    };
}
