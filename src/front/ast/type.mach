# the type-syntax nodes of the syntax tree: types as they are written, before they resolve

use std.types.bool.bool;

use base_source: mach.base.source;
use ast_id:      mach.front.ast.id;

pub def TypeKind: u8;

pub val TYPE_KIND_NAMED:           TypeKind = 0;
pub val TYPE_KIND_PTR:             TypeKind = 1;
pub val TYPE_KIND_ARRAY:           TypeKind = 2;
pub val TYPE_KIND_FUN:             TypeKind = 3;
pub val TYPE_KIND_REC:             TypeKind = 4;
pub val TYPE_KIND_UNI:             TypeKind = 5;
pub val TYPE_KIND_PACK:            TypeKind = 6;
pub val TYPE_KIND_SECRET:          TypeKind = 7;
pub val TYPE_KIND_FIELD_TYPE:      TypeKind = 8;
pub val TYPE_KIND_POINTEE_OF:      TypeKind = 9;
pub val TYPE_KIND_DISCRIMINANT_OF: TypeKind = 10;
pub val TYPE_KIND_ERROR:           TypeKind = 255;

# a named type, with its generic arguments
# ---
# name:       the span of the dotted path
# args_start: first generic argument in the type id table
# args_len:   how many generic arguments
# operand:    whether the type stands as a type operand of a call, such as the argument of `$size_of`
pub rec TypeNamed {
    name:       base_source.Span;
    args_start: u32;
    args_len:   u32;
    operand:    bool;
    # in a literal head after generic arguments, `T[A].c{...}`, the tag case written; length zero
    # otherwise. a bare `T.c` keeps its whole path in `name`, and name resolution's head
    # interpretation reads it as type and case
    case_name: base_source.Span;
    # in a literal head `T.[c]{...}`, the comptime case descriptor; EXPR_NIL otherwise
    case_desc: ast_id.ExprId;
    # where the tree's path names hold the id of each segment of `name`, in order
    segments: u32;
}

# a pointer type `*T`
# ---
# pointee: the pointed-to type syntax
pub rec TypePtr {
    pointee: ast_id.TypeId;
}

# a secret type `^T`
# ---
# inner: the qualified type syntax
pub rec TypeSecret {
    inner: ast_id.TypeId;
}

# an array type `[N]T`
# ---
# length:  the length expression, EXPR_NIL for `[_]`
# element: the element type syntax
pub rec TypeArray {
    length:  ast_id.ExprId;
    element: ast_id.TypeId;
}

# a function type
# ---
# params_start: first parameter in the typed name table
# params_len:   how many parameters
# ret_type:     the return type syntax, TYPE_NIL when none is written
# c_variadic:   whether the parameter list ends in a C `...`
pub rec TypeFun {
    params_start: u32;
    params_len:   u32;
    ret_type:     ast_id.TypeId;
    c_variadic:   bool;
}

# an anonymous `rec { ... }` type
# ---
# fields_start: first field in the typed name table
# fields_len:   how many fields
pub rec TypeRec {
    fields_start: u32;
    fields_len:   u32;
}

# an anonymous `uni { ... }` type
# ---
# fields_start: first field in the typed name table
# fields_len:   how many fields
pub rec TypeUni {
    fields_start: u32;
    fields_len:   u32;
}

# the type of a comptime field descriptor, written `f.type`
# ---
# var_name: the span of the descriptor variable
pub rec TypeFieldType {
    var_name: base_source.Span;
}

# `$pointee_of(T)`, the type a typed reference refers to
# ---
# inner: the reference type syntax
pub rec TypePointeeOf {
    inner: ast_id.TypeId;
}

# `$discriminant_of(T)`, a tag's discriminator type
# ---
# inner: the tag type syntax
pub rec TypeDiscriminantOf {
    inner: ast_id.TypeId;
}

# one type-syntax node
# ---
# span: the whole type as written
# kind: which TYPE_KIND_ the node is, which names the active `data` field
# data: the payload of the node's kind
pub rec Type {
    span: base_source.Span;
    kind: TypeKind;
    data: uni {
        named: TypeNamed;
        ptr: TypePtr;
        secret: TypeSecret;
        array: TypeArray;
        fun_: TypeFun;
        rec_: TypeRec;
        uni_: TypeUni;
        field_type: TypeFieldType;
        pointee_of: TypePointeeOf;
        discriminant_of: TypeDiscriminantOf;
    };
}
