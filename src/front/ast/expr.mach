# the expression nodes of the syntax tree and the operators they carry

use std.types.bool.bool;

use mach.base.intern;
use base_source: mach.base.source;
use mach.base.wide;
use ast_id:    mach.front.ast.id;
use type_kind: mach.type.kind;

pub def ExprKind: u8;

pub val EXPR_KIND_IDENT:            ExprKind = 0;
pub val EXPR_KIND_LIT_INT:          ExprKind = 1;
pub val EXPR_KIND_LIT_FLOAT:        ExprKind = 2;
pub val EXPR_KIND_LIT_CHAR:         ExprKind = 3;
pub val EXPR_KIND_LIT_STR:          ExprKind = 4;
pub val EXPR_KIND_LIT_NIL:          ExprKind = 6;
pub val EXPR_KIND_BINARY:           ExprKind = 7;
pub val EXPR_KIND_UNARY:            ExprKind = 8;
pub val EXPR_KIND_CALL:             ExprKind = 9;
pub val EXPR_KIND_INDEX:            ExprKind = 10;
pub val EXPR_KIND_MEMBER:           ExprKind = 11;
pub val EXPR_KIND_CAST:             ExprKind = 12;
pub val EXPR_KIND_ARRAY_LIT:        ExprKind = 13;
pub val EXPR_KIND_STRUCT_LIT:       ExprKind = 14;
pub val EXPR_KIND_COMPTIME_IDENT:   ExprKind = 15;
pub val EXPR_KIND_PROJECT:          ExprKind = 16;
pub val EXPR_KIND_SPREAD:           ExprKind = 17;
pub val EXPR_KIND_STRIP:            ExprKind = 18;
pub val EXPR_KIND_VECTOR_LIT:       ExprKind = 19;
pub val EXPR_KIND_TYPE_REF:         ExprKind = 20;
pub val EXPR_KIND_GENERIC_INSTANCE: ExprKind = 21;
pub val EXPR_KIND_SEL:              ExprKind = 23;
pub val EXPR_KIND_ERROR:            ExprKind = 255;

pub def BinOp: u8;

pub val BIN_ADD:     BinOp = 0;
pub val BIN_SUB:     BinOp = 1;
pub val BIN_MUL:     BinOp = 2;
pub val BIN_DIV:     BinOp = 3;
pub val BIN_MOD:     BinOp = 4;
pub val BIN_EQ:      BinOp = 5;
pub val BIN_NEQ:     BinOp = 6;
pub val BIN_LT:      BinOp = 7;
pub val BIN_LEQ:     BinOp = 8;
pub val BIN_GT:      BinOp = 9;
pub val BIN_GEQ:     BinOp = 10;
pub val BIN_AND:     BinOp = 11;
pub val BIN_OR:      BinOp = 12;
pub val BIN_BIT_AND: BinOp = 13;
pub val BIN_BIT_OR:  BinOp = 14;
pub val BIN_BIT_XOR: BinOp = 15;
pub val BIN_SHL:     BinOp = 16;
pub val BIN_SHR:     BinOp = 17;
pub val BIN_ASSIGN:  BinOp = 18;

pub def UnOp: u8;

pub val UN_NEG:     UnOp = 0;
pub val UN_NOT:     UnOp = 1;
pub val UN_BIT_NOT: UnOp = 2;
pub val UN_ADDR:    UnOp = 3;
pub val UN_DEREF:   UnOp = 4;

pub val LIT_SUFFIX_NONE: type_kind.TypeKind = 0xFF;

# an identifier, or a `$name` comptime identifier whose `tok` covers the `$` and the name.
# `name` is the identifier as the parse interned it, STR_NIL for a comptime identifier
rec ExprIdent {
    tok:  base_source.Span;
    name: intern.StrId;
}

rec ExprLitInt {
    value:  wide.Wide;
    suffix: type_kind.TypeKind;
    tok:    base_source.Span;
}

rec ExprLitFloat {
    value:  f64;
    suffix: type_kind.TypeKind;
    tok:    base_source.Span;
}

rec ExprLitChar {
    value: u32;
    tok:   base_source.Span;
}

# a run of bytes in the tree's literal byte table
pub rec ByteRange {
    start: u32;
    len:   u32;
}

# a string literal: `tok` covers the quotes
rec ExprLitStr {
    tok:   base_source.Span;
    value: ByteRange;
}

rec ExprLitNil {
    tok: base_source.Span;
}

# a binary operation, assignment included
# ---
# op:  the BIN_ operator
# lhs: the left operand
# rhs: the right operand
pub rec ExprBinary {
    op:  BinOp;
    lhs: ast_id.ExprId;
    rhs: ast_id.ExprId;
}

# a unary operation
# ---
# op:      the UN_ operator
# operand: the operand
pub rec ExprUnary {
    op:      UnOp;
    operand: ast_id.ExprId;
}

# a call, or a generic instance `f[T]` with no argument list
# the parser keeps the reading of the bracket as an index beside its reading as generic
# arguments, and name resolution picks one (interpretation.get)
# ---
# callee:          the called expression
# args_start:      first argument in the expression id table
# args_len:        how many arguments
# type_args_start: first generic argument in the type id table
# type_args_len:   how many generic arguments
# index_callee:    the bracket read as an index expression, EXPR_NIL when there is no bracket or it
#                  cannot be read as one
pub rec ExprCall {
    callee:          ast_id.ExprId;
    args_start:      u32;
    args_len:        u32;
    type_args_start: u32;
    type_args_len:   u32;
    index_callee:    ast_id.ExprId;
}

# `x[i]` reads one element; `x[i, n]` is a range of `n` elements from `i`, and
# `count` is EXPR_NIL for the single element
pub rec ExprIndex {
    object: ast_id.ExprId;
    index:  ast_id.ExprId;
    count:  ast_id.ExprId;
}

# whether an index expression is a range `x[i, n]`
# ---
# ix:  the index expression
# ret: true when it carries a count
pub fun is_range(ix: *ExprIndex) bool {
    ret !ast_id.expr_is_nil(ix.count);
}

# `name_id` is `name` as the parse interned it, STR_NIL for a member with no name
pub rec ExprMember {
    object:  ast_id.ExprId;
    name:    base_source.Span;
    name_id: intern.StrId;
}

# a comptime field projection `x.[f]`
# ---
# object: the projected value
# field:  the comptime field descriptor
pub rec ExprProject {
    object: ast_id.ExprId;
    field:  ast_id.ExprId;
}

# a pack spread `va...`
# ---
# inner: the spread pack
pub rec ExprSpread {
    inner: ast_id.ExprId;
}

# a cast `x::T` or `x:~T`
# ---
# value:       the cast operand
# ty:          the target type syntax
# reinterpret: true for a `:~` bit reinterpretation, false for a `::` value conversion
pub rec ExprCast {
    value:       ast_id.ExprId;
    ty:          ast_id.TypeId;
    reinterpret: bool;
}

# a secret downgrade `x:>T`
# ---
# value: the operand
# ty:    the public target type syntax
pub rec ExprStrip {
    value: ast_id.ExprId;
    ty:    ast_id.TypeId;
}

# an array literal `[N]T{a, b}`
# ---
# ty:          the array type syntax
# elems_start: first element in the expression id table
# elems_len:   how many elements
pub rec ExprArrayLit {
    ty:          ast_id.TypeId;
    elems_start: u32;
    elems_len:   u32;
}

pub val INIT_NAMED:      u8 = 0;
pub val INIT_BARE:       u8 = 1;
pub val INIT_POSITIONAL: u8 = 2;

# `name_id` is `name` as the parse interned it, STR_NIL for a positional element
pub rec FieldInit {
    form:    u8;
    name:    base_source.Span;
    name_id: intern.StrId;
    value:   ast_id.ExprId;
}

# a typed literal `T{...}` with named or bare fields, or no fields
# ---
# elems_start:  first element value in the expression id table, one per field init in order
# elems_len:    how many element values
# ty:           the head type syntax
# fields_start: first field init in the field init table
# fields_len:   how many field inits
pub rec ExprStructLit {
    elems_start:  u32;
    elems_len:    u32;
    ty:           ast_id.TypeId;
    fields_start: u32;
    fields_len:   u32;
}

# a typed literal with only positional elements, `T{a, b}`: a vector's lanes as written, or a tag
# case's payload when name resolution finds the head names a case (interpretation.CASE_LITERAL)
pub rec ExprVectorLit {
    ty:          ast_id.TypeId;
    elems_start: u32;
    elems_len:   u32;
}

# a type written where an expression stands
# ---
# ty: the type syntax
pub rec ExprTypeRef {
    ty: ast_id.TypeId;
}

# a `sel place.case` test of whether a tag place holds the named case
# ---
# place:     the tag place tested
# case_name: the case as written, an empty span at the place for `sel place.[c]`
# case_id:   `case_name` as the parse interned it, STR_NIL for an unnamed case
# case_desc: `sel place.[c]`: the comptime case descriptor, EXPR_NIL when the case is named
pub rec ExprSel {
    place:     ast_id.ExprId;
    case_name: base_source.Span;
    case_id:   intern.StrId;
    case_desc: ast_id.ExprId;
}

# `span` is the node's visual extent, grouping parentheses included. a token-backed node (a name
# or a literal) keeps its token in its payload's `tok`, and its text is read through `tok`, never
# through `span`
pub rec Expr {
    span: base_source.Span;
    kind: ExprKind;
    data: uni {
        ident: ExprIdent;
        comptime_ident: ExprIdent;
        lit_int: ExprLitInt;
        lit_float: ExprLitFloat;
        lit_char: ExprLitChar;
        lit_str: ExprLitStr;
        lit_nil: ExprLitNil;
        binary: ExprBinary;
        unary: ExprUnary;
        call: ExprCall;
        index: ExprIndex;
        member: ExprMember;
        cast: ExprCast;
        strip: ExprStrip;
        array_lit: ExprArrayLit;
        struct_lit: ExprStructLit;
        vector_lit: ExprVectorLit;
        project: ExprProject;
        spread: ExprSpread;
        type_ref: ExprTypeRef;
        sel: ExprSel;
    };
}
