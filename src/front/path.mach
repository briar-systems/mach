# dotted paths read from the source, with the trivia between their segments skipped
#
# a path keeps the comments and whitespace it was written with, so its segments, its last
# segment and its prefix are found by walking its span, and `intern_path` interns it with its
# segments joined by single dots.

use mach.base.intern;
use base_source: mach.base.source;
use A:           std.allocator;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

# paths are parser accepted identifier and dot sequences with original trivia intact
pub fun next(source: str, path: base_source.Span, cursor: *usize) base_source.Span {
    val end: usize = path.offset + path.len;
    var pos: usize = @cursor;
    for (pos < end) {
        val c: u8 = source[pos];
        if (c == '#') {
            for (pos < end && source[pos] != '\n' && source[pos] != '\r') { pos = pos + 1; }
        }
        or (c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '.') { pos = pos + 1; }
        or                                                               { brk; }
    }
    val start: usize = pos;
    for (pos < end) {
        val c: u8 = source[pos];
        if (c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '.' || c == '#') { brk; }
        pos = pos + 1;
    }
    @cursor = pos;
    ret base_source.Span{offset: start, len: pos - start};
}

# the last segment of a dotted path
# ---
# source: text the path is read from
# path:   span of the whole path
# ret:    span of the last segment, empty at the path's start when it has none
pub fun leaf(source: str, path: base_source.Span) base_source.Span {
    var cursor: usize            = path.offset;
    var found:  base_source.Span = base_source.Span{offset: path.offset, len: 0};
    for (cursor < path.offset + path.len) {
        val segment: base_source.Span = next(source, path, ?cursor);
        if (segment.len == 0) { brk; }
        found = segment;
    }
    ret found;
}

# the path up to the end of its second to last segment, trivia included
# ---
# source: text the path is read from
# path:   span of the whole path
# ret:    span from the path's start to the end of the second to last segment, empty for a one segment path
pub fun prefix(source: str, path: base_source.Span) base_source.Span {
    var cursor:   usize            = path.offset;
    var previous: base_source.Span = base_source.Span{offset: path.offset, len: 0};
    var found:    base_source.Span = previous;
    for (cursor < path.offset + path.len) {
        val segment: base_source.Span = next(source, path, ?cursor);
        if (segment.len == 0) { brk; }
        found.len = previous.offset + previous.len - path.offset;
        previous  = segment;
    }
    ret found;
}

# intern a dotted path with its trivia dropped and its segments joined by single dots
# ---
# itn:    interner to add the text to, whose allocator holds the scratch copy
# source: text the path is read from
# path:   span of the whole path
# ret:    the interned id, or the allocator's error
pub fun intern_path(itn: *intern.Interner, source: str, path: base_source.Span) res[intern.StrId, A.Error] {
    val length: usize = joined_len(source, path);
    if (length == 0 || length == path.len) { ret intern.range_add(itn, source, path.offset, path.len); }
    val res_allocated: res[*u8, A.Error] = A.allocate[u8](itn.a, length);
    if (sel res_allocated.err) { ret res[intern.StrId, A.Error].err{res_allocated.err}; }
    val bytes: *u8 = res_allocated.ok;
    fin { A.deallocate[u8](itn.a, bytes, length); }
    joined_write(source, path, bytes);
    ret intern.bytes_add(itn, bytes, length);
}

# the text `intern_path` interns, from `a` and terminated, without interning it
pub fun path_text(a: *A.Allocator, source: str, path: base_source.Span) res[str, A.Error] {
    val length:        usize             = joined_len(source, path);
    val res_allocated: res[*u8, A.Error] = A.allocate[u8](a, length + 1);
    if (sel res_allocated.err) { ret res[str, A.Error].err{res_allocated.err}; }
    val bytes: *u8 = res_allocated.ok;
    if (length == 0 || length == path.len) {
        var i: usize = 0;
        for (i < path.len) {
            bytes[i] = source[path.offset + i];
            i        = i + 1;
        }
        bytes[path.len] = 0;
        ret res[str, A.Error].ok{bytes::str};
    }
    joined_write(source, path, bytes);
    bytes[length] = 0;
    ret res[str, A.Error].ok{bytes::str};
}

# the length of the path's segments joined by single dots
fun joined_len(source: str, path: base_source.Span) usize {
    var cursor: usize = path.offset;
    var length: usize = 0;
    for (cursor < path.offset + path.len) {
        val segment: base_source.Span = next(source, path, ?cursor);
        if (segment.len == 0) { brk; }
        if (length != 0)      { length = length + 1; }
        length = length + segment.len;
    }
    ret length;
}

# the path's segments joined by single dots, written to `bytes`
fun joined_write(source: str, path: base_source.Span, bytes: *u8) {
    var cursor:  usize = path.offset;
    var written: usize = 0;
    for (cursor < path.offset + path.len) {
        val segment: base_source.Span = next(source, path, ?cursor);
        if (segment.len == 0) { brk; }
        if (written != 0) {
            bytes[written] = '.';
            written        = written + 1;
        }
        var b: usize = 0;
        for (b < segment.len) {
            bytes[written] = source[segment.offset + b];
            written        = written + 1;
            b              = b + 1;
        }
    }
}
