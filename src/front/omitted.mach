# the names a build leaves out: each name a module-scope `$if` branch the build does not select
# declares, with the condition that left it out
#
# name resolution records them as it discards a branch, from the syntax the parser already
# built, and reads them only once a lookup has failed, to say that the name exists under a
# condition this build does not meet.

use collections_vector: std.collections.vector;
use std.types.bool.bool;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;

use mach.base.diagnostic;
use mach.base.fail;
use mach.base.intern;
use base_source: mach.base.source;
use mach.base.stack;
use mach.front.ast;
use ast_decl:      mach.front.ast.decl;
use ast_expr:      mach.front.ast.expr;
use ast_id:        mach.front.ast.id;
use comptime_gate: mach.front.comptime.gate;
use front_path:    mach.front.path;

# one name a branch the build does not select declares
# ---
# name:     the name
# file:     the file that declares it
# at:       the name where it is declared
# cond:     the condition that left it out: the branch's own, which is false, or, for a branch
#           after the one the build selects, the selected branch's
# selected: `cond` is the selected branch's
pub rec Omitted {
    name:     intern.StrId;
    file:     base_source.FileId;
    at:       base_source.Span;
    cond:     base_source.Span;
    selected: bool;
}

# record every name branch `br` of a module-scope chain declares, at any depth, as left out by
# condition `cond`; a nested chain is left out by the same condition, since it was never decided
# ---
# out:      where the names go, in declaration order
# a:        the module's syntax
# source:   its text
# itn:      the interner names are interned in
# br:       the branch the build does not select
# cond:     the condition that left it out
# selected: `cond` is an earlier branch's, which the build selects
# ret:      the allocator's refusal, or a nesting refusal for chains deeper than the stack
pub fun record(out: *collections_vector.Vector[Omitted], a: *ast.Ast, source: str, itn: *intern.Interner,
    br: *ast_decl.ComptimeBranch, cond: base_source.Span, selected: bool) err[fail.Fail] {
    if (stack.exhausted()) { ret err[fail.Fail].err{comptime_gate.nesting()}; }
    var i: u32 = 0;
    for (i < br.body_len) {
        val opt_decl: opt[*ast_decl.Decl] = ast.get_decl(a, a.decl_ids.data[br.body_start + i]);
        if (sel opt_decl.none) { ret err[fail.Fail].err{fail.message("a branch lists a declaration outside its module's syntax")}; }
        val d: *ast_decl.Decl = opt_decl.some;
        if (d.kind == ast_decl.DECL_KIND_COMPTIME_IF) {
            var bi: u32 = 0;
            for (bi < d.data.comptime_if.branches_len) {
                val inner:     *ast_decl.ComptimeBranch = ?a.comptime_branches.data[d.data.comptime_if.branches_start + bi];
                val err_inner: err[fail.Fail]           = record(out, a, source, itn, inner, cond, selected);
                if (sel err_inner.err) { ret err_inner; }
                bi = bi + 1;
            }
        }
        or {
            val at: base_source.Span = declared_name(source, d);
            if (at.len != 0) {
                val res_name: res[intern.StrId, A.Error] = intern.range_add(itn, source, at.offset, at.len);
                if (sel res_name.err) { ret err[fail.Fail].err{fail.refused(res_name.err)}; }
                val res_pushed: res[usize, A.Error] = collections_vector.push[Omitted](out,
                    Omitted{name: res_name.ok, file: a.file_id, at: at, cond: cond, selected: selected});
                if (sel res_pushed.err) { ret err[fail.Fail].err{fail.refused(res_pushed.err)}; }
            }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# the span of a branch's condition, empty for a bare `$or`
pub fun condition(a: *ast.Ast, br: *ast_decl.ComptimeBranch) base_source.Span {
    if (ast_id.expr_is_nil(br.cond)) { ret base_source.Span{}; }
    val opt_expr: opt[*ast_expr.Expr] = ast.get_expr(a, br.cond);
    if (sel opt_expr.none) { ret base_source.Span{}; }
    ret opt_expr.some.span;
}

# the name a declaration binds where name resolution looks names up, empty for one that binds none
fun declared_name(source: str, d: *ast_decl.Decl) base_source.Span {
    if (d.kind == ast_decl.DECL_KIND_FUN)                                     { ret d.data.fun_.name; }
    if (d.kind == ast_decl.DECL_KIND_REC)                                     { ret d.data.rec_.name; }
    if (d.kind == ast_decl.DECL_KIND_UNI)                                     { ret d.data.uni_.name; }
    if (d.kind == ast_decl.DECL_KIND_TAG)                                     { ret d.data.tag_.name; }
    if (d.kind == ast_decl.DECL_KIND_DEF)                                     { ret d.data.def_.name; }
    if (d.kind == ast_decl.DECL_KIND_VAL || d.kind == ast_decl.DECL_KIND_VAR) { ret d.data.bind.name; }
    if (d.kind == ast_decl.DECL_KIND_USE) {
        if (d.data.use_.alias.len != 0) { ret d.data.use_.alias; }
        ret front_path.leaf(source, d.data.use_.path);
    }
    if (d.kind == ast_decl.DECL_KIND_FWD) {
        if (d.data.fwd_.alias.len != 0) { ret d.data.fwd_.alias; }
        ret front_path.leaf(source, d.data.fwd_.path);
    }
    ret base_source.Span{};
}

# the first record of `name` among `count` records, nil when the build leaves no such name out
pub fun find(list: *Omitted, count: u32, name: intern.StrId) *Omitted {
    var i: u32 = 0;
    for (i < count) {
        if (intern.str_same(list[i].name, name)) { ret ?list[i]; }
        i = i + 1;
    }
    ret nil;
}

# point a report of a name no lookup found at where the build left it out: the declaration, and
# the condition that excluded it
pub fun attach(b: *diagnostic.DiagnosticBuilder, o: *Omitted) err[fail.Fail] {
    val err_at: err[fail.Fail] = diagnostic.attach_related(b, o.file, o.at, "declared here, in a branch this build does not select");
    if (sel err_at.err) { ret err_at; }
    if (o.selected)     { ret diagnostic.attach_related(b, o.file, o.cond, "this build selects this earlier branch instead"); }
    ret diagnostic.attach_related(b, o.file, o.cond, "this condition is false in this build");
}

# whether two records say the same, so an importer reading one reports what it would read in the other
pub fun same(l: *Omitted, r: *Omitted) bool {
    ret intern.str_same(l.name, r.name) && base_source.file_same(l.file, r.file) && l.selected == r.selected
        && l.at.offset == r.at.offset && l.at.len == r.at.len && l.cond.offset == r.cond.offset && l.cond.len == r.cond.len;
}
