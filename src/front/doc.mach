# the model of one doc comment: its prose paragraphs, the summary first, and the
# component lines after `# ---`
#
# a doc comment is a span of source holding one or more `#` lines. this module is
# the one reader of that span: the parser's linter walks its components, and the
# documentation generator takes its paragraphs and component descriptions as text
# with the comment marks removed, through `prose` and `flowed`
use std.memory;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;

use base_source: mach.base.source;

pub rec DocComponent {
    name_span: base_source.Span;
    desc_span: base_source.Span;
}

pub rec DocComponentIter {
    source: str;
    off:    usize;
    end:    usize;
}

# the paragraphs of a doc comment's prose, which ends at the separator or the end
pub rec ParagraphIter {
    source: str;
    off:    usize;
    end:    usize;
}

pub fun has_component_block(source: str, doc: base_source.Span) bool {
    if (doc.len == 0) { ret false; }
    ret separator_offset(source, doc) != doc.offset + doc.len;
}

pub fun paragraph_iter(source: str, doc: base_source.Span) ParagraphIter {
    var it: ParagraphIter;
    it.source = source;
    it.off    = doc.offset;
    it.end    = doc.offset;
    if (doc.len > 0) { it.end = separator_offset(source, doc); }
    ret it;
}

# the next paragraph, the lines up to a blank `#` line, written to `out`; false once none is left
pub fun paragraph_next(it: *ParagraphIter, out: *base_source.Span) bool {
    var lo: usize = it.end;
    var hi: usize = it.end;
    for (it.off < it.end) {
        val le:      usize = line_end(it.source, it.off, it.end);
        val content: usize = strip_hash(it.source, it.off, le);
        val blank:   bool  = trim_trailing(it.source, content, le) == content;
        if (!blank && lo == it.end) { lo = it.off; }
        if (!blank)                 { hi = le; }
        it.off = le;
        if (it.off < it.end && it.source[it.off] == '\n') { it.off = it.off + 1; }
        if (blank && lo != it.end)                        { brk; }
    }
    if (lo == it.end) { ret false; }
    out.offset = lo;
    out.len    = hi - lo;
    ret true;
}

# the length of the summary of `prose`, a doc comment's first paragraph without its
# comment marks: the text before its first sentence end, a `.` followed by white space or
# the end of the text, outside a code span, and not the last `.` of `e.g.`, `i.e.`, `etc.`
# or `vs.`; the whole text when no sentence ends in it
pub fun summary_len(prose: str) usize {
    var code: bool  = false;
    var i:    usize = 0;
    for (prose[i] != 0) {
        val c: u8 = prose[i];
        if (c == '`') { code = !code; }
        or (c == '.' && !code && (prose[i + 1] == 0 || is_space(prose[i + 1]) || prose[i + 1] == '\n') && !abbreviation(prose, i)) {
            ret i;
        }
        i = i + 1;
    }
    ret i;
}

# whether the `.` at `dot` ends one of the abbreviations a summary runs past
fun abbreviation(prose: str, dot: usize) bool {
    ret word_before(prose, dot, "e.g") || word_before(prose, dot, "i.e") || word_before(prose, dot, "etc") || word_before(prose, dot, "vs");
}

# whether `word` stands whole right before `at`: at the start of the text or after a byte
# that is no letter or digit
fun word_before(prose: str, at: usize, word: str) bool {
    var n: usize = 0;
    for (word[n] != 0) { n = n + 1; }
    if (at < n) { ret false; }
    val lo: usize = at - n;
    var i:  usize = 0;
    for (i < n) {
        if (prose[lo + i] != word[i]) { ret false; }
        i = i + 1;
    }
    if (lo == 0) { ret true; }
    val c: u8 = prose[lo - 1];
    ret !((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9'));
}

# the text of `span`, every line without its indentation, its `#` and the one blank after it,
# lines kept apart by a newline
pub fun prose(a: *A.Allocator, source: str, span: base_source.Span) res[str, A.Error] {
    ret stripped(a, source, span, false);
}

# the text of `span`, every line without its `#` and every blank around its words, lines
# joined by one space: a component description that wraps over continuation lines
pub fun flowed(a: *A.Allocator, source: str, span: base_source.Span) res[str, A.Error] {
    ret stripped(a, source, span, true);
}

fun stripped(a: *A.Allocator, source: str, span: base_source.Span, flow: bool) res[str, A.Error] {
    val end:     usize             = span.offset + span.len;
    val res_buf: res[*u8, A.Error] = A.allocate[u8](a, span.len + 1);
    if (sel res_buf.err) { ret res[str, A.Error].err{res_buf.err}; }
    val buf: *u8   = res_buf.ok;
    var n:   usize = 0;
    var off: usize = span.offset;
    for (off < end) {
        val le: usize = line_end(source, off, end);
        var lo: usize = off;
        for (lo < le && is_space(source[lo])) { lo = lo + 1; }
        if (lo < le && source[lo] == '#') {
            lo = lo + 1;
            if (flow) {
                for (lo < le && is_space(source[lo])) { lo = lo + 1; }
            }
            or (lo < le && source[lo] == ' ') {
                lo = lo + 1;
            }
        }
        val hi: usize = trim_trailing(source, lo, le);
        if (off != span.offset) {
            if (flow) { buf[n] = ' '; }
            or        { buf[n] = '\n'; }
            n = n + 1;
        }
        memory.raw_copy(?buf[n], ?source[lo], hi - lo);
        n   = n + hi - lo;
        off = le;
        if (off < end && source[off] == '\n') { off = off + 1; }
    }
    buf[n] = 0;
    ret res[str, A.Error].ok{buf::str};
}

pub fun component_iter(source: str, doc: base_source.Span) DocComponentIter {
    var it: DocComponentIter;
    it.source = source;
    it.end    = doc.offset + doc.len;

    if (doc.len == 0) {
        it.off = it.end;
        ret it;
    }

    val sep: usize = separator_offset(source, doc);
    if (sep == it.end) {
        it.off = it.end;
        ret it;
    }

    var off: usize = line_end(source, sep, it.end);
    if (off < it.end && source[off] == '\n') { off = off + 1; }
    it.off = off;
    ret it;
}

# the next component written to `out`, false once none is left
pub fun component_next(it: *DocComponentIter, out: *DocComponent) bool {
    var have:    bool             = false;
    var name:    base_source.Span = span_make();
    var desc_lo: usize            = 0;
    var desc_hi: usize            = 0;

    for (it.off < it.end) {
        val le:      usize = line_end(it.source, it.off, it.end);
        val content: usize = strip_hash(it.source, it.off, le);

        var name_span: base_source.Span = span_make();
        var head_lo:   usize            = 0;
        val starts:    bool             = component_head(it.source, it.off, le, ?name_span, ?head_lo);

        if (starts) {
            if (have) {
                emit_component(out, name, desc_lo, desc_hi);
                ret true;
            }

            have    = true;
            name    = name_span;
            desc_lo = head_lo;
            desc_hi = trim_trailing(it.source, head_lo, le);
        }
        or (have) {
            val hi: usize = trim_trailing(it.source, content, le);
            if (hi > content) { desc_hi = hi; }
        }

        it.off = le;
        if (it.off < it.end && it.source[it.off] == '\n') { it.off = it.off + 1; }
    }

    if (have) { emit_component(out, name, desc_lo, desc_hi); }
    ret have;
}

fun span_make() base_source.Span {
    var s: base_source.Span;
    s.offset = 0;
    s.len    = 0;
    ret s;
}

fun is_space(c: u8) bool {
    ret c == ' ' || c == '\t' || c == '\r';
}

fun line_end(source: str, off: usize, end: usize) usize {
    var i: usize = off;
    for (i < end && source[i] != '\n') { i = i + 1; }
    ret i;
}

fun strip_hash(source: str, off: usize, end: usize) usize {
    var i: usize = off;
    for (i < end && is_space(source[i])) { i = i + 1; }
    if (i < end && source[i] == '#') { i = i + 1; }
    for (i < end && is_space(source[i])) { i = i + 1; }
    ret i;
}

fun trim_trailing(source: str, lo: usize, hi: usize) usize {
    var i: usize = hi;
    for (i > lo && is_space(source[i - 1])) { i = i - 1; }
    ret i;
}

fun is_separator_line(source: str, content: usize, content_end: usize) bool {
    val hi: usize = trim_trailing(source, content, content_end);
    if (hi - content != 3) { ret false; }
    ret source[content] == '-' && source[content + 1] == '-' && source[content + 2] == '-';
}

fun separator_offset(source: str, doc: base_source.Span) usize {
    val end: usize = doc.offset + doc.len;
    var off: usize = doc.offset;
    for (off < end) {
        val le:      usize = line_end(source, off, end);
        val content: usize = strip_hash(source, off, le);
        if (is_separator_line(source, content, le)) { ret off; }
        off = le;
        if (off < end && source[off] == '\n') { off = off + 1; }
    }
    ret end;
}

# the length of the component head that opens the comment line at `line`, from its `#`
# through its `:`: `#`, zero or one space, a name with no space in it, and a `:` that ends
# the line or is followed by a space. 0 when the line opens no component. the formatter
# aligns descriptions by it and the linter and the generator read components by it
pub fun component_head_len(source: str, line: base_source.Span) usize {
    ret head_len(source, line.offset, line.offset + line.len);
}

# whether the comment line at `line` continues a description: `#`, two or more spaces,
# then text
pub fun continues(source: str, line: base_source.Span) bool {
    val end: usize = line.offset + line.len;
    if (line.offset >= end || source[line.offset] != '#') { ret false; }
    var i: usize = line.offset + 1;
    for (i < end && is_space(source[i])) { i = i + 1; }
    ret i >= line.offset + 3 && i < end;
}

fun head_len(source: str, hash: usize, le: usize) usize {
    if (hash >= le || source[hash] != '#') { ret 0; }
    var i: usize = hash + 1;
    if (i < le && is_space(source[i])) { i = i + 1; }
    val name: usize = i;
    for (i < le && source[i] != ':' && !is_space(source[i])) { i = i + 1; }
    if (i == name || i >= le || source[i] != ':') { ret 0; }
    if (i + 1 < le && !is_space(source[i + 1]))   { ret 0; }
    ret i + 1 - hash;
}

fun component_head(source: str, off: usize, le: usize, name_out: *base_source.Span, desc_lo_out: *usize) bool {
    var hash: usize = off;
    for (hash < le && is_space(source[hash])) { hash = hash + 1; }
    val n: usize = head_len(source, hash, le);
    if (n == 0) { ret false; }
    var name: usize = hash + 1;
    if (is_space(source[name])) { name = name + 1; }
    var lo: usize = hash + n;
    for (lo < le && is_space(source[lo])) { lo = lo + 1; }
    name_out.offset = name;
    name_out.len    = hash + n - 1 - name;
    @desc_lo_out    = lo;
    ret true;
}

fun emit_component(out: *DocComponent, name: base_source.Span, desc_lo: usize, desc_hi: usize) {
    out.name_span = name;
    if (desc_hi > desc_lo) {
        out.desc_span.offset = desc_lo;
        out.desc_span.len    = desc_hi - desc_lo;
    }
    or {
        out.desc_span = span_make();
    }
}
