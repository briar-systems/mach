# module loading: every module a build reaches, its gates decided and its imports bound
#
# from the modules it is asked for, the loader finds each one they import through the source
# provider and has its host parse it, decides each module's declaring gates and binds the public
# constants those gates read, in the build target's frame and under every target of a union
# build. it leaves a load record on each module, with one `Binding` per import declaration for
# name resolution to bind from. the host owns the module table and the parses, and a reload
# walks one changed module again and says whether its load surface survived.

use std.collections.map;
use std.collections.sort;
use collections_vector: std.collections.vector;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.view;
use std.types.view.view_eq_str;

use A: std.allocator;

use mach.base.diagnostic;
use diagnostic_kind: mach.base.diagnostic.kind;
use mach.base.fail;
use mach.base.float;
use mach.base.intern;
use base_source: mach.base.source;
use mach.base.source.provider;
use mach.base.stack;
use mach.front.ast;
use ast_decl: mach.front.ast.decl;
use ast_expr: mach.front.ast.expr;
use ast_id:   mach.front.ast.id;
use mach.front.ast.interpretation;
use ast_module: mach.front.ast.module;
use ast_type:   mach.front.ast.type;
use mach.front.comptime;
use comptime_capability: mach.front.comptime.capability;
use comptime_failure:    mach.front.comptime.failure;
use comptime_gate:       mach.front.comptime.gate;
use comptime_scope:      mach.front.comptime.scope;
use comptime_value:      mach.front.comptime.value;
use mach.front.decorator;
use mach.front.parser.state;
use front_path:   mach.front.path;
use report_phase: mach.report.phase;
use mach.session;
use session_embed: mach.session.embed;
use mach.session.module;
use target_facts: mach.target.facts;
use type_kind:    mach.type.kind;
use type_prim:    mach.type.prim;

# the frame the load walk reads and binds in: the build target's, or a union tuple's by index
pub val FRAME_BUILD: u32 = 0xFFFFFFFF;

# how far the load has reached a module
pub def State: u8;

val STATE_NEW:     State = 0;
val STATE_LOADING: State = 1;
val STATE_DONE:    State = 2;

# a public constant a module binds in its build frame, exported to the gates of its importers
rec Const {
    name:  intern.StrId;
    value: comptime_value.CTValue;
}

# what an import declaration binds, as the load decided it
# ---
# BINDING_MODULE:  the declaration names a module and binds it under `name`
# BINDING_MEMBER:  it names the member `name` of a module
# BINDING_UNBOUND: its path names no module; the load reported it, so resolve says nothing more
def BindingKind: u8;

pub val BINDING_MODULE:  BindingKind = 0;
pub val BINDING_MEMBER:  BindingKind = 1;
pub val BINDING_UNBOUND: BindingKind = 2;

# the record of one import declaration, which resolve binds from rather than reading its path
# ---
# decl:     the `use` or `fwd`
# kind:     what it binds
# name:     the name a module binding binds it under, or the member a member binding names
# module:   the module it names
# span:     its path
# constant: a `use` of a member under the member's own name, so the member's public constant is
#           bound for the importer's gates
pub rec Binding {
    decl:     ast_id.DeclId;
    kind:     BindingKind;
    name:     intern.StrId;
    module:   module.StableModuleId;
    span:     base_source.Span;
    constant: bool;
}

# one declaration or gate the load is deciding, so a demand that reaches it again is a cycle
# ---
# module: the module it is in
# frame:  the frame it is decided in
# decl:   the `val` being walked, or DECL_NIL for a gate
# cond:   the gate's condition, or EXPR_NIL for a `val`
# name:   the `val`'s name
rec Demand {
    module: module.ModuleId;
    frame:  u32;
    decl:   ast_id.DeclId;
    cond:   ast_id.ExprId;
    name:   intern.StrId;
}

# one target a union build decides every gate under
pub rec Tuple {
    target:        target_facts.Facts;
    os_name:       intern.StrId;
    isa_name:      intern.StrId;
    abi_name:      intern.StrId;
    platform_name: intern.StrId;
}

# the load product of one module: the gates it decided and the constants it bound, in its
# context, the modules it reaches and a record of each import declaration. modules are named by
# stable id
# ---
# status:       the standing of the module's load
# home:         the package that owns it and its file there
# artifact:     the artifact whose walk first reached it, what `$bin.name` reads
# gated:        it was first reached from an artifact this target does not build, or a union
#               reached it only under another target's arms (see build_reach)
# outcome:      the outcome of its module-scope gates
# ctx:          its build target's frame, which every later phase reads
# frame:        the frame the walk is in: FRAME_BUILD or a union tuple
# frames:       its frame under each union tuple, which only the load reads
# walked:       the declarations the walk reached in its build target's frame, by declaration
# frame_walked: the declarations the walk reached under each union tuple, `decl_count` per tuple
# reached:      the union tuples a walk reached it under
# deps:         the modules it imports
# consts:       the public constants it exports to its importers' gates
# bindings:     one record per import declaration the walk reached
# binders:      where a demand finds each name a declaration list binds, built once per syntax
#               (see demand_index)
pub rec Module {
    status:       report_phase.PhaseStatus;
    home:         provider.Home;
    artifact:     intern.StrId;
    gated:        bool;
    outcome:      comptime_gate.GateOutcome;
    ctx:          comptime_scope.ComptimeCtx;
    frame:        u32;
    frames:       *comptime_scope.ComptimeCtx;
    frame_count:  u32;
    walked:       *bool;
    frame_walked: *bool;
    decl_count:   u32;
    reached:      *bool;
    reach_count:  u32;
    deps:         collections_vector.Vector[module.StableModuleId];
    consts:       collections_vector.Vector[Const];
    bindings:     collections_vector.Vector[Binding];
    binders:      DemandIndex;
}

# the declarations a demand for a name reaches in one module's syntax, so a demand costs one
# lookup rather than a pass over its list
# ---
# names:   the first `val` or `use` that binds a name in a declaration list, by demand_key of the
#          list's first pool position and the name, as its position in the declaration pool
# uses:    the first `use` that binds a name in a declaration list, keyed and placed as `names`
# chains:  the pool position of every `$if` chain in the module, ascending; a chain before the
#          binder may bind the name first in the arm it selects
# indexed: the maps and chains above describe the current syntax
rec DemandIndex {
    names:   map.Map[u64, u32];
    uses:    map.Map[u64, u32];
    chains:  collections_vector.Vector[u32];
    indexed: bool;
}

# a module as the load's host holds it: its identity and its load record
pub rec Row {
    name:   intern.StrId;
    stable: module.StableModuleId;
    file:   base_source.FileId;
    load:   *Module;
}

# what the load asks of the program that runs it, which owns the module table and the parses.
# the host runs each of the load's entries (module_load, module_load_one, module_reload and
# decorators_record) whole, and replaces no module's syntax while one runs but through `parse`
# ---
# ctx:     the host's own state
# add:     make a row for a module with this name and stable id, with no file or syntax yet, and
#          give its id; ids are given in order from zero
# row:     a module's row; the load record it points at stays where it is
# syntax:  a module's current syntax, nil where it has none
# parse:   give the module this file and make its syntax current; `reported` says the load
#          reached it by walking, so a progress readout lists it
# context: the comptime context of a module of `artifact` under the build target, with nothing
#          of the module itself
# done:    a module and everything it imports finished loading
pub rec Host {
    ctx:     ptr;
    add:     fun(ptr, intern.StrId, module.StableModuleId) res[module.ModuleId, fail.Fail];
    row:     fun(ptr, module.ModuleId) Row;
    syntax:  fun(ptr, module.ModuleId) *ast.Ast;
    parse:   fun(ptr, module.ModuleId, base_source.FileId, bool) err[fail.Fail];
    context: fun(ptr, intern.StrId) res[comptime_scope.ComptimeCtx, fail.Fail];
    done:    fun(ptr, module.ModuleId) err[fail.Fail];
}

# what the provider answered an entry about a path
rec Named {
    entry:  u64;
    module: bool;
}

# what the loader holds of one module
# ---
# load:   its load record, which stays where it is (Host.row)
# entry:  the entry its syntax and text were read in, 0 for none; they hold for that entry alone
# a:      its syntax as that entry read it
# source: its text as that entry read it
# known:  the session holds its file, so `source` is its text
rec Held {
    load:   *Module;
    entry:  u64;
    a:      *ast.Ast;
    source: str;
    known:  bool;
}

# the front end's loading stage: from the modules it is asked for, it finds every module they
# reach through the source provider, decides each one's declaring gates and binds the constants
# those gates read, and leaves a load record on each
# ---
# host:      what runs the load, bound before each use
# sources:   the module namespace, bound before each use
# diags:     where the load reports, bound before each use
# by_name:   each module's id by its fqn
# by_stable: each module's id by its stable id
# states:    how far each module is loaded, by id
# held:      what the loader holds of each module, by id
# entry:     the entry running now, numbering each from 1
# named:     whether each path a `use` or `fwd` spells names a module, as the provider answered
#            the entry it was asked in
# demands:   the gates and constants the load is deciding, innermost last
# union:     the build decides every gate under each of `tuples` as well as its own target
# filter:    the tuples the walk is under now, nil for all of them
# foreign:   the walk is under an artifact this target does not build
# artifact:  the artifact a module reached now is attributed to
# dirty:     a module reached under a new tuple after it loaded was walked again, which can give
#            it dependencies the host's order placed after it
pub rec Loader {
    s:           *session.Session;
    alloc:       *A.Allocator;
    host:        Host;
    sources:     provider.Provider;
    diags:       *diagnostic.DiagnosticStore;
    by_name:     map.Map[intern.StrId, module.ModuleId];
    by_stable:   map.Map[module.StableModuleId, module.ModuleId];
    states:      collections_vector.Vector[State];
    held:        collections_vector.Vector[Held];
    entry:       u64;
    named:       map.Map[intern.StrId, Named];
    demands:     collections_vector.Vector[Demand];
    union:       bool;
    tuples:      *Tuple;
    tuple_count: u32;
    tuple_cap:   u32;
    filter:      *bool;
    foreign:     bool;
    artifact:    intern.StrId;
    dirty:       bool;
}

pub fun init(s: *session.Session, a: *A.Allocator) Loader {
    var l: Loader;
    l.s           = s;
    l.alloc       = a;
    l.host        = Host{};
    l.sources     = provider.Provider{};
    l.diags       = nil;
    l.by_name     = map.init[intern.StrId, module.ModuleId](a);
    l.by_stable   = map.init[module.StableModuleId, module.ModuleId](a);
    l.states      = collections_vector.init[State](a);
    l.held        = collections_vector.init[Held](a);
    l.entry       = 0;
    l.named       = map.init[intern.StrId, Named](a);
    l.demands     = collections_vector.init[Demand](a);
    l.union       = false;
    l.tuples      = nil;
    l.tuple_count = 0;
    l.tuple_cap   = 0;
    l.filter      = nil;
    l.foreign     = false;
    l.artifact    = intern.STR_NIL;
    l.dirty       = false;
    ret l;
}

# release what the loader owns; each module's record is released by its row's owner
pub fun dnit(l: *Loader) {
    map.dnit[intern.StrId, module.ModuleId](?l.by_name);
    map.dnit[module.StableModuleId, module.ModuleId](?l.by_stable);
    collections_vector.dnit[State](?l.states);
    collections_vector.dnit[Held](?l.held);
    map.dnit[intern.StrId, Named](?l.named);
    collections_vector.dnit[Demand](?l.demands);
    if (l.tuples != nil && l.tuple_cap > 0) { A.deallocate[Tuple](l.alloc, l.tuples, l.tuple_cap::usize); }
    l.tuples      = nil;
    l.tuple_count = 0;
    l.tuple_cap   = 0;
}

# point the loader at what runs it, which may have moved since its last use
pub fun bind(l: *Loader, host: Host, sources: provider.Provider, diags: *diagnostic.DiagnosticStore) {
    l.host    = host;
    l.sources = sources;
    l.diags   = diags;
}

# make a union build: every gate is decided under each of `count` tuples, which the loader owns
pub fun tuples_set(l: *Loader, tuples: *Tuple, count: u32, cap: u32) {
    l.tuples      = tuples;
    l.tuple_count = count;
    l.tuple_cap   = cap;
    l.union       = true;
}

pub fun module_dnit(a: *A.Allocator, m: *Module) {
    comptime_scope.dnit(?m.ctx);
    walked_dnit(a, m);
    if (m.frames != nil) {
        var ti: u32 = 0;
        for (ti < m.frame_count) {
            comptime_scope.dnit(?m.frames[ti]);
            ti = ti + 1;
        }
        A.deallocate[comptime_scope.ComptimeCtx](a, m.frames, m.frame_count::usize);
    }
    if (m.reached != nil && m.reach_count > 0) { A.deallocate[bool](a, m.reached, m.reach_count::usize); }
    m.frames      = nil;
    m.frame_count = 0;
    m.reached     = nil;
    m.reach_count = 0;
    collections_vector.dnit[module.StableModuleId](?m.deps);
    collections_vector.dnit[Const](?m.consts);
    collections_vector.dnit[Binding](?m.bindings);
    map.dnit[u64, u32](?m.binders.names);
    map.dnit[u64, u32](?m.binders.uses);
    collections_vector.dnit[u32](?m.binders.chains);
}

# the id of the module named `fqn`, none when the load has not reached it
pub fun module_find(l: *Loader, fqn: intern.StrId) opt[module.ModuleId] {
    val opt_found: opt[*module.ModuleId] = map.get[intern.StrId, module.ModuleId](?l.by_name, ?fqn);
    if (sel opt_found.none) { ret opt[module.ModuleId].none{}; }
    ret opt[module.ModuleId].some{@opt_found.some};
}

# the id of the module a load product names by stable id, MODULE_NIL when the load has not reached it
pub fun module_of(l: *Loader, sid: module.StableModuleId) module.ModuleId {
    val opt_found: opt[*module.ModuleId] = map.get[module.StableModuleId, module.ModuleId](?l.by_stable, ?sid);
    if (sel opt_found.none) { ret module.MODULE_NIL; }
    ret @opt_found.some;
}

# whether the module is gated out of this build
pub fun gated_at(l: *Loader, mid: module.ModuleId) bool {
    ret module_at(l, mid).gated;
}

pub fun module_count(l: *Loader) u32 {
    ret l.states.len::u32;
}

fun row(l: *Loader, mid: module.ModuleId) Row {
    ret l.host.row(l.host.ctx, mid);
}

fun module_at(l: *Loader, mid: module.ModuleId) *Module {
    ret l.held.data[module.index(mid)::usize].load;
}

# a module's syntax and text as the running entry holds them, read on its first ask
fun held_now(l: *Loader, mid: module.ModuleId) *Held {
    val h: *Held = ?l.held.data[module.index(mid)::usize];
    if (h.entry == l.entry) { ret h; }
    h.entry  = l.entry;
    h.a      = l.host.syntax(l.host.ctx, mid);
    h.source = nil;
    h.known  = false;
    val opt_file: opt[*base_source.SourceFile] = base_source.get(l.s.sources, file_of(l, mid));
    if (sel opt_file.some) {
        h.source = opt_file.some.text;
        h.known  = true;
    }
    ret h;
}

fun syntax_of(l: *Loader, mid: module.ModuleId) *ast.Ast {
    ret held_now(l, mid).a;
}

# whether a path names a module: one entry asks the provider once for each path, so every
# declaration that spells it is decided alike
fun names_module(l: *Loader, fqn: intern.StrId) res[bool, fail.Fail] {
    val opt_known: opt[*Named] = map.get[intern.StrId, Named](?l.named, ?fqn);
    if (sel opt_known.some) {
        if (opt_known.some.entry == l.entry) { ret res[bool, fail.Fail].ok{opt_known.some.module}; }
    }
    val res_asked: res[bool, fail.Fail] = provider.module_exists(?l.sources, l.alloc, fqn);
    if (sel res_asked.err) { ret res_asked; }
    val res_kept: res[bool, A.Error] = map.insert[intern.StrId, Named](?l.named, fqn, Named{entry: l.entry, module: res_asked.ok});
    if (sel res_kept.err) { ret res[bool, fail.Fail].err{fail.refused(res_kept.err)}; }
    ret res_asked;
}

# open one of the load's entries: what an earlier one read no longer holds
fun entry_begin(l: *Loader) {
    l.entry = l.entry + 1;
}

fun file_of(l: *Loader, mid: module.ModuleId) base_source.FileId {
    ret row(l, mid).file;
}

fun fqn_of(l: *Loader, mid: module.ModuleId) intern.StrId {
    ret row(l, mid).name;
}

fun stable_of(l: *Loader, mid: module.ModuleId) module.StableModuleId {
    ret row(l, mid).stable;
}

# the comptime context a module's gates and bodies evaluate in, under the build target
fun module_context(l: *Loader, fqn: intern.StrId, home: *provider.Home, artifact: intern.StrId) res[comptime_scope.ComptimeCtx, fail.Fail] {
    val res_made: res[comptime_scope.ComptimeCtx, fail.Fail] = l.host.context(l.host.ctx, artifact);
    if (sel res_made.err) { ret res_made; }
    var ctx: comptime_scope.ComptimeCtx = res_made.ok;
    comptime_scope.set_source_context(?ctx, l.s.sources, fqn, home.file, home.package, home.version);
    ret res[comptime_scope.ComptimeCtx, fail.Fail].ok{ctx};
}

fun state_set(l: *Loader, mid: module.ModuleId, state: State) {
    l.states.data[module.index(mid)::usize] = state;
}

fun state_of(l: *Loader, mid: module.ModuleId) State {
    ret l.states.data[module.index(mid)::usize];
}

# read a module's text through the source provider, register it with the session's sources and
# have the host parse it
fun module_parse(l: *Loader, mid: module.ModuleId, fqn: intern.StrId, reported: bool) err[fail.Fail] {
    val res_located: res[opt[provider.Origin], fail.Fail] = provider.module_locate(?l.sources, l.alloc, fqn);
    if (sel res_located.err)     { ret err[fail.Fail].err{res_located.err}; }
    if (sel res_located.ok.none) { ret err[fail.Fail].err{fail.message("no project or dep matches the head segment of the module path")}; }
    var origin: provider.Origin = res_located.ok.some;
    fin { provider.origin_dnit(l.alloc, ?origin); }
    val res_text: res[provider.Text, fail.Fail] = provider.module_read(?l.sources, l.alloc, origin.path);
    if (sel res_text.err) { ret err[fail.Fail].err{res_text.err}; }
    var text:    provider.Text                      = res_text.ok;
    val res_fid: res[base_source.FileId, fail.Fail] = session.load_source(l.s, origin.path, text.data);
    provider.text_dnit(l.alloc, ?text);
    if (sel res_fid.err) { ret err[fail.Fail].err{res_fid.err}; }
    # the module's syntax and text are replaced here, so what the entry held of them goes
    l.held.data[module.index(mid)::usize].entry = 0;
    ret l.host.parse(l.host.ctx, mid, res_fid.ok, reported);
}

# give a module reached for the first time a row and a fresh load record under the artifact the
# walk is attributing modules to now
fun module_add(l: *Loader, fqn: intern.StrId) res[module.ModuleId, fail.Fail] {
    val res_located: res[opt[provider.Origin], fail.Fail] = provider.module_locate(?l.sources, l.alloc, fqn);
    if (sel res_located.err)     { ret res[module.ModuleId, fail.Fail].err{res_located.err}; }
    if (sel res_located.ok.none) { ret res[module.ModuleId, fail.Fail].err{fail.message("no project or dep matches the head segment of the module path")}; }
    var origin: provider.Origin = res_located.ok.some;
    provider.origin_dnit(l.alloc, ?origin);

    val res_sid: res[module.StableModuleId, fail.Fail] = module.stable_module_id(?l.s.modules, fqn);
    if (sel res_sid.err) { ret res[module.ModuleId, fail.Fail].err{res_sid.err}; }
    val res_ctx: res[comptime_scope.ComptimeCtx, fail.Fail] = module_context(l, fqn, ?origin.home, l.artifact);
    if (sel res_ctx.err) { ret res[module.ModuleId, fail.Fail].err{res_ctx.err}; }
    var ctx: comptime_scope.ComptimeCtx = res_ctx.ok;

    var handed: bool = false;
    fin {
        if (!handed) { comptime_scope.dnit(?ctx); }
    }

    val res_added: res[module.ModuleId, fail.Fail] = l.host.add(l.host.ctx, fqn, res_sid.ok);
    if (sel res_added.err) { ret res_added; }
    val mid: module.ModuleId = res_added.ok;
    if (module.index(mid)::usize != l.states.len || l.held.len != l.states.len) {
        ret res[module.ModuleId, fail.Fail].err{fail.message("the load host numbered a module out of order")};
    }
    val slot:      *Module             = row(l, mid).load;
    val res_holds: res[usize, A.Error] = collections_vector.push[Held](?l.held, Held{load: slot, entry: 0, a: nil, source: nil, known: false});
    if (sel res_holds.err) { ret res[module.ModuleId, fail.Fail].err{fail.refused(res_holds.err)}; }
    # a module first reached from an artifact this target does not build belongs to that
    # artifact's target, not this one
    handed = true;
    @slot  = Module{
        status:   report_phase.accepted(), home: origin.home, artifact: l.artifact, gated: l.foreign, outcome: comptime_gate.GATE_ACTIVE,
        ctx:      ctx, frame: FRAME_BUILD, frames: nil, frame_count: 0, walked: nil, frame_walked: nil, decl_count: 0,
        reached:  nil, reach_count: 0,
        deps:     collections_vector.init[module.StableModuleId](l.alloc), consts: collections_vector.init[Const](l.alloc),
        bindings: collections_vector.init[Binding](l.alloc),
        binders:  DemandIndex{names: map.init[u64, u32](l.alloc), uses: map.init[u64, u32](l.alloc), chains: collections_vector.init[u32](l.alloc), indexed: false}
    };
    val res_pushed: res[usize, A.Error] = collections_vector.push[State](?l.states, STATE_LOADING);
    if (sel res_pushed.err) { ret res[module.ModuleId, fail.Fail].err{fail.refused(res_pushed.err)}; }
    val res_named: res[bool, A.Error] = map.insert[intern.StrId, module.ModuleId](?l.by_name, fqn, mid);
    if (sel res_named.err) { ret res[module.ModuleId, fail.Fail].err{fail.refused(res_named.err)}; }
    val res_numbered: res[bool, A.Error] = map.insert[module.StableModuleId, module.ModuleId](?l.by_stable, res_sid.ok, mid);
    if (sel res_numbered.err) { ret res[module.ModuleId, fail.Fail].err{fail.refused(res_numbered.err)}; }
    val err_warned: err[fail.Fail] = module.register_module_warned(?l.s.modules, mid, origin.home.warned);
    if (sel err_warned.err) { ret res[module.ModuleId, fail.Fail].err{err_warned.err}; }
    ret res[module.ModuleId, fail.Fail].ok{mid};
}

# mark a module reached under the tuples the union walk is under, and say which of them are new
# to it: nil when none is, else a filter over the tuples the caller releases
fun mark_tuple_reachable(l: *Loader, mid: module.ModuleId) res[*bool, fail.Fail] {
    if (!l.union || l.tuple_count == 0) { ret res[*bool, fail.Fail].ok{nil}; }
    val m: *Module = module_at(l, mid);
    if (m.reached == nil) {
        val res_allocate: res[*bool, A.Error] = A.allocate[bool](l.alloc, l.tuple_count::usize);
        if (sel res_allocate.err) { ret res[*bool, fail.Fail].err{fail.refused(res_allocate.err)}; }
        m.reached     = res_allocate.ok;
        m.reach_count = l.tuple_count;
        var z: u32 = 0;
        for (z < m.reach_count) {
            m.reached[z] = false;
            z            = z + 1;
        }
    }
    var gained: *bool = nil;
    var ti:     u32   = 0;
    for (ti < m.reach_count) {
        if ((l.filter == nil || l.filter[ti]) && !m.reached[ti]) {
            if (gained == nil) {
                val res_allocate: res[*bool, A.Error] = A.allocate[bool](l.alloc, m.reach_count::usize);
                if (sel res_allocate.err) { ret res[*bool, fail.Fail].err{fail.refused(res_allocate.err)}; }
                gained = res_allocate.ok;
                var z: u32 = 0;
                for (z < m.reach_count) {
                    gained[z] = false;
                    z         = z + 1;
                }
            }
            m.reached[ti] = true;
            gained[ti]    = true;
        }
        ti = ti + 1;
    }
    ret res[*bool, fail.Fail].ok{gained};
}

# a loaded module a union walk reaches under tuples new to it is walked again under those tuples
# alone, so the arms they select load what they import; that can give it dependencies the host
# already placed after it, so the host reorders once the load is done
fun rewalk_under_tuples(l: *Loader, mid: module.ModuleId, gained: *bool) err[fail.Fail] {
    val m: *Module = module_at(l, mid);
    if (m.gated) { ret err[fail.Fail].ok{}; }
    val saved_filter:   *bool        = l.filter;
    val saved_artifact: intern.StrId = l.artifact;
    val saved_frame:    u32          = m.frame;
    l.filter   = gained;
    l.artifact = m.artifact;
    m.frame    = FRAME_BUILD;
    val res_walk_module_for_load: res[comptime_gate.GateOutcome, fail.Fail] = walk_module_for_load(l, mid);
    m.frame    = saved_frame;
    l.artifact = saved_artifact;
    l.filter   = saved_filter;
    if (sel res_walk_module_for_load.err) { ret err[fail.Fail].err{res_walk_module_for_load.err}; }
    m.outcome = res_walk_module_for_load.ok;
    l.dirty   = true;
    ret err[fail.Fail].ok{};
}

# parse the module `fqn` names without walking it, as a root a later phase reads alone
pub fun module_load_one(l: *Loader, fqn: intern.StrId) res[module.ModuleId, fail.Fail] {
    entry_begin(l);
    val opt_existing: opt[module.ModuleId] = module_find(l, fqn);
    if (sel opt_existing.some) { ret res[module.ModuleId, fail.Fail].ok{opt_existing.some}; }
    val res_added: res[module.ModuleId, fail.Fail] = module_add(l, fqn);
    if (sel res_added.err) { ret res_added; }
    val err_parsed: err[fail.Fail] = module_parse(l, res_added.ok, fqn, false);
    if (sel err_parsed.err) { ret res[module.ModuleId, fail.Fail].err{err_parsed.err}; }
    state_set(l, res_added.ok, STATE_DONE);
    ret res[module.ModuleId, fail.Fail].ok{res_added.ok};
}

# load the module `fqn` names and everything it reaches: each is parsed, its gates decided and
# its imports loaded first, then handed to the host as done
pub fun module_load(l: *Loader, fqn: intern.StrId) res[module.ModuleId, fail.Fail] {
    entry_begin(l);
    ret load_module(l, fqn);
}

fun load_module(l: *Loader, fqn: intern.StrId) res[module.ModuleId, fail.Fail] {
    val opt_existing: opt[module.ModuleId] = module_find(l, fqn);
    if (sel opt_existing.some) {
        val mid:        module.ModuleId       = opt_existing.some;
        val res_gained: res[*bool, fail.Fail] = mark_tuple_reachable(l, mid);
        if (sel res_gained.err) { ret res[module.ModuleId, fail.Fail].err{res_gained.err}; }
        val gained: *bool = res_gained.ok;
        fin {
            if (gained != nil) { A.deallocate[bool](l.alloc, gained, l.tuple_count::usize); }
        }
        if (state_of(l, mid) == STATE_LOADING) {
            ret res[module.ModuleId, fail.Fail].err{fail.message_of(name_joined(l.s, "circular module dependency: '", fqn, "' is already being loaded"))};
        }
        if (gained != nil) {
            val err_rewalked: err[fail.Fail] = rewalk_under_tuples(l, mid, gained);
            if (sel err_rewalked.err) { ret res[module.ModuleId, fail.Fail].err{err_rewalked.err}; }
        }
        ret res[module.ModuleId, fail.Fail].ok{mid};
    }

    val res_added: res[module.ModuleId, fail.Fail] = module_add(l, fqn);
    if (sel res_added.err) { ret res_added; }
    val mid: module.ModuleId = res_added.ok;

    val res_marked: res[*bool, fail.Fail] = mark_tuple_reachable(l, mid);
    if (sel res_marked.err)   { ret res[module.ModuleId, fail.Fail].err{res_marked.err}; }
    if (res_marked.ok != nil) { A.deallocate[bool](l.alloc, res_marked.ok, l.tuple_count::usize); }

    val err_parse: err[fail.Fail] = module_parse(l, mid, fqn, true);
    if (sel err_parse.err) { ret res[module.ModuleId, fail.Fail].err{err_parse.err}; }
    val m:         *Module        = module_at(l, mid);
    val a:         *ast.Ast       = syntax_of(l, mid);
    val err_gates: err[fail.Fail] = walk_prepare(l, m, a);
    if (sel err_gates.err) { ret res[module.ModuleId, fail.Fail].err{err_gates.err}; }

    val res_walk: res[comptime_gate.GateOutcome, fail.Fail] = walk_module_for_load(l, mid);
    if (sel res_walk.err) { ret res[module.ModuleId, fail.Fail].err{res_walk.err}; }
    m.outcome = res_walk.ok;
    state_set(l, mid, STATE_DONE);

    if (m.gated) { ret res[module.ModuleId, fail.Fail].ok{mid}; }
    val err_done: err[fail.Fail] = l.host.done(l.host.ctx, mid);
    if (sel err_done.err) { ret res[module.ModuleId, fail.Fail].err{err_done.err}; }
    ret res[module.ModuleId, fail.Fail].ok{mid};
}

# reparse and re-walk one loaded module in place, after its text changed, and say whether its load
# surface survived: the modules it reaches, the public constants it declares to importers' gates,
# its own gate outcome and its target gating. a surface that survived leaves every other module as
# it is; one that did not needs a full load. the record is rebuilt from a fresh comptime context,
# since gate states and load marks are keyed by the old syntax tree's ids
# ---
# l:   the loader that loaded the module
# mid: the module whose text changed
# ret: ok(true) when the surface is unchanged; ok(false) when the caller must reload; or the
#      parse or walk failure
pub fun module_reload(l: *Loader, mid: module.ModuleId) res[bool, fail.Fail] {
    entry_begin(l);
    val m:           *Module                   = module_at(l, mid);
    val fqn:         intern.StrId              = fqn_of(l, mid);
    val old_modules: u32                       = module_count(l);
    val old_outcome: comptime_gate.GateOutcome = m.outcome;
    val old_gated:   bool                      = m.gated;

    val res_ctx: res[comptime_scope.ComptimeCtx, fail.Fail] = module_context(l, fqn, ?m.home, m.artifact);
    if (sel res_ctx.err) { ret res[bool, fail.Fail].err{res_ctx.err}; }
    var old_deps:   collections_vector.Vector[module.StableModuleId] = m.deps;
    var old_consts: collections_vector.Vector[Const]                 = m.consts;
    fin {
        collections_vector.dnit[module.StableModuleId](?old_deps);
        collections_vector.dnit[Const](?old_consts);
    }
    comptime_scope.dnit(?m.ctx);
    frames_dnit(l, m);
    walked_dnit(l.alloc, m);
    m.ctx    = res_ctx.ok;
    m.frame  = FRAME_BUILD;
    m.deps   = collections_vector.init[module.StableModuleId](l.alloc);
    m.consts = collections_vector.init[Const](l.alloc);
    collections_vector.truncate[Binding](?m.bindings, 0);
    m.status  = report_phase.accepted();
    m.outcome = comptime_gate.GATE_ACTIVE;
    state_set(l, mid, STATE_LOADING);

    val err_parse: err[fail.Fail] = module_parse(l, mid, fqn, false);
    if (sel err_parse.err) {
        state_set(l, mid, STATE_DONE);
        ret res[bool, fail.Fail].err{err_parse.err};
    }
    val a:         *ast.Ast       = syntax_of(l, mid);
    val err_gates: err[fail.Fail] = walk_prepare(l, m, a);
    if (sel err_gates.err) {
        state_set(l, mid, STATE_DONE);
        ret res[bool, fail.Fail].err{err_gates.err};
    }
    val saved_artifact: intern.StrId = l.artifact;
    l.artifact = m.artifact;
    val res_walk: res[comptime_gate.GateOutcome, fail.Fail] = walk_module_for_load(l, mid);
    l.artifact = saved_artifact;
    state_set(l, mid, STATE_DONE);
    if (sel res_walk.err) { ret res[bool, fail.Fail].err{res_walk.err}; }
    m.outcome = res_walk.ok;

    if (module_count(l) != old_modules)       { ret res[bool, fail.Fail].ok{false}; }
    if (m.outcome != old_outcome)             { ret res[bool, fail.Fail].ok{false}; }
    if (m.gated != old_gated)                 { ret res[bool, fail.Fail].ok{false}; }
    if (!same_dep_set(?old_deps, ?m.deps))    { ret res[bool, fail.Fail].ok{false}; }
    if (!same_consts(?old_consts, ?m.consts)) { ret res[bool, fail.Fail].ok{false}; }
    ret res[bool, fail.Fail].ok{true};
}

fun same_dep_set(a: *collections_vector.Vector[module.StableModuleId], b: *collections_vector.Vector[module.StableModuleId]) bool {
    if (a.len != b.len) { ret false; }
    var i: usize = 0;
    for (i < a.len) {
        var found: bool  = false;
        var j:     usize = 0;
        for (j < b.len) {
            if (module.stable_same(b.data[j], a.data[i])) { found = true; }
            j = j + 1;
        }
        if (!found) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun same_ct_value(a: *comptime_value.CTValue, b: *comptime_value.CTValue) bool {
    if (a.kind != b.kind || a.int_unsigned != b.int_unsigned || a.int_width != b.int_width || a.float_width != b.float_width) { ret false; }
    if (a.kind == comptime_value.CT_KIND_INT)                                                                                 { ret a.data.w.lo == b.data.w.lo && a.data.w.hi == b.data.w.hi; }
    if (a.kind == comptime_value.CT_KIND_FLOAT)                                                                               { ret a.data.f == b.data.f; }
    if (a.kind == comptime_value.CT_KIND_STR)                                                                                 { ret intern.str_same(a.data.s, b.data.s); }
    if (a.kind == comptime_value.CT_KIND_NON_INTEGER)                                                                         { ret intern.str_same(a.data.s, b.data.s); }
    if (a.kind == comptime_value.CT_KIND_TYPE)                                                                                { ret a.data.t == b.data.t; }
    if (a.kind == comptime_value.CT_KIND_FIELD || a.kind == comptime_value.CT_KIND_CASE)                                      { ret a.data.fld.owner == b.data.fld.owner && a.data.fld.index == b.data.fld.index; }
    if (a.kind == comptime_value.CT_KIND_PACK_ELEM)                                                                           { ret a.data.pelem.index == b.data.pelem.index && a.data.pelem.ty == b.data.pelem.ty; }
    if (a.kind == comptime_value.CT_KIND_CONST_ELEM)                                                                          { ret a.data.celem.elem == b.data.celem.elem && a.data.celem.ty == b.data.celem.ty; }
    if (a.kind == comptime_value.CT_KIND_NODE)                                                                                { ret a.data.node.module == b.data.node.module && a.data.node.node == b.data.node.node && a.data.node.ty == b.data.node.ty; }
    ret false;
}

fun same_consts(a: *collections_vector.Vector[Const], b: *collections_vector.Vector[Const]) bool {
    if (a.len != b.len) { ret false; }
    var i: usize = 0;
    for (i < a.len) {
        val x: *Const = ?a.data[i];
        val y: *Const = ?b.data[i];
        if (!intern.str_same(x.name, y.name) || !same_ct_value(?x.value, ?y.value)) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun walk_module_for_load(l: *Loader, mid: module.ModuleId) res[comptime_gate.GateOutcome, fail.Fail] {
    val a: *ast.Ast = syntax_of(l, mid);
    if (a == nil) { ret res[comptime_gate.GateOutcome, fail.Fail].err{fail.message("the load walk reached a module with no syntax")}; }
    val opt_module: opt[*ast_module.Module] = ast.get_module(a, a.root_module);
    if (sel opt_module.none) { ret res[comptime_gate.GateOutcome, fail.Fail].err{fail.message("module root not set on Ast")}; }
    val mod_node: *ast_module.Module = opt_module.some;
    ret walk_decl_list_for_load(l, mid, mod_node.decls_start, mod_node.decls_len);
}

fun walk_decl_list_for_load(l: *Loader, mid: module.ModuleId, start: u32, len: u32) res[comptime_gate.GateOutcome, fail.Fail] {
    val a: *ast.Ast = syntax_of(l, mid);
    if (start::usize > a.decl_ids.len || len::usize > a.decl_ids.len - start::usize) {
        ret res[comptime_gate.GateOutcome, fail.Fail].err{fail.message("load declaration list exceeds its parsed owner")};
    }
    var i: u32 = 0;
    for (i < len) {
        val res_walk_one_decl_for_load: res[comptime_gate.GateOutcome, fail.Fail] = walk_one_decl_for_load(l, mid, a.decl_ids.data[start + i]);
        if (sel res_walk_one_decl_for_load.err)                         { ret res_walk_one_decl_for_load; }
        if (res_walk_one_decl_for_load.ok != comptime_gate.GATE_ACTIVE) { ret res_walk_one_decl_for_load; }
        i = i + 1;
    }
    ret res[comptime_gate.GateOutcome, fail.Fail].ok{comptime_gate.GATE_ACTIVE};
}

fun walk_one_decl_for_load(l: *Loader, mid: module.ModuleId, did: ast_id.DeclId) res[comptime_gate.GateOutcome, fail.Fail] {
    val m:        *Module             = module_at(l, mid);
    val opt_decl: opt[*ast_decl.Decl] = ast.get_decl(syntax_of(l, mid), did);
    if (sel opt_decl.none) { ret res[comptime_gate.GateOutcome, fail.Fail].err{fail.message("DeclId out of range during walk")}; }
    var copied: ast_decl.Decl  = @opt_decl.some;
    val d:      *ast_decl.Decl = ?copied;
    if (stack.exhausted()) { ret res[comptime_gate.GateOutcome, fail.Fail].err{refuse_nesting(l, mid, d.span)}; }

    if (d.kind == ast_decl.DECL_KIND_COMPTIME_IF) {
        ret walk_comptime_if_for_load(l, mid, did, ?d.data.comptime_if, d.span);
    }
    if (walked_at(m, m.frame, did)
        && !(l.union && (d.kind == ast_decl.DECL_KIND_USE || d.kind == ast_decl.DECL_KIND_FWD))) {
        ret res[comptime_gate.GateOutcome, fail.Fail].ok{comptime_gate.GATE_ACTIVE};
    }
    if (d.kind == ast_decl.DECL_KIND_USE) {
        val err_walk_use_for_load: err[fail.Fail] = walk_use_for_load(l, mid, did, ?d.data.use_);
        ret finish_decl_walk(l, mid, did, err_walk_use_for_load);
    }
    if (d.kind == ast_decl.DECL_KIND_FWD) {
        val err_walk_fwd_for_load: err[fail.Fail] = walk_fwd_for_load(l, mid, did, ?d.data.fwd_);
        ret finish_decl_walk(l, mid, did, err_walk_fwd_for_load);
    }
    if (d.kind == ast_decl.DECL_KIND_VAL) {
        # a verdict matters only to a gate that demanded the constant; the walk goes on
        val res_walk_val: res[Verdict, fail.Fail] = walk_val(l, mid, did);
        if (sel res_walk_val.err) { ret res[comptime_gate.GateOutcome, fail.Fail].err{res_walk_val.err}; }
        ret res[comptime_gate.GateOutcome, fail.Fail].ok{comptime_gate.GATE_ACTIVE};
    }
    walked_mark(m, did);
    ret res[comptime_gate.GateOutcome, fail.Fail].ok{comptime_gate.GATE_ACTIVE};
}

fun finish_decl_walk(l: *Loader, mid: module.ModuleId, did: ast_id.DeclId, r: err[fail.Fail]) res[comptime_gate.GateOutcome, fail.Fail] {
    if (sel r.err) {
        ret res[comptime_gate.GateOutcome, fail.Fail].err{r.err};
    }
    walked_mark(module_at(l, mid), did);
    ret res[comptime_gate.GateOutcome, fail.Fail].ok{comptime_gate.GATE_ACTIVE};
}

fun walk_comptime_if_for_load(l: *Loader, mid: module.ModuleId, did: ast_id.DeclId, ci: *ast_decl.DeclComptimeIf, span: base_source.Span) res[comptime_gate.GateOutcome, fail.Fail] {
    val m: *Module = module_at(l, mid);
    if (!l.union && walked_at(m, m.frame, did)) { ret res[comptime_gate.GateOutcome, fail.Fail].ok{comptime_gate.GATE_ACTIVE}; }
    val res_source: res[str, fail.Fail] = module_source(l, mid);
    if (sel res_source.err) { ret res[comptime_gate.GateOutcome, fail.Fail].err{res_source.err}; }
    val source: str = res_source.ok;

    # a chain whose every arm declares nothing selects no declaration, so type checking decides it
    val res_nothing: res[bool, fail.Fail] = comptime_gate.comptime_if_declares_nothing(syntax_of(l, mid), ci.branches_start, ci.branches_len);
    if (sel res_nothing.err) { ret res[comptime_gate.GateOutcome, fail.Fail].err{refuse(l, mid, span, res_nothing.err)}; }
    if (res_nothing.ok) {
        walked_mark(m, did);
        ret res[comptime_gate.GateOutcome, fail.Fail].ok{comptime_gate.GATE_ACTIVE};
    }

    if (l.union) { ret walk_comptime_if_union(l, mid, did, ci, source); }

    val res_choice: res[ChainChoice, fail.Fail] = decide_chain(l, mid, ci, source);
    if (sel res_choice.err) { ret res[comptime_gate.GateOutcome, fail.Fail].err{res_choice.err}; }
    val choice: ChainChoice = res_choice.ok;
    if (choice.outcome == comptime_gate.GATE_REJECTED || choice.outcome == comptime_gate.GATE_FAILED) {
        walked_mark(m, did);
        ret res[comptime_gate.GateOutcome, fail.Fail].ok{choice.outcome};
    }
    if (choice.branch < ci.branches_len) {
        val br:                          *ast_decl.ComptimeBranch                  = ?syntax_of(l, mid).comptime_branches.data[ci.branches_start + choice.branch];
        val res_walk_decl_list_for_load: res[comptime_gate.GateOutcome, fail.Fail] = walk_decl_list_for_load(l, mid, br.body_start, br.body_len);
        if (sel res_walk_decl_list_for_load.err) { ret res_walk_decl_list_for_load; }
        walked_mark(m, did);
        ret res_walk_decl_list_for_load;
    }
    walked_mark(m, did);
    ret res[comptime_gate.GateOutcome, fail.Fail].ok{comptime_gate.GATE_ACTIVE};
}

# a union walk decides each chain in the frame of every tuple it is under, and in the build
# target's, which resolve reads, when the walk is in it. each arm taken is walked once under the
# tuples that took it, in a frame that selects it: the build target's when it does, else the
# first of those tuples'. so a frame binds only what its own arms declare, and a tuple frame
# binds the rest of what its gates read on demand
fun walk_comptime_if_union(l: *Loader, mid: module.ModuleId, did: ast_id.DeclId, ci: *ast_decl.DeclComptimeIf, source: str) res[comptime_gate.GateOutcome, fail.Fail] {
    val m: *Module = module_at(l, mid);
    val n: u32     = ci.branches_len;
    if (n == 0) {
        walked_mark(m, did);
        ret res[comptime_gate.GateOutcome, fail.Fail].ok{comptime_gate.GATE_ACTIVE};
    }

    # the build target decides a chain only in a walk its own arms led to
    var built_arm: u32 = n;
    if (m.frame == FRAME_BUILD) {
        val res_built: res[ChainChoice, fail.Fail] = decide_in_frame(l, mid, FRAME_BUILD, ci, source);
        if (sel res_built.err)                                 { ret res[comptime_gate.GateOutcome, fail.Fail].err{res_built.err}; }
        if (res_built.ok.outcome == comptime_gate.GATE_ACTIVE) { built_arm = res_built.ok.branch; }
    }

    val res_allocate: res[*bool, A.Error] = A.allocate[bool](l.alloc, n::usize);
    if (sel res_allocate.err) { ret res[comptime_gate.GateOutcome, fail.Fail].err{fail.refused(res_allocate.err)}; }
    val taken: *bool = res_allocate.ok;
    fin { A.deallocate[bool](l.alloc, taken, n::usize); }
    var z: u32 = 0;
    for (z < n) {
        taken[z] = false;
        z        = z + 1;
    }

    val branch_count: usize = n::usize;
    val tuple_count:  usize = l.tuple_count::usize;
    val usize_max:    usize = ~(0::usize);
    if (tuple_count != 0 && branch_count > usize_max / tuple_count) {
        ret res[comptime_gate.GateOutcome, fail.Fail].err{fail.message("union gate coverage size overflow")};
    }
    val coverage_len:       usize               = branch_count * tuple_count;
    val res_allocate_alloc: res[*bool, A.Error] = A.allocate[bool](l.alloc, coverage_len);
    if (sel res_allocate_alloc.err) { ret res[comptime_gate.GateOutcome, fail.Fail].err{fail.refused(res_allocate_alloc.err)}; }
    val coverage: *bool = res_allocate_alloc.ok;
    fin { A.deallocate[bool](l.alloc, coverage, coverage_len); }
    var zi: usize = 0;
    for (zi < coverage_len) {
        coverage[zi] = false;
        zi           = zi + 1;
    }

    # every tuple decides the chain, so each one's refusal is reported, and a refusal ends the walk
    var refused: comptime_gate.GateOutcome = comptime_gate.GATE_ACTIVE;
    var ti:      u32                       = 0;
    for (ti < l.tuple_count) {
        if (l.filter != nil && !l.filter[ti]) {
            ti = ti + 1;
            cnt;
        }
        val err_framed: err[fail.Fail] = ensure_tuple_frames(l, mid);
        if (sel err_framed.err) { ret res[comptime_gate.GateOutcome, fail.Fail].err{err_framed.err}; }
        val res_decided: res[ChainChoice, fail.Fail] = decide_in_frame(l, mid, ti, ci, source);
        if (sel res_decided.err) { ret res[comptime_gate.GateOutcome, fail.Fail].err{res_decided.err}; }
        val choice: ChainChoice = res_decided.ok;
        if (choice.outcome == comptime_gate.GATE_REJECTED || choice.outcome == comptime_gate.GATE_FAILED) {
            if (refused == comptime_gate.GATE_ACTIVE) { refused = choice.outcome; }
        }
        or (choice.branch < n) {
            taken[choice.branch]                                     = true;
            coverage[choice.branch::usize * tuple_count + ti::usize] = true;
        }
        ti = ti + 1;
    }
    if (refused != comptime_gate.GATE_ACTIVE) {
        walked_mark(m, did);
        ret res[comptime_gate.GateOutcome, fail.Fail].ok{refused};
    }

    var bi: u32 = 0;
    for (bi < n) {
        if (taken[bi] || bi == built_arm) {
            var frame: u32 = FRAME_BUILD;
            if (bi != built_arm) { frame = first_tuple_of(?coverage[bi::usize * tuple_count], l.tuple_count); }
            val br:           *ast_decl.ComptimeBranch = ?syntax_of(l, mid).comptime_branches.data[ci.branches_start + bi];
            val saved_filter: *bool                    = l.filter;
            val saved_frame:  u32                      = m.frame;
            l.filter = ?coverage[bi::usize * tuple_count];
            m.frame  = frame;
            val res_walk_decl_list_for_load: res[comptime_gate.GateOutcome, fail.Fail] = walk_decl_list_for_load(l, mid, br.body_start, br.body_len);
            m.frame  = saved_frame;
            l.filter = saved_filter;
            if (sel res_walk_decl_list_for_load.err) { ret res_walk_decl_list_for_load; }
            if (res_walk_decl_list_for_load.ok != comptime_gate.GATE_ACTIVE) {
                walked_mark(m, did);
                ret res_walk_decl_list_for_load;
            }
        }
        bi = bi + 1;
    }
    walked_mark(m, did);
    ret res[comptime_gate.GateOutcome, fail.Fail].ok{comptime_gate.GATE_ACTIVE};
}

# the first tuple a filter admits; a filter an arm is walked under admits at least one
fun first_tuple_of(filter: *bool, count: u32) u32 {
    var ti: u32 = 0;
    for (ti < count) {
        if (filter[ti]) { ret ti; }
        ti = ti + 1;
    }
    ret FRAME_BUILD;
}

# decide a chain in one frame of a union build: the build target's, where a module a demand
# reaches is reached under no tuple, or one tuple's, where it is reached under that tuple
fun decide_in_frame(l: *Loader, mid: module.ModuleId, frame: u32, ci: *ast_decl.DeclComptimeIf, source: str) res[ChainChoice, fail.Fail] {
    val m:            *Module             = module_at(l, mid);
    val res_allocate: res[*bool, A.Error] = A.allocate[bool](l.alloc, l.tuple_count::usize + 1);
    if (sel res_allocate.err) { ret res[ChainChoice, fail.Fail].err{fail.refused(res_allocate.err)}; }
    val filter: *bool = res_allocate.ok;
    fin { A.deallocate[bool](l.alloc, filter, l.tuple_count::usize + 1); }
    var i: u32 = 0;
    for (i < l.tuple_count) {
        filter[i] = i == frame;
        i         = i + 1;
    }
    val saved_frame:  u32   = m.frame;
    val saved_filter: *bool = l.filter;
    m.frame  = frame;
    l.filter = filter;
    val res_decide_chain: res[ChainChoice, fail.Fail] = decide_chain(l, mid, ci, source);
    l.filter = saved_filter;
    m.frame  = saved_frame;
    ret res_decide_chain;
}

# the arm a chain selects, decided in the module's current frame
# ---
# outcome: GATE_ACTIVE when an arm is selected, GATE_INACTIVE when none is, or the refusal
# branch:  the selected arm, or the arm count when none is
# verdict: a refusal the chain passes down to the demand that owns it, VERDICT_ABSENT otherwise
rec ChainChoice {
    outcome: comptime_gate.GateOutcome;
    branch:  u32;
    verdict: Verdict;
}

fun chain_choice(outcome: comptime_gate.GateOutcome, branch: u32, verdict: Verdict) ChainChoice {
    ret ChainChoice{outcome: outcome, branch: branch, verdict: verdict};
}

fun decide_chain(l: *Loader, mid: module.ModuleId, ci: *ast_decl.DeclComptimeIf, source: str) res[ChainChoice, fail.Fail] {
    val n:  u32 = ci.branches_len;
    var bi: u32 = 0;
    for (bi < n) {
        val br: *ast_decl.ComptimeBranch = ?syntax_of(l, mid).comptime_branches.data[ci.branches_start + bi];
        if (ast_id.expr_is_nil(br.cond)) { ret res[ChainChoice, fail.Fail].ok{chain_choice(comptime_gate.GATE_ACTIVE, bi, verdict(VERDICT_ABSENT))}; }
        val res_decided: res[GateChoice, fail.Fail] = decide_gate(l, mid, br.cond, source);
        if (sel res_decided.err) { ret res[ChainChoice, fail.Fail].err{res_decided.err}; }
        val g: GateChoice = res_decided.ok;
        if (g.verdict.kind == VERDICT_REFUSED)        { ret res[ChainChoice, fail.Fail].ok{chain_choice(comptime_gate.GATE_FAILED, n, g.verdict)}; }
        if (g.outcome == comptime_gate.GATE_ACTIVE)   { ret res[ChainChoice, fail.Fail].ok{chain_choice(comptime_gate.GATE_ACTIVE, bi, g.verdict)}; }
        if (g.outcome != comptime_gate.GATE_INACTIVE) { ret res[ChainChoice, fail.Fail].ok{chain_choice(g.outcome, n, g.verdict)}; }
        bi = bi + 1;
    }
    ret res[ChainChoice, fail.Fail].ok{chain_choice(comptime_gate.GATE_INACTIVE, n, verdict(VERDICT_ABSENT))};
}

rec GateChoice {
    outcome: comptime_gate.GateOutcome;
    verdict: Verdict;
}

fun gate_choice(outcome: comptime_gate.GateOutcome) GateChoice {
    ret GateChoice{outcome: outcome, verdict: verdict(VERDICT_ABSENT)};
}

# decide one declaring gate in the module's current frame. every constant it names is demanded
# first, so it reads a constant declared later in its module as readily as one declared before
# it; a gate that asks a type question, directly or through a constant it reads, or that its
# own constants lead back to, is refused here
fun decide_gate(l: *Loader, mid: module.ModuleId, cond: ast_id.ExprId, source: str) res[GateChoice, fail.Fail] {
    val m:     *Module                     = module_at(l, mid);
    val ctx:   *comptime_scope.ComptimeCtx = frame_ctx(m);
    val known: comptime_scope.GateState    = comptime_scope.gate_state(ctx, cond);
    if (known == comptime_scope.GATE_STATE_TRUE)     { ret res[GateChoice, fail.Fail].ok{gate_choice(comptime_gate.GATE_ACTIVE)}; }
    if (known == comptime_scope.GATE_STATE_FALSE)    { ret res[GateChoice, fail.Fail].ok{gate_choice(comptime_gate.GATE_INACTIVE)}; }
    if (known == comptime_scope.GATE_STATE_REJECTED) { ret res[GateChoice, fail.Fail].ok{gate_choice(comptime_gate.GATE_REJECTED)}; }

    val opt_open: opt[u32] = demand_find(l, mid, m.frame, ast_id.DECL_NIL, cond);
    if (sel opt_open.some) {
        val res_cycle: res[Verdict, fail.Fail] = cycle_verdict(l, opt_open.some);
        if (sel res_cycle.err) { ret res[GateChoice, fail.Fail].err{res_cycle.err}; }
        ret res[GateChoice, fail.Fail].ok{GateChoice{outcome: comptime_gate.GATE_FAILED, verdict: res_cycle.ok}};
    }

    val res_question: res[ast_id.ExprId, fail.Fail] = comptime_gate.type_question(syntax_of(l, mid), source, cond);
    if (sel res_question.err) { ret res[GateChoice, fail.Fail].err{refuse_expr(l, mid, cond, res_question.err)}; }
    if (!ast_id.expr_is_nil(res_question.ok)) {
        val res_text: res[intern.StrId, fail.Fail] = type_question_message(l, mid, res_question.ok, l.demands.len::u32, l.demands.len::u32);
        if (sel res_text.err) { ret res[GateChoice, fail.Fail].err{res_text.err}; }
        ret refuse_gate(l, mid, cond, diagnostic_kind.GATE_TYPE_QUESTION, res_text.ok);
    }

    val res_index: res[u32, fail.Fail] = demand_push(l, mid, ast_id.DECL_NIL, cond, intern.STR_NIL);
    if (sel res_index.err) { ret res[GateChoice, fail.Fail].err{res_index.err}; }
    val res_demanded: res[Verdict, fail.Fail] = demand_names(l, mid, cond, true);
    demand_pop(l);
    if (sel res_demanded.err) { ret res[GateChoice, fail.Fail].err{res_demanded.err}; }
    if (res_demanded.ok.kind == VERDICT_REFUSED) {
        if (res_demanded.ok.head >= res_index.ok) { ret refuse_gate(l, mid, cond, res_demanded.ok.diag, res_demanded.ok.message); }
        ret res[GateChoice, fail.Fail].ok{GateChoice{outcome: comptime_gate.GATE_FAILED, verdict: res_demanded.ok}};
    }

    var lc: LoadMemberCtx;
    lc.l   = l;
    lc.mid = mid;
    val res_caps: res[comptime_capability.PhaseCapabilities[LoadMemberCtx], fail.Fail] = comptime_capability.loading_capabilities[LoadMemberCtx](resolve_module_member_const_load, load_cast, load_head);
    if (sel res_caps.err) { ret res[GateChoice, fail.Fail].err{res_caps.err}; }
    val res_evaluate_gate: res[comptime_gate.GateVerdict, fail.Fail] = comptime_gate.evaluate_gate[LoadMemberCtx](
        ctx, ?lc, res_caps.ok, syntax_of(l, mid), source, cond, ?l.s.interner, comptime_gate.GATE_SCOPE_DECL, true);
    if (sel res_evaluate_gate.err) { ret res[GateChoice, fail.Fail].err{res_evaluate_gate.err}; }
    val v:       comptime_gate.GateVerdict = res_evaluate_gate.ok;
    val reports: bool                      = frame_reports(l, m);

    if (v.outcome == comptime_gate.GATE_ACTIVE || v.outcome == comptime_gate.GATE_INACTIVE) {
        ret res[GateChoice, fail.Fail].ok{gate_choice(v.outcome)};
    }
    if (v.outcome == comptime_gate.GATE_REJECTED) {
        if (reports && str_len(v.message) > 0) {
            report_phase.reject(?m.status);
            val err_committed: err[fail.Fail] = diagnostic.report(l.diags, v.diag, file_of(l, mid), v.span, v.message);
            if (sel err_committed.err) { ret res[GateChoice, fail.Fail].err{err_committed.err}; }
        }
        or (reports) { report_phase.reject(?m.status); }
        ret res[GateChoice, fail.Fail].ok{gate_choice(comptime_gate.GATE_REJECTED)};
    }
    # a gate the load cannot decide is refused here, so no later phase decides it again; an unbound
    # name is the one it waits on, any other failure says what it cannot evaluate
    if (v.outcome == comptime_gate.GATE_FAILED) {
        comptime_scope.set_gate_state(ctx, cond, comptime_scope.GATE_STATE_REJECTED);
        if (reports) {
            report_phase.reject(?m.status);
            var message: str  = v.message;
            var owned:   bool = false;
            if (!intern.str_is_nil(v.depends)) {
                val res_named: res[str, fail.Fail] = comptime_gate.never_decided_message(l.diags.a, ?l.s.interner, v.depends);
                if (sel res_named.err) { ret res[GateChoice, fail.Fail].err{res_named.err}; }
                message = res_named.ok;
                owned   = true;
            }
            val err_committed: err[fail.Fail] = diagnostic.report(l.diags, v.diag, file_of(l, mid), v.span, message);
            if (owned)                 { str_free(l.diags.a, message); }
            if (sel err_committed.err) { ret res[GateChoice, fail.Fail].err{err_committed.err}; }
        }
        ret res[GateChoice, fail.Fail].ok{gate_choice(comptime_gate.GATE_FAILED)};
    }
    # what the load cannot evaluate, a comptime cast among them, no later phase decides either:
    # the declarations this gate selects are fixed before any type exists
    val res_reason: res[intern.StrId, A.Error] = intern.add(?l.s.interner, v.message);
    if (sel res_reason.err) { ret res[GateChoice, fail.Fail].err{fail.refused(res_reason.err)}; }
    ret refuse_gate(l, mid, cond, v.diag, res_reason.ok);
}

# the frame a union build's resolve reads is decided without a word, since each tuple's
# frame reports the same gate in its own terms
fun frame_reports(l: *Loader, m: *Module) bool {
    ret !(l.union && m.frame == FRAME_BUILD);
}

# the walks recurse as deep as the input nests, over chains, constants and imports, so each
# asks for stack before it descends and refuses the node it stands on
fun refuse_nesting(l: *Loader, mid: module.ModuleId, span: base_source.Span) fail.Fail {
    ret report_refusal(l, mid, span, diagnostic_kind.SYNTAX_NESTING_DEPTH, NESTING_MSG);
}

# a failure a walk over syntax alone returned, reported against `span`: a refusal of the
# input under its own kind; any other failure is the load's own
fun refuse(l: *Loader, mid: module.ModuleId, span: base_source.Span, f: fail.Fail) fail.Fail {
    val k: diagnostic_kind.Kind = fail.kind_of(f);
    if (k == diagnostic_kind.NONE || k == diagnostic_kind.COMPILER_INTERNAL) { ret f; }
    ret report_refusal(l, mid, span, k, fail.describe(f));
}

# the same refusal reported against expression `eid`
fun refuse_expr(l: *Loader, mid: module.ModuleId, eid: ast_id.ExprId, f: fail.Fail) fail.Fail {
    val opt_expr: opt[*ast_expr.Expr] = ast.get_expr(syntax_of(l, mid), eid);
    if (sel opt_expr.none) { ret f; }
    ret refuse(l, mid, opt_expr.some.span, f);
}

fun report_refusal(l: *Loader, mid: module.ModuleId, span: base_source.Span, k: diagnostic_kind.Kind, message: str) fail.Fail {
    report_phase.reject(?module_at(l, mid).status);
    val err_report: err[fail.Fail] = diagnostic.report(l.diags, k, file_of(l, mid), span, message);
    if (sel err_report.err) { ret err_report.err; }
    ret fail.reported();
}

fun nesting() fail.Fail {
    ret fail.user(diagnostic_kind.SYNTAX_NESTING_DEPTH, NESTING_MSG);
}

val NESTING_MSG: str = "input nests too deeply for module loading";

fun refuse_gate(l: *Loader, mid: module.ModuleId, cond: ast_id.ExprId, k: diagnostic_kind.Kind, message: intern.StrId) res[GateChoice, fail.Fail] {
    val m: *Module = module_at(l, mid);
    comptime_scope.set_gate_state(frame_ctx(m), cond, comptime_scope.GATE_STATE_REJECTED);
    if (!frame_reports(l, m)) { ret res[GateChoice, fail.Fail].ok{gate_choice(comptime_gate.GATE_FAILED)}; }
    val opt_cond: opt[*ast_expr.Expr] = ast.get_expr(syntax_of(l, mid), cond);
    if (sel opt_cond.none) { ret res[GateChoice, fail.Fail].err{fail.message("gate condition is out of range")}; }
    val opt_text: opt[str] = intern.get(?l.s.interner, message);
    if (sel opt_text.none) { ret res[GateChoice, fail.Fail].err{fail.message("gate refusal is not interned")}; }
    report_phase.reject(?m.status);
    val err_committed: err[fail.Fail] = diagnostic.report(l.diags, k, file_of(l, mid), opt_cond.some.span, opt_text.some);
    if (sel err_committed.err) { ret res[GateChoice, fail.Fail].err{err_committed.err}; }
    ret res[GateChoice, fail.Fail].ok{gate_choice(comptime_gate.GATE_FAILED)};
}

# what a demand for a constant found
# ---
# VERDICT_BOUND:   the constant is bound in the frame
# VERDICT_ABSENT:  it is not, for a reason the gate reading it reports itself
# VERDICT_REFUSED: it is not because it asks a type question or depends on itself; the gate
#                  at or below `head` on the demand stack is refused with `message`, reported
#                  as `diag`
def VerdictKind: u8;

val VERDICT_BOUND:   VerdictKind = 0;
val VERDICT_ABSENT:  VerdictKind = 1;
val VERDICT_REFUSED: VerdictKind = 2;

rec Verdict {
    kind:    VerdictKind;
    head:    u32;
    diag:    diagnostic_kind.Kind;
    message: intern.StrId;
}

fun verdict(kind: VerdictKind) Verdict {
    ret Verdict{kind: kind, head: 0, diag: diagnostic_kind.NONE, message: intern.STR_NIL};
}

fun demand_push(l: *Loader, mid: module.ModuleId, did: ast_id.DeclId, cond: ast_id.ExprId, name: intern.StrId) res[u32, fail.Fail] {
    val index:      u32                 = l.demands.len::u32;
    val res_pushed: res[usize, A.Error] = collections_vector.push[Demand](?l.demands, Demand{
        module: mid, frame: module_at(l, mid).frame, decl: did, cond: cond, name: name
    });
    if (sel res_pushed.err) { ret res[u32, fail.Fail].err{fail.refused(res_pushed.err)}; }
    ret res[u32, fail.Fail].ok{index};
}

fun demand_pop(l: *Loader) {
    if (l.demands.len > 0) { collections_vector.truncate[Demand](?l.demands, l.demands.len - 1); }
}

fun demand_find(l: *Loader, mid: module.ModuleId, frame: u32, did: ast_id.DeclId, cond: ast_id.ExprId) opt[u32] {
    var i: usize = 0;
    for (i < l.demands.len) {
        val d: *Demand = ?l.demands.data[i];
        if (module.same(d.module, mid) && d.frame == frame && ast_id.decl_same(d.decl, did) && ast_id.expr_same(d.cond, cond)) { ret opt[u32].some{i::u32}; }
        i = i + 1;
    }
    ret opt[u32].none{};
}

# the innermost gate at or below a stack position, which is the one a refusal there belongs to
fun demand_gate_at_or_below(l: *Loader, index: u32) opt[u32] {
    var i: u32 = index + 1;
    if (i::usize > l.demands.len) { i = l.demands.len::u32; }
    for (i > 0) {
        i = i - 1;
        if (!ast_id.expr_is_nil(l.demands.data[i].cond)) { ret opt[u32].some{i}; }
    }
    ret opt[u32].none{};
}

# a demand reached an entry already open on the stack at `head`: the entries from there up lead
# back to it. only a gate can be refused for it, so without one below it the constants involved
# are left unbound as any other unreadable constant is. the gate that owns the refusal reports
# the cycle, and every other gate on it is refused without a word of its own
fun cycle_verdict(l: *Loader, head: u32) res[Verdict, fail.Fail] {
    val opt_owner: opt[u32] = demand_gate_at_or_below(l, head);
    if (sel opt_owner.none) { ret res[Verdict, fail.Fail].ok{verdict(VERDICT_ABSENT)}; }
    var gi: u32 = head + 1;
    for (gi::usize < l.demands.len) {
        val d: Demand = l.demands.data[gi];
        if (!ast_id.expr_is_nil(d.cond)) {
            comptime_scope.set_gate_state(frame_ctx_at(module_at(l, d.module), d.frame), d.cond, comptime_scope.GATE_STATE_REJECTED);
        }
        gi = gi + 1;
    }
    var chain: str = nil;
    fin { str_free(l.s.alloc, chain); }
    var i: u32 = head;
    for (i::usize <= l.demands.len) {
        var at: u32 = i;
        if (i::usize == l.demands.len) { at = head; }
        val res_step: res[str, fail.Fail] = demand_step_text(l, ?l.demands.data[at]);
        if (sel res_step.err) { ret res[Verdict, fail.Fail].err{res_step.err}; }
        var res_next: res[str, fail.Fail];
        if (chain == nil) { res_next = diagnostic.format(l.s.alloc, "{}", res_step.ok); }
        or                { res_next = diagnostic.format(l.s.alloc, "{} -> {}", chain, res_step.ok); }
        str_free(l.s.alloc, res_step.ok);
        str_free(l.s.alloc, chain);
        chain = nil;
        if (sel res_next.err) { ret res[Verdict, fail.Fail].err{res_next.err}; }
        chain = res_next.ok;
        i     = i + 1;
    }
    val res_msg: res[str, fail.Fail] = diagnostic.format(l.s.alloc,
        "the declaring gates and constants this gate reads depend on each other, so no order decides them. the cycle is {}", chain);
    if (sel res_msg.err) { ret res[Verdict, fail.Fail].err{res_msg.err}; }
    val res_interned: res[intern.StrId, A.Error] = intern.add(?l.s.interner, res_msg.ok);
    str_free(l.s.alloc, res_msg.ok);
    if (sel res_interned.err) { ret res[Verdict, fail.Fail].err{fail.refused(res_interned.err)}; }
    ret res[Verdict, fail.Fail].ok{Verdict{kind: VERDICT_REFUSED, head: head, diag: diagnostic_kind.GATE_CYCLE, message: res_interned.ok}};
}

# source text as the interner holds it, so a message can format it
fun span_text(l: *Loader, source: str, span: base_source.Span) res[str, fail.Fail] {
    val res_range_add: res[intern.StrId, A.Error] = intern.range_add(?l.s.interner, source, span.offset, span.len);
    if (sel res_range_add.err) { ret res[str, fail.Fail].err{fail.refused(res_range_add.err)}; }
    val opt_text: opt[str] = intern.get(?l.s.interner, res_range_add.ok);
    if (sel opt_text.none) { ret res[str, fail.Fail].err{fail.message("interned source text is absent")}; }
    ret res[str, fail.Fail].ok{opt_text.some};
}

# a stack entry as a cycle names it: a gate by its condition, a constant by its name
fun demand_step_text(l: *Loader, d: *Demand) res[str, fail.Fail] {
    if (ast_id.expr_is_nil(d.cond)) {
        val opt_name: opt[str] = intern.get(?l.s.interner, d.name);
        if (sel opt_name.none) { ret res[str, fail.Fail].err{fail.message("demanded constant name is not interned")}; }
        val res_format: res[str, fail.Fail] = diagnostic.format(l.s.alloc, "`{}`", opt_name.some);
        if (sel res_format.err) { ret res[str, fail.Fail].err{res_format.err}; }
        ret res[str, fail.Fail].ok{res_format.ok};
    }
    val res_source: res[str, fail.Fail] = module_source(l, d.module);
    if (sel res_source.err) { ret res[str, fail.Fail].err{res_source.err}; }
    val opt_cond: opt[*ast_expr.Expr] = ast.get_expr(syntax_of(l, d.module), d.cond);
    if (sel opt_cond.none) { ret res[str, fail.Fail].err{fail.message("demanded gate condition is out of range")}; }
    val res_text: res[str, fail.Fail] = span_text(l, res_source.ok, opt_cond.some.span);
    if (sel res_text.err) { ret res_text; }
    val res_format: res[str, fail.Fail] = diagnostic.format(l.s.alloc, "`$if ({})`", res_text.ok);
    if (sel res_format.err) { ret res[str, fail.Fail].err{res_format.err}; }
    ret res[str, fail.Fail].ok{res_format.ok};
}

# the constants on the demand stack from `from` up to `top` are the ones a type question is
# reached through
fun type_question_message(l: *Loader, mid: module.ModuleId, call: ast_id.ExprId, from: u32, top: u32) res[intern.StrId, fail.Fail] {
    val res_source: res[str, fail.Fail] = module_source(l, mid);
    if (sel res_source.err) { ret res[intern.StrId, fail.Fail].err{res_source.err}; }
    var via: str = nil;
    fin { str_free(l.s.alloc, via); }
    var i: u32 = from;
    for (i < top) {
        val opt_name: opt[str] = intern.get(?l.s.interner, l.demands.data[i].name);
        if (sel opt_name.none) { ret res[intern.StrId, fail.Fail].err{fail.message("demanded constant name is not interned")}; }
        var res_next: res[str, fail.Fail];
        if (via == nil) { res_next = diagnostic.format(l.s.alloc, " through `{}`", opt_name.some); }
        or              { res_next = diagnostic.format(l.s.alloc, "{} -> `{}`", via, opt_name.some); }
        str_free(l.s.alloc, via);
        via = nil;
        if (sel res_next.err) { ret res[intern.StrId, fail.Fail].err{res_next.err}; }
        via = res_next.ok;
        i   = i + 1;
    }
    var through: str = "";
    if (via != nil) { through = via; }
    val res_type_question_message: res[intern.StrId, fail.Fail] = comptime_gate.type_question_message(?l.s.interner, syntax_of(l, mid), res_source.ok, call, through);
    ret res_type_question_message;
}

# a constant an expression names: `name` alone, or `member` of the module `name` imports
rec NameRef {
    name:   intern.StrId;
    member: intern.StrId;
}

rec NameWalk {
    l:      *Loader;
    source: str;
    a:      *ast.Ast;
    out:    *collections_vector.Vector[NameRef];
}

fun name_walk_node(w: *NameWalk, eid: ast_id.ExprId, e: *ast_expr.Expr) res[comptime_gate.GateNodeVerdict, fail.Fail] {
    var r: NameRef = NameRef{name: intern.STR_NIL, member: intern.STR_NIL};
    if (e.kind == ast_expr.EXPR_KIND_IDENT) { r.name = e.data.ident.name; }
    or (e.kind == ast_expr.EXPR_KIND_MEMBER) {
        val opt_object: opt[*ast_expr.Expr] = ast.get_expr(w.a, e.data.member.object);
        if (sel opt_object.none)                              { ret res[comptime_gate.GateNodeVerdict, fail.Fail].ok{comptime_gate.GATE_NODE_NO}; }
        if (opt_object.some.kind != ast_expr.EXPR_KIND_IDENT) { ret res[comptime_gate.GateNodeVerdict, fail.Fail].ok{comptime_gate.GATE_NODE_NO}; }
        r.name   = opt_object.some.data.ident.name;
        r.member = e.data.member.name_id;
    }
    or { ret res[comptime_gate.GateNodeVerdict, fail.Fail].ok{comptime_gate.GATE_NODE_NO}; }
    val res_pushed: res[usize, A.Error] = collections_vector.push[NameRef](w.out, r);
    if (sel res_pushed.err)                  { ret res[comptime_gate.GateNodeVerdict, fail.Fail].err{fail.refused(res_pushed.err)}; }
    if (e.kind == ast_expr.EXPR_KIND_MEMBER) { ret res[comptime_gate.GateNodeVerdict, fail.Fail].ok{comptime_gate.GATE_NODE_PRUNE}; }
    ret res[comptime_gate.GateNodeVerdict, fail.Fail].ok{comptime_gate.GATE_NODE_NO};
}

fun name_walk_expression(w: *NameWalk, a: *ast.Ast, eid: ast_id.ExprId) res[ast_expr.Expr, comptime_failure.EvalFail] {
    val opt_found: opt[*ast_expr.Expr] = ast.get_expr(a, eid);
    if (sel opt_found.none) { ret res[ast_expr.Expr, comptime_failure.EvalFail].err{comptime_failure.eval_error(comptime_failure.EVAL_FAIL_INTERNAL, diagnostic_kind.COMPILER_INTERNAL, "load: expression identity is out of range")}; }
    ret res[ast_expr.Expr, comptime_failure.EvalFail].ok{@opt_found.some};
}

# demand every constant an expression names that its module's frame does not bind yet.
# `walk` says whether the module is still loading, so a demand may walk its declarations;
# a loaded module only explains why a constant it never bound is unreadable
fun demand_names(l: *Loader, mid: module.ModuleId, eid: ast_id.ExprId, walk: bool) res[Verdict, fail.Fail] {
    val res_source: res[str, fail.Fail] = module_source(l, mid);
    if (sel res_source.err) { ret res[Verdict, fail.Fail].err{res_source.err}; }
    var names: collections_vector.Vector[NameRef] = collections_vector.init[NameRef](l.alloc);
    fin { collections_vector.dnit[NameRef](?names); }
    var w:          NameWalk             = NameWalk{l: l, source: res_source.ok, a: syntax_of(l, mid), out: ?names};
    val res_walked: res[bool, fail.Fail] = comptime_gate.gate_walk[NameWalk](w.a, w.source, ?w, name_walk_node, name_walk_expression, eid);
    if (sel res_walked.err) { ret res[Verdict, fail.Fail].err{refuse_expr(l, mid, eid, res_walked.err)}; }
    # a name the expression repeats is demanded once: its first demand left every walk it needs
    # done, so a second finds what the first did
    var seen: map.Map[u64, u8] = map.init[u64, u8](l.alloc);
    fin { map.dnit[u64, u8](?seen); }
    var i: usize = 0;
    for (i < names.len) {
        val r: NameRef = names.data[i];
        val m: *Module = module_at(l, mid);
        i = i + 1;
        val pair:      u64                = (intern.str_index(r.name)::u64 << 32) | intern.str_index(r.member)::u64;
        val res_fresh: res[bool, A.Error] = map.insert[u64, u8](?seen, pair, 0);
        if (sel res_fresh.err) { ret res[Verdict, fail.Fail].err{fail.refused(res_fresh.err)}; }
        if (!res_fresh.ok)     { cnt; }
        var v:         Verdict                        = verdict(VERDICT_BOUND);
        val opt_bound: opt[comptime_scope.NamedConst] = comptime_scope.lookup(frame_ctx(m), r.name);
        if (intern.str_is_nil(r.member)) {
            if (sel opt_bound.some) { cnt; }
            val res_demand_name: res[Verdict, fail.Fail] = demand_name(l, mid, r.name, walk);
            if (sel res_demand_name.err) { ret res_demand_name; }
            v = res_demand_name.ok;
        }
        or {
            if (sel opt_bound.none) {
                val res_demand_name: res[Verdict, fail.Fail] = demand_name(l, mid, r.name, walk);
                if (sel res_demand_name.err) { ret res_demand_name; }
                v = res_demand_name.ok;
            }
            val res_dep: res[opt[module.ModuleId], fail.Fail] = frame_mod_ref(l, mid, r.name);
            if (sel res_dep.err) { ret res[Verdict, fail.Fail].err{res_dep.err}; }
            val opt_dep: opt[module.ModuleId] = res_dep.ok;
            if (v.kind != VERDICT_REFUSED) {
                if (sel opt_dep.some) {
                    val opt_exported: opt[*Const] = const_find(module_at(l, opt_dep.some), r.member);
                    if (sel opt_exported.none) {
                        val res_demand_public: res[Verdict, fail.Fail] = demand_public(l, opt_dep.some, r.member);
                        if (sel res_demand_public.err) { ret res_demand_public; }
                        v = res_demand_public.ok;
                    }
                }
            }
        }
        if (v.kind == VERDICT_REFUSED) { ret res[Verdict, fail.Fail].ok{v}; }
    }
    ret res[Verdict, fail.Fail].ok{verdict(VERDICT_ABSENT)};
}

# find what binds `name` at module scope in the module's current frame and bring it in: a `val`
# is walked, a `use` loads its module and binds the import, and a chain with an arm that binds it
# is decided first so the demand goes on in the arm it selects
fun demand_name(l: *Loader, mid: module.ModuleId, name: intern.StrId, walk: bool) res[Verdict, fail.Fail] {
    val m:          *Module                 = module_at(l, mid);
    val opt_module: opt[*ast_module.Module] = ast.get_module(syntax_of(l, mid), syntax_of(l, mid).root_module);
    if (sel opt_module.none) { ret res[Verdict, fail.Fail].err{fail.message("module root not set on Ast")}; }
    val res_demand_in_list: res[Verdict, fail.Fail] = demand_in_list(l, mid, opt_module.some.decls_start, opt_module.some.decls_len, name, walk);
    ret res_demand_in_list;
}

# why a loaded module never bound a public constant an importer's gate reads
fun demand_public(l: *Loader, dep: module.ModuleId, name: intern.StrId) res[Verdict, fail.Fail] {
    val m:           *Module = module_at(l, dep);
    val saved_frame: u32     = m.frame;
    m.frame = FRAME_BUILD;
    val res_demand_name: res[Verdict, fail.Fail] = demand_name(l, dep, name, false);
    m.frame = saved_frame;
    ret res_demand_name;
}

fun demand_in_list(l: *Loader, mid: module.ModuleId, start: u32, len: u32, name: intern.StrId, walk: bool) res[Verdict, fail.Fail] {
    val res_source: res[str, fail.Fail] = module_source(l, mid);
    if (sel res_source.err) { ret res[Verdict, fail.Fail].err{res_source.err}; }
    val source:   str      = res_source.ok;
    val opt_text: opt[str] = intern.get(?l.s.interner, name);
    if (sel opt_text.none) { ret res[Verdict, fail.Fail].err{fail.message("demanded constant name is not interned")}; }
    val err_indexed: err[fail.Fail] = demand_index(l, mid, source);
    if (sel err_indexed.err) { ret res[Verdict, fail.Fail].err{err_indexed.err}; }
    val end:       u32       = start + len;
    var binder:    u32       = end;
    val key:       u64       = demand_key(start, name);
    val opt_found: opt[*u32] = map.get[u64, u32](?module_at(l, mid).binders.names, ?key);
    if (sel opt_found.some) { binder = @opt_found.some; }
    # the chains before the binder, in order, each of which may bind the name in its arm first
    var ci: usize = chain_from(?module_at(l, mid).binders.chains, start);
    for (ci < module_at(l, mid).binders.chains.len) {
        val at: u32 = module_at(l, mid).binders.chains.data[ci];
        ci = ci + 1;
        if (at >= binder) { brk; }
        val a:        *ast.Ast            = syntax_of(l, mid);
        val opt_decl: opt[*ast_decl.Decl] = ast.get_decl(a, a.decl_ids.data[at]);
        if (sel opt_decl.none) { ret res[Verdict, fail.Fail].err{fail.message("DeclId out of range during a demand")}; }
        var copied: ast_decl.Decl = @opt_decl.some;
        if (stack.exhausted()) { ret res[Verdict, fail.Fail].err{refuse_nesting(l, mid, copied.span)}; }
        val res_binds: res[bool, fail.Fail] = chain_may_bind(l, mid, ?copied, source, opt_text.some, false, false);
        if (sel res_binds.err) { ret res[Verdict, fail.Fail].err{res_binds.err}; }
        if (res_binds.ok) {
            val res_arm: res[ChainChoice, fail.Fail] = demand_arm(l, mid, ?copied.data.comptime_if, source, walk);
            if (sel res_arm.err) { ret res[Verdict, fail.Fail].err{res_arm.err}; }
            val arm: ChainChoice = res_arm.ok;
            if (arm.verdict.kind == VERDICT_REFUSED) { ret res[Verdict, fail.Fail].ok{arm.verdict}; }
            if (arm.branch < copied.data.comptime_if.branches_len) {
                val br:        ast_decl.ComptimeBranch = syntax_of(l, mid).comptime_branches.data[copied.data.comptime_if.branches_start + arm.branch];
                val res_inner: res[Verdict, fail.Fail] = demand_in_list(l, mid, br.body_start, br.body_len, name, walk);
                if (sel res_inner.err)                   { ret res_inner; }
                if (res_inner.ok.kind != VERDICT_ABSENT) { ret res_inner; }
            }
        }
    }
    if (binder >= end) { ret res[Verdict, fail.Fail].ok{verdict(VERDICT_ABSENT)}; }
    val a:        *ast.Ast            = syntax_of(l, mid);
    val did:      ast_id.DeclId       = a.decl_ids.data[binder];
    val opt_decl: opt[*ast_decl.Decl] = ast.get_decl(a, did);
    if (sel opt_decl.none) { ret res[Verdict, fail.Fail].err{fail.message("DeclId out of range during a demand")}; }
    var copied: ast_decl.Decl = @opt_decl.some;
    if (stack.exhausted())                     { ret res[Verdict, fail.Fail].err{refuse_nesting(l, mid, copied.span)}; }
    if (copied.kind == ast_decl.DECL_KIND_VAL) { ret demand_val(l, mid, did, walk); }
    if (!walk)                                 { ret res[Verdict, fail.Fail].ok{verdict(VERDICT_ABSENT)}; }
    ret demand_use(l, mid, did, name);
}

# the key a declaration list starting at pool position `start` files `name` under
fun demand_key(start: u32, name: intern.StrId) u64 {
    ret (start::u64 << 32) | intern.str_index(name)::u64;
}

# the first of `chains` at or after pool position `start`
fun chain_from(chains: *collections_vector.Vector[u32], start: u32) usize {
    var lo: usize = 0;
    var hi: usize = chains.len;
    for (lo < hi) {
        val mid: usize = lo + (hi - lo) / 2;
        if (chains.data[mid] < start) { lo = mid + 1; }
        or                            { hi = mid; }
    }
    ret lo;
}

# index every declaration list of a module's syntax for demands, once per syntax
fun demand_index(l: *Loader, mid: module.ModuleId, source: str) err[fail.Fail] {
    val m: *Module = module_at(l, mid);
    if (m.binders.indexed) { ret err[fail.Fail].ok{}; }
    val a:          *ast.Ast                = syntax_of(l, mid);
    val opt_module: opt[*ast_module.Module] = ast.get_module(a, a.root_module);
    if (sel opt_module.none) { ret err[fail.Fail].err{fail.message("module root not set on Ast")}; }
    val err_listed: err[fail.Fail] = demand_index_list(l, ?m.binders, a, source, opt_module.some.decls_start, opt_module.some.decls_len);
    if (sel err_listed.err) {
        map.clear[u64, u32](?m.binders.names);
        map.clear[u64, u32](?m.binders.uses);
        collections_vector.clear[u32](?m.binders.chains);
        ret err_listed;
    }
    sort.sort[u32](m.binders.chains.data, m.binders.chains.len);
    m.binders.indexed = true;
    ret err[fail.Fail].ok{};
}

fun demand_index_list(l: *Loader, ix: *DemandIndex, a: *ast.Ast, source: str, start: u32, len: u32) err[fail.Fail] {
    if (stack.exhausted()) { ret err[fail.Fail].err{nesting()}; }
    var i: u32 = 0;
    for (i < len) {
        val at:       u32                 = start + i;
        val opt_decl: opt[*ast_decl.Decl] = ast.get_decl(a, a.decl_ids.data[at]);
        i = i + 1;
        if (sel opt_decl.none) { ret err[fail.Fail].err{fail.message("DeclId out of range during a demand")}; }
        val d:     *ast_decl.Decl   = opt_decl.some;
        var bound: base_source.Span = base_source.Span{offset: 0, len: 0};
        if (d.kind == ast_decl.DECL_KIND_VAL) { bound = d.data.bind.name; }
        if (d.kind == ast_decl.DECL_KIND_USE && d.data.use_.path.len != 0) {
            bound = d.data.use_.alias;
            if (bound.len == 0) { bound = front_path.leaf(source, d.data.use_.path); }
        }
        if (bound.len != 0) {
            val res_named: res[intern.StrId, A.Error] = intern.range_add(?l.s.interner, source, bound.offset, bound.len);
            if (sel res_named.err) { ret err[fail.Fail].err{fail.refused(res_named.err)}; }
            val key: u64 = demand_key(start, res_named.ok);
            if (!map.contains[u64, u32](?ix.names, ?key)) {
                val res_added: res[bool, A.Error] = map.insert[u64, u32](?ix.names, key, at);
                if (sel res_added.err) { ret err[fail.Fail].err{fail.refused(res_added.err)}; }
            }
            if (d.kind == ast_decl.DECL_KIND_USE && !map.contains[u64, u32](?ix.uses, ?key)) {
                val res_used: res[bool, A.Error] = map.insert[u64, u32](?ix.uses, key, at);
                if (sel res_used.err) { ret err[fail.Fail].err{fail.refused(res_used.err)}; }
            }
        }
        if (d.kind == ast_decl.DECL_KIND_COMPTIME_IF) {
            val res_pushed: res[usize, A.Error] = collections_vector.push[u32](?ix.chains, at);
            if (sel res_pushed.err) { ret err[fail.Fail].err{fail.refused(res_pushed.err)}; }
            val ci: ast_decl.DeclComptimeIf = d.data.comptime_if;
            var bi: u32                     = 0;
            for (bi < ci.branches_len) {
                val br:       ast_decl.ComptimeBranch = a.comptime_branches.data[ci.branches_start + bi];
                val err_body: err[fail.Fail]          = demand_index_list(l, ix, a, source, br.body_start, br.body_len);
                if (sel err_body.err) { ret err_body; }
                bi = bi + 1;
            }
        }
    }
    ret err[fail.Fail].ok{};
}

# the arm a chain selects for a demand: decided now in a module still loading, or read from the
# states its walk left in a loaded one
fun demand_arm(l: *Loader, mid: module.ModuleId, ci: *ast_decl.DeclComptimeIf, source: str, walk: bool) res[ChainChoice, fail.Fail] {
    if (walk) { ret decide_chain(l, mid, ci, source); }
    val m:  *Module = module_at(l, mid);
    val n:  u32     = ci.branches_len;
    var bi: u32     = 0;
    for (bi < n) {
        val cond: ast_id.ExprId = syntax_of(l, mid).comptime_branches.data[ci.branches_start + bi].cond;
        if (ast_id.expr_is_nil(cond)) { ret res[ChainChoice, fail.Fail].ok{chain_choice(comptime_gate.GATE_ACTIVE, bi, verdict(VERDICT_ABSENT))}; }
        val state: comptime_scope.GateState = comptime_scope.gate_state(frame_ctx(m), cond);
        if (state == comptime_scope.GATE_STATE_TRUE)  { ret res[ChainChoice, fail.Fail].ok{chain_choice(comptime_gate.GATE_ACTIVE, bi, verdict(VERDICT_ABSENT))}; }
        if (state != comptime_scope.GATE_STATE_FALSE) { brk; }
        bi = bi + 1;
    }
    ret res[ChainChoice, fail.Fail].ok{chain_choice(comptime_gate.GATE_INACTIVE, n, verdict(VERDICT_ABSENT))};
}

fun use_binds(source: str, du: *ast_decl.DeclUse, text: str) bool {
    if (du.path.len == 0) { ret false; }
    var bound: base_source.Span = du.alias;
    if (bound.len == 0) { bound = front_path.leaf(source, du.path); }
    ret spells(source, bound, text);
}

# whether any arm of a chain, at any depth, declares `text` as a constant or imports it
fun chain_binds(a: *ast.Ast, source: str, ci: *ast_decl.DeclComptimeIf, text: str) res[bool, fail.Fail] {
    if (stack.exhausted()) { ret res[bool, fail.Fail].err{nesting()}; }
    var bi: u32 = 0;
    for (bi < ci.branches_len) {
        val br:        *ast_decl.ComptimeBranch = ?a.comptime_branches.data[ci.branches_start + bi];
        val res_binds: res[bool, fail.Fail]     = list_binds(a, source, br.body_start, br.body_len, text);
        if (sel res_binds.err) { ret res_binds; }
        if (res_binds.ok)      { ret res_binds; }
        bi = bi + 1;
    }
    ret res[bool, fail.Fail].ok{false};
}

fun list_binds(a: *ast.Ast, source: str, start: u32, len: u32, text: str) res[bool, fail.Fail] {
    var i: u32 = 0;
    for (i < len) {
        val opt_decl: opt[*ast_decl.Decl] = ast.get_decl(a, a.decl_ids.data[start + i]);
        if (sel opt_decl.some) {
            val d: *ast_decl.Decl = opt_decl.some;
            if (d.kind == ast_decl.DECL_KIND_VAL && spells(source, d.data.bind.name, text)) { ret res[bool, fail.Fail].ok{true}; }
            if (d.kind == ast_decl.DECL_KIND_USE && use_binds(source, ?d.data.use_, text))  { ret res[bool, fail.Fail].ok{true}; }
            if (d.kind == ast_decl.DECL_KIND_COMPTIME_IF) {
                val res_binds: res[bool, fail.Fail] = chain_binds(a, source, ?d.data.comptime_if, text);
                if (sel res_binds.err) { ret res_binds; }
                if (res_binds.ok)      { ret res_binds; }
            }
        }
        i = i + 1;
    }
    ret res[bool, fail.Fail].ok{false};
}

# whether the chain declaration `d` may bind `text`: it declares something and an arm at any
# depth binds the name, as a constant or import (chain_binds) or as a def chain reads it
# (`types`, chain_names_type); a chain nested deeper than the walk can descend is refused at `d`
fun chain_may_bind(l: *Loader, mid: module.ModuleId, d: *ast_decl.Decl, source: str, text: str, types: bool, local: bool) res[bool, fail.Fail] {
    if (d.kind != ast_decl.DECL_KIND_COMPTIME_IF) { ret res[bool, fail.Fail].ok{false}; }
    val a:           *ast.Ast             = syntax_of(l, mid);
    val res_nothing: res[bool, fail.Fail] = comptime_gate.comptime_if_declares_nothing(a, d.data.comptime_if.branches_start, d.data.comptime_if.branches_len);
    if (sel res_nothing.err) { ret res[bool, fail.Fail].err{refuse(l, mid, d.span, res_nothing.err)}; }
    if (res_nothing.ok)      { ret res[bool, fail.Fail].ok{false}; }
    var res_binds: res[bool, fail.Fail] = res[bool, fail.Fail].ok{false};
    if (types)             { res_binds = chain_names_type(a, source, ?d.data.comptime_if, text, local); }
    or                     { res_binds = chain_binds(a, source, ?d.data.comptime_if, text); }
    if (sel res_binds.err) { ret res[bool, fail.Fail].err{refuse(l, mid, d.span, res_binds.err)}; }
    ret res_binds;
}

fun demand_val(l: *Loader, mid: module.ModuleId, did: ast_id.DeclId, walk: bool) res[Verdict, fail.Fail] {
    val m:        *Module             = module_at(l, mid);
    val opt_decl: opt[*ast_decl.Decl] = ast.get_decl(syntax_of(l, mid), did);
    if (sel opt_decl.none) { ret res[Verdict, fail.Fail].err{fail.message("DeclId out of range during a demand")}; }
    val name_span:  base_source.Span    = opt_decl.some.data.bind.name;
    val res_source: res[str, fail.Fail] = module_source(l, mid);
    if (sel res_source.err) { ret res[Verdict, fail.Fail].err{res_source.err}; }
    val res_name: res[intern.StrId, A.Error] = intern.range_add(?l.s.interner, res_source.ok, name_span.offset, name_span.len);
    if (sel res_name.err) { ret res[Verdict, fail.Fail].err{fail.refused(res_name.err)}; }
    val opt_bound: opt[comptime_scope.NamedConst] = comptime_scope.lookup(frame_ctx(m), res_name.ok);
    if (sel opt_bound.some) { ret res[Verdict, fail.Fail].ok{verdict(VERDICT_BOUND)}; }
    val opt_open: opt[u32] = demand_find(l, mid, m.frame, did, ast_id.EXPR_NIL);
    if (sel opt_open.some)          { ret cycle_verdict(l, opt_open.some); }
    if (walked_at(m, m.frame, did)) { ret val_reason(l, mid, did); }
    if (!walk)                      { ret res[Verdict, fail.Fail].ok{verdict(VERDICT_ABSENT)}; }
    ret walk_val(l, mid, did);
}

fun demand_use(l: *Loader, mid: module.ModuleId, did: ast_id.DeclId, name: intern.StrId) res[Verdict, fail.Fail] {
    val m:          *Module                                   = module_at(l, mid);
    val res_walked: res[comptime_gate.GateOutcome, fail.Fail] = walk_one_decl_for_load(l, mid, did);
    if (sel res_walked.err) { ret res[Verdict, fail.Fail].err{res_walked.err}; }
    val opt_bound: opt[comptime_scope.NamedConst] = comptime_scope.lookup(frame_ctx(m), name);
    if (sel opt_bound.some) { ret res[Verdict, fail.Fail].ok{verdict(VERDICT_BOUND)}; }
    # a module name is no constant; an import that bound none lets its module say why
    val opt_recorded: opt[*Binding] = binding_for(m, did);
    if (sel opt_recorded.some && opt_recorded.some.kind == BINDING_MODULE) { ret res[Verdict, fail.Fail].ok{verdict(VERDICT_ABSENT)}; }
    val opt_decl: opt[*ast_decl.Decl] = ast.get_decl(syntax_of(l, mid), did);
    if (sel opt_decl.none) { ret res[Verdict, fail.Fail].err{fail.message("DeclId out of range during a demand")}; }
    val path:       base_source.Span    = opt_decl.some.data.use_.path;
    val res_source: res[str, fail.Fail] = module_source(l, mid);
    if (sel res_source.err) { ret res[Verdict, fail.Fail].err{res_source.err}; }
    val res_tgt: res[UseTarget, fail.Fail] = use_target(l, res_source.ok, path);
    if (sel res_tgt.err)         { ret res[Verdict, fail.Fail].ok{verdict(VERDICT_ABSENT)}; }
    if (res_tgt.ok.binds_module) { ret res[Verdict, fail.Fail].ok{verdict(VERDICT_ABSENT)}; }
    val opt_entry: opt[module.ModuleId] = module_find(l, res_tgt.ok.module_fqn);
    if (sel opt_entry.none) { ret res[Verdict, fail.Fail].ok{verdict(VERDICT_ABSENT)}; }
    ret demand_public(l, opt_entry.some, res_tgt.ok.leaf);
}

# why a constant the walk reached is unbound: a constant it reads is refused, or its own value
# asks a type question
fun val_reason(l: *Loader, mid: module.ModuleId, did: ast_id.DeclId) res[Verdict, fail.Fail] {
    val m:        *Module             = module_at(l, mid);
    val opt_decl: opt[*ast_decl.Decl] = ast.get_decl(syntax_of(l, mid), did);
    if (sel opt_decl.none) { ret res[Verdict, fail.Fail].err{fail.message("DeclId out of range during a demand")}; }
    var copied: ast_decl.Decl = @opt_decl.some;
    if (copied.data.bind.name.len == 0 || ast_id.expr_is_nil(copied.data.bind.init)) { ret res[Verdict, fail.Fail].ok{verdict(VERDICT_ABSENT)}; }
    val res_source: res[str, fail.Fail] = module_source(l, mid);
    if (sel res_source.err) { ret res[Verdict, fail.Fail].err{res_source.err}; }
    val res_name: res[intern.StrId, A.Error] = intern.range_add(?l.s.interner, res_source.ok, copied.data.bind.name.offset, copied.data.bind.name.len);
    if (sel res_name.err) { ret res[Verdict, fail.Fail].err{fail.refused(res_name.err)}; }
    val res_index: res[u32, fail.Fail] = demand_push(l, mid, did, ast_id.EXPR_NIL, res_name.ok);
    if (sel res_index.err) { ret res[Verdict, fail.Fail].err{res_index.err}; }
    val res_unbound_reason: res[Verdict, fail.Fail] = unbound_reason(l, mid, ?copied, res_name.ok, false);
    demand_pop(l);
    ret res_unbound_reason;
}

# the reason a constant on top of the demand stack is unbound, which only a gate below it reports:
# a constant it reads is refused, its value asks a type question, or its type is no integer
fun unbound_reason(l: *Loader, mid: module.ModuleId, d: *ast_decl.Decl, name: intern.StrId, demanded: bool) res[Verdict, fail.Fail] {
    val init:      ast_id.ExprId = d.data.bind.init;
    val opt_owner: opt[u32]      = demand_gate_at_or_below(l, l.demands.len::u32 - 1);
    if (sel opt_owner.none) { ret res[Verdict, fail.Fail].ok{verdict(VERDICT_ABSENT)}; }
    if (!demanded) {
        val res_deps: res[Verdict, fail.Fail] = demand_names(l, mid, init, false);
        if (sel res_deps.err)                    { ret res_deps; }
        if (res_deps.ok.kind == VERDICT_REFUSED) { ret res_deps; }
    }
    val res_source: res[str, fail.Fail] = module_source(l, mid);
    if (sel res_source.err) { ret res[Verdict, fail.Fail].err{res_source.err}; }
    val res_question: res[ast_id.ExprId, fail.Fail] = comptime_gate.type_question(syntax_of(l, mid), res_source.ok, init);
    if (sel res_question.err) { ret res[Verdict, fail.Fail].err{refuse_expr(l, mid, init, res_question.err)}; }
    if (ast_id.expr_is_nil(res_question.ok)) {
        if (ast_id.type_is_nil(d.data.bind.ty)) { ret res[Verdict, fail.Fail].ok{verdict(VERDICT_ABSENT)}; }
        var w: DeclaredWalk;
        w.l     = l;
        w.steps = collections_vector.init[intern.StrId](l.alloc);
        fin { collections_vector.dnit[intern.StrId](?w.steps); }
        val res_declared: res[DeclaredInt, fail.Fail] = declared_type(?w, mid, d.data.bind.ty, 0);
        if (sel res_declared.err)                      { ret res[Verdict, fail.Fail].err{res_declared.err}; }
        if (res_declared.ok.class != DECLARED_NON_INT) { ret res[Verdict, fail.Fail].ok{verdict(VERDICT_ABSENT)}; }
        val res_refusal: res[intern.StrId, fail.Fail] = non_integer_message(l, name, ?w.steps);
        if (sel res_refusal.err) { ret res[Verdict, fail.Fail].err{res_refusal.err}; }
        ret res[Verdict, fail.Fail].ok{Verdict{kind: VERDICT_REFUSED, head: l.demands.len::u32 - 1, diag: diagnostic_kind.GATE_CONST_NOT_INTEGER, message: res_refusal.ok}};
    }
    val top:      u32                          = l.demands.len::u32;
    val res_text: res[intern.StrId, fail.Fail] = type_question_message(l, mid, res_question.ok, opt_owner.some + 1, top);
    if (sel res_text.err) { ret res[Verdict, fail.Fail].err{res_text.err}; }
    ret res[Verdict, fail.Fail].ok{Verdict{kind: VERDICT_REFUSED, head: top - 1, diag: diagnostic_kind.GATE_TYPE_QUESTION, message: res_text.ok}};
}

# walk a module-scope constant in the module's current frame: every constant its value names is
# demanded first, then it is evaluated and bound, and a public one in the build target's frame is
# exported to the gates of its importers
fun walk_val(l: *Loader, mid: module.ModuleId, did: ast_id.DeclId) res[Verdict, fail.Fail] {
    val m:        *Module             = module_at(l, mid);
    val opt_decl: opt[*ast_decl.Decl] = ast.get_decl(syntax_of(l, mid), did);
    if (sel opt_decl.none) { ret res[Verdict, fail.Fail].err{fail.message("DeclId out of range during walk")}; }
    var copied: ast_decl.Decl = @opt_decl.some;
    if (copied.data.bind.name.len == 0 || ast_id.expr_is_nil(copied.data.bind.init)) {
        walked_mark(m, did);
        ret res[Verdict, fail.Fail].ok{verdict(VERDICT_ABSENT)};
    }
    val res_source: res[str, fail.Fail] = module_source(l, mid);
    if (sel res_source.err) { ret res[Verdict, fail.Fail].err{res_source.err}; }
    val res_name: res[intern.StrId, A.Error] = intern.range_add(?l.s.interner, res_source.ok, copied.data.bind.name.offset, copied.data.bind.name.len);
    if (sel res_name.err) { ret res[Verdict, fail.Fail].err{fail.refused(res_name.err)}; }
    val res_index: res[u32, fail.Fail] = demand_push(l, mid, did, ast_id.EXPR_NIL, res_name.ok);
    if (sel res_index.err) { ret res[Verdict, fail.Fail].err{res_index.err}; }
    val res_bind_val: res[Verdict, fail.Fail] = bind_val(l, mid, ?copied, res_source.ok, res_name.ok);
    demand_pop(l);
    walked_mark(module_at(l, mid), did);
    ret res_bind_val;
}

fun bind_val(l: *Loader, mid: module.ModuleId, d: *ast_decl.Decl, source: str, name: intern.StrId) res[Verdict, fail.Fail] {
    # an array is never evaluated, so the names it reads matter only to a gate that demanded it
    if (initializer_is_array(l, mid, d.data.bind.init)) {
        val opt_owner: opt[u32] = demand_gate_at_or_below(l, l.demands.len::u32 - 1);
        if (sel opt_owner.none) { ret res[Verdict, fail.Fail].ok{verdict(VERDICT_ABSENT)}; }
    }
    val res_deps: res[Verdict, fail.Fail] = demand_names(l, mid, d.data.bind.init, true);
    if (sel res_deps.err)                    { ret res_deps; }
    if (res_deps.ok.kind == VERDICT_REFUSED) { ret res_deps; }
    val m: *Module = module_at(l, mid);
    # a constant tag is bound as its own literal, which a gate's `sel` reads; it points into this
    # module's syntax, so no importer reads it
    val res_tag: res[bool, fail.Fail] = constant_tag(l, mid, d.data.bind.init, source);
    if (sel res_tag.err) { ret res[Verdict, fail.Fail].err{res_tag.err}; }
    val res_secret: res[bool, fail.Fail] = declared_secret(l, mid, d.data.bind.ty, 0);
    if (sel res_secret.err) { ret res[Verdict, fail.Fail].err{res_secret.err}; }
    if (res_tag.ok) {
        var elem: comptime_value.CTValue = comptime_value.const_elem_untyped(d.data.bind.init::u32);
        elem.secret = res_secret.ok;
        val err_tagged: err[fail.Fail] = comptime_scope.bind(frame_ctx(m), name, elem);
        if (sel err_tagged.err) { ret res[Verdict, fail.Fail].err{err_tagged.err}; }
        ret res[Verdict, fail.Fail].ok{verdict(VERDICT_BOUND)};
    }
    val fw:                float.FloatWidth                                       = comptime.declared_float_width(syntax_of(l, mid), source, d.data.bind.ty);
    val res_eval_for_load: res[comptime_value.CTValue, comptime_failure.EvalFail] = eval_for_load(l, mid, source, d.data.bind.init, fw, res_secret.ok);
    if (sel res_eval_for_load.err) { ret unbound_reason(l, mid, d, name, true); }
    val res_typed: res[comptime_value.CTValue, fail.Fail] = declared_value(l, mid, name, d.data.bind.ty, res_eval_for_load.ok);
    if (sel res_typed.err) { ret res[Verdict, fail.Fail].err{res_typed.err}; }
    var v: comptime_value.CTValue = res_typed.ok;
    v.secret = res_secret.ok;

    if (comptime_value.float_width_unread(v)) {
        val err_deferred: err[fail.Fail] = comptime_scope.defer_float_width(frame_ctx(m), name);
        if (sel err_deferred.err) { ret res[Verdict, fail.Fail].err{err_deferred.err}; }
        ret res[Verdict, fail.Fail].ok{verdict(VERDICT_ABSENT)};
    }

    val err_bind: err[fail.Fail] = comptime_scope.bind(frame_ctx(m), name, v);
    if (sel err_bind.err) { ret res[Verdict, fail.Fail].err{err_bind.err}; }

    if ((d.flags & ast_decl.DECL_FLAG_PUB) != 0 && m.frame == FRAME_BUILD) {
        val err_added: err[fail.Fail] = const_add(l, m, name, v);
        if (sel err_added.err) { ret res[Verdict, fail.Fail].err{err_added.err}; }
    }
    ret res[Verdict, fail.Fail].ok{verdict(VERDICT_BOUND)};
}

fun initializer_is_array(l: *Loader, mid: module.ModuleId, init: ast_id.ExprId) bool {
    val opt_init: opt[*ast_expr.Expr] = ast.get_expr(syntax_of(l, mid), init);
    if (sel opt_init.none) { ret false; }
    ret opt_init.some.kind == ast_expr.EXPR_KIND_ARRAY_LIT;
}

# whether a constant's value is a case literal of a type declared in its own module, `T.c{...}`:
# the head reads as type and case as name resolution reads it, so a gate reads the case now
fun constant_tag(l: *Loader, mid: module.ModuleId, init: ast_id.ExprId, source: str) res[bool, fail.Fail] {
    val opt_init: opt[*ast_expr.Expr] = ast.get_expr(syntax_of(l, mid), init);
    if (sel opt_init.none) { ret res[bool, fail.Fail].ok{false}; }
    val tid: ast_id.TypeId = comptime.literal_head_type(opt_init.some);
    if (ast_id.type_is_nil(tid)) { ret res[bool, fail.Fail].ok{false}; }
    val res_head: res[opt[ast_type.Type], fail.Fail] = constant_head(l, mid, tid, source);
    if (sel res_head.err)     { ret res[bool, fail.Fail].err{res_head.err}; }
    if (sel res_head.ok.none) { ret res[bool, fail.Fail].ok{false}; }
    ret res[bool, fail.Fail].ok{comptime.names_case(res_head.ok.some)};
}

# the head `tid` of a literal as the load reads it: the parser's case, or a bare `T.c` whose prefix
# is a single name this module declares as a type, split into that type and case; none for a
# head that names no case. the parsed tree is never rewritten
fun constant_head(l: *Loader, mid: module.ModuleId, tid: ast_id.TypeId, source: str) res[opt[ast_type.Type], fail.Fail] {
    val opt_type: opt[*ast_type.Type] = ast.get_type(syntax_of(l, mid), tid);
    if (sel opt_type.none) { ret res[opt[ast_type.Type], fail.Fail].ok{opt[ast_type.Type].none{}}; }
    val t: ast_type.Type = @opt_type.some;
    if (t.kind != ast_type.TYPE_KIND_NAMED) { ret res[opt[ast_type.Type], fail.Fail].ok{opt[ast_type.Type].none{}}; }
    if (comptime.names_case(t))             { ret res[opt[ast_type.Type], fail.Fail].ok{opt[ast_type.Type].some{t}}; }
    val path: base_source.Span = t.data.named.name;
    val pre:  base_source.Span = front_path.prefix(source, path);
    if (pre.len == 0 || pre.len >= path.len || front_path.prefix(source, pre).len != 0) { ret res[opt[ast_type.Type], fail.Fail].ok{opt[ast_type.Type].none{}}; }
    val leaf: base_source.Span = front_path.leaf(source, path);
    if (leaf.len == 0) { ret res[opt[ast_type.Type], fail.Fail].ok{opt[ast_type.Type].none{}}; }
    val res_pre: res[intern.StrId, A.Error] = intern.range_add(?l.s.interner, source, pre.offset, pre.len);
    if (sel res_pre.err) { ret res[opt[ast_type.Type], fail.Fail].err{fail.refused(res_pre.err)}; }
    val res_module_meaning: res[Meaning, fail.Fail] = module_meaning(l, mid, res_pre.ok, true);
    if (sel res_module_meaning.err)                                                                 { ret res[opt[ast_type.Type], fail.Fail].err{res_module_meaning.err}; }
    if (res_module_meaning.ok.kind != MEANING_NOMINAL && res_module_meaning.ok.kind != MEANING_DEF) { ret res[opt[ast_type.Type], fail.Fail].ok{opt[ast_type.Type].none{}}; }
    val res_split: res[ast_type.Type, fail.Fail] = interpretation.split(t, source);
    if (sel res_split.err) { ret res[opt[ast_type.Type], fail.Fail].err{res_split.err}; }
    ret res[opt[ast_type.Type], fail.Fail].ok{opt[ast_type.Type].some{res_split.ok}};
}

# a type node as a load evaluation reads it: a constant tag's head split as `constant_head` splits
# it, any other as parsed
fun load_head(lc: *LoadMemberCtx, a: *ast.Ast, tid: ast_id.TypeId) res[ast_type.Type, comptime_failure.EvalFail] {
    if (lc == nil || syntax_of(lc.l, lc.mid) != a) { ret res[ast_type.Type, comptime_failure.EvalFail].err{comptime_failure.eval_error(comptime_failure.EVAL_FAIL_INTERNAL, diagnostic_kind.COMPILER_INTERNAL, "load type belongs to a different parsed owner")}; }
    val opt_type: opt[*ast_type.Type] = ast.get_type(a, tid);
    if (sel opt_type.none) { ret res[ast_type.Type, comptime_failure.EvalFail].err{comptime_failure.eval_error(comptime_failure.EVAL_FAIL_INTERNAL, diagnostic_kind.COMPILER_INTERNAL, "load type identity is out of range")}; }
    val res_source: res[str, fail.Fail] = module_source(lc.l, lc.mid);
    if (sel res_source.err) { ret res[ast_type.Type, comptime_failure.EvalFail].err{comptime_failure.eval_error(comptime_failure.EVAL_FAIL_INTERNAL, diagnostic_kind.COMPILER_INTERNAL, fail.describe(res_source.err))}; }
    val res_head: res[opt[ast_type.Type], fail.Fail] = constant_head(lc.l, lc.mid, tid, res_source.ok);
    if (sel res_head.err)     { ret res[ast_type.Type, comptime_failure.EvalFail].err{comptime_failure.eval_error(comptime_failure.EVAL_FAIL_INTERNAL, diagnostic_kind.COMPILER_INTERNAL, fail.describe(res_head.err))}; }
    if (sel res_head.ok.some) { ret res[ast_type.Type, comptime_failure.EvalFail].ok{res_head.ok.some}; }
    ret res[ast_type.Type, comptime_failure.EvalFail].ok{@opt_type.some};
}

# a cast the load can evaluate: to the integer primitive its destination names, directly or through
# a def chain; any other waits for a type the load does not have
fun load_cast(lc: *LoadMemberCtx, eid: ast_id.ExprId, value: comptime_value.CTValue) res[comptime_value.CTValue, comptime_failure.EvalFail] {
    val opt_expr: opt[*ast_expr.Expr] = ast.get_expr(syntax_of(lc.l, lc.mid), eid);
    if (sel opt_expr.none) { ret res[comptime_value.CTValue, comptime_failure.EvalFail].err{comptime_failure.eval_error(comptime_failure.EVAL_FAIL_INTERNAL, diagnostic_kind.COMPILER_INTERNAL, "load cast names no expression")}; }
    val node: *ast_expr.Expr = opt_expr.some;
    if (node.kind != ast_expr.EXPR_KIND_CAST) { ret res[comptime_value.CTValue, comptime_failure.EvalFail].err{comptime_failure.eval_error(comptime_failure.EVAL_FAIL_INTERNAL, diagnostic_kind.COMPILER_INTERNAL, "load cast capability requires a cast expression")}; }
    val untyped: comptime_failure.EvalFail = comptime_failure.eval_error(comptime_failure.EVAL_FAIL_NEEDS_TYPES, diagnostic_kind.COMPTIME_CAST_UNTYPED, "a comptime cast requires its resolved source and destination types");
    if (node.data.cast.reinterpret) { ret res[comptime_value.CTValue, comptime_failure.EvalFail].err{untyped}; }
    var w: DeclaredWalk;
    w.l     = lc.l;
    w.steps = collections_vector.init[intern.StrId](lc.l.alloc);
    fin { collections_vector.dnit[intern.StrId](?w.steps); }
    val res_declared: res[DeclaredInt, fail.Fail] = declared_type(?w, lc.mid, node.data.cast.ty, 0);
    if (sel res_declared.err)                  { ret res[comptime_value.CTValue, comptime_failure.EvalFail].err{comptime_failure.eval_error(comptime_failure.EVAL_FAIL_INTERNAL, diagnostic_kind.COMPILER_INTERNAL, fail.describe(res_declared.err))}; }
    if (res_declared.ok.class != DECLARED_INT) { ret res[comptime_value.CTValue, comptime_failure.EvalFail].err{untyped}; }
    ret comptime_value.cast_to_int(value, res_declared.ok.width, !res_declared.ok.unsigned);
}

# the context the load walk reads and binds in for a module: its build target's, or the union
# tuple frame the walk is deciding a chain in
fun frame_ctx(m: *Module) *comptime_scope.ComptimeCtx {
    ret frame_ctx_at(m, m.frame);
}

fun frame_ctx_at(m: *Module, frame: u32) *comptime_scope.ComptimeCtx {
    if (frame == FRAME_BUILD) { ret ?m.ctx; }
    ret ?m.frames[frame];
}

# a module's union tuple frames, made on first use: its context under each tuple's target, with
# nothing bound and nothing decided
fun ensure_tuple_frames(l: *Loader, mid: module.ModuleId) err[fail.Fail] {
    val m: *Module = module_at(l, mid);
    if (m.frames != nil || l.tuple_count == 0) { ret err[fail.Fail].ok{}; }
    val res_allocate: res[*comptime_scope.ComptimeCtx, A.Error] = A.allocate[comptime_scope.ComptimeCtx](l.alloc, l.tuple_count::usize);
    if (sel res_allocate.err) { ret err[fail.Fail].err{fail.refused(res_allocate.err)}; }
    val frames: *comptime_scope.ComptimeCtx = res_allocate.ok;
    var made:   u32                         = 0;
    for (made < l.tuple_count) {
        val res_ctx: res[comptime_scope.ComptimeCtx, fail.Fail] = module_context(l, fqn_of(l, mid), ?m.home, m.artifact);
        if (sel res_ctx.err) {
            var ri: u32 = 0;
            for (ri < made) {
                comptime_scope.dnit(?frames[ri]);
                ri = ri + 1;
            }
            A.deallocate[comptime_scope.ComptimeCtx](l.alloc, frames, l.tuple_count::usize);
            ret err[fail.Fail].err{res_ctx.err};
        }
        frames[made] = res_ctx.ok;
        apply_tuple_target(?frames[made], ?l.tuples[made]);
        made = made + 1;
    }
    m.frames      = frames;
    m.frame_count = l.tuple_count;
    val a:  *ast.Ast = syntax_of(l, mid);
    var ti: u32      = 0;
    for (ti < m.frame_count) {
        val err_prepared: err[fail.Fail] = comptime_scope.prepare_gates(?m.frames[ti], a.exprs.len::u32);
        if (sel err_prepared.err) { ret err_prepared; }
        ti = ti + 1;
    }
    if (m.decl_count == 0) { ret err[fail.Fail].ok{}; }
    val res_marks: res[*bool, fail.Fail] = marks_init(l.alloc, m.frame_count * m.decl_count);
    if (sel res_marks.err) { ret err[fail.Fail].err{res_marks.err}; }
    m.frame_walked = res_marks.ok;
    ret err[fail.Fail].ok{};
}

# size a module's gate decisions and walk marks for its tree `a`, with nothing decided or reached
fun walk_prepare(l: *Loader, m: *Module, a: *ast.Ast) err[fail.Fail] {
    val err_gates: err[fail.Fail] = comptime_scope.prepare_gates(?m.ctx, a.exprs.len::u32);
    if (sel err_gates.err) { ret err_gates; }
    m.decl_count = a.decls.len::u32;
    if (m.decl_count == 0) { ret err[fail.Fail].ok{}; }
    val res_marks: res[*bool, fail.Fail] = marks_init(l.alloc, m.decl_count);
    if (sel res_marks.err) { ret err[fail.Fail].err{res_marks.err}; }
    m.walked = res_marks.ok;
    ret err[fail.Fail].ok{};
}

fun marks_init(a: *A.Allocator, count: u32) res[*bool, fail.Fail] {
    val res_allocate: res[*bool, A.Error] = A.allocate[bool](a, count::usize);
    if (sel res_allocate.err) { ret res[*bool, fail.Fail].err{fail.refused(res_allocate.err)}; }
    var i: u32 = 0;
    for (i < count) {
        res_allocate.ok[i] = false;
        i                  = i + 1;
    }
    ret res[*bool, fail.Fail].ok{res_allocate.ok};
}

fun walked_dnit(a: *A.Allocator, m: *Module) {
    if (m.walked != nil)       { A.deallocate[bool](a, m.walked, m.decl_count::usize); }
    if (m.frame_walked != nil) { A.deallocate[bool](a, m.frame_walked, (m.frame_count * m.decl_count)::usize); }
    m.walked       = nil;
    m.frame_walked = nil;
    m.decl_count   = 0;
    map.clear[u64, u32](?m.binders.names);
    map.clear[u64, u32](?m.binders.uses);
    collections_vector.clear[u32](?m.binders.chains);
    m.binders.indexed = false;
}

fun walked_slot(m: *Module, frame: u32, did: ast_id.DeclId) *bool {
    if (ast_id.decl_is_nil(did) || ast_id.decl_index(did) >= m.decl_count) { ret nil; }
    if (frame == FRAME_BUILD) {
        if (m.walked == nil) { ret nil; }
        ret ?m.walked[ast_id.decl_index(did)];
    }
    if (m.frame_walked == nil || frame >= m.frame_count) { ret nil; }
    ret ?m.frame_walked[frame * m.decl_count + ast_id.decl_index(did)];
}

# whether the walk reached a declaration in the frame `frame`
fun walked_at(m: *Module, frame: u32, did: ast_id.DeclId) bool {
    val slot: *bool = walked_slot(m, frame, did);
    ret slot != nil && @slot;
}

# mark a declaration reached in the frame the walk is in
fun walked_mark(m: *Module, did: ast_id.DeclId) {
    val slot: *bool = walked_slot(m, m.frame, did);
    if (slot != nil) { @slot = true; }
}

# whether the walk reached a declaration in the module's build target's frame
pub fun walked(m: *Module, did: ast_id.DeclId) bool {
    ret walked_at(m, FRAME_BUILD, did);
}

# mark in `reached`, by module index, every module the build target's own frame reaches from the
# modules marked there already: through each import declaration at module scope and in each arm
# its frame selected. a module the union loaded only under another tuple's arms stays unmarked
pub fun build_reach(l: *Loader, reached: *bool) err[fail.Fail] {
    var work: collections_vector.Vector[module.ModuleId] = collections_vector.init[module.ModuleId](l.alloc);
    fin { collections_vector.dnit[module.ModuleId](?work); }
    var i: u32 = 0;
    for (i < module_count(l)) {
        if (reached[i]) {
            val res_pushed: res[usize, A.Error] = collections_vector.push[module.ModuleId](?work, i::module.ModuleId);
            if (sel res_pushed.err) { ret err[fail.Fail].err{fail.refused(res_pushed.err)}; }
        }
        i = i + 1;
    }
    for (work.len > 0) {
        val mid: module.ModuleId = work.data[work.len - 1];
        collections_vector.truncate[module.ModuleId](?work, work.len - 1);
        val a: *ast.Ast = syntax_of(l, mid);
        if (a == nil) { cnt; }
        val opt_module: opt[*ast_module.Module] = ast.get_module(a, a.root_module);
        if (sel opt_module.none) { cnt; }
        val err_walked: err[fail.Fail] = reach_in_list(l, mid, opt_module.some.decls_start, opt_module.some.decls_len, reached, ?work);
        if (sel err_walked.err) { ret err_walked; }
    }
    ret err[fail.Fail].ok{};
}

fun reach_in_list(l: *Loader, mid: module.ModuleId, start: u32, len: u32, reached: *bool, work: *collections_vector.Vector[module.ModuleId]) err[fail.Fail] {
    val m: *Module  = module_at(l, mid);
    val a: *ast.Ast = syntax_of(l, mid);
    var i: u32      = 0;
    for (i < len) {
        val did:      ast_id.DeclId       = a.decl_ids.data[start + i];
        val opt_decl: opt[*ast_decl.Decl] = ast.get_decl(a, did);
        i = i + 1;
        if (sel opt_decl.none) { cnt; }
        val d: *ast_decl.Decl = opt_decl.some;
        if (d.kind == ast_decl.DECL_KIND_COMPTIME_IF) {
            if (stack.exhausted()) { ret err[fail.Fail].err{refuse_nesting(l, mid, d.span)}; }
            val ci: *ast_decl.DeclComptimeIf = ?d.data.comptime_if;
            var bi: u32                      = 0;
            for (bi < ci.branches_len) {
                val br:    *ast_decl.ComptimeBranch = ?a.comptime_branches.data[ci.branches_start + bi];
                val state: comptime_scope.GateState = comptime_scope.gate_state(?m.ctx, br.cond);
                if (ast_id.expr_is_nil(br.cond) || state == comptime_scope.GATE_STATE_TRUE) {
                    val err_inner: err[fail.Fail] = reach_in_list(l, mid, br.body_start, br.body_len, reached, work);
                    if (sel err_inner.err) { ret err_inner; }
                    brk;
                }
                if (state != comptime_scope.GATE_STATE_FALSE) { brk; }
                bi = bi + 1;
            }
            cnt;
        }
        if (d.kind != ast_decl.DECL_KIND_USE && d.kind != ast_decl.DECL_KIND_FWD) { cnt; }
        val opt_binding_for: opt[*Binding] = binding_for(m, did);
        if (sel opt_binding_for.none)                     { cnt; }
        if (opt_binding_for.some.kind == BINDING_UNBOUND) { cnt; }
        val dep: module.ModuleId = module_of(l, opt_binding_for.some.module);
        if (module.is_nil(dep) || reached[module.index(dep)]) { cnt; }
        reached[module.index(dep)] = true;
        val res_pushed: res[usize, A.Error] = collections_vector.push[module.ModuleId](work, dep);
        if (sel res_pushed.err) { ret err[fail.Fail].err{fail.refused(res_pushed.err)}; }
    }
    ret err[fail.Fail].ok{};
}

# release a module's walked frames; a module with no frames owns none
fun frames_dnit(l: *Loader, m: *Module) {
    if (m.frame_walked != nil) { A.deallocate[bool](l.alloc, m.frame_walked, (m.frame_count * m.decl_count)::usize); }
    m.frame_walked = nil;
    if (m.frames == nil) { ret; }
    var ti: u32 = 0;
    for (ti < m.frame_count) {
        comptime_scope.dnit(?m.frames[ti]);
        ti = ti + 1;
    }
    A.deallocate[comptime_scope.ComptimeCtx](l.alloc, m.frames, m.frame_count::usize);
    m.frames      = nil;
    m.frame_count = 0;
}

fun apply_tuple_target(c: *comptime_scope.ComptimeCtx, t: *Tuple) {
    c.env.target              = t.target;
    c.env.build.os_name       = t.os_name;
    c.env.build.isa_name      = t.isa_name;
    c.env.build.abi_name      = t.abi_name;
    c.env.build.platform_name = t.platform_name;
}

# a `use` whose path names no module is reported here, with the dependency remedy the loader
# alone knows, and binds nothing: the module's load is rejected, the walk goes on so the rest of
# the module still resolves, and its unbound record tells resolve to say nothing more about it
fun walk_use_for_load(l: *Loader, mid: module.ModuleId, did: ast_id.DeclId, du: *ast_decl.DeclUse) err[fail.Fail] {
    if (du.path.len == 0) { ret err[fail.Fail].ok{}; }
    val m:          *Module             = module_at(l, mid);
    val res_source: res[str, fail.Fail] = module_source(l, mid);
    if (sel res_source.err) { ret err[fail.Fail].err{res_source.err}; }
    val source: str = res_source.ok;

    val res_tgt: res[UseTarget, fail.Fail] = use_target(l, source, du.path);
    if (sel res_tgt.err) {
        val error: fail.Fail = res_tgt.err;
        if (sel error.user) {
            val err_reported: err[fail.Fail] = diagnostic.report(l.diags, fail.kind_of(error), file_of(l, mid), du.path, fail.describe(error));
            if (sel err_reported.err) {
                report_phase.internal(?m.status, err_reported.err);
                ret err[fail.Fail].err{fail.as_internal(err_reported.err)};
            }
            report_phase.reject(?m.status);
            ret binding_record(l, mid, Binding{
                decl: did, kind: BINDING_UNBOUND, name: intern.STR_NIL, module: module.STABLE_MODULE_NIL, span: du.path, constant: false
            });
        }
        report_phase.internal(?m.status, error);
        ret err[fail.Fail].err{error};
    }
    val ut:    UseTarget    = res_tgt.ok;
    var bound: intern.StrId = ut.leaf;
    if (ut.binds_module && du.alias.len != 0) {
        val res_alias: res[intern.StrId, A.Error] = intern.range_add(?l.s.interner, source, du.alias.offset, du.alias.len);
        if (sel res_alias.err) { ret err[fail.Fail].err{fail.refused(res_alias.err)}; }
        bound = res_alias.ok;
    }
    val aliased: bool = du.alias.len > 0;

    val res_dep: res[module.ModuleId, fail.Fail] = load_module(l, ut.module_fqn);
    if (sel res_dep.err) { ret err[fail.Fail].err{res_dep.err}; }
    val dep_mid: module.ModuleId = res_dep.ok;

    val err_record: err[fail.Fail] = dep_record(l, mid, dep_mid);
    if (sel err_record.err) { ret err_record; }

    var kind: BindingKind = BINDING_MEMBER;
    if (ut.binds_module) { kind = BINDING_MODULE; }
    val constant:     bool           = !ut.binds_module && !aliased;
    val err_recorded: err[fail.Fail] = binding_record(l, mid, Binding{
        decl: did, kind: kind, name: bound, module: stable_of(l, dep_mid), span: du.path, constant: constant
    });
    if (sel err_recorded.err) { ret err_recorded; }
    if (!constant)            { ret err[fail.Fail].ok{}; }
    ret const_merge(l, mid, dep_mid, ut.leaf);
}

# what a `fwd` names is recorded as a `use` is; one whose path names no module is left for
# resolve to report
fun walk_fwd_for_load(l: *Loader, mid: module.ModuleId, did: ast_id.DeclId, df: *ast_decl.DeclFwd) err[fail.Fail] {
    if (df.path.len == 0) { ret err[fail.Fail].ok{}; }
    val m:          *Module             = module_at(l, mid);
    val res_source: res[str, fail.Fail] = module_source(l, mid);
    if (sel res_source.err) { ret err[fail.Fail].err{res_source.err}; }

    val res_tgt: res[UseTarget, fail.Fail] = use_target(l, res_source.ok, df.path);
    if (sel res_tgt.err) {
        val error: fail.Fail = res_tgt.err;
        if (sel error.user) { ret err[fail.Fail].ok{}; }
        report_phase.internal(?m.status, error);
        ret err[fail.Fail].err{error};
    }
    val ut: UseTarget = res_tgt.ok;

    val res_dep: res[module.ModuleId, fail.Fail] = load_module(l, ut.module_fqn);
    if (sel res_dep.err) { ret err[fail.Fail].err{res_dep.err}; }
    val dep_mid: module.ModuleId = res_dep.ok;

    val err_record: err[fail.Fail] = dep_record(l, mid, dep_mid);
    if (sel err_record.err) { ret err_record; }
    var kind: BindingKind = BINDING_MEMBER;
    if (ut.binds_module) { kind = BINDING_MODULE; }
    ret binding_record(l, mid, Binding{decl: did, kind: kind, name: ut.leaf, module: stable_of(l, dep_mid), span: df.path, constant: false});
}

# each import declaration is recorded once; arms a union walk takes under different tuples may
# bind one name to different modules
fun binding_record(l: *Loader, mid: module.ModuleId, b: Binding) err[fail.Fail] {
    val m:            *Module       = module_at(l, mid);
    val opt_existing: opt[*Binding] = binding_for(m, b.decl);
    if (sel opt_existing.some) { ret err[fail.Fail].ok{}; }
    val res_pushed: res[usize, A.Error] = collections_vector.push[Binding](?m.bindings, b);
    if (sel res_pushed.err) { ret err[fail.Fail].err{fail.refused(res_pushed.err)}; }
    ret err[fail.Fail].ok{};
}

# what an import path names: a module, or one member of a module
# ---
# module_fqn:   the module it loads
# leaf:         its last segment
# binds_module: the whole path names the module, rather than a member of it
rec UseTarget {
    module_fqn:   intern.StrId;
    leaf:         intern.StrId;
    binds_module: bool;
}

fun use_target(l: *Loader, source: str, path: base_source.Span) res[UseTarget, fail.Fail] {
    val res_full: res[intern.StrId, A.Error] = front_path.intern_path(?l.s.interner, source, path);
    if (sel res_full.err) { ret res[UseTarget, fail.Fail].err{fail.refused(res_full.err)}; }
    val full_id: intern.StrId = res_full.ok;

    val res_leaf: res[intern.StrId, fail.Fail] = leaf_name(?l.s.interner, source, path);
    if (sel res_leaf.err) { ret res[UseTarget, fail.Fail].err{res_leaf.err}; }
    val leaf: intern.StrId = res_leaf.ok;

    # a path is a project id then a source path, so one segment names a project and no module
    if (front_path.prefix(source, path).len == 0) {
        ret res[UseTarget, fail.Fail].err{fail.user_of(diagnostic_kind.USE_UNRESOLVED, unresolvable_use_msg(l, source, path, full_id))};
    }

    val res_names_file: res[bool, fail.Fail] = names_module(l, full_id);
    if (sel res_names_file.err) { ret res[UseTarget, fail.Fail].err{res_names_file.err}; }
    if (res_names_file.ok)      { ret res[UseTarget, fail.Fail].ok{UseTarget{module_fqn: full_id, leaf: leaf, binds_module: true}}; }

    # a path that runs on past a module's member names nothing a use can bind
    var prefix: base_source.Span = front_path.prefix(source, path);
    var direct: bool             = true;
    for (prefix.len != 0) {
        val res_pid: res[intern.StrId, A.Error] = front_path.intern_path(?l.s.interner, source, prefix);
        if (sel res_pid.err) { ret res[UseTarget, fail.Fail].err{fail.refused(res_pid.err)}; }
        val pid:                   intern.StrId         = res_pid.ok;
        val res_prefix_names_file: res[bool, fail.Fail] = names_module(l, pid);
        if (sel res_prefix_names_file.err)      { ret res[UseTarget, fail.Fail].err{res_prefix_names_file.err}; }
        if (res_prefix_names_file.ok && direct) { ret res[UseTarget, fail.Fail].ok{UseTarget{module_fqn: pid, leaf: leaf, binds_module: false}}; }
        if (res_prefix_names_file.ok) {
            ret res[UseTarget, fail.Fail].err{fail.user_of(diagnostic_kind.USE_UNRESOLVED, diagnostic.format_intern(?l.s.interner, l.s.alloc,
                "use path '{}' names no module or member. '{}' is a module, so a use of it must name the module or one of its members",
                intern.text(?l.s.interner, full_id), intern.text(?l.s.interner, pid)))};
        }
        prefix = front_path.prefix(source, prefix);
        direct = false;
    }
    ret res[UseTarget, fail.Fail].err{fail.user_of(diagnostic_kind.USE_UNRESOLVED, unresolvable_use_msg(l, source, path, full_id))};
}

fun unresolvable_use_msg(l: *Loader, source: str, path: base_source.Span, full_id: intern.StrId) res[str, fail.Fail] {
    if (front_path.prefix(source, path).len == 0) { ret name_joined(l.s, "use path '", full_id, "' does not name a module"); }
    var cursor:    usize                      = path.offset;
    val root_span: base_source.Span           = front_path.next(source, path, ?cursor);
    val res_root:  res[intern.StrId, A.Error] = intern.range_add(?l.s.interner, source, root_span.offset, root_span.len);
    if (sel res_root.err) { ret res[str, fail.Fail].err{fail.refused(res_root.err)}; }
    val root_id: intern.StrId = res_root.ok;

    if (provider.package_known(?l.sources, root_id)) { ret name_joined(l.s, "use path '", full_id, "' does not name a module"); }

    ret diagnostic.format_intern(?l.s.interner, l.s.alloc,
        "use path '{}' has module root '{}', which is neither this project nor a declared dependency. declare it in mach.toml",
        intern.text(?l.s.interner, full_id), intern.text(?l.s.interner, root_id));
}

# `prefix`, the text of `name_id`, then `suffix`, interned
fun name_joined(s: *session.Session, prefix: str, name_id: intern.StrId, suffix: str) res[str, fail.Fail] {
    ret diagnostic.format_intern(?s.interner, s.alloc, "{}{}{}", prefix, intern.text(?s.interner, name_id), suffix);
}

fun leaf_name(i: *intern.Interner, source: str, path: base_source.Span) res[intern.StrId, fail.Fail] {
    val leaf:            base_source.Span           = front_path.leaf(source, path);
    val res_intern_span: res[intern.StrId, A.Error] = intern.range_add(i, source, leaf.offset, leaf.len);
    if (sel res_intern_span.err) { ret res[intern.StrId, fail.Fail].err{fail.refused(res_intern_span.err)}; }
    ret res[intern.StrId, fail.Fail].ok{res_intern_span.ok};
}

fun dep_record(l: *Loader, mid: module.ModuleId, dep_mid: module.ModuleId) err[fail.Fail] {
    val m:   *Module               = module_at(l, mid);
    val sid: module.StableModuleId = stable_of(l, dep_mid);
    var i:   usize                 = 0;
    for (i < m.deps.len) {
        if (module.stable_same(m.deps.data[i], sid)) { ret err[fail.Fail].ok{}; }
        i = i + 1;
    }
    val res_pushed: res[usize, A.Error] = collections_vector.push[module.StableModuleId](?m.deps, sid);
    if (sel res_pushed.err) { ret err[fail.Fail].err{fail.refused(res_pushed.err)}; }
    ret err[fail.Fail].ok{};
}

# binds the constant `leaf` a `use` imports in the module's frame
fun const_merge(l: *Loader, mid: module.ModuleId, dep_mid: module.ModuleId, leaf: intern.StrId) err[fail.Fail] {
    val opt_const_find: opt[*Const] = const_find(module_at(l, dep_mid), leaf);
    if (sel opt_const_find.none) { ret err[fail.Fail].ok{}; }
    ret comptime_scope.bind(frame_ctx(module_at(l, mid)), leaf, opt_const_find.some.value);
}

# the public constant `name` a loaded module exports to the gates of its importers
fun const_find(m: *Module, name: intern.StrId) opt[*Const] {
    var i: usize = 0;
    for (i < m.consts.len) {
        val pc: *Const = ?m.consts.data[i];
        if (intern.str_same(pc.name, name)) { ret opt[*Const].some{pc}; }
        i = i + 1;
    }
    ret opt[*Const].none{};
}

# the record of what the import declaration `decl` binds, none when the load recorded none
pub fun binding_for(m: *Module, decl: ast_id.DeclId) opt[*Binding] {
    var i: usize = 0;
    for (i < m.bindings.len) {
        if (ast_id.decl_same(m.bindings.data[i].decl, decl)) { ret opt[*Binding].some{?m.bindings.data[i]}; }
        i = i + 1;
    }
    ret opt[*Binding].none{};
}

# the module `name` names in the module's current frame: the one the `use` binding it names, read
# in the arm each enclosing chain selects there; none when that `use` has not been walked
fun frame_mod_ref(l: *Loader, mid: module.ModuleId, name: intern.StrId) res[opt[module.ModuleId], fail.Fail] {
    val a:          *ast.Ast                = syntax_of(l, mid);
    val opt_module: opt[*ast_module.Module] = ast.get_module(a, a.root_module);
    if (sel opt_module.none) { ret res[opt[module.ModuleId], fail.Fail].err{fail.message("module root not set on Ast")}; }
    val res_source: res[str, fail.Fail] = module_source(l, mid);
    if (sel res_source.err) { ret res[opt[module.ModuleId], fail.Fail].err{res_source.err}; }
    val opt_text: opt[str] = intern.get(?l.s.interner, name);
    if (sel opt_text.none) { ret res[opt[module.ModuleId], fail.Fail].err{fail.message("module name is not interned")}; }
    val err_indexed: err[fail.Fail] = demand_index(l, mid, res_source.ok);
    if (sel err_indexed.err) { ret res[opt[module.ModuleId], fail.Fail].err{err_indexed.err}; }
    ret mod_ref_in_list(l, mid, opt_module.some.decls_start, opt_module.some.decls_len, res_source.ok, name, opt_text.some);
}

# the chains of a list before its first `use` of the name, each of which may bind it in its arm
# first, then that `use`, found through the module's demand index
fun mod_ref_in_list(l: *Loader, mid: module.ModuleId, start: u32, len: u32, source: str, name: intern.StrId, text: str) res[opt[module.ModuleId], fail.Fail] {
    val m:         *Module   = module_at(l, mid);
    val a:         *ast.Ast  = syntax_of(l, mid);
    val end:       u32       = start + len;
    var binder:    u32       = end;
    val key:       u64       = demand_key(start, name);
    val opt_found: opt[*u32] = map.get[u64, u32](?m.binders.uses, ?key);
    if (sel opt_found.some) { binder = @opt_found.some; }
    var ci: usize = chain_from(?m.binders.chains, start);
    for (ci < m.binders.chains.len) {
        val at: u32 = m.binders.chains.data[ci];
        ci = ci + 1;
        if (at >= binder) { brk; }
        val opt_decl: opt[*ast_decl.Decl] = ast.get_decl(a, a.decl_ids.data[at]);
        if (sel opt_decl.none) { ret res[opt[module.ModuleId], fail.Fail].err{fail.message("DeclId out of range during a module lookup")}; }
        var copied: ast_decl.Decl = @opt_decl.some;
        if (stack.exhausted()) { ret res[opt[module.ModuleId], fail.Fail].err{refuse_nesting(l, mid, copied.span)}; }
        val res_binds: res[bool, fail.Fail] = chain_may_bind(l, mid, ?copied, source, text, false, false);
        if (sel res_binds.err) { ret res[opt[module.ModuleId], fail.Fail].err{res_binds.err}; }
        if (res_binds.ok) {
            val res_arm: res[ChainChoice, fail.Fail] = demand_arm(l, mid, ?copied.data.comptime_if, source, false);
            if (sel res_arm.err) { ret res[opt[module.ModuleId], fail.Fail].err{res_arm.err}; }
            if (res_arm.ok.branch < copied.data.comptime_if.branches_len) {
                val br:        ast_decl.ComptimeBranch              = a.comptime_branches.data[copied.data.comptime_if.branches_start + res_arm.ok.branch];
                val res_inner: res[opt[module.ModuleId], fail.Fail] = mod_ref_in_list(l, mid, br.body_start, br.body_len, source, name, text);
                if (sel res_inner.err)     { ret res_inner; }
                if (sel res_inner.ok.some) { ret res_inner; }
            }
        }
    }
    if (binder >= end) { ret res[opt[module.ModuleId], fail.Fail].ok{opt[module.ModuleId].none{}}; }
    val did:      ast_id.DeclId       = a.decl_ids.data[binder];
    val opt_decl: opt[*ast_decl.Decl] = ast.get_decl(a, did);
    if (sel opt_decl.none) { ret res[opt[module.ModuleId], fail.Fail].err{fail.message("DeclId out of range during a module lookup")}; }
    if (stack.exhausted()) { ret res[opt[module.ModuleId], fail.Fail].err{refuse_nesting(l, mid, opt_decl.some.span)}; }
    val opt_binding_for: opt[*Binding] = binding_for(m, did);
    if (sel opt_binding_for.some) {
        if (opt_binding_for.some.kind == BINDING_MODULE) { ret res[opt[module.ModuleId], fail.Fail].ok{opt[module.ModuleId].some{module_of(l, opt_binding_for.some.module)}}; }
    }
    ret res[opt[module.ModuleId], fail.Fail].ok{opt[module.ModuleId].none{}};
}

rec LoadMemberCtx {
    l:   *Loader;
    mid: module.ModuleId;
}

fun resolve_module_member_const_load(lc: *LoadMemberCtx, eid: ast_id.ExprId) res[opt[comptime_value.CTValue], comptime_failure.EvalFail] {
    if (lc == nil) { ret res[opt[comptime_value.CTValue], comptime_failure.EvalFail].ok{opt[comptime_value.CTValue].none{}}; }
    val l:   *Loader         = lc.l;
    val mid: module.ModuleId = lc.mid;
    val a:   *ast.Ast        = syntax_of(l, mid);
    if (a == nil) { ret res[opt[comptime_value.CTValue], comptime_failure.EvalFail].ok{opt[comptime_value.CTValue].none{}}; }

    val opt_expr: opt[*ast_expr.Expr] = ast.get_expr(a, eid);
    if (sel opt_expr.none) { ret res[opt[comptime_value.CTValue], comptime_failure.EvalFail].ok{opt[comptime_value.CTValue].none{}}; }
    val node: *ast_expr.Expr = opt_expr.some;
    if (node.kind != ast_expr.EXPR_KIND_MEMBER) { ret res[opt[comptime_value.CTValue], comptime_failure.EvalFail].ok{opt[comptime_value.CTValue].none{}}; }

    val opt_opt_object: opt[*ast_expr.Expr] = ast.get_expr(a, node.data.member.object);
    if (sel opt_opt_object.none) { ret res[opt[comptime_value.CTValue], comptime_failure.EvalFail].ok{opt[comptime_value.CTValue].none{}}; }
    val obj: *ast_expr.Expr = opt_opt_object.some;
    if (obj.kind != ast_expr.EXPR_KIND_IDENT) { ret res[opt[comptime_value.CTValue], comptime_failure.EvalFail].ok{opt[comptime_value.CTValue].none{}}; }

    val res_dep: res[opt[module.ModuleId], fail.Fail] = frame_mod_ref(l, mid, obj.data.ident.name);
    if (sel res_dep.err) { ret res[opt[comptime_value.CTValue], comptime_failure.EvalFail].err{comptime_failure.eval_error(comptime_failure.EVAL_FAIL_INTERNAL, diagnostic_kind.COMPILER_INTERNAL, fail.describe(res_dep.err))}; }
    val opt_dep: opt[module.ModuleId] = res_dep.ok;
    if (sel opt_dep.none) { ret res[opt[comptime_value.CTValue], comptime_failure.EvalFail].ok{opt[comptime_value.CTValue].none{}}; }

    val opt_const_find: opt[*Const] = const_find(module_at(l, opt_dep.some), node.data.member.name_id);
    if (sel opt_const_find.none) { ret res[opt[comptime_value.CTValue], comptime_failure.EvalFail].ok{opt[comptime_value.CTValue].none{}}; }
    ret res[opt[comptime_value.CTValue], comptime_failure.EvalFail].ok{opt[comptime_value.CTValue].some{opt_const_find.some.value}};
}

# records the load's reading of the module's decorator arguments, in the build target's frame the
# walk bound: the string each argument that takes one evaluates to, and what each `embed` argument names
pub fun decorators_record(l: *Loader, mid: module.ModuleId) err[fail.Fail] {
    entry_begin(l);
    val m: *Module  = module_at(l, mid);
    val a: *ast.Ast = syntax_of(l, mid);
    if (a == nil) { ret err[fail.Fail].ok{}; }
    val res_source: res[str, fail.Fail] = module_source(l, mid);
    if (sel res_source.err) { ret err[fail.Fail].err{res_source.err}; }
    var lc: LoadMemberCtx;
    lc.l   = l;
    lc.mid = mid;
    val res_caps: res[comptime_capability.PhaseCapabilities[LoadMemberCtx], fail.Fail] = comptime_capability.loading_capabilities[LoadMemberCtx](resolve_module_member_const_load, load_cast, load_head);
    if (sel res_caps.err) { ret err[fail.Fail].err{res_caps.err}; }
    comptime_scope.decorators_clear(?m.ctx);
    val err_strings: err[fail.Fail] = decorator.strings_record[LoadMemberCtx](?l.s.interner, ?m.ctx, a, res_source.ok, ?m.ctx, ?lc, res_caps.ok, m.walked);
    if (sel err_strings.err) { ret err_strings; }
    val err_embeds: err[fail.Fail] = embeds_record(l.s, ?m.ctx, a, fqn_of(l, mid), m.walked);
    if (sel err_embeds.err) { report_phase.internal(?m.status, err_embeds.err); }
    ret err_embeds;
}

# records into the load scope `c` what each `embed` argument of a module names, reading the string
# `c` holds for it: a declaration `reached` does not mark is left out, where it marks any, and so
# is an argument with no string, which type checking reports
pub fun embeds_record(s: *session.Session, c: *comptime_scope.ComptimeCtx, a: *ast.Ast, fqn: intern.StrId,
    reached: *bool) err[fail.Fail] {
    val opt_root: opt[*ast_module.Module] = ast.get_module(a, a.root_module);
    if (sel opt_root.none) { ret err[fail.Fail].ok{}; }
    ret embeds_in(s, c, a, fqn, reached, opt_root.some.decls_start, opt_root.some.decls_len);
}

fun embeds_in(s: *session.Session, c: *comptime_scope.ComptimeCtx, a: *ast.Ast, fqn: intern.StrId,
    reached: *bool, start: u32, len: u32) err[fail.Fail] {
    var i: u32 = 0;
    for (i < len) {
        val did: ast_id.DeclId = a.decl_ids.data[start + i];
        i = i + 1;
        if (reached != nil && !reached[ast_id.decl_index(did)]) { cnt; }
        val opt_decl: opt[*ast_decl.Decl] = ast.get_decl(a, did);
        if (sel opt_decl.none) { cnt; }
        val d: *ast_decl.Decl = opt_decl.some;
        if (d.kind == ast_decl.DECL_KIND_COMPTIME_IF) {
            var b: u32 = 0;
            for (b < d.data.comptime_if.branches_len) {
                val br:            *ast_decl.ComptimeBranch = ?a.comptime_branches.data[d.data.comptime_if.branches_start + b];
                val err_embeds_in: err[fail.Fail]           = embeds_in(s, c, a, fqn, reached, br.body_start, br.body_len);
                if (sel err_embeds_in.err) { ret err_embeds_in; }
                b = b + 1;
            }
            cnt;
        }
        var k: u32 = 0;
        for (k < d.decorators_len) {
            val dec: *ast_decl.Decorator = ?a.decorators.data[d.decorators_start + k];
            k = k + 1;
            if (dec.args_len == 0 || dec.id != decorator.EMBED) { cnt; }
            val err_embed_record: err[fail.Fail] = embed_record(s, c, a, fqn, a.expr_ids.data[dec.args_start]);
            if (sel err_embed_record.err) { ret err_embed_record; }
        }
    }
    ret err[fail.Fail].ok{};
}

fun embed_record(s: *session.Session, c: *comptime_scope.ComptimeCtx, a: *ast.Ast, fqn: intern.StrId, arg: ast_id.ExprId) err[fail.Fail] {
    val named: intern.StrId = comptime_scope.decorator_string_at(c, arg);
    if (intern.str_is_nil(named)) { ret err[fail.Fail].ok{}; }
    val text: str = intern.text(?s.interner, named);
    if (str_len(text) == 0) { ret err[fail.Fail].ok{}; }
    var located:  str                          = nil;
    val opt_file: opt[*base_source.SourceFile] = base_source.get(s.sources, a.file_id);
    if (sel opt_file.some) { located = opt_file.some.path; }
    if (located == nil) {
        ret comptime_scope.decorator_embed_set(c, arg, comptime_scope.EmbedPath{kind: comptime_scope.EMBED_PATH_NO_LOCATION, text: intern.STR_NIL, artifact: intern.STR_NIL});
    }
    val res_resolved: res[session_embed.Resolution, fail.Fail] = session_embed.resolve_arg(s.alloc, ?s.embeds, ?s.interner, fqn, located, text);
    if (sel res_resolved.err) {
        if (fail.is_message(res_resolved.err)) { ret err[fail.Fail].err{res_resolved.err}; }
        val res_reason: res[intern.StrId, A.Error] = intern.add(?s.interner, fail.describe(res_resolved.err));
        if (sel res_reason.err) { ret err[fail.Fail].err{fail.refused(res_reason.err)}; }
        ret comptime_scope.decorator_embed_set(c, arg, comptime_scope.EmbedPath{kind: comptime_scope.EMBED_PATH_REFUSED, text: res_reason.ok, artifact: intern.STR_NIL});
    }
    val embed_path: str = res_resolved.ok.path;
    fin { str_free(s.alloc, embed_path); }
    val res_escaped: res[bool, fail.Fail] = session_embed.escapes_root(s.alloc, ?s.embeds, embed_path);
    if (sel res_escaped.err) { ret err[fail.Fail].err{fail.as_internal(res_escaped.err)}; }
    val res_path: res[intern.StrId, A.Error] = intern.add(?s.interner, embed_path);
    if (sel res_path.err) { ret err[fail.Fail].err{fail.refused(res_path.err)}; }
    var kind: comptime_scope.EmbedPathKind = comptime_scope.EMBED_PATH_RESOLVED;
    if (res_escaped.ok) { kind = comptime_scope.EMBED_PATH_ESCAPED; }
    ret comptime_scope.decorator_embed_set(c, arg, comptime_scope.EmbedPath{kind: kind, text: res_path.ok, artifact: res_resolved.ok.artifact});
}

fun eval_for_load(
    l: *Loader,
    mid: module.ModuleId,
    source: str,
    e: ast_id.ExprId,
    fw: float.FloatWidth,
    secret: bool) res[comptime_value.CTValue, comptime_failure.EvalFail] {
    val m:  *Module = module_at(l, mid);
    var lc: LoadMemberCtx;
    lc.l   = l;
    lc.mid = mid;
    val lcp:      *LoadMemberCtx                                                       = ?lc;
    val res_caps: res[comptime_capability.PhaseCapabilities[LoadMemberCtx], fail.Fail] = comptime_capability.loading_capabilities[LoadMemberCtx](resolve_module_member_const_load, load_cast, load_head);
    if (sel res_caps.err) {
        var f: comptime_failure.EvalFail;
        f.kind    = comptime_failure.EVAL_FAIL_INTERNAL;
        f.diag    = diagnostic_kind.COMPILER_INTERNAL;
        f.message = fail.describe(res_caps.err);
        report_phase.internal(?m.status, fail.message(f.message));
        ret res[comptime_value.CTValue, comptime_failure.EvalFail].err{f};
    }
    val caps: comptime_capability.PhaseCapabilities[LoadMemberCtx] =
        res_caps.ok;
    var res_evaluate_at_float_width: res[comptime_value.CTValue, comptime_failure.EvalFail] = comptime.evaluate_at_float_width[LoadMemberCtx](frame_ctx(m), lcp, caps, syntax_of(l, mid), source, e, ?l.s.interner, fw);
    if (secret) { res_evaluate_at_float_width = comptime.evaluate_secret_at_float_width[LoadMemberCtx](frame_ctx(m), lcp, caps, syntax_of(l, mid), source, e, ?l.s.interner, fw); }
    if (sel res_evaluate_at_float_width.err) {
        val f: comptime_failure.EvalFail = res_evaluate_at_float_width.err;
        if (f.kind == comptime_failure.EVAL_FAIL_INTERNAL) { report_phase.internal(?m.status, fail.message(f.message)); }
        ret res[comptime_value.CTValue, comptime_failure.EvalFail].err{f};
    }
    ret res[comptime_value.CTValue, comptime_failure.EvalFail].ok{res_evaluate_at_float_width.ok};
}

# what a constant's declared type makes of its integer value: a primitive
# spelling types it directly, and a name is followed through `def`s across
# `use` and `fwd` to the primitive the chain ends at, so a gate reading the
# constant computes with the width and sign the program declared
def DeclaredClass: u8;

# not readable from syntax (a computed type, or a name the loaded modules do not
# bind yet): the value stays untyped and type checking decides it
val DECLARED_UNTYPED: DeclaredClass = 0;
val DECLARED_INT:     DeclaredClass = 1;
# the chain ends at a record, pointer, float or other non-integer type
val DECLARED_NON_INT: DeclaredClass = 2;

# a chain longer than this is a cycle, which type checking reports
val DECLARED_CHAIN_LIMIT: u32 = 64;

rec DeclaredInt {
    class:    DeclaredClass;
    unsigned: bool;
    width:    u32;
}

fun declared_int(class: DeclaredClass) DeclaredInt {
    var r: DeclaredInt;
    r.class    = class;
    r.unsigned = false;
    r.width    = 0;
    ret r;
}

rec DeclaredWalk {
    l: *Loader;
    # the type spellings the chain passes through, for the refusal that names it
    steps: collections_vector.Vector[intern.StrId];
}

def MeaningKind: u8;

val MEANING_NONE:    MeaningKind = 0;
val MEANING_DEF:     MeaningKind = 1;
val MEANING_NOMINAL: MeaningKind = 2;
val MEANING_MODULE:  MeaningKind = 3;
val MEANING_SYMBOL:  MeaningKind = 4;

# what one module-scope name means, as far as a def chain needs to know
rec Meaning {
    kind:   MeaningKind;
    ty:     ast_id.TypeId;
    module: module.ModuleId;
    leaf:   intern.StrId;
    # the declaration of a nominal type
    decl: ast_id.DeclId;
}

fun meaning(kind: MeaningKind) Meaning {
    var b: Meaning;
    b.kind   = kind;
    b.ty     = ast_id.TYPE_NIL;
    b.module = module.MODULE_NIL;
    b.leaf   = intern.STR_NIL;
    b.decl   = ast_id.DECL_NIL;
    ret b;
}

fun module_source(l: *Loader, mid: module.ModuleId) res[str, fail.Fail] {
    val h: *Held = held_now(l, mid);
    if (!h.known) { ret res[str, fail.Fail].err{fail.message("module file_id not found in SourceMap")}; }
    ret res[str, fail.Fail].ok{h.source};
}

fun declared_value(l: *Loader, mid: module.ModuleId, name: intern.StrId, ty: ast_id.TypeId, value: comptime_value.CTValue) res[comptime_value.CTValue, fail.Fail] {
    val m:          *Module             = module_at(l, mid);
    val res_source: res[str, fail.Fail] = module_source(l, mid);
    if (sel res_source.err) { ret res[comptime_value.CTValue, fail.Fail].err{res_source.err}; }
    val source: str = res_source.ok;
    if (value.kind != comptime_value.CT_KIND_INT || !names_def_chain(syntax_of(l, mid), source, ty)) {
        ret res[comptime_value.CTValue, fail.Fail].ok{comptime_value.apply_declared_int_type(syntax_of(l, mid), source, ty, value)};
    }

    var w: DeclaredWalk;
    w.l     = l;
    w.steps = collections_vector.init[intern.StrId](l.alloc);
    fin { collections_vector.dnit[intern.StrId](?w.steps); }
    val res_declared_type: res[DeclaredInt, fail.Fail] = declared_type(?w, mid, ty, 0);
    if (sel res_declared_type.err) { ret res[comptime_value.CTValue, fail.Fail].err{res_declared_type.err}; }
    val d: DeclaredInt = res_declared_type.ok;
    if (d.class == DECLARED_INT) { ret res[comptime_value.CTValue, fail.Fail].ok{comptime_value.typed_int(value, d.unsigned, comptime_value.width_held(d.width))}; }
    if (d.class == DECLARED_UNTYPED) {
        ret res[comptime_value.CTValue, fail.Fail].ok{comptime_value.typed_int(value, value.int_unsigned, 0)};
    }
    val res_message: res[intern.StrId, fail.Fail] = non_integer_message(l, name, ?w.steps);
    if (sel res_message.err) { ret res[comptime_value.CTValue, fail.Fail].err{res_message.err}; }
    ret res[comptime_value.CTValue, fail.Fail].ok{comptime_value.non_integer(res_message.ok)};
}

# a declared type that is a name no primitive spells, so only its def chain types the value
fun names_def_chain(a: *ast.Ast, source: str, ty: ast_id.TypeId) bool {
    if (ast_id.type_is_nil(ty)) { ret false; }
    val opt_found: opt[*ast_type.Type] = ast.get_type(a, ty);
    if (sel opt_found.none) { ret false; }
    val t: *ast_type.Type = opt_found.some;
    if (t.kind == ast_type.TYPE_KIND_SECRET)                              { ret names_def_chain(a, source, t.data.secret.inner); }
    if (t.kind != ast_type.TYPE_KIND_NAMED || t.data.named.args_len != 0) { ret false; }
    val opt_prim: opt[type_kind.TypeKind] = type_prim.prim_from_view(view(?source[t.data.named.name.offset], t.data.named.name.len));
    ret sel opt_prim.none;
}

# whether a constant's declared type holds a secret as far as its syntax shows: a `^` in its
# spelling, in a type argument, an element, or a field or case of a type it names, followed
# through `def`s across `use` and `fwd`. a pointer's pointee is not the value's storage
fun declared_secret(l: *Loader, mid: module.ModuleId, ty: ast_id.TypeId, depth: u32) res[bool, fail.Fail] {
    if (depth > DECLARED_CHAIN_LIMIT || ast_id.type_is_nil(ty)) { ret res[bool, fail.Fail].ok{false}; }
    val a:         *ast.Ast            = syntax_of(l, mid);
    val opt_found: opt[*ast_type.Type] = ast.get_type(a, ty);
    if (sel opt_found.none) { ret res[bool, fail.Fail].err{fail.message("declared TypeId out of range")}; }
    var copied: ast_type.Type  = @opt_found.some;
    val t:      *ast_type.Type = ?copied;
    if (stack.exhausted())                   { ret res[bool, fail.Fail].err{refuse_nesting(l, mid, t.span)}; }
    if (t.kind == ast_type.TYPE_KIND_SECRET) { ret res[bool, fail.Fail].ok{true}; }
    if (t.kind == ast_type.TYPE_KIND_ARRAY)  { ret declared_secret(l, mid, t.data.array.element, depth + 1); }
    if (t.kind == ast_type.TYPE_KIND_REC)    { ret fields_secret(l, mid, t.data.rec_.fields_start, t.data.rec_.fields_len, depth + 1); }
    if (t.kind == ast_type.TYPE_KIND_UNI)    { ret fields_secret(l, mid, t.data.uni_.fields_start, t.data.uni_.fields_len, depth + 1); }
    if (t.kind != ast_type.TYPE_KIND_NAMED)  { ret res[bool, fail.Fail].ok{false}; }
    var i: u32 = 0;
    for (i < t.data.named.args_len) {
        val res_arg: res[bool, fail.Fail] = declared_secret(l, mid, a.type_ids.data[t.data.named.args_start + i], depth + 1);
        if (sel res_arg.err) { ret res_arg; }
        if (res_arg.ok)      { ret res_arg; }
        i = i + 1;
    }
    val res_source: res[str, fail.Fail] = module_source(l, mid);
    if (sel res_source.err) { ret res[bool, fail.Fail].err{res_source.err}; }
    val source: str              = res_source.ok;
    val path:   base_source.Span = t.data.named.name;
    if (front_path.prefix(source, path).len == 0) {
        val opt_prim: opt[type_kind.TypeKind] = type_prim.prim_from_view(view(?source[path.offset], path.len));
        if (sel opt_prim.some) { ret res[bool, fail.Fail].ok{false}; }
    }
    val res_owner: res[opt[module.ModuleId], fail.Fail] = qualifier_module(l, mid, source, front_path.prefix(source, path));
    if (sel res_owner.err)     { ret res[bool, fail.Fail].err{res_owner.err}; }
    if (sel res_owner.ok.none) { ret res[bool, fail.Fail].ok{false}; }
    val leaf:     base_source.Span           = front_path.leaf(source, path);
    val res_leaf: res[intern.StrId, A.Error] = intern.range_add(?l.s.interner, source, leaf.offset, leaf.len);
    if (sel res_leaf.err) { ret res[bool, fail.Fail].err{fail.refused(res_leaf.err)}; }
    ret name_secret(l, res_owner.ok.some, res_leaf.ok, front_path.prefix(source, path).len == 0, depth + 1);
}

fun name_secret(l: *Loader, mid: module.ModuleId, name: intern.StrId, local: bool, depth: u32) res[bool, fail.Fail] {
    if (depth > DECLARED_CHAIN_LIMIT) { ret res[bool, fail.Fail].ok{false}; }
    val res_module_meaning: res[Meaning, fail.Fail] = module_meaning(l, mid, name, local);
    if (sel res_module_meaning.err) { ret res[bool, fail.Fail].err{res_module_meaning.err}; }
    val b: Meaning = res_module_meaning.ok;
    if (b.kind == MEANING_DEF)                                   { ret declared_secret(l, mid, b.ty, depth + 1); }
    if (b.kind == MEANING_SYMBOL)                                { ret name_secret(l, b.module, b.leaf, false, depth + 1); }
    if (b.kind != MEANING_NOMINAL || ast_id.decl_is_nil(b.decl)) { ret res[bool, fail.Fail].ok{false}; }
    val opt_decl: opt[*ast_decl.Decl] = ast.get_decl(syntax_of(l, mid), b.decl);
    if (sel opt_decl.none) { ret res[bool, fail.Fail].err{fail.message("a nominal's DeclId is out of range")}; }
    val d: *ast_decl.Decl = opt_decl.some;
    if (d.kind == ast_decl.DECL_KIND_REC) { ret fields_secret(l, mid, d.data.rec_.fields_start, d.data.rec_.fields_len, depth + 1); }
    if (d.kind == ast_decl.DECL_KIND_UNI) { ret fields_secret(l, mid, d.data.uni_.fields_start, d.data.uni_.fields_len, depth + 1); }
    if (d.kind != ast_decl.DECL_KIND_TAG) { ret res[bool, fail.Fail].ok{false}; }
    val start: u32 = d.data.tag_.cases_start;
    val len:   u32 = d.data.tag_.cases_len;
    var i:     u32 = 0;
    for (i < len) {
        val payload:  ast_id.TypeId        = syntax_of(l, mid).tag_cases.data[start + i].payload;
        val res_held: res[bool, fail.Fail] = declared_secret(l, mid, payload, depth + 1);
        if (sel res_held.err) { ret res_held; }
        if (res_held.ok)      { ret res_held; }
        i = i + 1;
    }
    ret res[bool, fail.Fail].ok{false};
}

fun fields_secret(l: *Loader, mid: module.ModuleId, start: u32, len: u32, depth: u32) res[bool, fail.Fail] {
    var i: u32 = 0;
    for (i < len) {
        val ty:       ast_id.TypeId        = syntax_of(l, mid).typed_names.data[start + i].ty;
        val res_held: res[bool, fail.Fail] = declared_secret(l, mid, ty, depth);
        if (sel res_held.err) { ret res_held; }
        if (res_held.ok)      { ret res_held; }
        i = i + 1;
    }
    ret res[bool, fail.Fail].ok{false};
}

fun declared_type(w: *DeclaredWalk, mid: module.ModuleId, ty: ast_id.TypeId, depth: u32) res[DeclaredInt, fail.Fail] {
    if (depth > DECLARED_CHAIN_LIMIT || ast_id.type_is_nil(ty)) { ret res[DeclaredInt, fail.Fail].ok{declared_int(DECLARED_UNTYPED)}; }
    val res_source: res[str, fail.Fail] = module_source(w.l, mid);
    if (sel res_source.err) { ret res[DeclaredInt, fail.Fail].err{res_source.err}; }
    val source:    str                 = res_source.ok;
    val opt_found: opt[*ast_type.Type] = ast.get_type(syntax_of(w.l, mid), ty);
    if (sel opt_found.none) { ret res[DeclaredInt, fail.Fail].err{fail.message("declared TypeId out of range")}; }
    var copied: ast_type.Type  = @opt_found.some;
    val t:      *ast_type.Type = ?copied;
    if (stack.exhausted())                   { ret res[DeclaredInt, fail.Fail].err{refuse_nesting(w.l, mid, t.span)}; }
    if (t.kind == ast_type.TYPE_KIND_SECRET) { ret declared_type(w, mid, t.data.secret.inner, depth); }

    val res_step: res[intern.StrId, A.Error] = intern.range_add(?w.l.s.interner, source, t.span.offset, t.span.len);
    if (sel res_step.err) { ret res[DeclaredInt, fail.Fail].err{fail.refused(res_step.err)}; }
    val res_pushed: res[usize, A.Error] = collections_vector.push[intern.StrId](?w.steps, res_step.ok);
    if (sel res_pushed.err) { ret res[DeclaredInt, fail.Fail].err{fail.refused(res_pushed.err)}; }

    if (t.kind == ast_type.TYPE_KIND_PTR || t.kind == ast_type.TYPE_KIND_ARRAY || t.kind == ast_type.TYPE_KIND_FUN
        || t.kind == ast_type.TYPE_KIND_REC || t.kind == ast_type.TYPE_KIND_UNI) {
        ret res[DeclaredInt, fail.Fail].ok{declared_int(DECLARED_NON_INT)};
    }
    if (t.kind != ast_type.TYPE_KIND_NAMED) { ret res[DeclaredInt, fail.Fail].ok{declared_int(DECLARED_UNTYPED)}; }
    # a def is never generic, so a name taking arguments is a record, union or tag
    if (t.data.named.args_len != 0) { ret res[DeclaredInt, fail.Fail].ok{declared_int(DECLARED_NON_INT)}; }

    val path: base_source.Span = t.data.named.name;
    if (front_path.prefix(source, path).len == 0) {
        # a vector spelling names a type as a primitive does, and no vector is an integer
        val opt_spelled: opt[str] = intern.get(?w.l.s.interner, res_step.ok);
        if (sel opt_spelled.some) {
            if (type_prim.is_vector_spelling(opt_spelled.some)) { ret res[DeclaredInt, fail.Fail].ok{declared_int(DECLARED_NON_INT)}; }
        }
        val opt_prim: opt[type_kind.TypeKind] = type_prim.prim_from_view(view(?source[path.offset], path.len));
        if (sel opt_prim.some) {
            val pd: type_prim.PrimDesc = type_prim.prim_desc(opt_prim.some);
            if (pd.class != type_prim.PRIM_CLASS_INT) { ret res[DeclaredInt, fail.Fail].ok{declared_int(DECLARED_NON_INT)}; }
            var r: DeclaredInt = declared_int(DECLARED_INT);
            r.unsigned = !pd.signed;
            r.width    = pd.width;
            ret res[DeclaredInt, fail.Fail].ok{r};
        }
    }
    val res_owner: res[opt[module.ModuleId], fail.Fail] = qualifier_module(w.l, mid, source, front_path.prefix(source, path));
    if (sel res_owner.err)     { ret res[DeclaredInt, fail.Fail].err{res_owner.err}; }
    if (sel res_owner.ok.none) { ret res[DeclaredInt, fail.Fail].ok{declared_int(DECLARED_UNTYPED)}; }
    val leaf:     base_source.Span           = front_path.leaf(source, path);
    val res_leaf: res[intern.StrId, A.Error] = intern.range_add(?w.l.s.interner, source, leaf.offset, leaf.len);
    if (sel res_leaf.err) { ret res[DeclaredInt, fail.Fail].err{fail.refused(res_leaf.err)}; }
    val local: bool = front_path.prefix(source, path).len == 0;
    ret declared_name(w, res_owner.ok.some, res_leaf.ok, local, depth);
}

# the type a name binds in a module: its own scope when `local`, else its public surface
fun declared_name(w: *DeclaredWalk, mid: module.ModuleId, name: intern.StrId, local: bool, depth: u32) res[DeclaredInt, fail.Fail] {
    if (depth > DECLARED_CHAIN_LIMIT) { ret res[DeclaredInt, fail.Fail].ok{declared_int(DECLARED_UNTYPED)}; }
    val res_module_meaning: res[Meaning, fail.Fail] = module_meaning(w.l, mid, name, local);
    if (sel res_module_meaning.err) { ret res[DeclaredInt, fail.Fail].err{res_module_meaning.err}; }
    val b: Meaning = res_module_meaning.ok;
    if (b.kind == MEANING_DEF)     { ret declared_type(w, mid, b.ty, depth + 1); }
    if (b.kind == MEANING_NOMINAL) { ret res[DeclaredInt, fail.Fail].ok{declared_int(DECLARED_NON_INT)}; }
    if (b.kind == MEANING_SYMBOL)  { ret declared_name(w, b.module, b.leaf, false, depth + 1); }
    ret res[DeclaredInt, fail.Fail].ok{declared_int(DECLARED_UNTYPED)};
}

# the module a qualified type's prefix names: its first segment is a module this
# one imports, and each further segment a module the previous one forwards
fun qualifier_module(l: *Loader, mid: module.ModuleId, source: str, prefix: base_source.Span) res[opt[module.ModuleId], fail.Fail] {
    if (prefix.len == 0) { ret res[opt[module.ModuleId], fail.Fail].ok{opt[module.ModuleId].some{mid}}; }
    var owner:  module.ModuleId = mid;
    var local:  bool            = true;
    var cursor: usize           = prefix.offset;
    for (cursor < prefix.offset + prefix.len) {
        val segment: base_source.Span = front_path.next(source, prefix, ?cursor);
        if (segment.len == 0) { brk; }
        val res_seg: res[intern.StrId, A.Error] = intern.range_add(?l.s.interner, source, segment.offset, segment.len);
        if (sel res_seg.err) { ret res[opt[module.ModuleId], fail.Fail].err{fail.refused(res_seg.err)}; }
        val res_module_meaning: res[Meaning, fail.Fail] = module_meaning(l, owner, res_seg.ok, local);
        if (sel res_module_meaning.err)                   { ret res[opt[module.ModuleId], fail.Fail].err{res_module_meaning.err}; }
        if (res_module_meaning.ok.kind != MEANING_MODULE) { ret res[opt[module.ModuleId], fail.Fail].ok{opt[module.ModuleId].none{}}; }
        owner = res_module_meaning.ok.module;
        local = false;
    }
    ret res[opt[module.ModuleId], fail.Fail].ok{opt[module.ModuleId].some{owner}};
}

# what `name` binds at module scope in `mid`, read from its syntax so the answer does not depend
# on how far the walk has reached; a `use` binds only locally. a name declared under `$if` is
# read in the arm its chain selects: decided now in the module being walked (`local`), or from
# the states its walk left in a module already loaded, where an undecided chain binds nothing
fun module_meaning(l: *Loader, mid: module.ModuleId, name: intern.StrId, local: bool) res[Meaning, fail.Fail] {
    val a: *ast.Ast = syntax_of(l, mid);
    if (a == nil) { ret res[Meaning, fail.Fail].err{fail.message("a def chain reached a module with no syntax")}; }
    val m:          *Module             = module_at(l, mid);
    val res_source: res[str, fail.Fail] = module_source(l, mid);
    if (sel res_source.err) { ret res[Meaning, fail.Fail].err{res_source.err}; }
    val opt_text: opt[str] = intern.get(?l.s.interner, name);
    if (sel opt_text.none) { ret res[Meaning, fail.Fail].err{fail.message("def chain name is not interned")}; }
    val opt_module: opt[*ast_module.Module] = ast.get_module(a, a.root_module);
    if (sel opt_module.none) { ret res[Meaning, fail.Fail].err{fail.message("module root not set on Ast")}; }
    val saved_frame: u32 = m.frame;
    if (!local) { m.frame = FRAME_BUILD; }
    val res_meaning_in_list: res[Meaning, fail.Fail] = meaning_in_list(l, mid, opt_module.some.decls_start, opt_module.some.decls_len, res_source.ok, opt_text.some, local);
    m.frame = saved_frame;
    ret res_meaning_in_list;
}

fun meaning_in_list(l: *Loader, mid: module.ModuleId, start: u32, len: u32, source: str, text: str, local: bool) res[Meaning, fail.Fail] {
    var i: u32 = 0;
    for (i < len) {
        val a:        *ast.Ast            = syntax_of(l, mid);
        val opt_decl: opt[*ast_decl.Decl] = ast.get_decl(a, a.decl_ids.data[start + i]);
        if (sel opt_decl.none) { ret res[Meaning, fail.Fail].err{fail.message("DeclId out of range during def chain lookup")}; }
        var copied: ast_decl.Decl  = @opt_decl.some;
        val d:      *ast_decl.Decl = ?copied;
        i = i + 1;
        if (stack.exhausted()) { ret res[Meaning, fail.Fail].err{refuse_nesting(l, mid, d.span)}; }
        if (d.kind == ast_decl.DECL_KIND_DEF && spells(source, d.data.def_.name, text)) {
            var b: Meaning = meaning(MEANING_DEF);
            b.ty = d.data.def_.ty;
            ret res[Meaning, fail.Fail].ok{b};
        }
        if (declares_nominal(source, d, text)) {
            var b: Meaning = meaning(MEANING_NOMINAL);
            b.decl = a.decl_ids.data[start + i - 1];
            ret res[Meaning, fail.Fail].ok{b};
        }
        if ((d.kind == ast_decl.DECL_KIND_USE && local) || d.kind == ast_decl.DECL_KIND_FWD) {
            var alias: base_source.Span = d.data.use_.alias;
            var path:  base_source.Span = d.data.use_.path;
            if (d.kind == ast_decl.DECL_KIND_FWD) {
                alias = d.data.fwd_.alias;
                path  = d.data.fwd_.path;
            }
            var bound: base_source.Span = alias;
            if (bound.len == 0)                               { bound = front_path.leaf(source, path); }
            if (path.len != 0 && spells(source, bound, text)) { ret import_meaning(l, source, path); }
        }
        val res_names: res[bool, fail.Fail] = chain_may_bind(l, mid, d, source, text, true, local);
        if (sel res_names.err) { ret res[Meaning, fail.Fail].err{res_names.err}; }
        if (res_names.ok) {
            val res_arm: res[ChainChoice, fail.Fail] = demand_arm(l, mid, ?d.data.comptime_if, source, local);
            if (sel res_arm.err) { ret res[Meaning, fail.Fail].err{res_arm.err}; }
            if (res_arm.ok.verdict.kind != VERDICT_REFUSED && res_arm.ok.branch < d.data.comptime_if.branches_len) {
                val br:        ast_decl.ComptimeBranch = a.comptime_branches.data[d.data.comptime_if.branches_start + res_arm.ok.branch];
                val res_found: res[Meaning, fail.Fail] = meaning_in_list(l, mid, br.body_start, br.body_len, source, text, local);
                if (sel res_found.err)                 { ret res_found; }
                if (res_found.ok.kind != MEANING_NONE) { ret res_found; }
            }
        }
    }
    ret res[Meaning, fail.Fail].ok{meaning(MEANING_NONE)};
}

fun declares_nominal(source: str, d: *ast_decl.Decl, text: str) bool {
    ret (d.kind == ast_decl.DECL_KIND_REC && spells(source, d.data.rec_.name, text))
        || (d.kind == ast_decl.DECL_KIND_UNI && spells(source, d.data.uni_.name, text))
        || (d.kind == ast_decl.DECL_KIND_TAG && spells(source, d.data.tag_.name, text))
        || (d.kind == ast_decl.DECL_KIND_FUN && spells(source, d.data.fun_.name, text));
}

# whether any arm of a chain, at any depth, binds `text` as a def chain can read it
fun chain_names_type(a: *ast.Ast, source: str, ci: *ast_decl.DeclComptimeIf, text: str, local: bool) res[bool, fail.Fail] {
    if (stack.exhausted()) { ret res[bool, fail.Fail].err{nesting()}; }
    var bi: u32 = 0;
    for (bi < ci.branches_len) {
        val br: *ast_decl.ComptimeBranch = ?a.comptime_branches.data[ci.branches_start + bi];
        var i:  u32                      = 0;
        for (i < br.body_len) {
            val opt_decl: opt[*ast_decl.Decl] = ast.get_decl(a, a.decl_ids.data[br.body_start + i]);
            if (sel opt_decl.some) {
                val d: *ast_decl.Decl = opt_decl.some;
                if (d.kind == ast_decl.DECL_KIND_DEF && spells(source, d.data.def_.name, text))         { ret res[bool, fail.Fail].ok{true}; }
                if (declares_nominal(source, d, text))                                                  { ret res[bool, fail.Fail].ok{true}; }
                if (d.kind == ast_decl.DECL_KIND_USE && local && use_binds(source, ?d.data.use_, text)) { ret res[bool, fail.Fail].ok{true}; }
                if (d.kind == ast_decl.DECL_KIND_FWD && d.data.fwd_.path.len != 0) {
                    var bound: base_source.Span = d.data.fwd_.alias;
                    if (bound.len == 0)              { bound = front_path.leaf(source, d.data.fwd_.path); }
                    if (spells(source, bound, text)) { ret res[bool, fail.Fail].ok{true}; }
                }
                if (d.kind == ast_decl.DECL_KIND_COMPTIME_IF) {
                    val res_names: res[bool, fail.Fail] = chain_names_type(a, source, ?d.data.comptime_if, text, local);
                    if (sel res_names.err) { ret res_names; }
                    if (res_names.ok)      { ret res_names; }
                }
            }
            i = i + 1;
        }
        bi = bi + 1;
    }
    ret res[bool, fail.Fail].ok{false};
}

fun import_meaning(l: *Loader, source: str, path: base_source.Span) res[Meaning, fail.Fail] {
    # an unresolvable import is reported where the walk reaches it
    val res_tgt: res[UseTarget, fail.Fail] = use_target(l, source, path);
    if (sel res_tgt.err) {
        val error: fail.Fail = res_tgt.err;
        if (sel error.user) { ret res[Meaning, fail.Fail].ok{meaning(MEANING_NONE)}; }
        ret res[Meaning, fail.Fail].err{error};
    }
    val ut:        UseTarget            = res_tgt.ok;
    val opt_entry: opt[module.ModuleId] = module_find(l, ut.module_fqn);
    if (sel opt_entry.none) { ret res[Meaning, fail.Fail].ok{meaning(MEANING_NONE)}; }
    val target: module.ModuleId = opt_entry.some;
    if (l.states.data[module.index(target)::usize] == STATE_NEW) { ret res[Meaning, fail.Fail].ok{meaning(MEANING_NONE)}; }
    var b: Meaning = meaning(MEANING_SYMBOL);
    if (ut.binds_module) { b.kind = MEANING_MODULE; }
    b.module = target;
    b.leaf   = ut.leaf;
    ret res[Meaning, fail.Fail].ok{b};
}

fun spells(source: str, span: base_source.Span, text: str) bool {
    ret span.len != 0 && view_eq_str(view(?source[span.offset], span.len), text);
}

fun non_integer_message(l: *Loader, name: intern.StrId, steps: *collections_vector.Vector[intern.StrId]) res[intern.StrId, fail.Fail] {
    val opt_name_text: opt[str] = intern.get(?l.s.interner, name);
    if (sel opt_name_text.none) { ret res[intern.StrId, fail.Fail].err{fail.message("constant name is not interned")}; }
    var chain: str = nil;
    var i:     u32 = 0;
    for (i::usize < steps.len) {
        val opt_step: opt[str] = intern.get(?l.s.interner, steps.data[i]);
        if (sel opt_step.none) { ret res[intern.StrId, fail.Fail].err{fail.message("def chain step is not interned")}; }
        var res_next: res[str, fail.Fail];
        if (chain == nil)     { res_next = diagnostic.format(l.s.alloc, "`{}`", opt_step.some); }
        or                    { res_next = diagnostic.format(l.s.alloc, "{} -> `{}`", chain, opt_step.some); }
        if (chain != nil)     { str_free(l.s.alloc, chain); }
        if (sel res_next.err) { ret res[intern.StrId, fail.Fail].err{res_next.err}; }
        chain = res_next.ok;
        i     = i + 1;
    }
    var res_msg: res[str, fail.Fail];
    if (steps.len == 1) {
        res_msg = diagnostic.format(l.s.alloc, "`{}` cannot be read by a gate, because its type {} is not an integer primitive",
            opt_name_text.some, chain);
    }
    or {
        res_msg = diagnostic.format(l.s.alloc,
            "`{}` cannot be read by a gate, because its type follows the def chain {} to a type that is not an integer primitive",
            opt_name_text.some, chain);
    }
    if (chain != nil)    { str_free(l.s.alloc, chain); }
    if (sel res_msg.err) { ret res[intern.StrId, fail.Fail].err{res_msg.err}; }
    val res_interned: res[intern.StrId, A.Error] = intern.add(?l.s.interner, res_msg.ok);
    str_free(l.s.alloc, res_msg.ok);
    if (sel res_interned.err) { ret res[intern.StrId, fail.Fail].err{fail.refused(res_interned.err)}; }
    ret res[intern.StrId, fail.Fail].ok{res_interned.ok};
}

fun const_add(l: *Loader, m: *Module, name: intern.StrId, value: comptime_value.CTValue) err[fail.Fail] {
    val res_pushed: res[usize, A.Error] = collections_vector.push[Const](?m.consts, Const{name: name, value: value});
    if (sel res_pushed.err) { ret err[fail.Fail].err{fail.refused(res_pushed.err)}; }
    ret err[fail.Fail].ok{};
}
