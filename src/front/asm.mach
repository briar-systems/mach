# the lexis of an inline-asm body: the instruction set its head names, whose source dialect
# says where the body's comments and literals lie, and the `{name}` references outside them
# that bind a local. everything else in the body is the instruction set's, and reaches its
# assembler as written
use base_source: mach.base.source;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.char.char;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;

use mach.front.transition;
use masc_source: masc.core.source;
use masc_isa:    masc.isa;

def RefKind: u8;

# the body has no more braces
pub val REF_END: RefKind = 0;
# `{name}`, a local the block reads or writes
pub val REF_NAME: RefKind = 1;
# a brace group that is not one identifier, such as an aarch64 `{v0.16b}` register list,
# which belongs to the instruction set
val REF_OTHER: RefKind = 2;
# `{}`
pub val REF_EMPTY: RefKind = 3;

# one brace group of a body: its kind and the text between its braces
pub rec Ref {
    kind:  RefKind;
    inner: base_source.Span;
}

# the one instruction set of masc's whose catalog reads the head at `head` of `source` as a
# selection, whose source dialect says where the body's comments and literals lie. a head a
# previous major wrote names the set of the selection that stands for it
# ---
# a:      allocates the head's spelling and masc's lookup
# source: the text the head indexes
# head:   the head's span in `source`
# ret:    the reader masc finds, or the allocator's refusal
pub fun dialect(a: *A.Allocator, source: str, head: base_source.Span) res[masc_isa.Reader, A.Error] {
    val row: *transition.Head = transition.head_of(source, head);
    if (row != nil) { ret masc_isa.reader(a, ?masc_isa.REGISTRY, row.to); }
    val res_buf: res[*u8, A.Error] = A.allocate[u8](a, head.len + 1);
    if (sel res_buf.err) { ret res[masc_isa.Reader, A.Error].err{res_buf.err}; }
    val spelling: *u8 = res_buf.ok;
    fin { A.deallocate[u8](a, spelling, head.len + 1); }
    var i: usize = 0;
    for (i < head.len) {
        spelling[i] = source[head.offset + i];
        i           = i + 1;
    }
    spelling[head.len] = 0;
    ret masc_isa.reader(a, ?masc_isa.REGISTRY, spelling::str);
}

# the offset past the comment or literal of `dialect` at `i` of `source`, `i` where none starts
fun skip(dialect: *masc_source.Source, source: str, i: usize, end: usize) usize {
    ret i + dialect.skip(source::*u8, i, end);
}

# the next brace group of `body` at or after `at`, outside any comment or literal of
# `dialect`; `at` moves past it. the lexer closed every brace of the body
# ---
# dialect: the body's source dialect
# source:  the text the body indexes
# body:    the body's span in `source`
# at:      the scan's offset into `source`, which starts at body.offset
pub fun ref_next(dialect: *masc_source.Source, source: str, body: base_source.Span, at: *usize) Ref {
    val end: usize = body.offset + body.len;
    var i:   usize = @at;
    for (i < end && source[i] != '{'::char) {
        val past: usize = skip(dialect, source, i, end);
        if (past > i) { i = past; }
        or            { i = i + 1; }
    }
    if (i >= end) {
        @at = end;
        ret Ref{kind: REF_END, inner: base_source.Span{offset: end, len: 0}};
    }
    val start: usize = i + 1;
    var j:     usize = start;
    for (j < end && source[j] != '}'::char) {
        val past: usize = skip(dialect, source, j, end);
        if (past > j) { j = past; }
        or            { j = j + 1; }
    }
    val inner: base_source.Span = base_source.Span{offset: start, len: j - start};
    @at = j + 1;
    if (inner.len == 0)          { ret Ref{kind: REF_EMPTY, inner: inner}; }
    if (!name_is(source, inner)) { ret Ref{kind: REF_OTHER, inner: inner}; }
    ret Ref{kind: REF_NAME, inner: inner};
}

fun name_is(source: str, span: base_source.Span) bool {
    var i: usize = span.offset;
    for (i < span.offset + span.len) {
        val c:     u8   = source[i]::u8;
        val alpha: bool = (c >= 'a'::u8 && c <= 'z'::u8) || (c >= 'A'::u8 && c <= 'Z'::u8) || c == '_'::u8;
        val digit: bool = c >= '0'::u8 && c <= '9'::u8;
        if (!alpha && !(digit && i > span.offset)) { ret false; }
        i = i + 1;
    }
    ret true;
}
