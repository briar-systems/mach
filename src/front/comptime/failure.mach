# why a comptime evaluation has no value: refused for good, waiting on a later phase or
# an instance, or failed inside the compiler
use mach.base.diagnostic;
use diagnostic_kind: mach.base.diagnostic.kind;
use mach.base.fail;
use base_source: mach.base.source;
use A:           std.allocator;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use types_string: std.types.string;
use std.types.string.str;
use std.types.string.str_join;
use std.types.string.str_len;

pub def EvalFailKind: u8;

pub val EVAL_FAIL_NONE:           EvalFailKind = 0;
pub val EVAL_FAIL_REJECTED:       EvalFailKind = 1;
pub val EVAL_FAIL_UNBOUND:        EvalFailKind = 2;
pub val EVAL_FAIL_NEEDS_MEMBER:   EvalFailKind = 3;
pub val EVAL_FAIL_NEEDS_TYPES:    EvalFailKind = 4;
pub val EVAL_FAIL_NEEDS_LAYOUT:   EvalFailKind = 5;
pub val EVAL_FAIL_INTERNAL:       EvalFailKind = 6;
pub val EVAL_FAIL_NEEDS_INSTANCE: EvalFailKind = 7;
pub val EVAL_FAIL_NOT_INTEGER:    EvalFailKind = 8;
# a refusal typing already reported, so no reader reports it again
pub val EVAL_FAIL_TYPED: EvalFailKind = 9;

# diag: the diagnostic kind the failure is reported as, where it reaches the user
pub rec EvalFail {
    kind:    EvalFailKind;
    diag:    diagnostic_kind.Kind;
    message: str;
}

# a failure of the given kind
# ---
# kind:    why the evaluation has no value
# diag:    the diagnostic kind it is reported as
# message: the text reported, borrowed
# ret:     the failure
pub fun eval_error(kind: EvalFailKind, diag: diagnostic_kind.Kind, message: str) EvalFail {
    var f: EvalFail;
    f.kind    = kind;
    f.diag    = diag;
    f.message = message;
    ret f;
}

# an internal failure of the evaluator, a compiler defect wherever it surfaces
pub fun eval_internal(message: str) EvalFail {
    ret eval_error(EVAL_FAIL_INTERNAL, diagnostic_kind.COMPILER_INTERNAL, message);
}

# the evaluation failure a compiler failure means: a failure already reported is a rejection
# under `diag`, any other an internal failure carrying its description
# ---
# f:                the failure
# diag:             the diagnostic kind a rejection is reported as
# rejected_message: the text of a rejection
# ret:              the evaluation failure
pub fun eval_from_fail(f: fail.Fail, diag: diagnostic_kind.Kind, rejected_message: str) EvalFail {
    if (sel f.reported) { ret eval_error(EVAL_FAIL_REJECTED, diag, rejected_message); }
    ret eval_internal(fail.describe(f));
}

# a failure a walk with no place of its own returned to an evaluation: a refusal of the input
# is rejected under its own kind, which the evaluation reports at the node it stands on, and
# any other failure reads as eval_from_fail reads it
pub fun eval_from_refusal(f: fail.Fail, diag: diagnostic_kind.Kind, rejected_message: str) EvalFail {
    val k: diagnostic_kind.Kind = fail.kind_of(f);
    if (k == diagnostic_kind.NONE || k == diagnostic_kind.COMPILER_INTERNAL) { ret eval_from_fail(f, diag, rejected_message); }
    ret eval_error(EVAL_FAIL_REJECTED, k, fail.describe(f));
}

# a refusal reported as itself wherever a compile-time value was asked for, since it says why no
# value exists better than the asker can: a secret
pub fun stands_alone(f: EvalFail) bool {
    ret f.kind == EVAL_FAIL_REJECTED && f.diag == diagnostic_kind.SECRET_COMPTIME;
}

# whether a refusal is one typing reports itself wherever the expression is typed, naming
# more than the evaluator can: an expression typing refused, or a suffixed literal its suffix's type does not hold
pub fun typed_alone(kind: EvalFailKind, diag: diagnostic_kind.Kind) bool {
    ret kind == EVAL_FAIL_TYPED || (kind == EVAL_FAIL_REJECTED && diag == diagnostic_kind.LITERAL_OUT_OF_RANGE);
}

# whether a failure of a global initializer's own evaluation means it is no constant: it needs a
# value, a member, the types or a layout no constant gives it
pub fun not_constant(kind: EvalFailKind) bool {
    ret kind == EVAL_FAIL_UNBOUND || kind == EVAL_FAIL_NEEDS_MEMBER || kind == EVAL_FAIL_NEEDS_TYPES || kind == EVAL_FAIL_NEEDS_LAYOUT;
}

# whether a failure of kind `kind` reported as `diag` says the expression has no compile-time
# value at all, as a run-time binding, a call or a name no constant binds gives none, rather
# than a fault in a value it has. a context that asks for a constant refuses it under its own kind
pub fun no_value(kind: EvalFailKind, diag: diagnostic_kind.Kind) bool {
    if (not_constant(kind)) { ret true; }
    ret kind == EVAL_FAIL_REJECTED && (diag == diagnostic_kind.COMPTIME_NOT_CONSTANT || diag == diagnostic_kind.COMPTIME_NOT_EVALUABLE);
}

# reports the initializer at `span` of the global `name` as no constant, as lowering meets
# it; a decorator argument has no name
pub fun init_not_constant_report(alloc: *A.Allocator, diags: *diagnostic.DiagnosticStore, file: base_source.FileId, span: base_source.Span, name: opt[str]) err[fail.Fail] {
    if (sel name.none) {
        ret diagnostic.report(diags, diagnostic_kind.GLOBAL_INIT_NOT_CONSTANT, file, span, "a global initialiser must be a constant expression");
    }
    val res_joined: res[str, types_string.StrError] = str_join(alloc, "global initialiser of `", name.some, "` must be a constant expression");
    if (sel res_joined.err) { ret err[fail.Fail].err{fail.str_refused(res_joined.err)}; }
    val err_reported: err[fail.Fail] = diagnostic.report(diags, diagnostic_kind.GLOBAL_INIT_NOT_CONSTANT, file, span, res_joined.ok);
    A.deallocate[u8](alloc, res_joined.ok::*u8, str_len(res_joined.ok) + 1);
    ret err_reported;
}

# reports the initializer at `span` of the global `name` as no constant, as
# init_not_constant_report does, with the evaluator's reason it has no value as a note
pub fun init_no_value_report(diags: *diagnostic.DiagnosticStore, file: base_source.FileId, span: base_source.Span, name: str, why: str) err[fail.Fail] {
    val res_begun: res[diagnostic.DiagnosticBuilder, fail.Fail] = diagnostic.builder_initf(diags.a, diagnostic_kind.GLOBAL_INIT_NOT_CONSTANT, file, span,
        "global initialiser of `{}` must be a constant expression", name);
    if (sel res_begun.err) { ret err[fail.Fail].err{res_begun.err}; }
    var b: diagnostic.DiagnosticBuilder = res_begun.ok;
    if (why != nil && str_len(why) > 0) {
        val err_noted: err[fail.Fail] = diagnostic.attach_note(?b, why);
        if (sel err_noted.err) {
            diagnostic.builder_dnit(?b);
            ret err_noted;
        }
    }
    ret diagnostic.commit(?b, diags);
}
