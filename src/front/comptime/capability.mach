# what each phase lets a comptime evaluation ask of it: members, identifiers, types,
# fields and layout, published as one record per phase
use T:               std.allocator.testing;
use diagnostic_kind: mach.base.diagnostic.kind;
use mach.base.fail;
use mach.base.intern;
use mach.front.ast;
use ast_expr:         mach.front.ast.expr;
use ast_id:           mach.front.ast.id;
use ast_type:         mach.front.ast.type;
use comptime_deep:    mach.front.comptime.deep;
use comptime_failure: mach.front.comptime.failure;
use comptime_value:   mach.front.comptime.value;
use mach.type;
use type_field: mach.type.field;
use type_kind:  mach.type.kind;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.option.opt;
use std.types.result.res;
use std.types.string.str;

pub val FIELD_SEL_NAME:         u8 = 0;
pub val FIELD_SEL_TYPE:         u8 = 1;
pub val FIELD_SEL_OFFSET:       u8 = 2;
pub val FIELD_SEL_HAS_PAYLOAD:  u8 = 4;
pub val FIELD_SEL_CODE:         u8 = 5;
pub val FIELD_SEL_TYPE_BY_NAME: u8 = 6;

pub val COMPTIME_CASE_NO_PAYLOAD_MSG: str =
    "this case has no payload, so it has no `.type` or `.offset`. gate on `.has_payload` first";

pub val TYPE_QUERY_IS_RECORD:    u8 = 0;
pub val TYPE_QUERY_IS_UNION:     u8 = 1;
pub val TYPE_QUERY_IS_POINTER:   u8 = 2;
pub val TYPE_QUERY_NAME:         u8 = 3;
pub val TYPE_QUERY_IS_SECRET:    u8 = 4;
pub val TYPE_QUERY_IS_TAG:       u8 = 5;
pub val TYPE_QUERY_IS_INTEGER:   u8 = 6;
pub val TYPE_QUERY_IS_FLOAT:     u8 = 7;
pub val TYPE_QUERY_HOLDS_SECRET: u8 = 8;

def PhaseCapabilityKind: u8;

pub val PHASE_CAP_NONE:           PhaseCapabilityKind = 0;
pub val PHASE_CAP_LOADING:        PhaseCapabilityKind = 1;
pub val PHASE_CAP_RESOLUTION:     PhaseCapabilityKind = 2;
val     PHASE_CAP_SEMANTIC_NAMES: PhaseCapabilityKind = 3;
val     PHASE_CAP_SEMANTIC_TYPES: PhaseCapabilityKind = 4;
val     PHASE_CAP_LOWERING:       PhaseCapabilityKind = 5;

# the context of an evaluation that holds no phase capability
pub rec NoCapabilityContext {}

# the questions one phase answers for a comptime evaluation, each a function over the phase's
# context `T`, nil for a question the phase cannot answer. `kind` says which phase it is, and
# only the set each kind publishes is complete
# ---
# expression: an expression node as the phase reads it
# kind:       the phase, one of PHASE_CAP_
# member:     the value of a module member `m.name`, none when the member names no constant
# type_:      the type id a type operand names
# query:      the answer to a TYPE_QUERY_ about a type id
# layout:     the value of a layout intrinsic at an expression
# ident:      whether a bare name binds a run-time value, which makes it no constant
# cast:       a value converted by the cast expression it is the operand of
# scalar:     a value fit to the scalar type the phase gave an expression
pub rec PhaseCapabilities[T] {
    expression: fun(*T, *ast.Ast, ast_id.ExprId) res[ast_expr.Expr, comptime_failure.EvalFail];
    # a type node as the phase reads it, a literal head split into type and case once names are
    # resolved
    head:   fun(*T, *ast.Ast, ast_id.TypeId) res[ast_type.Type, comptime_failure.EvalFail];
    kind:   PhaseCapabilityKind;
    member: fun(*T, ast_id.ExprId) res[opt[comptime_value.CTValue], comptime_failure.EvalFail];
    type_:  fun(*T, ast_id.ExprId) res[opt[u32], comptime_failure.EvalFail];
    # the type store the field descriptors read, and the byte offset of a field, which only
    # the phase that knows layout answers
    types:  fun(*T) *type.TypeInterner;
    offset: fun(*T, u32, u32) res[opt[comptime_value.CTValue], comptime_failure.EvalFail];
    # the zero of a type, which a member an element literal leaves out holds: a scalar's value,
    # or an aggregate as a node `store` answers
    zero:   fun(*T, u32) res[comptime_value.CTValue, comptime_failure.EvalFail];
    query:  fun(*T, u32, u8) res[opt[comptime_value.CTValue], comptime_failure.EvalFail];
    layout: fun(*T, u32) res[opt[comptime_value.CTValue], comptime_failure.EvalFail];
    ident:  fun(*T, ast_id.ExprId) bool;
    # the value of the module constant a bare name names, which only sema binds on demand
    constant: fun(*T, ast_id.ExprId) res[opt[comptime_value.CTValue], comptime_failure.EvalFail];
    cast:     fun(*T, ast_id.ExprId, comptime_value.CTValue) res[comptime_value.CTValue, comptime_failure.EvalFail];
    scalar:   fun(*T, ast_id.ExprId, comptime_value.CTValue) res[comptime_value.CTValue, comptime_failure.EvalFail];
    # whether the place an expression reads is of a type that holds a secret, which only sema answers
    secret: fun(*T, ast_id.ExprId) bool;
    # the store of published constant values of the module with a stable id, which only the
    # phases that read interfaces hold
    store: fun(*T, u32) res[*comptime_deep.Store, comptime_failure.EvalFail];
}

# a capability set of phase `kind` that answers only from the parsed tree, every other question nil
# ---
# kind: the phase
# ret:  the set, which a publisher fills in and checks
pub fun capabilities_make[T](kind: PhaseCapabilityKind) PhaseCapabilities[T] {
    var caps: PhaseCapabilities[T];
    caps.kind       = kind;
    caps.expression = parsed_expression[T];
    caps.head       = parsed_head[T];
    caps.member     = nil;
    caps.type_      = nil;
    caps.types      = nil;
    caps.offset     = nil;
    caps.zero       = nil;
    caps.query      = nil;
    caps.layout     = nil;
    caps.ident      = nil;
    caps.constant   = nil;
    caps.cast       = nil;
    caps.scalar     = nil;
    caps.store      = nil;
    caps.secret     = nil;
    ret caps;
}

# an expression node as the parse made it
# ---
# ctx: the phase context, unused
# a:   the tree
# eid: the expression
# ret: a copy of the node, or an internal failure when the tree is nil or the id out of range
pub fun parsed_expression[T](ctx: *T, a: *ast.Ast, eid: ast_id.ExprId) res[ast_expr.Expr, comptime_failure.EvalFail] {
    if (a == nil) { ret res[ast_expr.Expr, comptime_failure.EvalFail].err{comptime_failure.eval_internal("comptime expression has no parsed owner")}; }
    val opt_found: opt[*ast_expr.Expr] = ast.get_expr(a, eid);
    if (sel opt_found.none) { ret res[ast_expr.Expr, comptime_failure.EvalFail].err{comptime_failure.eval_internal("comptime expression identity is out of range")}; }
    ret res[ast_expr.Expr, comptime_failure.EvalFail].ok{@opt_found.some};
}

# a type node as the parse made it
# ---
# ctx: the phase context, unused
# a:   the tree
# tid: the type node
# ret: a copy of the node, or an internal failure when the tree is nil or the id out of range
pub fun parsed_head[T](ctx: *T, a: *ast.Ast, tid: ast_id.TypeId) res[ast_type.Type, comptime_failure.EvalFail] {
    if (a == nil) { ret res[ast_type.Type, comptime_failure.EvalFail].err{comptime_failure.eval_internal("comptime type has no parsed owner")}; }
    val opt_found: opt[*ast_type.Type] = ast.get_type(a, tid);
    if (sel opt_found.none) { ret res[ast_type.Type, comptime_failure.EvalFail].err{comptime_failure.eval_internal("comptime type identity is out of range")}; }
    ret res[ast_type.Type, comptime_failure.EvalFail].ok{@opt_found.some};
}

# a type node as the active phase reads it
# ---
# ctx:  the phase context, nil only for a set of no phase
# caps: the phase's capabilities
# a:    the tree
# tid:  the type node
# ret:  the node, or an internal failure when the set is incomplete or its context missing
pub fun read_head[T](ctx: *T, caps: PhaseCapabilities[T], a: *ast.Ast, tid: ast_id.TypeId) res[ast_type.Type, comptime_failure.EvalFail] {
    if (!capabilities_complete[T](caps) || (ctx == nil && caps.kind != PHASE_CAP_NONE)) {
        ret res[ast_type.Type, comptime_failure.EvalFail].err{comptime_failure.eval_internal("comptime type requires its active phase capability")};
    }
    ret caps.head(ctx, a, tid);
}

# an expression node as the active phase reads it
# ---
# ctx:  the phase context, nil only for a set of no phase
# caps: the phase's capabilities
# a:    the tree
# eid:  the expression
# ret:  the node, or an internal failure when the set is incomplete or its context missing
pub fun read_expression[T](ctx: *T, caps: PhaseCapabilities[T], a: *ast.Ast, eid: ast_id.ExprId) res[ast_expr.Expr, comptime_failure.EvalFail] {
    if (!capabilities_complete[T](caps) || (ctx == nil && caps.kind != PHASE_CAP_NONE)) {
        ret res[ast_expr.Expr, comptime_failure.EvalFail].err{comptime_failure.eval_internal("comptime expression requires its active phase capability")};
    }
    ret caps.expression(ctx, a, eid);
}

# no phase capability: an expression reads literals and the constants its context binds
pub fun no_capabilities() PhaseCapabilities[NoCapabilityContext] {
    ret capabilities_make[NoCapabilityContext](PHASE_CAP_NONE);
}

fun capabilities_complete[T](caps: PhaseCapabilities[T]) bool {
    if (caps.expression == nil || caps.head == nil) { ret false; }
    val no_types: bool = caps.type_ == nil && caps.offset == nil && caps.zero == nil && caps.query == nil && caps.layout == nil && caps.cast == nil && caps.scalar == nil;
    val semantic: bool = caps.kind == PHASE_CAP_SEMANTIC_NAMES || caps.kind == PHASE_CAP_SEMANTIC_TYPES;
    if ((caps.constant != nil) != semantic)                                   { ret false; }
    if ((caps.secret != nil) != semantic)                                     { ret false; }
    if ((caps.store != nil) != (semantic || caps.kind == PHASE_CAP_LOWERING)) { ret false; }
    if (caps.kind == PHASE_CAP_NONE) {
        ret caps.member == nil && no_types && caps.ident == nil;
    }
    if (caps.kind == PHASE_CAP_LOADING) {
        # the load casts to the integer a def chain names, so it may carry a cast and no other type capability
        val no_other_types: bool = caps.type_ == nil && caps.offset == nil && caps.zero == nil && caps.query == nil && caps.layout == nil && caps.scalar == nil;
        ret caps.member != nil && no_other_types && caps.ident == nil;
    }
    if (caps.kind == PHASE_CAP_RESOLUTION) {
        ret caps.member == nil && no_types && caps.ident != nil;
    }
    if (caps.kind == PHASE_CAP_SEMANTIC_NAMES) {
        ret caps.member != nil && no_types && caps.ident != nil;
    }
    if (caps.kind == PHASE_CAP_SEMANTIC_TYPES || caps.kind == PHASE_CAP_LOWERING) {
        ret caps.member != nil && caps.type_ != nil && caps.offset != nil && caps.zero != nil && caps.types != nil
            && caps.query != nil && caps.layout != nil && caps.ident != nil && caps.cast != nil && caps.scalar != nil;
    }
    ret false;
}

fun capabilities_publish[T](caps: PhaseCapabilities[T]) res[PhaseCapabilities[T], fail.Fail] {
    if (!capabilities_complete[T](caps)) {
        ret res[PhaseCapabilities[T], fail.Fail].err{fail.message("comptime: incomplete or contradictory phase capabilities")};
    }
    ret res[PhaseCapabilities[T], fail.Fail].ok{caps};
}

# the capabilities of the load: module members, casts to the integer a def chain names, and type
# heads
# ---
# ret: the checked set, or a failure when it is incomplete or contradictory
pub fun loading_capabilities[T](member: fun(*T, ast_id.ExprId) res[opt[comptime_value.CTValue], comptime_failure.EvalFail],
    cast: fun(*T, ast_id.ExprId, comptime_value.CTValue) res[comptime_value.CTValue, comptime_failure.EvalFail],
    head: fun(*T, *ast.Ast, ast_id.TypeId) res[ast_type.Type, comptime_failure.EvalFail]) res[PhaseCapabilities[T], fail.Fail] {
    var caps: PhaseCapabilities[T] = capabilities_make[T](PHASE_CAP_LOADING);
    caps.member = member;
    caps.cast   = cast;
    caps.head   = head;
    ret capabilities_publish[T](caps);
}

# the capabilities of name resolution: which names bind run-time values, and expressions and
# type heads as resolution reads them
# ---
# ret: the checked set, or a failure when it is incomplete or contradictory
pub fun resolution_capabilities[T](ident: fun(*T, ast_id.ExprId) bool,
    expression: fun(*T, *ast.Ast, ast_id.ExprId) res[ast_expr.Expr, comptime_failure.EvalFail],
    head: fun(*T, *ast.Ast, ast_id.TypeId) res[ast_type.Type, comptime_failure.EvalFail]) res[PhaseCapabilities[T], fail.Fail] {
    var caps: PhaseCapabilities[T] = capabilities_make[T](PHASE_CAP_RESOLUTION);
    caps.ident      = ident;
    caps.expression = expression;
    caps.head       = head;
    ret capabilities_publish[T](caps);
}

# the capabilities of sema before types are known: members, module constants, published stores,
# run-time names, secret places, and expressions and type heads
# ---
# ret: the checked set, or a failure when it is incomplete or contradictory
pub fun semantic_name_capabilities[T](
    member: fun(*T, ast_id.ExprId) res[opt[comptime_value.CTValue], comptime_failure.EvalFail],
    constant: fun(*T, ast_id.ExprId) res[opt[comptime_value.CTValue], comptime_failure.EvalFail],
    store: fun(*T, u32) res[*comptime_deep.Store, comptime_failure.EvalFail],
    ident: fun(*T, ast_id.ExprId) bool,
    secret: fun(*T, ast_id.ExprId) bool,
    expression: fun(*T, *ast.Ast, ast_id.ExprId) res[ast_expr.Expr, comptime_failure.EvalFail],
    head: fun(*T, *ast.Ast, ast_id.TypeId) res[ast_type.Type, comptime_failure.EvalFail]) res[PhaseCapabilities[T], fail.Fail] {
    var caps: PhaseCapabilities[T] = capabilities_make[T](PHASE_CAP_SEMANTIC_NAMES);
    caps.member     = member;
    caps.constant   = constant;
    caps.secret     = secret;
    caps.store      = store;
    caps.ident      = ident;
    caps.expression = expression;
    caps.head       = head;
    ret capabilities_publish[T](caps);
}

# the capabilities of sema once types are known: every question sema answers, layout included
# ---
# ret: the checked set, or a failure when it is incomplete or contradictory
pub fun semantic_type_capabilities[T](
    member: fun(*T, ast_id.ExprId) res[opt[comptime_value.CTValue], comptime_failure.EvalFail],
    constant: fun(*T, ast_id.ExprId) res[opt[comptime_value.CTValue], comptime_failure.EvalFail],
    store: fun(*T, u32) res[*comptime_deep.Store, comptime_failure.EvalFail],
    type_: fun(*T, ast_id.ExprId) res[opt[u32], comptime_failure.EvalFail],
    types: fun(*T) *type.TypeInterner,
    offset: fun(*T, u32, u32) res[opt[comptime_value.CTValue], comptime_failure.EvalFail],
    zero: fun(*T, u32) res[comptime_value.CTValue, comptime_failure.EvalFail],
    query: fun(*T, u32, u8) res[opt[comptime_value.CTValue], comptime_failure.EvalFail],
    layout: fun(*T, u32) res[opt[comptime_value.CTValue], comptime_failure.EvalFail],
    cast: fun(*T, ast_id.ExprId, comptime_value.CTValue) res[comptime_value.CTValue, comptime_failure.EvalFail],
    scalar: fun(*T, ast_id.ExprId, comptime_value.CTValue) res[comptime_value.CTValue, comptime_failure.EvalFail],
    ident: fun(*T, ast_id.ExprId) bool,
    secret: fun(*T, ast_id.ExprId) bool,
    expression: fun(*T, *ast.Ast, ast_id.ExprId) res[ast_expr.Expr, comptime_failure.EvalFail],
    head: fun(*T, *ast.Ast, ast_id.TypeId) res[ast_type.Type, comptime_failure.EvalFail]) res[PhaseCapabilities[T], fail.Fail] {
    var caps: PhaseCapabilities[T] = capabilities_make[T](PHASE_CAP_SEMANTIC_TYPES);
    caps.member     = member;
    caps.constant   = constant;
    caps.secret     = secret;
    caps.store      = store;
    caps.type_      = type_;
    caps.types      = types;
    caps.offset     = offset;
    caps.zero       = zero;
    caps.query      = query;
    caps.layout     = layout;
    caps.cast       = cast;
    caps.scalar     = scalar;
    caps.ident      = ident;
    caps.expression = expression;
    caps.head       = head;
    ret capabilities_publish[T](caps);
}

# the capabilities of lowering: every question of typed sema except module constants and secret places
# ---
# ret: the checked set, or a failure when it is incomplete or contradictory
pub fun lowering_capabilities[T](
    member: fun(*T, ast_id.ExprId) res[opt[comptime_value.CTValue], comptime_failure.EvalFail],
    store: fun(*T, u32) res[*comptime_deep.Store, comptime_failure.EvalFail],
    type_: fun(*T, ast_id.ExprId) res[opt[u32], comptime_failure.EvalFail],
    types: fun(*T) *type.TypeInterner,
    offset: fun(*T, u32, u32) res[opt[comptime_value.CTValue], comptime_failure.EvalFail],
    zero: fun(*T, u32) res[comptime_value.CTValue, comptime_failure.EvalFail],
    query: fun(*T, u32, u8) res[opt[comptime_value.CTValue], comptime_failure.EvalFail],
    layout: fun(*T, u32) res[opt[comptime_value.CTValue], comptime_failure.EvalFail],
    cast: fun(*T, ast_id.ExprId, comptime_value.CTValue) res[comptime_value.CTValue, comptime_failure.EvalFail],
    scalar: fun(*T, ast_id.ExprId, comptime_value.CTValue) res[comptime_value.CTValue, comptime_failure.EvalFail],
    ident: fun(*T, ast_id.ExprId) bool,
    expression: fun(*T, *ast.Ast, ast_id.ExprId) res[ast_expr.Expr, comptime_failure.EvalFail],
    head: fun(*T, *ast.Ast, ast_id.TypeId) res[ast_type.Type, comptime_failure.EvalFail]) res[PhaseCapabilities[T], fail.Fail] {
    var caps: PhaseCapabilities[T] = capabilities_make[T](PHASE_CAP_LOWERING);
    caps.member     = member;
    caps.store      = store;
    caps.type_      = type_;
    caps.types      = types;
    caps.offset     = offset;
    caps.zero       = zero;
    caps.query      = query;
    caps.layout     = layout;
    caps.cast       = cast;
    caps.scalar     = scalar;
    caps.ident      = ident;
    caps.expression = expression;
    caps.head       = head;
    ret capabilities_publish[T](caps);
}

# whether the phase answers module members
# ---
# ctx:  the phase context
# caps: the phase's capabilities
# ret:  true for the load, sema and lowering, false for a nil context or an incomplete set
pub fun capabilities_have_member[T](ctx: *T, caps: PhaseCapabilities[T]) bool {
    if (ctx == nil || !capabilities_complete[T](caps)) { ret false; }
    ret caps.kind == PHASE_CAP_LOADING
        || caps.kind == PHASE_CAP_SEMANTIC_NAMES
        || caps.kind == PHASE_CAP_SEMANTIC_TYPES
        || caps.kind == PHASE_CAP_LOWERING;
}

# whether the phase answers which bare names bind run-time values
# ---
# ctx:  the phase context
# caps: the phase's capabilities
# ret:  true for resolution, sema and lowering, false for a nil context or an incomplete set
pub fun capabilities_have_ident[T](ctx: *T, caps: PhaseCapabilities[T]) bool {
    if (ctx == nil || !capabilities_complete[T](caps)) { ret false; }
    ret caps.kind == PHASE_CAP_RESOLUTION
        || caps.kind == PHASE_CAP_SEMANTIC_NAMES
        || caps.kind == PHASE_CAP_SEMANTIC_TYPES
        || caps.kind == PHASE_CAP_LOWERING;
}

# whether the phase answers the values of module constants
# ---
# ctx:  the phase context
# caps: the phase's capabilities
# ret:  true for sema, false for a nil context or an incomplete set
pub fun capabilities_have_constant[T](ctx: *T, caps: PhaseCapabilities[T]) bool {
    if (ctx == nil || !capabilities_complete[T](caps)) { ret false; }
    ret caps.constant != nil;
}

# the store holding the node a value names, which only a phase that reads interfaces has
pub fun store_of[T](ctx: *T, caps: PhaseCapabilities[T], module: u32) res[*comptime_deep.Store, comptime_failure.EvalFail] {
    if (ctx == nil || !capabilities_complete[T](caps) || caps.store == nil) {
        ret res[*comptime_deep.Store, comptime_failure.EvalFail].err{comptime_failure.eval_internal("comptime: a published constant value is read outside a phase that reads interfaces")};
    }
    ret caps.store(ctx, module);
}

# whether the phase answers types and layout
# ---
# ctx:  the phase context
# caps: the phase's capabilities
# ret:  true for typed sema and lowering, false for a nil context or an incomplete set
pub fun capabilities_have_types[T](ctx: *T, caps: PhaseCapabilities[T]) bool {
    if (ctx == nil || !capabilities_complete[T](caps)) { ret false; }
    ret caps.kind == PHASE_CAP_SEMANTIC_TYPES || caps.kind == PHASE_CAP_LOWERING;
}

# whether the phase is lowering, which materializes only values an earlier phase asked for
pub fun capabilities_lowering[T](caps: PhaseCapabilities[T]) bool {
    ret caps.kind == PHASE_CAP_LOWERING;
}

# whether the phase converts cast operands
# ---
# ctx:  the phase context
# caps: the phase's capabilities
# ret:  true for the load, typed sema and lowering, false for a nil context or an incomplete set
pub fun capabilities_cast[T](ctx: *T, caps: PhaseCapabilities[T]) bool {
    if (ctx == nil || !capabilities_complete[T](caps) || caps.cast == nil) { ret false; }
    ret capabilities_have_types[T](ctx, caps) || caps.kind == PHASE_CAP_LOADING;
}

# what a field descriptor answers about field `index` of `owner`, `pick` naming the member
# asked; every answer but the offset reads the type store, and the offset is the phase's
pub fun field_of[T](ctx: *T, caps: PhaseCapabilities[T], owner: u32, index: u32, pick: u8) res[opt[comptime_value.CTValue], comptime_failure.EvalFail] {
    val owner_ty: type_kind.TypeId = owner::type_kind.TypeId;
    if (pick == FIELD_SEL_TYPE_BY_NAME) { ret res[opt[comptime_value.CTValue], comptime_failure.EvalFail].ok{type_by_name(caps.types(ctx), owner_ty, index::intern.StrId)}; }

    val opt_field_at: opt[*type_field.Entry] = type.field_at(caps.types(ctx), owner_ty, index);
    if (sel opt_field_at.none) { ret res[opt[comptime_value.CTValue], comptime_failure.EvalFail].ok{opt[comptime_value.CTValue].none{}}; }
    val fe: *type_field.Entry = opt_field_at.some;

    if (pick == FIELD_SEL_NAME) { ret res[opt[comptime_value.CTValue], comptime_failure.EvalFail].ok{opt[comptime_value.CTValue].some{comptime_value.ct_str(fe.name)}}; }
    if (pick == FIELD_SEL_HAS_PAYLOAD) {
        ret res[opt[comptime_value.CTValue], comptime_failure.EvalFail].ok{opt[comptime_value.CTValue].some{comptime_value.ct_u1(!type_kind.is_nil(fe.ty))}};
    }
    if (pick == FIELD_SEL_CODE) { ret res[opt[comptime_value.CTValue], comptime_failure.EvalFail].ok{opt[comptime_value.CTValue].some{comptime_value.ct_uint(index::u64)}}; }
    # a payloadless case owns no storage, so it has neither a type nor an offset
    if (type_kind.is_nil(fe.ty) && (pick == FIELD_SEL_TYPE || pick == FIELD_SEL_OFFSET)) {
        ret res[opt[comptime_value.CTValue], comptime_failure.EvalFail].err{comptime_failure.eval_error(comptime_failure.EVAL_FAIL_REJECTED, diagnostic_kind.COMPTIME_CASE_NO_PAYLOAD, COMPTIME_CASE_NO_PAYLOAD_MSG)};
    }
    if (pick == FIELD_SEL_TYPE)   { ret res[opt[comptime_value.CTValue], comptime_failure.EvalFail].ok{opt[comptime_value.CTValue].some{comptime_value.ct_type(fe.ty::u32)}}; }
    if (pick == FIELD_SEL_OFFSET) { ret caps.offset(ctx, owner, index); }
    ret res[opt[comptime_value.CTValue], comptime_failure.EvalFail].ok{opt[comptime_value.CTValue].none{}};
}

# the entry of the field or case `name` declares on `owner`
fun field_named(types: *type.TypeInterner, owner: type_kind.TypeId, name: intern.StrId) opt[*type_field.Entry] {
    val stripped: type_kind.TypeId = type.strip_secret(types, owner);
    val n:        u32              = type.field_count(types, stripped);
    var i:        u32              = 0;
    for (i < n) {
        val opt_field_at: opt[*type_field.Entry] = type.field_at(types, stripped, i);
        if (sel opt_field_at.some && intern.str_same(opt_field_at.some.name, name)) { ret opt_field_at; }
        i = i + 1;
    }
    ret opt[*type_field.Entry].none{};
}

# the declared type of a field or case payload named on an owner; none for an unknown name or a payloadless case
fun type_by_name(types: *type.TypeInterner, owner: type_kind.TypeId, name: intern.StrId) opt[comptime_value.CTValue] {
    val opt_field_named: opt[*type_field.Entry] = field_named(types, owner, name);
    if (sel opt_field_named.none)                  { ret opt[comptime_value.CTValue].none{}; }
    if (type_kind.is_nil(opt_field_named.some.ty)) { ret opt[comptime_value.CTValue].none{}; }
    ret opt[comptime_value.CTValue].some{comptime_value.ct_type(opt_field_named.some.ty::u32)};
}
