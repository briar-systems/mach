# field graphs: the field tables a set of types reaches, captured for another reader
#
# `capture` walks every type the roots reach, preparing each record, union and tag it meets, and
# copies its fields, its tag discriminator and its layout decorations into a graph. `install`
# publishes a graph into the type table's current projection and refuses one that disagrees with
# a table already there, so a module's typing or published surface brings the field tables it
# was read with.

use T: std.allocator.testing;
use std.collections.sort;
use collections_vector: std.collections.vector;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;

use mach.base.fail;
use mach.base.intern;
use mach.session;
use mach.type;
use mach.type.deprecation;
use type_field: mach.type.field;
use type_kind:  mach.type.kind;
use type_scan:  mach.type.scan;

# one record, union, tag or materialized instance a graph captured
# ---
# ty:         the type the node describes
# entries:    its fields, in declaration order
# decoration: its layout decorations
pub rec Node {
    ty:         type_kind.TypeId;
    entries:    collections_vector.Vector[type_field.Entry];
    decoration: type_field.Decoration;
    # the declared discriminator of a tag nominal; TYPE_NIL on every other node
    disc: type_kind.TypeId;
}

# one group of root types a capture starts from
# ---
# data: the first root
# len:  how many roots the group holds
pub rec Roots {
    data: *type_kind.TypeId;
    len:  usize;
}

def CaptureMode: u8;

pub val RECIPES:      CaptureMode = 0;
pub val MATERIALIZED: CaptureMode = 1;

# the field tables a capture copied, sorted by type index
# ---
# nodes:                the captured nodes, owned by the graph
# installed:            whether `install` has published the graph
# installed_generation: the projection generation it was published under
pub rec Graph {
    nodes:                collections_vector.Vector[Node];
    installed:            bool;
    installed_generation: u64;
}

# an empty graph
# ---
# a:   the allocator its nodes are held in
# ret: the graph, released with `dnit`
pub fun init(a: *A.Allocator) Graph {
    ret Graph{nodes: collections_vector.init[Node](a), installed: false, installed_generation: 0};
}

# releases every node of `graph` and the graph's own storage
# ---
# graph: the graph to release
pub fun dnit(graph: *Graph) {
    var i: usize = 0;
    for (i < graph.nodes.len) {
        collections_vector.dnit[type_field.Entry](?graph.nodes.data[i].entries);
        i = i + 1;
    }
    collections_vector.dnit[Node](?graph.nodes);
}

fun node_compare(left: *Node, right: *Node) i64 {
    if (type_kind.index(left.ty) < type_kind.index(right.ty)) { ret -1; }
    if (type_kind.index(left.ty) > type_kind.index(right.ty)) { ret 1; }
    ret 0;
}

fun enqueue(ti: *type.TypeInterner, scan: *type_scan.Scan, pending: *collections_vector.Vector[type_kind.TypeId],
    ty: type_kind.TypeId) err[fail.Fail] {
    if (type_kind.is_nil(ty) || type_kind.is_error(ty)) { ret err[fail.Fail].ok{}; }
    val opt_found: opt[*type.Type] = type.get(ti, ty);
    if (!sel opt_found.some) { ret err[fail.Fail].err{fail.message("field graph contains an invalid type identity")}; }
    val res_marked: res[type_scan.Mark, fail.Fail] = type.type_scan_mark(ti, scan, ty);
    if (sel res_marked.err)                    { ret err[fail.Fail].err{res_marked.err}; }
    if (res_marked.ok == type_scan.VISIT_SEEN) { ret err[fail.Fail].ok{}; }
    val res_queued: res[usize, A.Error] = collections_vector.push[type_kind.TypeId](pending, ty);
    if (sel res_queued.err) { ret err[fail.Fail].err{fail.refused(res_queued.err)}; }
    ret err[fail.Fail].ok{};
}

fun enqueue_parameters(ti: *type.TypeInterner, scan: *type_scan.Scan, pending: *collections_vector.Vector[type_kind.TypeId],
    start: u32, len: u32) err[fail.Fail] {
    var i: u32 = 0;
    for (i < len) {
        val opt_parameter: opt[type_kind.TypeId] = type.get_param(ti, start + i);
        if (!sel opt_parameter.some) { ret err[fail.Fail].err{fail.message("field graph contains an invalid type parameter run")}; }
        val err_added: err[fail.Fail] = enqueue(ti, scan, pending, opt_parameter.some);
        if (sel err_added.err) { ret err_added; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# a handle's operands are its declaration's site where no target mints it, else the
# words and types of the kind it is minted as, whose types the graph reaches
fun enqueue_handle(ti: *type.TypeInterner, scan: *type_scan.Scan, pending: *collections_vector.Vector[type_kind.TypeId],
    handle: type.TypeHandle) err[fail.Fail] {
    if (handle.ctor == type.NO_HANDLE_CTOR) { ret err[fail.Fail].ok{}; }
    var i: u32 = 0;
    for (i + 1 < handle.ops_len) {
        val part: u32 = ti.handle_ops[handle.ops_start + i];
        val held: u32 = ti.handle_ops[handle.ops_start + i + 1];
        i = i + 2;
        if (part != type.HANDLE_PART_TYPE) { cnt; }
        val err_added: err[fail.Fail] = enqueue(ti, scan, pending, type_kind.id(held));
        if (sel err_added.err) { ret err_added; }
    }
    ret err[fail.Fail].ok{};
}

fun capture_node(s: *session.Session, graph: *Graph, scan: *type_scan.Scan,
    pending: *collections_vector.Vector[type_kind.TypeId], ty: type_kind.TypeId) err[fail.Fail] {
    var node: Node;
    node.ty         = ty;
    node.entries    = collections_vector.init[type_field.Entry](graph.nodes.a);
    node.decoration = type.decoration_of(s.types, ty);
    node.disc       = type.tag_discriminator(s.types, ty);
    var transferred: bool = false;
    fin {
        if (!transferred) { collections_vector.dnit[type_field.Entry](?node.entries); }
    }
    val opt_table: opt[*type_field.Table] = type.field_table_for(s.types, ty);
    if (!sel opt_table.some) { ret err[fail.Fail].err{fail.message("prepared nominal field recipe is unavailable")}; }
    {
        val current: *type_field.Table = opt_table.some;
        var i:       u32               = 0;
        for (i < current.fields_len) {
            val field:      *type_field.Entry   = type.field_entry_at(s.types, current, i);
            val res_copied: res[usize, A.Error] = collections_vector.push[type_field.Entry](?node.entries, @field);
            if (sel res_copied.err) { ret err[fail.Fail].err{fail.refused(res_copied.err)}; }
            val err_added: err[fail.Fail] = enqueue(s.types, scan, pending, field.ty);
            if (sel err_added.err) { ret err_added; }
            i = i + 1;
        }
    }
    val res_appended: res[usize, A.Error] = collections_vector.push[Node](?graph.nodes, node);
    if (sel res_appended.err) { ret err[fail.Fail].err{fail.refused(res_appended.err)}; }
    transferred = true;
    ret err[fail.Fail].ok{};
}

# walks every type the roots reach, preparing each record, union and tag, and copies the
# fields, discriminator and decorations of each into a new graph. in `MATERIALIZED` mode an
# instance that has a field table is captured as well
# ---
# s:       the session whose type table is read
# a:       the allocator the graph is held in
# roots:   the root groups
# count:   how many groups `roots` holds
# mode:    `RECIPES` or `MATERIALIZED`
# ctx:     the context passed to `prepare`
# prepare: prepares one nominal's field table before it is read
# ret:     the graph, owned by the caller and released with `dnit`, or the failure of a scan,
#          an allocation, a preparation or an invalid argument
pub fun capture[T](s: *session.Session, a: *A.Allocator, roots: *Roots, count: usize, mode: CaptureMode, ctx: *T,
    prepare: fun(*T, type_kind.TypeId) err[fail.Fail]) res[Graph, fail.Fail] {
    if (mode != RECIPES && mode != MATERIALIZED) { ret res[Graph, fail.Fail].err{fail.message("invalid field graph capture mode")}; }
    if (roots == nil && count != 0)              { ret res[Graph, fail.Fail].err{fail.message("field graph roots are nil")}; }
    if (ctx == nil || prepare == nil)            { ret res[Graph, fail.Fail].err{fail.message("field graph capture requires an active preparation capability")}; }
    var graph:    Graph = init(a);
    var complete: bool  = false;
    fin {
        if (!complete) { dnit(?graph); }
    }
    var scan:         type_scan.Scan;
    val err_scanning: err[fail.Fail] = type.type_scan_begin(s.types, ?scan);
    if (sel err_scanning.err) { ret res[Graph, fail.Fail].err{err_scanning.err}; }
    fin { type.type_scan_end(s.types, ?scan); }
    var pending: collections_vector.Vector[type_kind.TypeId] = collections_vector.init[type_kind.TypeId](a);
    fin { collections_vector.dnit[type_kind.TypeId](?pending); }
    var i: usize = 0;
    for (i < count) {
        val group: Roots = roots[i];
        if (group.data == nil && group.len != 0) { ret res[Graph, fail.Fail].err{fail.message("field graph root group is nil")}; }
        var j: usize = 0;
        for (j < group.len) {
            val err_added: err[fail.Fail] = enqueue(s.types, ?scan, ?pending, group.data[j]);
            if (sel err_added.err) { ret res[Graph, fail.Fail].err{err_added.err}; }
            j = j + 1;
        }
        i = i + 1;
    }
    i = 0;
    for (i < pending.len) {
        val ty:          type_kind.TypeId = pending.data[i];
        val opt_initial: opt[*type.Type]  = type.get(s.types, ty);
        if (sel opt_initial.none) { ret res[Graph, fail.Fail].err{fail.message("field graph contains an invalid type identity")}; }
        val kind: type_kind.TypeKind = opt_initial.some.kind;
        if (kind == type_kind.TYPE_REC || kind == type_kind.TYPE_UNI || kind == type_kind.TYPE_TAG) {
            val err_prepared: err[fail.Fail] = prepare(ctx, ty);
            if (sel err_prepared.err) { ret res[Graph, fail.Fail].err{err_prepared.err}; }
        }
        val opt_info: opt[*type.Type] = type.get(s.types, ty);
        if (sel opt_info.none) { ret res[Graph, fail.Fail].err{fail.message("field graph type disappeared during capture")}; }
        val node:  *type.Type       = opt_info.some;
        var child: type_kind.TypeId = type_kind.TYPE_NIL;
        if (node.kind == type_kind.TYPE_POINTER) { child = node.data.pointer.base; }
        or (node.kind == type_kind.TYPE_ARRAY)   { child = node.data.array.base; }
        or (node.kind == type_kind.TYPE_SECRET)  { child = node.data.secret.base; }
        or (node.kind == type_kind.TYPE_FUN) {
            child = node.data.fn.ret_type;
            val err_parameters: err[fail.Fail] = enqueue_parameters(s.types, ?scan, ?pending,
                node.data.fn.params_start, node.data.fn.params_len);
            if (sel err_parameters.err) { ret res[Graph, fail.Fail].err{err_parameters.err}; }
        }
        or (node.kind == type_kind.TYPE_INSTANCE) {
            child = node.data.instance.nominal;
            val err_parameters: err[fail.Fail] = enqueue_parameters(s.types, ?scan, ?pending,
                node.data.instance.args_start, node.data.instance.args_len);
            if (sel err_parameters.err) { ret res[Graph, fail.Fail].err{err_parameters.err}; }
        }
        or (node.kind == type_kind.TYPE_HANDLE) {
            val err_operands: err[fail.Fail] = enqueue_handle(s.types, ?scan, ?pending, node.data.handle);
            if (sel err_operands.err) { ret res[Graph, fail.Fail].err{err_operands.err}; }
        }
        val err_added: err[fail.Fail] = enqueue(s.types, ?scan, ?pending, child);
        if (sel err_added.err) { ret res[Graph, fail.Fail].err{err_added.err}; }
        val opt_table: opt[*type_field.Table] = type.field_table_for(s.types, ty);
        if (node.kind == type_kind.TYPE_REC || node.kind == type_kind.TYPE_UNI || node.kind == type_kind.TYPE_TAG
            || (mode == MATERIALIZED && node.kind == type_kind.TYPE_INSTANCE && sel opt_table.some)) {
            val err_copied: err[fail.Fail] = capture_node(s, ?graph, ?scan, ?pending, ty);
            if (sel err_copied.err) { ret res[Graph, fail.Fail].err{err_copied.err}; }
        }
        i = i + 1;
    }
    sort.sort_by[Node](graph.nodes.data, graph.nodes.len, node_compare);
    complete = true;
    ret res[Graph, fail.Fail].ok{graph};
}

fun same_fields(s: *session.Session, table: *type_field.Table, node: *Node) bool {
    if (table.fields_len::usize != node.entries.len) { ret false; }
    var i: u32 = 0;
    for (i < table.fields_len) {
        val entry: *type_field.Entry = type.field_entry_at(s.types, table, i);
        if (!intern.str_same(entry.name, node.entries.data[i].name) || !type_kind.same(entry.ty, node.entries.data[i].ty)
            || !deprecation.equal(entry.deprecation, node.entries.data[i].deprecation)) { ret false; }
        i = i + 1;
    }
    if (!type_kind.same(type.tag_discriminator(s.types, node.ty), node.disc)) { ret false; }
    val dec: type_field.Decoration = type.decoration_of(s.types, node.ty);
    ret dec.align == node.decoration.align && dec.packed == node.decoration.packed && dec.volatile_ == node.decoration.volatile_;
}

# publishes each node of `graph` that the type table has no field table for, and holds every
# one it already has to the node's fields, discriminator and decorations. a graph installed
# under the current projection is not checked again
# ---
# s:     the session whose type table receives the tables
# graph: the graph to install
# ret:   ok, or a failure when a table disagrees with the graph or one cannot be published
pub fun install(s: *session.Session, graph: *Graph) err[fail.Fail] {
    # published tables only change through a projection reset, so a graph installed
    # under this projection verifies identically on every later acquisition
    val generation: u64 = s.types.projection_generation;
    if (graph.installed && graph.installed_generation == generation) { ret err[fail.Fail].ok{}; }
    var i: usize = 0;
    for (i < graph.nodes.len) {
        val node:         *Node                  = ?graph.nodes.data[i];
        val opt_existing: opt[*type_field.Table] = type.field_table_for(s.types, node.ty);
        if (sel opt_existing.some) {
            if (!same_fields(s, opt_existing.some, node)) {
                ret err[fail.Fail].err{fail.message("field projection disagrees with an acquired definition")};
            }
            i = i + 1;
            cnt;
        }
        if (node.entries.len > 0xFFFFFFFF::usize) { ret err[fail.Fail].err{fail.message("field projection exceeds the field count limit")}; }
        val res_staged: res[u32, fail.Fail] = type.field_table_stage(s.types, node.entries.len::u32);
        if (sel res_staged.err) { ret err[fail.Fail].err{res_staged.err}; }
        var j: usize = 0;
        for (j < node.entries.len) {
            val err_copied: err[fail.Fail] = type.field_table_stage_push_entry(s.types, node.entries.data[j]);
            if (sel err_copied.err) { ret err_copied; }
            j = j + 1;
        }
        if (!type_kind.is_nil(node.disc)) {
            val err_disc: err[fail.Fail] = type.set_tag_discriminator(s.types, node.ty, node.disc);
            if (sel err_disc.err) { ret err_disc; }
        }
        val dec: type_field.Decoration = node.decoration;
        if (dec.align != 0 || dec.packed || dec.volatile_) {
            val err_decorated: err[fail.Fail] = type.decoration_set(s.types, node.ty, dec);
            if (sel err_decorated.err) { ret err_decorated; }
        }
        val err_published: err[fail.Fail] = type.field_table_publish(s.types, node.ty,
            res_staged.ok, node.entries.len::u32);
        if (sel err_published.err) { ret err_published; }
        i = i + 1;
    }
    graph.installed            = true;
    graph.installed_generation = generation;
    ret err[fail.Fail].ok{};
}
