# the built-ins a `#[gpu.builtin]` names: the spir-v built-in each stands for, whether a stage
# writes it, and the type the pipeline binds it at, which type checking holds a declaration to
# and lowering spells the built-in by
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use mach.base.textbuild;
use mach.type;
use type_kind: mach.type.kind;

# one built-in
# ---
# name:   the name `#[gpu.builtin]` takes
# spirv:  the spir-v built-in it stands for, as masc's grammar spells it
# output: whether a stage writes it, where the pipeline supplies every other
# lanes:  the lanes of the type it is bound at, 1 for a scalar, each lane 32 bits wide
# float:  whether those lanes are floats; an integer one is either sign, since spir-v's
#         type is sign-less and the vulkan environment asks only for its width
pub rec Builtin {
    name:   str;
    spirv:  str;
    output: bool;
    lanes:  u32;
    float:  bool;
}

val COUNT: usize          = 14;
val ROWS:  [COUNT]Builtin = [COUNT]Builtin{
    Builtin{name: "position", spirv: "Position", output: true, lanes: 4, float: true},
    Builtin{name: "vertex_index", spirv: "VertexIndex", output: false, lanes: 1, float: false},
    Builtin{name: "instance_index", spirv: "InstanceIndex", output: false, lanes: 1, float: false},
    Builtin{name: "frag_coord", spirv: "FragCoord", output: false, lanes: 4, float: true},
    Builtin{name: "point_size", spirv: "PointSize", output: true, lanes: 1, float: true},
    Builtin{name: "global_invocation", spirv: "GlobalInvocationId", output: false, lanes: 3, float: false},
    Builtin{name: "local_invocation", spirv: "LocalInvocationId", output: false, lanes: 3, float: false},
    Builtin{name: "workgroup_id", spirv: "WorkgroupId", output: false, lanes: 3, float: false},
    Builtin{name: "num_workgroups", spirv: "NumWorkgroups", output: false, lanes: 3, float: false},
    Builtin{name: "local_invocation_index", spirv: "LocalInvocationIndex", output: false, lanes: 1, float: false},
    Builtin{name: "subgroup_size", spirv: "SubgroupSize", output: false, lanes: 1, float: false},
    Builtin{name: "subgroup_invocation", spirv: "SubgroupLocalInvocationId", output: false, lanes: 1, float: false},
    Builtin{name: "subgroup_id", spirv: "SubgroupId", output: false, lanes: 1, float: false},
    Builtin{name: "num_subgroups", spirv: "NumSubgroups", output: false, lanes: 1, float: false},
};

# the built-in `name` names
pub fun of(name: str) opt[*Builtin] {
    var i: usize = 0;
    for (i < COUNT) {
        if (str_equals(ROWS[i].name, name)) { ret opt[*Builtin].some{?ROWS[i]}; }
        i = i + 1;
    }
    ret opt[*Builtin].none{};
}

# every name `#[gpu.builtin]` takes, quoted, as `"position", ..., or "num_subgroups"`. a
# failed append is held by the builder
pub fun names_append(b: *textbuild.TextBuilder) {
    var i: usize = 0;
    for (i < COUNT) {
        if (i + 1 == COUNT) { textbuild.tb_append(b, ", or "); }
        or (i > 0)          { textbuild.tb_append(b, ", "); }
        textbuild.tb_append(b, "\"");
        textbuild.tb_append(b, ROWS[i].name);
        textbuild.tb_append(b, "\"");
        i = i + 1;
    }
}

# whether a 32-bit lane of kind `k` is one `b` is bound with
fun lane_is(b: *Builtin, k: type_kind.TypeKind) bool {
    if (b.float) { ret k == type_kind.TYPE_F32; }
    ret k == type_kind.TYPE_U32 || k == type_kind.TYPE_I32;
}

# whether `ty` is the type the pipeline binds `b` at
pub fun binds(ti: *type.TypeInterner, b: *Builtin, ty: type_kind.TypeId) bool {
    val opt_type: opt[*type.Type] = type.get(ti, type.strip_secret(ti, ty));
    if (sel opt_type.none) { ret false; }
    if (b.lanes == 1)      { ret lane_is(b, opt_type.some.kind); }
    ret type.is_vector(ti, ty) && type.vector_lanes(ti, ty) == b.lanes && lane_is(b, type.vector_element(ti, ty));
}

# the type the pipeline binds `b` at, as a diagnostic spells it
pub fun required(b: *Builtin) str {
    if (b.float && b.lanes == 4) { ret "`f32x4`"; }
    if (b.float)                 { ret "`f32`"; }
    if (b.lanes == 3)            { ret "`u32x3` or `i32x3`"; }
    ret "`u32` or `i32`";
}
