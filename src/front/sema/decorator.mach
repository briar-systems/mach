# checking each decorator against its declaration: its places, arguments and rule
use diagnostic_kind: mach.base.diagnostic.kind;
use mach.base.fail;
use mach.base.intern;
use base_source: mach.base.source;
use mach.base.stack;
use mach.base.textbuild;
use mach.front.ast;
use ast_decl: mach.front.ast.decl;
use ast_id:   mach.front.ast.id;
use ast_stmt: mach.front.ast.stmt;
use ast_type: mach.front.ast.type;
use mach.front.comptime;
use comptime_failure: mach.front.comptime.failure;
use comptime_value:   mach.front.comptime.value;
use mach.front.decorator;
use mach.front.expect;
use mach.front.resolve;
use mach.front.sema.abitype;
use sema_builtin:  mach.front.sema.builtin;
use sema_context:  mach.front.sema.context;
use sema_declared: mach.front.sema.declared;
use mach.front.sema.growth;
use sema_handle: mach.front.sema.handle;
use mach.front.sema.infer;
use mach.front.sema.typename;
use report_phase: mach.report.phase;
use mach.session.module;
use mach.type;
use type_kind:      mach.type.kind;
use type_prim:      mach.type.prim;
use masc_extension: masc.core.extension;
use masc_set:       masc.core.set;
use masc_isa:       masc.isa;
use A:              std.allocator;
use std.collections.map;
use std.text.string.str_dup_range;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.view.View;

pub fun infer_decorator_args(sc: *sema_context.SemaContext, d: *ast_decl.Decl) {
    var i: u32 = 0;
    for (i < d.decorators_len) {
        val dec: *ast_decl.Decorator = ?sc.view.a.decorators.data[d.decorators_start + i];
        var ii:  u32                 = 0;
        for (ii < dec.args_len && dec.id != decorator.NONE) {
            if (!sema_handle.arg_is_type(sc, dec, ii)) {
                infer.infer_expr(sc, sc.view.a.expr_ids.data[dec.args_start + ii]);
            }
            ii = ii + 1;
        }
        i = i + 1;
    }
}

pub fun validate_decorators(sc: *sema_context.SemaContext, d: *ast_decl.Decl) {
    val places: decorator.Places = decorator.places_of(d);
    var i:      u32              = 0;
    for (i < d.decorators_len) {
        val dec: *ast_decl.Decorator = ?sc.view.a.decorators.data[d.decorators_start + i];
        if (validate_decorator_row(sc, dec, places, d.decorators_start, i)) { validate_decorator_rule(sc, d, dec); }
        i = i + 1;
    }
    if (d.kind == ast_decl.DECL_KIND_TAG) { validate_case_decorators(sc, ?d.data.tag_); }
    if (d.kind == ast_decl.DECL_KIND_DEF) { validate_def_defined(sc, d); }
    if (states_definition(sc, d))         { validate_symbols_once(sc, d); }
}

# whether `d` defines one symbol of its own: an `ext` or bodyless declaration may name
# what another defines, and a template's instances are named apart
fun states_definition(sc: *sema_context.SemaContext, d: *ast_decl.Decl) bool {
    if ((d.flags & ast_decl.DECL_FLAG_EXT) != 0) { ret false; }
    if (d.kind == ast_decl.DECL_KIND_FUN)        { ret !ast_id.stmt_is_nil(d.data.fun_.body) && !growth.fun_is_template(sc.view.a, d); }
    ret d.kind == ast_decl.DECL_KIND_VAL || d.kind == ast_decl.DECL_KIND_VAR;
}

# one object holds one definition of a name, whichever of `symbol` and `weak` states it, so
# a default and its replacement stand in two modules. only the arms of a gate that are
# taken reach here, so two arms may each define the name
fun validate_symbols_once(sc: *sema_context.SemaContext, d: *ast_decl.Decl) {
    if (sc.typing.symbols == nil) { ret; }
    var i: u32 = 0;
    for (i < d.decorators_len) {
        val dec: *ast_decl.Decorator = ?sc.view.a.decorators.data[d.decorators_start + i];
        i = i + 1;
        if (dec.id != decorator.SYMBOL && dec.id != decorator.WEAK) { cnt; }
        val named: intern.StrId = decorator.string_id(sc.view.ctx, sc.view.a, dec, 0);
        if (intern.str_is_nil(named)) { cnt; }
        val key:       u32       = named::u32;
        val opt_prior: opt[*u64] = map.get[u32, u64](sc.typing.symbols, ?key);
        if (sel opt_prior.some) {
            if (@opt_prior.some != d.span.offset) {
                sema_context.reportf(sc, diagnostic_kind.NAME_DUPLICATE, dec.name, "symbol `{}` is defined twice in this module. a `weak` default and its replacement must be in different modules", intern.text(sc.s.interner, named));
            }
            cnt;
        }
        val res_noted: res[bool, A.Error] = map.insert[u32, u64](sc.typing.symbols, key, d.span.offset);
        if (sel res_noted.err) {
            sema_context.refuse(sc, dec.name, fail.refused(res_noted.err));
            ret;
        }
    }
}

# a `def` that states no type takes it from a decorator that supplies one, and is refused
# without one; its uses then see the error type and say nothing more
fun validate_def_defined(sc: *sema_context.SemaContext, d: *ast_decl.Decl) {
    if (!ast_id.type_is_nil(d.data.def_.ty))                               { ret; }
    if (decorator.count_flagged(sc.view.a, d, decorator.FLAG_DEFINES) > 0) { ret; }
    report_decorator_listing(sc, diagnostic_kind.DEF_NO_TYPE, d.span,
        "a `def` with no type names nothing. state the type it aliases, as in `def Name: T;`, or give it a decorator that defines it, ",
        decorator.FLAG_DEFINES, decorator.places_of(d), "or", "");
}

# a tag case's decorators answer to their rows alone: every rule a decorator adds
# shapes a symbol or a whole type
fun validate_case_decorators(sc: *sema_context.SemaContext, t: *ast_decl.DeclTag) {
    var i: u32 = 0;
    for (i < t.cases_len) {
        val c: *ast_decl.TagCase = ?sc.view.a.tag_cases.data[t.cases_start + i];
        var j: u32               = 0;
        for (j < c.decorators_len) {
            validate_decorator_row(sc, ?sc.view.a.decorators.data[c.decorators_start + j], decorator.PLACE_CASE, c.decorators_start, j);
            j = j + 1;
        }
        i = i + 1;
    }
}

# the refusal of a decorator a previous major named, nil for any other
fun refusal_of(sc: *sema_context.SemaContext, dec: *ast_decl.Decorator) str {
    val res_source: res[str, fail.Fail] = sema_context.source_text_of(sc.s, sc.view.a);
    if (sel res_source.err) { ret nil; }
    ret decorator.refusal_of(res_source.ok, dec.name, dec.args_len);
}

# holds `dec` to its registry row: the count and kind of its arguments, whether it
# stands somewhere in `places`, and whether it repeats among the `index` decorators
# before it from `start`. true when it stands where its row admits it, once
fun validate_decorator_row(sc: *sema_context.SemaContext, dec: *ast_decl.Decorator, places: decorator.Places, start: u32, index: u32) bool {
    val row: *decorator.Row = decorator.row(dec.id);
    if (row == nil) {
        val refusal: str = refusal_of(sc, dec);
        if (refusal != nil) { sema_context.report(sc, diagnostic_kind.DECORATOR_UNKNOWN, dec.name, refusal); }
        or                  { report_decorator_listing(sc, diagnostic_kind.DECORATOR_UNKNOWN, dec.name, "unknown decorator. the decorators are ", 0, decorator.PLACES_ANY, nil, ""); }
        ret false;
    }
    if (dec.args_len < row.args_min || dec.args_len > row.args_max) { sema_context.report(sc, diagnostic_kind.DECORATOR_ARITY, dec.name, row.arity); }
    or                                                              { validate_decorator_args(sc, dec, row); }
    # a decorator that refuses its own misplacement still refuses a tag case here
    val self_placed: bool = (row.flags & decorator.FLAG_PLACE_CHECKED) != 0 && places != decorator.PLACE_CASE;
    if ((row.places & places) == 0 && !self_placed) {
        if (places == decorator.PLACE_CASE) {
            report_decorator_listing(sc, diagnostic_kind.DECORATOR_MISPLACED, dec.name, "a tag case takes only the ", 0, decorator.PLACE_CASE, "or", " decorator");
        }
        or { sema_context.report(sc, diagnostic_kind.DECORATOR_MISPLACED, dec.name, row.misplaced); }
        ret false;
    }
    if (decorator.list_has(sc.view.a, start, index, dec.id)) {
        sema_context.report(sc, diagnostic_kind.DECORATOR_DUPLICATE, dec.name, row.duplicate);
        ret false;
    }
    ret true;
}

# the extension argument `ord` of `dec` names
fun extension_at(sc: *sema_context.SemaContext, dec: *ast_decl.Decorator, ord: u32) opt[View] {
    val opt_string_of: opt[str] = decorator.string_of(sc.s.interner, sc.view.ctx, sc.view.a, dec, ord);
    if (sel opt_string_of.none) { ret opt[View].none{}; }
    ret opt[View].some{View{data: opt_string_of.some, len: str_len(opt_string_of.some)}};
}

# the arguments its row checks: each string it records where the row checks them,
# and each integer, stopping at the first that is not one
fun validate_decorator_args(sc: *sema_context.SemaContext, dec: *ast_decl.Decorator, row: *decorator.Row) {
    var ord: u32 = 0;
    for (ord < dec.args_len) {
        if ((row.flags & decorator.FLAG_STRINGS_CHECKED) != 0 && decorator.takes_string(dec, ord)) {
            val opt_decorator_string_arg: opt[str] = sema_context.decorator_string_arg(sc, dec, ord, diagnostic_kind.DECORATOR_ARGUMENT, row.argument);
            if (sel opt_decorator_string_arg.some) {
                if (ord == 0 && row.modes != nil && !decorator.mode_admits(row.modes, opt_decorator_string_arg.some)) {
                    sema_context.report(sc, diagnostic_kind.DECORATOR_ARGUMENT, expect.arg_span(sc.view.a, sc.view.a.expr_ids.data[dec.args_start], dec.name), row.argument);
                }
            }
        }
        ord = ord + 1;
    }
    ord = 0;
    for (ord < dec.args_len && ord < 32) {
        if (((row.integers >> ord) & 1) != 0 && !require_integer_arg(sc, dec, ord, row.argument)) { brk; }
        if (((row.words >> ord) & 1) != 0)                                                        { require_word_arg(sc, dec, ord); }
        ord = ord + 1;
    }
}

# an integer argument its row holds to an unsigned 32-bit value, the one literal word its
# target states it in; a value that is no constant is refused as one already
fun require_word_arg(sc: *sema_context.SemaContext, dec: *ast_decl.Decorator, ord: u32) {
    val eid:          ast_id.ExprId                                          = sc.view.a.expr_ids.data[dec.args_start + ord];
    val res_evaluate: res[comptime_value.CTValue, comptime_failure.EvalFail] = comptime.evaluate[sema_context.SemaContext](sc.view.ctx, sc, sc.typing.caps, sc.view.a, sc.view.source, eid, sc.s.interner);
    if (sel res_evaluate.err) { ret; }
    val opt_word: opt[u64] = comptime_value.ct_int_u64(res_evaluate.ok);
    if (sel opt_word.some && opt_word.some <= 0xFFFF_FFFF) { ret; }
    sema_context.reportf(sc, diagnostic_kind.DECORATOR_ARGUMENT, sema_context.decorator_arg_span(sc, eid, dec.name),
        "`{}` takes this argument as an unsigned 32-bit integer", decorator.name_of(dec.id));
}

# reports `prefix`, the names of the rows carrying `flags` that stand in `places`
# as `decorator.names_append` lists them, then `suffix`
fun report_decorator_listing(sc: *sema_context.SemaContext, k: diagnostic_kind.Kind, at: base_source.Span, prefix: str,
    flags: decorator.Flags, places: decorator.Places, conjunction: str, suffix: str) {
    var b: textbuild.TextBuilder = textbuild.tb_init(sc.s.alloc);
    fin { textbuild.tb_dnit(?b); }
    val err_head: err[textbuild.Error] = textbuild.tb_append(?b, prefix);
    var failed:   bool                 = sel err_head.err;
    if (!failed) {
        val err_names: err[textbuild.Error] = decorator.names_append(?b, flags, places, conjunction);
        failed = sel err_names.err;
    }
    if (!failed) {
        val err_tail: err[textbuild.Error] = textbuild.tb_append(?b, suffix);
        failed = sel err_tail.err;
    }
    if (failed) {
        report_phase.internal(?sc.status, fail.message("a decorator listing could not be built"));
        ret;
    }
    val res_text: res[str, textbuild.Error] = textbuild.tb_finish(?b);
    if (sel res_text.err) {
        report_phase.internal(?sc.status, fail.message(textbuild.text(res_text.err)));
        ret;
    }
    sema_context.report(sc, k, at, res_text.ok);
    str_free(sc.s.alloc, res_text.ok);
}

# an integer argument: of an integer type and a constant expression
fun require_integer_arg(sc: *sema_context.SemaContext, dec: *ast_decl.Decorator, ord: u32, kind_msg: str) bool {
    val eid: ast_id.ExprId = sc.view.a.expr_ids.data[dec.args_start + ord];
    if (!type.is_integer(sc.s.types, decorator_arg_type(sc, eid))) {
        sema_context.report(sc, diagnostic_kind.DECORATOR_ARGUMENT, dec.name, kind_msg);
        ret false;
    }
    sema_context.require_constant_arg(sc, dec, ord);
    ret true;
}

# whether `tid` is a 32-bit integer, the width a workgroup size is stated in
fun is_word_integer(sc: *sema_context.SemaContext, tid: type_kind.TypeId) bool {
    if (!type.is_integer(sc.s.types, tid)) { ret false; }
    val opt_type: opt[*type.Type] = type.get(sc.s.types, type.strip_secret(sc.s.types, tid));
    if (sel opt_type.none) { ret false; }
    ret type_prim.prim_desc(opt_type.some.kind).bits == 32;
}

# a workgroup dimension is an integer constant or names a `#[gpu.spec]` var, whose value the
# host supplies at pipeline creation. a var another module declares is held to that by
# the back end, which sees its role
fun validate_workgroup_dim(sc: *sema_context.SemaContext, dec: *ast_decl.Decorator, ord: u32) bool {
    val eid:     ast_id.ExprId        = sc.view.a.expr_ids.data[dec.args_start + ord];
    val opt_sym: opt[*resolve.Symbol] = sema_context.symbol_for_expr(sc, eid);
    if (sel opt_sym.some) {
        val sym:    *resolve.Symbol = opt_sym.some;
        val own:    bool            = sym.kind == resolve.SYM_VAR;
        val import: bool            = sym.kind == resolve.SYM_IMPORTED && sym.definition_kind == resolve.SYM_VAR;
        if (own || import) {
            if (!is_word_integer(sc, decorator_arg_type(sc, eid))) {
                sema_context.report(sc, diagnostic_kind.DECORATOR_ARGUMENT, sema_context.decorator_arg_span(sc, eid, dec.name), "a `gpu.workgroup` dimension named by a `#[gpu.spec]` var must be a `u32` or an `i32`");
                ret false;
            }
            if (own && !sema_context.foreign(sc, sym)) {
                val opt_d: opt[*ast_decl.Decl] = ast.get_decl(sc.view.a, sym.decl);
                if (sel opt_d.some && !decorator.has(sc.view.a, opt_d.some, decorator.GPU_SPEC)) {
                    sema_context.report(sc, diagnostic_kind.DECORATOR_NOT_CONSTANT, sema_context.decorator_arg_span(sc, eid, dec.name), "a `gpu.workgroup` dimension that is not a constant must name a `#[gpu.spec(id)]` var, whose value the host supplies when it creates the pipeline");
                    ret false;
                }
            }
            ret true;
        }
    }
    ret require_integer_arg(sc, dec, ord, "`gpu.workgroup` decorator dimensions must be integer comptime expressions or `#[gpu.spec]` vars");
}

# a shader interface binding carries one role, and its initializer follows that role
fun validate_iface_role(sc: *sema_context.SemaContext, d: *ast_decl.Decl, dec: *ast_decl.Decorator) {
    if (decorator.count_flagged(sc.view.a, d, decorator.FLAG_ROLE) > 1) {
        report_decorator_listing(sc, diagnostic_kind.DECORATOR_CONFLICT, dec.name, "a shader interface variable has exactly one role, so ",
            decorator.FLAG_ROLE, decorator.PLACES_ANY, "and", " are mutually exclusive");
    }
    validate_iface_init(sc, d, dec);
    if (dec.id == decorator.GPU_BUILTIN) { validate_builtin(sc, d, dec); }
}

# a built-in is a row of the built-in table, and the pipeline binds it at the one type its
# row states, so a declaration at any other is a module the pipeline cannot bind
fun validate_builtin(sc: *sema_context.SemaContext, d: *ast_decl.Decl, dec: *ast_decl.Decorator) {
    if (dec.args_len != 1) { ret; }
    val opt_named: opt[str] = decorator.string_of(sc.s.interner, sc.view.ctx, sc.view.a, dec, 0);
    if (sel opt_named.none) { ret; }
    val opt_row: opt[*sema_builtin.Builtin] = sema_builtin.of(opt_named.some);
    if (sel opt_row.none) {
        report_unknown_builtin(sc, dec);
        ret;
    }
    val declared: type_kind.TypeId = sema_context.resolved_type_of(sc, d.data.bind.ty);
    if (type_kind.is_nil(declared) || type_kind.is_error(declared)) { ret; }
    if (sema_builtin.binds(sc.s.types, opt_row.some, declared))     { ret; }
    var at:       base_source.Span    = dec.name;
    val opt_node: opt[*ast_type.Type] = ast.get_type(sc.view.a, d.data.bind.ty);
    if (sel opt_node.some) { at = opt_node.some.span; }
    val res_spelled: res[str, fail.Fail] = typename.type_to_str(sc.s, declared);
    if (sel res_spelled.err) {
        sema_context.refuse(sc, at, res_spelled.err);
        ret;
    }
    fin { typename.type_str_free(sc.s, res_spelled.ok); }
    sema_context.reportf(sc, diagnostic_kind.SPIRV_INTERFACE, at,
        "a `#[gpu.builtin(\"{}\")]` variable must have the built-in's type. it is declared `{}`, and the pipeline binds it as {}",
        opt_row.some.name, res_spelled.ok, sema_builtin.required(opt_row.some));
}

fun report_unknown_builtin(sc: *sema_context.SemaContext, dec: *ast_decl.Decorator) {
    var b: textbuild.TextBuilder = textbuild.tb_init(sc.s.alloc);
    fin { textbuild.tb_dnit(?b); }
    textbuild.tb_append(?b, "unknown built-in. `gpu.builtin` takes ");
    sema_builtin.names_append(?b);
    val res_text: res[str, textbuild.Error] = textbuild.tb_finish(?b);
    if (sel res_text.err) {
        report_phase.internal(?sc.status, fail.message(textbuild.text(res_text.err)));
        ret;
    }
    fin { str_free(sc.s.alloc, res_text.ok); }
    sema_context.report(sc, diagnostic_kind.DECORATOR_ARGUMENT, expect.arg_span(sc.view.a, sc.view.a.expr_ids.data[dec.args_start], dec.name), res_text.ok);
}

# the one rule for an initializer on an interface binding, per role: a `#[gpu.spec]` var's is
# the default it requires, an output's is the value it starts at, and every other role's
# value is supplied by the host, the pipeline or the stage, so an initializer is refused
fun validate_iface_init(sc: *sema_context.SemaContext, d: *ast_decl.Decl, dec: *ast_decl.Decorator) {
    val has: bool = !ast_id.expr_is_nil(d.data.bind.init);
    if (dec.id == decorator.GPU_SPEC) {
        if (!has) {
            sema_context.report(sc, diagnostic_kind.DECORATOR_REQUIRES, dec.name, "a `#[gpu.spec(id)]` var needs an initializer, the default the pipeline keeps when the host supplies no value");
        }
        ret;
    }
    if (!has) { ret; }
    var why: str = nil;
    if (dec.id == decorator.GPU_INPUT) {
        why = "a `#[gpu.input]` variable cannot have an initializer, because the previous stage or the vertex input supplies its value";
    }
    or (dec.id == decorator.GPU_BUILTIN && !builtin_is_output(sc, dec)) {
        why = "an input `#[gpu.builtin]` cannot have an initializer, because the pipeline supplies its value";
    }
    or (dec.id == decorator.GPU_UNIFORM || dec.id == decorator.GPU_STORAGE || dec.id == decorator.GPU_SAMPLER) {
        why = "a `#[gpu.uniform]`, `#[gpu.storage]` or `#[gpu.sampler]` variable cannot have an initializer, because the host binds its memory";
    }
    or (dec.id == decorator.GPU_PUSH) {
        why = "a `#[gpu.push]` block cannot have an initializer, because the host supplies it";
    }
    or (dec.id == decorator.GPU_SHARED) {
        why = "a `#[gpu.shared]` variable cannot have an initializer, because workgroup memory starts at zero. assign it inside the stage";
    }
    if (why != nil) { sema_context.report(sc, diagnostic_kind.DECORATOR_CONFLICT, dec.name, why); }
}

# the built-ins a stage writes rather than reads; an unknown or unreadable one is left to
# the built-in check
fun builtin_is_output(sc: *sema_context.SemaContext, dec: *ast_decl.Decorator) bool {
    if (dec.args_len != 1) { ret true; }
    val opt_string_of: opt[str] = decorator.string_of(sc.s.interner, sc.view.ctx, sc.view.a, dec, 0);
    if (sel opt_string_of.none) { ret true; }
    val opt_row: opt[*sema_builtin.Builtin] = sema_builtin.of(opt_string_of.some);
    if (sel opt_row.none) { ret true; }
    ret opt_row.some.output;
}

fun validate_storage_quals(sc: *sema_context.SemaContext, dec: *ast_decl.Decorator) {
    var readonly:  bool = false;
    var writeonly: bool = false;
    var i:         u32  = 2;
    for (i < dec.args_len) {
        val opt_qual: opt[str] = sema_context.decorator_string_arg(sc, dec, i, diagnostic_kind.DECORATOR_ARGUMENT,
            "a `gpu.storage` memory qualifier must be a string, as in `#[gpu.storage(0, 3, \"readonly\")]`");
        if (sel opt_qual.none) {
            i = i + 1;
            cnt;
        }
        val at: base_source.Span = expect.arg_span(sc.view.a, sc.view.a.expr_ids.data[dec.args_start + i], dec.name);
        if (str_equals(opt_qual.some, "readonly"))  { readonly = true; }
        or (str_equals(opt_qual.some, "writeonly")) { writeonly = true; }
        or (!str_equals(opt_qual.some, "coherent")) {
            sema_context.report(sc, diagnostic_kind.DECORATOR_ARGUMENT, at,
                "unknown `gpu.storage` memory qualifier. it takes \"readonly\", \"writeonly\" or \"coherent\"");
        }
        if (readonly && writeonly) {
            sema_context.report(sc, diagnostic_kind.DECORATOR_ARGUMENT, at,
                "`\"readonly\"` and `\"writeonly\"` together declare a binding no stage reads or writes. keep the one that says how the binding is used");
            readonly  = false;
            writeonly = false;
        }
        i = i + 1;
    }
}

fun decorator_arg_type(sc: *sema_context.SemaContext, eid: ast_id.ExprId) type_kind.TypeId {
    if (ast_id.expr_is_nil(eid))                              { ret type_kind.TYPE_ERROR; }
    if (ast_id.expr_index(eid)::usize >= sc.view.a.exprs.len) { ret type_kind.TYPE_ERROR; }
    ret sc.view.expr_type[ast_id.expr_index(eid)];
}

# a specialization constant is a scalar integer or float, the one kind of value OpSpecConstant states
fun validate_spec_type(sc: *sema_context.SemaContext, d: *ast_decl.Decl, dec: *ast_decl.Decorator) {
    val declared: type_kind.TypeId = sema_context.resolved_type_of(sc, d.data.bind.ty);
    if (type_kind.is_nil(declared) || type_kind.is_error(declared))                   { ret; }
    if (type.is_integer(sc.s.types, declared) || type.is_float(sc.s.types, declared)) { ret; }
    sema_context.report(sc, diagnostic_kind.DECORATOR_MISPLACED, dec.name, "a `#[gpu.spec(id)]` var must be a scalar integer or float, because a specialization constant is one scalar");
}

# the rule a decorator adds to its row, keyed by its id; a decorator its row holds
# entirely adds none
fun validate_decorator_rule(sc: *sema_context.SemaContext, d: *ast_decl.Decl, dec: *ast_decl.Decorator) {
    val id: decorator.Id = dec.id;
    if (id == decorator.GPU_SPEC && d.kind == ast_decl.DECL_KIND_VAL) {
        sema_context.report(sc, diagnostic_kind.DECORATOR_MISPLACED, dec.name, "`gpu.spec` applies only to a module-level `var`, because the host supplies its value when it creates the pipeline");
        ret;
    }
    if (id == decorator.GPU_SPEC) { validate_spec_type(sc, d, dec); }
    if (id == decorator.GPU_SHARED && d.kind == ast_decl.DECL_KIND_VAL) {
        sema_context.report(sc, diagnostic_kind.DECORATOR_MISPLACED, dec.name, "`#[gpu.shared]` applies only to a `var`, because the stage writes workgroup memory");
        ret;
    }
    if (decorator.flagged(id, decorator.FLAG_ROLE)) { validate_iface_role(sc, d, dec); }
    if (id == decorator.TESTING)                    { validate_testing(sc, d, dec); }
    or (id == decorator.EXPECT)                     { validate_expect(sc, dec); }
    or (id == decorator.ALIGN)                      { validate_align(sc, d, dec); }
    or (id == decorator.GPU_WORKGROUP)              { validate_workgroup(sc, d, dec); }
    or (id == decorator.GPU_STORAGE)                { validate_storage_quals(sc, dec); }
    or (id == decorator.NAKED)                      { validate_naked(sc, d, dec); }
    or (id == decorator.EXTENSION)                  { validate_extensions(sc, d, dec); }
    or (id == decorator.EXPORT)                     { validate_export(sc, d, dec); }
    or (id == decorator.THREAD)                     { validate_thread(sc, d, dec); }
    or (id == decorator.AT)                         { validate_at(sc, d, dec); }
    or (id == decorator.WEAK)                       { validate_weak(sc, d, dec); }
    or (id == decorator.CONSTANT_TIME)              { validate_constant_time(sc, d, dec); }
    or (id == decorator.HANDLE)                     { sema_handle.validate(sc, d, dec); }
    or (id == decorator.ABI_TYPE)                   { abitype.validate(sc, d, dec); }
}

# an `align` on a function or a global is decided here; a type's is decided with its layout
fun validate_align(sc: *sema_context.SemaContext, d: *ast_decl.Decl, dec: *ast_decl.Decorator) {
    if (dec.args_len == 1 && sema_context.is_fun_or_global(d.kind)) { sema_declared.declared_align(sc, d); }
}

# a workgroup sizes a compute stage, each dimension an integer or a `#[gpu.spec]` var
fun validate_workgroup(sc: *sema_context.SemaContext, d: *ast_decl.Decl, dec: *ast_decl.Decorator) {
    var wi: u32 = 0;
    for (dec.args_len == 3 && wi < 3) {
        if (!validate_workgroup_dim(sc, dec, wi)) { brk; }
        wi = wi + 1;
    }
    val opt_stage: opt[*ast_decl.Decorator] = decorator.get(sc.view.a, d, decorator.GPU_STAGE);
    if (sel opt_stage.none) {
        sema_context.report(sc, diagnostic_kind.DECORATOR_REQUIRES, dec.name, "`gpu.workgroup` needs `#[gpu.stage(\"compute\")]` on the same function");
        ret;
    }
    val opt_model: opt[str] = decorator.string_of(sc.s.interner, sc.view.ctx, sc.view.a, opt_stage.some, 0);
    if (sel opt_model.some && !str_equals(opt_model.some, "compute")) {
        sema_context.report(sc, diagnostic_kind.DECORATOR_REQUIRES, dec.name, "`gpu.workgroup` applies only to a `#[gpu.stage(\"compute\")]` function, the only stage with a workgroup");
    }
}

# `#[testing]` confines references to test code, which neither an `ext` declaration
# nor a decorator naming a consumer outside Mach source lets it follow
fun validate_testing(sc: *sema_context.SemaContext, d: *ast_decl.Decl, dec: *ast_decl.Decorator) {
    if ((d.flags & ast_decl.DECL_FLAG_EXT) != 0) {
        sema_context.report(sc, diagnostic_kind.DECORATOR_MISPLACED, dec.name, "`testing` cannot apply to an `ext` declaration, because its definition and callers are outside Mach source");
    }
    var i: u32 = 0;
    for (i < d.decorators_len) {
        val other: *ast_decl.Decorator = ?sc.view.a.decorators.data[d.decorators_start + i];
        i = i + 1;
        if (!decorator.flagged(other.id, decorator.FLAG_TESTING_EXCLUSIVE)) { cnt; }
        sema_context.reportf(sc, diagnostic_kind.DECORATOR_CONFLICT, dec.name,
            "`testing` cannot combine with `{}`, because that names a consumer outside Mach source", decorator.name_of(other.id));
    }
}

# `#[expect("<key>", ...)]`: each argument names a warning key or family, as a
# string named once. an unknown key is refused, and so is one that covers only
# errors, since an error is never acknowledged
fun validate_expect(sc: *sema_context.SemaContext, dec: *ast_decl.Decorator) {
    var i: u32 = 0;
    for (i < dec.args_len) {
        val eid:     ast_id.ExprId = sc.view.a.expr_ids.data[dec.args_start + i];
        val opt_key: opt[str]      = sema_context.decorator_string_arg(sc, dec, i, diagnostic_kind.DECORATOR_ARGUMENT, "`expect` key must be a string");
        if (sel opt_key.some) {
            val at:     base_source.Span          = expect.arg_span(sc.view.a, eid, dec.name);
            var picked: diagnostic_kind.Selection = diagnostic_kind.select(opt_key.some);
            var dup:    bool                      = false;
            var j:      u32                       = 0;
            for (!dup && j < i) {
                val opt_prior: opt[str] = expect.key_of(sc.s, sc.view.ctx, sc.view.a.expr_ids.data[dec.args_start + j]);
                if (sel opt_prior.some && str_equals(opt_prior.some, opt_key.some)) { dup = true; }
                j = j + 1;
            }
            if (diagnostic_kind.selection_unknown(?picked)) {
                sema_context.reportf(sc, diagnostic_kind.EXPECT_UNKNOWN_KEY, at,
                    "`{}` is not a warning key. `expect` names a key or a family of keys, such as `vector.scalarize` or `vector`", opt_key.some);
            }
            or (diagnostic_kind.selection_is_empty(?picked)) {
                sema_context.reportf(sc, diagnostic_kind.EXPECT_ERROR_KEY, at, "`{}` names an error, and an error is never acknowledged", opt_key.some);
            }
            or (dup) {
                sema_context.reportf(sc, diagnostic_kind.EXPECT_DUPLICATE_KEY, at, "`expect` names `{}` twice", opt_key.some);
            }
        }
        i = i + 1;
    }
}

# `#[extension("name", ...)]`: a function whose body may use extensions the target
# does not select. each argument is a string naming an extension of masc's catalog
# for some instruction set, listed once; the caller's run-time check is its own
# contract, never enforced
fun validate_extensions(sc: *sema_context.SemaContext, d: *ast_decl.Decl, dec: *ast_decl.Decorator) {
    if (ast_id.stmt_is_nil(d.data.fun_.body) || (d.flags & ast_decl.DECL_FLAG_EXT) != 0) {
        sema_context.report(sc, diagnostic_kind.DECORATOR_MISPLACED, dec.name, "`extension` applies only to a function with a body");
        ret;
    }
    var i: u32 = 0;
    for (i < dec.args_len) {
        val opt_name: opt[View] = extension_at(sc, dec, i);
        if (sel opt_name.none) { ret; }
        val at: base_source.Span = expect.arg_span(sc.view.a, sc.view.a.expr_ids.data[dec.args_start + i], dec.name);
        var j:  u32              = 0;
        for (j < i) {
            val opt_prior: opt[View] = extension_at(sc, dec, j);
            if (sel opt_prior.some && same_text(opt_prior.some, opt_name.some)) {
                sema_context.report(sc, diagnostic_kind.EXTENSION_DUPLICATE, at, "`extension` names this extension twice");
                ret;
            }
            j = j + 1;
        }
        val named: Named = masc_names(opt_name.some);
        if (!named.found) {
            report_unknown_extension(sc, at, opt_name.some);
            ret;
        }
        if (!named.selectable) {
            report_target_only(sc, at, opt_name.some, named.target_only);
            ret;
        }
        i = i + 1;
    }
}

# `#[export]` names the declaration in a shared library's export table, which only a
# `pub` declaration may reach: `pub` alone exports nothing
fun validate_export(sc: *sema_context.SemaContext, d: *ast_decl.Decl, dec: *ast_decl.Decorator) {
    if ((d.flags & ast_decl.DECL_FLAG_PUB) == 0) {
        sema_context.report(sc, diagnostic_kind.DECORATOR_REQUIRES, dec.name, "`export` needs `pub`, because a library exports only its public interface");
    }
    if ((d.flags & ast_decl.DECL_FLAG_EXT) != 0) {
        sema_context.report(sc, diagnostic_kind.DECORATOR_MISPLACED, dec.name, "`export` cannot apply to an `ext` declaration, because another image defines it");
    }
}

# `#[thread]` gives each thread its own copy of a module `var`, laid out from its
# initializer as the thread-local template; no shader stage has threads of that kind
fun validate_thread(sc: *sema_context.SemaContext, d: *ast_decl.Decl, dec: *ast_decl.Decorator) {
    if (decorator.count_flagged(sc.view.a, d, decorator.FLAG_ROLE) > 0) {
        sema_context.report(sc, diagnostic_kind.DECORATOR_CONFLICT, dec.name, "`thread` cannot combine with a shader interface role, because a shader invocation has no thread-local storage");
    }
}

# `#[at(offset)]` places a module global at an offset in the image: it lowers to a section
# of its own, which the link places, so it names no section and holds no thread's copy.
# a mapped format is refused by mink, which places the section
fun validate_at(sc: *sema_context.SemaContext, d: *ast_decl.Decl, dec: *ast_decl.Decorator) {
    if ((d.flags & ast_decl.DECL_FLAG_EXT) != 0) {
        sema_context.report(sc, diagnostic_kind.DECORATOR_MISPLACED, dec.name, "`at` cannot apply to an `ext` declaration, because another image defines it");
    }
    if (decorator.has(sc.view.a, d, decorator.SECTION)) {
        sema_context.report(sc, diagnostic_kind.DECORATOR_CONFLICT, dec.name, "`at` cannot combine with `section`, because a placed global is a section of its own");
    }
    if (decorator.has(sc.view.a, d, decorator.THREAD)) {
        sema_context.report(sc, diagnostic_kind.DECORATOR_CONFLICT, dec.name, "`at` cannot combine with `thread`, because each thread's copy has its own address");
    }
}

# `#[constant_time(mode)]` is a promise this build keeps by walking the code it compiles, which an `ext` declaration
# or a function with no body leaves to another build
fun validate_constant_time(sc: *sema_context.SemaContext, d: *ast_decl.Decl, dec: *ast_decl.Decorator) {
    if ((d.flags & ast_decl.DECL_FLAG_EXT) != 0 || ast_id.stmt_is_nil(d.data.fun_.body)) {
        sema_context.report(sc, diagnostic_kind.DECORATOR_MISPLACED, dec.name, "`constant_time` applies only to a function with a body, because the build checks the code it compiles and an `ext` function's code is compiled elsewhere");
    }
}

# `#[weak("sym")]` defines `sym` as a link-time default: a definition with one symbol, which
# another definition of the name replaces, so no caller may take its body for the one that runs
fun validate_weak(sc: *sema_context.SemaContext, d: *ast_decl.Decl, dec: *ast_decl.Decorator) {
    if (dec.args_len == 1) {
        val opt_named: opt[str] = decorator.string_of(sc.s.interner, sc.view.ctx, sc.view.a, dec, 0);
        if (sel opt_named.some && str_len(opt_named.some) == 0) {
            sema_context.report(sc, diagnostic_kind.DECORATOR_ARGUMENT, expect.arg_span(sc.view.a, sc.view.a.expr_ids.data[dec.args_start], dec.name), "`weak` names the symbol it defines, which an empty string does not");
        }
    }
    if (decorator.has(sc.view.a, d, decorator.SYMBOL)) {
        sema_context.report(sc, diagnostic_kind.DECORATOR_CONFLICT, dec.name, "`weak` cannot combine with `symbol`. `weak` names the symbol itself, and `symbol` on another definition replaces it");
    }
    if ((d.flags & ast_decl.DECL_FLAG_EXT) != 0 || ast_id.stmt_is_nil(d.data.fun_.body)) {
        sema_context.report(sc, diagnostic_kind.DECORATOR_MISPLACED, dec.name, "`weak` applies only to a function with a body, because it marks a default definition");
        ret;
    }
    if (growth.fun_is_template(sc.view.a, d)) {
        sema_context.report(sc, diagnostic_kind.DECORATOR_MISPLACED, dec.name, "`weak` cannot apply to a generic, comptime-parameter or pack function, because its instances have no one symbol");
    }
    val opt_inlined: opt[*ast_decl.Decorator] = decorator.get(sc.view.a, d, decorator.INLINE);
    if (sel opt_inlined.some) {
        val opt_mode: opt[str] = decorator.string_of(sc.s.interner, sc.view.ctx, sc.view.a, opt_inlined.some, 0);
        if (sel opt_mode.some && str_equals(opt_mode.some, "always")) {
            sema_context.report(sc, diagnostic_kind.DECORATOR_CONFLICT, dec.name, "`weak` and `inline(\"always\")` cannot be combined, because the link may replace a weak function's body");
        }
    }
}

# what masc's catalogs make of an extension name
# ---
# found:       some catalog names it
# selectable:  some catalog names it with a row a function may select alone
# target_only: why the rows a catalog names it by are only a whole target's, where none is selectable
rec Named {
    found:       bool;
    selectable:  bool;
    target_only: str;
}

# what the catalogs masc serves make of `name`
fun masc_names(name: View) Named {
    var named: Named = Named{found: false, selectable: false, target_only: nil};
    var i:     u32   = 0;
    for (i < masc_isa.REGISTRY.count) {
        val set: *masc_set.Set = masc_isa.REGISTRY.sets[i];
        i = i + 1;
        if (set.extensions == nil) { cnt; }
        val opt_found: opt[*masc_extension.NameEntry] = masc_extension.entry(set.extensions, name, false);
        if (sel opt_found.none) { cnt; }
        named.found = true;
        val why: str = target_only_of(set.extensions, opt_found.some);
        if (why == nil) { named.selectable = true; }
        or              { named.target_only = why; }
    }
    ret named;
}

# why the rows `e` names are only a whole target's, the first such row's, nil when a function may select any of them
fun target_only_of(catalog: *masc_extension.Catalog, e: *masc_extension.NameEntry) str {
    if (e.rows.len == 0) { ret nil; }
    var k: u32 = 0;
    for (k < e.rows.len) {
        val row: u32 = e.rows.at[k];
        k = k + 1;
        if (row >= catalog.count || catalog.extensions[row].target_only == nil) { ret nil; }
    }
    ret catalog.extensions[e.rows.at[0]].target_only;
}

fun same_text(a: View, b: View) bool {
    if (a.len != b.len) { ret false; }
    var i: usize = 0;
    for (i < a.len) {
        if (a.data[i] != b.data[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun report_unknown_extension(sc: *sema_context.SemaContext, at: base_source.Span, name: View) {
    val res_copied: res[str, A.Error] = str_dup_range(sc.s.alloc, name.data::str, 0, name.len);
    if (sel res_copied.err) {
        report_phase.internal(?sc.status, fail.refused(res_copied.err));
        ret;
    }
    fin { str_free(sc.s.alloc, res_copied.ok); }
    var b: textbuild.TextBuilder = textbuild.tb_init(sc.s.alloc);
    fin { textbuild.tb_dnit(?b); }
    catalogs_append(?b);
    val res_listed: res[str, textbuild.Error] = textbuild.tb_finish(?b);
    if (sel res_listed.err) {
        report_phase.internal(?sc.status, fail.message(textbuild.text(res_listed.err)));
        ret;
    }
    fin { str_free(sc.s.alloc, res_listed.ok); }
    sema_context.reportf(sc, diagnostic_kind.EXTENSION_UNKNOWN, at, "`extension` names `{}`, which no extension catalog of this target holds. the catalogs are masc's {}, which also name what the manifest's `ext` takes", res_copied.ok, res_listed.ok);
}

# the instruction-set family of each catalog masc serves, as `riscv, x86 and spirv`; a failed
# append is held by the builder
fun catalogs_append(b: *textbuild.TextBuilder) {
    var count: u32 = 0;
    var i:     u32 = 0;
    for (i < masc_isa.REGISTRY.count) {
        if (masc_isa.REGISTRY.sets[i].extensions != nil) { count = count + 1; }
        i = i + 1;
    }
    var n: u32 = 0;
    i = 0;
    for (i < masc_isa.REGISTRY.count) {
        val set: *masc_set.Set = masc_isa.REGISTRY.sets[i];
        i = i + 1;
        if (set.extensions == nil)   { cnt; }
        if (n > 0 && n + 1 == count) { textbuild.tb_append(b, " and "); }
        or (n > 0)                   { textbuild.tb_append(b, ", "); }
        textbuild.tb_append(b, set.arches.at[0].arch.family.name);
        n = n + 1;
    }
}

fun report_target_only(sc: *sema_context.SemaContext, at: base_source.Span, name: View, why: str) {
    val res_copied: res[str, A.Error] = str_dup_range(sc.s.alloc, name.data::str, 0, name.len);
    if (sel res_copied.err) {
        report_phase.internal(?sc.status, fail.refused(res_copied.err));
        ret;
    }
    fin { str_free(sc.s.alloc, res_copied.ok); }
    sema_context.reportf(sc, diagnostic_kind.EXTENSION_TARGET_ONLY, at, "`extension` cannot name `{}`, because only a target's `ext` selects it. {}", res_copied.ok, why);
}

fun validate_naked(sc: *sema_context.SemaContext, d: *ast_decl.Decl, dec: *ast_decl.Decorator) {
    val opt_inlined: opt[*ast_decl.Decorator] = decorator.get(sc.view.a, d, decorator.INLINE);
    if (sel opt_inlined.some) {
        val opt_mode: opt[str] = decorator.string_of(sc.s.interner, sc.view.ctx, sc.view.a, opt_inlined.some, 0);
        if (sel opt_mode.some && str_equals(opt_mode.some, "always")) {
            sema_context.report(sc, diagnostic_kind.DECORATOR_CONFLICT, dec.name, "`naked` and `inline(\"always\")` cannot be combined, because a naked function cannot be inlined");
        }
    }
    if (decorator.has(sc.view.a, d, decorator.CONSTANT_TIME)) {
        sema_context.report(sc, diagnostic_kind.DECORATOR_CONFLICT, dec.name, "`naked` and `constant_time` cannot be combined, because the compiler writes a constant-time function's entry and returns itself");
    }
    if (ast_id.stmt_is_nil(d.data.fun_.body)) {
        sema_context.report(sc, diagnostic_kind.DECORATOR_MISPLACED, dec.name, "`naked` decorator applies only to a function with a body");
        ret;
    }
    check_naked_body(sc, d.data.fun_.body);
}

fun check_naked_body(sc: *sema_context.SemaContext, sid: ast_id.StmtId) {
    val opt_stmt: opt[*ast_stmt.Stmt] = ast.get_stmt(sc.view.a, sid);
    if (!sel opt_stmt.some) { ret; }
    val s: *ast_stmt.Stmt = opt_stmt.some;
    if (stack.exhausted()) {
        sema_context.refuse_nesting(sc, s.span);
        ret;
    }

    if (s.kind == ast_stmt.STMT_KIND_ASM) { ret; }

    if (s.kind == ast_stmt.STMT_KIND_BLOCK) {
        var i: u32 = 0;
        for (i < s.data.block.stmts_len) {
            check_naked_body(sc, sc.view.a.stmt_ids.data[s.data.block.stmts_start + i]);
            i = i + 1;
        }
        ret;
    }

    if (s.kind == ast_stmt.STMT_KIND_COMPTIME_IF) {
        var b: u32 = 0;
        for (b < s.data.comptime_if.branches_len) {
            val br: *ast_decl.ComptimeBranch = ?sc.view.a.comptime_branches.data[s.data.comptime_if.branches_start + b];
            var i:  u32                      = 0;
            for (i < br.body_len) {
                check_naked_body(sc, sc.view.a.stmt_ids.data[br.body_start + i]);
                i = i + 1;
            }
            b = b + 1;
        }
        ret;
    }

    sema_context.report(sc, diagnostic_kind.NAKED_BODY, s.span, "a `naked` function's body may contain only inline `asm` statements");
}
