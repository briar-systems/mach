# an `#[intrinsic(owner, set, name)]` function names what a call of it becomes. an owner that
# is an architecture names an instruction of that target's operation catalog, mirl's
# capability catalog of the target, which holds masc's rows of each set: a declaration for
# the selected architecture is read against that catalog where a call to it is lowered, and
# mirl's verifier holds the instruction to its row, while one for any other architecture is an
# ordinary function, its body what that target runs. the reserved owner `mirl` names one of
# mirl's own operations of the set `ir`, on every target: the declaration has no body, takes
# no type, `$` or pack parameter, and names an operation OPERATIONS admits, and lowering holds
# its signature to the operation's row
use std.types.bool.bool;
use std.types.bool.false;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.view.View;

use mach.base.diagnostic;
use diagnostic_kind: mach.base.diagnostic.kind;
use mach.base.intern;
use mach.front.ast;
use ast_decl: mach.front.ast.decl;
use ast_id:   mach.front.ast.id;
use ast_type: mach.front.ast.type;
use mach.front.decorator;
use sema_context: mach.front.sema.context;
use mach.front.sema.interface;
use opcode_row: mirl.ir.opcode.row;
use mirl.ir.opcode.row.Opcode;
use opcode_table: mirl.ir.opcode.table;

# the owner naming mirl itself, which no architecture is named
val MIRL: str = "mirl";

# the one set of mirl's own operations
val IR: str = "ir";

# the operations an `intrinsic` of mirl may name. each is one whose row a declaration states
# whole: value operands only, no immediate, no target and no tail, so its parameters are its
# operands and its return type its result
val OPERATIONS: [3]Opcode = [3]Opcode{opcode_table.POPCNT, opcode_table.CLZ, opcode_table.CTZ};

# what the `#[intrinsic]` of a function names for the build
# ---
# none:      no intrinsic of the build: none at all, one of another architecture, or one the
#            decorator's row refuses
# native:    an instruction of the selected target's catalog
# operation: mirl's own operation
# set:       an intrinsic of mirl naming a set that is not `ir`, the set argument's text
# name:      an intrinsic of mirl naming no operation it may, the name argument's text
tag Read: u8 {
    none;
    native:    interface.Native;
    operation: Opcode;
    set:       str;
    name:      str;
}

# what the `#[intrinsic]` decorator `dec` names for the build
fun read(sc: *sema_context.SemaContext, dec: *ast_decl.Decorator) Read {
    if (dec.args_len != 3) { ret Read.none{}; }
    val opt_owner: opt[str]     = decorator.string_of(sc.s.interner, sc.view.ctx, sc.view.a, dec, 0);
    val set:       intern.StrId = decorator.string_id(sc.view.ctx, sc.view.a, dec, 1);
    val name:      intern.StrId = decorator.string_id(sc.view.ctx, sc.view.a, dec, 2);
    if (sel opt_owner.none)                                { ret Read.none{}; }
    if (intern.str_is_nil(set) || intern.str_is_nil(name)) { ret Read.none{}; }
    if (str_equals(opt_owner.some, MIRL)) {
        val set_text:  str = intern.text(sc.s.interner, set);
        val name_text: str = intern.text(sc.s.interner, name);
        if (!str_equals(set_text, IR)) { ret Read.set{set_text}; }
        val opt_op: opt[Opcode] = admitted(View{data: name_text, len: str_len(name_text)});
        if (sel opt_op.none) { ret Read.name{name_text}; }
        ret Read.operation{opt_op.some};
    }
    if (!target_is_selected(sc, opt_owner.some)) { ret Read.none{}; }
    ret Read.native{interface.Native{set: set, name: name}};
}

# the operation of mirl `name` names, where an `intrinsic` may name it
fun admitted(name: View) opt[Opcode] {
    val opt_op: opt[Opcode] = opcode_table.named(name);
    if (sel opt_op.none) { ret opt_op; }
    var i: usize = 0;
    for (i < $length_of(OPERATIONS)) {
        if (OPERATIONS[i] == opt_op.some) { ret opt_op; }
        i = i + 1;
    }
    ret opt[Opcode].none{};
}

# whether the architecture name `tgt` names the selected architecture, as an `#[intrinsic]` or a `#[handle]` names it
pub fun target_is_selected(sc: *sema_context.SemaContext, tgt: str) bool {
    val opt_interner_entry: opt[str] = intern.get(sc.s.interner, sc.view.ctx.env.build.isa_name);
    if (!sel opt_interner_entry.some) { ret false; }
    ret str_equals(tgt, opt_interner_entry.some);
}

# what the `#[intrinsic]` of the function `d` makes a call of it for the build, none where it
# has none or `check` refuses it
pub fun intrinsic_of(sc: *sema_context.SemaContext, d: *ast_decl.Decl) interface.Intrinsic {
    val opt_dec: opt[*ast_decl.Decorator] = decorator.get(sc.view.a, d, decorator.INTRINSIC);
    if (sel opt_dec.none) { ret interface.Intrinsic.none{}; }
    val r: Read = read(sc, opt_dec.some);
    if (sel r.native)    { ret interface.Intrinsic.native{r.native}; }
    if (sel r.operation) { ret interface.Intrinsic.operation{r.operation}; }
    ret interface.Intrinsic.none{};
}

# the function `d` refused where its `#[intrinsic]` names one of mirl's operations and the
# declaration cannot be that operation: a set other than `ir`, a name `ir` holds no operation
# an `intrinsic` may name of, a body, a type parameter, a `$` parameter or a pack
pub fun check(sc: *sema_context.SemaContext, d: *ast_decl.Decl) {
    val opt_dec: opt[*ast_decl.Decorator] = decorator.get(sc.view.a, d, decorator.INTRINSIC);
    if (sel opt_dec.none) { ret; }
    val dec: *ast_decl.Decorator = opt_dec.some;
    val r:   Read                = read(sc, dec);
    if (sel r.set) {
        sema_context.reportf(sc, diagnostic_kind.OP_UNKNOWN, dec.span, "an `intrinsic` of `mirl` names the set `ir`, not `{}`", r.set);
        ret;
    }
    if (sel r.name) {
        sema_context.reportf(sc, diagnostic_kind.OP_UNKNOWN, dec.span, "`{}` is not an operation of mirl an `intrinsic` may name", r.name);
        ret;
    }
    if (!(sel r.operation)) { ret; }
    val f: *ast_decl.DeclFun = ?d.data.fun_;
    if (!ast_id.stmt_is_nil(f.body)) {
        sema_context.report(sc, diagnostic_kind.OP_SIGNATURE, f.name, "an `intrinsic` of `mirl` has no body, since every target computes its operation");
        ret;
    }
    if (f.generics_len > 0) {
        sema_context.report(sc, diagnostic_kind.OP_SIGNATURE, f.name, "an `intrinsic` of `mirl` takes no type parameter, since its signature is held to its operation's");
        ret;
    }
    var i: u32 = 0;
    for (i < f.params_len) {
        val param:  *ast_decl.TypedName = ?sc.view.a.typed_names.data[f.params_start + i];
        val opt_ty: opt[*ast_type.Type] = ast.get_type(sc.view.a, param.ty);
        if (param.comptime || (sel opt_ty.some && opt_ty.some.kind == ast_type.TYPE_KIND_PACK)) {
            sema_context.report(sc, diagnostic_kind.OP_SIGNATURE, f.name, "an `intrinsic` of `mirl` takes no `$` parameter or pack, since each parameter is an operand of its operation");
            ret;
        }
        i = i + 1;
    }
}
