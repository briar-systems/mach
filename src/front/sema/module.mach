# typing one module: its declarations and bodies, the instances they ask for, and the result it
# publishes; and typing one instance on its own (instance_sema)
use mach.base.diagnostic;
use diagnostic_kind: mach.base.diagnostic.kind;
use mach.base.fail;
use mach.base.intern;
use base_source: mach.base.source;
use mach.base.stack;
use mach.front.ast;
use ast_decl:            mach.front.ast.decl;
use ast_expr:            mach.front.ast.expr;
use ast_id:              mach.front.ast.id;
use ast_module:          mach.front.ast.module;
use ast_type:            mach.front.ast.type;
use comptime_capability: mach.front.comptime.capability;
use comptime_deep:       mach.front.comptime.deep;
use comptime_gate:       mach.front.comptime.gate;
use comptime_scope:      mach.front.comptime.scope;
use comptime_value:      mach.front.comptime.value;
use mach.front.decorator;
use mach.front.refusal;
use mach.front.resolve;
use mach.front.sema.abitype;
use sema_capability: mach.front.sema.capability;
use sema_constant:   mach.front.sema.constant;
use sema_context:    mach.front.sema.context;
use sema_declared:   mach.front.sema.declared;
use sema_decorator:  mach.front.sema.decorator;
use sema_embed:      mach.front.sema.embed;
use mach.front.sema.fields;
use mach.front.sema.generics;
use sema_growth: mach.front.sema.growth;
use sema_handle: mach.front.sema.handle;
use mach.front.sema.infer;
use sema_inferred: mach.front.sema.inferred;
use sema_instance: mach.front.sema.instance;
use mach.front.sema.interface;
use sema_lint:    mach.front.sema.lint;
use sema_literal: mach.front.sema.literal;
use sema_product: mach.front.sema.product;
use mach.front.sema.publish;
use sema_stmt: mach.front.sema.stmt;
use mach.front.sema.variant;
use report_phase: mach.report.phase;
use mach.session;
use mach.session.module;
use mach.type;
use type_kind: mach.type.kind;
use mach.type.query.reach;
use mach.type.query.subst;
use type_scan: mach.type.scan;
use A:         std.allocator;
use std.collections.map;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

# type a module in a scope over the load's, `load`, and resolve's bindings in `rr`, which sema
# reads and never writes; what sema binds is its result's
pub fun sema(
    s: *session.Session,
    a: *ast.Ast,
    rr: *resolve.ResolveResult,
    deps: *sema_product.SemaDeps,
    load: *comptime_scope.ComptimeCtx,
    own_module: module.ModuleId,
    diags: *diagnostic.DiagnosticStore) res[sema_product.SemaResult, fail.Fail] {
    var scope: comptime_scope.ComptimeCtx = comptime_scope.stage_init(load, comptime_scope.STAGE_SEMA, s.alloc);
    fin { comptime_scope.dnit(?scope); }
    if (rr != nil) { comptime_scope.layer_set(?scope, comptime_scope.STAGE_RESOLVE, ?rr.constants); }
    val err_gates: err[fail.Fail] = comptime_scope.prepare_gates(?scope, a.exprs.len::u32);
    if (sel err_gates.err) { ret res[sema_product.SemaResult, fail.Fail].err{err_gates.err}; }
    var values: comptime_deep.Store = comptime_deep.init(s.alloc);
    fin { comptime_deep.dnit(?values); }
    var sc:          sema_context.SemaContext;
    var uni_reports: sema_context.UniReports;
    uni_reports.len = 0;
    var handle_reports: sema_context.UniReports;
    handle_reports.len = 0;

    val err_init: err[fail.Fail] = init_context(?sc, s, a, rr, deps, ?scope, own_module, ?values, diags);
    if (sel err_init.err) { ret res[sema_product.SemaResult, fail.Fail].err{err_init.err}; }
    fin { dnit_context(?sc); }
    var logical_seen: map.Map[type_kind.TypeId, bool] = map.init[type_kind.TypeId, bool](s.alloc);
    fin { map.dnit[type_kind.TypeId, bool](?logical_seen); }
    sc.typing.logical_seen = ?logical_seen;
    var refused: refusal.Refusal = refusal.init(s.alloc);
    fin { refusal.dnit(?refused); }
    sc.typing.refusal = ?refused;
    if (refused_module(?sc)) { ret finish_result(?sc, fields.init(s.alloc), interface.init(s.alloc)); }

    val err_embeds: err[fail.Fail] = resolve_all_embeds(?sc);
    if (sel err_embeds.err) { ret res[sema_product.SemaResult, fail.Fail].err{err_embeds.err}; }

    sema_inferred.record_all(?sc);

    val err_types: err[fail.Fail] = resolve_all_types(?sc);
    if (sel err_types.err) { ret res[sema_product.SemaResult, fail.Fail].err{err_types.err}; }

    val res_analyzed: res[sema_growth.Analysis, fail.Fail] = sema_growth.analyze(s, a, rr, sc.view.source, own_module, s.alloc);
    if (sel res_analyzed.err) { ret res[sema_product.SemaResult, fail.Fail].err{res_analyzed.err}; }
    var growth: sema_growth.Analysis = res_analyzed.ok;
    fin { sema_growth.dnit(?growth); }
    sc.typing.growth = ?growth;
    growth_refusals_report(?sc);

    val err_decls: err[fail.Fail] = infer_all_decls(?sc);
    if (sel err_decls.err) { ret res[sema_product.SemaResult, fail.Fail].err{err_decls.err}; }

    val err_constants: err[fail.Fail] = bind_all_constants(?sc);
    if (sel err_constants.err) { ret res[sema_product.SemaResult, fail.Fail].err{err_constants.err}; }

    val err_occurs: err[fail.Fail] = sema_declared.check_occurs_all(?sc);
    if (sel err_occurs.err) { ret res[sema_product.SemaResult, fail.Fail].err{err_occurs.err}; }

    val err_uni_secrecy: err[fail.Fail] = sema_declared.check_uni_secrecy_all(?sc);
    if (sel err_uni_secrecy.err) { ret res[sema_product.SemaResult, fail.Fail].err{err_uni_secrecy.err}; }

    sema_handle.check_handle_fields_all(?sc);

    sc.typing.has_secret  = sema_context.recover[bool](?sc, reach.module_secret(s, sc.view.type_resolved_ty, a.types.len::u32), false);
    sc.typing.uni_reports = ?uni_reports;
    check_annotation_uni_secrecy_all(?sc);
    sc.typing.handle_reports = ?handle_reports;
    sema_handle.check_annotation_handles_all(?sc);

    var tests: map.Map[u32, u32] = map.init[u32, u32](s.alloc);
    fin { map.dnit[u32, u32](?tests); }
    sc.typing.tests = ?tests;
    var symbols: map.Map[u32, u64] = map.init[u32, u64](s.alloc);
    fin { map.dnit[u32, u64](?symbols); }
    sc.typing.symbols = ?symbols;
    var functions: map.Map[u32, ast_id.DeclId] = map.init[u32, ast_id.DeclId](s.alloc);
    fin { map.dnit[u32, ast_id.DeclId](?functions); }
    sc.typing.functions = ?functions;
    sc.typing.caps      = sc.typing.type_caps;
    val err_bodies: err[fail.Fail] = infer_all_bodies(?sc);
    if (sel err_bodies.err) { ret res[sema_product.SemaResult, fail.Fail].err{err_bodies.err}; }

    sema_literal.check_float_literals(?sc);
    val err_shifts: err[fail.Fail] = sema_literal.check_literal_shifts(?sc);
    if (sel err_shifts.err) { ret res[sema_product.SemaResult, fail.Fail].err{err_shifts.err}; }

    val err_defaults: err[fail.Fail] = sema_literal.check_default_literals(?sc);
    if (sel err_defaults.err) { ret res[sema_product.SemaResult, fail.Fail].err{err_defaults.err}; }

    val err_notices: err[fail.Fail] = sema_lint.warn_deprecated_uses(?sc);
    if (sel err_notices.err) { ret res[sema_product.SemaResult, fail.Fail].err{err_notices.err}; }

    val err_confined: err[fail.Fail] = sema_lint.check_testing_uses(?sc);
    if (sel err_confined.err) { ret res[sema_product.SemaResult, fail.Fail].err{err_confined.err}; }

    ret build_result(?sc);
}

# a growing cycle no comptime gate stops is refused at its growing call, naming the
# templates on it, before any instance of it is made
fun growth_refusals_report(sc: *sema_context.SemaContext) {
    val an: *sema_growth.Analysis = sc.typing.growth;
    if (an.nested) { sema_context.refuse_nesting(sc, an.nested_at); }
    var i: usize = 0;
    for (i < an.cycles.len) {
        val c: *sema_growth.Cycle = ?an.cycles.data[i];
        if (c.refused) {
            val opt_msg: opt[str] = sema_context.text(sc,
                "`{}` instantiates `{}` here at an argument that grows, on a cycle of instances no comptime gate can stop ({}), so its instances never end",
                intern.text(sc.s.interner, c.caller), intern.text(sc.s.interner, c.callee), intern.text(sc.s.interner, c.members));
            if (sel opt_msg.some) {
                sema_context.report_note(sc, diagnostic_kind.GENERIC_GROWING_CYCLE, c.site, opt_msg.some,
                    "an instance on this cycle asks for a new instance at every step. put the growing call under a comptime gate that ends it");
                sema_context.text_free(sc, opt_msg.some);
            }
        }
        i = i + 1;
    }
}

# resolve refused this module and bound nothing else, or typing refused a module it imports,
# so there is nothing to type and the refusal is this pass's answer too
fun refused_module(sc: *sema_context.SemaContext) bool {
    if (sc.view.rr != nil && refusal.is_refused(?sc.view.rr.refusal)) {
        report_phase.reject(?sc.status);
        ret true;
    }
    val deps: *sema_product.SemaDeps = sc.typing.deps;
    var i:    u32                    = 0;
    for (i < deps.count) {
        if (deps.entries[i].refused) {
            sc.typing.refusal.state = refusal.IMPORTED;
            report_phase.reject(?sc.status);
            ret true;
        }
        i = i + 1;
    }
    ret false;
}

fun copy_typeids(dst: *type_kind.TypeId, src: *type_kind.TypeId, n: usize) {
    var i: u32 = 0;
    for (i < n::u32) {
        dst[i] = src[i];
        i      = i + 1;
    }
}

fun free_typeids(alloc: *A.Allocator, arr: *type_kind.TypeId, n: usize) {
    if (arr != nil && n > 0) { A.deallocate[type_kind.TypeId](alloc, arr, n); }
}

# types the instance `item` on its own: a generic under its type arguments, a function with
# comptime value parameters with them bound, a function with a pack over its element types. it
# reads its declaring module's typed definition and the surfaces `deps` holds, and writes only
# its own result: its frames, the instances its body asks for after it in a set of its own,
# the constants its body builds, and its reports, those it would make where it is asked for
# placed nowhere. who asked for it is no part of its typing, so one typing serves every user
pub fun instance_sema(s: *session.Session, item: *sema_instance.Instance, deps: *sema_product.SemaDeps) res[sema_product.InstanceResult, fail.Fail] {
    var out: sema_product.InstanceResult = sema_product.InstanceResult{status: report_phase.accepted()};
    out.values = comptime_deep.init(s.alloc);
    out.diags  = diagnostic.store_init(s.alloc);
    var handed: bool = false;
    fin {
        if (!handed) { sema_product.instance_dnit(?out); }
    }
    val err_typed: err[fail.Fail] = instance_type(s, item, deps, ?out);
    if (sel err_typed.err)            { ret res[sema_product.InstanceResult, fail.Fail].err{err_typed.err}; }
    if (sel out.status.kind.internal) { ret res[sema_product.InstanceResult, fail.Fail].err{report_phase.phase_failure(out.status)}; }
    handed = true;
    ret res[sema_product.InstanceResult, fail.Fail].ok{out};
}

# types the instance `item` into `out`: acquires its declaring module's typed definition,
# heads a set of its own with it, binds its comptime values and types its body under its
# substitution
fun instance_type(s: *session.Session, item: *sema_instance.Instance, deps: *sema_product.SemaDeps, out: *sema_product.InstanceResult) err[fail.Fail] {
    val res_acquired: res[sema_product.Definition, fail.Fail] = sema_product.acquire_definition(?deps.definitions, item.origin, sema_product.DEFINITION_TYPED);
    if (sel res_acquired.err) { ret err[fail.Fail].err{res_acquired.err}; }
    val definition: sema_product.Definition = res_acquired.ok;
    val oa:         *ast.Ast                = definition.parsed.a;
    if (oa == nil || definition.sr.decl_type == nil) { ret err[fail.Fail].err{fail.message("instance typing: the declaring module has no typed declarations")}; }
    val res_source: res[str, fail.Fail] = sema_context.source_text_of(s, oa);
    if (sel res_source.err) { ret err[fail.Fail].err{res_source.err}; }

    val opt_decl: opt[*ast_decl.Decl] = ast.get_decl(oa, item.decl);
    if (!sel opt_decl.some) { ret err[fail.Fail].err{fail.message("instance typing: instance decl id out of range in origin AST (invariant violated)")}; }
    val d: *ast_decl.Decl = opt_decl.some;
    if (d.kind != ast_decl.DECL_KIND_FUN) { ret err[fail.Fail].err{fail.message("instance typing: instance decl is not a function (invariant violated)")}; }

    # the instance heads its own set, its frame the one its body is typed into
    val res_worklist: res[*sema_context.InstWorklist, fail.Fail] = sema_context.inst_worklist_init(s.alloc);
    if (sel res_worklist.err) { ret err[fail.Fail].err{res_worklist.err}; }
    val wl: *sema_context.InstWorklist = res_worklist.ok;
    fin { sema_context.inst_worklist_take(wl, ?out.set); }
    val res_headed: res[sema_instance.Added, fail.Fail] = sema_instance.add(?wl.set, @item);
    if (sel res_headed.err) { ret err[fail.Fail].err{res_headed.err}; }
    val head_frame: u32 = sema_instance.at(?wl.set, res_headed.ok.id).frame;
    if (ast_id.stmt_is_nil(d.data.fun_.body)) { ret err[fail.Fail].ok{}; }

    var owner: type.GenericOwner;
    if (item.arg_len > 0) {
        val res_who: res[type.GenericOwner, fail.Fail] = sema_context.generic_owner_of_decl(s, oa, item.origin, item.decl);
        if (sel res_who.err) { ret err[fail.Fail].err{res_who.err}; }
        owner = res_who.ok;
    }

    var scratch_expr: *type_kind.TypeId = nil;
    var scratch_decl: *type_kind.TypeId = nil;
    fin {
        free_typeids(s.alloc, scratch_expr, oa.exprs.len);
        free_typeids(s.alloc, scratch_decl, oa.decls.len);
    }
    if (oa.exprs.len > 0) {
        val res_typeid_array_alloc: res[*type_kind.TypeId, fail.Fail] = typeid_array_alloc(s.alloc, oa.exprs.len);
        if (sel res_typeid_array_alloc.err) { ret err[fail.Fail].err{res_typeid_array_alloc.err}; }
        scratch_expr = res_typeid_array_alloc.ok;
        if (definition.sr.expr_type != nil) { copy_typeids(scratch_expr, definition.sr.expr_type, oa.exprs.len); }
    }
    if (oa.decls.len > 0) {
        val res_typeid_array_alloc: res[*type_kind.TypeId, fail.Fail] = typeid_array_alloc(s.alloc, oa.decls.len);
        if (sel res_typeid_array_alloc.err) { ret err[fail.Fail].err{res_typeid_array_alloc.err}; }
        scratch_decl = res_typeid_array_alloc.ok;
        copy_typeids(scratch_decl, definition.sr.decl_type, oa.decls.len);
    }

    val res_caps: res[comptime_capability.PhaseCapabilities[sema_context.SemaContext], fail.Fail] = sema_capability.semantic_type_caps();
    if (sel res_caps.err) { ret err[fail.Fail].err{res_caps.err}; }
    var foreign: comptime_scope.ComptimeCtx = comptime_scope.reader_init(definition.ctx);
    fin { comptime_scope.dnit(?foreign); }
    var logical_seen: map.Map[type_kind.TypeId, bool] = map.init[type_kind.TypeId, bool](s.alloc);
    fin { map.dnit[type_kind.TypeId, bool](?logical_seen); }
    var uni_reports: sema_context.UniReports;
    uni_reports.len = 0;
    var handle_reports: sema_context.UniReports;
    handle_reports.len = 0;

    var view: sema_context.ModuleView = sema_context.ModuleView{};
    view.own_module       = item.origin;
    view.own_stable       = resolve.stable_of_module(s, item.origin);
    view.a                = oa;
    view.rr               = definition.rr;
    view.ctx              = ?foreign;
    view.source           = res_source.ok;
    view.type_resolved_ty = definition.sr.type_resolved_ty;
    view.expr_type        = scratch_expr;
    view.decl_type        = scratch_decl;
    var typing: sema_context.Typing = sema_context.Typing{};
    typing.deps                = deps;
    typing.caps                = res_caps.ok;
    typing.type_caps           = res_caps.ok;
    typing.insts               = wl;
    typing.collect_insts       = true;
    typing.uni_reports         = ?uni_reports;
    typing.handle_reports      = ?handle_reports;
    typing.logical_seen        = ?logical_seen;
    typing.subst_fn            = subst.substitute;
    typing.annotation_check_fn = generics.check_annotation;
    typing.infer_fn            = infer.infer_expr;
    typing.type_fn             = sema_declared.resolve_type_ref;
    typing.module              = module.stable_id(comptime_deep.INSTANCE_MODULE);
    typing.values              = ?out.values;
    typing.has_secret          = definition.sr.has_secret || arguments_secret(s, item);
    var instance: sema_context.Instance = sema_context.Instance{};
    instance.parent      = res_headed.ok.id;
    instance.frame       = head_frame;
    instance.pack_types  = item.pack;
    instance.pack_len    = item.pack_len;
    instance.quiet       = item.kind == sema_instance.KIND_PACK || (item.kind == sema_instance.KIND_VALUE && !sema_context.decl_value_sized(definition.rr, item.decl));
    instance.site_file   = base_source.FILE_NIL;
    instance.site_set    = true;
    instance.subst       = item.args;
    instance.subst_len   = item.arg_len;
    instance.subst_owner = owner;
    var tsc: sema_context.SemaContext = sema_context.init(s, ?out.diags, typing, view, instance);
    fin { report_phase.merge(?out.status, tsc.status); }
    tsc.walk.silent      = instance.quiet;
    tsc.walk.timed       = sema_declared.timed_of(?tsc, tsc.view.ctx, oa, d);
    tsc.walk.ret_written = d.data.fun_.return_type;
    var secrecy: sema_context.SecrecyWalk;
    variant.walk_begin(?tsc, ?secrecy);
    fin { variant.walk_end(?tsc, ?secrecy); }
    tsc.instance.secrecy = ?secrecy;
    var handles: type_scan.Scan;
    if (!sema_handle.scan_begin(?tsc, ?handles)) { ret err[fail.Fail].err{fail.message("instance typing: the handle walk cannot open")}; }
    fin { type.type_scan_end(s.types, ?handles); }
    tsc.instance.handles = ?handles;

    var bound: comptime_scope.FrameMark;
    if (item.value_len > 0) {
        val res_mark: res[comptime_scope.FrameMark, fail.Fail] = comptime_scope.frame_begin(tsc.view.ctx);
        if (sel res_mark.err) { ret err[fail.Fail].err{res_mark.err}; }
        bound = res_mark.ok;
        var vi: u32 = 0;
        for (vi < item.value_len) {
            val err_put: err[fail.Fail] = comptime_scope.bind_local(tsc.view.ctx, item.names[vi], item.values[vi]);
            if (sel err_put.err) {
                val err_closed: err[fail.Fail] = comptime_scope.frame_end(tsc.view.ctx, bound);
                if (sel err_closed.err) { ret err_closed; }
                ret err_put;
            }
            vi = vi + 1;
        }
    }

    val ret_ty: type_kind.TypeId = sema_context.resolved_type_of(?tsc, d.data.fun_.return_type);
    sema_context.check_handle_in_array(?tsc, ret_ty, d.data.fun_.name);
    var pi: u32 = 0;
    for (pi < d.data.fun_.params_len) {
        val ptn: *ast_decl.TypedName = ?oa.typed_names.data[d.data.fun_.params_start + pi];
        generics.check_annotation(?tsc, ptn.ty);
        if (ast_id.type_index(ptn.ty) < oa.types.len::u32) {
            sema_context.check_handle_in_array(?tsc, sema_context.apply_subst(?tsc, tsc.view.type_resolved_ty[ast_id.type_index(ptn.ty)]), ptn.name);
        }
        pi = pi + 1;
    }
    val err_infer_stmt: err[fail.Fail] = sema_stmt.infer_stmt(?tsc, d.data.fun_.body, ret_ty);
    if (!tsc.instance.quiet) { sema_literal.check_instance_float_literals(?tsc, definition.sr.expr_type); }
    tsc.instance.site_set = false;
    tsc.walk.offer        = nil;
    if (item.value_len > 0) {
        val err_closed: err[fail.Fail] = comptime_scope.frame_end(tsc.view.ctx, bound);
        if (sel err_closed.err) { ret err_closed; }
    }
    ret err_infer_stmt;
}

# whether an instance's type arguments or pack bring a secret its template's own annotations do not
fun arguments_secret(s: *session.Session, item: *sema_instance.Instance) bool {
    val res_args: res[bool, fail.Fail] = reach.module_secret(s, item.args, item.arg_len);
    if (sel res_args.err) { ret true; }
    if (res_args.ok)      { ret true; }
    val res_pack: res[bool, fail.Fail] = reach.module_secret(s, item.pack, item.pack_len);
    if (sel res_pack.err) { ret true; }
    ret res_pack.ok;
}

# makes the sema context of a module and its typing tables, every entry pending or unset
fun init_context(
    sc: *sema_context.SemaContext,
    s: *session.Session,
    a: *ast.Ast,
    rr: *resolve.ResolveResult,
    deps: *sema_product.SemaDeps,
    ctx: *comptime_scope.ComptimeCtx,
    own_module: module.ModuleId,
    values: *comptime_deep.Store,
    diags: *diagnostic.DiagnosticStore) err[fail.Fail] {
    val res_caps: res[comptime_capability.PhaseCapabilities[sema_context.SemaContext], fail.Fail] = sema_capability.semantic_name_caps();
    if (sel res_caps.err) { ret err[fail.Fail].err{res_caps.err}; }
    val res_type_caps: res[comptime_capability.PhaseCapabilities[sema_context.SemaContext], fail.Fail] = sema_capability.semantic_type_caps();
    if (sel res_type_caps.err) { ret err[fail.Fail].err{res_type_caps.err}; }
    val res_source: res[str, fail.Fail] = sema_context.source_text_of(s, a);
    if (sel res_source.err) { ret err[fail.Fail].err{res_source.err}; }
    var view: sema_context.ModuleView = sema_context.ModuleView{};
    view.a          = a;
    view.rr         = rr;
    view.ctx        = ctx;
    view.own_module = own_module;
    view.own_stable = resolve.stable_of_module(s, own_module);
    view.source     = res_source.ok;
    var typing: sema_context.Typing = sema_context.Typing{};
    typing.deps                = deps;
    typing.caps                = res_caps.ok;
    typing.type_caps           = res_type_caps.ok;
    typing.collect_insts       = true;
    typing.subst_fn            = subst.substitute;
    typing.annotation_check_fn = generics.check_annotation;
    typing.infer_fn            = infer.infer_expr;
    typing.type_fn             = sema_declared.resolve_type_ref;
    typing.module              = view.own_stable;
    typing.values              = values;
    @sc                        = sema_context.init(s, diags, typing, view, sema_context.instance_none());

    val res_worklist: res[*sema_context.InstWorklist, fail.Fail] = sema_context.inst_worklist_init(s.alloc);
    if (sel res_worklist.err) { ret err[fail.Fail].err{res_worklist.err}; }
    sc.typing.insts = res_worklist.ok;
    var handed: bool = false;
    fin {
        if (!handed) { dnit_context(sc); }
    }

    if (a.exprs.len > 0) {
        val res_expr: res[*type_kind.TypeId, fail.Fail] = typeid_array_alloc(s.alloc, a.exprs.len);
        if (sel res_expr.err) {
            ret err[fail.Fail].err{res_expr.err};
        }
        sc.view.expr_type = res_expr.ok;
        val res_cases: res[*u32, A.Error] = A.zallocate[u32](s.alloc, a.exprs.len);
        if (sel res_cases.err) { ret err[fail.Fail].err{fail.refused(res_cases.err)}; }
        sc.view.guard_case = res_cases.ok;
    }
    if (a.types.len > 0) {
        val res_type: res[*type_kind.TypeId, fail.Fail] = typeid_array_alloc(s.alloc, a.types.len);
        if (sel res_type.err) {
            ret err[fail.Fail].err{res_type.err};
        }
        sc.view.type_resolved_ty = res_type.ok;

        val res_memo: res[*u8, fail.Fail] = memo_array_alloc(s.alloc, a.types.len);
        if (sel res_memo.err) {
            ret err[fail.Fail].err{res_memo.err};
        }
        sc.view.type_resolved_memo = res_memo.ok;

        val res_emb: res[*u64, fail.Fail] = inferred_len_array_alloc(s.alloc, a.types.len);
        if (sel res_emb.err) {
            ret err[fail.Fail].err{res_emb.err};
        }
        sc.view.inferred_len = res_emb.ok;
    }
    if (a.decls.len > 0) {
        val res_decl: res[*type_kind.TypeId, fail.Fail] = typeid_array_alloc(s.alloc, a.decls.len);
        if (sel res_decl.err) {
            ret err[fail.Fail].err{res_decl.err};
        }
        sc.view.decl_type = res_decl.ok;

        val res_lay: res[*u8, fail.Fail] = layout_state_alloc(s.alloc, a.decls.len);
        if (sel res_lay.err) {
            ret err[fail.Fail].err{res_lay.err};
        }
        sc.view.layout_state = res_lay.ok;

        val res_const: res[*u8, fail.Fail] = constant_state_alloc(s.alloc, a.decls.len);
        if (sel res_const.err) {
            ret err[fail.Fail].err{res_const.err};
        }
        sc.view.constant_state = res_const.ok;

        val res_node: res[*comptime_deep.Node, fail.Fail] = constant_node_alloc(s.alloc, a.decls.len);
        if (sel res_node.err) {
            ret err[fail.Fail].err{res_node.err};
        }
        sc.view.constant_node = res_node.ok;
    }

    val err_seed: err[fail.Fail] = sema_declared.seed_builtins(sc);
    if (sel err_seed.err) {
        ret err_seed;
    }

    handed = true;
    ret err[fail.Fail].ok{};
}

fun typeid_array_alloc(a: *A.Allocator, len: usize) res[*type_kind.TypeId, fail.Fail] {
    val res_arr: res[*type_kind.TypeId, A.Error] = A.allocate[type_kind.TypeId](a, len);
    if (sel res_arr.err) { ret res[*type_kind.TypeId, fail.Fail].err{fail.refused(res_arr.err)}; }
    val arr: *type_kind.TypeId = res_arr.ok;

    var i: u32 = 0;
    for (i < len::u32) {
        arr[i] = type_kind.TYPE_NIL;
        i      = i + 1;
    }
    ret res[*type_kind.TypeId, fail.Fail].ok{arr};
}

fun layout_state_alloc(a: *A.Allocator, len: usize) res[*u8, fail.Fail] {
    val res_arr: res[*u8, A.Error] = A.allocate[u8](a, len);
    if (sel res_arr.err) { ret res[*u8, fail.Fail].err{fail.refused(res_arr.err)}; }
    val arr: *u8 = res_arr.ok;

    var i: u32 = 0;
    for (i < len::u32) {
        arr[i] = sema_context.LAYOUT_PENDING;
        i      = i + 1;
    }
    ret res[*u8, fail.Fail].ok{arr};
}

fun constant_state_alloc(a: *A.Allocator, len: usize) res[*u8, fail.Fail] {
    val res_arr: res[*u8, A.Error] = A.allocate[u8](a, len);
    if (sel res_arr.err) { ret res[*u8, fail.Fail].err{fail.refused(res_arr.err)}; }
    val arr: *u8 = res_arr.ok;

    var i: u32 = 0;
    for (i < len::u32) {
        arr[i] = sema_constant.CONSTANT_PENDING;
        i      = i + 1;
    }
    ret res[*u8, fail.Fail].ok{arr};
}

fun constant_node_alloc(a: *A.Allocator, len: usize) res[*comptime_deep.Node, fail.Fail] {
    val res_arr: res[*comptime_deep.Node, A.Error] = A.allocate[comptime_deep.Node](a, len);
    if (sel res_arr.err) { ret res[*comptime_deep.Node, fail.Fail].err{fail.refused(res_arr.err)}; }
    val arr: *comptime_deep.Node = res_arr.ok;

    var i: u32 = 0;
    for (i < len::u32) {
        arr[i] = comptime_deep.NONE;
        i      = i + 1;
    }
    ret res[*comptime_deep.Node, fail.Fail].ok{arr};
}

fun inferred_len_array_alloc(a: *A.Allocator, len: usize) res[*u64, fail.Fail] {
    val res_arr: res[*u64, A.Error] = A.allocate[u64](a, len);
    if (sel res_arr.err) { ret res[*u64, fail.Fail].err{fail.refused(res_arr.err)}; }
    val arr: *u64 = res_arr.ok;

    var i: u32 = 0;
    for (i < len::u32) {
        arr[i] = sema_product.INFERRED_LEN_NONE;
        i      = i + 1;
    }
    ret res[*u64, fail.Fail].ok{arr};
}

fun memo_array_alloc(a: *A.Allocator, len: usize) res[*u8, fail.Fail] {
    val res_arr: res[*u8, A.Error] = A.allocate[u8](a, len);
    if (sel res_arr.err) { ret res[*u8, fail.Fail].err{fail.refused(res_arr.err)}; }
    val arr: *u8 = res_arr.ok;

    var i: u32 = 0;
    for (i < len::u32) {
        arr[i] = sema_context.TYPE_MEMO_NONE;
        i      = i + 1;
    }
    ret res[*u8, fail.Fail].ok{arr};
}

fun dnit_context(sc: *sema_context.SemaContext) {
    if (sc.view.expr_type != nil && sc.view.a.exprs.len > 0) {
        A.deallocate[type_kind.TypeId](sc.s.alloc, sc.view.expr_type, sc.view.a.exprs.len);
    }
    if (sc.view.guard_case != nil && sc.view.a.exprs.len > 0) {
        A.deallocate[u32](sc.s.alloc, sc.view.guard_case, sc.view.a.exprs.len);
    }
    if (sc.view.type_resolved_ty != nil && sc.view.a.types.len > 0) {
        A.deallocate[type_kind.TypeId](sc.s.alloc, sc.view.type_resolved_ty, sc.view.a.types.len);
    }
    if (sc.view.decl_type != nil && sc.view.a.decls.len > 0) {
        A.deallocate[type_kind.TypeId](sc.s.alloc, sc.view.decl_type, sc.view.a.decls.len);
    }
    if (sc.view.type_resolved_memo != nil && sc.view.a.types.len > 0) {
        A.deallocate[u8](sc.s.alloc, sc.view.type_resolved_memo, sc.view.a.types.len);
    }
    if (sc.view.layout_state != nil && sc.view.a.decls.len > 0) {
        A.deallocate[u8](sc.s.alloc, sc.view.layout_state, sc.view.a.decls.len);
    }
    if (sc.view.constant_state != nil && sc.view.a.decls.len > 0) {
        A.deallocate[u8](sc.s.alloc, sc.view.constant_state, sc.view.a.decls.len);
    }
    if (sc.view.constant_node != nil && sc.view.a.decls.len > 0) {
        A.deallocate[comptime_deep.Node](sc.s.alloc, sc.view.constant_node, sc.view.a.decls.len);
    }
    if (sc.view.inferred_len != nil && sc.view.a.types.len > 0) {
        A.deallocate[u64](sc.s.alloc, sc.view.inferred_len, sc.view.a.types.len);
    }
    if (sc.view.embed_paths != nil && sc.view.embed_path_cap > 0) {
        A.deallocate[intern.StrId](sc.s.alloc, sc.view.embed_paths, sc.view.embed_path_cap::usize);
    }
    sc.view.inferred_len       = nil;
    sc.view.embed_paths        = nil;
    sc.view.embed_path_len     = 0;
    sc.view.embed_path_cap     = 0;
    sc.view.expr_type          = nil;
    sc.view.guard_case         = nil;
    sc.view.type_resolved_ty   = nil;
    sc.view.type_resolved_memo = nil;
    sc.view.layout_state       = nil;
    sc.view.constant_state     = nil;
    sc.view.constant_node      = nil;
    sc.view.decl_type          = nil;
    sema_context.inst_worklist_dnit(sc);
}

# every annotation's check shares one walk, so a type that several annotations reach, as a
# chain of defs each over the one before does, is walked once rather than once per annotation
fun check_annotation_uni_secrecy_all(sc: *sema_context.SemaContext) {
    if (!sc.typing.has_secret)           { ret; }
    if (sc.view.type_resolved_ty == nil) { ret; }
    var walk: sema_context.SecrecyWalk;
    variant.walk_begin(sc, ?walk);
    var i: u32 = 0;
    for (i < sc.view.a.types.len::u32) {
        variant.check_annotation_uni_secrecy(sc, ?walk, ast_id.type(i));
        i = i + 1;
    }
    variant.walk_end(sc, ?walk);
}

fun resolve_all_types(sc: *sema_context.SemaContext) err[fail.Fail] {
    if (sc.view.type_resolved_ty == nil) { ret err[fail.Fail].ok{}; }
    val outer: sema_context.Walk = sema_context.walk_begin(sc);
    sc.walk.type_prepass = true;
    var i: u32 = 0;
    for (i < sc.view.a.types.len::u32) {
        sc.view.type_resolved_ty[i] = sema_declared.resolve_type_ref(sc, ast_id.type(i));
        i                           = i + 1;
    }
    sema_context.walk_end(sc, outer);
    ret err[fail.Fail].ok{};
}

fun resolve_all_embeds(sc: *sema_context.SemaContext) err[fail.Fail] {
    val opt_module: opt[*ast_module.Module] = ast.get_module(sc.view.a, sc.view.a.root_module);
    if (!sel opt_module.some) {
        ret err[fail.Fail].err{fail.message("root_module is not set on this Ast")};
    }
    val mnode: *ast_module.Module = opt_module.some;
    ret resolve_embeds_in_list(sc, mnode.decls_start, mnode.decls_len);
}

fun resolve_embeds_in_list(sc: *sema_context.SemaContext, start: u32, len: u32) err[fail.Fail] {
    var i: u32 = 0;
    for (i < len) {
        val did:                    ast_id.DeclId  = sc.view.a.decl_ids.data[start + i];
        val err_resolve_embeds_one: err[fail.Fail] = resolve_embeds_one(sc, did);
        if (sel err_resolve_embeds_one.err) { ret err_resolve_embeds_one; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# resolves the `embed` on the declaration `did`, or on each declaration of the arm a
# declaring `$if` takes
fun resolve_embeds_one(sc: *sema_context.SemaContext, did: ast_id.DeclId) err[fail.Fail] {
    val opt_decl: opt[*ast_decl.Decl] = ast.get_decl(sc.view.a, did);
    if (!sel opt_decl.some) { ret err[fail.Fail].err{fail.message("DeclId out of range")}; }
    val d: *ast_decl.Decl = opt_decl.some;
    if (stack.exhausted()) {
        sema_context.refuse_nesting(sc, d.span);
        ret err[fail.Fail].ok{};
    }

    if (d.kind == ast_decl.DECL_KIND_COMPTIME_IF) {
        val ci:          *ast_decl.DeclComptimeIf = ?d.data.comptime_if;
        val opt_nothing: opt[bool]                = chain_declares_nothing(sc, ci, d.span);
        if (!sel opt_nothing.some) { ret err[fail.Fail].ok{}; }
        if (opt_nothing.some)      { ret err[fail.Fail].ok{}; }
        var b: u32 = 0;
        for (b < ci.branches_len) {
            val br:         *ast_decl.ComptimeBranch = ?sc.view.a.comptime_branches.data[ci.branches_start + b];
            val res_active: res[bool, fail.Fail]     = comptime_branch_active(sc, br);
            if (sel res_active.err) { ret err[fail.Fail].err{res_active.err}; }
            if (res_active.ok) {
                ret resolve_embeds_in_list(sc, br.body_start, br.body_len);
            }
            b = b + 1;
        }
        ret err[fail.Fail].ok{};
    }

    # a second `embed` is refused by its registry row
    val opt_embed: opt[*ast_decl.Decorator] = decorator.get(sc.view.a, d, decorator.EMBED);
    if (sel opt_embed.none) { ret err[fail.Fail].ok{}; }
    ret sema_embed.resolve_one(sc, did, d, opt_embed.some);
}

fun infer_all_decls(sc: *sema_context.SemaContext) err[fail.Fail] {
    if (sc.view.decl_type == nil) { ret err[fail.Fail].ok{}; }
    val opt_module: opt[*ast_module.Module] = ast.get_module(sc.view.a, sc.view.a.root_module);
    if (!sel opt_module.some) {
        ret err[fail.Fail].err{fail.message("root_module is not set on this Ast")};
    }
    val mnode: *ast_module.Module = opt_module.some;
    ret infer_decls_in_list(sc, mnode.decls_start, mnode.decls_len);
}

# binds every module constant no earlier read bound, once every declaration is typed, so
# each is bound before any body or instance reads it
fun bind_all_constants(sc: *sema_context.SemaContext) err[fail.Fail] {
    val opt_module: opt[*ast_module.Module] = ast.get_module(sc.view.a, sc.view.a.root_module);
    if (!sel opt_module.some) { ret err[fail.Fail].err{fail.message("root_module is not set on this Ast")}; }
    val err_bound: err[fail.Fail] = bind_constants_in_list(sc, opt_module.some.decls_start, opt_module.some.decls_len);
    sema_constant.settle(sc);
    ret err_bound;
}

fun bind_constants_in_list(sc: *sema_context.SemaContext, start: u32, len: u32) err[fail.Fail] {
    var i: u32 = 0;
    for (i < len) {
        val did:      ast_id.DeclId       = sc.view.a.decl_ids.data[start + i];
        val opt_decl: opt[*ast_decl.Decl] = ast.get_decl(sc.view.a, did);
        if (!sel opt_decl.some) { ret err[fail.Fail].err{fail.message("DeclId out of range")}; }
        val d: *ast_decl.Decl = opt_decl.some;
        if (d.kind == ast_decl.DECL_KIND_COMPTIME_IF && stack.exhausted()) { sema_context.refuse_nesting(sc, d.span); }
        or (d.kind == ast_decl.DECL_KIND_COMPTIME_IF) {
            val res_arm: res[opt[*ast_decl.ComptimeBranch], fail.Fail] = declaring_arm(sc, ?d.data.comptime_if, d.span);
            if (sel res_arm.err) { ret err[fail.Fail].err{res_arm.err}; }
            val opt_taken: opt[*ast_decl.ComptimeBranch] = res_arm.ok;
            if (sel opt_taken.some) {
                val err_inner: err[fail.Fail] = bind_constants_in_list(sc, opt_taken.some.body_start, opt_taken.some.body_len);
                if (sel err_inner.err) { ret err_inner; }
            }
        }
        or (d.kind == ast_decl.DECL_KIND_VAL) {
            val err_one: err[fail.Fail] = sema_constant.bind(sc, did);
            if (sel err_one.err) { ret err_one; }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# the arm of a declaring chain the gates already decided to take, none when no arm declares
# anything or none is taken
fun declaring_arm(sc: *sema_context.SemaContext, ci: *ast_decl.DeclComptimeIf, span: base_source.Span) res[opt[*ast_decl.ComptimeBranch], fail.Fail] {
    val opt_nothing: opt[bool] = chain_declares_nothing(sc, ci, span);
    if (!sel opt_nothing.some) { ret res[opt[*ast_decl.ComptimeBranch], fail.Fail].ok{opt[*ast_decl.ComptimeBranch].none{}}; }
    if (opt_nothing.some) {
        ret res[opt[*ast_decl.ComptimeBranch], fail.Fail].ok{opt[*ast_decl.ComptimeBranch].none{}};
    }
    var i: u32 = 0;
    for (i < ci.branches_len) {
        val br: *ast_decl.ComptimeBranch = ?sc.view.a.comptime_branches.data[ci.branches_start + i];
        if (!ast_id.expr_is_nil(br.cond) && comptime_scope.gate_state(sc.view.ctx, br.cond) == comptime_scope.GATE_STATE_UNKNOWN) {
            ret res[opt[*ast_decl.ComptimeBranch], fail.Fail].ok{opt[*ast_decl.ComptimeBranch].none{}};
        }
        val res_active: res[bool, fail.Fail] = comptime_branch_active(sc, br);
        if (sel res_active.err) { ret res[opt[*ast_decl.ComptimeBranch], fail.Fail].err{res_active.err}; }
        if (res_active.ok)      { ret res[opt[*ast_decl.ComptimeBranch], fail.Fail].ok{opt[*ast_decl.ComptimeBranch].some{br}}; }
        i = i + 1;
    }
    ret res[opt[*ast_decl.ComptimeBranch], fail.Fail].ok{opt[*ast_decl.ComptimeBranch].none{}};
}

fun decl_gate_verdict(sc: *sema_context.SemaContext, cond: ast_id.ExprId) res[comptime_gate.GateVerdict, fail.Fail] {
    ret comptime_gate.evaluate_gate[sema_context.SemaContext](sc.view.ctx, sc, sc.typing.caps, sc.view.a, sc.view.source, cond,
        sc.s.interner, comptime_gate.GATE_SCOPE_DECL, true);
}

# the verdict on a declaring gate, which sema is the last to give: one it cannot decide is
# refused here, and lowering reads the verdict
fun decl_gate_is_active(sc: *sema_context.SemaContext, cond: ast_id.ExprId) res[bool, fail.Fail] {
    val res_decl_gate_verdict: res[comptime_gate.GateVerdict, fail.Fail] = decl_gate_verdict(sc, cond);
    if (sel res_decl_gate_verdict.err) {
        ret res[bool, fail.Fail].err{res_decl_gate_verdict.err};
    }
    val v: comptime_gate.GateVerdict = res_decl_gate_verdict.ok;
    if (v.outcome != comptime_gate.GATE_ACTIVE && v.outcome != comptime_gate.GATE_INACTIVE && str_len(v.message) > 0) {
        sema_context.report(sc, v.diag, v.span, v.message);
    }
    ret res[bool, fail.Fail].ok{v.outcome == comptime_gate.GATE_ACTIVE};
}

fun infer_decls_in_list(sc: *sema_context.SemaContext, start: u32, len: u32) err[fail.Fail] {
    var i: u32 = 0;
    for (i < len) {
        val did:      ast_id.DeclId  = sc.view.a.decl_ids.data[start + i];
        val err_decl: err[fail.Fail] = infer_one_decl(sc, did);
        if (sel err_decl.err) { ret err_decl; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun infer_one_decl(sc: *sema_context.SemaContext, did: ast_id.DeclId) err[fail.Fail] {
    val opt_decl: opt[*ast_decl.Decl] = ast.get_decl(sc.view.a, did);
    if (!sel opt_decl.some) { ret err[fail.Fail].err{fail.message("DeclId out of range")}; }
    val d: *ast_decl.Decl = opt_decl.some;
    if (stack.exhausted()) {
        sema_context.refuse_nesting(sc, d.span);
        ret err[fail.Fail].ok{};
    }

    if (d.kind == ast_decl.DECL_KIND_COMPTIME_IF) {
        ret infer_decls_comptime_if(sc, ?d.data.comptime_if, d.span);
    }

    val ty: type_kind.TypeId = infer.infer_decl(sc, did);
    sema_context.decl_type_set(sc, did, ty);
    ret err[fail.Fail].ok{};
}

fun infer_decls_comptime_if(sc: *sema_context.SemaContext, ci: *ast_decl.DeclComptimeIf, span: base_source.Span) err[fail.Fail] {
    val opt_nothing: opt[bool] = chain_declares_nothing(sc, ci, span);
    if (!sel opt_nothing.some) { ret err[fail.Fail].ok{}; }
    if (opt_nothing.some) {
        ret err[fail.Fail].ok{};
    }
    var i: u32 = 0;
    for (i < ci.branches_len) {
        val br: *ast_decl.ComptimeBranch = ?sc.view.a.comptime_branches.data[ci.branches_start + i];
        # a gate load or resolve already decided is typed too, so every typing rule covers it
        if (!ast_id.expr_is_nil(br.cond) && comptime_scope.gate_state(sc.view.ctx, br.cond) != comptime_scope.GATE_STATE_REJECTED) {
            if (!sema_stmt.gate_condition_check(sc, br.cond)) { ret err[fail.Fail].ok{}; }
        }
        val res_active: res[bool, fail.Fail] = comptime_branch_active(sc, br);
        if (sel res_active.err) { ret err[fail.Fail].err{res_active.err}; }
        if (res_active.ok) {
            ret infer_decls_in_list(sc, br.body_start, br.body_len);
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun infer_all_bodies(sc: *sema_context.SemaContext) err[fail.Fail] {
    if (sc.view.decl_type == nil) { ret err[fail.Fail].ok{}; }
    val opt_module: opt[*ast_module.Module] = ast.get_module(sc.view.a, sc.view.a.root_module);
    if (!sel opt_module.some) {
        ret err[fail.Fail].err{fail.message("root_module is not set on this Ast")};
    }
    val mnode: *ast_module.Module = opt_module.some;
    ret infer_bodies_in_list(sc, mnode.decls_start, mnode.decls_len);
}

fun infer_bodies_in_list(sc: *sema_context.SemaContext, start: u32, len: u32) err[fail.Fail] {
    var i: u32 = 0;
    for (i < len) {
        val did:      ast_id.DeclId  = sc.view.a.decl_ids.data[start + i];
        val err_body: err[fail.Fail] = infer_one_body(sc, did);
        if (sel err_body.err) { ret err_body; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# reports a pack parameter on a function with no body
fun pack_on_import_check(sc: *sema_context.SemaContext, d: *ast_decl.Decl) {
    var i: u32 = 0;
    for (i < d.data.fun_.params_len) {
        val tn:    *ast_decl.TypedName = ?sc.view.a.typed_names.data[d.data.fun_.params_start + i];
        val opt_t: opt[*ast_type.Type] = ast.get_type(sc.view.a, tn.ty);
        if (sel opt_t.some) {
            if (opt_t.some.kind == ast_type.TYPE_KIND_PACK) {
                sema_context.report_note(sc, diagnostic_kind.PACK_BODYLESS, d.span,
                    "a comptime variadic pack `...` cannot appear on a body-less `fun`",
                    "a pack has one instance per call site, so no foreign library can export it. for a C function declared with `...`, write `ext fun f(a: T, ...)`");
                ret;
            }
        }
        i = i + 1;
    }
}

# an `ext fun` names one foreign symbol, so it has no body and no instances
fun ext_fun_check(sc: *sema_context.SemaContext, d: *ast_decl.Decl) {
    if (!ast_id.stmt_is_nil(d.data.fun_.body)) {
        sema_context.report(sc, diagnostic_kind.EXT_FUN_BODY, d.span, "an `ext fun` declares a foreign import and cannot have a body");
        ret;
    }
    var comptime_param: bool = false;
    var i:              u32  = 0;
    for (i < d.data.fun_.params_len) {
        if (sc.view.a.typed_names.data[d.data.fun_.params_start + i].comptime) { comptime_param = true; }
        i = i + 1;
    }
    if (d.data.fun_.generics_len > 0 || comptime_param) {
        sema_context.report_note(sc, diagnostic_kind.EXT_GENERIC, d.span,
            "an `ext fun` cannot take type or comptime parameters",
            "each instance would be a function of its own, so no foreign library can export it. declare one `ext fun` per foreign function");
        ret;
    }
    pack_on_import_check(sc, d);
}

fun infer_one_body(sc: *sema_context.SemaContext, did: ast_id.DeclId) err[fail.Fail] {
    val opt_decl: opt[*ast_decl.Decl] = ast.get_decl(sc.view.a, did);
    if (!sel opt_decl.some) { ret err[fail.Fail].err{fail.message("DeclId out of range")}; }
    val d: *ast_decl.Decl = opt_decl.some;
    if (stack.exhausted()) {
        sema_context.refuse_nesting(sc, d.span);
        ret err[fail.Fail].ok{};
    }
    ret infer_one_body_as(sc, did, d);
}

# checks the decorators and handle rules of the declaration `d` and types its body, its
# initializer, or the declarations of the arm a module `$if` takes
fun infer_one_body_as(sc: *sema_context.SemaContext, did: ast_id.DeclId, d: *ast_decl.Decl) err[fail.Fail] {
    sema_decorator.infer_decorator_args(sc, d);
    sema_decorator.validate_decorators(sc, did, d);
    sema_handle.check_handle_decl(sc, did, d);
    sema_handle.check_handle_signature(sc, d);
    abitype.check_abi_type_placement(sc, did, d);

    if (d.kind == ast_decl.DECL_KIND_COMPTIME_IF) {
        ret infer_bodies_comptime_if(sc, ?d.data.comptime_if, d.span);
    }
    if (d.kind == ast_decl.DECL_KIND_FUN) {
        if ((d.flags & ast_decl.DECL_FLAG_EXT) != 0) {
            ext_fun_check(sc, d);
            ret err[fail.Fail].ok{};
        }
        if (!ast_id.stmt_is_nil(d.data.fun_.body)) {
            val ret_ty: type_kind.TypeId = sema_context.resolved_type_of(sc, d.data.fun_.return_type);
            # a generic body is judged at each instantiation, against that instance's own
            # types; the template has none to judge it by, so it types the body to fill the
            # expression table that each instance and the lowering read, and says nothing.
            # so is a body with a type its comptime parameters size, at each value instance
            val outer: sema_context.Walk = sema_context.walk_begin(sc);
            if (d.data.fun_.generics_len > 0 || sema_context.decl_value_sized(sc.view.rr, did)) { sc.walk.silent = true; }
            sc.walk.timed       = sema_declared.timed_of(sc, sc.view.ctx, sc.view.a, d);
            sc.walk.ret_written = d.data.fun_.return_type;
            val err_body: err[fail.Fail] = sema_stmt.infer_stmt(sc, d.data.fun_.body, ret_ty);
            sema_context.walk_end(sc, outer);
            ret err_body;
        }
        if (!decorator.has(sc.view.a, d, decorator.INTRINSIC)) {
            sema_context.report(sc, diagnostic_kind.FUN_BODYLESS, d.span, "a `fun` needs a body unless it is an `ext fun` or an `intrinsic`");
            ret err[fail.Fail].ok{};
        }
        pack_on_import_check(sc, d);
        ret err[fail.Fail].ok{};
    }
    if (d.kind == ast_decl.DECL_KIND_TEST) {
        val err_named: err[fail.Fail] = test_name_check(sc, d);
        if (sel err_named.err) { ret err_named; }
        if (!ast_id.stmt_is_nil(d.data.test_.body)) {
            val ret_ty: type_kind.TypeId = sema_stmt.test_return_type(sc);
            sc.walk.in_test = true;
            val err_body: err[fail.Fail] = sema_stmt.infer_stmt(sc, d.data.test_.body, ret_ty);
            sc.walk.in_test = false;
            ret err_body;
        }
        ret err[fail.Fail].ok{};
    }
    if (d.kind == ast_decl.DECL_KIND_VAL || d.kind == ast_decl.DECL_KIND_VAR) {
        if ((d.flags & ast_decl.DECL_FLAG_EXT) != 0 && !ast_id.expr_is_nil(d.data.bind.init)) {
            sema_context.report(sc, diagnostic_kind.EXT_DATA_INITIALIZER, d.span, "an `ext` data import cannot have an initializer");
            ret err[fail.Fail].ok{};
        }
        ret infer_binding_init(sc, did, d);
    }
    # a module-scope `$error` reached here sits under a chain only typing decides, and refuses
    # the module as one resolve decides does
    if (d.kind == ast_decl.DECL_KIND_COMPTIME_DIRECTIVE) {
        # one in a module whose syntax did not parse cleanly is not evaluated, as resolve does
        if (sc.view.rr != nil && !sc.view.rr.syntax_clean)                                   { ret err[fail.Fail].ok{}; }
        if (sema_stmt.eval_comptime_directive(sc, d.data.comptime_directive.target, d.span)) { ret refusal.fired(sc.typing.refusal, d.span.offset); }
        ret err[fail.Fail].ok{};
    }
    ret err[fail.Fail].ok{};
}

# a module's tests are emitted under their names, so two of one name are refused
fun test_name_check(sc: *sema_context.SemaContext, d: *ast_decl.Decl) err[fail.Fail] {
    if (sc.typing.tests == nil) { ret err[fail.Fail].ok{}; }
    val res_name: res[intern.StrId, A.Error] = intern.range_add(sc.s.interner, sc.view.source, d.data.test_.name.offset, d.data.test_.name.len);
    if (sel res_name.err) { ret err[fail.Fail].err{fail.refused(res_name.err)}; }
    val res_fresh: res[bool, A.Error] = map.insert[u32, u32](sc.typing.tests, res_name.ok::u32, 0);
    if (sel res_fresh.err) { ret err[fail.Fail].err{fail.refused(res_fresh.err)}; }
    if (!res_fresh.ok) {
        sema_context.reportf(sc, diagnostic_kind.TEST_DUPLICATE, d.data.test_.name, "duplicate test `{}` in this module", intern.text(sc.s.interner, res_name.ok));
    }
    ret err[fail.Fail].ok{};
}

# types the initializer of an annotated module binding and holds it to the declared type
fun infer_binding_init(sc: *sema_context.SemaContext, did: ast_id.DeclId, d: *ast_decl.Decl) err[fail.Fail] {
    if (ast_id.expr_is_nil(d.data.bind.init)) { ret err[fail.Fail].ok{}; }
    if (ast_id.type_is_nil(d.data.bind.ty))   { ret err[fail.Fail].ok{}; }

    val actual:   type_kind.TypeId = infer.infer_expr(sc, d.data.bind.init);
    val expected: type_kind.TypeId = sc.view.decl_type[ast_id.decl_index(did)];
    if (!type_kind.is_nil(expected) && !type_kind.is_error(expected) && !type_kind.is_error(actual)) {
        sema_stmt.check_binding(sc, expected, d.data.bind.init, actual, d.span, d.data.bind.ty);
        if (d.kind == ast_decl.DECL_KIND_VAL && sema_context.is_case_literal(sc, d.data.bind.init)) {
            ret rebind_constant_tag(sc, d, expected);
        }
    }
    ret err[fail.Fail].ok{};
}

# name resolution bound a case-literal `val` as an untyped constant element; the checked type lets
# a nested payload read name its member types
fun rebind_constant_tag(sc: *sema_context.SemaContext, d: *ast_decl.Decl, ty: type_kind.TypeId) err[fail.Fail] {
    val res_name: res[intern.StrId, A.Error] = intern.range_add(sc.s.interner, sc.view.source, d.data.bind.name.offset, d.data.bind.name.len);
    if (sel res_name.err) { ret err[fail.Fail].err{fail.refused(res_name.err)}; }
    val name:      intern.StrId                   = res_name.ok;
    val opt_bound: opt[comptime_scope.NamedConst] = comptime_scope.lookup_constant(sc.view.ctx, name);
    if (!sel opt_bound.some) { ret err[fail.Fail].ok{}; }
    val nc: comptime_scope.NamedConst = opt_bound.some;
    if (nc.value.kind != comptime_value.CT_KIND_CONST_ELEM || nc.value.data.celem.elem != d.data.bind.init::u32) { ret err[fail.Fail].ok{}; }
    if (nc.value.data.celem.ty == ty::u32)                                                                       { ret err[fail.Fail].ok{}; }
    var elem: comptime_value.CTValue = comptime_value.const_elem_value(d.data.bind.init::u32, ty::u32);
    elem.secret = sema_context.holds_secret(sc, ty);
    ret comptime_scope.bind(sc.view.ctx, name, elem);
}

# types the bodies under a chain that declares nothing, deciding each gate in turn
fun infer_bodies_deferred_chain(sc: *sema_context.SemaContext, ci: *ast_decl.DeclComptimeIf) err[fail.Fail] {
    var i: u32 = 0;
    for (i < ci.branches_len) {
        val br: *ast_decl.ComptimeBranch = ?sc.view.a.comptime_branches.data[ci.branches_start + i];
        if (ast_id.expr_is_nil(br.cond)) {
            ret infer_bodies_in_list(sc, br.body_start, br.body_len);
        }
        val res_cond: res[ast_expr.Expr, fail.Fail] = sema_context.expression(sc, br.cond);
        if (sel res_cond.err) { ret err[fail.Fail].err{fail.message("comptime branch cond ExprId out of range")}; }
        val cond_span: base_source.Span = res_cond.ok.span;

        val outer: sema_context.Walk = sema_context.walk_begin(sc);
        sc.walk.in_comptime_gate = true;
        val res_decided: res[opt[comptime_gate.GateVerdict], fail.Fail] = sema_stmt.deferred_gate_decide(sc, br.cond, cond_span);
        sema_context.walk_end(sc, outer);
        if (sel res_decided.err)     { ret err[fail.Fail].err{res_decided.err}; }
        if (sel res_decided.ok.none) { ret err[fail.Fail].ok{}; }
        val v: comptime_gate.GateVerdict = res_decided.ok.some;
        if (sema_stmt.gate_verdict_truth(v)) {
            ret infer_bodies_in_list(sc, br.body_start, br.body_len);
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun infer_bodies_comptime_if(sc: *sema_context.SemaContext, ci: *ast_decl.DeclComptimeIf, span: base_source.Span) err[fail.Fail] {
    val opt_nothing: opt[bool] = chain_declares_nothing(sc, ci, span);
    if (!sel opt_nothing.some) { ret err[fail.Fail].ok{}; }
    if (opt_nothing.some) {
        ret infer_bodies_deferred_chain(sc, ci);
    }
    var i: u32 = 0;
    for (i < ci.branches_len) {
        val br:         *ast_decl.ComptimeBranch = ?sc.view.a.comptime_branches.data[ci.branches_start + i];
        val res_active: res[bool, fail.Fail]     = comptime_branch_active(sc, br);
        if (sel res_active.err) { ret err[fail.Fail].err{res_active.err}; }
        if (res_active.ok) {
            ret infer_bodies_in_list(sc, br.body_start, br.body_len);
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# whether a declaring chain declares nothing: none when it nests deeper than the walk asking
# can descend, which is refused against the chain's `span`, and none of its arms is walked
fun chain_declares_nothing(sc: *sema_context.SemaContext, ci: *ast_decl.DeclComptimeIf, span: base_source.Span) opt[bool] {
    val res_comptime_if_declares_nothing: res[bool, fail.Fail] = comptime_gate.comptime_if_declares_nothing(sc.view.a, ci.branches_start, ci.branches_len);
    if (sel res_comptime_if_declares_nothing.err) {
        sema_context.refuse(sc, span, res_comptime_if_declares_nothing.err);
        ret opt[bool].none{};
    }
    ret opt[bool].some{res_comptime_if_declares_nothing.ok};
}

fun comptime_branch_active(sc: *sema_context.SemaContext, br: *ast_decl.ComptimeBranch) res[bool, fail.Fail] {
    if (ast_id.expr_is_nil(br.cond)) { ret res[bool, fail.Fail].ok{true}; }
    ret decl_gate_is_active(sc, br.cond);
}

fun build_result(sc: *sema_context.SemaContext) res[sema_product.SemaResult, fail.Fail] {
    if (sel sc.status.kind.internal) {
        ret res[sema_product.SemaResult, fail.Fail].err{report_phase.phase_failure(sc.status)};
    }
    # a rejected module publishes what it typed too, so its importers are checked against it
    val res_built: res[interface.Interface, fail.Fail] = publish.interface_of(sc);
    if (sel res_built.err) { ret res[sema_product.SemaResult, fail.Fail].err{res_built.err}; }
    var published: interface.Interface = res_built.ok;
    publish.refusals_report(sc, ?published);
    var roots: [3]fields.Roots;
    roots[0] = fields.Roots{data: sc.view.expr_type, len: sc.view.a.exprs.len};
    roots[1] = fields.Roots{data: sc.view.type_resolved_ty, len: sc.view.a.types.len};
    roots[2] = fields.Roots{data: sc.view.decl_type, len: sc.view.a.decls.len};
    val res_captured: res[fields.Graph, fail.Fail] = fields.capture[sema_context.SemaContext](sc.s, sc.s.alloc,
        ?roots[0], 3, fields.MATERIALIZED, sc, sema_declared.prepare_nominal_recipe);
    if (sel res_captured.err) {
        interface.dnit(?published);
        ret res[sema_product.SemaResult, fail.Fail].err{res_captured.err};
    }
    ret finish_result(sc, res_captured.ok, published);
}

# moves the module's typing, constants, instances, growth analysis and refusal into its
# result, which owns them from then on. after an internal failure it releases `graph` and
# `published` and returns the failure
fun finish_result(sc: *sema_context.SemaContext, graph: fields.Graph, published: interface.Interface) res[sema_product.SemaResult, fail.Fail] {
    if (sel sc.status.kind.internal) {
        var owned:         fields.Graph        = graph;
        var owned_surface: interface.Interface = published;
        fields.dnit(?owned);
        interface.dnit(?owned_surface);
        ret res[sema_product.SemaResult, fail.Fail].err{report_phase.phase_failure(sc.status)};
    }
    var out: sema_product.SemaResult;
    out.field_graph      = graph;
    out.interface        = published;
    out.status           = sc.status;
    out.alloc            = sc.s.alloc;
    out.expr_type        = sc.view.expr_type;
    out.guard_case       = sc.view.guard_case;
    out.type_resolved_ty = sc.view.type_resolved_ty;
    out.decl_type        = sc.view.decl_type;
    out.expr_count       = sc.view.a.exprs.len::u32;
    out.type_count       = sc.view.a.types.len::u32;
    out.decl_count       = sc.view.a.decls.len::u32;
    out.embed_paths      = sc.view.embed_paths;
    out.embed_path_count = sc.view.embed_path_len;
    out.constants        = comptime_scope.publish(sc.view.ctx);
    out.instances        = sc.typing.insts.set;
    out.has_secret       = sc.typing.has_secret;
    out.refusal          = @sc.typing.refusal;
    @sc.typing.refusal   = refusal.init(sc.s.alloc);
    # the result owns the set and the analysis now
    sc.typing.insts.set.alloc = nil;
    out.growth.alloc          = nil;
    if (sc.typing.growth != nil) {
        out.growth             = @sc.typing.growth;
        sc.typing.growth.alloc = nil;
    }

    sc.view.expr_type        = nil;
    sc.view.guard_case       = nil;
    sc.view.type_resolved_ty = nil;
    sc.view.decl_type        = nil;
    out.embed_path_cap       = sc.view.embed_path_cap;
    sc.view.embed_paths      = nil;
    sc.view.embed_path_cap   = 0;
    sc.view.embed_path_len   = 0;

    ret res[sema_product.SemaResult, fail.Fail].ok{out};
}
