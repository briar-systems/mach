# the type rules sema holds each site to: assignments, calls, indexes, members and casts
#
# each check takes the types the walk found at a site, reports a refusal there with the types
# spelled and, where one can be offered, the cast that would fix it, and answers whether the site
# holds or the type it gives. returns, conditions, shift counts and constant ranges are checked
# here too, beside the size of a type as sema measures it and the reports the other checks share.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;

use A: std.allocator;

use diagnostic_kind: mach.base.diagnostic.kind;
use mach.base.fail;
use mach.base.float;
use mach.base.intern;
use base_source: mach.base.source;
use mach.base.wide;
use mach.front.ast;
use ast_decl: mach.front.ast.decl;
use ast_expr: mach.front.ast.expr;
use ast_id:   mach.front.ast.id;
use mach.front.comptime;
use comptime_failure: mach.front.comptime.failure;
use comptime_gate:    mach.front.comptime.gate;
use comptime_value:   mach.front.comptime.value;
use mach.front.resolve;
use mach.front.sema.abitype;
use mach.front.sema.coerce;
use sema_context:  mach.front.sema.context;
use sema_instance: mach.front.sema.instance;
use sema_product:  mach.front.sema.product;
use mach.front.sema.typename;
use mach.front.transition;
use report_phase: mach.report.phase;
use mach.session.module;
use mach.type;
use type_field: mach.type.field;
use type_kind:  mach.type.kind;
use type_prim:  mach.type.prim;
use mach.type.query.deep;
use mach.type.query.extent;
use mach.type.query.reach;
use mach.type.query.secrecy;

# where an expected type was written, found only once a mismatch is reported: an annotation
# the syntax `a` holds, a parameter of the function a callee names, or a field of the record
# or union a literal head names, by its position
# ---
# none:       written nowhere a mismatch can name
# annotation: a type annotation
# parameter:  a parameter of the function a callee names
# field:      a field of the record or union a literal head names
pub tag Written: u8 {
    none;
    annotation: Annotation;
    parameter:  Member;
    field:      Member;
}

# a type annotation and the syntax that holds it
# ---
# a:  the syntax holding it, nil for none
# ty: the annotation's type node
pub rec Annotation {
    a:  *ast.Ast;
    ty: ast_id.TypeId;
}

# the function a callee expression names, or the record or union a literal's head names, and
# the position of a parameter or field in it
# ---
# callee: the callee expression, nil for a field
# head:   the literal's head, nil for a parameter
# index:  the parameter's or field's position
pub rec Member {
    callee: ast_id.ExprId;
    head:   ast_id.TypeId;
    index:  u32;
}

# an expected type written nowhere a mismatch can name
# ---
# ret: the `none` case
pub fun unwritten() Written {
    ret Written.none{};
}

# an expected type written as the annotation `ty` of the syntax `a`
# ---
# a:   the syntax holding the annotation
# ty:  the annotation's type node
# ret: the `annotation` case
pub fun annotation(a: *ast.Ast, ty: ast_id.TypeId) Written {
    ret Written.annotation{Annotation{a: a, ty: ty}};
}

# an expected type written as a parameter of the function `callee` names
# ---
# callee: the callee expression
# index:  the parameter's position
# ret:    the `parameter` case
pub fun parameter(callee: ast_id.ExprId, index: u32) Written {
    ret Written.parameter{Member{callee: callee, head: ast_id.TYPE_NIL, index: index}};
}

# an expected type written as a field of the record or union a literal's `head` names
# ---
# head:  the literal's head
# index: the field's position
# ret:   the `field` case
pub fun field(head: ast_id.TypeId, index: u32) Written {
    ret Written.field{Member{callee: ast_id.EXPR_NIL, head: head, index: index}};
}

# the annotation `w` names, none where it names none
fun written_annotation(sc: *sema_context.SemaContext, w: Written) Annotation {
    var none: Annotation = Annotation{a: nil, ty: ast_id.TYPE_NIL};
    if (sel w.annotation) { ret w.annotation; }
    var opt_sym: opt[*resolve.Symbol] = opt[*resolve.Symbol].none{};
    var index:   u32                  = 0;
    if (sel w.parameter) {
        opt_sym = sema_context.symbol_for_expr(sc, w.parameter.callee);
        index   = w.parameter.index;
    }
    if (sel w.field) {
        opt_sym = sema_context.symbol_for_type(sc, w.field.head);
        index   = w.field.index;
    }
    if (sel opt_sym.none) { ret none; }
    val sym:  *resolve.Symbol = opt_sym.some;
    var kind: resolve.SymKind = sym.kind;
    if (kind == resolve.SYM_IMPORTED)                                                  { kind = sym.definition_kind; }
    if (kind != resolve.SYM_FUN && kind != resolve.SYM_REC && kind != resolve.SYM_UNI) { ret none; }
    if (!sema_context.foreign(sc, sym) && ast_id.decl_is_nil(sym.decl))                { ret none; }
    val res_defined: res[sema_product.DefinedSymbol, fail.Fail] = sema_context.symbol_definition(sc, sym, sema_product.DEFINITION_RESOLVED);
    if (sel res_defined.err) { ret none; }
    val a:        *ast.Ast            = res_defined.ok.definition.parsed.a;
    val opt_decl: opt[*ast_decl.Decl] = ast.get_decl(a, res_defined.ok.symbol.decl);
    if (sel opt_decl.none) { ret none; }
    val d:     *ast_decl.Decl = opt_decl.some;
    var start: u32            = 0;
    var len:   u32            = 0;
    if (d.kind == ast_decl.DECL_KIND_FUN && sel w.parameter) {
        start = d.data.fun_.params_start;
        len   = d.data.fun_.params_len;
    }
    or (d.kind == ast_decl.DECL_KIND_REC && sel w.field) {
        start = d.data.rec_.fields_start;
        len   = d.data.rec_.fields_len;
    }
    or (d.kind == ast_decl.DECL_KIND_UNI && sel w.field) {
        start = d.data.uni_.fields_start;
        len   = d.data.uni_.fields_len;
    }
    if (index >= len) { ret none; }
    ret Annotation{a: a, ty: a.typed_names.data[start + index].ty};
}

# whether a value of type `actual` may be assigned where `expected` is, reporting a mismatch at
# `span` when not, its expected type spelled as `written` writes it. a case selector is never
# assignable, and an error type on either side holds
fun check_assignable(sc: *sema_context.SemaContext, expected: type_kind.TypeId, actual: type_kind.TypeId, span: base_source.Span, written: Written) bool {
    if (type_kind.is_error(expected) || type_kind.is_error(actual)) { ret true; }
    val same: bool = type_kind.same(expected, actual);
    if (type.is_case_selector(sc.s.types, actual) || (!same && type.is_case_selector(sc.s.types, expected))) {
        report(sc, diagnostic_kind.TAG_SELECTOR_VALUE, span, "a case selector is not a value and cannot be stored, assigned or passed");
        ret false;
    }
    if (same) { ret true; }

    if (coerce.is_assignable(sc, actual, expected)) { ret true; }

    var note: str = "";
    if (cast_would_compile(sc, actual, expected)) { note = "implicit numeric conversion is not allowed"; }
    or (type.timed_of(sc.s.types, expected) > type.timed_of(sc.s.types, actual) && type.is_fun_type(sc.s.types, actual)) {
        note = "a function type marked `constant_time` holds only a function declared constant time in that mode or a stronger one, and not `#[weak]`";
    }
    report_mismatch(sc, span, expected, actual, note, written);
    ret false;
}

# whether expression `eid` may be assigned where `expected` is, after a literal in it takes
# that type. a range miss or a mismatch is reported at `span`, a mismatch a numeric cast would
# fix with that cast offered
# ---
# sc:       the walk
# expected: the type expected at the site
# eid:      the expression
# actual:   the type the walk gave it
# span:     where a refusal is reported
# written:  where the expected type was written, whose spelling a mismatch names, or `unwritten()`
# ret:      true when the site holds, false when refused or the expression cannot be read
pub fun check_coercible(sc: *sema_context.SemaContext, expected: type_kind.TypeId, eid: ast_id.ExprId, actual: type_kind.TypeId, span: base_source.Span, written: Written) bool {
    val res_try_coerce_literal: res[coerce.CoerceResult, fail.Fail] = coerce.try_coerce_literal(sc, eid, expected);
    if (sel res_try_coerce_literal.err) { ret false; }
    val cr: coerce.CoerceResult = res_try_coerce_literal.ok;
    if (cr.kind == coerce.COERCE_OUT_OF_RANGE) {
        report_out_of_range(sc, span, cr);
        ret false;
    }
    if (cr.kind == coerce.COERCE_BYTES_LENGTH || cr.kind == coerce.COERCE_BYTES_ELEMENT) {
        report_bytes(sc, span, cr);
        ret false;
    }
    var have: type_kind.TypeId = actual;
    if (cr.kind == coerce.COERCE_COERCED) { have = cr.ty; }

    # a value a cast would make fit is offered that cast as the mismatch's fix
    if (!cast_would_compile(sc, have, expected) || coerce.is_assignable(sc, have, expected)) { ret check_assignable(sc, expected, have, span, written); }
    var offer:       sema_context.Offer   = sema_context.Offer{};
    val res_offered: res[bool, fail.Fail] = cast_offer(sc, expected, eid, ?offer);
    if (sel res_offered.err) { ret false; }
    val offered: bool = res_offered.ok;
    if (offered) { sc.walk.offer = ?offer; }
    val ok: bool = check_assignable(sc, expected, have, span, written);
    sc.walk.offer = nil;
    if (offered) { offer_dnit(sc, ?offer); }
    ret ok;
}

# the cast to `expected` written around expression `eid`: a suffix where the
# cast binds tighter than the expression's own form, parentheses and the
# suffix otherwise. false when no fix can be offered
fun cast_offer(sc: *sema_context.SemaContext, expected: type_kind.TypeId, eid: ast_id.ExprId, out: *sema_context.Offer) res[bool, fail.Fail] {
    val res_expr: res[ast_expr.Expr, fail.Fail] = sema_context.expression(sc, eid);
    if (sel res_expr.err) { ret res[bool, fail.Fail].err{res_expr.err}; }
    val span: base_source.Span = res_expr.ok.span;
    if (span.len == 0) { ret res[bool, fail.Fail].ok{false}; }

    val opt_type_text: opt[str] = type_text(sc, expected, span);
    if (sel opt_type_text.none) { ret res[bool, fail.Fail].ok{false}; }
    fin { type_str_free(sc, opt_type_text.some); }

    var close_fmt: str = ")::{}";
    var label_fmt: str = "parenthesize the value and cast it with `::{}`";
    out.open = "(";
    if (expr_binds_tighter_than_cast(res_expr.ok.kind)) {
        close_fmt = "::{}";
        label_fmt = "cast the value with `::{}`";
        out.open  = nil;
    }
    val opt_label: opt[str] = sema_context.text(sc, label_fmt, opt_type_text.some);
    if (sel opt_label.none) { ret res[bool, fail.Fail].ok{false}; }
    val opt_close: opt[str] = sema_context.text(sc, close_fmt, opt_type_text.some);
    if (sel opt_close.none) {
        sema_context.text_free(sc, opt_label.some);
        ret res[bool, fail.Fail].ok{false};
    }
    out.label       = opt_label.some;
    out.close       = opt_close.some;
    out.head.offset = span.offset;
    out.head.len    = 0;
    out.tail.offset = span.offset + span.len;
    out.tail.len    = 0;
    ret res[bool, fail.Fail].ok{true};
}

fun offer_dnit(sc: *sema_context.SemaContext, o: *sema_context.Offer) {
    sema_context.text_free(sc, o.label);
    sema_context.text_free(sc, o.close);
}

# whether a `::` from `from` to `to` would compile where the plain assignment does not: two
# distinct numeric types of the same secrecy, and no float conversion of a secret
fun cast_would_compile(sc: *sema_context.SemaContext, from: type_kind.TypeId, to: type_kind.TypeId) bool {
    if (type_kind.is_error(from) || type_kind.is_error(to))                     { ret false; }
    if (type_kind.same(from, to))                                               { ret false; }
    if (!type.is_numeric(sc.s.types, from) || !type.is_numeric(sc.s.types, to)) { ret false; }

    if (type.is_secret(sc.s.types, from) != type.is_secret(sc.s.types, to)) { ret false; }

    if (type.is_secret(sc.s.types, from) && cast_is_fp_conversion(sc, from, to)) { ret false; }

    ret true;
}

# the expression kinds a cast binds to without parentheses; false for every
# other kind
fun expr_binds_tighter_than_cast(k: ast_expr.ExprKind) bool {
    if (k == ast_expr.EXPR_KIND_IDENT)            { ret true; }
    if (k == ast_expr.EXPR_KIND_COMPTIME_IDENT)   { ret true; }
    if (k == ast_expr.EXPR_KIND_LIT_INT)          { ret true; }
    if (k == ast_expr.EXPR_KIND_LIT_FLOAT)        { ret true; }
    if (k == ast_expr.EXPR_KIND_LIT_CHAR)         { ret true; }
    if (k == ast_expr.EXPR_KIND_LIT_STR)          { ret true; }
    if (k == ast_expr.EXPR_KIND_LIT_NIL)          { ret true; }
    if (k == ast_expr.EXPR_KIND_CALL)             { ret true; }
    if (k == ast_expr.EXPR_KIND_INDEX)            { ret true; }
    if (k == ast_expr.EXPR_KIND_MEMBER)           { ret true; }
    if (k == ast_expr.EXPR_KIND_PROJECT)          { ret true; }
    if (k == ast_expr.EXPR_KIND_CAST)             { ret true; }
    if (k == ast_expr.EXPR_KIND_STRIP)            { ret true; }
    if (k == ast_expr.EXPR_KIND_ARRAY_LIT)        { ret true; }
    if (k == ast_expr.EXPR_KIND_STRUCT_LIT)       { ret true; }
    if (k == ast_expr.EXPR_KIND_VECTOR_LIT)       { ret true; }
    if (k == ast_expr.EXPR_KIND_GENERIC_INSTANCE) { ret true; }
    ret false;
}

# check a call's arguments against the callee's signature: the count, each fixed argument's
# type, pack spreads, and what a C-variadic or pack argument may be
# ---
# sc:         the walk
# callee:     the callee expression, whose declaration a mismatched argument's parameter
#             annotation is read from
# callee_sig: the callee's type
# args_start: the first argument in the module's expression id list
# args_len:   how many arguments
# span:       where a refusal of the callee or the count is reported
# ret:        true when the call holds or the callee's type is an error
pub fun check_call(sc: *sema_context.SemaContext, callee: ast_id.ExprId, callee_sig: type_kind.TypeId, args_start: u32, args_len: u32, span: base_source.Span) bool {
    if (type_kind.is_error(callee_sig)) { ret true; }

    val opt_fun: opt[*type.Type] = type.get(sc.s.types, callee_sig);
    if (!sel opt_fun.some) {
        report(sc, diagnostic_kind.CALL_NOT_CALLABLE, span, "the callee is not a function");
        ret false;
    }
    val fun_type: *type.Type = opt_fun.some;
    if (fun_type.kind != type_kind.TYPE_FUN) {
        report_typed(sc, diagnostic_kind.CALL_NOT_CALLABLE, span, "`", callee_sig, "` is not a function");
        ret false;
    }

    val params_len:   u32  = fun_type.data.fn.params_len;
    val params_start: u32  = fun_type.data.fn.params_start;
    val c_variadic:   bool = fun_type.data.fn.c_variadic;

    var fixed_len: u32  = params_len;
    val has_pack:  bool = params_len > 0 && param_is_pack(sc, params_start + params_len - 1);
    if (has_pack) { fixed_len = params_len - 1; }

    if (!validate_pack_spreads(sc, has_pack || c_variadic, fixed_len, args_start, args_len)) {
        ret false;
    }

    if (has_pack) {
        if (args_len < fixed_len) {
            report_arity(sc, span, fixed_len, args_len, true);
            ret false;
        }
    }
    or (c_variadic) {
        if (args_len < params_len) {
            report_arity(sc, span, params_len, args_len, true);
            ret false;
        }
    }
    or (args_len != params_len) {
        report_arity(sc, span, params_len, args_len, false);
        ret false;
    }

    var all_ok: bool = true;
    var i:      u32  = 0;
    for (i < fixed_len) {
        val opt_param_type: opt[type_kind.TypeId] = type.get_param(sc.s.types, params_start + i);
        if (!sel opt_param_type.some) {
            all_ok = false;
            brk;
        }
        val expected: type_kind.TypeId = opt_param_type.some;

        val arg_eid:          ast_id.ExprId                    = sc.view.a.expr_ids.data[args_start + i];
        val actual:           type_kind.TypeId                 = expr_type_of(sc, arg_eid);
        val res_expr_span_of: res[base_source.Span, fail.Fail] = expr_span_of(sc, arg_eid);
        if (sel res_expr_span_of.err) { ret false; }
        if (!check_coercible(sc, expected, arg_eid, actual, res_expr_span_of.ok, parameter(callee, i))) {
            all_ok = false;
        }
        i = i + 1;
    }

    if (c_variadic) {
        var vi: u32 = params_len;
        for (vi < args_len) {
            val veid:       ast_id.ExprId        = sc.view.a.expr_ids.data[args_start + vi];
            val res_spread: res[bool, fail.Fail] = arg_is_spread(sc, veid);
            if (sel res_spread.err) { ret false; }
            if (res_spread.ok) {
                if (!check_c_variadic_spread(sc, veid)) { all_ok = false; }
            }
            or (!check_variadic_value(sc, veid)) { all_ok = false; }
            or (!check_c_variadic_arg(sc, veid)) { all_ok = false; }
            vi = vi + 1;
        }
    }

    if (has_pack) {
        var pk: u32 = fixed_len;
        for (pk < args_len) {
            val parg_eid:   ast_id.ExprId        = sc.view.a.expr_ids.data[args_start + pk];
            val res_spread: res[bool, fail.Fail] = arg_is_spread(sc, parg_eid);
            if (sel res_spread.err)                  { ret false; }
            if (!check_variadic_value(sc, parg_eid)) { all_ok = false; }
            pk = pk + 1;
        }
    }
    ret all_ok;
}

# check a call to a function with comptime parameters: each comptime argument is evaluated and
# held to its parameter's type, each runtime one checked as an assignment, and a call whose
# comptime values are all decided asks for the value instance they make
# ---
# sc:         the walk
# eid:        the call, which the instance is recorded at
# callee_sig: the callee's runtime signature
# callee:     the callee expression
# f:          the callee's declaration
# args_start: the first argument in the module's expression id list
# args_len:   how many arguments
# span:       where an arity refusal is reported
# ret:        true when the call holds, or the callee's declaring syntax cannot be had
pub fun check_comptime_call(sc: *sema_context.SemaContext, eid: ast_id.ExprId, callee_sig: type_kind.TypeId, callee: ast_id.ExprId, f: *ast_decl.DeclFun, args_start: u32, args_len: u32, span: base_source.Span) bool {
    val params_ast: *ast.Ast = callee_origin_ast(sc, callee);
    if (params_ast == nil) { ret true; }

    val param_total: u32 = f.params_len;
    if (args_len != param_total) {
        report_arity(sc, span, param_total, args_len, false);
        ret false;
    }

    val opt_sig: opt[*type.Type] = type.get(sc.s.types, callee_sig);
    if (!sel opt_sig.some) { ret true; }
    val sig:      *type.Type = opt_sig.some;
    val rt_start: u32        = sig.data.fn.params_start;
    val rt_len:   u32        = sig.data.fn.params_len;

    var values: ComptimeArgs = comptime_args_init(sc, f, params_ast);
    fin { comptime_args_dnit(sc, ?values); }

    var all_ok:  bool = true;
    var i:       u32  = 0;
    var rt_seen: u32  = 0;
    for (i < param_total) {
        val tn:               *ast_decl.TypedName              = ?params_ast.typed_names.data[f.params_start + i];
        val arg_eid:          ast_id.ExprId                    = sc.view.a.expr_ids.data[args_start + i];
        val res_expr_span_of: res[base_source.Span, fail.Fail] = expr_span_of(sc, arg_eid);
        if (sel res_expr_span_of.err) { ret false; }
        val arg_span: base_source.Span = res_expr_span_of.ok;

        if (tn.comptime) {
            if (!comptime_arg_value(sc, ?values, callee, params_ast, tn, arg_eid, arg_span)) { all_ok = false; }
            i = i + 1;
            cnt;
        }

        if (rt_seen < rt_len) {
            val opt_param_type: opt[type_kind.TypeId] = type.get_param(sc.s.types, rt_start + rt_seen);
            if (sel opt_param_type.some) {
                val expected: type_kind.TypeId = opt_param_type.some;
                val actual:   type_kind.TypeId = expr_type_of(sc, arg_eid);
                if (!check_coercible(sc, expected, arg_eid, actual, arg_span, annotation(params_ast, tn.ty))) { all_ok = false; }
            }
            rt_seen = rt_seen + 1;
        }
        i = i + 1;
    }
    if (all_ok && values.complete) { record_value_instance(sc, eid, callee, callee_sig, ?values, span); }
    ret all_ok;
}

# the comptime arguments of one call, in parameter order, with the parameters they bind;
# incomplete while any is decided only at an instance of the caller
rec ComptimeArgs {
    values:   *comptime_value.CTValue;
    names:    *intern.StrId;
    len:      u32;
    cap:      u32;
    complete: bool;
}

fun comptime_args_init(sc: *sema_context.SemaContext, f: *ast_decl.DeclFun, params_ast: *ast.Ast) ComptimeArgs {
    var out: ComptimeArgs;
    out.values   = nil;
    out.names    = nil;
    out.len      = 0;
    out.cap      = 0;
    out.complete = true;
    var n: u32 = 0;
    var i: u32 = 0;
    for (i < f.params_len) {
        if (params_ast.typed_names.data[f.params_start + i].comptime) { n = n + 1; }
        i = i + 1;
    }
    if (n == 0) { ret out; }
    val res_allocate: res[*comptime_value.CTValue, A.Error] = A.allocate[comptime_value.CTValue](sc.s.alloc, n::usize);
    if (sel res_allocate.err) {
        report_phase.internal(?sc.status, fail.message("out of memory holding a call's comptime arguments"));
        out.complete = false;
        ret out;
    }
    val res_allocate_alloc: res[*intern.StrId, A.Error] = A.allocate[intern.StrId](sc.s.alloc, n::usize);
    if (sel res_allocate_alloc.err) {
        A.deallocate[comptime_value.CTValue](sc.s.alloc, res_allocate.ok, n::usize);
        report_phase.internal(?sc.status, fail.message("out of memory holding a call's comptime arguments"));
        out.complete = false;
        ret out;
    }
    out.values = res_allocate.ok;
    out.names  = res_allocate_alloc.ok;
    out.cap    = n;
    ret out;
}

fun comptime_args_dnit(sc: *sema_context.SemaContext, values: *ComptimeArgs) {
    if (values.cap == 0) { ret; }
    A.deallocate[comptime_value.CTValue](sc.s.alloc, values.values, values.cap::usize);
    A.deallocate[intern.StrId](sc.s.alloc, values.names, values.cap::usize);
    values.cap = 0;
}

# evaluates one comptime argument and holds it to its parameter's type. one that names a
# comptime parameter of the enclosing function is decided at each instance of it, where
# the walk binds that parameter, and an instance's walk reports what its template could not
fun comptime_arg_value(sc: *sema_context.SemaContext, values: *ComptimeArgs, callee: ast_id.ExprId, params_ast: *ast.Ast,
    tn: *ast_decl.TypedName, arg_eid: ast_id.ExprId, arg_span: base_source.Span) bool {
    val per_instance: bool = arg_references_comptime_param(sc, arg_eid, arg_span);
    if (per_instance && !sema_context.walk_binds_values(sc)) {
        values.complete = false;
        ret true;
    }
    val outer: sema_context.Walk = sema_context.walk_begin(sc);
    if (per_instance) { sc.walk.silent = false; }
    val ok: bool = comptime_arg_evaluate(sc, values, callee, params_ast, tn, arg_eid, arg_span);
    sema_context.walk_end(sc, outer);
    ret ok;
}

fun comptime_arg_evaluate(sc: *sema_context.SemaContext, values: *ComptimeArgs, callee: ast_id.ExprId, params_ast: *ast.Ast,
    tn: *ast_decl.TypedName, arg_eid: ast_id.ExprId, arg_span: base_source.Span) bool {
    val res_eval: res[comptime_value.CTValue, comptime_failure.EvalFail] = comptime.evaluate_at_float_width[sema_context.SemaContext](sc.view.ctx, sc, sc.typing.caps, sc.view.a, sc.view.source,
        arg_eid, sc.s.interner, expr_float_width(sc, arg_eid));
    sema_context.record_eval_result(sc, res_eval);
    if (sel res_eval.err) {
        values.complete = false;
        report_arg_refused(sc, res_eval.err, arg_span);
        ret false;
    }
    if (!check_comptime_arg_fits(sc, res_eval.ok, comptime_param_type(sc, callee, params_ast, tn.ty), arg_span)) {
        values.complete = false;
        ret false;
    }
    if (values.len >= values.cap) {
        values.complete = false;
        ret true;
    }
    val opt_text: opt[*base_source.SourceFile] = base_source.get(sc.s.sources, params_ast.file_id);
    if (sel opt_text.none) {
        report_phase.internal(?sc.status, fail.message("a comptime parameter's module has no source"));
        values.complete = false;
        ret true;
    }
    val res_name: res[intern.StrId, A.Error] = intern.range_add(sc.s.interner, opt_text.some.text, tn.name.offset, tn.name.len);
    if (sel res_name.err) {
        report_phase.internal(?sc.status, fail.message("out of memory naming a comptime parameter"));
        values.complete = false;
        ret true;
    }
    values.values[values.len] = res_eval.ok;
    values.names[values.len]  = res_name.ok;
    values.len                = values.len + 1;
    ret true;
}

# the one report of an argument the evaluator refused. a refusal that stands alone is reported as itself;
# any other refusal is a reason the generic message already states. an internal failure is recorded
fun report_arg_refused(sc: *sema_context.SemaContext, f: comptime_failure.EvalFail, span: base_source.Span) {
    if (f.kind == comptime_failure.EVAL_FAIL_INTERNAL) { ret; }
    if (comptime_failure.stands_alone(f)) {
        sema_context.report(sc, f.diag, span, f.message);
        ret;
    }
    report_note(sc, diagnostic_kind.COMPTIME_ARGUMENT_NOT_CONSTANT, span, "comptime argument is not a compile-time constant", f.message);
}

fun expr_float_width(sc: *sema_context.SemaContext, eid: ast_id.ExprId) float.FloatWidth {
    val tid: type_kind.TypeId = expr_type_of(sc, eid);
    if (type_kind.is_nil(tid) || type_kind.is_error(tid)) { ret float.FLOAT_W_NONE; }
    val ct:    type_kind.TypeId = type.strip_secret(sc.s.types, sema_context.apply_subst(sc, tid));
    val opt_t: opt[*type.Type]  = type.get(sc.s.types, ct);
    if (!sel opt_t.some) { ret float.FLOAT_W_NONE; }
    ret type_prim.float_width_of(opt_t.some.kind);
}

fun record_value_instance(sc: *sema_context.SemaContext, eid: ast_id.ExprId, callee: ast_id.ExprId, callee_sig: type_kind.TypeId,
    values: *ComptimeArgs, span: base_source.Span) {
    val opt_sym: opt[*resolve.Symbol] = sema_context.symbol_for_expr(sc, callee);
    if (!sel opt_sym.some) { ret; }
    val sym:          *resolve.Symbol                            = opt_sym.some;
    val res_acquired: res[sema_product.DefinedSymbol, fail.Fail] = sema_context.symbol_definition(sc, sym, sema_product.DEFINITION_RESOLVED);
    if (sel res_acquired.err) { ret; }
    var item: sema_instance.Instance;
    item.kind      = sema_instance.KIND_VALUE;
    item.origin    = resolve.origin_of(sc.s, sym);
    item.decl      = res_acquired.ok.symbol.decl;
    item.args      = nil;
    item.arg_len   = 0;
    item.values    = values.values;
    item.names     = values.names;
    item.value_len = values.len;
    item.pack      = nil;
    item.pack_len  = 0;
    item.bare      = sym.name;
    item.canon     = sym.canon;
    item.sig       = callee_sig;
    item.site      = span;
    val err_recorded: err[fail.Fail] = sema_context.record_instance(sc, item, eid);
    if (sel err_recorded.err) { report(sc, diagnostic_kind.COMPILER_INTERNAL, span, fail.describe(err_recorded.err)); }
}

# the declared type of a comptime parameter of `callee`, read from the module that
# declares it
fun comptime_param_type(sc: *sema_context.SemaContext, callee: ast_id.ExprId, params_ast: *ast.Ast, ty: ast_id.TypeId) type_kind.TypeId {
    if (ast_id.type_is_nil(ty) || ast_id.type_index(ty)::usize >= params_ast.types.len) { ret type_kind.TYPE_ERROR; }
    val opt_sym: opt[*resolve.Symbol] = sema_context.symbol_for_expr(sc, callee);
    if (!sel opt_sym.some) { ret type_kind.TYPE_ERROR; }
    val sym: *resolve.Symbol = opt_sym.some;
    if (!sema_context.foreign(sc, sym)) {
        if (sc.view.type_resolved_ty == nil) { ret type_kind.TYPE_ERROR; }
        ret sc.view.type_resolved_ty[ast_id.type_index(ty)];
    }
    val res_acquired: res[sema_product.DefinedSymbol, fail.Fail] = sema_context.imported_definition(sc, sym, sema_product.DEFINITION_TYPED);
    if (sel res_acquired.err) { ret type_kind.TYPE_ERROR; }
    val sr: *sema_product.SemaResult = res_acquired.ok.definition.sr;
    if (sr == nil || sr.type_resolved_ty == nil) { ret type_kind.TYPE_ERROR; }
    ret sr.type_resolved_ty[ast_id.type_index(ty)];
}

# a comptime argument's value is held to its parameter's type the way a runtime
# argument is, so one its type cannot represent is refused as an overflow
fun check_comptime_arg_fits(sc: *sema_context.SemaContext, value: comptime_value.CTValue, param_ty: type_kind.TypeId, span: base_source.Span) bool {
    val cr: coerce.CoerceResult = coerce.fit_ct_int(sc, value, param_ty);
    if (cr.kind != coerce.COERCE_OUT_OF_RANGE) { ret true; }
    report_out_of_range_kind(sc, diagnostic_kind.COMPTIME_OVERFLOW, span, cr, "comptime argument", nil);
    ret false;
}

# whether `sym` is an import of another module's `val`
pub fun imported_module_const_sym(sc: *sema_context.SemaContext, sym: *resolve.Symbol) bool {
    if (sym.kind != resolve.SYM_IMPORTED) { ret false; }
    ret sym.definition_kind == resolve.SYM_VAL;
}

# the type of an index into a value of type `object`, reporting a secret index, a secret
# address, an object that is not a pointer or array, and an index that is not an integer
# ---
# sc:     the walk
# object: the indexed value's type
# index:  the index's type
# span:   where a refusal is reported
# ret:    the element type, secret when the object is, TYPE_ERROR for an error object, or none
#         when the object cannot be indexed
pub fun check_index(sc: *sema_context.SemaContext, object: type_kind.TypeId, index: type_kind.TypeId, span: base_source.Span) opt[type_kind.TypeId] {
    if (type_kind.is_error(object)) { ret opt[type_kind.TypeId].some{type_kind.TYPE_ERROR}; }

    if (!type_kind.is_error(index) && type.is_secret(sc.s.types, index)) {
        report_note(sc, diagnostic_kind.SECRET_INDEX, span, "secret value used as a memory index",
            "index by a public value, or load the whole table without branching on the secret");
    }

    check_secret_address(sc, object, span);

    val obj_secret: bool             = type.is_secret(sc.s.types, object);
    val base_obj:   type_kind.TypeId = type.strip_secret(sc.s.types, object);

    val opt_object: opt[*type.Type] = type.get(sc.s.types, base_obj);
    if (!sel opt_object.some) {
        report(sc, diagnostic_kind.INDEX_NOT_INDEXABLE, span, "only a pointer or an array can be indexed");
        ret opt[type_kind.TypeId].none{};
    }
    val object_type: *type.Type = opt_object.some;

    var elem: type_kind.TypeId = type_kind.TYPE_NIL;
    if (object_type.kind == type_kind.TYPE_POINTER) {
        elem = object_type.data.pointer.base;
    }
    or (object_type.kind == type_kind.TYPE_ARRAY) {
        elem = object_type.data.array.base;
    }
    or (object_type.kind == type_kind.TYPE_PTR) {
        report_untyped_access(sc, span, "an index");
        ret opt[type_kind.TypeId].none{};
    }
    or (object_type.kind == type_kind.TYPE_FUN) {
        report_note(sc, diagnostic_kind.INDEX_NOT_INDEXABLE, span, "a function cannot be indexed",
            "type arguments go where a generic is called, as in `f[i64](x)`");
        ret opt[type_kind.TypeId].none{};
    }
    or {
        report(sc, diagnostic_kind.INDEX_NOT_INDEXABLE, span, "only a pointer or an array can be indexed");
        ret opt[type_kind.TypeId].none{};
    }

    if (!type_kind.is_error(index) && !type.is_integer(sc.s.types, index)) {
        report(sc, diagnostic_kind.INDEX_TYPE, span, "an index must be an integer");
    }
    if (obj_secret) { elem = secret_of(sc, elem); }
    ret opt[type_kind.TypeId].some{elem};
}

# whether a constant index `idx` lies inside the array or vector type `object`, reporting it at
# `span` when not. a pointer, or an index that is no constant, holds
pub fun check_const_index(sc: *sema_context.SemaContext, object: type_kind.TypeId, idx: ast_id.ExprId, span: base_source.Span) bool {
    val opt_element_count: opt[u32] = type.element_count(sc.s.types, object);
    if (!sel opt_element_count.some) { ret true; }

    val opt_const_index_value: opt[comptime_value.CTValue] = const_index_value(sc, idx);
    if (!sel opt_const_index_value.some) { ret true; }

    val n:  u32                    = opt_element_count.some;
    val cv: comptime_value.CTValue = opt_const_index_value.some;

    val opt_index: opt[u64] = comptime_value.ct_int_u64(cv);
    var index:     u64      = 0;
    if (sel opt_index.some)                   { index = opt_index.some; }
    if (sel opt_index.some && index < n::u64) { ret true; }

    report_index_oob(sc, span, cv, object, n);
    ret false;
}

# the count of a range `x[i, n]`: an integer comptime constant, at least one.
# absent, reported at the count, when it is not
pub fun check_range_count(sc: *sema_context.SemaContext, count: ast_id.ExprId, count_type: type_kind.TypeId) opt[u32] {
    val res_expr_span_of: res[base_source.Span, fail.Fail] = expr_span_of(sc, count);
    if (sel res_expr_span_of.err) { ret opt[u32].none{}; }
    val at: base_source.Span = res_expr_span_of.ok;
    if (!type.is_integer(sc.s.types, count_type)) {
        report(sc, diagnostic_kind.RANGE_COUNT_INVALID, at, "a range count must be an integer");
        ret opt[u32].none{};
    }
    val opt_const_index_value: opt[comptime_value.CTValue] = const_index_value(sc, count);
    if (!sel opt_const_index_value.some) {
        val res_eval: res[comptime_value.CTValue, comptime_failure.EvalFail] = comptime.evaluate[sema_context.SemaContext](sc.view.ctx, sc, sc.typing.caps, sc.view.a, sc.view.source, count, sc.s.interner);
        if (sel res_eval.err) {
            if (comptime_failure.stands_alone(res_eval.err)) {
                sema_context.report(sc, res_eval.err.diag, at, res_eval.err.message);
                ret opt[u32].none{};
            }
        }
        report_note(sc, diagnostic_kind.RANGE_COUNT_NOT_CONSTANT, at, "range count is not a comptime constant",
            "the count of `x[start, count]` must be a constant, and the start may vary");
        ret opt[u32].none{};
    }
    val opt_ct_int_u64: opt[u64] = comptime_value.ct_int_u64(opt_const_index_value.some);
    var n:              u64      = 0;
    if (sel opt_ct_int_u64.some) { n = opt_ct_int_u64.some; }
    if (comptime_value.ct_is_negative(opt_const_index_value.some)) {
        report_range_count(sc, at, opt_const_index_value.some, "is negative");
        ret opt[u32].none{};
    }
    if (!sel opt_ct_int_u64.some || n > 0xFFFFFFFF) {
        report_range_count(sc, at, opt_const_index_value.some, "is too large");
        ret opt[u32].none{};
    }
    if (n == 0) {
        report_range_count(sc, at, opt_const_index_value.some, "is empty");
        ret opt[u32].none{};
    }
    ret opt[u32].some{n::u32};
}

fun report_range_count(sc: *sema_context.SemaContext, span: base_source.Span, cv: comptime_value.CTValue, why: str) {
    var digits: [wide.FORMAT_CAP]u8;
    sema_context.reportf(sc, diagnostic_kind.RANGE_COUNT_INVALID, span, "range count {} {}", comptime_value.ct_int_text(cv, ?digits[0]), why);
}

# a constant start must keep the whole range inside an array or a vector:
# `start + count` may reach the length and not pass it. a pointer has no length
pub fun check_const_range(sc: *sema_context.SemaContext, object: type_kind.TypeId, start: ast_id.ExprId, count: u32, span: base_source.Span) bool {
    val opt_element_count: opt[u32] = type.element_count(sc.s.types, object);
    if (!sel opt_element_count.some) { ret true; }

    val opt_const_index_value: opt[comptime_value.CTValue] = const_index_value(sc, start);
    if (!sel opt_const_index_value.some) { ret true; }

    val n:  u32                    = opt_element_count.some;
    val cv: comptime_value.CTValue = opt_const_index_value.some;

    val opt_index: opt[u64] = comptime_value.ct_int_u64(cv);
    var index:     u64      = 0;
    if (sel opt_index.some)                                                    { index = opt_index.some; }
    if (sel opt_index.some && index <= n::u64 && count::u64 <= n::u64 - index) { ret true; }

    report_range_oob(sc, span, cv, count, object, n);
    ret false;
}

fun report_range_oob(sc: *sema_context.SemaContext, span: base_source.Span, cv: comptime_value.CTValue, count: u32, object: type_kind.TypeId, n: u32) {
    val opt_type_text: opt[str] = type_text(sc, object, span);
    if (sel opt_type_text.none) { ret; }
    fin { type_str_free(sc, opt_type_text.some); }
    var digits: [wide.FORMAT_CAP]u8;
    sema_context.reportf(sc, diagnostic_kind.RANGE_OUT_OF_BOUNDS, span, "range [{}, {}] is out of bounds for `{}` of length {}",
        comptime_value.ct_int_text(cv, ?digits[0]), count, opt_type_text.some, n);
}

# the integer constant expression `eid` evaluates to, none when it is nil, no constant or no integer
pub fun const_index_value(sc: *sema_context.SemaContext, eid: ast_id.ExprId) opt[comptime_value.CTValue] {
    if (ast_id.expr_is_nil(eid)) { ret opt[comptime_value.CTValue].none{}; }

    val res_evaluate: res[comptime_value.CTValue, comptime_failure.EvalFail] = comptime.evaluate[sema_context.SemaContext](sc.view.ctx, sc, sc.typing.caps, sc.view.a, sc.view.source, eid, sc.s.interner);

    sema_context.record_eval_result(sc, res_evaluate);
    if (sel res_evaluate.err) { ret opt[comptime_value.CTValue].none{}; }

    val cv: comptime_value.CTValue = res_evaluate.ok;
    if (cv.kind != comptime_value.CT_KIND_INT) { ret opt[comptime_value.CTValue].none{}; }
    ret opt[comptime_value.CTValue].some{cv};
}

# a shift whose count is a comptime constant must keep the count below the
# left operand's width: at or above it the runtime answer is the saturated
# value (0, or the sign fill), which a constant program never means
pub fun check_shift_count(sc: *sema_context.SemaContext, span: base_source.Span, lt: type_kind.TypeId, count: ast_id.ExprId) bool {
    val opt_const_index_value: opt[comptime_value.CTValue] = const_index_value(sc, count);
    if (!sel opt_const_index_value.some) { ret true; }
    val cv:   comptime_value.CTValue = opt_const_index_value.some;
    val bits: u32                    = byte_size(sc, lt, span) * 8;
    if (bits == 0) { ret true; }
    if (comptime_value.ct_is_negative(cv)) {
        var digits: [wide.FORMAT_CAP]u8;
        sema_context.reportf(sc, diagnostic_kind.SHIFT_COUNT, span, "shift count {} is negative", comptime_value.ct_int_text(cv, ?digits[0]));
        ret false;
    }
    if (cv.data.w.hi != 0 || cv.data.w.lo >= bits::u64) {
        report_shift_width(sc, span, cv, lt, bits);
        ret false;
    }
    ret true;
}

fun report_shift_width(sc: *sema_context.SemaContext, span: base_source.Span, cv: comptime_value.CTValue, lt: type_kind.TypeId, bits: u32) {
    val opt_type_text: opt[str] = type_text(sc, lt, span);
    if (sel opt_type_text.none) { ret; }
    fin { type_str_free(sc, opt_type_text.some); }
    var digits: [wide.FORMAT_CAP]u8;
    sema_context.reportf(sc, diagnostic_kind.SHIFT_COUNT, span, "shift count {} is at least the width of `{}` ({} bits)",
        comptime_value.ct_int_text(cv, ?digits[0]), opt_type_text.some, bits);
}

fun report_index_oob(sc: *sema_context.SemaContext, span: base_source.Span, cv: comptime_value.CTValue, object: type_kind.TypeId, n: u32) {
    val opt_type_text: opt[str] = type_text(sc, object, span);
    if (sel opt_type_text.none) { ret; }
    fin { type_str_free(sc, opt_type_text.some); }
    var digits: [wide.FORMAT_CAP]u8;
    sema_context.reportf(sc, diagnostic_kind.INDEX_OUT_OF_BOUNDS, span, "index {} is out of bounds for `{}` of length {}",
        comptime_value.ct_int_text(cv, ?digits[0]), opt_type_text.some, n);
}

# whether a value of type `ty` may be used as an address: a secret pointer is reported at `span`
pub fun check_secret_address(sc: *sema_context.SemaContext, ty: type_kind.TypeId, span: base_source.Span) bool {
    if (type_kind.is_error(ty))                                          { ret true; }
    if (!type.is_secret(sc.s.types, ty))                                 { ret true; }
    if (!type.is_pointer(sc.s.types, type.strip_secret(sc.s.types, ty))) { ret true; }

    report_note(sc, diagnostic_kind.SECRET_ADDRESS, span, "secret value used as a memory address",
        "address with a public pointer, or declassify the pointer with `:>T` when disclosure is intended");
    ret false;
}

# the refusal of `access` read through the untyped `ptr`, which names no type to read
pub fun report_untyped_access(sc: *sema_context.SemaContext, span: base_source.Span, access: str) {
    sema_context.reportf(sc, diagnostic_kind.PTR_UNTYPED_ACCESS, span, "{} through an untyped pointer is not allowed. cast it to a typed pointer `*T` first", access);
}

# the type of member `name` of a value of type `object`, through one pointer: a record or
# union field, or a tag payload, which needs an open guard for its case
# ---
# sc:     the walk
# object: the value's type
# name:   the member's name
# hold:   what the open guards say of this place's case
# span:   where a refusal is reported
# ret:    the member's type, secret when its container is, TYPE_ERROR for an error object, or
#         none when it is refused
pub fun check_member(sc: *sema_context.SemaContext, object: type_kind.TypeId, name: intern.StrId, hold: sema_context.Hold, span: base_source.Span) opt[type_kind.TypeId] {
    if (type_kind.is_error(object)) { ret opt[type_kind.TypeId].some{type_kind.TYPE_ERROR}; }

    check_secret_address(sc, object, span);

    val deref:            type_kind.TypeId = deref_one(sc, type.strip_secret(sc.s.types, object));
    val container_secret: bool             = type.is_secret(sc.s.types, object) || type.is_secret(sc.s.types, deref);
    val record:           type_kind.TypeId = type.strip_secret(sc.s.types, deref);

    if (type_kind.same(record, type_kind.id(type_kind.TYPE_PTR::u32))) {
        report_untyped_access(sc, span, "a member access");
        ret opt[type_kind.TypeId].none{};
    }
    if (type.is_tag(sc.s.types, record)) {
        val opt_case: opt[type_kind.TypeId] = sema_context.field_lookup(sc, record, name);
        if (!sel opt_case.some) {
            report_no_field(sc, span, name, record);
            ret opt[type_kind.TypeId].none{};
        }
        if (type_kind.is_nil(opt_case.some)) {
            report(sc, diagnostic_kind.TAG_PAYLOAD_UNEXPECTED, span, "this tag case takes no payload");
            ret opt[type_kind.TypeId].none{};
        }
        if (sel hold.none) {
            report(sc, diagnostic_kind.TAG_PAYLOAD_UNGUARDED, span, "a tag payload requires a `sel` guard for its case");
            ret opt[type_kind.TypeId].none{};
        }
        if (sel hold.ended) {
            report(sc, diagnostic_kind.TAG_PAYLOAD_UNGUARDED, span,
                "the guard for this payload ended at an assignment to a name in its place that runs before this point, so the place may name a tag no `sel` tested. test the case again, or bind the payload to a name before the assignment");
            ret opt[type_kind.TypeId].none{};
        }
        var pty: type_kind.TypeId = opt_case.some;
        if (container_secret) { pty = secret_of(sc, pty); }
        ret opt[type_kind.TypeId].some{pty};
    }
    val opt_field: opt[type_kind.TypeId] = sema_context.field_lookup(sc, record, name);
    if (sel opt_field.some) {
        var fty: type_kind.TypeId = opt_field.some;
        if (container_secret) { fty = secret_of(sc, fty); }
        ret opt[type_kind.TypeId].some{fty};
    }

    report_no_field(sc, span, name, record);
    ret opt[type_kind.TypeId].none{};
}

# check a `::` cast from `from` to `to`: numeric conversion, vector lanes, arrays and vectors of
# the same element, equal-size values, and on a logical-addressing target a pointer to or from a
# 64-bit integer. a cast that touches secrecy, a tag's representation or an ABI type is refused
# ---
# sc:   the walk
# from: the operand's type
# to:   the type cast to
# span: where a refusal is reported
# ret:  `to` when the cast holds, none when it is refused
pub fun check_cast(sc: *sema_context.SemaContext, from: type_kind.TypeId, to: type_kind.TypeId, span: base_source.Span) opt[type_kind.TypeId] {
    if (type_kind.is_error(from) || type_kind.is_error(to)) { ret opt[type_kind.TypeId].some{to}; }
    # neither side's conversion class is known while a type parameter is unsubstituted
    if (sema_context.awaits_instance(sc, from) || sema_context.awaits_instance(sc, to)) { ret opt[type_kind.TypeId].some{to}; }
    if (type.is_case_selector(sc.s.types, from) || type.is_case_selector(sc.s.types, to)) {
        report(sc, diagnostic_kind.TAG_SELECTOR_VALUE, span, "a case selector is not a value and cannot be cast");
        ret opt[type_kind.TypeId].none{};
    }
    if (type_kind.same(from, to))                  { ret opt[type_kind.TypeId].some{to}; }
    if (!check_tag_value_cast(sc, from, to, span)) { ret opt[type_kind.TypeId].none{}; }
    if (!check_abi_type_cast(sc, from, to, span))  { ret opt[type_kind.TypeId].none{}; }

    if (!check_secrecy_cast(sc, from, to, span)) { ret opt[type_kind.TypeId].none{}; }
    if (!check_timed_cast(sc, from, to, span))   { ret opt[type_kind.TypeId].none{}; }

    val from_vec: bool = type.is_vector(sc.s.types, from);
    val to_vec:   bool = type.is_vector(sc.s.types, to);
    if (from_vec && to_vec)           { ret check_vector_cast(sc, from, to, span); }
    if (from_vec && is_array(sc, to)) { ret check_array_vector_cast(sc, to, from, to, span); }
    if (to_vec && is_array(sc, from)) { ret check_array_vector_cast(sc, from, to, to, span); }

    if (type.is_u1(sc.s.types, to) && type.is_float(sc.s.types, from)) {
        report_note(sc, diagnostic_kind.CAST_INVALID, span, "a float cannot be cast to u1, because a cast to u1 tests an integer against zero",
            "compare the float, as `x != 0.0`");
        ret opt[type_kind.TypeId].none{};
    }
    if (type.is_numeric(sc.s.types, from) && type.is_numeric(sc.s.types, to)) {
        if (type.is_secret(sc.s.types, from) && cast_is_fp_conversion(sc, from, to)) {
            report_note(sc, diagnostic_kind.SECRET_VARIABLE_LATENCY, span, "secret value used as an operand of a variable-latency floating-point conversion",
                "convert public data, or declassify with `:>T` when disclosure is intended");
        }
        ret opt[type_kind.TypeId].some{to};
    }

    val size_from: u32 = byte_size(sc, from, span);
    val size_to:   u32 = byte_size(sc, to, span);
    if (size_from != 0 && size_from == size_to) {
        ret opt[type_kind.TypeId].some{to};
    }
    if (physical_address_cast(sc, from, to, size_from, size_to))                                        { ret opt[type_kind.TypeId].some{to}; }
    if (size_from != 0 && size_to != 0 && report_address_width(sc, from, to, size_from, size_to, span)) { ret opt[type_kind.TypeId].none{}; }

    report_note(sc, diagnostic_kind.CAST_INVALID, span, "invalid cast",
        "`::` casts numeric types or reinterprets equal-size values only");
    ret opt[type_kind.TypeId].none{};
}

# a cast between a typed pointer and a 64-bit integer on a target of logical addressing, whose
# pointer has no width of its own: the address of a physical pointer, which the lowering holds to
# whether the build has them (types.md, "pointers on spir-v")
fun physical_address_cast(sc: *sema_context.SemaContext, from: type_kind.TypeId, to: type_kind.TypeId, size_from: u32, size_to: u32) bool {
    if (sc.view.ctx == nil || sc.view.ctx.env.target.flat_addressing)         { ret false; }
    if (type.is_pointer(sc.s.types, from) && type.is_integer(sc.s.types, to)) { ret size_to == 8; }
    if (type.is_integer(sc.s.types, from) && type.is_pointer(sc.s.types, to)) { ret size_from == 8; }
    ret false;
}

# the refusal of a cast between an address and an integer of another width, naming the widths:
# an address converts only to and from an integer as wide as a pointer. false when the cast is not one
fun report_address_width(sc: *sema_context.SemaContext, from: type_kind.TypeId, to: type_kind.TypeId, size_from: u32, size_to: u32, span: base_source.Span) bool {
    val address_from: bool = type.is_pointer_like(sc.s.types, from) && type.is_integer(sc.s.types, to);
    val address_to:   bool = type.is_integer(sc.s.types, from) && type.is_pointer_like(sc.s.types, to);
    if (!address_from && !address_to) { ret false; }
    var int_ty:    type_kind.TypeId = to;
    var int_size:  u32              = size_to;
    var addr_size: u32              = size_from;
    if (address_to) {
        int_ty    = from;
        int_size  = size_from;
        addr_size = size_to;
    }
    val opt_int_str: opt[str] = type_text(sc, int_ty, span);
    if (sel opt_int_str.none) { ret true; }
    fin { type_str_free(sc, opt_int_str.some); }
    var opt_msg: opt[str];
    if (address_from) {
        opt_msg = sema_context.text(sc, "an address of {} bytes does not fit `{}`, an integer of {} bytes", addr_size::usize, opt_int_str.some, int_size::usize);
    }
    or {
        opt_msg = sema_context.text(sc, "`{}`, an integer of {} bytes, does not fill an address of {} bytes", opt_int_str.some, int_size::usize, addr_size::usize);
    }
    if (sel opt_msg.none) { ret true; }
    fin { sema_context.text_free(sc, opt_msg.some); }
    val opt_note: opt[str] = sema_context.text(sc, "an address converts only to and from an integer as wide as a pointer, {} bytes on this target", addr_size::usize);
    if (sel opt_note.none) { ret true; }
    fin { sema_context.text_free(sc, opt_note.some); }
    report_note(sc, diagnostic_kind.CAST_INVALID, span, opt_msg.some, opt_note.some);
    ret true;
}

# whether a value cast to `to` stands as far as constant-time modes go, reporting one that does
# not: a cast never gives a function type a mode, since nothing would check the claim, so a cast
# to a marked function type, or to an array of them, stands only where the value converts to it
# with no cast
fun check_timed_cast(sc: *sema_context.SemaContext, from: type_kind.TypeId, to: type_kind.TypeId, span: base_source.Span) bool {
    var at: type_kind.TypeId = type.strip_secret(sc.s.types, to);
    for (is_array(sc, at)) {
        val opt_found: opt[*type.Type] = type.get(sc.s.types, at);
        if (!sel opt_found.some) { ret true; }
        at = type.strip_secret(sc.s.types, opt_found.some.data.array.base);
    }
    if (type.timed_of(sc.s.types, at) == type.TIMED_NONE || coerce.is_assignable(sc, from, to)) { ret true; }
    report_note(sc, diagnostic_kind.CAST_INVALID, span, "a cast cannot give a function type a constant-time mode",
        "a function declared constant time in that mode or a stronger one converts to it with no cast");
    ret false;
}

# whether neither side of a cast between two distinct types holds a tag by value, reporting one that does
fun check_tag_value_cast(sc: *sema_context.SemaContext, from: type_kind.TypeId, to: type_kind.TypeId, span: base_source.Span) bool {
    if (type_kind.same(from, to)) { ret true; }
    val f: bool = sema_context.recover_at[bool](sc, span, reach.tag_value(sc.s, from), false);
    val t: bool = sema_context.recover_at[bool](sc, span, reach.tag_value(sc.s, to), false);
    if (sel sc.status.kind.internal) { ret false; }
    if (!f && !t)                    { ret true; }
    report(sc, diagnostic_kind.CAST_TAG_REPRESENTATION, span, "a cast cannot change the representation of a tag or an aggregate containing a tag by value");
    ret false;
}

fun check_abi_type_cast(sc: *sema_context.SemaContext, from: type_kind.TypeId, to: type_kind.TypeId, span: base_source.Span) bool {
    val f: type_kind.TypeId = type.strip_secret(sc.s.types, from);
    val t: type_kind.TypeId = type.strip_secret(sc.s.types, to);
    if (!type.is_abi_type(sc.s.types, f) && !type.is_abi_type(sc.s.types, t)) { ret true; }
    report(sc, diagnostic_kind.ABI_TYPE_OPAQUE, span, abitype.exclusion_message());
    ret false;
}

# vector `::` applies the scalar numeric rule to each lane pair; lane counts must match
fun check_vector_cast(sc: *sema_context.SemaContext, from: type_kind.TypeId, to: type_kind.TypeId, span: base_source.Span) opt[type_kind.TypeId] {
    val lanes_from: u32 = type.vector_lanes(sc.s.types, from);
    val lanes_to:   u32 = type.vector_lanes(sc.s.types, to);
    if (lanes_from != lanes_to) {
        report_note(sc, diagnostic_kind.CAST_VECTOR_SHAPE, span, "vector lane counts differ",
            "`::` converts a vector lane by lane, so both sides need the same lane count");
        ret opt[type_kind.TypeId].none{};
    }
    val opt_lane_from: opt[type_kind.TypeId] = type.prim(sc.s.types, type.vector_element(sc.s.types, from));
    val opt_lane_to:   opt[type_kind.TypeId] = type.prim(sc.s.types, type.vector_element(sc.s.types, to));
    if (!type.is_secret(sc.s.types, from)) { ret opt[type_kind.TypeId].some{to}; }
    if (sel opt_lane_from.some) {
        if (sel opt_lane_to.some) {
            if (cast_is_fp_conversion(sc, opt_lane_from.some, opt_lane_to.some)) {
                report_note(sc, diagnostic_kind.SECRET_VARIABLE_LATENCY, span, "secret value used as an operand of a variable-latency floating-point conversion",
                    "convert public data, or declassify with `:>T` when disclosure is intended");
            }
        }
    }
    ret opt[type_kind.TypeId].some{to};
}

fun is_array(sc: *sema_context.SemaContext, t: type_kind.TypeId) bool {
    val opt_found: opt[*type.Type] = type.get(sc.s.types, type.strip_secret(sc.s.types, t));
    if (!sel opt_found.some) { ret false; }
    ret opt_found.some.kind == type_kind.TYPE_ARRAY;
}

# `::` between `[N]T` and `TxN` moves the lanes as they are: the element type
# and the count are the same on both sides
fun check_array_vector_cast(sc: *sema_context.SemaContext, arr: type_kind.TypeId, vec: type_kind.TypeId, to: type_kind.TypeId, span: base_source.Span) opt[type_kind.TypeId] {
    val opt_types_entry: opt[*type.Type] = type.get(sc.s.types, type.strip_secret(sc.s.types, arr));
    if (!sel opt_types_entry.some) { ret opt[type_kind.TypeId].some{to}; }
    val at: *type.Type = opt_types_entry.some;
    if (at.data.array.count != type.vector_lanes(sc.s.types, vec)) {
        report_note(sc, diagnostic_kind.CAST_VECTOR_SHAPE, span, "array length and vector lane count differ",
            "`::` between `[N]T` and `TxN` converts lane by lane, so both sides need the same count");
        ret opt[type_kind.TypeId].none{};
    }
    val opt_lane: opt[type_kind.TypeId] = type.prim(sc.s.types, type.vector_element(sc.s.types, vec));
    var same:     bool                  = false;
    if (sel opt_lane.some) { same = type_kind.same(type.strip_secret(sc.s.types, at.data.array.base), opt_lane.some); }
    if (!same) {
        report_note(sc, diagnostic_kind.CAST_VECTOR_ELEMENT, span, "array and vector element types differ",
            "`::` between `[N]T` and `TxN` keeps the element type. convert the vector's lanes with a vector `::` first");
        ret opt[type_kind.TypeId].none{};
    }
    ret opt[type_kind.TypeId].some{to};
}

fun cast_is_fp_conversion(sc: *sema_context.SemaContext, from: type_kind.TypeId, to: type_kind.TypeId) bool {
    val sf: type_kind.TypeId = type.strip_secret(sc.s.types, from);
    val st: type_kind.TypeId = type.strip_secret(sc.s.types, to);
    if (type_kind.same(sf, st)) { ret false; }
    ret type.is_float(sc.s.types, sf) || type.is_float(sc.s.types, st);
}

# whether a cast keeps secrecy as it is: no `ptr` to or from a type that holds a secret, and no
# `^` added or dropped or left unprovable, each refusal reported at `span`
fun check_secrecy_cast(sc: *sema_context.SemaContext, from: type_kind.TypeId, to: type_kind.TypeId, span: base_source.Span) bool {
    val from_raw_ptr: bool = type_kind.same(from, type_kind.id(type_kind.TYPE_PTR::u32));
    val to_raw_ptr:   bool = type_kind.same(to, type_kind.id(type_kind.TYPE_PTR::u32));
    if ((from_raw_ptr && sema_context.recover[bool](sc, deep.contains_secret(sc.s, to), false))
        || (to_raw_ptr && sema_context.recover[bool](sc, deep.contains_secret(sc.s, from), false))) {
        report_note(sc, diagnostic_kind.SECRET_PTR_ERASE, span, "a secret-welded pointer cannot be erased to the untyped `ptr`",
            "erasing `^` to `ptr` would let a public alias read secret memory");
        ret false;
    }
    val res_allowed: res[secrecy.Verdict, fail.Fail] = secrecy.cast_allowed(sc.s, sema_context.laying_of(sc), from, to);
    if (sel res_allowed.err) {
        sema_context.refuse(sc, span, res_allowed.err);
        ret false;
    }
    val allowed: secrecy.Verdict = res_allowed.ok;
    if (allowed.agreement == secrecy.AGREE) { ret true; }
    if (allowed.agreement == secrecy.UNDECIDABLE) {
        report_secrecy(sc, diagnostic_kind.SECRET_VARIANT_UNPROVABLE, span, secrecy.UNBOUNDED_CAST_MSG, allowed, GROWTH_NOTE);
        ret false;
    }
    report_secrecy(sc, diagnostic_kind.SECRET_CAST_QUALIFIER, span, "`::` and `:~` cannot add or drop the secret qualifier `^`", allowed,
        "a public value becomes secret without a cast, and `:>T` is the only way back to public");
    ret false;
}

pub val GROWTH_NOTE: str = "a generic whose argument grows through a pointer is compared by the layout of the arguments its fields hold, and arguments that differ in size or alignment cannot be compared. give both sides arguments of the same size and alignment";

# a secrecy refusal whose message names the field its answer turned on: where the classes
# differ, or the instance that grows and what kept it from lining up with the other side
pub fun report_secrecy(sc: *sema_context.SemaContext, k: diagnostic_kind.Kind, span: base_source.Span, head: str, v: secrecy.Verdict, note: str) {
    val opt_msg: opt[str] = secrecy_text(sc, head, v, span);
    if (sel opt_msg.none) { ret; }
    fin { sema_context.text_free(sc, opt_msg.some); }
    if (note == nil) { sema_context.report(sc, k, span, opt_msg.some); }
    or               { sema_context.report_note(sc, k, span, opt_msg.some, note); }
}

fun secrecy_text(sc: *sema_context.SemaContext, head: str, v: secrecy.Verdict, span: base_source.Span) opt[str] {
    if (type_kind.is_nil(v.owner)) { ret sema_context.text(sc, "{}", head); }
    val opt_type_text: opt[str] = type_text(sc, v.owner, span);
    if (sel opt_type_text.none) { ret opt[str].none{}; }
    fin { type_str_free(sc, opt_type_text.some); }
    var name: str = "";
    if (v.field != secrecy.NO_FIELD) {
        val opt_field_at: opt[*type_field.Entry] = type.field_at(sc.s.types, type.strip_secret(sc.s.types, v.owner), v.field);
        if (sel opt_field_at.some) {
            val opt_spelled: opt[str] = intern.get(sc.s.interner, opt_field_at.some.name);
            if (sel opt_spelled.some) { name = opt_spelled.some; }
        }
    }
    if (v.agreement == secrecy.UNDECIDABLE) {
        if (str_len(name) > 0) {
            ret sema_context.text(sc, "{}. `{}` is an instance of a generic whose argument grows through a pointer, and field `{}` holds arguments of a different size or alignment on the two sides", head, opt_type_text.some, name);
        }
        ret sema_context.text(sc, "{}. `{}` is an instance of a generic whose argument grows through a pointer, and the other side holds storage of another shape there", head, opt_type_text.some);
    }
    if (str_len(name) > 0) { ret sema_context.text(sc, "{}, at field `{}` of `{}`", head, name, opt_type_text.some); }
    ret sema_context.text(sc, "{}", head);
}

# check a `:~` reinterpret from `from` to `to`, which needs two types of equal size and refuses
# what a `::` cast refuses of secrecy, tags and ABI types
# ---
# sc:   the walk
# from: the operand's type
# to:   the type reinterpreted to
# span: where a refusal is reported
# ret:  `to` when it holds, none when it is refused
pub fun check_reinterpret(sc: *sema_context.SemaContext, from: type_kind.TypeId, to: type_kind.TypeId, span: base_source.Span) opt[type_kind.TypeId] {
    if (type_kind.is_error(from) || type_kind.is_error(to)) { ret opt[type_kind.TypeId].some{to}; }
    if (type_kind.same(from, to))                           { ret opt[type_kind.TypeId].some{to}; }
    # an unsubstituted parameter has no size to compare; the instance has one
    if (sema_context.awaits_instance(sc, from) || sema_context.awaits_instance(sc, to)) { ret opt[type_kind.TypeId].some{to}; }
    if (!check_tag_value_cast(sc, from, to, span))                                      { ret opt[type_kind.TypeId].none{}; }
    if (!check_abi_type_cast(sc, from, to, span))                                       { ret opt[type_kind.TypeId].none{}; }

    if (!check_secrecy_cast(sc, from, to, span)) { ret opt[type_kind.TypeId].none{}; }
    if (!check_timed_cast(sc, from, to, span))   { ret opt[type_kind.TypeId].none{}; }

    val size_from: u32 = byte_size(sc, from, span);
    val size_to:   u32 = byte_size(sc, to, span);
    if (size_from != 0 && size_from == size_to) { ret opt[type_kind.TypeId].some{to}; }

    report_reinterpret_mismatch(sc, span, from, size_from, to, size_to);
    ret opt[type_kind.TypeId].none{};
}

# check a `ret` against the function's result type
# ---
# sc:     the walk
# fn_ret: the function's result type, nil for none
# value:  the returned value's type, nil for a bare `ret`
# span:   where a refusal is reported
# ret:    true when the return holds
pub fun check_return(sc: *sema_context.SemaContext, fn_ret: type_kind.TypeId, value: type_kind.TypeId, span: base_source.Span) bool {
    if (type_kind.is_nil(value)) {
        if (type_kind.is_nil(fn_ret) || type_kind.is_error(fn_ret)) { ret true; }
        report(sc, diagnostic_kind.RET_VALUE, span, "the function must return a value");
        ret false;
    }
    if (type_kind.is_nil(fn_ret)) {
        report(sc, diagnostic_kind.RET_VALUE, span, "the function returns no value");
        ret false;
    }
    ret check_assignable(sc, fn_ret, value, span, unwritten());
}

# check a branch or loop condition, which must be a public `u1`. a secret, a vector, a `u8`
# and any other type are refused at `span`
# ---
# sc:   the walk
# cond: the condition's type
# span: where a refusal is reported
# ret:  true when the condition holds, or its type is an error or awaits an instance
pub fun check_condition(sc: *sema_context.SemaContext, cond: type_kind.TypeId, span: base_source.Span) bool {
    if (type_kind.is_error(cond)) { ret true; }
    # whether a type parameter is a truth value is the instance's answer, not the template's
    if (sema_context.awaits_instance(sc, cond)) { ret true; }
    if (type.is_secret(sc.s.types, cond)) {
        report_note(sc, diagnostic_kind.SECRET_BRANCH, span, "secret value used as a branch condition",
            "compute without branching on it, or declassify with `:>T` when disclosure is intended");
        ret false;
    }
    if (type.is_vector(sc.s.types, cond)) {
        report_note(sc, diagnostic_kind.CONDITION_TYPE, span, "a vector is not a truth value",
            "reduce the vector, including a comparison mask, to a scalar before branching");
        ret false;
    }
    if (type.is_u1(sc.s.types, cond)) { ret true; }
    if (type.is_u8(sc.s.types, cond)) {
        refuse_form(sc, transition.CONDITION_U8, span);
        ret false;
    }
    report_note(sc, diagnostic_kind.CONDITION_TYPE, span, "a condition must have type u1",
        "comparisons and logical operators produce u1 condition values");
    ret false;
}

# form `form` of a previous major written at `span`, refused naming what this major spells
pub fun refuse_form(sc: *sema_context.SemaContext, form: transition.Form, span: base_source.Span) {
    val row: *transition.Row = transition.row(form);
    report_note(sc, row.refusal, span, row.message, row.note);
}

# form `form` refused as `refuse_form` refuses it, with `note` saying how the program came to write it
pub fun refuse_form_note(sc: *sema_context.SemaContext, form: transition.Form, span: base_source.Span, note: str) {
    val row: *transition.Row = transition.row(form);
    report_note(sc, row.refusal, span, row.message, note);
}

fun secret_of(sc: *sema_context.SemaContext, t: type_kind.TypeId) type_kind.TypeId {
    val res_intern_secret: res[type_kind.TypeId, fail.Fail] = type.intern_secret(sc.s.types, t);
    if (sel res_intern_secret.err) {
        report_phase.internal(?sc.status, res_intern_secret.err);
        ret t;
    }
    ret res_intern_secret.ok;
}

# the size of a value of `t`, 0 when it has none or does not fit 32 bits; an array is its
# element's size times every count above it, read in a loop, so an array nested through flat
# defs deeper than the stack still has its size. a measurement asked at `span` that refuses
# the input is reported there
pub fun byte_size(sc: *sema_context.SemaContext, t: type_kind.TypeId, span: base_source.Span) u32 {
    var at:    type_kind.TypeId = type.strip_secret(sc.s.types, t);
    var count: u64              = 1;
    for {
        val opt_type: opt[*type.Type] = type.get(sc.s.types, at);
        if (!sel opt_type.some)                         { ret 0; }
        if (opt_type.some.kind != type_kind.TYPE_ARRAY) { brk; }
        count = count * opt_type.some.data.array.count::u64;
        if (count > 4294967295) { ret 0; }
        at = type.strip_secret(sc.s.types, opt_type.some.data.array.base);
    }
    val total: u64 = element_size(sc, at, span)::u64 * count;
    if (total > 4294967295) { ret 0; }
    ret total::u32;
}

fun element_size(sc: *sema_context.SemaContext, t: type_kind.TypeId, span: base_source.Span) u32 {
    val opt_type: opt[*type.Type] = type.get(sc.s.types, t);
    if (!sel opt_type.some) { ret 0; }
    val tp: *type.Type         = opt_type.some;
    val k:  type_kind.TypeKind = tp.kind;
    val d:  type_prim.PrimDesc = type_prim.prim_desc(k);
    if (d.class == type_prim.PRIM_CLASS_INT || d.class == type_prim.PRIM_CLASS_FLOAT) { ret d.bits / 8; }
    if (k == type_kind.TYPE_VECTOR) {
        ret (type_prim.prim_desc(tp.data.vector.element).bits / 8) * tp.data.vector.lanes;
    }
    if (k == type_kind.TYPE_PTR || k == type_kind.TYPE_POINTER || k == type_kind.TYPE_FUN
        || k == type_kind.TYPE_HANDLE) { ret ptr_width(sc); }
    if (k == type_kind.TYPE_ABI || k == type_kind.TYPE_REC || k == type_kind.TYPE_UNI || k == type_kind.TYPE_TAG || k == type_kind.TYPE_INSTANCE) {
        val ext: extent.Extent = sema_context.recover_at[extent.Extent](sc, span, extent.of(sc.s, sema_context.laying_of(sc), t), extent.unknown(extent.CAUSE_UNKNOWN));
        if (!ext.ok) { ret 0; }
        ret ext.size;
    }
    ret 0;
}

# the spelling of type `t`, owned by the caller and released with type_str_free, or the failure
pub fun type_to_str(sc: *sema_context.SemaContext, t: type_kind.TypeId) res[str, fail.Fail] {
    ret typename.type_to_str(sc.s, t);
}

# release a spelling type_to_str returned
pub fun type_str_free(sc: *sema_context.SemaContext, owned: str) {
    typename.type_str_free(sc.s, owned);
}

# the spelling of `t`, released with `type_str_free`, for a diagnostic at `span`; a type
# nested too deep to spell is refused there, any other refusal fails the phase as an
# internal failure, and either gives none
fun type_text(sc: *sema_context.SemaContext, t: type_kind.TypeId, span: base_source.Span) opt[str] {
    val res_type_to_str: res[str, fail.Fail] = type_to_str(sc, t);
    if (sel res_type_to_str.err) {
        sema_context.refuse(sc, span, res_type_to_str.err);
        ret opt[str].none{};
    }
    ret opt[str].some{res_type_to_str.ok};
}

# report that type `record` has no field `name`
pub fun report_no_field(sc: *sema_context.SemaContext, span: base_source.Span, name: intern.StrId, record: type_kind.TypeId) {
    val opt_type_text: opt[str] = type_text(sc, record, span);
    if (sel opt_type_text.none) { ret; }
    fin { type_str_free(sc, opt_type_text.some); }
    sema_context.reportf(sc, diagnostic_kind.FIELD_UNKNOWN, span, "no such field `{}` on type {}", typename.name_str(sc.s, name), opt_type_text.some);
}

# report a diagnostic of kind `k` whose message is `prefix`, the text of `name`, then `suffix`
pub fun report_named(sc: *sema_context.SemaContext, k: diagnostic_kind.Kind, span: base_source.Span, prefix: str, name: intern.StrId, suffix: str) {
    sema_context.reportf(sc, k, span, "{}{}{}", prefix, typename.name_str(sc.s, name), suffix);
}

# report a generic type named without its `expected` type arguments
pub fun report_missing_type_args(sc: *sema_context.SemaContext, span: base_source.Span, name: intern.StrId, expected: u32) {
    var noun: str = "type arguments";
    if (expected == 1) { noun = "type argument"; }
    val opt_msg: opt[str] = sema_context.text(sc, "generic type `{}` needs {} {}, found none", typename.name_str(sc.s, name), expected::usize, noun);
    if (sel opt_msg.none) { ret; }
    fin { sema_context.text_free(sc, opt_msg.some); }
    sema_context.report_note(sc, diagnostic_kind.GENERIC_MISSING_TYPE_ARGS, span, opt_msg.some,
        "a generic declaration must be named with its type arguments");
}

# report a generic function called without its `expected` type arguments
pub fun report_missing_call_type_args(sc: *sema_context.SemaContext, span: base_source.Span, name: intern.StrId, expected: u32) {
    var noun: str = "type arguments";
    if (expected == 1) { noun = "type argument"; }
    val opt_msg: opt[str] = sema_context.text(sc, "generic function `{}` needs {} {}, found none", typename.name_str(sc.s, name), expected::usize, noun);
    if (sel opt_msg.none) { ret; }
    fin { sema_context.text_free(sc, opt_msg.some); }
    sema_context.report_note(sc, diagnostic_kind.GENERIC_MISSING_TYPE_ARGS, span, opt_msg.some,
        "a call names a generic's type arguments, as in `f[i64](x)`, and none are inferred");
}

# report a diagnostic of kind `k` whose message is `prefix`, the spelling of `t`, then `suffix`
pub fun report_typed(sc: *sema_context.SemaContext, k: diagnostic_kind.Kind, span: base_source.Span, prefix: str, t: type_kind.TypeId, suffix: str) {
    val opt_type_text: opt[str] = type_text(sc, t, span);
    if (sel opt_type_text.none) { ret; }
    fin { type_str_free(sc, opt_type_text.some); }
    sema_context.reportf(sc, k, span, "{}{}{}", prefix, opt_type_text.some, suffix);
}

# report a diagnostic of kind `k` spelling two types between `prefix`, `mid` and `suffix`, with
# a note naming their modules when two distinct types spell the same
pub fun report_typed2(sc: *sema_context.SemaContext, k: diagnostic_kind.Kind, span: base_source.Span, prefix: str, a: type_kind.TypeId, mid: str, b: type_kind.TypeId, suffix: str) {
    val opt_a_str: opt[str] = type_text(sc, a, span);
    if (sel opt_a_str.none) { ret; }
    fin { type_str_free(sc, opt_a_str.some); }
    val opt_b_str: opt[str] = type_text(sc, b, span);
    if (sel opt_b_str.none) { ret; }
    fin { type_str_free(sc, opt_b_str.some); }
    val opt_msg: opt[str] = sema_context.text(sc, "{}{}{}{}{}", prefix, opt_a_str.some, mid, opt_b_str.some, suffix);
    if (sel opt_msg.none) { ret; }
    fin { sema_context.text_free(sc, opt_msg.some); }
    report_types_pair(sc, k, span, opt_msg.some, a, b, opt_a_str.some, opt_b_str.some, "");
}

# the shapes refused as one `...` argument before its secrecy is asked: a case
# selector and an unspread pack are not values at all
fun check_variadic_value(sc: *sema_context.SemaContext, eid: ast_id.ExprId) bool {
    val res_spread: res[bool, fail.Fail] = arg_is_spread(sc, eid);
    if (sel res_spread.err) { ret false; }
    if (res_spread.ok)      { ret true; }
    val actual: type_kind.TypeId = expr_type_of(sc, eid);
    if (type_kind.is_error(actual)) { ret true; }
    val res_expr_span_of: res[base_source.Span, fail.Fail] = expr_span_of(sc, eid);
    if (sel res_expr_span_of.err) { ret false; }
    val arg_span: base_source.Span = res_expr_span_of.ok;
    if (type.is_case_selector(sc.s.types, actual)) {
        report(sc, diagnostic_kind.TAG_SELECTOR_VALUE, arg_span, "a case selector is not a value and cannot be passed to a variadic `...` argument");
        ret false;
    }
    if (type.is_pack(sc.s.types, actual)) {
        report(sc, diagnostic_kind.PACK_SPREAD, arg_span, "a variadic pack cannot be passed as one `...` argument. forward it with a spread, `va...`");
        ret false;
    }
    ret true;
}

# whether a value may be passed to a C-variadic `...`: no secret, and no float or integer
# narrower than the type C promotes it to
fun check_c_variadic_arg(sc: *sema_context.SemaContext, eid: ast_id.ExprId) bool {
    val actual: type_kind.TypeId = expr_type_of(sc, eid);
    if (type_kind.is_error(actual)) { ret true; }
    val res_expr_span_of: res[base_source.Span, fail.Fail] = expr_span_of(sc, eid);
    if (sel res_expr_span_of.err) { ret false; }
    ret c_variadic_value(sc, actual, res_expr_span_of.ok);
}

# whether a pack spread into a C-variadic `...` may be, as that many arguments each held to
# what a plain argument is. a pack instance knows its elements' types and reports what it
# finds here, since its template could not; a template's spread binds no pack yet
fun check_c_variadic_spread(sc: *sema_context.SemaContext, eid: ast_id.ExprId) bool {
    if (sc.instance.pack_types == nil) { ret true; }
    val res_expr_span_of: res[base_source.Span, fail.Fail] = expr_span_of(sc, eid);
    if (sel res_expr_span_of.err) { ret false; }
    val outer: sema_context.Walk = sema_context.walk_begin(sc);
    if (sel sc.status.kind.accepted) { sc.walk.silent = false; }
    var ok: bool = true;
    var i:  u32  = 0;
    for (i < sc.instance.pack_len && ok) {
        val actual: type_kind.TypeId = sc.instance.pack_types[i];
        if (!type_kind.is_error(actual)) { ok = c_variadic_value(sc, actual, res_expr_span_of.ok); }
        i = i + 1;
    }
    sema_context.walk_end(sc, outer);
    ret ok;
}

# whether a value of type `actual`, written at `arg_span`, may be one C-variadic argument
fun c_variadic_value(sc: *sema_context.SemaContext, actual: type_kind.TypeId, arg_span: base_source.Span) bool {
    if (sema_context.recover[bool](sc, deep.contains_secret(sc.s, actual), false)) {
        report_note(sc, diagnostic_kind.SECRET_VARIADIC, arg_span, "a secret value cannot be passed to a C-variadic `...` argument",
            "the argument has no declared type to stay `^` in, and a secret reaches a public place only declassified. write `:>T` to pass it");
        ret false;
    }

    val bare:      type_kind.TypeId = type.strip_secret(sc.s.types, actual);
    val opt_found: opt[*type.Type]  = type.get(sc.s.types, bare);
    if (!sel opt_found.some) { ret true; }
    val d: type_prim.PrimDesc = type_prim.prim_desc(opt_found.some.kind);

    if (d.class == type_prim.PRIM_CLASS_FLOAT && d.bits < 64) {
        report_typed(sc, diagnostic_kind.CALL_C_VARIADIC_PROMOTION, arg_span, "`", actual, "` is promoted to `f64` in a C-variadic argument. write the cast `x::f64`");
        ret false;
    }
    if (d.class == type_prim.PRIM_CLASS_INT && d.bits < 32) {
        report_typed(sc, diagnostic_kind.CALL_C_VARIADIC_PROMOTION, arg_span, "`", actual, "` is promoted to a 32-bit integer in a C-variadic argument. write the cast `x::i32` or `x::u32`");
        ret false;
    }
    ret true;
}

fun param_is_pack(sc: *sema_context.SemaContext, param_idx: u32) bool {
    val opt_param_type: opt[type_kind.TypeId] = type.get_param(sc.s.types, param_idx);
    if (!sel opt_param_type.some) { ret false; }
    val opt_type: opt[*type.Type] = type.get(sc.s.types, opt_param_type.some);
    if (!sel opt_type.some) { ret false; }
    ret opt_type.some.kind == type_kind.TYPE_PACK;
}

fun arg_is_spread(sc: *sema_context.SemaContext, eid: ast_id.ExprId) res[bool, fail.Fail] {
    val res_expr: res[ast_expr.Expr, fail.Fail] = sema_context.expression(sc, eid);
    if (sel res_expr.err) { ret res[bool, fail.Fail].err{res_expr.err}; }
    ret res[bool, fail.Fail].ok{res_expr.ok.kind == ast_expr.EXPR_KIND_SPREAD};
}

fun validate_pack_spreads(sc: *sema_context.SemaContext, has_pack: bool, fixed_len: u32, args_start: u32, args_len: u32) bool {
    var all_ok: bool = true;
    var i:      u32  = 0;
    for (i < args_len) {
        val arg_eid:    ast_id.ExprId        = sc.view.a.expr_ids.data[args_start + i];
        val res_spread: res[bool, fail.Fail] = arg_is_spread(sc, arg_eid);
        if (sel res_spread.err) { ret false; }
        if (res_spread.ok) {
            val res_expr_span_of: res[base_source.Span, fail.Fail] = expr_span_of(sc, arg_eid);
            if (sel res_expr_span_of.err) { ret false; }
            val arg_span: base_source.Span = res_expr_span_of.ok;
            if (type_kind.is_error(expr_type_of(sc, arg_eid))) {
                all_ok = false;
            }
            or (!has_pack) {
                report(sc, diagnostic_kind.CALL_SPREAD, arg_span, "cannot spread `...` into fixed parameters. the callee has no variadic pack parameter");
                all_ok = false;
            }
            or (i != fixed_len || args_len != fixed_len + 1) {
                report(sc, diagnostic_kind.CALL_SPREAD, arg_span, "a `...` pack spread must be the sole trailing argument, forwarding the whole pack");
                all_ok = false;
            }
        }
        i = i + 1;
    }
    ret all_ok;
}

fun arg_probe_ident_is_comptime_param(sc: *sema_context.SemaContext, eid: ast_id.ExprId) bool {
    val opt_sym: opt[*resolve.Symbol] = sema_context.symbol_for_expr(sc, eid);
    if (!sel opt_sym.some) { ret false; }
    val sym: *resolve.Symbol = opt_sym.some;
    ret sym.kind == resolve.SYM_PARAM && (sym.flags & resolve.SYM_FLAG_COMPTIME) != 0;
}

fun arg_references_comptime_param(sc: *sema_context.SemaContext, eid: ast_id.ExprId, span: base_source.Span) bool {
    if (ast_id.expr_is_nil(eid)) { ret false; }
    val res_depends: res[bool, fail.Fail] = comptime_gate.gate_depends_on[sema_context.SemaContext](sc.view.a, sc.view.source, sc,
        comptime_gate.gate_probes[sema_context.SemaContext](arg_probe_ident_is_comptime_param, nil, nil, nil, sema_context.comptime_expression),
        comptime_gate.GATE_PROBE_COMPTIME_PARAM, eid);
    if (sel res_depends.err) {
        # an argument nested deeper than the walk descends is refused under its own kind
        if (fail.kind_of(res_depends.err) == diagnostic_kind.SYNTAX_NESTING_DEPTH) { sema_context.refuse(sc, span, res_depends.err); }
        or                                                                         { report(sc, diagnostic_kind.COMPTIME_ARGUMENT_NOT_CONSTANT, span, fail.describe(res_depends.err)); }
        ret true;
    }
    ret res_depends.ok;
}

fun callee_origin_ast(sc: *sema_context.SemaContext, callee: ast_id.ExprId) *ast.Ast {
    val opt_sym: opt[*resolve.Symbol] = sema_context.symbol_for_expr(sc, callee);
    if (!sel opt_sym.some) { ret nil; }
    val sym: *resolve.Symbol = opt_sym.some;
    if (!sema_context.foreign(sc, sym)) { ret sc.view.a; }
    ret sema_context.definition_ast(sc, resolve.origin_of(sc.s, sym));
}

fun deref_one(sc: *sema_context.SemaContext, object: type_kind.TypeId) type_kind.TypeId {
    val opt_type: opt[*type.Type] = type.get(sc.s.types, object);
    if (!sel opt_type.some) { ret object; }
    val tp: *type.Type = opt_type.some;
    if (tp.kind == type_kind.TYPE_POINTER) { ret tp.data.pointer.base; }
    ret object;
}

fun ptr_width(sc: *sema_context.SemaContext) u32 {
    ret sc.view.ctx.env.target.pointer_width;
}

fun expr_type_of(sc: *sema_context.SemaContext, eid: ast_id.ExprId) type_kind.TypeId {
    if (ast_id.expr_is_nil(eid))                                         { ret type_kind.TYPE_ERROR; }
    if (sc.view.expr_type == nil || !sema_context.expr_in_view(sc, eid)) { ret type_kind.TYPE_ERROR; }
    ret sc.view.expr_type[ast_id.expr_index(eid)];
}

# the span of expression `eid`, or the failure reading it, which also fails the phase as internal
pub fun expr_span_of(sc: *sema_context.SemaContext, eid: ast_id.ExprId) res[base_source.Span, fail.Fail] {
    val res_expr: res[ast_expr.Expr, fail.Fail] = sema_context.expression(sc, eid);
    if (sel res_expr.err) { ret res[base_source.Span, fail.Fail].err{res_expr.err}; }
    ret res[base_source.Span, fail.Fail].ok{res_expr.ok.span};
}

fun report(sc: *sema_context.SemaContext, k: diagnostic_kind.Kind, span: base_source.Span, message: str) {
    sema_context.report(sc, k, span, message);
}

fun report_note(sc: *sema_context.SemaContext, k: diagnostic_kind.Kind, span: base_source.Span, message: str, note: str) {
    sema_context.report_note(sc, k, span, message, note);
}

# the expected side reads as its annotation spells it, with the type it names once where the two
# spellings differ, and the found side as the type it is
fun report_mismatch(sc: *sema_context.SemaContext, span: base_source.Span, expected: type_kind.TypeId, actual: type_kind.TypeId, note: str, written: Written) {
    if (type_kind.is_nil(actual)) {
        report_typed_note(sc, diagnostic_kind.TYPE_MISMATCH, span, "expected ", expected,
            ", found no value", "a call to a function with no return type produces no value");
        ret;
    }
    val opt_expected_str: opt[str] = type_text(sc, expected, span);
    if (sel opt_expected_str.none) { ret; }
    fin { type_str_free(sc, opt_expected_str.some); }
    val opt_actual_str: opt[str] = type_text(sc, actual, span);
    if (sel opt_actual_str.none) { ret; }
    fin { type_str_free(sc, opt_actual_str.some); }
    val spelled:     Annotation               = written_annotation(sc, written);
    val res_spelled: res[opt[str], fail.Fail] = typename.annotation_str(sc.s, spelled.a, spelled.ty);
    if (sel res_spelled.err) {
        sema_context.refuse(sc, span, res_spelled.err);
        ret;
    }
    val opt_spelled: opt[str] = res_spelled.ok;
    fin {
        if (sel opt_spelled.some) { type_str_free(sc, opt_spelled.some); }
    }
    var opt_msg: opt[str] = opt[str].none{};
    var as_is:   bool     = true;
    if (sel opt_spelled.some) {
        as_is = str_equals(opt_spelled.some, opt_expected_str.some);
        if (!as_is) { opt_msg = sema_context.text(sc, "expected {} (that is {}), found {}", opt_spelled.some, opt_expected_str.some, opt_actual_str.some); }
    }
    if (as_is)            { opt_msg = sema_context.text(sc, "expected {}, found {}", opt_expected_str.some, opt_actual_str.some); }
    if (sel opt_msg.none) { ret; }
    fin { sema_context.text_free(sc, opt_msg.some); }
    report_types_pair(sc, diagnostic_kind.TYPE_MISMATCH, span, opt_msg.some, expected, actual, opt_expected_str.some, opt_actual_str.some, note);
}

fun report_types_pair(sc: *sema_context.SemaContext, k: diagnostic_kind.Kind, span: base_source.Span, msg: str,
    a: type_kind.TypeId, b: type_kind.TypeId, a_str: str, b_str: str, note: str) {
    if (type_kind.same(a, b) || !str_equals(a_str, b_str)) {
        report_pair_plain(sc, k, span, msg, note);
        ret;
    }

    val am: intern.StrId = declaring_module_fqn(sc, a);
    val bm: intern.StrId = declaring_module_fqn(sc, b);
    if (intern.str_is_nil(am) || intern.str_is_nil(bm)) {
        report_pair_plain(sc, k, span, msg, note);
        ret;
    }
    val opt_interner_entry: opt[str] = intern.get(sc.s.interner, am);
    val opt_b_text:         opt[str] = intern.get(sc.s.interner, bm);
    if (!sel opt_interner_entry.some) {
        report_pair_plain(sc, k, span, msg, note);
        ret;
    }
    if (!sel opt_b_text.some) {
        report_pair_plain(sc, k, span, msg, note);
        ret;
    }

    val opt_text: opt[str] = sema_context.text(sc,
        "these are two different types named `{}`, the first declared in `{}` and the second in `{}`",
        a_str, opt_interner_entry.some, opt_b_text.some);
    if (sel opt_text.none) { ret; }
    fin { sema_context.text_free(sc, opt_text.some); }
    report_note(sc, k, span, msg, opt_text.some);
}

fun report_pair_plain(sc: *sema_context.SemaContext, k: diagnostic_kind.Kind, span: base_source.Span, msg: str, note: str) {
    if (str_len(note) == 0) {
        report(sc, k, span, msg);
        ret;
    }
    report_note(sc, k, span, msg, note);
}

fun declaring_module_fqn(sc: *sema_context.SemaContext, t: type_kind.TypeId) intern.StrId {
    val opt_found: opt[*type.Type] = type.get(sc.s.types, t);
    if (!sel opt_found.some) { ret intern.STR_NIL; }
    val ty: *type.Type = opt_found.some;
    if (ty.kind == type_kind.TYPE_REC || ty.kind == type_kind.TYPE_UNI || ty.kind == type_kind.TYPE_TAG) {
        ret module.module_fqn(?sc.s.modules, module.module_id_for_stable(?sc.s.modules, ty.data.nominal.owner.module));
    }
    if (ty.kind == type_kind.TYPE_INSTANCE) {
        ret declaring_module_fqn(sc, ty.data.instance.nominal);
    }
    ret intern.STR_NIL;
}

# the range refusal of a value an out-of-range coercion result describes
# a string literal its array refuses: an element other than u8, or a byte count other than the
# array's length, with the terminator offered when the literal is one byte short
fun report_bytes(sc: *sema_context.SemaContext, span: base_source.Span, cr: coerce.CoerceResult) {
    if (cr.kind == coerce.COERCE_BYTES_ELEMENT) {
        val opt_array: opt[*type.Type] = type.get(sc.s.types, cr.ty);
        if (sel opt_array.none) { ret; }
        report_typed(sc, diagnostic_kind.TYPE_MISMATCH, span, "the bytes of a string literal initialize an array of u8, not an array of `", opt_array.some.data.array.base, "`");
        ret;
    }
    var unit: str = "bytes";
    if (cr.bytes == 1) { unit = "byte"; }
    val opt_message: opt[str] = sema_context.text(sc, "the string literal holds {} {} and the array {}", cr.bytes, unit, cr.length);
    if (sel opt_message.none) { ret; }
    fin { sema_context.text_free(sc, opt_message.some); }
    var note: str = nil;
    if (cr.bytes + 1 == cr.length) { note = "end the literal with `\\0` to store a terminator"; }
    report_note(sc, diagnostic_kind.ARRAY_LITERAL_LENGTH, span, opt_message.some, note);
}

# the range refusal of a constant its typed context does not hold, with no note
pub fun report_out_of_range(sc: *sema_context.SemaContext, span: base_source.Span, cr: coerce.CoerceResult) {
    report_out_of_range_note(sc, span, cr, nil);
}

# the range refusal of a literal no context typed, which took the i64 default
pub fun report_default_out_of_range(sc: *sema_context.SemaContext, span: base_source.Span, cr: coerce.CoerceResult) {
    report_out_of_range_note(sc, span, cr,
        "an unsuffixed literal with no typed context is i64. give it a suffix (`u64`, `i128`, `u128`) or a typed context");
}

# the range refusal of a literal a cast to `to` reinterprets, which took an integer of `to`'s size
pub fun report_cast_out_of_range(sc: *sema_context.SemaContext, span: base_source.Span, cr: coerce.CoerceResult, to: type_kind.TypeId) {
    val opt_type_text: opt[str] = type_text(sc, to, span);
    if (sel opt_type_text.none) { ret; }
    fin { type_str_free(sc, opt_type_text.some); }
    val opt_note: opt[str] = sema_context.text(sc, "a cast to `{}` reinterprets an integer of its size, {} bytes", opt_type_text.some, byte_size(sc, to, span));
    if (sel opt_note.none) { ret; }
    fin { sema_context.text_free(sc, opt_note.some); }
    report_out_of_range_note(sc, span, cr, opt_note.some);
}

# the range refusal of a suffixed literal its own suffix's type does not hold
pub fun report_literal_out_of_range(sc: *sema_context.SemaContext, span: base_source.Span, cr: coerce.CoerceResult) {
    report_out_of_range_kind(sc, diagnostic_kind.LITERAL_OUT_OF_RANGE, span, cr, "literal", nil);
}

fun report_out_of_range_note(sc: *sema_context.SemaContext, span: base_source.Span, cr: coerce.CoerceResult, note: str) {
    var noun: str = "value";
    if (cr.literal) { noun = "literal"; }
    report_out_of_range_kind(sc, diagnostic_kind.CONST_OUT_OF_RANGE, span, cr, noun, note);
}

fun report_out_of_range_kind(sc: *sema_context.SemaContext, k: diagnostic_kind.Kind, span: base_source.Span, cr: coerce.CoerceResult, noun: str, note: str) {
    val opt_type_text: opt[str] = type_text(sc, cr.ty, span);
    if (sel opt_type_text.none) { ret; }
    fin { type_str_free(sc, opt_type_text.some); }
    val bounds: type_prim.IntRange = cr.bounds;

    var sign:     str = "";
    var min_sign: str = "";
    if (cr.negated)         { sign = "-"; }
    if (bounds.min_negated) { min_sign = "-"; }

    var value_digits: [wide.FORMAT_CAP]u8;
    var min_digits:   [wide.FORMAT_CAP]u8;
    var max_digits:   [wide.FORMAT_CAP]u8;
    val opt_msg:      opt[str] = sema_context.text(sc, "{} {}{} is out of range for {} ({}{}..{})",
        noun, sign, wide.text_u(cr.value, ?value_digits[0]), opt_type_text.some, min_sign,
        wide.text_u(bounds.min_mag, ?min_digits[0]), wide.text_u(bounds.max_mag, ?max_digits[0]));
    if (sel opt_msg.none) { ret; }
    fin { sema_context.text_free(sc, opt_msg.some); }
    if (note == nil) { report(sc, k, span, opt_msg.some); }
    or               { report_note(sc, k, span, opt_msg.some, note); }
}

fun report_typed_note(sc: *sema_context.SemaContext, k: diagnostic_kind.Kind, span: base_source.Span, prefix: str, t: type_kind.TypeId, suffix: str, note: str) {
    val opt_type_text: opt[str] = type_text(sc, t, span);
    if (sel opt_type_text.none) { ret; }
    fin { type_str_free(sc, opt_type_text.some); }
    val opt_msg: opt[str] = sema_context.text(sc, "{}{}{}", prefix, opt_type_text.some, suffix);
    if (sel opt_msg.none) { ret; }
    fin { sema_context.text_free(sc, opt_msg.some); }
    report_note(sc, k, span, opt_msg.some, note);
}

fun report_arity(sc: *sema_context.SemaContext, span: base_source.Span, expected: u32, actual: u32, at_least: bool) {
    var atleast: str = "";
    if (at_least) { atleast = "at least "; }
    var noun: str = "arguments";
    if (expected == 1) { noun = "argument"; }
    sema_context.reportf(sc, diagnostic_kind.CALL_ARITY, span, "expected {}{} {}, found {}", atleast, expected::usize, noun, actual::usize);
}

fun report_reinterpret_mismatch(sc: *sema_context.SemaContext, span: base_source.Span, from: type_kind.TypeId, size_from: u32, to: type_kind.TypeId, size_to: u32) {
    val opt_from_str: opt[str] = type_text(sc, from, span);
    if (sel opt_from_str.none) { ret; }
    fin { type_str_free(sc, opt_from_str.some); }
    val opt_to_str: opt[str] = type_text(sc, to, span);
    if (sel opt_to_str.none) { ret; }
    fin { type_str_free(sc, opt_to_str.some); }
    val opt_msg: opt[str] = sema_context.text(sc, "a bit reinterpret needs types of equal size, found {} of {} bytes and {} of {} bytes",
        opt_from_str.some, size_from::usize, opt_to_str.some, size_to::usize);
    if (sel opt_msg.none) { ret; }
    fin { sema_context.text_free(sc, opt_msg.some); }
    report_types_pair(sc, diagnostic_kind.CAST_REINTERPRET_SIZE, span, opt_msg.some, from, to, opt_from_str.some, opt_to_str.some, "");
}
