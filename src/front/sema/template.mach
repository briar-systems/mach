# the template part of a module's interface: what an importer's lowering reads to emit an
# instance of one of the module's generic, comptime-parameter or pack functions. it holds an
# owned copy of the module's syntax, its resolution, its typing and the constants each stage
# bound, every node at the id it has in the module, so an importer's instance typing, keyed by
# those ids, reads against it. a module with no such function holds none
use std.types.bool.bool;
use std.collections.map;
use std.text.string.str_free;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use types_string: std.types.string;
use std.types.string.str;
use std.types.string.str_copy;

use A: std.allocator;

use mach.base.fail;
use base_source: mach.base.source;
use mach.front.ast;
use comptime_scope: mach.front.comptime.scope;
use mach.front.resolve;
use type_kind: mach.type.kind;

# the module's own typing of its syntax, by node id
pub rec Typing {
    expr_type:        *type_kind.TypeId;
    type_resolved_ty: *type_kind.TypeId;
    decl_type:        *type_kind.TypeId;
    expr_count:       u32;
    type_count:       u32;
    decl_count:       u32;
}

# load, resolved, typed: the constants and decisions the load, resolve and sema stages bound
# env: the build and module the module's comptime reads
pub rec Template {
    alloc:    *A.Allocator;
    present:  bool;
    a:        ast.Ast;
    source:   str;
    rr:       resolve.ResolveResult;
    typing:   Typing;
    load:     comptime_scope.Bindings;
    resolved: comptime_scope.Bindings;
    typed:    comptime_scope.Bindings;
    env:      comptime_scope.ComptimeEnv;
}

# the template of a module with no generic, comptime-parameter or pack function: empty
# tables and `present` false
# ---
# alloc: the allocator its empty tables are held in
# ret:   the template, released with `dnit`
pub fun none(alloc: *A.Allocator) Template {
    var t: Template = Template{alloc: alloc, present: false, source: nil};
    t.a        = ast.init(alloc, base_source.FILE_NIL);
    t.rr       = resolve.ResolveResult{alloc: alloc, param_index: map.init[u64, resolve.SymbolId](alloc), nominals: map.init[u64, resolve.SymbolId](alloc), constants: comptime_scope.bindings_init(alloc)};
    t.load     = comptime_scope.bindings_init(alloc);
    t.resolved = comptime_scope.bindings_init(alloc);
    t.typed    = comptime_scope.bindings_init(alloc);
    ret t;
}

# release a template set; a nil one, or one never made, holds nothing
pub fun dnit(t: *Template) {
    if (t == nil || t.alloc == nil) { ret; }
    ast.dnit(?t.a);
    resolve.result_dnit(?t.rr);
    typing_dnit(t.alloc, ?t.typing);
    comptime_scope.bindings_dnit(?t.load);
    comptime_scope.bindings_dnit(?t.resolved);
    comptime_scope.bindings_dnit(?t.typed);
    if (t.source != nil) { str_free(t.alloc, t.source); }
    t.source  = nil;
    t.present = false;
    t.alloc   = nil;
}

fun typing_dnit(alloc: *A.Allocator, ty: *Typing) {
    if (ty.expr_type != nil)        { A.deallocate[type_kind.TypeId](alloc, ty.expr_type, ty.expr_count::usize); }
    if (ty.type_resolved_ty != nil) { A.deallocate[type_kind.TypeId](alloc, ty.type_resolved_ty, ty.type_count::usize); }
    if (ty.decl_type != nil)        { A.deallocate[type_kind.TypeId](alloc, ty.decl_type, ty.decl_count::usize); }
    ty.expr_type        = nil;
    ty.type_resolved_ty = nil;
    ty.decl_type        = nil;
}

# what a template is captured from, all of which it copies
pub rec Captured {
    a:        *ast.Ast;
    source:   str;
    rr:       *resolve.ResolveResult;
    typing:   Typing;
    load:     *comptime_scope.Bindings;
    resolved: *comptime_scope.Bindings;
    typed:    *comptime_scope.Bindings;
    env:      comptime_scope.ComptimeEnv;
}

# an owned copy of everything `from` names, from `alloc`
pub fun capture(alloc: *A.Allocator, from: Captured) res[Template, fail.Fail] {
    var t:    Template = none(alloc);
    var done: bool     = false;
    fin {
        if (!done) { dnit(?t); }
    }
    t.env = from.env;
    val res_copied: res[ast.Ast, fail.Fail] = ast.copy(from.a, alloc);
    if (sel res_copied.err) { ret res[Template, fail.Fail].err{res_copied.err}; }
    ast.dnit(?t.a);
    t.a = res_copied.ok;
    val res_text: res[str, types_string.StrError] = str_copy(alloc, from.source);
    if (sel res_text.err) { ret res[Template, fail.Fail].err{fail.str_refused(res_text.err)}; }
    t.source = res_text.ok;
    val res_result_copy: res[resolve.ResolveResult, fail.Fail] = resolve.result_copy(from.rr, alloc);
    if (sel res_result_copy.err) { ret res[Template, fail.Fail].err{res_result_copy.err}; }
    t.rr = res_result_copy.ok;
    val err_typing: err[fail.Fail] = typing_copy(alloc, ?t.typing, ?from.typing);
    if (sel err_typing.err) { ret res[Template, fail.Fail].err{err_typing.err}; }
    val err_load: err[fail.Fail] = bindings_take(alloc, ?t.load, from.load);
    if (sel err_load.err) { ret res[Template, fail.Fail].err{err_load.err}; }
    val err_resolved: err[fail.Fail] = bindings_take(alloc, ?t.resolved, from.resolved);
    if (sel err_resolved.err) { ret res[Template, fail.Fail].err{err_resolved.err}; }
    val err_typed: err[fail.Fail] = bindings_take(alloc, ?t.typed, from.typed);
    if (sel err_typed.err) { ret res[Template, fail.Fail].err{err_typed.err}; }
    t.present = true;
    done      = true;
    ret res[Template, fail.Fail].ok{t};
}

fun bindings_take(alloc: *A.Allocator, dst: *comptime_scope.Bindings, src: *comptime_scope.Bindings) err[fail.Fail] {
    if (src == nil) { ret err[fail.Fail].ok{}; }
    val res_copied: res[comptime_scope.Bindings, fail.Fail] = comptime_scope.bindings_copy(src, alloc);
    if (sel res_copied.err) { ret err[fail.Fail].err{res_copied.err}; }
    comptime_scope.bindings_dnit(dst);
    @dst = res_copied.ok;
    ret err[fail.Fail].ok{};
}

fun typing_copy(alloc: *A.Allocator, dst: *Typing, src: *Typing) err[fail.Fail] {
    dst.expr_count = src.expr_count;
    dst.type_count = src.type_count;
    dst.decl_count = src.decl_count;
    val res_exprs: res[*type_kind.TypeId, fail.Fail] = types_copy(alloc, src.expr_type, src.expr_count);
    if (sel res_exprs.err) { ret err[fail.Fail].err{res_exprs.err}; }
    dst.expr_type = res_exprs.ok;
    val res_types: res[*type_kind.TypeId, fail.Fail] = types_copy(alloc, src.type_resolved_ty, src.type_count);
    if (sel res_types.err) { ret err[fail.Fail].err{res_types.err}; }
    dst.type_resolved_ty = res_types.ok;
    val res_decls: res[*type_kind.TypeId, fail.Fail] = types_copy(alloc, src.decl_type, src.decl_count);
    if (sel res_decls.err) { ret err[fail.Fail].err{res_decls.err}; }
    dst.decl_type = res_decls.ok;
    ret err[fail.Fail].ok{};
}

fun types_copy(alloc: *A.Allocator, src: *type_kind.TypeId, n: u32) res[*type_kind.TypeId, fail.Fail] {
    if (src == nil || n == 0) { ret res[*type_kind.TypeId, fail.Fail].ok{nil}; }
    val res_made: res[*type_kind.TypeId, A.Error] = A.allocate[type_kind.TypeId](alloc, n::usize);
    if (sel res_made.err) { ret res[*type_kind.TypeId, fail.Fail].err{fail.refused(res_made.err)}; }
    var i: u32 = 0;
    for (i < n) {
        res_made.ok[i] = src[i];
        i              = i + 1;
    }
    ret res[*type_kind.TypeId, fail.Fail].ok{res_made.ok};
}
