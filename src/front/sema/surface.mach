# the typed surface a module publishes to its importers: each public symbol's
# type and bound constant, and the field recipes of the types they reach
use collections_vector: std.collections.vector;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;

use mach.base.fail;
use mach.base.intern;
use ast_id:         mach.front.ast.id;
use comptime_deep:  mach.front.comptime.deep;
use comptime_scope: mach.front.comptime.scope;
use comptime_value: mach.front.comptime.value;
use mach.front.resolve;
use mach.front.sema.fields;
use mach.front.sema.interface;
use sema_product: mach.front.sema.product;
use mach.session;
use mach.session.module;
use mach.type;
use type_field: mach.type.field;
use type_kind:  mach.type.kind;

# the module whose surface is built: its ids and its load scope
pub rec Owner {
    module: module.ModuleId;
    stable: module.StableModuleId;
    path:   intern.StrId;
    ctx:    *comptime_scope.ComptimeCtx;
}

# where the surfaces of the modules a surface forwards from are read: a loaded module's
# published surface, owned by the caller
pub rec Origins {
    ctx:  ptr;
    read: fun(ptr, module.ModuleId, *A.Allocator) res[sema_product.ModuleSema, fail.Fail];
}

# a module's own export, with the constant type checking left it bound to
fun own_export(s: *session.Session, owner: *Owner, symbol: *resolve.Symbol,
    rr: *resolve.ResolveResult, sr: *sema_product.SemaResult) res[sema_product.TypeExport, fail.Fail] {
    var row: sema_product.TypeExport = sema_product.TypeExport{
        origin:   owner.stable, canon: symbol.canon, ty: type_kind.TYPE_NIL,
        constant: resolve.ExportConstant{name: symbol.canon}
    };
    if (symbol.definition_kind == resolve.SYM_USE) { ret res[sema_product.TypeExport, fail.Fail].ok{row}; }
    if (!module.stable_same(symbol.origin, owner.stable) || sr == nil || ast_id.decl_is_nil(symbol.decl) || ast_id.decl_index(symbol.decl) >= sr.decl_count) {
        ret res[sema_product.TypeExport, fail.Fail].err{fail.message("typed export has no matching current declaration")};
    }
    row.ty = sr.decl_type[ast_id.decl_index(symbol.decl)];
    if (symbol.definition_kind == resolve.SYM_VAL) {
        var typed: comptime_scope.ComptimeCtx = comptime_scope.stage_init(owner.ctx, comptime_scope.STAGE_LOWER, s.alloc);
        fin { comptime_scope.dnit(?typed); }
        comptime_scope.layer_set(?typed, comptime_scope.STAGE_RESOLVE, ?rr.constants);
        comptime_scope.layer_set(?typed, comptime_scope.STAGE_SEMA, ?sr.constants);
        val opt_found: opt[comptime_scope.NamedConst] = comptime_scope.lookup(?typed, symbol.canon);
        if (sel opt_found.some) {
            val constant: comptime_scope.NamedConst = opt_found.some;
            row.constant.present = true;
            row.constant.value   = constant.value;
            # a case literal is the value the module's interface publishes
            if (constant.value.kind == comptime_value.CT_KIND_CONST_ELEM) {
                row.constant.present = false;
                val opt_published: opt[*interface.Declaration] = interface.declaration_at(?sr.interface, symbol.decl);
                if (sel opt_published.some) {
                    if (!comptime_deep.is_none(opt_published.some.value)) {
                        row.constant.present = true;
                        row.constant.value   = comptime_deep.node_ref(module.stable_index(owner.stable), opt_published.some.value, constant.value.data.celem.ty);
                    }
                }
            }
        }
    }
    ret res[sema_product.TypeExport, fail.Fail].ok{row};
}

rec OriginSurface { module: module.ModuleId; surface: sema_product.ModuleSema; }

fun origin_surfaces_dnit(decoded: *collections_vector.Vector[OriginSurface]) {
    var i: usize = 0;
    for (i < decoded.len) {
        sema_product.module_sema_dnit(?decoded.data[i].surface);
        i = i + 1;
    }
    collections_vector.dnit[OriginSurface](decoded);
}

# one read per origin module while a surface is built, however many symbols it forwards
fun origin_surface(s: *session.Session, origins: *Origins, mid: module.ModuleId, decoded: *collections_vector.Vector[OriginSurface]) res[*sema_product.ModuleSema, fail.Fail] {
    var i: usize = 0;
    for (i < decoded.len) {
        if (module.same(decoded.data[i].module, mid)) { ret res[*sema_product.ModuleSema, fail.Fail].ok{?decoded.data[i].surface}; }
        i = i + 1;
    }
    val res_acquired: res[sema_product.ModuleSema, fail.Fail] = origins.read(origins.ctx, mid, s.alloc);
    if (sel res_acquired.err) { ret res[*sema_product.ModuleSema, fail.Fail].err{res_acquired.err}; }
    var surface:   sema_product.ModuleSema = res_acquired.ok;
    val res_added: res[usize, A.Error]     = collections_vector.push[OriginSurface](decoded, OriginSurface{module: mid, surface: surface});
    if (sel res_added.err) {
        sema_product.module_sema_dnit(?surface);
        ret res[*sema_product.ModuleSema, fail.Fail].err{fail.refused(res_added.err)};
    }
    ret res[*sema_product.ModuleSema, fail.Fail].ok{?decoded.data[decoded.len - 1].surface};
}

# a symbol the module forwards, as the surface its origin module published it
fun imported_export(s: *session.Session, origins: *Origins, symbol: *resolve.Symbol,
    decoded: *collections_vector.Vector[OriginSurface]) res[sema_product.TypeExport, fail.Fail] {
    val origin: module.StableModuleId = symbol.origin;
    val mid:    module.ModuleId       = resolve.origin_of(s, symbol);
    if (module.stable_is_nil(origin) || module.is_nil(mid)) { ret res[sema_product.TypeExport, fail.Fail].err{fail.message("forwarded type origin is not loaded")}; }
    val res_acquired: res[*sema_product.ModuleSema, fail.Fail] = origin_surface(s, origins, mid, decoded);
    if (sel res_acquired.err) { ret res[sema_product.TypeExport, fail.Fail].err{res_acquired.err}; }
    val surface: *sema_product.ModuleSema = res_acquired.ok;
    var i:       usize                    = 0;
    for (i < surface.exports.len) {
        val row: sema_product.TypeExport = surface.exports.data[i];
        if (module.stable_same(row.origin, origin) && intern.str_same(row.canon, symbol.canon)) { ret res[sema_product.TypeExport, fail.Fail].ok{row}; }
        i = i + 1;
    }
    ret res[sema_product.TypeExport, fail.Fail].err{fail.message("forwarded type has no acquired canonical public surface")};
}

# the exports of `owner`'s typed surface, allocated from `a`; a symbol it forwards is read
# from the surface its origin published
pub fun exports(s: *session.Session, owner: *Owner, rr: *resolve.ResolveResult, sr: *sema_product.SemaResult,
    origins: *Origins, a: *A.Allocator) res[sema_product.ModuleSema, fail.Fail] {
    var surface:     sema_product.ModuleSema                  = sema_product.module_sema_init(a, owner.path, owner.module, owner.stable);
    var transferred: bool                                     = false;
    var decoded:     collections_vector.Vector[OriginSurface] = collections_vector.init[OriginSurface](s.alloc);
    fin {
        origin_surfaces_dnit(?decoded);
        if (!transferred) { sema_product.module_sema_dnit(?surface); }
    }
    var i: u32 = 0;
    for (i < rr.pub_count) {
        val symbol:       *resolve.Symbol = ?rr.symbols[i];
        var res_captured: res[sema_product.TypeExport, fail.Fail];
        if (module.stable_same(symbol.origin, owner.stable)) { res_captured = own_export(s, owner, symbol, rr, sr); }
        or                                                   { res_captured = imported_export(s, origins, symbol, ?decoded); }
        if (sel res_captured.err)                            { ret res[sema_product.ModuleSema, fail.Fail].err{res_captured.err}; }
        val res_added: res[usize, A.Error] = collections_vector.push[sema_product.TypeExport](?surface.exports, res_captured.ok);
        if (sel res_added.err) { ret res[sema_product.ModuleSema, fail.Fail].err{fail.refused(res_added.err)}; }
        i = i + 1;
    }
    transferred = true;
    ret res[sema_product.ModuleSema, fail.Fail].ok{surface};
}

# holds a public nominal to having its field table prepared already, by the module that owns it
fun prepared_recipe(s: *session.Session, ty: type_kind.TypeId) err[fail.Fail] {
    val opt_table: opt[*type_field.Table] = type.field_table_for(s.types, ty);
    if (sel opt_table.none) {
        ret err[fail.Fail].err{fail.message("public nominal recipe was not prepared by its acquired semantic owner")};
    }
    ret err[fail.Fail].ok{};
}

# the field recipes of every type the exports of `surface` reach, and of the type each
# exported constant names, read from the session's type table
pub fun graph(s: *session.Session, surface: *sema_product.ModuleSema) res[fields.Graph, fail.Fail] {
    var roots: collections_vector.Vector[type_kind.TypeId] = collections_vector.init[type_kind.TypeId](surface.exports.a);
    fin { collections_vector.dnit[type_kind.TypeId](?roots); }
    var i: usize = 0;
    for (i < surface.exports.len) {
        val row:       *sema_product.TypeExport = ?surface.exports.data[i];
        val res_added: res[usize, A.Error]      = collections_vector.push[type_kind.TypeId](?roots, row.ty);
        if (sel res_added.err) { ret res[fields.Graph, fail.Fail].err{fail.refused(res_added.err)}; }
        if (row.constant.present) {
            val value: comptime_value.CTValue = row.constant.value;
            var extra: type_kind.TypeId       = type_kind.TYPE_NIL;
            if (value.kind == comptime_value.CT_KIND_TYPE)                                               { extra = value.data.t::type_kind.TypeId; }
            or (value.kind == comptime_value.CT_KIND_FIELD || value.kind == comptime_value.CT_KIND_CASE) { extra = value.data.fld.owner::type_kind.TypeId; }
            or (value.kind == comptime_value.CT_KIND_PACK_ELEM)                                          { extra = value.data.pelem.ty::type_kind.TypeId; }
            or (value.kind == comptime_value.CT_KIND_CONST_ELEM)                                         { extra = value.data.celem.ty::type_kind.TypeId; }
            or (value.kind == comptime_value.CT_KIND_NODE)                                               { extra = value.data.node.ty::type_kind.TypeId; }
            val res_pushed: res[usize, A.Error] = collections_vector.push[type_kind.TypeId](?roots, extra);
            if (sel res_pushed.err) { ret res[fields.Graph, fail.Fail].err{fail.refused(res_pushed.err)}; }
        }
        i = i + 1;
    }
    var group: fields.Roots = fields.Roots{data: roots.data, len: roots.len};
    ret fields.capture[session.Session](s, surface.exports.a, ?group, 1, fields.RECIPES, s, prepared_recipe);
}
