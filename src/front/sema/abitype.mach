# `#[abi_type]` declarations: C types whose layout the target supplies, such as `va_list`
#
# a bodyless `def` marked `#[abi_type("va_list")]` takes its size and alignment from the selected
# target's calling convention. a value of it can only be received as a parameter and passed on, so
# no field, payload, result or module binding may hold one, and no parameter may hold one under a
# pointer, array or secret.

use A: std.allocator;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.string.str;
use std.types.string.str_equals;

use diagnostic_kind: mach.base.diagnostic.kind;
use mach.base.fail;
use mach.base.intern;
use base_source: mach.base.source;
use mach.front.ast;
use ast_decl: mach.front.ast.decl;
use ast_expr: mach.front.ast.expr;
use ast_id:   mach.front.ast.id;
use mach.front.decorator;
use sema_context: mach.front.sema.context;
use report_phase: mach.report.phase;
use target_facts: mach.target.facts;
use target_tags:  mach.target.tags;
use mach.type;
use type_kind: mach.type.kind;

val ARG_COUNT: u32 = 1;

pub def ReadStatus: u8;
pub val READ_OK:      ReadStatus = 0;
val     READ_REFUSED: ReadStatus = 1;

# what reading one `#[abi_type]` declaration found
# ---
# status: READ_OK when the declaration names a layout the target supplies, READ_REFUSED otherwise
# tag:    which ABI type it is, as `type.ABI_TYPE_*`
# size:   its size in bytes, as the target's calling convention lists it
# align:  its alignment in bytes
rec Read {
    status: ReadStatus;
    tag:    u32;
    size:   u32;
    align:  u32;
}

fun decorator_of(sc: *sema_context.SemaContext, d: *ast_decl.Decl) *ast_decl.Decorator {
    val opt_found: opt[*ast_decl.Decorator] = decorator.get(sc.view.a, d, decorator.ABI_TYPE);
    if (sel opt_found.none) { ret nil; }
    ret opt_found.some;
}

# whether `d` is a bodyless `def` marked `#[abi_type]`
# ---
# sc:  the walk
# d:   the declaration asked about
# ret: true for a bodyless `def` that carries the decorator
pub fun declares_abi_type(sc: *sema_context.SemaContext, d: *ast_decl.Decl) bool {
    if (d.kind != ast_decl.DECL_KIND_DEF)    { ret false; }
    if (!ast_id.type_is_nil(d.data.def_.ty)) { ret false; }
    ret decorator_of(sc, d) != nil;
}

fun arg_expr(sc: *sema_context.SemaContext, dec: *ast_decl.Decorator, index: u32) *ast_expr.Expr {
    if (index >= dec.args_len) { ret nil; }
    val opt_e: opt[*ast_expr.Expr] = ast.get_expr(sc.view.a, sc.view.a.expr_ids.data[dec.args_start + index]);
    if (!sel opt_e.some) { ret nil; }
    ret opt_e.some;
}

# read the layout an `#[abi_type]` decorator on `d` names from the selected target
# ---
# sc:     the walk
# d:      the declaration the decorator is on
# dec:    the `abi_type` decorator
# report: whether a misplaced or malformed decorator, or an unavailable layout, is reported
# ret:    the read, with status READ_REFUSED and zero layout when anything is wrong
pub fun read(sc: *sema_context.SemaContext, d: *ast_decl.Decl, dec: *ast_decl.Decorator, report: bool) Read {
    var out: Read;
    out.status = READ_REFUSED;
    out.tag    = 0;
    out.size   = 0;
    out.align  = 0;

    if (d.kind != ast_decl.DECL_KIND_DEF) {
        if (report) { sema_context.report(sc, diagnostic_kind.DECORATOR_MISPLACED, dec.name, "`abi_type` applies only to a `def` declaration"); }
        ret out;
    }
    if (!ast_id.type_is_nil(d.data.def_.ty)) {
        if (report) { sema_context.report(sc, diagnostic_kind.ABI_TYPE_HAS_BODY, dec.name, "an `abi_type` declaration has no body. write `def Name;` and the target supplies the layout"); }
        ret out;
    }
    if (dec.args_len != ARG_COUNT) {
        if (report) { sema_context.report(sc, diagnostic_kind.DECORATOR_ARITY, dec.name, "`abi_type` takes exactly one string argument, the name of the C type whose layout the target declares"); }
        ret out;
    }

    val name_e: *ast_expr.Expr = arg_expr(sc, dec, 0);
    if (name_e == nil) { ret out; }
    var opt_name: opt[str] = decorator.string_of(sc.s.interner, sc.view.ctx, sc.view.a, dec, 0);
    if (report) {
        opt_name = sema_context.decorator_string_arg(sc, dec, 0, diagnostic_kind.DECORATOR_ARGUMENT,
            "the `abi_type` argument must be a string naming a C type the target declares");
    }
    if (sel opt_name.none) { ret out; }

    if (!str_equals(opt_name.some, "va_list")) {
        if (report) { sema_context.report(sc, diagnostic_kind.ABI_TYPE_UNKNOWN, name_e.span, "no such ABI type. `va_list` is the only C type whose layout a target declares"); }
        ret out;
    }

    # the layout `va_list` takes is the target convention's row in mirl, read when the
    # target resolved
    val listed: target_facts.VaList = sc.view.ctx.env.target.va_list;
    val abi:    str                 = target_tags.abi_name(sc.view.ctx.env.target.abi_id);
    if (sel listed.unlisted) {
        if (report) { sema_context.reportf(sc, diagnostic_kind.ABI_TYPE_UNAVAILABLE, name_e.span, "the selected target's calling convention `{}` has no `va_list`", abi); }
        ret out;
    }
    if (sel listed.refused) {
        if (report) { sema_context.reportf(sc, diagnostic_kind.ABI_TYPE_UNAVAILABLE, name_e.span, "the `va_list` of calling convention `{}` has no layout ({})", abi, listed.refused); }
        ret out;
    }
    if (sel listed.listed) {
        out.status = READ_OK;
        out.tag    = type.ABI_TYPE_VA_LIST;
        out.size   = listed.listed.size;
        out.align  = listed.listed.align;
    }
    ret out;
}

# report everything wrong with an `#[abi_type]` decorator on `d`
# ---
# sc:  the walk
# d:   the declaration the decorator is on
# dec: the `abi_type` decorator
pub fun validate(sc: *sema_context.SemaContext, d: *ast_decl.Decl, dec: *ast_decl.Decorator) {
    read(sc, d, dec, true);
}

# the interned ABI type an `#[abi_type]` declaration stands for
# ---
# sc:  the walk
# d:   the declaration
# ret: the type, or TYPE_ERROR when `d` has no such decorator or its layout is refused, which
#      reports nothing here, or interning it fails, which fails the phase as internal
pub fun type_of(sc: *sema_context.SemaContext, d: *ast_decl.Decl) type_kind.TypeId {
    val dec: *ast_decl.Decorator = decorator_of(sc, d);
    if (dec == nil) { ret type_kind.TYPE_ERROR; }

    val r: Read = read(sc, d, dec, false);
    if (r.status == READ_REFUSED) { ret type_kind.TYPE_ERROR; }

    val res_intern_abi_type: res[type_kind.TypeId, fail.Fail] =
        type.intern_abi_type(sc.s.types, intern_name(sc, d.data.def_.name), r.tag, r.size, r.align);
    if (sel res_intern_abi_type.err) {
        report_phase.internal(?sc.status, res_intern_abi_type.err);
        ret type_kind.TYPE_ERROR;
    }
    ret res_intern_abi_type.ok;
}

# the interned text of `span` in this view's source, STR_NIL for an empty span or a failed intern
fun intern_name(sc: *sema_context.SemaContext, span: base_source.Span) intern.StrId {
    if (span.len == 0) { ret intern.STR_NIL; }
    val res_range_add: res[intern.StrId, A.Error] = intern.range_add(sc.s.interner, sc.view.source, span.offset, span.len);
    if (sel res_range_add.err) {
        sema_context.report_internal(sc, span, fail.refused(res_range_add.err));
        ret intern.STR_NIL;
    }
    ret res_range_add.ok;
}

# the message every misplaced ABI type value is reported with
pub fun exclusion_message() str {
    ret "a `va_list` cannot be read, constructed or stored. receive it as a parameter and pass it to the C function that consumes it";
}

# whether `t` is an ABI type, or one under any chain of secret, pointer and array
# ---
# sc:  the walk
# t:   the type asked about
# ret: true when an ABI type is reached through those wrappers
pub fun type_carries_abi_type(sc: *sema_context.SemaContext, t: type_kind.TypeId) bool {
    var at: type_kind.TypeId = t;
    for {
        if (type_kind.is_nil(at) || type_kind.is_error(at)) { ret false; }
        val opt_type: opt[*type.Type] = type.get(sc.s.types, at);
        if (!sel opt_type.some) { ret false; }
        val tp: *type.Type = opt_type.some;
        if (tp.kind == type_kind.TYPE_ABI)     { ret true; }
        if (tp.kind == type_kind.TYPE_SECRET)  { at = tp.data.secret.base; }
        or (tp.kind == type_kind.TYPE_POINTER) { at = tp.data.pointer.base; }
        or (tp.kind == type_kind.TYPE_ARRAY)   { at = tp.data.array.base; }
        or                                     { ret false; }
    }
}

# report every place in declaration `d` that holds an ABI type where it cannot: a tag payload,
# a record or union field, a function result, a module binding, or a parameter that holds one
# under a wrapper, since only a parameter of the ABI type itself is allowed
# ---
# sc:  the walk
# did: the id of `d`, which keys the type of a module binding
# d:   the declaration checked
pub fun check_abi_type_placement(sc: *sema_context.SemaContext, did: ast_id.DeclId, d: *ast_decl.Decl) {
    if (d.kind == ast_decl.DECL_KIND_TAG) {
        var i: u32 = 0;
        for (i < d.data.tag_.cases_len) {
            val c: *ast_decl.TagCase = ?sc.view.a.tag_cases.data[d.data.tag_.cases_start + i];
            if (type_carries_abi_type(sc, sema_context.resolved_type_of(sc, c.payload))) {
                sema_context.report(sc, diagnostic_kind.ABI_TYPE_OPAQUE, c.name, exclusion_message());
            }
            i = i + 1;
        }
        ret;
    }
    if (d.kind == ast_decl.DECL_KIND_REC) {
        check_abi_type_fields(sc, d.data.rec_.fields_start, d.data.rec_.fields_len);
        ret;
    }
    if (d.kind == ast_decl.DECL_KIND_UNI) {
        check_abi_type_fields(sc, d.data.uni_.fields_start, d.data.uni_.fields_len);
        ret;
    }
    if (d.kind == ast_decl.DECL_KIND_FUN) {
        var i: u32 = 0;
        for (i < d.data.fun_.params_len) {
            val tn:  *ast_decl.TypedName = ?sc.view.a.typed_names.data[d.data.fun_.params_start + i];
            val pty: type_kind.TypeId    = sema_context.resolved_type_of(sc, tn.ty);
            if (type_carries_abi_type(sc, pty) && !type.is_abi_type(sc.s.types, pty)) {
                sema_context.report(sc, diagnostic_kind.ABI_TYPE_OPAQUE, tn.name, exclusion_message());
            }
            i = i + 1;
        }
        if (type_carries_abi_type(sc, sema_context.resolved_type_of(sc, d.data.fun_.return_type))) {
            sema_context.report(sc, diagnostic_kind.ABI_TYPE_OPAQUE, d.data.fun_.name, exclusion_message());
        }
        ret;
    }
    if (sema_context.is_global_binding(d.kind)) {
        if (sc.view.decl_type == nil) { ret; }
        if (type_carries_abi_type(sc, sc.view.decl_type[ast_id.decl_index(did)])) {
            sema_context.report(sc, diagnostic_kind.ABI_TYPE_OPAQUE, d.span, exclusion_message());
        }
    }
}

# report every field among `len` typed names from `start` whose type carries an ABI type
fun check_abi_type_fields(sc: *sema_context.SemaContext, start: u32, len: u32) {
    var i: u32 = 0;
    for (i < len) {
        val tn: *ast_decl.TypedName = ?sc.view.a.typed_names.data[start + i];
        if (type_carries_abi_type(sc, sema_context.resolved_type_of(sc, tn.ty))) {
            sema_context.report(sc, diagnostic_kind.ABI_TYPE_OPAQUE, tn.name, exclusion_message());
        }
        i = i + 1;
    }
}
