# the instantiation of a generic the sema context names, and the checks each instance owes
# its type annotations
use diagnostic_kind: mach.base.diagnostic.kind;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use mach.base.fail;
use mach.base.intern;
use base_source: mach.base.source;
use ast_id:      mach.front.ast.id;
use mach.front.resolve;
use sema_context: mach.front.sema.context;
use sema_handle:  mach.front.sema.handle;
use mach.front.sema.variant;
use report_phase: mach.report.phase;
use mach.type;
use type_kind: mach.type.kind;

# the instance of the generic record, union or tag `sym` names at the type arguments `args`.
# a declaration that is not a generic type, a wrong argument count or an argument that is not
# a type is reported and gives the error type
# ---
# sc:        the sema context of the module being typed
# sym:       the symbol the generic is named by
# args:      the type arguments, `arg_count` of them
# arg_count: how many type arguments the use states
# span:      where the use stands, for diagnostics
# ret:       the instance type, the error type after a reported refusal, or the internal failure
#            of interning its nominal or instance
pub fun instantiate(
    sc: *sema_context.SemaContext,
    sym: *resolve.Symbol,
    args: *type_kind.TypeId,
    arg_count: u32,
    span: base_source.Span) res[type_kind.TypeId, fail.Fail] {
    if (sym.definition_kind != resolve.SYM_REC && sym.definition_kind != resolve.SYM_UNI && sym.definition_kind != resolve.SYM_TAG) {
        sema_context.report(sc, diagnostic_kind.GENERIC_NOT_GENERIC, span, "this declaration is not generic");
        ret res[type_kind.TypeId, fail.Fail].ok{type_kind.TYPE_ERROR};
    }

    if (!check_arity(sc, sym, arg_count, span)) {
        ret res[type_kind.TypeId, fail.Fail].ok{type_kind.TYPE_ERROR};
    }

    var i: u32 = 0;
    for (i < arg_count) {
        if (type_kind.is_nil(args[i]) || type_kind.is_error(args[i])) {
            sema_context.reportf(sc, diagnostic_kind.GENERIC_ARGUMENT, span, "type argument {} is not a type", (i + 1)::usize);
            ret res[type_kind.TypeId, fail.Fail].ok{type_kind.TYPE_ERROR};
        }
        i = i + 1;
    }

    val gnom: type_kind.TypeId = nominal_of(sc, sym);
    if (sel sc.status.kind.internal) { ret res[type_kind.TypeId, fail.Fail].err{sc.status.kind.internal}; }
    ret type.intern_instance(sc.s.types, gnom, args, arg_count);
}

# whether `sym` is a function or a type that declares exactly `arg_count` type parameters,
# reporting the mismatch when it does not
# ---
# sc:        the sema context of the module being typed
# sym:       the symbol the use names
# arg_count: how many type arguments the use states
# span:      where the use stands, for diagnostics
# ret:       true when the count matches
pub fun check_arity(
    sc: *sema_context.SemaContext,
    sym: *resolve.Symbol,
    arg_count: u32,
    span: base_source.Span) bool {
    if (sym.definition_kind != resolve.SYM_FUN && sym.definition_kind != resolve.SYM_REC && sym.definition_kind != resolve.SYM_UNI && sym.definition_kind != resolve.SYM_TAG) {
        sema_context.report(sc, diagnostic_kind.GENERIC_NOT_GENERIC, span, "this declaration takes no type parameters");
        ret false;
    }
    val want: u32 = sym.generic_arity;
    if (want == 0) {
        sema_context.reportf(sc, diagnostic_kind.GENERIC_NOT_GENERIC, span, "`{}` declares no type parameters, so it takes no type arguments", intern.text(sc.s.interner, sym.name));
        ret false;
    }
    if (arg_count != want) {
        report_type_arg_count(sc, span, want, arg_count);
        ret false;
    }
    ret true;
}

# the checks an instance owes each type annotation it resolves, which no check of the
# generic declaration can answer before its parameters are known
pub fun check_annotation(sc: *sema_context.SemaContext, ast_tid: ast_id.TypeId) {
    variant.check_annotation_uni_secrecy(sc, sc.instance.secrecy, ast_tid);
    sema_handle.check_annotation_handles(sc, sc.instance.handles, ast_tid);
}

# the nominal type `sym` declares, the error type after an internal failure
fun nominal_of(sc: *sema_context.SemaContext, sym: *resolve.Symbol) type_kind.TypeId {
    var kind: type_kind.TypeKind = type_kind.TYPE_REC;
    if (sym.definition_kind == resolve.SYM_UNI) { kind = type_kind.TYPE_UNI; }
    if (sym.definition_kind == resolve.SYM_TAG) { kind = type_kind.TYPE_TAG; }
    if (base_source.file_is_nil(sym.definition_file)) {
        report_phase.internal(?sc.status, fail.message("generic nominal has no defining source identity"));
        ret type_kind.TYPE_ERROR;
    }
    val res_nominal: res[type_kind.TypeId, fail.Fail] = type.intern_nominal(sc.s.types, sym.canon,
        resolve.type_owner(sc.s, resolve.origin_of(sc.s, sym), sym.definition_file), kind);
    if (sel res_nominal.err) {
        report_phase.internal(?sc.status, res_nominal.err);
        ret type_kind.TYPE_ERROR;
    }
    ret res_nominal.ok;
}

fun report_type_arg_count(sc: *sema_context.SemaContext, span: base_source.Span, expected: u32, actual: u32) {
    var noun: str = "type arguments";
    if (expected == 1) { noun = "type argument"; }
    sema_context.reportf(sc, diagnostic_kind.GENERIC_ARITY, span, "expected {} {}, found {}", expected::usize, noun, actual::usize);
}
