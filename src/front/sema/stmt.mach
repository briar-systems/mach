# typing statements, with the comptime `$if` and `$each` that stand among them
use diagnostic_kind: mach.base.diagnostic.kind;
use mach.base.fail;
use mach.base.intern;
use base_source: mach.base.source;
use mach.base.stack;
use mach.base.wide;
use mach.front.ast;
use ast_decl: mach.front.ast.decl;
use ast_expr: mach.front.ast.expr;
use ast_id:   mach.front.ast.id;
use ast_stmt: mach.front.ast.stmt;
use mach.front.comptime;
use comptime_deep:    mach.front.comptime.deep;
use comptime_failure: mach.front.comptime.failure;
use comptime_gate:    mach.front.comptime.gate;
use mach.front.comptime.intrinsic;
use comptime_scope: mach.front.comptime.scope;
use comptime_value: mach.front.comptime.value;
use mach.front.decorator;
use mach.front.resolve;
use mach.front.sema.abitype;
use mach.front.sema.check;
use mach.front.sema.coerce;
use sema_constant: mach.front.sema.constant;
use sema_context:  mach.front.sema.context;
use mach.front.sema.guard;
use sema_handle: mach.front.sema.handle;
use mach.front.sema.infer;
use sema_instance: mach.front.sema.instance;
use sema_noreturn: mach.front.sema.noreturn;
use mach.front.transition;
use report_phase:    mach.report.phase;
use target_baseline: mach.target.baseline;
use target_tags:     mach.target.tags;
use mach.type;
use type_kind: mach.type.kind;
use A:         std.allocator;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.string.StrError;
use std.types.string.str;
use std.types.string.str_copy_slice;
use std.types.string.str_len;

# the type a test body returns, `i32`
# ---
# sc:  the sema context whose type table is read
# ret: the `i32` type, the error type when it is not interned
pub fun test_return_type(sc: *sema_context.SemaContext) type_kind.TypeId {
    val opt_i32: opt[type_kind.TypeId] = type.prim(sc.s.types, type_kind.TYPE_I32);
    if (!sel opt_i32.some) { ret type_kind.TYPE_ERROR; }
    ret opt_i32.some;
}

# a test result is a process status: the u8 range is the status range, so a
# literal-shaped `ret` whose folded value lies outside it is refused here, at the
# ret, instead of being folded by the dispatcher at run time
fun check_test_status(sc: *sema_context.SemaContext, value: ast_id.ExprId, span: base_source.Span) {
    if (ast_id.expr_is_nil(value)) { ret; }
    # the probe at the test's own return type admits only literal shapes whose leaves fit it
    val res_probe_literal_range: res[coerce.CoerceResult, fail.Fail] = coerce.probe_literal_range(sc, value, test_return_type(sc));
    if (sel res_probe_literal_range.err)                          { ret; }
    if (res_probe_literal_range.ok.kind != coerce.COERCE_COERCED) { ret; }

    val outer: sema_context.Walk = sema_context.walk_begin(sc);
    sc.walk.silent = true;
    val res_eval: res[comptime_value.CTValue, comptime_failure.EvalFail] = comptime.evaluate[sema_context.SemaContext](sc.view.ctx, sc, sc.typing.caps, sc.view.a, sc.view.source, value, sc.s.interner);
    sema_context.record_eval_result(sc, res_eval);
    sema_context.walk_end(sc, outer);
    if (!sel res_eval.ok) { ret; }
    val ctval: comptime_value.CTValue = res_eval.ok;
    if (ctval.kind != comptime_value.CT_KIND_INT) { ret; }

    var mag:  wide.Wide = ctval.data.w;
    var sign: str       = "";
    if (comptime_value.ct_is_negative(ctval)) {
        mag  = wide.neg(mag);
        sign = "-";
    }
    or (wide.fits_unsigned(mag, 8)) { ret; }
    var digits:  [wide.FORMAT_CAP]u8;
    val opt_msg: opt[str] = sema_context.text(sc, "test result {}{} is outside the status range 0..255", sign, wide.text_u(mag, ?digits[0]));
    if (sel opt_msg.none) { ret; }
    fin { sema_context.text_free(sc, opt_msg.some); }
    sema_context.report_note(sc, diagnostic_kind.TEST_STATUS_RANGE, span, opt_msg.some,
        "a test's result is its exit status, where 0 passes, 77 skips and any other value up to 255 fails");
}

# types a gate's condition inside the gate and checks that it is a condition
pub fun gate_condition_check(sc: *sema_context.SemaContext, cond: ast_id.ExprId) bool {
    val outer: sema_context.Walk = sema_context.walk_begin(sc);
    sc.walk.in_comptime_gate = true;
    var ok:      bool             = false;
    val gate_ty: type_kind.TypeId = infer.infer_expr(sc, cond);
    if (!type_kind.is_error(gate_ty)) {
        ok = true;
        val res_gate: res[ast_expr.Expr, fail.Fail] = sema_context.expression(sc, cond);
        if (sel res_gate.ok) { ok = check.check_condition(sc, gate_ty, res_gate.ok.span); }
    }
    sema_context.walk_end(sc, outer);
    ret ok;
}

# the verdict of a deferred chain's gate, none when the gate is not a condition or its
# verdict is neither active nor inactive, which is reported at `cond_span`
pub fun deferred_gate_decide(sc: *sema_context.SemaContext, cond: ast_id.ExprId, cond_span: base_source.Span) res[opt[comptime_gate.GateVerdict], fail.Fail] {
    val gate_ty: type_kind.TypeId = infer.infer_expr(sc, cond);
    if (type_kind.is_error(gate_ty) || !check.check_condition(sc, gate_ty, cond_span)) { ret res[opt[comptime_gate.GateVerdict], fail.Fail].ok{opt[comptime_gate.GateVerdict].none{}}; }
    val res_stmt_gate_verdict: res[comptime_gate.GateVerdict, fail.Fail] = stmt_gate_verdict(sc, cond);
    if (sel res_stmt_gate_verdict.err) { ret res[opt[comptime_gate.GateVerdict], fail.Fail].err{res_stmt_gate_verdict.err}; }
    val v: comptime_gate.GateVerdict = res_stmt_gate_verdict.ok;
    if (v.outcome != comptime_gate.GATE_ACTIVE && v.outcome != comptime_gate.GATE_INACTIVE) {
        if (str_len(v.message) > 0) { sema_context.report(sc, v.diag, cond_span, v.message); }
        ret res[opt[comptime_gate.GateVerdict], fail.Fail].ok{opt[comptime_gate.GateVerdict].none{}};
    }
    ret res[opt[comptime_gate.GateVerdict], fail.Fail].ok{opt[comptime_gate.GateVerdict].some{v}};
}

# a statement gate's verdict in the walk's frame, recorded there for lowering once decided
fun stmt_gate_verdict(sc: *sema_context.SemaContext, cond: ast_id.ExprId) res[comptime_gate.GateVerdict, fail.Fail] {
    val res_evaluate_gate: res[comptime_gate.GateVerdict, fail.Fail] = comptime_gate.evaluate_gate[sema_context.SemaContext](sc.view.ctx, sc, sc.typing.caps, sc.view.a, sc.view.source, cond,
        sc.s.interner, comptime_gate.GATE_SCOPE_INSTANCE, false);
    if (sel res_evaluate_gate.ok) {
        if (res_evaluate_gate.ok.outcome == comptime_gate.GATE_ACTIVE)   { sema_context.gate_set(sc, cond, true); }
        if (res_evaluate_gate.ok.outcome == comptime_gate.GATE_INACTIVE) { sema_context.gate_set(sc, cond, false); }
    }
    ret res_evaluate_gate;
}

# whether a gate's verdict selects its arm
# ---
# v:   the verdict
# ret: true only when the gate is active
pub fun gate_verdict_truth(v: comptime_gate.GateVerdict) bool {
    ret v.outcome == comptime_gate.GATE_ACTIVE;
}

# how control leaves a statement the walk typed, read from the arms the build selects
# ---
# passes: control can reach the statement's end and go on to the one after it
# breaks: a `brk` in it leaves the innermost loop around it
pub rec Flow {
    passes: bool;
    breaks: bool;
}

val FLOW_ON: Flow = Flow{passes: true, breaks: false};
# a statement the walk refused or cannot decide claims neither, so no refusal follows from it
val FLOW_NONE: Flow = Flow{passes: false, breaks: false};

# `a` followed by `b`: a `brk` in `b` counts only when control can reach it
fun flow_then(a: Flow, b: Flow) Flow {
    ret Flow{passes: a.passes && b.passes, breaks: a.breaks || (a.passes && b.breaks)};
}

# types the body of the function `d` against its result type and holds where the body ends to
# the rules: neither a `noreturn` function nor one with a result type may reach the end of its
# body. a `naked` body is assembly, which ends however its instructions do, so only the
# `noreturn` rule holds there
# ---
# sc:     the sema context of the module or instance being typed
# d:      the function, which has a body
# fn_ret: its result type, nil for none
# ret:    ok, or an internal failure of the walk
pub fun infer_fun_body(sc: *sema_context.SemaContext, d: *ast_decl.Decl, fn_ret: type_kind.TypeId) err[fail.Fail] {
    val res_flow: res[Flow, fail.Fail] = infer_stmt(sc, d.data.fun_.body, fn_ret);
    if (sel res_flow.err)    { ret err[fail.Fail].err{res_flow.err}; }
    if (!res_flow.ok.passes) { ret err[fail.Fail].ok{}; }
    val opt_noreturn: opt[*ast_decl.Decorator] = decorator.get(sc.view.a, d, decorator.NORETURN);
    if (sel opt_noreturn.some) {
        sema_context.report(sc, diagnostic_kind.NORETURN_RETURNS, opt_noreturn.some.name, "the body of a `noreturn` function can reach its end. end it in a call to a `noreturn` function, an `asm` block marked `noreturn` or a `for` no `brk` leaves");
        ret err[fail.Fail].ok{};
    }
    if (sc.walk.naked || type_kind.is_nil(fn_ret) || type_kind.is_error(fn_ret)) { ret err[fail.Fail].ok{}; }
    val opt_body: opt[*ast_stmt.Stmt] = ast.get_stmt(sc.view.a, d.data.fun_.body);
    if (sel opt_body.none) { ret err[fail.Fail].err{fail.message("StmtId out of range")}; }
    val body:  base_source.Span = opt_body.some.span;
    var brace: base_source.Span = body;
    if (body.len > 0) { brace = base_source.Span{offset: body.offset + body.len - 1, len: 1}; }
    sema_context.report_note(sc, diagnostic_kind.RET_MISSING, brace, "the function states a result type, and control can reach the end of its body without returning one",
        "end every path with `ret`, or with a call to a `noreturn` function");
    ret err[fail.Fail].ok{};
}

# types the statement `sid` and everything under it, reporting what it finds to `sc`
# ---
# sc:     the sema context of the module being typed
# sid:    the statement, nil for none
# fn_ret: the return type of the enclosing function, which a `ret` is held to
# ret:    how control leaves the statement, or an internal failure: a statement id out of
#         range, an unknown statement kind, or a failure of a walk under it
pub fun infer_stmt(sc: *sema_context.SemaContext, sid: ast_id.StmtId, fn_ret: type_kind.TypeId) res[Flow, fail.Fail] {
    if (ast_id.stmt_is_nil(sid)) { ret res[Flow, fail.Fail].ok{FLOW_ON}; }
    val opt_stmt: opt[*ast_stmt.Stmt] = ast.get_stmt(sc.view.a, sid);
    if (!sel opt_stmt.some) { ret res[Flow, fail.Fail].err{fail.message("StmtId out of range")}; }
    val st: *ast_stmt.Stmt = opt_stmt.some;
    if (stack.exhausted()) {
        sema_context.refuse_nesting(sc, st.span);
        ret res[Flow, fail.Fail].ok{FLOW_NONE};
    }

    if (st.kind == ast_stmt.STMT_KIND_EXPR) {
        val ty: type_kind.TypeId = infer.infer_expr(sc, st.data.expr.expr);
        if (type.is_case_selector(sc.s.types, ty)) {
            sema_context.report(sc, diagnostic_kind.TAG_SELECTOR_VALUE, st.span, "a case selector is not a value");
        }
        ret res[Flow, fail.Fail].ok{Flow{passes: !sema_noreturn.call_ends(sc, st.data.expr.expr), breaks: false}};
    }
    if (st.kind == ast_stmt.STMT_KIND_BLOCK) {
        val outer_block: base_source.Span = sc.walk.block;
        sc.walk.block = st.span;
        val res_list: res[Flow, fail.Fail] = infer_stmt_list(sc, st.data.block.stmts_start, st.data.block.stmts_len, fn_ret);
        sc.walk.block = outer_block;
        ret res_list;
    }
    if (st.kind == ast_stmt.STMT_KIND_IF) { ret infer_if_chain(sc, sid, fn_ret, nil); }
    if (st.kind == ast_stmt.STMT_KIND_FOR) {
        val err_loop: err[fail.Fail] = guard.loop_begin(sc, st.span);
        if (sel err_loop.err) { ret res[Flow, fail.Fail].err{err_loop.err}; }
        if (!ast_id.expr_is_nil(st.data.for_.cond)) {
            val cond_ty: type_kind.TypeId = infer.infer_expr(sc, st.data.for_.cond);
            if (!type_kind.is_error(cond_ty)) { check.check_condition(sc, cond_ty, st.span); }
        }
        sc.walk.loop_depth = sc.walk.loop_depth + 1;
        val res_body: res[Flow, fail.Fail] = infer_stmt(sc, st.data.for_.body, fn_ret);
        sc.walk.loop_depth = sc.walk.loop_depth - 1;
        if (sel res_body.err) { ret res_body; }
        # a loop with a condition ends when the condition fails, a bare one only by a `brk` of its own
        ret res[Flow, fail.Fail].ok{Flow{passes: !ast_id.expr_is_nil(st.data.for_.cond) || res_body.ok.breaks, breaks: false}};
    }
    if (st.kind == ast_stmt.STMT_KIND_RET) {
        if (sc.walk.in_fin) {
            sema_context.report(sc, diagnostic_kind.FIN_RET, st.span, "`ret` cannot appear inside a `fin` body");
        }
        check_return_stmt(sc, fn_ret, st.data.ret_.value, st.span);
        if (sc.walk.in_test) { check_test_status(sc, st.data.ret_.value, st.span); }
        ret res[Flow, fail.Fail].ok{FLOW_NONE};
    }
    if (st.kind == ast_stmt.STMT_KIND_BRK) {
        if (sc.walk.loop_depth == 0) {
            if (sc.walk.in_fin) { sema_context.report(sc, diagnostic_kind.FIN_JUMP, st.span, "`brk` inside a `fin` body cannot target a loop outside the fin"); }
            or                  { sema_context.report(sc, diagnostic_kind.JUMP_NO_LOOP, st.span, "`brk` is outside any loop. it leaves the innermost enclosing `for`"); }
        }
        ret res[Flow, fail.Fail].ok{Flow{passes: false, breaks: true}};
    }
    if (st.kind == ast_stmt.STMT_KIND_CNT) {
        if (sc.walk.loop_depth == 0) {
            if (sc.walk.in_fin) { sema_context.report(sc, diagnostic_kind.FIN_JUMP, st.span, "`cnt` inside a `fin` body cannot target a loop outside the fin"); }
            or                  { sema_context.report(sc, diagnostic_kind.JUMP_NO_LOOP, st.span, "`cnt` is outside any loop. it continues the innermost enclosing `for`"); }
        }
        ret res[Flow, fail.Fail].ok{FLOW_NONE};
    }
    if (st.kind == ast_stmt.STMT_KIND_FIN) {
        val err_fin: err[fail.Fail] = guard.fin_begin(sc, sid, st.span);
        if (sel err_fin.err) { ret res[Flow, fail.Fail].err{err_fin.err}; }
        val outer: sema_context.Walk = sema_context.walk_begin(sc);
        sc.walk.in_fin     = true;
        sc.walk.loop_depth = 0;
        val res_body: res[Flow, fail.Fail] = infer_stmt(sc, st.data.fin_.body, fn_ret);
        sema_context.walk_end(sc, outer);
        guard.fin_end(sc, sid);
        if (sel res_body.err) { ret res_body; }
        # the body runs when the block exits, not here, so control passes a `fin`
        ret res[Flow, fail.Fail].ok{FLOW_ON};
    }
    if (st.kind == ast_stmt.STMT_KIND_DECL) {
        val err_decl: err[fail.Fail] = infer_local_decl(sc, st.data.decl.decl);
        if (sel err_decl.err) { ret res[Flow, fail.Fail].err{err_decl.err}; }
        ret res[Flow, fail.Fail].ok{FLOW_ON};
    }
    if (st.kind == ast_stmt.STMT_KIND_COMPTIME_IF) {
        ret infer_stmt_comptime_if(sc, st.data.comptime_if.branches_start, st.data.comptime_if.branches_len, fn_ret, st.span);
    }
    if (st.kind == ast_stmt.STMT_KIND_COMPTIME_EACH) {
        ret walk_stmt_comptime_each(sc, sid, ?st.data.comptime_each, st.span, fn_ret);
    }
    if (st.kind == ast_stmt.STMT_KIND_COMPTIME_DIRECTIVE) {
        eval_comptime_directive(sc, st.data.comptime_directive.target, st.span);
        # a `$error` refuses the build wherever the walk reaches it, so nothing after it runs
        ret res[Flow, fail.Fail].ok{Flow{passes: !intrinsic.is_error_call(sc.view.a, sc.view.source, st.data.comptime_directive.target), breaks: false}};
    }
    if (st.kind == ast_stmt.STMT_KIND_ASM) {
        asm_target_check(sc, st.span);
        asm_head_check(sc, st.data.asm_.head);
        # the walk reaches only the arms the build selects, so a block in a discarded arm is never judged
        if (sc.walk.naked && sc.view.rr != nil && resolve.asm_binds_any(sc.view.rr, sid)) {
            sema_context.report(sc, diagnostic_kind.ASM_OPERAND, st.span, "an asm block of a `#[naked]` function binds a local, which the function has no frame to hold");
        }
        ret res[Flow, fail.Fail].ok{Flow{passes: !st.data.asm_.noreturn, breaks: false}};
    }
    if (st.kind == ast_stmt.STMT_KIND_ERROR) { ret res[Flow, fail.Fail].ok{FLOW_NONE}; }
    val failure: fail.Fail = resolve.unknown_catalog(sc.s, "StmtKind", st.kind::u32);
    report_phase.internal(?sc.status, failure);
    ret res[Flow, fail.Fail].err{failure};
}

# an asm block needs an instruction set that takes assembly
fun asm_target_check(sc: *sema_context.SemaContext, span: base_source.Span) {
    if (sc.view.ctx == nil || sc.view.ctx.env.target.has_assembly) { ret; }
    sema_context.reportf(sc, diagnostic_kind.ASM_UNAVAILABLE, span, "inline assembly is not allowed on instruction set '{}', which declares no assembly capability",
        target_tags.arch_name(sc.view.ctx.env.target.arch_id));
}

# a surviving block's head names a selection of masc's for the compile target, read
# through masc whole. a previous major's identifier is refused naming its rewrite
fun asm_head_check(sc: *sema_context.SemaContext, head: base_source.Span) {
    if (head.len == 0 || sc.view.ctx == nil) { ret; }
    if (transition.head_of(sc.view.source, head) != nil) {
        check.refuse_form(sc, transition.ASM_HEAD, head);
        ret;
    }
    if (!sc.view.ctx.env.target.has_assembly) { ret; }
    val res_text: res[str, StrError] = str_copy_slice(sc.s.alloc, sc.view.source, head.offset, head.len);
    if (sel res_text.err) {
        report_phase.internal(?sc.status, fail.str_refused(res_text.err));
        ret;
    }
    fin { str_free(sc.s.alloc, res_text.ok); }
    val verdict: target_baseline.Head = target_baseline.head_read(sc.s.alloc, target_tags.arch_name(sc.view.ctx.env.target.arch_id), res_text.ok);
    if (verdict.refused == nil) { ret; }
    sema_context.report_note(sc, diagnostic_kind.ASM_HEAD, head, verdict.refused, verdict.note);
}

# whether the directive at `span` is a `$error` that fired, reported as the walk reports
pub fun eval_comptime_directive(sc: *sema_context.SemaContext, target: ast_id.ExprId, span: base_source.Span) bool {
    if (ast_id.expr_is_nil(target))                                  { ret false; }
    if (sc.walk.arm == sema_context.ARM_DEFERRED)                    { ret false; }
    if (!intrinsic.is_error_call(sc.view.a, sc.view.source, target)) { ret false; }

    val outer: sema_context.Walk = sema_context.walk_begin(sc);
    if (sc.walk.arm == sema_context.ARM_SELECTED) { sc.walk.silent = false; }
    val res_msg: res[str, comptime_failure.EvalFail] = comptime.error_message[sema_context.SemaContext](sc.view.ctx, sc, sc.typing.caps, sc.view.a, sc.view.source, target, sc.s.interner);
    if (sel res_msg.err) {
        val f: comptime_failure.EvalFail = res_msg.err;
        if (f.kind == comptime_failure.EVAL_FAIL_INTERNAL) { sema_context.report_internal(sc, span, fail.message(f.message)); }
        or                                                 { sema_context.report(sc, f.diag, span, f.message); }
    }
    or { sema_context.report(sc, diagnostic_kind.COMPTIME_USER_ERROR, span, res_msg.ok); }
    sema_context.walk_end(sc, outer);
    ret true;
}

# one iteration of the `$each` at `sid`, typed in a frame of its own under the walk's
rec EachIteration {
    sid:    ast_id.StmtId;
    index:  u32;
    fn_ret: type_kind.TypeId;
}

# visits one iteration's body in its own frame under the walk's, when the module records
# instances, and in the walk's frame otherwise
fun each_iteration_visit(sc: *sema_context.SemaContext, it: EachIteration, start: u32, len: u32, pack: bool) res[Flow, fail.Fail] {
    if (sc.typing.insts == nil) { ret infer_stmt_list(sc, start, len, it.fn_ret); }
    val res_made: res[u32, fail.Fail] = sema_instance.iteration_add(?sc.typing.insts.set, sc.instance.frame, it.sid, it.index);
    if (sel res_made.err) { ret res[Flow, fail.Fail].err{res_made.err}; }
    val saved_frame: u32               = sc.instance.frame;
    val saved_quiet: bool              = sc.instance.quiet;
    val outer:       sema_context.Walk = sema_context.walk_begin(sc);
    sc.instance.frame = res_made.ok;
    # an `$each` over a pack is the one body a pack's template cannot type, so its instance
    # reports what it finds there, until the module has an error to show
    if (pack && sc.instance.quiet) {
        if (sel sc.status.kind.accepted) {
            sc.instance.quiet = false;
            sc.walk.silent    = false;
        }
    }
    val res_visit: res[Flow, fail.Fail] = infer_stmt_list(sc, start, len, it.fn_ret);
    sc.instance.frame = saved_frame;
    sc.instance.quiet = saved_quiet;
    sema_context.walk_end(sc, outer);
    ret res_visit;
}

# types the body of the `$each` at `sid` once per element of its sequence: a field or case
# of a type, an element of a pack, or an element of a constant array. control passes it when
# it passes every iteration, so an empty sequence passes
fun walk_stmt_comptime_each(sc: *sema_context.SemaContext, sid: ast_id.StmtId, ce: *ast_stmt.StmtComptimeEach, span: base_source.Span, fn_ret: type_kind.TypeId) res[Flow, fail.Fail] {
    var it:         EachIteration = EachIteration{sid: sid, index: 0, fn_ret: fn_ret};
    val over_cases: bool          = intrinsic.is_cases_call(sc.view.a, sc.view.source, ce.seq);
    if (!intrinsic.is_fields_call(sc.view.a, sc.view.source, ce.seq) && !over_cases) {
        val seq_ty:  type_kind.TypeId = infer.infer_expr(sc, ce.seq);
        val opt_seq: opt[*type.Type]  = type.get(sc.s.types, seq_ty);
        if (sel opt_seq.some) {
            if (opt_seq.some.kind == type_kind.TYPE_PACK) {
                ret infer_pack_each(sc, ce, it);
            }
        }
        if (sel opt_seq.some) {
            if (opt_seq.some.kind == type_kind.TYPE_ARRAY) {
                ret infer_const_array_each(sc, ce, span, it, seq_ty);
            }
        }
        if (!type_kind.is_error(seq_ty)) {
            sema_context.report(sc, diagnostic_kind.EACH_SEQUENCE, span, "a `$each` sequence must be `$fields(T)`, `$cases(T)`, a variadic pack, or a constant array `val`");
        }
        ret res[Flow, fail.Fail].ok{FLOW_NONE};
    }

    var owner: type_kind.TypeId = type_kind.TYPE_ERROR;
    if (over_cases)                             { owner = infer.case_seq_owner(sc, ce.seq, span); }
    or                                          { owner = infer.field_seq_owner(sc, ce.seq, span); }
    if (type_kind.is_error(owner))              { ret res[Flow, fail.Fail].ok{FLOW_NONE}; }
    if (infer.type_is_generic_param(sc, owner)) { ret res[Flow, fail.Fail].ok{FLOW_NONE}; }

    val res_name: res[intern.StrId, A.Error] = intern.range_add(sc.s.interner, sc.view.source, ce.var_name.offset, ce.var_name.len);
    if (sel res_name.err) { ret res[Flow, fail.Fail].err{fail.refused(res_name.err)}; }
    val fname: intern.StrId = res_name.ok;

    val n:    u32  = type.field_count(sc.s.types, owner);
    var flow: Flow = FLOW_ON;
    var i:    u32  = 0;
    for (i < n) {
        val res_mark: res[comptime_scope.FrameMark, fail.Fail] = comptime_scope.frame_begin(sc.view.ctx);
        if (sel res_mark.err) { ret res[Flow, fail.Fail].err{res_mark.err}; }
        val mark: comptime_scope.FrameMark = res_mark.ok;
        var desc: comptime_value.CTValue   = comptime_value.field_value(owner::u32, i);
        if (over_cases) { desc = comptime_value.case_value(owner::u32, i); }
        val err_bind: err[fail.Fail] = comptime_scope.bind_local(sc.view.ctx, fname, desc);
        if (sel err_bind.err) {
            val err_close: err[fail.Fail] = comptime_scope.frame_end(sc.view.ctx, mark);
            if (sel err_close.err) { ret res[Flow, fail.Fail].err{err_close.err}; }
            ret res[Flow, fail.Fail].err{err_bind.err};
        }
        it.index = i;
        val res_body:  res[Flow, fail.Fail] = each_iteration_visit(sc, it, ce.body_start, ce.body_len, false);
        val err_close: err[fail.Fail]       = comptime_scope.frame_end(sc.view.ctx, mark);
        if (sel res_body.err)  { ret res_body; }
        if (sel err_close.err) { ret res[Flow, fail.Fail].err{err_close.err}; }
        flow = flow_then(flow, res_body.ok);
        i    = i + 1;
    }
    ret res[Flow, fail.Fail].ok{flow};
}

# an `$each` over a pack, typed once per element where an instance binds the pack; a
# template binds none and leaves the body to its instances
fun infer_pack_each(sc: *sema_context.SemaContext, ce: *ast_stmt.StmtComptimeEach, it: EachIteration) res[Flow, fail.Fail] {
    if (!sema_context.walk_binds_pack(sc)) { ret res[Flow, fail.Fail].ok{FLOW_NONE}; }
    val res_name: res[intern.StrId, A.Error] = intern.range_add(sc.s.interner, sc.view.source, ce.var_name.offset, ce.var_name.len);
    if (sel res_name.err) { ret res[Flow, fail.Fail].err{fail.refused(res_name.err)}; }
    val fname: intern.StrId  = res_name.ok;
    var at:    EachIteration = it;
    var flow:  Flow          = FLOW_ON;
    var i:     u32           = 0;
    for (i < sc.instance.pack_len) {
        val res_mark: res[comptime_scope.FrameMark, fail.Fail] = comptime_scope.frame_begin(sc.view.ctx);
        if (sel res_mark.err) { ret res[Flow, fail.Fail].err{res_mark.err}; }
        val mark:     comptime_scope.FrameMark = res_mark.ok;
        val err_bind: err[fail.Fail]           = comptime_scope.bind_local(sc.view.ctx, fname, comptime_value.pack_elem_value(i, sc.instance.pack_types[i]::u32));
        if (sel err_bind.err) {
            val err_close: err[fail.Fail] = comptime_scope.frame_end(sc.view.ctx, mark);
            if (sel err_close.err) { ret res[Flow, fail.Fail].err{err_close.err}; }
            ret res[Flow, fail.Fail].err{err_bind.err};
        }
        at.index = i;
        val res_body:  res[Flow, fail.Fail] = each_iteration_visit(sc, at, ce.body_start, ce.body_len, true);
        val err_close: err[fail.Fail]       = comptime_scope.frame_end(sc.view.ctx, mark);
        if (sel res_body.err)  { ret res_body; }
        if (sel err_close.err) { ret res[Flow, fail.Fail].err{err_close.err}; }
        flow = flow_then(flow, res_body.ok);
        i    = i + 1;
    }
    ret res[Flow, fail.Fail].ok{flow};
}

# an `$each` over a constant array, typed once per element of the array's published value with
# the loop variable naming that element; lowering reads the same value from the frame
fun infer_const_array_each(sc: *sema_context.SemaContext, ce: *ast_stmt.StmtComptimeEach, span: base_source.Span, it: EachIteration, seq_ty: type_kind.TypeId) res[Flow, fail.Fail] {
    val opt_arr: opt[*type.Type] = type.get(sc.s.types, seq_ty);
    if (!sel opt_arr.some) { ret res[Flow, fail.Fail].ok{FLOW_NONE}; }
    val arr:     *type.Type       = opt_arr.some;
    val elem_ty: type_kind.TypeId = arr.data.array.base;
    val count:   u32              = arr.data.array.count;

    val opt_sym: opt[*resolve.Symbol] = sema_context.symbol_for_expr(sc, ce.seq);
    if (!sel opt_sym.some) {
        sema_context.report(sc, diagnostic_kind.EACH_SEQUENCE, span, "a `$each` array sequence must name an array `val`");
        ret res[Flow, fail.Fail].ok{FLOW_NONE};
    }
    val sym:  *resolve.Symbol = opt_sym.some;
    var kind: resolve.SymKind = sym.kind;
    if (kind == resolve.SYM_IMPORTED) { kind = sym.definition_kind; }
    if (kind == resolve.SYM_VAR) {
        sema_context.report(sc, diagnostic_kind.EACH_MUTABLE, span, "a `$each` array sequence must be a `val`, because a `var` is not a compile-time constant");
        ret res[Flow, fail.Fail].ok{FLOW_NONE};
    }
    if (kind != resolve.SYM_VAL) {
        sema_context.report(sc, diagnostic_kind.EACH_SEQUENCE, span, "a `$each` array sequence must name an array `val`");
        ret res[Flow, fail.Fail].ok{FLOW_NONE};
    }

    val opt_elem: opt[*type.Type] = type.get(sc.s.types, elem_ty);
    if (sel opt_elem.some) {
        if (opt_elem.some.kind == type_kind.TYPE_ARRAY) {
            sema_context.report(sc, diagnostic_kind.EACH_ELEMENT_TYPE, span, "a `$each` array element must be a scalar or a record, not an array");
            ret res[Flow, fail.Fail].ok{FLOW_NONE};
        }
    }

    val res_valued: res[opt[comptime_value.CTValue], fail.Fail] = sema_constant.array_value(sc, sym);
    if (sel res_valued.err) { ret res[Flow, fail.Fail].err{res_valued.err}; }
    if (sel res_valued.ok.none) {
        sema_context.report(sc, diagnostic_kind.EACH_INITIALIZER, span, "a `$each` array sequence must be initialized with an array literal");
        ret res[Flow, fail.Fail].ok{FLOW_NONE};
    }
    val array:     comptime_value.CTValue                               = res_valued.ok.some;
    val res_store: res[*comptime_deep.Store, comptime_failure.EvalFail] = sema_constant.store_of(sc, array.data.node.module);
    if (sel res_store.err) { ret res[Flow, fail.Fail].err{fail.message(res_store.err.message)}; }
    val store: *comptime_deep.Store = res_store.ok;
    val node:  comptime_deep.Node   = comptime_deep.node_of(array);
    val shape: *comptime_deep.Shape = comptime_deep.shape_at(store, node);
    if (shape.kind != comptime_deep.NODE_ARRAY) {
        sema_context.report(sc, diagnostic_kind.EACH_INITIALIZER, span, "a `$each` array sequence must be initialized with an array literal");
        ret res[Flow, fail.Fail].ok{FLOW_NONE};
    }
    if (shape.len != count) {
        sema_context.report(sc, diagnostic_kind.EACH_INITIALIZER, span, "every element of a `$each` array needs an initializer");
        ret res[Flow, fail.Fail].ok{FLOW_NONE};
    }
    sema_context.each_set(sc, it.sid, array);

    val res_name: res[intern.StrId, A.Error] = intern.range_add(sc.s.interner, sc.view.source, ce.var_name.offset, ce.var_name.len);
    if (sel res_name.err) { ret res[Flow, fail.Fail].err{fail.refused(res_name.err)}; }
    val fname: intern.StrId  = res_name.ok;
    var at:    EachIteration = it;
    var flow:  Flow          = FLOW_ON;
    var i:     u32           = 0;
    for (i < count) {
        val opt_elem: opt[comptime_deep.Member] = comptime_deep.member_at(store, node, i);
        if (sel opt_elem.none) { ret res[Flow, fail.Fail].err{fail.message("sema: `$each` array element index out of range")}; }
        val res_mark: res[comptime_scope.FrameMark, fail.Fail] = comptime_scope.frame_begin(sc.view.ctx);
        if (sel res_mark.err) { ret res[Flow, fail.Fail].err{res_mark.err}; }
        val mark:     comptime_scope.FrameMark = res_mark.ok;
        val err_bind: err[fail.Fail]           = comptime_scope.bind_local(sc.view.ctx, fname, comptime_deep.node_ref(array.data.node.module, opt_elem.some.node, type_kind.index(elem_ty)));
        if (sel err_bind.err) {
            val err_close: err[fail.Fail] = comptime_scope.frame_end(sc.view.ctx, mark);
            if (sel err_close.err) { ret res[Flow, fail.Fail].err{err_close.err}; }
            ret res[Flow, fail.Fail].err{err_bind.err};
        }
        at.index = i;
        val res_body:  res[Flow, fail.Fail] = each_iteration_visit(sc, at, ce.body_start, ce.body_len, false);
        val err_close: err[fail.Fail]       = comptime_scope.frame_end(sc.view.ctx, mark);
        if (sel res_body.err)  { ret res_body; }
        if (sel err_close.err) { ret res[Flow, fail.Fail].err{err_close.err}; }
        flow = flow_then(flow, res_body.ok);
        i    = i + 1;
    }
    ret res[Flow, fail.Fail].ok{flow};
}

# an `if` and its `or` arms, walked as one chain so its final bare `or` is guarded by every arm
# before it. when `arms_exit` is non-nil and the chain has no bare `or`, sets `@arms_exit` to whether
# every arm exits. control passes the chain when it passes an arm, or when neither a bare `or` nor
# tests naming every case of one tag close it
fun infer_if_chain(sc: *sema_context.SemaContext, head: ast_id.StmtId, fn_ret: type_kind.TypeId, arms_exit: *bool) res[Flow, fail.Fail] {
    if (arms_exit != nil) { @arms_exit = false; }
    var flow: Flow          = FLOW_NONE;
    var cur:  ast_id.StmtId = head;
    for {
        val opt_stmt: opt[*ast_stmt.Stmt] = ast.get_stmt(sc.view.a, cur);
        if (!sel opt_stmt.some) { ret res[Flow, fail.Fail].err{fail.message("StmtId out of range")}; }
        val st: *ast_stmt.Stmt = opt_stmt.some;
        if (stack.exhausted()) {
            sema_context.refuse_nesting(sc, st.span);
            ret res[Flow, fail.Fail].ok{FLOW_NONE};
        }
        val cond_ty: type_kind.TypeId = infer.infer_expr(sc, st.data.if_.cond);
        if (!type_kind.is_error(cond_ty)) { check.check_condition(sc, cond_ty, st.span); }
        var arm_guard:  sema_context.Guard;
        val res_opened: res[bool, fail.Fail] = guard.sel_begin(sc, st.data.if_.cond, ?arm_guard);
        if (sel res_opened.err) { ret res[Flow, fail.Fail].err{res_opened.err}; }
        val res_then: res[Flow, fail.Fail] = infer_stmt(sc, st.data.if_.then_block, fn_ret);
        if (res_opened.ok)    { guard.end(sc, ?arm_guard); }
        if (sel res_then.err) { ret res_then; }
        flow = flow_either(flow, res_then.ok);

        val next: ast_id.StmtId = st.data.if_.else_block;
        if (ast_id.stmt_is_nil(next)) {
            if (arms_exit != nil) { @arms_exit = !flow.passes; }
            # with no bare `or` control passes the chain unless its tests name every case of one tag
            val res_exhausts: res[bool, fail.Fail] = guard.chain_exhausts(sc, head);
            if (sel res_exhausts.err) { ret res[Flow, fail.Fail].err{res_exhausts.err}; }
            ret res[Flow, fail.Fail].ok{Flow{passes: flow.passes || !res_exhausts.ok, breaks: flow.breaks}};
        }
        val opt_next: opt[*ast_stmt.Stmt] = ast.get_stmt(sc.view.a, next);
        if (!sel opt_next.some) { ret res[Flow, fail.Fail].err{fail.message("StmtId out of range")}; }
        if (opt_next.some.kind == ast_stmt.STMT_KIND_IF) {
            cur = next;
            cnt;
        }
        var or_guard:    sema_context.Guard;
        val res_guarded: res[bool, fail.Fail] = guard.final_or_begin(sc, head, ?or_guard);
        if (sel res_guarded.err) { ret res[Flow, fail.Fail].err{res_guarded.err}; }
        val res_tail: res[Flow, fail.Fail] = infer_stmt(sc, next, fn_ret);
        if (res_guarded.ok)   { guard.end(sc, ?or_guard); }
        if (sel res_tail.err) { ret res_tail; }
        ret res[Flow, fail.Fail].ok{flow_either(flow, res_tail.ok)};
    }
}

# one of two arms: control passes when it passes either, and either may break
fun flow_either(a: Flow, b: Flow) Flow {
    ret Flow{passes: a.passes || b.passes, breaks: a.breaks || b.breaks};
}

# types a run of statements, walking the rest of the run inside the guard an exiting chain opens
fun infer_stmt_list(sc: *sema_context.SemaContext, start: u32, len: u32, fn_ret: type_kind.TypeId) res[Flow, fail.Fail] {
    var flow: Flow = FLOW_ON;
    var i:    u32  = 0;
    for (i < len) {
        val sid:   ast_id.StmtId = sc.view.a.stmt_ids.data[start + i];
        var is_if: bool          = false;
        if (!ast_id.stmt_is_nil(sid)) {
            val opt_stmt: opt[*ast_stmt.Stmt] = ast.get_stmt(sc.view.a, sid);
            if (sel opt_stmt.some) { is_if = opt_stmt.some.kind == ast_stmt.STMT_KIND_IF; }
        }
        var arms_exit: bool                 = false;
        var res_stmt:  res[Flow, fail.Fail] = res[Flow, fail.Fail].ok{FLOW_ON};
        if (is_if)            { res_stmt = infer_if_chain(sc, sid, fn_ret, ?arms_exit); }
        or                    { res_stmt = infer_stmt(sc, sid, fn_ret); }
        if (sel res_stmt.err) { ret res_stmt; }
        flow = flow_then(flow, res_stmt.ok);
        i    = i + 1;
        # an exiting chain guards the rest of the block, so the rest is walked inside its frame
        if (arms_exit) {
            var rest_guard: sema_context.Guard;
            val res_opened: res[bool, fail.Fail] = guard.exit_chain_begin(sc, sid, ?rest_guard);
            if (sel res_opened.err) { ret res[Flow, fail.Fail].err{res_opened.err}; }
            if (res_opened.ok) {
                val res_rest: res[Flow, fail.Fail] = infer_stmt_list(sc, start + i, len - i, fn_ret);
                guard.end(sc, ?rest_guard);
                if (sel res_rest.err) { ret res_rest; }
                ret res[Flow, fail.Fail].ok{flow_then(flow, res_rest.ok)};
            }
        }
    }
    ret res[Flow, fail.Fail].ok{flow};
}

fun gate_probe_ident_is_comptime_param(sc: *sema_context.SemaContext, eid: ast_id.ExprId) bool {
    val opt_sym: opt[*resolve.Symbol] = sema_context.symbol_for_expr(sc, eid);
    if (!sel opt_sym.some) { ret false; }
    val sym: *resolve.Symbol = opt_sym.some;
    ret sym.kind == resolve.SYM_PARAM && (sym.flags & resolve.SYM_FLAG_COMPTIME) != 0;
}

fun sema_gate_probes() comptime_gate.GateProbes[sema_context.SemaContext] {
    ret comptime_gate.gate_probes[sema_context.SemaContext](
        gate_probe_ident_is_comptime_param, nil, nil, infer.is_field_type_operand, sema_context.comptime_expression);
}

fun gate_chain_depends(sc: *sema_context.SemaContext, probe: comptime_gate.GateProbe,
    start: u32, len: u32) res[bool, fail.Fail] {
    ret comptime_gate.gate_chain_depends_on[sema_context.SemaContext](sc.view.a, sc.view.source, sc, sema_gate_probes(),
        probe, start, len);
}

# types a comptime `$if` chain: the selected arm alone, every arm deferred when a gate reads
# a comptime parameter no instance binds or a type comparison it cannot decide, and no arm
# while a compared type waits for its instantiation. control passes the selected arm's way,
# and passes a chain that selects none. a deferred chain stands for every instance, so control
# passes it when it passes an arm or no bare `$or` closes it
fun infer_stmt_comptime_if(sc: *sema_context.SemaContext, start: u32, len: u32, fn_ret: type_kind.TypeId, span: base_source.Span) res[Flow, fail.Fail] {
    val res_param_gated: res[bool, fail.Fail] = gate_chain_depends(sc, comptime_gate.GATE_PROBE_COMPTIME_PARAM, start, len);
    if (sel res_param_gated.err) { ret flow_of(gate_refused(sc, span, res_param_gated.err), FLOW_NONE); }
    val param_gated:      bool                 = res_param_gated.ok;
    val res_has_type_cmp: res[bool, fail.Fail] = gate_chain_depends(sc, comptime_gate.GATE_PROBE_TYPE_COMPARISON, start, len);
    if (sel res_has_type_cmp.err) { ret flow_of(gate_refused(sc, span, res_has_type_cmp.err), FLOW_NONE); }
    val has_type_cmp: bool = res_has_type_cmp.ok;

    if (has_type_cmp && !param_gated) {
        var pruned_flow: Flow               = FLOW_ON;
        val res_pruned:  res[u8, fail.Fail] = prune_type_comparison_chain(sc, start, len, fn_ret, ?pruned_flow);
        if (sel res_pruned.err)              { ret res[Flow, fail.Fail].err{res_pruned.err}; }
        if (res_pruned.ok == PRUNE_SELECTED) { ret res[Flow, fail.Fail].ok{pruned_flow}; }
        # a gate reading a type no instantiation has pinned down yet is decided at the instantiation,
        # so no arm is selected and none is checked here
        if (res_pruned.ok == PRUNE_UNINSTANTIATED) { ret res[Flow, fail.Fail].ok{FLOW_NONE}; }
    }

    # a value instance binds the parameters the chain reads, so it selects the arm
    val per_instance: bool = param_gated && sema_context.walk_binds_values(sc);
    if ((param_gated || has_type_cmp) && !per_instance) {
        var flow:      Flow = FLOW_NONE;
        var closed:    bool = false;
        var chain_bad: bool = false;
        var i:         u32  = 0;
        for (i < len) {
            val arm: *ast_decl.ComptimeBranch = ?sc.view.a.comptime_branches.data[start + i];
            if (ast_id.expr_is_nil(arm.cond)) { closed = true; }
            or {
                if (!gate_condition_check(sc, arm.cond)) { chain_bad = true; }
                val err_check_comptime_gate: err[fail.Fail] = check_comptime_gate(sc, arm.cond);
                if (sel err_check_comptime_gate.err) { ret res[Flow, fail.Fail].err{err_check_comptime_gate.err}; }
            }
            if (!chain_bad) {
                val outer: sema_context.Walk = sema_context.walk_begin(sc);
                sc.walk.arm = sema_context.ARM_DEFERRED;
                val res_body: res[Flow, fail.Fail] = infer_comptime_arm(sc, arm, fn_ret);
                sema_context.walk_end(sc, outer);
                if (sel res_body.err) { ret res_body; }
                flow = flow_either(flow, res_body.ok);
            }
            i = i + 1;
        }
        if (chain_bad) { ret res[Flow, fail.Fail].ok{FLOW_NONE}; }
        if (!closed)   { flow.passes = true; }
        ret res[Flow, fail.Fail].ok{flow};
    }
    ret select_arm(sc, start, len, fn_ret, per_instance);
}

# a walk's result `e` carried with the flow `f`
fun flow_of(e: err[fail.Fail], f: Flow) res[Flow, fail.Fail] {
    if (sel e.err) { ret res[Flow, fail.Fail].err{e.err}; }
    ret res[Flow, fail.Fail].ok{f};
}

# the first arm whose gate holds, typed. a chain gated on comptime parameters is selected
# per instance: its template could only check the gates and arms, so the instance reports
# its gates' verdicts and each `$error` the selected arm reaches, quiet or not
fun select_arm(sc: *sema_context.SemaContext, start: u32, len: u32, fn_ret: type_kind.TypeId, per_instance: bool) res[Flow, fail.Fail] {
    val outer_arm: u8 = sc.walk.arm;
    if (per_instance) { sc.walk.arm = sema_context.ARM_SELECTED; }
    var res_arm: res[Flow, fail.Fail] = res[Flow, fail.Fail].ok{FLOW_ON};
    var i:       u32                  = 0;
    for (i < len) {
        val br: *ast_decl.ComptimeBranch = ?sc.view.a.comptime_branches.data[start + i];
        if (!ast_id.expr_is_nil(br.cond)) {
            if (!gate_condition_check(sc, br.cond)) {
                res_arm = res[Flow, fail.Fail].ok{FLOW_NONE};
                brk;
            }
        }
        val gate: sema_context.Walk = sema_context.walk_begin(sc);
        if (per_instance) { sc.walk.silent = false; }
        val res_active: res[bool, fail.Fail] = stmt_comptime_branch_active(sc, br);
        sema_context.walk_end(sc, gate);
        if (sel res_active.err) {
            res_arm = res[Flow, fail.Fail].err{res_active.err};
            brk;
        }
        if (res_active.ok) {
            res_arm = infer_comptime_arm(sc, br, fn_ret);
            brk;
        }
        i = i + 1;
    }
    sc.walk.arm = outer_arm;
    ret res_arm;
}

# a comptime arm is a chain arm: a condition that is exactly `sel P.c` guards `P.c` in its body
fun infer_comptime_arm(sc: *sema_context.SemaContext, br: *ast_decl.ComptimeBranch, fn_ret: type_kind.TypeId) res[Flow, fail.Fail] {
    var arm_guard:  sema_context.Guard;
    val res_opened: res[bool, fail.Fail] = guard.sel_begin(sc, br.cond, ?arm_guard);
    if (sel res_opened.err) { ret res[Flow, fail.Fail].err{res_opened.err}; }
    val res_body: res[Flow, fail.Fail] = infer_stmt_list(sc, br.body_start, br.body_len, fn_ret);
    if (res_opened.ok) { guard.end(sc, ?arm_guard); }
    ret res_body;
}

# whether a comptime arm is taken, reporting a gate that failed to evaluate
fun stmt_comptime_branch_active(sc: *sema_context.SemaContext, br: *ast_decl.ComptimeBranch) res[bool, fail.Fail] {
    if (ast_id.expr_is_nil(br.cond)) { ret res[bool, fail.Fail].ok{true}; }
    val res_stmt_gate_verdict: res[comptime_gate.GateVerdict, fail.Fail] = stmt_gate_verdict(sc, br.cond);
    if (sel res_stmt_gate_verdict.err) {
        ret res[bool, fail.Fail].err{res_stmt_gate_verdict.err};
    }
    val v: comptime_gate.GateVerdict = res_stmt_gate_verdict.ok;
    if (v.outcome == comptime_gate.GATE_FAILED && str_len(v.message) > 0) {
        val outer: sema_context.Walk = sema_context.walk_begin(sc);
        sc.walk.in_comptime_gate = true;
        sema_context.report(sc, v.diag, v.span, v.message);
        sema_context.walk_end(sc, outer);
    }
    ret res[bool, fail.Fail].ok{gate_verdict_truth(v)};
}

val PRUNE_SELECTED:       u8 = 0;
val PRUNE_UNDECIDABLE:    u8 = 1;
val PRUNE_UNINSTANTIATED: u8 = 2;

# walks a `$type_of`-gated chain and type-checks only the arm this instantiation selects; an arm is
# never selected while an earlier gate is still undecided. `flow` takes the selected arm's flow,
# and stays as given when no arm is selected
fun prune_type_comparison_chain(sc: *sema_context.SemaContext, start: u32, len: u32, fn_ret: type_kind.TypeId, flow: *Flow) res[u8, fail.Fail] {
    var i: u32 = 0;
    for (i < len) {
        val arm: *ast_decl.ComptimeBranch = ?sc.view.a.comptime_branches.data[start + i];
        if (ast_id.expr_is_nil(arm.cond)) {
            val res_body: res[Flow, fail.Fail] = infer_stmt_list(sc, arm.body_start, arm.body_len, fn_ret);
            if (sel res_body.err) { ret res[u8, fail.Fail].err{res_body.err}; }
            @flow = res_body.ok;
            ret res[u8, fail.Fail].ok{PRUNE_SELECTED};
        }

        if (!gate_condition_check(sc, arm.cond)) {
            @flow = FLOW_NONE;
            ret res[u8, fail.Fail].ok{PRUNE_SELECTED};
        }

        val res_stmt_gate_verdict: res[comptime_gate.GateVerdict, fail.Fail] = stmt_gate_verdict(sc, arm.cond);
        if (sel res_stmt_gate_verdict.err) {
            ret res[u8, fail.Fail].err{res_stmt_gate_verdict.err};
        }
        val v: comptime_gate.GateVerdict = res_stmt_gate_verdict.ok;
        if (v.outcome == comptime_gate.GATE_AWAITING_INSTANCE) { ret res[u8, fail.Fail].ok{PRUNE_UNINSTANTIATED}; }
        if (v.outcome != comptime_gate.GATE_ACTIVE && v.outcome != comptime_gate.GATE_INACTIVE) {
            ret res[u8, fail.Fail].ok{PRUNE_UNDECIDABLE};
        }
        if (gate_verdict_truth(v)) {
            val res_body: res[Flow, fail.Fail] = infer_stmt_list(sc, arm.body_start, arm.body_len, fn_ret);
            if (sel res_body.err) { ret res[u8, fail.Fail].err{res_body.err}; }
            @flow = res_body.ok;
            ret res[u8, fail.Fail].ok{PRUNE_SELECTED};
        }
        i = i + 1;
    }
    ret res[u8, fail.Fail].ok{PRUNE_SELECTED};
}

# walks a deferred gate's condition, reporting each operand that is not a compile-time constant
fun check_comptime_gate(sc: *sema_context.SemaContext, eid: ast_id.ExprId) err[fail.Fail] {
    if (ast_id.expr_is_nil(eid)) { ret err[fail.Fail].ok{}; }
    val res_matched: res[bool, fail.Fail] = comptime_gate.gate_walk[sema_context.SemaContext](sc.view.a, sc.view.source, sc, gate_operand_check, sema_context.comptime_expression, eid);
    if (sel res_matched.err) {
        val opt_expr: opt[*ast_expr.Expr] = ast.get_expr(sc.view.a, eid);
        if (sel opt_expr.none) { ret err[fail.Fail].err{res_matched.err}; }
        ret gate_refused(sc, opt_expr.some.span, res_matched.err);
    }
    ret err[fail.Fail].ok{};
}

# a failure a walk over a gate returned, at `span`: a refusal of the input is reported there
# and the check goes on, and any other failure is the phase's own
fun gate_refused(sc: *sema_context.SemaContext, span: base_source.Span, f: fail.Fail) err[fail.Fail] {
    val k: diagnostic_kind.Kind = fail.kind_of(f);
    if (k == diagnostic_kind.NONE || k == diagnostic_kind.COMPILER_INTERNAL) { ret err[fail.Fail].err{f}; }
    sema_context.refuse(sc, span, f);
    ret err[fail.Fail].ok{};
}

# the verdict on one node of a gate's condition, reporting a runtime value or a non-constant
fun gate_operand_check(sc: *sema_context.SemaContext, eid: ast_id.ExprId, e: *ast_expr.Expr) res[comptime_gate.GateNodeVerdict, fail.Fail] {
    val k: ast_expr.ExprKind = e.kind;

    if (k == ast_expr.EXPR_KIND_BINARY) {
        val res_lhs_field: res[bool, fail.Fail] = infer.is_field_type_operand(sc, e.data.binary.lhs);
        if (sel res_lhs_field.err) { ret res[comptime_gate.GateNodeVerdict, fail.Fail].err{res_lhs_field.err}; }
        val res_rhs_field: res[bool, fail.Fail] = infer.is_field_type_operand(sc, e.data.binary.rhs);
        if (sel res_rhs_field.err) { ret res[comptime_gate.GateNodeVerdict, fail.Fail].err{res_rhs_field.err}; }
        if (intrinsic.is_type_comparison_binary(sc.view.a, sc.view.source, ?e.data.binary, res_lhs_field.ok, res_rhs_field.ok)) {
            ret res[comptime_gate.GateNodeVerdict, fail.Fail].ok{comptime_gate.GATE_NODE_PRUNE};
        }
        ret res[comptime_gate.GateNodeVerdict, fail.Fail].ok{comptime_gate.GATE_NODE_NO};
    }
    if (k == ast_expr.EXPR_KIND_UNARY) {
        if (e.data.unary.op == ast_expr.UN_DEREF || e.data.unary.op == ast_expr.UN_ADDR) {
            sema_context.report(sc, diagnostic_kind.GATE_NOT_CONSTANT, e.span, "comptime `$if` gate is not a compile-time constant");
            ret res[comptime_gate.GateNodeVerdict, fail.Fail].ok{comptime_gate.GATE_NODE_PRUNE};
        }
        ret res[comptime_gate.GateNodeVerdict, fail.Fail].ok{comptime_gate.GATE_NODE_NO};
    }

    if (k == ast_expr.EXPR_KIND_CALL
        && (intrinsic.is_type_query_call(sc.view.a, sc.view.source, eid) || intrinsic.is_layout_intrinsic_call(sc.view.a, sc.view.source, eid))) {
        ret res[comptime_gate.GateNodeVerdict, fail.Fail].ok{comptime_gate.GATE_NODE_PRUNE};
    }

    if (k == ast_expr.EXPR_KIND_INDEX) { ret res[comptime_gate.GateNodeVerdict, fail.Fail].ok{comptime_gate.GATE_NODE_NO}; }
    if (k == ast_expr.EXPR_KIND_CAST)  { ret res[comptime_gate.GateNodeVerdict, fail.Fail].ok{comptime_gate.GATE_NODE_NO}; }

    if (k == ast_expr.EXPR_KIND_LIT_INT || k == ast_expr.EXPR_KIND_LIT_FLOAT
        || k == ast_expr.EXPR_KIND_LIT_CHAR || k == ast_expr.EXPR_KIND_LIT_STR) {
        ret res[comptime_gate.GateNodeVerdict, fail.Fail].ok{comptime_gate.GATE_NODE_PRUNE};
    }

    if (k == ast_expr.EXPR_KIND_COMPTIME_IDENT) {
        val res_eval: res[comptime_value.CTValue, comptime_failure.EvalFail] = comptime.evaluate[sema_context.SemaContext](sc.view.ctx, sc, sc.typing.caps, sc.view.a, sc.view.source, eid, sc.s.interner);
        sema_context.record_eval_result(sc, res_eval);
        if (sel res_eval.err) {
            sema_context.report(sc, res_eval.err.diag, e.span, res_eval.err.message);
        }
        ret res[comptime_gate.GateNodeVerdict, fail.Fail].ok{comptime_gate.GATE_NODE_PRUNE};
    }

    if (k == ast_expr.EXPR_KIND_IDENT) {
        val opt_sym: opt[*resolve.Symbol] = sema_context.symbol_for_expr(sc, eid);
        if (!sel opt_sym.some) { ret res[comptime_gate.GateNodeVerdict, fail.Fail].ok{comptime_gate.GATE_NODE_PRUNE}; }
        val sym: *resolve.Symbol = opt_sym.some;
        if (resolve.symbol_is_runtime(sym)) {
            if (sym.kind == resolve.SYM_PARAM) {
                check.report_named(sc, diagnostic_kind.GATE_RUNTIME_VALUE, e.span, "comptime `$if` gate cannot reference runtime parameter '", sym.name, "'");
                ret res[comptime_gate.GateNodeVerdict, fail.Fail].ok{comptime_gate.GATE_NODE_PRUNE};
            }
            check.report_named(sc, diagnostic_kind.GATE_RUNTIME_VALUE, e.span, "comptime `$if` gate cannot reference runtime value '", sym.name, "'");
            ret res[comptime_gate.GateNodeVerdict, fail.Fail].ok{comptime_gate.GATE_NODE_PRUNE};
        }
        if (sym.kind == resolve.SYM_PARAM) { ret res[comptime_gate.GateNodeVerdict, fail.Fail].ok{comptime_gate.GATE_NODE_PRUNE}; }
        if (sym.kind == resolve.SYM_VAL || sym.kind == resolve.SYM_IMPORTED) {
            val res_eval: res[comptime_value.CTValue, comptime_failure.EvalFail] = comptime.evaluate[sema_context.SemaContext](sc.view.ctx, sc, sc.typing.caps, sc.view.a, sc.view.source, eid, sc.s.interner);
            sema_context.record_eval_result(sc, res_eval);
            if (sel res_eval.err) {
                if (comptime_failure.stands_alone(res_eval.err)) {
                    sema_context.report(sc, res_eval.err.diag, e.span, res_eval.err.message);
                    ret res[comptime_gate.GateNodeVerdict, fail.Fail].ok{comptime_gate.GATE_NODE_PRUNE};
                }
            }
            if (sel res_eval.err && !check.imported_module_const_sym(sc, sym)) {
                check.report_named(sc, diagnostic_kind.GATE_RUNTIME_VALUE, e.span, "comptime `$if` gate cannot reference runtime value '", sym.name, "'");
            }
            ret res[comptime_gate.GateNodeVerdict, fail.Fail].ok{comptime_gate.GATE_NODE_PRUNE};
        }
        check.report_named(sc, diagnostic_kind.GATE_RUNTIME_VALUE, e.span, "comptime `$if` gate cannot reference runtime value '", sym.name, "'");
        ret res[comptime_gate.GateNodeVerdict, fail.Fail].ok{comptime_gate.GATE_NODE_PRUNE};
    }

    if (k == ast_expr.EXPR_KIND_MEMBER) {
        val res_eval: res[comptime_value.CTValue, comptime_failure.EvalFail] = comptime.evaluate[sema_context.SemaContext](sc.view.ctx, sc, sc.typing.caps, sc.view.a, sc.view.source, eid, sc.s.interner);
        sema_context.record_eval_result(sc, res_eval);
        if (sel res_eval.err) {
            if (comptime_failure.stands_alone(res_eval.err)) {
                sema_context.report(sc, res_eval.err.diag, e.span, res_eval.err.message);
                ret res[comptime_gate.GateNodeVerdict, fail.Fail].ok{comptime_gate.GATE_NODE_PRUNE};
            }
            val opt_sym: opt[*resolve.Symbol] = sema_context.symbol_for_expr(sc, eid);
            if (sel opt_sym.some) {
                if (!check.imported_module_const_sym(sc, opt_sym.some)) {
                    sema_context.report(sc, diagnostic_kind.GATE_NOT_CONSTANT, e.span, "comptime `$if` gate is not a compile-time constant");
                }
            }
            if (sel opt_sym.none) { sema_context.report(sc, diagnostic_kind.GATE_NOT_CONSTANT, e.span, "comptime `$if` gate is not a compile-time constant"); }
        }
        ret res[comptime_gate.GateNodeVerdict, fail.Fail].ok{comptime_gate.GATE_NODE_PRUNE};
    }

    sema_context.report(sc, diagnostic_kind.GATE_NOT_CONSTANT, e.span, "comptime `$if` gate is not a compile-time constant");
    ret res[comptime_gate.GateNodeVerdict, fail.Fail].ok{comptime_gate.GATE_NODE_PRUNE};
}

# types a local `val` or `var` and holds it to the rules of a local binding
fun infer_local_decl(sc: *sema_context.SemaContext, did: ast_id.DeclId) err[fail.Fail] {
    if (ast_id.decl_is_nil(did)) { ret err[fail.Fail].ok{}; }
    val opt_decl: opt[*ast_decl.Decl] = ast.get_decl(sc.view.a, did);
    if (!sel opt_decl.some) { ret err[fail.Fail].err{fail.message("DeclId out of range")}; }
    val d: *ast_decl.Decl = opt_decl.some;
    if (d.kind > ast_decl.DECL_KIND_TAG && d.kind != ast_decl.DECL_KIND_ERROR) {
        val failure: fail.Fail = resolve.unknown_catalog(sc.s, "DeclKind", d.kind::u32);
        report_phase.internal(?sc.status, failure);
        ret err[fail.Fail].err{failure};
    }
    if (d.kind != ast_decl.DECL_KIND_VAL && d.kind != ast_decl.DECL_KIND_VAR) {
        ret err[fail.Fail].ok{};
    }

    val ty: type_kind.TypeId = infer.infer_decl(sc, did);
    sema_context.decl_type_set(sc, did, ty);

    if (type.is_case_selector(sc.s.types, ty)) {
        sema_context.report(sc, diagnostic_kind.TAG_SELECTOR_VALUE, d.span, "a case selector is not a value and cannot be stored, assigned or passed");
    }

    if (sema_handle.type_carries_handle(sc, ty) && !sema_handle.annotation_refuses_indirection(sc, d.data.bind.ty, ty)) {
        sema_context.report(sc, diagnostic_kind.HANDLE_STORAGE, d.span,
            "a handle cannot be a local binding. pass the handle to the operation that uses it without naming it first");
    }

    if (abitype.type_carries_abi_type(sc, ty)) {
        sema_context.report(sc, diagnostic_kind.ABI_TYPE_OPAQUE, d.span, abitype.exclusion_message());
    }

    if (!ast_id.expr_is_nil(d.data.bind.init)) {
        val actual: type_kind.TypeId = infer.infer_expr(sc, d.data.bind.init);
        if (type.is_case_selector(sc.s.types, actual)) {
            sema_context.report(sc, diagnostic_kind.TAG_SELECTOR_VALUE, d.span, "a case selector is not a value");
            ret err[fail.Fail].ok{};
        }
        if (!ast_id.type_is_nil(d.data.bind.ty) && !type_kind.is_nil(ty)
            && !type_kind.is_error(ty) && !type_kind.is_error(actual)) {
            check_binding(sc, ty, d.data.bind.init, actual, d.span, d.data.bind.ty);
        }
    }
    ret err[fail.Fail].ok{};
}

# holds the initializer `eid` of type `actual` to a binding's declared type `expected`
# ---
# sc:       the sema context of the module being typed
# expected: the declared type
# eid:      the initializer
# actual:   the initializer's type
# span:     where a refusal is reported
# written:  the binding's annotation, whose spelling a mismatch names
pub fun check_binding(sc: *sema_context.SemaContext, expected: type_kind.TypeId, eid: ast_id.ExprId, actual: type_kind.TypeId, span: base_source.Span, written: ast_id.TypeId) {
    check.check_coercible(sc, expected, eid, actual, span, check.annotation(sc.view.a, written));
}

fun check_return_stmt(sc: *sema_context.SemaContext, ret_type: type_kind.TypeId, value: ast_id.ExprId, span: base_source.Span) {
    if (ast_id.expr_is_nil(value)) {
        check.check_return(sc, ret_type, type_kind.TYPE_NIL, span);
        ret;
    }
    val value_ty: type_kind.TypeId = infer.infer_expr(sc, value);
    if (type_kind.is_nil(ret_type) || type_kind.is_error(ret_type)
        || type_kind.is_error(value_ty) || type_kind.is_nil(value_ty)) {
        check.check_return(sc, ret_type, value_ty, span);
        ret;
    }
    check.check_coercible(sc, ret_type, value, value_ty, span, check.annotation(sc.view.a, sc.walk.ret_written));
}
