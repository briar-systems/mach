# what sema publishes for a module, and how one module reads another's
use std.collections.map;
use collections_vector: std.collections.vector;
use std.types.bool.bool;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;

use mach.base.diagnostic;

use mach.base.fail;
use mach.base.intern;
use base_source:    mach.base.source;
use ast_id:         mach.front.ast.id;
use comptime_deep:  mach.front.comptime.deep;
use comptime_scope: mach.front.comptime.scope;
use mach.front.refusal;
use mach.front.resolve;
use mach.front.sema.fields;
use sema_growth:   mach.front.sema.growth;
use sema_instance: mach.front.sema.instance;
use mach.front.sema.interface;
use report_phase:   mach.report.phase;
use session_module: mach.session.module;
use type_kind:      mach.type.kind;

pub rec SemaResult {
    field_graph:      fields.Graph;
    status:           report_phase.PhaseStatus;
    alloc:            *A.Allocator;
    expr_type:        *type_kind.TypeId;
    type_resolved_ty: *type_kind.TypeId;
    decl_type:        *type_kind.TypeId;
    expr_count:       u32;
    type_count:       u32;
    decl_count:       u32;
    embed_paths:      *intern.StrId;
    embed_path_count: u32;
    embed_path_cap:   u32;
    # the constants sema bound and the gates it decided, over the load's and resolve's
    constants: comptime_scope.Bindings;
    # every instance the module's own code asks for, with where and from what each is asked,
    # and the calls and gates of its own typing (frame 0); each instance is typed by itself
    # (InstanceResult), not here
    instances: sema_instance.Set;
    # whether the module's annotations reach a secret, which an instance of its templates
    # starts its own answer from
    has_secret: bool;
    # the growing cycles among the module's templates
    growth: sema_growth.Analysis;
    # what the lowering of every importer reads of the module
    interface: interface.Interface;
    # why typing refused the module, if it did: a module-scope `$error` that only typing
    # decides fired in it, or a module it imports was refused
    refusal: refusal.Refusal;
}

# release a semantic result; a nil result holds nothing
pub fun result_dnit(r: *SemaResult) {
    if (r == nil) { ret; }
    fields.dnit(?r.field_graph);
    if (r.expr_type != nil && r.expr_count > 0) {
        A.deallocate[type_kind.TypeId](r.alloc, r.expr_type, r.expr_count::usize);
    }
    if (r.type_resolved_ty != nil && r.type_count > 0) {
        A.deallocate[type_kind.TypeId](r.alloc, r.type_resolved_ty, r.type_count::usize);
    }
    if (r.decl_type != nil && r.decl_count > 0) {
        A.deallocate[type_kind.TypeId](r.alloc, r.decl_type, r.decl_count::usize);
    }
    if (r.embed_paths != nil && r.embed_path_cap > 0) {
        A.deallocate[intern.StrId](r.alloc, r.embed_paths, r.embed_path_cap::usize);
    }
    comptime_scope.bindings_dnit(?r.constants);
    sema_instance.dnit(?r.instances);
    sema_growth.dnit(?r.growth);
    interface.dnit(?r.interface);
    refusal.dnit(?r.refusal);
    r.embed_paths      = nil;
    r.embed_path_count = 0;
    r.embed_path_cap   = 0;
    r.expr_type        = nil;
    r.type_resolved_ty = nil;
    r.decl_type        = nil;
    r.expr_count       = 0;
    r.type_count       = 0;
    r.decl_count       = 0;
}

# give back what only the module's own lowering reads of a semantic result, once it is lowered:
# its typing, its bound constants, its instances and its growth. the interface every importer's
# lowering reads, the field graph, the status and the refusal stay
pub fun result_shed(r: *SemaResult) {
    if (r == nil) { ret; }
    if (r.expr_type != nil && r.expr_count > 0) {
        A.deallocate[type_kind.TypeId](r.alloc, r.expr_type, r.expr_count::usize);
    }
    if (r.type_resolved_ty != nil && r.type_count > 0) {
        A.deallocate[type_kind.TypeId](r.alloc, r.type_resolved_ty, r.type_count::usize);
    }
    if (r.decl_type != nil && r.decl_count > 0) {
        A.deallocate[type_kind.TypeId](r.alloc, r.decl_type, r.decl_count::usize);
    }
    comptime_scope.bindings_dnit(?r.constants);
    sema_instance.dnit(?r.instances);
    sema_growth.dnit(?r.growth);
    # each emptied as never made, so the result's release passes over them
    r.constants        = comptime_scope.Bindings{};
    r.instances        = sema_instance.Set{};
    r.growth           = sema_growth.Analysis{};
    r.expr_type        = nil;
    r.type_resolved_ty = nil;
    r.decl_type        = nil;
    r.expr_count       = 0;
    r.type_count       = 0;
    r.decl_count       = 0;
}

# one instance typed on its own, which every user of it reads
# ---
# status: whether its body type checks
# set:    the instance at its head (id 0), its typing in the head's frames, and after it every
#         instance its body asks for, with where each is asked
# values: the constants its body builds, which answer to comptime_deep.INSTANCE_MODULE
# diags:  what typing it reported; a report the instance raises where it is asked for is placed
#         nowhere (base_source.FILE_NIL), for the demand of each module reaching it to place
pub rec InstanceResult {
    status: report_phase.PhaseStatus;
    set:    sema_instance.Set;
    values: comptime_deep.Store;
    diags:  diagnostic.DiagnosticStore;
}

# release a typed instance; a nil one holds nothing
pub fun instance_dnit(r: *InstanceResult) {
    if (r == nil) { ret; }
    sema_instance.dnit(?r.set);
    comptime_deep.dnit(?r.values);
    diagnostic.store_dnit(?r.diags);
}

pub val INFERRED_LEN_NONE: u64 = 0xFFFFFFFFFFFFFFFF;

pub val INFERRED_LEN_FAILED: u64 = 0xFFFFFFFFFFFFFFFE;

# a `[_]T` annotation on a binding whose initializer is absent or not an array literal
pub val INFERRED_LEN_NEEDS_LITERAL: u64 = 0xFFFFFFFFFFFFFFFD;

# a constant an array, record or case literal gives is a value naming a node of the store its
# module's interface publishes
pub rec TypeExport {
    origin:   session_module.StableModuleId;
    canon:    intern.StrId;
    ty:       type_kind.TypeId;
    constant: resolve.ExportConstant;
}

# exports are append-only, and `index` maps (origin, canon) to the first export with
# that key over the first `indexed` of them. `stable` names the module whose surface it is
pub rec ModuleSema {
    path:    intern.StrId;
    module:  session_module.ModuleId;
    stable:  session_module.StableModuleId;
    exports: collections_vector.Vector[TypeExport];
    graph:   fields.Graph;
    index:   map.Map[u64, u32];
    indexed: usize;
    # the module is refused, by its own `$error` or an import's: an importer is not typed
    refused: bool;
}

pub fun module_sema_init(a: *A.Allocator, path: intern.StrId, module: session_module.ModuleId, stable: session_module.StableModuleId) ModuleSema {
    ret ModuleSema{path: path, module: module, stable: stable, exports: collections_vector.init[TypeExport](a), graph: fields.init(a),
        index: map.init[u64, u32](a), indexed: 0};
}

pub fun module_sema_dnit(module: *ModuleSema) {
    collections_vector.dnit[TypeExport](?module.exports);
    fields.dnit(?module.graph);
    map.dnit[u64, u32](?module.index);
    module.indexed = 0;
}

fun export_key(origin: session_module.StableModuleId, canon: intern.StrId) u64 {
    ret (session_module.stable_index(origin)::u64 << 32) | intern.str_index(canon)::u64;
}

# the export of `module` keyed (origin, canon), bringing the index up to the current exports
pub fun module_export_for(module: *ModuleSema, origin: session_module.StableModuleId, canon: intern.StrId) res[opt[TypeExport], A.Error] {
    for (module.indexed < module.exports.len) {
        val item:     *TypeExport = ?module.exports.data[module.indexed];
        var key:      u64         = export_key(item.origin, item.canon);
        val opt_seen: opt[*u32]   = map.get[u64, u32](?module.index, ?key);
        if (sel opt_seen.none) {
            val res_added: res[bool, A.Error] = map.insert[u64, u32](?module.index, key, module.indexed::u32);
            if (sel res_added.err) { ret res[opt[TypeExport], A.Error].err{res_added.err}; }
        }
        module.indexed = module.indexed + 1;
    }
    var want:      u64       = export_key(origin, canon);
    val opt_found: opt[*u32] = map.get[u64, u32](?module.index, ?want);
    if (sel opt_found.none) { ret res[opt[TypeExport], A.Error].ok{opt[TypeExport].none{}}; }
    ret res[opt[TypeExport], A.Error].ok{opt[TypeExport].some{module.exports.data[@opt_found.some]}};
}

pub def DefinitionPhase: u8;
pub val DEFINITION_PARSED:   DefinitionPhase = 0;
pub val DEFINITION_RESOLVED: DefinitionPhase = 1;
pub val DEFINITION_TYPED:    DefinitionPhase = 2;

# a module's definition as far as a phase acquired it
# ---
# ctx:        the scope its constants are read in, once typed
# decorators: a scope that reads the load's records of its decorators, at every phase
pub rec Definition {
    parsed:     resolve.ParsedDefinition;
    origin:     session_module.ModuleId;
    rr:         *resolve.ResolveResult;
    sr:         *SemaResult;
    ctx:        *comptime_scope.ComptimeCtx;
    decorators: *comptime_scope.ComptimeCtx;
}

rec AcquiredDefinition {
    phase:      DefinitionPhase;
    definition: Definition;
}

pub rec DefinitionReader {
    ctx:      ptr;
    read:     fun(ptr, session_module.ModuleId, DefinitionPhase) res[Definition, fail.Fail];
    acquired: collections_vector.Vector[AcquiredDefinition];
}

# a reader lives for one computation, which acquires the same current definition once per origin
pub fun reader_init(ctx: ptr, read: fun(ptr, session_module.ModuleId, DefinitionPhase) res[Definition, fail.Fail],
    a: *A.Allocator) DefinitionReader {
    ret DefinitionReader{ctx: ctx, read: read, acquired: collections_vector.init[AcquiredDefinition](a)};
}

# release a reader; a nil reader holds nothing
pub fun reader_dnit(reader: *DefinitionReader) {
    if (reader == nil) { ret; }
    collections_vector.dnit[AcquiredDefinition](?reader.acquired);
}

pub rec DefinedSymbol {
    definition: Definition;
    symbol:     resolve.Symbol;
}

# the definition of module `origin` as far as each phase got: an importer is checked against
# what a rejected module resolved and typed, since what it refused carries the error type
pub fun acquire_definition(reader: *DefinitionReader, origin: session_module.ModuleId, phase: DefinitionPhase) res[Definition, fail.Fail] {
    if (reader == nil || reader.ctx == nil || reader.read == nil || phase > DEFINITION_TYPED) {
        ret res[Definition, fail.Fail].err{fail.message("current definition acquisition requires an active phase capability")};
    }
    var slot: usize = reader.acquired.len;
    var ai:   usize = 0;
    for (ai < reader.acquired.len) {
        val entry: *AcquiredDefinition = ?reader.acquired.data[ai];
        if (session_module.same(entry.definition.origin, origin)) {
            if (entry.phase >= phase) { ret res[Definition, fail.Fail].ok{entry.definition}; }
            slot = ai;
            brk;
        }
        ai = ai + 1;
    }
    val res_acquired: res[Definition, fail.Fail] = reader.read(reader.ctx, origin, phase);
    if (sel res_acquired.err) { ret res[Definition, fail.Fail].err{res_acquired.err}; }
    val current: Definition = res_acquired.ok;
    if (!session_module.same(current.origin, origin) || current.parsed.a == nil || current.parsed.incarnation == 0
        || current.parsed.incarnation != current.parsed.a.incarnation
        || !base_source.file_same(current.parsed.owner.file, current.parsed.a.file_id)) {
        ret res[Definition, fail.Fail].err{fail.message("current definition has inconsistent parsed ownership")};
    }
    if (phase >= DEFINITION_RESOLVED && current.rr == nil) {
        ret res[Definition, fail.Fail].err{fail.message("current definition has no acquired resolution product")};
    }
    if (phase == DEFINITION_TYPED && (current.sr == nil || current.ctx == nil)) {
        ret res[Definition, fail.Fail].err{fail.message("current definition has no acquired semantic product")};
    }
    if (phase >= DEFINITION_RESOLVED) {
        val opt_resolved: opt[fail.Fail] = report_phase.internal_failure(current.rr.status);
        if (sel opt_resolved.some) { ret res[Definition, fail.Fail].err{opt_resolved.some}; }
    }
    if (phase == DEFINITION_TYPED) {
        val opt_typed: opt[fail.Fail] = report_phase.internal_failure(current.sr.status);
        if (sel opt_typed.some) { ret res[Definition, fail.Fail].err{opt_typed.some}; }
    }
    val entry: AcquiredDefinition = AcquiredDefinition{phase: phase, definition: current};
    if (slot < reader.acquired.len) { reader.acquired.data[slot] = entry; }
    or {
        val res_added: res[usize, A.Error] = collections_vector.push[AcquiredDefinition](?reader.acquired, entry);
        if (sel res_added.err) { ret res[Definition, fail.Fail].err{fail.refused(res_added.err)}; }
    }
    ret res[Definition, fail.Fail].ok{current};
}

# the current definition of `requested`, which module `origin` defines as this operation numbers it
pub fun acquire_symbol(reader: *DefinitionReader, requested: *resolve.Symbol, origin: session_module.ModuleId,
    phase: DefinitionPhase) res[DefinedSymbol, fail.Fail] {
    if (requested == nil || phase < DEFINITION_RESOLVED) {
        ret res[DefinedSymbol, fail.Fail].err{fail.message("symbol definition requires resolved acquisition")};
    }
    val res_acquired: res[Definition, fail.Fail] = acquire_definition(reader, origin, phase);
    if (sel res_acquired.err) { ret res[DefinedSymbol, fail.Fail].err{res_acquired.err}; }
    val current: Definition       = res_acquired.ok;
    var found:   resolve.SymbolId = resolve.SYMBOL_NIL;
    # the owner's index of what it declares answers in one step. where it names another symbol
    # than the one asked for, or more than one declaration, every symbol is read as before
    val filed: resolve.SymbolId = resolve.own_declared(current.rr, requested.definition_kind, requested.canon);
    if (!resolve.symbol_is_nil(filed) && filed != resolve.SYMBOL_AMBIGUOUS && resolve.symbol_index(filed) < current.rr.symbol_count) {
        val symbol: *resolve.Symbol = ?current.rr.symbols[resolve.symbol_index(filed)];
        if (session_module.stable_same(symbol.origin, requested.origin) && symbol.kind == requested.definition_kind
            && intern.str_same(symbol.canon, requested.canon) && !ast_id.decl_is_nil(symbol.decl)) { found = filed; }
    }
    var i: u32 = 0;
    if (!resolve.symbol_is_nil(found)) { i = current.rr.symbol_count; }
    for (i < current.rr.symbol_count) {
        val symbol: *resolve.Symbol = ?current.rr.symbols[i];
        if (session_module.stable_same(symbol.origin, requested.origin) && symbol.kind == requested.definition_kind
            && intern.str_same(symbol.canon, requested.canon) && !ast_id.decl_is_nil(symbol.decl)) {
            if (!resolve.symbol_is_nil(found) && !ast_id.decl_same(current.rr.symbols[resolve.symbol_index(found)].decl, symbol.decl)) {
                ret res[DefinedSymbol, fail.Fail].err{fail.message("current canonical definition is ambiguous")};
            }
            found = resolve.symbol_id(i);
        }
        i = i + 1;
    }
    if (resolve.symbol_is_nil(found) || ast_id.decl_index(current.rr.symbols[resolve.symbol_index(found)].decl) >= current.parsed.a.decls.len::u32) {
        ret res[DefinedSymbol, fail.Fail].err{fail.message("current canonical definition is absent from its resolved owner")};
    }
    ret res[DefinedSymbol, fail.Fail].ok{DefinedSymbol{definition: current, symbol: current.rr.symbols[resolve.symbol_index(found)]}};
}

# the imported surfaces are borrowed: the driver owns each one and shares it
# between every importer in a pass. `owners` holds each surface's position by the stable
# index of its module, the first where two are one module's; surfaces_set fills it with
# `entries`, which nothing changes after, and surfaces_dnit releases both
pub rec SemaDeps {
    definitions: DefinitionReader;
    entries:     **ModuleSema;
    count:       u32;
    owners:      map.Map[u32, u32];
}

# hand `deps` the surfaces `entries` holds, an array of `count` allocated from `a`
pub fun surfaces_set(deps: *SemaDeps, entries: **ModuleSema, count: u32, a: *A.Allocator) err[A.Error] {
    deps.entries = entries;
    deps.count   = count;
    deps.owners  = map.init[u32, u32](a);
    var i: u32 = 0;
    for (i < count) {
        var key: u32 = session_module.stable_index(entries[i].stable);
        if (!map.contains[u32, u32](?deps.owners, ?key)) {
            val res_indexed: res[bool, A.Error] = map.insert[u32, u32](?deps.owners, key, i);
            if (sel res_indexed.err) { ret err[A.Error].err{res_indexed.err}; }
        }
        i = i + 1;
    }
    ret err[A.Error].ok{};
}

# release what surfaces_set handed `deps`: the array, from `a`, and the index; the surfaces are borrowed
pub fun surfaces_dnit(deps: *SemaDeps, a: *A.Allocator) {
    if (deps.entries != nil) { A.deallocate[*ModuleSema](a, deps.entries, deps.count::usize); }
    map.dnit[u32, u32](?deps.owners);
    deps.entries = nil;
    deps.count   = 0;
}

# the surface of the module `owner` among those `deps` holds, none when it holds none
pub fun surface_of_owner(deps: *SemaDeps, owner: session_module.StableModuleId) opt[*ModuleSema] {
    var key:       u32       = session_module.stable_index(owner);
    val opt_found: opt[*u32] = map.get[u32, u32](?deps.owners, ?key);
    if (sel opt_found.none) { ret opt[*ModuleSema].none{}; }
    ret opt[*ModuleSema].some{deps.entries[@opt_found.some]};
}
