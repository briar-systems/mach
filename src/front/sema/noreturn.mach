# the `#[noreturn]` rule: a function so marked states no result, holds no `ret`, and its body ends where control never
# comes back, so falling off its end is unreachable
#
# a statement ends when control never passes it: a call to a `noreturn` function, an `asm` block marked `noreturn`, a
# `$error` directive, a bare `for` no `brk` of its own leaves, a block holding a statement that ends, an `if` chain
# with a bare `or` each arm of which ends, and a `$if` each branch of which ends where one branch is bare
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;

use diagnostic_kind: mach.base.diagnostic.kind;
use mach.base.fail;
use base_source: mach.base.source;
use mach.base.stack;
use mach.front.ast;
use ast_decl: mach.front.ast.decl;
use ast_expr: mach.front.ast.expr;
use ast_id:   mach.front.ast.id;
use ast_stmt: mach.front.ast.stmt;
use mach.front.decorator;
use mach.front.resolve;
use sema_context: mach.front.sema.context;
use mach.front.sema.interface;
use report_phase: mach.report.phase;

# hold the function `d` the decorator `dec` marks `noreturn` to the rule
pub fun validate(sc: *sema_context.SemaContext, d: *ast_decl.Decl, dec: *ast_decl.Decorator) {
    if (!ast_id.type_is_nil(d.data.fun_.return_type)) {
        sema_context.report(sc, diagnostic_kind.NORETURN_RETURNS, dec.name, "a `noreturn` function states no result type, since no caller ever receives one");
    }
    val body: ast_id.StmtId = d.data.fun_.body;
    if (ast_id.stmt_is_nil(body)) { ret; }
    refuse_returns(sc, body);
    if (!ends(sc, body)) {
        sema_context.report(sc, diagnostic_kind.NORETURN_RETURNS, dec.name, "the body of a `noreturn` function can reach its end. end it in a call to a `noreturn` function, an `asm` block marked `noreturn` or a `for` no `brk` leaves");
    }
}

# every `ret` under `sid` refused
fun refuse_returns(sc: *sema_context.SemaContext, sid: ast_id.StmtId) {
    val opt_stmt: opt[*ast_stmt.Stmt] = ast.get_stmt(sc.view.a, sid);
    if (sel opt_stmt.none) { ret; }
    val s: *ast_stmt.Stmt = opt_stmt.some;
    if (stack.exhausted()) {
        sema_context.refuse_nesting(sc, s.span);
        ret;
    }
    if (s.kind == ast_stmt.STMT_KIND_RET) {
        sema_context.report(sc, diagnostic_kind.NORETURN_RETURNS, s.span, "a `noreturn` function may not return");
        ret;
    }
    if (s.kind == ast_stmt.STMT_KIND_BLOCK) { refuse_list(sc, s.data.block.stmts_start, s.data.block.stmts_len); }
    or (s.kind == ast_stmt.STMT_KIND_IF) {
        refuse_returns(sc, s.data.if_.then_block);
        refuse_returns(sc, s.data.if_.else_block);
    }
    or (s.kind == ast_stmt.STMT_KIND_FOR) { refuse_returns(sc, s.data.for_.body); }
    or (s.kind == ast_stmt.STMT_KIND_FIN) { refuse_returns(sc, s.data.fin_.body); }
    or (s.kind == ast_stmt.STMT_KIND_COMPTIME_IF) {
        var b: u32 = 0;
        for (b < s.data.comptime_if.branches_len) {
            val br: *ast_decl.ComptimeBranch = ?sc.view.a.comptime_branches.data[s.data.comptime_if.branches_start + b];
            refuse_list(sc, br.body_start, br.body_len);
            b = b + 1;
        }
    }
    or (s.kind == ast_stmt.STMT_KIND_COMPTIME_EACH) { refuse_list(sc, s.data.comptime_each.body_start, s.data.comptime_each.body_len); }
}

fun refuse_list(sc: *sema_context.SemaContext, start: u32, len: u32) {
    var i: u32 = 0;
    for (i < len) {
        refuse_returns(sc, sc.view.a.stmt_ids.data[start + i]);
        i = i + 1;
    }
}

# whether control never passes the statement `sid`
fun ends(sc: *sema_context.SemaContext, sid: ast_id.StmtId) bool {
    val opt_stmt: opt[*ast_stmt.Stmt] = ast.get_stmt(sc.view.a, sid);
    if (sel opt_stmt.none) { ret false; }
    val s: *ast_stmt.Stmt = opt_stmt.some;
    if (stack.exhausted())                               { ret false; }
    if (s.kind == ast_stmt.STMT_KIND_ASM)                { ret s.data.asm_.noreturn; }
    if (s.kind == ast_stmt.STMT_KIND_COMPTIME_DIRECTIVE) { ret true; }
    if (s.kind == ast_stmt.STMT_KIND_EXPR)               { ret call_ends(sc, s.data.expr.expr); }
    if (s.kind == ast_stmt.STMT_KIND_BLOCK)              { ret list_ends(sc, s.data.block.stmts_start, s.data.block.stmts_len); }
    if (s.kind == ast_stmt.STMT_KIND_IF) {
        if (ast_id.stmt_is_nil(s.data.if_.else_block)) { ret false; }
        ret ends(sc, s.data.if_.then_block) && ends(sc, s.data.if_.else_block);
    }
    if (s.kind == ast_stmt.STMT_KIND_FOR) { ret ast_id.expr_is_nil(s.data.for_.cond) && !breaks(sc, s.data.for_.body); }
    if (s.kind == ast_stmt.STMT_KIND_COMPTIME_IF) {
        var bare: bool = false;
        var b:    u32  = 0;
        for (b < s.data.comptime_if.branches_len) {
            val br: *ast_decl.ComptimeBranch = ?sc.view.a.comptime_branches.data[s.data.comptime_if.branches_start + b];
            if (ast_id.expr_is_nil(br.cond))                { bare = true; }
            if (!list_ends(sc, br.body_start, br.body_len)) { ret false; }
            b = b + 1;
        }
        ret bare;
    }
    ret false;
}

fun list_ends(sc: *sema_context.SemaContext, start: u32, len: u32) bool {
    var i: u32 = 0;
    for (i < len) {
        if (ends(sc, sc.view.a.stmt_ids.data[start + i])) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether a `brk` under `sid` leaves the loop whose body it is, one in a nested loop leaving that loop alone
fun breaks(sc: *sema_context.SemaContext, sid: ast_id.StmtId) bool {
    val opt_stmt: opt[*ast_stmt.Stmt] = ast.get_stmt(sc.view.a, sid);
    if (sel opt_stmt.none) { ret false; }
    val s: *ast_stmt.Stmt = opt_stmt.some;
    if (stack.exhausted())                  { ret true; }
    if (s.kind == ast_stmt.STMT_KIND_BRK)   { ret true; }
    if (s.kind == ast_stmt.STMT_KIND_BLOCK) { ret list_breaks(sc, s.data.block.stmts_start, s.data.block.stmts_len); }
    if (s.kind == ast_stmt.STMT_KIND_IF)    { ret breaks(sc, s.data.if_.then_block) || breaks(sc, s.data.if_.else_block); }
    if (s.kind == ast_stmt.STMT_KIND_COMPTIME_IF) {
        var b: u32 = 0;
        for (b < s.data.comptime_if.branches_len) {
            val br: *ast_decl.ComptimeBranch = ?sc.view.a.comptime_branches.data[s.data.comptime_if.branches_start + b];
            if (list_breaks(sc, br.body_start, br.body_len)) { ret true; }
            b = b + 1;
        }
    }
    if (s.kind == ast_stmt.STMT_KIND_COMPTIME_EACH) { ret list_breaks(sc, s.data.comptime_each.body_start, s.data.comptime_each.body_len); }
    ret false;
}

fun list_breaks(sc: *sema_context.SemaContext, start: u32, len: u32) bool {
    var i: u32 = 0;
    for (i < len) {
        if (breaks(sc, sc.view.a.stmt_ids.data[start + i])) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether the expression `eid` is a call of a function declared `noreturn`
fun call_ends(sc: *sema_context.SemaContext, eid: ast_id.ExprId) bool {
    val opt_expr: opt[*ast_expr.Expr] = ast.get_expr(sc.view.a, eid);
    if (sel opt_expr.none)                             { ret false; }
    if (opt_expr.some.kind != ast_expr.EXPR_KIND_CALL) { ret false; }
    val callee: ast_id.ExprId = opt_expr.some.data.call.callee;
    if (ast_id.expr_is_nil(callee))                         { ret false; }
    if (ast_id.expr_index(callee) >= sc.view.rr.expr_count) { ret false; }
    val sid: resolve.SymbolId = sc.view.rr.expr_resolved[ast_id.expr_index(callee)];
    if (resolve.symbol_is_nil(sid) || resolve.symbol_is_rejected(sid)) { ret false; }
    ret symbol_noreturn(sc, ?sc.view.rr.symbols[resolve.symbol_index(sid)]);
}

# whether `sym` names a function declared `noreturn`, this module's by its decorators and another's by its interface
fun symbol_noreturn(sc: *sema_context.SemaContext, sym: *resolve.Symbol) bool {
    if (!sema_context.foreign(sc, sym)) {
        val opt_decl: opt[*ast_decl.Decl] = ast.get_decl(sc.view.a, sym.decl);
        if (sel opt_decl.none) { ret false; }
        ret decorator.has(sc.view.a, opt_decl.some, decorator.NORETURN);
    }
    val res_acquired: res[*interface.Interface, fail.Fail] = sema_context.interface_of(sc, resolve.origin_of(sc.s, sym));
    if (sel res_acquired.err) {
        report_phase.internal(?sc.status, res_acquired.err);
        ret false;
    }
    val res_named: res[*interface.Declaration, fail.Fail] = interface.declaration_for(res_acquired.ok, sym.definition_kind, sym.canon);
    if (sel res_named.err) {
        report_phase.internal(?sc.status, res_named.err);
        ret false;
    }
    ret (res_named.ok.flags & interface.DECLARATION_NORETURN) != 0;
}
