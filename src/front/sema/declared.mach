pub fun seed_builtins(sc: *sema_context.SemaContext) err[fail.Fail] {
    ret err[fail.Fail].ok{};
}

# the declared discriminator is the tag's storage contract; a too-narrow one is rejected here
# the discriminator is part of the tag's layout: it is recorded with the case table by every
# path that readies the layout, so a type query never sees a table without its width
fun record_tag_discriminator(sc: *sema_context.SemaContext, ty: type_kind.TypeId, t: *ast_decl.DeclTag) {
    if (ast_id.type_is_nil(t.disc)) { ret; }
    var disc: type_kind.TypeId = sema_context.resolved_type_of(sc, t.disc);
    if (type_kind.is_nil(disc) && sc.instance.subst == nil) { disc = resolve_type_ref(sc, t.disc); }
    if (type_kind.is_error(disc) || type_kind.is_nil(disc)) { ret; }
    val k: type_kind.TypeKind = type.shape_kind(?sc.s.types, disc);
    if (!type.is_valid_discriminator_kind(k) || type.is_secret(?sc.s.types, disc)) {
        check.report_typed(sc, diagnostic_kind.TAG_DISCRIMINATOR_TYPE, t.name, "a tag discriminator must be `u8`, `u16`, `u32` or `u64`, but this declares `", disc, "`");
        ret;
    }
    val bits: u32 = type_prim.prim_desc(k).bits;
    if (bits < 64 && t.cases_len::u64 > (1::u64 << bits::u64)) {
        check.report_typed(sc, diagnostic_kind.TAG_DISCRIMINATOR_NARROW, t.name, "this tag has more cases than `", disc,
            "` can number. declare a wider discriminator type");
        ret;
    }
    val err_recorded: err[fail.Fail] = type.set_tag_discriminator(?sc.s.types, ty, disc);
    if (sel err_recorded.err) { report_phase.internal(?sc.status, err_recorded.err); }
}

pub fun infer_fun_sig(sc: *sema_context.SemaContext, f: *ast_decl.DeclFun) type_kind.TypeId {
    val ret_type: type_kind.TypeId = sema_context.resolved_type_of(sc, f.return_type);

    var runtime_count: u32 = 0;
    var i:             u32 = 0;
    for (i < f.params_len) {
        val tn: *ast_decl.TypedName = ?sc.view.a.typed_names.data[f.params_start + i];
        if (!tn.comptime) { runtime_count = runtime_count + 1; }
        or (sema_context.holds_secret(sc, sema_context.resolved_type_of(sc, tn.ty))) {
            sema_context.report(sc, diagnostic_kind.SECRET_COMPTIME, tn.name,
                "a comptime parameter cannot hold a secret. declare the parameter public and declassify the argument, as in `K:>u64`");
        }
        i = i + 1;
    }

    if (runtime_count == 0) {
        val res_intern_function: res[type_kind.TypeId, fail.Fail] = type.intern_function(?sc.s.types, ret_type, nil, 0, f.c_variadic);
        if (sel res_intern_function.err) {
            report_phase.internal(?sc.status, res_intern_function.err);
            ret type_kind.TYPE_ERROR;
        }
        ret res_intern_function.ok;
    }

    val res_allocate_params: res[*type_kind.TypeId, fail.Fail] = allocate_params(sc, runtime_count);
    if (sel res_allocate_params.err) {
        report_phase.internal(?sc.status, res_allocate_params.err);
        ret type_kind.TYPE_ERROR;
    }
    val params: *type_kind.TypeId = res_allocate_params.ok;

    var w: u32 = 0;
    i = 0;
    for (i < f.params_len) {
        val tn: *ast_decl.TypedName = ?sc.view.a.typed_names.data[f.params_start + i];
        if (!tn.comptime) {
            params[w] = sema_context.resolved_type_of(sc, tn.ty);
            w         = w + 1;
        }
        i = i + 1;
    }

    val res_intern_function: res[type_kind.TypeId, fail.Fail] = type.intern_function(?sc.s.types, ret_type, params, runtime_count, f.c_variadic);
    params_free(sc, params, runtime_count);
    if (sel res_intern_function.err) {
        report_phase.internal(?sc.status, res_intern_function.err);
        ret type_kind.TYPE_ERROR;
    }
    ret res_intern_function.ok;
}

pub fun infer_nominal(sc: *sema_context.SemaContext, did: ast_id.DeclId, name_span: base_source.Span, r: *ast_decl.DeclRec, kind: type_kind.TypeKind) type_kind.TypeId {
    val name_id:            intern.StrId                     = intern_span_or_nil(sc, name_span);
    val res_intern_nominal: res[type_kind.TypeId, fail.Fail] = type.intern_nominal(?sc.s.types, name_id, resolve.type_owner(sc.s, sc.view.own_module, sc.view.a.file_id), kind);
    if (sel res_intern_nominal.err) {
        report_phase.internal(?sc.status, res_intern_nominal.err);
        ret type_kind.TYPE_ERROR;
    }
    val ty: type_kind.TypeId = res_intern_nominal.ok;

    elaborate_nominal(sc, did, ty, r.fields_start, r.fields_len);
    ret ty;
}

pub fun infer_nominal_uni(sc: *sema_context.SemaContext, did: ast_id.DeclId, name_span: base_source.Span, u: *ast_decl.DeclUni, kind: type_kind.TypeKind) type_kind.TypeId {
    val name_id:            intern.StrId                     = intern_span_or_nil(sc, name_span);
    val res_intern_nominal: res[type_kind.TypeId, fail.Fail] = type.intern_nominal(?sc.s.types, name_id, resolve.type_owner(sc.s, sc.view.own_module, sc.view.a.file_id), kind);
    if (sel res_intern_nominal.err) {
        report_phase.internal(?sc.status, res_intern_nominal.err);
        ret type_kind.TYPE_ERROR;
    }
    val ty: type_kind.TypeId = res_intern_nominal.ok;

    elaborate_nominal(sc, did, ty, u.fields_start, u.fields_len);
    ret ty;
}

pub fun elaborate_nominal(sc: *sema_context.SemaContext, did: ast_id.DeclId, ty: type_kind.TypeId,
    fields_start: u32, fields_len: u32) intern.StrId {
    val st: u8 = layout_state_of(sc, did);
    if (st == sema_context.LAYOUT_READY)  { ret intern.STR_NIL; }
    if (st == sema_context.LAYOUT_FAILED) { ret intern.STR_NIL; }
    if (st == sema_context.LAYOUT_ACTIVE) { ret nominal_name_id(sc, did); }

    layout_state_set(sc, did, sema_context.LAYOUT_ACTIVE);
    # a declaration is elaborated once, so what it reports it reports now, whatever walk reached it
    val outer: sema_context.Walk = sema_context.walk_begin(sc);
    sc.walk.silent = false;
    fin { sema_context.walk_end(sc, outer); }
    val opt_declared: opt[*ast_decl.Decl] = ast.get_decl(sc.view.a, did);
    if (sel opt_declared.some) {
        if (opt_declared.some.kind == ast_decl.DECL_KIND_TAG) {
            record_tag_discriminator(sc, ty, ?opt_declared.some.data.tag_);
        }
    }
    val err_fields: err[fail.Fail] = build_field_table(sc, ty, fields_start, fields_len);
    if (sel err_fields.err) {
        layout_state_set(sc, did, sema_context.LAYOUT_FAILED);
        report_phase.internal(?sc.status, err_fields.err);
        ret intern.STR_NIL;
    }
    record_decoration(sc, did, ty, fields_start, fields_len);
    layout_state_set(sc, did, sema_context.LAYOUT_READY);
    ret intern.STR_NIL;
}

fun layout_state_of(sc: *sema_context.SemaContext, did: ast_id.DeclId) u8 {
    if (sc.view.layout_state == nil)                        { ret sema_context.LAYOUT_READY; }
    if (ast_id.decl_index(did) >= sc.view.a.decls.len::u32) { ret sema_context.LAYOUT_READY; }
    ret sc.view.layout_state[ast_id.decl_index(did)];
}

fun layout_state_set(sc: *sema_context.SemaContext, did: ast_id.DeclId, st: u8) {
    if (sc.view.layout_state == nil)                        { ret; }
    if (ast_id.decl_index(did) >= sc.view.a.decls.len::u32) { ret; }
    sc.view.layout_state[ast_id.decl_index(did)] = st;
}

fun nominal_name_id(sc: *sema_context.SemaContext, did: ast_id.DeclId) intern.StrId {
    val opt_decl: opt[*ast_decl.Decl] = ast.get_decl(sc.view.a, did);
    if (!sel opt_decl.some) { ret intern.STR_NIL; }
    val d: *ast_decl.Decl = opt_decl.some;
    if (d.kind == ast_decl.DECL_KIND_UNI) { ret intern_span_or_nil(sc, d.data.uni_.name); }
    if (d.kind == ast_decl.DECL_KIND_REC) { ret intern_span_or_nil(sc, d.data.rec_.name); }
    if (d.kind == ast_decl.DECL_KIND_TAG) { ret intern_span_or_nil(sc, d.data.tag_.name); }
    ret intern.STR_NIL;
}

# elaborates every nominal `tid` holds by value, each once; the name of a nominal whose
# layout is still being decided when it is reached again, nil otherwise
pub fun ensure_layout_ready(sc: *sema_context.SemaContext, tid: type_kind.TypeId) intern.StrId {
    var scan:       type_scan.Scan;
    val err_opened: err[fail.Fail] = type.type_scan_begin(?sc.s.types, ?scan);
    if (sel err_opened.err) {
        report_phase.internal(?sc.status, err_opened.err);
        ret intern.STR_NIL;
    }
    fin { type.type_scan_end(?sc.s.types, ?scan); }
    ret ensure_layout_walk(sc, ?scan, tid);
}

fun ensure_layout_walk(sc: *sema_context.SemaContext, scan: *type_scan.Scan, tid: type_kind.TypeId) intern.StrId {
    if (type_kind.is_nil(tid) || type_kind.is_error(tid)) { ret intern.STR_NIL; }
    # the measurement that follows meets the same nesting and refuses it
    if (stack.exhausted()) { ret intern.STR_NIL; }

    val base:     type_kind.TypeId               = type.strip_secret(?sc.s.types, tid);
    val res_mark: res[type_scan.Mark, fail.Fail] = type.type_scan_mark(?sc.s.types, scan, base);
    if (sel res_mark.err) {
        report_phase.internal(?sc.status, res_mark.err);
        ret intern.STR_NIL;
    }
    if (res_mark.ok != type_scan.VISIT_FRESH) { ret intern.STR_NIL; }
    val opt_types_entry: opt[*type.Type] = type.get(?sc.s.types, base);
    if (!sel opt_types_entry.some) { ret intern.STR_NIL; }
    val t: *type.Type = opt_types_entry.some;

    if (t.kind == type_kind.TYPE_ARRAY) { ret ensure_layout_walk(sc, scan, t.data.array.base); }

    if (t.kind == type_kind.TYPE_REC || t.kind == type_kind.TYPE_UNI || t.kind == type_kind.TYPE_TAG) {
        val owner: type.TypeOwner = resolve.type_owner(sc.s, sc.view.own_module, sc.view.a.file_id);
        if (!module.stable_same(t.data.nominal.owner.module, owner.module) || !base_source.file_same(t.data.nominal.owner.file, owner.file)
            || t.data.nominal.incarnation != 0) { ret intern.STR_NIL; }
        val res_selected: res[ast_id.DeclId, fail.Fail] = sema_context.own_nominal_declaration(sc, t);
        if (sel res_selected.err) {
            report_phase.internal(?sc.status, res_selected.err);
            ret intern.STR_NIL;
        }
        val did:      ast_id.DeclId       = res_selected.ok;
        val opt_decl: opt[*ast_decl.Decl] = ast.get_decl(sc.view.a, did);
        if (!sel opt_decl.some) { ret intern.STR_NIL; }
        val d: *ast_decl.Decl = opt_decl.some;

        var fstart: u32 = d.data.rec_.fields_start;
        var flen:   u32 = d.data.rec_.fields_len;
        if (d.kind == ast_decl.DECL_KIND_UNI) {
            fstart = d.data.uni_.fields_start;
            flen   = d.data.uni_.fields_len;
        }
        or (d.kind == ast_decl.DECL_KIND_TAG) {
            fstart = d.data.tag_.cases_start;
            flen   = d.data.tag_.cases_len;
        }
        or (d.kind != ast_decl.DECL_KIND_REC) { ret intern.STR_NIL; }

        val cyc: intern.StrId = elaborate_nominal(sc, did, base, fstart, flen);
        if (!intern.str_is_nil(cyc)) { ret cyc; }
        ret ensure_layout_fields(sc, scan, base);
    }

    if (t.kind == type_kind.TYPE_INSTANCE) {
        val cyc: intern.StrId = ensure_layout_walk(sc, scan, t.data.instance.nominal);
        if (!intern.str_is_nil(cyc)) { ret cyc; }
        # a type nested too deep to substitute is refused, as above, by the measurement that follows
        val err_fields: err[fail.Fail] = subst.ensure_fields(sc.s, base);
        if (sel err_fields.err) {
            if (fail.kind_of(err_fields.err) != diagnostic_kind.SYNTAX_NESTING_DEPTH) { report_phase.internal(?sc.status, err_fields.err); }
            ret intern.STR_NIL;
        }
        ret ensure_layout_fields(sc, scan, base);
    }

    ret intern.STR_NIL;
}

pub fun prepare_nominal_recipe(sc: *sema_context.SemaContext, ty: type_kind.TypeId) err[fail.Fail] {
    val opt_table_1: opt[*type_field.Table] = type.field_table_for(?sc.s.types, ty);
    if (sel opt_table_1.some) { ret err[fail.Fail].ok{}; }
    val opt_selected: opt[*type.Type] = type.get(?sc.s.types, ty);
    if (!sel opt_selected.some) { ret err[fail.Fail].err{fail.message("nominal recipe has no semantic type")}; }
    val nominal:        *type.Type                    = opt_selected.some;
    val res_definition: res[ast_id.DeclId, fail.Fail] = sema_context.own_nominal_declaration(sc, nominal);
    if (sel res_definition.err) { ret err[fail.Fail].err{res_definition.err}; }
    val did:   ast_id.DeclId  = res_definition.ok;
    val d:     *ast_decl.Decl = ?sc.view.a.decls.data[ast_id.decl_index(did)];
    var start: u32            = 0;
    var len:   u32            = 0;
    if (d.kind == ast_decl.DECL_KIND_REC) {
        start = d.data.rec_.fields_start;
        len   = d.data.rec_.fields_len;
    }
    or (d.kind == ast_decl.DECL_KIND_UNI) {
        start = d.data.uni_.fields_start;
        len   = d.data.uni_.fields_len;
    }
    or (d.kind == ast_decl.DECL_KIND_TAG) {
        start = d.data.tag_.cases_start;
        len   = d.data.tag_.cases_len;
    }
    or { ret err[fail.Fail].err{fail.message("nominal recipe definition has the wrong kind")}; }
    val cycle: intern.StrId = elaborate_nominal(sc, did, ty, start, len);
    if (!sel sc.status.kind.accepted) { ret err[fail.Fail].err{report_phase.phase_failure(sc.status)}; }
    val opt_table_2: opt[*type_field.Table] = type.field_table_for(?sc.s.types, ty);
    if (!intern.str_is_nil(cycle)) {
        ret err[fail.Fail].err{fail.message("nominal recipe preparation did not produce a complete table")};
    }
    if (!sel opt_table_2.some) {
        ret err[fail.Fail].err{fail.message("nominal recipe preparation did not produce a complete table")};
    }
    ret err[fail.Fail].ok{};
}

fun ensure_layout_fields(sc: *sema_context.SemaContext, scan: *type_scan.Scan, ty: type_kind.TypeId) intern.StrId {
    val n: u32 = type.field_count(?sc.s.types, ty);
    var i: u32 = 0;
    for (i < n) {
        val opt_field_at: opt[*type_field.Entry] = type.field_at(?sc.s.types, ty, i);
        if (sel opt_field_at.some) {
            val cyc: intern.StrId = ensure_layout_walk(sc, scan, opt_field_at.some.ty);
            if (!intern.str_is_nil(cyc)) { ret cyc; }
        }
        i = i + 1;
    }
    ret intern.STR_NIL;
}

pub fun resolve_type_query(sc: *sema_context.SemaContext, tid: u32, which: u8) res[opt[comptime_value.CTValue], comptime_failure.EvalFail] {
    if (sc == nil) { ret res[opt[comptime_value.CTValue], comptime_failure.EvalFail].ok{opt[comptime_value.CTValue].none{}}; }
    ret answer_type_query(sc.s, tid, which);
}

pub fun answer_type_query(s: *session.Session, tid: u32, which: u8) res[opt[comptime_value.CTValue], comptime_failure.EvalFail] {
    val t: type_kind.TypeId = tid::type_kind.TypeId;
    if (type_kind.is_nil(t) || type_kind.is_error(t)) {
        ret res[opt[comptime_value.CTValue], comptime_failure.EvalFail].ok{opt[comptime_value.CTValue].none{}};
    }

    if (which == comptime_capability.TYPE_QUERY_IS_SECRET) {
        if (type.is_secret(?s.types, t)) {
            ret res[opt[comptime_value.CTValue], comptime_failure.EvalFail].ok{opt[comptime_value.CTValue].some{comptime_value.ct_u1(true)}};
        }
        if (type.shape_kind(?s.types, t) == type_kind.TYPE_GENERIC_PARAM) {
            ret res[opt[comptime_value.CTValue], comptime_failure.EvalFail].ok{opt[comptime_value.CTValue].none{}};
        }
        ret res[opt[comptime_value.CTValue], comptime_failure.EvalFail].ok{opt[comptime_value.CTValue].some{comptime_value.ct_u1(false)}};
    }

    # one implementation: the same deep walk the raw-pointer cast check refuses on
    if (which == comptime_capability.TYPE_QUERY_HOLDS_SECRET) {
        val res_reached: res[bool, fail.Fail] = deep.contains_secret(s, t);
        if (sel res_reached.err) { ret res[opt[comptime_value.CTValue], comptime_failure.EvalFail].err{comptime_failure.eval_error(comptime_failure.EVAL_FAIL_INTERNAL, diagnostic_kind.COMPILER_INTERNAL, fail.describe(res_reached.err))}; }
        if (res_reached.ok) {
            ret res[opt[comptime_value.CTValue], comptime_failure.EvalFail].ok{opt[comptime_value.CTValue].some{comptime_value.ct_u1(true)}};
        }
        val res_open: res[bool, fail.Fail] = type.mentions_generic_param(?s.types, t);
        if (sel res_open.err) { ret res[opt[comptime_value.CTValue], comptime_failure.EvalFail].err{comptime_failure.eval_error(comptime_failure.EVAL_FAIL_INTERNAL, diagnostic_kind.COMPILER_INTERNAL, fail.describe(res_open.err))}; }
        if (res_open.ok) {
            ret res[opt[comptime_value.CTValue], comptime_failure.EvalFail].ok{opt[comptime_value.CTValue].none{}};
        }
        ret res[opt[comptime_value.CTValue], comptime_failure.EvalFail].ok{opt[comptime_value.CTValue].some{comptime_value.ct_u1(false)}};
    }

    if (type.is_secret(?s.types, t) && which != comptime_capability.TYPE_QUERY_NAME) {
        ret res[opt[comptime_value.CTValue], comptime_failure.EvalFail].ok{opt[comptime_value.CTValue].some{comptime_value.ct_u1(false)}};
    }

    if (type.shape_kind(?s.types, t) == type_kind.TYPE_GENERIC_PARAM) {
        ret res[opt[comptime_value.CTValue], comptime_failure.EvalFail].ok{opt[comptime_value.CTValue].none{}};
    }

    if (which == comptime_capability.TYPE_QUERY_NAME) {
        val res_type_to_str: res[str, fail.Fail] = typename.type_to_str(s, t);
        if (sel res_type_to_str.err) {
            val k: diagnostic_kind.Kind = fail.kind_of(res_type_to_str.err);
            if (k != diagnostic_kind.NONE && k != diagnostic_kind.COMPILER_INTERNAL) {
                ret res[opt[comptime_value.CTValue], comptime_failure.EvalFail].err{comptime_failure.eval_error(comptime_failure.EVAL_FAIL_REJECTED, k, fail.describe(res_type_to_str.err))};
            }
            ret res[opt[comptime_value.CTValue], comptime_failure.EvalFail].err{comptime_failure.eval_error(comptime_failure.EVAL_FAIL_INTERNAL, diagnostic_kind.COMPILER_INTERNAL, fail.describe(res_type_to_str.err))};
        }
        val text:               str                        = res_type_to_str.ok;
        val res_interner_added: res[intern.StrId, A.Error] = intern.add(?s.interner, text);
        A.deallocate[char](s.alloc, text, str_len(text) + 1);
        if (sel res_interner_added.err) {
            ret res[opt[comptime_value.CTValue], comptime_failure.EvalFail].err{comptime_failure.eval_error(comptime_failure.EVAL_FAIL_INTERNAL, diagnostic_kind.COMPILER_INTERNAL, base_alloc.text(res_interner_added.err))};
        }
        ret res[opt[comptime_value.CTValue], comptime_failure.EvalFail].ok{opt[comptime_value.CTValue].some{comptime_value.ct_str(res_interner_added.ok)}};
    }

    val k:      type_kind.TypeKind = type.shape_kind(?s.types, t);
    var answer: bool               = false;
    if (which == comptime_capability.TYPE_QUERY_IS_RECORD)  { answer = k == type_kind.TYPE_REC; }
    if (which == comptime_capability.TYPE_QUERY_IS_UNION)   { answer = k == type_kind.TYPE_UNI; }
    if (which == comptime_capability.TYPE_QUERY_IS_TAG)     { answer = k == type_kind.TYPE_TAG; }
    if (which == comptime_capability.TYPE_QUERY_IS_POINTER) { answer = k == type_kind.TYPE_POINTER || k == type_kind.TYPE_PTR; }
    if (which == comptime_capability.TYPE_QUERY_IS_INTEGER) { answer = type_prim.prim_desc(k).class == type_prim.PRIM_CLASS_INT; }
    if (which == comptime_capability.TYPE_QUERY_IS_FLOAT)   { answer = type_prim.prim_desc(k).class == type_prim.PRIM_CLASS_FLOAT; }
    ret res[opt[comptime_value.CTValue], comptime_failure.EvalFail].ok{opt[comptime_value.CTValue].some{comptime_value.ct_u1(answer)}};
}

fun fold_layout_intrinsic(sc: *sema_context.SemaContext, eid: ast_id.ExprId, span: base_source.Span) opt[opt[comptime_value.CTValue]] {
    val is_size:   bool = intrinsic.is_size_of_call(sc.view.a, sc.view.source, eid);
    val is_align:  bool = intrinsic.is_align_of_call(sc.view.a, sc.view.source, eid);
    val is_len:    bool = intrinsic.is_length_of_call(sc.view.a, sc.view.source, eid);
    val is_offset: bool = intrinsic.is_offset_of_call(sc.view.a, sc.view.source, eid);
    val is_id:     bool = intrinsic.is_type_id_call(sc.view.a, sc.view.source, eid);
    if (!is_size && !is_align && !is_len && !is_offset && !is_id) { ret opt[opt[comptime_value.CTValue]].none{}; }

    val arg: ast_id.ExprId = intrinsic.layout_intrinsic_type_arg(sc.view.a, eid);
    if (ast_id.expr_is_nil(arg)) {
        sema_context.report(sc, diagnostic_kind.COMPTIME_INTRINSIC_ARITY, span, "a layout intrinsic takes one type argument");
        ret opt[opt[comptime_value.CTValue]].some{opt[comptime_value.CTValue].none{}};
    }

    val tid: type_kind.TypeId = intrinsic_operand_type(sc, arg, span);
    if (type_kind.is_error(tid)) { ret opt[opt[comptime_value.CTValue]].some{opt[comptime_value.CTValue].none{}}; }

    if (is_id) { ret opt[opt[comptime_value.CTValue]].some{fold_type_id(sc, tid, span)}; }

    if (is_len) {
        val opt_element_count: opt[u32] = type.element_count(?sc.s.types, tid);
        if (!sel opt_element_count.some) {
            check.report_typed(sc, diagnostic_kind.COMPTIME_LENGTH_OF, span, "`$length_of` has no answer for `", tid,
                "`. only a fixed array and a vector have an element count");
            ret opt[opt[comptime_value.CTValue]].some{opt[comptime_value.CTValue].none{}};
        }
        ret opt[opt[comptime_value.CTValue]].some{opt[comptime_value.CTValue].some{comptime_value.ct_uint(opt_element_count.some::u64)}};
    }

    val cyc: intern.StrId = ensure_layout_ready(sc, tid);
    if (!intern.str_is_nil(cyc)) {
        check.report_named(sc, diagnostic_kind.LAYOUT_CYCLE, span, "measuring `", cyc,
            "` here needs a layout this measurement is itself deciding. break the cycle with a literal alignment or length");
        ret opt[opt[comptime_value.CTValue]].some{opt[comptime_value.CTValue].none{}};
    }

    if (is_offset) {
        val res_expression: res[ast_expr.Expr, fail.Fail] = sema_context.expression(sc, eid);
        if (sel res_expression.err)                            { ret opt[opt[comptime_value.CTValue]].some{opt[comptime_value.CTValue].none{}}; }
        if (res_expression.ok.kind != ast_expr.EXPR_KIND_CALL) { ret opt[opt[comptime_value.CTValue]].some{opt[comptime_value.CTValue].none{}}; }
        var call_value: ast_expr.Expr            = res_expression.ok;
        val res_member: res[opt[u32], fail.Fail] = offset_of_member_index(sc, ?call_value.data.call, tid, span, true);
        if (sel res_member.err) { ret opt[opt[comptime_value.CTValue]].some{opt[comptime_value.CTValue].none{}}; }
        val opt_member: opt[u32] = res_member.ok;
        if (!sel opt_member.some) { ret opt[opt[comptime_value.CTValue]].some{opt[comptime_value.CTValue].none{}}; }
        val off: extent.Extent = sema_context.recover_at[extent.Extent](sc, span, extent.field_offset(sc.s, sema_context.laying_of(sc), tid, opt_member.some), extent.unknown(extent.CAUSE_UNKNOWN));
        if (!off.ok) {
            report_layout_failure(sc, span, off.cause);
            ret opt[opt[comptime_value.CTValue]].some{opt[comptime_value.CTValue].none{}};
        }
        ret opt[opt[comptime_value.CTValue]].some{opt[comptime_value.CTValue].some{comptime_value.ct_uint(off.size::u64)}};
    }

    val ext: extent.Extent = sema_context.recover_at[extent.Extent](sc, span, extent.of(sc.s, sema_context.laying_of(sc), tid), extent.unknown(extent.CAUSE_UNKNOWN));
    if (!ext.ok) {
        report_layout_failure(sc, span, ext.cause);
        ret opt[opt[comptime_value.CTValue]].some{opt[comptime_value.CTValue].none{}};
    }

    var n: u32 = ext.size;
    if (is_align) { n = ext.align; }
    ret opt[opt[comptime_value.CTValue]].some{opt[comptime_value.CTValue].some{comptime_value.ct_uint(n::u64)}};
}

# `$type_id` needs no layout, and `^T` keeps its qualifier: a secret is a different type
fun fold_type_id(sc: *sema_context.SemaContext, tid: type_kind.TypeId, span: base_source.Span) opt[comptime_value.CTValue] {
    if (sema_context.awaits_instance(sc, tid)) {
        check.report_typed(sc, diagnostic_kind.COMPTIME_TYPE_ID, span, "`$type_id` of `", tid, "` is answered per instantiation, and this position has none");
        ret opt[comptime_value.CTValue].none{};
    }
    val res_identity: res[u64, fail.Fail] = recipe.identity(sc.s, tid);
    if (sel res_identity.err) {
        check.report_typed(sc, diagnostic_kind.COMPTIME_TYPE_ID, span, "`$type_id` has no identity for `", tid, "`");
        ret opt[comptime_value.CTValue].none{};
    }
    ret opt[comptime_value.CTValue].some{comptime_value.ct_uint(res_identity.ok)};
}

# the member named by `$offset_of(T, m)`: a record field, or a tag case that owns a payload
pub fun offset_of_member_index(sc: *sema_context.SemaContext, c: *ast_expr.ExprCall, owner: type_kind.TypeId, span: base_source.Span, silent: bool) res[opt[u32], fail.Fail] {
    if (c.args_len < 2) { ret res[opt[u32], fail.Fail].ok{opt[u32].none{}}; }
    val res_expression: res[ast_expr.Expr, fail.Fail] = sema_context.expression(sc, sc.view.a.expr_ids.data[c.args_start + 1]);
    if (sel res_expression.err) { ret res[opt[u32], fail.Fail].err{res_expression.err}; }
    val m: ast_expr.Expr = res_expression.ok;
    if (m.kind != ast_expr.EXPR_KIND_IDENT) {
        if (!silent) { sema_context.report(sc, diagnostic_kind.COMPTIME_OFFSET_OF, m.span, "`$offset_of` names its member by a bare identifier"); }
        ret res[opt[u32], fail.Fail].ok{opt[u32].none{}};
    }
    val name: intern.StrId     = m.data.ident.name;
    val base: type_kind.TypeId = type.strip_secret(?sc.s.types, owner);
    sema_context.record_at(sc, span, subst.ensure_fields(sc.s, base));
    val n: u32 = type.field_count(?sc.s.types, base);
    var i: u32 = 0;
    for (i < n) {
        val opt_field_at: opt[*type_field.Entry] = type.field_at(?sc.s.types, base, i);
        if (sel opt_field_at.some) {
            if (intern.str_same(opt_field_at.some.name, name)) {
                if (type.is_tag(?sc.s.types, base) && type_kind.is_nil(opt_field_at.some.ty)) {
                    if (!silent) { check.report_named(sc, diagnostic_kind.COMPTIME_OFFSET_OF, m.span, "`$offset_of` case `", name, "` has no payload, so it has no offset"); }
                    ret res[opt[u32], fail.Fail].ok{opt[u32].none{}};
                }
                ret res[opt[u32], fail.Fail].ok{opt[u32].some{i}};
            }
        }
        i = i + 1;
    }
    if (!silent) {
        if (type.is_tag(?sc.s.types, base)) { check.report_named(sc, diagnostic_kind.TAG_UNKNOWN_CASE, m.span, "unknown tag case `", name, "`"); }
        or                                  { check.report_no_field(sc, m.span, name, base); }
    }
    ret res[opt[u32], fail.Fail].ok{opt[u32].none{}};
}

# a field descriptor's offset, from the checked type layout
pub fun field_offset(sc: *sema_context.SemaContext, owner: u32, index: u32) res[opt[comptime_value.CTValue], comptime_failure.EvalFail] {
    val owner_ty:  type_kind.TypeId       = owner::type_kind.TypeId;
    val opt_entry: opt[*type_field.Entry] = type.field_at(?sc.s.types, owner_ty, index);
    if (!sel opt_entry.some) { ret res[opt[comptime_value.CTValue], comptime_failure.EvalFail].ok{opt[comptime_value.CTValue].none{}}; }
    val res_off: res[extent.Extent, fail.Fail] = extent.field_offset(sc.s, sema_context.laying_of(sc), owner_ty, index);
    if (sel res_off.err) {
        ret res[opt[comptime_value.CTValue], comptime_failure.EvalFail].err{comptime_failure.eval_from_refusal(res_off.err, diagnostic_kind.LAYOUT_UNAVAILABLE, comptime.COMPTIME_DESCRIPTOR_LAYOUT_MSG)};
    }
    val off: extent.Extent = res_off.ok;
    if (!off.ok) {
        ret res[opt[comptime_value.CTValue], comptime_failure.EvalFail].err{comptime_failure.eval_error(comptime_failure.EVAL_FAIL_REJECTED, diagnostic_kind.LAYOUT_UNAVAILABLE, comptime.COMPTIME_DESCRIPTOR_LAYOUT_MSG)};
    }
    ret res[opt[comptime_value.CTValue], comptime_failure.EvalFail].ok{opt[comptime_value.CTValue].some{comptime_value.ct_uint(off.size::u64)}};
}

fun report_layout_failure(sc: *sema_context.SemaContext, span: base_source.Span, cause: extent.Cause) {
    val opt_cause_text: opt[str] = extent.cause_name(cause);
    if (sel opt_cause_text.none) {
        sema_context.report_internal(sc, span, resolve.unknown_catalog(sc.s, "ExtentCause", cause::u32));
        ret;
    }
    sema_context.reportf(sc, diagnostic_kind.LAYOUT_UNAVAILABLE, span, "the layout of the type this intrinsic names could not be determined ({})", opt_cause_text.some);
}

pub fun resolve_layout_intrinsic(sc: *sema_context.SemaContext, eid: u32) res[opt[comptime_value.CTValue], comptime_failure.EvalFail] {
    if (sc == nil) { ret res[opt[comptime_value.CTValue], comptime_failure.EvalFail].ok{opt[comptime_value.CTValue].none{}}; }
    val e:        ast_id.ExprId                 = eid::ast_id.ExprId;
    val res_expr: res[ast_expr.Expr, fail.Fail] = sema_context.expression(sc, e);
    if (sel res_expr.err) {
        ret res[opt[comptime_value.CTValue], comptime_failure.EvalFail].err{comptime_failure.eval_error(comptime_failure.EVAL_FAIL_INTERNAL, diagnostic_kind.COMPILER_INTERNAL, fail.describe(res_expr.err))};
    }
    val span: base_source.Span = res_expr.ok.span;

    val opt_lay: opt[opt[comptime_value.CTValue]] = fold_layout_intrinsic(sc, e, span);
    if (sel sc.status.kind.internal) {
        ret res[opt[comptime_value.CTValue], comptime_failure.EvalFail].err{comptime_failure.eval_error(comptime_failure.EVAL_FAIL_INTERNAL, diagnostic_kind.COMPILER_INTERNAL, fail.describe(sc.status.kind.internal))};
    }
    if (!sel opt_lay.some) {
        ret res[opt[comptime_value.CTValue], comptime_failure.EvalFail].ok{opt[comptime_value.CTValue].none{}};
    }
    val opt_inner: opt[comptime_value.CTValue] = opt_lay.some;
    if (!sel opt_inner.some) {
        ret res[opt[comptime_value.CTValue], comptime_failure.EvalFail].err{comptime_failure.eval_error(comptime_failure.EVAL_FAIL_REJECTED, diagnostic_kind.LAYOUT_UNAVAILABLE, LAYOUT_REPORTED_MSG)};
    }
    ret res[opt[comptime_value.CTValue], comptime_failure.EvalFail].ok{opt[comptime_value.CTValue].some{opt_inner.some}};
}

val LAYOUT_REPORTED_MSG: str = "this layout intrinsic could not be measured. see the diagnostic reported against it";

val REACHES_MAX_DEPTH: u32 = 1024;

val REACHES_DEPTH_MSG: str = "this type nests too deeply to prove it has a finite size. break the nesting with a pointer `*T`";

fun reaches_nominal(s: *session.Session, seen: *u32, cap: u32, stamp: u32,
    target: type_kind.TypeId, ty: type_kind.TypeId, depth: u32) res[bool, fail.Fail] {
    if (depth >= REACHES_MAX_DEPTH || stack.exhausted()) { ret res[bool, fail.Fail].err{fail.message(REACHES_DEPTH_MSG)}; }

    val base:      type_kind.TypeId = type.strip_secret(?s.types, ty);
    val opt_found: opt[*type.Type]  = type.get(?s.types, base);
    if (!sel opt_found.some) { ret res[bool, fail.Fail].ok{false}; }
    val t: *type.Type = opt_found.some;

    if (t.kind == type_kind.TYPE_ARRAY) {
        ret reaches_nominal(s, seen, cap, stamp, target, t.data.array.base, depth + 1);
    }

    if (t.kind != type_kind.TYPE_REC && t.kind != type_kind.TYPE_UNI && t.kind != type_kind.TYPE_TAG && t.kind != type_kind.TYPE_INSTANCE) {
        ret res[bool, fail.Fail].ok{false};
    }

    val nom: type_kind.TypeId = type.aggregate_nominal(?s.types, base);
    if (type_kind.is_error(nom))     { ret res[bool, fail.Fail].ok{false}; }
    if (type_kind.same(nom, target)) { ret res[bool, fail.Fail].ok{true}; }
    if (nom::u32 >= cap)             { ret res[bool, fail.Fail].ok{false}; }
    if (seen[nom::u32] == stamp)     { ret res[bool, fail.Fail].ok{false}; }
    seen[nom::u32] = stamp;

    val n: u32 = type.field_count(?s.types, nom);
    var i: u32 = 0;
    for (i < n) {
        val opt_field_at: opt[*type_field.Entry] = type.field_at(?s.types, nom, i);
        if (sel opt_field_at.some) {
            val res_reaches: res[bool, fail.Fail] = reaches_nominal(s, seen, cap, stamp, target,
                opt_field_at.some.ty, depth + 1);
            if (sel res_reaches.err) { ret res_reaches; }
            if (res_reaches.ok)      { ret res[bool, fail.Fail].ok{true}; }
        }
        i = i + 1;
    }
    ret res[bool, fail.Fail].ok{false};
}

val REACHES_NO:        u8 = 0;
val REACHES_YES:       u8 = 1;
val REACHES_EXHAUSTED: u8 = 2;

fun reaches_checked(sc: *sema_context.SemaContext, seen: *u32, cap: u32, stamp: u32,
    target: type_kind.TypeId, ty: type_kind.TypeId, at: base_source.Span) u8 {
    val res_reaches: res[bool, fail.Fail] = reaches_nominal(sc.s, seen, cap, stamp, target, ty, 0);
    if (sel res_reaches.err) {
        sema_context.report(sc, diagnostic_kind.TYPE_RECURSIVE, at, fail.describe(res_reaches.err));
        ret REACHES_EXHAUSTED;
    }
    if (res_reaches.ok) { ret REACHES_YES; }
    ret REACHES_NO;
}

fun check_occurs(sc: *sema_context.SemaContext, nom: type_kind.TypeId, fields_start: u32, fields_len: u32,
    seen: *u32, cap: u32, stamp: u32) u32 {
    var next: u32 = stamp;
    var i:    u32 = 0;
    for (i < fields_len) {
        var member: ast_decl.TypedName  = nominal_member(sc, fields_start, i, type.is_tag(?sc.s.types, nom));
        val tn:     *ast_decl.TypedName = ?member;
        val ty:     type_kind.TypeId    = sema_context.resolved_type_of(sc, tn.ty);
        if (reaches_checked(sc, seen, cap, next, nom, ty, tn.name) == REACHES_YES) {
            sema_context.report(sc, diagnostic_kind.TYPE_RECURSIVE, tn.name, "this field holds the type being declared by value, so the type has infinite size. store it behind a pointer `*T` instead");
        }
        next = next + 1;
        i    = i + 1;
    }
    ret next;
}

fun check_uni_secrecy(sc: *sema_context.SemaContext, nom: type_kind.TypeId, fields_start: u32, fields_len: u32,
    seen: *u32, cap: u32, stamp: u32) u32 {
    var next: u32 = stamp;
    if (fields_len < 2) { ret next; }

    val res_allocate: res[*bool, A.Error] = A.allocate[bool](sc.s.alloc, fields_len::usize);
    if (sel res_allocate.err) {
        report_phase.internal(?sc.status, fail.refused(res_allocate.err));
        ret next;
    }
    val sized: *bool = res_allocate.ok;
    fin { A.deallocate[bool](sc.s.alloc, sized, fields_len::usize); }

    # a variant that reaches the union by value is the recursion error's, not this check's
    var b: u32 = 0;
    for (b < fields_len) {
        val btn: *ast_decl.TypedName = ?sc.view.a.typed_names.data[fields_start + b];
        val bty: type_kind.TypeId    = sema_context.resolved_type_of(sc, btn.ty);
        val br:  u8                  = reaches_checked(sc, seen, cap, next, nom, bty, btn.name);
        next = next + 1;
        if (br == REACHES_EXHAUSTED) {
            ret next;
        }
        sized[b] = br == REACHES_NO;
        b        = b + 1;
    }

    # agreement is pairwise over the bytes each pair shares, so no variant stands in for the rest
    var i: u32 = 1;
    for (i < fields_len) {
        if (sized[i]) {
            val tn: *ast_decl.TypedName = ?sc.view.a.typed_names.data[fields_start + i];
            val ty: type_kind.TypeId    = sema_context.resolved_type_of(sc, tn.ty);
            var j:  u32                 = 0;
            for (j < i) {
                if (sized[j]) {
                    val jtn:        *ast_decl.TypedName             = ?sc.view.a.typed_names.data[fields_start + j];
                    val jty:        type_kind.TypeId                = sema_context.resolved_type_of(sc, jtn.ty);
                    val res_agreed: res[secrecy.Verdict, fail.Fail] = secrecy.overlay_agrees(sc.s, sema_context.laying_of(sc), jty, ty);
                    if (sel res_agreed.err) {
                        sema_context.refuse(sc, tn.name, res_agreed.err);
                        ret next;
                    }
                    val agree: secrecy.Verdict = res_agreed.ok;
                    if (agree.agreement == secrecy.UNDECIDABLE) {
                        check.report_secrecy(sc, diagnostic_kind.SECRET_VARIANT_UNPROVABLE, tn.name, secrecy.UNBOUNDED_VARIANTS_MSG, agree, check.GROWTH_NOTE);
                        brk;
                    }
                    if (agree.agreement != secrecy.AGREE) {
                        check.report_secrecy(sc, diagnostic_kind.SECRET_VARIANT_MISMATCH, tn.name, "these overlapping fields are part secret `^` and part public", agree, nil);
                        brk;
                    }
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    ret next;
}

pub fun check_occurs_all(sc: *sema_context.SemaContext) err[fail.Fail] {
    if (sc.view.decl_type == nil) { ret err[fail.Fail].ok{}; }

    val cap: u32 = type.type_count(?sc.s.types);
    if (cap == 0) { ret err[fail.Fail].ok{}; }

    val res_allocate: res[*u32, A.Error] = A.allocate[u32](sc.s.alloc, cap::usize);
    if (sel res_allocate.err) {
        report_phase.internal(?sc.status, fail.refused(res_allocate.err));
        ret err[fail.Fail].err{fail.message(RECURSIVE_SCRATCH_MSG)};
    }
    val seen: *u32 = res_allocate.ok;

    var z: u32 = 0;
    for (z < cap) {
        seen[z] = 0;
        z       = z + 1;
    }
    var stamp: u32 = 1;

    var d: u32 = 0;
    for (d < sc.view.a.decls.len::u32) {
        if (!type_kind.is_nil(sc.view.decl_type[d])) {
            val opt_decl: opt[*ast_decl.Decl] = ast.get_decl(sc.view.a, ast_id.decl(d));
            if (sel opt_decl.some) {
                val dd: *ast_decl.Decl = opt_decl.some;
                if (dd.kind == ast_decl.DECL_KIND_TAG) {
                    stamp = check_occurs(sc, sc.view.decl_type[d], dd.data.tag_.cases_start,
                        dd.data.tag_.cases_len, seen, cap, stamp);
                }
                if (dd.kind == ast_decl.DECL_KIND_REC) {
                    stamp = check_occurs(sc, sc.view.decl_type[d], dd.data.rec_.fields_start,
                        dd.data.rec_.fields_len, seen, cap, stamp);
                }
                if (dd.kind == ast_decl.DECL_KIND_UNI) {
                    stamp = check_occurs(sc, sc.view.decl_type[d], dd.data.uni_.fields_start,
                        dd.data.uni_.fields_len, seen, cap, stamp);
                }
            }
        }
        d = d + 1;
    }

    A.deallocate[u32](sc.s.alloc, seen, cap::usize);
    ret err[fail.Fail].ok{};
}

val RECURSIVE_SCRATCH_MSG: str = "out of memory allocating the recursive-type checker's scratch table, and the check cannot be skipped, because a type that contains itself by value would reach layout with no finite size";

pub fun check_uni_secrecy_all(sc: *sema_context.SemaContext) err[fail.Fail] {
    val cap: u32 = type.type_count(?sc.s.types);
    if (cap == 0) { ret err[fail.Fail].ok{}; }

    val res_allocate: res[*u32, A.Error] = A.allocate[u32](sc.s.alloc, cap::usize);
    if (sel res_allocate.err) {
        report_phase.internal(?sc.status, fail.refused(res_allocate.err));
        ret err[fail.Fail].err{fail.message(RECURSIVE_SCRATCH_MSG)};
    }
    val seen: *u32 = res_allocate.ok;
    var z:    u32  = 0;
    for (z < cap) {
        seen[z] = 0;
        z       = z + 1;
    }

    var stamp: u32 = 1;

    if (sc.view.decl_type != nil) {
        var d: u32 = 0;
        for (d < sc.view.a.decls.len::u32) {
            if (!type_kind.is_nil(sc.view.decl_type[d])) {
                val opt_decl: opt[*ast_decl.Decl] = ast.get_decl(sc.view.a, ast_id.decl(d));
                if (sel opt_decl.some) {
                    val dd: *ast_decl.Decl = opt_decl.some;
                    if (dd.kind == ast_decl.DECL_KIND_UNI) {
                        stamp = check_uni_secrecy(sc, sc.view.decl_type[d], dd.data.uni_.fields_start,
                            dd.data.uni_.fields_len, seen, cap, stamp);
                    }
                }
            }
            d = d + 1;
        }
    }

    var i: u32 = 0;
    for (i < sc.view.a.types.len::u32) {
        val opt_type: opt[*ast_type.Type] = ast.get_type(sc.view.a, ast_id.type(i));
        if (sel opt_type.some) {
            val t: *ast_type.Type = opt_type.some;
            if (t.kind == ast_type.TYPE_KIND_UNI) {
                stamp = check_uni_secrecy(sc, sc.view.type_resolved_ty[i], t.data.uni_.fields_start,
                    t.data.uni_.fields_len, seen, cap, stamp);
            }
        }
        i = i + 1;
    }

    A.deallocate[u32](sc.s.alloc, seen, cap::usize);
    ret err[fail.Fail].ok{};
}

# the layout decorations `did` declares on nominal `ty`, published beside its field table
fun record_decoration(sc: *sema_context.SemaContext, did: ast_id.DeclId, ty: type_kind.TypeId, fields_start: u32, fields_len: u32) {
    val opt_decl: opt[*ast_decl.Decl] = ast.get_decl(sc.view.a, did);
    if (!sel opt_decl.some) { ret; }
    val d: *ast_decl.Decl = opt_decl.some;

    val dec: type_field.Decoration = type_field.Decoration{
        align: declared_align(sc, d), packed: decorator.has(sc.view.a, d, decorator.PACKED), volatile_: decorator.has(sc.view.a, d, decorator.VOLATILE)
    };
    if (dec.packed)                                      { check_packed_no_vector_members(sc, fields_start, fields_len, type.is_tag(?sc.s.types, ty)); }
    if (dec.align == 0 && !dec.packed && !dec.volatile_) { ret; }
    val err_set: err[fail.Fail] = type.decoration_set(?sc.s.types, ty, dec);
    if (sel err_set.err) { report_phase.internal(?sc.status, err_set.err); }
}

# the alignment `d` declares, zero when it declares none or a refused one, which is
# reported here for a type, a function and a global alike
pub fun declared_align(sc: *sema_context.SemaContext, d: *ast_decl.Decl) u32 {
    var i: u32 = 0;
    for (i < d.decorators_len) {
        val dec: *ast_decl.Decorator = ?sc.view.a.decorators.data[d.decorators_start + i];
        if (dec.id == decorator.ALIGN) {
            if (dec.args_len != 1) { ret 0; }
            val arg:     ast_id.ExprId                    = sc.view.a.expr_ids.data[dec.args_start];
            var cv:      comptime_value.CTValue;
            val opt_lay: opt[opt[comptime_value.CTValue]] = fold_layout_intrinsic(sc, arg, dec.name);
            if (sel opt_lay.some) {
                val opt_lay: opt[comptime_value.CTValue] = opt_lay.some;
                if (!sel opt_lay.some) { ret 0; }
                cv = opt_lay.some;
            }
            if (sel opt_lay.none) {
                val res_evaluate: res[comptime_value.CTValue, comptime_failure.EvalFail] = comptime.evaluate[sema_context.SemaContext](sc.view.ctx, sc, sc.typing.caps, sc.view.a, sc.view.source, arg, ?sc.s.interner);
                sema_context.record_eval_result(sc, res_evaluate);
                if (sel res_evaluate.err) {
                    if (comptime_failure.stands_alone(res_evaluate.err)) {
                        sema_context.report(sc, res_evaluate.err.diag, dec.name, res_evaluate.err.message);
                        ret 0;
                    }
                    sema_context.report(sc, diagnostic_kind.DECORATOR_ALIGN, dec.name, "`align` value must be a compile-time constant");
                    ret 0;
                }
                cv = res_evaluate.ok;
            }
            if (cv.kind != comptime_value.CT_KIND_INT) {
                sema_context.report(sc, diagnostic_kind.DECORATOR_ALIGN, dec.name, "`align` value must be an integer");
                ret 0;
            }
            if (comptime_value.ct_is_negative(cv)) {
                sema_context.report(sc, diagnostic_kind.DECORATOR_ALIGN, dec.name, "`align` value must be a non-zero power of two");
                ret 0;
            }
            if (!wide.is_pow2(cv.data.w)) {
                sema_context.report(sc, diagnostic_kind.DECORATOR_ALIGN, dec.name, "`align` value must be a non-zero power of two");
                ret 0;
            }
            val opt_ct_int_u64: opt[u64] = comptime_value.ct_int_u64(cv);
            var n:              u64      = 0;
            if (sel opt_ct_int_u64.some) { n = opt_ct_int_u64.some; }
            if (!sel opt_ct_int_u64.some || n > 0xFFFFFFFF) {
                sema_context.report(sc, diagnostic_kind.DECORATOR_ALIGN, dec.name, "`align` value exceeds the maximum alignment");
                ret 0;
            }
            ret n::u32;
        }
        i = i + 1;
    }
    ret 0;
}

fun check_packed_no_vector_members(sc: *sema_context.SemaContext, fields_start: u32, fields_len: u32, tagged: bool) {
    var i: u32 = 0;
    for (i < fields_len) {
        var member: ast_decl.TypedName  = nominal_member(sc, fields_start, i, tagged);
        val tn:     *ast_decl.TypedName = ?member;
        val fty:    type_kind.TypeId    = sema_context.resolved_type_of(sc, tn.ty);
        ensure_layout_ready(sc, fty);
        var q:      type_query.Query = sema_context.query_of(sc);
        val vector: bool             = reach.vector(?q, fty);
        sema_context.query_settle(sc, ?q, tn.name);
        if (vector) {
            sema_context.report(sc, diagnostic_kind.VECTOR_PACKED_FIELD, tn.name, "a vector field is not allowed in a `#[packed]` record, because packing can misalign it. store the lanes as scalar fields, or drop `#[packed]`");
            ret;
        }
        i = i + 1;
    }
}

fun nominal_member(sc: *sema_context.SemaContext, start: u32, index: u32, tagged: bool) ast_decl.TypedName {
    if (!tagged) { ret sc.view.a.typed_names.data[start + index]; }
    val c: *ast_decl.TagCase = ?sc.view.a.tag_cases.data[start + index];
    ret ast_decl.TypedName{name: c.name, ty: c.payload};
}

fun build_field_table(sc: *sema_context.SemaContext, ty: type_kind.TypeId, fields_start: u32, fields_len: u32) err[fail.Fail] {
    val opt_table: opt[*type_field.Table] = sema_context.field_table_for(sc, ty);
    if (sel opt_table.some) { ret err[fail.Fail].ok{}; }

    var fields: *type_field.Entry = nil;
    if (fields_len != 0) {
        val res_allocated: res[*type_field.Entry, A.Error] = A.allocate[type_field.Entry](sc.s.alloc, fields_len::usize);
        if (sel res_allocated.err) { ret err[fail.Fail].err{fail.refused(res_allocated.err)}; }
        fields = res_allocated.ok;
    }
    fin {
        if (fields != nil) { A.deallocate[type_field.Entry](sc.s.alloc, fields, fields_len::usize); }
    }

    var i: u32 = 0;
    for (i < fields_len) {
        var member: ast_decl.TypedName  = nominal_member(sc, fields_start, i, type.is_tag(?sc.s.types, ty));
        val tn:     *ast_decl.TypedName = ?member;
        val fname:  intern.StrId        = intern_span_or_nil(sc, tn.name);
        var fty:    type_kind.TypeId    = sema_context.resolved_type_of(sc, tn.ty);
        if (type_kind.is_nil(fty) && sc.instance.subst == nil && !ast_id.type_is_nil(tn.ty)) {
            fty = resolve_type_ref(sc, tn.ty);
        }
        if (sel sc.status.kind.internal) { ret err[fail.Fail].err{sc.status.kind.internal}; }
        var previous: u32 = 0;
        for (previous < i) {
            if (intern.str_same(fields[previous].name, fname)) {
                if (type.is_tag(?sc.s.types, ty)) { sema_context.report(sc, diagnostic_kind.TAG_DUPLICATE_CASE, tn.name, "duplicate tag case name"); }
                or                                { check.report_named(sc, diagnostic_kind.NAME_DUPLICATE, tn.name, "`", fname, "` is already a field of this type"); }
                brk;
            }
            previous = previous + 1;
        }
        var notice: deprecation.Deprecation = deprecation.none();
        if (type.is_tag(?sc.s.types, ty)) {
            val c:         *ast_decl.TagCase                       = ?sc.view.a.tag_cases.data[fields_start + i];
            val res_noted: res[deprecation.Deprecation, fail.Fail] = resolve.decorators_deprecation(sc.view.ctx, sc.view.a, c.decorators_start, c.decorators_len);
            if (sel res_noted.err) { ret err[fail.Fail].err{res_noted.err}; }
            notice = res_noted.ok;
        }
        fields[i] = type_field.Entry{name: fname, ty: fty, deprecation: notice};
        i         = i + 1;
    }

    val res_start: res[u32, fail.Fail] = sema_context.field_table_stage(sc, fields_len);
    if (sel res_start.err) { ret err[fail.Fail].err{res_start.err}; }
    val start: u32 = res_start.ok;
    i = 0;
    for (i < fields_len) {
        val err_push: err[fail.Fail] = sema_context.field_table_stage_push_entry(sc, fields[i]);
        if (sel err_push.err) { ret err_push; }
        i = i + 1;
    }

    ret sema_context.field_table_publish(sc, ty, start, fields_len);
}

pub fun intrinsic_operand_type(sc: *sema_context.SemaContext, eid: ast_id.ExprId, span: base_source.Span) type_kind.TypeId {
    val res_expr: res[ast_expr.Expr, fail.Fail] = sema_context.expression(sc, eid);

    if (sel res_expr.ok) {
        if (intrinsic.is_field_type_member(sc.view.a, sc.view.source, eid)) {
            val res_evaluate: res[comptime_value.CTValue, comptime_failure.EvalFail] = comptime.evaluate[sema_context.SemaContext](sc.view.ctx, sc, sc.typing.caps, sc.view.a, sc.view.source, eid, ?sc.s.interner);
            sema_context.record_eval_result(sc, res_evaluate);
            if (sel res_evaluate.err) {
                sema_context.report(sc, res_evaluate.err.diag, span, res_evaluate.err.message);
                ret type_kind.TYPE_ERROR;
            }
            val v: comptime_value.CTValue = res_evaluate.ok;
            if (v.kind != comptime_value.CT_KIND_TYPE) {
                sema_context.report(sc, diagnostic_kind.COMPTIME_TYPE_ARGUMENT, span, "a comptime intrinsic's type argument did not resolve to a type");
                ret type_kind.TYPE_ERROR;
            }
            ret v.data.t::type_kind.TypeId;
        }
    }

    if (sel res_expr.err) {
        sema_context.report_internal(sc, span, fail.message("a comptime intrinsic argument was not parsed as a type"));
        ret type_kind.TYPE_ERROR;
    }
    if (res_expr.ok.kind != ast_expr.EXPR_KIND_TYPE_REF) {
        sema_context.report_internal(sc, span, fail.message("a comptime intrinsic argument was not parsed as a type"));
        ret type_kind.TYPE_ERROR;
    }
    var e_value: ast_expr.Expr  = res_expr.ok;
    val e:       *ast_expr.Expr = ?e_value;

    # type errors include deferred generic operands, and allocation errors carry their own status.
    ret resolve_type_ref(sc, e.data.type_ref.ty);
}

fun interned(sc: *sema_context.SemaContext, text: str) intern.StrId {
    val res_interner_added: res[intern.StrId, A.Error] = intern.add(?sc.s.interner, text);
    if (sel res_interner_added.err) {
        report_phase.internal(?sc.status, fail.refused(res_interner_added.err));
        ret intern.STR_NIL;
    }
    ret res_interner_added.ok;
}

pub fun resolve_type_ref(sc: *sema_context.SemaContext, tid: ast_id.TypeId) type_kind.TypeId {
    if (!ast_id.type_is_nil(tid) && stack.exhausted()) { ret refuse_type_nesting(sc, tid); }
    sema_context.report_deferred_type(sc, tid);
    if (type_is_per_iteration(sc, tid)) {
        ret resolve_type_ref_raw(sc, tid);
    }

    if (memo_state(sc, tid) == sema_context.TYPE_MEMO_RESOLVED) { ret sc.view.type_resolved_ty[ast_id.type_index(tid)]; }

    # a memoized node is resolved once, so what it reports it reports now, whatever walk reached it
    val outer: sema_context.Walk = sema_context.walk_begin(sc);
    if (memo_begin(sc, tid)) { sc.walk.silent = false; }
    val resolved: type_kind.TypeId = resolve_type_ref_raw(sc, tid);
    sema_context.walk_end(sc, outer);
    memo_record(sc, tid, resolved);
    ret resolved;
}

fun refuse_type_nesting(sc: *sema_context.SemaContext, tid: ast_id.TypeId) type_kind.TypeId {
    val opt_type: opt[*ast_type.Type] = ast.get_type(sc.view.a, tid);
    if (sel opt_type.some) { sema_context.refuse_nesting(sc, opt_type.some.span); }
    or                     { report_phase.internal(?sc.status, fail.message("TypeId out of range")); }
    ret type_kind.TYPE_ERROR;
}

# whether the type spelled at `tid` names a `$fields` loop's field type anywhere, so it is
# resolved afresh on every iteration. the walk keeps the type arguments it has yet to visit on a
# worklist rather than the stack, so a spelling nested deeper than any stack is still answered;
# a worklist that cannot grow fails the phase
fun type_is_per_iteration(sc: *sema_context.SemaContext, tid: ast_id.TypeId) bool {
    var work: Vector[ast_id.TypeId] = collections_vector.init[ast_id.TypeId](sc.s.alloc);
    fin { collections_vector.dnit[ast_id.TypeId](?work); }
    var at: ast_id.TypeId = tid;
    for {
        var next: ast_id.TypeId = ast_id.TYPE_NIL;
        if (!ast_id.type_is_nil(at)) {
            val opt_type: opt[*ast_type.Type] = ast.get_type(sc.view.a, at);
            if (sel opt_type.some) {
                val t: *ast_type.Type = opt_type.some;
                if (t.kind == ast_type.TYPE_KIND_FIELD_TYPE)      { ret true; }
                or (t.kind == ast_type.TYPE_KIND_POINTEE_OF)      { next = t.data.pointee_of.inner; }
                or (t.kind == ast_type.TYPE_KIND_DISCRIMINANT_OF) { next = t.data.discriminant_of.inner; }
                or (t.kind == ast_type.TYPE_KIND_PTR)             { next = t.data.ptr.pointee; }
                or (t.kind == ast_type.TYPE_KIND_SECRET)          { next = t.data.secret.inner; }
                or (t.kind == ast_type.TYPE_KIND_ARRAY)           { next = t.data.array.element; }
                or (t.kind == ast_type.TYPE_KIND_NAMED) {
                    var i: u32 = 0;
                    for (i < t.data.named.args_len) {
                        val res_pushed: res[usize, A.Error] = collections_vector.push[ast_id.TypeId](?work, sc.view.a.type_ids.data[t.data.named.args_start + i]);
                        if (sel res_pushed.err) {
                            report_phase.internal(?sc.status, fail.refused(res_pushed.err));
                            ret false;
                        }
                        i = i + 1;
                    }
                }
            }
        }
        if (ast_id.type_is_nil(next)) {
            val opt_popped: opt[ast_id.TypeId] = collections_vector.pop[ast_id.TypeId](?work);
            if (sel opt_popped.none) { ret false; }
            next = opt_popped.some;
        }
        at = next;
    }
}

fun memo_state(sc: *sema_context.SemaContext, tid: ast_id.TypeId) u8 {
    if (sc.view.type_resolved_memo == nil)                  { ret sema_context.TYPE_MEMO_NONE; }
    if (sc.view.type_resolved_ty == nil)                    { ret sema_context.TYPE_MEMO_NONE; }
    if (ast_id.type_index(tid) >= sc.view.a.types.len::u32) { ret sema_context.TYPE_MEMO_NONE; }
    ret sc.view.type_resolved_memo[ast_id.type_index(tid)];
}

# marks `tid` as being resolved, answering whether it is memoized at all
fun memo_begin(sc: *sema_context.SemaContext, tid: ast_id.TypeId) bool {
    if (sc.view.type_resolved_memo == nil)                  { ret false; }
    if (sc.view.type_resolved_ty == nil)                    { ret false; }
    if (ast_id.type_index(tid) >= sc.view.a.types.len::u32) { ret false; }
    sc.view.type_resolved_memo[ast_id.type_index(tid)] = sema_context.TYPE_MEMO_ACTIVE;
    ret true;
}

fun memo_record(sc: *sema_context.SemaContext, tid: ast_id.TypeId, resolved: type_kind.TypeId) {
    if (sc.view.type_resolved_memo == nil)                  { ret; }
    if (sc.view.type_resolved_ty == nil)                    { ret; }
    if (ast_id.type_index(tid) >= sc.view.a.types.len::u32) { ret; }
    sc.view.type_resolved_ty[ast_id.type_index(tid)]   = resolved;
    sc.view.type_resolved_memo[ast_id.type_index(tid)] = sema_context.TYPE_MEMO_RESOLVED;
}

fun resolve_type_ref_raw(sc: *sema_context.SemaContext, tid: ast_id.TypeId) type_kind.TypeId {
    val opt_type: opt[*ast_type.Type] = ast.get_type(sc.view.a, tid);
    if (!sel opt_type.some) { ret type_kind.TYPE_ERROR; }
    val t: *ast_type.Type = opt_type.some;

    if (t.kind == ast_type.TYPE_KIND_NAMED)           { ret resolve_type_named(sc, tid, ?t.data.named, t.span); }
    if (t.kind == ast_type.TYPE_KIND_PTR)             { ret resolve_type_ptr(sc, ?t.data.ptr); }
    if (t.kind == ast_type.TYPE_KIND_SECRET)          { ret resolve_type_secret(sc, ?t.data.secret); }
    if (t.kind == ast_type.TYPE_KIND_FIELD_TYPE)      { ret resolve_type_field_type(sc, ?t.data.field_type, t.span); }
    if (t.kind == ast_type.TYPE_KIND_POINTEE_OF)      { ret resolve_type_pointee_of(sc, ?t.data.pointee_of, t.span); }
    if (t.kind == ast_type.TYPE_KIND_DISCRIMINANT_OF) { ret resolve_type_discriminant_of(sc, ?t.data.discriminant_of, t.span); }
    if (t.kind == ast_type.TYPE_KIND_ARRAY)           { ret resolve_type_array(sc, tid, ?t.data.array, t.span); }
    if (t.kind == ast_type.TYPE_KIND_FUN)             { ret resolve_type_fun(sc, ?t.data.fun_); }
    if (t.kind == ast_type.TYPE_KIND_REC)             { ret resolve_type_anon(sc, tid, t.data.rec_.fields_start, t.data.rec_.fields_len, type_kind.TYPE_REC); }
    if (t.kind == ast_type.TYPE_KIND_UNI)             { ret resolve_type_anon(sc, tid, t.data.uni_.fields_start, t.data.uni_.fields_len, type_kind.TYPE_UNI); }
    if (t.kind == ast_type.TYPE_KIND_PACK) {
        val res_intern_pack: res[type_kind.TypeId, fail.Fail] = type.intern_pack(?sc.s.types);
        if (sel res_intern_pack.err) {
            report_phase.internal(?sc.status, res_intern_pack.err);
            ret type_kind.TYPE_ERROR;
        }
        ret res_intern_pack.ok;
    }
    if (t.kind != ast_type.TYPE_KIND_ERROR) {
        report_phase.internal(?sc.status, resolve.unknown_catalog(sc.s, "AstTypeKind", t.kind::u32));
    }
    ret type_kind.TYPE_ERROR;
}

fun resolve_type_field_type(sc: *sema_context.SemaContext, ft: *ast_type.TypeFieldType, span: base_source.Span) type_kind.TypeId {
    val res_range_add: res[intern.StrId, A.Error] = intern.range_add(?sc.s.interner, sc.view.source, ft.var_name.offset, ft.var_name.len);
    if (sel res_range_add.err) {
        sema_context.report_internal(sc, span, fail.refused(res_range_add.err));
        ret type_kind.TYPE_ERROR;
    }
    val res_field_type_of_binding: res[opt[u32], comptime_failure.EvalFail] = comptime_scope.field_type_of_binding[sema_context.SemaContext](sc.view.ctx, sc, sc.typing.caps, res_range_add.ok);
    if (sel res_field_type_of_binding.err) {
        val f: comptime_failure.EvalFail = res_field_type_of_binding.err;
        if (f.kind == comptime_failure.EVAL_FAIL_INTERNAL) { sema_context.report_internal(sc, span, fail.message(f.message)); }
        or (f.kind == comptime_failure.EVAL_FAIL_REJECTED) { sema_context.report(sc, f.diag, span, f.message); }
        ret type_kind.TYPE_ERROR;
    }
    val opt_resolved: opt[u32] = res_field_type_of_binding.ok;
    if (sel opt_resolved.none) { ret type_kind.TYPE_ERROR; }
    ret opt_resolved.some::type_kind.TypeId;
}

fun resolve_type_discriminant_of(sc: *sema_context.SemaContext, dof: *ast_type.TypeDiscriminantOf, span: base_source.Span) type_kind.TypeId {
    val inner: type_kind.TypeId = resolve_type_ref(sc, dof.inner);
    if (type_kind.is_error(inner) || type_kind.is_nil(inner)) { ret type_kind.TYPE_ERROR; }
    val base: type_kind.TypeId = type.strip_secret(?sc.s.types, inner);
    if (!type.is_tag(?sc.s.types, base)) {
        check.report_typed(sc, diagnostic_kind.COMPTIME_DISCRIMINANT_OF, span, "`$discriminant_of` expects a tag, but this names `", inner, "`");
        ret type_kind.TYPE_ERROR;
    }
    ensure_layout_ready(sc, base);
    val disc: type_kind.TypeId = type.tag_discriminator(?sc.s.types, base);
    if (type_kind.is_nil(disc) || type_kind.is_error(disc)) { ret type_kind.TYPE_ERROR; }
    ret disc;
}

fun resolve_type_pointee_of(sc: *sema_context.SemaContext, po: *ast_type.TypePointeeOf, span: base_source.Span) type_kind.TypeId {
    val inner: type_kind.TypeId = resolve_type_ref(sc, po.inner);
    if (type_kind.is_error(inner) || type_kind.is_nil(inner)) { ret type_kind.TYPE_ERROR; }

    val k: type_kind.TypeKind = type.shape_kind(?sc.s.types, inner);
    if (k == type_kind.TYPE_GENERIC_PARAM) { ret type_kind.TYPE_ERROR; }

    if (type.is_secret(?sc.s.types, inner)) {
        check.report_typed(sc, diagnostic_kind.COMPTIME_POINTEE_OF, span, "`$pointee_of` has no answer for `", inner,
            "`, because a `^` secret is not a reference, and `$is_pointer` answers false for it");
        ret type_kind.TYPE_ERROR;
    }

    val opt_types_entry: opt[*type.Type] = type.get(?sc.s.types, inner);
    if (sel opt_types_entry.some) {
        if (opt_types_entry.some.kind == type_kind.TYPE_POINTER) {
            ret opt_types_entry.some.data.pointer.base;
        }
    }

    if (k == type_kind.TYPE_PTR) {
        sema_context.report(sc, diagnostic_kind.COMPTIME_POINTEE_OF, span, "`$pointee_of(ptr)` has no answer, because `ptr` has no pointee type");
        ret type_kind.TYPE_ERROR;
    }

    check.report_typed(sc, diagnostic_kind.COMPTIME_POINTEE_OF, span, "`$pointee_of` expects a typed reference `*U`, but this names `", inner, "`");
    ret type_kind.TYPE_ERROR;
}

fun resolve_type_named(sc: *sema_context.SemaContext, tid: ast_id.TypeId, named: *ast_type.TypeNamed, span: base_source.Span) type_kind.TypeId {
    val opt_sym: opt[*resolve.Symbol] = sema_context.symbol_for_type(sc, tid);
    if (!sel opt_sym.some) {
        ret type_kind.TYPE_ERROR;
    }
    val sym: *resolve.Symbol = opt_sym.some;

    if (named.args_len > 0) {
        ret instantiate_named(sc, sym, named, span);
    }

    if (named.operand && is_value_binding(sym)) { ret binding_type_for(sc, sym, span); }

    ret type_for_symbol(sc, sym, span);
}

fun is_value_binding(sym: *resolve.Symbol) bool {
    if ((sym.flags & resolve.SYM_FLAG_COMPTIME) != 0) { ret false; }
    if (ast_id.decl_is_nil(sym.decl))                 { ret false; }
    if (sym.kind == resolve.SYM_VAL)                  { ret true; }
    if (sym.kind == resolve.SYM_VAR)                  { ret true; }
    if (sym.kind == resolve.SYM_PARAM)                { ret true; }
    ret false;
}

fun binding_type_for(sc: *sema_context.SemaContext, sym: *resolve.Symbol, span: base_source.Span) type_kind.TypeId {
    if (sym.kind == resolve.SYM_PARAM || sema_context.foreign(sc, sym)) {
        val t: type_kind.TypeId = sema_context.decl_type_for(sc, sym);
        if (type_kind.is_nil(t) || type_kind.is_error(t)) {
            check.report_named(sc, diagnostic_kind.COMPTIME_UNMEASURABLE, span, "`", sym.name, "` has no type a comptime intrinsic can measure here");
            ret type_kind.TYPE_ERROR;
        }
        ret t;
    }

    val opt_decl: opt[*ast_decl.Decl] = ast.get_decl(sc.view.a, sym.decl);
    if (!sel opt_decl.some) { ret type_kind.TYPE_ERROR; }
    val d: *ast_decl.Decl = opt_decl.some;
    if (d.kind != ast_decl.DECL_KIND_VAL && d.kind != ast_decl.DECL_KIND_VAR) { ret type_kind.TYPE_ERROR; }
    if (ast_id.type_is_nil(d.data.bind.ty))                                   { ret type_kind.TYPE_ERROR; }
    ret resolve_type_ref(sc, d.data.bind.ty);
}

pub fun type_for_symbol(sc: *sema_context.SemaContext, sym: *resolve.Symbol, span: base_source.Span) type_kind.TypeId {
    if (sym.kind == resolve.SYM_REC || sym.kind == resolve.SYM_UNI || sym.kind == resolve.SYM_TAG || sym.kind == resolve.SYM_IMPORTED) {
        val arity: u32 = sym.generic_arity;
        if (arity > 0) {
            check.report_missing_type_args(sc, span, sym.name, arity);
            ret type_kind.TYPE_ERROR;
        }
    }

    if (sym.kind == resolve.SYM_PRIM) {
        ret prim_or_error(sc, sym.slot::type_kind.TypeKind);
    }
    if (sym.kind == resolve.SYM_VECTOR) {
        ret sym.slot::type_kind.TypeId;
    }
    if (sym.kind == resolve.SYM_GENERIC) { ret sema_context.generic_param_type_for(sc, sym); }
    if (sym.kind == resolve.SYM_REC || sym.kind == resolve.SYM_UNI || sym.kind == resolve.SYM_TAG) {
        var kind: type_kind.TypeKind = type_kind.TYPE_REC;
        if (sym.kind == resolve.SYM_UNI) { kind = type_kind.TYPE_UNI; }
        if (sym.kind == resolve.SYM_TAG) { kind = type_kind.TYPE_TAG; }
        if (base_source.file_is_nil(sym.definition_file)) {
            sema_context.report_internal(sc, span, fail.message("nominal symbol has no defining source identity"));
            ret type_kind.TYPE_ERROR;
        }
        val res_intern_nominal: res[type_kind.TypeId, fail.Fail] = type.intern_nominal(?sc.s.types, sym.canon, resolve.type_owner(sc.s, resolve.origin_of(sc.s, sym), sym.definition_file), kind);
        if (sel res_intern_nominal.err) {
            sema_context.report_internal(sc, span, res_intern_nominal.err);
            ret type_kind.TYPE_ERROR;
        }
        ret res_intern_nominal.ok;
    }
    if (sym.kind == resolve.SYM_DEF) {
        ret def_underlying(sc, sym, span);
    }
    if (sym.kind == resolve.SYM_IMPORTED) {
        val imported: type_kind.TypeId = sema_context.decl_type_for(sc, sym);
        if (type_kind.is_nil(imported) || type_kind.is_error(imported)) {
            check.report_named(sc, diagnostic_kind.NAME_NOT_TYPE, span, "imported `", sym.name, "` does not resolve to a type");
            ret type_kind.TYPE_ERROR;
        }
        ret imported;
    }
    check.report_named(sc, diagnostic_kind.NAME_NOT_TYPE, span, "`", sym.name, "` does not name a type");
    ret type_kind.TYPE_ERROR;
}

pub fun def_underlying(sc: *sema_context.SemaContext, sym: *resolve.Symbol, span: base_source.Span) type_kind.TypeId {
    if (!sema_context.foreign(sc, sym)) {
        val opt_decl: opt[*ast_decl.Decl] = ast.get_decl(sc.view.a, sym.decl);
        if (!sel opt_decl.some) { ret type_kind.TYPE_ERROR; }
        val d: *ast_decl.Decl = opt_decl.some;
        if (d.kind != ast_decl.DECL_KIND_DEF) { ret type_kind.TYPE_ERROR; }
        if (ast_id.type_is_nil(d.data.def_.ty) && abitype.declares_abi_type(sc, d)) {
            ret abitype.type_of(sc, d);
        }
        if (ast_id.type_is_nil(d.data.def_.ty)) { ret sema_handle.type_of(sc, sym.decl, d); }
        if (expanding(sc, sym.decl))            { ret refuse_def_cycle(sc, sym, span); }
        var here: sema_context.Expansion = sema_context.Expansion{decl: sym.decl, name: sym.name, outer: sc.walk.expanding};
        sc.walk.expanding = ?here;
        val ty: type_kind.TypeId = resolve_type_ref(sc, d.data.def_.ty);
        sc.walk.expanding = here.outer;
        ret ty;
    }
    ret sema_context.decl_type_for(sc, sym);
}

# whether the walk is inside the definition of the alias `decl`
fun expanding(sc: *sema_context.SemaContext, decl: ast_id.DeclId) bool {
    var at: *sema_context.Expansion = sc.walk.expanding;
    for (at != nil) {
        if (at.decl == decl) { ret true; }
        at = at.outer;
    }
    ret false;
}

# an alias names a type and is never one, so a definition that reaches itself, behind a
# pointer or not, has no type to stand for: refused at the name that closes the cycle, naming
# each alias on it in the order the definitions name them
fun refuse_def_cycle(sc: *sema_context.SemaContext, sym: *resolve.Symbol, span: base_source.Span) type_kind.TypeId {
    var depth: u32                     = 0;
    var at:    *sema_context.Expansion = sc.walk.expanding;
    for (at.decl != sym.decl) {
        depth = depth + 1;
        at    = at.outer;
    }
    var b: textbuild.TextBuilder = textbuild.tb_init(sc.s.alloc);
    fin { textbuild.tb_dnit(?b); }
    textbuild.tb_append(?b, typename.name_str(sc.s, sym.name));
    var step: u32 = depth;
    for (step > 0) {
        step = step - 1;
        var named: *sema_context.Expansion = sc.walk.expanding;
        var k:     u32                     = 0;
        for (k < step) {
            named = named.outer;
            k     = k + 1;
        }
        textbuild.tb_append(?b, " -> ");
        textbuild.tb_append(?b, typename.name_str(sc.s, named.name));
    }
    textbuild.tb_append(?b, " -> ");
    textbuild.tb_append(?b, typename.name_str(sc.s, sym.name));
    val res_text: res[str, textbuild.Error] = textbuild.tb_finish(?b);
    if (sel res_text.err) {
        report_phase.internal(?sc.status, fail.message(textbuild.text(res_text.err)));
        ret type_kind.TYPE_ERROR;
    }
    fin { str_free(sc.s.alloc, res_text.ok); }
    sema_context.reportf(sc, diagnostic_kind.DEF_CYCLE, span,
        "`{}` names itself through its own definition ({}). an alias is another name for the type it names and never a type of its own, so its definition never ends, behind a pointer or not. declare a `rec` to give the type a name it can refer to",
        typename.name_str(sc.s, sym.name), res_text.ok);
    ret type_kind.TYPE_ERROR;
}

fun instantiate_named(sc: *sema_context.SemaContext, sym: *resolve.Symbol, named: *ast_type.TypeNamed, span: base_source.Span) type_kind.TypeId {
    val res_allocate_params: res[*type_kind.TypeId, fail.Fail] = allocate_params(sc, named.args_len);
    if (sel res_allocate_params.err) {
        sema_context.report_internal(sc, span, res_allocate_params.err);
        ret type_kind.TYPE_ERROR;
    }
    val args: *type_kind.TypeId = res_allocate_params.ok;
    fin { params_free(sc, args, named.args_len); }

    val hits_before: u32 = sc.walk.deferred_hits;
    var i:           u32 = 0;
    for (i < named.args_len) {
        val arg_tid: ast_id.TypeId = sc.view.a.type_ids.data[named.args_start + i];
        args[i] = resolve_type_ref(sc, arg_tid);
        i       = i + 1;
    }
    # an argument naming what resolve left for its arm is reported as that name, if the arm is selected
    if (sc.walk.deferred_hits != hits_before) { ret type_kind.TYPE_ERROR; }

    val res_instantiate: res[type_kind.TypeId, fail.Fail] = generics.instantiate(sc, sym, args, named.args_len, span);
    if (sel res_instantiate.err) {
        sema_context.report_internal(sc, span, res_instantiate.err);
        ret type_kind.TYPE_ERROR;
    }
    ret res_instantiate.ok;
}

fun resolve_type_ptr(sc: *sema_context.SemaContext, p: *ast_type.TypePtr) type_kind.TypeId {
    val base: type_kind.TypeId = resolve_type_ref(sc, p.pointee);
    ret ptr_to(sc, base);
}

fun resolve_type_secret(sc: *sema_context.SemaContext, s: *ast_type.TypeSecret) type_kind.TypeId {
    val inner: type_kind.TypeId = resolve_type_ref(sc, s.inner);
    if (type_kind.is_error(inner)) { ret type_kind.TYPE_ERROR; }
    val res_intern_secret: res[type_kind.TypeId, fail.Fail] = type.intern_secret(?sc.s.types, inner);
    if (sel res_intern_secret.err) {
        report_phase.internal(?sc.status, res_intern_secret.err);
        ret type_kind.TYPE_ERROR;
    }
    ret res_intern_secret.ok;
}

fun resolve_type_array(sc: *sema_context.SemaContext, tid: ast_id.TypeId, ar: *ast_type.TypeArray, span: base_source.Span) type_kind.TypeId {
    val elem: type_kind.TypeId = resolve_type_ref(sc, ar.element);
    if (type_kind.is_error(elem)) { ret type_kind.TYPE_ERROR; }

    val inferred_len: u64 = sema_context.inferred_len_of(sc, tid);
    if (ast_id.expr_is_nil(ar.length)) {
        if (inferred_len == sema_product.INFERRED_LEN_FAILED) { ret type_kind.TYPE_ERROR; }
        if (inferred_len == sema_product.INFERRED_LEN_NEEDS_LITERAL) {
            sema_context.report(sc, diagnostic_kind.ARRAY_INFERRED_LENGTH, span, "an inferred array length `[_]` needs an array literal initializer, as in `val x: [_]T = [_]T{...}`");
            ret type_kind.TYPE_ERROR;
        }
        if (inferred_len == sema_product.INFERRED_LEN_NONE) {
            sema_context.report(sc, diagnostic_kind.ARRAY_INFERRED_LENGTH, span, "an inferred array length `[_]` is allowed only on an array literal `[_]T{...}`, a `val` or `var` it initializes, or an `#[embed(...)]` declaration, and never nested in another type");
            ret type_kind.TYPE_ERROR;
        }
        val res_intern_array: res[type_kind.TypeId, fail.Fail] = type.intern_array(?sc.s.types, elem, inferred_len::u32);
        if (sel res_intern_array.err) {
            sema_context.report_internal(sc, span, res_intern_array.err);
            ret type_kind.TYPE_ERROR;
        }
        ret res_intern_array.ok;
    }

    var cv:      comptime_value.CTValue;
    val opt_lay: opt[opt[comptime_value.CTValue]] = fold_layout_intrinsic(sc, ar.length, span);
    if (sel opt_lay.some) {
        val opt_lay: opt[comptime_value.CTValue] = opt_lay.some;
        if (!sel opt_lay.some) { ret type_kind.TYPE_ERROR; }
        cv = opt_lay.some;
    }
    if (sel opt_lay.none) {
        # typed quietly first, as a constant initializer is, so a cast in the length folds at the
        # types its operands were given; a failure is named by the refusal below
        var caps:  comptime_capability.PhaseCapabilities[sema_context.SemaContext] = sc.typing.caps;
        val outer: sema_context.Walk                                               = sema_context.walk_begin(sc);
        if (sc.typing.infer_fn != nil) {
            sc.walk.silent = true;
            sc.typing.infer_fn(sc, ar.length);
            caps = sc.typing.type_caps;
        }
        val res_len: res[comptime_value.CTValue, comptime_failure.EvalFail] = comptime.evaluate[sema_context.SemaContext](sc.view.ctx, sc, caps, sc.view.a, sc.view.source, ar.length, ?sc.s.interner);
        sema_context.walk_end(sc, outer);
        sema_context.record_eval_result(sc, res_len);
        if (sel res_len.err) {
            # a length the target leaves unspecified is refused as itself, naming the target, as is a secret
            if (res_len.err.diag == diagnostic_kind.COMPTIME_NAN_UNSPECIFIED || comptime_failure.stands_alone(res_len.err)) {
                sema_context.report(sc, res_len.err.diag, span, res_len.err.message);
                ret type_kind.TYPE_ERROR;
            }
            sema_context.reportf(sc, diagnostic_kind.ARRAY_LENGTH_NOT_CONST, span, "the array length must be a comptime constant ({})", res_len.err.message);
            ret type_kind.TYPE_ERROR;
        }
        cv = res_len.ok;
    }
    if (cv.kind != comptime_value.CT_KIND_INT) {
        sema_context.report(sc, diagnostic_kind.ARRAY_LENGTH_VALUE, span, "an array length must be an integer");
        ret type_kind.TYPE_ERROR;
    }
    if (comptime_value.ct_is_negative(cv)) {
        sema_context.report(sc, diagnostic_kind.ARRAY_LENGTH_VALUE, span, "an array length must not be negative");
        ret type_kind.TYPE_ERROR;
    }
    val opt_len_u: opt[u64] = comptime_value.ct_int_u64(cv);
    var len_u:     u64      = 0;
    if (sel opt_len_u.some) { len_u = opt_len_u.some; }
    if (!sel opt_len_u.some || len_u > 4294967295) {
        sema_context.report(sc, diagnostic_kind.ARRAY_LENGTH_VALUE, span, "an array length must be at most 4294967295");
        ret type_kind.TYPE_ERROR;
    }

    if (inferred_len == sema_product.INFERRED_LEN_FAILED) { ret type_kind.TYPE_ERROR; }
    if (inferred_len != sema_product.INFERRED_LEN_NONE && len_u != inferred_len) {
        report_embed_size(sc, span, len_u, inferred_len);
        ret type_kind.TYPE_ERROR;
    }

    val res_intern_array: res[type_kind.TypeId, fail.Fail] = type.intern_array(?sc.s.types, elem, len_u::u32);
    if (sel res_intern_array.err) {
        sema_context.report_internal(sc, span, res_intern_array.err);
        ret type_kind.TYPE_ERROR;
    }
    ret res_intern_array.ok;
}

fun report_embed_size(sc: *sema_context.SemaContext, span: base_source.Span, declared: u64, actual: u64) {
    sema_context.reportf(sc, diagnostic_kind.EMBED_SIZE, span, "`embed` declares {} bytes but the file holds {}", declared, actual);
}

fun resolve_type_fun(sc: *sema_context.SemaContext, fn: *ast_type.TypeFun) type_kind.TypeId {
    var ret_type: type_kind.TypeId = type_kind.TYPE_NIL;
    if (!ast_id.type_is_nil(fn.ret_type)) { ret_type = resolve_type_ref(sc, fn.ret_type); }

    if (fn.params_len == 0) {
        val res_intern_function: res[type_kind.TypeId, fail.Fail] = type.intern_function(?sc.s.types, ret_type, nil, 0, fn.c_variadic);
        if (sel res_intern_function.err) {
            report_phase.internal(?sc.status, res_intern_function.err);
            ret type_kind.TYPE_ERROR;
        }
        ret res_intern_function.ok;
    }

    val res_allocate_params: res[*type_kind.TypeId, fail.Fail] = allocate_params(sc, fn.params_len);
    if (sel res_allocate_params.err) {
        report_phase.internal(?sc.status, res_allocate_params.err);
        ret type_kind.TYPE_ERROR;
    }
    val params: *type_kind.TypeId = res_allocate_params.ok;

    var i: u32 = 0;
    for (i < fn.params_len) {
        val pt: ast_id.TypeId = sc.view.a.type_ids.data[fn.params_start + i];
        params[i] = resolve_type_ref(sc, pt);
        i         = i + 1;
    }

    val res_intern_function: res[type_kind.TypeId, fail.Fail] = type.intern_function(?sc.s.types, ret_type, params, fn.params_len, fn.c_variadic);
    params_free(sc, params, fn.params_len);
    if (sel res_intern_function.err) {
        report_phase.internal(?sc.status, res_intern_function.err);
        ret type_kind.TYPE_ERROR;
    }
    ret res_intern_function.ok;
}

pub fun resolve_type_anon(sc: *sema_context.SemaContext, tid: ast_id.TypeId, fields_start: u32, fields_len: u32, kind: type_kind.TypeKind) type_kind.TypeId {
    val name_id: intern.StrId = synth_anon_name(sc, kind);

    val key: intern.StrId = anon_struct_key(sc, fields_start, fields_len, kind);
    if (intern.str_is_nil(key)) { ret type_kind.TYPE_ERROR; }

    val res_intern_anonymous: res[type_kind.TypeId, fail.Fail] = type.intern_anonymous(?sc.s.types, name_id, resolve.type_owner(sc.s, sc.view.own_module, sc.view.a.file_id), sc.view.a.incarnation, key, kind);
    if (sel res_intern_anonymous.err) {
        report_phase.internal(?sc.status, res_intern_anonymous.err);
        ret type_kind.TYPE_ERROR;
    }
    val ty: type_kind.TypeId = res_intern_anonymous.ok;

    val err_fields: err[fail.Fail] = build_field_table(sc, ty, fields_start, fields_len);
    if (sel err_fields.err) {
        report_phase.internal(?sc.status, err_fields.err);
        ret type_kind.TYPE_ERROR;
    }
    ret ty;
}

fun anon_struct_key(sc: *sema_context.SemaContext, fields_start: u32, fields_len: u32, kind: type_kind.TypeKind) intern.StrId {
    val res_allocated: res[*type_field.Entry, A.Error] = A.allocate[type_field.Entry](sc.s.alloc, fields_len::usize);
    if (sel res_allocated.err) {
        report_phase.internal(?sc.status, fail.refused(res_allocated.err));
        ret intern.STR_NIL;
    }
    val entries: *type_field.Entry = res_allocated.ok;
    fin { A.deallocate[type_field.Entry](sc.s.alloc, entries, fields_len::usize); }
    var i: u32 = 0;
    for (i < fields_len) {
        val tn: ast_decl.TypedName = sc.view.a.typed_names.data[fields_start + i];
        entries[i] = type_field.Entry{name: intern_span_or_nil(sc, tn.name), ty: sema_context.resolved_type_of(sc, tn.ty), deprecation: deprecation.none()};
        if (!sel sc.status.kind.accepted)      { ret intern.STR_NIL; }
        if (type_kind.is_error(entries[i].ty)) { ret intern.STR_NIL; }
        i = i + 1;
    }
    val res_encoded: res[intern.StrId, fail.Fail] = recipe.anonymous(sc.s, kind, entries, fields_len);
    if (sel res_encoded.err) {
        report_phase.internal(?sc.status, res_encoded.err);
        ret intern.STR_NIL;
    }
    ret res_encoded.ok;
}

fun synth_anon_name(sc: *sema_context.SemaContext, kind: type_kind.TypeKind) intern.StrId {
    var label: str = "__anon_rec";
    if (kind == type_kind.TYPE_UNI) { label = "__anon_uni"; }
    ret interned(sc, label);
}

pub fun ptr_to(sc: *sema_context.SemaContext, base: type_kind.TypeId) type_kind.TypeId {
    if (type_kind.is_error(base)) { ret type_kind.TYPE_ERROR; }
    val res_intern_pointer: res[type_kind.TypeId, fail.Fail] = type.intern_pointer(?sc.s.types, base);
    if (sel res_intern_pointer.err) {
        report_phase.internal(?sc.status, res_intern_pointer.err);
        ret type_kind.TYPE_ERROR;
    }
    ret res_intern_pointer.ok;
}

pub fun prim_or_error(sc: *sema_context.SemaContext, kind: type_kind.TypeKind) type_kind.TypeId {
    val opt_prim: opt[type_kind.TypeId] = type.prim(?sc.s.types, kind);
    if (!sel opt_prim.some) { ret type_kind.TYPE_ERROR; }
    ret opt_prim.some;
}

pub fun intern_span_or_nil(sc: *sema_context.SemaContext, span: base_source.Span) intern.StrId {
    if (span.len == 0) { ret intern.STR_NIL; }
    val res_range_add: res[intern.StrId, A.Error] = intern.range_add(?sc.s.interner, sc.view.source, span.offset, span.len);
    if (sel res_range_add.err) {
        sema_context.report_internal(sc, span, fail.refused(res_range_add.err));
        ret intern.STR_NIL;
    }
    ret res_range_add.ok;
}

pub fun allocate_params(sc: *sema_context.SemaContext, count: u32) res[*type_kind.TypeId, fail.Fail] {
    val res_allocated: res[*type_kind.TypeId, A.Error] = A.allocate[type_kind.TypeId](sc.s.alloc, count::usize);
    if (sel res_allocated.err) { ret res[*type_kind.TypeId, fail.Fail].err{fail.refused(res_allocated.err)}; }
    ret res[*type_kind.TypeId, fail.Fail].ok{res_allocated.ok};
}

pub fun params_free(sc: *sema_context.SemaContext, params: *type_kind.TypeId, count: u32) {
    A.deallocate[type_kind.TypeId](sc.s.alloc, params, count::usize);
}
