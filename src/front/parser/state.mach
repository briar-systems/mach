# add a module node to the tree
# ---
# p:   the parser
# m:   the module node
# ret: its id, or MODULE_NODE_NIL when the parse has ended or the add ran out of memory, which ends it
pub fun push_module(p: *Parser, m: ast_module.Module) ast_id.ModuleNodeId {
    if (p.fatal) { ret ast_id.MODULE_NODE_NIL; }
    val res_add: res[ast_id.ModuleNodeId, fail.Fail] = ast.add_module(p.ast, m);
    if (sel res_add.err) {
        fatal_oom_at(p, m.span);
        ret ast_id.MODULE_NODE_NIL;
    }
    ret res_add.ok;
}

# a list gathered while its length is unknown, then flushed into its AST table in one run
pub fun list_init[T](p: *Parser) Vector[T] {
    ret collections_vector.init[T](p.ast.a);
}

# append to a gathered list, ending the parse when it runs out of memory
# ---
# [T]: the element type
# p:   the parser
# b:   the list
# x:   the element
pub fun list_push[T](p: *Parser, b: *Vector[T], x: T) {
    if (p.fatal) { ret; }
    val res_grown: res[usize, A.Error] = collections_vector.push[T](b, x);
    if (sel res_grown.err) { fatal_oom(p); }
}

# free a gathered list, ending the parse as an internal error when the free is refused
# ---
# [T]: the element type
# p:   the parser
# b:   the list
pub fun list_dnit[T](p: *Parser, b: *Vector[T]) {
    val err_freed: err[A.Error] = collections_vector.dnit[T](b);
    if (sel err_freed.err) { fatal_ice_at(p, current(p).span, base_alloc.text(err_freed.err)); }
}

# appends the gathered list to `table`, frees it, and answers where it starts in the
# table, with its length in `out_len`
pub fun list_flush[T](p: *Parser, b: *Vector[T], table: *Vector[T], out_len: *u32) u32 {
    val start: u32   = table.len::u32;
    var i:     usize = 0;
    for (i < b.len && !p.fatal) {
        val res_added: res[u32, fail.Fail] = ast.table_push[T](table, b.data[i]);
        if (sel res_added.err) { fatal_oom(p); }
        i = i + 1;
    }
    @out_len = (table.len::u32) - start;
    list_dnit[T](p, b);
    ret start;
}
