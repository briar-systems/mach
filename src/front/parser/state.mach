# the parser's state: its cursor over the tokens, the tree it builds and what it reports
#
# the grammar reads tokens and pushes nodes through it. it holds the nesting limit, the fatal
# failure that ends a parse, the rollback of a reading that lost, and the buffer that keeps what a
# walk deciding between the two readings of `name[` reports until its reading becomes the parse.

use collections_vector: std.collections.vector;
use std.collections.vector.Vector;
use std.text.string.str_dup_range;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_region_equals;

use A: std.allocator;
use T: std.allocator.testing;

use base_alloc: mach.base.alloc;
use mach.base.diagnostic;
use diagnostic_kind: mach.base.diagnostic.kind;
use mach.base.fail;
use mach.base.growth;
use mach.base.intern;
use base_source: mach.base.source;
use mach.base.stack;
use mach.front.ast;
use ast_decl:    mach.front.ast.decl;
use ast_expr:    mach.front.ast.expr;
use ast_id:      mach.front.ast.id;
use ast_module:  mach.front.ast.module;
use ast_stmt:    mach.front.ast.stmt;
use ast_type:    mach.front.ast.type;
use front_lexer: mach.front.lexer;
use mach.front.lexis;
use mach.front.token;
use report_phase: mach.report.phase;

pub def ParseFailKind: u8;

pub val PARSE_FAIL_OOM:   ParseFailKind = 0;
pub val PARSE_FAIL_ICE:   ParseFailKind = 1;
pub val PARSE_FAIL_DIAG:  ParseFailKind = 2;
pub val PARSE_FAIL_DEPTH: ParseFailKind = 3;

# why a parse ended without a tree
# ---
# kind:    PARSE_FAIL_OOM, PARSE_FAIL_ICE, PARSE_FAIL_DIAG or PARSE_FAIL_DEPTH
# message: what went wrong
pub rec ParseFail {
    kind:    ParseFailKind;
    message: str;
}

# names: the interner every name the tree holds an id of is interned in. it outlives the tree
#        and never takes a string back, so each id stays the name's for as long as the tree lives
pub rec Parser {
    tokens:        *front_lexer.TokenStream;
    pos:           usize;
    ast:           *ast.Ast;
    names:         *intern.Interner;
    diags:         *diagnostic.DiagnosticStore;
    status:        report_phase.PhaseStatus;
    panic:         bool;
    fatal:         bool;
    fatal_kind:    ParseFailKind;
    fatal_message: str;
    no_struct_lit: bool;
    depth:         usize;
    suppressed:    bool;
    probed:        *u8;
    probed_len:    usize;

    pending:     *PendingDiag;
    pending_len: usize;
    pending_cap: usize;
    buffering:   bool;
}

# what a deciding walk said. the walk that decides between the two readings of
# `name[` cannot speak as it goes: if its reading loses, nothing it said was
# ever true. it records here, and whichever reading becomes the parse says what
# it recorded, in order.
rec PendingDiag {
    kind:    diagnostic_kind.Kind;
    span:    base_source.Span;
    message: str;
}

# the deepest nesting the parser will descend into, a sanity limit. the stack
# is guarded by the margin check in descend (mach.base.stack), which refuses
# first wherever the stack runs short of this. it is not the semantic limit:
# the recursive-type checker refuses at 1024 (REACHES_MAX_DEPTH in
# front/sema/declared.mach) with a message that says what to do about it, so the
# parser must sit above that or sema never gets to speak. the compiler's own
# source and the standard library reach 14.
pub val MAX_NEST_DEPTH: usize = 2048;

# a parser at the first token, its status already rejected when the stream holds lex errors
# ---
# tokens: the lexed file, ending in an end of file token
# out:    the tree the parse pushes nodes into
# names:  the interner names are interned in, which outlives the tree
# diags:  the store syntax errors are reported to
# ret:    the parser, whose probed table the caller sets up with `probed_init` and releases with `probed_dnit`, and whose diagnostic buffer it releases with `diag_dnit`
pub fun init(tokens: *front_lexer.TokenStream, out: *ast.Ast, names: *intern.Interner, diags: *diagnostic.DiagnosticStore) Parser {
    var p: Parser;
    p.tokens = tokens;
    p.pos    = 0;
    p.ast    = out;
    p.names  = names;
    p.diags  = diags;
    p.status = report_phase.accepted();
    if (tokens.error_len > 0) { report_phase.reject(?p.status); }
    p.panic         = false;
    p.fatal         = false;
    p.fatal_kind    = PARSE_FAIL_OOM;
    p.fatal_message = nil;
    p.no_struct_lit = false;
    p.depth         = 0;
    p.suppressed    = false;
    p.probed        = nil;
    p.probed_len    = 0;
    p.pending       = nil;
    p.pending_len   = 0;
    p.pending_cap   = 0;
    p.buffering     = false;
    ret p;
}

# the token at the cursor
# ---
# p:   the parser
# ret: the current token
pub fun current(p: *Parser) token.Token {
    ret p.tokens.tokens[p.pos];
}

# the token `offset` places past the cursor, the end of file token when that is past the end
# ---
# p:      the parser
# offset: how far ahead to look, 0 for the current token
# ret:    the token there
pub fun peek(p: *Parser, offset: usize) token.Token {
    val idx: usize = p.pos + offset;
    if (idx >= p.tokens.len) {
        ret p.tokens.tokens[p.tokens.len - 1];
    }
    ret p.tokens.tokens[idx];
}

# step the cursor past the current token, never past the end of file token
# ---
# p:   the parser
# ret: the token stepped past
pub fun advance(p: *Parser) token.Token {
    val t: token.Token = p.tokens.tokens[p.pos];
    if (t.kind != token.KIND_EOF) {
        p.pos = p.pos + 1;
    }
    ret t;
}

# the id of the name `span` covers; a refused intern is fatal, and its name is STR_NIL
pub fun name_id(p: *Parser, span: base_source.Span) intern.StrId {
    val res_range_add: res[intern.StrId, A.Error] = intern.range_add(p.names, p.tokens.source, span.offset, span.len);
    if (sel res_range_add.err) {
        fatal_oom_at(p, span);
        ret intern.STR_NIL;
    }
    ret res_range_add.ok;
}

# whether the current token is of `kind`
# ---
# p:    the parser
# kind: the kind to test for
# ret:  true when it is
pub fun at(p: *Parser, kind: token.Kind) bool {
    ret current(p).kind == kind;
}

# whether the current token is the identifier spelled `kw`
# ---
# p:   the parser
# kw:  the reserved word to test for
# ret: true when it is
pub fun at_kw(p: *Parser, kw: str) bool {
    if (!at(p, token.KIND_IDENT)) { ret false; }
    val t: token.Token = current(p);
    ret str_region_equals(p.tokens.source, t.span.offset, t.span.len, kw);
}

# whether the cursor is at the end of file token
# ---
# p:   the parser
# ret: true at the end of input
pub fun at_eof(p: *Parser) bool {
    ret at(p, token.KIND_EOF);
}

# whether the current token can open a declaration: a decorator, a `$` or a declaration keyword
# ---
# p:   the parser
# ret: true when it can
pub fun at_decl_start(p: *Parser) bool {
    if (at(p, token.KIND_DECORATOR_OPEN)) { ret true; }
    if (at(p, token.KIND_DOLLAR))         { ret true; }
    if (!at(p, token.KIND_IDENT))         { ret false; }
    ret at_kw(p, lexis.KW_PUB) || at_kw(p, lexis.KW_EXT)
        || at_kw(p, lexis.KW_USE) || at_kw(p, lexis.KW_FWD) || at_kw(p, lexis.KW_FUN)
        || at_kw(p, lexis.KW_TAG) || at_kw(p, lexis.KW_REC) || at_kw(p, lexis.KW_UNI) || at_kw(p, lexis.KW_VAL)
        || at_kw(p, lexis.KW_VAR) || at_kw(p, lexis.KW_DEF) || at_kw(p, lexis.KW_TEST);
}

# step past the current token when it is of `kind`
# ---
# p:    the parser
# kind: the kind to take
# ret:  true when a token was taken
pub fun eat(p: *Parser, kind: token.Kind) bool {
    if (at(p, kind)) {
        advance(p);
        ret true;
    }
    ret false;
}

# step past the current token when it is the identifier spelled `kw`
# ---
# p:   the parser
# kw:  the reserved word to take
# ret: true when a token was taken
pub fun eat_kw(p: *Parser, kw: str) bool {
    if (at_kw(p, kw)) {
        advance(p);
        ret true;
    }
    ret false;
}

# take a token of `kind`, or report `message` at the current token as an expected token error
# ---
# p:       the parser
# kind:    the kind required
# message: the error text when it is missing
# ret:     true when the token was taken
pub fun expect(p: *Parser, kind: token.Kind, message: str) bool {
    if (eat(p, kind)) {
        ret true;
    }
    error_at_current(p, diagnostic_kind.SYNTAX_EXPECTED_TOKEN, message);
    ret false;
}

# the token just before the cursor
# ---
# p:   the parser, past at least one token
# ret: the previous token
pub fun previous(p: *Parser) token.Token {
    ret p.tokens.tokens[p.pos - 1];
}

# take a closing token of `kind` as `expect` does, for the end of a node's span
# ---
# p:       the parser
# kind:    the kind required
# message: the error text when it is missing
# ret:     the token taken, or the previous token when it is missing
pub fun expect_end(p: *Parser, kind: token.Kind, message: str) token.Token {
    val candidate: token.Token = current(p);
    if (expect(p, kind, message)) {
        ret candidate;
    }
    ret previous(p);
}

fun set_fatal(p: *Parser, k: diagnostic_kind.Kind, kind: ParseFailKind, span: base_source.Span, message: str) {
    set_fatal_detail(p, k, kind, span, message, message);
}

fun set_fatal_detail(p: *Parser, k: diagnostic_kind.Kind, kind: ParseFailKind, span: base_source.Span, message: str, detail: str) {
    if (p.fatal)                  { ret; }
    if (kind == PARSE_FAIL_DEPTH) { report_phase.reject(?p.status); }
    or                            { report_phase.internal(?p.status, fail.at(fail.message(message), base_source.location(p.tokens.file_id, span))); }
    p.fatal         = true;
    p.fatal_kind    = kind;
    p.fatal_message = message;

    # a fatal parse is discarded whole, so nothing below this point can be
    # published and there is nothing left to read. moving to the end of input
    # is what ends it: every loop above unwinds through its own end-of-input
    # check instead of walking the rest of the file a token at a time.
    p.pos   = p.tokens.len - 1;
    p.panic = true;

    val err_report: err[fail.Fail] = diagnostic.report(p.diags, k, p.tokens.file_id, span, detail);
    if (sel err_report.err) {
        report_phase.internal(?p.status, fail.at(err_report.err, base_source.location(p.tokens.file_id, span)));
        if (kind == PARSE_FAIL_DEPTH) {
            p.fatal_kind    = PARSE_FAIL_DIAG;
            p.fatal_message = fail.describe(err_report.err);
        }
    }
}

# the failure a parse failure stands for in the caller's terms
# ---
# f:   the parse failure
# ret: an already reported failure for a nesting limit, a failure carrying the message otherwise
pub fun failure(f: ParseFail) fail.Fail {
    if (f.kind == PARSE_FAIL_DEPTH) { ret fail.reported(); }
    ret fail.message(f.message);
}

fun error_at_span(p: *Parser, k: diagnostic_kind.Kind, span: base_source.Span, message: str) {
    if (p.fatal) { ret; }
    if (p.buffering) {
        pending_push(p, k, span, message);
        ret;
    }
    report_phase.reject(?p.status);
    val err_report: err[fail.Fail] = diagnostic.report(p.diags, k, p.tokens.file_id, span, message);
    if (sel err_report.err) {
        set_fatal(p, diagnostic_kind.COMPILER_INTERNAL, PARSE_FAIL_DIAG, span, fail.describe(err_report.err));
    }
}

fun pending_push(p: *Parser, k: diagnostic_kind.Kind, span: base_source.Span, message: str) {
    if (p.pending_len == p.pending_cap) {
        val err_reserve_usize: err[A.Error] = growth.reserve_usize[PendingDiag](p.ast.a, ?p.pending, ?p.pending_cap, p.pending_len + 1);
        if (sel err_reserve_usize.err) {
            p.buffering = false;
            fatal_oom_at(p, span);
            ret;
        }
    }
    p.pending[p.pending_len].kind    = k;
    p.pending[p.pending_len].span    = span;
    p.pending[p.pending_len].message = message;
    p.pending_len                    = p.pending_len + 1;
}

# a mark in the buffer of pending diagnostics, for `diag_discard` or `diag_flush`
# ---
# p:   the parser
# ret: how many diagnostics are pending
pub fun diag_mark(p: *Parser) usize {
    ret p.pending_len;
}

# drop every pending diagnostic recorded since the mark, because the reading that recorded them lost
# ---
# p: the parser
# m: a mark from `diag_mark`
pub fun diag_discard(p: *Parser, m: usize) {
    if (m <= p.pending_len) { p.pending_len = m; }
}

# the reading that recorded these is the parse, so they are real. inside an
# enclosing deciding walk they stay in the buffer, because that walk may yet
# lose and take them with it; at the top they go to the sink, in order.
pub fun diag_flush(p: *Parser, m: usize) {
    if (m > p.pending_len) { ret; }
    if (p.buffering)       { ret; }
    var i: usize = m;
    for (i < p.pending_len) {
        error_at_span(p, p.pending[i].kind, p.pending[i].span, p.pending[i].message);
        i = i + 1;
    }
    p.pending_len = m;
}

# free the buffer of pending diagnostics
# ---
# p:     the parser
# alloc: the allocator the buffer grew from, the tree's
pub fun diag_dnit(p: *Parser, alloc: *A.Allocator) {
    if (p.pending != nil && p.pending_cap > 0) {
        A.deallocate[PendingDiag](alloc, p.pending, p.pending_cap);
    }
    p.pending     = nil;
    p.pending_len = 0;
    p.pending_cap = 0;
}

# report a syntax error at the current token and enter panic, or only note it as suppressed while already in panic
# ---
# p:       the parser
# k:       the diagnostic kind
# message: the error text
pub fun error_at_current(p: *Parser, k: diagnostic_kind.Kind, message: str) {
    if (p.panic) {
        p.suppressed = true;
        ret;
    }
    p.panic = true;
    error_at_span(p, k, current(p).span, message);
}

# report as `error_at_current` does, and step past the offending token when the parser was not already in panic
# ---
# p:       the parser
# k:       the diagnostic kind
# message: the error text
pub fun error_recover_advance(p: *Parser, k: diagnostic_kind.Kind, message: str) {
    val was_panicking: bool = p.panic;
    error_at_current(p, k, message);
    if (!was_panicking) { advance(p); }
}

# report a syntax error at `span` and enter panic, or only note it as suppressed while already in panic
# ---
# p:       the parser
# k:       the diagnostic kind
# span:    where the error is reported
# message: the error text
pub fun error_at(p: *Parser, k: diagnostic_kind.Kind, span: base_source.Span, message: str) {
    if (p.panic) {
        p.suppressed = true;
        ret;
    }
    p.panic = true;
    error_at_span(p, k, span, message);
}

# an error at `span` whose text fills the one `{}` of `fmt` with the source
# text of `name`. it leaves panic alone, so the reading goes on where it
# stands. the text is released once the store holds its own copy, so it is
# never buffered: a caller reads outside every deciding walk
pub fun error_naming(p: *Parser, k: diagnostic_kind.Kind, span: base_source.Span, fmt: str, name: base_source.Span) {
    if (p.panic) {
        p.suppressed = true;
        ret;
    }
    if (p.buffering) {
        fatal_ice_at(p, span, "a named parse diagnostic was raised inside a deciding walk");
        ret;
    }
    val res_name: res[str, A.Error] = str_dup_range(p.ast.a, p.tokens.source, name.offset, name.len);
    if (sel res_name.err) {
        fatal_oom_at(p, span);
        ret;
    }
    val text: str = res_name.ok;
    fin { str_free(p.ast.a, text); }
    val res_format: res[str, fail.Fail] = diagnostic.format(p.ast.a, fmt, text);
    if (sel res_format.err) {
        set_fatal(p, diagnostic_kind.COMPILER_INTERNAL, PARSE_FAIL_OOM, span, fail.describe(res_format.err));
        ret;
    }
    val message: str = res_format.ok;
    fin { str_free(p.ast.a, message); }
    error_at_span(p, k, span, message);
}

# end the parse for running out of memory, reported at `span`
# ---
# p:    the parser
# span: where the failure is reported
pub fun fatal_oom_at(p: *Parser, span: base_source.Span) {
    set_fatal(p, diagnostic_kind.COMPILER_INTERNAL, PARSE_FAIL_OOM, span, "out of memory while parsing");
}

fun fatal_oom(p: *Parser) {
    fatal_oom_at(p, current(p).span);
}

# end the parse for an internal compiler error, reported at `span`
# ---
# p:       the parser
# span:    where the failure is reported
# message: what went wrong
pub fun fatal_ice_at(p: *Parser, span: base_source.Span, message: str) {
    set_fatal(p, diagnostic_kind.COMPILER_INTERNAL, PARSE_FAIL_ICE, span, message);
}

# a token position where the index reading of `name[` has already been tried
# and did not parse. the verdict is about tokens alone, so it survives any
# rollback, and without it a malformed chain re-derives the same failure at
# every level and doubles with depth.
pub fun probed_init(p: *Parser, alloc: *A.Allocator) {
    p.probed     = nil;
    p.probed_len = 0;
    if (p.tokens == nil || p.tokens.len == 0) { ret; }
    val res_allocate: res[*u8, A.Error] = A.allocate[u8](alloc, p.tokens.len);
    if (sel res_allocate.err) {
        fatal_oom_at(p, current(p).span);
        ret;
    }
    p.probed     = res_allocate.ok;
    p.probed_len = p.tokens.len;
    var i: usize = 0;
    for (i < p.probed_len) {
        p.probed[i] = 0;
        i           = i + 1;
    }
}

# free the table of positions where the index reading failed
# ---
# p:     the parser
# alloc: the allocator `probed_init` took it from
pub fun probed_dnit(p: *Parser, alloc: *A.Allocator) {
    if (p.probed != nil && p.probed_len > 0) { A.deallocate[u8](alloc, p.probed, p.probed_len); }
    p.probed     = nil;
    p.probed_len = 0;
}

# whether the index reading of `name[` already failed at a token position
# ---
# p:   the parser
# at:  the token position of the `[`
# ret: true when it was recorded as failed
pub fun index_reading_failed_here(p: *Parser, at: usize) bool {
    if (p.probed == nil || at >= p.probed_len) { ret false; }
    ret p.probed[at] != 0;
}

# record that the index reading of `name[` failed at a token position
# ---
# p:  the parser
# at: the token position of the `[`
pub fun record_index_reading_failed(p: *Parser, at: usize) {
    if (p.probed == nil || at >= p.probed_len) { ret; }
    p.probed[at] = 1;
}

# enter one more level of nesting, ending the parse when it passes MAX_NEST_DEPTH or the stack runs short
# ---
# p:   the parser
# ret: true when the level was entered, which the caller leaves with `ascend`
pub fun descend(p: *Parser) bool {
    if (p.depth >= MAX_NEST_DEPTH) {
        fatal_depth(p);
        ret false;
    }
    if (stack.exhausted()) {
        fatal_stack(p);
        ret false;
    }
    p.depth = p.depth + 1;
    ret true;
}

# leave a level of nesting `descend` entered
# ---
# p: the parser
pub fun ascend(p: *Parser) {
    if (p.depth > 0) { p.depth = p.depth - 1; }
}

fun fatal_depth(p: *Parser) {
    val res_format: res[str, fail.Fail] = diagnostic.format(p.ast.a,
        "input nests deeper than the parser's limit of {} levels",
        MAX_NEST_DEPTH);
    if (sel res_format.err) {
        set_fatal(p, diagnostic_kind.COMPILER_INTERNAL, PARSE_FAIL_OOM, current(p).span, fail.describe(res_format.err));
        ret;
    }
    val detail: str = res_format.ok;
    fin { str_free(p.ast.a, detail); }
    set_fatal_detail(p, diagnostic_kind.SYNTAX_NESTING_DEPTH, PARSE_FAIL_DEPTH, current(p).span,
        "input nests deeper than this parser descends", detail);
}

fun fatal_stack(p: *Parser) {
    set_fatal_detail(p, diagnostic_kind.SYNTAX_NESTING_DEPTH, PARSE_FAIL_DEPTH, current(p).span,
        "input nests deeper than this parser descends",
        "input nests too deeply for the parser");
}

# a mark in the tree, for rolling back a reading that loses
# ---
# p:   the parser
# ret: the tree's current mark
pub fun ast_mark(p: *Parser) ast.AstMark {
    ret ast.mark(p.ast);
}

# drop every node pushed since the mark, ending the parse as an internal error when the mark is invalid
# ---
# p: the parser
# m: a mark from `ast_mark`
pub fun ast_rollback(p: *Parser, m: ast.AstMark) {
    if (!ast.rollback(p.ast, m)) {
        fatal_ice_at(p, current(p).span, "parser AST rollback mark is invalid");
    }
}

# skip tokens up to one of the three kinds or the end of input, and leave panic
# ---
# p:  the parser
# k0: a kind to stop at
# k1: a kind to stop at
# k2: a kind to stop at
pub fun sync_to(p: *Parser, k0: token.Kind, k1: token.Kind, k2: token.Kind) {
    if (p.fatal) { ret; }
    for (!at(p, token.KIND_EOF)) {
        val k: token.Kind = current(p).kind;
        if (k == k0 || k == k1 || k == k2) {
            p.panic = false;
            ret;
        }
        advance(p);
    }
    p.panic = false;
}

# skip tokens up to one of the three kinds outside any bracket opened on the way, or the end of input, and leave panic
# ---
# p:  the parser
# k0: a kind to stop at
# k1: a kind to stop at
# k2: a kind to stop at
pub fun sync_to_body(p: *Parser, k0: token.Kind, k1: token.Kind, k2: token.Kind) {
    if (p.fatal) { ret; }
    var depth: usize = 0;
    for (!at(p, token.KIND_EOF)) {
        val k: token.Kind = current(p).kind;
        if (depth == 0 && (k == k0 || k == k1 || k == k2)) {
            p.panic = false;
            ret;
        }
        if (k == token.KIND_LBRACE || k == token.KIND_LPAREN || k == token.KIND_LBRACKET) {
            depth = depth + 1;
        }
        or (depth > 0 && (k == token.KIND_RBRACE || k == token.KIND_RPAREN || k == token.KIND_RBRACKET)) {
            depth = depth - 1;
        }
        advance(p);
    }
    p.panic = false;
}

# skip at least one token, then up to the next token that can open a declaration or the end of input, and leave panic
# ---
# p: the parser
pub fun sync_to_decl(p: *Parser) {
    if (p.fatal)           { ret; }
    if (!at_decl_start(p)) { advance(p); }
    for (!at(p, token.KIND_EOF) && !at_decl_start(p)) {
        advance(p);
    }
    p.panic = false;
}

# the span from the start of one span to the end of another
# ---
# start: the first span
# end:   the last span, at or after `start`
# ret:   the span covering both
pub fun span_of(start: base_source.Span, end: base_source.Span) base_source.Span {
    var s: base_source.Span;
    s.offset = start.offset;
    s.len    = (end.offset + end.len) - start.offset;
    ret s;
}

# add an expression to the tree
# ---
# p:   the parser
# e:   the expression
# ret: its id, or EXPR_NIL when the parse has ended or the add ran out of memory, which ends it
pub fun push_expr(p: *Parser, e: ast_expr.Expr) ast_id.ExprId {
    if (p.fatal) { ret ast_id.EXPR_NIL; }
    val res_add: res[ast_id.ExprId, fail.Fail] = ast.add_expr(p.ast, e);
    if (sel res_add.err) {
        fatal_oom_at(p, e.span);
        ret ast_id.EXPR_NIL;
    }
    ret res_add.ok;
}

# add a statement to the tree
# ---
# p:   the parser
# s:   the statement
# ret: its id, or STMT_NIL when the parse has ended or the add ran out of memory, which ends it
pub fun push_stmt(p: *Parser, s: ast_stmt.Stmt) ast_id.StmtId {
    if (p.fatal) { ret ast_id.STMT_NIL; }
    val res_add: res[ast_id.StmtId, fail.Fail] = ast.add_stmt(p.ast, s);
    if (sel res_add.err) {
        fatal_oom_at(p, s.span);
        ret ast_id.STMT_NIL;
    }
    ret res_add.ok;
}

# add a declaration to the tree
# ---
# p:   the parser
# d:   the declaration
# ret: its id, or DECL_NIL when the parse has ended or the add ran out of memory, which ends it
pub fun push_decl(p: *Parser, d: ast_decl.Decl) ast_id.DeclId {
    if (p.fatal) { ret ast_id.DECL_NIL; }
    val res_add: res[ast_id.DeclId, fail.Fail] = ast.add_decl(p.ast, d);
    if (sel res_add.err) {
        fatal_oom_at(p, d.span);
        ret ast_id.DECL_NIL;
