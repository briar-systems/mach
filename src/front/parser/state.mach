    ret res_add.ok;
}

# add a type to the tree
# ---
# p:   the parser
# t:   the type
# ret: its id, or TYPE_NIL when the parse has ended or the add ran out of memory, which ends it
pub fun push_type(p: *Parser, t: ast_type.Type) ast_id.TypeId {
    if (p.fatal) { ret ast_id.TYPE_NIL; }
    val res_add: res[ast_id.TypeId, fail.Fail] = ast.add_type(p.ast, t);
    if (sel res_add.err) {
