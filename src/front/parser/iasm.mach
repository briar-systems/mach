# the parse of an inline `asm` statement
#
# the head after `asm` is masc's selection and the body is masc's syntax, so the lexer hands
# each on as one raw token and both are kept as spans of the source. the lexer reported a
# body it could not read or close, so a body no `}` follows is reported nowhere here

use std.types.bool.bool;
use std.types.size.usize;

use diagnostic_kind: mach.base.diagnostic.kind;
use base_source:     mach.base.source;
use ast_id:          mach.front.ast.id;
use ast_stmt:        mach.front.ast.stmt;
use mach.front.parser.state;
use mach.front.token;

# parse an `asm` statement, keeping its head and body as source spans
# ---
# p:        the parser, at the `asm` keyword
# noreturn: a `#[noreturn]` marks it
# ret:      the statement, or STMT_NIL when the parse has ended
pub fun parse_asm(p: *state.Parser, noreturn: bool) ast_id.StmtId {
    val start: token.Token = state.advance(p);

    var head:     base_source.Span;
    var body:     base_source.Span;
    var end_span: base_source.Span = start.span;

    if (!state.at(p, token.KIND_ASM_HEAD)) {
        state.error_at_current(p, diagnostic_kind.ASM_ISA_MISSING, "expected a selection of masc's after 'asm', as `asm x86-64 { ... }`");
        if (state.at(p, token.KIND_LBRACE)) { end_span = skip_block(p); }
    }
    or {
        head     = state.advance(p).span;
        end_span = head;
        if (state.peek(p, 1).kind != token.KIND_ASM_BODY) {
            state.error_at_current(p, diagnostic_kind.SYNTAX_EXPECTED_TOKEN, "expected '{' on the head's line to open inline assembly body");
        }
        or {
            state.advance(p);
            body     = state.advance(p).span;
            end_span = body;
            if (state.at(p, token.KIND_RBRACE)) { end_span = state.advance(p).span; }
        }
    }

    var asm_stmt: ast_stmt.StmtAsm;
    asm_stmt.head     = head;
    asm_stmt.body     = body;
    asm_stmt.noreturn = noreturn;

    var node: ast_stmt.Stmt;
    node.span      = state.span_of(start.span, end_span);
    node.kind      = ast_stmt.STMT_KIND_ASM;
    node.data.asm_ = asm_stmt;
    ret state.push_stmt(p, node);
}

# past a brace-balanced run of tokens that a headless `asm` opens, to the span of its last token
fun skip_block(p: *state.Parser) base_source.Span {
    var depth: usize            = 0;
    var last:  base_source.Span = state.advance(p).span;
    for (!state.at_eof(p)) {
        if (state.at(p, token.KIND_RBRACE) && depth == 0) {
            ret state.advance(p).span;
        }
        if (state.at(p, token.KIND_LBRACE)) { depth = depth + 1; }
        or (state.at(p, token.KIND_RBRACE)) { depth = depth - 1; }
        last = state.advance(p).span;
    }
    ret last;
}
