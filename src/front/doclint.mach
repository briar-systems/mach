use mach.base.fail;
use std.memory;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_region_equals;

use A: std.allocator;

use mach.base.diagnostic;
use diagnostic_kind: mach.base.diagnostic.kind;
use base_source:     mach.base.source;
use mach.front.ast;
use ast_decl:  mach.front.ast.decl;
use ast_id:    mach.front.ast.id;
use front_doc: mach.front.doc;

def ItemKind: u8;
val ITEM_GENERIC:  ItemKind = 0;
val ITEM_COMPTIME: ItemKind = 1;
val ITEM_PLAIN:    ItemKind = 2;
val ITEM_RET:      ItemKind = 3;

val MSG_UNKNOWN: str = "documented component matches no parameter, field, generic, or `ret` of this declaration";
val MSG_NO_DESC: str = "documented component has no description";
val MSG_ORDER:   str = "documented components are out of declaration order";

rec Item {
    kind:     ItemKind;
    name_off: usize;
    name_len: usize;
}

pub fun lint_module(a: *ast.Ast, source: str, diags: *diagnostic.DiagnosticStore) err[fail.Fail] {
    var i: usize = 0;
    for (i < a.decls.len) {
        val err_lint_decl: err[fail.Fail] = lint_decl(a, ?a.decls.data[i], source, diags);
        if (sel err_lint_decl.err) { ret err_lint_decl; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun lint_decl(a: *ast.Ast, d: *ast_decl.Decl, source: str, diags: *diagnostic.DiagnosticStore) err[fail.Fail] {
    if ((d.flags & ast_decl.DECL_FLAG_PUB) == 0)       { ret err[fail.Fail].ok{}; }
    if (d.doc.len == 0)                                { ret err[fail.Fail].ok{}; }
    if (!is_documentable(d.kind))                      { ret err[fail.Fail].ok{}; }
    if (!front_doc.has_component_block(source, d.doc)) { ret err[fail.Fail].ok{}; }
    ret check_components(a, d, source, diags);
}

fun is_documentable(kind: ast_decl.DeclKind) bool {
    ret kind == ast_decl.DECL_KIND_FUN
        || kind == ast_decl.DECL_KIND_REC
        || kind == ast_decl.DECL_KIND_UNI
        || kind == ast_decl.DECL_KIND_TAG;
}

fun item_count(d: *ast_decl.Decl) usize {
    if (d.kind == ast_decl.DECL_KIND_FUN) {
        val f: *ast_decl.DeclFun = ?d.data.fun_;
        var n: usize             = f.generics_len::usize + f.params_len::usize;
        if (!ast_id.type_is_nil(f.return_type)) { n = n + 1; }
        ret n;
    }
    if (d.kind == ast_decl.DECL_KIND_REC) {
        val r: *ast_decl.DeclRec = ?d.data.rec_;
        ret r.generics_len::usize + r.fields_len::usize;
    }
    if (d.kind == ast_decl.DECL_KIND_UNI) {
        val u: *ast_decl.DeclUni = ?d.data.uni_;
        ret u.generics_len::usize + u.fields_len::usize;
    }
    if (d.kind == ast_decl.DECL_KIND_TAG) {
        val t: *ast_decl.DeclTag = ?d.data.tag_;
        ret t.generics_len::usize + t.cases_len::usize;
    }
    ret 0;
}

fun check_components(a: *ast.Ast, d: *ast_decl.Decl, source: str, diags: *diagnostic.DiagnosticStore) err[fail.Fail] {
    val count: usize = item_count(d);

    var items: *Item = nil;
    if (count > 0) {
        val res_items: res[*Item, A.Error] = A.allocate[Item](a.a, count);
        if (sel res_items.err) { ret err[fail.Fail].err{fail.refused(res_items.err)}; }
        items = res_items.ok;
        fill_items(a, d, items);
    }

    fin {
        if (items != nil) { A.deallocate[Item](a.a, items, count); }
    }

    var iter:      front_doc.DocComponentIter = front_doc.component_iter(source, d.doc);
    var component: front_doc.DocComponent;
    var prev:      usize                      = 0;
    var have_prev: bool                       = false;

    for (front_doc.component_next(?iter, ?component)) {
        val idx: usize = match_item(source, items, count, component.name_span);
        if (idx == count) {
            val err_warn: err[fail.Fail] = warn(diags, a.file_id, component.name_span, MSG_UNKNOWN);
            if (sel err_warn.err) { ret err_warn; }
            cnt;
        }
        if (component.desc_span.len == 0) {
            val err_warn: err[fail.Fail] = warn(diags, a.file_id, component.name_span, MSG_NO_DESC);
            if (sel err_warn.err) { ret err_warn; }
        }
        if (have_prev && idx < prev) {
            val err_warn: err[fail.Fail] = warn(diags, a.file_id, component.name_span, MSG_ORDER);
            if (sel err_warn.err) { ret err_warn; }
        }
        prev      = idx;
        have_prev = true;
    }

    ret err[fail.Fail].ok{};
}

fun fill_items(a: *ast.Ast, d: *ast_decl.Decl, out: *Item) {
    var n: usize = 0;

    if (d.kind == ast_decl.DECL_KIND_FUN) {
        val f: *ast_decl.DeclFun = ?d.data.fun_;
        n = put_generics(a, f.generics_start, f.generics_len, out, n);
        n = put_typed_names(a, f.params_start, f.params_len, out, n);
        if (!ast_id.type_is_nil(f.return_type)) {
            out[n].kind     = ITEM_RET;
            out[n].name_off = 0;
            out[n].name_len = 0;
            n               = n + 1;
        }
        ret;
    }
    if (d.kind == ast_decl.DECL_KIND_REC) {
        val r: *ast_decl.DeclRec = ?d.data.rec_;
        n = put_generics(a, r.generics_start, r.generics_len, out, n);
        n = put_typed_names(a, r.fields_start, r.fields_len, out, n);
        ret;
    }
    if (d.kind == ast_decl.DECL_KIND_UNI) {
        val u: *ast_decl.DeclUni = ?d.data.uni_;
        n = put_generics(a, u.generics_start, u.generics_len, out, n);
        n = put_typed_names(a, u.fields_start, u.fields_len, out, n);
        ret;
    }
    if (d.kind == ast_decl.DECL_KIND_TAG) {
        val t: *ast_decl.DeclTag = ?d.data.tag_;
        n = put_generics(a, t.generics_start, t.generics_len, out, n);
        n = put_tag_cases(a, t.cases_start, t.cases_len, out, n);
        ret;
    }
}

fun put_tag_cases(a: *ast.Ast, start: u32, len: u32, out: *Item, n: usize) usize {
    var i:   u32   = 0;
    var cur: usize = n;
    for (i < len) {
        val c: *ast_decl.TagCase = ?a.tag_cases.data[start + i];
        out[cur].kind     = ITEM_PLAIN;
        out[cur].name_off = c.name.offset;
        out[cur].name_len = c.name.len;
        cur               = cur + 1;
        i                 = i + 1;
    }
    ret cur;
}

fun put_generics(a: *ast.Ast, start: u32, len: u32, out: *Item, n: usize) usize {
    var i:   u32   = 0;
    var cur: usize = n;
    for (i < len) {
        val sp: base_source.Span = a.generic_names.data[start + i];
        out[cur].kind     = ITEM_GENERIC;
        out[cur].name_off = sp.offset;
        out[cur].name_len = sp.len;
        cur               = cur + 1;
        i                 = i + 1;
    }
    ret cur;
}

fun put_typed_names(a: *ast.Ast, start: u32, len: u32, out: *Item, n: usize) usize {
    var i:   u32   = 0;
    var cur: usize = n;
    for (i < len) {
        val tn: *ast_decl.TypedName = ?a.typed_names.data[start + i];
        if (tn.comptime) {
            out[cur].kind = ITEM_COMPTIME;
        }
        or {
            out[cur].kind = ITEM_PLAIN;
        }
        out[cur].name_off = tn.name.offset;
        out[cur].name_len = tn.name.len;
        cur               = cur + 1;
        i                 = i + 1;
    }
    ret cur;
}

fun match_item(source: str, items: *Item, count: usize, name: base_source.Span) usize {
    var i: usize = 0;
    for (i < count) {
        if (item_name_eq(source, ?items[i], name)) { ret i; }
        i = i + 1;
    }
    ret count;
}

fun item_name_eq(source: str, it: *Item, name: base_source.Span) bool {
    if (it.kind == ITEM_RET) {
        ret str_region_equals(source, name.offset, name.len, "ret");
    }
    if (it.kind == ITEM_GENERIC) {
        if (name.len != it.name_len + 2)               { ret false; }
        if (source[name.offset] != '[')                { ret false; }
        if (source[name.offset + name.len - 1] != ']') { ret false; }
        ret bytes_eq(source, name.offset + 1, it.name_off, it.name_len);
    }
    if (it.kind == ITEM_COMPTIME) {
        if (name.len != it.name_len + 1) { ret false; }
        if (source[name.offset] != '$')  { ret false; }
        ret bytes_eq(source, name.offset + 1, it.name_off, it.name_len);
    }
    if (name.len != it.name_len) { ret false; }
    ret bytes_eq(source, name.offset, it.name_off, it.name_len);
}

fun bytes_eq(source: str, a_off: usize, b_off: usize, len: usize) bool {
    ret memory.raw_equal(?source[a_off], ?source[b_off], len);
}

fun warn(diags: *diagnostic.DiagnosticStore, file_id: base_source.FileId, span: base_source.Span, message: str) err[fail.Fail] {
    val err_report: err[fail.Fail] = diagnostic.report(diags, diagnostic_kind.DOC_LINT, file_id, span, message);
    if (sel err_report.err) { ret err_report; }
    ret err[fail.Fail].ok{};
}
