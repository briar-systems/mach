# the parser's entry: one token stream parsed into a syntax tree, then its docstrings
# linted, the tree handed back only when the parse completed
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;

use std.types.error.err;
use std.types.result.res;

use mach.base.diagnostic;
use mach.base.fail;
use mach.base.intern;
use mach.front.ast;
use mach.front.doclint;
use front_lexer: mach.front.lexer;
use mach.front.parser.grammar;
use mach.front.parser.state;
use report_phase: mach.report.phase;

# the names the tree holds are interned in `names`, which must outlive it
pub fun parse(tokens: *front_lexer.TokenStream, out: *ast.Ast, names: *intern.Interner, diags: *diagnostic.DiagnosticStore) res[report_phase.PhaseStatus, state.ParseFail] {
    var txn: ast.Ast      = @out;
    var p:   state.Parser = state.init(tokens, ?txn, names, diags);

    var handed: bool = false;
    fin {
        if (!handed) { ast.dnit(?txn); }
    }
    state.probed_init(?p, txn.a);
    grammar.parse_module(?p);
    state.probed_dnit(?p, txn.a);
    state.diag_dnit(?p, txn.a);

    if (p.fatal) {
        var f: state.ParseFail;
        f.kind    = p.fatal_kind;
        f.message = p.fatal_message;
        ret res[report_phase.PhaseStatus, state.ParseFail].err{f};
    }

    val err_lint: err[fail.Fail] = doclint.lint_module(?txn, tokens.source, diags);
    if (sel err_lint.err) {
        var f: state.ParseFail;
        f.kind    = state.PARSE_FAIL_DIAG;
        f.message = fail.describe(err_lint.err);
        ret res[report_phase.PhaseStatus, state.ParseFail].err{f};
    }
    @out   = txn;
    handed = true;
    ret res[report_phase.PhaseStatus, state.ParseFail].ok{p.status};
}
