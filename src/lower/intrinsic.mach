# an `#[intrinsic]` declaration of the selected target held to the row its calls become
#
# a declaration is held to its row where it is declared, whether or not anything calls it:
# its parameter count, the result it must or must not return, a constant or literal operand
# taken as an integer, an image, sampler or sampled image operand taken as a handle, a pointer
# an instruction reads or writes through taken as a pointer, and a handle returned only where
# the row's result is one. on spir-v the row's typing in masc (`masc.isa.spirv.typing`) holds
# each slot further: the number its type is a scalar or vector of, its shape and widths, how
# it relates to another slot's type, a pointer slot's being the type it points to, the
# members of a record it is, and the types a typed row's data operand or result may be. a row
# masc states no typing of is held to its operand kinds alone, and its types are the author's
# to get right. each break is refused with `op.signature`, naming the parameter. a call holds
# what depends on its arguments: an instruction the catalog does not hold or holds as no
# `intrinsic`, the constants an index chain reads, and in mirl the constants, enumerant
# values, image operands, storage classes and capabilities of the call
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.string.str;
use std.types.string.str_equals;

use std.types.string.str_len;
use std.types.view.View;

use mach.base.diagnostic;
use diagnostic_kind: mach.base.diagnostic.kind;
use mach.base.fail;
use mach.base.intern;
use base_source:    mach.base.source;
use sema_interface: mach.front.sema.interface;
use mach.front.sema.typename;
use mach.lower.builder;
use lower_context: mach.lower.context;
use lower_shader:  mach.lower.shader;
use op_written:    mach.lower.written;
use mach.type;
use type_field:   mach.type.field;
use type_kind:    mach.type.kind;
use type_prim:    mach.type.prim;
use masc_effect:  masc.core.effect;
use masc_operand: masc.core.operand;
use masc_row:     masc.core.row;
use masc.isa.spirv.gen_typing;
use spirv_kind: masc.isa.spirv.kind;
use masc.isa.spirv.typing;
use mirl_types:      mirl.ir.type.table;
use mirl_capability: mirl.target.capability;

# the declaration a call reads, its parameters and result by type
# ---
# params: the first parameter's index in the type table's parameter pool
# count:  how many parameters
# result: the result's type, nil for none
rec Declared {
    params: u32;
    count:  u32;
    result: type_kind.TypeId;
}

# the instruction an `#[intrinsic]` names in the selected target's catalog
# ---
# set:  its set
# row:  its row
# lead: the row operands its result, result type or set's import take
pub rec Found {
    set:  *mirl_capability.OpSet;
    row:  *masc_row.Row;
    lead: u32;
}

# what the selected target's catalog holds of the instruction an `#[intrinsic]` names
# ---
# no_catalog: the catalog holds no instruction set
# no_set:     it holds no set of the name
# refused:    the set holds the instruction, but no `intrinsic` may name it, for the reason given
# no_row:     the set holds no instruction of the name
# found:      the instruction
pub tag Named: u8 {
    no_catalog;
    no_set;
    refused: op_written.Refusal;
    no_row;
    found: Found;
}

# what the selected target's catalog holds of instruction `name` of set `set`
pub fun named(ctx: *lower_context.LowerContext, set: str, name: str) Named {
    val held: mirl_capability.Ops = ctx.machine.target.caps.ops;
    if (!(sel held.catalog)) { ret Named.no_catalog{}; }
    val c:        *mirl_capability.Catalog    = held.catalog;
    val set_view: View                        = View{data: set, len: str_len(set)};
    val op_view:  View                        = View{data: name, len: str_len(name)};
    val opt_set:  opt[*mirl_capability.OpSet] = mirl_capability.op_set(c, set_view);
    if (sel opt_set.none) { ret Named.no_set{}; }
    val opt_refused: opt[op_written.Refusal] = op_written.refused(opt_set.some, set_view, op_view);
    if (sel opt_refused.some) { ret Named.refused{opt_refused.some}; }
    val opt_row: opt[*masc_row.Row] = mirl_capability.op_row(c, opt_set.some, op_view);
    if (sel opt_row.none) { ret Named.no_row{}; }
    ret Named.found{Found{set: opt_set.some, row: opt_row.some, lead: mirl_capability.supplies(opt_set.some, opt_row.some)}};
}

# the `#[intrinsic]` declaration `op` of the selected target, of function type `fn`, held to
# its row where it is declared, at `span`. one whose instruction the catalog does not hold, or
# holds as no `intrinsic`, is refused at each call instead, where the program uses it
pub fun declared(ctx: *lower_context.LowerContext, span: base_source.Span, op: *sema_interface.Declaration, fn: type_kind.TypeId) err[fail.Fail] {
    val name:  str   = intern.text(?ctx.s.interner, op.op_name);
    val named: Named = named(ctx, intern.text(?ctx.s.interner, op.op_set), name);
    if (!(sel named.found)) { ret err[fail.Fail].ok{}; }
    val found:  Found           = named.found;
    val opt_fn: opt[*type.Type] = type.get(?ctx.s.types, type.strip_secret(?ctx.s.types, fn));
    if (sel opt_fn.none)                        { ret err[fail.Fail].ok{}; }
    if (opt_fn.some.kind != type_kind.TYPE_FUN) { ret err[fail.Fail].ok{}; }
    val d:       Declared      = Declared{params: opt_fn.some.data.fn.params_start, count: opt_fn.some.data.fn.params_len, result: opt_fn.some.data.fn.ret_type};
    val r:       *masc_row.Row = found.row;
    val lead:    u32           = found.lead;
    val counted: OpCount       = op_count(r, lead);
    if (d.count < counted.least || (counted.bounded && d.count > counted.most)) { ret count_refused(ctx, span, name, d.count, counted); }
    ret check(ctx, span, name, r, lead, ?d);
}

# a call of row `r`, named `name` at `span`, refused where masc's typing states that no
# environment admits the row, as GLSL.std.450 removed IMix. a declaration of it builds
pub fun withdrawn(ctx: *lower_context.LowerContext, span: base_source.Span, name: str, r: *masc_row.Row) err[fail.Fail] {
    if (!lower_shader.attaching(ctx)) { ret err[fail.Fail].ok{}; }
    val opt_typing: opt[*typing.Typing] = typing.of(?gen_typing.TYPINGS[0], gen_typing.COUNT, r.index);
    if (sel opt_typing.none)              { ret err[fail.Fail].ok{}; }
    if (opt_typing.some.withdrawn == nil) { ret err[fail.Fail].ok{}; }
    val res_text: res[str, fail.Fail] = diagnostic.format(ctx.s.alloc, "`{}` is in its set's grammar, but no environment allows it ({}). write what it computes with the instructions that remain", name, opt_typing.some.withdrawn);
    if (sel res_text.err) { ret err[fail.Fail].err{res_text.err}; }
    ret err[fail.Fail].err{lower_context.report_gate(ctx, diagnostic_kind.OP_UNKNOWN, span, res_text.ok)};
}

# the parameters a declaration of a row may take: the operands it must pass, and the most it
# may where no variadic operand and no operand whose value brings operands leaves that open
# ---
# least:   the operands the row requires
# most:    every operand it has, required and optional
# bounded: whether `most` bounds a declaration
rec OpCount {
    least:   u32;
    most:    u32;
    bounded: bool;
}

# the parameters a declaration of the row `r` may take, past the `lead` operands its result
# and result type, or its set's import, take
fun op_count(r: *masc_row.Row, lead: u32) OpCount {
    var out: OpCount = OpCount{least: 0, most: 0, bounded: true};
    var j:   u32     = lead;
    for (j < r.operands.len) {
        val x: *masc_operand.Operand = ?r.operands.at[j];
        if (x.quantity == masc_operand.VARIADIC) { out.bounded = false; }
        or {
            out.most = out.most + 1;
            if (x.quantity == masc_operand.ONE) { out.least = out.least + 1; }
            if (sel x.shape.enumerant) {
                if (brings(x.shape.enumerant)) { out.bounded = false; }
            }
        }
        j = j + 1;
    }
    ret out;
}

# whether a value of an enumeration brings operands after it
fun brings(en: masc_operand.Enumeration) bool {
    var i: u32 = 0;
    for (i < en.count) {
        if (en.members[i].params.len > 0) { ret true; }
        i = i + 1;
    }
    ret false;
}

# a declaration whose parameters its row's operand count does not admit
fun count_refused(ctx: *lower_context.LowerContext, span: base_source.Span, name: str, count: u32, counted: OpCount) err[fail.Fail] {
    var said: str = "`{}` takes at least {} operands after its result, but its declaration takes {} parameters. declare one parameter per operand, in the instruction's order";
    var n:    u32 = counted.least;
    if (count > counted.least) {
        said = "`{}` takes at most {} operands after its result, but its declaration takes {} parameters. declare one parameter per operand, in the instruction's order";
        n    = counted.most;
    }
    val res_text: res[str, fail.Fail] = diagnostic.format(ctx.s.alloc, said, name, n, count);
    if (sel res_text.err) { ret err[fail.Fail].err{res_text.err}; }
    ret err[fail.Fail].err{lower_context.report_gate(ctx, diagnostic_kind.OP_OPERAND_COUNT, span, res_text.ok)};
}

# what declaration `d` must be against its row `r`, refused with `op.signature`
# ---
# span: the declaration
# name: the instruction, as the declaration names it
# r:    its row
# lead: the row operands its result, result type or set's import take
# d:    the declaration
fun check(ctx: *lower_context.LowerContext, span: base_source.Span, name: str, r: *masc_row.Row, lead: u32, d: *Declared) err[fail.Fail] {
    val defines: u32 = r.effect.values.defines::u32;
    if (defines != 0 && type_kind.is_nil(d.result)) {
        ret refused(ctx, span, diagnostic.format(ctx.s.alloc, "`{}` has a result, so its declaration must return the result's type", name));
    }
    if (defines == 0 && !type_kind.is_nil(d.result)) {
        ret refused(ctx, span, diagnostic.format(ctx.s.alloc, "`{}` has no result, so its declaration must not have a return type", name));
    }
    if (defines != 0 && is_handle(ctx, d.result) && handle_kind(r, defines - 1) == masc_operand.NO_HANDLE) {
        ret refused(ctx, span, diagnostic.format(ctx.s.alloc, "`{}` makes no handle, because no operand derives its result, so its declaration must return the result's value type", name));
    }
    var i: u32 = 0;
    for (i < d.count) {
        val j: opt[u32] = operand_of(r, lead + i);
        if (sel j.some) {
            val err_kind: err[fail.Fail] = kind(ctx, span, name, r, j.some, i, param(ctx, d, i));
            if (sel err_kind.err) { ret err_kind; }
        }
        i = i + 1;
    }
    if (!lower_shader.attaching(ctx)) { ret err[fail.Fail].ok{}; }
    val opt_typing: opt[*typing.Typing] = typing.of(?gen_typing.TYPINGS[0], gen_typing.COUNT, r.index);
    if (sel opt_typing.none) { ret err[fail.Fail].ok{}; }
    val t: *typing.Typing = opt_typing.some;
    var k: u32            = 0;
    for (k < t.count) {
        val f:        *typing.Form   = ?t.forms[k];
        val err_form: err[fail.Fail] = form(ctx, span, name, r, d, lead, f, Place{slot: f.slot, member: WHOLE}, slot_type(ctx, d, lead, f.slot));
        if (sel err_form.err) { ret err_form; }
        k = k + 1;
    }
    k = 0;
    for (k < t.membered) {
        val err_member: err[fail.Fail] = member(ctx, span, name, r, d, lead, t, ?t.members[k]);
        if (sel err_member.err) { ret err_member; }
        k = k + 1;
    }
    ret typed(ctx, span, name, d, lead, t);
}

# whether row `r` ends its block, nothing falling through after it, as OpKill and OpTerminateInvocation
pub fun ends(r: *masc_row.Row) bool {
    ret !masc_effect.falls(?r.effect.control);
}

# the storage class a call's pointer result points into where its row's typing states it: the Image class where it
# relates the result to the texel of an image, as OpImageTexelPointer's result points into (spir-v 1.6,
# OpImageTexelPointer), PhysicalStorageBuffer where the result is a physical pointer, as OpConvertUToPtr makes. none for
# any other row, whose pointer result keeps the default space or takes its base's (`chain_base`)
pub fun result_class(ctx: *lower_context.LowerContext, r: *masc_row.Row) opt[u32] {
    if (!lower_shader.attaching(ctx)) { ret opt[u32].none{}; }
    val opt_typing: opt[*typing.Typing] = typing.of(?gen_typing.TYPINGS[0], gen_typing.COUNT, r.index);
    if (sel opt_typing.none) { ret opt[u32].none{}; }
    val t: *typing.Typing = opt_typing.some;
    var k: u32            = 0;
    for (k < t.count) {
        if (t.forms[k].slot == typing.RESULT && t.forms[k].pointer == typing.PHYSICAL) { ret builder.physical_space(?ctx.builder); }
        if (t.forms[k].slot == typing.RESULT && t.forms[k].relation == typing.TEXEL) {
            val opt_class: opt[u64] = lower_shader.storage_class("Image");
            if (sel opt_class.none) { ret opt[u32].none{}; }
            ret opt[u32].some{opt_class.some::u32};
        }
        k = k + 1;
    }
    ret opt[u32].none{};
}

# the row operand a call's pointer result is chained from where its row's typing relates the result to an index chain,
# as OpInBoundsAccessChain's to its Base, the result pointing into the storage class that operand points into. none for
# any other row
pub fun chain_base(ctx: *lower_context.LowerContext, r: *masc_row.Row) opt[u8] {
    if (!lower_shader.attaching(ctx)) { ret opt[u8].none{}; }
    val opt_typing: opt[*typing.Typing] = typing.of(?gen_typing.TYPINGS[0], gen_typing.COUNT, r.index);
    if (sel opt_typing.none) { ret opt[u8].none{}; }
    val t: *typing.Typing = opt_typing.some;
    var k: u32            = 0;
    for (k < t.count) {
        if (t.forms[k].slot == typing.RESULT && t.forms[k].relation == typing.CHAIN) { ret opt[u8].some{t.forms[k].to}; }
        k = k + 1;
    }
    ret opt[u8].none{};
}

# the pointer result of a chained row held to what its indexes reach: from what parameter `base` points to, each
# parameter after it steps into an array's element, a vector's component, or the member of a record its constant names,
# and the return type points to what the last step reaches. `indexes` holds the constant each index parameter's argument
# folds to, none for one known only at run time
pub fun chained(ctx: *lower_context.LowerContext, span: base_source.Span, name: str, fn: type_kind.TypeId, lead: u32, base: u8, indexes: *opt[u64], n: u32) err[fail.Fail] {
    val opt_fn: opt[*type.Type] = shape_of(ctx, fn);
    if (sel opt_fn.none)                        { ret err[fail.Fail].ok{}; }
    if (opt_fn.some.kind != type_kind.TYPE_FUN) { ret err[fail.Fail].ok{}; }
    val d:     Declared = Declared{params: opt_fn.some.data.fn.params_start, count: opt_fn.some.data.fn.params_len, result: opt_fn.some.data.fn.ret_type};
    val first: u32      = base::u32 - lead;
    if (first >= d.count || type_kind.is_nil(d.result)) { ret err[fail.Fail].ok{}; }
    var at: type_kind.TypeId = pointee(ctx, param(ctx, ?d, first));
    var k:  u32              = 0;
    for (k < n) {
        val index: type_kind.TypeId = param(ctx, ?d, first + k + 1);
        if (!type_kind.is_nil(index) && !integer_scalar(ctx, index)) { ret refused_param(ctx, span, name, first + k + 1, index, "an index, a scalar integer"); }
        val opt_t: opt[*type.Type] = shape_of(ctx, at);
        if (sel opt_t.none) { ret err[fail.Fail].ok{}; }
        val kind: type_kind.TypeKind = opt_t.some.kind;
        if (kind == type_kind.TYPE_ARRAY) { at = type.strip_secret(?ctx.s.types, opt_t.some.data.array.base); }
        or (kind == type_kind.TYPE_VECTOR) {
            val opt_lane: opt[type_kind.TypeId] = type.prim(?ctx.s.types, opt_t.some.data.vector.element);
            if (sel opt_lane.none) { ret err[fail.Fail].ok{}; }
            at = opt_lane.some;
        }
        or (type.is_record(?ctx.s.types, at)) {
            val i: opt[u64] = indexes[k];
            if (sel i.none) {
                ret refused(ctx, span, diagnostic.format(ctx.s.alloc, "parameter {} of the declaration of `{}` indexes a record, so it must be a constant, such as a literal or a module-scope `val`", first + k + 2, name));
            }
            val members: u32 = type.field_count(?ctx.s.types, at);
            if (i.some >= members::u64) {
                ret refused(ctx, span, diagnostic.format(ctx.s.alloc, "parameter {} of the declaration of `{}` indexes member {} of a record of {} members", first + k + 2, name, i.some, members));
            }
            val opt_field: opt[*type_field.Entry] = type.field_at(?ctx.s.types, at, i.some::u32);
            if (sel opt_field.none) { ret err[fail.Fail].ok{}; }
            at = type.strip_secret(?ctx.s.types, opt_field.some.ty);
        }
        or {
            ret refused(ctx, span, diagnostic.format(ctx.s.alloc, "the declaration of `{}` passes {} indexes after parameter {}, but parameter {} indexes a value that has no members. pass one index per step into what parameter {} points to", name, n, first + 1, first + k + 2, first + 1));
        }
        k = k + 1;
    }
    if (!is_pointer(ctx, d.result) || pointee(ctx, d.result) == at) { ret err[fail.Fail].ok{}; }
    val res_reached: res[str, fail.Fail] = typename.type_to_str(ctx.s, at);
    if (sel res_reached.err) { ret err[fail.Fail].err{res_reached.err}; }
    fin { typename.type_str_free(ctx.s, res_reached.ok); }
    val res_named: res[str, fail.Fail] = typename.type_to_str(ctx.s, d.result);
    if (sel res_named.err) { ret err[fail.Fail].err{res_named.err}; }
    fin { typename.type_str_free(ctx.s, res_named.ok); }
    ret refused(ctx, span, diagnostic.format(ctx.s.alloc, "the declaration of `{}` returns `{}`, but its indexes reach `{}` in what parameter {} points to. return a pointer to that", name, res_named.ok, res_reached.ok, first + 1));
}

# the type a typed row's data operand or result is, or points to, held to the types the row admits
fun typed(ctx: *lower_context.LowerContext, span: base_source.Span, name: str, d: *Declared, lead: u32, t: *typing.Typing) err[fail.Fail] {
    if (t.data == typing.ABSENT) { ret err[fail.Fail].ok{}; }
    val held: type_kind.TypeId = slot_type(ctx, d, lead, t.data);
    if (type_kind.is_nil(held)) { ret err[fail.Fail].ok{}; }
    val pointed: type_kind.TypeId        = pointee(ctx, held);
    val opt_k:   opt[type_kind.TypeKind] = component(ctx, pointed);
    if (sel opt_k.some) {
        var k: u32 = 0;
        for (k < t.types) {
            if (holds(?t.typed[k], opt_k.some, lanes(ctx, pointed))) { ret err[fail.Fail].ok{}; }
            k = k + 1;
        }
    }
    val res_named: res[str, fail.Fail] = typename.type_to_str(ctx.s, pointed);
    if (sel res_named.err) { ret err[fail.Fail].err{res_named.err}; }
    fin { typename.type_str_free(ctx.s, res_named.ok); }
    if (is_pointer(ctx, held)) {
        ret refused(ctx, span, diagnostic.format(ctx.s.alloc, "parameter {} of the declaration of `{}` points to `{}`, which the instruction cannot operate on in any storage class. point it to {}", t.data::u32 - lead + 1, name, res_named.ok, typed_names(ctx, t)));
    }
    val res_slot: res[str, fail.Fail] = slot_name(ctx, lead, t.data);
    if (sel res_slot.err) { ret err[fail.Fail].err{res_slot.err}; }
    ret refused(ctx, span, diagnostic.format(ctx.s.alloc, "{} of the declaration of `{}` is `{}`, which the instruction cannot operate on. declare it as {}", res_slot.ok, name, res_named.ok, typed_names(ctx, t)));
}

# whether typed type `x` holds a scalar of kind `k`, or a vector of `n` components of it
fun holds(x: *typing.Typed, k: type_kind.TypeKind, n: u32) bool {
    val p: type_prim.PrimDesc = type_prim.prim_desc(k);
    if (p.class == type_prim.PRIM_CLASS_PTR)                { ret false; }
    if (x.float != (p.class == type_prim.PRIM_CLASS_FLOAT)) { ret false; }
    if (x.bits != 0 && x.bits::u32 != p.bits)               { ret false; }
    if (x.lanes == 0)                                       { ret n > 1; }
    ret x.lanes::u32 == n;
}

# the types a typed row admits, as `an integer of 32 bits, a vector of 4 integers of 8 bits or a vector of integers`
fun typed_names(ctx: *lower_context.LowerContext, t: *typing.Typing) str {
    var text: str = "";
    var k:    u32 = 0;
    for (k < t.types) {
        val res_one: res[str, fail.Fail] = typed_name(ctx, ?t.typed[k]);
        if (sel res_one.err) { ret text; }
        var res_joined: res[str, fail.Fail] = res_one;
        if (k > 0 && k + 1 == t.types) { res_joined = diagnostic.format(ctx.s.alloc, "{} or {}", text, res_one.ok); }
        or (k > 0)                     { res_joined = diagnostic.format(ctx.s.alloc, "{}, {}", text, res_one.ok); }
        if (sel res_joined.err)        { ret text; }
        text = res_joined.ok;
        k    = k + 1;
    }
    ret text;
}

# one type a typed row admits, as `an integer of 32 bits` or `a vector of 2 integers of 32 bits`
fun typed_name(ctx: *lower_context.LowerContext, x: *typing.Typed) res[str, fail.Fail] {
    var number: str = "integers";
    if (x.float) { number = "floats"; }
    if (x.lanes == 1) {
        if (x.float) { ret diagnostic.format(ctx.s.alloc, "a float of {} bits", x.bits::u32); }
        ret diagnostic.format(ctx.s.alloc, "an integer of {} bits", x.bits::u32);
    }
    if (x.lanes == 0 && x.bits == 0) { ret diagnostic.format(ctx.s.alloc, "a vector of {}", number); }
    if (x.lanes == 0)                { ret diagnostic.format(ctx.s.alloc, "a vector of {} of {} bits", number, x.bits::u32); }
    if (x.bits == 0)                 { ret diagnostic.format(ctx.s.alloc, "a vector of {} {}", x.lanes::u32, number); }
    ret diagnostic.format(ctx.s.alloc, "a vector of {} {} of {} bits", x.lanes::u32, number, x.bits::u32);
}

# the row operand the declaration's parameter at row operand `at` passes, a variadic operand
# taking every parameter from its own on, none for an operand past the row's own, which an
# enumerant brings and types
fun operand_of(r: *masc_row.Row, at: u32) opt[u32] {
    var j: u32 = 0;
    for (j < r.operands.len) {
        if (r.operands.at[j].quantity == masc_operand.VARIADIC && j <= at) { ret opt[u32].some{j}; }
        j = j + 1;
    }
    if (at < r.operands.len) { ret opt[u32].some{at}; }
    ret opt[u32].none{};
}

fun param(ctx: *lower_context.LowerContext, d: *Declared, i: u32) type_kind.TypeId {
    val opt_param: opt[type_kind.TypeId] = type.get_param(?ctx.s.types, d.params + i);
    if (sel opt_param.none) { ret type_kind.TYPE_NIL; }
    ret opt_param.some;
}

fun refused(ctx: *lower_context.LowerContext, span: base_source.Span, text: res[str, fail.Fail]) err[fail.Fail] {
    if (sel text.err) { ret err[fail.Fail].err{text.err}; }
    ret err[fail.Fail].err{lower_context.report_gate(ctx, diagnostic_kind.OP_SIGNATURE, span, text.ok)};
}

# a refusal naming parameter `i`, its type and what its operand takes
fun refused_param(ctx: *lower_context.LowerContext, span: base_source.Span, name: str, i: u32, t: type_kind.TypeId, takes: str) err[fail.Fail] {
    val res_named: res[str, fail.Fail] = typename.type_to_str(ctx.s, t);
    if (sel res_named.err) { ret err[fail.Fail].err{res_named.err}; }
    fin { typename.type_str_free(ctx.s, res_named.ok); }
    ret refused(ctx, span, diagnostic.format(ctx.s.alloc, "parameter {} of the declaration of `{}` is `{}`, but its operand takes {}", i + 1, name, res_named.ok, takes));
}

fun shape_of(ctx: *lower_context.LowerContext, t: type_kind.TypeId) opt[*type.Type] {
    if (type_kind.is_nil(t)) { ret opt[*type.Type].none{}; }
    ret type.get(?ctx.s.types, type.strip_secret(?ctx.s.types, t));
}

fun is_handle(ctx: *lower_context.LowerContext, t: type_kind.TypeId) bool {
    val opt_t: opt[*type.Type] = shape_of(ctx, t);
    if (sel opt_t.none) { ret false; }
    ret opt_t.some.kind == type_kind.TYPE_HANDLE;
}

fun is_pointer(ctx: *lower_context.LowerContext, t: type_kind.TypeId) bool {
    val opt_t: opt[*type.Type] = shape_of(ctx, t);
    if (sel opt_t.none) { ret false; }
    ret opt_t.some.kind == type_kind.TYPE_POINTER || opt_t.some.kind == type_kind.TYPE_PTR;
}

# the type a pointer points to, the type itself for any other
fun pointee(ctx: *lower_context.LowerContext, t: type_kind.TypeId) type_kind.TypeId {
    val opt_t: opt[*type.Type] = shape_of(ctx, t);
    if (sel opt_t.none)                            { ret t; }
    if (opt_t.some.kind == type_kind.TYPE_POINTER) { ret type.strip_secret(?ctx.s.types, opt_t.some.data.pointer.base); }
    ret type.strip_secret(?ctx.s.types, t);
}

# the kind of a scalar `t` is, or of a vector's component, none for any other type
fun component(ctx: *lower_context.LowerContext, t: type_kind.TypeId) opt[type_kind.TypeKind] {
    val opt_t: opt[*type.Type] = shape_of(ctx, t);
    if (sel opt_t.none) { ret opt[type_kind.TypeKind].none{}; }
    val k: type_kind.TypeKind = opt_t.some.kind;
    if (k == type_kind.TYPE_VECTOR)                      { ret opt[type_kind.TypeKind].some{opt_t.some.data.vector.element}; }
    if (type_prim.is_prim(k) && k != type_kind.TYPE_PTR) { ret opt[type_kind.TypeKind].some{k}; }
    ret opt[type_kind.TypeKind].none{};
}

# the component count of `t`, a scalar's being 1
fun lanes(ctx: *lower_context.LowerContext, t: type_kind.TypeId) u32 {
    val opt_t: opt[*type.Type] = shape_of(ctx, t);
    if (sel opt_t.none)                           { ret 0; }
    if (opt_t.some.kind == type_kind.TYPE_VECTOR) { ret opt_t.some.data.vector.lanes; }
    ret 1;
}

fun integer_scalar(ctx: *lower_context.LowerContext, t: type_kind.TypeId) bool {
    if (lanes(ctx, t) != 1) { ret false; }
    val opt_k: opt[type_kind.TypeKind] = component(ctx, t);
    if (sel opt_k.none) { ret false; }
    ret type_prim.prim_desc(opt_k.some).class == type_prim.PRIM_CLASS_INT;
}

# the handle kind row operand `j` names, masc_operand.NO_HANDLE for none
fun handle_kind(r: *masc_row.Row, j: u32) u8 {
    val x: *masc_operand.Operand = ?r.operands.at[j];
    if (sel x.shape.id) { ret x.shape.id.handle; }
    ret masc_operand.NO_HANDLE;
}

# whether row operand `j` is a constant id, a literal, an immediate or an enumerant
fun constant_operand(r: *masc_row.Row, j: u32) bool {
    val x: *masc_operand.Operand = ?r.operands.at[j];
    if (!(sel x.shape.id)) { ret true; }
    val o: masc_effect.Order = r.effect.order;
    val n: u32               = j + 1;
    ret n == o.scope::u32 || n == o.semantics::u32 || n == o.failure::u32 || n == o.execution::u32;
}

# whether the row accesses memory through row operand `j`
fun accessed(r: *masc_row.Row, j: u32) bool {
    val m: masc_effect.Accesses = r.effect.memory;
    var k: u32                  = 0;
    for (k < m.len) {
        if (m.at[k].operand::u32 == j && m.at[k].role != masc_operand.NONE) { ret true; }
        k = k + 1;
    }
    ret false;
}

# parameter `i`, of type `t`, held to the kind of row operand `j`
fun kind(ctx: *lower_context.LowerContext, span: base_source.Span, name: str, r: *masc_row.Row, j: u32, i: u32, t: type_kind.TypeId) err[fail.Fail] {
    if (type_kind.is_nil(t)) { ret err[fail.Fail].ok{}; }
    if (constant_operand(r, j)) {
        if (!integer_scalar(ctx, t)) { ret refused_param(ctx, span, name, i, t, "a constant integer, as a constant id or a literal is written"); }
        ret err[fail.Fail].ok{};
    }
    val h: u8 = handle_kind(r, j);
    if (h == spirv_kind.IMAGE_POINTER) {
        if (!is_pointer(ctx, t) || !is_handle(ctx, pointee(ctx, t))) { ret refused_param(ctx, span, name, i, t, "a pointer to an image's binding"); }
        ret err[fail.Fail].ok{};
    }
    if (h != masc_operand.NO_HANDLE) {
        if (!is_handle(ctx, t)) { ret refused_param(ctx, span, name, i, t, "a handle, an image, a sampler or a sampled image passed by value"); }
        ret err[fail.Fail].ok{};
    }
    if (accessed(r, j) && !is_pointer(ctx, t)) { ret refused_param(ctx, span, name, i, t, "a pointer, the memory it reads or writes through"); }
    ret err[fail.Fail].ok{};
}

# the type the declaration gives row operand `slot`, the result's for typing.RESULT, nil for
# one it passes no parameter for
fun slot_type(ctx: *lower_context.LowerContext, d: *Declared, lead: u32, slot: u8) type_kind.TypeId {
    if (slot == typing.RESULT)                           { ret d.result; }
    if (slot::u32 < lead || slot::u32 - lead >= d.count) { ret type_kind.TYPE_NIL; }
    ret param(ctx, d, slot::u32 - lead);
}

# what a refusal calls slot `slot`
fun slot_name(ctx: *lower_context.LowerContext, lead: u32, slot: u8) res[str, fail.Fail] {
    if (slot == typing.RESULT) { ret res[str, fail.Fail].ok{"the return type"}; }
    ret diagnostic.format(ctx.s.alloc, "parameter {}", slot::u32 - lead + 1);
}

# where a form holds a type: a slot, or a member of the record the slot's type is, the record a
# pointer slot points to
# ---
# slot:   the slot
# member: the member, typing.LAST for the record's last, WHOLE for the slot's type itself
rec Place {
    slot:   u8;
    member: u8;
}

val WHOLE: u8 = 0xFE;

# what a refusal calls place `at` of declaration `d` of instruction `name`, as `parameter 2 of the
# declaration of `Ldexp`` or `the last member of the record parameter 1 of the declaration of
# `OpArrayLength` points to`
fun place_name(ctx: *lower_context.LowerContext, name: str, d: *Declared, lead: u32, at: Place) res[str, fail.Fail] {
    val res_slot: res[str, fail.Fail] = slot_name(ctx, lead, at.slot);
    if (sel res_slot.err) { ret res_slot; }
    var member: str = "";
    if (at.member == typing.LAST) { member = "the last member of "; }
    or (at.member != WHOLE) {
        val res_member: res[str, fail.Fail] = diagnostic.format(ctx.s.alloc, "member {} of ", at.member::u32);
        if (sel res_member.err) { ret res_member; }
        member = res_member.ok;
    }
    if (at.member != WHOLE && is_pointer(ctx, slot_type(ctx, d, lead, at.slot))) { ret diagnostic.format(ctx.s.alloc, "{}the record {} of the declaration of `{}` points to", member, res_slot.ok, name); }
    ret diagnostic.format(ctx.s.alloc, "{}{} of the declaration of `{}`", member, res_slot.ok, name);
}

val CLASS_NAMES: [7]str = [7]str{"a type", "floats", "integers", "signed integers", "unsigned integers", "integers or floats", "integers, a truth value of 1 or 0"};

# whether a component of kind `k` is a number class `c` admits
fun admits(c: typing.Class, k: type_kind.TypeKind) bool {
    val p: type_prim.PrimDesc = type_prim.prim_desc(k);
    if (c == typing.ANY)                          { ret true; }
    if (c == typing.FLOAT)                        { ret p.class == type_prim.PRIM_CLASS_FLOAT; }
    if (c == typing.INTEGER || c == typing.TRUTH) { ret p.class == type_prim.PRIM_CLASS_INT; }
    if (c == typing.SIGNED)                       { ret p.class == type_prim.PRIM_CLASS_INT && p.signed; }
    if (c == typing.UNSIGNED)                     { ret p.class == type_prim.PRIM_CLASS_INT && !p.signed; }
    ret p.class == type_prim.PRIM_CLASS_INT || p.class == type_prim.PRIM_CLASS_FLOAT;
}

# whether the form `f` of row `r` holds a pointer: one its form says is, or one the row reads or writes through
fun pointer_slot(r: *masc_row.Row, f: *typing.Form) bool {
    if (f.pointer != typing.VALUE) { ret true; }
    ret f.slot != typing.RESULT && f.slot::u32 < r.operands.len && accessed(r, f.slot::u32);
}

# whether row operand `slot` is a variadic literal, whose values a form holds by their count
fun literal_slot(r: *masc_row.Row, slot: u8) bool {
    if (slot == typing.RESULT || slot::u32 >= r.operands.len) { ret false; }
    ret r.operands.at[slot].quantity == masc_operand.VARIADIC;
}

# the members of the record slot `m.form.slot`'s type is, or points to, held to member form `m`
# of typing `t`: a record of exactly the members `t` names by index, or of any where `m` names
# its last, whose member `m` names is held to the form
fun member(ctx: *lower_context.LowerContext, span: base_source.Span, name: str, r: *masc_row.Row, d: *Declared, lead: u32, t: *typing.Typing, m: *typing.Member) err[fail.Fail] {
    val whole: Place            = Place{slot: m.form.slot, member: WHOLE};
    val held:  type_kind.TypeId = slot_type(ctx, d, lead, m.form.slot);
    if (type_kind.is_nil(held)) { ret err[fail.Fail].ok{}; }
    val record: type_kind.TypeId = pointee(ctx, held);
    if (!type.is_record(?ctx.s.types, record)) { ret broke_place(ctx, span, name, d, lead, whole, held, "but the instruction takes a record there"); }
    val members: u32 = type.field_count(?ctx.s.types, record);
    var index:   u32 = m.index::u32;
    if (m.index == typing.LAST) {
        if (members == 0) { ret broke_place(ctx, span, name, d, lead, whole, held, "but the instruction takes a record of at least one member there"); }
        index = members - 1;
    }
    or {
        var named: u32 = 0;
        var k:     u32 = 0;
        for (k < t.membered) {
            if (t.members[k].form.slot == m.form.slot && t.members[k].index != typing.LAST) { named = named + 1; }
            k = k + 1;
        }
        if (members != named) {
            val res_takes: res[str, fail.Fail] = diagnostic.format(ctx.s.alloc, "a record of {} members, but the instruction takes a record of {} members there", members, named);
            if (sel res_takes.err) { ret err[fail.Fail].err{res_takes.err}; }
            ret broke_place(ctx, span, name, d, lead, whole, held, res_takes.ok);
        }
    }
    val opt_field: opt[*type_field.Entry] = type.field_at(?ctx.s.types, record, index);
    if (sel opt_field.none) { ret err[fail.Fail].ok{}; }
    ret form(ctx, span, name, r, d, lead, ?m.form, Place{slot: m.form.slot, member: m.index}, type.strip_secret(?ctx.s.types, opt_field.some.ty));
}

# whether `t` is an array whose length the program sets at run time, `[0]T`
fun runtime_array(ctx: *lower_context.LowerContext, t: type_kind.TypeId) bool {
    val opt_t: opt[*type.Type] = shape_of(ctx, t);
    if (sel opt_t.none)                          { ret false; }
    if (opt_t.some.kind != type_kind.TYPE_ARRAY) { ret false; }
    ret opt_t.some.data.array.count == 0;
}

# place `at` of the declaration, of type `held`, held to form `f`
fun form(ctx: *lower_context.LowerContext, span: base_source.Span, name: str, r: *masc_row.Row, d: *Declared, lead: u32, f: *typing.Form, at: Place, held: type_kind.TypeId) err[fail.Fail] {
    if (at.member == WHOLE && literal_slot(r, f.slot)) { ret counted(ctx, span, name, d, lead, f); }
    if (type_kind.is_nil(held))                        { ret err[fail.Fail].ok{}; }
    val pointed: bool = at.member == WHOLE && pointer_slot(r, f);
    if (pointed && !is_pointer(ctx, held)) { ret broke_place(ctx, span, name, d, lead, at, held, "but the instruction takes a pointer there"); }
    if (!pointed && is_pointer(ctx, held)) { ret broke_place(ctx, span, name, d, lead, at, held, "but the instruction takes a value, not a pointer there"); }
    val t: type_kind.TypeId = pointee(ctx, held);
    if (f.shape == typing.RUNTIME) {
        if (!runtime_array(ctx, t)) { ret broke_place(ctx, span, name, d, lead, at, held, "but the instruction takes an array whose length the program sets at run time, declared `[0]T`"); }
        ret err[fail.Fail].ok{};
    }
    if (f.relation == typing.COMPOSED) {
        val to: type_kind.TypeId = pointee(ctx, slot_type(ctx, d, lead, f.to));
        if (type_kind.is_nil(to))  { ret err[fail.Fail].ok{}; }
        if (!composes(ctx, t, to)) { ret broke(ctx, span, name, d, lead, f, at, held, "a sampled image whose image is the type of"); }
        ret err[fail.Fail].ok{};
    }
    if (f.class != typing.ANY) {
        val opt_k: opt[type_kind.TypeKind] = component(ctx, t);
        var ok:    bool                    = false;
        if (sel opt_k.some) { ok = admits(f.class, opt_k.some); }
        if (!ok)            { ret broke_class(ctx, span, name, d, lead, f, at, held); }
    }
    val n: u32 = lanes(ctx, t);
    if ((f.shape == typing.SCALAR && n != 1) || (f.shape == typing.VECTOR && n < 2) || (f.lanes != 0 && n != f.lanes::u32)) { ret broke_class(ctx, span, name, d, lead, f, at, held); }
    if (f.bits != 0) {
        val opt_k: opt[type_kind.TypeKind] = component(ctx, t);
        if (sel opt_k.some) {
            if (type_prim.prim_desc(opt_k.some).bits != f.bits::u32) { ret broke_class(ctx, span, name, d, lead, f, at, held); }
        }
    }
    if (f.widest != 0) {
        val opt_k: opt[type_kind.TypeKind] = component(ctx, t);
        if (sel opt_k.some) {
            if (type_prim.prim_desc(opt_k.some).bits > f.widest::u32) { ret broke_class(ctx, span, name, d, lead, f, at, held); }
        }
    }
    if (f.relation == typing.NONE) { ret err[fail.Fail].ok{}; }
    val other: type_kind.TypeId = slot_type(ctx, d, lead, f.to);
    if (type_kind.is_nil(other)) { ret err[fail.Fail].ok{}; }
    val u: type_kind.TypeId = pointee(ctx, other);
    if (f.relation == typing.SAME && t != u) { ret broke(ctx, span, name, d, lead, f, at, held, "the type of"); }
    if (f.relation == typing.COMPONENT || f.relation == typing.ELEMENT) {
        val opt_mine:   opt[type_kind.TypeKind] = component(ctx, t);
        val opt_theirs: opt[type_kind.TypeKind] = component(ctx, u);
        if (sel opt_theirs.some) {
            var same_kind: bool = false;
            if (sel opt_mine.some)                                                    { same_kind = opt_mine.some == opt_theirs.some; }
            if (f.relation == typing.COMPONENT && (lanes(ctx, t) != 1 || !same_kind)) { ret broke(ctx, span, name, d, lead, f, at, held, "the component type of"); }
            if (f.relation == typing.ELEMENT && !same_kind)                           { ret broke(ctx, span, name, d, lead, f, at, held, "components of the component type of"); }
        }
    }
    if (f.relation == typing.LANES && lanes(ctx, t) != lanes(ctx, u)) { ret broke(ctx, span, name, d, lead, f, at, held, "as many components as"); }
    if (f.relation == typing.LIKE) {
        val opt_mine:   opt[type_kind.TypeKind] = component(ctx, t);
        val opt_theirs: opt[type_kind.TypeKind] = component(ctx, u);
        var alike:      bool                    = lanes(ctx, t) == lanes(ctx, u);
        if (sel opt_mine.some) {
            if (sel opt_theirs.some) { alike = alike && same_number(opt_mine.some, opt_theirs.some); }
        }
        if (!alike) { ret broke(ctx, span, name, d, lead, f, at, held, "as many components, of one class and width, as"); }
    }
    if (f.relation == typing.WIDE && lanes(ctx, u) > 1) {
        val opt_mine:   opt[type_kind.TypeKind] = component(ctx, t);
        val opt_theirs: opt[type_kind.TypeKind] = component(ctx, u);
        if (sel opt_mine.some) {
            if (sel opt_theirs.some) {
                if (type_prim.prim_desc(opt_mine.some).bits < type_prim.prim_desc(opt_theirs.some).bits) { ret broke(ctx, span, name, d, lead, f, at, held, "a component at least as wide as the components of"); }
            }
        }
    }
    if (f.relation == typing.TEXEL || f.relation == typing.FORMAT) {
        val opt_texel: opt[type_kind.TypeKind] = texel(ctx, u);
        val opt_mine:  opt[type_kind.TypeKind] = component(ctx, t);
        if (sel opt_texel.some) {
            if (sel opt_mine.some) {
                if (!same_number(opt_texel.some, opt_mine.some)) { ret broke(ctx, span, name, d, lead, f, at, held, "the texel scalar of the image of"); }
            }
        }
        if (f.relation == typing.FORMAT && lanes(ctx, t) < format_lanes(ctx, u)) { ret broke(ctx, span, name, d, lead, f, at, held, "at least as many components as the format of the image of"); }
    }
    ret err[fail.Fail].ok{};
}

# whether two scalar kinds are one number, alike in class and width, as spir-v's integers
# carry no sign
fun same_number(a: type_kind.TypeKind, b: type_kind.TypeKind) bool {
    val x: type_prim.PrimDesc = type_prim.prim_desc(a);
    val y: type_prim.PrimDesc = type_prim.prim_desc(b);
    ret x.class == y.class && x.bits == y.bits;
}

# the values the declaration passes for the variadic literal `f.slot` held to the count its form relates them to
fun counted(ctx: *lower_context.LowerContext, span: base_source.Span, name: str, d: *Declared, lead: u32, f: *typing.Form) err[fail.Fail] {
    if (f.relation != typing.COUNT || f.slot::u32 < lead) { ret err[fail.Fail].ok{}; }
    val first: u32 = f.slot::u32 - lead;
    var given: u32 = 0;
    if (d.count > first) { given = d.count - first; }
    val other: type_kind.TypeId = slot_type(ctx, d, lead, f.to);
    if (type_kind.is_nil(other)) { ret err[fail.Fail].ok{}; }
    val want: u32 = lanes(ctx, pointee(ctx, other));
    if (given == want) { ret err[fail.Fail].ok{}; }
    val res_to: res[str, fail.Fail] = slot_name(ctx, lead, f.to);
    if (sel res_to.err) { ret err[fail.Fail].err{res_to.err}; }
    ret refused(ctx, span, diagnostic.format(ctx.s.alloc, "the declaration of `{}` passes {} values from parameter {} on, but the instruction takes one for each of the {} components of {}. declare one parameter per component",
        name, given, first + 1, want, res_to.ok));
}

# place `at` of the declaration, of type `held`, refused saying what the instruction takes there
fun broke_place(ctx: *lower_context.LowerContext, span: base_source.Span, name: str, d: *Declared, lead: u32, at: Place, held: type_kind.TypeId, takes: str) err[fail.Fail] {
    val res_named: res[str, fail.Fail] = typename.type_to_str(ctx.s, held);
    if (sel res_named.err) { ret err[fail.Fail].err{res_named.err}; }
    fin { typename.type_str_free(ctx.s, res_named.ok); }
    val res_place: res[str, fail.Fail] = place_name(ctx, name, d, lead, at);
    if (sel res_place.err) { ret err[fail.Fail].err{res_place.err}; }
    ret refused(ctx, span, diagnostic.format(ctx.s.alloc, "{} is `{}`, {}", res_place.ok, res_named.ok, takes));
}

fun broke_class(ctx: *lower_context.LowerContext, span: base_source.Span, name: str, d: *Declared, lead: u32, f: *typing.Form, at: Place, held: type_kind.TypeId) err[fail.Fail] {
    var shape: str = "a scalar or vector";
    if (f.shape == typing.SCALAR) { shape = "a scalar"; }
    if (f.shape == typing.VECTOR) { shape = "a vector"; }
    val res_takes: res[str, fail.Fail] = diagnostic.format(ctx.s.alloc, "but the instruction takes {} of {}{}{}", shape, CLASS_NAMES[f.class], lanes_text(f), bits_text(f));
    if (sel res_takes.err) { ret err[fail.Fail].err{res_takes.err}; }
    ret broke_place(ctx, span, name, d, lead, at, held, res_takes.ok);
}

fun lanes_text(f: *typing.Form) str {
    if (f.lanes == 2) { ret ", of 2 components"; }
    if (f.lanes == 3) { ret ", of 3 components"; }
    if (f.lanes == 4) { ret ", of 4 components"; }
    ret "";
}

fun bits_text(f: *typing.Form) str {
    if (f.bits == 16)   { ret ", 16 bits wide"; }
    if (f.bits == 32)   { ret ", 32 bits wide"; }
    if (f.bits == 64)   { ret ", 64 bits wide"; }
    if (f.widest == 16) { ret ", at most 16 bits wide"; }
    if (f.widest == 32) { ret ", at most 32 bits wide"; }
    ret "";
}

# a relation of place `at` to slot `f.to` the declaration breaks, saying a pointer's type is
# its pointee's where either takes a pointer
fun broke(ctx: *lower_context.LowerContext, span: base_source.Span, name: str, d: *Declared, lead: u32, f: *typing.Form, at: Place, held: type_kind.TypeId, relation: str) err[fail.Fail] {
    val res_named: res[str, fail.Fail] = typename.type_to_str(ctx.s, held);
    if (sel res_named.err) { ret err[fail.Fail].err{res_named.err}; }
    fin { typename.type_str_free(ctx.s, res_named.ok); }
    val res_slot: res[str, fail.Fail] = place_name(ctx, name, d, lead, at);
    if (sel res_slot.err) { ret err[fail.Fail].err{res_slot.err}; }
    val res_to: res[str, fail.Fail] = slot_name(ctx, lead, f.to);
    if (sel res_to.err) { ret err[fail.Fail].err{res_to.err}; }
    var said: str = "{} is `{}`, but the instruction takes {} {}. declare them alike";
    if (is_pointer(ctx, held) || is_pointer(ctx, slot_type(ctx, d, lead, f.to))) { said = "{} is `{}`, but the instruction takes {} {}, counting a pointer as the type it points to. declare them alike"; }
    ret refused(ctx, span, diagnostic.format(ctx.s.alloc, said, res_slot.ok, res_named.ok, relation, res_to.ok));
}

# operand `i` of handle `h` as its part and value
fun handle_operand(ctx: *lower_context.LowerContext, h: type.TypeHandle, i: u32, part: u32) opt[u32] {
    if (i * 2 + 1 >= h.ops_len)                              { ret opt[u32].none{}; }
    if (ctx.s.types.handle_ops[h.ops_start + i * 2] != part) { ret opt[u32].none{}; }
    ret opt[u32].some{ctx.s.types.handle_ops[h.ops_start + i * 2 + 1]};
}

# the image `t` is, a sampled image's being the image it composes over, none for another type
fun image_of(ctx: *lower_context.LowerContext, t: type_kind.TypeId) opt[type.TypeHandle] {
    val opt_t: opt[*type.Type] = shape_of(ctx, t);
    if (sel opt_t.none)                           { ret opt[type.TypeHandle].none{}; }
    if (opt_t.some.kind != type_kind.TYPE_HANDLE) { ret opt[type.TypeHandle].none{}; }
    val h:    type.TypeHandle = opt_t.some.data.handle;
    val kind: str             = intern.text(?ctx.s.interner, h.ctor::intern.StrId);
    if (str_equals(kind, "spirv.image"))          { ret opt[type.TypeHandle].some{h}; }
    if (!str_equals(kind, "spirv.sampled_image")) { ret opt[type.TypeHandle].none{}; }
    val opt_inner: opt[u32] = handle_operand(ctx, h, 0, type.HANDLE_PART_TYPE);
    if (sel opt_inner.none) { ret opt[type.TypeHandle].none{}; }
    ret image_of(ctx, opt_inner.some::type_kind.TypeId);
}

# the texel scalar of the image `t` is, none for another type
fun texel(ctx: *lower_context.LowerContext, t: type_kind.TypeId) opt[type_kind.TypeKind] {
    val opt_image: opt[type.TypeHandle] = image_of(ctx, t);
    if (sel opt_image.none) { ret opt[type_kind.TypeKind].none{}; }
    val opt_scalar: opt[u32] = handle_operand(ctx, opt_image.some, 0, type.HANDLE_PART_TYPE);
    if (sel opt_scalar.none) { ret opt[type_kind.TypeKind].none{}; }
    ret component(ctx, opt_scalar.some::type_kind.TypeId);
}

# the components the handle type `t` stores, as the target's catalog gives the number its texels
# are, 0 where it gives none, as for an image of unknown format
fun format_lanes(ctx: *lower_context.LowerContext, t: type_kind.TypeId) u32 {
    val res_lowered: res[mirl_types.Type, fail.Fail] = lower_context.lower_type(ctx, t);
    if (sel res_lowered.err) { ret 0; }
    val opt_number: opt[mirl_capability.Number] = lower_context.texel_number(ctx, res_lowered.ok);
    if (sel opt_number.none) { ret 0; }
    ret opt_number.some.lanes;
}

# whether `t` is a sampled image composed over the image type `image`
fun composes(ctx: *lower_context.LowerContext, t: type_kind.TypeId, image: type_kind.TypeId) bool {
    val opt_t: opt[*type.Type] = shape_of(ctx, t);
    if (sel opt_t.none)                           { ret false; }
    if (opt_t.some.kind != type_kind.TYPE_HANDLE) { ret false; }
    val opt_inner: opt[u32] = handle_operand(ctx, opt_t.some.data.handle, 0, type.HANDLE_PART_TYPE);
    if (sel opt_inner.none) { ret false; }
    ret type.strip_secret(?ctx.s.types, opt_inner.some::type_kind.TypeId) == image;
}
