# a published constant value laid out as the constant bytes of its type: a record's fields at
# their offsets, a tag's case code and payload, an array's or a vector's elements at the
# element stride, a string leaf as a pointer to its bytes, and an address as a relocation
# against the symbol it points into. the bytes become one mirl constant: runs of bytes
# between the addresses, each address at its offset, or under logical addressing, which
# reinterprets no memory, a constant of the type itself, read member by member from them
use std.collections.map;
use std.collections.slice.Slice;
use collections_vector: std.collections.vector;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.view.View;

use A: std.allocator;

use mach.base.fail;
use mach.base.float;
use mach.base.intern;
use mach.base.wide;
use comptime_deep: mach.front.comptime.deep;
use mach.lower.builder;
use lower_context: mach.lower.context;
use mach.lower.irt;
use mach.lower.mangle;
use mach.lower.value;
use mach.session;
use mach.session.module;
use mach.type;
use mach.type.shape;

use comptime_value: mach.front.comptime.value;
use type_field:     mach.type.field;
use type_kind:      mach.type.kind;
use mbuild:         mirl.build.builder;
use mirl.ir.constant.Address;
use mirl.ir.constant.Aggregate;
use mirl.ir.constant.Bits;
use mirl.ir.constant.Bytes;
use mirl.ir.constant.ConstantData;
use mirl.ir.function.ConstantTime;
use mirl_global: mirl.ir.global;
use mirl.ir.id;
use mirl_module: mirl.ir.module;
use mirl.ir.type.table.Type;

# an address the bytes hold at `offset`
rec Reloc {
    offset: u64;
    symbol: id.Symbol;
    addend: i64;
}

# the bytes of a constant being laid out and the addresses among them
rec Image {
    blob:   *u8;
    size:   u64;
    relocs: collections_vector.Vector[Reloc];
}

fun size_of(ctx: *lower_context.LowerContext, ty: Type) res[u64, fail.Fail] {
    ret irt.size(?ctx.builder.layout, ty);
}

# node `node` of `store` as a constant of the mirl type `ity`, which a global of `ity` is
# initialised with
pub fun aggregate(ctx: *lower_context.LowerContext, store: *comptime_deep.Store, node: comptime_deep.Node, ity: Type) res[value.Value, fail.Fail] {
    val res_size: res[u64, fail.Fail] = size_of(ctx, ity);
    if (sel res_size.err) { ret res[value.Value, fail.Fail].err{res_size.err}; }
    if (res_size.ok == 0) {
        # a type with no bytes has one value and nothing to place
        val res_zero: res[id.Constant, fail.Fail] = made(ctx, ConstantData.zero{ity});
        if (sel res_zero.err) { ret res[value.Value, fail.Fail].err{res_zero.err}; }
        ret res[value.Value, fail.Fail].ok{value.constant(res_zero.ok, ity)};
    }
    val res_blob: res[*u8, A.Error] = A.zallocate[u8](ctx.s.alloc, res_size.ok::usize);
    if (sel res_blob.err) { ret res[value.Value, fail.Fail].err{fail.refused(res_blob.err)}; }
    var image: Image = Image{blob: res_blob.ok, size: res_size.ok, relocs: collections_vector.init[Reloc](ctx.s.alloc)};
    fin {
        A.deallocate[u8](ctx.s.alloc, image.blob, image.size::usize);
        collections_vector.dnit[Reloc](?image.relocs);
    }
    val err_placed: err[fail.Fail] = place(ctx, store, node, ity, 0, ?image);
    if (sel err_placed.err) { ret res[value.Value, fail.Fail].err{err_placed.err}; }
    val res_made: res[id.Constant, fail.Fail] = constant_of_image(ctx, ?image, ity);
    if (sel res_made.err) { ret res[value.Value, fail.Fail].err{res_made.err}; }
    ret res[value.Value, fail.Fail].ok{value.constant(res_made.ok, constant_type(ctx, res_made.ok, ity))};
}

# the type a constant made from an image holds: the image's own when it is no constant of `ity`
fun constant_type(ctx: *lower_context.LowerContext, c: id.Constant, ity: Type) Type {
    val res_held: res[Type, mirl_module.Error] = mirl_module.constant_type(ctx.m, c);
    if (sel res_held.ok) { ret res_held.ok; }
    ret ity;
}

# bytes as one constant: zero when every byte is, a constant of `ity` under logical
# addressing, an address when one address fills them, else a structure of byte runs and the
# addresses between them
fun constant_of_image(ctx: *lower_context.LowerContext, image: *Image, ity: Type) res[id.Constant, fail.Fail] {
    val ptr: Type = lower_context.ptr_or_none(ctx);
    if (image.relocs.len == 0 && all_zero(image.blob, image.size)) {
        ret made(ctx, ConstantData.zero{ity});
    }
    if (builder.classes(?ctx.builder)) { ret typed(ctx, image, ity, 0); }
    val res_psize: res[u64, fail.Fail] = size_of(ctx, ptr);
    if (sel res_psize.err) { ret res[id.Constant, fail.Fail].err{res_psize.err}; }
    if (image.relocs.len == 1 && image.size == res_psize.ok && image.relocs.data[0].offset == 0 && irt.is_ptr(?ctx.m.types, ity)) {
        val r: Reloc = image.relocs.data[0];
        ret made(ctx, ConstantData.address{Address{type: ptr, symbol: r.symbol, offset: r.addend}});
    }

    order_relocs(image);
    var members:  collections_vector.Vector[Type]        = collections_vector.init[Type](ctx.s.alloc);
    var offsets:  collections_vector.Vector[u64]         = collections_vector.init[u64](ctx.s.alloc);
    var elements: collections_vector.Vector[id.Constant] = collections_vector.init[id.Constant](ctx.s.alloc);
    fin {
        collections_vector.dnit[Type](?members);
        collections_vector.dnit[u64](?offsets);
        collections_vector.dnit[id.Constant](?elements);
    }
    var at: u64   = 0;
    var r:  usize = 0;
    for (at < image.size) {
        var end: u64 = image.size;
        if (r < image.relocs.len) { end = image.relocs.data[r].offset; }
        if (end > at) {
            val res_run: res[Pair, fail.Fail] = byte_run(ctx, image.blob, at, end - at);
            if (sel res_run.err) { ret res[id.Constant, fail.Fail].err{res_run.err}; }
            val err_pushed: err[fail.Fail] = member_add(?members, ?offsets, ?elements, res_run.ok.ty, at, res_run.ok.c);
            if (sel err_pushed.err) { ret res[id.Constant, fail.Fail].err{err_pushed.err}; }
            at = end;
        }
        if (r < image.relocs.len) {
            val rl:       Reloc                       = image.relocs.data[r];
            val res_addr: res[id.Constant, fail.Fail] = made(ctx, ConstantData.address{Address{type: ptr, symbol: rl.symbol, offset: rl.addend}});
            if (sel res_addr.err) { ret res_addr; }
            val err_pushed: err[fail.Fail] = member_add(?members, ?offsets, ?elements, ptr, at, res_addr.ok);
            if (sel err_pushed.err) { ret res[id.Constant, fail.Fail].err{err_pushed.err}; }
            at = at + res_psize.ok;
            r  = r + 1;
        }
    }
    val res_structure_at: res[Type, fail.Fail] = irt.structure_at(?ctx.m.types, members.data, offsets.data, members.len::u32);
    if (sel res_structure_at.err) { ret res[id.Constant, fail.Fail].err{res_structure_at.err}; }
    ret made(ctx, ConstantData.aggregate{Aggregate{type: res_structure_at.ok, elements: Slice[id.Constant]{data: elements.data, size: elements.len}}});
}

# the bytes of `image` from `base` as a constant of the type `ty` laid out there: zero where
# they and no address are, a number of the bits its bytes hold, an address where one is placed,
# and an aggregate of its members' or elements' constants. a union has no constant of its own
# members to be held as, so one that is not zero is refused
fun typed(ctx: *lower_context.LowerContext, image: *Image, ty: Type, base: u64) res[id.Constant, fail.Fail] {
    val res_size: res[u64, fail.Fail] = size_of(ctx, ty);
    if (sel res_size.err) { ret res[id.Constant, fail.Fail].err{res_size.err}; }
    val size:   u64        = res_size.ok;
    val opt_at: opt[Reloc] = reloc_at(image, base);
    val placed: bool       = sel opt_at.some;
    if (irt.is_ptr(?ctx.m.types, ty)) {
        if (sel opt_at.some) { ret made(ctx, ConstantData.address{Address{type: ty, symbol: opt_at.some.symbol, offset: opt_at.some.addend}}); }
        ret made(ctx, ConstantData.zero{ty});
    }
    if (!placed && !relocated(image, base, size) && all_zero((image.blob::usize + base::usize)::*u8, size)) { ret made(ctx, ConstantData.zero{ty}); }
    if (irt.is_int(?ctx.m.types, ty) || irt.is_float(?ctx.m.types, ty)) {
        if (size == 0 || size > 16) { ret res[id.Constant, fail.Fail].err{fail.message("lower: a constant scalar has an unsupported size")}; }
        var words: [2]u64 = [2]u64{0, 0};
        var i:     u64    = 0;
        for (i < size) {
            words[i / 8] = words[i / 8] | (image.blob[base + i]::u64 << ((i % 8) * 8));
            i            = i + 1;
        }
        val bits: Bits = Bits{type: ty, words: Slice[u64]{data: ?words[0], size: ((size + 7) / 8)::usize}};
        if (irt.is_float(?ctx.m.types, ty)) { ret made(ctx, ConstantData.float{bits}); }
        ret made(ctx, ConstantData.integer{bits});
    }
    var count:  u64  = 0;
    var stride: u64  = 0;
    val record: bool = irt.is_struct(?ctx.m.types, ty);
    if (record) { count = irt.member_count(?ctx.m.types, ty)::u64; }
    or (irt.is_array(?ctx.m.types, ty) || irt.is_vector(?ctx.m.types, ty)) {
        count = irt.count(?ctx.m.types, ty);
        if (irt.is_vector(?ctx.m.types, ty)) { count = irt.lanes(?ctx.m.types, ty)::u64; }
        val res_stride: res[u64, fail.Fail] = element_stride(ctx, ty);
        if (sel res_stride.err) { ret res[id.Constant, fail.Fail].err{res_stride.err}; }
        stride = res_stride.ok;
    }
    or { ret res[id.Constant, fail.Fail].err{fail.message("lower: a constant under logical addressing holds a union or another type with no constant of its own")}; }
    var elements: collections_vector.Vector[id.Constant] = collections_vector.init[id.Constant](ctx.s.alloc);
    fin { collections_vector.dnit[id.Constant](?elements); }
    var k: u64 = 0;
    for (k < count) {
        var at:   u64  = base + k * stride;
        var part: Type = irt.element(?ctx.m.types, ty);
        if (record) {
            part = irt.member(?ctx.m.types, ty, k::u32);
            val res_offset: res[u64, fail.Fail] = member_offset(ctx, ty, k::u32);
            if (sel res_offset.err) { ret res[id.Constant, fail.Fail].err{res_offset.err}; }
            at = base + res_offset.ok;
        }
        val res_part: res[id.Constant, fail.Fail] = typed(ctx, image, part, at);
        if (sel res_part.err) { ret res_part; }
        val res_pushed: res[usize, A.Error] = collections_vector.push[id.Constant](?elements, res_part.ok);
        if (sel res_pushed.err) { ret res[id.Constant, fail.Fail].err{fail.refused(res_pushed.err)}; }
        k = k + 1;
    }
    ret made(ctx, ConstantData.aggregate{Aggregate{type: ty, elements: Slice[id.Constant]{data: elements.data, size: elements.len}}});
}

# the address placed at `offset`, none where none is
fun reloc_at(image: *Image, offset: u64) opt[Reloc] {
    var i: usize = 0;
    for (i < image.relocs.len) {
        if (image.relocs.data[i].offset == offset) { ret opt[Reloc].some{image.relocs.data[i]}; }
        i = i + 1;
    }
    ret opt[Reloc].none{};
}

# whether an address is placed in the `size` bytes from `base`
fun relocated(image: *Image, base: u64, size: u64) bool {
    var i: usize = 0;
    for (i < image.relocs.len) {
        val at: u64 = image.relocs.data[i].offset;
        if (at >= base && at < base + size) { ret true; }
        i = i + 1;
    }
    ret false;
}

# the image's addresses by offset: a literal names its fields in any order, and
# the byte runs between addresses are read from the lowest up
fun order_relocs(image: *Image) {
    var i: usize = 1;
    for (i < image.relocs.len) {
        val r: Reloc = image.relocs.data[i];
        var j: usize = i;
        for (j > 0 && image.relocs.data[j - 1].offset > r.offset) {
            image.relocs.data[j] = image.relocs.data[j - 1];
            j                    = j - 1;
        }
        image.relocs.data[j] = r;
        i                    = i + 1;
    }
}

# a byte run's array type and its constant
rec Pair {
    ty: Type;
    c:  id.Constant;
}

# append one member of a byte-run structure: its type, its offset and its constant
fun member_add(members: *collections_vector.Vector[Type], offsets: *collections_vector.Vector[u64], elements: *collections_vector.Vector[id.Constant],
    ty: Type, at: u64, c: id.Constant) err[fail.Fail] {
    val res_members_pushed: res[usize, A.Error] = collections_vector.push[Type](members, ty);
    if (sel res_members_pushed.err) { ret err[fail.Fail].err{fail.refused(res_members_pushed.err)}; }
    val res_offsets_pushed: res[usize, A.Error] = collections_vector.push[u64](offsets, at);
    if (sel res_offsets_pushed.err) { ret err[fail.Fail].err{fail.refused(res_offsets_pushed.err)}; }
    val res_elements_pushed: res[usize, A.Error] = collections_vector.push[id.Constant](elements, c);
    if (sel res_elements_pushed.err) { ret err[fail.Fail].err{fail.refused(res_elements_pushed.err)}; }
    ret err[fail.Fail].ok{};
}

# `len` bytes from `at` as a byte array constant
fun byte_run(ctx: *lower_context.LowerContext, blob: *u8, at: u64, len: u64) res[Pair, fail.Fail] {
    val res_i8t: res[Type, fail.Fail] = irt.int(?ctx.m.types, 8);
    if (sel res_i8t.err) { ret res[Pair, fail.Fail].err{res_i8t.err}; }
    val res_arr: res[Type, fail.Fail] = irt.array(?ctx.m.types, res_i8t.ok, len);
    if (sel res_arr.err) { ret res[Pair, fail.Fail].err{res_arr.err}; }
    if (all_zero((blob::usize + at::usize)::*u8, len)) {
        val res_made: res[id.Constant, fail.Fail] = made(ctx, ConstantData.zero{res_arr.ok});
        if (sel res_made.err) { ret res[Pair, fail.Fail].err{res_made.err}; }
        ret res[Pair, fail.Fail].ok{Pair{ty: res_arr.ok, c: res_made.ok}};
    }
    val res_run: res[id.Constant, fail.Fail] = made(ctx, ConstantData.bytes{Bytes{type: res_arr.ok, data: Slice[u8]{data: (blob::usize + at::usize)::*u8, size: len::usize}}});
    if (sel res_run.err) { ret res[Pair, fail.Fail].err{res_run.err}; }
    ret res[Pair, fail.Fail].ok{Pair{ty: res_arr.ok, c: res_run.ok}};
}

# bytes as a constant of their own: a byte array, which a string leaf and an embedded file are
pub fun bytes_constant(ctx: *lower_context.LowerContext, data: *u8, len: u64) res[value.Value, fail.Fail] {
    val res_run: res[Pair, fail.Fail] = byte_run(ctx, data, 0, len);
    if (sel res_run.err) { ret res[value.Value, fail.Fail].err{res_run.err}; }
    ret res[value.Value, fail.Fail].ok{value.constant(res_run.ok.c, res_run.ok.ty)};
}

# the constant `data` built in the module, or the failure mirl's builder kept
fun made(ctx: *lower_context.LowerContext, data: ConstantData) res[id.Constant, fail.Fail] {
    val c:       id.Constant    = mbuild.constant(?ctx.builder.mb, data);
    val err_why: err[fail.Fail] = lower_context.builder_state(ctx);
    if (sel err_why.err) { ret res[id.Constant, fail.Fail].err{err_why.err}; }
    ret res[id.Constant, fail.Fail].ok{c};
}

fun all_zero(blob: *u8, len: u64) bool {
    var i: u64 = 0;
    for (i < len) {
        if (blob[i] != 0) { ret false; }
        i = i + 1;
    }
    ret true;
}

# lay node `node` out as a value of `ity` at byte `base` of `image`, by its shape: an
# address, a tag, a record or union, an array or vector, or a scalar
fun place(ctx: *lower_context.LowerContext, store: *comptime_deep.Store, node: comptime_deep.Node, ity: Type, base: u64, image: *Image) err[fail.Fail] {
    val n: *comptime_deep.Shape = comptime_deep.shape_at(store, node);
    if (n.kind == comptime_deep.NODE_REFUSED)                                { ret err[fail.Fail].err{fail.message("lower: a constant value holds a leaf with no compile-time value")}; }
    if (n.kind == comptime_deep.NODE_ADDRESS)                                { ret place_address(ctx, store, node, base, image); }
    if (n.kind == comptime_deep.NODE_LITERAL && !intern.str_is_nil(n.head))  { ret place_tag(ctx, store, node, ity, base, image); }
    if (irt.is_struct(?ctx.m.types, ity) || irt.is_union(?ctx.m.types, ity)) { ret place_record(ctx, store, node, ity, base, image); }
    if (irt.is_array(?ctx.m.types, ity) || irt.is_vector(?ctx.m.types, ity)) { ret place_elements(ctx, store, node, ity, base, image); }
    ret place_scalar(ctx, store, node, ity, base, image);
}

# the field or case `name` declares on the semantic type `owner`, looked for from member `from`
# on and then from the first: a literal mostly names its fields in declaration order
fun member_index(ctx: *lower_context.LowerContext, owner: type_kind.TypeId, name: intern.StrId, from: u32) opt[u32] {
    val stripped: type_kind.TypeId = type.strip_secret(ctx.s.types, owner);
    val n:        u32              = type.field_count(ctx.s.types, stripped);
    var i:        u32              = from;
    var k:        u32              = 0;
    for (k < n) {
        if (i >= n) { i = 0; }
        val opt_field_at: opt[*type_field.Entry] = type.field_at(ctx.s.types, stripped, i);
        if (sel opt_field_at.some && intern.str_same(opt_field_at.some.name, name)) { ret opt[u32].some{i}; }
        i = i + 1;
        k = k + 1;
    }
    ret opt[u32].none{};
}

# the byte offset of member `i` of the structure or union `ity`
fun member_offset(ctx: *lower_context.LowerContext, ity: Type, i: u32) res[u64, fail.Fail] {
    if (irt.is_union(?ctx.m.types, ity)) { ret res[u64, fail.Fail].ok{0}; }
    ret irt.offset(?ctx.builder.layout, ity, i);
}

# a tag holds its case code in its discriminant and its payload in the area that holds it
fun place_tag(ctx: *lower_context.LowerContext, store: *comptime_deep.Store, node: comptime_deep.Node, ity: Type, base: u64, image: *Image) err[fail.Fail] {
    val n:           *comptime_deep.Shape = comptime_deep.shape_at(store, node);
    val opt_case_ix: opt[u32]             = member_index(ctx, n.ty, n.head, 0);
    if (sel opt_case_ix.none) { ret err[fail.Fail].err{fail.message("lower: a constant tag holds a case its type does not declare")}; }
    val disc:    Type                = irt.member(?ctx.m.types, ity, shape.TAG_DISCRIMINANT);
    val res_dsz: res[u64, fail.Fail] = size_of(ctx, disc);
    if (sel res_dsz.err) { ret err[fail.Fail].err{res_dsz.err}; }
    write_bits(image.blob, base, wide.from_u64(opt_case_ix.some::u64), res_dsz.ok);
    val opt_payload: opt[comptime_deep.Member] = comptime_deep.member_at(store, node, 0);
    if (sel opt_payload.none)                                             { ret err[fail.Fail].ok{}; }
    if (!lower_context.tag_case_has_payload(ctx, n.ty, opt_case_ix.some)) { ret err[fail.Fail].err{fail.message("lower: a constant tag holds a payload its case does not")}; }
    val res_carried: res[shape.Carried, fail.Fail] = lower_context.tag_carried(ctx, n.ty, opt_case_ix.some);
    if (sel res_carried.err) { ret err[fail.Fail].err{res_carried.err}; }
    val res_offset: res[u64, fail.Fail] = irt.offset(?ctx.builder.layout, ity, res_carried.ok.area);
    if (sel res_offset.err) { ret err[fail.Fail].err{res_offset.err}; }
    val area: Type = irt.member(?ctx.m.types, ity, res_carried.ok.area);
    val held: Type = irt.member(?ctx.m.types, area, res_carried.ok.member);
    ret place(ctx, store, opt_payload.some.node, held, base + res_offset.ok, image);
}

# a record's named fields at their offsets; a field the literal leaves out stays zero
fun place_record(ctx: *lower_context.LowerContext, store: *comptime_deep.Store, node: comptime_deep.Node, ity: Type, base: u64, image: *Image) err[fail.Fail] {
    val n: *comptime_deep.Shape = comptime_deep.shape_at(store, node);
    if (n.kind != comptime_deep.NODE_LITERAL) { ret err[fail.Fail].err{fail.message("lower: a constant record is no record literal")}; }
    val count: u32 = irt.member_count(?ctx.m.types, ity);
    var next:  u32 = 0;
    var i:     u32 = 0;
    for (i < n.len) {
        val m:            comptime_deep.Member = comptime_deep.member(store, node, i);
        val opt_field_ix: opt[u32]             = member_index(ctx, n.ty, m.name, next);
        var ix:           u32                  = count;
        if (sel opt_field_ix.some) { ix = opt_field_ix.some; }
        if (ix >= count)           { ret err[fail.Fail].err{fail.message("lower: a constant record names a field its type does not declare")}; }
        next = ix + 1;
        val res_foff: res[u64, fail.Fail] = member_offset(ctx, ity, ix);
        if (sel res_foff.err) { ret err[fail.Fail].err{res_foff.err}; }
        val err_placed: err[fail.Fail] = place(ctx, store, m.node, irt.member(?ctx.m.types, ity, ix), base + res_foff.ok, image);
        if (sel err_placed.err) { ret err_placed; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# the bytes from one element of the array or vector `ity` to the next: the array's stride as
# the layout states it, a vector's lane size
fun element_stride(ctx: *lower_context.LowerContext, ity: Type) res[u64, fail.Fail] {
    if (irt.is_vector(?ctx.m.types, ity)) { ret size_of(ctx, irt.element(?ctx.m.types, ity)); }
    ret irt.stride(?ctx.builder.layout, ity);
}

# an array's or a vector's elements at the element stride; an element the literal leaves out
# stays zero
fun place_elements(ctx: *lower_context.LowerContext, store: *comptime_deep.Store, node: comptime_deep.Node, ity: Type, base: u64, image: *Image) err[fail.Fail] {
    val n:     *comptime_deep.Shape = comptime_deep.shape_at(store, node);
    val ety:   Type                 = irt.element(?ctx.m.types, ity);
    var count: u64                  = irt.count(?ctx.m.types, ity);
    if (irt.is_vector(?ctx.m.types, ity)) { count = irt.lanes(?ctx.m.types, ity)::u64; }
    val res_stride: res[u64, fail.Fail] = element_stride(ctx, ity);
    if (sel res_stride.err) { ret err[fail.Fail].err{res_stride.err}; }
    var i: u32 = 0;
    for (i::u64 < count && i < n.len) {
        val err_placed: err[fail.Fail] = place(ctx, store, comptime_deep.member(store, node, i).node, ety, base + i::u64 * res_stride.ok, image);
        if (sel err_placed.err) { ret err_placed; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun place_scalar(ctx: *lower_context.LowerContext, store: *comptime_deep.Store, node: comptime_deep.Node, ity: Type, base: u64, image: *Image) err[fail.Fail] {
    if (comptime_deep.shape_at(store, node).kind != comptime_deep.NODE_SCALAR) { ret err[fail.Fail].err{fail.message("lower: a constant scalar is an aggregate")}; }
    val v:        comptime_value.CTValue = comptime_deep.scalar(store, node);
    val res_size: res[u64, fail.Fail]    = size_of(ctx, ity);
    if (sel res_size.err)                     { ret err[fail.Fail].err{res_size.err}; }
    if (v.kind == comptime_value.CT_KIND_STR) { ret place_string(ctx, v.data.s, base, image); }
    if (res_size.ok == 0 || res_size.ok > 16) { ret err[fail.Fail].err{fail.message("lower: a constant scalar has an unsupported size")}; }
    if (v.kind == comptime_value.CT_KIND_INT) {
        write_bits(image.blob, base, v.data.w, res_size.ok);
        ret err[fail.Fail].ok{};
    }
    if (v.kind == comptime_value.CT_KIND_FLOAT) {
        var bits: u64 = 0;
        if (res_size.ok == 8) { bits = float.f64_bits(v.data.f); }
        or (res_size.ok == 4) { bits = float.f64_to_f32_bits(float.f64_bits(v.data.f))::u64; }
        or (res_size.ok == 2) { bits = float.bits_at(v.data.f, float.FLOAT_W_16); }
        or                    { ret err[fail.Fail].err{fail.message("lower: a constant float has an unsupported width")}; }
        write_bits(image.blob, base, wide.from_u64(bits), res_size.ok);
        ret err[fail.Fail].ok{};
    }
    ret err[fail.Fail].err{fail.message("lower: a constant leaf holds no runtime value")};
}

# a string leaf points at its bytes, which become a global of their own
fun place_string(ctx: *lower_context.LowerContext, text: intern.StrId, base: u64, image: *Image) err[fail.Fail] {
    val res_added: res[value.Value, fail.Fail] = string_global(ctx, text);
    if (sel res_added.err) { ret err[fail.Fail].err{res_added.err}; }
    ret reloc_add(image, Reloc{offset: base, symbol: id.Symbol.global{res_added.ok.index}, addend: 0});
}

# the read-only global holding an interned string's bytes, NULs included, and the terminator
# the interner keeps after them; its address is the value. the bytes are never written, so
# every use of one text in a module shares one global
pub fun string_global(ctx: *lower_context.LowerContext, text: intern.StrId) res[value.Value, fail.Fail] {
    val opt_known: opt[*value.Value] = map.get[intern.StrId, value.Value](?ctx.strings, ?text);
    if (sel opt_known.some) { ret res[value.Value, fail.Fail].ok{@opt_known.some}; }
    val opt_bytes: opt[View] = intern.bytes(ctx.s.interner, text);
    if (sel opt_bytes.none) { ret res[value.Value, fail.Fail].err{fail.message("lower: a constant string is not interned")}; }
    val res_bytes: res[value.Value, fail.Fail] = bytes_constant(ctx, opt_bytes.some.data::*u8, (opt_bytes.some.len + 1)::u64);
    if (sel res_bytes.err) { ret res_bytes; }
    val res_constant_global: res[value.Value, fail.Fail] = lower_context.constant_global(ctx, res_bytes.ok);
    if (sel res_constant_global.err) { ret res_constant_global; }
    val res_kept: res[bool, A.Error] = map.insert[intern.StrId, value.Value](?ctx.strings, text, res_constant_global.ok);
    if (sel res_kept.err) { ret res[value.Value, fail.Fail].err{fail.refused(res_kept.err)}; }
    ret res_constant_global;
}

# an address is a relocation against the symbol it points into, offset to the place its field
# and element steps reach
fun place_address(ctx: *lower_context.LowerContext, store: *comptime_deep.Store, node: comptime_deep.Node, base: u64, image: *Image) err[fail.Fail] {
    val n:   *comptime_deep.Shape = comptime_deep.shape_at(store, node);
    val mid: module.ModuleId      = module.module_id_for_stable(?ctx.s.modules, module.stable_id(n.symbol.module));
    if (module.is_nil(mid)) { ret err[fail.Fail].err{fail.message("lower: a constant address names a module the session has not loaded")}; }
    val res_name: res[intern.StrId, fail.Fail] = mangle.declaration_linkage_name(ctx.linkage, ctx.s, mid, n.symbol.canon, n.symbol.decl);
    if (sel res_name.err) { ret err[fail.Fail].err{res_name.err}; }
    var target: id.Symbol = id.Symbol.global{0};
    if (n.symbol.function) {
        val res_sig: res[lower_context.FnSig, fail.Fail] = lower_context.fn_sig_of_type(ctx, n.ty);
        if (sel res_sig.err) { ret err[fail.Fail].err{res_sig.err}; }
        val res_timed: res[ConstantTime, fail.Fail] = lower_context.mode_of(ctx, mid, n.symbol.decl);
        if (sel res_timed.err) { ret err[fail.Fail].err{res_timed.err}; }
        val res_ensure_extern_function: res[u32, fail.Fail] = lower_context.ensure_extern_function(ctx, res_name.ok, res_sig.ok, lower_context.external_linkage(), res_timed.ok);
        if (sel res_ensure_extern_function.err) { ret err[fail.Fail].err{res_ensure_extern_function.err}; }
        target = id.Symbol.function{res_ensure_extern_function.ok};
    }
    or {
        val res_ensure_extern_global: res[u32, fail.Fail] = lower_context.ensure_extern_global(ctx, res_name.ok, lower_context.byte_type(ctx), opt[mirl_global.Tls].none{}, type_kind.TYPE_NIL, lower_context.external_linkage(), false);
        if (sel res_ensure_extern_global.err) { ret err[fail.Fail].err{res_ensure_extern_global.err}; }
        target = id.Symbol.global{res_ensure_extern_global.ok};
    }
    var addend: i64 = 0;
    var i:      u32 = 0;
    for (i < n.len) {
        val m:           comptime_deep.Member = comptime_deep.member(store, node, i);
        val step:        *comptime_deep.Shape = comptime_deep.shape_at(store, m.node);
        val opt_ordinal: opt[u64]             = comptime_value.ct_int_u64(comptime_deep.scalar(store, m.node));
        if (sel opt_ordinal.none) { ret err[fail.Fail].err{fail.message("lower: a constant address step holds no ordinal")}; }
        val res_owner: res[Type, fail.Fail] = lower_context.lower_type(ctx, step.ty);
        if (sel res_owner.err) { ret err[fail.Fail].err{res_owner.err}; }
        if (!intern.str_is_nil(m.name)) {
            val res_off: res[u64, fail.Fail] = member_offset(ctx, res_owner.ok, opt_ordinal.some::u32);
            if (sel res_off.err) { ret err[fail.Fail].err{res_off.err}; }
            addend = addend + res_off.ok::i64;
        }
        or {
            val res_stride: res[u64, fail.Fail] = element_stride(ctx, res_owner.ok);
            if (sel res_stride.err) { ret err[fail.Fail].err{res_stride.err}; }
            addend = addend + opt_ordinal.some::i64 * res_stride.ok::i64;
        }
        i = i + 1;
    }
    ret reloc_add(image, Reloc{offset: base, symbol: target, addend: addend});
}

fun reloc_add(image: *Image, r: Reloc) err[fail.Fail] {
    val res_pushed: res[usize, A.Error] = collections_vector.push[Reloc](?image.relocs, r);
    if (sel res_pushed.err) { ret err[fail.Fail].err{fail.refused(res_pushed.err)}; }
    ret err[fail.Fail].ok{};
}

# little-endian bytes of a constant: the low limb first, then the high limb
# once the leaf is wider than 8 bytes
fun write_bits(blob: *u8, base: u64, bits: wide.Wide, size: u64) {
    var i: u64 = 0;
    for (i < size) {
        blob[base + i] = wide.shr_u(bits, (i * 8)::u32).lo::u8;
        i              = i + 1;
    }
}
