# the mirl types lowering builds: interned in the module's type table, laid out by the
# target's data layout and never by mach
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.view.View;

use std.collections.slice.Slice;

use types_calling: mirl.ir.type.calling;
use types_format:  mirl.ir.type.format;
use types:         mirl.ir.type.table;
use mirl.ir.type.table.Type;
use mirl_layout: mirl.target.layout;
use mirl_record: mirl.target.record;

use diagnostic_kind: mach.base.diagnostic.kind;
use mach.base.fail;
use type_shape: mach.type.shape;

# no type: what a function that gives nothing returns
pub val NONE: Type = 0xFFFFFFFF;

pub fun is_none(t: Type) bool {
    ret t == NONE;
}

pub fun same(a: Type, b: Type) bool {
    ret a == b;
}

fun refused(e: types.Error) fail.Fail {
    if (sel e.alloc)    { ret fail.refused(e.alloc); }
    if (sel e.width)    { ret fail.message("lower: mirl's type table refused an integer width"); }
    if (sel e.extended) { ret fail.message("lower: mirl's type table refused an extension on a type that is not an integer"); }
    ret fail.message("lower: mirl's type table refused a type lowering built");
}

fun interned(t: *types.Table, s: types.Shape) res[Type, fail.Fail] {
    val res_intern: res[Type, types.Error] = types.intern(t, s);
    if (sel res_intern.err) { ret res[Type, fail.Fail].err{refused(res_intern.err)}; }
    ret res[Type, fail.Fail].ok{res_intern.ok};
}

# a signless integer of `bits`, rounded up to a width mirl holds
pub fun int(t: *types.Table, bits: u32) res[Type, fail.Fail] {
    val res_made: res[Type, type_shape.Unshaped] = type_shape.integer(t, bits);
    if (sel res_made.err) { ret res[Type, fail.Fail].err{fail.message("lower: mirl's type table refused an integer width")}; }
    ret res[Type, fail.Fail].ok{res_made.ok};
}

pub fun float(t: *types.Table, bits: u32) res[Type, fail.Fail] {
    val opt_format: opt[types_format.Format] = type_shape.format(bits);
    if (sel opt_format.none) { ret res[Type, fail.Fail].err{fail.message("lower: a float width mirl has no format for")}; }
    ret interned(t, types.Shape.float{types.Float{format: opt_format.some}});
}

pub fun ptr(t: *types.Table) res[Type, fail.Fail] {
    ret interned(t, types.Shape.pointer{types.Pointer{space: types.DEFAULT_SPACE}});
}

pub fun ptr_in(t: *types.Table, space: u32) res[Type, fail.Fail] {
    ret interned(t, types.Shape.pointer{types.Pointer{space: space}});
}

pub fun vector(t: *types.Table, element: Type, lanes: u32) res[Type, fail.Fail] {
    ret interned(t, types.Shape.vector{types.Vector{lanes: lanes, element: element}});
}

pub fun array(t: *types.Table, element: Type, count: u64) res[Type, fail.Fail] {
    ret interned(t, types.Shape.array{types.Array{count: count, element: element, stride: opt[u64].none{}}});
}

# a structure whose members stand at the offsets mach states, as a constant's byte runs do
pub fun structure_at(t: *types.Table, members: *Type, offsets: *u64, n: u32) res[Type, fail.Fail] {
    ret interned(t, types.Shape.structure{types.Structure{members: Slice[Type]{data: members, size: n::usize}, offsets: opt[Slice[u64]].some{Slice[u64]{data: offsets, size: n::usize}}, align: opt[u64].none{}, packed: false}});
}

# a signature: its parameters and results, each narrow integer with its extension
pub fun signature(t: *types.Table, params: *Type, param_ext: *types.Extension, pn: u32, results: *Type, result_ext: *types.Extension, rn: u32) res[Type, fail.Fail] {
    var f: types.Function;
    f.params     = Slice[Type]{data: params, size: pn::usize};
    f.results    = Slice[Type]{data: results, size: rn::usize};
    f.param_ext  = Slice[types.Extension]{data: param_ext, size: pn::usize};
    f.result_ext = Slice[types.Extension]{data: result_ext, size: rn::usize};
    f.convention = opt[types_calling.Calling].none{};
    if (pn == 0) { f.param_ext = Slice[types.Extension]{data: nil, size: 0}; }
    if (rn == 0) { f.result_ext = Slice[types.Extension]{data: nil, size: 0}; }
    ret interned(t, types.Shape.function{f});
}

# the signature `sig` with its `n` parameters of the types at `params`, its results,
# extensions and convention kept
pub fun restated(t: *types.Table, sig: Type, params: *Type, n: u32) res[Type, fail.Fail] {
    val opt_shape: opt[*types.Shape] = shape(t, sig);
    if (sel opt_shape.some) {
        val k: *types.Shape = opt_shape.some;
        if (sel k.function) {
            var f: types.Function = k.function;
            if (f.params.size != n::usize) { ret res[Type, fail.Fail].err{fail.message("lower: a signature restated at another parameter count")}; }
            f.params = Slice[Type]{data: params, size: n::usize};
            ret interned(t, types.Shape.function{f});
        }
    }
    ret res[Type, fail.Fail].err{fail.message("lower: a signature restated of a type that is no function")};
}

# the signature `sig` taking unnamed arguments after its parameters, as a C function
# declared with `...` does
pub fun variadic(t: *types.Table, sig: Type) res[Type, fail.Fail] {
    val opt_shape: opt[*types.Shape] = shape(t, sig);
    if (sel opt_shape.some) {
        val k: *types.Shape = opt_shape.some;
        if (sel k.function) {
            var f: types.Function = k.function;
            f.variadic = true;
            ret interned(t, types.Shape.function{f});
        }
    }
    ret res[Type, fail.Fail].err{fail.message("lower: a variadic signature made of a type that is no function")};
}

# the shape of `ty` as the table holds it, valid until the table next interns a type
pub fun shape(t: *types.Table, ty: Type) opt[*types.Shape] {
    if (is_none(ty)) { ret opt[*types.Shape].none{}; }
    val res_shape_at: res[*types.Shape, types.Error] = types.shape_at(t, ty);
    if (sel res_shape_at.err) { ret opt[*types.Shape].none{}; }
    ret opt[*types.Shape].some{res_shape_at.ok};
}

pub fun is_int(t: *types.Table, ty: Type) bool {
    val opt_shape: opt[*types.Shape] = shape(t, ty);
    ret sel opt_shape.some && sel opt_shape.some.integer;
}

# an integer's width, 0 for any other type
pub fun int_width(t: *types.Table, ty: Type) u32 {
    val opt_shape: opt[*types.Shape] = shape(t, ty);
    if (sel opt_shape.some) {
        if (sel opt_shape.some.integer) { ret opt_shape.some.integer.width; }
    }
    ret 0;
}

pub fun is_float(t: *types.Table, ty: Type) bool {
    val opt_shape: opt[*types.Shape] = shape(t, ty);
    ret sel opt_shape.some && sel opt_shape.some.float;
}

# a float's width, 0 for any other type
pub fun float_width(t: *types.Table, ty: Type) u32 {
    val opt_shape: opt[*types.Shape] = shape(t, ty);
    if (sel opt_shape.some) {
        if (sel opt_shape.some.float) {
            val opt_row: opt[types_format.Row] = types_format.row(opt_shape.some.float.format);
            if (sel opt_row.some) { ret opt_row.some.width; }
        }
    }
    ret 0;
}

# the address space a pointer type points into, the default space for any other type
pub fun space_of(t: *types.Table, ty: Type) u32 {
    val opt_shape: opt[*types.Shape] = shape(t, ty);
    if (sel opt_shape.some) {
        val k: *types.Shape = opt_shape.some;
        if (sel k.pointer) { ret k.pointer.space; }
    }
    ret types.DEFAULT_SPACE;
}

pub fun is_ptr(t: *types.Table, ty: Type) bool {
    val opt_shape: opt[*types.Shape] = shape(t, ty);
    ret sel opt_shape.some && sel opt_shape.some.pointer;
}

pub fun is_vector(t: *types.Table, ty: Type) bool {
    val opt_shape: opt[*types.Shape] = shape(t, ty);
    ret sel opt_shape.some && sel opt_shape.some.vector;
}

pub fun is_function(t: *types.Table, ty: Type) bool {
    val opt_shape: opt[*types.Shape] = shape(t, ty);
    ret sel opt_shape.some && sel opt_shape.some.function;
}

pub fun is_handle(t: *types.Table, ty: Type) bool {
    val opt_shape: opt[*types.Shape] = shape(t, ty);
    ret sel opt_shape.some && sel opt_shape.some.handle;
}

# the handle of the kind `kind`, as its family mints it, made of the `n` operands at `operands`
pub fun handle(t: *types.Table, kind: View, operands: *types.HandleOperand, n: u32) res[Type, fail.Fail] {
    ret interned(t, types.Shape.handle{types.Handle{kind: kind, operands: Slice[types.HandleOperand]{data: operands, size: n::usize}}});
}

# whether `ty` is a handle of the kind `kind`
pub fun handle_of(t: *types.Table, ty: Type, kind: View) bool {
    val opt_shape: opt[*types.Shape] = shape(t, ty);
    if (sel opt_shape.none) { ret false; }
    val got: *types.Shape = opt_shape.some;
    if (!(sel got.handle)) { ret false; }
    val held: View = got.handle.kind;
    if (held.len != kind.len) { ret false; }
    var i: usize = 0;
    for (i < kind.len) {
        if (held.data[i] != kind.data[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

pub fun is_struct(t: *types.Table, ty: Type) bool {
    val opt_shape: opt[*types.Shape] = shape(t, ty);
    ret sel opt_shape.some && sel opt_shape.some.structure;
}

pub fun is_array(t: *types.Table, ty: Type) bool {
    val opt_shape: opt[*types.Shape] = shape(t, ty);
    ret sel opt_shape.some && sel opt_shape.some.array;
}

pub fun is_union(t: *types.Table, ty: Type) bool {
    val opt_shape: opt[*types.Shape] = shape(t, ty);
    ret sel opt_shape.some && sel opt_shape.some.union;
}

# a structure, union or array: what lowering holds in storage and passes by its address
pub fun is_aggregate(t: *types.Table, ty: Type) bool {
    val opt_shape: opt[*types.Shape] = shape(t, ty);
    if (sel opt_shape.none) { ret false; }
    ret sel opt_shape.some.structure || sel opt_shape.some.union || sel opt_shape.some.array;
}

# a float or a vector of floats
pub fun is_float_like(t: *types.Table, ty: Type) bool {
    val opt_shape: opt[*types.Shape] = shape(t, ty);
    if (sel opt_shape.none)        { ret false; }
    if (sel opt_shape.some.float)  { ret true; }
    if (sel opt_shape.some.vector) { ret is_float(t, opt_shape.some.vector.element); }
    ret false;
}

# a pointer or a vector of pointers
pub fun is_ptr_like(t: *types.Table, ty: Type) bool {
    val opt_shape: opt[*types.Shape] = shape(t, ty);
    if (sel opt_shape.none)         { ret false; }
    if (sel opt_shape.some.pointer) { ret true; }
    if (sel opt_shape.some.vector)  { ret is_ptr(t, opt_shape.some.vector.element); }
    ret false;
}

# a vector's lane count, 0 for any other type
pub fun lanes(t: *types.Table, ty: Type) u32 {
    val opt_shape: opt[*types.Shape] = shape(t, ty);
    if (sel opt_shape.some) {
        if (sel opt_shape.some.vector) { ret opt_shape.some.vector.lanes; }
    }
    ret 0;
}

# the element of a vector or an array, the type itself for a scalar
pub fun element(t: *types.Table, ty: Type) Type {
    val opt_shape: opt[*types.Shape] = shape(t, ty);
    if (sel opt_shape.some) {
        if (sel opt_shape.some.vector) { ret opt_shape.some.vector.element; }
        if (sel opt_shape.some.array)  { ret opt_shape.some.array.element; }
    }
    ret ty;
}

# an array's element count, 0 for any other type
pub fun count(t: *types.Table, ty: Type) u64 {
    val opt_shape: opt[*types.Shape] = shape(t, ty);
    if (sel opt_shape.some) {
        if (sel opt_shape.some.array) { ret opt_shape.some.array.count; }
    }
    ret 0;
}

# a structure's or union's member count, 0 for any other type
pub fun member_count(t: *types.Table, ty: Type) u32 {
    val opt_shape: opt[*types.Shape] = shape(t, ty);
    if (sel opt_shape.some) {
        if (sel opt_shape.some.structure) { ret opt_shape.some.structure.members.size::u32; }
        if (sel opt_shape.some.union)     { ret opt_shape.some.union.members.size::u32; }
    }
    ret 0;
}

# member `i` of a structure or union, an array's element, NONE past the members
pub fun member(t: *types.Table, ty: Type, i: u32) Type {
    val opt_shape: opt[*types.Shape] = shape(t, ty);
    if (sel opt_shape.some) {
        if (sel opt_shape.some.structure) {
            if (i::usize < opt_shape.some.structure.members.size) { ret opt_shape.some.structure.members.data[i]; }
        }
        if (sel opt_shape.some.union) {
            if (i::usize < opt_shape.some.union.members.size) { ret opt_shape.some.union.members.data[i]; }
        }
        if (sel opt_shape.some.array) { ret opt_shape.some.array.element; }
    }
    ret NONE;
}

# a signature's first result, NONE when it gives none
pub fun result_of(t: *types.Table, sig: Type) Type {
    val opt_shape: opt[*types.Shape] = shape(t, sig);
    if (sel opt_shape.some) {
        if (sel opt_shape.some.function) {
            if (opt_shape.some.function.results.size > 0) { ret opt_shape.some.function.results.data[0]; }
        }
    }
    ret NONE;
}

# a signature's parameter count
pub fun param_count(t: *types.Table, sig: Type) u32 {
    val opt_shape: opt[*types.Shape] = shape(t, sig);
    if (sel opt_shape.some) {
        if (sel opt_shape.some.function) { ret opt_shape.some.function.params.size::u32; }
    }
    ret 0;
}

# whether a signature takes a pointer
pub fun takes_pointer(t: *types.Table, sig: Type) bool {
    var i: u32 = 0;
    for (i < param_count(t, sig)) {
        if (is_ptr(t, param_of(t, sig, i))) { ret true; }
        i = i + 1;
    }
    ret false;
}

# parameter `i` of a signature, NONE past them
pub fun param_of(t: *types.Table, sig: Type, i: u32) Type {
    val opt_shape: opt[*types.Shape] = shape(t, sig);
    if (sel opt_shape.some) {
        if (sel opt_shape.some.function) {
            if (i::usize < opt_shape.some.function.params.size) { ret opt_shape.some.function.params.data[i]; }
        }
    }
    ret NONE;
}

# why the target's data layout gave no extent to a type lowering built, by mirl's refusal
fun laid(e: mirl_record.Error) fail.Fail {
    if (sel e.space)   { ret fail.message("lower: the target's data layout has no row for the address space of a pointer lowering built"); }
    if (sel e.unsized) { ret fail.message("lower: the target's data layout gives a type lowering built no representation in memory"); }
    # a logical pointer names memory and has no address, so it cannot sit in memory or in an
    # aggregate: the program's, refused where the expression needs its layout
    if (sel e.unmodelled) { ret fail.user(diagnostic_kind.SPIRV_UNSUPPORTED, "a pointer cannot be held in memory or in an aggregate here: under logical addressing a pointer names memory and has no address to store"); }
    if (sel e.ruled)      { ret fail.message("lower: the rules of the address space a type lowering built is asked in do not lay it out"); }
    if (sel e.stride)     { ret fail.message("lower: an array lowering built states a stride its alignment does not divide"); }
    if (sel e.overflow)   { ret fail.message("lower: a type lowering built is larger than 64 bits of bytes"); }
    if (sel e.unstated)   { ret fail.message("lower: the target leaves a fact of its data layout unstated"); }
    if (sel e.types)      { ret fail.message("lower: the type table refused a read of a type lowering built"); }
    ret fail.message("lower: the target's data layout gives no extent to a type lowering built");
}

# the size in bytes the target's data layout gives `ty`
pub fun size(l: *mirl_layout.Layout, ty: Type) res[u64, fail.Fail] {
    val res_size: res[u64, mirl_record.Error] = mirl_layout.size(l, ty, types.DEFAULT_SPACE);
    if (sel res_size.err) { ret res[u64, fail.Fail].err{laid(res_size.err)}; }
    ret res[u64, fail.Fail].ok{res_size.ok};
}

# the alignment in bytes the target's data layout gives `ty`
pub fun align(l: *mirl_layout.Layout, ty: Type) res[u64, fail.Fail] {
    val res_align: res[u64, mirl_record.Error] = mirl_layout.align(l, ty, types.DEFAULT_SPACE);
    if (sel res_align.err) { ret res[u64, fail.Fail].err{laid(res_align.err)}; }
    ret res[u64, fail.Fail].ok{res_align.ok};
}

# the byte offset of member `i` of a structure or union
pub fun offset(l: *mirl_layout.Layout, ty: Type, i: u32) res[u64, fail.Fail] {
    val res_offset: res[u64, mirl_record.Error] = mirl_layout.offset(l, ty, types.DEFAULT_SPACE, i);
    if (sel res_offset.err) { ret res[u64, fail.Fail].err{laid(res_offset.err)}; }
    ret res[u64, fail.Fail].ok{res_offset.ok};
}

# the bytes from one element of the array `ty` to the next
pub fun stride(l: *mirl_layout.Layout, ty: Type) res[u64, fail.Fail] {
    val res_stride: res[u64, mirl_record.Error] = mirl_layout.stride(l, ty, types.DEFAULT_SPACE);
    if (sel res_stride.err) { ret res[u64, fail.Fail].err{laid(res_stride.err)}; }
    ret res[u64, fail.Fail].ok{res_stride.ok};
}

# whether `ty` lays out a byte no member or element of it covers: a gap between a
# structure's members or after its last, a union member shorter than the union, or such a
# byte inside any member or element
pub fun padded(l: *mirl_layout.Layout, t: *types.Table, ty: Type) res[bool, fail.Fail] {
    if (is_array(t, ty)) {
        if (count(t, ty) == 0) { ret res[bool, fail.Fail].ok{false}; }
        val e:        Type                = element(t, ty);
        val res_step: res[u64, fail.Fail] = stride(l, ty);
        if (sel res_step.err) { ret res[bool, fail.Fail].err{res_step.err}; }
        val res_held: res[u64, fail.Fail] = size(l, e);
        if (sel res_held.err)           { ret res[bool, fail.Fail].err{res_held.err}; }
        if (res_step.ok != res_held.ok) { ret res[bool, fail.Fail].ok{true}; }
        ret padded(l, t, e);
    }
    if (!is_struct(t, ty) && !is_union(t, ty)) { ret res[bool, fail.Fail].ok{false}; }
    val res_whole: res[u64, fail.Fail] = size(l, ty);
    if (sel res_whole.err) { ret res[bool, fail.Fail].err{res_whole.err}; }
    val overlaid: bool = is_union(t, ty);
    val n:        u32  = member_count(t, ty);
    var at:       u64  = 0;
    var i:        u32  = 0;
    for (i < n) {
        val m:        Type                = member(t, ty, i);
        val res_held: res[u64, fail.Fail] = size(l, m);
        if (sel res_held.err) { ret res[bool, fail.Fail].err{res_held.err}; }
        if (overlaid) {
            if (res_held.ok != res_whole.ok) { ret res[bool, fail.Fail].ok{true}; }
        }
        or {
            val res_off: res[u64, fail.Fail] = offset(l, ty, i);
            if (sel res_off.err)  { ret res[bool, fail.Fail].err{res_off.err}; }
            if (res_off.ok != at) { ret res[bool, fail.Fail].ok{true}; }
            at = res_off.ok + res_held.ok;
        }
        val res_inner: res[bool, fail.Fail] = padded(l, t, m);
        if (sel res_inner.err) { ret res_inner; }
        if (res_inner.ok)      { ret res_inner; }
        i = i + 1;
    }
    ret res[bool, fail.Fail].ok{!overlaid && at != res_whole.ok};
}
