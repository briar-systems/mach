# a value lowering holds: a mirl value of the function being built, or a constant, a
# function or a global the builder makes a value of where an instruction uses it. a
# value of an aggregate type is the address of storage holding it, typed as the aggregate,
# or, where it is `whole`, a mirl value of the aggregate itself with no storage
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;

use mirl.ir.id;
use types: mirl.ir.type.table;
use mirl.ir.type.table.Type;

use mach.base.float;
use mach.base.wide;
use mach.lower.irt;

pub def ValueKind: u8;

# none:   no value, what a call of a function that gives nothing yields
# ssa:    a mirl value of the function being built
# int:    an integer constant, its bits in `bits`
# float:  a float constant, the bits of its binary64 encoding in `bits`
# null:   every bit zero
# fn:     function `index` of the module, called by name or taken as an address
# global: the address of global `index` of the module
# const:  constant `index` of the module, a scalar or an aggregate laid out as its type
pub val VAL_NONE:   ValueKind = 0;
pub val VAL_SSA:    ValueKind = 1;
pub val VAL_INT:    ValueKind = 2;
pub val VAL_FLOAT:  ValueKind = 3;
pub val VAL_NULL:   ValueKind = 4;
pub val VAL_FN:     ValueKind = 5;
pub val VAL_GLOBAL: ValueKind = 6;
pub val VAL_CONST:  ValueKind = 7;

# space: the address space of the storage an address points into, which a value retyped
#        as its aggregate keeps
# held:  what a stack slot was made to hold, none for any other value
# whole: an aggregate held as a mirl value of its own type, which has no address
# align: the alignment an address is known to have, which a part of a packed aggregate holds below
#        its own type's, 0 where nothing is known past what its pointee's type states
pub rec Value {
    kind:   ValueKind;
    ty:     Type;
    secret: bool;
    id:     id.Value;
    bits:   wide.Wide;
    index:  u32;
    # the signature a function is called through
    sig:   Type;
    space: u32;
    held:  Type;
    # the i1 a bool byte was widened from, which a branch or a select reads in its place
    truth:  id.Value;
    truthy: bool;
    whole:  bool;
    align:  u64;
}

# no value, what a call of a function that gives nothing yields
# ---
# ret: a value of kind VAL_NONE typed NONE, every other field at its empty state
pub fun none() Value {
    var v: Value;
    v.kind   = VAL_NONE;
    v.ty     = irt.NONE;
    v.secret = false;
    v.id     = 0xFFFFFFFF;
    v.bits   = wide.zero();
    v.index  = 0;
    v.sig    = irt.NONE;
    v.space  = types.DEFAULT_SPACE;
    v.held   = irt.NONE;
    v.truth  = 0xFFFFFFFF;
    v.truthy = false;
    v.whole  = false;
    ret v;
}

# the mirl value `at` of the function being built
# ---
# at:     the mirl value id
# ty:     its mirl type
# secret: whether the value is secret
# ret:    a value of kind VAL_SSA
pub fun ssa(at: id.Value, ty: Type, secret: bool) Value {
    var v: Value = none();
    v.kind   = VAL_SSA;
    v.ty     = ty;
    v.secret = secret;
    v.id     = at;
    ret v;
}

# the aggregate mirl value `at` of `ty`, held whole with no storage
pub fun whole(at: id.Value, ty: Type, secret: bool) Value {
    var v: Value = ssa(at, ty, secret);
    v.whole = true;
    ret v;
}

# the aggregate of `ty` every byte of which is zero, held whole
pub fun zero_whole(ty: Type) Value {
    var v: Value = const_null(ty);
    v.whole = true;
    ret v;
}

# an integer constant of up to 64 bits
# ---
# bits: the constant's bits, of which a narrower type reads the low ones
# ty:   its mirl type
# ret:  a value of kind VAL_INT
pub fun const_int(bits: u64, ty: Type) Value {
    ret const_int_wide(wide.from_u64(bits), ty);
}

# a constant up to 128 bits wide; a narrower type reads its low bits
pub fun const_int_wide(bits: wide.Wide, ty: Type) Value {
    var v: Value = none();
    v.kind = VAL_INT;
    v.ty   = ty;
    v.bits = bits;
    ret v;
}

# a float constant, held as the bits of its binary64 encoding
# ---
# f:   the constant's value
# ty:  its mirl type, which may be narrower than binary64
# ret: a value of kind VAL_FLOAT
pub fun const_float(f: f64, ty: Type) Value {
    var v: Value = none();
    v.kind = VAL_FLOAT;
    v.ty   = ty;
    v.bits = wide.from_u64(float.f64_bits(f));
    ret v;
}

# the value of `ty` every bit of which is zero
# ---
# ty:  its mirl type
# ret: a value of kind VAL_NULL
pub fun const_null(ty: Type) Value {
    var v: Value = none();
    v.kind = VAL_NULL;
    v.ty   = ty;
    ret v;
}

# function `index`, an address of `ptr` called through `sig`
pub fun fn(index: u32, ptr: Type, sig: Type) Value {
    var v: Value = none();
    v.kind  = VAL_FN;
    v.ty    = ptr;
    v.index = index;
    v.sig   = sig;
    ret v;
}

# the address of global `index`, of `ty`, into storage of `space`
pub fun global(index: u32, ty: Type, space: u32) Value {
    var v: Value = none();
    v.kind  = VAL_GLOBAL;
    v.ty    = ty;
    v.index = index;
    v.space = space;
    ret v;
}

# constant `c` of the module
# ---
# c:   the module's constant id
# ty:  the constant's mirl type
# ret: a value of kind VAL_CONST
pub fun constant(c: id.Constant, ty: Type) Value {
    var v: Value = none();
    v.kind  = VAL_CONST;
    v.ty    = ty;
    v.index = c;
    ret v;
}

# `v` with its type replaced by `ty`, dropping the bool byte's widened i1
# ---
# v:   the value to retype
# ty:  the new mirl type
# ret: a copy of `v` typed `ty` with `truthy` cleared
pub fun retype(v: Value, ty: Type) Value {
    var copy: Value = v;
    copy.ty     = ty;
    copy.truthy = false;
    ret copy;
}

# whether `v` is no value
# ---
# v:   the value to test
# ret: true for kind VAL_NONE
pub fun is_none(v: Value) bool {
    ret v.kind == VAL_NONE;
}

# an integer constant's low 64 bits
pub fun int_lit(v: Value) u64 {
    ret v.bits.lo;
}

# whether `v` is an integer constant
# ---
# v:   the value to test
# ret: true for kind VAL_INT
pub fun is_int_const(v: Value) bool {
    ret v.kind == VAL_INT;
}

# whether `v` is a constant: an integer, a float, every bit zero, or a module constant
# ---
# v:   the value to test
# ret: true for kind VAL_INT, VAL_FLOAT, VAL_NULL or VAL_CONST
pub fun is_constant(v: Value) bool {
    ret v.kind == VAL_INT || v.kind == VAL_FLOAT || v.kind == VAL_NULL || v.kind == VAL_CONST;
}

# a float constant's value
pub fun float_lit(v: Value) f64 {
    ret v.bits.lo:~f64;
}
