# an `#[intrinsic("mirl", "ir", name)]` declaration held to its operation's row
#
# the declaration states the row whole: one parameter per fixed operand, in the row's order,
# and the row's result as its return type. mirl's checker types the row over the parameters'
# types, so what the operation takes and gives is the row's alone, never a list here. each
# break is refused where the function is declared, the count with `op.operand_count` and any
# other with `op.signature`, whether or not anything calls it
use std.types.bool.bool;
use std.types.bool.false;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;
use std.collections.slice.Slice;
use std.collections.vector;

use mach.base.diagnostic;
use diagnostic_kind: mach.base.diagnostic.kind;
use mach.base.fail;
use base_source: mach.base.source;
use mach.front.sema.typename;
use mach.lower.builder;
use lower_context: mach.lower.context;
use mach.type;
use type_kind:  mach.type.kind;
use mirl_check: mirl.ir.opcode.check;
use opcode_row: mirl.ir.opcode.row;
use mirl.ir.opcode.row.Opcode;
use mirl.ir.opcode.rule.Class;
use mirl.ir.opcode.rule.Pair;
use mirl.ir.opcode.rule.Subject;
use opcode_table: mirl.ir.opcode.table;
use mirl.ir.type.table.Type;

# the declaration a row is held against: its parameters' source and lowered types and its result
# ---
# name:    the operation's name
# params:  the first parameter's index in the type table's parameter pool
# count:   how many parameters
# result:  the source result type, nil for none
# lowered: each parameter's type in mirl, `count` of them
rec Declaration {
    name:    str;
    params:  u32;
    count:   u32;
    result:  type_kind.TypeId;
    lowered: *Type;
}

# the declaration of the operation `code`, of function type `fn`, held to the operation's row
# at `span`
pub fun declared(ctx: *lower_context.LowerContext, span: base_source.Span, code: Opcode, fn: type_kind.TypeId) err[fail.Fail] {
    val opt_row: opt[*opcode_row.Row] = opcode_table.at(code);
    if (sel opt_row.none) { ret err[fail.Fail].err{fail.message("lower: an `intrinsic` of mirl names an opcode with no row")}; }
    val r:      *opcode_row.Row = opt_row.some;
    val opt_fn: opt[*type.Type] = type.get(ctx.s.types, type.strip_secret(ctx.s.types, fn));
    if (sel opt_fn.none)                        { ret err[fail.Fail].err{fail.message("lower: an `intrinsic` of mirl is declared with no type")}; }
    if (opt_fn.some.kind != type_kind.TYPE_FUN) { ret err[fail.Fail].err{fail.message("lower: an `intrinsic` of mirl is declared with no function type")}; }
    val count:    u32 = opt_fn.some.data.fn.params_len;
    val operands: u32 = opcode_row.fixed(r);
    if (count != operands) {
        val res_text: res[str, fail.Fail] = diagnostic.format(ctx.s.alloc, "`{}` takes {} operands, but its declaration takes {} parameters. declare one parameter per operand, in the operation's order", r.name, operands, count);
        if (sel res_text.err) { ret err[fail.Fail].err{res_text.err}; }
        ret err[fail.Fail].err{lower_context.report_gate(ctx, diagnostic_kind.OP_OPERAND_COUNT, span, res_text.ok)};
    }

    var lowered: *Type = nil;
    var secret:  *bool = nil;
    fin {
        if (lowered != nil) { A.deallocate[Type](ctx.s.alloc, lowered, count::usize); }
        if (secret != nil)  { A.deallocate[bool](ctx.s.alloc, secret, count::usize); }
    }
    if (count > 0) {
        val res_lowered: res[*Type, A.Error] = A.allocate[Type](ctx.s.alloc, count::usize);
        if (sel res_lowered.err) { ret err[fail.Fail].err{fail.refused(res_lowered.err)}; }
        lowered = res_lowered.ok;
        val res_secret: res[*bool, A.Error] = A.allocate[bool](ctx.s.alloc, count::usize);
        if (sel res_secret.err) { ret err[fail.Fail].err{fail.refused(res_secret.err)}; }
        secret = res_secret.ok;
    }
    val d: Declaration = Declaration{name: r.name, params: opt_fn.some.data.fn.params_start, count: count, result: opt_fn.some.data.fn.ret_type, lowered: lowered};
    var i: u32         = 0;
    for (i < count) {
        val t:         type_kind.TypeId     = param(ctx, ?d, i);
        val res_param: res[Type, fail.Fail] = lower_context.lower_type(ctx, type.strip_secret(ctx.s.types, t));
        if (sel res_param.err) { ret err[fail.Fail].err{res_param.err}; }
        lowered[i] = res_param.ok;
        secret[i]  = type.is_secret(ctx.s.types, t);
        i          = i + 1;
    }

    var inst: mirl_check.Instance = mirl_check.Instance{
        operands:   Slice[Type]{data: lowered, size: count::usize},
        secret:     Slice[bool]{data: secret, size: count::usize},
        declared:   false,
        kept:       false,
        bounded:    false,
        checked:    false,
        oriented:   false,
        immediates: Slice[opcode_row.Immediate]{data: nil, size: 0},
        edges:      Slice[mirl_check.Edge]{data: nil, size: 0},
        returns:    Slice[Type]{data: nil, size: 0}
    };
    var gives: vector.Vector[Type] = vector.init[Type](ctx.s.alloc);
    fin { vector.dnit[Type](?gives); }
    val res_typed: res[bool, mirl_check.Error] = mirl_check.check_row(builder.types_of(?ctx.builder), r, ?inst, ?gives);
    if (sel res_typed.err) { ret broken(ctx, span, ?d, res_typed.err); }
    ret returned(ctx, span, ?d, ?gives);
}

# the declaration `d` refused for the break `e` mirl's checker found in it
fun broken(ctx: *lower_context.LowerContext, span: base_source.Span, d: *Declaration, e: mirl_check.Error) err[fail.Fail] {
    val opt_starved: opt[A.Error] = mirl_check.starved(e);
    if (sel opt_starved.some) { ret err[fail.Fail].err{fail.refused(opt_starved.some)}; }
    if (sel e.class) {
        val opt_k: opt[u32] = operand(e.class.subject);
        if (sel opt_k.some) { ret refused_param(ctx, span, d, opt_k.some, takes(e.class.class)); }
    }
    if (sel e.agree)   { ret refused_pair(ctx, span, d, e.agree, "must be one type"); }
    if (sel e.conform) { ret refused_pair(ctx, span, d, e.conform, "must both be vectors of one lane count, or both scalars"); }
    if (sel e.element) { ret refused_pair(ctx, span, d, e.element, "must have one lane type"); }
    if (sel e.bits)    { ret refused_pair(ctx, span, d, e.bits, "must have one bit width"); }
    if (sel e.wider)   { ret refused_pair(ctx, span, d, e.wider, "must be the first wider than the second"); }
    if (sel e.unsized) {
        val opt_k: opt[u32] = operand(e.unsized);
        if (sel opt_k.some) { ret refused_param(ctx, span, d, opt_k.some, "a type of a stated bit width"); }
    }
    ret err[fail.Fail].err{fail.message("lower: mirl's checker refused the declaration of an `intrinsic` of mirl for a break no parameter states")};
}

# the declaration `d` held to the results `gives` the row types over its parameters
fun returned(ctx: *lower_context.LowerContext, span: base_source.Span, d: *Declaration, gives: *vector.Vector[Type]) err[fail.Fail] {
    if (gives.len > 1) { ret err[fail.Fail].err{fail.message("lower: an `intrinsic` of mirl names an operation of more than one result")}; }
    if (gives.len == 0) {
        if (type_kind.is_nil(d.result)) { ret err[fail.Fail].ok{}; }
        ret refused(ctx, span, diagnostic.format(ctx.s.alloc, "`{}` gives no result, so its declaration must not have a return type", d.name));
    }
    if (type_kind.is_nil(d.result)) { ret refused(ctx, span, diagnostic.format(ctx.s.alloc, "`{}` gives a result, so its declaration must return its type", d.name)); }
    val res_result: res[Type, fail.Fail] = lower_context.lower_type(ctx, type.strip_secret(ctx.s.types, d.result));
    if (sel res_result.err)             { ret err[fail.Fail].err{res_result.err}; }
    if (res_result.ok == gives.data[0]) { ret err[fail.Fail].ok{}; }
    val res_named: res[str, fail.Fail] = typename.type_to_str(ctx.s, d.result);
    if (sel res_named.err) { ret err[fail.Fail].err{res_named.err}; }
    fin { typename.type_str_free(ctx.s, res_named.ok); }
    var k: u32 = 0;
    for (k < d.count) {
        if (d.lowered[k] == gives.data[0]) {
            ret refused(ctx, span, diagnostic.format(ctx.s.alloc, "the declaration of `{}` returns `{}`, but the operation gives the type of parameter {}", d.name, res_named.ok, k + 1));
        }
        k = k + 1;
    }
    ret refused(ctx, span, diagnostic.format(ctx.s.alloc, "the declaration of `{}` returns `{}`, which is not the type the operation gives", d.name, res_named.ok));
}

# the parameter a subject is, none for an immediate, which no declaration states
fun operand(s: Subject) opt[u32] {
    if (sel s.operand) { ret opt[u32].some{s.operand}; }
    ret opt[u32].none{};
}

# what an operand of the class `c` takes, as a refusal states it
fun takes(c: Class) str {
    if (sel c.integer)   { ret "an integer"; }
    if (sel c.width)     { ret "an integer of the width its operation states"; }
    if (sel c.float)     { ret "a float"; }
    if (sel c.format)    { ret "a float of the format its operation states"; }
    if (sel c.pointer)   { ret "a pointer"; }
    if (sel c.function)  { ret "a function"; }
    if (sel c.bytes)     { ret "an integer of a whole number of bytes"; }
    if (sel c.vector)    { ret "a vector"; }
    if (sel c.scalar)    { ret "an integer, a float or a pointer"; }
    if (sel c.structure) { ret "a record"; }
    if (sel c.array)     { ret "an array"; }
    if (sel c.aggregate) { ret "a record, an array or a union"; }
    ret "any type";
}

# the type of parameter `i` of the declaration `d`
fun param(ctx: *lower_context.LowerContext, d: *Declaration, i: u32) type_kind.TypeId {
    val opt_param: opt[type_kind.TypeId] = type.get_param(ctx.s.types, d.params + i);
    if (sel opt_param.none) { ret type_kind.TYPE_NIL; }
    ret opt_param.some;
}

# the declaration refused at `span` with `op.signature` and the message `text`
fun refused(ctx: *lower_context.LowerContext, span: base_source.Span, text: res[str, fail.Fail]) err[fail.Fail] {
    if (sel text.err) { ret err[fail.Fail].err{text.err}; }
    ret err[fail.Fail].err{lower_context.report_gate(ctx, diagnostic_kind.OP_SIGNATURE, span, text.ok)};
}

# a refusal naming parameter `i`, its type and what its operand takes
fun refused_param(ctx: *lower_context.LowerContext, span: base_source.Span, d: *Declaration, i: u32, what: str) err[fail.Fail] {
    val res_named: res[str, fail.Fail] = typename.type_to_str(ctx.s, param(ctx, d, i));
    if (sel res_named.err) { ret err[fail.Fail].err{res_named.err}; }
    fin { typename.type_str_free(ctx.s, res_named.ok); }
    ret refused(ctx, span, diagnostic.format(ctx.s.alloc, "parameter {} of the declaration of `{}` is `{}`, but its operand takes {}", i + 1, d.name, res_named.ok, what));
}

# a refusal naming the two parameters `p` speaks of and what the operation asks of them
fun refused_pair(ctx: *lower_context.LowerContext, span: base_source.Span, d: *Declaration, p: Pair, what: str) err[fail.Fail] {
    val opt_left:  opt[u32] = operand(p.left);
    val opt_right: opt[u32] = operand(p.right);
    if (sel opt_left.none)  { ret err[fail.Fail].err{fail.message("lower: mirl's checker refused an `intrinsic` of mirl over an immediate")}; }
    if (sel opt_right.none) { ret err[fail.Fail].err{fail.message("lower: mirl's checker refused an `intrinsic` of mirl over an immediate")}; }
    ret refused(ctx, span, diagnostic.format(ctx.s.alloc, "parameters {} and {} of the declaration of `{}` {}", opt_left.some + 1, opt_right.some + 1, d.name, what));
}
