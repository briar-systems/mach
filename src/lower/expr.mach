# the lowering of expressions into mirl values, places and branches
#
# it covers reads and stores of places, calls with their class copies and `#[intrinsic]`
# instructions, members and tag payloads, a guarded payload checked by a trap in the debug
# profile, vector ranges, comptime intrinsics, the elements of a `$each`, and the constant a
# global's initializer folds to.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use A: std.allocator;
use std.collections.slice.Slice;

use mach.base.diagnostic;
use diagnostic_kind: mach.base.diagnostic.kind;
use mach.base.fail;
use mach.base.float;
use mach.base.intern;
use base_source: mach.base.source;
use mach.base.stack;
use mach.base.wide;
use mach.front.ast;
use ast_expr: mach.front.ast.expr;
use ast_id:   mach.front.ast.id;
use ast_type: mach.front.ast.type;
use mach.front.comptime;
use comptime_deep: mach.front.comptime.deep;
use mach.front.comptime.intrinsic;
use front_literal: mach.front.literal;
use mach.front.resolve;
use mach.lower.builder;
use mach.lower.constnode;
use lower_context: mach.lower.context;
use op_intrinsic:  mach.lower.intrinsic;
use mach.lower.irt;
use mach.lower.mangle;
use lower_shader: mach.lower.shader;
use mach.lower.value;
use op_written: mach.lower.written;
use mach.session.module;
use mach.type;
use mach.type.query.subst;
use mach.type.shape;

use comptime_failure: mach.front.comptime.failure;
use comptime_scope:   mach.front.comptime.scope;
use comptime_value:   mach.front.comptime.value;
use sema_instance:    mach.front.sema.instance;
use sema_interface:   mach.front.sema.interface;
use type_field:       mach.type.field;
use type_kind:        mach.type.kind;
use type_prim:        mach.type.prim;
use mirl.ir.function.ConstantTime;
use mirl_global: mirl.ir.global;
use mirl.ir.id;
use mirl.ir.linkage.Linkage;
use mirl.ir.native;
use mirl.ir.opcode.row.Opcode;
use opcode: mirl.ir.opcode.table;
use mirl.ir.place.Named;
use types: mirl.ir.type.table;
use mirl.ir.type.table.Type;
use collections_vector: std.collections.vector;

pub fun lower_rvalue(ctx: *lower_context.LowerContext, eid: ast_id.ExprId) res[value.Value, fail.Fail] {
    val res_expression: res[ast_expr.Expr, fail.Fail] = lower_context.expression(ctx, eid);
    if (sel res_expression.err) {
        ret res[value.Value, fail.Fail].err{fail.message("lower: expression id out of range")};
    }
    var e_value: ast_expr.Expr  = res_expression.ok;
    val e:       *ast_expr.Expr = ?e_value;
    if (stack.exhausted()) { ret res[value.Value, fail.Fail].err{lower_context.refuse_nesting(ctx, e.span)}; }

    val saved_loc: base_source.Location = builder.current_loc(?ctx.builder);
    builder.set_loc(?ctx.builder, base_source.location(ctx.scope.a.file_id, e.span));
    fin { builder.set_loc(?ctx.builder, saved_loc); }
    # only the armed argument's own read may borrow, never a read nested inside it
    val saved_borrow: bool = ctx.borrow_now;
    ctx.borrow_now = ctx.borrow_armed && ast_id.expr_same(eid, ctx.borrow_eid);
    fin { ctx.borrow_now = saved_borrow; }
    # only the armed expression itself may build its value in the armed destination
    val saved_into: bool = ctx.into_now;
    ctx.into_now = ctx.into_armed && ast_id.expr_same(eid, ctx.into_eid);
    fin { ctx.into_now = saved_into; }

    val res_kind:    res[value.Value, fail.Fail] = lower_rvalue_kind(ctx, eid, e);
    var res_lowered: res[value.Value, fail.Fail] = res_kind;
    if (sel res_kind.ok)     { res_lowered = stamp_secret(ctx, eid, res_kind.ok); }
    if (sel res_lowered.err) { ret res[value.Value, fail.Fail].err{fail.at(res_lowered.err, builder.current_loc(?ctx.builder))}; }
    ret res_lowered;
}

fun lower_rvalue_kind(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, e: *ast_expr.Expr) res[value.Value, fail.Fail] {
    val k: ast_expr.ExprKind = e.kind;

    if (k == ast_expr.EXPR_KIND_LIT_INT)          { ret lower_lit_int(ctx, eid, e); }
    if (k == ast_expr.EXPR_KIND_LIT_FLOAT)        { ret lower_lit_float(ctx, eid, e); }
    if (k == ast_expr.EXPR_KIND_LIT_CHAR)         { ret lower_lit_char(ctx, eid, e); }
    if (k == ast_expr.EXPR_KIND_LIT_STR)          { ret lower_lit_str(ctx, e); }
    if (k == ast_expr.EXPR_KIND_LIT_NIL)          { ret lower_lit_nil(ctx, eid); }
    if (k == ast_expr.EXPR_KIND_IDENT)            { ret lower_ident_rvalue(ctx, eid); }
    if (k == ast_expr.EXPR_KIND_MEMBER)           { ret lower_member_rvalue(ctx, eid, e); }
    if (k == ast_expr.EXPR_KIND_PROJECT)          { ret lower_project_rvalue(ctx, eid, e); }
    if (k == ast_expr.EXPR_KIND_INDEX)            { ret lower_index_rvalue(ctx, eid, e); }
    if (k == ast_expr.EXPR_KIND_GENERIC_INSTANCE) { ret lower_instance_reference(ctx, eid); }
    if (k == ast_expr.EXPR_KIND_CALL)             { ret lower_call(ctx, eid, e); }
    if (k == ast_expr.EXPR_KIND_BINARY)           { ret lower_binary(ctx, eid, e); }
    if (k == ast_expr.EXPR_KIND_UNARY)            { ret lower_unary(ctx, eid, e); }
    if (k == ast_expr.EXPR_KIND_CAST)             { ret lower_cast(ctx, eid, e); }
    if (k == ast_expr.EXPR_KIND_STRIP)            { ret lower_strip(ctx, e); }
    if (k == ast_expr.EXPR_KIND_COMPTIME_IDENT)   { ret lower_comptime_path(ctx, eid); }
    if (k == ast_expr.EXPR_KIND_ARRAY_LIT)        { ret lower_array_lit(ctx, eid, e, lower_rvalue); }
    if (k == ast_expr.EXPR_KIND_STRUCT_LIT)       { ret lower_struct_lit(ctx, eid, e); }
    if (k == ast_expr.EXPR_KIND_VECTOR_LIT)       { ret lower_vector_lit(ctx, eid, e, lower_rvalue); }
    if (k == ast_expr.EXPR_KIND_SEL)              { ret lower_sel(ctx, eid, e); }

    ret res[value.Value, fail.Fail].err{fail.message("lower: unsupported expression kind in rvalue position")};
}

# a value of a secret type is secret: one built from public operands, or a constant, is
# classified where it is made. an aggregate is its storage's address, which is public, and
# is marked secret where its type holds a secret at any depth, so every whole read and copy
# of it is
fun stamp_secret(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, v: value.Value) res[value.Value, fail.Fail] {
    if (v.secret || value.is_none(v)) { ret res[value.Value, fail.Fail].ok{v}; }
    if (irt.is_aggregate(?ctx.m.types, v.ty)) {
        var out: value.Value = v;
        out.secret = lower_context.type_contains_secret(ctx, lower_context.expr_type_of(ctx, eid));
        ret res[value.Value, fail.Fail].ok{out};
    }
    var sec: bool = lower_context.expr_is_secret(ctx, eid);
    if (!sec) { sec = compare_operand_secret(ctx, eid); }
    if (!sec) { ret res[value.Value, fail.Fail].ok{v}; }
    ret builder.emit_classify(?ctx.builder, v);
}

fun compare_operand_secret(ctx: *lower_context.LowerContext, eid: ast_id.ExprId) bool {
    val res_expr: res[ast_expr.Expr, fail.Fail] = lower_context.expression(ctx, eid);
    if (sel res_expr.err) { ret false; }
    var e_value: ast_expr.Expr  = res_expr.ok;
    val e:       *ast_expr.Expr = ?e_value;
    if (e.kind != ast_expr.EXPR_KIND_BINARY) { ret false; }
    if (!is_compare_binop(e.data.binary.op)) { ret false; }
    ret lower_context.expr_is_secret(ctx, e.data.binary.lhs) || lower_context.expr_is_secret(ctx, e.data.binary.rhs);
}

fun lower_lvalue(ctx: *lower_context.LowerContext, eid: ast_id.ExprId) res[value.Value, fail.Fail] {
    val res_expression: res[ast_expr.Expr, fail.Fail] = lower_context.expression(ctx, eid);
    if (sel res_expression.err) {
        ret res[value.Value, fail.Fail].err{fail.message("lower: lvalue id out of range")};
    }
    var e_value: ast_expr.Expr  = res_expression.ok;
    val e:       *ast_expr.Expr = ?e_value;
    if (stack.exhausted()) { ret res[value.Value, fail.Fail].err{lower_context.refuse_nesting(ctx, e.span)}; }

    val saved_loc: base_source.Location = builder.current_loc(?ctx.builder);
    builder.set_loc(?ctx.builder, base_source.location(ctx.scope.a.file_id, e.span));
    fin { builder.set_loc(?ctx.builder, saved_loc); }

    val res_lowered: res[value.Value, fail.Fail] = lower_lvalue_kind(ctx, eid, e);
    if (sel res_lowered.err) { ret res[value.Value, fail.Fail].err{fail.at(res_lowered.err, builder.current_loc(?ctx.builder))}; }
    ret res_lowered;
}

fun lower_lvalue_kind(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, e: *ast_expr.Expr) res[value.Value, fail.Fail] {
    val k: ast_expr.ExprKind = ast.expr_place_kind(e);

    if (k == ast_expr.EXPR_KIND_IDENT)   { ret lower_ident_lvalue(ctx, eid); }
    if (k == ast_expr.EXPR_KIND_MEMBER)  { ret lower_member_lvalue(ctx, eid, e); }
    if (k == ast_expr.EXPR_KIND_PROJECT) { ret lower_project_lvalue(ctx, eid, e); }
    if (k == ast_expr.EXPR_KIND_INDEX)   { ret lower_index_lvalue(ctx, eid, e); }
    if (k == ast_expr.EXPR_KIND_UNARY)   { ret lower_rvalue(ctx, e.data.unary.operand); }

    if (k == ast_expr.EXPR_KIND_CALL) {
        val res_ir: res[Type, fail.Fail] = ir_type_of_expr(ctx, eid);
        if (sel res_ir.err) { ret res[value.Value, fail.Fail].err{res_ir.err}; }
        if (is_aggregate_ir(ctx, res_ir.ok)) {
            ret lower_rvalue(ctx, eid);
        }
    }

    ret res[value.Value, fail.Fail].err{fail.message("lower: expression is not an lvalue")};
}

fun lower_lit_int(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, e: *ast_expr.Expr) res[value.Value, fail.Fail] {
    val res_ir: res[Type, fail.Fail] = ir_type_of_expr(ctx, eid);
    if (sel res_ir.err) { ret res[value.Value, fail.Fail].err{res_ir.err}; }
    # a literal is an unsigned magnitude, so past the 128-bit carrier it zero extends
    if (irt.int_width(?ctx.m.types, res_ir.ok) > 128) {
        val carrier: value.Value = value.const_int_wide(e.data.lit_int.value, builder.int_type(?ctx.builder, 128));
        ret builder.emit_zext(?ctx.builder, carrier, res_ir.ok);
    }
    ret res[value.Value, fail.Fail].ok{value.const_int_wide(e.data.lit_int.value, res_ir.ok)};
}

fun lower_lit_float(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, e: *ast_expr.Expr) res[value.Value, fail.Fail] {
    val res_ir: res[Type, fail.Fail] = ir_type_of_expr(ctx, eid);
    if (sel res_ir.err) { ret res[value.Value, fail.Fail].err{res_ir.err}; }
    val res_lit: res[float.Rounded, fail.Fail] = front_literal.float_at(lower_context.module_source(ctx), e.data.lit_float.tok, lower_context.expr_float_width(ctx, eid));
    if (sel res_lit.err) { ret res[value.Value, fail.Fail].err{res_lit.err}; }
    ret res[value.Value, fail.Fail].ok{float_constant(ctx, res_lit.ok.value, res_ir.ok)};
}

fun float_constant(ctx: *lower_context.LowerContext, f: f64, ty: Type) value.Value {
    ret value.const_float(f, ty);
}

fun lower_lit_char(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, e: *ast_expr.Expr) res[value.Value, fail.Fail] {
    val res_ir: res[Type, fail.Fail] = ir_type_of_expr(ctx, eid);
    if (sel res_ir.err) { ret res[value.Value, fail.Fail].err{res_ir.err}; }
    ret res[value.Value, fail.Fail].ok{value.const_int(e.data.lit_char.value::u64, res_ir.ok)};
}

fun lower_lit_str(ctx: *lower_context.LowerContext, e: *ast_expr.Expr) res[value.Value, fail.Fail] {
    val inner:   View                       = ast.lit_str_value(ctx.scope.a, e);
    val res_sid: res[intern.StrId, A.Error] = intern.bytes_add(ctx.s.interner, inner.data::str, inner.len);
    if (sel res_sid.err) { ret res[value.Value, fail.Fail].err{fail.refused(res_sid.err)}; }
    ret constnode.string_global(ctx, res_sid.ok);
}

fun lower_lit_nil(ctx: *lower_context.LowerContext, eid: ast_id.ExprId) res[value.Value, fail.Fail] {
    val res_ir: res[Type, fail.Fail] = ir_type_of_expr(ctx, eid);
    if (sel res_ir.err) { ret res[value.Value, fail.Fail].err{res_ir.err}; }
    ret res[value.Value, fail.Fail].ok{value.const_null(res_ir.ok)};
}

fun lower_ident_rvalue(ctx: *lower_context.LowerContext, eid: ast_id.ExprId) res[value.Value, fail.Fail] {
    val sid: resolve.SymbolId = lower_context.expr_symbol_of(ctx, eid);

    val opt_cv: opt[comptime_value.CTValue] = comptime_param_value(ctx, sid);
    if (sel opt_cv.some) {
        ret const_value_of(ctx, eid, opt_cv.some);
    }

    val opt_ord: opt[u32] = pack_elem_ordinal(ctx, sid);
    if (sel opt_ord.some) {
        ret load_pack_elem(ctx, eid, opt_ord.some);
    }

    val opt_elem: opt[comptime_value.CTValue] = each_element(ctx, sid);
    if (sel opt_elem.some) {
        ret element_value(ctx, eid, opt_elem.some);
    }

    val opt_held: opt[value.Value] = lower_context.lookup_direct(ctx, sid);
    if (sel opt_held.some) { ret res[value.Value, fail.Fail].ok{opt_held.some}; }

    val opt_local: opt[value.Value] = lower_context.lookup_local(ctx, sid);
    if (sel opt_local.some) {
        val slot:   value.Value          = opt_local.some;
        val res_ir: res[Type, fail.Fail] = ir_type_of_expr(ctx, eid);
        if (sel res_ir.err) { ret res[value.Value, fail.Fail].err{res_ir.err}; }
        ret rvalue_at(ctx, slot, res_ir.ok, lower_context.expr_type_of(ctx, eid), access_is_volatile(ctx, eid));
    }
    ret symbol_reference(ctx, eid, sid);
}

fun pack_elem_ordinal(ctx: *lower_context.LowerContext, sid: resolve.SymbolId) opt[u32] {
    val opt_sym: opt[*resolve.Symbol] = lower_context.symbol_of(ctx, sid);
    if (sel opt_sym.none) { ret opt[u32].none{}; }
    val sym: *resolve.Symbol = opt_sym.some;
    if (sym.kind != resolve.SYM_VAL || (sym.flags & resolve.SYM_FLAG_COMPTIME) == 0) { ret opt[u32].none{}; }
    if (!ast_id.decl_is_nil(sym.decl))                                               { ret opt[u32].none{}; }
    val opt_nc: opt[comptime_scope.NamedConst] = comptime_scope.lookup(ctx.scope.ctx, sym.name);
    if (sel opt_nc.none) { ret opt[u32].none{}; }
    val cval: comptime_value.CTValue = opt_nc.some.value;
    if (cval.kind != comptime_value.CT_KIND_PACK_ELEM) { ret opt[u32].none{}; }
    ret opt[u32].some{cval.data.pelem.index};
}

# the element of a constant array a `$each` loop variable names
fun each_element(ctx: *lower_context.LowerContext, sid: resolve.SymbolId) opt[comptime_value.CTValue] {
    val opt_sym: opt[*resolve.Symbol] = lower_context.symbol_of(ctx, sid);
    if (sel opt_sym.none) { ret opt[comptime_value.CTValue].none{}; }
    val sym: *resolve.Symbol = opt_sym.some;
    if (sym.kind != resolve.SYM_VAL || (sym.flags & resolve.SYM_FLAG_COMPTIME) == 0) { ret opt[comptime_value.CTValue].none{}; }
    if (!ast_id.decl_is_nil(sym.decl))                                               { ret opt[comptime_value.CTValue].none{}; }
    val opt_nc: opt[comptime_scope.NamedConst] = comptime_scope.lookup(ctx.scope.ctx, sym.name);
    if (sel opt_nc.none)                                       { ret opt[comptime_value.CTValue].none{}; }
    if (opt_nc.some.value.kind != comptime_value.CT_KIND_NODE) { ret opt[comptime_value.CTValue].none{}; }
    ret opt[comptime_value.CTValue].some{opt_nc.some.value};
}

# the part of a `$each` element `eid` reads: a constant where the array's published value holds
# it whole, a scalar's or an aggregate's of constant bytes of its own, and otherwise a read of
# the array itself, where the element is stored
fun element_value(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, element: comptime_value.CTValue) res[value.Value, fail.Fail] {
    val res_store: res[*comptime_deep.Store, fail.Fail] = lower_context.constant_store(ctx, element.data.node.module);
    if (sel res_store.err) { ret res[value.Value, fail.Fail].err{res_store.err}; }
    val store:       *comptime_deep.Store    = res_store.ok;
    val node:        comptime_deep.Node      = comptime_deep.node_of(element);
    val opt_refused: opt[comptime_deep.Node] = comptime_deep.refused_within(store, node);
    if (sel opt_refused.some) {
        val res_at: res[value.Value, fail.Fail] = element_address(ctx, eid);
        if (sel res_at.err) { ret res_at; }
        val res_load_ir: res[Type, fail.Fail] = ir_type_of_expr(ctx, eid);
        if (sel res_load_ir.err) { ret res[value.Value, fail.Fail].err{res_load_ir.err}; }
        ret rvalue_at(ctx, res_at.ok, res_load_ir.ok, lower_context.expr_type_of(ctx, eid), false);
    }
    if (comptime_deep.shape_at(store, node).kind == comptime_deep.NODE_SCALAR) { ret const_value_of(ctx, eid, comptime_deep.scalar(store, node)); }
    val res_ir: res[Type, fail.Fail] = ir_type_of_expr(ctx, eid);
    if (sel res_ir.err) { ret res[value.Value, fail.Fail].err{res_ir.err}; }
    val ity:     Type                        = res_ir.ok;
    val res_agg: res[value.Value, fail.Fail] = constnode.aggregate(ctx, store, node, ity);
    if (sel res_agg.err) { ret res_agg; }
    val res_global: res[value.Value, fail.Fail] = lower_context.constant_global(ctx, res_agg.ok);
    if (sel res_global.err) { ret res_global; }
    ret rvalue_at(ctx, res_global.ok, ity, lower_context.expr_type_of(ctx, eid), false);
}

fun load_pack_elem(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, ord: u32) res[value.Value, fail.Fail] {
    if (ctx.pack_slots == nil || ord >= ctx.pack_len) {
        ret res[value.Value, fail.Fail].err{fail.message("lower: pack element ordinal out of range")};
    }
    val res_ir: res[Type, fail.Fail] = ir_type_of_expr(ctx, eid);
    if (sel res_ir.err) { ret res[value.Value, fail.Fail].err{res_ir.err}; }
    ret rvalue_at(ctx, ctx.pack_slots[ord], res_ir.ok, lower_context.expr_type_of(ctx, eid), access_is_volatile(ctx, eid));
}

fun is_spread_expr(ctx: *lower_context.LowerContext, eid: ast_id.ExprId) bool {
    val res_expression: res[ast_expr.Expr, fail.Fail] = lower_context.expression(ctx, eid);
    if (sel res_expression.err) { ret false; }
    ret res_expression.ok.kind == ast_expr.EXPR_KIND_SPREAD;
}

fun call_has_spread(ctx: *lower_context.LowerContext, e: *ast_expr.Expr) bool {
    var i: u32 = 0;
    for (i < e.data.call.args_len) {
        val pool_ix: u32 = e.data.call.args_start + i;
        if (pool_ix::usize >= ctx.scope.a.expr_ids.len)              { ret false; }
        if (is_spread_expr(ctx, ctx.scope.a.expr_ids.data[pool_ix])) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun load_pack_slot(ctx: *lower_context.LowerContext, slot_ix: u32) res[value.Value, fail.Fail] {
    if (ctx.pack_slots == nil || slot_ix >= ctx.pack_len) {
        ret res[value.Value, fail.Fail].err{fail.message("lower: pack slot index out of range")};
    }
    val res_ir: res[Type, fail.Fail] = lower_context.lower_type(ctx, ctx.pack_types[slot_ix]);
    if (sel res_ir.err) { ret res[value.Value, fail.Fail].err{res_ir.err}; }
    ret rvalue_at(ctx, ctx.pack_slots[slot_ix], res_ir.ok, ctx.pack_types[slot_ix], type_is_volatile_record(ctx, ctx.pack_types[slot_ix]));
}

fun comptime_param_value(ctx: *lower_context.LowerContext, sid: resolve.SymbolId) opt[comptime_value.CTValue] {
    val opt_sym: opt[*resolve.Symbol] = lower_context.symbol_of(ctx, sid);
    if (sel opt_sym.none) { ret opt[comptime_value.CTValue].none{}; }
    val sym: *resolve.Symbol = opt_sym.some;
    if (sym.kind != resolve.SYM_PARAM || (sym.flags & resolve.SYM_FLAG_COMPTIME) == 0) {
        ret opt[comptime_value.CTValue].none{};
    }
    val opt_nc: opt[comptime_scope.NamedConst] = comptime_scope.lookup(ctx.scope.ctx, sym.name);
    if (sel opt_nc.none) { ret opt[comptime_value.CTValue].none{}; }
    ret opt[comptime_value.CTValue].some{opt_nc.some.value};
}

fun reference_linkage_name(ctx: *lower_context.LowerContext, sym: *resolve.Symbol) res[intern.StrId, fail.Fail] {
    if (lower_context.foreign(ctx, sym) || !ast_id.decl_is_nil(sym.decl)) {
        val res_found: res[lower_context.Declared, fail.Fail] = lower_context.declared(ctx, sym);
        if (sel res_found.err) { ret res[intern.StrId, fail.Fail].err{res_found.err}; }
        ret mangle.declaration_linkage_name(ctx.linkage, ctx.s, resolve.origin_of(ctx.s, sym), sym.canon, ast_id.decl_index(res_found.ok.declaration.decl));
    }
    ret mangle.linkage_name(ctx.s, module.module_fqn(?ctx.s.modules, resolve.origin_of(ctx.s, sym)), sym.canon, intern.STR_NIL);
}

# the linkage name of the module-level binding `eid` names, nil when it names a binding with
# none
pub fun symbol_linkage_name(ctx: *lower_context.LowerContext, eid: ast_id.ExprId) res[intern.StrId, fail.Fail] {
    val sid:     resolve.SymbolId     = lower_context.expr_symbol_of(ctx, eid);
    val opt_sym: opt[*resolve.Symbol] = lower_context.symbol_of(ctx, sid);
    if (sel opt_sym.none) { ret res[intern.StrId, fail.Fail].ok{intern.STR_NIL}; }
    val sym: *resolve.Symbol = opt_sym.some;

    # a binding has a linkage name only at module level
    val is_addressable: bool = sym.kind == resolve.SYM_FUN
        || ((sym.kind == resolve.SYM_VAL || sym.kind == resolve.SYM_VAR) && (sym.flags & resolve.SYM_FLAG_MODULE) != 0)
        || sym.kind == resolve.SYM_IMPORTED;
    if (!is_addressable) { ret res[intern.StrId, fail.Fail].ok{intern.STR_NIL}; }
    ret reference_linkage_name(ctx, sym);
}

fun symbol_reference(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, sid: resolve.SymbolId) res[value.Value, fail.Fail] {
    val opt_sym: opt[*resolve.Symbol] = lower_context.symbol_of(ctx, sid);
    if (sel opt_sym.none) {
        ret res[value.Value, fail.Fail].err{fail.message("lower: an identifier resolve bound names no symbol")};
    }
    val sym: *resolve.Symbol = opt_sym.some;

    val res_ln: res[intern.StrId, fail.Fail] = reference_linkage_name(ctx, sym);
    if (sel res_ln.err) { ret res[value.Value, fail.Fail].err{res_ln.err}; }
    val link: intern.StrId = res_ln.ok;

    val res_reached: res[Linkage, fail.Fail] = reference_linkage(ctx, sym);
    if (sel res_reached.err) { ret res[value.Value, fail.Fail].err{res_reached.err}; }

    if (names_function(ctx, sym)) {
        val res_sig: res[lower_context.FnSig, fail.Fail] = lower_context.fn_sig_of_type(ctx, lower_context.expr_type_of(ctx, eid));
        if (sel res_sig.err) { ret res[value.Value, fail.Fail].err{res_sig.err}; }
        val res_found: res[lower_context.Declared, fail.Fail] = lower_context.declared(ctx, sym);
        if (sel res_found.err) { ret res[value.Value, fail.Fail].err{res_found.err}; }
        ret fn_reference(ctx, link, res_sig.ok, res_reached.ok, lower_context.declaration_mode(res_found.ok.declaration));
    }

    val res_ir: res[Type, fail.Fail] = ir_type_of_expr(ctx, eid);
    if (sel res_ir.err) { ret res[value.Value, fail.Fail].err{res_ir.err}; }
    val vty: Type = res_ir.ok;

    val res_spec: res[opt[lower_shader.SpecVar], fail.Fail] = lower_shader.spec_var(ctx, sym);
    if (sel res_spec.err)     { ret res[value.Value, fail.Fail].err{res_spec.err}; }
    if (sel res_spec.ok.some) { ret spec_reference(ctx, res_spec.ok.some, vty); }

    val res_cv: res[opt[comptime_value.CTValue], fail.Fail] = module_const_value(ctx, sym);
    if (sel res_cv.err) {
        ret res[value.Value, fail.Fail].err{res_cv.err};
    }
    val opt_cv: opt[comptime_value.CTValue] = res_cv.ok;
    if (sel opt_cv.some) {
        ret const_value_of(ctx, eid, opt_cv.some);
    }

    val opt_gi: opt[u32] = find_global(ctx, link);
    if (sel opt_gi.some) {
        ret emit_global_rvalue(ctx, eid, opt_gi.some, vty);
    }

    val res_tls: res[opt[mirl_global.Tls], fail.Fail] = reference_thread(ctx, sym);
    if (sel res_tls.err) { ret res[value.Value, fail.Fail].err{res_tls.err}; }
    val res_fixed: res[bool, fail.Fail] = reference_constant(ctx, sym);
    if (sel res_fixed.err) { ret res[value.Value, fail.Fail].err{res_fixed.err}; }
    val res_xg: res[u32, fail.Fail] = lower_context.ensure_extern_global(ctx, link, vty, res_tls.ok, lower_context.expr_type_of(ctx, eid), res_reached.ok, res_fixed.ok);
    if (sel res_xg.err) { ret res[value.Value, fail.Fail].err{res_xg.err}; }
    val err_shaded: err[fail.Fail] = lower_shader.extern_global_attributes(ctx, sym, res_xg.ok);
    if (sel err_shaded.err) { ret res[value.Value, fail.Fail].err{err_shaded.err}; }
    ret emit_global_rvalue(ctx, eid, res_xg.ok, vty);
}

# a read of a `#[gpu.spec]` var: its specialization constant, of the var's type `vty`
fun spec_reference(ctx: *lower_context.LowerContext, spec: lower_shader.SpecVar, vty: Type) res[value.Value, fail.Fail] {
    var default: value.Value = value.none();
    if (spec.default.kind == comptime_value.CT_KIND_FLOAT) { default = float_constant(ctx, spec.default.data.f, vty); }
    or                                                     { default = value.const_int_wide(spec.default.data.w, vty); }
    val stated:    value.Value    = builder.spec_constant(?ctx.builder, spec.id, default);
    val err_built: err[fail.Fail] = lower_context.builder_state(ctx);
    if (sel err_built.err) { ret res[value.Value, fail.Fail].err{err_built.err}; }
    ret res[value.Value, fail.Fail].ok{stated};
}

# how a reference reaches the module binding `sym` names: through the thread when it is a
# `#[thread]` var, none otherwise
fun reference_thread(ctx: *lower_context.LowerContext, sym: *resolve.Symbol) res[opt[mirl_global.Tls], fail.Fail] {
    val res_found: res[lower_context.Declared, fail.Fail] = lower_context.declared(ctx, sym);
    if (sel res_found.err) { ret res[opt[mirl_global.Tls], fail.Fail].err{res_found.err}; }
    ret res[opt[mirl_global.Tls], fail.Fail].ok{lower_context.declared_thread(ctx, res_found.ok)};
}

# whether the program never writes the module global `sym` another object defines: a `val`
# of mach source, never one an `#[ext]` declaration names, which foreign code may write
fun reference_constant(ctx: *lower_context.LowerContext, sym: *resolve.Symbol) res[bool, fail.Fail] {
    if (sym.definition_kind != resolve.SYM_VAL) { ret res[bool, fail.Fail].ok{false}; }
    val res_found: res[lower_context.Declared, fail.Fail] = lower_context.declared(ctx, sym);
    if (sel res_found.err) { ret res[bool, fail.Fail].err{res_found.err}; }
    ret res[bool, fail.Fail].ok{(res_found.ok.declaration.flags & sema_interface.DECLARATION_EXT) == 0};
}

fun module_const_value(ctx: *lower_context.LowerContext, sym: *resolve.Symbol) res[opt[comptime_value.CTValue], fail.Fail] {
    val res_found: res[lower_context.Declared, fail.Fail] = lower_context.declared(ctx, sym);
    if (sel res_found.err) { ret res[opt[comptime_value.CTValue], fail.Fail].err{res_found.err}; }
    val opt_scalar: opt[comptime_value.CTValue] = lower_context.declared_scalar(ctx, res_found.ok);
    if (sel opt_scalar.none)                     { ret res[opt[comptime_value.CTValue], fail.Fail].ok{opt[comptime_value.CTValue].none{}}; }
    if (!const_has_no_identity(opt_scalar.some)) { ret res[opt[comptime_value.CTValue], fail.Fail].ok{opt[comptime_value.CTValue].none{}}; }
    ret res[opt[comptime_value.CTValue], fail.Fail].ok{opt_scalar};
}

fun const_has_no_identity(v: comptime_value.CTValue) bool {
    ret v.kind == comptime_value.CT_KIND_INT
        || v.kind == comptime_value.CT_KIND_FLOAT;
}

# how a binding another object defines is declared: kept inside the image when it is a private
# declaration this build defines, which an instance lowered in another module reaches
fun reference_linkage(ctx: *lower_context.LowerContext, sym: *resolve.Symbol) res[Linkage, fail.Fail] {
    if (sym.kind == resolve.SYM_IMPORTED || (sym.flags & resolve.SYM_FLAG_PUB) != 0 || ast_id.decl_is_nil(sym.decl)) {
        ret res[Linkage, fail.Fail].ok{lower_context.external_linkage()};
    }
    val res_found: res[lower_context.Declared, fail.Fail] = lower_context.declared(ctx, sym);
    if (sel res_found.err)                                                      { ret res[Linkage, fail.Fail].err{res_found.err}; }
    if ((res_found.ok.declaration.flags & sema_interface.DECLARATION_EXT) != 0) { ret res[Linkage, fail.Fail].ok{lower_context.external_linkage()}; }
    ret res[Linkage, fail.Fail].ok{lower_context.image_linkage(ctx)};
}

fun names_function(ctx: *lower_context.LowerContext, sym: *resolve.Symbol) bool {
    ret sym.kind == resolve.SYM_FUN
        || (sym.kind == resolve.SYM_IMPORTED && sym.definition_kind == resolve.SYM_FUN);
}

fun symbol_lvalue(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, sid: resolve.SymbolId) res[value.Value, fail.Fail] {
    val opt_sym: opt[*resolve.Symbol] = lower_context.symbol_of(ctx, sid);
    if (sel opt_sym.none) {
        ret res[value.Value, fail.Fail].err{fail.message("lower: an identifier resolve bound names no symbol")};
    }
    val sym: *resolve.Symbol = opt_sym.some;

    val res_ln: res[intern.StrId, fail.Fail] = reference_linkage_name(ctx, sym);
    if (sel res_ln.err) { ret res[value.Value, fail.Fail].err{res_ln.err}; }
    val link: intern.StrId = res_ln.ok;

    val opt_gi: opt[u32] = find_global(ctx, link);
    if (sel opt_gi.some) {
        ret global_pointer(ctx, opt_gi.some);
    }

    val res_ir: res[Type, fail.Fail] = ir_type_of_expr(ctx, eid);
    if (sel res_ir.err) { ret res[value.Value, fail.Fail].err{res_ir.err}; }
    val res_tls: res[opt[mirl_global.Tls], fail.Fail] = reference_thread(ctx, sym);
    if (sel res_tls.err) { ret res[value.Value, fail.Fail].err{res_tls.err}; }
    val res_reached: res[Linkage, fail.Fail] = reference_linkage(ctx, sym);
    if (sel res_reached.err) { ret res[value.Value, fail.Fail].err{res_reached.err}; }
    val res_fixed: res[bool, fail.Fail] = reference_constant(ctx, sym);
    if (sel res_fixed.err) { ret res[value.Value, fail.Fail].err{res_fixed.err}; }
    val res_xg: res[u32, fail.Fail] = lower_context.ensure_extern_global(ctx, link, res_ir.ok, res_tls.ok, lower_context.expr_type_of(ctx, eid), res_reached.ok, res_fixed.ok);
    if (sel res_xg.err) { ret res[value.Value, fail.Fail].err{res_xg.err}; }
    val err_shaded: err[fail.Fail] = lower_shader.extern_global_attributes(ctx, sym, res_xg.ok);
    if (sel err_shaded.err) { ret res[value.Value, fail.Fail].err{err_shaded.err}; }
    ret global_pointer(ctx, res_xg.ok);
}

fun lower_ident_lvalue(ctx: *lower_context.LowerContext, eid: ast_id.ExprId) res[value.Value, fail.Fail] {
    val sid: resolve.SymbolId = lower_context.expr_symbol_of(ctx, eid);

    val opt_cv: opt[comptime_value.CTValue] = comptime_param_value(ctx, sid);
    if (sel opt_cv.some) {
        ret res[value.Value, fail.Fail].err{fail.message("lower: cannot take the address of a comptime parameter")};
    }

    val opt_ord: opt[u32] = pack_elem_ordinal(ctx, sid);
    if (sel opt_ord.some) {
        val ord: u32 = opt_ord.some;
        if (ctx.pack_slots == nil || ord >= ctx.pack_len) {
            ret res[value.Value, fail.Fail].err{fail.message("lower: pack element ordinal out of range")};
        }
        ret res[value.Value, fail.Fail].ok{ctx.pack_slots[ord]};
    }

    val opt_elem: opt[comptime_value.CTValue] = each_element(ctx, sid);
    if (sel opt_elem.some) {
        ret res[value.Value, fail.Fail].err{fail.message("lower: cannot take the address of a `$each` constant array element")};
    }

    val opt_local: opt[value.Value] = lower_context.lookup_local(ctx, sid);
    if (sel opt_local.some) {
        ret res[value.Value, fail.Fail].ok{opt_local.some};
    }
    val opt_held: opt[value.Value] = lower_context.lookup_direct(ctx, sid);
    if (sel opt_held.some) { ret res[value.Value, fail.Fail].err{fail.message("lower: the place of a local bound to its value is taken")}; }
    ret symbol_lvalue(ctx, eid, sid);
}

# where the part of a `$each` element `eid` reads is stored: its element of the array, and the
# field or payload a member names in it
fun element_address(ctx: *lower_context.LowerContext, eid: ast_id.ExprId) res[value.Value, fail.Fail] {
    val res_expr: res[ast_expr.Expr, fail.Fail] = lower_context.expression(ctx, eid);
    if (sel res_expr.err) { ret res[value.Value, fail.Fail].err{res_expr.err}; }
    val e: ast_expr.Expr = res_expr.ok;
    if (e.kind == ast_expr.EXPR_KIND_MEMBER) {
        val res_base: res[value.Value, fail.Fail] = element_address(ctx, e.data.member.object);
        if (sel res_base.err) { ret res_base; }
        val rec_ty: type_kind.TypeId = type.strip_secret(ctx.s.types, lower_context.expr_type_of(ctx, e.data.member.object));
        ret field_gep(ctx, res_base.ok, rec_ty, field_index_of(ctx, rec_ty, e.data.member.name_id));
    }
    val opt_sym: opt[*resolve.Symbol] = lower_context.symbol_of(ctx, lower_context.expr_symbol_of(ctx, eid));
    if (sel opt_sym.none) { ret res[value.Value, fail.Fail].err{fail.message("lower: a `$each` element read names no loop variable")}; }
    val opt_found: opt[lower_context.EachElement] = lower_context.each_element_of(ctx, opt_sym.some.name);
    if (sel opt_found.none) { ret res[value.Value, fail.Fail].err{fail.message("lower: a `$each` loop variable is read outside its statement")}; }
    val element:  lower_context.EachElement   = opt_found.some;
    val res_base: res[value.Value, fail.Fail] = lower_lvalue(ctx, element.array);
    if (sel res_base.err) { ret res_base; }
    val res_arr: res[Type, fail.Fail] = lower_context.lower_type(ctx, lower_context.expr_type_of(ctx, element.array));
    if (sel res_arr.err) { ret res[value.Value, fail.Fail].err{res_arr.err}; }
    ret builder.emit_element(?ctx.builder, res_base.ok, res_arr.ok, value.const_int(element.index::u64, builder.index_type(?ctx.builder)));
}

fun try_lower_element_member(ctx: *lower_context.LowerContext, eid: ast_id.ExprId) opt[res[value.Value, fail.Fail]] {
    var zero:     bool                                        = false;
    val res_leaf: res[opt[comptime_value.CTValue], fail.Fail] = element_leaf(ctx, eid, ?zero);
    if (sel res_leaf.err)     { ret opt[res[value.Value, fail.Fail]].some{res[value.Value, fail.Fail].err{res_leaf.err}}; }
    if (zero)                 { ret opt[res[value.Value, fail.Fail]].some{dead_zero_value(ctx, eid)}; }
    if (sel res_leaf.ok.none) { ret opt[res[value.Value, fail.Fail]].none{}; }
    ret opt[res[value.Value, fail.Fail]].some{element_value(ctx, eid, res_leaf.ok.some)};
}

# the part of a `$each` element a member path reaches: the element itself for the binding, or the
# field or selected payload a member names; `zero` is raised for a path that reads a zero: a
# field the literal leaves out, or a payload of a case the element does not hold, which only a
# `sel` that folded false reaches; none is a path the element does not answer
fun element_leaf(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, zero: *bool) res[opt[comptime_value.CTValue], fail.Fail] {
    val res_none: res[opt[comptime_value.CTValue], fail.Fail] = res[opt[comptime_value.CTValue], fail.Fail].ok{opt[comptime_value.CTValue].none{}};
    val res_expr: res[ast_expr.Expr, fail.Fail]               = lower_context.expression(ctx, eid);
    if (sel res_expr.err) { ret res_none; }
    val e: ast_expr.Expr = res_expr.ok;
    if (e.kind == ast_expr.EXPR_KIND_IDENT)  { ret res[opt[comptime_value.CTValue], fail.Fail].ok{each_element(ctx, lower_context.expr_symbol_of(ctx, eid))}; }
    if (e.kind != ast_expr.EXPR_KIND_MEMBER) { ret res_none; }
    val res_inner: res[opt[comptime_value.CTValue], fail.Fail] = element_leaf(ctx, e.data.member.object, zero);
    if (sel res_inner.err)     { ret res_inner; }
    if (sel res_inner.ok.none) { ret res_none; }
    val object:    comptime_value.CTValue               = res_inner.ok.some;
    val res_store: res[*comptime_deep.Store, fail.Fail] = lower_context.constant_store(ctx, object.data.node.module);
    if (sel res_store.err) { ret res[opt[comptime_value.CTValue], fail.Fail].err{res_store.err}; }
    val res_name: res[intern.StrId, A.Error] = intern.range_add(ctx.s.interner, lower_context.module_source(ctx), e.data.member.name.offset, e.data.member.name.len);
    if (sel res_name.err) { ret res[opt[comptime_value.CTValue], fail.Fail].err{fail.refused(res_name.err)}; }
    val p: comptime_deep.Projection = comptime_deep.project(res_store.ok, comptime_deep.node_of(object), res_name.ok);
    if (p.kind == comptime_deep.PROJECT_UNSELECTED || p.kind == comptime_deep.PROJECT_OMITTED) {
        @zero = true;
        ret res_none;
    }
    if (p.kind != comptime_deep.PROJECT_MEMBER) { ret res_none; }
    ret res[opt[comptime_value.CTValue], fail.Fail].ok{opt[comptime_value.CTValue].some{comptime_deep.node_ref(object.data.node.module, p.node,
        type_kind.index(lower_context.expr_type_of(ctx, eid)))}};
}

# whether a place is spelled over a `$each` element, which has no storage to address
fun place_roots_in_const_elem(ctx: *lower_context.LowerContext, eid: ast_id.ExprId) bool {
    val res_expr: res[ast_expr.Expr, fail.Fail] = lower_context.expression(ctx, eid);
    if (sel res_expr.err) { ret false; }
    val e: ast_expr.Expr = res_expr.ok;
    if (e.kind == ast_expr.EXPR_KIND_IDENT) {
        val opt_elem: opt[comptime_value.CTValue] = each_element(ctx, lower_context.expr_symbol_of(ctx, eid));
        ret sel opt_elem.some;
    }
    if (e.kind == ast_expr.EXPR_KIND_MEMBER) { ret place_roots_in_const_elem(ctx, e.data.member.object); }
    ret false;
}

# evaluates an expression at compile time and materializes its scalar value
fun lower_comptime_value(ctx: *lower_context.LowerContext, eid: ast_id.ExprId) res[value.Value, fail.Fail] {
    val res_evaluate: res[comptime_value.CTValue, comptime_failure.EvalFail] = comptime.evaluate[lower_context.LowerContext](ctx.scope.ctx, ctx, ctx.caps,
        ctx.scope.a, lower_context.module_source(ctx), eid, ctx.s.interner);
    lower_context.record_eval_result(ctx, res_evaluate);
    if (sel res_evaluate.err) {
        val f: comptime_failure.EvalFail = res_evaluate.err;
        if (f.kind == comptime_failure.EVAL_FAIL_INTERNAL) { ret res[value.Value, fail.Fail].err{fail.message(f.message)}; }
        ret report_expr(ctx, f.diag, eid, f.message);
    }
    ret const_value_of_init(ctx, eid, res_evaluate.ok);
}

# a zero of an expression's type, for a read the constant folding proved dead or a field a
# constant leaves out
fun dead_zero_value(ctx: *lower_context.LowerContext, eid: ast_id.ExprId) res[value.Value, fail.Fail] {
    val res_ir: res[Type, fail.Fail] = ir_type_of_expr(ctx, eid);
    if (sel res_ir.err) { ret res[value.Value, fail.Fail].err{res_ir.err}; }
    val ity: Type = res_ir.ok;
    if (irt.is_aggregate(?ctx.m.types, ity)) {
        val res_slot: res[value.Value, fail.Fail] = builder.emit_alloca(?ctx.builder, ity);
        if (sel res_slot.err) { ret res_slot; }
        val slot:             value.Value    = res_slot.ok;
        val err_emit_memzero: err[fail.Fail] = builder.emit_memzero(?ctx.builder, slot, ity, lower_context.type_contains_secret(ctx, lower_context.expr_type_of(ctx, eid)));
        if (sel err_emit_memzero.err) { ret res[value.Value, fail.Fail].err{err_emit_memzero.err}; }
        ret res[value.Value, fail.Fail].ok{value.retype(slot, ity)};
    }
    ret res[value.Value, fail.Fail].ok{value.const_null(ity)};
}

fun try_lower_field_member(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, e: *ast_expr.Expr) opt[res[value.Value, fail.Fail]] {
    val src_text: str                                                    = lower_context.module_source(ctx);
    val res_obj:  res[comptime_value.CTValue, comptime_failure.EvalFail] = comptime.evaluate[lower_context.LowerContext](ctx.scope.ctx, ctx, ctx.caps, ctx.scope.a, src_text, e.data.member.object, ctx.s.interner);
    lower_context.record_eval_result(ctx, res_obj);
    if (sel res_obj.err)                           { ret opt[res[value.Value, fail.Fail]].none{}; }
    if (!comptime_value.is_descriptor(res_obj.ok)) { ret opt[res[value.Value, fail.Fail]].none{}; }

    val res_member: res[comptime_value.CTValue, comptime_failure.EvalFail] = comptime.evaluate[lower_context.LowerContext](ctx.scope.ctx, ctx, ctx.caps, ctx.scope.a, src_text, eid, ctx.s.interner);

    lower_context.record_eval_result(ctx, res_member);
    if (sel res_member.err) { ret opt[res[value.Value, fail.Fail]].some{res[value.Value, fail.Fail].err{fail.message(res_member.err.message)}}; }
    val v: comptime_value.CTValue = res_member.ok;
    if (v.kind == comptime_value.CT_KIND_INT) {
        val res_ir: res[Type, fail.Fail] = ir_type_of_expr(ctx, eid);
        if (sel res_ir.err) { ret opt[res[value.Value, fail.Fail]].some{res[value.Value, fail.Fail].err{res_ir.err}}; }
        ret opt[res[value.Value, fail.Fail]].some{res[value.Value, fail.Fail].ok{value.const_int_wide(v.data.w, res_ir.ok)}};
    }
    if (v.kind == comptime_value.CT_KIND_STR) { ret opt[res[value.Value, fail.Fail]].some{constnode.string_global(ctx, v.data.s)}; }
    ret opt[res[value.Value, fail.Fail]].some{res[value.Value, fail.Fail].err{fail.message("lower: unsupported field descriptor member in value position")}};
}

fun try_lower_pack_len(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, e: *ast_expr.Expr) opt[res[value.Value, fail.Fail]] {
    val obj_ty: type_kind.TypeId = lower_context.expr_type_of(ctx, e.data.member.object);
    val opt_t:  opt[*type.Type]  = type.get(ctx.s.types, obj_ty);
    if (sel opt_t.none)                         { ret opt[res[value.Value, fail.Fail]].none{}; }
    if (opt_t.some.kind != type_kind.TYPE_PACK) { ret opt[res[value.Value, fail.Fail]].none{}; }

    val res_ir: res[Type, fail.Fail] = ir_type_of_expr(ctx, eid);
    if (sel res_ir.err) {
        ret opt[res[value.Value, fail.Fail]].some{res[value.Value, fail.Fail].err{res_ir.err}};
    }
    val ity: Type = res_ir.ok;
    ret opt[res[value.Value, fail.Fail]].some{res[value.Value, fail.Fail].ok{value.const_int(ctx.pack_len::u64, ity)}};
}

fun lower_member_rvalue(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, e: *ast_expr.Expr) res[value.Value, fail.Fail] {
    val opt_elem: opt[res[value.Value, fail.Fail]] = try_lower_element_member(ctx, eid);
    if (sel opt_elem.some) { ret opt_elem.some; }

    val opt_pack_len: opt[res[value.Value, fail.Fail]] = try_lower_pack_len(ctx, eid, e);
    if (sel opt_pack_len.some) { ret opt_pack_len.some; }

    val opt_field: opt[res[value.Value, fail.Fail]] = try_lower_field_member(ctx, eid, e);
    if (sel opt_field.some) { ret opt_field.some; }

    val qsid: resolve.SymbolId = lower_context.expr_symbol_of(ctx, eid);
    if (!resolve.symbol_is_nil(qsid)) {
        ret symbol_reference(ctx, eid, qsid);
    }

    if (intrinsic.is_comptime_path(ctx.scope.a, eid)) {
        ret lower_comptime_path(ctx, eid);
    }

    var rec_ty:   type_kind.TypeId;
    val res_base: res[value.Value, fail.Fail] = member_base(ctx, e.data.member.object, ?rec_ty);
    if (sel res_base.err) { ret res_base; }
    val field_ix: u32 = field_index_of(ctx, rec_ty, e.data.member.name_id);
    if (res_base.ok.whole) { ret whole_member(ctx, e.data.member.object, res_base.ok, rec_ty, field_ix); }
    val res_ptr: res[value.Value, fail.Fail] = member_place(ctx, e.data.member.object, res_base.ok, rec_ty, field_ix);
    if (sel res_ptr.err) { ret res_ptr; }
    val res_ir: res[Type, fail.Fail] = ir_type_of_expr(ctx, eid);
    if (sel res_ir.err) { ret res[value.Value, fail.Fail].err{res_ir.err}; }
    ret rvalue_at(ctx, res_ptr.ok, res_ir.ok, lower_context.expr_type_of(ctx, eid), access_is_volatile(ctx, eid));
}

# the place or value a member of `obj_eid` is read from: an aggregate held whole where the
# object is one or is reached from one through fields alone, and otherwise its address, as the
# receiver of a place is
fun member_base(ctx: *lower_context.LowerContext, obj_eid: ast_id.ExprId, out_rec_ty: *type_kind.TypeId) res[value.Value, fail.Fail] {
    val obj_ty: type_kind.TypeId = type.strip_secret(ctx.s.types, lower_context.expr_type_of(ctx, obj_eid));
    if (!is_pointer_type(ctx, obj_ty) && rooted_whole(ctx, obj_eid)) {
        @out_rec_ty = obj_ty;
        ret lower_rvalue(ctx, obj_eid);
    }
    ret member_receiver(ctx, obj_eid, out_rec_ty);
}

# whether `eid` is an aggregate held whole, or reached from one through fields alone: a local
# bound to its value, a call's result or a literal of a type held whole
fun rooted_whole(ctx: *lower_context.LowerContext, eid: ast_id.ExprId) bool {
    var cur: ast_id.ExprId = eid;
    for (!ast_id.expr_is_nil(cur)) {
        if (is_pointer_type(ctx, type.strip_secret(ctx.s.types, lower_context.expr_type_of(ctx, cur)))) { ret false; }
        val res_expression: res[ast_expr.Expr, fail.Fail] = lower_context.expression(ctx, cur);
        if (sel res_expression.err) { ret false; }
        var held: ast_expr.Expr  = res_expression.ok;
        val e:    *ast_expr.Expr = ?held;
        if (e.kind == ast_expr.EXPR_KIND_MEMBER)  { cur = e.data.member.object; }
        or (e.kind == ast_expr.EXPR_KIND_PROJECT) { cur = e.data.project.object; }
        or (e.kind == ast_expr.EXPR_KIND_IDENT) {
            val opt_bound: opt[value.Value] = lower_context.lookup_direct(ctx, lower_context.expr_symbol_of(ctx, cur));
            if (sel opt_bound.some) { ret opt_bound.some.whole; }
            ret false;
        }
        or {
            if (e.kind != ast_expr.EXPR_KIND_CALL && e.kind != ast_expr.EXPR_KIND_STRUCT_LIT) { ret false; }
            val res_ir: res[Type, fail.Fail] = ir_type_of_expr(ctx, cur);
            if (sel res_ir.err) { ret false; }
            ret lower_context.holds_whole(ctx, lower_context.expr_type_of(ctx, cur), res_ir.ok);
        }
    }
    ret false;
}

# member `field_ix` of the record, union or tag `rec_ty` held whole in `base`, read from the
# object `obj_eid`: a tag's case is its member of the payload area that holds it, and a guarded
# payload in the debug profile traps when the discriminator does not select its case
fun whole_member(ctx: *lower_context.LowerContext, obj_eid: ast_id.ExprId, base: value.Value, rec_ty: type_kind.TypeId, field_ix: u32) res[value.Value, fail.Fail] {
    if (!type.is_tag(ctx.s.types, type.strip_secret(ctx.s.types, rec_ty))) { ret builder.emit_extract(?ctx.builder, base, field_ix); }
    if (ctx.checks && !place_fixed(ctx, obj_eid)) {
        val res_code: res[value.Value, fail.Fail] = builder.emit_extract(?ctx.builder, base, shape.TAG_DISCRIMINANT);
        if (sel res_code.err) { ret res_code; }
        val err_check: err[fail.Fail] = case_trap(ctx, res_code.ok, field_ix);
        if (sel err_check.err) { ret res[value.Value, fail.Fail].err{err_check.err}; }
    }
    val res_carried: res[shape.Carried, fail.Fail] = lower_context.tag_carried(ctx, rec_ty, field_ix);
    if (sel res_carried.err) { ret res[value.Value, fail.Fail].err{res_carried.err}; }
    val res_area: res[value.Value, fail.Fail] = builder.emit_extract(?ctx.builder, base, res_carried.ok.area);
    if (sel res_area.err) { ret res_area; }
    ret builder.emit_extract(?ctx.builder, res_area.ok, res_carried.ok.member);
}

fun lower_member_lvalue(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, e: *ast_expr.Expr) res[value.Value, fail.Fail] {
    val qsid: resolve.SymbolId = lower_context.expr_symbol_of(ctx, eid);
    if (!resolve.symbol_is_nil(qsid)) {
        ret symbol_lvalue(ctx, eid, qsid);
    }

    var rec_ty:   type_kind.TypeId;
    val res_base: res[value.Value, fail.Fail] = member_receiver(ctx, e.data.member.object, ?rec_ty);
    if (sel res_base.err) { ret res_base; }
    ret member_place(ctx, e.data.member.object, res_base.ok, rec_ty, field_index_of(ctx, rec_ty, e.data.member.name_id));
}

# the address of member `field_ix` of the record, union or tag `rec_ty` at `base`, the place
# the object `obj_eid` names; a guarded payload in the debug profile traps when the
# discriminator no longer selects its case
fun member_place(ctx: *lower_context.LowerContext, obj_eid: ast_id.ExprId, base: value.Value, rec_ty: type_kind.TypeId, field_ix: u32) res[value.Value, fail.Fail] {
    if (ctx.checks && type.is_tag(ctx.s.types, rec_ty) && !place_fixed(ctx, obj_eid)) {
        val err_check: err[fail.Fail] = emit_case_check(ctx, base, rec_ty, field_ix);
        if (sel err_check.err) { ret res[value.Value, fail.Fail].err{err_check.err}; }
    }
    ret field_gep(ctx, base, rec_ty, field_ix);
}

# whether nothing can change the place `eid` names between a guard on it and a read under
# that guard: it is reached by value, through fields alone, from a local or parameter that
# nothing takes the address of, in whole or in part, or names in an asm block. sema refuses a
# write by name under the guard, so only a pointer could change it, and none exists
fun place_fixed(ctx: *lower_context.LowerContext, eid: ast_id.ExprId) bool {
    var cur: ast_id.ExprId = eid;
    for (!ast_id.expr_is_nil(cur)) {
        if (is_pointer_type(ctx, type.strip_secret(ctx.s.types, lower_context.expr_type_of(ctx, cur)))) { ret false; }
        val res_expression: res[ast_expr.Expr, fail.Fail] = lower_context.expression(ctx, cur);
        if (sel res_expression.err) { ret false; }
        var held: ast_expr.Expr  = res_expression.ok;
        val e:    *ast_expr.Expr = ?held;
        if (e.kind == ast_expr.EXPR_KIND_MEMBER)  { cur = e.data.member.object; }
        or (e.kind == ast_expr.EXPR_KIND_PROJECT) { cur = e.data.project.object; }
        or {
            if (e.kind != ast_expr.EXPR_KIND_IDENT) { ret false; }
            val opt_named: opt[*resolve.Symbol] = lower_context.symbol_of(ctx, lower_context.expr_symbol_of(ctx, cur));
            if (sel opt_named.none) { ret false; }
            val sym:   *resolve.Symbol = opt_named.some;
            val moved: u8              = resolve.SYM_FLAG_STORED | resolve.SYM_FLAG_REACHED | resolve.SYM_FLAG_MODULE | resolve.SYM_FLAG_COMPTIME;
            ret (sym.kind == resolve.SYM_VAL || sym.kind == resolve.SYM_PARAM) && (sym.flags & moved) == 0;
        }
    }
    ret false;
}

# the address of a tag's discriminator, the first member of the structure it lowers to
fun disc_gep(ctx: *lower_context.LowerContext, base: value.Value, tag_ir: Type) res[value.Value, fail.Fail] {
    ret builder.emit_member(?ctx.builder, base, tag_ir, shape.TAG_DISCRIMINANT);
}

# the integer a tag's discriminator is held in
fun disc_type(ctx: *lower_context.LowerContext, tag_ir: Type) Type {
    ret irt.member(?ctx.m.types, tag_ir, shape.TAG_DISCRIMINANT);
}

# a guarded payload access in the debug profile traps when the discriminator no longer selects its case
fun emit_case_check(ctx: *lower_context.LowerContext, base: value.Value, tag_ty: type_kind.TypeId, case_ix: u32) err[fail.Fail] {
    val res_tag_ir: res[Type, fail.Fail] = lower_context.lower_type(ctx, tag_ty);
    if (sel res_tag_ir.err) { ret err[fail.Fail].err{res_tag_ir.err}; }
    val tag_ir:  Type = res_tag_ir.ok;
    val disc_ir: Type = disc_type(ctx, tag_ir);

    val res_dp: res[value.Value, fail.Fail] = disc_gep(ctx, base, tag_ir);
    if (sel res_dp.err) { ret err[fail.Fail].err{res_dp.err}; }
    val res_code: res[value.Value, fail.Fail] = builder.emit_load_discriminator(?ctx.builder, res_dp.ok, disc_ir);
    if (sel res_code.err) { ret err[fail.Fail].err{res_code.err}; }
    ret case_trap(ctx, res_code.ok, case_ix);
}

# trap unless the discriminator `code` selects case `case_ix`
fun case_trap(ctx: *lower_context.LowerContext, code: value.Value, case_ix: u32) err[fail.Fail] {
    val res_ok: res[value.Value, fail.Fail] = builder.emit_cmp_eq(?ctx.builder, code, value.const_int(case_ix::u64, code.ty));
    if (sel res_ok.err) { ret err[fail.Fail].err{res_ok.err}; }

    val res_cont: res[id.Block, fail.Fail] = builder.block_make(?ctx.builder);
    if (sel res_cont.err) { ret err[fail.Fail].err{res_cont.err}; }
    val res_trap: res[id.Block, fail.Fail] = builder.block_make(?ctx.builder);
    if (sel res_trap.err) { ret err[fail.Fail].err{res_trap.err}; }
    val cont: id.Block = res_cont.ok;
    val trap: id.Block = res_trap.ok;

    val err_cbr: err[fail.Fail] = builder.emit_cbr(?ctx.builder, res_ok.ok, cont, trap);
    if (sel err_cbr.err) { ret err_cbr; }
    builder.set_block(?ctx.builder, trap);
    val err_unreachable: err[fail.Fail] = builder.emit_unreachable(?ctx.builder);
    if (sel err_unreachable.err) { ret err_unreachable; }
    builder.set_block(?ctx.builder, cont);
    ret err[fail.Fail].ok{};
}

fun project_field_index(ctx: *lower_context.LowerContext, field_eid: ast_id.ExprId) res[u32, fail.Fail] {
    val res_field: res[comptime_value.CTValue, comptime_failure.EvalFail] = comptime.evaluate[lower_context.LowerContext](ctx.scope.ctx, ctx, ctx.caps, ctx.scope.a, lower_context.module_source(ctx), field_eid, ctx.s.interner);
    lower_context.record_eval_result(ctx, res_field);
    if (sel res_field.err) { ret res[u32, fail.Fail].err{fail.message(res_field.err.message)}; }
    val fv: comptime_value.CTValue = res_field.ok;
    if (!comptime_value.is_descriptor(fv)) {
        ret res[u32, fail.Fail].err{fail.message("lower: `v.[f]` field operand is not a comptime field descriptor")};
    }
    ret res[u32, fail.Fail].ok{fv.data.fld.index};
}

fun lower_project_rvalue(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, e: *ast_expr.Expr) res[value.Value, fail.Fail] {
    val obj_ty: type_kind.TypeId = type.strip_secret(ctx.s.types, lower_context.expr_type_of(ctx, e.data.project.object));
    if (!is_pointer_type(ctx, obj_ty) && rooted_whole(ctx, e.data.project.object)) {
        val res_fix: res[u32, fail.Fail] = project_field_index(ctx, e.data.project.field);
        if (sel res_fix.err) { ret res[value.Value, fail.Fail].err{res_fix.err}; }
        val res_whole: res[value.Value, fail.Fail] = lower_rvalue(ctx, e.data.project.object);
        if (sel res_whole.err) { ret res_whole; }
        ret whole_member(ctx, e.data.project.object, res_whole.ok, obj_ty, res_fix.ok);
    }
    val res_ptr: res[value.Value, fail.Fail] = lower_project_lvalue(ctx, eid, e);
    if (sel res_ptr.err) { ret res_ptr; }
    val res_ir: res[Type, fail.Fail] = ir_type_of_expr(ctx, eid);
    if (sel res_ir.err) { ret res[value.Value, fail.Fail].err{res_ir.err}; }
    ret rvalue_at(ctx, res_ptr.ok, res_ir.ok, lower_context.expr_type_of(ctx, eid), access_is_volatile(ctx, eid));
}

fun lower_project_lvalue(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, e: *ast_expr.Expr) res[value.Value, fail.Fail] {
    val res_fix: res[u32, fail.Fail] = project_field_index(ctx, e.data.project.field);
    if (sel res_fix.err) { ret res[value.Value, fail.Fail].err{res_fix.err}; }
    val field_ix: u32 = res_fix.ok;

    var rec_ty:   type_kind.TypeId;
    val res_base: res[value.Value, fail.Fail] = member_receiver(ctx, e.data.project.object, ?rec_ty);
    if (sel res_base.err) { ret res_base; }

    val base: value.Value = res_base.ok;
    if (ctx.checks && type.is_tag(ctx.s.types, rec_ty) && !place_fixed(ctx, e.data.project.object)) {
        val err_check: err[fail.Fail] = emit_case_check(ctx, base, rec_ty, field_ix);
        if (sel err_check.err) { ret res[value.Value, fail.Fail].err{err_check.err}; }
    }
    ret field_gep(ctx, base, rec_ty, field_ix);
}

fun vector_lane_of(ctx: *lower_context.LowerContext, e: *ast_expr.Expr) opt[res[u64, fail.Fail]] {
    val obj_ty: type_kind.TypeId = lower_context.expr_type_of(ctx, e.data.index.object);
    if (!type.is_vector(ctx.s.types, obj_ty)) { ret opt[res[u64, fail.Fail]].none{}; }
    if (ast_expr.is_range(?e.data.index))     { ret opt[res[u64, fail.Fail]].none{}; }

    val res_evaluate: res[comptime_value.CTValue, comptime_failure.EvalFail] = comptime.evaluate[lower_context.LowerContext](ctx.scope.ctx, ctx, ctx.caps, ctx.scope.a,
        lower_context.module_source(ctx), e.data.index.index, ctx.s.interner);

    lower_context.record_eval_result(ctx, res_evaluate);
    if (sel res_evaluate.err) {
        ret opt[res[u64, fail.Fail]].some{res[u64, fail.Fail].err{fail.message("lower: vector lane index is not a comptime constant")}};
    }
    val cv:       comptime_value.CTValue = res_evaluate.ok;
    val opt_lane: opt[u64]               = comptime_value.ct_int_u64(cv);
    var lane:     u64                    = 0;
    if (sel opt_lane.some) { lane = opt_lane.some; }
    if (!sel opt_lane.some) {
        ret opt[res[u64, fail.Fail]].some{res[u64, fail.Fail].err{fail.message("lower: vector lane index is not a non-negative integer constant")}};
    }
    ret opt[res[u64, fail.Fail]].some{res[u64, fail.Fail].ok{lane}};
}

fun lower_index_rvalue(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, e: *ast_expr.Expr) res[value.Value, fail.Fail] {
    if (is_vector_range(ctx, e)) { ret lower_vector_range_read(ctx, eid, e); }
    val opt_lane: opt[res[u64, fail.Fail]] = vector_lane_of(ctx, e);
    if (sel opt_lane.some) {
        ret lower_vector_lane_read(ctx, eid, e, opt_lane.some);
    }
    val res_ptr: res[value.Value, fail.Fail] = lower_index_lvalue(ctx, eid, e);
    if (sel res_ptr.err) { ret res_ptr; }
    val res_ir: res[Type, fail.Fail] = ir_type_of_expr(ctx, eid);
    if (sel res_ir.err) { ret res[value.Value, fail.Fail].err{res_ir.err}; }
    ret rvalue_at(ctx, res_ptr.ok, res_ir.ok, lower_context.expr_type_of(ctx, eid), access_is_volatile(ctx, eid));
}

fun lower_vector_lane_read(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, e: *ast_expr.Expr,
    lane: res[u64, fail.Fail]) res[value.Value, fail.Fail] {
    if (sel lane.err) { ret res[value.Value, fail.Fail].err{lane.err}; }

    val res_vec: res[value.Value, fail.Fail] = lower_rvalue(ctx, e.data.index.object);
    if (sel res_vec.err) { ret res_vec; }

    val res_ir: res[Type, fail.Fail] = ir_type_of_expr(ctx, eid);
    if (sel res_ir.err) { ret res[value.Value, fail.Fail].err{res_ir.err}; }

    ret builder.emit_vec_extract(?ctx.builder, res_vec.ok, value.const_int(lane.ok, builder.index_type(?ctx.builder)), res_ir.ok);
}

fun is_vector_range(ctx: *lower_context.LowerContext, e: *ast_expr.Expr) bool {
    if (e.kind != ast_expr.EXPR_KIND_INDEX || !ast_expr.is_range(?e.data.index)) { ret false; }
    ret type.is_vector(ctx.s.types, lower_context.expr_type_of(ctx, e.data.index.object));
}

# the first lane of a vector range, which sema holds to a comptime constant
fun vector_range_start(ctx: *lower_context.LowerContext, e: *ast_expr.Expr) res[u64, fail.Fail] {
    val res_evaluate: res[comptime_value.CTValue, comptime_failure.EvalFail] = comptime.evaluate[lower_context.LowerContext](ctx.scope.ctx, ctx, ctx.caps, ctx.scope.a,
        lower_context.module_source(ctx), e.data.index.index, ctx.s.interner);
    lower_context.record_eval_result(ctx, res_evaluate);
    if (sel res_evaluate.err) { ret res[u64, fail.Fail].err{fail.message("lower: vector range start is not a comptime constant")}; }
    val opt_start: opt[u64] = comptime_value.ct_int_u64(res_evaluate.ok);
    var start:     u64      = 0;
    if (sel opt_start.some) { start = opt_start.some; }
    if (!sel opt_start.some) {
        ret res[u64, fail.Fail].err{fail.message("lower: vector range start is not a non-negative integer constant")};
    }
    ret res[u64, fail.Fail].ok{start};
}

# `v[start, n]` is the vector of lanes `start` to `start + n - 1` of `v`
fun lower_vector_range_read(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, e: *ast_expr.Expr) res[value.Value, fail.Fail] {
    val res_start: res[u64, fail.Fail] = vector_range_start(ctx, e);
    if (sel res_start.err) { ret res[value.Value, fail.Fail].err{res_start.err}; }
    val res_vec: res[value.Value, fail.Fail] = lower_rvalue(ctx, e.data.index.object);
    if (sel res_vec.err) { ret res_vec; }
    val res_ir: res[Type, fail.Fail] = ir_type_of_expr(ctx, eid);
    if (sel res_ir.err) { ret res[value.Value, fail.Fail].err{res_ir.err}; }
    ret extract_lanes(ctx, res_vec.ok, res_start.ok, res_ir.ok, opt[bool].none{});
}

# the vector of type `ty` whose lanes are `vec`'s from lane `start` on, each
# extended to `ty`'s lane type under `extend`'s signedness when it is present:
# the range is one shuffle, and the extension one lane-wise conversion
fun extract_lanes(ctx: *lower_context.LowerContext, vec: value.Value, start: u64, ty: Type, extend: opt[bool]) res[value.Value, fail.Fail] {
    val t:     *types.Table = builder.types_of(?ctx.builder);
    val lanes: u32          = irt.lanes(t, ty);
    var range: Type         = ty;
    if (sel extend.some) {
        val res_vector: res[Type, fail.Fail] = irt.vector(t, irt.element(t, vec.ty), lanes);
        if (sel res_vector.err) { ret res[value.Value, fail.Fail].err{res_vector.err}; }
        range = res_vector.ok;
    }
    var picks: collections_vector.Vector[u32] = collections_vector.init[u32](ctx.s.alloc);
    fin { collections_vector.dnit[u32](?picks); }
    var k: u32 = 0;
    for (k < lanes) {
        val res_pushed: res[usize, A.Error] = collections_vector.push[u32](?picks, (start + k::u64)::u32);
        if (sel res_pushed.err) { ret res[value.Value, fail.Fail].err{fail.refused(res_pushed.err)}; }
        k = k + 1;
    }
    val res_emit_shuffle: res[value.Value, fail.Fail] = builder.emit_shuffle(?ctx.builder, range, vec, vec, picks.data, lanes);
    if (sel res_emit_shuffle.err) { ret res_emit_shuffle; }
    if (sel extend.none)          { ret res_emit_shuffle; }
    if (extend.some)              { ret builder.emit_sext(?ctx.builder, res_emit_shuffle.ok, ty); }
    ret builder.emit_zext(?ctx.builder, res_emit_shuffle.ok, ty);
}

fun lower_index_lvalue(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, e: *ast_expr.Expr) res[value.Value, fail.Fail] {
    val obj_ty: type_kind.TypeId = type.strip_secret(ctx.s.types, lower_context.expr_type_of(ctx, e.data.index.object));
    val is_ptr: bool             = is_pointer_type(ctx, obj_ty);

    var base: value.Value;
    if (is_ptr) {
        val res_base: res[value.Value, fail.Fail] = lower_rvalue(ctx, e.data.index.object);
        if (sel res_base.err) { ret res_base; }
        base = res_base.ok;
    }
    or {
        val res_base: res[value.Value, fail.Fail] = storage_address(ctx, e.data.index.object);
        if (sel res_base.err) { ret res_base; }
        base = res_base.ok;
    }

    val res_ix: res[value.Value, fail.Fail] = lower_rvalue(ctx, e.data.index.index);
    if (sel res_ix.err) { ret res_ix; }
    val res_widen: res[value.Value, fail.Fail] = widen_index(ctx, res_ix.ok, lower_context.expr_type_of(ctx, e.data.index.index));
    if (sel res_widen.err) { ret res_widen; }
    val ix: value.Value = res_widen.ok;

    if (is_ptr) {
        val opt_pt: opt[*type.Type] = type.get(ctx.s.types, obj_ty);
        if (sel opt_pt.none) { ret res[value.Value, fail.Fail].err{fail.message("lower: index base has no pointer type")}; }
        val pt: *type.Type = opt_pt.some;
        if (pt.kind != type_kind.TYPE_POINTER) {
            ret res[value.Value, fail.Fail].err{fail.message("lower: an index sema accepted reads through an untyped pointer")};
        }
        val res_elem_ir: res[Type, fail.Fail] = lower_context.lower_type(ctx, pt.data.pointer.base);
        if (sel res_elem_ir.err) { ret res[value.Value, fail.Fail].err{res_elem_ir.err}; }
        ret builder.emit_step(?ctx.builder, base, res_elem_ir.ok, ix);
    }

    val res_obj_ir: res[Type, fail.Fail] = lower_context.lower_type(ctx, obj_ty);
    if (sel res_obj_ir.err) { ret res[value.Value, fail.Fail].err{res_obj_ir.err}; }
    ret builder.emit_element(?ctx.builder, base, res_obj_ir.ok, ix);
}

# `$zeroize(p, count)` as one kept fill of the bytes of `count` pointees of `p`
fun lower_zeroize(ctx: *lower_context.LowerContext, e: *ast_expr.Expr) res[value.Value, fail.Fail] {
    val target:          ast_id.ExprId   = ctx.scope.a.expr_ids.data[e.data.call.args_start];
    val count:           ast_id.ExprId   = ctx.scope.a.expr_ids.data[e.data.call.args_start + 1];
    val opt_types_entry: opt[*type.Type] = type.get(ctx.s.types, type.strip_secret(ctx.s.types, lower_context.expr_type_of(ctx, target)));
    if (sel opt_types_entry.none)                            { ret res[value.Value, fail.Fail].err{fail.message("lower: `$zeroize` of a target sema typed as no pointer")}; }
    if (opt_types_entry.some.kind != type_kind.TYPE_POINTER) { ret res[value.Value, fail.Fail].err{fail.message("lower: `$zeroize` of a target sema typed as no pointer")}; }
    val res_elem: res[Type, fail.Fail] = lower_context.lower_type(ctx, opt_types_entry.some.data.pointer.base);
    if (sel res_elem.err) { ret res[value.Value, fail.Fail].err{res_elem.err}; }
    val res_addr: res[value.Value, fail.Fail] = lower_rvalue(ctx, target);
    if (sel res_addr.err) { ret res_addr; }
    val res_lower_rvalue: res[value.Value, fail.Fail] = lower_rvalue(ctx, count);
    if (sel res_lower_rvalue.err) { ret res_lower_rvalue; }
    val err_wiped: err[fail.Fail] = builder.emit_wipe(?ctx.builder, res_addr.ok, res_lower_rvalue.ok, is_signed_type(ctx, lower_context.expr_type_of(ctx, count)), res_elem.ok, lower_context.type_contains_secret(ctx, opt_types_entry.some.data.pointer.base));
    if (sel err_wiped.err) { ret res[value.Value, fail.Fail].err{err_wiped.err}; }
    ret res[value.Value, fail.Fail].ok{value.none()};
}

pub fun try_lower_comptime_intrinsic(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, e: *ast_expr.Expr) opt[res[value.Value, fail.Fail]] {
    if (intrinsic.is_path_call(ctx.scope.a, eid)) {
        ret opt[res[value.Value, fail.Fail]].some{lower_comptime_path(ctx, eid)};
    }
    val res_expression: res[ast_expr.Expr, fail.Fail] = lower_context.expression(ctx, e.data.call.callee);
    if (sel res_expression.err) { ret opt[res[value.Value, fail.Fail]].none{}; }
    var ce_value: ast_expr.Expr  = res_expression.ok;
    val ce:       *ast_expr.Expr = ?ce_value;
    if (ce.kind != ast_expr.EXPR_KIND_COMPTIME_IDENT) { ret opt[res[value.Value, fail.Fail]].none{}; }

    val id_of: intrinsic.Id = intrinsic.ident_intrinsic(lower_context.module_source(ctx), ce.data.comptime_ident.tok);
    if (id_of == intrinsic.TYPE_NAME || id_of == intrinsic.TYPE_ID) {
        val res_evaluate: res[comptime_value.CTValue, comptime_failure.EvalFail] = comptime.evaluate[lower_context.LowerContext](ctx.scope.ctx, ctx, ctx.caps, ctx.scope.a, lower_context.module_source(ctx), eid, ctx.s.interner);
        lower_context.record_eval_result(ctx, res_evaluate);
        if (sel res_evaluate.err) {
            ret opt[res[value.Value, fail.Fail]].some{res[value.Value, fail.Fail].err{fail.message(res_evaluate.err.message)}};
        }
        ret opt[res[value.Value, fail.Fail]].some{const_value_of(ctx, eid, res_evaluate.ok)};
    }
    if (id_of == intrinsic.ZEROIZE)                         { ret opt[res[value.Value, fail.Fail]].some{lower_zeroize(ctx, e)}; }
    if (!intrinsic.in_class(id_of, intrinsic.CLASS_LAYOUT)) { ret opt[res[value.Value, fail.Fail]].none{}; }

    val arity: u32 = intrinsic.row(id_of).args;
    if (e.data.call.args_len < arity ||
        e.data.call.args_start::usize + e.data.call.args_len::usize > ctx.scope.a.expr_ids.len) {
        ret opt[res[value.Value, fail.Fail]].some{res[value.Value, fail.Fail].err{fail.message("lower: comptime intrinsic argument index out of range")}};
    }
    val arg0_eid:  ast_id.ExprId        = ctx.scope.a.expr_ids.data[e.data.call.args_start];
    val op_ty:     type_kind.TypeId     = type.strip_secret(ctx.s.types, lower_context.expr_type_of(ctx, arg0_eid));
    val res_op_ir: res[Type, fail.Fail] = lower_context.laid_type(ctx, op_ty);
    if (sel res_op_ir.err) {
        ret opt[res[value.Value, fail.Fail]].some{res[value.Value, fail.Fail].err{res_op_ir.err}};
    }
    val op_ir: Type = res_op_ir.ok;

    val res_ir: res[Type, fail.Fail] = ir_type_of_expr(ctx, eid);
    if (sel res_ir.err) {
        ret opt[res[value.Value, fail.Fail]].some{res[value.Value, fail.Fail].err{res_ir.err}};
    }
    val rt: Type = res_ir.ok;

    var n: u64 = 0;
    if (id_of == intrinsic.SIZE_OF)  { n = builder.size_of(?ctx.builder, op_ir); }
    if (id_of == intrinsic.ALIGN_OF) { n = lower_context.storage_align(ctx, op_ir); }
    if (id_of == intrinsic.LENGTH_OF) {
        val opt_element_count: opt[u32] = type.element_count(ctx.s.types, op_ty);
        if (sel opt_element_count.none) {
            ret opt[res[value.Value, fail.Fail]].some{res[value.Value, fail.Fail].err{fail.message("lower: $length_of operand has no element count")}};
        }
        n = opt_element_count.some::u64;
    }
    if (id_of == intrinsic.OFFSET_OF) {
        val f_eid:          ast_id.ExprId                 = ctx.scope.a.expr_ids.data[e.data.call.args_start + 1];
        val res_expression: res[ast_expr.Expr, fail.Fail] = lower_context.expression(ctx, f_eid);
        if (sel res_expression.err) {
            ret opt[res[value.Value, fail.Fail]].some{res[value.Value, fail.Fail].err{fail.message("lower: offset_of field argument out of range")}};
        }
        if (res_expression.ok.kind != ast_expr.EXPR_KIND_IDENT) {
            ret opt[res[value.Value, fail.Fail]].some{res[value.Value, fail.Fail].err{fail.message("lower: offset_of field argument is not a bare identifier")}};
        }
        val field_ix:          u32                 = field_index_of(ctx, op_ty, res_expression.ok.data.ident.name);
        val res_member_offset: res[u64, fail.Fail] = lower_context.member_offset(ctx, op_ty, op_ir, field_ix);
        if (sel res_member_offset.err) { ret opt[res[value.Value, fail.Fail]].some{res[value.Value, fail.Fail].err{res_member_offset.err}}; }
        n = res_member_offset.ok;
    }
    val err_measured: err[fail.Fail] = lower_context.builder_state(ctx);
    if (sel err_measured.err) { ret opt[res[value.Value, fail.Fail]].some{res[value.Value, fail.Fail].err{err_measured.err}}; }

    val dst_ty:  type_kind.TypeId = type.strip_secret(ctx.s.types, lower_context.expr_type_of(ctx, eid));
    val opt_dst: opt[*type.Type]  = type.get(ctx.s.types, dst_ty);
    if (sel opt_dst.some) {
        val d: type_prim.PrimDesc = type_prim.prim_desc(opt_dst.some.kind);
        if (d.class == type_prim.PRIM_CLASS_INT) {
            var max: u64 = 0;
            if (d.signed) { max = (1::u64 << (d.bits - 1)::usize) - 1; }
            or            { max = ~(0::u64) >> (64 - d.bits)::usize; }
            # sema refused a measurement its destination cannot hold
            if (n > max) { ret opt[res[value.Value, fail.Fail]].some{res[value.Value, fail.Fail].err{fail.message("lower: a layout measurement sema admitted does not fit its type")}}; }
        }
    }

    ret opt[res[value.Value, fail.Fail]].some{res[value.Value, fail.Fail].ok{value.const_int(n, rt)}};
}

# the signature the call `e` of a C-variadic function naming `fixed` parameters is made
# through, its `argc` arguments past those typed as sema typed them
fun variadic_signature(ctx: *lower_context.LowerContext, e: *ast_expr.Expr, fixed: u32, argc: u32) res[Type, fail.Fail] {
    if (argc < fixed) { ret res[Type, fail.Fail].err{fail.message("lower: a C-variadic call passes fewer arguments than its function names")}; }
    val tail_len: u32               = argc - fixed;
    var tail:     *type_kind.TypeId = nil;
    fin {
        if (tail != nil) { A.deallocate[type_kind.TypeId](ctx.s.alloc, tail, tail_len::usize); }
    }
    if (tail_len > 0) {
        val res_made: res[*type_kind.TypeId, A.Error] = A.allocate[type_kind.TypeId](ctx.s.alloc, tail_len::usize);
        if (sel res_made.err) { ret res[Type, fail.Fail].err{fail.refused(res_made.err)}; }
        tail = res_made.ok;
    }
    # argument positions follow lower_call's, a spread pack taking one per element
    var pos: u32 = 0;
    var i:   u32 = 0;
    for (i < e.data.call.args_len) {
        val pool_ix: u32 = e.data.call.args_start + i;
        if (pool_ix::usize >= ctx.scope.a.expr_ids.len) { ret res[Type, fail.Fail].err{fail.message("lower: call argument index out of range")}; }
        val arg_eid: ast_id.ExprId = ctx.scope.a.expr_ids.data[pool_ix];
        val spread:  bool          = is_spread_expr(ctx, arg_eid);
        var n:       u32           = 1;
        if (spread) { n = ctx.pack_len; }
        var k: u32 = 0;
        for (k < n) {
            if (pos >= fixed) {
                if (pos >= argc) { ret res[Type, fail.Fail].err{fail.message("lower: a C-variadic call passes more arguments than it counted")}; }
                if (spread)      { tail[pos - fixed] = ctx.pack_types[k]; }
                or               { tail[pos - fixed] = lower_context.expr_type_of(ctx, arg_eid); }
            }
            pos = pos + 1;
            k   = k + 1;
        }
        i = i + 1;
    }
    if (pos != argc) { ret res[Type, fail.Fail].err{fail.message("lower: a C-variadic call passes fewer arguments than it counted")}; }
    val res_sig: res[lower_context.FnSig, fail.Fail] = lower_context.variadic_sig_of_type(ctx, lower_context.expr_type_of(ctx, e.data.call.callee), tail, tail_len);
    if (sel res_sig.err) { ret res[Type, fail.Fail].err{res_sig.err}; }
    ret res[Type, fail.Fail].ok{res_sig.ok.sig};
}

fun lower_call(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, e: *ast_expr.Expr) res[value.Value, fail.Fail] {
    val opt_intr: opt[res[value.Value, fail.Fail]] = try_lower_comptime_intrinsic(ctx, eid, e);
    if (sel opt_intr.some) { ret opt_intr.some; }

    # a function an `#[intrinsic]` of the selected target makes an instruction is called as it
    val opt_op: opt[lower_context.Declared] = callee_declared(ctx, e.data.call.callee);
    if (sel opt_op.some) {
        if (!intern.str_is_nil(opt_op.some.declaration.op_set)) { ret lower_target_op(ctx, eid, e, opt_op.some.declaration); }
    }

    # on a target whose pointers name a storage class, a direct call of a plain function is
    # resolved once its arguments are, since the classes they point into choose the copy
    val opt_plain: opt[lower_context.Declared] = classed_callee(ctx, e);
    var callee:    value.Value                 = value.none();
    var sig:       Type                        = irt.NONE;
    # an instance taking a pointer on such a target is called as the copy of it taking its
    # pointers in the classes its arguments point into
    var instance: u32 = sema_instance.NONE;
    if (sel opt_plain.some) {
        val res_plain: res[lower_context.FnSig, fail.Fail] = lower_context.fn_sig_of_type(ctx, lower_context.expr_type_of(ctx, e.data.call.callee));
        if (sel res_plain.err) { ret res[value.Value, fail.Fail].err{res_plain.err}; }
        sig = res_plain.ok.sig;
    }
    or {
        # the instance is never referenced as itself there, only as its copies, so its
        # signature is read without declaring it
        if (builder.classes(?ctx.builder) && instancing(ctx, e)) {
            val res_instance_id_of_call: res[u32, fail.Fail] = lower_context.instance_id_of_call(ctx, eid);
            if (sel res_instance_id_of_call.err) { ret res[value.Value, fail.Fail].err{res_instance_id_of_call.err}; }
            val item:      *sema_instance.Instance             = sema_instance.at(ctx.instances, res_instance_id_of_call.ok);
            val res_typed: res[lower_context.FnSig, fail.Fail] = lower_context.instance_ref_sig(ctx, item);
            if (sel res_typed.err) { ret res[value.Value, fail.Fail].err{res_typed.err}; }
            if (irt.takes_pointer(?ctx.m.types, res_typed.ok.sig)) {
                instance = res_instance_id_of_call.ok;
                sig      = res_typed.ok.sig;
            }
        }
        if (instance == sema_instance.NONE) {
            val res_callee: res[value.Value, fail.Fail] = lower_callee(ctx, eid, e);
            if (sel res_callee.err) { ret res_callee; }
            callee = res_callee.ok;
            sig    = callee.sig;
            if (builder.classes(?ctx.builder) && callee.kind == value.VAL_FN && irt.takes_pointer(?ctx.m.types, sig)) {
                ret res[value.Value, fail.Fail].err{lower_context.report_gate(ctx, diagnostic_kind.SPIRV_UNSUPPORTED, e.span,
                    "a call cannot spread a pack into a function taking a pointer where pointers name a storage class. name each argument")};
            }
        }
    }

    # a direct call is made through its callee's signature, an indirect one through the
    # function type it calls
    if (sel opt_plain.none && instance == sema_instance.NONE && callee.kind != value.VAL_FN) {
        val res_sig: res[lower_context.FnSig, fail.Fail] = lower_context.fn_sig_of_type(ctx, lower_context.expr_type_of(ctx, e.data.call.callee));
        if (sel res_sig.err) { ret res[value.Value, fail.Fail].err{res_sig.err}; }
        sig = res_sig.ok.sig;
    }

    # the callee's comptime parameters take no argument at run time
    val opt_cf: opt[lower_context.Declared] = callee_declared(ctx, e.data.call.callee);
    var cf:     lower_context.Declared      = lower_context.Declared{iface: nil, declaration: nil};
    var has_ct: bool                        = false;
    if (sel opt_cf.some) {
        cf     = opt_cf.some;
        has_ct = sema_interface.declaration_has_comptime_param(cf.iface, cf.declaration);
    }

    val argc:       u32  = e.data.call.args_len;
    val has_spread: bool = call_has_spread(ctx, e);
    var rtc:        u32  = argc;
    if (has_ct)     { rtc = runtime_arg_count(cf, argc); }
    if (has_spread) { rtc = (argc - 1) + ctx.pack_len; }

    var args: *value.Value = nil;
    fin {
        if (args != nil) { A.deallocate[value.Value](ctx.s.alloc, args, rtc::usize); }
    }
    if (rtc > 0) {
        val res_args: res[*value.Value, A.Error] = A.allocate[value.Value](ctx.s.alloc, rtc::usize);
        if (sel res_args.err) { ret res[value.Value, fail.Fail].err{fail.refused(res_args.err)}; }
        args = res_args.ok;

        var dst: u32 = 0;
        var i:   u32 = 0;
        for (i < argc) {
            if (has_ct && arg_is_comptime(cf, i)) {
                i = i + 1;
                cnt;
            }
            val pool_ix: u32 = e.data.call.args_start + i;
            if (pool_ix::usize >= ctx.scope.a.expr_ids.len) {
                ret res[value.Value, fail.Fail].err{fail.message("lower: call argument index out of range")};
            }
            val arg_eid: ast_id.ExprId = ctx.scope.a.expr_ids.data[pool_ix];
            if (has_spread && is_spread_expr(ctx, arg_eid)) {
                var ii: u32 = 0;
                for (ii < ctx.pack_len) {
                    val res_slot: res[value.Value, fail.Fail] = load_pack_slot(ctx, ii);
                    if (sel res_slot.err) { ret res_slot; }
                    args[dst] = res_slot.ok;
                    dst       = dst + 1;
                    ii        = ii + 1;
                }
                i = i + 1;
                cnt;
            }
            val saved_armed: bool          = ctx.borrow_armed;
            val saved_eid:   ast_id.ExprId = ctx.borrow_eid;
            val saved_hit:   bool          = ctx.borrow_hit;
            ctx.borrow_armed = arg_may_borrow(ctx, e, i, arg_eid, has_ct, cf);
            ctx.borrow_eid   = arg_eid;
            ctx.borrow_hit   = false;
            val res_arg: res[value.Value, fail.Fail] = lower_rvalue(ctx, arg_eid);
            ctx.borrow_armed = saved_armed;
            ctx.borrow_eid   = saved_eid;
            ctx.borrow_hit   = saved_hit;
            if (sel res_arg.err) { ret res_arg; }
            args[dst] = res_arg.ok;
            dst       = dst + 1;
            i         = i + 1;
        }
    }

    if (sel opt_plain.some) {
        val res_chosen: res[value.Value, fail.Fail] = classed_reference(ctx, e.data.call.callee, opt_plain.some, sig, args, rtc);
        if (sel res_chosen.err) { ret res_chosen; }
        callee = res_chosen.ok;
        sig    = callee.sig;
    }
    if (instance != sema_instance.NONE) {
        val res_chosen: res[value.Value, fail.Fail] = classed_instance(ctx, instance, sig, args, rtc);
        if (sel res_chosen.err) { ret res_chosen; }
        callee = res_chosen.ok;
        sig    = callee.sig;
    }

    # a call of a C-variadic function names its declared parameters and passes the rest
    # unnamed, through a signature stating every argument's type
    var named:     Named    = Named.all{};
    val opt_fixed: opt[u32] = lower_context.c_variadic_fixed(ctx, lower_context.expr_type_of(ctx, e.data.call.callee));
    if (sel opt_fixed.some) {
        val res_stated: res[Type, fail.Fail] = variadic_signature(ctx, e, opt_fixed.some, rtc);
        if (sel res_stated.err) { ret res[value.Value, fail.Fail].err{res_stated.err}; }
        sig   = res_stated.ok;
        named = Named.first{opt_fixed.some};
    }

    # a call whose result holds a secret gives a secret result
    builder.set_secret(?ctx.builder, lower_context.type_contains_secret(ctx, lower_context.expr_type_of(ctx, eid)));
    # an aggregate result lands in the armed destination, when this call is the armed expression
    val rt:       Type             = irt.result_of(?ctx.m.types, sig);
    val opt_into: opt[value.Value] = lower_context.take_into(ctx, rt);
    var slot:     bool             = irt.is_aggregate(?ctx.m.types, rt);
    if (sel opt_into.some) {
        builder.result_into(?ctx.builder, opt_into.some);
        slot = false;
    }
    or (lower_context.holds_whole(ctx, lower_context.expr_type_of(ctx, eid), rt)) {
        builder.result_whole(?ctx.builder);
        slot = false;
    }
    val res_call: res[value.Value, fail.Fail] = builder.emit_call_named(?ctx.builder, callee, sig, args, rtc, named);
    builder.set_secret(?ctx.builder, false);
    # an aggregate result lands in a slot of its own, stated as its type is
    if (!slot) { ret res_call; }
    if (sel res_call.ok) {
        val err_stated: err[fail.Fail] = lower_context.state_slot(ctx, res_call.ok, lower_context.expr_type_of(ctx, eid), rt);
        if (sel err_stated.err) { ret res[value.Value, fail.Fail].err{err_stated.err}; }
    }
    ret res_call;
}

# the function a direct call names, when it is a plain one called on a target whose pointers
# name a storage class: no comptime, pack or generic parameter, and no spread argument
fun classed_callee(ctx: *lower_context.LowerContext, e: *ast_expr.Expr) opt[lower_context.Declared] {
    if (!builder.classes(?ctx.builder) || e.data.call.type_args_len != 0 || call_has_spread(ctx, e)) { ret opt[lower_context.Declared].none{}; }
    val opt_cf: opt[lower_context.Declared] = callee_declared(ctx, e.data.call.callee);
    if (sel opt_cf.none) { ret opt_cf; }
    val d: *sema_interface.Declaration = opt_cf.some.declaration;
    if (sema_interface.declaration_has_comptime_param(opt_cf.some.iface, d)) { ret opt[lower_context.Declared].none{}; }
    if ((d.flags & sema_interface.DECLARATION_PACK) != 0 || d.generics > 0)  { ret opt[lower_context.Declared].none{}; }
    ret opt_cf;
}

# the function a plain direct call calls: the function itself where it takes no pointer,
# else the copy of it this module lowers taking its pointers in the classes the `n`
# arguments at `args` point into, one copy for each tuple of classes
fun classed_reference(ctx: *lower_context.LowerContext, callee_eid: ast_id.ExprId, cf: lower_context.Declared, sig: Type,
    args: *value.Value, n: u32) res[value.Value, fail.Fail] {
    val opt_sym: opt[*resolve.Symbol] = lower_context.symbol_of(ctx, lower_context.expr_symbol_of(ctx, callee_eid));
    if (sel opt_sym.none) { ret res[value.Value, fail.Fail].err{fail.message("lower: a callee names no symbol")}; }
    val res_ln: res[intern.StrId, fail.Fail] = reference_linkage_name(ctx, opt_sym.some);
    if (sel res_ln.err) { ret res[value.Value, fail.Fail].err{res_ln.err}; }
    val origin: module.ModuleId = resolve.origin_of(ctx.s, opt_sym.some);

    val res_copied: res[opt[Type], fail.Fail] = classed_signature(ctx, sig, args, n);
    if (sel res_copied.err) { ret res[value.Value, fail.Fail].err{res_copied.err}; }
    if (sel res_copied.ok.none) {
        val res_reached: res[Linkage, fail.Fail] = reference_linkage(ctx, opt_sym.some);
        if (sel res_reached.err) { ret res[value.Value, fail.Fail].err{res_reached.err}; }
        ret fn_reference(ctx, res_ln.ok, lower_context.bare_sig(sig), res_reached.ok, lower_context.declaration_mode(cf.declaration));
    }
    val res_made: res[u32, fail.Fail] = lower_context.class_copy(ctx, origin, cf.declaration.decl, res_ln.ok, res_copied.ok.some, sema_instance.NONE);
    if (sel res_made.err) { ret res[value.Value, fail.Fail].err{res_made.err}; }
    ret res[value.Value, fail.Fail].ok{value.fn(res_made.ok, builder.ptr_type(?ctx.builder), res_copied.ok.some)};
}

# a call of the function `op` declares an instruction of the target's catalog: the
# instruction itself, its operands the call's arguments in order and its result the
# function's return type. the set and the op are read in mirl's catalog of the target,
# which holds the rows masc states, and mirl's verifier holds the instruction to its row.
# the declaration is held to its row where it is declared (`op_intrinsic.declared`), and
# the call holds what depends on it: whether the catalog holds the instruction as an
# `intrinsic`, and the constants an index chain reads. the instruction reads and writes all
# memory, so no access moves across it and it is never deleted, as a barrier, whose row
# accesses nothing, must not be
fun lower_target_op(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, e: *ast_expr.Expr, op: *sema_interface.Declaration) res[value.Value, fail.Fail] {
    val set_name: str                = intern.text(ctx.s.interner, op.op_set);
    val op_name:  str                = intern.text(ctx.s.interner, op.op_name);
    val set_view: View               = View{data: set_name, len: str_len(set_name)};
    val op_view:  View               = View{data: op_name, len: str_len(op_name)};
    val named:    op_intrinsic.Named = op_intrinsic.named(ctx, set_name, op_name);
    if (sel named.no_catalog) {
        ret res[value.Value, fail.Fail].err{lower_context.report_gate(ctx, diagnostic_kind.OP_UNKNOWN, e.span,
            "the selected target's catalog holds no instruction set, so no `intrinsic` of it is an instruction")};
    }
    if (sel named.no_set) {
        ret res[value.Value, fail.Fail].err{op_refused(ctx, e.span, diagnostic.join(ctx.s.alloc, "the selected target's catalog holds no instruction set `", set_name, "`"))};
    }
    if (sel named.refused) {
        val why: op_written.Refusal = named.refused;
        if (sel why.construct) {
            ret res[value.Value, fail.Fail].err{op_refused(ctx, e.span, diagnostic.join(ctx.s.alloc, "`", op_name, "` is not an `intrinsic`. write it with ", why.construct))};
        }
        if (sel why.structure) {
            ret res[value.Value, fail.Fail].err{op_refused(ctx, e.span, diagnostic.join(ctx.s.alloc, "`", op_name, "` is not an `intrinsic`. ", why.structure))};
        }
        if (sel why.unavailable) {
            ret res[value.Value, fail.Fail].err{op_refused(ctx, e.span, diagnostic.join(ctx.s.alloc, "`", op_name, "` is not available as an `intrinsic`. ", why.unavailable))};
        }
    }
    if (sel named.no_row) {
        ret res[value.Value, fail.Fail].err{op_refused(ctx, e.span, diagnostic.join(ctx.s.alloc, "instruction set `", set_name, "` of the selected target holds no `", op_name, "`"))};
    }
    if (!(sel named.found)) { ret res[value.Value, fail.Fail].err{fail.message("lower: an `intrinsic` named neither a refusal nor an instruction")}; }
    val found:         op_intrinsic.Found = named.found;
    val err_withdrawn: err[fail.Fail]     = op_intrinsic.withdrawn(ctx, e.span, op_name, found.row);
    if (sel err_withdrawn.err) { ret res[value.Value, fail.Fail].err{err_withdrawn.err}; }
    val argc: u32          = e.data.call.args_len;
    val lead: u32          = found.lead;
    var args: *value.Value = nil;
    fin {
        if (args != nil) { A.deallocate[value.Value](ctx.s.alloc, args, argc::usize); }
    }
    if (argc > 0) {
        val res_made: res[*value.Value, A.Error] = A.allocate[value.Value](ctx.s.alloc, argc::usize);
        if (sel res_made.err) { ret res[value.Value, fail.Fail].err{fail.refused(res_made.err)}; }
        args = res_made.ok;
    }
    var i: u32 = 0;
    for (i < argc) {
        val arg_eid:     ast_id.ExprId               = ctx.scope.a.expr_ids.data[e.data.call.args_start + i];
        val res_lowered: res[value.Value, fail.Fail] = target_op_argument(ctx, arg_eid);
        if (sel res_lowered.err) { ret res_lowered; }
        args[i] = res_lowered.ok;
        i       = i + 1;
    }

    var results: [1]Type          = [1]Type{irt.NONE};
    var count:   usize            = 0;
    val ret_sem: type_kind.TypeId = lower_context.expr_type_of(ctx, eid);
    if (!type_kind.is_nil(ret_sem)) {
        val res_lowered: res[Type, fail.Fail] = lower_context.lower_type(ctx, ret_sem);
        if (sel res_lowered.err) { ret res[value.Value, fail.Fail].err{res_lowered.err}; }
        results[0] = res_lowered.ok;
        count      = 1;
    }
    var pointed: opt[u32] = opt[u32].none{};
    if (count == 1 && irt.is_ptr(?ctx.m.types, results[0])) { pointed = op_intrinsic.result_class(ctx, found.row); }
    val opt_chain: opt[u8] = op_intrinsic.chain_base(ctx, found.row);
    if (sel opt_chain.some) {
        val err_chained: err[fail.Fail] = chain_held(ctx, e, op_name, lead, opt_chain.some);
        if (sel err_chained.err) { ret res[value.Value, fail.Fail].err{err_chained.err}; }
        val at: u32 = opt_chain.some::u32 - lead;
        if (count == 1 && at < argc) { pointed = opt[u32].some{args[at].space}; }
    }
    val opt_last: opt[op_intrinsic.LastOf] = op_intrinsic.last_of(ctx, found.row);
    if (sel opt_last.some) {
        val err_last: err[fail.Fail] = last_held(ctx, e, op_name, lead, opt_last.some);
        if (sel err_last.err) { ret res[value.Value, fail.Fail].err{err_last.err}; }
    }
    # a pointer result no typing places is stated in the slot space, as no class of the source's
    if (count == 1 && irt.is_ptr(?ctx.m.types, results[0]) && !(sel pointed.some)) { results[0] = builder.ptr_type(?ctx.builder); }
    if (sel pointed.some)                                                          { results[0] = builder.ptr_in(?ctx.builder, pointed.some); }
    var instruction: native.Op = native.Op{
        set:     set_view,
        name:    op_view,
        results: Slice[Type]{data: ?results[0], size: count},
        reads:   true,
        writes:  true
    };
    val res_made: res[value.Value, fail.Fail] = builder.emit_target_op(?ctx.builder, ?instruction, args, argc);
    if (sel res_made.err) { ret res_made; }
    # a row nothing falls through after, as OpKill, ends its block, and what follows the call is unreachable
    if (op_intrinsic.ends(found.row)) {
        val err_ended: err[fail.Fail] = builder.emit_unreachable(?ctx.builder);
        if (sel err_ended.err) { ret res[value.Value, fail.Fail].err{err_ended.err}; }
    }
    var made: value.Value = res_made.ok;
    # a pointer result is an address into its storage class, which a call it is passed to is copied for
    if (sel pointed.some) {
        made.space = pointed.some;
        ret res[value.Value, fail.Fail].ok{made};
    }
    # a row whose result is a structure, as a sparse image read's residency code and texels,
    # gives the aggregate itself, which has no storage until the program stores it
    if (made.kind == value.VAL_SSA && irt.is_aggregate(?ctx.m.types, made.ty)) { ret res[value.Value, fail.Fail].ok{value.whole(made.id, made.ty, made.secret)}; }
    ret res_made;
}

# a call of a chained row held to what its indexes reach, each index argument's constant read where it folds to one
fun chain_held(ctx: *lower_context.LowerContext, e: *ast_expr.Expr, op_name: str, lead: u32, base: u8) err[fail.Fail] {
    val argc:  u32 = e.data.call.args_len;
    val first: u32 = base::u32 - lead + 1;
    if (first >= argc) { ret err[fail.Fail].ok{}; }
    val n:        u32                     = argc - first;
    val res_made: res[*opt[u64], A.Error] = A.allocate[opt[u64]](ctx.s.alloc, n::usize);
    if (sel res_made.err) { ret err[fail.Fail].err{fail.refused(res_made.err)}; }
    val indexes: *opt[u64] = res_made.ok;
    fin { A.deallocate[opt[u64]](ctx.s.alloc, indexes, n::usize); }
    var k: u32 = 0;
    for (k < n) {
        indexes[k] = opt[u64].none{};
        val arg_eid:      ast_id.ExprId                                          = ctx.scope.a.expr_ids.data[e.data.call.args_start + first + k];
        val res_evaluate: res[comptime_value.CTValue, comptime_failure.EvalFail] = comptime.evaluate[lower_context.LowerContext](ctx.scope.ctx, ctx, ctx.caps,
            ctx.scope.a, lower_context.module_source(ctx), arg_eid, ctx.s.interner);
        if (sel res_evaluate.ok) {
            if (res_evaluate.ok.kind == comptime_value.CT_KIND_INT) { indexes[k] = opt[u64].some{res_evaluate.ok.data.w.lo}; }
        }
        k = k + 1;
    }
    ret op_intrinsic.chained(ctx, e.span, op_name, lower_context.expr_type_of(ctx, e.data.call.callee), lead, base, indexes, n);
}

# a call's literal held to the record it indexes the last member of, where its argument folds to a constant. one that
# does not is refused in mirl, as every literal operand must be a constant
fun last_held(ctx: *lower_context.LowerContext, e: *ast_expr.Expr, op_name: str, lead: u32, at: op_intrinsic.LastOf) err[fail.Fail] {
    if (at.literal::u32 < lead) { ret err[fail.Fail].ok{}; }
    val k: u32 = at.literal::u32 - lead;
    if (k >= e.data.call.args_len) { ret err[fail.Fail].ok{}; }
    val arg_eid:      ast_id.ExprId                                          = ctx.scope.a.expr_ids.data[e.data.call.args_start + k];
    val res_evaluate: res[comptime_value.CTValue, comptime_failure.EvalFail] = comptime.evaluate[lower_context.LowerContext](ctx.scope.ctx, ctx, ctx.caps,
        ctx.scope.a, lower_context.module_source(ctx), arg_eid, ctx.s.interner);
    if (!sel res_evaluate.ok)                               { ret err[fail.Fail].ok{}; }
    if (res_evaluate.ok.kind != comptime_value.CT_KIND_INT) { ret err[fail.Fail].ok{}; }
    ret op_intrinsic.last_held(ctx, e.span, op_name, lower_context.expr_type_of(ctx, e.data.call.callee), lead, at, res_evaluate.ok.data.w.lo);
}

# an argument of a target op, the constant it folds to where its expression is an integer
# the front end evaluates, as `ACQUIRE | WORKGROUP_MEMORY` over module `val`s or `-1` is, and
# an array or vector literal of such arguments, element by element, so an operand that must
# be a constant receives one whether or not the build optimizes
fun target_op_argument(ctx: *lower_context.LowerContext, eid: ast_id.ExprId) res[value.Value, fail.Fail] {
    val res_evaluate: res[comptime_value.CTValue, comptime_failure.EvalFail] = comptime.evaluate[lower_context.LowerContext](ctx.scope.ctx, ctx, ctx.caps,
        ctx.scope.a, lower_context.module_source(ctx), eid, ctx.s.interner);
    if (sel res_evaluate.ok) {
        if (res_evaluate.ok.kind == comptime_value.CT_KIND_INT) { ret const_value_of(ctx, eid, res_evaluate.ok); }
    }
    val res_expression: res[ast_expr.Expr, fail.Fail] = lower_context.expression(ctx, eid);
    if (sel res_expression.err) { ret res[value.Value, fail.Fail].err{res_expression.err}; }
    var e: ast_expr.Expr = res_expression.ok;
    if (e.kind == ast_expr.EXPR_KIND_STRUCT_LIT && type.is_vector(ctx.s.types, lower_context.expr_type_of(ctx, eid))) { e = as_vector_lit(?e); }
    var opt_literal: opt[res[value.Value, fail.Fail]] = opt[res[value.Value, fail.Fail]].none{};
    if (e.kind == ast_expr.EXPR_KIND_VECTOR_LIT) { opt_literal = opt[res[value.Value, fail.Fail]].some{lower_vector_lit(ctx, eid, ?e, target_op_argument)}; }
    if (e.kind == ast_expr.EXPR_KIND_ARRAY_LIT)  { opt_literal = opt[res[value.Value, fail.Fail]].some{lower_array_lit(ctx, eid, ?e, target_op_argument)}; }
    if (sel opt_literal.some) {
        val res_made: res[value.Value, fail.Fail] = opt_literal.some;
        if (sel res_made.err) { ret res_made; }
        ret stamp_secret(ctx, eid, res_made.ok);
    }
    val res_value: res[value.Value, fail.Fail] = lower_rvalue(ctx, eid);
    if (sel res_value.err) { ret res_value; }
    # a truth value reaches the instruction as the i1 it holds, not the byte that stores it
    if (type.is_u1(ctx.s.types, lower_context.expr_type_of(ctx, eid))) { ret res[value.Value, fail.Fail].ok{builder.truth(?ctx.builder, res_value.ok)}; }
    ret res_value;
}

# an `intrinsic` call the target's catalog refuses, reported with `text` where it is written
fun op_refused(ctx: *lower_context.LowerContext, span: base_source.Span, text: res[str, fail.Fail]) fail.Fail {
    if (sel text.err) { ret text.err; }
    ret lower_context.report_gate(ctx, diagnostic_kind.OP_UNKNOWN, span, text.ok);
}

# the copy of the instance `id` of the module's set a call calls, taking its pointers in the
# classes the `n` arguments at `args` point into, one copy for each tuple of classes
fun classed_instance(ctx: *lower_context.LowerContext, id: u32, sig: Type, args: *value.Value, n: u32) res[value.Value, fail.Fail] {
    val item:     *sema_instance.Instance      = sema_instance.at(ctx.instances, id);
    val res_link: res[intern.StrId, fail.Fail] = lower_context.instance_link_name(ctx, item);
    if (sel res_link.err) { ret res[value.Value, fail.Fail].err{res_link.err}; }
    val res_copied: res[opt[Type], fail.Fail] = classed_signature(ctx, sig, args, n);
    if (sel res_copied.err) { ret res[value.Value, fail.Fail].err{res_copied.err}; }
    if (sel res_copied.ok.none) {
        val res_timed: res[ConstantTime, fail.Fail] = lower_context.mode_of(ctx, item.origin, item.decl);
        if (sel res_timed.err) { ret res[value.Value, fail.Fail].err{res_timed.err}; }
        ret fn_reference(ctx, res_link.ok, lower_context.bare_sig(sig), lower_context.image_linkage(ctx), res_timed.ok);
    }
    val res_made: res[u32, fail.Fail] = lower_context.class_copy(ctx, item.origin, item.decl, res_link.ok, res_copied.ok.some, id);
    if (sel res_made.err) { ret res[value.Value, fail.Fail].err{res_made.err}; }
    ret res[value.Value, fail.Fail].ok{value.fn(res_made.ok, builder.ptr_type(?ctx.builder), res_copied.ok.some)};
}

# `sig` restated with each pointer parameter in the class the argument of the `n` at `args`
# passed for it points into, none where it takes no pointer
fun classed_signature(ctx: *lower_context.LowerContext, sig: Type, args: *value.Value, n: u32) res[opt[Type], fail.Fail] {
    val t:      *types.Table                    = ?ctx.m.types;
    var params: collections_vector.Vector[Type] = collections_vector.init[Type](ctx.s.alloc);
    fin { collections_vector.dnit[Type](?params); }
    var pointers: bool = false;
    var i:        u32  = 0;
    for (i < irt.param_count(t, sig)) {
        var p: Type = irt.param_of(t, sig, i);
        if (irt.is_ptr(t, p) && i < n) {
            pointers = true;
            val a:         value.Value = args[i];
            val addressed: bool        = a.kind == value.VAL_GLOBAL || (a.kind == value.VAL_SSA && irt.is_ptr(t, a.ty));
            if (addressed) { p = builder.ptr_in(?ctx.builder, irt.space_of(t, a.ty)); }
        }
        val res_pushed: res[usize, A.Error] = collections_vector.push[Type](?params, p);
        if (sel res_pushed.err) { ret res[opt[Type], fail.Fail].err{fail.refused(res_pushed.err)}; }
        i = i + 1;
    }
    if (!pointers) { ret res[opt[Type], fail.Fail].ok{opt[Type].none{}}; }
    val res_copied: res[Type, fail.Fail] = irt.restated(t, sig, params.data, params.len::u32);
    if (sel res_copied.err) { ret res[opt[Type], fail.Fail].err{res_copied.err}; }
    ret res[opt[Type], fail.Fail].ok{opt[Type].some{res_copied.ok}};
}

# whether a call names an instance, as lower_callee reads it: a function with comptime or
# pack parameters, or one given type arguments
fun instancing(ctx: *lower_context.LowerContext, e: *ast_expr.Expr) bool {
    if (e.data.call.type_args_len != 0) { ret true; }
    val opt_cf: opt[lower_context.Declared] = callee_declared(ctx, e.data.call.callee);
    if (sel opt_cf.none) { ret false; }
    val cf: lower_context.Declared = opt_cf.some;
    ret sema_interface.declaration_has_comptime_param(cf.iface, cf.declaration) || (cf.declaration.flags & sema_interface.DECLARATION_PACK) != 0;
}

# whether call argument `ord` may be read in place: an aggregate place with no secret, read
# where no later argument can write anything, so the call's whole read of it still sees the
# value the argument had when it was evaluated
fun arg_may_borrow(ctx: *lower_context.LowerContext, e: *ast_expr.Expr, ord: u32, arg_eid: ast_id.ExprId,
    has_ct: bool, cf: lower_context.Declared) bool {
    val res_expression: res[ast_expr.Expr, fail.Fail] = lower_context.expression(ctx, arg_eid);
    if (sel res_expression.err) { ret false; }
    val k: ast_expr.ExprKind = res_expression.ok.kind;
    if (k != ast_expr.EXPR_KIND_IDENT && k != ast_expr.EXPR_KIND_MEMBER && k != ast_expr.EXPR_KIND_PROJECT
        && k != ast_expr.EXPR_KIND_INDEX && k != ast_expr.EXPR_KIND_UNARY) { ret false; }
    if (k == ast_expr.EXPR_KIND_UNARY && res_expression.ok.data.unary.op != ast_expr.UN_DEREF) { ret false; }
    if (lower_context.type_contains_secret(ctx, lower_context.expr_type_of(ctx, arg_eid)))     { ret false; }
    val res_ir: res[Type, fail.Fail] = ir_type_of_expr(ctx, arg_eid);
    if (sel res_ir.err)                    { ret false; }
    if (!is_aggregate_ir(ctx, res_ir.ok))  { ret false; }
    if (!expr_write_free(ctx, arg_eid, 0)) { ret false; }
    var j: u32 = ord + 1;
    for (j < e.data.call.args_len) {
        if (!(has_ct && arg_is_comptime(cf, j))) {
            val pool_ix: u32 = e.data.call.args_start + j;
            if (pool_ix::usize >= ctx.scope.a.expr_ids.len)                   { ret false; }
            if (!expr_write_free(ctx, ctx.scope.a.expr_ids.data[pool_ix], 0)) { ret false; }
        }
        j = j + 1;
    }
    ret true;
}

val WRITE_FREE_DEPTH: u32 = 32;

# whether evaluating `eid` can write no memory: a call, an assignment, or an address that
# escapes may, and anything unrecognized is taken to
fun expr_write_free(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, depth: u32) bool {
    if (ast_id.expr_is_nil(eid))  { ret true; }
    if (depth > WRITE_FREE_DEPTH) { ret false; }
    val res_expression: res[ast_expr.Expr, fail.Fail] = lower_context.expression(ctx, eid);
    if (sel res_expression.err) { ret false; }
    var e_value: ast_expr.Expr     = res_expression.ok;
    val e:       *ast_expr.Expr    = ?e_value;
    val k:       ast_expr.ExprKind = e.kind;
    val d:       u32               = depth + 1;
    if (k == ast_expr.EXPR_KIND_LIT_INT || k == ast_expr.EXPR_KIND_LIT_FLOAT || k == ast_expr.EXPR_KIND_LIT_CHAR
        || k == ast_expr.EXPR_KIND_LIT_STR || k == ast_expr.EXPR_KIND_LIT_NIL || k == ast_expr.EXPR_KIND_IDENT
        || k == ast_expr.EXPR_KIND_COMPTIME_IDENT || k == ast_expr.EXPR_KIND_TYPE_REF) { ret true; }
    if (k == ast_expr.EXPR_KIND_BINARY) {
        if (e.data.binary.op == ast_expr.BIN_ASSIGN) { ret false; }
        ret expr_write_free(ctx, e.data.binary.lhs, d) && expr_write_free(ctx, e.data.binary.rhs, d);
    }
    if (k == ast_expr.EXPR_KIND_UNARY) {
        if (e.data.unary.op == ast_expr.UN_ADDR) { ret false; }
        ret expr_write_free(ctx, e.data.unary.operand, d);
    }
    if (k == ast_expr.EXPR_KIND_INDEX) {
        ret expr_write_free(ctx, e.data.index.object, d) && expr_write_free(ctx, e.data.index.index, d)
            && expr_write_free(ctx, e.data.index.count, d);
    }
    if (k == ast_expr.EXPR_KIND_MEMBER)     { ret expr_write_free(ctx, e.data.member.object, d); }
    if (k == ast_expr.EXPR_KIND_PROJECT)    { ret expr_write_free(ctx, e.data.project.object, d) && expr_write_free(ctx, e.data.project.field, d); }
    if (k == ast_expr.EXPR_KIND_CAST)       { ret expr_write_free(ctx, e.data.cast.value, d); }
    if (k == ast_expr.EXPR_KIND_STRIP)      { ret expr_write_free(ctx, e.data.strip.value, d); }
    if (k == ast_expr.EXPR_KIND_SEL)        { ret expr_write_free(ctx, e.data.sel.place, d) && expr_write_free(ctx, e.data.sel.case_desc, d); }
    if (k == ast_expr.EXPR_KIND_ARRAY_LIT)  { ret pool_write_free(ctx, e.data.array_lit.elems_start, e.data.array_lit.elems_len, d); }
    if (k == ast_expr.EXPR_KIND_VECTOR_LIT) { ret pool_write_free(ctx, e.data.vector_lit.elems_start, e.data.vector_lit.elems_len, d); }
    if (k == ast_expr.EXPR_KIND_STRUCT_LIT) {
        if (!pool_write_free(ctx, e.data.struct_lit.elems_start, e.data.struct_lit.elems_len, d)) { ret false; }
        var i: u32 = 0;
        for (i < e.data.struct_lit.fields_len) {
            val pool_ix: u32 = e.data.struct_lit.fields_start + i;
            if (pool_ix::usize >= ctx.scope.a.field_inits.len)                         { ret false; }
            if (!expr_write_free(ctx, ctx.scope.a.field_inits.data[pool_ix].value, d)) { ret false; }
            i = i + 1;
        }
        ret true;
    }
    ret false;
}

fun pool_write_free(ctx: *lower_context.LowerContext, start: u32, len: u32, depth: u32) bool {
    var i: u32 = 0;
    for (i < len) {
        val pool_ix: u32 = start + i;
        if (pool_ix::usize >= ctx.scope.a.expr_ids.len)                       { ret false; }
        if (!expr_write_free(ctx, ctx.scope.a.expr_ids.data[pool_ix], depth)) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun runtime_arg_count(cf: lower_context.Declared, argc: u32) u32 {
    var len: u32 = 0;
    var i:   u32 = 0;
    for (i < argc) {
        if (!arg_is_comptime(cf, i)) { len = len + 1; }
        i = i + 1;
    }
    ret len;
}

fun arg_is_comptime(cf: lower_context.Declared, ord: u32) bool {
    if (cf.declaration == nil) { ret false; }
    val opt_param_at: opt[sema_interface.Param] = sema_interface.param_at(cf.iface, cf.declaration, ord);
    ret sel opt_param_at.some && opt_param_at.some.comptime;
}

fun lower_callee(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, e: *ast_expr.Expr) res[value.Value, fail.Fail] {
    val opt_cf: opt[lower_context.Declared] = callee_declared(ctx, e.data.call.callee);
    if (sel opt_cf.some) {
        val cf: lower_context.Declared = opt_cf.some;
        if (sema_interface.declaration_has_comptime_param(cf.iface, cf.declaration)) {
            if (cf.declaration.generics > 0) {
                ret res[value.Value, fail.Fail].err{fail.message("lower: comptime value parameters on a generic function are not supported")};
            }
            ret lower_instance_reference(ctx, eid);
        }
        if ((cf.declaration.flags & sema_interface.DECLARATION_PACK) != 0) { ret lower_instance_reference(ctx, eid); }
    }
    if (e.data.call.type_args_len == 0) {
        ret lower_rvalue(ctx, e.data.call.callee);
    }
    ret lower_instance_reference(ctx, eid);
}

# the function a call's callee names, as its module's interface describes it
fun callee_declared(ctx: *lower_context.LowerContext, callee: ast_id.ExprId) opt[lower_context.Declared] {
    val sid:     resolve.SymbolId     = lower_context.expr_symbol_of(ctx, callee);
    val opt_sym: opt[*resolve.Symbol] = lower_context.symbol_of(ctx, sid);
    if (sel opt_sym.none) { ret opt[lower_context.Declared].none{}; }
    val sym: *resolve.Symbol = opt_sym.some;
    if (sym.kind != resolve.SYM_FUN && sym.kind != resolve.SYM_IMPORTED)            { ret opt[lower_context.Declared].none{}; }
    if (sym.kind == resolve.SYM_IMPORTED && sym.definition_kind != resolve.SYM_FUN) { ret opt[lower_context.Declared].none{}; }
    val res_found: res[lower_context.Declared, fail.Fail] = lower_context.declared(ctx, sym);
    if (sel res_found.err)                                { ret opt[lower_context.Declared].none{}; }
    if (res_found.ok.declaration.kind != resolve.SYM_FUN) { ret opt[lower_context.Declared].none{}; }
    ret opt[lower_context.Declared].some{res_found.ok};
}

# where expression `eid` is written; an expression its syntax lacks records an internal failure
# and has the empty span
pub fun expr_span_of(ctx: *lower_context.LowerContext, eid: ast_id.ExprId) base_source.Span {
    val res_expression: res[ast_expr.Expr, fail.Fail] = lower_context.expression(ctx, eid);
    if (sel res_expression.ok)  { ret res_expression.ok.span; }
    if (sel res_expression.err) { lower_context.internal(ctx, res_expression.err); }
    var s: base_source.Span;
    s.offset = 0;
    s.len    = 0;
    ret s;
}

fun report_expr(ctx: *lower_context.LowerContext, k: diagnostic_kind.Kind, eid: ast_id.ExprId, message: str) res[value.Value, fail.Fail] {
    diagnostic.record(ctx.diags, k, ctx.scope.a.file_id, expr_span_of(ctx, eid), message);
    ret res[value.Value, fail.Fail].err{fail.reported()};
}

# a reference to the instance sema decided `eid` names, by its symbol and signature
fun lower_instance_reference(ctx: *lower_context.LowerContext, eid: ast_id.ExprId) res[value.Value, fail.Fail] {
    val res_instance_id_of_call: res[u32, fail.Fail] = lower_context.instance_id_of_call(ctx, eid);
    if (sel res_instance_id_of_call.err) { ret res[value.Value, fail.Fail].err{res_instance_id_of_call.err}; }
    val item: *sema_instance.Instance = sema_instance.at(ctx.instances, res_instance_id_of_call.ok);

    val res_link: res[intern.StrId, fail.Fail] = lower_context.instance_link_name(ctx, item);
    if (sel res_link.err) { ret res[value.Value, fail.Fail].err{res_link.err}; }
    val err_reached: err[fail.Fail] = lower_context.reach_instance(ctx, res_instance_id_of_call.ok, res_link.ok, lower_context.building_constant_time(ctx));
    if (sel err_reached.err) { ret res[value.Value, fail.Fail].err{err_reached.err}; }

    val res_sig: res[lower_context.FnSig, fail.Fail] = lower_context.instance_ref_sig(ctx, item);
    if (sel res_sig.err) { ret res[value.Value, fail.Fail].err{res_sig.err}; }
    val res_timed: res[ConstantTime, fail.Fail] = lower_context.mode_of(ctx, item.origin, item.decl);
    if (sel res_timed.err) { ret res[value.Value, fail.Fail].err{res_timed.err}; }
    ret fn_reference(ctx, res_link.ok, res_sig.ok, lower_context.image_linkage(ctx), res_timed.ok);
}

fun lower_binary(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, e: *ast_expr.Expr) res[value.Value, fail.Fail] {
    val op: ast_expr.BinOp = e.data.binary.op;

    if (op == ast_expr.BIN_ASSIGN)                       { ret lower_assign(ctx, eid, e); }
    if (op == ast_expr.BIN_AND || op == ast_expr.BIN_OR) { ret lower_logical(ctx, e); }

    val res_lhs: res[value.Value, fail.Fail] = lower_rvalue(ctx, e.data.binary.lhs);
    if (sel res_lhs.err) { ret res_lhs; }
    val lhs: value.Value = res_lhs.ok;

    val res_rhs: res[value.Value, fail.Fail] = lower_rvalue(ctx, e.data.binary.rhs);
    if (sel res_rhs.err) { ret res_rhs; }
    val rhs: value.Value = res_rhs.ok;

    val lty:    type_kind.TypeId = lower_context.expr_type_of(ctx, e.data.binary.lhs);
    val rty:    type_kind.TypeId = lower_context.expr_type_of(ctx, e.data.binary.rhs);
    val signed: bool             = is_signed_type(ctx, lty);

    if (type.is_vector(ctx.s.types, lty)) {
        ret lower_vector_binary(ctx, op, lhs, rhs, lty);
    }

    if (is_compare_binop(op)) { ret lower_cmp(ctx, op, lhs, lty, rhs, rty); }

    if (op == ast_expr.BIN_ADD) { ret builder.emit_add(?ctx.builder, lhs, rhs); }
    if (op == ast_expr.BIN_SUB) { ret builder.emit_sub(?ctx.builder, lhs, rhs); }
    if (op == ast_expr.BIN_MUL) { ret builder.emit_mul(?ctx.builder, lhs, rhs); }
    if (op == ast_expr.BIN_DIV) {
        if (signed) { ret builder.emit_div_s(?ctx.builder, lhs, rhs); }
        ret builder.emit_div_u(?ctx.builder, lhs, rhs);
    }
    if (op == ast_expr.BIN_MOD) {
        if (signed) { ret builder.emit_rem_s(?ctx.builder, lhs, rhs); }
        ret builder.emit_rem_u(?ctx.builder, lhs, rhs);
    }
    if (op == ast_expr.BIN_BIT_AND) { ret builder.emit_and(?ctx.builder, lhs, rhs); }
    if (op == ast_expr.BIN_BIT_OR)  { ret builder.emit_or(?ctx.builder, lhs, rhs); }
    if (op == ast_expr.BIN_BIT_XOR) { ret builder.emit_xor(?ctx.builder, lhs, rhs); }
    if (op == ast_expr.BIN_SHL)     { ret builder.emit_shl(?ctx.builder, lhs, rhs); }
    if (op == ast_expr.BIN_SHR) {
        if (signed) { ret builder.emit_shr_s(?ctx.builder, lhs, rhs); }
        ret builder.emit_shr_u(?ctx.builder, lhs, rhs);
    }

    ret res[value.Value, fail.Fail].err{fail.message("lower: unsupported binary operator")};
}

fun lower_vector_binary(ctx: *lower_context.LowerContext, op: ast_expr.BinOp, lhs: value.Value, rhs: value.Value, lty: type_kind.TypeId) res[value.Value, fail.Fail] {
    if (is_compare_binop(op)) { ret lower_vector_compare(ctx, op, lhs, rhs, vector_lane_signed(ctx, lty)); }

    if (op == ast_expr.BIN_ADD) { ret builder.emit_add(?ctx.builder, lhs, rhs); }
    if (op == ast_expr.BIN_SUB) { ret builder.emit_sub(?ctx.builder, lhs, rhs); }
    if (op == ast_expr.BIN_MUL) { ret builder.emit_mul(?ctx.builder, lhs, rhs); }
    if (op == ast_expr.BIN_DIV) {
        if (vector_lane_signed(ctx, lty)) { ret builder.emit_div_s(?ctx.builder, lhs, rhs); }
        ret builder.emit_div_u(?ctx.builder, lhs, rhs);
    }
    if (op == ast_expr.BIN_BIT_AND) { ret builder.emit_and(?ctx.builder, lhs, rhs); }
    if (op == ast_expr.BIN_BIT_OR)  { ret builder.emit_or(?ctx.builder, lhs, rhs); }
    if (op == ast_expr.BIN_BIT_XOR) { ret builder.emit_xor(?ctx.builder, lhs, rhs); }
    if (op == ast_expr.BIN_SHL)     { ret builder.emit_shl(?ctx.builder, lhs, rhs); }
    if (op == ast_expr.BIN_SHR) {
        if (vector_lane_signed(ctx, lty)) { ret builder.emit_shr_s(?ctx.builder, lhs, rhs); }
        ret builder.emit_shr_u(?ctx.builder, lhs, rhs);
    }

    ret res[value.Value, fail.Fail].err{fail.message("lower: unsupported vector binary operator")};
}

fun lower_vector_compare(ctx: *lower_context.LowerContext, op: ast_expr.BinOp, lhs: value.Value, rhs: value.Value, signed: bool) res[value.Value, fail.Fail] {
    val res_mask: res[Type, fail.Fail] = vector_mask_ir(ctx, lhs.ty);
    if (sel res_mask.err) { ret res[value.Value, fail.Fail].err{res_mask.err}; }
    val mask: Type = res_mask.ok;

    if (op == ast_expr.BIN_EQ)  { ret builder.emit_vcompare(?ctx.builder, opcode.EQ, opcode.FEQ_O, lhs, rhs, mask); }
    if (op == ast_expr.BIN_NEQ) { ret builder.emit_vcompare(?ctx.builder, opcode.NE, opcode.FNE_U, lhs, rhs, mask); }
    if (op == ast_expr.BIN_LT)  { ret builder.emit_vcompare(?ctx.builder, vec_cmp_lt(signed), opcode.FLT_O, lhs, rhs, mask); }
    if (op == ast_expr.BIN_LEQ) { ret builder.emit_vcompare(?ctx.builder, vec_cmp_le(signed), opcode.FLE_O, lhs, rhs, mask); }
    if (op == ast_expr.BIN_GT)  { ret builder.emit_vcompare(?ctx.builder, vec_cmp_lt(signed), opcode.FLT_O, rhs, lhs, mask); }
    if (op == ast_expr.BIN_GEQ) { ret builder.emit_vcompare(?ctx.builder, vec_cmp_le(signed), opcode.FLE_O, rhs, lhs, mask); }
    ret res[value.Value, fail.Fail].err{fail.message("lower: unsupported vector comparison operator")};
}

fun vec_cmp_lt(signed: bool) Opcode {
    if (signed) { ret opcode.LT_S; }
    ret opcode.LT_U;
}

fun vec_cmp_le(signed: bool) Opcode {
    if (signed) { ret opcode.LE_S; }
    ret opcode.LE_U;
}

fun vector_lane_signed(ctx: *lower_context.LowerContext, lty: type_kind.TypeId) bool {
    val base: type_kind.TypeId = type.strip_secret(ctx.s.types, lty);
    ret type_prim.prim_desc(type.vector_element(ctx.s.types, base)).signed;
}

# the mask a comparison of `vec_ir` vectors gives: an integer lane as wide as each of theirs
fun vector_mask_ir(ctx: *lower_context.LowerContext, vec_ir: Type) res[Type, fail.Fail] {
    val t: *types.Table = builder.types_of(?ctx.builder);
    if (!irt.is_vector(t, vec_ir)) { ret res[Type, fail.Fail].err{fail.message("lower: vector compare operand is not a vector")}; }
    val lane: Type = irt.element(t, vec_ir);
    var bits: u32  = irt.int_width(t, lane);
    if (irt.is_float(t, lane)) { bits = irt.float_width(t, lane); }
    val res_elem: res[Type, fail.Fail] = irt.int(t, bits);
    if (sel res_elem.err) { ret res_elem; }
    ret irt.vector(t, res_elem.ok, irt.lanes(t, vec_ir));
}

fun is_compare_binop(op: ast_expr.BinOp) bool {
    ret op == ast_expr.BIN_EQ || op == ast_expr.BIN_NEQ ||
        op == ast_expr.BIN_LT || op == ast_expr.BIN_LEQ ||
        op == ast_expr.BIN_GT || op == ast_expr.BIN_GEQ;
}

fun lower_cmp(ctx: *lower_context.LowerContext, op: ast_expr.BinOp, lhs: value.Value, lty: type_kind.TypeId, rhs: value.Value, rty: type_kind.TypeId) res[value.Value, fail.Fail] {
    if (is_float_type(ctx, lty) || is_float_type(ctx, rty)) {
        var fl:        value.Value    = lhs;
        var fr:        value.Value    = rhs;
        val err_unify: err[fail.Fail] = unify_float_compare_widths(ctx, ?fl, lty, ?fr, rty);
        if (sel err_unify.err) { ret res[value.Value, fail.Fail].err{err_unify.err}; }
        ret emit_cmp_int(ctx, op, false, fl, fr);
    }

    val ls: bool = is_signed_type(ctx, lty);
    val rs: bool = is_signed_type(ctx, rty);

    if (ls == rs) {
        var sl:        value.Value    = lhs;
        var sr:        value.Value    = rhs;
        val err_unify: err[fail.Fail] = unify_int_compare_widths(ctx, ?sl, lty, ?sr, rty);
        if (sel err_unify.err) { ret res[value.Value, fail.Fail].err{err_unify.err}; }
        ret emit_cmp_int(ctx, op, ls, sl, sr);
    }

    var s_val:    value.Value      = lhs;
    var s_ty:     type_kind.TypeId = lty;
    var u_val:    value.Value      = rhs;
    var u_ty:     type_kind.TypeId = rty;
    var s_is_lhs: bool             = true;
    if (!ls) {
        s_val    = rhs;
        s_ty     = rty;
        u_val    = lhs;
        u_ty     = lty;
        s_is_lhs = false;
    }

    # a mixed-sign compare runs at the register width, or at the wider operand's
    # width when one is wider than a register (u128 against i64, i128 against u128)
    var w: u32 = 64;
    if (scalar_bits(ctx, s_ty) > w) { w = scalar_bits(ctx, s_ty); }
    if (scalar_bits(ctx, u_ty) > w) { w = scalar_bits(ctx, u_ty); }

    val res_tyw: res[Type, fail.Fail] = irt.int(?ctx.m.types, w);
    if (sel res_tyw.err) { ret res[value.Value, fail.Fail].err{res_tyw.err}; }
    val tyw: Type = res_tyw.ok;

    val res_sw: res[value.Value, fail.Fail] = widen_signed_to(ctx, s_val, s_ty, tyw, w);
    if (sel res_sw.err) { ret res_sw; }
    val sw: value.Value = res_sw.ok;

    if (scalar_bits(ctx, u_ty) < w) {
        val res_uw: res[value.Value, fail.Fail] = builder.emit_zext(?ctx.builder, u_val, tyw);
        if (sel res_uw.err) { ret res_uw; }
        val uw: value.Value = res_uw.ok;
        if (s_is_lhs) { ret emit_cmp_int(ctx, op, true, sw, uw); }
        ret emit_cmp_int(ctx, op, true, uw, sw);
    }

    ret lower_cmp_signed_wide(ctx, op, sw, u_val, s_is_lhs, tyw);
}

fun emit_cmp_int(ctx: *lower_context.LowerContext, op: ast_expr.BinOp, signed: bool, lhs: value.Value, rhs: value.Value) res[value.Value, fail.Fail] {
    if (op == ast_expr.BIN_EQ)  { ret builder.emit_cmp_eq(?ctx.builder, lhs, rhs); }
    if (op == ast_expr.BIN_NEQ) { ret builder.emit_cmp_ne(?ctx.builder, lhs, rhs); }
    if (op == ast_expr.BIN_LT) {
        if (signed) { ret builder.emit_cmp_lt_s(?ctx.builder, lhs, rhs); }
        ret builder.emit_cmp_lt_u(?ctx.builder, lhs, rhs);
    }
    if (op == ast_expr.BIN_LEQ) {
        if (signed) { ret builder.emit_cmp_le_s(?ctx.builder, lhs, rhs); }
        ret builder.emit_cmp_le_u(?ctx.builder, lhs, rhs);
    }
    if (op == ast_expr.BIN_GT) {
        if (signed) { ret builder.emit_cmp_lt_s(?ctx.builder, rhs, lhs); }
        ret builder.emit_cmp_lt_u(?ctx.builder, rhs, lhs);
    }
    if (op == ast_expr.BIN_GEQ) {
        if (signed) { ret builder.emit_cmp_le_s(?ctx.builder, rhs, lhs); }
        ret builder.emit_cmp_le_u(?ctx.builder, rhs, lhs);
    }
    ret res[value.Value, fail.Fail].err{fail.message("lower: unsupported comparison operator")};
}

fun widen_signed_to(ctx: *lower_context.LowerContext, v: value.Value, vty: type_kind.TypeId, tyw: Type, w: u32) res[value.Value, fail.Fail] {
    if (scalar_bits(ctx, vty) >= w) { ret res[value.Value, fail.Fail].ok{v}; }
    ret builder.emit_sext(?ctx.builder, v, tyw);
}

fun lower_cmp_signed_wide(ctx: *lower_context.LowerContext, op: ast_expr.BinOp, s64: value.Value, u: value.Value, s_is_lhs: bool, ty64: Type) res[value.Value, fail.Fail] {
    var nop: ast_expr.BinOp = op;
    if (!s_is_lhs) { nop = swap_cmp_op(op); }
    val zero: value.Value = value.const_int(0, ty64);

    if (nop == ast_expr.BIN_LT) {
        ret cmp_or(ctx, builder.emit_cmp_lt_s(?ctx.builder, s64, zero),
            builder.emit_cmp_lt_u(?ctx.builder, s64, u));
    }
    if (nop == ast_expr.BIN_LEQ) {
        ret cmp_or(ctx, builder.emit_cmp_lt_s(?ctx.builder, s64, zero),
            builder.emit_cmp_le_u(?ctx.builder, s64, u));
    }
    if (nop == ast_expr.BIN_GT) {
        ret cmp_and(ctx, builder.emit_cmp_le_s(?ctx.builder, zero, s64),
            builder.emit_cmp_lt_u(?ctx.builder, u, s64));
    }
    if (nop == ast_expr.BIN_GEQ) {
        ret cmp_and(ctx, builder.emit_cmp_le_s(?ctx.builder, zero, s64),
            builder.emit_cmp_le_u(?ctx.builder, u, s64));
    }
    if (nop == ast_expr.BIN_EQ) {
        ret cmp_and(ctx, builder.emit_cmp_le_s(?ctx.builder, zero, s64),
            builder.emit_cmp_eq(?ctx.builder, s64, u));
    }
    if (nop == ast_expr.BIN_NEQ) {
        ret cmp_or(ctx, builder.emit_cmp_lt_s(?ctx.builder, s64, zero),
            builder.emit_cmp_ne(?ctx.builder, s64, u));
    }
    ret res[value.Value, fail.Fail].err{fail.message("lower: unsupported comparison operator")};
}

fun swap_cmp_op(op: ast_expr.BinOp) ast_expr.BinOp {
    if (op == ast_expr.BIN_LT)  { ret ast_expr.BIN_GT; }
    if (op == ast_expr.BIN_LEQ) { ret ast_expr.BIN_GEQ; }
    if (op == ast_expr.BIN_GT)  { ret ast_expr.BIN_LT; }
    if (op == ast_expr.BIN_GEQ) { ret ast_expr.BIN_LEQ; }
    ret op;
}

fun cmp_or(ctx: *lower_context.LowerContext, a: res[value.Value, fail.Fail], b: res[value.Value, fail.Fail]) res[value.Value, fail.Fail] {
    if (sel a.err) { ret a; }
    if (sel b.err) { ret b; }
    ret builder.emit_or(?ctx.builder, a.ok, b.ok);
}

fun cmp_and(ctx: *lower_context.LowerContext, a: res[value.Value, fail.Fail], b: res[value.Value, fail.Fail]) res[value.Value, fail.Fail] {
    if (sel a.err) { ret a; }
    if (sel b.err) { ret b; }
    ret builder.emit_and(?ctx.builder, a.ok, b.ok);
}

fun unify_float_compare_widths(ctx: *lower_context.LowerContext, lhs: *value.Value, lty: type_kind.TypeId, rhs: *value.Value, rty: type_kind.TypeId) err[fail.Fail] {
    val lw: u32 = scalar_bits(ctx, lty);
    val rw: u32 = scalar_bits(ctx, rty);
    if (lw == rw) { ret err[fail.Fail].ok{}; }
    if (lw < rw) {
        val res_ext: res[value.Value, fail.Fail] = builder.emit_fp_ext(?ctx.builder, @lhs, rhs.ty);
        if (sel res_ext.err) { ret err[fail.Fail].err{res_ext.err}; }
        @lhs = res_ext.ok;
        ret err[fail.Fail].ok{};
    }
    val res_ext: res[value.Value, fail.Fail] = builder.emit_fp_ext(?ctx.builder, @rhs, lhs.ty);
    if (sel res_ext.err) { ret err[fail.Fail].err{res_ext.err}; }
    @rhs = res_ext.ok;
    ret err[fail.Fail].ok{};
}

fun unify_int_compare_widths(ctx: *lower_context.LowerContext, lhs: *value.Value, lty: type_kind.TypeId, rhs: *value.Value, rty: type_kind.TypeId) err[fail.Fail] {
    val lw: u32 = scalar_bits(ctx, lty);
    val rw: u32 = scalar_bits(ctx, rty);
    if (lw == 0 || rw == 0 || lw == rw) { ret err[fail.Fail].ok{}; }
    if (lw < rw) {
        val res_ext: res[value.Value, fail.Fail] = extend_int_value(ctx, @lhs, lty, rhs.ty);
        if (sel res_ext.err) { ret err[fail.Fail].err{res_ext.err}; }
        @lhs = res_ext.ok;
        ret err[fail.Fail].ok{};
    }
    val res_ext: res[value.Value, fail.Fail] = extend_int_value(ctx, @rhs, rty, lhs.ty);
    if (sel res_ext.err) { ret err[fail.Fail].err{res_ext.err}; }
    @rhs = res_ext.ok;
    ret err[fail.Fail].ok{};
}

fun extend_int_value(ctx: *lower_context.LowerContext, v: value.Value, from: type_kind.TypeId, to: Type) res[value.Value, fail.Fail] {
    if (is_signed_type(ctx, from)) { ret builder.emit_sext(?ctx.builder, v, to); }
    ret builder.emit_zext(?ctx.builder, v, to);
}

fun lower_assign(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, e: *ast_expr.Expr) res[value.Value, fail.Fail] {
    val opt_stored: opt[res[value.Value, fail.Fail]] = lower_vector_store(ctx, e);
    if (sel opt_stored.some) { ret opt_stored.some; }

    # the snapshot is only needed when the value is used again or the destination's address
    # expression can write memory
    var borrowed: bool                        = false;
    val res_rhs:  res[value.Value, fail.Fail] = lower_stored_rvalue(ctx, e.data.binary.rhs,
        ast_id.expr_same(eid, ctx.discard_eid) && expr_write_free(ctx, e.data.binary.lhs, 0), ?borrowed);
    if (sel res_rhs.err) { ret res_rhs; }
    val rhs: value.Value = res_rhs.ok;

    val res_wrote: res[bool, fail.Fail] = lower_vector_lane_write(ctx, e.data.binary.lhs, rhs);
    if (sel res_wrote.err) { ret res[value.Value, fail.Fail].err{res_wrote.err}; }
    if (res_wrote.ok)      { ret res[value.Value, fail.Fail].ok{rhs}; }

    val res_lhs: res[value.Value, fail.Fail] = lower_lvalue(ctx, e.data.binary.lhs);
    if (sel res_lhs.err) { ret res_lhs; }
    val ptr: value.Value = res_lhs.ok;

    val err_store: err[fail.Fail] = store_stated(ctx, rhs, ptr, lower_context.expr_type_of(ctx, e.data.binary.lhs), access_is_volatile(ctx, e.data.binary.lhs));
    if (sel err_store.err) { ret res[value.Value, fail.Fail].err{err_store.err}; }

    # a borrowed source may change later, and the destination holds the value it wrote
    if (borrowed) { ret res[value.Value, fail.Fail].ok{value.retype(ptr, rhs.ty)}; }
    ret res[value.Value, fail.Fail].ok{rhs};
}

# the value a store consumes. when `in_place` holds, nothing writes memory between this read
# and the store, so an aggregate place is read where it lies and the store copies from it:
# the aggregate copy is overlap-safe, so no snapshot sits between them
pub fun lower_stored_rvalue(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, in_place: bool, borrowed: *bool) res[value.Value, fail.Fail] {
    val saved_armed: bool          = ctx.borrow_armed;
    val saved_eid:   ast_id.ExprId = ctx.borrow_eid;
    val saved_hit:   bool          = ctx.borrow_hit;
    ctx.borrow_armed = in_place;
    ctx.borrow_eid   = eid;
    ctx.borrow_hit   = false;
    val res_v: res[value.Value, fail.Fail] = lower_rvalue(ctx, eid);
    @borrowed        = ctx.borrow_hit;
    ctx.borrow_armed = saved_armed;
    ctx.borrow_eid   = saved_eid;
    ctx.borrow_hit   = saved_hit;
    if (sel res_v.err) { ret res_v; }
    var v: value.Value = res_v.ok;
    # the store reads the source itself, so it carries the secrecy the snapshot copy did
    if (@borrowed && lower_context.type_contains_secret(ctx, lower_context.expr_type_of(ctx, eid))) { v.secret = true; }
    ret res[value.Value, fail.Fail].ok{v};
}

# `place = v::[N]T` stores the vector where the array lives: one vector store,
# with no array value in between. the assignment's value is the place it wrote
fun lower_vector_store(ctx: *lower_context.LowerContext, e: *ast_expr.Expr) opt[res[value.Value, fail.Fail]] {
    val res_rhs: res[ast_expr.Expr, fail.Fail] = lower_context.expression(ctx, e.data.binary.rhs);
    if (sel res_rhs.err) { ret opt[res[value.Value, fail.Fail]].none{}; }
    val rhs: ast_expr.Expr = res_rhs.ok;
    if (rhs.kind != ast_expr.EXPR_KIND_CAST || rhs.data.cast.reinterpret) { ret opt[res[value.Value, fail.Fail]].none{}; }
    val to_ty: type_kind.TypeId = lower_context.expr_type_of(ctx, e.data.binary.rhs);
    if (!is_array_type(ctx, to_ty))                                                         { ret opt[res[value.Value, fail.Fail]].none{}; }
    if (!type.is_vector(ctx.s.types, lower_context.expr_type_of(ctx, rhs.data.cast.value))) { ret opt[res[value.Value, fail.Fail]].none{}; }

    val res_arr: res[Type, fail.Fail] = lower_context.lower_type(ctx, to_ty);
    if (sel res_arr.err) { ret opt[res[value.Value, fail.Fail]].some{res[value.Value, fail.Fail].err{res_arr.err}}; }
    val res_vec: res[value.Value, fail.Fail] = lower_rvalue(ctx, rhs.data.cast.value);
    if (sel res_vec.err) { ret opt[res[value.Value, fail.Fail]].some{res_vec}; }
    val res_lhs: res[value.Value, fail.Fail] = lower_lvalue(ctx, e.data.binary.lhs);
    if (sel res_lhs.err) { ret opt[res[value.Value, fail.Fail]].some{res_lhs}; }

    val err_store: err[fail.Fail] = store_stated(ctx, res_vec.ok, res_lhs.ok, lower_context.expr_type_of(ctx, e.data.binary.lhs), access_is_volatile(ctx, e.data.binary.lhs));
    if (sel err_store.err) { ret opt[res[value.Value, fail.Fail]].some{res[value.Value, fail.Fail].err{err_store.err}}; }
    ret opt[res[value.Value, fail.Fail]].some{res[value.Value, fail.Fail].ok{value.retype(res_lhs.ok, res_arr.ok)}};
}

fun lower_vector_lane_write(ctx: *lower_context.LowerContext, lhs: ast_id.ExprId, rhs: value.Value) res[bool, fail.Fail] {
    val res_expression: res[ast_expr.Expr, fail.Fail] = lower_context.expression(ctx, lhs);
    if (sel res_expression.err) { ret res[bool, fail.Fail].ok{false}; }
    var e_value: ast_expr.Expr  = res_expression.ok;
    val e:       *ast_expr.Expr = ?e_value;
    if (e.kind != ast_expr.EXPR_KIND_INDEX) { ret res[bool, fail.Fail].ok{false}; }
    if (is_vector_range(ctx, e))            { ret lower_vector_range_write(ctx, e, rhs); }

    val opt_lane: opt[res[u64, fail.Fail]] = vector_lane_of(ctx, e);
    if (sel opt_lane.none) { ret res[bool, fail.Fail].ok{false}; }
    val res_lane: res[u64, fail.Fail] = opt_lane.some;
    if (sel res_lane.err) { ret res[bool, fail.Fail].err{res_lane.err}; }

    val res_slot: res[value.Value, fail.Fail] = lower_lvalue(ctx, e.data.index.object);
    if (sel res_slot.err) { ret res[bool, fail.Fail].err{res_slot.err}; }
    val slot: value.Value = res_slot.ok;

    val res_vty: res[Type, fail.Fail] = lower_context.lower_type(ctx, lower_context.expr_type_of(ctx, e.data.index.object));
    if (sel res_vty.err) { ret res[bool, fail.Fail].err{res_vty.err}; }

    val res_old: res[value.Value, fail.Fail] = builder.emit_load_as(?ctx.builder, slot, res_vty.ok, lower_context.type_contains_secret(ctx, lower_context.expr_type_of(ctx, e.data.index.object)));
    if (sel res_old.err) { ret res[bool, fail.Fail].err{res_old.err}; }

    val res_new: res[value.Value, fail.Fail] = builder.emit_vec_insert(?ctx.builder, res_old.ok, value.const_int(res_lane.ok, builder.index_type(?ctx.builder)), rhs);
    if (sel res_new.err) { ret res[bool, fail.Fail].err{res_new.err}; }

    val err_store: err[fail.Fail] = store_stated(ctx, res_new.ok, slot, lower_context.expr_type_of(ctx, e.data.index.object), false);
    if (sel err_store.err) { ret res[bool, fail.Fail].err{err_store.err}; }
    ret res[bool, fail.Fail].ok{true};
}

# `v[start, n] = x` replaces lanes `start` to `start + n - 1` of `v` with `x`'s
fun lower_vector_range_write(ctx: *lower_context.LowerContext, e: *ast_expr.Expr, rhs: value.Value) res[bool, fail.Fail] {
    val res_start: res[u64, fail.Fail] = vector_range_start(ctx, e);
    if (sel res_start.err) { ret res[bool, fail.Fail].err{res_start.err}; }

    val res_slot: res[value.Value, fail.Fail] = lower_lvalue(ctx, e.data.index.object);
    if (sel res_slot.err) { ret res[bool, fail.Fail].err{res_slot.err}; }
    val slot: value.Value = res_slot.ok;

    val res_vty: res[Type, fail.Fail] = lower_context.lower_type(ctx, lower_context.expr_type_of(ctx, e.data.index.object));
    if (sel res_vty.err) { ret res[bool, fail.Fail].err{res_vty.err}; }
    val t:     *types.Table = builder.types_of(?ctx.builder);
    val elem:  Type         = irt.element(t, rhs.ty);
    val lanes: u32          = irt.lanes(t, rhs.ty);
    val xty:   Type         = builder.index_type(?ctx.builder);

    val res_old: res[value.Value, fail.Fail] = builder.emit_load_as(?ctx.builder, slot, res_vty.ok, lower_context.type_contains_secret(ctx, lower_context.expr_type_of(ctx, e.data.index.object)));
    if (sel res_old.err) { ret res[bool, fail.Fail].err{res_old.err}; }
    var cur: value.Value = res_old.ok;
    var k:   u32         = 0;
    for (k < lanes) {
        val res_emit_vec_extract: res[value.Value, fail.Fail] = builder.emit_vec_extract(?ctx.builder, rhs, value.const_int(k::u64, xty), elem);
        if (sel res_emit_vec_extract.err) { ret res[bool, fail.Fail].err{res_emit_vec_extract.err}; }
        val res_ins: res[value.Value, fail.Fail] = builder.emit_vec_insert(?ctx.builder, cur, value.const_int(res_start.ok + k::u64, xty), res_emit_vec_extract.ok);
        if (sel res_ins.err) { ret res[bool, fail.Fail].err{res_ins.err}; }
        cur = res_ins.ok;
        k   = k + 1;
    }
    val err_store: err[fail.Fail] = store_stated(ctx, cur, slot, lower_context.expr_type_of(ctx, e.data.index.object), false);
    if (sel err_store.err) { ret res[bool, fail.Fail].err{err_store.err}; }
    ret res[bool, fail.Fail].ok{true};
}

fun lower_logical(ctx: *lower_context.LowerContext, e: *ast_expr.Expr) res[value.Value, fail.Fail] {
    val res_i8: res[Type, fail.Fail] = irt.int(?ctx.m.types, 8);
    if (sel res_i8.err) { ret res[value.Value, fail.Fail].err{res_i8.err}; }
    val i8: Type = res_i8.ok;

    val res_lhs: res[value.Value, fail.Fail] = lower_rvalue(ctx, e.data.binary.lhs);
    if (sel res_lhs.err) { ret res_lhs; }
    val res_lhs_condition: res[value.Value, fail.Fail] = condition_value(ctx, e.data.binary.lhs, res_lhs.ok);
    if (sel res_lhs_condition.err) { ret res_lhs_condition; }
    var lhs: [1]value.Value = [1]value.Value{res_lhs_condition.ok};

    val res_rhs_block: res[id.Block, fail.Fail] = builder.block_make(?ctx.builder);
    if (sel res_rhs_block.err) { ret res[value.Value, fail.Fail].err{res_rhs_block.err}; }
    val rhs_block: id.Block = res_rhs_block.ok;

    # the join takes the operand that decided the result, the left's when it short-circuits, and
    # is secret where either is: the branch keys on the public left, and a secret right taints it
    var joined: [1]Type  = [1]Type{i8};
    var secret: [1]bool  = [1]bool{lhs[0].secret || lower_context.type_contains_secret(ctx, lower_context.expr_type_of(ctx, e.data.binary.rhs))};
    val join:   id.Block = builder.block_make_with(?ctx.builder, ?joined[0], ?secret[0], 1);

    val res_short: res[id.Block, fail.Fail] = builder.block_make(?ctx.builder);
    if (sel res_short.err) { ret res[value.Value, fail.Fail].err{res_short.err}; }
    val short: id.Block = res_short.ok;

    var err_cbr: err[fail.Fail] = err[fail.Fail].ok{};
    if (e.data.binary.op == ast_expr.BIN_AND) { err_cbr = builder.emit_cbr(?ctx.builder, lhs[0], rhs_block, short); }
    or                                        { err_cbr = builder.emit_cbr(?ctx.builder, lhs[0], short, rhs_block); }
    if (sel err_cbr.err)                      { ret res[value.Value, fail.Fail].err{err_cbr.err}; }

    builder.set_block(?ctx.builder, short);
    val err_skip: err[fail.Fail] = builder.emit_br_args(?ctx.builder, join, ?lhs[0], 1);
    if (sel err_skip.err) { ret res[value.Value, fail.Fail].err{err_skip.err}; }

    builder.set_block(?ctx.builder, rhs_block);
    val res_rhs: res[value.Value, fail.Fail] = lower_rvalue(ctx, e.data.binary.rhs);
    if (sel res_rhs.err) { ret res_rhs; }
    val res_rhs_condition: res[value.Value, fail.Fail] = condition_value(ctx, e.data.binary.rhs, res_rhs.ok);
    if (sel res_rhs_condition.err) { ret res_rhs_condition; }
    var rhs:              [1]value.Value = [1]value.Value{res_rhs_condition.ok};
    val err_emit_br_args: err[fail.Fail] = builder.emit_br_args(?ctx.builder, join, ?rhs[0], 1);
    if (sel err_emit_br_args.err) { ret res[value.Value, fail.Fail].err{err_emit_br_args.err}; }

    builder.set_block(?ctx.builder, join);
    ret res[value.Value, fail.Fail].ok{builder.block_param(?ctx.builder, join, 0, i8)};
}

fun address_operand_names_function(ctx: *lower_context.LowerContext, eid: ast_id.ExprId) bool {
    val res_expr: res[ast_expr.Expr, fail.Fail] = lower_context.expression(ctx, eid);
    if (sel res_expr.err) { ret false; }
    var e_value: ast_expr.Expr  = res_expr.ok;
    val e:       *ast_expr.Expr = ?e_value;
    if (e.kind == ast_expr.EXPR_KIND_GENERIC_INSTANCE)                             { ret true; }
    if (e.kind != ast_expr.EXPR_KIND_IDENT && e.kind != ast_expr.EXPR_KIND_MEMBER) { ret false; }
    val sid:     resolve.SymbolId     = lower_context.expr_symbol_of(ctx, eid);
    val opt_sym: opt[*resolve.Symbol] = lower_context.symbol_of(ctx, sid);
    if (sel opt_sym.none) { ret false; }
    ret names_function(ctx, opt_sym.some);
}

fun lower_unary(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, e: *ast_expr.Expr) res[value.Value, fail.Fail] {
    val op: ast_expr.UnOp = e.data.unary.op;

    if (op == ast_expr.UN_ADDR) {
        if (address_operand_names_function(ctx, e.data.unary.operand)) {
            ret lower_rvalue(ctx, e.data.unary.operand);
        }
        ret lower_lvalue(ctx, e.data.unary.operand);
    }
    if (op == ast_expr.UN_DEREF) {
        val res_ptr: res[value.Value, fail.Fail] = lower_rvalue(ctx, e.data.unary.operand);
        if (sel res_ptr.err) { ret res_ptr; }
        val res_ir: res[Type, fail.Fail] = ir_type_of_expr(ctx, eid);
        if (sel res_ir.err) { ret res[value.Value, fail.Fail].err{res_ir.err}; }
        ret rvalue_at(ctx, res_ptr.ok, res_ir.ok, lower_context.expr_type_of(ctx, eid), access_is_volatile(ctx, eid));
    }

    val res_v: res[value.Value, fail.Fail] = lower_rvalue(ctx, e.data.unary.operand);
    if (sel res_v.err) { ret res_v; }
    val v: value.Value = res_v.ok;

    if (op == ast_expr.UN_NEG)     { ret builder.emit_neg(?ctx.builder, v); }
    if (op == ast_expr.UN_BIT_NOT) { ret builder.emit_not(?ctx.builder, v); }
    if (op == ast_expr.UN_NOT)     { ret builder.emit_cmp_ne(?ctx.builder, v, value.const_int(1, v.ty)); }

    ret res[value.Value, fail.Fail].err{fail.message("lower: unsupported unary operator")};
}

# branch to `then_b` where the condition `eid` holds, else to `else_b`. a logical and, or and
# not that holds no secret branches on its operands in turn, so no bool is made for it and
# its right operand runs only where the left does not decide
pub fun branch_on(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, then_b: id.Block, else_b: id.Block) err[fail.Fail] {
    val res_expr: res[ast_expr.Expr, fail.Fail] = lower_context.expression(ctx, eid);
    if (sel res_expr.ok) {
        var e_value: ast_expr.Expr  = res_expr.ok;
        val e:       *ast_expr.Expr = ?e_value;
        if (!stack.exhausted() && !lower_context.expr_is_secret(ctx, eid)) {
            if (e.kind == ast_expr.EXPR_KIND_BINARY && (e.data.binary.op == ast_expr.BIN_AND || e.data.binary.op == ast_expr.BIN_OR)) {
                val res_mid: res[id.Block, fail.Fail] = builder.block_make(?ctx.builder);
                if (sel res_mid.err) { ret err[fail.Fail].err{res_mid.err}; }
                val mid:     id.Block       = res_mid.ok;
                var err_lhs: err[fail.Fail] = err[fail.Fail].ok{};
                if (e.data.binary.op == ast_expr.BIN_AND) { err_lhs = branch_on(ctx, e.data.binary.lhs, mid, else_b); }
                or                                        { err_lhs = branch_on(ctx, e.data.binary.lhs, then_b, mid); }
                if (sel err_lhs.err)                      { ret err_lhs; }
                builder.set_block(?ctx.builder, mid);
                ret branch_on(ctx, e.data.binary.rhs, then_b, else_b);
            }
            if (e.kind == ast_expr.EXPR_KIND_UNARY && e.data.unary.op == ast_expr.UN_NOT) {
                ret branch_on(ctx, e.data.unary.operand, else_b, then_b);
            }
        }
    }
    val res_cond: res[value.Value, fail.Fail] = lower_rvalue(ctx, eid);
    if (sel res_cond.err) { ret err[fail.Fail].err{res_cond.err}; }
    val res_condition: res[value.Value, fail.Fail] = condition_value(ctx, eid, res_cond.ok);
    if (sel res_condition.err) { ret err[fail.Fail].err{res_condition.err}; }
    ret builder.emit_cbr(?ctx.builder, res_condition.ok, then_b, else_b);
}

pub fun condition_value(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, v: value.Value) res[value.Value, fail.Fail] {
    val res_expr: res[ast_expr.Expr, fail.Fail] = lower_context.expression(ctx, eid);
    if (sel res_expr.ok) {
        var e_value: ast_expr.Expr  = res_expr.ok;
        val e:       *ast_expr.Expr = ?e_value;
        if (e.kind == ast_expr.EXPR_KIND_BINARY && (is_compare_binop(e.data.binary.op) || e.data.binary.op == ast_expr.BIN_AND || e.data.binary.op == ast_expr.BIN_OR)) { ret res[value.Value, fail.Fail].ok{v}; }
        if (e.kind == ast_expr.EXPR_KIND_UNARY && e.data.unary.op == ast_expr.UN_NOT) {
            ret res[value.Value, fail.Fail].ok{v};
        }
        # a runtime `sel` is already the discriminator compare; a folded one stays a constant
        if (e.kind == ast_expr.EXPR_KIND_SEL && v.kind != value.VAL_INT) {
            ret res[value.Value, fail.Fail].ok{v};
        }
    }
    ret builder.emit_cmp_eq(?ctx.builder, v, value.const_int(1, v.ty));
}

fun lower_cast(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, e: *ast_expr.Expr) res[value.Value, fail.Fail] {
    val from_ty: type_kind.TypeId = lower_context.expr_type_of(ctx, e.data.cast.value);
    val to_ty:   type_kind.TypeId = lower_context.type_resolved_of(ctx, e.data.cast.ty);
    if (!e.data.cast.reinterpret) {
        val opt_shaped: opt[res[value.Value, fail.Fail]] = lower_cast_shape(ctx, e.data.cast.value, from_ty, to_ty);
        if (sel opt_shaped.some) { ret opt_shaped.some; }
    }

    val res_v: res[value.Value, fail.Fail] = lower_rvalue(ctx, e.data.cast.value);
    if (sel res_v.err) { ret res_v; }
    val v: value.Value = res_v.ok;

    val res_dst: res[Type, fail.Fail] = lower_context.lower_type(ctx, to_ty);
    if (sel res_dst.err) { ret res[value.Value, fail.Fail].err{res_dst.err}; }
    val dst: Type = res_dst.ok;

    # a vector converts lane by lane, so the rule is chosen from the lane types
    var from_rule: type_kind.TypeId = from_ty;
    var to_rule:   type_kind.TypeId = to_ty;
    val lanewise:  bool             = !e.data.cast.reinterpret && type.is_vector(ctx.s.types, from_ty) && type.is_vector(ctx.s.types, to_ty);
    if (lanewise) {
        val opt_prim:       opt[type_kind.TypeId] = type.prim(ctx.s.types, type.vector_element(ctx.s.types, from_ty));
        val opt_prim_types: opt[type_kind.TypeId] = type.prim(ctx.s.types, type.vector_element(ctx.s.types, to_ty));
        if (sel opt_prim.some)       { from_rule = opt_prim.some; }
        or                           { ret res[value.Value, fail.Fail].err{fail.message("lower: vector cast lane type is not a primitive")}; }
        if (sel opt_prim_types.some) { to_rule = opt_prim_types.some; }
        or                           { ret res[value.Value, fail.Fail].err{fail.message("lower: vector cast lane type is not a primitive")}; }
    }

    if (e.data.cast.reinterpret || !type.is_numeric(ctx.s.types, from_rule) || !type.is_numeric(ctx.s.types, to_rule)) {
        ret lower_reinterpret(ctx, v, from_ty, dst);
    }

    # a cast to u1 asks whether the value is non-zero, which keeps the byte 0 or 1
    if (type.is_u1(ctx.s.types, to_rule) && !type.is_u1(ctx.s.types, from_rule)) {
        val res_from: res[Type, fail.Fail] = lower_context.lower_type(ctx, from_rule);
        if (sel res_from.err) { ret res[value.Value, fail.Fail].err{res_from.err}; }
        ret builder.emit_cmp_ne(?ctx.builder, v, value.const_int(0, res_from.ok));
    }

    val from_float:  bool = is_float_type(ctx, from_rule);
    val to_float:    bool = is_float_type(ctx, to_rule);
    val from_signed: bool = is_signed_type(ctx, from_rule);
    val to_signed:   bool = is_signed_type(ctx, to_rule);
    val from_bits:   u32  = scalar_bits(ctx, from_rule);
    val to_bits:     u32  = scalar_bits(ctx, to_rule);

    if (from_float && to_float) {
        if (to_bits < from_bits) { ret builder.emit_fp_trunc(?ctx.builder, v, dst); }
        if (to_bits > from_bits) { ret builder.emit_fp_ext(?ctx.builder, v, dst); }
        ret emit_retype(ctx, v, dst);
    }
    if (from_float && !to_float) {
        if (to_signed) { ret builder.emit_fp_to_si(?ctx.builder, v, dst); }
        ret builder.emit_fp_to_ui(?ctx.builder, v, dst);
    }
    if (!from_float && to_float) {
        if (from_signed) { ret builder.emit_si_to_fp(?ctx.builder, v, dst); }
        ret builder.emit_ui_to_fp(?ctx.builder, v, dst);
    }

    if (to_bits < from_bits) { ret builder.emit_trunc(?ctx.builder, v, dst); }
    if (to_bits > from_bits) {
        if (from_signed) { ret builder.emit_sext(?ctx.builder, v, dst); }
        ret builder.emit_zext(?ctx.builder, v, dst);
    }
    ret emit_retype(ctx, v, dst);
}

# the conversions whose operand's shape is their lowering: an array in memory
# read as a vector is one vector load, and a range of a vector widened lane by
# lane extends straight from the vector
fun lower_cast_shape(ctx: *lower_context.LowerContext, operand: ast_id.ExprId, from_ty: type_kind.TypeId, to_ty: type_kind.TypeId) opt[res[value.Value, fail.Fail]] {
    if (!type.is_vector(ctx.s.types, to_ty)) { ret opt[res[value.Value, fail.Fail]].none{}; }
    if (is_array_type(ctx, from_ty)) {
        ret opt[res[value.Value, fail.Fail]].some{lower_array_as_vector(ctx, operand, to_ty)};
    }
    if (type.is_vector(ctx.s.types, from_ty)) { ret lower_range_cast(ctx, operand, from_ty, to_ty); }
    ret opt[res[value.Value, fail.Fail]].none{};
}

fun lower_array_as_vector(ctx: *lower_context.LowerContext, operand: ast_id.ExprId, to_ty: type_kind.TypeId) res[value.Value, fail.Fail] {
    val res_dst: res[Type, fail.Fail] = lower_context.lower_type(ctx, to_ty);
    if (sel res_dst.err) { ret res[value.Value, fail.Fail].err{res_dst.err}; }
    val res_ptr: res[value.Value, fail.Fail] = storage_address(ctx, operand);
    if (sel res_ptr.err) { ret res_ptr; }
    builder.set_access(?ctx.builder, lower_context.type_contains_secret(ctx, lower_context.expr_type_of(ctx, operand)));
    val res_read: res[value.Value, fail.Fail] = builder.emit_load_marked(?ctx.builder, value.retype(res_ptr.ok, builder.ptr_type(?ctx.builder)), res_dst.ok, access_is_volatile(ctx, operand));
    builder.end_access(?ctx.builder);
    ret res_read;
}

# write `v` to `ptr`, a place of source type `ty`, stating the memory it writes as secret or public as `ty` is
# refuse the pointer `v` written where `at` holds a pointer of the type `held` names, when one of
# the two is physical and the other logical: memory, a result and a parameter no call names a
# storage of hold physical pointers only, and a pointer local holds the class its initializer
# gave it, so a logical pointer stored there, or a physical one where a logical one is held, is
# a register one path makes logical and another physical (types.md, "pointers on spir-v")
pub fun refuse_mixed(ctx: *lower_context.LowerContext, v: value.Value, at: value.Value, held: Type, span: base_source.Span) err[fail.Fail] {
    val t: *types.Table = ?ctx.m.types;
    if (!irt.is_ptr(t, v.ty)) { ret err[fail.Fail].ok{}; }
    var into: Type = held;
    if (irt.is_ptr(t, at.held))                         { into = at.held; }
    if (!irt.is_ptr(t, into))                           { ret err[fail.Fail].ok{}; }
    if (irt.space_of(t, v.ty) == irt.space_of(t, into)) { ret err[fail.Fail].ok{}; }
    val from_physical: bool = builder.is_physical(?ctx.builder, v.ty);
    val into_physical: bool = builder.is_physical(?ctx.builder, into);
    if (!from_physical && !into_physical) { ret err[fail.Fail].ok{}; }
    if (irt.is_ptr(t, at.held) && from_physical) {
        ret err[fail.Fail].err{lower_context.report_gate(ctx, diagnostic_kind.SPIRV_UNSUPPORTED, span,
            "a physical pointer is written to a pointer that holds a logical one. one register cannot be logical on one path and physical on another")};
    }
    if (irt.is_ptr(t, at.held)) {
        ret err[fail.Fail].err{lower_context.report_gate(ctx, diagnostic_kind.SPIRV_UNSUPPORTED, span,
            "a logical pointer is written to a pointer that holds a physical one. one register cannot be logical on one path and physical on another")};
    }
    ret err[fail.Fail].err{lower_context.report_gate(ctx, diagnostic_kind.SPIRV_UNSUPPORTED, span,
        "a logical pointer cannot be held in memory, returned or passed where a physical one is, because it names a variable and has no address. a physical pointer is one read from memory, made from an integer, returned or `nil`")};
}

pub fun store_stated(ctx: *lower_context.LowerContext, v: value.Value, ptr: value.Value, ty: type_kind.TypeId, vol: bool) err[fail.Fail] {
    if (builder.classes(?ctx.builder) && irt.is_ptr(?ctx.m.types, v.ty)) {
        val res_held: res[Type, fail.Fail] = lower_context.lower_type(ctx, ty);
        if (sel res_held.err) { ret err[fail.Fail].err{res_held.err}; }
        val err_mixed: err[fail.Fail] = refuse_mixed(ctx, v, ptr, res_held.ok, builder.current_loc(?ctx.builder).span);
        if (sel err_mixed.err) { ret err_mixed; }
    }
    val secret: bool = lower_context.type_contains_secret(ctx, ty);
    builder.set_access(?ctx.builder, secret);
    val err_emit_store_marked: err[fail.Fail] = builder.emit_store_marked(?ctx.builder, v, ptr, vol);
    builder.end_access(?ctx.builder);
    if (sel err_emit_store_marked.err) { ret err_emit_store_marked; }
    # a whole copy of a type mixing secret and public bytes is stated secret, so in constant-time code its public bytes
    # are copied again, stated public
    if (!secret || vol || v.whole || !irt.is_aggregate(?ctx.m.types, v.ty) || !lower_context.building_constant_time(ctx)) { ret err_emit_store_marked; }
    var publics: collections_vector.Vector[mirl_global.Range] = collections_vector.init[mirl_global.Range](ctx.s.alloc);
    fin { collections_vector.dnit[mirl_global.Range](?publics); }
    val err_laid: err[fail.Fail] = lower_context.public_ranges(ctx, ty, v.ty, ?publics);
    if (sel err_laid.err) { ret err_laid; }
    ret builder.copy_publics(?ctx.builder, ptr, v, v.ty, Slice[mirl_global.Range]{data: publics.data, size: publics.len});
}

# where an aggregate operand's bytes are: a place is read where it lives, and any other
# aggregate value is already a pointer to its own storage. a projection reads through this,
# so only `?` and a store ask for a place, and those sema has held to places
fun storage_address(ctx: *lower_context.LowerContext, eid: ast_id.ExprId) res[value.Value, fail.Fail] {
    val res_expr: res[ast_expr.Expr, fail.Fail] = lower_context.expression(ctx, eid);
    if (sel res_expr.err) { ret res[value.Value, fail.Fail].err{res_expr.err}; }
    var e_value: ast_expr.Expr     = res_expr.ok;
    val k:       ast_expr.ExprKind = ast.expr_place_kind(?e_value);
    if (k != ast_expr.EXPR_KIND_ERROR && k != ast_expr.EXPR_KIND_CALL && !place_roots_in_const_elem(ctx, eid)) {
        ret lower_lvalue(ctx, eid);
    }
    ret lower_rvalue(ctx, eid);
}

# `v[a, n]::T` over an integer vector, where each lane of `T` is wider: the range is
# extracted and each lane extended straight from `v`
fun lower_range_cast(ctx: *lower_context.LowerContext, operand: ast_id.ExprId, from_ty: type_kind.TypeId, to_ty: type_kind.TypeId) opt[res[value.Value, fail.Fail]] {
    val res_operand: res[ast_expr.Expr, fail.Fail] = lower_context.expression(ctx, operand);
    if (sel res_operand.err) { ret opt[res[value.Value, fail.Fail]].none{}; }
    var e_value: ast_expr.Expr  = res_operand.ok;
    val e:       *ast_expr.Expr = ?e_value;
    if (!is_vector_range(ctx, e)) { ret opt[res[value.Value, fail.Fail]].none{}; }

    val opt_prim:       opt[type_kind.TypeId] = type.prim(ctx.s.types, type.vector_element(ctx.s.types, from_ty));
    val opt_prim_types: opt[type_kind.TypeId] = type.prim(ctx.s.types, type.vector_element(ctx.s.types, to_ty));
    if (sel opt_prim.none)                                                            { ret opt[res[value.Value, fail.Fail]].none{}; }
    if (sel opt_prim_types.none)                                                      { ret opt[res[value.Value, fail.Fail]].none{}; }
    if (is_float_type(ctx, opt_prim.some) || is_float_type(ctx, opt_prim_types.some)) { ret opt[res[value.Value, fail.Fail]].none{}; }
    if (scalar_bits(ctx, opt_prim_types.some) <= scalar_bits(ctx, opt_prim.some))     { ret opt[res[value.Value, fail.Fail]].none{}; }

    val res_start: res[u64, fail.Fail] = vector_range_start(ctx, e);
    if (sel res_start.err) { ret opt[res[value.Value, fail.Fail]].some{res[value.Value, fail.Fail].err{res_start.err}}; }
    val res_dst: res[Type, fail.Fail] = lower_context.lower_type(ctx, to_ty);
    if (sel res_dst.err) { ret opt[res[value.Value, fail.Fail]].some{res[value.Value, fail.Fail].err{res_dst.err}}; }
    val res_vec: res[value.Value, fail.Fail] = lower_rvalue(ctx, e.data.index.object);
    if (sel res_vec.err) { ret opt[res[value.Value, fail.Fail]].some{res_vec}; }
    ret opt[res[value.Value, fail.Fail]].some{extract_lanes(ctx, res_vec.ok, res_start.ok, res_dst.ok, opt[bool].some{is_signed_type(ctx, opt_prim.some)})};
}

fun emit_retype(ctx: *lower_context.LowerContext, v: value.Value, dst: Type) res[value.Value, fail.Fail] {
    if (irt.same(v.ty, dst)) { ret res[value.Value, fail.Fail].ok{v}; }
    ret builder.emit_bitcast(?ctx.builder, v, dst);
}

fun lower_reinterpret(ctx: *lower_context.LowerContext, v: value.Value, from_ty: type_kind.TypeId, dst: Type) res[value.Value, fail.Fail] {
    val res_src: res[Type, fail.Fail] = lower_context.lower_type(ctx, from_ty);
    if (sel res_src.err) { ret res[value.Value, fail.Fail].err{res_src.err}; }
    val src: Type = res_src.ok;

    var from: value.Value = v;
    if (v.whole) {
        # the bytes of an aggregate held whole are read as another type from storage of their own
        val res_spilled: res[value.Value, fail.Fail] = builder.emit_spill(?ctx.builder, v);
        if (sel res_spilled.err) { ret res_spilled; }
        from = res_spilled.ok;
    }
    ret reinterpret_from(ctx, from, src, dst);
}

fun reinterpret_from(ctx: *lower_context.LowerContext, v: value.Value, src: Type, dst: Type) res[value.Value, fail.Fail] {
    val src_agg: bool = is_aggregate_ir(ctx, src);
    val dst_agg: bool = is_aggregate_ir(ctx, dst);
    if (src_agg && dst_agg) { ret reinterpret_aggregate(ctx, v, src, dst); }
    if (src_agg == dst_agg) { ret emit_retype(ctx, v, dst); }

    if (src_agg) {
        val res_ptr: res[Type, fail.Fail] = irt.ptr(?ctx.m.types);
        if (sel res_ptr.err) { ret res[value.Value, fail.Fail].err{res_ptr.err}; }
        ret builder.emit_load_as(?ctx.builder, value.retype(v, res_ptr.ok), dst, v.secret);
    }

    val res_slot: res[value.Value, fail.Fail] = builder.emit_alloca(?ctx.builder, dst);
    if (sel res_slot.err) { ret res_slot; }
    val slot: value.Value = res_slot.ok;

    val err_store: err[fail.Fail] = builder.emit_store(?ctx.builder, v, slot);
    if (sel err_store.err) { ret res[value.Value, fail.Fail].err{err_store.err}; }

    ret res[value.Value, fail.Fail].ok{value.retype(slot, dst)};
}

# aggregate `v` of `src` read as `dst` of its size: its bytes copied to storage of `dst`, which
# has the alignment `dst` asks and `v`'s storage may not
fun reinterpret_aggregate(ctx: *lower_context.LowerContext, v: value.Value, src: Type, dst: Type) res[value.Value, fail.Fail] {
    if (irt.same(src, dst)) { ret res[value.Value, fail.Fail].ok{v}; }
    val res_slot: res[value.Value, fail.Fail] = builder.emit_alloca(?ctx.builder, dst);
    if (sel res_slot.err) { ret res_slot; }
    # the copy claims the lesser of the two alignments, which both ends hold to
    var held: Type = dst;
    if (builder.align_of(?ctx.builder, src) < builder.align_of(?ctx.builder, dst)) { held = src; }
    val err_copied: err[fail.Fail] = builder.emit_copy(?ctx.builder, res_slot.ok, v, held);
    if (sel err_copied.err) { ret res[value.Value, fail.Fail].err{err_copied.err}; }
    ret res[value.Value, fail.Fail].ok{value.retype(res_slot.ok, dst)};
}

fun lower_strip(ctx: *lower_context.LowerContext, e: *ast_expr.Expr) res[value.Value, fail.Fail] {
    val res_inner: res[value.Value, fail.Fail] = lower_rvalue(ctx, e.data.strip.value);
    if (sel res_inner.err) { ret res_inner; }
    ret builder.emit_declassify(?ctx.builder, res_inner.ok);
}

fun lower_comptime_path(ctx: *lower_context.LowerContext, eid: ast_id.ExprId) res[value.Value, fail.Fail] {
    val res_eval: res[comptime_value.CTValue, comptime_failure.EvalFail] = comptime.evaluate_at_float_width[lower_context.LowerContext](ctx.scope.ctx, ctx, ctx.caps, ctx.scope.a, lower_context.module_source(ctx), eid, ctx.s.interner,
        lower_context.expr_float_width(ctx, eid));
    lower_context.record_eval_result(ctx, res_eval);
    if (sel res_eval.err) { ret res[value.Value, fail.Fail].err{fail.message(res_eval.err.message)}; }
    ret const_value_of(ctx, eid, res_eval.ok);
}

# how the elements of an array or vector literal are lowered: as any value is, or as an intrinsic's argument is
def Element: fun(*lower_context.LowerContext, ast_id.ExprId) res[value.Value, fail.Fail];

fun lower_array_lit(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, e: *ast_expr.Expr, element: Element) res[value.Value, fail.Fail] {
    val arr_ty:     type_kind.TypeId     = lower_context.expr_type_of(ctx, eid);
    val res_arr_ir: res[Type, fail.Fail] = lower_context.lower_type(ctx, arr_ty);
    if (sel res_arr_ir.err) { ret res[value.Value, fail.Fail].err{res_arr_ir.err}; }
    val arr_ir: Type = res_arr_ir.ok;
    val xty:    Type = builder.index_type(?ctx.builder);

    val res_slot: res[value.Value, fail.Fail] = builder.emit_alloca(?ctx.builder, arr_ir);
    if (sel res_slot.err) { ret res_slot; }
    val slot: value.Value = res_slot.ok;

    val res_pad: res[bool, fail.Fail] = secret_padding(ctx, arr_ty, arr_ir);
    if (sel res_pad.err) { ret res[value.Value, fail.Fail].err{res_pad.err}; }
    if (res_pad.ok) {
        val err_emit_memzero: err[fail.Fail] = builder.emit_memzero(?ctx.builder, slot, arr_ir, lower_context.type_contains_secret(ctx, arr_ty));
        if (sel err_emit_memzero.err) { ret res[value.Value, fail.Fail].err{err_emit_memzero.err}; }
    }

    var i: u32 = 0;
    for (i < e.data.array_lit.elems_len) {
        val pool_ix: u32 = e.data.array_lit.elems_start + i;
        if (pool_ix::usize >= ctx.scope.a.expr_ids.len) {
            ret res[value.Value, fail.Fail].err{fail.message("lower: array literal element index out of range")};
        }
        val elem_eid: ast_id.ExprId               = ctx.scope.a.expr_ids.data[pool_ix];
        val res_elem: res[value.Value, fail.Fail] = element(ctx, elem_eid);
        if (sel res_elem.err) { ret res_elem; }

        val res_at: res[value.Value, fail.Fail] = builder.emit_element(?ctx.builder, slot, arr_ir, value.const_int(i::u64, xty));
        if (sel res_at.err) { ret res_at; }
        val err_store: err[fail.Fail] = store_stated(ctx, res_elem.ok, res_at.ok, lower_context.expr_type_of(ctx, elem_eid), false);
        if (sel err_store.err) { ret res[value.Value, fail.Fail].err{err_store.err}; }
        i = i + 1;
    }

    ret res[value.Value, fail.Fail].ok{value.retype(slot, arr_ir)};
}

fun lower_vector_lit(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, e: *ast_expr.Expr, element: Element) res[value.Value, fail.Fail] {
    val vec_ty:     type_kind.TypeId     = lower_context.expr_type_of(ctx, eid);
    val res_vec_ir: res[Type, fail.Fail] = lower_context.lower_type(ctx, vec_ty);
    if (sel res_vec_ir.err) { ret res[value.Value, fail.Fail].err{res_vec_ir.err}; }
    val vec_ir: Type = res_vec_ir.ok;

    val n:     u32                                    = e.data.vector_lit.elems_len;
    var lanes: collections_vector.Vector[value.Value] = collections_vector.init[value.Value](ctx.s.alloc);
    fin { collections_vector.dnit[value.Value](?lanes); }
    var li: u32 = 0;
    for (li < n) {
        val lpool_ix: u32 = e.data.vector_lit.elems_start + li;
        if (lpool_ix::usize >= ctx.scope.a.expr_ids.len) {
            ret res[value.Value, fail.Fail].err{fail.message("lower: vector literal element index out of range")};
        }
        val res_lres: res[value.Value, fail.Fail] = element(ctx, ctx.scope.a.expr_ids.data[lpool_ix]);
        if (sel res_lres.err) { ret res_lres; }
        val res_pushed: res[usize, A.Error] = collections_vector.push[value.Value](?lanes, res_lres.ok);
        if (sel res_pushed.err) { ret res[value.Value, fail.Fail].err{fail.refused(res_pushed.err)}; }
        li = li + 1;
    }
    ret builder.emit_vec_build(?ctx.builder, vec_ir, lanes.data, n);
}

# `sel` loads the discriminator and compares it with the case code; it never reads a payload.
# a pointer place tests its pointee through the pointer value, like a member access does
fun lower_sel(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, e: *ast_expr.Expr) res[value.Value, fail.Fail] {
    val place_eid: ast_id.ExprId = e.data.sel.place;
    # a constant element has no storage: the test is decided at compile time and materialized
    if (place_roots_in_const_elem(ctx, place_eid)) { ret lower_comptime_value(ctx, eid); }
    var tag_ty:   type_kind.TypeId;
    val res_addr: res[value.Value, fail.Fail] = member_base(ctx, place_eid, ?tag_ty);
    if (sel res_addr.err) { ret res_addr; }

    val res_tag_ir: res[Type, fail.Fail] = lower_context.lower_type(ctx, tag_ty);
    if (sel res_tag_ir.err) { ret res[value.Value, fail.Fail].err{res_tag_ir.err}; }
    val tag_ir:  Type = res_tag_ir.ok;
    val disc_ir: Type = disc_type(ctx, tag_ir);

    var res_code: res[value.Value, fail.Fail] = res[value.Value, fail.Fail].ok{value.none()};
    if (res_addr.ok.whole) { res_code = builder.emit_extract(?ctx.builder, res_addr.ok, shape.TAG_DISCRIMINANT); }
    or {
        val res_dp: res[value.Value, fail.Fail] = disc_gep(ctx, res_addr.ok, tag_ir);
        if (sel res_dp.err) { ret res_dp; }
        res_code = builder.emit_load_discriminator(?ctx.builder, res_dp.ok, disc_ir);
    }
    if (sel res_code.err) { ret res_code; }

    var case_ix: u32 = 0;
    if (!ast_id.expr_is_nil(e.data.sel.case_desc)) {
        val res_ix: res[u32, fail.Fail] = case_descriptor_index(ctx, e.data.sel.case_desc);
        if (sel res_ix.err) { ret res[value.Value, fail.Fail].err{res_ix.err}; }
        case_ix = res_ix.ok;
    }
    or { case_ix = field_index_of(ctx, tag_ty, e.data.sel.case_id); }
    ret builder.emit_cmp_eq(?ctx.builder, res_code.ok, value.const_int(case_ix::u64, disc_ir));
}

# the case ordinal a comptime case descriptor names; type checking already tied it to this tag
fun case_descriptor_index(ctx: *lower_context.LowerContext, desc_eid: ast_id.ExprId) res[u32, fail.Fail] {
    val res_desc: res[comptime_value.CTValue, comptime_failure.EvalFail] = comptime.evaluate[lower_context.LowerContext](ctx.scope.ctx, ctx, ctx.caps, ctx.scope.a, lower_context.module_source(ctx), desc_eid, ctx.s.interner);
    lower_context.record_eval_result(ctx, res_desc);
    if (sel res_desc.err) { ret res[u32, fail.Fail].err{fail.message(res_desc.err.message)}; }
    val dv: comptime_value.CTValue = res_desc.ok;
    if (dv.kind != comptime_value.CT_KIND_CASE) {
        ret res[u32, fail.Fail].err{fail.message("lower: a bracketed case operand is not a comptime case descriptor")};
    }
    ret res[u32, fail.Fail].ok{dv.data.fld.index};
}

fun literal_head_case(ctx: *lower_context.LowerContext, tid: ast_id.TypeId) base_source.Span {
    var absent: base_source.Span;
    absent.offset = 0;
    absent.len    = 0;
    val res_type_node: res[ast_type.Type, fail.Fail] = lower_context.type_node(ctx, tid);
    if (sel res_type_node.err)                             { ret absent; }
    if (res_type_node.ok.kind != ast_type.TYPE_KIND_NAMED) { ret absent; }
    ret res_type_node.ok.data.named.case_name;
}

fun literal_head_case_desc(ctx: *lower_context.LowerContext, tid: ast_id.TypeId) ast_id.ExprId {
    val res_type_node: res[ast_type.Type, fail.Fail] = lower_context.type_node(ctx, tid);
    if (sel res_type_node.err)                             { ret ast_id.EXPR_NIL; }
    if (res_type_node.ok.kind != ast_type.TYPE_KIND_NAMED) { ret ast_id.EXPR_NIL; }
    ret res_type_node.ok.data.named.case_desc;
}

# the case a literal head selects, by name or through a descriptor; none when the head names a plain type
fun literal_head_case_index(ctx: *lower_context.LowerContext, tid: ast_id.TypeId, tag_ty: type_kind.TypeId) res[opt[u32], fail.Fail] {
    val desc: ast_id.ExprId = literal_head_case_desc(ctx, tid);
    if (!ast_id.expr_is_nil(desc)) {
        val res_ix: res[u32, fail.Fail] = case_descriptor_index(ctx, desc);
        if (sel res_ix.err) { ret res[opt[u32], fail.Fail].err{res_ix.err}; }
        ret res[opt[u32], fail.Fail].ok{opt[u32].some{res_ix.ok}};
    }
    val case_span: base_source.Span = literal_head_case(ctx, tid);
    if (case_span.len == 0) { ret res[opt[u32], fail.Fail].ok{opt[u32].none{}}; }
    ret res[opt[u32], fail.Fail].ok{opt[u32].some{field_index_in_type(ctx, tag_ty, case_span)}};
}

# a construction writes the case code to the discriminant and stores the payload in its member
# of the payload area that holds it, after zeroing the whole object where the tag holds a secret
fun lower_tag_case_lit(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, e: *ast_expr.Expr,
    tag_ty: type_kind.TypeId, case_ix: u32) res[value.Value, fail.Fail] {
    val res_tag_ir: res[Type, fail.Fail] = lower_context.lower_type(ctx, tag_ty);
    if (sel res_tag_ir.err) { ret res[value.Value, fail.Fail].err{res_tag_ir.err}; }
    val tag_ir:  Type = res_tag_ir.ok;
    val disc_ir: Type = disc_type(ctx, tag_ir);

    var slot:     value.Value      = value.none();
    val opt_into: opt[value.Value] = lower_context.take_into(ctx, tag_ir);
    if (sel opt_into.some)                              { slot = opt_into.some; }
    or (lower_context.holds_whole(ctx, tag_ty, tag_ir)) { ret whole_case(ctx, e, tag_ty, tag_ir, case_ix); }
    or {
        val res_slot: res[value.Value, fail.Fail] = lower_context.slot_for(ctx, tag_ty, tag_ir);
        if (sel res_slot.err) { ret res_slot; }
        slot = res_slot.ok;
    }

    # a tag that holds a secret, or any in a constant-time function, has every byte its case does
    # not write zeroed, so no stale secret rides in them and a read of the whole value reads no
    # stack no store reached. any other tag is its discriminator and its active payload alone
    if (zeroed_whole(ctx, tag_ty)) {
        val err_emit_memzero: err[fail.Fail] = builder.emit_memzero(?ctx.builder, slot, tag_ir, true);
        if (sel err_emit_memzero.err) { ret res[value.Value, fail.Fail].err{err_emit_memzero.err}; }
    }

    if (e.data.struct_lit.elems_len == 1) {
        val res_at: res[value.Value, fail.Fail] = field_gep(ctx, slot, tag_ty, case_ix);
        if (sel res_at.err) { ret res_at; }
        val err_store: err[fail.Fail] = store_member(ctx, ctx.scope.a.expr_ids.data[e.data.struct_lit.elems_start], res_at.ok);
        if (sel err_store.err) { ret res[value.Value, fail.Fail].err{err_store.err}; }
    }

    val res_dp: res[value.Value, fail.Fail] = disc_gep(ctx, slot, tag_ir);
    if (sel res_dp.err) { ret res_dp; }
    val err_code: err[fail.Fail] = builder.emit_store(?ctx.builder, value.const_int(case_ix::u64, disc_ir), res_dp.ok);
    if (sel err_code.err) { ret res[value.Value, fail.Fail].err{err_code.err}; }

    ret res[value.Value, fail.Fail].ok{value.retype(slot, tag_ir)};
}

# a tag literal held whole: from a zero of the tag, the payload put in its member of a zero of
# the area that holds it, and the case code in the discriminant
fun whole_case(ctx: *lower_context.LowerContext, e: *ast_expr.Expr, tag_ty: type_kind.TypeId, tag_ir: Type, case_ix: u32) res[value.Value, fail.Fail] {
    var acc: value.Value = value.zero_whole(tag_ir);
    if (e.data.struct_lit.elems_len == 1) {
        val res_carried: res[shape.Carried, fail.Fail] = lower_context.tag_carried(ctx, tag_ty, case_ix);
        if (sel res_carried.err) { ret res[value.Value, fail.Fail].err{res_carried.err}; }
        val res_part: res[value.Value, fail.Fail] = whole_part(ctx, ctx.scope.a.expr_ids.data[e.data.struct_lit.elems_start]);
        if (sel res_part.err) { ret res_part; }
        val area_ir:  Type                        = irt.member(?ctx.m.types, tag_ir, res_carried.ok.area);
        val res_area: res[value.Value, fail.Fail] = builder.emit_insert(?ctx.builder, value.zero_whole(area_ir), res_part.ok, res_carried.ok.member);
        if (sel res_area.err) { ret res_area; }
        val res_held: res[value.Value, fail.Fail] = builder.emit_insert(?ctx.builder, acc, res_area.ok, res_carried.ok.area);
        if (sel res_held.err) { ret res_held; }
        acc = res_held.ok;
    }
    ret builder.emit_insert(?ctx.builder, acc, value.const_int(case_ix::u64, disc_type(ctx, tag_ir)), shape.TAG_DISCRIMINANT);
}

# a record or union literal held whole: from a zero of its type, each field it names put in
# its member, so each field it leaves out and every byte of padding is zero
fun whole_record(ctx: *lower_context.LowerContext, e: *ast_expr.Expr, rec_ty: type_kind.TypeId, rec_ir: Type) res[value.Value, fail.Fail] {
    var acc: value.Value = value.zero_whole(rec_ir);
    var i:   u32         = 0;
    for (i < e.data.struct_lit.fields_len) {
        val pool_ix: u32 = e.data.struct_lit.fields_start + i;
        if (pool_ix::usize >= ctx.scope.a.field_inits.len) {
            ret res[value.Value, fail.Fail].err{fail.message("lower: struct literal field index out of range")};
        }
        val fi:       *ast_expr.FieldInit         = ?ctx.scope.a.field_inits.data[pool_ix];
        val res_part: res[value.Value, fail.Fail] = whole_part(ctx, fi.value);
        if (sel res_part.err) { ret res_part; }
        val res_held: res[value.Value, fail.Fail] = builder.emit_insert(?ctx.builder, acc, res_part.ok, field_index_of(ctx, rec_ty, fi.name_id));
        if (sel res_held.err) { ret res_held; }
        acc = res_held.ok;
        i   = i + 1;
    }
    ret res[value.Value, fail.Fail].ok{acc};
}

# the value of `eid` as a member of a literal held whole: a scalar as it is and an aggregate
# held whole, read at once from where it lies
fun whole_part(ctx: *lower_context.LowerContext, eid: ast_id.ExprId) res[value.Value, fail.Fail] {
    var borrowed: bool                        = false;
    val res_v:    res[value.Value, fail.Fail] = lower_stored_rvalue(ctx, eid, true, ?borrowed);
    if (sel res_v.err)                      { ret res_v; }
    if (!is_aggregate_ir(ctx, res_v.ok.ty)) { ret res_v; }
    ret builder.emit_whole(?ctx.builder, res_v.ok);
}

# store the value of `eid` at `at`, a member of the literal being built, which nothing reads
# yet: an aggregate literal or a call's result is built there, an aggregate place is copied
# from where it lies, since the store follows its read at once, and any other value is stored
fun store_member(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, at: value.Value) err[fail.Fail] {
    val sem:    type_kind.TypeId     = lower_context.expr_type_of(ctx, eid);
    val res_ir: res[Type, fail.Fail] = ir_type_of_expr(ctx, eid);
    var dest:   value.Value          = at;
    var armed:  bool                 = false;
    if (sel res_ir.ok) {
        if (is_aggregate_ir(ctx, res_ir.ok) && !type_is_volatile_record(ctx, sem) && !lower_context.type_contains_secret(ctx, sem)) {
            dest.held = res_ir.ok;
            armed     = true;
        }
    }
    val saved_armed: bool          = ctx.into_armed;
    val saved_eid:   ast_id.ExprId = ctx.into_eid;
    val saved_slot:  value.Value   = ctx.into_slot;
    val saved_hit:   bool          = ctx.into_hit;
    ctx.into_armed = armed;
    ctx.into_eid   = eid;
    ctx.into_slot  = dest;
    ctx.into_hit   = false;
    var borrowed: bool                        = false;
    val res_v:    res[value.Value, fail.Fail] = lower_stored_rvalue(ctx, eid, true, ?borrowed);
    val built:    bool                        = ctx.into_hit;
    ctx.into_armed = saved_armed;
    ctx.into_eid   = saved_eid;
    ctx.into_slot  = saved_slot;
    ctx.into_hit   = saved_hit;
    if (sel res_v.err) { ret err[fail.Fail].err{res_v.err}; }
    if (built)         { ret err[fail.Fail].ok{}; }
    ret store_stated(ctx, res_v.ok, at, sem, false);
}

# whether a value of source type `tid`, held in `ir`, has padding whose bytes are zero where
# it is built: one that holds a secret anywhere, and any in a constant-time function, whose
# walk refuses a read of stack no store reached, as a load of the whole reads its padding
fun secret_padding(ctx: *lower_context.LowerContext, tid: type_kind.TypeId, ir: Type) res[bool, fail.Fail] {
    if (!zeroed_whole(ctx, tid)) { ret res[bool, fail.Fail].ok{false}; }
    ret irt.padded(?ctx.builder.layout, ?ctx.m.types, ir);
}

# whether a value of `tid` built here has every byte its construction does not write zeroed: one
# that holds a secret, and any in a constant-time function
fun zeroed_whole(ctx: *lower_context.LowerContext, tid: type_kind.TypeId) bool {
    if (lower_context.type_contains_secret(ctx, tid)) { ret true; }
    val opt_builder: opt[id.Function] = ctx.builder.fn;
    if (sel opt_builder.none) { ret false; }
    val mode: ConstantTime = ctx.m.functions.data[opt_builder.some].data.constant_time;
    ret !(sel mode.none);
}

# a record literal of a vector type, as the vector literal it is
fun as_vector_lit(e: *ast_expr.Expr) ast_expr.Expr {
    var vector: ast_expr.Expr = @e;
    vector.kind            = ast_expr.EXPR_KIND_VECTOR_LIT;
    vector.data.vector_lit = ast_expr.ExprVectorLit{ty: e.data.struct_lit.ty,
        elems_start: e.data.struct_lit.elems_start, elems_len: e.data.struct_lit.elems_len};
    ret vector;
}

fun lower_struct_lit(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, e: *ast_expr.Expr) res[value.Value, fail.Fail] {
    val rec_ty:   type_kind.TypeId         = lower_context.expr_type_of(ctx, eid);
    val res_case: res[opt[u32], fail.Fail] = literal_head_case_index(ctx, e.data.struct_lit.ty, rec_ty);
    if (sel res_case.err) { ret res[value.Value, fail.Fail].err{res_case.err}; }
    val opt_head: opt[u32] = res_case.ok;
    if (sel opt_head.some) { ret lower_tag_case_lit(ctx, eid, e, rec_ty, opt_head.some); }
    if (type.is_vector(ctx.s.types, rec_ty)) {
        var vector: ast_expr.Expr = as_vector_lit(e);
        ret lower_vector_lit(ctx, eid, ?vector, lower_rvalue);
    }
    val res_rec_ir: res[Type, fail.Fail] = lower_context.lower_type(ctx, rec_ty);
    if (sel res_rec_ir.err) { ret res[value.Value, fail.Fail].err{res_rec_ir.err}; }
    val rec_ir: Type = res_rec_ir.ok;

    var slot:     value.Value      = value.none();
    val opt_into: opt[value.Value] = lower_context.take_into(ctx, rec_ir);
    if (sel opt_into.some)                              { slot = opt_into.some; }
    or (lower_context.holds_whole(ctx, rec_ty, rec_ir)) { ret whole_record(ctx, e, rec_ty, rec_ir); }
    or {
        val res_slot: res[value.Value, fail.Fail] = lower_context.slot_for(ctx, rec_ty, rec_ir);
        if (sel res_slot.err) { ret res_slot; }
        slot = res_slot.ok;
    }

    # a value that holds a secret, or any in a constant-time function, has every byte the literal
    # does not write zeroed. any other record has each field the literal leaves out zeroed and
    # nothing else, and any other union is the member it names alone. a record literal that
    # names no field is all zero
    val res_pad: res[bool, fail.Fail] = secret_padding(ctx, rec_ty, rec_ir);
    if (sel res_pad.err) { ret res[value.Value, fail.Fail].err{res_pad.err}; }
    val count:   u32  = type.field_count(ctx.s.types, rec_ty);
    val partial: bool = e.data.struct_lit.fields_len < count;
    val overlap: bool = type.is_union(ctx.s.types, type.strip_secret(ctx.s.types, rec_ty));
    if (res_pad.ok || (partial && lower_context.type_contains_secret(ctx, rec_ty)) || (e.data.struct_lit.fields_len == 0 && !overlap) || (overlap && zeroed_whole(ctx, rec_ty))) {
        val err_emit_memzero: err[fail.Fail] = builder.emit_memzero(?ctx.builder, slot, rec_ir, lower_context.type_contains_secret(ctx, rec_ty));
        if (sel err_emit_memzero.err) { ret res[value.Value, fail.Fail].err{err_emit_memzero.err}; }
    }
    or (partial && !overlap) {
        var k: u32 = 0;
        for (k < count) {
            if (!literal_names(ctx, e, rec_ty, k)) {
                val res_gap: res[value.Value, fail.Fail] = field_gep(ctx, slot, rec_ty, k);
                if (sel res_gap.err) { ret res_gap; }
                val err_emit_memzero: err[fail.Fail] = builder.emit_memzero(?ctx.builder, res_gap.ok, irt.member(?ctx.m.types, rec_ir, k), false);
                if (sel err_emit_memzero.err) { ret res[value.Value, fail.Fail].err{err_emit_memzero.err}; }
            }
            k = k + 1;
        }
    }

    var i: u32 = 0;
    for (i < e.data.struct_lit.fields_len) {
        val pool_ix: u32 = e.data.struct_lit.fields_start + i;
        if (pool_ix::usize >= ctx.scope.a.field_inits.len) {
            ret res[value.Value, fail.Fail].err{fail.message("lower: struct literal field index out of range")};
        }
        val fi:       *ast_expr.FieldInit         = ?ctx.scope.a.field_inits.data[pool_ix];
        val field_ix: u32                         = field_index_of(ctx, rec_ty, fi.name_id);
        val res_at:   res[value.Value, fail.Fail] = field_gep(ctx, slot, rec_ty, field_ix);
        if (sel res_at.err) { ret res_at; }
        val err_store: err[fail.Fail] = store_member(ctx, fi.value, res_at.ok);
        if (sel err_store.err) { ret res[value.Value, fail.Fail].err{err_store.err}; }
        i = i + 1;
    }

    ret res[value.Value, fail.Fail].ok{value.retype(slot, rec_ir)};
}

# whether a record literal names field `k` of its type
fun literal_names(ctx: *lower_context.LowerContext, e: *ast_expr.Expr, rec_ty: type_kind.TypeId, k: u32) bool {
    var i: u32 = 0;
    for (i < e.data.struct_lit.fields_len) {
        val pool_ix: u32 = e.data.struct_lit.fields_start + i;
        if (pool_ix::usize >= ctx.scope.a.field_inits.len)                                   { ret true; }
        if (field_index_of(ctx, rec_ty, ctx.scope.a.field_inits.data[pool_ix].name_id) == k) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun const_value_of(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, v: comptime_value.CTValue) res[value.Value, fail.Fail] {
    ret materialize_const_value(ctx, eid, v, true);
}

pub fun const_value_of_init(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, v: comptime_value.CTValue) res[value.Value, fail.Fail] {
    ret materialize_const_value(ctx, eid, v, false);
}

# a comptime scalar as a value of the expression's type; a string is the address of a global
# holding its bytes, which a global's initialiser names as a constant address
fun materialize_const_value(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, v: comptime_value.CTValue, expr_pos: bool) res[value.Value, fail.Fail] {
    val res_ir: res[Type, fail.Fail] = ir_type_of_expr(ctx, eid);
    if (sel res_ir.err) { ret res[value.Value, fail.Fail].err{res_ir.err}; }
    val ty_id: Type = res_ir.ok;

    if (v.kind == comptime_value.CT_KIND_INT)   { ret res[value.Value, fail.Fail].ok{value.const_int_wide(v.data.w, ty_id)}; }
    if (v.kind == comptime_value.CT_KIND_FLOAT) { ret res[value.Value, fail.Fail].ok{float_constant(ctx, v.data.f, ty_id)}; }
    if (v.kind == comptime_value.CT_KIND_STR)   { ret constnode.string_global(ctx, v.data.s); }
    ret res[value.Value, fail.Fail].err{fail.message("lower: unsupported comptime value kind")};
}

fun snapshot_aggregate(ctx: *lower_context.LowerContext, source_value: value.Value, sem_ty: type_kind.TypeId, vol: bool) res[value.Value, fail.Fail] {
    val res_allocated: res[value.Value, fail.Fail] = lower_context.slot_for(ctx, sem_ty, source_value.ty);
    if (sel res_allocated.err) { ret res_allocated; }
    val slot:   value.Value = res_allocated.ok;
    var source: value.Value = source_value;
    source.secret = lower_context.type_contains_secret(ctx, sem_ty);
    builder.set_access(?ctx.builder, source.secret);
    val err_copied: err[fail.Fail] = builder.emit_store_marked(?ctx.builder, source, slot, vol || type_is_volatile_record(ctx, sem_ty));
    builder.end_access(?ctx.builder);
    if (sel err_copied.err) { ret res[value.Value, fail.Fail].err{err_copied.err}; }
    # the value owns its bytes before later expressions can mutate its source
    var result: value.Value = value.retype(slot, source_value.ty);
    result.secret = source.secret;
    ret res[value.Value, fail.Fail].ok{result};
}

# the value of `sem_ty` stored at `ptr`: a read of a secret is marked so, and its result
# is secret, and any other states the memory it reads public
fun rvalue_at(ctx: *lower_context.LowerContext, ptr: value.Value, ity: Type, sem_ty: type_kind.TypeId, vol: bool) res[value.Value, fail.Fail] {
    if (is_aggregate_ir(ctx, ity)) {
        # a call argument nothing later can write is read in place: the call's own whole
        # read is then the only copy
        if (ctx.borrow_now && !vol && !type_is_volatile_record(ctx, sem_ty)) {
            ctx.borrow_now = false;
            ctx.borrow_hit = true;
            ret res[value.Value, fail.Fail].ok{value.retype(ptr, ity)};
        }
        ret snapshot_aggregate(ctx, value.retype(ptr, ity), sem_ty, vol);
    }
    builder.set_access(?ctx.builder, lower_context.type_contains_secret(ctx, sem_ty));
    val res_emit_load_marked: res[value.Value, fail.Fail] = builder.emit_load_marked(?ctx.builder, ptr, ity, vol);
    builder.end_access(?ctx.builder);
    ret res_emit_load_marked;
}

fun global_pointer(ctx: *lower_context.LowerContext, global_ix: u32) res[value.Value, fail.Fail] {
    val space: u32 = builder.global_space(?ctx.builder, global_ix);
    ret res[value.Value, fail.Fail].ok{value.global(global_ix, builder.ptr_in(?ctx.builder, space), space)};
}

fun emit_global_rvalue(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, global_ix: u32, vty: Type) res[value.Value, fail.Fail] {
    val res_gptr: res[value.Value, fail.Fail] = global_pointer(ctx, global_ix);
    if (sel res_gptr.err) { ret res_gptr; }
    val gptr: value.Value = res_gptr.ok;
    ret rvalue_at(ctx, gptr, vty, lower_context.expr_type_of(ctx, eid), access_is_volatile(ctx, eid));
}

# the address of the function `link` of signature `sig`, declared with `linkage` and the mode `timed` its declaration
# states where this module does not define it
fun fn_reference(ctx: *lower_context.LowerContext, link: intern.StrId, sig: lower_context.FnSig, linkage: Linkage, timed: ConstantTime) res[value.Value, fail.Fail] {
    val res_xfn: res[u32, fail.Fail] = lower_context.ensure_extern_function(ctx, link, sig, linkage, timed);
    if (sel res_xfn.err) { ret res[value.Value, fail.Fail].err{res_xfn.err}; }
    ret res[value.Value, fail.Fail].ok{value.fn(res_xfn.ok, builder.ptr_type(?ctx.builder), sig.sig)};
}

fun member_receiver(ctx: *lower_context.LowerContext, obj_eid: ast_id.ExprId, out_rec_ty: *type_kind.TypeId) res[value.Value, fail.Fail] {
    val obj_ty: type_kind.TypeId = type.strip_secret(ctx.s.types, lower_context.expr_type_of(ctx, obj_eid));
    if (is_pointer_type(ctx, obj_ty)) {
        val opt_pt: opt[*type.Type] = type.get(ctx.s.types, obj_ty);
        if (sel opt_pt.none) { ret res[value.Value, fail.Fail].err{fail.message("lower: receiver base has no pointer type")}; }
        val pt: *type.Type = opt_pt.some;
        if (pt.kind != type_kind.TYPE_POINTER) {
            ret res[value.Value, fail.Fail].err{fail.message("lower: a member sema accepted reads through an untyped pointer")};
        }
        @out_rec_ty = type.strip_secret(ctx.s.types, pt.data.pointer.base);
        ret lower_rvalue(ctx, obj_eid);
    }
    @out_rec_ty = obj_ty;
    ret storage_address(ctx, obj_eid);
}

fun field_access_rec_ty(ctx: *lower_context.LowerContext, obj_eid: ast_id.ExprId) type_kind.TypeId {
    val obj_ty: type_kind.TypeId = type.strip_secret(ctx.s.types, lower_context.expr_type_of(ctx, obj_eid));
    if (is_pointer_type(ctx, obj_ty)) {
        val opt_pt: opt[*type.Type] = type.get(ctx.s.types, obj_ty);
        if (sel opt_pt.none) { ret type_kind.TYPE_ERROR; }
        val pt: *type.Type = opt_pt.some;
        if (pt.kind != type_kind.TYPE_POINTER) { ret type_kind.TYPE_ERROR; }
        ret type.strip_secret(ctx.s.types, pt.data.pointer.base);
    }
    ret obj_ty;
}

pub fun type_is_volatile_record(ctx: *lower_context.LowerContext, sem_ty: type_kind.TypeId) bool {
    val t: type_kind.TypeId = type.strip_secret(ctx.s.types, sem_ty);
    if (type_kind.is_nil(t) || type_kind.is_error(t)) { ret false; }
    val nom: type_kind.TypeId = type.aggregate_nominal(ctx.s.types, t);
    if (type_kind.is_error(nom)) { ret false; }
    ret type.decoration_of(ctx.s.types, nom).volatile_;
}

# volatility is a property of the storage an access is rooted in. the chain of
# member, projection and index steps is walked to the object it reads or writes,
# and any volatile nominal along it, the node's own type included, marks the
# access; an indirection ends the chain at its pointee, so a pointer field of a
# volatile record reaches ordinary storage and a raw scalar pointer is never
# volatile. one predicate for every access form, load and store alike
fun access_is_volatile(ctx: *lower_context.LowerContext, eid: ast_id.ExprId) bool {
    var cur: ast_id.ExprId = eid;
    for (!ast_id.expr_is_nil(cur)) {
        if (type_is_volatile_record(ctx, lower_context.expr_type_of(ctx, cur))) { ret true; }
        val res_expression: res[ast_expr.Expr, fail.Fail] = lower_context.expression(ctx, cur);
        if (sel res_expression.err) { ret false; }
        var e_value: ast_expr.Expr  = res_expression.ok;
        val e:       *ast_expr.Expr = ?e_value;
        var obj:     ast_id.ExprId  = ast_id.EXPR_NIL;
        if (e.kind == ast_expr.EXPR_KIND_MEMBER)  { obj = e.data.member.object; }
        or (e.kind == ast_expr.EXPR_KIND_PROJECT) { obj = e.data.project.object; }
        or (e.kind == ast_expr.EXPR_KIND_INDEX)   { obj = e.data.index.object; }
        or (e.kind == ast_expr.EXPR_KIND_UNARY && e.data.unary.op == ast_expr.UN_DEREF) {
            ret type_is_volatile_record(ctx, field_access_rec_ty(ctx, e.data.unary.operand));
        }
        or { ret false; }
        if (is_pointer_type(ctx, type.strip_secret(ctx.s.types, lower_context.expr_type_of(ctx, obj)))) {
            ret type_is_volatile_record(ctx, field_access_rec_ty(ctx, obj));
        }
        cur = obj;
    }
    ret false;
}

# the address of member `field_ix` of the record, union or tag `rec_ty` at `base`: a tag's
# case is its member of the payload area that holds it
fun field_gep(ctx: *lower_context.LowerContext, base: value.Value, rec_ty: type_kind.TypeId, field_ix: u32) res[value.Value, fail.Fail] {
    val res_rec_ir: res[Type, fail.Fail] = lower_context.lower_type(ctx, rec_ty);
    if (sel res_rec_ir.err) { ret res[value.Value, fail.Fail].err{res_rec_ir.err}; }
    val rec_ir: Type = res_rec_ir.ok;
    if (!type.is_tag(ctx.s.types, type.strip_secret(ctx.s.types, rec_ty))) {
        ret builder.emit_member(?ctx.builder, base, rec_ir, field_ix);
    }
    val res_carried: res[shape.Carried, fail.Fail] = lower_context.tag_carried(ctx, rec_ty, field_ix);
    if (sel res_carried.err) { ret res[value.Value, fail.Fail].err{res_carried.err}; }
    val res_area: res[value.Value, fail.Fail] = builder.emit_member(?ctx.builder, base, rec_ir, res_carried.ok.area);
    if (sel res_area.err) { ret res_area; }
    val union_ir: Type = irt.member(?ctx.m.types, rec_ir, res_carried.ok.area);
    ret builder.emit_member(?ctx.builder, res_area.ok, union_ir, res_carried.ok.member);
}

fun ir_type_of_expr(ctx: *lower_context.LowerContext, eid: ast_id.ExprId) res[Type, fail.Fail] {
    ret lower_context.lower_type(ctx, lower_context.expr_type_of(ctx, eid));
}

fun widen_index(ctx: *lower_context.LowerContext, v: value.Value, sem_ty: type_kind.TypeId) res[value.Value, fail.Fail] {
    # an index into what a logical pointer points to is read at its own width, and a
    # constant one in the word spir-v writes a constant index in where it fits there
    if (builder.classes(?ctx.builder)) {
        if (v.kind == value.VAL_INT && wide.lt_u(v.bits, wide.from_u64(0x80000000))) {
            ret res[value.Value, fail.Fail].ok{value.const_int_wide(v.bits, builder.index_type(?ctx.builder))};
        }
        ret res[value.Value, fail.Fail].ok{v};
    }
    val xty: Type = builder.index_type(?ctx.builder);
    if (scalar_bits(ctx, sem_ty) >= irt.int_width(?ctx.m.types, xty)) { ret res[value.Value, fail.Fail].ok{v}; }
    if (is_signed_type(ctx, sem_ty))                                  { ret builder.emit_sext(?ctx.builder, v, xty); }
    ret builder.emit_zext(?ctx.builder, v, xty);
}

fun repr_kind(ctx: *lower_context.LowerContext, tid: type_kind.TypeId) opt[type_kind.TypeKind] {
    val base:  type_kind.TypeId = type.strip_secret(ctx.s.types, tid);
    val opt_t: opt[*type.Type]  = type.get(ctx.s.types, base);
    if (sel opt_t.none) { ret opt[type_kind.TypeKind].none{}; }
    ret opt[type_kind.TypeKind].some{opt_t.some.kind};
}

fun scalar_bits(ctx: *lower_context.LowerContext, tid: type_kind.TypeId) u32 {
    val opt_repr_kind: opt[type_kind.TypeKind] = repr_kind(ctx, tid);
    if (sel opt_repr_kind.none) { ret 0; }
    val k: type_kind.TypeKind = opt_repr_kind.some;
    val d: type_prim.PrimDesc = type_prim.prim_desc(k);
    if (d.class == type_prim.PRIM_CLASS_INT || d.class == type_prim.PRIM_CLASS_FLOAT)      { ret d.bits; }
    if (k == type_kind.TYPE_PTR || k == type_kind.TYPE_POINTER || k == type_kind.TYPE_FUN) { ret ctx.facts.pointer_width * 8; }
    ret 0;
}

fun is_signed_type(ctx: *lower_context.LowerContext, tid: type_kind.TypeId) bool {
    val opt_repr_kind: opt[type_kind.TypeKind] = repr_kind(ctx, tid);
    if (sel opt_repr_kind.none) { ret false; }
    ret type_prim.prim_desc(opt_repr_kind.some).signed;
}

fun is_float_type(ctx: *lower_context.LowerContext, tid: type_kind.TypeId) bool {
    val opt_repr_kind: opt[type_kind.TypeKind] = repr_kind(ctx, tid);
    if (sel opt_repr_kind.none) { ret false; }
    ret type_prim.prim_desc(opt_repr_kind.some).class == type_prim.PRIM_CLASS_FLOAT;
}

fun is_array_type(ctx: *lower_context.LowerContext, tid: type_kind.TypeId) bool {
    val opt_t: opt[*type.Type] = type.get(ctx.s.types, type.strip_secret(ctx.s.types, tid));
    if (sel opt_t.none) { ret false; }
    ret opt_t.some.kind == type_kind.TYPE_ARRAY;
}

fun is_pointer_type(ctx: *lower_context.LowerContext, tid: type_kind.TypeId) bool {
    val opt_t: opt[*type.Type] = type.get(ctx.s.types, tid);
    if (sel opt_t.none) { ret false; }
    val k: type_kind.TypeKind = opt_t.some.kind;
    ret k == type_kind.TYPE_PTR || k == type_kind.TYPE_POINTER;
}

fun is_aggregate_ir(ctx: *lower_context.LowerContext, ity: Type) bool {
    ret irt.is_aggregate(?ctx.m.types, ity);
}

# the index of the member `name` names in `rec_ty`; a name sema bound that names no member, or
# one that cannot be interned, records an internal failure and answers 0
fun field_index_in_type(ctx: *lower_context.LowerContext, rec_ty: type_kind.TypeId, name: base_source.Span) u32 {
    val src_text: str                        = lower_context.module_source(ctx);
    val res_want: res[intern.StrId, A.Error] = intern.range_add(ctx.s.interner, src_text, name.offset, name.len);
    if (sel res_want.err) {
        lower_context.internal(ctx, fail.refused(res_want.err));
        ret 0;
    }
    ret field_index_of(ctx, rec_ty, res_want.ok);
}

# the index of the member `want` names in `rec_ty`, as field_index_in_type. an instance type's
# fields are derived on first need, and naming a member may be the first
fun field_index_of(ctx: *lower_context.LowerContext, rec_ty: type_kind.TypeId, want: intern.StrId) u32 {
    val err_ensured: err[fail.Fail] = subst.ensure_fields(ctx.s, rec_ty);
    if (sel err_ensured.err) {
        val refused: fail.Fail = lower_context.refuse(ctx, err_ensured.err);
        if (sel ctx.status.kind.accepted) { lower_context.internal(ctx, refused); }
        ret 0;
    }
    val fields_len: u32 = type.field_count(ctx.s.types, rec_ty);
    var i:          u32 = 0;
    for (i < fields_len) {
        val opt_fe: opt[*type_field.Entry] = type.field_at(ctx.s.types, rec_ty, i);
        if (sel opt_fe.some) {
            if (intern.str_same(opt_fe.some.name, want)) { ret i; }
        }
        i = i + 1;
    }

    lower_context.internal(ctx, fail.message("lower: a member name sema bound names no member of its type"));
    ret 0;
}

fun find_global(ctx: *lower_context.LowerContext, name: intern.StrId) opt[u32] {
    ret lower_context.global_named(ctx, name);
}
