# what a build declares about linkage, owned by the build's project and read
# by the lowering that names declarations and the linker that binds imports:
# each declaration's export name and library, the name each declaration links
# under once the lowering has named it, and the library each imported symbol is
# pinned to
use std.collections.map;
use collections_vector: std.collections.vector;
use std.collections.vector.Vector;
use std.types.bool.bool;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;

use mach.base.fail;
use mach.base.intern;
use mach.base.role;
use mach.session.module;

# what the build knows an imported symbol to be
pub def Sort: u8;

# nothing, as of a name a manifest entry claims for an archive
pub val UNSTATED: Sort = 0;
# a function, as an `ext fun` declares
pub val CODE: Sort = 1;
# a variable, as an `ext val` or `ext var` declares
pub val DATA: Sort = 2;

# an imported symbol pinned to a library
# ---
# name:   its link name
# lib:    the library's key
# sort:   what the build knows it to be
# listed: whether the library's link entry lists it, so every object claims it, referring to it or not
pub rec Import {
    name:   intern.StrId;
    lib:    intern.StrId;
    sort:   Sort;
    listed: bool;
}

# the name each declaration links under once a lowering has named it, keyed as a linkage keys
# declarations. a name is a pure function of its key, so a memo serves every lowering that names
# its strings where the memo's names were named: the project's serves each lowering on the owner,
# and a lowering that names its strings in an interner of its own keeps one of its own
pub rec Named {
    names: map.Map[u64, intern.StrId];
}

# an empty memo
# ---
# alloc: the allocator the memo's map takes
# ret:   the memo, which `named_dnit` gives back
pub fun named_init(alloc: *A.Allocator) Named {
    ret Named{names: map.init[u64, intern.StrId](alloc)};
}

# give back a memo's map
# ---
# n: the memo, unusable after
pub fun named_dnit(n: *Named) {
    map.dnit[u64, intern.StrId](?n.names);
}

# keyed by declaration: a module's index in the high 32 bits, its declaration
# index in the low
# imports holds every pinned import in the order it was first pinned, and import_at its index
# there by link name
pub rec Linkage {
    export_names:     map.Map[u64, intern.StrId];
    named:            Named;
    export_libraries: map.Map[u64, intern.StrId];
    imports:          Vector[Import];
    import_at:        map.Map[intern.StrId, usize];
}

# an empty linkage record whose tables allocate from `alloc`
# ---
# alloc: the allocator every table grows from
# ret:   the linkage, which the caller releases with dnit
pub fun init(alloc: *A.Allocator) Linkage {
    ret Linkage{
        export_names:     map.init[u64, intern.StrId](alloc),
        named:            named_init(alloc),
        export_libraries: map.init[u64, intern.StrId](alloc),
        imports:          collections_vector.init[Import](alloc),
        import_at:        map.init[intern.StrId, usize](alloc)
    };
}

# release every table of `l`
# ---
# l: the linkage to release
pub fun dnit(l: *Linkage) {
    map.dnit[u64, intern.StrId](?l.export_names);
    named_dnit(?l.named);
    map.dnit[u64, intern.StrId](?l.export_libraries);
    collections_vector.dnit[Import](?l.imports);
    map.dnit[intern.StrId, usize](?l.import_at);
}

# the key of declaration `did` of `mid`: the module's index high, the declaration's low
fun declaration(mid: module.ModuleId, did: u32) u64 {
    ret (module.index(mid)::u64 << 32) | did::u64;
}

fun name_of(table: *map.Map[u64, intern.StrId], key: u64) intern.StrId {
    val opt_table_entry: opt[*intern.StrId] = map.get[u64, intern.StrId](table, ?key);
    if (sel opt_table_entry.some) { ret @opt_table_entry.some; }
    ret intern.STR_NIL;
}

# record the name declaration `did` of `mid` is exported under, replacing an earlier one
# ---
# l:    the linkage
# mid:  the declaration's module
# did:  the declaration's index in that module
# name: the export name
# ret:  ok, or the allocator's refusal
pub fun register_export_name(l: *Linkage, mid: module.ModuleId, did: u32, name: intern.StrId) err[fail.Fail] {
    $if (role.CHECKED) { role.touched(role.LINKAGE, nil); }

    val res_inserted: res[bool, A.Error] = map.insert[u64, intern.StrId](?l.export_names, declaration(mid, did), name);
    if (sel res_inserted.err) { ret err[fail.Fail].err{fail.refused(res_inserted.err)}; }
    ret err[fail.Fail].ok{};
}

# drop every export name and linkage name of one module's declarations, before
# its syntax tree is replaced and its declaration ids no longer name the same
# declarations
# ---
# mid:        the module whose names go
# decl_count: the declaration count of the syntax tree they were registered against
pub fun forget_names(l: *Linkage, mid: module.ModuleId, decl_count: u32) {
    $if (role.CHECKED) { role.touched(role.LINKAGE, nil); }

    var did: u32 = 0;
    for (did < decl_count) {
        var key: u64 = declaration(mid, did);
        map.remove[u64, intern.StrId](?l.export_names, ?key);
        map.remove[u64, intern.StrId](?l.named.names, ?key);
        did = did + 1;
    }
}

# the name declaration `did` of `mid` is exported under, nil when it names none
pub fun export_name(l: *Linkage, mid: module.ModuleId, did: u32) intern.StrId {
    ret name_of(?l.export_names, declaration(mid, did));
}

# record in `n` the name declaration `did` of `mid` links under, as the lowering
# first names it
pub fun register_name(n: *Named, mid: module.ModuleId, did: u32, name: intern.StrId) err[fail.Fail] {
    $if (role.CHECKED) { role.touched(role.LINKAGE, n::ptr); }

    val res_inserted: res[bool, A.Error] = map.insert[u64, intern.StrId](?n.names, declaration(mid, did), name);
    if (sel res_inserted.err) { ret err[fail.Fail].err{fail.refused(res_inserted.err)}; }
    ret err[fail.Fail].ok{};
}

# the name `n` holds for declaration `did` of `mid`, nil before a lowering has named it there
pub fun name(n: *Named, mid: module.ModuleId, did: u32) intern.StrId {
    ret name_of(?n.names, declaration(mid, did));
}

# record the library declaration `did` of `mid` is imported from, replacing an earlier one
# ---
# l:   the linkage
# mid: the declaration's module
# did: the declaration's index in that module
# lib: the library's key
# ret: ok, or the allocator's refusal
pub fun register_export_library(l: *Linkage, mid: module.ModuleId, did: u32, lib: intern.StrId) err[fail.Fail] {
    $if (role.CHECKED) { role.touched(role.LINKAGE, nil); }

    val res_inserted: res[bool, A.Error] = map.insert[u64, intern.StrId](?l.export_libraries, declaration(mid, did), lib);
    if (sel res_inserted.err) { ret err[fail.Fail].err{fail.refused(res_inserted.err)}; }
    ret err[fail.Fail].ok{};
}

# the library declaration `did` of `mid` is imported from, nil when it names none
pub fun export_library(l: *Linkage, mid: module.ModuleId, did: u32) intern.StrId {
    ret name_of(?l.export_libraries, declaration(mid, did));
}

# pin the imported symbol `name`, known as `sort`, to the library `lib`, `listed` when the
# library's link entry lists it. a symbol pinned again takes the later pin, a sort the earlier
# one left unstated included, and stays listed once a pin lists it
pub fun register_import_library(l: *Linkage, name: intern.StrId, lib: intern.StrId, sort: Sort, listed: bool) err[fail.Fail] {
    $if (role.CHECKED) { role.touched(role.LINKAGE, nil); }

    val opt_known: opt[*usize] = map.get[intern.StrId, usize](?l.import_at, ?name);
    if (sel opt_known.some) {
        val held: *Import = ?l.imports.data[@opt_known.some];
        held.lib    = lib;
        held.listed = held.listed || listed;
        if (sort != UNSTATED) { held.sort = sort; }
        ret err[fail.Fail].ok{};
    }
    val at:         usize               = l.imports.len;
    val res_pushed: res[usize, A.Error] = collections_vector.push[Import](?l.imports, Import{name: name, lib: lib, sort: sort, listed: listed});
    if (sel res_pushed.err) { ret err[fail.Fail].err{fail.refused(res_pushed.err)}; }
    val res_indexed: res[bool, A.Error] = map.insert[intern.StrId, usize](?l.import_at, name, at);
    if (sel res_indexed.err) {
        collections_vector.truncate[Import](?l.imports, at);
        ret err[fail.Fail].err{fail.refused(res_indexed.err)};
    }
    ret err[fail.Fail].ok{};
}

# the library the imported symbol `name` is pinned to, nil when it is pinned to none
pub fun import_library(l: *Linkage, name: intern.StrId) intern.StrId {
    val opt_import_at_entry: opt[*usize] = map.get[intern.StrId, usize](?l.import_at, ?name);
    if (sel opt_import_at_entry.some) { ret l.imports.data[@opt_import_at_entry.some].lib; }
    ret intern.STR_NIL;
}
