# the lowering of declarations: functions, instances, class copies and globals
#
# it decides how far each definition is seen and where it is placed: an instance merged by source
# identity, or weak where the target's objects merge none, a `#[weak]` default, an `#[export]` in
# the export table, a class copy local to the module that asked for it, and a global's section and
# `#[at]` offset. a global's initial bytes come from the value its module's interface publishes.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use A: std.allocator;

use mach.base.diagnostic;
use mach.base.fail;
use mach.base.intern;
use base_source: mach.base.source;
use mach.base.stack;
use mach.front.ast;
use ast_decl: mach.front.ast.decl;
use ast_expr: mach.front.ast.expr;
use ast_id:   mach.front.ast.id;
use mach.front.comptime;
use comptime_deep: mach.front.comptime.deep;
use mach.front.decorator;
use mach.front.resolve;
use mach.lower.builder;
use mach.lower.constnode;
use lower_context: mach.lower.context;
use lower_expr:    mach.lower.expr;
use op_intrinsic:  mach.lower.intrinsic;
use mach.lower.irt;
use mach.lower.mangle;
use mach.lower.placement;
use lower_shader: mach.lower.shader;
use lower_stmt:   mach.lower.stmt;
use mach.lower.value;
use session_embed: mach.session.embed;
use mach.type;

use comptime_failure: mach.front.comptime.failure;
use comptime_scope:   mach.front.comptime.scope;
use comptime_value:   mach.front.comptime.value;
use sema_interface:   mach.front.sema.interface;
use report_phase:     mach.report.phase;
use type_kind:        mach.type.kind;
use mink_section:     mink.model.section;
use mink.model.symbol;
use mirl.ir.attribute.Attribute;
use mirl.ir.attribute.Datum;
use mirl_function: mirl.ir.function;
use mirl.ir.function.ConstantTime;
use mirl.ir.function.FunctionData;
use mirl.ir.function.NO_EXTENSIONS;
use mirl_global: mirl.ir.global;
use mirl.ir.global.GlobalData;
use mirl.ir.global.Section;
use mirl.ir.id;
use mirl.ir.linkage;
use mirl.ir.linkage.Linkage;
use mirl_module: mirl.ir.module;
use types:       mirl.ir.type.table;
use mirl.ir.type.table.Type;
use register_schema: mirl.target.register.schema;
use std.collections.slice.Slice;
use collections_vector: std.collections.vector;
use std.types.string.str_len;
use std.types.view.View;

pub fun lower_decl(ctx: *lower_context.LowerContext, did: ast_id.DeclId) err[fail.Fail] {
    val opt_decl: opt[*ast_decl.Decl] = ast.get_decl(ctx.scope.a, did);
    if (sel opt_decl.none) {
        ret err[fail.Fail].err{fail.message("lower: declaration id out of range")};
    }
    val d: *ast_decl.Decl    = opt_decl.some;
    val k: ast_decl.DeclKind = d.kind;
    if (stack.exhausted()) { ret err[fail.Fail].err{lower_context.refuse_nesting(ctx, d.span)}; }

    # a `#[testing]` declaration is checked in every build and emitted only in the test object
    val testing:     bool = resolve.declaration_testing(ctx.scope.a, did);
    val test_object: bool = ctx.normal_object != nil;
    if (!test_object && testing)     { ret err[fail.Fail].ok{}; }
    if (k == ast_decl.DECL_KIND_FUN) { ret lower_fun(ctx, did, d); }
    if (k == ast_decl.DECL_KIND_TEST) {
        if (!test_object) { ret err[fail.Fail].ok{}; }
        ret lower_test(ctx, did, d);
    }
    if (k == ast_decl.DECL_KIND_VAL)         { ret lower_global(ctx, did, d, false); }
    if (k == ast_decl.DECL_KIND_VAR)         { ret lower_global(ctx, did, d, true); }
    if (k == ast_decl.DECL_KIND_COMPTIME_IF) { ret lower_comptime_if(ctx, d); }

    if (k == ast_decl.DECL_KIND_ERROR) {
        ret err[fail.Fail].err{fail.message("lower: error declaration reached the middle end")};
    }

    ret err[fail.Fail].ok{};
}

# an instance, defined in every object whose code reaches it: a merged definition of its source
# identity, so the link keeps one copy, two libraries built apart from the same source that each
# hold it link together and ones built from different source are refused, and hidden, so no
# image exports it. weak where the target's objects hold no merged definitions. the copy
# constant-time code calls is local to the object that calls it, so no definition elsewhere in
# the link replaces what the walk of its caller read
fun instance_linkage(ctx: *lower_context.LowerContext, defining: lower_context.Defining) Linkage {
    if (sel defining.merged) { ret Linkage{binding: ?symbol.GLOBAL, visibility: lower_context.internal_visibility(ctx), merged: opt[u64].some{defining.merged}}; }
    if (sel defining.local)  { ret linkage.local(); }
    ret Linkage{binding: ?symbol.WEAKLY, visibility: lower_context.internal_visibility(ctx)};
}

# a `#[weak]` definition, a link-time default: replaced by a strong definition in the same
# link, and seen outside its image only when `#[export]` says so
fun default_linkage(ctx: *lower_context.LowerContext) Linkage {
    ret Linkage{binding: ?symbol.WEAKLY, visibility: lower_context.internal_visibility(ctx), replaceable: true};
}

# how far the function `d` of this module is seen
fun function_linkage(ctx: *lower_context.LowerContext, d: *ast_decl.Decl) Linkage {
    if (decorator.has(ctx.scope.a, d, decorator.WEAK)) { ret exported(ctx, d, default_linkage(ctx)); }
    ret exported(ctx, d, lower_context.image_linkage(ctx));
}

# a class copy, local to the module whose call asked for it
fun class_copy_linkage() Linkage {
    ret Linkage{binding: ?symbol.LOCAL, visibility: ?symbol.DEFAULT};
}

# a linkage a `#[export]` declaration puts in a shared library's export table, seen outside the
# image whatever project declares it (`exported_visibility`)
fun exported(ctx: *lower_context.LowerContext, d: *ast_decl.Decl, l: Linkage) Linkage {
    var out: Linkage = l;
    out.export = decorator.has(ctx.scope.a, d, decorator.EXPORT);
    if (out.export) { out.visibility = exported_visibility(ctx, d); }
    ret out;
}

# the visibility of an exported declaration: default, but sealed (`Machine.sealed`) for a
# constant-time function its callers in the image trust (`declared_mode`), so no load preempts
# the code their walk read with code of another timing
fun exported_visibility(ctx: *lower_context.LowerContext, d: *ast_decl.Decl) *symbol.Visibility {
    val trusted: ConstantTime = declared_mode(ctx, d);
    if (sel trusted.none) { ret ?symbol.DEFAULT; }
    ret ctx.machine.sealed;
}

# how a `#[thread]` var is reached, none for any other binding; one an `ext` declaration
# names may live in another image
fun thread_of(ctx: *lower_context.LowerContext, d: *ast_decl.Decl, foreign_image: bool) opt[mirl_global.Tls] {
    if (!decorator.has(ctx.scope.a, d, decorator.THREAD)) { ret opt[mirl_global.Tls].none{}; }
    ret lower_context.thread_model(ctx, foreign_image);
}

fun lower_fun(ctx: *lower_context.LowerContext, did: ast_id.DeclId, d: *ast_decl.Decl) err[fail.Fail] {
    if (d.data.fun_.generics_len > 0)   { ret err[fail.Fail].ok{}; }
    if (fun_has_comptime_param(ctx, d)) { ret err[fail.Fail].ok{}; }
    if (fun_has_pack_param(ctx, d))     { ret err[fail.Fail].ok{}; }

    val res_sig: res[lower_context.FnSig, fail.Fail] = lower_context.lower_fn_sig(ctx, did);
    if (sel res_sig.err) { ret err[fail.Fail].err{res_sig.err}; }
    val sig: lower_context.FnSig = res_sig.ok;

    val res_bare: res[intern.StrId, fail.Fail] = function_bare_name(ctx, d);
    if (sel res_bare.err) { ret err[fail.Fail].err{res_bare.err}; }
    val bare: intern.StrId = res_bare.ok;

    val res_name: res[intern.StrId, fail.Fail] = mangle.declaration_linkage_name(ctx.linkage, ctx.s, ctx.scope.own_module, bare, did::u32);
    if (sel res_name.err) { ret err[fail.Fail].err{res_name.err}; }
    val name: intern.StrId = res_name.ok;

    val opt_own: opt[*sema_interface.Declaration] = sema_interface.declaration_at(ctx.scope.iface, did);
    if (sel opt_own.none) { ret err[fail.Fail].err{fail.message("lower: a function has no declaration in its module's interface")}; }
    # an instruction of the target's catalog is no function: each call is the instruction, and the declaration is held to its row
    if (!intern.str_is_nil(opt_own.some.op_set)) { ret op_intrinsic.declared(ctx, d.data.fun_.name, opt_own.some, lower_context.decl_type_of(ctx, did)); }
    # a body the normal object defines is declared in the test object
    var declared_only: bool = (d.flags & ast_decl.DECL_FLAG_EXT) != 0 || ast_id.stmt_is_nil(d.data.fun_.body);
    if (lower_context.normal_defines(ctx, name)) { declared_only = true; }
    if (declared_only) {
        val res_declared: res[u32, fail.Fail] = lower_context.ensure_extern_function(ctx, name, sig, lower_context.external_linkage(), declared_mode(ctx, d));
        if (sel res_declared.err) { ret err[fail.Fail].err{res_declared.err}; }
        ret err[fail.Fail].ok{};
    }

    # where pointers name a storage class, a function taking one is lowered only as the
    # copies its callers' classes ask for
    if (builder.classes(?ctx.builder) && irt.takes_pointer(?ctx.m.types, sig.sig)) { ret err[fail.Fail].ok{}; }

    val res_idx: res[u32, fail.Fail] = define_function(ctx, name, sig, function_linkage(ctx, d), d);
    if (sel res_idx.err) { ret err[fail.Fail].err{res_idx.err}; }
    val err_staged: err[fail.Fail] = lower_shader.function_attributes(ctx, d, res_idx.ok, bare);
    if (sel err_staged.err) { ret err_staged; }
    ret emit_function_body(ctx, did, d, res_idx.ok, sig, lower_context.decl_ret_sem(ctx, did), base_source.location(ctx.scope.a.file_id, d.data.fun_.name));
}

# the mode a caller may trust the function `d` holds: its own, but none for a `#[weak]` default another definition
# may replace, as the interface publishes it (`lower_context.declaration_mode`)
fun declared_mode(ctx: *lower_context.LowerContext, d: *ast_decl.Decl) ConstantTime {
    if (decorator.has(ctx.scope.a, d, decorator.WEAK)) { ret ConstantTime.none{}; }
    ret constant_time(ctx, d);
}

# a function's constant-time mode, as its `#[constant_time]` names it: its secrets never steer its timing
fun constant_time(ctx: *lower_context.LowerContext, d: *ast_decl.Decl) ConstantTime {
    val opt_mode: opt[str] = decorator.constant_time_mode(?ctx.s.interner, ctx.scope.ctx, ctx.scope.a, d);
    if (sel opt_mode.none)                 { ret ConstantTime.none{}; }
    if (str_equals(opt_mode.some, "soft")) { ret ConstantTime.soft{}; }
    if (str_equals(opt_mode.some, "hard")) { ret ConstantTime.hard{}; }
    ret ConstantTime.none{};
}

# an instance bound as `defining` states, or with `copy` the class copy of it taking its
# pointers in the classes `copy` states, under the name `name` each way. a generic and a
# comptime-parameter instance are lowered alike: the substitution or the bound values are the
# scope's
pub fun lower_instance(ctx: *lower_context.LowerContext, did: ast_id.DeclId, d: *ast_decl.Decl, name: intern.StrId, defining: lower_context.Defining, copy: opt[Type]) err[fail.Fail] {
    if (ast_id.stmt_is_nil(d.data.fun_.body)) { ret err[fail.Fail].ok{}; }

    val res_sig: res[lower_context.FnSig, fail.Fail] = lower_context.lower_fn_sig(ctx, did);
    if (sel res_sig.err) { ret err[fail.Fail].err{res_sig.err}; }
    var sig:     lower_context.FnSig = res_sig.ok;
    var linkage: Linkage             = instance_linkage(ctx, defining);
    if (sel copy.some) {
        sig.sig = copy.some;
        linkage = class_copy_linkage();
    }
    or (builder.classes(?ctx.builder) && irt.takes_pointer(?ctx.m.types, sig.sig)) {
        # where pointers name a storage class, an instance taking one is lowered only as the
        # copies its callers' classes ask for
        ret err[fail.Fail].ok{};
    }

    val res_idx: res[u32, fail.Fail] = define_function(ctx, name, sig, linkage, d);
    if (sel res_idx.err) { ret err[fail.Fail].err{res_idx.err}; }
    ret emit_function_body(ctx, did, d, res_idx.ok, sig, lower_context.decl_ret_sem(ctx, did), base_source.location(ctx.scope.a.file_id, d.data.fun_.name));
}

pub fun lower_pack_instance(ctx: *lower_context.LowerContext, did: ast_id.DeclId, d: *ast_decl.Decl,
    name: intern.StrId, types: *type_kind.TypeId, type_len: u32, defining: lower_context.Defining, copy: opt[Type]) err[fail.Fail] {
    if (ast_id.stmt_is_nil(d.data.fun_.body)) { ret err[fail.Fail].ok{}; }

    val fixed_count: u32 = d.data.fun_.params_len - 1;

    val res_sig: res[lower_context.FnSig, fail.Fail] = lower_context.pack_instance_sig(ctx, lower_context.decl_type_of(ctx, did), types, type_len);
    if (sel res_sig.err) { ret err[fail.Fail].err{res_sig.err}; }
    var sig:     lower_context.FnSig = res_sig.ok;
    var linkage: Linkage             = instance_linkage(ctx, defining);
    if (sel copy.some) {
        sig.sig = copy.some;
        linkage = class_copy_linkage();
    }
    or (builder.classes(?ctx.builder) && irt.takes_pointer(?ctx.m.types, sig.sig)) { ret err[fail.Fail].ok{}; }

    val res_idx: res[u32, fail.Fail] = define_function(ctx, name, sig, linkage, d);
    if (sel res_idx.err) { ret err[fail.Fail].err{res_idx.err}; }
    val fn_index: u32 = res_idx.ok;

    val ret_sem:     type_kind.TypeId = lower_context.decl_ret_sem(ctx, did);
    val err_entered: err[fail.Fail]   = enter_function(ctx, fn_index, sig, ret_sem, base_source.location(ctx.scope.a.file_id, d.data.fun_.name));
    if (sel err_entered.err) { ret err_entered; }

    ctx.pack_types    = types;
    ctx.pack_len      = type_len;
    ctx.pack_ret_type = ret_sem;

    val err_params: err[fail.Fail] = lower_pack_params(ctx, did, d, fixed_count, types, type_len);
    if (sel err_params.err) {
        clear_pack_state(ctx);
        ret err_params;
    }

    val err_body: err[fail.Fail] = lower_stmt.lower_stmt(ctx, d.data.fun_.body);
    if (sel err_body.err) {
        clear_pack_state(ctx);
        ret err_body;
    }

    val err_close: err[fail.Fail] = function_end(ctx);
    clear_pack_state(ctx);
    ret err_close;
}

fun fun_has_comptime_param(ctx: *lower_context.LowerContext, d: *ast_decl.Decl) bool {
    var i: u32 = 0;
    for (i < d.data.fun_.params_len) {
        val pool_ix: u32 = d.data.fun_.params_start + i;
        if (pool_ix::usize < ctx.scope.a.typed_names.len && ctx.scope.a.typed_names.data[pool_ix].comptime) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun fun_has_pack_param(ctx: *lower_context.LowerContext, d: *ast_decl.Decl) bool {
    val n: u32 = d.data.fun_.params_len;
    if (n == 0) { ret false; }
    val pool_ix: u32 = d.data.fun_.params_start + (n - 1);
    if (pool_ix::usize >= ctx.scope.a.typed_names.len) { ret false; }
    val tn:       *ast_decl.TypedName = ?ctx.scope.a.typed_names.data[pool_ix];
    val pt:       type_kind.TypeId    = lower_context.type_resolved_of(ctx, tn.ty);
    val opt_type: opt[*type.Type]     = type.get(?ctx.s.types, pt);
    if (sel opt_type.none) { ret false; }
    ret opt_type.some.kind == type_kind.TYPE_PACK;
}

# a global's section: the named one `#[section]` gives it, of the kind its mutability needs
# the section a function's `#[section]` places its code in, of mink's executable kind
fun function_section(ctx: *lower_context.LowerContext, d: *ast_decl.Decl) opt[Section] {
    val named: intern.StrId = decl_section_of(ctx, d);
    if (intern.str_is_nil(named)) { ret opt[Section].none{}; }
    val text: str = intern.text(?ctx.s.interner, named);
    ret opt[Section].some{Section{name: View{data: text, len: str_len(text)}, kind: ?mink_section.TEXT}};
}

# a global's section, or the section of its own `#[at]` places, named for its offset
fun global_section(ctx: *lower_context.LowerContext, d: *ast_decl.Decl, is_mut: bool) res[opt[Section], fail.Fail] {
    var kind: *mink_section.Kind = ?mink_section.RODATA;
    if (is_mut)                                          { kind = ?mink_section.DATA; }
    if (decorator.has(ctx.scope.a, d, decorator.THREAD)) { kind = ?mink_section.TLS_DATA; }
    val res_placed: res[opt[u64], fail.Fail] = decl_at_of(ctx, d);
    if (sel res_placed.err) { ret res[opt[Section], fail.Fail].err{res_placed.err}; }
    if (sel res_placed.ok.some) {
        val opt_section_name: opt[str] = placement.section_name(?ctx.s.interner, res_placed.ok.some);
        if (sel opt_section_name.none) { ret res[opt[Section], fail.Fail].err{fail.message("lower: a placed global's section name could not be held")}; }
        ret res[opt[Section], fail.Fail].ok{opt[Section].some{Section{name: View{data: opt_section_name.some, len: str_len(opt_section_name.some)}, kind: kind}}};
    }
    val named: intern.StrId = decl_section_of(ctx, d);
    if (intern.str_is_nil(named)) { ret res[opt[Section], fail.Fail].ok{opt[Section].none{}}; }
    val text: str = intern.text(?ctx.s.interner, named);
    ret res[opt[Section], fail.Fail].ok{opt[Section].some{Section{name: View{data: text, len: str_len(text)}, kind: kind}}};
}

# the offset a global's `#[at]` places it at, none without one
fun decl_at_of(ctx: *lower_context.LowerContext, d: *ast_decl.Decl) res[opt[u64], fail.Fail] {
    val opt_arg: opt[ast_id.ExprId] = decorator_arg_eid(ctx, d, decorator.AT, 0);
    if (sel opt_arg.none) { ret res[opt[u64], fail.Fail].ok{opt[u64].none{}}; }
    val res_u64: res[Type, fail.Fail] = irt.int(?ctx.m.types, 64);
    if (sel res_u64.err) { ret res[opt[u64], fail.Fail].err{res_u64.err}; }
    val res_fold: res[value.Value, fail.Fail] = fold_global_init(ctx, ast_id.DECL_NIL, opt_arg.some, res_u64.ok, intern.STR_NIL);
    if (sel res_fold.err)                  { ret res[opt[u64], fail.Fail].err{res_fold.err}; }
    if (res_fold.ok.kind != value.VAL_INT) { ret res[opt[u64], fail.Fail].err{fail.message("lower: an `at` sema accepted did not fold to an integer")}; }
    ret res[opt[u64], fail.Fail].ok{opt[u64].some{value.int_lit(res_fold.ok)}};
}

fun lower_global(ctx: *lower_context.LowerContext, did: ast_id.DeclId, d: *ast_decl.Decl, is_mut: bool) err[fail.Fail] {
    val sem:     type_kind.TypeId     = lower_context.decl_type_of(ctx, did);
    val res_gty: res[Type, fail.Fail] = lower_context.lower_type(ctx, sem);
    if (sel res_gty.err) { ret err[fail.Fail].err{res_gty.err}; }
    val gty: Type = res_gty.ok;

    val res_bare: res[intern.StrId, A.Error] = intern.range_add(?ctx.s.interner, lower_context.module_source(ctx), d.data.bind.name.offset, d.data.bind.name.len);
    if (sel res_bare.err) { ret err[fail.Fail].err{fail.refused(res_bare.err)}; }
    val bare: intern.StrId = res_bare.ok;

    val res_name: res[intern.StrId, fail.Fail] = mangle.declaration_linkage_name(ctx.linkage, ctx.s, ctx.scope.own_module, bare, did::u32);
    if (sel res_name.err) { ret err[fail.Fail].err{res_name.err}; }
    val name: intern.StrId = res_name.ok;

    # the normal object defines it: a test that reads it declares it where it does
    if (lower_context.normal_defines(ctx, name)) { ret err[fail.Fail].ok{}; }

    if ((d.flags & ast_decl.DECL_FLAG_EXT) != 0) {
        val res_declared: res[u32, fail.Fail] = lower_context.ensure_extern_global(ctx, name, gty, thread_of(ctx, d, true), sem, lower_context.external_linkage(), false);
        if (sel res_declared.err) { ret err[fail.Fail].err{res_declared.err}; }
        ret err[fail.Fail].ok{};
    }

    # a `#[gpu.spec]` var is a specialization constant wherever it is read
    if (lower_shader.specialized(ctx, d)) { ret err[fail.Fail].ok{}; }

    var init_val: value.Value = value.const_null(gty);
    if (decorator.has(ctx.scope.a, d, decorator.EMBED)) {
        val res_embed_file_of: res[*session_embed.EmbedFile, fail.Fail] = embed_file_of(ctx, d);
        if (sel res_embed_file_of.err) { ret err[fail.Fail].err{res_embed_file_of.err}; }
        val res_bytes: res[value.Value, fail.Fail] = constnode.bytes_constant(ctx, res_embed_file_of.ok.bytes, res_embed_file_of.ok.len::u64);
        if (sel res_bytes.err) { ret err[fail.Fail].err{res_bytes.err}; }
        init_val = res_bytes.ok;
    }
    or (!ast_id.expr_is_nil(d.data.bind.init)) {
        val res_fold: res[value.Value, fail.Fail] = fold_global_init(ctx, did, d.data.bind.init, gty, bare);
        if (sel res_fold.err) { ret err[fail.Fail].err{res_fold.err}; }
        init_val = res_fold.ok;
    }

    val res_align: res[u32, fail.Fail] = decl_align_of(ctx, d);
    if (sel res_align.err) { ret err[fail.Fail].err{res_align.err}; }
    var align: u64 = res_align.ok::u64;
    if (align == 0) { align = lower_context.storage_align(ctx, gty); }

    val initial:   id.Constant    = builder.constant_of(?ctx.builder, init_val);
    val err_built: err[fail.Fail] = lower_context.builder_state(ctx);
    if (sel err_built.err) { ret err_built; }

    var g: GlobalData;
    g.name    = lower_context.symbol_name(ctx, name);
    g.type    = init_val.ty;
    g.initial = opt[id.Constant].some{initial};
    if (!lower_shader.initialized(ctx, d)) { g.initial = opt[id.Constant].none{}; }
    g.alignment = opt[u64].some{align};
    val res_section: res[opt[Section], fail.Fail] = global_section(ctx, d, is_mut);
    if (sel res_section.err) { ret err[fail.Fail].err{res_section.err}; }
    g.section  = res_section.ok;
    g.tls      = thread_of(ctx, d, false);
    g.linkage  = exported(ctx, d, lower_context.image_linkage(ctx));
    g.constant = !is_mut;

    # how much of it is secret, from its source type, which every constant-time walk seeds
    var ranges: collections_vector.Vector[mirl_global.Range] = collections_vector.init[mirl_global.Range](ctx.s.alloc);
    fin { collections_vector.dnit[mirl_global.Range](?ranges); }
    val res_secret: res[mirl_global.Secrecy, fail.Fail] = lower_context.global_secrecy(ctx, sem, gty, ?ranges);
    if (sel res_secret.err) { ret err[fail.Fail].err{res_secret.err}; }
    g.secret = res_secret.ok;

    val res_idx: res[u32, fail.Fail] = lower_context.define_global(ctx, g);
    if (sel res_idx.err) { ret err[fail.Fail].err{res_idx.err}; }
    if (ctx.debug) {
        val err_described: err[fail.Fail] = lower_context.describe_global(ctx, res_idx.ok, d.data.bind.name, sem);
        if (sel err_described.err) { ret err_described; }
    }
    ret lower_shader.global_attributes(ctx, d, res_idx.ok);
}

# a copy of the function `did` whose pointer parameters take the classes `sig` states,
# local to the module whose call asked for it
pub fun lower_class_copy(ctx: *lower_context.LowerContext, did: ast_id.DeclId, d: *ast_decl.Decl, name: intern.StrId, sig: Type) err[fail.Fail] {
    if (ast_id.stmt_is_nil(d.data.fun_.body)) { ret err[fail.Fail].ok{}; }
    val res_sig: res[lower_context.FnSig, fail.Fail] = lower_context.lower_fn_sig(ctx, did);
    if (sel res_sig.err) { ret err[fail.Fail].err{res_sig.err}; }
    var copied: lower_context.FnSig = res_sig.ok;
    copied.sig = sig;
    val res_idx: res[u32, fail.Fail] = define_function(ctx, name, copied, class_copy_linkage(), d);
    if (sel res_idx.err) { ret err[fail.Fail].err{res_idx.err}; }
    ret emit_function_body(ctx, did, d, res_idx.ok, copied, lower_context.decl_ret_sem(ctx, did), base_source.location(ctx.scope.a.file_id, d.data.fun_.name));
}

fun function_bare_name(ctx: *lower_context.LowerContext, d: *ast_decl.Decl) res[intern.StrId, fail.Fail] {
    val res_r_353: res[intern.StrId, A.Error] = intern.range_add(?ctx.s.interner, lower_context.module_source(ctx), d.data.fun_.name.offset, d.data.fun_.name.len);
    if (sel res_r_353.err) { ret res[intern.StrId, fail.Fail].err{fail.refused(res_r_353.err)}; }
    ret res[intern.StrId, fail.Fail].ok{res_r_353.ok};
}

# the module's definition of the function `name`, which a reference earlier in the module
# may have declared
fun define_function(ctx: *lower_context.LowerContext, name: intern.StrId, sig: lower_context.FnSig, linkage_of: Linkage, d: *ast_decl.Decl) res[u32, fail.Fail] {
    val res_aligned: res[u32, fail.Fail] = decl_align_of(ctx, d);
    if (sel res_aligned.err) { ret res[u32, fail.Fail].err{res_aligned.err}; }
    var opt_alignment: opt[u64] = opt[u64].none{};
    if (res_aligned.ok != 0) { opt_alignment = opt[u64].some{res_aligned.ok::u64}; }
    val res_named: res[Slice[View], fail.Fail] = extensions_of(ctx, d);
    if (sel res_named.err) { ret res[u32, fail.Fail].err{res_named.err}; }
    var secrets:  collections_vector.Vector[mirl_global.Secrecy] = collections_vector.init[mirl_global.Secrecy](ctx.s.alloc);
    var ranges:   collections_vector.Vector[mirl_global.Range]   = collections_vector.init[mirl_global.Range](ctx.s.alloc);
    var pointers: collections_vector.Vector[u32]                 = collections_vector.init[u32](ctx.s.alloc);
    fin {
        collections_vector.dnit[mirl_global.Secrecy](?secrets);
        collections_vector.dnit[mirl_global.Range](?ranges);
        collections_vector.dnit[u32](?pointers);
    }
    var result:     mirl_global.Secrecy = mirl_global.Secrecy.public{};
    val err_stated: err[fail.Fail]      = lower_context.declared_secrets(ctx, sig, ?secrets, ?result, ?ranges, ?pointers);
    if (sel err_stated.err) {
        if (res_named.ok.size != 0) { A.deallocate[View](ctx.s.alloc, res_named.ok.data, res_named.ok.size); }
        ret res[u32, fail.Fail].err{err_stated.err};
    }
    val res_defined: res[u32, fail.Fail] = lower_context.define_function(ctx, FunctionData{name: lower_context.symbol_name(ctx, name), signature: sig.sig, linkage: linkage_of, constant_time: constant_time(ctx, d), extensions: res_named.ok, alignment: opt_alignment, section: function_section(ctx, d), secrets: Slice[mirl_global.Secrecy]{data: secrets.data, size: secrets.len}, result: result, pointers: Slice[u32]{data: pointers.data, size: pointers.len}},
        lower_context.FnInfo{name: name, line: 0, test: false, noreturn: false, defined: true});
    if (res_named.ok.size != 0) { A.deallocate[View](ctx.s.alloc, res_named.ok.data, res_named.ok.size); }
    ret res_defined;
}

# the extensions a function's `#[extension]` names past the build's, as views of the
# session's interned strings
fun extensions_of(ctx: *lower_context.LowerContext, d: *ast_decl.Decl) res[Slice[View], fail.Fail] {
    val opt_found: opt[*ast_decl.Decorator] = decorator.get(ctx.scope.a, d, decorator.EXTENSION);
    if (!(sel opt_found.some)) { ret res[Slice[View], fail.Fail].ok{NO_EXTENSIONS}; }
    val dec: *ast_decl.Decorator = opt_found.some;
    if (dec.args_len == 0) { ret res[Slice[View], fail.Fail].ok{NO_EXTENSIONS}; }
    val count:    usize               = dec.args_len::usize;
    val res_made: res[*View, A.Error] = A.allocate[View](ctx.s.alloc, count);
    if (sel res_made.err) { ret res[Slice[View], fail.Fail].err{fail.refused(res_made.err)}; }
    var i: usize = 0;
    for (i < count) {
        val opt_named: opt[View] = extension_named(ctx, dec, i::u32);
        if (sel opt_named.none) {
            A.deallocate[View](ctx.s.alloc, res_made.ok, count);
            ret res[Slice[View], fail.Fail].err{fail.message("lower: an extension sema admitted names nothing")};
        }
        res_made.ok[i] = opt_named.some;
        i              = i + 1;
    }
    ret res[Slice[View], fail.Fail].ok{Slice[View]{data: res_made.ok, size: count}};
}

# the extension argument `ord` of `dec` names
fun extension_named(ctx: *lower_context.LowerContext, dec: *ast_decl.Decorator, ord: u32) opt[View] {
    val opt_name: opt[str] = decorator.string_of(?ctx.s.interner, ctx.scope.ctx, ctx.scope.a, dec, ord);
    if (sel opt_name.none) { ret opt[View].none{}; }
    ret opt[View].some{View{data: opt_name.some, len: str_len(opt_name.some)}};
}

# start building function `fn_index`: its entry takes its signature's parameters, each secret
# where its declaration states some of it secret
fun enter_function(ctx: *lower_context.LowerContext, fn_index: u32, sig: lower_context.FnSig, ret_sem: type_kind.TypeId, at: base_source.Location) err[fail.Fail] {
    val t:       *types.Table                    = ?ctx.m.types;
    val n:       u32                             = irt.param_count(t, sig.sig);
    var params:  collections_vector.Vector[Type] = collections_vector.init[Type](ctx.s.alloc);
    var secrets: collections_vector.Vector[bool] = collections_vector.init[bool](ctx.s.alloc);
    fin {
        collections_vector.dnit[Type](?params);
        collections_vector.dnit[bool](?secrets);
    }
    var i: u32 = 0;
    for (i < n) {
        val ity:               Type                = irt.param_of(t, sig.sig, i);
        val res_params_pushed: res[usize, A.Error] = collections_vector.push[Type](?params, ity);
        if (sel res_params_pushed.err) { ret err[fail.Fail].err{fail.refused(res_params_pushed.err)}; }
        val stated:             mirl_global.Secrecy = mirl_function.parameter_secrecy(?ctx.m.functions.data[fn_index].data, i::usize);
        val res_secrets_pushed: res[usize, A.Error] = collections_vector.push[bool](?secrets, !(sel stated.public));
        if (sel res_secrets_pushed.err) { ret err[fail.Fail].err{fail.refused(res_secrets_pushed.err)}; }
        i = i + 1;
    }
    lower_context.begin_function(ctx, fn_index, irt.result_of(t, sig.sig));
    ctx.fn_ret_sem = ret_sem;
    ctx.fn_sig     = sig.sig;
    builder.enter(?ctx.builder, fn_index, params.data, secrets.data, n);
    builder.set_loc(?ctx.builder, at);
    ret lower_context.builder_state(ctx);
}

# a `#[naked]` function's body is its asm alone: its parameters stay where the convention
# passes them, and control that falls off its end reaches the unreachable that closes it
fun emit_function_body(ctx: *lower_context.LowerContext, did: ast_id.DeclId, d: *ast_decl.Decl, fn_index: u32, sig: lower_context.FnSig, ret_sem: type_kind.TypeId, at: base_source.Location) err[fail.Fail] {
    val naked: bool = decorator.has(ctx.scope.a, d, decorator.NAKED);
    if (naked) {
        val err_made: err[mirl_module.Error] = mirl_module.attach(ctx.m, id.Symbol.function{fn_index}, Attribute{family: View{data: register_schema.FAMILY, len: str_len(register_schema.FAMILY)}, name: View{data: "naked", len: 5}, datum: Datum.integer{1}});
        if (sel err_made.err) { ret err[fail.Fail].err{fail.message("lower: mirl refused a naked function's attribute")}; }
    }
    val err_entered: err[fail.Fail] = enter_function(ctx, fn_index, sig, ret_sem, at);
    if (sel err_entered.err) { ret err_entered; }
    ctx.fn_naked = naked;

    if (!naked) {
        val err_params: err[fail.Fail] = lower_params(ctx, did, d);
        if (sel err_params.err) { ret err_params; }
    }

    if (!ast_id.stmt_is_nil(d.data.fun_.body)) {
        val err_body: err[fail.Fail] = lower_stmt.lower_stmt(ctx, d.data.fun_.body);
        if (sel err_body.err) { ret err_body; }
    }

    if (naked && !lower_context.block_terminated(ctx)) {
        val err_ended: err[fail.Fail] = builder.emit_unreachable(?ctx.builder);
        if (sel err_ended.err) { ret err_ended; }
    }
    ret function_end(ctx);
}

fun clear_pack_state(ctx: *lower_context.LowerContext) {
    if (ctx.pack_slots != nil && ctx.pack_len > 0) {
        A.deallocate[value.Value](ctx.s.alloc, ctx.pack_slots, ctx.pack_len::usize);
    }
    ctx.pack_slots    = nil;
    ctx.pack_types    = nil;
    ctx.pack_len      = 0;
    ctx.pack_ret_type = type_kind.TYPE_NIL;
}

fun lower_pack_params(ctx: *lower_context.LowerContext, did: ast_id.DeclId, d: *ast_decl.Decl,
    fixed_count: u32, types_of: *type_kind.TypeId, type_len: u32) err[fail.Fail] {
    val total:  u32          = fixed_count + type_len;
    var slots:  *value.Value = nil;
    var handed: bool         = false;
    fin {
        if (!handed && slots != nil) { A.deallocate[value.Value](ctx.s.alloc, slots, type_len::usize); }
    }
    if (type_len > 0) {
        val res_slots: res[*value.Value, A.Error] = A.allocate[value.Value](ctx.s.alloc, type_len::usize);
        if (sel res_slots.err) { ret err[fail.Fail].err{fail.refused(res_slots.err)}; }
        slots = res_slots.ok;
    }

    var i: u32 = 0;
    for (i < total) {
        var p_sem: type_kind.TypeId = type_kind.TYPE_NIL;
        if (i < fixed_count) {
            val pool_ix: u32 = d.data.fun_.params_start + i;
            if (pool_ix::usize < ctx.scope.a.typed_names.len) {
                p_sem = lower_context.type_resolved_of(ctx, ctx.scope.a.typed_names.data[pool_ix].ty);
            }
        }
        or { p_sem = types_of[i - fixed_count]; }

        var sid: resolve.SymbolId = resolve.SYMBOL_NIL;
        if (i < fixed_count) { sid = param_symbol(ctx, did, i); }
        val res_home: res[Home, fail.Fail] = param_home(ctx, i, p_sem, sid);
        if (sel res_home.err) { ret err[fail.Fail].err{res_home.err}; }

        if (i < fixed_count) {
            if (!resolve.symbol_is_nil(sid)) {
                val err_bind: err[fail.Fail] = param_bind(ctx, sid, res_home.ok);
                if (sel err_bind.err) { ret err_bind; }
            }
        }
        or { slots[i - fixed_count] = res_home.ok.slot; }
        i = i + 1;
    }

    ctx.pack_slots = slots;
    handed         = true;
    ret err[fail.Fail].ok{};
}

# where a parameter lives in the body: the slot its name binds to, an address, and the value
# it arrived as. a `direct` one's name binds to that value, and its slot, none unless the
# build describes variables, only shows a debugger the value
rec Home {
    slot:    value.Value;
    arrived: value.Value;
    direct:  bool;
}

# the home a parameter's name binds to. an aggregate arrives in a slot of its own unless it is
# held whole; a parameter in a register gets a slot and an entry store, unless `sid` is bound to
# its value
fun param_home(ctx: *lower_context.LowerContext, w: u32, p_sem: type_kind.TypeId, sid: resolve.SymbolId) res[Home, fail.Fail] {
    val res_p_ir: res[Type, fail.Fail] = lower_context.lower_type(ctx, p_sem);
    if (sel res_p_ir.err) { ret res[Home, fail.Fail].err{res_p_ir.err}; }
    var p_ir:     Type = res_p_ir.ok;
    val declared: Type = res_p_ir.ok;
    # a pointer parameter is of the class the signature states, which a copy's call sites chose
    if (irt.is_ptr(?ctx.m.types, p_ir)) { p_ir = irt.param_of(?ctx.m.types, ctx.fn_sig, w); }

    # a handle has no representation in memory, so it is never homed in a slot, and neither is a
    # pointer into a storage class, whose class alone differs from the declared type, unless the
    # body stores to it
    val held:      bool                        = irt.is_handle(?ctx.m.types, p_ir);
    val classed:   bool                        = builder.classes(?ctx.builder) && irt.is_ptr(?ctx.m.types, p_ir);
    val direct:    bool                        = held || ((irt.same(p_ir, declared) || classed) && lower_context.binds_direct(ctx, sid, p_sem, p_ir));
    val res_param: res[value.Value, fail.Fail] = builder.param(?ctx.builder, w, p_ir, direct);
    if (sel res_param.err) { ret res[Home, fail.Fail].err{res_param.err}; }
    var pval: value.Value = res_param.ok;
    if (lower_context.type_contains_secret(ctx, p_sem)) { pval.secret = true; }

    if (irt.is_aggregate(?ctx.m.types, p_ir) && !direct) {
        val err_stated: err[fail.Fail] = lower_context.state_slot(ctx, pval, p_sem, p_ir);
        if (sel err_stated.err) { ret res[Home, fail.Fail].err{err_stated.err}; }
        ret res[Home, fail.Fail].ok{Home{slot: value.retype(pval, lower_context.ptr_or_none(ctx)), arrived: pval, direct: false}};
    }
    if (direct) {
        if (!ctx.debug || held || classed) { ret res[Home, fail.Fail].ok{Home{slot: value.none(), arrived: pval, direct: true}}; }
        val res_seen: res[value.Value, fail.Fail] = lower_context.slot_for(ctx, p_sem, p_ir);
        if (sel res_seen.err) { ret res[Home, fail.Fail].err{res_seen.err}; }
        val err_kept: err[fail.Fail] = builder.emit_store(?ctx.builder, pval, res_seen.ok);
        if (sel err_kept.err) { ret res[Home, fail.Fail].err{err_kept.err}; }
        ret res[Home, fail.Fail].ok{Home{slot: res_seen.ok, arrived: pval, direct: true}};
    }
    val res_slot: res[value.Value, fail.Fail] = lower_context.slot_for(ctx, p_sem, p_ir);
    if (sel res_slot.err) { ret res[Home, fail.Fail].err{res_slot.err}; }
    val err_store: err[fail.Fail] = lower_expr.store_stated(ctx, pval, res_slot.ok, p_sem, lower_expr.type_is_volatile_record(ctx, p_sem));
    if (sel err_store.err) { ret res[Home, fail.Fail].err{err_store.err}; }
    ret res[Home, fail.Fail].ok{Home{slot: res_slot.ok, arrived: pval, direct: false}};
}

fun lower_test(ctx: *lower_context.LowerContext, did: ast_id.DeclId, d: *ast_decl.Decl) err[fail.Fail] {
    val res_i32: res[Type, fail.Fail] = irt.int(?ctx.m.types, 32);
    if (sel res_i32.err) { ret err[fail.Fail].err{res_i32.err}; }
    var result:     Type                 = res_i32.ok;
    var result_ext: types.Extension      = types.Extension.sext{};
    val res_sig:    res[Type, fail.Fail] = irt.signature(?ctx.m.types, nil, nil, 0, ?result, ?result_ext, 1);
    if (sel res_sig.err) { ret err[fail.Fail].err{res_sig.err}; }
    val sig: lower_context.FnSig = lower_context.bare_sig(res_sig.ok);

    val res_ident: res[intern.StrId, A.Error] = intern.range_add(?ctx.s.interner, lower_context.module_source(ctx), d.data.test_.name.offset, d.data.test_.name.len);
    if (sel res_ident.err) { ret err[fail.Fail].err{fail.refused(res_ident.err)}; }
    val ident: intern.StrId = res_ident.ok;

    val res_name: res[intern.StrId, fail.Fail] = mangle.test_name(ctx.s, ctx.scope.fqn, ident);
    if (sel res_name.err) { ret err[fail.Fail].err{res_name.err}; }
    val name: intern.StrId = res_name.ok;

    val opt_twice: opt[u32] = lower_context.function_named(ctx, name);
    if (sel opt_twice.some) { ret err[fail.Fail].err{fail.message("lower: a test name sema accepted is emitted twice")}; }

    var line:   u32                          = 0;
    val opt_sf: opt[*base_source.SourceFile] = base_source.get(ctx.s.sources, ctx.scope.a.file_id);
    if (sel opt_sf.some) { line = base_source.position(opt_sf.some, d.data.test_.name.offset).line::u32; }

    val res_idx: res[u32, fail.Fail] = lower_context.define_function(ctx,
        FunctionData{name: lower_context.symbol_name(ctx, name), signature: sig.sig, linkage: Linkage{binding: ?symbol.GLOBAL, visibility: lower_context.internal_visibility(ctx)}, constant_time: ConstantTime.none{}, extensions: NO_EXTENSIONS, alignment: opt[u64].none{}, section: opt[Section].none{}},
        lower_context.FnInfo{name: name, line: line, test: true, noreturn: false, defined: true});
    if (sel res_idx.err) { ret err[fail.Fail].err{res_idx.err}; }

    val err_entered: err[fail.Fail] = enter_function(ctx, res_idx.ok, sig, type_kind.TYPE_NIL, base_source.location(ctx.scope.a.file_id, d.data.test_.name));
    if (sel err_entered.err) { ret err_entered; }
    if (!ast_id.stmt_is_nil(d.data.test_.body)) {
        val err_body: err[fail.Fail] = lower_stmt.lower_stmt(ctx, d.data.test_.body);
        if (sel err_body.err) { ret err_body; }
    }
    ret function_end(ctx);
}

# bind a parameter's name to its home
fun param_bind(ctx: *lower_context.LowerContext, sid: resolve.SymbolId, home: Home) err[fail.Fail] {
    if (home.direct) { ret lower_context.bind_direct(ctx, sid, home.arrived); }
    ret lower_context.bind_local(ctx, sid, home.slot);
}

fun lower_params(ctx: *lower_context.LowerContext, did: ast_id.DeclId, d: *ast_decl.Decl) err[fail.Fail] {
    val count: u32 = d.data.fun_.params_len;
    var w:     u32 = 0;
    var i:     u32 = 0;
    for (i < count) {
        val pool_ix: u32 = d.data.fun_.params_start + i;
        if (pool_ix::usize < ctx.scope.a.typed_names.len && ctx.scope.a.typed_names.data[pool_ix].comptime) {
            i = i + 1;
            cnt;
        }
        var p_sem: type_kind.TypeId = type_kind.TYPE_NIL;
        if (pool_ix::usize < ctx.scope.a.typed_names.len) { p_sem = lower_context.type_resolved_of(ctx, ctx.scope.a.typed_names.data[pool_ix].ty); }

        val sid:      resolve.SymbolId     = param_symbol(ctx, did, i);
        val res_home: res[Home, fail.Fail] = param_home(ctx, w, p_sem, sid);
        if (sel res_home.err) {
            # a refusal of the parameter's type points at the parameter
            if (pool_ix::usize < ctx.scope.a.typed_names.len) { ret err[fail.Fail].err{fail.at(res_home.err, base_source.location(ctx.scope.a.file_id, ctx.scope.a.typed_names.data[pool_ix].name))}; }
            ret err[fail.Fail].err{res_home.err};
        }

        if (!resolve.symbol_is_nil(sid)) {
            val err_bind: err[fail.Fail] = param_bind(ctx, sid, res_home.ok);
            if (sel err_bind.err) { ret err_bind; }
        }

        if (ctx.debug && pool_ix::usize < ctx.scope.a.typed_names.len) {
            var opt_held: opt[value.Value] = opt[value.Value].some{res_home.ok.slot};
            if (value.is_none(res_home.ok.slot)) { opt_held = opt[value.Value].none{}; }
            val err_dbg: err[fail.Fail] = lower_context.emit_dbg_birth(ctx, ctx.scope.a.typed_names.data[pool_ix].name, p_sem,
                opt[u32].some{w}, res_home.ok.arrived, opt_held);
            if (sel err_dbg.err) { ret err_dbg; }
        }

        w = w + 1;
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# end the function: the block it falls off the end of returns zero, every other block left
# open is unreachable, and the builder's first refusal is the function's
fun function_end(ctx: *lower_context.LowerContext) err[fail.Fail] {
    if (!lower_context.block_terminated(ctx)) {
        val err_term: err[fail.Fail] = emit_default_terminator(ctx);
        if (sel err_term.err) { ret err_term; }
    }
    val err_exit: err[fail.Fail] = lower_context.emit_exit(ctx);
    if (sel err_exit.err) { ret err_exit; }
    val err_sealed: err[fail.Fail] = builder.seal(?ctx.builder);
    var err_state:  err[fail.Fail] = lower_context.builder_state(ctx);
    if (sel err_sealed.err && !sel err_state.err) { err_state = err_sealed; }
    builder.leave(?ctx.builder);
    ret err_state;
}

fun emit_default_terminator(ctx: *lower_context.LowerContext) err[fail.Fail] {
    val opt_info: opt[*lower_context.FnInfo] = lower_context.fn_info(ctx.unit, ctx.fn_index);
    if (sel opt_info.some && opt_info.some.noreturn) { ret builder.emit_unreachable(?ctx.builder); }
    if (irt.is_none(ctx.ret_type))                   { ret lower_context.leave(ctx, value.none()); }

    val res_zero: res[value.Value, fail.Fail] = default_return_value(ctx, ctx.ret_type);
    if (sel res_zero.err) { ret err[fail.Fail].err{res_zero.err}; }
    ret lower_context.leave(ctx, res_zero.ok);
}

fun default_return_value(ctx: *lower_context.LowerContext, ret_ir: Type) res[value.Value, fail.Fail] {
    if (!irt.is_aggregate(?ctx.m.types, ret_ir)) { ret res[value.Value, fail.Fail].ok{value.const_null(ret_ir)}; }
    if (lower_context.returns_whole(ctx))        { ret res[value.Value, fail.Fail].ok{value.zero_whole(ret_ir)}; }
    # the slot every return hands back, so the function's results are all built in one place
    val res_slot: res[value.Value, fail.Fail] = lower_context.result_slot(ctx);
    if (sel res_slot.err) { ret res_slot; }
    val err_emit_memzero: err[fail.Fail] = builder.emit_memzero(?ctx.builder, res_slot.ok, ret_ir, lower_context.type_contains_secret(ctx, ctx.fn_ret_sem));
    if (sel err_emit_memzero.err) { ret res[value.Value, fail.Fail].err{err_emit_memzero.err}; }
    ret res[value.Value, fail.Fail].ok{value.retype(res_slot.ok, ret_ir)};
}

# the constant a global's initialiser binds, folded exactly as its lowering folds it; `did` is the
# declaration whose published value lays it out, DECL_NIL for a decorator argument, which has none
fun fold_global_init(ctx: *lower_context.LowerContext, did: ast_id.DeclId, eid: ast_id.ExprId, gty: Type, name: intern.StrId) res[value.Value, fail.Fail] {
    val res_folded: res[value.Value, fail.Fail] = fold_global_value(ctx, did, eid, gty, name);
    if (sel ctx.status.kind.internal) { ret res[value.Value, fail.Fail].err{report_phase.phase_failure(ctx.status)}; }
    if (sel res_folded.err) {
        val failure: fail.Fail = res_folded.err;
        if (sel failure.reported) {
            if (sel ctx.status.kind.accepted) { report_phase.reject(?ctx.status); }
        }
        or { lower_context.internal(ctx, failure); }
    }
    ret res_folded;
}

fun fold_global_value(ctx: *lower_context.LowerContext, did: ast_id.DeclId, eid: ast_id.ExprId, gty: Type, name: intern.StrId) res[value.Value, fail.Fail] {
    if (is_null_init(ctx, eid)) { ret res[value.Value, fail.Fail].ok{value.const_null(gty)}; }

    val res_laid: res[opt[value.Value], fail.Fail] = published_layout(ctx, did, gty);
    if (sel res_laid.err)     { ret res[value.Value, fail.Fail].err{res_laid.err}; }
    if (sel res_laid.ok.some) { ret res[value.Value, fail.Fail].ok{res_laid.ok.some}; }

    val opt_scalar: opt[comptime_value.CTValue] = published_scalar(ctx, did);
    if (sel opt_scalar.some) { ret lower_expr.const_value_of_init(ctx, eid, opt_scalar.some); }

    val res_evaluated: res[comptime_value.CTValue, comptime_failure.EvalFail] = try_comptime(ctx, eid);
    if (sel res_evaluated.ok) {
        ret lower_expr.const_value_of_init(ctx, eid, res_evaluated.ok);
    }

    val eval_failure: comptime_failure.EvalFail = res_evaluated.err;
    if (eval_failure.kind == comptime_failure.EVAL_FAIL_INTERNAL) {
        ret res[value.Value, fail.Fail].err{fail.message(eval_failure.message)};
    }

    val res_init: res[ast_expr.Expr, fail.Fail] = lower_context.expression(ctx, eid);
    if (sel res_init.err) { ret res[value.Value, fail.Fail].err{res_init.err}; }
    var ie_value: ast_expr.Expr  = res_init.ok;
    val ie:       *ast_expr.Expr = ?ie_value;

    if (ie.kind == ast_expr.EXPR_KIND_CALL) {
        val opt_intr: opt[res[value.Value, fail.Fail]] = lower_expr.try_lower_comptime_intrinsic(ctx, eid, ie);
        if (sel opt_intr.some) { ret opt_intr.some; }
    }

    if (eval_failure.kind == comptime_failure.EVAL_FAIL_REJECTED) {
        report_phase.reject(?ctx.status);
        val err_reported: err[fail.Fail] = diagnostic.report(ctx.diags, eval_failure.diag, ctx.scope.a.file_id, ie.span, eval_failure.message);
        if (sel err_reported.err) { ret res[value.Value, fail.Fail].err{err_reported.err}; }
    }
    or (comptime_failure.not_constant(eval_failure.kind)) {
        report_phase.reject(?ctx.status);
        val err_reported: err[fail.Fail] = comptime_failure.init_not_constant_report(ctx.s.alloc, ctx.diags, ctx.scope.a.file_id, ie.span, intern.get(?ctx.s.interner, name));
        if (sel err_reported.err) { ret res[value.Value, fail.Fail].err{err_reported.err}; }
    }
    or { ret res[value.Value, fail.Fail].err{fail.message("lower: invalid comptime evaluation failure kind")}; }
    ret res[value.Value, fail.Fail].err{fail.reported()};
}

# the scalar value the module's interface publishes for the global `did`, none for a global it
# publishes no scalar for
fun published_scalar(ctx: *lower_context.LowerContext, did: ast_id.DeclId) opt[comptime_value.CTValue] {
    val opt_found: opt[*sema_interface.Declaration] = sema_interface.declaration_at(ctx.scope.iface, did);
    if (sel opt_found.none)                          { ret opt[comptime_value.CTValue].none{}; }
    if (comptime_deep.is_none(opt_found.some.value)) { ret opt[comptime_value.CTValue].none{}; }
    val n: *comptime_deep.Shape = comptime_deep.shape_at(?ctx.scope.iface.values, opt_found.some.value);
    if (n.kind != comptime_deep.NODE_SCALAR || n.value.kind == comptime_value.CT_KIND_STR) { ret opt[comptime_value.CTValue].none{}; }
    ret opt[comptime_value.CTValue].some{comptime_deep.scalar(?ctx.scope.iface.values, opt_found.some.value)};
}

# the bytes of a global whose published value is an aggregate or an address, laid out from that
# value; none for a scalar, which folds as its published value, and for no declaration
fun published_layout(ctx: *lower_context.LowerContext, did: ast_id.DeclId, gty: Type) res[opt[value.Value], fail.Fail] {
    val res_none:  res[opt[value.Value], fail.Fail] = res[opt[value.Value], fail.Fail].ok{opt[value.Value].none{}};
    val opt_found: opt[*sema_interface.Declaration] = sema_interface.declaration_at(ctx.scope.iface, did);
    if (sel opt_found.none)                          { ret res_none; }
    if (comptime_deep.is_none(opt_found.some.value)) { ret res_none; }
    val store: *comptime_deep.Store = ?ctx.scope.iface.values;
    val node:  comptime_deep.Node   = opt_found.some.value;
    val n:     *comptime_deep.Shape = comptime_deep.shape_at(store, node);
    var laid:  bool                 = n.kind == comptime_deep.NODE_LITERAL || n.kind == comptime_deep.NODE_ARRAY || n.kind == comptime_deep.NODE_ADDRESS;
    if (n.kind == comptime_deep.NODE_SCALAR && n.value.kind == comptime_value.CT_KIND_STR)                              { laid = true; }
    if (n.kind == comptime_deep.NODE_REFUSED && (irt.is_aggregate(?ctx.m.types, gty) || irt.is_ptr(?ctx.m.types, gty))) { laid = true; }
    if (!laid)                                                                                                          { ret res_none; }
    val opt_refused: opt[comptime_deep.Node] = comptime_deep.refused_within(store, node);
    if (sel opt_refused.some) {
        val r: comptime_deep.Refusal = comptime_deep.shape_at(store, opt_refused.some).refusal;
        report_phase.reject(?ctx.status);
        val err_reported: err[fail.Fail] = diagnostic.report(ctx.diags, r.diag, r.at.file, r.at.span, intern.text(?ctx.s.interner, r.message));
        if (sel err_reported.err) { ret res[opt[value.Value], fail.Fail].err{err_reported.err}; }
        ret res[opt[value.Value], fail.Fail].err{fail.reported()};
    }
    val res_agg: res[value.Value, fail.Fail] = constnode.aggregate(ctx, store, node, gty);
    if (sel res_agg.err) { ret res[opt[value.Value], fail.Fail].err{res_agg.err}; }
    ret res[opt[value.Value], fail.Fail].ok{opt[value.Value].some{res_agg.ok}};
}

fun is_null_init(ctx: *lower_context.LowerContext, eid: ast_id.ExprId) bool {
    var cur: ast_id.ExprId = eid;
    for (true) {
        val res_expr: res[ast_expr.Expr, fail.Fail] = lower_context.expression(ctx, cur);
        if (sel res_expr.err) { ret false; }
        var e_value: ast_expr.Expr  = res_expr.ok;
        val e:       *ast_expr.Expr = ?e_value;
        if (e.kind == ast_expr.EXPR_KIND_LIT_NIL) { ret true; }
        if (e.kind != ast_expr.EXPR_KIND_CAST)    { ret false; }
        cur = e.data.cast.value;
    }
    ret false;
}

fun lower_comptime_if(ctx: *lower_context.LowerContext, d: *ast_decl.Decl) err[fail.Fail] {
    var i: u32 = 0;
    for (i < d.data.comptime_if.branches_len) {
        val branch_ix: u32 = d.data.comptime_if.branches_start + i;
        if (branch_ix::usize >= ctx.scope.a.comptime_branches.len) {
            ret err[fail.Fail].err{fail.message("lower: comptime branch index out of range")};
        }
        val branch: *ast_decl.ComptimeBranch = ?ctx.scope.a.comptime_branches.data[branch_ix];

        var active: bool = false;
        if (ast_id.expr_is_nil(branch.cond)) {
            active = true;
        }
        or {
            # a gate that declares is decided with the module, one over code alone as sema types it
            val state: comptime_scope.GateState = comptime_scope.gate_state(ctx.scope.ctx, branch.cond);
            if (state == comptime_scope.GATE_STATE_TRUE || state == comptime_scope.GATE_STATE_FALSE) { active = state == comptime_scope.GATE_STATE_TRUE; }
            or {
                val opt_verdict: opt[bool] = lower_context.gate_of(ctx, branch.cond);
                if (sel opt_verdict.none) { ret err[fail.Fail].err{fail.message("lower: a module-level gate reached lowering undecided")}; }
                active = opt_verdict.some;
            }
        }

        if (active) {
            var ii: u32 = 0;
            for (ii < branch.body_len) {
                val pool_ix: u32 = branch.body_start + ii;
                if (pool_ix::usize >= ctx.scope.a.decl_ids.len) {
                    ret err[fail.Fail].err{fail.message("lower: comptime decl body index out of range")};
                }
                val err_decl: err[fail.Fail] = lower_decl(ctx, ctx.scope.a.decl_ids.data[pool_ix]);
                if (sel err_decl.err) { ret err_decl; }
                ii = ii + 1;
            }
            ret err[fail.Fail].ok{};
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun decl_section_of(ctx: *lower_context.LowerContext, d: *ast_decl.Decl) intern.StrId {
    val opt_dec: opt[*ast_decl.Decorator] = decorator.get(ctx.scope.a, d, decorator.SECTION);
    if (sel opt_dec.none) { ret intern.STR_NIL; }
    ret decorator.string_id(ctx.scope.ctx, ctx.scope.a, opt_dec.some, 0);
}

fun embed_file_of(ctx: *lower_context.LowerContext, d: *ast_decl.Decl) res[*session_embed.EmbedFile, fail.Fail] {
    val opt_dec: opt[*ast_decl.Decorator] = decorator.get(ctx.scope.a, d, decorator.EMBED);
    if (sel opt_dec.none) {
        ret res[*session_embed.EmbedFile, fail.Fail].err{fail.message("embed declaration lost its decorator before lowering")};
    }

    if (opt_dec.some.args_len == 0) {
        ret res[*session_embed.EmbedFile, fail.Fail].err{fail.message("embed declaration has a malformed path after sema")};
    }
    val file: intern.StrId = comptime_scope.decorator_embed_file(ctx.scope.ctx, ctx.scope.a.expr_ids.data[opt_dec.some.args_start]);
    if (intern.str_is_nil(file)) {
        ret res[*session_embed.EmbedFile, fail.Fail].err{fail.message("embed path became invalid after successful sema")};
    }

    val opt_e: opt[*session_embed.EmbedFile] = session_embed.get(?ctx.s.embeds, file);
    if (sel opt_e.none) {
        ret res[*session_embed.EmbedFile, fail.Fail].err{fail.message("embed cache entry is unavailable during lowering")};
    }
    val e: *session_embed.EmbedFile = opt_e.some;
    if (e.status != session_embed.EMBED_OK) {
        ret res[*session_embed.EmbedFile, fail.Fail].err{fail.message("embed cache entry changed after successful sema")};
    }
    ret res[*session_embed.EmbedFile, fail.Fail].ok{e};
}

fun decorator_arg_eid(ctx: *lower_context.LowerContext, d: *ast_decl.Decl, id: decorator.Id, ord: u32) opt[ast_id.ExprId] {
    val opt_dec: opt[*ast_decl.Decorator] = decorator.get(ctx.scope.a, d, id);
    if (sel opt_dec.none) { ret opt[ast_id.ExprId].none{}; }
    val found: *ast_decl.Decorator = opt_dec.some;
    if (ord >= found.args_len) { ret opt[ast_id.ExprId].none{}; }
    ret opt[ast_id.ExprId].some{ctx.scope.a.expr_ids.data[found.args_start + ord]};
}

# the value of a declaration's `#[align]`, 0 without one
fun decl_align_of(ctx: *lower_context.LowerContext, d: *ast_decl.Decl) res[u32, fail.Fail] {
    val opt_arg: opt[ast_id.ExprId] = decorator_arg_eid(ctx, d, decorator.ALIGN, 0);
    if (sel opt_arg.none) { ret res[u32, fail.Fail].ok{0}; }
    val arg: ast_id.ExprId = opt_arg.some;

    val res_u64: res[Type, fail.Fail] = irt.int(?ctx.m.types, 64);
    if (sel res_u64.err) { ret res[u32, fail.Fail].err{res_u64.err}; }
    val u64t: Type = res_u64.ok;

    val res_fold: res[value.Value, fail.Fail] = fold_global_init(ctx, ast_id.DECL_NIL, arg, u64t, intern.STR_NIL);
    if (sel res_fold.err) { ret res[u32, fail.Fail].err{res_fold.err}; }
    val v: value.Value = res_fold.ok;
    # sema decided the value is a power of two that fits
    if (v.kind != value.VAL_INT) { ret res[u32, fail.Fail].err{fail.message("lower: an `align` sema accepted did not fold to an integer")}; }
    val n: u64 = value.int_lit(v);
    if (n == 0 || (n & (n - 1)) != 0 || n > 0xFFFFFFFF) { ret res[u32, fail.Fail].err{fail.message("lower: an `align` sema accepted is not a power of two that fits")}; }
    ret res[u32, fail.Fail].ok{n::u32};
}

fun param_symbol(ctx: *lower_context.LowerContext, fun_did: ast_id.DeclId, index: u32) resolve.SymbolId {
    ret resolve.param_symbol(ctx.scope.rr, fun_did, index);
}

fun try_comptime(ctx: *lower_context.LowerContext, eid: ast_id.ExprId) res[comptime_value.CTValue, comptime_failure.EvalFail] {
    val res_r_1162: res[comptime_value.CTValue, comptime_failure.EvalFail] = comptime.evaluate_at_float_width[lower_context.LowerContext](ctx.scope.ctx, ctx, ctx.caps, ctx.scope.a,
        lower_context.module_source(ctx), eid, ?ctx.s.interner, lower_context.expr_float_width(ctx, eid));
    if (sel res_r_1162.err) { ret res[comptime_value.CTValue, comptime_failure.EvalFail].err{res_r_1162.err}; }
    ret res[comptime_value.CTValue, comptime_failure.EvalFail].ok{res_r_1162.ok};
}
