# a shader declaration's decorators as the attributes of the target family that reads them
#
# a stage, its entry name and its workgroup size attach to the function, and an interface
# variable's storage class, descriptor set and binding, input attachment index, location,
# built-in and memory qualifiers to the global, each the number spir-v gives it, read from
# masc's grammar by its spir-v name. only a target whose family's schema is spir-v's takes
# them, so a machine target compiles a staged function as any other

use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.view.View;

use A: std.allocator;
use std.collections.map;
use std.collections.slice.Slice;

use mach.base.diagnostic;
use diagnostic_kind: mach.base.diagnostic.kind;
use mach.base.fail;
use mach.base.intern;
use base_source: mach.base.source;
use mach.front.ast;
use ast_decl: mach.front.ast.decl;
use ast_id:   mach.front.ast.id;
use mach.front.comptime;
use comptime_deep: mach.front.comptime.deep;
use mach.front.decorator;
use mach.front.resolve;
use mach.lower.builder;
use lower_context: mach.lower.context;
use mach.lower.value;
use mach.session.module;

use comptime_failure: mach.front.comptime.failure;
use comptime_value:   mach.front.comptime.value;
use sema_builtin:     mach.front.sema.builtin;
use sema_interface:   mach.front.sema.interface;
use report_phase:     mach.report.phase;
use mirl.ir.attribute.Attribute;
use mirl.ir.attribute.Datum;
use mirl.ir.id;
use mirl_module: mirl.ir.module;
use mirl_types:  mirl.ir.type.table;
use mirl.ir.type.table.Type;
use mirl_capability: mirl.target.capability;
use mirl.target.capability.Attributes;
use mirl.target.capability.Schema;
use spirv_schema: mirl.target.spirv.schema;

# the schema the target's family reads shader attributes by, none for a target that takes
# none of them
fun schema_of(lc: *lower_context.LowerContext) opt[*Schema] {
    val at: Attributes = lc.builder.target.caps.attributes;
    if (sel at.schema) {
        if (str_equals(at.schema.family, spirv_schema.FAMILY)) { ret opt[*Schema].some{at.schema}; }
    }
    ret opt[*Schema].none{};
}

# whether the target reads shader attributes
pub fun attaching(lc: *lower_context.LowerContext) bool {
    val opt_schema: opt[*Schema] = schema_of(lc);
    ret sel opt_schema.some;
}

# the value of the storage class the spir-v grammar names `name`
pub fun storage_class(name: str) opt[u64] {
    ret spirv_schema.spelled(spirv_schema.Enumeration.storage{}, name);
}

fun view_of(s: str) View {
    ret View{data: s, len: str_len(s)};
}

fun attach(lc: *lower_context.LowerContext, s: id.Symbol, family: str, name: str, datum: Datum) err[fail.Fail] {
    val err_made: err[mirl_module.Error] = mirl_module.attach(lc.m, s, Attribute{family: view_of(family), name: view_of(name), datum: datum});
    if (sel err_made.err) { ret err[fail.Fail].err{fail.message("lower: mirl refused a shader attribute")}; }
    ret err[fail.Fail].ok{};
}

fun attach_integer(lc: *lower_context.LowerContext, s: id.Symbol, family: str, name: str, n: u64) err[fail.Fail] {
    ret attach(lc, s, family, name, Datum.integer{n});
}

# a refusal of the source where `span` is written in the module being lowered
fun refused(lc: *lower_context.LowerContext, span: base_source.Span, k: diagnostic_kind.Kind, message: str) err[fail.Fail] {
    report_phase.reject(?lc.status);
    val loc: base_source.Location = base_source.location(lc.scope.a.file_id, span);
    ret err[fail.Fail].err{diagnostic.reject(lc.diags, k, loc, message)};
}

# argument `ord` of a decorator, nil past its arguments
fun argument(lc: *lower_context.LowerContext, dec: *ast_decl.Decorator, ord: u32) ast_id.ExprId {
    if (ord >= dec.args_len) { ret ast_id.EXPR_NIL; }
    ret lc.scope.a.expr_ids.data[dec.args_start + ord];
}

# the integer a decorator argument folds to, which sema admitted as one
fun integer_of(lc: *lower_context.LowerContext, eid: ast_id.ExprId) res[u64, fail.Fail] {
    val res_folded: res[comptime_value.CTValue, comptime_failure.EvalFail] = comptime.evaluate_at_float_width[lower_context.LowerContext](lc.scope.ctx, lc, lc.caps, lc.scope.a,
        lower_context.module_source(lc), eid, ?lc.s.interner, lower_context.expr_float_width(lc, eid));
    if (!sel res_folded.ok) { ret res[u64, fail.Fail].err{fail.message("lower: a shader decorator argument sema admitted did not fold")}; }
    val opt_ct_int_u64: opt[u64] = comptime_value.ct_int_u64(res_folded.ok);
    if (sel opt_ct_int_u64.none) { ret res[u64, fail.Fail].err{fail.message("lower: a shader decorator argument sema admitted as an integer is not one")}; }
    ret res[u64, fail.Fail].ok{opt_ct_int_u64.some};
}

fun string_of(lc: *lower_context.LowerContext, dec: *ast_decl.Decorator, ord: u32) opt[str] {
    ret decorator.string_of(?lc.s.interner, lc.scope.ctx, lc.scope.a, dec, ord);
}

# the spir-v storage class a decorated global lives in, none for one with no shader role. a
# binding's class is decided by its role and the type it holds, `held` where it is known: a
# `gpu.storage` or `gpu.sampler` binding that holds an opaque handle, a storage image, a sampler
# or a sampled image, lives in UniformConstant, where vulkan binds every handle. otherwise a
# uniform binding holds a block in Uniform and a storage binding one in StorageBuffer
fun class_name(lc: *lower_context.LowerContext, d: *ast_decl.Decl, held: opt[Type]) opt[str] {
    val a: *ast.Ast = lc.scope.a;
    if (decorator.has(a, d, decorator.GPU_INPUT))  { ret opt[str].some{"Input"}; }
    if (decorator.has(a, d, decorator.GPU_OUTPUT)) { ret opt[str].some{"Output"}; }
    val bound: bool = decorator.has(a, d, decorator.GPU_STORAGE) || decorator.has(a, d, decorator.GPU_SAMPLER);
    if (bound && opaque(lc, held))                  { ret opt[str].some{"UniformConstant"}; }
    if (decorator.has(a, d, decorator.GPU_UNIFORM)) { ret opt[str].some{"Uniform"}; }
    if (decorator.has(a, d, decorator.GPU_STORAGE)) { ret opt[str].some{"StorageBuffer"}; }
    if (decorator.has(a, d, decorator.GPU_SAMPLER)) { ret opt[str].some{"UniformConstant"}; }
    if (decorator.has(a, d, decorator.GPU_PUSH))    { ret opt[str].some{"PushConstant"}; }
    if (decorator.has(a, d, decorator.GPU_SHARED))  { ret opt[str].some{"Workgroup"}; }
    val opt_gpu_builtin_entry: opt[*ast_decl.Decorator] = decorator.get(a, d, decorator.GPU_BUILTIN);
    if (sel opt_gpu_builtin_entry.some) {
        val opt_named: opt[str] = string_of(lc, opt_gpu_builtin_entry.some, 0);
        if (sel opt_named.some) {
            val opt_row: opt[*sema_builtin.Builtin] = sema_builtin.of(opt_named.some);
            if (sel opt_row.some) {
                if (opt_row.some.output) { ret opt[str].some{"Output"}; }
                ret opt[str].some{"Input"};
            }
        }
    }
    ret opt[str].none{};
}

# a handle binding held to the binding the target's catalog states for its kind: a storage resource
# the shader reads and writes directly binds through `gpu.storage`, and any other handle through
# `gpu.sampler`. a handle that reads an attachment states its index by `gpu.attachment`, which
# no other handle takes
fun handle_binding(lc: *lower_context.LowerContext, d: *ast_decl.Decl, held: Type) err[fail.Fail] {
    val res_handle: res[mirl_types.Handle, mirl_types.Error] = mirl_types.handle(?lc.m.types, held);
    if (sel res_handle.err) { ret err[fail.Fail].ok{}; }
    val opt_minted: opt[*mirl_capability.Minted] = mirl_capability.minted(lc.machine.target.caps.handles, res_handle.ok.kind);
    if (sel opt_minted.none) { ret err[fail.Fail].ok{}; }
    var words:          mirl_capability.Words    = mirl_capability.words_of(res_handle.ok);
    val reads:          bool                     = mirl_capability.attachment(opt_minted.some, ?words.at[0], words.count);
    val opt_attachment: opt[*ast_decl.Decorator] = decorator.get(lc.scope.a, d, decorator.GPU_ATTACHMENT);
    if (reads && sel opt_attachment.none) {
        ret refused(lc, d.span, diagnostic_kind.HANDLE_UNBOUND,
            "this handle is a subpass input and needs `#[gpu.attachment(index)]` beside its `#[gpu.storage(set, binding)]` (VUID-RuntimeSpirv-None-09558)");
    }
    if (sel opt_attachment.some) {
        if (!reads) {
            ret refused(lc, opt_attachment.some.name, diagnostic_kind.DECORATOR_MISPLACED,
                "`gpu.attachment` applies only to a subpass input, an `image` of `Dim` \"SubpassData\", and this handle reads no input attachment");
        }
    }
    val storage: bool = mirl_capability.storage(opt_minted.some, ?words.at[0], words.count);
    if (storage && !decorator.has(lc.scope.a, d, decorator.GPU_STORAGE)) {
        ret refused(lc, d.span, diagnostic_kind.HANDLE_ROLE,
            "this handle is a storage resource, so it binds through `#[gpu.storage(set, binding)]`. `gpu.sampler` binds a handle the shader samples or fetches through its descriptor");
    }
    if (!storage && decorator.has(lc.scope.a, d, decorator.GPU_STORAGE)) {
        ret refused(lc, d.span, diagnostic_kind.HANDLE_ROLE,
            "this handle is sampled or fetched through its descriptor, so it binds through `#[gpu.sampler(set, binding)]`. `gpu.storage` binds a buffer or storage resource the shader reads and writes directly");
    }
    ret err[fail.Fail].ok{};
}

# whether a type is an opaque handle. sema refuses one inside an array or behind a pointer
fun opaque(lc: *lower_context.LowerContext, held: opt[Type]) bool {
    if (sel held.none) { ret false; }
    val res_shape: res[mirl_types.Shape, mirl_types.Error] = mirl_types.shape(?lc.m.types, held.some);
    if (sel res_shape.err) { ret false; }
    val k: mirl_types.Shape = res_shape.ok;
    ret sel k.handle;
}

# whether a global of the declaration `d` holds the initial value it is written with: the
# host, the pipeline or the previous stage supplies an interface variable's
pub fun initialized(lc: *lower_context.LowerContext, d: *ast_decl.Decl) bool {
    if (!attaching(lc)) { ret true; }
    val opt_class: opt[str] = class_name(lc, d, opt[Type].none{});
    if (sel opt_class.none) { ret true; }
    ret str_equals(opt_class.some, "Output") || str_equals(opt_class.some, "Workgroup");
}

# whether the declaration `d` is a `#[gpu.spec]` var on a target that states specialization
# constants, which defines no global there: each read of it is the constant
pub fun specialized(lc: *lower_context.LowerContext, d: *ast_decl.Decl) bool {
    ret attaching(lc) && decorator.has(lc.scope.a, d, decorator.GPU_SPEC);
}

# a `#[gpu.spec]` var as its specialization constant: the id the host sets it by and the
# default its initializer gives
pub rec SpecVar {
    id:      u32;
    default: comptime_value.CTValue;
}

# the `#[gpu.spec]` var `sym` names on a target that states specialization constants, read in
# the scope it is written in, none for any other binding or target
pub fun spec_var(lc: *lower_context.LowerContext, sym: *resolve.Symbol) res[opt[SpecVar], fail.Fail] {
    val module_var: bool = sym.kind == resolve.SYM_VAR && (sym.flags & resolve.SYM_FLAG_MODULE) != 0;
    val imported:   bool = sym.kind == resolve.SYM_IMPORTED && sym.definition_kind == resolve.SYM_VAR;
    if (!attaching(lc) || !(module_var || imported)) { ret res[opt[SpecVar], fail.Fail].ok{opt[SpecVar].none{}}; }
    val res_found: res[lower_context.Declared, fail.Fail] = lower_context.declared(lc, sym);
    if (sel res_found.err)               { ret res[opt[SpecVar], fail.Fail].err{res_found.err}; }
    if (!lower_context.foreign(lc, sym)) { ret spec_of_declared(lc, res_found.ok); }
    val res_acquired: res[lower_context.ModuleScope, fail.Fail] = lower_context.origin_scope(lc, resolve.origin_of(lc.s, sym));
    if (sel res_acquired.err) { ret res[opt[SpecVar], fail.Fail].err{res_acquired.err}; }
    val res_mark: res[lower_context.ScopeMark, fail.Fail] = lower_context.scope_enter(lc, res_acquired.ok);
    if (sel res_mark.err) { ret res[opt[SpecVar], fail.Fail].err{res_mark.err}; }
    val res_made: res[opt[SpecVar], fail.Fail] = spec_of_declared(lc, res_found.ok);
    val err_left: err[fail.Fail]               = lower_context.scope_leave(lc, res_mark.ok);
    if (sel res_made.err) { ret res_made; }
    if (sel err_left.err) { ret res[opt[SpecVar], fail.Fail].err{err_left.err}; }
    ret res_made;
}

# the specialization constant of the declaration `found`, read in the scope in effect, which
# is the one it is written in
fun spec_of_declared(lc: *lower_context.LowerContext, found: lower_context.Declared) res[opt[SpecVar], fail.Fail] {
    val opt_decl: opt[*ast_decl.Decl] = ast.get_decl(lc.scope.a, found.declaration.decl);
    if (sel opt_decl.none) { ret res[opt[SpecVar], fail.Fail].ok{opt[SpecVar].none{}}; }
    val opt_dec: opt[*ast_decl.Decorator] = decorator.get(lc.scope.a, opt_decl.some, decorator.GPU_SPEC);
    if (sel opt_dec.none) { ret res[opt[SpecVar], fail.Fail].ok{opt[SpecVar].none{}}; }
    val res_integer_of: res[u64, fail.Fail] = integer_of(lc, argument(lc, opt_dec.some, 0));
    if (sel res_integer_of.err)                         { ret res[opt[SpecVar], fail.Fail].err{res_integer_of.err}; }
    if (res_integer_of.ok > 0xFFFF_FFFF)                { ret res[opt[SpecVar], fail.Fail].err{fail.message("lower: a `#[gpu.spec]` id sema admitted is wider than 32 bits")}; }
    if (found.declaration.value == sema_interface.NONE) { ret res[opt[SpecVar], fail.Fail].err{fail.message("lower: a `#[gpu.spec]` var declares no default")}; }
    val res_value: res[comptime_value.CTValue, comptime_failure.EvalFail] = comptime_deep.value(?found.iface.values, ?lc.s.interner, found.declaration.value);
    if (!sel res_value.ok)                                                                                    { ret res[opt[SpecVar], fail.Fail].err{fail.message("lower: a `#[gpu.spec]` var's default does not read back")}; }
    if (res_value.ok.kind != comptime_value.CT_KIND_INT && res_value.ok.kind != comptime_value.CT_KIND_FLOAT) { ret res[opt[SpecVar], fail.Fail].err{fail.message("lower: a `#[gpu.spec]` var's default is neither an integer nor a float")}; }
    val err_claimed: err[fail.Fail] = claim_spec(lc, res_integer_of.ok::u32, found.declaration, opt_decl.some);
    if (sel err_claimed.err) { ret res[opt[SpecVar], fail.Fail].err{err_claimed.err}; }
    ret res[opt[SpecVar], fail.Fail].ok{opt[SpecVar].some{SpecVar{id: res_integer_of.ok::u32, default: res_value.ok}}};
}

# the specialization id `id` claimed for the `#[gpu.spec]` var `declaration` names, `d` in the scope in
# effect, which is the one it is written in. the host names a constant by its id, so two vars of the
# unit that claim one id are refused at the second's declaration, naming both
fun claim_spec(lc: *lower_context.LowerContext, id: u32, declaration: *sema_interface.Declaration, d: *ast_decl.Decl) err[fail.Fail] {
    var key:       u32                           = id;
    val opt_known: opt[*lower_context.SpecClaim] = map.get[u32, lower_context.SpecClaim](?lc.specs, ?key);
    if (sel opt_known.some) {
        val known: *lower_context.SpecClaim = opt_known.some;
        if (module.same(known.origin, lc.scope.own_module) && known.decl == declaration.decl) { ret err[fail.Fail].ok{}; }
        val res_named: res[str, fail.Fail] = spec_name(lc, declaration);
        if (sel res_named.err) { ret err[fail.Fail].err{res_named.err}; }
        val res_said: res[str, fail.Fail] = diagnostic.format(lc.s.alloc,
            "the `#[gpu.spec({})]` vars '{}' and '{}' share one id in one SPIR-V module. give them different ids", id, res_named.ok, known.name);
        if (sel res_said.err) { ret err[fail.Fail].err{res_said.err}; }
        val refused: fail.Fail = lower_context.report_gate(lc, diagnostic_kind.SPIRV_INTERFACE, d.span, res_said.ok);
        str_free(lc.s.alloc, res_said.ok);
        ret err[fail.Fail].err{refused};
    }
    val res_named: res[str, fail.Fail] = spec_name(lc, declaration);
    if (sel res_named.err) { ret err[fail.Fail].err{res_named.err}; }
    val res_kept: res[bool, A.Error] = map.insert[u32, lower_context.SpecClaim](?lc.specs, id, lower_context.SpecClaim{origin: lc.scope.own_module, decl: declaration.decl, name: res_named.ok});
    if (sel res_kept.err) { ret err[fail.Fail].err{fail.refused(res_kept.err)}; }
    ret err[fail.Fail].ok{};
}

# the qualified name of the var `declaration` names, of the module in scope, held for the session
fun spec_name(lc: *lower_context.LowerContext, declaration: *sema_interface.Declaration) res[str, fail.Fail] {
    val res_joined: res[str, fail.Fail] = diagnostic.join(lc.s.alloc, intern.text(?lc.s.interner, lc.scope.fqn), ".", intern.text(?lc.s.interner, declaration.canon));
    if (sel res_joined.err) { ret res_joined; }
    ret diagnostic.text_intern(?lc.s.interner, lc.s.alloc, res_joined.ok);
}

# the attributes of global `gix` its declaration `d` states, read in the scope `d` is
# written in. a global that already carries attributes keeps them
pub fun global_attributes(lc: *lower_context.LowerContext, d: *ast_decl.Decl, gix: u32) err[fail.Fail] {
    val opt_schema: opt[*Schema] = schema_of(lc);
    if (sel opt_schema.none) { ret err[fail.Fail].ok{}; }
    val family: str = opt_schema.some.family;
    if (lc.m.globals.data[gix::usize].attributes.len != 0) { ret err[fail.Fail].ok{}; }
    val held:        Type     = lc.m.globals.data[gix::usize].data.type;
    val opt_class_n: opt[str] = class_name(lc, d, opt[Type].some{held});
    if (sel opt_class_n.none) { ret err[fail.Fail].ok{}; }
    if (opaque(lc, opt[Type].some{held})) {
        val err_role: err[fail.Fail] = handle_binding(lc, d, held);
        if (sel err_role.err) { ret err_role; }
    }
    val opt_class: opt[u64] = storage_class(opt_class_n.some);
    if (sel opt_class.none) { ret err[fail.Fail].err{fail.message("lower: masc's grammar has no storage class a shader role names")}; }
    val s:          id.Symbol      = id.Symbol.global{gix};
    val err_stored: err[fail.Fail] = attach_integer(lc, s, family, "storage", opt_class.some);
    if (sel err_stored.err) { ret err_stored; }

    val a:            *ast.Ast                 = lc.scope.a;
    var opt_resource: opt[*ast_decl.Decorator] = decorator.get(a, d, decorator.GPU_UNIFORM);
    if (!decorator.has(a, d, decorator.GPU_UNIFORM))                                                { opt_resource = decorator.get(a, d, decorator.GPU_STORAGE); }
    if (!decorator.has(a, d, decorator.GPU_UNIFORM) && !decorator.has(a, d, decorator.GPU_STORAGE)) { opt_resource = decorator.get(a, d, decorator.GPU_SAMPLER); }
    if (sel opt_resource.some) {
        val res_set: res[u64, fail.Fail] = integer_of(lc, argument(lc, opt_resource.some, 0));
        if (sel res_set.err) { ret err[fail.Fail].err{res_set.err}; }
        val res_binding: res[u64, fail.Fail] = integer_of(lc, argument(lc, opt_resource.some, 1));
        if (sel res_binding.err) { ret err[fail.Fail].err{res_binding.err}; }
        val err_put_set: err[fail.Fail] = attach_integer(lc, s, family, "set", res_set.ok);
        if (sel err_put_set.err) { ret err_put_set; }
        val err_put_binding: err[fail.Fail] = attach_integer(lc, s, family, "binding", res_binding.ok);
        if (sel err_put_binding.err) { ret err_put_binding; }
    }
    val opt_attachment: opt[*ast_decl.Decorator] = decorator.get(a, d, decorator.GPU_ATTACHMENT);
    if (sel opt_attachment.some) {
        val res_index: res[u64, fail.Fail] = integer_of(lc, argument(lc, opt_attachment.some, 0));
        if (sel res_index.err) { ret err[fail.Fail].err{res_index.err}; }
        val err_put_attachment: err[fail.Fail] = attach_integer(lc, s, family, "attachment", res_index.ok);
        if (sel err_put_attachment.err) { ret err_put_attachment; }
    }
    var opt_located: opt[*ast_decl.Decorator] = decorator.get(a, d, decorator.GPU_INPUT);
    if (!decorator.has(a, d, decorator.GPU_INPUT)) { opt_located = decorator.get(a, d, decorator.GPU_OUTPUT); }
    if (sel opt_located.some) {
        val res_integer_of: res[u64, fail.Fail] = integer_of(lc, argument(lc, opt_located.some, 0));
        if (sel res_integer_of.err) { ret err[fail.Fail].err{res_integer_of.err}; }
        val err_put: err[fail.Fail] = attach_integer(lc, s, family, "location", res_integer_of.ok);
        if (sel err_put.err) { ret err_put; }
    }
    val opt_gpu_builtin_entry: opt[*ast_decl.Decorator] = decorator.get(a, d, decorator.GPU_BUILTIN);
    if (sel opt_gpu_builtin_entry.some) {
        val opt_named: opt[str] = string_of(lc, opt_gpu_builtin_entry.some, 0);
        if (sel opt_named.none) { ret err[fail.Fail].err{fail.message("lower: a `#[gpu.builtin]` sema admitted names no built-in")}; }
        val opt_row: opt[*sema_builtin.Builtin] = sema_builtin.of(opt_named.some);
        if (sel opt_row.none) { ret err[fail.Fail].err{fail.message("lower: a `#[gpu.builtin]` sema admitted names no built-in")}; }
        val opt_spelled: opt[u64] = spirv_schema.spelled(spirv_schema.Enumeration.builtin{}, opt_row.some.spirv);
        if (sel opt_spelled.none) { ret err[fail.Fail].err{fail.message("lower: masc's grammar has no built-in a `#[gpu.builtin]` names")}; }
        val err_put: err[fail.Fail] = attach_integer(lc, s, family, "builtin", opt_spelled.some);
        if (sel err_put.err) { ret err_put; }
    }
    val opt_gpu_storage_entry: opt[*ast_decl.Decorator] = decorator.get(a, d, decorator.GPU_STORAGE);
    if (sel opt_gpu_storage_entry.some) { ret qualifiers(lc, s, family, opt_gpu_storage_entry.some); }
    ret err[fail.Fail].ok{};
}

# a `#[gpu.storage]` binding's memory qualifiers as the decorations of its variable
fun qualifiers(lc: *lower_context.LowerContext, s: id.Symbol, family: str, dec: *ast_decl.Decorator) err[fail.Fail] {
    var held: [3]u64;
    var n:    usize = 0;
    var ord:  u32   = 2;
    for (ord < dec.args_len && n < 3) {
        val opt_string_of: opt[str] = string_of(lc, dec, ord);
        ord = ord + 1;
        if (sel opt_string_of.none) { cnt; }
        var spelled: str = nil;
        if (str_equals(opt_string_of.some, "readonly"))  { spelled = "NonWritable"; }
        or (str_equals(opt_string_of.some, "writeonly")) { spelled = "NonReadable"; }
        or (str_equals(opt_string_of.some, "coherent"))  { spelled = "Coherent"; }
        if (spelled == nil)                              { cnt; }
        val opt_spelled: opt[u64] = spirv_schema.spelled(spirv_schema.Enumeration.decoration{}, spelled);
        if (sel opt_spelled.none) { ret err[fail.Fail].err{fail.message("lower: masc's grammar has no decoration a `#[gpu.storage]` qualifier names")}; }
        held[n] = opt_spelled.some;
        n       = n + 1;
    }
    if (n == 0) { ret err[fail.Fail].ok{}; }
    ret attach(lc, s, family, "decorate", Datum.integers{Slice[u64]{data: ?held[0], size: n}});
}

# the attributes of the global `gix` declared here for another module's declaration of
# `sym`, read in the scope it is written in
pub fun extern_global_attributes(lc: *lower_context.LowerContext, sym: *resolve.Symbol, gix: u32) err[fail.Fail] {
    if (!attaching(lc))                                    { ret err[fail.Fail].ok{}; }
    if (lc.m.globals.data[gix::usize].attributes.len != 0) { ret err[fail.Fail].ok{}; }
    val res_found: res[lower_context.Declared, fail.Fail] = lower_context.declared(lc, sym);
    if (sel res_found.err) { ret err[fail.Fail].err{res_found.err}; }
    val res_acquired: res[lower_context.ModuleScope, fail.Fail] = lower_context.origin_scope(lc, resolve.origin_of(lc.s, sym));
    if (sel res_acquired.err) { ret err[fail.Fail].err{res_acquired.err}; }
    val res_mark: res[lower_context.ScopeMark, fail.Fail] = lower_context.scope_enter(lc, res_acquired.ok);
    if (sel res_mark.err) { ret err[fail.Fail].err{res_mark.err}; }
    var err_made: err[fail.Fail]      = err[fail.Fail].ok{};
    val opt_decl: opt[*ast_decl.Decl] = ast.get_decl(lc.scope.a, res_found.ok.declaration.decl);
    if (sel opt_decl.some) { err_made = global_attributes(lc, opt_decl.some, gix); }
    val err_left: err[fail.Fail] = lower_context.scope_leave(lc, res_mark.ok);
    if (sel err_made.err) { ret err_made; }
    ret err_left;
}

# the spir-v execution model a `#[gpu.stage]` names
fun stage_name(name: str) opt[str] {
    if (str_equals(name, "vertex"))   { ret opt[str].some{"Vertex"}; }
    if (str_equals(name, "fragment")) { ret opt[str].some{"Fragment"}; }
    if (str_equals(name, "compute"))  { ret opt[str].some{"GLCompute"}; }
    ret opt[str].none{};
}

# the entry point function `fix` is: its stage, the bare source name a pipeline finds it
# by, and a compute stage's workgroup size, one in each dimension it does not state
pub fun function_attributes(lc: *lower_context.LowerContext, d: *ast_decl.Decl, fix: u32, bare: intern.StrId) err[fail.Fail] {
    val opt_schema: opt[*Schema] = schema_of(lc);
    if (sel opt_schema.none) { ret err[fail.Fail].ok{}; }
    val family:  str                      = opt_schema.some.family;
    val a:       *ast.Ast                 = lc.scope.a;
    val opt_dec: opt[*ast_decl.Decorator] = decorator.get(a, d, decorator.GPU_STAGE);
    if (sel opt_dec.none) { ret err[fail.Fail].ok{}; }
    val opt_named: opt[str] = string_of(lc, opt_dec.some, 0);
    if (sel opt_named.none) { ret err[fail.Fail].err{fail.message("lower: a `#[gpu.stage]` sema admitted names no stage")}; }
    val opt_model: opt[str] = stage_name(opt_named.some);
    if (sel opt_model.none) { ret err[fail.Fail].err{fail.message("lower: a `#[gpu.stage]` sema admitted names no stage")}; }
    val opt_spelled: opt[u64] = spirv_schema.spelled(spirv_schema.Enumeration.model{}, opt_model.some);
    if (sel opt_spelled.none) { ret err[fail.Fail].err{fail.message("lower: masc's grammar has no execution model a `#[gpu.stage]` names")}; }
    val s:          id.Symbol      = id.Symbol.function{fix};
    val err_staged: err[fail.Fail] = attach_integer(lc, s, family, "stage", opt_spelled.some);
    if (sel err_staged.err) { ret err_staged; }
    val err_entry: err[fail.Fail] = attach(lc, s, family, "entry", Datum.text{view_of(intern.text(?lc.s.interner, bare))});
    if (sel err_entry.err)                        { ret err_entry; }
    if (!str_equals(opt_model.some, "GLCompute")) { ret err[fail.Fail].ok{}; }

    var size:                    [3]u64                   = [3]u64{1, 1, 1};
    var specs:                   [6]u64;
    var spec_size:               usize                    = 0;
    val opt_gpu_workgroup_entry: opt[*ast_decl.Decorator] = decorator.get(a, d, decorator.GPU_WORKGROUP);
    if (sel opt_gpu_workgroup_entry.some) {
        var k: u32 = 0;
        for (k < 3 && k < opt_gpu_workgroup_entry.some.args_len) {
            val arg: ast_id.ExprId = argument(lc, opt_gpu_workgroup_entry.some, k);
            k = k + 1;
            val opt_sym: opt[*resolve.Symbol] = lower_context.symbol_of(lc, lower_context.expr_symbol_of(lc, arg));
            if (sel opt_sym.some) {
                val res_spec: res[opt[SpecVar], fail.Fail] = spec_var(lc, opt_sym.some);
                if (sel res_spec.err) { ret err[fail.Fail].err{res_spec.err}; }
                if (sel res_spec.ok.some) {
                    val res_sized: res[u64, fail.Fail] = workgroup_spec(lc, arg, res_spec.ok.some);
                    if (sel res_sized.err) { ret err[fail.Fail].err{res_sized.err}; }
                    size[k - 1]          = res_sized.ok;
                    specs[spec_size]     = (k - 1)::u64;
                    specs[spec_size + 1] = res_spec.ok.some.id::u64;
                    spec_size            = spec_size + 2;
                    cnt;
                }
            }
            val res_dim: res[u64, fail.Fail] = integer_of(lc, arg);
            if (sel res_dim.err) { ret err[fail.Fail].err{res_dim.err}; }
            size[k - 1] = res_dim.ok;
        }
    }
    val err_sized: err[fail.Fail] = attach(lc, s, family, "workgroup", Datum.integers{Slice[u64]{data: ?size[0], size: 3}});
    if (sel err_sized.err) { ret err_sized; }
    if (spec_size == 0)    { ret err[fail.Fail].ok{}; }
    ret attach(lc, s, family, "workgroup_spec", Datum.integers{Slice[u64]{data: ?specs[0], size: spec_size}});
}

# the default size of a workgroup dimension the `#[gpu.spec]` var `spec` sizes, named at `arg`,
# whose constant the module states so the dimension names one of its constants
fun workgroup_spec(lc: *lower_context.LowerContext, arg: ast_id.ExprId, spec: SpecVar) res[u64, fail.Fail] {
    val opt_ct_int_u64: opt[u64] = comptime_value.ct_int_u64(spec.default);
    if (sel opt_ct_int_u64.none) { ret res[u64, fail.Fail].err{fail.message("lower: a workgroup `#[gpu.spec]` var's default is not an integer")}; }
    val res_lower_type: res[Type, fail.Fail] = lower_context.lower_type(lc, lower_context.expr_type_of(lc, arg));
    if (sel res_lower_type.err) { ret res[u64, fail.Fail].err{res_lower_type.err}; }
    val stated:    value.Value    = builder.spec_constant(?lc.builder, spec.id, value.const_int(opt_ct_int_u64.some, res_lower_type.ok));
    val err_built: err[fail.Fail] = lower_context.builder_state(lc);
    if (sel err_built.err) { ret res[u64, fail.Fail].err{err_built.err}; }
    ret res[u64, fail.Fail].ok{opt_ct_int_u64.some};
}
