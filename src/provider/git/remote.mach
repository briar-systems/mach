# smart HTTP v0/v1 reference discovery and self-contained upload-pack requests

use http.client.url;
use mach.provider.git.object;
use mach.provider.git.protocol;
use A: std.allocator;
#[testing]
use std.allocator.page;
use std.collections.vector;
use std.collections.vector.Vector;
use std.format;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view;

pub val MAX_REFS:      usize = 100000;
pub val MAX_DISCOVERY: usize = 16777216;

# name borrows the advertisement's input bytes
pub rec Ref {
    id:   object.Id;
    name: view.View;
}

pub rec Advertisement {
    refs:          Vector[Ref];
    hash_len:      usize;
    sideband:      bool;
    ofs_delta:     bool;
    object_format: bool;
    include_tag:   bool;
}

fun same(data: *u8, len: usize, text: str) bool {
    if (len != str_len(text)) { ret false; }
    var i: usize = 0;
    for (i < len) {
        if (data[i] != text[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun capability(ad: *Advertisement, data: *u8, len: usize) err[str] {
    if (same(data, len, "side-band-64k")) { ad.sideband = true; }
    if (same(data, len, "include-tag"))   { ad.include_tag = true; }
    if (same(data, len, "ofs-delta"))     { ad.ofs_delta = true; }
    if (same(data, len, "object-format=sha1")) {
        ad.hash_len      = 20;
        ad.object_format = true;
    }
    if (same(data, len, "object-format=sha256")) {
        ad.hash_len      = 32;
        ad.object_format = true;
    }
    if (len >= 14 && same(data, 14, "object-format=")
        && !same(data, len, "object-format=sha1") && !same(data, len, "object-format=sha256")) {
        ret err[str].err{"unsupported Git object format"};
    }
    ret err[str].ok{};
}

pub fun valid_ref(data: *u8, len: usize) bool {
    if (len == 0 || data == nil || data[0] == '/' || data[len - 1] == '/' || data[len - 1] == '.') { ret false; }
    var start: usize = 0;
    var i:     usize = 0;
    for (i < len) {
        val c: u8 = data[i];
        if (c <= 32 || c == 127 || c == '\\' || c == '~' || c == '^' || c == ':'
            || c == '?' || c == '*' || c == '[') { ret false; }
        if (i > 0 && ((c == '.' && data[i - 1] == '.') || (c == '{' && data[i - 1] == '@'))) { ret false; }
        if (c == '/' || i + 1 == len) {
            var end: usize = i;
            if (c != '/')                                                                                     { end = i + 1; }
            if (end == start || data[start] == '.' || (end - start >= 5 && same(?data[end - 5], 5, ".lock"))) { ret false; }
            start = i + 1;
        }
        i = i + 1;
    }
    ret true;
}

pub fun discover(a: *A.Allocator, data: *u8, len: usize) res[Advertisement, str] {
    if (len > MAX_DISCOVERY) { ret res[Advertisement, str].err{"Git reference advertisement exceeds limit"}; }
    var r:       protocol.Reader           = protocol.Reader{data: data, len: len, pos: 0};
    val service: res[protocol.Packet, str] = protocol.next(?r);
    if (sel service.err) { ret res[Advertisement, str].err{service.err}; }
    if (service.ok.flush || !same(service.ok.data, service.ok.len, "# service=git-upload-pack\n")) {
        ret res[Advertisement, str].err{"unexpected Git HTTP service"};
    }
    val separator: res[protocol.Packet, str] = protocol.next(?r);
    if (sel separator.err)   { ret res[Advertisement, str].err{separator.err}; }
    if (!separator.ok.flush) { ret res[Advertisement, str].err{"missing Git service separator"}; }
    var ad: Advertisement;
    ad.refs     = vector.init[Ref](a);
    ad.hash_len = 20;
    var keep: bool = false;
    fin {
        if (!keep) { vector.dnit[Ref](?ad.refs); }
    }
    var first:        bool = true;
    var version_seen: bool = false;
    for {
        val packet: res[protocol.Packet, str] = protocol.next(?r);
        if (sel packet.err)  { ret res[Advertisement, str].err{packet.err}; }
        if (packet.ok.flush) { brk; }
        var n:     usize = packet.ok.len;
        val bytes: *u8   = packet.ok.data;
        if (n > 0 && bytes[n - 1] == '\n') { n = n - 1; }
        if (first && !version_seen && same(bytes, n, "version 1")) {
            version_seen = true;
            cnt;
        }
        var split: usize = 0;
        for (split < n && bytes[split] != ' ') { split = split + 1; }
        val id: res[object.Id, str] = object.parse_id(bytes, split);
        if (sel id.err) { ret res[Advertisement, str].err{id.err}; }
        if (split == n) { ret res[Advertisement, str].err{"Git reference has no name"}; }
        var end: usize = split + 1;
        for (end < n && bytes[end] != 0) { end = end + 1; }
        if (end < n) {
            if (!first) { ret res[Advertisement, str].err{"Git capabilities outside first reference"}; }
            var start: usize = end + 1;
            for (start < n) {
                var stop: usize = start;
                for (stop < n && bytes[stop] != ' ') { stop = stop + 1; }
                val cap: err[str] = capability(?ad, ?bytes[start], stop - start);
                if (sel cap.err) { ret res[Advertisement, str].err{cap.err}; }
                start = stop + 1;
            }
        }
        first = false;
        if (id.ok.len != ad.hash_len) { ret res[Advertisement, str].err{"Git reference object format mismatch"}; }
        val name:     *u8   = ?bytes[split + 1];
        val name_len: usize = end - split - 1;
        var peeled:   bool  = false;
        if (name_len >= 3) { peeled = same(?name[name_len - 3], 3, "^{}"); }
        var checked_len: usize = name_len;
        if (peeled)                        { checked_len = checked_len - 3; }
        if (!valid_ref(name, checked_len)) { ret res[Advertisement, str].err{"invalid advertised Git reference"}; }
        if (ad.refs.len == MAX_REFS)       { ret res[Advertisement, str].err{"Git reference count exceeds limit"}; }
        if (!same(name, name_len, "capabilities^{}")) {
            var j: usize = 0;
            for (j < ad.refs.len) {
                if (ad.refs.data[j].name.len == name_len) {
                    var k: usize = 0;
                    for (k < name_len && ad.refs.data[j].name.data[k] == name[k]) { k = k + 1; }
                    if (k == name_len) { ret res[Advertisement, str].err{"duplicate Git reference"}; }
                }
                j = j + 1;
            }
            val added: res[usize, A.Error] = vector.push[Ref](?ad.refs,
                Ref{id: id.ok, name: view.view(name, name_len)});
            if (sel added.err) { ret res[Advertisement, str].err{"Git reference allocation refused"}; }
        }
    }
    if (r.pos != r.len) { ret res[Advertisement, str].err{"trailing Git reference advertisement"}; }
    keep = true;
    ret res[Advertisement, str].ok{ad};
}

pub fun select(ad: *Advertisement, selector: str) res[object.Id, str] {
    val n: usize = str_len(selector);
    if (n > 7 && same(selector, 7, "commit/")) { ret object.parse_id(?selector[7], n - 7); }
    var prefix: str   = "";
    var start:  usize = 0;
    if (n > 7 && same(selector, 7, "branch/")) {
        prefix = "refs/heads/";
        start  = 7;
    }
    or (n > 4 && same(selector, 4, "tag/")) {
        prefix = "refs/tags/";
        start  = 4;
    }
    or                                           { ret res[object.Id, str].err{"invalid Git selector"}; }
    if (!valid_ref(?selector[start], n - start)) { ret res[object.Id, str].err{"invalid Git selector name"}; }
    var i: usize = 0;
    for (i < ad.refs.len) {
        val ref: *Ref  = ?ad.refs.data[i];
        val p:   usize = str_len(prefix);
        if (ref.name.len == p + n - start && same(ref.name.data, p, prefix)) {
            var j: usize = 0;
            for (j < n - start && ref.name.data[p + j] == selector[start + j]) { j = j + 1; }
            if (j == n - start) { ret res[object.Id, str].ok{ref.id}; }
        }
        i = i + 1;
    }
    ret res[object.Id, str].err{"Git selector was not advertised"};
}

# request a complete object closure: no have lines, depth, filters or thin-pack
pub fun request(a: *A.Allocator, ad: *Advertisement, wanted: *object.Id) res[Vector[u8], str] {
    if (wanted.len != ad.hash_len) { ret res[Vector[u8], str].err{"Git requested object format mismatch"}; }
    var id: [65]u8;
    if (!object.format_id(wanted, ?id[0])) { ret res[Vector[u8], str].err{"invalid Git requested object ID"}; }
    var include_tag: str = "";
    if (ad.include_tag) { include_tag = " include-tag"; }
    var sideband:      str = "";
    var delta:         str = "";
    var object_format: str = "";
    if (ad.sideband)  { sideband = " side-band-64k"; }
    if (ad.ofs_delta) { delta = " ofs-delta"; }
    if (ad.object_format) {
        object_format = " object-format=sha1";
        if (ad.hash_len == 32) { object_format = " object-format=sha256"; }
    }
    val line: res[str, format.FormatError] = format.sprint(a, "want {}{}{}{}{}\n", (?id[0])::str, sideband, delta, object_format, include_tag);
    if (sel line.err) { ret res[Vector[u8], str].err{"Git request allocation refused"}; }
    fin { str_free(a, line.ok); }
    var out:  Vector[u8] = vector.init[u8](a);
    var keep: bool       = false;
    fin {
        if (!keep) { vector.dnit[u8](?out); }
    }
    val want: err[str] = protocol.append_packet(?out, line.ok, str_len(line.ok));
    if (sel want.err) { ret res[Vector[u8], str].err{want.err}; }
    val flush: err[str] = protocol.append_flush(?out);
    if (sel flush.err) { ret res[Vector[u8], str].err{flush.err}; }
    val done: err[str] = protocol.append_packet(?out, "done\n", 5);
    if (sel done.err) { ret res[Vector[u8], str].err{done.err}; }
    keep = true;
    ret res[Vector[u8], str].ok{out};
}

pub fun response(a: *A.Allocator, data: *u8, len: usize, sideband: bool, limit: usize) res[Vector[u8], str] {
    var r:   protocol.Reader           = protocol.Reader{data: data, len: len, pos: 0};
    val ack: res[protocol.Packet, str] = protocol.next(?r);
    if (sel ack.err) { ret res[Vector[u8], str].err{ack.err}; }
    if (ack.ok.flush || !same(ack.ok.data, ack.ok.len, "NAK\n")) {
        ret res[Vector[u8], str].err{"unexpected Git upload-pack acknowledgement"};
    }
    var out:  Vector[u8] = vector.init[u8](a);
    var keep: bool       = false;
    fin {
        if (!keep) { vector.dnit[u8](?out); }
    }
    if (!sideband) {
        if (len - r.pos > limit) { ret res[Vector[u8], str].err{"Git pack exceeds download limit"}; }
        val copy: err[str] = protocol.append_bytes(?out, ?data[r.pos], len - r.pos);
        if (sel copy.err) { ret res[Vector[u8], str].err{copy.err}; }
    }
    or {
        for {
            val packet: res[protocol.Packet, str] = protocol.next(?r);
            if (sel packet.err)     { ret res[Vector[u8], str].err{packet.err}; }
            if (packet.ok.flush)    { brk; }
            if (packet.ok.len == 0) { ret res[Vector[u8], str].err{"empty Git sideband packet"}; }
            val channel: u8 = packet.ok.data[0];
            if (channel == 3)                 { ret res[Vector[u8], str].err{"Git server rejected upload-pack request"}; }
            if (channel != 1 && channel != 2) { ret res[Vector[u8], str].err{"invalid Git sideband channel"}; }
            if (channel == 1) {
                if (packet.ok.len - 1 > limit - out.len) { ret res[Vector[u8], str].err{"Git pack exceeds download limit"}; }
                val copy: err[str] = protocol.append_bytes(?out, ?packet.ok.data[1], packet.ok.len - 1);
                if (sel copy.err) { ret res[Vector[u8], str].err{copy.err}; }
            }
        }
        if (r.pos != len) { ret res[Vector[u8], str].err{"trailing Git sideband bytes"}; }
    }
    keep = true;
    ret res[Vector[u8], str].ok{out};
}

# validate the public HTTPS URL before any transport or filesystem operation
pub fun validate_url(text: str) err[str] {
    val parsed: url.Parsed = url.parse(view.view(text, str_len(text)), url.limits_default());
    if (parsed.status != url.URL_OK || !url.secure(parsed.url) || parsed.url.has_query || parsed.url.has_fragment) {
        ret err[str].err{"Git acquisition requires a public HTTPS repository URL"};
    }
    ret err[str].ok{};
}

test discovery__selectors_capabilities_and_duplicates {
    var a: A.Allocator;
    page.make(?a);
    var bytes: Vector[u8] = vector.init[u8](?a);
    fin { vector.dnit[u8](?bytes); }
    val service: err[str] = protocol.append_packet(?bytes, "# service=git-upload-pack\n", 26);
    if (sel service.err) { ret 1; }
    val separator: err[str] = protocol.append_flush(?bytes);
    if (sel separator.err) { ret 2; }
    val prefix: str        = "ce013625030ba8dba906f756967f9e9ca394464a refs/heads/main";
    val caps:   str        = "side-band-64k ofs-delta object-format=sha1\n";
    var first:  Vector[u8] = vector.init[u8](?a);
    fin { vector.dnit[u8](?first); }
    val p: err[str] = protocol.append_bytes(?first, prefix, str_len(prefix) + 1);
    if (sel p.err) { ret 3; }
    val c: err[str] = protocol.append_bytes(?first, caps, str_len(caps));
    if (sel c.err) { ret 4; }
    val ref: err[str] = protocol.append_packet(?bytes, first.data, first.len);
    if (sel ref.err) { ret 5; }
    val end: err[str] = protocol.append_flush(?bytes);
    if (sel end.err) { ret 6; }
    val parsed: res[Advertisement, str] = discover(?a, bytes.data, bytes.len);
    if (sel parsed.err) { ret 7; }
    var ad: Advertisement = parsed.ok;
    fin { vector.dnit[Ref](?ad.refs); }
    if (ad.refs.len != 1 || !ad.sideband || !ad.ofs_delta || ad.hash_len != 20) { ret 8; }
    val chosen: res[object.Id, str] = select(?ad, "branch/main");
    if (sel chosen.err) { ret 9; }
    val missing: res[object.Id, str] = select(?ad, "branch/missing");
    if (sel missing.ok) { ret 10; }
    var id:    object.Id            = chosen.ok;
    val built: res[Vector[u8], str] = request(?a, ?ad, ?id);
    if (sel built.err) { ret 11; }
    var request_bytes: Vector[u8] = built.ok;
    fin { vector.dnit[u8](?request_bytes); }
    var r:      protocol.Reader           = protocol.Reader{data: request_bytes.data, len: request_bytes.len, pos: 0};
    val wanted: res[protocol.Packet, str] = protocol.next(?r);
    if (sel wanted.err)                                          { ret 12; }
    if (wanted.ok.len < 45 || !same(wanted.ok.data, 5, "want ")) { ret 13; }
    bytes.len = bytes.len - 4;
    val duplicate: err[str] = protocol.append_packet(?bytes, prefix, str_len(prefix));
    if (sel duplicate.err) { ret 14; }
    val finish: err[str] = protocol.append_flush(?bytes);
    if (sel finish.err) { ret 15; }
    val refused: res[Advertisement, str] = discover(?a, bytes.data, bytes.len);
    if (sel refused.ok) {
        var leaked: Advertisement = refused.ok;
        vector.dnit[Ref](?leaked.refs);
        ret 16;
    }
}

test url__requires_https_without_credentials_or_query {
    val good: err[str] = validate_url("https://example.com/repo.git");
    if (sel good.err) { ret 1; }
    val bad: [4]str = [4]str{"http://example.com/repo", "ssh://example.com/repo", "https://user:password@example.com/repo", "https://example.com/repo?x"};
    var i:   usize  = 0;
    for (i < 4) {
        val checked: err[str] = validate_url(bad[i]);
        if (sel checked.ok) { ret 2; }
        i = i + 1;
    }
}
