# adapter for the compiler's existing dependency operations; never spawns a process

use acquire: mach.provider.git;
use mach.provider.git.checkout;
use cfg: mach.provider.git.configuration;
use mach.provider.git.index;
use mach.provider.git.object;
use mach.provider.git.pack;
use mach.provider.git.protocol;
use mach.provider.git.remote;
use mach.provider.git.store;
use wt: mach.provider.git.worktree;
use A:  std.allocator;
use std.collections.sort;
use std.collections.vector;
use std.collections.vector.Vector;
use fs: std.filesystem;
use std.format;
use io_error: std.io.error;
use std.io.handle;
use std.system.os;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.string.str_starts_with;

use std.types.path;
use std.types.view;

rec     Cached { directory: str; context: *wt.Context; }
pub rec State  { a: *A.Allocator; contexts: Vector[Cached]; }

pub fun init(a: *A.Allocator) State {
    ret State{a: a, contexts: vector.init[Cached](a)};
}

pub fun clear(s: *State) {
    var i: usize = 0;
    for (i < s.contexts.len) {
        val item: *Cached = ?s.contexts.data[i];
        wt.dnit(item.context);
        A.deallocate[wt.Context](s.a, item.context, 1);
        str_free(s.a, item.directory);
        i = i + 1;
    }
    s.contexts.len = 0;
}

pub fun dnit(s: *State) {
    clear(s);
    vector.dnit[Cached](?s.contexts);
}

fun context(s: *State, directory: str) res[*wt.Context, str] {
    var i: usize = 0;
    for (i < s.contexts.len) {
        if (str_equals(s.contexts.data[i].directory, directory)) { ret res[*wt.Context, str].ok{s.contexts.data[i].context}; }
        i = i + 1;
    }
    val opened: res[wt.Context, str] = wt.open(s.a, directory);
    if (sel opened.err) { ret res[*wt.Context, str].err{opened.err}; }
    var c:         wt.Context                = opened.ok;
    val allocated: res[*wt.Context, A.Error] = A.allocate[wt.Context](s.a, 1);
    if (sel allocated.err) {
        wt.dnit(?c);
        ret res[*wt.Context, str].err{"Git context allocation refused"};
    }
    @allocated.ok = c;
    val name: res[str, str] = cfg.copy(s.a, directory);
    if (sel name.err) {
        wt.dnit(allocated.ok);
        A.deallocate[wt.Context](s.a, allocated.ok, 1);
        ret res[*wt.Context, str].err{name.err};
    }
    val added: res[usize, A.Error] = vector.push[Cached](?s.contexts, Cached{directory: name.ok, context: allocated.ok});
    if (sel added.err) {
        str_free(s.a, name.ok);
        wt.dnit(allocated.ok);
        A.deallocate[wt.Context](s.a, allocated.ok, 1);
        ret res[*wt.Context, str].err{"Git context allocation refused"};
    }
    ret res[*wt.Context, str].ok{allocated.ok};
}

fun text(a: *A.Allocator, value: str) res[Vector[u8], str] {
    var out:    Vector[u8] = vector.init[u8](a);
    val copied: err[str]   = wt.append(?out, value);
    if (sel copied.err) {
        vector.dnit[u8](?out);
        ret res[Vector[u8], str].err{copied.err};
    }
    ret res[Vector[u8], str].ok{out};
}

fun answer(r: err[str], a: *A.Allocator) res[Vector[u8], str] {
    if (sel r.err) { ret res[Vector[u8], str].err{r.err}; }
    ret text(a, "");
}

fun flag(args: *str, n: usize, value: str) bool {
    var i: usize = 0;
    for (i < n) {
        if (str_equals(args[i], value)) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun path_operand(args: *str, n: usize) str {
    var i: usize = 0;
    for (i + 1 < n) {
        if (str_equals(args[i], "--")) { ret args[i + 1]; }
        i = i + 1;
    }
    ret "";
}

fun prefix(a: *A.Allocator, c: *wt.Context, directory: str) res[str, str] {
    val resolved: res[str, str] = wt.absolute(a, directory);
    if (sel resolved.err) { ret res[str, str].err{"Git prefix allocation refused"}; }
    fin { str_free(a, resolved.ok); }
    if (str_equals(resolved.ok, c.root)) { ret cfg.copy(a, ""); }
    val n: usize = str_len(c.root);
    if (!str_starts_with(resolved.ok, c.root) || !path.is_separator(resolved.ok[n])) { ret res[str, str].err{"Git operand outside repository"}; }
    val formatted: res[str, format.FormatError] = format.sprint(a, "{}/", (?resolved.ok[n + 1])::str);
    if (sel formatted.err) { ret res[str, str].err{"Git prefix allocation refused"}; }
    ret res[str, str].ok{formatted.ok};
}

fun relative(a: *A.Allocator, c: *wt.Context, directory: str, rel: str) res[str, str] {
    val p: res[str, str] = prefix(a, c, directory);
    if (sel p.err) { ret p; }
    var operand: str = rel;
    if (str_equals(operand, ".")) { operand = ""; }
    val formatted: res[str, format.FormatError] = format.sprint(a, "{}{}", p.ok, operand);
    str_free(a, p.ok);
    if (sel formatted.err) { ret res[str, str].err{"Git relative path allocation refused"}; }
    ret res[str, str].ok{formatted.ok};
}

fun id_answer(a: *A.Allocator, id: object.Id) res[Vector[u8], str] {
    var value:     object.Id     = id;
    val formatted: res[str, str] = wt.id_text(a, ?value);
    if (sel formatted.err) { ret res[Vector[u8], str].err{formatted.err}; }
    val out: res[Vector[u8], str] = text(a, formatted.ok);
    str_free(a, formatted.ok);
    ret out;
}

fun list_tree(c: *wt.Context, id: object.Id, rel: str, recursive: bool, directories: bool, mode_only: bool, nul: bool, out: *Vector[u8], depth: usize) err[str] {
    if (depth > 128) { ret err[str].err{"Git tree nesting exceeds limit"}; }
    var tree_id: object.Id              = id;
    val loaded:  res[*pack.Object, str] = wt.load(c, ?tree_id);
    if (sel loaded.err)      { ret err[str].err{loaded.err}; }
    if (loaded.ok.kind != 2) { ret err[str].err{"Git listing requires a tree"}; }
    var r: protocol.Reader = protocol.Reader{data: loaded.ok.bytes.data, len: loaded.ok.bytes.len, pos: 0};
    for (r.pos < r.len) {
        val parsed: res[store.TreeEntry, str] = store.tree_next(?r, c.repo.hash_len);
        if (sel parsed.err) { ret err[str].err{parsed.err}; }
        var e:      store.TreeEntry = parsed.ok;
        val joined: res[str, str]   = store.join(c.a, rel, e.name::str);
        if (sel joined.err) { ret err[str].err{joined.err}; }
        fin { str_free(c.a, joined.ok); }
        if (e.mode != 0o40000 || !recursive || directories) {
            val oid: res[str, str] = wt.id_text(c.a, ?e.id);
            if (sel oid.err) { ret err[str].err{oid.err}; }
            var kind: str = "blob";
            if (e.mode == 0o40000)  { kind = "tree"; }
            or (e.mode == 0o160000) { kind = "commit"; }
            var line: res[str, format.FormatError];
            if (mode_only) { line = format.sprint(c.a, "{} {}", wt.mode_text(e.mode), joined.ok); }
            or             { line = format.sprint(c.a, "{} {} {}\t{}", wt.mode_text(e.mode), kind, oid.ok, joined.ok); }
            str_free(c.a, oid.ok);
            if (sel line.err) { ret err[str].err{"Git tree listing allocation refused"}; }
            val copied: err[str] = wt.append(out, line.ok);
            str_free(c.a, line.ok);
            if (sel copied.err) { ret copied; }
            var end: u8 = '\n';
            if (nul) { end = 0; }
            val ended: err[str] = protocol.append_bytes(out, ?end, 1);
            if (sel ended.err) { ret ended; }
        }
        if (recursive && e.mode == 0o40000) {
            val nested: err[str] = list_tree(c, e.id, joined.ok, true, directories, mode_only, nul, out, depth + 1);
            if (sel nested.err) { ret nested; }
        }
    }
    ret err[str].ok{};
}

fun stage_compare(a: *index.Entry, b: *index.Entry) i64 {
    ret string.str_compare(a.name.data::str, b.name.data::str)::i64;
}

fun stage(c: *wt.Context, rel: str, remove: bool) err[str] {
    val old: *index.Entry = wt.entry(c, rel);
    if (remove) {
        if (old == nil) { ret err[str].ok{}; }
        val at: usize = ((old::usize - c.staged.entries.data::usize) / $size_of(index.Entry));
        var i:  usize = at;
        for (i + 1 < c.staged.entries.len) {
            c.staged.entries.data[i] = c.staged.entries.data[i + 1];
            i                        = i + 1;
        }
        c.staged.entries.len = c.staged.entries.len - 1;
        ret wt.save_index(c);
    }
    val full: res[str, str] = store.join(c.a, c.root, rel);
    if (sel full.err) { ret err[str].err{full.err}; }
    fin { str_free(c.a, full.ok); }
    val observed: res[fs.Metadata, io_error.Error] = fs.metadata_link(full.ok);
    if (sel observed.err) { ret err[str].err{"Git stage operand unavailable"}; }
    var meta:  fs.Metadata = observed.ok;
    var entry: index.Entry;
    var bytes: Vector[u8]  = vector.init[u8](c.a);
    fin { vector.dnit[u8](?bytes); }
    if (fs.meta_is_dir(?meta)) {
        val opened: res[wt.Context, str] = wt.open(c.a, full.ok);
        if (sel opened.err) { ret err[str].err{opened.err}; }
        var child: wt.Context = opened.ok;
        fin { wt.dnit(?child); }
        if (!str_equals(child.root, full.ok)) { ret err[str].err{"Git stage directory is not a repository root"}; }
        val head: res[object.Id, str] = wt.resolve(?child, "HEAD^{commit}");
        if (sel head.err) { ret err[str].err{head.err}; }
        entry.mode = 0o160000;
        entry.id   = head.ok;
    }
    or {
        if (!fs.meta_is_file(?meta)) { ret err[str].err{"Git metadata staging requires a regular file"}; }
        val read: res[Vector[u8], str] = store.read_bounded(c.a, full.ok, pack.MAX_OBJECT);
        if (sel read.err) { ret err[str].err{read.err}; }
        bytes = read.ok;
        val hashed: res[object.Id, str] = object.object_id("blob", bytes.data, bytes.len, c.repo.hash_len);
        if (sel hashed.err) { ret err[str].err{hashed.err}; }
        entry.id   = hashed.ok;
        entry.mode = 0o100644;
        if ((meta.mode & 0o111) != 0) { entry.mode = 0o100755; }
        var o:      pack.Object = pack.Object{id: entry.id, kind: 3, bytes: bytes, offset: 0, depth: 0};
        val stored: err[str]    = store.write_object(c.a, ?c.repo, ?o);
        if (sel stored.err) { ret stored; }
    }
    if (old != nil) {
        entry.name = old.name;
        @old       = entry;
    }
    or {
        entry.name = view.view(rel, str_len(rel));
        val added: res[usize, A.Error] = vector.push[index.Entry](?c.staged.entries, entry);
        if (sel added.err) { ret err[str].err{"Git stage allocation refused"}; }
    }
    sort.sort_by[index.Entry](c.staged.entries.data, c.staged.entries.len, stage_compare);
    ret wt.save_index(c);
}

fun glob(pattern: *u8, pn: usize, value: *u8, vn: usize) bool {
    var p:     usize = 0;
    var v:     usize = 0;
    var star:  usize = pn;
    var retry: usize = 0;
    var cross: bool  = false;
    for (v < vn) {
        if (p < pn && (pattern[p] == value[v] || (pattern[p] == '?' && value[v] != '/'))) {
            p = p + 1;
            v = v + 1;
            cnt;
        }
        if (p < pn && pattern[p] == '*') {
            cross = p + 1 < pn && pattern[p + 1] == '*';
            for (p < pn && pattern[p] == '*') { p = p + 1; }
            star  = p;
            retry = v;
            cnt;
        }
        if (star != pn && retry < vn && (cross || value[retry] != '/')) {
            retry = retry + 1;
            v     = retry;
            p     = star;
            cnt;
        }
        ret false;
    }
    for (p < pn && pattern[p] == '*') { p = p + 1; }
    ret p == pn;
}

fun ignore_file(c: *wt.Context, file: str, rel: str, directory: bool, prior: bool) bool {
    val read: res[Vector[u8], str] = store.read_bounded(c.a, file, 1048576);
    if (sel read.err) { ret prior; }
    var bytes: Vector[u8] = read.ok;
    fin { vector.dnit[u8](?bytes); }
    var ignored: bool  = prior;
    var pos:     usize = 0;
    for (pos < bytes.len) {
        var end: usize = pos;
        for (end < bytes.len && bytes.data[end] != '\n') { end = end + 1; }
        var start: usize = pos;
        pos = end + 1;
        for (end > start && (bytes.data[end - 1] == '\r' || bytes.data[end - 1] == ' ')) { end = end - 1; }
        if (end == start || bytes.data[start] == '#') { cnt; }
        var negated: bool = false;
        if (bytes.data[start] == '!') {
            negated = true;
            start   = start + 1;
        }
        if (start == end) { cnt; }
        if (bytes.data[end - 1] == '/') {
            if (!directory) { cnt; }
            end = end - 1;
        }
        var anchored: bool = false;
        if (start < end && bytes.data[start] == '/') {
            anchored = true;
            start    = start + 1;
        }
        var slash: bool  = anchored;
        var i:     usize = start;
        for (i < end) {
            if (bytes.data[i] == '/') { slash = true; }
            i = i + 1;
        }
        var target: str = rel;
        if (!slash) {
            i = str_len(rel);
            for (i > 0 && rel[i - 1] != '/') { i = i - 1; }
            target = (?rel[i])::str;
        }
        if (glob(?bytes.data[start], end - start, target, str_len(target))) { ignored = !negated; }
    }
    ret ignored;
}

fun ignored(c: *wt.Context, rel: str, directory: bool) bool {
    val exclude: res[str, str] = store.join(c.a, c.repo.directory, "info/exclude");
    var answer:  bool          = false;
    if (sel exclude.ok) {
        answer = ignore_file(c, exclude.ok, rel, directory, false);
        str_free(c.a, exclude.ok);
    }
    var start: usize = 0;
    for {
        val prefix: res[str, string.StrError] = string.str_copy_slice(c.a, rel, 0, start);
        if (sel prefix.err) { ret answer; }
        val sub: res[str, str] = store.join(c.a, c.root, prefix.ok);
        str_free(c.a, prefix.ok);
        if (sel sub.err) { ret answer; }
        val file: res[str, str] = store.join(c.a, sub.ok, ".gitignore");
        str_free(c.a, sub.ok);
        if (sel file.ok) {
            answer = ignore_file(c, file.ok, (?rel[start])::str, directory, answer);
            str_free(c.a, file.ok);
        }
        var end: usize = start;
        for (rel[end] != 0 && rel[end] != '/') { end = end + 1; }
        if (rel[end] == 0) { brk; }
        start = end + 1;
    }
    ret answer;
}

fun within(name: str, scope: str) bool {
    if (str_len(scope) == 0 || str_equals(scope, ".")) { ret true; }
    ret str_equals(name, scope) || (str_starts_with(name, scope) && (scope[str_len(scope) - 1] == '/' || name[str_len(scope)] == '/'));
}

fun untracked(c: *wt.Context, rel: str, scope: str, out: *Vector[u8], paths_only: bool, nul: bool, depth: usize) err[str] {
    if (depth > 128) { ret err[str].err{"Git work tree nesting exceeds limit"}; }
    val full: res[str, str] = store.join(c.a, c.root, rel);
    if (sel full.err) { ret err[str].err{full.err}; }
    val listed: res[Vector[str], fs.FsError] = fs.read_dir(c.a, full.ok);
    str_free(c.a, full.ok);
    if (sel listed.err) { ret err[str].err{"Git work tree listing failed"}; }
    var names: Vector[str] = listed.ok;
    fin {
        var i: usize = 0;
        for (i < names.len) {
            str_free(c.a, names.data[i]);
            i = i + 1;
        }
        vector.dnit[str](?names);
    }
    var i: usize = 0;
    for (i < names.len) {
        val name: str = names.data[i];
        i = i + 1;
        if (str_equals(name, ".git")) { cnt; }
        val child: res[str, str] = store.join(c.a, rel, name);
        if (sel child.err) { ret err[str].err{child.err}; }
        fin { str_free(c.a, child.ok); }
        if (wt.entry(c, child.ok) != nil) { cnt; }
        val path_text: res[str, str] = store.join(c.a, c.root, child.ok);
        if (sel path_text.err) { ret err[str].err{path_text.err}; }
        val observed: res[fs.Metadata, io_error.Error] = fs.metadata_link(path_text.ok);
        str_free(c.a, path_text.ok);
        if (sel observed.err) { ret err[str].err{"Git work tree metadata failed"}; }
        var meta:   fs.Metadata = observed.ok;
        val is_dir: bool        = fs.meta_is_dir(?meta);
        if (ignored(c, child.ok, is_dir)) { cnt; }
        if (is_dir) {
            val nested: err[str] = untracked(c, child.ok, scope, out, paths_only, nul, depth + 1);
            if (sel nested.err) { ret nested; }
        }
        or (within(child.ok, scope)) {
            if (!paths_only) {
                val mark: err[str] = wt.append(out, "?? ");
                if (sel mark.err) { ret mark; }
            }
            val copied: err[str] = wt.append(out, child.ok);
            if (sel copied.err) { ret copied; }
            var end: u8 = '\n';
            if (nul) { end = 0; }
            val ended: err[str] = protocol.append_bytes(out, ?end, 1);
            if (sel ended.err) { ret ended; }
        }
    }
    ret err[str].ok{};
}

use mach.provider.git.links;

fun status(c: *wt.Context, scope: str, out: *Vector[u8], nul: bool) err[str] {
    val a:         *A.Allocator = c.a;
    var head_tree: object.Id;
    if (str_len(scope) == 0 || str_equals(scope, ".")) {
        val tree: res[object.Id, str] = wt.tree(c, "HEAD");
        if (sel tree.ok) { head_tree = tree.ok; }
    }
    var i: usize = 0;
    for (i < c.staged.entries.len) {
        val e: *index.Entry = ?c.staged.entries.data[i];
        i = i + 1;
        val name: res[str, string.StrError] = string.str_copy_slice(a, e.name.data::str, 0, e.name.len);
        if (sel name.err) { ret err[str].err{"Git status allocation refused"}; }
        fin { str_free(a, name.ok); }
        if (!within(name.ok, scope)) { cnt; }
        var x: u8 = ' ';
        var y: u8 = ' ';
        if (head_tree.len != 0) {
            val committed: res[store.TreeEntry, str] = wt.lookup(c, head_tree, name.ok);
            if (sel committed.err) { x = 'A'; }
            or (sel committed.ok) {
                var old: store.TreeEntry = committed.ok;
                if (!object.equal(?old.id, ?e.id) || old.mode != e.mode) { x = 'M'; }
            }
        }
        if (e.mode != 0o160000) {
            val full: res[str, str] = store.join(a, c.root, name.ok);
            if (sel full.err) { ret err[str].err{full.err}; }
            fin { str_free(a, full.ok); }
            val observed: res[fs.Metadata, io_error.Error] = fs.metadata_link(full.ok);
            if (sel observed.err) {
                if (observed.err.kind != io_error.NOT_FOUND) { ret err[str].err{"Git status metadata failed"}; }
                y = 'D';
            }
            or (sel observed.ok) {
                var meta:  fs.Metadata          = observed.ok;
                var bytes: res[Vector[u8], str] = res[Vector[u8], str].err{"Git status type mismatch"};
                if (e.mode == 0o120000 && fs.meta_is_symlink(?meta)) { bytes = links.read(a, full.ok); }
                or (e.mode != 0o120000 && fs.meta_is_file(?meta))    { bytes = store.read_bounded(a, full.ok, pack.MAX_OBJECT); }
                if (sel bytes.err)                                   { ret err[str].err{bytes.err}; }
                var content: Vector[u8]          = bytes.ok;
                val hashed:  res[object.Id, str] = object.object_id("blob", content.data, content.len, c.repo.hash_len);
                vector.dnit[u8](?content);
                if (sel hashed.err) { ret err[str].err{hashed.err}; }
                var actual: object.Id = hashed.ok;
                if (!object.equal(?actual, ?e.id)) { y = 'M'; }
                $if ($mach.build.os != $mach.os.windows) {
                    if (e.mode != 0o120000 && (((meta.mode & 0o111) != 0) != (e.mode == 0o100755))) { y = 'M'; }
                }
            }
        }
        if (x != ' ' || y != ' ') {
            var mark: [3]u8    = [3]u8{x, y, ' '};
            val m:    err[str] = protocol.append_bytes(out, ?mark[0], 3);
            if (sel m.err) { ret m; }
            val p: err[str] = wt.append(out, name.ok);
            if (sel p.err) { ret p; }
            var end: u8 = '\n';
            if (nul) { end = 0; }
            val n: err[str] = protocol.append_bytes(out, ?end, 1);
            if (sel n.err) { ret n; }
        }
    }
    ret untracked(c, "", scope, out, false, nul, 0);
}

fun initialize(a: *A.Allocator, directory: str) err[str] {
    val marker: res[str, str] = store.join(a, directory, ".git");
    if (sel marker.err) { ret err[str].err{marker.err}; }
    fin { str_free(a, marker.ok); }
    val exists: res[bool, io_error.Error] = fs.exists(marker.ok);
    if (sel exists.err) { ret err[str].err{"Git initialization inspection failed"}; }
    if (exists.ok)      { ret err[str].ok{}; }
    val directories: [4]str = [4]str{"objects", "refs/heads", "refs/tags", "info"};
    var i:           usize  = 0;
    for (i < 4) {
        val full: res[str, str] = store.join(a, marker.ok, directories[i]);
        if (sel full.err) { ret err[str].err{full.err}; }
        val made: err[fs.FsError] = fs.create_dir_all(a, full.ok, 493);
        str_free(a, full.ok);
        if (sel made.err) { ret err[str].err{"Git initialization failed"}; }
        i = i + 1;
    }
    val config: res[str, str] = store.join(a, marker.ok, "config");
    if (sel config.err) { ret err[str].err{config.err}; }
    val content:    str             = "[core]\nrepositoryformatversion = 0\nbare = false\nfilemode = true\n";
    val configured: err[fs.FsError] = fs.write_bytes(config.ok, content, str_len(content), 420);
    str_free(a, config.ok);
    if (sel configured.err) { ret err[str].err{"Git initialization configuration failed"}; }
    val head: res[str, str] = store.join(a, marker.ok, "HEAD");
    if (sel head.err) { ret err[str].err{head.err}; }
    val pointed: str             = "ref: refs/heads/main\n";
    val written: err[fs.FsError] = fs.write_bytes(head.ok, pointed, str_len(pointed), 420);
    str_free(a, head.ok);
    if (sel written.err) { ret err[str].err{"Git initialization HEAD failed"}; }
    ret err[str].ok{};
}

rec Listing { bytes: Vector[u8]; ad: remote.Advertisement; }

fun listing(a: *A.Allocator, url: str) res[Listing, str] {
    val checked: err[str] = remote.validate_url(url);
    if (sel checked.err) { ret res[Listing, str].err{checked.err}; }
    val info: res[str, format.FormatError] = format.sprint(a, "{}/info/refs?service=git-upload-pack", url);
    if (sel info.err) { ret res[Listing, str].err{"Git reference URL allocation refused"}; }
    val got: res[Vector[u8], str] = acquire.exchange(a, info.ok, false, nil, 0, "application/x-git-upload-pack-advertisement", remote.MAX_DISCOVERY);
    str_free(a, info.ok);
    if (sel got.err) { ret res[Listing, str].err{got.err}; }
    var bytes:  Vector[u8]                     = got.ok;
    val parsed: res[remote.Advertisement, str] = remote.discover(a, bytes.data, bytes.len);
    if (sel parsed.err) {
        vector.dnit[u8](?bytes);
        ret res[Listing, str].err{parsed.err};
    }
    ret res[Listing, str].ok{Listing{bytes: bytes, ad: parsed.ok}};
}

fun listing_dnit(l: *Listing) {
    vector.dnit[remote.Ref](?l.ad.refs);
    vector.dnit[u8](?l.bytes);
}

fun ref_line(a: *A.Allocator, out: *Vector[u8], id: object.Id, name: str) err[str] {
    var value: object.Id     = id;
    val hex:   res[str, str] = wt.id_text(a, ?value);
    if (sel hex.err) { ret err[str].err{hex.err}; }
    val line: res[str, format.FormatError] = format.sprint(a, "{} {}\n", hex.ok, name);
    str_free(a, hex.ok);
    if (sel line.err) { ret err[str].err{"Git reference listing allocation refused"}; }
    val added: err[str] = wt.append(out, line.ok);
    str_free(a, line.ok);
    ret added;
}

fun local_refs(c: *wt.Context, namespace: str, out: *Vector[str], depth: usize) err[str] {
    if (depth > 128) { ret err[str].err{"Git reference nesting exceeds limit"}; }
    val path_text: res[str, str] = store.join(c.a, c.repo.directory, namespace);
    if (sel path_text.err) { ret err[str].err{path_text.err}; }
    val listed: res[Vector[str], fs.FsError] = fs.read_dir(c.a, path_text.ok);
    str_free(c.a, path_text.ok);
    if (sel listed.err) { ret err[str].ok{}; }
    var names: Vector[str] = listed.ok;
    fin {
        var j: usize = 0;
        for (j < names.len) {
            str_free(c.a, names.data[j]);
            j = j + 1;
        }
        vector.dnit[str](?names);
    }
    var i: usize = 0;
    for (i < names.len) {
        val rel: res[str, str] = store.join(c.a, namespace, names.data[i]);
        i = i + 1;
        if (sel rel.err) { ret err[str].err{rel.err}; }
        val full: res[str, str] = store.join(c.a, c.repo.directory, rel.ok);
        if (sel full.err) {
            str_free(c.a, rel.ok);
            ret err[str].err{full.err};
        }
        val directory: res[bool, io_error.Error] = fs.is_dir(full.ok);
        str_free(c.a, full.ok);
        if (sel directory.ok && directory.ok) {
            val nested: err[str] = local_refs(c, rel.ok, out, depth + 1);
            str_free(c.a, rel.ok);
            if (sel nested.err) { ret nested; }
        }
        or {
            val added: res[usize, A.Error] = vector.push[str](out, rel.ok);
            if (sel added.err) {
                str_free(c.a, rel.ok);
                ret err[str].err{"Git reference allocation refused"};
            }
        }
    }
    ret err[str].ok{};
}

fun refs(c: *wt.Context, out: *Vector[str]) err[str] {
    val loose: err[str] = local_refs(c, "refs", out, 0);
    if (sel loose.err) { ret loose; }
    val file: res[str, str] = store.join(c.a, c.repo.directory, "packed-refs");
    if (sel file.err) { ret err[str].err{file.err}; }
    val read: res[Vector[u8], str] = store.read_bounded(c.a, file.ok, remote.MAX_DISCOVERY);
    str_free(c.a, file.ok);
    if (sel read.err) { ret err[str].ok{}; }
    var bytes: Vector[u8] = read.ok;
    fin { vector.dnit[u8](?bytes); }
    var pos: usize = 0;
    for (pos < bytes.len) {
        var end: usize = pos;
        for (end < bytes.len && bytes.data[end] != '\n') { end = end + 1; }
        val start: usize = pos;
        pos = end + 1;
        val n: usize = c.repo.hash_len * 2;
        if (end - start <= n + 1 || bytes.data[start + n] != ' ') { cnt; }
        val name: res[*u8, A.Error] = A.allocate[u8](c.a, end - start - n);
        if (sel name.err) { ret err[str].err{"Git reference allocation refused"}; }
        var j: usize = 0;
        for (j < end - start - n - 1) {
            name.ok[j] = bytes.data[start + n + 1 + j];
            j          = j + 1;
        }
        name.ok[j] = 0;
        var duplicate: bool = false;
        j = 0;
        for (j < out.len) {
            if (str_equals(out.data[j], name.ok::str)) {
                duplicate = true;
                brk;
            }
            j = j + 1;
        }
        if (duplicate) {
            str_free(c.a, name.ok::str);
            cnt;
        }
        val added: res[usize, A.Error] = vector.push[str](out, name.ok::str);
        if (sel added.err) {
            str_free(c.a, name.ok::str);
            ret err[str].err{"Git reference allocation refused"};
        }
    }
    ret err[str].ok{};
}

fun free_names(a: *A.Allocator, names: *Vector[str]) {
    var i: usize = 0;
    for (i < names.len) {
        str_free(a, names.data[i]);
        i = i + 1;
    }
    vector.dnit[str](names);
}

fun write_ref(c: *wt.Context, name: str, id: *object.Id) err[str] {
    if ((!str_starts_with(name, "refs/") && !str_equals(name, "HEAD") && !str_equals(name, "FETCH_HEAD")) || !remote.valid_ref(name, str_len(name))) { ret err[str].err{"invalid Git reference destination"}; }
    val file: res[str, str] = store.join(c.a, c.repo.directory, name);
    if (sel file.err) { ret err[str].err{file.err}; }
    fin { str_free(c.a, file.ok); }
    val hex: res[str, str] = wt.id_text(c.a, id);
    if (sel hex.err) { ret err[str].err{hex.err}; }
    val line: res[str, format.FormatError] = format.sprint(c.a, "{}\n", hex.ok);
    str_free(c.a, hex.ok);
    if (sel line.err) { ret err[str].err{"Git reference allocation refused"}; }
    val parent: res[path.Path, A.Error] = path.parent(c.a, file.ok);
    if (sel parent.err) {
        str_free(c.a, line.ok);
        ret err[str].err{"Git reference directory allocation refused"};
    }
    val made: err[fs.FsError] = fs.create_dir_all(c.a, parent.ok, 493);
    str_free(c.a, parent.ok);
    if (sel made.err) {
        str_free(c.a, line.ok);
        ret err[str].err{"Git reference directory creation failed"};
    }
    val written: err[fs.FsError] = fs.replace_bytes_atomic(c.a, file.ok, line.ok, str_len(line.ok), 420, 493);
    str_free(c.a, line.ok);
    if (sel written.err) { ret err[str].err{"Git reference write failed"}; }
    ret err[str].ok{};
}

fun collect(c: *wt.Context, p: *pack.Pack, id: object.Id, history: bool, depth: usize) err[str] {
    var current: object.Id = id;
    if (pack.find(p, ?current) != nil)                     { ret err[str].ok{}; }
    if (depth > 4096 || p.objects.len >= pack.MAX_OBJECTS) { ret err[str].err{"Git local object closure exceeds limit"}; }
    val loaded: res[*pack.Object, str] = wt.load(c, ?current);
    if (sel loaded.err) { ret err[str].err{loaded.err}; }
    val o:      pack.Object = @loaded.ok;
    var bytes:  Vector[u8]  = vector.init[u8](c.a);
    val copied: err[str]    = protocol.append_bytes(?bytes, o.bytes.data, o.bytes.len);
    if (sel copied.err) {
        vector.dnit[u8](?bytes);
        ret copied;
    }
    val added: res[usize, A.Error] = vector.push[pack.Object](?p.objects, pack.Object{id: o.id, kind: o.kind, bytes: bytes, offset: 0, depth: 0});
    if (sel added.err) {
        vector.dnit[u8](?bytes);
        ret err[str].err{"Git local closure allocation refused"};
    }
    if (o.kind == 2) {
        var r: protocol.Reader = protocol.Reader{data: o.bytes.data, len: o.bytes.len, pos: 0};
        for (r.pos < r.len) {
            val e: res[store.TreeEntry, str] = store.tree_next(?r, c.repo.hash_len);
            if (sel e.err) { ret err[str].err{e.err}; }
            if (e.ok.mode != 0o160000) {
                val nested: err[str] = collect(c, p, e.ok.id, history, depth + 1);
                if (sel nested.err) { ret nested; }
            }
        }
    }
    or (o.kind == 1 || o.kind == 4) {
        var start: usize = 0;
        for (start < o.bytes.len && o.bytes.data[start] != '\n') {
            var end: usize = start;
            for (end < o.bytes.len && o.bytes.data[end] != '\n') { end = end + 1; }
            var offset: usize = 0;
            if (end - start > 5 && o.bytes.data[start] == 't' && o.bytes.data[start + 1] == 'r')            { offset = 5; }
            or (history && end - start > 7 && o.bytes.data[start] == 'p' && o.bytes.data[start + 1] == 'a') { offset = 7; }
            or (o.kind == 4 && end - start > 7 && o.bytes.data[start] == 'o')                               { offset = 7; }
            if (offset != 0) {
                val child: res[object.Id, str] = object.parse_id(?o.bytes.data[start + offset], end - start - offset);
                if (sel child.err) { ret err[str].err{child.err}; }
                val nested: err[str] = collect(c, p, child.ok, history, depth + 1);
                if (sel nested.err) { ret nested; }
            }
            start = end + 1;
        }
    }
    ret err[str].ok{};
}

fun acquire_objects(a: *A.Allocator, url: str, selector: str) res[acquire.Fetched, str] {
    if (str_starts_with(url, "https://")) { ret acquire.fetch(a, url, selector); }
    if (str_starts_with(url, "http:") || str_starts_with(url, "ssh:") || str_starts_with(url, "git:") || str_starts_with(url, "git@")) {
        ret res[acquire.Fetched, str].err{"dependency transport needs external Git; native acquisition supports public HTTPS and local repositories"};
    }
    var source: str = url;
    if (str_starts_with(source, "file://")) { source = (?source[7])::str; }
    val opened: res[wt.Context, str] = wt.open(a, source);
    if (sel opened.err) { ret res[acquire.Fetched, str].err{opened.err}; }
    var c: wt.Context = opened.ok;
    fin { wt.dnit(?c); }
    var revision: str = selector;
    var owned:    str = nil;
    fin { str_free(a, owned); }
    if (str_starts_with(selector, "commit/")) { revision = (?selector[7])::str; }
    or (str_starts_with(selector, "branch/") || str_starts_with(selector, "tag/")) {
        var group: str   = "refs/heads/";
        var skip:  usize = 7;
        if (str_starts_with(selector, "tag/")) {
            group = "refs/tags/";
            skip  = 4;
        }
        val name: res[str, format.FormatError] = format.sprint(a, "{}{}", group, (?selector[skip])::str);
        if (sel name.err) { ret res[acquire.Fetched, str].err{"Git local selector allocation refused"}; }
        owned    = name.ok;
        revision = owned;
    }
    val chosen: res[object.Id, str] = wt.resolve(?c, revision);
    if (sel chosen.err) { ret res[acquire.Fetched, str].err{chosen.err}; }
    var p: pack.Pack;
    p.objects = vector.init[pack.Object](a);
    val collected: err[str] = collect(?c, ?p, chosen.ok, true, 0);
    if (sel collected.err) {
        pack.dnit(?p);
        ret res[acquire.Fetched, str].err{collected.err};
    }
    var names: Vector[str] = vector.init[str](a);
    fin { free_names(a, ?names); }
    val listed: err[str] = refs(?c, ?names);
    if (sel listed.err) {
        pack.dnit(?p);
        ret res[acquire.Fetched, str].err{listed.err};
    }
    var i: usize = 0;
    for (i < names.len) {
        val name: str = names.data[i];
        i = i + 1;
        if (!str_starts_with(name, "refs/tags/")) { cnt; }
        val tagged: res[object.Id, str] = wt.resolve(?c, name);
        if (sel tagged.err) {
            pack.dnit(?p);
            ret res[acquire.Fetched, str].err{tagged.err};
        }
        val peeled: res[object.Id, str] = wt.peel(?c, tagged.ok);
        if (sel peeled.err) {
            pack.dnit(?p);
            ret res[acquire.Fetched, str].err{peeled.err};
        }
        var oid: object.Id = peeled.ok;
        if (pack.find(?p, ?oid) != nil) {
            val added_tag: err[str] = collect(?c, ?p, tagged.ok, true, 0);
            if (sel added_tag.err) {
                pack.dnit(?p);
                ret res[acquire.Fetched, str].err{added_tag.err};
            }
        }
    }
    ret res[acquire.Fetched, str].ok{acquire.Fetched{objects: p, selected: chosen.ok}};
}

fun default_selector(a: *A.Allocator, url: str) res[str, str] {
    var id: object.Id;
    if (str_starts_with(url, "https://")) {
        val read: res[Listing, str] = listing(a, url);
        if (sel read.err) { ret res[str, str].err{read.err}; }
        var l: Listing = read.ok;
        fin { listing_dnit(?l); }
        var i: usize = 0;
        for (i < l.ad.refs.len) {
            val r: *remote.Ref = ?l.ad.refs.data[i];
            if (r.name.len == 4 && r.name.data[0] == 'H' && r.name.data[1] == 'E' && r.name.data[2] == 'A' && r.name.data[3] == 'D') {
                id = r.id;
                brk;
            }
            i = i + 1;
        }
        if (id.len == 0) { ret res[str, str].err{"Git remote has no default commit"}; }
    }
    or {
        var source: str = url;
        if (str_starts_with(url, "file://")) { source = (?url[7])::str; }
        val opened: res[wt.Context, str] = wt.open(a, source);
        if (sel opened.err) { ret res[str, str].err{opened.err}; }
        var c:      wt.Context          = opened.ok;
        val chosen: res[object.Id, str] = wt.resolve(?c, "HEAD");
        wt.dnit(?c);
        if (sel chosen.err) { ret res[str, str].err{chosen.err}; }
        id = chosen.ok;
    }
    val hex: res[str, str] = wt.id_text(a, ?id);
    if (sel hex.err) { ret hex; }
    val formatted: res[str, format.FormatError] = format.sprint(a, "commit/{}", hex.ok);
    str_free(a, hex.ok);
    if (sel formatted.err) { ret res[str, str].err{"Git default selector allocation refused"}; }
    ret res[str, str].ok{formatted.ok};
}

fun persist_ref(c: *wt.Context, p: *pack.Pack, name: str, id: object.Id) err[str] {
    var oid: object.Id = id;
    if (pack.find(p, ?oid) == nil) { ret err[str].ok{}; }
    var destination: str = name;
    var owned:       str = nil;
    fin { str_free(c.a, owned); }
    if (str_starts_with(name, "refs/heads/")) {
        val formatted: res[str, format.FormatError] = format.sprint(c.a, "refs/remotes/origin/{}", (?name[11])::str);
        if (sel formatted.err) { ret err[str].err{"Git remote ref allocation refused"}; }
        owned       = formatted.ok;
        destination = owned;
    }
    if (!str_starts_with(destination, "refs/")) { ret err[str].ok{}; }
    ret write_ref(c, destination, ?oid);
}

fun persist(c: *wt.Context, url: str, p: *pack.Pack, selected: *object.Id) err[str] {
    if (str_starts_with(url, "https://")) {
        val read: res[Listing, str] = listing(c.a, url);
        if (sel read.err) { ret err[str].err{read.err}; }
        var l: Listing = read.ok;
        fin { listing_dnit(?l); }
        var i: usize = 0;
        for (i < l.ad.refs.len) {
            val r: *remote.Ref = ?l.ad.refs.data[i];
            i = i + 1;
            if (r.name.len >= 3 && r.name.data[r.name.len - 3] == '^') { cnt; }
            val allocated: res[*u8, A.Error] = A.allocate[u8](c.a, r.name.len + 1);
            if (sel allocated.err) { ret err[str].err{"Git reference allocation refused"}; }
            var j: usize = 0;
            for (j < r.name.len) {
                allocated.ok[j] = r.name.data[j];
                j               = j + 1;
            }
            allocated.ok[j] = 0;
            val saved: err[str] = persist_ref(c, p, allocated.ok::str, r.id);
            str_free(c.a, allocated.ok::str);
            if (sel saved.err) { ret saved; }
        }
    }
    or {
        var source: str = url;
        if (str_starts_with(url, "file://")) { source = (?url[7])::str; }
        val opened: res[wt.Context, str] = wt.open(c.a, source);
        if (sel opened.err) { ret err[str].err{opened.err}; }
        var local: wt.Context = opened.ok;
        fin { wt.dnit(?local); }
        var names: Vector[str] = vector.init[str](c.a);
        fin { free_names(c.a, ?names); }
        val listed: err[str] = refs(?local, ?names);
        if (sel listed.err) { ret listed; }
        var i: usize = 0;
        for (i < names.len) {
            val resolved: res[object.Id, str] = wt.resolve(?local, names.data[i]);
            if (sel resolved.err) { ret err[str].err{resolved.err}; }
            val saved: err[str] = persist_ref(c, p, names.data[i], resolved.ok);
            if (sel saved.err) { ret saved; }
            i = i + 1;
        }
    }
    ret write_ref(c, "FETCH_HEAD", selected);
}

fun origin(c: *wt.Context) res[str, str] {
    val file: res[str, str] = store.join(c.a, c.repo.directory, "config");
    if (sel file.err) { ret file; }
    val read: res[cfg.Config, str] = wt.read_config(c.a, file.ok);
    str_free(c.a, file.ok);
    if (sel read.err) { ret res[str, str].err{read.err}; }
    var config: cfg.Config    = read.ok;
    val result: res[str, str] = cfg.get(c.a, ?config, "remote.origin.url", false);
    cfg.dnit(c.a, ?config);
    ret result;
}

fun set_origin(c: *wt.Context, url: str) err[str] {
    val file: res[str, str] = store.join(c.a, c.repo.directory, "config");
    if (sel file.err) { ret err[str].err{file.err}; }
    fin { str_free(c.a, file.ok); }
    val source: err[str] = wt.config_set(c.a, file.ok, "remote.origin.url", url, false);
    if (sel source.err) { ret source; }
    ret wt.config_set(c.a, file.ok, "remote.origin.fetch", "+refs/heads/*:refs/remotes/origin/*", false);
}

fun clone(a: *A.Allocator, url: str, destination: str, selected: str) err[str] {
    val parent: err[str] = parent_make(a, destination);
    if (sel parent.err) { ret parent; }
    var selector: str = selected;
    var owned:    str = nil;
    fin { str_free(a, owned); }
    if (str_len(selector) == 0) {
        val default_ref: res[str, str] = default_selector(a, url);
        if (sel default_ref.err) { ret err[str].err{default_ref.err}; }
        selector = default_ref.ok;
        owned    = selector;
    }
    val fetched: res[acquire.Fetched, str] = acquire_objects(a, url, selector);
    if (sel fetched.err) { ret err[str].err{fetched.err}; }
    var f: acquire.Fetched = fetched.ok;
    fin { pack.dnit(?f.objects); }
    val created: res[object.Id, str] = checkout.create(a, ?f.objects, ?f.selected, destination);
    if (sel created.err) { ret err[str].err{created.err}; }
    val opened: res[wt.Context, str] = wt.open(a, destination);
    if (sel opened.err) { ret err[str].err{opened.err}; }
    var c: wt.Context = opened.ok;
    fin { wt.dnit(?c); }
    val configured: err[str] = set_origin(?c, url);
    if (sel configured.err) { ret configured; }
    ret persist(?c, url, ?f.objects, ?f.selected);
}

fun fetch(c: *wt.Context, url: str, refspec: str) err[str] {
    var selector: str = nil;
    fin { str_free(c.a, selector); }
    if (str_len(refspec) != 0 && !string.str_contains(refspec, "*")) {
        var start: usize = 0;
        if (refspec[0] == '+') { start = 1; }
        var end: usize = start;
        for (refspec[end] != 0 && refspec[end] != ':') { end = end + 1; }
        val source: res[str, string.StrError] = string.str_copy_slice(c.a, refspec, start, end - start);
        if (sel source.err) { ret err[str].err{"Git fetch selector allocation refused"}; }
        var prefix: str = "commit/";
        var value:  str = source.ok;
        if (str_starts_with(value, "refs/tags/")) {
            prefix = "tag/";
            value  = (?value[10])::str;
        }
        or (str_starts_with(value, "refs/heads/")) {
            prefix = "branch/";
            value  = (?value[11])::str;
        }
        val formatted: res[str, format.FormatError] = format.sprint(c.a, "{}{}", prefix, value);
        str_free(c.a, source.ok);
        if (sel formatted.err) { ret err[str].err{"Git fetch selector allocation refused"}; }
        selector = formatted.ok;
    }
    or {
        val chosen: res[str, str] = default_selector(c.a, url);
        if (sel chosen.err) { ret err[str].err{chosen.err}; }
        selector = chosen.ok;
    }
    val fetched: res[acquire.Fetched, str] = acquire_objects(c.a, url, selector);
    if (sel fetched.err) { ret err[str].err{fetched.err}; }
    var f: acquire.Fetched = fetched.ok;
    fin { pack.dnit(?f.objects); }
    if (f.selected.len != c.repo.hash_len) { ret err[str].err{"Git fetched object format differs from repository"}; }
    val saved: err[str] = store.write_pack(c.a, ?c.repo, ?f.objects);
    if (sel saved.err) { ret saved; }
    ret persist(c, url, ?f.objects, ?f.selected);
}

fun checked_parent(a: *A.Allocator, root: str, rel: str) err[str] {
    var pos: usize = 0;
    for (rel[pos] != 0) {
        if (rel[pos] == '/') {
            val parent: res[str, string.StrError] = string.str_copy_slice(a, rel, 0, pos);
            if (sel parent.err) { ret err[str].err{"Git checkout parent allocation refused"}; }
            val full: res[str, str] = store.join(a, root, parent.ok);
            str_free(a, parent.ok);
            if (sel full.err) { ret err[str].err{full.err}; }
            val observed: res[fs.Metadata, io_error.Error] = fs.metadata_link(full.ok);
            str_free(a, full.ok);
            if (sel observed.ok) {
                var meta: fs.Metadata = observed.ok;
                if (!fs.meta_is_dir(?meta)) { ret err[str].err{"Git checkout parent is not a directory"}; }
            }
            or (sel observed.err) {
                if (observed.err.kind != io_error.NOT_FOUND) { ret err[str].err{"Git checkout parent inspection failed"}; }
            }
        }
        pos = pos + 1;
    }
    ret err[str].ok{};
}

fun parent_make(a: *A.Allocator, file: str) err[str] {
    val parent: res[path.Path, A.Error] = path.parent(a, file);
    if (sel parent.err) { ret err[str].err{"Git parent allocation refused"}; }
    val made: err[fs.FsError] = fs.create_dir_all(a, parent.ok, 493);
    str_free(a, parent.ok);
    if (sel made.err) { ret err[str].err{"Git parent directory creation failed"}; }
    ret err[str].ok{};
}

fun change_checkout(c: *wt.Context, revision: str) err[str] {
    val chosen: res[object.Id, str] = wt.resolve(c, revision);
    if (sel chosen.err) { ret err[str].err{chosen.err}; }
    val peeled: res[object.Id, str] = wt.peel(c, chosen.ok);
    if (sel peeled.err) { ret err[str].err{peeled.err}; }
    var id:         object.Id     = peeled.ok;
    val index_file: res[str, str] = store.join(c.a, c.repo.directory, "index");
    if (sel index_file.err) { ret err[str].err{index_file.err}; }
    fin { str_free(c.a, index_file.ok); }
    val lock_name: res[str, format.FormatError] = format.sprint(c.a, "{}.lock", index_file.ok);
    if (sel lock_name.err) { ret err[str].err{"Git checkout lock allocation refused"}; }
    fin { str_free(c.a, lock_name.ok); }
    var fd: usize = os.INVALID_HANDLE;
    if (os.open(os.working_dir(), lock_name.ok, os.O_CREAT | os.O_EXCL | os.O_RDWR, 420, ?fd) < 0) { ret err[str].err{"Git index is locked; checkout retained"}; }
    var file:   fs.File = fs.File{handle: handle.FileHandle{value: fd}};
    var closed: bool    = false;
    fin {
        if (!closed) { fs.close(?file); }
        fs.remove_file(lock_name.ok);
    }
    var changes: Vector[u8] = vector.init[u8](c.a);
    fin { vector.dnit[u8](?changes); }
    val clean: err[str] = status(c, "", ?changes, false);
    if (sel clean.err)    { ret clean; }
    if (changes.len != 0) { ret err[str].err{"dependency checkout is dirty; existing checkout retained"}; }
    val head_name: res[str, str] = store.join(c.a, c.repo.directory, "HEAD");
    if (sel head_name.err) { ret err[str].err{head_name.err}; }
    fin { str_free(c.a, head_name.ok); }
    val prior: res[Vector[u8], str] = store.read_bounded(c.a, head_name.ok, 8192);
    if (sel prior.err) { ret err[str].err{prior.err}; }
    var old_head: Vector[u8] = prior.ok;
    fin { vector.dnit[u8](?old_head); }
    var p: pack.Pack;
    p.objects = vector.init[pack.Object](c.a);
    fin { pack.dnit(?p); }
    val gathered: err[str] = collect(c, ?p, id, false, 0);
    if (sel gathered.err) { ret gathered; }
    val temporary: res[fs.TempFile, fs.FsError] = fs.temp_create(c.a, "mach_checkout");
    if (sel temporary.err) { ret err[str].err{"Git checkout temporary allocation failed"}; }
    var temp: fs.TempFile = temporary.ok;
    fs.temp_close_and_remove(?temp);
    fin { str_free(c.a, fs.temp_path(?temp)); }
    val fresh_name: res[str, format.FormatError] = format.sprint(c.a, "{}.{}", c.root, path.filename(fs.temp_path(?temp)));
    if (sel fresh_name.err) { ret err[str].err{"Git checkout staging path allocation refused"}; }
    fin { str_free(c.a, fresh_name.ok); }
    val created: res[object.Id, str] = checkout.create(c.a, ?p, ?id, fresh_name.ok);
    if (sel created.err) { ret err[str].err{created.err}; }
    var retain_backup: bool = false;
    fin {
        if (!retain_backup) { fs.remove_all(c.a, fresh_name.ok); }
    }
    val next_name: res[str, str] = store.join(c.a, fresh_name.ok, ".git/index");
    if (sel next_name.err) { ret err[str].err{next_name.err}; }
    val read: res[Vector[u8], str] = store.read_bounded(c.a, next_name.ok, pack.MAX_TOTAL);
    str_free(c.a, next_name.ok);
    if (sel read.err) { ret err[str].err{read.err}; }
    var next_bytes: Vector[u8] = read.ok;
    fin { vector.dnit[u8](?next_bytes); }
    val parsed: res[index.Index, str] = index.decode(c.a, next_bytes.data, next_bytes.len, c.repo.hash_len);
    if (sel parsed.err) { ret err[str].err{parsed.err}; }
    var next: index.Index = parsed.ok;
    fin { vector.dnit[index.Entry](?next.entries); }
    var i: usize = 0;
    for (i < next.entries.len) {
        val e: *index.Entry = ?next.entries.data[i];
        i = i + 1;
        val name: str      = e.name.data::str;
        val safe: err[str] = checked_parent(c.a, c.root, name);
        if (sel safe.err) { ret safe; }
        if (wt.entry(c, name) == nil) {
            val full: res[str, str] = store.join(c.a, c.root, name);
            if (sel full.err) { ret err[str].err{full.err}; }
            val observed: res[fs.Metadata, io_error.Error] = fs.metadata_link(full.ok);
            if (sel observed.ok) {
                var meta: fs.Metadata = observed.ok;
                if (fs.meta_is_dir(?meta)) {
                    val removed: err[io_error.Error] = fs.remove_dir(full.ok);
                    if (sel removed.ok) {
                        str_free(c.a, full.ok);
                        cnt;
                    }
                }
                str_free(c.a, full.ok);
                ret err[str].err{"checkout would overwrite an untracked path; existing checkout retained"};
            }
            str_free(c.a, full.ok);
            if (observed.err.kind != io_error.NOT_FOUND) { ret err[str].err{"Git checkout path inspection failed"}; }
        }
    }
    val backup: res[str, str] = store.join(c.a, fresh_name.ok, ".mach-backup");
    if (sel backup.err) { ret err[str].err{backup.err}; }
    fin { str_free(c.a, backup.ok); }
    val made: err[io_error.Error] = fs.create_dir(backup.ok, 493);
    if (sel made.err) { ret err[str].err{"Git checkout backup creation failed"}; }
    var moved_old: Vector[str] = vector.init[str](c.a);
    var moved_new: Vector[str] = vector.init[str](c.a);
    var keep:      bool        = false;
    fin {
        if (!keep) {
            var j: usize = 0;
            for (j < moved_new.len) {
                val full: res[str, str] = store.join(c.a, c.root, moved_new.data[j]);
                if (sel full.ok) {
                    fs.remove_file(full.ok);
                    str_free(c.a, full.ok);
                }
                j = j + 1;
            }
            j = 0;
            for (j < moved_old.len) {
                val src: res[str, str] = store.join(c.a, backup.ok, moved_old.data[j]);
                val dst: res[str, str] = store.join(c.a, c.root, moved_old.data[j]);
                if (sel src.ok) {
                    if (sel dst.ok) {
                        val restored: err[io_error.Error] = fs.rename(src.ok, dst.ok);
                        if (sel restored.err) { retain_backup = true; }
                    }
                    or { retain_backup = true; }
                }
                or              { retain_backup = true; }
                if (sel src.ok) { str_free(c.a, src.ok); }
                if (sel dst.ok) { str_free(c.a, dst.ok); }
                j = j + 1;
            }
            fs.replace_bytes_atomic(c.a, head_name.ok, old_head.data, old_head.len, 420, 493);
        }
        vector.dnit[str](?moved_old);
        vector.dnit[str](?moved_new);
    }
    # reserve bookkeeping before moving any path
    val old_room: res[usize, A.Error] = vector.reserve[str](?moved_old, c.staged.entries.len);
    val new_room: res[usize, A.Error] = vector.reserve[str](?moved_new, next.entries.len);
    if (sel old_room.err) { ret err[str].err{"Git checkout backup allocation refused"}; }
    if (sel new_room.err) { ret err[str].err{"Git checkout backup allocation refused"}; }
    i = 0;
    for (i < c.staged.entries.len) {
        val e: *index.Entry = ?c.staged.entries.data[i];
        i = i + 1;
        if (e.mode == 0o160000) {
            var replaced: bool  = false;
            var j:        usize = 0;
            for (j < next.entries.len) {
                val incoming: *index.Entry = ?next.entries.data[j];
                if (incoming.mode != 0o160000 && str_equals(e.name.data::str, incoming.name.data::str)) {
                    replaced = true;
                    brk;
                }
                j = j + 1;
            }
            if (!replaced) { cnt; }
            val gitlink: res[str, str] = store.join(c.a, c.root, e.name.data::str);
            if (sel gitlink.err) { ret err[str].err{gitlink.err}; }
            val contents: res[Vector[str], fs.FsError] = fs.read_dir(c.a, gitlink.ok);
            str_free(c.a, gitlink.ok);
            if (sel contents.err) { ret err[str].err{"Git checkout gitlink directory inspection failed"}; }
            var names:    Vector[str] = contents.ok;
            val occupied: bool        = names.len != 0;
            free_names(c.a, ?names);
            if (occupied) { ret err[str].err{"checkout would overwrite a populated gitlink; existing checkout retained"}; }
        }
        val src: res[str, str] = store.join(c.a, c.root, e.name.data::str);
        if (sel src.err) { ret err[str].err{src.err}; }
        fin { str_free(c.a, src.ok); }
        val dst: res[str, str] = store.join(c.a, backup.ok, e.name.data::str);
        if (sel dst.err) { ret err[str].err{dst.err}; }
        fin { str_free(c.a, dst.ok); }
        val parent: err[str] = parent_make(c.a, dst.ok);
        if (sel parent.err) { ret parent; }
        val moved: err[io_error.Error] = fs.rename(src.ok, dst.ok);
        if (sel moved.err) { ret err[str].err{"Git checkout backup move failed"}; }
        vector.push[str](?moved_old, e.name.data::str);
    }
    i = 0;
    for (i < next.entries.len) {
        val e: *index.Entry = ?next.entries.data[i];
        i = i + 1;
        if (e.mode == 0o160000) {
            val full: res[str, str] = store.join(c.a, c.root, e.name.data::str);
            if (sel full.err) { ret err[str].err{full.err}; }
            val made: err[fs.FsError] = fs.create_dir_all(c.a, full.ok, 493);
            str_free(c.a, full.ok);
            if (sel made.err) { ret err[str].err{"Git checkout gitlink directory creation failed"}; }
            cnt;
        }
        val src: res[str, str] = store.join(c.a, fresh_name.ok, e.name.data::str);
        if (sel src.err) { ret err[str].err{src.err}; }
        fin { str_free(c.a, src.ok); }
        val dst: res[str, str] = store.join(c.a, c.root, e.name.data::str);
        if (sel dst.err) { ret err[str].err{dst.err}; }
        fin { str_free(c.a, dst.ok); }
        val parent: err[str] = parent_make(c.a, dst.ok);
        if (sel parent.err) { ret parent; }
        val moved: err[io_error.Error] = fs.rename(src.ok, dst.ok);
        if (sel moved.err) { ret err[str].err{"Git checkout materialization failed"}; }
        vector.push[str](?moved_new, e.name.data::str);
    }
    var pos: usize = 0;
    for (pos < next_bytes.len) {
        val written: res[usize, io_error.Error] = fs.write(file, ?next_bytes.data[pos], next_bytes.len - pos);
        if (sel written.err) { ret err[str].err{"Git checkout index write failed"}; }
        if (written.ok == 0) { ret err[str].err{"short Git checkout index write"}; }
        pos = pos + written.ok;
    }
    val synced: err[io_error.Error] = fs.sync(file);
    if (sel synced.err) { ret err[str].err{"Git checkout index sync failed"}; }
    val finished: err[io_error.Error] = fs.close(?file);
    closed = true;
    if (sel finished.err) { ret err[str].err{"Git checkout index close failed"}; }
    val pinned: err[str] = write_ref(c, "HEAD", ?id);
    if (sel pinned.err) { ret pinned; }
    val published: err[io_error.Error] = fs.rename(lock_name.ok, index_file.ok);
    if (sel published.err) { ret err[str].err{"Git checkout index replacement failed"}; }
    keep = true;
    ret err[str].ok{};
}

fun setting(c: *wt.Context, args: *str, n: usize, directory: str) res[Vector[u8], str] {
    var file:  str = nil;
    var blob:  str = nil;
    var owned: str = nil;
    fin { str_free(c.a, owned); }
    var i: usize = 1;
    for (i < n) {
        if (str_equals(args[i], "-f") && i + 1 < n) {
            file = args[i + 1];
            i    = i + 1;
        }
        or (str_starts_with(args[i], "--blob=")) { blob = (?args[i][7])::str; }
        i = i + 1;
    }
    var config: cfg.Config;
    config.pairs = vector.init[cfg.Pair](c.a);
    fin { cfg.dnit(c.a, ?config); }
    if (blob != nil) {
        val id: res[object.Id, str] = wt.resolve(c, blob);
        if (sel id.err) { ret res[Vector[u8], str].err{id.err}; }
        val loaded: res[*pack.Object, str] = wt.load(c, ?id.ok);
        if (sel loaded.err) { ret res[Vector[u8], str].err{loaded.err}; }
        val parsed: res[cfg.Config, str] = cfg.parse(c.a, loaded.ok.bytes.data, loaded.ok.bytes.len);
        if (sel parsed.err) { ret res[Vector[u8], str].err{parsed.err}; }
        config = parsed.ok;
    }
    or {
        var path_text: res[str, str] = res[str, str].err{"Git configuration path unavailable"};
        if (file != nil)       { path_text = store.join(c.a, directory, file); }
        or                     { path_text = store.join(c.a, c.repo.directory, "config"); }
        if (sel path_text.err) { ret res[Vector[u8], str].err{path_text.err}; }
        owned = path_text.ok;
        file  = owned;
        val loaded: res[cfg.Config, str] = wt.read_config(c.a, file);
        if (sel loaded.err) { ret res[Vector[u8], str].err{loaded.err}; }
        config = loaded.ok;
    }
    if (flag(args, n, "--get") || flag(args, n, "--get-all")) {
        val found: res[str, str] = cfg.get(c.a, ?config, args[n - 1], flag(args, n, "--get-all"));
        if (sel found.err) {
            i = 1;
            for (i + 1 < n) {
                if (str_equals(args[i], "--default")) { ret text(c.a, args[i + 1]); }
                i = i + 1;
            }
            ret res[Vector[u8], str].err{found.err};
        }
        val out: res[Vector[u8], str] = text(c.a, found.ok);
        str_free(c.a, found.ok);
        ret out;
    }
    if (blob != nil || n < 3)              { ret res[Vector[u8], str].err{"unsupported dependency Git configuration operation"}; }
    if (flag(args, n, "--remove-section")) { ret answer(wt.config_set(c.a, file, args[n - 1], "", true), c.a); }
    ret answer(wt.config_set(c.a, file, args[n - 2], args[n - 1], false), c.a);
}

fun submodule(c: *wt.Context, args: *str, n: usize) err[str] {
    if (n < 3) { ret err[str].err{"invalid dependency submodule operation"}; }
    val rel:  str           = args[n - 1];
    val full: res[str, str] = store.join(c.a, c.root, rel);
    if (sel full.err) { ret err[str].err{full.err}; }
    fin { str_free(c.a, full.ok); }
    val gm: res[str, str] = store.join(c.a, c.root, ".gitmodules");
    if (sel gm.err) { ret err[str].err{gm.err}; }
    fin { str_free(c.a, gm.ok); }
    val path_key: res[str, format.FormatError] = format.sprint(c.a, "submodule.{}.path", rel);
    if (sel path_key.err) { ret err[str].err{"Git submodule key allocation refused"}; }
    fin { str_free(c.a, path_key.ok); }
    val url_key: res[str, format.FormatError] = format.sprint(c.a, "submodule.{}.url", rel);
    if (sel url_key.err) { ret err[str].err{"Git submodule key allocation refused"}; }
    fin { str_free(c.a, url_key.ok); }
    if (str_equals(args[1], "add")) {
        val url:    str                       = args[n - 2];
        val exists: res[bool, io_error.Error] = fs.exists(full.ok);
        if (sel exists.err) { ret err[str].err{"Git submodule inspection failed"}; }
        if (!exists.ok) {
            val cloned: err[str] = clone(c.a, url, full.ok, "");
            if (sel cloned.err) { ret cloned; }
        }
        val child_r: res[wt.Context, str] = wt.open(c.a, full.ok);
        if (sel child_r.err) { ret err[str].err{child_r.err}; }
        var child:   wt.Context = child_r.ok;
        val pointed: err[str]   = set_origin(?child, url);
        wt.dnit(?child);
        if (sel pointed.err) { ret pointed; }
        val path_set: err[str] = wt.config_set(c.a, gm.ok, path_key.ok, rel, false);
        if (sel path_set.err) { ret path_set; }
        val url_set: err[str] = wt.config_set(c.a, gm.ok, url_key.ok, url, false);
        if (sel url_set.err) { ret url_set; }
        val metadata: err[str] = stage(c, ".gitmodules", false);
        if (sel metadata.err) { ret metadata; }
        ret stage(c, rel, false);
    }
    val read: res[cfg.Config, str] = wt.read_config(c.a, gm.ok);
    if (sel read.err) { ret err[str].err{read.err}; }
    var config: cfg.Config = read.ok;
    fin { cfg.dnit(c.a, ?config); }
    val source: res[str, str] = cfg.get(c.a, ?config, url_key.ok, false);
    if (sel source.err) { ret err[str].err{source.err}; }
    fin { str_free(c.a, source.ok); }
    if (str_equals(args[1], "sync")) {
        val child_r: res[wt.Context, str] = wt.open(c.a, full.ok);
        if (sel child_r.err) { ret err[str].err{child_r.err}; }
        var child:  wt.Context = child_r.ok;
        val synced: err[str]   = set_origin(?child, source.ok);
        wt.dnit(?child);
        ret synced;
    }
    if (!str_equals(args[1], "update")) { ret err[str].err{"unsupported dependency submodule operation"}; }
    val pin: *index.Entry = wt.entry(c, rel);
    if (pin == nil || pin.mode != 0o160000) { ret err[str].err{"submodule has no recorded commit"}; }
    val hex: res[str, str] = wt.id_text(c.a, ?pin.id);
    if (sel hex.err) { ret err[str].err{hex.err}; }
    val selector: res[str, format.FormatError] = format.sprint(c.a, "commit/{}", hex.ok);
    str_free(c.a, hex.ok);
    if (sel selector.err) { ret err[str].err{"Git submodule selector allocation refused"}; }
    fin { str_free(c.a, selector.ok); }
    val exists: res[bool, io_error.Error] = fs.exists(full.ok);
    if (sel exists.err) { ret err[str].err{"Git submodule inspection failed"}; }
    if (exists.ok) {
        val removed: err[io_error.Error] = fs.remove_dir(full.ok);
        if (sel removed.err) { ret err[str].err{"Git submodule destination is not empty"}; }
    }
    val store_rel: res[str, format.FormatError] = format.sprint(c.a, "modules/{}", rel);
    if (sel store_rel.err) { ret err[str].err{"Git module store path allocation refused"}; }
    val local: res[str, str] = store.join(c.a, c.repo.directory, store_rel.ok);
    str_free(c.a, store_rel.ok);
    if (sel local.err) { ret err[str].err{local.err}; }
    fin { str_free(c.a, local.ok); }
    val held: res[bool, io_error.Error] = fs.is_dir(local.ok);
    var url:  str                       = source.ok;
    if (sel held.ok && held.ok) { url = local.ok; }
    val cloned: err[str] = clone(c.a, url, full.ok, selector.ok);
    if (sel cloned.err) { ret cloned; }
    val child_r: res[wt.Context, str] = wt.open(c.a, full.ok);
    if (sel child_r.err) { ret err[str].err{child_r.err}; }
    var child:   wt.Context = child_r.ok;
    val pointed: err[str]   = set_origin(?child, source.ok);
    wt.dnit(?child);
    if (sel pointed.err) { ret pointed; }
    ret absorb(c, rel, full.ok);
}

# translate only the operations issued by the dependency driver, not a Git CLI
pub fun run(s: *State, directory: str, given: *str, count: usize) res[Vector[u8], str] {
    var skip: usize = 0;
    for (skip < count) {
        if (str_equals(given[skip], "-c") && skip + 1 < count) { skip = skip + 2; }
        or (str_starts_with(given[skip], "--work-tree="))      { skip = skip + 1; }
        or                                                     { brk; }
    }
    if (skip == count) { ret res[Vector[u8], str].err{"missing dependency Git operation"}; }
    val args:     *str         = ?given[skip];
    val n:        usize        = count - skip;
    val op:       str          = args[0];
    val a:        *A.Allocator = s.a;
    var mutating: bool         = str_equals(op, "init") || str_equals(op, "clone") || str_equals(op, "fetch") || str_equals(op, "checkout") || str_equals(op, "submodule") || str_equals(op, "add") || str_equals(op, "rm");
    if (str_equals(op, "config") && !flag(args, n, "--get") && !flag(args, n, "--get-all")) { mutating = true; }
    fin {
        if (mutating) { clear(s); }
    }
    if (str_equals(op, "init")) { ret answer(initialize(a, directory), a); }
    if (str_equals(op, "clone") && n >= 3) {
        val full: res[str, str] = store.join(a, directory, args[n - 1]);
        if (sel full.err) { ret res[Vector[u8], str].err{full.err}; }
        val result: err[str] = clone(a, args[n - 2], full.ok, "");
        str_free(a, full.ok);
        ret answer(result, a);
    }
    if (str_equals(op, "ls-remote") && n >= 2) {
        val url:  str        = args[n - 1];
        var out:  Vector[u8] = vector.init[u8](a);
        var keep: bool       = false;
        fin {
            if (!keep) { vector.dnit[u8](?out); }
        }
        if (str_starts_with(url, "https://")) {
            val got: res[Listing, str] = listing(a, url);
            if (sel got.err) { ret res[Vector[u8], str].err{got.err}; }
            var l: Listing = got.ok;
            fin { listing_dnit(?l); }
            var i: usize = 0;
            for (i < l.ad.refs.len) {
                val ref: *remote.Ref = ?l.ad.refs.data[i];
                i = i + 1;
                if (ref.name.len < 10) { cnt; }
                val name: res[*u8, A.Error] = A.allocate[u8](a, ref.name.len + 1);
                if (sel name.err) { ret res[Vector[u8], str].err{"Git listing allocation refused"}; }
                var j: usize = 0;
                for (j < ref.name.len) {
                    name.ok[j] = ref.name.data[j];
                    j          = j + 1;
                }
                name.ok[j] = 0;
                var added: err[str] = err[str].ok{};
                if (str_starts_with(name.ok::str, "refs/tags/")) { added = ref_line(a, ?out, ref.id, name.ok::str); }
                str_free(a, name.ok::str);
                if (sel added.err) { ret res[Vector[u8], str].err{added.err}; }
            }
        }
        or {
            var source: str = url;
            if (str_starts_with(url, "file://")) { source = (?url[7])::str; }
            val opened: res[wt.Context, str] = wt.open(a, source);
            if (sel opened.err) { ret res[Vector[u8], str].err{opened.err}; }
            var c: wt.Context = opened.ok;
            fin { wt.dnit(?c); }
            var names: Vector[str] = vector.init[str](a);
            fin { free_names(a, ?names); }
            val listed: err[str] = refs(?c, ?names);
            if (sel listed.err) { ret res[Vector[u8], str].err{listed.err}; }
            var i: usize = 0;
            for (i < names.len) {
                val name: str = names.data[i];
                i = i + 1;
                if (!str_starts_with(name, "refs/tags/")) { cnt; }
                val resolved: res[object.Id, str] = wt.resolve(?c, name);
                if (sel resolved.err) { ret res[Vector[u8], str].err{resolved.err}; }
                val added: err[str] = ref_line(a, ?out, resolved.ok, name);
                if (sel added.err) { ret res[Vector[u8], str].err{added.err}; }
                val peeled: res[object.Id, str] = wt.peel(?c, resolved.ok);
                if (sel peeled.err) { ret res[Vector[u8], str].err{peeled.err}; }
                var raw:    object.Id = resolved.ok;
                var target: object.Id = peeled.ok;
                if (!object.equal(?raw, ?target)) {
                    val suffixed: res[str, format.FormatError] = format.sprint(a, "{}^{{}}", name);
                    if (sel suffixed.err) { ret res[Vector[u8], str].err{"Git listing allocation refused"}; }
                    val p: err[str] = ref_line(a, ?out, target, suffixed.ok);
                    str_free(a, suffixed.ok);
                    if (sel p.err) { ret res[Vector[u8], str].err{p.err}; }
                }
            }
        }
        keep = true;
        ret res[Vector[u8], str].ok{out};
    }
    val opened: res[*wt.Context, str] = context(s, directory);
    if (sel opened.err) { ret res[Vector[u8], str].err{opened.err}; }
    val c: *wt.Context = opened.ok;
    if (str_equals(op, "config"))             { ret setting(c, args, n, directory); }
    if (str_equals(op, "submodule"))          { ret answer(submodule(c, args, n), a); }
    if (str_equals(op, "checkout") && n >= 2) { ret answer(change_checkout(c, args[n - 1]), a); }
    if (str_equals(op, "add") || str_equals(op, "rm")) {
        val rel: res[str, str] = relative(a, c, directory, args[n - 1]);
        if (sel rel.err) { ret res[Vector[u8], str].err{rel.err}; }
        val staged: err[str] = stage(c, rel.ok, str_equals(op, "rm"));
        str_free(a, rel.ok);
        ret answer(staged, a);
    }
    if (str_equals(op, "fetch")) {
        var source: str   = nil;
        var spec:   str   = "";
        var i:      usize = 1;
        for (i < n) {
            if (args[i][0] != '-') {
                if (source == nil) { source = args[i]; }
                or                 { spec = args[i]; }
            }
            i = i + 1;
        }
        var owned: str = nil;
        fin { str_free(a, owned); }
        if (source == nil || str_equals(source, "origin")) {
            val url: res[str, str] = origin(c);
            if (sel url.err) { ret res[Vector[u8], str].err{url.err}; }
            owned  = url.ok;
            source = owned;
        }
        ret answer(fetch(c, source, spec), a);
    }
    if (str_equals(op, "rev-parse")) {
        if (flag(args, n, "--git-path")) {
            val joined: res[str, str] = store.join(a, c.repo.directory, args[n - 1]);
            if (sel joined.err) { ret res[Vector[u8], str].err{joined.err}; }
            val out: res[Vector[u8], str] = text(a, joined.ok);
            str_free(a, joined.ok);
            ret out;
        }
        var out:     Vector[u8] = vector.init[u8](a);
        var special: bool       = false;
        var keep:    bool       = false;
        fin {
            if (!keep) { vector.dnit[u8](?out); }
        }
        var i: usize = 1;
        for (i < n) {
            if (str_equals(args[i], "--is-inside-work-tree")) {
                val r: err[str] = wt.append(?out, "true\n");
                if (sel r.err) { ret res[Vector[u8], str].err{r.err}; }
                special = true;
            }
            or (str_equals(args[i], "--show-toplevel")) {
                val r: err[str] = wt.append(?out, c.root);
                if (sel r.err) { ret res[Vector[u8], str].err{r.err}; }
                val e: err[str] = wt.append(?out, "\n");
                if (sel e.err) { ret res[Vector[u8], str].err{e.err}; }
                special = true;
            }
            or (str_equals(args[i], "--show-prefix")) {
                val p: res[str, str] = prefix(a, c, directory);
                if (sel p.err) { ret res[Vector[u8], str].err{p.err}; }
                val r: err[str] = wt.append(?out, p.ok);
                str_free(a, p.ok);
                if (sel r.err) { ret res[Vector[u8], str].err{r.err}; }
                val e: err[str] = wt.append(?out, "\n");
                if (sel e.err) { ret res[Vector[u8], str].err{e.err}; }
                special = true;
            }
            i = i + 1;
        }
        if (special) {
            keep = true;
            ret res[Vector[u8], str].ok{out};
        }
        val id: res[object.Id, str] = wt.resolve(c, args[n - 1]);
        if (sel id.err) { ret res[Vector[u8], str].err{id.err}; }
        ret id_answer(a, id.ok);
    }
    if (str_equals(op, "show") || str_equals(op, "cat-file")) {
        val spec:  str   = args[n - 1];
        var split: usize = 0;
        for (spec[split] != 0 && spec[split] != ':') { split = split + 1; }
        var id: object.Id;
        if (spec[split] == ':') {
            val revision: res[str, string.StrError] = string.str_copy_slice(a, spec, 0, split);
            if (sel revision.err) { ret res[Vector[u8], str].err{"Git show allocation refused"}; }
            val tree: res[object.Id, str] = wt.tree(c, revision.ok);
            str_free(a, revision.ok);
            if (sel tree.err) { ret res[Vector[u8], str].err{tree.err}; }
            val found: res[store.TreeEntry, str] = wt.lookup(c, tree.ok, (?spec[split + 1])::str);
            if (sel found.err) { ret res[Vector[u8], str].err{found.err}; }
            id = found.ok.id;
        }
        or {
            val resolved: res[object.Id, str] = wt.resolve(c, spec);
            if (sel resolved.err) { ret res[Vector[u8], str].err{resolved.err}; }
            id = resolved.ok;
        }
        val loaded: res[*pack.Object, str] = wt.load(c, ?id);
        if (sel loaded.err) { ret res[Vector[u8], str].err{loaded.err}; }
        var out:    Vector[u8] = vector.init[u8](a);
        val copied: err[str]   = protocol.append_bytes(?out, loaded.ok.bytes.data, loaded.ok.bytes.len);
        if (sel copied.err) {
            vector.dnit[u8](?out);
            ret res[Vector[u8], str].err{copied.err};
        }
        ret res[Vector[u8], str].ok{out};
    }
    if (str_equals(op, "ls-tree")) {
        var revision: str   = "HEAD";
        var i:        usize = 1;
        for (i < n && !str_equals(args[i], "--")) {
            if (args[i][0] != '-') { revision = args[i]; }
            i = i + 1;
        }
        val tree: res[object.Id, str] = wt.tree(c, revision);
        if (sel tree.err) { ret res[Vector[u8], str].err{tree.err}; }
        var out:  Vector[u8] = vector.init[u8](a);
        var keep: bool       = false;
        fin {
            if (!keep) { vector.dnit[u8](?out); }
        }
        val requested: str = path_operand(args, n);
        if (str_len(requested) != 0) {
            val rel: res[str, str] = relative(a, c, directory, requested);
            if (sel rel.err) { ret res[Vector[u8], str].err{rel.err}; }
            val found: res[store.TreeEntry, str] = wt.lookup(c, tree.ok, rel.ok);
            str_free(a, rel.ok);
            if (sel found.ok) {
                var e:   store.TreeEntry = found.ok;
                val oid: res[str, str]   = wt.id_text(a, ?e.id);
                if (sel oid.err) { ret res[Vector[u8], str].err{oid.err}; }
                var kind: str = "blob";
                if (e.mode == 0o160000) { kind = "commit"; }
                or (e.mode == 0o40000)  { kind = "tree"; }
                val line: res[str, format.FormatError] = format.sprint(a, "{} {} {}\t{}\n", wt.mode_text(e.mode), kind, oid.ok, requested);
                str_free(a, oid.ok);
                if (sel line.err) { ret res[Vector[u8], str].err{"Git listing allocation refused"}; }
                val copied: err[str] = wt.append(?out, line.ok);
                str_free(a, line.ok);
                if (sel copied.err) { ret res[Vector[u8], str].err{copied.err}; }
            }
        }
        or {
            val listed: err[str] = list_tree(c, tree.ok, "", flag(args, n, "-r"), flag(args, n, "-t"), flag(args, n, "--format=%(objectmode) %(path)"), flag(args, n, "-z"), ?out, 0);
            if (sel listed.err) { ret res[Vector[u8], str].err{listed.err}; }
        }
        keep = true;
        ret res[Vector[u8], str].ok{out};
    }
    if (str_equals(op, "ls-files") || str_equals(op, "status")) {
        val rel: res[str, str] = relative(a, c, directory, path_operand(args, n));
        if (sel rel.err) { ret res[Vector[u8], str].err{rel.err}; }
        fin { str_free(a, rel.ok); }
        var out:  Vector[u8] = vector.init[u8](a);
        var keep: bool       = false;
        fin {
            if (!keep) { vector.dnit[u8](?out); }
        }
        if (str_equals(op, "status")) {
            val checked: err[str] = status(c, rel.ok, ?out, flag(args, n, "-z"));
            if (sel checked.err) { ret res[Vector[u8], str].err{checked.err}; }
        }
        or {
            var i: usize = 0;
            for (i < c.staged.entries.len) {
                val e: *index.Entry = ?c.staged.entries.data[i];
                i = i + 1;
                val name: str = e.name.data::str;
                if (!within(name, rel.ok)) { cnt; }
                if (flag(args, n, "--stage")) {
                    val oid: res[str, str] = wt.id_text(a, ?e.id);
                    if (sel oid.err) { ret res[Vector[u8], str].err{oid.err}; }
                    val lead: res[str, format.FormatError] = format.sprint(a, "{} {} 0\t", wt.mode_text(e.mode), oid.ok);
                    str_free(a, oid.ok);
                    if (sel lead.err) { ret res[Vector[u8], str].err{"Git index listing allocation refused"}; }
                    val copied: err[str] = wt.append(?out, lead.ok);
                    str_free(a, lead.ok);
                    if (sel copied.err) { ret res[Vector[u8], str].err{copied.err}; }
                }
                val copied: err[str] = wt.append(?out, name);
                if (sel copied.err) { ret res[Vector[u8], str].err{copied.err}; }
                var end: u8 = '\n';
                if (flag(args, n, "-z")) { end = 0; }
                val ended: err[str] = protocol.append_bytes(?out, ?end, 1);
                if (sel ended.err) { ret res[Vector[u8], str].err{ended.err}; }
            }
            if (flag(args, n, "--others")) {
                val others: err[str] = untracked(c, "", rel.ok, ?out, true, flag(args, n, "-z"), 0);
                if (sel others.err) { ret res[Vector[u8], str].err{others.err}; }
            }
        }
        if (str_equals(op, "ls-files")) {
            val p: res[str, str] = prefix(a, c, directory);
            if (sel p.err) { ret res[Vector[u8], str].err{p.err}; }
            fin { str_free(a, p.ok); }
            val cut: usize = str_len(p.ok);
            if (cut != 0) {
                var adjusted:      Vector[u8] = vector.init[u8](a);
                var adjusted_keep: bool       = false;
                fin {
                    if (!adjusted_keep) { vector.dnit[u8](?adjusted); }
                }
                var pos:       usize = 0;
                var delimiter: u8    = '\n';
                if (flag(args, n, "-z")) { delimiter = 0; }
                for (pos < out.len) {
                    var end: usize = pos;
                    for (end < out.len && out.data[end] != delimiter) { end = end + 1; }
                    var name: usize = pos;
                    if (flag(args, n, "--stage")) {
                        for (name < end && out.data[name] != '\t') { name = name + 1; }
                        if (name < end) { name = name + 1; }
                    }
                    if (end - name < cut) { ret res[Vector[u8], str].err{"Git listing path is outside project prefix"}; }
                    val lead: err[str] = protocol.append_bytes(?adjusted, ?out.data[pos], name - pos);
                    if (sel lead.err) { ret res[Vector[u8], str].err{lead.err}; }
                    val tail: err[str] = protocol.append_bytes(?adjusted, ?out.data[name + cut], end - name - cut);
                    if (sel tail.err) { ret res[Vector[u8], str].err{tail.err}; }
                    val ending: err[str] = protocol.append_bytes(?adjusted, ?delimiter, 1);
                    if (sel ending.err) { ret res[Vector[u8], str].err{ending.err}; }
                    pos = end + 1;
                }
                adjusted_keep = true;
                ret res[Vector[u8], str].ok{adjusted};
            }
        }
        keep = true;
        ret res[Vector[u8], str].ok{out};
    }
    if (str_equals(op, "for-each-ref") || str_equals(op, "tag")) {
        var names: Vector[str] = vector.init[str](a);
        fin { free_names(a, ?names); }
        val listed: err[str] = refs(c, ?names);
        if (sel listed.err) { ret res[Vector[u8], str].err{listed.err}; }
        var out:  Vector[u8] = vector.init[u8](a);
        var keep: bool       = false;
        fin {
            if (!keep) { vector.dnit[u8](?out); }
        }
        var target: object.Id;
        if (str_equals(op, "tag")) {
            val resolved: res[object.Id, str] = wt.resolve(c, args[n - 1]);
            if (sel resolved.err) { ret res[Vector[u8], str].err{resolved.err}; }
            val peeled: res[object.Id, str] = wt.peel(c, resolved.ok);
            if (sel peeled.err) { ret res[Vector[u8], str].err{peeled.err}; }
            target = peeled.ok;
        }
        var i: usize = 0;
        for (i < names.len) {
            val name: str = names.data[i];
            i = i + 1;
            if (!str_starts_with(name, "refs/tags/")) { cnt; }
            val raw: res[object.Id, str] = wt.resolve(c, name);
            if (sel raw.err) { ret res[Vector[u8], str].err{raw.err}; }
            val peeled: res[object.Id, str] = wt.peel(c, raw.ok);
            if (sel peeled.err) { ret res[Vector[u8], str].err{peeled.err}; }
            var raw_id:    object.Id = raw.ok;
            var commit_id: object.Id = peeled.ok;
            if (str_equals(op, "tag")) {
                if (object.equal(?commit_id, ?target)) {
                    val t: err[str] = wt.append(?out, (?name[10])::str);
                    if (sel t.err) { ret res[Vector[u8], str].err{t.err}; }
                    val e: err[str] = wt.append(?out, "\n");
                    if (sel e.err) { ret res[Vector[u8], str].err{e.err}; }
                }
            }
            or {
                val r: err[str] = ref_line(a, ?out, raw_id, name);
                if (sel r.err) { ret res[Vector[u8], str].err{r.err}; }
                if (!object.equal(?raw_id, ?commit_id)) {
                    val suffixed: res[str, format.FormatError] = format.sprint(a, "{}^{{}}", name);
                    if (sel suffixed.err) { ret res[Vector[u8], str].err{"Git peeled ref allocation refused"}; }
                    val p: err[str] = ref_line(a, ?out, commit_id, suffixed.ok);
                    str_free(a, suffixed.ok);
                    if (sel p.err) { ret res[Vector[u8], str].err{p.err}; }
                }
            }
        }
        keep = true;
        ret res[Vector[u8], str].ok{out};
    }
    ret res[Vector[u8], str].err{"unsupported compiler Git operation"};
}

# the driver knows the selector before acquisition, so a fresh checkout need not
# fetch unrelated branch tips to obtain a release tag
pub fun clone_selection(s: *State, directory: str, url: str, name: str, selector: str) err[str] {
    fin { clear(s); }
    val destination: res[str, str] = store.join(s.a, directory, name);
    if (sel destination.err) { ret err[str].err{destination.err}; }
    val result: err[str] = clone(s.a, url, destination.ok, selector);
    str_free(s.a, destination.ok);
    ret result;
}

pub fun add_dependency(s: *State, root: str, rel: str, url: str, selector: str, offline: bool) err[str] {
    fin { clear(s); }
    val opened: res[*wt.Context, str] = context(s, root);
    if (sel opened.err) { ret err[str].err{opened.err}; }
    val c:           *wt.Context   = opened.ok;
    val destination: res[str, str] = store.join(s.a, c.root, rel);
    if (sel destination.err) { ret err[str].err{destination.err}; }
    fin { str_free(s.a, destination.ok); }
    val exists: res[bool, io_error.Error] = fs.exists(destination.ok);
    if (sel exists.err) { ret err[str].err{"dependency destination inspection failed"}; }
    if (!exists.ok) {
        var source: str = url;
        var local:  str = nil;
        fin { str_free(s.a, local); }
        if (offline) {
            val stored_name: res[str, format.FormatError] = format.sprint(s.a, "modules/{}", rel);
            if (sel stored_name.err) { ret err[str].err{"dependency store allocation refused"}; }
            val stored: res[str, str] = store.join(s.a, c.repo.directory, stored_name.ok);
            str_free(s.a, stored_name.ok);
            if (sel stored.err) { ret err[str].err{stored.err}; }
            local  = stored.ok;
            source = local;
            val held: res[bool, io_error.Error] = fs.is_dir(source);
            if (sel held.err) { ret err[str].err{"offline dependency store unavailable"}; }
            if (!held.ok)     { ret err[str].err{"offline dependency store unavailable"}; }
        }
        val cloned: err[str] = clone(s.a, source, destination.ok, selector);
        if (sel cloned.err) { ret cloned; }
    }
    val child_r: res[wt.Context, str] = wt.open(s.a, destination.ok);
    if (sel child_r.err) { ret err[str].err{child_r.err}; }
    var child: wt.Context = child_r.ok;
    fin { wt.dnit(?child); }
    val pointed: err[str] = set_origin(?child, url);
    if (sel pointed.err) { ret pointed; }
    var revision: str = selector;
    var owned:    str = nil;
    fin { str_free(s.a, owned); }
    if (str_starts_with(selector, "commit/")) { revision = (?selector[7])::str; }
    or {
        var group: str   = "refs/remotes/origin/";
        var skip:  usize = 7;
        if (str_starts_with(selector, "tag/")) {
            group = "refs/tags/";
            skip  = 4;
        }
        val formatted: res[str, format.FormatError] = format.sprint(s.a, "{}{}", group, (?selector[skip])::str);
        if (sel formatted.err) { ret err[str].err{"dependency revision allocation refused"}; }
        owned    = formatted.ok;
        revision = owned;
    }
    if (!offline) {
        val ready:   res[object.Id, str] = wt.resolve(?child, revision);
        val missing: bool                = sel ready.err;
        if (missing || str_starts_with(selector, "branch/")) {
            var refspec:     str = revision;
            var branch_spec: str = nil;
            fin { str_free(s.a, branch_spec); }
            if (str_starts_with(selector, "branch/")) {
                val b: res[str, format.FormatError] = format.sprint(s.a, "refs/heads/{}", (?selector[7])::str);
                if (sel b.err) { ret err[str].err{"dependency fetch selector allocation refused"}; }
                branch_spec = b.ok;
                refspec     = branch_spec;
            }
            val fetched: err[str] = fetch(?child, url, refspec);
            if (sel fetched.err) { ret fetched; }
        }
    }
    val chosen: res[object.Id, str] = wt.resolve(?child, revision);
    if (sel chosen.err) { ret err[str].err{chosen.err}; }
    val at: res[object.Id, str] = wt.resolve(?child, "HEAD");
    if (sel at.err) { ret err[str].err{at.err}; }
    var target:  object.Id           = chosen.ok;
    var current: object.Id           = at.ok;
    val peeled:  res[object.Id, str] = wt.peel(?child, target);
    if (sel peeled.err) { ret err[str].err{peeled.err}; }
    target = peeled.ok;
    if (!object.equal(?target, ?current)) {
        val moved: err[str] = change_checkout(?child, revision);
        if (sel moved.err) { ret moved; }
    }
    val retained: err[str] = absorb(c, rel, destination.ok);
    if (sel retained.err) { ret retained; }
    val gm: res[str, str] = store.join(s.a, c.root, ".gitmodules");
    if (sel gm.err) { ret err[str].err{gm.err}; }
    fin { str_free(s.a, gm.ok); }
    val pk: res[str, format.FormatError] = format.sprint(s.a, "submodule.{}.path", rel);
    if (sel pk.err) { ret err[str].err{"dependency registration allocation refused"}; }
    val path_set: err[str] = wt.config_set(s.a, gm.ok, pk.ok, rel, false);
    str_free(s.a, pk.ok);
    if (sel path_set.err) { ret path_set; }
    val uk: res[str, format.FormatError] = format.sprint(s.a, "submodule.{}.url", rel);
    if (sel uk.err) { ret err[str].err{"dependency registration allocation refused"}; }
    val url_set: err[str] = wt.config_set(s.a, gm.ok, uk.ok, url, false);
    str_free(s.a, uk.ok);
    if (sel url_set.err) { ret url_set; }
    val metadata: err[str] = stage(c, ".gitmodules", false);
    if (sel metadata.err) { ret metadata; }
    ret stage(c, rel, false);
}

pub fun fetch_selection(s: *State, directory: str, selector: str) err[str] {
    fin { clear(s); }
    val opened: res[*wt.Context, str] = context(s, directory);
    if (sel opened.err) { ret err[str].err{opened.err}; }
    val c:   *wt.Context   = opened.ok;
    val url: res[str, str] = origin(c);
    if (sel url.err) { ret err[str].err{url.err}; }
    fin { str_free(s.a, url.ok); }
    var prefix: str = "";
    var value:  str = selector;
    if (str_starts_with(selector, "tag/")) {
        prefix = "refs/tags/";
        value  = (?selector[4])::str;
    }
    or (str_starts_with(selector, "branch/")) {
        prefix = "refs/heads/";
        value  = (?selector[7])::str;
    }
    or (str_starts_with(selector, "commit/")) { value = (?selector[7])::str; }
    val spec: res[str, format.FormatError] = format.sprint(s.a, "{}{}", prefix, value);
    if (sel spec.err) { ret err[str].err{"Git selector allocation refused"}; }
    val result: err[str] = fetch(c, url.ok, spec.ok);
    str_free(s.a, spec.ok);
    ret result;
}

pub fun ensure_pin_tag(s: *State, directory: str, pin: str) err[str] {
    fin { clear(s); }
    val opened: res[*wt.Context, str] = context(s, directory);
    if (sel opened.err) { ret err[str].err{opened.err}; }
    val c:   *wt.Context   = opened.ok;
    val url: res[str, str] = origin(c);
    if (sel url.err) { ret err[str].err{url.err}; }
    fin { str_free(s.a, url.ok); }
    val parsed: res[object.Id, str] = object.parse_id(pin, str_len(pin));
    if (sel parsed.err) { ret err[str].err{parsed.err}; }
    var target: object.Id   = parsed.ok;
    var names:  Vector[str] = vector.init[str](s.a);
    fin { free_names(s.a, ?names); }
    if (str_starts_with(url.ok, "https://")) {
        val read: res[Listing, str] = listing(s.a, url.ok);
        if (sel read.err) { ret err[str].err{read.err}; }
        var l: Listing = read.ok;
        fin { listing_dnit(?l); }
        var i: usize = 0;
        for (i < l.ad.refs.len) {
            val ref: *remote.Ref = ?l.ad.refs.data[i];
            i = i + 1;
            if (ref.name.len < 10 || !object.equal(?ref.id, ?target)) { cnt; }
            var len: usize = ref.name.len;
            if (len >= 3 && ref.name.data[len - 3] == '^') { len = len - 3; }
            val name: res[*u8, A.Error] = A.allocate[u8](s.a, len + 1);
            if (sel name.err) { ret err[str].err{"Git release name allocation refused"}; }
            var j: usize = 0;
            for (j < len) {
                name.ok[j] = ref.name.data[j];
                j          = j + 1;
            }
            name.ok[j] = 0;
            if (!str_starts_with(name.ok::str, "refs/tags/")) {
                str_free(s.a, name.ok::str);
                cnt;
            }
            val added: res[usize, A.Error] = vector.push[str](?names, name.ok::str);
            if (sel added.err) {
                str_free(s.a, name.ok::str);
                ret err[str].err{"Git release name allocation refused"};
            }
        }
    }
    or {
        var source: str = url.ok;
        if (str_starts_with(source, "file://")) { source = (?source[7])::str; }
        val source_r: res[wt.Context, str] = wt.open(s.a, source);
        if (sel source_r.err) { ret err[str].err{source_r.err}; }
        var local: wt.Context = source_r.ok;
        fin { wt.dnit(?local); }
        var all: Vector[str] = vector.init[str](s.a);
        fin { free_names(s.a, ?all); }
        val listed: err[str] = refs(?local, ?all);
        if (sel listed.err) { ret listed; }
        var i: usize = 0;
        for (i < all.len) {
            val name: str = all.data[i];
            i = i + 1;
            if (!str_starts_with(name, "refs/tags/")) { cnt; }
            val id: res[object.Id, str] = wt.resolve(?local, name);
            if (sel id.err) { ret err[str].err{id.err}; }
            val peeled: res[object.Id, str] = wt.peel(?local, id.ok);
            if (sel peeled.err) { ret err[str].err{peeled.err}; }
            var commit: object.Id = peeled.ok;
            if (!object.equal(?commit, ?target)) { cnt; }
            val copied: res[str, str] = cfg.copy(s.a, name);
            if (sel copied.err) { ret err[str].err{copied.err}; }
            val added: res[usize, A.Error] = vector.push[str](?names, copied.ok);
            if (sel added.err) {
                str_free(s.a, copied.ok);
                ret err[str].err{"Git release name allocation refused"};
            }
        }
    }
    var i: usize = 0;
    for (i < names.len) {
        val fetched: err[str] = fetch(c, url.ok, names.data[i]);
        if (sel fetched.err) { ret fetched; }
        i = i + 1;
    }
    ret err[str].ok{};
}

fun relative_path(a: *A.Allocator, from: str, to: str) res[str, str] {
    var common:   usize = 0;
    var boundary: usize = 0;
    for (from[common] != 0 && to[common] != 0 && from[common] == to[common]) {
        if (path.is_separator(from[common])) { boundary = common + 1; }
        common = common + 1;
    }
    if (from[common] == 0 && path.is_separator(to[common])) { boundary = common + 1; }
    if (boundary == 0)                                      { ret cfg.copy(a, to); }
    var out: Vector[u8] = vector.init[u8](a);
    fin { vector.dnit[u8](?out); }
    var i: usize = boundary;
    for (from[i] != 0) {
        val added: err[str] = wt.append(?out, "../");
        if (sel added.err) { ret res[str, str].err{added.err}; }
        for (from[i] != 0 && !path.is_separator(from[i])) { i = i + 1; }
        if (from[i] != 0) { i = i + 1; }
    }
    val tail: err[str] = wt.append(?out, (?to[boundary])::str);
    if (sel tail.err) { ret res[str, str].err{tail.err}; }
    val end: res[usize, A.Error] = vector.push[u8](?out, 0);
    if (sel end.err) { ret res[str, str].err{"Git relative path allocation refused"}; }
    ret cfg.copy(a, out.data::str);
}

# retain the dependency object store outside its work tree, as Git submodules do
fun absorb(parent: *wt.Context, rel: str, destination: str) err[str] {
    val a:      *A.Allocator  = parent.a;
    val marker: res[str, str] = store.join(a, destination, ".git");
    if (sel marker.err) { ret err[str].err{marker.err}; }
    fin { str_free(a, marker.ok); }
    val observed: res[fs.Metadata, io_error.Error] = fs.metadata_link(marker.ok);
    if (sel observed.err) { ret err[str].err{"dependency metadata unavailable"}; }
    var meta: fs.Metadata = observed.ok;
    if (fs.meta_is_file(?meta)) { ret err[str].ok{}; }
    if (!fs.meta_is_dir(?meta)) { ret err[str].err{"dependency metadata is not a directory"}; }
    val suffix: res[str, format.FormatError] = format.sprint(a, "modules/{}", rel);
    if (sel suffix.err) { ret err[str].err{"dependency cache path allocation refused"}; }
    val cache: res[str, str] = store.join(a, parent.repo.directory, suffix.ok);
    str_free(a, suffix.ok);
    if (sel cache.err) { ret err[str].err{cache.err}; }
    fin { str_free(a, cache.ok); }
    val exists: res[bool, io_error.Error] = fs.exists(cache.ok);
    if (sel exists.err) { ret err[str].err{"dependency cache inspection failed"}; }
    if (exists.ok) {
        val opened: res[wt.Context, str] = wt.open(a, destination);
        if (sel opened.err) { ret err[str].err{opened.err}; }
        var child: wt.Context = opened.ok;
        fin { wt.dnit(?child); }
        val stored: res[wt.Context, str] = wt.open(a, cache.ok);
        if (sel stored.err) { ret err[str].err{stored.err}; }
        var existing: wt.Context = stored.ok;
        fin { wt.dnit(?existing); }
        if (existing.repo.hash_len != child.repo.hash_len) { ret err[str].err{"dependency cache object format mismatch"}; }
        var p: pack.Pack;
        p.objects = vector.init[pack.Object](a);
        fin { pack.dnit(?p); }
        val head: res[object.Id, str] = wt.resolve(?child, "HEAD");
        if (sel head.err) { ret err[str].err{head.err}; }
        val gathered: err[str] = collect(?child, ?p, head.ok, true, 0);
        if (sel gathered.err) { ret gathered; }
        var names: Vector[str] = vector.init[str](a);
        fin { free_names(a, ?names); }
        val listed: err[str] = refs(?child, ?names);
        if (sel listed.err) { ret listed; }
        var i: usize = 0;
        for (i < names.len) {
            val id: res[object.Id, str] = wt.resolve(?child, names.data[i]);
            if (sel id.err) { ret err[str].err{id.err}; }
            val nested: err[str] = collect(?child, ?p, id.ok, true, 0);
            if (sel nested.err) { ret nested; }
            i = i + 1;
        }
        val copied: err[str] = store.write_pack(a, ?existing.repo, ?p);
        if (sel copied.err) { ret copied; }
        i = 0;
        for (i < names.len) {
            val id: res[object.Id, str] = wt.resolve(?child, names.data[i]);
            if (sel id.err) { ret err[str].err{id.err}; }
            var oid:        object.Id = id.ok;
            val copied_ref: err[str]  = write_ref(?existing, names.data[i], ?oid);
            if (sel copied_ref.err) { ret copied_ref; }
            i = i + 1;
        }
        val child_index: res[str, str] = store.join(a, child.repo.directory, "index");
        if (sel child_index.err) { ret err[str].err{child_index.err}; }
        val raw: res[Vector[u8], str] = store.read_bounded(a, child_index.ok, pack.MAX_TOTAL);
        str_free(a, child_index.ok);
        if (sel raw.err) { ret err[str].err{raw.err}; }
        var bytes: Vector[u8] = raw.ok;
        fin { vector.dnit[u8](?bytes); }
        val parsed: res[index.Index, str] = index.decode(a, bytes.data, bytes.len, child.repo.hash_len);
        if (sel parsed.err) { ret err[str].err{parsed.err}; }
        vector.dnit[index.Entry](?existing.staged.entries);
        existing.staged = parsed.ok;
        val indexed: err[str] = wt.save_index(?existing);
        if (sel indexed.err) { ret indexed; }
        var pin:    object.Id = head.ok;
        val pinned: err[str]  = write_ref(?existing, "HEAD", ?pin);
        if (sel pinned.err) { ret pinned; }
        val removed: err[fs.FsError] = fs.remove_all(a, marker.ok);
        if (sel removed.err) { ret err[str].err{"copied dependency metadata could not be removed"}; }
    }
    or {
        val ready: err[str] = parent_make(a, cache.ok);
        if (sel ready.err) { ret ready; }
        val moved: err[io_error.Error] = fs.rename(marker.ok, cache.ok);
        if (sel moved.err) { ret err[str].err{"dependency metadata cache move failed"}; }
    }
    val config: res[str, str] = store.join(a, cache.ok, "config");
    if (sel config.err) { ret err[str].err{config.err}; }
    fin { str_free(a, config.ok); }
    val worktree: res[str, str] = relative_path(a, cache.ok, destination);
    if (sel worktree.err) { ret err[str].err{worktree.err}; }
    val configured: err[str] = wt.config_set(a, config.ok, "core.worktree", worktree.ok, false);
    str_free(a, worktree.ok);
    if (sel configured.err) { ret configured; }
    val pointer: res[str, str] = relative_path(a, destination, cache.ok);
    if (sel pointer.err) { ret err[str].err{pointer.err}; }
    val content: res[str, format.FormatError] = format.sprint(a, "gitdir: {}\n", pointer.ok);
    str_free(a, pointer.ok);
    if (sel content.err) { ret err[str].err{"dependency Git pointer allocation refused"}; }
    val written: err[fs.FsError] = fs.replace_bytes_atomic(a, marker.ok, content.ok, str_len(content.ok), 420, 493);
    str_free(a, content.ok);
    if (sel written.err) { ret err[str].err{"dependency Git pointer write failed; metadata retained in module store"}; }
    ret err[str].ok{};
}
