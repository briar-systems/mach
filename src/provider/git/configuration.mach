# the Git configuration subset used for repository and dependency metadata

use mach.provider.git.protocol;
use A: std.allocator;
use std.collections.vector;
use std.collections.vector.Vector;
use std.format;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string;
use std.types.string.str;
use std.types.string.str_copy_slice;
use std.types.string.str_equals;
use std.types.string.str_len;

pub rec Pair   { section: str; subsection: str; key: str; value: str; }
pub rec Config { pairs: Vector[Pair]; }

pub fun dnit(a: *A.Allocator, c: *Config) {
    var i: usize = 0;
    for (i < c.pairs.len) {
        str_free(a, c.pairs.data[i].section);
        str_free(a, c.pairs.data[i].subsection);
        str_free(a, c.pairs.data[i].key);
        str_free(a, c.pairs.data[i].value);
        i = i + 1;
    }
    vector.dnit[Pair](?c.pairs);
}

pub fun copy(a: *A.Allocator, text: str) res[str, str] {
    val r: res[str, string.StrError] = str_copy_slice(a, text, 0, str_len(text));
    if (sel r.err) { ret res[str, str].err{"Git configuration allocation refused"}; }
    ret res[str, str].ok{r.ok};
}

fun slice(a: *A.Allocator, data: *u8, len: usize, fold: bool) res[str, str] {
    val allocated: res[*u8, A.Error] = A.allocate[u8](a, len + 1);
    if (sel allocated.err) { ret res[str, str].err{"Git configuration allocation refused"}; }
    var i: usize = 0;
    for (i < len) {
        var c: u8 = data[i];
        if (fold && c >= 'A' && c <= 'Z') { c = c + 32; }
        allocated.ok[i] = c;
        i               = i + 1;
    }
    allocated.ok[len] = 0;
    ret res[str, str].ok{allocated.ok::str};
}

fun value(a: *A.Allocator, data: *u8, len: usize) res[str, str] {
    var out: Vector[u8] = vector.init[u8](a);
    fin { vector.dnit[u8](?out); }
    var quoted: bool  = false;
    var end:    usize = 0;
    var i:      usize = 0;
    for (i < len) {
        var c: u8 = data[i];
        if (c == '"') {
            quoted = !quoted;
            i      = i + 1;
            cnt;
        }
        if (!quoted && (c == '#' || c == ';')) { brk; }
        if (c == '\\') {
            i = i + 1;
            if (i == len) { ret res[str, str].err{"continued Git configuration values are unsupported"}; }
            c = data[i];
            if (c == 'n')              { c = '\n'; }
            or (c == 't')              { c = '\t'; }
            or (c == 'b')              { c = 8; }
            or (c != '\\' && c != '"') { ret res[str, str].err{"invalid Git configuration escape"}; }
        }
        if (c == 0) { ret res[str, str].err{"nul in Git configuration"}; }
        val added: res[usize, A.Error] = vector.push[u8](?out, c);
        if (sel added.err)                                  { ret res[str, str].err{"Git configuration allocation refused"}; }
        if (quoted || (c != ' ' && c != '\t' && c != '\r')) { end = out.len; }
        i = i + 1;
    }
    if (quoted) { ret res[str, str].err{"unterminated Git configuration quote"}; }
    ret slice(a, out.data, end, false);
}

pub fun parse(a: *A.Allocator, data: *u8, len: usize) res[Config, str] {
    var c:    Config = Config{pairs: vector.init[Pair](a)};
    var keep: bool   = false;
    fin {
        if (!keep) { dnit(a, ?c); }
    }
    var section:    str = nil;
    var subsection: str = nil;
    fin {
        str_free(a, section);
        str_free(a, subsection);
    }
    var pos: usize = 0;
    for (pos < len) {
        var end: usize = pos;
        for (end < len && data[end] != '\n') { end = end + 1; }
        var start: usize = pos;
        pos = end + 1;
        for (start < end && (data[start] == ' ' || data[start] == '\t' || data[start] == '\r')) { start = start + 1; }
        if (start == end || data[start] == '#' || data[start] == ';') { cnt; }
        if (data[start] == '[') {
            var stop: usize = start + 1;
            for (stop < end && data[stop] != ']' && data[stop] != ' ' && data[stop] != '\t') { stop = stop + 1; }
            val sec: res[str, str] = slice(a, ?data[start + 1], stop - start - 1, true);
            if (sel sec.err) { ret res[Config, str].err{sec.err}; }
            str_free(a, section);
            section = sec.ok;
            str_free(a, subsection);
            subsection = nil;
            for (stop < end && (data[stop] == ' ' || data[stop] == '\t')) { stop = stop + 1; }
            if (stop == end) { ret res[Config, str].err{"invalid Git configuration section"}; }
            if (data[stop] == '"') {
                var close: usize = end;
                for (close > stop && data[close - 1] != ']') { close = close - 1; }
                if (close <= stop) { ret res[Config, str].err{"invalid Git configuration subsection"}; }
                val sub: res[str, str] = value(a, ?data[stop], close - stop - 1);
                if (sel sub.err) { ret res[Config, str].err{sub.err}; }
                subsection = sub.ok;
            }
            or (data[stop] != ']') { ret res[Config, str].err{"unsupported Git configuration section syntax"}; }
            cnt;
        }
        if (section == nil) { ret res[Config, str].err{"Git configuration key outside section"}; }
        var split: usize = start;
        for (split < end && data[split] != '=' && data[split] != ' ' && data[split] != '\t') { split = split + 1; }
        val key: res[str, str] = slice(a, ?data[start], split - start, true);
        if (sel key.err) { ret res[Config, str].err{key.err}; }
        var vpos: usize = split;
        for (vpos < end && (data[vpos] == ' ' || data[vpos] == '\t')) { vpos = vpos + 1; }
        var parsed: res[str, str] = res[str, str].err{"invalid Git configuration assignment"};
        if (vpos == end) { parsed = copy(a, "true"); }
        or (data[vpos] == '=') {
            vpos = vpos + 1;
            for (vpos < end && (data[vpos] == ' ' || data[vpos] == '\t')) { vpos = vpos + 1; }
            parsed = value(a, ?data[vpos], end - vpos);
        }
        if (sel parsed.err) {
            str_free(a, key.ok);
            ret res[Config, str].err{parsed.err};
        }
        val sec: res[str, str] = copy(a, section);
        if (sel sec.err) {
            str_free(a, key.ok);
            str_free(a, parsed.ok);
            ret res[Config, str].err{sec.err};
        }
        val sub: res[str, str] = copy(a, subsection);
        if (sel sub.err) {
            str_free(a, sec.ok);
            str_free(a, key.ok);
            str_free(a, parsed.ok);
            ret res[Config, str].err{sub.err};
        }
        val added: res[usize, A.Error] = vector.push[Pair](?c.pairs, Pair{section: sec.ok, subsection: sub.ok, key: key.ok, value: parsed.ok});
        if (sel added.err) {
            str_free(a, sec.ok);
            str_free(a, sub.ok);
            str_free(a, key.ok);
            str_free(a, parsed.ok);
            ret res[Config, str].err{"Git configuration allocation refused"};
        }
    }
    keep = true;
    ret res[Config, str].ok{c};
}

pub fun name(a: *A.Allocator, p: *Pair) res[str, str] {
    var r: res[str, format.FormatError];
    if (str_len(p.subsection) != 0) { r = format.sprint(a, "{}.{}.{}", p.section, p.subsection, p.key); }
    or                              { r = format.sprint(a, "{}.{}", p.section, p.key); }
    if (sel r.err)                  { ret res[str, str].err{"Git configuration allocation refused"}; }
    ret res[str, str].ok{r.ok};
}

pub fun get(a: *A.Allocator, c: *Config, key: str, all: bool) res[str, str] {
    var out: Vector[u8] = vector.init[u8](a);
    fin { vector.dnit[u8](?out); }
    var found: bool  = false;
    var i:     usize = 0;
    for (i < c.pairs.len) {
        val p: *Pair = ?c.pairs.data[i];
        i = i + 1;
        val n: res[str, str] = name(a, p);
        if (sel n.err) { ret n; }
        val matches: bool = str_equals(n.ok, key);
        str_free(a, n.ok);
        if (!matches) { cnt; }
        if (!all)     { out.len = 0; }
        if (all && found) {
            val newline: err[str] = protocol.append_bytes(?out, "\n", 1);
            if (sel newline.err) { ret res[str, str].err{newline.err}; }
        }
        val appended: err[str] = protocol.append_bytes(?out, p.value, str_len(p.value));
        if (sel appended.err) { ret res[str, str].err{appended.err}; }
        found = true;
    }
    if (!found) { ret res[str, str].err{"Git configuration key not found"}; }
    ret slice(a, out.data, out.len, false);
}

pub fun quoted(out: *Vector[u8], text: str) err[str] {
    val opening: err[str] = protocol.append_bytes(out, "\"", 1);
    if (sel opening.err) { ret opening; }
    var i: usize = 0;
    for (i < str_len(text)) {
        val c:      u8  = text[i];
        var escape: str = nil;
        if (c == '"')  { escape = "\\\""; }
        or (c == '\\') { escape = "\\\\"; }
        or (c == '\n') { escape = "\\n"; }
        or (c == '\t') { escape = "\\t"; }
        or (c == 8)    { escape = "\\b"; }
        if (escape != nil) {
            val r: err[str] = protocol.append_bytes(out, escape, 2);
            if (sel r.err) { ret r; }
        }
        or {
            val r: err[str] = protocol.append_bytes(out, ?text[i], 1);
            if (sel r.err) { ret r; }
        }
        i = i + 1;
    }
    ret protocol.append_bytes(out, "\"", 1);
}

pub fun encode(a: *A.Allocator, c: *Config) res[Vector[u8], str] {
    var out:  Vector[u8] = vector.init[u8](a);
    var keep: bool       = false;
    fin {
        if (!keep) { vector.dnit[u8](?out); }
    }
    var i: usize = 0;
    for (i < c.pairs.len) {
        val p: *Pair = ?c.pairs.data[i];
        i = i + 1;
        val head: res[str, format.FormatError] = format.sprint(a, "[{}", p.section);
        if (sel head.err) { ret res[Vector[u8], str].err{"Git configuration allocation refused"}; }
        val h: err[str] = protocol.append_bytes(?out, head.ok, str_len(head.ok));
        str_free(a, head.ok);
        if (sel h.err) { ret res[Vector[u8], str].err{h.err}; }
        if (str_len(p.subsection) != 0) {
            val space: err[str] = protocol.append_bytes(?out, " ", 1);
            if (sel space.err) { ret res[Vector[u8], str].err{space.err}; }
            val sub: err[str] = quoted(?out, p.subsection);
            if (sel sub.err) { ret res[Vector[u8], str].err{sub.err}; }
        }
        val key: res[str, format.FormatError] = format.sprint(a, "]\n\t{} = ", p.key);
        if (sel key.err) { ret res[Vector[u8], str].err{"Git configuration allocation refused"}; }
        val k: err[str] = protocol.append_bytes(?out, key.ok, str_len(key.ok));
        str_free(a, key.ok);
        if (sel k.err) { ret res[Vector[u8], str].err{k.err}; }
        val v: err[str] = quoted(?out, p.value);
        if (sel v.err) { ret res[Vector[u8], str].err{v.err}; }
        val n: err[str] = protocol.append_bytes(?out, "\n", 1);
        if (sel n.err) { ret res[Vector[u8], str].err{n.err}; }
    }
    keep = true;
    ret res[Vector[u8], str].ok{out};
}

#[testing]
use std.allocator.page;

test configuration__quoted_roundtrip_and_repeated_sections {
    var a: A.Allocator;
    page.make(?a);
    val input: str              = "[core]\n bare = false\n[submodule \"dep/a.b\"]\npath = \"dep/a.b\"\nurl = \"https://example.test/a\\\"b\" # comment\n[submodule \"dep/a.b\"]\npath = second\n";
    val read:  res[Config, str] = parse(?a, input, str_len(input));
    if (sel read.err) { ret 1; }
    var config: Config = read.ok;
    fin { dnit(?a, ?config); }
    val all: res[str, str] = get(?a, ?config, "submodule.dep/a.b.path", true);
    if (sel all.err) { ret 2; }
    fin { str_free(?a, all.ok); }
    if (!str_equals(all.ok, "dep/a.b\nsecond")) { ret 3; }
    val encoded: res[Vector[u8], str] = encode(?a, ?config);
    if (sel encoded.err) { ret 4; }
    var bytes: Vector[u8] = encoded.ok;
    fin { vector.dnit[u8](?bytes); }
    val again: res[Config, str] = parse(?a, bytes.data, bytes.len);
    if (sel again.err) { ret 5; }
    var restored: Config = again.ok;
    fin { dnit(?a, ?restored); }
    val url: res[str, str] = get(?a, ?restored, "submodule.dep/a.b.url", false);
    if (sel url.err) { ret 6; }
    fin { str_free(?a, url.ok); }
    if (!str_equals(url.ok, "https://example.test/a\"b")) { ret 7; }
}
