# bounded packet-line framing and Git delta reconstruction

use A: std.allocator;
use std.allocator.page;
use std.collections.vector;
use std.collections.vector.Vector;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

pub val MAX_PACKET: usize = 65520;

pub rec Packet {
    data:  *u8;
    len:   usize;
    flush: bool;
}

pub rec Reader {
    data: *u8;
    len:  usize;
    pos:  usize;
}

pub fun hex(c: u8) i32 {
    if (c >= '0' && c <= '9') { ret (c - '0')::i32; }
    if (c >= 'a' && c <= 'f') { ret (c - 'a' + 10)::i32; }
    if (c >= 'A' && c <= 'F') { ret (c - 'A' + 10)::i32; }
    ret -1;
}

# consume exactly one complete v0/v1 packet, rejecting reserved control lengths
pub fun next(r: *Reader) res[Packet, str] {
    if (r.pos > r.len || r.len - r.pos < 4 || r.data == nil) {
        ret res[Packet, str].err{"truncated Git packet header"};
    }
    var size: usize = 0;
    var i:    usize = 0;
    for (i < 4) {
        val n: i32 = hex(r.data[r.pos + i]);
        if (n < 0) { ret res[Packet, str].err{"invalid Git packet length"}; }
        size = size * 16 + n::usize;
        i    = i + 1;
    }
    if (size == 0) {
        r.pos = r.pos + 4;
        ret res[Packet, str].ok{Packet{data: nil, len: 0, flush: true}};
    }
    if (size < 4 || size > MAX_PACKET) { ret res[Packet, str].err{"invalid Git packet size"}; }
    if (size > r.len - r.pos)          { ret res[Packet, str].err{"truncated Git packet payload"}; }
    val p: Packet = Packet{data: ?r.data[r.pos + 4], len: size - 4, flush: false};
    r.pos = r.pos + size;
    ret res[Packet, str].ok{p};
}

pub fun append_bytes(out: *Vector[u8], data: *u8, len: usize) err[str] {
    var i: usize = 0;
    for (i < len) {
        val pushed: res[usize, A.Error] = vector.push[u8](out, data[i]);
        if (sel pushed.err) { ret err[str].err{"Git buffer allocation refused"}; }
        i = i + 1;
    }
    ret err[str].ok{};
}

# append a packet transactionally: allocation failure restores the prior length
pub fun append_packet(out: *Vector[u8], data: *u8, len: usize) err[str] {
    if (len > MAX_PACKET - 4 || (len != 0 && data == nil)) {
        ret err[str].err{"Git packet payload exceeds limit"};
    }
    val before: usize = out.len;
    val size:   usize = len + 4;
    val digits: str   = "0123456789abcdef";
    var header: [4]u8;
    var i:      usize = 0;
    for (i < 4) {
        header[i] = digits[(size >> ((3 - i) * 4)::u32) & 15];
        i         = i + 1;
    }
    val h: err[str] = append_bytes(out, ?header[0], 4);
    if (sel h.err) {
        out.len = before;
        ret h;
    }
    val p: err[str] = append_bytes(out, data, len);
    if (sel p.err) {
        out.len = before;
        ret p;
    }
    ret err[str].ok{};
}

pub fun append_flush(out: *Vector[u8]) err[str] {
    val before: usize    = out.len;
    val r:      err[str] = append_bytes(out, "0000", 4);
    if (sel r.err) { out.len = before; }
    ret r;
}

fun delta_size(r: *Reader) res[usize, str] {
    var size:  usize = 0;
    var shift: u32   = 0;
    for (r.pos < r.len) {
        val b: u8 = r.data[r.pos];
        r.pos = r.pos + 1;
        if (shift >= 64 || (b & 127)::usize > (0xffffffffffffffffu64::usize >> shift)) {
            ret res[usize, str].err{"Git delta size overflow"};
        }
        size = size | ((b & 127)::usize << shift);
        if ((b & 128) == 0) { ret res[usize, str].ok{size}; }
        shift = shift + 7;
    }
    ret res[usize, str].err{"truncated Git delta size"};
}

# reconstruct into a new owned vector, checking every source and output boundary
pub fun apply_delta(a: *A.Allocator, base: *u8, base_len: usize,
    delta: *u8, delta_len: usize, limit: usize) res[Vector[u8], str] {
    if ((base_len != 0 && base == nil) || (delta_len != 0 && delta == nil)) {
        ret res[Vector[u8], str].err{"missing Git delta bytes"};
    }
    var r:      Reader          = Reader{data: delta, len: delta_len, pos: 0};
    val source: res[usize, str] = delta_size(?r);
    if (sel source.err)        { ret res[Vector[u8], str].err{source.err}; }
    if (source.ok != base_len) { ret res[Vector[u8], str].err{"Git delta base size mismatch"}; }
    val target: res[usize, str] = delta_size(?r);
    if (sel target.err)    { ret res[Vector[u8], str].err{target.err}; }
    if (target.ok > limit) { ret res[Vector[u8], str].err{"Git delta output exceeds limit"}; }
    var out:  Vector[u8] = vector.init[u8](a);
    var keep: bool       = false;
    fin {
        if (!keep) { vector.dnit[u8](?out); }
    }
    for (r.pos < r.len) {
        val op: u8 = r.data[r.pos];
        r.pos = r.pos + 1;
        var data:  *u8   = nil;
        var count: usize = 0;
        if ((op & 128) != 0) {
            var offset: usize = 0;
            var bit:    u32   = 0;
            for (bit < 7) {
                if ((op & (1u8 << bit)) != 0) {
                    if (r.pos == r.len) { ret res[Vector[u8], str].err{"truncated Git delta copy"}; }
                    val b: usize = r.data[r.pos]::usize;
                    r.pos = r.pos + 1;
                    if (bit < 4) { offset = offset | (b << (bit * 8)); }
                    or           { count = count | (b << ((bit - 4) * 8)); }
                }
                bit = bit + 1;
            }
            if (count == 0) { count = 65536; }
            if (offset > base_len || count > base_len - offset) {
                ret res[Vector[u8], str].err{"Git delta copy outside base"};
            }
            data = ?base[offset];
        }
        or {
            count = op::usize;
            if (count == 0)            { ret res[Vector[u8], str].err{"reserved Git delta opcode"}; }
            if (count > r.len - r.pos) { ret res[Vector[u8], str].err{"truncated Git delta insert"}; }
            data  = ?r.data[r.pos];
            r.pos = r.pos + count;
        }
        if (count > target.ok - out.len) { ret res[Vector[u8], str].err{"Git delta exceeds declared output"}; }
        val copied: err[str] = append_bytes(?out, data, count);
        if (sel copied.err) { ret res[Vector[u8], str].err{copied.err}; }
    }
    if (out.len != target.ok) { ret res[Vector[u8], str].err{"Git delta output size mismatch"}; }
    keep = true;
    ret res[Vector[u8], str].ok{out};
}

test packet__binary_roundtrip_and_truncation {
    var a: A.Allocator;
    page.make(?a);
    var out: Vector[u8] = vector.init[u8](?a);
    fin { vector.dnit[u8](?out); }
    var data:     [3]u8    = [3]u8{'a', 0, 'b'};
    val appended: err[str] = append_packet(?out, ?data[0], 3);
    if (sel appended.err) { ret 1; }
    val flushed: err[str] = append_flush(?out);
    if (sel flushed.err) { ret 2; }
    var r:     Reader           = Reader{data: out.data, len: out.len, pos: 0};
    val first: res[Packet, str] = next(?r);
    if (sel first.err)                                                { ret 3; }
    if (first.ok.flush || first.ok.len != 3 || first.ok.data[1] != 0) { ret 4; }
    val end: res[Packet, str] = next(?r);
    if (sel end.err)                       { ret 5; }
    if (!end.ok.flush || r.pos != out.len) { ret 6; }
    var n: usize = 0;
    for (n < 7) {
        r.pos = 0;
        r.len = n;
        val truncated: res[Packet, str] = next(?r);
        if (sel truncated.ok) { ret 7; }
        if (r.pos != 0)       { ret 8; }
        n = n + 1;
    }
}

test delta__copy_insert_and_refusals {
    var a: A.Allocator;
    page.make(?a);
    var delta:   [10]u8               = [10]u8{5, 6, 0x90, 5, 1, '!', 0, 0, 0, 0};
    val decoded: res[Vector[u8], str] = apply_delta(?a, "hello", 5, ?delta[0], 6, 1024);
    if (sel decoded.err) { ret 1; }
    var out: Vector[u8] = decoded.ok;
    fin { vector.dnit[u8](?out); }
    if (out.len != 6 || out.data[0] != 'h' || out.data[5] != '!') { ret 2; }
    val small: res[Vector[u8], str] = apply_delta(?a, "hello", 5, ?delta[0], 6, 5);
    if (sel small.ok) { ret 3; }
    delta[3] = 6;
    val overrun: res[Vector[u8], str] = apply_delta(?a, "hello", 5, ?delta[0], 6, 1024);
    if (sel overrun.ok) { ret 4; }
    delta[3] = 5;
    val reserved: res[Vector[u8], str] = apply_delta(?a, "hello", 5, ?delta[0], 7, 1024);
    if (sel reserved.ok) { ret 5; }
}
