fun t_pack(data: *u8, len: usize, hash_len: usize, count: usize, expanded: bool) i32 {
    var a: A.Allocator;
    page.make(?a);
    val parsed: res[Pack, str] = decode(?a, data, len, hash_len);
    if (sel parsed.err) {
        print.eprintln(parsed.err);
        ret 1;
    }
    var p: Pack = parsed.ok;
    fin { dnit(?p); }
    if (p.objects.len != count) { ret 2; }
    if (expanded) {
        var found: bool  = false;
        var i:     usize = 0;
        for (i < p.objects.len) {
            val item: *Object = ?p.objects.data[i];
            if (item.bytes.len == 6 && item.bytes.data[5] == '!') { found = true; }
            i = i + 1;
        }
        if (!found) { ret 3; }
    }
    var n: usize = 0;
    for (n < len) {
        val truncated: res[Pack, str] = decode(?a, data, n, hash_len);
        if (sel truncated.ok) {
            var leaked: Pack = truncated.ok;
            dnit(?leaked);
            ret 4;
        }
        n = n + 1;
    }
    ret 0;
}

test pack__plain {
    ret t_pack(?T_PLAIN[0], 46, 20, 1, false);
}

test pack__offset {
    ret t_pack(?T_OFFSET[0], 62, 20, 2, true);
}

test pack__reference {
    ret t_pack(?T_REFERENCE[0], 81, 20, 2, true);
}

test pack__sha256 {
    ret t_pack(?T_SHA256[0], 58, 32, 1, false);
}
