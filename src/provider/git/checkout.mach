# materialize a verified object closure into a new Git-compatible checkout

use mach.provider.git.index;
use mach.provider.git.object;
use mach.provider.git.pack;
use mach.provider.git.protocol;
use mach.provider.git.store;
use A: std.allocator;
use std.collections.sort;
use std.collections.vector;
use std.collections.vector.Vector;
use fs: std.filesystem;
use std.format;
use io_error: std.io.error;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_compare;
use std.types.string.str_len;
use std.types.view;

pub fun commit(p: *pack.Pack, selected: *object.Id) res[object.Id, str] {
    var id:    object.Id = @selected;
    var depth: usize     = 0;
    for (depth < 8) {
        val item: *pack.Object = pack.find(p, ?id);
        if (item == nil)    { ret res[object.Id, str].err{"Git selected object is missing"}; }
        if (item.kind == 1) { ret res[object.Id, str].ok{id}; }
        if (item.kind != 4 || item.bytes.len < 8 + id.len * 2) {
            ret res[object.Id, str].err{"Git selector does not resolve to a commit"};
        }
        val prefix: str   = "object ";
        var i:      usize = 0;
        for (i < 7) {
            if (item.bytes.data[i] != prefix[i]) { ret res[object.Id, str].err{"invalid annotated Git tag"}; }
            i = i + 1;
        }
        if (item.bytes.data[7 + id.len * 2] != '\n') { ret res[object.Id, str].err{"invalid annotated Git tag object"}; }
        val parsed: res[object.Id, str] = object.parse_id(?item.bytes.data[7], id.len * 2);
        if (sel parsed.err) { ret parsed; }
        id    = parsed.ok;
        depth = depth + 1;
    }
    ret res[object.Id, str].err{"annotated Git tag chain exceeds limit"};
}

fun tree(p: *pack.Pack, id: *object.Id) res[object.Id, str] {
    val item: *pack.Object = pack.find(p, id);
    if (item == nil || item.kind != 1 || item.bytes.len < 6 + id.len * 2) {
        ret res[object.Id, str].err{"Git commit is missing or malformed"};
    }
    val prefix: str   = "tree ";
    var i:      usize = 0;
    for (i < 5) {
        if (item.bytes.data[i] != prefix[i]) { ret res[object.Id, str].err{"Git commit has no tree"}; }
        i = i + 1;
    }
    if (item.bytes.data[5 + id.len * 2] != '\n') { ret res[object.Id, str].err{"invalid Git commit tree ID"}; }
    ret object.parse_id(?item.bytes.data[5], id.len * 2);
}

fun link_safe(data: *u8, len: usize) bool {
    if (len == 0 || len > 8192 || data[0] == '/') { ret false; }
    var start: usize = 0;
    var i:     usize = 0;
    for (i <= len) {
        if (i == len || data[i] == '/') {
            val n: usize = i - start;
            if (n == 2 && data[start] == '.' && data[start + 1] == '.') {
                # parent traversal needs the compiler's complete symlink-chain verifier
                ret false;
            }
            or (n != 0 && !(n == 1 && data[start] == '.')) {
                if (n == 4 && data[start] == '.' && (data[start + 1] == 'g' || data[start + 1] == 'G')
                    && (data[start + 2] == 'i' || data[start + 2] == 'I') && (data[start + 3] == 't' || data[start + 3] == 'T')) { ret false; }
            }
            start = i + 1;
        }
        or (data[i] == 0 || data[i] == '\\' || data[i] == ':') { ret false; }
        i = i + 1;
    }
    ret true;
}

fun entry_compare(a: *index.Entry, b: *index.Entry) i64 {
    ret str_compare(a.name.data::str, b.name.data::str)::i64;
}

fun walk(a: *A.Allocator, p: *pack.Pack, root: str, relative: str, id: *object.Id,
    entries: *Vector[index.Entry], depth: usize) err[str] {
    if (depth > 128) { ret err[str].err{"Git tree nesting exceeds limit"}; }
    val item: *pack.Object = pack.find(p, id);
    if (item == nil || item.kind != 2) { ret err[str].err{"Git tree object missing"}; }
    var r: protocol.Reader = protocol.Reader{data: item.bytes.data, len: item.bytes.len, pos: 0};
    for (r.pos < r.len) {
        val parsed: res[store.TreeEntry, str] = store.tree_next(?r, id.len);
        if (sel parsed.err) { ret err[str].err{parsed.err}; }
        var entry: store.TreeEntry = parsed.ok;
        val named: res[str, str]   = store.join(a, relative, entry.name::str);
        if (sel named.err) { ret err[str].err{named.err}; }
        val name:      str  = named.ok;
        var keep_name: bool = false;
        fin {
            if (!keep_name) { str_free(a, name); }
        }
        if (str_len(name) > 8192) { ret err[str].err{"Git checkout path exceeds limit"}; }
        val full: res[str, str] = store.join(a, root, name);
        if (sel full.err) { ret err[str].err{full.err}; }
        fin { str_free(a, full.ok); }
        val existing: res[fs.Metadata, io_error.Error] = fs.metadata_link(full.ok);
        if (sel existing.ok)                         { ret err[str].err{"Git tree contains duplicate checkout path"}; }
        if (existing.err.kind != io_error.NOT_FOUND) { ret err[str].err{"Git checkout path inspection failed"}; }
        if (entry.mode == 0o40000 || entry.mode == 0o160000) {
            val made: err[io_error.Error] = fs.create_dir(full.ok, 493);
            if (sel made.err) { ret err[str].err{"Git checkout directory creation failed"}; }
            if (entry.mode == 0o40000) {
                val nested: err[str] = walk(a, p, root, name, ?entry.id, entries, depth + 1);
                if (sel nested.err) { ret nested; }
                cnt;
            }
        }
        or {
            val blob: *pack.Object = pack.find(p, ?entry.id);
            if (blob == nil || blob.kind != 3) { ret err[str].err{"Git checkout blob missing"}; }
            if (entry.mode == 0o120000) {
                if (!link_safe(blob.bytes.data, blob.bytes.len)) { ret err[str].err{"Git checkout symlink escapes its tree"}; }
                var target: Vector[u8] = vector.init[u8](a);
                fin { vector.dnit[u8](?target); }
                val copied: err[str] = protocol.append_bytes(?target, blob.bytes.data, blob.bytes.len);
                if (sel copied.err) { ret copied; }
                val terminated: res[usize, A.Error] = vector.push[u8](?target, 0);
                if (sel terminated.err) { ret err[str].err{"Git symlink target allocation refused"}; }
                val linked: err[io_error.Error] = fs.symlink(target.data::str, full.ok);
                if (sel linked.err) { ret err[str].err{"Git checkout symlink creation failed"}; }
            }
            or {
                var mode: i32 = 420;
                if (entry.mode == 0o100755) { mode = 493; }
                val written: err[fs.FsError] = fs.write_bytes(full.ok, blob.bytes.data, blob.bytes.len, mode);
                if (sel written.err) { ret err[str].err{"Git checkout file write failed"}; }
            }
        }
        if (entries.len == index.MAX_ENTRIES) { ret err[str].err{"Git checkout entry count exceeds limit"}; }
        var staged: index.Entry;
        staged.id   = entry.id;
        staged.mode = entry.mode;
        staged.name = view.view(name, str_len(name));
        val added: res[usize, A.Error] = vector.push[index.Entry](entries, staged);
        if (sel added.err) { ret err[str].err{"Git checkout index allocation refused"}; }
        keep_name = true;
    }
    ret err[str].ok{};
}

fun write_file(a: *A.Allocator, root: str, name: str, data: *u8, len: usize) err[str] {
    val full: res[str, str] = store.join(a, root, name);
    if (sel full.err) { ret err[str].err{full.err}; }
    val written: err[fs.FsError] = fs.write_bytes(full.ok, data, len, 420);
    str_free(a, full.ok);
    if (sel written.err) { ret err[str].err{"Git checkout metadata write failed"}; }
    ret err[str].ok{};
}

# destination must not exist; failure removes only the directory this call created
pub fun create(a: *A.Allocator, p: *pack.Pack, selected: *object.Id, destination: str) res[object.Id, str] {
    val chosen: res[object.Id, str] = commit(p, selected);
    if (sel chosen.err) { ret chosen; }
    var id:        object.Id           = chosen.ok;
    val root_tree: res[object.Id, str] = tree(p, ?id);
    if (sel root_tree.err) { ret root_tree; }
    var tree_id: object.Id           = root_tree.ok;
    val made:    err[io_error.Error] = fs.create_dir(destination, 493);
    if (sel made.err) { ret res[object.Id, str].err{"Git checkout destination must be a new directory"}; }
    var keep: bool = false;
    fin {
        if (!keep) { fs.remove_all(a, destination); }
    }
    var staged: index.Index;
    staged.entries = vector.init[index.Entry](a);
    fin {
        var i: usize = 0;
        for (i < staged.entries.len) {
            str_free(a, staged.entries.data[i].name.data::str);
            i = i + 1;
        }
        vector.dnit[index.Entry](?staged.entries);
    }
    val materialized: err[str] = walk(a, p, destination, "", ?tree_id, ?staged.entries, 0);
    if (sel materialized.err) { ret res[object.Id, str].err{materialized.err}; }
    val metadata: res[str, str] = store.join(a, destination, ".git");
    if (sel metadata.err) { ret res[object.Id, str].err{metadata.err}; }
    fin { str_free(a, metadata.ok); }
    val dirs: [3]str = [3]str{"objects", "refs/heads", "refs/tags"};
    var i:    usize  = 0;
    for (i < 3) {
        val full: res[str, str] = store.join(a, metadata.ok, dirs[i]);
        if (sel full.err) { ret res[object.Id, str].err{full.err}; }
        val dir: err[fs.FsError] = fs.create_dir_all(a, full.ok, 493);
        str_free(a, full.ok);
        if (sel dir.err) { ret res[object.Id, str].err{"Git metadata directory creation failed"}; }
        i = i + 1;
    }
    var repo:   store.Repository = store.Repository{directory: metadata.ok, hash_len: id.len};
    val stored: err[str]         = store.write_pack(a, ?repo, p);
    if (sel stored.err) { ret res[object.Id, str].err{stored.err}; }
    var configuration: str = "[core]\nrepositoryformatversion = 0\nbare = false\nfilemode = true\n";
    if (id.len == 32) { configuration = "[core]\nrepositoryformatversion = 1\nbare = false\nfilemode = true\n[extensions]\nobjectformat = sha256\n"; }
    val configured: err[str] = write_file(a, metadata.ok, "config", configuration, str_len(configuration));
    if (sel configured.err) { ret res[object.Id, str].err{configured.err}; }
    var hex: [65]u8;
    object.format_id(?id, ?hex[0]);
    val head: res[str, format.FormatError] = format.sprint(a, "{}\n", (?hex[0])::str);
    if (sel head.err) { ret res[object.Id, str].err{"Git HEAD allocation refused"}; }
    val pinned: err[str] = write_file(a, metadata.ok, "HEAD", head.ok, str_len(head.ok));
    str_free(a, head.ok);
    if (sel pinned.err) { ret res[object.Id, str].err{pinned.err}; }
    sort.sort_by[index.Entry](staged.entries.data, staged.entries.len, entry_compare);
    val encoded: res[Vector[u8], str] = index.encode(a, ?staged, id.len);
    if (sel encoded.err) { ret res[object.Id, str].err{encoded.err}; }
    var index_bytes: Vector[u8] = encoded.ok;
    fin { vector.dnit[u8](?index_bytes); }
    val indexed: err[str] = write_file(a, metadata.ok, "index", index_bytes.data, index_bytes.len);
    if (sel indexed.err) { ret res[object.Id, str].err{indexed.err}; }
    keep = true;
    ret res[object.Id, str].ok{id};
}
