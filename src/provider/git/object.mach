# public Git object IDs; SHA-1 is used only for Git format compatibility

use mach.provider.git.protocol;
use std.crypto.hash.sha256;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;

pub rec Id {
    bytes: [32]u8;
    len:   usize;
}

pub fun parse_id(data: *u8, len: usize) res[Id, str] {
    if (data == nil || (len != 40 && len != 64)) { ret res[Id, str].err{"invalid Git object ID length"}; }
    var id: Id;
    id.len = len / 2;
    var i: usize = 0;
    for (i < id.len) {
        val hi: i32 = protocol.hex(data[i * 2]);
        val lo: i32 = protocol.hex(data[i * 2 + 1]);
        if (hi < 0 || lo < 0) { ret res[Id, str].err{"invalid Git object ID digit"}; }
        id.bytes[i] = (hi * 16 + lo)::u8;
        i           = i + 1;
    }
    ret res[Id, str].ok{id};
}

# write a lowercase, nul-terminated ID to caller storage (at least 65 bytes)
pub fun format_id(id: *Id, out: *u8) bool {
    if (id == nil || out == nil || (id.len != 20 && id.len != 32)) { ret false; }
    val digits: str   = "0123456789abcdef";
    var i:      usize = 0;
    for (i < id.len) {
        out[i * 2]     = digits[(id.bytes[i] >> 4)::usize];
        out[i * 2 + 1] = digits[(id.bytes[i] & 15)::usize];
        i              = i + 1;
    }
    out[id.len * 2] = 0;
    ret true;
}

pub fun equal(a: *Id, b: *Id) bool {
    if (a.len != b.len || (a.len != 20 && a.len != 32)) { ret false; }
    var i: usize = 0;
    for (i < a.len) {
        if (a.bytes[i] != b.bytes[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

rec Sha1 {
    h:     [5]u32;
    block: [64]u8;
    used:  usize;
    total: u64;
}

fun rol(v: u32, n: u32) u32 {
    ret (v << n) | (v >> (32 - n));
}

fun sha1_init() Sha1 {
    var s: Sha1;
    s.h = [5]u32{0x67452301, 0xefcdab89, 0x98badcfe, 0x10325476, 0xc3d2e1f0};
    ret s;
}

fun sha1_block(s: *Sha1) {
    var w: [80]u32;
    var i: usize = 0;
    for (i < 16) {
        val p: usize = i * 4;
        w[i] = (s.block[p]::u32 << 24) | (s.block[p + 1]::u32 << 16)
            | (s.block[p + 2]::u32 << 8) | s.block[p + 3]::u32;
        i = i + 1;
    }
    for (i < 80) {
        w[i] = rol(w[i - 3] ^ w[i - 8] ^ w[i - 14] ^ w[i - 16], 1);
        i    = i + 1;
    }
    var a: u32 = s.h[0];
    var b: u32 = s.h[1];
    var c: u32 = s.h[2];
    var d: u32 = s.h[3];
    var e: u32 = s.h[4];
    i = 0;
    for (i < 80) {
        var f: u32 = b ^ c ^ d;
        var k: u32 = 0xca62c1d6;
        if (i < 20) {
            f = (b & c) | (~b & d);
            k = 0x5a827999;
        }
        or (i < 40) { k = 0x6ed9eba1; }
        or (i < 60) {
            f = (b & c) | (b & d) | (c & d);
            k = 0x8f1bbcdc;
        }
        val t: u32 = rol(a, 5) + f + e + k + w[i];
        e = d;
        d = c;
        c = rol(b, 30);
        b = a;
        a = t;
        i = i + 1;
    }
    s.h[0] = s.h[0] + a;
    s.h[1] = s.h[1] + b;
    s.h[2] = s.h[2] + c;
    s.h[3] = s.h[3] + d;
    s.h[4] = s.h[4] + e;
}

fun sha1_update(s: *Sha1, data: *u8, len: usize) {
    s.total = s.total + len::u64;
    var i: usize = 0;
    for (i < len) {
        s.block[s.used] = data[i];
        s.used          = s.used + 1;
        if (s.used == 64) {
            sha1_block(s);
            s.used = 0;
        }
        i = i + 1;
    }
}

fun sha1_final(s: *Sha1, out: *u8) {
    val bits: u64 = s.total * 8;
    s.block[s.used] = 128;
    s.used          = s.used + 1;
    if (s.used > 56) {
        for (s.used < 64) {
            s.block[s.used] = 0;
            s.used          = s.used + 1;
        }
        sha1_block(s);
        s.used = 0;
    }
    for (s.used < 56) {
        s.block[s.used] = 0;
        s.used          = s.used + 1;
    }
    var i: usize = 0;
    for (i < 8) {
        s.block[56 + i] = (bits >> ((7 - i) * 8)::u32)::u8;
        i               = i + 1;
    }
    sha1_block(s);
    i = 0;
    for (i < 20) {
        out[i] = (s.h[i / 4] >> ((3 - i % 4) * 8)::u32)::u8;
        i      = i + 1;
    }
}

pub fun digest(data: *u8, len: usize, hash_len: usize) res[Id, str] {
    if ((hash_len != 20 && hash_len != 32) || (len != 0 && data == nil)) {
        ret res[Id, str].err{"invalid Git hash input"};
    }
    var id: Id;
    id.len = hash_len;
    if (hash_len == 32) { sha256.hash(data, len, ?id.bytes[0]); }
    or {
        var state: Sha1 = sha1_init();
        sha1_update(?state, data, len);
        sha1_final(?state, ?id.bytes[0]);
    }
    ret res[Id, str].ok{id};
}

# hash the canonical type, decimal length, nul and payload
pub fun object_id(kind: str, data: *u8, len: usize, hash_len: usize) res[Id, str] {
    if ((hash_len != 20 && hash_len != 32) || (len != 0 && data == nil)) {
        ret res[Id, str].err{"invalid Git object input"};
    }
    if (!str_equals(kind, "blob") && !str_equals(kind, "tree") && !str_equals(kind, "commit") && !str_equals(kind, "tag")) {
        ret res[Id, str].err{"unsupported Git object type"};
    }
    var header:   [32]u8;
    val kind_len: usize = str_len(kind);
    if (kind_len == 0 || kind_len > 6) { ret res[Id, str].err{"invalid Git object type"}; }
    var i: usize = 0;
    for (i < kind_len) {
        header[i] = kind[i];
        i         = i + 1;
    }
    header[i] = ' ';
    i         = i + 1;
    var digits: [20]u8;
    var count:  usize = 0;
    var value:  usize = len;
    for {
        digits[count] = '0' + (value % 10)::u8;
        count         = count + 1;
        value         = value / 10;
        if (value == 0) { brk; }
    }
    for (count > 0) {
        count     = count - 1;
        header[i] = digits[count];
        i         = i + 1;
    }
    header[i] = 0;
    i         = i + 1;
    var id: Id;
    id.len = hash_len;
    if (hash_len == 32) {
        var s: sha256.State = sha256.init();
        sha256.update(?s, ?header[0], i);
        sha256.update(?s, data, len);
        sha256.final(?s, ?id.bytes[0]);
    }
    or {
        var s: Sha1 = sha1_init();
        sha1_update(?s, ?header[0], i);
        sha1_update(?s, data, len);
        sha1_final(?s, ?id.bytes[0]);
    }
    ret res[Id, str].ok{id};
}

test object_id__git_known_vectors {
    val empty: res[Id, str] = object_id("blob", nil, 0, 20);
    val hello: res[Id, str] = object_id("blob", "hello\n", 6, 20);
    val sha:   res[Id, str] = digest("abc", 3, 32);
    if (sel empty.err) { ret 1; }
    if (sel hello.err) { ret 2; }
    if (sel sha.err)   { ret 3; }
    val a: res[Id, str] = parse_id("e69de29bb2d1d6434b8b29ae775ad8c2e48c5391", 40);
    val b: res[Id, str] = parse_id("ce013625030ba8dba906f756967f9e9ca394464a", 40);
    val c: res[Id, str] = parse_id("ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad", 64);
    if (sel a.err) { ret 4; }
    if (sel b.err) { ret 5; }
    if (sel c.err) { ret 6; }
    var actual_a:   Id = empty.ok;
    var actual_b:   Id = hello.ok;
    var actual_c:   Id = sha.ok;
    var expected_a: Id = a.ok;
    var expected_b: Id = b.ok;
    var expected_c: Id = c.ok;
    if (!equal(?actual_a, ?expected_a)) { ret 7; }
    if (!equal(?actual_b, ?expected_b)) { ret 8; }
    if (!equal(?actual_c, ?expected_c)) { ret 9; }
}
