# read link payloads without following them when checking a Git work tree

use mach.provider.git.protocol;
use A: std.allocator;
use std.collections.vector;
use std.collections.vector.Vector;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

$if ($mach.build.os == $mach.os.darwin) {
    #[library("libSystem")]
    #[symbol("readlink")]
    ext fun bsd_readlink(pathname: *u8, buffer: *u8, capacity: usize) i64;
}

pub fun read(a: *A.Allocator, pathname: str) res[Vector[u8], str] {
    var buffer:   [8192]u8;
    val data:     *u8   = ?buffer[0];
    val capacity: usize = 8192;
    var count:    i64   = -1;
    $if ($mach.build.os == $mach.os.linux) {
        $if ($mach.build.arch == $mach.arch.x86_64) {
            asm x86_64 {
                mov rax, 89
                mov rdi, {pathname}
                mov rsi, {data}
                mov rdx, {capacity}
                syscall
                mov {count}, rax
            }
        }
        $or ($mach.build.arch == $mach.arch.aarch64) {
            asm aarch64 {
                mov x0, -100
                ldr x1, {pathname}
                ldr x2, {data}
                ldr x3, {capacity}
                mov x8, 78
                svc 0
                str x0, {count}
            }
        }
        $or ($mach.build.arch == $mach.arch.riscv64) {
            asm riscv64 {
                li a0, -100
                ld a1, {pathname}
                ld a2, {data}
                ld a3, {capacity}
                li a7, 78
                ecall
                sd a0, {count}
            }
        }
    }
    $or ($mach.build.os == $mach.os.darwin) { count = bsd_readlink(pathname, data, capacity); }
    if (count < 0 || count >= 8192)         { ret res[Vector[u8], str].err{"Git symlink payload could not be read"}; }
    var out:    Vector[u8] = vector.init[u8](a);
    val copied: err[str]   = protocol.append_bytes(?out, data, count::usize);
    if (sel copied.err) {
        vector.dnit[u8](?out);
        ret res[Vector[u8], str].err{copied.err};
    }
    ret res[Vector[u8], str].ok{out};
}
