pub rec Fetched {
    objects:  pack.Pack;
    selected: object.Id;
}

# fetch a selector's full closure and require its exact object to be present
pub fun fetch(a: *A.Allocator, repository: str, selector: str) res[Fetched, str] {
    val valid: err[str] = remote.validate_url(repository);
    if (sel valid.err) { ret res[Fetched, str].err{valid.err}; }
    # repository itself remains owned by the caller
    val info: res[str, format.FormatError] = format.sprint(a, "{}/info/refs?service=git-upload-pack", repository);
    if (sel info.err) { ret res[Fetched, str].err{"Git discovery URL allocation refused"}; }
    fin { str_free(a, info.ok); }
    val advertised: res[Vector[u8], str] = https.exchange(a, info.ok, false, nil, 0,
        "application/x-git-upload-pack-advertisement", remote.MAX_DISCOVERY);
    if (sel advertised.err) { ret res[Fetched, str].err{advertised.err}; }
    var bytes: Vector[u8] = advertised.ok;
    fin { vector.dnit[u8](?bytes); }
    val discovered: res[remote.Advertisement, str] = remote.discover(a, bytes.data, bytes.len);
    if (sel discovered.err) { ret res[Fetched, str].err{discovered.err}; }
    var ad: remote.Advertisement = discovered.ok;
    fin { vector.dnit[remote.Ref](?ad.refs); }
    val chosen: res[object.Id, str] = remote.select(?ad, selector);
    if (sel chosen.err) { ret res[Fetched, str].err{chosen.err}; }
    var wanted: object.Id            = chosen.ok;
    val built:  res[Vector[u8], str] = remote.request(a, ?ad, ?wanted);
    if (sel built.err) { ret res[Fetched, str].err{built.err}; }
    var request_body: Vector[u8] = built.ok;
    fin { vector.dnit[u8](?request_body); }
    val upload: res[str, format.FormatError] = format.sprint(a, "{}/git-upload-pack", repository);
    if (sel upload.err) { ret res[Fetched, str].err{"Git upload URL allocation refused"}; }
    fin { str_free(a, upload.ok); }
    val uploaded: res[Vector[u8], str] = https.exchange(a, upload.ok, true, request_body.data,
        request_body.len, "application/x-git-upload-pack-result", https.MAX_BODY);
    if (sel uploaded.err) { ret res[Fetched, str].err{uploaded.err}; }
    var response_body: Vector[u8] = uploaded.ok;
    fin { vector.dnit[u8](?response_body); }
    val unwrapped: res[Vector[u8], str] = remote.response(a, response_body.data, response_body.len,
        ad.sideband, pack.MAX_TOTAL);
    if (sel unwrapped.err) { ret res[Fetched, str].err{unwrapped.err}; }
    var packed: Vector[u8] = unwrapped.ok;
    fin { vector.dnit[u8](?packed); }
    val decoded: res[pack.Pack, str] = pack.decode(a, packed.data, packed.len, ad.hash_len);
    if (sel decoded.err) { ret res[Fetched, str].err{decoded.err}; }
    var result: pack.Pack = decoded.ok;
    if (pack.find(?result, ?wanted) == nil) {
        pack.dnit(?result);
        ret res[Fetched, str].err{"Git server did not send the requested object"};
    }
    ret res[Fetched, str].ok{Fetched{objects: result, selected: wanted}};
}

test https__public_repository_opt_in {
    var enabled:    [2]u8;
    val configured: res[opt[usize], env.EnvError] = env.get("MACH_GIT_HTTPS_TEST", ?enabled[0], 2);
    if (sel configured.err)     { ret 1; }
    if (sel configured.ok.none) { ret 0; }
    var a: A.Allocator;
    page.make(?a);
    val fetched: res[Fetched, str] = fetch(?a, "https://github.com/briar-systems/mach-sieve", "branch/main");
    if (sel fetched.err) {
        print.eprintln(fetched.err);
        ret 2;
    }
    var result: Fetched = fetched.ok;
    fin { pack.dnit(?result.objects); }
    if (result.objects.objects.len == 0) { ret 3; }
    var destination:   [8192]u8;
    val checkout_path: res[opt[usize], env.EnvError] = env.get("MACH_GIT_CHECKOUT_TEST", ?destination[0], 8192);
    if (sel checkout_path.err) { ret 4; }
    if (sel checkout_path.ok.some) {
        if (checkout_path.ok.some >= 8192) { ret 5; }
        val created: res[object.Id, str] = checkout.create(?a, ?result.objects, ?result.selected, (?destination[0])::str);
        if (sel created.err) {
            print.eprintln(created.err);
            ret 6;
        }
    }
}
