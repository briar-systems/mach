# the dependency manager behind `mach dep` and `mach init`. it reads a project's
# dependency closure from its manifests, resolves version ranges against the releases a
# source publishes, realizes every dependency flat under dep/ and records its pin, and
# checks a realized closure against all of it. a build never reaches it: the driver only
# locates what dep/ holds (compile/closure.mach).
#
# the closure engine (closure, resolve, edit, list, verify) works through three contracts,
# so a new source is a new member and not a new engine:
#
# - source.mach: where a dependency's releases and content come from
# - pin.mach: where a project records the revision each dependency is held at
# - report.mach: where progress, notes and failures go while it works
#
# git, under package/git, is the member of the first two and the one outside tool mach
# runs; path.mach realizes a dependency declared by a local path, and scratch.mach makes the
# temporary storage every part writes, released when the command ends. this module holds what
# every part shares: the slot layout under dep/ and the identity rule
use std.collections.sort;
use collections_vector: std.collections.vector;
use std.collections.vector.Vector;
use fs:         std.filesystem;
use std_format: std.format;
use io_error:   std.io.error;
use std.process.env;
use std.text.string.str_dup;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use types_path: std.types.path;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.OwnedString;
use std.types.string.owned_dnit;
use std.types.string.str;
use std.types.string.str_contains;
use std.types.string.str_len;

use A: std.allocator;

use diagnostic_kind: mach.base.diagnostic.kind;
use mach.base.fail;
use mach.base.intern;
use compile_closure: mach.compile.closure;
use compile_load:    mach.compile.load;
use mach.host.listing;
use manifest_load:   mach.manifest.load;
use manifest_model:  mach.manifest.model;
use manifest_schema: mach.manifest.schema;
use mach.session;

# free every name in a vector and then the vector itself
# ---
# alloc: the allocator that owns the names
# names: the vector to release
pub fun name_vector_dnit(alloc: *A.Allocator, names: *Vector[str]) {
    var i: usize = 0;
    for (i < names.len) {
        str_free(alloc, names.data[i]);
        i = i + 1;
    }
    collections_vector.dnit[str](names);
}

# the note naming one requirement a root declaration overrode, as `mach dep pull`, `update`,
# `add` and `verify` print it
# ---
# a:         allocates the note
# name:      the dependency identity
# declared:  the root's winning selector, as its manifest line spells it
# chain:     the requiring chain, ending at the dependency
# requested: the selector the chain asked for, in the same form
pub fun override_note(a: *A.Allocator, name: str, declared: str, chain: str, requested: str) res[str, fail.Fail] {
    val res_sprint: res[str, std_format.FormatError] = std_format.sprint(a,
        "dependency '{}' is declared by the root as {}, overriding {}, which requires {}. nothing checks that '{}' accepts the root's selection",
        name, declared, chain, requested, name);
    if (sel res_sprint.err) { ret res[str, fail.Fail].err{fail.message(fail.format_text(res_sprint.err))}; }
    ret res[str, fail.Fail].ok{res_sprint.ok};
}

# the source a manifest's `git` value names, as every git command and record reads it: a
# relative local path is resolved against the directory of the manifest that declares it, as
# a `path` is, and made absolute, since git runs in other directories than that one. a url
# (`scheme://`, or scp-like `host:path`) and an absolute path are kept as written
# ---
# a:            allocates the source, which the caller owns
# manifest_dir: the directory of the declaring manifest
# spelled:      the `git` value as written
# ret:          the source, err when the working directory cannot be read
pub fun git_source(a: *A.Allocator, manifest_dir: str, spelled: str) res[str, fail.Fail] {
    if (types_path.is_abs(spelled) || str_contains(spelled, "://") || scp_like(spelled)) {
        val res_kept: res[str, A.Error] = str_dup(a, spelled);
        if (sel res_kept.err) { ret res[str, fail.Fail].err{fail.refused(res_kept.err)}; }
        ret res[str, fail.Fail].ok{res_kept.ok};
    }
    val res_cwd: res[OwnedString, env.EnvError] = env.current_dir(a);
    if (sel res_cwd.err) { ret res[str, fail.Fail].err{fail.refusal(a, diagnostic_kind.FS_CURRENT_DIR, fail.Op{verb: "read", role: "the working directory"}, fail.Cause.env{res_cwd.err})}; }
    var cwd: OwnedString = res_cwd.ok;
    fin { owned_dnit(?cwd); }
    val res_base: res[str, A.Error] = types_path.resolve(a, cwd.data, manifest_dir);
    if (sel res_base.err) { ret res[str, fail.Fail].err{fail.refused(res_base.err)}; }
    fin { str_free(a, res_base.ok); }
    val res_joined: res[str, A.Error] = types_path.join(a, res_base.ok, spelled);
    if (sel res_joined.err) { ret res[str, fail.Fail].err{fail.refused(res_joined.err)}; }
    fin { str_free(a, res_joined.ok); }
    val res_cleaned: res[str, A.Error] = types_path.clean(a, res_joined.ok);
    if (sel res_cleaned.err) { ret res[str, fail.Fail].err{fail.refused(res_cleaned.err)}; }
    ret res[str, fail.Fail].ok{res_cleaned.ok};
}

# git's scp-like `[user@]host:path`: a colon before any slash
fun scp_like(spelled: str) bool {
    val n: usize = str_len(spelled);
    var i: usize = 0;
    for (i < n && spelled[i] != '/') {
        if (spelled[i] == ':') { ret true; }
        i = i + 1;
    }
    ret false;
}

# the ref a git line names, empty when it names none
pub fun ref_of(s: *session.Session, d: *manifest_model.DepDef) str {
    if (intern.str_is_nil(d.ref)) { ret ""; }
    ret intern.text(s.interner, d.ref);
}

# a realized nested dependency (`dep/<id>/dep/<x>/mach.toml`) is refused: the
# root owns the flat closure and a dependency's own dep/ is never realized.
# an empty directory git materializes for a consumed dependency's gitlink is not
# a realization and passes
pub fun refuse_nested_realization(s: *session.Session, alias: str, dep_dir: str) err[fail.Fail] {
    val res_nested: res[str, fail.Fail] = compile_load.join_path(s.build_alloc, dep_dir, compile_closure.DEP_DIR);
    if (sel res_nested.err) { ret err[fail.Fail].err{res_nested.err}; }
    val nested: str = res_nested.ok;
    fin { str_free(s.build_alloc, nested); }
    val res_is_dir: res[bool, io_error.Error] = fs.is_dir(nested);
    if (!(sel res_is_dir.ok && res_is_dir.ok)) { ret err[fail.Fail].ok{}; }
    val res_listed: res[Vector[fs.Listed], fs.FsError] = fs.read_dir(s.build_alloc, nested);
    if (sel res_listed.err) { ret err[fail.Fail].err{fail.refusal(s.build_alloc, diagnostic_kind.FS_READ, fail.Op{verb: "list", role: "the nested dependency root", path: nested}, fail.Cause.fs{res_listed.err})}; }
    var entries: Vector[fs.Listed] = res_listed.ok;
    fin { fs.listed_dnit(?entries); }
    val res_names: res[Vector[str], fail.Fail] = listing.names(s.build_alloc, nested, ?entries);
    if (sel res_names.err) { ret err[fail.Fail].err{res_names.err}; }
    var names: Vector[str] = res_names.ok;
    fin { collections_vector.dnit[str](?names); }
    var i: usize = 0;
    for (i < names.len) {
        val res_child: res[str, fail.Fail] = compile_load.join_path(s.build_alloc, nested, names.data[i]);
        if (sel res_child.err) { ret err[fail.Fail].err{res_child.err}; }
        val child:         str                 = res_child.ok;
        val res_join_path: res[str, fail.Fail] = compile_load.join_path(s.build_alloc, child, manifest_load.MANIFEST_FILE);
        str_free(s.build_alloc, child);
        if (sel res_join_path.err) { ret err[fail.Fail].err{res_join_path.err}; }
        val mf:         str                       = res_join_path.ok;
        val res_exists: res[bool, io_error.Error] = fs.exists(mf);
        str_free(s.build_alloc, mf);
        if (sel res_exists.ok && res_exists.ok) {
            val res_msg: res[str, std_format.FormatError] = std_format.sprint(s.build_alloc,
                "dependency '{}' has a nested realization at {}/{}/{}/{}, which is never used. delete {}/{}/{}",
                alias, compile_closure.DEP_DIR, alias, compile_closure.DEP_DIR, names.data[i], compile_closure.DEP_DIR, alias, compile_closure.DEP_DIR);
            if (sel res_msg.err) { ret err[fail.Fail].err{fail.format_refused(res_msg.err)}; }
            ret err[fail.Fail].err{fail.user(diagnostic_kind.DEP_NESTED, res_msg.ok)};
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# check that the manifest of a realized dependency declares the id it is realized under
# ---
# s:        the session whose allocator, interner and source map read the manifest
# dep_full: the dependency's root directory
# id:       the identity it is realized under, its directory name under dep/
# ret:      ok when the declared id matches, err when the manifest cannot be read, declares
#           no readable id or declares a different one
pub fun verify_dep_manifest_id(s: *session.Session, dep_full: str, id: str) err[fail.Fail] {
    val res_read_at: res[manifest_model.Manifest, fail.Fail] = manifest_load.read_at(s.build_alloc, s.interner, s.sources, dep_full);
    if (sel res_read_at.err) { ret err[fail.Fail].err{res_read_at.err}; }
    var parsed: manifest_model.Manifest = res_read_at.ok;
    fin { manifest_model.dnit(?parsed, s.build_alloc); }
    val opt_interner_entry: opt[str] = intern.get(s.interner, parsed.id);
    if (sel opt_interner_entry.none) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.DEP_NO_PROJECT_ID, "dependency manifest declares no readable project id")};
    }
    val declared: str = opt_interner_entry.some;
    ret compile_closure.check_dep_identity(s, id, declared);
}

# the path of a dependency's slot relative to the project root, `dep/<id>`
# ---
# alloc: allocates the path, which the caller owns
# id:    the dependency identity
# ret:   the relative path, err when it cannot be formatted
pub fun dep_rel_of(alloc: *A.Allocator, id: str) res[str, fail.Fail] {
    val res_sprint: res[str, std_format.FormatError] = std_format.sprint(alloc, "{}/{}", compile_closure.DEP_DIR, id);
    if (sel res_sprint.err) { ret res[str, fail.Fail].err{fail.message(fail.format_text(res_sprint.err))}; }
    ret res[str, fail.Fail].ok{res_sprint.ok};
}

# the path of a dependency's slot under a project root, `<root>/dep/<id>`
# ---
# alloc: allocates the path, which the caller owns
# root:  the project root
# id:    the dependency identity
# ret:   the joined path, err when it cannot be built
pub fun dep_full_of(alloc: *A.Allocator, root: str, id: str) res[str, fail.Fail] {
    val res_rel: res[str, fail.Fail] = dep_rel_of(alloc, id);
    if (sel res_rel.err) { ret res[str, fail.Fail].err{res_rel.err}; }
    val rel:      str                 = res_rel.ok;
    val res_full: res[str, fail.Fail] = compile_load.join_path(alloc, root, rel);
    str_free(alloc, rel);
    if (sel res_full.err) { ret res[str, fail.Fail].err{res_full.err}; }
    ret res[str, fail.Fail].ok{res_full.ok};
}

# a dependency slot is a directory under dep/ named by a valid project id
pub fun realized_ids(alloc: *A.Allocator, root: str) res[Vector[str], fail.Fail] {
    val res_dep_root: res[str, fail.Fail] = compile_load.join_path(alloc, root, compile_closure.DEP_DIR);
    if (sel res_dep_root.err) { ret res[Vector[str], fail.Fail].err{res_dep_root.err}; }
    val dep_root: str = res_dep_root.ok;
    fin { str_free(alloc, dep_root); }
    val res_is_dir: res[bool, io_error.Error] = fs.is_dir(dep_root);
    if (!(sel res_is_dir.ok && res_is_dir.ok)) { ret res[Vector[str], fail.Fail].ok{collections_vector.init[str](alloc)}; }
    val res_listed: res[Vector[fs.Listed], fs.FsError] = fs.read_dir(alloc, dep_root);
    if (sel res_listed.err) { ret res[Vector[str], fail.Fail].err{fail.refusal(alloc, diagnostic_kind.FS_READ, fail.Op{verb: "list", role: "the dependency root", path: dep_root}, fail.Cause.fs{res_listed.err})}; }
    var entries: Vector[fs.Listed] = res_listed.ok;
    fin { fs.listed_dnit(?entries); }
    var names:  Vector[str] = collections_vector.init[str](alloc);
    var handed: bool        = false;
    fin {
        if (!handed) { name_vector_dnit(alloc, ?names); }
    }
    var i: usize = 0;
    for (i < entries.len) {
        val entry: fs.Listed = entries.data[i];
        i = i + 1;
        # a name with no UTF-8 spelling is never a valid id, so like any other such name it is no slot
        var name: str = nil;
        if (sel entry.name)                       { name = entry.name; }
        or                                        { cnt; }
        if (!manifest_schema.is_project_id(name)) { cnt; }
        val res_full: res[str, fail.Fail] = compile_load.join_path(alloc, dep_root, name);
        if (sel res_full.err) { ret res[Vector[str], fail.Fail].err{res_full.err}; }
        val res_entry: res[bool, io_error.Error] = fs.is_dir(res_full.ok);
        str_free(alloc, res_full.ok);
        if (!(sel res_entry.ok && res_entry.ok)) { cnt; }
        val res_owned: res[str, A.Error] = str_dup(alloc, name);
        if (sel res_owned.err) { ret res[Vector[str], fail.Fail].err{fail.refused(res_owned.err)}; }
        val res_pushed: res[usize, A.Error] = collections_vector.push[str](?names, res_owned.ok);
        if (sel res_pushed.err) {
            str_free(alloc, res_owned.ok);
            ret res[Vector[str], fail.Fail].err{fail.refused(res_pushed.err)};
        }
    }
    sort.sort[str](names.data, names.len);
    handed = true;
    ret res[Vector[str], fail.Fail].ok{names};
}
