use std.runtime;
use std.types.size.usize;
use std.types.string.str;

use mach.cli.cmd.dispatch;
use mach.lang.stack;

rec Invocation {
    argc: usize;
    argv: *str;
    code: i64;
}

fun invoke(arg: *u8) {
    val inv: *Invocation = arg::*Invocation;
    inv.code = dispatch(inv.argc, inv.argv);
}

# reached only through its symbol, by the runtime's entry. the command runs on a
# stack the compiler sizes itself where the host has threads (mach.lang.stack)
#[symbol("main")]
fun main(argc: usize, argv: *str) i64 {
    var inv: Invocation = Invocation{argc: argc, argv: argv, code: 0};
    stack.run(invoke, (?inv)::*u8);
    ret inv.code;
}
