# module ids: a module's index in the session and the stable identity of its name
#
# the registry holds each loaded module's fully qualified name, whether it belongs to the root
# project, and the stable identity of its name, which outlives the loads that reuse it. a
# standalone editor buffer's module id lies past BUFFER_BASE, so a table keyed by module serves
# both.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.char.char;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_ends_with;
use std.types.string.str_len;
use std.types.view.View;
use std.types.view.view;

use A: std.allocator;
use std.collections.map;

use mach.base.fail;
use mach.base.intern;
use mach.base.role;

# a module's index in the session's module table
pub def ModuleId: u32;

pub val MODULE_NIL: ModuleId = 0xFFFFFFFF;

# a module's identity across the loads of a session, keyed by its fully qualified name
pub def StableModuleId: u32;

pub val STABLE_MODULE_NIL: StableModuleId = 0xFFFFFFFF;

# a project numbers its modules from 0 below BUFFER_BASE, and a standalone
# editor buffer's module is BUFFER_BASE past its file's index, so no project
# module takes a buffer's id and a table keyed by module serves both
pub val BUFFER_BASE: u32 = 0x80000000;

# the module of the standalone buffer over the file with index `file`, none
# past the last id the buffer range holds
pub fun buffer_id(file: u32) opt[ModuleId] {
    if (file >= MODULE_NIL - BUFFER_BASE) { ret opt[ModuleId].none{}; }
    ret opt[ModuleId].some{id(BUFFER_BASE + file)};
}

# the index of the file whose standalone buffer is the module `m`, none when
# `m` is a project's module or nil
pub fun buffer_file(m: ModuleId) opt[u32] {
    if (m < BUFFER_BASE || is_nil(m)) { ret opt[u32].none{}; }
    ret opt[u32].some{m - BUFFER_BASE};
}

# the module id with the given index
# ---
# index: the module's index in the session's module table
# ret:   the module id
pub fun id(index: u32) ModuleId {
    var m: ModuleId;
    m = index;
    ret m;
}

# the index a module id names
# ---
# m:   the module id
# ret: its index in the session's module table
pub fun index(m: ModuleId) u32 {
    ret m;
}

# whether two module ids name the same module
pub fun same(left: ModuleId, right: ModuleId) bool {
    ret left == right;
}

# whether a module id is MODULE_NIL
pub fun is_nil(m: ModuleId) bool {
    ret m == MODULE_NIL;
}

# the stable module identity with the given index
# ---
# index: the identity's number
# ret:   the stable identity
pub fun stable_id(index: u32) StableModuleId {
    var m: StableModuleId;
    m = index;
    ret m;
}

# the number a stable module identity holds
pub fun stable_index(m: StableModuleId) u32 {
    ret m;
}

# whether two stable identities are the same
pub fun stable_same(left: StableModuleId, right: StableModuleId) bool {
    ret left == right;
}

# whether a stable identity is STABLE_MODULE_NIL
pub fun stable_is_nil(m: StableModuleId) bool {
    ret m == STABLE_MODULE_NIL;
}

# the module name of a source path under a package: the id, then the path without its suffix, its separators dotted
pub fun compose_fqn(alloc: *A.Allocator, itn: *intern.Interner, id_text: str, rel_text: str) res[intern.StrId, fail.Fail] {
    val rel_stripped: View = strip_mach_suffix(rel_text);

    val id_len:  usize             = str_len(id_text);
    val total:   usize             = id_len + 1 + rel_stripped.len;
    val res_buf: res[*u8, A.Error] = A.allocate[u8](alloc, total);
    if (sel res_buf.err) { ret res[intern.StrId, fail.Fail].err{fail.refused(res_buf.err)}; }
    val buf: *u8 = res_buf.ok;

    var k: usize = 0;
    var j: usize = 0;
    for (j < id_len) {
        buf[k] = id_text[j];
        k      = k + 1;
        j      = j + 1;
    }
    buf[k] = '.';
    k      = k + 1;
    j      = 0;
    for (j < rel_stripped.len) {
        val c: u8 = rel_stripped.data[j];
        if (c == '/' || c == '\\') { buf[k] = '.'; }
        or                         { buf[k] = c; }
        k = k + 1;
        j = j + 1;
    }

    val res_bytes_add: res[intern.StrId, A.Error] = intern.bytes_add(itn, buf::str, k);
    A.deallocate[u8](alloc, buf, total);
    if (sel res_bytes_add.err) { ret res[intern.StrId, fail.Fail].err{fail.refused(res_bytes_add.err)}; }
    ret res[intern.StrId, fail.Fail].ok{res_bytes_add.ok};
}

fun strip_mach_suffix(s: str) View {
    val suffix: str   = ".mach";
    val s_len:  usize = str_len(s);
    if (!str_ends_with(s, suffix)) { ret view(s::*char, s_len); }
    ret view(s::*char, s_len - str_len(suffix));
}

# the identities of the modules a session loaded: each module's name, whether it
# belongs to the root project, and the stable identity of each name, which
# outlives the loads that reuse it
# ---
# count:         one past the highest project module id held; below BUFFER_BASE, so it
#                never wraps
# fqns:          each module's fully qualified name
# warned:        the modules whose warnings the build shows, declared by the loader as it gives
#                the module its id, from its package (`mach.compile.request.shows_warnings`).
#                the store and every pass whose only product is a warning read it here
# stable_ids:    the stable identity of each name
# stable_next:   the next stable identity to issue
# stable_to_mid: the module each stable identity is loaded as
pub rec Registry {
    count:         u32;
    fqns:          map.Map[ModuleId, intern.StrId];
    warned:        map.Map[ModuleId, bool];
    stable_ids:    map.Map[intern.StrId, StableModuleId];
    stable_next:   StableModuleId;
    stable_to_mid: map.Map[StableModuleId, ModuleId];
}

# an empty registry
# ---
# a:   the allocator its maps draw from
# ret: the registry, released with `registry_dnit`
pub fun registry_init(a: *A.Allocator) Registry {
    ret Registry{
        count:         0,
        fqns:          map.init[ModuleId, intern.StrId](a),
        warned:        map.init[ModuleId, bool](a),
        stable_ids:    map.init[intern.StrId, StableModuleId](a),
        stable_next:   stable_id(0),
        stable_to_mid: map.init[StableModuleId, ModuleId](a)
    };
}

# release the registry's maps
pub fun registry_dnit(r: *Registry) {
    r.count = 0;
    map.dnit[ModuleId, intern.StrId](?r.fqns);
    map.dnit[ModuleId, bool](?r.warned);
    map.dnit[intern.StrId, StableModuleId](?r.stable_ids);
    map.dnit[StableModuleId, ModuleId](?r.stable_to_mid);
}

# forget every project module identity, keeping the stable identities, which outlive a load
pub fun reset_module_registry(r: *Registry) {
    r.count = 0;

    map.clear[ModuleId, intern.StrId](?r.fqns);
    map.clear[ModuleId, bool](?r.warned);

    map.clear[StableModuleId, ModuleId](?r.stable_to_mid);
}

# one past the highest project module id the registry holds an identity for
pub fun module_count(r: *Registry) u32 {
    ret r.count;
}

fun register_module_fqn(r: *Registry, mid: ModuleId, fqn: intern.StrId) err[fail.Fail] {
    val res_insert: res[bool, A.Error] = map.insert[ModuleId, intern.StrId](?r.fqns, mid, fqn);
    if (sel res_insert.err) { ret err[fail.Fail].err{fail.refused(res_insert.err)}; }
    ret err[fail.Fail].ok{};
}

# the build shows the warnings of the module `mid`, as its package's `warned` declares
pub fun register_module_warned(r: *Registry, mid: ModuleId, warned: bool) err[fail.Fail] {
    $if (role.CHECKED) { role.touched(role.MODULES, nil); }

    val res_insert: res[bool, A.Error] = map.insert[ModuleId, bool](?r.warned, mid, warned);
    if (sel res_insert.err) { ret err[fail.Fail].err{fail.refused(res_insert.err)}; }
    ret err[fail.Fail].ok{};
}

# whether the build shows the warnings of the module `mid`. a module the loader never declared,
# as a standalone editor buffer's, belongs to no project, and its warning-only passes do not run
pub fun module_warned(r: *Registry, mid: ModuleId) bool {
    if (is_nil(mid)) { ret false; }
    val opt_get: opt[*bool] = map.get[ModuleId, bool](?r.warned, ?mid);
    if (sel opt_get.some) { ret @opt_get.some; }
    ret false;
}

# the fully qualified name of a module
# ---
# r:   the registry
# mid: the module
# ret: its name, or STR_NIL when `mid` is nil or has no identity registered
pub fun module_fqn(r: *Registry, mid: ModuleId) intern.StrId {
    if (is_nil(mid)) { ret intern.STR_NIL; }
    val opt_get: opt[*intern.StrId] = map.get[ModuleId, intern.StrId](?r.fqns, ?mid);
    if (sel opt_get.some) {
        ret @opt_get.some;
    }
    ret intern.STR_NIL;
}

# the stable identity of a name, issuing the next one when the name has none yet
# ---
# r:   the registry
# fqn: the module's fully qualified name
# ret: the identity, or a failure when identities are exhausted or the map refuses the insert
pub fun stable_module_id(r: *Registry, fqn: intern.StrId) res[StableModuleId, fail.Fail] {
    $if (role.CHECKED) { role.touched(role.MODULES, nil); }

    val opt_get: opt[*StableModuleId] = map.get[intern.StrId, StableModuleId](?r.stable_ids, ?fqn);
    if (sel opt_get.some) {
        ret res[StableModuleId, fail.Fail].ok{@opt_get.some};
    }

    if (stable_is_nil(r.stable_next)) {
        ret res[StableModuleId, fail.Fail].err{fail.message("stable module identities are exhausted")};
    }
    val issued:     StableModuleId     = r.stable_next;
    val res_insert: res[bool, A.Error] = map.insert[intern.StrId, StableModuleId](?r.stable_ids, fqn, issued);
    if (sel res_insert.err) {
        ret res[StableModuleId, fail.Fail].err{fail.refused(res_insert.err)};
    }
    r.stable_next = stable_id(stable_index(r.stable_next) + 1);
    ret res[StableModuleId, fail.Fail].ok{issued};
}

# the stable identity already issued for a name, without issuing one
# ---
# r:   the registry
# fqn: the module's fully qualified name
# ret: the identity, or STABLE_MODULE_NIL when the name has none
pub fun stable_module_id_lookup(r: *Registry, fqn: intern.StrId) StableModuleId {
    val opt_get: opt[*StableModuleId] = map.get[intern.StrId, StableModuleId](?r.stable_ids, ?fqn);
    if (sel opt_get.some) {
        ret @opt_get.some;
    }
    ret STABLE_MODULE_NIL;
}

# record the module a stable identity is loaded as
# ---
# r:      the registry
# stable: the stable identity
# mid:    the module it is loaded as, replacing any earlier one
# ret:    ok, or a failure when the map refuses the insert
pub fun register_stable_mid(r: *Registry, stable: StableModuleId, mid: ModuleId) err[fail.Fail] {
    $if (role.CHECKED) { role.touched(role.MODULES, nil); }

    val res_insert: res[bool, A.Error] = map.insert[StableModuleId, ModuleId](?r.stable_to_mid, stable, mid);
    if (sel res_insert.err) { ret err[fail.Fail].err{fail.refused(res_insert.err)}; }
    ret err[fail.Fail].ok{};
}

# the module a stable identity is loaded as
# ---
# r:      the registry
# stable: the stable identity
# ret:    the module, or MODULE_NIL when `stable` is nil or not loaded
pub fun module_id_for_stable(r: *Registry, stable: StableModuleId) ModuleId {
    if (stable_is_nil(stable)) { ret MODULE_NIL; }
    val opt_get: opt[*ModuleId] = map.get[StableModuleId, ModuleId](?r.stable_to_mid, ?stable);
    if (sel opt_get.some) {
        ret @opt_get.some;
    }
    ret MODULE_NIL;
}

# give the module `mid` its name and stable identity; a project's module also
# counts toward module_count, a standalone buffer's does not
pub fun register_module_identity(r: *Registry, mid: ModuleId, fqn: intern.StrId, stable: StableModuleId) err[fail.Fail] {
    if (is_nil(mid)) { ret err[fail.Fail].err{fail.message("a module identity needs a module id")}; }
    var key:                     ModuleId       = mid;
    val err_register_module_fqn: err[fail.Fail] = register_module_fqn(r, mid, fqn);
    if (sel err_register_module_fqn.err) { ret err_register_module_fqn; }
    val err_register_stable_mid: err[fail.Fail] = register_stable_mid(r, stable, mid);
    if (sel err_register_stable_mid.err) {
        map.remove[ModuleId, intern.StrId](?r.fqns, ?key);
        ret err_register_stable_mid;
    }
    val opt_buffer: opt[u32] = buffer_file(mid);
    if (sel opt_buffer.none && index(mid) >= r.count) { r.count = index(mid) + 1; }
    ret err[fail.Fail].ok{};
}

# forget a module's name, warning flag and the load of its stable identity
# the stable identity itself stays issued, and module_count is left as it was
# ---
# r:      the registry
# mid:    the module to forget
# stable: the stable identity it was loaded as
pub fun unregister_module_identity(r: *Registry, mid: ModuleId, stable: StableModuleId) {
    var key:  ModuleId       = mid;
    var skey: StableModuleId = stable;
    map.remove[ModuleId, intern.StrId](?r.fqns, ?key);
    map.remove[ModuleId, bool](?r.warned, ?key);
    map.remove[StableModuleId, ModuleId](?r.stable_to_mid, ?skey);
}
