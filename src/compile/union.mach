# the union build's targets, under which every gate is decided, and every artifact's entry
#
# a target whose facts cannot be assembled is skipped with a warning. an artifact the
# selected target does not build is foreign: its entry loads so the modules only it
# reaches are known and left out of the compiled set.

use std_format: std.format;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;

use mach.base.diagnostic;
use diagnostic_kind: mach.base.diagnostic.kind;
use mach.base.fail;
use mach.base.growth;
use mach.base.intern;
use front_load: mach.front.load;
use mach.session.module;

use mach.target.assembled;
use target_facts: mach.target.facts;
use mach.target.resolved;

use mach.compile.project;
use manifest_artifact: mach.manifest.artifact;
use manifest_model:    mach.manifest.model;
use manifest_target:   mach.manifest.target;

fun warn_union_target_skipped(p: *project.Project, os_name: str, isa_name: str, why: str) {
    val res_msg: res[str, std_format.FormatError] = std_format.sprint(p.alloc, "target '{}-{}' cannot be built here and is skipped in multi-target analysis ({})", os_name, isa_name, why);
    if (sel res_msg.err) { ret; }
    val buf: str = res_msg.ok;

    diagnostic.record_unlocated(?p.diags, diagnostic_kind.TARGET_SKIPPED, buf);

    str_free(p.alloc, buf);
}

# the facts a program reads of the declared target `td`, as mirl assembles it
fun facts_of(p: *project.Project, td: *manifest_model.TargetDef) res[target_facts.Facts, fail.Fail] {
    val res_resolve_declared: res[resolved.Target, fail.Fail] = manifest_target.resolve_declared(p.s.alloc, p.s.interner, td, intern.STR_NIL, nil);
    if (sel res_resolve_declared.err) { ret res[target_facts.Facts, fail.Fail].err{res_resolve_declared.err}; }
    var selected: resolved.Target                      = res_resolve_declared.ok;
    val res_made: res[*assembled.Assembled, fail.Fail] = assembled.assemble(p.s.alloc, ?selected);
    if (sel res_made.err) { ret res[target_facts.Facts, fail.Fail].err{res_made.err}; }
    fin { assembled.dnit(p.s.alloc, res_made.ok); }
    ret target_facts.of(p.s.alloc, res_made.ok, ?selected);
}

# make the project's loader a union build over every target the manifest declares
# a target whose facts cannot be resolved or assembled is skipped with a TARGET_SKIPPED warning,
# and the loader takes ownership of the tuple array. a manifest with no targets leaves the loader as it is
# ---
# p:   the project whose loader takes the tuples
# m:   the manifest whose targets are read
# ret: ok, or the failure when the tuple array cannot be allocated
pub fun populate_union_tuples(p: *project.Project, m: *manifest_model.Manifest) err[fail.Fail] {
    val n: u32 = m.target_count;
    if (n == 0) { ret err[fail.Fail].ok{}; }
    val res_allocate: res[*front_load.Tuple, A.Error] = A.allocate[front_load.Tuple](p.alloc, n::usize);
    if (sel res_allocate.err) { ret err[fail.Fail].err{fail.refused(res_allocate.err)}; }
    val tuples: *front_load.Tuple = res_allocate.ok;
    var k:      u32               = 0;
    var fill:   u32               = 0;
    for (k < n) {
        val td:           *manifest_model.TargetDef          = ?m.targets[k];
        val os_name:      str                                = intern.text(p.s.interner, td.sys);
        val isa_name:     str                                = intern.text(p.s.interner, td.arch);
        val res_facts_of: res[target_facts.Facts, fail.Fail] = facts_of(p, td);
        if (sel res_facts_of.err) {
            warn_union_target_skipped(p, os_name, isa_name, fail.describe(res_facts_of.err));
        }
        if (sel res_facts_of.ok) {
            tuples[fill].target        = res_facts_of.ok;
            tuples[fill].os_name       = td.sys;
            tuples[fill].isa_name      = td.arch;
            tuples[fill].abi_name      = td.abi;
            tuples[fill].platform_name = td.platform;
            fill                       = fill + 1;
        }
        k = k + 1;
    }
    front_load.tuples_set(?p.loader, tuples, fill, n);
    ret err[fail.Fail].ok{};
}

# the artifact entries of this project, split by whether the selected target builds them:
# an artifact this target does not declare is another target's, and the modules only it
# reaches are not this build's to compile. each entry carries its artifact, the one the
# modules its walk first reaches are attributed to; two artifacts sharing an entry keep
# the first in manifest order
pub fun populate_union_entries(p: *project.Project, m: *manifest_model.Manifest) err[fail.Fail] {
    if (m.artifact_count == 0) { ret err[fail.Fail].ok{}; }

    var cap: u32 = m.artifact_count;

    val res_allocate: res[*project.ArtifactEntry, A.Error] = A.allocate[project.ArtifactEntry](p.alloc, cap::usize);
    if (sel res_allocate.err) { ret err[fail.Fail].err{fail.refused(res_allocate.err)}; }
    val entries:        *project.ArtifactEntry = res_allocate.ok;
    var entries_handed: bool                   = false;
    fin {
        if (!entries_handed) { A.deallocate[project.ArtifactEntry](p.alloc, entries, cap::usize); }
    }

    val res_allocate_alloc: res[*project.ArtifactEntry, A.Error] = A.allocate[project.ArtifactEntry](p.alloc, cap::usize);
    if (sel res_allocate_alloc.err) { ret err[fail.Fail].err{fail.refused(res_allocate_alloc.err)}; }
    val foreign:        *project.ArtifactEntry = res_allocate_alloc.ok;
    var foreign_handed: bool                   = false;
    fin {
        if (!foreign_handed) { A.deallocate[project.ArtifactEntry](p.alloc, foreign, cap::usize); }
    }

    val opt_interner_entry: opt[str] = intern.get(p.s.interner, p.config.id);
    if (sel opt_interner_entry.none) { ret err[fail.Fail].err{fail.message("union project id not interned")}; }
    val id_text: str = opt_interner_entry.some;

    var selected: intern.StrId = intern.STR_NIL;
    if (p.target_entry != nil) { selected = p.target_entry.name; }

    var w: u32 = 0;
    var f: u32 = 0;
    var k: u32 = 0;
    for (k < m.artifact_count) {
        val a:    *manifest_model.ArtifactDef = ?m.artifacts[k];
        var into: *project.ArtifactEntry      = entries;
        var at:   *u32                        = ?w;
        if (!intern.str_is_nil(selected) && !manifest_artifact.artifact_supports_target(p.s.interner, a, selected)) {
            into = foreign;
            at   = ?f;
        }
        val res_add_union_entry: res[u32, fail.Fail] = add_union_entry(p, into, @at, cap, id_text, a);
        if (sel res_add_union_entry.err) { ret err[fail.Fail].err{res_add_union_entry.err}; }
        @at = res_add_union_entry.ok;
        k   = k + 1;
    }

    entries_handed = true;
    val err_kept: err[fail.Fail] = keep_entries(p, entries, w, cap, ?p.union_entries, ?p.union_entry_count);
    if (sel err_kept.err) { ret err_kept; }
    foreign_handed = true;
    ret keep_entries(p, foreign, f, cap, ?p.foreign_entries, ?p.foreign_entry_count);
}

# hand a filled entry array to the project at its final length
fun keep_entries(p: *project.Project, entries: *project.ArtifactEntry, used: u32, cap: u32,
    out: **project.ArtifactEntry, out_count: *u32) err[fail.Fail] {
    @out       = nil;
    @out_count = 0;
    var kept:       *project.ArtifactEntry = entries;
    var kept_cap:   u32                    = cap;
    val err_fitted: err[A.Error]           = growth.resize[project.ArtifactEntry](p.alloc, ?kept, ?kept_cap, used::usize);
    if (sel err_fitted.err) {
        A.deallocate[project.ArtifactEntry](p.alloc, entries, cap::usize);
        ret err[fail.Fail].err{fail.refused(err_fitted.err)};
    }
    @out       = kept;
    @out_count = used;
    ret err[fail.Fail].ok{};
}

fun add_union_entry(p: *project.Project, entries: *project.ArtifactEntry, w: u32, cap: u32, id_text: str, a: *manifest_model.ArtifactDef) res[u32, fail.Fail] {
    val opt_interner_entry: opt[str] = intern.get(p.s.interner, a.entry);
    if (sel opt_interner_entry.none) { ret res[u32, fail.Fail].err{fail.message("union artifact entry not interned")}; }
    val res_fqn: res[intern.StrId, fail.Fail] = module.compose_fqn(p.alloc, p.s.interner, id_text, opt_interner_entry.some);
    if (sel res_fqn.err) { ret res[u32, fail.Fail].err{res_fqn.err}; }
    val fqn: intern.StrId = res_fqn.ok;

    var i: u32 = 0;
    for (i < w) {
        if (intern.str_same(entries[i].fqn, fqn)) { ret res[u32, fail.Fail].ok{w}; }
        i = i + 1;
    }
    if (w >= cap) { ret res[u32, fail.Fail].err{fail.message("union entry count exceeded capacity")}; }
    entries[w] = project.ArtifactEntry{fqn: fqn, artifact: a.name, kind: a.kind, at: a.entry_at};
    ret res[u32, fail.Fail].ok{w + 1};
}
