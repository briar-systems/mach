# the texts of a unit a build writes beside its object when `--emit` names them: mirl's text of
# the module mach lowered and masc's listing of the object. each is a row of VIEWS, which every
# layer reads, so a new view is one row, and a new case of Source where mirl writes it from a
# stream of its own

use std.types.bool.bool;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use io_writer: std.io.writer;

use mach.host.output.layout;

# where a view's text is taken from
# ---
# lowered: the module mach hands mirl, which mach prints before mirl compiles it
# listing: masc's listing of the object, which mirl writes as its back end makes it
pub tag Source: u8 {
    lowered;
    listing;
}

# one view of a unit
# ---
# name:   the value `--emit` takes
# tree:   the tree of the work directory its files are written in, one a module, by the module's path
# ext:    the extension of each file
# source: where its text is taken from
pub rec View {
    name:   str;
    tree:   str;
    ext:    str;
    source: Source;
}

# a set of views, bit `i` for the view at VIEWS[i]
pub def Set: u8;

# the empty set
pub val NONE: Set = 0;

# the views a build can write
pub val COUNT: usize = 2;

# every view, in the order `--emit` lists them
pub val VIEWS: [COUNT]View = [COUNT]View{
    View{name: "ir", tree: layout.IR, ext: "ir", source: Source.lowered{}},
    View{name: "asm", tree: layout.ASM, ext: "s", source: Source.listing{}},
};

# the texts mirl writes as it compiles a unit, each where a view of it asks: masc's listing of the
# object
pub rec Streams {
    listing: opt[*io_writer.Writer];
}

# no text written as mirl compiles
pub val UNSTREAMED: Streams = Streams{listing: opt[*io_writer.Writer].none{}};

# a path for each view, none of them written
pub fun unwritten() [COUNT]str {
    var paths: [COUNT]str;
    var i:     usize = 0;
    for (i < COUNT) {
        paths[i] = "";
        i        = i + 1;
    }
    ret paths;
}

# the view `name` names, none for none
pub fun named(name: str) opt[usize] {
    var i: usize = 0;
    for (i < COUNT) {
        if (str_equals(VIEWS[i].name, name)) { ret opt[usize].some{i}; }
        i = i + 1;
    }
    ret opt[usize].none{};
}

# the set holding the view at VIEWS[i] alone
pub fun only(i: usize) Set {
    ret (1::u8 << i::u8)::Set;
}

# whether `s` holds the view at VIEWS[i]
pub fun has(s: Set, i: usize) bool {
    ret (s & only(i)) != 0;
}

# whether mirl writes the view at VIEWS[i] as it compiles, rather than mach before it
pub fun streamed(i: usize) bool {
    val src: Source = VIEWS[i].source;
    ret !(sel src.lowered);
}

# the texts `writers` name, one a view in the order of VIEWS, as mirl's options take them
pub fun streams(writers: [COUNT]opt[*io_writer.Writer]) Streams {
    var s: Streams = UNSTREAMED;
    var i: usize   = 0;
    for (i < COUNT) {
        val src: Source = VIEWS[i].source;
        if (sel src.listing) { s.listing = writers[i]; }
        i = i + 1;
    }
    ret s;
}
