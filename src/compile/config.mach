# the program `mach run` launches
# ---
# path:          the built executable, or `-o`
# host_runnable: the target's os and isa are the host's
# target_name:   the target's declared name
# runner:        the runner the target declares, none when it declares none
pub rec RunArtifact {
    path:          str;
    host_runnable: bool;
    target_name:   str;
    runner:        runner.Runner;
}

# the built executable `mach run` launches: the one (artifact, target, profile)
# the selectors name, which must be a `bin`
# ---
# alloc:           owns the result and every message
# project_root:    the project root
# selectors:       the `-a`, `-t` and `-p` patterns; an artifact axis given none takes the sole `bin`
# output_override: `-o`, the path to run instead of the artifact's output, or nil
# sources:         receives the manifest's text, which a refusal points into
# ret:             the executable; err from the manifest or selection, when the selection
#                  names several cells or a library, or for an unusable `-o`
pub fun resolve_run_artifact(alloc: *A.Allocator, project_root: str, selectors: *manifest_select.Selectors,
    output_override: str, sources: *base_source.SourceMap) res[RunArtifact, fail.Fail] {
    var itn:         intern.Interner                         = intern.init(alloc);
    val res_read_at: res[manifest_model.Manifest, fail.Fail] = manifest_load.read_at(alloc, ?itn, sources, project_root);
    if (sel res_read_at.err) { ret res[RunArtifact, fail.Fail].err{res_read_at.err}; }
    var m: manifest_model.Manifest = res_read_at.ok;
    fin { manifest_model.dnit(?m, alloc); }

    val res_picked: res[manifest_select.Cell, fail.Fail] = manifest_select.resolve_cell(alloc, ?itn, ?m, selectors,
        manifest_select.ARTIFACT_DEFAULT_EXECUTABLE, "mach run executes one artifact");
    if (sel res_picked.err) { ret res[RunArtifact, fail.Fail].err{res_picked.err}; }
    var cell: manifest_select.Cell = res_picked.ok;

    val res_resolve_build_unit: res[manifest_plan.BuildUnit, fail.Fail] = manifest_plan.resolve_build_unit(alloc, ?itn, ?m, ?cell);
    if (sel res_resolve_build_unit.err) { ret res[RunArtifact, fail.Fail].err{res_resolve_build_unit.err}; }
    val bu: manifest_plan.BuildUnit = res_resolve_build_unit.ok;

    if (!mach_target.is_executable(bu.artifact.kind)) {
        val refusal: fail.Fail = fail.formatted_user(alloc, diagnostic_kind.ARTIFACT_NOT_RUNNABLE,
            "selected artifact '{}' is kind = \"{}\"; run executes only bin artifacts", intern.text(?itn, bu.artifact.name), mach_target.kind_name(bu.artifact.kind));
        ret res[RunArtifact, fail.Fail].err{refusal};
    }

    var ra: RunArtifact;
    ra.host_runnable = manifest_target.target_matches_host(?itn, bu.target);
    ra.target_name   = intern.text(?itn, bu.target.name);
    val res_work: res[str, fail.Fail] = compile_load.join_path(alloc, project_root, intern.text(?itn, bu.out_root));
    if (sel res_work.err) { ret res[RunArtifact, fail.Fail].err{res_work.err}; }
    val res_declared: res[runner.Runner, fail.Fail] = runner.declared(alloc, ?itn, bu.target, intern.text(?itn, bu.profile_name), res_work.ok);
    if (sel res_declared.err) { ret res[RunArtifact, fail.Fail].err{res_declared.err}; }
    ra.runner = res_declared.ok;

    if (output_override != nil) {
        if (str_is_empty(output_override)) {
            ret res[RunArtifact, fail.Fail].err{fail.user(diagnostic_kind.CLI_OUTPUT_PATH, "-o requires a non-empty path")};
        }
        val res_resolved: res[types_path.Path, A.Error] = types_path.resolve(alloc, project_root, output_override);
        if (sel res_resolved.err) {
            ret res[RunArtifact, fail.Fail].err{fail.formatted_user(alloc, diagnostic_kind.CLI_OUTPUT_PATH, "-o '{}': {}", output_override, base_alloc.text(res_resolved.err))};
        }
        val res_cleaned: res[types_path.Path, A.Error] = types_path.clean(alloc, res_resolved.ok);
        if (sel res_cleaned.err) {
            ret res[RunArtifact, fail.Fail].err{fail.formatted_user(alloc, diagnostic_kind.CLI_OUTPUT_PATH, "-o '{}': {}", output_override, base_alloc.text(res_cleaned.err))};
        }
        ra.path = res_cleaned.ok;
        ret res[RunArtifact, fail.Fail].ok{ra};
    }

    if (intern.str_is_nil(bu.bin_path)) {
        ret res[RunArtifact, fail.Fail].err{fail.user(diagnostic_kind.ARTIFACT_NO_OUTPUT, "the selected artifact is an object artifact, whose objects stay under obj/ for a later link, so nothing runs")};
    }
    val res_abs: res[str, fail.Fail] = compile_load.join_path(alloc, project_root, intern.text(?itn, bu.bin_path));
    if (sel res_abs.err) { ret res[RunArtifact, fail.Fail].err{res_abs.err}; }
    ra.path = res_abs.ok;
    ret res[RunArtifact, fail.Fail].ok{ra};
}

fun dup_strid_array(alloc: *A.Allocator, src: *intern.StrId, count: u32) res[*intern.StrId, fail.Fail] {
    if (src == nil || count == 0) { ret res[*intern.StrId, fail.Fail].ok{nil}; }
    val res_allocate: res[*intern.StrId, A.Error] = A.allocate[intern.StrId](alloc, count::usize);
    if (sel res_allocate.err) { ret res[*intern.StrId, fail.Fail].err{fail.refused(res_allocate.err)}; }
    val arr: *intern.StrId = res_allocate.ok;
    var i:   u32           = 0;
    for (i < count) {
        arr[i] = src[i];
        i      = i + 1;
    }
    ret res[*intern.StrId, fail.Fail].ok{arr};
}

# a copy of the `count` places at `src`, nil for none
fun dup_sites(alloc: *A.Allocator, src: *base_source.Location, count: u32) res[*base_source.Location, fail.Fail] {
    if (src == nil || count == 0) { ret res[*base_source.Location, fail.Fail].ok{nil}; }
    val res_allocate: res[*base_source.Location, A.Error] = A.allocate[base_source.Location](alloc, count::usize);
    if (sel res_allocate.err) { ret res[*base_source.Location, fail.Fail].err{fail.refused(res_allocate.err)}; }
    var i: u32 = 0;
    for (i < count) {
        res_allocate.ok[i] = src[i];
        i                  = i + 1;
    }
    ret res[*base_source.Location, fail.Fail].ok{res_allocate.ok};
}

fun clone_step(alloc: *A.Allocator, src: *manifest_model.StepDef, out: *manifest_model.StepDef) err[fail.Fail] {
    var d: manifest_model.StepDef = @src;
    d.argv       = nil;
    d.env_keys   = nil;
    d.env_values = nil;
    d.env_in     = nil;
    d.in         = nil;
    d.out        = nil;
    d.need       = nil;
    d.argv_at    = nil;
    d.env_at     = nil;
    d.env_in_at  = nil;
    d.in_at      = nil;
    d.out_at     = nil;
    d.need_at    = nil;
    var handed: bool = false;
    fin {
        if (!handed) { manifest_model.step_dnit(alloc, ?d); }
    }

    val res_argv: res[*intern.StrId, fail.Fail] = dup_strid_array(alloc, src.argv, src.argv_count);
    if (sel res_argv.err) { ret err[fail.Fail].err{res_argv.err}; }
    d.argv = res_argv.ok;

    val res_env_keys: res[*intern.StrId, fail.Fail] = dup_strid_array(alloc, src.env_keys, src.env_count);
    if (sel res_env_keys.err) { ret err[fail.Fail].err{res_env_keys.err}; }
    d.env_keys = res_env_keys.ok;

    val res_env_values: res[*intern.StrId, fail.Fail] = dup_strid_array(alloc, src.env_values, src.env_count);
    if (sel res_env_values.err) { ret err[fail.Fail].err{res_env_values.err}; }
    d.env_values = res_env_values.ok;

    val res_env_in: res[*intern.StrId, fail.Fail] = dup_strid_array(alloc, src.env_in, src.env_in_count);
    if (sel res_env_in.err) { ret err[fail.Fail].err{res_env_in.err}; }
    d.env_in = res_env_in.ok;

    val res_dup_strid_array: res[*intern.StrId, fail.Fail] = dup_strid_array(alloc, src.in, src.in_count);
    if (sel res_dup_strid_array.err) { ret err[fail.Fail].err{res_dup_strid_array.err}; }
    d.in = res_dup_strid_array.ok;

    val res_out: res[*intern.StrId, fail.Fail] = dup_strid_array(alloc, src.out, src.out_count);
    if (sel res_out.err) { ret err[fail.Fail].err{res_out.err}; }
    d.out = res_out.ok;

    val res_need: res[*intern.StrId, fail.Fail] = dup_strid_array(alloc, src.need, src.need_count);
    if (sel res_need.err) { ret err[fail.Fail].err{res_need.err}; }
    d.need = res_need.ok;

    val res_argv_at: res[*base_source.Location, fail.Fail] = dup_sites(alloc, src.argv_at, src.argv_count);
    if (sel res_argv_at.err) { ret err[fail.Fail].err{res_argv_at.err}; }
    d.argv_at = res_argv_at.ok;
    val res_env_at: res[*base_source.Location, fail.Fail] = dup_sites(alloc, src.env_at, src.env_count);
    if (sel res_env_at.err) { ret err[fail.Fail].err{res_env_at.err}; }
    d.env_at = res_env_at.ok;
    val res_env_in_at: res[*base_source.Location, fail.Fail] = dup_sites(alloc, src.env_in_at, src.env_in_count);
    if (sel res_env_in_at.err) { ret err[fail.Fail].err{res_env_in_at.err}; }
    d.env_in_at = res_env_in_at.ok;
    val res_in_at: res[*base_source.Location, fail.Fail] = dup_sites(alloc, src.in_at, src.in_count);
    if (sel res_in_at.err) { ret err[fail.Fail].err{res_in_at.err}; }
    d.in_at = res_in_at.ok;
    val res_out_at: res[*base_source.Location, fail.Fail] = dup_sites(alloc, src.out_at, src.out_count);
    if (sel res_out_at.err) { ret err[fail.Fail].err{res_out_at.err}; }
    d.out_at = res_out_at.ok;
    val res_need_at: res[*base_source.Location, fail.Fail] = dup_sites(alloc, src.need_at, src.need_count);
    if (sel res_need_at.err) { ret err[fail.Fail].err{res_need_at.err}; }
    d.need_at = res_need_at.ok;
    @out      = d;
    handed    = true;
    ret err[fail.Fail].ok{};
}

# the closure the project compiles against: `closure` borrowed, or with none
# given one it locates and owns
fun closure_taken(p: *project.Project, m: *manifest_model.Manifest, project_root: str, closure: *project.Closure) err[fail.Fail] {
    var taken: *project.Closure = closure;
    if (taken == nil) {
        val res_located: res[project.Closure, fail.Fail] = compile_closure.locate(p.s, p.alloc, m, project_root, nil, compile_closure.UNREALIZED_REFUSED);
        if (sel res_located.err) { ret err[fail.Fail].err{res_located.err}; }
        project.closure_dnit(?p.config.closure);
        p.config.closure = res_located.ok;
        taken            = ?p.config.closure;
    }
    ret compile_closure.adopt(p, taken);
}

# configure a project for one build cell of `m`, or of one of its dependencies
# ---
# p:            the project being configured
# project_root: the root project's directory
# m:            the root manifest
# closure:      `m`'s located closure, which the project borrows; nil to locate
#               one the project owns
# c:            the cell; with `owner`, a target and artifact of that dependency and
#               a profile of `m`
# owner:        "" for a cell of `m`, or the id of the closure dependency whose export
#               library requires the cell
# for_union:    configure the editor's union of every artifact: every artifact's
#               entry loads, and `{artifact.<id>.out}` resolves over every artifact
#               some artifact needs
# ret:          ok; err from selection, template, step, link or dependency resolution
pub fun load_config_manifest(p: *project.Project, project_root: str, m: *manifest_model.Manifest, closure: *project.Closure, c: *manifest_select.Cell,
    owner: str, for_union: bool) err[fail.Fail] {
    val res_abs_root: res[intern.StrId, A.Error] = intern.add(?p.s.interner, project_root);
    if (sel res_abs_root.err) { ret err[fail.Fail].err{fail.refused(res_abs_root.err)}; }
    p.config.project_root = res_abs_root.ok;
    p.config.home_root    = res_abs_root.ok;

    var scope: manifest_plan.Scope = manifest_plan.root_scope(m);
    if (!str_is_empty(owner)) {
        val err_closure_taken: err[fail.Fail] = closure_taken(p, m, project_root, closure);
        if (sel err_closure_taken.err) { ret err_closure_taken; }
        val err_scope_closure_to_dependency: err[fail.Fail] = compile_closure.scope_closure_to_dependency(p, owner);
        if (sel err_scope_closure_to_dependency.err) { ret err_scope_closure_to_dependency; }
        scope                 = manifest_plan.dependency_scope(m, ?p.config.owner.manifest);
        p.config.project_root = p.config.owner.vendor_root;
    }
    val om: *manifest_model.Manifest = scope.owner;

    val res_resolve_scoped_build_unit: res[manifest_plan.BuildUnit, fail.Fail] = manifest_plan.resolve_scoped_build_unit(p.alloc, ?p.s.interner, ?scope, c);
    if (sel res_resolve_scoped_build_unit.err) {
        ret err[fail.Fail].err{res_resolve_scoped_build_unit.err};
    }
    val bu: manifest_plan.BuildUnit = res_resolve_scoped_build_unit.ok;

    val cell_profile: str = intern.text(?p.s.interner, bu.profile_name);
    p.config.art_reqs      = nil;
    p.config.art_req_count = 0;
    # the union holds every artifact and resolves every artifact's requirements: a
    # module of a non-default artifact is checked against its own artifact's `need`
    val err_rqr: err[fail.Fail] = manifest_plan.resolve_artifact_reqs(p.alloc, ?p.s.interner, ?scope,
        bu.artifact, bu.target.name, cell_profile, for_union, ?p.config.art_reqs, ?p.config.art_req_count);
    if (sel err_rqr.err) { ret err[fail.Fail].err{err_rqr.err}; }

    var cell_v: template.Values = template.values_with(?p.s.interner, bu.target,
        cell_profile, p.config.art_reqs, p.config.art_req_count);

    # a dependency's other artifacts are never built for the root, so only the
    # root's own declarations can collide within a manifest
    if (!manifest_plan.scope_is_dependency(?scope)) {
        val err_check_collisions: err[fail.Fail] = manifest_plan.check_collisions(p.alloc, ?p.s.interner, m, ?cell_v);
        if (sel err_check_collisions.err) {
            ret err_check_collisions;
        }
    }

    val res_ter: res[*project.TargetEntry, A.Error] = A.allocate[project.TargetEntry](p.alloc, 1::usize);
    if (sel res_ter.err) { ret err[fail.Fail].err{fail.refused(res_ter.err)}; }
    val targets: *project.TargetEntry = res_ter.ok;
    targets[0] = project.target_entry_of(?bu);

    p.config.id           = om.id;
    p.config.version      = om.version;
    p.config.bin_name     = intern.STR_NIL;
    p.config.icon         = intern.STR_NIL;
    p.config.app_manifest = intern.STR_NIL;
    p.config.artifact     = bu.artifact;
    if (bu.artifact != nil) {
        p.config.bin_name     = bu.artifact.name;
        p.config.icon         = bu.artifact.icon;
        p.config.app_manifest = bu.artifact.app_manifest;
    }
    # a module is the cell's artifact's until the union walk says otherwise
    p.loader.artifact         = p.config.bin_name;
    p.config.module           = bu.entry;
    p.config.dir_src          = om.src;
    p.config.targets          = targets;
    p.config.target_count     = 1;
    p.target_entry            = ?p.config.targets[0];
    p.config.profile          = bu.profile_name;
    p.config.step_order       = nil;
    p.config.step_order_count = 0;

    val res_project_work_str: res[str, fail.Fail] = manifest_project.expand_project_work(p.alloc, ?p.s.interner, m, ?cell_v);
    if (sel res_project_work_str.err) { ret err[fail.Fail].err{res_project_work_str.err}; }
    val project_work_str: str = res_project_work_str.ok;
    fin { str_free(p.alloc, project_work_str); }
    val res_po_id: res[intern.StrId, A.Error] = intern.add(?p.s.interner, project_work_str);
    if (sel res_po_id.err) { ret err[fail.Fail].err{fail.refused(res_po_id.err)}; }
    p.config.project_work = res_po_id.ok;

    val err_validate_local_links: err[fail.Fail] = validate_local_links(p, project_root, om, bu.target, project_work_str, ?cell_v);
    if (sel err_validate_local_links.err) { ret err_validate_local_links; }

    val err_sor: err[fail.Fail] = validate_step_outputs(p, om, project_work_str, ?cell_v);
    if (sel err_sor.err) { ret err_sor; }

    val err_spr: err[fail.Fail] = compute_step_plan(p, om, ?bu, for_union, project_work_str, ?cell_v);
    if (sel err_spr.err) { ret err_spr; }

    p.config.steps      = nil;
    p.config.step_count = 0;
    if (om.step_count > 0) {
        val res_steps: res[*manifest_model.StepDef, A.Error] = A.allocate[manifest_model.StepDef](p.alloc, om.step_count::usize);
        if (sel res_steps.err) {
            ret err[fail.Fail].err{fail.refused(res_steps.err)};
        }
        val steps: *manifest_model.StepDef = res_steps.ok;
        var si:    u32                     = 0;
        for (si < om.step_count) {
            val err_clone: err[fail.Fail] = clone_step(p.alloc, ?om.steps[si], ?steps[si]);
            if (sel err_clone.err) {
                var sj: u32 = 0;
                for (sj < si) {
                    manifest_model.step_dnit(p.alloc, ?steps[sj]);
                    sj = sj + 1;
                }
                A.deallocate[manifest_model.StepDef](p.alloc, steps, om.step_count::usize);
                ret err_clone;
            }
            si = si + 1;
        }
        p.config.steps      = steps;
        p.config.step_count = om.step_count;
    }

    if (!manifest_plan.scope_is_dependency(?scope)) {
        val err_closure_taken: err[fail.Fail] = closure_taken(p, m, project_root, closure);
        if (sel err_closure_taken.err) { ret err_closure_taken; }
    }

    val err_scoped: err[fail.Fail] = compile_closure.resolve_requirement_scopes(p, m, cell_profile);
    if (sel err_scoped.err) { ret err_scoped; }
    session_embed.set_path_env(?p.s.embeds, project_root, p.config.req_scopes, p.config.req_scope_count,
        p.req.goal != request.GOAL_CHECK);

    val err_cascade_libs_resolved: err[fail.Fail] = compile_closure.resolve_cascade_libs(p, bu.target.arch, bu.target.sys, bu.target.abi,
        p.target_entry.libs, p.target_entry.lib_count);
    if (sel err_cascade_libs_resolved.err) { ret err[fail.Fail].err{err_cascade_libs_resolved.err}; }

    if (for_union) {
        val err_populate_union_tuples: err[fail.Fail] = union.populate_union_tuples(p, m);
        if (sel err_populate_union_tuples.err) { ret err[fail.Fail].err{err_populate_union_tuples.err}; }
    }
    if (for_union) {
        val err_populate_union_entries: err[fail.Fail] = union.populate_union_entries(p, m);
        if (sel err_populate_union_entries.err) { ret err[fail.Fail].err{err_populate_union_entries.err}; }
    }

    ret err[fail.Fail].ok{};
}

pub fun module_obj_tree(a: *A.Allocator, proj_out: str, id: str) res[str, fail.Fail] {
    ret layout.within(a, proj_out, layout.OBJ, id);
}

pub fun path_in_module_obj_tree(path: str, tree: str) bool {
    if (str_equals(path, tree))       { ret true; }
    if (!str_starts_with(path, tree)) { ret false; }
    ret types_path.is_separator(path[str_len(tree)]);
}

pub fun step_out_reserved_error(a: *A.Allocator, what: str, name: str, path: str, tree: str, owner_desc: str) fail.Fail {
    ret fail.formatted_user(a, diagnostic_kind.STEP_OUTPUT_RESERVED,
        "{} '{}' writes '{}' into '{}/', {}: the compiler owns that directory, so a step output there is overwritten by (or overwrites) compiler state. write it elsewhere under {{project.work}}",
        what, name, path, tree, owner_desc);
}

# one declared step output: its expanded path, its step, and where it is written
rec DeclaredStepOutput {
    path: str;
    step: str;
    at:   base_source.Location;
}

# by path, then step, then where each is written, so of two claims the earlier
# written one leads
fun declared_step_output_compare(a: *DeclaredStepOutput, b: *DeclaredStepOutput) i64 {
    val pc: i64 = str_compare(a.path, b.path);
    if (pc != 0) { ret pc; }
    val sc: i64 = str_compare(a.step, b.step);
    if (sc != 0)                             { ret sc; }
    if (a.at.span.offset < b.at.span.offset) { ret -1; }
    if (a.at.span.offset > b.at.span.offset) { ret 1; }
    ret 0;
}

fun declared_step_outputs_dnit(a: *A.Allocator, outputs: *Vector[DeclaredStepOutput]) {
    var i: usize = 0;
    for (i < outputs.len) {
        str_free(a, outputs.data[i].path);
        i = i + 1;
    }
    collections_vector.dnit[DeclaredStepOutput](outputs);
}

fun validate_declared_step_output_collisions(a: *A.Allocator, outputs: *Vector[DeclaredStepOutput]) err[fail.Fail] {
    sort.sort_by[DeclaredStepOutput](outputs.data, outputs.len, declared_step_output_compare);
    var i: usize = 0;
    for (i < outputs.len) {
        var j: usize = i + 1;
        for (j < outputs.len) {
            val left:  *DeclaredStepOutput = ?outputs.data[i];
            val right: *DeclaredStepOutput = ?outputs.data[j];
            val exact: bool                = str_equals(left.path, right.path);
            if (exact || path_in_module_obj_tree(right.path, left.path)) {
                var claims: [2]base_source.Location;
                claims[0] = left.at;
                claims[1] = right.at;
                if (exact && str_equals(left.step, right.step)) {
                    ret err[fail.Fail].err{manifest_refusal.at_sites(a, fail.formatted_user(a, diagnostic_kind.STEP_OUTPUT_DUPLICATE, "mach.toml: [step.{}] declares output '{}' more than once", left.step, left.path), ?claims[0], 2)};
                }
                ret err[fail.Fail].err{manifest_refusal.at_sites(a, fail.formatted_user(a, diagnostic_kind.STEP_OUTPUT_COLLISION, "mach.toml: [step.{}] output '{}' collides with [step.{}] output '{}'", left.step, left.path, right.step, right.path), ?claims[0], 2)};
            }
            j = j + 1;
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun validate_step_outputs(p: *project.Project, m: *manifest_model.Manifest, proj_out: str, v: *template.Values) err[fail.Fail] {
    if (m.step_count == 0) { ret err[fail.Fail].ok{}; }

    val res_tree: res[str, fail.Fail] = module_obj_tree(p.alloc, proj_out, intern.text(?p.s.interner, m.id));
    if (sel res_tree.err) { ret err[fail.Fail].err{res_tree.err}; }
    val tree: str = res_tree.ok;
    fin { str_free(p.alloc, tree); }
    val res_stage_tree: res[str, fail.Fail] = layout.under(p.alloc, proj_out, layout.STAGE);
    if (sel res_stage_tree.err) { ret err[fail.Fail].err{res_stage_tree.err}; }
    val stage_tree: str = res_stage_tree.ok;
    fin { str_free(p.alloc, stage_tree); }
    val res_cache_tree: res[str, fail.Fail] = layout.under(p.alloc, proj_out, layout.CACHE);
    if (sel res_cache_tree.err) { ret err[fail.Fail].err{res_cache_tree.err}; }
    val cache_tree: str = res_cache_tree.ok;
    fin { str_free(p.alloc, cache_tree); }
    var outputs: Vector[DeclaredStepOutput] = collections_vector.init[DeclaredStepOutput](p.alloc);
    fin { declared_step_outputs_dnit(p.alloc, ?outputs); }

    var si: u32 = 0;
    for (si < m.step_count) {
        val step:  *manifest_model.StepDef = ?m.steps[si];
        val sname: str                     = intern.text(?p.s.interner, step.name);

        var oi: u32 = 0;
        for (oi < step.out_count) {
            val at:      base_source.Location = manifest_model.site_of(step.out_at, oi);
            val res_exp: res[str, fail.Fail]  = template.path_expand(p.alloc, intern.text(?p.s.interner, step.out[oi]), template.CONTEXT_PATH, proj_out, v, "a build step output");
            if (sel res_exp.err) { ret err[fail.Fail].err{fail.at(res_exp.err, at)}; }
            val exp:    str  = res_exp.ok;
            var pushed: bool = false;
            fin {
                if (!pushed) { str_free(p.alloc, exp); }
            }

            var reserved_tree: str = "";
            var reserved_desc: str = "";
            if (path_in_module_obj_tree(exp, tree)) {
                reserved_tree = tree;
                reserved_desc = "the module object tree";
            }
            or (path_in_module_obj_tree(exp, stage_tree)) {
                reserved_tree = stage_tree;
                reserved_desc = "the build step staging area";
            }
            or (path_in_module_obj_tree(exp, cache_tree)) {
                reserved_tree = cache_tree;
                reserved_desc = "the compiler cache directory";
            }
            if (!str_is_empty(reserved_tree)) {
                var refusal:   fail.Fail           = fail.reported();
                val res_label: res[str, fail.Fail] = diagnostic.format(p.alloc, "[step.{}]", sname);
                if (sel res_label.err) { refusal = res_label.err; }
                or (sel res_label.ok) {
                    refusal = fail.at(step_out_reserved_error(p.alloc, "mach.toml: declared output of", res_label.ok, exp, reserved_tree, reserved_desc), at);
                    str_free(p.alloc, res_label.ok);
                }
                ret err[fail.Fail].err{refusal};
            }
            val res_push: res[usize, A.Error] = collections_vector.push[DeclaredStepOutput](?outputs, DeclaredStepOutput{path: exp, step: sname, at: at});
            if (sel res_push.err) { ret err[fail.Fail].err{fail.refused(res_push.err)}; }
            pushed = true;
            oi     = oi + 1;
        }
        si = si + 1;
    }
    val err_collision: err[fail.Fail] = validate_declared_step_output_collisions(p.alloc, ?outputs);
    if (sel err_collision.err) { ret err[fail.Fail].err{err_collision.err}; }
    ret err[fail.Fail].ok{};
}

fun compute_step_plan(p: *project.Project, m: *manifest_model.Manifest, bu: *manifest_plan.BuildUnit,
    for_union: bool, proj_out: str, v: *template.Values) err[fail.Fail] {
    p.config.step_order       = nil;
    p.config.step_order_count = 0;
    if (m.step_count == 0) { ret err[fail.Fail].ok{}; }

    var names:  *intern.StrId = nil;
    var ncount: u32           = 0;
    var owned:  bool          = false;
    if (for_union && m.artifact_count > 0) {
        val res_allocate: res[*intern.StrId, A.Error] = A.allocate[intern.StrId](p.alloc, m.artifact_count::usize);
        if (sel res_allocate.err) { ret err[fail.Fail].err{fail.refused(res_allocate.err)}; }
        names = res_allocate.ok;
        owned = true;
        var i: u32 = 0;
        for (i < m.artifact_count) {
            names[i] = m.artifacts[i].name;
            i        = i + 1;
        }
        ncount = m.artifact_count;
    }
    or {
        if (bu.artifact == nil) { ret err[fail.Fail].ok{}; }
        names  = ?bu.artifact.name;
        ncount = 1;
    }

    var order:          *u32           = nil;
    var count:          u32            = 0;
    val err_plan_steps: err[fail.Fail] = manifest_plan.plan_steps(p.alloc, ?p.s.interner, m, names, ncount, bu.target, proj_out, v, ?order, ?count);
    if (owned)                  { A.deallocate[intern.StrId](p.alloc, names, m.artifact_count::usize); }
    if (sel err_plan_steps.err) { ret err[fail.Fail].err{err_plan_steps.err}; }
    p.config.step_order       = order;
    p.config.step_order_count = count;
    ret err[fail.Fail].ok{};
}

fun validate_local_links(p: *project.Project, project_root: str, m: *manifest_model.Manifest, t: *manifest_model.TargetDef, proj_out: str, v: *template.Values) err[fail.Fail] {
    var li: u32 = 0;
    for (li < m.link_count) {
        val l: *manifest_model.LinkDef = ?m.links[li];
        if (l.source == manifest_model.LINK_LOCAL && manifest_link.link_matches_target(?p.s.interner, l, t)) {
            val ename: str = intern.text(?p.s.interner, l.name);

            val res_exp: res[str, fail.Fail] = manifest_link.expand_local_path(p.alloc, ?p.s.interner, l, proj_out, v);
            if (sel res_exp.err) { ret err[fail.Fail].err{res_exp.err}; }
            val exp: str = res_exp.ok;
            fin { str_free(p.alloc, exp); }

            val res_demanded: res[bool, fail.Fail] = manifest_plan.local_path_demanded(p.alloc, ?p.s.interner, m, t, exp, proj_out, v);
            if (sel res_demanded.err) { ret err[fail.Fail].err{res_demanded.err}; }
            var ok_: bool = res_demanded.ok;
            if (!ok_) {
                val res_abs: res[str, fail.Fail] = compile_load.join_path(p.alloc, project_root, exp);
                if (sel res_abs.ok) {
                    val abs:        str                       = res_abs.ok;
                    val res_exists: res[bool, io_error.Error] = fs.exists(abs);
                    ok_ = (sel res_exists.ok && res_exists.ok);
                    str_free(p.alloc, abs);
                }
            }
            if (!ok_) {
                val refusal: fail.Fail = fail.formatted_user(p.alloc, diagnostic_kind.LINK_LOCAL_MISSING,
                    "mach.toml: [link.{}] path '{}' matches no step or artifact output and does not exist on disk", ename, exp);
                ret err[fail.Fail].err{fail.at(refusal, l.path_at)};
            }
        }
        li = li + 1;
    }
    ret err[fail.Fail].ok{};
}

pub fun select_target(p: *project.Project, t: *project.TargetEntry) err[fail.Fail] {
    readout.phase_begin(p.progress, readout.TARGET);
    var declared: manifest_model.TargetDef = t.declared;
    # an executable's linkage narrows the target, so mink resolves it against the host
    var linkage: intern.StrId = intern.STR_NIL;
    if (mach_target.is_executable(t.kind)) { linkage = t.linkage; }
    val res_resolve_declared: res[resolved.Target, fail.Fail] = manifest_target.resolve_declared(p.s.alloc, ?p.s.interner, ?declared, linkage, ?t.linkage_from);
    if (sel res_resolve_declared.err) { ret err[fail.Fail].err{fail.as_user(diagnostic_kind.TARGET_INVALID, res_resolve_declared.err)}; }
    p.target = res_resolve_declared.ok;
    # mirl builds the artifact's code for the output kind it is: a shared object's address
    # model lets another image preempt what it exports
    var made: *mink_output.Kind = nil;
    if (mach_target.is_executable(t.kind)) {
        val res_linkage_of: res[*mink_output.Kind, fail.Fail] = mach_target.linkage_of(p.s.alloc, ?p.target, diagnostic_kind.MANIFEST_INVALID_VALUE);
        if (sel res_linkage_of.err) { ret err[fail.Fail].err{res_linkage_of.err}; }
        made = res_linkage_of.ok;
    }
    p.target.output = opt[*mink_output.Kind].some{mach_target.output_of(t.kind, made)};
    backend.dnit(p.alloc, ?p.back);
    val res_opened: res[backend.Back, fail.Fail] = backend.init(p.alloc, ?p.target);
    if (sel res_opened.err) { ret err[fail.Fail].err{fail.as_user(diagnostic_kind.TARGET_INVALID, res_opened.err)}; }
    p.back = res_opened.ok;
    readout.phase_end(p.progress, readout.TARGET, 1, "target", "targets");

    val res_rcn: res[intern.StrId, A.Error] = intern.add(?p.s.interner, "mach");
    if (sel res_rcn.err) { ret err[fail.Fail].err{fail.refused(res_rcn.err)}; }
    p.compiler_name = res_rcn.ok;

    val res_rcv: res[intern.StrId, A.Error] = intern.add(?p.s.interner, base_version.MACH_VERSION);
    if (sel res_rcv.err) { ret err[fail.Fail].err{fail.refused(res_rcv.err)}; }
    p.compiler_ver = res_rcv.ok;

    ret err[fail.Fail].ok{};
}
