# the link claims an object mach emits carries for whoever links it: one per
# `[link.*]` requirement of the unit the object is compiled for, its own and
# those its dependencies export, each classified as mach's own link classifies it. a
# shared system library on a target whose link makes one from its claim is named by
# its loader name as written, with the versions the entry states, and provides the
# symbols the entry lists and each symbol the object refers to that a `#[library]`
# pins to it, each with whether it is a function or a variable. an import module is
# named by its name and provides its symbols the same way. any other library or
# framework is named with its kind, and a file by its absolute path. mink adds them
# as one section every image leaves out, so an archive of the objects carries them
# to the link that takes it

use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use types_path: std.types.path;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.OwnedString;
use std.types.string.owned_dnit;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use A: std.allocator;
use std.collections.vector;
use std.collections.vector.Vector;
use std.process.env;

use mach.base.fail;
use mach.base.intern;
use mach.compile.backend;
use mach.compile.project;
use mach.lower.linkage;
use mach.target.input;

use manifest_link:  mach.manifest.link;
use manifest_model: mach.manifest.model;
use mink_fail:      mink.base.fail;
use mink_intern:    mink.base.intern;
use mink_table:     mink.base.table;
use mink.model.claim;
use mink.model.claim.Claim;
use mink.model.claim.Provided;
use mink.model.object;
use mink.model.object.Object;
use mink.model.object.Versions;
use mink_symbol: mink.model.symbol;

# what every claim of one object reads: the object, whether the target's link makes a
# shared system library from its claim, and per name of the object whether it refers to
# it undefined
rec Stating {
    o:          *Object;
    describes:  bool;
    referenced: Vector[bool];
}

# add to `o` the claims of every link requirement of `p`'s unit, nothing for none
pub fun state(p: *project.Project, o: *Object) err[fail.Fail] {
    val te: *project.TargetEntry = p.target_entry;
    var n:  u32                  = p.config.cascade_lib_count;
    if (te != nil) { n = n + te.lib_count; }
    if (n == 0)    { ret err[fail.Fail].ok{}; }
    val res_described: res[bool, fail.Fail] = backend.describes_claims(?p.back, p.alloc);
    if (sel res_described.err) { ret err[fail.Fail].err{res_described.err}; }
    var st: Stating = Stating{o: o, describes: res_described.ok, referenced: vector.init[bool](p.alloc)};
    fin { vector.dnit[bool](?st.referenced); }
    val err_marked: err[fail.Fail] = mark_referenced(p, o, ?st);
    if (sel err_marked.err) { ret err_marked; }
    var w:              claim.Writer        = claim.writer(o);
    val err_all_stated: err[fail.Fail]      = all_stated(p, ?st, ?w);
    val err_finished:   err[mink_fail.Fail] = claim.finish(?w);
    if (sel err_all_stated.err) { ret err_all_stated; }
    if (sel err_finished.err)   { ret err[fail.Fail].err{backend.input_refused_by_mink(p.alloc, err_finished.err)}; }
    ret err[fail.Fail].ok{};
}

# mark each name of `o` a symbol refers to undefined
fun mark_referenced(p: *project.Project, o: *Object, st: *Stating) err[fail.Fail] {
    val names: usize = mink_intern.count(?o.names);
    var i:     usize = 0;
    for (i < names) {
        val res_pushed: res[usize, A.Error] = vector.push[bool](?st.referenced, false);
        if (sel res_pushed.err) { ret err[fail.Fail].err{fail.refused(res_pushed.err)}; }
        i = i + 1;
    }
    i = 0;
    for (i < mink_table.count[object.Symbol](?o.symbols)) {
        val sym: *object.Symbol = object.symbol_at(o, mink_table.nth[object.Symbol](i));
        i = i + 1;
        if (!sel sym.def.undefined || !mink_symbol.binds(sym.binding, mink_symbol.EXTERNAL)) { cnt; }
        st.referenced.data[sym.name.index::usize] = true;
    }
    ret err[fail.Fail].ok{};
}

fun all_stated(p: *project.Project, st: *Stating, w: *claim.Writer) err[fail.Fail] {
    val te: *project.TargetEntry = p.target_entry;
    if (te != nil) {
        val err_own: err[fail.Fail] = stated(p, st, w, te.libs, te.lib_count);
        if (sel err_own.err) { ret err_own; }
    }
    ret stated(p, st, w, p.config.cascade_libs, p.config.cascade_lib_count);
}

fun stated(p: *project.Project, st: *Stating, w: *claim.Writer, reqs: *manifest_link.LinkRequirement, count: u32) err[fail.Fail] {
    var i: u32 = 0;
    for (i < count) {
        val err_reqs_one: err[fail.Fail] = one(p, st, w, ?reqs[i]);
        if (sel err_reqs_one.err) { ret err_reqs_one; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# whether the link takes the library or framework the requirement `req` names from its claim
# alone, on a target whose link makes one from its claim: a shared system library, which no file
# is looked for for, and a framework that states no directory, which the link makes from its
# claim unless a framework directory the command line gives holds it
pub fun described(req: *manifest_link.LinkRequirement, describes: bool) bool {
    if (!describes)                                  { ret false; }
    if (req.source == manifest_model.LINK_FRAMEWORK) { ret intern.str_is_nil(req.dir); }
    ret req.source == manifest_model.LINK_SYSTEM && req.kind == input.SHARED;
}

# the claim of the requirement `req`, classified as mach's own link classifies it: an import
# module, a library the link makes from its claim, a framework, a file when its name is a path,
# else a library by name. the file is not looked for here, so the claim asks for it only where a link takes
# the object, as the requirement stated there would
fun one(p: *project.Project, st: *Stating, w: *claim.Writer, req: *manifest_link.LinkRequirement) err[fail.Fail] {
    val text: str   = intern.text(p.s.interner, req.text);
    var c:    Claim = Claim{form: claim.Form.system{}, kind: opt[claim.LibraryKind].some{claim.LibraryKind.shared{}}, referenced: req.include_referenced};
    if (req.kind == input.STATIC) { c.kind = opt[claim.LibraryKind].some{claim.LibraryKind.static{}}; }
    if (req.versions.stated)      { c.versions = opt[Versions].some{Versions{current: req.versions.current, compat: req.versions.compat}}; }
    var path: str = nil;
    fin {
        if (path != nil) { str_free(p.alloc, path); }
    }
    if (req.kind == input.MODULE) {
        c.form     = claim.Form.module{};
        c.kind     = opt[claim.LibraryKind].none{};
        c.versions = opt[Versions].none{};
    }
    or (req.source == manifest_model.LINK_FRAMEWORK) { c.form = claim.Form.framework{}; }
    or (described(req, st.describes))                {}
    or (input.token_is_path(text::*u8)) {
        val res_absolute: res[str, fail.Fail] = absolute_of(p.alloc, text);
        if (sel res_absolute.err) { ret err[fail.Fail].err{res_absolute.err}; }
        path       = res_absolute.ok;
        c.form     = claim.Form.local{};
        c.kind     = opt[claim.LibraryKind].none{};
        c.versions = opt[Versions].none{};
    }
    var name: str = text;
    if (path != nil) { name = path; }
    c.name = View{data: name::*u8, len: str_len(name)};
    var symbols: Vector[Provided] = vector.init[Provided](p.alloc);
    fin { vector.dnit[Provided](?symbols); }
    val err_listed: err[fail.Fail] = provided(p, st, req, ?symbols);
    if (sel err_listed.err) { ret err_listed; }
    c.symbols      = symbols.data;
    c.symbol_count = symbols.len;
    val err_added: err[mink_fail.Fail] = claim.add(w, ?c);
    if (sel err_added.err) { ret err[fail.Fail].err{backend.input_refused_by_mink(p.alloc, err_added.err)}; }
    ret err[fail.Fail].ok{};
}

# the symbols the requirement `req` provides into `out`: each its entry lists, of no stated
# sort, then each the object refers to that a declaration pins to its library and the entry
# does not list, of the sort the declaration states
fun provided(p: *project.Project, st: *Stating, req: *manifest_link.LinkRequirement, out: *Vector[Provided]) err[fail.Fail] {
    var i: u32 = 0;
    for (i < req.symbol_count) {
        val res_link_name_for: res[intern.StrId, fail.Fail] = project.link_name_for(p, req.symbols[i]);
        if (sel res_link_name_for.err) { ret err[fail.Fail].err{res_link_name_for.err}; }
        val linked:     str                 = intern.text(p.s.interner, res_link_name_for.ok);
        val res_pushed: res[usize, A.Error] = vector.push[Provided](out, Provided{name: View{data: linked::*u8, len: str_len(linked)}, sort: claim.Sort.unstated{}});
        if (sel res_pushed.err) { ret err[fail.Fail].err{fail.refused(res_pushed.err)}; }
        i = i + 1;
    }
    val listed: usize = out.len;
    var k:      usize = 0;
    for (k < p.linkage.imports.len) {
        val im: *linkage.Import = ?p.linkage.imports.data[k];
        k = k + 1;
        if (!intern.str_same(im.lib, req.key)) { cnt; }
        val linked: str  = intern.text(p.s.interner, im.name);
        val v:      View = View{data: linked::*u8, len: str_len(linked)};
        if (!referenced(st, v) || listed_in(out, listed, v)) { cnt; }
        var sort: claim.Sort = claim.Sort.unstated{};
        if (im.sort == linkage.CODE) { sort = claim.Sort.code{}; }
        or (im.sort == linkage.DATA) { sort = claim.Sort.data{}; }
        val res_pushed: res[usize, A.Error] = vector.push[Provided](out, Provided{name: v, sort: sort});
        if (sel res_pushed.err) { ret err[fail.Fail].err{fail.refused(res_pushed.err)}; }
    }
    ret err[fail.Fail].ok{};
}

# whether the object refers to the name `v` undefined
fun referenced(st: *Stating, v: View) bool {
    val opt_find: opt[mink_table.Id[mink_intern.Name]] = mink_intern.find(?st.o.names, v.data, v.len);
    if (sel opt_find.none) { ret false; }
    ret st.referenced.data[opt_find.some.index::usize];
}

# whether the first `n` symbols of `out` hold the name `v`
fun listed_in(out: *Vector[Provided], n: usize, v: View) bool {
    var i: usize = 0;
    for (i < n) {
        val have: View = out.data[i].name;
        i = i + 1;
        if (have.len != v.len) { cnt; }
        var k:    usize = 0;
        var same: bool  = true;
        for (k < v.len && same) {
            if (have.data[k] != v.data[k]) { same = false; }
            k = k + 1;
        }
        if (same) { ret true; }
    }
    ret false;
}

# `spelled` as an absolute, lexically clean path, as the link reads it: a local entry's path is
# anchored already, and a relative one, a system entry's name that names a file, lies under the
# working directory
fun absolute_of(a: *A.Allocator, spelled: str) res[str, fail.Fail] {
    val res_cwd: res[OwnedString, env.EnvError] = env.current_dir(a);
    if (sel res_cwd.err) { ret res[str, fail.Fail].err{fail.message("a link claim's path cannot be made absolute: the current directory is unreadable")}; }
    var cwd: OwnedString = res_cwd.ok;
    fin { owned_dnit(?cwd); }
    val res_joined: res[str, A.Error] = types_path.resolve(a, cwd.data, spelled);
    if (sel res_joined.err) { ret res[str, fail.Fail].err{fail.refused(res_joined.err)}; }
    fin { str_free(a, res_joined.ok); }
    val res_cleaned: res[str, A.Error] = types_path.clean(a, res_joined.ok);
    if (sel res_cleaned.err) { ret res[str, fail.Fail].err{fail.refused(res_cleaned.err)}; }
    ret res[str, fail.Fail].ok{res_cleaned.ok};
}
