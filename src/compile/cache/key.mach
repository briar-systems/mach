# the object cache's key builder, and the keys of a module's normal and test objects

use mach.base.fail;
use mach.base.intern;
use mach.base.wire;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

# a cache key: the sha-256 of a domain then each input, every number a u64
# and every byte run its length then its bytes
pub rec Builder {
    sink: wire.Sink;
}

# start a key in a domain, the domain hashed as the first input
# ---
# domain: the text naming what the key is for
# ret:    a builder holding the running digest
pub fun begin(domain: str) Builder {
    var b: Builder = Builder{sink: wire.digest()};
    text(?b, domain);
    ret b;
}

# add a u64 input to the key
# ---
# b:     the key being built
# value: the number to add
pub fun number(b: *Builder, value: u64) {
    wire.put_u64(?b.sink, value);
}

# add a byte run to the key as its length then its bytes
# a nonempty run with nil bytes marks the builder failed, reported by finish
# ---
# b:    the key being built
# data: the first byte, nil only when len is 0
# len:  the byte count
pub fun bytes(b: *Builder, data: *u8, len: usize) {
    if (data == nil && len != 0) {
        wire.refuse(?b.sink, fail.message("cache key has a nonempty input without bytes"));
        ret;
    }
    number(b, len::u64);
    wire.put_bytes(?b.sink, data, len);
}

# add a string to the key, nil and present text hashed apart by a leading 0 or 1
# ---
# b:     the key being built
# value: the nul-terminated text, or nil
pub fun text(b: *Builder, value: str) {
    if (value == nil) {
        number(b, 0);
        ret;
    }
    number(b, 1);
    bytes(b, value, str_len(value));
}

# add an interned name to the key as its text, a nil id hashed as nil text
# a name missing from the interner marks the builder failed, reported by finish
# ---
# b:   the key being built
# itn: the interner holding the name
# id:  the name's id
pub fun name(b: *Builder, itn: *intern.Interner, id: intern.StrId) {
    if (intern.str_is_nil(id)) {
        text(b, nil);
        ret;
    }
    val opt_value: opt[str] = intern.get(itn, id);
    if (sel opt_value.none) {
        wire.refuse(?b.sink, fail.message("cache key name is absent from its interner"));
        ret;
    }
    text(b, opt_value.some);
}

# finish the key into its 32-byte digest
# ---
# b:      the key being built
# digest: where the digest is written
# ret:    the builder's first refusal or a missing destination as an error, digest untouched
pub fun finish(b: *Builder, digest: *[32]u8) err[fail.Fail] {
    val opt_failed: opt[fail.Fail] = wire.failure(?b.sink);
    if (sel opt_failed.some) { ret err[fail.Fail].err{opt_failed.some}; }
    if (digest == nil)       { ret err[fail.Fail].err{fail.message("cache key has no digest destination")}; }
    wire.digest_final(?b.sink, digest);
    ret err[fail.Fail].ok{};
}

# compare two 32-byte keys
# ---
# left:  the first key
# right: the second key
# ret:   true when every byte matches
pub fun equal(left: *[32]u8, right: *[32]u8) bool {
    var i: usize = 0;
    for (i < 32) {
        if ((@left)[i] != (@right)[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the key of a module's object: the module's key and its name
pub fun object(module_key: *[32]u8, module: str, out: *[32]u8) err[fail.Fail] {
    var b: Builder = begin("mach.object-image");
    bytes(?b, ?(@module_key)[0], 32);
    text(?b, module);
    ret finish(?b, out);
}

# the key of a module's test object: the key of the normal object it is lowered
# against, which covers the module's whole source, tests included
pub fun test_object(object_key: *[32]u8, out: *[32]u8) err[fail.Fail] {
    var b: Builder = begin("mach.test-object-image");
    bytes(?b, ?(@object_key)[0], 32);
    ret finish(?b, out);
}
