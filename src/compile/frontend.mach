# the front end's products: a module's parse, its resolution and the surface it exports, its
# types and the typed surface importers read, each a kind declared here beside its computation.
# a computation reads what it depends on through the query engine, and a host reads a product
# through the readers here: inside an operation by acquiring it, between operations as this
# project's operations last published it
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;
use std.collections.map;
use collections_vector: std.collections.vector;
use std.memory;

use mach.base.diagnostic;
use diagnostic_kind: mach.base.diagnostic.kind;
use mach.base.fail;
use base_fingerprint: mach.base.fingerprint;
use mach.base.float;
use mach.base.growth;
use mach.base.intern;
use base_source: mach.base.source;
use mach.base.wire;
use mach.compile.readahead;
use mach.front.ast;
use ast_id: mach.front.ast.id;
use mach.front.expect;
use front_lexer:  mach.front.lexer;
use front_load:   mach.front.load;
use front_parser: mach.front.parser;
use mach.front.parser.state;
use mach.front.refusal;
use mach.front.resolve;
use mach.session;
use session_embed: mach.session.embed;
use mach.session.module;
use mach.session.query;
use mach.type.deprecation;

use mach.compile.codec;
use mach.compile.context;
use mach.compile.project;
use comptime_scope: mach.front.comptime.scope;
use comptime_value: mach.front.comptime.value;
use sema_fields:    mach.front.sema.fields;
use sema_instance:  mach.front.sema.instance;
use sema_module:    mach.front.sema.module;
use sema_product:   mach.front.sema.product;
use sema_surface:   mach.front.sema.surface;
use report_phase:   mach.report.phase;
use mach.type;
use type_field: mach.type.field;
use type_kind:  mach.type.kind;

# a file's parse: the syntax tree and how the parse stood, keyed by the file
pub val PARSE: query.Kind = query.Kind{
    name: "parse", role: query.DERIVED, owner: query.KEY_FILE, origin: diagnostic.ORIGIN_LOAD, compute: parse_compute, finalize: parse_finalize
};
# the digest of what the load walk decided for a module, keyed by its stable id
pub val LOAD_VIEW: query.Kind = query.Kind{name: "load view", role: query.INPUT, owner: query.KEY_MODULE};
# the module id this build numbers a module with, keyed by its stable id
pub val MODULE_NUMBER: query.Kind = query.Kind{name: "module number", role: query.INPUT, owner: query.KEY_MODULE};
# a module's resolution, keyed by its stable id
pub val RESOLVE: query.Kind = query.Kind{
    name: "resolve", role: query.DERIVED, owner: query.KEY_MODULE, origin: diagnostic.ORIGIN_RESOLVE, compute: resolve_compute, finalize: resolve_finalize
};
# what a module's resolution exports to an importer, keyed by its stable id
pub val EXPORTS: query.Kind = query.Kind{
    name:     "exports", role: query.DERIVED, owner: query.KEY_MODULE, origin: diagnostic.ORIGIN_RESOLVE, compute: exports_compute,
    finalize: exports_finalize, equal: exports_equal
};
# a module's types, keyed by its stable id
pub val SEMA: query.Kind = query.Kind{
    name: "sema", role: query.DERIVED, owner: query.KEY_MODULE, origin: diagnostic.ORIGIN_SEMA, compute: sema_compute, finalize: sema_finalize
};
# the typed surface a module exports to its importers, shared by every one, keyed by its stable id
pub val TYPED_EXPORTS: query.Kind = query.Kind{
    name:     "typed exports", role: query.DERIVED, owner: query.KEY_MODULE, origin: diagnostic.ORIGIN_SEMA, compute: typed_exports_compute,
    finalize: surface_finalize, equal: surface_equal
};
# the typed surfaces of every module a module imports, transitively, keyed by its stable id: what
# an instance of the module's templates reads of the modules around it. every instance of the
# module shares the one list, so each depends on it once rather than on each surface in it
pub val INSTANCE_SURFACES: query.Kind = query.Kind{
    name:     "instance surfaces", role: query.DERIVED, owner: query.KEY_MODULE, origin: diagnostic.ORIGIN_SEMA, compute: instance_surfaces_compute,
    finalize: instance_surfaces_finalize
};

# a module's parse in the open operation
pub fun parse(p: *project.Project, m: *project.ModuleEntry) res[ParsedModule, fail.Fail] {
    val res_acquired: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, ?PARSE, base_source.file_index(m.file_id)::u64);
    if (sel res_acquired.err) { ret res[ParsedModule, fail.Fail].err{res_acquired.err}; }
    val view: query.QueryView = res_acquired.ok;
    if (view.value == nil || view.value_len::usize < $size_of(ParsedModule)) { ret res[ParsedModule, fail.Fail].err{fail.message("parse query produced no syntax tree")}; }
    val parsed: ParsedModule = @(view.value::ptr::*ParsedModule);
    if (parsed.a == nil) { ret res[ParsedModule, fail.Fail].err{fail.message("parse query produced no syntax tree")}; }
    ret res[ParsedModule, fail.Fail].ok{parsed};
}

# a module's resolution in the open operation
pub fun resolution(p: *project.Project, m: *project.ModuleEntry) res[*resolve.ResolveResult, fail.Fail] {
    val res_acquired: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, ?RESOLVE, module.stable_index(m.stable_id)::u64);
    if (sel res_acquired.err) { ret res[*resolve.ResolveResult, fail.Fail].err{res_acquired.err}; }
    val rr: *resolve.ResolveResult = codec.resolve_handle_decode(res_acquired.ok);
    if (rr == nil) { ret res[*resolve.ResolveResult, fail.Fail].err{fail.message("resolve query produced no result")}; }
    ret res[*resolve.ResolveResult, fail.Fail].ok{rr};
}

# a module's syntax tree: inside an operation the parse it acquires, which a computation reading
# it depends on, and between operations the one this project's operations last published. nil
# when the module has none, and inside an operation when the parse could not be acquired: the
# operation keeps that failure and ends with it, so nothing built on the nil is published
pub fun syntax(p: *project.Project, m: *project.ModuleEntry) *ast.Ast {
    if (base_source.file_is_nil(m.file_id)) { ret nil; }
    if (p.s.queries.operation_active) {
        val res_acquired: res[ParsedModule, fail.Fail] = parse(p, m);
        if (sel res_acquired.err) { ret nil; }
        ret res_acquired.ok.a;
    }
    val opt_shown: opt[ParsedModule] = parsed(p, m);
    if (sel opt_shown.none) { ret nil; }
    ret opt_shown.some.a;
}

# a module's parse as this project's operations last published it
pub fun parsed(p: *project.Project, m: *project.ModuleEntry) opt[ParsedModule] {
    if (base_source.file_is_nil(m.file_id)) { ret opt[ParsedModule].none{}; }
    val opt_shown: opt[query.QueryView] = query.published(?p.s.queries, ?PARSE, base_source.file_index(m.file_id)::u64, p.since);
    if (sel opt_shown.none) { ret opt[ParsedModule].none{}; }
    val view: query.QueryView = opt_shown.some;
    ret opt[ParsedModule].some{@(codec.handle_bytes(view.value, view.value_len, $size_of(ParsedModule))::ptr::*ParsedModule)};
}

# a module's resolution as this project's operations last published it, nil when none did
pub fun resolved(p: *project.Project, m: *project.ModuleEntry) *resolve.ResolveResult {
    val opt_shown: opt[query.QueryView] = query.published(?p.s.queries, ?RESOLVE, module.stable_index(m.stable_id)::u64, p.since);
    if (sel opt_shown.none) { ret nil; }
    ret codec.resolve_handle_decode(opt_shown.some);
}

# a module's types as this project's operations last published them, nil when none did
pub fun typed(p: *project.Project, m: *project.ModuleEntry) *sema_product.SemaResult {
    val opt_shown: opt[query.QueryView] = query.published(?p.s.queries, ?SEMA, module.stable_index(m.stable_id)::u64, p.since);
    if (sel opt_shown.none) { ret nil; }
    ret sema_handle_decode(opt_shown.some);
}

# the standing of the load walk alone, over every module it reached
pub fun load_status(p: *project.Project) report_phase.PhaseStatus {
    var status: report_phase.PhaseStatus = report_phase.accepted();
    var i:      u32                      = 0;
    for (i < project.module_count(p)) {
        report_phase.merge(?status, project.module_at(p, i).load.status);
        i = i + 1;
    }
    ret status;
}

# the standing of one module: its load's and that of each product this project's operations
# published for it
pub fun module_status(p: *project.Project, m: *project.ModuleEntry) report_phase.PhaseStatus {
    var status:    report_phase.PhaseStatus = m.load.status;
    val opt_shown: opt[ParsedModule]        = parsed(p, m);
    if (sel opt_shown.some) { report_phase.merge(?status, opt_shown.some.status); }
    val rr: *resolve.ResolveResult   = resolved(p, m);
    val sr: *sema_product.SemaResult = typed(p, m);
    if (rr != nil) { report_phase.merge(?status, rr.status); }
    if (sr != nil) { report_phase.merge(?status, sr.status); }
    ret status;
}

# the standing of the front end over every module
pub fun frontend_status(p: *project.Project) report_phase.PhaseStatus {
    var status: report_phase.PhaseStatus = report_phase.accepted();
    var i:      u32                      = 0;
    for (i < project.module_count(p)) {
        report_phase.merge(?status, module_status(p, project.module_at(p, i)));
        i = i + 1;
    }
    ret status;
}

# a parse product: the syntax tree it owns and how the parse stood
pub rec ParsedModule {
    a:      *ast.Ast;
    status: report_phase.PhaseStatus;
}

fun parsed_definition(ctx: ptr, mid: module.ModuleId) res[resolve.ParsedDefinition, fail.Fail] {
    val p: *project.Project = ctx::*project.Project;
    if (p == nil || module.is_nil(mid) || mid::u32 >= project.module_count(p)) {
        ret res[resolve.ParsedDefinition, fail.Fail].err{fail.message("parsed definition module is not in the active project")};
    }
    val m:            *project.ModuleEntry         = project.module_at(p, mid::u32);
    val file_id:      base_source.FileId           = m.file_id;
    val res_acquired: res[ParsedModule, fail.Fail] = parse(p, m);
    if (sel res_acquired.err) { ret res[resolve.ParsedDefinition, fail.Fail].err{res_acquired.err}; }
    val a:      *ast.Ast                 = res_acquired.ok.a;
    val status: report_phase.PhaseStatus = res_acquired.ok.status;
    ret res[resolve.ParsedDefinition, fail.Fail].ok{resolve.ParsedDefinition{a: a, status: status, owner: resolve.type_owner(p.s, mid, file_id), incarnation: a.incarnation}};
}

fun parse_compute(raw: ptr, kind: *query.Kind, key: u64, alloc: *A.Allocator, diags: *diagnostic.DiagnosticStore) res[query.QueryOutput, fail.Fail] {
    val p:       *project.Project   = raw::*project.Project;
    val s:       *session.Session   = p.s;
    val file_id: base_source.FileId = base_source.file_id(key::u32);

    val err_depend: err[fail.Fail] = query.depend[project.Project](?p.queries, p, ?session.FILE_TEXT, key);
    if (sel err_depend.err) { ret res[query.QueryOutput, fail.Fail].err{err_depend.err}; }

    val opt_file: opt[*base_source.SourceFile] = base_source.get(s.sources, file_id);
    if (sel opt_file.none) { ret res[query.QueryOutput, fail.Fail].err{fail.message("parse: the file is not registered with the session")}; }
    val file: *base_source.SourceFile = opt_file.some;
    if (p.ahead != nil) {
        val opt_taken: opt[readahead.Taken] = readahead.parse_for(p.ahead, file.path);
        if (sel opt_taken.some) {
            val res_merged: res[query.QueryOutput, fail.Fail] = parse_merged(s, file_id, alloc, diags, opt_taken.some);
            readahead.release(p.ahead, file.path);
            ret res_merged;
        }
    }

    val res_tok: res[front_lexer.TokenStream, fail.Fail] = front_lexer.tokenize(file.text, alloc, file_id);
    if (sel res_tok.err) { ret res[query.QueryOutput, fail.Fail].err{res_tok.err}; }
    var stream: front_lexer.TokenStream = res_tok.ok;
    fin { front_lexer.dnit(?stream, alloc); }

    val res_allocate: res[*ast.Ast, A.Error] = A.allocate[ast.Ast](alloc, 1::usize);
    if (sel res_allocate.err) { ret res[query.QueryOutput, fail.Fail].err{fail.refused(res_allocate.err)}; }
    val a: *ast.Ast = res_allocate.ok;
    a[0] = ast.init(alloc, file_id);
    var handed: bool = false;
    fin {
        if (!handed) {
            ast.dnit(a);
            A.deallocate[ast.Ast](alloc, a, 1::usize);
        }
    }
    val res_incarnation: res[u64, fail.Fail] = session.next_parse_incarnation(s);
    if (sel res_incarnation.err) { ret res[query.QueryOutput, fail.Fail].err{res_incarnation.err}; }
    a.incarnation = res_incarnation.ok;

    val err_emit_diagnostics: err[fail.Fail] = front_lexer.emit_diagnostics(?stream, diags);
    if (sel err_emit_diagnostics.err) { ret res[query.QueryOutput, fail.Fail].err{err_emit_diagnostics.err}; }
    val res_parse: res[report_phase.PhaseStatus, state.ParseFail] = front_parser.parse(?stream, a, s.interner, diags);
    if (sel res_parse.err) {
        val f: state.ParseFail = res_parse.err;
        ret res[query.QueryOutput, fail.Fail].err{state.failure(f)};
    }

    handed = true;
    ret ast_handle_encode(alloc, a, res_parse.ok);
}

# a parse a worker made ahead of the walk, merged as `parse_compute` would have made it here: its
# tree copied onto `alloc`, its incarnation, its reports in the order they were made, placed in
# `file_id`, and its names interned in the order the parse interned them, so its tree names them by
# the ids a parse on this thread gives
fun parse_merged(s: *session.Session, file_id: base_source.FileId, alloc: *A.Allocator, diags: *diagnostic.DiagnosticStore,
    t: readahead.Taken) res[query.QueryOutput, fail.Fail] {
    val res_allocate: res[*ast.Ast, A.Error] = A.allocate[ast.Ast](alloc, 1::usize);
    if (sel res_allocate.err) { ret res[query.QueryOutput, fail.Fail].err{fail.refused(res_allocate.err)}; }
    val a:        *ast.Ast                = res_allocate.ok;
    val res_copy: res[ast.Ast, fail.Fail] = ast.copy(t.tree, alloc);
    if (sel res_copy.err) {
        A.deallocate[ast.Ast](alloc, a, 1::usize);
        ret res[query.QueryOutput, fail.Fail].err{res_copy.err};
    }
    a[0] = res_copy.ok;
    var handed: bool = false;
    fin {
        if (!handed) {
            ast.dnit(a);
            A.deallocate[ast.Ast](alloc, a, 1::usize);
        }
    }
    a.file_id = file_id;
    val res_incarnation: res[u64, fail.Fail] = session.next_parse_incarnation(s);
    if (sel res_incarnation.err) { ret res[query.QueryOutput, fail.Fail].err{res_incarnation.err}; }
    a.incarnation = res_incarnation.ok;
    var i: usize = 0;
    for (i < t.diags.items.len) {
        val d:          *diagnostic.Diagnostic = ?t.diags.items.data[i];
        val err_report: err[fail.Fail]         = diagnostic.report(diags, d.kind, file_id, d.loc.span, d.message);
        if (sel err_report.err) { ret res[query.QueryOutput, fail.Fail].err{err_report.err}; }
        i = i + 1;
    }
    val res_remap: res[intern.Remap, A.Error] = intern.child_reintern(t.names, s.interner, alloc);
    if (sel res_remap.err) { ret res[query.QueryOutput, fail.Fail].err{fail.refused(res_remap.err)}; }
    var remap: intern.Remap = res_remap.ok;
    ast.names_remap(a, ?remap);
    intern.remap_dnit(alloc, ?remap);
    if (t.failed) { ret res[query.QueryOutput, fail.Fail].err{state.failure(t.fatal)}; }
    handed = true;
    ret ast_handle_encode(alloc, a, status_placed(t.status, file_id));
}

# a parse's status with a refusal placed in no file yet placed in `file_id`
fun status_placed(status: report_phase.PhaseStatus, file_id: base_source.FileId) report_phase.PhaseStatus {
    val kind: report_phase.PhaseKind = status.kind;
    if (!sel kind.internal) { ret status; }
    var placed: report_phase.PhaseStatus = status;
    placed.kind = report_phase.PhaseKind.internal{fail.placed(kind.internal, file_id)};
    ret placed;
}

fun parse_finalize(value: *u8, value_len: u32, alloc: *A.Allocator) {
    val a: *ast.Ast = (codec.handle_bytes(value, value_len, $size_of(ParsedModule))::ptr::*ParsedModule).a;
    ast.dnit(a);
    A.deallocate[ast.Ast](alloc, a, 1::usize);
}

fun ast_handle_encode(alloc: *A.Allocator, a: *ast.Ast, status: report_phase.PhaseStatus) res[query.QueryOutput, fail.Fail] {
    val n:            u32               = $size_of(ParsedModule)::u32;
    val res_allocate: res[*u8, A.Error] = A.allocate[u8](alloc, n::usize);
    if (sel res_allocate.err) {
        ast.dnit(a);
        A.deallocate[ast.Ast](alloc, a, 1::usize);
        ret res[query.QueryOutput, fail.Fail].err{fail.refused(res_allocate.err)};
    }
    val buf:  *u8           = res_allocate.ok;
    val slot: *ParsedModule = buf::ptr::*ParsedModule;
    slot.a      = a;
    slot.status = status;
    var out: query.QueryOutput;
    out.bytes = buf;
    out.len   = n;
    ret res[query.QueryOutput, fail.Fail].ok{out};
}

# what a module's resolution exports: the symbols and refusal an importer's resolution reads, and
# the constants the module publishes, a change of which is a change of its interface
# ---
# symbols:    the importer's view, its path and module named by the reader
# constants:  the published constants, each a plain value
# definition: the revision of the module's parse when a constant names an element of it, else 0
rec Exports {
    symbols:        resolve.ModuleExports;
    constants:      *resolve.ExportConstant;
    constant_count: u32;
    definition:     query.Revision;
}

fun exports_compute(raw: ptr, kind: *query.Kind, key: u64, alloc: *A.Allocator, diags: *diagnostic.DiagnosticStore) res[query.QueryOutput, fail.Fail] {
    val p:                 *project.Project                = raw::*project.Project;
    val res_queries_entry: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, ?RESOLVE, key);
    if (sel res_queries_entry.err) { ret res[query.QueryOutput, fail.Fail].err{res_queries_entry.err}; }
    val rr: *resolve.ResolveResult = codec.resolve_handle_decode(res_queries_entry.ok);
    if (rr == nil) { ret res[query.QueryOutput, fail.Fail].err{fail.message("exports: the module has no resolve result")}; }

    var definition_revision: query.Revision = 0;
    var i:                   u32            = 0;
    for (i < rr.public_constant_count) {
        if (rr.public_constants[i].present && rr.public_constants[i].value.kind == comptime_value.CT_KIND_CONST_ELEM) {
            val mid: module.ModuleId = module.module_id_for_stable(?p.s.modules, key::u32::module.StableModuleId);
            if (module.is_nil(mid)) { ret res[query.QueryOutput, fail.Fail].err{fail.message("constant definition is not loaded")}; }
            val res_observed: res[query.Revision, fail.Fail] = query.revision[project.Project](?p.queries, p,
                ?PARSE, base_source.file_index(project.module_at(p, mid::u32).file_id)::u64);
            if (sel res_observed.err) { ret res[query.QueryOutput, fail.Fail].err{res_observed.err}; }
            definition_revision = res_observed.ok;
            brk;
        }
        i = i + 1;
    }
    i = 0;
    for (i < rr.public_constant_count) {
        val opt_refused: opt[str] = constant_refusal(?rr.public_constants[i], definition_revision);
        if (sel opt_refused.some) { ret res[query.QueryOutput, fail.Fail].err{fail.message(opt_refused.some)}; }
        i = i + 1;
    }
    val res_boxed: res[*Exports, A.Error] = A.allocate[Exports](alloc, 1);
    if (sel res_boxed.err) { ret res[query.QueryOutput, fail.Fail].err{fail.refused(res_boxed.err)}; }
    val ex: *Exports = res_boxed.ok;
    @ex = Exports{definition: definition_revision};
    var handed: bool = false;
    fin {
        if (!handed) { exports_dnit(ex, alloc); }
    }
    val res_symbols: res[resolve.ModuleExports, fail.Fail] = resolve.result_exports(alloc, rr, intern.STR_NIL, key::u32::module.StableModuleId);
    if (sel res_symbols.err) { ret res[query.QueryOutput, fail.Fail].err{res_symbols.err}; }
    ex.symbols = res_symbols.ok;
    if (rr.public_constant_count != 0) {
        val res_constants: res[*resolve.ExportConstant, A.Error] = A.allocate[resolve.ExportConstant](alloc, rr.public_constant_count::usize);
        if (sel res_constants.err) { ret res[query.QueryOutput, fail.Fail].err{fail.refused(res_constants.err)}; }
        memory.raw_copy(res_constants.ok::ptr, rr.public_constants::ptr, rr.public_constant_count::usize * $size_of(resolve.ExportConstant));
        ex.constants      = res_constants.ok;
        ex.constant_count = rr.public_constant_count;
    }
    val res_out: res[query.QueryOutput, fail.Fail] = pointer_output(alloc, ex::ptr);
    if (sel res_out.ok) { handed = true; }
    ret res_out;
}

fun exports_of(value: *u8, value_len: u32) *Exports {
    ret (codec.handle_bytes(value, value_len, $size_of(ptr))::ptr::*ptr)[0]::*Exports;
}

fun exports_dnit(ex: *Exports, alloc: *A.Allocator) {
    resolve.exports_dnit(alloc, ?ex.symbols);
    if (ex.constant_count != 0) { A.deallocate[resolve.ExportConstant](alloc, ex.constants, ex.constant_count::usize); }
    A.deallocate[Exports](alloc, ex, 1);
}

fun exports_finalize(value: *u8, value_len: u32, alloc: *A.Allocator) {
    exports_dnit(exports_of(value, value_len), alloc);
}

# two exports are the same when an importer reads the same symbols and refusal and the module
# publishes the same constants
fun exports_equal(left: *u8, left_len: u32, right: *u8, right_len: u32) bool {
    val l: *Exports = exports_of(left, left_len);
    val r: *Exports = exports_of(right, right_len);
    if (l.symbols.count != r.symbols.count || l.symbols.refused != r.symbols.refused) { ret false; }
    if (l.constant_count != r.constant_count || l.definition != r.definition)         { ret false; }
    var i: u32 = 0;
    for (i < l.symbols.count) {
        if (!symbol_same(?l.symbols.symbols[i], ?r.symbols.symbols[i])) { ret false; }
        i = i + 1;
    }
    i = 0;
    for (i < l.constant_count) {
        if (!constant_same(?l.constants[i], ?r.constants[i])) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun symbol_same(l: *resolve.PublicSymbol, r: *resolve.PublicSymbol) bool {
    ret l.kind == r.kind && l.name::u32 == r.name::u32 && l.canon::u32 == r.canon::u32 && l.file::u32 == r.file::u32
        && l.generic_arity == r.generic_arity && l.has_comptime_params == r.has_comptime_params
        && l.has_pack_param == r.has_pack_param && deprecation_same(l.deprecation, r.deprecation)
        && l.testing == r.testing && l.slot == r.slot && l.origin::u32 == r.origin::u32;
}

fun deprecation_same(l: deprecation.Deprecation, r: deprecation.Deprecation) bool {
    ret l.present == r.present && l.owner::u32 == r.owner::u32 && l.message::u32 == r.message::u32;
}

fun constant_same(l: *resolve.ExportConstant, r: *resolve.ExportConstant) bool {
    if (l.name::u32 != r.name::u32 || l.present != r.present) { ret false; }
    ret !l.present || value_same(?l.value, ?r.value);
}

# two published constant values are the same when they hold the same value of the same kind;
# a constant element is the same element of the same revision of its definition, which the
# owner compares beside it
fun value_same(l: *comptime_value.CTValue, r: *comptime_value.CTValue) bool {
    if (l.kind != r.kind) { ret false; }
    val k: comptime_value.CTKind = l.kind;
    if (k == comptime_value.CT_KIND_INT) {
        ret l.data.w.lo == r.data.w.lo && l.data.w.hi == r.data.w.hi && l.int_width == r.int_width && l.int_unsigned == r.int_unsigned;
    }
    if (k == comptime_value.CT_KIND_FLOAT)                                          { ret float.f64_bits(l.data.f) == float.f64_bits(r.data.f) && l.float_width == r.float_width; }
    if (k == comptime_value.CT_KIND_STR || k == comptime_value.CT_KIND_NON_INTEGER) { ret l.data.s::u32 == r.data.s::u32; }
    if (k == comptime_value.CT_KIND_TYPE)                                           { ret l.data.t == r.data.t; }
    if (k == comptime_value.CT_KIND_FIELD || k == comptime_value.CT_KIND_CASE) {
        ret l.data.fld.owner == r.data.fld.owner && l.data.fld.index == r.data.fld.index;
    }
    if (k == comptime_value.CT_KIND_PACK_ELEM) { ret l.data.pelem.index == r.data.pelem.index && l.data.pelem.ty == r.data.pelem.ty; }
    if (k == comptime_value.CT_KIND_NODE) {
        ret l.data.node.module == r.data.node.module && l.data.node.shape == r.data.node.shape && l.data.node.at == r.data.node.at && l.data.node.ty == r.data.node.ty;
    }
    if (k == comptime_value.CT_KIND_CONST_ELEM) { ret l.data.celem.elem == r.data.celem.elem && l.data.celem.ty == r.data.celem.ty; }
    ret false;
}

# why a constant cannot be published, none when it can: its value is of a kind an interface
# holds, and a constant element names a definition whose revision is known
fun constant_refusal(item: *resolve.ExportConstant, definition: query.Revision) opt[str] {
    if (!item.present) { ret opt[str].none{}; }
    val k: comptime_value.CTKind = item.value.kind;
    if (k == comptime_value.CT_KIND_CONST_ELEM) {
        if (definition == 0) { ret opt[str].some{"constant element surface requires its current definition revision"}; }
        ret opt[str].none{};
    }
    if (k == comptime_value.CT_KIND_INT || k == comptime_value.CT_KIND_FLOAT || k == comptime_value.CT_KIND_STR
        || k == comptime_value.CT_KIND_NON_INTEGER || k == comptime_value.CT_KIND_TYPE || k == comptime_value.CT_KIND_FIELD
        || k == comptime_value.CT_KIND_CASE || k == comptime_value.CT_KIND_PACK_ELEM || k == comptime_value.CT_KIND_NODE) {
        ret opt[str].none{};
    }
    ret opt[str].some{"constant surface has an unknown CTKind"};
}

# a product whose bytes are one pointer to what it owns
fun pointer_output(alloc: *A.Allocator, owned: ptr) res[query.QueryOutput, fail.Fail] {
    val res_bytes: res[*u8, A.Error] = A.allocate[u8](alloc, $size_of(ptr));
    if (sel res_bytes.err) { ret res[query.QueryOutput, fail.Fail].err{fail.refused(res_bytes.err)}; }
    val slot: *ptr = res_bytes.ok::ptr::*ptr;
    slot[0] = owned;
    ret res[query.QueryOutput, fail.Fail].ok{query.QueryOutput{bytes: res_bytes.ok, len: $size_of(ptr)::u32}};
}

rec LowerClosure {
    list:  *module.ModuleId;
    count: u32;
    cap:   u32;
}

# a module's definition as far as a phase reads it, through the products of this operation
pub fun read_definition(raw: ptr, mid: module.ModuleId, phase: sema_product.DefinitionPhase) res[sema_product.Definition, fail.Fail] {
    val p:          *project.Project                         = raw::*project.Project;
    val res_parsed: res[resolve.ParsedDefinition, fail.Fail] = parsed_definition(raw, mid);
    if (sel res_parsed.err) { ret res[sema_product.Definition, fail.Fail].err{res_parsed.err}; }
    var result: sema_product.Definition = sema_product.Definition{
        parsed: res_parsed.ok, origin: mid, decorators: ?project.module_at(p, mid::u32).load.ctx
    };
    if (phase >= sema_product.DEFINITION_RESOLVED) {
        val err_viewed: err[fail.Fail] = depend_load_view(p, project.module_at(p, mid::u32));
        if (sel err_viewed.err) { ret res[sema_product.Definition, fail.Fail].err{err_viewed.err}; }
        val res_acquired: res[*resolve.ResolveResult, fail.Fail] = resolution(p, project.module_at(p, mid::u32));
        if (sel res_acquired.err) { ret res[sema_product.Definition, fail.Fail].err{res_acquired.err}; }
        result.rr = res_acquired.ok;
    }
    if (phase == sema_product.DEFINITION_TYPED) {
        val res_acquired: res[*sema_product.SemaResult, fail.Fail] = acquire_sema(p, mid);
        if (sel res_acquired.err) { ret res[sema_product.Definition, fail.Fail].err{res_acquired.err}; }
        result.sr = res_acquired.ok;
        val res_scoped: res[*comptime_scope.ComptimeCtx, fail.Fail] = lower_scope_for(p, project.module_at(p, mid::u32), res_parsed.ok.a, result.rr, result.sr);
        if (sel res_scoped.err) { ret res[sema_product.Definition, fail.Fail].err{res_scoped.err}; }
        result.ctx = res_scoped.ok;
    }
    ret res[sema_product.Definition, fail.Fail].ok{result};
}

# the lowering scope of a module as a definition read sees it, made or brought up to date
fun lower_scope_for(p: *project.Project, m: *project.ModuleEntry, a: *ast.Ast, rr: *resolve.ResolveResult,
    sr: *sema_product.SemaResult) res[*comptime_scope.ComptimeCtx, fail.Fail] {
    val err_prepared: err[fail.Fail] = lower_scope_prepare(m, a, rr, sr);
    if (sel err_prepared.err) { ret res[*comptime_scope.ComptimeCtx, fail.Fail].err{err_prepared.err}; }
    ret res[*comptime_scope.ComptimeCtx, fail.Fail].ok{?m.lower_scope};
}

# the scope lowering binds a module's constants in, over what the load, resolve and sema bound
# over it, made on the first call and kept for as long as the module's syntax stands; each call
# sets the layers to the products given, the module's current ones, so it runs only where
# nothing else reads them
fun lower_scope_prepare(m: *project.ModuleEntry, a: *ast.Ast, rr: *resolve.ResolveResult, sr: *sema_product.SemaResult) err[fail.Fail] {
    var exprs:    u32                      = 0;
    var resolved: *comptime_scope.Bindings = nil;
    var typed:    *comptime_scope.Bindings = nil;
    if (a != nil)  { exprs = a.exprs.len::u32; }
    if (rr != nil) { resolved = ?rr.constants; }
    if (sr != nil) { typed = ?sr.constants; }
    ret comptime_scope.lowering_prepare(?m.lower_scope, ?m.lower_scoped, ?m.load.ctx, exprs, resolved, typed);
}

fun resolve_compute(raw: ptr, kind: *query.Kind, key: u64, alloc: *A.Allocator, diags: *diagnostic.DiagnosticStore) res[query.QueryOutput, fail.Fail] {
    val p: *project.Project = raw::*project.Project;
    val s: *session.Session = p.s;

    val stable: module.StableModuleId = key::u32::module.StableModuleId;
    val mid:    module.ModuleId       = module.module_id_for_stable(?s.modules, stable);
    if (module.is_nil(mid)) { ret res[query.QueryOutput, fail.Fail].err{fail.message("resolve: the stable id is not loaded this build")}; }
    val m:          *project.ModuleEntry                     = project.module_at(p, mid::u32);
    val res_parsed: res[resolve.ParsedDefinition, fail.Fail] = parsed_definition(p::ptr, mid);
    if (sel res_parsed.err) { ret res[query.QueryOutput, fail.Fail].err{res_parsed.err}; }
    val a:          *ast.Ast       = res_parsed.ok.a;
    val err_depend: err[fail.Fail] = query.depend[project.Project](?p.queries, p, ?context.TARGET, 0);
    if (sel err_depend.err) { ret res[query.QueryOutput, fail.Fail].err{err_depend.err}; }
    val err_depend_load_view: err[fail.Fail] = depend_load_view(p, m);
    if (sel err_depend_load_view.err) { ret res[query.QueryOutput, fail.Fail].err{err_depend_load_view.err}; }

    val res_deps: res[resolve.ResolveDeps, fail.Fail] = build_resolve_deps_owned(p, m);
    if (sel res_deps.err) { ret res[query.QueryOutput, fail.Fail].err{res_deps.err}; }
    var deps: resolve.ResolveDeps = res_deps.ok;
    fin { resolve.deps_dnit(s.alloc, ?deps); }
    deps.bindings      = m.load.bindings.data;
    deps.binding_count = m.load.bindings.len::u32;

    val res_resolve: res[resolve.ResolveResult, fail.Fail] = resolve.resolve(s, a, ?deps, ?m.load.ctx, mid, m.stable_id, diags);
    if (sel res_resolve.err) { ret res[query.QueryOutput, fail.Fail].err{res_resolve.err}; }
    var result: resolve.ResolveResult = res_resolve.ok;

    val res_allocate: res[*resolve.ResolveResult, A.Error] = A.allocate[resolve.ResolveResult](alloc, 1::usize);
    if (sel res_allocate.err) {
        resolve.result_dnit(?result);
        ret res[query.QueryOutput, fail.Fail].err{fail.refused(res_allocate.err)};
    }
    val box: *resolve.ResolveResult = res_allocate.ok;
    box[0] = result;
    ret codec.resolve_handle_encode(alloc, box);
}

fun resolve_finalize(value: *u8, value_len: u32, alloc: *A.Allocator) {
    val r: *resolve.ResolveResult = codec.resolve_handle_decode(query.QueryView{value: value, value_len: value_len});
    resolve.result_dnit(r);
    A.deallocate[resolve.ResolveResult](alloc, r, 1::usize);
}

# what a module exports to an importer, read from its exports product so the importer's
# resolution depends on that surface and nothing else of the module
fun exporter_exports(raw: ptr, mid: module.ModuleId, a: *A.Allocator) res[resolve.ModuleExports, fail.Fail] {
    val p:           *project.Project                = raw::*project.Project;
    val m:           *project.ModuleEntry            = project.module_at(p, mid::u32);
    val res_surface: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, ?EXPORTS, module.stable_index(m.stable_id)::u64);
    if (sel res_surface.err) { ret res[resolve.ModuleExports, fail.Fail].err{res_surface.err}; }
    val ex: *Exports = exports_of(res_surface.ok.value, res_surface.ok.value_len);
    ret resolve.exports_copy(a, ?ex.symbols, m.fqn, m.stable_id);
}

fun exporter_path(raw: ptr, mid: module.ModuleId) intern.StrId {
    ret project.module_at(raw::*project.Project, mid::u32).fqn;
}

fun build_resolve_deps_owned(p: *project.Project, m: *project.ModuleEntry) res[resolve.ResolveDeps, fail.Fail] {
    var from: resolve.Exporters = resolve.Exporters{
        ctx: p::ptr, count: project.module_count(p), exports: exporter_exports, path: exporter_path
    };
    ret resolve.deps_of(p.s.alloc, p.s, ?p.loader, ?m.load, ?from);
}

# a module's sema product in the open operation, its field graph installed in the projection.
# once the module's front-end products are given back (products_dnit) only kept_sema reads it
pub fun acquire_sema(p: *project.Project, mid: module.ModuleId) res[*sema_product.SemaResult, fail.Fail] {
    if (!module.is_nil(mid) && mid::u32 < project.module_count(p) && project.module_at(p, mid::u32).released) {
        ret res[*sema_product.SemaResult, fail.Fail].err{fail.message("a released module's typing was read again")};
    }
    ret kept_sema(p, mid);
}

# what a module's sema product keeps once its front-end products are given back: its status,
# refusal, interface and field graph, the graph installed in the projection. the rest of it is
# acquire_sema's
pub fun kept_sema(p: *project.Project, mid: module.ModuleId) res[*sema_product.SemaResult, fail.Fail] {
    if (module.is_nil(mid) || mid::u32 >= project.module_count(p)) {
        ret res[*sema_product.SemaResult, fail.Fail].err{fail.message("semantic definition module is not in the active project")};
    }
    val stable:       module.StableModuleId           = project.module_at(p, mid::u32).stable_id;
    val res_acquired: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, ?SEMA, module.stable_index(stable)::u64);
    ret sema_kept(p, res_acquired);
}

# the semantic product of module `mid` as `reads` reads it, its field graph installed
pub fun kept_sema_read(p: *project.Project, reads: *query.Reads, mid: module.ModuleId) res[*sema_product.SemaResult, fail.Fail] {
    if (module.is_nil(mid) || mid::u32 >= project.module_count(p)) {
        ret res[*sema_product.SemaResult, fail.Fail].err{fail.message("semantic definition module is not in the active project")};
    }
    val stable: module.StableModuleId = project.module_at(p, mid::u32).stable_id;
    ret sema_kept(p, reads.read(reads.ctx, ?SEMA, module.stable_index(stable)::u64));
}

fun sema_kept(p: *project.Project, res_acquired: res[query.QueryView, fail.Fail]) res[*sema_product.SemaResult, fail.Fail] {
    if (sel res_acquired.err) { ret res[*sema_product.SemaResult, fail.Fail].err{res_acquired.err}; }
    val result: *sema_product.SemaResult = sema_handle_decode(res_acquired.ok);
    if (result == nil) { ret res[*sema_product.SemaResult, fail.Fail].err{fail.message("semantic query produced no result owner")}; }
    val err_installed: err[fail.Fail] = sema_fields.install(p.s, ?result.field_graph);
    if (sel err_installed.err) { ret res[*sema_product.SemaResult, fail.Fail].err{err_installed.err}; }
    ret res[*sema_product.SemaResult, fail.Fail].ok{result};
}

fun sema_compute(raw: ptr, kind: *query.Kind, key: u64, alloc: *A.Allocator, diags: *diagnostic.DiagnosticStore) res[query.QueryOutput, fail.Fail] {
    val p: *project.Project = raw::*project.Project;
    val s: *session.Session = p.s;

    val stable: module.StableModuleId = key::u32::module.StableModuleId;
    val mid:    module.ModuleId       = module.module_id_for_stable(?s.modules, stable);
    if (module.is_nil(mid)) { ret res[query.QueryOutput, fail.Fail].err{fail.message("sema: the stable id is not loaded this build")}; }
    val m:          *project.ModuleEntry                     = project.module_at(p, mid::u32);
    val res_parsed: res[resolve.ParsedDefinition, fail.Fail] = parsed_definition(p::ptr, mid);
    if (sel res_parsed.err) { ret res[query.QueryOutput, fail.Fail].err{res_parsed.err}; }
    # whatever asked for it, the module's front end runs: the build reads its typing and presents
    # its own reports from here on, not its record's
    m.frontend_skipped = false;
    val definition: resolve.ParsedDefinition = res_parsed.ok;
    if (sel definition.status.kind.internal) { ret res[query.QueryOutput, fail.Fail].err{report_phase.phase_failure(definition.status)}; }
    val a:          *ast.Ast       = definition.a;
    val err_viewed: err[fail.Fail] = depend_load_view(p, m);
    if (sel err_viewed.err) { ret res[query.QueryOutput, fail.Fail].err{err_viewed.err}; }
    val res_resolved: res[*resolve.ResolveResult, fail.Fail] = resolution(p, m);
    if (sel res_resolved.err) { ret res[query.QueryOutput, fail.Fail].err{res_resolved.err}; }
    val rr:         *resolve.ResolveResult = res_resolved.ok;
    val err_depend: err[fail.Fail]         = query.depend[project.Project](?p.queries, p, ?context.TARGET, 0);
    if (sel err_depend.err) { ret res[query.QueryOutput, fail.Fail].err{err_depend.err}; }
    val err_depend_queries: err[fail.Fail] = query.depend[project.Project](?p.queries, p, ?MODULE_NUMBER, key);
    if (sel err_depend_queries.err) { ret res[query.QueryOutput, fail.Fail].err{err_depend_queries.err}; }

    val res_sdeps: res[sema_product.SemaDeps, fail.Fail] = build_sema_deps_query(p, m);
    if (sel res_sdeps.err) { ret res[query.QueryOutput, fail.Fail].err{res_sdeps.err}; }
    var sdeps: sema_product.SemaDeps = res_sdeps.ok;

    val res_sem: res[sema_product.SemaResult, fail.Fail] = sema_module.sema(s, a, rr, ?sdeps, ?m.load.ctx, mid, diags);
    sema_deps_query_dnit(s.alloc, ?sdeps);
    if (sel res_sem.err) { ret res[query.QueryOutput, fail.Fail].err{res_sem.err}; }
    var result: sema_product.SemaResult = res_sem.ok;
    var handed: bool                    = false;
    fin {
        if (!handed) { sema_product.result_dnit(?result); }
    }
    # a rejected parse still types, as the recovered tree is for, and the
    # product carries the parse rejection so the module stays rejected
    report_phase.merge(?result.status, definition.status);

    var ei: u32 = 0;
    for (ei < result.embed_path_count) {
        val err_depend: err[fail.Fail] = query.depend[project.Project](?p.queries, p, ?session_embed.EMBED_FILE, intern.str_index(result.embed_paths[ei])::u64);
        if (sel err_depend.err) { ret res[query.QueryOutput, fail.Fail].err{err_depend.err}; }
        ei = ei + 1;
    }

    val res_allocate: res[*sema_product.SemaResult, A.Error] = A.allocate[sema_product.SemaResult](alloc, 1::usize);
    if (sel res_allocate.err) { ret res[query.QueryOutput, fail.Fail].err{fail.refused(res_allocate.err)}; }
    val box: *sema_product.SemaResult = res_allocate.ok;
    box[0] = result;
    handed = true;
    ret sema_handle_encode(alloc, box);
}

fun sema_finalize(value: *u8, value_len: u32, alloc: *A.Allocator) {
    val r: *sema_product.SemaResult = sema_handle_decode(query.QueryView{value: value, value_len: value_len});
    sema_product.result_dnit(r);
    A.deallocate[sema_product.SemaResult](alloc, r, 1::usize);
}

fun sema_handle_encode(alloc: *A.Allocator, r: *sema_product.SemaResult) res[query.QueryOutput, fail.Fail] {
    val n:            u32               = $size_of(ptr)::u32;
    val res_allocate: res[*u8, A.Error] = A.allocate[u8](alloc, n::usize);
    if (sel res_allocate.err) {
        sema_product.result_dnit(r);
        A.deallocate[sema_product.SemaResult](alloc, r, 1::usize);
        ret res[query.QueryOutput, fail.Fail].err{fail.refused(res_allocate.err)};
    }
    val buf:  *u8  = res_allocate.ok;
    val slot: *ptr = buf::ptr::*ptr;
    slot[0] = r::ptr;
    var out: query.QueryOutput;
    out.bytes = buf;
    out.len   = n;
    ret res[query.QueryOutput, fail.Fail].ok{out};
}

fun sema_handle_decode(e: query.QueryView) *sema_product.SemaResult {
    val slot: *ptr = codec.handle_bytes(e.value, e.value_len, $size_of(ptr))::ptr::*ptr;
    ret slot[0]::*sema_product.SemaResult;
}

fun build_sema_deps_query(p: *project.Project, m: *project.ModuleEntry) res[sema_product.SemaDeps, fail.Fail] {
    var deps: sema_product.SemaDeps = sema_product.SemaDeps{};
    deps.definitions = sema_product.reader_init(p::ptr, read_definition, p.s.alloc);
    val res_surfaces: res[Surfaces, fail.Fail] = closure_surfaces(p, m);
    if (sel res_surfaces.err) {
        sema_product.reader_dnit(?deps.definitions);
        ret res[sema_product.SemaDeps, fail.Fail].err{res_surfaces.err};
    }
    val err_set: err[A.Error] = sema_product.surfaces_set(?deps, res_surfaces.ok.entries, res_surfaces.ok.count, p.s.alloc);
    if (sel err_set.err) {
        sema_deps_query_dnit(p.s.alloc, ?deps);
        ret res[sema_product.SemaDeps, fail.Fail].err{fail.refused(err_set.err)};
    }
    ret res[sema_product.SemaDeps, fail.Fail].ok{deps};
}

# the typed surface of every module in the closure of `m`'s imports, in closure order
fun closure_surfaces(p: *project.Project, m: *project.ModuleEntry) res[Surfaces, fail.Fail] {
    val res_closure: res[LowerClosure, fail.Fail] = collect_lower_closure(p, m);
    if (sel res_closure.err) { ret res[Surfaces, fail.Fail].err{res_closure.err}; }
    var imports: LowerClosure = res_closure.ok;
    fin { lower_closure_dnit(p.s.alloc, ?imports); }
    if (imports.count == 0) { ret res[Surfaces, fail.Fail].ok{Surfaces{entries: nil, count: 0}}; }
    val res_allocated: res[**sema_product.ModuleSema, A.Error] = A.allocate[*sema_product.ModuleSema](p.s.alloc, imports.count::usize);
    if (sel res_allocated.err) { ret res[Surfaces, fail.Fail].err{fail.refused(res_allocated.err)}; }
    val entries: **sema_product.ModuleSema = res_allocated.ok;
    var i:       u32                       = 0;
    for (i < imports.count) {
        val res_shared: res[*sema_product.ModuleSema, fail.Fail] = typed_surface_of(p, imports.list[i]);
        if (sel res_shared.err) {
            A.deallocate[*sema_product.ModuleSema](p.s.alloc, entries, imports.count::usize);
            ret res[Surfaces, fail.Fail].err{res_shared.err};
        }
        entries[i] = res_shared.ok;
        i          = i + 1;
    }
    ret res[Surfaces, fail.Fail].ok{Surfaces{entries: entries, count: imports.count}};
}

# the surfaces are the project's, so only the borrowing array and its index are released
fun sema_deps_query_dnit(alloc: *A.Allocator, deps: *sema_product.SemaDeps) {
    sema_product.reader_dnit(?deps.definitions);
    sema_product.surfaces_dnit(deps, alloc);
}

# a module's typed surface, shared by every importer, its field graph installed in the projection
# on each read
fun typed_surface_of(p: *project.Project, mid: module.ModuleId) res[*sema_product.ModuleSema, fail.Fail] {
    if (module.is_nil(mid) || mid::u32 >= project.module_count(p)) { ret res[*sema_product.ModuleSema, fail.Fail].err{fail.message("typed surface module is not loaded")}; }
    val m:            *project.ModuleEntry            = project.module_at(p, mid::u32);
    val res_acquired: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, ?TYPED_EXPORTS, module.stable_index(m.stable_id)::u64);
    if (sel res_acquired.err) { ret res[*sema_product.ModuleSema, fail.Fail].err{res_acquired.err}; }
    val surface:       *sema_product.ModuleSema = surface_handle_decode(res_acquired.ok);
    val err_installed: err[fail.Fail]           = sema_fields.install(p.s, ?surface.graph);
    if (sel err_installed.err) { ret res[*sema_product.ModuleSema, fail.Fail].err{err_installed.err}; }
    ret res[*sema_product.ModuleSema, fail.Fail].ok{surface};
}

fun surface_handle_decode(e: query.QueryView) *sema_product.ModuleSema {
    ret (codec.handle_bytes(e.value, e.value_len, $size_of(ptr))::ptr::*ptr)[0]::*sema_product.ModuleSema;
}

fun surface_dnit(surface: *sema_product.ModuleSema, alloc: *A.Allocator) {
    sema_product.module_sema_dnit(surface);
    A.deallocate[sema_product.ModuleSema](alloc, surface, 1::usize);
}

fun surface_finalize(value: *u8, value_len: u32, alloc: *A.Allocator) {
    surface_dnit(surface_handle_decode(query.QueryView{value: value, value_len: value_len}), alloc);
}

# two typed surfaces are the same when they export the same rows and reach the same field recipes;
# the index a reader builds and where the graph was installed are not part of either
fun surface_equal(left: *u8, left_len: u32, right: *u8, right_len: u32) bool {
    val l: *sema_product.ModuleSema = surface_handle_decode(query.QueryView{value: left, value_len: left_len});
    val r: *sema_product.ModuleSema = surface_handle_decode(query.QueryView{value: right, value_len: right_len});
    if (l.refused != r.refused || l.exports.len != r.exports.len || l.graph.nodes.len != r.graph.nodes.len) { ret false; }
    var i: usize = 0;
    for (i < l.exports.len) {
        val lr: *sema_product.TypeExport = ?l.exports.data[i];
        val rr: *sema_product.TypeExport = ?r.exports.data[i];
        if (lr.origin::u32 != rr.origin::u32 || lr.canon::u32 != rr.canon::u32 || lr.ty::u32 != rr.ty::u32) { ret false; }
        if (!constant_same(?lr.constant, ?rr.constant))                                                     { ret false; }
        i = i + 1;
    }
    i = 0;
    for (i < l.graph.nodes.len) {
        val ln: *sema_fields.Node = ?l.graph.nodes.data[i];
        val rn: *sema_fields.Node = ?r.graph.nodes.data[i];
        if (ln.ty::u32 != rn.ty::u32 || ln.disc::u32 != rn.disc::u32 || ln.entries.len != rn.entries.len) { ret false; }
        if (ln.decoration.align != rn.decoration.align || ln.decoration.packed != rn.decoration.packed
            || ln.decoration.volatile_ != rn.decoration.volatile_) { ret false; }
        var j: usize = 0;
        for (j < ln.entries.len) {
            val le: *type_field.Entry = ?ln.entries.data[j];
            val re: *type_field.Entry = ?rn.entries.data[j];
            if (le.name::u32 != re.name::u32 || le.ty::u32 != re.ty::u32 || !deprecation_same(le.deprecation, re.deprecation)) { ret false; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret true;
}

# a module's typed surface copied for a reader that owns it, under the id this build numbers the
# module with, its field graph installed in the projection
fun read_typed_surface(p: *project.Project, mid: module.ModuleId, a: *A.Allocator) res[sema_product.ModuleSema, fail.Fail] {
    if (module.is_nil(mid) || mid::u32 >= project.module_count(p)) { ret res[sema_product.ModuleSema, fail.Fail].err{fail.message("typed surface module is not loaded")}; }
    val res_acquired: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p,
        ?TYPED_EXPORTS, module.stable_index(project.module_at(p, mid::u32).stable_id)::u64);
    if (sel res_acquired.err) { ret res[sema_product.ModuleSema, fail.Fail].err{res_acquired.err}; }
    var owned:      sema_product.ModuleSema = sema_product.module_sema_init(a, project.module_at(p, mid::u32).fqn, mid, project.module_at(p, mid::u32).stable_id);
    val err_copied: err[fail.Fail]          = surface_copy(surface_handle_decode(res_acquired.ok), ?owned);
    if (sel err_copied.err) {
        sema_product.module_sema_dnit(?owned);
        ret res[sema_product.ModuleSema, fail.Fail].err{err_copied.err};
    }
    val err_installed: err[fail.Fail] = sema_fields.install(p.s, ?owned.graph);
    if (sel err_installed.err) {
        sema_product.module_sema_dnit(?owned);
        ret res[sema_product.ModuleSema, fail.Fail].err{err_installed.err};
    }
    ret res[sema_product.ModuleSema, fail.Fail].ok{owned};
}

# the rows, field recipes and refusal of `from` appended to `into`, from `into`'s allocator
fun surface_copy(from: *sema_product.ModuleSema, into: *sema_product.ModuleSema) err[fail.Fail] {
    into.refused = from.refused;
    val res_rows: res[usize, A.Error] = collections_vector.reserve[sema_product.TypeExport](?into.exports, from.exports.len);
    if (sel res_rows.err) { ret err[fail.Fail].err{fail.refused(res_rows.err)}; }
    var i: usize = 0;
    for (i < from.exports.len) {
        collections_vector.push[sema_product.TypeExport](?into.exports, from.exports.data[i]);
        i = i + 1;
    }
    val res_nodes: res[usize, A.Error] = collections_vector.reserve[sema_fields.Node](?into.graph.nodes, from.graph.nodes.len);
    if (sel res_nodes.err) { ret err[fail.Fail].err{fail.refused(res_nodes.err)}; }
    i = 0;
    for (i < from.graph.nodes.len) {
        val source: *sema_fields.Node = ?from.graph.nodes.data[i];
        var node:   sema_fields.Node  = sema_fields.Node{
            ty: source.ty, entries: collections_vector.init[type_field.Entry](into.exports.a), decoration: source.decoration, disc: source.disc
        };
        val res_entries: res[usize, A.Error] = collections_vector.reserve[type_field.Entry](?node.entries, source.entries.len);
        if (sel res_entries.err) { ret err[fail.Fail].err{fail.refused(res_entries.err)}; }
        var j: usize = 0;
        for (j < source.entries.len) {
            collections_vector.push[type_field.Entry](?node.entries, source.entries.data[j]);
            j = j + 1;
        }
        collections_vector.push[sema_fields.Node](?into.graph.nodes, node);
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# resolve reads the dep list, the gate states and the bound constants from the load walk, not through a
# query. they are one digest per module, its load view, an input every product that reads them depends
# on. a dependent folds a dep's stable id, not its view, so an edit inside the dep reaches the dependent
# only through the dep's products
fun parse_revision(p: *project.Project, m: *project.ModuleEntry) query.Revision {
    ret query.peek_revision(?p.s.queries, ?PARSE, base_source.file_index(m.file_id)::u64);
}

fun fold_bound_const(p: *project.Project, m: *project.ModuleEntry, entry: *comptime_scope.NamedConst, fb: *wire.Sink) err[fail.Fail] {
    wire.put_u32(fb, entry.name::u32);
    ret codec.ct_value_encode(fb, ?entry.value, m.stable_id, parse_revision(p, m));
}

# a bound element may name an element of the exporter's definition, so its revision is folded then
fun fold_const_import(p: *project.Project, exporter: *project.ModuleEntry, elements: bool, fb: *wire.Sink) {
    wire.put_u32(fb, exporter.stable_id::u32);
    if (elements) { wire.put_u64(fb, parse_revision(p, exporter)); }
}

# everything resolve reads from the load walk rather than through a query
fun fold_load_view(p: *project.Project, m: *project.ModuleEntry, fb: *wire.Sink) err[fail.Fail] {
    # the artifact the walk attributed the module to is what its gates and bodies read as
    # `$bin.name`, so a module another artifact reaches first is typed again
    base_fingerprint.put_name(fb, p.s.interner, m.load.artifact);
    wire.put_u32(fb, project.dep_count(m));
    var i: u32 = 0;
    for (i < project.dep_count(m)) {
        wire.put_u32(fb, module.stable_index(m.load.deps.data[i::usize]));
        i = i + 1;
    }
    val made: *comptime_scope.Bindings = ?m.load.ctx.own;
    wire.put_u32(fb, made.gate_count);
    i = 0;
    for (i < made.gate_count) {
        wire.put_u8(fb, made.gate_states[i]::u8);
        i = i + 1;
    }
    var elements: bool = false;
    wire.put_u32(fb, made.entries_len);
    i = 0;
    for (i < made.entries_len) {
        if (made.entries[i].value.kind == comptime_value.CT_KIND_CONST_ELEM) { elements = true; }
        val err_bound: err[fail.Fail] = fold_bound_const(p, m, ?made.entries[i], fb);
        if (sel err_bound.err) { ret err_bound; }
        i = i + 1;
    }
    wire.put_u32(fb, made.deferred_len);
    i = 0;
    for (i < made.deferred_len) {
        wire.put_u32(fb, made.deferred[i]::u32);
        i = i + 1;
    }
    wire.put_u32(fb, m.load.bindings.len::u32);
    i = 0;
    for (i::usize < m.load.bindings.len) {
        val b: *front_load.Binding = ?m.load.bindings.data[i::usize];
        wire.put_u32(fb, ast_id.decl_index(b.decl));
        wire.put_u8(fb, b.kind::u8);
        wire.put_u32(fb, intern.str_index(b.name));
        if (b.constant) { fold_const_import(p, project.module_at(p, front_load.module_of(?p.loader, b.module)::u32), elements, fb); }
        or              { wire.put_u32(fb, module.stable_index(b.module)); }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# set each module's load view from what the walk left it; an unchanged view is no change
pub fun record_load_views(p: *project.Project) err[fail.Fail] {
    var digest: [32]u8;
    var i:      u32 = 0;
    for (i < p.topo_len) {
        val m:          *project.ModuleEntry = project.module_at(p, p.topo[i]::u32);
        var fb:         wire.Sink            = wire.digest();
        val err_folded: err[fail.Fail]       = fold_load_view(p, m, ?fb);
        if (sel err_folded.err) { ret err_folded; }
        val opt_failed: opt[fail.Fail] = wire.failure(?fb);
        if (sel opt_failed.some) { ret err[fail.Fail].err{opt_failed.some}; }
        wire.digest_final(?fb, ?digest);
        val err_stored: err[fail.Fail] = query.set_input(?p.s.queries, ?LOAD_VIEW, module.stable_index(m.stable_id)::u64, ?digest[0], 32);
        if (sel err_stored.err) { ret err_stored; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# a product that reads the load walk's state depends on the module's view, so a view change reaches it
fun depend_load_view(p: *project.Project, m: *project.ModuleEntry) err[fail.Fail] {
    ret query.depend[project.Project](?p.queries, p, ?LOAD_VIEW, module.stable_index(m.stable_id)::u64);
}

fun typed_exports_compute(raw: ptr, kind: *query.Kind, key: u64, alloc: *A.Allocator, diags: *diagnostic.DiagnosticStore) res[query.QueryOutput, fail.Fail] {
    val p: *project.Project = raw::*project.Project;
    val s: *session.Session = p.s;

    val stable: module.StableModuleId = key::u32::module.StableModuleId;
    val mid:    module.ModuleId       = module.module_id_for_stable(?s.modules, stable);
    if (module.is_nil(mid)) { ret res[query.QueryOutput, fail.Fail].err{fail.message("typed exports: the stable id is not loaded this build")}; }
    val m:            *project.ModuleEntry                     = project.module_at(p, mid::u32);
    val res_acquired: res[*sema_product.SemaResult, fail.Fail] = acquire_sema(p, mid);
    if (sel res_acquired.err) { ret res[query.QueryOutput, fail.Fail].err{res_acquired.err}; }
    val sr:         *sema_product.SemaResult = res_acquired.ok;
    val err_viewed: err[fail.Fail]           = depend_load_view(p, m);
    if (sel err_viewed.err) { ret res[query.QueryOutput, fail.Fail].err{err_viewed.err}; }
    val res_resolved: res[*resolve.ResolveResult, fail.Fail] = resolution(p, m);
    if (sel res_resolved.err) { ret res[query.QueryOutput, fail.Fail].err{res_resolved.err}; }
    val rr: *resolve.ResolveResult = res_resolved.ok;
    # a rejected module still publishes what it typed, so its importers are checked against it:
    # a declaration it could not type carries the error type, which no importer reports again
    if (sel rr.status.kind.internal) { ret res[query.QueryOutput, fail.Fail].err{rr.status.kind.internal}; }
    if (sel sr.status.kind.internal) { ret res[query.QueryOutput, fail.Fail].err{sr.status.kind.internal}; }

    var owner:        sema_surface.Owner                      = surface_owner(p, mid);
    var origins:      sema_surface.Origins                    = sema_surface.Origins{ctx: p::ptr, read: origin_read};
    val res_captured: res[sema_product.ModuleSema, fail.Fail] = sema_surface.exports(s, ?owner, rr, sr, ?origins, alloc);
    if (sel res_captured.err) { ret res[query.QueryOutput, fail.Fail].err{res_captured.err}; }
    var surface: sema_product.ModuleSema = res_captured.ok;
    var handed:  bool                    = false;
    surface.refused = refusal.is_refused(?rr.refusal) || refusal.is_refused(?sr.refusal);
    fin {
        if (!handed) { sema_product.module_sema_dnit(?surface); }
    }
    var j: usize = 0;
    for (j < surface.exports.len) {
        val opt_refused: opt[str] = constant_refusal(?surface.exports.data[j].constant, 0);
        if (sel opt_refused.some) { ret res[query.QueryOutput, fail.Fail].err{fail.message(opt_refused.some)}; }
        j = j + 1;
    }
    val res_graph: res[sema_fields.Graph, fail.Fail] = sema_surface.graph(s, ?surface);
    if (sel res_graph.err) { ret res[query.QueryOutput, fail.Fail].err{res_graph.err}; }
    surface.graph = res_graph.ok;
    # a shared surface outlives the build that numbered the modules, so it names its module by path alone
    surface.module = module.MODULE_NIL;
    val res_boxed: res[*sema_product.ModuleSema, A.Error] = A.allocate[sema_product.ModuleSema](alloc, 1::usize);
    if (sel res_boxed.err) { ret res[query.QueryOutput, fail.Fail].err{fail.refused(res_boxed.err)}; }
    res_boxed.ok[0] = surface;
    handed          = true;
    val res_out: res[query.QueryOutput, fail.Fail] = pointer_output(alloc, res_boxed.ok::ptr);
    if (sel res_out.err) { surface_dnit(res_boxed.ok, alloc); }
    ret res_out;
}

fun lower_visit_reserve(p: *project.Project, needed: u32) err[fail.Fail] {
    val old:       u32          = p.lower_visit_cap;
    val err_grown: err[A.Error] = growth.reserve[u32](p.s.alloc, ?p.lower_visit_gen, ?p.lower_visit_cap, needed::usize);
    if (sel err_grown.err) { ret err[fail.Fail].err{fail.refused(err_grown.err)}; }
    var i: u32 = old;
    for (i < p.lower_visit_cap) {
        p.lower_visit_gen[i] = 0;
        i                    = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# a gated module is not this build's, and only an arm this build does not select imports it
fun collect_lower_closure(p: *project.Project, m: *project.ModuleEntry) res[LowerClosure, fail.Fail] {
    var cl: LowerClosure;
    cl.list  = nil;
    cl.count = 0;
    cl.cap   = 0;
    if (project.dep_count(m) == 0 || project.module_count(p) == 0) { ret res[LowerClosure, fail.Fail].ok{cl}; }

    val err_lower_visit_reserve: err[fail.Fail] = lower_visit_reserve(p, project.module_count(p));
    if (sel err_lower_visit_reserve.err) { ret res[LowerClosure, fail.Fail].err{err_lower_visit_reserve.err}; }
    p.lower_visit_epoch = p.lower_visit_epoch + 1;
    val epoch: u32  = p.lower_visit_epoch;
    val gen:   *u32 = p.lower_visit_gen;

    val res_allocate: res[*module.ModuleId, A.Error] = A.allocate[module.ModuleId](p.s.alloc, project.module_count(p)::usize);
    if (sel res_allocate.err) { ret res[LowerClosure, fail.Fail].err{fail.refused(res_allocate.err)}; }
    val list:     *module.ModuleId = res_allocate.ok;
    var list_len: u32              = 0;

    var i: u32 = 0;
    for (i < project.dep_count(m)) {
        val d: module.ModuleId = project.dep_at(p, m, i);
        if (d::u32 < project.module_count(p) && gen[d::u32] != epoch && !project.module_at(p, d::u32).load.gated) {
            gen[d::u32]    = epoch;
            list[list_len] = d;
            list_len       = list_len + 1;
        }
        i = i + 1;
    }

    var head: u32 = 0;
    for (head < list_len) {
        val cur: module.ModuleId      = list[head];
        val cm:  *project.ModuleEntry = project.module_at(p, cur::u32);
        var j:   u32                  = 0;
        for (j < project.dep_count(cm)) {
            val d: module.ModuleId = project.dep_at(p, cm, j);
            if (d::u32 < project.module_count(p) && gen[d::u32] != epoch && !project.module_at(p, d::u32).load.gated) {
                gen[d::u32]    = epoch;
                list[list_len] = d;
                list_len       = list_len + 1;
            }
            j = j + 1;
        }
        head = head + 1;
    }

    cl.list  = list;
    cl.count = list_len;
    cl.cap   = project.module_count(p);
    ret res[LowerClosure, fail.Fail].ok{cl};
}

# what typing the instance `item` reads besides its declaring module's definition: the typed
# surfaces of every module the declaring module imports, and of every module declaring a type
# its arguments or pack name with what each of those imports, transitively, each field graph
# installed. reading them is what makes the instance's typing depend on them
pub fun instance_deps(p: *project.Project, item: *sema_instance.Instance) res[sema_product.SemaDeps, fail.Fail] {
    if (module.is_nil(item.origin) || item.origin::u32 >= project.module_count(p)) {
        ret res[sema_product.SemaDeps, fail.Fail].err{fail.message("instance typing: the declaring module is not loaded")};
    }
    var owners: collections_vector.Vector[module.ModuleId] = collections_vector.init[module.ModuleId](p.s.alloc);
    fin { collections_vector.dnit[module.ModuleId](?owners); }
    val err_named: err[fail.Fail] = instance_reads(p, item, ?owners);
    if (sel err_named.err) { ret res[sema_product.SemaDeps, fail.Fail].err{err_named.err}; }
    var read: collections_vector.Vector[*sema_product.ModuleSema] = collections_vector.init[*sema_product.ModuleSema](p.s.alloc);
    fin { collections_vector.dnit[*sema_product.ModuleSema](?read); }
    val err_around: err[fail.Fail] = surfaces_into(p, item.origin, ?read);
    if (sel err_around.err) { ret res[sema_product.SemaDeps, fail.Fail].err{err_around.err}; }
    var k: usize = 1;
    for (k < owners.len) {
        var seen: bool  = false;
        var j:    usize = 0;
        for (j < k) {
            if (owners.data[j]::u32 == owners.data[k]::u32) { seen = true; }
            j = j + 1;
        }
        if (!seen) {
            val res_own: res[*sema_product.ModuleSema, fail.Fail] = typed_surface_of(p, owners.data[k]);
            if (sel res_own.err) { ret res[sema_product.SemaDeps, fail.Fail].err{res_own.err}; }
            val res_pushed: res[usize, A.Error] = collections_vector.push[*sema_product.ModuleSema](?read, res_own.ok);
            if (sel res_pushed.err) { ret res[sema_product.SemaDeps, fail.Fail].err{fail.refused(res_pushed.err)}; }
            val err_beyond: err[fail.Fail] = surfaces_into(p, owners.data[k], ?read);
            if (sel err_beyond.err) { ret res[sema_product.SemaDeps, fail.Fail].err{err_beyond.err}; }
        }
        k = k + 1;
    }
    var deps: sema_product.SemaDeps = sema_product.SemaDeps{};
    deps.definitions = sema_product.reader_init(p::ptr, read_definition, p.s.alloc);
    if (read.len == 0) { ret res[sema_product.SemaDeps, fail.Fail].ok{deps}; }
    val res_allocated: res[**sema_product.ModuleSema, A.Error] = A.allocate[*sema_product.ModuleSema](p.s.alloc, read.len);
    if (sel res_allocated.err) {
        sema_product.reader_dnit(?deps.definitions);
        ret res[sema_product.SemaDeps, fail.Fail].err{fail.refused(res_allocated.err)};
    }
    k = 0;
    for (k < read.len) {
        res_allocated.ok[k] = read.data[k];
        k                   = k + 1;
    }
    val err_set: err[A.Error] = sema_product.surfaces_set(?deps, res_allocated.ok, read.len::u32, p.s.alloc);
    if (sel err_set.err) {
        sema_deps_query_dnit(p.s.alloc, ?deps);
        ret res[sema_product.SemaDeps, fail.Fail].err{fail.refused(err_set.err)};
    }
    ret res[sema_product.SemaDeps, fail.Fail].ok{deps};
}

# the modules the instance `item` names: its declaring module first, then every module declaring
# a type its arguments or pack name
pub fun instance_reads(p: *project.Project, item: *sema_instance.Instance, out: *collections_vector.Vector[module.ModuleId]) err[fail.Fail] {
    val res_pushed: res[usize, A.Error] = collections_vector.push[module.ModuleId](out, item.origin);
    if (sel res_pushed.err) { ret err[fail.Fail].err{fail.refused(res_pushed.err)}; }
    var i: u32 = 0;
    for (i < item.arg_len) {
        val err_named: err[fail.Fail] = type_owners(p, item.args[i], out, 0);
        if (sel err_named.err) { ret err_named; }
        i = i + 1;
    }
    i = 0;
    for (i < item.pack_len) {
        val err_named: err[fail.Fail] = type_owners(p, item.pack[i], out, 0);
        if (sel err_named.err) { ret err_named; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# release what instance_deps made
pub fun instance_deps_dnit(p: *project.Project, deps: *sema_product.SemaDeps) {
    sema_deps_query_dnit(p.s.alloc, deps);
}

# the surfaces around module `mid`, its INSTANCE_SURFACES, pushed onto `out`, each graph installed
fun surfaces_into(p: *project.Project, mid: module.ModuleId, out: *collections_vector.Vector[*sema_product.ModuleSema]) err[fail.Fail] {
    val m:                 *project.ModuleEntry            = project.module_at(p, mid::u32);
    val res_queries_entry: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, ?INSTANCE_SURFACES, module.stable_index(m.stable_id)::u64);
    if (sel res_queries_entry.err) { ret err[fail.Fail].err{res_queries_entry.err}; }
    val held: *Surfaces = (codec.handle_bytes(res_queries_entry.ok.value, res_queries_entry.ok.value_len, $size_of(ptr))::ptr::*ptr)[0]::*Surfaces;
    var i:    u32       = 0;
    for (i < held.count) {
        val err_installed: err[fail.Fail] = sema_fields.install(p.s, ?held.entries[i].graph);
        if (sel err_installed.err) { ret err_installed; }
        val res_pushed: res[usize, A.Error] = collections_vector.push[*sema_product.ModuleSema](out, held.entries[i]);
        if (sel res_pushed.err) { ret err[fail.Fail].err{fail.refused(res_pushed.err)}; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# the typed surfaces INSTANCE_SURFACES holds, borrowed from their own products, which it depends on
rec Surfaces {
    entries: **sema_product.ModuleSema;
    count:   u32;
}

fun instance_surfaces_compute(raw: ptr, kind: *query.Kind, key: u64, alloc: *A.Allocator, diags: *diagnostic.DiagnosticStore) res[query.QueryOutput, fail.Fail] {
    val p:   *project.Project = raw::*project.Project;
    val mid: module.ModuleId  = module.module_id_for_stable(?p.s.modules, key::u32::module.StableModuleId);
    if (module.is_nil(mid)) { ret res[query.QueryOutput, fail.Fail].err{fail.message("instance surfaces: the stable id is not loaded this build")}; }
    val res_made: res[Surfaces, fail.Fail] = closure_surfaces(p, project.module_at(p, mid::u32));
    if (sel res_made.err) { ret res[query.QueryOutput, fail.Fail].err{res_made.err}; }
    val res_boxed: res[*Surfaces, A.Error] = A.allocate[Surfaces](p.s.alloc, 1);
    if (sel res_boxed.err) {
        if (res_made.ok.entries != nil) { A.deallocate[*sema_product.ModuleSema](p.s.alloc, res_made.ok.entries, res_made.ok.count::usize); }
        ret res[query.QueryOutput, fail.Fail].err{fail.refused(res_boxed.err)};
    }
    @res_boxed.ok = res_made.ok;
    val res_out: res[query.QueryOutput, fail.Fail] = pointer_output(alloc, res_boxed.ok::ptr);
    if (sel res_out.err) { surfaces_dnit(res_boxed.ok, p.s.alloc); }
    ret res_out;
}

fun surfaces_dnit(held: *Surfaces, alloc: *A.Allocator) {
    if (held.entries != nil) { A.deallocate[*sema_product.ModuleSema](alloc, held.entries, held.count::usize); }
    A.deallocate[Surfaces](alloc, held, 1);
}

fun instance_surfaces_finalize(value: *u8, value_len: u32, alloc: *A.Allocator) {
    surfaces_dnit((codec.handle_bytes(value, value_len, $size_of(ptr))::ptr::*ptr)[0]::*Surfaces, alloc);
}

# the modules declaring a nominal type `ty` names, through pointers, arrays, signatures and the
# arguments of other instances, each pushed onto `out`
fun type_owners(p: *project.Project, ty: type_kind.TypeId, out: *collections_vector.Vector[module.ModuleId], depth: u32) err[fail.Fail] {
    if (depth > 64 || type_kind.is_nil(ty) || type_kind.is_error(ty)) { ret err[fail.Fail].ok{}; }
    val opt_found: opt[*type.Type] = type.get(p.s.types, ty);
    if (sel opt_found.none) { ret err[fail.Fail].ok{}; }
    val t: *type.Type = opt_found.some;
    if (t.kind == type_kind.TYPE_REC || t.kind == type_kind.TYPE_UNI || t.kind == type_kind.TYPE_TAG) {
        val mid: module.ModuleId = module.module_id_for_stable(?p.s.modules, t.data.nominal.owner.module);
        if (module.is_nil(mid)) { ret err[fail.Fail].ok{}; }
        val res_pushed: res[usize, A.Error] = collections_vector.push[module.ModuleId](out, mid);
        if (sel res_pushed.err) { ret err[fail.Fail].err{fail.refused(res_pushed.err)}; }
        ret err[fail.Fail].ok{};
    }
    if (t.kind == type_kind.TYPE_POINTER) { ret type_owners(p, t.data.pointer.base, out, depth + 1); }
    if (t.kind == type_kind.TYPE_SECRET)  { ret type_owners(p, t.data.secret.base, out, depth + 1); }
    if (t.kind == type_kind.TYPE_ARRAY)   { ret type_owners(p, t.data.array.base, out, depth + 1); }
    if (t.kind == type_kind.TYPE_FUN) {
        val err_type_owners: err[fail.Fail] = type_owners(p, t.data.fn.ret_type, out, depth + 1);
        if (sel err_type_owners.err) { ret err_type_owners; }
        ret pool_owners(p, t.data.fn.params_start, t.data.fn.params_len, out, depth);
    }
    if (t.kind == type_kind.TYPE_INSTANCE) {
        val err_type_owners: err[fail.Fail] = type_owners(p, t.data.instance.nominal, out, depth + 1);
        if (sel err_type_owners.err) { ret err_type_owners; }
        ret pool_owners(p, t.data.instance.args_start, t.data.instance.args_len, out, depth);
    }
    ret err[fail.Fail].ok{};
}

fun pool_owners(p: *project.Project, start: u32, len: u32, out: *collections_vector.Vector[module.ModuleId], depth: u32) err[fail.Fail] {
    var i: u32 = 0;
    for (i < len) {
        val opt_param: opt[type_kind.TypeId] = type.get_param(p.s.types, start + i);
        if (sel opt_param.some) {
            val err_type_owners: err[fail.Fail] = type_owners(p, opt_param.some, out, depth + 1);
            if (sel err_type_owners.err) { ret err_type_owners; }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# release a lowering closure; an empty one owns no list
fun lower_closure_dnit(alloc: *A.Allocator, cl: *LowerClosure) {
    if (cl.list == nil || cl.cap == 0) { ret; }
    A.deallocate[module.ModuleId](alloc, cl.list, cl.cap::usize);
    cl.list  = nil;
    cl.count = 0;
    cl.cap   = 0;
}

# the module whose typed surface the project builds, as the front end names it
fun surface_owner(p: *project.Project, mid: module.ModuleId) sema_surface.Owner {
    val m: *project.ModuleEntry = project.module_at(p, mid::u32);
    ret sema_surface.Owner{module: mid, stable: m.stable_id, path: m.fqn, ctx: ?m.load.ctx};
}

fun origin_read(raw: ptr, mid: module.ModuleId, a: *A.Allocator) res[sema_product.ModuleSema, fail.Fail] {
    ret read_typed_surface(raw::*project.Project, mid, a);
}

# open a query operation over the project: the build context must be as it was frozen, and the
# type projections the last operation installed are reset
pub fun begin_query_phase(p: *project.Project) res[query.Operation, fail.Fail] {
    val err_unchanged: err[fail.Fail] = context.unchanged(p);
    if (sel err_unchanged.err) { ret res[query.Operation, fail.Fail].err{err_unchanged.err}; }
    val err_reset: err[fail.Fail] = session.reset_type_projection(p.s);
    if (sel err_reset.err) {
        ret res[query.Operation, fail.Fail].err{err_reset.err};
    }
    val res_begun: res[query.Operation, fail.Fail] = query.begin(?p.s.queries);
    if (sel res_begun.err) {
        ret res[query.Operation, fail.Fail].err{res_begun.err};
    }
    project.fresh_staged_dnit(p);
    ret res[query.Operation, fail.Fail].ok{res_begun.ok};
}

# the session's store is rebuilt from the project's and the query presentation's,
# dropping the warnings a declaration's `#[expect]` acknowledges and the ones their
# owner's governance hides or silences, then reporting each judged expectation nothing
# fulfilled. a warning replayed from the cache passes through here as a fresh one does
pub fun refresh_diagnostics(p: *project.Project) err[fail.Fail] {
    var staged: diagnostic.DiagnosticStore = diagnostic.store_init(p.s.alloc);
    var handed: bool                       = false;
    fin {
        if (!handed) { diagnostic.store_dnit(?staged); }
    }
    val err_governed: err[fail.Fail] = govern(p, ?staged);
    if (sel err_governed.err) { ret err_governed; }
    var expects:      collections_vector.Vector[diagnostic.Expectation] = collections_vector.init[diagnostic.Expectation](p.s.alloc);
    val err_gathered: err[fail.Fail]                                    = gather_expectations(p, ?expects);
    val err_indexed:  err[fail.Fail]                                    = diagnostic.expect(?staged, expects);
    if (sel err_gathered.err) { ret err[fail.Fail].err{err_gathered.err}; }
    if (sel err_indexed.err)  { ret err[fail.Fail].err{err_indexed.err}; }
    var err_copied: err[fail.Fail] = diagnostic.replay_into(?staged, ?p.diags);
    val copied_ok:  bool           = sel err_copied.ok && p.s.queries.presentation != nil;
    if (copied_ok) {
        err_copied = diagnostic.replay_into(?staged, ?p.s.queries.presentation.diags);
    }
    if (sel err_copied.err) { ret err[fail.Fail].err{err_copied.err}; }
    val err_recorded: err[fail.Fail] = replay_recorded(p, ?staged);
    if (sel err_recorded.err) { ret err_recorded; }
    diagnostic.report_unfulfilled(?staged);
    drop_refused(p, ?staged);
    val err_placed: err[fail.Fail] = place_refusals(p, ?staged);
    if (sel err_placed.err) { ret err_placed; }
    diagnostic.set_origin(?staged, p.s.diags.origin);
    diagnostic.store_dnit(?p.s.diags);
    p.s.diags = staged;
    handed    = true;
    ret err[fail.Fail].ok{};
}

# who owns each warning and how the owner governs it. a warning belongs to the package that
# owns the file it stands in: the project being built shows its own under the profile's
# `allow`, and a warning standing in no package's file is its. whether a dependency's are shown
# is the registry's `module_warned`, as every warning-only pass reads it, and a shown one is
# governed by the `allow` of the profile it selects as a build of it would with no profile
# named, so the root's `allow` never silences a dependency's warning nor the reverse. errors
# and notes belong to the build whoever owns them
fun govern(p: *project.Project, store: *diagnostic.DiagnosticStore) err[fail.Fail] {
    diagnostic.govern(store, diagnostic.Governance{shown: true, silenced: p.req.allow});
    var owners: map.Map[intern.StrId, u32] = map.init[intern.StrId, u32](p.s.alloc);
    fin { map.dnit[intern.StrId, u32](?owners); }
    var i: u32 = 0;
    for (i < project.module_count(p)) {
        val m:     *project.ModuleEntry = project.module_at(p, i);
        val shown: bool                 = module.module_warned(?p.s.modules, module.id(i));
        i = i + 1;
        if (m.load.home.root || base_source.file_is_nil(m.file_id)) { cnt; }
        var package:   intern.StrId = m.load.home.package;
        val opt_owner: opt[*u32]    = map.get[intern.StrId, u32](?owners, ?package);
        var owner:     u32          = 0;
        if (sel opt_owner.some) { owner = @opt_owner.some; }
        or {
            val res_added: res[u32, fail.Fail] = diagnostic.owner_add(store, dependency_governance(p, package, shown));
            if (sel res_added.err) { ret err[fail.Fail].err{res_added.err}; }
            owner = res_added.ok;
            val res_noted: res[bool, A.Error] = map.insert[intern.StrId, u32](?owners, package, owner);
            if (sel res_noted.err) { ret err[fail.Fail].err{fail.refused(res_noted.err)}; }
        }
        val err_owned: err[fail.Fail] = diagnostic.own(store, m.file_id, owner);
        if (sel err_owned.err) { ret err_owned; }
    }
    ret err[fail.Fail].ok{};
}

# how the dependency `package` governs its warnings in this build: hidden unless `shown`, and
# when shown under the `allow` its configuration resolved from the profile its own manifest
# selects with no profile named. a package the closure holds no manifest of silences nothing
fun dependency_governance(p: *project.Project, package: intern.StrId, shown: bool) diagnostic.Governance {
    var g: diagnostic.Governance = diagnostic.Governance{shown: shown, silenced: diagnostic_kind.set_make()};
    if (!g.shown) { ret g; }
    var i: u32 = 0;
    for (i < p.config.dep_count) {
        if (p.config.deps[i].project_id == package) {
            g.silenced = p.config.dep_allow[i];
            ret g;
        }
        i = i + 1;
    }
    ret g;
}

# a refused module's file shows the module-scope `$error`s that fired in it, and the file of
# one refused by an import shows nothing. the load reports before any refusal is decided, and
# a refusal typing decides comes after the module's resolution reported, so what those said
# of a refused module goes here
fun drop_refused(p: *project.Project, store: *diagnostic.DiagnosticStore) {
    var i: u32 = 0;
    for (i < project.module_count(p)) {
        val m: *project.ModuleEntry = project.module_at(p, i);
        i = i + 1;
        if (base_source.file_is_nil(m.file_id)) { cnt; }
        val r: *refusal.Refusal = refusal_of(p, m);
        if (r != nil) { diagnostic.drop_file_except(store, m.file_id, r.sites.data, r.sites.len); }
    }
}

# a module refused by its own `$error` that is not a file of the project is reported at the
# import in the project's own source that reaches it, directly or through modules refused by
# their imports, with each `$error` that fired as a related site, and its own file then shows
# nothing. one diagnostic stands for each such module, at the first import that reaches it: the
# project's files in the order the build loaded them, each file's imports in their order. a
# project file refused by its own `$error` reports there, and the walk stops at one refused by
# an import, which reports at its own imports. a refused module no project import reaches keeps
# its `$error`s where they are
fun place_refusals(p: *project.Project, store: *diagnostic.DiagnosticStore) err[fail.Fail] {
    val count: u32 = project.module_count(p);
    if (!placeable(p)) { ret err[fail.Fail].ok{}; }
    val res_placed: res[*bool, A.Error] = A.zallocate[bool](p.s.alloc, count::usize);
    if (sel res_placed.err) { ret err[fail.Fail].err{fail.refused(res_placed.err)}; }
    fin { A.deallocate[bool](p.s.alloc, res_placed.ok, count::usize); }
    val res_seen: res[*bool, A.Error] = A.zallocate[bool](p.s.alloc, count::usize);
    if (sel res_seen.err) { ret err[fail.Fail].err{fail.refused(res_seen.err)}; }
    fin { A.deallocate[bool](p.s.alloc, res_seen.ok, count::usize); }
    var stack: collections_vector.Vector[module.ModuleId] = collections_vector.init[module.ModuleId](p.s.alloc);
    fin { collections_vector.dnit[module.ModuleId](?stack); }
    var i: u32 = 0;
    for (i < count) {
        val m: *project.ModuleEntry = project.module_at(p, i);
        i = i + 1;
        if (!m.load.home.root || base_source.file_is_nil(m.file_id)) { cnt; }
        var k: usize = 0;
        for (k < m.load.bindings.len) {
            val b: *front_load.Binding = ?m.load.bindings.data[k];
            k = k + 1;
            if (b.kind == front_load.BINDING_UNBOUND) { cnt; }
            val mid: module.ModuleId = front_load.module_of(?p.loader, b.module);
            if (module.is_nil(mid))                                   { cnt; }
            if (refusal_of(p, project.module_at(p, mid::u32)) == nil) { cnt; }
            memory.zero[bool](res_seen.ok, count::usize);
            collections_vector.clear[module.ModuleId](?stack);
            val res_pushed: res[usize, A.Error] = collections_vector.push[module.ModuleId](?stack, mid);
            if (sel res_pushed.err) { ret err[fail.Fail].err{fail.refused(res_pushed.err)}; }
            for (stack.len > 0) {
                val opt_at: opt[module.ModuleId] = collections_vector.pop[module.ModuleId](?stack);
                if (sel opt_at.none) { brk; }
                val at: module.ModuleId = opt_at.some;
                if (res_seen.ok[at]) { cnt; }
                res_seen.ok[at] = true;
                val n: *project.ModuleEntry = project.module_at(p, at::u32);
                val r: *refusal.Refusal     = refusal_of(p, n);
                if (r == nil || n.load.home.root) { cnt; }
                if (r.state == refusal.OWN) {
                    if (!res_placed.ok[at]) {
                        res_placed.ok[at] = true;
                        val err_moved: err[fail.Fail] = place_refusal(store, m, b, n, r);
                        if (sel err_moved.err) { ret err_moved; }
                    }
                    cnt;
                }
                var j: usize = 0;
                for (j < n.load.bindings.len) {
                    val nb: *front_load.Binding = ?n.load.bindings.data[j];
                    j = j + 1;
                    if (nb.kind == front_load.BINDING_UNBOUND) { cnt; }
                    val next: module.ModuleId = front_load.module_of(?p.loader, nb.module);
                    if (module.is_nil(next)) { cnt; }
                    val res_next: res[usize, A.Error] = collections_vector.push[module.ModuleId](?stack, next);
                    if (sel res_next.err) { ret err[fail.Fail].err{fail.refused(res_next.err)}; }
                }
            }
        }
    }
    ret err[fail.Fail].ok{};
}

# whether some module outside the project is refused by its own `$error`
fun placeable(p: *project.Project) bool {
    var i: u32 = 0;
    for (i < project.module_count(p)) {
        val m: *project.ModuleEntry = project.module_at(p, i);
        i = i + 1;
        if (m.load.home.root) { cnt; }
        val r: *refusal.Refusal = refusal_of(p, m);
        if (r != nil && r.state == refusal.OWN) { ret true; }
    }
    ret false;
}

# the label each `$error` of a refused module carries where its importer reports it
val REFUSAL_LABEL: str = "the module this import reaches is refused by this module-scope `$error`";

# report the refusal of `n` at the import `b` of the project file `m`: the message of its first
# `$error`, each `$error` a related site and the message of each after the first a note. the
# `$error`s then leave `n`'s file. nothing moves when the store holds no `$error` of `n`
fun place_refusal(store: *diagnostic.DiagnosticStore, m: *project.ModuleEntry, b: *front_load.Binding, n: *project.ModuleEntry, r: *refusal.Refusal) err[fail.Fail] {
    var first: *diagnostic.Diagnostic = nil;
    var i:     usize                  = 0;
    for (first == nil && i < store.items.len) {
        val d: *diagnostic.Diagnostic = ?store.items.data[i];
        if (base_source.file_same(d.loc.file, n.file_id) && d.loc.span.offset == r.sites.data[0]::usize) { first = d; }
        i = i + 1;
    }
    if (first == nil) { ret err[fail.Fail].ok{}; }
    val res_builder: res[diagnostic.DiagnosticBuilder, fail.Fail] = diagnostic.builder_init(store.a, first.kind, m.file_id, b.span, first.message);
    if (sel res_builder.err) { ret err[fail.Fail].err{res_builder.err}; }
    var builder: diagnostic.DiagnosticBuilder = res_builder.ok;
    builder.origin = first.origin;
    var handed: bool = false;
    fin {
        if (!handed) { diagnostic.builder_dnit(?builder); }
    }
    var s: usize = 0;
    for (s < r.sites.len) {
        var k: usize = 0;
        for (k < store.items.len) {
            val d: *diagnostic.Diagnostic = ?store.items.data[k];
            k = k + 1;
            if (!base_source.file_same(d.loc.file, n.file_id) || d.loc.span.offset != r.sites.data[s]::usize) { cnt; }
            val err_related: err[fail.Fail] = diagnostic.attach_related(?builder, d.loc.file, d.loc.span, REFUSAL_LABEL);
            if (sel err_related.err) { ret err_related; }
            if (s > 0) {
                val err_noted: err[fail.Fail] = diagnostic.attach_note(?builder, d.message);
                if (sel err_noted.err) { ret err_noted; }
            }
        }
        s = s + 1;
    }
    diagnostic.drop_file(store, n.file_id);
    handed = true;
    ret diagnostic.commit(?builder, store);
}

# why a module is refused, as this project's operations last published it: by resolution, or
# by typing when resolution did not refuse it. nil when neither did
fun refusal_of(p: *project.Project, m: *project.ModuleEntry) *refusal.Refusal {
    val rr: *resolve.ResolveResult = resolved(p, m);
    if (rr != nil && refusal.is_refused(?rr.refusal)) { ret ?rr.refusal; }
    val sr: *sema_product.SemaResult = typed(p, m);
    if (sr != nil && refusal.is_refused(?sr.refusal)) { ret ?sr.refusal; }
    ret nil;
}

# the front end's warnings of every module whose front end the build skipped, from its record: a
# module typed after all is no longer skipped, and reports its own
fun replay_recorded(p: *project.Project, into: *diagnostic.DiagnosticStore) err[fail.Fail] {
    var i: u32 = 0;
    for (i < project.module_count(p)) {
        val m: *project.ModuleEntry = project.module_at(p, i);
        if (m.frontend_skipped && m.recorded_held) {
            val err_replayed: err[fail.Fail] = diagnostic.replay_into(into, ?m.recorded);
            if (sel err_replayed.err) { ret err_replayed; }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# every loaded module's `#[expect]` keys. a module's are judged once its
# warnings are all in: it was type checked this build, or its front end was
# skipped and its recorded warnings replayed. where each module's keys stand is
# read once per parse of it, so a refresh walks no module's declarations
fun gather_expectations(p: *project.Project, out: *collections_vector.Vector[diagnostic.Expectation]) err[fail.Fail] {
    var i: u32 = 0;
    for (i < project.module_count(p)) {
        val m: *project.ModuleEntry = project.module_at(p, i);
        i = i + 1;
        # an expectation acknowledges warnings alone, so a module whose warnings the build hides
        # gathers none
        if (!module.module_warned(?p.s.modules, module.id(i - 1))) { cnt; }
        if (m.released) {
            val err_held: err[fail.Fail] = expectations_append(out, ?m.held_expects);
            if (sel err_held.err) { ret err_held; }
            cnt;
        }
        val a: *ast.Ast = syntax(p, m);
        if (a == nil) { cnt; }
        val err_indexed: err[fail.Fail] = expect.index(p.s, a, ?m.expects);
        if (sel err_indexed.err)                { ret err_indexed; }
        if (expect.site_count(?m.expects) == 0) { cnt; }
        val checked:       bool                       = typed(p, m) != nil || m.frontend_skipped;
        var scope:         comptime_scope.ComptimeCtx = typed_scope(p, m);
        val err_collected: err[fail.Fail]             = expect.collect(p.s, a, ?m.expects, ?scope, checked, out);
        comptime_scope.dnit(?scope);
        if (sel err_collected.err) { ret err_collected; }
    }
    ret err[fail.Fail].ok{};
}

fun expectations_append(out: *collections_vector.Vector[diagnostic.Expectation], from: *collections_vector.Vector[diagnostic.Expectation]) err[fail.Fail] {
    var i: usize = 0;
    for (i < from.len) {
        val res_pushed: res[usize, A.Error] = collections_vector.push[diagnostic.Expectation](out, from.data[i]);
        if (sel res_pushed.err) { ret err[fail.Fail].err{fail.refused(res_pushed.err)}; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# give back a lowered module's front-end products, which nothing the build runs after its
# lowering reads: its syntax tree, its resolution, its lowering scope and what its typing holds
# beyond the interface its importers' lowerings read. its expectations are collected first and
# held, so a later refresh judges them as it would have. called inside the operation that
# lowered it, once its own products and every reader of them are done. a later read of any of
# them refuses: the syntax and resolution in the query engine, the typing in acquire_sema
pub fun products_dnit(p: *project.Project, mid: module.ModuleId) err[fail.Fail] {
    val m: *project.ModuleEntry = project.module_at(p, mid::u32);
    if (m.released || m.frontend_skipped || base_source.file_is_nil(m.file_id)) { ret err[fail.Fail].ok{}; }
    var held: collections_vector.Vector[diagnostic.Expectation] = collections_vector.init[diagnostic.Expectation](p.s.alloc);
    var kept: bool                                              = false;
    fin {
        if (!kept) { collections_vector.dnit[diagnostic.Expectation](?held); }
    }
    val res_parsed: res[ParsedModule, fail.Fail] = parse(p, m);
    if (sel res_parsed.err) { ret err[fail.Fail].err{res_parsed.err}; }
    val a:           *ast.Ast       = res_parsed.ok.a;
    val err_indexed: err[fail.Fail] = expect.index(p.s, a, ?m.expects);
    if (sel err_indexed.err) { ret err_indexed; }
    val res_resolution: res[*resolve.ResolveResult, fail.Fail] = resolution(p, m);
    if (sel res_resolution.err) { ret err[fail.Fail].err{res_resolution.err}; }
    val res_sema: res[*sema_product.SemaResult, fail.Fail] = acquire_sema(p, mid);
    if (sel res_sema.err) { ret err[fail.Fail].err{res_sema.err}; }
    if (expect.site_count(?m.expects) != 0) {
        var scope:         comptime_scope.ComptimeCtx = typed_scope_of(m, res_resolution.ok, res_sema.ok);
        val err_collected: err[fail.Fail]             = expect.collect(p.s, a, ?m.expects, ?scope, true, ?held);
        comptime_scope.dnit(?scope);
        if (sel err_collected.err) { ret err_collected; }
    }
    project.lower_scope_dnit(m);
    sema_product.result_shed(res_sema.ok);
    val stable:      u64            = module.stable_index(m.stable_id)::u64;
    val err_resolve: err[fail.Fail] = query.value_dnit(?p.s.queries, ?RESOLVE, stable);
    if (sel err_resolve.err) { ret err_resolve; }
    val err_syntax: err[fail.Fail] = query.value_dnit(?p.s.queries, ?PARSE, base_source.file_index(m.file_id)::u64);
    if (sel err_syntax.err) { ret err_syntax; }
    m.held_expects = held;
    m.released     = true;
    kept           = true;
    ret err[fail.Fail].ok{};
}

# close a query operation over the project and show it: end it, hold its failure where the
# session presents it, collect the diagnostics of every product the roots reach into the
# session's presentation and refresh the session's store from it
# ---
# p:         the project
# operation: the operation begin_query_phase opened
# roots:     the products whose diagnostics the phase presents
# count:     how many roots
# result:    the phase's own result; an operation failure that is a message displaces it; given
#            back unless it is ok and the refresh fails
pub fun finish_query_phase(p: *project.Project, operation: query.Operation,
    roots: *query.QueryKey, count: usize,
    result: err[fail.Fail]) err[fail.Fail] {
    val db:        *query.QueryDb = ?p.s.queries;
    val err_ended: err[fail.Fail] = query.end(db, operation);
    if (!db.operation_active) { project.fresh_staged_dnit(p); }
    var err_final:         err[fail.Fail] = result;
    var operation_failure: bool           = false;
    var lost:              bool           = false;
    if (sel err_ended.err) {
        val failure:   fail.Fail = err_ended.err;
        var displaces: bool      = sel result.ok;
        if (sel result.err) {
            if (sel failure.message && !fail.is_message(result.err)) { displaces = true; }
        }
        if (displaces) {
            err_final         = err[fail.Fail].err{failure};
            operation_failure = true;
        }
    }
    # the phase's own failure is held before the collect below releases what its text may read
    if (!operation_failure) {
        if (sel result.err) { err_final = err[fail.Fail].err{query.hold_failure(?p.s.queries, result.err, ?lost)}; }
        or                  { query.failure_dnit(?p.s.queries); }
    }
    val res_collected: res[*query.Presentation, fail.Fail] = query.collect(db, operation, roots, count, p.s.alloc);
    if (sel res_collected.err) {
        # the operation's own failure goes to the session's slot, since no presentation holds it
        val res_taken: res[opt[fail.Fail], fail.Fail] = query.take_failure(db, operation);
        if (sel res_taken.ok) {
            if (sel res_taken.ok.some) {
                if (operation_failure) { query.adopt_failure(?p.s.queries, res_taken.ok.some); }
                or                     { fail.dnit(db.a, res_taken.ok.some); }
            }
        }
        if (sel res_taken.err) { lost = true; }
        val err_discarded: err[fail.Fail] = query.discard(db, operation);
        if (sel err_discarded.err) { lost = true; }
        val no_result: bool = sel err_final.ok;
        if (no_result) { err_final = err[fail.Fail].err{res_collected.err}; }
        lost = true;
    }
    if (sel res_collected.ok) {
        val presentation: *query.Presentation = res_collected.ok;
        if (p.s.queries.presentation != nil) { query.presentation_dnit(p.s.queries.presentation); }
        p.s.queries.presentation = presentation;
        if (operation_failure) { query.failure_dnit(?p.s.queries); }
    }
    if (lost) {
        diagnostic.note_lost(?p.diags);
        diagnostic.note_lost(?p.s.diags);
    }
    if (sel res_collected.err) { ret err_final; }
    val err_refreshed: err[fail.Fail] = refresh_diagnostics(p);
    if (sel err_refreshed.err) {
        diagnostic.note_lost(?p.diags);
        diagnostic.note_lost(?p.s.diags);
        val result_ok: bool = sel err_final.ok;
        if (result_ok) { ret err_refreshed; }
    }
    ret err_final;
}

# what the front end bound over a module, to read: the load's bindings, and resolve's and sema's
# where this project's operations ran them
fun typed_scope(p: *project.Project, m: *project.ModuleEntry) comptime_scope.ComptimeCtx {
    ret typed_scope_of(m, resolved(p, m), typed(p, m));
}

fun typed_scope_of(m: *project.ModuleEntry, rr: *resolve.ResolveResult, sr: *sema_product.SemaResult) comptime_scope.ComptimeCtx {
    var scope: comptime_scope.ComptimeCtx = comptime_scope.stage_init(?m.load.ctx, comptime_scope.STAGE_LOWER, m.load.ctx.own.alloc);
    if (rr != nil) { comptime_scope.layer_set(?scope, comptime_scope.STAGE_RESOLVE, ?rr.constants); }
    if (sr != nil) { comptime_scope.layer_set(?scope, comptime_scope.STAGE_SEMA, ?sr.constants); }
    ret scope;
}
