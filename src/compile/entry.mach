# an entry build: one artifact of one entry file built with no mach.toml, the command line
# stating the whole project. the project it states is made as the manifest's model and held to
# the checks every manifest passes, so the build that follows cannot tell the two apart
use std.collections.vector.Vector;
use collections_vector: std.collections.vector;
use fs:                 std.filesystem;
use std_format:         std.format;
use io_error:           std.io.error;
use std.text.string.str_dup_range;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use types_path: std.types.path;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_ends_with;
use std.types.string.str_equals;
use std.types.string.str_index_char;
use std.types.string.str_is_empty;
use std.types.string.str_len;
use std.types.string.str_starts_with;

use A: std.allocator;

use diagnostic_kind: mach.base.diagnostic.kind;
use mach.base.fail;
use mach.base.intern;
use mach.base.textbuild;
use compile_closure:   mach.compile.closure;
use manifest_artifact: mach.manifest.artifact;
use manifest_load:     mach.manifest.load;
use manifest_model:    mach.manifest.model;
use manifest_schema:   mach.manifest.schema;
use mach.session;
use mach_target: mach.target;
use mach.target.resolved;
use mink_fail:   mink.base.fail;
use mink_arch:   mink.catalog.arch;
use mink_output: mink.catalog.output;
use mink.catalog.output.Spelled;
use mink_target: mink.catalog.target;

# the flags that narrow an entry build's target, each as written and nil when absent
# ---
# env:        `--env`
# abi:        `--abi`
# isa:        `--isa`
# exts:       every `--ext`, in argv order
# ext_count:  length of `exts`
# code_model: `--code-model`
pub rec Narrowing {
    env:        str;
    abi:        str;
    isa:        str;
    exts:       *str;
    ext_count:  usize;
    code_model: str;
}

# whether any narrowing flag is given
pub fun narrowed(n: *Narrowing) bool {
    ret n.env != nil || n.abi != nil || n.isa != nil || n.ext_count > 0 || n.code_model != nil;
}

# what the command line states of an entry build
# ---
# entry:        the entry file, a canonical path under the current directory
# kind:         the artifact's product, mink's spelling
# linkage:      the `--linkage` spelling, nil for the target's default
# sources:      each `--source` value, `name=dir` as written
# source_count: length of `sources`
# target:       the `-t` spelling, nil for the host's system and architecture
# narrowing:    the flags that narrow the target
# optimize:     the build runs the optimization pass set
# debug:        the build emits debug information
pub rec EntryRequest {
    entry:        str;
    kind:         str;
    linkage:      str;
    sources:      *str;
    source_count: usize;
    target:       str;
    narrowing:    Narrowing;
    optimize:     bool;
    debug:        bool;
}

# the work directory an entry build lays its intermediates in, `mach init`'s
val ENTRY_WORK: str = "out/{target.name}/{profile.name}";

# the rule an entry build's entry keeps
val ENTRY_CONSTRAINT: str = "an entry build's entry must be a .mach file inside the current directory, named by a relative path with no . or .. component";

# one `--source` binding, split
rec Binding {
    name: str;
    dir:  str;
}

# the project an entry build states, made as its manifest. the project root is the current
# directory, so `-o` and `-w` keep the rules they keep in a project
# ---
# s:   the session whose build allocator owns the manifest and whose interner holds its names
# r:   what the command line states
# ret: the manifest, owned by the session's build allocator; err as the command line names
#      no buildable project
pub fun entry_manifest(s: *session.Session, r: *EntryRequest) res[manifest_model.Manifest, fail.Fail] {
    val a: *A.Allocator = s.build_alloc;
    if (!manifest_schema.is_project_path(r.entry) || !str_ends_with(r.entry, ".mach")) {
        ret res[manifest_model.Manifest, fail.Fail].err{fail.user(diagnostic_kind.CLI_OPERAND, ENTRY_CONSTRAINT)};
    }

    var bindings: Vector[Binding] = collections_vector.init[Binding](a);
    fin { collections_vector.dnit[Binding](?bindings); }
    var i: usize = 0;
    for (i < r.source_count) {
        val res_split: res[Binding, fail.Fail] = binding_of(a, r.sources[i]);
        if (sel res_split.err) { ret res[manifest_model.Manifest, fail.Fail].err{res_split.err}; }
        var k: usize = 0;
        for (k < bindings.len) {
            if (str_equals(bindings.data[k].name, res_split.ok.name)) {
                ret res[manifest_model.Manifest, fail.Fail].err{fail.formatted_user(a, diagnostic_kind.CLI_FLAG_VALUE, "--source binds '{}' twice", res_split.ok.name)};
            }
            k = k + 1;
        }
        val res_pushed: res[usize, A.Error] = collections_vector.push[Binding](?bindings, res_split.ok);
        if (sel res_pushed.err) { ret res[manifest_model.Manifest, fail.Fail].err{fail.refused(res_pushed.err)}; }
        i = i + 1;
    }

    # the entry's own package is the binding whose directory holds it, else the entry's
    # directory under the entry's stem
    val file:     str               = types_path.filename(r.entry);
    val res_stem: res[str, A.Error] = str_dup_range(a, file, 0, str_len(file) - 5);
    if (sel res_stem.err) { ret res[manifest_model.Manifest, fail.Fail].err{fail.refused(res_stem.err)}; }
    val stem:  str   = res_stem.ok;
    var id:    str   = stem;
    var src:   str   = ".";
    var entry: str   = file;
    var own:   usize = bindings.len;
    i = 0;
    for (i < bindings.len) {
        val dir: str = bindings.data[i].dir;
        if (str_equals(dir, "."))                                                                                  { own = i; }
        or (manifest_schema.is_project_path(dir) && str_starts_with(r.entry, dir) && r.entry[str_len(dir)] == '/') { own = i; }
        i = i + 1;
    }
    if (own < bindings.len) {
        id  = bindings.data[own].name;
        src = bindings.data[own].dir;
        if (!str_equals(src, ".")) { entry = (?r.entry[str_len(src) + 1])::str; }
        or                         { entry = r.entry; }
    }
    or {
        if (!manifest_schema.is_project_id(stem)) {
            ret res[manifest_model.Manifest, fail.Fail].err{fail.formatted_user(a, diagnostic_kind.CLI_OPERAND,
                "the entry's stem '{}' is not a project id. {}. rename the file, or name the project with `mach build --source <name>=<dir>`", stem, manifest_schema.PROJECT_ID_RULE)};
        }
        val res_parent: res[str, A.Error] = types_path.parent(a, r.entry);
        if (sel res_parent.err)           { ret res[manifest_model.Manifest, fail.Fail].err{fail.refused(res_parent.err)}; }
        if (!str_is_empty(res_parent.ok)) { src = res_parent.ok; }
    }

    var m:      manifest_model.Manifest = manifest_model.init();
    var handed: bool                    = false;
    fin {
        if (!handed) { manifest_model.dnit(?m, a); }
    }
    val err_made: err[fail.Fail] = entry_model(s, r, id, src, entry, stem, ?m);
    if (sel err_made.err) { ret res[manifest_model.Manifest, fail.Fail].err{err_made.err}; }
    val err_roots: err[fail.Fail] = source_roots(s, ?m, ?bindings, own);
    if (sel err_roots.err) { ret res[manifest_model.Manifest, fail.Fail].err{err_roots.err}; }
    val err_checked: err[fail.Fail] = manifest_load.check(a, s.interner, ?m);
    if (sel err_checked.err) { ret res[manifest_model.Manifest, fail.Fail].err{err_checked.err}; }
    handed = true;
    ret res[manifest_model.Manifest, fail.Fail].ok{m};
}

# `name=dir`, split at its first `=`, its directory cleaned
fun binding_of(a: *A.Allocator, written: str) res[Binding, fail.Fail] {
    val opt_found: opt[usize] = str_index_char(written, '=');
    var at:        usize      = 0;
    if (sel opt_found.some) { at = opt_found.some; }
    if (at == 0 || at + 1 >= str_len(written)) {
        ret res[Binding, fail.Fail].err{fail.formatted_user(a, diagnostic_kind.CLI_FLAG_VALUE, "--source '{}' must be written <name>=<dir>", written)};
    }
    val res_name: res[str, A.Error] = str_dup_range(a, written, 0, at);
    if (sel res_name.err) { ret res[Binding, fail.Fail].err{fail.refused(res_name.err)}; }
    if (!manifest_schema.is_project_id(res_name.ok)) {
        ret res[Binding, fail.Fail].err{fail.formatted_user(a, diagnostic_kind.CLI_FLAG_VALUE, "--source '{}' does not name a project id. {}", written, manifest_schema.PROJECT_ID_RULE)};
    }
    # `./src` and `src/` bind the directory `src` does
    val res_dir: res[str, A.Error] = types_path.clean(a, (?written[at + 1])::str);
    if (sel res_dir.err) { ret res[Binding, fail.Fail].err{fail.refused(res_dir.err)}; }
    # the directory is the user's, refused here at the flag rather than as modules it never holds
    val res_present: res[bool, io_error.Error] = fs.is_dir(res_dir.ok);
    if (sel res_present.err) {
        ret res[Binding, fail.Fail].err{fail.refusal(a, diagnostic_kind.CLI_FLAG_VALUE, fail.Op{verb: "inspect", role: "the --source directory", path: res_dir.ok, given: true}, fail.Cause.io{res_present.err})};
    }
    if (!res_present.ok) {
        ret res[Binding, fail.Fail].err{fail.formatted_user(a, diagnostic_kind.CLI_FLAG_VALUE, "--source '{}' names '{}', which is not a directory", written, res_dir.ok)};
    }
    ret res[Binding, fail.Fail].ok{Binding{name: res_name.ok, dir: res_dir.ok}};
}

# every binding but the entry's own, as the manifest's source roots
fun source_roots(s: *session.Session, m: *manifest_model.Manifest, bindings: *Vector[Binding], own: usize) err[fail.Fail] {
    var n: usize = bindings.len;
    if (own < bindings.len) { n = n - 1; }
    if (n == 0)             { ret err[fail.Fail].ok{}; }
    val res_made: res[*manifest_model.SourceRoot, A.Error] = A.allocate[manifest_model.SourceRoot](s.build_alloc, n);
    if (sel res_made.err) { ret err[fail.Fail].err{fail.refused(res_made.err)}; }
    m.sources      = res_made.ok;
    m.source_count = n::u32;
    var at: usize = 0;
    var i:  usize = 0;
    for (i < bindings.len) {
        if (i == own) {
            i = i + 1;
            cnt;
        }
        val res_name: res[intern.StrId, A.Error] = intern.add(s.interner, bindings.data[i].name);
        if (sel res_name.err) { ret err[fail.Fail].err{fail.refused(res_name.err)}; }
        val res_dir: res[intern.StrId, A.Error] = intern.add(s.interner, bindings.data[i].dir);
        if (sel res_dir.err) { ret err[fail.Fail].err{fail.refused(res_dir.err)}; }
        m.sources[at] = manifest_model.SourceRoot{name: res_name.ok, dir: res_dir.ok};
        at            = at + 1;
        i             = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# the project an entry build states, made into `m`: the project, one profile, the one target
# the command line resolves to and one artifact. it states no link entry: the libraries a
# build links are the entries a bound project exports, as a project's dependencies' are
fun entry_model(s: *session.Session, r: *EntryRequest, id: str, src: str, entry: str, stem: str, m: *manifest_model.Manifest) err[fail.Fail] {
    val a:   *A.Allocator     = s.build_alloc;
    val itn: *intern.Interner = s.interner;

    val res_floor: res[str, std_format.FormatError] = compile_closure.running_mach_range_floor(a);
    if (sel res_floor.err) { ret err[fail.Fail].err{fail.message(fail.format_text(res_floor.err))}; }
    val res_mach: res[intern.StrId, fail.Fail] = id_of(itn, res_floor.ok);
    str_free(a, res_floor.ok);
    if (sel res_mach.err) { ret err[fail.Fail].err{res_mach.err}; }
    m.mach = res_mach.ok;
    var texts: [5]str = [5]str{id, "0.0.0", src, ENTRY_WORK, "*"};
    var ids:   [5]intern.StrId;
    var k:     usize  = 0;
    for (k < 5) {
        val res_id_of: res[intern.StrId, fail.Fail] = id_of(itn, texts[k]);
        if (sel res_id_of.err) { ret err[fail.Fail].err{res_id_of.err}; }
        ids[k] = res_id_of.ok;
        k      = k + 1;
    }
    m.id        = ids[0];
    m.version   = ids[1];
    m.src       = ids[2];
    m.work_tmpl = ids[3];
    val any: intern.StrId = ids[4];

    var profile_name: str = "debug";
    if (r.optimize) { profile_name = "release"; }
    val err_profiled: err[fail.Fail] = entry_profile(a, itn, r, profile_name, m);
    if (sel err_profiled.err) { ret err_profiled; }

    val res_product: res[Spelled, mink_fail.Fail] = mink_output.spelled(r.kind);
    if (sel res_product.err) { ret err[fail.Fail].err{resolved.refused(a, diagnostic_kind.CLI_FLAG_VALUE, res_product.err)}; }
    if (r.linkage != nil && !mach_target.is_executable(res_product.ok)) {
        ret err[fail.Fail].err{fail.formatted_user(a, diagnostic_kind.CLI_FLAG_INAPPLICABLE,
            "--linkage applies only to -k bin, as only an executable is linked as one, and -k {} makes no executable", r.kind)};
    }
    val res_target: res[mink_target.Target, fail.Fail] = target_of(a, r);
    if (sel res_target.err) { ret err[fail.Fail].err{res_target.err}; }
    val err_stated: err[fail.Fail] = entry_target(a, itn, ?res_target.ok, m);
    if (sel err_stated.err) { ret err_stated; }
    # `--linkage` narrowed the target, so mink resolved it against the host, and the artifact
    # keeps its name as a manifest's `linkage` does
    var linked: intern.StrId = intern.STR_NIL;
    if (r.linkage != nil) {
        val res_named: res[intern.StrId, fail.Fail] = id_of(itn, r.linkage);
        if (sel res_named.err) { ret err[fail.Fail].err{res_named.err}; }
        linked = res_named.ok;
    }

    ret entry_artifact(a, itn, id, res_product.ok, linked, entry, stem, any, m);
}

# the one profile, the default, as the command line states it
fun entry_profile(a: *A.Allocator, itn: *intern.Interner, r: *EntryRequest, name: str, m: *manifest_model.Manifest) err[fail.Fail] {
    val res_named: res[intern.StrId, fail.Fail] = id_of(itn, name);
    if (sel res_named.err) { ret err[fail.Fail].err{res_named.err}; }
    val res_made: res[*manifest_model.ProfileDef, A.Error] = A.allocate[manifest_model.ProfileDef](a, 1);
    if (sel res_made.err) { ret err[fail.Fail].err{fail.refused(res_made.err)}; }
    var pf: manifest_model.ProfileDef = manifest_model.profile_def();
    pf.name         = res_named.ok;
    pf.is_default   = true;
    pf.optimize     = r.optimize;
    pf.debug        = r.debug;
    res_made.ok[0]  = pf;
    m.profiles      = res_made.ok;
    m.profile_count = 1;
    ret err[fail.Fail].ok{};
}

# the one target, every key as mink's catalog resolved it, named `<sys>-<arch>`. the object
# format is the system's, so the target states none
fun entry_target(a: *A.Allocator, itn: *intern.Interner, t: *mink_target.Target, m: *manifest_model.Manifest) err[fail.Fail] {
    val res_isa: res[str, mink_fail.Fail] = mink_target.isa(t);
    if (sel res_isa.err) { ret err[fail.Fail].err{resolved.refused(a, diagnostic_kind.CLI_FLAG_VALUE, res_isa.err)}; }
    val res_abi: res[opt[*mink_arch.Abi], mink_fail.Fail] = mink_target.abi(t);
    if (sel res_abi.err) { ret err[fail.Fail].err{resolved.refused(a, diagnostic_kind.CLI_FLAG_VALUE, res_abi.err)}; }
    if (t.ext_count > resolved.MAX_ADDED::usize) {
        ret err[fail.Fail].err{fail.formatted_user(a, diagnostic_kind.EXTENSION_TOO_MANY, "--ext names more than {} extensions", resolved.MAX_ADDED)};
    }
    var d:        manifest_model.TargetDef     = manifest_model.target_def();
    val res_name: res[intern.StrId, fail.Fail] = target_name(a, itn, t);
    if (sel res_name.err) { ret err[fail.Fail].err{res_name.err}; }
    d.name = res_name.ok;
    var abi_name: str = "";
    if (sel res_abi.ok.some) { abi_name = res_abi.ok.some.name; }
    var texts: [4]str = [4]str{t.arch.name, t.sys.name, abi_name, res_isa.ok};
    var ids:   [4]intern.StrId;
    var k:     usize  = 0;
    for (k < 4) {
        val res_id_of: res[intern.StrId, fail.Fail] = id_of(itn, texts[k]);
        if (sel res_id_of.err) { ret err[fail.Fail].err{res_id_of.err}; }
        ids[k] = res_id_of.ok;
        k      = k + 1;
    }
    d.arch = ids[0];
    d.sys  = ids[1];
    d.abi  = ids[2];
    d.isa  = ids[3];
    if (sel t.env.some) {
        val res_env: res[intern.StrId, fail.Fail] = id_of(itn, t.env.some.name);
        if (sel res_env.err) { ret err[fail.Fail].err{res_env.err}; }
        d.env = res_env.ok;
    }
    if (sel t.code_model.some) {
        val res_model: res[intern.StrId, fail.Fail] = id_of(itn, t.code_model.some.name);
        if (sel res_model.err) { ret err[fail.Fail].err{res_model.err}; }
        d.code_model = res_model.ok;
    }
    var i: usize = 0;
    for (i < t.ext_count) {
        val res_ext: res[intern.StrId, fail.Fail] = id_of(itn, t.ext[i]);
        if (sel res_ext.err) { ret err[fail.Fail].err{res_ext.err}; }
        d.ext[i] = res_ext.ok;
        i        = i + 1;
    }
    d.ext_count = t.ext_count::u32;
    val res_made: res[*manifest_model.TargetDef, A.Error] = A.allocate[manifest_model.TargetDef](a, 1);
    if (sel res_made.err) { ret err[fail.Fail].err{fail.refused(res_made.err)}; }
    res_made.ok[0] = d;
    m.targets      = res_made.ok;
    m.target_count = 1;
    ret err[fail.Fail].ok{};
}

# `<sys>-<arch>`, every byte a portable identifier does not take as '_'
fun target_name(a: *A.Allocator, itn: *intern.Interner, t: *mink_target.Target) res[intern.StrId, fail.Fail] {
    var b: textbuild.TextBuilder = textbuild.tb_init(a);
    fin { textbuild.tb_dnit(?b); }
    put_name(?b, t.sys.name);
    textbuild.tb_append(?b, "-");
    put_name(?b, t.arch.name);
    val res_made: res[str, textbuild.Error] = textbuild.tb_finish(?b);
    if (sel res_made.err) { ret res[intern.StrId, fail.Fail].err{fail.message(textbuild.text(res_made.err))}; }
    val res_name: res[intern.StrId, fail.Fail] = id_of(itn, res_made.ok);
    str_free(a, res_made.ok);
    ret res_name;
}

# the one artifact, the default, which builds for every target
fun entry_artifact(a: *A.Allocator, itn: *intern.Interner, id: str, kind: Spelled, linkage: intern.StrId, entry: str, stem: str,
    any: intern.StrId, m: *manifest_model.Manifest) err[fail.Fail] {
    var d: manifest_model.ArtifactDef = manifest_model.artifact_def();
    var b: textbuild.TextBuilder      = textbuild.tb_init(a);
    fin { textbuild.tb_dnit(?b); }
    textbuild.tb_append(?b, stem);
    textbuild.tb_append(?b, "{artifact.suffix}");
    val res_out: res[str, textbuild.Error] = textbuild.tb_finish(?b);
    if (sel res_out.err) { ret err[fail.Fail].err{fail.message(textbuild.text(res_out.err))}; }
    var texts: [3]str = [3]str{id, entry, res_out.ok};
    var ids:   [3]intern.StrId;
    var k:     usize  = 0;
    for (k < 3) {
        val res_id_of: res[intern.StrId, fail.Fail] = id_of(itn, texts[k]);
        if (sel res_id_of.err) { ret err[fail.Fail].err{res_id_of.err}; }
        ids[k] = res_id_of.ok;
        k      = k + 1;
    }
    str_free(a, res_out.ok);
    d.name  = ids[0];
    d.kind  = kind;
    d.entry = ids[1];
    if (!mach_target.per_module(kind)) { d.out = ids[2]; }
    d.is_default         = true;
    d.linkage            = linkage;
    d.linkage_from.named = "--linkage";
    val res_made: res[*manifest_model.ArtifactDef, A.Error] = A.allocate[manifest_model.ArtifactDef](a, 1);
    if (sel res_made.err) { ret err[fail.Fail].err{fail.refused(res_made.err)}; }
    res_made.ok[0]   = d;
    m.artifacts      = res_made.ok;
    m.artifact_count = 1;
    ret every(a, any, ?res_made.ok.targets, ?res_made.ok.target_count);
}

# a list of the one entry `any`, `*`, over `items` and `count`
fun every(a: *A.Allocator, any: intern.StrId, items: **intern.StrId, count: *u32) err[fail.Fail] {
    val res_made: res[*intern.StrId, A.Error] = A.allocate[intern.StrId](a, 1);
    if (sel res_made.err) { ret err[fail.Fail].err{fail.refused(res_made.err)}; }
    res_made.ok[0] = any;
    @items         = res_made.ok;
    @count         = 1;
    ret err[fail.Fail].ok{};
}

# the id of `text`, interned in `itn`
fun id_of(itn: *intern.Interner, text: str) res[intern.StrId, fail.Fail] {
    val res_itn_added: res[intern.StrId, A.Error] = intern.add(itn, text);
    if (sel res_itn_added.err) { ret res[intern.StrId, fail.Fail].err{fail.refused(res_itn_added.err)}; }
    ret res[intern.StrId, fail.Fail].ok{res_itn_added.ok};
}

# the target the command line states, resolved by mink's catalog: `-t`, or the host's own system
# and architecture where it is left out, narrowed by the narrowing flags and `--linkage`. every
# part they leave out is the catalog's
fun target_of(a: *A.Allocator, r: *EntryRequest) res[mink_target.Target, fail.Fail] {
    var spec: mink_target.Spec;
    if (r.target != nil) {
        val res_parsed: res[mink_target.Spec, mink_fail.Fail] = mink_target.parse(r.target);
        if (sel res_parsed.err) { ret res[mink_target.Target, fail.Fail].err{resolved.refused(a, diagnostic_kind.CLI_FLAG_VALUE, res_parsed.err)}; }
        spec = res_parsed.ok;
    }
    or {
        val res_host: res[mink_target.Spec, fail.Fail] = resolved.spec_of(a, diagnostic_kind.CLI_FLAG_VALUE, mach_target.host_sys_name(), mach_target.host_arch_name());
        if (sel res_host.err) { ret res[mink_target.Target, fail.Fail].err{res_host.err}; }
        spec = res_host.ok;
    }
    val n:           *Narrowing                              = ?r.narrowing;
    var narrowed:    mink_target.Narrowing                   = mink_target.Narrowing{env: n.env, abi: n.abi, isa: n.isa, ext: n.exts, ext_count: n.ext_count, code_model: n.code_model, linkage: r.linkage, format: nil};
    val res_resolve: res[mink_target.Target, mink_fail.Fail] = mink_target.resolve(spec, ?narrowed);
    if (sel res_resolve.err) { ret res[mink_target.Target, fail.Fail].err{resolved.refused(a, diagnostic_kind.CLI_FLAG_VALUE, res_resolve.err)}; }
    ret res[mink_target.Target, fail.Fail].ok{res_resolve.ok};
}

# `text` as a portable identifier: every byte one does not take as '_'
fun put_name(b: *textbuild.TextBuilder, text: str) {
    var one: [2]u8;
    one[1] = 0;
    var i: usize = 0;
    for (text[i] != 0) {
        val c: u8 = text[i];
        one[0] = '_';
        if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '-' || c == '_') { one[0] = c; }
        textbuild.tb_append(b, (?one[0])::str);
        i = i + 1;
    }
}
