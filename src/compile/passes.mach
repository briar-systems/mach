# a module's code lowered into a mirl module on a heap of its own, with the facts its lowering
# kept, keyed by its back-half key. its codegen takes it, compiles it and gives its value back,
# so it is read once
pub val LOWER: query.Kind = query.Kind{
    name:     "lower", role: query.DERIVED, owner: query.KEY_MODULE, origin: diagnostic.ORIGIN_LOWER, compute: lower_compute,
    finalize: lowered_finalize, replay: true
};
# the symbols a module's lowered code defines under a binding other objects see, keyed by its
# back-half key: each one's session id, a little-endian u32, and none for a module that declares
# no tests. read from its lowering before its codegen spends it, or from the record of the object
# the cache restored, so the module's test object, which declares them, reads its normal module's
# lowering and never its compiled object
pub val DEFINED: query.Kind = query.Kind{name: "defined", role: query.DERIVED, owner: query.KEY_MODULE, origin: diagnostic.ORIGIN_LOWER, compute: defined_compute};
# a module's object, mink's, and the facts its lowering kept, keyed by its back-half key: its
# lowered module compiled
pub val CODEGEN: query.Kind = query.Kind{
    name:     "codegen", role: query.DERIVED, owner: query.KEY_MODULE, origin: diagnostic.ORIGIN_CODEGEN, compute: codegen_compute,
    finalize: codegen_finalize, replay: true
};
# one instance typed on its own (sema_product.InstanceResult), keyed by the session's id of its
# symbol, which is its identity: it reads its declaring module's typed definition and the typed
# surfaces instance_deps names, never a module that asks for it, so it is typed once per build
# however many modules reach it
pub val INSTANCE_SEMA: query.Kind = query.Kind{
    name:     "instance sema", role: query.DERIVED, owner: query.KEY_UNOWNED, origin: diagnostic.ORIGIN_SEMA, compute: instance_sema_compute,
    finalize: instance_sema_finalize
};
# every instance a module's code asks for, closed through what each instance's body asks for
# (compile/demand), each typed, keyed by the module's stable id. the reports of the instances it
# reaches are the module's: placed in the instance's body, or at the module's first call site
# leading to it. a restored object replays them, as the module's lowering depends on it
pub val INSTANCES: query.Kind = query.Kind{
    name:   "instances", role: query.DERIVED, owner: query.KEY_MODULE, origin: diagnostic.ORIGIN_SEMA, compute: instances_compute,
    replay: true
};
# the build's artifact, written by the link job from the current objects. its product is the
# artifact's path and the digest of the bytes written, and it reruns only when an input moved
pub val LINK: query.Kind = query.Kind{name: "link", role: query.DERIVED, owner: query.KEY_UNOWNED, origin: diagnostic.ORIGIN_LINK, compute: link_compute};
# what the link is configured with beyond the build context, set by the build
pub val LINK_CONFIG: query.Kind = query.Kind{name: "link config", role: query.INPUT, owner: query.KEY_UNOWNED};
# moves whenever the artifact on disk is not the one the link last wrote, so a missing or
# overwritten artifact is linked again
pub val LINK_ARTIFACT: query.Kind = query.Kind{name: "link artifact", role: query.INPUT, owner: query.KEY_UNOWNED};

# a rejected module is one module's answer, so the pass folds it and carries
# on over the rest; an internal failure ends the pass where it met it
pub fun run_resolve_pass(p: *project.Project) err[fail.Fail] {
    var rejected: bool = false;
    var i:        u32  = 0;
    for (i < p.topo_len) {
        val mid: module.ModuleId = p.topo[i];
        if (project.module_at(p, mid::u32).frontend_skipped) {
            i = i + 1;
            cnt;
        }
        val err_run_resolve_one: err[fail.Fail] = run_resolve_one(p, mid);
        if (sel err_run_resolve_one.err) {
            if (!fail.is_reported(err_run_resolve_one.err)) { ret err_run_resolve_one; }
            rejected = true;
        }
        i = i + 1;
    }
    if (rejected) { ret err[fail.Fail].err{fail.reported()}; }
    ret err[fail.Fail].ok{};
}

fun run_resolve_one(p: *project.Project, mid: module.ModuleId) err[fail.Fail] {
    val m: *project.ModuleEntry = project.module_at(p, mid::u32);

    val opt_t_item: readout.Instant = readout.item_begin(p.progress);

    val res_resolved: res[*resolve.ResolveResult, fail.Fail] = frontend.resolution(p, m);
    if (sel res_resolved.err) { ret err[fail.Fail].err{res_resolved.err}; }

    val res_queries_entry: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, ?frontend.EXPORTS, module.stable_index(m.stable_id)::u64);
    if (sel res_queries_entry.err) { ret err[fail.Fail].err{res_queries_entry.err}; }

    readout.item(p.progress, readout.RESOLVE, intern.text(?p.s.interner, m.fqn), opt_t_item);
    ret err[fail.Fail].ok{};
}

# a rejected module is one module's answer, so the pass folds it and carries
# on over the rest; an internal failure ends the pass where it met it
pub fun run_sema_pass(p: *project.Project) err[fail.Fail] {
    readout.phase_begin(p.progress, readout.SEMA);
    var rejected: bool = false;
    var i:        u32  = 0;
    for (i < p.topo_len) {
        val mid: module.ModuleId = p.topo[i];
        if (project.module_at(p, mid::u32).frontend_skipped) {
            i = i + 1;
            cnt;
        }
        val err_run_sema_one: err[fail.Fail] = run_sema_one(p, mid);
        if (sel err_run_sema_one.err) {
            if (!fail.is_reported(err_run_sema_one.err)) { ret err[fail.Fail].err{err_run_sema_one.err}; }
            rejected = true;
        }
        i = i + 1;
    }
    # the instances each typed module asks for once every module is typed, but a restored
    # object's, which holds them and replays their reports
    i = 0;
    for (i < p.topo_len) {
        val m: *project.ModuleEntry = project.module_at(p, p.topo[i]::u32);
        if (types_instances(p, m)) {
            val res_reached: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, ?INSTANCES, module.stable_index(m.stable_id)::u64);
            if (sel res_reached.err) {
                if (!fail.is_reported(res_reached.err)) { ret err[fail.Fail].err{res_reached.err}; }
                rejected = true;
            }
        }
        i = i + 1;
    }
    readout.phase_end(p.progress, readout.SEMA, cache.frontend_count(p), "module", "modules");
    if (rejected) { ret err[fail.Fail].err{fail.reported()}; }
    ret err[fail.Fail].ok{};
}

# the build types the instances module `m` asks for: its front end runs, and no object restored
# for it holds them
pub fun types_instances(p: *project.Project, m: *project.ModuleEntry) bool {
    ret !m.frontend_skipped && !cache.restored(p, m);
}

fun run_sema_one(p: *project.Project, mid: module.ModuleId) err[fail.Fail] {
    val m: *project.ModuleEntry = project.module_at(p, mid::u32);

    val opt_t_item: readout.Instant = readout.item_begin(p.progress);

    val res_acquired: res[sema_product.Definition, fail.Fail] = frontend.read_definition(p::ptr, mid, sema_product.DEFINITION_TYPED);
    if (sel res_acquired.err) { ret err[fail.Fail].err{res_acquired.err}; }

    val res_queries_entry: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, ?frontend.TYPED_EXPORTS, module.stable_index(m.stable_id)::u64);
    if (sel res_queries_entry.err) { ret err[fail.Fail].err{res_queries_entry.err}; }

    readout.item(p.progress, readout.SEMA, intern.text(?p.s.interner, m.fqn), opt_t_item);
    if (!report_phase.is_accepted(res_acquired.ok.rr.status) || !report_phase.is_accepted(res_acquired.ok.sr.status)) { ret err[fail.Fail].err{fail.reported()}; }
    ret err[fail.Fail].ok{};
}

# every module the load reached, gated out or not, is held under the session's active retainer: the
# project borrows each one's parse. a load closes its retainer's round unless a caller keeps the round
# open across builds, and then whatever no retainer holds is retired
pub fun retain_modules(p: *project.Project, rejected: bool) err[fail.Fail] {
    val t:  *retention.Retention = ?p.s.retention;
    val id: retention.RetainerId = t.active;
    if (rejected) { retention.reject(t, id); }
    var i: u32 = 0;
    for (i < project.module_count(p)) {
        val m: *project.ModuleEntry = project.module_at(p, i);
        if (!module.stable_is_nil(m.stable_id)) {
            val err_recorded: err[fail.Fail] = retention.record(t, id, m.stable_id, m.file_id, rejected);
            if (sel err_recorded.err) { ret err_recorded; }
        }
        i = i + 1;
    }
    val err_ended: err[fail.Fail] = retention.end_round(t, id, true);
    if (sel err_ended.err) { ret err_ended; }
    ret retention.retire(t, ?p.s.queries);
}

# a module's lowering and codegen products are keyed by its stable id, and by the
# test bit for its test object
pub fun back_half_key(stable: module.StableModuleId, test_object: bool) u64 {
    var k: u64 = module.stable_index(stable)::u64;
    if (test_object) { k = k | cache.TEST_KEY_BIT; }
    ret k;
}

pub fun back_half_key_is_test(key: u64) bool {
    ret (key & cache.TEST_KEY_BIT) != 0;
}

# the bit of a back-half key that names an artifact taken whole, keyed by the module its unit's
# object is held on
val WHOLE_KEY_BIT: u64 = 0x200000000;

# the key of unit `u`'s lowering and codegen: its module's normal key, or for an artifact taken
# whole that module's key with the whole bit
pub fun unit_key(p: *project.Project, u: u32) u64 {
    val k: u64 = back_half_key(project.unit_module(p, u).stable_id, false);
    if (backend.whole(?p.back)) { ret k | WHOLE_KEY_BIT; }
    ret k;
}

fun back_half_key_is_whole(key: u64) bool {
    ret (key & WHOLE_KEY_BIT) != 0;
}

# the normal object's key, the same in every build that compiles the module
pub fun back_half_key_for(p: *project.Project, m: *project.ModuleEntry) u64 {
    ret back_half_key(m.stable_id, false);
}

pub fun test_key_for(m: *project.ModuleEntry) u64 {
    ret cache.test_input_key(m);
}

# the module gets a test object in this build: a test build, and a module whose
# source declares a test or a `#[testing]` declaration
pub fun has_test_object(p: *project.Project, m: *project.ModuleEntry) bool {
    ret cache.has_test_object(p, m);
}

pub fun codegen_reusable(p: *project.Project, mid: module.ModuleId) res[bool, fail.Fail] {
    val m:            *project.ModuleEntry = project.module_at(p, mid::u32);
    val res_reusable: res[bool, fail.Fail] = query.reusable[project.Project](?p.queries, p, ?CODEGEN, back_half_key_for(p, m));
    if (sel res_reusable.err) { ret res_reusable; }
    if (res_reusable.ok)      { ret res_reusable; }
    ret res[bool, fail.Fail].ok{cache.restored(p, m)};
}

pub fun test_build(p: *project.Project) bool {
    ret request.test_goal(p.req.goal);
}

# the artifact this build links is a shared library. a test build compiles the
# library's own objects, so it lowers them the way the library's build does
fun shared_artifact_build(p: *project.Project) bool {
    if (p.req.goal != request.GOAL_ARTIFACT && !test_build(p)) { ret false; }
    if (p.target_entry == nil)                                 { ret false; }
    ret mach_target.is_row(p.target_entry.kind, ?mink_output.SHARED);
}

# whether the build's objects are the members of a static archive, as the artifact keyed with
# them states, whatever the goal
fun archive_build(p: *project.Project) bool {
    if (p.target_entry == nil) { ret false; }
    ret mach_target.is_row(p.target_entry.kind, ?mink_output.ARCHIVE);
}

# the import libraries the declarations name, which every lowering reads, registered before any is
pub fun prepare_codegen_pass(p: *project.Project) err[fail.Fail] {
    val err_imports: err[fail.Fail] = declared.register_import_libraries(p);
    if (sel err_imports.err) { ret err[fail.Fail].err{fail.as_user(diagnostic_kind.LINK_IMPORT_LIBRARY, err_imports.err)}; }
    ret err[fail.Fail].ok{};
}

fun acquire_frontend_inputs(p: *project.Project) err[fail.Fail] {
    var i: u32 = 0;
    for (i < p.topo_len) {
        # a released module's object is final for this build, and no lowering reads it again
        val m: *project.ModuleEntry = project.module_at(p, p.topo[i]::u32);
        if (m.frontend_skipped || m.released) {
            i = i + 1;
            cnt;
        }
        val res_acquired: res[sema_product.Definition, fail.Fail] = frontend.read_definition(p::ptr, p.topo[i], sema_product.DEFINITION_TYPED);
        # reading the typed definition makes the module's lowering scope, before any worker reads one
        if (sel res_acquired.err) { ret err[fail.Fail].err{res_acquired.err}; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# the module the back-half key `key` names, loaded this build
fun keyed_module(p: *project.Project, key: u64) res[module.ModuleId, fail.Fail] {
    val stable: module.StableModuleId = key::u32::module.StableModuleId;
    val mid:    module.ModuleId       = module.module_id_for_stable(?p.s.modules, stable);
    if (module.is_nil(mid)) { ret res[module.ModuleId, fail.Fail].err{fail.message("lower: stable id not loaded this build")}; }
    ret res[module.ModuleId, fail.Fail].ok{mid};
}

# the symbols the module's normal object defines, which its test object declares
fun normal_object_of(p: *project.Project, m: *project.ModuleEntry) res[lower_context.NormalObject, fail.Fail] {
    var names: collections_vector.Vector[intern.StrId] = collections_vector.init[intern.StrId](p.s.backing);
    fin { collections_vector.dnit[intern.StrId](?names); }
    val err_read: err[fail.Fail] = defined_of(p, m, ?names);
    if (sel err_read.err) { ret res[lower_context.NormalObject, fail.Fail].err{err_read.err}; }
    var normal: lower_context.NormalObject = lower_context.NormalObject{defined: map.init[intern.StrId, bool](p.s.alloc)};
    var i:      usize                      = 0;
    for (i < names.len) {
        val res_added: res[bool, A.Error] = map.insert[intern.StrId, bool](?normal.defined, names.data[i], true);
        if (sel res_added.err) {
            map.dnit[intern.StrId, bool](?normal.defined);
            ret res[lower_context.NormalObject, fail.Fail].err{fail.refused(res_added.err)};
        }
        i = i + 1;
    }
    ret res[lower_context.NormalObject, fail.Fail].ok{normal};
}

# the symbols the module `m` defines, as its DEFINED product holds them, pushed onto `into`
fun defined_of(p: *project.Project, m: *project.ModuleEntry, into: *collections_vector.Vector[intern.StrId]) err[fail.Fail] {
    val res_queries_entry: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, ?DEFINED, back_half_key_for(p, m));
    if (sel res_queries_entry.err) { ret err[fail.Fail].err{res_queries_entry.err}; }
    var r: wire.Source = wire.source(res_queries_entry.ok.value, res_queries_entry.ok.value_len::usize);
    var i: u32         = 0;
    for (i < res_queries_entry.ok.value_len / 4) {
        val res_pushed: res[usize, A.Error] = collections_vector.push[intern.StrId](into, intern.str_id(wire.take_u32(?r)));
        if (sel res_pushed.err) { ret err[fail.Fail].err{fail.refused(res_pushed.err)}; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# a module's defined symbols: its restored object's record's, or its lowering's when it declares
# tests. a lowering already compiled has given its module back, so this is read before its codegen
fun defined_compute(raw: ptr, kind: *query.Kind, key: u64, alloc: *A.Allocator, diags: *diagnostic.DiagnosticStore) res[query.QueryOutput, fail.Fail] {
    val p:         *project.Project                = raw::*project.Project;
    val res_keyed: res[module.ModuleId, fail.Fail] = keyed_module(p, key);
    if (sel res_keyed.err) { ret res[query.QueryOutput, fail.Fail].err{res_keyed.err}; }
    val m:  *project.ModuleEntry = project.module_at(p, res_keyed.ok::u32);
    var fb: wire.Sink            = wire.grown(alloc);
    fin { wire.dnit(?fb); }
    if (cache.restored(p, m)) {
        var i: u32 = 0;
        for (i < m.staged_facts.defined_count) {
            wire.put_u32(?fb, intern.str_index(m.staged_facts.defined[i]));
            i = i + 1;
        }
        ret codec.output(?fb);
    }
    val res_queries_entry: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, ?LOWER, key);
    if (sel res_queries_entry.err) { ret res[query.QueryOutput, fail.Fail].err{res_queries_entry.err}; }
    val l: *Lowering = handle_decode(res_queries_entry.ok)::*Lowering;
    if (l.taken)  { ret res[query.QueryOutput, fail.Fail].err{fail.message("defined: the module's lowering was compiled before its symbols were read")}; }
    if (!l.tests) { ret codec.output(?fb); }
    var names: collections_vector.Vector[intern.StrId] = collections_vector.init[intern.StrId](p.s.backing);
    fin { collections_vector.dnit[intern.StrId](?names); }
    val err_gathered: err[fail.Fail] = gather_defined(p, ?l.lowered.m, ?names);
    if (sel err_gathered.err) { ret res[query.QueryOutput, fail.Fail].err{err_gathered.err}; }
    var i: usize = 0;
    for (i < names.len) {
        wire.put_u32(?fb, intern.str_index(names.data[i]));
        i = i + 1;
    }
    ret codec.output(?fb);
}

# a lowering product: the module lowered and what its lowering kept for its cache record, until
# its codegen takes them
# ---
# held:  every instance the object holds a copy of, whose typing the lowering read
# tests: the module declares tests, so DEFINED reads the symbols its lowered module defines
# taken: its codegen took the facts and the instances, and compiling spent the module
rec Lowering {
    lowered: *compile_unit.Lowered;
    held:    collections_vector.Vector[intern.StrId];
    tests:   bool;
    taken:   bool;
}

fun lowering_dnit(raw: ptr, alloc: *A.Allocator) {
    val l: *Lowering = raw::*Lowering;
    if (!l.taken) {
        lower_context.unit_dnit(?l.lowered.facts);
        collections_vector.dnit[intern.StrId](?l.held);
    }
    compile_unit.dnit(alloc, l.lowered);
    A.deallocate[Lowering](alloc, l, 1);
}

fun lowered_finalize(value: *u8, value_len: u32, alloc: *A.Allocator) {
    lowering_dnit(handle_decode(query.QueryView{value: value, value_len: value_len}), alloc);
}

# the module `lowered` made into a lowering product, the instances it holds kept beside it
fun lowering_encode(p: *project.Project, alloc: *A.Allocator, lowered: *compile_unit.Lowered, held: collections_vector.Vector[intern.StrId], tests: bool) res[query.QueryOutput, fail.Fail] {
    val res_boxed: res[*Lowering, A.Error] = A.allocate[Lowering](p.s.alloc, 1);
    if (sel res_boxed.err) {
        var h: collections_vector.Vector[intern.StrId] = held;
        collections_vector.dnit[intern.StrId](?h);
        lower_context.unit_dnit(?lowered.facts);
        compile_unit.dnit(p.s.alloc, lowered);
        ret res[query.QueryOutput, fail.Fail].err{fail.refused(res_boxed.err)};
    }
    @res_boxed.ok = Lowering{lowered: lowered, held: held, tests: tests, taken: false};
    ret handle_encode(alloc, res_boxed.ok::ptr, lowering_dnit, p.s.alloc);
}

# every symbol the lowered module `m` defines, a function with a body or a global with a value,
# under a binding other objects see
fun gather_defined(p: *project.Project, m: *Module, into: *collections_vector.Vector[intern.StrId]) err[fail.Fail] {
    var i: usize = 0;
    for (i < m.functions.len) {
        val f: *mirl_function.Node = ?m.functions.data[i];
        if (f.data.linkage.binding != ?mink_symbol.LOCAL && f.body.blocks.len != 0) {
            val err_kept: err[fail.Fail] = defined_add(p, m, f.data.name, into);
            if (sel err_kept.err) { ret err_kept; }
        }
        i = i + 1;
    }
    i = 0;
    for (i < m.globals.len) {
        val g: *mirl_global.Node = ?m.globals.data[i];
        if (g.data.linkage.binding != ?mink_symbol.LOCAL && sel g.data.initial.some) {
            val err_kept: err[fail.Fail] = defined_add(p, m, g.data.name, into);
            if (sel err_kept.err) { ret err_kept; }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun defined_add(p: *project.Project, m: *Module, n: mink_table.Id[mink_intern.Name], into: *collections_vector.Vector[intern.StrId]) err[fail.Fail] {
    val name:      View                       = mirl_module.name_of(m, n);
    val res_named: res[intern.StrId, A.Error] = intern.bytes_add(?p.s.interner, name.data::str, name.len);
    if (sel res_named.err) { ret err[fail.Fail].err{fail.refused(res_named.err)}; }
    val res_pushed: res[usize, A.Error] = collections_vector.push[intern.StrId](into, res_named.ok);
    if (sel res_pushed.err) { ret err[fail.Fail].err{fail.refused(res_pushed.err)}; }
    ret err[fail.Fail].ok{};
}

# a unit's lowering, against its normal object's symbols when it is a module's test object: its
# modules' typed definitions, their instances and the target are its inputs. it keeps the instances
# its object holds, and whether the module declares tests. an artifact taken whole lowers every
# emitted module in topological order into its one unit, and declares no tests
fun lower_compute(raw: ptr, kind: *query.Kind, key: u64, alloc: *A.Allocator, diags: *diagnostic.DiagnosticStore) res[query.QueryOutput, fail.Fail] {
    val p:           *project.Project                = raw::*project.Project;
    val s:           *session.Session                = p.s;
    val opt_t_lower: readout.Instant                 = readout.span_begin(p.progress);
    val test_object: bool                            = back_half_key_is_test(key);
    val res_keyed:   res[module.ModuleId, fail.Fail] = keyed_module(p, key);
    if (sel res_keyed.err) { ret res[query.QueryOutput, fail.Fail].err{res_keyed.err}; }
    val m:          *project.ModuleEntry = project.module_at(p, res_keyed.ok::u32);
    val err_depend: err[fail.Fail]       = query.depend[project.Project](?p.queries, p, ?context.TARGET, 0);
    if (sel err_depend.err) { ret res[query.QueryOutput, fail.Fail].err{err_depend.err}; }

    # a test object declares what its normal object defines, so it lowers against those symbols
    var normal:      lower_context.NormalObject;
    var normal_from: *lower_context.NormalObject = nil;
    if (test_object) {
        val res_defined: res[lower_context.NormalObject, fail.Fail] = normal_object_of(p, m);
        if (sel res_defined.err) { ret res[query.QueryOutput, fail.Fail].err{res_defined.err}; }
        normal      = res_defined.ok;
        normal_from = ?normal;
    }
    fin {
        if (normal_from != nil) { map.dnit[intern.StrId, bool](?normal.defined); }
    }
    var reading: Reading = Reading{p: p, held: collections_vector.init[intern.StrId](s.backing)};
    var handed:  bool    = false;
    fin {
        if (!handed) { collections_vector.dnit[intern.StrId](?reading.held); }
    }
    var count: u32 = 1;
    if (back_half_key_is_whole(key)) { count = p.emit_len; }
    val res_reqs: res[*lower_context.LowerRequest, A.Error] = A.allocate[lower_context.LowerRequest](s.backing, count::usize);
    if (sel res_reqs.err) { ret res[query.QueryOutput, fail.Fail].err{fail.refused(res_reqs.err)}; }
    val reqs: *lower_context.LowerRequest = res_reqs.ok;
    fin { A.deallocate[lower_context.LowerRequest](s.backing, reqs, count::usize); }
    var tests: bool = false;
    var i:     u32  = 0;
    for (i < count) {
        var mid: module.ModuleId = res_keyed.ok;
        if (back_half_key_is_whole(key)) { mid = p.topo[i]; }
        val res_definition: res[sema_product.Definition, fail.Fail] = frontend.read_definition(p::ptr, mid, sema_product.DEFINITION_TYPED);
        if (sel res_definition.err) { ret res[query.QueryOutput, fail.Fail].err{res_definition.err}; }
        val d: sema_product.Definition = res_definition.ok;
        # the instances the module's code reaches, typed and reported as the module's
        val res_reached: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, ?INSTANCES, module.stable_index(project.module_at(p, mid::u32).stable_id)::u64);
        if (sel res_reached.err) { ret res[query.QueryOutput, fail.Fail].err{res_reached.err}; }
        val res_req: res[lower_context.LowerRequest, fail.Fail] = unit_request(p, mid, d, normal_from, ?reading, diags);
        if (sel res_req.err) { ret res[query.QueryOutput, fail.Fail].err{res_req.err}; }
        reqs[i] = res_req.ok;
        if (!test_object && !back_half_key_is_whole(key)) { tests = testrunner.declares_tests(d.parsed.a); }
        i = i + 1;
    }
    val res_lowered: res[*compile_unit.Lowered, fail.Fail] = compile_unit.lower(reqs, count::usize, ?p.back, s.spans, p.s.alloc);
    if (sel res_lowered.err) { ret res[query.QueryOutput, fail.Fail].err{lower_stable_fail(p, res_lowered.err)}; }
    val l: *compile_unit.Lowered = res_lowered.ok;
    read_out_lowering(p, test_object, intern.text(?s.interner, m.fqn), l, opt_t_lower);
    handed = true;
    ret lowering_encode(p, alloc, l, reading.held, tests);
}

# the lowering request of the module `mid`, whose typed definition is `d`, against `normal` when
# it is the module's test object, its instances read through `reading`
fun unit_request(p: *project.Project, mid: module.ModuleId, d: sema_product.Definition, normal: *lower_context.NormalObject, reading: *Reading,
    diags: *diagnostic.DiagnosticStore) res[lower_context.LowerRequest, fail.Fail] {
    val s:           *session.Session                       = p.s;
    val res_machine: res[*lower_context.Machine, fail.Fail] = backend.machine(?p.back);
    if (sel res_machine.err) { ret res[lower_context.LowerRequest, fail.Fail].err{res_machine.err}; }
    ret lower_context.request(s, ?p.linkage, ?p.back.facts, res_machine.ok, p.back.laying, s.backing, d.parsed.a, project.module_at(p, mid::u32).fqn, mid,
        d.sr, d.rr, d.ctx, normal, shared_artifact_build(p), p.req.debug, archive_build(p), p.req.opt != request.OPT_RELEASE, diags,
        sema_interface.Reader{ctx: p::ptr, read: read_interface}, lower_context.InstanceReader{ctx: reading::ptr, read: read_held, bind: bind_held});
}

# what a lowering reads beside its own typing: the instances whose typing it reads, which are those
# its object holds a copy of (each instance its code reaches, and the callee a class copy copies),
# each named once
rec Reading {
    p:    *project.Project;
    held: collections_vector.Vector[intern.StrId];
}

# the typing of the instance `item` describes, read for a lowering, which names it
fun read_held(raw: ptr, item: *sema_instance.Instance) res[*sema_product.InstanceResult, fail.Fail] {
    val r:         *Reading                     = raw::*Reading;
    val res_named: res[intern.StrId, fail.Fail] = demand.register(?r.p.instances, r.p.s, item);
    if (sel res_named.err) { ret res[*sema_product.InstanceResult, fail.Fail].err{res_named.err}; }
    var i: usize = 0;
    for (i < r.held.len && r.held.data[i] != res_named.ok) { i = i + 1; }
    if (i == r.held.len) {
        val res_pushed: res[usize, A.Error] = collections_vector.push[intern.StrId](?r.held, res_named.ok);
        if (sel res_pushed.err) { ret res[*sema_product.InstanceResult, fail.Fail].err{fail.refused(res_pushed.err)}; }
    }
    ret instance_typed(r.p, res_named.ok);
}

# how the instance `item` is bound where no constant-time code calls it: a merged definition of
# its source identity (compile/identity) where the target's objects hold them, weak otherwise
fun bind_held(raw: ptr, item: *sema_instance.Instance) res[lower_context.Defining, fail.Fail] {
    val r: *Reading = raw::*Reading;
    if (!backend.merges(?r.p.back)) { ret res[lower_context.Defining, fail.Fail].ok{lower_context.Defining.instance{}}; }
    val res_named: res[intern.StrId, fail.Fail] = demand.register(?r.p.instances, r.p.s, item);
    if (sel res_named.err) { ret res[lower_context.Defining, fail.Fail].err{res_named.err}; }
    val res_source: res[u64, fail.Fail] = identity.of_instance(r.p, item, res_named.ok);
    if (sel res_source.err) { ret res[lower_context.Defining, fail.Fail].err{res_source.err}; }
    ret res[lower_context.Defining, fail.Fail].ok{lower_context.Defining.merged{res_source.ok}};
}

# what lowering a module measured: its own row, carved out of the codegen row it runs inside
# while each module is lowered just before it is compiled, and the counts of its module
fun read_out_lowering(p: *project.Project, test_object: bool, name: str, l: *compile_unit.Lowered, t_lower: readout.Instant) {
    var lower:   readout.Phase = readout.LOWER;
    var codegen: readout.Phase = readout.CODEGEN;
    if (test_object) {
        lower   = readout.TEST_LOWER;
        codegen = readout.TEST_CODEGEN;
    }
    readout.span_end(p.progress, lower, codegen, t_lower);
    readout.item_spent(p.progress, lower, name, l.lower);
    readout.count(p.progress, readout.FUNCTIONS, name, l.functions);
    readout.count(p.progress, readout.IR_INSTRUCTIONS, name, l.ir_count);
}

# a module's test object's name, `<module path>#tests`: `#` is in no module path, so it names no module
fun test_object_name(p: *project.Project, fqn: intern.StrId) res[str, fail.Fail] {
    val res_joined: res[str, fail.Fail] = diagnostic.join(p.alloc, intern.text(?p.s.interner, fqn), "#tests");
    if (sel res_joined.err) { ret res_joined; }
    val res_held: res[intern.StrId, A.Error] = intern.add(?p.s.interner, res_joined.ok);
    str_free(p.alloc, res_joined.ok);
    if (sel res_held.err) { ret res[str, fail.Fail].err{fail.refused(res_held.err)}; }
    ret res[str, fail.Fail].ok{intern.text(?p.s.interner, res_held.ok)};
}

# how this build's request has mirl compile each module
fun codegen_of(p: *project.Project) compile_unit.Codegen {
    ret compile_unit.Codegen{level: p.req.opt, checked: p.req.verify, relax: p.req.linker_relax, floats: p.req.floats, require: p.req.simd == manifest_model.SIMD_REQUIRE};
}

# the typing of the instance named `name`, which the registry describes
fun instance_typed(p: *project.Project, name: intern.StrId) res[*sema_product.InstanceResult, fail.Fail] {
    val res_queries_entry: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, ?INSTANCE_SEMA, intern.str_index(name)::u64);
    if (sel res_queries_entry.err) { ret res[*sema_product.InstanceResult, fail.Fail].err{res_queries_entry.err}; }
    ret res[*sema_product.InstanceResult, fail.Fail].ok{handle_decode(res_queries_entry.ok)::*sema_product.InstanceResult};
}

fun typer_typed(raw: ptr, name: intern.StrId, item: *sema_instance.Instance) res[*sema_product.InstanceResult, fail.Fail] {
    ret instance_typed(raw::*project.Project, name);
}

# the instances the module keyed `key` asks for, closed and typed, their reports placed as the
# module's. one that does not type check rejects the module
fun instances_compute(raw: ptr, kind: *query.Kind, key: u64, alloc: *A.Allocator, diags: *diagnostic.DiagnosticStore) res[query.QueryOutput, fail.Fail] {
    val p:         *project.Project                = raw::*project.Project;
    val res_keyed: res[module.ModuleId, fail.Fail] = keyed_module(p, key);
    if (sel res_keyed.err) { ret res[query.QueryOutput, fail.Fail].err{res_keyed.err}; }
    val res_typed: res[*sema_product.SemaResult, fail.Fail] = frontend.acquire_sema(p, res_keyed.ok);
    if (sel res_typed.err) { ret res[query.QueryOutput, fail.Fail].err{res_typed.err}; }
    var d: demand.Demand = demand.init(p.s.alloc);
    fin { demand.dnit(?d); }
    val err_offered: err[fail.Fail] = demand.offer_module(?d, ?p.instances, p.s, ?res_typed.ok.instances);
    if (sel err_offered.err) { ret res[query.QueryOutput, fail.Fail].err{err_offered.err}; }
    val err_closed: err[fail.Fail] = demand.close(?d, ?p.instances, p.s, demand.Typer{ctx: p::ptr, typed: typer_typed});
    if (sel err_closed.err) { ret res[query.QueryOutput, fail.Fail].err{err_closed.err}; }
    val err_reported: err[fail.Fail] = demand.report(?d, p.s, diags);
    if (sel err_reported.err) { ret res[query.QueryOutput, fail.Fail].err{err_reported.err}; }
    if (d.rejected)           { ret res[query.QueryOutput, fail.Fail].err{fail.reported()}; }
    var fb: wire.Sink = wire.grown(alloc);
    fin { wire.dnit(?fb); }
    ret codec.output(?fb);
}

fun instance_sema_compute(raw: ptr, kind: *query.Kind, key: u64, alloc: *A.Allocator, diags: *diagnostic.DiagnosticStore) res[query.QueryOutput, fail.Fail] {
    val p:         *project.Project             = raw::*project.Project;
    val opt_about: opt[*sema_instance.Instance] = demand.described(?p.instances, intern.str_id(key::u32));
    if (sel opt_about.none) { ret res[query.QueryOutput, fail.Fail].err{fail.message("instance sema: the instance has no description")}; }
    val err_depend: err[fail.Fail] = query.depend[project.Project](?p.queries, p, ?context.TARGET, 0);
    if (sel err_depend.err) { ret res[query.QueryOutput, fail.Fail].err{err_depend.err}; }
    val res_deps: res[sema_product.SemaDeps, fail.Fail] = frontend.instance_deps(p, opt_about.some);
    if (sel res_deps.err) { ret res[query.QueryOutput, fail.Fail].err{res_deps.err}; }
    var deps:      sema_product.SemaDeps                       = res_deps.ok;
    val res_typed: res[sema_product.InstanceResult, fail.Fail] = sema_module.instance_sema(p.s, opt_about.some, ?deps);
    frontend.instance_deps_dnit(p, ?deps);
    if (sel res_typed.err) { ret res[query.QueryOutput, fail.Fail].err{res_typed.err}; }
    val res_boxed: res[*sema_product.InstanceResult, A.Error] = A.allocate[sema_product.InstanceResult](p.s.alloc, 1);
    if (sel res_boxed.err) {
        var kept: sema_product.InstanceResult = res_typed.ok;
        sema_product.instance_dnit(?kept);
        ret res[query.QueryOutput, fail.Fail].err{fail.refused(res_boxed.err)};
    }
    @res_boxed.ok = res_typed.ok;
    ret handle_encode(alloc, res_boxed.ok::ptr, instance_dnit, p.s.alloc);
}

fun instance_dnit(raw: ptr, alloc: *A.Allocator) {
    val r: *sema_product.InstanceResult = raw::*sema_product.InstanceResult;
    sema_product.instance_dnit(r);
    A.deallocate[sema_product.InstanceResult](alloc, r, 1);
}

fun instance_sema_finalize(value: *u8, value_len: u32, alloc: *A.Allocator) {
    instance_dnit(handle_decode(query.QueryView{value: value, value_len: value_len}), alloc);
}

# the interface the module `mid` published, which is all an importer's lowering reads of it
fun read_interface(raw: ptr, mid: module.ModuleId) res[*sema_interface.Interface, fail.Fail] {
    val p:            *project.Project                         = raw::*project.Project;
    val res_acquired: res[*sema_product.SemaResult, fail.Fail] = frontend.acquire_sema(p, mid);
    if (sel res_acquired.err)                      { ret res[*sema_interface.Interface, fail.Fail].err{res_acquired.err}; }
    if (!sel res_acquired.ok.status.kind.accepted) { ret res[*sema_interface.Interface, fail.Fail].err{report_phase.phase_failure(res_acquired.ok.status)}; }
    ret res[*sema_interface.Interface, fail.Fail].ok{?res_acquired.ok.interface};
}

fun lower_stable_fail(p: *project.Project, f: fail.Fail) fail.Fail {
    if (sel f.reported) { ret f; }
    ret fail.with_text(f, lower_stable_err(p, fail.describe(f)));
}

fun lower_stable_err(p: *project.Project, msg: str) str {
    val res_kept: res[str, fail.Fail] = diagnostic.text_retain(?p.s.interner, msg);
    if (sel res_kept.ok) { ret res_kept.ok; }
    ret "lowering failed, and re-homing its diagnostic off the module arena failed in turn (allocation failure)";
}

# a product handle: the one pointer it owns
fun handle_encode(alloc: *A.Allocator, held: ptr, release: fun(ptr, *A.Allocator), owner: *A.Allocator) res[query.QueryOutput, fail.Fail] {
    val n:            u32               = $size_of(ptr)::u32;
    val res_allocate: res[*u8, A.Error] = A.allocate[u8](alloc, n::usize);
    if (sel res_allocate.err) {
        release(held, owner);
        ret res[query.QueryOutput, fail.Fail].err{fail.refused(res_allocate.err)};
    }
    val slot: *ptr = res_allocate.ok::ptr::*ptr;
    slot[0] = held;
    var out: query.QueryOutput;
    out.bytes = res_allocate.ok;
    out.len   = n;
    ret res[query.QueryOutput, fail.Fail].ok{out};
}

fun handle_decode(e: query.QueryView) ptr {
    val slot: *ptr = codec.handle_bytes(e.value, e.value_len, $size_of(ptr))::ptr::*ptr;
    ret slot[0];
}

# the codegen operation's inputs: the typed definitions every step reads. the facts a
# module's step keeps are read from its product as the pass takes it
fun acquire_codegen_inputs(p: *project.Project) err[fail.Fail] {
    var clear: u32 = 0;
    for (clear < project.module_count(p)) {
        project.module_at(p, clear).unit = nil;
        clear                            = clear + 1;
    }
    ret acquire_frontend_inputs(p);
}

# the test operation's inputs: the typed definitions every test object's step reads
fun acquire_test_inputs(p: *project.Project) err[fail.Fail] {
    var clear: u32 = 0;
    for (clear < project.module_count(p)) {
        project.module_at(p, clear).test.unit = nil;
        clear                                 = clear + 1;
    }
    ret acquire_frontend_inputs(p);
}

# the test stage's computation: each test object's typed inputs, then each test object
pub fun run_test_pass(p: *project.Project) err[fail.Fail] {
    val err_inputs: err[fail.Fail] = acquire_test_inputs(p);
    if (sel err_inputs.err) { ret err_inputs; }
    ret run_test_object_pass(p);
}

fun run_test_object_pass(p: *project.Project) err[fail.Fail] {
    var i: u32 = 0;
    for (i < p.emit_len) {
        val mid: module.ModuleId = p.topo[i];
        if (has_test_object(p, project.module_at(p, mid::u32))) {
            val err_run_test_object_one: err[fail.Fail] = run_test_object_one(p, mid);
            if (sel err_run_test_object_one.err) { ret err[fail.Fail].err{err_run_test_object_one.err}; }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# each module in topological order, its front-end products given back once nothing after reads
# them: an importer's lowering reads the definitions of every module it reaches, so a module is
# held until the last module reaching it is lowered, and a test build lowers every module again
pub fun run_codegen_pass(p: *project.Project) err[fail.Fail] {
    val err_inputs: err[fail.Fail] = acquire_codegen_inputs(p);
    if (sel err_inputs.err)     { ret err_inputs; }
    if (backend.whole(?p.back)) { ret run_whole_codegen(p); }
    if (test_build(p)) {
        var t: u32 = 0;
        for (t < p.emit_len) {
            val err_run_codegen_one: err[fail.Fail] = run_codegen_one(p, p.topo[t]);
            if (sel err_run_codegen_one.err) { ret err_run_codegen_one; }
            t = t + 1;
        }
        ret err[fail.Fail].ok{};
    }
    val count:         u32                = project.module_count(p);
    val res_allocated: res[*u32, A.Error] = A.allocate[u32](p.s.alloc, count::usize);
    if (sel res_allocated.err) { ret err[fail.Fail].err{fail.refused(res_allocated.err)}; }
    val last: *u32 = res_allocated.ok;
    fin { A.deallocate[u32](p.s.alloc, last, count::usize); }
    last_readers(p, last, count);
    var i: u32 = 0;
    for (i < p.emit_len) {
        val err_run_codegen_one: err[fail.Fail] = run_codegen_one(p, p.topo[i]);
        if (sel err_run_codegen_one.err) { ret err_run_codegen_one; }
        var j: u32 = 0;
        for (j <= i) {
            if (last[p.topo[j]::u32] == i) {
                val err_released: err[fail.Fail] = frontend.products_dnit(p, p.topo[j]);
                if (sel err_released.err) { ret err_released; }
            }
            j = j + 1;
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# the topological position of the last emitted module whose lowering may read each module's
# definition: its own, or that of its last importer, and NO_READER for a module not emitted
fun last_readers(p: *project.Project, last: *u32, count: u32) {
    var k: u32 = 0;
    for (k < count) {
        last[k] = NO_READER;
        k       = k + 1;
    }
    var i: u32 = 0;
    for (i < p.emit_len) {
        last[p.topo[i]::u32] = i;
        i                    = i + 1;
    }
    var r: u32 = p.emit_len;
    for (r > 0) {
        r = r - 1;
        val m:    *project.ModuleEntry = project.module_at(p, p.topo[r]::u32);
        val read: u32                  = last[p.topo[r]::u32];
        var d:    u32                  = 0;
        for (d < project.dep_count(m)) {
            val dep: u32 = project.dep_at(p, m, d)::u32;
            if (dep < count && last[dep] != NO_READER && last[dep] < read) { last[dep] = read; }
            d = d + 1;
        }
    }
}

val NO_READER: u32 = 0xFFFFFFFF;

# the module `key` names lowered just before it is compiled, unless its object is current or
# restored, whose codegen reads no lowering
fun lower_ahead(p: *project.Project, lowering: *query.Kind, codegen: *query.Kind, key: u64) err[fail.Fail] {
    val res_reusable: res[bool, fail.Fail] = query.reusable[project.Project](?p.queries, p, codegen, key);
    if (sel res_reusable.err) { ret err[fail.Fail].err{res_reusable.err}; }
    if (res_reusable.ok)      { ret err[fail.Fail].ok{}; }
    val res_lowered: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, lowering, key);
    if (sel res_lowered.err) { ret err[fail.Fail].err{res_lowered.err}; }
    ret err[fail.Fail].ok{};
}

fun run_codegen_one(p: *project.Project, mid: module.ModuleId) err[fail.Fail] {
    val m: *project.ModuleEntry = project.module_at(p, mid::u32);
    # the symbols the module defines are read from its lowering before its codegen spends it
    var defined: collections_vector.Vector[intern.StrId] = collections_vector.init[intern.StrId](p.s.backing);
    fin { collections_vector.dnit[intern.StrId](?defined); }
    if (!cache.restored(p, m)) {
        val err_ahead: err[fail.Fail] = lower_ahead(p, ?LOWER, ?CODEGEN, back_half_key_for(p, m));
        if (sel err_ahead.err) { ret err_ahead; }
        val err_read: err[fail.Fail] = defined_of(p, m, ?defined);
        if (sel err_read.err) { ret err_read; }
    }
    val res_queries_entry: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, ?CODEGEN, back_half_key_for(p, m));
    if (sel res_queries_entry.err) { ret err[fail.Fail].err{res_queries_entry.err}; }
    val made: *Product = product_decode(res_queries_entry.ok);
    if (made == nil) { ret err[fail.Fail].err{fail.message("the codegen query produced no result handle")}; }
    m.object = ?made.object;
    m.unit   = product_facts(made);
    val o: *Object = m.object;
    # a generated object, or one this session held, carries the key of the current snapshot
    # into `obj/`
    if (!made.lowered) { ret cache.publish(p, m, o, nil, 0, nil, 0, query.QueryKey{kind: ?CODEGEN, key: back_half_key_for(p, m)}); }
    ret cache.publish(p, m, o, defined.data, defined.len::u32, made.kept.held.data, made.kept.held.len::u32, query.QueryKey{kind: ?CODEGEN, key: back_half_key_for(p, m)});
}

# an artifact taken whole: every emitted module lowered into the one unit and compiled, its object
# held on the unit's module, then every module's front-end products given back, since the unit's
# lowering was the last to read them. no object cache keys such a unit (cache.prepare)
fun run_whole_codegen(p: *project.Project) err[fail.Fail] {
    if (p.emit_len == 0) { ret err[fail.Fail].ok{}; }
    val key:       u64            = unit_key(p, 0);
    val err_ahead: err[fail.Fail] = lower_ahead(p, ?LOWER, ?CODEGEN, key);
    if (sel err_ahead.err) { ret err_ahead; }
    val res_queries_entry: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, ?CODEGEN, key);
    if (sel res_queries_entry.err) { ret err[fail.Fail].err{res_queries_entry.err}; }
    val made: *Product = product_decode(res_queries_entry.ok);
    if (made == nil) { ret err[fail.Fail].err{fail.message("the codegen query produced no result handle")}; }
    val m: *project.ModuleEntry = project.unit_module(p, 0);
    m.object = ?made.object;
    m.unit   = product_facts(made);
    var i: u32 = 0;
    for (i < p.emit_len) {
        val err_released: err[fail.Fail] = frontend.products_dnit(p, p.topo[i]);
        if (sel err_released.err) { ret err_released; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# the module's test object, lowered against its normal object and compiled
fun run_test_object_one(p: *project.Project, mid: module.ModuleId) err[fail.Fail] {
    val m: *project.ModuleEntry = project.module_at(p, mid::u32);
    if (!cache.test_restored(p, m)) {
        val err_ahead: err[fail.Fail] = lower_ahead(p, ?LOWER, ?CODEGEN, test_key_for(m));
        if (sel err_ahead.err) { ret err_ahead; }
    }
    val res_queries_entry: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, ?CODEGEN, test_key_for(m));
    if (sel res_queries_entry.err) { ret err[fail.Fail].err{res_queries_entry.err}; }
    val made: *Product = product_decode(res_queries_entry.ok);
    if (made == nil) { ret err[fail.Fail].err{fail.message("the codegen query produced no test object handle")}; }
    m.test.object = ?made.object;
    m.test.unit   = product_facts(made);
    val o: *Object = m.test.object;
    if (!made.lowered) { ret cache.publish_test(p, m, o, nil, 0, query.QueryKey{kind: ?CODEGEN, key: test_key_for(m)}); }
    ret cache.publish_test(p, m, o, made.kept.held.data, made.kept.held.len::u32, query.QueryKey{kind: ?CODEGEN, key: test_key_for(m)});
}

# the test object's codegen product is current or cached, so no worker generates it
pub fun test_codegen_reusable(p: *project.Project, mid: module.ModuleId) res[bool, fail.Fail] {
    val m:            *project.ModuleEntry = project.module_at(p, mid::u32);
    val res_reusable: res[bool, fail.Fail] = query.reusable[project.Project](?p.queries, p, ?CODEGEN, test_key_for(m));
    if (sel res_reusable.err) { ret res_reusable; }
    if (res_reusable.ok)      { ret res_reusable; }
    ret res[bool, fail.Fail].ok{cache.test_restored(p, m)};
}

# a module's object: its lowering, which it then depends on, compiled, or the object the object
# cache staged for it
fun codegen_compute(raw: ptr, kind: *query.Kind, key: u64, alloc: *A.Allocator, diags: *diagnostic.DiagnosticStore) res[query.QueryOutput, fail.Fail] {
    val p:         *project.Project                = raw::*project.Project;
    val s:         *session.Session                = p.s;
    val res_keyed: res[module.ModuleId, fail.Fail] = keyed_module(p, key);
    if (sel res_keyed.err) { ret res[query.QueryOutput, fail.Fail].err{res_keyed.err}; }
    val mid:         module.ModuleId      = res_keyed.ok;
    val m:           *project.ModuleEntry = project.module_at(p, mid::u32);
    val test_object: bool                 = back_half_key_is_test(key);
    if (!test_object && cache.staged_restored(p, m))     { ret q_codegen_restored(p, mid, false, alloc); }
    if (test_object && cache.test_staged_restored(p, m)) { ret q_codegen_restored(p, mid, true, alloc); }
    var job: compile_unit.Job = compile_unit.Job{back: ?p.back, codegen: codegen_of(p), out: s.backing, ir_path: "", asm_path: "", name: intern.text(?s.interner, m.fqn),
        timed: p.progress != nil, sources: s.sources};
    if (!test_object) {
        job.ir_path  = m.ir_output;
        job.asm_path = m.asm_output;
    }
    or {
        val res_named: res[str, fail.Fail] = test_object_name(p, m.fqn);
        if (sel res_named.err) { ret res[query.QueryOutput, fail.Fail].err{res_named.err}; }
        job.name = res_named.ok;
    }
    ret compiled_from(p, ?LOWER, key, ?job, test_object, alloc, diags);
}

# the object of the lowering `lowering` keys under `key`, compiled as `job` says: the codegen takes
# what the lowering kept, and the lowering's value is given back once its module is compiled
fun compiled_from(p: *project.Project, lowering: *query.Kind, key: u64, job: *compile_unit.Job, test_object: bool, alloc: *A.Allocator,
    diags: *diagnostic.DiagnosticStore) res[query.QueryOutput, fail.Fail] {
    val res_queries_entry: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, lowering, key);
    if (sel res_queries_entry.err) { ret res[query.QueryOutput, fail.Fail].err{res_queries_entry.err}; }
    val l:        *Lowering                               = handle_decode(res_queries_entry.ok)::*Lowering;
    val opt_t_cg: readout.Instant                         = readout.item_begin(p.progress);
    var res_made: res[compile_unit.Made, fail.Fail]       = compile_unit.compile(job, l.lowered);
    val facts:    lower_context.Unit                      = l.lowered.facts;
    val held:     collections_vector.Vector[intern.StrId] = l.held;
    l.taken = true;
    val err_released: err[fail.Fail] = query.value_dnit(?p.s.queries, lowering, key);
    var kept:         Kept           = Kept{facts: facts, held: held};
    if (sel err_released.err) {
        if (sel res_made.ok) { backend.object_dnit(?res_made.ok.compiled.object); }
        kept_dnit(?kept);
        ret res[query.QueryOutput, fail.Fail].err{err_released.err};
    }
    if (sel res_made.err) {
        kept_dnit(?kept);
        ret res[query.QueryOutput, fail.Fail].err{lower_stable_fail(p, res_made.err)};
    }
    val err_warned: err[fail.Fail] = warn(p, diags, ?res_made.ok.compiled);
    if (sel err_warned.err) {
        backend.object_dnit(?res_made.ok.compiled.object);
        kept_dnit(?kept);
        ret res[query.QueryOutput, fail.Fail].err{err_warned.err};
    }
    # the object carries its unit's link claims, so an archive of it carries them to its link
    val err_claimed: err[fail.Fail] = claims.state(p, ?res_made.ok.compiled.object);
    if (sel err_claimed.err) {
        backend.object_dnit(?res_made.ok.compiled.object);
        kept_dnit(?kept);
        ret res[query.QueryOutput, fail.Fail].err{err_claimed.err};
    }
    read_out_step(p, test_object, intern.text(?p.s.interner, facts.name), ?res_made.ok.stats, readout.elapsed(opt_t_cg));
    ret product_encode(alloc, res_made.ok.compiled.object, opt[Kept].some{kept}, p.s.alloc);
}

# what compiling the unit `name` measured: its verify stage and mirl's and masc's move out of
# the codegen row into rows of their own, the rest of the compile is codegen's, and each count
# adds to the unit's total. mirl's verifier runs add to mach's, and mirl's emit row is its emit
# less masc's layout and encoding, which it holds. a refused clock read leaves its stage short,
# and is reported rather than shown as a zero
fun read_out_step(p: *project.Project, test_object: bool, name: str, st: *compile_unit.Stats, spent: chrono_duration.Duration) {
    var verify:  readout.Phase = readout.VERIFY;
    var codegen: readout.Phase = readout.CODEGEN;
    if (test_object) {
        verify  = readout.TEST_VERIFY;
        codegen = readout.TEST_CODEGEN;
    }
    val ms:          *mirl_stats.Stats        = ?st.mirl;
    val verified:    chrono_duration.Duration = st.verify + ns(ms.verify);
    val masc_layout: u64                      = ms.masc.layout;
    val masc_encode: u64                      = ms.masc.encode;
    var mirl_emit:   u64                      = 0;
    if (ms.emit > masc_layout + masc_encode) { mirl_emit = ms.emit - masc_layout - masc_encode; }
    readout.carve(p.progress, verify, codegen, verified);
    var times:  [readout.STAGE_COUNT]u64 = [readout.STAGE_COUNT]u64{ms.lower + ms.passes, ms.select, ms.alloc, ms.frame, mirl_emit, masc_layout, masc_encode};
    var carved: chrono_duration.Duration = verified;
    var i:      usize                    = 0;
    for (i < readout.STAGE_COUNT) {
        readout.carve(p.progress, readout.STAGES[i], codegen, ns(times[i]));
        readout.item_spent(p.progress, readout.STAGES[i], name, ns(times[i]));
        carved = carved + ns(times[i]);
        i      = i + 1;
    }
    var rest: chrono_duration.Duration = spent - carved;
    if (rest < 0) { rest = 0; }
    readout.item_spent(p.progress, verify, name, verified);
    readout.item_spent(p.progress, codegen, name, rest);
    readout.count(p.progress, readout.VERIFY_RUNS, name, st.verifies + ms.verified);
    readout.count(p.progress, readout.SELECTED, name, ms.selected);
    readout.count(p.progress, readout.ALLOCATED, name, ms.allocated);
    readout.count(p.progress, readout.ALLOC_ROUNDS, name, ms.rounds);
    readout.count(p.progress, readout.ALLOCATED_BLOCKS, name, st.blocks);
    readout.count(p.progress, readout.ALLOCATED_BYTES, name, st.bytes);
    readout.count(p.progress, readout.HEAP_PEAK, name, st.peak);
    if (sel ms.clock.some) {
        val res_text: res[str, fail.Fail] = diagnostic.join(p.s.alloc, "the clock refused a read while mirl timed '", name, "', so a stage row is incomplete (", fail.cause_text(fail.Cause.io{ms.clock.some}), ")");
        var said:     str                 = "the clock refused a read while mirl timed a module, so a stage row is incomplete";
        if (sel res_text.ok) { said = res_text.ok; }
        val err_reported: err[fail.Fail] = diagnostic.report(?p.diags, diagnostic_kind.READOUT_CLOCK_REFUSED, base_source.FILE_NIL, base_source.Span{}, said);
    }
}

# mirl's nanoseconds as a duration
fun ns(n: u64) chrono_duration.Duration {
    ret n::chrono_duration.Duration;
}

# the mirl module `m` compiled into an object, which owns its storage in the session's backing
# allocator, the warnings mirl gave reported on `diags`. compiling spends the module
pub fun compile_module(p: *project.Project, diags: *diagnostic.DiagnosticStore, m: *Module, name: str) res[Object, fail.Fail] {
    val c:            compile_unit.Codegen                     = codegen_of(p);
    val res_compiled: res[backend_compile.Compiled, fail.Fail] = backend_compile.compile(?p.back, p.s.backing, p.s.sources, m, c.level, c.checked, c.relax, c.floats, c.require, opt[*std_writer.Writer].none{}, opt[*mirl_stats.Stats].none{}, name);
    if (sel res_compiled.err) { ret res[Object, fail.Fail].err{res_compiled.err}; }
    var made:       backend_compile.Compiled = res_compiled.ok;
    val err_warned: err[fail.Fail]           = warn(p, diags, ?made);
    if (sel err_warned.err) {
        backend.object_dnit(?made.object);
        ret res[Object, fail.Fail].err{err_warned.err};
    }
    ret res[Object, fail.Fail].ok{made.object};
}

# the warnings mirl gave compiling a module, each reported on `diags` under its kind at the source
# it points at, then given back, and the module refused as reported where one of them is an error,
# as a scalarized operation is under `simd = "require"`. the object stays the caller's
fun warn(p: *project.Project, diags: *diagnostic.DiagnosticStore, c: *backend_compile.Compiled) err[fail.Fail] {
    fin { backend_compile.warnings_dnit(p.s.backing, c); }
    var refused: bool  = false;
    var i:       usize = 0;
    for (i < c.warnings.len) {
        val w:        fail.Fail                 = c.warnings.data[i];
        val opt_text: opt[str]                  = fail.text(w);
        var at:       base_source.Location      = base_source.location_nil();
        val opt_put:  opt[base_source.Location] = fail.place_of(w);
        if (sel opt_put.some) { at = opt_put.some; }
        if (sel opt_text.some) {
            val err_reported: err[fail.Fail] = diagnostic.report(diags, fail.kind_of(w), at.file, at.span, opt_text.some);
            if (sel err_reported.err)                      { ret err_reported; }
            if (diagnostic_kind.is_error(fail.kind_of(w))) { refused = true; }
        }
        i = i + 1;
    }
    if (refused) { ret err[fail.Fail].err{fail.reported()}; }
    ret err[fail.Fail].ok{};
}

# a product restored from `obj/` becomes the module's codegen product with the
# target and the codegen flags as its edges, plus the module's object key,
# which is the persistent key's in-process image: any input the key covers
# advances it. a test object's key derives from the same one. it reads no
# typed definition, so a module nothing compiled imports is never typed
fun q_codegen_restored(p: *project.Project, mid: module.ModuleId, test_object: bool, alloc: *A.Allocator) res[query.QueryOutput, fail.Fail] {
    val m:          *project.ModuleEntry = project.module_at(p, mid::u32);
    val err_depend: err[fail.Fail]       = query.depend[project.Project](?p.queries, p, ?context.TARGET, 0);
    if (sel err_depend.err) { ret res[query.QueryOutput, fail.Fail].err{err_depend.err}; }
    var input: u64 = module.stable_index(m.stable_id)::u64;
    if (test_object) { input = cache.test_input_key(m); }
    val err_keyed: err[fail.Fail] = query.depend[project.Project](?p.queries, p, ?cache.OBJECT_KEY, input);
    if (sel err_keyed.err) { ret res[query.QueryOutput, fail.Fail].err{err_keyed.err}; }
    var staged: *Object = nil;
    if (test_object)   { staged = cache.take_staged_test(p, m); }
    or                 { staged = cache.take_staged(p, m); }
    if (staged == nil) { ret res[query.QueryOutput, fail.Fail].err{fail.message("codegen: restored product left the module")}; }
    val o: Object = @staged;
    A.deallocate[Object](p.s.alloc, staged, 1);
    ret product_encode(alloc, o, opt[Kept].none{}, p.s.alloc);
}

# what a module's codegen keeps of its lowering once the module is compiled: the facts mach reads
# of it, and the instances its object holds a copy of (see Lowering)
rec Kept {
    facts: lower_context.Unit;
    held:  collections_vector.Vector[intern.StrId];
}

fun kept_dnit(k: *Kept) {
    lower_context.unit_dnit(?k.facts);
    collections_vector.dnit[intern.StrId](?k.held);
}

# a codegen product: the unit's object, and what it kept of its lowering, none for an object
# the cache restored
rec Product {
    object:  Object;
    kept:    Kept;
    lowered: bool;
}

fun product_dnit(raw: ptr, alloc: *A.Allocator) {
    val made: *Product = raw::*Product;
    backend.object_dnit(?made.object);
    if (made.lowered) { kept_dnit(?made.kept); }
    A.deallocate[Product](alloc, made, 1);
}

fun product_encode(alloc: *A.Allocator, o: Object, kept: opt[Kept], owner: *A.Allocator) res[query.QueryOutput, fail.Fail] {
    var held:      Object                 = o;
    val res_boxed: res[*Product, A.Error] = A.allocate[Product](owner, 1);
    if (sel res_boxed.err) {
        backend.object_dnit(?held);
        if (sel kept.some) {
            var k: Kept = kept.some;
            kept_dnit(?k);
        }
        ret res[query.QueryOutput, fail.Fail].err{fail.refused(res_boxed.err)};
    }
    res_boxed.ok.object  = held;
    res_boxed.ok.lowered = sel kept.some;
    if (sel kept.some) { res_boxed.ok.kept = kept.some; }
    ret handle_encode(alloc, res_boxed.ok::ptr, product_dnit, owner);
}

fun product_decode(e: query.QueryView) *Product {
    ret handle_decode(e)::*Product;
}

# the facts a product's lowering kept, nil for a restored object
fun product_facts(made: *Product) *lower_context.Unit {
    if (!made.lowered) { ret nil; }
    ret ?made.kept.facts;
}

fun codegen_finalize(value: *u8, value_len: u32, alloc: *A.Allocator) {
    product_dnit(handle_decode(query.QueryView{value: value, value_len: value_len}), alloc);
}

# the link stage's computation: the current objects, then the link the build's job names,
# which runs only when one of its inputs moved
pub fun run_link_pass(p: *project.Project) err[fail.Fail] {
    val res_linked: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, ?LINK, 0);
    if (sel res_linked.err) { ret err[fail.Fail].err{res_linked.err}; }
    ret err[fail.Fail].ok{};
}

# before the link stage's operation: when the artifact on disk is not what the link last wrote
# to `artifact`, or nothing was linked yet, LINK_ARTIFACT moves to a value it never held, the
# database's next revision, so the link runs again
pub fun prepare_link(p: *project.Project, artifact: str) err[fail.Fail] {
    val db:       *query.QueryDb       = ?p.s.queries;
    val opt_last: opt[query.QueryView] = query.published(db, ?LINK, 0, 0);
    var whole:    bool                 = false;
    if (sel opt_last.some) {
        if (query.peek_revision(db, ?LINK_ARTIFACT, 0) != 0) {
            val res_held: res[bool, fail.Fail] = artifact_held(p, opt_last.some, artifact);
            if (sel res_held.err) { ret err[fail.Fail].err{res_held.err}; }
            whole = res_held.ok;
        }
    }
    if (whole) { ret err[fail.Fail].ok{}; }
    var fb: wire.Sink = wire.grown(p.alloc);
    fin { wire.dnit(?fb); }
    wire.put_u64(?fb, db.revision);
    val res_taken: res[query.QueryOutput, fail.Fail] = codec.output(?fb);
    if (sel res_taken.err) { ret err[fail.Fail].err{res_taken.err}; }
    val err_set: err[fail.Fail] = query.set_input(db, ?LINK_ARTIFACT, 0, res_taken.ok.bytes, res_taken.ok.len);
    if (res_taken.ok.bytes != nil) { A.deallocate[u8](p.alloc, res_taken.ok.bytes, res_taken.ok.len::usize); }
    ret err_set;
}

# the link's last product names `artifact`, and the file there holds the bytes it recorded
fun artifact_held(p: *project.Project, last: query.QueryView, artifact: str) res[bool, fail.Fail] {
    val n:        usize = str_len(artifact);
    val recorded: usize = last.value_len::usize;
    if (recorded != n + LINK_DIGEST)                          { ret res[bool, fail.Fail].ok{false}; }
    if (!memory.raw_equal(last.value::ptr, artifact::ptr, n)) { ret res[bool, fail.Fail].ok{false}; }
    val res_present: res[bool, io_error.Error] = fs.is_file(artifact);
    if (sel res_present.err) {
        if (res_present.err.kind == io_error.NOT_FOUND) { ret res[bool, fail.Fail].ok{false}; }
        ret res[bool, fail.Fail].err{diagnostic.refusal_interned(?p.s.interner, p.alloc, diagnostic_kind.FS_STAT, fail.Op{verb: "inspect", role: "the linked artifact", path: artifact}, fail.Cause.io{res_present.err})};
    }
    if (!res_present.ok) { ret res[bool, fail.Fail].ok{false}; }
    var now:        [LINK_DIGEST]u8;
    val err_digest: err[fail.Cause] = base_fingerprint.file_sha256(artifact, ?now[0]);
    if (sel err_digest.err) { ret res[bool, fail.Fail].err{diagnostic.refusal_interned(?p.s.interner, p.alloc, diagnostic_kind.FS_READ, fail.Op{verb: "digest", role: "the linked artifact", path: artifact}, err_digest.err)}; }
    ret res[bool, fail.Fail].ok{memory.raw_equal((?now[0])::ptr, (?last.value[n])::ptr, LINK_DIGEST)};
}

# the bytes of a link product's digest, after the artifact's path
val LINK_DIGEST: usize = 32;

# the link: every object the artifact takes, the target, the link configuration and the
# artifact's standing are its inputs, and the build's link job writes the artifact
fun link_compute(raw: ptr, kind: *query.Kind, key: u64, alloc: *A.Allocator, diags: *diagnostic.DiagnosticStore) res[query.QueryOutput, fail.Fail] {
    val p:   *project.Project = raw::*project.Project;
    val job: *project.LinkJob = p.link;
    if (job == nil) { ret res[query.QueryOutput, fail.Fail].err{fail.message("link: the build set no link job")}; }

    val err_depend: err[fail.Fail] = query.depend[project.Project](?p.queries, p, ?context.TARGET, 0);
    if (sel err_depend.err) { ret res[query.QueryOutput, fail.Fail].err{err_depend.err}; }
    val err_depend_queries: err[fail.Fail] = query.depend[project.Project](?p.queries, p, ?LINK_CONFIG, 0);
    if (sel err_depend_queries.err) { ret res[query.QueryOutput, fail.Fail].err{err_depend_queries.err}; }
    val err_depend_link_artifact: err[fail.Fail] = query.depend[project.Project](?p.queries, p, ?LINK_ARTIFACT, 0);
    if (sel err_depend_link_artifact.err) { ret res[query.QueryOutput, fail.Fail].err{err_depend_link_artifact.err}; }

    var i: u32 = 0;
    for (i < project.unit_count(p)) {
        val err_depend: err[fail.Fail] = query.depend[project.Project](?p.queries, p, ?CODEGEN, unit_key(p, i));
        if (sel err_depend.err) { ret res[query.QueryOutput, fail.Fail].err{err_depend.err}; }
        i = i + 1;
    }
    i = 0;
    for (i < p.emit_len) {
        val m: *project.ModuleEntry = project.module_at(p, (p.topo[i])::u32);
        # a test build links each test object too
        if (has_test_object(p, m)) {
            val err_rtest: err[fail.Fail] = query.depend[project.Project](?p.queries, p, ?CODEGEN, test_key_for(m));
            if (sel err_rtest.err) { ret res[query.QueryOutput, fail.Fail].err{err_rtest.err}; }
        }
        i = i + 1;
    }

    val res_linked: res[backend.LinkRead, fail.Fail] = job.run(job.ctx, p, diags);
    if (sel res_linked.err) { ret res[query.QueryOutput, fail.Fail].err{res_linked.err}; }
    var read: backend.LinkRead = res_linked.ok;
    fin { backend.link_read_dnit(p.alloc, ?read); }

    var written:    [LINK_DIGEST]u8;
    val err_digest: err[fail.Cause] = base_fingerprint.file_sha256(job.artifact, ?written[0]);
    if (sel err_digest.err) {
        val op: fail.Op = fail.Op{verb: "digest", role: "the linked artifact", path: job.artifact};
        ret res[query.QueryOutput, fail.Fail].err{diagnostic.refusal_interned(?p.s.interner, p.alloc, diagnostic_kind.FS_READ, op, err_digest.err)};
    }
    val err_noted: err[fail.Fail] = cache.note_link(p, job.artifact, ?written, ?read);
    if (sel err_noted.err) { ret res[query.QueryOutput, fail.Fail].err{err_noted.err}; }
    var fb: wire.Sink = wire.grown(alloc);
    fin { wire.dnit(?fb); }
    wire.put_bytes(?fb, job.artifact::*u8, str_len(job.artifact));
    wire.put_bytes(?fb, ?written[0], LINK_DIGEST);
    ret codec.output(?fb);
}

# key the loaded modules and read `obj/` under their keys (compile/cache),
# reported as the cache phase carved out of resolve, which it precedes
pub fun prepare_object_cache(p: *project.Project) err[fail.Fail] {
    if (!p.req.object_cache) { ret cache.forget(p); }
    readout.phase_begin(p.progress, readout.CACHE);
    val opt_t_cache:  readout.Instant                   = readout.span_begin(p.progress);
    val res_captured: res[query.QueryOutput, fail.Fail] = context.capture_configuration_identity(p, p.s.backing);
    if (sel res_captured.err) { ret err[fail.Fail].err{res_captured.err}; }
    val config: query.QueryOutput = res_captured.ok;
    fin {
        if (config.bytes != nil) { A.deallocate[u8](p.s.backing, config.bytes, config.len::usize); }
    }
    val err_prepared: err[fail.Fail] = cache.prepare(p, config.bytes, config.len::usize, readout.CACHE);
    readout.span_end(p.progress, readout.CACHE, readout.RESOLVE, opt_t_cache);
    readout.phase_end(p.progress, readout.CACHE, project.unit_count(p) - cache.generated_count(p), "module", "modules");
    ret err_prepared;
}

pub fun module_in_current_project(p: *project.Project, fqn: intern.StrId) bool {
    val fqn_text:     str = intern.text(?p.s.interner, fqn);
    val proj_id_text: str = intern.text(?p.s.interner, p.config.id);

    val fqn_len:  usize = str_len(fqn_text);
    var head_end: usize = 0;
    for (head_end < fqn_len && fqn_text[head_end] != '.') { head_end = head_end + 1; }
    ret view_eq_str(view(fqn_text::*char, head_end), proj_id_text);
}
