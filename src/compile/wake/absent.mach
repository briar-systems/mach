# the signal of a host with one thread: no thread waits on it, and none could wake one that did

use std.sync.mutex;
use std.types.bool.bool;
use std.types.bool.false;

pub rec Wake {
    waits: u32;
}

pub fun make() Wake {
    ret Wake{};
}

# nothing: no thread waits
pub fun all(w: *Wake) {}

# refuse the wait: the one thread would wait on itself
# ---
# ret: false: nothing waited, and what the caller waited for cannot come
pub fun wait(w: *Wake, lock: *mutex.Mutex) bool {
    ret false;
}
