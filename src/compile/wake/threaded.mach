# a signal threads wait on under a lock: std.sync.condition

use std.sync.condition;
use std.sync.mutex;
use std.types.bool.bool;
use std.types.bool.true;

pub rec Wake {
    woken: condition.Condition;
}

pub fun make() Wake {
    ret Wake{woken: condition.make()};
}

# wake every thread waiting on `w`
pub fun all(w: *Wake) {
    condition.broadcast(?w.woken);
}

# wait under `lock`, which the caller holds, until another thread wakes `w`
# ---
# ret: true: the wait ended, and the caller looks again at what it waited for
pub fun wait(w: *Wake, lock: *mutex.Mutex) bool {
    condition.wait(?w.woken, lock);
    ret true;
}
