# offers: the bodies a module's normal object offers the inliners of the modules that import it (design 2.7)
#
# a module's offer is mirl's text of its functions another module's inliner may expand (mirl.opt.offer). its unit's
# run makes it from the lowered module, on the thread that lowered it, right after lowering and before the compile
# reads or changes the module (`make`). the offer is a pure function of the lowered module, so it does not depend on
# which thread lowered it. a restored module offers what its object's record carries, which its lowering made when
# the object was built, read on the owner before any unit.
#
# offers pass between the units of a pass through its hand-over (`Handover`), the unit runner's ordered event for
# them (compile/passes, run_units): each module is handed over exactly once, by its unit's run as soon as the offer is
# made, empty when its lowering or its offer failed, or on the owner, as its entry holds it, when the pass begins or
# when its unit begins without running. an importer's prepare names the modules it may bind, its direct imports and
# its own module where it is a test object, which declares what its normal object defines, and reads no offer. its
# run waits until each of them is handed over (`bound`), never for an import's compile, so each offer it reads is the
# one its import's source makes whatever the thread count, and the binary does not depend on timing. the unit's
# completion on the owner, in unit order, then moves the offer its run made onto the module's entry (project.Offer),
# whose bytes stay where the importers read them. the compile binds, in that order, the pieces of each offer chosen on
# the module as lowered that fit it as it stands (`attach`), reading the text of no other piece, before anything else
# reads the module, so `--emit ir` prints the module as it is compiled, offers included.
#
# which offered bodies a module binds is mirl's rule (mirl.opt.offer, `select` and `bind`), and follows from what
# the link calls. an offered function is a strong definition other objects see, never weak, replaceable, merged nor
# exported: a generic instance is merged, or weak on a target with no merged definitions, or local to an object where
# constant-time code calls it, and none is offered. so the link binds every other object's reference to the name to
# that one definition, or refuses a second definition of it, and a mach reference is tied to its definition by its
# symbol name at every step (lowering declares a callee by its link name, the link resolves by name). a body is bound
# only for a function the module declares and does not define, which the link would have bound to the offering
# import's definition whichever module the source named it through. a piece is not bound where the module defines a
# name the piece's text states, the function it gives a body for or a symbol that body names: the module's own
# references to that name never reach the link, so binding would reach the module's definition where linking reaches
# the offerer's. nor is a piece bound that states another signature for a function than the module's declaration of
# its name: the module's `ext fun` is then wrong about the definition, which mach trusts and does not check, and its
# calls go through its own declaration as they do where no offer is bound. a piece left out keeps none of its
# neighbours out. a function under an explicit `#[symbol]` is offered like any other, since its name is no less the
# one strong definition the link keeps; only such a name can meet another module's, so a program that does not reuse a
# name across modules loses no offer by this. a malformed offer, one mirl's bind refuses, is a defect.
#
# an importer's object key takes each direct import's object key in place of its surface where the build makes offers
# (compile/cache, key_module), so the keyed set holds every offer a unit may bind and a body edited in an import
# rebuilds its importers. an artifact taken whole is one mirl module, whose inliner reads every body already, and
# makes none.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.view.View;

use A: std.allocator;
use std.collections.slice.Slice;
use std_writer: std.io.writer;
use std.memory;
use std.sync.condition;
use std.sync.mutex;
use std.types.string.StrError;
use std.types.string.str_copy_slice;

use diagnostic_kind: mach.base.diagnostic.kind;
use mach.base.fail;
use mach.compile.backend;
use mach.compile.project;
use mach.session.module;
use mirl_failure: mirl.failure;
use mirl.ir.module.Module;
use mirl_offer: mirl.opt.offer;

# an offer a unit may bind, as its run reads it: views of the text and the names of an offer held on a module's
# entry, which outlive the unit's compile
# ---
# text:  the offered bodies
# names: the offer's names list (mirl.opt.offer)
pub rec Candidate {
    text:  View;
    names: View;
}

# whether the build makes offers: its inliner runs and the target's family compiles one module per unit
pub fun made(p: *project.Project) bool {
    if (backend.whole(?p.back)) { ret false; }
    ret mirl_offer.wanted(?p.req.optimise);
}

# what an offer's failure says, from mirl's wording of it, the environment's where the allocator refused
fun refused(a: *A.Allocator, m: *Module, e: mirl_offer.Error) fail.Fail {
    var held: std_writer.Memory = std_writer.Memory{};
    var w:    std_writer.Writer = std_writer.memory_growing(?held, a);
    fin { std_writer.memory_dnit(?held); }
    var o:      mirl_failure.Out   = mirl_failure.Out{a: a, w: ?w, file: nil, head: nil};
    val class:  mirl_failure.Class = mirl_failure.offered(?o, m, e);
    var length: usize              = held.len;
    if (length > 0 && held.buf[length - 1] == '\n') { length = length - 1; }
    val res_said: res[str, StrError] = str_copy_slice(a, std_writer.memory_text(?held), 0, length);
    if (sel res_said.err)      { ret fail.str_refused(res_said.err); }
    if (sel class.environment) { ret fail.owning(fail.environment(diagnostic_kind.MEMORY_REFUSED, res_said.ok)); }
    ret fail.owning(fail.message(res_said.ok));
}

# bytes a growing memory holds copied into `a`, nil for none
fun kept(a: *A.Allocator, m: *std_writer.Memory, out: **u8, out_len: *u32) err[fail.Fail] {
    if (m.len == 0)         { ret err[fail.Fail].ok{}; }
    if (m.len > 0xFFFFFFFF) { ret err[fail.Fail].err{fail.message("a module's offer exceeds the size its record can hold")}; }
    val res_kept: res[*u8, A.Error] = A.allocate[u8](a, m.len);
    if (sel res_kept.err) { ret err[fail.Fail].err{fail.refused(res_kept.err)}; }
    memory.raw_copy(res_kept.ok::ptr, m.buf::ptr, m.len);
    @out     = res_kept.ok;
    @out_len = m.len::u32;
    ret err[fail.Fail].ok{};
}

# the offer of the lowered module `m`, made by its unit's run before the compile reads it, its bytes and a failure's
# words drawn from `a`, which any thread may use. it reads `m` alone and names no string
# ---
# a:   the allocator the offer's bytes are drawn from
# m:   the lowered module
# ret: the offer, empty when it offers nothing
pub fun make(a: *A.Allocator, m: *Module) res[project.Offer, fail.Fail] {
    var text_held:  std_writer.Memory = std_writer.Memory{};
    var names_held: std_writer.Memory = std_writer.Memory{};
    var text_w:     std_writer.Writer = std_writer.memory_growing(?text_held, a);
    var names_w:    std_writer.Writer = std_writer.memory_growing(?names_held, a);
    fin {
        std_writer.memory_dnit(?text_held);
        std_writer.memory_dnit(?names_held);
    }
    val err_written: err[mirl_offer.Error] = mirl_offer.write(?text_w, ?names_w, m);
    if (sel err_written.err) { ret res[project.Offer, fail.Fail].err{refused(a, m, err_written.err)}; }
    var made_offer: project.Offer  = project.Offer{a: a};
    val err_text:   err[fail.Fail] = kept(a, ?text_held, ?made_offer.text, ?made_offer.text_len);
    if (sel err_text.err) { ret res[project.Offer, fail.Fail].err{err_text.err}; }
    val err_names: err[fail.Fail] = kept(a, ?names_held, ?made_offer.names, ?made_offer.names_len);
    if (sel err_names.err) {
        project.offer_dnit(?made_offer);
        ret res[project.Offer, fail.Fail].err{err_names.err};
    }
    ret res[project.Offer, fail.Fail].ok{made_offer};
}

# the offer `o` as a unit reads it
fun candidate(o: *project.Offer) Candidate {
    ret Candidate{text: View{data: o.text, len: o.text_len::usize}, names: View{data: o.names, len: o.names_len::usize}};
}

# the hand-over of a pass's offers to the units that bind them, each module's handed over once: by its unit's run
# as soon as its lowering ran, empty when that lowering failed or made no offer, or by the owner when the pass begins
# or its unit begins without running, as its entry holds it. a unit's run waits for each module it binds to be handed
# over, then reads views of those that hold an offer, which never move while the pass runs. every field is read and
# written under `lock`, and a hand-over or the pass's end wakes the waiters
# ---
# lock:      held for every read and write of the rest
# woken:     waited on by a run whose binds are not all handed over
# handed:    per module, whether it was handed over
# offers:    per module, its offer as handed over
# count:     the modules both cover
# cancelled: the pass ended, so a run still waiting compiles nothing
# a:         where both are drawn from
pub rec Handover {
    lock:      mutex.Mutex;
    woken:     condition.Condition;
    handed:    *bool;
    offers:    *Candidate;
    count:     u32;
    cancelled: bool;
    a:         *A.Allocator;
}

# the hand-over of a pass over the modules of `p` in `h`, drawn from `a`, every module handed over as its entry holds
# its offer but the `count` modules at `pending`, whose units hand theirs over as they run or begin. read on the owner
# before any unit, and `h` must not move while a run reads it
pub fun handover_init(h: *Handover, p: *project.Project, a: *A.Allocator, pending: *module.ModuleId, count: u32) err[fail.Fail] {
    @h = Handover{lock: mutex.make(), woken: condition.make(), a: a};
    val modules:    u32                 = project.module_count(p);
    val res_handed: res[*bool, A.Error] = A.allocate[bool](a, modules::usize + 1);
    if (sel res_handed.err) { ret err[fail.Fail].err{fail.refused(res_handed.err)}; }
    val res_offers: res[*Candidate, A.Error] = A.allocate[Candidate](a, modules::usize + 1);
    if (sel res_offers.err) {
        A.deallocate[bool](a, res_handed.ok, modules::usize + 1);
        ret err[fail.Fail].err{fail.refused(res_offers.err)};
    }
    h.handed = res_handed.ok;
    h.offers = res_offers.ok;
    h.count  = modules;
    var i: u32 = 0;
    for (i < modules) {
        h.offers[i] = candidate(?project.module_at(p, i).offer);
        h.handed[i] = true;
        i           = i + 1;
    }
    i = 0;
    for (i < count) {
        val mid: u32 = pending[i]::u32;
        if (mid < modules) {
            h.offers[mid] = Candidate{};
            h.handed[mid] = false;
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# the hand-over given back, once no run reads it
pub fun handover_dnit(h: *Handover) {
    if (h.handed != nil) { A.deallocate[bool](h.a, h.handed, h.count::usize + 1); }
    if (h.offers != nil) { A.deallocate[Candidate](h.a, h.offers, h.count::usize + 1); }
    @h = Handover{};
}

# module `mid`'s offer `o` handed over, views of bytes that stay put until the pass ends, its waiters woken. a module
# is handed over once, by its unit's run or its unit's begin, never both
pub fun hand(h: *Handover, mid: u32, o: *project.Offer) {
    mutex.lock(?h.lock);
    if (mid < h.count) {
        h.offers[mid] = candidate(o);
        h.handed[mid] = true;
    }
    condition.broadcast(?h.woken);
    mutex.unlock(?h.lock);
}

# the pass ended: a run still waiting stops waiting and compiles nothing
pub fun handover_cancel(h: *Handover) {
    mutex.lock(?h.lock);
    h.cancelled = true;
    condition.broadcast(?h.woken);
    mutex.unlock(?h.lock);
}

# the offers a unit binds, those of the modules `binds` names that hold one, in that order, as views in `a`, the unit's
# own storage, read by its run once each is handed over. none when the pass ended first
# ---
# h:     the pass's hand-over
# binds: the modules whose offers the unit may bind, its direct imports, or its own module for a test object
# a:     the unit's storage
# ret:   the views, empty when none holds an offer, or none when the pass ended before every one was handed over
pub fun bound(h: *Handover, binds: Slice[u32], a: *A.Allocator) res[opt[Slice[Candidate]], fail.Fail] {
    mutex.lock(?h.lock);
    var count: usize = 0;
    var i:     usize = 0;
    for (i < binds.size) {
        val mid: u32 = binds.data[i];
        for (mid < h.count && !h.handed[mid] && !h.cancelled) { condition.wait(?h.woken, ?h.lock); }
        if (h.cancelled) {
            mutex.unlock(?h.lock);
            ret res[opt[Slice[Candidate]], fail.Fail].ok{opt[Slice[Candidate]].none{}};
        }
        if (mid < h.count && h.offers[mid].text.len != 0) { count = count + 1; }
        i = i + 1;
    }
    mutex.unlock(?h.lock);
    if (count == 0) { ret res[opt[Slice[Candidate]], fail.Fail].ok{opt[Slice[Candidate]].some{Slice[Candidate]{data: nil, size: 0}}}; }
    val res_views: res[*Candidate, A.Error] = A.allocate[Candidate](a, count);
    if (sel res_views.err) { ret res[opt[Slice[Candidate]], fail.Fail].err{fail.refused(res_views.err)}; }
    # every module of `binds` is handed over and its entry never changes again in the pass, so it is read unlocked
    var n: usize = 0;
    i = 0;
    for (i < binds.size) {
        val mid: u32 = binds.data[i];
        if (mid < h.count && h.offers[mid].text.len != 0) {
            res_views.ok[n] = h.offers[mid];
            n               = n + 1;
        }
        i = i + 1;
    }
    ret res[opt[Slice[Candidate]], fail.Fail].ok{opt[Slice[Candidate]].some{Slice[Candidate]{data: res_views.ok, size: count}}};
}

# bind into module `m` the pieces of `offers` it binds (mirl.opt.offer): those chosen on the module as lowered, before
# any is bound, then each bound in order where it fits the module as it stands with those bound before it. scratch
# storage from `a`, the words of a failure from `words`. a refusal is a defect of the offer
# ---
# m:      the unit's module
# a:      the unit's scratch storage
# words:  where a failure's words are drawn from
# offers: the offers handed over that it may bind, in its prepare's order
# ret:    the failure binding one, ok when every piece it binds is bound
pub fun attach(m: *Module, a: *A.Allocator, words: *A.Allocator, offers: Slice[Candidate]) err[fail.Fail] {
    if (offers.size == 0) { ret err[fail.Fail].ok{}; }
    val res_chosen: res[*mirl_offer.Selection, A.Error] = A.zallocate[mirl_offer.Selection](a, offers.size);
    if (sel res_chosen.err) { ret err[fail.Fail].err{fail.refused(res_chosen.err)}; }
    val chosen: *mirl_offer.Selection = res_chosen.ok;
    fin {
        var k: usize = 0;
        for (k < offers.size) {
            mirl_offer.selection_dnit(?chosen[k], a);
            k = k + 1;
        }
        A.deallocate[mirl_offer.Selection](a, chosen, offers.size);
    }
    var i: usize = 0;
    for (i < offers.size) {
        val res_selected: res[mirl_offer.Selection, mirl_offer.Error] = mirl_offer.select(m, a, offers.data[i].names, offers.data[i].text.len);
        if (sel res_selected.err) { ret err[fail.Fail].err{refused(words, m, res_selected.err)}; }
        chosen[i] = res_selected.ok;
        i         = i + 1;
    }
    i = 0;
    for (i < offers.size) {
        val err_bound: err[mirl_offer.Error] = mirl_offer.bind(m, a, offers.data[i].text, offers.data[i].names, ?chosen[i]);
        if (sel err_bound.err) { ret err[fail.Fail].err{refused(words, m, err_bound.err)}; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}
