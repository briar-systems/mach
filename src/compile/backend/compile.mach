use mach.base.diagnostic;
use mink_fail: mink.base.fail;
use mink.model.object;
use mink.model.object.Object;

# a module's object and the warnings mirl gave compiling it, each a failure of its warning's kind
# with where mirl states it, both owned by the caller and given back with `dnit`, or the
# warnings alone with `warnings_dnit` once the object has moved on
pub rec Compiled {
    object:   Object;
    warnings: vector.Vector[Unplaced];
}

# a failure of the compile before it is placed in the build's sources: the failure, where mirl's
# debug table states it, and the places of the failures it names besides itself, each owned
# through the allocator the compile was given. `placed` puts it in the sources
pub rec Unplaced {
    fail: fail.Fail;
    at:   opt[Spot];
    also: vector.Vector[Spot];
}

# a source position as mirl's debug table states it: the path of its file, its line and its column
pub rec Spot {
    path: str;
    line: usize;
    col:  usize;
}

# the mirl module `m` compiled to mink's object under the setting `optimise`, its schedule's own checks
# run with `checked`, the linker let relax its code with `relax`, its frames stated for unwind tables where `unwind`
# holds, and the float relaxations `floats`
# permitted, masc's listing of the object written to `listing` when there is one, and its stages
# timed and counted into `stats` when there is one. a vector operation mirl takes lane by lane is
# refused where `require` holds, as the profile's `simd = "require"` asks, and is a warning
# otherwise, a refusal naming the dependency `owner` whose code the module is, nil for the project
# being built. where `report` holds, mirl writes its report of the optimisation passes that changed
# each function to stdout, each line whole. where `closed` holds, nothing outside the object refers into it, so mirl
# leaves out what no root of its own reaches. a failure or warning carries the location mirl names, unplaced.
# `name` is the object's, no other object's in a link. the module is the schedule's to rewrite, so
# it is spent here
pub fun compile(b: *Back, a: *A.Allocator, m: *Module, optimise: Optimise, checked: bool, relax: bool, unwind: bool, floats: relaxation.Relaxations,
    require: bool, report: bool, closed: bool, listing: opt[*std_writer.Writer], stats: opt[*mirl_stats.Stats], name: str, owner: str) res[Compiled, Unplaced] {
    if (b.assembled == nil || b.prepared == nil) { ret res[Compiled, Unplaced].err{bare(fail.message("no target is open, so the build has no back end"))}; }
    var o: mirl_options.Options = mirl_options.Options{
        output:   mirl_options.Output.object{},
        relax:    relax,
        floats:   floats,
        optimise: optimise,
        checked:  checked,
        machine:  opt[*std_writer.Writer].none{},
        listing:  listing,
        stats:    stats,
        name:     name,
        unwind:   unwind,
        report:   opt[*std_writer.Writer].none{},
        closed:   closed
    };
    var stdout: std_writer.Writer = fs.writer(fs.STDOUT);
    if (report) { o.report = opt[*std_writer.Writer].some{?stdout}; }
    # mirl lends the module's names to the object it makes, so it compiles under the module's
    # allocator, and the object is copied into `a` where the module's storage does not outlive it
    val res_made: res[mirl_compile.Compiled, mirl_family.Error] = mirl_compile.compile(b.prepared, m.a, m, o);
    if (sel res_made.err) { ret res[Compiled, Unplaced].err{uncompiled(a, b, m, name, res_made.err)}; }
    var given: mirl_compile.Compiled = res_made.ok;
    fin { vector.dnit[Warning](?given.warnings); }
    # the object keeps the module's names, so a warning names its function through it, and the
    # module names nothing once the warnings are read
    mirl_module.lent_to(m, ?given.object.names);
    var out: Compiled = Compiled{object: given.object, warnings: vector.init[Unplaced](a)};
    var i:   usize    = 0;
    for (i < given.warnings.len) {
        val res_said: res[opt[Unplaced], fail.Fail] = warned(a, m, name, require, owner, given.warnings.data[i]);
        if (sel res_said.err) {
            mirl_module.spent(m);
            dnit(a, ?out);
            ret res[Compiled, Unplaced].err{bare(res_said.err)};
        }
        i = i + 1;
        var opt_said: opt[Unplaced] = res_said.ok;
        if (sel opt_said.none) { cnt; }
        val res_pushed: res[usize, A.Error] = vector.push[Unplaced](?out.warnings, opt_said.some);
        if (sel res_pushed.err) {
            unplaced_dnit(a, ?opt_said.some);
            mirl_module.spent(m);
            dnit(a, ?out);
            ret res[Compiled, Unplaced].err{bare(fail.refused(res_pushed.err))};
        }
    }
    mirl_module.spent(m);
    if (m.a != a) {
        val res_copied:  res[Object, mink_fail.Fail] = object.copy(a, ?out.object);
        val err_dropped: err[mink_fail.Fail]         = object.dnit(?out.object);
        if (sel res_copied.err) {
            warnings_dnit(a, ?out);
            ret res[Compiled, Unplaced].err{bare(refused_by_mink(a, "mink did not copy the compiled object", res_copied.err))};
        }
        out.object = res_copied.ok;
    }
    ret res[Compiled, Unplaced].ok{out};
}

# give back the warnings of what `compile` made, which own their text and places through `a`, the
# allocator it was given
pub fun warnings_dnit(a: *A.Allocator, c: *Compiled) {
    var i: usize = 0;
    for (i < c.warnings.len) {
        unplaced_dnit(a, ?c.warnings.data[i]);
        i = i + 1;
    }
    vector.dnit[Unplaced](?c.warnings);
}

# give back a failure of the compile, placed or not: its text and places, and the paths of the
# spots it still holds, all owned through `a`, the allocator the compile was given
pub fun unplaced_dnit(a: *A.Allocator, u: *Unplaced) {
    fail.dnit(a, u.fail);
    spots_dnit(a, u);
}

# give back the spots `u` holds, leaving it none
fun spots_dnit(a: *A.Allocator, u: *Unplaced) {
    if (sel u.at.some) { str_free(a, u.at.some.path); }
    u.at = opt[Spot].none{};
    var i: usize = 0;
    for (i < u.also.len) {
        str_free(a, u.also.data[i].path);
        i = i + 1;
    }
    vector.dnit[Spot](?u.also);
}

# the failure `u` placed in `sources`: at the byte of its spot, with the bytes of the spots it
# names besides as its related places, as `located` finds them. `u` holds the placed failure from
# then on and no spot, its spots given back through `a`, the allocator the compile was given
pub fun placed(a: *A.Allocator, sources: *base_source.SourceMap, u: *Unplaced) fail.Fail {
    fin { spots_dnit(a, u); }
    if (sel u.at.some) {
        val opt_at: opt[base_source.Location] = located(sources, u.at.some);
        if (sel opt_at.some) { u.fail = fail.at(u.fail, opt_at.some); }
    }
    if (u.also.len == 0) { ret u.fail; }
    var places: vector.Vector[base_source.Location] = vector.init[base_source.Location](a);
    fin { vector.dnit[base_source.Location](?places); }
    var i: usize = 0;
    for (i < u.also.len) {
        val opt_place: opt[base_source.Location] = located(sources, u.also.data[i]);
        i = i + 1;
        if (sel opt_place.none) { cnt; }
        val res_placed: res[usize, A.Error] = vector.push[base_source.Location](?places, opt_place.some);
        if (sel res_placed.err) {
            fail.dnit(a, u.fail);
            u.fail = fail.refused(res_placed.err);
            ret u.fail;
        }
    }
    u.fail = fail.with_related(a, u.fail, places.data, places.len);
    ret u.fail;
}

# the place in `sources` of the spot `s`, which holds a line and a column and no extent, so the
# one byte there in the file it names. a file `sources` does not hold, or a position past its
# text, is no place
fun located(sources: *base_source.SourceMap, s: Spot) opt[base_source.Location] {
    val file:       base_source.FileId           = base_source.find(sources, s.path);
    val opt_loaded: opt[*base_source.SourceFile] = base_source.get(sources, file);
    if (sel opt_loaded.none) { ret opt[base_source.Location].none{}; }
    val opt_offset: opt[usize] = base_source.offset_of(opt_loaded.some, base_source.Position{line: s.line, col: s.col});
    if (sel opt_offset.none) { ret opt[base_source.Location].none{}; }
    ret opt[base_source.Location].some{base_source.location(file, base_source.span(opt_offset.some, 1))};
}

# give back what `compile` made: its object and its warnings
pub fun dnit(a: *A.Allocator, c: *Compiled) {
    val err_released: err[mink_fail.Fail] = object.dnit(?c.object);
    warnings_dnit(a, c);
}

# a warning mirl gave compiling the module `name`, as the failure of its kind at the source
# location mirl states for it, none for one the build does not report
fun warned(a: *A.Allocator, m: *Module, name: str, require: bool, owner: str, w: Warning) res[opt[Unplaced], fail.Fail] {
    if (sel w.unheld) {
        val res_unheld: res[Unplaced, fail.Fail] = unheld(a, m, name, w.unheld);
        if (sel res_unheld.err) { ret res[opt[Unplaced], fail.Fail].err{res_unheld.err}; }
        ret res[opt[Unplaced], fail.Fail].ok{opt[Unplaced].some{res_unheld.ok}};
    }
    if (sel w.scalarized) { ret scalarized(a, m, name, require, owner, w.scalarized); }
    ret res[opt[Unplaced], fail.Fail].err{fail.message_of(diagnostic.join(a, "mirl gave a warning of '", name, "' of a case mach does not read"))};
}

# a soft constant-time function of the module `name` on a set that guarantees no instruction's
# timing, compiled with its timing not held, naming what the walk could not follow of it when it
# could not
fun unheld(a: *A.Allocator, m: *Module, name: str, u: mct.Unheld) res[Unplaced, fail.Fail] {
    val res_fname: res[str, fail.Fail] = function_name(a, m, u.function);
    if (sel res_fname.err) { ret res[Unplaced, fail.Fail].err{res_fname.err}; }
    var res_said: res[str, fail.Fail] = diagnostic.join(a, "'", res_fname.ok, "' of '", name, "': ", masc_ct.UNGUARANTEED);
    if (sel u.unread.some) { res_said = diagnostic.join(a, "'", res_fname.ok, "' of '", name, "': ", masc_ct.UNGUARANTEED, ", and mirl could not follow its encoded code to verify the rest: ", u.unread.some.message); }
    if (sel res_said.err)  { ret res[Unplaced, fail.Fail].err{res_said.err}; }
    ret res[Unplaced, fail.Fail].ok{unplaced(a, m, fail.owning(fail.user(diagnostic_kind.SECRET_TARGET_UNENFORCEABLE, res_said.ok)), u.location)};
}

# a vector operation of the module `name` that mirl took lane by lane, at its source location
# where it carries one: refused under `require`, whatever the cause, naming the dependency
# `owner` when the module is one's, and otherwise a warning where a vector unit holds its lanes
# and computes none of it and the location is there, and nothing for any other
fun scalarized(a: *A.Allocator, m: *Module, name: str, require: bool, owner: str, s: Scalarized) res[opt[Unplaced], fail.Fail] {
    if (!require) {
        if (!(sel s.cause.computed) || sel s.location.none) { ret res[opt[Unplaced], fail.Fail].ok{opt[Unplaced].none{}}; }
    }
    val res_what: res[str, fail.Fail] = operation_text(a, m, name, s);
    if (sel res_what.err) { ret res[opt[Unplaced], fail.Fail].err{res_what.err}; }
    var made: res[str, fail.Fail]  = diagnostic.join(a, "the ", res_what.ok, " is split into scalar operations, because no vector unit of the target computes it");
    var kind: diagnostic_kind.Kind = diagnostic_kind.VECTOR_SCALARIZE;
    if (require) {
        val res_function: res[str, fail.Fail] = function_name(a, m, s.function);
        if (sel res_function.err) { ret res[opt[Unplaced], fail.Fail].err{res_function.err}; }
        var res_fname: res[str, fail.Fail] = res_function;
        if (owner != nil)      { res_fname = diagnostic.join(a, res_function.ok, "' of dependency '", owner); }
        if (sel res_fname.err) { ret res[opt[Unplaced], fail.Fail].err{res_fname.err}; }
        val refused: str = ", so `simd = \"require\"` refuses its scalar expansion";
        kind = diagnostic_kind.VECTOR_SCALARIZE_REFUSED;
        if (sel s.cause.computed) { made = diagnostic.join(a, "'", res_fname.ok, "' has a ", res_what.ok, " that no vector unit of the target computes", refused); }
        or (sel s.cause.unheld)   { made = diagnostic.join(a, "'", res_fname.ok, "' has a ", res_what.ok, " that no vector unit of the target holds whole", refused); }
        or (sel s.cause.timed)    { made = diagnostic.join(a, "'", res_fname.ok, "' requires constant time and has a ", res_what.ok, " whose vector code the target does not time relative to its lanes", refused); }
        or                        { made = diagnostic.join(a, "'", res_fname.ok, "' has a ", res_what.ok, ", and the target holds no vector unit", refused); }
    }
    if (sel made.err) { ret res[opt[Unplaced], fail.Fail].err{made.err}; }
    ret res[opt[Unplaced], fail.Fail].ok{opt[Unplaced].some{unplaced(a, m, fail.owning(fail.user(kind, made.ok)), s.location)}};
}

# what a vector operation of the module `name` is, as `vector divide over 4 lanes of 32-bit integers`
fun operation_text(a: *A.Allocator, m: *Module, name: str, s: Scalarized) res[str, fail.Fail] {
    val opt_word: opt[str] = operation_word(s.opcode);
    if (sel opt_word.none) { ret res[str, fail.Fail].err{fail.message_of(diagnostic.join(a, "mirl took an operation of '", name, "' lane by lane that mach has no word for"))}; }
    val opt_vector: opt[mirl_types.Vector] = vector_of(m, s.vector);
    if (sel opt_vector.none) { ret res[str, fail.Fail].err{fail.message_of(diagnostic.join(a, "mirl took an operation of '", name, "' lane by lane that is stated at no vector type"))}; }
    val lanes:    u32                                     = opt_vector.some.lanes;
    val res_lane: res[mirl_types.Shape, mirl_types.Error] = mirl_types.shape(?m.types, opt_vector.some.element);
    if (sel res_lane.ok) {
        val lane: mirl_types.Shape = res_lane.ok;
        if (sel lane.integer) { ret diagnostic.format(a, "vector {} over {} lanes of {}-bit integers", opt_word.some, lanes, lane.integer.width); }
        if (sel lane.float) {
            val opt_format: opt[type_format.Row] = type_format.row(lane.float.format);
            if (sel opt_format.some) { ret diagnostic.format(a, "vector {} over {} lanes of {}-bit floats", opt_word.some, lanes, opt_format.some.width); }
        }
    }
    ret diagnostic.format(a, "vector {} over {} lanes of pointers", opt_word.some, lanes);
}

# the vector a type of `m` is, none for any other type
fun vector_of(m: *Module, ty: mirl_types.Type) opt[mirl_types.Vector] {
    val res_shape: res[mirl_types.Shape, mirl_types.Error] = mirl_types.shape(?m.types, ty);
    if (sel res_shape.err) { ret opt[mirl_types.Vector].none{}; }
    val shape: mirl_types.Shape = res_shape.ok;
    if (sel shape.vector) { ret opt[mirl_types.Vector].some{shape.vector}; }
    ret opt[mirl_types.Vector].none{};
}

# the noun a message names a vector operation by, a row of WORDS
# ---
# code: the operation
# word: what it is called, a noun that reads after `vector`, as `vector bitwise and`
rec Word {
    code: opcode_row.Opcode;
    word: str;
}

# a word for every operation the vector legalisation takes over lanes
val WORDS: [98]Word = [98]Word{
    Word{code: opcode_table.ADD, word: "add"},
    Word{code: opcode_table.SUB, word: "subtract"},
    Word{code: opcode_table.MUL, word: "multiply"},
    Word{code: opcode_table.DIV_S, word: "divide"},
    Word{code: opcode_table.DIV_U, word: "divide"},
    Word{code: opcode_table.REM_S, word: "remainder"},
    Word{code: opcode_table.REM_U, word: "remainder"},
    Word{code: opcode_table.AND, word: "bitwise and"},
    Word{code: opcode_table.OR, word: "bitwise or"},
    Word{code: opcode_table.XOR, word: "bitwise exclusive or"},
    Word{code: opcode_table.SHL, word: "left shift"},
    Word{code: opcode_table.SHR_U, word: "right shift"},
    Word{code: opcode_table.SHR_S, word: "right shift"},
    Word{code: opcode_table.NEG, word: "negation"},
    Word{code: opcode_table.NOT, word: "complement"},
    Word{code: opcode_table.EQ, word: "comparison"},
    Word{code: opcode_table.NE, word: "comparison"},
    Word{code: opcode_table.LT_S, word: "comparison"},
    Word{code: opcode_table.LE_S, word: "comparison"},
    Word{code: opcode_table.GT_S, word: "comparison"},
    Word{code: opcode_table.GE_S, word: "comparison"},
    Word{code: opcode_table.LT_U, word: "comparison"},
    Word{code: opcode_table.LE_U, word: "comparison"},
    Word{code: opcode_table.GT_U, word: "comparison"},
    Word{code: opcode_table.GE_U, word: "comparison"},
    Word{code: opcode_table.FADD, word: "add"},
    Word{code: opcode_table.FSUB, word: "subtract"},
    Word{code: opcode_table.FMUL, word: "multiply"},
    Word{code: opcode_table.FDIV, word: "divide"},
    Word{code: opcode_table.FREM, word: "remainder"},
    Word{code: opcode_table.FMIN, word: "minimum"},
    Word{code: opcode_table.FMAX, word: "maximum"},
    Word{code: opcode_table.FMINNUM, word: "minimum"},
    Word{code: opcode_table.FMAXNUM, word: "maximum"},
    Word{code: opcode_table.FCOPYSIGN, word: "sign copy"},
    Word{code: opcode_table.FNEG, word: "negation"},
    Word{code: opcode_table.FABS, word: "absolute value"},
    Word{code: opcode_table.FSQRT, word: "square root"},
    Word{code: opcode_table.FFLOOR, word: "floor"},
    Word{code: opcode_table.FCEIL, word: "ceiling"},
    Word{code: opcode_table.FINT, word: "truncation"},
    Word{code: opcode_table.FNEAREST, word: "rounding"},
    Word{code: opcode_table.FMA, word: "fused multiply and add"},
    Word{code: opcode_table.FLT_O, word: "comparison"},
    Word{code: opcode_table.FEQ_O, word: "comparison"},
    Word{code: opcode_table.FNE_O, word: "comparison"},
    Word{code: opcode_table.FLE_O, word: "comparison"},
    Word{code: opcode_table.FGT_O, word: "comparison"},
    Word{code: opcode_table.FGE_O, word: "comparison"},
    Word{code: opcode_table.FORD, word: "comparison"},
    Word{code: opcode_table.FEQ_U, word: "comparison"},
    Word{code: opcode_table.FNE_U, word: "comparison"},
    Word{code: opcode_table.FLT_U, word: "comparison"},
    Word{code: opcode_table.FLE_U, word: "comparison"},
    Word{code: opcode_table.FGT_U, word: "comparison"},
    Word{code: opcode_table.FGE_U, word: "comparison"},
    Word{code: opcode_table.FUNO, word: "comparison"},
    Word{code: opcode_table.EXT_U, word: "widening"},
    Word{code: opcode_table.EXT_S, word: "widening"},
    Word{code: opcode_table.TRUNC, word: "narrowing"},
    Word{code: opcode_table.ITOF_S, word: "conversion"},
    Word{code: opcode_table.ITOF_U, word: "conversion"},
    Word{code: opcode_table.FTOI_S, word: "conversion"},
    Word{code: opcode_table.FTOI_U, word: "conversion"},
    Word{code: opcode_table.FPROMOTE, word: "conversion"},
    Word{code: opcode_table.FDEMOTE, word: "conversion"},
    Word{code: opcode_table.SELECT, word: "selection"},
    Word{code: opcode_table.ADD_OV_S, word: "add with overflow"},
    Word{code: opcode_table.ADD_OV_U, word: "add with overflow"},
    Word{code: opcode_table.SUB_OV_S, word: "subtract with overflow"},
    Word{code: opcode_table.SUB_OV_U, word: "subtract with overflow"},
    Word{code: opcode_table.MUL_OV_S, word: "multiply with overflow"},
    Word{code: opcode_table.MUL_OV_U, word: "multiply with overflow"},
    Word{code: opcode_table.MUL_HIGH_U, word: "high multiply"},
    Word{code: opcode_table.MUL_HIGH_S, word: "high multiply"},
    Word{code: opcode_table.MUL_HIGH_SU, word: "high multiply"},
    Word{code: opcode_table.DIV_WIDE_U, word: "wide divide"},
    Word{code: opcode_table.POPCNT, word: "bit count"},
    Word{code: opcode_table.CLZ, word: "leading zero count"},
    Word{code: opcode_table.CTZ, word: "trailing zero count"},
    Word{code: opcode_table.BSWAP, word: "byte swap"},
    Word{code: opcode_table.REDUCE_ADD, word: "sum reduction"},
    Word{code: opcode_table.REDUCE_FADD_ANY, word: "sum reduction"},
    Word{code: opcode_table.REDUCE_FADD_SEQ, word: "sum reduction"},
    Word{code: opcode_table.REDUCE_MUL, word: "product reduction"},
    Word{code: opcode_table.REDUCE_FMUL_ANY, word: "product reduction"},
    Word{code: opcode_table.REDUCE_FMUL_SEQ, word: "product reduction"},
    Word{code: opcode_table.REDUCE_AND, word: "bitwise and reduction"},
    Word{code: opcode_table.REDUCE_OR, word: "bitwise or reduction"},
    Word{code: opcode_table.REDUCE_XOR, word: "bitwise exclusive or reduction"},
    Word{code: opcode_table.REDUCE_SMIN, word: "minimum reduction"},
    Word{code: opcode_table.REDUCE_UMIN, word: "minimum reduction"},
    Word{code: opcode_table.REDUCE_FMIN, word: "minimum reduction"},
    Word{code: opcode_table.REDUCE_FMINNUM, word: "minimum reduction"},
    Word{code: opcode_table.REDUCE_SMAX, word: "maximum reduction"},
    Word{code: opcode_table.REDUCE_UMAX, word: "maximum reduction"},
    Word{code: opcode_table.REDUCE_FMAX, word: "maximum reduction"},
    Word{code: opcode_table.REDUCE_FMAXNUM, word: "maximum reduction"},
};

# the word of a vector operation, none for one the legalisation never takes over lanes
fun operation_word(code: opcode_row.Opcode) opt[str] {
    var i: usize = 0;
    for (i < $length_of(WORDS)) {
        if (WORDS[i].code == code) { ret opt[str].some{WORDS[i].word}; }
        i = i + 1;
    }
    ret opt[str].none{};
}

# why mirl did not compile the module `name`. a failure whose chain ends at the allocator's refusal anywhere is that
# refusal, whatever its outer case, reported with no storage of its own. which of mirl's and masc's other refusals the
# source can clear is decided here, by their own cases: a refusal mach words itself is a user failure under its row of
# the diagnostic table, at the source location mirl states for it, and every other refusal is reported in mirl's
# words by `mirl_refused`
fun uncompiled(a: *A.Allocator, b: *Back, m: *Module, name: str, e: mirl_family.Error) Unplaced {
    val opt_starved: opt[A.Error] = mirl_failure.starved_of(e);
    if (sel opt_starved.some) { ret bare(fail.refused(opt_starved.some)); }
    if (sel e.timing)         { ret untimed(a, m, name, e.timing, "the ir's constant-time check"); }
    if (sel e.foreign)        { ret bare(foreign_refused(a, m, name, e.foreign)); }
    var opt_source: opt[Unplaced] = opt[Unplaced].none{};
    if (sel e.schedule)      { opt_source = pass_refused(a, m, name, e.schedule); }
    or (sel e.register)      { opt_source = register_refused(a, m, name, e.register); }
    or (sel e.spirv)         { opt_source = spirv_refused(a, m, name, e.spirv); }
    or (sel e.wasm)          { opt_source = wasm_refused(a, m, name, e.wasm); }
    if (sel opt_source.some) { ret opt_source.some; }
    ret mirl_refused(a, b, m, name, e);
}

# mirl's words for the failure `e` of the module `name`, its whole chain from the outer case to the leaf: the
# environment's where mirl classes it so, a user failure under the row `source_kind` names for a case the source
# clears, at the location it states, and the compiler's otherwise
fun mirl_refused(a: *A.Allocator, b: *Back, m: *Module, name: str, e: mirl_family.Error) Unplaced {
    var held: std_writer.Memory = std_writer.Memory{};
    var w:    std_writer.Writer = std_writer.memory_growing(?held, a);
    fin { std_writer.memory_dnit(?held); }
    var o:      mirl_failure.Out   = mirl_failure.Out{a: a, w: ?w, file: nil, head: nil};
    val class:  mirl_failure.Class = mirl_failure.compiled(?o, m, ?b.assembled.target, assembled.added(b.assembled), e);
    var length: usize              = held.len;
    if (length > 0 && held.buf[length - 1] == '\n') { length = length - 1; }
    val res_chain: res[str, StrError] = str_copy_slice(a, std_writer.memory_text(?held), 0, length);
    if (sel res_chain.err) { ret bare(fail.str_refused(res_chain.err)); }
    fin { str_free(a, res_chain.ok); }
    val res_said: res[str, fail.Fail] = diagnostic.join(a, "'", name, "' cannot be compiled, as mirl refused it:\n", res_chain.ok);
    if (sel res_said.err)      { ret bare(res_said.err); }
    if (sel class.environment) { ret bare(fail.owning(fail.environment(diagnostic_kind.MEMORY_REFUSED, res_said.ok))); }
    val kind: diagnostic_kind.Kind = source_kind(e);
    if (kind != diagnostic_kind.NONE) { ret unplaced(a, m, fail.owning(fail.user(kind, res_said.ok)), source_at(m, e)); }
    ret bare(fail.owning(fail.message(res_said.ok)));
}

# the row a refusal mirl words is the source's under, NONE for one that is the compiler's
fun source_kind(e: mirl_family.Error) diagnostic_kind.Kind {
    if (sel e.schedule) {
        val p: pass_failure.Error = e.schedule;
        if (sel p.refused) { ret pass_kind(p.refused.why); }
    }
    if (sel e.spirv) { ret spirv_kind(e.spirv); }
    ret diagnostic_kind.NONE;
}

# the source location a refusal mirl words names, none where it names none
fun source_at(m: *Module, e: mirl_family.Error) opt[mirl_debug.Location] {
    if (sel e.schedule) {
        val p: pass_failure.Error = e.schedule;
        if (sel p.refused) {
            val w: refusal.Error = p.refused.why;
            if (sel w.slot) { ret w.slot.location; }
        }
    }
    if (sel e.spirv) { ret spirv_at(m, e.spirv); }
    ret opt[mirl_debug.Location].none{};
}

# the failure `f` with no spot
pub fun bare(f: fail.Fail) Unplaced {
    ret Unplaced{fail: f, at: opt[Spot].none{}};
}

# the failure `f` at the source location `at` of the debug table of `m`, its spot the file path,
# line and column the table states, read from the module alone. a location mirl does not state,
# or one the table does not hold, leaves it with no spot
fun unplaced(a: *A.Allocator, m: *Module, f: fail.Fail, at: opt[mirl_debug.Location]) Unplaced {
    if (sel at.none) { ret bare(f); }
    val res_position: res[mirl_debug.Position, mirl_debug_table.Error] = mirl_debug_place.position(?m.debug, at.some);
    if (sel res_position.err) { ret bare(f); }
    val res_path: res[View, mirl_debug_table.Error] = mirl_debug_place.path(?m.debug, res_position.ok.file);
    if (sel res_path.err) { ret bare(f); }
    val res_copied: res[str, StrError] = str_copy_slice(a, res_path.ok.data, 0, res_path.ok.len);
    if (sel res_copied.err) { ret bare(fail.str_refused(res_copied.err)); }
    ret Unplaced{fail: f, at: opt[Spot].some{Spot{path: res_copied.ok, line: res_position.ok.line::usize, col: res_position.ok.column::usize}}};
}

# a function of the module `name` holding an operation the target's family does not serve
fun foreign_refused(a: *A.Allocator, m: *Module, name: str, e: mirl_family.Foreign) fail.Fail {
    val res_fname: res[str, fail.Fail] = function_name(a, m, e.function);
    if (sel res_fname.err) { ret res_fname.err; }
    ret fail.user_of(diagnostic_kind.TARGET_UNSUPPORTED_OP, diagnostic.join(a, "'", res_fname.ok, "' of '", name, "' holds the operation ", e.row.name, ", which the target's family does not serve"));
}

# what of mirl's pass schedule's refusal of the module `name` mach words itself: a symbol the source defines under a
# name mirl delivers, and a thread-local global a constant-time function reaches through the runtime's resolver
fun pass_refused(a: *A.Allocator, m: *Module, name: str, e: pass_failure.Error) opt[Unplaced] {
    if (!(sel e.refused)) { ret opt[Unplaced].none{}; }
    val r: pass_failure.Refusal = e.refused;
    if (sel r.why.resolved) { ret opt[Unplaced].some{resolved_refused(a, m, name, r.why.resolved)}; }
    if (!(sel r.why.taken)) { ret opt[Unplaced].none{}; }
    var where: str = "the module";
    if (sel r.function.some) {
        val res_fname: res[str, fail.Fail] = function_name(a, m, r.function.some);
        if (sel res_fname.err) { ret opt[Unplaced].some{bare(res_fname.err)}; }
        where = res_fname.ok;
    }
    ret opt[Unplaced].some{taken_refused(a, m, name, where, r.why.taken)};
}

# a symbol of the module `name` defined under a name mirl delivers a symbol of its own under, as
# the code of `asking` asked for it, at the place the source defines it
fun taken_refused(a: *A.Allocator, m: *Module, name: str, asking: str, t: refusal.Taken) Unplaced {
    var res_symbol: res[str, fail.Fail] = res[str, fail.Fail].err{fail.message("mirl refused a symbol its module does not hold")};
    if (sel t.symbol.function) { res_symbol = function_name(a, m, t.symbol.function); }
    or (sel t.symbol.global)   { res_symbol = global_name(a, m, t.symbol.global); }
    if (sel res_symbol.err)    { ret bare(res_symbol.err); }
    val res_said: res[str, fail.Fail] = diagnostic.join(a, "'", res_symbol.ok, "' of '", name, "' has the name mirl gives ", t.wanted, " that '", asking, "' needs, and mirl never takes the source's symbol for its own. rename it");
    if (sel res_said.err) { ret bare(res_said.err); }
    ret unplaced(a, m, fail.owning(fail.user(diagnostic_kind.NAME_RESERVED, res_said.ok)), t.location);
}

# a function of the module `name` that requires constant time and reaches a thread-local global through a call of
# the runtime's resolver, at the function's first source location
fun resolved_refused(a: *A.Allocator, m: *Module, name: str, r: refusal.Resolved) Unplaced {
    val res_fname: res[str, fail.Fail] = function_name(a, m, r.function);
    if (sel res_fname.err) { ret bare(res_fname.err); }
    val res_gname: res[str, fail.Fail] = global_name(a, m, r.global);
    if (sel res_gname.err) { ret bare(res_gname.err); }
    val res_said: res[str, fail.Fail] = diagnostic.join(a, "'", res_fname.ok, "' of '", name, "' requires constant time and reaches the thread-local '", res_gname.ok, "', which the target reaches through a call of the runtime's resolver, whose code the constant-time check cannot see into");
    if (sel res_said.err) { ret bare(res_said.err); }
    ret unplaced(a, m, fail.owning(fail.user(diagnostic_kind.SECRET_UNVERIFIABLE, res_said.ok)), mct.location(m, r.function));
}

# the row a pass's refusal of the source is reported under, NONE for one that is the compiler's
fun pass_kind(w: refusal.Error) diagnostic_kind.Kind {
    if (sel w.timing)      { ret diagnostic_kind.SECRET_UNVERIFIABLE; }
    if (sel w.unheld)      { ret diagnostic_kind.TARGET_NO_FLOAT; }
    if (sel w.threaded)    { ret diagnostic_kind.TARGET_UNSUPPORTED_OP; }
    if (sel w.absent)      { ret diagnostic_kind.TARGET_UNSUPPORTED_OP; }
    if (sel w.exported)    { ret diagnostic_kind.TARGET_UNSUPPORTED_OP; }
    if (sel w.resolved)    { ret diagnostic_kind.SECRET_UNVERIFIABLE; }
    if (sel w.specialized) { ret diagnostic_kind.TARGET_UNSUPPORTED_OP; }
    if (sel w.slot)        { ret diagnostic_kind.TARGET_UNSUPPORTED_OP; }
    if (sel w.taken)       { ret diagnostic_kind.NAME_RESERVED; }
    ret diagnostic_kind.NONE;
}

# what the object's sections refuse of the module `name`, and what masc refused of an asm block as
# its operands were placed, which the source states; none for any other refusal of emission
fun emit_rejected(a: *A.Allocator, m: *Module, name: str, e: handover.Error) opt[Unplaced] {
    if (sel e.section) {
        val sym: id.Symbol = e.section;
        if (sel sym.function) {
            val res_fname: res[str, fail.Fail] = function_name(a, m, sym.function);
            if (sel res_fname.err) { ret opt[Unplaced].some{bare(res_fname.err)}; }
            ret opt[Unplaced].some{bare(fail.user_of(diagnostic_kind.LINK_SECTION_UNSUPPORTED, diagnostic.join(a, "'", res_fname.ok, "' of '", name, "' names a section a global or another function names with another kind")))};
        }
        val res_gname: res[str, fail.Fail] = global_name(a, m, sym.global);
        if (sel res_gname.err) { ret opt[Unplaced].some{bare(res_gname.err)}; }
        ret opt[Unplaced].some{bare(fail.user_of(diagnostic_kind.LINK_SECTION_UNSUPPORTED, diagnostic.join(a, "'", res_gname.ok, "' of '", name, "' names a section a function or another global names with another kind")))};
    }
    if (sel e.inline) {
        val res_fname: res[str, fail.Fail] = function_name(a, m, e.inline.at.function);
        if (sel res_fname.err) { ret opt[Unplaced].some{bare(res_fname.err)}; }
        val text: fail.Fail = fail.user_of(diagnostic_kind.ASM_OPERAND, diagnostic.join(a, "an asm block of '", res_fname.ok, "' of '", name, "' is refused (", e.inline.message, ")"));
        ret opt[Unplaced].some{unplaced(a, m, text, e.inline.at.location)};
    }
    ret opt[Unplaced].none{};
}

# what of mirl's register back end's refusal of the module `name` is the source's: a constant-time walk of the
# encoded code, an asm block, a naked body, a frame an asm block breaks and what `emit_rejected` names
fun register_refused(a: *A.Allocator, m: *Module, name: str, failed: mirl_machine.Failed) opt[Unplaced] {
    val e: mirl_machine.Error = failed.error;
    if (sel failed.function.some) { ret function_refused(a, m, name, failed, failed.function.some); }
    if (sel e.walked) {
        val every: Slice[mct.Error] = e.walked;
        if (every.size > 0) { ret opt[Unplaced].some{walk_refused(a, m, name, every)}; }
    }
    if (sel e.emit) { ret emit_rejected(a, m, name, e.emit); }
    ret opt[Unplaced].none{};
}

# every function of the module `name` the walk of its encoded code refused, each with its place: the first one's
# failure, its text naming what refused each other one as well, at that one's place among its related places, in the
# order mirl emitted them
fun walk_refused(a: *A.Allocator, m: *Module, name: str, every: Slice[mct.Error]) Unplaced {
    var first: Unplaced = walk_one(a, m, name, every.data[0]);
    if (every.size == 1) { ret first; }
    val opt_head: opt[str] = fail.text(first.fail);
    if (sel opt_head.none) { ret first; }
    var text: str = opt_head.some;
    first.also = vector.init[Spot](a);
    var i: usize = 1;
    for (i < every.size) {
        var other: Unplaced = walk_one(a, m, name, every.data[i]);
        fin { unplaced_dnit(a, ?other); }
        val opt_said: opt[str] = fail.text(other.fail);
        if (sel opt_said.some) {
            val res_joined: res[str, fail.Fail] = diagnostic.join(a, text, ". also, ", opt_said.some);
            if (sel res_joined.err) { ret bare(res_joined.err); }
            text = res_joined.ok;
        }
        val opt_spot: opt[Spot] = other.at;
        other.at = opt[Spot].none{};
        if (sel opt_spot.some) {
            val res_placed: res[usize, A.Error] = vector.push[Spot](?first.also, opt_spot.some);
            if (sel res_placed.err) {
                str_free(a, opt_spot.some.path);
                ret bare(fail.refused(res_placed.err));
            }
        }
        i = i + 1;
    }
    first.fail = fail.owning(fail.with_text(first.fail, text));
    ret first;
}

# what the walk of a constant-time function's encoded code found of it
fun walk_one(a: *A.Allocator, m: *Module, name: str, unmet: mct.Error) Unplaced {
    if (sel unmet.refused)      { ret untimed(a, m, name, unmet.refused, "the walk of its encoded code"); }
    if (sel unmet.unfollowed)   { ret unfollowed(a, m, name, unmet.unfollowed); }
    if (sel unmet.unguaranteed) { ret unguaranteed(a, m, name, unmet.unguaranteed); }
    if (sel unmet.stale)        { ret stale(a, m, name, unmet.stale); }
    ret bare(fail.message("the walk of a constant-time function refused it in a case mach does not read"));
}

# what of a refusal of the function `function` of the module `name` at a stage of the register back end is the
# source's, at the source location of the instruction it names
fun function_refused(a: *A.Allocator, m: *Module, name: str, failed: mirl_machine.Failed, function: Function) opt[Unplaced] {
    val res_fname: res[str, fail.Fail] = function_name(a, m, function);
    if (sel res_fname.err) { ret opt[Unplaced].some{bare(res_fname.err)}; }
    val stage: mirl_machine.Error = failed.error;
    if (sel stage.timing) {
        val found: fail.Fail = fail.user_of(timing_kind(?stage.timing.refusal), diagnostic.join(a, "'", res_fname.ok, "' of '", name, "' requires constant time, but the machine form's check refused an instruction of it. ", masc_ct.message(?stage.timing.refusal)));
        ret opt[Unplaced].some{unplaced(a, m, found, failed.location)};
    }
    if (sel stage.select) {
        val selection: mirl_engine.Error = stage.select;
        if (sel selection.assembly) { ret opt[Unplaced].some{unplaced(a, m, block_refused(a, res_fname.ok, selection.assembly.refusal), failed.location)}; }
        if (sel selection.naked) {
            ret opt[Unplaced].some{unplaced(a, m, fail.user_of(diagnostic_kind.NAKED_BODY, diagnostic.join(a, "'", res_fname.ok, "' of '", name, "' is naked, and holds an instruction other than an asm block that binds nothing")), failed.location)};
        }
    }
    if (sel stage.frame) {
        val framed: frame_finish.Error = stage.frame;
        if (sel framed.moved) {
            ret opt[Unplaced].some{unplaced(a, m, fail.user_of(diagnostic_kind.ASM_UNSUPPORTED, diagnostic.join(a, "an asm block of '", res_fname.ok, "' binds a name off the stack pointer and moves the stack pointer, which moves the name's address. push and pop around the block, or stage the address into a register before the block")), failed.location)};
        }
        if (sel framed.rebased) {
            ret opt[Unplaced].some{unplaced(a, m, fail.user_of(diagnostic_kind.ASM_UNSUPPORTED, diagnostic.join(a, "an asm block of '", res_fname.ok, "' binds a local and writes the register its locals are addressed off, which '", res_fname.ok, "' keeps the realigned stack pointer in, because it holds an over-aligned local and moves the stack pointer. stage the address into a register before the block, or leave that register alone")), failed.location)};
        }
        if (sel framed.lay) {
            # the allocator never assigns a kept frame pointer, so only an asm block writes it
            val laid: frame_lay.Error = framed.lay;
            if (sel laid.taken) {
                ret opt[Unplaced].some{unplaced(a, m, fail.user_of(diagnostic_kind.ASM_UNSUPPORTED, diagnostic.join(a, "an asm block of '", res_fname.ok, "' writes the frame pointer, which '", res_fname.ok, "' keeps and addresses its frame off. leave that register alone")), failed.location)};
            }
        }
    }
    ret opt[Unplaced].none{};
}

# what of mirl's spir-v back end's refusal of the module `name` mach words itself, at the source location of the
# instruction it names
fun spirv_refused(a: *A.Allocator, m: *Module, name: str, q: mirl_spirv.Error) opt[Unplaced] {
    if (sel q.unmet)      { ret opt[Unplaced].some{unplaced(a, m, fail.user_of(diagnostic_kind.SPIRV_CAPABILITY, diagnostic.join(a, "'", name, "' needs ", q.unmet.name, ", which the target's selection does not hold")), unmet_at(q.unmet))}; }
    if (sel q.bounded)    { ret opt[Unplaced].some{bare(fail.user_of(diagnostic_kind.SPIRV_CAPABILITY, diagnostic.join(a, "'", name, "' cannot be compiled, because the target selects ", q.bounded.atom, ", which the ", q.bounded.env, " environment cannot hold. drop it from `ext`, or target an environment that holds it")))}; }
    if (sel q.passed)     { ret opt[Unplaced].some{unplaced(a, m, fail.user_of(diagnostic_kind.SPIRV_UNSUPPORTED, diagnostic.join(a, "'", name, "' passes a pointer into ", passed_reach(q.passed.whole), "the ", q.passed.class, " storage class, which no call can pass, so pass the value or reach the binding in the callee")), q.passed.at.location)}; }
    if (sel q.atomic)     { ret opt[Unplaced].some{unplaced(a, m, fail.user_of(diagnostic_kind.SPIRV_CAPABILITY, diagnostic.join(a, "'", name, "' has an atomic on memory of the ", q.atomic.class, " storage class, which Vulkan allows only on buffer memory, workgroup memory and image texels (VUID-StandaloneSpirv-None-04686). keep the value in a `#[gpu.storage]` buffer or a `#[gpu.shared]` variable")), q.atomic.at.location)}; }
    if (!spirv_worded(q)) { ret opt[Unplaced].none{}; }
    ret opt[Unplaced].some{unplaced(a, m, fail.user_of(spirv_kind(q), spirv_said(a, m, name, q)), spirv_at(m, q))};
}

# whether `spirv_said` words a spir-v refusal in its own terms
fun spirv_worded(q: mirl_spirv.Error) bool {
    ret sel q.interface || sel q.pointee || sel q.readonly || sel q.writeonly || sel q.operand_value || sel q.not_constant || sel q.signature || sel q.flow || sel q.recursion || sel q.executed || sel q.image;
}

# what a spir-v refusal of the module `name` says, of a case `spirv_worded` holds of
fun spirv_said(a: *A.Allocator, m: *Module, name: str, q: mirl_spirv.Error) res[str, fail.Fail] {
    if (sel q.interface) { ret interface_said(a, m, name, q.interface); }
    if (sel q.pointee) {
        ret diagnostic.format(a, "'{}' cannot be compiled for SPIR-V. memory a physical pointer reaches holds a value at byte {} that {} places at byte {}, and a storage buffer keeps its declared layout and is never repacked. pad the members so the two agree",
            name, q.pointee.layout.offset, q.pointee.layout.rules, q.pointee.layout.placed);
    }
    if (sel q.readonly) {
        val res_binding: res[str, fail.Fail] = global_name(a, m, q.readonly.binding);
        if (sel res_binding.err) { ret res_binding; }
        if (sel q.readonly.why.push) {
            ret diagnostic.join(a, "'", name, "' cannot be compiled for SPIR-V. a store reaches the push-constant block '", res_binding.ok, "', which only the host writes. copy the value into a local to change it");
        }
        ret diagnostic.join(a, "'", name, "' cannot be compiled for SPIR-V. a store reaches the `\"readonly\"` binding '", res_binding.ok, "', which the qualifier declares nothing writes. drop the qualifier to write it");
    }
    if (sel q.writeonly) {
        val res_binding: res[str, fail.Fail] = global_name(a, m, q.writeonly.binding);
        if (sel res_binding.err) { ret res_binding; }
        ret diagnostic.join(a, "'", name, "' cannot be compiled for SPIR-V. a load reaches the `\"writeonly\"` binding '", res_binding.ok, "', which the qualifier declares nothing reads. drop the qualifier to read it");
    }
    if (sel q.operand_value) {
        val v: mirl_spirv.Valued = q.operand_value;
        if (sel v.why.brought) {
            ret diagnostic.format(a, "'{}' cannot be compiled for SPIR-V. argument {} of the call is {}, which brings {} operands after the instruction's others, but the call passes {}. call a declaration that takes exactly the operands the value brings",
                name, v.operand.operand + 1, v.value, v.why.brought.brings, v.why.brought.passed);
        }
        ret diagnostic.format(a, "'{}' cannot be compiled for SPIR-V. argument {} of the call is {}, but its operand admits only {}", name, v.operand.operand + 1, v.value, v.why.outside);
    }
    if (sel q.not_constant) {
        ret diagnostic.format(a, "'{}' cannot be compiled for SPIR-V. argument {} of the call must be a constant, such as a literal, a module-scope `val` or an aggregate of them, since its operand is a constant id or a literal", name, q.not_constant.operand + 1);
    }
    if (sel q.signature) {
        ret diagnostic.format(a, "'{}' cannot be compiled for SPIR-V. argument {} of the call is of a kind its operand does not take, which takes {}. declare the parameter as that kind", name, q.signature.operand.operand + 1, q.signature.admits);
    }
    if (sel q.flow) {
        ret diagnostic.join(a, "'", name, "' cannot be compiled for SPIR-V. the call's result is used where its instruction's result cannot flow. pass it directly to the instruction that consumes it, in the block that makes it");
    }
    if (sel q.mixed) {
        ret diagnostic.format(a, "'{}' cannot be compiled for SPIR-V. argument {} of this call is {} and the same argument of another call of the function is {}, and SPIR-V gives the two pointers different types. split the function into one for each",
            name, q.mixed.parameter + 1, mixed_reach(q.mixed.whole), mixed_reach(!q.mixed.whole));
    }
    if (sel q.recursion) {
        val res_called: res[str, fail.Fail] = function_name(a, m, q.recursion.function);
        if (sel res_called.err) { ret res_called; }
        ret diagnostic.join(a, "'", name, "' cannot be compiled for SPIR-V. '", res_called.ok, "' reaches itself through this call, and a SPIR-V module allows no recursion. write the recursion as a loop");
    }
    if (sel q.executed) {
        val res_entry: res[str, fail.Fail] = function_name(a, m, q.executed.entry);
        if (sel res_entry.err) { ret res_entry; }
        ret diagnostic.format(a, "'{}' cannot be compiled for SPIR-V. the {} stage '{}' reaches this instruction, which executes only in {}. call it only from those stages",
            name, q.executed.stage, res_entry.ok, q.executed.models);
    }
    if (sel q.image) {
        ret diagnostic.format(a, "'{}' cannot be compiled for SPIR-V. argument {} of the call is an image or image operands its instruction does not take, which takes {}", name, q.image.operand.operand + 1, q.image.why);
    }
    ret res[str, fail.Fail].err{fail.message("a spir-v refusal `spirv_worded` does not hold was worded as one it does")};
}

# what a refusal of a stage's interface of the module `name` says, naming the global it stands
# at and what its rule names
fun interface_said(a: *A.Allocator, m: *Module, name: str, i: mirl_spirv.Interface) res[str, fail.Fail] {
    var named: str = "";
    if (sel i.site.global) {
        val res_global: res[str, fail.Fail] = global_name(a, m, i.site.global);
        if (sel res_global.err) { ret res_global; }
        val res_quoted: res[str, fail.Fail] = diagnostic.join(a, " '", res_global.ok, "'");
        if (sel res_quoted.err) { ret res_quoted; }
        named = res_quoted.ok;
    }
    val r: mirl_spirv.Rule = i.rule;
    if (sel r.builtin) {
        val res_entry: res[str, fail.Fail] = function_name(a, m, r.builtin.entry);
        if (sel res_entry.err) { ret res_entry; }
        ret diagnostic.format(a, "'{}' cannot be compiled for SPIR-V. the {} stage '{}' reaches the built-in{} ({}), which exists only in {}. use it only from those stages",
            name, r.builtin.stage, res_entry.ok, named, r.builtin.builtin, r.builtin.exists);
    }
    if (sel r.handle) {
        val res_entry: res[str, fail.Fail] = function_name(a, m, r.handle.entry);
        if (sel res_entry.err) { ret res_entry; }
        ret diagnostic.format(a, "'{}' cannot be compiled for SPIR-V. the {} stage '{}' reaches the handle binding{}, which exists only in {} ({}). use it only from those stages",
            name, r.handle.stage, res_entry.ok, named, r.handle.exists, r.handle.why);
    }
    if (sel r.shared) {
        val res_entry: res[str, fail.Fail] = function_name(a, m, r.shared.entry);
        if (sel res_entry.err) { ret res_entry; }
        ret diagnostic.format(a, "'{}' cannot be compiled for SPIR-V. the {} stage '{}' reaches the `#[gpu.shared]` variable{}, which exists only in a compute stage",
            name, r.shared.stage, res_entry.ok, named);
    }
    if (sel r.output) {
        val res_entry: res[str, fail.Fail] = function_name(a, m, r.output.entry);
        if (sel res_entry.err) { ret res_entry; }
        ret diagnostic.format(a, "'{}' cannot be compiled for SPIR-V. the {} stage '{}' reaches the output{}, and Vulkan allows no Output variable in that stage. write the result to a `#[gpu.storage]` buffer",
            name, r.output.stage, res_entry.ok, named);
    }
    if (sel r.flat) {
        val res_fragment: res[str, fail.Fail] = function_name(a, m, r.flat.fragment);
        if (sel res_fragment.err) { ret res_fragment; }
        val res_vertex: res[str, fail.Fail] = function_name(a, m, r.flat.vertex);
        if (sel res_vertex.err) { ret res_vertex; }
        ret diagnostic.format(a, "'{}' cannot be compiled for SPIR-V. the input{} is read by the fragment stage '{}', which reads an integer or 64-bit input only as Flat, and by the vertex stage '{}', whose inputs Flat may not decorate. give the two stages inputs of their own",
            name, named, res_fragment.ok, res_vertex.ok);
    }
    if (sel r.push) {
        val res_entry: res[str, fail.Fail] = function_name(a, m, r.push.entry);
        if (sel res_entry.err) { ret res_entry; }
        val res_other: res[str, fail.Fail] = global_name(a, m, r.push.other);
        if (sel res_other.err) { ret res_other; }
        ret diagnostic.format(a, "'{}' cannot be compiled for SPIR-V. the stage '{}' uses the push-constant block{} and '{}', and Vulkan allows one per entry point. merge them into one block",
            name, res_entry.ok, named, res_other.ok);
    }
    if (sel r.spec) {
        val res_other: res[str, fail.Fail] = global_name(a, m, r.spec.other);
        if (sel res_other.err) { ret res_other; }
        ret diagnostic.format(a, "'{}' cannot be compiled for SPIR-V. the `#[gpu.spec({})]` var{} and '{}' share one id, and the host names a specialization constant by its id. give them different ids",
            name, r.spec.id, named, res_other.ok);
    }
    if (sel r.workgroup) {
        val res_first: res[str, fail.Fail] = function_name(a, m, r.workgroup.first);
        if (sel res_first.err) { ret res_first; }
        val res_second: res[str, fail.Fail] = function_name(a, m, r.workgroup.second);
        if (sel res_second.err) { ret res_second; }
        ret diagnostic.format(a, "'{}' cannot be compiled for SPIR-V. the compute stages '{}' and '{}' size their workgroups differently, one of them by a `#[gpu.spec]` var, and this environment sizes every compute stage of a module by one WorkgroupSize built-in. give the stages one workgroup, put them in separate modules, or target vulkan1.3",
            name, res_first.ok, res_second.ok);
    }
    if (sel r.narrow) {
        ret diagnostic.format(a, "'{}' cannot be compiled for SPIR-V. the stage input or output{} holds {}-bit integers, which no stage's interface carries. declare it at 32 bits", name, named, r.narrow);
    }
    if (sel r.layout) {
        ret diagnostic.format(a, "'{}' cannot be compiled for SPIR-V. the block{} holds a value at byte {} that {} places at byte {}, and a block keeps its declared layout and is never repacked. pad the members so the two agree",
            name, named, r.layout.offset, r.layout.rules, r.layout.placed);
    }
    ret diagnostic.join(a, "'", name, "' breaks a rule of a stage's interface");
}

# the row a spir-v refusal of the source is reported under, NONE for one that is the compiler's:
# logical addressing, the shape of an entry and its interface, what a binding admits, an
# intrinsic call's operands and result and a `#[weak]` definition are the source's to change
fun spirv_kind(q: mirl_spirv.Error) diagnostic_kind.Kind {
    if (sel q.unstructured)  { ret diagnostic_kind.SPIRV_CONTROL_FLOW; }
    if (sel q.entry)         { ret diagnostic_kind.SPIRV_STAGE_SIGNATURE; }
    if (sel q.workgroup)     { ret diagnostic_kind.SPIRV_STAGE_SIGNATURE; }
    if (sel q.imported)      { ret diagnostic_kind.SPIRV_INTERFACE; }
    if (sel q.interface)     { ret diagnostic_kind.SPIRV_INTERFACE; }
    if (sel q.pointee)       { ret diagnostic_kind.SPIRV_INTERFACE; }
    if (sel q.readonly)      { ret diagnostic_kind.SPIRV_READONLY_STORE; }
    if (sel q.writeonly)     { ret diagnostic_kind.SPIRV_WRITEONLY_LOAD; }
    if (sel q.operand_value) { ret diagnostic_kind.OP_OPERAND_VALUE; }
    if (sel q.not_constant)  { ret diagnostic_kind.OP_OPERAND_NOT_CONSTANT; }
    if (sel q.signature)     { ret diagnostic_kind.OP_SIGNATURE; }
    if (sel q.flow)          { ret diagnostic_kind.OP_RESULT_FLOW; }
    if (sel q.recursion)     { ret diagnostic_kind.SPIRV_RECURSION; }
    if (sel q.image)         { ret diagnostic_kind.OP_OPERAND_VALUE; }
    if (sel q.executed)      { ret diagnostic_kind.OP_OPERAND_VALUE; }
    if (sel q.unselected || sel q.untyped || sel q.unpointed || sel q.reinterpreted || sel q.variable || sel q.storage || sel q.slot || sel q.passed || sel q.mixed || sel q.replaceable) {
        ret diagnostic_kind.SPIRV_UNSUPPORTED;
    }
    ret diagnostic_kind.NONE;
}

# the source location of the instruction or global a spir-v refusal names, none for any other
fun spirv_at(m: *Module, q: mirl_spirv.Error) opt[mirl_debug.Location] {
    if (sel q.unselected)    { ret q.unselected.location; }
    if (sel q.unpointed)     { ret q.unpointed.location; }
    if (sel q.reinterpreted) { ret q.reinterpreted.location; }
    if (sel q.variable)      { ret q.variable.location; }
    if (sel q.slot)          { ret q.slot.location; }
    if (sel q.passed)        { ret q.passed.at.location; }
    if (sel q.mixed)         { ret q.mixed.at.location; }
    if (sel q.atomic)        { ret q.atomic.at.location; }
    if (sel q.interface)     { ret site_at(m, q.interface.site); }
    if (sel q.pointee)       { ret q.pointee.at.location; }
    if (sel q.readonly)      { ret site_at(m, q.readonly.site); }
    if (sel q.writeonly)     { ret site_at(m, q.writeonly.site); }
    if (sel q.operand_value) { ret q.operand_value.operand.at.location; }
    if (sel q.not_constant)  { ret q.not_constant.at.location; }
    if (sel q.signature)     { ret q.signature.operand.at.location; }
    if (sel q.flow)          { ret q.flow.location; }
    if (sel q.recursion)     { ret q.recursion.location; }
    if (sel q.image)         { ret q.image.operand.at.location; }
    if (sel q.executed)      { ret q.executed.at.location; }
    if (sel q.unmet)         { ret unmet_at(q.unmet); }
    ret opt[mirl_debug.Location].none{};
}

# the source location of the instruction that first named an unmet need, none for one the module itself needs
fun unmet_at(u: mirl_spirv.Unmet) opt[mirl_debug.Location] {
    if (sel u.at.some) { ret u.at.some.location; }
    ret opt[mirl_debug.Location].none{};
}

# the source location of a refusal's site: its instruction's, or where its global's source
# variable is declared, none where the debug table states none
fun site_at(m: *Module, s: mirl_spirv.Site) opt[mirl_debug.Location] {
    if (sel s.at)                         { ret s.at.location; }
    if (s.global::usize >= m.globals.len) { ret opt[mirl_debug.Location].none{}; }
    val opt_binding: opt[mirl_debug.Binding] = m.globals.data[s.global::usize].data.debug;
    if (sel opt_binding.none) { ret opt[mirl_debug.Location].none{}; }
    val res_variable: res[mirl_debug.Variable, mirl_debug_table.Error] = mirl_debug_place.variable(?m.debug, opt_binding.some);
    if (sel res_variable.err) { ret opt[mirl_debug.Location].none{}; }
    ret opt[mirl_debug.Location].some{res_variable.ok.declared};
}

# what a pointer argument of a function its calls pass two kinds of reaches
fun mixed_reach(whole: bool) str {
    if (whole) { ret "a whole block variable"; }
    ret "a member or an element of a block variable";
}

# how much of a variable a refused pointer argument reaches
fun passed_reach(whole: bool) str {
    if (whole) { ret ""; }
    ret "part of a variable of ";
}

# what of mirl's webassembly back end's refusal of the module `name` is the source's: the constant-time refusals
# read as the register back end's, and what wasm has no form of at the instruction it names
fun wasm_refused(a: *A.Allocator, m: *Module, name: str, q: mirl_wasm.Error) opt[Unplaced] {
    if (sel q.timing)       { ret opt[Unplaced].some{untimed(a, m, name, q.timing, "the walk of its encoded code")}; }
    if (sel q.unfollowed)   { ret opt[Unplaced].some{unfollowed(a, m, name, q.unfollowed)}; }
    if (sel q.stale)        { ret opt[Unplaced].some{stale(a, m, name, q.stale)}; }
    if (sel q.unguaranteed) { ret opt[Unplaced].some{unguaranteed(a, m, name, q.unguaranteed)}; }
    if (sel q.unselected)   { ret opt[Unplaced].some{unplaced(a, m, fail.user_of(diagnostic_kind.TARGET_UNSUPPORTED_OP, diagnostic.join(a, "'", name, "' uses an instruction wasm has no form of")), q.unselected.location)}; }
    if (sel q.threads)      { ret opt[Unplaced].some{unplaced(a, m, fail.user_of(diagnostic_kind.TARGET_UNSUPPORTED_OP, diagnostic.join(a, "'", name, "' has an atomic access or a fence on a build that runs threads")), q.threads.location)}; }
    if (sel q.assembly)     { ret opt[Unplaced].some{unplaced(a, m, wasm_block_refused(a, m, q.assembly), q.assembly.at.location)}; }
    ret opt[Unplaced].none{};
}

# an inline assembly block wasm's block reader refused, in its kind and its words
fun wasm_block_refused(a: *A.Allocator, m: *Module, r: mirl_wasm.Assembly) fail.Fail {
    val res_fname: res[str, fail.Fail] = function_name(a, m, r.at.function);
    if (sel res_fname.err)           { ret res_fname.err; }
    if (r.what == mirl_wasm.TEXT)    { ret fail.user_of(diagnostic_kind.ASM_SYNTAX, diagnostic.join(a, "an asm block of '", res_fname.ok, "' cannot be read (", r.message, ")")); }
    if (r.what == mirl_wasm.HEAD)    { ret fail.user_of(diagnostic_kind.ASM_HEAD, diagnostic.join(a, "the head of an asm block of '", res_fname.ok, "' was not read (", r.message, ")")); }
    if (r.what == mirl_wasm.OPERAND) { ret fail.user_of(diagnostic_kind.ASM_OPERAND, diagnostic.join(a, "an asm block of '", res_fname.ok, "' binds a name to ", r.message)); }
    ret fail.user_of(diagnostic_kind.ASM_UNSUPPORTED, diagnostic.join(a, "an asm block of '", res_fname.ok, "' holds ", r.message));
}

# a function of the module `name` that requires constant time, refused as mirl words it: a
# set that classifies no timing is the target's, and a secret where the code may hold none is
# the source's
fun untimed(a: *A.Allocator, m: *Module, name: str, r: mct.Refused, by: str) Unplaced {
    val res_fname: res[str, fail.Fail] = function_name(a, m, r.function);
    if (sel res_fname.err) { ret bare(res_fname.err); }
    var at: str = "the function as a whole";
    if (sel r.at.instruction) { at = "an instruction of it"; }
    or (sel r.at.offset)      { at = "a byte of its encoded code"; }
    val kind:     diagnostic_kind.Kind = timing_kind(?r.refusal);
    val res_said: res[str, fail.Fail]  = refusal_words(a, ?r.refusal);
    if (sel res_said.err) { ret bare(res_said.err); }
    var refused: fail.Fail = fail.user_of(kind, diagnostic.join(a, "'", res_fname.ok, "' of '", name, "' requires constant time, but ", by, " refused ", at, ". ", res_said.ok));
    if (r.refusal.reason == masc_ct.RESULT) {
        # a secret not declassified reached a public result
        refused = fail.user_of(kind, diagnostic.join(a, "'", res_fname.ok, "' of '", name, "' requires constant time, but ", by, " refused ", at, ". ", res_said.ok,
            ". return the secret type, or declassify it with `:>` where it is meant public"));
    }
    if (r.refusal.reason == masc_ct.STORED) {
        refused = fail.user_of(kind, diagnostic.join(a, "'", res_fname.ok, "' of '", name, "' requires constant time, but ", by, " refused ", at, ". ", res_said.ok,
            ". keep it in storage of a secret type, or declassify it with `:>` where it is meant public"));
    }
    if (sel r.callee.some) {
        val res_callee: res[str, fail.Fail] = function_name(a, m, r.callee.some);
        if (sel res_callee.err) { ret bare(res_callee.err); }
        refused = fail.user_of(kind, diagnostic.join(a, "'", res_fname.ok, "' of '", name, "' requires constant time, but ", by, " refused ", at, ". ", res_said.ok, ". the callee is '", res_callee.ok, "'"));
    }
    if (sel r.shared.some) {
        val opt_said: opt[str]            = fail.text(refused);
        val res_note: res[str, fail.Fail] = shared_note(a, m, res_fname.ok, r.function, r.shared.some);
        if (sel res_note.err) { ret bare(res_note.err); }
        if (sel opt_said.some) {
            val res_joined: res[str, fail.Fail] = diagnostic.join(a, opt_said.some, res_note.ok);
            if (sel res_joined.err) { ret bare(res_joined.err); }
            refused = fail.owning(fail.with_text(refused, res_joined.ok));
        }
    }
    ret unplaced(a, m, refused, r.location);
}

# the words of refusal `r`: its message with what of a condition the context lacked, as the state a target does not
# establish, and where the walk held the value byte by byte the bytes of it that hold the secret, as "bytes 0 to 3 of
# the 8-byte store"
fun refusal_words(a: *A.Allocator, r: *masc_ct.Refusal) res[str, fail.Fail] {
    var message: str = masc_ct.message(r);
    if (r.unmet.len > 0) {
        var words:       vector.Vector[u8]   = vector.init[u8](a);
        val err_spelled: err[A.Error]        = masc_ct.spell(r, ?words);
        val res_ended:   res[usize, A.Error] = vector.push[u8](?words, 0);
        if (!(sel err_spelled.err) && sel res_ended.ok) { message = words.data; }
    }
    if (r.width == 0 || r.bytes == 0) { ret res[str, fail.Fail].ok{message}; }
    var what: str = "value";
    if (r.reason == masc_ct.STORED)                                      { what = "store"; }
    or (r.reason == masc_ct.RESULT)                                      { what = "result piece"; }
    or (r.reason == masc_ct.UNCHECKED || r.reason == masc_ct.UNDECLARED) { what = "argument piece"; }
    var low:  u64 = 64;
    var high: u64 = 0;
    var k:    u64 = 0;
    for (k < r.width::u64 && k < 64) {
        if (((r.bytes >> k) & 1) != 0) {
            if (low == 64) { low = k; }
            high = k;
        }
        k = k + 1;
    }
    if (low == high) { ret diagnostic.format(a, "{} (byte {} of the {}-byte {})", message, low, r.width, what); }
    ret diagnostic.format(a, "{} (bytes {} to {} of the {}-byte {})", message, low, high, r.width, what);
}

# what an author can act on when the walk refused function `f`, named `fname`, which takes a record by value whose
# piece `s` carries secret and public bytes in one register of no general class: the walk holds such a register's
# secrecy whole, so a public member there reads as secret. names the record and its members where the module names them
fun shared_note(a: *A.Allocator, m: *Module, fname: str, f: Function, s: mct.Shared) res[str, fail.Fail] {
    val last:       u64                                        = s.offset + s.length - 1;
    var res_record: res[str, fail.Fail]                        = diagnostic.format(a, "parameter {}", s.parameter + 1);
    var res_inside: res[str, fail.Fail]                        = diagnostic.format(a, "bytes {} to {} of it", s.offset, last);
    val res_sig:    res[mirl_types.Function, mirl_types.Error] = mirl_types.signature(?m.types, m.functions.data[f].data.signature);
    if (sel res_sig.ok) {
        if (s.parameter::usize < res_sig.ok.params.size) {
            val ty:        mirl_types.Type                         = res_sig.ok.params.data[s.parameter];
            val opt_named: opt[mirl_types.Naming]                  = mirl_types.naming(?m.types, ty);
            val res_shape: res[mirl_types.Shape, mirl_types.Error] = mirl_types.shape(?m.types, ty);
            if (sel opt_named.some) {
                val res_title: res[str, StrError] = str_copy_slice(a, opt_named.some.name.data, 0, opt_named.some.name.len);
                if (sel res_title.err) { ret res[str, fail.Fail].err{fail.str_refused(res_title.err)}; }
                res_record = diagnostic.format(a, "parameter {} of record '{}'", s.parameter + 1, res_title.ok);
                if (sel res_shape.ok) {
                    val res_members: res[str, fail.Fail] = shared_members(a, ?m.functions.data[f].data, s, opt_named.some, res_shape.ok);
                    if (sel res_members.err)          { ret res_members; }
                    if (str_len(res_members.ok) != 0) { res_inside = res_members; }
                }
            }
        }
    }
    if (sel res_record.err) { ret res_record; }
    if (sel res_inside.err) { ret res_inside; }
    ret diagnostic.join(a, ". '", fname, "' takes its ", res_record.ok, " by value, and ", res_inside.ok,
        " share one floating-point or vector register, so the check reads the public ones as secret too. pass it through a pointer, or order its members so secret and public ones fall in different pieces");
}

# the members of a record named `named` of shape `shape` lying in piece `s`, each with whether the declaration of `d`
# states it secret, "" where the record states no member offsets
fun shared_members(a: *A.Allocator, d: *mirl_function.FunctionData, s: mct.Shared, named: mirl_types.Naming, shape: mirl_types.Shape) res[str, fail.Fail] {
    if (!(sel shape.structure)) { ret res[str, fail.Fail].ok{""}; }
    val st: mirl_types.Structure = shape.structure;
    if (sel st.offsets.none) { ret res[str, fail.Fail].ok{""}; }
    val offs: Slice[u64]          = st.offsets.some;
    val held: mirl_global.Secrecy = mirl_function.parameter_secrecy(d, s.parameter::usize);
    var out:  str                 = "its members";
    var k:    usize               = 0;
    for (k < offs.size && k < named.members.size) {
        val at: u64 = offs.data[k];
        k = k + 1;
        if (at < s.offset || at >= s.offset + s.length) { cnt; }
        var kind: str = "public";
        if (sel held.ranges) {
            var n: usize = 0;
            for (n < held.ranges.size) {
                val r: mirl_global.Range = held.ranges.data[n];
                if (at >= r.offset && at < r.offset + r.length) { kind = "secret"; }
                n = n + 1;
            }
        }
        val member:    View               = named.members.data[k - 1];
        val res_spelt: res[str, StrError] = str_copy_slice(a, member.data, 0, member.len);
        if (sel res_spelt.err) { ret res[str, fail.Fail].err{fail.str_refused(res_spelt.err)}; }
        var gap: str = ", ";
        if (str_len(out) == 11) { gap = " "; }
        val res_grown: res[str, fail.Fail] = diagnostic.format(a, "{}{}'{}' ({})", out, gap, res_spelt.ok, kind);
        if (sel res_grown.err) { ret res_grown; }
        out = res_grown.ok;
    }
    if (str_len(out) == 11) { ret res[str, fail.Fail].ok{""}; }
    ret res[str, fail.Fail].ok{out};
}

# the row masc's constant-time refusal is reported under: a set that classifies no timing is the
# target's, and anything else the source's
fun timing_kind(r: *masc_ct.Refusal) diagnostic_kind.Kind {
    if (r.reason == masc_ct.UNCLASSIFIED) { ret diagnostic_kind.SECRET_TARGET_UNVERIFIABLE; }
    ret diagnostic_kind.SECRET_UNVERIFIABLE;
}

# a constant-time function of the module `name` whose encoded code mirl could not follow
fun unfollowed(a: *A.Allocator, m: *Module, name: str, u: mct.Unfollowed) Unplaced {
    val res_fname: res[str, fail.Fail] = function_name(a, m, u.function);
    if (sel res_fname.err) { ret bare(res_fname.err); }
    ret unplaced(a, m, fail.user_of(diagnostic_kind.SECRET_UNVERIFIABLE, diagnostic.join(a, "'", res_fname.ok, "' of '", name, "' requires constant time, but mirl could not follow its encoded code (", u.unread.message, ")")), u.location);
}

# a constant-time function of the module `name` whose frame reads a slot no store reaches first
fun stale(a: *A.Allocator, m: *Module, name: str, s: mct.Stale) Unplaced {
    val res_fname: res[str, fail.Fail] = function_name(a, m, s.function);
    if (sel res_fname.err) { ret bare(res_fname.err); }
    ret unplaced(a, m, fail.user_of(diagnostic_kind.SECRET_UNVERIFIABLE, diagnostic.join(a, "'", res_fname.ok, "' of '", name, "' requires constant time, and its frame reads a slot no store of it reaches first, which may hold a secret an earlier frame left")), s.location);
}

# a hard constant-time function of the module `name` whose code holds only under timing modes the
# build does not guarantee, named by the features a target selects to guarantee them
fun unguaranteed(a: *A.Allocator, m: *Module, name: str, u: mct.Unguaranteed) Unplaced {
    val res_fname: res[str, fail.Fail] = function_name(a, m, u.function);
    if (sel res_fname.err) { ret bare(res_fname.err); }
    if (u.needs == mct.NO_NEEDS) {
        ret unplaced(a, m, fail.user_of(diagnostic_kind.SECRET_TARGET_UNGUARANTEED, diagnostic.join(a, "'", res_fname.ok, "' of '", name,
            "' requires hard constant time, and the target's instruction set guarantees no instruction's timing")), u.location);
    }
    var features: vector.Vector[u8] = vector.init[u8](a);
    fin { vector.dnit[u8](?features); }
    val err_spelled: err[A.Error] = mct.missing(u.set, u.needs, ?features);
    if (sel err_spelled.err) { ret bare(fail.refused(err_spelled.err)); }
    val res_nul: res[usize, A.Error] = vector.push[u8](?features, 0);
    if (sel res_nul.err) { ret bare(fail.refused(res_nul.err)); }
    ret unplaced(a, m, fail.user_of(diagnostic_kind.SECRET_TARGET_UNGUARANTEED, diagnostic.join(a, "'", res_fname.ok, "' of '", name,
        "' requires hard constant time, and its code runs in constant time only under ", features.data::str,
        ", which the target does not guarantee. select it in the target's `isa` or `ext`, or mark the function soft")), u.location);
}

# the name a function of `m` is declared by, copied
fun function_name(a: *A.Allocator, m: *Module, f: Function) res[str, fail.Fail] {
    if (f::usize >= m.functions.len) { ret res[str, fail.Fail].err{fail.message("mirl refused a function its module does not hold")}; }
    val v:          View               = mirl_module.name_of(m, m.functions.data[f::usize].data.name);
    val res_copied: res[str, StrError] = str_copy_slice(a, v.data, 0, v.len);
    if (sel res_copied.err) { ret res[str, fail.Fail].err{fail.str_refused(res_copied.err)}; }
    ret res[str, fail.Fail].ok{res_copied.ok};
}

# the name a global of `m` is declared by, copied
fun global_name(a: *A.Allocator, m: *Module, g: id.Global) res[str, fail.Fail] {
    if (g::usize >= m.globals.len) { ret res[str, fail.Fail].err{fail.message("mirl refused a global its module does not hold")}; }
    val v:          View               = mirl_module.name_of(m, m.globals.data[g::usize].data.name);
    val res_copied: res[str, StrError] = str_copy_slice(a, v.data, 0, v.len);
    if (sel res_copied.err) { ret res[str, fail.Fail].err{fail.str_refused(res_copied.err)}; }
    ret res[str, fail.Fail].ok{res_copied.ok};
}

# an asm block of the function `name` that uses an instruction or an operand its selection does not hold, named
# with what masc says selecting admits it and where a build selects that
fun unadmitted(a: *A.Allocator, name: str, u: *mirl_inline.Unadmitted) fail.Fail {
    var needs: vector.Vector[u8] = vector.init[u8](a);
    fin { vector.dnit[u8](?needs); }
    val err_spelled: err[A.Error] = masc_unmet.spell_choices(?u.unmet, ?needs);
    if (sel err_spelled.err) { ret fail.refused(err_spelled.err); }
    val res_nul: res[usize, A.Error] = vector.push[u8](?needs, 0);
    if (sel res_nul.err) { ret fail.refused(res_nul.err); }
    val res_mnemonic: res[str, StrError] = str_copy_slice(a, u.mnemonic.data, 0, u.mnemonic.len);
    if (sel res_mnemonic.err) { ret fail.str_refused(res_mnemonic.err); }
    fin { str_free(a, res_mnemonic.ok); }
    val lacks: str = "`, which the target's extensions do not admit. select ";
    val tail:  str = " in the target's `isa` or `ext`, or in the function's `#[extension]`";
    if (u.spelled.data == u.mnemonic.data) {
        ret fail.user_of(diagnostic_kind.ASM_EXTENSION, diagnostic.join(a, "an asm block of '", name, "' uses `", res_mnemonic.ok, lacks, needs.data::str, tail));
    }
    val res_spelled: res[str, StrError] = str_copy_slice(a, u.spelled.data, 0, u.spelled.len);
    if (sel res_spelled.err) { ret fail.str_refused(res_spelled.err); }
    fin { str_free(a, res_spelled.ok); }
    ret fail.user_of(diagnostic_kind.ASM_EXTENSION, diagnostic.join(a, "an asm block of '", name, "' uses `", res_mnemonic.ok, "` with `", res_spelled.ok, lacks, needs.data::str, tail));
}

# why mirl compiles no asm block of the function `name` as it is written
fun block_refused(a: *A.Allocator, name: str, r: mirl_inline.Error) fail.Fail {
    if (sel r.alloc)      { ret fail.refused(r.alloc); }
    if (sel r.parsed)     { ret fail.user_of(diagnostic_kind.ASM_SYNTAX, diagnostic.join(a, "an asm block of '", name, "' cannot be read (", r.parsed, ")")); }
    if (sel r.unadmitted) { ret unadmitted(a, name, ?r.unadmitted); }
    if (sel r.head)       { ret fail.user_of(diagnostic_kind.ASM_HEAD, diagnostic.join(a, "the head of an asm block of '", name, "' was not read (", mirl_head.fact(r.head), ")")); }
    if (sel r.returns) {
        ret fail.user_of(diagnostic_kind.ASM_UNSUPPORTED, diagnostic.join(a, "an asm block of '", name, "' may return from its function and skip the epilogue that restores the caller's frame. return from a `#[naked]` function's body instead"));
    }
    if (sel r.switched) {
        ret fail.user_of(diagnostic_kind.ASM_UNSUPPORTED, diagnostic.join(a, "an asm block of '", name, "' switches the code width in a function with a compiler-built frame. switch it in a `#[naked]` function's body instead"));
    }
    if (sel r.operands) { ret fail.user_of(diagnostic_kind.ASM_OPERAND, diagnostic.join(a, "an asm block of '", name, "' binds more names than one block may")); }
    if (sel r.class)    { ret fail.user_of(diagnostic_kind.ASM_OPERAND, diagnostic.join(a, "an asm block of '", name, "' binds a name in another register class than its operand takes")); }
    ret fail.user_of(diagnostic_kind.ASM_UNSUPPORTED, diagnostic.join(a, "an asm block of '", name, "' binds an address as an immediate, which mirl carries no relocation for yet"));
}
