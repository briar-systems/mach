    Word{code: opcode_table.REDUCE_AND, word: "bitwise and reduction"},
    Word{code: opcode_table.REDUCE_OR, word: "bitwise or reduction"},
    Word{code: opcode_table.REDUCE_XOR, word: "bitwise exclusive or reduction"},
    Word{code: opcode_table.REDUCE_SMIN, word: "minimum reduction"},
    Word{code: opcode_table.REDUCE_UMIN, word: "minimum reduction"},
    Word{code: opcode_table.REDUCE_FMIN, word: "minimum reduction"},
    Word{code: opcode_table.REDUCE_FMINNUM, word: "minimum reduction"},
    Word{code: opcode_table.REDUCE_SMAX, word: "maximum reduction"},
