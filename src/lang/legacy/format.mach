# std.format in its 1.x shape (see mach.lang.legacy)
use std.types.size.usize;
use std.types.string.str;
use std.types.bool.bool;
use std.types.canonical.res;

use A: std.allocator;
use R: std.types.result;
use stdformat: std.format;
use writer: std.io.writer;

use mach.lang.legacy;

pub fun write_bytes(w: *writer.Writer, buf: *u8, len: usize) R.Result[usize, str] {
    val r: res[usize, writer.WriteError] = stdformat.write_bytes(w, buf, len);
    if (sel r.err) { ret R.err[usize, str](legacy.write_text(r.err)); }
    ret R.ok[usize, str](r.ok);
}

pub fun write_str(w: *writer.Writer, s: str) R.Result[usize, str] {
    val r: res[usize, writer.WriteError] = stdformat.write_str(w, s);
    if (sel r.err) { ret R.err[usize, str](legacy.write_text(r.err)); }
    ret R.ok[usize, str](r.ok);
}

pub fun write_newline(w: *writer.Writer) R.Result[usize, str] {
    val r: res[usize, writer.WriteError] = stdformat.write_newline(w);
    if (sel r.err) { ret R.err[usize, str](legacy.write_text(r.err)); }
    ret R.ok[usize, str](r.ok);
}

pub fun write_u64(w: *writer.Writer, n: u64) R.Result[usize, str] {
    val r: res[usize, writer.WriteError] = stdformat.write_u64(w, n);
    if (sel r.err) { ret R.err[usize, str](legacy.write_text(r.err)); }
    ret R.ok[usize, str](r.ok);
}

pub fun write_i64(w: *writer.Writer, n: i64) R.Result[usize, str] {
    val r: res[usize, writer.WriteError] = stdformat.write_i64(w, n);
    if (sel r.err) { ret R.err[usize, str](legacy.write_text(r.err)); }
    ret R.ok[usize, str](r.ok);
}

pub fun write_hex_u64(w: *writer.Writer, n: u64, upper: bool) R.Result[usize, str] {
    val r: res[usize, writer.WriteError] = stdformat.write_hex_u64(w, n, upper);
    if (sel r.err) { ret R.err[usize, str](legacy.write_text(r.err)); }
    ret R.ok[usize, str](r.ok);
}

pub fun write_f64(w: *writer.Writer, n: f64) R.Result[usize, str] {
    val r: res[usize, writer.WriteError] = stdformat.write_f64(w, n);
    if (sel r.err) { ret R.err[usize, str](legacy.write_text(r.err)); }
    ret R.ok[usize, str](r.ok);
}

pub fun vformat(w: *writer.Writer, fmt: str, va: ...) R.Result[usize, str] {
    val r: res[usize, stdformat.FormatError] = stdformat.vformat(w, fmt, va...);
    if (sel r.err) { ret R.err[usize, str](legacy.format_text(r.err)); }
    ret R.ok[usize, str](r.ok);
}

pub fun format(w: *writer.Writer, fmt: str, va: ...) R.Result[usize, str] {
    val r: res[usize, stdformat.FormatError] = stdformat.format(w, fmt, va...);
    if (sel r.err) { ret R.err[usize, str](legacy.format_text(r.err)); }
    ret R.ok[usize, str](r.ok);
}

pub fun sprint(a: *A.Allocator, fmt: str, va: ...) R.Result[str, str] {
    val r: res[str, stdformat.FormatError] = stdformat.sprint(a, fmt, va...);
    if (sel r.err) { ret R.err[str, str](legacy.format_text(r.err)); }
    ret R.ok[str, str](r.ok);
}
