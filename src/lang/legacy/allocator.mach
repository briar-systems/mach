# std.allocator in its 1.x shape (see mach.lang.legacy)
use std.types.size.usize;
use std.types.string.str;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.canonical.res;
use std.types.canonical.err;

use A: std.allocator;
use R: std.types.result;

use mach.lang.alloc;

fwd A.Allocator;
fwd A.Error;

pub fun allocate[T](a: *A.Allocator, count: usize) R.Result[*T, str] {
    val r: res[*T, A.Error] = A.allocate[T](a, count);
    if (sel r.err) { ret R.err[*T, str](alloc.text(r.err)); }
    ret R.ok[*T, str](r.ok);
}

pub fun zallocate[T](a: *A.Allocator, count: usize) R.Result[*T, str] {
    val r: res[*T, A.Error] = A.zallocate[T](a, count);
    if (sel r.err) { ret R.err[*T, str](alloc.text(r.err)); }
    ret R.ok[*T, str](r.ok);
}

pub fun reallocate[T](a: *A.Allocator, p: *T, old_count: usize, new_count: usize) R.Result[*T, str] {
    val r: res[*T, A.Error] = A.reallocate[T](a, p, old_count, new_count);
    if (sel r.err) { ret R.err[*T, str](alloc.text(r.err)); }
    ret R.ok[*T, str](r.ok);
}

pub fun deallocate[T](a: *A.Allocator, p: *T, count: usize) R.Result[bool, str] {
    val r: err[A.Error] = A.deallocate[T](a, p, count);
    if (sel r.err) { ret R.err[bool, str](alloc.text(r.err)); }
    ret R.ok[bool, str](true);
}
