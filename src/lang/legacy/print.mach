# std.print in its 1.x shape (see mach.lang.legacy)
use std.types.size.usize;
use std.types.string.str;
use std.types.canonical.res;

use R: std.types.result;
use stdprint: std.print;
use stdformat: std.format;
use writer: std.io.writer;

use mach.lang.legacy;

fun written(r: res[usize, writer.WriteError]) R.Result[usize, str] {
    if (sel r.err) { ret R.err[usize, str](legacy.write_text(r.err)); }
    ret R.ok[usize, str](r.ok);
}

fun formatted(r: res[usize, stdformat.FormatError]) R.Result[usize, str] {
    if (sel r.err) { ret R.err[usize, str](legacy.format_text(r.err)); }
    ret R.ok[usize, str](r.ok);
}

pub fun print(s: str) R.Result[usize, str]    { ret written(stdprint.print(s)); }
pub fun println(s: str) R.Result[usize, str]  { ret written(stdprint.println(s)); }
pub fun eprint(s: str) R.Result[usize, str]   { ret written(stdprint.eprint(s)); }
pub fun eprintln(s: str) R.Result[usize, str] { ret written(stdprint.eprintln(s)); }
pub fun u64(n: u64) R.Result[usize, str]      { ret written(stdprint.u64(n)); }
pub fun eu64(n: u64) R.Result[usize, str]     { ret written(stdprint.eu64(n)); }

pub fun printf(fmt: str, va: ...) R.Result[usize, str]    { ret formatted(stdprint.printf(fmt, va...)); }
pub fun eprintf(fmt: str, va: ...) R.Result[usize, str]   { ret formatted(stdprint.eprintf(fmt, va...)); }
pub fun printlnf(fmt: str, va: ...) R.Result[usize, str]  { ret formatted(stdprint.printlnf(fmt, va...)); }
pub fun eprintlnf(fmt: str, va: ...) R.Result[usize, str] { ret formatted(stdprint.eprintlnf(fmt, va...)); }
