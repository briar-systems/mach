# std.text.string in its 1.x shape (see mach.lang.legacy)
use std.types.size.usize;
use std.types.string.str;
use std.types.canonical.res;
use std.types.canonical.err;

use A: std.allocator;
use R: std.types.result;
use text: std.text.string;

use mach.lang.alloc;

pub fun str_dup(a: *A.Allocator, s: str) R.Result[str, str] {
    val r: res[str, A.Error] = text.str_dup(a, s);
    if (sel r.err) { ret R.err[str, str](alloc.text(r.err)); }
    ret R.ok[str, str](r.ok);
}

pub fun str_dup_range(a: *A.Allocator, source: str, offset: usize, len: usize) R.Result[str, str] {
    val r: res[str, A.Error] = text.str_dup_range(a, source, offset, len);
    if (sel r.err) { ret R.err[str, str](alloc.text(r.err)); }
    ret R.ok[str, str](r.ok);
}

# 1.x discarded the release outcome
pub fun str_free(a: *A.Allocator, s: str) {
    text.str_free(a, s);
}
