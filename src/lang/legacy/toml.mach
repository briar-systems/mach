# std.data.toml in its 1.x shape (see mach.lang.legacy): absence and a wrong
# shape read as a nil pointer or nil string, exactly as 1.x answered them
use std.types.size.usize;
use std.types.string.str;
use std.types.canonical.res;
use std.types.canonical.opt;
use std.types.canonical.err;

use A: std.allocator;
use R: std.types.result;
use O: std.types.option;
use toml: std.data.toml;

use mach.lang.legacy;

fwd toml.TYPE_STRING;
fwd toml.TYPE_INTEGER;
fwd toml.TYPE_FLOAT;
fwd toml.TYPE_BOOL;
fwd toml.TYPE_ARRAY;
fwd toml.TYPE_TABLE;
fwd toml.TomlError;
fwd toml.Value;
fwd toml.Array;
fwd toml.Table;
fwd toml.table_len;
fwd toml.array_len;
fwd toml.MAX_VALUE_DEPTH;

pub fun parse(a: *A.Allocator, src: str) R.Result[toml.Table, str] {
    val r: res[toml.Table, toml.TomlError] = toml.parse(a, src);
    if (sel r.err) { ret R.err[toml.Table, str](legacy.toml_text(r.err)); }
    ret R.ok[toml.Table, str](r.ok);
}

pub fun dnit(a: *A.Allocator, t: *toml.Table) { toml.dnit(a, t); }

pub fun get(t: *toml.Table, path: str) *toml.Value {
    val r: opt[*toml.Value] = toml.get(t, path);
    if (sel r.some) { ret r.some; }
    ret nil;
}

pub fun get_str(t: *toml.Table, path: str) str {
    val r: opt[str] = toml.get_str(t, path);
    if (sel r.some) { ret r.some; }
    ret nil;
}

pub fun get_int(t: *toml.Table, path: str) O.Option[i64] {
    val r: opt[i64] = toml.get_int(t, path);
    if (sel r.some) { ret O.some[i64](r.some); }
    ret O.none[i64]();
}

pub fun get_table(t: *toml.Table, path: str) *toml.Table {
    val r: opt[*toml.Table] = toml.get_table(t, path);
    if (sel r.some) { ret r.some; }
    ret nil;
}

pub fun get_array(t: *toml.Table, path: str) *toml.Array {
    val r: opt[*toml.Array] = toml.get_array(t, path);
    if (sel r.some) { ret r.some; }
    ret nil;
}

pub fun array_get(arr: *toml.Array, index: usize) *toml.Value {
    val r: opt[*toml.Value] = toml.array_get(arr, index);
    if (sel r.some) { ret r.some; }
    ret nil;
}

pub fun table_key(t: *toml.Table, index: usize) str {
    val r: opt[str] = toml.table_key(t, index);
    if (sel r.some) { ret r.some; }
    ret nil;
}

pub fun table_value(t: *toml.Table, index: usize) *toml.Value {
    val r: opt[*toml.Value] = toml.table_value(t, index);
    if (sel r.some) { ret r.some; }
    ret nil;
}
