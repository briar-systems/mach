# std.collections.map in its 1.x shape (see mach.lang.legacy)
use std.types.size.usize;
use std.types.string.str;
use std.types.bool.bool;
use std.types.canonical.res;
use std.types.canonical.opt;
use std.types.canonical.err;

use A: std.allocator;
use R: std.types.result;
use map: std.collections.map;

use mach.lang.alloc;

fwd map.Map;
fwd map.init;
fwd map.is_empty;
fwd map.length;
fwd map.capacity;
fwd map.clear;
fwd map.contains;
fwd map.hash_str;
fwd map.eq_str;
fwd map.hash_i64;
fwd map.eq_i64;
fwd map.hash_u64;
fwd map.eq_u64;
fwd map.hash_u32;
fwd map.eq_u32;

pub fun dnit[K, V](m: *map.Map[K, V]) bool {
    val r: err[A.Error] = map.dnit[K, V](m);
    ret sel r.ok;
}

pub fun insert[K, V](m: *map.Map[K, V], key: K, value: V) R.Result[bool, str] {
    val r: res[bool, A.Error] = map.insert[K, V](m, key, value);
    if (sel r.err) { ret R.err[bool, str](alloc.text(r.err)); }
    ret R.ok[bool, str](r.ok);
}

pub fun get[K, V](m: *map.Map[K, V], key: *K) R.Result[*V, str] {
    val r: opt[*V] = map.get[K, V](m, key);
    if (sel r.some) { ret R.ok[*V, str](r.some); }
    ret R.err[*V, str]("key not found");
}

pub fun remove[K, V](m: *map.Map[K, V], key: *K) R.Result[bool, str] {
    ret R.ok[bool, str](map.remove[K, V](m, key));
}
