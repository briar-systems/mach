# std.types.string in its 1.x shape (see mach.lang.legacy)
use std.types.size.usize;
use std.types.canonical.res;
use std.types.canonical.opt;

use A: std.allocator;
use R: std.types.result;
use O: std.types.option;
use string: std.types.string;

use mach.lang.legacy;

fwd string.str;
fwd string.str_len;
fwd string.str_empty;
fwd string.str_equals;
fwd string.str_region_equals;
fwd string.str_compare;
fwd string.str_starts_with;
fwd string.str_ends_with;
fwd string.str_contains;
fwd string.str_contains_char;

pub fun str_index_of(s: string.str, sub: string.str) O.Option[usize] {
    val r: opt[usize] = string.str_index_of(s, sub);
    if (sel r.some) { ret O.some[usize](r.some); }
    ret O.none[usize]();
}

pub fun str_copy(a: *A.Allocator, s: string.str) R.Result[string.str, string.str] {
    val r: res[string.str, string.StrError] = string.str_copy(a, s);
    if (sel r.err) { ret R.err[string.str, string.str](legacy.str_text(r.err)); }
    ret R.ok[string.str, string.str](r.ok);
}

pub fun str_copy_slice(a: *A.Allocator, s: string.str, start: usize, len: usize) R.Result[string.str, string.str] {
    val r: res[string.str, string.StrError] = string.str_copy_slice(a, s, start, len);
    if (sel r.err) { ret R.err[string.str, string.str](legacy.str_text(r.err)); }
    ret R.ok[string.str, string.str](r.ok);
}

pub fun str_join(a: *A.Allocator, va: ...) R.Result[string.str, string.str] {
    val r: res[string.str, string.StrError] = string.str_join(a, va...);
    if (sel r.err) { ret R.err[string.str, string.str](legacy.str_text(r.err)); }
    ret R.ok[string.str, string.str](r.ok);
}

pub fun str_replace(a: *A.Allocator, s: string.str, old: string.str, new: string.str) R.Result[string.str, string.str] {
    val r: res[string.str, string.StrError] = string.str_replace(a, s, old, new);
    if (sel r.err) { ret R.err[string.str, string.str](legacy.str_text(r.err)); }
    ret R.ok[string.str, string.str](r.ok);
}
