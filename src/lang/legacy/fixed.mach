# std.allocator.fixed in its 1.x shape (see mach.lang.legacy)
use std.types.size.usize;
use std.types.string.str;
use std.types.canonical.err;

use A: std.allocator;
use O: std.types.option;
use fixed: std.allocator.fixed;

use mach.lang.alloc;

fwd fixed.FixedState;
fwd fixed.reset;
fwd fixed.remaining;

pub fun make(a: *A.Allocator, state: *fixed.FixedState, buf: *u8, cap: usize) O.Option[str] {
    val r: err[A.Error] = fixed.make(a, state, buf, cap);
    if (sel r.err) { ret O.some[str](alloc.text(r.err)); }
    ret O.none[str]();
}
