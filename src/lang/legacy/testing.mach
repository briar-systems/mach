# std.allocator.testing in its 1.x shape (see mach.lang.legacy)
use std.types.string.str;
use std.types.canonical.err;

use A: std.allocator;
use O: std.types.option;
use testing: std.allocator.testing;

use mach.lang.alloc;

fwd testing.Testing;
fwd testing.POISON_NEW;
fwd testing.POISON_FREE;
fwd testing.MAX_TRACKED;
fwd testing.allocator_of;
fwd testing.fail_at_ordinal;
fwd testing.clear_failure;
fwd testing.live_count;
fwd testing.total_count;
fwd testing.attempt_count;
fwd testing.leaked;
fwd testing.double_free_count;
fwd testing.tracking_exhausted;
fwd testing.dnit;

pub fun make(t: *testing.Testing) O.Option[str] {
    val r: err[A.Error] = testing.make(t);
    if (sel r.err) { ret O.some[str](alloc.text(r.err)); }
    ret O.none[str]();
}
