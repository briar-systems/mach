# std.chrono.time in its 1.x shape (see mach.lang.legacy): a clock the
# platform refuses reads as the zero time, as 1.x's unchecked read did
use std.types.canonical.res;

use time: std.chrono.time;
use io_error: std.io.error;

fwd time.Time;
fwd time.Clock;
fwd time.unix;
fwd time.since;
fwd time.until;
fwd time.time_unix_sec;
fwd time.time_unix_nsec;
fwd time.time_unix_usec;
fwd time.time_unix_msec;
fwd time.time_add;
fwd time.time_sub;
fwd time.time_before;
fwd time.time_after;
fwd time.time_equal;
fwd time.time_is_zero;

fun read(c: time.Clock) time.Time {
    if (sel c.ok) { ret c.ok; }
    ret time.Time{sec: 0, nsec: 0};
}

pub fun now() time.Time       { ret read(time.now()); }
pub fun monotonic() time.Time { ret read(time.monotonic()); }
