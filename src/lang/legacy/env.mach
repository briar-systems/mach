# std.process.env in its 1.x shape (see mach.lang.legacy). 1.x owned values
# had the extent of their length plus the terminator and were released with
# str_free; an OwnedString may hold more, so the value is copied to that
# extent and the owned buffer released
use std.types.size.usize;
use std.types.string.str;
use std.types.canonical.res;
use std.types.canonical.opt;

use A: std.allocator;
use R: std.types.result;
use env: std.process.env;
use string: std.types.string;
use text: std.text.string;
use os: std.system.os;

use mach.lang.alloc;
use mach.lang.legacy;

fwd env.EnvError;
fwd env.environ;

pub fun compare_names(left: str, right: str) R.Result[i32, str] {
    val r: res[i32, env.EnvError] = env.compare_names(left, right);
    if (sel r.err) { ret R.err[i32, str](legacy.env_text(r.err)); }
    ret R.ok[i32, str](r.ok);
}

# 1.x: the full length, NOT_FOUND (-1) when unset, negative on failure
pub fun get(name: str, buf: *u8, cap: usize) i64 {
    val r: res[opt[usize], env.EnvError] = env.get(name, buf, cap);
    if (sel r.err) {
        if (sel r.err.native) { ret r.err.native; }
        ret -1;
    }
    if (sel r.ok.some) { ret r.ok.some::i64; }
    ret os.NOT_FOUND;
}

fun tight_copy(a: *A.Allocator, owned: string.OwnedString) R.Result[str, str] {
    var o: string.OwnedString = owned;
    val copied: res[str, A.Error] = text.str_dup(a, o.data);
    string.owned_release(?o);
    if (sel copied.err) { ret R.err[str, str](alloc.text(copied.err)); }
    ret R.ok[str, str](copied.ok);
}

pub fun value(a: *A.Allocator, name: str) R.Result[str, str] {
    val r: res[opt[string.OwnedString], env.EnvError] = env.value(a, name);
    if (sel r.err) { ret R.err[str, str](legacy.env_text(r.err)); }
    if (sel r.ok.none) { ret R.err[str, str]("environment variable not set"); }
    ret tight_copy(a, r.ok.some);
}

pub fun current_dir(a: *A.Allocator) R.Result[str, str] {
    val r: res[string.OwnedString, env.EnvError] = env.current_dir(a);
    if (sel r.err) { ret R.err[str, str](legacy.env_text(r.err)); }
    ret tight_copy(a, r.ok);
}
