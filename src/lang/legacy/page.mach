# std.allocator.page in its 1.x shape (see mach.lang.legacy)
use std.types.string.str;
use std.types.canonical.err;

use A: std.allocator;
use O: std.types.option;
use page: std.allocator.page;

use mach.lang.alloc;

pub fun make(a: *A.Allocator) O.Option[str] {
    val r: err[A.Error] = page.make(a);
    if (sel r.err) { ret O.some[str](alloc.text(r.err)); }
    ret O.none[str]();
}
