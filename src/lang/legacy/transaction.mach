fun unit(r: err[txn.Error]) O.Option[txn.Error] {
    if (sel r.err) { ret O.some[txn.Error](r.err); }
    ret O.none[txn.Error]();
}

pub fun root_open(out: *txn.Root, base: Path, rel: Path) O.Option[txn.Error] {
    ret unit(txn.root_open(out, base, rel));
}

pub fun root_open_child(out: *txn.Root, parent: *txn.Root, leaf: str) O.Option[txn.Error] {
    ret unit(txn.root_open_child(out, parent, leaf));
}

pub fun root_dnit(r: *txn.Root) O.Option[txn.Error] { ret unit(txn.root_dnit(r)); }

pub fun root_identity(r: *txn.Root) R.Result[txn.Identity, txn.Error] {
    val got: res[txn.Identity, txn.Error] = txn.root_identity(r);
    if (sel got.err) { ret R.err[txn.Identity, txn.Error](got.err); }
    ret R.ok[txn.Identity, txn.Error](got.ok);
}

pub fun entry_probe(r: *txn.Root, leaf: str) R.Result[txn.EntryProbe, txn.Error] {
    val got: res[txn.EntryProbe, txn.Error] = txn.entry_probe(r, leaf);
    if (sel got.err) { ret R.err[txn.EntryProbe, txn.Error](got.err); }
    ret R.ok[txn.EntryProbe, txn.Error](got.ok);
}

pub fun entry_identity(r: *txn.Root, leaf: str) R.Result[O.Option[txn.Identity], txn.Error] {
    val got: res[opt[txn.Identity], txn.Error] = txn.entry_identity(r, leaf);
    if (sel got.err) { ret R.err[O.Option[txn.Identity], txn.Error](got.err); }
    if (sel got.ok.some) { ret R.ok[O.Option[txn.Identity], txn.Error](O.some[txn.Identity](got.ok.some)); }
    ret R.ok[O.Option[txn.Identity], txn.Error](O.none[txn.Identity]());
}

pub fun entry_rename(from: *txn.Claim, to: *txn.Claim) O.Option[txn.Error] { ret unit(txn.entry_rename(from, to)); }
pub fun entry_unlink(destination: *txn.Claim) O.Option[txn.Error]          { ret unit(txn.entry_unlink(destination)); }
pub fun entry_rmdir_if_empty(destination: *txn.Claim) O.Option[txn.Error]  { ret unit(txn.entry_rmdir_if_empty(destination)); }

pub fun root_remove_tree(destination: *txn.Claim, rel: Path) R.Result[usize, txn.Error] {
    val got: res[usize, txn.Error] = txn.root_remove_tree(destination, rel);
    if (sel got.err) { ret R.err[usize, txn.Error](got.err); }
    ret R.ok[usize, txn.Error](got.ok);
}

pub fun entry_make_dir(destination: *txn.Claim, mode: i32) R.Result[bool, txn.Error] {
    val got: res[bool, txn.Error] = txn.entry_make_dir(destination, mode);
    if (sel got.err) { ret R.err[bool, txn.Error](got.err); }
    ret R.ok[bool, txn.Error](got.ok);
}

pub fun entry_read_all(r: *txn.Root, leaf: str, out: *u8, out_cap: usize) R.Result[O.Option[usize], txn.Error] {
    val got: res[opt[usize], txn.Error] = txn.entry_read_all(r, leaf, out, out_cap);
    if (sel got.err) { ret R.err[O.Option[usize], txn.Error](got.err); }
    if (sel got.ok.some) { ret R.ok[O.Option[usize], txn.Error](O.some[usize](got.ok.some)); }
    ret R.ok[O.Option[usize], txn.Error](O.none[usize]());
}

pub fun lock(out: *txn.Lock, r: *txn.Root) O.Option[txn.Error] { ret unit(txn.lock(out, r)); }
pub fun unlock(held: *txn.Lock) O.Option[txn.Error]           { ret unit(txn.unlock(held)); }

pub fun claim(out: *txn.Claim, alloc: *A.Allocator, held: *txn.Lock, leaf: str) O.Option[txn.Error] {
    ret unit(txn.claim(out, alloc, held, leaf));
}

pub fun release_claim(destination: *txn.Claim) O.Option[txn.Error] { ret unit(txn.release_claim(destination)); }

pub fun transaction_staged_identity(t: *txn.Transaction) R.Result[txn.Identity, txn.Error] {
    val got: res[txn.Identity, txn.Error] = txn.transaction_staged_identity(t);
    if (sel got.err) { ret R.err[txn.Identity, txn.Error](got.err); }
    ret R.ok[txn.Identity, txn.Error](got.ok);
}

pub fun transaction_staged_child_identity(t: *txn.Transaction, leaf: str) R.Result[txn.Identity, txn.Error] {
    val got: res[txn.Identity, txn.Error] = txn.transaction_staged_child_identity(t, leaf);
    if (sel got.err) { ret R.err[txn.Identity, txn.Error](got.err); }
    ret R.ok[txn.Identity, txn.Error](got.ok);
}

# a 1.x producer reports its refusal as a message the transaction never read:
# any refusal is REJECTED, so the adapter reports the sink as having accepted
# nothing. the consumer lane gives the producer the writer's own outcome
pub rec Producer[W] {
    ctx: *W;
    cb:  fun(*W, *writer.Writer) R.Result[R.Void, str];
}

fun produce[W](p: *Producer[W], w: *writer.Writer) err[writer.WriteError] {
    val r: R.Result[R.Void, str] = p.cb(p.ctx, w);
    if (R.is_err[R.Void, str](r)) { ret err[writer.WriteError].err{writer.WriteError.stalled{0}}; }
    ret err[writer.WriteError].ok{};
}

pub fun prepare[W](out: *txn.Transaction, alloc: *A.Allocator, destination: *txn.Claim,
                   write_ctx: *W, write_cb: fun(*W, *writer.Writer) R.Result[R.Void, str],
                   mode: i32, want_digest: bool, options: txn.PrepareOptions) O.Option[txn.Error] {
    if (write_ctx == nil || write_cb == nil) { ret O.some[txn.Error](txn.error(txn.INVALID, txn.OP_PREPARE)); }
    var producer: Producer[W];
    producer.ctx = write_ctx;
    producer.cb  = write_cb;
    val adapted: fun(*Producer[W], *writer.Writer) err[writer.WriteError] = produce[W];
    ret unit(txn.prepare[Producer[W]](out, alloc, destination, ?producer, adapted, mode, want_digest, options));
}

pub fun prepare_bytes(out: *txn.Transaction, alloc: *A.Allocator, destination: *txn.Claim, data: *u8, len: usize,
                      mode: i32, want_digest: bool, options: txn.PrepareOptions) O.Option[txn.Error] {
    ret unit(txn.prepare_bytes(out, alloc, destination, data, len, mode, want_digest, options));
}

pub fun prepare_subtree(out: *txn.Transaction, alloc: *A.Allocator, destination: *txn.Claim, inv: *txn.Inventory,
                        mode: i32, options: txn.PrepareOptions) O.Option[txn.Error] {
    ret unit(txn.prepare_subtree(out, alloc, destination, inv, mode, options));
}

pub fun commit(t: *txn.Transaction) R.Result[txn.Outcome, txn.Error] {
    val got: res[txn.Outcome, txn.Error] = txn.commit(t);
    if (sel got.err) { ret R.err[txn.Outcome, txn.Error](got.err); }
    ret R.ok[txn.Outcome, txn.Error](got.ok);
}

pub fun abort(t: *txn.Transaction) O.Option[txn.Error] { ret unit(txn.abort(t)); }

# the 1.x report carried its two outcomes as options
pub rec BackupOutcome {
    consumed:        bool;
    prior_moved:     bool;
    published:       bool;
    achieved:        txn.Durability;
    shortfall:       bool;
    failure:         O.Option[txn.Error];
    cleanup_failure: O.Option[txn.Error];
    staging_residue: str;
}

pub fun commit_with_backup(t: *txn.Transaction, backup: *txn.Claim) BackupOutcome {
    val got: txn.BackupOutcome = txn.commit_with_backup(t, backup);
    var out: BackupOutcome;
    out.consumed        = got.consumed;
    out.prior_moved     = got.prior_moved;
    out.published       = got.published;
    out.achieved        = got.achieved;
    out.shortfall       = got.shortfall;
    out.failure         = unit(got.failure);
    out.cleanup_failure = unit(got.cleanup_failure);
    out.staging_residue = got.staging_residue;
    ret out;
}

pub fun inventory_dnit(inv: *txn.Inventory) { txn.inventory_dnit(inv); }

pub fun inventory_push(inv: *txn.Inventory, e: txn.Entry) O.Option[txn.Error] { ret unit(txn.inventory_push(inv, e)); }

pub fun recover(alloc: *A.Allocator, held: *txn.Lock, leaf: str) R.Result[usize, txn.Error] {
    val got: res[usize, txn.Error] = txn.recover(alloc, held, leaf);
    if (sel got.err) { ret R.err[usize, txn.Error](got.err); }
    ret R.ok[usize, txn.Error](got.ok);
}

pub fun descend(out: *txn.Descent, alloc: *A.Allocator, base: Path, rel: Path) R.Result[bool, txn.Error] {
    val got: res[bool, txn.Error] = txn.descend(out, alloc, base, rel);
    if (sel got.err) { ret R.err[bool, txn.Error](got.err); }
    ret R.ok[bool, txn.Error](got.ok);
}

pub fun descent_dnit(alloc: *A.Allocator, d: *txn.Descent) O.Option[txn.Error] { ret unit(txn.descent_dnit(alloc, d)); }
