# std.types.path in its 1.x shape (see mach.lang.legacy)
use std.types.string.str;
use std.types.canonical.res;

use A: std.allocator;
use R: std.types.result;
use path: std.types.path;

use mach.lang.alloc;

fwd path.Path;
fwd path.separator;
fwd path.is_separator;
fwd path.root;
fwd path.has_separator;
fwd path.is_empty;
fwd path.is_abs;
fwd path.is_root;
fwd path.seg_count;
fwd path.filename;
fwd path.extension;

pub fun stem(a: *A.Allocator, p: path.Path) R.Result[path.Path, str] {
    val r: res[path.Path, A.Error] = path.stem(a, p);
    if (sel r.err) { ret R.err[path.Path, str](alloc.text(r.err)); }
    ret R.ok[path.Path, str](r.ok);
}

pub fun clone(a: *A.Allocator, p: path.Path) R.Result[path.Path, str] {
    val r: res[path.Path, A.Error] = path.clone(a, p);
    if (sel r.err) { ret R.err[path.Path, str](alloc.text(r.err)); }
    ret R.ok[path.Path, str](r.ok);
}

pub fun join(a: *A.Allocator, left: path.Path, right: path.Path) R.Result[path.Path, str] {
    val r: res[path.Path, A.Error] = path.join(a, left, right);
    if (sel r.err) { ret R.err[path.Path, str](alloc.text(r.err)); }
    ret R.ok[path.Path, str](r.ok);
}

pub fun parent(a: *A.Allocator, p: path.Path) R.Result[path.Path, str] {
    val r: res[path.Path, A.Error] = path.parent(a, p);
    if (sel r.err) { ret R.err[path.Path, str](alloc.text(r.err)); }
    ret R.ok[path.Path, str](r.ok);
}

pub fun resolve(a: *A.Allocator, base: path.Path, p: path.Path) R.Result[path.Path, str] {
    val r: res[path.Path, A.Error] = path.resolve(a, base, p);
    if (sel r.err) { ret R.err[path.Path, str](alloc.text(r.err)); }
    ret R.ok[path.Path, str](r.ok);
}

pub fun clean(a: *A.Allocator, p: path.Path) R.Result[path.Path, str] {
    val r: res[path.Path, A.Error] = path.clean(a, p);
    if (sel r.err) { ret R.err[path.Path, str](alloc.text(r.err)); }
    ret R.ok[path.Path, str](r.ok);
}
