# std.text.parse in its 1.x shape (see mach.lang.legacy)
use std.types.string.str;
use std.types.canonical.res;

use R: std.types.result;
use parse: std.text.parse;

use mach.lang.legacy;

fwd parse.ParseError;

pub fun parse_u64_exact(s: str, base: u8) R.Result[u64, str] {
    val r: res[u64, parse.ParseError] = parse.parse_u64_exact(s, base);
    if (sel r.err) { ret R.err[u64, str](legacy.parse_text(r.err)); }
    ret R.ok[u64, str](r.ok);
}

pub fun parse_i64_exact(s: str, base: u8) R.Result[i64, str] {
    val r: res[i64, parse.ParseError] = parse.parse_i64_exact(s, base);
    if (sel r.err) { ret R.err[i64, str](legacy.parse_text(r.err)); }
    ret R.ok[i64, str](r.ok);
}
