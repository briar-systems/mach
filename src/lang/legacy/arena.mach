# std.allocator.arena in its 1.x shape (see mach.lang.legacy)
use std.types.size.usize;
use std.types.string.str;
use std.types.canonical.err;

use A: std.allocator;
use O: std.types.option;
use arena: std.allocator.arena;

use mach.lang.alloc;

fwd arena.Arena;
fwd arena.Chunk;
fwd arena.reset;

pub fun init(ar: *arena.Arena, backing: *A.Allocator, cap: usize) O.Option[str] {
    val r: err[A.Error] = arena.init(ar, backing, cap);
    if (sel r.err) { ret O.some[str](alloc.text(r.err)); }
    ret O.none[str]();
}

pub fun make(a: *A.Allocator, ar: *arena.Arena) O.Option[str] {
    val r: err[A.Error] = arena.make(a, ar);
    if (sel r.err) { ret O.some[str](alloc.text(r.err)); }
    ret O.none[str]();
}

# 1.x reported the release status as an integer, zero on success
pub fun dnit(ar: *arena.Arena) i64 {
    val r: err[A.Error] = arena.dnit(ar);
    if (sel r.err) {
        if (sel r.err.release) { ret r.err.release; }
        ret -1;
    }
    ret 0;
}
