# std.io.writer in its 1.x shape (see mach.lang.legacy)
use std.types.size.usize;
use std.types.string.str;
use std.types.canonical.res;
use std.types.canonical.err;

use R: std.types.result;
use O: std.types.option;
use writer: std.io.writer;

use mach.lang.legacy;

fwd writer.Writer;
fwd writer.WriteError;
fwd writer.WriteFailure;
fwd writer.native_failure;
fwd writer.persisted;

# the 1.x message for a sink that persisted less than it was given
pub val ERR_SHORT_WRITE: str = "short write";

pub fun write(w: *writer.Writer, buf: *u8, len: usize) R.Result[usize, str] {
    val r: res[usize, writer.WriteError] = writer.write(w, buf, len);
    if (sel r.err) { ret R.err[usize, str](legacy.write_text(r.err)); }
    ret R.ok[usize, str](r.ok);
}

pub fun write_all(w: *writer.Writer, buf: *u8, len: usize) O.Option[str] {
    val r: err[writer.WriteError] = writer.write_all(w, buf, len);
    if (sel r.err) { ret O.some[str](legacy.write_text(r.err)); }
    ret O.none[str]();
}
