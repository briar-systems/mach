# std.process.exec in its 1.x shape (see mach.lang.legacy). the status is
# std 2.0's ProcessStatus (there is no raw word to forward); `code` keeps its
# 1.x i32 spelling, the consumer lane reads the full u32
use std.types.size.usize;
use std.types.string.str;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.canonical.res;
use std.types.canonical.opt;
use std.types.canonical.err;

use A: std.allocator;
use R: std.types.result;
use O: std.types.option;
use exec: std.process.exec;

use mach.lang.legacy;

fwd exec.ExitStatus;
fwd exec.PROCESS_EXITED;
fwd exec.PROCESS_SIGNALED;
fwd exec.PROCESS_STOPPED;
fwd exec.PROCESS_CONTINUED;
fwd exec.Child;
fwd exec.Failure;
fwd exec.OutputFailure;
fwd exec.Error;
fwd exec.retained;
fwd exec.error_message;
fwd exec.Output;
fwd exec.exited;
fwd exec.signaled;
fwd exec.signal;
fwd exec.exit;

pub fun code(status: exec.ExitStatus) i32 { ret exec.code(status)::i32; }

fun status(r: res[exec.ExitStatus, exec.Error]) R.Result[exec.ExitStatus, str] {
    if (sel r.err) { ret R.err[exec.ExitStatus, str](legacy.exec_text(r.err)); }
    ret R.ok[exec.ExitStatus, str](r.ok);
}

fun child(r: res[exec.Child, exec.Error]) R.Result[exec.Child, str] {
    if (sel r.err) { ret R.err[exec.Child, str](legacy.exec_text(r.err)); }
    ret R.ok[exec.Child, str](r.ok);
}

fun unit(r: err[exec.Error]) R.Result[bool, str] {
    if (sel r.err) { ret R.err[bool, str](legacy.exec_text(r.err)); }
    ret R.ok[bool, str](true);
}

pub fun run(pathname: str, argv: **u8, envp: **u8) R.Result[exec.ExitStatus, str] {
    ret status(exec.run(pathname, argv, envp));
}

pub fun output(a: *A.Allocator, pathname: str, argv: **u8, envp: **u8) R.Result[exec.Output, str] {
    val r: res[exec.Output, exec.Error] = exec.output(a, pathname, argv, envp);
    if (sel r.err) { ret R.err[exec.Output, str](legacy.exec_text(r.err)); }
    ret R.ok[exec.Output, str](r.ok);
}

pub fun spawn(pathname: str, argv: **u8, envp: **u8) R.Result[exec.Child, str] {
    ret child(exec.spawn(pathname, argv, envp));
}

pub fun spawn_grouped(pathname: str, argv: **u8, envp: **u8) R.Result[exec.Child, str] {
    ret child(exec.spawn_grouped(pathname, argv, envp));
}

pub fun spawn_redirected_grouped(pathname: str, argv: **u8, envp: **u8, stdout_fd: i32, stderr_fd: i32) R.Result[exec.Child, str] {
    ret child(exec.spawn_redirected_grouped(pathname, argv, envp, stdout_fd, stderr_fd));
}

pub fun spawn_in(pathname: str, argv: **u8, envp: **u8, cwd: str) R.Result[exec.Child, str] {
    ret child(exec.spawn_in(pathname, argv, envp, cwd));
}

pub fun spawn_redirected_in(pathname: str, argv: **u8, envp: **u8, cwd: str, stdin_fd: i32, stdout_fd: i32, stderr_fd: i32) R.Result[exec.Child, str] {
    ret child(exec.spawn_redirected_in(pathname, argv, envp, cwd, stdin_fd, stdout_fd, stderr_fd));
}

pub fun spawn_redirected_in_grouped(pathname: str, argv: **u8, envp: **u8, cwd: str, stdin_fd: i32, stdout_fd: i32, stderr_fd: i32) R.Result[exec.Child, str] {
    ret child(exec.spawn_redirected_in_grouped(pathname, argv, envp, cwd, stdin_fd, stdout_fd, stderr_fd));
}

pub fun terminate_child(c: exec.Child) R.Result[bool, str] { ret unit(exec.terminate_child(c)); }
pub fun terminate_group(c: exec.Child) R.Result[bool, str] { ret unit(exec.terminate_group(c)); }

pub fun wait(c: exec.Child) R.Result[exec.ExitStatus, str] { ret status(exec.wait(c)); }

pub fun try_wait(c: exec.Child) R.Result[O.Option[exec.ExitStatus], str] {
    val r: res[opt[exec.ExitStatus], exec.Error] = exec.try_wait(c);
    if (sel r.err) { ret R.err[O.Option[exec.ExitStatus], str](legacy.exec_text(r.err)); }
    if (sel r.ok.some) { ret R.ok[O.Option[exec.ExitStatus], str](O.some[exec.ExitStatus](r.ok.some)); }
    ret R.ok[O.Option[exec.ExitStatus], str](O.none[exec.ExitStatus]());
}

pub fun resolve(a: *A.Allocator, name: str) R.Result[str, str] {
    val r: res[str, exec.Error] = exec.resolve(a, name);
    if (sel r.err) { ret R.err[str, str](legacy.exec_text(r.err)); }
    ret R.ok[str, str](r.ok);
}
