# std.encoding.binary in its 1.x shape (see mach.lang.legacy)
use std.types.size.usize;
use std.types.string.str;
use std.types.bool.bool;
use std.types.canonical.res;
use std.types.canonical.err;

use A: std.allocator;
use R: std.types.result;
use binary: std.encoding.binary;

use mach.lang.legacy;

fwd binary.Order;
fwd binary.LITTLE;
fwd binary.BIG;
fwd binary.Checkpoint;
fwd binary.EncodeError;
fwd binary.DecodeError;
fwd binary.put_uint;
fwd binary.get_uint;
fwd binary.Encoder;
fwd binary.encoder;
fwd binary.Decoder;
fwd binary.Cursor;
fwd binary.decoder;
fwd binary.cursor;
fwd binary.remaining;

pub fun encoder_dnit(e: *binary.Encoder) bool {
    val r: err[A.Error] = binary.encoder_dnit(e);
    ret sel r.ok;
}

fun encoded(r: res[usize, binary.EncodeError]) R.Result[usize, str] {
    if (sel r.err) { ret R.err[usize, str](legacy.encode_text(r.err)); }
    ret R.ok[usize, str](r.ok);
}

pub fun write_u8(e: *binary.Encoder, v: u8) R.Result[usize, str]                 { ret encoded(binary.write_u8(e, v)); }
pub fun write_u16(e: *binary.Encoder, v: u16) R.Result[usize, str]               { ret encoded(binary.write_u16(e, v)); }
pub fun write_u32(e: *binary.Encoder, v: u32) R.Result[usize, str]               { ret encoded(binary.write_u32(e, v)); }
pub fun write_u64(e: *binary.Encoder, v: u64) R.Result[usize, str]               { ret encoded(binary.write_u64(e, v)); }
pub fun write_bytes(e: *binary.Encoder, p: *u8, len: usize) R.Result[usize, str] { ret encoded(binary.write_bytes(e, p, len)); }
pub fun write_str(e: *binary.Encoder, s: str) R.Result[usize, str]               { ret encoded(binary.write_str(e, s)); }

pub fun read_u8(d: *binary.Decoder) R.Result[u8, str] {
    val r: res[u8, binary.DecodeError] = binary.read_u8(d);
    if (sel r.err) { ret R.err[u8, str](legacy.decode_text(r.err)); }
    ret R.ok[u8, str](r.ok);
}

pub fun read_u16(d: *binary.Decoder) R.Result[u16, str] {
    val r: res[u16, binary.DecodeError] = binary.read_u16(d);
    if (sel r.err) { ret R.err[u16, str](legacy.decode_text(r.err)); }
    ret R.ok[u16, str](r.ok);
}

pub fun read_u32(d: *binary.Decoder) R.Result[u32, str] {
    val r: res[u32, binary.DecodeError] = binary.read_u32(d);
    if (sel r.err) { ret R.err[u32, str](legacy.decode_text(r.err)); }
    ret R.ok[u32, str](r.ok);
}

pub fun read_u64(d: *binary.Decoder) R.Result[u64, str] {
    val r: res[u64, binary.DecodeError] = binary.read_u64(d);
    if (sel r.err) { ret R.err[u64, str](legacy.decode_text(r.err)); }
    ret R.ok[u64, str](r.ok);
}

pub fun read_str(d: *binary.Decoder) R.Result[str, str] {
    val r: res[str, binary.DecodeError] = binary.read_str(d);
    if (sel r.err) { ret R.err[str, str](legacy.decode_text(r.err)); }
    ret R.ok[str, str](r.ok);
}
