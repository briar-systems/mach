# std.collections.vector in its 1.x shape (see mach.lang.legacy)
use std.types.size.usize;
use std.types.string.str;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.canonical.res;
use std.types.canonical.opt;
use std.types.canonical.err;

use A: std.allocator;
use R: std.types.result;
use vector: std.collections.vector;

use mach.lang.alloc;

fwd vector.Vector;
fwd vector.init;
fwd vector.is_empty;
fwd vector.clear;

pub fun dnit[T](vec: *vector.Vector[T]) bool {
    val r: err[A.Error] = vector.dnit[T](vec);
    ret sel r.ok;
}

pub fun reserve[T](vec: *vector.Vector[T], additional: usize) R.Result[usize, str] {
    val r: res[usize, A.Error] = vector.reserve[T](vec, additional);
    if (sel r.err) { ret R.err[usize, str](alloc.text(r.err)); }
    ret R.ok[usize, str](r.ok);
}

pub fun ensure[T](vec: *vector.Vector[T], total: usize) R.Result[usize, str] {
    val r: res[usize, A.Error] = vector.ensure[T](vec, total);
    if (sel r.err) { ret R.err[usize, str](alloc.text(r.err)); }
    ret R.ok[usize, str](r.ok);
}

pub fun push[T](vec: *vector.Vector[T], value: T) R.Result[usize, str] {
    val r: res[usize, A.Error] = vector.push[T](vec, value);
    if (sel r.err) { ret R.err[usize, str](alloc.text(r.err)); }
    ret R.ok[usize, str](r.ok);
}

pub fun pop[T](vec: *vector.Vector[T]) R.Result[T, str] {
    val r: opt[T] = vector.pop[T](vec);
    if (sel r.some) { ret R.ok[T, str](r.some); }
    ret R.err[T, str]("pop from empty vector");
}

pub fun get[T](vec: *vector.Vector[T], index: usize) R.Result[*T, str] {
    val r: opt[*T] = vector.get[T](vec, index);
    if (sel r.some) { ret R.ok[*T, str](r.some); }
    ret R.err[*T, str]("index out of bounds");
}
