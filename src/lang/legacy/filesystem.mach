# std.filesystem in its 1.x shape (see mach.lang.legacy). a query the
# platform refuses reads as absent, exactly as 1.x answered it; the typed
# refusal is what the consumer lane reads once it imports std.filesystem.
use std.types.size.usize;
use std.types.string.str;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.canonical.res;
use std.types.canonical.err;
use std.types.path.Path;
use std.collections.vector.Vector;

use A: std.allocator;
use R: std.types.result;
use O: std.types.option;
use fs: std.filesystem;
use io_error: std.io.error;

use mach.lang.legacy;

fwd fs.Identity;
fwd fs.File;
fwd fs.Kind;
fwd fs.KIND_OTHER;
fwd fs.KIND_FILE;
fwd fs.KIND_DIR;
fwd fs.KIND_SYMLINK;
fwd fs.Metadata;
fwd fs.STDIN;
fwd fs.STDOUT;
fwd fs.STDERR;
fwd fs.SEEK_SET;
fwd fs.SEEK_CUR;
fwd fs.SEEK_END;
fwd fs.FsError;
fwd fs.reader;
fwd fs.writer;
fwd fs.identity_equal;
fwd fs.meta_is_dir;
fwd fs.meta_is_file;
fwd fs.meta_is_symlink;
fwd fs.TempFile;
fwd fs.temp_path;

fun io_option(r: err[io_error.Error]) O.Option[str] {
    if (sel r.err) { ret O.some[str](legacy.io_text(r.err)); }
    ret O.none[str]();
}

fun fs_option(r: err[fs.FsError]) O.Option[str] {
    if (sel r.err) { ret O.some[str](legacy.fs_text(r.err)); }
    ret O.none[str]();
}

fun query(r: res[bool, io_error.Error]) bool {
    if (sel r.ok) { ret r.ok; }
    ret false;
}

pub fun open(p: Path) R.Result[fs.File, io_error.Error] {
    val r: res[fs.File, io_error.Error] = fs.open(p);
    if (sel r.err) { ret R.err[fs.File, io_error.Error](r.err); }
    ret R.ok[fs.File, io_error.Error](r.ok);
}

pub fun close(f: *fs.File) O.Option[io_error.Error] {
    val r: err[io_error.Error] = fs.close(f);
    if (sel r.err) { ret O.some[io_error.Error](r.err); }
    ret O.none[io_error.Error]();
}

pub fun read(f: fs.File, buf: *u8, len: usize) R.Result[usize, io_error.Error] {
    val r: res[usize, io_error.Error] = fs.read(f, buf, len);
    if (sel r.err) { ret R.err[usize, io_error.Error](r.err); }
    ret R.ok[usize, io_error.Error](r.ok);
}

pub fun write(f: fs.File, buf: *u8, len: usize) R.Result[usize, io_error.Error] {
    val r: res[usize, io_error.Error] = fs.write(f, buf, len);
    if (sel r.err) { ret R.err[usize, io_error.Error](r.err); }
    ret R.ok[usize, io_error.Error](r.ok);
}

pub fun seek(f: fs.File, offset: i64, whence: i32) R.Result[i64, io_error.Error] {
    val r: res[i64, io_error.Error] = fs.seek(f, offset, whence);
    if (sel r.err) { ret R.err[i64, io_error.Error](r.err); }
    ret R.ok[i64, io_error.Error](r.ok);
}

pub fun identity_of(f: fs.File) R.Result[fs.Identity, io_error.Error] {
    val r: res[fs.Identity, io_error.Error] = fs.identity_of(f);
    if (sel r.err) { ret R.err[fs.Identity, io_error.Error](r.err); }
    ret R.ok[fs.Identity, io_error.Error](r.ok);
}

pub fun stat_of(f: fs.File) R.Result[fs.Metadata, str] {
    val r: res[fs.Metadata, io_error.Error] = fs.stat_of(f);
    if (sel r.err) { ret R.err[fs.Metadata, str](legacy.io_text(r.err)); }
    ret R.ok[fs.Metadata, str](r.ok);
}

pub fun stat_of_error(f: fs.File) R.Result[fs.Metadata, io_error.Error] {
    val r: res[fs.Metadata, io_error.Error] = fs.stat_of(f);
    if (sel r.err) { ret R.err[fs.Metadata, io_error.Error](r.err); }
    ret R.ok[fs.Metadata, io_error.Error](r.ok);
}

pub fun metadata(p: Path) R.Result[fs.Metadata, str] {
    val r: res[fs.Metadata, io_error.Error] = fs.metadata(p);
    if (sel r.err) { ret R.err[fs.Metadata, str](legacy.io_text(r.err)); }
    ret R.ok[fs.Metadata, str](r.ok);
}

pub fun metadata_link(p: Path) R.Result[fs.Metadata, str] {
    val r: res[fs.Metadata, io_error.Error] = fs.metadata_link(p);
    if (sel r.err) { ret R.err[fs.Metadata, str](legacy.io_text(r.err)); }
    ret R.ok[fs.Metadata, str](r.ok);
}

pub fun exists(p: Path) bool     { ret query(fs.exists(p)); }
pub fun is_file(p: Path) bool    { ret query(fs.is_file(p)); }
pub fun is_dir(p: Path) bool     { ret query(fs.is_dir(p)); }
pub fun is_symlink(p: Path) bool { ret query(fs.is_symlink(p)); }

pub fun create_dir(p: Path, mode: i32) O.Option[str]      { ret io_option(fs.create_dir(p, mode)); }
pub fun remove_file(p: Path) O.Option[str]                { ret io_option(fs.remove_file(p)); }
pub fun remove_dir(p: Path) O.Option[str]                 { ret io_option(fs.remove_dir(p)); }
pub fun rename(from: Path, to: Path) O.Option[str]        { ret io_option(fs.rename(from, to)); }
pub fun symlink(target: Path, linkpath: Path) O.Option[str] { ret io_option(fs.symlink(target, linkpath)); }

pub fun read_bytes(a: *A.Allocator, p: Path) R.Result[Vector[u8], str] {
    val r: res[Vector[u8], fs.FsError] = fs.read_bytes(a, p);
    if (sel r.err) { ret R.err[Vector[u8], str](legacy.fs_text(r.err)); }
    ret R.ok[Vector[u8], str](r.ok);
}

pub fun read_string(a: *A.Allocator, p: Path) R.Result[str, str] {
    val r: res[str, fs.FsError] = fs.read_string(a, p);
    if (sel r.err) { ret R.err[str, str](legacy.fs_text(r.err)); }
    ret R.ok[str, str](r.ok);
}

pub fun read_dir(a: *A.Allocator, p: Path) R.Result[Vector[str], str] {
    val r: res[Vector[str], fs.FsError] = fs.read_dir(a, p);
    if (sel r.err) { ret R.err[Vector[str], str](legacy.fs_text(r.err)); }
    ret R.ok[Vector[str], str](r.ok);
}

pub fun write_bytes(p: Path, data: *u8, len: usize, mode: i32) O.Option[str] {
    ret fs_option(fs.write_bytes(p, data, len, mode));
}

pub fun create_dir_all(a: *A.Allocator, p: Path, mode: i32) O.Option[str] {
    ret fs_option(fs.create_dir_all(a, p, mode));
}

pub fun remove_all(a: *A.Allocator, p: Path) O.Option[str] {
    ret fs_option(fs.remove_all(a, p));
}

pub fun temp_create(a: *A.Allocator, prefix: str) R.Result[fs.TempFile, str] {
    val r: res[fs.TempFile, fs.FsError] = fs.temp_create(a, prefix);
    if (sel r.err) { ret R.err[fs.TempFile, str](legacy.fs_text(r.err)); }
    ret R.ok[fs.TempFile, str](r.ok);
}

pub fun temp_close(tf: *fs.TempFile) O.Option[str]            { ret io_option(fs.temp_close(tf)); }
pub fun temp_remove(tf: *fs.TempFile) O.Option[str]           { ret io_option(fs.temp_remove(tf)); }
pub fun temp_close_and_remove(tf: *fs.TempFile) O.Option[str] { ret io_option(fs.temp_close_and_remove(tf)); }
