use mach.lang.fail;
use std.allocator.page;
use T: std.allocator.testing;
use std.collections.vector;
use std.collections.vector.Vector;
use std.crypto.hash.sha256;
use fs:  std.filesystem;
use txn: std.filesystem.transaction;
use std.format;
use io_error: std.io.error;
use std.process.env;
use std.system.os;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string;
use std.types.string.str;
use std.types.string.str_contains_char;
use std.types.string.str_empty;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.string.str_starts_with;

use A: std.allocator;
use std.types.path;

use mach.lang.fe.ast;
use mach.lang.fe.ast.decl;
use mach.lang.fe.ast.expr;
use mach.lang.fe.token;
use mach.lang.intern;
use mach.lang.manifest;
use mach.lang.query;

pub def EmbedStatus: u8;

pub val EMBED_OK:         EmbedStatus = 0;
pub val EMBED_MISSING:    EmbedStatus = 1;
pub val EMBED_IS_DIR:     EmbedStatus = 2;
pub val EMBED_UNREADABLE: EmbedStatus = 3;
pub val EMBED_TOO_LARGE:  EmbedStatus = 4;

pub rec EmbedFile {
    path:   intern.StrId;
    status: EmbedStatus;
    reason: str;
    bytes:  *u8;
    len:    u32;
    digest: [32]u8;
}

pub rec EmbedCache {
    alloc:   *A.Allocator;
    entries: *EmbedFile;
    len:     u32;
    cap:     u32;

    root:      str;
    reqs:      *manifest.ArtifactReq;
    req_count: u32;
}

val ENTRY_SEED_CAP: u32 = 8;

val INPUT_LEN: u32 = 33;

pub fun init(alloc: *A.Allocator) EmbedCache {
    var c: EmbedCache;
    c.alloc     = alloc;
    c.entries   = nil;
    c.len       = 0;
    c.cap       = 0;
    c.root      = "";
    c.reqs      = nil;
    c.req_count = 0;
    ret c;
}

pub fun set_path_env(c: *EmbedCache, root: str, reqs: *manifest.ArtifactReq, req_count: u32) {
    c.root      = root;
    c.reqs      = reqs;
    c.req_count = req_count;
}

pub fun dnit(c: *EmbedCache) {
    if (c.entries == nil || c.cap == 0) {
        c.entries = nil;
        c.len     = 0;
        c.cap     = 0;
        ret;
    }
    var i: u32 = 0;
    for (i < c.len) {
        free_bytes(c, ?c.entries[i]);
        i = i + 1;
    }
    A.deallocate[EmbedFile](c.alloc, c.entries, c.cap::usize);
    c.entries = nil;
    c.len     = 0;
    c.cap     = 0;
}

pub fun get(c: *EmbedCache, path_id: intern.StrId) opt[*EmbedFile] {
    var i: u32 = 0;
    for (i < c.len) {
        if (c.entries[i].path == path_id) { ret opt[*EmbedFile].some{?c.entries[i]}; }
        i = i + 1;
    }
    ret opt[*EmbedFile].none{};
}

pub fun resolve_arg(alloc: *A.Allocator, c: *EmbedCache, decl_file: str, arg: str) res[str, manifest.TemplateError] {
    if (!str_contains_char(arg, '{')) {
        val r: res[str, fail.Fail] = resolve_path(alloc, decl_file, arg);
        if (sel r.err) {
            ret res[str, manifest.TemplateError].err{manifest.template_internal(fail.describe(r.err))};
        }
        ret res[str, manifest.TemplateError].ok{r.ok};
    }
    val er: res[str, manifest.TemplateError] = manifest.expand_artifact_path(alloc, arg, c.reqs, c.req_count,
        "an `embed` path");
    if (sel er.err) { ret er; }
    val expanded: str = er.ok;
    fin { str_free(alloc, expanded); }
    if (str_empty(c.root)) {
        ret res[str, manifest.TemplateError].err{manifest.template_rejection(alloc, "an `embed` path", arg,
            "path template needs a project root; this build has none")};
    }
    val jr: res[path.Path, A.Error] = path.resolve(alloc, c.root, expanded);
    if (sel jr.err) {
        ret res[str, manifest.TemplateError].err{manifest.template_internal(fail.describe(fail.refused(jr.err)))};
    }
    ret res[str, manifest.TemplateError].ok{jr.ok};
}

# check lexical and existing-parent containment beneath the project root
# a missing parent is left to embed loading, while an incomplete check is err
# the project root and a resolved file are compared in one coordinate system:
# a relative root (`mach build .`) and a relative source path are both rooted
# at the working directory before the lexical containment check
fun absolute_clean(alloc: *A.Allocator, value: str) res[path.Path, fail.Fail] {
    if (path.is_abs(value)) {
        val cr: res[path.Path, A.Error] = path.clean(alloc, value);
        if (sel cr.err) { ret res[path.Path, fail.Fail].err{fail.refused(cr.err)}; }
        ret res[path.Path, fail.Fail].ok{cr.ok};
    }
    val cwd_r: res[string.OwnedString, env.EnvError] = env.current_dir(alloc);
    if (sel cwd_r.err) { ret res[path.Path, fail.Fail].err{env_failure(cwd_r.err)}; }
    var cwd:      string.OwnedString      = cwd_r.ok;
    val joined_r: res[path.Path, A.Error] = path.resolve(alloc, cwd.data, value);
    string.owned_release(?cwd);
    if (sel joined_r.err) { ret res[path.Path, fail.Fail].err{fail.refused(joined_r.err)}; }
    val joined: str                     = joined_r.ok;
    val cr:     res[path.Path, A.Error] = path.clean(alloc, joined);
    str_free(alloc, joined);
    if (sel cr.err) { ret res[path.Path, fail.Fail].err{fail.refused(cr.err)}; }
    ret res[path.Path, fail.Fail].ok{cr.ok};
}

fun env_failure(e: env.EnvError) fail.Fail {
    if (sel e.native) { ret fail.message(os.message(e.native)); }
    if (sel e.alloc)  { ret fail.refused(e.alloc); }
    ret fail.message("the working directory changed while it was read");
}

pub fun escapes_root(alloc: *A.Allocator, c: *EmbedCache, resolved: str) res[bool, fail.Fail] {
    if (str_empty(c.root)) { ret res[bool, fail.Fail].ok{false}; }
    val root_r: res[path.Path, fail.Fail] = absolute_clean(alloc, c.root);
    if (sel root_r.err) { ret res[bool, fail.Fail].err{root_r.err}; }
    val root: str = root_r.ok;
    fin { str_free(alloc, root); }
    val res_r: res[path.Path, fail.Fail] = absolute_clean(alloc, resolved);
    if (sel res_r.err) { ret res[bool, fail.Fail].err{res_r.err}; }
    val target: str = res_r.ok;
    fin { str_free(alloc, target); }
    if (str_equals(target, root)) { ret res[bool, fail.Fail].ok{false}; }

    val rl: usize = str_len(root);
    if (str_len(target) <= rl || !str_starts_with(target, root)) { ret res[bool, fail.Fail].ok{true}; }
    var relative_start: usize = rl;
    if (root[rl - 1] != path.separator()) {
        if (target[rl] != path.separator()) { ret res[bool, fail.Fail].ok{true}; }
        relative_start = relative_start + 1;
    }
    val rel:   str                     = (target::usize + relative_start)::str;
    val dir_r: res[path.Path, A.Error] = path.parent(alloc, rel);
    if (sel dir_r.err) { ret res[bool, fail.Fail].err{fail.refused(dir_r.err)}; }
    val dir: str = dir_r.ok;
    fin { str_free(alloc, dir); }
    if (path.separator() != '/'::u8) {
        var i: usize = 0;
        for (dir[i] != 0) {
            if (dir[i] == path.separator()) { dir[i] = '/'::u8; }
            i = i + 1;
        }
    }
    var opened: txn.Root;
    val open_r: err[txn.Error] = txn.root_open(?opened, root, dir);
    if (sel open_r.err) {
        val error: txn.Error = open_r.err;
        if (error.kind == txn.CONTAINMENT)                   { ret res[bool, fail.Fail].ok{true}; }
        if (error.kind == txn.IO && error.code == os.ENOENT) { ret res[bool, fail.Fail].ok{false}; }
        ret res[bool, fail.Fail].err{fail.message(txn.error_message(error))};
    }
    val closed: err[txn.Error] = txn.root_dnit(?opened);
    if (sel closed.err) {
        ret res[bool, fail.Fail].err{fail.message(txn.error_message(closed.err))};
    }
    ret res[bool, fail.Fail].ok{false};
}

pub fun resolve_path(alloc: *A.Allocator, decl_file: str, arg: str) res[str, fail.Fail] {
    val pr: res[path.Path, A.Error] = path.parent(alloc, decl_file);
    if (sel pr.err) { ret res[str, fail.Fail].err{fail.refused(pr.err)}; }
    val dir: path.Path = pr.ok;

    val jr: res[path.Path, A.Error] = path.resolve(alloc, dir, arg);
    str_free(alloc, dir);
    if (sel jr.err) { ret res[str, fail.Fail].err{fail.refused(jr.err)}; }
    ret res[str, fail.Fail].ok{jr.ok};
}

pub fun refresh(c: *EmbedCache, db: *query.QueryDb, itn: *intern.Interner, p: str) res[intern.StrId, fail.Fail] {
    val ir: res[intern.StrId, A.Error] = intern.intern(itn, p);
    if (sel ir.err) { ret res[intern.StrId, fail.Fail].err{fail.refused(ir.err)}; }
    val path_id: intern.StrId = ir.ok;

    val er: res[*EmbedFile, fail.Fail] = entry_for(c, path_id);
    if (sel er.err) { ret res[intern.StrId, fail.Fail].err{er.err}; }
    val e: *EmbedFile = er.ok;

    val rr: err[fail.Fail] = read_into(c, e, p);
    if (sel rr.err) { ret res[intern.StrId, fail.Fail].err{rr.err}; }

    val pr: err[fail.Fail] = publish(db, e);
    if (sel pr.err) { ret res[intern.StrId, fail.Fail].err{pr.err}; }
    ret res[intern.StrId, fail.Fail].ok{path_id};
}

fun read_into(c: *EmbedCache, e: *EmbedFile, p: str) err[fail.Fail] {
    val was_ok:  bool = e.status == EMBED_OK;
    val old_len: u32  = e.len;

    val is_dir_r: res[bool, io_error.Error] = fs.is_dir(p);
    if (sel is_dir_r.ok && is_dir_r.ok) {
        free_bytes(c, e);
        zero_digest(e);
        e.status = EMBED_IS_DIR;
        e.reason = "is a directory";
        ret err[fail.Fail].ok{};
    }
    val exists_r: res[bool, io_error.Error] = fs.exists(p);
    if (!(sel exists_r.ok && exists_r.ok)) {
        free_bytes(c, e);
        zero_digest(e);
        e.status = EMBED_MISSING;
        e.reason = "no such file or directory";
        ret err[fail.Fail].ok{};
    }

    val mr: res[fs.Metadata, io_error.Error] = fs.metadata(p);
    if (sel mr.ok && mr.ok.size::u64 > 4294967295) {
        mark_too_large(c, e);
        ret err[fail.Fail].ok{};
    }

    val rr: res[Vector[u8], fs.FsError] = fs.read_bytes(c.alloc, p);
    if (sel rr.err) {
        free_bytes(c, e);
        zero_digest(e);
        e.status = EMBED_UNREADABLE;
        e.reason = fail.describe(fail.fs_refused(rr.err));
        ret err[fail.Fail].ok{};
    }
    var buf: Vector[u8] = rr.ok;
    if (buf.len::u64 > 4294967295) {
        vector.dnit[u8](?buf);
        mark_too_large(c, e);
        ret err[fail.Fail].ok{};
    }

    var fresh: [32]u8;
    sha256.hash(buf.data, buf.len, ?fresh[0]);

    if (was_ok && old_len == buf.len::u32 && digest_equals(?e.digest[0], ?fresh[0])) {
        vector.dnit[u8](?buf);
        ret err[fail.Fail].ok{};
    }

    free_bytes(c, e);
    e.status = EMBED_OK;
    e.reason = "";
    var i: u32 = 0;
    for (i < 32) {
        e.digest[i] = fresh[i];
        i           = i + 1;
    }

    if (buf.len > 0) {
        val ar: res[*u8, A.Error] = A.allocate[u8](c.alloc, buf.len);
        if (sel ar.err) {
            vector.dnit[u8](?buf);
            ret err[fail.Fail].err{fail.refused(ar.err)};
        }
        e.bytes = ar.ok;
        e.len   = buf.len::u32;
        var bi: usize = 0;
        for (bi < buf.len) {
            e.bytes[bi] = buf.data[bi];
            bi          = bi + 1;
        }
    }
    vector.dnit[u8](?buf);
    ret err[fail.Fail].ok{};
}

fun digest_equals(a: *u8, b: *u8) bool {
    var i: u32 = 0;
    for (i < 32) {
        if (a[i] != b[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun publish(db: *query.QueryDb, e: *EmbedFile) err[fail.Fail] {
    var value: [33]u8;
    value[0] = e.status;
    var i: u32 = 0;
    for (i < 32) {
        value[i + 1] = e.digest[i];
        i            = i + 1;
    }
    ret query.set_input(db, query.Q_EMBED_FILE, e.path::u64, ?value[0], INPUT_LEN);
}

fun entry_for(c: *EmbedCache, path_id: intern.StrId) res[*EmbedFile, fail.Fail] {
    var i: u32 = 0;
    for (i < c.len) {
        if (c.entries[i].path == path_id) { ret res[*EmbedFile, fail.Fail].ok{?c.entries[i]}; }
        i = i + 1;
    }

    val gr: err[fail.Fail] = grow(c);
    if (sel gr.err) { ret res[*EmbedFile, fail.Fail].err{gr.err}; }

    val idx: u32 = c.len;
    var e:   EmbedFile;
    e.path         = path_id;
    e.status       = EMBED_OK;
    e.reason       = "";
    e.bytes        = nil;
    e.len          = 0;
    c.entries[idx] = e;
    c.len          = c.len + 1;
    zero_digest(?c.entries[idx]);
    ret res[*EmbedFile, fail.Fail].ok{?c.entries[idx]};
}

fun grow(c: *EmbedCache) err[fail.Fail] {
    if (c.len < c.cap) { ret err[fail.Fail].ok{}; }

    var new_cap: u32 = ENTRY_SEED_CAP;
    if (c.cap > 0) { new_cap = c.cap * 2; }

    if (c.entries == nil) {
        val ar: res[*EmbedFile, A.Error] = A.allocate[EmbedFile](c.alloc, new_cap::usize);
        if (sel ar.err) { ret err[fail.Fail].err{fail.refused(ar.err)}; }
        c.entries = ar.ok;
    }
    or {
        val rr: res[*EmbedFile, A.Error] = A.reallocate[EmbedFile](c.alloc, c.entries, c.cap::usize, new_cap::usize);
        if (sel rr.err) { ret err[fail.Fail].err{fail.refused(rr.err)}; }
        c.entries = rr.ok;
    }
    c.cap = new_cap;
    ret err[fail.Fail].ok{};
}

fun free_bytes(c: *EmbedCache, e: *EmbedFile) {
    if (e.bytes != nil && e.len > 0) {
        A.deallocate[u8](c.alloc, e.bytes, e.len::usize);
    }
    e.bytes = nil;
    e.len   = 0;
}

fun zero_digest(e: *EmbedFile) {
    var i: u32 = 0;
    for (i < 32) {
        e.digest[i] = 0;
        i           = i + 1;
    }
}

fun mark_too_large(c: *EmbedCache, e: *EmbedFile) {
    free_bytes(c, e);
    zero_digest(e);
    e.status = EMBED_TOO_LARGE;
    e.reason = "file exceeds the maximum embed size of 4294967295 bytes";
}

pub fun path_arg_span(a: *ast.Ast, dec: *decl.Decorator) opt[token.Span] {
    if (dec.args_len != 1) { ret opt[token.Span].none{}; }
    val opt_e: opt[*expr.Expr] = ast.get_expr(a, a.expr_ids[dec.args_start]);
    if (sel opt_e.none) { ret opt[token.Span].none{}; }
    val e: *expr.Expr = opt_e.some;
    if (e.kind != expr.EXPR_KIND_LIT_STR) { ret opt[token.Span].none{}; }
    if (e.span.len <= 2::usize)           { ret opt[token.Span].none{}; }

    var inner: token.Span = e.span;
    inner.offset = inner.offset + 1::usize;
    inner.len    = inner.len - 2::usize;
    ret opt[token.Span].some{inner};
}

fun t_embed_containment_paths(refuse: bool) i32 {
    var backing: A.Allocator;
    val make_r:  err[A.Error] = page.make(?backing);
    if (sel make_r.err) { ret 1; }
    val made: res[fs.TempFile, fs.FsError] = fs.temp_create(?backing, "mach_embed_containment");
    if (sel made.err) { ret 1; }
    var temp: fs.TempFile = made.ok;
    fin { str_free(?backing, temp.path); }
    val temp_close_and_remove_r: err[io_error.Error] = fs.temp_close_and_remove(?temp);
    if (sel temp_close_and_remove_r.err) { ret 1; }
    val create_dir_r: err[io_error.Error] = fs.create_dir(temp.path, 0o700);
    if (sel create_dir_r.err) { ret 1; }
    fin { fs.remove_all(?backing, temp.path); }
    val nested_r: res[path.Path, A.Error] = path.join(?backing, temp.path, "outer/inner");
    if (sel nested_r.err) { ret 1; }
    val nested: str = nested_r.ok;
    fin { str_free(?backing, nested); }
    val create_dir_all_r: err[fs.FsError] = fs.create_dir_all(?backing, nested, 0o700);
    if (sel create_dir_all_r.err) { ret 1; }
    val inside_r: res[path.Path, A.Error] = path.join(?backing, nested, "payload.bin");
    if (sel inside_r.err) { ret 1; }
    val inside: str = inside_r.ok;
    fin { str_free(?backing, inside); }
    val missing_r: res[path.Path, A.Error] = path.join(?backing, temp.path, "missing/nested/payload.bin");
    if (sel missing_r.err) { ret 1; }
    val missing: str = missing_r.ok;
    fin { str_free(?backing, missing); }
    val sibling_r: res[str, format.FormatError] = format.sprint(?backing, "{}-sibling/payload.bin", temp.path);
    if (sel sibling_r.err) { ret 1; }
    val sibling: str = sibling_r.ok;
    fin { str_free(?backing, sibling); }
    var paths: [4]str;
    paths[0] = temp.path;
    paths[1] = inside;
    paths[2] = missing;
    paths[3] = sibling;
    var t:       T.Testing;
    val make_r2: err[A.Error] = T.make(?t);
    if (sel make_r2.err) { ret 1; }
    fin { T.dnit(?t); }
    val alloc: *A.Allocator = T.allocator_of(?t);
    var cache: EmbedCache   = init(?backing);
    cache.root = temp.path;
    var i: u32 = 0;
    for (i < 4) {
        val before: usize                = T.attempt_count(?t);
        val result: res[bool, fail.Fail] = escapes_root(alloc, ?cache, paths[i]);
        if (sel result.err)                                                           { ret 2; }
        if (result.ok != (i == 3))                                                    { ret 3; }
        if (T.leaked(?t) || T.double_free_count(?t) != 0 || T.tracking_exhausted(?t)) { ret 4; }
        val attempts: usize = T.attempt_count(?t) - before;
        if (attempts == 0) { ret 5; }
        if (refuse) {
            var ordinal: usize = 1;
            for (ordinal <= attempts) {
                T.fail_at_ordinal(?t, T.attempt_count(?t) + ordinal);
                val failed: res[bool, fail.Fail] = escapes_root(alloc, ?cache, paths[i]);
                if (sel failed.ok)                                                            { ret 6; }
                if (!str_equals(fail.describe(failed.err), "out of memory"))                  { ret 7; }
                if (T.leaked(?t) || T.double_free_count(?t) != 0 || T.tracking_exhausted(?t)) { ret 8; }
                ordinal = ordinal + 1;
            }
            T.fail_at_ordinal(?t, 0);
        }
        i = i + 1;
    }
    ret 0;
}

test "mach.lang.embed.containment:nested_and_missing_parents_are_distinct_from_escape" {
    ret t_embed_containment_paths(false);
}

test "mach.lang.embed.containment:allocation_refusal_never_becomes_a_containment_answer" {
    ret t_embed_containment_paths(true);
}

test "mach.lang.embed.containment:root_open_failure_is_not_a_missing_parent" {
    var backing: A.Allocator;
    val make_r:  err[A.Error] = page.make(?backing);
    if (sel make_r.err) { ret 1; }
    val made: res[fs.TempFile, fs.FsError] = fs.temp_create(?backing, "mach_embed_obstruction");
    if (sel made.err) { ret 1; }
    var temp: fs.TempFile = made.ok;
    fin {
        fs.temp_close_and_remove(?temp);
        str_free(?backing, temp.path);
    }
    val child_r: res[path.Path, A.Error] = path.join(?backing, temp.path, "child/payload.bin");
    if (sel child_r.err) { ret 1; }
    val child: str = child_r.ok;
    fin { str_free(?backing, child); }
    var t:       T.Testing;
    val make_r2: err[A.Error] = T.make(?t);
    if (sel make_r2.err) { ret 1; }
    fin { T.dnit(?t); }
    var cache: EmbedCache = init(?backing);
    cache.root = temp.path;
    val result: res[bool, fail.Fail] = escapes_root(T.allocator_of(?t), ?cache, child);
    if (sel result.ok)                                                            { ret 2; }
    if (str_empty(fail.describe(result.err)))                                     { ret 3; }
    if (T.leaked(?t) || T.double_free_count(?t) != 0 || T.tracking_exhausted(?t)) { ret 4; }
    ret 0;
}

test "mach.lang.embed.containment:filesystem_root_is_a_parent_without_an_extra_separator" {
    var backing: A.Allocator;
    val make_r:  err[A.Error] = page.make(?backing);
    if (sel make_r.err) { ret 1; }
    var cache: EmbedCache = init(?backing);
    cache.root = "/";
    val result: res[bool, fail.Fail] = escapes_root(?backing, ?cache,
        "/mach_embed_containment_missing_parent_3209/payload.bin");
    if (sel result.err) { ret 2; }
    if (result.ok)      { ret 3; }
    ret 0;
}

# `mach build .` hands the cache a relative root while the resolved file is a
# relative source path; both are rooted at the working directory before the
# check, so a file under src/ is never reported as escaping (#3226)
test "mach.lang.embed.containment:relative_roots_and_source_paths_share_absolute_coordinates" {
    var backing: A.Allocator;
    val make_r:  err[A.Error] = page.make(?backing);
    if (sel make_r.err) { ret 1; }
    val cwd_r: res[string.OwnedString, env.EnvError] = env.current_dir(?backing);
    if (sel cwd_r.err) { ret 2; }
    var cwd: string.OwnedString = cwd_r.ok;
    fin { string.owned_release(?cwd); }
    val abs_src_r: res[path.Path, A.Error] = path.join(?backing, cwd.data, "src/asset.bin");
    if (sel abs_src_r.err) { ret 3; }
    val abs_src: str = abs_src_r.ok;
    fin { str_free(?backing, abs_src); }

    var cache: EmbedCache = init(?backing);
    var mode:  u32        = 0;
    for (mode < 4) {
        cache.root = ".";
        var file: str = "src/asset.bin";
        if (mode == 1) { cache.root = "./src/.."; }
        if (mode == 2) { file = abs_src; }
        if (mode == 3) { cache.root = cwd.data; }
        val inside: res[bool, fail.Fail] = escapes_root(?backing, ?cache, file);
        if (sel inside.err) { ret 4; }
        if (inside.ok)      { ret 10 + mode::i32; }
        mode = mode + 1;
    }
    cache.root = ".";
    val outside: res[bool, fail.Fail] = escapes_root(?backing, ?cache, "../outside.bin");
    if (sel outside.err) { ret 5; }
    if (!outside.ok)     { ret 6; }
    cache.root = "src";
    val sibling: res[bool, fail.Fail] = escapes_root(?backing, ?cache, "dep/x/asset.bin");
    if (sel sibling.err) { ret 7; }
    if (!sibling.ok)     { ret 8; }
    ret 0;
}
