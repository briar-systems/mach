use std.allocator.page;
use std.format;
use T: std.allocator.testing;
use std.system.os;
use std.collections.vector;
use std.collections.vector.Vector;
use std.crypto.hash.sha256;
use fs: std.filesystem;
use txn: std.filesystem.transaction;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_contains_char;
use std.types.string.str_empty;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.string.str_starts_with;

use A: std.allocator;
use O: std.types.option;
use R: std.types.result;
use std.types.path;

use mach.lang.fe.ast;
use mach.lang.fe.ast.decl;
use mach.lang.fe.ast.expr;
use mach.lang.fe.token;
use mach.lang.intern;
use mach.lang.manifest;
use mach.lang.query;

pub def EmbedStatus: u8;

pub val EMBED_OK:       EmbedStatus = 0;
pub val EMBED_MISSING:  EmbedStatus = 1;
pub val EMBED_IS_DIR:   EmbedStatus = 2;
pub val EMBED_UNREADABLE: EmbedStatus = 3;
pub val EMBED_TOO_LARGE:  EmbedStatus = 4;

pub rec EmbedFile {
    path:   intern.StrId;
    status: EmbedStatus;
    reason: str;
    bytes:  *u8;
    len:    u32;
    digest: [32]u8;
}

pub rec EmbedCache {
    alloc:   *A.Allocator;
    entries: *EmbedFile;
    len:     u32;
    cap:     u32;

    root:      str;
    reqs:      *manifest.ArtifactReq;
    req_count: u32;
}

val ENTRY_SEED_CAP: u32 = 8;

val INPUT_LEN: u32 = 33;

pub fun init(alloc: *A.Allocator) EmbedCache {
    var c: EmbedCache;
    c.alloc   = alloc;
    c.entries = nil;
    c.len     = 0;
    c.cap     = 0;
    c.root      = "";
    c.reqs      = nil;
    c.req_count = 0;
    ret c;
}

pub fun set_path_env(c: *EmbedCache, root: str, reqs: *manifest.ArtifactReq, req_count: u32) {
    c.root      = root;
    c.reqs      = reqs;
    c.req_count = req_count;
}

pub fun dnit(c: *EmbedCache) {
    if (c.entries == nil || c.cap == 0) {
        c.entries = nil;
        c.len     = 0;
        c.cap     = 0;
        ret;
    }
    var i: u32 = 0;
    for (i < c.len) {
        free_bytes(c, ?c.entries[i]);
        i = i + 1;
    }
    A.deallocate[EmbedFile](c.alloc, c.entries, c.cap::usize);
    c.entries = nil;
    c.len     = 0;
    c.cap     = 0;
}

pub fun get(c: *EmbedCache, path_id: intern.StrId) O.Option[*EmbedFile] {
    var i: u32 = 0;
    for (i < c.len) {
        if (c.entries[i].path == path_id) { ret O.some[*EmbedFile](?c.entries[i]); }
        i = i + 1;
    }
    ret O.none[*EmbedFile]();
}

pub fun resolve_arg(alloc: *A.Allocator, c: *EmbedCache, decl_file: str, arg: str) R.Result[str, manifest.TemplateError] {
    if (!str_contains_char(arg, '{')) {
        val r: R.Result[str, str] = resolve_path(alloc, decl_file, arg);
        if (R.is_err[str, str](r)) {
            ret R.err[str, manifest.TemplateError](manifest.template_internal(R.unwrap_err[str, str](r)));
        }
        ret R.ok[str, manifest.TemplateError](R.unwrap_ok[str, str](r));
    }
    val er: R.Result[str, manifest.TemplateError] = manifest.expand_artifact_path(alloc, arg, c.reqs, c.req_count,
        "an `embed` path");
    if (R.is_err[str, manifest.TemplateError](er)) { ret er; }
    val expanded: str = R.unwrap_ok[str, manifest.TemplateError](er);
    fin { str_free(alloc, expanded); }
    if (str_empty(c.root)) {
        ret R.err[str, manifest.TemplateError](manifest.template_rejection(alloc, "an `embed` path", arg,
            "path template needs a project root; this build has none"));
    }
    val jr: R.Result[path.Path, str] = path.resolve(alloc, c.root, expanded);
    if (R.is_err[path.Path, str](jr)) {
        ret R.err[str, manifest.TemplateError](manifest.template_internal(R.unwrap_err[path.Path, str](jr)));
    }
    ret R.ok[str, manifest.TemplateError](R.unwrap_ok[path.Path, str](jr));
}

# check lexical and existing-parent containment beneath the project root
# a missing parent is left to embed loading, while an incomplete check is err
pub fun escapes_root(alloc: *A.Allocator, c: *EmbedCache, resolved: str) R.Result[bool, str] {
    if (str_empty(c.root)) { ret R.ok[bool, str](false); }
    val root_r: R.Result[path.Path, str] = path.clean(alloc, c.root);
    if (R.is_err[path.Path, str](root_r)) { ret R.err[bool, str](R.unwrap_err[path.Path, str](root_r)); }
    val root: str = R.unwrap_ok[path.Path, str](root_r);
    fin { str_free(alloc, root); }
    val res_r: R.Result[path.Path, str] = path.clean(alloc, resolved);
    if (R.is_err[path.Path, str](res_r)) { ret R.err[bool, str](R.unwrap_err[path.Path, str](res_r)); }
    val target: str = R.unwrap_ok[path.Path, str](res_r);
    fin { str_free(alloc, target); }
    if (str_equals(target, root)) { ret R.ok[bool, str](false); }

    val rl: usize = str_len(root);
    if (str_len(target) <= rl || !str_starts_with(target, root)) { ret R.ok[bool, str](true); }
    var relative_start: usize = rl;
    if (root[rl - 1] != path.separator()) {
        if (target[rl] != path.separator()) { ret R.ok[bool, str](true); }
        relative_start = relative_start + 1;
    }
    val rel: str = (target::usize + relative_start)::str;
    val dir_r: R.Result[path.Path, str] = path.parent(alloc, rel);
    if (R.is_err[path.Path, str](dir_r)) { ret R.err[bool, str](R.unwrap_err[path.Path, str](dir_r)); }
    val dir: str = R.unwrap_ok[path.Path, str](dir_r);
    fin { str_free(alloc, dir); }
    if (path.separator() != '/'::u8) {
        var i: usize = 0;
        for (dir[i] != 0) {
            if (dir[i] == path.separator()) { dir[i] = '/'::u8; }
            i = i + 1;
        }
    }
    val open_r: R.Result[txn.Root, txn.Error] = txn.root_open(root, dir);
    if (R.is_err[txn.Root, txn.Error](open_r)) {
        val error: txn.Error = R.unwrap_err[txn.Root, txn.Error](open_r);
        if (error.kind == txn.CONTAINMENT) { ret R.ok[bool, str](true); }
        if (error.kind == txn.IO && error.code == os.ENOENT) { ret R.ok[bool, str](false); }
        ret R.err[bool, str](txn.error_message(error));
    }
    var opened: txn.Root = R.unwrap_ok[txn.Root, txn.Error](open_r);
    txn.root_dnit(?opened);
    ret R.ok[bool, str](false);
}

pub fun resolve_path(alloc: *A.Allocator, decl_file: str, arg: str) R.Result[str, str] {
    val pr: R.Result[path.Path, str] = path.parent(alloc, decl_file);
    if (R.is_err[path.Path, str](pr)) { ret R.err[str, str](R.unwrap_err[path.Path, str](pr)); }
    val dir: path.Path = R.unwrap_ok[path.Path, str](pr);

    val jr: R.Result[path.Path, str] = path.resolve(alloc, dir, arg);
    str_free(alloc, dir);
    if (R.is_err[path.Path, str](jr)) { ret R.err[str, str](R.unwrap_err[path.Path, str](jr)); }
    ret R.ok[str, str](R.unwrap_ok[path.Path, str](jr));
}

pub fun refresh(c: *EmbedCache, db: *query.QueryDb, itn: *intern.Interner, p: str) R.Result[intern.StrId, str] {
    val ir: R.Result[intern.StrId, str] = intern.intern(itn, p);
    if (R.is_err[intern.StrId, str](ir)) { ret ir; }
    val path_id: intern.StrId = R.unwrap_ok[intern.StrId, str](ir);

    val er: R.Result[*EmbedFile, str] = entry_for(c, path_id);
    if (R.is_err[*EmbedFile, str](er)) { ret R.err[intern.StrId, str](R.unwrap_err[*EmbedFile, str](er)); }
    val e: *EmbedFile = R.unwrap_ok[*EmbedFile, str](er);

    val rr: R.Result[R.Void, str] = read_into(c, e, p);
    if (R.is_err[R.Void, str](rr)) { ret R.err[intern.StrId, str](R.unwrap_err[R.Void, str](rr)); }

    val pr: R.Result[R.Void, str] = publish(db, e);
    if (R.is_err[R.Void, str](pr)) { ret R.err[intern.StrId, str](R.unwrap_err[R.Void, str](pr)); }
    ret R.ok[intern.StrId, str](path_id);
}

fun read_into(c: *EmbedCache, e: *EmbedFile, p: str) R.Result[R.Void, str] {
    val was_ok:  bool = e.status == EMBED_OK;
    val old_len: u32  = e.len;

    if (fs.is_dir(p)) {
        free_bytes(c, e);
        zero_digest(e);
        e.status = EMBED_IS_DIR;
        e.reason = "is a directory";
        ret R.ok_void[str]();
    }
    if (!fs.exists(p)) {
        free_bytes(c, e);
        zero_digest(e);
        e.status = EMBED_MISSING;
        e.reason = "no such file or directory";
        ret R.ok_void[str]();
    }

    val mr: R.Result[fs.Metadata, str] = fs.metadata(p);
    if (R.is_ok[fs.Metadata, str](mr) && R.unwrap_ok[fs.Metadata, str](mr).size::u64 > 4294967295) {
        mark_too_large(c, e);
        ret R.ok_void[str]();
    }

    val rr: R.Result[Vector[u8], str] = fs.read_bytes(c.alloc, p);
    if (R.is_err[Vector[u8], str](rr)) {
        free_bytes(c, e);
        zero_digest(e);
        e.status = EMBED_UNREADABLE;
        e.reason = R.unwrap_err[Vector[u8], str](rr);
        ret R.ok_void[str]();
    }
    var buf: Vector[u8] = R.unwrap_ok[Vector[u8], str](rr);
    if (buf.len::u64 > 4294967295) {
        vector.dnit[u8](?buf);
        mark_too_large(c, e);
        ret R.ok_void[str]();
    }

    var fresh: [32]u8;
    sha256.hash(buf.data, buf.len, ?fresh[0]);

    if (was_ok && old_len == buf.len::u32 && digest_equals(?e.digest[0], ?fresh[0])) {
        vector.dnit[u8](?buf);
        ret R.ok_void[str]();
    }

    free_bytes(c, e);
    e.status = EMBED_OK;
    e.reason = "";
    var i: u32 = 0;
    for (i < 32) {
        e.digest[i] = fresh[i];
        i = i + 1;
    }

    if (buf.len > 0) {
        val ar: R.Result[*u8, str] = A.allocate[u8](c.alloc, buf.len);
        if (R.is_err[*u8, str](ar)) {
            vector.dnit[u8](?buf);
            ret R.err[R.Void, str](R.unwrap_err[*u8, str](ar));
        }
        e.bytes = R.unwrap_ok[*u8, str](ar);
        e.len   = buf.len::u32;
        var bi: usize = 0;
        for (bi < buf.len) {
            e.bytes[bi] = buf.data[bi];
            bi = bi + 1;
        }
    }
    vector.dnit[u8](?buf);
    ret R.ok_void[str]();
}

fun digest_equals(a: *u8, b: *u8) bool {
    var i: u32 = 0;
    for (i < 32) {
        if (a[i] != b[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun publish(db: *query.QueryDb, e: *EmbedFile) R.Result[R.Void, str] {
    var value: [33]u8;
    value[0] = e.status;
    var i: u32 = 0;
    for (i < 32) {
        value[i + 1] = e.digest[i];
        i = i + 1;
    }
    ret query.set_input(db, query.Q_EMBED_FILE, e.path::u64, ?value[0], INPUT_LEN);
}

fun entry_for(c: *EmbedCache, path_id: intern.StrId) R.Result[*EmbedFile, str] {
    var i: u32 = 0;
    for (i < c.len) {
        if (c.entries[i].path == path_id) { ret R.ok[*EmbedFile, str](?c.entries[i]); }
        i = i + 1;
    }

    val gr: R.Result[R.Void, str] = grow(c);
    if (R.is_err[R.Void, str](gr)) { ret R.err[*EmbedFile, str](R.unwrap_err[R.Void, str](gr)); }

    val idx: u32 = c.len;
    var e: EmbedFile;
    e.path   = path_id;
    e.status = EMBED_OK;
    e.reason = "";
    e.bytes  = nil;
    e.len    = 0;
    c.entries[idx] = e;
    c.len = c.len + 1;
    zero_digest(?c.entries[idx]);
    ret R.ok[*EmbedFile, str](?c.entries[idx]);
}

fun grow(c: *EmbedCache) R.Result[R.Void, str] {
    if (c.len < c.cap) { ret R.ok_void[str](); }

    var new_cap: u32 = ENTRY_SEED_CAP;
    if (c.cap > 0) { new_cap = c.cap * 2; }

    if (c.entries == nil) {
        val ar: R.Result[*EmbedFile, str] = A.allocate[EmbedFile](c.alloc, new_cap::usize);
        if (R.is_err[*EmbedFile, str](ar)) { ret R.err[R.Void, str](R.unwrap_err[*EmbedFile, str](ar)); }
        c.entries = R.unwrap_ok[*EmbedFile, str](ar);
    }
    or {
        val rr: R.Result[*EmbedFile, str] = A.reallocate[EmbedFile](c.alloc, c.entries, c.cap::usize, new_cap::usize);
        if (R.is_err[*EmbedFile, str](rr)) { ret R.err[R.Void, str](R.unwrap_err[*EmbedFile, str](rr)); }
        c.entries = R.unwrap_ok[*EmbedFile, str](rr);
    }
    c.cap = new_cap;
    ret R.ok_void[str]();
}

fun free_bytes(c: *EmbedCache, e: *EmbedFile) {
    if (e.bytes != nil && e.len > 0) {
        A.deallocate[u8](c.alloc, e.bytes, e.len::usize);
    }
    e.bytes = nil;
    e.len   = 0;
}

fun zero_digest(e: *EmbedFile) {
    var i: u32 = 0;
    for (i < 32) {
        e.digest[i] = 0;
        i = i + 1;
    }
}

fun mark_too_large(c: *EmbedCache, e: *EmbedFile) {
    free_bytes(c, e);
    zero_digest(e);
    e.status = EMBED_TOO_LARGE;
    e.reason = "file exceeds the maximum embed size of 4294967295 bytes";
}

pub fun path_arg_span(a: *ast.Ast, dec: *decl.Decorator) O.Option[token.Span] {
    if (dec.args_len != 1) { ret O.none[token.Span](); }
    val opt_e: O.Option[*expr.Expr] = ast.get_expr(a, a.expr_ids[dec.args_start]);
    if (O.is_none[*expr.Expr](opt_e)) { ret O.none[token.Span](); }
    val e: *expr.Expr = O.unwrap[*expr.Expr](opt_e);
    if (e.kind != expr.EXPR_KIND_LIT_STR) { ret O.none[token.Span](); }
    if (e.span.len <= 2::usize)           { ret O.none[token.Span](); }

    var inner: token.Span = e.span;
    inner.offset = inner.offset + 1::usize;
    inner.len    = inner.len - 2::usize;
    ret O.some[token.Span](inner);
}

fun t_embed_containment_paths(refuse: bool) i32 {
    var backing: A.Allocator;
    if (O.is_some[str](page.make(?backing))) { ret 1; }
    val made: R.Result[fs.TempFile, str] = fs.temp_create(?backing, "mach_embed_containment");
    if (R.is_err[fs.TempFile, str](made)) { ret 1; }
    var temp: fs.TempFile = R.unwrap_ok[fs.TempFile, str](made);
    fin { str_free(?backing, temp.path); }
    if (O.is_some[str](fs.temp_close_and_remove(?temp))) { ret 1; }
    if (O.is_some[str](fs.create_dir(temp.path, 0o700))) { ret 1; }
    fin { fs.remove_all(?backing, temp.path); }
    val nested_r: R.Result[path.Path, str] = path.join(?backing, temp.path, "outer/inner");
    if (R.is_err[path.Path, str](nested_r)) { ret 1; }
    val nested: str = R.unwrap_ok[path.Path, str](nested_r);
    fin { str_free(?backing, nested); }
    if (O.is_some[str](fs.create_dir_all(?backing, nested, 0o700))) { ret 1; }
    val inside_r: R.Result[path.Path, str] = path.join(?backing, nested, "payload.bin");
    if (R.is_err[path.Path, str](inside_r)) { ret 1; }
    val inside: str = R.unwrap_ok[path.Path, str](inside_r);
    fin { str_free(?backing, inside); }
    val missing_r: R.Result[path.Path, str] = path.join(?backing, temp.path, "missing/nested/payload.bin");
    if (R.is_err[path.Path, str](missing_r)) { ret 1; }
    val missing: str = R.unwrap_ok[path.Path, str](missing_r);
    fin { str_free(?backing, missing); }
    val sibling_r: R.Result[str, str] = format.sprint(?backing, "{}-sibling/payload.bin", temp.path);
    if (R.is_err[str, str](sibling_r)) { ret 1; }
    val sibling: str = R.unwrap_ok[str, str](sibling_r);
    fin { str_free(?backing, sibling); }
    var paths: [4]str;
    paths[0] = temp.path;
    paths[1] = inside;
    paths[2] = missing;
    paths[3] = sibling;
    var t: T.Testing;
    if (O.is_some[str](T.make(?t))) { ret 1; }
    fin { T.dnit(?t); }
    val alloc: *A.Allocator = T.allocator_of(?t);
    var cache: EmbedCache = init(?backing);
    cache.root = temp.path;
    var i: u32 = 0;
    for (i < 4) {
        val before: usize = T.attempt_count(?t);
        val result: R.Result[bool, str] = escapes_root(alloc, ?cache, paths[i]);
        if (R.is_err[bool, str](result)) { ret 2; }
        if (R.unwrap_ok[bool, str](result) != (i == 3)) { ret 3; }
        if (T.leaked(?t) || T.double_free_count(?t) != 0 || T.tracking_exhausted(?t)) { ret 4; }
        val attempts: usize = T.attempt_count(?t) - before;
        if (attempts == 0) { ret 5; }
        if (refuse) {
            var ordinal: usize = 1;
            for (ordinal <= attempts) {
                T.fail_at_ordinal(?t, T.attempt_count(?t) + ordinal);
                val failed: R.Result[bool, str] = escapes_root(alloc, ?cache, paths[i]);
                if (R.is_ok[bool, str](failed)) { ret 6; }
                if (!str_equals(R.unwrap_err[bool, str](failed), "out of memory")) { ret 7; }
                if (T.leaked(?t) || T.double_free_count(?t) != 0 || T.tracking_exhausted(?t)) { ret 8; }
                ordinal = ordinal + 1;
            }
            T.fail_at_ordinal(?t, 0);
        }
        i = i + 1;
    }
    ret 0;
}

test "mach.lang.embed.containment:nested_and_missing_parents_are_distinct_from_escape" {
    ret t_embed_containment_paths(false);
}

test "mach.lang.embed.containment:allocation_refusal_never_becomes_a_containment_answer" {
    ret t_embed_containment_paths(true);
}

test "mach.lang.embed.containment:root_open_failure_is_not_a_missing_parent" {
    var backing: A.Allocator;
    if (O.is_some[str](page.make(?backing))) { ret 1; }
    val made: R.Result[fs.TempFile, str] = fs.temp_create(?backing, "mach_embed_obstruction");
    if (R.is_err[fs.TempFile, str](made)) { ret 1; }
    var temp: fs.TempFile = R.unwrap_ok[fs.TempFile, str](made);
    fin { fs.temp_close_and_remove(?temp); str_free(?backing, temp.path); }
    val child_r: R.Result[path.Path, str] = path.join(?backing, temp.path, "child/payload.bin");
    if (R.is_err[path.Path, str](child_r)) { ret 1; }
    val child: str = R.unwrap_ok[path.Path, str](child_r);
    fin { str_free(?backing, child); }
    var t: T.Testing;
    if (O.is_some[str](T.make(?t))) { ret 1; }
    fin { T.dnit(?t); }
    var cache: EmbedCache = init(?backing);
    cache.root = temp.path;
    val result: R.Result[bool, str] = escapes_root(T.allocator_of(?t), ?cache, child);
    if (R.is_ok[bool, str](result)) { ret 2; }
    if (str_empty(R.unwrap_err[bool, str](result))) { ret 3; }
    if (T.leaked(?t) || T.double_free_count(?t) != 0 || T.tracking_exhausted(?t)) { ret 4; }
    ret 0;
}

test "mach.lang.embed.containment:filesystem_root_is_a_parent_without_an_extra_separator" {
    var backing: A.Allocator;
    if (O.is_some[str](page.make(?backing))) { ret 1; }
    var cache: EmbedCache = init(?backing);
    cache.root = "/";
    val result: R.Result[bool, str] = escapes_root(?backing, ?cache,
        "/mach_embed_containment_missing_parent_3209/payload.bin");
    if (R.is_err[bool, str](result)) { ret 2; }
    if (R.unwrap_ok[bool, str](result)) { ret 3; }
    ret 0;
}
