# the compile-time file-embedding store: resolved paths, their content, and the
# build-input fingerprint each one contributes
#
# An `#[embed("path")]` declaration sources a constant's bytes from a file at
# compile time. The path resolves against the declaring source file's directory,
# and the content is read once per build into this cache: sema reads its length
# to size the declared array and the middle end reads its bytes to initialize the
# global, so the two can never disagree about what was embedded.
#
# The cache is also where an embedded file becomes a build input. Every refresh
# writes the file's status and content digest into the Q_EMBED_FILE input keyed
# by the resolved path, so `set_input`'s byte-equality cutoff leaves an untouched
# asset's revision alone (the module reusing its cached sema) and an edited one
# advances it (invalidating every module that embedded it). A file that fails to
# read still writes a status, so an asset that appears or disappears invalidates
# exactly like one whose bytes changed.
#
# Sits below the frontend and the middle end - both read it, neither owns it -
# and depends on no compiler module other than the interner and the query db.

use std.collections.vector;
use std.collections.vector.Vector;
use std.crypto.hash.sha256;
use fs: std.filesystem;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;
use O: std.types.option;
use R: std.types.result;
use path: std.types.path;

use mach.lang.intern;
use mach.lang.query;

# why a refresh could not deliver the file's bytes
pub def EmbedStatus: u8;

pub val EMBED_OK:       EmbedStatus = 0;
pub val EMBED_MISSING:  EmbedStatus = 1;
pub val EMBED_IS_DIR:   EmbedStatus = 2;
pub val EMBED_UNREADABLE: EmbedStatus = 3;

# one embedded file's cached content and fingerprint
#
# `bytes` is owned by the cache and replaced wholesale on a content change; a
# non-OK `status` leaves it nil with a zero `len`, so a consumer that ignored the
# status would embed nothing rather than stale bytes.
# ---
# path:   the resolved absolute-or-relative path, interned
# status: EMBED_OK, or why the read failed
# reason: the OS message behind a non-OK status (borrowed static text)
# bytes:  the file's content, owned by the cache (nil unless status is OK)
# len:    number of content bytes
# digest: sha256 of the content (all zero unless status is OK)
pub rec EmbedFile {
    path:   intern.StrId;
    status: EmbedStatus;
    reason: str;
    bytes:  *u8;
    len:    u32;
    digest: [32]u8;
}

# the per-session store of every file an `#[embed]` in this build referenced
# ---
# alloc:   allocator owning the entry array and every entry's bytes
# entries: first-seen-ordered array of cached files
# len:     number of live entries
# cap:     allocated capacity of the entry array
pub rec EmbedCache {
    alloc:   *A.Allocator;
    entries: *EmbedFile;
    len:     u32;
    cap:     u32;
}

# seed capacity of the entry array, doubled on demand from there
val ENTRY_SEED_CAP: u32 = 8;

# the length prefix plus digest a Q_EMBED_FILE input value carries
val INPUT_LEN: u32 = 33;

# construct an empty cache backed by the given allocator
# ---
# alloc: allocator used for the entry array and every entry's content buffer
# ret:   a new empty cache
pub fun init(alloc: *A.Allocator) EmbedCache {
    var c: EmbedCache;
    c.alloc   = alloc;
    c.entries = nil;
    c.len     = 0;
    c.cap     = 0;
    ret c;
}

# release every cached content buffer and the entry array itself
# ---
# c: the cache to tear down
pub fun dnit(c: *EmbedCache) {
    if (c.entries == nil || c.cap == 0) {
        c.entries = nil;
        c.len     = 0;
        c.cap     = 0;
        ret;
    }
    var i: u32 = 0;
    for (i < c.len) {
        free_bytes(c, ?c.entries[i]);
        i = i + 1;
    }
    A.deallocate[EmbedFile](c.alloc, c.entries, c.cap::usize);
    c.entries = nil;
    c.len     = 0;
    c.cap     = 0;
}

# the cached entry for `path_id`, or none when this build never refreshed it
# ---
# c:       the cache
# path_id: the interned resolved path
# ret:     some(*EmbedFile) into the entry array (invalidated by a later refresh
#          that grows it), or none
pub fun get(c: *EmbedCache, path_id: intern.StrId) O.Option[*EmbedFile] {
    var i: u32 = 0;
    for (i < c.len) {
        if (c.entries[i].path == path_id) { ret O.some[*EmbedFile](?c.entries[i]); }
        i = i + 1;
    }
    ret O.none[*EmbedFile]();
}

# resolve `arg` against the directory holding `decl_file`, yielding the path an
# `#[embed]` on a declaration in that file names
#
# The path is file-relative, so a module reads its own assets by the same
# spelling wherever the project is checked out. An absolute `arg` is taken as
# written (path.resolve keeps it), which is what a generated or vendored asset
# under a manifest-expanded path needs.
# ---
# alloc:     allocator for the returned owned path
# decl_file: on-disk path of the source file carrying the declaration
# arg:       the decorator's path argument, escapes already decoded
# ret:       the owned resolved path, or an allocation error
pub fun resolve_path(alloc: *A.Allocator, decl_file: str, arg: str) R.Result[str, str] {
    val pr: R.Result[path.Path, str] = path.parent(alloc, decl_file);
    if (R.is_err[path.Path, str](pr)) { ret R.err[str, str](R.unwrap_err[path.Path, str](pr)); }
    val dir: path.Path = R.unwrap_ok[path.Path, str](pr);

    val jr: R.Result[path.Path, str] = path.resolve(alloc, dir, arg);
    str_free(alloc, dir);
    if (R.is_err[path.Path, str](jr)) { ret R.err[str, str](R.unwrap_err[path.Path, str](jr)); }
    ret R.ok[str, str](R.unwrap_ok[path.Path, str](jr));
}

# re-read the file at `p` into the cache and publish its Q_EMBED_FILE input
#
# Called once per build for every path an `#[embed]` names, before the phases
# that consume it, so the input is current when a cached sema entry revalidates
# against it. Reading unconditionally is what makes an asset edit visible: a
# module whose sema was reused never runs the code that would notice the file, so
# the refresh cannot be deferred to the consumer.
#
# A read failure is recorded on the entry rather than returned - the frontend
# reports it against the declaration that named the path, which this layer cannot
# see. Only an allocation or query failure is an error here.
# ---
# c:   the cache
# db:  the query db the Q_EMBED_FILE input is published into
# itn: the interner owning the resolved path
# p:   the resolved path to read
# ret: the interned path id keying the entry, or an allocation error
pub fun refresh(c: *EmbedCache, db: *query.QueryDb, itn: *intern.Interner, p: str) R.Result[intern.StrId, str] {
    val ir: R.Result[intern.StrId, str] = intern.intern(itn, p);
    if (R.is_err[intern.StrId, str](ir)) { ret ir; }
    val path_id: intern.StrId = R.unwrap_ok[intern.StrId, str](ir);

    val er: R.Result[*EmbedFile, str] = entry_for(c, path_id);
    if (R.is_err[*EmbedFile, str](er)) { ret R.err[intern.StrId, str](R.unwrap_err[*EmbedFile, str](er)); }
    val e: *EmbedFile = R.unwrap_ok[*EmbedFile, str](er);

    val rr: R.Result[bool, str] = read_into(c, e, p);
    if (R.is_err[bool, str](rr)) { ret R.err[intern.StrId, str](R.unwrap_err[bool, str](rr)); }

    val pr: R.Result[bool, str] = publish(db, e);
    if (R.is_err[bool, str](pr)) { ret R.err[intern.StrId, str](R.unwrap_err[bool, str](pr)); }
    ret R.ok[intern.StrId, str](path_id);
}

# read `p` into entry `e`, classifying a failure rather than propagating it
#
# The directory case is separated from a bare open failure because it is the one
# a caller most often reaches by naming an asset folder, and "is a directory"
# tells them so where a generic read error would not.
# ---
# c:   the cache owning `e`'s buffer
# e:   the entry to fill
# p:   the path to read
# ret: true once the entry reflects the read, or an allocation error
fun read_into(c: *EmbedCache, e: *EmbedFile, p: str) R.Result[bool, str] {
    free_bytes(c, e);
    e.status = EMBED_OK;
    e.reason = "";
    zero_digest(e);

    if (fs.is_dir(p)) {
        e.status = EMBED_IS_DIR;
        e.reason = "is a directory";
        ret R.ok[bool, str](true);
    }
    if (!fs.exists(p)) {
        e.status = EMBED_MISSING;
        e.reason = "no such file or directory";
        ret R.ok[bool, str](true);
    }

    val rr: R.Result[Vector[u8], str] = fs.read_bytes(c.alloc, p);
    if (R.is_err[Vector[u8], str](rr)) {
        e.status = EMBED_UNREADABLE;
        e.reason = R.unwrap_err[Vector[u8], str](rr);
        ret R.ok[bool, str](true);
    }
    var buf: Vector[u8] = R.unwrap_ok[Vector[u8], str](rr);

    # the vector's storage is capacity-sized and freed by its own dnit, so the
    # content is copied into an exactly-sized cache-owned buffer rather than
    # adopted; an empty file keeps a nil buffer with a zero length.
    if (buf.len > 0) {
        val ar: R.Result[*u8, str] = A.allocate[u8](c.alloc, buf.len);
        if (R.is_err[*u8, str](ar)) {
            vector.dnit[u8](?buf);
            ret R.err[bool, str](R.unwrap_err[*u8, str](ar));
        }
        e.bytes = R.unwrap_ok[*u8, str](ar);
        e.len   = buf.len::u32;
        var i: usize = 0;
        for (i < buf.len) {
            e.bytes[i] = buf.data[i];
            i = i + 1;
        }
        sha256.hash(e.bytes, e.len::usize, ?e.digest[0]);
    }
    or {
        sha256.hash(nil, 0::usize, ?e.digest[0]);
    }
    vector.dnit[u8](?buf);
    ret R.ok[bool, str](true);
}

# write entry `e`'s status and digest into its Q_EMBED_FILE input
#
# Status leads the value so a file that changes from unreadable to readable moves
# the input even if the digest of the empty read matched.
# ---
# db: the query db
# e:  the entry to publish
# ret: true on success, or the query db's error
fun publish(db: *query.QueryDb, e: *EmbedFile) R.Result[bool, str] {
    var value: [33]u8;
    value[0] = e.status;
    var i: u32 = 0;
    for (i < 32) {
        value[i + 1] = e.digest[i];
        i = i + 1;
    }
    ret query.set_input(db, query.Q_EMBED_FILE, e.path::u64, ?value[0], INPUT_LEN);
}

# the entry for `path_id`, appending a fresh one when this is its first refresh
# ---
# c:       the cache
# path_id: the interned resolved path
# ret:     the entry, or an allocation error
fun entry_for(c: *EmbedCache, path_id: intern.StrId) R.Result[*EmbedFile, str] {
    var i: u32 = 0;
    for (i < c.len) {
        if (c.entries[i].path == path_id) { ret R.ok[*EmbedFile, str](?c.entries[i]); }
        i = i + 1;
    }

    val gr: R.Result[bool, str] = grow(c);
    if (R.is_err[bool, str](gr)) { ret R.err[*EmbedFile, str](R.unwrap_err[bool, str](gr)); }

    val idx: u32 = c.len;
    var e: EmbedFile;
    e.path   = path_id;
    e.status = EMBED_OK;
    e.reason = "";
    e.bytes  = nil;
    e.len    = 0;
    c.entries[idx] = e;
    c.len = c.len + 1;
    zero_digest(?c.entries[idx]);
    ret R.ok[*EmbedFile, str](?c.entries[idx]);
}

# ensure the entry array has room for one more, doubling from the seed capacity
# ---
# c:   the cache
# ret: true once there is room, or an allocation error
fun grow(c: *EmbedCache) R.Result[bool, str] {
    if (c.len < c.cap) { ret R.ok[bool, str](true); }

    var new_cap: u32 = ENTRY_SEED_CAP;
    if (c.cap > 0) { new_cap = c.cap * 2; }

    if (c.entries == nil) {
        val ar: R.Result[*EmbedFile, str] = A.allocate[EmbedFile](c.alloc, new_cap::usize);
        if (R.is_err[*EmbedFile, str](ar)) { ret R.err[bool, str](R.unwrap_err[*EmbedFile, str](ar)); }
        c.entries = R.unwrap_ok[*EmbedFile, str](ar);
    }
    or {
        val rr: R.Result[*EmbedFile, str] = A.reallocate[EmbedFile](c.alloc, c.entries, c.cap::usize, new_cap::usize);
        if (R.is_err[*EmbedFile, str](rr)) { ret R.err[bool, str](R.unwrap_err[*EmbedFile, str](rr)); }
        c.entries = R.unwrap_ok[*EmbedFile, str](rr);
    }
    c.cap = new_cap;
    ret R.ok[bool, str](true);
}

# release entry `e`'s content buffer, leaving it empty
fun free_bytes(c: *EmbedCache, e: *EmbedFile) {
    if (e.bytes != nil && e.len > 0) {
        A.deallocate[u8](c.alloc, e.bytes, e.len::usize);
    }
    e.bytes = nil;
    e.len   = 0;
}

# clear entry `e`'s digest
fun zero_digest(e: *EmbedFile) {
    var i: u32 = 0;
    for (i < 32) {
        e.digest[i] = 0;
        i = i + 1;
    }
}

# whether two cached entries hold byte-identical content
#
# Compared by digest and length: the dedup decision the back end makes when it
# places embedded data, where a full compare of two multi-megabyte assets would
# cost more than the placement it saves.
# ---
# a:   one entry
# b:   the other
# ret: true when both read successfully and hold the same bytes
pub fun same_content(a: *EmbedFile, b: *EmbedFile) bool {
    if (a.status != EMBED_OK || b.status != EMBED_OK) { ret false; }
    if (a.len != b.len) { ret false; }
    var i: u32 = 0;
    for (i < 32) {
        if (a.digest[i] != b.digest[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}
