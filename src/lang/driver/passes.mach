pub fun read_definition(raw: ptr, mid: session.ModuleId, phase: scx.DefinitionPhase) res[scx.Definition, fail.Fail] {
    val p:      *project.Project                         = raw::*project.Project;
    val parsed: res[resolve.ParsedDefinition, fail.Fail] = load.parsed_definition(raw, mid);
    if (sel parsed.err) { ret res[scx.Definition, fail.Fail].err{parsed.err}; }
    var result: scx.Definition = scx.Definition{parsed: parsed.ok, origin: mid};
    if (phase >= scx.DEFINITION_RESOLVED) {
        val viewed: err[fail.Fail] = depend_load_view(p, project.module_at(p, mid::u32));
        if (sel viewed.err) { ret res[scx.Definition, fail.Fail].err{viewed.err}; }
        val acquired: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, query.Q_RESOLVE, project.module_at(p, mid::u32).stable_id::u64);
        if (sel acquired.err) { ret res[scx.Definition, fail.Fail].err{acquired.err}; }
        result.rr = dq.resolve_handle_decode(acquired.ok);
        if (result.rr == nil) { ret res[scx.Definition, fail.Fail].err{fail.message("current definition has no resolved query owner")}; }
        resolve.remap_result(result.rr, p.s);
        project.module_at(p, mid::u32).resolve_result = result.rr;
    }
    if (phase == scx.DEFINITION_TYPED) {
        val acquired: res[*sema.SemaResult, fail.Fail] = acquire_sema(p, mid);
        if (sel acquired.err) { ret res[scx.Definition, fail.Fail].err{acquired.err}; }
        result.sr  = acquired.ok;
        result.ctx = ?project.module_at(p, mid::u32).ctx;
    }
    ret res[scx.Definition, fail.Fail].ok{result};
}

pub fun prepare_resolve_pass(p: *project.Project) err[fail.Fail] {
    if (!query.is_registered(?p.s.queries, query.Q_RESOLVE)) {
        val rr: err[fail.Fail] = query.register_derived_owned(?p.s.queries, query.Q_RESOLVE, q_resolve_finalize);
        if (sel rr.err) { ret rr; }
    }
    if (!query.is_registered(?p.s.queries, query.Q_EXPORTS)) {
        val re: err[fail.Fail] = query.register_derived(?p.s.queries, query.Q_EXPORTS);
        if (sel re.err) { ret re; }
    }
    if (!query.is_registered(?p.s.queries, query.Q_LOAD_VIEW)) {
        val rv: err[fail.Fail] = query.register_input(?p.s.queries, query.Q_LOAD_VIEW);
        if (sel rv.err) { ret rv; }
    }
    ret record_load_views(p);
}

# a rejected module is one module's answer, so the pass folds it and carries
# on over the rest; an internal failure ends the pass where it met it
pub fun run_resolve_pass(p: *project.Project) err[fail.Fail] {
    var rejected: bool = false;
    var i:        u32  = 0;
    for (i < p.topo_len) {
        val mid: session.ModuleId = p.topo[i];
        val r:   err[fail.Fail]   = run_resolve_one(p, mid);
        if (sel r.err) {
            if (!fail.is_reported(r.err)) { ret r; }
            rejected = true;
        }
        i = i + 1;
    }
    if (rejected) { ret err[fail.Fail].err{fail.reported()}; }
    ret err[fail.Fail].ok{};
}

fun run_resolve_one(p: *project.Project, mid: session.ModuleId) err[fail.Fail] {
    val m: *project.ModuleEntry = project.module_at(p, mid::u32);

    val t_item: readout.Instant = readout.item_begin(p.events);

    val e_r: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, query.Q_RESOLVE, m.stable_id::u64);
    if (sel e_r.err) { ret err[fail.Fail].err{e_r.err}; }
    val rr: *resolve.ResolveResult = dq.resolve_handle_decode(e_r.ok);
    if (rr == nil) { ret err[fail.Fail].err{fail.message("Q_RESOLVE produced no result handle")}; }

    # the product is on the entry before the export query can reject it, so a
    # module that resolved with errors still exposes what it resolved
    resolve.remap_result(rr, p.s);
    m.resolve_result = rr;

    val ex_r: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, query.Q_EXPORTS, m.stable_id::u64);
    if (sel ex_r.err) { ret err[fail.Fail].err{ex_r.err}; }

    m.resolved = true;
    if (p.events != nil) { m.resolve_elapsed = m.resolve_elapsed + readout.elapsed(t_item); }
    ret err[fail.Fail].ok{};
}

pub fun q_resolve_compute(p: *project.Project, key: u64, alloc: *A.Allocator, diags: *diagnostic.DiagnosticStore) res[query.QueryOutput, fail.Fail] {
    val db: *query.QueryDb   = ?p.s.queries;
    val s:  *session.Session = p.s;

    val stable: session.StableModuleId = key::u32::session.StableModuleId;
    val mid:    session.ModuleId       = session.module_id_for_stable(s, stable);
    if (mid == session.MODULE_NIL) { ret res[query.QueryOutput, fail.Fail].err{fail.message("Q_RESOLVE: stable id not loaded this build")}; }
    val m:      *project.ModuleEntry                     = project.module_at(p, mid::u32);
    val parsed: res[resolve.ParsedDefinition, fail.Fail] = load.parsed_definition(p::ptr, mid);
    if (sel parsed.err) { ret res[query.QueryOutput, fail.Fail].err{parsed.err}; }
    val a:  *ast.Ast       = parsed.ok.a;
    val rt: err[fail.Fail] = query.depend[project.Project](?p.queries, p, query.Q_TARGET, 0);
    if (sel rt.err) { ret res[query.QueryOutput, fail.Fail].err{rt.err}; }
    val rv: err[fail.Fail] = depend_load_view(p, m);
    if (sel rv.err) { ret res[query.QueryOutput, fail.Fail].err{rv.err}; }

    val deps_r: res[resolve.ResolveDeps, fail.Fail] = build_resolve_deps_owned(p, m);
    if (sel deps_r.err) { ret res[query.QueryOutput, fail.Fail].err{deps_r.err}; }
    var deps: resolve.ResolveDeps = deps_r.ok;

    var di: u32 = 0;
    for (di < deps.count) {
        val dep_mid: session.ModuleId = deps.entries[di].module;
        if (dep_mid::u32 < project.module_count(p)) {
            val ge: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, query.Q_EXPORTS, project.module_at(p, dep_mid::u32).stable_id::u64);
            if (sel ge.err) {
                free_resolve_deps(s.alloc, ?deps);
                ret res[query.QueryOutput, fail.Fail].err{ge.err};
            }
        }
        di = di + 1;
    }

    val rr_r: res[resolve.ResolveResult, fail.Fail] = resolve.resolve(s, a, ?deps, ?m.ctx, mid, diags);
    free_resolve_deps(s.alloc, ?deps);
    if (sel rr_r.err) { ret res[query.QueryOutput, fail.Fail].err{rr_r.err}; }
    var result: resolve.ResolveResult = rr_r.ok;

    val br: res[*resolve.ResolveResult, A.Error] = A.allocate[resolve.ResolveResult](alloc, 1::usize);
    if (sel br.err) {
        resolve.dnit_result(?result);
        ret res[query.QueryOutput, fail.Fail].err{fail.refused(br.err)};
    }
    val box: *resolve.ResolveResult = br.ok;
    box[0] = result;
    ret dq.resolve_handle_encode(alloc, box);
}

pub fun q_resolve_finalize(value: *u8, value_len: u32, alloc: *A.Allocator) {
    if (value == nil || value_len::usize < $size_of(ptr)) { ret; }
    val slot: *ptr                   = value::ptr::*ptr;
    val r:    *resolve.ResolveResult = slot[0]::*resolve.ResolveResult;
    if (r == nil) { ret; }
    resolve.dnit_result(r);
    A.deallocate[resolve.ResolveResult](alloc, r, 1::usize);
}

fun build_resolve_deps_owned(p: *project.Project, m: *project.ModuleEntry) res[resolve.ResolveDeps, fail.Fail] {
    var deps: resolve.ResolveDeps;
    deps.entries = nil;
    deps.count   = 0;
    if (m.dep_count == 0) { ret res[resolve.ResolveDeps, fail.Fail].ok{deps}; }

    val lr: res[*session.ModuleId, A.Error] = A.allocate[session.ModuleId](p.s.alloc, project.module_count(p)::usize);
    if (sel lr.err) {
        ret res[resolve.ResolveDeps, fail.Fail].err{fail.refused(lr.err)};
    }
    val list: *session.ModuleId = lr.ok;

    val r: res[resolve.ResolveDeps, fail.Fail] = build_resolve_deps(p, m, list);
    A.deallocate[session.ModuleId](p.s.alloc, list, project.module_count(p)::usize);
    ret r;
}

fun resolve_list_contains(list: *session.ModuleId, list_len: u32, id: session.ModuleId) bool {
    var i: u32 = 0;
    for (i < list_len) {
        if (list[i] == id) { ret true; }
        i = i + 1;
    }
    ret false;
}

pub fun prepare_sema_pass(p: *project.Project) err[outcome.Fail] {
    if (!query.is_registered(?p.s.queries, query.Q_SEMA)) {
        val rsm: err[fail.Fail] = query.register_derived_owned(?p.s.queries, query.Q_SEMA, q_sema_finalize);
        if (sel rsm.err) { ret err[outcome.Fail].err{outcome.from_fail(rsm.err)}; }
    }
    if (!query.is_registered(?p.s.queries, query.Q_TYPED_EXPORTS)) {
        val rte: err[fail.Fail] = query.register_derived(?p.s.queries, query.Q_TYPED_EXPORTS);
        if (sel rte.err) { ret err[outcome.Fail].err{outcome.from_fail(rte.err)}; }
    }

    ret err[outcome.Fail].ok{};
}

# a rejected module is one module's answer, so the pass folds it and carries
# on over the rest; an internal failure ends the pass where it met it
pub fun run_sema_pass(p: *project.Project) err[outcome.Fail] {
    readout.phase_begin(p.events, readout.PH_SEMA);
    var rejected: bool = false;
    var i:        u32  = 0;
    for (i < p.topo_len) {
        val mid: session.ModuleId = p.topo[i];

        val r: err[fail.Fail] = run_sema_one(p, mid);
        if (sel r.err) {
            if (!fail.is_reported(r.err)) { ret err[outcome.Fail].err{outcome.from_fail(r.err)}; }
            rejected = true;
        }
        i = i + 1;
    }
    readout.phase_end(p.events, readout.PH_SEMA, p.topo_len, "module", "modules");
    if (rejected) { ret err[outcome.Fail].err{outcome.reported()}; }
    ret err[outcome.Fail].ok{};
}

pub fun acquire_sema(p: *project.Project, mid: session.ModuleId) res[*sema.SemaResult, fail.Fail] {
    if (mid == session.MODULE_NIL || mid::u32 >= project.module_count(p)) {
        ret res[*sema.SemaResult, fail.Fail].err{fail.message("semantic definition module is not in the active project")};
    }
    val stable:   session.StableModuleId          = project.module_at(p, mid::u32).stable_id;
    val acquired: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, query.Q_SEMA, stable::u64);
    if (sel acquired.err) { ret res[*sema.SemaResult, fail.Fail].err{acquired.err}; }
    val result: *sema.SemaResult = sema_handle_decode(acquired.ok);
    if (result == nil) { ret res[*sema.SemaResult, fail.Fail].err{fail.message("semantic query produced no result owner")}; }
    val installed: err[fail.Fail] = fields.install(p.s, ?result.field_graph);
    if (sel installed.err) { ret res[*sema.SemaResult, fail.Fail].err{installed.err}; }
    project.module_at(p, mid::u32).sema_result = result;
    ret res[*sema.SemaResult, fail.Fail].ok{result};
}

fun run_sema_one(p: *project.Project, mid: session.ModuleId) err[fail.Fail] {
    val m: *project.ModuleEntry = project.module_at(p, mid::u32);

    val t_item: readout.Instant = readout.item_begin(p.events);

    val acquired: res[scx.Definition, fail.Fail] = read_definition(p::ptr, mid, scx.DEFINITION_TYPED);
    if (sel acquired.err) { ret err[fail.Fail].err{acquired.err}; }
    val current: scx.Definition   = acquired.ok;
    val sr:      *sema.SemaResult = current.sr;

    # acquire_sema put the product on the entry; it is registered with the
    # session before the typed export query can reject it, so a module that
    # typed with errors still exposes what it typed
    val rp: err[fail.Fail] = session.register_module_phase(p.s, mid, sr::ptr,
        current.rr::ptr, current.ctx::ptr);
    if (sel rp.err) { ret rp; }

    val tx_r: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, query.Q_TYPED_EXPORTS, m.stable_id::u64);
    if (sel tx_r.err) { ret err[fail.Fail].err{tx_r.err}; }

    readout.item(p.events, readout.PH_SEMA, project.fqn_name(p, m.fqn), t_item);
    ret err[fail.Fail].ok{};
}

pub fun q_sema_compute(p: *project.Project, key: u64, alloc: *A.Allocator, diags: *diagnostic.DiagnosticStore) res[query.QueryOutput, fail.Fail] {
    val db: *query.QueryDb   = ?p.s.queries;
    val s:  *session.Session = p.s;

    val stable: session.StableModuleId = key::u32::session.StableModuleId;
    val mid:    session.ModuleId       = session.module_id_for_stable(s, stable);
    if (mid == session.MODULE_NIL) { ret res[query.QueryOutput, fail.Fail].err{fail.message("Q_SEMA: stable id not loaded this build")}; }
    val m:      *project.ModuleEntry                     = project.module_at(p, mid::u32);
    val parsed: res[resolve.ParsedDefinition, fail.Fail] = load.parsed_definition(p::ptr, mid);
    if (sel parsed.err) { ret res[query.QueryOutput, fail.Fail].err{parsed.err}; }
    val definition: resolve.ParsedDefinition = parsed.ok;
    if (sel definition.status.kind.internal) { ret res[query.QueryOutput, fail.Fail].err{fail.phase_failure(definition.status)}; }
    val a:      *ast.Ast       = definition.a;
    val viewed: err[fail.Fail] = depend_load_view(p, m);
    if (sel viewed.err) { ret res[query.QueryOutput, fail.Fail].err{viewed.err}; }
    val resolved: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, query.Q_RESOLVE, m.stable_id::u64);
    if (sel resolved.err) { ret res[query.QueryOutput, fail.Fail].err{resolved.err}; }
    val rr: *resolve.ResolveResult = dq.resolve_handle_decode(resolved.ok);
    if (rr == nil) { ret res[query.QueryOutput, fail.Fail].err{fail.message("Q_SEMA: acquired query has no resolve result")}; }
    m.resolve_result = rr;
    val rt: err[fail.Fail] = query.depend[project.Project](?p.queries, p, query.Q_TARGET, 0);
    if (sel rt.err) { ret res[query.QueryOutput, fail.Fail].err{rt.err}; }
    val rn: err[fail.Fail] = query.depend[project.Project](?p.queries, p, query.Q_MODULE_NUMBER, key);
    if (sel rn.err) { ret res[query.QueryOutput, fail.Fail].err{rn.err}; }

    val sdeps_r: res[sema.SemaDeps, fail.Fail] = build_sema_deps_query(p, m);
    if (sel sdeps_r.err) { ret res[query.QueryOutput, fail.Fail].err{sdeps_r.err}; }
    var sdeps: sema.SemaDeps = sdeps_r.ok;

    val sem_r: res[sema.SemaResult, fail.Fail] = sema.sema(s, a, rr, ?sdeps, ?m.ctx, mid, diags);
    free_sema_deps_query(s.alloc, ?sdeps);
    if (sel sem_r.err) { ret res[query.QueryOutput, fail.Fail].err{sem_r.err}; }
    var result: sema.SemaResult = sem_r.ok;
    # a rejected parse still types, as the recovered tree is for, and the
    # product carries the parse rejection so the module stays rejected
    fail.merge(?result.status, definition.status);

    var ei: u32 = 0;
    for (ei < result.embed_path_count) {
        val re: err[fail.Fail] = query.depend[project.Project](?p.queries, p, query.Q_EMBED_FILE, result.embed_paths[ei]::u64);
        if (sel re.err) {
            sema.dnit_result(?result);
            ret res[query.QueryOutput, fail.Fail].err{re.err};
        }
        ei = ei + 1;
    }

    val br: res[*sema.SemaResult, A.Error] = A.allocate[sema.SemaResult](alloc, 1::usize);
    if (sel br.err) {
        sema.dnit_result(?result);
        ret res[query.QueryOutput, fail.Fail].err{fail.refused(br.err)};
    }
    val box: *sema.SemaResult = br.ok;
    box[0] = result;
    ret sema_handle_encode(alloc, box);
}

pub fun q_sema_finalize(value: *u8, value_len: u32, alloc: *A.Allocator) {
    if (value == nil || value_len::usize < $size_of(ptr)) { ret; }
    val slot: *ptr             = value::ptr::*ptr;
    val r:    *sema.SemaResult = slot[0]::*sema.SemaResult;
    if (r == nil) { ret; }
    sema.dnit_result(r);
    A.deallocate[sema.SemaResult](alloc, r, 1::usize);
}

fun sema_handle_encode(alloc: *A.Allocator, r: *sema.SemaResult) res[query.QueryOutput, fail.Fail] {
    val n:  u32               = $size_of(ptr)::u32;
    val rb: res[*u8, A.Error] = A.allocate[u8](alloc, n::usize);
    if (sel rb.err) {
        sema.dnit_result(r);
        A.deallocate[sema.SemaResult](alloc, r, 1::usize);
        ret res[query.QueryOutput, fail.Fail].err{fail.refused(rb.err)};
    }
    val buf:  *u8  = rb.ok;
    val slot: *ptr = buf::ptr::*ptr;
    slot[0] = r::ptr;
    var out: query.QueryOutput;
    out.bytes = buf;
    out.len   = n;
    ret res[query.QueryOutput, fail.Fail].ok{out};
}

fun sema_handle_decode(e: query.QueryView) *sema.SemaResult {
    if (e.value == nil || e.value_len::usize < $size_of(ptr)) { ret nil; }
    val slot: *ptr = e.value::ptr::*ptr;
    ret slot[0]::*sema.SemaResult;
}

fun build_sema_deps_query(p: *project.Project, m: *project.ModuleEntry) res[sema.SemaDeps, fail.Fail] {
    var deps: sema.SemaDeps = sema.SemaDeps{};
    deps.definitions = scx.reader_init(p::ptr, read_definition, p.s.alloc);
    val closure: res[LowerClosure, fail.Fail] = collect_lower_closure(p, m);
    if (sel closure.err) { ret res[sema.SemaDeps, fail.Fail].err{closure.err}; }
    var imports: LowerClosure = closure.ok;
    fin { free_lower_closure(p.s.alloc, ?imports); }
    if (imports.count == 0) { ret res[sema.SemaDeps, fail.Fail].ok{deps}; }
    val allocated: res[**sema.ModuleSema, A.Error] = A.allocate[*sema.ModuleSema](p.s.alloc, imports.count::usize);
    if (sel allocated.err) { ret res[sema.SemaDeps, fail.Fail].err{fail.refused(allocated.err)}; }
    deps.entries = allocated.ok;
    deps.count   = imports.count;
    var i: u32 = 0;
    for (i < imports.count) {
        val shared: res[*sema.ModuleSema, fail.Fail] = typed_surface_of(p, imports.list[i]);
        if (sel shared.err) {
            free_sema_deps_query(p.s.alloc, ?deps);
            ret res[sema.SemaDeps, fail.Fail].err{shared.err};
        }
        deps.entries[i] = shared.ok;
        i               = i + 1;
    }
    ret res[sema.SemaDeps, fail.Fail].ok{deps};
}

# the surfaces are the project's, so only the borrowing array is released
fun free_sema_deps_query(alloc: *A.Allocator, deps: *sema.SemaDeps) {
    scx.reader_dnit(?deps.definitions);
    if (deps.entries != nil) { A.deallocate[*sema.ModuleSema](alloc, deps.entries, deps.count::usize); }
    deps.entries = nil;
    deps.count   = 0;
}

# one decoded surface per module and typed-exports revision, shared by every importer
fun typed_surface_of(p: *project.Project, mid: session.ModuleId) res[*sema.ModuleSema, fail.Fail] {
    if (mid == session.MODULE_NIL || mid::u32 >= project.module_count(p)) { ret res[*sema.ModuleSema, fail.Fail].err{fail.message("typed surface module is not loaded")}; }
    val m:        *project.ModuleEntry            = project.module_at(p, mid::u32);
    val acquired: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p,
        query.Q_TYPED_EXPORTS, m.stable_id::u64);
    if (sel acquired.err) { ret res[*sema.ModuleSema, fail.Fail].err{acquired.err}; }
    val view: query.QueryView = acquired.ok;
    if (m.typed_surface != nil && m.typed_surface_rev == view.last_changed) {
        ret res[*sema.ModuleSema, fail.Fail].ok{m.typed_surface};
    }
    val decoded: res[scx.ModuleSema, fail.Fail] = surface_from_view(p, mid, view, p.alloc);
    if (sel decoded.err) { ret res[*sema.ModuleSema, fail.Fail].err{decoded.err}; }
    val boxed: res[*sema.ModuleSema, fail.Fail] = box_surface(p, decoded.ok);
    if (sel boxed.err) { ret boxed; }
    project.drop_surface(p.alloc, ?m.typed_surface);
    m.typed_surface     = boxed.ok;
    m.typed_surface_rev = view.last_changed;
    ret boxed;
}

fun box_surface(p: *project.Project, surface: scx.ModuleSema) res[*sema.ModuleSema, fail.Fail] {
    var owned: scx.ModuleSema                 = surface;
    val ar:    res[*sema.ModuleSema, A.Error] = A.allocate[sema.ModuleSema](p.alloc, 1::usize);
    if (sel ar.err) {
        scx.module_sema_dnit(?owned);
        ret res[*sema.ModuleSema, fail.Fail].err{fail.refused(ar.err)};
    }
    ar.ok[0] = owned;
    ret res[*sema.ModuleSema, fail.Fail].ok{ar.ok};
}

pub fun read_typed_surface(p: *project.Project, mid: session.ModuleId, a: *A.Allocator) res[scx.ModuleSema, fail.Fail] {
    if (mid == session.MODULE_NIL || mid::u32 >= project.module_count(p)) { ret res[scx.ModuleSema, fail.Fail].err{fail.message("typed surface module is not loaded")}; }
    val acquired: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p,
        query.Q_TYPED_EXPORTS, project.module_at(p, mid::u32).stable_id::u64);
    if (sel acquired.err) { ret res[scx.ModuleSema, fail.Fail].err{acquired.err}; }
    ret surface_from_view(p, mid, acquired.ok, a);
}

fun surface_from_view(p: *project.Project, mid: session.ModuleId, view: query.QueryView, a: *A.Allocator) res[scx.ModuleSema, fail.Fail] {
    ret surface_from_bytes(p, mid, view.value, view.value_len, a);
}

fun surface_from_bytes(p: *project.Project, mid: session.ModuleId, bytes: *u8, len: u32, a: *A.Allocator) res[scx.ModuleSema, fail.Fail] {
    val decoded: res[scx.ModuleSema, fail.Fail] = dq.typed_surface_decode(?p.s.interner, a, bytes, len, project.module_at(p, mid::u32).fqn, mid);
    if (sel decoded.err) { ret decoded; }
    var owned:     scx.ModuleSema = decoded.ok;
    val installed: err[fail.Fail] = fields.install(p.s, ?owned.graph);
    if (sel installed.err) {
        scx.module_sema_dnit(?owned);
        ret res[scx.ModuleSema, fail.Fail].err{installed.err};
    }
    ret res[scx.ModuleSema, fail.Fail].ok{owned};
}

# resolve reads the dep list, the gate states and the bound constants from the load walk, not through a
# query. they are one digest per module, its load view, an input every product that reads them depends
# on. a dependent folds a dep's stable id, not its view, so an edit inside the dep reaches the dependent
# only through the dep's products (#3536)
fun bool_byte(b: bool) u8 {
    if (b) { ret 1; }
    ret 0;
}

fun parse_revision(p: *project.Project, m: *project.ModuleEntry) query.Revision {
    ret query.peek_revision(?p.s.queries, query.Q_PARSE, m.file_id::u64);
}

fun fold_bound_const(p: *project.Project, m: *project.ModuleEntry, entry: *comptime.NamedConst, fb: *dq.FpBuf) err[fail.Fail] {
    val name: err[fail.Fail] = dq.fp_u32(fb, entry.name::u32);
    if (sel name.err) { ret name; }
    val gated: err[fail.Fail] = dq.fp_u8(fb, bool_byte(entry.gated));
    if (sel gated.err) { ret gated; }
    ret dq.fp_ct_value(fb, ?entry.value, m.stable_id, parse_revision(p, m));
}

# a bound element may name an element of the exporter's definition, so its revision is folded then
fun fold_const_import(p: *project.Project, exporter: *project.ModuleEntry, elements: bool, fb: *dq.FpBuf) err[fail.Fail] {
    val id: err[fail.Fail] = dq.fp_u32(fb, exporter.stable_id::u32);
    if (sel id.err || !elements) { ret id; }
    ret dq.fp_u64(fb, parse_revision(p, exporter));
}

# everything resolve reads from the load walk rather than through a query
fun fold_load_view(p: *project.Project, m: *project.ModuleEntry, fb: *dq.FpBuf) err[fail.Fail] {
    # the artifact the walk attributed the module to is what its gates and bodies read as
    # `$bin.name`, so a module another artifact reaches first is typed again
    val artifact: err[fail.Fail] = dq.fp_name(fb, ?p.s.interner, m.artifact);
    if (sel artifact.err) { ret artifact; }
    val dep_count: err[fail.Fail] = dq.fp_u32(fb, m.dep_count);
    if (sel dep_count.err) { ret dep_count; }
    var i: u32 = 0;
    for (i < m.dep_count) {
        var dep: u32 = session.STABLE_MODULE_NIL::u32;
        if (m.deps[i]::u32 < project.module_count(p)) { dep = project.module_at(p, m.deps[i]::u32).stable_id::u32; }
        val folded: err[fail.Fail] = dq.fp_u32(fb, dep);
        if (sel folded.err) { ret folded; }
        i = i + 1;
    }
    val gate_count: err[fail.Fail] = dq.fp_u32(fb, m.ctx.gate_count);
    if (sel gate_count.err) { ret gate_count; }
    i = 0;
    for (i < m.ctx.gate_count) {
        val gate: err[fail.Fail] = dq.fp_u8(fb, m.ctx.gate_states[i]::u8);
        if (sel gate.err) { ret gate; }
        i = i + 1;
    }
    var elements:    bool           = false;
    val const_count: err[fail.Fail] = dq.fp_u32(fb, m.ctx.entries_len);
    if (sel const_count.err) { ret const_count; }
    i = 0;
    for (i < m.ctx.entries_len) {
        if (m.ctx.entries[i].value.kind == comptime.CT_KIND_CONST_ELEM) { elements = true; }
        val bound: err[fail.Fail] = fold_bound_const(p, m, ?m.ctx.entries[i], fb);
        if (sel bound.err) { ret bound; }
        i = i + 1;
    }
    val deferred_count: err[fail.Fail] = dq.fp_u32(fb, m.ctx.deferred_len);
    if (sel deferred_count.err) { ret deferred_count; }
    i = 0;
    for (i < m.ctx.deferred_len) {
        val deferred: err[fail.Fail] = dq.fp_u32(fb, m.ctx.deferred[i]::u32);
        if (sel deferred.err) { ret deferred; }
        i = i + 1;
    }
    val import_count: err[fail.Fail] = dq.fp_u32(fb, m.const_import_count);
    if (sel import_count.err) { ret import_count; }
    i = 0;
    for (i < m.const_import_count) {
        val imported: err[fail.Fail] = fold_const_import(p, project.module_at(p, m.const_imports[i].module::u32), elements, fb);
        if (sel imported.err) { ret imported; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# set each module's load view from what the walk left it; an unchanged view is no change
fun record_load_views(p: *project.Project) err[fail.Fail] {
    var fb: dq.FpBuf = dq.FpBuf{alloc: p.alloc};
    fin { dq.fp_free(?fb); }
    var digest: [32]u8;
    var i:      u32 = 0;
    for (i < p.topo_len) {
        val m: *project.ModuleEntry = project.module_at(p, p.topo[i]::u32);
        fb.len = 0;
        val folded: err[fail.Fail] = fold_load_view(p, m, ?fb);
        if (sel folded.err) { ret folded; }
        sha256.hash(fb.buf, fb.len, ?digest[0]);
        val stored: err[fail.Fail] = query.set_input(?p.s.queries, query.Q_LOAD_VIEW, m.stable_id::u64, ?digest[0], 32);
        if (sel stored.err) { ret stored; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# every module the load reached, gated out or not, is held under the session's active retainer: the
# project borrows each one's parse. a load closes its retainer's round unless a caller keeps the round
# open across builds, and then whatever no retainer holds is retired
pub fun retain_modules(p: *project.Project, rejected: bool) err[fail.Fail] {
    val t:  *retention.Retention = ?p.s.retention;
    val id: retention.RetainerId = t.active;
    if (rejected) { retention.reject(t, id); }
    var i: u32 = 0;
    for (i < project.module_count(p)) {
        val m: *project.ModuleEntry = project.module_at(p, i);
        if (m.stable_id != session.STABLE_MODULE_NIL) {
            val recorded: err[fail.Fail] = retention.record(t, id, m.stable_id, m.file_id, rejected);
            if (sel recorded.err) { ret recorded; }
        }
        i = i + 1;
    }
    if (!t.rounds) { ret err[fail.Fail].ok{}; }
    val ended: err[fail.Fail] = retention.end_round(t, id, true);
    if (sel ended.err) { ret ended; }
    ret retention.retire(t, ?p.s.queries);
}

# a product that reads the load walk's state depends on the module's view, so a view change reaches it
fun depend_load_view(p: *project.Project, m: *project.ModuleEntry) err[fail.Fail] {
    ret query.depend[project.Project](?p.queries, p, query.Q_LOAD_VIEW, m.stable_id::u64);
}

pub fun q_typed_exports_compute(p: *project.Project, key: u64, alloc: *A.Allocator, diags: *diagnostic.DiagnosticStore) res[query.QueryOutput, fail.Fail] {
    val s: *session.Session = p.s;

    val stable: session.StableModuleId = key::u32::session.StableModuleId;
    val mid:    session.ModuleId       = session.module_id_for_stable(s, stable);
    if (mid == session.MODULE_NIL) { ret res[query.QueryOutput, fail.Fail].err{fail.message("Q_TYPED_EXPORTS: stable id not loaded this build")}; }
    val m:        *project.ModuleEntry             = project.module_at(p, mid::u32);
    val acquired: res[*sema.SemaResult, fail.Fail] = acquire_sema(p, mid);
    if (sel acquired.err) { ret res[query.QueryOutput, fail.Fail].err{acquired.err}; }
    val sr:     *sema.SemaResult = acquired.ok;
    val viewed: err[fail.Fail]   = depend_load_view(p, m);
    if (sel viewed.err) { ret res[query.QueryOutput, fail.Fail].err{viewed.err}; }
    val resolved: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, query.Q_RESOLVE, m.stable_id::u64);
    if (sel resolved.err) { ret res[query.QueryOutput, fail.Fail].err{resolved.err}; }
    val rr: *resolve.ResolveResult = dq.resolve_handle_decode(resolved.ok);
    if (rr == nil)                    { ret res[query.QueryOutput, fail.Fail].err{fail.message("typed surface has no acquired resolved owner")}; }
    if (!sel rr.status.kind.accepted) { ret res[query.QueryOutput, fail.Fail].err{fail.phase_failure(rr.status)}; }
    if (!sel sr.status.kind.accepted) { ret res[query.QueryOutput, fail.Fail].err{fail.phase_failure(sr.status)}; }

    var fb: dq.FpBuf;
    fb.alloc = alloc;
    fb.buf   = nil;
    fb.len   = 0;
    fb.cap   = 0;

    val captured: res[scx.ModuleSema, fail.Fail] = build_type_surface(p, mid, rr, sr, alloc);
    if (sel captured.err) { ret res[query.QueryOutput, fail.Fail].err{captured.err}; }
    var surface: scx.ModuleSema = captured.ok;
    fin { scx.module_sema_dnit(?surface); }
    val graph: res[fields.Graph, fail.Fail] = capture_surface_graph(p, ?surface);
    if (sel graph.err) { ret res[query.QueryOutput, fail.Fail].err{graph.err}; }
    surface.graph = graph.ok;
    val wr: err[fail.Fail] = dq.typed_surface_encode(?fb, ?surface);
    if (sel wr.err) {
        if (fb.buf != nil && fb.cap > 0) { A.deallocate[u8](alloc, fb.buf, fb.cap::usize); }
        ret res[query.QueryOutput, fail.Fail].err{wr.err};
    }

    ret dq.fp_take(?fb);
}

rec LowerClosure {
    list:  *session.ModuleId;
    count: u32;
    cap:   u32;
}

val BACK_HALF_TEST_BIT: u64 = 0x100000000;

pub fun back_half_key(stable: session.StableModuleId, test_mode: bool) u64 {
    var k: u64 = stable::u64;
    if (test_mode) { k = k | BACK_HALF_TEST_BIT; }
    ret k;
}

pub fun back_half_key_is_test(key: u64) bool {
    ret (key & BACK_HALF_TEST_BIT) != 0;
}

pub fun back_half_key_for(p: *project.Project, m: *project.ModuleEntry) u64 {
    ret back_half_key(m.stable_id, test_build(p));
}

pub fun codegen_reusable(p: *project.Project, mid: session.ModuleId) res[bool, fail.Fail] {
    val m:        *project.ModuleEntry = project.module_at(p, mid::u32);
    val reusable: res[bool, fail.Fail] = query.reusable[project.Project](?p.queries, p, query.Q_CODEGEN, back_half_key_for(p, m));
    if (sel reusable.err) { ret reusable; }
    if (reusable.ok)      { ret reusable; }
    val restored: res[bool, fail.Fail] = persistent.restore(p, mid, readout.PH_CODEGEN);
    if (sel restored.err) { ret res[bool, fail.Fail].err{restored.err}; }
    ret res[bool, fail.Fail].ok{restored.ok};
}

pub fun test_build(p: *project.Project) bool {
    ret request.test_goal(p.req.goal);
}

# the artifact this build links is a shared library. a test build of the same
# project links an executable, so the export surface is not at stake there
pub fun shared_artifact_build(p: *project.Project) bool {
    if (p.req.goal != request.GOAL_EXECUTE) { ret false; }
    if (p.target_entry == nil)              { ret false; }
    ret p.target_entry.mode == project.MODE_LIBRARY && p.target_entry.lib_kind == manifest.LIBKIND_SHARED;
}

pub fun debug_info_of(p: *project.Project) res[codegen.DebugInfo, fail.Fail] {
    var d: codegen.DebugInfo = codegen.no_debug();
    if (!p.req.debug) { ret res[codegen.DebugInfo, fail.Fail].ok{d}; }
    if (p.target.debug == nil) {
        ret res[codegen.DebugInfo, fail.Fail].err{fail.message("debug info was requested, but this target registers no debug model; build without -g or select a target with one")};
    }

    val rp: res[intern.StrId, fail.Fail] = intern_producer(?p.s.interner, p.s.alloc, p.compiler_name, p.compiler_ver);
    if (sel rp.err) { ret res[codegen.DebugInfo, fail.Fail].err{rp.err}; }
    d.emit     = true;
    d.producer = rp.ok;
    d.comp_dir = p.config.project_root;
    val prep: err[fail.Fail] = codegen.prepare_debug(p.s);
    if (sel prep.err) { ret res[codegen.DebugInfo, fail.Fail].err{prep.err}; }
    ret res[codegen.DebugInfo, fail.Fail].ok{d};
}

fun intern_producer(itn: *intern.Interner, alloc: *A.Allocator, name_id: intern.StrId, ver_id: intern.StrId) res[intern.StrId, fail.Fail] {
    val no: opt[str] = intern.lookup(itn, name_id);
    val vo: opt[str] = intern.lookup(itn, ver_id);
    if (sel no.none) {
        ret res[intern.StrId, fail.Fail].err{fail.message("debug: compiler identity not interned")};
    }
    if (sel vo.none) {
        ret res[intern.StrId, fail.Fail].err{fail.message("debug: compiler identity not interned")};
    }
    val jr: res[str, string.StrError] = str_join(alloc, no.some, " ", vo.some);
    if (sel jr.err) { ret res[intern.StrId, fail.Fail].err{fail.str_refused(jr.err)}; }
    val joined: str                        = jr.ok;
    val ri:     res[intern.StrId, A.Error] = intern.intern(itn, joined);
    A.deallocate[u8](alloc, joined::*u8, str_len(joined) + 1);
    if (sel ri.err) { ret res[intern.StrId, fail.Fail].err{fail.refused(ri.err)}; }
    ret res[intern.StrId, fail.Fail].ok{ri.ok};
}

test "mach.lang.driver.passes.intern_producer:name_version" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);

    val rn: res[intern.StrId, A.Error] = intern.intern(?itn, "mach");
    val rv: res[intern.StrId, A.Error] = intern.intern(?itn, "2.14.0");
    if (sel rn.err) { ret 1; }
    if (sel rv.err) { ret 1; }

    val rp: res[intern.StrId, fail.Fail] = intern_producer(?itn, ?alloc,
        rn.ok, rv.ok);
    if (sel rp.err) { ret 1; }
    val got: opt[str] = intern.lookup(?itn, rp.ok);
    if (sel got.none)                         { ret 1; }
    if (!str_equals(got.some, "mach 2.14.0")) { ret 1; }
    ret 0;
}

pub fun run_lower_pass(p: *project.Project) err[outcome.Fail] {
    val prepared: err[outcome.Fail] = acquire_lower_inputs(p);
    if (sel prepared.err) { ret prepared; }
    val restored: err[outcome.Fail] = run_cache_restore(p);
    if (sel restored.err) { ret restored; }

    if (lower_parallel_enabled(p)) {
        val rp: err[fail.Fail] = run_lower_parallel(p);
        if (sel rp.err) {
            ret err[outcome.Fail].err{outcome.from_fail(rp.err)};
        }
    }

    var i: u32 = 0;
    for (i < p.emit_len) {
        val mid: session.ModuleId = p.topo[i];
        if (persistent.restored(p, project.module_at(p, mid::u32))) {
            i = i + 1;
            cnt;
        }

        val r: err[fail.Fail] = run_lower_one(p, mid);
        if (sel r.err) {
            ret err[outcome.Fail].err{outcome.from_fail(r.err)};
        }
        i = i + 1;
    }
    ret err[outcome.Fail].ok{};
}

# the cache work shares the lowering operation, whose snapshot its verdicts are
# taken under. with the cache on it is reported as its own phase carved out of lower
fun run_cache_restore(p: *project.Project) err[outcome.Fail] {
    val t_cache: readout.Instant   = readout.span_begin(p.events);
    val cached:  err[outcome.Fail] = prepare_persistent_cache(p, readout.PH_CACHE);
    var result:  err[outcome.Fail] = cached;
    if (sel cached.ok)      { result = restore_before_lowering(p); }
    if (p.req.object_cache) { readout.span_end(p.events, readout.PH_CACHE, readout.PH_LOWER, t_cache); }
    ret result;
}

# the object key does not depend on the lowered or optimized ir, so a module
# whose object the store holds is restored here and never lowers
fun restore_before_lowering(p: *project.Project) err[outcome.Fail] {
    if (!p.cache_ready || !persistent.early_restore_enabled(p)) { ret err[outcome.Fail].ok{}; }
    var i: u32 = 0;
    for (i < p.emit_len) {
        val mid: session.ModuleId = p.topo[i];
        # a codegen product this session still holds needs no restoring
        val held: res[bool, fail.Fail] = query.reusable[project.Project](?p.queries, p, query.Q_CODEGEN, back_half_key_for(p, project.module_at(p, mid::u32)));
        if (sel held.err) { ret err[outcome.Fail].err{outcome.from_fail(held.err)}; }
        if (held.ok) {
            i = i + 1;
            cnt;
        }
        val restored: res[bool, fail.Fail] = persistent.restore(p, mid, readout.PH_CACHE);
        if (sel restored.err) { ret err[outcome.Fail].err{outcome.from_fail(restored.err)}; }
        i = i + 1;
    }
    ret err[outcome.Fail].ok{};
}

pub fun prepare_lower_pass(p: *project.Project) err[outcome.Fail] {
    val imports: err[fail.Fail] = union.register_import_libraries(p);
    if (sel imports.err) { ret err[outcome.Fail].err{outcome.user_fail(imports.err)}; }

    if (!query.is_registered(?p.s.queries, query.Q_LOWERED_SURFACE)) {
        val rls: err[fail.Fail] = query.register_derived(?p.s.queries, query.Q_LOWERED_SURFACE);
        if (sel rls.err) { ret err[outcome.Fail].err{outcome.from_fail(rls.err)}; }
    }
    if (!query.is_registered(?p.s.queries, query.Q_INLINE_BODIES)) {
        val registered: err[fail.Fail] = query.register_derived_equatable(?p.s.queries, query.Q_INLINE_BODIES, q_lower_finalize, lower_output_equal);
        if (sel registered.err) { ret err[outcome.Fail].err{outcome.from_fail(registered.err)}; }
    }
    if (!query.is_registered(?p.s.queries, query.Q_LOWER)) {
        val rl: err[fail.Fail] = query.register_derived_equatable(?p.s.queries, query.Q_LOWER, q_lower_finalize, lower_output_equal);
        if (sel rl.err) { ret err[outcome.Fail].err{outcome.from_fail(rl.err)}; }
    }
    if (!query.is_registered(?p.s.queries, query.Q_CELL_SNAPSHOT)) {
        val rc: err[fail.Fail] = query.register_derived(?p.s.queries, query.Q_CELL_SNAPSHOT);
        if (sel rc.err) { ret err[outcome.Fail].err{outcome.from_fail(rc.err)}; }
    }
    val registered: err[outcome.Fail] = register_codegen_product(p);
    if (sel registered.err) { ret registered; }
    ret set_codegen_flags_input(p);
}

# the persistent object key's inputs as one query product: every typed
# definition in the cell, the target configuration and the codegen flags. its
# bytes are the cell digest, so an edit anywhere in the cell advances it and
# every product restored under the old digest recomputes
pub fun q_cell_snapshot_compute(p: *project.Project, key: u64, alloc: *A.Allocator, diags: *diagnostic.DiagnosticStore) res[query.QueryOutput, fail.Fail] {
    if (key != 0) { ret res[query.QueryOutput, fail.Fail].err{fail.message("Q_CELL_SNAPSHOT has one key")}; }
    var i: u32 = 0;
    for (i < p.topo_len) {
        val definition: res[scx.Definition, fail.Fail] = read_definition(p::ptr, p.topo[i], scx.DEFINITION_TYPED);
        if (sel definition.err) { ret res[query.QueryOutput, fail.Fail].err{definition.err}; }
        i = i + 1;
    }
    val rt: err[fail.Fail] = query.depend[project.Project](?p.queries, p, query.Q_TARGET, 0);
    if (sel rt.err) { ret res[query.QueryOutput, fail.Fail].err{rt.err}; }
    val rf: err[fail.Fail] = query.depend[project.Project](?p.queries, p, query.Q_CODEGEN_FLAGS, 0);
    if (sel rf.err)                        { ret res[query.QueryOutput, fail.Fail].err{rf.err}; }
    if (!persistent.identity_available(p)) { ret res[query.QueryOutput, fail.Fail].err{fail.message("Q_CELL_SNAPSHOT requires the compiler identity")}; }
    var backing: A.Allocator;
    val make_r:  err[A.Error] = page.make(?backing);
    if (sel make_r.err) { ret res[query.QueryOutput, fail.Fail].err{fail.message("cache fingerprint allocator is unavailable")}; }
    val captured: res[query.QueryOutput, fail.Fail] = capture_configuration_identity(p, ?backing);
    if (sel captured.err) { ret captured; }
    val config: query.QueryOutput = captured.ok;
    fin {
        if (config.bytes != nil) { A.deallocate[u8](?backing, config.bytes, config.len::usize); }
    }
    var digest: [32]u8;
    val keyed:  err[fail.Fail] = persistent.snapshot(?backing, p, config.bytes, config.len::usize, ?p.compiler_identity, ?digest);
    if (sel keyed.err) { ret res[query.QueryOutput, fail.Fail].err{keyed.err}; }
    val bytes: res[*u8, A.Error] = A.allocate[u8](alloc, 32);
    if (sel bytes.err) { ret res[query.QueryOutput, fail.Fail].err{fail.refused(bytes.err)}; }
    var b: usize = 0;
    for (b < 32) {
        bytes.ok[b] = digest[b];
        b           = b + 1;
    }
    ret res[query.QueryOutput, fail.Fail].ok{query.QueryOutput{bytes: bytes.ok, len: 32}};
}

fun acquire_frontend_inputs(p: *project.Project) err[outcome.Fail] {
    var i: u32 = 0;
    for (i < p.topo_len) {
        val acquired: res[scx.Definition, fail.Fail] = read_definition(p::ptr, p.topo[i], scx.DEFINITION_TYPED);
        if (sel acquired.err) { ret err[outcome.Fail].err{outcome.from_fail(acquired.err)}; }
        i = i + 1;
    }
    ret err[outcome.Fail].ok{};
}

fun acquire_lower_inputs(p: *project.Project) err[outcome.Fail] {
    val frontend: err[outcome.Fail] = acquire_frontend_inputs(p);
    if (sel frontend.err) { ret frontend; }
    var i: u32 = 0;
    for (i < p.emit_len) {
        val m:    *project.ModuleEntry            = project.module_at(p, p.topo[i]::u32);
        val sf_r: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, query.Q_LOWERED_SURFACE, m.stable_id::u64);
        if (sel sf_r.err) {
            ret err[outcome.Fail].err{outcome.from_fail(sf_r.err)};
        }
        i = i + 1;
    }
    ret err[outcome.Fail].ok{};
}

fun lower_reusable(p: *project.Project, mid: session.ModuleId) res[bool, fail.Fail] {
    val m: *project.ModuleEntry = project.module_at(p, mid::u32);
    ret query.reusable[project.Project](?p.queries, p, query.Q_LOWER, back_half_key_for(p, m));
}

test "mach.lang.driver.passes:internal_failure_is_not_hidden_by_a_user_error" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 2; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var span: token.Span;
    span.offset = 0;
    span.len    = 1;
    val emitted: err[fail.Fail] = diagnostic.error(?s.diags, 0::src.FileId, span, "invalid user expression");
    if (sel emitted.err) { ret 3; }
    val f: outcome.Fail = outcome.from_fail(fail.message("internal allocation failure after rejection"));
    if (!sel f.internal)                                                                 { ret 4; }
    if (!str_equals(outcome.describe(f), "internal allocation failure after rejection")) { ret 5; }
    ret 0;
}

test "mach.lang.driver.passes:message_only_internal_failure_stays_internal" {
    val f: outcome.Fail = outcome.from_fail(fail.message("internal failure without a diagnostic"));
    if (!sel f.internal)                                                           { ret 1; }
    if (!str_equals(outcome.describe(f), "internal failure without a diagnostic")) { ret 2; }
    if (!outcome.is_reported(outcome.from_fail(fail.reported())))                  { ret 3; }
    ret 0;
}

# the standing of the load walk alone, over every module it reached
pub fun load_status(p: *project.Project) fail.PhaseStatus {
    var status: fail.PhaseStatus = fail.accepted();
    var i:      u32              = 0;
    for (i < project.module_count(p)) {
        fail.merge(?status, project.module_at(p, i).load_status);
        i = i + 1;
    }
    ret status;
}

pub fun frontend_status(p: *project.Project) fail.PhaseStatus {
    var status: fail.PhaseStatus = fail.accepted();
    var i:      u32              = 0;
    for (i < project.module_count(p)) {
        val m: *project.ModuleEntry = project.module_at(p, i);
        fail.merge(?status, m.parse_status);
        fail.merge(?status, m.load_status);
        if (m.resolve_result != nil) { fail.merge(?status, m.resolve_result.status); }
        if (m.sema_result != nil)    { fail.merge(?status, m.sema_result.status); }
        i = i + 1;
    }
    ret status;
}

fun run_lower_one(p: *project.Project, mid: session.ModuleId) err[fail.Fail] {
    val m: *project.ModuleEntry = project.module_at(p, mid::u32);

    val e_r: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, query.Q_LOWER, back_half_key_for(p, m));
    if (sel e_r.err) { ret err[fail.Fail].err{e_r.err}; }
    val irm: *ir.Module = ir_handle_decode(e_r.ok);
    if (irm == nil) { ret err[fail.Fail].err{fail.message("Q_LOWER produced no result handle")}; }

    m.ir_module = irm;
    ret err[fail.Fail].ok{};
}

pub fun q_lowered_surface_compute(p: *project.Project, key: u64, alloc: *A.Allocator, diags: *diagnostic.DiagnosticStore) res[query.QueryOutput, fail.Fail] {
    val db: *query.QueryDb   = ?p.s.queries;
    val s:  *session.Session = p.s;

    val stable: session.StableModuleId = key::u32::session.StableModuleId;
    val mid:    session.ModuleId       = session.module_id_for_stable(s, stable);
    if (mid == session.MODULE_NIL) { ret res[query.QueryOutput, fail.Fail].err{fail.message("Q_LOWERED_SURFACE: stable id not loaded this build")}; }
    val m:          *project.ModuleEntry           = project.module_at(p, mid::u32);
    val definition: res[scx.Definition, fail.Fail] = read_definition(p::ptr, mid, scx.DEFINITION_RESOLVED);
    if (sel definition.err) { ret res[query.QueryOutput, fail.Fail].err{definition.err}; }
    val a: *ast.Ast = definition.ok.parsed.a;

    val sf_o: opt[*src.SourceFile] = src.get(?s.sources, a.file_id);
    if (sel sf_o.none) { ret res[query.QueryOutput, fail.Fail].err{fail.message("Q_LOWERED_SURFACE: module source not loaded")}; }
    val text: str = sf_o.some.text;

    var fb: dq.FpBuf;
    fb.alloc = alloc;
    fb.buf   = nil;
    fb.len   = 0;
    fb.cap   = 0;

    val wr: err[fail.Fail] = fp_lowered_surface(?fb, a, text);
    if (sel wr.err) {
        if (fb.buf != nil && fb.cap > 0) { A.deallocate[u8](alloc, fb.buf, fb.cap::usize); }
        ret res[query.QueryOutput, fail.Fail].err{wr.err};
    }

    ret dq.fp_take(?fb);
}

fun fp_lowered_surface(fb: *dq.FpBuf, a: *ast.Ast, text: str) err[fail.Fail] {
    val base:  *u8   = text::*u8;
    val total: usize = str_len(text);

    val m_opt: opt[*module.Module] = ast.get_module(a, a.root_module);
    if (sel m_opt.none) { ret dq.fp_bytes(fb, base, total::u32); }
    val mod_node: *module.Module = m_opt.some;

    var cursor: usize = 0;
    var i:      u32   = 0;
    for (i < mod_node.decls_len) {
        val did: id.DeclId      = a.decl_ids[mod_node.decls_start + i];
        val w:   err[fail.Fail] = fp_non_flowing_decl_bodies(fb, a, text, base, did, ?cursor);
        if (sel w.err) { ret w; }
        i = i + 1;
    }
    ret dq.fp_bytes(fb, ?base[cursor], (total - cursor)::u32);
}

fun fp_non_flowing_decl_bodies(fb: *dq.FpBuf, a: *ast.Ast, text: str, base: *u8,
    did: id.DeclId, cursor: *usize) err[fail.Fail] {
    val d_opt: opt[*decl.Decl] = ast.get_decl(a, did);
    if (sel d_opt.none) {
        ret err[fail.Fail].err{fail.message("Q_LOWERED_SURFACE: declaration id out of range")};
    }
    val d: *decl.Decl = d_opt.some;

    val bs_o: opt[token.Span] = non_flowing_body_span(a, text, d);
    if (sel bs_o.some) {
        val bs: token.Span = bs_o.some;
        if (bs.offset < @cursor) {
            ret err[fail.Fail].err{fail.message("Q_LOWERED_SURFACE: declaration body spans overlap")};
        }
        val w: err[fail.Fail] = dq.fp_bytes(fb, ?base[@cursor], (bs.offset - @cursor)::u32);
        if (sel w.err) { ret w; }
        @cursor = bs.offset + bs.len;
        ret err[fail.Fail].ok{};
    }

    if (d.kind != decl.DECL_KIND_COMPTIME_IF) { ret err[fail.Fail].ok{}; }
    var bi: u32 = 0;
    for (bi < d.data.comptime_if.branches_len) {
        val branch_ix: u32 = d.data.comptime_if.branches_start + bi;
        if (branch_ix::usize >= a.comptime_branch_len) {
            ret err[fail.Fail].err{fail.message("Q_LOWERED_SURFACE: comptime branch index out of range")};
        }
        val branch: *decl.ComptimeBranch = ?a.comptime_branches[branch_ix];
        var di:     u32                  = 0;
        for (di < branch.body_len) {
            val pool_ix: u32 = branch.body_start + di;
            if (pool_ix::usize >= a.decl_id_len) {
                ret err[fail.Fail].err{fail.message("Q_LOWERED_SURFACE: comptime declaration index out of range")};
            }
            val w: err[fail.Fail] = fp_non_flowing_decl_bodies(fb, a, text, base, a.decl_ids[pool_ix], cursor);
            if (sel w.err) { ret w; }
            di = di + 1;
        }
        bi = bi + 1;
    }
    ret err[fail.Fail].ok{};
}

fun non_flowing_body_span(a: *ast.Ast, text: str, d: *decl.Decl) opt[token.Span] {
    var body: id.StmtId = id.STMT_NIL;
    if (d.kind == decl.DECL_KIND_TEST) {
        body = d.data.test_.body;
    }
    or (d.kind == decl.DECL_KIND_FUN) {
        if (d.data.fun_.generics_len > 0) { ret opt[token.Span].none{}; }
        var pi: u32 = 0;
        for (pi < d.data.fun_.params_len) {
            if (a.typed_names[d.data.fun_.params_start + pi].comptime) { ret opt[token.Span].none{}; }
            pi = pi + 1;
        }
        body = d.data.fun_.body;
    }
    if (body == id.STMT_NIL) { ret opt[token.Span].none{}; }

    val st_o: opt[*stmt.Stmt] = ast.get_stmt(a, body);
    if (sel st_o.none) { ret opt[token.Span].none{}; }
    ret opt[token.Span].some{st_o.some.span};
}

# the inputs a module's lowering reads: its typed definition and the target. every
# product built from a raw lowering records these on itself, whether it lowers or
# takes the raw module another product captured, so no edit to the source can be
# hidden behind an equal sibling product
fun lower_inputs(p: *project.Project, key: u64) res[session.ModuleId, fail.Fail] {
    val stable: session.StableModuleId = key::u32::session.StableModuleId;
    val mid:    session.ModuleId       = session.module_id_for_stable(p.s, stable);
    if (mid == session.MODULE_NIL) { ret res[session.ModuleId, fail.Fail].err{fail.message("Q_LOWER: stable id not loaded this build")}; }
    val definition: res[scx.Definition, fail.Fail] = read_definition(p::ptr, mid, scx.DEFINITION_TYPED);
    if (sel definition.err) { ret res[session.ModuleId, fail.Fail].err{definition.err}; }
    val rt: err[fail.Fail] = query.depend[project.Project](?p.queries, p, query.Q_TARGET, 0);
    if (sel rt.err) { ret res[session.ModuleId, fail.Fail].err{rt.err}; }
    ret res[session.ModuleId, fail.Fail].ok{mid};
}

fun lower_raw_candidate_compute(p: *project.Project, key: u64, alloc: *A.Allocator, diags: *diagnostic.DiagnosticStore) res[query.QueryOutput, fail.Fail] {
    val test_mode: bool                             = back_half_key_is_test(key);
    val inputs:    res[session.ModuleId, fail.Fail] = lower_inputs(p, key);
    if (sel inputs.err) { ret res[query.QueryOutput, fail.Fail].err{inputs.err}; }
    val mid: session.ModuleId               = inputs.ok;
    val m:   *project.ModuleEntry           = project.module_at(p, mid::u32);
    val hr:  res[*ir.ModuleHome, fail.Fail] = ir_home_new(alloc);
    if (sel hr.err) { ret res[query.QueryOutput, fail.Fail].err{hr.err}; }
    val home: *ir.ModuleHome = hr.ok;

    val t_low:  readout.Instant            = readout.item_begin(p.events);
    val rr_raw: res[*ir.Module, fail.Fail] = lower_raw(p, mid, home, test_mode, diags);
    if (sel rr_raw.err) {
        val stable: fail.Fail = lower_stable_fail(p, rr_raw.err);
        ir_release(alloc, home);
        ret res[query.QueryOutput, fail.Fail].err{stable};
    }
    readout.item(p.events, readout.PH_LOWER, project.fqn_name(p, m.fqn), t_low);
    val irmod: *ir.Module = rr_raw.ok;

    ret ir_handle_encode(alloc, irmod, home);
}

pub fun q_inline_bodies_compute(p: *project.Project, key: u64, alloc: *A.Allocator, diags: *diagnostic.DiagnosticStore) res[query.QueryOutput, fail.Fail] {
    val raw: res[query.QueryOutput, fail.Fail] = lower_raw_candidate_compute(p, key, alloc, diags);
    if (sel raw.err) { ret raw; }
    val output:      query.QueryOutput = raw.ok;
    var transferred: bool              = false;
    fin {
        if (!transferred) { release_lower_output(alloc, output); }
    }
    val src:        *ir.Module           = ir_handle_decode(query.QueryView{value: output.bytes, value_len: output.len});
    val normalized: res[bool, fail.Fail] = mem2reg.run(src);
    if (sel normalized.err) { ret res[query.QueryOutput, fail.Fail].err{lower_stable_fail(p, normalized.err)}; }
    val created: res[*ir.ModuleHome, fail.Fail] = ir_home_new(alloc);
    if (sel created.err) { ret res[query.QueryOutput, fail.Fail].err{created.err}; }
    val home:  *ir.ModuleHome           = created.ok;
    val boxed: res[*ir.Module, A.Error] = A.allocate[ir.Module](?home.alloc, 1::usize);
    if (sel boxed.err) {
        ir_release(alloc, home);
        ret res[query.QueryOutput, fail.Fail].err{fail.refused(boxed.err)};
    }
    val dst:         *ir.Module                = boxed.ok;
    val initialized: res[ir.Module, fail.Fail] = ir.init(?home.alloc, src.name);
    if (sel initialized.err) {
        ir_release(alloc, home);
        ret res[query.QueryOutput, fail.Fail].err{initialized.err};
    }
    @dst = initialized.ok;
    val flags: res[*bool, A.Error] = A.allocate[bool](p.s.alloc, src.function_len::usize);
    if (sel flags.err) {
        ir_release(alloc, home);
        ret res[query.QueryOutput, fail.Fail].err{fail.refused(flags.err)};
    }
    val recursive: *bool = flags.ok;
    fin {
        if (recursive != nil) { A.deallocate[bool](p.s.alloc, recursive, src.function_len::usize); }
    }
    val marked: err[fail.Fail] = inline_pass.mark_recursive(src, recursive, p.s.alloc);
    if (sel marked.err) {
        ir_release(alloc, home);
        ret res[query.QueryOutput, fail.Fail].err{lower_stable_fail(p, marked.err)};
    }
    val extracted: err[fail.Fail] = body.extract(dst, src, ?p.target, p.s.alloc, recursive);
    if (sel extracted.err) {
        val stable: fail.Fail = lower_stable_fail(p, extracted.err);
        ir_release(alloc, home);
        ret res[query.QueryOutput, fail.Fail].err{stable};
    }
    val encoded: res[query.QueryOutput, fail.Fail] = ir_handle_encode(alloc, dst, home);
    if (sel encoded.err) { ret encoded; }
    if (p.raw_lower_capture != nil && p.raw_lower_capture.key == key && p.raw_lower_capture.output.bytes == nil) {
        p.raw_lower_capture.output = output;
        transferred                = true;
    }
    ret encoded;
}

fun release_lower_output(alloc: *A.Allocator, output: query.QueryOutput) {
    if (output.bytes == nil) { ret; }
    q_lower_finalize(output.bytes, output.len, alloc);
    A.deallocate[u8](alloc, output.bytes, output.len::usize);
}

fun lower_candidate_compute(p: *project.Project, key: u64, alloc: *A.Allocator, diags: *diagnostic.DiagnosticStore) res[query.QueryOutput, fail.Fail] {
    if (p.req.opt != pipeline.OPT_RELEASE) { ret lower_raw_candidate_compute(p, key, alloc, diags); }
    val inputs: res[session.ModuleId, fail.Fail] = lower_inputs(p, key);
    if (sel inputs.err) { ret res[query.QueryOutput, fail.Fail].err{inputs.err}; }
    var local: project.RawLowerCapture;
    local.key = key;
    val saved: *project.RawLowerCapture = p.raw_lower_capture;
    if (saved == nil) { p.raw_lower_capture = ?local; }
    fin {
        p.raw_lower_capture = saved;
        release_lower_output(alloc, local.output);
    }
    val available: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, query.Q_INLINE_BODIES, key);
    if (sel available.err) { ret res[query.QueryOutput, fail.Fail].err{available.err}; }
    if (p.raw_lower_capture.key == key && p.raw_lower_capture.output.bytes != nil) {
        val out: query.QueryOutput = p.raw_lower_capture.output;
        p.raw_lower_capture.output = query.QueryOutput{};
        ret res[query.QueryOutput, fail.Fail].ok{out};
    }
    ret lower_raw_candidate_compute(p, key, alloc, diags);
}

fun acquire_inline_bodies(p: *project.Project, m: *ir.Module, available: *body.Available, test_mode: bool) err[fail.Fail] {
    if (p.req.opt != pipeline.OPT_RELEASE) { ret err[fail.Fail].ok{}; }
    var i: u32 = 0;
    for (i < m.function_len) {
        val origin: intern.StrId = m.functions[i].body_module;
        if ((m.functions[i].flags & ir.FN_FLAG_EXTERN) == 0 || origin == intern.STR_NIL || origin == m.name) {
            i = i + 1;
            cnt;
        }
        val stable: session.StableModuleId = session.stable_module_id_lookup(p.s, origin);
        if (stable == session.STABLE_MODULE_NIL) { ret err[fail.Fail].err{fail.message("inline body: defining module has no stable query identity")}; }
        val got: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, query.Q_INLINE_BODIES, back_half_key(stable, test_mode));
        if (sel got.err) { ret err[fail.Fail].err{got.err}; }
        val provider: *ir.Module = ir_handle_decode(got.ok);
        if (provider == nil) { ret err[fail.Fail].err{fail.message("inline body: provider has no owned product")}; }
        val imported: err[fail.Fail] = body.acquire(available, m, provider, m.functions[i].name, ?p.target, p.s.alloc);
        if (sel imported.err) { ret err[fail.Fail].err{imported.err}; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun q_lower_raw_compute(p: *project.Project, kind: query.QueryKind, key: u64,
    alloc: *A.Allocator, diags: *diagnostic.DiagnosticStore) res[query.QueryOutput, fail.Fail] {
    if (kind != query.Q_LOWER) { ret res[query.QueryOutput, fail.Fail].err{fail.message("raw lowering requires its Q_LOWER owner")}; }
    val raw: res[query.QueryOutput, fail.Fail] = lower_candidate_compute(p, key, alloc, diags);
    if (sel raw.err) { ret raw; }
    val output: query.QueryOutput = raw.ok;
    if (p.req.opt == pipeline.OPT_RELEASE) {
        if (p.raw_lower_capture == nil || p.raw_lower_capture.available == nil) {
            release_lower_output(alloc, output);
            ret res[query.QueryOutput, fail.Fail].err{fail.message("prepared lowering requires its scoped body owner")};
        }
        val m:        *ir.Module     = ir_handle_decode(query.QueryView{value: output.bytes, value_len: output.len});
        val imported: err[fail.Fail] = acquire_inline_bodies(p, m, p.raw_lower_capture.available, back_half_key_is_test(key));
        if (sel imported.err) {
            val failure: fail.Fail = lower_stable_fail(p, imported.err);
            release_lower_output(alloc, output);
            ret res[query.QueryOutput, fail.Fail].err{failure};
        }
    }
    ret raw;
}

pub fun q_lower_compute(p: *project.Project, key: u64, alloc: *A.Allocator, diags: *diagnostic.DiagnosticStore) res[query.QueryOutput, fail.Fail] {
    val raw: res[query.QueryOutput, fail.Fail] = lower_candidate_compute(p, key, alloc, diags);
    if (sel raw.err) { ret raw; }
    val output:      query.QueryOutput = raw.ok;
    var transferred: bool              = false;
    fin {
        if (!transferred) {
            q_lower_finalize(output.bytes, output.len, alloc);
            A.deallocate[u8](alloc, output.bytes, output.len::usize);
        }
    }
    val irmod:     *ir.Module      = ir_handle_decode(query.QueryView{value: output.bytes, value_len: output.len});
    var storage:   body.Available;
    var available: *body.Available = nil;
    fin {
        if (available != nil) { body.available_dnit(available, irmod); }
    }
    if (p.req.opt == pipeline.OPT_RELEASE) {
        val opened: err[fail.Fail] = body.available_init(?storage, irmod.name);
        if (sel opened.err) { ret res[query.QueryOutput, fail.Fail].err{opened.err}; }
        available = ?storage;
        val imported: err[fail.Fail] = acquire_inline_bodies(p, irmod, available, back_half_key_is_test(key));
        if (sel imported.err) { ret res[query.QueryOutput, fail.Fail].err{lower_stable_fail(p, imported.err)}; }
    }
    val main_id: res[intern.StrId, fail.Fail] = neutralize_id(p, back_half_key_is_test(key));
    if (sel main_id.err) { ret res[query.QueryOutput, fail.Fail].err{main_id.err}; }
    val t_opt:     readout.Instant = readout.span_begin(p.events);
    val optimized: err[fail.Fail]  = lower_optimize(p, irmod, main_id.ok, available, diags);
    readout.item(p.events, readout.PH_OPTIMIZE, project.fqn_name(p, irmod.name), t_opt);
    readout.span_end(p.events, readout.PH_OPTIMIZE, readout.PH_LOWER, t_opt);
    if (sel optimized.err) { ret res[query.QueryOutput, fail.Fail].err{lower_stable_fail(p, optimized.err)}; }
    transferred = true;
    ret raw;
}

fun lower_raw(p: *project.Project, mid: session.ModuleId, home: *ir.ModuleHome, test_mode: bool, diags: *diagnostic.DiagnosticStore) res[*ir.Module, fail.Fail] {
    val s: *session.Session     = p.s;
    val m: *project.ModuleEntry = project.module_at(p, mid::u32);

    val captured: res[sema.SemaDeps, fail.Fail] = build_sema_deps_query(p, m);
    if (sel captured.err) { ret res[*ir.Module, fail.Fail].err{captured.err}; }
    var deps: sema.SemaDeps = captured.ok;
    fin { free_sema_deps_query(p.s.alloc, ?deps); }
    val req_r: res[lower.LowerRequest, fail.Fail] = lower.request(s, ?p.target, ?home.alloc, m.a, m.fqn, mid,
        m.sema_result, m.resolve_result, ?m.ctx, test_mode, shared_artifact_build(p), p.req.debug, p.req.opt != pipeline.OPT_RELEASE, diags, ?deps);
    if (sel req_r.err) { ret res[*ir.Module, fail.Fail].err{req_r.err}; }
    var req: lower.LowerRequest = req_r.ok;

    val res_lower: res[ir.Module, fail.Fail] = lower.lower_module(?req);
    if (sel res_lower.err) { ret res[*ir.Module, fail.Fail].err{res_lower.err}; }

    val br: res[*ir.Module, A.Error] = A.allocate[ir.Module](?home.alloc, 1::usize);
    if (sel br.err) { ret res[*ir.Module, fail.Fail].err{fail.refused(br.err)}; }
    val box: *ir.Module = br.ok;
    box[0] = res_lower.ok;

    val res_obl: res[bool, fail.Fail] = oblivious.check_module(box, ?s.interner, diags, s.alloc);
    if (sel res_obl.err) { ret res[*ir.Module, fail.Fail].err{res_obl.err}; }
    if (!res_obl.ok)     { ret res[*ir.Module, fail.Fail].err{fail.reported()}; }
    ret res[*ir.Module, fail.Fail].ok{box};
}

fun lower_optimize(p: *project.Project, irmod: *ir.Module, main_id: intern.StrId, available: *body.Available, diags: *diagnostic.DiagnosticStore) err[fail.Fail] {
    var preq: pipeline.PipelineRequest;
    preq.module            = irmod;
    preq.available         = available;
    preq.target            = ?p.target;
    preq.level             = p.req.opt;
    preq.vectorize_enabled = pipeline.VectorizeEnabledOption{v: p.req.vectorize};
    preq.simd_require      = pipeline.SimdRequireOption{v: p.req.simd == manifest.SIMD_REQUIRE};
    preq.float_reassoc     = pipeline.FloatReassocOption{v: p.req.float_reassoc};
    preq.interner          = ?p.s.interner;
    preq.source_map        = ?p.s.sources;
    preq.diags             = diags;
    val res_opt: res[bool, fail.Fail] = pipeline.run(?preq);
    if (sel res_opt.err) { ret err[fail.Fail].err{res_opt.err}; }

    if (main_id != intern.STR_NIL) { testrunner.neutralize_main(main_id, irmod); }
    ret err[fail.Fail].ok{};
}

fun neutralize_id(p: *project.Project, test_mode: bool) res[intern.StrId, fail.Fail] {
    if (!test_mode) { ret res[intern.StrId, fail.Fail].ok{intern.STR_NIL}; }
    val linkage: res[intern.StrId, fail.Fail] = testrunner.main_linkage_id(p.s);
    if (sel linkage.err) { ret res[intern.StrId, fail.Fail].err{linkage.err}; }
    ret res[intern.StrId, fail.Fail].ok{linkage.ok};
}

fun ir_home_new(alloc: *A.Allocator) res[*ir.ModuleHome, fail.Fail] {
    val hr: res[*ir.ModuleHome, A.Error] = A.allocate[ir.ModuleHome](alloc, 1::usize);
    if (sel hr.err) { ret res[*ir.ModuleHome, fail.Fail].err{fail.refused(hr.err)}; }
    val home: *ir.ModuleHome = hr.ok;
    val io:   err[fail.Fail] = ir.home_init(home);
    if (sel io.err) {
        A.deallocate[ir.ModuleHome](alloc, home, 1::usize);
        ret res[*ir.ModuleHome, fail.Fail].err{io.err};
    }
    ret res[*ir.ModuleHome, fail.Fail].ok{home};
}

fun lower_stable_fail(p: *project.Project, f: fail.Fail) fail.Fail {
    if (sel f.reported) { ret f; }
    ret fail.message(lower_stable_err(p, f.message));
}

fun lower_stable_err(p: *project.Project, msg: str) str {
    val ir_r: res[intern.StrId, A.Error] = intern.intern(?p.s.interner, msg);
    if (sel ir_r.ok) {
        val nm: opt[str] = intern.lookup(?p.s.interner, ir_r.ok);
        if (sel nm.some) { ret nm.some; }
    }
    ret "lowering failed, and re-homing its diagnostic off the module arena failed in turn (allocation failure)";
}

fun ir_release(alloc: *A.Allocator, home: *ir.ModuleHome) {
    if (home == nil) { ret; }
    ir.home_dnit(home);
    A.deallocate[ir.ModuleHome](alloc, home, 1::usize);
}

pub fun q_lower_finalize(value: *u8, value_len: u32, alloc: *A.Allocator) {
    if (value == nil || value_len < ir_handle_len()) { ret; }
    val slot: *ptr = value::ptr::*ptr;
    ir_release(alloc, slot[1]::*ir.ModuleHome);
}

fun ir_handle_len() u32 {
    ret ($size_of(ptr) * 2)::u32;
}

fun ir_handle_encode(alloc: *A.Allocator, r: *ir.Module, home: *ir.ModuleHome) res[query.QueryOutput, fail.Fail] {
    val rb: res[*u8, A.Error] = A.allocate[u8](alloc, ir_handle_len()::usize);
    if (sel rb.err) {
        ir_release(alloc, home);
        ret res[query.QueryOutput, fail.Fail].err{fail.refused(rb.err)};
    }
    val buf:  *u8  = rb.ok;
    val slot: *ptr = buf::ptr::*ptr;
    slot[0] = r::ptr;
    slot[1] = home::ptr;
    var out: query.QueryOutput;
    out.bytes = buf;
    out.len   = ir_handle_len();
    ret res[query.QueryOutput, fail.Fail].ok{out};
}

fun ir_handle_decode(e: query.QueryView) *ir.Module {
    if (e.value == nil || e.value_len < ir_handle_len()) { ret nil; }
    val slot: *ptr = e.value::ptr::*ptr;
    ret slot[0]::*ir.Module;
}

fun lower_parallel_enabled(p: *project.Project) bool {
    ret p.req.jobs >= 1 && p.emit_len > 0;
}

rec PlwSlot {
    prepared:       query.PreparedQuery;
    capture:        project.RawLowerCapture;
    available:      body.Available;
    available_live: bool;
    live:           bool;
    mid:            session.ModuleId;
    m:              *ir.Module;
    diags:          *diagnostic.DiagnosticStore;
    failed:         bool;
    fail:           fail.Fail;
    d:              cdur.Duration;
}

rec ParallelLower {
    p:        *project.Project;
    next:     i64;
    stop:     i64;
    main_id:  intern.StrId;
    slots:    *PlwSlot;
    slot_len: u32;
}

fun plw_worker_main(arg: *u8) {
    val pl: *ParallelLower = arg::*ParallelLower;
    if (pl == nil) { ret; }

    for (true) {
        if (atomic.load(?pl.stop) != 0) { ret; }
        val idx_raw: i64 = atomic.fetch_add(?pl.next, 1::i64);
        if (idx_raw >= pl.slot_len::i64) { ret; }

        val slot: *PlwSlot        = ?pl.slots[idx_raw::usize];
        val t0:   readout.Instant = readout.sample();
        val r:    err[fail.Fail]  = lower_optimize(pl.p, slot.m, pl.main_id, slot.capture.available, slot.diags);
        slot.d = readout.elapsed(t0);
        if (sel r.err) {
            slot.fail   = r.err;
            slot.failed = true;
            atomic.store(?pl.stop, 1::i64);
            ret;
        }
    }
}

fun run_lower_parallel(p: *project.Project) err[fail.Fail] {
    val count: u32 = p.emit_len;
    if (count == 0) { ret err[fail.Fail].ok{}; }
    val allocated: res[*PlwSlot, A.Error] = A.allocate[PlwSlot](p.alloc, count::usize);
    if (sel allocated.err) { ret err[fail.Fail].err{fail.refused(allocated.err)}; }
    val slots: *PlwSlot = allocated.ok;
    fin { A.deallocate[PlwSlot](p.alloc, slots, count::usize); }
    var i: u32 = 0;
    for (i < count) {
        slots[i] = PlwSlot{};
        i        = i + 1;
    }
    var result: err[fail.Fail] = run_lower_batch(p, slots, count);
    i = 0;
    for (i < count) {
        if (slots[i].available_live) {
            body.available_dnit(?slots[i].available, slots[i].m);
            slots[i].available_live = false;
        }
        release_lower_output(p.s.queries.a, slots[i].capture.output);
        slots[i].capture.output = query.QueryOutput{};
        if (slots[i].live) {
            val cancelled: err[fail.Fail] = query.cancel_prepared(?p.s.queries, slots[i].prepared);
            if (sel cancelled.err) {
                if (!(sel result.err && !(fail.is_reported(result.err)))) {
                    result = err[fail.Fail].err{cancelled.err};
                }
            }
        }
        i = i + 1;
    }
    ret result;
}

fun prime_inline_bodies(p: *project.Project, capture: *project.RawLowerCapture) err[fail.Fail] {
    val saved: *project.RawLowerCapture = p.raw_lower_capture;
    p.raw_lower_capture = capture;
    fin { p.raw_lower_capture = saved; }
    val got: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, query.Q_INLINE_BODIES, capture.key);
    if (sel got.err) { ret err[fail.Fail].err{got.err}; }
    ret err[fail.Fail].ok{};
}

fun prepare_lower_slot(p: *project.Project, capture: *project.RawLowerCapture) res[query.PreparedQuery, fail.Fail] {
    val saved: *project.RawLowerCapture = p.raw_lower_capture;
    p.raw_lower_capture = capture;
    fin { p.raw_lower_capture = saved; }
    ret query.prepare[project.Project](?p.queries, p, query.Q_LOWER, capture.key, q_lower_raw_compute);
}

fun run_lower_batch(p: *project.Project, slots: *PlwSlot, emit_len: u32) err[fail.Fail] {
    var slot_len: u32 = 0;
    var ti:       u32 = 0;
    for (ti < emit_len) {
        val mid:      session.ModuleId     = p.topo[ti];
        val reusable: res[bool, fail.Fail] = lower_reusable(p, mid);
        if (sel reusable.err) {
            ret err[fail.Fail].err{reusable.err};
        }
        if (!reusable.ok && !persistent.restored(p, project.module_at(p, mid::u32))) {
            slots[slot_len].mid    = mid;
            slots[slot_len].m      = nil;
            slots[slot_len].failed = false;
            slots[slot_len].d      = 0;
            slot_len               = slot_len + 1;
        }
        ti = ti + 1;
    }
    if (slot_len <= 1) {
        ret err[fail.Fail].ok{};
    }
    var prime: u32 = 0;
    for (prime < slot_len) {
        val m: *project.ModuleEntry = project.module_at(p, slots[prime].mid::u32);
        slots[prime].capture.key = back_half_key_for(p, m);
        if (p.req.opt == pipeline.OPT_RELEASE) {
            val initialized: err[fail.Fail] = body.available_init(?slots[prime].available, m.fqn);
            if (sel initialized.err) { ret err[fail.Fail].err{initialized.err}; }
            slots[prime].available_live    = true;
            slots[prime].capture.available = ?slots[prime].available;
            val primed: err[fail.Fail] = prime_inline_bodies(p, ?slots[prime].capture);
            if (sel primed.err) { ret primed; }
        }
        prime = prime + 1;
    }

    val test_mode: bool = test_build(p);

    var si: u32 = 0;
    for (si < slot_len) {
        val mid: session.ModuleId     = slots[si].mid;
        val m:   *project.ModuleEntry = project.module_at(p, mid::u32);

        val prepared: res[query.PreparedQuery, fail.Fail] = prepare_lower_slot(p, ?slots[si].capture);
        if (sel prepared.err) { ret err[fail.Fail].err{prepared.err}; }
        slots[si].prepared = prepared.ok;
        slots[si].live     = true;
        val view: res[query.QueryView, fail.Fail] = query.prepared_view(?p.s.queries, slots[si].prepared);
        if (sel view.err) { ret err[fail.Fail].err{view.err}; }
        slots[si].m = ir_handle_decode(view.ok);
        if (slots[si].m == nil) { ret err[fail.Fail].err{fail.message("prepared lowering has no IR owner")}; }
        val store: res[*diagnostic.DiagnosticStore, fail.Fail] = query.prepared_diags(?p.s.queries, slots[si].prepared);
        if (sel store.err) { ret err[fail.Fail].err{store.err}; }
        slots[si].diags = store.ok;
        si              = si + 1;
    }

    if (p.raw_lower_capture != nil) { ret err[fail.Fail].err{fail.message("lower: synchronous raw capture escaped into worker execution")}; }
    var nworkers: u32 = p.req.jobs;
    if (nworkers == 0)       { nworkers = 1; }
    if (nworkers > slot_len) { nworkers = slot_len; }

    val nid: res[intern.StrId, fail.Fail] = neutralize_id(p, test_mode);
    if (sel nid.err) {
        ret err[fail.Fail].err{nid.err};
    }

    var pl: ParallelLower;
    pl.p        = p;
    pl.next     = 0;
    pl.stop     = 0;
    pl.main_id  = nid.ok;
    pl.slots    = slots;
    pl.slot_len = slot_len;

    val t_opt:   readout.Instant = readout.span_begin(p.events);
    var threads: *thread.Thread  = nil;
    val extra:   u32             = nworkers - 1;
    if (extra > 0) {
        val rt: res[*thread.Thread, A.Error] = A.allocate[thread.Thread](p.alloc, extra::usize);
        if (sel rt.err) {
            ret err[fail.Fail].err{fail.refused(rt.err)};
        }
        threads = rt.ok;
        var k: u32 = 0;
        for (k < extra) {
            thread.spawn_with(plw_worker_main, (?pl)::*u8, ?threads[k]);
            k = k + 1;
        }
    }

    plw_worker_main((?pl)::*u8);

    if (extra > 0) {
        var k: u32 = 0;
        for (k < extra) {
            if (threads[k].tid >= 0) { thread.join(?threads[k]); }
            k = k + 1;
        }
        A.deallocate[thread.Thread](p.alloc, threads, extra::usize);
    }
    readout.span_end(p.events, readout.PH_OPTIMIZE, readout.PH_LOWER, t_opt);

    readout.phase_workers(p.events, readout.PH_OPTIMIZE, nworkers);
    var ii: u32 = 0;
    for (ii < slot_len) {
        val im: *project.ModuleEntry = project.module_at(p, slots[ii].mid::u32);
        readout.item_dur(p.events, readout.PH_OPTIMIZE, project.fqn_name(p, im.fqn), slots[ii].d);
        ii = ii + 1;
    }

    var ei: u32 = 0;
    for (ei < slot_len) {
        if (slots[ei].failed) {
            val result: err[fail.Fail] = query.complete_prepared(?p.s.queries, slots[ei].prepared,
                err[fail.Fail].err{slots[ei].fail});
            slots[ei].live = false;
            ret result;
        }
        ei = ei + 1;
    }
    ei = 0;
    for (ei < slot_len) {
        val result: err[fail.Fail] = query.complete_prepared(?p.s.queries, slots[ei].prepared, err[fail.Fail].ok{});
        slots[ei].live = false;
        if (sel result.err) { ret result; }
        ei = ei + 1;
    }
    ret err[fail.Fail].ok{};
}

fun ensure_lower_visit_capacity(p: *project.Project, needed: u32) err[fail.Fail] {
    if (p.lower_visit_cap >= needed) { ret err[fail.Fail].ok{}; }
    var new_cap: u32 = p.lower_visit_cap;
    if (new_cap == 0) { new_cap = load.INITIAL_MODULE_CAP; }
    for (new_cap < needed) { new_cap = new_cap * 2; }

    if (p.lower_visit_gen == nil) {
        val r: res[*u32, A.Error] = A.allocate[u32](p.s.alloc, new_cap::usize);
        if (sel r.err) { ret err[fail.Fail].err{fail.refused(r.err)}; }
        p.lower_visit_gen = r.ok;
    }
    or {
        val r: res[*u32, A.Error] = A.reallocate[u32](p.s.alloc, p.lower_visit_gen, p.lower_visit_cap::usize, new_cap::usize);
        if (sel r.err) { ret err[fail.Fail].err{fail.refused(r.err)}; }
        p.lower_visit_gen = r.ok;
    }
    var i: u32 = p.lower_visit_cap;
    for (i < new_cap) {
        p.lower_visit_gen[i] = 0;
        i                    = i + 1;
    }
    p.lower_visit_cap = new_cap;
    ret err[fail.Fail].ok{};
}

fun collect_lower_closure(p: *project.Project, m: *project.ModuleEntry) res[LowerClosure, fail.Fail] {
    var cl: LowerClosure;
    cl.list  = nil;
    cl.count = 0;
    cl.cap   = 0;
    if (m.dep_count == 0 || project.module_count(p) == 0) { ret res[LowerClosure, fail.Fail].ok{cl}; }

    val cr: err[fail.Fail] = ensure_lower_visit_capacity(p, project.module_count(p));
    if (sel cr.err) { ret res[LowerClosure, fail.Fail].err{cr.err}; }
    p.lower_visit_epoch = p.lower_visit_epoch + 1;
    val epoch: u32  = p.lower_visit_epoch;
    val gen:   *u32 = p.lower_visit_gen;

    val lr: res[*session.ModuleId, A.Error] = A.allocate[session.ModuleId](p.s.alloc, project.module_count(p)::usize);
    if (sel lr.err) { ret res[LowerClosure, fail.Fail].err{fail.refused(lr.err)}; }
    val list:     *session.ModuleId = lr.ok;
    var list_len: u32               = 0;

    var i: u32 = 0;
    for (i < m.dep_count) {
        val d: session.ModuleId = m.deps[i];
        if (d::u32 < project.module_count(p) && gen[d::u32] != epoch) {
            gen[d::u32]    = epoch;
            list[list_len] = d;
            list_len       = list_len + 1;
        }
        i = i + 1;
    }

    var head: u32 = 0;
    for (head < list_len) {
        val cur: session.ModuleId     = list[head];
        val cm:  *project.ModuleEntry = project.module_at(p, cur::u32);
        var j:   u32                  = 0;
        for (j < cm.dep_count) {
            val d: session.ModuleId = cm.deps[j];
            if (d::u32 < project.module_count(p) && gen[d::u32] != epoch) {
                gen[d::u32]    = epoch;
                list[list_len] = d;
                list_len       = list_len + 1;
            }
            j = j + 1;
        }
        head = head + 1;
    }

    cl.list  = list;
    cl.count = list_len;
    cl.cap   = project.module_count(p);
    ret res[LowerClosure, fail.Fail].ok{cl};
}

fun free_lower_closure(alloc: *A.Allocator, cl: *LowerClosure) {
    if (cl.list == nil || cl.cap == 0) { ret; }
    A.deallocate[session.ModuleId](alloc, cl.list, cl.cap::usize);
    cl.list  = nil;
    cl.count = 0;
    cl.cap   = 0;
}

# the codegen flags are a request constant; the cell snapshot reads them from
# the lower operation on, so they are set before either back-half pass
fun set_codegen_flags_input(p: *project.Project) err[outcome.Fail] {
    var pflag: u32            = codegen.resolve_placement_policy(p.req.placement_policy);
    val pf:    err[fail.Fail] = query.set_input(?p.s.queries, query.Q_CODEGEN_FLAGS, 0, (?pflag)::*u8, 4);
    if (sel pf.err) { ret err[outcome.Fail].err{outcome.from_fail(pf.err)}; }
    ret err[outcome.Fail].ok{};
}

# the codegen product is registered from the lower pass on: the early restore
# asks whether the session still holds one before it asks the store
fun register_codegen_product(p: *project.Project) err[outcome.Fail] {
    if (!query.is_registered(?p.s.queries, query.Q_CODEGEN)) {
        val rcg: err[fail.Fail] = query.register_derived_owned(?p.s.queries, query.Q_CODEGEN, q_codegen_finalize);
        if (sel rcg.err) { ret err[outcome.Fail].err{outcome.from_fail(rcg.err)}; }
    }
    ret err[outcome.Fail].ok{};
}

pub fun prepare_codegen_pass(p: *project.Project) err[outcome.Fail] {
    val registered: err[outcome.Fail] = register_codegen_product(p);
    if (sel registered.err) { ret registered; }
    ret set_codegen_flags_input(p);
}

# the modules that still lower here are those without a product restored under
# this operation's snapshot; a module restored in the lower operation keeps its
# staged product when the snapshot is unchanged and lowers now if it changed
pub fun acquire_codegen_inputs(p: *project.Project) err[outcome.Fail] {
    var clear: u32 = 0;
    for (clear < project.module_count(p)) {
        project.module_at(p, clear).ir_module = nil;
        clear                                 = clear + 1;
    }
    val frontend: err[outcome.Fail] = acquire_frontend_inputs(p);
    if (sel frontend.err) { ret frontend; }
    val cached: err[outcome.Fail] = prepare_persistent_cache(p, readout.PH_CODEGEN);
    if (sel cached.err) { ret cached; }
    var i: u32 = 0;
    for (i < p.emit_len) {
        val mid: session.ModuleId = p.topo[i];
        if (persistent.restored(p, project.module_at(p, mid::u32))) {
            i = i + 1;
            cnt;
        }
        val acquired: err[fail.Fail] = run_lower_one(p, mid);
        if (sel acquired.err) { ret err[outcome.Fail].err{outcome.from_fail(acquired.err)}; }
        i = i + 1;
    }
    ret err[outcome.Fail].ok{};
}

# once per query operation, after the typed definitions are current: the
# compiler identity (once per project), then the cell snapshot through its
# query so an unchanged cell is not rehashed, then the store directory. its
# items are reported under the readout phase ph that runs it
pub fun prepare_persistent_cache(p: *project.Project, ph: u8) err[outcome.Fail] {
    if (!persistent.operation_active(p)) { ret err[outcome.Fail].err{outcome.internal("persistent cache requires the current query operation")}; }
    if (p.cache_initialized)             { ret err[outcome.Fail].ok{}; }
    if (!p.req.object_cache) {
        val disabled: err[fail.Fail] = persistent.prepare(p, nil);
        if (sel disabled.err) { ret err[outcome.Fail].err{outcome.from_fail(disabled.err)}; }
        ret err[outcome.Fail].ok{};
    }
    val identified: err[fail.Fail] = persistent.identify(p, ph);
    if (sel identified.err) { ret err[outcome.Fail].err{outcome.from_fail(identified.err)}; }
    if (!persistent.identity_available(p)) {
        val unidentified: err[fail.Fail] = persistent.prepare(p, nil);
        if (sel unidentified.err) { ret err[outcome.Fail].err{outcome.from_fail(unidentified.err)}; }
        ret err[outcome.Fail].ok{};
    }
    if (!query.is_registered(?p.s.queries, query.Q_CELL_SNAPSHOT)) {
        val rc: err[fail.Fail] = query.register_derived(?p.s.queries, query.Q_CELL_SNAPSHOT);
        if (sel rc.err) { ret err[outcome.Fail].err{outcome.from_fail(rc.err)}; }
    }
    val t_cell: readout.Instant                 = readout.item_begin(p.events);
    val cell:   res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, query.Q_CELL_SNAPSHOT, 0);
    if (sel cell.err) { ret err[outcome.Fail].err{outcome.from_fail(cell.err)}; }
    readout.item(p.events, ph, "cell snapshot", t_cell);
    if (cell.ok.value == nil || cell.ok.value_len != 32) { ret err[outcome.Fail].err{outcome.internal("Q_CELL_SNAPSHOT produced no digest")}; }
    val prepared: err[fail.Fail] = persistent.prepare(p, cell.ok.value::*[32]u8);
    if (sel prepared.err) { ret err[outcome.Fail].err{outcome.from_fail(prepared.err)}; }
    ret err[outcome.Fail].ok{};
}

pub fun run_codegen_pass(p: *project.Project) err[outcome.Fail] {
    val inputs: err[outcome.Fail] = acquire_codegen_inputs(p);
    if (sel inputs.err) { ret inputs; }
    var i: u32 = 0;
    for (i < p.emit_len) {
        val mid: session.ModuleId = p.topo[i];

        val r: err[fail.Fail] = run_codegen_one(p, mid);
        if (sel r.err) {
            ret err[outcome.Fail].err{outcome.from_fail(r.err)};
        }
        i = i + 1;
    }
    ret err[outcome.Fail].ok{};
}

pub fun code_sources(p: *project.Project, mid: session.ModuleId, a: *A.Allocator) res[CodeSources, fail.Fail] {
    if (!isa.emits_whole_module(p.target.isa)) { ret res[CodeSources, fail.Fail].ok{sources_empty()}; }
    val n: u32 = project.module_count(p);
    if (n == 0) { ret res[CodeSources, fail.Fail].ok{sources_empty()}; }

    val rm: res[*bool, A.Error] = A.allocate[bool](a, n::usize);
    if (sel rm.err) { ret res[CodeSources, fail.Fail].err{fail.refused(rm.err)}; }
    val mark: *bool = rm.ok;
    var i:    u32   = 0;
    for (i < n) {
        mark[i] = false;
        i       = i + 1;
    }
    mark[mid::u32] = true;

    var changed: bool = true;
    for (changed) {
        changed = false;
        i       = 0;
        for (i < n) {
            if (!mark[i]) {
                i = i + 1;
                cnt;
            }
            val im: *ir.Module = project.module_at(p, i).ir_module;
            if (im == nil) {
                i = i + 1;
                cnt;
            }
            var fi: u32 = 0;
            for (fi < im.function_len) {
                val fn: *ir.Function = ?im.functions[fi];
                if ((fn.flags & ir.FN_FLAG_EXTERN) == 0 || fn.is_import) {
                    fi = fi + 1;
                    cnt;
                }
                val def: u32 = definer_of(p, fn.name);
                if (def != n && !mark[def]) {
                    mark[def] = true;
                    changed   = true;
                }
                fi = fi + 1;
            }
            var gi: u32 = 0;
            for (gi < im.global_len) {
                val g: *ir.Global = ?im.globals[gi];
                if (!g.is_extern || g.is_import) {
                    gi = gi + 1;
                    cnt;
                }
                val gdef: u32 = global_definer_of(p, g.name);
                if (gdef != n && !mark[gdef]) {
                    mark[gdef] = true;
                    changed    = true;
                }
                gi = gi + 1;
            }
            i = i + 1;
        }
    }

    var count: u32 = 0;
    i = 0;
    for (i < n) {
        if (mark[i] && i != mid::u32 && project.module_at(p, i).ir_module != nil) { count = count + 1; }
        i = i + 1;
    }
    if (count == 0) {
        A.deallocate[bool](a, mark, n::usize);
        ret res[CodeSources, fail.Fail].ok{sources_empty()};
    }

    var cs: CodeSources               = sources_empty();
    val rs: res[**ir.Module, A.Error] = A.allocate[*ir.Module](a, count::usize);
    if (sel rs.err) {
        A.deallocate[bool](a, mark, n::usize);
        ret res[CodeSources, fail.Fail].err{fail.refused(rs.err)};
    }
    cs.set.mods = rs.ok;
    val ri: res[*session.ModuleId, A.Error] = A.allocate[session.ModuleId](a, count::usize);
    if (sel ri.err) {
        A.deallocate[*ir.Module](a, cs.set.mods, count::usize);
        A.deallocate[bool](a, mark, n::usize);
        ret res[CodeSources, fail.Fail].err{fail.refused(ri.err)};
    }
    cs.ids = ri.ok;
    cs.cap = count;

    var ti: u32 = 0;
    for (ti < p.topo_len) {
        val tid: u32 = p.topo[ti]::u32;
        if (mark[tid] && tid != mid::u32 && project.module_at(p, tid).ir_module != nil && cs.set.len < count) {
            cs.set.mods[cs.set.len] = project.module_at(p, tid).ir_module;
            cs.ids[cs.set.len]      = p.topo[ti];
            cs.set.len              = cs.set.len + 1;
        }
        ti = ti + 1;
    }
    A.deallocate[bool](a, mark, n::usize);
    ret res[CodeSources, fail.Fail].ok{cs};
}

pub rec CodeSources {
    set: unit.IrSet;
    ids: *session.ModuleId;
    cap: u32;
}

pub fun sources_empty() CodeSources {
    var cs: CodeSources;
    cs.set = unit.ir_set_empty();
    cs.ids = nil;
    cs.cap = 0;
    ret cs;
}

pub fun sources_dnit(a: *A.Allocator, cs: *CodeSources) {
    if (cs.cap > 0) {
        if (cs.set.mods != nil) { A.deallocate[*ir.Module](a, cs.set.mods, cs.cap::usize); }
        if (cs.ids != nil)      { A.deallocate[session.ModuleId](a, cs.ids, cs.cap::usize); }
    }
    cs.set.mods = nil;
    cs.set.len  = 0;
    cs.ids      = nil;
    cs.cap      = 0;
}

fun definer_of(p: *project.Project, name: intern.StrId) u32 {
    var i: u32 = 0;
    for (i < project.module_count(p)) {
        val im: *ir.Module = project.module_at(p, i).ir_module;
        if (im != nil && unit.defined_index(im, name) != unit.UNIT_NONE) { ret i; }
        i = i + 1;
    }
    ret project.module_count(p);
}

fun global_definer_of(p: *project.Project, name: intern.StrId) u32 {
    var i: u32 = 0;
    for (i < project.module_count(p)) {
        val im: *ir.Module = project.module_at(p, i).ir_module;
        if (im != nil && unit.defined_global_index(im, name) != unit.UNIT_NONE) { ret i; }
        i = i + 1;
    }
    ret project.module_count(p);
}

fun run_codegen_one(p: *project.Project, mid: session.ModuleId) err[fail.Fail] {
    val m: *project.ModuleEntry = project.module_at(p, mid::u32);

    val e_r: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, query.Q_CODEGEN, back_half_key_for(p, m));
    if (sel e_r.err) { ret err[fail.Fail].err{e_r.err}; }
    val img: *of.ObjectImage = image_handle_decode(e_r.ok);
    if (img == nil) { ret err[fail.Fail].err{fail.message("Q_CODEGEN produced no result handle")}; }

    m.object_image = img;
    ret err[fail.Fail].ok{};
}

pub fun q_codegen_compute(p: *project.Project, key: u64, alloc: *A.Allocator, diags: *diagnostic.DiagnosticStore) res[query.QueryOutput, fail.Fail] {
    val db: *query.QueryDb   = ?p.s.queries;
    val s:  *session.Session = p.s;

    val stable: session.StableModuleId = key::u32::session.StableModuleId;
    val mid:    session.ModuleId       = session.module_id_for_stable(s, stable);
    if (mid == session.MODULE_NIL) { ret res[query.QueryOutput, fail.Fail].err{fail.message("Q_CODEGEN: stable id not loaded this build")}; }
    val m: *project.ModuleEntry = project.module_at(p, mid::u32);
    if (persistent.staged_restored(p, m)) { ret q_codegen_restored(p, mid, alloc); }
    val lower_owner: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, query.Q_LOWER, key);
    if (sel lower_owner.err) { ret res[query.QueryOutput, fail.Fail].err{lower_owner.err}; }
    val irmod: *ir.Module = ir_handle_decode(lower_owner.ok);
    if (irmod == nil) { ret res[query.QueryOutput, fail.Fail].err{fail.message("Q_CODEGEN: module has no lowered IR")}; }
    m.ir_module = irmod;
    val rt: err[fail.Fail] = query.depend[project.Project](?p.queries, p, query.Q_TARGET, 0);
    if (sel rt.err) { ret res[query.QueryOutput, fail.Fail].err{rt.err}; }
    val rpp: err[fail.Fail] = query.depend[project.Project](?p.queries, p, query.Q_CODEGEN_FLAGS, 0);
    if (sel rpp.err) { ret res[query.QueryOutput, fail.Fail].err{rpp.err}; }

    val srcs_r: res[CodeSources, fail.Fail] = code_sources(p, mid, s.alloc);
    if (sel srcs_r.err) { ret res[query.QueryOutput, fail.Fail].err{srcs_r.err}; }
    var srcs: CodeSources = srcs_r.ok;
    var di:   u32         = 0;
    for (di < srcs.set.len) {
        val dm: *project.ModuleEntry = project.module_at(p, srcs.ids[di]::u32);
        val rd: err[fail.Fail]       = query.depend[project.Project](?p.queries, p, query.Q_LOWER, back_half_key_for(p, dm));
        if (sel rd.err) {
            sources_dnit(s.alloc, ?srcs);
            ret res[query.QueryOutput, fail.Fail].err{rd.err};
        }
        di = di + 1;
    }

    if (m.staged_image == nil) {
        val restored: res[bool, fail.Fail] = persistent.restore(p, mid, readout.PH_CODEGEN);
        if (sel restored.err) {
            sources_dnit(s.alloc, ?srcs);
            ret res[query.QueryOutput, fail.Fail].err{restored.err};
        }
    }
    val staged: *of.ObjectImage = persistent.take_staged(p, m);
    if (staged != nil) {
        sources_dnit(s.alloc, ?srcs);
        val published: err[fail.Fail] = persistent.publish(p, m, staged);
        if (sel published.err) {
            obj.dnit(staged);
            A.deallocate[of.ObjectImage](s.alloc, staged, 1);
            ret res[query.QueryOutput, fail.Fail].err{published.err};
        }
        ret image_handle_encode(alloc, staged);
    }

    val dbg_r: res[codegen.DebugInfo, fail.Fail] = debug_info_of(p);
    if (sel dbg_r.err) {
        sources_dnit(s.alloc, ?srcs);
        ret res[query.QueryOutput, fail.Fail].err{dbg_r.err};
    }

    val t_cg:   readout.Instant                = readout.item_begin(p.events);
    val res_cg: res[of.ObjectImage, fail.Fail] = codegen.codegen_unit(s, ?p.target, irmod, srcs.set, nil, p.req.placement_policy, dbg_r.ok, diags);
    sources_dnit(s.alloc, ?srcs);
    if (sel res_cg.err) { ret res[query.QueryOutput, fail.Fail].err{res_cg.err}; }
    readout.item(p.events, readout.PH_CODEGEN, project.fqn_name(p, m.fqn), t_cg);
    var img:       of.ObjectImage = res_cg.ok;
    val published: err[fail.Fail] = persistent.publish(p, m, ?img);
    if (sel published.err) {
        obj.dnit(?img);
        ret res[query.QueryOutput, fail.Fail].err{published.err};
    }

    val br: res[*of.ObjectImage, A.Error] = A.allocate[of.ObjectImage](alloc, 1::usize);
    if (sel br.err) {
        obj.dnit(?img);
        ret res[query.QueryOutput, fail.Fail].err{fail.refused(br.err)};
    }
    val box: *of.ObjectImage = br.ok;
    box[0] = img;
    ret image_handle_encode(alloc, box);
}

# a product the store restored becomes the module's codegen product with the
# edges a generated one carries directly (its typed definition, the target and
# the codegen flags) plus the cell snapshot, which is the persistent key's
# in-process image: any input the key covers advances it
fun q_codegen_restored(p: *project.Project, mid: session.ModuleId, alloc: *A.Allocator) res[query.QueryOutput, fail.Fail] {
    val m:          *project.ModuleEntry           = project.module_at(p, mid::u32);
    val definition: res[scx.Definition, fail.Fail] = read_definition(p::ptr, mid, scx.DEFINITION_TYPED);
    if (sel definition.err) { ret res[query.QueryOutput, fail.Fail].err{definition.err}; }
    val rt: err[fail.Fail] = query.depend[project.Project](?p.queries, p, query.Q_TARGET, 0);
    if (sel rt.err) { ret res[query.QueryOutput, fail.Fail].err{rt.err}; }
    val rpp: err[fail.Fail] = query.depend[project.Project](?p.queries, p, query.Q_CODEGEN_FLAGS, 0);
    if (sel rpp.err) { ret res[query.QueryOutput, fail.Fail].err{rpp.err}; }
    val cell: err[fail.Fail] = query.depend[project.Project](?p.queries, p, query.Q_CELL_SNAPSHOT, 0);
    if (sel cell.err) { ret res[query.QueryOutput, fail.Fail].err{cell.err}; }
    val staged: *of.ObjectImage = persistent.take_staged(p, m);
    if (staged == nil) { ret res[query.QueryOutput, fail.Fail].err{fail.message("Q_CODEGEN: restored product left the module")}; }
    ret image_handle_encode(alloc, staged);
}

pub fun q_codegen_finalize(value: *u8, value_len: u32, alloc: *A.Allocator) {
    if (value == nil || value_len::usize < $size_of(ptr)) { ret; }
    val slot: *ptr            = value::ptr::*ptr;
    val r:    *of.ObjectImage = slot[0]::*of.ObjectImage;
    if (r == nil) { ret; }
    obj.dnit(r);
    A.deallocate[of.ObjectImage](alloc, r, 1::usize);
}

fun image_handle_encode(alloc: *A.Allocator, r: *of.ObjectImage) res[query.QueryOutput, fail.Fail] {
    val n:  u32               = $size_of(ptr)::u32;
    val rb: res[*u8, A.Error] = A.allocate[u8](alloc, n::usize);
    if (sel rb.err) {
        obj.dnit(r);
        A.deallocate[of.ObjectImage](alloc, r, 1::usize);
        ret res[query.QueryOutput, fail.Fail].err{fail.refused(rb.err)};
    }
    val buf:  *u8  = rb.ok;
    val slot: *ptr = buf::ptr::*ptr;
    slot[0] = r::ptr;
    var out: query.QueryOutput;
    out.bytes = buf;
    out.len   = n;
    ret res[query.QueryOutput, fail.Fail].ok{out};
}

fun image_handle_decode(e: query.QueryView) *of.ObjectImage {
    if (e.value == nil || e.value_len::usize < $size_of(ptr)) { ret nil; }
    val slot: *ptr = e.value::ptr::*ptr;
    ret slot[0]::*of.ObjectImage;
}

pub fun prepare_link_pass(p: *project.Project) err[outcome.Fail] {
    if (!query.is_registered(?p.s.queries, query.Q_LINK)) {
        val rln: err[fail.Fail] = query.register_derived(?p.s.queries, query.Q_LINK);
        if (sel rln.err) { ret err[outcome.Fail].err{outcome.from_fail(rln.err)}; }
    }

    ret err[outcome.Fail].ok{};
}

pub fun run_link_pass(p: *project.Project) res[bool, outcome.Fail] {
    val images: err[outcome.Fail] = run_codegen_pass(p);
    if (sel images.err) { ret res[bool, outcome.Fail].err{images.err}; }
    val prior: query.Revision                  = query.peek_revision(?p.s.queries, query.Q_LINK, 0);
    val e_r:   res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, query.Q_LINK, 0);
    if (sel e_r.err) { ret res[bool, outcome.Fail].err{outcome.from_fail(e_r.err)}; }
    val now: query.Revision = e_r.ok.last_changed;
    ret res[bool, outcome.Fail].ok{now != prior};
}

pub fun q_link_compute(p: *project.Project, key: u64, alloc: *A.Allocator, diags: *diagnostic.DiagnosticStore) res[query.QueryOutput, fail.Fail] {
    val db: *query.QueryDb   = ?p.s.queries;
    val s:  *session.Session = p.s;

    var fb: dq.FpBuf;
    fb.alloc = alloc;
    fb.buf   = nil;
    fb.len   = 0;
    fb.cap   = 0;
    fin { dq.fp_free(?fb); }

    val rt: res[query.Revision, fail.Fail] = query.revision[project.Project](?p.queries, p, query.Q_TARGET, 0);
    if (sel rt.err) { ret res[query.QueryOutput, fail.Fail].err{rt.err}; }
    val wt: err[fail.Fail] = dq.fp_u64(?fb, rt.ok);
    if (sel wt.err) { ret res[query.QueryOutput, fail.Fail].err{wt.err}; }

    val rc: res[query.Revision, fail.Fail] = query.revision[project.Project](?p.queries, p, query.Q_LINK_CONFIG, 0);
    if (sel rc.err) { ret res[query.QueryOutput, fail.Fail].err{rc.err}; }
    val wc: err[fail.Fail] = dq.fp_u64(?fb, rc.ok);
    if (sel wc.err) { ret res[query.QueryOutput, fail.Fail].err{wc.err}; }

    val wn: err[fail.Fail] = dq.fp_u32(?fb, p.emit_len);
    if (sel wn.err) { ret res[query.QueryOutput, fail.Fail].err{wn.err}; }
    var i: u32 = 0;
    for (i < p.emit_len) {
        val m:  *project.ModuleEntry           = project.module_at(p, (p.topo[i])::u32);
        val rd: res[query.Revision, fail.Fail] = query.revision[project.Project](?p.queries, p, query.Q_CODEGEN, back_half_key_for(p, m));
        if (sel rd.err) { ret res[query.QueryOutput, fail.Fail].err{rd.err}; }
        val wm: err[fail.Fail] = dq.fp_u64(?fb, rd.ok);
        if (sel wm.err) { ret res[query.QueryOutput, fail.Fail].err{wm.err}; }
        i = i + 1;
    }

    ret dq.fp_take(?fb);
}

fun own_type_export(p: *project.Project, mid: session.ModuleId, symbol: *resolve.Symbol,
    sr: *sema.SemaResult, ctx: *comptime.ComptimeCtx) res[scx.TypeExport, fail.Fail] {
    var row: scx.TypeExport = scx.TypeExport{
        origin:   project.module_at(p, mid::u32).stable_id, canon: symbol.canon, ty: type.TYPE_NIL,
        constant: resolve.ExportConstant{name: symbol.canon}
    };
    if (symbol.definition_kind == resolve.SYM_USE) { ret res[scx.TypeExport, fail.Fail].ok{row}; }
    if (symbol.origin != mid || sr == nil || symbol.decl == id.DECL_NIL || symbol.decl >= sr.decl_count) {
        ret res[scx.TypeExport, fail.Fail].err{fail.message("typed export has no matching current declaration")};
    }
    row.ty = sr.decl_type[symbol.decl];
    if (symbol.definition_kind == resolve.SYM_VAL) {
        val found: opt[comptime.NamedConst] = comptime.lookup(ctx, symbol.canon);
        if (sel found.some) {
            val constant: comptime.NamedConst = found.some;
            row.constant.present = true;
            row.constant.gated   = constant.gated;
            row.constant.value   = constant.value;
            if (constant.value.kind == comptime.CT_KIND_CONST_ELEM) {
                row.definition_incarnation = project.module_at(p, mid::u32).a.incarnation;
            }
        }
    }
    ret res[scx.TypeExport, fail.Fail].ok{row};
}

rec OriginSurface { module: session.ModuleId; surface: scx.ModuleSema; }

fun free_origin_surfaces(decoded: *vector.Vector[OriginSurface]) {
    var i: usize = 0;
    for (i < decoded.len) {
        scx.module_sema_dnit(?decoded.data[i].surface);
        i = i + 1;
    }
    vector.dnit[OriginSurface](decoded);
}

# one decode per origin module while a surface is built, however many symbols it forwards
fun origin_surface(p: *project.Project, mid: session.ModuleId, decoded: *vector.Vector[OriginSurface]) res[*scx.ModuleSema, fail.Fail] {
    var i: usize = 0;
    for (i < decoded.len) {
        if (decoded.data[i].module == mid) { ret res[*scx.ModuleSema, fail.Fail].ok{?decoded.data[i].surface}; }
        i = i + 1;
    }
    val acquired: res[scx.ModuleSema, fail.Fail] = read_typed_surface(p, mid, p.s.alloc);
    if (sel acquired.err) { ret res[*scx.ModuleSema, fail.Fail].err{acquired.err}; }
    var surface: scx.ModuleSema      = acquired.ok;
    val added:   res[usize, A.Error] = vector.push[OriginSurface](decoded, OriginSurface{module: mid, surface: surface});
    if (sel added.err) {
        scx.module_sema_dnit(?surface);
        ret res[*scx.ModuleSema, fail.Fail].err{fail.refused(added.err)};
    }
    ret res[*scx.ModuleSema, fail.Fail].ok{?decoded.data[decoded.len - 1].surface};
}

fun imported_type_export(p: *project.Project, symbol: *resolve.Symbol,
    decoded: *vector.Vector[OriginSurface]) res[scx.TypeExport, fail.Fail] {
    val mid: session.ModuleId = symbol.origin;
    if (mid == session.MODULE_NIL || mid::u32 >= project.module_count(p)) { ret res[scx.TypeExport, fail.Fail].err{fail.message("forwarded type origin is not loaded")}; }
    val acquired: res[*scx.ModuleSema, fail.Fail] = origin_surface(p, mid, decoded);
    if (sel acquired.err) { ret res[scx.TypeExport, fail.Fail].err{acquired.err}; }
    val surface: *scx.ModuleSema        = acquired.ok;
    val origin:  session.StableModuleId = project.module_at(p, mid::u32).stable_id;
    var i:       usize                  = 0;
    for (i < surface.exports.len) {
        val row: scx.TypeExport = surface.exports.data[i];
        if (row.origin == origin && row.canon == symbol.canon) { ret res[scx.TypeExport, fail.Fail].ok{row}; }
        i = i + 1;
    }
    ret res[scx.TypeExport, fail.Fail].err{fail.message("forwarded type has no acquired canonical public surface")};
}

fun build_type_surface(p: *project.Project, mid: session.ModuleId, rr: *resolve.ResolveResult,
    sr: *sema.SemaResult, a: *A.Allocator) res[scx.ModuleSema, fail.Fail] {
    var surface:     scx.ModuleSema = scx.module_sema_init(a, project.module_at(p, mid::u32).fqn, mid);
    var transferred: bool           = false;
    fin {
        if (!transferred) { scx.module_sema_dnit(?surface); }
    }
    var decoded: vector.Vector[OriginSurface] = vector.init[OriginSurface](p.s.alloc);
    fin { free_origin_surfaces(?decoded); }
    var i: u32 = 0;
    for (i < rr.pub_count) {
        val symbol:   *resolve.Symbol = ?rr.symbols[i];
        var captured: res[scx.TypeExport, fail.Fail];
        if (symbol.origin == mid) { captured = own_type_export(p, mid, symbol, sr, ?project.module_at(p, mid::u32).ctx); }
        or                        { captured = imported_type_export(p, symbol, ?decoded); }
        if (sel captured.err)     { ret res[scx.ModuleSema, fail.Fail].err{captured.err}; }
        val added: res[usize, A.Error] = vector.push[scx.TypeExport](?surface.exports, captured.ok);
        if (sel added.err) { ret res[scx.ModuleSema, fail.Fail].err{fail.refused(added.err)}; }
        i = i + 1;
    }
    transferred = true;
    ret res[scx.ModuleSema, fail.Fail].ok{surface};
}

fun prepared_surface_recipe(p: *project.Project, ty: type.TypeId) err[fail.Fail] {
    val field_table_for_r: opt[*type.FieldTable] = type.field_table_for(?p.s.types, ty);
    if (sel field_table_for_r.none) {
        ret err[fail.Fail].err{fail.message("public nominal recipe was not prepared by its acquired semantic owner")};
    }
    ret err[fail.Fail].ok{};
}

fun capture_surface_graph(p: *project.Project, surface: *scx.ModuleSema) res[fields.Graph, fail.Fail] {
    var roots: vector.Vector[type.TypeId] = vector.init[type.TypeId](surface.exports.a);
    fin { vector.dnit[type.TypeId](?roots); }
    var i: usize = 0;
    for (i < surface.exports.len) {
        val row:   *scx.TypeExport     = ?surface.exports.data[i];
        val added: res[usize, A.Error] = vector.push[type.TypeId](?roots, row.ty);
        if (sel added.err) { ret res[fields.Graph, fail.Fail].err{fail.refused(added.err)}; }
        if (row.constant.present) {
            val value: comptime.CTValue = row.constant.value;
            var extra: type.TypeId      = type.TYPE_NIL;
            if (value.kind == comptime.CT_KIND_TYPE)                                         { extra = value.data.t::type.TypeId; }
            or (value.kind == comptime.CT_KIND_FIELD || value.kind == comptime.CT_KIND_CASE) { extra = value.data.fld.owner::type.TypeId; }
            or (value.kind == comptime.CT_KIND_PACK_ELEM)                                    { extra = value.data.pelem.ty::type.TypeId; }
            or (value.kind == comptime.CT_KIND_CONST_ELEM)                                   { extra = value.data.celem.ty::type.TypeId; }
            val added: res[usize, A.Error] = vector.push[type.TypeId](?roots, extra);
            if (sel added.err) { ret res[fields.Graph, fail.Fail].err{fail.refused(added.err)}; }
        }
        i = i + 1;
    }
    var group:     fields.Roots                 = fields.Roots{data: roots.data, len: roots.len};
    val capture_r: res[fields.Graph, fail.Fail] = fields.capture[project.Project](p.s, surface.exports.a, ?group, 1, fields.RECIPES,
        project.module_at(p, surface.module::u32).ctx.env.target_defs, p, prepared_surface_recipe);
    if (sel capture_r.err) { ret res[fields.Graph, fail.Fail].err{capture_r.err}; }
    ret res[fields.Graph, fail.Fail].ok{capture_r.ok};
}

pub fun capture_build_config(p: *project.Project, alloc: *A.Allocator) res[query.QueryOutput, fail.Fail] {
    var fb: dq.FpBuf = dq.FpBuf{alloc: alloc};
    fin { dq.fp_free(?fb); }
    val written: err[fail.Fail] = write_build_config(?fb, p);
    if (sel written.err) { ret res[query.QueryOutput, fail.Fail].err{written.err}; }
    ret dq.fp_take(?fb);
}

# the configuration without the planner environment: what a persistent product
# may key on. steps that ran are keyed by their own fingerprint chain, and the
# inherited environment reaches an object only through them.
pub fun capture_build_identity(p: *project.Project, alloc: *A.Allocator) res[query.QueryOutput, fail.Fail] {
    var fb: dq.FpBuf = dq.FpBuf{alloc: alloc};
    fin { dq.fp_free(?fb); }
    val written: err[fail.Fail] = write_build_identity(?fb, p);
    if (sel written.err) { ret res[query.QueryOutput, fail.Fail].err{written.err}; }
    ret dq.fp_take(?fb);
}

# the build identity without the request: the persistent key hashes the request
# itself, with the project root in canonical form, so the spelled root stays out
pub fun capture_configuration_identity(p: *project.Project, alloc: *A.Allocator) res[query.QueryOutput, fail.Fail] {
    var fb: dq.FpBuf = dq.FpBuf{alloc: alloc};
    fin { dq.fp_free(?fb); }
    val written: err[fail.Fail] = write_configuration_identity(?fb, p);
    if (sel written.err) { ret res[query.QueryOutput, fail.Fail].err{written.err}; }
    ret dq.fp_take(?fb);
}

pub fun set_build_config_input(p: *project.Project) err[fail.Fail] {
    val captured: res[query.QueryOutput, fail.Fail] = capture_build_config(p, p.s.alloc);
    if (sel captured.err) { ret err[fail.Fail].err{captured.err}; }
    val bytes: query.QueryOutput = captured.ok;
    fin {
        if (bytes.bytes != nil) { A.deallocate[u8](p.s.alloc, bytes.bytes, bytes.len::usize); }
    }
    ret query.set_input(?p.s.queries, query.Q_TARGET, 0, bytes.bytes, bytes.len);
}

fun write_build_config(fb: *dq.FpBuf, p: *project.Project) err[fail.Fail] {
    val identity: err[fail.Fail] = write_build_identity(fb, p);
    if (sel identity.err) { ret identity; }
    ret write_step_environment(fb, p);
}

fun write_build_identity(fb: *dq.FpBuf, p: *project.Project) err[fail.Fail] {
    var digest: [32]u8;
    val hr:     err[outcome.Fail] = request.semantic_hash(fb.alloc, ?p.req, ?digest[0]);
    if (sel hr.err) { ret err[fail.Fail].err{fail.message(outcome.describe(hr.err))}; }
    val ah: err[fail.Fail] = dq.fp_bytes(fb, ?digest[0], request.HASH_SIZE::u32);
    if (sel ah.err) { ret ah; }
    ret write_configuration_identity(fb, p);
}

fun write_configuration_identity(fb: *dq.FpBuf, p: *project.Project) err[fail.Fail] {
    val tf: err[fail.Fail] = write_target_fingerprint(fb, p);
    if (sel tf.err) { ret tf; }

    val a5: err[fail.Fail] = dq.fp_name(fb, ?p.s.interner, p.target_entry.os_name);
    if (sel a5.err) { ret a5; }
    val a6: err[fail.Fail] = dq.fp_name(fb, ?p.s.interner, p.target_entry.isa_name);
    if (sel a6.err) { ret a6; }
    val a7: err[fail.Fail] = dq.fp_name(fb, ?p.s.interner, p.target_entry.abi_name);
    if (sel a7.err) { ret a7; }
    val apl: err[fail.Fail] = dq.fp_name(fb, ?p.s.interner, p.target_entry.platform_name);
    if (sel apl.err) { ret apl; }
    val a8: err[fail.Fail] = dq.fp_name(fb, ?p.s.interner, p.config.id);
    if (sel a8.err) { ret a8; }
    val a9: err[fail.Fail] = dq.fp_name(fb, ?p.s.interner, p.config.version);
    if (sel a9.err) { ret a9; }
    val ab: err[fail.Fail] = dq.fp_name(fb, ?p.s.interner, p.config.bin_name);
    if (sel ab.err) { ret ab; }
    # the root set decides which entries load and how gates are walked
    val ar: err[fail.Fail] = dq.fp_u8(fb, p.roots::u8);
    if (sel ar.err) { ret ar; }
    val rq: err[fail.Fail] = write_requirement_scopes(fb, p);
    if (sel rq.err) { ret rq; }
    ret write_step_declarations(fb, p);
}

# the `{artifact.<id>.out}` vocabulary each project's modules resolve an embed
# in: sema reads it, so a cell that resolves other requirements is another
# configuration and a module's products are not reused across the two
fun write_requirement_scopes(fb: *dq.FpBuf, p: *project.Project) err[fail.Fail] {
    val rc: err[fail.Fail] = dq.fp_u32(fb, p.config.req_scope_count);
    if (sel rc.err) { ret rc; }
    var si: u32 = 0;
    for (si < p.config.req_scope_count) {
        val sc: *manifest.RequirementScope = ?p.config.req_scopes[si];
        val ro: err[fail.Fail]             = dq.fp_name(fb, ?p.s.interner, sc.owner);
        if (sel ro.err) { ret ro; }
        var dependency: u8 = 0;
        if (sc.dependency) { dependency = 1; }
        val rd: err[fail.Fail] = dq.fp_u8(fb, dependency);
        if (sel rd.err) { ret rd; }
        val rn: err[fail.Fail] = dq.fp_u32(fb, sc.req_count);
        if (sel rn.err) { ret rn; }
        var ri: u32 = 0;
        for (ri < sc.req_count) {
            val rname: err[fail.Fail] = dq.fp_cstr(fb, sc.reqs[ri].name);
            if (sel rname.err) { ret rname; }
            val rout: err[fail.Fail] = dq.fp_cstr(fb, sc.reqs[ri].out);
            if (sel rout.err) { ret rout; }
            ri = ri + 1;
        }
        si = si + 1;
    }
    ret err[fail.Fail].ok{};
}

fun write_target_fingerprint(fb: *dq.FpBuf, p: *project.Project) err[fail.Fail] {
    var e: binary.Encoder = binary.encoder(fb.alloc, binary.LITTLE);
    if (!target.fingerprint(?p.target, ?e)) {
        binary.encoder_dnit(?e);
        ret err[fail.Fail].err{fail.message("out of memory fingerprinting the selected target")};
    }
    if (e.len > 0xFFFFFFFF::usize) {
        binary.encoder_dnit(?e);
        ret err[fail.Fail].err{fail.message("target fingerprint exceeds 32-bit length")};
    }
    val rl: err[fail.Fail] = dq.fp_u32(fb, e.len::u32);
    if (sel rl.err) {
        binary.encoder_dnit(?e);
        ret rl;
    }
    val rb: err[fail.Fail] = dq.fp_bytes(fb, e.data, e.len::u32);
    binary.encoder_dnit(?e);
    ret rb;
}

fun write_step_declarations(fb: *dq.FpBuf, p: *project.Project) err[fail.Fail] {
    val rc: err[fail.Fail] = dq.fp_u32(fb, p.config.step_count);
    if (sel rc.err) { ret rc; }
    var si: u32 = 0;
    for (si < p.config.step_count) {
        val st: *manifest.StepDef = ?p.config.steps[si];
        val rn: err[fail.Fail]    = dq.fp_name(fb, ?p.s.interner, st.name);
        if (sel rn.err) { ret rn; }
        val re: err[fail.Fail] = dq.fp_u32(fb, st.env_count);
        if (sel re.err) { ret re; }
        var ei: u32 = 0;
        for (ei < st.env_count) {
            val rk: err[fail.Fail] = dq.fp_name(fb, ?p.s.interner, st.env_keys[ei]);
            if (sel rk.err) { ret rk; }
            val rv: err[fail.Fail] = dq.fp_name(fb, ?p.s.interner, st.env_values[ei]);
            if (sel rv.err) { ret rv; }
            ei = ei + 1;
        }
        si = si + 1;
    }
    ret err[fail.Fail].ok{};
}

fun write_step_environment(fb: *dq.FpBuf, p: *project.Project) err[fail.Fail] {
    if (p.config.step_count == 0 && p.config.dep_count == 0) { ret dq.fp_u32(fb, 0); }
    val inherited: **u8 = env.environ();
    if (inherited == nil) { ret err[fail.Fail].err{fail.message("planner environment unavailable")}; }
    ret write_planner_environment(fb, inherited);
}

# planner inputs cover child inheritance and executable lookup for root and dependency steps
fun write_planner_environment(fb: *dq.FpBuf, inherited: **u8) err[fail.Fail] {
    val captured: res[step_env.Environment, outcome.Fail] = step_env.capture(fb.alloc, inherited);
    if (sel captured.err) { ret err[fail.Fail].err{fail.message(outcome.describe(captured.err))}; }
    var environment: step_env.Environment = captured.ok;
    fin { step_env.dnit(?environment); }
    val exported: res[step_env.Strings, outcome.Fail] = step_env.to_strings(?environment);
    if (sel exported.err) { ret err[fail.Fail].err{fail.message(outcome.describe(exported.err))}; }
    var strings: step_env.Strings = exported.ok;
    fin { step_env.strings_free(fb.alloc, ?strings); }
    val count: err[fail.Fail] = dq.fp_u32(fb, strings.count);
    if (sel count.err) { ret count; }
    var i: u32 = 0;
    for (i < strings.count) {
        val entry: err[fail.Fail] = dq.fp_cstr(fb, strings.items[i]);
        if (sel entry.err) { ret entry; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

test "mach.lang.driver.passes.write_build_config:distinguishes_target_identity" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }

    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val rr: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel rr.err) { ret 1; }

    val tx: res[target.Target, fail.Fail] = target.select(?reg, "x86_64", "linux", "sysv64");
    val ta: res[target.Target, fail.Fail] = target.select(?reg, "aarch64", "linux", "aapcs64");
    if (sel tx.err) { ret 1; }
    if (sel ta.err) { ret 1; }

    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var te: project.TargetEntry;
    te.os_name       = intern.STR_NIL;
    te.isa_name      = intern.STR_NIL;
    te.abi_name      = intern.STR_NIL;
    te.platform_name = intern.STR_NIL;
    var cfg: project.ProjectConfig;
    cfg.id       = intern.STR_NIL;
    cfg.version  = intern.STR_NIL;
    cfg.bin_name = intern.STR_NIL;

    var px: project.Project;
    px.s            = ?s;
    px.req          = request.defaults();
    px.target       = tx.ok;
    px.target_entry = ?te;
    px.config       = cfg;

    var pa: project.Project;
    pa.s            = ?s;
    pa.req          = request.defaults();
    pa.target       = ta.ok;
    pa.target_entry = ?te;
    pa.config       = cfg;

    var dx: [32]u8;
    var da: [32]u8;
    if (!ut_fp_digest(?alloc, ?px, ?dx[0])) { ret 1; }
    if (!ut_fp_digest(?alloc, ?pa, ?da[0])) { ret 1; }
    if (!ut_digest_differs(?dx[0], ?da[0])) { ret 1; }
    ret 0;
}

# the root set and the requirement scopes are configuration: a union cell and an
# artifact cell of one target are different builds, as are two cells whose modules
# resolve `{artifact.<id>.out}` over different requirements (#3774)
test "mach.lang.driver.passes.write_build_config:root_set_and_requirement_scopes_move_the_fingerprint" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }

    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val rr: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel rr.err) { ret 1; }
    val tx: res[target.Target, fail.Fail] = target.select(?reg, "x86_64", "linux", "sysv64");
    if (sel tx.err) { ret 1; }

    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }

    var te: project.TargetEntry;
    te.os_name       = intern.STR_NIL;
    te.isa_name      = intern.STR_NIL;
    te.abi_name      = intern.STR_NIL;
    te.platform_name = intern.STR_NIL;
    var cfg: project.ProjectConfig;
    cfg.id       = intern.STR_NIL;
    cfg.version  = intern.STR_NIL;
    cfg.bin_name = intern.STR_NIL;

    var base: project.Project;
    base.s            = ?s;
    base.req          = request.defaults();
    base.target       = tx.ok;
    base.target_entry = ?te;
    base.config       = cfg;
    base.roots        = project.ROOT_ARTIFACT;
    var d_base: [32]u8;
    if (!ut_fp_digest(?alloc, ?base, ?d_base[0])) { ret 1; }

    var union_cell: project.Project = base;
    union_cell.roots = project.ROOT_UNION;
    var d_union: [32]u8;
    if (!ut_fp_digest(?alloc, ?union_cell, ?d_union[0])) { ret 1; }
    if (!ut_digest_differs(?d_base[0], ?d_union[0]))     { ret 2; }

    var req:   manifest.ArtifactReq      = manifest.ArtifactReq{name: "shader-vert", out: "out/spv/vert.spv"};
    var scope: manifest.RequirementScope = manifest.RequirementScope{owner: intern.STR_NIL, dependency: false,
        reqs: ?req, req_count: 1};
    var scoped: project.Project = base;
    scoped.config.req_scopes      = ?scope;
    scoped.config.req_scope_count = 1;
    var d_scoped: [32]u8;
    if (!ut_fp_digest(?alloc, ?scoped, ?d_scoped[0])) { ret 1; }
    if (!ut_digest_differs(?d_base[0], ?d_scoped[0])) { ret 3; }

    # the same requirement resolving to another output is another scope
    req.out = "out/spv/vert.bin";
    var d_moved: [32]u8;
    if (!ut_fp_digest(?alloc, ?scoped, ?d_moved[0]))   { ret 1; }
    if (!ut_digest_differs(?d_scoped[0], ?d_moved[0])) { ret 4; }
    ret 0;
}

fun build_resolve_deps(p: *project.Project, m: *project.ModuleEntry, list: *session.ModuleId) res[resolve.ResolveDeps, fail.Fail] {
    var deps: resolve.ResolveDeps;
    deps.entries = nil;
    deps.count   = 0;
    if (m.dep_count == 0) { ret res[resolve.ResolveDeps, fail.Fail].ok{deps}; }

    var list_len: u32 = 0;

    var i: u32 = 0;
    for (i < m.dep_count) {
        val d: session.ModuleId = m.deps[i];
        if (d::u32 < project.module_count(p) && !resolve_list_contains(list, list_len, d)) {
            list[list_len] = d;
            list_len       = list_len + 1;
        }
        i = i + 1;
    }

    var head: u32 = 0;
    for (head < list_len) {
        add_reexport_targets(p, list[head], list, ?list_len);
        head = head + 1;
    }
    ret assemble_resolve_deps(p, list, list_len);
}

fun assemble_resolve_deps(p: *project.Project, list: *session.ModuleId, list_len: u32) res[resolve.ResolveDeps, fail.Fail] {
    var deps: resolve.ResolveDeps         = resolve.ResolveDeps{};
    val ar:   res[*intern.StrId, A.Error] = A.allocate[intern.StrId](p.s.alloc, list_len::usize);
    if (sel ar.err) {
        ret res[resolve.ResolveDeps, fail.Fail].err{fail.refused(ar.err)};
    }
    val aliases: *intern.StrId = ar.ok;
    var alias_n: u32           = 0;
    var ai:      u32           = 0;
    for (ai < list_len) {
        aliases[ai] = bare_alias_for_module(p, project.module_at(p, list[ai]::u32).fqn);
        if (aliases[ai] != intern.STR_NIL) { alias_n = alias_n + 1; }
        ai = ai + 1;
    }

    val total: u32                                  = list_len + alias_n;
    val r:     res[*resolve.ModuleExports, A.Error] = A.allocate[resolve.ModuleExports](p.s.alloc, total::usize);
    if (sel r.err) {
        A.deallocate[intern.StrId](p.s.alloc, aliases, list_len::usize);
        ret res[resolve.ResolveDeps, fail.Fail].err{fail.refused(r.err)};
    }
    deps.entries = r.ok;
    deps.count   = total;

    var z: u32 = 0;
    for (z < total) {
        deps.entries[z].symbols = nil;
        deps.entries[z].count   = 0;
        z                       = z + 1;
    }

    var w: u32 = 0;
    var k: u32 = 0;
    for (k < list_len) {
        val dep_id: session.ModuleId                      = list[k];
        val mx_r:   res[resolve.ModuleExports, fail.Fail] = build_module_exports(p, dep_id, project.module_at(p, dep_id::u32));
        if (sel mx_r.err) {
            free_resolve_deps(p.s.alloc, ?deps);
            A.deallocate[intern.StrId](p.s.alloc, aliases, list_len::usize);
            ret res[resolve.ResolveDeps, fail.Fail].err{mx_r.err};
        }
        deps.entries[w] = mx_r.ok;
        w               = w + 1;
        if (aliases[k] != intern.STR_NIL) {
            val ax_r: res[resolve.ModuleExports, fail.Fail] = build_module_exports(p, dep_id, project.module_at(p, dep_id::u32));
            if (sel ax_r.err) {
                free_resolve_deps(p.s.alloc, ?deps);
                A.deallocate[intern.StrId](p.s.alloc, aliases, list_len::usize);
                ret res[resolve.ResolveDeps, fail.Fail].err{ax_r.err};
            }
            var ax: resolve.ModuleExports = ax_r.ok;
            ax.path         = aliases[k];
            deps.entries[w] = ax;
            w               = w + 1;
        }
        k = k + 1;
    }

    A.deallocate[intern.StrId](p.s.alloc, aliases, list_len::usize);

    ret res[resolve.ResolveDeps, fail.Fail].ok{deps};
}

pub fun module_in_current_project(p: *project.Project, fqn: intern.StrId) bool {
    val fqn_opt: opt[str] = intern.lookup(?p.s.interner, fqn);
    if (sel fqn_opt.none) { ret false; }
    val fqn_text: str = fqn_opt.some;

    val pid_opt: opt[str] = intern.lookup(?p.s.interner, p.config.id);
    if (sel pid_opt.none) { ret false; }
    val proj_id_text: str = pid_opt.some;

    val fqn_len:  usize = str_len(fqn_text);
    var head_end: usize = 0;
    for (head_end < fqn_len && fqn_text[head_end] != '.') { head_end = head_end + 1; }
    ret view_eq_str(view(fqn_text::*char, head_end), proj_id_text);
}

fun bare_alias_for_module(p: *project.Project, mod_fqn: intern.StrId) intern.StrId {
    if (p.config.module != intern.STR_NIL && canonical_module_fqn_is(p, p.config.id, p.config.module, mod_fqn)) {
        ret p.config.id;
    }
    var k: u32 = 0;
    for (k < p.config.dep_count) {
        val dep: *project.DepEntry = ?p.config.deps[k];
        if (dep.project_module != intern.STR_NIL && canonical_module_fqn_is(p, dep.project_id, dep.project_module, mod_fqn)) {
            ret dep.project_id;
        }
        k = k + 1;
    }
    ret intern.STR_NIL;
}

fun canonical_module_fqn_is(p: *project.Project, id: intern.StrId, module: intern.StrId, fqn: intern.StrId) bool {
    val id_opt:  opt[str] = intern.lookup(?p.s.interner, id);
    val mod_opt: opt[str] = intern.lookup(?p.s.interner, module);
    if (sel id_opt.none)  { ret false; }
    if (sel mod_opt.none) { ret false; }
    val cf_r: res[intern.StrId, fail.Fail] = load.compose_module_fqn(p.alloc, ?p.s.interner, id_opt.some, mod_opt.some);
    if (sel cf_r.err) { ret false; }
    ret cf_r.ok == fqn;
}

fun add_reexport_targets(p: *project.Project, mid: session.ModuleId, list: *session.ModuleId, list_len: *u32) {
    val dep: *project.ModuleEntry = project.module_at(p, mid::u32);
    if (!dep.resolved || dep.resolve_result == nil) { ret; }
    val rr: *resolve.ResolveResult = dep.resolve_result;
    if (rr.symbols == nil) { ret; }
    var i: u32 = 0;
    for (i < rr.pub_count) {
        val s: *resolve.Symbol = ?rr.symbols[i];
        if (s.kind == resolve.SYM_USE) {
            val target_mid: session.ModuleId = s.slot::session.ModuleId;
            if (target_mid::u32 < project.module_count(p) && !resolve_list_contains(list, @list_len, target_mid)) {
                list[@list_len] = target_mid;
                @list_len       = @list_len + 1;
            }
        }
        i = i + 1;
    }
}

fun build_module_exports(p: *project.Project, dep_id: session.ModuleId, dep: *project.ModuleEntry) res[resolve.ModuleExports, fail.Fail] {
    var mx: resolve.ModuleExports;
    mx.path    = dep.fqn;
    mx.module  = dep_id;
    mx.symbols = nil;
    mx.count   = 0;
    mx.refused = dep.resolve_result != nil && dep.resolve_result.refused;
    if (!dep.resolved || dep.resolve_result == nil || dep.resolve_result.pub_count == 0) {
        ret res[resolve.ModuleExports, fail.Fail].ok{mx};
    }
    val pcount: u32                                 = dep.resolve_result.pub_count;
    val r:      res[*resolve.PublicSymbol, A.Error] = A.allocate[resolve.PublicSymbol](p.s.alloc, pcount::usize);
    if (sel r.err) { ret res[resolve.ModuleExports, fail.Fail].err{fail.refused(r.err)}; }
    val syms: *resolve.PublicSymbol = r.ok;

    var i: u32 = 0;
    for (i < pcount) {
        val sym: *resolve.Symbol = ?dep.resolve_result.symbols[i];
        var ps:  resolve.PublicSymbol;
        ps.kind                = sym.definition_kind;
        ps.name                = sym.name;
        ps.canon               = sym.canon;
        ps.file                = sym.definition_file;
        ps.generic_arity       = sym.generic_arity;
        ps.has_comptime_params = sym.has_comptime_params;
        ps.has_pack_param      = sym.has_pack_param;
        ps.deprecation         = sym.deprecation;
        ps.testing             = sym.testing;
        ps.slot                = sym.slot;
        ps.origin              = sym.origin;
        syms[i]                = ps;
        i                      = i + 1;
    }

    mx.symbols = syms;
    mx.count   = pcount;
    ret res[resolve.ModuleExports, fail.Fail].ok{mx};
}

fun free_resolve_deps(alloc: *A.Allocator, deps: *resolve.ResolveDeps) {
    if (deps.entries == nil) { ret; }
    var i: u32 = 0;
    for (i < deps.count) {
        val mx: *resolve.ModuleExports = ?deps.entries[i];
        if (mx.symbols != nil && mx.count > 0) {
            A.deallocate[resolve.PublicSymbol](alloc, mx.symbols, mx.count::usize);
        }
        i = i + 1;
    }
    A.deallocate[resolve.ModuleExports](alloc, deps.entries, deps.count::usize);
    deps.entries = nil;
    deps.count   = 0;
}

fun ut_fp_digest(alloc: *A.Allocator, p: *project.Project, out: *u8) bool {
    var fb: dq.FpBuf;
    fb.alloc = alloc;
    fb.buf   = nil;
    fb.len   = 0;
    fb.cap   = 0;
    val w: err[fail.Fail] = write_build_config(?fb, p);
    if (sel w.err) {
        dq.fp_free(?fb);
        ret false;
    }
    sha256.hash(fb.buf, fb.len, out);
    dq.fp_free(?fb);
    ret true;
}

fun ut_digest_differs(a: *u8, b: *u8) bool {
    var i: usize = 0;
    for (i < 32) {
        if (a[i] != b[i]) { ret true; }
        i = i + 1;
    }
    ret false;
}

test "mach.lang.driver.passes.write_build_config:every_tuple_field_moves_the_fingerprint" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }

    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val register_all_r: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel register_all_r.err) { ret 1; }

    val tx_r: res[target.Target, fail.Fail] = target.select(?reg, "x86_64", "linux", "sysv64");
    val ta_r: res[target.Target, fail.Fail] = target.select(?reg, "aarch64", "linux", "aapcs64");
    val tw_r: res[target.Target, fail.Fail] = target.select(?reg, "x86_64", "windows", "win64");
    if (sel tx_r.err) { ret 1; }
    if (sel ta_r.err) { ret 1; }
    if (sel tw_r.err) { ret 1; }
    val tx: target.Target = tx_r.ok;
    val ta: target.Target = ta_r.ok;
    val tw: target.Target = tw_r.ok;

    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }

    var te: project.TargetEntry;
    te.os_name       = intern.STR_NIL;
    te.isa_name      = intern.STR_NIL;
    te.abi_name      = intern.STR_NIL;
    te.platform_name = intern.STR_NIL;
    var cfg: project.ProjectConfig;
    cfg.id       = intern.STR_NIL;
    cfg.version  = intern.STR_NIL;
    cfg.bin_name = intern.STR_NIL;

    var base: project.Project;
    base.s            = ?s;
    base.req          = request.defaults();
    base.req.profile  = "debug";
    base.target       = tx;
    base.target_entry = ?te;
    base.config       = cfg;

    val N:       usize = 10;
    var digests: [10][32]u8;
    if (!ut_fp_digest(?alloc, ?base, ?digests[0][0])) { ret 1; }

    var v: project.Project = base;
    v.target.arch_id = ta.arch_id;
    if (!ut_fp_digest(?alloc, ?v, ?digests[1][0])) { ret 1; }

    v               = base;
    v.target.abi_id = ta.abi_id;
    if (!ut_fp_digest(?alloc, ?v, ?digests[2][0])) { ret 1; }

    v              = base;
    v.target.os_id = tw.os_id;
    if (!ut_fp_digest(?alloc, ?v, ?digests[3][0])) { ret 1; }

    v           = base;
    v.target.of = tw.of;
    if (!ut_fp_digest(?alloc, ?v, ?digests[4][0])) { ret 1; }

    v                 = base;
    v.target.debug_id = base.target.debug_id + 1;
    if (!ut_fp_digest(?alloc, ?v, ?digests[5][0])) { ret 1; }

    v                      = base;
    v.target.stack_reserve = base.target.stack_reserve + 0x1000;
    if (!ut_fp_digest(?alloc, ?v, ?digests[6][0])) { ret 1; }

    v                     = base;
    v.target.stack_commit = base.target.stack_commit + 0x1000;
    if (!ut_fp_digest(?alloc, ?v, ?digests[7][0])) { ret 1; }

    v             = base;
    v.req.profile = "release";
    if (!ut_fp_digest(?alloc, ?v, ?digests[8][0])) { ret 1; }

    var env_keys:   [1]intern.StrId;
    var env_values: [1]intern.StrId;
    val intern_r2:  res[intern.StrId, A.Error] = intern.intern(?s.interner, "MODE");
    if (sel intern_r2.err) { ret 99; }
    env_keys[0] = intern_r2.ok;
    val intern_r3: res[intern.StrId, A.Error] = intern.intern(?s.interner, "audit");
    if (sel intern_r3.err) { ret 99; }
    env_values[0] = intern_r3.ok;
    var steps:     [1]manifest.StepDef;
    val intern_r4: res[intern.StrId, A.Error] = intern.intern(?s.interner, "generate");
    if (sel intern_r4.err) { ret 99; }
    steps[0].name       = intern_r4.ok;
    steps[0].env_keys   = ?env_keys[0];
    steps[0].env_values = ?env_values[0];
    steps[0].env_count  = 1;
    v                   = base;
    v.config.steps      = ?steps[0];
    v.config.step_count = 1;
    if (!ut_fp_digest(?alloc, ?v, ?digests[9][0])) { ret 1; }

    var i: usize = 0;
    for (i < N) {
        var j: usize = i + 1;
        for (j < N) {
            if (!ut_digest_differs(?digests[i][0], ?digests[j][0])) { ret 1; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret 0;
}

fun t_capture_bytes(p: *project.Project, a: *A.Allocator, identity: bool) res[query.QueryOutput, fail.Fail] {
    if (identity) { ret capture_build_identity(p, a); }
    ret capture_build_config(p, a);
}

fun t_capture_equal(a: *A.Allocator, left: *project.Project, right: *project.Project, identity: bool) i32 {
    val l: res[query.QueryOutput, fail.Fail] = t_capture_bytes(left, a, identity);
    val r: res[query.QueryOutput, fail.Fail] = t_capture_bytes(right, a, identity);
    if (sel l.err) { ret -1; }
    if (sel r.err) { ret -1; }
    val lb: query.QueryOutput = l.ok;
    val rb: query.QueryOutput = r.ok;
    fin {
        if (lb.bytes != nil) { A.deallocate[u8](a, lb.bytes, lb.len::usize); }
        if (rb.bytes != nil) { A.deallocate[u8](a, rb.bytes, rb.len::usize); }
    }
    if (lb.len != rb.len) { ret 0; }
    var i: u32 = 0;
    for (i < lb.len) {
        if (lb.bytes[i] != rb.bytes[i]) { ret 0; }
        i = i + 1;
    }
    ret 1;
}

test "mach.lang.driver.passes.capture_build_identity:excludes_the_planner_environment" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val register_all_r: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel register_all_r.err) { ret 1; }
    val tx: res[target.Target, fail.Fail] = target.select(?reg, "x86_64", "linux", "sysv64");
    if (sel tx.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var te: project.TargetEntry;
    te.os_name       = intern.STR_NIL;
    te.isa_name      = intern.STR_NIL;
    te.abi_name      = intern.STR_NIL;
    te.platform_name = intern.STR_NIL;
    var cfg: project.ProjectConfig;
    cfg.id       = intern.STR_NIL;
    cfg.version  = intern.STR_NIL;
    cfg.bin_name = intern.STR_NIL;
    var alone: project.Project;
    alone.s            = ?s;
    alone.req          = request.defaults();
    alone.target       = tx.ok;
    alone.target_entry = ?te;
    alone.config       = cfg;
    var hosted: project.Project = alone;
    hosted.config.dep_count = 1;
    # a dependency makes the configuration sample the inherited environment; the identity never does
    if (t_capture_equal(?alloc, ?alone, ?hosted, false) != 0) { ret 2; }
    if (t_capture_equal(?alloc, ?alone, ?hosted, true) != 1)  { ret 3; }
    hosted.req.profile = "release";
    if (t_capture_equal(?alloc, ?alone, ?hosted, true) != 0) { ret 4; }
    ret 0;
}

fun t_planner_environment_digest(a: *A.Allocator, inherited: **u8, digest: *u8) bool {
    var fb: dq.FpBuf;
    fb.alloc = a;
    fb.buf   = nil;
    fb.len   = 0;
    fb.cap   = 0;
    fin { dq.fp_free(?fb); }
    val written: err[fail.Fail] = write_planner_environment(?fb, inherited);
    if (sel written.err) { ret false; }
    sha256.hash(fb.buf, fb.len, digest);
    ret true;
}

test "mach.lang.driver.passes: planner environment cache input tracks values and ignores entry order" {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    var entries: [4]usize;
    entries[0] = ("MACH_3146_B=two")::usize;
    entries[1] = ("MACH_3146_A=one")::usize;
    entries[2] = ("MACH_3146_A=ignored duplicate")::usize;
    entries[3] = 0;
    var initial: [32]u8;
    if (!t_planner_environment_digest(?a, (?entries[0])::**u8, ?initial[0])) { ret 2; }
    entries[0] = ("MACH_3146_A=one")::usize;
    entries[1] = ("MACH_3146_B=two")::usize;
    entries[2] = 0;
    var reordered: [32]u8;
    if (!t_planner_environment_digest(?a, (?entries[0])::**u8, ?reordered[0])) { ret 3; }
    if (ut_digest_differs(?initial[0], ?reordered[0]))                         { ret 4; }
    entries[1] = ("MACH_3146_B=changed inherited value")::usize;
    var changed: [32]u8;
    if (!t_planner_environment_digest(?a, (?entries[0])::**u8, ?changed[0])) { ret 5; }
    if (!ut_digest_differs(?initial[0], ?changed[0]))                        { ret 6; }
    ret 0;
}

fun lower_output_equal(a: *u8, a_len: u32, b: *u8, b_len: u32) bool {
    val left:  *ir.Module = ir_handle_decode(query.QueryView{value: a, value_len: a_len});
    val right: *ir.Module = ir_handle_decode(query.QueryView{value: b, value_len: b_len});
    if (left == nil || right == nil) { ret false; }
    ret ir_equal.content_equal(left, right);
}
