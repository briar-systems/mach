fun read_definition(raw: ptr, mid: session.ModuleId, phase: fe_sema.DefinitionPhase) res[fe_sema.Definition, fail.Fail] {
    val p:      *project.Project                         = raw::*project.Project;
    val parsed: res[resolve.ParsedDefinition, fail.Fail] = driver_load.parsed_definition(raw, mid);
    if (sel parsed.err) { ret res[fe_sema.Definition, fail.Fail].err{parsed.err}; }
    var result: fe_sema.Definition = fe_sema.Definition{
        parsed: parsed.ok, origin: mid, decorators: ?project.module_at(p, mid::u32).load.ctx
    };
    if (phase >= fe_sema.DEFINITION_RESOLVED) {
        val viewed: err[fail.Fail] = depend_load_view(p, project.module_at(p, mid::u32));
        if (sel viewed.err) { ret res[fe_sema.Definition, fail.Fail].err{viewed.err}; }
        val acquired: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, query.Q_RESOLVE, module.stable_index(project.module_at(p, mid::u32).stable_id)::u64);
        if (sel acquired.err) { ret res[fe_sema.Definition, fail.Fail].err{acquired.err}; }
        result.rr = driver_query.resolve_handle_decode(acquired.ok);
        if (result.rr == nil) { ret res[fe_sema.Definition, fail.Fail].err{fail.message("current definition has no resolved query owner")}; }
        resolve.remap_result(result.rr, p.s);
        project.module_at(p, mid::u32).resolve_result = result.rr;
    }
    if (phase == fe_sema.DEFINITION_TYPED) {
        val acquired: res[*fe_sema.SemaResult, fail.Fail] = acquire_sema(p, mid);
        if (sel acquired.err) { ret res[fe_sema.Definition, fail.Fail].err{acquired.err}; }
        result.sr = acquired.ok;
        val scoped: res[*comptime.ComptimeCtx, fail.Fail] = lower_scope_for(p, project.module_at(p, mid::u32));
        if (sel scoped.err) { ret res[fe_sema.Definition, fail.Fail].err{scoped.err}; }
        result.ctx = scoped.ok;
    }
    ret res[fe_sema.Definition, fail.Fail].ok{result};
}

# the lowering scope of a module as a definition read sees it: made or brought up to date on a
# serial path, and only read while lowering workers run
fun lower_scope_for(p: *project.Project, m: *project.ModuleEntry) res[*comptime.ComptimeCtx, fail.Fail] {
    if (p.lowering_workers) { ret lower_scope_of(m); }
    val prepared: err[fail.Fail] = lower_scope_prepare(m);
    if (sel prepared.err) { ret res[*comptime.ComptimeCtx, fail.Fail].err{prepared.err}; }
    ret res[*comptime.ComptimeCtx, fail.Fail].ok{?m.lower_scope};
}

# the scope lowering binds a module's constants in, over what the load, resolve and sema bound
# over it, made on the first call and kept for as long as the module's syntax stands; each call
# sets the layers to the module's current products, so it runs only where nothing else reads them
pub fun lower_scope_prepare(m: *project.ModuleEntry) err[fail.Fail] {
    if (!m.lower_scoped) {
        m.lower_scope = comptime.stage_init(?m.load.ctx, comptime.STAGE_LOWER, m.load.ctx.own.alloc);
        if (m.a != nil) {
            val prepared: err[fail.Fail] = comptime.prepare_gates(?m.lower_scope, m.a.expr_len::u32);
            if (sel prepared.err) {
                comptime.dnit(?m.lower_scope);
                ret prepared;
            }
        }
        m.lower_scoped = true;
    }
    comptime.layer_set(?m.lower_scope, comptime.STAGE_LOAD, ?m.load.ctx.own);
    if (m.resolve_result != nil) { comptime.layer_set(?m.lower_scope, comptime.STAGE_RESOLVE, ?m.resolve_result.constants); }
    if (m.sema_result != nil)    { comptime.layer_set(?m.lower_scope, comptime.STAGE_SEMA, ?m.sema_result.constants); }
    ret err[fail.Fail].ok{};
}

# the lowering scope `lower_scope_prepare` made, read without writing it: a scope that was never
# made, or whose layers are not the module's current products, is a defect of the caller
pub fun lower_scope_of(m: *project.ModuleEntry) res[*comptime.ComptimeCtx, fail.Fail] {
    if (!m.lower_scoped) { ret res[*comptime.ComptimeCtx, fail.Fail].err{fail.message("lower: a module's lowering scope was read before it was prepared")}; }
    var current: bool = comptime.layer_at(?m.lower_scope, comptime.STAGE_LOAD) == ?m.load.ctx.own;
    if (m.resolve_result != nil) { current = current && comptime.layer_at(?m.lower_scope, comptime.STAGE_RESOLVE) == ?m.resolve_result.constants; }
    if (m.sema_result != nil)    { current = current && comptime.layer_at(?m.lower_scope, comptime.STAGE_SEMA) == ?m.sema_result.constants; }
    if (!current)                { ret res[*comptime.ComptimeCtx, fail.Fail].err{fail.message("lower: a module's lowering scope does not read its current products")}; }
    ret res[*comptime.ComptimeCtx, fail.Fail].ok{?m.lower_scope};
}

pub fun prepare_resolve_pass(p: *project.Project) err[fail.Fail] {
    if (!query.is_registered(?p.s.queries, query.Q_RESOLVE)) {
        val rr: err[fail.Fail] = query.register_derived_owned(?p.s.queries, query.Q_RESOLVE, q_resolve_finalize);
        if (sel rr.err) { ret rr; }
    }
    if (!query.is_registered(?p.s.queries, query.Q_EXPORTS)) {
        val re: err[fail.Fail] = query.register_derived(?p.s.queries, query.Q_EXPORTS);
        if (sel re.err) { ret re; }
    }
    if (!query.is_registered(?p.s.queries, query.Q_LOAD_VIEW)) {
        val rv: err[fail.Fail] = query.register_input(?p.s.queries, query.Q_LOAD_VIEW);
        if (sel rv.err) { ret rv; }
    }
    ret record_load_views(p);
}

# a rejected module is one module's answer, so the pass folds it and carries
# on over the rest; an internal failure ends the pass where it met it
pub fun run_resolve_pass(p: *project.Project) err[fail.Fail] {
    var rejected: bool = false;
    var i:        u32  = 0;
    for (i < p.topo_len) {
        val mid: session.ModuleId = p.topo[i];
        if (project.module_at(p, mid::u32).frontend_skipped) {
            i = i + 1;
            cnt;
        }
        val r: err[fail.Fail] = run_resolve_one(p, mid);
        if (sel r.err) {
            if (!fail.is_reported(r.err)) { ret r; }
            rejected = true;
        }
        i = i + 1;
    }
    if (rejected) { ret err[fail.Fail].err{fail.reported()}; }
    ret err[fail.Fail].ok{};
}

fun run_resolve_one(p: *project.Project, mid: session.ModuleId) err[fail.Fail] {
    val m: *project.ModuleEntry = project.module_at(p, mid::u32);

    val t_item: readout.Instant = readout.item_begin(p.progress);

    val e_r: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, query.Q_RESOLVE, module.stable_index(m.stable_id)::u64);
    if (sel e_r.err) { ret err[fail.Fail].err{e_r.err}; }
    val rr: *resolve.ResolveResult = driver_query.resolve_handle_decode(e_r.ok);
    if (rr == nil) { ret err[fail.Fail].err{fail.message("Q_RESOLVE produced no result handle")}; }

    # the product is on the entry before the export query can reject it, so a
    # module that resolved with errors still exposes what it resolved
    resolve.remap_result(rr, p.s);
    m.resolve_result = rr;

    val ex_r: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, query.Q_EXPORTS, module.stable_index(m.stable_id)::u64);
    if (sel ex_r.err) { ret err[fail.Fail].err{ex_r.err}; }

    m.resolved = true;
    readout.item(p.progress, readout.RESOLVE, intern.text(?p.s.interner, m.fqn), t_item);
    ret err[fail.Fail].ok{};
}

pub fun q_resolve_compute(p: *project.Project, key: u64, alloc: *A.Allocator, diags: *diagnostic.DiagnosticStore) res[query.QueryOutput, fail.Fail] {
    val db: *query.QueryDb   = ?p.s.queries;
    val s:  *session.Session = p.s;

    val stable: session.StableModuleId = key::u32::session.StableModuleId;
    val mid:    session.ModuleId       = session.module_id_for_stable(s, stable);
    if (module.is_nil(mid)) { ret res[query.QueryOutput, fail.Fail].err{fail.message("Q_RESOLVE: stable id not loaded this build")}; }
    val m:      *project.ModuleEntry                     = project.module_at(p, mid::u32);
    val parsed: res[resolve.ParsedDefinition, fail.Fail] = driver_load.parsed_definition(p::ptr, mid);
    if (sel parsed.err) { ret res[query.QueryOutput, fail.Fail].err{parsed.err}; }
    val a:  *ast.Ast       = parsed.ok.a;
    val rt: err[fail.Fail] = query.depend[project.Project](?p.queries, p, query.Q_TARGET, 0);
    if (sel rt.err) { ret res[query.QueryOutput, fail.Fail].err{rt.err}; }
    val rv: err[fail.Fail] = depend_load_view(p, m);
    if (sel rv.err) { ret res[query.QueryOutput, fail.Fail].err{rv.err}; }

    val deps_r: res[resolve.ResolveDeps, fail.Fail] = build_resolve_deps_owned(p, m);
    if (sel deps_r.err) { ret res[query.QueryOutput, fail.Fail].err{deps_r.err}; }
    var deps: resolve.ResolveDeps = deps_r.ok;
    deps.bindings      = m.load.bindings.data;
    deps.binding_count = m.load.bindings.len::u32;

    var di: u32 = 0;
    for (di < deps.count) {
        val dep_mid: session.ModuleId = deps.entries[di].module;
        if (dep_mid::u32 < project.module_count(p)) {
            val ge: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, query.Q_EXPORTS, module.stable_index(project.module_at(p, dep_mid::u32).stable_id)::u64);
            if (sel ge.err) {
                free_resolve_deps(s.alloc, ?deps);
                ret res[query.QueryOutput, fail.Fail].err{ge.err};
            }
        }
        di = di + 1;
    }

    val rr_r: res[resolve.ResolveResult, fail.Fail] = resolve.resolve(s, a, ?deps, ?m.load.ctx, mid, diags);
    free_resolve_deps(s.alloc, ?deps);
    if (sel rr_r.err) { ret res[query.QueryOutput, fail.Fail].err{rr_r.err}; }
    var result: resolve.ResolveResult = rr_r.ok;

    val br: res[*resolve.ResolveResult, A.Error] = A.allocate[resolve.ResolveResult](alloc, 1::usize);
    if (sel br.err) {
        resolve.result_dnit(?result);
        ret res[query.QueryOutput, fail.Fail].err{fail.refused(br.err)};
    }
    val box: *resolve.ResolveResult = br.ok;
    box[0] = result;
    ret driver_query.resolve_handle_encode(alloc, box);
}

fun q_resolve_finalize(value: *u8, value_len: u32, alloc: *A.Allocator) {
    if (value == nil || value_len::usize < $size_of(ptr)) { ret; }
    val slot: *ptr                   = value::ptr::*ptr;
    val r:    *resolve.ResolveResult = slot[0]::*resolve.ResolveResult;
    if (r == nil) { ret; }
    resolve.result_dnit(r);
    A.deallocate[resolve.ResolveResult](alloc, r, 1::usize);
}

fun build_resolve_deps_owned(p: *project.Project, m: *project.ModuleEntry) res[resolve.ResolveDeps, fail.Fail] {
    var deps: resolve.ResolveDeps;
    deps.entries = nil;
    deps.count   = 0;
    if (project.dep_count(m) == 0) { ret res[resolve.ResolveDeps, fail.Fail].ok{deps}; }

    val lr: res[*session.ModuleId, A.Error] = A.allocate[session.ModuleId](p.s.alloc, project.module_count(p)::usize);
    if (sel lr.err) {
        ret res[resolve.ResolveDeps, fail.Fail].err{fail.refused(lr.err)};
    }
    val list: *session.ModuleId = lr.ok;

    val r: res[resolve.ResolveDeps, fail.Fail] = build_resolve_deps(p, m, list);
    A.deallocate[session.ModuleId](p.s.alloc, list, project.module_count(p)::usize);
    ret r;
}

fun resolve_list_contains(list: *session.ModuleId, list_len: u32, id: session.ModuleId) bool {
    var i: u32 = 0;
    for (i < list_len) {
        if (module.same(list[i], id)) { ret true; }
        i = i + 1;
    }
    ret false;
}

pub fun prepare_sema_pass(p: *project.Project) err[fail.Fail] {
    if (!query.is_registered(?p.s.queries, query.Q_SEMA)) {
        val rsm: err[fail.Fail] = query.register_derived_owned(?p.s.queries, query.Q_SEMA, q_sema_finalize);
        if (sel rsm.err) { ret err[fail.Fail].err{rsm.err}; }
    }
    if (!query.is_registered(?p.s.queries, query.Q_TYPED_EXPORTS)) {
        val rte: err[fail.Fail] = query.register_derived(?p.s.queries, query.Q_TYPED_EXPORTS);
        if (sel rte.err) { ret err[fail.Fail].err{rte.err}; }
    }

    ret err[fail.Fail].ok{};
}

# a rejected module is one module's answer, so the pass folds it and carries
# on over the rest; an internal failure ends the pass where it met it
pub fun run_sema_pass(p: *project.Project) err[fail.Fail] {
    readout.phase_begin(p.progress, readout.SEMA);
    var rejected: bool = false;
    var i:        u32  = 0;
    for (i < p.topo_len) {
        val mid: session.ModuleId = p.topo[i];
        if (project.module_at(p, mid::u32).frontend_skipped) {
            i = i + 1;
            cnt;
        }

        val r: err[fail.Fail] = run_sema_one(p, mid);
        if (sel r.err) {
            if (!fail.is_reported(r.err)) { ret err[fail.Fail].err{r.err}; }
            rejected = true;
        }
        i = i + 1;
    }
    readout.phase_end(p.progress, readout.SEMA, cache.frontend_count(p), "module", "modules");
    if (rejected) { ret err[fail.Fail].err{fail.reported()}; }
    ret err[fail.Fail].ok{};
}

fun acquire_sema(p: *project.Project, mid: session.ModuleId) res[*fe_sema.SemaResult, fail.Fail] {
    if (module.is_nil(mid) || mid::u32 >= project.module_count(p)) {
        ret res[*fe_sema.SemaResult, fail.Fail].err{fail.message("semantic definition module is not in the active project")};
    }
    val stable:   session.StableModuleId          = project.module_at(p, mid::u32).stable_id;
    val acquired: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, query.Q_SEMA, module.stable_index(stable)::u64);
    if (sel acquired.err) { ret res[*fe_sema.SemaResult, fail.Fail].err{acquired.err}; }
    val result: *fe_sema.SemaResult = sema_handle_decode(acquired.ok);
    if (result == nil) { ret res[*fe_sema.SemaResult, fail.Fail].err{fail.message("semantic query produced no result owner")}; }
    val installed: err[fail.Fail] = fe_sema.fields.install(p.s, ?result.field_graph);
    if (sel installed.err) { ret res[*fe_sema.SemaResult, fail.Fail].err{installed.err}; }
    project.module_at(p, mid::u32).sema_result = result;
    ret res[*fe_sema.SemaResult, fail.Fail].ok{result};
}

fun run_sema_one(p: *project.Project, mid: session.ModuleId) err[fail.Fail] {
    val m: *project.ModuleEntry = project.module_at(p, mid::u32);

    val t_item: readout.Instant = readout.item_begin(p.progress);

    val acquired: res[fe_sema.Definition, fail.Fail] = read_definition(p::ptr, mid, fe_sema.DEFINITION_TYPED);
    if (sel acquired.err) { ret err[fail.Fail].err{acquired.err}; }
    val current: fe_sema.Definition  = acquired.ok;
    val sr:      *fe_sema.SemaResult = current.sr;

    # acquire_sema put the product on the entry; it is registered with the
    # session before the typed export query can reject it, so a module that
    # typed with errors still exposes what it typed
    val rp: err[fail.Fail] = session.register_module_phase(p.s, mid, sr::ptr, current.rr::ptr);
    if (sel rp.err) { ret rp; }

    val tx_r: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, query.Q_TYPED_EXPORTS, module.stable_index(m.stable_id)::u64);
    if (sel tx_r.err) { ret err[fail.Fail].err{tx_r.err}; }

    readout.item(p.progress, readout.SEMA, intern.text(?p.s.interner, m.fqn), t_item);
    ret err[fail.Fail].ok{};
}

pub fun q_sema_compute(p: *project.Project, key: u64, alloc: *A.Allocator, diags: *diagnostic.DiagnosticStore) res[query.QueryOutput, fail.Fail] {
    val db: *query.QueryDb   = ?p.s.queries;
    val s:  *session.Session = p.s;

    val stable: session.StableModuleId = key::u32::session.StableModuleId;
    val mid:    session.ModuleId       = session.module_id_for_stable(s, stable);
    if (module.is_nil(mid)) { ret res[query.QueryOutput, fail.Fail].err{fail.message("Q_SEMA: stable id not loaded this build")}; }
    val m:      *project.ModuleEntry                     = project.module_at(p, mid::u32);
    val parsed: res[resolve.ParsedDefinition, fail.Fail] = driver_load.parsed_definition(p::ptr, mid);
    if (sel parsed.err) { ret res[query.QueryOutput, fail.Fail].err{parsed.err}; }
    val definition: resolve.ParsedDefinition = parsed.ok;
    if (sel definition.status.kind.internal) { ret res[query.QueryOutput, fail.Fail].err{fail.phase_failure(definition.status)}; }
    val a:      *ast.Ast       = definition.a;
    val viewed: err[fail.Fail] = depend_load_view(p, m);
    if (sel viewed.err) { ret res[query.QueryOutput, fail.Fail].err{viewed.err}; }
    val resolved: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, query.Q_RESOLVE, module.stable_index(m.stable_id)::u64);
    if (sel resolved.err) { ret res[query.QueryOutput, fail.Fail].err{resolved.err}; }
    val rr: *resolve.ResolveResult = driver_query.resolve_handle_decode(resolved.ok);
    if (rr == nil) { ret res[query.QueryOutput, fail.Fail].err{fail.message("Q_SEMA: acquired query has no resolve result")}; }
    m.resolve_result = rr;
    val rt: err[fail.Fail] = query.depend[project.Project](?p.queries, p, query.Q_TARGET, 0);
    if (sel rt.err) { ret res[query.QueryOutput, fail.Fail].err{rt.err}; }
    val rn: err[fail.Fail] = query.depend[project.Project](?p.queries, p, query.Q_MODULE_NUMBER, key);
    if (sel rn.err) { ret res[query.QueryOutput, fail.Fail].err{rn.err}; }

    val sdeps_r: res[fe_sema.SemaDeps, fail.Fail] = build_sema_deps_query(p, m);
    if (sel sdeps_r.err) { ret res[query.QueryOutput, fail.Fail].err{sdeps_r.err}; }
    var sdeps: fe_sema.SemaDeps = sdeps_r.ok;
    sdeps.watch = fe_sema.GrowthWatch{ctx: p::ptr, expanded: growth_expanded};

    val sem_r: res[fe_sema.SemaResult, fail.Fail] = fe_sema.sema(s, a, rr, ?sdeps, ?m.load.ctx, mid, diags);
    free_sema_deps_query(s.alloc, ?sdeps);
    if (sel sem_r.err) { ret res[query.QueryOutput, fail.Fail].err{sem_r.err}; }
    var result: fe_sema.SemaResult = sem_r.ok;
    # a rejected parse still types, as the recovered tree is for, and the
    # product carries the parse rejection so the module stays rejected
    fail.merge(?result.status, definition.status);

    var ei: u32 = 0;
    for (ei < result.embed_path_count) {
        val re: err[fail.Fail] = query.depend[project.Project](?p.queries, p, query.Q_EMBED_FILE, intern.str_index(result.embed_paths[ei])::u64);
        if (sel re.err) {
            fe_sema.result_dnit(?result);
            ret res[query.QueryOutput, fail.Fail].err{re.err};
        }
        ei = ei + 1;
    }

    val br: res[*fe_sema.SemaResult, A.Error] = A.allocate[fe_sema.SemaResult](alloc, 1::usize);
    if (sel br.err) {
        fe_sema.result_dnit(?result);
        ret res[query.QueryOutput, fail.Fail].err{fail.refused(br.err)};
    }
    val box: *fe_sema.SemaResult = br.ok;
    box[0] = result;
    ret sema_handle_encode(alloc, box);
}

fun q_sema_finalize(value: *u8, value_len: u32, alloc: *A.Allocator) {
    if (value == nil || value_len::usize < $size_of(ptr)) { ret; }
    val slot: *ptr                = value::ptr::*ptr;
    val r:    *fe_sema.SemaResult = slot[0]::*fe_sema.SemaResult;
    if (r == nil) { ret; }
    fe_sema.result_dnit(r);
    A.deallocate[fe_sema.SemaResult](alloc, r, 1::usize);
}

fun sema_handle_encode(alloc: *A.Allocator, r: *fe_sema.SemaResult) res[query.QueryOutput, fail.Fail] {
    val n:  u32               = $size_of(ptr)::u32;
    val rb: res[*u8, A.Error] = A.allocate[u8](alloc, n::usize);
    if (sel rb.err) {
        fe_sema.result_dnit(r);
        A.deallocate[fe_sema.SemaResult](alloc, r, 1::usize);
        ret res[query.QueryOutput, fail.Fail].err{fail.refused(rb.err)};
    }
    val buf:  *u8  = rb.ok;
    val slot: *ptr = buf::ptr::*ptr;
    slot[0] = r::ptr;
    var out: query.QueryOutput;
    out.bytes = buf;
    out.len   = n;
    ret res[query.QueryOutput, fail.Fail].ok{out};
}

fun sema_handle_decode(e: query.QueryView) *fe_sema.SemaResult {
    if (e.value == nil || e.value_len::usize < $size_of(ptr)) { ret nil; }
    val slot: *ptr = e.value::ptr::*ptr;
    ret slot[0]::*fe_sema.SemaResult;
}

# a growing cycle's expansion, shown under the phase readout as it runs
fun growth_expanded(raw: ptr, module: intern.StrId, members: intern.StrId, instances: u32) {
    val p: *project.Project = raw::*project.Project;
    if (p.progress == nil) { ret; }
    readout.growth(p.progress.sink, intern.text(?p.s.interner, module), intern.text(?p.s.interner, members), instances);
}

fun build_sema_deps_query(p: *project.Project, m: *project.ModuleEntry) res[fe_sema.SemaDeps, fail.Fail] {
    var deps: fe_sema.SemaDeps = fe_sema.SemaDeps{};
    deps.definitions = fe_sema.reader_init(p::ptr, read_definition, p.s.alloc);
    val closure: res[LowerClosure, fail.Fail] = collect_lower_closure(p, m);
    if (sel closure.err) { ret res[fe_sema.SemaDeps, fail.Fail].err{closure.err}; }
    var imports: LowerClosure = closure.ok;
    fin { free_lower_closure(p.s.alloc, ?imports); }
    if (imports.count == 0) { ret res[fe_sema.SemaDeps, fail.Fail].ok{deps}; }
    val allocated: res[**fe_sema.ModuleSema, A.Error] = A.allocate[*fe_sema.ModuleSema](p.s.alloc, imports.count::usize);
    if (sel allocated.err) { ret res[fe_sema.SemaDeps, fail.Fail].err{fail.refused(allocated.err)}; }
    deps.entries = allocated.ok;
    deps.count   = imports.count;
    var i: u32 = 0;
    for (i < imports.count) {
        val shared: res[*fe_sema.ModuleSema, fail.Fail] = typed_surface_of(p, imports.list[i]);
        if (sel shared.err) {
            free_sema_deps_query(p.s.alloc, ?deps);
            ret res[fe_sema.SemaDeps, fail.Fail].err{shared.err};
        }
        deps.entries[i] = shared.ok;
        i               = i + 1;
    }
    ret res[fe_sema.SemaDeps, fail.Fail].ok{deps};
}

# the surfaces are the project's, so only the borrowing array is released
fun free_sema_deps_query(alloc: *A.Allocator, deps: *fe_sema.SemaDeps) {
    fe_sema.reader_dnit(?deps.definitions);
    if (deps.entries != nil) { A.deallocate[*fe_sema.ModuleSema](alloc, deps.entries, deps.count::usize); }
    deps.entries = nil;
    deps.count   = 0;
}

# one decoded surface per module and typed-exports revision, shared by every importer
fun typed_surface_of(p: *project.Project, mid: session.ModuleId) res[*fe_sema.ModuleSema, fail.Fail] {
    if (module.is_nil(mid) || mid::u32 >= project.module_count(p)) { ret res[*fe_sema.ModuleSema, fail.Fail].err{fail.message("typed surface module is not loaded")}; }
    val m:        *project.ModuleEntry            = project.module_at(p, mid::u32);
    val acquired: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p,
        query.Q_TYPED_EXPORTS, module.stable_index(m.stable_id)::u64);
    if (sel acquired.err) { ret res[*fe_sema.ModuleSema, fail.Fail].err{acquired.err}; }
    val view: query.QueryView = acquired.ok;
    if (m.typed_surface != nil && m.typed_surface_rev == view.last_changed) {
        ret res[*fe_sema.ModuleSema, fail.Fail].ok{m.typed_surface};
    }
    val decoded: res[fe_sema.ModuleSema, fail.Fail] = surface_from_view(p, mid, view, p.alloc);
    if (sel decoded.err) { ret res[*fe_sema.ModuleSema, fail.Fail].err{decoded.err}; }
    val boxed: res[*fe_sema.ModuleSema, fail.Fail] = box_surface(p, decoded.ok);
    if (sel boxed.err) { ret boxed; }
    project.drop_surface(p.alloc, ?m.typed_surface);
    m.typed_surface     = boxed.ok;
    m.typed_surface_rev = view.last_changed;
    ret boxed;
}

fun box_surface(p: *project.Project, surface: fe_sema.ModuleSema) res[*fe_sema.ModuleSema, fail.Fail] {
    var owned: fe_sema.ModuleSema                = surface;
    val ar:    res[*fe_sema.ModuleSema, A.Error] = A.allocate[fe_sema.ModuleSema](p.alloc, 1::usize);
    if (sel ar.err) {
        fe_sema.module_sema_dnit(?owned);
        ret res[*fe_sema.ModuleSema, fail.Fail].err{fail.refused(ar.err)};
    }
    ar.ok[0] = owned;
    ret res[*fe_sema.ModuleSema, fail.Fail].ok{ar.ok};
}

fun read_typed_surface(p: *project.Project, mid: session.ModuleId, a: *A.Allocator) res[fe_sema.ModuleSema, fail.Fail] {
    if (module.is_nil(mid) || mid::u32 >= project.module_count(p)) { ret res[fe_sema.ModuleSema, fail.Fail].err{fail.message("typed surface module is not loaded")}; }
    val acquired: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p,
        query.Q_TYPED_EXPORTS, module.stable_index(project.module_at(p, mid::u32).stable_id)::u64);
    if (sel acquired.err) { ret res[fe_sema.ModuleSema, fail.Fail].err{acquired.err}; }
    ret surface_from_view(p, mid, acquired.ok, a);
}

fun surface_from_view(p: *project.Project, mid: session.ModuleId, view: query.QueryView, a: *A.Allocator) res[fe_sema.ModuleSema, fail.Fail] {
    ret surface_from_bytes(p, mid, view.value, view.value_len, a);
}

fun surface_from_bytes(p: *project.Project, mid: session.ModuleId, bytes: *u8, len: u32, a: *A.Allocator) res[fe_sema.ModuleSema, fail.Fail] {
    val decoded: res[fe_sema.ModuleSema, fail.Fail] = driver_query.typed_surface_decode(?p.s.interner, a, bytes, len, project.module_at(p, mid::u32).fqn, mid);
    if (sel decoded.err) { ret decoded; }
    var owned:     fe_sema.ModuleSema = decoded.ok;
    val installed: err[fail.Fail]     = fe_sema.fields.install(p.s, ?owned.graph);
    if (sel installed.err) {
        fe_sema.module_sema_dnit(?owned);
        ret res[fe_sema.ModuleSema, fail.Fail].err{installed.err};
    }
    ret res[fe_sema.ModuleSema, fail.Fail].ok{owned};
}

# resolve reads the dep list, the gate states and the bound constants from the load walk, not through a
# query. they are one digest per module, its load view, an input every product that reads them depends
# on. a dependent folds a dep's stable id, not its view, so an edit inside the dep reaches the dependent
# only through the dep's products
fun bool_byte(b: bool) u8 {
    if (b) { ret 1; }
    ret 0;
}

fun parse_revision(p: *project.Project, m: *project.ModuleEntry) query.Revision {
    ret query.peek_revision(?p.s.queries, query.Q_PARSE, lang_source.file_index(m.file_id)::u64);
}

fun fold_bound_const(p: *project.Project, m: *project.ModuleEntry, entry: *comptime.NamedConst, fb: *wire.Sink) err[fail.Fail] {
    wire.put_u32(fb, entry.name::u32);
    wire.put_u8(fb, bool_byte(entry.gated));
    ret driver_query.ct_value_encode(fb, ?entry.value, m.stable_id, parse_revision(p, m));
}

# a bound element may name an element of the exporter's definition, so its revision is folded then
fun fold_const_import(p: *project.Project, exporter: *project.ModuleEntry, elements: bool, fb: *wire.Sink) {
    wire.put_u32(fb, exporter.stable_id::u32);
    if (elements) { wire.put_u64(fb, parse_revision(p, exporter)); }
}

# everything resolve reads from the load walk rather than through a query
fun fold_load_view(p: *project.Project, m: *project.ModuleEntry, fb: *wire.Sink) err[fail.Fail] {
    # the artifact the walk attributed the module to is what its gates and bodies read as
    # `$bin.name`, so a module another artifact reaches first is typed again
    build_fingerprint.put_name(fb, ?p.s.interner, m.load.artifact);
    wire.put_u32(fb, project.dep_count(m));
    var i: u32 = 0;
    for (i < project.dep_count(m)) {
        wire.put_u32(fb, module.stable_index(m.load.deps.data[i::usize]));
        i = i + 1;
    }
    val made: *comptime.Bindings = ?m.load.ctx.own;
    wire.put_u32(fb, made.gate_count);
    i = 0;
    for (i < made.gate_count) {
        wire.put_u8(fb, made.gate_states[i]::u8);
        i = i + 1;
    }
    var elements: bool = false;
    wire.put_u32(fb, made.entries_len);
    i = 0;
    for (i < made.entries_len) {
        if (made.entries[i].value.kind == comptime.CT_KIND_CONST_ELEM) { elements = true; }
        val bound: err[fail.Fail] = fold_bound_const(p, m, ?made.entries[i], fb);
        if (sel bound.err) { ret bound; }
        i = i + 1;
    }
    wire.put_u32(fb, made.deferred_len);
    i = 0;
    for (i < made.deferred_len) {
        wire.put_u32(fb, made.deferred[i]::u32);
        i = i + 1;
    }
    wire.put_u32(fb, m.load.bindings.len::u32);
    i = 0;
    for (i::usize < m.load.bindings.len) {
        val b: *fe_load.Binding = ?m.load.bindings.data[i::usize];
        wire.put_u32(fb, ast_id.decl_index(b.decl));
        wire.put_u8(fb, b.kind::u8);
        wire.put_u32(fb, intern.str_index(b.name));
        if (b.constant) { fold_const_import(p, project.module_at(p, fe_load.module_of(?p.loader, b.module)::u32), elements, fb); }
        or              { wire.put_u32(fb, module.stable_index(b.module)); }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# set each module's load view from what the walk left it; an unchanged view is no change
fun record_load_views(p: *project.Project) err[fail.Fail] {
    var digest: [32]u8;
    var i:      u32 = 0;
    for (i < p.topo_len) {
        val m:      *project.ModuleEntry = project.module_at(p, p.topo[i]::u32);
        var fb:     wire.Sink            = wire.digest();
        val folded: err[fail.Fail]       = fold_load_view(p, m, ?fb);
        if (sel folded.err) { ret folded; }
        val failed: opt[fail.Fail] = wire.failure(?fb);
        if (sel failed.some) { ret err[fail.Fail].err{failed.some}; }
        wire.digest_final(?fb, ?digest);
        val stored: err[fail.Fail] = query.set_input(?p.s.queries, query.Q_LOAD_VIEW, module.stable_index(m.stable_id)::u64, ?digest[0], 32);
        if (sel stored.err) { ret stored; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# every module the load reached, gated out or not, is held under the session's active retainer: the
# project borrows each one's parse. a load closes its retainer's round unless a caller keeps the round
# open across builds, and then whatever no retainer holds is retired
pub fun retain_modules(p: *project.Project, rejected: bool) err[fail.Fail] {
    val t:  *retention.Retention = ?p.s.retention;
    val id: retention.RetainerId = t.active;
    if (rejected) { retention.reject(t, id); }
    var i: u32 = 0;
    for (i < project.module_count(p)) {
        val m: *project.ModuleEntry = project.module_at(p, i);
        if (!module.stable_is_nil(m.stable_id)) {
            val recorded: err[fail.Fail] = retention.record(t, id, m.stable_id, m.file_id, rejected);
            if (sel recorded.err) { ret recorded; }
        }
        i = i + 1;
    }
    val ended: err[fail.Fail] = retention.end_round(t, id, true);
    if (sel ended.err) { ret ended; }
    ret retention.retire(t, ?p.s.queries);
}

# a product that reads the load walk's state depends on the module's view, so a view change reaches it
fun depend_load_view(p: *project.Project, m: *project.ModuleEntry) err[fail.Fail] {
    ret query.depend[project.Project](?p.queries, p, query.Q_LOAD_VIEW, module.stable_index(m.stable_id)::u64);
}

pub fun q_typed_exports_compute(p: *project.Project, key: u64, alloc: *A.Allocator, diags: *diagnostic.DiagnosticStore) res[query.QueryOutput, fail.Fail] {
    val s: *session.Session = p.s;

    val stable: session.StableModuleId = key::u32::session.StableModuleId;
    val mid:    session.ModuleId       = session.module_id_for_stable(s, stable);
    if (module.is_nil(mid)) { ret res[query.QueryOutput, fail.Fail].err{fail.message("Q_TYPED_EXPORTS: stable id not loaded this build")}; }
    val m:        *project.ModuleEntry                = project.module_at(p, mid::u32);
    val acquired: res[*fe_sema.SemaResult, fail.Fail] = acquire_sema(p, mid);
    if (sel acquired.err) { ret res[query.QueryOutput, fail.Fail].err{acquired.err}; }
    val sr:     *fe_sema.SemaResult = acquired.ok;
    val viewed: err[fail.Fail]      = depend_load_view(p, m);
    if (sel viewed.err) { ret res[query.QueryOutput, fail.Fail].err{viewed.err}; }
    val resolved: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, query.Q_RESOLVE, module.stable_index(m.stable_id)::u64);
    if (sel resolved.err) { ret res[query.QueryOutput, fail.Fail].err{resolved.err}; }
    val rr: *resolve.ResolveResult = driver_query.resolve_handle_decode(resolved.ok);
    if (rr == nil)                    { ret res[query.QueryOutput, fail.Fail].err{fail.message("typed surface has no acquired resolved owner")}; }
    if (!sel rr.status.kind.accepted) { ret res[query.QueryOutput, fail.Fail].err{fail.phase_failure(rr.status)}; }
    if (!sel sr.status.kind.accepted) { ret res[query.QueryOutput, fail.Fail].err{fail.phase_failure(sr.status)}; }

    val captured: res[fe_sema.ModuleSema, fail.Fail] = build_type_surface(p, mid, rr, sr, alloc);
    if (sel captured.err) { ret res[query.QueryOutput, fail.Fail].err{captured.err}; }
    var surface: fe_sema.ModuleSema = captured.ok;
    fin { fe_sema.module_sema_dnit(?surface); }
    val graph: res[fe_sema.fields.Graph, fail.Fail] = capture_surface_graph(p, ?surface);
    if (sel graph.err) { ret res[query.QueryOutput, fail.Fail].err{graph.err}; }
    surface.graph = graph.ok;
    var fb: wire.Sink = wire.grown(alloc);
    fin { wire.dnit(?fb); }
    val wr: err[fail.Fail] = driver_query.typed_surface_encode(?fb, ?surface);
    if (sel wr.err) { ret res[query.QueryOutput, fail.Fail].err{wr.err}; }
    ret driver_query.output(?fb);
}

rec LowerClosure {
    list:  *session.ModuleId;
    count: u32;
    cap:   u32;
}

# a module's lowering and codegen products are keyed by its stable id, and by the
# test bit for its test object
pub fun back_half_key(stable: session.StableModuleId, test_object: bool) u64 {
    var k: u64 = module.stable_index(stable)::u64;
    if (test_object) { k = k | cache.TEST_KEY_BIT; }
    ret k;
}

pub fun back_half_key_is_test(key: u64) bool {
    ret (key & cache.TEST_KEY_BIT) != 0;
}

# the normal object's key, the same in every build that compiles the module
pub fun back_half_key_for(p: *project.Project, m: *project.ModuleEntry) u64 {
    ret back_half_key(m.stable_id, false);
}

pub fun test_key_for(m: *project.ModuleEntry) u64 {
    ret cache.test_input_key(m);
}

# the module gets a test object in this build: a test build, and a module whose
# source declares a test or a `#[testing]` declaration
pub fun has_test_object(p: *project.Project, m: *project.ModuleEntry) bool {
    ret cache.has_test_object(p, m);
}

# the load restored the module's test object and nothing needs its lowered ir
fun test_skips_lowering(p: *project.Project, m: *project.ModuleEntry) bool {
    ret cache.test_restored(p, m) && cache.early_restore_enabled(p);
}

pub fun codegen_reusable(p: *project.Project, mid: session.ModuleId) res[bool, fail.Fail] {
    val m:        *project.ModuleEntry = project.module_at(p, mid::u32);
    val reusable: res[bool, fail.Fail] = query.reusable[project.Project](?p.queries, p, query.Q_CODEGEN, back_half_key_for(p, m));
    if (sel reusable.err) { ret reusable; }
    if (reusable.ok)      { ret reusable; }
    ret res[bool, fail.Fail].ok{cache.restored(p, m)};
}

pub fun test_build(p: *project.Project) bool {
    ret request.test_goal(p.req.goal);
}

# the artifact this build links is a shared library. a test build compiles the
# library's own objects, so it lowers them the way the library's build does
fun shared_artifact_build(p: *project.Project) bool {
    if (p.req.goal != request.GOAL_ARTIFACT && !test_build(p)) { ret false; }
    if (p.target_entry == nil)                                 { ret false; }
    ret p.target_entry.kind == catalog_artifact.SHARED;
}

pub fun debug_info_of(p: *project.Project) res[codegen.DebugInfo, fail.Fail] {
    var d: codegen.DebugInfo = codegen.no_debug();
    if (!p.req.debug) { ret res[codegen.DebugInfo, fail.Fail].ok{d}; }
    if (p.target.debug == nil) {
        ret res[codegen.DebugInfo, fail.Fail].err{fail.message("debug info was requested, but this target registers no debug model; build without -g or select a target with one")};
    }

    val rp: res[intern.StrId, fail.Fail] = intern_producer(?p.s.interner, p.s.alloc, p.compiler_name, p.compiler_ver);
    if (sel rp.err) { ret res[codegen.DebugInfo, fail.Fail].err{rp.err}; }
    d.emit     = true;
    d.producer = rp.ok;
    d.comp_dir = p.config.project_root;
    val prep: err[fail.Fail] = codegen.prepare_debug(p.s);
    if (sel prep.err) { ret res[codegen.DebugInfo, fail.Fail].err{prep.err}; }
    ret res[codegen.DebugInfo, fail.Fail].ok{d};
}

fun intern_producer(itn: *intern.Interner, alloc: *A.Allocator, name_id: intern.StrId, ver_id: intern.StrId) res[intern.StrId, fail.Fail] {
    val no: opt[str] = intern.get(itn, name_id);
    val vo: opt[str] = intern.get(itn, ver_id);
    if (sel no.none) {
        ret res[intern.StrId, fail.Fail].err{fail.message("debug: compiler identity not interned")};
    }
    if (sel vo.none) {
        ret res[intern.StrId, fail.Fail].err{fail.message("debug: compiler identity not interned")};
    }
    val jr: res[str, types_string.StrError] = str_join(alloc, no.some, " ", vo.some);
    if (sel jr.err) { ret res[intern.StrId, fail.Fail].err{fail.str_refused(jr.err)}; }
    val joined: str                        = jr.ok;
    val ri:     res[intern.StrId, A.Error] = intern.add(itn, joined);
    A.deallocate[u8](alloc, joined::*u8, str_len(joined) + 1);
    if (sel ri.err) { ret res[intern.StrId, fail.Fail].err{fail.refused(ri.err)}; }
    ret res[intern.StrId, fail.Fail].ok{ri.ok};
}

test intern_producer__name_version {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);

    val rn: res[intern.StrId, A.Error] = intern.add(?itn, "mach");
    val rv: res[intern.StrId, A.Error] = intern.add(?itn, "2.14.0");
    if (sel rn.err) { ret 1; }
    if (sel rv.err) { ret 1; }

    val rp: res[intern.StrId, fail.Fail] = intern_producer(?itn, ?alloc,
        rn.ok, rv.ok);
    if (sel rp.err) { ret 1; }
    val got: opt[str] = intern.get(?itn, rp.ok);
    if (sel got.none)                         { ret 1; }
    if (!str_equals(got.some, "mach 2.14.0")) { ret 1; }
    ret 0;
}

pub fun run_lower_pass(p: *project.Project) err[fail.Fail] {
    val prepared: err[fail.Fail] = acquire_lower_inputs(p);
    if (sel prepared.err) { ret prepared; }

    if (lower_parallel_enabled(p)) {
        val rp: err[fail.Fail] = run_lower_parallel(p);
        if (sel rp.err) {
            ret err[fail.Fail].err{rp.err};
        }
    }

    var i: u32 = 0;
    for (i < p.emit_len) {
        val mid: session.ModuleId = p.topo[i];
        if (cache.skips_lowering(p, project.module_at(p, mid::u32))) {
            i = i + 1;
            cnt;
        }

        val r: err[fail.Fail] = run_lower_one(p, mid);
        if (sel r.err) {
            ret err[fail.Fail].err{r.err};
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

pub fun prepare_lower_pass(p: *project.Project) err[fail.Fail] {
    val imports: err[fail.Fail] = union.register_import_libraries(p);
    if (sel imports.err) { ret err[fail.Fail].err{fail.as_user(diagnostic_kind.LINK_IMPORT_LIBRARY, imports.err)}; }

    if (!query.is_registered(?p.s.queries, query.Q_LOWERED_SURFACE)) {
        val rls: err[fail.Fail] = query.register_derived(?p.s.queries, query.Q_LOWERED_SURFACE);
        if (sel rls.err) { ret err[fail.Fail].err{rls.err}; }
    }
    if (!query.is_registered(?p.s.queries, query.Q_INLINE_BODIES)) {
        val registered: err[fail.Fail] = query.register_derived_equatable(?p.s.queries, query.Q_INLINE_BODIES, q_lower_finalize, lower_output_equal);
        if (sel registered.err) { ret err[fail.Fail].err{registered.err}; }
    }
    if (!query.is_registered(?p.s.queries, query.Q_LOWER)) {
        val rl: err[fail.Fail] = query.register_derived_equatable(?p.s.queries, query.Q_LOWER, q_lower_finalize, lower_output_equal);
        if (sel rl.err) { ret err[fail.Fail].err{rl.err}; }
    }
    ret register_codegen_product(p);
}

fun acquire_frontend_inputs(p: *project.Project) err[fail.Fail] {
    var i: u32 = 0;
    for (i < p.topo_len) {
        if (project.module_at(p, p.topo[i]::u32).frontend_skipped) {
            i = i + 1;
            cnt;
        }
        val acquired: res[fe_sema.Definition, fail.Fail] = read_definition(p::ptr, p.topo[i], fe_sema.DEFINITION_TYPED);
        if (sel acquired.err) { ret err[fail.Fail].err{acquired.err}; }
        # every lowering scope is made here, before any worker reads one
        val scoped: err[fail.Fail] = lower_scope_prepare(project.module_at(p, p.topo[i]::u32));
        if (sel scoped.err) { ret scoped; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun acquire_lower_inputs(p: *project.Project) err[fail.Fail] {
    val frontend: err[fail.Fail] = acquire_frontend_inputs(p);
    if (sel frontend.err) { ret frontend; }
    var i: u32 = 0;
    for (i < p.emit_len) {
        val m: *project.ModuleEntry = project.module_at(p, p.topo[i]::u32);
        if (m.frontend_skipped) {
            i = i + 1;
            cnt;
        }
        val sf_r: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, query.Q_LOWERED_SURFACE, module.stable_index(m.stable_id)::u64);
        if (sel sf_r.err) {
            ret err[fail.Fail].err{sf_r.err};
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun lower_reusable(p: *project.Project, mid: session.ModuleId) res[bool, fail.Fail] {
    val m: *project.ModuleEntry = project.module_at(p, mid::u32);
    ret query.reusable[project.Project](?p.queries, p, query.Q_LOWER, back_half_key_for(p, m));
}

test internal_failure_is_not_hidden_by_a_user_error {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 2; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var span: lang_source.Span;
    span.offset = 0;
    span.len    = 1;
    val emitted: err[fail.Fail] = diagnostic.report(?s.diags, diagnostic_kind.SECRET_NOT_OBLIVIOUS, lang_source.file_id(0), span, "invalid user expression");
    if (sel emitted.err) { ret 3; }
    val f: fail.Fail = fail.message("internal allocation failure after rejection");
    if (!sel f.message)                                                               { ret 4; }
    if (!str_equals(fail.describe(f), "internal allocation failure after rejection")) { ret 5; }
    ret 0;
}

test message_only_internal_failure_stays_internal {
    val f: fail.Fail = fail.message("internal failure without a diagnostic");
    if (!sel f.message)                                                         { ret 1; }
    if (!str_equals(fail.describe(f), "internal failure without a diagnostic")) { ret 2; }
    if (!fail.is_reported(fail.reported()))                                     { ret 3; }
    ret 0;
}

# the standing of the load walk alone, over every module it reached
pub fun load_status(p: *project.Project) fail.PhaseStatus {
    var status: fail.PhaseStatus = fail.accepted();
    var i:      u32              = 0;
    for (i < project.module_count(p)) {
        fail.merge(?status, project.module_at(p, i).load.status);
        i = i + 1;
    }
    ret status;
}

pub fun frontend_status(p: *project.Project) fail.PhaseStatus {
    var status: fail.PhaseStatus = fail.accepted();
    var i:      u32              = 0;
    for (i < project.module_count(p)) {
        val m: *project.ModuleEntry = project.module_at(p, i);
        fail.merge(?status, m.parse_status);
        fail.merge(?status, m.load.status);
        if (m.resolve_result != nil) { fail.merge(?status, m.resolve_result.status); }
        if (m.sema_result != nil)    { fail.merge(?status, m.sema_result.status); }
        i = i + 1;
    }
    ret status;
}

fun run_lower_one(p: *project.Project, mid: session.ModuleId) err[fail.Fail] {
    val m: *project.ModuleEntry = project.module_at(p, mid::u32);

    val e_r: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, query.Q_LOWER, back_half_key_for(p, m));
    if (sel e_r.err) { ret err[fail.Fail].err{e_r.err}; }
    val irm: *me_ir.Module = ir_handle_decode(e_r.ok);
    if (irm == nil) { ret err[fail.Fail].err{fail.message("Q_LOWER produced no result handle")}; }

    m.ir_module = irm;
    ret err[fail.Fail].ok{};
}

pub fun q_lowered_surface_compute(p: *project.Project, key: u64, alloc: *A.Allocator, diags: *diagnostic.DiagnosticStore) res[query.QueryOutput, fail.Fail] {
    val db: *query.QueryDb   = ?p.s.queries;
    val s:  *session.Session = p.s;

    val stable: session.StableModuleId = key::u32::session.StableModuleId;
    val mid:    session.ModuleId       = session.module_id_for_stable(s, stable);
    if (module.is_nil(mid)) { ret res[query.QueryOutput, fail.Fail].err{fail.message("Q_LOWERED_SURFACE: stable id not loaded this build")}; }
    val m:          *project.ModuleEntry               = project.module_at(p, mid::u32);
    val definition: res[fe_sema.Definition, fail.Fail] = read_definition(p::ptr, mid, fe_sema.DEFINITION_RESOLVED);
    if (sel definition.err) { ret res[query.QueryOutput, fail.Fail].err{definition.err}; }
    val a: *ast.Ast = definition.ok.parsed.a;

    val sf_o: opt[*lang_source.SourceFile] = lang_source.get(?s.sources, a.file_id);
    if (sel sf_o.none) { ret res[query.QueryOutput, fail.Fail].err{fail.message("Q_LOWERED_SURFACE: module source not loaded")}; }
    val text: str = sf_o.some.text;

    var spans: collections_vector.Vector[lang_source.Span] = collections_vector.init[lang_source.Span](p.s.alloc);
    fin { collections_vector.dnit[lang_source.Span](?spans); }
    val omitted: err[fail.Fail] = surface.omitted(a, text, ?spans);
    if (sel omitted.err) { ret res[query.QueryOutput, fail.Fail].err{omitted.err}; }
    var fb: wire.Sink = wire.grown(alloc);
    fin { wire.dnit(?fb); }
    surface.write(?fb, text, ?spans);
    ret driver_query.output(?fb);
}

# the inputs a module's lowering reads: its typed definition and the target. every
# product built from a raw lowering records these on itself, whether it lowers or
# takes the raw module another product captured, so no edit to the source can be
# hidden behind an equal sibling product
fun lower_inputs(p: *project.Project, key: u64) res[session.ModuleId, fail.Fail] {
    val stable: session.StableModuleId = key::u32::session.StableModuleId;
    val mid:    session.ModuleId       = session.module_id_for_stable(p.s, stable);
    if (module.is_nil(mid)) { ret res[session.ModuleId, fail.Fail].err{fail.message("Q_LOWER: stable id not loaded this build")}; }
    val definition: res[fe_sema.Definition, fail.Fail] = read_definition(p::ptr, mid, fe_sema.DEFINITION_TYPED);
    if (sel definition.err) { ret res[session.ModuleId, fail.Fail].err{definition.err}; }
    val rt: err[fail.Fail] = query.depend[project.Project](?p.queries, p, query.Q_TARGET, 0);
    if (sel rt.err) { ret res[session.ModuleId, fail.Fail].err{rt.err}; }
    ret res[session.ModuleId, fail.Fail].ok{mid};
}

fun lower_raw_candidate_compute(p: *project.Project, key: u64, alloc: *A.Allocator, diags: *diagnostic.DiagnosticStore) res[query.QueryOutput, fail.Fail] {
    val inputs: res[session.ModuleId, fail.Fail] = lower_inputs(p, key);
    if (sel inputs.err) { ret res[query.QueryOutput, fail.Fail].err{inputs.err}; }
    val mid: session.ModuleId     = inputs.ok;
    val m:   *project.ModuleEntry = project.module_at(p, mid::u32);

    # a test object declares what its normal object defines, so it lowers against that object
    var normal:      me_lower.NormalObject;
    var normal_from: *me_lower.NormalObject = nil;
    val test_object: bool                   = back_half_key_is_test(key);
    if (test_object) {
        val defined: res[me_lower.NormalObject, fail.Fail] = normal_object_of(p, m);
        if (sel defined.err) { ret res[query.QueryOutput, fail.Fail].err{defined.err}; }
        normal      = defined.ok;
        normal_from = ?normal;
    }
    fin {
        if (normal_from != nil) { map.dnit[intern.StrId, bool](?normal.defined); }
    }

    val hr: res[*me_ir.ModuleHome, fail.Fail] = ir_home_new(alloc, p.s.backing);
    if (sel hr.err) { ret res[query.QueryOutput, fail.Fail].err{hr.err}; }
    val home: *me_ir.ModuleHome = hr.ok;

    var phase: readout.Phase = readout.LOWER;
    if (test_object) { phase = readout.TEST_LOWER; }
    val t_low:  readout.Instant               = readout.item_begin(p.progress);
    val rr_raw: res[*me_ir.Module, fail.Fail] = lower_raw(p, mid, home, normal_from, diags);
    if (sel rr_raw.err) {
        val stable: fail.Fail = lower_stable_fail(p, rr_raw.err);
        ir_release(alloc, home);
        ret res[query.QueryOutput, fail.Fail].err{stable};
    }
    readout.item(p.progress, phase, intern.text(?p.s.interner, m.fqn), t_low);
    val irmod: *me_ir.Module = rr_raw.ok;

    ret ir_handle_encode(alloc, irmod, home);
}

# every global symbol the module's normal object defines, read from its codegen
# product, which this lowering then depends on
fun normal_object_of(p: *project.Project, m: *project.ModuleEntry) res[me_lower.NormalObject, fail.Fail] {
    val got: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, query.Q_CODEGEN, back_half_key_for(p, m));
    if (sel got.err) { ret res[me_lower.NormalObject, fail.Fail].err{got.err}; }
    val image: *target_of.ObjectImage = image_handle_decode(got.ok);
    if (image == nil) { ret res[me_lower.NormalObject, fail.Fail].err{fail.message("a test object requires its normal object's image")}; }
    var normal: me_lower.NormalObject = me_lower.NormalObject{defined: map.init[intern.StrId, bool](p.s.alloc)};
    var i:      u32                   = 0;
    for (i < image.symbol_count) {
        val sym: *target_of.Symbol = ?image.symbols[i];
        if ((sym.flags & target_of.SYM_OBJ_FLAG_GLOBAL) != 0 && !target_of.section_is_external(sym.section)) {
            val added: res[bool, A.Error] = map.insert[intern.StrId, bool](?normal.defined, sym.name, true);
            if (sel added.err) {
                map.dnit[intern.StrId, bool](?normal.defined);
                ret res[me_lower.NormalObject, fail.Fail].err{fail.refused(added.err)};
            }
        }
        i = i + 1;
    }
    ret res[me_lower.NormalObject, fail.Fail].ok{normal};
}

pub fun q_inline_bodies_compute(p: *project.Project, key: u64, alloc: *A.Allocator, diags: *diagnostic.DiagnosticStore) res[query.QueryOutput, fail.Fail] {
    val raw: res[query.QueryOutput, fail.Fail] = lower_raw_candidate_compute(p, key, alloc, diags);
    if (sel raw.err) { ret raw; }
    val output:      query.QueryOutput = raw.ok;
    var transferred: bool              = false;
    fin {
        if (!transferred) { release_lower_output(alloc, output); }
    }
    val src:        *me_ir.Module        = ir_handle_decode(query.QueryView{value: output.bytes, value_len: output.len});
    val normalized: res[bool, fail.Fail] = me_opt.mem2reg.run(src);
    if (sel normalized.err) { ret res[query.QueryOutput, fail.Fail].err{lower_stable_fail(p, normalized.err)}; }
    val created: res[*me_ir.ModuleHome, fail.Fail] = ir_home_new(alloc, p.s.backing);
    if (sel created.err) { ret res[query.QueryOutput, fail.Fail].err{created.err}; }
    val home:  *me_ir.ModuleHome           = created.ok;
    val boxed: res[*me_ir.Module, A.Error] = A.allocate[me_ir.Module](?home.alloc, 1::usize);
    if (sel boxed.err) {
        ir_release(alloc, home);
        ret res[query.QueryOutput, fail.Fail].err{fail.refused(boxed.err)};
    }
    val dst:         *me_ir.Module                = boxed.ok;
    val initialized: res[me_ir.Module, fail.Fail] = me_ir.init(?home.alloc, src.name);
    if (sel initialized.err) {
        ir_release(alloc, home);
        ret res[query.QueryOutput, fail.Fail].err{initialized.err};
    }
    @dst        = initialized.ok;
    dst.backing = home.backing;
    val flags: res[*bool, A.Error] = A.allocate[bool](p.s.alloc, src.function_len::usize);
    if (sel flags.err) {
        ir_release(alloc, home);
        ret res[query.QueryOutput, fail.Fail].err{fail.refused(flags.err)};
    }
    val recursive: *bool = flags.ok;
    fin {
        if (recursive != nil) { A.deallocate[bool](p.s.alloc, recursive, src.function_len::usize); }
    }
    val marked: err[fail.Fail] = me_opt.inline.mark_recursive(src, recursive, p.s.alloc);
    if (sel marked.err) {
        ir_release(alloc, home);
        ret res[query.QueryOutput, fail.Fail].err{lower_stable_fail(p, marked.err)};
    }
    val extracted: err[fail.Fail] = body.extract(dst, src, ?p.target.target, p.s.alloc, recursive, ?me_opt.inline.OFFER);
    if (sel extracted.err) {
        val stable: fail.Fail = lower_stable_fail(p, extracted.err);
        ir_release(alloc, home);
        ret res[query.QueryOutput, fail.Fail].err{stable};
    }
    val encoded: res[query.QueryOutput, fail.Fail] = ir_handle_encode(alloc, dst, home);
    if (sel encoded.err) { ret encoded; }
    if (p.raw_lower_capture != nil && p.raw_lower_capture.key == key && p.raw_lower_capture.output.bytes == nil) {
        p.raw_lower_capture.output = output;
        transferred                = true;
    }
    ret encoded;
}

fun release_lower_output(alloc: *A.Allocator, output: query.QueryOutput) {
    if (output.bytes == nil) { ret; }
    q_lower_finalize(output.bytes, output.len, alloc);
    A.deallocate[u8](alloc, output.bytes, output.len::usize);
}

fun lower_candidate_compute(p: *project.Project, key: u64, alloc: *A.Allocator, diags: *diagnostic.DiagnosticStore) res[query.QueryOutput, fail.Fail] {
    # a test object offers no bodies to inline: its tests are reached only by the dispatcher
    if (p.req.opt != pipeline.OPT_RELEASE || back_half_key_is_test(key)) { ret lower_raw_candidate_compute(p, key, alloc, diags); }
    val inputs: res[session.ModuleId, fail.Fail] = lower_inputs(p, key);
    if (sel inputs.err) { ret res[query.QueryOutput, fail.Fail].err{inputs.err}; }
    var local: project.RawLowerCapture;
    local.key = key;
    val saved: *project.RawLowerCapture = p.raw_lower_capture;
    if (saved == nil) { p.raw_lower_capture = ?local; }
    fin {
        p.raw_lower_capture = saved;
        release_lower_output(alloc, local.output);
    }
    val available: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, query.Q_INLINE_BODIES, key);
    if (sel available.err) { ret res[query.QueryOutput, fail.Fail].err{available.err}; }
    if (p.raw_lower_capture.key == key && p.raw_lower_capture.output.bytes != nil) {
        val out: query.QueryOutput = p.raw_lower_capture.output;
        p.raw_lower_capture.output = query.QueryOutput{};
        ret res[query.QueryOutput, fail.Fail].ok{out};
    }
    ret lower_raw_candidate_compute(p, key, alloc, diags);
}

# the bodies m may inline come from each defining module's normal lowering. a test
# object also takes its own module's, whose definitions its normal object holds
fun acquire_inline_bodies(p: *project.Project, m: *me_ir.Module, available: *body.Available, test_object: bool) err[fail.Fail] {
    if (p.req.opt != pipeline.OPT_RELEASE) { ret err[fail.Fail].ok{}; }
    var i: u32 = 0;
    for (i < m.function_len) {
        val origin: intern.StrId = m.functions[i].body_module;
        if ((m.functions[i].flags & me_ir.FN_FLAG_EXTERN) == 0 || intern.str_is_nil(origin) || (intern.str_same(origin, m.name) && !test_object)) {
            i = i + 1;
            cnt;
        }
        val stable: session.StableModuleId = session.stable_module_id_lookup(p.s, origin);
        if (module.stable_is_nil(stable)) { ret err[fail.Fail].err{fail.message("inline body: defining module has no stable query identity")}; }
        val got: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, query.Q_INLINE_BODIES, back_half_key(stable, false));
        if (sel got.err) { ret err[fail.Fail].err{got.err}; }
        val provider: *me_ir.Module = ir_handle_decode(got.ok);
        if (provider == nil) { ret err[fail.Fail].err{fail.message("inline body: provider has no owned product")}; }
        val imported: err[fail.Fail] = body.acquire(available, m, provider, m.functions[i].name, ?p.target.target, p.s.alloc);
        if (sel imported.err) { ret err[fail.Fail].err{imported.err}; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun q_lower_raw_compute(p: *project.Project, kind: query.QueryKind, key: u64,
    alloc: *A.Allocator, diags: *diagnostic.DiagnosticStore) res[query.QueryOutput, fail.Fail] {
    if (kind != query.Q_LOWER) { ret res[query.QueryOutput, fail.Fail].err{fail.message("raw lowering requires its Q_LOWER owner")}; }
    val raw: res[query.QueryOutput, fail.Fail] = lower_candidate_compute(p, key, alloc, diags);
    if (sel raw.err) { ret raw; }
    val output: query.QueryOutput = raw.ok;
    if (p.req.opt == pipeline.OPT_RELEASE) {
        if (p.raw_lower_capture == nil || p.raw_lower_capture.available == nil) {
            release_lower_output(alloc, output);
            ret res[query.QueryOutput, fail.Fail].err{fail.message("prepared lowering requires its scoped body owner")};
        }
        val m:        *me_ir.Module  = ir_handle_decode(query.QueryView{value: output.bytes, value_len: output.len});
        val imported: err[fail.Fail] = acquire_inline_bodies(p, m, p.raw_lower_capture.available, back_half_key_is_test(key));
        if (sel imported.err) {
            val failure: fail.Fail = lower_stable_fail(p, imported.err);
            release_lower_output(alloc, output);
            ret res[query.QueryOutput, fail.Fail].err{failure};
        }
    }
    ret raw;
}

pub fun q_lower_compute(p: *project.Project, key: u64, alloc: *A.Allocator, diags: *diagnostic.DiagnosticStore) res[query.QueryOutput, fail.Fail] {
    val raw: res[query.QueryOutput, fail.Fail] = lower_candidate_compute(p, key, alloc, diags);
    if (sel raw.err) { ret raw; }
    val output:      query.QueryOutput = raw.ok;
    var transferred: bool              = false;
    fin {
        if (!transferred) {
            q_lower_finalize(output.bytes, output.len, alloc);
            A.deallocate[u8](alloc, output.bytes, output.len::usize);
        }
    }
    val irmod:     *me_ir.Module   = ir_handle_decode(query.QueryView{value: output.bytes, value_len: output.len});
    var storage:   body.Available;
    var available: *body.Available = nil;
    fin {
        if (available != nil) { body.available_dnit(available, irmod); }
    }
    if (p.req.opt == pipeline.OPT_RELEASE) {
        val opened: err[fail.Fail] = body.available_init(?storage, irmod.name, p.s.backing, me_opt.inline.OFFER);
        if (sel opened.err) { ret res[query.QueryOutput, fail.Fail].err{opened.err}; }
        available = ?storage;
        val imported: err[fail.Fail] = acquire_inline_bodies(p, irmod, available, back_half_key_is_test(key));
        if (sel imported.err) { ret res[query.QueryOutput, fail.Fail].err{lower_stable_fail(p, imported.err)}; }
    }
    val t_opt:     readout.Instant = readout.span_begin(p.progress);
    val optimized: err[fail.Fail]  = lower_optimize(p, irmod, available, diags);
    # a test object's optimization is part of the test phase's own row
    if (!back_half_key_is_test(key)) {
        readout.item(p.progress, readout.OPTIMIZE, intern.text(?p.s.interner, irmod.name), t_opt);
        readout.span_end(p.progress, readout.OPTIMIZE, readout.LOWER, t_opt);
    }
    if (sel optimized.err) { ret res[query.QueryOutput, fail.Fail].err{lower_stable_fail(p, optimized.err)}; }
    transferred = true;
    ret raw;
}

fun lower_raw(p: *project.Project, mid: session.ModuleId, home: *me_ir.ModuleHome, normal: *me_lower.NormalObject, diags: *diagnostic.DiagnosticStore) res[*me_ir.Module, fail.Fail] {
    val s: *session.Session     = p.s;
    val m: *project.ModuleEntry = project.module_at(p, mid::u32);

    val bound: err[fail.Fail] = bind_read_constants(p, mid, normal != nil, diags);
    if (sel bound.err) { ret res[*me_ir.Module, fail.Fail].err{bound.err}; }

    val captured: res[fe_sema.SemaDeps, fail.Fail] = build_sema_deps_query(p, m);
    if (sel captured.err) { ret res[*me_ir.Module, fail.Fail].err{captured.err}; }
    var deps: fe_sema.SemaDeps = captured.ok;
    fin { free_sema_deps_query(p.s.alloc, ?deps); }
    val scoped: res[*comptime.ComptimeCtx, fail.Fail] = lower_scope_for(p, m);
    if (sel scoped.err) { ret res[*me_ir.Module, fail.Fail].err{scoped.err}; }
    val req_r: res[me_lower.LowerRequest, fail.Fail] = me_lower.request(s, ?p.target.target, ?home.alloc, m.a, m.fqn, mid,
        m.sema_result, m.resolve_result, scoped.ok, normal, shared_artifact_build(p), p.req.debug, p.req.opt != pipeline.OPT_RELEASE, diags, ?deps);
    if (sel req_r.err) { ret res[*me_ir.Module, fail.Fail].err{req_r.err}; }
    var req: me_lower.LowerRequest = req_r.ok;

    val res_lower: res[me_ir.Module, fail.Fail] = me_lower.lower_module(?req);
    if (sel res_lower.err) { ret res[*me_ir.Module, fail.Fail].err{res_lower.err}; }

    val br: res[*me_ir.Module, A.Error] = A.allocate[me_ir.Module](?home.alloc, 1::usize);
    if (sel br.err) { ret res[*me_ir.Module, fail.Fail].err{fail.refused(br.err)}; }
    val box: *me_ir.Module = br.ok;
    box[0]      = res_lower.ok;
    box.backing = home.backing;

    var scope:   me_check.scope.Scope = me_check.scope.init(box, ?p.target.target, ?s.interner, diags, s.alloc);
    val checked: err[fail.Fail]       = me_check.oblivious.run(?scope);
    if (sel checked.err) { ret res[*me_ir.Module, fail.Fail].err{checked.err}; }
    ret res[*me_ir.Module, fail.Fail].ok{box};
}

# the constants a lowering of the module reads are bound before it starts, as they
# are when every module lowers in import order: its imports' normal constants, and
# for a test object its own normal constants and its imports' `#[testing]` ones.
# a module whose own lowering this session skipped binds them in a sweep
fun bind_read_constants(p: *project.Project, mid: session.ModuleId, test_object: bool, diags: *diagnostic.DiagnosticStore) err[fail.Fail] {
    val m: *project.ModuleEntry = project.module_at(p, mid::u32);
    if (test_object) { m.test.constants_bound = true; }
    or               { m.constants_bound = true; }
    if (test_object) {
        val own: err[fail.Fail] = bind_constants_of(p, mid, false, diags);
        if (sel own.err) { ret own; }
    }
    var i: u32 = 0;
    for (i < project.dep_count(m)) {
        val d: session.ModuleId = project.dep_at(p, m, i);
        if (d::u32 < project.module_count(p)) {
            val dep: err[fail.Fail] = bind_constants_of(p, d, test_object, diags);
            if (sel dep.err) { ret dep; }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# binds the module's normal constants, and with `testing` its `#[testing]` ones after
# them, unless a lowering this session already did
fun bind_constants_of(p: *project.Project, mid: session.ModuleId, testing: bool, diags: *diagnostic.DiagnosticStore) err[fail.Fail] {
    val m: *project.ModuleEntry = project.module_at(p, mid::u32);
    if (!m.constants_bound) {
        val normal: err[fail.Fail] = bind_read_constants(p, mid, false, diags);
        if (sel normal.err) { ret normal; }
        val swept: err[fail.Fail] = sweep_constants(p, mid, me_lower.SWEEP_NORMAL, diags);
        if (sel swept.err) { ret swept; }
    }
    if (testing && !m.test.constants_bound && has_test_object(p, m)) {
        val tested: err[fail.Fail] = bind_read_constants(p, mid, true, diags);
        if (sel tested.err) { ret tested; }
        val swept: err[fail.Fail] = sweep_constants(p, mid, me_lower.SWEEP_TESTING, diags);
        if (sel swept.err) { ret swept; }
    }
    ret err[fail.Fail].ok{};
}

fun sweep_constants(p: *project.Project, mid: session.ModuleId, sweep: me_lower.BindSweep, diags: *diagnostic.DiagnosticStore) err[fail.Fail] {
    val m:          *project.ModuleEntry               = project.module_at(p, mid::u32);
    val definition: res[fe_sema.Definition, fail.Fail] = read_definition(p::ptr, mid, fe_sema.DEFINITION_TYPED);
    if (sel definition.err)                                              { ret err[fail.Fail].err{definition.err}; }
    if (!me_lower.constants_pending(p.s, m.a, definition.ok.ctx, sweep)) { ret err[fail.Fail].ok{}; }

    val captured: res[fe_sema.SemaDeps, fail.Fail] = build_sema_deps_query(p, m);
    if (sel captured.err) { ret err[fail.Fail].err{captured.err}; }
    var deps: fe_sema.SemaDeps = captured.ok;
    fin { free_sema_deps_query(p.s.alloc, ?deps); }
    val hr: res[*me_ir.ModuleHome, fail.Fail] = ir_home_new(p.s.alloc, p.s.backing);
    if (sel hr.err) { ret err[fail.Fail].err{hr.err}; }
    val home: *me_ir.ModuleHome = hr.ok;
    fin { ir_release(p.s.alloc, home); }
    val req_r: res[me_lower.LowerRequest, fail.Fail] = me_lower.request(p.s, ?p.target.target, ?home.alloc, m.a, m.fqn, mid,
        m.sema_result, m.resolve_result, definition.ok.ctx, nil, shared_artifact_build(p), p.req.debug, p.req.opt != pipeline.OPT_RELEASE, diags, ?deps);
    if (sel req_r.err) { ret err[fail.Fail].err{req_r.err}; }
    var req: me_lower.LowerRequest = req_r.ok;
    ret me_lower.bind_constants(?req, sweep);
}

fun lower_optimize(p: *project.Project, irmod: *me_ir.Module, available: *body.Available, diags: *diagnostic.DiagnosticStore) err[fail.Fail] {
    var preq: pipeline.PipelineRequest;
    preq.module            = irmod;
    preq.available         = available;
    preq.target            = ?p.target.target;
    preq.level             = p.req.opt;
    preq.vectorize_enabled = pipeline.VectorizeEnabledOption{v: p.req.vectorize};
    preq.simd_require      = pipeline.SimdRequireOption{v: p.req.simd == manifest.SIMD_REQUIRE};
    preq.float_reassoc     = pipeline.FloatReassocOption{v: p.req.float_reassoc};
    preq.interner          = ?p.s.interner;
    preq.source_map        = ?p.s.sources;
    preq.diags             = diags;
    val res_opt: res[bool, fail.Fail] = pipeline.run(?preq);
    if (sel res_opt.err) { ret err[fail.Fail].err{res_opt.err}; }
    ret err[fail.Fail].ok{};
}

fun ir_home_new(alloc: *A.Allocator, backing: *A.Allocator) res[*me_ir.ModuleHome, fail.Fail] {
    val hr: res[*me_ir.ModuleHome, A.Error] = A.allocate[me_ir.ModuleHome](alloc, 1::usize);
    if (sel hr.err) { ret res[*me_ir.ModuleHome, fail.Fail].err{fail.refused(hr.err)}; }
    val home: *me_ir.ModuleHome = hr.ok;
    val io:   err[fail.Fail]    = me_ir.home_init(home, backing);
    if (sel io.err) {
        A.deallocate[me_ir.ModuleHome](alloc, home, 1::usize);
        ret res[*me_ir.ModuleHome, fail.Fail].err{io.err};
    }
    ret res[*me_ir.ModuleHome, fail.Fail].ok{home};
}

fun lower_stable_fail(p: *project.Project, f: fail.Fail) fail.Fail {
    if (sel f.reported) { ret f; }
    ret fail.with_text(f, lower_stable_err(p, fail.describe(f)));
}

fun lower_stable_err(p: *project.Project, msg: str) str {
    val kept: res[str, fail.Fail] = fail.text_retain(?p.s.interner, msg);
    if (sel kept.ok) { ret kept.ok; }
    ret "lowering failed, and re-homing its diagnostic off the module arena failed in turn (allocation failure)";
}

fun ir_release(alloc: *A.Allocator, home: *me_ir.ModuleHome) {
    if (home == nil) { ret; }
    me_ir.home_dnit(home);
    A.deallocate[me_ir.ModuleHome](alloc, home, 1::usize);
}

fun q_lower_finalize(value: *u8, value_len: u32, alloc: *A.Allocator) {
    if (value == nil || value_len < ir_handle_len()) { ret; }
    val slot: *ptr = value::ptr::*ptr;
    ir_release(alloc, slot[1]::*me_ir.ModuleHome);
}

fun ir_handle_len() u32 {
    ret ($size_of(ptr) * 2)::u32;
}

fun ir_handle_encode(alloc: *A.Allocator, r: *me_ir.Module, home: *me_ir.ModuleHome) res[query.QueryOutput, fail.Fail] {
    val rb: res[*u8, A.Error] = A.allocate[u8](alloc, ir_handle_len()::usize);
    if (sel rb.err) {
        ir_release(alloc, home);
        ret res[query.QueryOutput, fail.Fail].err{fail.refused(rb.err)};
    }
    val buf:  *u8  = rb.ok;
    val slot: *ptr = buf::ptr::*ptr;
    slot[0] = r::ptr;
    slot[1] = home::ptr;
    var out: query.QueryOutput;
    out.bytes = buf;
    out.len   = ir_handle_len();
    ret res[query.QueryOutput, fail.Fail].ok{out};
}

fun ir_handle_decode(e: query.QueryView) *me_ir.Module {
    if (e.value == nil || e.value_len < ir_handle_len()) { ret nil; }
    val slot: *ptr = e.value::ptr::*ptr;
    ret slot[0]::*me_ir.Module;
}

fun lower_parallel_enabled(p: *project.Project) bool {
    ret p.req.jobs >= 1 && p.emit_len > 0;
}

rec PlwSlot {
    prepared:       query.PreparedQuery;
    capture:        project.RawLowerCapture;
    available:      body.Available;
    available_live: bool;
    live:           bool;
    mid:            session.ModuleId;
    m:              *me_ir.Module;
    diags:          *diagnostic.DiagnosticStore;
    failed:         bool;
    fail:           fail.Fail;
}

rec ParallelLower {
    p:        *project.Project;
    next:     i64;
    stop:     i64;
    slots:    *PlwSlot;
    slot_len: u32;
}

fun plw_worker_main(arg: *u8) {
    val pl: *ParallelLower = arg::*ParallelLower;
    if (pl == nil) { ret; }

    for (true) {
        if (atomic.load(?pl.stop) != 0) { ret; }
        val idx_raw: i64 = atomic.fetch_add(?pl.next, 1::i64);
        if (idx_raw >= pl.slot_len::i64) { ret; }

        val slot: *PlwSlot        = ?pl.slots[idx_raw::usize];
        val t0:   readout.Instant = readout.item_begin(pl.p.progress);
        val r:    err[fail.Fail]  = lower_optimize(pl.p, slot.m, slot.capture.available, slot.diags);
        val name: str             = intern.text(?pl.p.s.interner, project.module_at(pl.p, slot.mid::u32).fqn);
        readout.item_post(pl.p.progress, readout.OPTIMIZE, name, readout.elapsed(t0));
        if (sel r.err) {
            slot.fail   = r.err;
            slot.failed = true;
            atomic.store(?pl.stop, 1::i64);
            ret;
        }
    }
}

fun run_lower_parallel(p: *project.Project) err[fail.Fail] {
    val count: u32 = p.emit_len;
    if (count == 0) { ret err[fail.Fail].ok{}; }
    val allocated: res[*PlwSlot, A.Error] = A.allocate[PlwSlot](p.alloc, count::usize);
    if (sel allocated.err) { ret err[fail.Fail].err{fail.refused(allocated.err)}; }
    val slots: *PlwSlot = allocated.ok;
    fin { A.deallocate[PlwSlot](p.alloc, slots, count::usize); }
    var i: u32 = 0;
    for (i < count) {
        slots[i] = PlwSlot{};
        i        = i + 1;
    }
    var result: err[fail.Fail] = run_lower_batch(p, slots, count);
    i = 0;
    for (i < count) {
        if (slots[i].available_live) {
            body.available_dnit(?slots[i].available, slots[i].m);
            slots[i].available_live = false;
        }
        release_lower_output(p.s.queries.a, slots[i].capture.output);
        slots[i].capture.output = query.QueryOutput{};
        if (slots[i].live) {
            val cancelled: err[fail.Fail] = query.cancel_prepared(?p.s.queries, slots[i].prepared);
            if (sel cancelled.err) {
                if (!(sel result.err && !(fail.is_reported(result.err)))) {
                    result = err[fail.Fail].err{cancelled.err};
                }
            }
        }
        i = i + 1;
    }
    ret result;
}

fun prime_inline_bodies(p: *project.Project, capture: *project.RawLowerCapture) err[fail.Fail] {
    val saved: *project.RawLowerCapture = p.raw_lower_capture;
    p.raw_lower_capture = capture;
    fin { p.raw_lower_capture = saved; }
    val got: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, query.Q_INLINE_BODIES, capture.key);
    if (sel got.err) { ret err[fail.Fail].err{got.err}; }
    ret err[fail.Fail].ok{};
}

fun prepare_lower_slot(p: *project.Project, capture: *project.RawLowerCapture) res[query.PreparedQuery, fail.Fail] {
    val saved: *project.RawLowerCapture = p.raw_lower_capture;
    p.raw_lower_capture = capture;
    fin { p.raw_lower_capture = saved; }
    ret query.prepare[project.Project](?p.queries, p, query.Q_LOWER, capture.key, q_lower_raw_compute);
}

fun run_lower_batch(p: *project.Project, slots: *PlwSlot, emit_len: u32) err[fail.Fail] {
    var slot_len: u32 = 0;
    var ti:       u32 = 0;
    for (ti < emit_len) {
        val mid:      session.ModuleId     = p.topo[ti];
        val reusable: res[bool, fail.Fail] = lower_reusable(p, mid);
        if (sel reusable.err) {
            ret err[fail.Fail].err{reusable.err};
        }
        if (!reusable.ok && !cache.skips_lowering(p, project.module_at(p, mid::u32))) {
            slots[slot_len].mid    = mid;
            slots[slot_len].m      = nil;
            slots[slot_len].failed = false;
            slot_len               = slot_len + 1;
        }
        ti = ti + 1;
    }
    if (slot_len <= 1) {
        ret err[fail.Fail].ok{};
    }
    var prime: u32 = 0;
    for (prime < slot_len) {
        val m: *project.ModuleEntry = project.module_at(p, slots[prime].mid::u32);
        slots[prime].capture.key = back_half_key_for(p, m);
        if (p.req.opt == pipeline.OPT_RELEASE) {
            val initialized: err[fail.Fail] = body.available_init(?slots[prime].available, m.fqn, p.s.backing, me_opt.inline.OFFER);
            if (sel initialized.err) { ret err[fail.Fail].err{initialized.err}; }
            slots[prime].available_live    = true;
            slots[prime].capture.available = ?slots[prime].available;
            val primed: err[fail.Fail] = prime_inline_bodies(p, ?slots[prime].capture);
            if (sel primed.err) { ret primed; }
        }
        prime = prime + 1;
    }

    var si: u32 = 0;
    for (si < slot_len) {
        val mid: session.ModuleId     = slots[si].mid;
        val m:   *project.ModuleEntry = project.module_at(p, mid::u32);

        val prepared: res[query.PreparedQuery, fail.Fail] = prepare_lower_slot(p, ?slots[si].capture);
        if (sel prepared.err) { ret err[fail.Fail].err{prepared.err}; }
        slots[si].prepared = prepared.ok;
        slots[si].live     = true;
        val view: res[query.QueryView, fail.Fail] = query.prepared_view(?p.s.queries, slots[si].prepared);
        if (sel view.err) { ret err[fail.Fail].err{view.err}; }
        slots[si].m = ir_handle_decode(view.ok);
        if (slots[si].m == nil) { ret err[fail.Fail].err{fail.message("prepared lowering has no IR owner")}; }
        val store: res[*diagnostic.DiagnosticStore, fail.Fail] = query.prepared_diags(?p.s.queries, slots[si].prepared);
        if (sel store.err) { ret err[fail.Fail].err{store.err}; }
        slots[si].diags = store.ok;
        si              = si + 1;
    }

    if (p.raw_lower_capture != nil) { ret err[fail.Fail].err{fail.message("lower: synchronous raw capture escaped into worker execution")}; }
    var nworkers: u32 = p.req.jobs;
    if (nworkers == 0)       { nworkers = 1; }
    if (nworkers > slot_len) { nworkers = slot_len; }

    var pl: ParallelLower;
    pl.p        = p;
    pl.next     = 0;
    pl.stop     = 0;
    pl.slots    = slots;
    pl.slot_len = slot_len;

    val queued: err[fail.Fail] = readout.workers_begin(p.progress, p.alloc, slot_len::usize);
    if (sel queued.err) { ret queued; }
    val t_opt:   readout.Instant     = readout.span_begin(p.progress);
    var threads: *sync_thread.Thread = nil;
    val extra:   u32                 = nworkers - 1;
    p.lowering_workers = true;
    fin { p.lowering_workers = false; }
    if (extra > 0) {
        val rt: res[*sync_thread.Thread, A.Error] = A.allocate[sync_thread.Thread](p.alloc, extra::usize);
        if (sel rt.err) {
            readout.workers_end(p.progress, p.alloc, readout.OPTIMIZE, 1);
            ret err[fail.Fail].err{fail.refused(rt.err)};
        }
        threads = rt.ok;
        var k: u32 = 0;
        for (k < extra) {
            sync_thread.spawn_with(plw_worker_main, (?pl)::*u8, ?threads[k]);
            k = k + 1;
        }
    }

    plw_worker_main((?pl)::*u8);

    if (extra > 0) {
        var k: u32 = 0;
        for (k < extra) {
            if (threads[k].tid >= 0) { sync_thread.join(?threads[k]); }
            k = k + 1;
        }
        A.deallocate[sync_thread.Thread](p.alloc, threads, extra::usize);
    }
    readout.span_end(p.progress, readout.OPTIMIZE, readout.LOWER, t_opt);

    readout.workers_end(p.progress, p.alloc, readout.OPTIMIZE, nworkers);

    var ei: u32 = 0;
    for (ei < slot_len) {
        if (slots[ei].failed) {
            val result: err[fail.Fail] = query.complete_prepared(?p.s.queries, slots[ei].prepared,
                err[fail.Fail].err{slots[ei].fail});
            slots[ei].live = false;
            ret result;
        }
        ei = ei + 1;
    }
    ei = 0;
    for (ei < slot_len) {
        val result: err[fail.Fail] = query.complete_prepared(?p.s.queries, slots[ei].prepared, err[fail.Fail].ok{});
        slots[ei].live = false;
        if (sel result.err) { ret result; }
        ei = ei + 1;
    }
    ret err[fail.Fail].ok{};
}

fun lower_visit_reserve(p: *project.Project, needed: u32) err[fail.Fail] {
    val old:   u32          = p.lower_visit_cap;
    val grown: err[A.Error] = growth.reserve[u32](p.s.alloc, ?p.lower_visit_gen, ?p.lower_visit_cap, needed::usize);
    if (sel grown.err) { ret err[fail.Fail].err{fail.refused(grown.err)}; }
    var i: u32 = old;
    for (i < p.lower_visit_cap) {
        p.lower_visit_gen[i] = 0;
        i                    = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun collect_lower_closure(p: *project.Project, m: *project.ModuleEntry) res[LowerClosure, fail.Fail] {
    var cl: LowerClosure;
    cl.list  = nil;
    cl.count = 0;
    cl.cap   = 0;
    if (project.dep_count(m) == 0 || project.module_count(p) == 0) { ret res[LowerClosure, fail.Fail].ok{cl}; }

    val cr: err[fail.Fail] = lower_visit_reserve(p, project.module_count(p));
    if (sel cr.err) { ret res[LowerClosure, fail.Fail].err{cr.err}; }
    p.lower_visit_epoch = p.lower_visit_epoch + 1;
    val epoch: u32  = p.lower_visit_epoch;
    val gen:   *u32 = p.lower_visit_gen;

    val lr: res[*session.ModuleId, A.Error] = A.allocate[session.ModuleId](p.s.alloc, project.module_count(p)::usize);
    if (sel lr.err) { ret res[LowerClosure, fail.Fail].err{fail.refused(lr.err)}; }
    val list:     *session.ModuleId = lr.ok;
    var list_len: u32               = 0;

    var i: u32 = 0;
    for (i < project.dep_count(m)) {
        val d: session.ModuleId = project.dep_at(p, m, i);
        if (d::u32 < project.module_count(p) && gen[d::u32] != epoch) {
            gen[d::u32]    = epoch;
            list[list_len] = d;
            list_len       = list_len + 1;
        }
        i = i + 1;
    }

    var head: u32 = 0;
    for (head < list_len) {
        val cur: session.ModuleId     = list[head];
        val cm:  *project.ModuleEntry = project.module_at(p, cur::u32);
        var j:   u32                  = 0;
        for (j < project.dep_count(cm)) {
            val d: session.ModuleId = project.dep_at(p, cm, j);
            if (d::u32 < project.module_count(p) && gen[d::u32] != epoch) {
                gen[d::u32]    = epoch;
                list[list_len] = d;
                list_len       = list_len + 1;
            }
            j = j + 1;
        }
        head = head + 1;
    }

    cl.list  = list;
    cl.count = list_len;
    cl.cap   = project.module_count(p);
    ret res[LowerClosure, fail.Fail].ok{cl};
}

fun free_lower_closure(alloc: *A.Allocator, cl: *LowerClosure) {
    if (cl.list == nil || cl.cap == 0) { ret; }
    A.deallocate[session.ModuleId](alloc, cl.list, cl.cap::usize);
    cl.list  = nil;
    cl.count = 0;
    cl.cap   = 0;
}

# the codegen product is registered from the lower pass on: the early restore
# asks whether the session still holds one before it reads `obj/`
fun register_codegen_product(p: *project.Project) err[fail.Fail] {
    if (!query.is_registered(?p.s.queries, query.Q_CODEGEN)) {
        val rcg: err[fail.Fail] = query.register_derived_owned(?p.s.queries, query.Q_CODEGEN, q_codegen_finalize);
        if (sel rcg.err) { ret err[fail.Fail].err{rcg.err}; }
    }
    ret err[fail.Fail].ok{};
}

pub fun prepare_codegen_pass(p: *project.Project) err[fail.Fail] {
    ret register_codegen_product(p);
}

# the modules that still lower here are those without a product restored under
# this operation's snapshot; a module restored in the lower operation keeps its
# staged product when the snapshot is unchanged and lowers now if it changed
pub fun acquire_codegen_inputs(p: *project.Project) err[fail.Fail] {
    var clear: u32 = 0;
    for (clear < project.module_count(p)) {
        project.module_at(p, clear).ir_module = nil;
        clear                                 = clear + 1;
    }
    val frontend: err[fail.Fail] = acquire_frontend_inputs(p);
    if (sel frontend.err) { ret frontend; }
    var i: u32 = 0;
    for (i < p.emit_len) {
        val mid: session.ModuleId = p.topo[i];
        if (cache.skips_lowering(p, project.module_at(p, mid::u32))) {
            i = i + 1;
            cnt;
        }
        val acquired: err[fail.Fail] = run_lower_one(p, mid);
        if (sel acquired.err) { ret err[fail.Fail].err{acquired.err}; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# the test operation's inputs: the typed definitions and each test object's
# lowered ir, unless the load restored its object from `obj/`
pub fun acquire_test_inputs(p: *project.Project) err[fail.Fail] {
    var clear: u32 = 0;
    for (clear < project.module_count(p)) {
        project.module_at(p, clear).test.ir_module = nil;
        clear                                      = clear + 1;
    }
    val frontend: err[fail.Fail] = acquire_frontend_inputs(p);
    if (sel frontend.err) { ret frontend; }
    var i: u32 = 0;
    for (i < p.emit_len) {
        val mid: session.ModuleId     = p.topo[i];
        val m:   *project.ModuleEntry = project.module_at(p, mid::u32);
        if (has_test_object(p, m) && !test_skips_lowering(p, m)) {
            val lowered: err[fail.Fail] = run_test_lower_one(p, mid);
            if (sel lowered.err) { ret err[fail.Fail].err{lowered.err}; }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

#[testing]
pub fun run_test_pass(p: *project.Project) err[fail.Fail] {
    val inputs: err[fail.Fail] = acquire_test_inputs(p);
    if (sel inputs.err) { ret inputs; }
    ret run_test_object_pass(p);
}

pub fun run_test_object_pass(p: *project.Project) err[fail.Fail] {
    var i: u32 = 0;
    for (i < p.emit_len) {
        val mid: session.ModuleId = p.topo[i];
        if (has_test_object(p, project.module_at(p, mid::u32))) {
            val r: err[fail.Fail] = run_test_object_one(p, mid);
            if (sel r.err) { ret err[fail.Fail].err{r.err}; }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

pub fun run_codegen_pass(p: *project.Project) err[fail.Fail] {
    val inputs: err[fail.Fail] = acquire_codegen_inputs(p);
    if (sel inputs.err) { ret inputs; }
    var i: u32 = 0;
    for (i < p.emit_len) {
        val mid: session.ModuleId = p.topo[i];

        val r: err[fail.Fail] = run_codegen_one(p, mid);
        if (sel r.err) {
            ret err[fail.Fail].err{r.err};
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# the other modules' lowered ir a whole-module backend reads to generate `seed`, module mid's ir
pub fun code_sources(p: *project.Project, mid: session.ModuleId, seed: *me_ir.Module, a: *A.Allocator) res[CodeSources, fail.Fail] {
    if (!isa.emits_whole_module(p.target.isa)) { ret res[CodeSources, fail.Fail].ok{sources_empty()}; }
    val n: u32 = project.module_count(p);
    if (n == 0) { ret res[CodeSources, fail.Fail].ok{sources_empty()}; }

    val rm: res[*bool, A.Error] = A.allocate[bool](a, n::usize);
    if (sel rm.err) { ret res[CodeSources, fail.Fail].err{fail.refused(rm.err)}; }
    val mark: *bool = rm.ok;
    var i:    u32   = 0;
    for (i < n) {
        mark[i] = false;
        i       = i + 1;
    }
    mark[mid::u32] = true;

    var changed: bool = true;
    for (changed) {
        changed = false;
        i       = 0;
        for (i < n) {
            if (!mark[i]) {
                i = i + 1;
                cnt;
            }
            var im: *me_ir.Module = project.module_at(p, i).ir_module;
            if (i == mid::u32) { im = seed; }
            if (im == nil) {
                i = i + 1;
                cnt;
            }
            var fi: u32 = 0;
            for (fi < im.function_len) {
                val fn: *me_ir.Function = ?im.functions[fi];
                if ((fn.flags & me_ir.FN_FLAG_EXTERN) == 0 || fn.is_import) {
                    fi = fi + 1;
                    cnt;
                }
                val def: u32 = definer_of(p, fn.name);
                if (def != n && !mark[def]) {
                    mark[def] = true;
                    changed   = true;
                }
                fi = fi + 1;
            }
            var gi: u32 = 0;
            for (gi < im.global_len) {
                val g: *me_ir.Global = ?im.globals[gi];
                if (!g.is_extern || g.is_import) {
                    gi = gi + 1;
                    cnt;
                }
                val gdef: u32 = global_definer_of(p, g.name);
                if (gdef != n && !mark[gdef]) {
                    mark[gdef] = true;
                    changed    = true;
                }
                gi = gi + 1;
            }
            i = i + 1;
        }
    }

    var count: u32 = 0;
    i = 0;
    for (i < n) {
        if (mark[i] && source_of(p, i, mid, seed) != nil) { count = count + 1; }
        i = i + 1;
    }
    if (count == 0) {
        A.deallocate[bool](a, mark, n::usize);
        ret res[CodeSources, fail.Fail].ok{sources_empty()};
    }

    var cs: CodeSources                  = sources_empty();
    val rs: res[**me_ir.Module, A.Error] = A.allocate[*me_ir.Module](a, count::usize);
    if (sel rs.err) {
        A.deallocate[bool](a, mark, n::usize);
        ret res[CodeSources, fail.Fail].err{fail.refused(rs.err)};
    }
    cs.set.mods = rs.ok;
    val ri: res[*session.ModuleId, A.Error] = A.allocate[session.ModuleId](a, count::usize);
    if (sel ri.err) {
        A.deallocate[*me_ir.Module](a, cs.set.mods, count::usize);
        A.deallocate[bool](a, mark, n::usize);
        ret res[CodeSources, fail.Fail].err{fail.refused(ri.err)};
    }
    cs.ids = ri.ok;
    cs.cap = count;

    var ti: u32 = 0;
    for (ti < p.topo_len) {
        val tid: u32 = p.topo[ti]::u32;
        if (mark[tid] && source_of(p, tid, mid, seed) != nil && cs.set.len < count) {
            cs.set.mods[cs.set.len] = project.module_at(p, tid).ir_module;
            cs.ids[cs.set.len]      = p.topo[ti];
            cs.set.len              = cs.set.len + 1;
        }
        ti = ti + 1;
    }
    A.deallocate[bool](a, mark, n::usize);
    ret res[CodeSources, fail.Fail].ok{cs};
}

# module i's ir as a code source for generating `seed`: another module's lowered ir,
# or the module's own normal ir when `seed` is its test object
fun source_of(p: *project.Project, i: u32, mid: session.ModuleId, seed: *me_ir.Module) *me_ir.Module {
    val im: *me_ir.Module = project.module_at(p, i).ir_module;
    if (i == mid::u32 && im == seed) { ret nil; }
    ret im;
}

pub rec CodeSources {
    set: mir_unit.IrSet;
    ids: *session.ModuleId;
    cap: u32;
}

fun sources_empty() CodeSources {
    var cs: CodeSources;
    cs.set = mir_unit.ir_set_empty();
    cs.ids = nil;
    cs.cap = 0;
    ret cs;
}

pub fun sources_dnit(a: *A.Allocator, cs: *CodeSources) {
    if (cs.cap > 0) {
        if (cs.set.mods != nil) { A.deallocate[*me_ir.Module](a, cs.set.mods, cs.cap::usize); }
        if (cs.ids != nil)      { A.deallocate[session.ModuleId](a, cs.ids, cs.cap::usize); }
    }
    cs.set.mods = nil;
    cs.set.len  = 0;
    cs.ids      = nil;
    cs.cap      = 0;
}

fun definer_of(p: *project.Project, name: intern.StrId) u32 {
    var i: u32 = 0;
    for (i < project.module_count(p)) {
        val im: *me_ir.Module = project.module_at(p, i).ir_module;
        if (im != nil && mir_unit.defined_index(im, name) != mir_unit.UNIT_NONE) { ret i; }
        i = i + 1;
    }
    ret project.module_count(p);
}

fun global_definer_of(p: *project.Project, name: intern.StrId) u32 {
    var i: u32 = 0;
    for (i < project.module_count(p)) {
        val im: *me_ir.Module = project.module_at(p, i).ir_module;
        if (im != nil && mir_unit.defined_global_index(im, name) != mir_unit.UNIT_NONE) { ret i; }
        i = i + 1;
    }
    ret project.module_count(p);
}

fun run_codegen_one(p: *project.Project, mid: session.ModuleId) err[fail.Fail] {
    val m: *project.ModuleEntry = project.module_at(p, mid::u32);

    val e_r: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, query.Q_CODEGEN, back_half_key_for(p, m));
    if (sel e_r.err) { ret err[fail.Fail].err{e_r.err}; }
    val img: *target_of.ObjectImage = image_handle_decode(e_r.ok);
    if (img == nil) { ret err[fail.Fail].err{fail.message("Q_CODEGEN produced no result handle")}; }

    m.object_image = img;
    # a generated object, or one this session held, carries the key of the
    # current snapshot into `obj/`
    ret cache.publish(p, m, img, back_half_key_for(p, m));
}

# the module's test object, lowered against its normal object and generated
fun run_test_object_one(p: *project.Project, mid: session.ModuleId) err[fail.Fail] {
    val m: *project.ModuleEntry = project.module_at(p, mid::u32);

    val e_r: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, query.Q_CODEGEN, test_key_for(m));
    if (sel e_r.err) { ret err[fail.Fail].err{e_r.err}; }
    val img: *target_of.ObjectImage = image_handle_decode(e_r.ok);
    if (img == nil) { ret err[fail.Fail].err{fail.message("Q_CODEGEN produced no test object handle")}; }

    m.test.object_image = img;
    ret cache.publish_test(p, m, img, test_key_for(m));
}

# the module's test ir, which test codegen workers read before the query publishes the object
fun run_test_lower_one(p: *project.Project, mid: session.ModuleId) err[fail.Fail] {
    val m:   *project.ModuleEntry            = project.module_at(p, mid::u32);
    val e_r: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, query.Q_LOWER, test_key_for(m));
    if (sel e_r.err) { ret err[fail.Fail].err{e_r.err}; }
    val irm: *me_ir.Module = ir_handle_decode(e_r.ok);
    if (irm == nil) { ret err[fail.Fail].err{fail.message("Q_LOWER produced no test object handle")}; }
    m.test.ir_module = irm;
    ret err[fail.Fail].ok{};
}

# the test object's codegen product is current or cached, so no worker generates it
pub fun test_codegen_reusable(p: *project.Project, mid: session.ModuleId) res[bool, fail.Fail] {
    val m:        *project.ModuleEntry = project.module_at(p, mid::u32);
    val reusable: res[bool, fail.Fail] = query.reusable[project.Project](?p.queries, p, query.Q_CODEGEN, test_key_for(m));
    if (sel reusable.err) { ret reusable; }
    if (reusable.ok)      { ret reusable; }
    ret res[bool, fail.Fail].ok{cache.test_restored(p, m)};
}

pub fun q_codegen_compute(p: *project.Project, key: u64, alloc: *A.Allocator, diags: *diagnostic.DiagnosticStore) res[query.QueryOutput, fail.Fail] {
    val db: *query.QueryDb   = ?p.s.queries;
    val s:  *session.Session = p.s;

    val stable: session.StableModuleId = key::u32::session.StableModuleId;
    val mid:    session.ModuleId       = session.module_id_for_stable(s, stable);
    if (module.is_nil(mid)) { ret res[query.QueryOutput, fail.Fail].err{fail.message("Q_CODEGEN: stable id not loaded this build")}; }
    val m:           *project.ModuleEntry = project.module_at(p, mid::u32);
    val test_object: bool                 = back_half_key_is_test(key);
    if (!test_object && cache.staged_restored(p, m))     { ret q_codegen_restored(p, mid, false, alloc); }
    if (test_object && cache.test_staged_restored(p, m)) { ret q_codegen_restored(p, mid, true, alloc); }
    val lower_owner: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, query.Q_LOWER, key);
    if (sel lower_owner.err) { ret res[query.QueryOutput, fail.Fail].err{lower_owner.err}; }
    val irmod: *me_ir.Module = ir_handle_decode(lower_owner.ok);
    if (irmod == nil) { ret res[query.QueryOutput, fail.Fail].err{fail.message("Q_CODEGEN: module has no lowered IR")}; }
    if (test_object)  { m.test.ir_module = irmod; }
    or                { m.ir_module = irmod; }
    val rt: err[fail.Fail] = query.depend[project.Project](?p.queries, p, query.Q_TARGET, 0);
    if (sel rt.err) { ret res[query.QueryOutput, fail.Fail].err{rt.err}; }

    val srcs_r: res[CodeSources, fail.Fail] = code_sources(p, mid, irmod, s.alloc);
    if (sel srcs_r.err) { ret res[query.QueryOutput, fail.Fail].err{srcs_r.err}; }
    var srcs: CodeSources = srcs_r.ok;
    var di:   u32         = 0;
    for (di < srcs.set.len) {
        val dm: *project.ModuleEntry = project.module_at(p, srcs.ids[di]::u32);
        val rd: err[fail.Fail]       = query.depend[project.Project](?p.queries, p, query.Q_LOWER, back_half_key_for(p, dm));
        if (sel rd.err) {
            sources_dnit(s.alloc, ?srcs);
            ret res[query.QueryOutput, fail.Fail].err{rd.err};
        }
        di = di + 1;
    }

    # a parallel codegen worker staged this object's fresh image
    var staged: *target_of.ObjectImage = nil;
    if (test_object) { staged = cache.take_staged_test(p, m); }
    or               { staged = cache.take_staged(p, m); }
    if (staged != nil) {
        sources_dnit(s.alloc, ?srcs);
        ret image_handle_encode(alloc, staged);
    }

    val dbg_r: res[codegen.DebugInfo, fail.Fail] = debug_info_of(p);
    if (sel dbg_r.err) {
        sources_dnit(s.alloc, ?srcs);
        ret res[query.QueryOutput, fail.Fail].err{dbg_r.err};
    }

    var phase: readout.Phase = readout.CODEGEN;
    if (test_object) { phase = readout.TEST_CODEGEN; }
    val t_cg:   readout.Instant                       = readout.item_begin(p.progress);
    val res_cg: res[target_of.ObjectImage, fail.Fail] = codegen.codegen_unit(s, ?p.target, irmod, srcs.set, nil, dbg_r.ok, diags);
    sources_dnit(s.alloc, ?srcs);
    if (sel res_cg.err) { ret res[query.QueryOutput, fail.Fail].err{res_cg.err}; }
    readout.item(p.progress, phase, intern.text(?p.s.interner, m.fqn), t_cg);
    var img: target_of.ObjectImage = res_cg.ok;

    val br: res[*target_of.ObjectImage, A.Error] = A.allocate[target_of.ObjectImage](alloc, 1::usize);
    if (sel br.err) {
        target_of.object_image_dnit(?img);
        ret res[query.QueryOutput, fail.Fail].err{fail.refused(br.err)};
    }
    val box: *target_of.ObjectImage = br.ok;
    box[0] = img;
    ret image_handle_encode(alloc, box);
}

# a product restored from `obj/` becomes the module's codegen product with the
# target and the codegen flags as its edges, plus the module's object key,
# which is the persistent key's in-process image: any input the key covers
# advances it. a test object's key derives from the same one. it reads no
# typed definition, so a module nothing compiled imports is never typed
fun q_codegen_restored(p: *project.Project, mid: session.ModuleId, test_object: bool, alloc: *A.Allocator) res[query.QueryOutput, fail.Fail] {
    val m:  *project.ModuleEntry = project.module_at(p, mid::u32);
    val rt: err[fail.Fail]       = query.depend[project.Project](?p.queries, p, query.Q_TARGET, 0);
    if (sel rt.err) { ret res[query.QueryOutput, fail.Fail].err{rt.err}; }
    var input: u64 = module.stable_index(m.stable_id)::u64;
    if (test_object) { input = cache.test_input_key(m); }
    val keyed: err[fail.Fail] = query.depend[project.Project](?p.queries, p, query.Q_OBJECT_KEY, input);
    if (sel keyed.err) { ret res[query.QueryOutput, fail.Fail].err{keyed.err}; }
    var staged: *target_of.ObjectImage = nil;
    if (test_object)   { staged = cache.take_staged_test(p, m); }
    or                 { staged = cache.take_staged(p, m); }
    if (staged == nil) { ret res[query.QueryOutput, fail.Fail].err{fail.message("Q_CODEGEN: restored product left the module")}; }
    ret image_handle_encode(alloc, staged);
}

fun q_codegen_finalize(value: *u8, value_len: u32, alloc: *A.Allocator) {
    if (value == nil || value_len::usize < $size_of(ptr)) { ret; }
    val slot: *ptr                   = value::ptr::*ptr;
    val r:    *target_of.ObjectImage = slot[0]::*target_of.ObjectImage;
    if (r == nil) { ret; }
    target_of.object_image_dnit(r);
    A.deallocate[target_of.ObjectImage](alloc, r, 1::usize);
}

fun image_handle_encode(alloc: *A.Allocator, r: *target_of.ObjectImage) res[query.QueryOutput, fail.Fail] {
    val n:  u32               = $size_of(ptr)::u32;
    val rb: res[*u8, A.Error] = A.allocate[u8](alloc, n::usize);
    if (sel rb.err) {
        target_of.object_image_dnit(r);
        A.deallocate[target_of.ObjectImage](alloc, r, 1::usize);
        ret res[query.QueryOutput, fail.Fail].err{fail.refused(rb.err)};
    }
    val buf:  *u8  = rb.ok;
    val slot: *ptr = buf::ptr::*ptr;
    slot[0] = r::ptr;
    var out: query.QueryOutput;
    out.bytes = buf;
    out.len   = n;
    ret res[query.QueryOutput, fail.Fail].ok{out};
}

fun image_handle_decode(e: query.QueryView) *target_of.ObjectImage {
    if (e.value == nil || e.value_len::usize < $size_of(ptr)) { ret nil; }
    val slot: *ptr = e.value::ptr::*ptr;
    ret slot[0]::*target_of.ObjectImage;
}

pub fun prepare_link_pass(p: *project.Project) err[fail.Fail] {
    if (!query.is_registered(?p.s.queries, query.Q_LINK)) {
        val rln: err[fail.Fail] = query.register_derived(?p.s.queries, query.Q_LINK);
        if (sel rln.err) { ret err[fail.Fail].err{rln.err}; }
    }

    ret err[fail.Fail].ok{};
}

pub fun run_link_pass(p: *project.Project) res[bool, fail.Fail] {
    val images: err[fail.Fail] = run_codegen_pass(p);
    if (sel images.err) { ret res[bool, fail.Fail].err{images.err}; }
    val prior: query.Revision                  = query.peek_revision(?p.s.queries, query.Q_LINK, 0);
    val e_r:   res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, query.Q_LINK, 0);
    if (sel e_r.err) { ret res[bool, fail.Fail].err{e_r.err}; }
    val now: query.Revision = e_r.ok.last_changed;
    ret res[bool, fail.Fail].ok{now != prior};
}

pub fun q_link_compute(p: *project.Project, key: u64, alloc: *A.Allocator, diags: *diagnostic.DiagnosticStore) res[query.QueryOutput, fail.Fail] {
    val db: *query.QueryDb   = ?p.s.queries;
    val s:  *session.Session = p.s;

    var fb: wire.Sink = wire.grown(alloc);
    fin { wire.dnit(?fb); }

    val rt: res[query.Revision, fail.Fail] = query.revision[project.Project](?p.queries, p, query.Q_TARGET, 0);
    if (sel rt.err) { ret res[query.QueryOutput, fail.Fail].err{rt.err}; }
    wire.put_u64(?fb, rt.ok);

    val rc: res[query.Revision, fail.Fail] = query.revision[project.Project](?p.queries, p, query.Q_LINK_CONFIG, 0);
    if (sel rc.err) { ret res[query.QueryOutput, fail.Fail].err{rc.err}; }
    wire.put_u64(?fb, rc.ok);

    wire.put_u32(?fb, p.emit_len);
    var i: u32 = 0;
    for (i < p.emit_len) {
        val m:  *project.ModuleEntry           = project.module_at(p, (p.topo[i])::u32);
        val rd: res[query.Revision, fail.Fail] = query.revision[project.Project](?p.queries, p, query.Q_CODEGEN, back_half_key_for(p, m));
        if (sel rd.err) { ret res[query.QueryOutput, fail.Fail].err{rd.err}; }
        wire.put_u64(?fb, rd.ok);
        # a test build links each test object too
        if (has_test_object(p, m)) {
            val rtest: res[query.Revision, fail.Fail] = query.revision[project.Project](?p.queries, p, query.Q_CODEGEN, test_key_for(m));
            if (sel rtest.err) { ret res[query.QueryOutput, fail.Fail].err{rtest.err}; }
            wire.put_u64(?fb, rtest.ok);
        }
        i = i + 1;
    }

    ret driver_query.output(?fb);
}

# a module's own export, with the constant type checking left it bound to
fun own_type_export(p: *project.Project, mid: session.ModuleId, symbol: *resolve.Symbol,
    rr: *resolve.ResolveResult, sr: *fe_sema.SemaResult) res[fe_sema.TypeExport, fail.Fail] {
    var row: fe_sema.TypeExport = fe_sema.TypeExport{
        origin:   project.module_at(p, mid::u32).stable_id, canon: symbol.canon, ty: type.TYPE_NIL,
        constant: resolve.ExportConstant{name: symbol.canon}
    };
    if (symbol.definition_kind == resolve.SYM_USE) { ret res[fe_sema.TypeExport, fail.Fail].ok{row}; }
    if (!module.same(symbol.origin, mid) || sr == nil || ast_id.decl_is_nil(symbol.decl) || ast_id.decl_index(symbol.decl) >= sr.decl_count) {
        ret res[fe_sema.TypeExport, fail.Fail].err{fail.message("typed export has no matching current declaration")};
    }
    row.ty = sr.decl_type[ast_id.decl_index(symbol.decl)];
    if (symbol.definition_kind == resolve.SYM_VAL) {
        var typed: comptime.ComptimeCtx = comptime.stage_init(?project.module_at(p, mid::u32).load.ctx, comptime.STAGE_LOWER, p.s.alloc);
        fin { comptime.dnit(?typed); }
        comptime.layer_set(?typed, comptime.STAGE_RESOLVE, ?rr.constants);
        comptime.layer_set(?typed, comptime.STAGE_SEMA, ?sr.constants);
        val found: opt[comptime.NamedConst] = comptime.lookup(?typed, symbol.canon);
        if (sel found.some) {
            val constant: comptime.NamedConst = found.some;
            row.constant.present = true;
            row.constant.gated   = constant.gated;
            row.constant.value   = constant.value;
            if (constant.value.kind == comptime.CT_KIND_CONST_ELEM) {
                row.definition_incarnation = project.module_at(p, mid::u32).a.incarnation;
            }
        }
    }
    ret res[fe_sema.TypeExport, fail.Fail].ok{row};
}

rec OriginSurface { module: session.ModuleId; surface: fe_sema.ModuleSema; }

fun free_origin_surfaces(decoded: *collections_vector.Vector[OriginSurface]) {
    var i: usize = 0;
    for (i < decoded.len) {
        fe_sema.module_sema_dnit(?decoded.data[i].surface);
        i = i + 1;
    }
    collections_vector.dnit[OriginSurface](decoded);
}

# one decode per origin module while a surface is built, however many symbols it forwards
fun origin_surface(p: *project.Project, mid: session.ModuleId, decoded: *collections_vector.Vector[OriginSurface]) res[*fe_sema.ModuleSema, fail.Fail] {
    var i: usize = 0;
    for (i < decoded.len) {
        if (module.same(decoded.data[i].module, mid)) { ret res[*fe_sema.ModuleSema, fail.Fail].ok{?decoded.data[i].surface}; }
        i = i + 1;
    }
    val acquired: res[fe_sema.ModuleSema, fail.Fail] = read_typed_surface(p, mid, p.s.alloc);
    if (sel acquired.err) { ret res[*fe_sema.ModuleSema, fail.Fail].err{acquired.err}; }
    var surface: fe_sema.ModuleSema  = acquired.ok;
    val added:   res[usize, A.Error] = collections_vector.push[OriginSurface](decoded, OriginSurface{module: mid, surface: surface});
    if (sel added.err) {
        fe_sema.module_sema_dnit(?surface);
        ret res[*fe_sema.ModuleSema, fail.Fail].err{fail.refused(added.err)};
    }
    ret res[*fe_sema.ModuleSema, fail.Fail].ok{?decoded.data[decoded.len - 1].surface};
}

fun imported_type_export(p: *project.Project, symbol: *resolve.Symbol,
    decoded: *collections_vector.Vector[OriginSurface]) res[fe_sema.TypeExport, fail.Fail] {
    val mid: session.ModuleId = symbol.origin;
    if (module.is_nil(mid) || mid::u32 >= project.module_count(p)) { ret res[fe_sema.TypeExport, fail.Fail].err{fail.message("forwarded type origin is not loaded")}; }
    val acquired: res[*fe_sema.ModuleSema, fail.Fail] = origin_surface(p, mid, decoded);
    if (sel acquired.err) { ret res[fe_sema.TypeExport, fail.Fail].err{acquired.err}; }
    val surface: *fe_sema.ModuleSema    = acquired.ok;
    val origin:  session.StableModuleId = project.module_at(p, mid::u32).stable_id;
    var i:       usize                  = 0;
    for (i < surface.exports.len) {
        val row: fe_sema.TypeExport = surface.exports.data[i];
        if (module.stable_same(row.origin, origin) && intern.str_same(row.canon, symbol.canon)) { ret res[fe_sema.TypeExport, fail.Fail].ok{row}; }
        i = i + 1;
    }
    ret res[fe_sema.TypeExport, fail.Fail].err{fail.message("forwarded type has no acquired canonical public surface")};
}

fun build_type_surface(p: *project.Project, mid: session.ModuleId, rr: *resolve.ResolveResult,
    sr: *fe_sema.SemaResult, a: *A.Allocator) res[fe_sema.ModuleSema, fail.Fail] {
    var surface:     fe_sema.ModuleSema = fe_sema.module_sema_init(a, project.module_at(p, mid::u32).fqn, mid);
    var transferred: bool               = false;
    fin {
        if (!transferred) { fe_sema.module_sema_dnit(?surface); }
    }
    var decoded: collections_vector.Vector[OriginSurface] = collections_vector.init[OriginSurface](p.s.alloc);
    fin { free_origin_surfaces(?decoded); }
    var i: u32 = 0;
    for (i < rr.pub_count) {
        val symbol:   *resolve.Symbol = ?rr.symbols[i];
        var captured: res[fe_sema.TypeExport, fail.Fail];
        if (module.same(symbol.origin, mid)) { captured = own_type_export(p, mid, symbol, rr, sr); }
        or                                   { captured = imported_type_export(p, symbol, ?decoded); }
        if (sel captured.err)                { ret res[fe_sema.ModuleSema, fail.Fail].err{captured.err}; }
        val added: res[usize, A.Error] = collections_vector.push[fe_sema.TypeExport](?surface.exports, captured.ok);
        if (sel added.err) { ret res[fe_sema.ModuleSema, fail.Fail].err{fail.refused(added.err)}; }
        i = i + 1;
    }
    transferred = true;
    ret res[fe_sema.ModuleSema, fail.Fail].ok{surface};
}

fun prepared_surface_recipe(p: *project.Project, ty: type.TypeId) err[fail.Fail] {
    val field_table_for_r: opt[*type.FieldTable] = type.field_table_for(?p.s.types, ty);
    if (sel field_table_for_r.none) {
        ret err[fail.Fail].err{fail.message("public nominal recipe was not prepared by its acquired semantic owner")};
    }
    ret err[fail.Fail].ok{};
}

fun capture_surface_graph(p: *project.Project, surface: *fe_sema.ModuleSema) res[fe_sema.fields.Graph, fail.Fail] {
    var roots: collections_vector.Vector[type.TypeId] = collections_vector.init[type.TypeId](surface.exports.a);
    fin { collections_vector.dnit[type.TypeId](?roots); }
    var i: usize = 0;
    for (i < surface.exports.len) {
        val row:   *fe_sema.TypeExport = ?surface.exports.data[i];
        val added: res[usize, A.Error] = collections_vector.push[type.TypeId](?roots, row.ty);
        if (sel added.err) { ret res[fe_sema.fields.Graph, fail.Fail].err{fail.refused(added.err)}; }
        if (row.constant.present) {
            val value: comptime.CTValue = row.constant.value;
            var extra: type.TypeId      = type.TYPE_NIL;
            if (value.kind == comptime.CT_KIND_TYPE)                                         { extra = value.data.t::type.TypeId; }
            or (value.kind == comptime.CT_KIND_FIELD || value.kind == comptime.CT_KIND_CASE) { extra = value.data.fld.owner::type.TypeId; }
            or (value.kind == comptime.CT_KIND_PACK_ELEM)                                    { extra = value.data.pelem.ty::type.TypeId; }
            or (value.kind == comptime.CT_KIND_CONST_ELEM)                                   { extra = value.data.celem.ty::type.TypeId; }
            val added: res[usize, A.Error] = collections_vector.push[type.TypeId](?roots, extra);
            if (sel added.err) { ret res[fe_sema.fields.Graph, fail.Fail].err{fail.refused(added.err)}; }
        }
        i = i + 1;
    }
    var group:     fe_sema.fields.Roots                 = fe_sema.fields.Roots{data: roots.data, len: roots.len};
    val capture_r: res[fe_sema.fields.Graph, fail.Fail] = fe_sema.fields.capture[project.Project](p.s, surface.exports.a, ?group, 1, fe_sema.fields.RECIPES,
        project.module_at(p, surface.module::u32).load.ctx.env.target_defs, p, prepared_surface_recipe);
    if (sel capture_r.err) { ret res[fe_sema.fields.Graph, fail.Fail].err{capture_r.err}; }
    ret res[fe_sema.fields.Graph, fail.Fail].ok{capture_r.ok};
}

pub fun capture_build_config(p: *project.Project, alloc: *A.Allocator) res[query.QueryOutput, fail.Fail] {
    var fb: wire.Sink = wire.grown(alloc);
    fin { wire.dnit(?fb); }
    val written: err[fail.Fail] = write_build_config(?fb, p, alloc);
    if (sel written.err) { ret res[query.QueryOutput, fail.Fail].err{written.err}; }
    ret driver_query.output(?fb);
}

# the configuration without the planner environment: what a persistent product
# may key on. steps that ran are keyed by their own fingerprint chain, and the
# inherited environment reaches an object only through them.
#[testing]
fun capture_build_identity(p: *project.Project, alloc: *A.Allocator) res[query.QueryOutput, fail.Fail] {
    var fb: wire.Sink = wire.grown(alloc);
    fin { wire.dnit(?fb); }
    val written: err[fail.Fail] = write_build_identity(?fb, p, alloc);
    if (sel written.err) { ret res[query.QueryOutput, fail.Fail].err{written.err}; }
    ret driver_query.output(?fb);
}

# the build identity without the request: the persistent key hashes the request
# itself, with the project root in canonical form, so the spelled root stays out
fun capture_configuration_identity(p: *project.Project, alloc: *A.Allocator) res[query.QueryOutput, fail.Fail] {
    var fb: wire.Sink = wire.grown(alloc);
    fin { wire.dnit(?fb); }
    write_configuration_identity(?fb, p);
    ret driver_query.output(?fb);
}

# key the loaded modules and read `obj/` under their keys (driver/cache),
# reported as the cache phase carved out of resolve, which it precedes
pub fun prepare_object_cache(p: *project.Project) err[fail.Fail] {
    if (!p.req.object_cache) {
        cache.forget(p);
        ret err[fail.Fail].ok{};
    }
    readout.phase_begin(p.progress, readout.CACHE);
    val t_cache:  readout.Instant                   = readout.span_begin(p.progress);
    val captured: res[query.QueryOutput, fail.Fail] = capture_configuration_identity(p, p.s.backing);
    if (sel captured.err) { ret err[fail.Fail].err{captured.err}; }
    val config: query.QueryOutput = captured.ok;
    fin {
        if (config.bytes != nil) { A.deallocate[u8](p.s.backing, config.bytes, config.len::usize); }
    }
    val prepared: err[fail.Fail] = cache.prepare(p, config.bytes, config.len::usize, readout.CACHE);
    readout.span_end(p.progress, readout.CACHE, readout.RESOLVE, t_cache);
    readout.phase_end(p.progress, readout.CACHE, p.emit_len - cache.generated_count(p), "module", "modules");
    ret prepared;
}

pub fun set_build_config_input(p: *project.Project) err[fail.Fail] {
    val captured: res[query.QueryOutput, fail.Fail] = capture_build_config(p, p.s.alloc);
    if (sel captured.err) { ret err[fail.Fail].err{captured.err}; }
    val bytes: query.QueryOutput = captured.ok;
    fin {
        if (bytes.bytes != nil) { A.deallocate[u8](p.s.alloc, bytes.bytes, bytes.len::usize); }
    }
    ret query.set_input(?p.s.queries, query.Q_TARGET, 0, bytes.bytes, bytes.len);
}

fun write_build_config(fb: *wire.Sink, p: *project.Project, a: *A.Allocator) err[fail.Fail] {
    val identity: err[fail.Fail] = write_build_identity(fb, p, a);
    if (sel identity.err) { ret identity; }
    ret write_step_environment(fb, p, a);
}

fun write_build_identity(fb: *wire.Sink, p: *project.Project, a: *A.Allocator) err[fail.Fail] {
    var digest: [32]u8;
    val hr:     err[fail.Fail] = request.semantic_hash(a, ?p.req, ?digest[0]);
    if (sel hr.err) { ret err[fail.Fail].err{hr.err}; }
    wire.put_bytes(fb, ?digest[0], request.HASH_SIZE);
    write_configuration_identity(fb, p);
    ret err[fail.Fail].ok{};
}

fun write_configuration_identity(fb: *wire.Sink, p: *project.Project) {
    write_target_fingerprint(fb, p);
    build_fingerprint.put_name(fb, ?p.s.interner, p.target_entry.os_name);
    build_fingerprint.put_name(fb, ?p.s.interner, p.target_entry.isa_name);
    build_fingerprint.put_name(fb, ?p.s.interner, p.target_entry.abi_name);
    build_fingerprint.put_name(fb, ?p.s.interner, p.target_entry.platform_name);
    build_fingerprint.put_name(fb, ?p.s.interner, p.config.id);
    build_fingerprint.put_name(fb, ?p.s.interner, p.config.version);
    build_fingerprint.put_name(fb, ?p.s.interner, p.config.bin_name);
    write_dependency_identities(fb, p);
    # the root set decides which entries load and how gates are walked
    wire.put_u8(fb, p.roots::u8);
    write_requirement_scopes(fb, p);
    write_step_declarations(fb, p);
}

# the identity each dependency's modules read as `$mach.project.*`
fun write_dependency_identities(fb: *wire.Sink, p: *project.Project) {
    wire.put_u32(fb, p.config.dep_count);
    var i: u32 = 0;
    for (i < p.config.dep_count) {
        build_fingerprint.put_name(fb, ?p.s.interner, p.config.deps[i].project_id);
        build_fingerprint.put_name(fb, ?p.s.interner, p.config.deps[i].manifest.version);
        i = i + 1;
    }
}

# the `{artifact.<id>.out}` vocabulary each project's modules resolve an embed
# in: sema reads it, so a cell that resolves other requirements is another
# configuration and a module's products are not reused across the two
fun write_requirement_scopes(fb: *wire.Sink, p: *project.Project) {
    wire.put_u32(fb, p.config.req_scope_count);
    var si: u32 = 0;
    for (si < p.config.req_scope_count) {
        val sc: *template.Requirements = ?p.config.req_scopes[si];
        build_fingerprint.put_name(fb, ?p.s.interner, sc.owner);
        var dependency: u8 = 0;
        if (sc.dependency) { dependency = 1; }
        wire.put_u8(fb, dependency);
        wire.put_u32(fb, sc.req_count);
        var ri: u32 = 0;
        for (ri < sc.req_count) {
            build_fingerprint.put_text(fb, sc.reqs[ri].name);
            build_fingerprint.put_text(fb, sc.reqs[ri].out);
            ri = ri + 1;
        }
        si = si + 1;
    }
}

# the target's fingerprint behind its u32 length, measured first
fun write_target_fingerprint(fb: *wire.Sink, p: *project.Project) {
    var measured: wire.Sink = wire.measure();
    target_fingerprint.put(?p.target, ?measured);
    val failed: opt[fail.Fail] = wire.failure(?measured);
    if (sel failed.some) {
        wire.refuse(fb, failed.some);
        ret;
    }
    if (measured.len > 0xFFFFFFFF::usize) {
        wire.refuse(fb, fail.message("target fingerprint exceeds 32-bit length"));
        ret;
    }
    wire.put_u32(fb, measured.len::u32);
    target_fingerprint.put(?p.target, fb);
}

fun write_step_declarations(fb: *wire.Sink, p: *project.Project) {
    wire.put_u32(fb, p.config.step_count);
    var si: u32 = 0;
    for (si < p.config.step_count) {
        val st: *manifest.StepDef = ?p.config.steps[si];
        build_fingerprint.put_name(fb, ?p.s.interner, st.name);
        wire.put_u32(fb, st.env_count);
        var ei: u32 = 0;
        for (ei < st.env_count) {
            build_fingerprint.put_name(fb, ?p.s.interner, st.env_keys[ei]);
            build_fingerprint.put_name(fb, ?p.s.interner, st.env_values[ei]);
            ei = ei + 1;
        }
        si = si + 1;
    }
}

fun write_step_environment(fb: *wire.Sink, p: *project.Project, a: *A.Allocator) err[fail.Fail] {
    if (p.config.step_count == 0 && p.config.dep_count == 0) {
        wire.put_u32(fb, 0);
        ret err[fail.Fail].ok{};
    }
    val inherited: **u8 = env.environ();
    if (inherited == nil) { ret err[fail.Fail].err{fail.message("planner environment unavailable")}; }
    ret write_planner_environment(fb, a, inherited);
}

# planner inputs cover child inheritance and executable lookup for root and dependency steps
fun write_planner_environment(fb: *wire.Sink, a: *A.Allocator, inherited: **u8) err[fail.Fail] {
    val captured: res[driver_environment.Environment, fail.Fail] = driver_environment.capture(a, inherited);
    if (sel captured.err) { ret err[fail.Fail].err{captured.err}; }
    var environment: driver_environment.Environment = captured.ok;
    fin { driver_environment.dnit(?environment); }
    val exported: res[driver_environment.Strings, fail.Fail] = driver_environment.to_strings(?environment);
    if (sel exported.err) { ret err[fail.Fail].err{exported.err}; }
    var strings: driver_environment.Strings = exported.ok;
    fin { driver_environment.strings_free(a, ?strings); }
    wire.put_u32(fb, strings.count);
    var i: u32 = 0;
    for (i < strings.count) {
        build_fingerprint.put_text(fb, strings.items[i]::str);
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

test write_build_config__distinguishes_target_identity {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }

    val tx: res[lang_target.Binding, fail.Fail] = lang_target.t_select("x86_64", "linux", "sysv64");
    val ta: res[lang_target.Binding, fail.Fail] = lang_target.t_select("aarch64", "linux", "aapcs64");
    if (sel tx.err) { ret 1; }
    if (sel ta.err) { ret 1; }

    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var te: project.TargetEntry;
    te.os_name       = intern.STR_NIL;
    te.isa_name      = intern.STR_NIL;
    te.abi_name      = intern.STR_NIL;
    te.platform_name = intern.STR_NIL;
    var cfg: project.ProjectConfig;
    cfg.id       = intern.STR_NIL;
    cfg.version  = intern.STR_NIL;
    cfg.bin_name = intern.STR_NIL;

    var px: project.Project;
    px.s            = ?s;
    px.req          = request.defaults();
    px.target       = tx.ok;
    px.target_entry = ?te;
    px.config       = cfg;

    var pa: project.Project;
    pa.s            = ?s;
    pa.req          = request.defaults();
    pa.target       = ta.ok;
    pa.target_entry = ?te;
    pa.config       = cfg;

    var dx: [32]u8;
    var da: [32]u8;
    if (!t_build_config_digest(?alloc, ?px, ?dx[0])) { ret 1; }
    if (!t_build_config_digest(?alloc, ?pa, ?da[0])) { ret 1; }
    if (!ut_digest_differs(?dx[0], ?da[0]))          { ret 1; }
    ret 0;
}

# the root set and the requirement scopes are configuration: a union cell and an
# artifact cell of one target are different builds, as are two cells whose modules
# resolve `{artifact.<id>.out}` over different requirements
test write_build_config__root_set_and_requirement_scopes_move_the_fingerprint {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }

    val tx: res[lang_target.Binding, fail.Fail] = lang_target.t_select("x86_64", "linux", "sysv64");
    if (sel tx.err) { ret 1; }

    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }

    var te: project.TargetEntry;
    te.os_name       = intern.STR_NIL;
    te.isa_name      = intern.STR_NIL;
    te.abi_name      = intern.STR_NIL;
    te.platform_name = intern.STR_NIL;
    var cfg: project.ProjectConfig;
    cfg.id       = intern.STR_NIL;
    cfg.version  = intern.STR_NIL;
    cfg.bin_name = intern.STR_NIL;

    var base: project.Project;
    base.s            = ?s;
    base.req          = request.defaults();
    base.target       = tx.ok;
    base.target_entry = ?te;
    base.config       = cfg;
    base.roots        = project.ROOT_ARTIFACT;
    var d_base: [32]u8;
    if (!t_build_config_digest(?alloc, ?base, ?d_base[0])) { ret 1; }

    var union_cell: project.Project = base;
    union_cell.roots = project.ROOT_UNION;
    var d_union: [32]u8;
    if (!t_build_config_digest(?alloc, ?union_cell, ?d_union[0])) { ret 1; }
    if (!ut_digest_differs(?d_base[0], ?d_union[0]))              { ret 2; }

    var req:   template.Requirement  = template.Requirement{name: "shader-vert", out: "out/spv/vert.spv"};
    var scope: template.Requirements = template.Requirements{owner: intern.STR_NIL, dependency: false,
        reqs: ?req, req_count: 1};
    var scoped: project.Project = base;
    scoped.config.req_scopes      = ?scope;
    scoped.config.req_scope_count = 1;
    var d_scoped: [32]u8;
    if (!t_build_config_digest(?alloc, ?scoped, ?d_scoped[0])) { ret 1; }
    if (!ut_digest_differs(?d_base[0], ?d_scoped[0]))          { ret 3; }

    # the same requirement resolving to another output is another scope
    req.out = "out/spv/vert.bin";
    var d_moved: [32]u8;
    if (!t_build_config_digest(?alloc, ?scoped, ?d_moved[0])) { ret 1; }
    if (!ut_digest_differs(?d_scoped[0], ?d_moved[0]))        { ret 4; }
    ret 0;
}

fun build_resolve_deps(p: *project.Project, m: *project.ModuleEntry, list: *session.ModuleId) res[resolve.ResolveDeps, fail.Fail] {
    var deps: resolve.ResolveDeps;
    deps.entries = nil;
    deps.count   = 0;
    if (project.dep_count(m) == 0) { ret res[resolve.ResolveDeps, fail.Fail].ok{deps}; }

    var list_len: u32 = 0;

    var i: u32 = 0;
    for (i < project.dep_count(m)) {
        val d: session.ModuleId = project.dep_at(p, m, i);
        if (d::u32 < project.module_count(p) && !resolve_list_contains(list, list_len, d)) {
            list[list_len] = d;
            list_len       = list_len + 1;
        }
        i = i + 1;
    }

    var head: u32 = 0;
    for (head < list_len) {
        add_reexport_targets(p, list[head], list, ?list_len);
        head = head + 1;
    }
    ret assemble_resolve_deps(p, list, list_len);
}

fun assemble_resolve_deps(p: *project.Project, list: *session.ModuleId, list_len: u32) res[resolve.ResolveDeps, fail.Fail] {
    var deps: resolve.ResolveDeps                  = resolve.ResolveDeps{};
    val r:    res[*resolve.ModuleExports, A.Error] = A.allocate[resolve.ModuleExports](p.s.alloc, list_len::usize);
    if (sel r.err) { ret res[resolve.ResolveDeps, fail.Fail].err{fail.refused(r.err)}; }
    deps.entries = r.ok;
    deps.count   = list_len;

    var z: u32 = 0;
    for (z < list_len) {
        deps.entries[z].symbols = nil;
        deps.entries[z].count   = 0;
        z                       = z + 1;
    }

    var k: u32 = 0;
    for (k < list_len) {
        val dep_id: session.ModuleId                      = list[k];
        val mx_r:   res[resolve.ModuleExports, fail.Fail] = build_module_exports(p, dep_id, project.module_at(p, dep_id::u32));
        if (sel mx_r.err) {
            free_resolve_deps(p.s.alloc, ?deps);
            ret res[resolve.ResolveDeps, fail.Fail].err{mx_r.err};
        }
        deps.entries[k] = mx_r.ok;
        k               = k + 1;
    }
    ret res[resolve.ResolveDeps, fail.Fail].ok{deps};
}

pub fun module_in_current_project(p: *project.Project, fqn: intern.StrId) bool {
    val fqn_text:     str = intern.text(?p.s.interner, fqn);
    val proj_id_text: str = intern.text(?p.s.interner, p.config.id);

    val fqn_len:  usize = str_len(fqn_text);
    var head_end: usize = 0;
    for (head_end < fqn_len && fqn_text[head_end] != '.') { head_end = head_end + 1; }
    ret view_eq_str(view(fqn_text::*char, head_end), proj_id_text);
}

fun add_reexport_targets(p: *project.Project, mid: session.ModuleId, list: *session.ModuleId, list_len: *u32) {
    val dep: *project.ModuleEntry = project.module_at(p, mid::u32);
    if (!dep.resolved || dep.resolve_result == nil) { ret; }
    val rr: *resolve.ResolveResult = dep.resolve_result;
    if (rr.symbols == nil) { ret; }
    var i: u32 = 0;
    for (i < rr.pub_count) {
        val s: *resolve.Symbol = ?rr.symbols[i];
        if (s.kind == resolve.SYM_USE) {
            val target_mid: session.ModuleId = s.slot::session.ModuleId;
            if (target_mid::u32 < project.module_count(p) && !resolve_list_contains(list, @list_len, target_mid)) {
                list[@list_len] = target_mid;
                @list_len       = @list_len + 1;
            }
        }
        i = i + 1;
    }
}

fun build_module_exports(p: *project.Project, dep_id: session.ModuleId, dep: *project.ModuleEntry) res[resolve.ModuleExports, fail.Fail] {
    var mx: resolve.ModuleExports;
    mx.path    = dep.fqn;
    mx.module  = dep_id;
    mx.symbols = nil;
    mx.count   = 0;
    mx.refused = dep.resolve_result != nil && dep.resolve_result.refused;
    if (!dep.resolved || dep.resolve_result == nil || dep.resolve_result.pub_count == 0) {
        ret res[resolve.ModuleExports, fail.Fail].ok{mx};
    }
    val pcount: u32                                 = dep.resolve_result.pub_count;
    val r:      res[*resolve.PublicSymbol, A.Error] = A.allocate[resolve.PublicSymbol](p.s.alloc, pcount::usize);
    if (sel r.err) { ret res[resolve.ModuleExports, fail.Fail].err{fail.refused(r.err)}; }
    val syms: *resolve.PublicSymbol = r.ok;

    var i: u32 = 0;
    for (i < pcount) {
        val sym: *resolve.Symbol = ?dep.resolve_result.symbols[i];
        var ps:  resolve.PublicSymbol;
        ps.kind                = sym.definition_kind;
        ps.name                = sym.name;
        ps.canon               = sym.canon;
        ps.file                = sym.definition_file;
        ps.generic_arity       = sym.generic_arity;
        ps.has_comptime_params = sym.has_comptime_params;
        ps.has_pack_param      = sym.has_pack_param;
        ps.deprecation         = sym.deprecation;
        ps.testing             = sym.testing;
        ps.slot                = sym.slot;
        ps.origin              = sym.origin;
        syms[i]                = ps;
        i                      = i + 1;
    }

    mx.symbols = syms;
    mx.count   = pcount;
    ret res[resolve.ModuleExports, fail.Fail].ok{mx};
}

fun free_resolve_deps(alloc: *A.Allocator, deps: *resolve.ResolveDeps) {
    if (deps.entries == nil) { ret; }
    var i: u32 = 0;
    for (i < deps.count) {
        val mx: *resolve.ModuleExports = ?deps.entries[i];
        if (mx.symbols != nil && mx.count > 0) {
            A.deallocate[resolve.PublicSymbol](alloc, mx.symbols, mx.count::usize);
        }
        i = i + 1;
    }
    A.deallocate[resolve.ModuleExports](alloc, deps.entries, deps.count::usize);
    deps.entries = nil;
    deps.count   = 0;
}

#[testing]
fun t_build_config_digest(alloc: *A.Allocator, p: *project.Project, out: *u8) bool {
    var fb:      wire.Sink      = wire.digest();
    val written: err[fail.Fail] = write_build_config(?fb, p, alloc);
    if (sel written.err || fb.failed) { ret false; }
    wire.digest_final(?fb, out::*[32]u8);
    ret true;
}

#[testing]
fun ut_digest_differs(a: *u8, b: *u8) bool {
    var i: usize = 0;
    for (i < 32) {
        if (a[i] != b[i]) { ret true; }
        i = i + 1;
    }
    ret false;
}

test write_build_config__every_tuple_field_moves_the_fingerprint {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }

    val tx_r: res[lang_target.Binding, fail.Fail] = lang_target.t_select("x86_64", "linux", "sysv64");
    val ta_r: res[lang_target.Binding, fail.Fail] = lang_target.t_select("aarch64", "linux", "aapcs64");
    val tw_r: res[lang_target.Binding, fail.Fail] = lang_target.t_select("x86_64", "windows", "win64");
    if (sel tx_r.err) { ret 1; }
    if (sel ta_r.err) { ret 1; }
    if (sel tw_r.err) { ret 1; }
    val tx: lang_target.Binding = tx_r.ok;
    val ta: lang_target.Binding = ta_r.ok;
    val tw: lang_target.Binding = tw_r.ok;

    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }

    var te: project.TargetEntry;
    te.os_name       = intern.STR_NIL;
    te.isa_name      = intern.STR_NIL;
    te.abi_name      = intern.STR_NIL;
    te.platform_name = intern.STR_NIL;
    var cfg: project.ProjectConfig;
    cfg.id       = intern.STR_NIL;
    cfg.version  = intern.STR_NIL;
    cfg.bin_name = intern.STR_NIL;

    var base: project.Project;
    base.s            = ?s;
    base.req          = request.defaults();
    base.req.profile  = "debug";
    base.target       = tx;
    base.target_entry = ?te;
    base.config       = cfg;

    val N:       usize = 10;
    var digests: [10][32]u8;
    if (!t_build_config_digest(?alloc, ?base, ?digests[0][0])) { ret 1; }

    var v: project.Project = base;
    v.target.target.arch_id = ta.target.arch_id;
    if (!t_build_config_digest(?alloc, ?v, ?digests[1][0])) { ret 1; }

    v                      = base;
    v.target.target.abi_id = ta.target.abi_id;
    if (!t_build_config_digest(?alloc, ?v, ?digests[2][0])) { ret 1; }

    v                     = base;
    v.target.target.os_id = tw.target.os_id;
    if (!t_build_config_digest(?alloc, ?v, ?digests[3][0])) { ret 1; }

    v           = base;
    v.target.of = tw.of;
    if (!t_build_config_digest(?alloc, ?v, ?digests[4][0])) { ret 1; }

    v                        = base;
    v.target.target.debug_id = base.target.target.debug_id + 1;
    if (!t_build_config_digest(?alloc, ?v, ?digests[5][0])) { ret 1; }

    v                             = base;
    v.target.target.stack_reserve = base.target.target.stack_reserve + 0x1000;
    if (!t_build_config_digest(?alloc, ?v, ?digests[6][0])) { ret 1; }

    v                            = base;
    v.target.target.stack_commit = base.target.target.stack_commit + 0x1000;
    if (!t_build_config_digest(?alloc, ?v, ?digests[7][0])) { ret 1; }

    v             = base;
    v.req.profile = "release";
    if (!t_build_config_digest(?alloc, ?v, ?digests[8][0])) { ret 1; }

    var env_keys:   [1]intern.StrId;
    var env_values: [1]intern.StrId;
    val intern_r2:  res[intern.StrId, A.Error] = intern.add(?s.interner, "MODE");
    if (sel intern_r2.err) { ret 99; }
    env_keys[0] = intern_r2.ok;
    val intern_r3: res[intern.StrId, A.Error] = intern.add(?s.interner, "audit");
    if (sel intern_r3.err) { ret 99; }
    env_values[0] = intern_r3.ok;
    var steps:     [1]manifest.StepDef;
    val intern_r4: res[intern.StrId, A.Error] = intern.add(?s.interner, "generate");
    if (sel intern_r4.err) { ret 99; }
    steps[0].name       = intern_r4.ok;
    steps[0].env_keys   = ?env_keys[0];
    steps[0].env_values = ?env_values[0];
    steps[0].env_count  = 1;
    v                   = base;
    v.config.steps      = ?steps[0];
    v.config.step_count = 1;
    if (!t_build_config_digest(?alloc, ?v, ?digests[9][0])) { ret 1; }

    var i: usize = 0;
    for (i < N) {
        var j: usize = i + 1;
        for (j < N) {
            if (!ut_digest_differs(?digests[i][0], ?digests[j][0])) { ret 1; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret 0;
}

#[testing]
fun t_capture_bytes(p: *project.Project, a: *A.Allocator, identity: bool) res[query.QueryOutput, fail.Fail] {
    if (identity) { ret capture_build_identity(p, a); }
    ret capture_build_config(p, a);
}

#[testing]
fun t_capture_equal(a: *A.Allocator, left: *project.Project, right: *project.Project, identity: bool) i32 {
    val l: res[query.QueryOutput, fail.Fail] = t_capture_bytes(left, a, identity);
    val r: res[query.QueryOutput, fail.Fail] = t_capture_bytes(right, a, identity);
    if (sel l.err) { ret -1; }
    if (sel r.err) { ret -1; }
    val lb: query.QueryOutput = l.ok;
    val rb: query.QueryOutput = r.ok;
    fin {
        if (lb.bytes != nil) { A.deallocate[u8](a, lb.bytes, lb.len::usize); }
        if (rb.bytes != nil) { A.deallocate[u8](a, rb.bytes, rb.len::usize); }
    }
    if (lb.len != rb.len) { ret 0; }
    var i: u32 = 0;
    for (i < lb.len) {
        if (lb.bytes[i] != rb.bytes[i]) { ret 0; }
        i = i + 1;
    }
    ret 1;
}

# 1 when the configuration is the identity followed by more: what it samples beyond it
#[testing]
fun t_config_extends_identity(a: *A.Allocator, p: *project.Project) i32 {
    val c: res[query.QueryOutput, fail.Fail] = t_capture_bytes(p, a, false);
    val d: res[query.QueryOutput, fail.Fail] = t_capture_bytes(p, a, true);
    if (sel c.err) { ret -1; }
    if (sel d.err) { ret -1; }
    val cb: query.QueryOutput = c.ok;
    val db: query.QueryOutput = d.ok;
    fin {
        if (cb.bytes != nil) { A.deallocate[u8](a, cb.bytes, cb.len::usize); }
        if (db.bytes != nil) { A.deallocate[u8](a, db.bytes, db.len::usize); }
    }
    if (cb.len <= db.len) { ret 0; }
    var i: u32 = 0;
    for (i < db.len) {
        if (cb.bytes[i] != db.bytes[i]) { ret 0; }
        i = i + 1;
    }
    ret 1;
}

test capture_build_identity__excludes_the_planner_environment {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val tx: res[lang_target.Binding, fail.Fail] = lang_target.t_select("x86_64", "linux", "sysv64");
    if (sel tx.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var te: project.TargetEntry;
    te.os_name       = intern.STR_NIL;
    te.isa_name      = intern.STR_NIL;
    te.abi_name      = intern.STR_NIL;
    te.platform_name = intern.STR_NIL;
    var cfg: project.ProjectConfig;
    cfg.id       = intern.STR_NIL;
    cfg.version  = intern.STR_NIL;
    cfg.bin_name = intern.STR_NIL;
    var alone: project.Project;
    alone.s            = ?s;
    alone.req          = request.defaults();
    alone.target       = tx.ok;
    alone.target_entry = ?te;
    alone.config       = cfg;
    var dep: project.DepEntry;
    dep.project_id       = intern.STR_NIL;
    dep.manifest.version = intern.STR_NIL;
    var hosted: project.Project = alone;
    hosted.config.dep_count = 1;
    hosted.config.deps      = ?dep;
    # a dependency makes the configuration sample the inherited environment; the identity never does
    if (t_capture_equal(?alloc, ?alone, ?hosted, false) != 0) { ret 2; }
    if (t_config_extends_identity(?alloc, ?hosted) != 1)      { ret 3; }
    var released: project.Project = hosted;
    released.req.profile = "release";
    if (t_capture_equal(?alloc, ?hosted, ?released, true) != 0) { ret 4; }
    ret 0;
}

#[testing]
fun t_planner_environment_digest(a: *A.Allocator, inherited: **u8, digest: *u8) bool {
    var fb:      wire.Sink      = wire.digest();
    val written: err[fail.Fail] = write_planner_environment(?fb, a, inherited);
    if (sel written.err || fb.failed) { ret false; }
    wire.digest_final(?fb, digest::*[32]u8);
    ret true;
}

test planner_environment_cache_input_tracks_values_and_ignores_entry_order {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    var entries: [4]usize;
    entries[0] = ("MACH_3146_B=two")::usize;
    entries[1] = ("MACH_3146_A=one")::usize;
    entries[2] = ("MACH_3146_A=ignored duplicate")::usize;
    entries[3] = 0;
    var initial: [32]u8;
    if (!t_planner_environment_digest(?a, (?entries[0])::**u8, ?initial[0])) { ret 2; }
    entries[0] = ("MACH_3146_A=one")::usize;
    entries[1] = ("MACH_3146_B=two")::usize;
    entries[2] = 0;
    var reordered: [32]u8;
    if (!t_planner_environment_digest(?a, (?entries[0])::**u8, ?reordered[0])) { ret 3; }
    if (ut_digest_differs(?initial[0], ?reordered[0]))                         { ret 4; }
    entries[1] = ("MACH_3146_B=changed inherited value")::usize;
    var changed: [32]u8;
    if (!t_planner_environment_digest(?a, (?entries[0])::**u8, ?changed[0])) { ret 5; }
    if (!ut_digest_differs(?initial[0], ?changed[0]))                        { ret 6; }
    ret 0;
}

fun lower_output_equal(a: *u8, a_len: u32, b: *u8, b_len: u32) bool {
    val left:  *me_ir.Module = ir_handle_decode(query.QueryView{value: a, value_len: a_len});
    val right: *me_ir.Module = ir_handle_decode(query.QueryView{value: b, value_len: b_len});
    if (left == nil || right == nil) { ret false; }
    ret equal.content_equal(left, right);
}
