pub fun run_resolve_pass(p: *project.Project) R.Result[R.Void, fail.Fail] {
    if (!query.is_registered(?p.s.queries, query.Q_RESOLVE)) {
        val rr: R.Result[R.Void, str] = query.register_derived_owned(?p.s.queries, query.Q_RESOLVE, q_resolve_finalize);
        if (R.is_err[R.Void, str](rr)) { ret fail.lift[R.Void](rr); }
    }
    if (!query.is_registered(?p.s.queries, query.Q_EXPORTS)) {
        val re: R.Result[R.Void, str] = query.register_derived(?p.s.queries, query.Q_EXPORTS);
        if (R.is_err[R.Void, str](re)) { ret fail.lift[R.Void](re); }
    }

    var tflag: u8 = 0;
    if (p.gate_terminal) { tflag = 1; }
    val tf: R.Result[R.Void, str] = query.set_input(?p.s.queries, query.Q_GATE_TERMINAL, 0, ?tflag, 1);
    if (R.is_err[R.Void, str](tf)) { ret fail.lift[R.Void](tf); }

    readout.phase_begin(p.events, readout.PH_RESOLVE);
    var i: u32 = 0;
    for (i < p.topo_len) {
        val mid: session.ModuleId = p.topo[i];
        val r: R.Result[R.Void, fail.Fail] = run_resolve_one(p, mid);
        if (R.is_err[R.Void, fail.Fail](r)) {
            ret r;
        }
        i = i + 1;
    }
    readout.phase_end(p.events, readout.PH_RESOLVE, p.topo_len, "module", "modules");
    ret R.ok_void[fail.Fail]();
}

fun run_resolve_one(p: *project.Project, mid: session.ModuleId) R.Result[R.Void, fail.Fail] {
    val m: *project.ModuleEntry = ?p.modules[mid::u32];

    val t_item: ctime.Time = readout.item_begin(p.events);

    val e_r: R.Result[*query.QueryEntry, fail.Fail] = query.get[project.Project](?p.queries, p, query.Q_RESOLVE, m.stable_id::u64);
    if (R.is_err[*query.QueryEntry, fail.Fail](e_r)) { ret R.err[R.Void, fail.Fail](R.unwrap_err[*query.QueryEntry, fail.Fail](e_r)); }
    val rr: *resolve.ResolveResult = dq.resolve_handle_decode(R.unwrap_ok[*query.QueryEntry, fail.Fail](e_r));
    if (rr == nil) { ret R.err[R.Void, fail.Fail](fail.message("Q_RESOLVE produced no result handle")); }

    val ex_r: R.Result[*query.QueryEntry, fail.Fail] = query.get[project.Project](?p.queries, p, query.Q_EXPORTS, m.stable_id::u64);
    if (R.is_err[*query.QueryEntry, fail.Fail](ex_r)) { ret R.err[R.Void, fail.Fail](R.unwrap_err[*query.QueryEntry, fail.Fail](ex_r)); }

    resolve.remap_result(rr, p.s);

    m.resolve_result = rr;
    m.resolved       = true;
    readout.item(p.events, readout.PH_RESOLVE, project.fqn_name(p, m.fqn), t_item);
    ret R.ok_void[fail.Fail]();
}

pub fun q_resolve_compute(p: *project.Project, key: u64, alloc: *A.Allocator) R.Result[query.QueryOutput, fail.Fail] {
    val db: *query.QueryDb = ?p.s.queries;
    val s: *session.Session = p.s;

    val stable: session.StableModuleId = key::u32::session.StableModuleId;
    val mid: session.ModuleId = session.module_id_for_stable(s, stable);
    if (mid == session.MODULE_NIL) { ret R.err[query.QueryOutput, fail.Fail](fail.message("Q_RESOLVE: stable id not loaded this build")); }
    val m: *project.ModuleEntry = ?p.modules[mid::u32];
    val a: *ast.Ast = m.a;
    if (a == nil) { ret R.err[query.QueryOutput, fail.Fail](fail.message("Q_RESOLVE: module has no parsed AST")); }

    val rp: R.Result[R.Void, str] = query.record_dep(db, query.Q_RESOLVE, key, query.Q_PARSE, a.file_id::u64);
    if (R.is_err[R.Void, str](rp)) { ret R.err[query.QueryOutput, fail.Fail](fail.message(R.unwrap_err[R.Void, str](rp))); }
    val rt: R.Result[R.Void, str] = query.record_dep(db, query.Q_RESOLVE, key, query.Q_TARGET, 0);
    if (R.is_err[R.Void, str](rt)) { ret R.err[query.QueryOutput, fail.Fail](fail.message(R.unwrap_err[R.Void, str](rt))); }
    val rgt: R.Result[R.Void, str] = query.record_dep(db, query.Q_RESOLVE, key, query.Q_GATE_TERMINAL, 0);
    if (R.is_err[R.Void, str](rgt)) { ret R.err[query.QueryOutput, fail.Fail](fail.message(R.unwrap_err[R.Void, str](rgt))); }

    val deps_r: R.Result[resolve.ResolveDeps, str] = build_resolve_deps_owned(p, m);
    if (R.is_err[resolve.ResolveDeps, str](deps_r)) { ret R.err[query.QueryOutput, fail.Fail](fail.message(R.unwrap_err[resolve.ResolveDeps, str](deps_r))); }
    var deps: resolve.ResolveDeps = R.unwrap_ok[resolve.ResolveDeps, str](deps_r);

    var di: u32 = 0;
    for (di < deps.count) {
        val dep_mid: session.ModuleId = deps.entries[di].module;
        if (dep_mid::u32 < p.module_len) {
            val dep_stable: session.StableModuleId = p.modules[dep_mid::u32].stable_id;
            val ge: R.Result[*query.QueryEntry, fail.Fail] = query.get[project.Project](?p.queries, p, query.Q_EXPORTS, dep_stable::u64);
            if (R.is_err[*query.QueryEntry, fail.Fail](ge)) {
                free_resolve_deps(s.alloc, ?deps);
                ret R.err[query.QueryOutput, fail.Fail](R.unwrap_err[*query.QueryEntry, fail.Fail](ge));
            }
        }
        di = di + 1;
    }

    val rr_r: R.Result[resolve.ResolveResult, fail.Fail] = resolve.resolve(s, a, ?deps, ?m.ctx, mid, p.gate_terminal);
    free_resolve_deps(s.alloc, ?deps);
    if (R.is_err[resolve.ResolveResult, fail.Fail](rr_r)) { ret R.err[query.QueryOutput, fail.Fail](R.unwrap_err[resolve.ResolveResult, fail.Fail](rr_r)); }
    var result: resolve.ResolveResult = R.unwrap_ok[resolve.ResolveResult, fail.Fail](rr_r);

    val br: R.Result[*resolve.ResolveResult, str] = A.allocate[resolve.ResolveResult](alloc, 1::usize);
    if (R.is_err[*resolve.ResolveResult, str](br)) {
        resolve.dnit_result(?result);
        ret R.err[query.QueryOutput, fail.Fail](fail.message(R.unwrap_err[*resolve.ResolveResult, str](br)));
    }
    val box: *resolve.ResolveResult = R.unwrap_ok[*resolve.ResolveResult, str](br);
    box[0] = result;
    ret fail.lift[query.QueryOutput](dq.resolve_handle_encode(alloc, box));
}

pub fun q_resolve_finalize(value: *u8, value_len: u32, alloc: *A.Allocator) {
    if (value == nil || value_len::usize < $size_of(ptr)) { ret; }
    val slot: *ptr = value::ptr::*ptr;
    val r: *resolve.ResolveResult = slot[0]::*resolve.ResolveResult;
    if (r == nil) { ret; }
    resolve.dnit_result(r);
    A.deallocate[resolve.ResolveResult](alloc, r, 1::usize);
}

fun build_resolve_deps_owned(p: *project.Project, m: *project.ModuleEntry) R.Result[resolve.ResolveDeps, str] {
    var deps: resolve.ResolveDeps;
    deps.entries = nil;
    deps.count   = 0;
    if (m.dep_count == 0) { ret R.ok[resolve.ResolveDeps, str](deps); }

    val lr: R.Result[*session.ModuleId, str] = A.allocate[session.ModuleId](p.s.alloc, p.module_len::usize);
    if (R.is_err[*session.ModuleId, str](lr)) {
        ret R.err[resolve.ResolveDeps, str](R.unwrap_err[*session.ModuleId, str](lr));
    }
    val list: *session.ModuleId = R.unwrap_ok[*session.ModuleId, str](lr);

    val r: R.Result[resolve.ResolveDeps, str] = build_resolve_deps(p, m, list);
    A.deallocate[session.ModuleId](p.s.alloc, list, p.module_len::usize);
    ret r;
}

fun resolve_list_contains(list: *session.ModuleId, list_len: u32, id: session.ModuleId) bool {
    var i: u32 = 0;
    for (i < list_len) {
        if (list[i] == id) { ret true; }
        i = i + 1;
    }
    ret false;
}

pub fun run_sema_pass(p: *project.Project) R.Result[R.Void, outcome.Fail] {
    if (!query.is_registered(?p.s.queries, query.Q_SEMA)) {
        val rsm: R.Result[R.Void, str] = query.register_derived_owned(?p.s.queries, query.Q_SEMA, q_sema_finalize);
        if (R.is_err[R.Void, str](rsm)) { ret R.err[R.Void, outcome.Fail](outcome.internal(R.unwrap_err[R.Void, str](rsm))); }
    }
    if (!query.is_registered(?p.s.queries, query.Q_TYPED_EXPORTS)) {
        val rte: R.Result[R.Void, str] = query.register_derived(?p.s.queries, query.Q_TYPED_EXPORTS);
        if (R.is_err[R.Void, str](rte)) { ret R.err[R.Void, outcome.Fail](outcome.internal(R.unwrap_err[R.Void, str](rte))); }
    }

    type.field_epoch_bump(?p.s.types);

    readout.phase_begin(p.events, readout.PH_SEMA);
    var i: u32 = 0;
    for (i < p.topo_len) {
        val mid: session.ModuleId = p.topo[i];

        val r: R.Result[R.Void, fail.Fail] = run_sema_one(p, mid);
        if (R.is_err[R.Void, fail.Fail](r)) {
            ret R.err[R.Void, outcome.Fail](outcome.from_fail(R.unwrap_err[R.Void, fail.Fail](r)));
        }
        i = i + 1;
    }
    readout.phase_end(p.events, readout.PH_SEMA, p.topo_len, "module", "modules");
    ret R.ok_void[outcome.Fail]();
}

fun run_sema_one(p: *project.Project, mid: session.ModuleId) R.Result[R.Void, fail.Fail] {
    val m: *project.ModuleEntry = ?p.modules[mid::u32];

    val t_item: ctime.Time = readout.item_begin(p.events);

    val e_r: R.Result[*query.QueryEntry, fail.Fail] = query.get[project.Project](?p.queries, p, query.Q_SEMA, m.stable_id::u64);
    if (R.is_err[*query.QueryEntry, fail.Fail](e_r)) { ret R.err[R.Void, fail.Fail](R.unwrap_err[*query.QueryEntry, fail.Fail](e_r)); }
    val sr: *sema.SemaResult = sema_handle_decode(R.unwrap_ok[*query.QueryEntry, fail.Fail](e_r));
    if (sr == nil) { ret R.err[R.Void, fail.Fail](fail.message("Q_SEMA produced no result handle")); }

    val tx_r: R.Result[*query.QueryEntry, fail.Fail] = query.get[project.Project](?p.queries, p, query.Q_TYPED_EXPORTS, m.stable_id::u64);
    if (R.is_err[*query.QueryEntry, fail.Fail](tx_r)) { ret R.err[R.Void, fail.Fail](R.unwrap_err[*query.QueryEntry, fail.Fail](tx_r)); }

    val rp: R.Result[R.Void, str] = session.register_module_phase(p.s, mid, sr::ptr,
        m.resolve_result::ptr, (?m.ctx)::ptr);
    if (R.is_err[R.Void, str](rp)) { ret fail.lift[R.Void](rp); }

    m.sema_result = sr;
    readout.item(p.events, readout.PH_SEMA, project.fqn_name(p, m.fqn), t_item);
    ret R.ok_void[fail.Fail]();
}

pub fun q_sema_compute(p: *project.Project, key: u64, alloc: *A.Allocator) R.Result[query.QueryOutput, fail.Fail] {
    val db: *query.QueryDb = ?p.s.queries;
    val s: *session.Session = p.s;

    val stable: session.StableModuleId = key::u32::session.StableModuleId;
    val mid: session.ModuleId = session.module_id_for_stable(s, stable);
    if (mid == session.MODULE_NIL) { ret R.err[query.QueryOutput, fail.Fail](fail.message("Q_SEMA: stable id not loaded this build")); }
    val m: *project.ModuleEntry = ?p.modules[mid::u32];
    val a: *ast.Ast = m.a;
    if (a == nil) { ret R.err[query.QueryOutput, fail.Fail](fail.message("Q_SEMA: module has no parsed AST")); }
    val rr: *resolve.ResolveResult = m.resolve_result;
    if (rr == nil) { ret R.err[query.QueryOutput, fail.Fail](fail.message("Q_SEMA: module has no resolve result")); }

    val rrd: R.Result[R.Void, str] = query.record_dep(db, query.Q_SEMA, key, query.Q_RESOLVE, key);
    if (R.is_err[R.Void, str](rrd)) { ret R.err[query.QueryOutput, fail.Fail](fail.message(R.unwrap_err[R.Void, str](rrd))); }
    val rt: R.Result[R.Void, str] = query.record_dep(db, query.Q_SEMA, key, query.Q_TARGET, 0);
    if (R.is_err[R.Void, str](rt)) { ret R.err[query.QueryOutput, fail.Fail](fail.message(R.unwrap_err[R.Void, str](rt))); }
    val rn: R.Result[R.Void, str] = query.record_dep(db, query.Q_SEMA, key, query.Q_MODULE_NUMBER, key);
    if (R.is_err[R.Void, str](rn)) { ret R.err[query.QueryOutput, fail.Fail](fail.message(R.unwrap_err[R.Void, str](rn))); }

    val deps_r: R.Result[resolve.ResolveDeps, str] = build_resolve_deps_owned(p, m);
    if (R.is_err[resolve.ResolveDeps, str](deps_r)) { ret R.err[query.QueryOutput, fail.Fail](fail.message(R.unwrap_err[resolve.ResolveDeps, str](deps_r))); }
    var deps: resolve.ResolveDeps = R.unwrap_ok[resolve.ResolveDeps, str](deps_r);
    var di: u32 = 0;
    for (di < deps.count) {
        val dep_mid: session.ModuleId = deps.entries[di].module;
        if (dep_mid::u32 < p.module_len) {
            val dep_stable: session.StableModuleId = p.modules[dep_mid::u32].stable_id;
            val ge: R.Result[*query.QueryEntry, fail.Fail] = query.get[project.Project](?p.queries, p, query.Q_TYPED_EXPORTS, dep_stable::u64);
            if (R.is_err[*query.QueryEntry, fail.Fail](ge)) {
                free_resolve_deps(s.alloc, ?deps);
                ret R.err[query.QueryOutput, fail.Fail](R.unwrap_err[*query.QueryEntry, fail.Fail](ge));
            }
        }
        di = di + 1;
    }
    free_resolve_deps(s.alloc, ?deps);

    val sdeps_r: R.Result[sema.SemaDeps, str] = build_sema_deps_query(p);
    if (R.is_err[sema.SemaDeps, str](sdeps_r)) { ret R.err[query.QueryOutput, fail.Fail](fail.message(R.unwrap_err[sema.SemaDeps, str](sdeps_r))); }
    var sdeps: sema.SemaDeps = R.unwrap_ok[sema.SemaDeps, str](sdeps_r);

    val sem_r: R.Result[sema.SemaResult, fail.Fail] = sema.sema(s, a, rr, ?sdeps, ?m.ctx, mid);
    free_sema_deps_query(s.alloc, ?sdeps);
    if (R.is_err[sema.SemaResult, fail.Fail](sem_r)) { ret R.err[query.QueryOutput, fail.Fail](R.unwrap_err[sema.SemaResult, fail.Fail](sem_r)); }
    var result: sema.SemaResult = R.unwrap_ok[sema.SemaResult, fail.Fail](sem_r);

    var ei: u32 = 0;
    for (ei < result.embed_path_count) {
        val re: R.Result[R.Void, str] = query.record_dep(db, query.Q_SEMA, key,
                                                       query.Q_EMBED_FILE, result.embed_paths[ei]::u64);
        if (R.is_err[R.Void, str](re)) {
            sema.dnit_result(?result);
            ret R.err[query.QueryOutput, fail.Fail](fail.message(R.unwrap_err[R.Void, str](re)));
        }
        ei = ei + 1;
    }

    val br: R.Result[*sema.SemaResult, str] = A.allocate[sema.SemaResult](alloc, 1::usize);
    if (R.is_err[*sema.SemaResult, str](br)) {
        sema.dnit_result(?result);
        ret R.err[query.QueryOutput, fail.Fail](fail.message(R.unwrap_err[*sema.SemaResult, str](br)));
    }
    val box: *sema.SemaResult = R.unwrap_ok[*sema.SemaResult, str](br);
    box[0] = result;
    ret sema_handle_encode(alloc, box);
}

pub fun q_sema_finalize(value: *u8, value_len: u32, alloc: *A.Allocator) {
    if (value == nil || value_len::usize < $size_of(ptr)) { ret; }
    val slot: *ptr = value::ptr::*ptr;
    val r: *sema.SemaResult = slot[0]::*sema.SemaResult;
    if (r == nil) { ret; }
    sema.dnit_result(r);
    A.deallocate[sema.SemaResult](alloc, r, 1::usize);
}

fun sema_handle_encode(alloc: *A.Allocator, r: *sema.SemaResult) R.Result[query.QueryOutput, fail.Fail] {
    val n: u32 = $size_of(ptr)::u32;
    val rb: R.Result[*u8, str] = A.allocate[u8](alloc, n::usize);
    if (R.is_err[*u8, str](rb)) {
        sema.dnit_result(r);
        A.deallocate[sema.SemaResult](alloc, r, 1::usize);
        ret R.err[query.QueryOutput, fail.Fail](fail.message(R.unwrap_err[*u8, str](rb)));
    }
    val buf: *u8 = R.unwrap_ok[*u8, str](rb);
    val slot: *ptr = buf::ptr::*ptr;
    slot[0] = r::ptr;
    var out: query.QueryOutput;
    out.bytes = buf;
    out.len   = n;
    ret R.ok[query.QueryOutput, fail.Fail](out);
}

fun sema_handle_decode(e: *query.QueryEntry) *sema.SemaResult {
    if (e.value == nil || e.value_len::usize < $size_of(ptr)) { ret nil; }
    val slot: *ptr = e.value::ptr::*ptr;
    ret slot[0]::*sema.SemaResult;
}

fun build_sema_deps_query(p: *project.Project) R.Result[sema.SemaDeps, str] {
    var deps: sema.SemaDeps;
    deps.entries = nil;
    deps.count   = 0;

    var ready_count: u32 = 0;
    var j: u32 = 0;
    for (j < p.module_len) {
        if (p.modules[j].sema_result != nil) { ready_count = ready_count + 1; }
        j = j + 1;
    }
    if (ready_count == 0) { ret R.ok[sema.SemaDeps, str](deps); }

    val r: R.Result[*sema.ModuleSema, str] = A.allocate[sema.ModuleSema](p.s.alloc, ready_count::usize);
    if (R.is_err[*sema.ModuleSema, str](r)) { ret R.err[sema.SemaDeps, str](R.unwrap_err[*sema.ModuleSema, str](r)); }
    val arr: *sema.ModuleSema = R.unwrap_ok[*sema.ModuleSema, str](r);

    var i: u32 = 0;
    var k: u32 = 0;
    for (i < p.module_len) {
        val sr: *sema.SemaResult = p.modules[i].sema_result;
        if (sr != nil) {
            var ms: sema.ModuleSema;
            ms.path       = p.modules[i].fqn;
            ms.module     = i::session.ModuleId;
            ms.decl_type  = sr.decl_type;
            ms.decl_count = sr.decl_count;
            ms.ctx        = ?p.modules[i].ctx;
            arr[k] = ms;
            k = k + 1;
        }
        i = i + 1;
    }

    deps.entries = arr;
    deps.count   = ready_count;
    ret R.ok[sema.SemaDeps, str](deps);
}

fun free_sema_deps_query(alloc: *A.Allocator, deps: *sema.SemaDeps) {
    if (deps.entries == nil) { ret; }
    A.deallocate[sema.ModuleSema](alloc, deps.entries, deps.count::usize);
    deps.entries = nil;
    deps.count   = 0;
}

pub fun decided_gate_count(p: *project.Project) u32 {
    var total: u32 = 0;
    var i: u32 = 0;
    for (i < p.module_len) {
        val m: *project.ModuleEntry = ?p.modules[i];
        if (m.ctx.gate_states != nil) {
            var gi: u32 = 0;
            for (gi < m.ctx.gate_count) {
                if (m.ctx.gate_states[gi] != comptime.GATE_STATE_UNKNOWN) { total = total + 1; }
                gi = gi + 1;
            }
        }
        i = i + 1;
    }
    ret total;
}

pub fun run_gate_pass(p: *project.Project) R.Result[bool, str] {
    clear_gate_results(p);
    var changed: bool = false;
    var i: u32 = 0;
    for (i < p.topo_len) {
        val mid: session.ModuleId = p.topo[i];
        val m: *project.ModuleEntry = ?p.modules[mid::u32];
        val deps_r: R.Result[sema.SemaDeps, str] = build_gate_deps(p, m);
        if (R.is_err[sema.SemaDeps, str](deps_r)) {
            ret R.err[bool, str](R.unwrap_err[sema.SemaDeps, str](deps_r));
        }
        var deps: sema.SemaDeps = R.unwrap_ok[sema.SemaDeps, str](deps_r);
        var before: u32 = 0;
        var gi: u32 = 0;
        for (gi < m.ctx.gate_count) {
            if (m.ctx.gate_states[gi] != comptime.GATE_STATE_UNKNOWN) { before = before + 1; }
            gi = gi + 1;
        }
        val gr: R.Result[sema.SemaResult, fail.Fail] = sema.resolve_gates(p.s, m.a, m.resolve_result, ?deps, ?m.ctx, mid);
        free_sema_deps_query(p.s.alloc, ?deps);
        if (R.is_err[sema.SemaResult, fail.Fail](gr)) {
            ret R.err[bool, str](R.unwrap_err[sema.SemaResult, fail.Fail](gr).message);
        }
        val ar: R.Result[*sema.SemaResult, str] = A.allocate[sema.SemaResult](p.alloc, 1::usize);
        if (R.is_err[*sema.SemaResult, str](ar)) {
            var result: sema.SemaResult = R.unwrap_ok[sema.SemaResult, fail.Fail](gr);
            sema.dnit_result(?result);
            ret R.err[bool, str](R.unwrap_err[*sema.SemaResult, str](ar));
        }
        m.gate_result = R.unwrap_ok[*sema.SemaResult, str](ar);
        m.gate_result[0] = R.unwrap_ok[sema.SemaResult, fail.Fail](gr);
        var after: u32 = 0;
        gi = 0;
        for (gi < m.ctx.gate_count) {
            if (m.ctx.gate_states[gi] != comptime.GATE_STATE_UNKNOWN) { after = after + 1; }
            gi = gi + 1;
        }
        if (after != before) { changed = true; }
        i = i + 1;
    }
    if (p.union && p.union_tuple_count > 0) {
        val union_changed_r: R.Result[bool, str] = run_union_gate_pass(p);
        if (R.is_err[bool, str](union_changed_r)) { ret union_changed_r; }
        if (R.unwrap_ok[bool, str](union_changed_r)) { changed = true; }
    }
    ret R.ok[bool, str](changed);
}

fun prepare_tuple_gate_storage(p: *project.Project, m: *project.ModuleEntry) R.Result[R.Void, str] {
    if (m.tuple_gates != nil) {
        if (m.tuple_gate_count != p.union_tuple_count) {
            ret R.err[R.Void, str]("union target tuple count changed after module load");
        }
        ret R.ok_void[str]();
    }
    if (p.union_tuple_count == 0) { ret R.ok_void[str](); }
    val ar: R.Result[*project.TupleGateResult, str] = A.allocate[project.TupleGateResult](p.alloc, p.union_tuple_count::usize);
    if (R.is_err[*project.TupleGateResult, str](ar)) { ret R.err[R.Void, str](R.unwrap_err[*project.TupleGateResult, str](ar)); }
    m.tuple_gates = R.unwrap_ok[*project.TupleGateResult, str](ar);
    m.tuple_gate_count = p.union_tuple_count;
    var ti: u32 = 0;
    for (ti < p.union_tuple_count) {
        val tg: *project.TupleGateResult = ?m.tuple_gates[ti];
        tg.states = nil;
        tg.state_count = 0;
        tg.entries = nil;
        tg.entries_len = 0;
        tg.entries_cap = 0;
        tg.deferred = nil;
        tg.deferred_len = 0;
        tg.deferred_cap = 0;
        tg.resolve_result = nil;
        tg.sema_result = nil;
        tg.merged_const_count = 0;
        ti = ti + 1;
    }
    ti = 0;
    for (ti < p.union_tuple_count) {
        val tg: *project.TupleGateResult = ?m.tuple_gates[ti];
        tg.state_count = m.ctx.gate_count;
        if (tg.state_count > 0) {
            val sr: R.Result[*comptime.GateState, str] = A.allocate[comptime.GateState](p.alloc, tg.state_count::usize);
            if (R.is_err[*comptime.GateState, str](sr)) { ret R.err[R.Void, str](R.unwrap_err[*comptime.GateState, str](sr)); }
            tg.states = R.unwrap_ok[*comptime.GateState, str](sr);
            var gi: u32 = 0;
            for (gi < tg.state_count) {
                tg.states[gi] = comptime.GATE_STATE_UNKNOWN;
                gi = gi + 1;
            }
        }
        ti = ti + 1;
    }
    ret R.ok_void[str]();
}

fun apply_tuple_target(c: *comptime.ComptimeCtx, t: *project.TargetTuple) {
    c.env.target_os_id   = t.os_id;
    c.env.target_arch_id = t.arch_id;
    c.env.target_abi_id  = t.abi_id;
    c.env.pointer_width  = t.pointer_width;
    c.env.vector_bits    = t.vector_bits;
    c.env.has_float      = t.has_float;
    c.env.target_defs    = t.target_defs;
    c.env.va_list_size   = t.va_list_size;
    c.env.va_list_align  = t.va_list_align;
    c.env.target_os      = t.os_name;
    c.env.target_isa     = t.isa_name;
    c.env.target_abi     = t.abi_name;
    c.env.target_platform = t.platform_name;
}

fun restore_build_target(p: *project.Project, c: *comptime.ComptimeCtx) {
    c.env.target_os_id   = p.target.os_id;
    c.env.target_arch_id = p.target.arch_id;
    c.env.target_abi_id  = p.target.abi_id;
    c.env.pointer_width  = p.target.isa.pointer_width;
    c.env.vector_bits    = p.target.model.vector_bits;
    c.env.has_float      = p.target.model.has_float;
    c.env.target_defs    = p.target.isa.defs;
    c.env.va_list_size   = p.target.va_list_size;
    c.env.va_list_align  = p.target.va_list_align;
    c.env.target_os      = p.target_entry.os_name;
    c.env.target_isa     = p.target_entry.isa_name;
    c.env.target_abi     = p.target_entry.abi_name;
    c.env.target_platform = p.target_entry.platform_name;
}

fun enter_union_tuple(p: *project.Project, ti: u32) R.Result[R.Void, str] {
    var i: u32 = 0;
    for (i < p.module_len) {
        val pr: R.Result[R.Void, str] = prepare_tuple_gate_storage(p, ?p.modules[i]);
        if (R.is_err[R.Void, str](pr)) { ret pr; }
        i = i + 1;
    }
    i = 0;
    for (i < p.module_len) {
        val m: *project.ModuleEntry = ?p.modules[i];
        val tg: *project.TupleGateResult = ?m.tuple_gates[ti];
        val build_states: *comptime.GateState = m.ctx.gate_states;
        m.ctx.gate_states = tg.states;
        tg.states = build_states;
        val build_entries: *comptime.NamedConst = m.ctx.entries;
        val build_entries_len: u32 = m.ctx.entries_len;
        val build_entries_cap: u32 = m.ctx.entries_cap;
        m.ctx.entries = tg.entries;
        m.ctx.entries_len = tg.entries_len;
        m.ctx.entries_cap = tg.entries_cap;
        tg.entries = build_entries;
        tg.entries_len = build_entries_len;
        tg.entries_cap = build_entries_cap;
        val build_deferred: *intern.StrId = m.ctx.deferred;
        val build_deferred_len: u32 = m.ctx.deferred_len;
        val build_deferred_cap: u32 = m.ctx.deferred_cap;
        m.ctx.deferred = tg.deferred;
        m.ctx.deferred_len = tg.deferred_len;
        m.ctx.deferred_cap = tg.deferred_cap;
        tg.deferred = build_deferred;
        tg.deferred_len = build_deferred_len;
        tg.deferred_cap = build_deferred_cap;
        val build_resolve: *resolve.ResolveResult = m.resolve_result;
        m.resolve_result = tg.resolve_result;
        tg.resolve_result = build_resolve;
        val build_sema: *sema.SemaResult = m.gate_result;
        m.gate_result = tg.sema_result;
        tg.sema_result = build_sema;
        apply_tuple_target(?m.ctx, ?p.union_tuples[ti]);
        i = i + 1;
    }
    p.gate_tuple_index = ti;
    ret R.ok_void[str]();
}

fun leave_union_tuple(p: *project.Project, ti: u32) {
    var i: u32 = 0;
    for (i < p.module_len) {
        val m: *project.ModuleEntry = ?p.modules[i];
        val tg: *project.TupleGateResult = ?m.tuple_gates[ti];
        val tuple_states: *comptime.GateState = m.ctx.gate_states;
        m.ctx.gate_states = tg.states;
        tg.states = tuple_states;
        val tuple_entries: *comptime.NamedConst = m.ctx.entries;
        val tuple_entries_len: u32 = m.ctx.entries_len;
        val tuple_entries_cap: u32 = m.ctx.entries_cap;
        m.ctx.entries = tg.entries;
        m.ctx.entries_len = tg.entries_len;
        m.ctx.entries_cap = tg.entries_cap;
        tg.entries = tuple_entries;
        tg.entries_len = tuple_entries_len;
        tg.entries_cap = tuple_entries_cap;
        val tuple_deferred: *intern.StrId = m.ctx.deferred;
        val tuple_deferred_len: u32 = m.ctx.deferred_len;
        val tuple_deferred_cap: u32 = m.ctx.deferred_cap;
        m.ctx.deferred = tg.deferred;
        m.ctx.deferred_len = tg.deferred_len;
        m.ctx.deferred_cap = tg.deferred_cap;
        tg.deferred = tuple_deferred;
        tg.deferred_len = tuple_deferred_len;
        tg.deferred_cap = tuple_deferred_cap;
        val tuple_resolve: *resolve.ResolveResult = m.resolve_result;
        m.resolve_result = tg.resolve_result;
        tg.resolve_result = tuple_resolve;
        val tuple_sema: *sema.SemaResult = m.gate_result;
        m.gate_result = tg.sema_result;
        tg.sema_result = tuple_sema;
        restore_build_target(p, ?m.ctx);
        i = i + 1;
    }
    p.gate_tuple_index = 0xFFFFFFFF;
}

fun box_resolve_result(p: *project.Project, r: resolve.ResolveResult) R.Result[*resolve.ResolveResult, str] {
    val ar: R.Result[*resolve.ResolveResult, str] = A.allocate[resolve.ResolveResult](p.alloc, 1::usize);
    if (R.is_err[*resolve.ResolveResult, str](ar)) { ret R.err[*resolve.ResolveResult, str](R.unwrap_err[*resolve.ResolveResult, str](ar)); }
    val out: *resolve.ResolveResult = R.unwrap_ok[*resolve.ResolveResult, str](ar);
    out[0] = r;
    ret R.ok[*resolve.ResolveResult, str](out);
}

fun box_sema_result(p: *project.Project, r: sema.SemaResult) R.Result[*sema.SemaResult, str] {
    val ar: R.Result[*sema.SemaResult, str] = A.allocate[sema.SemaResult](p.alloc, 1::usize);
    if (R.is_err[*sema.SemaResult, str](ar)) { ret R.err[*sema.SemaResult, str](R.unwrap_err[*sema.SemaResult, str](ar)); }
    val out: *sema.SemaResult = R.unwrap_ok[*sema.SemaResult, str](ar);
    out[0] = r;
    ret R.ok[*sema.SemaResult, str](out);
}

fun run_one_union_tuple(p: *project.Project, ti: u32) R.Result[bool, str] {
    val er: R.Result[R.Void, str] = enter_union_tuple(p, ti);
    if (R.is_err[R.Void, str](er)) { ret R.err[bool, str](R.unwrap_err[R.Void, str](er)); }
    var changed: bool = false;
    var i: u32 = 0;
    for (i < p.topo_len) {
        val mid: session.ModuleId = p.topo[i];
        val m: *project.ModuleEntry = ?p.modules[mid::u32];
        if (m.tuple_reachable == nil || ti >= m.tuple_reach_count || !m.tuple_reachable[ti]) {
            i = i + 1;
            cnt;
        }
        m.ctx.entries_len = 0;
        m.ctx.deferred_len = 0;
        val remerged_r: R.Result[bool, str] = load.remerge_tuple_pub_consts(p, mid, ti);
        if (R.is_err[bool, str](remerged_r)) {
            leave_union_tuple(p, ti);
            ret remerged_r;
        }
        if (R.unwrap_ok[bool, str](remerged_r)) { changed = true; }
        var unresolved_before: u32 = 0;
        var ug: u32 = 0;
        for (ug < m.ctx.gate_count) {
            if (m.ctx.gate_states[ug] == comptime.GATE_STATE_UNKNOWN) {
                unresolved_before = unresolved_before + 1;
            }
            ug = ug + 1;
        }
        val diag_mark: diagnostic.DiagMark = diagnostic.mark(?p.s.diags);
        val deps_r: R.Result[resolve.ResolveDeps, str] = build_resolve_deps_owned(p, m);
        if (R.is_err[resolve.ResolveDeps, str](deps_r)) {
            leave_union_tuple(p, ti);
            ret R.err[bool, str](R.unwrap_err[resolve.ResolveDeps, str](deps_r));
        }
        var deps: resolve.ResolveDeps = R.unwrap_ok[resolve.ResolveDeps, str](deps_r);
        val rr: R.Result[resolve.ResolveResult, fail.Fail] = resolve.resolve(p.s, m.a, ?deps, ?m.ctx, mid, false);
        free_resolve_deps(p.s.alloc, ?deps);
        if (R.is_err[resolve.ResolveResult, fail.Fail](rr)) {
            leave_union_tuple(p, ti);
            ret R.err[bool, str](R.unwrap_err[resolve.ResolveResult, fail.Fail](rr).message);
        }
        if (unresolved_before > 0) {
            val tr: R.Result[R.Void, str] = diagnostic.truncate(?p.s.diags, diag_mark);
            if (R.is_err[R.Void, str](tr)) {
                leave_union_tuple(p, ti);
                ret R.err[bool, str](R.unwrap_err[R.Void, str](tr));
            }
        }
        if (m.resolve_result != nil) {
            resolve.dnit_result(m.resolve_result);
            A.deallocate[resolve.ResolveResult](p.alloc, m.resolve_result, 1::usize);
            m.resolve_result = nil;
        }
        var resolved: resolve.ResolveResult = R.unwrap_ok[resolve.ResolveResult, fail.Fail](rr);
        val rb: R.Result[*resolve.ResolveResult, str] = box_resolve_result(p, resolved);
        if (R.is_err[*resolve.ResolveResult, str](rb)) {
            resolve.dnit_result(?resolved);
            leave_union_tuple(p, ti);
            ret R.err[bool, str](R.unwrap_err[*resolve.ResolveResult, str](rb));
        }
        m.resolve_result = R.unwrap_ok[*resolve.ResolveResult, str](rb);

        val sd_r: R.Result[sema.SemaDeps, str] = build_gate_deps(p, m);
        if (R.is_err[sema.SemaDeps, str](sd_r)) {
            leave_union_tuple(p, ti);
            ret R.err[bool, str](R.unwrap_err[sema.SemaDeps, str](sd_r));
        }
        var sema_deps: sema.SemaDeps = R.unwrap_ok[sema.SemaDeps, str](sd_r);
        var before: u32 = 0;
        var gi: u32 = 0;
        for (gi < m.ctx.gate_count) {
            if (m.ctx.gate_states[gi] != comptime.GATE_STATE_UNKNOWN) { before = before + 1; }
            gi = gi + 1;
        }
        val sr: R.Result[sema.SemaResult, fail.Fail] = sema.resolve_gates(p.s, m.a, m.resolve_result, ?sema_deps, ?m.ctx, mid);
        free_sema_deps_query(p.s.alloc, ?sema_deps);
        if (R.is_err[sema.SemaResult, fail.Fail](sr)) {
            leave_union_tuple(p, ti);
            ret R.err[bool, str](R.unwrap_err[sema.SemaResult, fail.Fail](sr).message);
        }
        if (m.gate_result != nil) {
            sema.dnit_result(m.gate_result);
            A.deallocate[sema.SemaResult](p.alloc, m.gate_result, 1::usize);
            m.gate_result = nil;
        }
        var sema_result: sema.SemaResult = R.unwrap_ok[sema.SemaResult, fail.Fail](sr);
        val sb: R.Result[*sema.SemaResult, str] = box_sema_result(p, sema_result);
        if (R.is_err[*sema.SemaResult, str](sb)) {
            sema.dnit_result(?sema_result);
            leave_union_tuple(p, ti);
            ret R.err[bool, str](R.unwrap_err[*sema.SemaResult, str](sb));
        }
        m.gate_result = R.unwrap_ok[*sema.SemaResult, str](sb);
        var after: u32 = 0;
        gi = 0;
        for (gi < m.ctx.gate_count) {
            if (m.ctx.gate_states[gi] != comptime.GATE_STATE_UNKNOWN) { after = after + 1; }
            gi = gi + 1;
        }
        if (after != before) { changed = true; }
        i = i + 1;
    }
    leave_union_tuple(p, ti);
    ret R.ok[bool, str](changed);
}

fun run_union_gate_pass(p: *project.Project) R.Result[bool, str] {
    var changed: bool = false;
    var ti: u32 = 0;
    for (ti < p.union_tuple_count) {
        val tuple_changed_r: R.Result[bool, str] = run_one_union_tuple(p, ti);
        if (R.is_err[bool, str](tuple_changed_r)) { ret tuple_changed_r; }
        if (R.unwrap_ok[bool, str](tuple_changed_r)) { changed = true; }
        ti = ti + 1;
    }
    ret R.ok[bool, str](changed);
}

fun build_gate_deps(p: *project.Project, m: *project.ModuleEntry) R.Result[sema.SemaDeps, str] {
    var deps: sema.SemaDeps;
    deps.entries = nil;
    deps.count = 0;
    val rr: R.Result[resolve.ResolveDeps, str] = build_resolve_deps_owned(p, m);
    if (R.is_err[resolve.ResolveDeps, str](rr)) {
        ret R.err[sema.SemaDeps, str](R.unwrap_err[resolve.ResolveDeps, str](rr));
    }
    var resolve_deps: resolve.ResolveDeps = R.unwrap_ok[resolve.ResolveDeps, str](rr);
    if (resolve_deps.count == 0) {
        free_resolve_deps(p.s.alloc, ?resolve_deps);
        ret R.ok[sema.SemaDeps, str](deps);
    }
    var dep_count: u32 = 0;
    var ri: u32 = 0;
    for (ri < resolve_deps.count) {
        val dep_mid: session.ModuleId = resolve_deps.entries[ri].module;
        val result: *sema.SemaResult = p.modules[dep_mid::u32].gate_result;
        if (result != nil) { dep_count = dep_count + 1; }
        or {
            val tuple_skip: bool = p.gate_tuple_index != 0xFFFFFFFF
                && (p.modules[dep_mid::u32].tuple_reachable == nil
                 || p.gate_tuple_index >= p.modules[dep_mid::u32].tuple_reach_count
                 || !p.modules[dep_mid::u32].tuple_reachable[p.gate_tuple_index]);
            if (!tuple_skip) {
                free_resolve_deps(p.s.alloc, ?resolve_deps);
                ret R.err[sema.SemaDeps, str]("gate dependency has no semantic header result");
            }
        }
        ri = ri + 1;
    }
    if (dep_count == 0) {
        free_resolve_deps(p.s.alloc, ?resolve_deps);
        ret R.ok[sema.SemaDeps, str](deps);
    }
    val ar: R.Result[*sema.ModuleSema, str] = A.allocate[sema.ModuleSema](p.s.alloc, dep_count::usize);
    if (R.is_err[*sema.ModuleSema, str](ar)) {
        free_resolve_deps(p.s.alloc, ?resolve_deps);
        ret R.err[sema.SemaDeps, str](R.unwrap_err[*sema.ModuleSema, str](ar));
    }
    val entries: *sema.ModuleSema = R.unwrap_ok[*sema.ModuleSema, str](ar);
    var i: u32 = 0;
    var w: u32 = 0;
    for (i < resolve_deps.count) {
        val mid: session.ModuleId = resolve_deps.entries[i].module;
        val result: *sema.SemaResult = p.modules[mid::u32].gate_result;
        if (result == nil) {
            i = i + 1;
            cnt;
        }
        entries[w].path = p.modules[mid::u32].fqn;
        entries[w].module = mid;
        entries[w].decl_type = result.decl_type;
        entries[w].decl_count = result.decl_count;
        entries[w].ctx = ?p.modules[mid::u32].ctx;
        w = w + 1;
        i = i + 1;
    }
    free_resolve_deps(p.s.alloc, ?resolve_deps);
    deps.entries = entries;
    deps.count = dep_count;
    ret R.ok[sema.SemaDeps, str](deps);
}

pub fun clear_gate_results(p: *project.Project) {
    var i: u32 = 0;
    for (i < p.module_len) {
        val result: *sema.SemaResult = p.modules[i].gate_result;
        if (result != nil) {
            p.modules[i].gate_status = result.status;
            sema.dnit_result(result);
            A.deallocate[sema.SemaResult](p.alloc, result, 1::usize);
            p.modules[i].gate_result = nil;
        }
        i = i + 1;
    }
}

pub fun invalidate_resolve_pass(p: *project.Project) R.Result[R.Void, str] {
    var i: u32 = 0;
    for (i < p.module_len) {
        val stable: session.StableModuleId = p.modules[i].stable_id;
        val re: R.Result[R.Void, str] = query.invalidate(?p.s.queries, query.Q_EXPORTS, stable::u64);
        if (R.is_err[R.Void, str](re)) { ret re; }
        val rr: R.Result[R.Void, str] = query.invalidate(?p.s.queries, query.Q_RESOLVE, stable::u64);
        if (R.is_err[R.Void, str](rr)) { ret rr; }
        p.modules[i].resolve_result = nil;
        p.modules[i].resolved = false;
        i = i + 1;
    }
    ret R.ok_void[str]();
}

pub fun q_typed_exports_compute(p: *project.Project, key: u64, alloc: *A.Allocator) R.Result[query.QueryOutput, fail.Fail] {
    val s: *session.Session = p.s;

    val stable: session.StableModuleId = key::u32::session.StableModuleId;
    val mid: session.ModuleId = session.module_id_for_stable(s, stable);
    if (mid == session.MODULE_NIL) { ret R.err[query.QueryOutput, fail.Fail](fail.message("Q_TYPED_EXPORTS: stable id not loaded this build")); }
    val m: *project.ModuleEntry = ?p.modules[mid::u32];
    val rr: *resolve.ResolveResult = m.resolve_result;
    if (rr == nil) { ret R.err[query.QueryOutput, fail.Fail](fail.message("Q_TYPED_EXPORTS: module has no resolve result")); }

    val e_r: R.Result[*query.QueryEntry, fail.Fail] = query.get[project.Project](?p.queries, p, query.Q_SEMA, key);
    if (R.is_err[*query.QueryEntry, fail.Fail](e_r)) { ret R.err[query.QueryOutput, fail.Fail](R.unwrap_err[*query.QueryEntry, fail.Fail](e_r)); }
    val sr: *sema.SemaResult = sema_handle_decode(R.unwrap_ok[*query.QueryEntry, fail.Fail](e_r));
    if (sr == nil) { ret R.err[query.QueryOutput, fail.Fail](fail.message("Q_TYPED_EXPORTS: module has no sema result")); }

    var fb: dq.FpBuf;
    fb.alloc = alloc;
    fb.buf   = nil;
    fb.len   = 0;
    fb.cap   = 0;

    val wr: R.Result[R.Void, str] = fp_typed_surface(?fb, s, mid, rr, sr);
    if (R.is_err[R.Void, str](wr)) {
        if (fb.buf != nil && fb.cap > 0) { A.deallocate[u8](alloc, fb.buf, fb.cap::usize); }
        ret R.err[query.QueryOutput, fail.Fail](fail.message(R.unwrap_err[R.Void, str](wr)));
    }

    ret fail.lift[query.QueryOutput](dq.fp_take(?fb));
}

rec LowerClosure {
    list:  *session.ModuleId;
    count: u32;
    cap:   u32;
}

val BACK_HALF_TEST_BIT: u64 = 0x100000000;

pub fun back_half_key(stable: session.StableModuleId, test_mode: bool) u64 {
    var k: u64 = stable::u64;
    if (test_mode) { k = k | BACK_HALF_TEST_BIT; }
    ret k;
}

pub fun back_half_key_is_test(key: u64) bool {
    ret (key & BACK_HALF_TEST_BIT) != 0;
}

pub fun back_half_key_for(p: *project.Project, m: *project.ModuleEntry) u64 {
    ret back_half_key(m.stable_id, test_build(p));
}

pub fun codegen_reusable(p: *project.Project, mid: session.ModuleId) bool {
    val m: *project.ModuleEntry = ?p.modules[mid::u32];
    ret query.peek_valid(?p.s.queries, query.Q_CODEGEN, back_half_key_for(p, m));
}

pub fun test_build(p: *project.Project) bool {
    ret request.test_goal(p.req.goal);
}

pub fun debug_info_of(p: *project.Project) R.Result[codegen.DebugInfo, str] {
    var d: codegen.DebugInfo = codegen.no_debug();
    if (!p.req.debug) { ret R.ok[codegen.DebugInfo, str](d); }
    if (p.target.debug == nil) {
        ret R.err[codegen.DebugInfo, str]("debug info was requested, but this target registers no debug model; build without -g or select a target with one");
    }

    val rp: R.Result[intern.StrId, str] = intern_producer(?p.s.interner, p.s.alloc, p.compiler_name, p.compiler_ver);
    if (R.is_err[intern.StrId, str](rp)) { ret R.err[codegen.DebugInfo, str](R.unwrap_err[intern.StrId, str](rp)); }
    d.emit     = true;
    d.producer = R.unwrap_ok[intern.StrId, str](rp);
    d.comp_dir = p.config.project_root;
    val prep: R.Result[R.Void, str] = codegen.prepare_debug_types(p.s);
    if (R.is_err[R.Void, str](prep)) { ret R.err[codegen.DebugInfo, str](R.unwrap_err[R.Void, str](prep)); }
    ret R.ok[codegen.DebugInfo, str](d);
}

fun intern_producer(itn: *intern.Interner, alloc: *A.Allocator, name_id: intern.StrId, ver_id: intern.StrId) R.Result[intern.StrId, str] {
    val no: O.Option[str] = intern.lookup(itn, name_id);
    val vo: O.Option[str] = intern.lookup(itn, ver_id);
    if (O.is_none[str](no) || O.is_none[str](vo)) {
        ret R.err[intern.StrId, str]("debug: compiler identity not interned");
    }
    val jr: R.Result[str, str] = str_join(alloc, O.unwrap[str](no), " ", O.unwrap[str](vo));
    if (R.is_err[str, str](jr)) { ret R.err[intern.StrId, str](R.unwrap_err[str, str](jr)); }
    val joined: str = R.unwrap_ok[str, str](jr);
    val ri: R.Result[intern.StrId, str] = intern.intern(itn, joined);
    A.deallocate[u8](alloc, joined::*u8, str_len(joined) + 1);
    ret ri;
}

test "mach.lang.driver.passes.intern_producer:name_version" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);

    val rn: R.Result[intern.StrId, str] = intern.intern(?itn, "mach");
    val rv: R.Result[intern.StrId, str] = intern.intern(?itn, "2.14.0");
    if (R.is_err[intern.StrId, str](rn) || R.is_err[intern.StrId, str](rv)) { ret 1; }

    val rp: R.Result[intern.StrId, str] = intern_producer(?itn, ?alloc,
        R.unwrap_ok[intern.StrId, str](rn), R.unwrap_ok[intern.StrId, str](rv));
    if (R.is_err[intern.StrId, str](rp)) { ret 1; }
    val got: O.Option[str] = intern.lookup(?itn, R.unwrap_ok[intern.StrId, str](rp));
    if (O.is_none[str](got) || !str_equals(O.unwrap[str](got), "mach 2.14.0")) { ret 1; }
    ret 0;
}

pub fun run_lower_pass(p: *project.Project) R.Result[R.Void, outcome.Fail] {
    val imp_r: R.Result[R.Void, str] = union.register_import_libraries(p);
    if (R.is_err[R.Void, str](imp_r)) {
        ret R.err[R.Void, outcome.Fail](outcome.user(R.unwrap_err[R.Void, str](imp_r)));
    }

    val pr: R.Result[R.Void, outcome.Fail] = lower_prepare(p);
    if (R.is_err[R.Void, outcome.Fail](pr)) { ret pr; }

    if (lower_parallel_enabled(p)) {

        val rp: R.Result[R.Void, fail.Fail] = run_lower_parallel(p);
        if (R.is_err[R.Void, fail.Fail](rp)) {
            ret R.err[R.Void, outcome.Fail](outcome.from_fail(R.unwrap_err[R.Void, fail.Fail](rp)));
        }
    }

    var i: u32 = 0;
    for (i < p.emit_len) {
        val mid: session.ModuleId = p.topo[i];

        val r: R.Result[R.Void, fail.Fail] = run_lower_one(p, mid);
        if (R.is_err[R.Void, fail.Fail](r)) {
            ret R.err[R.Void, outcome.Fail](outcome.from_fail(R.unwrap_err[R.Void, fail.Fail](r)));
        }
        i = i + 1;
    }
    ret R.ok_void[outcome.Fail]();
}

fun lower_prepare(p: *project.Project) R.Result[R.Void, outcome.Fail] {
    if (!query.is_registered(?p.s.queries, query.Q_LOWERED_SURFACE)) {
        val rls: R.Result[R.Void, str] = query.register_derived(?p.s.queries, query.Q_LOWERED_SURFACE);
        if (R.is_err[R.Void, str](rls)) { ret R.err[R.Void, outcome.Fail](outcome.internal(R.unwrap_err[R.Void, str](rls))); }
    }
    if (!query.is_registered(?p.s.queries, query.Q_LOWER)) {
        val rl: R.Result[R.Void, str] = query.register_derived_owned(?p.s.queries, query.Q_LOWER, q_lower_finalize);
        if (R.is_err[R.Void, str](rl)) { ret R.err[R.Void, outcome.Fail](outcome.internal(R.unwrap_err[R.Void, str](rl))); }
    }


    var i: u32 = 0;
    for (i < p.emit_len) {
        val m: *project.ModuleEntry = ?p.modules[p.topo[i]::u32];
        val sf_r: R.Result[*query.QueryEntry, fail.Fail] = query.get[project.Project](?p.queries, p, query.Q_LOWERED_SURFACE, m.stable_id::u64);
        if (R.is_err[*query.QueryEntry, fail.Fail](sf_r)) {
            ret R.err[R.Void, outcome.Fail](outcome.from_fail(R.unwrap_err[*query.QueryEntry, fail.Fail](sf_r)));
        }
        i = i + 1;
    }
    ret R.ok_void[outcome.Fail]();
}

fun lower_reusable(p: *project.Project, mid: session.ModuleId) bool {
    val m: *project.ModuleEntry = ?p.modules[mid::u32];
    ret query.peek_valid(?p.s.queries, query.Q_LOWER, back_half_key_for(p, m));
}

test "mach.lang.driver.passes:internal_failure_is_not_hidden_by_a_user_error" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 2; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    fin { session.dnit(?s); }
    var span: token.Span;
    span.offset = 0;
    span.len = 1;
    val emitted: R.Result[R.Void, str] = diagnostic.error(?s.diags, 0::src.FileId, span, "invalid user expression");
    if (R.is_err[R.Void, str](emitted)) { ret 3; }
    val f: outcome.Fail = outcome.from_fail(fail.message("internal allocation failure after rejection"));
    if (f.kind != outcome.FAIL_INTERNAL) { ret 4; }
    if (!str_equals(f.message, "internal allocation failure after rejection")) { ret 5; }
    ret 0;
}

test "mach.lang.driver.passes:message_only_internal_failure_stays_internal" {
    val f: outcome.Fail = outcome.from_fail(fail.message("internal failure without a diagnostic"));
    if (f.kind != outcome.FAIL_INTERNAL) { ret 1; }
    if (!str_equals(f.message, "internal failure without a diagnostic")) { ret 2; }
    if (outcome.from_fail(fail.reported()).kind != outcome.FAIL_REPORTED) { ret 3; }
    ret 0;
}

pub fun frontend_status(p: *project.Project) fail.PhaseStatus {
    var status: fail.PhaseStatus = fail.accepted();
    var i: u32 = 0;
    for (i < p.module_len) {
        val m: *project.ModuleEntry = ?p.modules[i];
        fail.merge(?status, m.parse_status);
        fail.merge(?status, m.load_status);
        fail.merge(?status, m.gate_status);
        if (m.resolve_result != nil) { fail.merge(?status, m.resolve_result.status); }
        if (m.sema_result != nil) { fail.merge(?status, m.sema_result.status); }
        i = i + 1;
    }
    ret status;
}

fun run_lower_one(p: *project.Project, mid: session.ModuleId) R.Result[R.Void, fail.Fail] {
    val m: *project.ModuleEntry = ?p.modules[mid::u32];

    val e_r: R.Result[*query.QueryEntry, fail.Fail] = query.get[project.Project](?p.queries, p, query.Q_LOWER, back_half_key_for(p, m));
    if (R.is_err[*query.QueryEntry, fail.Fail](e_r)) { ret R.err[R.Void, fail.Fail](R.unwrap_err[*query.QueryEntry, fail.Fail](e_r)); }
    val irm: *ir.Module = ir_handle_decode(R.unwrap_ok[*query.QueryEntry, fail.Fail](e_r));
    if (irm == nil) { ret R.err[R.Void, fail.Fail](fail.message("Q_LOWER produced no result handle")); }

    m.ir_module = irm;
    ret R.ok_void[fail.Fail]();
}

pub fun q_lowered_surface_compute(p: *project.Project, key: u64, alloc: *A.Allocator) R.Result[query.QueryOutput, fail.Fail] {
    val db: *query.QueryDb = ?p.s.queries;
    val s: *session.Session = p.s;

    val stable: session.StableModuleId = key::u32::session.StableModuleId;
    val mid: session.ModuleId = session.module_id_for_stable(s, stable);
    if (mid == session.MODULE_NIL) { ret R.err[query.QueryOutput, fail.Fail](fail.message("Q_LOWERED_SURFACE: stable id not loaded this build")); }
    val m: *project.ModuleEntry = ?p.modules[mid::u32];
    val a: *ast.Ast = m.a;
    if (a == nil) { ret R.err[query.QueryOutput, fail.Fail](fail.message("Q_LOWERED_SURFACE: module has no parsed AST")); }

    val rd: R.Result[R.Void, str] = query.record_dep(db, query.Q_LOWERED_SURFACE, key, query.Q_RESOLVE, key);
    if (R.is_err[R.Void, str](rd)) { ret R.err[query.QueryOutput, fail.Fail](fail.message(R.unwrap_err[R.Void, str](rd))); }

    val sf_o: O.Option[*src.SourceFile] = src.get(?s.sources, a.file_id);
    if (O.is_none[*src.SourceFile](sf_o)) { ret R.err[query.QueryOutput, fail.Fail](fail.message("Q_LOWERED_SURFACE: module source not loaded")); }
    val text: str = O.unwrap[*src.SourceFile](sf_o).text;

    var fb: dq.FpBuf;
    fb.alloc = alloc;
    fb.buf   = nil;
    fb.len   = 0;
    fb.cap   = 0;

    val wr: R.Result[R.Void, str] = fp_lowered_surface(?fb, a, text);
    if (R.is_err[R.Void, str](wr)) {
        if (fb.buf != nil && fb.cap > 0) { A.deallocate[u8](alloc, fb.buf, fb.cap::usize); }
        ret R.err[query.QueryOutput, fail.Fail](fail.message(R.unwrap_err[R.Void, str](wr)));
    }

    ret fail.lift[query.QueryOutput](dq.fp_take(?fb));
}

fun fp_lowered_surface(fb: *dq.FpBuf, a: *ast.Ast, text: str) R.Result[R.Void, str] {
    val base:  *u8    = text::*u8;
    val total: usize  = str_len(text);

    val m_opt: O.Option[*module.Module] = ast.get_module(a, a.root_module);
    if (O.is_none[*module.Module](m_opt)) { ret dq.fp_bytes(fb, base, total::u32); }
    val mod_node: *module.Module = O.unwrap[*module.Module](m_opt);

    var cursor: usize = 0;
    var i: u32 = 0;
    for (i < mod_node.decls_len) {
        val did: id.DeclId = a.decl_ids[mod_node.decls_start + i];
        val w: R.Result[R.Void, str] = fp_non_flowing_decl_bodies(fb, a, text, base, did, ?cursor);
        if (R.is_err[R.Void, str](w)) { ret w; }
        i = i + 1;
    }
    ret dq.fp_bytes(fb, ?base[cursor], (total - cursor)::u32);
}

fun fp_non_flowing_decl_bodies(fb: *dq.FpBuf, a: *ast.Ast, text: str, base: *u8,
                               did: id.DeclId, cursor: *usize) R.Result[R.Void, str] {
    val d_opt: O.Option[*decl.Decl] = ast.get_decl(a, did);
    if (O.is_none[*decl.Decl](d_opt)) {
        ret R.err[R.Void, str]("Q_LOWERED_SURFACE: declaration id out of range");
    }
    val d: *decl.Decl = O.unwrap[*decl.Decl](d_opt);

    val bs_o: O.Option[token.Span] = non_flowing_body_span(a, text, d);
    if (O.is_some[token.Span](bs_o)) {
        val bs: token.Span = O.unwrap[token.Span](bs_o);
        if (bs.offset < @cursor) {
            ret R.err[R.Void, str]("Q_LOWERED_SURFACE: declaration body spans overlap");
        }
        val w: R.Result[R.Void, str] = dq.fp_bytes(fb, ?base[@cursor], (bs.offset - @cursor)::u32);
        if (R.is_err[R.Void, str](w)) { ret w; }
        @cursor = bs.offset + bs.len;
        ret R.ok_void[str]();
    }

    if (d.kind != decl.DECL_KIND_COMPTIME_IF) { ret R.ok_void[str](); }
    var bi: u32 = 0;
    for (bi < d.data.comptime_if.branches_len) {
        val branch_ix: u32 = d.data.comptime_if.branches_start + bi;
        if (branch_ix::usize >= a.comptime_branch_len) {
            ret R.err[R.Void, str]("Q_LOWERED_SURFACE: comptime branch index out of range");
        }
        val branch: *decl.ComptimeBranch = ?a.comptime_branches[branch_ix];
        var di: u32 = 0;
        for (di < branch.body_len) {
            val pool_ix: u32 = branch.body_start + di;
            if (pool_ix::usize >= a.decl_id_len) {
                ret R.err[R.Void, str]("Q_LOWERED_SURFACE: comptime declaration index out of range");
            }
            val w: R.Result[R.Void, str] = fp_non_flowing_decl_bodies(fb, a, text, base, a.decl_ids[pool_ix], cursor);
            if (R.is_err[R.Void, str](w)) { ret w; }
            di = di + 1;
        }
        bi = bi + 1;
    }
    ret R.ok_void[str]();
}

fun non_flowing_body_span(a: *ast.Ast, text: str, d: *decl.Decl) O.Option[token.Span] {
    var body: id.StmtId = id.STMT_NIL;
    if (d.kind == decl.DECL_KIND_TEST) {
        body = d.data.test_.body;
    }
    or (d.kind == decl.DECL_KIND_FUN) {
        if (d.data.fun_.generics_len > 0) { ret O.none[token.Span](); }
        var pi: u32 = 0;
        for (pi < d.data.fun_.params_len) {
            if (a.typed_names[d.data.fun_.params_start + pi].comptime) { ret O.none[token.Span](); }
            pi = pi + 1;
        }
        if (decl_has_decorator_named(a, text, d, "inline")) { ret O.none[token.Span](); }
        body = d.data.fun_.body;
    }
    if (body == id.STMT_NIL) { ret O.none[token.Span](); }

    val st_o: O.Option[*stmt.Stmt] = ast.get_stmt(a, body);
    if (O.is_none[*stmt.Stmt](st_o)) { ret O.none[token.Span](); }
    ret O.some[token.Span](O.unwrap[*stmt.Stmt](st_o).span);
}

fun decl_has_decorator_named(a: *ast.Ast, text: str, d: *decl.Decl, name: str) bool {
    var i: u32 = 0;
    for (i < d.decorators_len) {
        val dec: *decl.Decorator = ?a.decorators[d.decorators_start + i];
        if (str_region_equals(text, dec.name.offset, dec.name.len, name)) { ret true; }
        i = i + 1;
    }
    ret false;
}

pub fun q_lower_compute(p: *project.Project, key: u64, alloc: *A.Allocator) R.Result[query.QueryOutput, fail.Fail] {
    val db: *query.QueryDb = ?p.s.queries;
    val s: *session.Session = p.s;

    val stable: session.StableModuleId = key::u32::session.StableModuleId;
    val test_mode: bool = back_half_key_is_test(key);
    val mid: session.ModuleId = session.module_id_for_stable(s, stable);
    if (mid == session.MODULE_NIL) { ret R.err[query.QueryOutput, fail.Fail](fail.message("Q_LOWER: stable id not loaded this build")); }
    val m: *project.ModuleEntry = ?p.modules[mid::u32];
    val a: *ast.Ast = m.a;
    if (a == nil) { ret R.err[query.QueryOutput, fail.Fail](fail.message("Q_LOWER: module has no parsed AST")); }
    val sr: *sema.SemaResult = m.sema_result;
    if (sr == nil) { ret R.err[query.QueryOutput, fail.Fail](fail.message("Q_LOWER: module has no sema result")); }

    val rsd: R.Result[R.Void, str] = query.record_dep(db, query.Q_LOWER, key, query.Q_SEMA, stable::u64);
    if (R.is_err[R.Void, str](rsd)) { ret R.err[query.QueryOutput, fail.Fail](fail.message(R.unwrap_err[R.Void, str](rsd))); }
    val rt: R.Result[R.Void, str] = query.record_dep(db, query.Q_LOWER, key, query.Q_TARGET, 0);
    if (R.is_err[R.Void, str](rt)) { ret R.err[query.QueryOutput, fail.Fail](fail.message(R.unwrap_err[R.Void, str](rt))); }

    val cl_r: R.Result[LowerClosure, str] = collect_lower_closure(p, m);
    if (R.is_err[LowerClosure, str](cl_r)) { ret R.err[query.QueryOutput, fail.Fail](fail.message(R.unwrap_err[LowerClosure, str](cl_r))); }
    var cl: LowerClosure = R.unwrap_ok[LowerClosure, str](cl_r);
    var di: u32 = 0;
    for (di < cl.count) {
        val dep_mid: session.ModuleId = cl.list[di];
        val dep_stable: session.StableModuleId = p.modules[dep_mid::u32].stable_id;
        val ge: R.Result[*query.QueryEntry, fail.Fail] = query.get[project.Project](?p.queries, p, query.Q_LOWERED_SURFACE, dep_stable::u64);
        if (R.is_err[*query.QueryEntry, fail.Fail](ge)) {
            free_lower_closure(s.alloc, ?cl);
            ret R.err[query.QueryOutput, fail.Fail](R.unwrap_err[*query.QueryEntry, fail.Fail](ge));
        }
        di = di + 1;
    }
    free_lower_closure(s.alloc, ?cl);

    if (m.staged_ir != nil) {
        val sir:  *ir.Module     = m.staged_ir;
        val shome: *ir.ModuleHome = m.staged_home;
        m.staged_ir   = nil;
        m.staged_home = nil;
        ret ir_handle_encode(alloc, sir, shome);
    }

    val hr: R.Result[*ir.ModuleHome, str] = ir_home_new(alloc);
    if (R.is_err[*ir.ModuleHome, str](hr)) { ret R.err[query.QueryOutput, fail.Fail](fail.message(R.unwrap_err[*ir.ModuleHome, str](hr))); }
    val home: *ir.ModuleHome = R.unwrap_ok[*ir.ModuleHome, str](hr);

    val t_low: ctime.Time = readout.item_begin(p.events);
    val rr_raw: R.Result[*ir.Module, fail.Fail] = lower_raw(p, mid, home, test_mode);
    if (R.is_err[*ir.Module, fail.Fail](rr_raw)) {
        val stable: fail.Fail = lower_stable_fail(p, R.unwrap_err[*ir.Module, fail.Fail](rr_raw));
        ir_release(alloc, home);
        ret R.err[query.QueryOutput, fail.Fail](stable);
    }
    readout.item(p.events, readout.PH_LOWER, project.fqn_name(p, m.fqn), t_low);
    val irmod: *ir.Module = R.unwrap_ok[*ir.Module, fail.Fail](rr_raw);

    val nid: R.Result[intern.StrId, fail.Fail] = neutralize_id(p, test_mode);
    if (R.is_err[intern.StrId, fail.Fail](nid)) {
        ir_release(alloc, home);
        ret R.err[query.QueryOutput, fail.Fail](R.unwrap_err[intern.StrId, fail.Fail](nid));
    }
    val t_opt: ctime.Time = readout.span_begin(p.events);
    val ro: R.Result[R.Void, fail.Fail] = lower_optimize(p, irmod, R.unwrap_ok[intern.StrId, fail.Fail](nid));
    readout.item(p.events, readout.PH_OPTIMIZE, project.fqn_name(p, m.fqn), t_opt);
    readout.span_end(p.events, readout.PH_OPTIMIZE, readout.PH_LOWER, t_opt);
    if (R.is_err[R.Void, fail.Fail](ro)) {
        val stable: fail.Fail = lower_stable_fail(p, R.unwrap_err[R.Void, fail.Fail](ro));
        ir_release(alloc, home);
        ret R.err[query.QueryOutput, fail.Fail](stable);
    }

    ret ir_handle_encode(alloc, irmod, home);
}

fun lower_raw(p: *project.Project, mid: session.ModuleId, home: *ir.ModuleHome, test_mode: bool) R.Result[*ir.Module, fail.Fail] {
    val s:   *session.Session   = p.s;
    val m:   *project.ModuleEntry = ?p.modules[mid::u32];

    val req_r: R.Result[lower.LowerRequest, fail.Fail] = lower.request(s, ?p.target, ?home.alloc, m.a, m.fqn, mid,
        m.sema_result, m.resolve_result, ?m.ctx, test_mode, p.req.debug);
    if (R.is_err[lower.LowerRequest, fail.Fail](req_r)) { ret R.err[*ir.Module, fail.Fail](R.unwrap_err[lower.LowerRequest, fail.Fail](req_r)); }
    var req: lower.LowerRequest = R.unwrap_ok[lower.LowerRequest, fail.Fail](req_r);

    val res_lower: R.Result[ir.Module, fail.Fail] = lower.lower_module(?req);
    if (R.is_err[ir.Module, fail.Fail](res_lower)) { ret R.err[*ir.Module, fail.Fail](R.unwrap_err[ir.Module, fail.Fail](res_lower)); }

    val br: R.Result[*ir.Module, str] = A.allocate[ir.Module](?home.alloc, 1::usize);
    if (R.is_err[*ir.Module, str](br)) { ret fail.lift[*ir.Module](br); }
    val box: *ir.Module = R.unwrap_ok[*ir.Module, str](br);
    box[0] = R.unwrap_ok[ir.Module, fail.Fail](res_lower);

    val res_obl: R.Result[bool, str] = oblivious.check_module(box, ?s.interner, ?s.diags, s.alloc);
    if (R.is_err[bool, str](res_obl)) { ret R.err[*ir.Module, fail.Fail](fail.message(R.unwrap_err[bool, str](res_obl))); }
    if (!R.unwrap_ok[bool, str](res_obl)) {
        ret R.err[*ir.Module, fail.Fail](fail.message("oblivious-required check: a function computes on a secret without `#[oblivious]`"));
    }
    ret R.ok[*ir.Module, fail.Fail](box);
}

fun lower_optimize(p: *project.Project, irmod: *ir.Module, main_id: intern.StrId) R.Result[R.Void, fail.Fail] {
    var preq: pipeline.PipelineRequest;
    preq.module            = irmod;
    preq.target             = ?p.target;
    preq.level               = p.req.opt;
    preq.vectorize_enabled   = pipeline.VectorizeEnabledOption{ v: p.req.vectorize };
    preq.simd_require        = pipeline.SimdRequireOption{ v: p.req.simd == manifest.SIMD_REQUIRE };
    preq.float_reassoc       = pipeline.FloatReassocOption{ v: p.req.float_reassoc };
    preq.interner            = ?p.s.interner;
    preq.source_map          = ?p.s.sources;
    val res_opt: R.Result[bool, str] = pipeline.run(?preq);
    if (R.is_err[bool, str](res_opt)) { ret fail.lift[R.Void](R.void_of[bool, str](res_opt)); }

    if (main_id != intern.STR_NIL) { testrunner.neutralize_main(main_id, irmod); }
    ret R.ok_void[fail.Fail]();
}

fun neutralize_id(p: *project.Project, test_mode: bool) R.Result[intern.StrId, fail.Fail] {
    if (!test_mode) { ret R.ok[intern.StrId, fail.Fail](intern.STR_NIL); }
    ret testrunner.main_linkage_id(p.s);
}

fun ir_home_new(alloc: *A.Allocator) R.Result[*ir.ModuleHome, str] {
    val hr: R.Result[*ir.ModuleHome, str] = A.allocate[ir.ModuleHome](alloc, 1::usize);
    if (R.is_err[*ir.ModuleHome, str](hr)) { ret hr; }
    val home: *ir.ModuleHome = R.unwrap_ok[*ir.ModuleHome, str](hr);
    val io: O.Option[str] = ir.home_init(home);
    if (O.is_some[str](io)) {
        A.deallocate[ir.ModuleHome](alloc, home, 1::usize);
        ret R.err[*ir.ModuleHome, str](O.unwrap[str](io));
    }
    ret R.ok[*ir.ModuleHome, str](home);
}

fun lower_stable_fail(p: *project.Project, f: fail.Fail) fail.Fail {
    if (f.kind == fail.REPORTED) { ret f; }
    ret fail.message(lower_stable_err(p, f.message));
}

fun lower_stable_err(p: *project.Project, msg: str) str {
    val ir_r: R.Result[intern.StrId, str] = intern.intern(?p.s.interner, msg);
    if (R.is_ok[intern.StrId, str](ir_r)) {
        val nm: O.Option[str] = intern.lookup(?p.s.interner, R.unwrap_ok[intern.StrId, str](ir_r));
        if (O.is_some[str](nm)) { ret O.unwrap[str](nm); }
    }
    ret "lowering failed, and re-homing its diagnostic off the module arena failed in turn (allocation failure)";
}

fun ir_release(alloc: *A.Allocator, home: *ir.ModuleHome) {
    if (home == nil) { ret; }
    ir.home_dnit(home);
    A.deallocate[ir.ModuleHome](alloc, home, 1::usize);
}

pub fun q_lower_finalize(value: *u8, value_len: u32, alloc: *A.Allocator) {
    if (value == nil || value_len < ir_handle_len()) { ret; }
    val slot: *ptr = value::ptr::*ptr;
    ir_release(alloc, slot[1]::*ir.ModuleHome);
}

fun ir_handle_len() u32 {
    ret ($size_of(ptr) * 2)::u32;
}

fun ir_handle_encode(alloc: *A.Allocator, r: *ir.Module, home: *ir.ModuleHome) R.Result[query.QueryOutput, fail.Fail] {
    val rb: R.Result[*u8, str] = A.allocate[u8](alloc, ir_handle_len()::usize);
    if (R.is_err[*u8, str](rb)) {
        ir_release(alloc, home);
        ret R.err[query.QueryOutput, fail.Fail](fail.message(R.unwrap_err[*u8, str](rb)));
    }
    val buf: *u8 = R.unwrap_ok[*u8, str](rb);
    val slot: *ptr = buf::ptr::*ptr;
    slot[0] = r::ptr;
    slot[1] = home::ptr;
    var out: query.QueryOutput;
    out.bytes = buf;
    out.len   = ir_handle_len();
    ret R.ok[query.QueryOutput, fail.Fail](out);
}

fun ir_handle_decode(e: *query.QueryEntry) *ir.Module {
    if (e.value == nil || e.value_len < ir_handle_len()) { ret nil; }
    val slot: *ptr = e.value::ptr::*ptr;
    ret slot[0]::*ir.Module;
}

fun lower_parallel_enabled(p: *project.Project) bool {
    ret p.req.jobs >= 1 && p.emit_len > 0;
}

rec PlwSlot {
    mid:    session.ModuleId;
    m:      *ir.Module;
    failed: bool;
    fail:   fail.Fail;
    d:      cdur.Duration;
}

rec ParallelLower {
    p:        *project.Project;
    next:     i64;
    stop:     i64;
    main_id:  intern.StrId;
    slots:    *PlwSlot;
    slot_len: u32;
}

fun plw_worker_main(arg: *u8) {
    val pl: *ParallelLower = arg::*ParallelLower;
    if (pl == nil) { ret; }

    for (true) {
        if (atomic.load(?pl.stop) != 0) { ret; }
        val idx_raw: i64 = atomic.fetch_add(?pl.next, 1::i64);
        if (idx_raw >= pl.slot_len::i64) { ret; }

        val slot: *PlwSlot = ?pl.slots[idx_raw::usize];
        val t0: ctime.Time = ctime.monotonic();
        val r: R.Result[R.Void, fail.Fail] = lower_optimize(pl.p, slot.m, pl.main_id);
        slot.d = ctime.time_sub(ctime.monotonic(), t0);
        if (R.is_err[R.Void, fail.Fail](r)) {
            slot.fail   = R.unwrap_err[R.Void, fail.Fail](r);
            slot.failed = true;
            atomic.store(?pl.stop, 1::i64);
            ret;
        }
    }
}

fun run_lower_parallel(p: *project.Project) R.Result[R.Void, fail.Fail] {
    val emit_len: u32 = p.emit_len;
    if (emit_len == 0) { ret R.ok_void[fail.Fail](); }

    val rslots: R.Result[*PlwSlot, str] = A.allocate[PlwSlot](p.alloc, emit_len::usize);
    if (R.is_err[*PlwSlot, str](rslots)) { ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[*PlwSlot, str](rslots))); }
    val slots: *PlwSlot = R.unwrap_ok[*PlwSlot, str](rslots);

    var slot_len: u32 = 0;
    var ti: u32 = 0;
    for (ti < emit_len) {
        val mid: session.ModuleId = p.topo[ti];
        if (!lower_reusable(p, mid)) {
            slots[slot_len].mid = mid;
            slots[slot_len].m   = nil;
            slots[slot_len].failed = false;
            slots[slot_len].d   = 0;
            slot_len = slot_len + 1;
        }
        ti = ti + 1;
    }
    if (slot_len <= 1) {
        A.deallocate[PlwSlot](p.alloc, slots, emit_len::usize);
        ret R.ok_void[fail.Fail]();
    }

    val test_mode: bool = test_build(p);

    var si: u32 = 0;
    for (si < slot_len) {
        val mid: session.ModuleId = slots[si].mid;
        val m:   *project.ModuleEntry = ?p.modules[mid::u32];

        val t_item: ctime.Time = readout.item_begin(p.events);

        val hr: R.Result[*ir.ModuleHome, str] = ir_home_new(p.s.alloc);
        if (R.is_err[*ir.ModuleHome, str](hr)) {
            lower_sweep_staged(p);
            A.deallocate[PlwSlot](p.alloc, slots, emit_len::usize);
            ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[*ir.ModuleHome, str](hr)));
        }
        val home: *ir.ModuleHome = R.unwrap_ok[*ir.ModuleHome, str](hr);

        val rr_raw: R.Result[*ir.Module, fail.Fail] = lower_raw(p, mid, home, test_mode);
        if (R.is_err[*ir.Module, fail.Fail](rr_raw)) {
            val stable: fail.Fail = lower_stable_fail(p, R.unwrap_err[*ir.Module, fail.Fail](rr_raw));
            ir_release(p.s.alloc, home);
            lower_sweep_staged(p);
            A.deallocate[PlwSlot](p.alloc, slots, emit_len::usize);
            ret R.err[R.Void, fail.Fail](stable);
        }
        m.staged_ir   = R.unwrap_ok[*ir.Module, fail.Fail](rr_raw);
        m.staged_home = home;
        slots[si].m   = m.staged_ir;
        readout.item(p.events, readout.PH_LOWER, project.fqn_name(p, m.fqn), t_item);
        si = si + 1;
    }

    var nworkers: u32 = p.req.jobs;
    if (nworkers == 0)        { nworkers = 1; }
    if (nworkers > slot_len)  { nworkers = slot_len; }

    val nid: R.Result[intern.StrId, fail.Fail] = neutralize_id(p, test_mode);
    if (R.is_err[intern.StrId, fail.Fail](nid)) {
        lower_sweep_staged(p);
        A.deallocate[PlwSlot](p.alloc, slots, emit_len::usize);
        ret R.err[R.Void, fail.Fail](R.unwrap_err[intern.StrId, fail.Fail](nid));
    }

    var pl: ParallelLower;
    pl.p        = p;
    pl.next     = 0;
    pl.stop     = 0;
    pl.main_id  = R.unwrap_ok[intern.StrId, fail.Fail](nid);
    pl.slots    = slots;
    pl.slot_len = slot_len;

    val t_opt: ctime.Time = readout.span_begin(p.events);
    var threads: *thread.Thread = nil;
    val extra: u32 = nworkers - 1;
    if (extra > 0) {
        val rt: R.Result[*thread.Thread, str] = A.allocate[thread.Thread](p.alloc, extra::usize);
        if (R.is_err[*thread.Thread, str](rt)) {
            lower_sweep_staged(p);
            A.deallocate[PlwSlot](p.alloc, slots, emit_len::usize);
            ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[*thread.Thread, str](rt)));
        }
        threads = R.unwrap_ok[*thread.Thread, str](rt);
        var k: u32 = 0;
        for (k < extra) { thread.spawn_with(plw_worker_main, (?pl)::*u8, ?threads[k]); k = k + 1; }
    }

    plw_worker_main((?pl)::*u8);

    if (extra > 0) {
        var k: u32 = 0;
        for (k < extra) {
            if (threads[k].tid >= 0) { thread.join(?threads[k]); }
            k = k + 1;
        }
        A.deallocate[thread.Thread](p.alloc, threads, extra::usize);
    }
    readout.span_end(p.events, readout.PH_OPTIMIZE, readout.PH_LOWER, t_opt);

    readout.phase_workers(p.events, readout.PH_OPTIMIZE, nworkers);
    var ii: u32 = 0;
    for (ii < slot_len) {
        val im: *project.ModuleEntry = ?p.modules[slots[ii].mid::u32];
        readout.item_dur(p.events, readout.PH_OPTIMIZE, project.fqn_name(p, im.fqn), slots[ii].d);
        ii = ii + 1;
    }

    var ei: u32 = 0;
    for (ei < slot_len) {
        if (slots[ei].failed) {
            val stable: fail.Fail = lower_stable_fail(p, slots[ei].fail);
            lower_sweep_staged(p);
            A.deallocate[PlwSlot](p.alloc, slots, emit_len::usize);
            ret R.err[R.Void, fail.Fail](stable);
        }
        ei = ei + 1;
    }

    A.deallocate[PlwSlot](p.alloc, slots, emit_len::usize);
    ret R.ok_void[fail.Fail]();
}

pub fun lower_sweep_staged(p: *project.Project) {
    var i: u32 = 0;
    for (i < p.module_len) {
        val m: *project.ModuleEntry = ?p.modules[i];
        if (m.staged_home != nil) {
            ir_release(p.s.alloc, m.staged_home);
            m.staged_home = nil;
        }
        m.staged_ir = nil;
        i = i + 1;
    }
}

fun ensure_lower_visit_capacity(p: *project.Project, needed: u32) R.Result[R.Void, str] {
    if (p.lower_visit_cap >= needed) { ret R.ok_void[str](); }
    var new_cap: u32 = p.lower_visit_cap;
    if (new_cap == 0) { new_cap = load.INITIAL_MODULE_CAP; }
    for (new_cap < needed) { new_cap = new_cap * 2; }

    if (p.lower_visit_gen == nil) {
        val r: R.Result[*u32, str] = A.allocate[u32](p.s.alloc, new_cap::usize);
        if (R.is_err[*u32, str](r)) { ret R.err[R.Void, str](R.unwrap_err[*u32, str](r)); }
        p.lower_visit_gen = R.unwrap_ok[*u32, str](r);
    }
    or {
        val r: R.Result[*u32, str] = A.reallocate[u32](p.s.alloc, p.lower_visit_gen, p.lower_visit_cap::usize, new_cap::usize);
        if (R.is_err[*u32, str](r)) { ret R.err[R.Void, str](R.unwrap_err[*u32, str](r)); }
        p.lower_visit_gen = R.unwrap_ok[*u32, str](r);
    }
    var i: u32 = p.lower_visit_cap;
    for (i < new_cap) { p.lower_visit_gen[i] = 0; i = i + 1; }
    p.lower_visit_cap = new_cap;
    ret R.ok_void[str]();
}

fun collect_lower_closure(p: *project.Project, m: *project.ModuleEntry) R.Result[LowerClosure, str] {
    var cl: LowerClosure;
    cl.list  = nil;
    cl.count = 0;
    cl.cap   = 0;
    if (m.dep_count == 0 || p.module_len == 0) { ret R.ok[LowerClosure, str](cl); }

    val cr: R.Result[R.Void, str] = ensure_lower_visit_capacity(p, p.module_len);
    if (R.is_err[R.Void, str](cr)) { ret R.err[LowerClosure, str](R.unwrap_err[R.Void, str](cr)); }
    p.lower_visit_epoch = p.lower_visit_epoch + 1;
    val epoch: u32 = p.lower_visit_epoch;
    val gen: *u32 = p.lower_visit_gen;

    val lr: R.Result[*session.ModuleId, str] = A.allocate[session.ModuleId](p.s.alloc, p.module_len::usize);
    if (R.is_err[*session.ModuleId, str](lr)) { ret R.err[LowerClosure, str](R.unwrap_err[*session.ModuleId, str](lr)); }
    val list: *session.ModuleId = R.unwrap_ok[*session.ModuleId, str](lr);
    var list_len: u32 = 0;

    var i: u32 = 0;
    for (i < m.dep_count) {
        val d: session.ModuleId = m.deps[i];
        if (d::u32 < p.module_len && gen[d::u32] != epoch) {
            gen[d::u32]     = epoch;
            list[list_len]  = d;
            list_len = list_len + 1;
        }
        i = i + 1;
    }

    var head: u32 = 0;
    for (head < list_len) {
        val cur: session.ModuleId = list[head];
        val cm:  *project.ModuleEntry = ?p.modules[cur::u32];
        var j: u32 = 0;
        for (j < cm.dep_count) {
            val d: session.ModuleId = cm.deps[j];
            if (d::u32 < p.module_len && gen[d::u32] != epoch) {
                gen[d::u32]     = epoch;
                list[list_len]  = d;
                list_len = list_len + 1;
            }
            j = j + 1;
        }
        head = head + 1;
    }

    cl.list  = list;
    cl.count = list_len;
    cl.cap   = p.module_len;
    ret R.ok[LowerClosure, str](cl);
}

fun free_lower_closure(alloc: *A.Allocator, cl: *LowerClosure) {
    if (cl.list == nil || cl.cap == 0) { ret; }
    A.deallocate[session.ModuleId](alloc, cl.list, cl.cap::usize);
    cl.list  = nil;
    cl.count = 0;
    cl.cap   = 0;
}

pub fun run_codegen_pass(p: *project.Project) R.Result[R.Void, outcome.Fail] {
    if (!query.is_registered(?p.s.queries, query.Q_CODEGEN)) {
        val rcg: R.Result[R.Void, str] = query.register_derived_owned(?p.s.queries, query.Q_CODEGEN, q_codegen_finalize);
        if (R.is_err[R.Void, str](rcg)) { ret R.err[R.Void, outcome.Fail](outcome.internal(R.unwrap_err[R.Void, str](rcg))); }
    }

    var pflag: u32 = codegen.resolve_placement_policy(p.req.placement_policy);
    val pf: R.Result[R.Void, str] = query.set_input(?p.s.queries, query.Q_CODEGEN_FLAGS, 0, (?pflag)::*u8, 4);
    if (R.is_err[R.Void, str](pf)) {
        ret R.err[R.Void, outcome.Fail](outcome.user(R.unwrap_err[R.Void, str](pf)));
    }

    var i: u32 = 0;
    for (i < p.emit_len) {
        val mid: session.ModuleId = p.topo[i];

        val r: R.Result[R.Void, fail.Fail] = run_codegen_one(p, mid);
        if (R.is_err[R.Void, fail.Fail](r)) {
            ret R.err[R.Void, outcome.Fail](outcome.from_fail(R.unwrap_err[R.Void, fail.Fail](r)));
        }
        i = i + 1;
    }
    ret R.ok_void[outcome.Fail]();
}

pub fun code_sources(p: *project.Project, mid: session.ModuleId, a: *A.Allocator) R.Result[CodeSources, str] {
    if (!isa.emits_whole_module(p.target.isa)) { ret R.ok[CodeSources, str](sources_empty()); }
    val n: u32 = p.module_len;
    if (n == 0) { ret R.ok[CodeSources, str](sources_empty()); }

    val rm: R.Result[*bool, str] = A.allocate[bool](a, n::usize);
    if (R.is_err[*bool, str](rm)) { ret R.err[CodeSources, str](R.unwrap_err[*bool, str](rm)); }
    val mark: *bool = R.unwrap_ok[*bool, str](rm);
    var i: u32 = 0;
    for (i < n) { mark[i] = false; i = i + 1; }
    mark[mid::u32] = true;

    var changed: bool = true;
    for (changed) {
        changed = false;
        i = 0;
        for (i < n) {
            if (!mark[i]) { i = i + 1; cnt; }
            val im: *ir.Module = p.modules[i].ir_module;
            if (im == nil) { i = i + 1; cnt; }
            var fi: u32 = 0;
            for (fi < im.function_len) {
                val fn: *ir.Function = ?im.functions[fi];
                if ((fn.flags & ir.FN_FLAG_EXTERN) == 0 || fn.is_import) { fi = fi + 1; cnt; }
                val def: u32 = definer_of(p, fn.name);
                if (def != n && !mark[def]) { mark[def] = true; changed = true; }
                fi = fi + 1;
            }
            var gi: u32 = 0;
            for (gi < im.global_len) {
                val g: *ir.Global = ?im.globals[gi];
                if (!g.is_extern || g.is_import) { gi = gi + 1; cnt; }
                val gdef: u32 = global_definer_of(p, g.name);
                if (gdef != n && !mark[gdef]) { mark[gdef] = true; changed = true; }
                gi = gi + 1;
            }
            i = i + 1;
        }
    }

    var count: u32 = 0;
    i = 0;
    for (i < n) { if (mark[i] && i != mid::u32 && p.modules[i].ir_module != nil) { count = count + 1; } i = i + 1; }
    if (count == 0) {
        A.deallocate[bool](a, mark, n::usize);
        ret R.ok[CodeSources, str](sources_empty());
    }

    var cs: CodeSources = sources_empty();
    val rs: R.Result[**ir.Module, str] = A.allocate[*ir.Module](a, count::usize);
    if (R.is_err[**ir.Module, str](rs)) {
        A.deallocate[bool](a, mark, n::usize);
        ret R.err[CodeSources, str](R.unwrap_err[**ir.Module, str](rs));
    }
    cs.set.mods = R.unwrap_ok[**ir.Module, str](rs);
    val ri: R.Result[*session.ModuleId, str] = A.allocate[session.ModuleId](a, count::usize);
    if (R.is_err[*session.ModuleId, str](ri)) {
        A.deallocate[*ir.Module](a, cs.set.mods, count::usize);
        A.deallocate[bool](a, mark, n::usize);
        ret R.err[CodeSources, str](R.unwrap_err[*session.ModuleId, str](ri));
    }
    cs.ids = R.unwrap_ok[*session.ModuleId, str](ri);
    cs.cap = count;

    var ti: u32 = 0;
    for (ti < p.topo_len) {
        val tid: u32 = p.topo[ti]::u32;
        if (mark[tid] && tid != mid::u32 && p.modules[tid].ir_module != nil && cs.set.len < count) {
            cs.set.mods[cs.set.len] = p.modules[tid].ir_module;
            cs.ids[cs.set.len]      = p.topo[ti];
            cs.set.len = cs.set.len + 1;
        }
        ti = ti + 1;
    }
    A.deallocate[bool](a, mark, n::usize);
    ret R.ok[CodeSources, str](cs);
}

pub rec CodeSources {
    set: unit.IrSet;
    ids: *session.ModuleId;
    cap: u32;
}

pub fun sources_empty() CodeSources {
    var cs: CodeSources;
    cs.set = unit.ir_set_empty();
    cs.ids = nil;
    cs.cap = 0;
    ret cs;
}

pub fun sources_dnit(a: *A.Allocator, cs: *CodeSources) {
    if (cs.cap > 0) {
        if (cs.set.mods != nil) { A.deallocate[*ir.Module](a, cs.set.mods, cs.cap::usize); }
        if (cs.ids != nil)      { A.deallocate[session.ModuleId](a, cs.ids, cs.cap::usize); }
    }
    cs.set.mods = nil;
    cs.set.len  = 0;
    cs.ids      = nil;
    cs.cap      = 0;
}

fun definer_of(p: *project.Project, name: intern.StrId) u32 {
    var i: u32 = 0;
    for (i < p.module_len) {
        val im: *ir.Module = p.modules[i].ir_module;
        if (im != nil && unit.defined_index(im, name) != unit.UNIT_NONE) { ret i; }
        i = i + 1;
    }
    ret p.module_len;
}

fun global_definer_of(p: *project.Project, name: intern.StrId) u32 {
    var i: u32 = 0;
    for (i < p.module_len) {
        val im: *ir.Module = p.modules[i].ir_module;
        if (im != nil && unit.defined_global_index(im, name) != unit.UNIT_NONE) { ret i; }
        i = i + 1;
    }
    ret p.module_len;
}

fun run_codegen_one(p: *project.Project, mid: session.ModuleId) R.Result[R.Void, fail.Fail] {
    val m: *project.ModuleEntry = ?p.modules[mid::u32];

    val e_r: R.Result[*query.QueryEntry, fail.Fail] = query.get[project.Project](?p.queries, p, query.Q_CODEGEN, back_half_key_for(p, m));
    if (R.is_err[*query.QueryEntry, fail.Fail](e_r)) { ret R.err[R.Void, fail.Fail](R.unwrap_err[*query.QueryEntry, fail.Fail](e_r)); }
    val img: *of.ObjectImage = image_handle_decode(R.unwrap_ok[*query.QueryEntry, fail.Fail](e_r));
    if (img == nil) { ret R.err[R.Void, fail.Fail](fail.message("Q_CODEGEN produced no result handle")); }

    m.object_image = img;
    ret R.ok_void[fail.Fail]();
}

pub fun q_codegen_compute(p: *project.Project, key: u64, alloc: *A.Allocator) R.Result[query.QueryOutput, fail.Fail] {
    val db: *query.QueryDb = ?p.s.queries;
    val s: *session.Session = p.s;

    val stable: session.StableModuleId = key::u32::session.StableModuleId;
    val mid: session.ModuleId = session.module_id_for_stable(s, stable);
    if (mid == session.MODULE_NIL) { ret R.err[query.QueryOutput, fail.Fail](fail.message("Q_CODEGEN: stable id not loaded this build")); }
    val m: *project.ModuleEntry = ?p.modules[mid::u32];
    val irmod: *ir.Module = m.ir_module;
    if (irmod == nil) { ret R.err[query.QueryOutput, fail.Fail](fail.message("Q_CODEGEN: module has no lowered IR")); }

    val rl: R.Result[R.Void, str] = query.record_dep(db, query.Q_CODEGEN, key, query.Q_LOWER, key);
    if (R.is_err[R.Void, str](rl)) { ret R.err[query.QueryOutput, fail.Fail](fail.message(R.unwrap_err[R.Void, str](rl))); }
    val rt: R.Result[R.Void, str] = query.record_dep(db, query.Q_CODEGEN, key, query.Q_TARGET, 0);
    if (R.is_err[R.Void, str](rt)) { ret R.err[query.QueryOutput, fail.Fail](fail.message(R.unwrap_err[R.Void, str](rt))); }
    val rpp: R.Result[R.Void, str] = query.record_dep(db, query.Q_CODEGEN, key, query.Q_CODEGEN_FLAGS, 0);
    if (R.is_err[R.Void, str](rpp)) { ret R.err[query.QueryOutput, fail.Fail](fail.message(R.unwrap_err[R.Void, str](rpp))); }

    val srcs_r: R.Result[CodeSources, str] = code_sources(p, mid, s.alloc);
    if (R.is_err[CodeSources, str](srcs_r)) { ret R.err[query.QueryOutput, fail.Fail](fail.message(R.unwrap_err[CodeSources, str](srcs_r))); }
    var srcs: CodeSources = R.unwrap_ok[CodeSources, str](srcs_r);
    var di: u32 = 0;
    for (di < srcs.set.len) {
        val dm: *project.ModuleEntry = ?p.modules[srcs.ids[di]::u32];
        val rd: R.Result[R.Void, str] = query.record_dep(db, query.Q_CODEGEN, key, query.Q_LOWER,
                                                       back_half_key_for(p, dm));
        if (R.is_err[R.Void, str](rd)) {
            sources_dnit(s.alloc, ?srcs);
            ret R.err[query.QueryOutput, fail.Fail](fail.message(R.unwrap_err[R.Void, str](rd)));
        }
        di = di + 1;
    }

    val staged: *of.ObjectImage = m.staged_image;
    if (staged != nil) {
        m.staged_image = nil;
        sources_dnit(s.alloc, ?srcs);
        ret image_handle_encode(alloc, staged);
    }

    val dbg_r: R.Result[codegen.DebugInfo, str] = debug_info_of(p);
    if (R.is_err[codegen.DebugInfo, str](dbg_r)) {
        sources_dnit(s.alloc, ?srcs);
        ret R.err[query.QueryOutput, fail.Fail](fail.message(R.unwrap_err[codegen.DebugInfo, str](dbg_r)));
    }

    val t_cg: ctime.Time = readout.item_begin(p.events);
    val res_cg: R.Result[of.ObjectImage, fail.Fail] = codegen.codegen_module(s, ?p.target, irmod, srcs.set, nil, p.req.placement_policy, R.unwrap_ok[codegen.DebugInfo, str](dbg_r));
    sources_dnit(s.alloc, ?srcs);
    if (R.is_err[of.ObjectImage, fail.Fail](res_cg)) { ret R.err[query.QueryOutput, fail.Fail](R.unwrap_err[of.ObjectImage, fail.Fail](res_cg)); }
    readout.item(p.events, readout.PH_CODEGEN, project.fqn_name(p, m.fqn), t_cg);
    var img: of.ObjectImage = R.unwrap_ok[of.ObjectImage, fail.Fail](res_cg);

    val br: R.Result[*of.ObjectImage, str] = A.allocate[of.ObjectImage](alloc, 1::usize);
    if (R.is_err[*of.ObjectImage, str](br)) {
        obj.dnit(?img);
        ret R.err[query.QueryOutput, fail.Fail](fail.message(R.unwrap_err[*of.ObjectImage, str](br)));
    }
    val box: *of.ObjectImage = R.unwrap_ok[*of.ObjectImage, str](br);
    box[0] = img;
    ret image_handle_encode(alloc, box);
}

pub fun q_codegen_finalize(value: *u8, value_len: u32, alloc: *A.Allocator) {
    if (value == nil || value_len::usize < $size_of(ptr)) { ret; }
    val slot: *ptr = value::ptr::*ptr;
    val r: *of.ObjectImage = slot[0]::*of.ObjectImage;
    if (r == nil) { ret; }
    obj.dnit(r);
    A.deallocate[of.ObjectImage](alloc, r, 1::usize);
}

fun image_handle_encode(alloc: *A.Allocator, r: *of.ObjectImage) R.Result[query.QueryOutput, fail.Fail] {
    val n: u32 = $size_of(ptr)::u32;
    val rb: R.Result[*u8, str] = A.allocate[u8](alloc, n::usize);
    if (R.is_err[*u8, str](rb)) {
        obj.dnit(r);
        A.deallocate[of.ObjectImage](alloc, r, 1::usize);
        ret R.err[query.QueryOutput, fail.Fail](fail.message(R.unwrap_err[*u8, str](rb)));
    }
    val buf: *u8 = R.unwrap_ok[*u8, str](rb);
    val slot: *ptr = buf::ptr::*ptr;
    slot[0] = r::ptr;
    var out: query.QueryOutput;
    out.bytes = buf;
    out.len   = n;
    ret R.ok[query.QueryOutput, fail.Fail](out);
}

fun image_handle_decode(e: *query.QueryEntry) *of.ObjectImage {
    if (e.value == nil || e.value_len::usize < $size_of(ptr)) { ret nil; }
    val slot: *ptr = e.value::ptr::*ptr;
    ret slot[0]::*of.ObjectImage;
}

pub fun run_link_pass(p: *project.Project) R.Result[bool, outcome.Fail] {
    if (!query.is_registered(?p.s.queries, query.Q_LINK)) {
        val rln: R.Result[R.Void, str] = query.register_derived(?p.s.queries, query.Q_LINK);
        if (R.is_err[R.Void, str](rln)) { ret R.err[bool, outcome.Fail](outcome.internal(R.unwrap_err[R.Void, str](rln))); }
    }

    val prior: query.Revision = query.peek_revision(?p.s.queries, query.Q_LINK, 0);
    val e_r: R.Result[*query.QueryEntry, fail.Fail] = query.get[project.Project](?p.queries, p, query.Q_LINK, 0);
    if (R.is_err[*query.QueryEntry, fail.Fail](e_r)) { ret R.err[bool, outcome.Fail](outcome.from_fail(R.unwrap_err[*query.QueryEntry, fail.Fail](e_r))); }
    val now: query.Revision = R.unwrap_ok[*query.QueryEntry, fail.Fail](e_r).last_changed;
    ret R.ok[bool, outcome.Fail](now != prior);
}

pub fun q_link_compute(p: *project.Project, key: u64, alloc: *A.Allocator) R.Result[query.QueryOutput, fail.Fail] {
    val db: *query.QueryDb = ?p.s.queries;
    val s: *session.Session = p.s;

    var fb: dq.FpBuf;
    fb.alloc = alloc;
    fb.buf   = nil;
    fb.len   = 0;
    fb.cap   = 0;

    val rt: R.Result[query.Revision, str] = query.record_dep_rev(db, query.Q_LINK, key, query.Q_TARGET, 0);
    if (R.is_err[query.Revision, str](rt)) { ret link_fp_fail(?fb, alloc, R.unwrap_err[query.Revision, str](rt)); }
    val wt: R.Result[R.Void, str] = dq.fp_u64(?fb, R.unwrap_ok[query.Revision, str](rt));
    if (R.is_err[R.Void, str](wt)) { ret link_fp_fail(?fb, alloc, R.unwrap_err[R.Void, str](wt)); }

    val rc: R.Result[query.Revision, str] = query.record_dep_rev(db, query.Q_LINK, key, query.Q_LINK_CONFIG, 0);
    if (R.is_err[query.Revision, str](rc)) { ret link_fp_fail(?fb, alloc, R.unwrap_err[query.Revision, str](rc)); }
    val wc: R.Result[R.Void, str] = dq.fp_u64(?fb, R.unwrap_ok[query.Revision, str](rc));
    if (R.is_err[R.Void, str](wc)) { ret link_fp_fail(?fb, alloc, R.unwrap_err[R.Void, str](wc)); }

    val wn: R.Result[R.Void, str] = dq.fp_u32(?fb, p.emit_len);
    if (R.is_err[R.Void, str](wn)) { ret link_fp_fail(?fb, alloc, R.unwrap_err[R.Void, str](wn)); }
    var i: u32 = 0;
    for (i < p.emit_len) {
        val m: *project.ModuleEntry = ?p.modules[(p.topo[i])::u32];
        val rd: R.Result[query.Revision, str] = query.record_dep_rev(db, query.Q_LINK, key, query.Q_CODEGEN, back_half_key_for(p, m));
        if (R.is_err[query.Revision, str](rd)) { ret link_fp_fail(?fb, alloc, R.unwrap_err[query.Revision, str](rd)); }
        val wm: R.Result[R.Void, str] = dq.fp_u64(?fb, R.unwrap_ok[query.Revision, str](rd));
        if (R.is_err[R.Void, str](wm)) { ret link_fp_fail(?fb, alloc, R.unwrap_err[R.Void, str](wm)); }
        i = i + 1;
    }

    ret fail.lift[query.QueryOutput](dq.fp_take(?fb));
}

fun link_fp_fail(fb: *dq.FpBuf, alloc: *A.Allocator, msg: str) R.Result[query.QueryOutput, fail.Fail] {
    if (fb.buf != nil && fb.cap > 0) { A.deallocate[u8](alloc, fb.buf, fb.cap::usize); }
    ret R.err[query.QueryOutput, fail.Fail](fail.message(msg));
}

fun fp_typed_surface(fb: *dq.FpBuf, s: *session.Session, mid: session.ModuleId, rr: *resolve.ResolveResult, sr: *sema.SemaResult) R.Result[R.Void, str] {
    val pc: R.Result[R.Void, str] = dq.fp_u32(fb, rr.pub_count);
    if (R.is_err[R.Void, str](pc)) { ret pc; }
    if (rr.symbols == nil)       { ret R.ok_void[str](); }

    var i: u32 = 0;
    for (i < rr.pub_count) {
        val sym: *resolve.Symbol = ?rr.symbols[i];
        val rk: R.Result[R.Void, str] = dq.fp_u8(fb, sym.kind::u8);    if (R.is_err[R.Void, str](rk)) { ret rk; }
        val rn: R.Result[R.Void, str] = dq.fp_u32(fb, sym.name::u32);  if (R.is_err[R.Void, str](rn)) { ret rn; }
        if (sym.origin == mid && sym.decl::u32 < sr.decl_count) {
            val ty: type.TypeId = sr.decl_type[sym.decl];
            val rty: R.Result[R.Void, str] = dq.fp_u32(fb, ty::u32);   if (R.is_err[R.Void, str](rty)) { ret rty; }
            val rf:  R.Result[R.Void, str] = fp_type_fields(fb, s, ty); if (R.is_err[R.Void, str](rf)) { ret rf; }
        }
        or {
            val rty: R.Result[R.Void, str] = dq.fp_u32(fb, 0xFFFFFFFF); if (R.is_err[R.Void, str](rty)) { ret rty; }
            val rf:  R.Result[R.Void, str] = dq.fp_u32(fb, 0);          if (R.is_err[R.Void, str](rf)) { ret rf; }
        }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

fun fp_type_fields(fb: *dq.FpBuf, s: *session.Session, ty: type.TypeId) R.Result[R.Void, str] {
    if (ty == type.TYPE_NIL || ty == type.TYPE_ERROR) { ret dq.fp_u32(fb, 0); }
    val ft_opt: O.Option[*type.FieldTable] = type.field_table_for(?s.types, ty);
    if (O.is_none[*type.FieldTable](ft_opt)) { ret dq.fp_u32(fb, 0); }
    val ft: *type.FieldTable = O.unwrap[*type.FieldTable](ft_opt);
    val rc: R.Result[R.Void, str] = dq.fp_u32(fb, ft.fields_len);
    if (R.is_err[R.Void, str](rc)) { ret rc; }
    var i: u32 = 0;
    for (i < ft.fields_len) {
        val fe: *type.FieldEntry = type.field_entry_at(?s.types, ft, i);
        val rn: R.Result[R.Void, str] = dq.fp_u32(fb, fe.name::u32); if (R.is_err[R.Void, str](rn)) { ret rn; }
        val rt: R.Result[R.Void, str] = dq.fp_u32(fb, fe.ty::u32);   if (R.is_err[R.Void, str](rt)) { ret rt; }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

pub fun set_build_config_input(p: *project.Project) R.Result[R.Void, str] {
    var fb: dq.FpBuf;
    fb.alloc = p.s.alloc;
    fb.buf   = nil;
    fb.len   = 0;
    fb.cap   = 0;

    val w: R.Result[R.Void, str] = write_build_config(?fb, p);
    if (R.is_err[R.Void, str](w)) {
        if (fb.buf != nil && fb.cap > 0) { A.deallocate[u8](p.s.alloc, fb.buf, fb.cap::usize); }
        ret w;
    }

    val fl: R.Result[u32, str] = dq.fp_input_len(?fb);
    if (R.is_err[u32, str](fl)) {
        dq.fp_free(?fb);
        ret R.err[R.Void, str](R.unwrap_err[u32, str](fl));
    }
    val si: R.Result[R.Void, str] = query.set_input(?p.s.queries, query.Q_TARGET, 0, fb.buf, R.unwrap_ok[u32, str](fl));
    if (fb.buf != nil && fb.cap > 0) { A.deallocate[u8](p.s.alloc, fb.buf, fb.cap::usize); }
    ret si;
}

fun write_build_config(fb: *dq.FpBuf, p: *project.Project) R.Result[R.Void, str] {
    var digest: [32]u8;
    val hr: R.Result[R.Void, str] = request.semantic_hash(p.s.alloc, ?p.req, ?digest[0]);
    if (R.is_err[R.Void, str](hr)) { ret hr; }
    val ah: R.Result[R.Void, str] = dq.fp_bytes(fb, ?digest[0], request.HASH_SIZE::u32);
    if (R.is_err[R.Void, str](ah)) { ret ah; }

    val tf: R.Result[R.Void, str] = write_target_fingerprint(fb, p);
    if (R.is_err[R.Void, str](tf)) { ret tf; }

    val a5: R.Result[R.Void, str] = dq.fp_u32(fb, p.target_entry.os_name::u32);  if (R.is_err[R.Void, str](a5)) { ret a5; }
    val a6: R.Result[R.Void, str] = dq.fp_u32(fb, p.target_entry.isa_name::u32); if (R.is_err[R.Void, str](a6)) { ret a6; }
    val a7: R.Result[R.Void, str] = dq.fp_u32(fb, p.target_entry.abi_name::u32); if (R.is_err[R.Void, str](a7)) { ret a7; }
    val apl: R.Result[R.Void, str] = dq.fp_u32(fb, p.target_entry.platform_name::u32); if (R.is_err[R.Void, str](apl)) { ret apl; }
    val a8: R.Result[R.Void, str] = dq.fp_u32(fb, p.config.id::u32);      if (R.is_err[R.Void, str](a8)) { ret a8; }
    val a9: R.Result[R.Void, str] = dq.fp_u32(fb, p.config.version::u32); if (R.is_err[R.Void, str](a9)) { ret a9; }
    val aa: R.Result[R.Void, str] = dq.fp_u32(fb, p.config.name::u32);    if (R.is_err[R.Void, str](aa)) { ret aa; }
    val ab: R.Result[R.Void, str] = dq.fp_u32(fb, p.config.bin_name::u32); if (R.is_err[R.Void, str](ab)) { ret ab; }

    val ac: R.Result[R.Void, str] = dq.fp_u32(fb, p.config.define_count); if (R.is_err[R.Void, str](ac)) { ret ac; }
    var i: u32 = 0;
    for (i < p.config.define_count) {
        val ad: R.Result[R.Void, str] = dq.fp_u32(fb, p.config.defines[i]::u32);
        if (R.is_err[R.Void, str](ad)) { ret ad; }
        i = i + 1;
    }
    ret write_step_environment(fb, p);
}

fun write_target_fingerprint(fb: *dq.FpBuf, p: *project.Project) R.Result[R.Void, str] {
    var e: binary.Encoder = binary.encoder(p.s.alloc, binary.LITTLE);
    if (!target.fingerprint(?p.target, ?e)) {
        binary.encoder_dnit(?e);
        ret R.err[R.Void, str]("out of memory fingerprinting the selected target");
    }
    if (e.len > 0xFFFFFFFF::usize) {
        binary.encoder_dnit(?e);
        ret R.err[R.Void, str]("target fingerprint exceeds 32-bit length");
    }
    val rl: R.Result[R.Void, str] = dq.fp_u32(fb, e.len::u32);
    if (R.is_err[R.Void, str](rl)) { binary.encoder_dnit(?e); ret rl; }
    val rb: R.Result[R.Void, str] = dq.fp_bytes(fb, e.data, e.len::u32);
    binary.encoder_dnit(?e);
    ret rb;
}

fun write_step_environment(fb: *dq.FpBuf, p: *project.Project) R.Result[R.Void, str] {
    val rc: R.Result[R.Void, str] = dq.fp_u32(fb, p.config.step_count);
    if (R.is_err[R.Void, str](rc)) { ret rc; }
    var si: u32 = 0;
    for (si < p.config.step_count) {
        val st: *manifest.StepDef = ?p.config.steps[si];
        val rn: R.Result[R.Void, str] = dq.fp_u32(fb, st.name::u32);  if (R.is_err[R.Void, str](rn)) { ret rn; }
        val re: R.Result[R.Void, str] = dq.fp_u32(fb, st.env_count);  if (R.is_err[R.Void, str](re)) { ret re; }
        var ei: u32 = 0;
        for (ei < st.env_count) {
            val rk: R.Result[R.Void, str] = dq.fp_u32(fb, st.env_keys[ei]::u32);   if (R.is_err[R.Void, str](rk)) { ret rk; }
            val rv: R.Result[R.Void, str] = dq.fp_u32(fb, st.env_values[ei]::u32); if (R.is_err[R.Void, str](rv)) { ret rv; }
            ei = ei + 1;
        }
        si = si + 1;
    }
    if (p.config.step_count == 0 && p.config.dep_count == 0) { ret dq.fp_u32(fb, 0); }
    val inherited: **u8 = env.environ();
    if (inherited == nil) { ret R.err[R.Void, str]("planner environment unavailable"); }
    ret write_planner_environment(fb, inherited);
}


# planner inputs cover child inheritance and executable lookup for root and dependency steps
fun write_planner_environment(fb: *dq.FpBuf, inherited: **u8) R.Result[R.Void, str] {
    val captured: R.Result[step_env.Environment, str] = step_env.capture(fb.alloc, inherited);
    if (R.is_err[step_env.Environment, str](captured)) { ret R.err[R.Void, str](R.unwrap_err[step_env.Environment, str](captured)); }
    var environment: step_env.Environment = R.unwrap_ok[step_env.Environment, str](captured);
    fin { step_env.dnit(?environment); }
    val exported: R.Result[step_env.Strings, str] = step_env.to_strings(?environment);
    if (R.is_err[step_env.Strings, str](exported)) { ret R.err[R.Void, str](R.unwrap_err[step_env.Strings, str](exported)); }
    var strings: step_env.Strings = R.unwrap_ok[step_env.Strings, str](exported);
    fin { step_env.strings_free(fb.alloc, ?strings); }
    val count: R.Result[R.Void, str] = dq.fp_u32(fb, strings.count);
    if (R.is_err[R.Void, str](count)) { ret count; }
    var i: u32 = 0;
    for (i < strings.count) {
        val entry: R.Result[R.Void, str] = dq.fp_cstr(fb, strings.items[i]);
        if (R.is_err[R.Void, str](entry)) { ret entry; }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

test "mach.lang.driver.passes.write_build_config:distinguishes_target_identity" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }

    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val rr: R.Result[R.Void, str] = target.register_all(?reg, target_testing.debug_descriptor);
    if (R.is_err[R.Void, str](rr)) { ret 1; }

    val tx: R.Result[target.Target, str] = target.select(?reg, "x86_64", "linux", "sysv64");
    val ta: R.Result[target.Target, str] = target.select(?reg, "aarch64", "linux", "aapcs64");
    if (R.is_err[target.Target, str](tx) || R.is_err[target.Target, str](ta)) { ret 1; }

    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    var te:  project.TargetEntry;
    var cfg: project.ProjectConfig;

    var px: project.Project;
    px.s            = ?s;
    px.req          = request.defaults();
    px.target       = R.unwrap_ok[target.Target, str](tx);
    px.target_entry = ?te;
    px.config       = cfg;

    var pa: project.Project;
    pa.s            = ?s;
    pa.req          = request.defaults();
    pa.target       = R.unwrap_ok[target.Target, str](ta);
    pa.target_entry = ?te;
    pa.config       = cfg;

    var dx: [32]u8;
    var da: [32]u8;
    if (!ut_fp_digest(?alloc, ?px, ?dx[0])) { ret 1; }
    if (!ut_fp_digest(?alloc, ?pa, ?da[0])) { ret 1; }
    if (!ut_digest_differs(?dx[0], ?da[0])) { ret 1; }
    ret 0;
}

fun build_resolve_deps(p: *project.Project, m: *project.ModuleEntry, list: *session.ModuleId) R.Result[resolve.ResolveDeps, str] {
    var deps: resolve.ResolveDeps;
    deps.entries = nil;
    deps.count   = 0;
    if (m.dep_count == 0) { ret R.ok[resolve.ResolveDeps, str](deps); }

    var list_len: u32 = 0;

    var i: u32 = 0;
    for (i < m.dep_count) {
        val d: session.ModuleId = m.deps[i];
        if (d::u32 < p.module_len && !resolve_list_contains(list, list_len, d)) {
            list[list_len] = d;
            list_len = list_len + 1;
        }
        i = i + 1;
    }

    var head: u32 = 0;
    for (head < list_len) {
        add_reexport_targets(p, list[head], list, ?list_len);
        head = head + 1;
    }

    val ar: R.Result[*intern.StrId, str] = A.allocate[intern.StrId](p.s.alloc, list_len::usize);
    if (R.is_err[*intern.StrId, str](ar)) {
        ret R.err[resolve.ResolveDeps, str](R.unwrap_err[*intern.StrId, str](ar));
    }
    val aliases: *intern.StrId = R.unwrap_ok[*intern.StrId, str](ar);
    var alias_n: u32 = 0;
    var ai: u32 = 0;
    for (ai < list_len) {
        aliases[ai] = bare_alias_for_module(p, p.modules[list[ai]::u32].fqn);
        if (aliases[ai] != intern.STR_NIL) { alias_n = alias_n + 1; }
        ai = ai + 1;
    }

    val total: u32 = list_len + alias_n;
    val r: R.Result[*resolve.ModuleExports, str] = A.allocate[resolve.ModuleExports](p.s.alloc, total::usize);
    if (R.is_err[*resolve.ModuleExports, str](r)) {
        A.deallocate[intern.StrId](p.s.alloc, aliases, list_len::usize);
        ret R.err[resolve.ResolveDeps, str](R.unwrap_err[*resolve.ModuleExports, str](r));
    }
    deps.entries = R.unwrap_ok[*resolve.ModuleExports, str](r);
    deps.count   = total;

    var z: u32 = 0;
    for (z < total) {
        deps.entries[z].symbols = nil;
        deps.entries[z].count   = 0;
        z = z + 1;
    }

    var w: u32 = 0;
    var k: u32 = 0;
    for (k < list_len) {
        val dep_id: session.ModuleId = list[k];
        val dep:    *project.ModuleEntry = ?p.modules[dep_id::u32];
        val mx_r: R.Result[resolve.ModuleExports, str] = build_module_exports(p, dep_id, dep);
        if (R.is_err[resolve.ModuleExports, str](mx_r)) {
            free_resolve_deps(p.s.alloc, ?deps);
            A.deallocate[intern.StrId](p.s.alloc, aliases, list_len::usize);
            ret R.err[resolve.ResolveDeps, str](R.unwrap_err[resolve.ModuleExports, str](mx_r));
        }
        deps.entries[w] = R.unwrap_ok[resolve.ModuleExports, str](mx_r);
        w = w + 1;
        if (aliases[k] != intern.STR_NIL) {
            val ax_r: R.Result[resolve.ModuleExports, str] = build_module_exports(p, dep_id, dep);
            if (R.is_err[resolve.ModuleExports, str](ax_r)) {
                free_resolve_deps(p.s.alloc, ?deps);
                A.deallocate[intern.StrId](p.s.alloc, aliases, list_len::usize);
                ret R.err[resolve.ResolveDeps, str](R.unwrap_err[resolve.ModuleExports, str](ax_r));
            }
            var ax: resolve.ModuleExports = R.unwrap_ok[resolve.ModuleExports, str](ax_r);
            ax.path = aliases[k];
            deps.entries[w] = ax;
            w = w + 1;
        }
        k = k + 1;
    }

    A.deallocate[intern.StrId](p.s.alloc, aliases, list_len::usize);

    ret R.ok[resolve.ResolveDeps, str](deps);
}

pub fun module_in_current_project(p: *project.Project, fqn: intern.StrId) bool {
    val fqn_opt: O.Option[str] = intern.lookup(?p.s.interner, fqn);
    if (O.is_none[str](fqn_opt)) { ret false; }
    val fqn_text: str = O.unwrap[str](fqn_opt);

    val pid_opt: O.Option[str] = intern.lookup(?p.s.interner, p.config.id);
    if (O.is_none[str](pid_opt)) { ret false; }
    val proj_id_text: str = O.unwrap[str](pid_opt);

    val fqn_len: usize = str_len(fqn_text);
    var head_end: usize = 0;
    for (head_end < fqn_len && fqn_text[head_end] != '.') { head_end = head_end + 1; }
    ret view_eq_str(view(fqn_text::*char, head_end), proj_id_text);
}

fun bare_alias_for_module(p: *project.Project, mod_fqn: intern.StrId) intern.StrId {
    if (p.config.module != intern.STR_NIL && canonical_module_fqn_is(p, p.config.id, p.config.module, mod_fqn)) {
        ret p.config.id;
    }
    var k: u32 = 0;
    for (k < p.config.dep_count) {
        val dep: *project.DepEntry = ?p.config.deps[k];
        if (dep.project_module != intern.STR_NIL && canonical_module_fqn_is(p, dep.project_id, dep.project_module, mod_fqn)) {
            ret dep.project_id;
        }
        k = k + 1;
    }
    ret intern.STR_NIL;
}

fun canonical_module_fqn_is(p: *project.Project, id: intern.StrId, module: intern.StrId, fqn: intern.StrId) bool {
    val id_opt:  O.Option[str] = intern.lookup(?p.s.interner, id);
    val mod_opt: O.Option[str] = intern.lookup(?p.s.interner, module);
    if (O.is_none[str](id_opt) || O.is_none[str](mod_opt)) { ret false; }
    val cf_r: R.Result[intern.StrId, str] = load.compose_module_fqn(p.alloc, ?p.s.interner, O.unwrap[str](id_opt), O.unwrap[str](mod_opt));
    if (R.is_err[intern.StrId, str](cf_r)) { ret false; }
    ret R.unwrap_ok[intern.StrId, str](cf_r) == fqn;
}

fun add_reexport_targets(p: *project.Project, mid: session.ModuleId, list: *session.ModuleId, list_len: *u32) {
    val dep: *project.ModuleEntry = ?p.modules[mid::u32];
    if (!dep.resolved || dep.resolve_result == nil) { ret; }
    val rr: *resolve.ResolveResult = dep.resolve_result;
    if (rr.symbols == nil) { ret; }
    var i: u32 = 0;
    for (i < rr.pub_count) {
        val s: *resolve.Symbol = ?rr.symbols[i];
        if (s.kind == resolve.SYM_USE) {
            val target_mid: session.ModuleId = s.slot::session.ModuleId;
            if (target_mid::u32 < p.module_len && !resolve_list_contains(list, @list_len, target_mid)) {
                list[@list_len] = target_mid;
                @list_len = @list_len + 1;
            }
        }
        i = i + 1;
    }
}

fun build_module_exports(p: *project.Project, dep_id: session.ModuleId, dep: *project.ModuleEntry) R.Result[resolve.ModuleExports, str] {
    var mx: resolve.ModuleExports;
    mx.path    = dep.fqn;
    mx.module  = dep_id;
    mx.symbols = nil;
    mx.count   = 0;
    if (!dep.resolved || dep.resolve_result == nil || dep.resolve_result.pub_count == 0) {
        ret R.ok[resolve.ModuleExports, str](mx);
    }
    val pcount: u32 = dep.resolve_result.pub_count;
    val r: R.Result[*resolve.PublicSymbol, str] = A.allocate[resolve.PublicSymbol](p.s.alloc, pcount::usize);
    if (R.is_err[*resolve.PublicSymbol, str](r)) { ret R.err[resolve.ModuleExports, str](R.unwrap_err[*resolve.PublicSymbol, str](r)); }
    val syms: *resolve.PublicSymbol = R.unwrap_ok[*resolve.PublicSymbol, str](r);

    var i: u32 = 0;
    for (i < pcount) {
        val sym: *resolve.Symbol = ?dep.resolve_result.symbols[i];
        var ps: resolve.PublicSymbol;
        ps.kind   = sym.kind;
        ps.name   = sym.name;
        ps.canon  = sym.canon;
        ps.decl   = sym.decl;
        ps.slot   = sym.slot;
        ps.origin = sym.origin;
        syms[i] = ps;
        i = i + 1;
    }

    mx.symbols = syms;
    mx.count   = pcount;
    ret R.ok[resolve.ModuleExports, str](mx);
}

fun free_resolve_deps(alloc: *A.Allocator, deps: *resolve.ResolveDeps) {
    if (deps.entries == nil) { ret; }
    var i: u32 = 0;
    for (i < deps.count) {
        val mx: *resolve.ModuleExports = ?deps.entries[i];
        if (mx.symbols != nil && mx.count > 0) {
            A.deallocate[resolve.PublicSymbol](alloc, mx.symbols, mx.count::usize);
        }
        i = i + 1;
    }
    A.deallocate[resolve.ModuleExports](alloc, deps.entries, deps.count::usize);
    deps.entries = nil;
    deps.count   = 0;
}

fun ut_fp_digest(alloc: *A.Allocator, p: *project.Project, out: *u8) bool {
    var fb: dq.FpBuf;
    fb.alloc = alloc;
    fb.buf   = nil;
    fb.len   = 0;
    fb.cap   = 0;
    val w: R.Result[R.Void, str] = write_build_config(?fb, p);
    if (R.is_err[R.Void, str](w)) { dq.fp_free(?fb); ret false; }
    sha256.hash(fb.buf, fb.len, out);
    dq.fp_free(?fb);
    ret true;
}

fun ut_digest_differs(a: *u8, b: *u8) bool {
    var i: usize = 0;
    for (i < 32) {
        if (a[i] != b[i]) { ret true; }
        i = i + 1;
    }
    ret false;
}

test "mach.lang.driver.passes.write_build_config:every_tuple_field_moves_the_fingerprint" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }

    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    if (R.is_err[R.Void, str](target.register_all(?reg, target_testing.debug_descriptor))) { ret 1; }

    val tx_r: R.Result[target.Target, str] = target.select(?reg, "x86_64", "linux", "sysv64");
    val ta_r: R.Result[target.Target, str] = target.select(?reg, "aarch64", "linux", "aapcs64");
    val tw_r: R.Result[target.Target, str] = target.select(?reg, "x86_64", "windows", "win64");
    if (R.is_err[target.Target, str](tx_r) || R.is_err[target.Target, str](ta_r)
        || R.is_err[target.Target, str](tw_r)) { ret 1; }
    val tx: target.Target = R.unwrap_ok[target.Target, str](tx_r);
    val ta: target.Target = R.unwrap_ok[target.Target, str](ta_r);
    val tw: target.Target = R.unwrap_ok[target.Target, str](tw_r);

    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    fin { session.dnit(?s); }

    var te:  project.TargetEntry;
    var cfg: project.ProjectConfig;

    var base: project.Project;
    base.s            = ?s;
    base.req          = request.defaults();
    base.req.profile  = "debug";
    base.target       = tx;
    base.target_entry = ?te;
    base.config       = cfg;

    val N: usize = 11;
    var digests: [11][32]u8;
    if (!ut_fp_digest(?alloc, ?base, ?digests[0][0])) { ret 1; }

    var v: project.Project = base;
    v.target.arch_id = ta.arch_id;
    if (!ut_fp_digest(?alloc, ?v, ?digests[1][0])) { ret 1; }

    v = base; v.target.abi_id = ta.abi_id;
    if (!ut_fp_digest(?alloc, ?v, ?digests[2][0])) { ret 1; }

    v = base; v.target.os_id = tw.os_id;
    if (!ut_fp_digest(?alloc, ?v, ?digests[3][0])) { ret 1; }

    v = base; v.target.of = tw.of;
    if (!ut_fp_digest(?alloc, ?v, ?digests[4][0])) { ret 1; }

    v = base; v.target.debug_id = base.target.debug_id + 1;
    if (!ut_fp_digest(?alloc, ?v, ?digests[5][0])) { ret 1; }

    v = base; v.target.stack_reserve = base.target.stack_reserve + 0x1000;
    if (!ut_fp_digest(?alloc, ?v, ?digests[6][0])) { ret 1; }

    v = base; v.target.stack_commit = base.target.stack_commit + 0x1000;
    if (!ut_fp_digest(?alloc, ?v, ?digests[7][0])) { ret 1; }

    v = base; v.req.profile = "release";
    if (!ut_fp_digest(?alloc, ?v, ?digests[8][0])) { ret 1; }

    var define_ids: [1]intern.StrId;
    define_ids[0] = 7;
    v = base;
    v.config.defines      = ?define_ids[0];
    v.config.define_count = 1;
    if (!ut_fp_digest(?alloc, ?v, ?digests[9][0])) { ret 1; }

    var env_keys:   [1]intern.StrId;
    var env_values: [1]intern.StrId;
    env_keys[0]   = 11;
    env_values[0] = 13;
    var steps: [1]manifest.StepDef;
    steps[0].name       = 17;
    steps[0].env_keys   = ?env_keys[0];
    steps[0].env_values = ?env_values[0];
    steps[0].env_count  = 1;
    v = base;
    v.config.steps      = ?steps[0];
    v.config.step_count = 1;
    if (!ut_fp_digest(?alloc, ?v, ?digests[10][0])) { ret 1; }

    var i: usize = 0;
    for (i < N) {
        var j: usize = i + 1;
        for (j < N) {
            if (!ut_digest_differs(?digests[i][0], ?digests[j][0])) { ret 1; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret 0;
}


fun t_planner_environment_digest(a: *A.Allocator, inherited: **u8, digest: *u8) bool {
    var fb: dq.FpBuf;
    fb.alloc = a;
    fb.buf = nil;
    fb.len = 0;
    fb.cap = 0;
    fin { dq.fp_free(?fb); }
    val written: R.Result[R.Void, str] = write_planner_environment(?fb, inherited);
    if (R.is_err[R.Void, str](written)) { ret false; }
    sha256.hash(fb.buf, fb.len, digest);
    ret true;
}

test "mach.lang.driver.passes: planner environment cache input tracks values and ignores entry order" {
    var a: A.Allocator;
    if (O.is_some[str](page.make(?a))) { ret 1; }
    var entries: [4]usize;
    entries[0] = ("MACH_3146_B=two")::usize;
    entries[1] = ("MACH_3146_A=one")::usize;
    entries[2] = ("MACH_3146_A=ignored duplicate")::usize;
    entries[3] = 0;
    var initial: [32]u8;
    if (!t_planner_environment_digest(?a, (?entries[0])::**u8, ?initial[0])) { ret 2; }
    entries[0] = ("MACH_3146_A=one")::usize;
    entries[1] = ("MACH_3146_B=two")::usize;
    entries[2] = 0;
    var reordered: [32]u8;
    if (!t_planner_environment_digest(?a, (?entries[0])::**u8, ?reordered[0])) { ret 3; }
    if (ut_digest_differs(?initial[0], ?reordered[0])) { ret 4; }
    entries[1] = ("MACH_3146_B=changed inherited value")::usize;
    var changed: [32]u8;
    if (!t_planner_environment_digest(?a, (?entries[0])::**u8, ?changed[0])) { ret 5; }
    if (!ut_digest_differs(?initial[0], ?changed[0])) { ret 6; }
    ret 0;
}
