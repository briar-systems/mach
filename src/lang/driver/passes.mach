# a module's code lowered into a mirl module on a heap of its own, with the facts its lowering
# kept, keyed by its back-half key. its codegen takes it, compiles it and gives its value back,
# so it is read once
pub val LOWER: query.Kind = query.Kind{
    name:     "lower", role: query.DERIVED, owner: query.KEY_MODULE, origin: diagnostic.ORIGIN_LOWER, compute: lower_compute,
    finalize: lowered_finalize, replay: true
};
# the symbols a module's lowered code defines under a binding other objects see, keyed by its
# back-half key: each one's session id, a little-endian u32, and none for a module that declares
# no tests. read from its lowering before its codegen spends it, or from the record of the object
# the cache restored, so the module's test object, which declares them, reads its normal module's
# lowering and never its compiled object
pub val DEFINED: query.Kind = query.Kind{name: "defined", role: query.DERIVED, owner: query.KEY_MODULE, origin: diagnostic.ORIGIN_LOWER, compute: defined_compute};
# a module's object, mink's, and the facts its lowering kept, keyed by its back-half key: its
# lowered module compiled
pub val CODEGEN: query.Kind = query.Kind{
    name:     "codegen", role: query.DERIVED, owner: query.KEY_MODULE, origin: diagnostic.ORIGIN_CODEGEN, compute: codegen_compute,
    finalize: codegen_finalize, replay: true
};
# one instance typed on its own (sema_product.InstanceResult), keyed by the session's id of its
# symbol, which is its identity: it reads its declaring module's typed definition and the typed
# surfaces instance_deps names, never a module that asks for it
pub val INSTANCE_SEMA: query.Kind = query.Kind{
    name:     "instance sema", role: query.DERIVED, owner: query.KEY_UNOWNED, origin: diagnostic.ORIGIN_SEMA, compute: instance_sema_compute,
    finalize: instance_sema_finalize
};
# every instance the build's modules ask for, closed through what each instance's body asks for,
# and the instance unit each emitted one falls in (driver/demand): an instance is emitted when the
# code of a module the build compiles reaches it, and in a test build when its tests do. the
# reports of every instance it typed are placed and reported here. a demand equal to the last
# keeps its revision, so a module that starts or stops using an instance another module also
# uses changes no unit. it reads the cell's records as well (cache.DEMAND_RECORDS)
pub val INSTANCE_DEMAND: query.Kind = query.Kind{
    name:     "instance demand", role: query.DERIVED, owner: query.KEY_UNOWNED, origin: diagnostic.ORIGIN_SEMA, compute: instance_demand_compute,
    finalize: instance_demand_finalize, equal: instance_demand_equal
};
# one instance unit's members, keyed by the unit's key: each member's symbol, in the order the
# unit lowers them. equal bytes keep the revision, so the demand moving elsewhere leaves the
# unit's object alone
pub val UNIT_DEMAND: query.Kind = query.Kind{name: "unit demand", role: query.DERIVED, owner: query.KEY_UNIT, origin: diagnostic.ORIGIN_LOWER, compute: unit_demand_compute};
# an instance unit's members lowered from their own typing into a mirl module, keyed by the
# unit's key, read once by its codegen as a module's lowering is
pub val UNIT_LOWER: query.Kind = query.Kind{
    name:     "unit lower", role: query.DERIVED, owner: query.KEY_UNIT, origin: diagnostic.ORIGIN_LOWER, compute: unit_lower_compute,
    finalize: lowered_finalize, replay: true
};
# an instance unit's object and the facts its lowering kept, keyed by the unit's key: its
# lowered unit compiled, as a module's codegen does
pub val UNIT_CODEGEN: query.Kind = query.Kind{
    name:     "unit codegen", role: query.DERIVED, owner: query.KEY_UNIT, origin: diagnostic.ORIGIN_CODEGEN, compute: unit_codegen_compute,
    finalize: codegen_finalize
};
# the build's artifact, written by the link job from the current objects. its product is the
# artifact's path and the digest of the bytes written, and it reruns only when an input moved
pub val LINK: query.Kind = query.Kind{name: "link", role: query.DERIVED, owner: query.KEY_UNOWNED, origin: diagnostic.ORIGIN_LINK, compute: link_compute};
# what the link is configured with beyond the build context, set by the build
pub val LINK_CONFIG: query.Kind = query.Kind{name: "link config", role: query.INPUT, owner: query.KEY_UNOWNED};
# moves whenever the artifact on disk is not the one the link last wrote, so a missing or
# overwritten artifact is linked again
pub val LINK_ARTIFACT: query.Kind = query.Kind{name: "link artifact", role: query.INPUT, owner: query.KEY_UNOWNED};

# a rejected module is one module's answer, so the pass folds it and carries
# on over the rest; an internal failure ends the pass where it met it
pub fun run_resolve_pass(p: *project.Project) err[fail.Fail] {
    var rejected: bool = false;
    var i:        u32  = 0;
    for (i < p.topo_len) {
        val mid: module.ModuleId = p.topo[i];
        if (project.module_at(p, mid::u32).frontend_skipped) {
            i = i + 1;
            cnt;
        }
        val r: err[fail.Fail] = run_resolve_one(p, mid);
        if (sel r.err) {
            if (!fail.is_reported(r.err)) { ret r; }
            rejected = true;
        }
        i = i + 1;
    }
    if (rejected) { ret err[fail.Fail].err{fail.reported()}; }
    ret err[fail.Fail].ok{};
}

fun run_resolve_one(p: *project.Project, mid: module.ModuleId) err[fail.Fail] {
    val m: *project.ModuleEntry = project.module_at(p, mid::u32);

    val t_item: readout.Instant = readout.item_begin(p.progress);

    val resolved: res[*resolve.ResolveResult, fail.Fail] = frontend.resolution(p, m);
    if (sel resolved.err) { ret err[fail.Fail].err{resolved.err}; }

    val ex_r: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, ?frontend.EXPORTS, module.stable_index(m.stable_id)::u64);
    if (sel ex_r.err) { ret err[fail.Fail].err{ex_r.err}; }

    readout.item(p.progress, readout.RESOLVE, intern.text(?p.s.interner, m.fqn), t_item);
    ret err[fail.Fail].ok{};
}

# a rejected module is one module's answer, so the pass folds it and carries
# on over the rest; an internal failure ends the pass where it met it
pub fun run_sema_pass(p: *project.Project) err[fail.Fail] {
    readout.phase_begin(p.progress, readout.SEMA);
    var rejected: bool = false;
    var i:        u32  = 0;
    for (i < p.topo_len) {
        val mid: module.ModuleId = p.topo[i];
        if (project.module_at(p, mid::u32).frontend_skipped) {
            i = i + 1;
            cnt;
        }
        val r: err[fail.Fail] = run_sema_one(p, mid);
        if (sel r.err) {
            if (!fail.is_reported(r.err)) { ret err[fail.Fail].err{r.err}; }
            rejected = true;
        }
        i = i + 1;
    }
    # every instance the modules ask for is typed once they are all typed, and the instance
    # records follow what the demand found
    val demanded: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, ?INSTANCE_DEMAND, 0);
    if (sel demanded.err) {
        if (!fail.is_reported(demanded.err)) { ret err[fail.Fail].err{demanded.err}; }
        rejected = true;
    }
    if (sel demanded.ok) {
        val stored: err[fail.Fail] = cache.store_records(p, handle_decode(demanded.ok)::*demand.Demand);
        if (sel stored.err) { ret stored; }
    }
    readout.phase_end(p.progress, readout.SEMA, cache.frontend_count(p), "module", "modules");
    if (rejected) { ret err[fail.Fail].err{fail.reported()}; }
    ret err[fail.Fail].ok{};
}

fun run_sema_one(p: *project.Project, mid: module.ModuleId) err[fail.Fail] {
    val m: *project.ModuleEntry = project.module_at(p, mid::u32);

    val t_item: readout.Instant = readout.item_begin(p.progress);

    val acquired: res[sema_product.Definition, fail.Fail] = frontend.read_definition(p::ptr, mid, sema_product.DEFINITION_TYPED);
    if (sel acquired.err) { ret err[fail.Fail].err{acquired.err}; }

    val tx_r: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, ?frontend.TYPED_EXPORTS, module.stable_index(m.stable_id)::u64);
    if (sel tx_r.err) { ret err[fail.Fail].err{tx_r.err}; }

    readout.item(p.progress, readout.SEMA, intern.text(?p.s.interner, m.fqn), t_item);
    ret err[fail.Fail].ok{};
}

# every module the load reached, gated out or not, is held under the session's active retainer: the
# project borrows each one's parse. a load closes its retainer's round unless a caller keeps the round
# open across builds, and then whatever no retainer holds is retired
pub fun retain_modules(p: *project.Project, rejected: bool) err[fail.Fail] {
    val t:  *retention.Retention = ?p.s.retention;
    val id: retention.RetainerId = t.active;
    if (rejected) { retention.reject(t, id); }
    var i: u32 = 0;
    for (i < project.module_count(p)) {
        val m: *project.ModuleEntry = project.module_at(p, i);
        if (!module.stable_is_nil(m.stable_id)) {
            val recorded: err[fail.Fail] = retention.record(t, id, m.stable_id, m.file_id, rejected);
            if (sel recorded.err) { ret recorded; }
        }
        i = i + 1;
    }
    val ended: err[fail.Fail] = retention.end_round(t, id, true);
    if (sel ended.err) { ret ended; }
    ret retention.retire(t, ?p.s.queries);
}

# a module's lowering and codegen products are keyed by its stable id, and by the
# test bit for its test object
pub fun back_half_key(stable: module.StableModuleId, test_object: bool) u64 {
    var k: u64 = module.stable_index(stable)::u64;
    if (test_object) { k = k | cache.TEST_KEY_BIT; }
    ret k;
}

pub fun back_half_key_is_test(key: u64) bool {
    ret (key & cache.TEST_KEY_BIT) != 0;
}

# the normal object's key, the same in every build that compiles the module
pub fun back_half_key_for(p: *project.Project, m: *project.ModuleEntry) u64 {
    ret back_half_key(m.stable_id, false);
}

pub fun test_key_for(m: *project.ModuleEntry) u64 {
    ret cache.test_input_key(m);
}

# the module gets a test object in this build: a test build, and a module whose
# source declares a test or a `#[testing]` declaration
pub fun has_test_object(p: *project.Project, m: *project.ModuleEntry) bool {
    ret cache.has_test_object(p, m);
}

pub fun codegen_reusable(p: *project.Project, mid: module.ModuleId) res[bool, fail.Fail] {
    val m:        *project.ModuleEntry = project.module_at(p, mid::u32);
    val reusable: res[bool, fail.Fail] = query.reusable[project.Project](?p.queries, p, ?CODEGEN, back_half_key_for(p, m));
    if (sel reusable.err) { ret reusable; }
    if (reusable.ok)      { ret reusable; }
    ret res[bool, fail.Fail].ok{cache.restored(p, m)};
}

pub fun test_build(p: *project.Project) bool {
    ret request.test_goal(p.req.goal);
}

# the artifact this build links is a shared library. a test build compiles the
# library's own objects, so it lowers them the way the library's build does
fun shared_artifact_build(p: *project.Project) bool {
    if (p.req.goal != request.GOAL_ARTIFACT && !test_build(p)) { ret false; }
    if (p.target_entry == nil)                                 { ret false; }
    ret lang_target.is_row(p.target_entry.kind, ?mink_output.SHARED);
}

# whether the build's objects are the members of a static archive, as the artifact keyed with
# them states, whatever the goal
fun archive_build(p: *project.Project) bool {
    if (p.target_entry == nil) { ret false; }
    ret lang_target.is_row(p.target_entry.kind, ?mink_output.ARCHIVE);
}

# the import libraries the declarations name, which every lowering reads, registered before any is
pub fun prepare_codegen_pass(p: *project.Project) err[fail.Fail] {
    val imports: err[fail.Fail] = declared.register_import_libraries(p);
    if (sel imports.err) { ret err[fail.Fail].err{fail.as_user(diagnostic_kind.LINK_IMPORT_LIBRARY, imports.err)}; }
    ret err[fail.Fail].ok{};
}

fun acquire_frontend_inputs(p: *project.Project) err[fail.Fail] {
    var i: u32 = 0;
    for (i < p.topo_len) {
        # a released module's object is final for this build, and no lowering reads it again
        val m: *project.ModuleEntry = project.module_at(p, p.topo[i]::u32);
        if (m.frontend_skipped || m.released) {
            i = i + 1;
            cnt;
        }
        val acquired: res[sema_product.Definition, fail.Fail] = frontend.read_definition(p::ptr, p.topo[i], sema_product.DEFINITION_TYPED);
        # reading the typed definition makes the module's lowering scope, before any worker reads one
        if (sel acquired.err) { ret err[fail.Fail].err{acquired.err}; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# the module the back-half key `key` names, loaded this build
fun keyed_module(p: *project.Project, key: u64) res[module.ModuleId, fail.Fail] {
    val stable: module.StableModuleId = key::u32::module.StableModuleId;
    val mid:    module.ModuleId       = module.module_id_for_stable(?p.s.modules, stable);
    if (module.is_nil(mid)) { ret res[module.ModuleId, fail.Fail].err{fail.message("lower: stable id not loaded this build")}; }
    ret res[module.ModuleId, fail.Fail].ok{mid};
}

# the symbols the module's normal object defines, which its test object declares
fun normal_object_of(p: *project.Project, m: *project.ModuleEntry) res[lower_context.NormalObject, fail.Fail] {
    var names: collections_vector.Vector[intern.StrId] = collections_vector.init[intern.StrId](p.s.backing);
    fin { collections_vector.dnit[intern.StrId](?names); }
    val read: err[fail.Fail] = defined_of(p, m, ?names);
    if (sel read.err) { ret res[lower_context.NormalObject, fail.Fail].err{read.err}; }
    var normal: lower_context.NormalObject = lower_context.NormalObject{defined: map.init[intern.StrId, bool](p.s.alloc)};
    var i:      usize                      = 0;
    for (i < names.len) {
        val added: res[bool, A.Error] = map.insert[intern.StrId, bool](?normal.defined, names.data[i], true);
        if (sel added.err) {
            map.dnit[intern.StrId, bool](?normal.defined);
            ret res[lower_context.NormalObject, fail.Fail].err{fail.refused(added.err)};
        }
        i = i + 1;
    }
    ret res[lower_context.NormalObject, fail.Fail].ok{normal};
}

# the symbols the module `m` defines, as its DEFINED product holds them, pushed onto `into`
fun defined_of(p: *project.Project, m: *project.ModuleEntry, into: *collections_vector.Vector[intern.StrId]) err[fail.Fail] {
    val got: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, ?DEFINED, back_half_key_for(p, m));
    if (sel got.err) { ret err[fail.Fail].err{got.err}; }
    var r: wire.Source = wire.source(got.ok.value, got.ok.value_len::usize);
    var i: u32         = 0;
    for (i < got.ok.value_len / 4) {
        val pushed: res[usize, A.Error] = collections_vector.push[intern.StrId](into, intern.str_id(wire.take_u32(?r)));
        if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# a module's defined symbols: its restored object's record's, or its lowering's when it declares
# tests. a lowering already compiled has given its module back, so this is read before its codegen
fun defined_compute(raw: ptr, kind: *query.Kind, key: u64, alloc: *A.Allocator, diags: *diagnostic.DiagnosticStore) res[query.QueryOutput, fail.Fail] {
    val p:     *project.Project                = raw::*project.Project;
    val keyed: res[module.ModuleId, fail.Fail] = keyed_module(p, key);
    if (sel keyed.err) { ret res[query.QueryOutput, fail.Fail].err{keyed.err}; }
    val m:  *project.ModuleEntry = project.module_at(p, keyed.ok::u32);
    var fb: wire.Sink            = wire.grown(alloc);
    fin { wire.dnit(?fb); }
    if (cache.restored(p, m)) {
        var i: u32 = 0;
        for (i < m.staged_facts.defined_count) {
            wire.put_u32(?fb, intern.str_index(m.staged_facts.defined[i]));
            i = i + 1;
        }
        ret codec.output(?fb);
    }
    val got: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, ?LOWER, key);
    if (sel got.err) { ret res[query.QueryOutput, fail.Fail].err{got.err}; }
    val l: *Lowering = handle_decode(got.ok)::*Lowering;
    if (l.taken)  { ret res[query.QueryOutput, fail.Fail].err{fail.message("defined: the module's lowering was compiled before its symbols were read")}; }
    if (!l.tests) { ret codec.output(?fb); }
    var names: collections_vector.Vector[intern.StrId] = collections_vector.init[intern.StrId](p.s.backing);
    fin { collections_vector.dnit[intern.StrId](?names); }
    val gathered: err[fail.Fail] = gather_defined(p, ?l.lowered.m, ?names);
    if (sel gathered.err) { ret res[query.QueryOutput, fail.Fail].err{gathered.err}; }
    var i: usize = 0;
    for (i < names.len) {
        wire.put_u32(?fb, intern.str_index(names.data[i]));
        i = i + 1;
    }
    ret codec.output(?fb);
}

# a lowering product: the unit lowered and what its lowering kept of the module's typing for its
# cache record, until its codegen takes them
# ---
# asked: every instance the module's code asks for, as its typing found them; none for a test object or a unit
# tests: the module declares tests, so DEFINED reads the symbols its lowered module defines
# taken: its codegen took the facts and the instances, and compiling spent the module
rec Lowering {
    lowered: *driver_unit.Lowered;
    asked:   collections_vector.Vector[cache_record.Asked];
    tests:   bool;
    taken:   bool;
}

fun lowering_release(raw: ptr, alloc: *A.Allocator) {
    val l: *Lowering = raw::*Lowering;
    if (!l.taken) {
        lower_context.unit_dnit(?l.lowered.facts);
        collections_vector.dnit[cache_record.Asked](?l.asked);
    }
    driver_unit.release(alloc, l.lowered);
    A.deallocate[Lowering](alloc, l, 1);
}

fun lowered_finalize(value: *u8, value_len: u32, alloc: *A.Allocator) {
    lowering_release(handle_decode(query.QueryView{value: value, value_len: value_len}), alloc);
}

# the unit `lowered` made into a lowering product, the instances kept beside it
fun lowering_encode(p: *project.Project, alloc: *A.Allocator, lowered: *driver_unit.Lowered, asked: collections_vector.Vector[cache_record.Asked],
    tests: bool) res[query.QueryOutput, fail.Fail] {
    val boxed: res[*Lowering, A.Error] = A.allocate[Lowering](p.s.alloc, 1);
    if (sel boxed.err) {
        var a: collections_vector.Vector[cache_record.Asked] = asked;
        collections_vector.dnit[cache_record.Asked](?a);
        lower_context.unit_dnit(?lowered.facts);
        driver_unit.release(p.s.alloc, lowered);
        ret res[query.QueryOutput, fail.Fail].err{fail.refused(boxed.err)};
    }
    @boxed.ok = Lowering{lowered: lowered, asked: asked, tests: tests, taken: false};
    ret handle_encode(alloc, boxed.ok::ptr, lowering_release, p.s.alloc);
}

# the instances the module's code asks for, from its typing, as its record keeps them
fun gather_asked(p: *project.Project, m: *project.ModuleEntry, sr: *sema_product.SemaResult, into: *collections_vector.Vector[cache_record.Asked]) err[fail.Fail] {
    val n: u32 = sema_instance.count(?sr.instances);
    var i: u32 = 0;
    for (i < n) {
        val item: *sema_instance.Instance = sema_instance.at(?sr.instances, i);
        if (item.site_file != m.file_id) { ret err[fail.Fail].err{fail.message("cache publication: a module asks for an instance outside its own source")}; }
        val named: res[intern.StrId, fail.Fail] = demand.register(?p.instances, p.s, item);
        if (sel named.err) { ret err[fail.Fail].err{named.err}; }
        val pushed: res[usize, A.Error] = collections_vector.push[cache_record.Asked](into, cache_record.Asked{name: named.ok, reach: item.reach::u8, span: item.site});
        if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# every symbol the lowered module `m` defines, a function with a body or a global with a value,
# under a binding other objects see
fun gather_defined(p: *project.Project, m: *Module, into: *collections_vector.Vector[intern.StrId]) err[fail.Fail] {
    var i: usize = 0;
    for (i < m.functions.len) {
        val f: *mirl_function.Node = ?m.functions.data[i];
        if (f.data.linkage.binding != ?mink_symbol.LOCAL && f.body.blocks.len != 0) {
            val kept: err[fail.Fail] = defined_add(p, m, f.data.name, into);
            if (sel kept.err) { ret kept; }
        }
        i = i + 1;
    }
    i = 0;
    for (i < m.globals.len) {
        val g: *mirl_global.Node = ?m.globals.data[i];
        if (g.data.linkage.binding != ?mink_symbol.LOCAL && sel g.data.initial.some) {
            val kept: err[fail.Fail] = defined_add(p, m, g.data.name, into);
            if (sel kept.err) { ret kept; }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun defined_add(p: *project.Project, m: *Module, n: mink_table.Id[mink_intern.Name], into: *collections_vector.Vector[intern.StrId]) err[fail.Fail] {
    val name:  View                       = mirl_module.name_of(m, n);
    val named: res[intern.StrId, A.Error] = intern.bytes_add(?p.s.interner, name.data::str, name.len);
    if (sel named.err) { ret err[fail.Fail].err{fail.refused(named.err)}; }
    val pushed: res[usize, A.Error] = collections_vector.push[intern.StrId](into, named.ok);
    if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
    ret err[fail.Fail].ok{};
}

# a module's lowering, against its normal object's symbols when it is the module's test object:
# its typed definition and the target are its inputs. a normal module keeps the instances its code
# asks for, and whether it declares tests
fun lower_compute(raw: ptr, kind: *query.Kind, key: u64, alloc: *A.Allocator, diags: *diagnostic.DiagnosticStore) res[query.QueryOutput, fail.Fail] {
    val p:           *project.Project                = raw::*project.Project;
    val s:           *session.Session                = p.s;
    val t_lower:     readout.Instant                 = readout.span_begin(p.progress);
    val test_object: bool                            = back_half_key_is_test(key);
    val keyed:       res[module.ModuleId, fail.Fail] = keyed_module(p, key);
    if (sel keyed.err) { ret res[query.QueryOutput, fail.Fail].err{keyed.err}; }
    val mid:        module.ModuleId                         = keyed.ok;
    val m:          *project.ModuleEntry                    = project.module_at(p, mid::u32);
    val definition: res[sema_product.Definition, fail.Fail] = frontend.read_definition(p::ptr, mid, sema_product.DEFINITION_TYPED);
    if (sel definition.err) { ret res[query.QueryOutput, fail.Fail].err{definition.err}; }
    val d:  sema_product.Definition = definition.ok;
    val rt: err[fail.Fail]          = query.depend[project.Project](?p.queries, p, ?context.TARGET, 0);
    if (sel rt.err) { ret res[query.QueryOutput, fail.Fail].err{rt.err}; }

    # a test object declares what its normal object defines, so it lowers against those symbols
    var normal:      lower_context.NormalObject;
    var normal_from: *lower_context.NormalObject = nil;
    if (test_object) {
        val defined: res[lower_context.NormalObject, fail.Fail] = normal_object_of(p, m);
        if (sel defined.err) { ret res[query.QueryOutput, fail.Fail].err{defined.err}; }
        normal      = defined.ok;
        normal_from = ?normal;
    }
    fin {
        if (normal_from != nil) { map.dnit[intern.StrId, bool](?normal.defined); }
    }
    val machine: res[*lower_context.Machine, fail.Fail] = backend.machine(?p.back);
    if (sel machine.err) { ret res[query.QueryOutput, fail.Fail].err{machine.err}; }
    val req_r: res[lower_context.LowerRequest, fail.Fail] = lower_context.request(s, ?p.linkage, ?p.back.facts, machine.ok, p.back.laying, s.backing, d.parsed.a, m.fqn, mid,
        d.sr, d.rr, d.ctx, normal_from, shared_artifact_build(p), p.req.debug, archive_build(p), p.req.opt != request.OPT_RELEASE, diags,
        sema_interface.Reader{ctx: p::ptr, read: read_interface}, lower_context.InstanceReader{ctx: p::ptr, read: read_instance});
    if (sel req_r.err) { ret res[query.QueryOutput, fail.Fail].err{req_r.err}; }
    var req:     lower_context.LowerRequest           = req_r.ok;
    val lowered: res[*driver_unit.Lowered, fail.Fail] = driver_unit.lower(driver_unit.Lowering.module{?req}, ?p.back, s.spans, p.s.alloc);
    if (sel lowered.err) { ret res[query.QueryOutput, fail.Fail].err{lower_stable_fail(p, lowered.err)}; }
    val l: *driver_unit.Lowered = lowered.ok;

    var asked: collections_vector.Vector[cache_record.Asked] = collections_vector.init[cache_record.Asked](s.backing);
    var kept:  err[fail.Fail]                                = err[fail.Fail].ok{};
    if (!test_object) { kept = gather_asked(p, m, d.sr, ?asked); }
    if (sel kept.err) {
        collections_vector.dnit[cache_record.Asked](?asked);
        lower_context.unit_dnit(?l.facts);
        driver_unit.release(p.s.alloc, l);
        ret res[query.QueryOutput, fail.Fail].err{kept.err};
    }
    read_out_lowering(p, test_object, intern.text(?s.interner, m.fqn), l, t_lower);
    ret lowering_encode(p, alloc, l, asked, !test_object && testrunner.declares_tests(d.parsed.a));
}

# what lowering a unit measured: its own row, carved out of the codegen row it runs inside
# while each unit is lowered just before it is compiled, and the counts of its module
fun read_out_lowering(p: *project.Project, test_object: bool, name: str, l: *driver_unit.Lowered, t_lower: readout.Instant) {
    var lower:   readout.Phase = readout.LOWER;
    var codegen: readout.Phase = readout.CODEGEN;
    if (test_object) {
        lower   = readout.TEST_LOWER;
        codegen = readout.TEST_CODEGEN;
    }
    readout.span_end(p.progress, lower, codegen, t_lower);
    readout.item_spent(p.progress, lower, name, l.lower);
    readout.count(p.progress, readout.FUNCTIONS, name, l.functions);
    readout.count(p.progress, readout.IR_INSTRUCTIONS, name, l.ir_count);
}

# a module's test object's name, `<module path>#tests`: `#` is in no module path, so it names no module, and its
# object is no instance unit's
fun test_object_name(p: *project.Project, fqn: intern.StrId) res[str, fail.Fail] {
    val joined: res[str, fail.Fail] = diagnostic.join(p.alloc, intern.text(?p.s.interner, fqn), "#tests");
    if (sel joined.err) { ret joined; }
    val held: res[intern.StrId, A.Error] = intern.add(?p.s.interner, joined.ok);
    str_free(p.alloc, joined.ok);
    if (sel held.err) { ret res[str, fail.Fail].err{fail.refused(held.err)}; }
    ret res[str, fail.Fail].ok{intern.text(?p.s.interner, held.ok)};
}

# how this build's request has mirl compile each module
fun codegen_of(p: *project.Project) driver_unit.Codegen {
    ret driver_unit.Codegen{level: p.req.opt, checked: p.req.verify, relax: p.req.linker_relax, floats: p.req.floats};
}

# the typing of the instance `item` describes, which the lowering asking for it then depends on
fun read_instance(raw: ptr, item: *sema_instance.Instance) res[*sema_product.InstanceResult, fail.Fail] {
    val p:     *project.Project             = raw::*project.Project;
    val named: res[intern.StrId, fail.Fail] = demand.register(?p.instances, p.s, item);
    if (sel named.err) { ret res[*sema_product.InstanceResult, fail.Fail].err{named.err}; }
    ret instance_typed(p, named.ok);
}

# the typing of the instance named `name`, which the registry describes
fun instance_typed(p: *project.Project, name: intern.StrId) res[*sema_product.InstanceResult, fail.Fail] {
    val got: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, ?INSTANCE_SEMA, intern.str_index(name)::u64);
    if (sel got.err) { ret res[*sema_product.InstanceResult, fail.Fail].err{got.err}; }
    ret res[*sema_product.InstanceResult, fail.Fail].ok{handle_decode(got.ok)::*sema_product.InstanceResult};
}

fun typer_typed(raw: ptr, name: intern.StrId, item: *sema_instance.Instance) res[*sema_product.InstanceResult, fail.Fail] {
    ret instance_typed(raw::*project.Project, name);
}

# the instances a module whose record stood in for its typing asks for, its front end run for it
fun typer_asked(raw: ptr, mid: module.ModuleId) res[*sema_instance.Set, fail.Fail] {
    val acquired: res[*sema_product.SemaResult, fail.Fail] = frontend.acquire_sema(raw::*project.Project, mid);
    if (sel acquired.err) { ret res[*sema_instance.Set, fail.Fail].err{acquired.err}; }
    ret res[*sema_instance.Set, fail.Fail].ok{?acquired.ok.instances};
}

# how the build's demand types an instance and has a module typed for it
fun typer_of(p: *project.Project) demand.Typer {
    ret demand.Typer{ctx: p::ptr, typed: typer_typed, asked: typer_asked};
}

fun instance_sema_compute(raw: ptr, kind: *query.Kind, key: u64, alloc: *A.Allocator, diags: *diagnostic.DiagnosticStore) res[query.QueryOutput, fail.Fail] {
    val p:     *project.Project             = raw::*project.Project;
    val about: opt[*sema_instance.Instance] = demand.described(?p.instances, intern.str_id(key::u32));
    if (sel about.none) { ret res[query.QueryOutput, fail.Fail].err{fail.message("instance sema: the instance has no description")}; }
    val rt: err[fail.Fail] = query.depend[project.Project](?p.queries, p, ?context.TARGET, 0);
    if (sel rt.err) { ret res[query.QueryOutput, fail.Fail].err{rt.err}; }
    val deps_r: res[sema_product.SemaDeps, fail.Fail] = frontend.instance_deps(p, about.some);
    if (sel deps_r.err) { ret res[query.QueryOutput, fail.Fail].err{deps_r.err}; }
    var deps:  sema_product.SemaDeps                       = deps_r.ok;
    val typed: res[sema_product.InstanceResult, fail.Fail] = sema_module.instance_sema(p.s, about.some, ?deps);
    frontend.free_instance_deps(p, ?deps);
    if (sel typed.err) { ret res[query.QueryOutput, fail.Fail].err{typed.err}; }
    val boxed: res[*sema_product.InstanceResult, A.Error] = A.allocate[sema_product.InstanceResult](p.s.alloc, 1);
    if (sel boxed.err) {
        var kept: sema_product.InstanceResult = typed.ok;
        sema_product.instance_dnit(?kept);
        ret res[query.QueryOutput, fail.Fail].err{fail.refused(boxed.err)};
    }
    @boxed.ok = typed.ok;
    ret handle_encode(alloc, boxed.ok::ptr, instance_release, p.s.alloc);
}

fun instance_release(raw: ptr, alloc: *A.Allocator) {
    val r: *sema_product.InstanceResult = raw::*sema_product.InstanceResult;
    sema_product.instance_dnit(r);
    A.deallocate[sema_product.InstanceResult](alloc, r, 1);
}

fun instance_sema_finalize(value: *u8, value_len: u32, alloc: *A.Allocator) {
    instance_release(handle_decode(query.QueryView{value: value, value_len: value_len}), alloc);
}

# the interface the module `mid` published, which is all an importer's lowering reads of it
fun read_interface(raw: ptr, mid: module.ModuleId) res[*sema_interface.Interface, fail.Fail] {
    val p:        *project.Project                         = raw::*project.Project;
    val acquired: res[*sema_product.SemaResult, fail.Fail] = frontend.acquire_sema(p, mid);
    if (sel acquired.err)                      { ret res[*sema_interface.Interface, fail.Fail].err{acquired.err}; }
    if (!sel acquired.ok.status.kind.accepted) { ret res[*sema_interface.Interface, fail.Fail].err{lang_phase.phase_failure(acquired.ok.status)}; }
    ret res[*sema_interface.Interface, fail.Fail].ok{?acquired.ok.interface};
}

fun lower_stable_fail(p: *project.Project, f: fail.Fail) fail.Fail {
    if (sel f.reported) { ret f; }
    ret fail.with_text(f, lower_stable_err(p, fail.describe(f)));
}

fun lower_stable_err(p: *project.Project, msg: str) str {
    val kept: res[str, fail.Fail] = diagnostic.text_retain(?p.s.interner, msg);
    if (sel kept.ok) { ret kept.ok; }
    ret "lowering failed, and re-homing its diagnostic off the module arena failed in turn (allocation failure)";
}

# a product handle: the one pointer it owns
fun handle_encode(alloc: *A.Allocator, held: ptr, release: fun(ptr, *A.Allocator), owner: *A.Allocator) res[query.QueryOutput, fail.Fail] {
    val n:  u32               = $size_of(ptr)::u32;
    val rb: res[*u8, A.Error] = A.allocate[u8](alloc, n::usize);
    if (sel rb.err) {
        release(held, owner);
        ret res[query.QueryOutput, fail.Fail].err{fail.refused(rb.err)};
    }
    val slot: *ptr = rb.ok::ptr::*ptr;
    slot[0] = held;
    var out: query.QueryOutput;
    out.bytes = rb.ok;
    out.len   = n;
    ret res[query.QueryOutput, fail.Fail].ok{out};
}

fun handle_decode(e: query.QueryView) ptr {
    val slot: *ptr = codec.handle_bytes(e.value, e.value_len, $size_of(ptr))::ptr::*ptr;
    ret slot[0];
}

# the codegen operation's inputs: the typed definitions every step reads. the facts a
# module's step keeps are read from its product as the pass takes it
fun acquire_codegen_inputs(p: *project.Project) err[fail.Fail] {
    var clear: u32 = 0;
    for (clear < project.module_count(p)) {
        project.module_at(p, clear).unit = nil;
        clear                            = clear + 1;
    }
    ret acquire_frontend_inputs(p);
}

# the test operation's inputs: the typed definitions every test object's step reads
fun acquire_test_inputs(p: *project.Project) err[fail.Fail] {
    var clear: u32 = 0;
    for (clear < project.module_count(p)) {
        project.module_at(p, clear).test.unit = nil;
        clear                                 = clear + 1;
    }
    ret acquire_frontend_inputs(p);
}

# the test stage's computation: each test object's typed inputs, then each test object
pub fun run_test_pass(p: *project.Project) err[fail.Fail] {
    val inputs: err[fail.Fail] = acquire_test_inputs(p);
    if (sel inputs.err) { ret inputs; }
    ret run_test_object_pass(p);
}

fun run_test_object_pass(p: *project.Project) err[fail.Fail] {
    var i: u32 = 0;
    for (i < p.emit_len) {
        val mid: module.ModuleId = p.topo[i];
        if (has_test_object(p, project.module_at(p, mid::u32))) {
            val r: err[fail.Fail] = run_test_object_one(p, mid);
            if (sel r.err) { ret err[fail.Fail].err{r.err}; }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# each module in topological order, its front-end products given back once nothing after reads
# them: an importer's lowering reads the definitions of every module it reaches, so a module is
# held until the last module reaching it is lowered, and a test build lowers every module again
pub fun run_codegen_pass(p: *project.Project) err[fail.Fail] {
    val inputs: err[fail.Fail] = acquire_codegen_inputs(p);
    if (sel inputs.err) { ret inputs; }
    val units: err[fail.Fail] = run_unit_pass(p);
    if (sel units.err) { ret units; }
    if (test_build(p)) {
        var t: u32 = 0;
        for (t < p.emit_len) {
            val r: err[fail.Fail] = run_codegen_one(p, p.topo[t]);
            if (sel r.err) { ret r; }
            t = t + 1;
        }
        ret err[fail.Fail].ok{};
    }
    val count:     u32                = project.module_count(p);
    val allocated: res[*u32, A.Error] = A.allocate[u32](p.s.alloc, count::usize);
    if (sel allocated.err) { ret err[fail.Fail].err{fail.refused(allocated.err)}; }
    val last: *u32 = allocated.ok;
    fin { A.deallocate[u32](p.s.alloc, last, count::usize); }
    last_readers(p, last, count);
    var i: u32 = 0;
    for (i < p.emit_len) {
        val r: err[fail.Fail] = run_codegen_one(p, p.topo[i]);
        if (sel r.err) { ret r; }
        var j: u32 = 0;
        for (j <= i) {
            if (last[p.topo[j]::u32] == i) {
                val released: err[fail.Fail] = frontend.release_lowered(p, p.topo[j]);
                if (sel released.err) { ret released; }
            }
            j = j + 1;
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# the build's instance units, from its instance demand, each unit's object made by its own step
fun run_unit_pass(p: *project.Project) err[fail.Fail] {
    val got: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, ?INSTANCE_DEMAND, 0);
    if (sel got.err) { ret err[fail.Fail].err{got.err}; }
    val d: *demand.Demand = handle_decode(got.ok)::*demand.Demand;
    project.units_clear(p);
    var i: usize = 0;
    for (i < d.units.len) {
        val listed: err[fail.Fail] = unit_add(p, ?d.units.data[i]);
        if (sel listed.err) { ret listed; }
        i = i + 1;
    }
    i = 0;
    for (i < p.units.len) {
        val restored: err[fail.Fail] = unit_restore(p, d, ?d.units.data[i], ?p.units.data[i]);
        if (sel restored.err) { ret restored; }
        i = i + 1;
    }
    # a unit that lowers needs each member's typing, so a member only records name is described
    i = 0;
    for (i < p.units.len) {
        if (!p.units.data[i].hit) {
            val du: *demand.Unit = ?d.units.data[i];
            var j:  u32          = 0;
            for (j < du.count) {
                val described_r: err[fail.Fail] = demand.describe_named(d, ?p.instances, p.s, typer_of(p), d.members.data[(du.first + j)::usize].name);
                if (sel described_r.err) { ret described_r; }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    i = 0;
    for (i < p.units.len) {
        val u: *project.InstanceUnit = ?p.units.data[i];
        if (!u.hit) {
            val ahead: err[fail.Fail] = lower_ahead(p, ?UNIT_LOWER, ?UNIT_CODEGEN, u.key);
            if (sel ahead.err) { ret ahead; }
        }
        val e: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, ?UNIT_CODEGEN, u.key);
        if (sel e.err) { ret err[fail.Fail].err{e.err}; }
        val made: *Product = product_decode(e.ok);
        if (made == nil) { ret err[fail.Fail].err{fail.message("the unit codegen query produced no result handle")}; }
        u.object = ?made.object;
        u.unit   = product_facts(made);
        val published: err[fail.Fail] = cache.publish_unit(p, u, query.QueryKey{kind: ?UNIT_CODEGEN, key: u.key});
        if (sel published.err) { ret published; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# key unit u from its members and the modules each names, from a member's description or else
# from the record that stood in for its typing, then read its object from `obj/` under that key
fun unit_restore(p: *project.Project, d: *demand.Demand, du: *demand.Unit, u: *project.InstanceUnit) err[fail.Fail] {
    var k:     cache.UnitKeying                           = cache.unit_begin(p, u.name);
    var reads: collections_vector.Vector[module.ModuleId] = collections_vector.init[module.ModuleId](p.s.alloc);
    fin { collections_vector.dnit[module.ModuleId](?reads); }
    var j: u32 = 0;
    for (j < du.count) {
        val member: *demand.Member               = ?d.members.data[(du.first + j)::usize];
        val about:  opt[*sema_instance.Instance] = demand.described(?p.instances, member.name);
        collections_vector.clear[module.ModuleId](?reads);
        if (sel about.some) {
            val named: err[fail.Fail] = frontend.instance_reads(p, about.some, ?reads);
            if (sel named.err) { ret named; }
        }
        or {
            val at: u32 = demand.recorded(d, member.name);
            if (at == cache_instances.NONE) { ret err[fail.Fail].err{fail.message("unit key: a member has neither a description nor a record")}; }
            val rec: *cache_instances.Record = cache_instances.at(?p.instance_records, at);
            var r:   u32                     = 0;
            for (r < rec.reads_count) {
                val pushed: res[usize, A.Error] = collections_vector.push[module.ModuleId](?reads, cache_instances.read_id(?p.instance_records, rec, r));
                if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
                r = r + 1;
            }
        }
        cache.unit_member(p, ?k, member.name, reads.data, reads.len);
        j = j + 1;
    }
    val finished: err[fail.Fail] = cache.unit_finish(p, ?k, u);
    if (sel finished.err) { ret finished; }
    if (!u.keyed)         { ret err[fail.Fail].ok{}; }
    val located: res[str, fail.Fail] = unit_output(p, p.object_dir, u.origin, u.bucket, backend.OBJECT_EXT);
    if (sel located.err) { ret err[fail.Fail].err{located.err}; }
    val found: res[bool, fail.Fail] = cache.restore_unit(p, u, located.ok);
    str_free(p.alloc, located.ok);
    if (sel found.err) { ret err[fail.Fail].err{found.err}; }
    ret err[fail.Fail].ok{};
}

# the unit of this build's units whose query key is `key`, nil when none is
fun unit_held(p: *project.Project, key: u64) *project.InstanceUnit {
    var i: usize = 0;
    for (i < p.units.len) {
        if (p.units.data[i].key == key) { ret ?p.units.data[i]; }
        i = i + 1;
    }
    ret nil;
}

# a unit object restored from `obj/` becomes the unit's codegen product with the target and the
# unit's object key as its edges, so a change to any member or to a module one reads advances it
fun unit_codegen_restored(p: *project.Project, u: *project.InstanceUnit, alloc: *A.Allocator) res[query.QueryOutput, fail.Fail] {
    val rt: err[fail.Fail] = query.depend[project.Project](?p.queries, p, ?context.TARGET, 0);
    if (sel rt.err) { ret res[query.QueryOutput, fail.Fail].err{rt.err}; }
    val keyed: err[fail.Fail] = query.depend[project.Project](?p.queries, p, ?cache.UNIT_OBJECT_KEY, u.key);
    if (sel keyed.err) { ret res[query.QueryOutput, fail.Fail].err{keyed.err}; }
    val staged: *Object = cache.take_staged_unit(u);
    if (staged == nil) { ret res[query.QueryOutput, fail.Fail].err{fail.message("unit codegen: restored product left the unit")}; }
    val o: Object = @staged;
    A.deallocate[Object](p.s.alloc, staged, 1);
    ret product_encode(alloc, o, opt[Kept].none{}, p.s.alloc);
}

# the unit `du` joins the project's units, named, with the paths its text and listing go to
fun unit_add(p: *project.Project, du: *demand.Unit) err[fail.Fail] {
    val named: res[intern.StrId, fail.Fail] = unit_name(p, du.origin, du.bucket);
    if (sel named.err) { ret err[fail.Fail].err{named.err}; }
    var u: project.InstanceUnit = project.InstanceUnit{key: du.key, origin: du.origin, bucket: du.bucket, name: named.ok};
    if (p.req.emit_ir) {
        val placed: res[str, fail.Fail] = unit_output(p, p.ir_dir, du.origin, du.bucket, "ir");
        if (sel placed.err) { ret err[fail.Fail].err{placed.err}; }
        u.ir_output = placed.ok;
    }
    if (p.req.emit_asm) {
        val placed: res[str, fail.Fail] = unit_output(p, p.asm_dir, du.origin, du.bucket, "s");
        if (sel placed.err) {
            if (u.ir_output != nil) { str_free(p.alloc, u.ir_output); }
            ret err[fail.Fail].err{placed.err};
        }
        u.asm_output = placed.ok;
    }
    val pushed: res[usize, A.Error] = collections_vector.push[project.InstanceUnit](?p.units, u);
    if (sel pushed.err) {
        if (u.ir_output != nil)  { str_free(p.alloc, u.ir_output); }
        if (u.asm_output != nil) { str_free(p.alloc, u.asm_output); }
        ret err[fail.Fail].err{fail.refused(pushed.err)};
    }
    ret err[fail.Fail].ok{};
}

# a unit's name, `<origin>#instances.<bucket>`: `#` is in no module path, so it names no module
fun unit_name(p: *project.Project, origin: module.ModuleId, bucket: u32) res[intern.StrId, fail.Fail] {
    var buf:    [demand.SUFFIX_CAP]u8;
    val suffix: str                 = demand.unit_suffix(bucket, ?buf[0]);
    val joined: res[str, fail.Fail] = diagnostic.join(p.alloc, intern.text(?p.s.interner, module.module_fqn(?p.s.modules, origin)), "#", suffix);
    if (sel joined.err) { ret res[intern.StrId, fail.Fail].err{joined.err}; }
    val held: res[intern.StrId, A.Error] = intern.add(?p.s.interner, joined.ok);
    str_free(p.alloc, joined.ok);
    if (sel held.err) { ret res[intern.StrId, fail.Fail].err{fail.refused(held.err)}; }
    ret res[intern.StrId, fail.Fail].ok{held.ok};
}

# where a unit's file of kind `ext` goes under `base`: beside its origin's, as
# `<module path>.instances.<bucket>.<ext>`, its directory made. the project owns the path
pub fun unit_output(p: *project.Project, base: str, origin: module.ModuleId, bucket: u32, ext: str) res[str, fail.Fail] {
    var buf:    [demand.SUFFIX_CAP]u8;
    val suffix: res[str, fail.Fail] = diagnostic.join(p.alloc, demand.unit_suffix(bucket, ?buf[0]), ".", ext);
    if (sel suffix.err) { ret suffix; }
    fin { str_free(p.alloc, suffix.ok); }
    val named: res[str, fail.Fail] = output.mirror_fqn(p.alloc, base::*u8, intern.text(?p.s.interner, module.module_fqn(?p.s.modules, origin)), suffix.ok);
    if (sel named.err) { ret named; }
    val reserved: err[fail.Fail] = output.reserve(p.alloc, p.out_dir, named.ok);
    if (sel reserved.err) {
        str_free(p.alloc, named.ok);
        ret res[str, fail.Fail].err{reserved.err};
    }
    ret named;
}

# the build's demand: what every module asks for, each typed module's own and an emitted one's
# reaching what its code reaches, closed through every instance's own typing, the instances'
# reports placed, then settled into units. a demand any instance of which does not type check is
# reported, after its reports
fun instance_demand_compute(raw: ptr, kind: *query.Kind, key: u64, alloc: *A.Allocator, diags: *diagnostic.DiagnosticStore) res[query.QueryOutput, fail.Fail] {
    val p:      *project.Project    = raw::*project.Project;
    var wanted: sema_instance.Reach = sema_instance.REACH_NORMAL;
    if (test_build(p)) { wanted = wanted | sema_instance.REACH_TESTING; }
    val boxed: res[*demand.Demand, A.Error] = A.allocate[demand.Demand](p.s.alloc, 1);
    if (sel boxed.err) { ret res[query.QueryOutput, fail.Fail].err{fail.refused(boxed.err)}; }
    val d: *demand.Demand = boxed.ok;
    @d = demand.init(p.s.alloc);
    var handed: bool = false;
    fin {
        if (!handed) { demand_release(d::ptr, p.s.alloc); }
    }
    val recorded: err[fail.Fail] = query.depend[project.Project](?p.queries, p, ?cache.DEMAND_RECORDS, 0);
    if (sel recorded.err) { ret res[query.QueryOutput, fail.Fail].err{recorded.err}; }
    if (p.cache_ready)    { d.records = ?p.instance_records; }
    var i: u32 = 0;
    for (i < p.topo_len) {
        val mid: module.ModuleId      = p.topo[i];
        val m:   *project.ModuleEntry = project.module_at(p, mid::u32);
        # a skipped module's record says what its code asks for
        if (m.frontend_skipped) {
            val listed: err[fail.Fail] = demand.offer_recorded(d, p.s, mid, m.file_id, m.staged_facts.asked, m.staged_facts.asked_count, i < p.emit_len);
            if (sel listed.err) { ret res[query.QueryOutput, fail.Fail].err{listed.err}; }
            i = i + 1;
            cnt;
        }
        val typed: res[*sema_product.SemaResult, fail.Fail] = frontend.acquire_sema(p, mid);
        if (sel typed.err) {
            if (!fail.is_reported(typed.err)) { ret res[query.QueryOutput, fail.Fail].err{typed.err}; }
            d.rejected = true;
            i          = i + 1;
            cnt;
        }
        val offered: err[fail.Fail] = demand.offer_module(d, ?p.instances, p.s, ?typed.ok.instances, i < p.emit_len);
        if (sel offered.err) { ret res[query.QueryOutput, fail.Fail].err{offered.err}; }
        i = i + 1;
    }
    val closed: err[fail.Fail] = demand.close(d, ?p.instances, p.s, typer_of(p));
    if (sel closed.err) { ret res[query.QueryOutput, fail.Fail].err{closed.err}; }
    var sources:  diagnostic.SourceTable = cache.source_table(p);
    val reported: err[fail.Fail]         = demand.report(d, p.s, ?sources, diags);
    if (sel reported.err) { ret res[query.QueryOutput, fail.Fail].err{reported.err}; }
    if (d.rejected)       { ret res[query.QueryOutput, fail.Fail].err{fail.reported()}; }
    if (p.cache_ready) {
        val kept: err[fail.Fail] = record_typed(p, d, ?sources);
        if (sel kept.err) { ret res[query.QueryOutput, fail.Fail].err{kept.err}; }
    }
    val settled: err[fail.Fail] = demand.settle(d, p.s, wanted);
    if (sel settled.err) { ret res[query.QueryOutput, fail.Fail].err{settled.err}; }
    handed = true;
    ret handle_encode(alloc, d::ptr, demand_release, p.s.alloc);
}

# a record of each instance the demand typed, for the cell's instance records: what its typing
# asked for and reported, under the key of what it read. an instance whose body asks for an
# instance outside its declaring module's file, or that reads a module this load did not key, is
# not recorded, and is typed in every build
fun record_typed(p: *project.Project, d: *demand.Demand, sources: *diagnostic.SourceTable) err[fail.Fail] {
    var reads: collections_vector.Vector[module.ModuleId] = collections_vector.init[module.ModuleId](p.s.alloc);
    fin { collections_vector.dnit[module.ModuleId](?reads); }
    var names: collections_vector.Vector[intern.StrId] = collections_vector.init[intern.StrId](p.s.alloc);
    fin { collections_vector.dnit[intern.StrId](?names); }
    var children: collections_vector.Vector[cache_instances.Child] = collections_vector.init[cache_instances.Child](p.s.alloc);
    fin { collections_vector.dnit[cache_instances.Child](?children); }
    var j: usize = 0;
    for (j < d.entries.len) {
        val e: *demand.Entry = ?d.entries.data[j];
        j = j + 1;
        if (e.typed == nil || !sel e.typed.status.kind.accepted || module.is_nil(e.origin)) { cnt; }
        val about: opt[*sema_instance.Instance] = demand.described(?p.instances, e.name);
        if (sel about.none) { ret err[fail.Fail].err{fail.message("instance records: a typed instance has no description")}; }
        val origin: *project.ModuleEntry = project.module_at(p, e.origin::u32);
        collections_vector.clear[module.ModuleId](?reads);
        val named: err[fail.Fail] = frontend.instance_reads(p, about.some, ?reads);
        if (sel named.err) { ret named; }
        var key:   [32]u8;
        val keyed: res[bool, fail.Fail] = cache.instance_key(p, e.name, reads.data, reads.len, ?key);
        if (sel keyed.err) { ret err[fail.Fail].err{keyed.err}; }
        if (!keyed.ok)     { cnt; }
        collections_vector.clear[cache_instances.Child](?children);
        var placeable: bool = true;
        val n:         u32  = sema_instance.count(?e.typed.set);
        var k:         u32  = 1;
        for (placeable && k < n) {
            val item: *sema_instance.Instance = sema_instance.at(?e.typed.set, k);
            placeable = item.site_file == origin.file_id;
            val asked: res[intern.StrId, fail.Fail] = demand.register(?p.instances, p.s, item);
            if (sel asked.err) { ret err[fail.Fail].err{asked.err}; }
            val pushed: res[usize, A.Error] = collections_vector.push[cache_instances.Child](?children, cache_instances.Child{name: asked.ok, span: item.site});
            if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
            k = k + 1;
        }
        if (!placeable) { cnt; }
        collections_vector.clear[intern.StrId](?names);
        var r: usize = 0;
        for (r < reads.len) {
            val pushed: res[usize, A.Error] = collections_vector.push[intern.StrId](?names, project.module_at(p, reads.data[r]::u32).fqn);
            if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
            r = r + 1;
        }
        var w: wire.Sink = wire.grown(p.s.backing);
        fin { wire.dnit(?w); }
        if (diagnostic.len(?e.typed.diags) > 0) { diagnostic.encode(?w, ?e.typed.diags, sources); }
        if (w.failed || w.len > 0xFFFFFFF0)     { ret err[fail.Fail].err{fail.message("instance records: an instance's reports exceed a record")}; }
        val added: res[u32, fail.Fail] = cache_instances.add(?d.fresh, e.name, origin.fqn, ?key, ?origin.placed_digest, names.data, names.len::u32,
            children.data, children.len::u32, wire.bytes(?w), w.len::u32);
        if (sel added.err) { ret err[fail.Fail].err{added.err}; }
    }
    ret err[fail.Fail].ok{};
}

fun demand_release(raw: ptr, alloc: *A.Allocator) {
    val d: *demand.Demand = raw::*demand.Demand;
    demand.dnit(d);
    A.deallocate[demand.Demand](alloc, d, 1);
}

fun instance_demand_finalize(value: *u8, value_len: u32, alloc: *A.Allocator) {
    demand_release(handle_decode(query.QueryView{value: value, value_len: value_len}), alloc);
}

fun instance_demand_equal(left: *u8, left_len: u32, right: *u8, right_len: u32) bool {
    val l: *demand.Demand = handle_decode(query.QueryView{value: left, value_len: left_len})::*demand.Demand;
    val r: *demand.Demand = handle_decode(query.QueryView{value: right, value_len: right_len})::*demand.Demand;
    ret demand.same(l, r);
}

# a unit's members as the demand holds them, none once nothing demands the unit
fun unit_demand_compute(raw: ptr, kind: *query.Kind, key: u64, alloc: *A.Allocator, diags: *diagnostic.DiagnosticStore) res[query.QueryOutput, fail.Fail] {
    val p:   *project.Project                = raw::*project.Project;
    val got: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, ?INSTANCE_DEMAND, 0);
    if (sel got.err) { ret res[query.QueryOutput, fail.Fail].err{got.err}; }
    val d:  *demand.Demand = handle_decode(got.ok)::*demand.Demand;
    var fb: wire.Sink      = wire.grown(alloc);
    fin { wire.dnit(?fb); }
    val found: opt[*demand.Unit] = demand.unit_of(d, key);
    if (sel found.some) {
        val u: *demand.Unit = found.some;
        var i: u32          = 0;
        for (i < u.count) {
            wire.put_u32(?fb, intern.str_index(d.members.data[(u.first + i)::usize].name));
            i = i + 1;
        }
    }
    ret codec.output(?fb);
}

# the bytes of one member in a unit demand product
val MEMBER_BYTES: u32 = 4;

# an instance unit's lowering: its members' own typing, which it then depends on, lowered in
# symbol order, each a merged definition of its source identity (driver/identity) where the
# target's objects hold them. it reads no module's typing, so only what its members read
# reaches it
fun unit_lower_compute(raw: ptr, kind: *query.Kind, key: u64, alloc: *A.Allocator, diags: *diagnostic.DiagnosticStore) res[query.QueryOutput, fail.Fail] {
    val p:       *project.Project                = raw::*project.Project;
    val s:       *session.Session                = p.s;
    val t_lower: readout.Instant                 = readout.span_begin(p.progress);
    val got:     res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, ?UNIT_DEMAND, key);
    if (sel got.err) { ret res[query.QueryOutput, fail.Fail].err{got.err}; }
    val count:   u32                                                     = got.ok.value_len / MEMBER_BYTES;
    var members: collections_vector.Vector[*sema_product.InstanceResult] = collections_vector.init[*sema_product.InstanceResult](s.alloc);
    fin { collections_vector.dnit[*sema_product.InstanceResult](?members); }
    var defining: collections_vector.Vector[lower_context.Defining] = collections_vector.init[lower_context.Defining](s.alloc);
    fin { collections_vector.dnit[lower_context.Defining](?defining); }
    val merges: bool        = backend.merges(?p.back);
    var r:      wire.Source = wire.source(got.ok.value, got.ok.value_len::usize);
    var i:      u32         = 0;
    for (i < count) {
        val name:  intern.StrId                                 = intern.str_id(wire.take_u32(?r));
        val typed: res[*sema_product.InstanceResult, fail.Fail] = instance_typed(p, name);
        if (sel typed.err) { ret res[query.QueryOutput, fail.Fail].err{typed.err}; }
        val pushed: res[usize, A.Error] = collections_vector.push[*sema_product.InstanceResult](?members, typed.ok);
        if (sel pushed.err) { ret res[query.QueryOutput, fail.Fail].err{fail.refused(pushed.err)}; }
        var bound: lower_context.Defining = lower_context.Defining.instance{};
        if (merges) {
            val source: res[u64, fail.Fail] = identity.of_instance(p, sema_instance.at(?typed.ok.set, 0), name);
            if (sel source.err) { ret res[query.QueryOutput, fail.Fail].err{source.err}; }
            bound = lower_context.Defining.merged{source.ok};
        }
        val held: res[usize, A.Error] = collections_vector.push[lower_context.Defining](?defining, bound);
        if (sel held.err) { ret res[query.QueryOutput, fail.Fail].err{fail.refused(held.err)}; }
        i = i + 1;
    }
    val rt: err[fail.Fail] = query.depend[project.Project](?p.queries, p, ?context.TARGET, 0);
    if (sel rt.err) { ret res[query.QueryOutput, fail.Fail].err{rt.err}; }

    val stable: module.StableModuleId = demand.key_stable(key);
    val origin: module.ModuleId       = module.module_id_for_stable(?s.modules, stable);
    if (module.is_nil(origin)) { ret res[query.QueryOutput, fail.Fail].err{fail.message("unit lower: the unit's origin is not loaded this build")}; }
    val named: res[intern.StrId, fail.Fail] = unit_name(p, origin, demand.key_bucket(key));
    if (sel named.err) { ret res[query.QueryOutput, fail.Fail].err{named.err}; }
    val machine: res[*lower_context.Machine, fail.Fail] = backend.machine(?p.back);
    if (sel machine.err) { ret res[query.QueryOutput, fail.Fail].err{machine.err}; }
    val req_r: res[lower_context.LowerRequest, fail.Fail] = lower_context.unit_request(s, ?p.linkage, ?p.back.facts, machine.ok, p.back.laying, s.backing,
        p.req.debug, archive_build(p), p.req.opt != request.OPT_RELEASE, diags, sema_interface.Reader{ctx: p::ptr, read: read_interface}, lower_context.InstanceReader{ctx: p::ptr, read: read_instance});
    if (sel req_r.err) { ret res[query.QueryOutput, fail.Fail].err{req_r.err}; }
    var req:      lower_context.LowerRequest           = req_r.ok;
    val lowering: driver_unit.Lowering                 = driver_unit.Lowering.unit{driver_unit.UnitLowering{req: ?req, name: named.ok, members: members.data, defining: defining.data, count: members.len::u32}};
    val lowered:  res[*driver_unit.Lowered, fail.Fail] = driver_unit.lower(lowering, ?p.back, s.spans, p.s.alloc);
    if (sel lowered.err) { ret res[query.QueryOutput, fail.Fail].err{lower_stable_fail(p, lowered.err)}; }
    read_out_lowering(p, false, intern.text(?s.interner, named.ok), lowered.ok, t_lower);
    ret lowering_encode(p, alloc, lowered.ok, collections_vector.init[cache_record.Asked](s.backing), false);
}

# an instance unit's object: its lowering, which it then depends on, compiled
fun unit_codegen_compute(raw: ptr, kind: *query.Kind, key: u64, alloc: *A.Allocator, diags: *diagnostic.DiagnosticStore) res[query.QueryOutput, fail.Fail] {
    val p:    *project.Project      = raw::*project.Project;
    val s:    *session.Session      = p.s;
    val held: *project.InstanceUnit = unit_held(p, key);
    if (held != nil && held.hit && held.staged != nil) { ret unit_codegen_restored(p, held, alloc); }
    if (held == nil)                                   { ret res[query.QueryOutput, fail.Fail].err{fail.message("unit codegen: the unit is not one of this build's")}; }
    var job: driver_unit.Job = driver_unit.Job{back: ?p.back, codegen: codegen_of(p), out: s.backing, ir_path: held.ir_output, asm_path: held.asm_output,
        name: intern.text(?s.interner, held.name), timed: p.progress != nil, sources: s.sources};
    ret compiled_from(p, ?UNIT_LOWER, key, ?job, false, alloc, diags);
}

# the topological position of the last emitted module whose lowering may read each module's
# definition: its own, or that of its last importer, and NO_READER for a module not emitted
fun last_readers(p: *project.Project, last: *u32, count: u32) {
    var k: u32 = 0;
    for (k < count) {
        last[k] = NO_READER;
        k       = k + 1;
    }
    var i: u32 = 0;
    for (i < p.emit_len) {
        last[p.topo[i]::u32] = i;
        i                    = i + 1;
    }
    var r: u32 = p.emit_len;
    for (r > 0) {
        r = r - 1;
        val m:    *project.ModuleEntry = project.module_at(p, p.topo[r]::u32);
        val read: u32                  = last[p.topo[r]::u32];
        var d:    u32                  = 0;
        for (d < project.dep_count(m)) {
            val dep: u32 = project.dep_at(p, m, d)::u32;
            if (dep < count && last[dep] != NO_READER && last[dep] < read) { last[dep] = read; }
            d = d + 1;
        }
    }
}

val NO_READER: u32 = 0xFFFFFFFF;

# the unit `key` names lowered just before it is compiled, unless its object is current or
# restored, whose codegen reads no lowering
fun lower_ahead(p: *project.Project, lowering: *query.Kind, codegen: *query.Kind, key: u64) err[fail.Fail] {
    val reusable: res[bool, fail.Fail] = query.reusable[project.Project](?p.queries, p, codegen, key);
    if (sel reusable.err) { ret err[fail.Fail].err{reusable.err}; }
    if (reusable.ok)      { ret err[fail.Fail].ok{}; }
    val lowered: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, lowering, key);
    if (sel lowered.err) { ret err[fail.Fail].err{lowered.err}; }
    ret err[fail.Fail].ok{};
}

fun run_codegen_one(p: *project.Project, mid: module.ModuleId) err[fail.Fail] {
    val m: *project.ModuleEntry = project.module_at(p, mid::u32);
    # the symbols the module defines are read from its lowering before its codegen spends it
    var defined: collections_vector.Vector[intern.StrId] = collections_vector.init[intern.StrId](p.s.backing);
    fin { collections_vector.dnit[intern.StrId](?defined); }
    if (!cache.restored(p, m)) {
        val ahead: err[fail.Fail] = lower_ahead(p, ?LOWER, ?CODEGEN, back_half_key_for(p, m));
        if (sel ahead.err) { ret ahead; }
        val read: err[fail.Fail] = defined_of(p, m, ?defined);
        if (sel read.err) { ret read; }
    }
    val e_r: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, ?CODEGEN, back_half_key_for(p, m));
    if (sel e_r.err) { ret err[fail.Fail].err{e_r.err}; }
    val made: *Product = product_decode(e_r.ok);
    if (made == nil) { ret err[fail.Fail].err{fail.message("the codegen query produced no result handle")}; }
    m.object = ?made.object;
    m.unit   = product_facts(made);
    val o: *Object = m.object;
    # a generated object, or one this session held, carries the key of the current snapshot
    # into `obj/`
    if (!made.lowered) { ret cache.publish(p, m, o, nil, 0, nil, 0, query.QueryKey{kind: ?CODEGEN, key: back_half_key_for(p, m)}); }
    ret cache.publish(p, m, o, made.kept.asked.data, made.kept.asked.len::u32, defined.data, defined.len::u32,
        query.QueryKey{kind: ?CODEGEN, key: back_half_key_for(p, m)});
}

# the module's test object, lowered against its normal object and compiled
fun run_test_object_one(p: *project.Project, mid: module.ModuleId) err[fail.Fail] {
    val m: *project.ModuleEntry = project.module_at(p, mid::u32);
    if (!cache.test_restored(p, m)) {
        val ahead: err[fail.Fail] = lower_ahead(p, ?LOWER, ?CODEGEN, test_key_for(m));
        if (sel ahead.err) { ret ahead; }
    }
    val e_r: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, ?CODEGEN, test_key_for(m));
    if (sel e_r.err) { ret err[fail.Fail].err{e_r.err}; }
    val made: *Product = product_decode(e_r.ok);
    if (made == nil) { ret err[fail.Fail].err{fail.message("the codegen query produced no test object handle")}; }
    m.test.object = ?made.object;
    m.test.unit   = product_facts(made);
    val o: *Object = m.test.object;
    ret cache.publish_test(p, m, o, query.QueryKey{kind: ?CODEGEN, key: test_key_for(m)});
}

# the test object's codegen product is current or cached, so no worker generates it
pub fun test_codegen_reusable(p: *project.Project, mid: module.ModuleId) res[bool, fail.Fail] {
    val m:        *project.ModuleEntry = project.module_at(p, mid::u32);
    val reusable: res[bool, fail.Fail] = query.reusable[project.Project](?p.queries, p, ?CODEGEN, test_key_for(m));
    if (sel reusable.err) { ret reusable; }
    if (reusable.ok)      { ret reusable; }
    ret res[bool, fail.Fail].ok{cache.test_restored(p, m)};
}

# a module's object: its lowering, which it then depends on, compiled, or the object the object
# cache staged for it
fun codegen_compute(raw: ptr, kind: *query.Kind, key: u64, alloc: *A.Allocator, diags: *diagnostic.DiagnosticStore) res[query.QueryOutput, fail.Fail] {
    val p:     *project.Project                = raw::*project.Project;
    val s:     *session.Session                = p.s;
    val keyed: res[module.ModuleId, fail.Fail] = keyed_module(p, key);
    if (sel keyed.err) { ret res[query.QueryOutput, fail.Fail].err{keyed.err}; }
    val mid:         module.ModuleId      = keyed.ok;
    val m:           *project.ModuleEntry = project.module_at(p, mid::u32);
    val test_object: bool                 = back_half_key_is_test(key);
    if (!test_object && cache.staged_restored(p, m))     { ret q_codegen_restored(p, mid, false, alloc); }
    if (test_object && cache.test_staged_restored(p, m)) { ret q_codegen_restored(p, mid, true, alloc); }
    var job: driver_unit.Job = driver_unit.Job{back: ?p.back, codegen: codegen_of(p), out: s.backing, ir_path: "", asm_path: "", name: intern.text(?s.interner, m.fqn),
        timed: p.progress != nil, sources: s.sources};
    if (!test_object) {
        job.ir_path  = m.ir_output;
        job.asm_path = m.asm_output;
    }
    or {
        val named: res[str, fail.Fail] = test_object_name(p, m.fqn);
        if (sel named.err) { ret res[query.QueryOutput, fail.Fail].err{named.err}; }
        job.name = named.ok;
    }
    ret compiled_from(p, ?LOWER, key, ?job, test_object, alloc, diags);
}

# the object of the lowering `lowering` keys under `key`, compiled as `job` says: the codegen takes
# what the lowering kept, and the lowering's value is given back once its module is compiled
fun compiled_from(p: *project.Project, lowering: *query.Kind, key: u64, job: *driver_unit.Job, test_object: bool, alloc: *A.Allocator,
    diags: *diagnostic.DiagnosticStore) res[query.QueryOutput, fail.Fail] {
    val got: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, lowering, key);
    if (sel got.err) { ret res[query.QueryOutput, fail.Fail].err{got.err}; }
    val l:     *Lowering                                     = handle_decode(got.ok)::*Lowering;
    val t_cg:  readout.Instant                               = readout.item_begin(p.progress);
    var made:  res[driver_unit.Made, fail.Fail]              = driver_unit.compile(job, l.lowered);
    val facts: lower_context.Unit                            = l.lowered.facts;
    val asked: collections_vector.Vector[cache_record.Asked] = l.asked;
    l.taken = true;
    val released: err[fail.Fail] = query.release_value(?p.s.queries, lowering, key);
    var kept:     Kept           = Kept{facts: facts, asked: asked};
    if (sel released.err) {
        if (sel made.ok) { backend.release_object(?made.ok.compiled.object); }
        kept_dnit(?kept);
        ret res[query.QueryOutput, fail.Fail].err{released.err};
    }
    if (sel made.err) {
        kept_dnit(?kept);
        ret res[query.QueryOutput, fail.Fail].err{lower_stable_fail(p, made.err)};
    }
    val warned: err[fail.Fail] = warn(p, diags, ?made.ok.compiled);
    if (sel warned.err) {
        backend.release_object(?made.ok.compiled.object);
        kept_dnit(?kept);
        ret res[query.QueryOutput, fail.Fail].err{warned.err};
    }
    # the object carries its unit's link claims, so an archive of it carries them to its link
    val claimed: err[fail.Fail] = claims.state(p, ?made.ok.compiled.object);
    if (sel claimed.err) {
        backend.release_object(?made.ok.compiled.object);
        kept_dnit(?kept);
        ret res[query.QueryOutput, fail.Fail].err{claimed.err};
    }
    read_out_step(p, test_object, intern.text(?p.s.interner, facts.name), ?made.ok.stats, readout.elapsed(t_cg));
    ret product_encode(alloc, made.ok.compiled.object, opt[Kept].some{kept}, p.s.alloc);
}

# what compiling the unit `name` measured: its verify stage and mirl's and masc's move out of
# the codegen row into rows of their own, the rest of the compile is codegen's, and each count
# adds to the unit's total. mirl's verifier runs add to mach's, and mirl's emit row is its emit
# less masc's layout and encoding, which it holds. a refused clock read leaves its stage short,
# and is reported rather than shown as a zero
fun read_out_step(p: *project.Project, test_object: bool, name: str, st: *driver_unit.Stats, spent: chrono_duration.Duration) {
    var verify:  readout.Phase = readout.VERIFY;
    var codegen: readout.Phase = readout.CODEGEN;
    if (test_object) {
        verify  = readout.TEST_VERIFY;
        codegen = readout.TEST_CODEGEN;
    }
    val ms:          *mirl_stats.Stats        = ?st.mirl;
    val verified:    chrono_duration.Duration = st.verify + ns(ms.verify);
    val masc_layout: u64                      = ms.masc.layout;
    val masc_encode: u64                      = ms.masc.encode;
    var mirl_emit:   u64                      = 0;
    if (ms.emit > masc_layout + masc_encode) { mirl_emit = ms.emit - masc_layout - masc_encode; }
    readout.carve(p.progress, verify, codegen, verified);
    var times:  [readout.STAGE_COUNT]u64 = [readout.STAGE_COUNT]u64{ms.lower + ms.passes, ms.select, ms.alloc, ms.frame, mirl_emit, masc_layout, masc_encode};
    var carved: chrono_duration.Duration = verified;
    var i:      usize                    = 0;
    for (i < readout.STAGE_COUNT) {
        readout.carve(p.progress, readout.STAGES[i], codegen, ns(times[i]));
        readout.item_spent(p.progress, readout.STAGES[i], name, ns(times[i]));
        carved = carved + ns(times[i]);
        i      = i + 1;
    }
    var rest: chrono_duration.Duration = spent - carved;
    if (rest < 0) { rest = 0; }
    readout.item_spent(p.progress, verify, name, verified);
    readout.item_spent(p.progress, codegen, name, rest);
    readout.count(p.progress, readout.VERIFY_RUNS, name, st.verifies + ms.verified);
    readout.count(p.progress, readout.SELECTED, name, ms.selected);
    readout.count(p.progress, readout.ALLOCATED, name, ms.allocated);
    readout.count(p.progress, readout.ALLOC_ROUNDS, name, ms.rounds);
    readout.count(p.progress, readout.ALLOCATED_BLOCKS, name, st.blocks);
    readout.count(p.progress, readout.ALLOCATED_BYTES, name, st.bytes);
    readout.count(p.progress, readout.HEAP_PEAK, name, st.peak);
    if (sel ms.clock.some) {
        val text: res[str, fail.Fail] = diagnostic.join(p.s.alloc, "the clock refused a read while mirl timed '", name, "', so a stage row is short: ", fail.cause_text(fail.Cause.io{ms.clock.some}));
        var said: str                 = "the clock refused a read while mirl timed a module, so a stage row is short";
        if (sel text.ok) { said = text.ok; }
        val reported: err[fail.Fail] = diagnostic.report(?p.diags, diagnostic_kind.READOUT_CLOCK_REFUSED, lang_source.FILE_NIL, lang_source.Span{}, said);
    }
}

# mirl's nanoseconds as a duration
fun ns(n: u64) chrono_duration.Duration {
    ret n::chrono_duration.Duration;
}

# the mirl module `m` compiled into an object, which owns its storage in the session's backing
# allocator, the warnings mirl gave reported on `diags`. compiling spends the module
pub fun compile_module(p: *project.Project, diags: *diagnostic.DiagnosticStore, m: *Module, name: str) res[Object, fail.Fail] {
    val c:        driver_unit.Codegen                      = codegen_of(p);
    val compiled: res[backend_compile.Compiled, fail.Fail] = backend_compile.compile(?p.back, p.s.backing, p.s.sources, m, c.level, c.checked, c.relax, c.floats, opt[*std_writer.Writer].none{}, opt[*mirl_stats.Stats].none{}, name);
    if (sel compiled.err) { ret res[Object, fail.Fail].err{compiled.err}; }
    var made:   backend_compile.Compiled = compiled.ok;
    val warned: err[fail.Fail]           = warn(p, diags, ?made);
    if (sel warned.err) {
        backend.release_object(?made.object);
        ret res[Object, fail.Fail].err{warned.err};
    }
    ret res[Object, fail.Fail].ok{made.object};
}

# the warnings mirl gave compiling a module, each reported on `diags` under its kind at the source
# it points at, then given back. the object stays the caller's
fun warn(p: *project.Project, diags: *diagnostic.DiagnosticStore, c: *backend_compile.Compiled) err[fail.Fail] {
    fin { backend_compile.release_warnings(p.s.backing, c); }
    var i: usize = 0;
    for (i < c.warnings.len) {
        val w:    fail.Fail                 = c.warnings.data[i];
        val text: opt[str]                  = fail.text(w);
        var at:   lang_source.Location      = lang_source.location_nil();
        val put:  opt[lang_source.Location] = fail.place_of(w);
        if (sel put.some) { at = put.some; }
        if (sel text.some) {
            val reported: err[fail.Fail] = diagnostic.report(diags, fail.kind_of(w), at.file, at.span, text.some);
            if (sel reported.err) { ret reported; }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# a product restored from `obj/` becomes the module's codegen product with the
# target and the codegen flags as its edges, plus the module's object key,
# which is the persistent key's in-process image: any input the key covers
# advances it. a test object's key derives from the same one. it reads no
# typed definition, so a module nothing compiled imports is never typed
fun q_codegen_restored(p: *project.Project, mid: module.ModuleId, test_object: bool, alloc: *A.Allocator) res[query.QueryOutput, fail.Fail] {
    val m:  *project.ModuleEntry = project.module_at(p, mid::u32);
    val rt: err[fail.Fail]       = query.depend[project.Project](?p.queries, p, ?context.TARGET, 0);
    if (sel rt.err) { ret res[query.QueryOutput, fail.Fail].err{rt.err}; }
    var input: u64 = module.stable_index(m.stable_id)::u64;
    if (test_object) { input = cache.test_input_key(m); }
    val keyed: err[fail.Fail] = query.depend[project.Project](?p.queries, p, ?cache.OBJECT_KEY, input);
    if (sel keyed.err) { ret res[query.QueryOutput, fail.Fail].err{keyed.err}; }
    var staged: *Object = nil;
    if (test_object)   { staged = cache.take_staged_test(p, m); }
    or                 { staged = cache.take_staged(p, m); }
    if (staged == nil) { ret res[query.QueryOutput, fail.Fail].err{fail.message("codegen: restored product left the module")}; }
    val o: Object = @staged;
    A.deallocate[Object](p.s.alloc, staged, 1);
    ret product_encode(alloc, o, opt[Kept].none{}, p.s.alloc);
}

# what a unit's codegen keeps of its lowering once the module is compiled: the facts mach reads of
# it, and for a module the instances its code asks for (see Lowering)
rec Kept {
    facts: lower_context.Unit;
    asked: collections_vector.Vector[cache_record.Asked];
}

fun kept_dnit(k: *Kept) {
    lower_context.unit_dnit(?k.facts);
    collections_vector.dnit[cache_record.Asked](?k.asked);
}

# a codegen product: the unit's object, and what it kept of its lowering, none for an object
# the cache restored
rec Product {
    object:  Object;
    kept:    Kept;
    lowered: bool;
}

fun product_release(raw: ptr, alloc: *A.Allocator) {
    val made: *Product = raw::*Product;
    backend.release_object(?made.object);
    if (made.lowered) { kept_dnit(?made.kept); }
    A.deallocate[Product](alloc, made, 1);
}

fun product_encode(alloc: *A.Allocator, o: Object, kept: opt[Kept], owner: *A.Allocator) res[query.QueryOutput, fail.Fail] {
    var held:  Object                 = o;
    val boxed: res[*Product, A.Error] = A.allocate[Product](owner, 1);
    if (sel boxed.err) {
        backend.release_object(?held);
        if (sel kept.some) {
            var k: Kept = kept.some;
            kept_dnit(?k);
        }
        ret res[query.QueryOutput, fail.Fail].err{fail.refused(boxed.err)};
    }
    boxed.ok.object  = held;
    boxed.ok.lowered = sel kept.some;
    if (sel kept.some) { boxed.ok.kept = kept.some; }
    ret handle_encode(alloc, boxed.ok::ptr, product_release, owner);
}

fun product_decode(e: query.QueryView) *Product {
    ret handle_decode(e)::*Product;
}

# the facts a product's lowering kept, nil for a restored object
fun product_facts(made: *Product) *lower_context.Unit {
    if (!made.lowered) { ret nil; }
    ret ?made.kept.facts;
}

fun codegen_finalize(value: *u8, value_len: u32, alloc: *A.Allocator) {
    product_release(handle_decode(query.QueryView{value: value, value_len: value_len}), alloc);
}

# the link stage's computation: the current objects, then the link the build's job names,
# which runs only when one of its inputs moved
pub fun run_link_pass(p: *project.Project) err[fail.Fail] {
    val linked: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, ?LINK, 0);
    if (sel linked.err) { ret err[fail.Fail].err{linked.err}; }
    ret err[fail.Fail].ok{};
}

# before the link stage's operation: when the artifact on disk is not what the link last wrote
# to `artifact`, or nothing was linked yet, LINK_ARTIFACT moves to a value it never held, the
# database's next revision, so the link runs again
pub fun prepare_link(p: *project.Project, artifact: str) err[fail.Fail] {
    val db:    *query.QueryDb       = ?p.s.queries;
    val last:  opt[query.QueryView] = query.published(db, ?LINK, 0, 0);
    var whole: bool                 = false;
    if (sel last.some) {
        if (query.peek_revision(db, ?LINK_ARTIFACT, 0) != 0) {
            val held: res[bool, fail.Fail] = artifact_held(p, last.some, artifact);
            if (sel held.err) { ret err[fail.Fail].err{held.err}; }
            whole = held.ok;
        }
    }
    if (whole) { ret err[fail.Fail].ok{}; }
    var fb: wire.Sink = wire.grown(p.alloc);
    fin { wire.dnit(?fb); }
    wire.put_u64(?fb, db.revision);
    val taken: res[query.QueryOutput, fail.Fail] = codec.output(?fb);
    if (sel taken.err) { ret err[fail.Fail].err{taken.err}; }
    val set: err[fail.Fail] = query.set_input(db, ?LINK_ARTIFACT, 0, taken.ok.bytes, taken.ok.len);
    if (taken.ok.bytes != nil) { A.deallocate[u8](p.alloc, taken.ok.bytes, taken.ok.len::usize); }
    ret set;
}

# the link's last product names `artifact`, and the file there holds the bytes it recorded
fun artifact_held(p: *project.Project, last: query.QueryView, artifact: str) res[bool, fail.Fail] {
    val n:        usize = str_len(artifact);
    val recorded: usize = last.value_len::usize;
    if (recorded != n + LINK_DIGEST)                          { ret res[bool, fail.Fail].ok{false}; }
    if (!memory.raw_equal(last.value::ptr, artifact::ptr, n)) { ret res[bool, fail.Fail].ok{false}; }
    val present: res[bool, io_error.Error] = fs.is_file(artifact);
    if (sel present.err) {
        if (present.err.kind == io_error.NOT_FOUND) { ret res[bool, fail.Fail].ok{false}; }
        ret res[bool, fail.Fail].err{diagnostic.refusal_interned(?p.s.interner, p.alloc, diagnostic_kind.FS_STAT, fail.Op{verb: "inspect", role: "the linked artifact", path: artifact}, fail.Cause.io{present.err})};
    }
    if (!present.ok) { ret res[bool, fail.Fail].ok{false}; }
    var now:    [LINK_DIGEST]u8;
    val digest: err[fail.Cause] = lang_fingerprint.file_sha256(artifact, ?now[0]);
    if (sel digest.err) { ret res[bool, fail.Fail].err{diagnostic.refusal_interned(?p.s.interner, p.alloc, diagnostic_kind.FS_READ, fail.Op{verb: "digest", role: "the linked artifact", path: artifact}, digest.err)}; }
    ret res[bool, fail.Fail].ok{memory.raw_equal((?now[0])::ptr, (?last.value[n])::ptr, LINK_DIGEST)};
}

# the bytes of a link product's digest, after the artifact's path
val LINK_DIGEST: usize = 32;

# the link: every object the artifact takes, the target, the link configuration and the
# artifact's standing are its inputs, and the build's link job writes the artifact
fun link_compute(raw: ptr, kind: *query.Kind, key: u64, alloc: *A.Allocator, diags: *diagnostic.DiagnosticStore) res[query.QueryOutput, fail.Fail] {
    val p:   *project.Project = raw::*project.Project;
    val job: *project.LinkJob = p.link;
    if (job == nil) { ret res[query.QueryOutput, fail.Fail].err{fail.message("link: the build set no link job")}; }

    val rt: err[fail.Fail] = query.depend[project.Project](?p.queries, p, ?context.TARGET, 0);
    if (sel rt.err) { ret res[query.QueryOutput, fail.Fail].err{rt.err}; }
    val rc: err[fail.Fail] = query.depend[project.Project](?p.queries, p, ?LINK_CONFIG, 0);
    if (sel rc.err) { ret res[query.QueryOutput, fail.Fail].err{rc.err}; }
    val ra: err[fail.Fail] = query.depend[project.Project](?p.queries, p, ?LINK_ARTIFACT, 0);
    if (sel ra.err) { ret res[query.QueryOutput, fail.Fail].err{ra.err}; }

    var i: u32 = 0;
    for (i < p.emit_len) {
        val m:  *project.ModuleEntry = project.module_at(p, (p.topo[i])::u32);
        val rd: err[fail.Fail]       = query.depend[project.Project](?p.queries, p, ?CODEGEN, back_half_key_for(p, m));
        if (sel rd.err) { ret res[query.QueryOutput, fail.Fail].err{rd.err}; }
        # a test build links each test object too
        if (has_test_object(p, m)) {
            val rtest: err[fail.Fail] = query.depend[project.Project](?p.queries, p, ?CODEGEN, test_key_for(m));
            if (sel rtest.err) { ret res[query.QueryOutput, fail.Fail].err{rtest.err}; }
        }
        i = i + 1;
    }
    # and every instance unit the demand names
    val rdem: err[fail.Fail] = query.depend[project.Project](?p.queries, p, ?INSTANCE_DEMAND, 0);
    if (sel rdem.err) { ret res[query.QueryOutput, fail.Fail].err{rdem.err}; }
    var u: usize = 0;
    for (u < p.units.len) {
        val ru: err[fail.Fail] = query.depend[project.Project](?p.queries, p, ?UNIT_CODEGEN, p.units.data[u].key);
        if (sel ru.err) { ret res[query.QueryOutput, fail.Fail].err{ru.err}; }
        u = u + 1;
    }

    val linked: err[fail.Fail] = job.run(job.ctx, p, diags);
    if (sel linked.err) { ret res[query.QueryOutput, fail.Fail].err{linked.err}; }

    var written: [LINK_DIGEST]u8;
    val digest:  err[fail.Cause] = lang_fingerprint.file_sha256(job.artifact, ?written[0]);
    if (sel digest.err) {
        val op: fail.Op = fail.Op{verb: "digest", role: "the linked artifact", path: job.artifact};
        ret res[query.QueryOutput, fail.Fail].err{diagnostic.refusal_interned(?p.s.interner, p.alloc, diagnostic_kind.FS_READ, op, digest.err)};
    }
    val err_noted: err[fail.Fail] = cache.note_link(p, job.artifact, ?written);
    if (sel err_noted.err) { ret res[query.QueryOutput, fail.Fail].err{err_noted.err}; }
    var fb: wire.Sink = wire.grown(alloc);
    fin { wire.dnit(?fb); }
    wire.put_bytes(?fb, job.artifact::*u8, str_len(job.artifact));
    wire.put_bytes(?fb, ?written[0], LINK_DIGEST);
    ret codec.output(?fb);
}

# key the loaded modules and read `obj/` under their keys (driver/cache),
# reported as the cache phase carved out of resolve, which it precedes
pub fun prepare_object_cache(p: *project.Project) err[fail.Fail] {
    if (!p.req.object_cache) { ret cache.forget(p); }
    readout.phase_begin(p.progress, readout.CACHE);
    val t_cache:  readout.Instant                   = readout.span_begin(p.progress);
    val captured: res[query.QueryOutput, fail.Fail] = context.capture_configuration_identity(p, p.s.backing);
    if (sel captured.err) { ret err[fail.Fail].err{captured.err}; }
    val config: query.QueryOutput = captured.ok;
    fin {
        if (config.bytes != nil) { A.deallocate[u8](p.s.backing, config.bytes, config.len::usize); }
    }
    val prepared: err[fail.Fail] = cache.prepare(p, config.bytes, config.len::usize, readout.CACHE);
    readout.span_end(p.progress, readout.CACHE, readout.RESOLVE, t_cache);
    readout.phase_end(p.progress, readout.CACHE, p.emit_len - cache.generated_count(p), "module", "modules");
    ret prepared;
}

pub fun module_in_current_project(p: *project.Project, fqn: intern.StrId) bool {
    val fqn_text:     str = intern.text(?p.s.interner, fqn);
    val proj_id_text: str = intern.text(?p.s.interner, p.config.id);

    val fqn_len:  usize = str_len(fqn_text);
    var head_end: usize = 0;
    for (head_end < fqn_len && fqn_text[head_end] != '.') { head_end = head_end + 1; }
    ret view_eq_str(view(fqn_text::*char, head_end), proj_id_text);
}
