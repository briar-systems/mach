# source identity: what a merged definition was made from, independent of how
# it was compiled (mink.model.merged)
#
# a module's identity folds its fully qualified name, the digest of its bare
# surface (driver/surface: its text without the bodies no importer compiles,
# free of paths and positions), the digests of the files it embeds and the
# identities of the modules it imports, so it covers every declaration and
# every generic or comptime body an instance of it can read, transitively. an
# instance's identity has the parts mink.model.merged states: its source, a
# digest of its symbol and the identities of the modules its typing reads
# (frontend.instance_reads), then the float relaxations the build permits and
# the digest of the build's closed instruction set selection mirl makes of
# every merged definition (mirl.target.basis.selection_digest), the two
# settings that change
# what a copy computes or where it runs, apart so a refusal can say which
# differed. the compiler, the optimisation level, debug information and every
# path stay out, so two libraries built from the same source under any of
# those settings hold copies that merge
#
# the parts are digests cut to 32 and 16 bits: ample against accident, and no
# authentication. an object made by hand that copies an identity onto other
# code merges with the copies it imitates

use A:                  std.allocator;
use collections_vector: std.collections.vector;
use std.collections.vector.Vector;
use std.text.string.str_free;
use std.types.bool.false;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use mach.lang.diagnostic;
use cache_key: mach.lang.driver.cache.key;
use mach.lang.driver.codec;
use mach.lang.driver.declared;
use mach.lang.driver.frontend;
use mach.lang.driver.project;
use mach.lang.driver.surface;
use mach.lang.fail;
use sema_instance: mach.lang.fe.sema.instance;
use mach.lang.intern;
use mach.lang.module;
use mach.lang.query;
use session_embed: mach.lang.session.embed;
use lang_source:   mach.lang.source;
use mach.lang.wire;
use mink.model.merged;
use mirl_basis: mirl.target.basis;

# a module's source identity, keyed by its stable id
pub val SOURCE_IDENTITY: query.Kind = query.Kind{
    name: "source identity", role: query.DERIVED, owner: query.KEY_MODULE, origin: diagnostic.ORIGIN_LOWER, compute: module_compute
};

# the bytes of a module's identity
val WIDTH: u32 = 32;

# the source identity of module `mid`
pub fun of_module(p: *project.Project, mid: module.ModuleId, out: *[32]u8) err[fail.Fail] {
    val m:   *project.ModuleEntry            = project.module_at(p, mid::u32);
    val got: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, ?SOURCE_IDENTITY, module.stable_index(m.stable_id)::u64);
    if (sel got.err)               { ret err[fail.Fail].err{got.err}; }
    if (got.ok.value_len != WIDTH) { ret err[fail.Fail].err{fail.message("source identity: a module's identity is not a digest")}; }
    var held: [32]u8;
    var i:    usize = 0;
    for (i < WIDTH::usize) {
        held[i] = got.ok.value[i];
        i       = i + 1;
    }
    @out = held;
    ret err[fail.Fail].ok{};
}

# the identity of the instance `item` of symbol `name`
pub fun of_instance(p: *project.Project, item: *sema_instance.Instance, name: intern.StrId) res[u64, fail.Fail] {
    var reads: Vector[module.ModuleId] = collections_vector.init[module.ModuleId](p.s.alloc);
    fin { collections_vector.dnit[module.ModuleId](?reads); }
    val named: err[fail.Fail] = frontend.instance_reads(p, item, ?reads);
    if (sel named.err) { ret res[u64, fail.Fail].err{named.err}; }
    var b: cache_key.Builder = cache_key.begin("mach.instance-identity");
    cache_key.name(?b, ?p.s.interner, name);
    cache_key.number(?b, reads.len::u64);
    var i: usize = 0;
    for (i < reads.len) {
        var read:  [32]u8;
        val known: err[fail.Fail] = of_module(p, reads.data[i], ?read);
        if (sel known.err) { ret res[u64, fail.Fail].err{known.err}; }
        cache_key.bytes(?b, ?read[0], 32);
        i = i + 1;
    }
    var source: [32]u8;
    val done:   err[fail.Fail] = cache_key.finish(?b, ?source);
    if (sel done.err) { ret res[u64, fail.Fail].err{done.err}; }
    var held: opt[*mirl_basis.Basis] = opt[*mirl_basis.Basis].none{};
    if (p.back.assembled != nil && p.back.assembled.based) { held = opt[*mirl_basis.Basis].some{?p.back.assembled.basis}; }
    ret res[u64, fail.Fail].ok{merged.compose(leading(?source, 4)::u32, (p.req.floats.bits & 0xffff)::u16, mirl_basis.selection_digest(held))};
}

# the first `n` bytes of a digest, big endian
fun leading(d: *[32]u8, n: usize) u64 {
    var v: u64   = 0;
    var i: usize = 0;
    for (i < n) {
        v = (v << 8) | d[0][i]::u64;
        i = i + 1;
    }
    ret v;
}

fun module_compute(raw: ptr, kind: *query.Kind, key: u64, alloc: *A.Allocator, diags: *diagnostic.DiagnosticStore) res[query.QueryOutput, fail.Fail] {
    val p:   *project.Project = raw::*project.Project;
    val mid: module.ModuleId  = module.module_id_for_stable(?p.s.modules, key::u32::module.StableModuleId);
    if (module.is_nil(mid)) { ret res[query.QueryOutput, fail.Fail].err{fail.message("source identity: the stable id is not loaded this build")}; }
    val m:      *project.ModuleEntry                  = project.module_at(p, mid::u32);
    val parsed: res[frontend.ParsedModule, fail.Fail] = frontend.parse(p, m);
    if (sel parsed.err) { ret res[query.QueryOutput, fail.Fail].err{parsed.err}; }
    val file: opt[*lang_source.SourceFile] = lang_source.get(p.s.sources, m.file_id);
    if (sel file.none) { ret res[query.QueryOutput, fail.Fail].err{fail.message("source identity: the module's file is not registered with the session")}; }
    val text: str = file.some.text;
    if (text == nil) { ret res[query.QueryOutput, fail.Fail].err{fail.message("source identity: the module's file holds no text")}; }
    val viewed: err[fail.Fail] = query.depend[project.Project](?p.queries, p, ?frontend.LOAD_VIEW, key);
    if (sel viewed.err) { ret res[query.QueryOutput, fail.Fail].err{viewed.err}; }

    var spans: Vector[lang_source.Span] = collections_vector.init[lang_source.Span](p.s.alloc);
    fin { collections_vector.dnit[lang_source.Span](?spans); }
    val found: err[fail.Fail] = surface.omitted(parsed.ok.a, text, ?spans);
    if (sel found.err) { ret res[query.QueryOutput, fail.Fail].err{found.err}; }
    var bare: [32]u8;
    surface.digest(text, ?spans, false, ?bare);

    var b: cache_key.Builder = cache_key.begin("mach.source-identity");
    cache_key.name(?b, ?p.s.interner, m.fqn);
    cache_key.bytes(?b, ?bare[0], 32);
    val embedded: err[fail.Fail] = embeds(?b, p, mid);
    if (sel embedded.err) { ret res[query.QueryOutput, fail.Fail].err{embedded.err}; }
    cache_key.number(?b, project.dep_count(m)::u64);
    var d: u32 = 0;
    for (d < project.dep_count(m)) {
        var imported: [32]u8;
        val known:    err[fail.Fail] = of_module(p, project.dep_at(p, m, d), ?imported);
        if (sel known.err) { ret res[query.QueryOutput, fail.Fail].err{known.err}; }
        cache_key.bytes(?b, ?imported[0], 32);
        d = d + 1;
    }
    var digest: [32]u8;
    val done:   err[fail.Fail] = cache_key.finish(?b, ?digest);
    if (sel done.err) { ret res[query.QueryOutput, fail.Fail].err{done.err}; }
    var fb: wire.Sink = wire.grown(alloc);
    fin { wire.dnit(?fb); }
    wire.put_bytes(?fb, ?digest[0], WIDTH::u64);
    ret codec.output(?fb);
}

# the files module `mid` embeds, by status, length and digest, never by path
fun embeds(b: *cache_key.Builder, p: *project.Project, mid: module.ModuleId) err[fail.Fail] {
    var paths: Vector[str] = collections_vector.init[str](p.s.alloc);
    fin {
        var i: usize = 0;
        for (i < paths.len) {
            str_free(p.s.alloc, paths.data[i]);
            i = i + 1;
        }
        collections_vector.dnit[str](?paths);
    }
    val collected: err[fail.Fail] = declared.module_embeds(p, mid, ?paths);
    if (sel collected.err) { ret collected; }
    cache_key.number(b, paths.len::u64);
    var i: usize = 0;
    for (i < paths.len) {
        val named: res[intern.StrId, A.Error] = intern.add(?p.s.interner, paths.data[i]);
        if (sel named.err) { ret err[fail.Fail].err{fail.refused(named.err)}; }
        val read: err[fail.Fail] = query.depend[project.Project](?p.queries, p, ?session_embed.EMBED_FILE, intern.str_index(named.ok)::u64);
        if (sel read.err) { ret read; }
        val found: opt[*session_embed.EmbedFile] = session_embed.get(?p.s.embeds, named.ok);
        if (sel found.some) {
            val e: *session_embed.EmbedFile = found.some;
            cache_key.number(b, e.status::u64);
            cache_key.number(b, e.len::u64);
            cache_key.bytes(b, ?e.digest[0], 32);
        }
        or { cache_key.number(b, 0xFFFFFFFF); }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}
