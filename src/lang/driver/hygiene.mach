# the compiler's own source held to its rules, read from the checkout: each module is
# imported under one name and each name imports one module, no pub declaration is named
# only in its own file unless its doc comment says what reaches it, driver imports nothing
# of build, a file directly under src/lang is a foundation or the facade of a shadow
# module, and the layers the imports form: the front and middle end reach no backend, the
# target tree and the pipeline meet only in the contract, and no test import climbs above
# its module's layer
use std.allocator.arena;
use std.allocator.page;
use collections_vector: std.collections.vector;
use std.collections.vector.Vector;
use fs:       std.filesystem;
use io_error: std.io.error;
use std.print;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use types_path: std.types.path;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_ends_with;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.string.str_region_equals;

use A: std.allocator;

use mach.lang.checkout;
use mach.lang.diagnostic;
use mach.lang.fail;
use mach.lang.fe.ast;
use ast_decl:   mach.lang.fe.ast.decl;
use ast_id:     mach.lang.fe.ast.id;
use ast_module: mach.lang.fe.ast.module;
use fe_lexer:   mach.lang.fe.lexer;
use fe_parser:  mach.lang.fe.parser;
use mach.lang.fe.parser.state;
use mach.lang.fe.resolve;
use mach.lang.fe.token;
use mach.lang.intern;
use mach.lang.listing;
use mach.lang.module;
use lang_source: mach.lang.source;

#[testing]
val NONE: u32 = 0xFFFFFFFF;

# the code that leaves for mirl, masc and mink: each prefix is a module and
# every module under it
#[testing]
val LEAVING_N: usize          = 13;
#[testing]
val LEAVING:   [LEAVING_N]str = [LEAVING_N]str{
    "mach.lang.be.codegen",
    "mach.lang.be.linker",
    "mach.lang.ct",
    "mach.lang.layout",
    "mach.lang.me",
    "mach.lang.mir",
    "mach.lang.target.abi",
    "mach.lang.target.catalog",
    "mach.lang.target.extension",
    "mach.lang.target.isa",
    "mach.lang.target.model",
    "mach.lang.target.of",
    "mach.lang.target.os",
};

# what stays under a leaving prefix: lowering is rebuilt in place onto mirl
#[testing]
val KEPT_N: usize       = 1;
#[testing]
val KEPT:   [KEPT_N]str = [KEPT_N]str{"mach.lang.me.lower"};

# how a doc comment line opens, after its `#` and blanks, to keep a pub
# declaration that no other file names: "reached through the ROWS table",
# "reached only by mach-lsp"
#[testing]
val MARKERS_N: usize          = 2;
#[testing]
val MARKERS:   [MARKERS_N]str = [MARKERS_N]str{"reached through ", "reached only by "};

# a `use` in a staying file: the name it binds and the path it imports; a gated
# use sits in an arm of a declaration-level `$if`
#[testing]
rec Binding {
    file:  u32;
    line:  usize;
    name:  intern.StrId;
    path:  intern.StrId;
    gated: bool;
}

# a pub declaration in a staying file, and whether its doc comment says what
# reaches it
#[testing]
rec Surface {
    file:   u32;
    line:   usize;
    name:   intern.StrId;
    exempt: bool;
}

# the source tree as the checks read it, in alloc, with each file's text and
# syntax in an arena over backing released once the file is read. first and shared are by name index:
# the first file naming the name, and whether another file names it too
#[testing]
rec Tree {
    alloc:    *A.Allocator;
    backing:  *A.Allocator;
    itn:      intern.Interner;
    paths:    Vector[str];
    bindings: Vector[Binding];
    surface:  Vector[Surface];
    first:    Vector[u32];
    shared:   Vector[bool];
    src:      str;
    fqns:     Vector[intern.StrId];
    starts:   Vector[u32];
    imports:  Vector[Import];
    by_fqn:   Vector[u32];
}

# a `use` in any file, leaving or staying, read for layering: the path it names,
# the file of the module that path is or names a member of, NONE outside the tree,
# and whether `#[testing]` confines it to tests. the imports of file f run from
# starts[f] to the next file's start
#[testing]
rec Import {
    file:    u32;
    line:    usize;
    path:    intern.StrId;
    to:      u32;
    testing: bool;
}

# where a scan stands in a file's text, so lines are counted once
#[testing]
rec Cursor {
    text:   str;
    offset: usize;
    line:   usize;
}

#[testing]
fun under(name: str, prefix: str) bool {
    val n: usize = str_len(prefix);
    if (str_len(name) < n || !str_region_equals(name, 0, n, prefix)) { ret false; }
    ret name[n] == 0 || name[n] == '.';
}

# whether the module or symbol a dotted name spells leaves at the split
#[testing]
fun leaves(name: str) bool {
    var i: usize = 0;
    for (i < KEPT_N) {
        if (under(name, KEPT[i])) { ret false; }
        i = i + 1;
    }
    i = 0;
    for (i < LEAVING_N) {
        if (under(name, LEAVING[i])) { ret true; }
        i = i + 1;
    }
    ret false;
}

#[testing]
fun is_dir(path: str) bool {
    val r: res[bool, io_error.Error] = fs.is_dir(path);
    if (sel r.ok) { ret r.ok; }
    ret false;
}

# the line of `offset`, which no earlier call on the cursor passed
#[testing]
fun line_at(c: *Cursor, offset: usize) usize {
    if (offset < c.offset) {
        c.offset = 0;
        c.line   = 1;
    }
    for (c.offset < offset) {
        if (c.text[c.offset] == '\n') { c.line = c.line + 1; }
        c.offset = c.offset + 1;
    }
    ret c.line;
}

# whether a line of the doc comment `span` opens with a marker
#[testing]
fun marked(text: str, span: lang_source.Span) bool {
    val end: usize = span.offset + span.len;
    var at:  usize = span.offset;
    for (at < end) {
        var p: usize = at;
        for (p < end && (text[p] == '#' || text[p] == ' ' || text[p] == '\t')) { p = p + 1; }
        var m: usize = 0;
        for (m < MARKERS_N) {
            val n: usize = str_len(MARKERS[m]);
            if (p + n <= end && str_region_equals(?text[p], 0, n, MARKERS[m])) { ret true; }
            m = m + 1;
        }
        for (at < end && text[at] != '\n') { at = at + 1; }
        at = at + 1;
    }
    ret false;
}

# file f names the name `id`
#[testing]
fun mark(t: *Tree, id: intern.StrId, f: u32) err[fail.Fail] {
    val at: usize = intern.str_index(id)::usize;
    for (t.first.len <= at) {
        val pf: res[usize, A.Error] = collections_vector.push[u32](?t.first, NONE);
        if (sel pf.err) { ret err[fail.Fail].err{fail.refused(pf.err)}; }
        val ps: res[usize, A.Error] = collections_vector.push[bool](?t.shared, false);
        if (sel ps.err) { ret err[fail.Fail].err{fail.refused(ps.err)}; }
    }
    if (t.first.data[at] == NONE) { t.first.data[at] = f; }
    or (t.first.data[at] != f)    { t.shared.data[at] = true; }
    ret err[fail.Fail].ok{};
}

#[testing]
fun bind(t: *Tree, f: u32, text: str, c: *Cursor, d: *ast_decl.Decl) err[fail.Fail] {
    val path: lang_source.Span           = d.data.use_.path;
    val rp:   res[intern.StrId, A.Error] = intern.range_add(?t.itn, text, path.offset, path.len);
    if (sel rp.err)                         { ret err[fail.Fail].err{fail.refused(rp.err)}; }
    if (leaves(intern.text(?t.itn, rp.ok))) { ret err[fail.Fail].ok{}; }

    # an unaliased use binds the path's leaf
    var name: lang_source.Span = d.data.use_.alias;
    if (name.len == 0) {
        var at: usize = path.offset + path.len;
        for (at > path.offset && text[at - 1] != '.') { at = at - 1; }
        name = lang_source.span(at, path.offset + path.len - at);
    }
    val rn: res[intern.StrId, A.Error] = intern.range_add(?t.itn, text, name.offset, name.len);
    if (sel rn.err) { ret err[fail.Fail].err{fail.refused(rn.err)}; }

    val b:      Binding             = Binding{file: f, line: line_at(c, d.span.offset), name: rn.ok, path: rp.ok, gated: (d.flags & ast_decl.DECL_FLAG_GATED) != 0};
    val pushed: res[usize, A.Error] = collections_vector.push[Binding](?t.bindings, b);
    if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
    ret err[fail.Fail].ok{};
}

#[testing]
fun publishes(d: *ast_decl.Decl) bool {
    if ((d.flags & ast_decl.DECL_FLAG_PUB) == 0)                                                                  { ret false; }
    if (d.kind == ast_decl.DECL_KIND_FUN || d.kind == ast_decl.DECL_KIND_REC || d.kind == ast_decl.DECL_KIND_UNI) { ret true; }
    if (d.kind == ast_decl.DECL_KIND_TAG || d.kind == ast_decl.DECL_KIND_DEF)                                     { ret true; }
    ret d.kind == ast_decl.DECL_KIND_VAL || d.kind == ast_decl.DECL_KIND_VAR;
}

#[testing]
fun record(t: *Tree, f: u32, text: str, c: *Cursor, d: *ast_decl.Decl, testing: bool) err[fail.Fail] {
    val path: lang_source.Span           = d.data.use_.path;
    val rp:   res[intern.StrId, A.Error] = intern.range_add(?t.itn, text, path.offset, path.len);
    if (sel rp.err) { ret err[fail.Fail].err{fail.refused(rp.err)}; }
    val pushed: res[usize, A.Error] = collections_vector.push[Import](?t.imports, Import{file: f, line: line_at(c, d.span.offset), path: rp.ok, to: NONE, testing: testing});
    if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
    ret err[fail.Fail].ok{};
}

# the module-scope declarations from `start`, through every arm of a
# declaration-level `$if`; every file's imports are recorded, and a staying
# file's bindings and pub surface
#[testing]
fun walk(t: *Tree, f: u32, text: str, c: *Cursor, a: *ast.Ast, start: u32, len: u32, stays: bool) err[fail.Fail] {
    var i: u32 = 0;
    for (i < len) {
        val did: ast_id.DeclId  = a.decl_ids.data[start + i];
        val d:   *ast_decl.Decl = ?a.decls.data[ast_id.decl_index(did)];
        i = i + 1;
        if (d.kind == ast_decl.DECL_KIND_COMPTIME_IF) {
            var b: u32 = 0;
            for (b < d.data.comptime_if.branches_len) {
                val br:     *ast_decl.ComptimeBranch = ?a.comptime_branches.data[d.data.comptime_if.branches_start + b];
                val walked: err[fail.Fail]           = walk(t, f, text, c, a, br.body_start, br.body_len, stays);
                if (sel walked.err) { ret walked; }
                b = b + 1;
            }
            cnt;
        }
        if (d.kind == ast_decl.DECL_KIND_USE) {
            val recorded: err[fail.Fail] = record(t, f, text, c, d, resolve.declaration_testing(a, did));
            if (sel recorded.err) { ret recorded; }
            if (!stays)           { cnt; }
            val bound: err[fail.Fail] = bind(t, f, text, c, d);
            if (sel bound.err) { ret bound; }
            cnt;
        }
        if (!stays || !publishes(d)) { cnt; }
        val span: lang_source.Span           = ast.decl_name_span(a, did);
        val rn:   res[intern.StrId, A.Error] = intern.range_add(?t.itn, text, span.offset, span.len);
        if (sel rn.err) { ret err[fail.Fail].err{fail.refused(rn.err)}; }
        val s:      Surface             = Surface{file: f, line: line_at(c, span.offset), name: rn.ok, exempt: marked(text, d.doc)};
        val pushed: res[usize, A.Error] = collections_vector.push[Surface](?t.surface, s);
        if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
    }
    ret err[fail.Fail].ok{};
}

# every name file f spells and every module it imports, and when it stays, its
# bindings and pub surface; the text and its syntax live in `scratch`, released
# by the caller
#[testing]
fun scan(t: *Tree, scratch: *A.Allocator, f: u32, path: str, stays: bool) err[fail.Fail] {
    val rt: res[str, fs.FsError] = fs.read_string(scratch, path);
    if (sel rt.err) { ret err[fail.Fail].err{fail.fs_refused(rt.err)}; }
    val text: str = rt.ok;

    val tr: res[fe_lexer.TokenStream, fail.Fail] = fe_lexer.tokenize(text, scratch, lang_source.FILE_NIL);
    if (sel tr.err) { ret err[fail.Fail].err{tr.err}; }
    var stream: fe_lexer.TokenStream = tr.ok;
    var k:      usize                = 0;
    for (k < stream.len) {
        val tok: token.Token = stream.tokens[k];
        k = k + 1;
        if (tok.kind != token.KIND_IDENT) { cnt; }
        val rn: res[intern.StrId, A.Error] = intern.range_add(?t.itn, text, tok.span.offset, tok.span.len);
        if (sel rn.err) { ret err[fail.Fail].err{fail.refused(rn.err)}; }
        val marked: err[fail.Fail] = mark(t, rn.ok, f);
        if (sel marked.err) { ret marked; }
    }

    var diags: diagnostic.DiagnosticStore             = diagnostic.store_init(scratch);
    var a:     ast.Ast                                = ast.init(scratch, lang_source.FILE_NIL);
    val pr:    res[fail.PhaseStatus, state.ParseFail] = fe_parser.parse(?stream, ?a, ?diags);
    if (sel pr.err || diagnostic.has_errors(?diags)) { ret err[fail.Fail].err{fail.message("the file does not parse")}; }

    var c: Cursor             = Cursor{text: text, offset: 0, line: 1};
    val m: *ast_module.Module = ?a.modules.data[ast_id.module_node_index(a.root_module)];
    ret walk(t, f, text, ?c, ?a, m.decls_start, m.decls_len, stays);
}

#[testing]
fun collect(t: *Tree, src: str, dir: str) err[fail.Fail] {
    val rd: res[Vector[fs.Listed], fs.FsError] = fs.read_dir(t.alloc, dir);
    if (sel rd.err) { ret err[fail.Fail].err{fail.fs_refused(rd.err)}; }
    var entries: Vector[fs.Listed] = rd.ok;
    fin { fs.listed_free(?entries); }
    val rn: res[Vector[str], fail.Fail] = listing.names(t.alloc, dir, ?entries);
    if (sel rn.err) { ret err[fail.Fail].err{rn.err}; }
    var names: Vector[str] = rn.ok;
    fin { collections_vector.dnit[str](?names); }
    var i: usize = 0;
    for (i < names.len) {
        val name: str = names.data[i];
        i = i + 1;
        if (str_equals(name, ".") || str_equals(name, "..")) { cnt; }
        val rj: res[str, A.Error] = types_path.join(t.alloc, dir, name);
        if (sel rj.err) { ret err[fail.Fail].err{fail.refused(rj.err)}; }
        val path: str = rj.ok;
        if (is_dir(path)) {
            val e: err[fail.Fail] = collect(t, src, path);
            if (sel e.err) { ret e; }
            cnt;
        }
        if (!str_ends_with(path, ".mach")) { cnt; }

        val rel: str                          = (?path[str_len(src) + 1])::str;
        val rm:  res[intern.StrId, fail.Fail] = module.compose_fqn(t.alloc, ?t.itn, "mach", rel);
        if (sel rm.err) { ret err[fail.Fail].err{rm.err}; }
        val f:      u32                 = t.paths.len::u32;
        val pushed: res[usize, A.Error] = collections_vector.push[str](?t.paths, rel);
        if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
        val pf: res[usize, A.Error] = collections_vector.push[intern.StrId](?t.fqns, rm.ok);
        if (sel pf.err) { ret err[fail.Fail].err{fail.refused(pf.err)}; }
        val ps: res[usize, A.Error] = collections_vector.push[u32](?t.starts, t.imports.len::u32);
        if (sel ps.err) { ret err[fail.Fail].err{fail.refused(ps.err)}; }

        var ar:      arena.Arena;
        var scratch: A.Allocator;
        val made:    err[A.Error] = arena.init(?ar, t.backing, 0);
        if (sel made.err) { ret err[fail.Fail].err{fail.refused(made.err)}; }
        arena.make(?scratch, ?ar);
        val scanned: err[fail.Fail] = scan(t, ?scratch, f, path, !leaves(intern.text(?t.itn, rm.ok)));
        arena.dnit(?ar);
        if (sel scanned.err) {
            print.eprintlnf("hygiene: {}: {}", rel, fail.describe(scanned.err));
            ret scanned;
        }
    }
    ret err[fail.Fail].ok{};
}

# the tree under the source root, or none with the reason printed
#[testing]
fun load(alloc: *A.Allocator, backing: *A.Allocator, t: *Tree) bool {
    t.alloc    = alloc;
    t.backing  = backing;
    t.itn      = intern.init(alloc);
    t.paths    = collections_vector.init[str](alloc);
    t.bindings = collections_vector.init[Binding](alloc);
    t.surface  = collections_vector.init[Surface](alloc);
    t.first    = collections_vector.init[u32](alloc);
    t.shared   = collections_vector.init[bool](alloc);
    t.fqns     = collections_vector.init[intern.StrId](alloc);
    t.starts   = collections_vector.init[u32](alloc);
    t.imports  = collections_vector.init[Import](alloc);
    val rs: opt[str] = checkout.path(alloc, "src");
    if (sel rs.none) { ret false; }
    t.src = rs.some;
    val walked: err[fail.Fail] = collect(t, rs.some, rs.some);
    if (sel walked.err) { ret false; }
    val resolved: err[fail.Fail] = resolve_imports(t);
    if (sel resolved.err) {
        print.eprintln(fail.describe(resolved.err));
        ret false;
    }
    ret true;
}

# the file of the module `id` names, NONE when it names none in the tree
#[testing]
fun file_of(t: *Tree, id: intern.StrId) u32 {
    val at: usize = intern.str_index(id)::usize;
    if (at >= t.by_fqn.len) { ret NONE; }
    ret t.by_fqn.data[at];
}

# each import's file: the module its path names, or the longest module prefix
# of a member's path
#[testing]
fun resolve_imports(t: *Tree) err[fail.Fail] {
    t.by_fqn = index(t);
    var f: usize = 0;
    for (f < t.fqns.len) {
        t.by_fqn.data[intern.str_index(t.fqns.data[f])] = f::u32;
        f                                               = f + 1;
    }
    var i: usize = 0;
    for (i < t.imports.len) {
        val m:    *Import = ?t.imports.data[i];
        val path: str     = intern.text(?t.itn, m.path);
        i = i + 1;
        var len: usize = str_len(path);
        for (len > 0 && m.to == NONE) {
            val rp: res[intern.StrId, A.Error] = intern.range_add(?t.itn, path, 0, len);
            if (sel rp.err) { ret err[fail.Fail].err{fail.refused(rp.err)}; }
            m.to = file_of(t, rp.ok);
            len  = len - 1;
            for (len > 0 && path[len] != '.') { len = len - 1; }
        }
    }
    ret err[fail.Fail].ok{};
}

# by name index, NONE everywhere
#[testing]
fun index(t: *Tree) Vector[u32] {
    var v: Vector[u32] = collections_vector.init[u32](t.alloc);
    var i: usize       = 0;
    for (i < intern.count(?t.itn)) {
        collections_vector.push[u32](?v, NONE);
        i = i + 1;
    }
    ret v;
}

# the bindings that import a path under a second name, or bind a name to a
# second path, each printed; the arms of a declaration-level `$if` may bind one
# name to a module apiece, so a gated binding is held to the first rule only
#[testing]
fun alias_violations(t: *Tree) usize {
    var by_path: Vector[u32] = index(t);
    var by_name: Vector[u32] = index(t);
    var count:   usize       = 0;
    var i:       usize       = 0;
    for (i < t.bindings.len) {
        val b:  *Binding = ?t.bindings.data[i];
        val pi: usize    = intern.str_index(b.path)::usize;
        if (by_path.data[pi] == NONE) { by_path.data[pi] = i::u32; }
        or {
            val o: *Binding = ?t.bindings.data[by_path.data[pi]];
            if (!intern.str_same(o.name, b.name)) {
                print.eprintlnf("hygiene: {}:{}: {} is imported as {}, and as {} at {}:{}", t.paths.data[b.file], b.line, intern.text(?t.itn, b.path), intern.text(?t.itn, b.name), intern.text(?t.itn, o.name), t.paths.data[o.file], o.line);
                count = count + 1;
            }
        }
        if (!b.gated) {
            val ni: usize = intern.str_index(b.name)::usize;
            if (by_name.data[ni] == NONE) { by_name.data[ni] = i::u32; }
            or {
                val o: *Binding = ?t.bindings.data[by_name.data[ni]];
                if (!intern.str_same(o.path, b.path)) {
                    print.eprintlnf("hygiene: {}:{}: {} names {}, and {} at {}:{}", t.paths.data[b.file], b.line, intern.text(?t.itn, b.name), intern.text(?t.itn, b.path), intern.text(?t.itn, o.path), t.paths.data[o.file], o.line);
                    count = count + 1;
                }
            }
        }
        i = i + 1;
    }
    ret count;
}

# the pub declarations no other file names and whose doc says nothing reaches
# them, each printed
#[testing]
fun surface_violations(t: *Tree) usize {
    var count: usize = 0;
    var i:     usize = 0;
    for (i < t.surface.len) {
        val s: *Surface = ?t.surface.data[i];
        i = i + 1;
        if (s.exempt || t.shared.data[intern.str_index(s.name)]) { cnt; }
        print.eprintlnf("hygiene: {}:{}: pub {} is named only in its own file; drop pub, or say in its doc comment what reaches it", t.paths.data[s.file], s.line, intern.text(?t.itn, s.name));
        count = count + 1;
    }
    ret count;
}

# the files of the driver that import a module of build, each printed; build is
# the layer above
#[testing]
fun driver_violations(t: *Tree) usize {
    var count: usize = 0;
    var i:     usize = 0;
    for (i < t.imports.len) {
        val m:    *Import = ?t.imports.data[i];
        val from: str     = intern.text(?t.itn, t.fqns.data[m.file]);
        i = i + 1;
        if (!under(from, "mach.lang.driver"))                       { cnt; }
        if (!under(intern.text(?t.itn, m.path), "mach.lang.build")) { cnt; }
        print.eprintlnf("hygiene: {}:{}: the driver imports {}, of build, the layer above it", t.paths.data[m.file], m.line, intern.text(?t.itn, m.path));
        count = count + 1;
    }
    ret count;
}

# the segments of a dotted name
#[testing]
fun segments(name: str) usize {
    var n:  usize = 1;
    var at: usize = 0;
    for (name[at] != 0) {
        if (name[at] == '.') { n = n + 1; }
        at = at + 1;
    }
    ret n;
}

# whether file f lies directly under src/lang
#[testing]
fun loose(t: *Tree, f: usize) bool {
    val fqn: str = intern.text(?t.itn, t.fqns.data[f]);
    ret under(fqn, "mach.lang") && segments(fqn) == 3;
}

# whether file f, directly under src/lang, has a shadow module: lang/fe.mach
# and the modules under lang/fe
#[testing]
fun facade(t: *Tree, f: usize) bool {
    val fqn: str   = intern.text(?t.itn, t.fqns.data[f]);
    var g:   usize = 0;
    for (g < t.fqns.len) {
        if (g != f && under(intern.text(?t.itn, t.fqns.data[g]), fqn)) { ret true; }
        g = g + 1;
    }
    ret false;
}

# a file a foundation may import: one directly under src/lang, or one in the
# shadow module of a facade there
#[testing]
fun candidate(t: *Tree, f: usize) bool {
    val fqn: str = intern.text(?t.itn, t.fqns.data[f]);
    if (!under(fqn, "mach.lang")) { ret false; }
    if (segments(fqn) == 3)       { ret true; }
    var len: usize = 10;
    for (fqn[len] != '.') { len = len + 1; }
    val rp: res[intern.StrId, A.Error] = intern.range_add(?t.itn, fqn, 0, len);
    if (sel rp.err) { ret false; }
    ret file_of(t, rp.ok) != NONE;
}

# the import of file f that is neither std nor a foundation, or NONE
#[testing]
fun blocker(t: *Tree, founds: *Vector[bool], f: usize) u32 {
    var i:   usize = t.starts.data[f]::usize;
    var end: usize = t.imports.len;
    if (f + 1 < t.starts.len) { end = t.starts.data[f + 1]::usize; }
    for (i < end) {
        val m: *Import = ?t.imports.data[i];
        i = i + 1;
        if (under(intern.text(?t.itn, m.path), "std")) { cnt; }
        if (m.to != NONE && founds.data[m.to])         { cnt; }
        ret (i - 1)::u32;
    }
    ret NONE;
}

# by file, whether it is a foundation: a candidate whose every import is std or
# a foundation. every candidate starts as one and loses it once an import does
# not qualify, until none changes, so a cycle of foundations stays one
#[testing]
fun foundations(t: *Tree) Vector[bool] {
    var founds: Vector[bool] = collections_vector.init[bool](t.alloc);
    var f:      usize        = 0;
    for (f < t.paths.len) {
        collections_vector.push[bool](?founds, candidate(t, f));
        f = f + 1;
    }
    var changed: bool = true;
    for (changed) {
        changed = false;
        f       = 0;
        for (f < t.paths.len) {
            if (founds.data[f] && blocker(t, ?founds, f) != NONE) {
                founds.data[f] = false;
                changed        = true;
            }
            f = f + 1;
        }
    }
    ret founds;
}

# the files directly under src/lang that are neither the facade of a shadow
# module nor a foundation, each printed with the import that keeps it from
# being one; editor.mach is split by S4 #4454
#[testing]
fun loose_violations(t: *Tree) usize {
    var founds: Vector[bool] = foundations(t);
    var count:  usize        = 0;
    var f:      usize        = 0;
    for (f < t.paths.len) {
        val rel: str = t.paths.data[f];
        f = f + 1;
        if (!loose(t, f - 1) || founds.data[f - 1] || facade(t, f - 1))              { cnt; }
        if (str_equals(intern.text(?t.itn, t.fqns.data[f - 1]), "mach.lang.editor")) { cnt; }
        val b: *Import = ?t.imports.data[blocker(t, ?founds, f - 1)];
        print.eprintlnf("hygiene: {}:{}: a loose file imports {}, which is not std or a foundation; make it a foundation, or the facade of a shadow module", rel, b.line, intern.text(?t.itn, b.path));
        count = count + 1;
    }
    ret count;
}

# the modules the front end and the middle end may read under the target tree: every
# other target module is a backend member, contract or facade
#[testing]
fun is_description(name: str) bool {
    if (under(name, "mach.lang.target.catalog") && !str_equals(name, "mach.lang.target.catalog")) { ret true; }
    if (under(name, "mach.lang.target.extension") || under(name, "mach.lang.target.model"))       { ret true; }
    ret str_equals(name, "mach.lang.target.definition") || str_equals(name, "mach.lang.target.resolved");
}

#[testing]
fun is_backend(name: str) bool {
    ret under(name, "mach.lang.be") || (under(name, "mach.lang.target") && !is_description(name));
}

#[testing]
fun is_pipeline(name: str) bool {
    ret under(name, "mach.lang.be");
}

#[testing]
fun is_target(name: str) bool {
    ret under(name, "mach.lang.target");
}

#[testing]
fun is_contract(name: str) bool {
    ret under(name, "mach.lang.mir");
}

# what the contract may not reach: the pipeline, and any target module but the description
#[testing]
fun is_contract_forbidden(name: str) bool {
    ret is_pipeline(name) || (is_target(name) && !is_description(name));
}

#[testing]
fun is_guarded(name: str) bool {
    ret under(name, "mach.lang.fe") || under(name, "mach.lang.me");
}

# the layer a module sits in, lowest first: the target description, the front end, the
# middle end, the backend contract, the backend with the target facade, and the
# composition that drives them all. the middle end's pipeline drives its passes over a
# selected target, so it sits with the backend. zero is a module outside the layers, such
# as the session and the source map every layer shares
#[testing]
fun layer_of(name: str) u32 {
    if (is_description(name))                                                                                        { ret 1; }
    if (under(name, "mach.lang.fe"))                                                                                 { ret 2; }
    if (under(name, "mach.lang.me"))                                                                                 { ret 3; }
    if (is_contract(name))                                                                                           { ret 4; }
    if (is_backend(name))                                                                                            { ret 5; }
    if (under(name, "mach.lang.driver") || (under(name, "mach.lang.build") && !str_equals(name, "mach.lang.build"))) { ret 6; }
    if (str_equals(name, "mach.lang.step") || str_equals(name, "mach.lang.editor") || under(name, "mach.cli"))       { ret 6; }
    ret 0;
}

#[testing]
def NamePredicate: fun(str) bool;

#[testing]
fun fqn_of(t: *Tree, f: usize) str {
    ret intern.text(?t.itn, t.fqns.data[f]);
}

# the end of file f's imports
#[testing]
fun imports_end(t: *Tree, f: usize) usize {
    if (f + 1 < t.starts.len) { ret t.starts.data[f + 1]::usize; }
    ret t.imports.len;
}

# by file, whether the imports from the files `seeds` marks reach it, the seeds included;
# a test's import is followed only when `testing` is; by[f] is the file that first imported
# f, NONE for a seed
#[testing]
fun reach(t: *Tree, seeds: *Vector[bool], testing: bool, by: *Vector[u32]) Vector[bool] {
    var seen:  Vector[bool] = collections_vector.init[bool](t.alloc);
    var queue: Vector[u32]  = collections_vector.init[u32](t.alloc);
    var f:     usize        = 0;
    for (f < t.paths.len) {
        collections_vector.push[bool](?seen, seeds.data[f]);
        collections_vector.push[u32](by, NONE);
        if (seeds.data[f]) { collections_vector.push[u32](?queue, f::u32); }
        f = f + 1;
    }
    var head: usize = 0;
    for (head < queue.len) {
        val from: usize = queue.data[head]::usize;
        head = head + 1;
        var i: usize = t.starts.data[from]::usize;
        for (i < imports_end(t, from)) {
            val m: *Import = ?t.imports.data[i];
            i = i + 1;
            if (m.to == NONE || seen.data[m.to] || (m.testing && !testing)) { cnt; }
            seen.data[m.to] = true;
            by.data[m.to]   = from::u32;
            collections_vector.push[u32](?queue, m.to);
        }
    }
    ret seen;
}

# by file, whether the compiler's entry reaches it through production imports
#[testing]
fun production(t: *Tree) Vector[bool] {
    var seeds: Vector[bool] = collections_vector.init[bool](t.alloc);
    var f:     usize        = 0;
    for (f < t.paths.len) {
        collections_vector.push[bool](?seeds, str_equals(fqn_of(t, f), "mach.bin.main"));
        f = f + 1;
    }
    var by: Vector[u32] = collections_vector.init[u32](t.alloc);
    ret reach(t, ?seeds, false, ?by);
}

# the files the production files `root` picks reach through production imports that
# `forbidden` picks, each printed with the chain that imports it; NONE when `root` picks
# none, since nothing would be checked
#[testing]
fun crossings(t: *Tree, live: *Vector[bool], root: NamePredicate, forbidden: NamePredicate, what: str) usize {
    var seeds: Vector[bool] = collections_vector.init[bool](t.alloc);
    var roots: usize        = 0;
    var f:     usize        = 0;
    for (f < t.paths.len) {
        val picked: bool = live.data[f] && root(fqn_of(t, f));
        collections_vector.push[bool](?seeds, picked);
        if (picked) { roots = roots + 1; }
        f = f + 1;
    }
    if (roots == 0) {
        print.eprintlnf("hygiene: the entry reaches no module of {}, so nothing was checked", what);
        ret NONE::usize;
    }
    var by:      Vector[u32]  = collections_vector.init[u32](t.alloc);
    var seen:    Vector[bool] = reach(t, ?seeds, false, ?by);
    var crossed: usize        = 0;
    f = 0;
    for (f < t.paths.len) {
        if (seen.data[f] && forbidden(fqn_of(t, f))) {
            crossed = crossed + 1;
            print.eprintlnf("hygiene: {} is reached from {}:", fqn_of(t, f), what);
            var step: u32 = by.data[f];
            for (step != NONE) {
                print.eprintlnf("    imported by {}", fqn_of(t, step::usize));
                step = by.data[step];
            }
        }
        f = f + 1;
    }
    ret crossed;
}

# the test imports of a file `from` picks that name a file `forbidden` picks, each printed
#[testing]
fun test_crossings(t: *Tree, from: NamePredicate, forbidden: NamePredicate, what: str) usize {
    var crossed: usize = 0;
    var i:       usize = 0;
    for (i < t.imports.len) {
        val m: *Import = ?t.imports.data[i];
        i = i + 1;
        if (!m.testing || m.to == NONE || !from(fqn_of(t, m.file::usize))) { cnt; }
        if (!forbidden(fqn_of(t, m.to::usize)))                            { cnt; }
        crossed = crossed + 1;
        print.eprintlnf("hygiene: the tests of {} import {}, from {}", fqn_of(t, m.file::usize), fqn_of(t, m.to::usize), what);
    }
    ret crossed;
}

# the test imports of production files in a layer that name a file above it which the
# file's production imports do not already reach, each printed; NONE when no layered
# production file imports anything for its tests
#[testing]
fun climbs(t: *Tree, live: *Vector[bool]) usize {
    var checked: usize = 0;
    var crossed: usize = 0;
    var f:       usize = 0;
    for (f < t.paths.len) {
        val rank:  u32   = layer_of(fqn_of(t, f));
        var tests: bool  = false;
        var i:     usize = t.starts.data[f]::usize;
        for (i < imports_end(t, f)) {
            if (t.imports.data[i].testing) { tests = true; }
            i = i + 1;
        }
        if (!live.data[f] || rank == 0 || !tests) {
            f = f + 1;
            cnt;
        }
        checked = checked + 1;
        var seeds: Vector[bool] = collections_vector.init[bool](t.alloc);
        var g:     usize        = 0;
        for (g < t.paths.len) {
            collections_vector.push[bool](?seeds, g == f);
            g = g + 1;
        }
        var by:   Vector[u32]  = collections_vector.init[u32](t.alloc);
        var seen: Vector[bool] = reach(t, ?seeds, false, ?by);
        i = t.starts.data[f]::usize;
        for (i < imports_end(t, f)) {
            val m: *Import = ?t.imports.data[i];
            i = i + 1;
            if (!m.testing || m.to == NONE || seen.data[m.to]) { cnt; }
            if (layer_of(fqn_of(t, m.to::usize)) <= rank)      { cnt; }
            crossed = crossed + 1;
            print.eprintlnf("hygiene: {}:{}: the tests of {} import {}, a layer above it; give the module a fixture at its own layer", t.paths.data[f], m.line, fqn_of(t, f), fqn_of(t, m.to::usize));
        }
        f = f + 1;
    }
    if (checked == 0) {
        print.eprintln("hygiene: no layered module imports anything for its tests, so nothing was checked");
        ret NONE::usize;
    }
    ret crossed;
}

test hygiene__each_module_is_imported_under_one_name {
    var backing: A.Allocator;
    page.make(?backing);
    var ar:    arena.Arena;
    var alloc: A.Allocator;
    val made:  err[A.Error] = arena.init(?ar, ?backing, 0);
    if (sel made.err) { ret 1; }
    arena.make(?alloc, ?ar);
    var t: Tree;
    if (!load(?alloc, ?backing, ?t)) { ret 1; }
    if (t.bindings.len == 0)         { ret 2; }
    if (alias_violations(?t) != 0)   { ret 3; }
    ret 0;
}

test hygiene__no_pub_declaration_is_named_only_in_its_own_file {
    var backing: A.Allocator;
    page.make(?backing);
    var ar:    arena.Arena;
    var alloc: A.Allocator;
    val made:  err[A.Error] = arena.init(?ar, ?backing, 0);
    if (sel made.err) { ret 1; }
    arena.make(?alloc, ?ar);
    var t: Tree;
    if (!load(?alloc, ?backing, ?t)) { ret 1; }
    if (t.surface.len == 0)          { ret 2; }
    if (surface_violations(?t) != 0) { ret 3; }
    ret 0;
}

test hygiene__the_driver_imports_nothing_of_build {
    var backing: A.Allocator;
    page.make(?backing);
    var ar:    arena.Arena;
    var alloc: A.Allocator;
    val made:  err[A.Error] = arena.init(?ar, ?backing, 0);
    if (sel made.err) { ret 1; }
    arena.make(?alloc, ?ar);
    var t: Tree;
    if (!load(?alloc, ?backing, ?t)) { ret 1; }
    if (t.imports.len == 0)          { ret 2; }
    if (driver_violations(?t) != 0)  { ret 3; }
    ret 0;
}

test hygiene__each_loose_file_is_a_foundation_or_a_facade {
    var backing: A.Allocator;
    page.make(?backing);
    var ar:    arena.Arena;
    var alloc: A.Allocator;
    val made:  err[A.Error] = arena.init(?ar, ?backing, 0);
    if (sel made.err) { ret 1; }
    arena.make(?alloc, ?ar);
    var t: Tree;
    if (!load(?alloc, ?backing, ?t)) { ret 1; }
    if (t.imports.len == 0)          { ret 2; }
    if (loose_violations(?t) != 0)   { ret 3; }
    ret 0;
}

test layering__front_and_middle_end_reach_no_backend {
    var backing: A.Allocator;
    page.make(?backing);
    var ar:    arena.Arena;
    var alloc: A.Allocator;
    val made:  err[A.Error] = arena.init(?ar, ?backing, 0);
    if (sel made.err) { ret 1; }
    arena.make(?alloc, ?ar);
    var t: Tree;
    if (!load(?alloc, ?backing, ?t)) { ret 1; }
    var live:    Vector[bool] = production(?t);
    val crossed: usize        = crossings(?t, ?live, is_guarded, is_backend, "the front or middle end");
    if (crossed == NONE::usize) { ret 2; }
    if (crossed != 0)           { ret 3; }
    ret 0;
}

# the instruction-set members implement a contract both sides import, so the target tree
# never calls back into the pipeline, not even from its tests, and the contract sits below
# both
test layering__target_and_pipeline_meet_only_in_the_contract {
    var backing: A.Allocator;
    page.make(?backing);
    var ar:    arena.Arena;
    var alloc: A.Allocator;
    val made:  err[A.Error] = arena.init(?ar, ?backing, 0);
    if (sel made.err) { ret 1; }
    arena.make(?alloc, ?ar);
    var t: Tree;
    if (!load(?alloc, ?backing, ?t)) { ret 1; }
    var live:   Vector[bool] = production(?t);
    val target: usize        = crossings(?t, ?live, is_target, is_pipeline, "the target tree");
    if (target == NONE::usize) { ret 2; }
    val contract: usize = crossings(?t, ?live, is_contract, is_contract_forbidden, "the backend contract");
    if (contract == NONE::usize)                                                                { ret 3; }
    if (target + contract + test_crossings(?t, is_target, is_pipeline, "the target tree") != 0) { ret 4; }
    ret 0;
}

# a module's tests may import what its own imports already reach, or anything in its layer
# or below; an import only its tests make never reaches above its layer, since the mark is
# no cycle escape and the edge would push the module up the graph
test layering__a_test_import_climbs_no_layer {
    var backing: A.Allocator;
    page.make(?backing);
    var ar:    arena.Arena;
    var alloc: A.Allocator;
    val made:  err[A.Error] = arena.init(?ar, ?backing, 0);
    if (sel made.err) { ret 1; }
    arena.make(?alloc, ?ar);
    var t: Tree;
    if (!load(?alloc, ?backing, ?t)) { ret 1; }
    var live:    Vector[bool] = production(?t);
    val crossed: usize        = climbs(?t, ?live);
    if (crossed == NONE::usize) { ret 2; }
    if (crossed != 0)           { ret 3; }
    ret 0;
}
