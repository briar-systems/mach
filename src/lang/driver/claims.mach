# the link claims an object mach emits carries for whoever links it: one per
# `[link.*]` requirement of the unit the object is compiled for, its own and
# those its dependencies export, each stated as mach's own link finds it. a
# library or framework is named with its kind, a file by its absolute path,
# and the symbols it provides by their link names. mink adds them as one
# section every image leaves out, so an archive of the objects carries them
# to the link that takes it

use std.text.string.str_free;
use std.types.error.err;
use std.types.option.opt;
use types_path: std.types.path;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.OwnedString;
use std.types.string.owned_release;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use A: std.allocator;
use std.process.env;

use mach.lang.driver.backend;
use mach.lang.driver.project;
use mach.lang.fail;
use mach.lang.intern;
use mach.lang.manifest;
use mach.lang.target.input;

use mink_fail: mink.base.fail;
use mink.model.claim;
use mink.model.claim.Claim;
use mink.model.object.Object;

# add to `o` the claims of every link requirement of `p`'s unit, nothing for none
pub fun state(p: *project.Project, o: *Object) err[fail.Fail] {
    var w:        claim.Writer        = claim.writer(o);
    val r:        err[fail.Fail]      = all_stated(p, ?w);
    val finished: err[mink_fail.Fail] = claim.finish(?w);
    if (sel r.err)        { ret r; }
    if (sel finished.err) { ret err[fail.Fail].err{backend.refused_by_mink(p.alloc, "the object's link claims were refused", finished.err)}; }
    ret err[fail.Fail].ok{};
}

fun all_stated(p: *project.Project, w: *claim.Writer) err[fail.Fail] {
    val te: *project.TargetEntry = p.target_entry;
    if (te != nil) {
        val own: err[fail.Fail] = stated(p, w, te.libs, te.lib_count);
        if (sel own.err) { ret own; }
    }
    ret stated(p, w, p.config.cascade_libs, p.config.cascade_lib_count);
}

fun stated(p: *project.Project, w: *claim.Writer, reqs: *manifest.LinkRequirement, count: u32) err[fail.Fail] {
    var i: u32 = 0;
    for (i < count) {
        val e: err[fail.Fail] = one(p, w, ?reqs[i]);
        if (sel e.err) { ret e; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# the claim of the requirement `req`, found as mach's own link finds it
fun one(p: *project.Project, w: *claim.Writer, req: *manifest.LinkRequirement) err[fail.Fail] {
    val found: res[input.Input, fail.Fail] = manifest.requirement_input(p.alloc, ?p.s.interner, p.req.project_root, req);
    if (sel found.err) { ret err[fail.Fail].err{found.err}; }
    val li: input.Input = found.ok;
    var c:  Claim       = Claim{form: claim.Form.system{}, kind: opt[claim.LibraryKind].some{claim.LibraryKind.shared{}}, referenced: li.include_referenced};
    if (li.kind == input.STATIC) { c.kind = opt[claim.LibraryKind].some{claim.LibraryKind.static{}}; }
    var path: str = nil;
    fin {
        if (path != nil) { str_free(p.alloc, path); }
    }
    if (li.form == input.FRAMEWORK) { c.form = claim.Form.framework{}; }
    or (li.form == input.FILE) {
        val absolute: res[str, fail.Fail] = absolute_of(p.alloc, li.text);
        str_free(p.alloc, li.text);
        if (sel absolute.err) { ret err[fail.Fail].err{absolute.err}; }
        path   = absolute.ok;
        c.form = claim.Form.local{};
        c.kind = opt[claim.LibraryKind].none{};
    }
    var name: str = li.text;
    if (path != nil) { name = path; }
    c.name = View{data: name::*u8, len: str_len(name)};
    var symbols: *View = nil;
    if (req.symbol_count > 0) {
        val made: res[*View, A.Error] = A.allocate[View](p.alloc, req.symbol_count::usize);
        if (sel made.err) { ret err[fail.Fail].err{fail.refused(made.err)}; }
        symbols = made.ok;
    }
    fin {
        if (symbols != nil) { A.deallocate[View](p.alloc, symbols, req.symbol_count::usize); }
    }
    var i: u32 = 0;
    for (i < req.symbol_count) {
        val ln: res[intern.StrId, fail.Fail] = project.link_name_for(p, req.symbols[i]);
        if (sel ln.err) { ret err[fail.Fail].err{ln.err}; }
        val text: str = intern.text(?p.s.interner, ln.ok);
        symbols[i] = View{data: text::*u8, len: str_len(text)};
        i          = i + 1;
    }
    c.symbols      = symbols;
    c.symbol_count = req.symbol_count::usize;
    val added: err[mink_fail.Fail] = claim.add(w, ?c);
    if (sel added.err) { ret err[fail.Fail].err{backend.refused_by_mink(p.alloc, "a link claim was refused", added.err)}; }
    ret err[fail.Fail].ok{};
}

# `spelled` as an absolute, lexically clean path, a relative one under the working directory
fun absolute_of(a: *A.Allocator, spelled: str) res[str, fail.Fail] {
    val cwd_r: res[OwnedString, env.EnvError] = env.current_dir(a);
    if (sel cwd_r.err) { ret res[str, fail.Fail].err{fail.message("a link claim's path cannot be made absolute: the current directory is unreadable")}; }
    var cwd: OwnedString = cwd_r.ok;
    fin { owned_release(?cwd); }
    val joined: res[str, A.Error] = types_path.resolve(a, cwd.data, spelled);
    if (sel joined.err) { ret res[str, fail.Fail].err{fail.refused(joined.err)}; }
    fin { str_free(a, joined.ok); }
    val cleaned: res[str, A.Error] = types_path.clean(a, joined.ok);
    if (sel cleaned.err) { ret res[str, fail.Fail].err{fail.refused(cleaned.err)}; }
    ret res[str, fail.Fail].ok{cleaned.ok};
}
