use std.allocator.page;
use collections_vector: std.collections.vector;
use std.collections.vector.Vector;
use std.crypto.hash.sha256;
use std.system.panic.panic;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_contains;
use std.types.string.str_empty;
use std.types.string.str_equals;
use std.types.string.str_len;

use A:         std.allocator;
use system_os: std.system.os;

use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.fail;
use lang_fingerprint: mach.lang.fingerprint;
use mach.lang.intern;
use mach.lang.manifest;
use catalog_subsystem: mach.lang.target.catalog.subsystem;
use mach.lang.wire;

# a binary profile lever as the command line sets it
pub def Lever: u8;

# neither `--key` nor `--no-key` was given: the profile decides
pub val LEVER_PROFILE: Lever = 0;
# `--key`
pub val LEVER_ON: Lever = 1;
# `--no-key`
pub val LEVER_OFF: Lever = 2;

# what a build-shaped command sets over the profile it builds, already typed;
# a lever or value left unset leaves the profile's
# ---
# output:    the `-o` path, nil when absent
# work:      the `-w` work directory, nil when absent
# subsystem: the declared subsystem, SUBSYSTEM_FLAG_NONE for the artifact's own
# optimize:  whether to optimize, or LEVER_PROFILE
# debug:     whether to emit debug information, or LEVER_PROFILE
# simd:      the vector lowering mode, none for the profile's
# jobs:      the worker count, 0 for the host's
pub rec Overrides {
    output:       *u8;
    work:         *u8;
    emit_asm:     bool;
    emit_ir:      bool;
    pie:          bool;
    subsystem:    SubsystemFlag;
    optimize:     Lever;
    debug:        Lever;
    simd:         opt[manifest.SimdMode];
    jobs:         u32;
    include_deps: bool;
    no_cache:     bool;
    link_tokens:  Vector[*u8];
    lib_dirs:     Vector[*u8];
}

# no override: the profile decides everything, with empty name lists and link
# inputs growable through `a`
pub fun overrides_init(a: *A.Allocator) Overrides {
    var o: Overrides;
    o.output       = nil;
    o.work         = nil;
    o.emit_asm     = false;
    o.emit_ir      = false;
    o.pie          = false;
    o.subsystem    = SUBSYSTEM_FLAG_NONE;
    o.optimize     = LEVER_PROFILE;
    o.debug        = LEVER_PROFILE;
    o.simd         = opt[manifest.SimdMode].none{};
    o.jobs         = 0;
    o.include_deps = false;
    o.no_cache     = false;
    o.link_tokens  = collections_vector.init[*u8](a);
    o.lib_dirs     = collections_vector.init[*u8](a);
    ret o;
}

pub def SubsystemFlag: u8;

val     SUBSYSTEM_FLAG_NONE:    SubsystemFlag = 0;
pub val SUBSYSTEM_FLAG_CONSOLE: SubsystemFlag = 1;
val     SUBSYSTEM_FLAG_GUI:     SubsystemFlag = 2;

rec SubsystemFlagSpec {
    flag:            SubsystemFlag;
    resolved:        catalog_subsystem.Subsystem;
    fingerprint_tag: u8;
}

val SUBSYSTEM_FLAG_N: usize                               = 2;
val SUBSYSTEM_FLAGS:  [SUBSYSTEM_FLAG_N]SubsystemFlagSpec = [SUBSYSTEM_FLAG_N]SubsystemFlagSpec{
    SubsystemFlagSpec{flag: SUBSYSTEM_FLAG_CONSOLE, resolved: catalog_subsystem.CONSOLE, fingerprint_tag: 1},
    SubsystemFlagSpec{flag: SUBSYSTEM_FLAG_GUI, resolved: catalog_subsystem.GUI, fingerprint_tag: 2},
};

# the flag a subsystem name sets, none for a name no flag sets
pub fun subsystem_flag_from_name(name: str) opt[SubsystemFlag] {
    val parsed: opt[catalog_subsystem.Subsystem] = catalog_subsystem.from_name(name);
    if (sel parsed.none) { ret opt[SubsystemFlag].none{}; }
    val s: catalog_subsystem.Subsystem = parsed.some;
    var i: usize                       = 0;
    for (i < SUBSYSTEM_FLAG_N) {
        if (SUBSYSTEM_FLAGS[i].resolved == s) { ret opt[SubsystemFlag].some{SUBSYSTEM_FLAGS[i].flag}; }
        i = i + 1;
    }
    ret opt[SubsystemFlag].none{};
}

pub fun subsystem_from_flag(f: SubsystemFlag) opt[catalog_subsystem.Subsystem] {
    var i: usize = 0;
    for (i < SUBSYSTEM_FLAG_N) {
        if (SUBSYSTEM_FLAGS[i].flag == f) { ret opt[catalog_subsystem.Subsystem].some{SUBSYSTEM_FLAGS[i].resolved}; }
        i = i + 1;
    }
    ret opt[catalog_subsystem.Subsystem].none{};
}

# a build's optimization lever: off, or the level mirl's schedule optimizes at
pub val OPT_DEBUG:   u8 = 0;
pub val OPT_RELEASE: u8 = 2;

pub def BuildGoal: u8;

# the finished artifact of the unit's kind: an executable, a static archive or a shared library
pub val GOAL_ARTIFACT: BuildGoal = 0;

pub val GOAL_OBJECTS: BuildGoal = 1;

pub val GOAL_TESTS: BuildGoal = 2;

pub val GOAL_TEST_LIST: BuildGoal = 3;

# `mach check`: load, resolve and check the selected artifacts' reachable source
# through the frontend and stop; no step runs and no product is written
pub val GOAL_CHECK: BuildGoal = 4;

# verb:   what the readout calls working on a cell for this goal
# caches: a request from the command line reads and publishes the object cache
# unless `--no-cache` forces an uncached build
rec BuildGoalSpec {
    goal:            BuildGoal;
    display:         str;
    verb:            str;
    emit_name:       str;
    fingerprint_tag: u8;
    caches:          bool;
}

val BUILD_GOAL_CATALOG_VERSION: u8 = 1;

val BUILD_GOAL_N: usize                       = 5;
val BUILD_GOALS:  [BUILD_GOAL_N]BuildGoalSpec = [BUILD_GOAL_N]BuildGoalSpec{
    BuildGoalSpec{goal: GOAL_ARTIFACT, display: "artifact", verb: "building", emit_name: "exe", fingerprint_tag: 1, caches: true},
    BuildGoalSpec{goal: GOAL_OBJECTS, display: "objects", verb: "building", emit_name: "obj", fingerprint_tag: 2, caches: true},
    BuildGoalSpec{goal: GOAL_TESTS, display: "tests", verb: "building", emit_name: "", fingerprint_tag: 3, caches: true},
    BuildGoalSpec{goal: GOAL_TEST_LIST, display: "test list", verb: "building", emit_name: "", fingerprint_tag: 4, caches: true},
    BuildGoalSpec{goal: GOAL_CHECK, display: "check", verb: "checking", emit_name: "", fingerprint_tag: 5, caches: false},
};

# reached only by mach-lsp
pub rec LinkToken {
    text: str;
}

# owner: "" for a cell of the root manifest, or the id of the closure dependency
#        whose export library requires the cell; `target` and
#        `artifact` then name that dependency's declarations
pub rec BuildRequest {
    project_root: str;
    owner:        str;

    target:   str;
    profile:  str;
    artifact: str;

    goal: BuildGoal;

    # the level mirl's schedule runs at
    opt: u8;
    # the command line changed a lever of the selected profile, so a build that
    # publishes artifacts must say where: presentation only, no part of any hash
    overrides: bool;
    debug:     bool;
    pie:       bool;
    # whether the linker may relax the code, which mirl's build option states
    relax:          bool;
    subsystem_flag: SubsystemFlag;
    subsystem:      catalog_subsystem.Subsystem;
    simd:           manifest.SimdMode;
    # the warning kinds the profile silences: presentation only, so no part of the request hash
    allow: diagnostic_kind.KindSet;
    jobs:  u32;

    emit_ir:  bool;
    emit_asm: bool;
    out:      str;
    # `-w`, the root manifest's work directory in place of its `[project].work`;
    # "" for none
    work: str;

    link_tokens: Vector[LinkToken];
    lib_dirs:    Vector[str];

    include_deps: bool;
    no_cache:     bool;
    object_cache: bool;
    # a test run's selection: the tests whose qualified name contains it, all when empty.
    # it shapes the dispatcher and never an object
    test_filter: str;
}

pub fun defaults() BuildRequest {
    var r: BuildRequest;
    r.project_root   = "";
    r.owner          = "";
    r.target         = "";
    r.profile        = "";
    r.artifact       = "";
    r.goal           = GOAL_ARTIFACT;
    r.opt            = OPT_DEBUG;
    r.debug          = false;
    r.pie            = false;
    r.relax          = true;
    r.subsystem_flag = SUBSYSTEM_FLAG_NONE;
    r.subsystem      = catalog_subsystem.CONSOLE;
    r.simd           = manifest.SIMD_SCALARIZE;
    r.overrides      = false;
    r.allow          = diagnostic_kind.set_empty();
    r.jobs           = 0;
    r.emit_ir        = false;
    r.emit_asm       = false;
    r.out            = "";
    r.work           = "";
    r.link_tokens    = collections_vector.init[LinkToken](nil);
    r.lib_dirs       = collections_vector.init[str](nil);
    r.include_deps   = false;
    r.test_filter    = "";
    r.no_cache       = false;
    r.object_cache   = false;
    ret r;
}

pub fun test_goal(g: BuildGoal) bool {
    ret g == GOAL_TESTS || g == GOAL_TEST_LIST;
}

pub fun goal_from_emit_name(name: str) opt[BuildGoal] {
    var i: usize = 0;
    for (i < BUILD_GOAL_N) {
        if (!str_empty(BUILD_GOALS[i].emit_name) && str_equals(BUILD_GOALS[i].emit_name, name)) {
            ret opt[BuildGoal].some{BUILD_GOALS[i].goal};
        }
        i = i + 1;
    }
    ret opt[BuildGoal].none{};
}

# the name `--emit` gives a catalogued goal, "" for one it does not name
pub fun goal_emit_name(goal: BuildGoal) str {
    ret catalogued(goal).emit_name;
}

# the name a catalogued goal is displayed by
pub fun goal_name(goal: BuildGoal) str {
    ret catalogued(goal).display;
}

# the verb a catalogued goal's unit is announced with
pub fun goal_verb(goal: BuildGoal) str {
    ret catalogued(goal).verb;
}

pub fun validate(a: *A.Allocator, r: *BuildRequest) err[fail.Fail] {
    if (goal_spec(r.goal) == nil) {
        ret err[fail.Fail].err{fail.unknown_catalog(a, "BuildGoal", r.goal::u32)};
    }
    if (r.opt != OPT_DEBUG && r.opt != OPT_RELEASE) {
        ret err[fail.Fail].err{fail.unknown_catalog(a, "OptLevel", r.opt::u32)};
    }
    if (r.simd != manifest.SIMD_SCALARIZE && r.simd != manifest.SIMD_REQUIRE) {
        ret err[fail.Fail].err{fail.unknown_catalog(a, "SimdMode", r.simd::u32)};
    }
    val subsystem_from_flag_r: opt[catalog_subsystem.Subsystem] = subsystem_from_flag(r.subsystem_flag);
    if (r.subsystem_flag != SUBSYSTEM_FLAG_NONE && sel subsystem_from_flag_r.none) {
        ret err[fail.Fail].err{fail.unknown_catalog(a, "SubsystemFlag", r.subsystem_flag::u32)};
    }
    if (catalog_subsystem.fingerprint_tag(r.subsystem) == 0) {
        ret err[fail.Fail].err{fail.unknown_catalog(a, "Subsystem", r.subsystem::u32)};
    }
    ret err[fail.Fail].ok{};
}

pub fun is_release(r: *BuildRequest) bool {
    ret r.opt == OPT_RELEASE;
}

pub fun compose(a: *A.Allocator, itn: *intern.Interner, m: *manifest.Manifest,
    o: *Overrides, root: str, goal: BuildGoal, profile: str) res[BuildRequest, fail.Fail] {
    var r: BuildRequest = defaults();
    r.project_root = root;
    r.goal         = goal;
    val valid: err[fail.Fail] = validate(a, ?r);
    if (sel valid.err) {
        ret res[BuildRequest, fail.Fail].err{valid.err};
    }

    r.profile = profile;

    val pr_r: res[manifest.ResolvedProfile, fail.Fail] = manifest.resolve_profile(a, itn, m, profile);
    if (sel pr_r.err) {
        ret res[BuildRequest, fail.Fail].err{pr_r.err};
    }
    val pf: manifest.ResolvedProfile = pr_r.ok;

    val checked: err[fail.Fail] = profiles_check(a, itn, m);
    if (sel checked.err) { ret res[BuildRequest, fail.Fail].err{checked.err}; }
    val levers: err[fail.Fail] = levers_compose(a, itn, ?pf, o, ?r);
    if (sel levers.err) { ret res[BuildRequest, fail.Fail].err{levers.err}; }
    r.pie = o.pie;

    r.subsystem_flag = o.subsystem;

    r.allow = pf.allow;

    r.jobs = workers(o.jobs);

    r.emit_ir  = o.emit_ir;
    r.emit_asm = o.emit_asm;
    if (o.output != nil) { r.out = o.output::str; }
    if (o.work != nil)   { r.work = o.work::str; }

    r.link_tokens = collections_vector.init[LinkToken](a);
    var ti: usize = 0;
    for (ti < o.link_tokens.len) {
        var t: LinkToken;
        t.text = o.link_tokens.data[ti]::str;
        val pr: res[usize, A.Error] = collections_vector.push[LinkToken](?r.link_tokens, t);
        if (sel pr.err) {
            ret res[BuildRequest, fail.Fail].err{fail.refused(pr.err)};
        }
        ti = ti + 1;
    }
    r.lib_dirs = collections_vector.init[str](a);
    var di: usize = 0;
    for (di < o.lib_dirs.len) {
        val dr: res[usize, A.Error] = collections_vector.push[str](?r.lib_dirs, o.lib_dirs.data[di]::str);
        if (sel dr.err) {
            ret res[BuildRequest, fail.Fail].err{fail.refused(dr.err)};
        }
        di = di + 1;
    }

    r.include_deps = o.include_deps;
    r.no_cache     = o.no_cache;
    r.object_cache = goal_caches(goal) && !o.no_cache;
    ret res[BuildRequest, fail.Fail].ok{r};
}

# the levers of the selected profile `pf`, then the command line's over them,
# into `r`: built-in defaults, then the profile, then the command line
fun levers_compose(a: *A.Allocator, itn: *intern.Interner, pf: *manifest.ResolvedProfile, o: *Overrides, r: *BuildRequest) err[fail.Fail] {
    if (pf.optimize) { r.opt = OPT_RELEASE; }
    r.debug = pf.debug;
    r.simd  = pf.simd;
    r.relax = pf.relax;

    val profiled: BuildRequest = @r;
    if (o.optimize == LEVER_ON)  { r.opt = OPT_RELEASE; }
    if (o.optimize == LEVER_OFF) { r.opt = OPT_DEBUG; }
    if (o.debug == LEVER_ON)     { r.debug = true; }
    if (o.debug == LEVER_OFF)    { r.debug = false; }
    if (sel o.simd.some)         { r.simd = o.simd.some; }
    if (r.simd == manifest.SIMD_REQUIRE) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.CLI_FLAG_VALUE, SIMD_REQUIRE_REFUSED)};
    }
    r.overrides = r.opt != profiled.opt || r.debug != profiled.debug || r.simd != profiled.simd;
    ret err[fail.Fail].ok{};
}

# mirl reports no operation it scalarizes, so a build cannot be held to packed vector forms
val SIMD_REQUIRE_REFUSED: str = "simd = \"require\" is not accepted: mirl legalizes vector operations and reports none it scalarizes, so a build cannot be held to packed forms";

# every profile's keys name what a build can hold, so a profile is refused where
# it is written whichever profile is selected: mirl schedules its passes by level,
# so no profile names passes, and none requires packed vector forms
fun profiles_check(a: *A.Allocator, itn: *intern.Interner, m: *manifest.Manifest) err[fail.Fail] {
    var i: u32 = 0;
    for (i < m.profile_count) {
        val pf: *manifest.ProfileDef = ?m.profiles[i];
        i = i + 1;
        val passes: err[fail.Fail] = no_names(a, itn, pf.name, ?pf.pass, "pass");
        if (sel passes.err) { ret passes; }
        val skips: err[fail.Fail] = no_names(a, itn, pf.name, ?pf.skip, "skip");
        if (sel skips.err) { ret skips; }
    }
    ret err[fail.Fail].ok{};
}

# a profile's `key` list refused where its first name is written
fun no_names(a: *A.Allocator, itn: *intern.Interner, profile: intern.StrId, names: *manifest.NameList, key: str) err[fail.Fail] {
    if (names.count == 0) { ret err[fail.Fail].ok{}; }
    val refused: fail.Fail = fail.formatted_user(a, diagnostic_kind.MANIFEST_INVALID_VALUE,
        "mach.toml: [profile.{}].{} is not accepted: mirl schedules its passes by optimization level, which `optimize` sets", intern.text(itn, profile), key);
    ret err[fail.Fail].err{fail.at(a, refused, names.sites[0])};
}

# `work`, a `-w` value, in place of the root manifest `m`'s `[project].work`: a
# canonical path inside the project root, taken as written
pub fun work_apply(itn: *intern.Interner, work: str, m: *manifest.Manifest) err[fail.Fail] {
    if (!manifest.is_project_path(work) || str_contains(work, "{")) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.CLI_OUTPUT_PATH, WORK_CONSTRAINT)};
    }
    val id: res[intern.StrId, A.Error] = intern.add(itn, work);
    if (sel id.err) { ret err[fail.Fail].err{fail.refused(id.err)}; }
    m.work_tmpl = id.ok;
    ret err[fail.Fail].ok{};
}

# the rule `-w` keeps
val WORK_CONSTRAINT: str = "-w must name a canonical path inside the project root: relative, with no . or .. component and no template";

pub fun for_cell(base: *BuildRequest, owner: str, target: str, artifact: str,
    subsystem: catalog_subsystem.Subsystem, goal: BuildGoal) BuildRequest {
    var r: BuildRequest = @base;
    r.owner     = owner;
    r.target    = target;
    r.artifact  = artifact;
    r.subsystem = subsystem;
    r.goal      = goal;
    ret r;
}

# the workers a run uses: the `--jobs` count, or the host's processor count when none was given
# ---
# asked: the count, 0 when none was given
# ret:   at least 1
pub fun workers(asked: u32) u32 {
    if (asked > 0) { ret asked; }
    val nc: i64 = system_os.cpu_count();
    if (nc > 1) { ret nc::u32; }
    ret 1;
}

pub val HASH_SIZE: usize = 32;

fun write_semantic_fields(s: *wire.Sink, r: *BuildRequest) {
    put_text(s, r.project_root);
    put_text(s, r.owner);
    put_text(s, r.target);
    put_text(s, r.profile);
    put_text(s, r.artifact);
    write_goal(s, r.goal);
    wire.put_u8(s, r.opt);
    put_flag(s, r.debug);
    put_flag(s, r.pie);
    put_flag(s, r.relax);
    wire.put_u8(s, r.simd);
    put_flag(s, r.include_deps);
}

fun goal_spec(goal: BuildGoal) *BuildGoalSpec {
    var i: usize = 0;
    for (i < BUILD_GOAL_N) {
        if (BUILD_GOALS[i].goal == goal) { ret ?BUILD_GOALS[i]; }
        i = i + 1;
    }
    ret nil;
}

# the entry of a goal in BUILD_GOALS. every goal a request carries is one validate admitted, so a
# goal outside the catalog is a defect in its caller
fun catalogued(goal: BuildGoal) *BuildGoalSpec {
    val spec: *BuildGoalSpec = goal_spec(goal);
    if (spec == nil) { panic("a build goal outside BUILD_GOALS"); }
    ret spec;
}

# whether a goal caches objects; a goal outside the catalog does not, and validate refuses it
fun goal_caches(goal: BuildGoal) bool {
    val spec: *BuildGoalSpec = goal_spec(goal);
    ret spec != nil && spec.caches;
}

fun write_goal(s: *wire.Sink, goal: BuildGoal) {
    val spec: *BuildGoalSpec = goal_spec(goal);
    if (spec == nil) {
        wire.refuse(s, fail.message("build request names an unknown goal"));
        ret;
    }
    lang_fingerprint.put_domain_u8(s, lang_fingerprint.DOMAIN_BUILD_GOAL, BUILD_GOAL_CATALOG_VERSION, spec.fingerprint_tag);
}

#[testing]
fun write_request_extra(s: *wire.Sink, r: *BuildRequest) {
    wire.put_u32(s, r.jobs);
    put_flag(s, r.emit_ir);
    put_flag(s, r.emit_asm);
    put_flag(s, r.no_cache);
    put_flag(s, r.object_cache);
    put_text(s, r.out);
    lang_fingerprint.put_domain_u8(s, lang_fingerprint.DOMAIN_SUBSYSTEM,
        catalog_subsystem.VERSION, catalog_subsystem.fingerprint_tag(r.subsystem));
    wire.put_u32(s, r.link_tokens.len::u32);
    var ti: usize = 0;
    for (ti < r.link_tokens.len) {
        put_text(s, r.link_tokens.data[ti].text);
        ti = ti + 1;
    }
    wire.put_u32(s, r.lib_dirs.len::u32);
    var di: usize = 0;
    for (di < r.lib_dirs.len) {
        put_text(s, r.lib_dirs.data[di]);
        di = di + 1;
    }
}

# the sha-256 of what the sink holds, or its failure; releases the sink
fun digest_of(s: *wire.Sink, digest: *u8) err[fail.Fail] {
    fin { wire.dnit(s); }
    val failed: opt[fail.Fail] = wire.failure(s);
    if (sel failed.some) { ret err[fail.Fail].err{failed.some}; }
    sha256.hash(wire.bytes(s), s.len, digest);
    ret err[fail.Fail].ok{};
}

#[testing]
fun request_hash(a: *A.Allocator, r: *BuildRequest, digest: *u8) err[fail.Fail] {
    val valid: err[fail.Fail] = validate(a, r);
    if (sel valid.err) {
        ret err[fail.Fail].err{valid.err};
    }
    var s: wire.Sink = wire.grown(a);
    write_semantic_fields(?s, r);
    write_request_extra(?s, r);
    ret digest_of(?s, digest);
}

pub fun semantic_hash(a: *A.Allocator, r: *BuildRequest, digest: *u8) err[fail.Fail] {
    val valid: err[fail.Fail] = validate(a, r);
    if (sel valid.err) {
        ret err[fail.Fail].err{valid.err};
    }
    var s: wire.Sink = wire.grown(a);
    write_semantic_fields(?s, r);
    ret digest_of(?s, digest);
}

# a text as its u32 length then its bytes
fun put_text(s: *wire.Sink, text: str) {
    wire.put_sized(s, text::*u8, str_len(text));
}

fun put_flag(s: *wire.Sink, v: bool) {
    var b: u8 = 0;
    if (v) { b = 1; }
    wire.put_u8(s, b);
}

test build_goal_catalog__is_complete_unique_ordered_and_round_trips {
    if (BUILD_GOAL_CATALOG_VERSION != 1)       { ret 1; }
    if (BUILD_GOAL_N != GOAL_CHECK::usize + 1) { ret 1; }

    var seen: [BUILD_GOAL_N]bool;
    var i:    usize = 0;
    for (i < BUILD_GOAL_N) {
        seen[i] = false;
        i       = i + 1;
    }

    var emit_count: usize = 0;
    i = 0;
    for (i < BUILD_GOAL_N) {
        val spec: *BuildGoalSpec = ?BUILD_GOALS[i];
        if (spec.goal::usize >= BUILD_GOAL_N)                { ret 1; }
        if (seen[spec.goal::usize])                          { ret 1; }
        if (str_empty(spec.display))                         { ret 1; }
        if (str_empty(spec.verb))                            { ret 1; }
        if (!str_equals(goal_verb(spec.goal), spec.verb))    { ret 1; }
        if (spec.fingerprint_tag != (i + 1)::u8)             { ret 1; }
        if (!str_equals(goal_name(spec.goal), spec.display)) { ret 1; }
        seen[spec.goal::usize] = true;

        var j: usize = 0;
        for (j < i) {
            val prior: *BuildGoalSpec = ?BUILD_GOALS[j];
            if (prior.goal == spec.goal)                       { ret 1; }
            if (prior.fingerprint_tag == spec.fingerprint_tag) { ret 1; }
            if (str_equals(prior.display, spec.display))       { ret 1; }
            if (!str_empty(spec.emit_name)
                && str_equals(prior.emit_name, spec.emit_name)) { ret 1; }
            j = j + 1;
        }

        if (!str_empty(spec.emit_name)) {
            val parsed: opt[BuildGoal] = goal_from_emit_name(spec.emit_name);
            if (sel parsed.none)          { ret 1; }
            if (parsed.some != spec.goal) { ret 1; }
            emit_count = emit_count + 1;
        }
        i = i + 1;
    }

    if (emit_count != 2) { ret 1; }
    val goal_from_emit_name_r: opt[BuildGoal] = goal_from_emit_name("tests");
    if (sel goal_from_emit_name_r.some) { ret 1; }
    val goal_from_emit_name_r2: opt[BuildGoal] = goal_from_emit_name("");
    if (sel goal_from_emit_name_r2.some) { ret 1; }
    i = 0;
    for (i < BUILD_GOAL_N) {
        if (!seen[i]) { ret 1; }
        i = i + 1;
    }
    ret 0;
}

test subsystem_flag_catalog__is_complete_unique_and_tracks_the_target_catalog {
    var seen: [SUBSYSTEM_FLAG_N]bool;
    var i:    usize = 0;
    for (i < SUBSYSTEM_FLAG_N) {
        seen[i] = false;
        i       = i + 1;
    }

    i = 0;
    for (i < SUBSYSTEM_FLAG_N) {
        val spec: *SubsystemFlagSpec = ?SUBSYSTEM_FLAGS[i];
        if (spec.flag == SUBSYSTEM_FLAG_NONE) { ret 1; }
        val slot: usize = spec.flag::usize - 1;
        if (slot >= SUBSYSTEM_FLAG_N) { ret 1; }
        if (seen[slot])               { ret 1; }
        seen[slot] = true;

        if (spec.fingerprint_tag != catalog_subsystem.fingerprint_tag(spec.resolved)) { ret 1; }

        var j: usize = 0;
        for (j < i) {
            val prior: *SubsystemFlagSpec = ?SUBSYSTEM_FLAGS[j];
            if (prior.flag == spec.flag)         { ret 1; }
            if (prior.resolved == spec.resolved) { ret 1; }
            j = j + 1;
        }

        val name:   str                = catalog_subsystem.name_for(spec.resolved);
        val parsed: opt[SubsystemFlag] = subsystem_flag_from_name(name);
        if (sel parsed.none)          { ret 1; }
        if (parsed.some != spec.flag) { ret 1; }

        val resolved: opt[catalog_subsystem.Subsystem] = subsystem_from_flag(spec.flag);
        if (sel resolved.none)              { ret 1; }
        if (resolved.some != spec.resolved) { ret 1; }
        i = i + 1;
    }

    val subsystem_flag_from_name_r: opt[SubsystemFlag] = subsystem_flag_from_name("");
    if (sel subsystem_flag_from_name_r.some) { ret 1; }
    val subsystem_flag_from_name_r2: opt[SubsystemFlag] = subsystem_flag_from_name("bogus");
    if (sel subsystem_flag_from_name_r2.some) { ret 1; }
    val subsystem_from_flag_r: opt[catalog_subsystem.Subsystem] = subsystem_from_flag(SUBSYSTEM_FLAG_NONE);
    if (sel subsystem_from_flag_r.some) { ret 1; }

    i = 0;
    for (i < SUBSYSTEM_FLAG_N) {
        if (!seen[i]) { ret 1; }
        i = i + 1;
    }
    ret 0;
}

#[testing]
fun dig_eq(a: *u8, b: *u8) bool {
    var i: usize = 0;
    for (i < HASH_SIZE) {
        if (a[i] != b[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# every build goal changes the semantic hash and every subsystem the request hash
test semantic_hash__distinguishes_every_goal_and_request_hash_every_subsystem {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }

    var goals: [BUILD_GOAL_N][32]u8;
    var i:     usize = 0;
    for (i < BUILD_GOAL_N) {
        var req: BuildRequest = defaults();
        req.goal = BUILD_GOALS[i].goal;
        val hashed: err[fail.Fail] = semantic_hash(?alloc, ?req, ?goals[i][0]);
        if (sel hashed.err) { ret 2; }
        var j: usize = 0;
        for (j < i) {
            if (dig_eq(?goals[j][0], ?goals[i][0])) { ret 3; }
            j = j + 1;
        }
        i = i + 1;
    }

    var subsystems: [SUBSYSTEM_FLAG_N][32]u8;
    i = 0;
    for (i < SUBSYSTEM_FLAG_N) {
        var req: BuildRequest = defaults();
        req.subsystem = SUBSYSTEM_FLAGS[i].resolved;
        val hashed: err[fail.Fail] = request_hash(?alloc, ?req, ?subsystems[i][0]);
        if (sel hashed.err) { ret 4; }
        var j: usize = 0;
        for (j < i) {
            if (dig_eq(?subsystems[j][0], ?subsystems[i][0])) { ret 5; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret 0;
}

test semantic_hash__omits_nonsemantic_fields {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }

    var ra: BuildRequest = defaults();
    ra.project_root = "/tmp/p";
    ra.opt          = OPT_DEBUG;

    var base:            [32]u8;
    val semantic_hash_r: err[fail.Fail] = semantic_hash(?alloc, ?ra, ?base[0]);
    if (sel semantic_hash_r.err) { ret 1; }

    var rb: BuildRequest = ra;
    rb.jobs = ra.jobs + 8;
    var d:                [32]u8;
    val semantic_hash_r2: err[fail.Fail] = semantic_hash(?alloc, ?rb, ?d[0]);
    if (sel semantic_hash_r2.err) { ret 1; }
    if (!dig_eq(?base[0], ?d[0])) { ret 1; }

    var rqa:            [32]u8;
    var rqb:            [32]u8;
    val request_hash_r: err[fail.Fail] = request_hash(?alloc, ?ra, ?rqa[0]);
    if (sel request_hash_r.err) { ret 1; }
    val request_hash_r2: err[fail.Fail] = request_hash(?alloc, ?rb, ?rqb[0]);
    if (sel request_hash_r2.err)  { ret 1; }
    if (dig_eq(?rqa[0], ?rqb[0])) { ret 1; }

    rb              = ra;
    rb.no_cache     = true;
    rb.object_cache = true;
    rb.emit_ir      = true;
    rb.emit_asm     = true;
    rb.out          = "/tmp/out.bin";
    val semantic_hash_r3: err[fail.Fail] = semantic_hash(?alloc, ?rb, ?d[0]);
    if (sel semantic_hash_r3.err) { ret 1; }
    if (!dig_eq(?base[0], ?d[0])) { ret 1; }

    rb           = ra;
    rb.subsystem = catalog_subsystem.GUI;
    val semantic_hash_r4: err[fail.Fail] = semantic_hash(?alloc, ?rb, ?d[0]);
    if (sel semantic_hash_r4.err) { ret 1; }
    if (!dig_eq(?base[0], ?d[0])) { ret 1; }
    val request_hash_r3: err[fail.Fail] = request_hash(?alloc, ?ra, ?rqa[0]);
    if (sel request_hash_r3.err) { ret 1; }
    val request_hash_r4: err[fail.Fail] = request_hash(?alloc, ?rb, ?rqb[0]);
    if (sel request_hash_r4.err)  { ret 1; }
    if (dig_eq(?rqa[0], ?rqb[0])) { ret 1; }

    rb     = ra;
    rb.opt = OPT_RELEASE;
    val semantic_hash_r5: err[fail.Fail] = semantic_hash(?alloc, ?rb, ?d[0]);
    if (sel semantic_hash_r5.err) { ret 1; }
    if (dig_eq(?base[0], ?d[0]))  { ret 1; }

    rb     = ra;
    rb.pie = true;
    val semantic_hash_r6: err[fail.Fail] = semantic_hash(?alloc, ?rb, ?d[0]);
    if (sel semantic_hash_r6.err) { ret 1; }
    if (dig_eq(?base[0], ?d[0]))  { ret 1; }
    ret 0;
}

# the profile's levers fill the request and each command-line lever wins over
# its profile's, and only a change marks the request as overriding the profile
test levers_compose__the_command_line_wins_over_the_profile {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    var itn: intern.Interner            = intern.init(?a);
    val id:  res[intern.StrId, A.Error] = intern.add(?itn, "p");
    if (sel id.err) { ret 2; }
    var pf: manifest.ResolvedProfile;
    pf.name     = id.ok;
    pf.optimize = false;
    pf.debug    = false;
    pf.simd     = manifest.SIMD_SCALARIZE;
    pf.pass     = manifest.NameList{items: nil, sites: nil, count: 0};
    pf.skip     = manifest.NameList{items: nil, sites: nil, count: 0};
    pf.relax    = true;

    var o:           Overrides      = overrides_init(?a);
    var r:           BuildRequest   = defaults();
    val as_profiled: err[fail.Fail] = levers_compose(?a, ?itn, ?pf, ?o, ?r);
    if (sel as_profiled.err)               { ret 4; }
    if (r.opt != OPT_DEBUG || r.overrides) { ret 5; }

    o.optimize = LEVER_ON;
    o.debug    = LEVER_ON;
    r          = defaults();
    val overridden: err[fail.Fail] = levers_compose(?a, ?itn, ?pf, ?o, ?r);
    if (sel overridden.err)                               { ret 7; }
    if (r.opt != OPT_RELEASE || !r.debug || !r.overrides) { ret 8; }

    var held: Overrides = overrides_init(?a);
    held.simd = opt[manifest.SimdMode].some{manifest.SIMD_REQUIRE};
    r         = defaults();
    val refused: err[fail.Fail] = levers_compose(?a, ?itn, ?pf, ?held, ?r);
    if (!(sel refused.err)) { ret 9; }
    ret 0;
}

test validate__unknown_catalog_members_never_hash_as_valid_requests {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    var r:          BuildRequest   = defaults();
    val validate_r: err[fail.Fail] = validate(?a, ?r);
    if (sel validate_r.err) { ret 2; }
    val catalogs: [5]str = [5]str{"BuildGoal", "OptLevel", "SimdMode", "SubsystemFlag", "Subsystem"};
    var i:        usize  = 0;
    for (i < 5) {
        r = defaults();
        if (i == 0) { r.goal = 255; }
        or (i == 1) { r.opt = 255; }
        or (i == 2) { r.simd = 255; }
        or (i == 3) { r.subsystem_flag = 255; }
        or          { r.subsystem = 255; }
        val valid: err[fail.Fail] = validate(?a, ?r);
        if (sel valid.ok) { ret 3; }
        val f:       fail.Fail = valid.err;
        val correct: bool      = sel f.message && str_contains(fail.describe(f), catalogs[i])
            && str_contains(fail.describe(f), "255");
        fail.dnit(?a, f);
        if (!correct) { ret 4; }
        var digest: [HASH_SIZE]u8;
        digest[0] = 171;
        val full: err[fail.Fail] = request_hash(?a, ?r, ?digest[0]);
        if (sel full.ok) { ret 5; }
        val full_message: str  = fail.describe(full.err);
        val full_correct: bool = str_contains(full_message, catalogs[i]) && digest[0] == 171;
        str_free(?a, full_message);
        if (!full_correct) { ret 6; }
        val semantic: err[fail.Fail] = semantic_hash(?a, ?r, ?digest[0]);
        if (sel semantic.ok) { ret 7; }
        val semantic_message: str  = fail.describe(semantic.err);
        val semantic_correct: bool = str_contains(semantic_message, catalogs[i]) && digest[0] == 171;
        str_free(?a, semantic_message);
        if (!semantic_correct) { ret 8; }
        i = i + 1;
    }
    ret 0;
}
