pub def RootSet: u8;

pub val ROOT_ARTIFACT: RootSet = 0;

pub val ROOT_UNION: RootSet = 1;

pub def TargetOpt: u8;

val TARGET_OPT_DEBUG: TargetOpt = 1;

pub val TARGET_OPT_RELEASE: TargetOpt = 2;

pub rec TargetEntry {
    name:          intern.StrId;
    os_name:       intern.StrId;
    isa_name:      intern.StrId;
    abi_name:      intern.StrId;
    of_name:       intern.StrId;
    platform_name: intern.StrId;
    env_name:      intern.StrId;
    base:          u64;
    stack_reserve: u64;
    stack_commit:  u64;
    # the manifest's `extensions` names, resolved against the isa at selection
    extensions:      [extension.MAX_SELECTED]intern.StrId;
    extension_count: u32;
    entrypoint:      intern.StrId;
    kind:            catalog_artifact.Kind;
    opt:             TargetOpt;
    libs:            *manifest.LinkRequirement;
    lib_count:       u32;
}

pub rec DepEntry {
    alias:           intern.StrId;
    project_id:      intern.StrId;
    project_dir_src: intern.StrId;
    project_module:  intern.StrId;
    vendor_root:     intern.StrId;
    source:          intern.StrId;
    ref:             intern.StrId;
    chain:           intern.StrId;
    root_declared:   bool;
    direct:          *intern.StrId;
    direct_count:    u32;
    manifest:        manifest.Manifest;
}

# what a configured build cell compiles and where it writes
# ---
# project_root:     the directory of the project that declares the cell: the root
#                   project, or for a dependency's cell the dependency's realization
# home_root:        the root project's directory; `project_out` is rooted here
# owner:            the dependency that declares the cell, moved out of the closure;
#                   meaningful only with `dependency_owned`
# dependency_owned: the cell is a requirement of a dependency's default library
#                   artifacts, built for the root project
# deps:             the realized closure the cell compiles against: the root's whole
#                   closure, or a dependency cell's own transitive closure
# art_reqs:         the requirements of the cell's artifact, in its declaring manifest
# req_scopes:       one requirement scope per project the cell compiles, the declaring
#                   project's first
pub rec ProjectConfig {
    id:                intern.StrId;
    version:           intern.StrId;
    bin_name:          intern.StrId;
    icon:              intern.StrId;
    app_manifest:      intern.StrId;
    module:            intern.StrId;
    dir_src:           intern.StrId;
    dir_dep:           intern.StrId;
    project_root:      intern.StrId;
    home_root:         intern.StrId;
    owner:             DepEntry;
    dependency_owned:  bool;
    targets:           *TargetEntry;
    target_count:      u32;
    deps:              *DepEntry;
    dep_count:         u32;
    cascade_libs:      *manifest.LinkRequirement;
    cascade_lib_count: u32;
    profile:           intern.StrId;
    project_out:       intern.StrId;
    steps:             *manifest.StepDef;
    step_count:        u32;
    step_order:        *u32;
    step_order_count:  u32;
    art_reqs:          *template.Requirement;
    art_req_count:     u32;
    req_scopes:        *template.Requirements;
    req_scope_count:   u32;
}

# an artifact entry the union walk loads: the entry module and the artifact it is of
pub rec ArtifactEntry {
    fqn:      intern.StrId;
    artifact: intern.StrId;
}

pub rec ModuleEntry {
    fqn:            intern.StrId;
    file_id:        lang_source.FileId;
    a:              *ast.Ast;
    parse_status:   fail.PhaseStatus;
    resolve_result: *resolve.ResolveResult;
    resolved:       bool;
    # the public surface each importer reads, decoded once per typed-exports revision
    typed_surface:     *fe_sema.ModuleSema;
    typed_surface_rev: query.Revision;
    sema_result:       *fe_sema.SemaResult;
    ir_module:         *me_ir.Module;
    object_image:      *target_of.ObjectImage;
    staged_image:      *target_of.ObjectImage;
    staged_facts:      cache_record.Facts;
    cache_checked:     bool;
    cache_hit:         bool;
    cache_under:       [32]u8;
    # the key this load built for the module's object, when it has one. the key
    # leaves the module's tests out, so the digest of its whole source keys its
    # test object and says whether the object's recorded warnings still stand
    cache_key:     [32]u8;
    cache_keyed:   bool;
    source_digest: [32]u8;
    # the module's object is reused and nothing the build still compiles
    # imports it, so it is not resolved, typed or lowered
    frontend_skipped: bool;
    # a lowering this session has bound the constants the module's normal object
    # binds, its own or a bind sweep before one that reads them
    constants_bound: bool;
    stable_id:       session.StableModuleId;
    # what the load decided for the module and the imports it records
    load: fe_load.Module;
    test: TestObject;
}

# a module's test object, beside its normal object and never changing it: the
# module's tests and what they reach that the normal object does not define. the
# fields mirror the normal object's on ModuleEntry
pub rec TestObject {
    ir_module:     *me_ir.Module;
    object_image:  *target_of.ObjectImage;
    staged_image:  *target_of.ObjectImage;
    staged_facts:  cache_record.Facts;
    cache_checked: bool;
    cache_hit:     bool;
    cache_under:   [32]u8;
    # the `#[testing]` constants, bound after the normal object's
    constants_bound: bool;
}

pub rec RawLowerCapture {
    key:       u64;
    output:    query.QueryOutput;
    available: *body.Available;
}

pub rec Project {
    s:                 *session.Session;
    alloc:             *A.Allocator;
    req:               request.BuildRequest;
    queries:           query.QueryRuntime[Project];
    raw_lower_capture: *RawLowerCapture;
    diags:             diagnostic.DiagnosticStore;
    config:            ProjectConfig;
    target_entry:      *TargetEntry;
    target:            lang_target.Binding;

    union_entries:     *ArtifactEntry;
    union_entry_count: u32;

    # the entries of artifacts this target does not build, loaded so the modules only they
    # reach are known and left out of the compiled set
    foreign_entries:     *ArtifactEntry;
    foreign_entry_count: u32;

    compiler_name: intern.StrId;
    compiler_ver:  intern.StrId;
    step_digest:   [32]u8;
    # the modules are keyed and `obj/` is read under those keys, until the next load
    cache_ready:                   bool;
    compiler_identity:             compiler.Identity;
    compiler_identity_initialized: bool;
    compiler_identity_available:   bool;
    cache_hits:                    u32;
    cache_misses:                  u32;
    # the build cell's obj directory, borrowed from its plan: where each
    # module's object is written and where the object cache reads it back
    object_dir: str;
    # the cell's compiler-only state directory, `<out>/.cache`, borrowed from
    # its plan: where the object cache keeps its digest memo
    cache_dir: str;
    # the cell's expanded `[project].out`, borrowed from its plan: the build
    # owns the layout beneath it
    out_dir: str;

    modules: handle.StableChunks[ModuleEntry];
    # the front end's load over the cell's packages, read through the session's open buffers
    loader:  fe_load.Loader;
    disk:    disk.Disk;
    overlay: overlay.Overlay;

    topo:     *session.ModuleId;
    topo_len: u32;
    topo_cap: u32;

    lower_visit_gen:   *u32;
    lower_visit_cap:   u32;
    lower_visit_epoch: u32;

    emit_len: u32;

    roots: RootSet;

    # the unit's phase rows, nil when nothing reads them
    progress: *readout.Progress;

    # how many products of each query kind this project computed rather than reused
    computes: [QUERY_KIND_SLOTS]u32;
}

val QUERY_KIND_SLOTS: u32 = 32;

pub fun note_compute(p: *Project, kind: query.QueryKind) {
    if (kind::u32 < QUERY_KIND_SLOTS) { p.computes[kind::u32] = p.computes[kind::u32] + 1; }
}

pub fun begin_query_phase(p: *Project) res[query.Operation, fail.Fail] {
    val reset: err[fail.Fail] = session.reset_type_projection(p.s);
    if (sel reset.err) {
        ret res[query.Operation, fail.Fail].err{reset.err};
    }
    val begun: res[query.Operation, fail.Fail] = query.begin(?p.s.queries);
    if (sel begun.err) {
        ret res[query.Operation, fail.Fail].err{begun.err};
    }
    release_fresh_staged(p);
    ret res[query.Operation, fail.Fail].ok{begun.ok};
}

# the session's store is rebuilt from the project's and the query presentation's,
# dropping the warnings a declaration's `#[expect]` acknowledges and the ones the
# profile's `allow` silences, then reporting each judged expectation nothing
# fulfilled. a warning replayed from the cache passes through here as a fresh one does
pub fun refresh_diagnostics(p: *Project) err[fail.Fail] {
    var staged: diagnostic.DiagnosticStore = diagnostic.store_init(p.s.alloc);
    diagnostic.silence(?staged, p.req.allow);
    var expects:  collections_vector.Vector[diagnostic.Expectation] = collections_vector.init[diagnostic.Expectation](p.s.alloc);
    val gathered: err[fail.Fail]                                    = gather_expectations(p, ?expects);
    diagnostic.expect(?staged, expects);
    if (sel gathered.err) {
        diagnostic.store_dnit(?staged);
        ret err[fail.Fail].err{gathered.err};
    }
    var copied:    err[fail.Fail] = diagnostic.replay_into(?staged, ?p.diags);
    val copied_ok: bool           = sel copied.ok && p.s.query_presentation != nil;
    if (copied_ok) {
        copied = diagnostic.replay_into(?staged, ?p.s.query_presentation.diags);
    }
    if (sel copied.err) {
        diagnostic.store_dnit(?staged);
        ret err[fail.Fail].err{copied.err};
    }
    diagnostic.report_unfulfilled(?staged);
    diagnostic.set_origin(?staged, p.s.diags.origin);
    diagnostic.store_dnit(?p.s.diags);
    p.s.diags = staged;
    ret err[fail.Fail].ok{};
}

# every loaded module's `#[expect]` keys. a module's are judged once its
# warnings are all in: it was type checked this build, or its front end was
# skipped and its recorded warnings replayed
fun gather_expectations(p: *Project, out: *collections_vector.Vector[diagnostic.Expectation]) err[fail.Fail] {
    var i: u32 = 0;
    for (i < module_count(p)) {
        val mid: u32          = i;
        val m:   *ModuleEntry = module_at(p, mid);
        i = i + 1;
        if (m.a == nil) { cnt; }
        val file: opt[*lang_source.SourceFile] = lang_source.get(?p.s.sources, m.file_id);
        if (sel file.none) { cnt; }
        val checked:   bool           = m.sema_result != nil || m.frontend_skipped;
        val collected: err[fail.Fail] = expect.collect(p.s, mid::session.ModuleId, m.a, file.some.text, ?m.load.ctx, checked, out);
        if (sel collected.err) { ret collected; }
    }
    ret err[fail.Fail].ok{};
}

pub fun finish_query_phase(p: *Project, operation: query.Operation,
    roots: *query.QueryKey, count: usize,
    result: err[fail.Fail]) err[fail.Fail] {
    val db:    *query.QueryDb = ?p.s.queries;
    val ended: err[fail.Fail] = query.end(db, operation);
    if (!db.operation_active) { release_fresh_staged(p); }
    var final_result:      err[fail.Fail] = result;
    var operation_failure: bool           = false;
    var message:           str            = nil;
    var held_places:       fail.Fail      = fail.reported();
    var lost:              bool           = false;
    if (sel ended.err) {
        val failure:   fail.Fail = ended.err;
        var displaces: bool      = sel result.ok;
        if (sel result.err) {
            if (sel failure.message && !fail.is_message(result.err)) { displaces = true; }
        }
        if (displaces) {
            final_result      = err[fail.Fail].err{failure};
            operation_failure = true;
        }
    }
    if (!operation_failure) {
        if (sel result.err) {
            var failure: fail.Fail = result.err;
            val carried: opt[str]  = fail.text(failure);
            if (sel carried.some) {
                val copied: res[str, A.Error] = str_dup(db.a, carried.some);
                if (sel copied.err) {
                    failure = fail.with_text(failure, lang_alloc.text(copied.err));
                    lost    = true;
                }
                if (sel copied.ok) {
                    message = copied.ok;
                    failure = fail.with_text(failure, message);
                }
                val places_r: res[fail.Fail, A.Error] = fail.places_retain(db.a, failure);
                if (sel places_r.err) {
                    failure = fail.without_places(failure);
                    lost    = true;
                }
                if (sel places_r.ok) {
                    failure     = places_r.ok;
                    held_places = failure;
                }
                final_result = err[fail.Fail].err{failure};
            }
        }
    }

    val collected: res[*query.Presentation, fail.Fail] = query.collect(db, operation, roots, count, p.s.alloc);
    if (sel collected.err) {
        val taken: res[str, fail.Fail] = query.take_failure_message(db, operation);
        if (sel taken.ok) {
            if (taken.ok != nil) {
                if (operation_failure) { message = taken.ok; }
                or                     { str_free(db.a, taken.ok); }
            }
        }
        if (sel taken.err) { lost = true; }
        val discarded: err[fail.Fail] = query.discard(db, operation);
        if (sel discarded.err) { lost = true; }
        val no_result: bool = sel final_result.ok;
        if (no_result) {
            final_result = err[fail.Fail].err{collected.err};
        }
        lost = true;
    }
    if (sel collected.ok) {
        val presentation: *query.Presentation = collected.ok;
        if (p.s.query_presentation != nil) { query.presentation_dnit(p.s.query_presentation); }
        p.s.query_presentation = presentation;
        val refreshed: err[fail.Fail] = refresh_diagnostics(p);
        if (sel refreshed.err) {
            val final_result_ok: bool = sel final_result.ok;
            if (final_result_ok) { final_result = refreshed; }
            lost = true;
        }
    }
    session.drop_query_failure(p.s);
    p.s.query_failure_message = message;
    p.s.query_failure_places  = held_places;
    if (lost) {
        diagnostic.note_lost(?p.diags);
        diagnostic.note_lost(?p.s.diags);
    }
    # a rejected operation leaves its published products as live as an
    # accepted one does, so the entries keep them; any other failure drops
    # every borrowed product pointer
    var products_stand: bool = sel ended.ok;
    if (sel ended.err) { products_stand = sel ended.err.reported; }
    if (!products_stand) {
        var i: u32 = 0;
        for (i < module_count(p)) {
            val m: *ModuleEntry = module_at(p, i);
            m.a                 = nil;
            m.resolve_result    = nil;
            m.sema_result       = nil;
            m.ir_module         = nil;
            m.object_image      = nil;
            m.test.ir_module    = nil;
            m.test.object_image = nil;
            i                   = i + 1;
        }
        i = 0;
        for (i < p.s.module_ast_count) {
            p.s.module_asts[i] = nil;
            i                  = i + 1;
        }
        map.clear[session.ModuleId, ptr](?p.s.module_resolve);
        map.clear[session.ModuleId, ptr](?p.s.module_sema);
        map.clear[session.ModuleId, ptr](?p.s.module_comptime);
    }
    ret final_result;
}

pub fun span_eq_str(source: str, span: lang_source.Span, s: str) bool {
    val n: usize = str_len(s);
    if (span.len != n) { ret false; }
    var i: usize = 0;
    for (i < n) {
        if (source[span.offset + i] != s[i]::u8) { ret false; }
        i = i + 1;
    }
    ret true;
}

pub fun link_name_for(p: *Project, bare: intern.StrId) res[intern.StrId, fail.Fail] {
    if (p.target.os == nil) {
        ret res[intern.StrId, fail.Fail].err{fail.message("internal: link name needs a resolved target")};
    }
    val prefix: str = p.target.os.c_symbol_prefix;
    if (str_len(prefix) == 0) { ret res[intern.StrId, fail.Fail].ok{bare}; }

    val bare_opt: opt[str] = intern.get(?p.s.interner, bare);
    if (sel bare_opt.none) {
        ret res[intern.StrId, fail.Fail].err{fail.message("internal: link name source is not interned")};
    }
    val joined_r: res[str, types_string.StrError] = str_join(p.s.build_alloc, prefix, bare_opt.some);
    if (sel joined_r.err) {
        ret res[intern.StrId, fail.Fail].err{fail.str_refused(joined_r.err)};
    }
    val joined: str                        = joined_r.ok;
    val id_r:   res[intern.StrId, A.Error] = intern.add(?p.s.interner, joined);
    str_free(p.s.build_alloc, joined);
    if (sel id_r.err) { ret res[intern.StrId, fail.Fail].err{fail.refused(id_r.err)}; }
    ret res[intern.StrId, fail.Fail].ok{id_r.ok};
}

# staged images are project-owned until a query takes them, object_image is borrowed
pub fun release_staged(p: *Project, m: *ModuleEntry) {
    if (m.staged_image != nil) {
        target_of.object_image_dnit(m.staged_image);
        A.deallocate[target_of.ObjectImage](p.s.alloc, m.staged_image, 1);
        m.staged_image = nil;
    }
    cache_record.facts_dnit(p.s.alloc, ?m.staged_facts);
    m.cache_checked = false;
    m.cache_hit     = false;
}

pub fun release_staged_test(p: *Project, m: *ModuleEntry) {
    val t: *TestObject = ?m.test;
    if (t.staged_image != nil) {
        target_of.object_image_dnit(t.staged_image);
        A.deallocate[target_of.ObjectImage](p.s.alloc, t.staged_image, 1);
        t.staged_image = nil;
    }
    cache_record.facts_dnit(p.s.alloc, ?t.staged_facts);
    t.cache_checked = false;
    t.cache_hit     = false;
}

pub fun release_all_staged(p: *Project) {
    var i: u32 = 0;
    for (i < module_count(p)) {
        release_staged(p, module_at(p, i));
        release_staged_test(p, module_at(p, i));
        i = i + 1;
    }
}

# a restored product stays staged across operations: it is keyed by the key
# it was read under and the next load discards it if that changed. a freshly
# generated image staged by a codegen worker belongs to the operation that
# generated it and leaves with it
fun release_fresh_staged(p: *Project) {
    var i: u32 = 0;
    for (i < module_count(p)) {
        val m: *ModuleEntry = module_at(p, i);
        if (m.staged_image != nil && !m.cache_hit)           { release_staged(p, m); }
        if (m.test.staged_image != nil && !m.test.cache_hit) { release_staged_test(p, m); }
        i = i + 1;
    }
}

pub fun dnit_project(p: *Project) {
    if (p == nil) { ret; }
    release_fresh_staged(p);
    release_all_staged(p);
    var i: u32 = 0;
    for (i < module_count(p)) {
        val m: *ModuleEntry = module_at(p, i);
        fe_load.module_dnit(p.alloc, ?m.load);
        drop_surface(p.alloc, ?m.typed_surface);
        i = i + 1;
    }
    handle.chunk_dnit[ModuleEntry](?p.modules);
    if (p.topo != nil && p.topo_cap > 0) {
        A.deallocate[session.ModuleId](p.alloc, p.topo, p.topo_cap::usize);
    }
    if (p.lower_visit_gen != nil && p.lower_visit_cap > 0) {
        A.deallocate[u32](p.alloc, p.lower_visit_gen, p.lower_visit_cap::usize);
    }
    if (p.union_entries != nil && p.union_entry_count > 0) {
        A.deallocate[ArtifactEntry](p.alloc, p.union_entries, p.union_entry_count::usize);
    }
    if (p.foreign_entries != nil && p.foreign_entry_count > 0) {
        A.deallocate[ArtifactEntry](p.alloc, p.foreign_entries, p.foreign_entry_count::usize);
    }
    fe_load.dnit(?p.loader);
    disk.dnit(?p.disk);
    diagnostic.store_dnit(?p.diags);
    deallocate_config(?p.config, p.alloc);

    session.reset_module_registry(p.s);
}

# attribute what the project's phases report directly, outside a query, to the
# phase now running: both the project's store and the session's
pub fun set_origin(p: *Project, o: diagnostic.Origin) {
    diagnostic.set_origin(?p.diags, o);
    diagnostic.set_origin(?p.s.diags, o);
}

pub fun init_project(p: *Project, s: *session.Session) {
    if (s.query_presentation != nil) {
        query.presentation_dnit(s.query_presentation);
        s.query_presentation = nil;
    }
    session.drop_query_failure(s);
    diagnostic.store_dnit(?s.diags);
    s.diags                 = diagnostic.store_init(s.alloc);
    p.s                     = s;
    p.alloc                 = s.build_alloc;
    p.req                   = request.defaults();
    p.raw_lower_capture     = nil;
    p.queries.db            = nil;
    p.queries.caps.compute  = nil;
    p.diags                 = diagnostic.store_init(p.alloc);
    p.target_entry          = nil;
    p.union_entries         = nil;
    p.union_entry_count     = 0;
    p.foreign_entries       = nil;
    p.foreign_entry_count   = 0;
    p.target.target.os_id   = catalog_os.UNKNOWN;
    p.target.target.arch_id = catalog_arch.UNKNOWN;
    p.target.target.abi_id  = 0;
    p.target.os             = nil;
    p.target.arch           = nil;
    p.target.abi            = nil;
    p.target.of             = nil;
    p.compiler_name         = intern.STR_NIL;
    p.compiler_ver          = intern.STR_NIL;
    var cache_byte: usize = 0;
    for (cache_byte < 32) {
        p.step_digest[cache_byte] = 0;
        cache_byte                = cache_byte + 1;
    }
    compiler.identity_clear(?p.compiler_identity);
    p.cache_ready                   = false;
    p.compiler_identity_initialized = false;
    p.compiler_identity_available   = false;
    p.cache_hits                    = 0;
    p.cache_misses                  = 0;
    p.object_dir                    = nil;
    p.cache_dir                     = nil;
    p.out_dir                       = nil;
    var ki: u32 = 0;
    for (ki < QUERY_KIND_SLOTS) {
        p.computes[ki] = 0;
        ki             = ki + 1;
    }
    p.config.id                = intern.STR_NIL;
    p.config.version           = intern.STR_NIL;
    p.config.bin_name          = intern.STR_NIL;
    p.config.icon              = intern.STR_NIL;
    p.config.app_manifest      = intern.STR_NIL;
    p.config.module            = intern.STR_NIL;
    p.config.targets           = nil;
    p.config.target_count      = 0;
    p.config.deps              = nil;
    p.config.dep_count         = 0;
    p.config.cascade_libs      = nil;
    p.config.cascade_lib_count = 0;
    p.config.art_reqs          = nil;
    p.config.art_req_count     = 0;
    p.config.req_scopes        = nil;
    p.config.req_scope_count   = 0;
    p.config.home_root         = intern.STR_NIL;
    p.config.dependency_owned  = false;
    p.modules                  = handle.chunk_init[ModuleEntry](p.alloc);
    p.loader                   = fe_load.init(s, p.alloc);
    p.disk                     = disk.init(p.alloc, ?s.interner);
    p.topo                     = nil;
    p.topo_len                 = 0;
    p.topo_cap                 = 0;
    p.lower_visit_gen          = nil;
    p.lower_visit_cap          = 0;
    p.lower_visit_epoch        = 0;
    p.emit_len                 = 0;
    p.roots                    = ROOT_ARTIFACT;
    p.progress                 = nil;
    set_origin(p, diagnostic.ORIGIN_BUILD);
}

fun deallocate_config(c: *ProjectConfig, alloc: *A.Allocator) {
    if (c.targets != nil && c.target_count > 0) {
        var i: u32 = 0;
        for (i < c.target_count) {
            val te: *TargetEntry = ?c.targets[i];
            if (te.libs != nil && te.lib_count > 0) {
                manifest.free_link_claims(alloc, te.libs, te.lib_count);
                A.deallocate[manifest.LinkRequirement](alloc, te.libs, te.lib_count::usize);
            }
            i = i + 1;
        }
        A.deallocate[TargetEntry](alloc, c.targets, c.target_count::usize);
    }
    if (c.deps != nil && c.dep_count > 0) {
        free_dep_entries(alloc, c.deps, c.dep_count, c.dep_count::usize);
    }
    if (c.cascade_libs != nil && c.cascade_lib_count > 0) {
        manifest.free_link_claims(alloc, c.cascade_libs, c.cascade_lib_count);
        A.deallocate[manifest.LinkRequirement](alloc, c.cascade_libs, c.cascade_lib_count::usize);
    }
    if (c.steps != nil && c.step_count > 0) {
        var si: u32 = 0;
        for (si < c.step_count) {
            manifest.step_dnit(alloc, ?c.steps[si]);
            si = si + 1;
        }
        A.deallocate[manifest.StepDef](alloc, c.steps, c.step_count::usize);
    }
    if (c.step_order != nil && c.step_order_count > 0) {
        A.deallocate[u32](alloc, c.step_order, c.step_order_count::usize);
    }
    free_artifact_reqs(alloc, c.art_reqs, c.art_req_count);
    if (c.req_scopes != nil && c.req_scope_count > 0) {
        var si: u32 = 0;
        for (si < c.req_scope_count) {
            if (c.req_scopes[si].dependency) {
                free_artifact_reqs(alloc, c.req_scopes[si].reqs, c.req_scopes[si].req_count);
            }
            si = si + 1;
        }
        A.deallocate[template.Requirements](alloc, c.req_scopes, c.req_scope_count::usize);
    }
    if (c.dependency_owned) {
        free_dep_entries_in_place(alloc, ?c.owner, 1);
    }
    c.dependency_owned  = false;
    c.req_scopes        = nil;
    c.req_scope_count   = 0;
    c.art_reqs          = nil;
    c.art_req_count     = 0;
    c.targets           = nil;
    c.target_count      = 0;
    c.deps              = nil;
    c.dep_count         = 0;
    c.cascade_libs      = nil;
    c.cascade_lib_count = 0;
    c.steps             = nil;
    c.step_count        = 0;
    c.step_order        = nil;
    c.step_order_count  = 0;
}

pub fun free_dep_entries(alloc: *A.Allocator, deps: *DepEntry, count: u32, capacity: usize) {
    if (deps == nil) { ret; }
    free_dep_entries_in_place(alloc, deps, count);
    A.deallocate[DepEntry](alloc, deps, capacity);
}

# release what each entry owns, leaving the entries' own storage to the caller
pub fun free_dep_entries_in_place(alloc: *A.Allocator, deps: *DepEntry, count: u32) {
    var i: u32 = 0;
    for (i < count) {
        if (deps[i].direct != nil && deps[i].direct_count > 0) {
            A.deallocate[intern.StrId](alloc, deps[i].direct, deps[i].direct_count::usize);
        }
        manifest.dnit(?deps[i].manifest, alloc);
        i = i + 1;
    }
}

fun free_artifact_reqs(alloc: *A.Allocator, reqs: *template.Requirement, count: u32) {
    if (reqs == nil || count == 0) { ret; }
    var ri: u32 = 0;
    for (ri < count) {
        if (!str_empty(reqs[ri].out)) { str_free(alloc, reqs[ri].out); }
        ri = ri + 1;
    }
    A.deallocate[template.Requirement](alloc, reqs, count::usize);
}

# the pipeline level a manifest profile level selects; absent for a tag
# outside the catalog, which the caller reports through the catalog policy
pub fun map_opt(o: manifest.MOpt) opt[TargetOpt] {
    if (o == manifest.MOPT_RELEASE) { ret opt[TargetOpt].some{TARGET_OPT_RELEASE}; }
    if (o == manifest.MOPT_DEBUG)   { ret opt[TargetOpt].some{TARGET_OPT_DEBUG}; }
    ret opt[TargetOpt].none{};
}

# whether `id` is interned text equal to `text`
#[testing]
pub fun id_is(itn: *intern.Interner, id: intern.StrId, text: str) bool {
    ret !intern.str_is_nil(id) && str_equals(intern.text(itn, id), text);
}

# the loaded module count; the next ModuleId to be issued
pub fun module_count(p: *Project) u32 {
    ret handle.chunk_count[ModuleEntry](?p.modules)::u32;
}

# the entry behind a ModuleId the project has issued
#
# the store is a handle.StableChunks: an entry is written once into a fixed
# chunk and never moves, so the pointer stays valid until dnit_project however
# many modules load after it. total: an id the project never issued stops the
# compiler
pub fun module_at(p: *Project, mid: u32) *ModuleEntry {
    val slot: opt[*ModuleEntry] = handle.chunk_at[ModuleEntry](?p.modules, mid::usize);
    if (sel slot.some) { ret slot.some; }
    panic("project: module index is past the loaded modules\n");
    ret nil;
}

fun store_fail(e: handle.Error) fail.Fail {
    if (sel e.alloc) { ret fail.refused(e.alloc); }
    ret fail.message(handle.text(e));
}

# make room for one more entry so the next module_append cannot fail
pub fun module_reserve(p: *Project) err[fail.Fail] {
    val editor_r: res[handle.ChunkEditor[ModuleEntry], handle.Error] = handle.chunk_editor[ModuleEntry](?p.modules);
    if (sel editor_r.err) { ret err[fail.Fail].err{store_fail(editor_r.err)}; }
    var editor: handle.ChunkEditor[ModuleEntry] = editor_r.ok;
    fin { handle.chunk_editor_finish[ModuleEntry](?editor); }
    val grown: err[handle.Error] = handle.chunk_grow[ModuleEntry](?editor, 1);
    if (sel grown.err) { ret err[fail.Fail].err{store_fail(grown.err)}; }
    ret err[fail.Fail].ok{};
}

# publish an entry under the next ModuleId into the slot module_reserve made.
# total: a caller that reserved nothing first stops the compiler
pub fun module_append(p: *Project, m: ModuleEntry) session.ModuleId {
    val mid:      session.ModuleId                                   = module.id(module_count(p));
    val editor_r: res[handle.ChunkEditor[ModuleEntry], handle.Error] = handle.chunk_editor[ModuleEntry](?p.modules);
    if (sel editor_r.err) {
        panic("project: module_append while the module table is being edited\n");
        ret mid;
    }
    var editor: handle.ChunkEditor[ModuleEntry] = editor_r.ok;
    fin { handle.chunk_editor_finish[ModuleEntry](?editor); }
    val placed: res[*ModuleEntry, handle.Error] = handle.chunk_append[ModuleEntry](?editor, m);
    if (sel placed.err) { panic("project: reserved module slot refused the append\n"); }
    ret mid;
}

# how many modules a loaded module imports
pub fun dep_count(m: *ModuleEntry) u32 {
    ret m.load.deps.len::u32;
}

# the module a loaded module imports at `i`, as its load record names it
pub fun dep_at(p: *Project, m: *ModuleEntry, i: u32) session.ModuleId {
    ret fe_load.module_of(?p.loader, m.load.deps.data[i::usize]);
}

# the entry loaded under a fully qualified name
#
# the returned `*ModuleEntry` is stable until dnit_project: the store never
# moves an entry when more modules load, so a holder may keep it across a
# nested load and read the same entry afterwards
pub fun module_by_fqn(p: *Project, fqn: intern.StrId) opt[*ModuleEntry] {
    val r: opt[session.ModuleId] = fe_load.module_find(?p.loader, fqn);
    if (sel r.none) { ret opt[*ModuleEntry].none{}; }
    val mid: session.ModuleId = r.some;
    if (mid::u32 >= module_count(p)) { ret opt[*ModuleEntry].none{}; }
    ret opt[*ModuleEntry].some{module_at(p, mid::u32)};
}

# the loaded module a source file backs, by a scan of the module table: editor edits
# arrive as file ids and the table is small beside the work a refresh saves
# ---
# p:   the project
# fid: the file
# ret: the module's id, or none when no loaded module reads that file
pub fun module_by_file(p: *Project, fid: lang_source.FileId) opt[session.ModuleId] {
    var i: u32 = 0;
    for (i < module_count(p)) {
        if (lang_source.file_same(module_at(p, i).file_id, fid)) { ret opt[session.ModuleId].some{i::session.ModuleId}; }
        i = i + 1;
    }
    ret opt[session.ModuleId].none{};
}

pub fun drop_surface(a: *A.Allocator, slot: **fe_sema.ModuleSema) {
    if (@slot == nil) { ret; }
    sema_context.module_sema_dnit(@slot);
    A.deallocate[fe_sema.ModuleSema](a, @slot, 1::usize);
    @slot = nil;
}

test module_by_fqn__pointer_stays_valid_across_growth {
    var a: A.Allocator;
    page.make(?a);
    val sr: res[session.Session, fail.Fail] = session.init(?a);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var p: Project;
    init_project(?p, ?s);
    fin { dnit_project(?p); }

    val first_r: res[intern.StrId, A.Error] = intern.add(?s.interner, "growth.first");
    if (sel first_r.err) { ret 1; }
    val first: intern.StrId   = first_r.ok;
    val room:  err[fail.Fail] = module_reserve(?p);
    if (sel room.err) { ret 1; }
    var entry: ModuleEntry;
    entry.fqn = first;
    val mid:   session.ModuleId   = module_append(?p, entry);
    val named: res[bool, A.Error] = map.insert[intern.StrId, session.ModuleId](?p.loader.by_name, first, mid);
    if (sel named.err) { ret 1; }
    val held_o: opt[*ModuleEntry] = module_by_fqn(?p, first);
    if (sel held_o.none) { ret 1; }
    val held: *ModuleEntry = held_o.some;

    # grow past 16, 32, 64 and 128 modules; the held pointer must not move at any boundary
    var i: u32 = 0;
    for (i < 200) {
        val more: err[fail.Fail] = module_reserve(?p);
        if (sel more.err) { ret 1; }
        module_append(?p, ModuleEntry{});
        val again: opt[*ModuleEntry] = module_by_fqn(?p, first);
        if (sel again.none)     { ret 1; }
        if (again.some != held) { ret 2; }
        i = i + 1;
    }

    if (!intern.str_same(held.fqn, first)) { ret 3; }
    if (module_count(?p) != 201)           { ret 3; }
    if (module_at(?p, mid::u32) != held)   { ret 2; }
    ret 0;
}
