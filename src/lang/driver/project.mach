pub def RootSet: u8;

pub val ROOT_ARTIFACT: RootSet = 0;

pub val ROOT_TEST:     RootSet = 1;

pub val ROOT_UNION:    RootSet = 2;

pub def BuildMode: u8;

pub val MODE_EXECUTABLE: BuildMode = 0;

pub val MODE_LIBRARY:    BuildMode = 1;

pub def TargetOpt: u8;

pub val TARGET_OPT_DEFAULT: TargetOpt = 0;

pub val TARGET_OPT_DEBUG:   TargetOpt = 1;

pub val TARGET_OPT_RELEASE: TargetOpt = 2;

pub rec TargetEntry {
    name:          intern.StrId;
    os_name:       intern.StrId;
    isa_name:      intern.StrId;
    abi_name:      intern.StrId;
    of_name:       intern.StrId;
    platform_name: intern.StrId;
    env_name:      intern.StrId;
    base:          u64;
    stack_reserve: u64;
    stack_commit:  u64;
    entrypoint:    intern.StrId;
    mode:          BuildMode;
    opt:           TargetOpt;
    libs:          *manifest.LinkRequirement;
    lib_count:     u32;
    lib_kind:      manifest.LibKind;
}

pub rec DepEntry {
    alias:           intern.StrId;
    project_id:      intern.StrId;
    project_dir_src: intern.StrId;
    project_module:  intern.StrId;
    vendor_root:     intern.StrId;
    source:          intern.StrId;
    ref:             intern.StrId;
    content:         intern.StrId;
    chain:           intern.StrId;
    root_declared:   bool;
    direct:          *intern.StrId;
    direct_count:    u32;
    manifest:        manifest.Manifest;
}

pub rec ProjectConfig {
    id:           intern.StrId;
    version:      intern.StrId;
    name:         intern.StrId;
    description:  intern.StrId;
    bin_name:     intern.StrId;
    icon:         intern.StrId;
    app_manifest: intern.StrId;
    module:       intern.StrId;
    dir_src:      intern.StrId;
    dir_dep:      intern.StrId;
    project_root: intern.StrId;
    targets:      *TargetEntry;
    target_count: u32;
    deps:         *DepEntry;
    dep_count:    u32;
    defines:      *intern.StrId;
    define_count: u32;
    cascade_libs:      *manifest.LinkRequirement;
    cascade_lib_count: u32;
    profile:      intern.StrId;
    project_out:  intern.StrId;
    steps:        *manifest.StepDef;
    step_count:   u32;
    step_order:       *u32;
    step_order_count: u32;
    art_reqs:         *manifest.ArtifactReq;
    art_req_count:    u32;
}

pub rec PubConst {
    name:  intern.StrId;
    value: comptime.CTValue;
    gated: bool;
}

pub rec ModRef {
    name:   intern.StrId;
    module: session.ModuleId;
    span:   token.Span;
}

pub rec TupleGateResult {
    states:             *comptime.GateState;
    state_count:        u32;
    entries:            *comptime.NamedConst;
    entries_len:        u32;
    entries_cap:        u32;
    deferred:           *intern.StrId;
    deferred_len:       u32;
    deferred_cap:       u32;
    resolve_result:     *resolve.ResolveResult;
    sema_result:        *sema.SemaResult;
    merged_const_count: u32;
}

pub rec ModuleEntry {
    fqn:               intern.StrId;
    file_id:           src.FileId;
    a:                 *ast.Ast;
    ctx:               comptime.ComptimeCtx;
    pub_consts:        *PubConst;
    pub_const_count:   u32;
    pub_const_cap:     u32;
    mod_refs:          *ModRef;
    mod_ref_count:     u32;
    mod_ref_cap:       u32;
    const_imports:     *ModRef;
    const_import_count: u32;
    const_import_cap:   u32;
    deps:              *session.ModuleId;
    dep_count:         u32;
    dep_cap:           u32;
    resolve_result:    *resolve.ResolveResult;
    resolved:          bool;
    gate_result:       *sema.SemaResult;
    tuple_gates:       *TupleGateResult;
    tuple_gate_count:  u32;
    tuple_reachable:   *bool;
    tuple_reach_count: u32;
    sema_result:       *sema.SemaResult;
    ir_module:         *ir.Module;
    object_image:      *of.ObjectImage;
    staged_ir:         *ir.Module;
    staged_home:       *ir.ModuleHome;
    staged_image:      *of.ObjectImage;
    stable_id:         session.StableModuleId;
    target_gated:      bool;
    load_outcome:      comptime.GateOutcome;
    load_walk_count:   u32;
}

pub def LoadStatus: u8;

pub val LOAD_NEW:     LoadStatus = 0;

pub val LOAD_LOADING: LoadStatus = 1;

pub val LOAD_DONE:    LoadStatus = 2;

pub rec TargetTuple {
    os_id:         u32;
    arch_id:       u32;
    abi_id:        u32;
    pointer_width: u32;
    vector_bits:   u32;
    has_float:     bool;
    target_defs:   *isa.TargetDefs;
    va_list_size:  u32;
    va_list_align: u32;
    os_name:       intern.StrId;
    isa_name:      intern.StrId;
    abi_name:      intern.StrId;
    platform_name: intern.StrId;
}

pub rec Project {
    s:            *session.Session;
    alloc:        *A.Allocator;
    req:          request.BuildRequest;
    queries:      query.QueryRuntime[Project];
    config:       ProjectConfig;
    target_entry: *TargetEntry;
    target:       target.Target;

    union:              bool;
    union_tuples:       *TargetTuple;
    union_tuple_count:  u32;
    union_tuple_cap:    u32;

    union_entries:      *intern.StrId;
    union_entry_count:  u32;

    compiler_name:  intern.StrId;
    compiler_ver:   intern.StrId;

    modules:      *ModuleEntry;
    module_len:   u32;
    module_cap:   u32;
    by_fqn:       map.Map[intern.StrId, session.ModuleId];

    load_status:  *LoadStatus;
    load_cap:     u32;

    topo:         *session.ModuleId;
    topo_len:     u32;
    topo_cap:     u32;

    lower_visit_gen:   *u32;
    lower_visit_cap:   u32;
    lower_visit_epoch: u32;

    emit_len:     u32;

    roots:        RootSet;

    events:       *readout.Progress;

    loading_orphans:    bool;
    union_tuple_filter: *bool;
    gate_tuple_index:   u32;
    in_gated_decl_walk: bool;
    gate_terminal:      bool;
}

pub fun span_eq_str(source: str, span: token.Span, s: str) bool {
    val n: usize = str_len(s);
    if (span.len != n) { ret false; }
    var i: usize = 0;
    for (i < n) {
        if (source[span.offset + i] != s[i]::u8) { ret false; }
        i = i + 1;
    }
    ret true;
}

pub fun link_name_for(p: *Project, bare: intern.StrId) R.Result[intern.StrId, str] {
    if (p.target.os == nil) {
        ret R.err[intern.StrId, str]("internal: link name needs a resolved target");
    }
    val prefix: str = p.target.os.c_symbol_prefix;
    if (str_len(prefix) == 0) { ret R.ok[intern.StrId, str](bare); }

    val bare_opt: O.Option[str] = intern.lookup(?p.s.interner, bare);
    if (O.is_none[str](bare_opt)) {
        ret R.err[intern.StrId, str]("internal: link name source is not interned");
    }
    val joined_r: R.Result[str, str] = str_join(p.s.build_alloc, prefix, O.unwrap[str](bare_opt));
    if (R.is_err[str, str](joined_r)) {
        ret R.err[intern.StrId, str](R.unwrap_err[str, str](joined_r));
    }
    val joined: str = R.unwrap_ok[str, str](joined_r);
    val id_r: R.Result[intern.StrId, str] = intern.intern(?p.s.interner, joined);
    str_free(p.s.build_alloc, joined);
    ret id_r;
}

pub fun dnit_project(p: *Project) {
    if (p == nil) { ret; }
    var i: u32 = 0;
    for (i < p.module_len) {
        val m: *ModuleEntry = ?p.modules[i];
        comptime.dnit(?m.ctx);
        if (m.pub_consts != nil && m.pub_const_cap > 0) {
            A.deallocate[PubConst](p.alloc, m.pub_consts, m.pub_const_cap::usize);
        }
        if (m.mod_refs != nil && m.mod_ref_cap > 0) {
            A.deallocate[ModRef](p.alloc, m.mod_refs, m.mod_ref_cap::usize);
        }
        if (m.const_imports != nil && m.const_import_cap > 0) {
            A.deallocate[ModRef](p.alloc, m.const_imports, m.const_import_cap::usize);
        }
        if (m.deps != nil && m.dep_cap > 0) {
            A.deallocate[session.ModuleId](p.alloc, m.deps, m.dep_cap::usize);
        }
        if (m.gate_result != nil) {
            sema.dnit_result(m.gate_result);
            A.deallocate[sema.SemaResult](p.alloc, m.gate_result, 1::usize);
        }
        if (m.tuple_gates != nil) {
            var ti: u32 = 0;
            for (ti < m.tuple_gate_count) {
                val tg: *TupleGateResult = ?m.tuple_gates[ti];
                if (tg.states != nil && tg.state_count > 0) {
                    A.deallocate[comptime.GateState](p.alloc, tg.states, tg.state_count::usize);
                }
                if (tg.entries != nil && tg.entries_cap > 0) {
                    A.deallocate[comptime.NamedConst](p.alloc, tg.entries, tg.entries_cap::usize);
                }
                if (tg.deferred != nil && tg.deferred_cap > 0) {
                    A.deallocate[intern.StrId](p.alloc, tg.deferred, tg.deferred_cap::usize);
                }
                if (tg.resolve_result != nil) {
                    resolve.dnit_result(tg.resolve_result);
                    A.deallocate[resolve.ResolveResult](p.alloc, tg.resolve_result, 1::usize);
                }
                if (tg.sema_result != nil) {
                    sema.dnit_result(tg.sema_result);
                    A.deallocate[sema.SemaResult](p.alloc, tg.sema_result, 1::usize);
                }
                ti = ti + 1;
            }
            A.deallocate[TupleGateResult](p.alloc, m.tuple_gates, m.tuple_gate_count::usize);
        }
        if (m.tuple_reachable != nil && m.tuple_reach_count > 0) {
            A.deallocate[bool](p.alloc, m.tuple_reachable, m.tuple_reach_count::usize);
        }
        i = i + 1;
    }
    if (p.modules != nil && p.module_cap > 0) {
        A.deallocate[ModuleEntry](p.alloc, p.modules, p.module_cap::usize);
    }
    if (p.load_status != nil && p.load_cap > 0) {
        A.deallocate[LoadStatus](p.alloc, p.load_status, p.load_cap::usize);
    }
    if (p.topo != nil && p.topo_cap > 0) {
        A.deallocate[session.ModuleId](p.alloc, p.topo, p.topo_cap::usize);
    }
    if (p.lower_visit_gen != nil && p.lower_visit_cap > 0) {
        A.deallocate[u32](p.alloc, p.lower_visit_gen, p.lower_visit_cap::usize);
    }
    if (p.union_tuples != nil && p.union_tuple_cap > 0) {
        A.deallocate[TargetTuple](p.alloc, p.union_tuples, p.union_tuple_cap::usize);
    }
    if (p.union_entries != nil && p.union_entry_count > 0) {
        A.deallocate[intern.StrId](p.alloc, p.union_entries, p.union_entry_count::usize);
    }
    map.dnit[intern.StrId, session.ModuleId](?p.by_fqn);
    deallocate_config(?p.config, p.alloc);

    session.reset_module_registry(p.s);
}

pub fun init_project(p: *Project, s: *session.Session) {
    p.s             = s;
    p.alloc         = s.build_alloc;
    p.req           = request.defaults();
    p.queries.db    = nil;
    p.queries.diags = nil;
    p.queries.caps.compute = nil;
    p.target_entry  = nil;
    p.union              = false;
    p.union_tuples       = nil;
    p.union_tuple_count  = 0;
    p.union_tuple_cap    = 0;
    p.union_entries      = nil;
    p.union_entry_count  = 0;
    p.target.os_id   = os.OS_UNKNOWN;
    p.target.arch_id = isa.ARCH_UNKNOWN;
    p.target.abi_id  = 0;
    p.target.os      = nil;
    p.target.arch    = nil;
    p.target.abi     = nil;
    p.target.of      = nil;
    p.compiler_name = intern.STR_NIL;
    p.compiler_ver  = intern.STR_NIL;
    p.config.id           = intern.STR_NIL;
    p.config.version      = intern.STR_NIL;
    p.config.name         = intern.STR_NIL;
    p.config.description  = intern.STR_NIL;
    p.config.bin_name     = intern.STR_NIL;
    p.config.icon         = intern.STR_NIL;
    p.config.app_manifest = intern.STR_NIL;
    p.config.module       = intern.STR_NIL;
    p.config.targets      = nil;
    p.config.target_count = 0;
    p.config.deps         = nil;
    p.config.dep_count    = 0;
    p.config.defines       = nil;
    p.config.define_count  = 0;
    p.config.cascade_libs      = nil;
    p.config.cascade_lib_count = 0;
    p.config.art_reqs      = nil;
    p.config.art_req_count = 0;
    p.modules       = nil;
    p.module_len    = 0;
    p.module_cap    = 0;
    p.by_fqn        = map.init[intern.StrId, session.ModuleId](p.alloc, map.hash_u32, map.eq_u32);
    p.load_status   = nil;
    p.load_cap      = 0;
    p.topo          = nil;
    p.topo_len      = 0;
    p.topo_cap      = 0;
    p.lower_visit_gen   = nil;
    p.lower_visit_cap   = 0;
    p.lower_visit_epoch = 0;
    p.emit_len      = 0;
    p.roots         = ROOT_ARTIFACT;
    p.events        = nil;
    p.loading_orphans    = false;
    p.union_tuple_filter = nil;
    p.gate_tuple_index   = 0xFFFFFFFF;
    p.in_gated_decl_walk = false;
    p.gate_terminal      = false;
}

fun deallocate_config(c: *ProjectConfig, alloc: *A.Allocator) {
    if (c.targets != nil && c.target_count > 0) {
        var i: u32 = 0;
        for (i < c.target_count) {
            val te: *TargetEntry = ?c.targets[i];
            if (te.libs != nil && te.lib_count > 0) {
                manifest.free_link_claims(alloc, te.libs, te.lib_count);
                A.deallocate[manifest.LinkRequirement](alloc, te.libs, te.lib_count::usize);
            }
            i = i + 1;
        }
        A.deallocate[TargetEntry](alloc, c.targets, c.target_count::usize);
    }
    if (c.deps != nil && c.dep_count > 0) {
        free_dep_entries(alloc, c.deps, c.dep_count, c.dep_count::usize);
    }
    if (c.defines != nil && c.define_count > 0) {
        A.deallocate[intern.StrId](alloc, c.defines, c.define_count::usize);
    }
    if (c.cascade_libs != nil && c.cascade_lib_count > 0) {
        manifest.free_link_claims(alloc, c.cascade_libs, c.cascade_lib_count);
        A.deallocate[manifest.LinkRequirement](alloc, c.cascade_libs, c.cascade_lib_count::usize);
    }
    if (c.steps != nil && c.step_count > 0) {
        var si: u32 = 0;
        for (si < c.step_count) {
            val s: *manifest.StepDef = ?c.steps[si];
            if (s.argv != nil && s.argv_count > 0) {
                A.deallocate[intern.StrId](alloc, s.argv, s.argv_count::usize);
            }
            if (s.env_keys != nil && s.env_count > 0) {
                A.deallocate[intern.StrId](alloc, s.env_keys, s.env_count::usize);
            }
            if (s.env_values != nil && s.env_count > 0) {
                A.deallocate[intern.StrId](alloc, s.env_values, s.env_count::usize);
            }
            if (s.in != nil && s.in_count > 0) {
                A.deallocate[intern.StrId](alloc, s.in, s.in_count::usize);
            }
            if (s.out != nil && s.out_count > 0) {
                A.deallocate[intern.StrId](alloc, s.out, s.out_count::usize);
            }
            if (s.need != nil && s.need_count > 0) {
                A.deallocate[intern.StrId](alloc, s.need, s.need_count::usize);
            }
            si = si + 1;
        }
        A.deallocate[manifest.StepDef](alloc, c.steps, c.step_count::usize);
    }
    if (c.step_order != nil && c.step_order_count > 0) {
        A.deallocate[u32](alloc, c.step_order, c.step_order_count::usize);
    }
    if (c.art_reqs != nil && c.art_req_count > 0) {
        var ri: u32 = 0;
        for (ri < c.art_req_count) {
            if (!str_empty(c.art_reqs[ri].out)) { str_free(alloc, c.art_reqs[ri].out); }
            ri = ri + 1;
        }
        A.deallocate[manifest.ArtifactReq](alloc, c.art_reqs, c.art_req_count::usize);
    }
    c.art_reqs      = nil;
    c.art_req_count = 0;
    c.targets      = nil;
    c.target_count = 0;
    c.deps         = nil;
    c.dep_count    = 0;
    c.defines       = nil;
    c.define_count  = 0;
    c.cascade_libs      = nil;
    c.cascade_lib_count = 0;
    c.steps = nil;
    c.step_count = 0;
    c.step_order = nil;
    c.step_order_count = 0;
}

pub fun free_dep_entries(alloc: *A.Allocator, deps: *DepEntry, count: u32, capacity: usize) {
    if (deps == nil) { ret; }
    var i: u32 = 0;
    for (i < count) {
        if (deps[i].direct != nil && deps[i].direct_count > 0) {
            A.deallocate[intern.StrId](alloc, deps[i].direct, deps[i].direct_count::usize);
        }
        manifest.dnit(?deps[i].manifest, alloc);
        i = i + 1;
    }
    A.deallocate[DepEntry](alloc, deps, capacity);
}

pub fun map_opt(o: manifest.MOpt) TargetOpt {
    if (o == manifest.MOPT_RELEASE) { ret TARGET_OPT_RELEASE; }
    if (o == manifest.MOPT_DEBUG)   { ret TARGET_OPT_DEBUG; }
    ret TARGET_OPT_DEFAULT;
}

pub fun intern_unwrap(itn: *intern.Interner, text: str) intern.StrId {
    val res: R.Result[intern.StrId, str] = intern.intern(itn, text);
    ret R.unwrap_ok[intern.StrId, str](res);
}

pub fun intern_opt_unwrap(itn: *intern.Interner, text: str) intern.StrId {
    if (str_empty(text)) { ret intern.STR_NIL; }
    ret intern_unwrap(itn, text);
}

pub fun fqn_name(p: *Project, fqn: intern.StrId) str {
    val o: O.Option[str] = intern.lookup(?p.s.interner, fqn);
    if (O.is_some[str](o)) { ret O.unwrap[str](o); }
    ret "<?>";
}

pub fun module_by_fqn(p: *Project, fqn: intern.StrId) O.Option[*ModuleEntry] {
    val r: R.Result[*session.ModuleId, str] = map.get[intern.StrId, session.ModuleId](?p.by_fqn, ?fqn);
    if (R.is_err[*session.ModuleId, str](r)) { ret O.none[*ModuleEntry](); }
    val mid: session.ModuleId = @R.unwrap_ok[*session.ModuleId, str](r);
    if (mid::u32 >= p.module_len) { ret O.none[*ModuleEntry](); }
    ret O.some[*ModuleEntry](?p.modules[mid::u32]);
}
