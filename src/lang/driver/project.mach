}

# an entry this unit build restored or published, which eviction keeps
pub rec CacheKey {
    bytes: [32]u8;
}

pub rec RawLowerCapture {
    key: u64;
    output: query.QueryOutput;
    available: *body.Available;
}

pub rec Project {
    s:            *session.Session;
    alloc:        *A.Allocator;
    req:          request.BuildRequest;
    queries:      query.QueryRuntime[Project];
    raw_lower_capture: *RawLowerCapture;
    diags:        diagnostic.DiagnosticStore;
    config:       ProjectConfig;
    target_entry: *TargetEntry;
    target:       target.Target;

    union:              bool;
    union_tuples:       *TargetTuple;
    union_tuple_count:  u32;
    union_tuple_cap:    u32;

    union_entries:      *intern.StrId;
    union_entry_count:  u32;

    compiler_name:  intern.StrId;
    compiler_ver:   intern.StrId;
    step_digest:    [32]u8;
    cache_snapshot: [32]u8;
    cache_ready:    bool;
    cache_initialized: bool;
    cache_operation_sequence: u64;
    compiler_identity: compiler.Identity;
    compiler_identity_initialized: bool;
    compiler_identity_available: bool;
    cache_hits:     u32;
    cache_misses:   u32;
    cache_dir:      str;
    cache_keys:     vector.Vector[CacheKey];

    modules:      *ModuleEntry;
    module_len:   u32;
    module_cap:   u32;
    by_fqn:       map.Map[intern.StrId, session.ModuleId];

    load_status:  *LoadStatus;
    load_cap:     u32;

    topo:         *session.ModuleId;
    topo_len:     u32;
    topo_cap:     u32;

    lower_visit_gen:   *u32;
    lower_visit_cap:   u32;
    lower_visit_epoch: u32;

    emit_len:     u32;

    roots:        RootSet;

    events:       *readout.Progress;

    loading_orphans:    bool;
    union_tuple_filter: *bool;
    gate_tuple_index:   u32;
    in_gated_decl_walk: bool;
    gate_terminal:      bool;
}

pub fun begin_query_phase(p: *Project) res[query.Operation, outcome.Fail] {
    val reset: err[fail.Fail] = session.reset_type_projection(p.s);
    if (sel reset.err) {
        ret res[query.Operation, outcome.Fail].err{outcome.from_fail(reset.err)};
    }
    val begun: res[query.Operation, fail.Fail] = query.begin(?p.s.queries);
    if (sel begun.err) {
        ret res[query.Operation, outcome.Fail].err{outcome.from_fail(begun.err)};
    }
    release_cache_operation(p);
    p.cache_operation_sequence = begun.ok.sequence;
    var i: usize = 0;
    for (i < 32) { p.cache_snapshot[i] = 0; i = i + 1; }
    ret res[query.Operation, outcome.Fail].ok{begun.ok};
}

pub fun refresh_diagnostics(p: *Project) err[outcome.Fail] {
    var staged: diagnostic.DiagnosticStore = diagnostic.store_init(p.s.alloc);
    var copied: err[fail.Fail] = diagnostic.replay_into(?staged, ?p.diags);
    val copied_ok: bool = sel copied.ok && p.s.query_presentation != nil;
    if (copied_ok) {
        copied = diagnostic.replay_into(?staged, ?p.s.query_presentation.diags);
    }
    if (sel copied.err) {
        diagnostic.store_dnit(?staged);
        ret err[outcome.Fail].err{outcome.from_fail(copied.err)};
    }
    diagnostic.store_dnit(?p.s.diags);
    p.s.diags = staged;
    ret err[outcome.Fail].ok{};
}

pub fun finish_query_phase(p: *Project, operation: query.Operation,
                          roots: *query.QueryKey, count: usize,
                          result: err[outcome.Fail]) err[outcome.Fail] {
    val db: *query.QueryDb = ?p.s.queries;
    val ended: err[fail.Fail] = query.end(db, operation);
    if (!db.operation_active && operation.owner == db::ptr && operation.sequence == p.cache_operation_sequence) {
        release_cache_operation(p);
    }
    var final_result: err[outcome.Fail] = result;
    var operation_failure: bool = false;
    var message: str = nil;
    var lost: bool = false;
    if (sel ended.err) {
        val failure: outcome.Fail = outcome.from_fail(ended.err);
        var displaces: bool = sel result.ok;
        if (sel result.err) {
            if (sel failure.internal && !outcome.is_internal(result.err)) { displaces = true; }
        }
        if (displaces) {
            final_result = err[outcome.Fail].err{failure};
            operation_failure = true;
        }
    }
    if (!operation_failure) {
        if (sel result.err) {
            var failure: outcome.Fail = result.err;
            val carried: opt[str] = outcome.text(failure);
            if (sel carried.some) {
                val copied: res[str, A.Error] = str_dup(db.a, carried.some);
                if (sel copied.err) {
                    failure = outcome.with_text(failure, alloc.text(copied.err));
                    lost = true;
                }
                if (sel copied.ok) {
                    message = copied.ok;
                    failure = outcome.with_text(failure, message);
                }
                final_result = err[outcome.Fail].err{failure};
            }
        }
    }

    val collected: res[*query.Presentation, fail.Fail] = query.collect(db, operation, roots, count, p.s.alloc);
    if (sel collected.err) {
        val taken: res[str, fail.Fail] = query.take_failure_message(db, operation);
        if (sel taken.ok) {
            if (taken.ok != nil) {
                if (operation_failure) { message = taken.ok; }
                or { str_free(db.a, taken.ok); }
            }
        }
        if (sel taken.err) { lost = true; }
        val discarded: err[fail.Fail] = query.discard(db, operation);
        if (sel discarded.err) { lost = true; }
        val no_result: bool = sel final_result.ok;
        if (no_result) {
            final_result = err[outcome.Fail].err{outcome.from_fail(collected.err)};
        }
        lost = true;
    }
    if (sel collected.ok) {
        val presentation: *query.Presentation = collected.ok;
        if (p.s.query_presentation != nil) { query.presentation_dnit(p.s.query_presentation); }
        p.s.query_presentation = presentation;
        val refreshed: err[outcome.Fail] = refresh_diagnostics(p);
        if (sel refreshed.err) {
            val final_result_ok: bool = sel final_result.ok;
            if (final_result_ok) { final_result = refreshed; }
            lost = true;
        }
    }
    if (p.s.query_failure_message != nil) { str_free(db.a, p.s.query_failure_message); }
    p.s.query_failure_message = message;
    if (lost) {
        diagnostic.note_lost(?p.diags);
        diagnostic.note_lost(?p.s.diags);
    }
    if (sel ended.err) {
        var i: u32 = 0;
        for (i < p.module_len) {
            val m: *ModuleEntry = ?p.modules[i];
            m.a = nil;
            m.resolve_result = nil;
            m.sema_result = nil;
            m.ir_module = nil;
            m.object_image = nil;
            i = i + 1;
        }
        i = 0;
        for (i < p.s.module_ast_count) { p.s.module_asts[i] = nil; i = i + 1; }
        map.clear[session.ModuleId, ptr](?p.s.module_resolve);
        map.clear[session.ModuleId, ptr](?p.s.module_sema);
        map.clear[session.ModuleId, ptr](?p.s.module_comptime);
    }
    ret final_result;
}

pub fun span_eq_str(source: str, span: token.Span, s: str) bool {
    val n: usize = str_len(s);
    if (span.len != n) { ret false; }
    var i: usize = 0;
    for (i < n) {
        if (source[span.offset + i] != s[i]::u8) { ret false; }
        i = i + 1;
    }
    ret true;
}

pub fun link_name_for(p: *Project, bare: intern.StrId) res[intern.StrId, fail.Fail] {
    if (p.target.os == nil) {
        ret res[intern.StrId, fail.Fail].err{fail.message("internal: link name needs a resolved target")};
    }
    val prefix: str = p.target.os.c_symbol_prefix;
    if (str_len(prefix) == 0) { ret res[intern.StrId, fail.Fail].ok{bare}; }

    val bare_opt: opt[str] = intern.lookup(?p.s.interner, bare);
    if (sel bare_opt.none) {
        ret res[intern.StrId, fail.Fail].err{fail.message("internal: link name source is not interned")};
    }
    val joined_r: res[str, string.StrError] = str_join(p.s.build_alloc, prefix, bare_opt.some);
    if (sel joined_r.err) {
        ret res[intern.StrId, fail.Fail].err{fail.str_refused(joined_r.err)};
    }
    val joined: str = joined_r.ok;
    val id_r: res[intern.StrId, A.Error] = intern.intern(?p.s.interner, joined);
    str_free(p.s.build_alloc, joined);
    if (sel id_r.err) { ret res[intern.StrId, fail.Fail].err{fail.refused(id_r.err)}; }
    ret res[intern.StrId, fail.Fail].ok{id_r.ok};
}

# staged images are project-owned until a query takes them, object_image is borrowed
pub fun release_staged(p: *Project, m: *ModuleEntry) {
    if (m.staged_image != nil) {
        of.object_image_dnit(m.staged_image);
        A.deallocate[of.ObjectImage](p.s.alloc, m.staged_image, 1);
        m.staged_image = nil;
    }
    codec.facts_dnit(p.s.alloc, ?m.staged_facts);
    m.cache_checked = false;
    m.cache_hit = false;
}

pub fun release_all_staged(p: *Project) {
    var i: u32 = 0;
    for (i < p.module_len) { release_staged(p, ?p.modules[i]); i = i + 1; }
}

# a restored product stays staged across operations: it is keyed by the cell
# snapshot it was read under and the next preparation discards it if that
# changed. a freshly generated image staged by a codegen worker belongs to the
# operation that generated it and leaves with it
fun release_cache_operation(p: *Project) {
    str_free(p.alloc, p.cache_dir);
    p.cache_dir = nil;
    p.cache_ready = false;
    p.cache_initialized = false;
    p.cache_operation_sequence = 0;
    var i: u32 = 0;
    for (i < p.module_len) {
        val m: *ModuleEntry = ?p.modules[i];
        if (m.staged_image != nil && !m.cache_hit) { release_staged(p, m); }
        i = i + 1;
    }
}

pub fun dnit_project(p: *Project) {
    if (p == nil) { ret; }
    release_cache_operation(p);
    release_all_staged(p);
    vector.dnit[CacheKey](?p.cache_keys);
    var i: u32 = 0;
    for (i < p.module_len) {
        val m: *ModuleEntry = ?p.modules[i];
        comptime.dnit(?m.ctx);
        if (m.pub_consts != nil && m.pub_const_cap > 0) {
            A.deallocate[PubConst](p.alloc, m.pub_consts, m.pub_const_cap::usize);
        }
        if (m.mod_refs != nil && m.mod_ref_cap > 0) {
            A.deallocate[ModRef](p.alloc, m.mod_refs, m.mod_ref_cap::usize);
        }
        if (m.const_imports != nil && m.const_import_cap > 0) {
            A.deallocate[ModRef](p.alloc, m.const_imports, m.const_import_cap::usize);
        }
        if (m.deps != nil && m.dep_cap > 0) {
            A.deallocate[session.ModuleId](p.alloc, m.deps, m.dep_cap::usize);
        }
        if (m.gate_result != nil) {
            sema.dnit_result(m.gate_result);
            A.deallocate[sema.SemaResult](p.alloc, m.gate_result, 1::usize);
        }
        if (m.tuple_gates != nil) {
            var ti: u32 = 0;
            for (ti < m.tuple_gate_count) {
                val tg: *TupleGateResult = ?m.tuple_gates[ti];
                if (tg.states != nil && tg.state_count > 0) {
                    A.deallocate[comptime.GateState](p.alloc, tg.states, tg.state_count::usize);
                }
                if (tg.entries != nil && tg.entries_cap > 0) {
                    A.deallocate[comptime.NamedConst](p.alloc, tg.entries, tg.entries_cap::usize);
                }
                if (tg.deferred != nil && tg.deferred_cap > 0) {
                    A.deallocate[intern.StrId](p.alloc, tg.deferred, tg.deferred_cap::usize);
                }
                if (tg.resolve_result != nil) {
                    resolve.dnit_result(tg.resolve_result);
                    A.deallocate[resolve.ResolveResult](p.alloc, tg.resolve_result, 1::usize);
                }
                if (tg.sema_result != nil) {
                    sema.dnit_result(tg.sema_result);
                    A.deallocate[sema.SemaResult](p.alloc, tg.sema_result, 1::usize);
                }
                ti = ti + 1;
            }
            A.deallocate[TupleGateResult](p.alloc, m.tuple_gates, m.tuple_gate_count::usize);
        }
        if (m.tuple_reachable != nil && m.tuple_reach_count > 0) {
            A.deallocate[bool](p.alloc, m.tuple_reachable, m.tuple_reach_count::usize);
        }
        i = i + 1;
    }
    if (p.modules != nil && p.module_cap > 0) {
        A.deallocate[ModuleEntry](p.alloc, p.modules, p.module_cap::usize);
    }
    if (p.load_status != nil && p.load_cap > 0) {
        A.deallocate[LoadStatus](p.alloc, p.load_status, p.load_cap::usize);
    }
    if (p.topo != nil && p.topo_cap > 0) {
        A.deallocate[session.ModuleId](p.alloc, p.topo, p.topo_cap::usize);
    }
    if (p.lower_visit_gen != nil && p.lower_visit_cap > 0) {
        A.deallocate[u32](p.alloc, p.lower_visit_gen, p.lower_visit_cap::usize);
    }
    if (p.union_tuples != nil && p.union_tuple_cap > 0) {
        A.deallocate[TargetTuple](p.alloc, p.union_tuples, p.union_tuple_cap::usize);
    }
    if (p.union_entries != nil && p.union_entry_count > 0) {
        A.deallocate[intern.StrId](p.alloc, p.union_entries, p.union_entry_count::usize);
    }
    map.dnit[intern.StrId, session.ModuleId](?p.by_fqn);
    diagnostic.store_dnit(?p.diags);
    deallocate_config(?p.config, p.alloc);

    session.reset_module_registry(p.s);
}

pub fun init_project(p: *Project, s: *session.Session) {
    if (s.query_presentation != nil) { query.presentation_dnit(s.query_presentation); s.query_presentation = nil; }
    if (s.query_failure_message != nil) { str_free(s.queries.a, s.query_failure_message); s.query_failure_message = nil; }
    diagnostic.store_dnit(?s.diags);
    s.diags = diagnostic.store_init(s.alloc);
    p.s             = s;
    p.alloc         = s.build_alloc;
    p.req           = request.defaults();
    p.raw_lower_capture = nil;
    p.queries.db    = nil;
    p.queries.caps.compute = nil;
    p.diags         = diagnostic.store_init(p.alloc);
    p.target_entry  = nil;
    p.union              = false;
    p.union_tuples       = nil;
    p.union_tuple_count  = 0;
    p.union_tuple_cap    = 0;
    p.union_entries      = nil;
    p.union_entry_count  = 0;
    p.target.os_id   = os.OS_UNKNOWN;
    p.target.arch_id = isa.ARCH_UNKNOWN;
    p.target.abi_id  = 0;
    p.target.os      = nil;
    p.target.arch    = nil;
    p.target.abi     = nil;
    p.target.of      = nil;
    p.compiler_name = intern.STR_NIL;
    p.compiler_ver  = intern.STR_NIL;
    var cache_byte: usize = 0;
    for (cache_byte < 32) {
        p.step_digest[cache_byte] = 0;
        p.cache_snapshot[cache_byte] = 0;
        cache_byte = cache_byte + 1;
    }
    compiler.identity_clear(?p.compiler_identity);
    p.cache_ready = false;
    p.cache_initialized = false;
    p.cache_operation_sequence = 0;
    p.compiler_identity_initialized = false;
    p.compiler_identity_available = false;
    p.cache_hits = 0;
    p.cache_misses = 0;
    p.cache_dir = nil;
    p.cache_keys = vector.init[CacheKey](s.alloc);
    p.config.id           = intern.STR_NIL;
    p.config.version      = intern.STR_NIL;
    p.config.bin_name     = intern.STR_NIL;
    p.config.icon         = intern.STR_NIL;
    p.config.app_manifest = intern.STR_NIL;
    p.config.module       = intern.STR_NIL;
    p.config.targets      = nil;
    p.config.target_count = 0;
    p.config.deps         = nil;
    p.config.dep_count    = 0;
    p.config.defines       = nil;
    p.config.define_count  = 0;
    p.config.cascade_libs      = nil;
    p.config.cascade_lib_count = 0;
    p.config.art_reqs      = nil;
    p.config.art_req_count = 0;
    p.modules       = nil;
    p.module_len    = 0;
    p.module_cap    = 0;
    p.by_fqn        = map.init[intern.StrId, session.ModuleId](p.alloc, map.hash_u32, map.eq_u32);
    p.load_status   = nil;
    p.load_cap      = 0;
    p.topo          = nil;
    p.topo_len      = 0;
    p.topo_cap      = 0;
    p.lower_visit_gen   = nil;
    p.lower_visit_cap   = 0;
    p.lower_visit_epoch = 0;
    p.emit_len      = 0;
    p.roots         = ROOT_ARTIFACT;
    p.events        = nil;
    p.loading_orphans    = false;
    p.union_tuple_filter = nil;
    p.gate_tuple_index   = 0xFFFFFFFF;
    p.in_gated_decl_walk = false;
    p.gate_terminal      = false;
}

fun deallocate_config(c: *ProjectConfig, alloc: *A.Allocator) {
    if (c.targets != nil && c.target_count > 0) {
        var i: u32 = 0;
        for (i < c.target_count) {
            val te: *TargetEntry = ?c.targets[i];
            if (te.libs != nil && te.lib_count > 0) {
                manifest.free_link_claims(alloc, te.libs, te.lib_count);
                A.deallocate[manifest.LinkRequirement](alloc, te.libs, te.lib_count::usize);
            }
            i = i + 1;
        }
        A.deallocate[TargetEntry](alloc, c.targets, c.target_count::usize);
    }
    if (c.deps != nil && c.dep_count > 0) {
        free_dep_entries(alloc, c.deps, c.dep_count, c.dep_count::usize);
    }
    if (c.defines != nil && c.define_count > 0) {
        A.deallocate[intern.StrId](alloc, c.defines, c.define_count::usize);
    }
    if (c.cascade_libs != nil && c.cascade_lib_count > 0) {
        manifest.free_link_claims(alloc, c.cascade_libs, c.cascade_lib_count);
        A.deallocate[manifest.LinkRequirement](alloc, c.cascade_libs, c.cascade_lib_count::usize);
    }
    if (c.steps != nil && c.step_count > 0) {
        var si: u32 = 0;
        for (si < c.step_count) {
            val s: *manifest.StepDef = ?c.steps[si];
            if (s.argv != nil && s.argv_count > 0) {
                A.deallocate[intern.StrId](alloc, s.argv, s.argv_count::usize);
            }
            if (s.env_keys != nil && s.env_count > 0) {
                A.deallocate[intern.StrId](alloc, s.env_keys, s.env_count::usize);
            }
            if (s.env_values != nil && s.env_count > 0) {
                A.deallocate[intern.StrId](alloc, s.env_values, s.env_count::usize);
            }
            if (s.in != nil && s.in_count > 0) {
                A.deallocate[intern.StrId](alloc, s.in, s.in_count::usize);
            }
            if (s.out != nil && s.out_count > 0) {
                A.deallocate[intern.StrId](alloc, s.out, s.out_count::usize);
            }
            if (s.need != nil && s.need_count > 0) {
                A.deallocate[intern.StrId](alloc, s.need, s.need_count::usize);
            }
            si = si + 1;
        }
        A.deallocate[manifest.StepDef](alloc, c.steps, c.step_count::usize);
    }
    if (c.step_order != nil && c.step_order_count > 0) {
        A.deallocate[u32](alloc, c.step_order, c.step_order_count::usize);
    }
    if (c.art_reqs != nil && c.art_req_count > 0) {
        var ri: u32 = 0;
        for (ri < c.art_req_count) {
            if (!str_empty(c.art_reqs[ri].out)) { str_free(alloc, c.art_reqs[ri].out); }
            ri = ri + 1;
        }
        A.deallocate[manifest.ArtifactReq](alloc, c.art_reqs, c.art_req_count::usize);
    }
    c.art_reqs      = nil;
    c.art_req_count = 0;
    c.targets      = nil;
    c.target_count = 0;
    c.deps         = nil;
    c.dep_count    = 0;
    c.defines       = nil;
    c.define_count  = 0;
    c.cascade_libs      = nil;
    c.cascade_lib_count = 0;
    c.steps = nil;
    c.step_count = 0;
    c.step_order = nil;
    c.step_order_count = 0;
}

pub fun free_dep_entries(alloc: *A.Allocator, deps: *DepEntry, count: u32, capacity: usize) {
    if (deps == nil) { ret; }
    var i: u32 = 0;
    for (i < count) {
        if (deps[i].direct != nil && deps[i].direct_count > 0) {
            A.deallocate[intern.StrId](alloc, deps[i].direct, deps[i].direct_count::usize);
        }
        manifest.dnit(?deps[i].manifest, alloc);
        i = i + 1;
    }
    A.deallocate[DepEntry](alloc, deps, capacity);
}

pub fun map_opt(o: manifest.MOpt) TargetOpt {
    if (o == manifest.MOPT_RELEASE) { ret TARGET_OPT_RELEASE; }
    if (o == manifest.MOPT_DEBUG)   { ret TARGET_OPT_DEBUG; }
    ret TARGET_OPT_DEFAULT;
}

pub fun intern_unwrap(itn: *intern.Interner, text: str) intern.StrId {
    val interned: res[intern.StrId, A.Error] = intern.intern(itn, text);
    if (sel interned.ok) { ret interned.ok; }
    ret intern.STR_NIL;
}

pub fun intern_opt_unwrap(itn: *intern.Interner, text: str) intern.StrId {
    if (str_empty(text)) { ret intern.STR_NIL; }
    ret intern_unwrap(itn, text);
}

pub fun fqn_name(p: *Project, fqn: intern.StrId) str {
    val o: opt[str] = intern.lookup(?p.s.interner, fqn);
    if (sel o.some) { ret o.some; }
    ret "<?>";
}

pub fun module_by_fqn(p: *Project, fqn: intern.StrId) opt[*ModuleEntry] {
    val r: opt[*session.ModuleId] = map.get[intern.StrId, session.ModuleId](?p.by_fqn, ?fqn);
    if (sel r.none) { ret opt[*ModuleEntry].none{}; }
    val mid: session.ModuleId = @r.some;
    if (mid::u32 >= p.module_len) { ret opt[*ModuleEntry].none{}; }
    ret opt[*ModuleEntry].some{?p.modules[mid::u32]};
}
