use std.collections.vector;
use std.collections.vector.Vector;
use std.text.string.str_free;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;

use mach.lang.build.outcome;
use mach.lang.manifest;
use range: mach.lang.manifest.version;

# where dependency resolution reads the releases of an identity (#3496, #3500). the git
# source reads `v`-prefixed semver tags and the manifest at each; a registry would
# implement the same two operations

# one release: its version (whose pre-release text borrows from `text`), the tag that
# names it and the commit it points at, all owned by the list's allocator
pub rec Release {
    version: range.Version;
    text:    str;
    tag:     str;
    commit:  str;
}

# every release reachable at `url`, appended to `out` in no particular order
pub def ReleasesFn: fun(ptr, str, *Vector[Release]) err[outcome.Fail];

# the manifest a release ships; err when it cannot be read or its [project].version
# disagrees with the release
pub def ManifestAtFn: fun(ptr, str, *Release) res[manifest.Manifest, outcome.Fail];

pub rec CandidateSource {
    ctx:         ptr;
    releases:    ReleasesFn;
    manifest_at: ManifestAtFn;
}

pub fun release_free(a: *A.Allocator, r: *Release) {
    str_free(a, r.text);
    str_free(a, r.tag);
    str_free(a, r.commit);
}

pub fun releases_free(a: *A.Allocator, list: *Vector[Release]) {
    var i: usize = 0;
    for (i < list.len) {
        release_free(a, ?list.data[i]);
        i = i + 1;
    }
    vector.dnit[Release](list);
}
