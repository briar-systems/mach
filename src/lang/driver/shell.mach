# host command resolution and `[step]` shell selection
#
# `exec.run` spawns through execve / CreateProcess and neither searches PATH,
# so a bare command name never launches - CreateProcess in particular completes
# a partial `lpApplicationName` against the current directory only. Every spawn
# site therefore has to turn a name into a concrete path first, and this module
# owns the single copy of that search plus the host's step-shell choice.

use A: std.allocator;
use O: std.types.option;
use R: std.types.result;

use std.allocator.page;
use fs: std.filesystem;
use std.process.env;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_copy;
use std.types.string.str_len;
use std.types.path;
use std.types.path.Path;

# the shell a step's `cmd` runs under: a concrete executable path and the flag
# that introduces the command string
#
# `cmd` is always owned by the caller's allocator, on every host, so releasing
# it never depends on which branch produced it.
pub rec Shell {
    cmd:  str;
    flag: *u8;
}

# resolve a bare command name against PATH, or return a pathed name verbatim
#
# a name containing a separator is returned as-is; a bare name is joined onto
# each PATH segment and the first existing file wins. only the returned
# candidate stays allocated; misses are freed.
# ---
# a:    allocator for the returned candidate path
# name: command name or path
# ret:  an executable path, or an error message
pub fun resolve_cmd(a: *A.Allocator, name: str) R.Result[str, str] {
    # a name that already spells a path is returned verbatim; only bare names
    # are searched on PATH.
    if (path.has_separator(name)) { ret R.ok[str, str](name); }

    var list_sep: u8 = ':';
    $if ($mach.build.os == $mach.os.windows) {
        list_sep = ';';
    }

    val paths_r: R.Result[str, str] = env.value(a, "PATH");
    if (R.is_err[str, str](paths_r)) { ret R.err[str, str]("PATH unset"); }
    val paths: str = R.unwrap_ok[str, str](paths_r);
    val plen: usize = str_len(paths);

    # the PATH value is owned, so each segment is terminated in place and
    # handed to path.join as an ordinary string
    var i: usize = 0;
    for (i < plen) {
        val start: usize = i;
        for (i < plen && paths[i] != list_sep) { i = i + 1; }
        paths[i] = 0;
        i = i + 1;
        if (i - 1 == start) { cnt; }

        val cand_r: R.Result[Path, str] = path.join(a, ?paths[start], name::str);
        if (R.is_err[Path, str](cand_r)) { ret R.err[str, str](R.unwrap_err[Path, str](cand_r)); }
        val cand: Path = R.unwrap_ok[Path, str](cand_r);

        if (fs.is_file(cand)) { ret R.ok[str, str](cand); }
        A.deallocate[u8](a, cand, str_len(cand) + 1);
    }

    ret R.err[str, str]("not found on PATH");
}

# resolve the shell a build step runs under on this host
#
# posix hosts use `/bin/sh -c`; windows hosts use `cmd.exe /c`, whose bare name
# must be found on PATH before it can be spawned (#2578). the returned `cmd` is
# always freshly allocated, so the caller frees it unconditionally.
# ---
# a:   allocator for the returned shell path
# ret: the host shell, or an error message
pub fun resolve_shell(a: *A.Allocator) R.Result[Shell, str] {
    var name: str = "/bin/sh";
    var sh: Shell;
    sh.cmd  = nil;
    sh.flag = "-c";
    $if ($mach.build.os == $mach.os.windows) {
        name = "cmd.exe";
        sh.flag = "/c";
    }

    val rr: R.Result[str, str] = resolve_cmd(a, name);
    if (R.is_err[str, str](rr)) { ret R.err[Shell, str](R.unwrap_err[str, str](rr)); }
    val found: str = R.unwrap_ok[str, str](rr);

    # resolve_cmd hands a pathed name straight back, so copy unconditionally to
    # give every host the same ownership contract, then release any candidate it
    # did allocate.
    val cr: R.Result[str, str] = str_copy(a, found);
    if (found::usize != name::usize) { A.deallocate[u8](a, found, str_len(found) + 1); }
    if (R.is_err[str, str](cr)) { ret R.err[Shell, str](R.unwrap_err[str, str](cr)); }
    sh.cmd = R.unwrap_ok[str, str](cr);
    ret R.ok[Shell, str](sh);
}

# release the shell path resolve_shell allocated
# ---
# a:  the allocator resolve_shell was given
# sh: the shell to release
pub fun free_shell(a: *A.Allocator, sh: *Shell) {
    if (sh == nil || sh.cmd == nil) { ret; }
    A.deallocate[u8](a, sh.cmd, str_len(sh.cmd) + 1);
    sh.cmd = nil;
}

# a name that already spells a path is returned verbatim without any
# filesystem probe
test "mach.lang.driver.shell.resolve_cmd:pathed_name_verbatim" {
    var backing: A.Allocator;
    if (O.is_some[str](page.make(?backing))) { ret 1; }

    val name: *u8 = "./definitely/not/a/real-cmd";
    val r: R.Result[*u8, str] = resolve_cmd(?backing, name);
    if (R.is_err[*u8, str](r))                         { ret 1; }
    if (R.unwrap_ok[*u8, str](r)::usize != name::usize) { ret 1; }
    ret 0;
}

# the host shell is a concrete, spawnable path - never a bare name, which
# neither execve nor CreateProcess would find (#2578) - and it is owned by the
# caller's allocator on every host
test "mach.lang.driver.shell.resolve_shell:concrete_spawnable_path" {
    var backing: A.Allocator;
    if (O.is_some[str](page.make(?backing))) { ret 1; }

    val r: R.Result[Shell, str] = resolve_shell(?backing);
    if (R.is_err[Shell, str](r)) { ret 1; }
    var sh: Shell = R.unwrap_ok[Shell, str](r);

    var bad: u8 = 0;
    if (!path.has_separator(sh.cmd)) { bad = 1; }
    or (!fs.is_file(sh.cmd))         { bad = 1; }
    or (sh.flag == nil)              { bad = 1; }

    free_shell(?backing, ?sh);
    if (sh.cmd != nil) { bad = 1; }
    ret bad::i32;
}
