#[testing]
pub fun resolve_artifact_path(alloc: *A.Allocator, reg: *lang_target.TargetRegistry, project_root: str, selectors: *manifest.Selectors) res[str, fail.Fail] {
    val mp_r: res[str, fail.Fail] = driver_load.join_path(alloc, project_root, manifest.MANIFEST_FILE);
    if (sel mp_r.err) { ret res[str, fail.Fail].err{mp_r.err}; }
    val manifest_path: str = mp_r.ok;

    val doc_r: res[manifest.Doc, fail.Fail] = manifest.doc_read(alloc, manifest_path);
    if (sel doc_r.err) { ret res[str, fail.Fail].err{doc_r.err}; }
    var doc: manifest.Doc = doc_r.ok;

    var itn: intern.Interner                   = intern.init(alloc);
    val mr:  res[manifest.Manifest, fail.Fail] = manifest.parse(alloc, ?itn, ?doc);
    manifest.doc_dnit(alloc, ?doc);
    if (sel mr.err) { ret res[str, fail.Fail].err{mr.err}; }
    var m: manifest.Manifest = mr.ok;

    val picked: res[manifest.Cell, fail.Fail] = manifest.resolve_cell(alloc, ?itn, ?m, selectors,
        manifest.ARTIFACT_DEFAULT_ONE, "an artifact path names one artifact");
    if (sel picked.err) {
        manifest.dnit(?m, alloc);
        ret res[str, fail.Fail].err{picked.err};
    }
    var cell: manifest.Cell = picked.ok;

    val ur: res[manifest.BuildUnit, fail.Fail] = manifest.resolve_build_unit(alloc, ?itn, reg, ?m, ?cell);
    if (sel ur.err) {
        manifest.dnit(?m, alloc);
        ret res[str, fail.Fail].err{ur.err};
    }
    val bu: manifest.BuildUnit = ur.ok;

    if (intern.str_is_nil(bu.bin_path) || str_empty(intern.text(?itn, bu.bin_path))) {
        manifest.dnit(?m, alloc);
        ret res[str, fail.Fail].err{fail.user(diagnostic_kind.ARTIFACT_NO_OUTPUT, "selected artifact has no output path; set the `out` template in mach.toml")};
    }
    val abs_r: res[str, fail.Fail] = driver_load.join_path(alloc, project_root, intern.text(?itn, bu.bin_path));
    manifest.dnit(?m, alloc);
    if (sel abs_r.err) { ret res[str, fail.Fail].err{abs_r.err}; }
    ret res[str, fail.Fail].ok{abs_r.ok};
}

pub rec RunArtifact {
    path:          str;
    host_runnable: bool;
    target_name:   str;
}

# the built executable `mach run` launches: the one (artifact, target, profile)
# the selectors name, which must be a `bin`
# ---
# alloc:           owns the result and every message
# reg:             the composed target registry the cell's target resolves against
# project_root:    the project root
# selectors:       the `-a`, `-t` and `-p` patterns; an artifact axis given none takes the sole `bin`
# output_override: `-o`, the path to run instead of the artifact's output, or nil
# ret:             the executable; err from the manifest or selection, when the selection
#                  names several cells or a library, or for an unusable `-o`
pub fun resolve_run_artifact(alloc: *A.Allocator, reg: *lang_target.TargetRegistry, project_root: str, selectors: *manifest.Selectors,
    output_override: str) res[RunArtifact, fail.Fail] {
    val mp_r: res[str, fail.Fail] = driver_load.join_path(alloc, project_root, manifest.MANIFEST_FILE);
    if (sel mp_r.err) { ret res[RunArtifact, fail.Fail].err{mp_r.err}; }
    val manifest_path: str = mp_r.ok;

    val doc_r: res[manifest.Doc, fail.Fail] = manifest.doc_read(alloc, manifest_path);
    if (sel doc_r.err) { ret res[RunArtifact, fail.Fail].err{doc_r.err}; }
    var doc: manifest.Doc = doc_r.ok;

    var itn: intern.Interner                   = intern.init(alloc);
    val mr:  res[manifest.Manifest, fail.Fail] = manifest.parse(alloc, ?itn, ?doc);
    manifest.doc_dnit(alloc, ?doc);
    if (sel mr.err) { ret res[RunArtifact, fail.Fail].err{mr.err}; }
    var m: manifest.Manifest = mr.ok;

    val picked: res[manifest.Cell, fail.Fail] = manifest.resolve_cell(alloc, ?itn, ?m, selectors,
        manifest.ARTIFACT_DEFAULT_EXECUTABLE, "mach run executes one artifact");
    if (sel picked.err) {
        manifest.dnit(?m, alloc);
        ret res[RunArtifact, fail.Fail].err{picked.err};
    }
    var cell: manifest.Cell = picked.ok;

    val ur: res[manifest.BuildUnit, fail.Fail] = manifest.resolve_build_unit(alloc, ?itn, reg, ?m, ?cell);
    if (sel ur.err) {
        manifest.dnit(?m, alloc);
        ret res[RunArtifact, fail.Fail].err{ur.err};
    }
    val bu: manifest.BuildUnit = ur.ok;

    if (catalog_artifact.is_library(bu.artifact.kind)) {
        val refusal: fail.Fail = fail.formatted_user(alloc, diagnostic_kind.ARTIFACT_NOT_RUNNABLE,
            "selected artifact '{}' is a library; run executes only bin artifacts", intern.text(?itn, bu.artifact.name));
        manifest.dnit(?m, alloc);
        ret res[RunArtifact, fail.Fail].err{refusal};
    }

    var ra: RunArtifact;
    ra.host_runnable = manifest.target_matches_host(?itn, bu.target, lang_target.host_os_id(), lang_target.host_arch_id());
    ra.target_name   = intern.text(?itn, bu.target.name);

    if (output_override != nil) {
        if (str_empty(output_override)) {
            manifest.dnit(?m, alloc);
            ret res[RunArtifact, fail.Fail].err{fail.user(diagnostic_kind.CLI_OUTPUT_PATH, "-o requires a non-empty path")};
        }
        val resolved_r: res[types_path.Path, A.Error] = types_path.resolve(alloc, project_root, output_override);
        if (sel resolved_r.err) {
            manifest.dnit(?m, alloc);
            ret res[RunArtifact, fail.Fail].err{fail.formatted_user(alloc, diagnostic_kind.CLI_OUTPUT_PATH, "-o '{}': {}", output_override, lang_alloc.text(resolved_r.err))};
        }
        val cleaned_r: res[types_path.Path, A.Error] = types_path.clean(alloc, resolved_r.ok);
        if (sel cleaned_r.err) {
            manifest.dnit(?m, alloc);
            ret res[RunArtifact, fail.Fail].err{fail.formatted_user(alloc, diagnostic_kind.CLI_OUTPUT_PATH, "-o '{}': {}", output_override, lang_alloc.text(cleaned_r.err))};
        }
        ra.path = cleaned_r.ok;
        manifest.dnit(?m, alloc);
        ret res[RunArtifact, fail.Fail].ok{ra};
    }

    if (intern.str_is_nil(bu.bin_path) || str_empty(intern.text(?itn, bu.bin_path))) {
        manifest.dnit(?m, alloc);
        ret res[RunArtifact, fail.Fail].err{fail.user(diagnostic_kind.ARTIFACT_NO_OUTPUT, "selected artifact has no output path; set the `out` template in mach.toml")};
    }
    val abs_r: res[str, fail.Fail] = driver_load.join_path(alloc, project_root, intern.text(?itn, bu.bin_path));
    manifest.dnit(?m, alloc);
    if (sel abs_r.err) { ret res[RunArtifact, fail.Fail].err{abs_r.err}; }
    ra.path = abs_r.ok;
    ret res[RunArtifact, fail.Fail].ok{ra};
}

fun dup_strid_array(alloc: *A.Allocator, src: *intern.StrId, count: u32) res[*intern.StrId, fail.Fail] {
    if (src == nil || count == 0) { ret res[*intern.StrId, fail.Fail].ok{nil}; }
    val r: res[*intern.StrId, A.Error] = A.allocate[intern.StrId](alloc, count::usize);
    if (sel r.err) { ret res[*intern.StrId, fail.Fail].err{fail.refused(r.err)}; }
    val arr: *intern.StrId = r.ok;
    var i:   u32           = 0;
    for (i < count) {
        arr[i] = src[i];
        i      = i + 1;
    }
    ret res[*intern.StrId, fail.Fail].ok{arr};
}

# a copy of the `count` places at `src`, nil for none
fun dup_sites(alloc: *A.Allocator, src: *fail.Place, count: u32) res[*fail.Place, fail.Fail] {
    if (src == nil || count == 0) { ret res[*fail.Place, fail.Fail].ok{nil}; }
    val r: res[*fail.Place, A.Error] = A.allocate[fail.Place](alloc, count::usize);
    if (sel r.err) { ret res[*fail.Place, fail.Fail].err{fail.refused(r.err)}; }
    var i: u32 = 0;
    for (i < count) {
        r.ok[i] = src[i];
        i       = i + 1;
    }
    ret res[*fail.Place, fail.Fail].ok{r.ok};
}

fun clone_step(alloc: *A.Allocator, src: *manifest.StepDef, out: *manifest.StepDef) err[fail.Fail] {
    var d: manifest.StepDef = @src;
    d.argv       = nil;
    d.env_keys   = nil;
    d.env_values = nil;
    d.in         = nil;
    d.out        = nil;
    d.need       = nil;
    d.argv_at    = nil;
    d.env_at     = nil;
    d.in_at      = nil;
    d.out_at     = nil;
    d.need_at    = nil;

    val argv_r: res[*intern.StrId, fail.Fail] = dup_strid_array(alloc, src.argv, src.argv_count);
    if (sel argv_r.err) { ret err[fail.Fail].err{argv_r.err}; }
    d.argv = argv_r.ok;

    val env_keys_r: res[*intern.StrId, fail.Fail] = dup_strid_array(alloc, src.env_keys, src.env_count);
    if (sel env_keys_r.err) {
        manifest.step_dnit(alloc, ?d);
        ret err[fail.Fail].err{env_keys_r.err};
    }
    d.env_keys = env_keys_r.ok;

    val env_values_r: res[*intern.StrId, fail.Fail] = dup_strid_array(alloc, src.env_values, src.env_count);
    if (sel env_values_r.err) {
        manifest.step_dnit(alloc, ?d);
        ret err[fail.Fail].err{env_values_r.err};
    }
    d.env_values = env_values_r.ok;

    val in_r: res[*intern.StrId, fail.Fail] = dup_strid_array(alloc, src.in, src.in_count);
    if (sel in_r.err) {
        manifest.step_dnit(alloc, ?d);
        ret err[fail.Fail].err{in_r.err};
    }
    d.in = in_r.ok;

    val out_r: res[*intern.StrId, fail.Fail] = dup_strid_array(alloc, src.out, src.out_count);
    if (sel out_r.err) {
        manifest.step_dnit(alloc, ?d);
        ret err[fail.Fail].err{out_r.err};
    }
    d.out = out_r.ok;

    val need_r: res[*intern.StrId, fail.Fail] = dup_strid_array(alloc, src.need, src.need_count);
    if (sel need_r.err) {
        manifest.step_dnit(alloc, ?d);
        ret err[fail.Fail].err{need_r.err};
    }
    d.need = need_r.ok;

    val argv_at_r: res[*fail.Place, fail.Fail] = dup_sites(alloc, src.argv_at, src.argv_count);
    if (sel argv_at_r.err) {
        manifest.step_dnit(alloc, ?d);
        ret err[fail.Fail].err{argv_at_r.err};
    }
    d.argv_at = argv_at_r.ok;
    val env_at_r: res[*fail.Place, fail.Fail] = dup_sites(alloc, src.env_at, src.env_count);
    if (sel env_at_r.err) {
        manifest.step_dnit(alloc, ?d);
        ret err[fail.Fail].err{env_at_r.err};
    }
    d.env_at = env_at_r.ok;
    val in_at_r: res[*fail.Place, fail.Fail] = dup_sites(alloc, src.in_at, src.in_count);
    if (sel in_at_r.err) {
        manifest.step_dnit(alloc, ?d);
        ret err[fail.Fail].err{in_at_r.err};
    }
    d.in_at = in_at_r.ok;
    val out_at_r: res[*fail.Place, fail.Fail] = dup_sites(alloc, src.out_at, src.out_count);
    if (sel out_at_r.err) {
        manifest.step_dnit(alloc, ?d);
        ret err[fail.Fail].err{out_at_r.err};
    }
    d.out_at = out_at_r.ok;
    val need_at_r: res[*fail.Place, fail.Fail] = dup_sites(alloc, src.need_at, src.need_count);
    if (sel need_at_r.err) {
        manifest.step_dnit(alloc, ?d);
        ret err[fail.Fail].err{need_at_r.err};
    }
    d.need_at = need_at_r.ok;
    @out      = d;
    ret err[fail.Fail].ok{};
}

# configure a project for one build cell of `m`, or of one of its dependencies
# ---
# p:            the project being configured
# project_root: the root project's directory
# m:            the root manifest
# c:            the cell; with `owner`, a target and artifact of that dependency and
#               a profile of `m`
# owner:        "" for a cell of `m`, or the id of the closure dependency whose export
#               library requires the cell
# for_union:    configure the editor's union of every artifact: every artifact's
#               entry loads, and `{artifact.<id>.out}` resolves over every artifact
#               some artifact needs
# ret:          ok; err from selection, template, step, link or dependency resolution
pub fun load_config_manifest(p: *project.Project, project_root: str, m: *manifest.Manifest, c: *manifest.Cell,
    owner: str, for_union: bool) err[fail.Fail] {
    val toolchain_r: res[*lang_target.TargetRegistry, fail.Fail] = toolchain.registry();
    if (sel toolchain_r.err) { ret err[fail.Fail].err{toolchain_r.err}; }
    val toolchain:  *lang_target.TargetRegistry = toolchain_r.ok;
    val abs_root_r: res[intern.StrId, A.Error]  = intern.add(?p.s.interner, project_root);
    if (sel abs_root_r.err) { ret err[fail.Fail].err{fail.refused(abs_root_r.err)}; }
    p.config.project_root = abs_root_r.ok;
    p.config.home_root    = abs_root_r.ok;
    val res_dep_id: res[intern.StrId, A.Error] = intern.add(?p.s.interner, "dep");
    if (sel res_dep_id.err) { ret err[fail.Fail].err{fail.refused(res_dep_id.err)}; }
    p.config.dir_dep = res_dep_id.ok;

    var scope: manifest.Scope = manifest.root_scope(m);
    if (!str_empty(owner)) {
        val dr: err[fail.Fail] = driver_closure.locate(p, m, project_root, nil);
        if (sel dr.err) { ret err[fail.Fail].err{dr.err}; }
        val sr: err[fail.Fail] = driver_closure.scope_closure_to_dependency(p, owner);
        if (sel sr.err) { ret sr; }
        scope                 = manifest.dependency_scope(m, ?p.config.owner.manifest);
        p.config.project_root = p.config.owner.vendor_root;
    }
    val om: *manifest.Manifest = scope.owner;

    val ur: res[manifest.BuildUnit, fail.Fail] = manifest.resolve_scoped_build_unit(p.alloc, ?p.s.interner, toolchain, ?scope, c);
    if (sel ur.err) {
        ret err[fail.Fail].err{ur.err};
    }
    val bu: manifest.BuildUnit = ur.ok;

    val cell_profile: str = intern.text(?p.s.interner, bu.profile_name);
    p.config.art_reqs      = nil;
    p.config.art_req_count = 0;
    # the union holds every artifact and resolves every artifact's requirements: a
    # module of a non-default artifact is checked against its own artifact's `need`
    val rqr: err[fail.Fail] = manifest.resolve_artifact_reqs(p.alloc, ?p.s.interner, toolchain, ?scope,
        bu.artifact, bu.target.name, cell_profile, for_union, ?p.config.art_reqs, ?p.config.art_req_count);
    if (sel rqr.err) { ret err[fail.Fail].err{rqr.err}; }

    var cell_v: template.Values = template.values_with(?p.s.interner, bu.target,
        cell_profile, p.config.art_reqs, p.config.art_req_count);

    # a dependency's other artifacts are never built for the root, so only the
    # root's own declarations can collide within a manifest
    if (!manifest.scope_is_dependency(?scope)) {
        val cr: err[fail.Fail] = manifest.check_collisions(p.alloc, ?p.s.interner, toolchain, m, ?cell_v);
        if (sel cr.err) {
            ret cr;
        }
    }

    val ter: res[*project.TargetEntry, A.Error] = A.allocate[project.TargetEntry](p.alloc, 1::usize);
    if (sel ter.err) { ret err[fail.Fail].err{fail.refused(ter.err)}; }
    val targets: *project.TargetEntry = ter.ok;
    var entry:   project.TargetEntry;
    entry.name            = bu.target_name;
    entry.os_name         = bu.target.os;
    entry.isa_name        = bu.target.isa;
    entry.abi_name        = bu.target.abi;
    entry.of_name         = bu.target.of;
    entry.platform_name   = bu.target.platform;
    entry.env_name        = bu.target.env;
    entry.base            = bu.target.base;
    entry.stack_reserve   = bu.target.stack_reserve;
    entry.stack_commit    = bu.target.stack_commit;
    entry.extensions      = bu.target.extensions;
    entry.extension_count = bu.target.extension_count;
    entry.entrypoint      = bu.entry;
    entry.kind            = bu.artifact.kind;
    entry.optimize        = bu.optimize;
    entry.libs            = bu.libs;
    entry.lib_count       = bu.lib_count;
    targets[0]            = entry;

    p.config.id           = om.id;
    p.config.version      = om.version;
    p.config.bin_name     = intern.STR_NIL;
    p.config.icon         = intern.STR_NIL;
    p.config.app_manifest = intern.STR_NIL;
    if (bu.artifact != nil) {
        p.config.bin_name     = bu.artifact.name;
        p.config.icon         = bu.artifact.icon;
        p.config.app_manifest = bu.artifact.app_manifest;
    }
    # a module is the cell's artifact's until the union walk says otherwise
    p.loader.artifact         = p.config.bin_name;
    p.config.module           = bu.entry;
    p.config.dir_src          = om.src;
    p.config.targets          = targets;
    p.config.target_count     = 1;
    p.target_entry            = ?p.config.targets[0];
    p.config.profile          = bu.profile_name;
    p.config.step_order       = nil;
    p.config.step_order_count = 0;

    val res_project_work_str: res[str, fail.Fail] = manifest.expand_project_work(p.alloc, ?p.s.interner, m, ?cell_v);
    if (sel res_project_work_str.err) { ret err[fail.Fail].err{res_project_work_str.err}; }
    val project_work_str: str                        = res_project_work_str.ok;
    val res_po_id:        res[intern.StrId, A.Error] = intern.add(?p.s.interner, project_work_str);
    if (sel res_po_id.err) {
        str_free(p.alloc, project_work_str);
        ret err[fail.Fail].err{fail.refused(res_po_id.err)};
    }
    p.config.project_work = res_po_id.ok;

    val vr: err[fail.Fail] = validate_local_links(p, project_root, om, bu.target, project_work_str, ?cell_v);
    if (sel vr.err) {
        str_free(p.alloc, project_work_str);
        ret vr;
    }

    val sor: err[fail.Fail] = validate_step_outputs(p, om, project_work_str, ?cell_v);
    if (sel sor.err) {
        str_free(p.alloc, project_work_str);
        ret sor;
    }

    val spr: err[fail.Fail] = compute_step_plan(p, om, ?bu, for_union, project_work_str, ?cell_v);
    if (sel spr.err) {
        str_free(p.alloc, project_work_str);
        ret spr;
    }
    str_free(p.alloc, project_work_str);

    p.config.steps      = nil;
    p.config.step_count = 0;
    if (om.step_count > 0) {
        val res_steps: res[*manifest.StepDef, A.Error] = A.allocate[manifest.StepDef](p.alloc, om.step_count::usize);
        if (sel res_steps.err) {
            ret err[fail.Fail].err{fail.refused(res_steps.err)};
        }
        val steps: *manifest.StepDef = res_steps.ok;
        var si:    u32               = 0;
        for (si < om.step_count) {
            val clone_r: err[fail.Fail] = clone_step(p.alloc, ?om.steps[si], ?steps[si]);
            if (sel clone_r.err) {
                var sj: u32 = 0;
                for (sj < si) {
                    manifest.step_dnit(p.alloc, ?steps[sj]);
                    sj = sj + 1;
                }
                A.deallocate[manifest.StepDef](p.alloc, steps, om.step_count::usize);
                ret clone_r;
            }
            si = si + 1;
        }
        p.config.steps      = steps;
        p.config.step_count = om.step_count;
    }

    if (!manifest.scope_is_dependency(?scope)) {
        val dr: err[fail.Fail] = driver_closure.locate(p, m, project_root, nil);
        if (sel dr.err) { ret err[fail.Fail].err{dr.err}; }
    }

    val scoped: err[fail.Fail] = driver_closure.resolve_requirement_scopes(p, m, cell_profile);
    if (sel scoped.err) { ret scoped; }
    session_embed.set_path_env(?p.s.embeds, project_root, p.config.req_scopes, p.config.req_scope_count,
        p.req.goal != request.GOAL_CHECK);

    val cr2: err[fail.Fail] = driver_closure.resolve_cascade_libs(p, bu.target.isa, bu.target.os, bu.target.abi,
        p.target_entry.libs, p.target_entry.lib_count);
    if (sel cr2.err) { ret err[fail.Fail].err{cr2.err}; }

    if (for_union) {
        val ut: err[fail.Fail] = union.populate_union_tuples(p, m);
        if (sel ut.err) { ret err[fail.Fail].err{ut.err}; }
    }
    if (for_union) {
        val ue: err[fail.Fail] = union.populate_union_entries(p, m);
        if (sel ue.err) { ret err[fail.Fail].err{ue.err}; }
    }

    ret err[fail.Fail].ok{};
}

pub fun module_obj_tree(a: *A.Allocator, proj_out: str, id: str) res[str, fail.Fail] {
    ret fail.format(a, "{}/obj/{}", proj_out, id);
}

pub fun path_in_module_obj_tree(path: str, tree: str) bool {
    if (str_equals(path, tree))       { ret true; }
    if (!str_starts_with(path, tree)) { ret false; }
    ret types_path.is_separator(path[str_len(tree)]);
}

pub fun step_out_reserved_error(a: *A.Allocator, what: str, name: str, path: str, tree: str, owner_desc: str) fail.Fail {
    ret fail.formatted_user(a, diagnostic_kind.STEP_OUTPUT_RESERVED,
        "{} '{}' writes '{}' into '{}/', {}: the compiler owns that directory, so a step output there is overwritten by (or overwrites) compiler state. write it elsewhere under {{project.work}}",
        what, name, path, tree, owner_desc);
}

# one declared step output: its expanded path, its step, and where it is written
rec DeclaredStepOutput {
    path: str;
    step: str;
    at:   fail.Place;
}

# by path, then step, then where each is written, so of two claims the earlier
# written one leads
fun declared_step_output_compare(a: *DeclaredStepOutput, b: *DeclaredStepOutput) i64 {
    val pc: i64 = str_compare(a.path, b.path);
    if (pc != 0) { ret pc; }
    val sc: i64 = str_compare(a.step, b.step);
    if (sc != 0)                             { ret sc; }
    if (a.at.span.offset < b.at.span.offset) { ret -1; }
    if (a.at.span.offset > b.at.span.offset) { ret 1; }
    ret 0;
}

fun declared_step_outputs_free(a: *A.Allocator, outputs: *Vector[DeclaredStepOutput]) {
    var i: usize = 0;
    for (i < outputs.len) {
        str_free(a, outputs.data[i].path);
        i = i + 1;
    }
    collections_vector.dnit[DeclaredStepOutput](outputs);
}

fun validate_declared_step_output_collisions(a: *A.Allocator, outputs: *Vector[DeclaredStepOutput]) err[fail.Fail] {
    sort.sort_by[DeclaredStepOutput](outputs.data, outputs.len, declared_step_output_compare);
    var i: usize = 0;
    for (i < outputs.len) {
        var j: usize = i + 1;
        for (j < outputs.len) {
            val left:  *DeclaredStepOutput = ?outputs.data[i];
            val right: *DeclaredStepOutput = ?outputs.data[j];
            val exact: bool                = str_equals(left.path, right.path);
            if (exact || path_in_module_obj_tree(right.path, left.path)) {
                var claims: [2]fail.Place;
                claims[0] = left.at;
                claims[1] = right.at;
                if (exact && str_equals(left.step, right.step)) {
                    ret err[fail.Fail].err{manifest.at_sites(a, fail.formatted_user(a, diagnostic_kind.STEP_OUTPUT_DUPLICATE, "mach.toml: [step.{}] declares output '{}' more than once", left.step, left.path), ?claims[0], 2)};
                }
                ret err[fail.Fail].err{manifest.at_sites(a, fail.formatted_user(a, diagnostic_kind.STEP_OUTPUT_COLLISION, "mach.toml: [step.{}] output '{}' collides with [step.{}] output '{}'", left.step, left.path, right.step, right.path), ?claims[0], 2)};
            }
            j = j + 1;
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun free_step_reserved_trees(a: *A.Allocator, tree: str, stage_tree: str, cache_tree: str) {
    str_free(a, tree);
    str_free(a, stage_tree);
    str_free(a, cache_tree);
}

fun validate_step_outputs(p: *project.Project, m: *manifest.Manifest, proj_out: str, v: *template.Values) err[fail.Fail] {
    if (m.step_count == 0) { ret err[fail.Fail].ok{}; }

    val tree_r: res[str, fail.Fail] = module_obj_tree(p.alloc, proj_out, intern.text(?p.s.interner, m.id));
    if (sel tree_r.err) { ret err[fail.Fail].err{tree_r.err}; }
    val stage_tree_r: res[str, fail.Fail] = fail.format(p.alloc, "{}/{}", proj_out, manifest.STAGE_DIR);
    if (sel stage_tree_r.err) {
        str_free(p.alloc, tree_r.ok);
        ret err[fail.Fail].err{stage_tree_r.err};
    }
    val cache_tree_r: res[str, fail.Fail] = fail.format(p.alloc, "{}/{}", proj_out, manifest.CACHE_DIR);
    if (sel cache_tree_r.err) {
        str_free(p.alloc, tree_r.ok);
        str_free(p.alloc, stage_tree_r.ok);
        ret err[fail.Fail].err{cache_tree_r.err};
    }
    val tree:       str                        = tree_r.ok;
    val stage_tree: str                        = stage_tree_r.ok;
    val cache_tree: str                        = cache_tree_r.ok;
    var outputs:    Vector[DeclaredStepOutput] = collections_vector.init[DeclaredStepOutput](p.alloc);

    var si: u32 = 0;
    for (si < m.step_count) {
        val step:  *manifest.StepDef = ?m.steps[si];
        val sname: str               = intern.text(?p.s.interner, step.name);

        var oi: u32 = 0;
        for (oi < step.out_count) {
            val at:    fail.Place          = manifest.site_of(step.out_at, oi);
            val exp_r: res[str, fail.Fail] = template.path_expand(p.alloc, intern.text(?p.s.interner, step.out[oi]), template.CONTEXT_PATH, proj_out, v, "a build step output");
            if (sel exp_r.err) {
                declared_step_outputs_free(p.alloc, ?outputs);
                free_step_reserved_trees(p.alloc, tree, stage_tree, cache_tree);
                ret err[fail.Fail].err{fail.at(p.alloc, exp_r.err, at)};
            }
            val exp: str = exp_r.ok;

            var reserved_tree: str = "";
            var reserved_desc: str = "";
            if (path_in_module_obj_tree(exp, tree)) {
                reserved_tree = tree;
                reserved_desc = "the module object tree";
            }
            or (path_in_module_obj_tree(exp, stage_tree)) {
                reserved_tree = stage_tree;
                reserved_desc = "the build step staging area";
            }
            or (path_in_module_obj_tree(exp, cache_tree)) {
                reserved_tree = cache_tree;
                reserved_desc = "the compiler cache directory";
            }
            if (!str_empty(reserved_tree)) {
                var refusal: fail.Fail           = fail.reported();
                val label:   res[str, fail.Fail] = fail.format(p.alloc, "[step.{}]", sname);
                if (sel label.err) { refusal = label.err; }
                or (sel label.ok) {
                    refusal = fail.at(p.alloc, step_out_reserved_error(p.alloc, "mach.toml: declared output of", label.ok, exp, reserved_tree, reserved_desc), at);
                    str_free(p.alloc, label.ok);
                }
                str_free(p.alloc, exp);
                declared_step_outputs_free(p.alloc, ?outputs);
                free_step_reserved_trees(p.alloc, tree, stage_tree, cache_tree);
                ret err[fail.Fail].err{refusal};
            }
            val push_r: res[usize, A.Error] = collections_vector.push[DeclaredStepOutput](?outputs, DeclaredStepOutput{path: exp, step: sname, at: at});
            if (sel push_r.err) {
                str_free(p.alloc, exp);
                declared_step_outputs_free(p.alloc, ?outputs);
                free_step_reserved_trees(p.alloc, tree, stage_tree, cache_tree);
                ret err[fail.Fail].err{fail.refused(push_r.err)};
            }
            oi = oi + 1;
        }
        si = si + 1;
    }
    val collision_r: err[fail.Fail] = validate_declared_step_output_collisions(p.alloc, ?outputs);
    declared_step_outputs_free(p.alloc, ?outputs);
    free_step_reserved_trees(p.alloc, tree, stage_tree, cache_tree);
    if (sel collision_r.err) { ret err[fail.Fail].err{collision_r.err}; }
    ret err[fail.Fail].ok{};
}

fun compute_step_plan(p: *project.Project, m: *manifest.Manifest, bu: *manifest.BuildUnit,
    for_union: bool, proj_out: str, v: *template.Values) err[fail.Fail] {
    p.config.step_order       = nil;
    p.config.step_order_count = 0;
    if (m.step_count == 0) { ret err[fail.Fail].ok{}; }

    var names:  *intern.StrId = nil;
    var ncount: u32           = 0;
    var owned:  bool          = false;
    if (for_union && m.artifact_count > 0) {
        val ar: res[*intern.StrId, A.Error] = A.allocate[intern.StrId](p.alloc, m.artifact_count::usize);
        if (sel ar.err) { ret err[fail.Fail].err{fail.refused(ar.err)}; }
        names = ar.ok;
        owned = true;
        var i: u32 = 0;
        for (i < m.artifact_count) {
            names[i] = m.artifacts[i].name;
            i        = i + 1;
        }
        ncount = m.artifact_count;
    }
    or {
        if (bu.artifact == nil) { ret err[fail.Fail].ok{}; }
        names  = ?bu.artifact.name;
        ncount = 1;
    }

    var order: *u32           = nil;
    var count: u32            = 0;
    val r:     err[fail.Fail] = manifest.plan_steps(p.alloc, ?p.s.interner, m, names, ncount, bu.target, proj_out, v, ?order, ?count);
    if (owned)     { A.deallocate[intern.StrId](p.alloc, names, m.artifact_count::usize); }
    if (sel r.err) { ret err[fail.Fail].err{r.err}; }
    p.config.step_order       = order;
    p.config.step_order_count = count;
    ret err[fail.Fail].ok{};
}

fun validate_local_links(p: *project.Project, project_root: str, m: *manifest.Manifest, t: *manifest.TargetDef, proj_out: str, v: *template.Values) err[fail.Fail] {
    var li: u32 = 0;
    for (li < m.link_count) {
        val l: *manifest.LinkDef = ?m.links[li];
        if (l.source == manifest.LINK_LOCAL && manifest.link_matches_target(?p.s.interner, l, t)) {
            val ename: str = intern.text(?p.s.interner, l.name);

            val exp_r: res[str, fail.Fail] = manifest.expand_local_path(p.alloc, ?p.s.interner, l, proj_out, v);
            if (sel exp_r.err) { ret err[fail.Fail].err{exp_r.err}; }
            val exp: str = exp_r.ok;

            val demanded: res[bool, fail.Fail] = manifest.local_path_demanded_by_step(p.alloc, ?p.s.interner, m, exp, proj_out, v);
            if (sel demanded.err) { ret err[fail.Fail].err{demanded.err}; }
            var ok_: bool = demanded.ok;
            if (!ok_) {
                val abs_r: res[str, fail.Fail] = driver_load.join_path(p.alloc, project_root, exp);
                if (sel abs_r.ok) {
                    val abs:      str                       = abs_r.ok;
                    val exists_r: res[bool, io_error.Error] = fs.exists(abs);
                    ok_ = (sel exists_r.ok && exists_r.ok);
                    str_free(p.alloc, abs);
                }
            }
            if (!ok_) {
                val refusal: fail.Fail = fail.formatted_user(p.alloc, diagnostic_kind.LINK_LOCAL_MISSING,
                    "mach.toml: [link.{}] path '{}' matches no step output and does not exist on disk", ename, exp);
                str_free(p.alloc, exp);
                ret err[fail.Fail].err{fail.at(p.alloc, refusal, l.path_at)};
            }
            str_free(p.alloc, exp);
        }
        li = li + 1;
    }
    ret err[fail.Fail].ok{};
}

pub fun select_target(p: *project.Project, t: *project.TargetEntry) err[fail.Fail] {
    val toolchain_r: res[*lang_target.TargetRegistry, fail.Fail] = toolchain.registry();
    if (sel toolchain_r.err) { ret err[fail.Fail].err{toolchain_r.err}; }
    val toolchain: *lang_target.TargetRegistry = toolchain_r.ok;
    val os_name:   str                         = intern.text(?p.s.interner, t.os_name);
    val isa_name:  str                         = intern.text(?p.s.interner, t.isa_name);
    val abi_name:  str                         = intern.text(?p.s.interner, t.abi_name);

    var of_name: str = "";
    if (!intern.str_is_nil(t.of_name)) { of_name = intern.text(?p.s.interner, t.of_name); }

    var req: lang_target.TargetRequest = lang_target.target_request(isa_name, os_name, abi_name);
    lang_target.with_of(?req, of_name);
    lang_target.with_image(?req, t.base, t.stack_reserve, t.stack_commit);
    var env_name: str = "";
    if (!intern.str_is_nil(t.env_name)) { env_name = intern.text(?p.s.interner, t.env_name); }
    # a target the manifest does not name is labelled by its isa
    var label: str = isa_name;
    if (!intern.str_is_nil(t.name) && !str_empty(intern.text(?p.s.interner, t.name))) { label = intern.text(?p.s.interner, t.name); }
    var origin: str = "";
    if (!str_empty(env_name)) {
        val written: res[str, fail.Fail] = fail.format_intern(?p.s.interner, p.s.alloc, "mach.toml: [target.{}] env = \"{}\"", label, env_name);
        if (sel written.err) { ret err[fail.Fail].err{written.err}; }
        origin = written.ok;
    }
    lang_target.with_env(?req, env_name, origin);
    var ext_names: [64]str;
    var ei:        u32 = 0;
    for (ei < t.extension_count) {
        ext_names[ei] = intern.text(?p.s.interner, t.extensions[ei]);
        ei            = ei + 1;
    }
    lang_target.with_extensions(?req, ?ext_names[0], t.extension_count);
    val tr: res[lang_target.Binding, fail.Fail] = lang_target.resolve(toolchain, ?req);
    if (sel tr.err) { ret err[fail.Fail].err{fail.as_user(diagnostic_kind.TARGET_INVALID, tr.err)}; }
    p.target = tr.ok;

    val rcn: res[intern.StrId, A.Error] = intern.add(?p.s.interner, "mach");
    if (sel rcn.err) { ret err[fail.Fail].err{fail.refused(rcn.err)}; }
    p.compiler_name = rcn.ok;

    val rcv: res[intern.StrId, A.Error] = intern.add(?p.s.interner, driver_load.MACH_VERSION);
    if (sel rcv.err) { ret err[fail.Fail].err{fail.refused(rcv.err)}; }
    p.compiler_ver = rcv.ok;

    ret err[fail.Fail].ok{};
}

#[testing]
fun cfg_contains(hay: str, needle: str) bool {
    val hn: usize = str_len(hay);
    val nn: usize = str_len(needle);
    if (nn > hn) { ret false; }
    var i: usize = 0;
    for (i + nn <= hn) {
        var j: usize = 0;
        for (j < nn && hay[i + j] == needle[j]) { j = j + 1; }
        if (j == nn) { ret true; }
        i = i + 1;
    }
    ret false;
}

# two allocations succeed, then every request is refused
test clone_step__allocation_failure_is_atomic {
    var t:      T.Testing;
    val make_r: err[A.Error] = T.make(?t);
    if (sel make_r.err) { ret 1; }
    fin { T.dnit(?t); }
    T.fail_from_ordinal(?t, 3);
    T.refuse_reallocates(?t, true);

    var argv:       [1]intern.StrId;
    var env_keys:   [1]intern.StrId;
    var env_values: [1]intern.StrId;
    argv[0]       = intern.str_id(1);
    env_keys[0]   = intern.str_id(2);
    env_values[0] = intern.str_id(3);
    var src: manifest.StepDef;
    src.name       = intern.str_id(4);
    src.argv       = ?argv[0];
    src.argv_count = 1;
    src.env_keys   = ?env_keys[0];
    src.env_values = ?env_values[0];
    src.env_count  = 1;
    src.in         = nil;
    src.in_count   = 0;
    src.out        = nil;
    src.out_count  = 0;
    src.need       = nil;
    src.need_count = 0;
    var out: manifest.StepDef;
    out.name = intern.str_id(99);
    val r: err[fail.Fail] = clone_step(T.allocator_of(?t), ?src, ?out);
    if (sel r.ok)                                      { ret 1; }
    if (!intern.str_same(out.name, intern.str_id(99))) { ret 1; }
    if (!T.clean(?t))                                  { ret 1; }
    ret 0;
}

test path_in_module_obj_tree__boundaries {
    val tree: str = "out/linux/debug/obj/vend";
    if (!path_in_module_obj_tree("out/linux/debug/obj/vend", tree))           { ret 1; }
    if (!path_in_module_obj_tree("out/linux/debug/obj/vend/window.o", tree))  { ret 2; }
    if (!path_in_module_obj_tree("out/linux/debug/obj/vend/gl/ctx.o", tree))  { ret 3; }
    if (path_in_module_obj_tree("out/linux/debug/obj/vend-c/window.o", tree)) { ret 4; }
    if (path_in_module_obj_tree("out/linux/debug/obj/other/window.o", tree))  { ret 5; }
    if (path_in_module_obj_tree("out/linux/debug/vendor/window.o", tree))     { ret 6; }
    ret 0;
}

test validate_declared_step_output_collisions__deterministic {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var outputs: Vector[DeclaredStepOutput] = collections_vector.init[DeclaredStepOutput](?alloc);
    val push_r:  res[usize, A.Error]        = collections_vector.push[DeclaredStepOutput](?outputs, DeclaredStepOutput{path: "out/generated", step: "zeta"});
    if (sel push_r.err) { ret 1; }
    val push_r2: res[usize, A.Error] = collections_vector.push[DeclaredStepOutput](?outputs, DeclaredStepOutput{path: "out/generated", step: "alpha"});
    if (sel push_r2.err) {
        collections_vector.dnit[DeclaredStepOutput](?outputs);
        ret 1;
    }
    val exact: err[fail.Fail] = validate_declared_step_output_collisions(?alloc, ?outputs);
    var bad:   bool           = sel exact.ok;
    if (sel exact.err) {
        val msg: str = fail.describe(exact.err);
        if (!cfg_contains(msg, "[step.alpha]") || !cfg_contains(msg, "[step.zeta]")) { bad = true; }
        str_free(?alloc, msg);
    }
    collections_vector.dnit[DeclaredStepOutput](?outputs);

    outputs = collections_vector.init[DeclaredStepOutput](?alloc);
    val push_r3: res[usize, A.Error] = collections_vector.push[DeclaredStepOutput](?outputs, DeclaredStepOutput{path: "out/generated/file", step: "zeta"});
    if (sel push_r3.err) { ret 1; }
    val push_r4: res[usize, A.Error] = collections_vector.push[DeclaredStepOutput](?outputs, DeclaredStepOutput{path: "out/generated", step: "alpha"});
    if (sel push_r4.err) {
        collections_vector.dnit[DeclaredStepOutput](?outputs);
        ret 1;
    }
    val nested: err[fail.Fail] = validate_declared_step_output_collisions(?alloc, ?outputs);
    if (sel nested.ok) { bad = true; }
    if (sel nested.err) {
        val msg: str = fail.describe(nested.err);
        if (!cfg_contains(msg, "collides")) { bad = true; }
        str_free(?alloc, msg);
    }
    collections_vector.dnit[DeclaredStepOutput](?outputs);

    outputs = collections_vector.init[DeclaredStepOutput](?alloc);
    val push_r5: res[usize, A.Error] = collections_vector.push[DeclaredStepOutput](?outputs, DeclaredStepOutput{path: "out/generated/file", step: "alpha"});
    if (sel push_r5.err) { ret 1; }
    val push_r6: res[usize, A.Error] = collections_vector.push[DeclaredStepOutput](?outputs, DeclaredStepOutput{path: "out/generated", step: "alpha"});
    if (sel push_r6.err) {
        collections_vector.dnit[DeclaredStepOutput](?outputs);
        ret 1;
    }
    val same_step_nested: err[fail.Fail] = validate_declared_step_output_collisions(?alloc, ?outputs);
    if (sel same_step_nested.ok) { bad = true; }
    if (sel same_step_nested.err) {
        val msg: str = fail.describe(same_step_nested.err);
        if (!cfg_contains(msg, "collides")) { bad = true; }
        str_free(?alloc, msg);
    }
    collections_vector.dnit[DeclaredStepOutput](?outputs);

    outputs = collections_vector.init[DeclaredStepOutput](?alloc);
    val push_r7: res[usize, A.Error] = collections_vector.push[DeclaredStepOutput](?outputs, DeclaredStepOutput{path: "out/a", step: "alpha"});
    if (sel push_r7.err) { ret 1; }
    val push_r8: res[usize, A.Error] = collections_vector.push[DeclaredStepOutput](?outputs, DeclaredStepOutput{path: "out/b", step: "beta"});
    if (sel push_r8.err) {
        collections_vector.dnit[DeclaredStepOutput](?outputs);
        ret 1;
    }
    val separate: err[fail.Fail] = validate_declared_step_output_collisions(?alloc, ?outputs);
    if (sel separate.err) { bad = true; }
    collections_vector.dnit[DeclaredStepOutput](?outputs);
    if (bad) { ret 1; }
    ret 0;
}

#[testing]
fun t_temp_project(a: *A.Allocator, prefix: str, toml_body: str) res[str, fail.Fail] {
    val tf_r: res[fs.TempFile, fs.FsError] = fs.temp_create(a, prefix);
    if (sel tf_r.err) { ret res[str, fail.Fail].err{fail.user(diagnostic_kind.FS_WRITE, fail.fs_text(tf_r.err))}; }
    var tf:   fs.TempFile = tf_r.ok;
    val root: str         = fs.temp_path(?tf);
    fs.temp_close_and_remove(?tf);
    val create_dir_all_r: err[fs.FsError] = fs.create_dir_all(a, root, 0o755);
    if (sel create_dir_all_r.err) { ret res[str, fail.Fail].err{fail.user(diagnostic_kind.FS_WRITE, "could not create temp project dir")}; }

    val toml_path_r: res[str, fail.Fail] = driver_load.join_path(a, root, "mach.toml");
    if (sel toml_path_r.err) { ret res[str, fail.Fail].err{toml_path_r.err}; }
    val toml_path:     str             = toml_path_r.ok;
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(toml_path, toml_body::*u8, str_len(toml_body), 0o644);
    if (sel write_bytes_r.err) {
        ret res[str, fail.Fail].err{fail.user(diagnostic_kind.FS_WRITE, "could not write mach.toml")};
    }
    ret res[str, fail.Fail].ok{root};
}

test resolve_run_artifact__rejects_library_selection {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val reg_made: res[*lang_target.TargetRegistry, fail.Fail] = toolchain.registry();
    if (sel reg_made.err) { ret 1; }
    val reg: *lang_target.TargetRegistry = reg_made.ok;

    val body:   str                 = "[project]\nmach = \">=5\"\nid = \"libonly\"\nversion = \"0.0.0\"\nsrc = \"src\"\nwork = \"out\"\n\n[artifact.libonly]\nkind = \"static\"\nentry = \"src/lib.mach\"\nout = \"{project.work}/lib/libonly.a\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\ndefault = true\noptimize = false\ndebug = true\nsimd = \"scalarize\"\n[profile.release]\noptimize = true\ndebug = false\nsimd = \"scalarize\"\n";
    val root_r: res[str, fail.Fail] = t_temp_project(?alloc, "mach_run_artifact_lib", body);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;

    var pick: manifest.Selectors          = manifest.selectors_init(?alloc);
    val rr:   res[RunArtifact, fail.Fail] = resolve_run_artifact(?alloc, reg, root, ?pick, nil);

    var bad: i32 = 0;
    if (sel rr.ok) { bad = 1; }
    if (sel rr.err) {
        if (!str_contains(fail.describe(rr.err), "library")) { bad = 1; }
    }

    fs.remove_all(?alloc, root);
    ret bad;
}

#[testing]
fun t_native_path_is(a: *A.Allocator, actual: str, base: str, leaf: str) bool {
    val joined_r: res[types_path.Path, A.Error] = types_path.join(a, base, leaf);
    if (sel joined_r.err) { ret false; }
    val joined:     str                           = joined_r.ok;
    val expected_r: res[types_path.Path, A.Error] = types_path.clean(a, joined);
    str_free(a, joined);
    if (sel expected_r.err) { ret false; }
    val expected: str                           = expected_r.ok;
    val actual_r: res[types_path.Path, A.Error] = types_path.clean(a, actual);
    if (sel actual_r.err) {
        str_free(a, expected);
        ret false;
    }
    val normalized: str  = actual_r.ok;
    val same:       bool = str_equals(normalized, expected);
    str_free(a, normalized);
    str_free(a, expected);
    ret same;
}

test resolve_run_artifact__o_override_resolves_relative_and_absolute {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val reg_made: res[*lang_target.TargetRegistry, fail.Fail] = toolchain.registry();
    if (sel reg_made.err) { ret 1; }
    val reg: *lang_target.TargetRegistry = reg_made.ok;

    val body:   str                 = "[project]\nmach = \">=5\"\nid = \"runbin\"\nversion = \"0.0.0\"\nsrc = \"src\"\nwork = \"out\"\n\n[artifact.runbin]\nkind = \"bin\"\nentry = \"src/main.mach\"\nout = \"{project.work}/bin/runbin\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\ndefault = true\noptimize = false\ndebug = true\nsimd = \"scalarize\"\n[profile.release]\noptimize = true\ndebug = false\nsimd = \"scalarize\"\n";
    val root_r: res[str, fail.Fail] = t_temp_project(?alloc, "mach_run_artifact_o", body);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;

    var bad: i32 = 0;

    var sel_default: manifest.Selectors          = manifest.selectors_init(?alloc);
    val default_r:   res[RunArtifact, fail.Fail] = resolve_run_artifact(?alloc, reg, root, ?sel_default, nil);
    if (sel default_r.err) { bad = 1; }
    if (sel default_r.ok) {
        val ra: RunArtifact = default_r.ok;
        if (!t_native_path_is(?alloc, ra.path, root, "out/bin/runbin")) { bad = 1; }
        if (!ra.host_runnable)                                          { bad = 1; }
    }

    var sel_rel: manifest.Selectors          = manifest.selectors_init(?alloc);
    val rel_r:   res[RunArtifact, fail.Fail] = resolve_run_artifact(?alloc, reg, root, ?sel_rel, "custom/copy");
    if (sel rel_r.err) { bad = 1; }
    if (sel rel_r.ok) {
        val ra: RunArtifact = rel_r.ok;
        if (!t_native_path_is(?alloc, ra.path, root, "custom/copy")) { bad = 1; }
    }

    val outside_join_r: res[types_path.Path, A.Error] = types_path.join(?alloc, root, "../somewhere/else");
    if (sel outside_join_r.err) {
        fs.remove_all(?alloc, root);
        ret 1;
    }
    val outside_join: str                           = outside_join_r.ok;
    val outside_r:    res[types_path.Path, A.Error] = types_path.clean(?alloc, outside_join);
    str_free(?alloc, outside_join);
    if (sel outside_r.err) {
        fs.remove_all(?alloc, root);
        ret 1;
    }
    val outside: str                         = outside_r.ok;
    var sel_abs: manifest.Selectors          = manifest.selectors_init(?alloc);
    val abs_r:   res[RunArtifact, fail.Fail] = resolve_run_artifact(?alloc, reg, root, ?sel_abs, outside);
    if (sel abs_r.err) { bad = 1; }
    if (sel abs_r.ok) {
        val ra: RunArtifact = abs_r.ok;
        if (!str_equals(ra.path, outside)) { bad = 1; }
    }

    str_free(?alloc, outside);

    var sel_empty: manifest.Selectors          = manifest.selectors_init(?alloc);
    val empty_r:   res[RunArtifact, fail.Fail] = resolve_run_artifact(?alloc, reg, root, ?sel_empty, "");
    if (sel empty_r.ok) { bad = 1; }

    fs.remove_all(?alloc, root);
    ret bad;
}

# run executes one artifact: a selection of two bins is refused before launch, naming both
test resolve_run_artifact__refuses_a_selection_of_several {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val reg_made: res[*lang_target.TargetRegistry, fail.Fail] = toolchain.registry();
    if (sel reg_made.err) { ret 1; }
    val reg:    *lang_target.TargetRegistry = reg_made.ok;
    val body:   str                         = "[project]\nmach = \">=5\"\nid = \"tworun\"\nversion = \"0.0.0\"\nsrc = \"src\"\nwork = \"out\"\n\n[artifact.one]\nkind = \"bin\"\nentry = \"one.mach\"\nout = \"{project.work}/bin/one\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[artifact.two]\nkind = \"bin\"\nentry = \"two.mach\"\nout = \"{project.work}/bin/two\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\ndefault = true\noptimize = false\ndebug = true\nsimd = \"scalarize\"\n";
    val root_r: res[str, fail.Fail]         = t_temp_project(?alloc, "mach_run_artifact_two", body);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?alloc, root); }

    var every: manifest.Selectors = manifest.selectors_init(?alloc);
    collections_vector.push[str](?every.artifacts, "*");
    val many: res[RunArtifact, fail.Fail] = resolve_run_artifact(?alloc, reg, root, ?every, nil);
    if (sel many.ok)                                                                            { ret 2; }
    if (!str_contains(fail.describe(many.err), "mach run executes one artifact"))               { ret 3; }
    if (!str_contains(fail.describe(many.err), "one on native (debug), two on native (debug)")) { ret 4; }

    var named: manifest.Selectors = manifest.selectors_init(?alloc);
    collections_vector.push[str](?named.artifacts, "two");
    val one: res[RunArtifact, fail.Fail] = resolve_run_artifact(?alloc, reg, root, ?named, nil);
    if (sel one.err)                            { ret 5; }
    if (!str_ends_with(one.ok.path, "bin/two")) { ret 6; }
    ret 0;
}

test resolve_run_artifact__host_runnable_reflects_the_resolved_target {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val reg_made: res[*lang_target.TargetRegistry, fail.Fail] = toolchain.registry();
    if (sel reg_made.err) { ret 1; }
    val reg: *lang_target.TargetRegistry = reg_made.ok;

    val host_body:   str                 = "[project]\nmach = \">=5\"\nid = \"hostrun\"\nversion = \"0.0.0\"\nsrc = \"src\"\nwork = \"out\"\n\n[artifact.hostrun]\nkind = \"bin\"\nentry = \"src/main.mach\"\nout = \"{project.work}/bin/hostrun\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\ndefault = true\noptimize = false\ndebug = true\nsimd = \"scalarize\"\n[profile.release]\noptimize = true\ndebug = false\nsimd = \"scalarize\"\n";
    val host_root_r: res[str, fail.Fail] = t_temp_project(?alloc, "mach_run_artifact_host", host_body);
    if (sel host_root_r.err) { ret 1; }
    val host_root: str = host_root_r.ok;

    var bad: i32 = 0;

    var host_sel: manifest.Selectors          = manifest.selectors_init(?alloc);
    val host_r:   res[RunArtifact, fail.Fail] = resolve_run_artifact(?alloc, reg, host_root, ?host_sel, nil);
    if (sel host_r.err)                                  { ret 99; }
    if (!(sel host_r.ok && !(!host_r.ok.host_runnable))) { bad = 1; }
    fs.remove_all(?alloc, host_root);

    var foreign_os:  str = "windows";
    var foreign_abi: str = "win64";
    $if ($mach.build.os == $mach.os.windows) {
        foreign_os  = "linux";
        foreign_abi = "sysv64";
    }
    val foreign_body_r: res[str, std_format.FormatError] = std_format.sprint(?alloc, "[project]\nmach = \">=5\"\nid = \"foreignrun\"\nversion = \"0.0.0\"\nsrc = \"src\"\nwork = \"out\"\n\n[target.foreign]\nisa = \"x86_64\"\nos = \"{}\"\nabi = \"{}\"\n\n[artifact.foreignrun]\nkind = \"bin\"\nentry = \"src/main.mach\"\nout = \"{{project.work}}/bin/foreignrun.exe\"\ntargets = [\"foreign\"]\nlink = []\nneed = []\n[profile.debug]\ndefault = true\noptimize = false\ndebug = true\nsimd = \"scalarize\"\n[profile.release]\noptimize = true\ndebug = false\nsimd = \"scalarize\"\n", foreign_os, foreign_abi);
    if (sel foreign_body_r.err) { ret 1; }
    val foreign_body: str = foreign_body_r.ok;
    fin { str_free(?alloc, foreign_body); }
    val foreign_root_r: res[str, fail.Fail] = t_temp_project(?alloc, "mach_run_artifact_foreign", foreign_body);
    if (sel foreign_root_r.err) { ret 1; }
    val foreign_root: str = foreign_root_r.ok;

    var foreign_sel: manifest.Selectors = manifest.selectors_init(?alloc);
    collections_vector.push[str](?foreign_sel.targets, "foreign");
    val foreign_r: res[RunArtifact, fail.Fail] = resolve_run_artifact(?alloc, reg, foreign_root, ?foreign_sel, nil);
    if (sel foreign_r.err)                                    { ret 99; }
    if (!(sel foreign_r.ok && !(foreign_r.ok.host_runnable))) { bad = 1; }
    fs.remove_all(?alloc, foreign_root);

    ret bad;
}
