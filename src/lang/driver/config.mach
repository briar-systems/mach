pub fun resolve_artifact_path(alloc: *A.Allocator, project_root: str, pick: *manifest.Selection) res[str, outcome.Fail] {
    val mp_r: res[str, fail.Fail] = load.join_path(alloc, project_root, manifest.MANIFEST_FILE);
    if (sel mp_r.err) { ret res[str, outcome.Fail].err{outcome.from_fail(mp_r.err)}; }
    val manifest_path: str = mp_r.ok;

    val toml_r: res[toml.Table, outcome.Fail] = ddep.parse_toml_file(alloc, manifest_path);
    if (sel toml_r.err) { ret res[str, outcome.Fail].err{toml_r.err}; }
    var t: toml.Table = toml_r.ok;

    var itn: intern.Interner = intern.init(alloc);
    val mr: res[manifest.Manifest, outcome.Fail] = manifest.parse(alloc, ?itn, ?t, true);
    toml.dnit(alloc, ?t);
    if (sel mr.err) { ret res[str, outcome.Fail].err{mr.err}; }
    var m: manifest.Manifest = mr.ok;

    var eff_sel: manifest.Selection = @pick;
    val ssr: err[outcome.Fail] = manifest.select_sole_target_artifact(
        alloc, ?itn, ?m, ?eff_sel);
    if (sel ssr.err) {
        manifest.dnit(?m, alloc);
        ret res[str, outcome.Fail].err{ssr.err};
    }

    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val ready: err[outcome.Fail] = setup_registry(?reg);
    if (sel ready.err) {
        manifest.dnit(?m, alloc);
        ret res[str, outcome.Fail].err{ready.err};
    }
    val ur: res[manifest.BuildUnit, outcome.Fail] = manifest.resolve_build_unit(alloc, ?itn, ?reg, ?m, eff_sel);
    if (sel ur.err) {
        manifest.dnit(?m, alloc);
        ret res[str, outcome.Fail].err{ur.err};
    }
    val bu: manifest.BuildUnit = ur.ok;

    val bin_opt: opt[str] = intern.lookup(?itn, bu.bin_path);
    if (sel bin_opt.none) {
        manifest.dnit(?m, alloc);
        ret res[str, outcome.Fail].err{outcome.user("selected artifact has no output path; set the `out` template in mach.toml")};
    }
    if (str_empty(bin_opt.some)) {
        manifest.dnit(?m, alloc);
        ret res[str, outcome.Fail].err{outcome.user("selected artifact has no output path; set the `out` template in mach.toml")};
    }
    val abs_r: res[str, fail.Fail] = load.join_path(alloc, project_root, bin_opt.some);
    manifest.dnit(?m, alloc);
    if (sel abs_r.err) { ret res[str, outcome.Fail].err{outcome.from_fail(abs_r.err)}; }
    ret res[str, outcome.Fail].ok{abs_r.ok};
}

pub rec RunArtifact {
    path:          str;
    host_runnable: bool;
    target_name:   str;
}

pub fun resolve_run_artifact(alloc: *A.Allocator, project_root: str, pick: *manifest.Selection,
                             output_override: str) res[RunArtifact, outcome.Fail] {
    val mp_r: res[str, fail.Fail] = load.join_path(alloc, project_root, manifest.MANIFEST_FILE);
    if (sel mp_r.err) { ret res[RunArtifact, outcome.Fail].err{outcome.from_fail(mp_r.err)}; }
    val manifest_path: str = mp_r.ok;

    val toml_r: res[toml.Table, outcome.Fail] = ddep.parse_toml_file(alloc, manifest_path);
    if (sel toml_r.err) { ret res[RunArtifact, outcome.Fail].err{toml_r.err}; }
    var t: toml.Table = toml_r.ok;

    var itn: intern.Interner = intern.init(alloc);
    val mr: res[manifest.Manifest, outcome.Fail] = manifest.parse(alloc, ?itn, ?t, true);
    toml.dnit(alloc, ?t);
    if (sel mr.err) { ret res[RunArtifact, outcome.Fail].err{mr.err}; }
    var m: manifest.Manifest = mr.ok;

    var eff_sel: manifest.Selection = @pick;
    val ssr: err[outcome.Fail] = manifest.select_sole_executable_artifact(alloc, ?itn, ?m, ?eff_sel);
    if (sel ssr.err) {
        manifest.dnit(?m, alloc);
        ret res[RunArtifact, outcome.Fail].err{ssr.err};
    }

    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val ready: err[outcome.Fail] = setup_registry(?reg);
    if (sel ready.err) {
        manifest.dnit(?m, alloc);
        ret res[RunArtifact, outcome.Fail].err{ready.err};
    }
    val ur: res[manifest.BuildUnit, outcome.Fail] = manifest.resolve_build_unit(alloc, ?itn, ?reg, ?m, eff_sel);
    if (sel ur.err) {
        manifest.dnit(?m, alloc);
        ret res[RunArtifact, outcome.Fail].err{ur.err};
    }
    val bu: manifest.BuildUnit = ur.ok;

    if (bu.is_lib) {
        var name: str = "?";
        val name_opt: opt[str] = intern.lookup(?itn, bu.artifact.name);
        if (sel name_opt.some) { name = name_opt.some; }
        val msg: str = sfmt(alloc, "selected artifact '{}' is a library; run executes only bin artifacts", name);
        manifest.dnit(?m, alloc);
        ret res[RunArtifact, outcome.Fail].err{outcome.user(msg)};
    }

    var ra: RunArtifact;
    ra.host_runnable = manifest.target_matches_host(?itn, bu.target, target.host_os_id(), target.host_arch_id());
    ra.target_name    = "?";
    val tname_opt: opt[str] = intern.lookup(?itn, bu.target.name);
    if (sel tname_opt.some) { ra.target_name = tname_opt.some; }

    if (output_override != nil) {
        if (str_empty(output_override)) {
            manifest.dnit(?m, alloc);
            ret res[RunArtifact, outcome.Fail].err{outcome.user("-o requires a non-empty path")};
        }
        val resolved_r: res[spath.Path, A.Error] = spath.resolve(alloc, project_root, output_override);
        if (sel resolved_r.err) {
            manifest.dnit(?m, alloc);
            ret res[RunArtifact, outcome.Fail].err{outcome.user(sfmt(alloc, "-o '{}': {}", output_override, outcome.alloc_text(resolved_r.err)))};
        }
        val cleaned_r: res[spath.Path, A.Error] = spath.clean(alloc, resolved_r.ok);
        if (sel cleaned_r.err) {
            manifest.dnit(?m, alloc);
            ret res[RunArtifact, outcome.Fail].err{outcome.user(sfmt(alloc, "-o '{}': {}", output_override, outcome.alloc_text(cleaned_r.err)))};
        }
        ra.path = cleaned_r.ok;
        manifest.dnit(?m, alloc);
        ret res[RunArtifact, outcome.Fail].ok{ra};
    }

    val bin_opt: opt[str] = intern.lookup(?itn, bu.bin_path);
    if (sel bin_opt.none) {
        manifest.dnit(?m, alloc);
        ret res[RunArtifact, outcome.Fail].err{outcome.user("selected artifact has no output path; set the `out` template in mach.toml")};
    }
    if (str_empty(bin_opt.some)) {
        manifest.dnit(?m, alloc);
        ret res[RunArtifact, outcome.Fail].err{outcome.user("selected artifact has no output path; set the `out` template in mach.toml")};
    }
    val abs_r: res[str, fail.Fail] = load.join_path(alloc, project_root, bin_opt.some);
    manifest.dnit(?m, alloc);
    if (sel abs_r.err) { ret res[RunArtifact, outcome.Fail].err{outcome.from_fail(abs_r.err)}; }
    ra.path = abs_r.ok;
    ret res[RunArtifact, outcome.Fail].ok{ra};
}

pub fun load_project_config(p: *project.Project, project_root: str, manifest_path: str, pick: *manifest.Selection, for_union: bool, is_test: bool) err[outcome.Fail] {
    val lock_r: err[outcome.Fail] = ddep.refuse_stale_lock(p.alloc, project_root);
    if (sel lock_r.err) { ret lock_r; }
    val toml_r: res[toml.Table, outcome.Fail] = ddep.parse_toml_file(p.alloc, manifest_path);
    if (sel toml_r.err) { ret err[outcome.Fail].err{toml_r.err}; }
    var t: toml.Table = toml_r.ok;

    val r: err[outcome.Fail] = load_config(p, project_root, ?t, pick, for_union, is_test);
    toml.dnit(p.alloc, ?t);
    ret r;
}

fun load_config(p: *project.Project, project_root: str, t: *toml.Table, pick: *manifest.Selection, for_union: bool, is_test: bool) err[outcome.Fail] {
    val mr: res[manifest.Manifest, outcome.Fail] = manifest.parse(p.alloc, ?p.s.interner, t, true);
    if (sel mr.err) { ret err[outcome.Fail].err{mr.err}; }
    var m: manifest.Manifest = mr.ok;
    val r: err[outcome.Fail] = load_config_manifest(p, project_root, ?m, pick, for_union, is_test);
    manifest.dnit(?m, p.alloc);
    ret r;
}

fun dup_strid_array(alloc: *A.Allocator, src: *intern.StrId, count: u32) res[*intern.StrId, outcome.Fail] {
    if (src == nil || count == 0) { ret res[*intern.StrId, outcome.Fail].ok{nil}; }
    val r: res[*intern.StrId, A.Error] = A.allocate[intern.StrId](alloc, count::usize);
    if (sel r.err) { ret res[*intern.StrId, outcome.Fail].err{outcome.refused(r.err)}; }
    val arr: *intern.StrId = r.ok;
    var i: u32 = 0;
    for (i < count) { arr[i] = src[i]; i = i + 1; }
    ret res[*intern.StrId, outcome.Fail].ok{arr};
}

fun free_step_arrays(alloc: *A.Allocator, d: *manifest.StepDef) {
    if (d.argv != nil && d.argv_count > 0) { A.deallocate[intern.StrId](alloc, d.argv, d.argv_count::usize); }
    if (d.env_keys != nil && d.env_count > 0) { A.deallocate[intern.StrId](alloc, d.env_keys, d.env_count::usize); }
    if (d.env_values != nil && d.env_count > 0) { A.deallocate[intern.StrId](alloc, d.env_values, d.env_count::usize); }
    if (d.in != nil && d.in_count > 0) { A.deallocate[intern.StrId](alloc, d.in, d.in_count::usize); }
    if (d.out != nil && d.out_count > 0) { A.deallocate[intern.StrId](alloc, d.out, d.out_count::usize); }
    if (d.need != nil && d.need_count > 0) { A.deallocate[intern.StrId](alloc, d.need, d.need_count::usize); }
}

fun clone_step(alloc: *A.Allocator, src: *manifest.StepDef, out: *manifest.StepDef) err[outcome.Fail] {
    var d: manifest.StepDef = @src;
    d.argv = nil;
    d.env_keys = nil;
    d.env_values = nil;
    d.in = nil;
    d.out = nil;
    d.need = nil;

    val argv_r: res[*intern.StrId, outcome.Fail] = dup_strid_array(alloc, src.argv, src.argv_count);
    if (sel argv_r.err) { ret err[outcome.Fail].err{argv_r.err}; }
    d.argv = argv_r.ok;

    val env_keys_r: res[*intern.StrId, outcome.Fail] = dup_strid_array(alloc, src.env_keys, src.env_count);
    if (sel env_keys_r.err) {
        free_step_arrays(alloc, ?d);
        ret err[outcome.Fail].err{env_keys_r.err};
    }
    d.env_keys = env_keys_r.ok;

    val env_values_r: res[*intern.StrId, outcome.Fail] = dup_strid_array(alloc, src.env_values, src.env_count);
    if (sel env_values_r.err) {
        free_step_arrays(alloc, ?d);
        ret err[outcome.Fail].err{env_values_r.err};
    }
    d.env_values = env_values_r.ok;

    val in_r: res[*intern.StrId, outcome.Fail] = dup_strid_array(alloc, src.in, src.in_count);
    if (sel in_r.err) {
        free_step_arrays(alloc, ?d);
        ret err[outcome.Fail].err{in_r.err};
    }
    d.in = in_r.ok;

    val out_r: res[*intern.StrId, outcome.Fail] = dup_strid_array(alloc, src.out, src.out_count);
    if (sel out_r.err) {
        free_step_arrays(alloc, ?d);
        ret err[outcome.Fail].err{out_r.err};
    }
    d.out = out_r.ok;

    val need_r: res[*intern.StrId, outcome.Fail] = dup_strid_array(alloc, src.need, src.need_count);
    if (sel need_r.err) {
        free_step_arrays(alloc, ?d);
        ret err[outcome.Fail].err{need_r.err};
    }
    d.need = need_r.ok;
    @out = d;
    ret err[outcome.Fail].ok{};
}

pub fun load_config_manifest(p: *project.Project, project_root: str, m: *manifest.Manifest, pick: *manifest.Selection, for_union: bool, is_test: bool) err[outcome.Fail] {
    val abs_root_r: res[intern.StrId, A.Error] = intern.intern(?p.s.interner, project_root);
    if (sel abs_root_r.err) { ret err[outcome.Fail].err{outcome.refused(abs_root_r.err)}; }
    p.config.project_root = abs_root_r.ok;

    var eff_sel: manifest.Selection;
    eff_sel.target       = pick.target;
    eff_sel.profile      = pick.profile;
    eff_sel.artifact     = pick.artifact;
    eff_sel.want_lib     = pick.want_lib;
    eff_sel.has_artifact = pick.has_artifact;
    if (for_union || is_test) {
        val psr: err[outcome.Fail] = manifest.select_primary_artifact(
            p.alloc, ?p.s.interner, m, ?eff_sel);
        if (sel psr.err) {
            ret psr;
        }
    }

    val ur: res[manifest.BuildUnit, outcome.Fail] = manifest.resolve_build_unit(p.alloc, ?p.s.interner, ?p.s.registry, m, eff_sel);
    if (sel ur.err) {
        ret err[outcome.Fail].err{ur.err};
    }
    val bu: manifest.BuildUnit = ur.ok;

    val lookup_r: opt[str] = intern.lookup(?p.s.interner, bu.profile_name);
    if (sel lookup_r.none) { ret err[outcome.Fail].err{outcome.internal("interned text is absent where the load config manifest expected it")}; }
    val cell_profile: str = lookup_r.some;
    p.config.art_reqs      = nil;
    p.config.art_req_count = 0;
    val rqr: err[outcome.Fail] = manifest.resolve_artifact_reqs(p.alloc, ?p.s.interner, ?p.s.registry, m,
        bu.artifact, bu.target, cell_profile, is_test, ?p.config.art_reqs, ?p.config.art_req_count);
    if (sel rqr.err) { ret err[outcome.Fail].err{rqr.err}; }

    var cell_v: manifest.TmplVars = manifest.tmpl_vars_with_reqs(?p.s.interner, bu.target,
        cell_profile, p.config.art_reqs, p.config.art_req_count);
    embed.set_path_env(?p.s.embeds, project_root, p.config.art_reqs, p.config.art_req_count);

    val cr: err[outcome.Fail] = manifest.check_collisions(p.alloc, ?p.s.interner, ?p.s.registry, m, ?cell_v);
    if (sel cr.err) {
        ret cr;
    }

    if (bu.warned) { emit_native_warning(p, bu.target_name); }

    val ter: res[*project.TargetEntry, A.Error] = A.allocate[project.TargetEntry](p.alloc, 1::usize);
    if (sel ter.err) { ret err[outcome.Fail].err{outcome.refused(ter.err)}; }
    val targets: *project.TargetEntry = ter.ok;
    var entry: project.TargetEntry;
    entry.name          = bu.target_name;
    entry.os_name       = bu.target.os;
    entry.isa_name      = bu.target.isa;
    entry.abi_name      = bu.target.abi;
    entry.of_name       = bu.target.of;
    entry.platform_name = bu.target.platform;
    entry.env_name      = bu.target.env;
    entry.base          = bu.target.base;
    entry.stack_reserve = bu.target.stack_reserve;
    entry.stack_commit  = bu.target.stack_commit;
    entry.entrypoint    = bu.entry;
    entry.mode          = project.MODE_EXECUTABLE;
    if (bu.is_lib) { entry.mode = project.MODE_LIBRARY; }
    entry.lib_kind      = bu.kind;
    entry.opt           = project.map_opt(bu.opt);
    entry.libs          = bu.libs;
    entry.lib_count     = bu.lib_count;
    targets[0] = entry;

    p.config.id           = m.id;
    p.config.version      = m.version;
    p.config.bin_name     = intern.STR_NIL;
    p.config.icon         = intern.STR_NIL;
    p.config.app_manifest = intern.STR_NIL;
    if (bu.artifact != nil) {
        p.config.bin_name     = bu.artifact.name;
        p.config.icon         = bu.artifact.icon;
        p.config.app_manifest = bu.artifact.app_manifest;
    }
    p.config.module       = bu.entry;
    p.config.dir_src      = m.src;
    val res_dep_id: res[intern.StrId, A.Error] = intern.intern(?p.s.interner, "dep");
    if (sel res_dep_id.ok) {
        p.config.dir_dep = res_dep_id.ok;
    }
    p.config.targets      = targets;
    p.config.target_count = 1;
    p.target_entry        = ?p.config.targets[0];
    p.config.profile      = bu.profile_name;
    p.config.step_order       = nil;
    p.config.step_order_count = 0;

    val lookup_r2: opt[str] = intern.lookup(?p.s.interner, m.out_tmpl);
    if (sel lookup_r2.none) { ret err[outcome.Fail].err{outcome.internal("interned text is absent where the load config manifest expected it")}; }
    val out_tmpl_s: str = lookup_r2.some;
    val res_project_out_str: res[str, outcome.Fail] = manifest.expand_project_path(p.alloc, out_tmpl_s, "", ?cell_v, "[project].out");
    if (sel res_project_out_str.err) { ret err[outcome.Fail].err{res_project_out_str.err}; }
    val project_out_str: str = res_project_out_str.ok;
    val res_po_id: res[intern.StrId, A.Error] = intern.intern(?p.s.interner, project_out_str);
    if (sel res_po_id.err) {
        str_free(p.alloc, project_out_str);
        ret err[outcome.Fail].err{outcome.refused(res_po_id.err)};
    }
    p.config.project_out = res_po_id.ok;

    val vr: err[outcome.Fail] = validate_local_links(p, project_root, m, bu.target, project_out_str, ?cell_v);
    if (sel vr.err) { str_free(p.alloc, project_out_str); ret vr; }

    val sor: err[outcome.Fail] = validate_step_outputs(p, m, project_out_str, ?cell_v);
    if (sel sor.err) { str_free(p.alloc, project_out_str); ret sor; }

    if (is_test) {
        var test_items: *manifest.LinkRequirement = nil;
        var test_count: u32 = 0;
        val tlr: err[outcome.Fail] = manifest.resolve_test_libs(p.alloc, ?p.s.interner, m, bu.target, project_out_str, ?cell_v, ?test_items, ?test_count);
        if (sel tlr.err) { str_free(p.alloc, project_out_str); ret tlr; }
        p.config.targets[0].libs      = test_items;
        p.config.targets[0].lib_count = test_count;
    }

    val spr: err[outcome.Fail] = compute_step_plan(p, m, ?bu, is_test, for_union, project_out_str, ?cell_v);
    if (sel spr.err) { str_free(p.alloc, project_out_str); ret spr; }
    str_free(p.alloc, project_out_str);

    p.config.steps      = nil;
    p.config.step_count = 0;
    if (m.step_count > 0) {
        val res_steps: res[*manifest.StepDef, A.Error] = A.allocate[manifest.StepDef](p.alloc, m.step_count::usize);
        if (sel res_steps.err) {
            ret err[outcome.Fail].err{outcome.refused(res_steps.err)};
        }
        val steps: *manifest.StepDef = res_steps.ok;
        var si: u32 = 0;
        for (si < m.step_count) {
            val clone_r: err[outcome.Fail] = clone_step(p.alloc, ?m.steps[si], ?steps[si]);
            if (sel clone_r.err) {
                var sj: u32 = 0;
                for (sj < si) { free_step_arrays(p.alloc, ?steps[sj]); sj = sj + 1; }
                A.deallocate[manifest.StepDef](p.alloc, steps, m.step_count::usize);
                ret clone_r;
            }
            si = si + 1;
        }
        p.config.steps      = steps;
        p.config.step_count = m.step_count;
    }

    val dr: err[outcome.Fail] = ddep.resolve_deps(p, m, project_root);
    if (sel dr.err) { ret err[outcome.Fail].err{dr.err}; }

    val isa_opt: opt[str] = intern.lookup(?p.s.interner, bu.target.isa);
    val os_opt: opt[str] = intern.lookup(?p.s.interner, bu.target.os);
    val abi_opt: opt[str] = intern.lookup(?p.s.interner, bu.target.abi);
    if (sel isa_opt.none) {
        ret err[outcome.Fail].err{outcome.user("internal: selected target tuple not interned")};
    }
    if (sel os_opt.none) {
        ret err[outcome.Fail].err{outcome.user("internal: selected target tuple not interned")};
    }
    if (sel abi_opt.none) {
        ret err[outcome.Fail].err{outcome.user("internal: selected target tuple not interned")};
    }
    val cr2: err[outcome.Fail] = ddep.resolve_cascade_libs(p,
        isa_opt.some, os_opt.some, abi_opt.some,
        p.target_entry.libs, p.target_entry.lib_count);
    if (sel cr2.err) { ret err[outcome.Fail].err{cr2.err}; }

    if (for_union) {
        val ut: err[fail.Fail] = union.populate_union_tuples(p, m);
        if (sel ut.err) { ret err[outcome.Fail].err{outcome.from_fail(ut.err)}; }
        val ue: err[fail.Fail] = union.populate_union_entries(p, m);
        if (sel ue.err) { ret err[outcome.Fail].err{outcome.from_fail(ue.err)}; }
    }

    ret err[outcome.Fail].ok{};
}

fun emit_native_warning(p: *project.Project, target_name: intern.StrId) {
    val tuple: str = manifest.host_tuple(p.alloc);
    val name_opt: opt[str] = intern.lookup(?p.s.interner, target_name);
    var name: str = "?";
    if (sel name_opt.some) { name = name_opt.some; }

    val res_msg: res[str, format.FormatError] = format.sprint(p.alloc, "no declared target matches the host ({}); building '{}'", tuple, name);
    if (sel res_msg.err) { str_free(p.alloc, tuple); ret; }
    val buf: str = res_msg.ok;

    var span: token.Span;
    span.offset = 0;
    span.len    = 0;
    diagnostic.record_warning(?p.diags, 0xFFFFFFFF::src.FileId, span, buf);

    str_free(p.alloc, buf);
    str_free(p.alloc, tuple);
}

fun local_link_error(alloc: *A.Allocator, name: str, path: str) str {
    val res_msg: res[str, format.FormatError] = format.sprint(alloc, "mach.toml: [link.{}] path '{}' matches no step output and does not exist on disk", name, path);
    if (sel res_msg.err) { ret "mach.toml: a local link path matches no step output and does not exist on disk"; }
    ret res_msg.ok;
}

fun module_obj_tree(a: *A.Allocator, proj_out: str, id: str) str {
    ret sfmt(a, "{}/obj/{}", proj_out, id);
}

val STEP_STAGE_DIR: str = ".mach-stage";
val STEP_STAMP_DIR: str = ".steps";

fun step_stage_tree(a: *A.Allocator, proj_out: str) str {
    ret sfmt(a, "{}/{}", proj_out, STEP_STAGE_DIR);
}

fun step_stamp_tree(a: *A.Allocator, proj_out: str) str {
    ret sfmt(a, "{}/{}", proj_out, STEP_STAMP_DIR);
}

fun path_in_module_obj_tree(path: str, tree: str) bool {
    if (str_equals(path, tree)) { ret true; }
    if (!str_starts_with(path, tree)) { ret false; }
    ret spath.is_separator(path[str_len(tree)]);
}

fun step_out_reserved_error(a: *A.Allocator, what: str, name: str, path: str, tree: str, owner_desc: str) str {
    val res_msg: res[str, format.FormatError] = format.sprint(a,
        "{} '{}' writes '{}' into '{}/', {}: the compiler owns that directory, so a step output there is overwritten by (or overwrites) compiler state. write it elsewhere under {{project.out}}",
        what, name, path, tree, owner_desc);
    if (sel res_msg.err) { ret "a build step writes into a directory the compiler owns"; }
    ret res_msg.ok;
}

rec DeclaredStepOutput {
    path: str;
    step: str;
}

fun declared_step_output_compare(a: *DeclaredStepOutput, b: *DeclaredStepOutput) i64 {
    val pc: i64 = str_compare(a.path, b.path);
    if (pc != 0) { ret pc; }
    ret str_compare(a.step, b.step);
}

fun declared_step_outputs_free(a: *A.Allocator, outputs: *Vector[DeclaredStepOutput]) {
    var i: usize = 0;
    for (i < outputs.len) {
        str_free(a, outputs.data[i].path);
        i = i + 1;
    }
    vector.dnit[DeclaredStepOutput](outputs);
}

fun validate_declared_step_output_collisions(a: *A.Allocator, outputs: *Vector[DeclaredStepOutput]) err[outcome.Fail] {
    sort.sort[DeclaredStepOutput](outputs.data, outputs.len, declared_step_output_compare);
    var i: usize = 0;
    for (i < outputs.len) {
        var j: usize = i + 1;
        for (j < outputs.len) {
            val left: *DeclaredStepOutput = ?outputs.data[i];
            val right: *DeclaredStepOutput = ?outputs.data[j];
            val exact: bool = str_equals(left.path, right.path);
            if (exact || path_in_module_obj_tree(right.path, left.path)) {
                if (exact && str_equals(left.step, right.step)) {
                    ret err[outcome.Fail].err{outcome.user(sfmt(a, "mach.toml: [step.{}] declares output '{}' more than once", left.step, left.path))};
                }
                ret err[outcome.Fail].err{outcome.user(sfmt(a, "mach.toml: [step.{}] output '{}' collides with [step.{}] output '{}'", left.step, left.path, right.step, right.path))};
            }
            j = j + 1;
        }
        i = i + 1;
    }
    ret err[outcome.Fail].ok{};
}

fun free_step_reserved_trees(a: *A.Allocator, tree: str, stage_tree: str, stamp_tree: str) {
    str_free(a, tree);
    str_free(a, stage_tree);
    str_free(a, stamp_tree);
}

fun validate_step_outputs(p: *project.Project, m: *manifest.Manifest, proj_out: str, v: *manifest.TmplVars) err[outcome.Fail] {
    if (m.step_count == 0) { ret err[outcome.Fail].ok{}; }

    val id_opt: opt[str] = intern.lookup(?p.s.interner, m.id);
    if (sel id_opt.none) { ret err[outcome.Fail].err{outcome.user("internal: project id not interned")}; }
    val tree: str = module_obj_tree(p.alloc, proj_out, id_opt.some);
    val stage_tree: str = step_stage_tree(p.alloc, proj_out);
    val stamp_tree: str = step_stamp_tree(p.alloc, proj_out);
    var outputs: Vector[DeclaredStepOutput] = vector.init[DeclaredStepOutput](p.alloc);

    var si: u32 = 0;
    for (si < m.step_count) {
        val step: *manifest.StepDef = ?m.steps[si];
        val name_opt: opt[str] = intern.lookup(?p.s.interner, step.name);
        if (sel name_opt.none) { declared_step_outputs_free(p.alloc, ?outputs); free_step_reserved_trees(p.alloc, tree, stage_tree, stamp_tree); ret err[outcome.Fail].err{outcome.user("internal: step name not interned")}; }
        val sname: str = name_opt.some;

        var oi: u32 = 0;
        for (oi < step.out_count) {
            val raw_opt: opt[str] = intern.lookup(?p.s.interner, step.out[oi]);
            if (sel raw_opt.none) { declared_step_outputs_free(p.alloc, ?outputs); free_step_reserved_trees(p.alloc, tree, stage_tree, stamp_tree); ret err[outcome.Fail].err{outcome.user("internal: step output not interned")}; }

            val exp_r: res[str, outcome.Fail] = manifest.expand_project_path(p.alloc, raw_opt.some, proj_out, v, "a build step output");
            if (sel exp_r.err) { declared_step_outputs_free(p.alloc, ?outputs); free_step_reserved_trees(p.alloc, tree, stage_tree, stamp_tree); ret err[outcome.Fail].err{exp_r.err}; }
            val exp: str = exp_r.ok;

            var reserved_tree: str = "";
            var reserved_desc: str = "";
            if (path_in_module_obj_tree(exp, tree))        { reserved_tree = tree;       reserved_desc = "the module object tree"; }
            or (path_in_module_obj_tree(exp, stage_tree))  { reserved_tree = stage_tree; reserved_desc = "the build step staging area"; }
            or (path_in_module_obj_tree(exp, stamp_tree))  { reserved_tree = stamp_tree; reserved_desc = "the build step cache directory"; }
            if (!str_empty(reserved_tree)) {
                val label: str = sfmt(p.alloc, "[step.{}]", sname);
                val msg: str = step_out_reserved_error(p.alloc, "mach.toml: declared output of", label, exp, reserved_tree, reserved_desc);
                str_free(p.alloc, label);
                str_free(p.alloc, exp);
                declared_step_outputs_free(p.alloc, ?outputs);
                free_step_reserved_trees(p.alloc, tree, stage_tree, stamp_tree);
                ret err[outcome.Fail].err{outcome.user(msg)};
            }
            val push_r: res[usize, A.Error] = vector.push[DeclaredStepOutput](?outputs, DeclaredStepOutput{path: exp, step: sname});
            if (sel push_r.err) {
                str_free(p.alloc, exp);
                declared_step_outputs_free(p.alloc, ?outputs);
                free_step_reserved_trees(p.alloc, tree, stage_tree, stamp_tree);
                ret err[outcome.Fail].err{outcome.refused(push_r.err)};
            }
            oi = oi + 1;
        }
        si = si + 1;
    }
    val collision_r: err[outcome.Fail] = validate_declared_step_output_collisions(p.alloc, ?outputs);
    declared_step_outputs_free(p.alloc, ?outputs);
    free_step_reserved_trees(p.alloc, tree, stage_tree, stamp_tree);
    if (sel collision_r.err) { ret err[outcome.Fail].err{collision_r.err}; }
    ret err[outcome.Fail].ok{};
}

fun compute_step_plan(p: *project.Project, m: *manifest.Manifest, bu: *manifest.BuildUnit,
                      is_test: bool, for_union: bool, proj_out: str, v: *manifest.TmplVars) err[outcome.Fail] {
    p.config.step_order       = nil;
    p.config.step_order_count = 0;
    if (m.step_count == 0) { ret err[outcome.Fail].ok{}; }

    var names:  *intern.StrId = nil;
    var ncount: u32           = 0;
    var owned:  bool          = false;
    if ((is_test || for_union) && m.artifact_count > 0) {
        val ar: res[*intern.StrId, A.Error] = A.allocate[intern.StrId](p.alloc, m.artifact_count::usize);
        if (sel ar.err) { ret err[outcome.Fail].err{outcome.refused(ar.err)}; }
        names = ar.ok;
        owned = true;
        var i: u32 = 0;
        for (i < m.artifact_count) { names[i] = m.artifacts[i].name; i = i + 1; }
        ncount = m.artifact_count;
    }
    or {
        if (bu.artifact == nil) { ret err[outcome.Fail].ok{}; }
        names  = ?bu.artifact.name;
        ncount = 1;
    }

    var order: *u32 = nil;
    var count: u32  = 0;
    val r: err[outcome.Fail] = manifest.plan_steps(p.alloc, ?p.s.interner, m, names, ncount, bu.target, proj_out, v, ?order, ?count);
    if (owned) { A.deallocate[intern.StrId](p.alloc, names, m.artifact_count::usize); }
    if (sel r.err) { ret err[outcome.Fail].err{r.err}; }
    p.config.step_order       = order;
    p.config.step_order_count = count;
    ret err[outcome.Fail].ok{};
}

fun validate_local_links(p: *project.Project, project_root: str, m: *manifest.Manifest, t: *manifest.TargetDef, proj_out: str, v: *manifest.TmplVars) err[outcome.Fail] {
    var li: u32 = 0;
    for (li < m.link_count) {
        val l: *manifest.LinkDef = ?m.links[li];
        if (l.source == manifest.LINK_LOCAL && manifest.link_matches_target(?p.s.interner, l, t)) {
            val path_opt: opt[str] = intern.lookup(?p.s.interner, l.path);
            val name_opt: opt[str] = intern.lookup(?p.s.interner, l.name);
            if (sel path_opt.none) { ret err[outcome.Fail].err{outcome.user("internal: link entry metadata not interned")}; }
            if (sel name_opt.none) { ret err[outcome.Fail].err{outcome.user("internal: link entry metadata not interned")}; }
            val raw_path: str = path_opt.some;
            val ename:    str = name_opt.some;

            val exp_r: res[str, outcome.Fail] = manifest.expand_project_path(p.alloc, raw_path, proj_out, v, "a local link path");
            if (sel exp_r.err) { ret err[outcome.Fail].err{exp_r.err}; }
            val exp: str = exp_r.ok;

            var ok_: bool = manifest.local_path_demanded_by_step(p.alloc, ?p.s.interner, m, exp, proj_out, v);
            if (!ok_) {
                val abs_r: res[str, fail.Fail] = load.join_path(p.alloc, project_root, exp);
                if (sel abs_r.ok) {
                    val abs: str = abs_r.ok;
                    val exists_r: res[bool, io_error.Error] = fs.exists(abs);
                    ok_ = (sel exists_r.ok && exists_r.ok);
                    str_free(p.alloc, abs);
                }
            }
            if (!ok_) {
                val msg: str = local_link_error(p.alloc, ename, exp);
                str_free(p.alloc, exp);
                ret err[outcome.Fail].err{outcome.user(msg)};
            }
            str_free(p.alloc, exp);
        }
        li = li + 1;
    }
    ret err[outcome.Fail].ok{};
}

pub fun select_target(p: *project.Project, t: *project.TargetEntry) err[outcome.Fail] {
    val os_opt: opt[str] = intern.lookup(?p.s.interner, t.os_name);
    if (sel os_opt.none) { ret err[outcome.Fail].err{outcome.user("target os name not interned")}; }
    val os_name: str = os_opt.some;

    val isa_opt: opt[str] = intern.lookup(?p.s.interner, t.isa_name);
    if (sel isa_opt.none) { ret err[outcome.Fail].err{outcome.user("target isa name not interned")}; }
    val isa_name: str = isa_opt.some;

    val abi_opt: opt[str] = intern.lookup(?p.s.interner, t.abi_name);
    if (sel abi_opt.none) { ret err[outcome.Fail].err{outcome.user("target abi name not interned")}; }
    val abi_name: str = abi_opt.some;

    var of_name: str = "";
    val of_opt: opt[str] = intern.lookup(?p.s.interner, t.of_name);
    if (sel of_opt.some) { of_name = of_opt.some; }

    var req: target.TargetRequest = target.target_request(isa_name, os_name, abi_name);
    target.with_of(?req, of_name);
    target.with_image(?req, t.base, t.stack_reserve, t.stack_commit);
    var env_name: str = "";
    val env_opt: opt[str] = intern.lookup(?p.s.interner, t.env_name);
    if (sel env_opt.some) { env_name = env_opt.some; }
    var label: str = "";
    val label_opt: opt[str] = intern.lookup(?p.s.interner, t.name);
    if (sel label_opt.some) { label = label_opt.some; }
    target.with_env(?req, env_name, label);
    val tr: res[target.Target, fail.Fail] = target.resolve(?p.s.registry, ?req);
    if (sel tr.err) { ret err[outcome.Fail].err{outcome.user_fail(tr.err)}; }
    p.target = tr.ok;

    val rcn: res[intern.StrId, A.Error] = intern.intern(?p.s.interner, "mach");
    if (sel rcn.err) { ret err[outcome.Fail].err{outcome.refused(rcn.err)}; }
    p.compiler_name = rcn.ok;

    val rcv: res[intern.StrId, A.Error] = intern.intern(?p.s.interner, load.MACH_VERSION);
    if (sel rcv.err) { ret err[outcome.Fail].err{outcome.refused(rcv.err)}; }
    p.compiler_ver = rcv.ok;

    ret err[outcome.Fail].ok{};
}

fun sfmt(alloc: *A.Allocator, fmt: str, va: ...) str {
    val r: res[str, format.FormatError] = format.sprint(alloc, fmt, va...);
    if (sel r.err) { ret ""; }
    ret r.ok;
}

fun cmp_str(a: *str, b: *str) i64 {
    ret str_compare(@a, @b);
}

pub fun wildcard_match(pat: str, name: str) bool {
    val pn: usize = str_len(pat);
    val nn: usize = str_len(name);
    var pi: usize = 0;
    var ni: usize = 0;
    var star: i64 = -1;
    var mark: usize = 0;
    for (ni < nn) {
        if (pi < pn && pat[pi] == '*'::u8) { star = pi::i64; mark = ni; pi = pi + 1; }
        or (pi < pn && pat[pi] == name[ni]) { pi = pi + 1; ni = ni + 1; }
        or (star >= 0) { pi = (star::usize) + 1; mark = mark + 1; ni = mark; }
        or { ret false; }
    }
    for (pi < pn && pat[pi] == '*'::u8) { pi = pi + 1; }
    ret pi == pn;
}

val PHYSICAL_REGULAR: u8 = 1;
val PHYSICAL_DIRECTORY: u8 = 2;
val PHYSICAL_ENTRY: u8 = 3;

fun physical_mode_valid(mode: u32, expected: u8) bool {
    val kind: u32 = mode & sysos.S_IFMT;
    if (expected == PHYSICAL_REGULAR) { ret kind == sysos.S_IFREG; }
    if (expected == PHYSICAL_DIRECTORY) { ret kind == sysos.S_IFDIR; }
    ret kind == sysos.S_IFREG || kind == sysos.S_IFDIR;
}

fun validate_physical_path_windows(alloc: *A.Allocator, root: str, rel: str, expected: u8, label: str) err[outcome.Fail] {
    val n: usize = str_len(rel);
    if (str_equals(rel, ".")) {
        val root_meta_r: res[fs.Metadata, io_error.Error] = fs.metadata_link(root);
        if (sel root_meta_r.err) { ret err[outcome.Fail].err{outcome.user(sfmt(alloc, "{} '{}' does not exist or cannot be inspected: {}", label, rel, outcome.io_text(root_meta_r.err)))}; }
        val root_meta: fs.Metadata = root_meta_r.ok;
        if (fs.meta_is_symlink(?root_meta)) { ret err[outcome.Fail].err{outcome.user(sfmt(alloc, "{} '{}' cannot traverse symlink component '{}'", label, rel, rel))}; }
        if (expected == PHYSICAL_REGULAR || !fs.meta_is_dir(?root_meta)) { ret err[outcome.Fail].err{outcome.user(sfmt(alloc, "{} '{}' has the wrong filesystem entry type", label, rel))}; }
        ret err[outcome.Fail].ok{};
    }
    var start: usize = 0;
    for (start < n) {
        var end: usize = start;
        for (end < n && rel[end] != '/'::u8) { end = end + 1; }
        if (end == start) { ret err[outcome.Fail].err{outcome.user(sfmt(alloc, "{} '{}' is not a canonical project path", label, rel))}; }
        val prefix_r: res[str, string.StrError] = str_copy_slice(alloc, rel, 0, end);
        if (sel prefix_r.err) { ret err[outcome.Fail].err{outcome.user(outcome.str_text(prefix_r.err))}; }
        val prefix: str = prefix_r.ok;
        val abs_r: res[str, A.Error] = spath.resolve(alloc, root, prefix);
        if (sel abs_r.err) { str_free(alloc, prefix); ret err[outcome.Fail].err{outcome.refused(abs_r.err)}; }
        val abs: str = abs_r.ok;
        val meta_r: res[fs.Metadata, io_error.Error] = fs.metadata_link(abs);
        str_free(alloc, abs);
        if (sel meta_r.err) {
            val msg: str = sfmt(alloc, "{} '{}' does not exist or cannot be inspected at '{}': {}", label, rel, prefix, outcome.io_text(meta_r.err));
            str_free(alloc, prefix);
            ret err[outcome.Fail].err{outcome.user(msg)};
        }
        val meta: fs.Metadata = meta_r.ok;
        if (fs.meta_is_symlink(?meta)) {
            val msg: str = sfmt(alloc, "{} '{}' cannot traverse symlink component '{}'", label, rel, prefix);
            str_free(alloc, prefix);
            ret err[outcome.Fail].err{outcome.user(msg)};
        }
        val last: bool = end == n;
        if ((!last && !fs.meta_is_dir(?meta)) || (last && expected == PHYSICAL_REGULAR && !fs.meta_is_file(?meta)) || (last && expected == PHYSICAL_DIRECTORY && !fs.meta_is_dir(?meta)) || (last && expected == PHYSICAL_ENTRY && !fs.meta_is_file(?meta) && !fs.meta_is_dir(?meta))) {
            val msg: str = sfmt(alloc, "{} '{}' has the wrong filesystem entry type at '{}'", label, rel, prefix);
            str_free(alloc, prefix);
            ret err[outcome.Fail].err{outcome.user(msg)};
        }
        str_free(alloc, prefix);
        start = end + 1;
    }
    ret err[outcome.Fail].ok{};
}

fun validate_physical_path(alloc: *A.Allocator, root: str, rel: str, expected: u8, label: str) err[outcome.Fail] {
    $if ($mach.build.os == $mach.os.windows) {
        ret validate_physical_path_windows(alloc, root, rel, expected, label);
    }
    $or {
        val root_fd_raw: i64 = sysos.open(sysos.AT_FDCWD, root, sysos.O_RDONLY | sysos.O_DIRECTORY, 0);
        if (root_fd_raw < 0) { ret err[outcome.Fail].err{outcome.user(sfmt(alloc, "{} root '{}' cannot be opened: {}", label, root, sysos.message(root_fd_raw)))}; }
        var fd: i32 = root_fd_raw::i32;
        if (str_equals(rel, ".")) {
            val close_r: i64 = sysos.close(fd);
            if (expected == PHYSICAL_REGULAR) { ret err[outcome.Fail].err{outcome.user(sfmt(alloc, "{} '{}' has the wrong filesystem entry type", label, rel))}; }
            if (close_r < 0) { ret err[outcome.Fail].err{outcome.user(sysos.message(close_r))}; }
            ret err[outcome.Fail].ok{};
        }
        val n: usize = str_len(rel);
        var start: usize = 0;
        for (start < n) {
            var end: usize = start;
            for (end < n && rel[end] != '/'::u8) { end = end + 1; }
            if (end == start) {
                sysos.close(fd);
                ret err[outcome.Fail].err{outcome.user(sfmt(alloc, "{} '{}' is not a canonical project path", label, rel))};
            }
            val component_r: res[str, string.StrError] = str_copy_slice(alloc, rel, start, end - start);
            if (sel component_r.err) { sysos.close(fd); ret err[outcome.Fail].err{outcome.user(outcome.str_text(component_r.err))}; }
            val component: str = component_r.ok;
            var st: sysos.stat_t;
            val stat_r: i64 = sysos.stat_path(fd, component, ?st, sysos.AT_SYMLINK_NOFOLLOW);
            if (stat_r < 0) {
                val msg: str = sfmt(alloc, "{} '{}' does not exist or cannot be inspected at '{}': {}", label, rel, component, sysos.message(stat_r));
                str_free(alloc, component);
                sysos.close(fd);
                ret err[outcome.Fail].err{outcome.user(msg)};
            }
            val mode: u32 = sysos.stat_mode(?st);
            val last: bool = end == n;
            if ((mode & sysos.S_IFMT) == sysos.S_IFLNK) {
                val msg: str = sfmt(alloc, "{} '{}' cannot traverse symlink component '{}'", label, rel, component);
                str_free(alloc, component);
                sysos.close(fd);
                ret err[outcome.Fail].err{outcome.user(msg)};
            }
            if (last) {
                if (!physical_mode_valid(mode, expected)) {
                    val msg: str = sfmt(alloc, "{} '{}' has the wrong filesystem entry type at '{}'", label, rel, component);
                    str_free(alloc, component);
                    sysos.close(fd);
                    ret err[outcome.Fail].err{outcome.user(msg)};
                }
                str_free(alloc, component);
                val close_r: i64 = sysos.close(fd);
                if (close_r < 0) { ret err[outcome.Fail].err{outcome.user(sysos.message(close_r))}; }
                ret err[outcome.Fail].ok{};
            }
            if ((mode & sysos.S_IFMT) != sysos.S_IFDIR) {
                val msg: str = sfmt(alloc, "{} '{}' has non-directory intermediate component '{}'", label, rel, component);
                str_free(alloc, component);
                sysos.close(fd);
                ret err[outcome.Fail].err{outcome.user(msg)};
            }
            val next_fd_raw: i64 = sysos.open(fd, component, sysos.O_RDONLY | sysos.O_DIRECTORY, 0);
            str_free(alloc, component);
            if (next_fd_raw < 0) {
                val msg: str = sfmt(alloc, "{} '{}' cannot open an intermediate directory: {}", label, rel, sysos.message(next_fd_raw));
                sysos.close(fd);
                ret err[outcome.Fail].err{outcome.user(msg)};
            }
            val next_fd: i32 = next_fd_raw::i32;
            var next_st: sysos.stat_t;
            val next_stat_r: i64 = sysos.stat(next_fd, ?next_st);
            if (next_stat_r < 0 || (sysos.stat_mode(?next_st) & sysos.S_IFMT) != sysos.S_IFDIR) {
                sysos.close(next_fd);
                sysos.close(fd);
                ret err[outcome.Fail].err{outcome.user(sfmt(alloc, "{} '{}' opened an invalid intermediate directory", label, rel))};
            }
            val close_r: i64 = sysos.close(fd);
            if (close_r < 0) {
                sysos.close(next_fd);
                ret err[outcome.Fail].err{outcome.user(sysos.message(close_r))};
            }
            fd = next_fd;
            start = end + 1;
        }
        sysos.close(fd);
        ret err[outcome.Fail].err{outcome.user(sfmt(alloc, "{} '{}' is empty", label, rel))};
    }
}

fun validate_contained_ancestors_windows(alloc: *A.Allocator, root: str, rel: str, label: str) err[outcome.Fail] {
    val n: usize = str_len(rel);
    var start: usize = 0;
    for (start < n) {
        var end: usize = start;
        for (end < n && rel[end] != '/'::u8) { end = end + 1; }
        if (end == start) { ret err[outcome.Fail].err{outcome.user(sfmt(alloc, "{} '{}' is not a canonical project path", label, rel))}; }
        val prefix_r: res[str, string.StrError] = str_copy_slice(alloc, rel, 0, end);
        if (sel prefix_r.err) { ret err[outcome.Fail].err{outcome.user(outcome.str_text(prefix_r.err))}; }
        val prefix: str = prefix_r.ok;
        val abs_r: res[str, A.Error] = spath.resolve(alloc, root, prefix);
        if (sel abs_r.err) { str_free(alloc, prefix); ret err[outcome.Fail].err{outcome.refused(abs_r.err)}; }
        val abs: str = abs_r.ok;
        val meta_r: res[fs.Metadata, io_error.Error] = fs.metadata_link(abs);
        str_free(alloc, abs);
        if (sel meta_r.err) {
            str_free(alloc, prefix);
            ret err[outcome.Fail].ok{};
        }
        val meta: fs.Metadata = meta_r.ok;
        if (fs.meta_is_symlink(?meta) || !fs.meta_is_dir(?meta)) {
            val msg: str = sfmt(alloc, "{} '{}' cannot traverse non-directory ancestor '{}'", label, rel, prefix);
            str_free(alloc, prefix);
            ret err[outcome.Fail].err{outcome.user(msg)};
        }
        str_free(alloc, prefix);
        start = end + 1;
    }
    ret err[outcome.Fail].ok{};
}

pub fun validate_contained_ancestors(alloc: *A.Allocator, root: str, rel: str, label: str) err[outcome.Fail] {
    if (str_empty(rel)) { ret err[outcome.Fail].ok{}; }
    $if ($mach.build.os == $mach.os.windows) {
        ret validate_contained_ancestors_windows(alloc, root, rel, label);
    }
    $or {
        val root_fd_raw: i64 = sysos.open(sysos.AT_FDCWD, root, sysos.O_RDONLY | sysos.O_DIRECTORY, 0);
        if (root_fd_raw < 0) { ret err[outcome.Fail].err{outcome.user(sfmt(alloc, "{} root '{}' cannot be opened: {}", label, root, sysos.message(root_fd_raw)))}; }
        var fd: i32 = root_fd_raw::i32;
        val n: usize = str_len(rel);
        var start: usize = 0;
        for (start < n) {
            var end: usize = start;
            for (end < n && rel[end] != '/'::u8) { end = end + 1; }
            if (end == start) { sysos.close(fd); ret err[outcome.Fail].err{outcome.user(sfmt(alloc, "{} '{}' is not a canonical project path", label, rel))}; }
            val component_r: res[str, string.StrError] = str_copy_slice(alloc, rel, start, end - start);
            if (sel component_r.err) { sysos.close(fd); ret err[outcome.Fail].err{outcome.user(outcome.str_text(component_r.err))}; }
            val component: str = component_r.ok;
            var st: sysos.stat_t;
            val stat_r: i64 = sysos.stat_path(fd, component, ?st, sysos.AT_SYMLINK_NOFOLLOW);
            if (stat_r < 0) {
                str_free(alloc, component);
                sysos.close(fd);
                if (stat_r == sysos.ENOENT) { ret err[outcome.Fail].ok{}; }
                ret err[outcome.Fail].err{outcome.user(sfmt(alloc, "{} '{}' cannot inspect ancestor '{}': {}", label, rel, component, sysos.message(stat_r)))};
            }
            val mode: u32 = sysos.stat_mode(?st);
            if ((mode & sysos.S_IFMT) != sysos.S_IFDIR) {
                val msg: str = sfmt(alloc, "{} '{}' cannot traverse non-directory ancestor '{}'", label, rel, component);
                str_free(alloc, component);
                sysos.close(fd);
                ret err[outcome.Fail].err{outcome.user(msg)};
            }
            val next_fd_raw: i64 = sysos.open(fd, component, sysos.O_RDONLY | sysos.O_DIRECTORY, 0);
            str_free(alloc, component);
            if (next_fd_raw < 0) {
                val msg: str = sfmt(alloc, "{} '{}' cannot open ancestor '{}': {}", label, rel, sysos.message(next_fd_raw));
                sysos.close(fd);
                ret err[outcome.Fail].err{outcome.user(msg)};
            }
            val close_r: i64 = sysos.close(fd);
            if (close_r < 0) { sysos.close(next_fd_raw::i32); ret err[outcome.Fail].err{outcome.user(sysos.message(close_r))}; }
            fd = next_fd_raw::i32;
            start = end + 1;
        }
        sysos.close(fd);
        ret err[outcome.Fail].ok{};
    }
}

test "mach.lang.driver.config.validate_contained_ancestors:missing_real_and_escaping" {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }

    val tf_r: res[fs.TempFile, fs.FsError] = fs.temp_create(?alloc, "mach_contained_ancestors");
    if (sel tf_r.err) { ret 1; }
    var tf: fs.TempFile = tf_r.ok;
    val root_r: res[str, A.Error] = str_dup(?alloc, fs.temp_path(?tf));
    fs.temp_close_and_remove(?tf);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    val create_dir_r: err[io_error.Error] = fs.create_dir(root, 0o700);
    if (sel create_dir_r.err) { str_free(?alloc, root); ret 1; }

    var bad: bool = false;

    val missing_r: err[outcome.Fail] = validate_contained_ancestors(?alloc, root, "never/created", "clean target");
    if (sel missing_r.err) { bad = true; }

    val out_dir: str = sfmt(?alloc, "{}/out", root);
    val out_x_dir: str = sfmt(?alloc, "{}/out/x", root);
    val create_dir_r3: err[io_error.Error] = fs.create_dir(out_dir, 0o700);
    val create_dir_r2: err[io_error.Error] = fs.create_dir(out_x_dir, 0o700);
    if (sel create_dir_r3.err || sel create_dir_r2.err) { bad = true; }
    val one_level_r: err[outcome.Fail] = validate_contained_ancestors(?alloc, root, "out", "clean target");
    if (sel one_level_r.err) { bad = true; }
    val two_level_r: err[outcome.Fail] = validate_contained_ancestors(?alloc, root, "out/x", "clean target");
    if (sel two_level_r.err) { bad = true; }

    val outside: str = sfmt(?alloc, "{}/outside", root);
    val escape: str = sfmt(?alloc, "{}/escape", root);
    val create_dir_r4: err[io_error.Error] = fs.create_dir(outside, 0o700);
    val symlink_r: err[io_error.Error] = fs.symlink(outside, escape);
    if (sel create_dir_r4.ok) {
        if (sel symlink_r.ok) {
            val escape_r: err[outcome.Fail] = validate_contained_ancestors(?alloc, root, "escape/x", "clean target");
            if (!(sel escape_r.err && cfg_contains(outcome.describe(escape_r.err), "non-directory ancestor"))) { bad = true; }
    }
        if (sel symlink_r.err) { bad = true; }
    }
    if (sel create_dir_r4.err) { bad = true; }

    val real_mid: str = sfmt(?alloc, "{}/real_mid", root);
    val jump_mid: str = sfmt(?alloc, "{}/out/jump_mid", root);
    val create_dir_r5: err[io_error.Error] = fs.create_dir(real_mid, 0o700);
    val symlink_r2: err[io_error.Error] = fs.symlink(real_mid, jump_mid);
    if (sel create_dir_r5.ok) {
        if (sel symlink_r2.ok) {
            val mid_r: err[outcome.Fail] = validate_contained_ancestors(?alloc, root, "out/jump_mid/y/z", "clean target");
            if (!(sel mid_r.err && cfg_contains(outcome.describe(mid_r.err), "non-directory ancestor"))) { bad = true; }
    }
        if (sel symlink_r2.err) { bad = true; }
    }
    if (sel create_dir_r5.err) { bad = true; }

    str_free(?alloc, jump_mid);
    str_free(?alloc, real_mid);
    str_free(?alloc, escape);
    str_free(?alloc, outside);
    str_free(?alloc, out_x_dir);
    str_free(?alloc, out_dir);
    fs.remove_all(?alloc, root);
    str_free(?alloc, root);
    if (bad) { ret 1; }
    ret 0;
}

fun ensure_physical_directory_path_windows(alloc: *A.Allocator, root: str, rel: str, label: str) err[outcome.Fail] {
    if (str_equals(rel, ".")) { ret validate_physical_path_windows(alloc, root, rel, PHYSICAL_DIRECTORY, label); }
    val n: usize = str_len(rel);
    var start: usize = 0;
    for (start < n) {
        var end: usize = start;
        for (end < n && rel[end] != '/'::u8) { end = end + 1; }
        val prefix_r: res[str, string.StrError] = str_copy_slice(alloc, rel, 0, end);
        if (sel prefix_r.err) { ret err[outcome.Fail].err{outcome.user(outcome.str_text(prefix_r.err))}; }
        val prefix: str = prefix_r.ok;
        val abs_r: res[str, A.Error] = spath.resolve(alloc, root, prefix);
        if (sel abs_r.err) { str_free(alloc, prefix); ret err[outcome.Fail].err{outcome.refused(abs_r.err)}; }
        val abs: str = abs_r.ok;
        val first_r: res[fs.Metadata, io_error.Error] = fs.metadata_link(abs);
        val absent: bool = sel first_r.err;
        if (absent) {
            val make_r: err[io_error.Error] = fs.create_dir(abs, 0o755);
            if (sel make_r.err) {
                val msg: str = sfmt(alloc, "{} '{}' cannot create directory '{}': {}", label, rel, prefix, outcome.io_text(make_r.err));
                str_free(alloc, abs);
                str_free(alloc, prefix);
                ret err[outcome.Fail].err{outcome.user(msg)};
            }
        }
        var meta_r: res[fs.Metadata, io_error.Error] = first_r;
        if (absent) { meta_r = fs.metadata_link(abs); }
        str_free(alloc, abs);
        if (sel meta_r.err) {
            val msg: str = sfmt(alloc, "{} '{}' cannot inspect directory '{}': {}", label, rel, prefix, outcome.io_text(meta_r.err));
            str_free(alloc, prefix);
            ret err[outcome.Fail].err{outcome.user(msg)};
        }
        val meta: fs.Metadata = meta_r.ok;
        if (fs.meta_is_symlink(?meta) || !fs.meta_is_dir(?meta)) {
            val msg: str = sfmt(alloc, "{} '{}' cannot use non-directory or symlink component '{}'", label, rel, prefix);
            str_free(alloc, prefix);
            ret err[outcome.Fail].err{outcome.user(msg)};
        }
        str_free(alloc, prefix);
        start = end + 1;
    }
    ret err[outcome.Fail].ok{};
}

fun ensure_physical_directory_path(alloc: *A.Allocator, root: str, rel: str, label: str) err[outcome.Fail] {
    $if ($mach.build.os == $mach.os.windows) {
        ret ensure_physical_directory_path_windows(alloc, root, rel, label);
    }
    $or {
        val root_fd_raw: i64 = sysos.open(sysos.AT_FDCWD, root, sysos.O_RDONLY | sysos.O_DIRECTORY, 0);
        if (root_fd_raw < 0) { ret err[outcome.Fail].err{outcome.user(sfmt(alloc, "{} root '{}' cannot be opened: {}", label, root, sysos.message(root_fd_raw)))}; }
        var fd: i32 = root_fd_raw::i32;
        if (str_equals(rel, ".")) {
            val close_r: i64 = sysos.close(fd);
            if (close_r < 0) { ret err[outcome.Fail].err{outcome.user(sysos.message(close_r))}; }
            ret err[outcome.Fail].ok{};
        }
        val n: usize = str_len(rel);
        var start: usize = 0;
        for (start < n) {
            var end: usize = start;
            for (end < n && rel[end] != '/'::u8) { end = end + 1; }
            if (end == start) { sysos.close(fd); ret err[outcome.Fail].err{outcome.user(sfmt(alloc, "{} '{}' is not a canonical project path", label, rel))}; }
            val component_r: res[str, string.StrError] = str_copy_slice(alloc, rel, start, end - start);
            if (sel component_r.err) { sysos.close(fd); ret err[outcome.Fail].err{outcome.user(outcome.str_text(component_r.err))}; }
            val component: str = component_r.ok;
            var st: sysos.stat_t;
            var stat_r: i64 = sysos.stat_path(fd, component, ?st, sysos.AT_SYMLINK_NOFOLLOW);
            if (stat_r == sysos.ENOENT) {
                val make_r: i64 = sysos.make_dir(fd, component, 0o755);
                if (make_r < 0 && make_r != sysos.EEXIST) {
                    val msg: str = sfmt(alloc, "{} '{}' cannot create directory '{}': {}", label, rel, component, sysos.message(make_r));
                    str_free(alloc, component);
                    sysos.close(fd);
                    ret err[outcome.Fail].err{outcome.user(msg)};
                }
                stat_r = sysos.stat_path(fd, component, ?st, sysos.AT_SYMLINK_NOFOLLOW);
            }
            if (stat_r < 0) {
                val msg: str = sfmt(alloc, "{} '{}' cannot inspect directory '{}': {}", label, rel, component, sysos.message(stat_r));
                str_free(alloc, component);
                sysos.close(fd);
                ret err[outcome.Fail].err{outcome.user(msg)};
            }
            val mode: u32 = sysos.stat_mode(?st);
            if ((mode & sysos.S_IFMT) == sysos.S_IFLNK || (mode & sysos.S_IFMT) != sysos.S_IFDIR) {
                val msg: str = sfmt(alloc, "{} '{}' cannot use non-directory or symlink component '{}'", label, rel, component);
                str_free(alloc, component);
                sysos.close(fd);
                ret err[outcome.Fail].err{outcome.user(msg)};
            }
            val next_fd_raw: i64 = sysos.open(fd, component, sysos.O_RDONLY | sysos.O_DIRECTORY, 0);
            str_free(alloc, component);
            if (next_fd_raw < 0) {
                val msg: str = sfmt(alloc, "{} '{}' cannot open a directory component: {}", label, rel, sysos.message(next_fd_raw));
                sysos.close(fd);
                ret err[outcome.Fail].err{outcome.user(msg)};
            }
            val next_fd: i32 = next_fd_raw::i32;
            var next_st: sysos.stat_t;
            val next_stat_r: i64 = sysos.stat(next_fd, ?next_st);
            if (next_stat_r < 0 || (sysos.stat_mode(?next_st) & sysos.S_IFMT) != sysos.S_IFDIR) {
                sysos.close(next_fd);
                sysos.close(fd);
                ret err[outcome.Fail].err{outcome.user(sfmt(alloc, "{} '{}' opened an invalid directory component", label, rel))};
            }
            val close_r: i64 = sysos.close(fd);
            if (close_r < 0) {
                sysos.close(next_fd);
                ret err[outcome.Fail].err{outcome.user(sysos.message(close_r))};
            }
            fd = next_fd;
            start = end + 1;
        }
        val close_r: i64 = sysos.close(fd);
        if (close_r < 0) { ret err[outcome.Fail].err{outcome.user(sysos.message(close_r))}; }
        ret err[outcome.Fail].ok{};
    }
}

fun glob_visit(alloc: *A.Allocator, root: str, base_rel: str, name: str, pat: str, recursive: bool, out: *vector.Vector[str]) err[outcome.Fail] {
    val child_rel_r: res[str, fail.Fail] = load.join_path(alloc, base_rel, name);
    if (sel child_rel_r.err) { ret err[outcome.Fail].err{outcome.from_fail(child_rel_r.err)}; }
    val child_rel: str = child_rel_r.ok;

    val child_abs_r: res[str, A.Error] = spath.resolve(alloc, root, child_rel);
    if (sel child_abs_r.err) { str_free(alloc, child_rel); ret err[outcome.Fail].err{outcome.refused(child_abs_r.err)}; }
    val child_abs: str = child_abs_r.ok;
    val fi_r: res[fs.Metadata, io_error.Error] = fs.metadata_link(child_abs);
    str_free(alloc, child_abs);
    if (sel fi_r.err) {
        val msg: str = sfmt(alloc, "failed to inspect build step glob entry '{}': {}", child_rel, outcome.io_text(fi_r.err));
        str_free(alloc, child_rel);
        ret err[outcome.Fail].err{outcome.user(msg)};
    }
    val fi: fs.Metadata = fi_r.ok;

    if (fs.meta_is_symlink(?fi)) {
        val msg: str = sfmt(alloc, "build step input glob cannot traverse symlink '{}'", child_rel);
        str_free(alloc, child_rel);
        ret err[outcome.Fail].err{outcome.user(msg)};
    }

    if (fs.meta_is_dir(?fi) && recursive && name[0] == '.'::u8) {
        str_free(alloc, child_rel);
        ret err[outcome.Fail].ok{};
    }
    or (fs.meta_is_dir(?fi) && recursive) {
        val rr: err[outcome.Fail] = glob_walk(alloc, root, child_rel, pat, recursive, out);
        str_free(alloc, child_rel);
        ret rr;
    }
    or (fs.meta_is_file(?fi) && name[0] == '.'::u8 && !(str_len(pat) > 0 && pat[0] == '.'::u8)) {
        str_free(alloc, child_rel);
        ret err[outcome.Fail].ok{};
    }
    or (fs.meta_is_file(?fi) && wildcard_match(pat, name)) {
        val pr: res[usize, A.Error] = vector.push[str](out, child_rel);
        if (sel pr.err) { str_free(alloc, child_rel); ret err[outcome.Fail].err{outcome.refused(pr.err)}; }
        ret err[outcome.Fail].ok{};
    }
    or (!fs.meta_is_dir(?fi) && !fs.meta_is_file(?fi)) {
        val msg: str = sfmt(alloc, "build step input glob cannot use special entry '{}'", child_rel);
        str_free(alloc, child_rel);
        ret err[outcome.Fail].err{outcome.user(msg)};
    }
    str_free(alloc, child_rel);
    ret err[outcome.Fail].ok{};
}

fun glob_dot_entry(name: *u8) bool {
    if (name[0] != '.'::u8) { ret false; }
    if (name[1] == 0) { ret true; }
    ret name[1] == '.'::u8 && name[2] == 0;
}

fun glob_walk(alloc: *A.Allocator, root: str, base_rel: str, pat: str, recursive: bool, out: *vector.Vector[str]) err[outcome.Fail] {
    val physical_r: err[outcome.Fail] = validate_physical_path(alloc, root, base_rel, PHYSICAL_DIRECTORY, "build step input glob directory");
    if (sel physical_r.err) { ret err[outcome.Fail].err{physical_r.err}; }
    val dir_abs_r: res[str, A.Error] = spath.resolve(alloc, root, base_rel);
    if (sel dir_abs_r.err) { ret err[outcome.Fail].err{outcome.refused(dir_abs_r.err)}; }
    val dir_abs: str = dir_abs_r.ok;

    val fd_raw: i64 = sysos.open(sysos.AT_FDCWD, dir_abs, sysos.O_RDONLY | sysos.O_DIRECTORY, 0);
    if (fd_raw < 0) {
        val msg: str = sfmt(alloc, "failed to open build step glob directory '{}': {}", dir_abs, sysos.message(fd_raw));
        str_free(alloc, dir_abs);
        ret err[outcome.Fail].err{outcome.user(msg)};
    }
    str_free(alloc, dir_abs);
    val fd: i32 = fd_raw::i32;

    var cursor: sysos.DirectoryCursor = sysos.DirectoryCursor{};
    val opened: sysos.DirectoryInitResult = sysos.directory_init(?cursor, fd);
    if (opened.code < 0) {
        sysos.close(fd);
        ret err[outcome.Fail].err{outcome.user(sysos.message(opened.code))};
    }
    var result: err[outcome.Fail] = err[outcome.Fail].ok{};
    var reading: bool = true;
    for (reading) {
        var entry: sysos.DirectoryEntry;
        val nread: i64 = sysos.directory_next(?cursor, ?entry);
        if (nread < 0)  { result = err[outcome.Fail].err{outcome.user(sysos.message(nread))}; reading = false; }
        or (nread == 0) { reading = false; }
        or (!glob_dot_entry(entry.name::*u8)) {
            val rr: err[outcome.Fail] = glob_visit(alloc, root, base_rel, entry.name, pat, recursive, out);
            if (sel rr.err) { result = rr; reading = false; }
        }
    }
    val cursor_r: i64 = sysos.directory_close(?cursor);
    val result_ok: bool = sel result.ok && cursor_r < 0;
    if (result_ok) {
        result = err[outcome.Fail].err{outcome.user(sysos.message(cursor_r))};
    }
    val close_r: i64 = sysos.close(fd);
    val result_ok2: bool = sel result.ok && close_r < 0;
    if (result_ok2) {
        result = err[outcome.Fail].err{outcome.user(sysos.message(close_r))};
    }
    ret result;
}

pub fun glob_shape_ok(pattern: str) bool {
    val n: usize = str_len(pattern);
    var final_start: usize = 0;
    var j: usize = 0;
    for (j < n) { if (pattern[j] == '/'::u8) { final_start = j + 1; } j = j + 1; }

    var dstar: u32 = 0;
    var i: usize = 0;
    for (i < final_start) {
        var seg_end: usize = i;
        for (seg_end < n && pattern[seg_end] != '/'::u8) { seg_end = seg_end + 1; }
        val slen: usize = seg_end - i;
        if (slen > 0) {
            if (slen == 2 && pattern[i] == '*'::u8 && pattern[i + 1] == '*'::u8) { dstar = dstar + 1; }
            or {
                var k: usize = i;
                for (k < seg_end) { if (pattern[k] == '*'::u8) { ret false; } k = k + 1; }
            }
        }
        i = seg_end + 1;
    }
    if (dstar > 1) { ret false; }

    var f: usize = final_start;
    var prev_star: bool = false;
    for (f < n) {
        if (pattern[f] == '*'::u8) {
            if (prev_star) { ret false; }
            prev_star = true;
        }
        or { prev_star = false; }
        f = f + 1;
    }
    ret true;
}

fun glob_expand_pattern(alloc: *A.Allocator, project_root: str, pattern: str, out: *vector.Vector[str]) err[outcome.Fail] {
    val n: usize = str_len(pattern);
    var star2: i64 = -1;
    var i: usize = 0;
    for (i + 1 < n && star2 < 0) {
        if (pattern[i] == '*'::u8 && pattern[i + 1] == '*'::u8) { star2 = i::i64; }
        i = i + 1;
    }

    if (star2 >= 0) {
        val sp: usize = star2::usize;
        var base_end: usize = sp;
        if (base_end > 0 && pattern[base_end - 1] == '/'::u8) { base_end = base_end - 1; }
        val base_r: res[str, string.StrError] = str_copy_slice(alloc, pattern, 0, base_end);
        if (sel base_r.err) { ret err[outcome.Fail].err{outcome.user(outcome.str_text(base_r.err))}; }
        val base: str = base_r.ok;
        var pat_start: usize = sp + 2;
        if (pat_start < n && pattern[pat_start] == '/'::u8) { pat_start = pat_start + 1; }
        val pat_r: res[str, string.StrError] = str_copy_slice(alloc, pattern, pat_start, n - pat_start);
        if (sel pat_r.err) { str_free(alloc, base); ret err[outcome.Fail].err{outcome.user(outcome.str_text(pat_r.err))}; }
        val pat: str = pat_r.ok;
        var base_use: str = base;
        if (str_empty(base)) { base_use = "."; }
        val gr: err[outcome.Fail] = glob_walk(alloc, project_root, base_use, pat, true, out);
        str_free(alloc, base);
        str_free(alloc, pat);
        ret gr;
    }

    var last: i64 = -1;
    i = 0;
    for (i < n) { if (pattern[i] == '/'::u8) { last = i::i64; } i = i + 1; }
    if (last < 0) { ret glob_walk(alloc, project_root, ".", pattern, false, out); }
    val dir_r: res[str, string.StrError] = str_copy_slice(alloc, pattern, 0, last::usize);
    if (sel dir_r.err) { ret err[outcome.Fail].err{outcome.user(outcome.str_text(dir_r.err))}; }
    val dir: str = dir_r.ok;
    val pat_r: res[str, string.StrError] = str_copy_slice(alloc, pattern, (last::usize) + 1, n - ((last::usize) + 1));
    if (sel pat_r.err) { str_free(alloc, dir); ret err[outcome.Fail].err{outcome.user(outcome.str_text(pat_r.err))}; }
    val pat: str = pat_r.ok;
    val gr: err[outcome.Fail] = glob_walk(alloc, project_root, dir, pat, false, out);
    str_free(alloc, dir);
    str_free(alloc, pat);
    ret gr;
}

fun collect_step_inputs(alloc: *A.Allocator, p: *project.Project, step: *manifest.StepDef, execution_root: str, output_root: str, out: *vector.Vector[str]) err[outcome.Fail] {
    var v: manifest.TmplVars = ddep.cell_tmpl_vars(p);
    var i: u32 = 0;
    for (i < step.in_count) {
        val lookup_r: opt[str] = intern.lookup(?p.s.interner, step.in[i]);
        if (sel lookup_r.none) { ret err[outcome.Fail].err{outcome.internal("interned text is absent where the collect step inputs expected it")}; }
        val raw: str = lookup_r.some;
        val sp_r: res[StepPath, outcome.Fail] = resolve_step_path(alloc, raw, output_root, ?v, execution_root, output_root, "a build step input", true);
        if (sel sp_r.err) { ret err[outcome.Fail].err{sp_r.err}; }
        var sp: StepPath = sp_r.ok;
        if (!str_contains_char(sp.rel, '*')) {
            val physical_r: err[outcome.Fail] = validate_physical_path(alloc, sp.root, sp.rel, PHYSICAL_REGULAR, "build step input");
            if (sel physical_r.err) { step_path_free(alloc, ?sp); ret physical_r; }
            str_free(alloc, sp.rel);
            val pr: res[usize, A.Error] = vector.push[str](out, sp.abs);
            if (sel pr.err) { str_free(alloc, sp.abs); ret err[outcome.Fail].err{outcome.refused(pr.err)}; }
        }
        or {
            if (!glob_shape_ok(sp.rel)) {
                val msg: str = sfmt(alloc, "mach.toml: step input glob '{}' has an unsupported shape; wildcards are allowed only in the final path segment, with an optional '**' directory segment (e.g. 'dir/*.c' or 'dir/**/*.c')", sp.rel);
                step_path_free(alloc, ?sp);
                ret err[outcome.Fail].err{outcome.user(msg)};
            }
            val before: usize = out.len;
            val gr: err[outcome.Fail] = glob_expand_pattern(alloc, sp.root, sp.rel, out);
            if (sel gr.err) { step_path_free(alloc, ?sp); ret gr; }
            if (out.len == before) {
                val msg: str = sfmt(alloc, "mach.toml: step input glob '{}' matched no files", sp.rel);
                step_path_free(alloc, ?sp);
                ret err[outcome.Fail].err{outcome.user(msg)};
            }
            var gi: usize = before;
            for (gi < out.len) {
                val abs_r: res[str, A.Error] = spath.resolve(alloc, sp.root, out.data[gi]);
                if (sel abs_r.err) { step_path_free(alloc, ?sp); ret err[outcome.Fail].err{outcome.refused(abs_r.err)}; }
                str_free(alloc, out.data[gi]);
                out.data[gi] = abs_r.ok;
                gi = gi + 1;
            }
            step_path_free(alloc, ?sp);
        }
        i = i + 1;
    }
    sort.sort[str](out.data, out.len, cmp_str);
    ret err[outcome.Fail].ok{};
}

fun step_free_inputs(alloc: *A.Allocator, ins: *vector.Vector[str]) {
    var i: usize = 0;
    for (i < ins.len) { str_free(alloc, ins.data[i]); i = i + 1; }
    vector.dnit[str](ins);
}

rec StepStrings {
    items: **u8;
    count: u32;
}

rec StepInvocation {
    argv: StepStrings;
    env:  StepStrings;
}

rec StepPath {
    root: str;
    rel:  str;
    abs:  str;
}

fun step_path_free(a: *A.Allocator, path: *StepPath) {
    str_free(a, path.rel);
    str_free(a, path.abs);
    # nil, not "": str_free no-ops on nil and would hand a static empty literal
    # to the allocator, so an empty reset makes a second free an invalid free
    path.rel = nil;
    path.abs = nil;
}

fun step_paths_free(a: *A.Allocator, paths: *Vector[StepPath]) {
    var i: usize = 0;
    for (i < paths.len) {
        step_path_free(a, ?paths.data[i]);
        i = i + 1;
    }
    vector.dnit[StepPath](paths);
}

fun absolute_path_in_root(path: str, root: str, allow_root: bool) bool {
    if (!spath.is_abs(path) || !spath.is_abs(root)) { ret false; }
    if (str_equals(path, root)) { ret allow_root; }
    val rn: usize = str_len(root);
    if (!str_starts_with(path, root) || str_len(path) <= rn) { ret false; }
    ret spath.is_separator(path[rn]);
}

fun step_path_error(a: *A.Allocator, field: str) str {
    ret sfmt(a, "mach.toml: {} must expand to a canonical path under the step execution root, or start with '{{project.out}}/' and remain under the designated output root", field);
}

fun resolve_step_path(a: *A.Allocator, raw: str, project_out: str, v: *manifest.TmplVars,
                      execution_root: str, output_root: str, field: str,
                      allow_output_root: bool) res[StepPath, outcome.Fail] {
    var empty: StepPath = StepPath{root: "", rel: "", abs: ""};
    val expanded_r: res[str, outcome.Fail] = manifest.expand(a, raw, project_out, v);
    if (sel expanded_r.err) { ret res[StepPath, outcome.Fail].err{expanded_r.err}; }
    val expanded: str = expanded_r.ok;
    val marker: str = "{project.out}";
    val absolute_output: bool = spath.is_abs(project_out) && str_contains(raw, marker);
    if (!absolute_output && manifest.is_project_path(expanded)) {
        val abs_r: res[str, A.Error] = spath.resolve(a, execution_root, expanded);
        if (sel abs_r.err) {
            str_free(a, expanded);
            ret res[StepPath, outcome.Fail].err{outcome.refused(abs_r.err)};
        }
        ret res[StepPath, outcome.Fail].ok{StepPath{root: execution_root, rel: expanded, abs: abs_r.ok}};
    }

    val mn: usize = str_len(marker);
    val rn: usize = str_len(raw);
    if (!spath.is_abs(expanded) || !str_starts_with(raw, marker)
        || (rn != mn && (rn <= mn || raw[mn] != '/'::u8))) {
        str_free(a, expanded);
        ret res[StepPath, outcome.Fail].err{outcome.user(step_path_error(a, field))};
    }

    var rel: str = "";
    if (rn == mn) {
        if (!allow_output_root) {
            str_free(a, expanded);
            ret res[StepPath, outcome.Fail].err{outcome.user(step_path_error(a, field))};
        }
        val rel_r: res[str, A.Error] = str_dup(a, ".");
        if (sel rel_r.err) {
            str_free(a, expanded);
            ret res[StepPath, outcome.Fail].err{outcome.refused(rel_r.err)};
        }
        rel = rel_r.ok;
    }
    or {
        val suffix: str = ?raw[mn + 1];
        val rel_r: res[str, outcome.Fail] = manifest.expand_project_path(a, suffix, "", v, field);
        if (sel rel_r.err) {
            str_free(a, expanded);
            ret res[StepPath, outcome.Fail].err{rel_r.err};
        }
        rel = rel_r.ok;
    }

    val joined_r: res[str, A.Error] = spath.resolve(a, output_root, rel);
    if (sel joined_r.err) {
        str_free(a, rel);
        str_free(a, expanded);
        ret res[StepPath, outcome.Fail].err{outcome.refused(joined_r.err)};
    }
    val joined: str = joined_r.ok;
    val clean_r: res[str, A.Error] = spath.clean(a, joined);
    str_free(a, joined);
    str_free(a, expanded);
    if (sel clean_r.err) {
        str_free(a, rel);
        ret res[StepPath, outcome.Fail].err{outcome.refused(clean_r.err)};
    }
    val clean: str = clean_r.ok;
    val clean_root_r: res[str, A.Error] = spath.clean(a, output_root);
    if (sel clean_root_r.err) {
        str_free(a, rel);
        str_free(a, clean);
        ret res[StepPath, outcome.Fail].err{outcome.refused(clean_root_r.err)};
    }
    val clean_root: str = clean_root_r.ok;
    fin { str_free(a, clean_root); }
    if (!absolute_path_in_root(clean, clean_root, allow_output_root)) {
        str_free(a, rel);
        str_free(a, clean);
        ret res[StepPath, outcome.Fail].err{outcome.user(step_path_error(a, field))};
    }
    empty = StepPath{root: output_root, rel: rel, abs: clean};
    ret res[StepPath, outcome.Fail].ok{empty};
}

fun step_strings_free(a: *A.Allocator, values: *StepStrings) {
    if (values.items == nil) { ret; }
    var i: u32 = 0;
    for (i < values.count) { str_free(a, values.items[i]::str); i = i + 1; }
    A.deallocate[*u8](a, values.items, values.count::usize + 1);
    values.items = nil;
    values.count = 0;
}

fun expand_step_strings(a: *A.Allocator, p: *project.Project, ids: *intern.StrId,
                        count: u32, project_out: str, v: *manifest.TmplVars) res[StepStrings, outcome.Fail] {
    var out: StepStrings;
    out.items = nil;
    out.count = 0;
    if (count == 0) { ret res[StepStrings, outcome.Fail].ok{out}; }

    val ar: res[**u8, A.Error] = A.allocate[*u8](a, count::usize + 1);
    if (sel ar.err) { ret res[StepStrings, outcome.Fail].err{outcome.refused(ar.err)}; }
    out.items = ar.ok;
    out.count = count;
    var cleared: usize = 0;
    for (cleared <= count::usize) { out.items[cleared] = nil; cleared = cleared + 1; }
    var i: u32 = 0;
    for (i < count) {
        val raw_opt: opt[str] = intern.lookup(?p.s.interner, ids[i]);
        if (sel raw_opt.none) {
            step_strings_free(a, ?out);
            ret res[StepStrings, outcome.Fail].err{outcome.user("internal: build step field not interned")};
        }
        val er: res[str, outcome.Fail] = manifest.expand_step_value(a, raw_opt.some, project_out, v);
        if (sel er.err) {
            step_strings_free(a, ?out);
            ret res[StepStrings, outcome.Fail].err{er.err};
        }
        out.items[i] = er.ok::*u8;
        i = i + 1;
    }
    out.items[count] = nil;
    out.count = count;
    ret res[StepStrings, outcome.Fail].ok{out};
}

fun expand_step_invocation(a: *A.Allocator, p: *project.Project, step: *manifest.StepDef,
                           project_out: str, v: *manifest.TmplVars) res[StepInvocation, outcome.Fail] {
    var invocation: StepInvocation;
    invocation.argv = StepStrings{items: nil, count: 0};
    invocation.env = StepStrings{items: nil, count: 0};

    val argv_r: res[StepStrings, outcome.Fail] = expand_step_strings(a, p, step.argv, step.argv_count, project_out, v);
    if (sel argv_r.err) { ret res[StepInvocation, outcome.Fail].err{argv_r.err}; }
    invocation.argv = argv_r.ok;
    if (invocation.argv.count == 0 || str_empty(invocation.argv.items[0]::str)) {
        step_strings_free(a, ?invocation.argv);
        ret res[StepInvocation, outcome.Fail].err{outcome.user("mach.toml: expanded build step argv[0] must name an executable")};
    }

    val inherited: **u8 = env.environ();
    if (inherited == nil) {
        step_strings_free(a, ?invocation.argv);
        ret res[StepInvocation, outcome.Fail].err{outcome.user("planner environment unavailable")};
    }
    val environment_r: res[StepStrings, outcome.Fail] = expand_step_environment(a, p, step, project_out, v, inherited);
    if (sel environment_r.err) {
        step_strings_free(a, ?invocation.argv);
        ret res[StepInvocation, outcome.Fail].err{environment_r.err};
    }
    invocation.env = environment_r.ok;
    ret res[StepInvocation, outcome.Fail].ok{invocation};
}

fun expand_step_environment(a: *A.Allocator, p: *project.Project, step: *manifest.StepDef,
                            project_out: str, v: *manifest.TmplVars, inherited: **u8) res[StepStrings, outcome.Fail] {
    val captured: res[step_env.Environment, outcome.Fail] = step_env.capture(a, inherited);
    if (sel captured.err) { ret res[StepStrings, outcome.Fail].err{captured.err}; }
    var environment: step_env.Environment = captured.ok;
    fin { step_env.dnit(?environment); }
    var i: u32 = 0;
    for (i < step.env_count) {
        val key_opt: opt[str] = intern.lookup(?p.s.interner, step.env_keys[i]);
        val value_opt: opt[str] = intern.lookup(?p.s.interner, step.env_values[i]);
        if (sel key_opt.none) {
            ret res[StepStrings, outcome.Fail].err{outcome.user("internal: build step environment not interned")};
        }
        if (sel value_opt.none) {
            ret res[StepStrings, outcome.Fail].err{outcome.user("internal: build step environment not interned")};
        }
        val key: str = key_opt.some;
        val reserved: res[bool, outcome.Fail] = is_target_env_key(key);
        if (sel reserved.err) { ret res[StepStrings, outcome.Fail].err{reserved.err}; }
        if (reserved.ok) { i = i + 1; cnt; }
        val value_r: res[str, outcome.Fail] = manifest.expand_step_value(a, value_opt.some, project_out, v);
        if (sel value_r.err) { ret res[StepStrings, outcome.Fail].err{value_r.err}; }
        val value: str = value_r.ok;
        val added: err[outcome.Fail] = step_env.put(?environment, key, value, true);
        str_free(a, value);
        if (sel added.err) { ret res[StepStrings, outcome.Fail].err{added.err}; }
        i = i + 1;
    }
    var ti: usize = 0;
    for (ti < TARGET_ENV_N) {
        val added: err[outcome.Fail] = step_env.put(?environment, TARGET_ENV_KEYS[ti], target_env_value(v, ti), true);
        if (sel added.err) { ret res[StepStrings, outcome.Fail].err{added.err}; }
        ti = ti + 1;
    }
    val exported: res[step_env.Strings, outcome.Fail] = step_env.to_strings(?environment);
    if (sel exported.err) { ret res[StepStrings, outcome.Fail].err{exported.err}; }
    val strings: step_env.Strings = exported.ok;
    ret res[StepStrings, outcome.Fail].ok{StepStrings{items: strings.items, count: strings.count}};
}

val TARGET_ENV_N: usize = 3;
val TARGET_ENV_KEYS: [TARGET_ENV_N]str = [TARGET_ENV_N]str{
    "MACH_TARGET_ISA",
    "MACH_TARGET_OS",
    "MACH_TARGET_ABI",
};

fun target_env_value(v: *manifest.TmplVars, idx: usize) str {
    if (idx == 0) { ret v.isa; }
    if (idx == 1) { ret v.os; }
    ret v.abi;
}

fun is_target_env_key(key: str) res[bool, outcome.Fail] {
    var i: usize = 0;
    for (i < TARGET_ENV_N) {
        val order: res[i32, env.EnvError] = env.compare_names(key, TARGET_ENV_KEYS[i]);
        if (sel order.err) { ret res[bool, outcome.Fail].err{outcome.user(outcome.env_text(order.err))}; }
        if (order.ok == 0) { ret res[bool, outcome.Fail].ok{true}; }
        i = i + 1;
    }
    ret res[bool, outcome.Fail].ok{false};
}

fun step_invocation_free(a: *A.Allocator, invocation: *StepInvocation) {
    step_strings_free(a, ?invocation.argv);
    step_strings_free(a, ?invocation.env);
}

fun collect_step_outputs(a: *A.Allocator, p: *project.Project, step: *manifest.StepDef, execution_root: str, output_root: str, outputs: *Vector[StepPath]) err[outcome.Fail] {
    var v: manifest.TmplVars = ddep.cell_tmpl_vars(p);
    var oi: u32 = 0;
    for (oi < step.out_count) {
        val raw_opt: opt[str] = intern.lookup(?p.s.interner, step.out[oi]);
        if (sel raw_opt.none) { ret err[outcome.Fail].err{outcome.user("internal: build step output not interned")}; }
        val sp_r: res[StepPath, outcome.Fail] = resolve_step_path(a, raw_opt.some, output_root, ?v, execution_root, output_root, "a build step output", false);
        if (sel sp_r.err) { ret err[outcome.Fail].err{sp_r.err}; }
        val sp: StepPath = sp_r.ok;
        val push_r: res[usize, A.Error] = vector.push[StepPath](outputs, sp);
        if (sel push_r.err) {
            var lost: StepPath = sp;
            step_path_free(a, ?lost);
            ret err[outcome.Fail].err{outcome.refused(push_r.err)};
        }
        oi = oi + 1;
    }
    ret err[outcome.Fail].ok{};
}

fun step_make_output_dirs(a: *A.Allocator, outputs: *Vector[StepPath]) err[outcome.Fail] {
    var oi: usize = 0;
    for (oi < outputs.len) {
        val sp: *StepPath = ?outputs.data[oi];
        val dir_r: res[str, A.Error] = spath.parent(a, sp.rel);
        if (sel dir_r.err) { ret err[outcome.Fail].err{outcome.refused(dir_r.err)}; }
        val rel_dir: str = dir_r.ok;
        val make_r: err[outcome.Fail] = ensure_physical_directory_path(a, sp.root, rel_dir, "build step output directory");
        str_free(a, rel_dir);
        if (sel make_r.err) { ret err[outcome.Fail].err{make_r.err}; }
        oi = oi + 1;
    }
    ret err[outcome.Fail].ok{};
}

fun resolve_step_program(a: *A.Allocator, execution_root: str, invocation: *StepInvocation) res[str, outcome.Fail] {
    val name: str = invocation.argv.items[0]::str;
    if (spath.has_separator(name)) {
        val resolve_r: res[spath.Path, A.Error] = spath.resolve(a, execution_root, name);
        if (sel resolve_r.err) { ret res[str, outcome.Fail].err{outcome.refused(resolve_r.err)}; }
        ret res[str, outcome.Fail].ok{resolve_r.ok};
    }
    val rr: res[str, exec.Error] = exec.resolve(a, name);
    if (sel rr.err) {
        ret res[str, outcome.Fail].err{outcome.user(sfmt(a, "mach.toml: build step executable '{}' was not found on the planner PATH", name))};
    }
    val found: str = rr.ok;
    if (spath.is_abs(found)) { ret res[str, outcome.Fail].ok{found}; }
    val cwd_r: res[string.OwnedString, env.EnvError] = env.current_dir(a);
    if (sel cwd_r.err) {
        str_free(a, found);
        ret res[str, outcome.Fail].err{outcome.user(outcome.env_text(cwd_r.err))};
    }
    var cwd: string.OwnedString = cwd_r.ok;
    val abs_r: res[str, A.Error] = spath.resolve(a, cwd.data, found);
    string.owned_release(?cwd);
    str_free(a, found);
    if (sel abs_r.err) { ret res[str, outcome.Fail].err{outcome.refused(abs_r.err)}; }
    ret res[str, outcome.Fail].ok{abs_r.ok};
}

fun execute_step_invocation(a: *A.Allocator, execution_root: str, program: str,
                            invocation: *StepInvocation, step_name: str,
                            timeout_seconds: i64) err[outcome.Fail] {
    var child: subprocess.OwnedSubprocess;
    subprocess.init(?child);
    val spawn_r: err[subprocess.Error] = subprocess.spawn_in_grouped(a, ?child, program, invocation.argv.items,
        invocation.env.items, execution_root);
    if (sel spawn_r.err) {
        val msg: str = sfmt(a, "failed to spawn build step executable '{}': {}", program, subprocess.text(a, spawn_r.err));
        subprocess.dnit(a, ?child);
        ret err[outcome.Fail].err{outcome.user(msg)};
    }
    if (timeout_seconds > 0) { subprocess.bound_seconds(?child, timeout_seconds); }

    var scope: cnc.Scope;
    cnc.make_root(?scope, false, tm.Time{sec: 0, nsec: 0});
    var source: events.Source;
    val made_source: err[io_error.Error] = events.make(?source);
    var has_source: bool = sel made_source.ok;
    var interrupt_source: *events.Source = nil;
    if (has_source) { interrupt_source = ?source; }

    val wait_r: res[*subprocess.OwnedSubprocess, subprocess.Error] = subprocess.wait_any(a, ?child, 1, ?scope, interrupt_source);
    if (has_source) { events.close(?source); }
    cnc.destroy(?scope);
    if (sel wait_r.err) {
        val wait_err: str = subprocess.text(a, wait_r.err);
        val cancel_r: res[subprocess.SubprocessTerminal, subprocess.Error] = subprocess.cancel(a, ?child, 0);
        if (sel cancel_r.err) {
            val msg: str = sfmt(a, "failed to wait for build step executable '{}': {}; cancellation also failed: {}", program, wait_err, subprocess.text(a, cancel_r.err));
            subprocess.dnit(a, ?child);
            ret err[outcome.Fail].err{outcome.user(msg)};
        }
        val msg: str = sfmt(a, "failed to wait for build step executable '{}': {}; child was canceled and reaped", program, wait_err);
        subprocess.dnit(a, ?child);
        ret err[outcome.Fail].err{outcome.user(msg)};
    }
    if (subprocess.expired(?child)) {
        val msg: str = sfmt(a, "build step '{}' exceeded its timeout_seconds of {} and its process group was terminated", step_name, timeout_seconds);
        subprocess.dnit(a, ?child);
        ret err[outcome.Fail].err{outcome.user(msg)};
    }
    val terminal: subprocess.SubprocessTerminal = child.terminal;
    if (terminal.kind == subprocess.STATE_EXITED) {
        if (terminal.code == 0) { subprocess.dnit(a, ?child); ret err[outcome.Fail].ok{}; }
        val msg: str = sfmt(a, "build step exited with code {}", terminal.code);
        subprocess.dnit(a, ?child);
        ret err[outcome.Fail].err{outcome.user(msg)};
    }
    if (terminal.kind == subprocess.STATE_SIGNALED) {
        val msg: str = sfmt(a, "build step terminated by signal {}", terminal.code);
        subprocess.dnit(a, ?child);
        ret err[outcome.Fail].err{outcome.user(msg)};
    }
    subprocess.dnit(a, ?child);
    ret err[outcome.Fail].err{outcome.user("build step reached an invalid terminal state")};
}

rec TreeFile {
    path: str;
    kind: u8;
    sec:  i64;
    nsec: i64;
    size: usize;
    digest: [32]u8;
}

val TREE_FILE: u8 = 1;
val TREE_DIRECTORY: u8 = 2;

fun collect_tree_files(a: *A.Allocator, dir: str, out: *vector.Vector[TreeFile]) err[outcome.Fail] {
    val is_symlink_r: res[bool, io_error.Error] = fs.is_symlink(dir);
    if ((sel is_symlink_r.ok && is_symlink_r.ok)) { ret err[outcome.Fail].err{outcome.user(sfmt(a, "cannot snapshot symlink tree root '{}'", dir))}; }
    val exists_r: res[bool, io_error.Error] = fs.exists(dir);
    if (!(sel exists_r.ok && exists_r.ok)) { ret err[outcome.Fail].ok{}; }
    val root_meta_r: res[fs.Metadata, io_error.Error] = fs.metadata_link(dir);
    if (sel root_meta_r.err) { ret err[outcome.Fail].err{outcome.user(outcome.io_text(root_meta_r.err))}; }
    val root_meta: fs.Metadata = root_meta_r.ok;
    if (!fs.meta_is_dir(?root_meta)) { ret err[outcome.Fail].err{outcome.user(sfmt(a, "cannot snapshot non-directory tree root '{}'", dir))}; }
    val root_path_r: res[str, A.Error] = spath.clean(a, dir);
    if (sel root_path_r.err) { ret err[outcome.Fail].err{outcome.refused(root_path_r.err)}; }
    var root_entry: TreeFile;
    root_entry.path = root_path_r.ok;
    root_entry.kind = TREE_DIRECTORY;
    root_entry.sec = 0;
    root_entry.nsec = 0;
    root_entry.size = 0;
    var root_digest_i: usize = 0;
    for (root_digest_i < 32) { root_entry.digest[root_digest_i] = 0; root_digest_i = root_digest_i + 1; }
    val root_push_r: res[usize, A.Error] = vector.push[TreeFile](out, root_entry);
    if (sel root_push_r.err) { str_free(a, root_entry.path); ret err[outcome.Fail].err{outcome.refused(root_push_r.err)}; }
    val names_r: res[Vector[str], fs.FsError] = fs.read_dir(a, root_entry.path);
    if (sel names_r.err) { ret err[outcome.Fail].err{outcome.user(outcome.fs_text(names_r.err))}; }
    var names: Vector[str] = names_r.ok;
    sort.sort[str](names.data, names.len, cmp_str);

    var i: usize = 0;
    for (i < names.len) {
        val child_r: res[str, fail.Fail] = load.join_path(a, root_entry.path, names.data[i]);
        if (sel child_r.err) {
            free_str_vector(a, ?names);
            ret err[outcome.Fail].err{outcome.from_fail(child_r.err)};
        }
        val child: str = child_r.ok;
        val fi_r: res[fs.Metadata, io_error.Error] = fs.metadata_link(child);
        if (sel fi_r.err) {
            str_free(a, child);
            free_str_vector(a, ?names);
            ret err[outcome.Fail].err{outcome.user(outcome.io_text(fi_r.err))};
        }
        val fi: fs.Metadata = fi_r.ok;
        if (fs.meta_is_dir(?fi)) {
            val child_walk_r: err[outcome.Fail] = collect_tree_files(a, child, out);
            str_free(a, child);
            if (sel child_walk_r.err) {
                free_str_vector(a, ?names);
                ret child_walk_r;
            }
        }
        or (fs.meta_is_file(?fi)) {
            var tf: TreeFile;
            tf.path = child;
            tf.kind = TREE_FILE;
            tf.sec  = fi.modified.sec;
            tf.nsec = fi.modified.nsec;
            tf.size = fi.size;
            val digest_r: err[outcome.Fail] = fingerprint.file_sha256(child, ?tf.digest[0]);
            if (sel digest_r.err) {
                str_free(a, child);
                free_str_vector(a, ?names);
                ret digest_r;
            }
            val pr: res[usize, A.Error] = vector.push[TreeFile](out, tf);
            if (sel pr.err) {
                str_free(a, child);
                free_str_vector(a, ?names);
                ret err[outcome.Fail].err{outcome.refused(pr.err)};
            }
        }
        or {
            val msg: str = sfmt(a, "cannot snapshot unsupported entry '{}'", child);
            str_free(a, child);
            free_str_vector(a, ?names);
            ret err[outcome.Fail].err{outcome.user(msg)};
        }
        i = i + 1;
    }
    free_str_vector(a, ?names);
    ret err[outcome.Fail].ok{};
}

fun free_str_vector(a: *A.Allocator, v: *Vector[str]) {
    var i: usize = 0;
    for (i < v.len) { str_free(a, v.data[i]); i = i + 1; }
    vector.dnit[str](v);
}

fun free_tree_files(a: *A.Allocator, v: *Vector[TreeFile]) {
    var i: usize = 0;
    for (i < v.len) { str_free(a, v.data[i].path); i = i + 1; }
    vector.dnit[TreeFile](v);
}

fun snapshot_holds(snap: *Vector[TreeFile], f: *TreeFile) bool {
    var i: usize = 0;
    for (i < snap.len) {
        val s: *TreeFile = ?snap.data[i];
        if (str_equals(s.path, f.path)) {
            if (s.kind != f.kind) { ret false; }
            if (s.kind == TREE_DIRECTORY) { ret true; }
            if (s.sec != f.sec || s.nsec != f.nsec || s.size != f.size) { ret false; }
            var j: usize = 0;
            for (j < 32) {
                if (s.digest[j] != f.digest[j]) { ret false; }
                j = j + 1;
            }
            ret true;
        }
        i = i + 1;
    }
    ret false;
}

fun check_step_left_obj_tree(a: *A.Allocator, before: *Vector[TreeFile], tree: str, name: str) err[outcome.Fail] {
    var after: Vector[TreeFile] = vector.init[TreeFile](a);
    val collect_r: err[outcome.Fail] = collect_tree_files(a, tree, ?after);
    if (sel collect_r.err) {
        free_tree_files(a, ?after);
        ret err[outcome.Fail].err{outcome.user(sfmt(a, "build step '{}' left the compiler-owned module object tree unverifiable: {}", name, outcome.describe(collect_r.err)))};
    }

    var verdict: err[outcome.Fail] = err[outcome.Fail].ok{};
    var i: usize = 0;
    for (i < after.len) {
        if (!snapshot_holds(before, ?after.data[i])) {
            verdict = err[outcome.Fail].err{outcome.user(step_out_reserved_error(a, "build step", name, after.data[i].path, tree, "the module object tree"))};
            i = after.len;
        }
        or { i = i + 1; }
    }
    i = 0;
    for (sel verdict.ok && i < before.len) {
        if (!snapshot_holds(?after, ?before.data[i])) {
            verdict = err[outcome.Fail].err{outcome.user(sfmt(a, "build step '{}' removed '{}' from '{}/', the compiler-owned module object tree", name, before.data[i].path, tree))};
            i = before.len;
        }
        or { i = i + 1; }
    }
    free_tree_files(a, ?after);
    ret verdict;
}

fun step_paths_absolute(a: *A.Allocator, paths: *Vector[StepPath], out: *Vector[str]) err[outcome.Fail] {
    var i: usize = 0;
    for (i < paths.len) {
        val dup_r: res[str, A.Error] = str_dup(a, paths.data[i].abs);
        if (sel dup_r.err) { ret err[outcome.Fail].err{outcome.refused(dup_r.err)}; }
        val dup: str = dup_r.ok;
        val push_r: res[usize, A.Error] = vector.push[str](out, dup);
        if (sel push_r.err) { str_free(a, dup); ret err[outcome.Fail].err{outcome.refused(push_r.err)}; }
        i = i + 1;
    }
    ret err[outcome.Fail].ok{};
}

fun step_paths_rel_for_root(a: *A.Allocator, paths: *Vector[StepPath], root: str, out: *Vector[str]) err[outcome.Fail] {
    var i: usize = 0;
    for (i < paths.len) {
        val sp: *StepPath = ?paths.data[i];
        if (str_equals(sp.root, root)) {
            val dup_r: res[str, A.Error] = str_dup(a, sp.rel);
            if (sel dup_r.err) { ret err[outcome.Fail].err{outcome.refused(dup_r.err)}; }
            val dup: str = dup_r.ok;
            val push_r: res[usize, A.Error] = vector.push[str](out, dup);
            if (sel push_r.err) { str_free(a, dup); ret err[outcome.Fail].err{outcome.refused(push_r.err)}; }
        }
        i = i + 1;
    }
    ret err[outcome.Fail].ok{};
}

fun output_path_declared(path: str, declared: *Vector[str]) bool {
    var i: usize = 0;
    for (i < declared.len) {
        if (path_in_module_obj_tree(path, declared.data[i])) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun validate_declared_step_outputs(a: *A.Allocator, root: str, outputs: *Vector[str], name: str) err[outcome.Fail] {
    var i: usize = 0;
    for (i < outputs.len) {
        val physical_r: err[outcome.Fail] = validate_physical_path(a, root, outputs.data[i], PHYSICAL_ENTRY, "declared build step output");
        if (sel physical_r.err) {
            ret err[outcome.Fail].err{outcome.user(sfmt(a, "build step '{}' did not publish valid declared output '{}': {}", name, outputs.data[i], outcome.describe(physical_r.err)))};
        }
        i = i + 1;
    }
    ret err[outcome.Fail].ok{};
}

fun check_step_output_effects(a: *A.Allocator, before: *Vector[TreeFile], tree: str, declared: *Vector[str], name: str) err[outcome.Fail] {
    var after: Vector[TreeFile] = vector.init[TreeFile](a);
    val collect_r: err[outcome.Fail] = collect_tree_files(a, tree, ?after);
    if (sel collect_r.err) {
        free_tree_files(a, ?after);
        ret err[outcome.Fail].err{outcome.user(sfmt(a, "build step '{}' left the project output tree unverifiable: {}", name, outcome.describe(collect_r.err)))};
    }
    var i: usize = 0;
    for (i < after.len) {
        if (!snapshot_holds(before, ?after.data[i]) && !output_path_declared(after.data[i].path, declared)) {
            val msg: str = sfmt(a, "build step '{}' created or modified undeclared output '{}' under '{}'; declare it in the step output list", name, after.data[i].path, tree);
            free_tree_files(a, ?after);
            ret err[outcome.Fail].err{outcome.user(msg)};
        }
        i = i + 1;
    }
    i = 0;
    for (i < before.len) {
        if (!snapshot_holds(?after, ?before.data[i]) && !output_path_declared(before.data[i].path, declared)) {
            val msg: str = sfmt(a, "build step '{}' removed undeclared output '{}' under '{}'; declare it in the step output list", name, before.data[i].path, tree);
            free_tree_files(a, ?after);
            ret err[outcome.Fail].err{outcome.user(msg)};
        }
        i = i + 1;
    }
    free_tree_files(a, ?after);
    ret err[outcome.Fail].ok{};
}

fun combine_step_terminal_results(a: *A.Allocator, object_integrity: err[outcome.Fail], output_integrity: err[outcome.Fail], execution: err[outcome.Fail]) err[outcome.Fail] {
    if (sel object_integrity.err) {
        if (sel output_integrity.err) {
            if (sel execution.err) {
                ret err[outcome.Fail].err{outcome.user(sfmt(a, "{}; project output integrity: {}; execution outcome: {}", outcome.describe(object_integrity.err), outcome.describe(output_integrity.err), outcome.describe(execution.err)))};
        }
        }
        if (sel output_integrity.err) {
            ret err[outcome.Fail].err{outcome.user(sfmt(a, "{}; project output integrity: {}", outcome.describe(object_integrity.err), outcome.describe(output_integrity.err)))};
        }
        if (sel execution.err) {
            ret err[outcome.Fail].err{outcome.user(sfmt(a, "{}; execution outcome: {}", outcome.describe(object_integrity.err), outcome.describe(execution.err)))};
        }
        ret object_integrity;
    }
    if (sel output_integrity.err) {
        if (sel execution.err) {
            ret err[outcome.Fail].err{outcome.user(sfmt(a, "{}; execution outcome: {}", outcome.describe(output_integrity.err), outcome.describe(execution.err)))};
        }
        ret output_integrity;
    }
    ret execution;
}

fun absolute_execution_root(a: *A.Allocator, root: str) res[str, outcome.Fail] {
    if (spath.is_abs(root)) {
        val str_dup_r: res[str, A.Error] = str_dup(a, root);
        if (sel str_dup_r.err) { ret res[str, outcome.Fail].err{outcome.refused(str_dup_r.err)}; }
        ret res[str, outcome.Fail].ok{str_dup_r.ok};
    }
    val cwd_r: res[string.OwnedString, env.EnvError] = env.current_dir(a);
    if (sel cwd_r.err) { ret res[str, outcome.Fail].err{outcome.user(outcome.env_text(cwd_r.err))}; }
    var cwd: string.OwnedString = cwd_r.ok;
    val joined_r: res[str, A.Error] = spath.resolve(a, cwd.data, root);
    string.owned_release(?cwd);
    if (sel joined_r.err) { ret res[str, outcome.Fail].err{outcome.refused(joined_r.err)}; }
    val joined: str = joined_r.ok;
    val clean_r: res[str, A.Error] = spath.clean(a, joined);
    str_free(a, joined);
    if (sel clean_r.err) { ret res[str, outcome.Fail].err{outcome.refused(clean_r.err)}; }
    ret res[str, outcome.Fail].ok{clean_r.ok};
}

val STEP_FP_SCHEMA: u8 = 1;

fun digest_hex(a: *A.Allocator, digest: *u8, len: usize) str {
    val cap: usize = ehex.encoded_len(len);
    val rb: res[*u8, A.Error] = A.allocate[u8](a, cap);
    if (sel rb.err) { ret ""; }
    val buf: *u8 = rb.ok;
    ehex.encode(digest, len, buf, cap);
    ret buf::str;
}

fun step_stamp_path(a: *A.Allocator, root_project: str, root_out: str, owner_id: str, step_name: str) str {
    val fname: str = sfmt(a, "{}.{}.stamp", owner_id, step_name);
    val d1_r: res[str, fail.Fail] = load.join_path(a, root_project, root_out);
    if (sel d1_r.err) { str_free(a, fname); ret ""; }
    val d1: str = d1_r.ok;
    val d2_r: res[str, fail.Fail] = load.join_path(a, d1, STEP_STAMP_DIR);
    str_free(a, d1);
    if (sel d2_r.err) { str_free(a, fname); ret ""; }
    val d2: str = d2_r.ok;
    val path_r: res[str, fail.Fail] = load.join_path(a, d2, fname);
    str_free(a, d2);
    str_free(a, fname);
    if (sel path_r.err) { ret ""; }
    ret path_r.ok;
}

fun stamp_matches(a: *A.Allocator, path: str, hex: str) bool {
    val rr: res[str, fs.FsError] = fs.read_string(a, path);
    if (sel rr.err) { ret false; }
    val prior: str = rr.ok;
    val eq: bool = str_equals(prior, hex);
    str_free(a, prior);
    ret eq;
}

fun write_stamp(a: *A.Allocator, path: str, hex: str) err[outcome.Fail] {
    ret publication.bytes(nil, a, path, hex::*u8, str_len(hex), 0o644, publication.REPLACE, publication.PARENTS_CREATE,
                          "write the build step stamp", "the build step stamp could not be published", nil);
}

fun step_final_outputs_current(a: *A.Allocator, outputs: *Vector[StepPath]) bool {
    var i: usize = 0;
    for (i < outputs.len) {
        val sp: *StepPath = ?outputs.data[i];
        val vr: err[outcome.Fail] = validate_physical_path(a, sp.root, sp.rel, PHYSICAL_ENTRY, "build step output");
        if (sel vr.err) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun step_fp_count(e: *binary.Encoder, n: u32) bool {
    var b: [4]u8;
    b[0] = (n & 0xFF)::u8;
    b[1] = ((n >> 8) & 0xFF)::u8;
    b[2] = ((n >> 16) & 0xFF)::u8;
    b[3] = ((n >> 24) & 0xFF)::u8;
    ret fingerprint.write_domain_bytes(e, fingerprint.DOMAIN_BUILD_STEP, STEP_FP_SCHEMA, ?b[0], 4);
}

fun step_fp_file(e: *binary.Encoder, a: *A.Allocator, path: str) err[outcome.Fail] {
    val rr: res[Vector[u8], fs.FsError] = fs.read_bytes(a, path);
    if (sel rr.err) { ret err[outcome.Fail].err{outcome.user(outcome.fs_text(rr.err))}; }
    var buf: Vector[u8] = rr.ok;
    var digest: [32]u8;
    sha256.hash(buf.data, buf.len, ?digest[0]);
    vector.dnit[u8](?buf);
    if (!fingerprint.write_domain_bytes(e, fingerprint.DOMAIN_BUILD_STEP, STEP_FP_SCHEMA, ?digest[0], 32)) {
        ret err[outcome.Fail].err{outcome.user("out of memory computing build step fingerprint")};
    }
    ret err[outcome.Fail].ok{};
}

fun step_fp_strings(e: *binary.Encoder, values: *StepStrings) bool {
    if (!step_fp_count(e, values.count)) { ret false; }
    var i: u32 = 0;
    for (i < values.count) {
        if (!fingerprint.write_domain_str(e, fingerprint.DOMAIN_BUILD_STEP, STEP_FP_SCHEMA, values.items[i]::str)) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun step_fp_path_vector(e: *binary.Encoder, values: *Vector[str]) err[outcome.Fail] {
    if (values.len > 0xFFFFFFFF::usize) { ret err[outcome.Fail].err{outcome.user("build step has too many declared paths")}; }
    if (!step_fp_count(e, values.len::u32)) { ret err[outcome.Fail].err{outcome.user("out of memory computing build step fingerprint")}; }
    var i: usize = 0;
    for (i < values.len) {
        if (!fingerprint.write_domain_str(e, fingerprint.DOMAIN_BUILD_STEP, STEP_FP_SCHEMA, values.data[i])) {
            ret err[outcome.Fail].err{outcome.user("out of memory computing build step fingerprint")};
        }
        i = i + 1;
    }
    ret err[outcome.Fail].ok{};
}

fun step_fp_input_vector(e: *binary.Encoder, a: *A.Allocator, values: *Vector[str]) err[outcome.Fail] {
    if (values.len > 0xFFFFFFFF::usize) { ret err[outcome.Fail].err{outcome.user("build step has too many expanded inputs")}; }
    if (!step_fp_count(e, values.len::u32)) { ret err[outcome.Fail].err{outcome.user("out of memory computing build step fingerprint")}; }
    var i: usize = 0;
    for (i < values.len) {
        if (!fingerprint.write_domain_str(e, fingerprint.DOMAIN_BUILD_STEP, STEP_FP_SCHEMA, values.data[i])) {
            ret err[outcome.Fail].err{outcome.user("out of memory computing build step fingerprint")};
        }
        val wc: err[outcome.Fail] = step_fp_file(e, a, values.data[i]);
        if (sel wc.err) { ret err[outcome.Fail].err{wc.err}; }
        i = i + 1;
    }
    ret err[outcome.Fail].ok{};
}

fun step_fingerprint(a: *A.Allocator, target_s: str, profile_s: str, program: str,
                     argv: *StepStrings, env: *StepStrings, prerequisites: *StepStrings,
                     ins: *Vector[str], outputs: *Vector[str], digest: *u8) err[outcome.Fail] {
    var e: binary.Encoder = binary.encoder(a, binary.LITTLE);

    if (!fingerprint.write_domain_str(?e, fingerprint.DOMAIN_BUILD_STEP, STEP_FP_SCHEMA, target_s)
        || !fingerprint.write_domain_str(?e, fingerprint.DOMAIN_BUILD_STEP, STEP_FP_SCHEMA, profile_s)
        || !fingerprint.write_domain_str(?e, fingerprint.DOMAIN_BUILD_STEP, STEP_FP_SCHEMA, program)) {
        binary.encoder_dnit(?e);
        ret err[outcome.Fail].err{outcome.user("out of memory computing build step fingerprint")};
    }
    val wpc: err[outcome.Fail] = step_fp_file(?e, a, program);
    if (sel wpc.err) { binary.encoder_dnit(?e); ret wpc; }

    if (!step_fp_strings(?e, argv) || !step_fp_strings(?e, env) || !step_fp_strings(?e, prerequisites)) {
        binary.encoder_dnit(?e);
        ret err[outcome.Fail].err{outcome.user("out of memory computing build step fingerprint")};
    }
    val wo: err[outcome.Fail] = step_fp_path_vector(?e, outputs);
    if (sel wo.err) { binary.encoder_dnit(?e); ret wo; }
    val wi: err[outcome.Fail] = step_fp_input_vector(?e, a, ins);
    if (sel wi.err) { binary.encoder_dnit(?e); ret wi; }

    sha256.hash(e.data, e.len, digest);
    binary.encoder_dnit(?e);
    ret err[outcome.Fail].ok{};
}

fun step_staging_root(a: *A.Allocator, output_root: str, step_name: str) str {
    ret sfmt(a, "{}/{}/{}", output_root, STEP_STAGE_DIR, step_name);
}

fun step_staging_home_out(a: *A.Allocator, home_out: str, step_name: str) str {
    ret sfmt(a, "{}/{}/{}", home_out, STEP_STAGE_DIR, step_name);
}

fun step_prepare_staging(a: *A.Allocator, output_root: str, staging_root: str, step_name: str) err[outcome.Fail] {
    val rel: str = sfmt(a, "{}/{}", STEP_STAGE_DIR, step_name);
    val ancestors_r: err[outcome.Fail] = validate_contained_ancestors(a, output_root, rel, "build step staging area");
    if (sel ancestors_r.err) { str_free(a, rel); ret ancestors_r; }
    val rm: err[fs.FsError] = fs.remove_all(a, staging_root);
    if (sel rm.err) { str_free(a, rel); ret err[outcome.Fail].err{outcome.user(sfmt(a, "failed to prepare build step staging area: {}", outcome.fs_text(rm.err)))}; }
    val make_r: err[outcome.Fail] = ensure_physical_directory_path(a, output_root, rel, "build step staging area");
    str_free(a, rel);
    ret make_r;
}

fun step_make_staging_dirs(a: *A.Allocator, output_root: str, staging_root: str, outputs: *Vector[StepPath]) err[outcome.Fail] {
    var oi: usize = 0;
    for (oi < outputs.len) {
        val sp: *StepPath = ?outputs.data[oi];
        if (str_equals(sp.root, output_root)) {
            val dir_r: res[str, A.Error] = spath.parent(a, sp.rel);
            if (sel dir_r.err) { ret err[outcome.Fail].err{outcome.refused(dir_r.err)}; }
            val rel_dir: str = dir_r.ok;
            val make_r: err[outcome.Fail] = ensure_physical_directory_path(a, staging_root, rel_dir, "build step staging output directory");
            str_free(a, rel_dir);
            if (sel make_r.err) { ret err[outcome.Fail].err{make_r.err}; }
        }
        oi = oi + 1;
    }
    ret err[outcome.Fail].ok{};
}

fun step_paths_staged_absolute(a: *A.Allocator, output_root: str, staging_root: str, outputs: *Vector[StepPath], out: *Vector[str]) err[outcome.Fail] {
    var i: usize = 0;
    for (i < outputs.len) {
        val sp: *StepPath = ?outputs.data[i];
        if (str_equals(sp.root, output_root)) {
            val abs_r: res[str, A.Error] = spath.resolve(a, staging_root, sp.rel);
            if (sel abs_r.err) { ret err[outcome.Fail].err{outcome.refused(abs_r.err)}; }
            val joined: str = abs_r.ok;
            val clean_r: res[str, A.Error] = spath.clean(a, joined);
            str_free(a, joined);
            if (sel clean_r.err) { ret err[outcome.Fail].err{outcome.refused(clean_r.err)}; }
            val abs: str = clean_r.ok;
            val push_r: res[usize, A.Error] = vector.push[str](out, abs);
            if (sel push_r.err) { str_free(a, abs); ret err[outcome.Fail].err{outcome.refused(push_r.err)}; }
        }
        i = i + 1;
    }
    ret err[outcome.Fail].ok{};
}

fun publish_staged_outputs(a: *A.Allocator, staging_root: str, output_root: str, outputs: *Vector[StepPath]) err[outcome.Fail] {
    var i: usize = 0;
    for (i < outputs.len) {
        val sp: *StepPath = ?outputs.data[i];
        if (str_equals(sp.root, output_root)) {
            val staged_r: res[str, A.Error] = spath.resolve(a, staging_root, sp.rel);
            if (sel staged_r.err) { ret err[outcome.Fail].err{outcome.refused(staged_r.err)}; }
            val staged: str = staged_r.ok;
            val rn: err[io_error.Error] = fs.rename(staged, sp.abs);
            str_free(a, staged);
            if (sel rn.err) {
                ret err[outcome.Fail].err{outcome.user(sfmt(a, "failed to publish build step output '{}': {}", sp.abs, outcome.io_text(rn.err)))};
            }
        }
        i = i + 1;
    }
    ret err[outcome.Fail].ok{};
}

fun run_one_step(a: *A.Allocator, p: *project.Project, step: *manifest.StepDef, project_root: str, home_out: str, owner_id: str) err[outcome.Fail] {
    val execution_root: str = project_root;
    var v: manifest.TmplVars = ddep.cell_tmpl_vars(p);
    val lookup_r: opt[str] = intern.lookup(?p.s.interner, step.name);
    if (sel lookup_r.none) { ret err[outcome.Fail].err{outcome.internal("interned text is absent where the run one step expected it")}; }
    val step_name: str = lookup_r.some;

    val output_root_r: res[str, A.Error] = spath.resolve(a, execution_root, home_out);
    if (sel output_root_r.err) { ret err[outcome.Fail].err{outcome.refused(output_root_r.err)}; }
    val output_root: str = output_root_r.ok;

    var ins: vector.Vector[str] = vector.init[str](a);
    val cir: err[outcome.Fail] = collect_step_inputs(a, p, step, execution_root, output_root, ?ins);
    if (sel cir.err) { step_free_inputs(a, ?ins); str_free(a, output_root); ret cir; }

    val invocation_r: res[StepInvocation, outcome.Fail] = expand_step_invocation(a, p, step, home_out, ?v);
    if (sel invocation_r.err) {
        step_free_inputs(a, ?ins);
        str_free(a, output_root);
        ret err[outcome.Fail].err{invocation_r.err};
    }
    var invocation: StepInvocation = invocation_r.ok;

    val program_r: res[str, outcome.Fail] = resolve_step_program(a, execution_root, ?invocation);
    if (sel program_r.err) {
        step_invocation_free(a, ?invocation);
        step_free_inputs(a, ?ins);
        str_free(a, output_root);
        ret err[outcome.Fail].err{program_r.err};
    }
    val program: str = program_r.ok;

    val lookup_r2: opt[str] = intern.lookup(?p.s.interner, p.config.project_root);
    if (sel lookup_r2.none) { ret err[outcome.Fail].err{outcome.internal("interned text is absent where the run one step expected it")}; }
    val consumer_root: str = lookup_r2.some;
    val lookup_r3: opt[str] = intern.lookup(?p.s.interner, p.config.project_out);
    if (sel lookup_r3.none) { ret err[outcome.Fail].err{outcome.internal("interned text is absent where the run one step expected it")}; }
    val consumer_out: str = lookup_r3.some;
    var outputs: Vector[StepPath] = vector.init[StepPath](a);
    val outputs_r: err[outcome.Fail] = collect_step_outputs(a, p, step, execution_root, output_root, ?outputs);
    if (sel outputs_r.err) {
        step_paths_free(a, ?outputs);
        str_free(a, program);
        step_invocation_free(a, ?invocation);
        step_free_inputs(a, ?ins);
        str_free(a, output_root);
        ret outputs_r;
    }
    val output_root_dir_r: err[outcome.Fail] = ensure_physical_directory_path(a, consumer_root, consumer_out, "project output directory");
    if (sel output_root_dir_r.err) {
        step_paths_free(a, ?outputs);
        str_free(a, program);
        step_invocation_free(a, ?invocation);
        step_free_inputs(a, ?ins);
        str_free(a, output_root);
        ret output_root_dir_r;
    }
    val mdr: err[outcome.Fail] = step_make_output_dirs(a, ?outputs);
    if (sel mdr.err) {
        step_paths_free(a, ?outputs);
        str_free(a, program);
        step_invocation_free(a, ?invocation);
        step_free_inputs(a, ?ins);
        str_free(a, output_root);
        ret mdr;
    }

    var output_paths: Vector[str] = vector.init[str](a);
    val output_paths_r: err[outcome.Fail] = step_paths_absolute(a, ?outputs, ?output_paths);
    if (sel output_paths_r.err) {
        step_free_inputs(a, ?output_paths);
        step_paths_free(a, ?outputs);
        str_free(a, program);
        step_invocation_free(a, ?invocation);
        step_free_inputs(a, ?ins);
        str_free(a, output_root);
        ret output_paths_r;
    }

    var prerequisites: StepStrings = StepStrings{items: nil, count: 0};
    val prerequisites_r: res[StepStrings, outcome.Fail] = expand_step_strings(a, p, step.need, step.need_count, home_out, ?v);
    if (sel prerequisites_r.err) {
        step_free_inputs(a, ?output_paths);
        step_paths_free(a, ?outputs);
        str_free(a, program);
        step_invocation_free(a, ?invocation);
        step_free_inputs(a, ?ins);
        str_free(a, output_root);
        ret err[outcome.Fail].err{prerequisites_r.err};
    }
    prerequisites = prerequisites_r.ok;

    var digest: [32]u8;
    val fpr: err[outcome.Fail] = step_fingerprint(a, v.target, v.profile, program, ?invocation.argv, ?invocation.env, ?prerequisites, ?ins, ?output_paths, ?digest[0]);
    step_strings_free(a, ?prerequisites);
    step_free_inputs(a, ?ins);
    if (sel fpr.err) {
        step_free_inputs(a, ?output_paths);
        step_paths_free(a, ?outputs);
        str_free(a, program);
        step_invocation_free(a, ?invocation);
        str_free(a, output_root);
        ret fpr;
    }

    val keyed: err[fail.Fail] = cache_key.step(?p.step_digest, owner_id, step_name, ?digest);
    if (sel keyed.err) {
        step_free_inputs(a, ?output_paths);
        step_paths_free(a, ?outputs);
        str_free(a, program);
        step_invocation_free(a, ?invocation);
        str_free(a, output_root);
        if (sel keyed.err) { ret err[outcome.Fail].err{outcome.from_fail(keyed.err)}; }
        ret err[outcome.Fail].ok{};
    }

    val lookup_r4: opt[str] = intern.lookup(?p.s.interner, p.config.project_root);
    if (sel lookup_r4.none) { ret err[outcome.Fail].err{outcome.internal("interned text is absent where the run one step expected it")}; }
    val root_project: str = lookup_r4.some;
    val lookup_r5: opt[str] = intern.lookup(?p.s.interner, p.config.project_out);
    if (sel lookup_r5.none) { ret err[outcome.Fail].err{outcome.internal("interned text is absent where the run one step expected it")}; }
    val root_out: str = lookup_r5.some;
    val stamp_path: str = step_stamp_path(a, root_project, root_out, owner_id, step_name);
    val hex: str = digest_hex(a, ?digest[0], 32::usize);

    if (!p.req.no_cache && step.out_count > 0 && !str_empty(stamp_path) && !str_empty(hex)
        && stamp_matches(a, stamp_path, hex) && step_final_outputs_current(a, ?outputs)) {
        str_free(a, hex);
        str_free(a, stamp_path);
        step_free_inputs(a, ?output_paths);
        step_paths_free(a, ?outputs);
        str_free(a, program);
        step_invocation_free(a, ?invocation);
        str_free(a, output_root);
        ret err[outcome.Fail].ok{};
    }
    step_free_inputs(a, ?output_paths);

    val staging_root: str = step_staging_root(a, output_root, step_name);
    val staging_home_out: str = step_staging_home_out(a, home_out, step_name);
    if (str_empty(staging_root) || str_empty(staging_home_out)) {
        str_free(a, hex); str_free(a, stamp_path);
        str_free(a, staging_root); str_free(a, staging_home_out);
        step_paths_free(a, ?outputs);
        str_free(a, program);
        step_invocation_free(a, ?invocation);
        str_free(a, output_root);
        ret err[outcome.Fail].err{outcome.user("out of memory constructing build step staging paths")};
    }

    val prep_r: err[outcome.Fail] = step_prepare_staging(a, output_root, staging_root, step_name);
    if (sel prep_r.err) {
        str_free(a, hex); str_free(a, stamp_path);
        str_free(a, staging_root); str_free(a, staging_home_out);
        step_paths_free(a, ?outputs);
        str_free(a, program);
        step_invocation_free(a, ?invocation);
        str_free(a, output_root);
        ret prep_r;
    }
    val staging_dirs_r: err[outcome.Fail] = step_make_staging_dirs(a, output_root, staging_root, ?outputs);
    if (sel staging_dirs_r.err) {
        str_free(a, hex); str_free(a, stamp_path);
        str_free(a, staging_root); str_free(a, staging_home_out);
        step_paths_free(a, ?outputs);
        str_free(a, program);
        step_invocation_free(a, ?invocation);
        str_free(a, output_root);
        ret staging_dirs_r;
    }

    val staging_invocation_r: res[StepInvocation, outcome.Fail] = expand_step_invocation(a, p, step, staging_home_out, ?v);
    if (sel staging_invocation_r.err) {
        str_free(a, hex); str_free(a, stamp_path);
        str_free(a, staging_root); str_free(a, staging_home_out);
        step_paths_free(a, ?outputs);
        str_free(a, program);
        step_invocation_free(a, ?invocation);
        str_free(a, output_root);
        ret err[outcome.Fail].err{staging_invocation_r.err};
    }
    var staging_invocation: StepInvocation = staging_invocation_r.ok;

    val msg: str = sfmt(a, "step {}: {}\n", step_name, invocation.argv.items[0]::str);
    print.print(msg);
    str_free(a, msg);
    step_invocation_free(a, ?invocation);

    val obj_tree: str = module_obj_tree(a, output_root, project.fqn_name(p, p.config.id));
    if (str_empty(obj_tree)) {
        str_free(a, hex); str_free(a, stamp_path);
        str_free(a, staging_root); str_free(a, staging_home_out);
        step_paths_free(a, ?outputs);
        str_free(a, program);
        step_invocation_free(a, ?staging_invocation);
        str_free(a, output_root);
        ret err[outcome.Fail].err{outcome.user("out of memory constructing compiler-owned object tree path")};
    }
    var obj_before: Vector[TreeFile] = vector.init[TreeFile](a);
    val snapshot_r: err[outcome.Fail] = collect_tree_files(a, obj_tree, ?obj_before);
    if (sel snapshot_r.err) {
        free_tree_files(a, ?obj_before);
        str_free(a, obj_tree);
        str_free(a, hex); str_free(a, stamp_path);
        str_free(a, staging_root); str_free(a, staging_home_out);
        step_paths_free(a, ?outputs);
        str_free(a, program);
        step_invocation_free(a, ?staging_invocation);
        str_free(a, output_root);
        ret snapshot_r;
    }

    var staging_before: Vector[TreeFile] = vector.init[TreeFile](a);
    val staging_snapshot_r: err[outcome.Fail] = collect_tree_files(a, staging_root, ?staging_before);
    if (sel staging_snapshot_r.err) {
        free_tree_files(a, ?staging_before);
        free_tree_files(a, ?obj_before);
        str_free(a, obj_tree);
        str_free(a, hex); str_free(a, stamp_path);
        str_free(a, staging_root); str_free(a, staging_home_out);
        step_paths_free(a, ?outputs);
        str_free(a, program);
        step_invocation_free(a, ?staging_invocation);
        str_free(a, output_root);
        ret staging_snapshot_r;
    }

    val res_run: err[outcome.Fail] = execute_step_invocation(a, execution_root, program, ?staging_invocation,
                                                               step_name, step.timeout_seconds);
    str_free(a, program);
    step_invocation_free(a, ?staging_invocation);

    val object_integrity: err[outcome.Fail] = check_step_left_obj_tree(a, ?obj_before, obj_tree, step_name);
    free_tree_files(a, ?obj_before);
    str_free(a, obj_tree);

    var staging_declared: Vector[str] = vector.init[str](a);
    var staging_declared_abs: Vector[str] = vector.init[str](a);
    var output_integrity: err[outcome.Fail] = step_paths_rel_for_root(a, ?outputs, output_root, ?staging_declared);
    val staged_ok: bool = sel output_integrity.ok;
    if (staged_ok) { output_integrity = step_paths_staged_absolute(a, output_root, staging_root, ?outputs, ?staging_declared_abs); }
    val effects_ok: bool = sel output_integrity.ok;
    if (effects_ok) {
        output_integrity = check_step_output_effects(a, ?staging_before, staging_root, ?staging_declared_abs, step_name);
        if (sel res_run.ok) {
            var declared_exec: Vector[str] = vector.init[str](a);
            var declared_r: err[outcome.Fail] = step_paths_rel_for_root(a, ?outputs, execution_root, ?declared_exec);
            val exec_declared: bool = sel declared_r.ok && declared_exec.len > 0;
            if (exec_declared) { declared_r = validate_declared_step_outputs(a, execution_root, ?declared_exec, step_name); }
            val staging_declared_ok: bool = sel declared_r.ok && staging_declared.len > 0;
            if (staging_declared_ok) { declared_r = validate_declared_step_outputs(a, staging_root, ?staging_declared, step_name); }
            step_free_inputs(a, ?declared_exec);
            if (sel declared_r.err) {
                var combined: err[outcome.Fail] = declared_r;
                if (sel output_integrity.err) {
                    combined = err[outcome.Fail].err{outcome.user(sfmt(a, "{}; declared output integrity: {}", outcome.describe(output_integrity.err), outcome.describe(declared_r.err)))};
                }
                output_integrity = combined;
            }
        }
    }
    free_tree_files(a, ?staging_before);
    step_free_inputs(a, ?staging_declared_abs);

    val finished: err[outcome.Fail] = combine_step_terminal_results(a, object_integrity, output_integrity, res_run);
    if (sel finished.err) {
        fs.remove_all(a, staging_root);
        step_free_inputs(a, ?staging_declared);
        str_free(a, hex); str_free(a, stamp_path);
        str_free(a, staging_root); str_free(a, staging_home_out);
        step_paths_free(a, ?outputs);
        str_free(a, output_root);
        ret finished;
    }

    val publish_r: err[outcome.Fail] = publish_staged_outputs(a, staging_root, output_root, ?outputs);
    if (sel publish_r.err) {
        step_free_inputs(a, ?staging_declared);
        str_free(a, hex); str_free(a, stamp_path);
        str_free(a, staging_root); str_free(a, staging_home_out);
        step_paths_free(a, ?outputs);
        str_free(a, output_root);
        ret publish_r;
    }
    fs.remove_all(a, staging_root);
    step_free_inputs(a, ?staging_declared);

    var stamped: err[outcome.Fail] = err[outcome.Fail].ok{};
    if (!p.req.no_cache && step.out_count > 0) {
        val written: err[outcome.Fail] = write_stamp(a, stamp_path, hex);
        if (sel written.err) {
            stamped = err[outcome.Fail].err{outcome.user(sfmt(a, "build step '{}' completed but its cache record could not be published: {}",
                                            step_name, outcome.describe(written.err)))};
        }
    }

    str_free(a, hex);
    str_free(a, stamp_path);
    str_free(a, staging_root);
    str_free(a, staging_home_out);
    step_paths_free(a, ?outputs);
    str_free(a, output_root);
    ret stamped;
}

pub fun execute_steps(a: *A.Allocator, p: *project.Project, project_root: str) err[outcome.Fail] {
    if (p.config.step_order_count == 0) { ret err[outcome.Fail].ok{}; }
    val abs_root_r: res[str, outcome.Fail] = absolute_execution_root(a, project_root);
    if (sel abs_root_r.err) { ret err[outcome.Fail].err{abs_root_r.err}; }
    val abs_root: str = abs_root_r.ok;
    val lookup_r: opt[str] = intern.lookup(?p.s.interner, p.config.project_out);
    if (sel lookup_r.none) { ret err[outcome.Fail].err{outcome.internal("interned text is absent where the execute steps expected it")}; }
    val root_out: str = lookup_r.some;
    val lookup_r2: opt[str] = intern.lookup(?p.s.interner, p.config.id);
    if (sel lookup_r2.none) { ret err[outcome.Fail].err{outcome.internal("interned text is absent where the execute steps expected it")}; }
    val owner_id: str = lookup_r2.some;
    var i: u32 = 0;
    for (i < p.config.step_order_count) {
        val idx: u32 = p.config.step_order[i];
        val outcome_r: err[outcome.Fail] = run_one_step(a, p, ?p.config.steps[idx], abs_root, root_out, owner_id);
        if (sel outcome_r.err) { str_free(a, abs_root); ret outcome_r; }
        i = i + 1;
    }
    str_free(a, abs_root);
    ret err[outcome.Fail].ok{};
}

fun dep_resolve_relative_root(alloc: *A.Allocator, cwd: str, rel: str) res[str, outcome.Fail] {
    val cwd_len: usize = str_len(cwd);
    val rel_len: usize = str_len(rel);
    val cap: usize = cwd_len + rel_len + 2;
    val rb: res[*u8, A.Error] = A.allocate[u8](alloc, cap);
    if (sel rb.err) { ret res[str, outcome.Fail].err{outcome.refused(rb.err)}; }
    val buf: *u8 = rb.ok;

    var k: usize = 0;
    for (k < cwd_len) { buf[k] = cwd[k]; k = k + 1; }

    var i: usize = 0;
    for (i < rel_len) {
        for (i < rel_len && spath.is_separator(rel[i])) { i = i + 1; }
        if (i >= rel_len) { brk; }
        val start: usize = i;
        for (i < rel_len && !spath.is_separator(rel[i])) { i = i + 1; }
        val len: usize = i - start;

        if (len == 1 && rel[start] == '.'::u8) { cnt; }
        if (len == 2 && rel[start] == '.'::u8 && rel[start + 1] == '.'::u8) {
            buf[k] = 0;
            val parent_r: res[str, A.Error] = spath.parent(alloc, buf::str);
            if (sel parent_r.err) {
                A.deallocate[u8](alloc, buf, cap);
                if (sel parent_r.err) { ret res[str, outcome.Fail].err{outcome.refused(parent_r.err)}; }
                ret res[str, outcome.Fail].ok{parent_r.ok};
            }
            val parent: str = parent_r.ok;
            val parent_len: usize = str_len(parent);
            k = 0;
            for (k < parent_len) { buf[k] = parent[k]; k = k + 1; }
            str_free(alloc, parent);
            cnt;
        }

        if (k > 0 && !spath.is_separator(buf[k - 1])) {
            buf[k] = spath.separator();
            k = k + 1;
        }
        var j: usize = 0;
        for (j < len) { buf[k] = rel[start + j]; k = k + 1; j = j + 1; }
    }
    buf[k] = 0;

    val out_r: res[str, string.StrError] = str_copy_slice(alloc, buf::str, 0, k);
    A.deallocate[u8](alloc, buf, cap);
    if (sel out_r.err) { ret res[str, outcome.Fail].err{outcome.user(outcome.str_text(out_r.err))}; }
    ret res[str, outcome.Fail].ok{out_r.ok};
}

pub fun dep_out_home(alloc: *A.Allocator, project_root: str, root_out: str) res[str, outcome.Fail] {
    if (spath.is_abs(project_root)) {
        val resolve_r: res[spath.Path, A.Error] = spath.resolve(alloc, project_root, root_out);
        if (sel resolve_r.err) { ret res[str, outcome.Fail].err{outcome.refused(resolve_r.err)}; }
        ret res[str, outcome.Fail].ok{resolve_r.ok};
    }

    val cwd_r: res[string.OwnedString, env.EnvError] = env.current_dir(alloc);
    if (sel cwd_r.err) { ret res[str, outcome.Fail].err{outcome.user(outcome.env_text(cwd_r.err))}; }
    var cwd: string.OwnedString = cwd_r.ok;

    val root_r: res[str, outcome.Fail] = dep_resolve_relative_root(alloc, cwd.data, project_root);
    string.owned_release(?cwd);
    if (sel root_r.err) { ret res[str, outcome.Fail].err{root_r.err}; }
    val root: str = root_r.ok;

    val out_r: res[str, A.Error] = spath.resolve(alloc, root, root_out);
    str_free(alloc, root);
    if (sel out_r.err) { ret res[str, outcome.Fail].err{outcome.refused(out_r.err)}; }
    ret res[str, outcome.Fail].ok{out_r.ok};
}

# one exported dependency step selected for a cell, by position in the closure
# ---
# dependency: index into `p.config.deps`
# step: index into that dependency manifest's `steps`
pub rec DependencyStep {
    dependency: u32;
    step:       u32;
}

# the exported dependency steps a cell runs, in execution order: each realized
# dependency's export step plan for the cell target, dependencies in closure
# order. shared by `execute_dep_steps` and the build plan display
# ---
# p: the configured project
# isa, os, abi: the cell target tuple
# ret: the ordered steps, owned by the caller; err from the export plan
pub fun plan_dep_steps(p: *project.Project, isa: str, os: str, abi: str) res[Vector[DependencyStep], outcome.Fail] {
    var steps: Vector[DependencyStep] = vector.init[DependencyStep](p.alloc);
    var retained: bool = false;
    fin { if (!retained) { vector.dnit[DependencyStep](?steps); } }
    val n: u32 = p.config.dep_count;
    if (n == 0) { retained = true; ret res[Vector[DependencyStep], outcome.Fail].ok{steps}; }

    var tgt: manifest.TargetDef;
    val ri: res[intern.StrId, A.Error] = intern.intern(?p.s.interner, isa);
    if (sel ri.err) { ret res[Vector[DependencyStep], outcome.Fail].err{outcome.refused(ri.err)}; }
    tgt.isa = ri.ok;
    val ro: res[intern.StrId, A.Error] = intern.intern(?p.s.interner, os);
    if (sel ro.err) { ret res[Vector[DependencyStep], outcome.Fail].err{outcome.refused(ro.err)}; }
    tgt.os = ro.ok;
    val ra: res[intern.StrId, A.Error] = intern.intern(?p.s.interner, abi);
    if (sel ra.err) { ret res[Vector[DependencyStep], outcome.Fail].err{outcome.refused(ra.err)}; }
    tgt.abi = ra.ok;

    val lookup_r: opt[str] = intern.lookup(?p.s.interner, p.config.project_out);
    if (sel lookup_r.none) { ret res[Vector[DependencyStep], outcome.Fail].err{outcome.internal("interned text is absent where the plan dep steps expected it")}; }
    val root_out: str = lookup_r.some;
    var cv: manifest.TmplVars = ddep.cell_tmpl_vars(p);
    var i: u32 = 0;
    for (i < n) {
        val mfd: *manifest.Manifest = ?p.config.deps[i].manifest;
        var order: *u32 = nil;
        var count: u32  = 0;
        val planned: err[outcome.Fail] = manifest.plan_export_steps(p.alloc, ?p.s.interner, mfd, ?tgt, root_out, ?cv, ?order, ?count);
        if (sel planned.err) { ret res[Vector[DependencyStep], outcome.Fail].err{planned.err}; }
        var si: u32 = 0;
        for (si < count) {
            val pushed: res[usize, A.Error] = vector.push[DependencyStep](?steps, DependencyStep{dependency: i, step: order[si]});
            if (sel pushed.err) {
                A.deallocate[u32](p.alloc, order, count::usize);
                ret res[Vector[DependencyStep], outcome.Fail].err{outcome.refused(pushed.err)};
            }
            si = si + 1;
        }
        if (order != nil && count > 0) { A.deallocate[u32](p.alloc, order, count::usize); }
        i = i + 1;
    }
    retained = true;
    ret res[Vector[DependencyStep], outcome.Fail].ok{steps};
}

pub fun execute_dep_steps(p: *project.Project, isa: str, os: str, abi: str) err[outcome.Fail] {
    val planned: res[Vector[DependencyStep], outcome.Fail] = plan_dep_steps(p, isa, os, abi);
    if (sel planned.err) { ret err[outcome.Fail].err{planned.err}; }
    var steps: Vector[DependencyStep] = planned.ok;
    fin { vector.dnit[DependencyStep](?steps); }
    if (steps.len == 0) { ret err[outcome.Fail].ok{}; }

    val lookup_r: opt[str] = intern.lookup(?p.s.interner, p.config.project_out);
    if (sel lookup_r.none) { ret err[outcome.Fail].err{outcome.internal("interned text is absent where the execute dep steps expected it")}; }
    val root_out: str = lookup_r.some;
    val lookup_r2: opt[str] = intern.lookup(?p.s.interner, p.config.project_root);
    if (sel lookup_r2.none) { ret err[outcome.Fail].err{outcome.internal("interned text is absent where the execute dep steps expected it")}; }
    val root_project: str = lookup_r2.some;
    val hr: res[str, outcome.Fail] = dep_out_home(p.alloc, root_project, root_out);
    if (sel hr.err) { ret err[outcome.Fail].err{hr.err}; }
    val dep_home: str = hr.ok;
    fin { str_free(p.alloc, dep_home); }

    var i: usize = 0;
    for (i < steps.len) {
        val selected: DependencyStep = steps.data[i];
        val mfd: *manifest.Manifest = ?p.config.deps[selected.dependency].manifest;
        val vr_opt: opt[str] = intern.lookup(?p.s.interner, p.config.deps[selected.dependency].vendor_root);
        val dep_owner_opt: opt[str] = intern.lookup(?p.s.interner, mfd.id);
        if (sel vr_opt.none) { ret err[outcome.Fail].err{outcome.user("internal: dep metadata not interned")}; }
        if (sel dep_owner_opt.none) { ret err[outcome.Fail].err{outcome.user("internal: dep metadata not interned")}; }
        val dep_abs_r: res[str, outcome.Fail] = absolute_execution_root(p.alloc, vr_opt.some);
        if (sel dep_abs_r.err) { ret err[outcome.Fail].err{dep_abs_r.err}; }
        val dep_abs: str = dep_abs_r.ok;
        val rs: err[outcome.Fail] = run_one_step(p.alloc, p, ?mfd.steps[selected.step], dep_abs, dep_home, dep_owner_opt.some);
        str_free(p.alloc, dep_abs);
        if (sel rs.err) { ret err[outcome.Fail].err{rs.err}; }
        i = i + 1;
    }
    ret err[outcome.Fail].ok{};
}

fun cfg_contains(hay: str, needle: str) bool {
    val hn: usize = str_len(hay);
    val nn: usize = str_len(needle);
    if (nn > hn) { ret false; }
    var i: usize = 0;
    for (i + nn <= hn) {
        var j: usize = 0;
        for (j < nn && hay[i + j] == needle[j]) { j = j + 1; }
        if (j == nn) { ret true; }
        i = i + 1;
    }
    ret false;
}

rec CloneAllocProbe {
    backing:   A.Allocator;
    remaining: u32;
    live:      u32;
}

fun clone_probe_alloc(ctx: ptr, size: usize, align: usize) opt[ptr] {
    val p: *CloneAllocProbe = ctx::*CloneAllocProbe;
    if (p.remaining == 0) { ret opt[ptr].none{}; }
    p.remaining = p.remaining - 1;
    val r: opt[ptr] = p.backing.fn_allocate(p.backing.ctx, size, align);
    if (sel r.some) { p.live = p.live + 1; }
    ret r;
}

fun clone_probe_realloc(ctx: ptr, item: ptr, old_size: usize, new_size: usize, align: usize) opt[ptr] {
    ret opt[ptr].none{};
}

fun clone_probe_dealloc(ctx: ptr, item: ptr, size: usize, align: usize) i64 {
    val p: *CloneAllocProbe = ctx::*CloneAllocProbe;
    p.live = p.live - 1;
    ret p.backing.fn_deallocate(p.backing.ctx, item, size, align);
}

test "mach.lang.driver.config.clone_step:allocation_failure_is_atomic" {
    var probe: CloneAllocProbe;
    val make_r: err[A.Error] = page.make(?probe.backing);
    if (sel make_r.err) { ret 1; }
    probe.remaining = 2;
    probe.live = 0;
    var alloc: A.Allocator;
    val probe_ptr: *CloneAllocProbe = ?probe;
    alloc.ctx = probe_ptr::ptr;
    alloc.fn_allocate = clone_probe_alloc;
    alloc.fn_reallocate = clone_probe_realloc;
    alloc.fn_deallocate = clone_probe_dealloc;

    var argv: [1]intern.StrId;
    var env_keys: [1]intern.StrId;
    var env_values: [1]intern.StrId;
    argv[0] = 1;
    env_keys[0] = 2;
    env_values[0] = 3;
    var src: manifest.StepDef;
    src.name = 4;
    src.argv = ?argv[0];
    src.argv_count = 1;
    src.env_keys = ?env_keys[0];
    src.env_values = ?env_values[0];
    src.env_count = 1;
    src.in = nil;
    src.in_count = 0;
    src.out = nil;
    src.out_count = 0;
    src.need = nil;
    src.need_count = 0;
    var out: manifest.StepDef;
    out.name = 99;
    val r: err[outcome.Fail] = clone_step(?alloc, ?src, ?out);
    if (sel r.ok) { ret 1; }
    if (out.name != 99) { ret 1; }
    if (probe.live != 0) { ret 1; }
    ret 0;
}

fun cfg_raw_nul_manifest_rejected(alloc: *A.Allocator, suffix: str) bool {
    val prefix: str = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";
    val prefix_len: usize = str_len(prefix);
    val suffix_len: usize = str_len(suffix);
    val total: usize = prefix_len + 1 + suffix_len;
    val bytes_r: res[*u8, A.Error] = A.allocate[u8](alloc, total);
    if (sel bytes_r.err) { ret false; }
    val bytes: *u8 = bytes_r.ok;
    var i: usize = 0;
    for (i < prefix_len) { bytes[i] = prefix[i]; i = i + 1; }
    bytes[prefix_len] = 0;
    i = 0;
    for (i < suffix_len) { bytes[prefix_len + 1 + i] = suffix[i]; i = i + 1; }

    val temp_r: res[fs.TempFile, fs.FsError] = fs.temp_create(alloc, "mach_nul_manifest");
    if (sel temp_r.err) { A.deallocate[u8](alloc, bytes, total); ret false; }
    var temp: fs.TempFile = temp_r.ok;
    val write_r: err[fs.FsError] = fs.write_bytes(fs.temp_path(?temp), bytes, total, 0o600);
    A.deallocate[u8](alloc, bytes, total);
    if (sel write_r.err) { fs.temp_close_and_remove(?temp); ret false; }
    val parse_r: res[toml.Table, outcome.Fail] = ddep.parse_toml_file(alloc, fs.temp_path(?temp));
    fs.temp_close_and_remove(?temp);
    if (sel parse_r.ok) {
        var table: toml.Table = parse_r.ok;
        toml.dnit(alloc, ?table);
        ret false;
    }
    ret cfg_contains(outcome.describe(parse_r.err), "NUL");
}

test "mach.lang.driver.config.parse_toml_file:raw_nul_rejects_trailing_bytes" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    if (!cfg_raw_nul_manifest_rejected(?alloc, "[profile.debug]\nopt=0\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n")) { ret 1; }
    if (!cfg_raw_nul_manifest_rejected(?alloc, "not = [valid TOML")) { ret 1; }
    ret 0;
}

test "mach.lang.driver.config.execute_step_invocation:exact_argv_and_environment" {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }

    var argv: [6]*u8;
    argv[0] = "sh";
    argv[1] = "-c";
    argv[2] = "test \"$1\" = \"$LITERAL\" && test -z \"${HOME+x}\" && test -z \"${MACH_TARGET_ISA+x}\"";
    argv[3] = "mach-step";
    argv[4] = "literal \"';$&|<>*?[]";
    argv[5] = nil;
    var envp: [2]*u8;
    envp[0] = "LITERAL=literal \"';$&|<>*?[]";
    envp[1] = nil;
    var invocation: StepInvocation;
    invocation.argv = StepStrings{items: ?argv[0], count: 5};
    invocation.env = StepStrings{items: ?envp[0], count: 1};
    val shell_r: res[str, outcome.Fail] = resolve_step_program(?alloc, "/", ?invocation);
    if (sel shell_r.err) { ret 1; }
    val shell: str = shell_r.ok;
    val shell_run: err[outcome.Fail] = execute_step_invocation(?alloc, "/", shell, ?invocation, "probe", 0);
    str_free(?alloc, shell);
    if (sel shell_run.err) { ret 1; }

    var empty_env: [1]*u8;
    empty_env[0] = nil;
    var env_argv: [2]*u8;
    env_argv[0] = "env";
    env_argv[1] = nil;
    invocation.argv = StepStrings{items: ?env_argv[0], count: 1};
    invocation.env = StepStrings{items: ?empty_env[0], count: 0};
    val env_program_r: res[str, outcome.Fail] = resolve_step_program(?alloc, "/", ?invocation);
    if (sel env_program_r.err) { ret 1; }
    val env_program: str = env_program_r.ok;
    val temp_r: res[fs.TempFile, fs.FsError] = fs.temp_create(?alloc, "mach_step_env");
    if (sel temp_r.err) { str_free(?alloc, env_program); ret 1; }
    var temp: fs.TempFile = temp_r.ok;
    val temp_close_r: err[io_error.Error] = fs.temp_close(?temp);
    if (sel temp_close_r.err) { str_free(?alloc, env_program); ret 1; }
    var child: subprocess.OwnedSubprocess;
    subprocess.init(?child);
    val spawn_r: err[subprocess.Error] = subprocess.spawn_captured(?alloc, ?child, env_program, ?env_argv[0], ?empty_env[0], fs.temp_path(?temp), 64);
    str_free(?alloc, env_program);
    if (sel spawn_r.err) { fs.temp_remove(?temp); ret 1; }
    val wait_r: res[subprocess.SubprocessTerminal, subprocess.Error] = subprocess.wait(?alloc, ?child);
    if (sel wait_r.err) { fs.temp_remove(?temp); ret 1; }
    val terminal: subprocess.SubprocessTerminal = wait_r.ok;
    val capture_r: res[subprocess.CaptureIoResult, subprocess.Error] = subprocess.finish_capture(?alloc, ?child, true);
    if (sel capture_r.err) { fs.temp_remove(?temp); ret 1; }
    val capture: subprocess.CaptureIoResult = capture_r.ok;
    var captured: usize = 0;
    subprocess.capture_bytes(?child, ?captured);
    val released: err[subprocess.Error] = subprocess.release_capture(?alloc, ?child);
    fs.temp_remove(?temp);
    if (terminal.kind != subprocess.STATE_EXITED) { ret 1; }
    if (terminal.code != 0) { ret 1; }
    if (capture.read_failed) { ret 1; }
    if (captured != 0) { ret 1; }
    if (sel released.err) { ret 1; }
    ret 0;
}

test "mach.lang.driver.config.execute_step_invocation:failure_states" {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var empty_env: [1]*u8;
    empty_env[0] = nil;
    var invocation: StepInvocation;
    invocation.env = StepStrings{items: ?empty_env[0], count: 0};

    var missing_argv: [2]*u8;
    missing_argv[0] = "definitely-not-a-mach-step-executable";
    missing_argv[1] = nil;
    invocation.argv = StepStrings{items: ?missing_argv[0], count: 1};
    val missing: res[str, outcome.Fail] = resolve_step_program(?alloc, "/", ?invocation);
    if (sel missing.ok) { ret 1; }
    if (!cfg_contains(outcome.describe(missing.err), "planner PATH")) { ret 1; }

    var spawn_argv: [2]*u8;
    spawn_argv[0] = "/definitely/not/a/mach-step-executable";
    spawn_argv[1] = nil;
    invocation.argv = StepStrings{items: ?spawn_argv[0], count: 1};
    val spawn_program_r: res[str, outcome.Fail] = resolve_step_program(?alloc, "/", ?invocation);
    if (sel spawn_program_r.err) { ret 1; }
    val spawn_program: str = spawn_program_r.ok;
    val spawn_failed: err[outcome.Fail] = execute_step_invocation(?alloc, "/", spawn_program, ?invocation, "probe", 0);
    str_free(?alloc, spawn_program);
    if (sel spawn_failed.ok) { ret 1; }
    if (!cfg_contains(outcome.describe(spawn_failed.err), "code 127")) { ret 1; }

    var exit_argv: [4]*u8;
    exit_argv[0] = "sh";
    exit_argv[1] = "-c";
    exit_argv[2] = "exit 7";
    exit_argv[3] = nil;
    invocation.argv = StepStrings{items: ?exit_argv[0], count: 3};
    val exit_program_r: res[str, outcome.Fail] = resolve_step_program(?alloc, "/", ?invocation);
    if (sel exit_program_r.err) { ret 1; }
    val exit_program: str = exit_program_r.ok;
    val exited: err[outcome.Fail] = execute_step_invocation(?alloc, "/", exit_program, ?invocation, "probe", 0);
    str_free(?alloc, exit_program);
    if (sel exited.ok) { ret 1; }
    if (!cfg_contains(outcome.describe(exited.err), "code 7")) { ret 1; }

    var signal_argv: [4]*u8;
    signal_argv[0] = "sh";
    signal_argv[1] = "-c";
    signal_argv[2] = "kill -TERM $$";
    signal_argv[3] = nil;
    invocation.argv = StepStrings{items: ?signal_argv[0], count: 3};
    val signal_program_r: res[str, outcome.Fail] = resolve_step_program(?alloc, "/", ?invocation);
    if (sel signal_program_r.err) { ret 1; }
    val signal_program: str = signal_program_r.ok;
    val signaled: err[outcome.Fail] = execute_step_invocation(?alloc, "/", signal_program, ?invocation, "probe", 0);
    str_free(?alloc, signal_program);
    if (sel signaled.ok) { ret 1; }
    if (!cfg_contains(outcome.describe(signaled.err), "terminated by signal")) { ret 1; }
    ret 0;
}

test "mach.lang.driver.config.glob:dot_names_errors_and_symlinks" {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }

    val tf_r: res[fs.TempFile, fs.FsError] = fs.temp_create(?alloc, "mach_step_glob");
    if (sel tf_r.err) { ret 1; }
    var tf: fs.TempFile = tf_r.ok;
    val root_r: res[str, A.Error] = str_dup(?alloc, fs.temp_path(?tf));
    fs.temp_close_and_remove(?tf);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    val create_dir_r: err[io_error.Error] = fs.create_dir(root, 0o700);
    if (sel create_dir_r.err) { str_free(?alloc, root); ret 1; }

    val hidden: str = sfmt(?alloc, "{}/.hidden", root);
    val visible: str = sfmt(?alloc, "{}/visible", root);
    val write_bytes_r2: err[fs.FsError] = fs.write_bytes(hidden, "h", 1, 0o600);
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(visible, "v", 1, 0o600);
    if (sel write_bytes_r2.err) {
        fs.remove_all(?alloc, root);
        str_free(?alloc, root);
        ret 1;
    }
    if (sel write_bytes_r.err) {
        fs.remove_all(?alloc, root);
        str_free(?alloc, root);
        ret 1;
    }

    var matches: vector.Vector[str] = vector.init[str](?alloc);
    val dot_r: err[outcome.Fail] = glob_expand_pattern(?alloc, root, ".*", ?matches);
    var bad: bool = sel dot_r.err || matches.len != 1;
    if (!bad && !cfg_contains(matches.data[0], ".hidden")) { bad = true; }
    step_free_inputs(?alloc, ?matches);

    var missing: vector.Vector[str] = vector.init[str](?alloc);
    val missing_r: err[outcome.Fail] = glob_expand_pattern(?alloc, root, "missing/*.c", ?missing);
    if (!(sel missing_r.err && cfg_contains(outcome.describe(missing_r.err), "does not exist"))) { bad = true; }
    step_free_inputs(?alloc, ?missing);

    val link: str = sfmt(?alloc, "{}/link", root);
    val symlink_r: err[io_error.Error] = fs.symlink(hidden, link);
    if (sel symlink_r.err) { bad = true; }
    if (sel symlink_r.ok) {
        var linked: vector.Vector[str] = vector.init[str](?alloc);
        val linked_r: err[outcome.Fail] = glob_expand_pattern(?alloc, root, "*", ?linked);
        if (!(sel linked_r.err && cfg_contains(outcome.describe(linked_r.err), "symlink"))) { bad = true; }
        step_free_inputs(?alloc, ?linked);
    }

    val real: str = sfmt(?alloc, "{}/real", root);
    val real_file: str = sfmt(?alloc, "{}/real/input.c", root);
    val jump: str = sfmt(?alloc, "{}/jump", root);
    val create_dir_r2: err[io_error.Error] = fs.create_dir(real, 0o700);
    val write_bytes_r3: err[fs.FsError] = fs.write_bytes(real_file, "c", 1, 0o600);
    val symlink_r2: err[io_error.Error] = fs.symlink(real, jump);
    if (sel create_dir_r2.err || sel write_bytes_r3.err || sel symlink_r2.err) { bad = true; }
    or {
        var escaped: vector.Vector[str] = vector.init[str](?alloc);
        val escaped_r: err[outcome.Fail] = glob_expand_pattern(?alloc, root, "jump/*.c", ?escaped);
        if (!(sel escaped_r.err && cfg_contains(outcome.describe(escaped_r.err), "symlink component"))) { bad = true; }
        step_free_inputs(?alloc, ?escaped);
    }

    val plain_ok: err[outcome.Fail] = validate_physical_path(?alloc, root, "visible", PHYSICAL_REGULAR, "build step input");
    if (sel plain_ok.err) { bad = true; }
    val plain_dir: err[outcome.Fail] = validate_physical_path(?alloc, root, "real", PHYSICAL_REGULAR, "build step input");
    if (sel plain_dir.ok) { bad = true; }

    str_free(?alloc, jump);
    str_free(?alloc, real_file);
    str_free(?alloc, real);
    str_free(?alloc, link);
    str_free(?alloc, hidden);
    str_free(?alloc, visible);
    fs.remove_all(?alloc, root);
    str_free(?alloc, root);
    if (bad) { ret 1; }
    ret 0;
}

test "mach.lang.driver.config.glob:implicit_pattern_skips_hidden_file_and_hidden_directory" {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }

    val tf_r: res[fs.TempFile, fs.FsError] = fs.temp_create(?alloc, "mach_step_glob_implicit");
    if (sel tf_r.err) { ret 1; }
    var tf: fs.TempFile = tf_r.ok;
    val root_r: res[str, A.Error] = str_dup(?alloc, fs.temp_path(?tf));
    fs.temp_close_and_remove(?tf);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    val create_dir_r: err[io_error.Error] = fs.create_dir(root, 0o700);
    if (sel create_dir_r.err) { str_free(?alloc, root); ret 1; }

    val hidden_file: str = sfmt(?alloc, "{}/.hidden.c", root);
    val visible_file: str = sfmt(?alloc, "{}/visible.c", root);
    val hidden_dir: str = sfmt(?alloc, "{}/.hidden_dir", root);
    val nested_file: str = sfmt(?alloc, "{}/.hidden_dir/nested.c", root);
    var bad: bool = false;
    val write_bytes_r3: err[fs.FsError] = fs.write_bytes(hidden_file, "h", 1, 0o600);
    val write_bytes_r2: err[fs.FsError] = fs.write_bytes(visible_file, "v", 1, 0o600);
    val create_dir_r2: err[io_error.Error] = fs.create_dir(hidden_dir, 0o700);
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(nested_file, "n", 1, 0o600);
    if (sel write_bytes_r3.err
        || sel write_bytes_r2.err
        || sel create_dir_r2.err
        || sel write_bytes_r.err) { bad = true; }

    var top: vector.Vector[str] = vector.init[str](?alloc);
    val top_r: err[outcome.Fail] = glob_expand_pattern(?alloc, root, "*.c", ?top);
    if (sel top_r.err || top.len != 1) { bad = true; }
    if (!bad && !cfg_contains(top.data[0], "visible.c")) { bad = true; }
    if (!bad && cfg_contains(top.data[0], "hidden")) { bad = true; }
    step_free_inputs(?alloc, ?top);

    var deep: vector.Vector[str] = vector.init[str](?alloc);
    val deep_r: err[outcome.Fail] = glob_expand_pattern(?alloc, root, "**/*.c", ?deep);
    if (sel deep_r.err || deep.len != 1) { bad = true; }
    if (!bad && !cfg_contains(deep.data[0], "visible.c")) { bad = true; }
    step_free_inputs(?alloc, ?deep);

    str_free(?alloc, nested_file);
    str_free(?alloc, hidden_dir);
    str_free(?alloc, visible_file);
    str_free(?alloc, hidden_file);
    fs.remove_all(?alloc, root);
    str_free(?alloc, root);
    if (bad) { ret 1; }
    ret 0;
}

test "mach.lang.driver.config.path_in_module_obj_tree:boundaries" {
    val tree: str = "out/linux/debug/obj/vend";
    if (!path_in_module_obj_tree("out/linux/debug/obj/vend", tree))            { ret 1; }
    if (!path_in_module_obj_tree("out/linux/debug/obj/vend/window.o", tree))   { ret 2; }
    if (!path_in_module_obj_tree("out/linux/debug/obj/vend/gl/ctx.o", tree))   { ret 3; }
    if (path_in_module_obj_tree("out/linux/debug/obj/vend-c/window.o", tree))  { ret 4; }
    if (path_in_module_obj_tree("out/linux/debug/obj/other/window.o", tree))   { ret 5; }
    if (path_in_module_obj_tree("out/linux/debug/vendor/window.o", tree))      { ret 6; }
    ret 0;
}

test "mach.lang.driver.config.validate_declared_step_output_collisions:deterministic" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var outputs: Vector[DeclaredStepOutput] = vector.init[DeclaredStepOutput](?alloc);
    val push_r: res[usize, A.Error] = vector.push[DeclaredStepOutput](?outputs, DeclaredStepOutput{path: "out/generated", step: "zeta"});
    if (sel push_r.err) { ret 1; }
    val push_r2: res[usize, A.Error] = vector.push[DeclaredStepOutput](?outputs, DeclaredStepOutput{path: "out/generated", step: "alpha"});
    if (sel push_r2.err) { vector.dnit[DeclaredStepOutput](?outputs); ret 1; }
    val exact: err[outcome.Fail] = validate_declared_step_output_collisions(?alloc, ?outputs);
    var bad: bool = sel exact.ok;
    if (sel exact.err) {
        val msg: str = outcome.describe(exact.err);
        if (!cfg_contains(msg, "[step.alpha]") || !cfg_contains(msg, "[step.zeta]")) { bad = true; }
        str_free(?alloc, msg);
    }
    vector.dnit[DeclaredStepOutput](?outputs);

    outputs = vector.init[DeclaredStepOutput](?alloc);
    val push_r3: res[usize, A.Error] = vector.push[DeclaredStepOutput](?outputs, DeclaredStepOutput{path: "out/generated/file", step: "zeta"});
    if (sel push_r3.err) { ret 1; }
    val push_r4: res[usize, A.Error] = vector.push[DeclaredStepOutput](?outputs, DeclaredStepOutput{path: "out/generated", step: "alpha"});
    if (sel push_r4.err) { vector.dnit[DeclaredStepOutput](?outputs); ret 1; }
    val nested: err[outcome.Fail] = validate_declared_step_output_collisions(?alloc, ?outputs);
    if (sel nested.ok) { bad = true; }
    if (sel nested.err) {
        val msg: str = outcome.describe(nested.err);
        if (!cfg_contains(msg, "collides")) { bad = true; }
        str_free(?alloc, msg);
    }
    vector.dnit[DeclaredStepOutput](?outputs);

    outputs = vector.init[DeclaredStepOutput](?alloc);
    val push_r5: res[usize, A.Error] = vector.push[DeclaredStepOutput](?outputs, DeclaredStepOutput{path: "out/generated/file", step: "alpha"});
    if (sel push_r5.err) { ret 1; }
    val push_r6: res[usize, A.Error] = vector.push[DeclaredStepOutput](?outputs, DeclaredStepOutput{path: "out/generated", step: "alpha"});
    if (sel push_r6.err) { vector.dnit[DeclaredStepOutput](?outputs); ret 1; }
    val same_step_nested: err[outcome.Fail] = validate_declared_step_output_collisions(?alloc, ?outputs);
    if (sel same_step_nested.ok) { bad = true; }
    if (sel same_step_nested.err) {
        val msg: str = outcome.describe(same_step_nested.err);
        if (!cfg_contains(msg, "collides")) { bad = true; }
        str_free(?alloc, msg);
    }
    vector.dnit[DeclaredStepOutput](?outputs);

    outputs = vector.init[DeclaredStepOutput](?alloc);
    val push_r7: res[usize, A.Error] = vector.push[DeclaredStepOutput](?outputs, DeclaredStepOutput{path: "out/a", step: "alpha"});
    if (sel push_r7.err) { ret 1; }
    val push_r8: res[usize, A.Error] = vector.push[DeclaredStepOutput](?outputs, DeclaredStepOutput{path: "out/b", step: "beta"});
    if (sel push_r8.err) { vector.dnit[DeclaredStepOutput](?outputs); ret 1; }
    val separate: err[outcome.Fail] = validate_declared_step_output_collisions(?alloc, ?outputs);
    if (sel separate.err) { bad = true; }
    vector.dnit[DeclaredStepOutput](?outputs);
    if (bad) { ret 1; }
    ret 0;
}

test "mach.lang.driver.config.step_outputs:physical_and_declared_effects" {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val tf_r: res[fs.TempFile, fs.FsError] = fs.temp_create(?alloc, "mach_step_outputs");
    if (sel tf_r.err) { ret 1; }
    var tf: fs.TempFile = tf_r.ok;
    val root_r: res[str, A.Error] = str_dup(?alloc, fs.temp_path(?tf));
    fs.temp_close_and_remove(?tf);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    val create_dir_r: err[io_error.Error] = fs.create_dir(root, 0o700);
    if (sel create_dir_r.err) { str_free(?alloc, root); ret 1; }
    var bad: bool = false;

    val made: err[outcome.Fail] = ensure_physical_directory_path(?alloc, root, "out/declared", "build step output directory");
    if (sel made.err) { bad = true; }
    val result_file: str = sfmt(?alloc, "{}/out/result", root);
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(result_file, "ok", 2, 0o600);
    if (sel write_bytes_r.err) { bad = true; }
    var declared_rel: Vector[str] = vector.init[str](?alloc);
    val push_r: res[usize, A.Error] = vector.push[str](?declared_rel, "out/result");
    if (sel push_r.err) { bad = true; }
    val valid_file: err[outcome.Fail] = validate_declared_step_outputs(?alloc, root, ?declared_rel, "generate");
    if (sel valid_file.err) { bad = true; }
    vector.dnit[str](?declared_rel);

    declared_rel = vector.init[str](?alloc);
    val push_r2: res[usize, A.Error] = vector.push[str](?declared_rel, "out/missing");
    if (sel push_r2.err) { bad = true; }
    val missing: err[outcome.Fail] = validate_declared_step_outputs(?alloc, root, ?declared_rel, "generate");
    if (!(sel missing.err && cfg_contains(outcome.describe(missing.err), "did not publish"))) { bad = true; }
    vector.dnit[str](?declared_rel);

    val linked_output: str = sfmt(?alloc, "{}/out/linked", root);
    val symlink_r: err[io_error.Error] = fs.symlink(result_file, linked_output);
    if (sel symlink_r.err) { bad = true; }
    if (sel symlink_r.ok) {
        declared_rel = vector.init[str](?alloc);
        val push_r3: res[usize, A.Error] = vector.push[str](?declared_rel, "out/linked");
        if (sel push_r3.err) { bad = true; }
        val linked: err[outcome.Fail] = validate_declared_step_outputs(?alloc, root, ?declared_rel, "generate");
        if (!(sel linked.err && cfg_contains(outcome.describe(linked.err), "symlink"))) { bad = true; }
        vector.dnit[str](?declared_rel);
        fs.remove_file(linked_output);
    }

    val outside: str = sfmt(?alloc, "{}/outside", root);
    val bridge: str = sfmt(?alloc, "{}/out/bridge", root);
    val create_dir_r2: err[io_error.Error] = fs.create_dir(outside, 0o700);
    val symlink_r2: err[io_error.Error] = fs.symlink(outside, bridge);
    if (sel create_dir_r2.ok) {
        if (sel symlink_r2.ok) {
            val escaped: err[outcome.Fail] = ensure_physical_directory_path(?alloc, root, "out/bridge/nested", "build step output directory");
            if (!(sel escaped.err && cfg_contains(outcome.describe(escaped.err), "symlink"))) { bad = true; }
            fs.remove_file(bridge);
    }
        if (sel symlink_r2.err) { bad = true; }
    }
    if (sel create_dir_r2.err) { bad = true; }

    val output_root: str = sfmt(?alloc, "{}/out", root);
    var before: Vector[TreeFile] = vector.init[TreeFile](?alloc);
    val collect_tree_files_r: err[outcome.Fail] = collect_tree_files(?alloc, output_root, ?before);
    if (sel collect_tree_files_r.err) { bad = true; }
    val declared_file: str = sfmt(?alloc, "{}/out/declared/result", root);
    val rogue_file: str = sfmt(?alloc, "{}/out/rogue", root);
    val write_bytes_r3: err[fs.FsError] = fs.write_bytes(declared_file, "yes", 3, 0o600);
    val write_bytes_r2: err[fs.FsError] = fs.write_bytes(rogue_file, "no", 2, 0o600);
    if (sel write_bytes_r3.err || sel write_bytes_r2.err) { bad = true; }
    var declared_abs: Vector[str] = vector.init[str](?alloc);
    val declared_dir: str = sfmt(?alloc, "{}/out/declared", root);
    val push_r4: res[usize, A.Error] = vector.push[str](?declared_abs, declared_dir);
    if (sel push_r4.err) { bad = true; }
    val effects: err[outcome.Fail] = check_step_output_effects(?alloc, ?before, output_root, ?declared_abs, "generate");
    if (!(sel effects.err && cfg_contains(outcome.describe(effects.err), "rogue"))) { bad = true; }
    val failed_combined: err[outcome.Fail] = combine_step_terminal_results(?alloc, err[outcome.Fail].ok{}, effects, err[outcome.Fail].err{outcome.user("build step exited with code 9")});
    if (!(sel failed_combined.err && (str_starts_with(outcome.describe(failed_combined.err), "build step 'generate' created or modified undeclared output") && cfg_contains(outcome.describe(failed_combined.err), "execution outcome: build step exited with code 9")))) { bad = true; }
    fs.remove_file(rogue_file);
    val allowed: err[outcome.Fail] = check_step_output_effects(?alloc, ?before, output_root, ?declared_abs, "generate");
    if (sel allowed.err) { bad = true; }

    val empty_added: str = sfmt(?alloc, "{}/out/empty-added", root);
    val create_dir_r3: err[io_error.Error] = fs.create_dir(empty_added, 0o700);
    if (sel create_dir_r3.err) { bad = true; }
    val added_dir_effect: err[outcome.Fail] = check_step_output_effects(?alloc, ?before, output_root, ?declared_abs, "generate");
    if (!(sel added_dir_effect.err && cfg_contains(outcome.describe(added_dir_effect.err), "empty-added"))) { bad = true; }
    fs.remove_all(?alloc, empty_added);

    val empty_removed: str = sfmt(?alloc, "{}/out/empty-removed", root);
    val create_dir_r4: err[io_error.Error] = fs.create_dir(empty_removed, 0o700);
    if (sel create_dir_r4.err) { bad = true; }
    var before_removed: Vector[TreeFile] = vector.init[TreeFile](?alloc);
    val collect_tree_files_r2: err[outcome.Fail] = collect_tree_files(?alloc, output_root, ?before_removed);
    if (sel collect_tree_files_r2.err) { bad = true; }
    fs.remove_all(?alloc, empty_removed);
    val removed_dir_effect: err[outcome.Fail] = check_step_output_effects(?alloc, ?before_removed, output_root, ?declared_abs, "generate");
    if (!(sel removed_dir_effect.err && cfg_contains(outcome.describe(removed_dir_effect.err), "empty-removed"))) { bad = true; }
    free_tree_files(?alloc, ?before_removed);

    val empty_old: str = sfmt(?alloc, "{}/out/empty-old", root);
    val empty_new: str = sfmt(?alloc, "{}/out/empty-new", root);
    val create_dir_r5: err[io_error.Error] = fs.create_dir(empty_old, 0o700);
    if (sel create_dir_r5.err) { bad = true; }
    var before_renamed: Vector[TreeFile] = vector.init[TreeFile](?alloc);
    val collect_tree_files_r3: err[outcome.Fail] = collect_tree_files(?alloc, output_root, ?before_renamed);
    if (sel collect_tree_files_r3.err) { bad = true; }
    val rename_r: err[io_error.Error] = fs.rename(empty_old, empty_new);
    if (sel rename_r.err) { bad = true; }
    val renamed_dir_effect: err[outcome.Fail] = check_step_output_effects(?alloc, ?before_renamed, output_root, ?declared_abs, "generate");
    if (!(sel renamed_dir_effect.err && cfg_contains(outcome.describe(renamed_dir_effect.err), "empty-new"))) { bad = true; }
    free_tree_files(?alloc, ?before_renamed);

    free_tree_files(?alloc, ?before);
    step_free_inputs(?alloc, ?declared_abs);
    str_free(?alloc, empty_new);
    str_free(?alloc, empty_old);
    str_free(?alloc, empty_removed);
    str_free(?alloc, empty_added);
    str_free(?alloc, rogue_file);
    str_free(?alloc, declared_file);
    str_free(?alloc, output_root);
    str_free(?alloc, bridge);
    str_free(?alloc, outside);
    str_free(?alloc, linked_output);
    str_free(?alloc, result_file);
    fs.remove_all(?alloc, root);
    str_free(?alloc, root);
    if (bad) { ret 1; }
    ret 0;
}

test "mach.lang.driver.config.check_step_left_obj_tree:new_file_only" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }

    val tf_r: res[fs.TempFile, fs.FsError] = fs.temp_create(?alloc, "mach_steptree_test");
    if (sel tf_r.err) { ret 1; }
    var tf: fs.TempFile = tf_r.ok;
    val dup_r: res[str, A.Error] = str_dup(?alloc, fs.temp_path(?tf));
    fs.temp_close_and_remove(?tf);
    if (sel dup_r.err) { ret 1; }
    val tree: str = dup_r.ok;
    val create_dir_all_r: err[fs.FsError] = fs.create_dir_all(?alloc, tree, 493);
    if (sel create_dir_all_r.err) { ret 1; }

    var bad: i32 = 0;

    val stale: str = sfmt(?alloc, "{}/main.o", tree);
    fs.write_bytes(stale, "x", 1::usize, 420);

    var not_dir: vector.Vector[TreeFile] = vector.init[TreeFile](?alloc);
    val collect_tree_files_r: err[outcome.Fail] = collect_tree_files(?alloc, stale, ?not_dir);
    if (sel collect_tree_files_r.ok) { bad = 1; }
    free_tree_files(?alloc, ?not_dir);

    val link: str = sfmt(?alloc, "{}/linked.o", tree);
    val symlink_r: err[io_error.Error] = fs.symlink(stale, link);
    if (sel symlink_r.ok) {
        var linked_tree: vector.Vector[TreeFile] = vector.init[TreeFile](?alloc);
        val collect_tree_files_r2: err[outcome.Fail] = collect_tree_files(?alloc, tree, ?linked_tree);
        if (sel collect_tree_files_r2.ok) { bad = 1; }
        free_tree_files(?alloc, ?linked_tree);
        fs.remove_file(link);
    }
    str_free(?alloc, link);

    var before: vector.Vector[TreeFile] = vector.init[TreeFile](?alloc);
    val collect_tree_files_r3: err[outcome.Fail] = collect_tree_files(?alloc, tree, ?before);
    if (sel collect_tree_files_r3.err) { ret 1; }

    val clean: err[outcome.Fail] = check_step_left_obj_tree(?alloc, ?before, tree, "vendor");
    if (sel clean.err) { bad = 1; }

    val dropped: str = sfmt(?alloc, "{}/window.o", tree);
    fs.write_bytes(dropped, "x", 1::usize, 420);

    val dirty: err[outcome.Fail] = check_step_left_obj_tree(?alloc, ?before, tree, "vendor");
    if (sel dirty.ok) { bad = 1; }
    if (sel dirty.err) {
        val msg: str = outcome.describe(dirty.err);
        if (!cfg_contains(msg, "vendor"))            { bad = 1; }
        or (!cfg_contains(msg, "window.o"))          { bad = 1; }
        or (!cfg_contains(msg, "module object tree")) { bad = 1; }
    }

    val nonzero_dirty: err[outcome.Fail] = combine_step_terminal_results(?alloc, dirty, err[outcome.Fail].ok{}, err[outcome.Fail].err{outcome.user("build step exited with code 7")});
    if (sel nonzero_dirty.ok) { bad = 1; }
    if (sel nonzero_dirty.err) {
        val msg: str = outcome.describe(nonzero_dirty.err);
        if (!str_starts_with(msg, "build step 'vendor'") || !cfg_contains(msg, "execution outcome: build step exited with code 7")) { bad = 1; }
    }
    val signal_dirty: err[outcome.Fail] = combine_step_terminal_results(?alloc, dirty, err[outcome.Fail].ok{}, err[outcome.Fail].err{outcome.user("build step terminated by signal 15")});
    if (!(sel signal_dirty.err && cfg_contains(outcome.describe(signal_dirty.err), "execution outcome: build step terminated by signal 15"))) { bad = 1; }
    val wait_dirty: err[outcome.Fail] = combine_step_terminal_results(?alloc, dirty, err[outcome.Fail].ok{}, err[outcome.Fail].err{outcome.user("failed to wait for build step executable")});
    if (!(sel wait_dirty.err && cfg_contains(outcome.describe(wait_dirty.err), "execution outcome: failed to wait"))) { bad = 1; }

    free_tree_files(?alloc, ?before);
    fs.remove_file(dropped);
    var before2: vector.Vector[TreeFile] = vector.init[TreeFile](?alloc);
    val collect_tree_files_r4: err[outcome.Fail] = collect_tree_files(?alloc, tree, ?before2);
    if (sel collect_tree_files_r4.err) { ret 1; }
    fs.write_bytes(stale, "yy", 2::usize, 420);
    val rewritten: err[outcome.Fail] = check_step_left_obj_tree(?alloc, ?before2, tree, "vendor");
    if (sel rewritten.ok) { bad = 1; }
    if (sel rewritten.err) {
        val msg2: str = outcome.describe(rewritten.err);
        if (!cfg_contains(msg2, "main.o")) { bad = 1; }
    }
    free_tree_files(?alloc, ?before2);
    var before_content: vector.Vector[TreeFile] = vector.init[TreeFile](?alloc);
    val collect_tree_files_r5: err[outcome.Fail] = collect_tree_files(?alloc, tree, ?before_content);
    if (sel collect_tree_files_r5.err) { ret 1; }
    fs.write_bytes(stale, "zz", 2::usize, 420);
    val post_write_r: res[fs.Metadata, io_error.Error] = fs.metadata_link(stale);
    if (sel post_write_r.err) { ret 1; }
    val post_write: fs.Metadata = post_write_r.ok;
    var bi: usize = 0;
    for (bi < before_content.len) {
        if (str_equals(before_content.data[bi].path, stale)) {
            before_content.data[bi].sec = post_write.modified.sec;
            before_content.data[bi].nsec = post_write.modified.nsec;
            before_content.data[bi].size = post_write.size;
        }
        bi = bi + 1;
    }
    val content_changed: err[outcome.Fail] = check_step_left_obj_tree(?alloc, ?before_content, tree, "vendor");
    if (sel content_changed.ok) { bad = 1; }
    free_tree_files(?alloc, ?before_content);
    var before3: vector.Vector[TreeFile] = vector.init[TreeFile](?alloc);
    val collect_tree_files_r6: err[outcome.Fail] = collect_tree_files(?alloc, tree, ?before3);
    if (sel collect_tree_files_r6.err) { ret 1; }
    fs.remove_file(stale);
    val removed: err[outcome.Fail] = check_step_left_obj_tree(?alloc, ?before3, tree, "vendor");
    if (sel removed.ok) { bad = 1; }
    if (sel removed.err) {
        val msg3: str = outcome.describe(removed.err);
        if (!cfg_contains(msg3, "removed") || !cfg_contains(msg3, "main.o")) { bad = 1; }
    }
    free_tree_files(?alloc, ?before3);

    var before_added_dir: vector.Vector[TreeFile] = vector.init[TreeFile](?alloc);
    val collect_tree_files_r7: err[outcome.Fail] = collect_tree_files(?alloc, tree, ?before_added_dir);
    if (sel collect_tree_files_r7.err) { ret 1; }
    val empty_added: str = sfmt(?alloc, "{}/empty-added", tree);
    val create_dir_r: err[io_error.Error] = fs.create_dir(empty_added, 0o700);
    if (sel create_dir_r.err) { bad = 1; }
    val added_dir: err[outcome.Fail] = check_step_left_obj_tree(?alloc, ?before_added_dir, tree, "vendor");
    if (!(sel added_dir.err && cfg_contains(outcome.describe(added_dir.err), "empty-added"))) { bad = 1; }
    free_tree_files(?alloc, ?before_added_dir);
    fs.remove_all(?alloc, empty_added);

    val empty_removed: str = sfmt(?alloc, "{}/empty-removed", tree);
    val create_dir_r2: err[io_error.Error] = fs.create_dir(empty_removed, 0o700);
    if (sel create_dir_r2.err) { bad = 1; }
    var before_removed_dir: vector.Vector[TreeFile] = vector.init[TreeFile](?alloc);
    val collect_tree_files_r8: err[outcome.Fail] = collect_tree_files(?alloc, tree, ?before_removed_dir);
    if (sel collect_tree_files_r8.err) { ret 1; }
    fs.remove_all(?alloc, empty_removed);
    val removed_dir: err[outcome.Fail] = check_step_left_obj_tree(?alloc, ?before_removed_dir, tree, "vendor");
    if (!(sel removed_dir.err && cfg_contains(outcome.describe(removed_dir.err), "empty-removed"))) { bad = 1; }
    free_tree_files(?alloc, ?before_removed_dir);

    val empty_old: str = sfmt(?alloc, "{}/empty-old", tree);
    val empty_new: str = sfmt(?alloc, "{}/empty-new", tree);
    val create_dir_r3: err[io_error.Error] = fs.create_dir(empty_old, 0o700);
    if (sel create_dir_r3.err) { bad = 1; }
    var before_renamed_dir: vector.Vector[TreeFile] = vector.init[TreeFile](?alloc);
    val collect_tree_files_r9: err[outcome.Fail] = collect_tree_files(?alloc, tree, ?before_renamed_dir);
    if (sel collect_tree_files_r9.err) { ret 1; }
    val rename_r: err[io_error.Error] = fs.rename(empty_old, empty_new);
    if (sel rename_r.err) { bad = 1; }
    val renamed_dir: err[outcome.Fail] = check_step_left_obj_tree(?alloc, ?before_renamed_dir, tree, "vendor");
    if (!(sel renamed_dir.err && cfg_contains(outcome.describe(renamed_dir.err), "empty-new"))) { bad = 1; }
    free_tree_files(?alloc, ?before_renamed_dir);
    val missing_tree: str = sfmt(?alloc, "{}-new", tree);
    var before_root_dir: vector.Vector[TreeFile] = vector.init[TreeFile](?alloc);
    val collect_tree_files_r10: err[outcome.Fail] = collect_tree_files(?alloc, missing_tree, ?before_root_dir);
    if (sel collect_tree_files_r10.err) { ret 1; }
    val create_dir_r4: err[io_error.Error] = fs.create_dir(missing_tree, 0o700);
    if (sel create_dir_r4.err) { bad = 1; }
    val added_root: err[outcome.Fail] = check_step_left_obj_tree(?alloc, ?before_root_dir, missing_tree, "vendor");
    if (!(sel added_root.err && cfg_contains(outcome.describe(added_root.err), "module object tree"))) { bad = 1; }
    free_tree_files(?alloc, ?before_root_dir);
    fs.remove_all(?alloc, missing_tree);
    str_free(?alloc, missing_tree);
    str_free(?alloc, empty_new);
    str_free(?alloc, empty_old);
    str_free(?alloc, empty_removed);
    str_free(?alloc, empty_added);
    str_free(?alloc, stale);
    str_free(?alloc, dropped);
    fs.remove_all(?alloc, tree);
    ret bad;
}

fun t_digest_check(alloc: *A.Allocator, path: str, data: *u8, len: usize) bool {
    var expect: [32]u8;
    sha256.hash(data, len, ?expect[0]);
    var got: [32]u8;
    val r: err[outcome.Fail] = fingerprint.file_sha256(path, ?got[0]);
    if (sel r.err) { ret false; }
    var i: usize = 0;
    for (i < 32) {
        if (expect[i] != got[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

test "mach.lang.build.fingerprint.file_sha256:matches_the_one_shot_hash_across_chunk_boundaries" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }

    val tf_r: res[fs.TempFile, fs.FsError] = fs.temp_create(?alloc, "mach_streamdigest_test");
    if (sel tf_r.err) { ret 1; }
    var tf: fs.TempFile = tf_r.ok;
    val dup_r: res[str, A.Error] = str_dup(?alloc, fs.temp_path(?tf));
    fs.temp_close_and_remove(?tf);
    if (sel dup_r.err) { ret 1; }
    val tree: str = dup_r.ok;
    val create_dir_all_r: err[fs.FsError] = fs.create_dir_all(?alloc, tree, 493);
    if (sel create_dir_all_r.err) { ret 1; }

    var bad: i32 = 0;

    val empty_path: str = sfmt(?alloc, "{}/empty", tree);
    fs.write_bytes(empty_path, "", 0::usize, 420);
    var empty_byte: u8 = 0;
    if (!t_digest_check(?alloc, empty_path, ?empty_byte, 0::usize)) { bad = 1; }

    val exact_path: str = sfmt(?alloc, "{}/exact", tree);
    val exact_r: res[*u8, A.Error] = A.allocate[u8](?alloc, fingerprint.FILE_DIGEST_CHUNK);
    if (sel exact_r.err) { ret 1; }
    val exact_buf: *u8 = exact_r.ok;
    var i: usize = 0;
    for (i < fingerprint.FILE_DIGEST_CHUNK) { exact_buf[i] = (i % 251)::u8; i = i + 1; }
    fs.write_bytes(exact_path, exact_buf, fingerprint.FILE_DIGEST_CHUNK, 420);
    if (!t_digest_check(?alloc, exact_path, exact_buf, fingerprint.FILE_DIGEST_CHUNK)) { bad = 1; }
    A.deallocate[u8](?alloc, exact_buf, fingerprint.FILE_DIGEST_CHUNK);

    val multi_path: str = sfmt(?alloc, "{}/multi", tree);
    val multi_len: usize = fingerprint.FILE_DIGEST_CHUNK * 3 + 17;
    val multi_r: res[*u8, A.Error] = A.allocate[u8](?alloc, multi_len);
    if (sel multi_r.err) { ret 1; }
    val multi_buf: *u8 = multi_r.ok;
    i = 0;
    for (i < multi_len) { multi_buf[i] = (i % 197)::u8; i = i + 1; }
    fs.write_bytes(multi_path, multi_buf, multi_len, 420);
    if (!t_digest_check(?alloc, multi_path, multi_buf, multi_len)) { bad = 1; }
    A.deallocate[u8](?alloc, multi_buf, multi_len);

    str_free(?alloc, empty_path);
    str_free(?alloc, exact_path);
    str_free(?alloc, multi_path);
    fs.remove_all(?alloc, tree);
    ret bad;
}

test "mach.lang.driver.config.absolute_execution_root:relative_becomes_cwd_anchored" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var bad: bool = false;
    val abs_r: res[str, outcome.Fail] = absolute_execution_root(?alloc, "/already/abs");
    if (sel abs_r.err) { bad = true; }
    if (sel abs_r.ok) {
        val kept: str = abs_r.ok;
        if (!str_equals(kept, "/already/abs")) { bad = true; }
        str_free(?alloc, kept);
    }
    val rel_r: res[str, outcome.Fail] = absolute_execution_root(?alloc, ".");
    if (sel rel_r.err) { bad = true; }
    if (sel rel_r.ok) {
        val anchored: str = rel_r.ok;
        if (!spath.is_abs(anchored)) { bad = true; }
        val cwd_r: res[string.OwnedString, env.EnvError] = env.current_dir(?alloc);
        if (sel cwd_r.err) { bad = true; }
        if (sel cwd_r.ok) {
            var cwd: string.OwnedString = cwd_r.ok;
            if (!str_equals(anchored, cwd.data)) { bad = true; }
            string.owned_release(?cwd);
        }
        str_free(?alloc, anchored);
    }
    if (bad) { ret 1; }
    ret 0;
}

test "mach.lang.driver.config.resolve_step_path:root_and_dep_two_root" {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var bad: bool = false;
    var v: manifest.TmplVars = manifest.TmplVars{target: "t", isa: "x86_64", os: "linux", abi: "gnu", profile: "debug", format: "", artifact_suffix: nil, reqs: nil, req_count: 0};

    val root_exec: str = "/proj";
    val root_out: str = "/proj/out";
    val ordinary_r: res[StepPath, outcome.Fail] = resolve_step_path(?alloc, "src/gen.c", root_out, ?v, root_exec, root_out, "a build step input", true);
    if (sel ordinary_r.err) { bad = true; }
    if (sel ordinary_r.ok) {
        var sp: StepPath = ordinary_r.ok;
        if (!str_equals(sp.root, root_exec) || !str_equals(sp.rel, "src/gen.c") || !str_equals(sp.abs, "/proj/src/gen.c")) { bad = true; }
        step_path_free(?alloc, ?sp);
    }

    val marker_r: res[StepPath, outcome.Fail] = resolve_step_path(?alloc, "{project.out}/gen.c", root_out, ?v, root_exec, root_out, "a build step output", false);
    if (sel marker_r.err) { bad = true; }
    if (sel marker_r.ok) {
        var sp2: StepPath = marker_r.ok;
        if (!str_equals(sp2.root, root_out) || !str_equals(sp2.rel, "gen.c") || !str_equals(sp2.abs, "/proj/out/gen.c")) { bad = true; }
        step_path_free(?alloc, ?sp2);
    }

    val dep_exec: str = "/vendor/dep";
    val dep_out: str = "/home/user/proj/out";
    val dep_in_r: res[StepPath, outcome.Fail] = resolve_step_path(?alloc, "build.sh", dep_out, ?v, dep_exec, dep_out, "a build step input", true);
    if (sel dep_in_r.err) { bad = true; }
    if (sel dep_in_r.ok) {
        var sp3: StepPath = dep_in_r.ok;
        if (!str_equals(sp3.root, dep_exec) || !str_equals(sp3.rel, "build.sh") || !str_equals(sp3.abs, "/vendor/dep/build.sh")) { bad = true; }
        step_path_free(?alloc, ?sp3);
    }

    val dep_out_r: res[StepPath, outcome.Fail] = resolve_step_path(?alloc, "{project.out}/vendor/dep/out.o", dep_out, ?v, dep_exec, dep_out, "a build step output", false);
    if (sel dep_out_r.err) { bad = true; }
    if (sel dep_out_r.ok) {
        var sp4: StepPath = dep_out_r.ok;
        if (!str_equals(sp4.root, dep_out) || !str_equals(sp4.rel, "vendor/dep/out.o") || !str_equals(sp4.abs, "/home/user/proj/out/vendor/dep/out.o")) { bad = true; }
        step_path_free(?alloc, ?sp4);
    }

    if (bad) { ret 1; }
    ret 0;
}

test "mach.lang.driver.config.resolve_step_path:escapes_and_malformed_markers" {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var bad: bool = false;
    var v: manifest.TmplVars = manifest.TmplVars{target: "t", isa: "x86_64", os: "linux", abi: "gnu", profile: "debug", format: "", artifact_suffix: nil, reqs: nil, req_count: 0};
    val exec_root: str = "/proj";
    val out_root: str = "/proj/out";

    val parent_r: res[StepPath, outcome.Fail] = resolve_step_path(?alloc, "../../etc/passwd", out_root, ?v, exec_root, out_root, "a build step input", true);
    if (sel parent_r.ok) { bad = true; }

    val marker_parent_r: res[StepPath, outcome.Fail] = resolve_step_path(?alloc, "{project.out}/../../escape", out_root, ?v, exec_root, out_root, "a build step input", true);
    if (sel marker_parent_r.ok) { bad = true; }

    val no_sep_r: res[StepPath, outcome.Fail] = resolve_step_path(?alloc, "{project.out}x", out_root, ?v, exec_root, out_root, "a build step input", true);
    if (sel no_sep_r.ok) { bad = true; }

    val mid_string_r: res[StepPath, outcome.Fail] = resolve_step_path(?alloc, "foo/{project.out}/bar", out_root, ?v, exec_root, out_root, "a build step input", true);
    if (sel mid_string_r.ok) { bad = true; }

    val root_disallowed_r: res[StepPath, outcome.Fail] = resolve_step_path(?alloc, "{project.out}", out_root, ?v, exec_root, out_root, "a build step output", false);
    if (sel root_disallowed_r.ok) { bad = true; }

    val root_allowed_r: res[StepPath, outcome.Fail] = resolve_step_path(?alloc, "{project.out}", out_root, ?v, exec_root, out_root, "a build step input", true);
    if (sel root_allowed_r.err) { bad = true; }
    if (sel root_allowed_r.ok) {
        var sp: StepPath = root_allowed_r.ok;
        if (!str_equals(sp.root, out_root) || !str_equals(sp.rel, ".") || !str_equals(sp.abs, out_root)) { bad = true; }
        step_path_free(?alloc, ?sp);
    }

    if (bad) { ret 1; }
    ret 0;
}

test "mach.lang.driver.config.absolute_path_in_root:sibling_prefix_and_equal_root" {
    var bad: bool = false;
    if (absolute_path_in_root("/home/user/proj/out-sibling/x", "/home/user/proj/out", false)) { bad = true; }
    if (absolute_path_in_root("/home/user/proj/out-sibling", "/home/user/proj/out", true)) { bad = true; }
    if (!absolute_path_in_root("/home/user/proj/out/x", "/home/user/proj/out", false)) { bad = true; }
    if (absolute_path_in_root("/home/user/proj/out", "/home/user/proj/out", false)) { bad = true; }
    if (!absolute_path_in_root("/home/user/proj/out", "/home/user/proj/out", true)) { bad = true; }
    if (absolute_path_in_root("out/x", "/home/user/proj/out", true)) { bad = true; }
    if (bad) { ret 1; }
    ret 0;
}

test "mach.lang.driver.config.resolve_step_path:prior_output_consumed_as_input" {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var bad: bool = false;

    val tf_r: res[fs.TempFile, fs.FsError] = fs.temp_create(?alloc, "mach_step_two_root");
    if (sel tf_r.err) { ret 1; }
    var tf: fs.TempFile = tf_r.ok;
    val root_r: res[str, A.Error] = str_dup(?alloc, fs.temp_path(?tf));
    fs.temp_close_and_remove(?tf);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    val create_dir_r: err[io_error.Error] = fs.create_dir(root, 0o700);
    if (sel create_dir_r.err) { str_free(?alloc, root); ret 1; }

    val exec_root: str = sfmt(?alloc, "{}/dep", root);
    val out_root: str = sfmt(?alloc, "{}/out", root);
    val create_dir_r3: err[io_error.Error] = fs.create_dir(exec_root, 0o700);
    val create_dir_r2: err[io_error.Error] = fs.create_dir(out_root, 0o700);
    if (sel create_dir_r3.err || sel create_dir_r2.err) { bad = true; }

    val generated: str = sfmt(?alloc, "{}/generated.txt", out_root);
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(generated, "ok", 2, 0o600);
    if (sel write_bytes_r.err) { bad = true; }

    var v: manifest.TmplVars = manifest.TmplVars{target: "t", isa: "x86_64", os: "linux", abi: "gnu", profile: "debug", format: "", artifact_suffix: nil, reqs: nil, req_count: 0};
    val sp_r: res[StepPath, outcome.Fail] = resolve_step_path(?alloc, "{project.out}/generated.txt", out_root, ?v, exec_root, out_root, "a build step input", true);
    if (sel sp_r.err) { bad = true; }
    if (sel sp_r.ok) {
        var sp: StepPath = sp_r.ok;
        if (!str_equals(sp.abs, generated)) { bad = true; }
        val physical_r: err[outcome.Fail] = validate_physical_path(?alloc, sp.root, sp.rel, PHYSICAL_REGULAR, "build step input");
        if (sel physical_r.err) { bad = true; }
        step_path_free(?alloc, ?sp);
    }

    val missing_r: res[StepPath, outcome.Fail] = resolve_step_path(?alloc, "{project.out}/missing.txt", out_root, ?v, exec_root, out_root, "a build step input", true);
    if (sel missing_r.err) { bad = true; }
    if (sel missing_r.ok) {
        var sp2: StepPath = missing_r.ok;
        val missing_physical_r: err[outcome.Fail] = validate_physical_path(?alloc, sp2.root, sp2.rel, PHYSICAL_REGULAR, "build step input");
        if (sel missing_physical_r.ok) { bad = true; }
        step_path_free(?alloc, ?sp2);
    }

    str_free(?alloc, generated);
    str_free(?alloc, out_root);
    str_free(?alloc, exec_root);
    fs.remove_all(?alloc, root);
    str_free(?alloc, root);
    if (bad) { ret 1; }
    ret 0;
}

fun t_temp_project(a: *A.Allocator, prefix: str, toml_body: str) res[str, outcome.Fail] {
    val tf_r: res[fs.TempFile, fs.FsError] = fs.temp_create(a, prefix);
    if (sel tf_r.err) { ret res[str, outcome.Fail].err{outcome.user(outcome.fs_text(tf_r.err))}; }
    var tf: fs.TempFile = tf_r.ok;
    val root: str = fs.temp_path(?tf);
    fs.temp_close_and_remove(?tf);
    val create_dir_all_r: err[fs.FsError] = fs.create_dir_all(a, root, 0o755);
    if (sel create_dir_all_r.err) { ret res[str, outcome.Fail].err{outcome.user("could not create temp project dir")}; }

    val toml_path_r: res[str, fail.Fail] = load.join_path(a, root, "mach.toml");
    if (sel toml_path_r.err) { ret res[str, outcome.Fail].err{outcome.from_fail(toml_path_r.err)}; }
    val toml_path: str = toml_path_r.ok;
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(toml_path, toml_body::*u8, str_len(toml_body), 0o644);
    if (sel write_bytes_r.err) {
        ret res[str, outcome.Fail].err{outcome.user("could not write mach.toml")};
    }
    ret res[str, outcome.Fail].ok{root};
}

test "mach.lang.driver.config.resolve_run_artifact:rejects_library_selection" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }

    val body: str = "[project]\nid = \"libonly\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out\"\n\n[artifact.libonly]\nkind = \"static\"\nentry = \"src/lib.mach\"\nout = \"lib/libonly.a\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n";
    val root_r: res[str, outcome.Fail] = t_temp_project(?alloc, "mach_run_artifact_lib", body);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;

    var pick: manifest.Selection = manifest.Selection{target: "", profile: "", artifact: "", want_lib: false, has_artifact: false};
    val rr: res[RunArtifact, outcome.Fail] = resolve_run_artifact(?alloc, root, ?pick, nil);

    var bad: i32 = 0;
    if (sel rr.ok) { bad = 1; }
    if (sel rr.err) {
        if (!str_contains(outcome.describe(rr.err), "library")) { bad = 1; }
    }

    fs.remove_all(?alloc, root);
    ret bad;
}

fun t_native_path_is(a: *A.Allocator, actual: str, base: str, leaf: str) bool {
    val joined_r: res[spath.Path, A.Error] = spath.join(a, base, leaf);
    if (sel joined_r.err) { ret false; }
    val joined: str = joined_r.ok;
    val expected_r: res[spath.Path, A.Error] = spath.clean(a, joined);
    str_free(a, joined);
    if (sel expected_r.err) { ret false; }
    val expected: str = expected_r.ok;
    val actual_r: res[spath.Path, A.Error] = spath.clean(a, actual);
    if (sel actual_r.err) { str_free(a, expected); ret false; }
    val normalized: str = actual_r.ok;
    val same: bool = str_equals(normalized, expected);
    str_free(a, normalized);
    str_free(a, expected);
    ret same;
}

test "mach.lang.driver.config.resolve_run_artifact:o_override_resolves_relative_and_absolute" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }

    val body: str = "[project]\nid = \"runbin\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out\"\n\n[artifact.runbin]\nkind = \"bin\"\nentry = \"src/main.mach\"\nout = \"bin/runbin\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n";
    val root_r: res[str, outcome.Fail] = t_temp_project(?alloc, "mach_run_artifact_o", body);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;

    var bad: i32 = 0;

    var sel_default: manifest.Selection = manifest.Selection{target: "", profile: "", artifact: "", want_lib: false, has_artifact: false};
    val default_r: res[RunArtifact, outcome.Fail] = resolve_run_artifact(?alloc, root, ?sel_default, nil);
    if (sel default_r.err) { bad = 1; }
    if (sel default_r.ok) {
        val ra: RunArtifact = default_r.ok;
        if (!t_native_path_is(?alloc, ra.path, root, "out/bin/runbin")) { bad = 1; }
        if (!ra.host_runnable) { bad = 1; }
    }

    var sel_rel: manifest.Selection = manifest.Selection{target: "", profile: "", artifact: "", want_lib: false, has_artifact: false};
    val rel_r: res[RunArtifact, outcome.Fail] = resolve_run_artifact(?alloc, root, ?sel_rel, "custom/copy");
    if (sel rel_r.err) { bad = 1; }
    if (sel rel_r.ok) {
        val ra: RunArtifact = rel_r.ok;
        if (!t_native_path_is(?alloc, ra.path, root, "custom/copy")) { bad = 1; }
    }

    val outside_join_r: res[spath.Path, A.Error] = spath.join(?alloc, root, "../somewhere/else");
    if (sel outside_join_r.err) { fs.remove_all(?alloc, root); ret 1; }
    val outside_join: str = outside_join_r.ok;
    val outside_r: res[spath.Path, A.Error] = spath.clean(?alloc, outside_join);
    str_free(?alloc, outside_join);
    if (sel outside_r.err) { fs.remove_all(?alloc, root); ret 1; }
    val outside: str = outside_r.ok;
    var sel_abs: manifest.Selection = manifest.Selection{target: "", profile: "", artifact: "", want_lib: false, has_artifact: false};
    val abs_r: res[RunArtifact, outcome.Fail] = resolve_run_artifact(?alloc, root, ?sel_abs, outside);
    if (sel abs_r.err) { bad = 1; }
    if (sel abs_r.ok) {
        val ra: RunArtifact = abs_r.ok;
        if (!str_equals(ra.path, outside)) { bad = 1; }
    }

    str_free(?alloc, outside);

    var sel_empty: manifest.Selection = manifest.Selection{target: "", profile: "", artifact: "", want_lib: false, has_artifact: false};
    val empty_r: res[RunArtifact, outcome.Fail] = resolve_run_artifact(?alloc, root, ?sel_empty, "");
    if (sel empty_r.ok) { bad = 1; }

    fs.remove_all(?alloc, root);
    ret bad;
}

test "mach.lang.driver.config.resolve_run_artifact:host_runnable_reflects_the_resolved_target" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }

    val host_body: str = "[project]\nid = \"hostrun\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out\"\n\n[artifact.hostrun]\nkind = \"bin\"\nentry = \"src/main.mach\"\nout = \"bin/hostrun\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n";
    val host_root_r: res[str, outcome.Fail] = t_temp_project(?alloc, "mach_run_artifact_host", host_body);
    if (sel host_root_r.err) { ret 1; }
    val host_root: str = host_root_r.ok;

    var bad: i32 = 0;

    var host_sel: manifest.Selection = manifest.Selection{target: "", profile: "", artifact: "", want_lib: false, has_artifact: false};
    val host_r: res[RunArtifact, outcome.Fail] = resolve_run_artifact(?alloc, host_root, ?host_sel, nil);
    if (sel host_r.err) { ret 99; }
    if (!(sel host_r.ok && !(!host_r.ok.host_runnable))) { bad = 1; }
    fs.remove_all(?alloc, host_root);

    var foreign_os: str = "windows";
    var foreign_abi: str = "win64";
    $if ($mach.build.os == $mach.os.windows) { foreign_os = "linux"; foreign_abi = "sysv64"; }
    val foreign_body_r: res[str, format.FormatError] = format.sprint(?alloc, "[project]\nid = \"foreignrun\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out\"\n\n[target.foreign]\nisa = \"x86_64\"\nos = \"{}\"\nabi = \"{}\"\n\n[artifact.foreignrun]\nkind = \"bin\"\nentry = \"src/main.mach\"\nout = \"bin/foreignrun.exe\"\ntargets = [\"foreign\"]\nlink = []\nneed = []\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n", foreign_os, foreign_abi);
    if (sel foreign_body_r.err) { ret 1; }
    val foreign_body: str = foreign_body_r.ok;
    fin { str_free(?alloc, foreign_body); }
    val foreign_root_r: res[str, outcome.Fail] = t_temp_project(?alloc, "mach_run_artifact_foreign", foreign_body);
    if (sel foreign_root_r.err) { ret 1; }
    val foreign_root: str = foreign_root_r.ok;

    var foreign_sel: manifest.Selection = manifest.Selection{target: "foreign", profile: "", artifact: "", want_lib: false, has_artifact: false};
    val foreign_r: res[RunArtifact, outcome.Fail] = resolve_run_artifact(?alloc, foreign_root, ?foreign_sel, nil);
    if (sel foreign_r.err) { ret 99; }
    if (!(sel foreign_r.ok && !(foreign_r.ok.host_runnable))) { bad = 1; }
    fs.remove_all(?alloc, foreign_root);

    ret bad;
}

fun t_tree_dir(a: *A.Allocator, prefix: str) res[str, outcome.Fail] {
    val tf_r: res[fs.TempFile, fs.FsError] = fs.temp_create(a, prefix);
    if (sel tf_r.err) { ret res[str, outcome.Fail].err{outcome.user(outcome.fs_text(tf_r.err))}; }
    var tf: fs.TempFile = tf_r.ok;
    val root: str = fs.temp_path(?tf);
    fs.temp_close_and_remove(?tf);
    val create_dir_all_r: err[fs.FsError] = fs.create_dir_all(a, root, 0o755);
    if (sel create_dir_all_r.err) { ret res[str, outcome.Fail].err{outcome.user("could not create temp tree")}; }
    ret res[str, outcome.Fail].ok{root};
}

fun t_tree_file(a: *A.Allocator, dir: str, leaf: str, body: str) str {
    val p_r: res[str, fail.Fail] = load.join_path(a, dir, leaf);
    if (sel p_r.err) { ret ""; }
    val p: str = p_r.ok;
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(p, body::*u8, str_len(body), 0o644);
    if (sel write_bytes_r.err) { ret ""; }
    ret p;
}

test "mach.lang.driver.config.check_step_left_obj_tree:rejects_a_deletion" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val root_r: res[str, outcome.Fail] = t_tree_dir(?alloc, "mach_objtree_del");
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;

    val kept: str = t_tree_file(?alloc, root, "kept.o", "kept");
    val gone: str = t_tree_file(?alloc, root, "gone.o", "gone");
    if (str_empty(kept) || str_empty(gone)) { fs.remove_all(?alloc, root); ret 1; }

    var before: Vector[TreeFile] = vector.init[TreeFile](?alloc);
    val collect_tree_files_r: err[outcome.Fail] = collect_tree_files(?alloc, root, ?before);
    if (sel collect_tree_files_r.err) {
        free_tree_files(?alloc, ?before); fs.remove_all(?alloc, root); ret 1;
    }

    var bad: i32 = 0;
    val clean: err[outcome.Fail] = check_step_left_obj_tree(?alloc, ?before, root, "probe");
    if (sel clean.err) { bad = 1; }

    val remove_file_r: err[io_error.Error] = fs.remove_file(gone);
    if (sel remove_file_r.err) { bad = 1; }
    val after: err[outcome.Fail] = check_step_left_obj_tree(?alloc, ?before, root, "probe");
    if (!(sel after.err && cfg_contains(outcome.describe(after.err), "removed"))) { bad = 1; }

    free_tree_files(?alloc, ?before);
    fs.remove_all(?alloc, root);
    ret bad;
}

test "mach.lang.driver.config.check_step_left_obj_tree:rejects_a_timestamp_preserving_rewrite" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val root_r: res[str, outcome.Fail] = t_tree_dir(?alloc, "mach_objtree_rw");
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;

    val obj: str = t_tree_file(?alloc, root, "one.o", "original");
    if (str_empty(obj)) { fs.remove_all(?alloc, root); ret 1; }

    var before: Vector[TreeFile] = vector.init[TreeFile](?alloc);
    val collect_tree_files_r: err[outcome.Fail] = collect_tree_files(?alloc, root, ?before);
    if (sel collect_tree_files_r.err) {
        free_tree_files(?alloc, ?before); fs.remove_all(?alloc, root); ret 1;
    }

    var bad: i32 = 0;
    val check_step_left_obj_tree_r: err[outcome.Fail] = check_step_left_obj_tree(?alloc, ?before, root, "probe");
    if (sel check_step_left_obj_tree_r.err) { bad = 1; }

    var idx: usize = 0;
    var found: bool = false;
    for (idx < before.len) {
        if (before.data[idx].kind == TREE_FILE) {
            before.data[idx].digest[0] = before.data[idx].digest[0] ^ 0xFF;
            found = true;
        }
        idx = idx + 1;
    }
    if (!found) { bad = 1; }

    val after: err[outcome.Fail] = check_step_left_obj_tree(?alloc, ?before, root, "probe");
    if (sel after.ok) { bad = 1; }

    free_tree_files(?alloc, ?before);
    fs.remove_all(?alloc, root);
    ret bad;
}

test "mach.lang.driver.config.execute_step_invocation:a_step_past_its_bound_fails_naming_the_step_and_bound" {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }

    var empty_env: [1]*u8;
    empty_env[0] = nil;
    var argv: [4]*u8;
    argv[0] = "sh";
    argv[1] = "-c";
    argv[2] = "sleep 30";
    argv[3] = nil;
    var invocation: StepInvocation;
    invocation.argv = StepStrings{items: ?argv[0], count: 3};
    invocation.env  = StepStrings{items: ?empty_env[0], count: 0};

    val program_r: res[str, outcome.Fail] = resolve_step_program(?alloc, "/", ?invocation);
    if (sel program_r.err) { ret 1; }
    val program: str = program_r.ok;
    val bounded: err[outcome.Fail] = execute_step_invocation(?alloc, "/", program, ?invocation, "slow-step", 1);
    str_free(?alloc, program);
    if (sel bounded.ok) { ret 2; }
    val msg: str = outcome.describe(bounded.err);
    if (!cfg_contains(msg, "slow-step")) { ret 3; }
    if (!cfg_contains(msg, "timeout_seconds of 1")) { ret 4; }
    ret 0;
}

test "mach.lang.driver.config.execute_step_invocation:an_unbounded_step_is_never_cut_short" {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }

    var empty_env: [1]*u8;
    empty_env[0] = nil;
    var argv: [4]*u8;
    argv[0] = "sh";
    argv[1] = "-c";
    argv[2] = "sleep 1; exit 0";
    argv[3] = nil;
    var invocation: StepInvocation;
    invocation.argv = StepStrings{items: ?argv[0], count: 3};
    invocation.env  = StepStrings{items: ?empty_env[0], count: 0};

    val program_r: res[str, outcome.Fail] = resolve_step_program(?alloc, "/", ?invocation);
    if (sel program_r.err) { ret 1; }
    val program: str = program_r.ok;
    val unbounded: err[outcome.Fail] = execute_step_invocation(?alloc, "/", program, ?invocation, "slow-step", 0);
    str_free(?alloc, program);
    if (sel unbounded.err) { ret 2; }
    ret 0;
}

test "mach.lang.driver.config: expanded step environment inherits overlays and owns target identity" {
    var a: A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?a);
    if (sel sr.err) { ret 2; }
    var owned_session: session.Session = sr.ok;
    fin { session.dnit(?owned_session); }
    var p: project.Project;
    p.s = ?owned_session;
    var keys: [2]intern.StrId;
    var values: [2]intern.StrId;
    val key: res[intern.StrId, A.Error] = intern.intern(?owned_session.interner, "MACH_3146_OVERRIDE");
    val value: res[intern.StrId, A.Error] = intern.intern(?owned_session.interner, "{profile.name}={target.isa}");
    val target_key: res[intern.StrId, A.Error] = intern.intern(?owned_session.interner, "MACH_TARGET_OS");
    val target_value: res[intern.StrId, A.Error] = intern.intern(?owned_session.interner, "ignored {unsupported}");
    if (sel key.err) { ret 3; }
    if (sel value.err) { ret 3; }
    if (sel target_key.err) { ret 3; }
    if (sel target_value.err) { ret 3; }
    keys[0] = key.ok;
    keys[1] = target_key.ok;
    values[0] = value.ok;
    values[1] = target_value.ok;
    var step: manifest.StepDef;
    step.env_keys = ?keys[0];
    step.env_values = ?values[0];
    step.env_count = 2;
    var v: manifest.TmplVars;
    v.target = "probe";
    v.profile = "release";
    v.isa = "x86_64";
    v.os = "windows";
    v.abi = "win64";
    var inherited: [6]usize;
    inherited[0] = ("PATH=/planner/compiler-tools")::usize;
    inherited[1] = ("MACH_3146_KEEP=unchanged")::usize;
    inherited[2] = ("MACH_3146_OVERRIDE=old")::usize;
    inherited[3] = ("MACH_TARGET_OS=wrong")::usize;
    inherited[4] = ("MACH_TARGET_ABI=wrong")::usize;
    inherited[5] = 0;
    $if ($mach.build.os == $mach.os.windows) {
        val folded_key: res[intern.StrId, A.Error] = intern.intern(?owned_session.interner, "mach_target_os");
        if (sel folded_key.err) { ret 8; }
        keys[1] = folded_key.ok;
        inherited[4] = ("mach_target_abi=wrong")::usize;
    }
    val er: res[StepStrings, outcome.Fail] = expand_step_environment(?a, ?p, ?step, "out", ?v, (?inherited[0])::**u8);
    if (sel er.err) { ret 4; }
    var environment: StepStrings = er.ok;
    fin { step_strings_free(?a, ?environment); }
    if (environment.count != 6 || environment.items[6] != nil) { ret 5; }
    var expected: [6]str;
    expected[0] = "MACH_3146_KEEP=unchanged";
    expected[1] = "MACH_3146_OVERRIDE=release=x86_64";
    expected[2] = "MACH_TARGET_ABI=win64";
    expected[3] = "MACH_TARGET_ISA=x86_64";
    expected[4] = "MACH_TARGET_OS=windows";
    expected[5] = "PATH=/planner/compiler-tools";
    var i: usize = 0;
    for (i < 6) {
        if (!str_equals(environment.items[i]::str, expected[i])) { ret 6; }
        i = i + 1;
    }
    $if ($mach.build.os != $mach.os.windows) {
        var argv: [4]usize;
        argv[0] = ("sh")::usize;
        argv[1] = ("-c")::usize;
        argv[2] = ("test \"$PATH\" = /planner/compiler-tools && test \"$MACH_3146_KEEP\" = unchanged && test \"$MACH_3146_OVERRIDE\" = release=x86_64 && test \"$MACH_TARGET_OS\" = windows")::usize;
        argv[3] = 0;
        var invocation: StepInvocation;
        invocation.argv = StepStrings{items: (?argv[0])::**u8, count: 3};
        invocation.env = environment;
        val execute_step_invocation_r: err[outcome.Fail] = execute_step_invocation(?a, "/", "/bin/sh", ?invocation, "environment inheritance", 0);
        if (sel execute_step_invocation_r.err) { ret 7; }
    }
    ret 0;
}

test "mach.lang.driver.config.resolve_step_path:native_output_roots_preserve_borrowed_identity" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var v: manifest.TmplVars = manifest.TmplVars{target: "t", isa: "x86_64", os: "linux", abi: "gnu", profile: "debug", format: "", artifact_suffix: nil, reqs: nil, req_count: 0};
    var roots: [3]str;
    var expected: [3]str;
    $if ($mach.build.os == $mach.os.windows) {
        roots[0] = "C:/project/out";
        roots[1] = "C:\\project/out";
        roots[2] = "//server/share/project/out";
        expected[0] = "C:\\project\\out\\obj\\vend-c\\window.o";
        expected[1] = expected[0];
        expected[2] = "\\\\server\\share\\project\\out\\obj\\vend-c\\window.o";
    }
    $or {
        roots[0] = "/project/out";
        roots[1] = "/project/./out";
        roots[2] = "/project/old/../out";
        expected[0] = "/project/out/obj/vend-c/window.o";
        expected[1] = expected[0];
        expected[2] = expected[0];
    }
    var i: usize = 0;
    for (i < 3) {
        val output_r: res[StepPath, outcome.Fail] = resolve_step_path(?alloc,
            "{project.out}/obj/vend-c/window.o", roots[i], ?v, roots[i], roots[i], "a build step output", false);
        if (sel output_r.err) {
            str_free(?alloc, outcome.describe(output_r.err));
            ret 2;
        }
        var output: StepPath = output_r.ok;
        val output_ok: bool = output.root == roots[i] && str_equals(output.rel, "obj/vend-c/window.o")
            && str_equals(output.abs, expected[i]);
        step_path_free(?alloc, ?output);
        if (!output_ok) { ret 3; }
        val root_r: res[StepPath, outcome.Fail] = resolve_step_path(?alloc,
            "{project.out}", roots[i], ?v, roots[i], roots[i], "a build step input", true);
        if (sel root_r.err) {
            str_free(?alloc, outcome.describe(root_r.err));
            ret 4;
        }
        var root_input: StepPath = root_r.ok;
        val root_ok: bool = root_input.root == roots[i] && str_equals(root_input.rel, ".")
            && absolute_path_in_root(expected[i], root_input.abs, false);
        step_path_free(?alloc, ?root_input);
        if (!root_ok) { ret 5; }
        i = i + 1;
    }
    ret 0;
}

test "mach.lang.driver.config.resolve_step_path:native_roots_retain_escape_and_marker_refusals" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var v: manifest.TmplVars = manifest.TmplVars{target: "t", isa: "x86_64", os: "linux", abi: "gnu", profile: "debug", format: "", artifact_suffix: nil, reqs: nil, req_count: 0};
    var root: str = "/project/out";
    $if ($mach.build.os == $mach.os.windows) { root = "C:/project/out"; }
    var denied: [8]str;
    denied[0] = "{project.out}/../../escape";
    denied[1] = "{project.out}/../out-sibling/file";
    denied[2] = "{project.out}x/file";
    denied[3] = "foo/{project.out}/file";
    denied[4] = "{project.out}";
    denied[5] = "{project.out}/./file";
    denied[6] = "{project.out}/dir//file";
    denied[7] = "../../escape";
    var i: usize = 0;
    for (i < 8) {
        val r: res[StepPath, outcome.Fail] = resolve_step_path(?alloc,
            denied[i], root, ?v, root, root, "a build step output", false);
        if (sel r.ok) {
            var accepted: StepPath = r.ok;
            step_path_free(?alloc, ?accepted);
            ret 2;
        }
        str_free(?alloc, outcome.describe(r.err));
        i = i + 1;
    }
    val relative_r: res[StepPath, outcome.Fail] = resolve_step_path(?alloc,
        "{project.out}/file", root, ?v, root, "relative", "a build step output", false);
    if (sel relative_r.ok) {
        var accepted: StepPath = relative_r.ok;
        step_path_free(?alloc, ?accepted);
        ret 3;
    }
    str_free(?alloc, outcome.describe(relative_r.err));
    ret 0;
}

test "mach.lang.driver.config.step_outputs:native_snapshot_and_declarations_share_canonical_paths" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val root_r: res[str, outcome.Fail] = t_tree_dir(?alloc, "mach_native_step_effects");
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?alloc, root); str_free(?alloc, root); }
    val staging: str = sfmt(?alloc, "{}/./stage", root);
    if (str_empty(staging)) { ret 1; }
    fin { str_free(?alloc, staging); }
    val object_dir: str = sfmt(?alloc, "{}/obj", staging);
    if (str_empty(object_dir)) { ret 1; }
    fin { str_free(?alloc, object_dir); }
    val create_dir_all_r: err[fs.FsError] = fs.create_dir_all(?alloc, object_dir, 0o700);
    if (sel create_dir_all_r.err) { ret 1; }
    var before: Vector[TreeFile] = vector.init[TreeFile](?alloc);
    fin { free_tree_files(?alloc, ?before); }
    val collect_tree_files_r: err[outcome.Fail] = collect_tree_files(?alloc, staging, ?before);
    if (sel collect_tree_files_r.err) { ret 1; }
    var i: usize = 0;
    for (i < before.len) {
        val clean_r: res[str, A.Error] = spath.clean(?alloc, before.data[i].path);
        if (sel clean_r.err) { ret 1; }
        val clean: str = clean_r.ok;
        val same: bool = str_equals(clean, before.data[i].path);
        str_free(?alloc, clean);
        if (!same) { ret 3; }
        i = i + 1;
    }
    var v: manifest.TmplVars = manifest.TmplVars{target: "t", isa: "x86_64", os: "linux", abi: "gnu", profile: "debug", format: "", artifact_suffix: nil, reqs: nil, req_count: 0};
    val output_r: res[StepPath, outcome.Fail] = resolve_step_path(?alloc,
        "{project.out}/obj/file", root, ?v, root, root, "a build step output", false);
    if (sel output_r.err) { ret 2; }
    var output: StepPath = output_r.ok;
    var outputs: Vector[StepPath] = vector.init[StepPath](?alloc);
    fin { step_paths_free(?alloc, ?outputs); }
    val push_r: res[usize, A.Error] = vector.push[StepPath](?outputs, output);
    if (sel push_r.err) {
        step_path_free(?alloc, ?output);
        ret 1;
    }
    var declared: Vector[str] = vector.init[str](?alloc);
    fin { step_free_inputs(?alloc, ?declared); }
    val step_paths_staged_absolute_r: err[outcome.Fail] = step_paths_staged_absolute(?alloc, root, staging, ?outputs, ?declared);
    if (sel step_paths_staged_absolute_r.err) { ret 1; }
    if (declared.len != 1) { ret 4; }
    val clean_r: res[str, A.Error] = spath.clean(?alloc, declared.data[0]);
    if (sel clean_r.err) { ret 1; }
    val clean: str = clean_r.ok;
    val canonical: bool = str_equals(clean, declared.data[0]);
    str_free(?alloc, clean);
    if (!canonical) { ret 4; }
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(declared.data[0], "file", 4, 0o600);
    if (sel write_bytes_r.err) { ret 1; }
    val check_step_output_effects_r: err[outcome.Fail] = check_step_output_effects(?alloc, ?before, staging, ?declared, "generate");
    if (sel check_step_output_effects_r.err) { ret 5; }
    step_free_inputs(?alloc, ?declared);
    declared = vector.init[str](?alloc);
    val dir_r: res[str, A.Error] = spath.clean(?alloc, object_dir);
    if (sel dir_r.err) { ret 1; }
    val dir: str = dir_r.ok;
    val push_r2: res[usize, A.Error] = vector.push[str](?declared, dir);
    if (sel push_r2.err) { str_free(?alloc, dir); ret 1; }
    val check_step_output_effects_r2: err[outcome.Fail] = check_step_output_effects(?alloc, ?before, staging, ?declared, "generate");
    if (sel check_step_output_effects_r2.err) { ret 6; }
    val sibling: str = sfmt(?alloc, "{}/obj-sibling", staging);
    if (str_empty(sibling)) { ret 1; }
    fin { str_free(?alloc, sibling); }
    val write_bytes_r2: err[fs.FsError] = fs.write_bytes(sibling, "bad", 3, 0o600);
    if (sel write_bytes_r2.err) { ret 1; }
    val refused: err[outcome.Fail] = check_step_output_effects(?alloc, ?before, staging, ?declared, "generate");
    if (sel refused.ok) { ret 7; }
    val message: str = outcome.describe(refused.err);
    val named: bool = str_contains(message, "obj-sibling");
    str_free(?alloc, message);
    if (!named) { ret 7; }
    ret 0;
}
