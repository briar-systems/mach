# the program `mach run` launches
# ---
# path:          the built executable, or `-o`
# host_runnable: the target's os and isa are the host's
# target_name:   the target's declared name
# runner:        the runner the target declares, none when it declares none
pub rec RunArtifact {
    path:          str;
    host_runnable: bool;
    target_name:   str;
    runner:        runner.Runner;
}

# the built executable `mach run` launches: the one (artifact, target, profile)
# the selectors name, which must be a `bin`
# ---
# alloc:           owns the result and every message
# reg:             the composed target registry the cell's target resolves against
# project_root:    the project root
# selectors:       the `-a`, `-t` and `-p` patterns; an artifact axis given none takes the sole `bin`
# output_override: `-o`, the path to run instead of the artifact's output, or nil
# ret:             the executable; err from the manifest or selection, when the selection
#                  names several cells or a library, or for an unusable `-o`
pub fun resolve_run_artifact(alloc: *A.Allocator, reg: *lang_target.TargetRegistry, project_root: str, selectors: *manifest.Selectors,
    output_override: str) res[RunArtifact, fail.Fail] {
    var itn: intern.Interner                   = intern.init(alloc);
    val mr:  res[manifest.Manifest, fail.Fail] = manifest.read_at(alloc, ?itn, project_root);
    if (sel mr.err) { ret res[RunArtifact, fail.Fail].err{mr.err}; }
    var m: manifest.Manifest = mr.ok;
    fin { manifest.dnit(?m, alloc); }

    val picked: res[manifest.Cell, fail.Fail] = manifest.resolve_cell(alloc, ?itn, ?m, selectors,
        manifest.ARTIFACT_DEFAULT_EXECUTABLE, "mach run executes one artifact");
    if (sel picked.err) { ret res[RunArtifact, fail.Fail].err{picked.err}; }
    var cell: manifest.Cell = picked.ok;

    val ur: res[manifest.BuildUnit, fail.Fail] = manifest.resolve_build_unit(alloc, ?itn, reg, ?m, ?cell);
    if (sel ur.err) { ret res[RunArtifact, fail.Fail].err{ur.err}; }
    val bu: manifest.BuildUnit = ur.ok;

    if (catalog_artifact.is_library(bu.artifact.kind)) {
        val refusal: fail.Fail = fail.formatted_user(alloc, diagnostic_kind.ARTIFACT_NOT_RUNNABLE,
            "selected artifact '{}' is a library; run executes only bin artifacts", intern.text(?itn, bu.artifact.name));
        ret res[RunArtifact, fail.Fail].err{refusal};
    }

    var ra: RunArtifact;
    ra.host_runnable = manifest.target_matches_host(?itn, bu.target, lang_target.host_os_id(), lang_target.host_arch_id());
    ra.target_name   = intern.text(?itn, bu.target.name);
    val work_r: res[str, fail.Fail] = driver_load.join_path(alloc, project_root, intern.text(?itn, bu.out_root));
    if (sel work_r.err) { ret res[RunArtifact, fail.Fail].err{work_r.err}; }
    val declared: res[runner.Runner, fail.Fail] = runner.declared(alloc, ?itn, bu.target, intern.text(?itn, bu.profile_name), work_r.ok);
    if (sel declared.err) { ret res[RunArtifact, fail.Fail].err{declared.err}; }
    ra.runner = declared.ok;

    if (output_override != nil) {
        if (str_empty(output_override)) {
            ret res[RunArtifact, fail.Fail].err{fail.user(diagnostic_kind.CLI_OUTPUT_PATH, "-o requires a non-empty path")};
        }
        val resolved_r: res[types_path.Path, A.Error] = types_path.resolve(alloc, project_root, output_override);
        if (sel resolved_r.err) {
            ret res[RunArtifact, fail.Fail].err{fail.formatted_user(alloc, diagnostic_kind.CLI_OUTPUT_PATH, "-o '{}': {}", output_override, lang_alloc.text(resolved_r.err))};
        }
        val cleaned_r: res[types_path.Path, A.Error] = types_path.clean(alloc, resolved_r.ok);
        if (sel cleaned_r.err) {
            ret res[RunArtifact, fail.Fail].err{fail.formatted_user(alloc, diagnostic_kind.CLI_OUTPUT_PATH, "-o '{}': {}", output_override, lang_alloc.text(cleaned_r.err))};
        }
        ra.path = cleaned_r.ok;
        ret res[RunArtifact, fail.Fail].ok{ra};
    }

    if (intern.str_is_nil(bu.bin_path) || str_empty(intern.text(?itn, bu.bin_path))) {
        ret res[RunArtifact, fail.Fail].err{fail.user(diagnostic_kind.ARTIFACT_NO_OUTPUT, "selected artifact has no output path; set the `out` template in mach.toml")};
    }
    val abs_r: res[str, fail.Fail] = driver_load.join_path(alloc, project_root, intern.text(?itn, bu.bin_path));
    if (sel abs_r.err) { ret res[RunArtifact, fail.Fail].err{abs_r.err}; }
    ra.path = abs_r.ok;
    ret res[RunArtifact, fail.Fail].ok{ra};
}

fun dup_strid_array(alloc: *A.Allocator, src: *intern.StrId, count: u32) res[*intern.StrId, fail.Fail] {
    if (src == nil || count == 0) { ret res[*intern.StrId, fail.Fail].ok{nil}; }
    val r: res[*intern.StrId, A.Error] = A.allocate[intern.StrId](alloc, count::usize);
    if (sel r.err) { ret res[*intern.StrId, fail.Fail].err{fail.refused(r.err)}; }
    val arr: *intern.StrId = r.ok;
    var i:   u32           = 0;
    for (i < count) {
        arr[i] = src[i];
        i      = i + 1;
    }
    ret res[*intern.StrId, fail.Fail].ok{arr};
}

# a copy of the `count` places at `src`, nil for none
fun dup_sites(alloc: *A.Allocator, src: *fail.Place, count: u32) res[*fail.Place, fail.Fail] {
    if (src == nil || count == 0) { ret res[*fail.Place, fail.Fail].ok{nil}; }
    val r: res[*fail.Place, A.Error] = A.allocate[fail.Place](alloc, count::usize);
    if (sel r.err) { ret res[*fail.Place, fail.Fail].err{fail.refused(r.err)}; }
    var i: u32 = 0;
    for (i < count) {
        r.ok[i] = src[i];
        i       = i + 1;
    }
    ret res[*fail.Place, fail.Fail].ok{r.ok};
}

fun clone_step(alloc: *A.Allocator, src: *manifest.StepDef, out: *manifest.StepDef) err[fail.Fail] {
    var d: manifest.StepDef = @src;
    d.argv       = nil;
    d.env_keys   = nil;
    d.env_values = nil;
    d.in         = nil;
    d.out        = nil;
    d.need       = nil;
    d.argv_at    = nil;
    d.env_at     = nil;
    d.in_at      = nil;
    d.out_at     = nil;
    d.need_at    = nil;
    var handed: bool = false;
    fin {
        if (!handed) { manifest.step_dnit(alloc, ?d); }
    }

    val argv_r: res[*intern.StrId, fail.Fail] = dup_strid_array(alloc, src.argv, src.argv_count);
    if (sel argv_r.err) { ret err[fail.Fail].err{argv_r.err}; }
    d.argv = argv_r.ok;

    val env_keys_r: res[*intern.StrId, fail.Fail] = dup_strid_array(alloc, src.env_keys, src.env_count);
    if (sel env_keys_r.err) { ret err[fail.Fail].err{env_keys_r.err}; }
    d.env_keys = env_keys_r.ok;

    val env_values_r: res[*intern.StrId, fail.Fail] = dup_strid_array(alloc, src.env_values, src.env_count);
    if (sel env_values_r.err) { ret err[fail.Fail].err{env_values_r.err}; }
    d.env_values = env_values_r.ok;

    val in_r: res[*intern.StrId, fail.Fail] = dup_strid_array(alloc, src.in, src.in_count);
    if (sel in_r.err) { ret err[fail.Fail].err{in_r.err}; }
    d.in = in_r.ok;

    val out_r: res[*intern.StrId, fail.Fail] = dup_strid_array(alloc, src.out, src.out_count);
    if (sel out_r.err) { ret err[fail.Fail].err{out_r.err}; }
    d.out = out_r.ok;

    val need_r: res[*intern.StrId, fail.Fail] = dup_strid_array(alloc, src.need, src.need_count);
    if (sel need_r.err) { ret err[fail.Fail].err{need_r.err}; }
    d.need = need_r.ok;

    val argv_at_r: res[*fail.Place, fail.Fail] = dup_sites(alloc, src.argv_at, src.argv_count);
    if (sel argv_at_r.err) { ret err[fail.Fail].err{argv_at_r.err}; }
    d.argv_at = argv_at_r.ok;
    val env_at_r: res[*fail.Place, fail.Fail] = dup_sites(alloc, src.env_at, src.env_count);
    if (sel env_at_r.err) { ret err[fail.Fail].err{env_at_r.err}; }
    d.env_at = env_at_r.ok;
    val in_at_r: res[*fail.Place, fail.Fail] = dup_sites(alloc, src.in_at, src.in_count);
    if (sel in_at_r.err) { ret err[fail.Fail].err{in_at_r.err}; }
    d.in_at = in_at_r.ok;
    val out_at_r: res[*fail.Place, fail.Fail] = dup_sites(alloc, src.out_at, src.out_count);
    if (sel out_at_r.err) { ret err[fail.Fail].err{out_at_r.err}; }
    d.out_at = out_at_r.ok;
    val need_at_r: res[*fail.Place, fail.Fail] = dup_sites(alloc, src.need_at, src.need_count);
    if (sel need_at_r.err) { ret err[fail.Fail].err{need_at_r.err}; }
    d.need_at = need_at_r.ok;
    @out      = d;
    handed    = true;
    ret err[fail.Fail].ok{};
}

# the closure the project compiles against: `closure` borrowed, or with none
# given one it locates and owns
fun closure_taken(p: *project.Project, m: *manifest.Manifest, project_root: str, closure: *project.Closure) err[fail.Fail] {
    var taken: *project.Closure = closure;
    if (taken == nil) {
        val located: res[project.Closure, fail.Fail] = driver_closure.locate(p.s, p.alloc, m, project_root, nil, driver_closure.UNREALIZED_REFUSED);
        if (sel located.err) { ret err[fail.Fail].err{located.err}; }
        project.closure_dnit(?p.config.closure);
        p.config.closure = located.ok;
        taken            = ?p.config.closure;
    }
    ret driver_closure.adopt(p, taken);
}

# configure a project for one build cell of `m`, or of one of its dependencies
# ---
# p:            the project being configured
# project_root: the root project's directory
# m:            the root manifest
# closure:      `m`'s located closure, which the project borrows; nil to locate
#               one the project owns
# c:            the cell; with `owner`, a target and artifact of that dependency and
#               a profile of `m`
# owner:        "" for a cell of `m`, or the id of the closure dependency whose export
#               library requires the cell
# for_union:    configure the editor's union of every artifact: every artifact's
#               entry loads, and `{artifact.<id>.out}` resolves over every artifact
#               some artifact needs
# ret:          ok; err from selection, template, step, link or dependency resolution
pub fun load_config_manifest(p: *project.Project, project_root: str, m: *manifest.Manifest, closure: *project.Closure, c: *manifest.Cell,
    owner: str, for_union: bool) err[fail.Fail] {
    val toolchain_r: res[*lang_target.TargetRegistry, fail.Fail] = toolchain.registry();
    if (sel toolchain_r.err) { ret err[fail.Fail].err{toolchain_r.err}; }
    val toolchain:  *lang_target.TargetRegistry = toolchain_r.ok;
    val abs_root_r: res[intern.StrId, A.Error]  = intern.add(?p.s.interner, project_root);
    if (sel abs_root_r.err) { ret err[fail.Fail].err{fail.refused(abs_root_r.err)}; }
    p.config.project_root = abs_root_r.ok;
    p.config.home_root    = abs_root_r.ok;

    var scope: manifest.Scope = manifest.root_scope(m);
    if (!str_empty(owner)) {
        val dr: err[fail.Fail] = closure_taken(p, m, project_root, closure);
        if (sel dr.err) { ret dr; }
        val sr: err[fail.Fail] = driver_closure.scope_closure_to_dependency(p, owner);
        if (sel sr.err) { ret sr; }
        scope                 = manifest.dependency_scope(m, ?p.config.owner.manifest);
        p.config.project_root = p.config.owner.vendor_root;
    }
    val om: *manifest.Manifest = scope.owner;

    val ur: res[manifest.BuildUnit, fail.Fail] = manifest.resolve_scoped_build_unit(p.alloc, ?p.s.interner, toolchain, ?scope, c);
    if (sel ur.err) {
        ret err[fail.Fail].err{ur.err};
    }
    val bu: manifest.BuildUnit = ur.ok;

    val cell_profile: str = intern.text(?p.s.interner, bu.profile_name);
    p.config.art_reqs      = nil;
    p.config.art_req_count = 0;
    # the union holds every artifact and resolves every artifact's requirements: a
    # module of a non-default artifact is checked against its own artifact's `need`
    val rqr: err[fail.Fail] = manifest.resolve_artifact_reqs(p.alloc, ?p.s.interner, toolchain, ?scope,
        bu.artifact, bu.target.name, cell_profile, for_union, ?p.config.art_reqs, ?p.config.art_req_count);
    if (sel rqr.err) { ret err[fail.Fail].err{rqr.err}; }

    var cell_v: template.Values = template.values_with(?p.s.interner, bu.target,
        cell_profile, p.config.art_reqs, p.config.art_req_count);

    # a dependency's other artifacts are never built for the root, so only the
    # root's own declarations can collide within a manifest
    if (!manifest.scope_is_dependency(?scope)) {
        val cr: err[fail.Fail] = manifest.check_collisions(p.alloc, ?p.s.interner, toolchain, m, ?cell_v);
        if (sel cr.err) {
            ret cr;
        }
    }

    val ter: res[*project.TargetEntry, A.Error] = A.allocate[project.TargetEntry](p.alloc, 1::usize);
    if (sel ter.err) { ret err[fail.Fail].err{fail.refused(ter.err)}; }
    val targets: *project.TargetEntry = ter.ok;
    targets[0] = project.target_entry_of(?bu);

    p.config.id           = om.id;
    p.config.version      = om.version;
    p.config.bin_name     = intern.STR_NIL;
    p.config.icon         = intern.STR_NIL;
    p.config.app_manifest = intern.STR_NIL;
    if (bu.artifact != nil) {
        p.config.bin_name     = bu.artifact.name;
        p.config.icon         = bu.artifact.icon;
        p.config.app_manifest = bu.artifact.app_manifest;
    }
    # a module is the cell's artifact's until the union walk says otherwise
    p.loader.artifact         = p.config.bin_name;
    p.config.module           = bu.entry;
    p.config.dir_src          = om.src;
    p.config.targets          = targets;
    p.config.target_count     = 1;
    p.target_entry            = ?p.config.targets[0];
    p.config.profile          = bu.profile_name;
    p.config.step_order       = nil;
    p.config.step_order_count = 0;

    val res_project_work_str: res[str, fail.Fail] = manifest.expand_project_work(p.alloc, ?p.s.interner, m, ?cell_v);
    if (sel res_project_work_str.err) { ret err[fail.Fail].err{res_project_work_str.err}; }
    val project_work_str: str = res_project_work_str.ok;
    fin { str_free(p.alloc, project_work_str); }
    val res_po_id: res[intern.StrId, A.Error] = intern.add(?p.s.interner, project_work_str);
    if (sel res_po_id.err) { ret err[fail.Fail].err{fail.refused(res_po_id.err)}; }
    p.config.project_work = res_po_id.ok;

    val vr: err[fail.Fail] = validate_local_links(p, project_root, om, bu.target, project_work_str, ?cell_v);
    if (sel vr.err) { ret vr; }

    val sor: err[fail.Fail] = validate_step_outputs(p, om, project_work_str, ?cell_v);
    if (sel sor.err) { ret sor; }

    val spr: err[fail.Fail] = compute_step_plan(p, om, ?bu, for_union, project_work_str, ?cell_v);
    if (sel spr.err) { ret spr; }

    p.config.steps      = nil;
    p.config.step_count = 0;
    if (om.step_count > 0) {
        val res_steps: res[*manifest.StepDef, A.Error] = A.allocate[manifest.StepDef](p.alloc, om.step_count::usize);
        if (sel res_steps.err) {
            ret err[fail.Fail].err{fail.refused(res_steps.err)};
        }
        val steps: *manifest.StepDef = res_steps.ok;
        var si:    u32               = 0;
        for (si < om.step_count) {
            val clone_r: err[fail.Fail] = clone_step(p.alloc, ?om.steps[si], ?steps[si]);
            if (sel clone_r.err) {
                var sj: u32 = 0;
                for (sj < si) {
                    manifest.step_dnit(p.alloc, ?steps[sj]);
                    sj = sj + 1;
                }
                A.deallocate[manifest.StepDef](p.alloc, steps, om.step_count::usize);
                ret clone_r;
            }
            si = si + 1;
        }
        p.config.steps      = steps;
        p.config.step_count = om.step_count;
    }

    if (!manifest.scope_is_dependency(?scope)) {
        val dr: err[fail.Fail] = closure_taken(p, m, project_root, closure);
        if (sel dr.err) { ret dr; }
    }

    val scoped: err[fail.Fail] = driver_closure.resolve_requirement_scopes(p, m, cell_profile);
    if (sel scoped.err) { ret scoped; }
    session_embed.set_path_env(?p.s.embeds, project_root, p.config.req_scopes, p.config.req_scope_count,
        p.req.goal != request.GOAL_CHECK);

    val cr2: err[fail.Fail] = driver_closure.resolve_cascade_libs(p, bu.target.arch, bu.target.sys, bu.target.abi,
        p.target_entry.libs, p.target_entry.lib_count);
    if (sel cr2.err) { ret err[fail.Fail].err{cr2.err}; }

    if (for_union) {
        val ut: err[fail.Fail] = union.populate_union_tuples(p, m);
        if (sel ut.err) { ret err[fail.Fail].err{ut.err}; }
    }
    if (for_union) {
        val ue: err[fail.Fail] = union.populate_union_entries(p, m);
        if (sel ue.err) { ret err[fail.Fail].err{ue.err}; }
    }

    ret err[fail.Fail].ok{};
}

pub fun module_obj_tree(a: *A.Allocator, proj_out: str, id: str) res[str, fail.Fail] {
    ret layout.within(a, proj_out, layout.OBJ, id);
}

pub fun path_in_module_obj_tree(path: str, tree: str) bool {
    if (str_equals(path, tree))       { ret true; }
    if (!str_starts_with(path, tree)) { ret false; }
    ret types_path.is_separator(path[str_len(tree)]);
}

pub fun step_out_reserved_error(a: *A.Allocator, what: str, name: str, path: str, tree: str, owner_desc: str) fail.Fail {
    ret fail.formatted_user(a, diagnostic_kind.STEP_OUTPUT_RESERVED,
        "{} '{}' writes '{}' into '{}/', {}: the compiler owns that directory, so a step output there is overwritten by (or overwrites) compiler state. write it elsewhere under {{project.work}}",
        what, name, path, tree, owner_desc);
}

# one declared step output: its expanded path, its step, and where it is written
rec DeclaredStepOutput {
    path: str;
    step: str;
    at:   fail.Place;
}

# by path, then step, then where each is written, so of two claims the earlier
# written one leads
fun declared_step_output_compare(a: *DeclaredStepOutput, b: *DeclaredStepOutput) i64 {
    val pc: i64 = str_compare(a.path, b.path);
    if (pc != 0) { ret pc; }
    val sc: i64 = str_compare(a.step, b.step);
    if (sc != 0)                             { ret sc; }
    if (a.at.span.offset < b.at.span.offset) { ret -1; }
    if (a.at.span.offset > b.at.span.offset) { ret 1; }
    ret 0;
}

fun declared_step_outputs_free(a: *A.Allocator, outputs: *Vector[DeclaredStepOutput]) {
    var i: usize = 0;
    for (i < outputs.len) {
        str_free(a, outputs.data[i].path);
        i = i + 1;
    }
    collections_vector.dnit[DeclaredStepOutput](outputs);
}

fun validate_declared_step_output_collisions(a: *A.Allocator, outputs: *Vector[DeclaredStepOutput]) err[fail.Fail] {
    sort.sort_by[DeclaredStepOutput](outputs.data, outputs.len, declared_step_output_compare);
    var i: usize = 0;
    for (i < outputs.len) {
        var j: usize = i + 1;
        for (j < outputs.len) {
            val left:  *DeclaredStepOutput = ?outputs.data[i];
            val right: *DeclaredStepOutput = ?outputs.data[j];
            val exact: bool                = str_equals(left.path, right.path);
            if (exact || path_in_module_obj_tree(right.path, left.path)) {
                var claims: [2]fail.Place;
                claims[0] = left.at;
                claims[1] = right.at;
                if (exact && str_equals(left.step, right.step)) {
                    ret err[fail.Fail].err{manifest.at_sites(a, fail.formatted_user(a, diagnostic_kind.STEP_OUTPUT_DUPLICATE, "mach.toml: [step.{}] declares output '{}' more than once", left.step, left.path), ?claims[0], 2)};
                }
                ret err[fail.Fail].err{manifest.at_sites(a, fail.formatted_user(a, diagnostic_kind.STEP_OUTPUT_COLLISION, "mach.toml: [step.{}] output '{}' collides with [step.{}] output '{}'", left.step, left.path, right.step, right.path), ?claims[0], 2)};
            }
            j = j + 1;
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun validate_step_outputs(p: *project.Project, m: *manifest.Manifest, proj_out: str, v: *template.Values) err[fail.Fail] {
    if (m.step_count == 0) { ret err[fail.Fail].ok{}; }

    val tree_r: res[str, fail.Fail] = module_obj_tree(p.alloc, proj_out, intern.text(?p.s.interner, m.id));
    if (sel tree_r.err) { ret err[fail.Fail].err{tree_r.err}; }
    val tree: str = tree_r.ok;
    fin { str_free(p.alloc, tree); }
    val stage_tree_r: res[str, fail.Fail] = layout.under(p.alloc, proj_out, layout.STAGE);
    if (sel stage_tree_r.err) { ret err[fail.Fail].err{stage_tree_r.err}; }
    val stage_tree: str = stage_tree_r.ok;
    fin { str_free(p.alloc, stage_tree); }
    val cache_tree_r: res[str, fail.Fail] = layout.under(p.alloc, proj_out, layout.CACHE);
    if (sel cache_tree_r.err) { ret err[fail.Fail].err{cache_tree_r.err}; }
    val cache_tree: str = cache_tree_r.ok;
    fin { str_free(p.alloc, cache_tree); }
    var outputs: Vector[DeclaredStepOutput] = collections_vector.init[DeclaredStepOutput](p.alloc);
    fin { declared_step_outputs_free(p.alloc, ?outputs); }

    var si: u32 = 0;
    for (si < m.step_count) {
        val step:  *manifest.StepDef = ?m.steps[si];
        val sname: str               = intern.text(?p.s.interner, step.name);

        var oi: u32 = 0;
        for (oi < step.out_count) {
            val at:    fail.Place          = manifest.site_of(step.out_at, oi);
            val exp_r: res[str, fail.Fail] = template.path_expand(p.alloc, intern.text(?p.s.interner, step.out[oi]), template.CONTEXT_PATH, proj_out, v, "a build step output");
            if (sel exp_r.err) { ret err[fail.Fail].err{fail.at(p.alloc, exp_r.err, at)}; }
            val exp:    str  = exp_r.ok;
            var pushed: bool = false;
            fin {
                if (!pushed) { str_free(p.alloc, exp); }
            }

            var reserved_tree: str = "";
            var reserved_desc: str = "";
            if (path_in_module_obj_tree(exp, tree)) {
                reserved_tree = tree;
                reserved_desc = "the module object tree";
            }
            or (path_in_module_obj_tree(exp, stage_tree)) {
                reserved_tree = stage_tree;
                reserved_desc = "the build step staging area";
            }
            or (path_in_module_obj_tree(exp, cache_tree)) {
                reserved_tree = cache_tree;
                reserved_desc = "the compiler cache directory";
            }
            if (!str_empty(reserved_tree)) {
                var refusal: fail.Fail           = fail.reported();
                val label:   res[str, fail.Fail] = fail.format(p.alloc, "[step.{}]", sname);
                if (sel label.err) { refusal = label.err; }
                or (sel label.ok) {
                    refusal = fail.at(p.alloc, step_out_reserved_error(p.alloc, "mach.toml: declared output of", label.ok, exp, reserved_tree, reserved_desc), at);
                    str_free(p.alloc, label.ok);
                }
                ret err[fail.Fail].err{refusal};
            }
            val push_r: res[usize, A.Error] = collections_vector.push[DeclaredStepOutput](?outputs, DeclaredStepOutput{path: exp, step: sname, at: at});
            if (sel push_r.err) { ret err[fail.Fail].err{fail.refused(push_r.err)}; }
            pushed = true;
            oi     = oi + 1;
        }
        si = si + 1;
    }
    val collision_r: err[fail.Fail] = validate_declared_step_output_collisions(p.alloc, ?outputs);
    if (sel collision_r.err) { ret err[fail.Fail].err{collision_r.err}; }
    ret err[fail.Fail].ok{};
}

fun compute_step_plan(p: *project.Project, m: *manifest.Manifest, bu: *manifest.BuildUnit,
    for_union: bool, proj_out: str, v: *template.Values) err[fail.Fail] {
    p.config.step_order       = nil;
    p.config.step_order_count = 0;
    if (m.step_count == 0) { ret err[fail.Fail].ok{}; }

    var names:  *intern.StrId = nil;
    var ncount: u32           = 0;
    var owned:  bool          = false;
    if (for_union && m.artifact_count > 0) {
        val ar: res[*intern.StrId, A.Error] = A.allocate[intern.StrId](p.alloc, m.artifact_count::usize);
        if (sel ar.err) { ret err[fail.Fail].err{fail.refused(ar.err)}; }
        names = ar.ok;
        owned = true;
        var i: u32 = 0;
        for (i < m.artifact_count) {
            names[i] = m.artifacts[i].name;
            i        = i + 1;
        }
        ncount = m.artifact_count;
    }
    or {
        if (bu.artifact == nil) { ret err[fail.Fail].ok{}; }
        names  = ?bu.artifact.name;
        ncount = 1;
    }

    var order: *u32           = nil;
    var count: u32            = 0;
    val r:     err[fail.Fail] = manifest.plan_steps(p.alloc, ?p.s.interner, m, names, ncount, bu.target, proj_out, v, ?order, ?count);
    if (owned)     { A.deallocate[intern.StrId](p.alloc, names, m.artifact_count::usize); }
    if (sel r.err) { ret err[fail.Fail].err{r.err}; }
    p.config.step_order       = order;
    p.config.step_order_count = count;
    ret err[fail.Fail].ok{};
}

fun validate_local_links(p: *project.Project, project_root: str, m: *manifest.Manifest, t: *manifest.TargetDef, proj_out: str, v: *template.Values) err[fail.Fail] {
    var li: u32 = 0;
    for (li < m.link_count) {
        val l: *manifest.LinkDef = ?m.links[li];
        if (l.source == manifest.LINK_LOCAL && manifest.link_matches_target(?p.s.interner, l, t)) {
            val ename: str = intern.text(?p.s.interner, l.name);

            val exp_r: res[str, fail.Fail] = manifest.expand_local_path(p.alloc, ?p.s.interner, l, proj_out, v);
            if (sel exp_r.err) { ret err[fail.Fail].err{exp_r.err}; }
            val exp: str = exp_r.ok;
            fin { str_free(p.alloc, exp); }

            val demanded: res[bool, fail.Fail] = manifest.local_path_demanded_by_step(p.alloc, ?p.s.interner, m, exp, proj_out, v);
            if (sel demanded.err) { ret err[fail.Fail].err{demanded.err}; }
            var ok_: bool = demanded.ok;
            if (!ok_) {
                val abs_r: res[str, fail.Fail] = driver_load.join_path(p.alloc, project_root, exp);
                if (sel abs_r.ok) {
                    val abs:      str                       = abs_r.ok;
                    val exists_r: res[bool, io_error.Error] = fs.exists(abs);
                    ok_ = (sel exists_r.ok && exists_r.ok);
                    str_free(p.alloc, abs);
                }
            }
            if (!ok_) {
                val refusal: fail.Fail = fail.formatted_user(p.alloc, diagnostic_kind.LINK_LOCAL_MISSING,
                    "mach.toml: [link.{}] path '{}' matches no step output and does not exist on disk", ename, exp);
                ret err[fail.Fail].err{fail.at(p.alloc, refusal, l.path_at)};
            }
        }
        li = li + 1;
    }
    ret err[fail.Fail].ok{};
}

pub fun select_target(p: *project.Project, t: *project.TargetEntry) err[fail.Fail] {
    val toolchain_r: res[*lang_target.TargetRegistry, fail.Fail] = toolchain.registry();
    if (sel toolchain_r.err) { ret err[fail.Fail].err{toolchain_r.err}; }
    val toolchain: *lang_target.TargetRegistry         = toolchain_r.ok;
    val tr:        res[lang_target.Binding, fail.Fail] = manifest.resolve_declared(p.s.alloc, ?p.s.interner, toolchain, ?t.declared);
    if (sel tr.err) { ret err[fail.Fail].err{fail.as_user(diagnostic_kind.TARGET_INVALID, tr.err)}; }
    p.target = tr.ok;
    backend.close(p.alloc, ?p.back);
    val opened: res[backend.Back, fail.Fail] = backend.open(p.alloc, ?p.target.target);
    if (sel opened.err) { ret err[fail.Fail].err{fail.as_user(diagnostic_kind.TARGET_INVALID, opened.err)}; }
    p.back = opened.ok;

    val rcn: res[intern.StrId, A.Error] = intern.add(?p.s.interner, "mach");
    if (sel rcn.err) { ret err[fail.Fail].err{fail.refused(rcn.err)}; }
    p.compiler_name = rcn.ok;

    val rcv: res[intern.StrId, A.Error] = intern.add(?p.s.interner, driver_load.MACH_VERSION);
    if (sel rcv.err) { ret err[fail.Fail].err{fail.refused(rcv.err)}; }
    p.compiler_ver = rcv.ok;

    ret err[fail.Fail].ok{};
}
