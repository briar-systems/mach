    var bad: i32 = 0;

    var host_sel: manifest.Selection = manifest.Selection{target: "", profile: "", artifact: "", want_lib: false, has_artifact: false};
    val host_r: R.Result[RunArtifact, str] = resolve_run_artifact(?alloc, host_root, ?host_sel, nil);
    if (R.is_err[RunArtifact, str](host_r) || !R.unwrap_ok[RunArtifact, str](host_r).host_runnable) { bad = 1; }
