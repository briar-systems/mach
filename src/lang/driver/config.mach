pub fun resolve_artifact_path(alloc: *A.Allocator, project_root: str, sel: *manifest.Selection) R.Result[str, str] {
    val mp_r: R.Result[str, str] = load.join_path(alloc, project_root, manifest.MANIFEST_FILE);
    if (R.is_err[str, str](mp_r)) { ret R.err[str, str](R.unwrap_err[str, str](mp_r)); }
    val manifest_path: str = R.unwrap_ok[str, str](mp_r);

    val toml_r: R.Result[toml.Table, str] = ddep.parse_toml_file(alloc, manifest_path);
    if (R.is_err[toml.Table, str](toml_r)) { ret R.err[str, str](R.unwrap_err[toml.Table, str](toml_r)); }
    var t: toml.Table = R.unwrap_ok[toml.Table, str](toml_r);

    var itn: intern.Interner = intern.init(alloc);
    val mr: R.Result[manifest.Manifest, str] = manifest.parse(alloc, ?itn, ?t, true);
    toml.dnit(alloc, ?t);
    if (R.is_err[manifest.Manifest, str](mr)) { ret R.err[str, str](R.unwrap_err[manifest.Manifest, str](mr)); }
    var m: manifest.Manifest = R.unwrap_ok[manifest.Manifest, str](mr);

    var eff_sel: manifest.Selection = @sel;
    val ssr: R.Result[R.Void, str] = manifest.select_sole_target_artifact(
        alloc, ?itn, ?m, ?eff_sel);
    if (R.is_err[R.Void, str](ssr)) {
        manifest.dnit(?m, alloc);
        ret R.err[str, str](R.unwrap_err[R.Void, str](ssr));
    }

    val ur: R.Result[manifest.BuildUnit, str] = manifest.resolve_build_unit(alloc, ?itn, ?m, eff_sel);
    if (R.is_err[manifest.BuildUnit, str](ur)) {
        manifest.dnit(?m, alloc);
        ret R.err[str, str](R.unwrap_err[manifest.BuildUnit, str](ur));
    }
    val bu: manifest.BuildUnit = R.unwrap_ok[manifest.BuildUnit, str](ur);

    val bin_opt: O.Option[str] = intern.lookup(?itn, bu.bin_path);
    if (O.is_none[str](bin_opt) || str_empty(O.unwrap[str](bin_opt))) {
        manifest.dnit(?m, alloc);
        ret R.err[str, str]("selected artifact has no output path; set the `out` template in mach.toml");
    }
    val abs_r: R.Result[str, str] = load.join_path(alloc, project_root, O.unwrap[str](bin_opt));
    manifest.dnit(?m, alloc);
    ret abs_r;
}

pub rec RunArtifact {
    path:          str;
    host_runnable: bool;
    target_name:   str;
}

pub fun resolve_run_artifact(alloc: *A.Allocator, project_root: str, sel: *manifest.Selection,
                             output_override: str) R.Result[RunArtifact, str] {
    val mp_r: R.Result[str, str] = load.join_path(alloc, project_root, manifest.MANIFEST_FILE);
    if (R.is_err[str, str](mp_r)) { ret R.err[RunArtifact, str](R.unwrap_err[str, str](mp_r)); }
    val manifest_path: str = R.unwrap_ok[str, str](mp_r);

    val toml_r: R.Result[toml.Table, str] = ddep.parse_toml_file(alloc, manifest_path);
    if (R.is_err[toml.Table, str](toml_r)) { ret R.err[RunArtifact, str](R.unwrap_err[toml.Table, str](toml_r)); }
    var t: toml.Table = R.unwrap_ok[toml.Table, str](toml_r);

    var itn: intern.Interner = intern.init(alloc);
    val mr: R.Result[manifest.Manifest, str] = manifest.parse(alloc, ?itn, ?t, true);
    toml.dnit(alloc, ?t);
    if (R.is_err[manifest.Manifest, str](mr)) { ret R.err[RunArtifact, str](R.unwrap_err[manifest.Manifest, str](mr)); }
    var m: manifest.Manifest = R.unwrap_ok[manifest.Manifest, str](mr);

    var eff_sel: manifest.Selection = @sel;
    val ssr: R.Result[R.Void, str] = manifest.select_sole_executable_artifact(alloc, ?itn, ?m, ?eff_sel);
    if (R.is_err[R.Void, str](ssr)) {
        manifest.dnit(?m, alloc);
        ret R.err[RunArtifact, str](R.unwrap_err[R.Void, str](ssr));
    }

    val ur: R.Result[manifest.BuildUnit, str] = manifest.resolve_build_unit(alloc, ?itn, ?m, eff_sel);
    if (R.is_err[manifest.BuildUnit, str](ur)) {
        manifest.dnit(?m, alloc);
        ret R.err[RunArtifact, str](R.unwrap_err[manifest.BuildUnit, str](ur));
    }
    val bu: manifest.BuildUnit = R.unwrap_ok[manifest.BuildUnit, str](ur);

    if (bu.is_lib) {
        var name: str = "?";
        val name_opt: O.Option[str] = intern.lookup(?itn, bu.artifact.name);
        if (O.is_some[str](name_opt)) { name = O.unwrap[str](name_opt); }
        val msg: str = sfmt(alloc, "selected artifact '{}' is a library; run executes only bin artifacts", name);
        manifest.dnit(?m, alloc);
        ret R.err[RunArtifact, str](msg);
    }

    var ra: RunArtifact;
    ra.host_runnable = manifest.target_matches_host(?itn, bu.target, target.host_os_id(), target.host_arch_id());
    ra.target_name    = "?";
    val tname_opt: O.Option[str] = intern.lookup(?itn, bu.target.name);
    if (O.is_some[str](tname_opt)) { ra.target_name = O.unwrap[str](tname_opt); }

    if (output_override != nil) {
        if (str_empty(output_override)) {
            manifest.dnit(?m, alloc);
            ret R.err[RunArtifact, str]("-o requires a non-empty path");
        }
        val resolved_r: R.Result[spath.Path, str] = spath.resolve(alloc, project_root, output_override);
        if (R.is_err[spath.Path, str](resolved_r)) {
            manifest.dnit(?m, alloc);
            ret R.err[RunArtifact, str](sfmt(alloc, "-o '{}': {}", output_override, R.unwrap_err[spath.Path, str](resolved_r)));
        }
        val cleaned_r: R.Result[spath.Path, str] = spath.clean(alloc, R.unwrap_ok[spath.Path, str](resolved_r));
        if (R.is_err[spath.Path, str](cleaned_r)) {
            manifest.dnit(?m, alloc);
            ret R.err[RunArtifact, str](sfmt(alloc, "-o '{}': {}", output_override, R.unwrap_err[spath.Path, str](cleaned_r)));
        }
        ra.path = R.unwrap_ok[spath.Path, str](cleaned_r);
        manifest.dnit(?m, alloc);
        ret R.ok[RunArtifact, str](ra);
    }

    val bin_opt: O.Option[str] = intern.lookup(?itn, bu.bin_path);
    if (O.is_none[str](bin_opt) || str_empty(O.unwrap[str](bin_opt))) {
        manifest.dnit(?m, alloc);
        ret R.err[RunArtifact, str]("selected artifact has no output path; set the `out` template in mach.toml");
    }
    val abs_r: R.Result[str, str] = load.join_path(alloc, project_root, O.unwrap[str](bin_opt));
    manifest.dnit(?m, alloc);
    if (R.is_err[str, str](abs_r)) { ret R.err[RunArtifact, str](R.unwrap_err[str, str](abs_r)); }
    ra.path = R.unwrap_ok[str, str](abs_r);
    ret R.ok[RunArtifact, str](ra);
}

pub fun load_project_config(p: *project.Project, project_root: str, manifest_path: str, sel: *manifest.Selection, for_union: bool, is_test: bool) R.Result[R.Void, str] {
    val toml_r: R.Result[toml.Table, str] = ddep.parse_toml_file(p.alloc, manifest_path);
    if (R.is_err[toml.Table, str](toml_r)) { ret R.err[R.Void, str](R.unwrap_err[toml.Table, str](toml_r)); }
    var t: toml.Table = R.unwrap_ok[toml.Table, str](toml_r);

    val r: R.Result[R.Void, str] = load_config(p, project_root, ?t, sel, for_union, is_test);
    toml.dnit(p.alloc, ?t);
    ret r;
}

fun load_config(p: *project.Project, project_root: str, t: *toml.Table, sel: *manifest.Selection, for_union: bool, is_test: bool) R.Result[R.Void, str] {
    val mr: R.Result[manifest.Manifest, str] = manifest.parse(p.alloc, ?p.s.interner, t, true);
    if (R.is_err[manifest.Manifest, str](mr)) { ret R.err[R.Void, str](R.unwrap_err[manifest.Manifest, str](mr)); }
    var m: manifest.Manifest = R.unwrap_ok[manifest.Manifest, str](mr);
    val r: R.Result[R.Void, str] = load_config_manifest(p, project_root, ?m, sel, for_union, is_test);
    manifest.dnit(?m, p.alloc);
    ret r;
}

fun dup_strid_array(alloc: *A.Allocator, src: *intern.StrId, count: u32) R.Result[*intern.StrId, str] {
    if (src == nil || count == 0) { ret R.ok[*intern.StrId, str](nil); }
    val r: R.Result[*intern.StrId, str] = A.allocate[intern.StrId](alloc, count::usize);
    if (R.is_err[*intern.StrId, str](r)) { ret r; }
    val arr: *intern.StrId = R.unwrap_ok[*intern.StrId, str](r);
    var i: u32 = 0;
    for (i < count) { arr[i] = src[i]; i = i + 1; }
    ret R.ok[*intern.StrId, str](arr);
}

fun free_step_arrays(alloc: *A.Allocator, d: *manifest.StepDef) {
    if (d.argv != nil && d.argv_count > 0) { A.deallocate[intern.StrId](alloc, d.argv, d.argv_count::usize); }
    if (d.env_keys != nil && d.env_count > 0) { A.deallocate[intern.StrId](alloc, d.env_keys, d.env_count::usize); }
    if (d.env_values != nil && d.env_count > 0) { A.deallocate[intern.StrId](alloc, d.env_values, d.env_count::usize); }
    if (d.in != nil && d.in_count > 0) { A.deallocate[intern.StrId](alloc, d.in, d.in_count::usize); }
    if (d.out != nil && d.out_count > 0) { A.deallocate[intern.StrId](alloc, d.out, d.out_count::usize); }
    if (d.need != nil && d.need_count > 0) { A.deallocate[intern.StrId](alloc, d.need, d.need_count::usize); }
}

fun clone_step(alloc: *A.Allocator, src: *manifest.StepDef, out: *manifest.StepDef) R.Result[R.Void, str] {
    var d: manifest.StepDef = @src;
    d.argv = nil;
    d.env_keys = nil;
    d.env_values = nil;
    d.in = nil;
    d.out = nil;
    d.need = nil;

    val argv_r: R.Result[*intern.StrId, str] = dup_strid_array(alloc, src.argv, src.argv_count);
    if (R.is_err[*intern.StrId, str](argv_r)) { ret R.err[R.Void, str](R.unwrap_err[*intern.StrId, str](argv_r)); }
    d.argv = R.unwrap_ok[*intern.StrId, str](argv_r);

    val env_keys_r: R.Result[*intern.StrId, str] = dup_strid_array(alloc, src.env_keys, src.env_count);
    if (R.is_err[*intern.StrId, str](env_keys_r)) {
        free_step_arrays(alloc, ?d);
        ret R.err[R.Void, str](R.unwrap_err[*intern.StrId, str](env_keys_r));
    }
    d.env_keys = R.unwrap_ok[*intern.StrId, str](env_keys_r);

    val env_values_r: R.Result[*intern.StrId, str] = dup_strid_array(alloc, src.env_values, src.env_count);
    if (R.is_err[*intern.StrId, str](env_values_r)) {
        free_step_arrays(alloc, ?d);
        ret R.err[R.Void, str](R.unwrap_err[*intern.StrId, str](env_values_r));
    }
    d.env_values = R.unwrap_ok[*intern.StrId, str](env_values_r);

    val in_r: R.Result[*intern.StrId, str] = dup_strid_array(alloc, src.in, src.in_count);
    if (R.is_err[*intern.StrId, str](in_r)) {
        free_step_arrays(alloc, ?d);
        ret R.err[R.Void, str](R.unwrap_err[*intern.StrId, str](in_r));
    }
    d.in = R.unwrap_ok[*intern.StrId, str](in_r);

    val out_r: R.Result[*intern.StrId, str] = dup_strid_array(alloc, src.out, src.out_count);
    if (R.is_err[*intern.StrId, str](out_r)) {
        free_step_arrays(alloc, ?d);
        ret R.err[R.Void, str](R.unwrap_err[*intern.StrId, str](out_r));
    }
    d.out = R.unwrap_ok[*intern.StrId, str](out_r);

    val need_r: R.Result[*intern.StrId, str] = dup_strid_array(alloc, src.need, src.need_count);
    if (R.is_err[*intern.StrId, str](need_r)) {
        free_step_arrays(alloc, ?d);
        ret R.err[R.Void, str](R.unwrap_err[*intern.StrId, str](need_r));
    }
    d.need = R.unwrap_ok[*intern.StrId, str](need_r);
    @out = d;
    ret R.ok_void[str]();
}

pub fun load_config_manifest(p: *project.Project, project_root: str, m: *manifest.Manifest, sel: *manifest.Selection, for_union: bool, is_test: bool) R.Result[R.Void, str] {
    val abs_root_r: R.Result[intern.StrId, str] = intern.intern(?p.s.interner, project_root);
    if (R.is_err[intern.StrId, str](abs_root_r)) { ret R.err[R.Void, str](R.unwrap_err[intern.StrId, str](abs_root_r)); }
    p.config.project_root = R.unwrap_ok[intern.StrId, str](abs_root_r);

    var eff_sel: manifest.Selection;
    eff_sel.target       = sel.target;
    eff_sel.profile      = sel.profile;
    eff_sel.artifact     = sel.artifact;
    eff_sel.want_lib     = sel.want_lib;
    eff_sel.has_artifact = sel.has_artifact;
    eff_sel.legacy_default = sel.legacy_default;
    if (for_union || is_test) {
        val psr: R.Result[R.Void, str] = manifest.select_primary_artifact(
            p.alloc, ?p.s.interner, m, ?eff_sel);
        if (R.is_err[R.Void, str](psr)) {
            ret psr;
        }
    }

    val ur: R.Result[manifest.BuildUnit, str] = manifest.resolve_build_unit(p.alloc, ?p.s.interner, m, eff_sel);
    if (R.is_err[manifest.BuildUnit, str](ur)) {
        ret R.err[R.Void, str](R.unwrap_err[manifest.BuildUnit, str](ur));
    }
    val bu: manifest.BuildUnit = R.unwrap_ok[manifest.BuildUnit, str](ur);

    val cell_profile: str = O.unwrap[str](intern.lookup(?p.s.interner, bu.profile_name));
    p.config.art_reqs      = nil;
    p.config.art_req_count = 0;
    val rqr: R.Result[R.Void, str] = manifest.resolve_artifact_reqs(p.alloc, ?p.s.interner, m,
        bu.artifact, bu.target, cell_profile, is_test, ?p.config.art_reqs, ?p.config.art_req_count);
    if (R.is_err[R.Void, str](rqr)) { ret rqr; }

    var cell_v: manifest.TmplVars = manifest.tmpl_vars_with_reqs(?p.s.interner, bu.target,
        cell_profile, p.config.art_reqs, p.config.art_req_count);
    embed.set_path_env(?p.s.embeds, project_root, p.config.art_reqs, p.config.art_req_count);

    val cr: R.Result[R.Void, str] = manifest.check_collisions(p.alloc, ?p.s.interner, m, ?cell_v);
    if (R.is_err[R.Void, str](cr)) {
        ret cr;
    }

    if (bu.warned) { emit_native_warning(p, bu.target_name); }
    if (bu.legacy_target_default)  { emit_legacy_default_warning(p, "target",   "[target.<name>]",   "--target"); }
    if (bu.legacy_profile_default) { emit_legacy_default_warning(p, "profile",  "[profile.<name>]",  "--profile"); }
    if (eff_sel.legacy_default)    { emit_legacy_default_warning(p, "artifact", "[artifact.<name>]", "--bin/--lib"); }

    val ter: R.Result[*project.TargetEntry, str] = A.allocate[project.TargetEntry](p.alloc, 1::usize);
    if (R.is_err[*project.TargetEntry, str](ter)) { ret R.err[R.Void, str](R.unwrap_err[*project.TargetEntry, str](ter)); }
    val targets: *project.TargetEntry = R.unwrap_ok[*project.TargetEntry, str](ter);
    var entry: project.TargetEntry;
    entry.name          = bu.target_name;
    entry.os_name       = bu.target.os;
    entry.isa_name      = bu.target.isa;
    entry.abi_name      = bu.target.abi;
    entry.of_name       = bu.target.of;
    entry.platform_name = bu.target.platform;
    entry.env_name      = bu.target.env;
    entry.base          = bu.target.base;
    entry.stack_reserve = bu.target.stack_reserve;
    entry.stack_commit  = bu.target.stack_commit;
    entry.entrypoint    = bu.entry;
    entry.mode          = project.MODE_EXECUTABLE;
    if (bu.is_lib) { entry.mode = project.MODE_LIBRARY; }
    entry.lib_kind      = bu.kind;
    entry.opt           = project.map_opt(bu.opt);
    entry.libs          = bu.libs;
    entry.lib_count     = bu.lib_count;
    targets[0] = entry;

    p.config.id           = m.id;
    p.config.version      = m.version;
    p.config.bin_name     = intern.STR_NIL;
    p.config.icon         = intern.STR_NIL;
    p.config.app_manifest = intern.STR_NIL;
    if (bu.artifact != nil) {
        p.config.bin_name     = bu.artifact.name;
        p.config.icon         = bu.artifact.icon;
        p.config.app_manifest = bu.artifact.app_manifest;
    }
    p.config.module       = bu.entry;
    p.config.dir_src      = m.src;
    val res_dep_id: R.Result[intern.StrId, str] = intern.intern(?p.s.interner, "dep");
    if (R.is_ok[intern.StrId, str](res_dep_id)) {
        p.config.dir_dep = R.unwrap_ok[intern.StrId, str](res_dep_id);
    }
    p.config.targets      = targets;
    p.config.target_count = 1;
    p.target_entry        = ?p.config.targets[0];
    p.config.profile      = bu.profile_name;
    p.config.step_order       = nil;
    p.config.step_order_count = 0;

    val out_tmpl_s: str = O.unwrap[str](intern.lookup(?p.s.interner, m.out_tmpl));
    val res_project_out_str: R.Result[str, str] = manifest.expand_project_path(p.alloc, out_tmpl_s, "", ?cell_v, "[project].out");
    if (R.is_err[str, str](res_project_out_str)) { ret R.err[R.Void, str](R.unwrap_err[str, str](res_project_out_str)); }
    val project_out_str: str = R.unwrap_ok[str, str](res_project_out_str);
    val res_po_id: R.Result[intern.StrId, str] = intern.intern(?p.s.interner, project_out_str);
    if (R.is_err[intern.StrId, str](res_po_id)) {
        str_free(p.alloc, project_out_str);
        ret R.err[R.Void, str](R.unwrap_err[intern.StrId, str](res_po_id));
    }
    p.config.project_out = R.unwrap_ok[intern.StrId, str](res_po_id);

    val vr: R.Result[R.Void, str] = validate_local_links(p, project_root, m, bu.target, project_out_str, ?cell_v);
    if (R.is_err[R.Void, str](vr)) { str_free(p.alloc, project_out_str); ret vr; }

    val sor: R.Result[R.Void, str] = validate_step_outputs(p, m, project_out_str, ?cell_v);
    if (R.is_err[R.Void, str](sor)) { str_free(p.alloc, project_out_str); ret sor; }

    if (is_test) {
        var test_items: *manifest.LinkRequirement = nil;
        var test_count: u32 = 0;
        val tlr: R.Result[R.Void, str] = manifest.resolve_test_libs(p.alloc, ?p.s.interner, m, bu.target, project_out_str, ?cell_v, ?test_items, ?test_count);
        if (R.is_err[R.Void, str](tlr)) { str_free(p.alloc, project_out_str); ret tlr; }
        p.config.targets[0].libs      = test_items;
        p.config.targets[0].lib_count = test_count;
    }

    val spr: R.Result[R.Void, str] = compute_step_plan(p, m, ?bu, is_test, for_union, project_out_str, ?cell_v);
    if (R.is_err[R.Void, str](spr)) { str_free(p.alloc, project_out_str); ret spr; }
    str_free(p.alloc, project_out_str);

    p.config.steps      = nil;
    p.config.step_count = 0;
    if (m.step_count > 0) {
        val res_steps: R.Result[*manifest.StepDef, str] = A.allocate[manifest.StepDef](p.alloc, m.step_count::usize);
        if (R.is_err[*manifest.StepDef, str](res_steps)) {
            ret R.err[R.Void, str](R.unwrap_err[*manifest.StepDef, str](res_steps));
        }
        val steps: *manifest.StepDef = R.unwrap_ok[*manifest.StepDef, str](res_steps);
        var si: u32 = 0;
        for (si < m.step_count) {
            val clone_r: R.Result[R.Void, str] = clone_step(p.alloc, ?m.steps[si], ?steps[si]);
            if (R.is_err[R.Void, str](clone_r)) {
                var sj: u32 = 0;
                for (sj < si) { free_step_arrays(p.alloc, ?steps[sj]); sj = sj + 1; }
                A.deallocate[manifest.StepDef](p.alloc, steps, m.step_count::usize);
                ret clone_r;
            }
            si = si + 1;
        }
        p.config.steps      = steps;
        p.config.step_count = m.step_count;
    }

    val dr: R.Result[R.Void, str] = ddep.resolve_deps(p, m, project_root);
    if (R.is_err[R.Void, str](dr)) { ret dr; }

    emit_deprecated_key_warnings(p, "", m);
    var dk: u32 = 0;
    for (dk < p.config.dep_count) {
        val alias_opt: O.Option[str] = intern.lookup(?p.s.interner, p.config.deps[dk].alias);
        if (O.is_some[str](alias_opt)) {
            val prefix_r: R.Result[str, str] = format.sprint(p.alloc, "dep '{}' ", O.unwrap[str](alias_opt));
            if (R.is_ok[str, str](prefix_r)) {
                val prefix: str = R.unwrap_ok[str, str](prefix_r);
                emit_deprecated_key_warnings(p, prefix, ?p.config.deps[dk].manifest);
                str_free(p.alloc, prefix);
            }
        }
        dk = dk + 1;
    }

    val isa_opt: O.Option[str] = intern.lookup(?p.s.interner, bu.target.isa);
    val os_opt: O.Option[str] = intern.lookup(?p.s.interner, bu.target.os);
    val abi_opt: O.Option[str] = intern.lookup(?p.s.interner, bu.target.abi);
    if (O.is_none[str](isa_opt) || O.is_none[str](os_opt) || O.is_none[str](abi_opt)) {
        ret R.err[R.Void, str]("internal: selected target tuple not interned");
    }
    val cr2: R.Result[R.Void, str] = ddep.resolve_cascade_libs(p,
        O.unwrap[str](isa_opt), O.unwrap[str](os_opt), O.unwrap[str](abi_opt),
        p.target_entry.libs, p.target_entry.lib_count);
    if (R.is_err[R.Void, str](cr2)) { ret cr2; }

    if (for_union) {
        val ut: R.Result[R.Void, str] = union.populate_union_tuples(p, m);
        if (R.is_err[R.Void, str](ut)) { ret ut; }
        val ue: R.Result[R.Void, str] = union.populate_union_entries(p, m);
        if (R.is_err[R.Void, str](ue)) { ret ue; }
    }

    ret R.ok_void[str]();
}

fun emit_deprecated_key_warnings(p: *project.Project, prefix: str, m: *manifest.Manifest) {
    var i: u32 = 0;
    for (i < m.deprecated_count) {
        val msg: str = manifest.deprecated_key_warning(p.alloc, prefix, ?m.deprecated[i]);
        var span: token.Span;
        span.offset = 0;
        span.len    = 0;
        diagnostic.record_warning(?p.s.diags, 0xFFFFFFFF::src.FileId, span, msg);
        str_free(p.alloc, msg);
        i = i + 1;
    }
}

fun emit_legacy_default_warning(p: *project.Project, axis: str, table: str, flag: str) {
    val res_msg: R.Result[str, str] = format.sprint(p.alloc,
        "mach.toml: several {}s are declared and none is marked `default = true`; the first declared {} is selected by table order, which 5.0.0 stops doing: mark exactly one {} with `default = true` or select one with {}",
        axis, axis, table, flag);
    if (R.is_err[str, str](res_msg)) { ret; }
    val buf: str = R.unwrap_ok[str, str](res_msg);
    var span: token.Span;
    span.offset = 0;
    span.len    = 0;
    diagnostic.record_warning(?p.s.diags, 0xFFFFFFFF::src.FileId, span, buf);
    str_free(p.alloc, buf);
}

fun emit_native_warning(p: *project.Project, target_name: intern.StrId) {
    val tuple: str = manifest.host_tuple(p.alloc);
    val name_opt: O.Option[str] = intern.lookup(?p.s.interner, target_name);
    var name: str = "?";
    if (O.is_some[str](name_opt)) { name = O.unwrap[str](name_opt); }

    val res_msg: R.Result[str, str] = format.sprint(p.alloc, "no declared target matches the host ({}); building '{}'", tuple, name);
    if (R.is_err[str, str](res_msg)) { str_free(p.alloc, tuple); ret; }
    val buf: str = R.unwrap_ok[str, str](res_msg);

    var span: token.Span;
    span.offset = 0;
    span.len    = 0;
    diagnostic.record_warning(?p.s.diags, 0xFFFFFFFF::src.FileId, span, buf);

    str_free(p.alloc, buf);
    str_free(p.alloc, tuple);
}

fun local_link_error(alloc: *A.Allocator, name: str, path: str) str {
    val res_msg: R.Result[str, str] = format.sprint(alloc, "mach.toml: [link.{}] path '{}' matches no step output and does not exist on disk", name, path);
    if (R.is_err[str, str](res_msg)) { ret "mach.toml: a local link path matches no step output and does not exist on disk"; }
    ret R.unwrap_ok[str, str](res_msg);
}

fun module_obj_tree(a: *A.Allocator, proj_out: str, id: str) str {
    ret sfmt(a, "{}/obj/{}", proj_out, id);
}

val STEP_STAGE_DIR: str = ".mach-stage";
val STEP_STAMP_DIR: str = ".steps";

fun step_stage_tree(a: *A.Allocator, proj_out: str) str {
    ret sfmt(a, "{}/{}", proj_out, STEP_STAGE_DIR);
}

fun step_stamp_tree(a: *A.Allocator, proj_out: str) str {
    ret sfmt(a, "{}/{}", proj_out, STEP_STAMP_DIR);
}

fun path_in_module_obj_tree(path: str, tree: str) bool {
    if (str_equals(path, tree)) { ret true; }
    if (!str_starts_with(path, tree)) { ret false; }
    ret spath.is_separator(path[str_len(tree)]);
}

fun step_out_reserved_error(a: *A.Allocator, what: str, name: str, path: str, tree: str, owner_desc: str) str {
    val res_msg: R.Result[str, str] = format.sprint(a,
        "{} '{}' writes '{}' into '{}/', {}: the compiler owns that directory, so a step output there is overwritten by (or overwrites) compiler state. write it elsewhere under {{project.out}}",
        what, name, path, tree, owner_desc);
    if (R.is_err[str, str](res_msg)) { ret "a build step writes into a directory the compiler owns"; }
    ret R.unwrap_ok[str, str](res_msg);
}

rec DeclaredStepOutput {
    path: str;
    step: str;
}

fun declared_step_output_compare(a: *DeclaredStepOutput, b: *DeclaredStepOutput) i64 {
    val pc: i64 = str_compare(a.path, b.path);
    if (pc != 0) { ret pc; }
    ret str_compare(a.step, b.step);
}

fun declared_step_outputs_free(a: *A.Allocator, outputs: *Vector[DeclaredStepOutput]) {
    var i: usize = 0;
    for (i < outputs.len) {
        str_free(a, outputs.data[i].path);
        i = i + 1;
    }
    vector.dnit[DeclaredStepOutput](outputs);
}

fun validate_declared_step_output_collisions(a: *A.Allocator, outputs: *Vector[DeclaredStepOutput]) R.Result[R.Void, str] {
    sort.sort[DeclaredStepOutput](outputs.data, outputs.len, declared_step_output_compare);
    var i: usize = 0;
    for (i < outputs.len) {
        var j: usize = i + 1;
        for (j < outputs.len) {
            val left: *DeclaredStepOutput = ?outputs.data[i];
            val right: *DeclaredStepOutput = ?outputs.data[j];
            val exact: bool = str_equals(left.path, right.path);
            if (exact || path_in_module_obj_tree(right.path, left.path)) {
                if (exact && str_equals(left.step, right.step)) {
                    ret R.err[R.Void, str](sfmt(a, "mach.toml: [step.{}] declares output '{}' more than once", left.step, left.path));
                }
                ret R.err[R.Void, str](sfmt(a, "mach.toml: [step.{}] output '{}' collides with [step.{}] output '{}'", left.step, left.path, right.step, right.path));
            }
            j = j + 1;
        }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

fun free_step_reserved_trees(a: *A.Allocator, tree: str, stage_tree: str, stamp_tree: str) {
    str_free(a, tree);
    str_free(a, stage_tree);
    str_free(a, stamp_tree);
}

fun validate_step_outputs(p: *project.Project, m: *manifest.Manifest, proj_out: str, v: *manifest.TmplVars) R.Result[R.Void, str] {
    if (m.step_count == 0) { ret R.ok_void[str](); }

    val id_opt: O.Option[str] = intern.lookup(?p.s.interner, m.id);
    if (O.is_none[str](id_opt)) { ret R.err[R.Void, str]("internal: project id not interned"); }
    val tree: str = module_obj_tree(p.alloc, proj_out, O.unwrap[str](id_opt));
    val stage_tree: str = step_stage_tree(p.alloc, proj_out);
    val stamp_tree: str = step_stamp_tree(p.alloc, proj_out);
    var outputs: Vector[DeclaredStepOutput] = vector.init[DeclaredStepOutput](p.alloc);

    var si: u32 = 0;
    for (si < m.step_count) {
        val step: *manifest.StepDef = ?m.steps[si];
        val name_opt: O.Option[str] = intern.lookup(?p.s.interner, step.name);
        if (O.is_none[str](name_opt)) { declared_step_outputs_free(p.alloc, ?outputs); free_step_reserved_trees(p.alloc, tree, stage_tree, stamp_tree); ret R.err[R.Void, str]("internal: step name not interned"); }
        val sname: str = O.unwrap[str](name_opt);

        var oi: u32 = 0;
        for (oi < step.out_count) {
            val raw_opt: O.Option[str] = intern.lookup(?p.s.interner, step.out[oi]);
            if (O.is_none[str](raw_opt)) { declared_step_outputs_free(p.alloc, ?outputs); free_step_reserved_trees(p.alloc, tree, stage_tree, stamp_tree); ret R.err[R.Void, str]("internal: step output not interned"); }

            val exp_r: R.Result[str, str] = manifest.expand_project_path(p.alloc, O.unwrap[str](raw_opt), proj_out, v, "a build step output");
            if (R.is_err[str, str](exp_r)) { declared_step_outputs_free(p.alloc, ?outputs); free_step_reserved_trees(p.alloc, tree, stage_tree, stamp_tree); ret R.err[R.Void, str](R.unwrap_err[str, str](exp_r)); }
            val exp: str = R.unwrap_ok[str, str](exp_r);

            var reserved_tree: str = "";
            var reserved_desc: str = "";
            if (path_in_module_obj_tree(exp, tree))        { reserved_tree = tree;       reserved_desc = "the module object tree"; }
            or (path_in_module_obj_tree(exp, stage_tree))  { reserved_tree = stage_tree; reserved_desc = "the build step staging area"; }
            or (path_in_module_obj_tree(exp, stamp_tree))  { reserved_tree = stamp_tree; reserved_desc = "the build step cache directory"; }
            if (!str_empty(reserved_tree)) {
                val label: str = sfmt(p.alloc, "[step.{}]", sname);
                val msg: str = step_out_reserved_error(p.alloc, "mach.toml: declared output of", label, exp, reserved_tree, reserved_desc);
                str_free(p.alloc, label);
                str_free(p.alloc, exp);
                declared_step_outputs_free(p.alloc, ?outputs);
                free_step_reserved_trees(p.alloc, tree, stage_tree, stamp_tree);
                ret R.err[R.Void, str](msg);
            }
            val push_r: R.Result[usize, str] = vector.push[DeclaredStepOutput](?outputs, DeclaredStepOutput{path: exp, step: sname});
            if (R.is_err[usize, str](push_r)) {
                str_free(p.alloc, exp);
                declared_step_outputs_free(p.alloc, ?outputs);
                free_step_reserved_trees(p.alloc, tree, stage_tree, stamp_tree);
                ret R.err[R.Void, str](R.unwrap_err[usize, str](push_r));
            }
            oi = oi + 1;
        }
        si = si + 1;
    }
    val collision_r: R.Result[R.Void, str] = validate_declared_step_output_collisions(p.alloc, ?outputs);
    declared_step_outputs_free(p.alloc, ?outputs);
    free_step_reserved_trees(p.alloc, tree, stage_tree, stamp_tree);
    if (R.is_err[R.Void, str](collision_r)) { ret collision_r; }
    ret R.ok_void[str]();
}

fun compute_step_plan(p: *project.Project, m: *manifest.Manifest, bu: *manifest.BuildUnit,
                      is_test: bool, for_union: bool, proj_out: str, v: *manifest.TmplVars) R.Result[R.Void, str] {
    p.config.step_order       = nil;
    p.config.step_order_count = 0;
    if (m.step_count == 0) { ret R.ok_void[str](); }

    var names:  *intern.StrId = nil;
    var ncount: u32           = 0;
    var owned:  bool          = false;
    if ((is_test || for_union) && m.artifact_count > 0) {
        val ar: R.Result[*intern.StrId, str] = A.allocate[intern.StrId](p.alloc, m.artifact_count::usize);
        if (R.is_err[*intern.StrId, str](ar)) { ret R.err[R.Void, str](R.unwrap_err[*intern.StrId, str](ar)); }
        names = R.unwrap_ok[*intern.StrId, str](ar);
        owned = true;
        var i: u32 = 0;
        for (i < m.artifact_count) { names[i] = m.artifacts[i].name; i = i + 1; }
        ncount = m.artifact_count;
    }
    or {
        if (bu.artifact == nil) { ret R.ok_void[str](); }
        names  = ?bu.artifact.name;
        ncount = 1;
    }

    var order: *u32 = nil;
    var count: u32  = 0;
    val r: R.Result[R.Void, str] = manifest.plan_steps(p.alloc, ?p.s.interner, m, names, ncount, bu.target, proj_out, v, ?order, ?count);
    if (owned) { A.deallocate[intern.StrId](p.alloc, names, m.artifact_count::usize); }
    if (R.is_err[R.Void, str](r)) { ret r; }
    p.config.step_order       = order;
    p.config.step_order_count = count;
    ret R.ok_void[str]();
}

fun validate_local_links(p: *project.Project, project_root: str, m: *manifest.Manifest, t: *manifest.TargetDef, proj_out: str, v: *manifest.TmplVars) R.Result[R.Void, str] {
    var li: u32 = 0;
    for (li < m.link_count) {
        val l: *manifest.LinkDef = ?m.links[li];
        if (l.source == manifest.LINK_LOCAL && manifest.link_matches_target(?p.s.interner, l, t)) {
            val path_opt: O.Option[str] = intern.lookup(?p.s.interner, l.path);
            val name_opt: O.Option[str] = intern.lookup(?p.s.interner, l.name);
            if (O.is_none[str](path_opt) || O.is_none[str](name_opt)) { ret R.err[R.Void, str]("internal: link entry metadata not interned"); }
            val raw_path: str = O.unwrap[str](path_opt);
            val ename:    str = O.unwrap[str](name_opt);

            val exp_r: R.Result[str, str] = manifest.expand_project_path(p.alloc, raw_path, proj_out, v, "a local link path");
            if (R.is_err[str, str](exp_r)) { ret R.err[R.Void, str](R.unwrap_err[str, str](exp_r)); }
            val exp: str = R.unwrap_ok[str, str](exp_r);

            var ok_: bool = manifest.local_path_demanded_by_step(p.alloc, ?p.s.interner, m, exp, proj_out, v);
            if (!ok_) {
                val abs_r: R.Result[str, str] = load.join_path(p.alloc, project_root, exp);
                if (R.is_ok[str, str](abs_r)) {
                    val abs: str = R.unwrap_ok[str, str](abs_r);
                    ok_ = fs.exists(abs);
                    str_free(p.alloc, abs);
                }
            }
            if (!ok_) {
                val msg: str = local_link_error(p.alloc, ename, exp);
                str_free(p.alloc, exp);
                ret R.err[R.Void, str](msg);
            }
            str_free(p.alloc, exp);
        }
        li = li + 1;
    }
    ret R.ok_void[str]();
}

pub fun select_target(p: *project.Project, t: *project.TargetEntry) R.Result[R.Void, str] {
    val os_opt: O.Option[str] = intern.lookup(?p.s.interner, t.os_name);
    if (O.is_none[str](os_opt)) { ret R.err[R.Void, str]("target os name not interned"); }
    val os_name: str = O.unwrap[str](os_opt);

    val isa_opt: O.Option[str] = intern.lookup(?p.s.interner, t.isa_name);
    if (O.is_none[str](isa_opt)) { ret R.err[R.Void, str]("target isa name not interned"); }
    val isa_name: str = O.unwrap[str](isa_opt);

    val abi_opt: O.Option[str] = intern.lookup(?p.s.interner, t.abi_name);
    if (O.is_none[str](abi_opt)) { ret R.err[R.Void, str]("target abi name not interned"); }
    val abi_name: str = O.unwrap[str](abi_opt);

    var of_name: str = "";
    val of_opt: O.Option[str] = intern.lookup(?p.s.interner, t.of_name);
    if (O.is_some[str](of_opt)) { of_name = O.unwrap[str](of_opt); }

    var req: target.TargetRequest = target.target_request(isa_name, os_name, abi_name);
    target.with_of(?req, of_name);
    target.with_image(?req, t.base, t.stack_reserve, t.stack_commit);
    var env_name: str = "";
    val env_opt: O.Option[str] = intern.lookup(?p.s.interner, t.env_name);
    if (O.is_some[str](env_opt)) { env_name = O.unwrap[str](env_opt); }
    var label: str = "";
    val label_opt: O.Option[str] = intern.lookup(?p.s.interner, t.name);
    if (O.is_some[str](label_opt)) { label = O.unwrap[str](label_opt); }
    target.with_env(?req, env_name, label);
    val tr: R.Result[target.Target, str] = target.resolve(?p.s.registry, ?req);
    if (R.is_err[target.Target, str](tr)) { ret R.err[R.Void, str](R.unwrap_err[target.Target, str](tr)); }
    p.target = R.unwrap_ok[target.Target, str](tr);

    val rcn: R.Result[intern.StrId, str] = intern.intern(?p.s.interner, "mach");
    if (R.is_err[intern.StrId, str](rcn)) { ret R.err[R.Void, str](R.unwrap_err[intern.StrId, str](rcn)); }
    p.compiler_name = R.unwrap_ok[intern.StrId, str](rcn);

    val rcv: R.Result[intern.StrId, str] = intern.intern(?p.s.interner, load.MACH_VERSION);
    if (R.is_err[intern.StrId, str](rcv)) { ret R.err[R.Void, str](R.unwrap_err[intern.StrId, str](rcv)); }
    p.compiler_ver = R.unwrap_ok[intern.StrId, str](rcv);

    ret R.ok_void[str]();
}

fun sfmt(alloc: *A.Allocator, fmt: str, va: ...) str {
    val r: R.Result[str, str] = format.sprint(alloc, fmt, va...);
    if (R.is_err[str, str](r)) { ret ""; }
    ret R.unwrap_ok[str, str](r);
}

fun cmp_str(a: *str, b: *str) i64 {
    ret str_compare(@a, @b);
}

pub fun wildcard_match(pat: str, name: str) bool {
    val pn: usize = str_len(pat);
    val nn: usize = str_len(name);
    var pi: usize = 0;
    var ni: usize = 0;
    var star: i64 = -1;
    var mark: usize = 0;
    for (ni < nn) {
        if (pi < pn && pat[pi] == '*'::u8) { star = pi::i64; mark = ni; pi = pi + 1; }
        or (pi < pn && pat[pi] == name[ni]) { pi = pi + 1; ni = ni + 1; }
        or (star >= 0) { pi = (star::usize) + 1; mark = mark + 1; ni = mark; }
        or { ret false; }
    }
    for (pi < pn && pat[pi] == '*'::u8) { pi = pi + 1; }
    ret pi == pn;
}

val PHYSICAL_REGULAR: u8 = 1;
val PHYSICAL_DIRECTORY: u8 = 2;
val PHYSICAL_ENTRY: u8 = 3;

fun physical_mode_valid(mode: u32, expected: u8) bool {
    val kind: u32 = mode & sysos.S_IFMT;
    if (expected == PHYSICAL_REGULAR) { ret kind == sysos.S_IFREG; }
    if (expected == PHYSICAL_DIRECTORY) { ret kind == sysos.S_IFDIR; }
    ret kind == sysos.S_IFREG || kind == sysos.S_IFDIR;
}

fun validate_physical_path_windows(alloc: *A.Allocator, root: str, rel: str, expected: u8, label: str) R.Result[R.Void, str] {
    val n: usize = str_len(rel);
    if (str_equals(rel, ".")) {
        val root_meta_r: R.Result[fs.Metadata, str] = fs.metadata_link(root);
        if (R.is_err[fs.Metadata, str](root_meta_r)) { ret R.err[R.Void, str](sfmt(alloc, "{} '{}' does not exist or cannot be inspected: {}", label, rel, R.unwrap_err[fs.Metadata, str](root_meta_r))); }
        val root_meta: fs.Metadata = R.unwrap_ok[fs.Metadata, str](root_meta_r);
        if (fs.meta_is_symlink(?root_meta)) { ret R.err[R.Void, str](sfmt(alloc, "{} '{}' cannot traverse symlink component '{}'", label, rel, rel)); }
        if (expected == PHYSICAL_REGULAR || !fs.meta_is_dir(?root_meta)) { ret R.err[R.Void, str](sfmt(alloc, "{} '{}' has the wrong filesystem entry type", label, rel)); }
        ret R.ok_void[str]();
    }
    var start: usize = 0;
    for (start < n) {
        var end: usize = start;
        for (end < n && rel[end] != '/'::u8) { end = end + 1; }
        if (end == start) { ret R.err[R.Void, str](sfmt(alloc, "{} '{}' is not a canonical project path", label, rel)); }
        val prefix_r: R.Result[str, str] = str_copy_slice(alloc, rel, 0, end);
        if (R.is_err[str, str](prefix_r)) { ret R.err[R.Void, str](R.unwrap_err[str, str](prefix_r)); }
        val prefix: str = R.unwrap_ok[str, str](prefix_r);
        val abs_r: R.Result[str, str] = spath.resolve(alloc, root, prefix);
        if (R.is_err[str, str](abs_r)) { str_free(alloc, prefix); ret R.err[R.Void, str](R.unwrap_err[str, str](abs_r)); }
        val abs: str = R.unwrap_ok[str, str](abs_r);
        val meta_r: R.Result[fs.Metadata, str] = fs.metadata_link(abs);
        str_free(alloc, abs);
        if (R.is_err[fs.Metadata, str](meta_r)) {
            val msg: str = sfmt(alloc, "{} '{}' does not exist or cannot be inspected at '{}': {}", label, rel, prefix, R.unwrap_err[fs.Metadata, str](meta_r));
            str_free(alloc, prefix);
            ret R.err[R.Void, str](msg);
        }
        val meta: fs.Metadata = R.unwrap_ok[fs.Metadata, str](meta_r);
        if (fs.meta_is_symlink(?meta)) {
            val msg: str = sfmt(alloc, "{} '{}' cannot traverse symlink component '{}'", label, rel, prefix);
            str_free(alloc, prefix);
            ret R.err[R.Void, str](msg);
        }
        val last: bool = end == n;
        if ((!last && !fs.meta_is_dir(?meta)) || (last && expected == PHYSICAL_REGULAR && !fs.meta_is_file(?meta)) || (last && expected == PHYSICAL_DIRECTORY && !fs.meta_is_dir(?meta)) || (last && expected == PHYSICAL_ENTRY && !fs.meta_is_file(?meta) && !fs.meta_is_dir(?meta))) {
            val msg: str = sfmt(alloc, "{} '{}' has the wrong filesystem entry type at '{}'", label, rel, prefix);
            str_free(alloc, prefix);
            ret R.err[R.Void, str](msg);
        }
        str_free(alloc, prefix);
        start = end + 1;
    }
    ret R.ok_void[str]();
}

fun validate_physical_path(alloc: *A.Allocator, root: str, rel: str, expected: u8, label: str) R.Result[R.Void, str] {
    $if ($mach.build.os == $mach.os.windows) {
        ret validate_physical_path_windows(alloc, root, rel, expected, label);
    }
    $or {
        val root_fd_raw: i64 = sysos.open(sysos.AT_FDCWD, root, sysos.O_RDONLY | sysos.O_DIRECTORY, 0);
        if (root_fd_raw < 0) { ret R.err[R.Void, str](sfmt(alloc, "{} root '{}' cannot be opened: {}", label, root, sysos.message(root_fd_raw))); }
        var fd: i32 = root_fd_raw::i32;
        if (str_equals(rel, ".")) {
            val close_r: i64 = sysos.close(fd);
            if (expected == PHYSICAL_REGULAR) { ret R.err[R.Void, str](sfmt(alloc, "{} '{}' has the wrong filesystem entry type", label, rel)); }
            if (close_r < 0) { ret R.err[R.Void, str](sysos.message(close_r)); }
            ret R.ok_void[str]();
        }
        val n: usize = str_len(rel);
        var start: usize = 0;
        for (start < n) {
            var end: usize = start;
            for (end < n && rel[end] != '/'::u8) { end = end + 1; }
            if (end == start) {
                sysos.close(fd);
                ret R.err[R.Void, str](sfmt(alloc, "{} '{}' is not a canonical project path", label, rel));
            }
            val component_r: R.Result[str, str] = str_copy_slice(alloc, rel, start, end - start);
            if (R.is_err[str, str](component_r)) { sysos.close(fd); ret R.err[R.Void, str](R.unwrap_err[str, str](component_r)); }
            val component: str = R.unwrap_ok[str, str](component_r);
            var st: sysos.stat_t;
            val stat_r: i64 = sysos.stat_path(fd, component, ?st, sysos.AT_SYMLINK_NOFOLLOW);
            if (stat_r < 0) {
                val msg: str = sfmt(alloc, "{} '{}' does not exist or cannot be inspected at '{}': {}", label, rel, component, sysos.message(stat_r));
                str_free(alloc, component);
                sysos.close(fd);
                ret R.err[R.Void, str](msg);
            }
            val mode: u32 = sysos.stat_mode(?st);
            val last: bool = end == n;
            if ((mode & sysos.S_IFMT) == sysos.S_IFLNK) {
                val msg: str = sfmt(alloc, "{} '{}' cannot traverse symlink component '{}'", label, rel, component);
                str_free(alloc, component);
                sysos.close(fd);
                ret R.err[R.Void, str](msg);
            }
            if (last) {
                if (!physical_mode_valid(mode, expected)) {
                    val msg: str = sfmt(alloc, "{} '{}' has the wrong filesystem entry type at '{}'", label, rel, component);
                    str_free(alloc, component);
                    sysos.close(fd);
                    ret R.err[R.Void, str](msg);
                }
                str_free(alloc, component);
                val close_r: i64 = sysos.close(fd);
                if (close_r < 0) { ret R.err[R.Void, str](sysos.message(close_r)); }
                ret R.ok_void[str]();
            }
            if ((mode & sysos.S_IFMT) != sysos.S_IFDIR) {
                val msg: str = sfmt(alloc, "{} '{}' has non-directory intermediate component '{}'", label, rel, component);
                str_free(alloc, component);
                sysos.close(fd);
                ret R.err[R.Void, str](msg);
            }
            val next_fd_raw: i64 = sysos.open(fd, component, sysos.O_RDONLY | sysos.O_DIRECTORY, 0);
            str_free(alloc, component);
            if (next_fd_raw < 0) {
                val msg: str = sfmt(alloc, "{} '{}' cannot open an intermediate directory: {}", label, rel, sysos.message(next_fd_raw));
                sysos.close(fd);
                ret R.err[R.Void, str](msg);
            }
            val next_fd: i32 = next_fd_raw::i32;
            var next_st: sysos.stat_t;
            val next_stat_r: i64 = sysos.stat(next_fd, ?next_st);
            if (next_stat_r < 0 || (sysos.stat_mode(?next_st) & sysos.S_IFMT) != sysos.S_IFDIR) {
                sysos.close(next_fd);
                sysos.close(fd);
                ret R.err[R.Void, str](sfmt(alloc, "{} '{}' opened an invalid intermediate directory", label, rel));
            }
            val close_r: i64 = sysos.close(fd);
            if (close_r < 0) {
                sysos.close(next_fd);
                ret R.err[R.Void, str](sysos.message(close_r));
            }
            fd = next_fd;
            start = end + 1;
        }
        sysos.close(fd);
        ret R.err[R.Void, str](sfmt(alloc, "{} '{}' is empty", label, rel));
    }
}

fun validate_contained_ancestors_windows(alloc: *A.Allocator, root: str, rel: str, label: str) R.Result[R.Void, str] {
    val n: usize = str_len(rel);
    var start: usize = 0;
    for (start < n) {
        var end: usize = start;
        for (end < n && rel[end] != '/'::u8) { end = end + 1; }
        if (end == start) { ret R.err[R.Void, str](sfmt(alloc, "{} '{}' is not a canonical project path", label, rel)); }
        val prefix_r: R.Result[str, str] = str_copy_slice(alloc, rel, 0, end);
        if (R.is_err[str, str](prefix_r)) { ret R.err[R.Void, str](R.unwrap_err[str, str](prefix_r)); }
        val prefix: str = R.unwrap_ok[str, str](prefix_r);
        val abs_r: R.Result[str, str] = spath.resolve(alloc, root, prefix);
        if (R.is_err[str, str](abs_r)) { str_free(alloc, prefix); ret R.err[R.Void, str](R.unwrap_err[str, str](abs_r)); }
        val abs: str = R.unwrap_ok[str, str](abs_r);
        val meta_r: R.Result[fs.Metadata, str] = fs.metadata_link(abs);
        str_free(alloc, abs);
        if (R.is_err[fs.Metadata, str](meta_r)) {
            str_free(alloc, prefix);
            ret R.ok_void[str]();
        }
        val meta: fs.Metadata = R.unwrap_ok[fs.Metadata, str](meta_r);
        if (fs.meta_is_symlink(?meta) || !fs.meta_is_dir(?meta)) {
            val msg: str = sfmt(alloc, "{} '{}' cannot traverse non-directory ancestor '{}'", label, rel, prefix);
            str_free(alloc, prefix);
            ret R.err[R.Void, str](msg);
        }
        str_free(alloc, prefix);
        start = end + 1;
    }
    ret R.ok_void[str]();
}

pub fun validate_contained_ancestors(alloc: *A.Allocator, root: str, rel: str, label: str) R.Result[R.Void, str] {
    if (str_empty(rel)) { ret R.ok_void[str](); }
    $if ($mach.build.os == $mach.os.windows) {
        ret validate_contained_ancestors_windows(alloc, root, rel, label);
    }
    $or {
        val root_fd_raw: i64 = sysos.open(sysos.AT_FDCWD, root, sysos.O_RDONLY | sysos.O_DIRECTORY, 0);
        if (root_fd_raw < 0) { ret R.err[R.Void, str](sfmt(alloc, "{} root '{}' cannot be opened: {}", label, root, sysos.message(root_fd_raw))); }
        var fd: i32 = root_fd_raw::i32;
        val n: usize = str_len(rel);
        var start: usize = 0;
        for (start < n) {
            var end: usize = start;
            for (end < n && rel[end] != '/'::u8) { end = end + 1; }
            if (end == start) { sysos.close(fd); ret R.err[R.Void, str](sfmt(alloc, "{} '{}' is not a canonical project path", label, rel)); }
            val component_r: R.Result[str, str] = str_copy_slice(alloc, rel, start, end - start);
            if (R.is_err[str, str](component_r)) { sysos.close(fd); ret R.err[R.Void, str](R.unwrap_err[str, str](component_r)); }
            val component: str = R.unwrap_ok[str, str](component_r);
            var st: sysos.stat_t;
            val stat_r: i64 = sysos.stat_path(fd, component, ?st, sysos.AT_SYMLINK_NOFOLLOW);
            if (stat_r < 0) {
                str_free(alloc, component);
                sysos.close(fd);
                if (stat_r == sysos.ENOENT) { ret R.ok_void[str](); }
                ret R.err[R.Void, str](sfmt(alloc, "{} '{}' cannot inspect ancestor '{}': {}", label, rel, component, sysos.message(stat_r)));
            }
            val mode: u32 = sysos.stat_mode(?st);
            if ((mode & sysos.S_IFMT) != sysos.S_IFDIR) {
                val msg: str = sfmt(alloc, "{} '{}' cannot traverse non-directory ancestor '{}'", label, rel, component);
                str_free(alloc, component);
                sysos.close(fd);
                ret R.err[R.Void, str](msg);
            }
            val next_fd_raw: i64 = sysos.open(fd, component, sysos.O_RDONLY | sysos.O_DIRECTORY, 0);
            str_free(alloc, component);
            if (next_fd_raw < 0) {
                val msg: str = sfmt(alloc, "{} '{}' cannot open ancestor '{}': {}", label, rel, sysos.message(next_fd_raw));
                sysos.close(fd);
                ret R.err[R.Void, str](msg);
            }
            val close_r: i64 = sysos.close(fd);
            if (close_r < 0) { sysos.close(next_fd_raw::i32); ret R.err[R.Void, str](sysos.message(close_r)); }
            fd = next_fd_raw::i32;
            start = end + 1;
        }
        sysos.close(fd);
        ret R.ok_void[str]();
    }
}

test "mach.lang.driver.config.validate_contained_ancestors:missing_real_and_escaping" {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "mach_contained_ancestors");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);
    val root_r: R.Result[str, str] = str_dup(?alloc, fs.temp_path(?tf));
    fs.temp_close_and_remove(?tf);
    if (R.is_err[str, str](root_r)) { ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);
    if (O.is_some[str](fs.create_dir(root, 0o700))) { str_free(?alloc, root); ret 1; }

    var bad: bool = false;

    val missing_r: R.Result[R.Void, str] = validate_contained_ancestors(?alloc, root, "never/created", "clean target");
    if (R.is_err[R.Void, str](missing_r)) { bad = true; }

    val out_dir: str = sfmt(?alloc, "{}/out", root);
    val out_x_dir: str = sfmt(?alloc, "{}/out/x", root);
    if (O.is_some[str](fs.create_dir(out_dir, 0o700)) || O.is_some[str](fs.create_dir(out_x_dir, 0o700))) { bad = true; }
    val one_level_r: R.Result[R.Void, str] = validate_contained_ancestors(?alloc, root, "out", "clean target");
    if (R.is_err[R.Void, str](one_level_r)) { bad = true; }
    val two_level_r: R.Result[R.Void, str] = validate_contained_ancestors(?alloc, root, "out/x", "clean target");
    if (R.is_err[R.Void, str](two_level_r)) { bad = true; }

    val outside: str = sfmt(?alloc, "{}/outside", root);
    val escape: str = sfmt(?alloc, "{}/escape", root);
    if (O.is_some[str](fs.create_dir(outside, 0o700)) || O.is_some[str](fs.symlink(outside, escape))) { bad = true; }
    or {
        val escape_r: R.Result[R.Void, str] = validate_contained_ancestors(?alloc, root, "escape/x", "clean target");
        if (R.is_ok[R.Void, str](escape_r) || !cfg_contains(R.unwrap_err[R.Void, str](escape_r), "non-directory ancestor")) { bad = true; }
    }

    val real_mid: str = sfmt(?alloc, "{}/real_mid", root);
    val jump_mid: str = sfmt(?alloc, "{}/out/jump_mid", root);
    if (O.is_some[str](fs.create_dir(real_mid, 0o700)) || O.is_some[str](fs.symlink(real_mid, jump_mid))) { bad = true; }
    or {
        val mid_r: R.Result[R.Void, str] = validate_contained_ancestors(?alloc, root, "out/jump_mid/y/z", "clean target");
        if (R.is_ok[R.Void, str](mid_r) || !cfg_contains(R.unwrap_err[R.Void, str](mid_r), "non-directory ancestor")) { bad = true; }
    }

    str_free(?alloc, jump_mid);
    str_free(?alloc, real_mid);
    str_free(?alloc, escape);
    str_free(?alloc, outside);
    str_free(?alloc, out_x_dir);
    str_free(?alloc, out_dir);
    fs.remove_all(?alloc, root);
    str_free(?alloc, root);
    if (bad) { ret 1; }
    ret 0;
}

fun ensure_physical_directory_path_windows(alloc: *A.Allocator, root: str, rel: str, label: str) R.Result[R.Void, str] {
    if (str_equals(rel, ".")) { ret validate_physical_path_windows(alloc, root, rel, PHYSICAL_DIRECTORY, label); }
    val n: usize = str_len(rel);
    var start: usize = 0;
    for (start < n) {
        var end: usize = start;
        for (end < n && rel[end] != '/'::u8) { end = end + 1; }
        val prefix_r: R.Result[str, str] = str_copy_slice(alloc, rel, 0, end);
        if (R.is_err[str, str](prefix_r)) { ret R.err[R.Void, str](R.unwrap_err[str, str](prefix_r)); }
        val prefix: str = R.unwrap_ok[str, str](prefix_r);
        val abs_r: R.Result[str, str] = spath.resolve(alloc, root, prefix);
        if (R.is_err[str, str](abs_r)) { str_free(alloc, prefix); ret R.err[R.Void, str](R.unwrap_err[str, str](abs_r)); }
        val abs: str = R.unwrap_ok[str, str](abs_r);
        var meta_r: R.Result[fs.Metadata, str] = fs.metadata_link(abs);
        if (R.is_err[fs.Metadata, str](meta_r)) {
            val make_r: O.Option[str] = fs.create_dir(abs, 0o755);
            if (O.is_some[str](make_r)) {
                val msg: str = sfmt(alloc, "{} '{}' cannot create directory '{}': {}", label, rel, prefix, O.unwrap[str](make_r));
                str_free(alloc, abs);
                str_free(alloc, prefix);
                ret R.err[R.Void, str](msg);
            }
            meta_r = fs.metadata_link(abs);
        }
        str_free(alloc, abs);
        if (R.is_err[fs.Metadata, str](meta_r)) {
            val msg: str = sfmt(alloc, "{} '{}' cannot inspect directory '{}': {}", label, rel, prefix, R.unwrap_err[fs.Metadata, str](meta_r));
            str_free(alloc, prefix);
            ret R.err[R.Void, str](msg);
        }
        val meta: fs.Metadata = R.unwrap_ok[fs.Metadata, str](meta_r);
        if (fs.meta_is_symlink(?meta) || !fs.meta_is_dir(?meta)) {
            val msg: str = sfmt(alloc, "{} '{}' cannot use non-directory or symlink component '{}'", label, rel, prefix);
            str_free(alloc, prefix);
            ret R.err[R.Void, str](msg);
        }
        str_free(alloc, prefix);
        start = end + 1;
    }
    ret R.ok_void[str]();
}

fun ensure_physical_directory_path(alloc: *A.Allocator, root: str, rel: str, label: str) R.Result[R.Void, str] {
    $if ($mach.build.os == $mach.os.windows) {
        ret ensure_physical_directory_path_windows(alloc, root, rel, label);
    }
    $or {
        val root_fd_raw: i64 = sysos.open(sysos.AT_FDCWD, root, sysos.O_RDONLY | sysos.O_DIRECTORY, 0);
        if (root_fd_raw < 0) { ret R.err[R.Void, str](sfmt(alloc, "{} root '{}' cannot be opened: {}", label, root, sysos.message(root_fd_raw))); }
        var fd: i32 = root_fd_raw::i32;
        if (str_equals(rel, ".")) {
            val close_r: i64 = sysos.close(fd);
            if (close_r < 0) { ret R.err[R.Void, str](sysos.message(close_r)); }
            ret R.ok_void[str]();
        }
        val n: usize = str_len(rel);
        var start: usize = 0;
        for (start < n) {
            var end: usize = start;
            for (end < n && rel[end] != '/'::u8) { end = end + 1; }
            if (end == start) { sysos.close(fd); ret R.err[R.Void, str](sfmt(alloc, "{} '{}' is not a canonical project path", label, rel)); }
            val component_r: R.Result[str, str] = str_copy_slice(alloc, rel, start, end - start);
            if (R.is_err[str, str](component_r)) { sysos.close(fd); ret R.err[R.Void, str](R.unwrap_err[str, str](component_r)); }
            val component: str = R.unwrap_ok[str, str](component_r);
            var st: sysos.stat_t;
            var stat_r: i64 = sysos.stat_path(fd, component, ?st, sysos.AT_SYMLINK_NOFOLLOW);
            if (stat_r == sysos.ENOENT) {
                val make_r: i64 = sysos.make_dir(fd, component, 0o755);
                if (make_r < 0 && make_r != sysos.EEXIST) {
                    val msg: str = sfmt(alloc, "{} '{}' cannot create directory '{}': {}", label, rel, component, sysos.message(make_r));
                    str_free(alloc, component);
                    sysos.close(fd);
                    ret R.err[R.Void, str](msg);
                }
                stat_r = sysos.stat_path(fd, component, ?st, sysos.AT_SYMLINK_NOFOLLOW);
            }
            if (stat_r < 0) {
                val msg: str = sfmt(alloc, "{} '{}' cannot inspect directory '{}': {}", label, rel, component, sysos.message(stat_r));
                str_free(alloc, component);
                sysos.close(fd);
                ret R.err[R.Void, str](msg);
            }
            val mode: u32 = sysos.stat_mode(?st);
            if ((mode & sysos.S_IFMT) == sysos.S_IFLNK || (mode & sysos.S_IFMT) != sysos.S_IFDIR) {
                val msg: str = sfmt(alloc, "{} '{}' cannot use non-directory or symlink component '{}'", label, rel, component);
                str_free(alloc, component);
                sysos.close(fd);
                ret R.err[R.Void, str](msg);
            }
            val next_fd_raw: i64 = sysos.open(fd, component, sysos.O_RDONLY | sysos.O_DIRECTORY, 0);
            str_free(alloc, component);
            if (next_fd_raw < 0) {
                val msg: str = sfmt(alloc, "{} '{}' cannot open a directory component: {}", label, rel, sysos.message(next_fd_raw));
                sysos.close(fd);
                ret R.err[R.Void, str](msg);
            }
            val next_fd: i32 = next_fd_raw::i32;
            var next_st: sysos.stat_t;
            val next_stat_r: i64 = sysos.stat(next_fd, ?next_st);
            if (next_stat_r < 0 || (sysos.stat_mode(?next_st) & sysos.S_IFMT) != sysos.S_IFDIR) {
                sysos.close(next_fd);
                sysos.close(fd);
                ret R.err[R.Void, str](sfmt(alloc, "{} '{}' opened an invalid directory component", label, rel));
            }
            val close_r: i64 = sysos.close(fd);
            if (close_r < 0) {
                sysos.close(next_fd);
                ret R.err[R.Void, str](sysos.message(close_r));
            }
            fd = next_fd;
            start = end + 1;
        }
        val close_r: i64 = sysos.close(fd);
        if (close_r < 0) { ret R.err[R.Void, str](sysos.message(close_r)); }
        ret R.ok_void[str]();
    }
}

fun glob_visit(alloc: *A.Allocator, root: str, base_rel: str, name: str, pat: str, recursive: bool, out: *vector.Vector[str]) R.Result[R.Void, str] {
    val child_rel_r: R.Result[str, str] = load.join_path(alloc, base_rel, name);
    if (R.is_err[str, str](child_rel_r)) { ret R.err[R.Void, str](R.unwrap_err[str, str](child_rel_r)); }
    val child_rel: str = R.unwrap_ok[str, str](child_rel_r);

    val child_abs_r: R.Result[str, str] = spath.resolve(alloc, root, child_rel);
    if (R.is_err[str, str](child_abs_r)) { str_free(alloc, child_rel); ret R.err[R.Void, str](R.unwrap_err[str, str](child_abs_r)); }
    val child_abs: str = R.unwrap_ok[str, str](child_abs_r);
    val fi_r: R.Result[fs.Metadata, str] = fs.metadata_link(child_abs);
    str_free(alloc, child_abs);
    if (R.is_err[fs.Metadata, str](fi_r)) {
        val msg: str = sfmt(alloc, "failed to inspect build step glob entry '{}': {}", child_rel, R.unwrap_err[fs.Metadata, str](fi_r));
        str_free(alloc, child_rel);
        ret R.err[R.Void, str](msg);
    }
    val fi: fs.Metadata = R.unwrap_ok[fs.Metadata, str](fi_r);

    if (fs.meta_is_symlink(?fi)) {
        val msg: str = sfmt(alloc, "build step input glob cannot traverse symlink '{}'", child_rel);
        str_free(alloc, child_rel);
        ret R.err[R.Void, str](msg);
    }

    if (fs.meta_is_dir(?fi) && recursive && name[0] == '.'::u8) {
        str_free(alloc, child_rel);
        ret R.ok_void[str]();
    }
    or (fs.meta_is_dir(?fi) && recursive) {
        val rr: R.Result[R.Void, str] = glob_walk(alloc, root, child_rel, pat, recursive, out);
        str_free(alloc, child_rel);
        ret rr;
    }
    or (fs.meta_is_file(?fi) && name[0] == '.'::u8 && !(str_len(pat) > 0 && pat[0] == '.'::u8)) {
        str_free(alloc, child_rel);
        ret R.ok_void[str]();
    }
    or (fs.meta_is_file(?fi) && wildcard_match(pat, name)) {
        val pr: R.Result[usize, str] = vector.push[str](out, child_rel);
        if (R.is_err[usize, str](pr)) { str_free(alloc, child_rel); ret R.err[R.Void, str](R.unwrap_err[usize, str](pr)); }
        ret R.ok_void[str]();
    }
    or (!fs.meta_is_dir(?fi) && !fs.meta_is_file(?fi)) {
        val msg: str = sfmt(alloc, "build step input glob cannot use special entry '{}'", child_rel);
        str_free(alloc, child_rel);
        ret R.err[R.Void, str](msg);
    }
    str_free(alloc, child_rel);
    ret R.ok_void[str]();
}

fun glob_dot_entry(name: *u8) bool {
    if (name[0] != '.'::u8) { ret false; }
    if (name[1] == 0) { ret true; }
    ret name[1] == '.'::u8 && name[2] == 0;
}

fun glob_walk(alloc: *A.Allocator, root: str, base_rel: str, pat: str, recursive: bool, out: *vector.Vector[str]) R.Result[R.Void, str] {
    val physical_r: R.Result[R.Void, str] = validate_physical_path(alloc, root, base_rel, PHYSICAL_DIRECTORY, "build step input glob directory");
    if (R.is_err[R.Void, str](physical_r)) { ret physical_r; }
    val dir_abs_r: R.Result[str, str] = spath.resolve(alloc, root, base_rel);
    if (R.is_err[str, str](dir_abs_r)) { ret R.err[R.Void, str](R.unwrap_err[str, str](dir_abs_r)); }
    val dir_abs: str = R.unwrap_ok[str, str](dir_abs_r);

    val fd_raw: i64 = sysos.open(sysos.AT_FDCWD, dir_abs, sysos.O_RDONLY | sysos.O_DIRECTORY, 0);
    if (fd_raw < 0) {
        val msg: str = sfmt(alloc, "failed to open build step glob directory '{}': {}", dir_abs, sysos.message(fd_raw));
        str_free(alloc, dir_abs);
        ret R.err[R.Void, str](msg);
    }
    str_free(alloc, dir_abs);
    val fd: i32 = fd_raw::i32;

    var dbuf: [8192]u8;
    var result: R.Result[R.Void, str] = R.ok_void[str]();
    var reading: bool = true;
    for (reading) {
        val nread: i64 = sysos.read_dir(fd, (?dbuf[0])::*sysos.dirent64, 8192);
        if (nread < 0)  { result = R.err[R.Void, str](sysos.message(nread)); reading = false; }
        or (nread == 0) { reading = false; }
        or {
            var pos: usize = 0;
            for (reading && pos < nread::usize) {
                val ent:    *sysos.dirent64 = ((?dbuf[0])::usize + pos)::*sysos.dirent64;
                val reclen: usize           = ent.d_reclen::usize;
                if (reclen == 0 || reclen > nread::usize - pos) {
                    result = R.err[R.Void, str]("invalid directory entry while expanding build step glob");
                    reading = false;
                }
                or {
                    val name: *u8 = ?ent.d_name[0];
                    if (!glob_dot_entry(name)) {
                        val rr: R.Result[R.Void, str] = glob_visit(alloc, root, base_rel, name::str, pat, recursive, out);
                        if (R.is_err[R.Void, str](rr)) { result = rr; reading = false; }
                    }
                    pos = pos + reclen;
                }
            }
        }
    }
    val close_r: i64 = sysos.close(fd);
    if (R.is_ok[R.Void, str](result) && close_r < 0) {
        result = R.err[R.Void, str](sysos.message(close_r));
    }
    ret result;
}

pub fun glob_shape_ok(pattern: str) bool {
    val n: usize = str_len(pattern);
    var final_start: usize = 0;
    var j: usize = 0;
    for (j < n) { if (pattern[j] == '/'::u8) { final_start = j + 1; } j = j + 1; }

    var dstar: u32 = 0;
    var i: usize = 0;
    for (i < final_start) {
        var seg_end: usize = i;
        for (seg_end < n && pattern[seg_end] != '/'::u8) { seg_end = seg_end + 1; }
        val slen: usize = seg_end - i;
        if (slen > 0) {
            if (slen == 2 && pattern[i] == '*'::u8 && pattern[i + 1] == '*'::u8) { dstar = dstar + 1; }
            or {
                var k: usize = i;
                for (k < seg_end) { if (pattern[k] == '*'::u8) { ret false; } k = k + 1; }
            }
        }
        i = seg_end + 1;
    }
    if (dstar > 1) { ret false; }

    var f: usize = final_start;
    var prev_star: bool = false;
    for (f < n) {
        if (pattern[f] == '*'::u8) {
            if (prev_star) { ret false; }
            prev_star = true;
        }
        or { prev_star = false; }
        f = f + 1;
    }
    ret true;
}

fun glob_expand_pattern(alloc: *A.Allocator, project_root: str, pattern: str, out: *vector.Vector[str]) R.Result[R.Void, str] {
    val n: usize = str_len(pattern);
    var star2: i64 = -1;
    var i: usize = 0;
    for (i + 1 < n && star2 < 0) {
        if (pattern[i] == '*'::u8 && pattern[i + 1] == '*'::u8) { star2 = i::i64; }
        i = i + 1;
    }

    if (star2 >= 0) {
        val sp: usize = star2::usize;
        var base_end: usize = sp;
        if (base_end > 0 && pattern[base_end - 1] == '/'::u8) { base_end = base_end - 1; }
        val base_r: R.Result[str, str] = str_copy_slice(alloc, pattern, 0, base_end);
        if (R.is_err[str, str](base_r)) { ret R.err[R.Void, str](R.unwrap_err[str, str](base_r)); }
        val base: str = R.unwrap_ok[str, str](base_r);
        var pat_start: usize = sp + 2;
        if (pat_start < n && pattern[pat_start] == '/'::u8) { pat_start = pat_start + 1; }
        val pat_r: R.Result[str, str] = str_copy_slice(alloc, pattern, pat_start, n - pat_start);
        if (R.is_err[str, str](pat_r)) { str_free(alloc, base); ret R.err[R.Void, str](R.unwrap_err[str, str](pat_r)); }
        val pat: str = R.unwrap_ok[str, str](pat_r);
        var base_use: str = base;
        if (str_empty(base)) { base_use = "."; }
        val gr: R.Result[R.Void, str] = glob_walk(alloc, project_root, base_use, pat, true, out);
        str_free(alloc, base);
        str_free(alloc, pat);
        ret gr;
    }

    var last: i64 = -1;
    i = 0;
    for (i < n) { if (pattern[i] == '/'::u8) { last = i::i64; } i = i + 1; }
    if (last < 0) { ret glob_walk(alloc, project_root, ".", pattern, false, out); }
    val dir_r: R.Result[str, str] = str_copy_slice(alloc, pattern, 0, last::usize);
    if (R.is_err[str, str](dir_r)) { ret R.err[R.Void, str](R.unwrap_err[str, str](dir_r)); }
    val dir: str = R.unwrap_ok[str, str](dir_r);
    val pat_r: R.Result[str, str] = str_copy_slice(alloc, pattern, (last::usize) + 1, n - ((last::usize) + 1));
    if (R.is_err[str, str](pat_r)) { str_free(alloc, dir); ret R.err[R.Void, str](R.unwrap_err[str, str](pat_r)); }
    val pat: str = R.unwrap_ok[str, str](pat_r);
    val gr: R.Result[R.Void, str] = glob_walk(alloc, project_root, dir, pat, false, out);
    str_free(alloc, dir);
    str_free(alloc, pat);
    ret gr;
}

fun collect_step_inputs(alloc: *A.Allocator, p: *project.Project, step: *manifest.StepDef, execution_root: str, output_root: str, out: *vector.Vector[str]) R.Result[R.Void, str] {
    var v: manifest.TmplVars = ddep.cell_tmpl_vars(p);
    var i: u32 = 0;
    for (i < step.in_count) {
        val raw: str = O.unwrap[str](intern.lookup(?p.s.interner, step.in[i]));
        val sp_r: R.Result[StepPath, str] = resolve_step_path(alloc, raw, output_root, ?v, execution_root, output_root, "a build step input", true);
        if (R.is_err[StepPath, str](sp_r)) { ret R.err[R.Void, str](R.unwrap_err[StepPath, str](sp_r)); }
        var sp: StepPath = R.unwrap_ok[StepPath, str](sp_r);
        if (!str_contains_char(sp.rel, '*')) {
            val physical_r: R.Result[R.Void, str] = validate_physical_path(alloc, sp.root, sp.rel, PHYSICAL_REGULAR, "build step input");
            if (R.is_err[R.Void, str](physical_r)) { step_path_free(alloc, ?sp); ret physical_r; }
            str_free(alloc, sp.rel);
            val pr: R.Result[usize, str] = vector.push[str](out, sp.abs);
            if (R.is_err[usize, str](pr)) { str_free(alloc, sp.abs); ret R.err[R.Void, str](R.unwrap_err[usize, str](pr)); }
        }
        or {
            if (!glob_shape_ok(sp.rel)) {
                val msg: str = sfmt(alloc, "mach.toml: step input glob '{}' has an unsupported shape; wildcards are allowed only in the final path segment, with an optional '**' directory segment (e.g. 'dir/*.c' or 'dir/**/*.c')", sp.rel);
                step_path_free(alloc, ?sp);
                ret R.err[R.Void, str](msg);
            }
            val before: usize = out.len;
            val gr: R.Result[R.Void, str] = glob_expand_pattern(alloc, sp.root, sp.rel, out);
            if (R.is_err[R.Void, str](gr)) { step_path_free(alloc, ?sp); ret gr; }
            if (out.len == before) {
                val msg: str = sfmt(alloc, "mach.toml: step input glob '{}' matched no files", sp.rel);
                step_path_free(alloc, ?sp);
                ret R.err[R.Void, str](msg);
            }
            var gi: usize = before;
            for (gi < out.len) {
                val abs_r: R.Result[str, str] = spath.resolve(alloc, sp.root, out.data[gi]);
                if (R.is_err[str, str](abs_r)) { step_path_free(alloc, ?sp); ret R.err[R.Void, str](R.unwrap_err[str, str](abs_r)); }
                str_free(alloc, out.data[gi]);
                out.data[gi] = R.unwrap_ok[str, str](abs_r);
                gi = gi + 1;
            }
            step_path_free(alloc, ?sp);
        }
        i = i + 1;
    }
    sort.sort[str](out.data, out.len, cmp_str);
    ret R.ok_void[str]();
}

fun step_free_inputs(alloc: *A.Allocator, ins: *vector.Vector[str]) {
    var i: usize = 0;
    for (i < ins.len) { str_free(alloc, ins.data[i]); i = i + 1; }
    vector.dnit[str](ins);
}

rec StepStrings {
    items: **u8;
    count: u32;
}

rec StepInvocation {
    argv: StepStrings;
    env:  StepStrings;
}

rec StepPath {
    root: str;
    rel:  str;
    abs:  str;
}

fun step_path_free(a: *A.Allocator, path: *StepPath) {
    str_free(a, path.rel);
    str_free(a, path.abs);
    # nil, not "": str_free no-ops on nil and would hand a static empty literal
    # to the allocator, so an empty reset makes a second free an invalid free
    path.rel = nil;
    path.abs = nil;
}

fun step_paths_free(a: *A.Allocator, paths: *Vector[StepPath]) {
    var i: usize = 0;
    for (i < paths.len) {
        step_path_free(a, ?paths.data[i]);
        i = i + 1;
    }
    vector.dnit[StepPath](paths);
}

fun absolute_path_in_root(path: str, root: str, allow_root: bool) bool {
    if (!spath.is_abs(path) || !spath.is_abs(root)) { ret false; }
    if (str_equals(path, root)) { ret allow_root; }
    val rn: usize = str_len(root);
    if (!str_starts_with(path, root) || str_len(path) <= rn) { ret false; }
    ret spath.is_separator(path[rn]);
}

fun step_path_error(a: *A.Allocator, field: str) str {
    ret sfmt(a, "mach.toml: {} must expand to a canonical path under the step execution root, or start with '{{project.out}}/' and remain under the designated output root", field);
}

fun resolve_step_path(a: *A.Allocator, raw: str, project_out: str, v: *manifest.TmplVars,
                      execution_root: str, output_root: str, field: str,
                      allow_output_root: bool) R.Result[StepPath, str] {
    var empty: StepPath = StepPath{root: "", rel: "", abs: ""};
    val expanded_r: R.Result[str, str] = manifest.expand(a, raw, project_out, v);
    if (R.is_err[str, str](expanded_r)) { ret R.err[StepPath, str](R.unwrap_err[str, str](expanded_r)); }
    val expanded: str = R.unwrap_ok[str, str](expanded_r);
    val marker: str = "{project.out}";
    val absolute_output: bool = spath.is_abs(project_out) && str_contains(raw, marker);
    if (!absolute_output && manifest.is_project_path(expanded)) {
        val abs_r: R.Result[str, str] = spath.resolve(a, execution_root, expanded);
        if (R.is_err[str, str](abs_r)) {
            str_free(a, expanded);
            ret R.err[StepPath, str](R.unwrap_err[str, str](abs_r));
        }
        ret R.ok[StepPath, str](StepPath{root: execution_root, rel: expanded, abs: R.unwrap_ok[str, str](abs_r)});
    }

    val mn: usize = str_len(marker);
    val rn: usize = str_len(raw);
    if (!spath.is_abs(expanded) || !str_starts_with(raw, marker)
        || (rn != mn && (rn <= mn || raw[mn] != '/'::u8))) {
        str_free(a, expanded);
        ret R.err[StepPath, str](step_path_error(a, field));
    }

    var rel: str = "";
    if (rn == mn) {
        if (!allow_output_root) {
            str_free(a, expanded);
            ret R.err[StepPath, str](step_path_error(a, field));
        }
        val rel_r: R.Result[str, str] = str_dup(a, ".");
        if (R.is_err[str, str](rel_r)) {
            str_free(a, expanded);
            ret R.err[StepPath, str](R.unwrap_err[str, str](rel_r));
        }
        rel = R.unwrap_ok[str, str](rel_r);
    }
    or {
        val suffix: str = ?raw[mn + 1];
        val rel_r: R.Result[str, str] = manifest.expand_project_path(a, suffix, "", v, field);
        if (R.is_err[str, str](rel_r)) {
            str_free(a, expanded);
            ret R.err[StepPath, str](R.unwrap_err[str, str](rel_r));
        }
        rel = R.unwrap_ok[str, str](rel_r);
    }

    val joined_r: R.Result[str, str] = spath.resolve(a, output_root, rel);
    if (R.is_err[str, str](joined_r)) {
        str_free(a, rel);
        str_free(a, expanded);
        ret R.err[StepPath, str](R.unwrap_err[str, str](joined_r));
    }
    val joined: str = R.unwrap_ok[str, str](joined_r);
    val clean_r: R.Result[str, str] = spath.clean(a, joined);
    str_free(a, joined);
    str_free(a, expanded);
    if (R.is_err[str, str](clean_r)) {
        str_free(a, rel);
        ret R.err[StepPath, str](R.unwrap_err[str, str](clean_r));
    }
    val clean: str = R.unwrap_ok[str, str](clean_r);
    val clean_root_r: R.Result[str, str] = spath.clean(a, output_root);
    if (R.is_err[str, str](clean_root_r)) {
        str_free(a, rel);
        str_free(a, clean);
        ret R.err[StepPath, str](R.unwrap_err[str, str](clean_root_r));
    }
    val clean_root: str = R.unwrap_ok[str, str](clean_root_r);
    fin { str_free(a, clean_root); }
    if (!absolute_path_in_root(clean, clean_root, allow_output_root)) {
        str_free(a, rel);
        str_free(a, clean);
        ret R.err[StepPath, str](step_path_error(a, field));
    }
    empty = StepPath{root: output_root, rel: rel, abs: clean};
    ret R.ok[StepPath, str](empty);
}

fun step_strings_free(a: *A.Allocator, values: *StepStrings) {
    if (values.items == nil) { ret; }
    var i: u32 = 0;
    for (i < values.count) { str_free(a, values.items[i]::str); i = i + 1; }
    A.deallocate[*u8](a, values.items, values.count::usize + 1);
    values.items = nil;
    values.count = 0;
}

fun expand_step_strings(a: *A.Allocator, p: *project.Project, ids: *intern.StrId,
                        count: u32, project_out: str, v: *manifest.TmplVars) R.Result[StepStrings, str] {
    var out: StepStrings;
    out.items = nil;
    out.count = 0;
    if (count == 0) { ret R.ok[StepStrings, str](out); }

    val ar: R.Result[**u8, str] = A.allocate[*u8](a, count::usize + 1);
    if (R.is_err[**u8, str](ar)) { ret R.err[StepStrings, str](R.unwrap_err[**u8, str](ar)); }
    out.items = R.unwrap_ok[**u8, str](ar);
    var i: u32 = 0;
    for (i < count) {
        val raw_opt: O.Option[str] = intern.lookup(?p.s.interner, ids[i]);
        if (O.is_none[str](raw_opt)) {
            out.count = i;
            step_strings_free(a, ?out);
            ret R.err[StepStrings, str]("internal: build step field not interned");
        }
        val er: R.Result[str, str] = manifest.expand_step_value(a, O.unwrap[str](raw_opt), project_out, v);
        if (R.is_err[str, str](er)) {
            out.count = i;
            step_strings_free(a, ?out);
            ret R.err[StepStrings, str](R.unwrap_err[str, str](er));
        }
        out.items[i] = R.unwrap_ok[str, str](er)::*u8;
        i = i + 1;
    }
    out.items[count] = nil;
    out.count = count;
    ret R.ok[StepStrings, str](out);
}

fun expand_step_invocation(a: *A.Allocator, p: *project.Project, step: *manifest.StepDef,
                           project_out: str, v: *manifest.TmplVars) R.Result[StepInvocation, str] {
    var invocation: StepInvocation;
    invocation.argv = StepStrings{items: nil, count: 0};
    invocation.env = StepStrings{items: nil, count: 0};

    val argv_r: R.Result[StepStrings, str] = expand_step_strings(a, p, step.argv, step.argv_count, project_out, v);
    if (R.is_err[StepStrings, str](argv_r)) { ret R.err[StepInvocation, str](R.unwrap_err[StepStrings, str](argv_r)); }
    invocation.argv = R.unwrap_ok[StepStrings, str](argv_r);
    if (invocation.argv.count == 0 || str_empty(invocation.argv.items[0]::str)) {
        step_strings_free(a, ?invocation.argv);
        ret R.err[StepInvocation, str]("mach.toml: expanded build step argv[0] must name an executable");
    }

    val env_r: R.Result[**u8, str] = A.allocate[*u8](a, step.env_count::usize + TARGET_ENV_N + 1);
    if (R.is_err[**u8, str](env_r)) {
        step_strings_free(a, ?invocation.argv);
        ret R.err[StepInvocation, str](R.unwrap_err[**u8, str](env_r));
    }
    invocation.env.items = R.unwrap_ok[**u8, str](env_r);

    var out: u32 = 0;
    var ti: usize = 0;
    for (ti < TARGET_ENV_N) {
        val entry_r: R.Result[str, str] = format.sprint(a, "{}={}", TARGET_ENV_KEYS[ti], target_env_value(v, ti));
        if (R.is_err[str, str](entry_r)) {
            invocation.env.count = out;
            step_strings_free(a, ?invocation.env);
            step_strings_free(a, ?invocation.argv);
            ret R.err[StepInvocation, str](R.unwrap_err[str, str](entry_r));
        }
        invocation.env.items[out] = R.unwrap_ok[str, str](entry_r)::*u8;
        out = out + 1;
        ti = ti + 1;
    }

    var i: u32 = 0;
    for (i < step.env_count) {
        val key_opt: O.Option[str] = intern.lookup(?p.s.interner, step.env_keys[i]);
        val value_opt: O.Option[str] = intern.lookup(?p.s.interner, step.env_values[i]);
        if (O.is_none[str](key_opt) || O.is_none[str](value_opt)) {
            invocation.env.count = out;
            step_strings_free(a, ?invocation.env);
            step_strings_free(a, ?invocation.argv);
            ret R.err[StepInvocation, str]("internal: build step environment not interned");
        }
        val key: str = O.unwrap[str](key_opt);
        if (is_target_env_key(key)) { i = i + 1; cnt; }

        val value_r: R.Result[str, str] = manifest.expand_step_value(a, O.unwrap[str](value_opt), project_out, v);
        if (R.is_err[str, str](value_r)) {
            invocation.env.count = out;
            step_strings_free(a, ?invocation.env);
            step_strings_free(a, ?invocation.argv);
            ret R.err[StepInvocation, str](R.unwrap_err[str, str](value_r));
        }
        val value: str = R.unwrap_ok[str, str](value_r);
        val entry_r: R.Result[str, str] = format.sprint(a, "{}={}", key, value);
        str_free(a, value);
        if (R.is_err[str, str](entry_r)) {
            invocation.env.count = out;
            step_strings_free(a, ?invocation.env);
            step_strings_free(a, ?invocation.argv);
            ret R.err[StepInvocation, str](R.unwrap_err[str, str](entry_r));
        }
        invocation.env.items[out] = R.unwrap_ok[str, str](entry_r)::*u8;
        out = out + 1;
        i = i + 1;
    }
    invocation.env.items[out] = nil;
    invocation.env.count = out;
    ret R.ok[StepInvocation, str](invocation);
}

val TARGET_ENV_N: usize = 3;
val TARGET_ENV_KEYS: [TARGET_ENV_N]str = [TARGET_ENV_N]str{
    "MACH_TARGET_ISA",
    "MACH_TARGET_OS",
    "MACH_TARGET_ABI",
};

fun target_env_value(v: *manifest.TmplVars, idx: usize) str {
    if (idx == 0) { ret v.isa; }
    if (idx == 1) { ret v.os; }
    ret v.abi;
}

fun is_target_env_key(key: str) bool {
    var i: usize = 0;
    for (i < TARGET_ENV_N) {
        if (str_equals(key, TARGET_ENV_KEYS[i])) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun step_invocation_free(a: *A.Allocator, invocation: *StepInvocation) {
    step_strings_free(a, ?invocation.argv);
    step_strings_free(a, ?invocation.env);
}

fun collect_step_outputs(a: *A.Allocator, p: *project.Project, step: *manifest.StepDef, execution_root: str, output_root: str, outputs: *Vector[StepPath]) R.Result[R.Void, str] {
    var v: manifest.TmplVars = ddep.cell_tmpl_vars(p);
    var oi: u32 = 0;
    for (oi < step.out_count) {
        val raw_opt: O.Option[str] = intern.lookup(?p.s.interner, step.out[oi]);
        if (O.is_none[str](raw_opt)) { ret R.err[R.Void, str]("internal: build step output not interned"); }
        val sp_r: R.Result[StepPath, str] = resolve_step_path(a, O.unwrap[str](raw_opt), output_root, ?v, execution_root, output_root, "a build step output", false);
        if (R.is_err[StepPath, str](sp_r)) { ret R.err[R.Void, str](R.unwrap_err[StepPath, str](sp_r)); }
        val sp: StepPath = R.unwrap_ok[StepPath, str](sp_r);
        val push_r: R.Result[usize, str] = vector.push[StepPath](outputs, sp);
        if (R.is_err[usize, str](push_r)) {
            var lost: StepPath = sp;
            step_path_free(a, ?lost);
            ret R.err[R.Void, str](R.unwrap_err[usize, str](push_r));
        }
        oi = oi + 1;
    }
    ret R.ok_void[str]();
}

fun step_make_output_dirs(a: *A.Allocator, outputs: *Vector[StepPath]) R.Result[R.Void, str] {
    var oi: usize = 0;
    for (oi < outputs.len) {
        val sp: *StepPath = ?outputs.data[oi];
        val dir_r: R.Result[str, str] = spath.parent(a, sp.rel);
        if (R.is_err[str, str](dir_r)) { ret R.err[R.Void, str](R.unwrap_err[str, str](dir_r)); }
        val rel_dir: str = R.unwrap_ok[str, str](dir_r);
        val make_r: R.Result[R.Void, str] = ensure_physical_directory_path(a, sp.root, rel_dir, "build step output directory");
        str_free(a, rel_dir);
        if (R.is_err[R.Void, str](make_r)) { ret make_r; }
        oi = oi + 1;
    }
    ret R.ok_void[str]();
}

fun resolve_step_program(a: *A.Allocator, execution_root: str, invocation: *StepInvocation) R.Result[str, str] {
    val name: str = invocation.argv.items[0]::str;
    if (spath.has_separator(name)) { ret spath.resolve(a, execution_root, name); }
    val rr: R.Result[str, str] = exec.resolve(a, name);
    if (R.is_err[str, str](rr)) {
        ret R.err[str, str](sfmt(a, "mach.toml: build step executable '{}' was not found on the planner PATH", name));
    }
    val found: str = R.unwrap_ok[str, str](rr);
    if (spath.is_abs(found)) { ret R.ok[str, str](found); }
    val cwd_r: R.Result[str, str] = env.current_dir(a);
    if (R.is_err[str, str](cwd_r)) {
        str_free(a, found);
        ret R.err[str, str](R.unwrap_err[str, str](cwd_r));
    }
    val cwd: str = R.unwrap_ok[str, str](cwd_r);
    val abs_r: R.Result[str, str] = spath.resolve(a, cwd, found);
    str_free(a, cwd);
    str_free(a, found);
    ret abs_r;
}

fun execute_step_invocation(a: *A.Allocator, execution_root: str, program: str,
                            invocation: *StepInvocation, step_name: str,
                            timeout_seconds: i64) R.Result[R.Void, str] {
    var child: subprocess.OwnedSubprocess;
    subprocess.init(?child);
    val spawn_r: R.Result[R.Void, str] = subprocess.spawn_in_grouped(a, ?child, program, invocation.argv.items,
        invocation.env.items, execution_root);
    if (R.is_err[R.Void, str](spawn_r)) {
        val msg: str = sfmt(a, "failed to spawn build step executable '{}': {}", program, R.unwrap_err[R.Void, str](spawn_r));
        subprocess.dnit(a, ?child);
        ret R.err[R.Void, str](msg);
    }
    if (timeout_seconds > 0) { subprocess.bound_seconds(?child, timeout_seconds); }

    var scope: cnc.Scope;
    cnc.make_root(?scope, false, tm.Time{sec: 0, nsec: 0});
    var source: events.Source;
    var has_source: bool = events.make(?source) == 0;
    var interrupt_source: *events.Source = nil;
    if (has_source) { interrupt_source = ?source; }

    val wait_r: R.Result[*subprocess.OwnedSubprocess, str] = subprocess.wait_any(a, ?child, 1, ?scope, interrupt_source);
    if (has_source) { events.close(?source); }
    cnc.destroy(?scope);
    if (R.is_err[*subprocess.OwnedSubprocess, str](wait_r)) {
        val wait_err: str = R.unwrap_err[*subprocess.OwnedSubprocess, str](wait_r);
        val cancel_r: R.Result[subprocess.SubprocessTerminal, str] = subprocess.cancel(a, ?child, 0);
        if (R.is_err[subprocess.SubprocessTerminal, str](cancel_r)) {
            val msg: str = sfmt(a, "failed to wait for build step executable '{}': {}; cancellation also failed: {}", program, wait_err, R.unwrap_err[subprocess.SubprocessTerminal, str](cancel_r));
            subprocess.dnit(a, ?child);
            ret R.err[R.Void, str](msg);
        }
        val msg: str = sfmt(a, "failed to wait for build step executable '{}': {}; child was canceled and reaped", program, wait_err);
        subprocess.dnit(a, ?child);
        ret R.err[R.Void, str](msg);
    }
    if (subprocess.expired(?child)) {
        val msg: str = sfmt(a, "build step '{}' exceeded its timeout_seconds of {} and its process group was terminated", step_name, timeout_seconds);
        subprocess.dnit(a, ?child);
        ret R.err[R.Void, str](msg);
    }
    val terminal: subprocess.SubprocessTerminal = child.terminal;
    if (terminal.kind == subprocess.STATE_EXITED) {
        if (terminal.code == 0) { subprocess.dnit(a, ?child); ret R.ok_void[str](); }
        val msg: str = sfmt(a, "build step exited with code {}", terminal.code);
        subprocess.dnit(a, ?child);
        ret R.err[R.Void, str](msg);
    }
    if (terminal.kind == subprocess.STATE_SIGNALED) {
        val msg: str = sfmt(a, "build step terminated by signal {}", terminal.code);
        subprocess.dnit(a, ?child);
        ret R.err[R.Void, str](msg);
    }
    subprocess.dnit(a, ?child);
    ret R.err[R.Void, str]("build step reached an invalid terminal state");
}

rec TreeFile {
    path: str;
    kind: u8;
    sec:  i64;
    nsec: i64;
    size: usize;
    digest: [32]u8;
}

val TREE_FILE: u8 = 1;
val TREE_DIRECTORY: u8 = 2;

fun collect_tree_files(a: *A.Allocator, dir: str, out: *vector.Vector[TreeFile]) R.Result[R.Void, str] {
    if (fs.is_symlink(dir)) { ret R.err[R.Void, str](sfmt(a, "cannot snapshot symlink tree root '{}'", dir)); }
    if (!fs.exists(dir)) { ret R.ok_void[str](); }
    val root_meta_r: R.Result[fs.Metadata, str] = fs.metadata_link(dir);
    if (R.is_err[fs.Metadata, str](root_meta_r)) { ret R.err[R.Void, str](R.unwrap_err[fs.Metadata, str](root_meta_r)); }
    val root_meta: fs.Metadata = R.unwrap_ok[fs.Metadata, str](root_meta_r);
    if (!fs.meta_is_dir(?root_meta)) { ret R.err[R.Void, str](sfmt(a, "cannot snapshot non-directory tree root '{}'", dir)); }
    val root_path_r: R.Result[str, str] = spath.clean(a, dir);
    if (R.is_err[str, str](root_path_r)) { ret R.err[R.Void, str](R.unwrap_err[str, str](root_path_r)); }
    var root_entry: TreeFile;
    root_entry.path = R.unwrap_ok[str, str](root_path_r);
    root_entry.kind = TREE_DIRECTORY;
    root_entry.sec = 0;
    root_entry.nsec = 0;
    root_entry.size = 0;
    var root_digest_i: usize = 0;
    for (root_digest_i < 32) { root_entry.digest[root_digest_i] = 0; root_digest_i = root_digest_i + 1; }
    val root_push_r: R.Result[usize, str] = vector.push[TreeFile](out, root_entry);
    if (R.is_err[usize, str](root_push_r)) { str_free(a, root_entry.path); ret R.err[R.Void, str](R.unwrap_err[usize, str](root_push_r)); }
    val names_r: R.Result[Vector[str], str] = fs.read_dir(a, root_entry.path);
    if (R.is_err[Vector[str], str](names_r)) { ret R.err[R.Void, str](R.unwrap_err[Vector[str], str](names_r)); }
    var names: Vector[str] = R.unwrap_ok[Vector[str], str](names_r);
    sort.sort[str](names.data, names.len, cmp_str);

    var i: usize = 0;
    for (i < names.len) {
        val child_r: R.Result[str, str] = load.join_path(a, root_entry.path, names.data[i]);
        if (R.is_err[str, str](child_r)) {
            free_str_vector(a, ?names);
            ret R.err[R.Void, str](R.unwrap_err[str, str](child_r));
        }
        val child: str = R.unwrap_ok[str, str](child_r);
        val fi_r: R.Result[fs.Metadata, str] = fs.metadata_link(child);
        if (R.is_err[fs.Metadata, str](fi_r)) {
            str_free(a, child);
            free_str_vector(a, ?names);
            ret R.err[R.Void, str](R.unwrap_err[fs.Metadata, str](fi_r));
        }
        val fi: fs.Metadata = R.unwrap_ok[fs.Metadata, str](fi_r);
        if (fs.meta_is_dir(?fi)) {
            val child_walk_r: R.Result[R.Void, str] = collect_tree_files(a, child, out);
            str_free(a, child);
            if (R.is_err[R.Void, str](child_walk_r)) {
                free_str_vector(a, ?names);
                ret child_walk_r;
            }
        }
        or (fs.meta_is_file(?fi)) {
            var tf: TreeFile;
            tf.path = child;
            tf.kind = TREE_FILE;
            tf.sec  = fi.modified.sec;
            tf.nsec = fi.modified.nsec;
            tf.size = fi.size;
            val digest_r: R.Result[R.Void, str] = fingerprint.file_sha256(child, ?tf.digest[0]);
            if (R.is_err[R.Void, str](digest_r)) {
                str_free(a, child);
                free_str_vector(a, ?names);
                ret digest_r;
            }
            val pr: R.Result[usize, str] = vector.push[TreeFile](out, tf);
            if (R.is_err[usize, str](pr)) {
                str_free(a, child);
                free_str_vector(a, ?names);
                ret R.err[R.Void, str](R.unwrap_err[usize, str](pr));
            }
        }
        or {
            val msg: str = sfmt(a, "cannot snapshot unsupported entry '{}'", child);
            str_free(a, child);
            free_str_vector(a, ?names);
            ret R.err[R.Void, str](msg);
        }
        i = i + 1;
    }
    free_str_vector(a, ?names);
    ret R.ok_void[str]();
}

fun free_str_vector(a: *A.Allocator, v: *Vector[str]) {
    var i: usize = 0;
    for (i < v.len) { str_free(a, v.data[i]); i = i + 1; }
    vector.dnit[str](v);
}

fun free_tree_files(a: *A.Allocator, v: *Vector[TreeFile]) {
    var i: usize = 0;
    for (i < v.len) { str_free(a, v.data[i].path); i = i + 1; }
    vector.dnit[TreeFile](v);
}

fun snapshot_holds(snap: *Vector[TreeFile], f: *TreeFile) bool {
    var i: usize = 0;
    for (i < snap.len) {
        val s: *TreeFile = ?snap.data[i];
        if (str_equals(s.path, f.path)) {
            if (s.kind != f.kind) { ret false; }
            if (s.kind == TREE_DIRECTORY) { ret true; }
            if (s.sec != f.sec || s.nsec != f.nsec || s.size != f.size) { ret false; }
            var j: usize = 0;
            for (j < 32) {
                if (s.digest[j] != f.digest[j]) { ret false; }
                j = j + 1;
            }
            ret true;
        }
        i = i + 1;
    }
    ret false;
}

fun check_step_left_obj_tree(a: *A.Allocator, before: *Vector[TreeFile], tree: str, name: str) R.Result[R.Void, str] {
    var after: Vector[TreeFile] = vector.init[TreeFile](a);
    val collect_r: R.Result[R.Void, str] = collect_tree_files(a, tree, ?after);
    if (R.is_err[R.Void, str](collect_r)) {
        free_tree_files(a, ?after);
        ret R.err[R.Void, str](sfmt(a, "build step '{}' left the compiler-owned module object tree unverifiable: {}", name, R.unwrap_err[R.Void, str](collect_r)));
    }

    var verdict: R.Result[R.Void, str] = R.ok_void[str]();
    var i: usize = 0;
    for (i < after.len) {
        if (!snapshot_holds(before, ?after.data[i])) {
            verdict = R.err[R.Void, str](step_out_reserved_error(a, "build step", name, after.data[i].path, tree, "the module object tree"));
            i = after.len;
        }
        or { i = i + 1; }
    }
    i = 0;
    for (R.is_ok[R.Void, str](verdict) && i < before.len) {
        if (!snapshot_holds(?after, ?before.data[i])) {
            verdict = R.err[R.Void, str](sfmt(a, "build step '{}' removed '{}' from '{}/', the compiler-owned module object tree", name, before.data[i].path, tree));
            i = before.len;
        }
        or { i = i + 1; }
    }
    free_tree_files(a, ?after);
    ret verdict;
}

fun step_paths_absolute(a: *A.Allocator, paths: *Vector[StepPath], out: *Vector[str]) R.Result[R.Void, str] {
    var i: usize = 0;
    for (i < paths.len) {
        val dup_r: R.Result[str, str] = str_dup(a, paths.data[i].abs);
        if (R.is_err[str, str](dup_r)) { ret R.err[R.Void, str](R.unwrap_err[str, str](dup_r)); }
        val dup: str = R.unwrap_ok[str, str](dup_r);
        val push_r: R.Result[usize, str] = vector.push[str](out, dup);
        if (R.is_err[usize, str](push_r)) { str_free(a, dup); ret R.err[R.Void, str](R.unwrap_err[usize, str](push_r)); }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

fun step_paths_rel_for_root(a: *A.Allocator, paths: *Vector[StepPath], root: str, out: *Vector[str]) R.Result[R.Void, str] {
    var i: usize = 0;
    for (i < paths.len) {
        val sp: *StepPath = ?paths.data[i];
        if (str_equals(sp.root, root)) {
            val dup_r: R.Result[str, str] = str_dup(a, sp.rel);
            if (R.is_err[str, str](dup_r)) { ret R.err[R.Void, str](R.unwrap_err[str, str](dup_r)); }
            val dup: str = R.unwrap_ok[str, str](dup_r);
            val push_r: R.Result[usize, str] = vector.push[str](out, dup);
            if (R.is_err[usize, str](push_r)) { str_free(a, dup); ret R.err[R.Void, str](R.unwrap_err[usize, str](push_r)); }
        }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

fun output_path_declared(path: str, declared: *Vector[str]) bool {
    var i: usize = 0;
    for (i < declared.len) {
        if (path_in_module_obj_tree(path, declared.data[i])) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun validate_declared_step_outputs(a: *A.Allocator, root: str, outputs: *Vector[str], name: str) R.Result[R.Void, str] {
    var i: usize = 0;
    for (i < outputs.len) {
        val physical_r: R.Result[R.Void, str] = validate_physical_path(a, root, outputs.data[i], PHYSICAL_ENTRY, "declared build step output");
        if (R.is_err[R.Void, str](physical_r)) {
            ret R.err[R.Void, str](sfmt(a, "build step '{}' did not publish valid declared output '{}': {}", name, outputs.data[i], R.unwrap_err[R.Void, str](physical_r)));
        }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

fun check_step_output_effects(a: *A.Allocator, before: *Vector[TreeFile], tree: str, declared: *Vector[str], name: str) R.Result[R.Void, str] {
    var after: Vector[TreeFile] = vector.init[TreeFile](a);
    val collect_r: R.Result[R.Void, str] = collect_tree_files(a, tree, ?after);
    if (R.is_err[R.Void, str](collect_r)) {
        free_tree_files(a, ?after);
        ret R.err[R.Void, str](sfmt(a, "build step '{}' left the project output tree unverifiable: {}", name, R.unwrap_err[R.Void, str](collect_r)));
    }
    var i: usize = 0;
    for (i < after.len) {
        if (!snapshot_holds(before, ?after.data[i]) && !output_path_declared(after.data[i].path, declared)) {
            val msg: str = sfmt(a, "build step '{}' created or modified undeclared output '{}' under '{}'; declare it in the step output list", name, after.data[i].path, tree);
            free_tree_files(a, ?after);
            ret R.err[R.Void, str](msg);
        }
        i = i + 1;
    }
    i = 0;
    for (i < before.len) {
        if (!snapshot_holds(?after, ?before.data[i]) && !output_path_declared(before.data[i].path, declared)) {
            val msg: str = sfmt(a, "build step '{}' removed undeclared output '{}' under '{}'; declare it in the step output list", name, before.data[i].path, tree);
            free_tree_files(a, ?after);
            ret R.err[R.Void, str](msg);
        }
        i = i + 1;
    }
    free_tree_files(a, ?after);
    ret R.ok_void[str]();
}

fun combine_step_terminal_results(a: *A.Allocator, object_integrity: R.Result[R.Void, str], output_integrity: R.Result[R.Void, str], execution: R.Result[R.Void, str]) R.Result[R.Void, str] {
    if (R.is_err[R.Void, str](object_integrity)) {
        if (R.is_err[R.Void, str](output_integrity) && R.is_err[R.Void, str](execution)) {
            ret R.err[R.Void, str](sfmt(a, "{}; project output integrity: {}; execution outcome: {}", R.unwrap_err[R.Void, str](object_integrity), R.unwrap_err[R.Void, str](output_integrity), R.unwrap_err[R.Void, str](execution)));
        }
        if (R.is_err[R.Void, str](output_integrity)) {
            ret R.err[R.Void, str](sfmt(a, "{}; project output integrity: {}", R.unwrap_err[R.Void, str](object_integrity), R.unwrap_err[R.Void, str](output_integrity)));
        }
        if (R.is_err[R.Void, str](execution)) {
            ret R.err[R.Void, str](sfmt(a, "{}; execution outcome: {}", R.unwrap_err[R.Void, str](object_integrity), R.unwrap_err[R.Void, str](execution)));
        }
        ret object_integrity;
    }
    if (R.is_err[R.Void, str](output_integrity)) {
        if (R.is_err[R.Void, str](execution)) {
            ret R.err[R.Void, str](sfmt(a, "{}; execution outcome: {}", R.unwrap_err[R.Void, str](output_integrity), R.unwrap_err[R.Void, str](execution)));
        }
        ret output_integrity;
    }
    ret execution;
}

fun absolute_execution_root(a: *A.Allocator, root: str) R.Result[str, str] {
    if (spath.is_abs(root)) { ret str_dup(a, root); }
    val cwd_r: R.Result[str, str] = env.current_dir(a);
    if (R.is_err[str, str](cwd_r)) { ret cwd_r; }
    val cwd: str = R.unwrap_ok[str, str](cwd_r);
    val joined_r: R.Result[str, str] = spath.resolve(a, cwd, root);
    str_free(a, cwd);
    if (R.is_err[str, str](joined_r)) { ret joined_r; }
    val joined: str = R.unwrap_ok[str, str](joined_r);
    val clean_r: R.Result[str, str] = spath.clean(a, joined);
    str_free(a, joined);
    ret clean_r;
}

val STEP_FP_SCHEMA: u8 = 1;

fun digest_hex(a: *A.Allocator, digest: *u8, len: usize) str {
    val cap: usize = ehex.encoded_len(len);
    val rb: R.Result[*u8, str] = A.allocate[u8](a, cap);
    if (R.is_err[*u8, str](rb)) { ret ""; }
    val buf: *u8 = R.unwrap_ok[*u8, str](rb);
    ehex.encode(digest, len, buf, cap);
    ret buf::str;
}

fun step_stamp_path(a: *A.Allocator, root_project: str, root_out: str, owner_id: str, step_name: str) str {
    val fname: str = sfmt(a, "{}.{}.stamp", owner_id, step_name);
    val d1_r: R.Result[str, str] = load.join_path(a, root_project, root_out);
    if (R.is_err[str, str](d1_r)) { str_free(a, fname); ret ""; }
    val d1: str = R.unwrap_ok[str, str](d1_r);
    val d2_r: R.Result[str, str] = load.join_path(a, d1, STEP_STAMP_DIR);
    str_free(a, d1);
    if (R.is_err[str, str](d2_r)) { str_free(a, fname); ret ""; }
    val d2: str = R.unwrap_ok[str, str](d2_r);
    val path_r: R.Result[str, str] = load.join_path(a, d2, fname);
    str_free(a, d2);
    str_free(a, fname);
    if (R.is_err[str, str](path_r)) { ret ""; }
    ret R.unwrap_ok[str, str](path_r);
}

fun stamp_matches(a: *A.Allocator, path: str, hex: str) bool {
    val rr: R.Result[str, str] = fs.read_string(a, path);
    if (R.is_err[str, str](rr)) { ret false; }
    val prior: str = R.unwrap_ok[str, str](rr);
    val eq: bool = str_equals(prior, hex);
    str_free(a, prior);
    ret eq;
}

fun write_stamp(a: *A.Allocator, path: str, hex: str) R.Result[R.Void, str] {
    ret publication.bytes(nil, a, path, hex::*u8, str_len(hex), 0o644, publication.REPLACE, publication.PARENTS_CREATE,
                          "write the build step stamp", "the build step stamp could not be published", nil);
}

fun step_final_outputs_current(a: *A.Allocator, outputs: *Vector[StepPath]) bool {
    var i: usize = 0;
    for (i < outputs.len) {
        val sp: *StepPath = ?outputs.data[i];
        val vr: R.Result[R.Void, str] = validate_physical_path(a, sp.root, sp.rel, PHYSICAL_ENTRY, "build step output");
        if (R.is_err[R.Void, str](vr)) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun step_fp_count(e: *binary.Encoder, n: u32) bool {
    var b: [4]u8;
    b[0] = (n & 0xFF)::u8;
    b[1] = ((n >> 8) & 0xFF)::u8;
    b[2] = ((n >> 16) & 0xFF)::u8;
    b[3] = ((n >> 24) & 0xFF)::u8;
    ret fingerprint.write_domain_bytes(e, fingerprint.DOMAIN_BUILD_STEP, STEP_FP_SCHEMA, ?b[0], 4);
}

fun step_fp_file(e: *binary.Encoder, a: *A.Allocator, path: str) R.Result[R.Void, str] {
    val rr: R.Result[Vector[u8], str] = fs.read_bytes(a, path);
    if (R.is_err[Vector[u8], str](rr)) { ret R.err[R.Void, str](R.unwrap_err[Vector[u8], str](rr)); }
    var buf: Vector[u8] = R.unwrap_ok[Vector[u8], str](rr);
    var digest: [32]u8;
    sha256.hash(buf.data, buf.len, ?digest[0]);
    vector.dnit[u8](?buf);
    if (!fingerprint.write_domain_bytes(e, fingerprint.DOMAIN_BUILD_STEP, STEP_FP_SCHEMA, ?digest[0], 32)) {
        ret R.err[R.Void, str]("out of memory computing build step fingerprint");
    }
    ret R.ok_void[str]();
}

fun step_fp_strings(e: *binary.Encoder, values: *StepStrings) bool {
    if (!step_fp_count(e, values.count)) { ret false; }
    var i: u32 = 0;
    for (i < values.count) {
        if (!fingerprint.write_domain_str(e, fingerprint.DOMAIN_BUILD_STEP, STEP_FP_SCHEMA, values.items[i]::str)) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun step_fp_path_vector(e: *binary.Encoder, values: *Vector[str]) R.Result[R.Void, str] {
    if (values.len > 0xFFFFFFFF::usize) { ret R.err[R.Void, str]("build step has too many declared paths"); }
    if (!step_fp_count(e, values.len::u32)) { ret R.err[R.Void, str]("out of memory computing build step fingerprint"); }
    var i: usize = 0;
    for (i < values.len) {
        if (!fingerprint.write_domain_str(e, fingerprint.DOMAIN_BUILD_STEP, STEP_FP_SCHEMA, values.data[i])) {
            ret R.err[R.Void, str]("out of memory computing build step fingerprint");
        }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

fun step_fp_input_vector(e: *binary.Encoder, a: *A.Allocator, values: *Vector[str]) R.Result[R.Void, str] {
    if (values.len > 0xFFFFFFFF::usize) { ret R.err[R.Void, str]("build step has too many expanded inputs"); }
    if (!step_fp_count(e, values.len::u32)) { ret R.err[R.Void, str]("out of memory computing build step fingerprint"); }
    var i: usize = 0;
    for (i < values.len) {
        if (!fingerprint.write_domain_str(e, fingerprint.DOMAIN_BUILD_STEP, STEP_FP_SCHEMA, values.data[i])) {
            ret R.err[R.Void, str]("out of memory computing build step fingerprint");
        }
        val wc: R.Result[R.Void, str] = step_fp_file(e, a, values.data[i]);
        if (R.is_err[R.Void, str](wc)) { ret wc; }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

fun step_fingerprint(a: *A.Allocator, target_s: str, profile_s: str, program: str,
                     argv: *StepStrings, env: *StepStrings, prerequisites: *StepStrings,
                     ins: *Vector[str], outputs: *Vector[str], digest: *u8) R.Result[R.Void, str] {
    var e: binary.Encoder = binary.encoder(a, binary.LITTLE);

    if (!fingerprint.write_domain_str(?e, fingerprint.DOMAIN_BUILD_STEP, STEP_FP_SCHEMA, target_s)
        || !fingerprint.write_domain_str(?e, fingerprint.DOMAIN_BUILD_STEP, STEP_FP_SCHEMA, profile_s)
        || !fingerprint.write_domain_str(?e, fingerprint.DOMAIN_BUILD_STEP, STEP_FP_SCHEMA, program)) {
        binary.encoder_dnit(?e);
        ret R.err[R.Void, str]("out of memory computing build step fingerprint");
    }
    val wpc: R.Result[R.Void, str] = step_fp_file(?e, a, program);
    if (R.is_err[R.Void, str](wpc)) { binary.encoder_dnit(?e); ret wpc; }

    if (!step_fp_strings(?e, argv) || !step_fp_strings(?e, env) || !step_fp_strings(?e, prerequisites)) {
        binary.encoder_dnit(?e);
        ret R.err[R.Void, str]("out of memory computing build step fingerprint");
    }
    val wo: R.Result[R.Void, str] = step_fp_path_vector(?e, outputs);
    if (R.is_err[R.Void, str](wo)) { binary.encoder_dnit(?e); ret wo; }
    val wi: R.Result[R.Void, str] = step_fp_input_vector(?e, a, ins);
    if (R.is_err[R.Void, str](wi)) { binary.encoder_dnit(?e); ret wi; }

    sha256.hash(e.data, e.len, digest);
    binary.encoder_dnit(?e);
    ret R.ok_void[str]();
}

fun step_staging_root(a: *A.Allocator, output_root: str, step_name: str) str {
    ret sfmt(a, "{}/{}/{}", output_root, STEP_STAGE_DIR, step_name);
}

fun step_staging_home_out(a: *A.Allocator, home_out: str, step_name: str) str {
    ret sfmt(a, "{}/{}/{}", home_out, STEP_STAGE_DIR, step_name);
}

fun step_prepare_staging(a: *A.Allocator, output_root: str, staging_root: str, step_name: str) R.Result[R.Void, str] {
    val rel: str = sfmt(a, "{}/{}", STEP_STAGE_DIR, step_name);
    val ancestors_r: R.Result[R.Void, str] = validate_contained_ancestors(a, output_root, rel, "build step staging area");
    if (R.is_err[R.Void, str](ancestors_r)) { str_free(a, rel); ret ancestors_r; }
    val rm: O.Option[str] = fs.remove_all(a, staging_root);
    if (O.is_some[str](rm)) { str_free(a, rel); ret R.err[R.Void, str](sfmt(a, "failed to prepare build step staging area: {}", O.unwrap[str](rm))); }
    val make_r: R.Result[R.Void, str] = ensure_physical_directory_path(a, output_root, rel, "build step staging area");
    str_free(a, rel);
    ret make_r;
}

fun step_make_staging_dirs(a: *A.Allocator, output_root: str, staging_root: str, outputs: *Vector[StepPath]) R.Result[R.Void, str] {
    var oi: usize = 0;
    for (oi < outputs.len) {
        val sp: *StepPath = ?outputs.data[oi];
        if (str_equals(sp.root, output_root)) {
            val dir_r: R.Result[str, str] = spath.parent(a, sp.rel);
            if (R.is_err[str, str](dir_r)) { ret R.err[R.Void, str](R.unwrap_err[str, str](dir_r)); }
            val rel_dir: str = R.unwrap_ok[str, str](dir_r);
            val make_r: R.Result[R.Void, str] = ensure_physical_directory_path(a, staging_root, rel_dir, "build step staging output directory");
            str_free(a, rel_dir);
            if (R.is_err[R.Void, str](make_r)) { ret make_r; }
        }
        oi = oi + 1;
    }
    ret R.ok_void[str]();
}

fun step_paths_staged_absolute(a: *A.Allocator, output_root: str, staging_root: str, outputs: *Vector[StepPath], out: *Vector[str]) R.Result[R.Void, str] {
    var i: usize = 0;
    for (i < outputs.len) {
        val sp: *StepPath = ?outputs.data[i];
        if (str_equals(sp.root, output_root)) {
            val abs_r: R.Result[str, str] = spath.resolve(a, staging_root, sp.rel);
            if (R.is_err[str, str](abs_r)) { ret R.err[R.Void, str](R.unwrap_err[str, str](abs_r)); }
            val joined: str = R.unwrap_ok[str, str](abs_r);
            val clean_r: R.Result[str, str] = spath.clean(a, joined);
            str_free(a, joined);
            if (R.is_err[str, str](clean_r)) { ret R.err[R.Void, str](R.unwrap_err[str, str](clean_r)); }
            val abs: str = R.unwrap_ok[str, str](clean_r);
            val push_r: R.Result[usize, str] = vector.push[str](out, abs);
            if (R.is_err[usize, str](push_r)) { str_free(a, abs); ret R.err[R.Void, str](R.unwrap_err[usize, str](push_r)); }
        }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

fun publish_staged_outputs(a: *A.Allocator, staging_root: str, output_root: str, outputs: *Vector[StepPath]) R.Result[R.Void, str] {
    var i: usize = 0;
    for (i < outputs.len) {
        val sp: *StepPath = ?outputs.data[i];
        if (str_equals(sp.root, output_root)) {
            val staged_r: R.Result[str, str] = spath.resolve(a, staging_root, sp.rel);
            if (R.is_err[str, str](staged_r)) { ret R.err[R.Void, str](R.unwrap_err[str, str](staged_r)); }
            val staged: str = R.unwrap_ok[str, str](staged_r);
            val rn: O.Option[str] = fs.rename(staged, sp.abs);
            str_free(a, staged);
            if (O.is_some[str](rn)) {
                ret R.err[R.Void, str](sfmt(a, "failed to publish build step output '{}': {}", sp.abs, O.unwrap[str](rn)));
            }
        }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

fun run_one_step(a: *A.Allocator, p: *project.Project, step: *manifest.StepDef, project_root: str, home_out: str, owner_id: str) R.Result[R.Void, str] {
    val execution_root: str = project_root;
    var v: manifest.TmplVars = ddep.cell_tmpl_vars(p);
    val step_name: str = O.unwrap[str](intern.lookup(?p.s.interner, step.name));

    val output_root_r: R.Result[str, str] = spath.resolve(a, execution_root, home_out);
    if (R.is_err[str, str](output_root_r)) { ret R.err[R.Void, str](R.unwrap_err[str, str](output_root_r)); }
    val output_root: str = R.unwrap_ok[str, str](output_root_r);

    var ins: vector.Vector[str] = vector.init[str](a);
    val cir: R.Result[R.Void, str] = collect_step_inputs(a, p, step, execution_root, output_root, ?ins);
    if (R.is_err[R.Void, str](cir)) { step_free_inputs(a, ?ins); str_free(a, output_root); ret cir; }

    val invocation_r: R.Result[StepInvocation, str] = expand_step_invocation(a, p, step, home_out, ?v);
    if (R.is_err[StepInvocation, str](invocation_r)) {
        step_free_inputs(a, ?ins);
        str_free(a, output_root);
        ret R.err[R.Void, str](R.unwrap_err[StepInvocation, str](invocation_r));
    }
    var invocation: StepInvocation = R.unwrap_ok[StepInvocation, str](invocation_r);

    val program_r: R.Result[str, str] = resolve_step_program(a, execution_root, ?invocation);
    if (R.is_err[str, str](program_r)) {
        step_invocation_free(a, ?invocation);
        step_free_inputs(a, ?ins);
        str_free(a, output_root);
        ret R.err[R.Void, str](R.unwrap_err[str, str](program_r));
    }
    val program: str = R.unwrap_ok[str, str](program_r);

    val consumer_root: str = O.unwrap[str](intern.lookup(?p.s.interner, p.config.project_root));
    val consumer_out: str = O.unwrap[str](intern.lookup(?p.s.interner, p.config.project_out));
    var outputs: Vector[StepPath] = vector.init[StepPath](a);
    val outputs_r: R.Result[R.Void, str] = collect_step_outputs(a, p, step, execution_root, output_root, ?outputs);
    if (R.is_err[R.Void, str](outputs_r)) {
        step_paths_free(a, ?outputs);
        str_free(a, program);
        step_invocation_free(a, ?invocation);
        step_free_inputs(a, ?ins);
        str_free(a, output_root);
        ret outputs_r;
    }
    val output_root_dir_r: R.Result[R.Void, str] = ensure_physical_directory_path(a, consumer_root, consumer_out, "project output directory");
    if (R.is_err[R.Void, str](output_root_dir_r)) {
        step_paths_free(a, ?outputs);
        str_free(a, program);
        step_invocation_free(a, ?invocation);
        step_free_inputs(a, ?ins);
        str_free(a, output_root);
        ret output_root_dir_r;
    }
    val mdr: R.Result[R.Void, str] = step_make_output_dirs(a, ?outputs);
    if (R.is_err[R.Void, str](mdr)) {
        step_paths_free(a, ?outputs);
        str_free(a, program);
        step_invocation_free(a, ?invocation);
        step_free_inputs(a, ?ins);
        str_free(a, output_root);
        ret mdr;
    }

    var output_paths: Vector[str] = vector.init[str](a);
    val output_paths_r: R.Result[R.Void, str] = step_paths_absolute(a, ?outputs, ?output_paths);
    if (R.is_err[R.Void, str](output_paths_r)) {
        step_free_inputs(a, ?output_paths);
        step_paths_free(a, ?outputs);
        str_free(a, program);
        step_invocation_free(a, ?invocation);
        step_free_inputs(a, ?ins);
        str_free(a, output_root);
        ret output_paths_r;
    }

    var prerequisites: StepStrings = StepStrings{items: nil, count: 0};
    val prerequisites_r: R.Result[StepStrings, str] = expand_step_strings(a, p, step.need, step.need_count, home_out, ?v);
    if (R.is_err[StepStrings, str](prerequisites_r)) {
        step_free_inputs(a, ?output_paths);
        step_paths_free(a, ?outputs);
        str_free(a, program);
        step_invocation_free(a, ?invocation);
        step_free_inputs(a, ?ins);
        str_free(a, output_root);
        ret R.err[R.Void, str](R.unwrap_err[StepStrings, str](prerequisites_r));
    }
    prerequisites = R.unwrap_ok[StepStrings, str](prerequisites_r);

    var digest: [32]u8;
    val fpr: R.Result[R.Void, str] = step_fingerprint(a, v.target, v.profile, program, ?invocation.argv, ?invocation.env, ?prerequisites, ?ins, ?output_paths, ?digest[0]);
    step_strings_free(a, ?prerequisites);
    step_free_inputs(a, ?ins);
    if (R.is_err[R.Void, str](fpr)) {
        step_free_inputs(a, ?output_paths);
        step_paths_free(a, ?outputs);
        str_free(a, program);
        step_invocation_free(a, ?invocation);
        str_free(a, output_root);
        ret fpr;
    }

    val root_project: str = O.unwrap[str](intern.lookup(?p.s.interner, p.config.project_root));
    val root_out: str = O.unwrap[str](intern.lookup(?p.s.interner, p.config.project_out));
    val stamp_path: str = step_stamp_path(a, root_project, root_out, owner_id, step_name);
    val hex: str = digest_hex(a, ?digest[0], 32::usize);

    if (step.out_count > 0 && !str_empty(stamp_path) && !str_empty(hex)
        && stamp_matches(a, stamp_path, hex) && step_final_outputs_current(a, ?outputs)) {
        str_free(a, hex);
        str_free(a, stamp_path);
        step_free_inputs(a, ?output_paths);
        step_paths_free(a, ?outputs);
        str_free(a, program);
        step_invocation_free(a, ?invocation);
        str_free(a, output_root);
        ret R.ok_void[str]();
    }
    step_free_inputs(a, ?output_paths);

    val staging_root: str = step_staging_root(a, output_root, step_name);
    val staging_home_out: str = step_staging_home_out(a, home_out, step_name);
    if (str_empty(staging_root) || str_empty(staging_home_out)) {
        str_free(a, hex); str_free(a, stamp_path);
        str_free(a, staging_root); str_free(a, staging_home_out);
        step_paths_free(a, ?outputs);
        str_free(a, program);
        step_invocation_free(a, ?invocation);
        str_free(a, output_root);
        ret R.err[R.Void, str]("out of memory constructing build step staging paths");
    }

    val prep_r: R.Result[R.Void, str] = step_prepare_staging(a, output_root, staging_root, step_name);
    if (R.is_err[R.Void, str](prep_r)) {
        str_free(a, hex); str_free(a, stamp_path);
        str_free(a, staging_root); str_free(a, staging_home_out);
        step_paths_free(a, ?outputs);
        str_free(a, program);
        step_invocation_free(a, ?invocation);
        str_free(a, output_root);
        ret prep_r;
    }
    val staging_dirs_r: R.Result[R.Void, str] = step_make_staging_dirs(a, output_root, staging_root, ?outputs);
    if (R.is_err[R.Void, str](staging_dirs_r)) {
        str_free(a, hex); str_free(a, stamp_path);
        str_free(a, staging_root); str_free(a, staging_home_out);
        step_paths_free(a, ?outputs);
        str_free(a, program);
        step_invocation_free(a, ?invocation);
        str_free(a, output_root);
        ret staging_dirs_r;
    }

    val staging_invocation_r: R.Result[StepInvocation, str] = expand_step_invocation(a, p, step, staging_home_out, ?v);
    if (R.is_err[StepInvocation, str](staging_invocation_r)) {
        str_free(a, hex); str_free(a, stamp_path);
        str_free(a, staging_root); str_free(a, staging_home_out);
        step_paths_free(a, ?outputs);
        str_free(a, program);
        step_invocation_free(a, ?invocation);
        str_free(a, output_root);
        ret R.err[R.Void, str](R.unwrap_err[StepInvocation, str](staging_invocation_r));
    }
    var staging_invocation: StepInvocation = R.unwrap_ok[StepInvocation, str](staging_invocation_r);

    val msg: str = sfmt(a, "step {}: {}\n", step_name, invocation.argv.items[0]::str);
    print.print(msg);
    str_free(a, msg);
    step_invocation_free(a, ?invocation);

    val obj_tree: str = module_obj_tree(a, output_root, O.unwrap[str](intern.lookup(?p.s.interner, p.config.id)));
    if (str_empty(obj_tree)) {
        str_free(a, hex); str_free(a, stamp_path);
        str_free(a, staging_root); str_free(a, staging_home_out);
        step_paths_free(a, ?outputs);
        str_free(a, program);
        step_invocation_free(a, ?staging_invocation);
        str_free(a, output_root);
        ret R.err[R.Void, str]("out of memory constructing compiler-owned object tree path");
    }
    var obj_before: Vector[TreeFile] = vector.init[TreeFile](a);
    val snapshot_r: R.Result[R.Void, str] = collect_tree_files(a, obj_tree, ?obj_before);
    if (R.is_err[R.Void, str](snapshot_r)) {
        free_tree_files(a, ?obj_before);
        str_free(a, obj_tree);
        str_free(a, hex); str_free(a, stamp_path);
        str_free(a, staging_root); str_free(a, staging_home_out);
        step_paths_free(a, ?outputs);
        str_free(a, program);
        step_invocation_free(a, ?staging_invocation);
        str_free(a, output_root);
        ret snapshot_r;
    }

    var staging_before: Vector[TreeFile] = vector.init[TreeFile](a);
    val staging_snapshot_r: R.Result[R.Void, str] = collect_tree_files(a, staging_root, ?staging_before);
    if (R.is_err[R.Void, str](staging_snapshot_r)) {
        free_tree_files(a, ?staging_before);
        free_tree_files(a, ?obj_before);
        str_free(a, obj_tree);
        str_free(a, hex); str_free(a, stamp_path);
        str_free(a, staging_root); str_free(a, staging_home_out);
        step_paths_free(a, ?outputs);
        str_free(a, program);
        step_invocation_free(a, ?staging_invocation);
        str_free(a, output_root);
        ret staging_snapshot_r;
    }

    val res_run: R.Result[R.Void, str] = execute_step_invocation(a, execution_root, program, ?staging_invocation,
                                                               step_name, step.timeout_seconds);
    str_free(a, program);
    step_invocation_free(a, ?staging_invocation);

    val object_integrity: R.Result[R.Void, str] = check_step_left_obj_tree(a, ?obj_before, obj_tree, step_name);
    free_tree_files(a, ?obj_before);
    str_free(a, obj_tree);

    var staging_declared: Vector[str] = vector.init[str](a);
    var staging_declared_abs: Vector[str] = vector.init[str](a);
    var output_integrity: R.Result[R.Void, str] = step_paths_rel_for_root(a, ?outputs, output_root, ?staging_declared);
    if (R.is_ok[R.Void, str](output_integrity)) { output_integrity = step_paths_staged_absolute(a, output_root, staging_root, ?outputs, ?staging_declared_abs); }
    if (R.is_ok[R.Void, str](output_integrity)) {
        output_integrity = check_step_output_effects(a, ?staging_before, staging_root, ?staging_declared_abs, step_name);
        if (R.is_ok[R.Void, str](res_run)) {
            var declared_exec: Vector[str] = vector.init[str](a);
            var declared_r: R.Result[R.Void, str] = step_paths_rel_for_root(a, ?outputs, execution_root, ?declared_exec);
            if (R.is_ok[R.Void, str](declared_r) && declared_exec.len > 0) { declared_r = validate_declared_step_outputs(a, execution_root, ?declared_exec, step_name); }
            if (R.is_ok[R.Void, str](declared_r) && staging_declared.len > 0) { declared_r = validate_declared_step_outputs(a, staging_root, ?staging_declared, step_name); }
            step_free_inputs(a, ?declared_exec);
            if (R.is_err[R.Void, str](declared_r)) {
                if (R.is_err[R.Void, str](output_integrity)) {
                    output_integrity = R.err[R.Void, str](sfmt(a, "{}; declared output integrity: {}", R.unwrap_err[R.Void, str](output_integrity), R.unwrap_err[R.Void, str](declared_r)));
                }
                or { output_integrity = declared_r; }
            }
        }
    }
    free_tree_files(a, ?staging_before);
    step_free_inputs(a, ?staging_declared_abs);

    val finished: R.Result[R.Void, str] = combine_step_terminal_results(a, object_integrity, output_integrity, res_run);
    if (R.is_err[R.Void, str](finished)) {
        fs.remove_all(a, staging_root);
        step_free_inputs(a, ?staging_declared);
        str_free(a, hex); str_free(a, stamp_path);
        str_free(a, staging_root); str_free(a, staging_home_out);
        step_paths_free(a, ?outputs);
        str_free(a, output_root);
        ret finished;
    }

    val publish_r: R.Result[R.Void, str] = publish_staged_outputs(a, staging_root, output_root, ?outputs);
    if (R.is_err[R.Void, str](publish_r)) {
        step_free_inputs(a, ?staging_declared);
        str_free(a, hex); str_free(a, stamp_path);
        str_free(a, staging_root); str_free(a, staging_home_out);
        step_paths_free(a, ?outputs);
        str_free(a, output_root);
        ret publish_r;
    }
    fs.remove_all(a, staging_root);
    step_free_inputs(a, ?staging_declared);

    var stamped: R.Result[R.Void, str] = R.ok_void[str]();
    if (step.out_count > 0) {
        stamped = write_stamp(a, stamp_path, hex);
        if (R.is_err[R.Void, str](stamped)) {
            stamped = R.err[R.Void, str](sfmt(a, "build step '{}' completed but its cache record could not be published: {}",
                                            step_name, R.unwrap_err[R.Void, str](stamped)));
        }
    }

    str_free(a, hex);
    str_free(a, stamp_path);
    str_free(a, staging_root);
    str_free(a, staging_home_out);
    step_paths_free(a, ?outputs);
    str_free(a, output_root);
    ret stamped;
}

pub fun execute_steps(a: *A.Allocator, p: *project.Project, project_root: str) R.Result[R.Void, str] {
    if (p.config.step_order_count == 0) { ret R.ok_void[str](); }
    val abs_root_r: R.Result[str, str] = absolute_execution_root(a, project_root);
    if (R.is_err[str, str](abs_root_r)) { ret R.err[R.Void, str](R.unwrap_err[str, str](abs_root_r)); }
    val abs_root: str = R.unwrap_ok[str, str](abs_root_r);
    val root_out: str = O.unwrap[str](intern.lookup(?p.s.interner, p.config.project_out));
    val owner_id: str = O.unwrap[str](intern.lookup(?p.s.interner, p.config.id));
    var i: u32 = 0;
    for (i < p.config.step_order_count) {
        val idx: u32 = p.config.step_order[i];
        val res: R.Result[R.Void, str] = run_one_step(a, p, ?p.config.steps[idx], abs_root, root_out, owner_id);
        if (R.is_err[R.Void, str](res)) { str_free(a, abs_root); ret res; }
        i = i + 1;
    }
    str_free(a, abs_root);
    ret R.ok_void[str]();
}

fun dep_resolve_relative_root(alloc: *A.Allocator, cwd: str, rel: str) R.Result[str, str] {
    val cwd_len: usize = str_len(cwd);
    val rel_len: usize = str_len(rel);
    val cap: usize = cwd_len + rel_len + 2;
    val rb: R.Result[*u8, str] = A.allocate[u8](alloc, cap);
    if (R.is_err[*u8, str](rb)) { ret R.err[str, str](R.unwrap_err[*u8, str](rb)); }
    val buf: *u8 = R.unwrap_ok[*u8, str](rb);

    var k: usize = 0;
    for (k < cwd_len) { buf[k] = cwd[k]; k = k + 1; }

    var i: usize = 0;
    for (i < rel_len) {
        for (i < rel_len && spath.is_separator(rel[i])) { i = i + 1; }
        if (i >= rel_len) { brk; }
        val start: usize = i;
        for (i < rel_len && !spath.is_separator(rel[i])) { i = i + 1; }
        val len: usize = i - start;

        if (len == 1 && rel[start] == '.'::u8) { cnt; }
        if (len == 2 && rel[start] == '.'::u8 && rel[start + 1] == '.'::u8) {
            buf[k] = 0;
            val parent_r: R.Result[str, str] = spath.parent(alloc, buf::str);
            if (R.is_err[str, str](parent_r)) {
                A.deallocate[u8](alloc, buf, cap);
                ret parent_r;
            }
            val parent: str = R.unwrap_ok[str, str](parent_r);
            val parent_len: usize = str_len(parent);
            k = 0;
            for (k < parent_len) { buf[k] = parent[k]; k = k + 1; }
            str_free(alloc, parent);
            cnt;
        }

        if (k > 0 && !spath.is_separator(buf[k - 1])) {
            buf[k] = spath.separator();
            k = k + 1;
        }
        var j: usize = 0;
        for (j < len) { buf[k] = rel[start + j]; k = k + 1; j = j + 1; }
    }
    buf[k] = 0;

    val out_r: R.Result[str, str] = str_copy_slice(alloc, buf::str, 0, k);
    A.deallocate[u8](alloc, buf, cap);
    ret out_r;
}

pub fun dep_out_home(alloc: *A.Allocator, project_root: str, root_out: str) R.Result[str, str] {
    if (spath.is_abs(project_root)) {
        ret spath.resolve(alloc, project_root, root_out);
    }

    val cwd_r: R.Result[str, str] = env.current_dir(alloc);
    if (R.is_err[str, str](cwd_r)) { ret cwd_r; }
    val cwd: str = R.unwrap_ok[str, str](cwd_r);

    val root_r: R.Result[str, str] = dep_resolve_relative_root(alloc, cwd, project_root);
    str_free(alloc, cwd);
    if (R.is_err[str, str](root_r)) { ret root_r; }
    val root: str = R.unwrap_ok[str, str](root_r);

    val out_r: R.Result[str, str] = spath.resolve(alloc, root, root_out);
    str_free(alloc, root);
    ret out_r;
}

pub fun execute_dep_steps(p: *project.Project, isa: str, os: str, abi: str) R.Result[R.Void, str] {
    val n: u32 = p.config.dep_count;
    if (n == 0) { ret R.ok_void[str](); }

    var tgt: manifest.TargetDef;
    val ri: R.Result[intern.StrId, str] = intern.intern(?p.s.interner, isa);
    if (R.is_err[intern.StrId, str](ri)) { ret R.err[R.Void, str](R.unwrap_err[intern.StrId, str](ri)); }
    tgt.isa = R.unwrap_ok[intern.StrId, str](ri);
    val ro: R.Result[intern.StrId, str] = intern.intern(?p.s.interner, os);
    if (R.is_err[intern.StrId, str](ro)) { ret R.err[R.Void, str](R.unwrap_err[intern.StrId, str](ro)); }
    tgt.os = R.unwrap_ok[intern.StrId, str](ro);
    val ra: R.Result[intern.StrId, str] = intern.intern(?p.s.interner, abi);
    if (R.is_err[intern.StrId, str](ra)) { ret R.err[R.Void, str](R.unwrap_err[intern.StrId, str](ra)); }
    tgt.abi = R.unwrap_ok[intern.StrId, str](ra);

    val root_out: str = O.unwrap[str](intern.lookup(?p.s.interner, p.config.project_out));
    val root_project: str = O.unwrap[str](intern.lookup(?p.s.interner, p.config.project_root));
    var cv: manifest.TmplVars = ddep.cell_tmpl_vars(p);

    var i: u32 = 0;
    for (i < n) {
        val vr_opt: O.Option[str] = intern.lookup(?p.s.interner, p.config.deps[i].vendor_root);
        if (O.is_none[str](vr_opt)) { ret R.err[R.Void, str]("internal: dep metadata not interned"); }
        val dep_vr: str = O.unwrap[str](vr_opt);

        val mfd: *manifest.Manifest = ?p.config.deps[i].manifest;
        val dep_owner_opt: O.Option[str] = intern.lookup(?p.s.interner, mfd.id);
        if (O.is_none[str](dep_owner_opt)) { ret R.err[R.Void, str]("internal: dependency manifest id not interned"); }
        val dep_owner: str = O.unwrap[str](dep_owner_opt);

        var dep_order: *u32 = nil;
        var dep_count: u32  = 0;
        val dpr: R.Result[R.Void, str] = manifest.plan_export_steps(p.alloc, ?p.s.interner, mfd, ?tgt, root_out, ?cv, ?dep_order, ?dep_count);
        if (R.is_err[R.Void, str](dpr)) { ret dpr; }

        if (dep_count > 0) {
            val hr: R.Result[str, str] = dep_out_home(p.alloc, root_project, root_out);
            if (R.is_err[str, str](hr)) { A.deallocate[u32](p.alloc, dep_order, dep_count::usize); ret R.err[R.Void, str](R.unwrap_err[str, str](hr)); }
            val dep_home: str = R.unwrap_ok[str, str](hr);
            val dep_abs_r: R.Result[str, str] = absolute_execution_root(p.alloc, dep_vr);
            if (R.is_err[str, str](dep_abs_r)) {
                str_free(p.alloc, dep_home);
                A.deallocate[u32](p.alloc, dep_order, dep_count::usize);
                ret R.err[R.Void, str](R.unwrap_err[str, str](dep_abs_r));
            }
            val dep_abs: str = R.unwrap_ok[str, str](dep_abs_r);
            var si: u32 = 0;
            for (si < dep_count) {
                val rs: R.Result[R.Void, str] = run_one_step(p.alloc, p, ?mfd.steps[dep_order[si]], dep_abs, dep_home, dep_owner);
                if (R.is_err[R.Void, str](rs)) { str_free(p.alloc, dep_abs); str_free(p.alloc, dep_home); A.deallocate[u32](p.alloc, dep_order, dep_count::usize); ret rs; }
                si = si + 1;
            }
            str_free(p.alloc, dep_abs);
            str_free(p.alloc, dep_home);
            A.deallocate[u32](p.alloc, dep_order, dep_count::usize);
        }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

fun cfg_contains(hay: str, needle: str) bool {
    val hn: usize = str_len(hay);
    val nn: usize = str_len(needle);
    if (nn > hn) { ret false; }
    var i: usize = 0;
    for (i + nn <= hn) {
        var j: usize = 0;
        for (j < nn && hay[i + j] == needle[j]) { j = j + 1; }
        if (j == nn) { ret true; }
        i = i + 1;
    }
    ret false;
}

rec CloneAllocProbe {
    backing:   A.Allocator;
    remaining: u32;
    live:      u32;
}

fun clone_probe_alloc(ctx: ptr, size: usize, align: usize) O.Option[ptr] {
    val p: *CloneAllocProbe = ctx::*CloneAllocProbe;
    if (p.remaining == 0) { ret O.none[ptr](); }
    p.remaining = p.remaining - 1;
    val r: O.Option[ptr] = p.backing.fn_allocate(p.backing.ctx, size, align);
    if (O.is_some[ptr](r)) { p.live = p.live + 1; }
    ret r;
}

fun clone_probe_realloc(ctx: ptr, item: ptr, old_size: usize, new_size: usize, align: usize) O.Option[ptr] {
    ret O.none[ptr]();
}

fun clone_probe_dealloc(ctx: ptr, item: ptr, size: usize, align: usize) i64 {
    val p: *CloneAllocProbe = ctx::*CloneAllocProbe;
    p.live = p.live - 1;
    ret p.backing.fn_deallocate(p.backing.ctx, item, size, align);
}

test "mach.lang.driver.config.clone_step:allocation_failure_is_atomic" {
    var probe: CloneAllocProbe;
    if (O.is_some[str](page.make(?probe.backing))) { ret 1; }
    probe.remaining = 2;
    probe.live = 0;
    var alloc: A.Allocator;
    val probe_ptr: *CloneAllocProbe = ?probe;
    alloc.ctx = probe_ptr::ptr;
    alloc.fn_allocate = clone_probe_alloc;
    alloc.fn_reallocate = clone_probe_realloc;
    alloc.fn_deallocate = clone_probe_dealloc;

    var argv: [1]intern.StrId;
    var env_keys: [1]intern.StrId;
    var env_values: [1]intern.StrId;
    argv[0] = 1;
    env_keys[0] = 2;
    env_values[0] = 3;
    var src: manifest.StepDef;
    src.name = 4;
    src.argv = ?argv[0];
    src.argv_count = 1;
    src.env_keys = ?env_keys[0];
    src.env_values = ?env_values[0];
    src.env_count = 1;
    src.in = nil;
    src.in_count = 0;
    src.out = nil;
    src.out_count = 0;
    src.need = nil;
    src.need_count = 0;
    var out: manifest.StepDef;
    out.name = 99;
    val r: R.Result[R.Void, str] = clone_step(?alloc, ?src, ?out);
    if (R.is_ok[R.Void, str](r)) { ret 1; }
    if (out.name != 99) { ret 1; }
    if (probe.live != 0) { ret 1; }
    ret 0;
}

fun cfg_raw_nul_manifest_rejected(alloc: *A.Allocator, suffix: str) bool {
    val prefix: str = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n";
    val prefix_len: usize = str_len(prefix);
    val suffix_len: usize = str_len(suffix);
    val total: usize = prefix_len + 1 + suffix_len;
    val bytes_r: R.Result[*u8, str] = A.allocate[u8](alloc, total);
    if (R.is_err[*u8, str](bytes_r)) { ret false; }
    val bytes: *u8 = R.unwrap_ok[*u8, str](bytes_r);
    var i: usize = 0;
    for (i < prefix_len) { bytes[i] = prefix[i]; i = i + 1; }
    bytes[prefix_len] = 0;
    i = 0;
    for (i < suffix_len) { bytes[prefix_len + 1 + i] = suffix[i]; i = i + 1; }

    val temp_r: R.Result[fs.TempFile, str] = fs.temp_create(alloc, "mach_nul_manifest");
    if (R.is_err[fs.TempFile, str](temp_r)) { A.deallocate[u8](alloc, bytes, total); ret false; }
    var temp: fs.TempFile = R.unwrap_ok[fs.TempFile, str](temp_r);
    val write_r: O.Option[str] = fs.write_bytes(fs.temp_path(?temp), bytes, total, 0o600);
    A.deallocate[u8](alloc, bytes, total);
    if (O.is_some[str](write_r)) { fs.temp_close_and_remove(?temp); ret false; }
    val parse_r: R.Result[toml.Table, str] = ddep.parse_toml_file(alloc, fs.temp_path(?temp));
    fs.temp_close_and_remove(?temp);
    if (R.is_ok[toml.Table, str](parse_r)) {
        var table: toml.Table = R.unwrap_ok[toml.Table, str](parse_r);
        toml.dnit(alloc, ?table);
        ret false;
    }
    ret cfg_contains(R.unwrap_err[toml.Table, str](parse_r), "NUL");
}

test "mach.lang.driver.config.parse_toml_file:raw_nul_rejects_trailing_bytes" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    if (!cfg_raw_nul_manifest_rejected(?alloc, "[profile.debug]\nopt=0\ndebug=false\nsimd=\"scalarize\"\n")) { ret 1; }
    if (!cfg_raw_nul_manifest_rejected(?alloc, "not = [valid TOML")) { ret 1; }
    ret 0;
}

test "mach.lang.driver.config.execute_step_invocation:exact_argv_and_environment" {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }

    var argv: [6]*u8;
    argv[0] = "sh";
    argv[1] = "-c";
    argv[2] = "test \"$1\" = \"$LITERAL\" && test -z \"${HOME+x}\" && test -z \"${MACH_TARGET_ISA+x}\"";
    argv[3] = "mach-step";
    argv[4] = "literal \"';$&|<>*?[]";
    argv[5] = nil;
    var envp: [2]*u8;
    envp[0] = "LITERAL=literal \"';$&|<>*?[]";
    envp[1] = nil;
    var invocation: StepInvocation;
    invocation.argv = StepStrings{items: ?argv[0], count: 5};
    invocation.env = StepStrings{items: ?envp[0], count: 1};
    val shell_r: R.Result[str, str] = resolve_step_program(?alloc, "/", ?invocation);
    if (R.is_err[str, str](shell_r)) { ret 1; }
    val shell: str = R.unwrap_ok[str, str](shell_r);
    val shell_run: R.Result[R.Void, str] = execute_step_invocation(?alloc, "/", shell, ?invocation, "probe", 0);
    str_free(?alloc, shell);
    if (R.is_err[R.Void, str](shell_run)) { ret 1; }

    var empty_env: [1]*u8;
    empty_env[0] = nil;
    var env_argv: [2]*u8;
    env_argv[0] = "env";
    env_argv[1] = nil;
    invocation.argv = StepStrings{items: ?env_argv[0], count: 1};
    invocation.env = StepStrings{items: ?empty_env[0], count: 0};
    val env_program_r: R.Result[str, str] = resolve_step_program(?alloc, "/", ?invocation);
    if (R.is_err[str, str](env_program_r)) { ret 1; }
    val env_program: str = R.unwrap_ok[str, str](env_program_r);
    val temp_r: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "mach_step_env");
    if (R.is_err[fs.TempFile, str](temp_r)) { str_free(?alloc, env_program); ret 1; }
    var temp: fs.TempFile = R.unwrap_ok[fs.TempFile, str](temp_r);
    if (O.is_some[str](fs.temp_close(?temp))) { str_free(?alloc, env_program); ret 1; }
    var child: subprocess.OwnedSubprocess;
    subprocess.init(?child);
    val spawn_r: R.Result[R.Void, str] = subprocess.spawn_captured(?alloc, ?child, env_program, ?env_argv[0], ?empty_env[0], fs.temp_path(?temp), 64);
    str_free(?alloc, env_program);
    if (R.is_err[R.Void, str](spawn_r)) { fs.temp_remove(?temp); ret 1; }
    val wait_r: R.Result[subprocess.SubprocessTerminal, str] = subprocess.wait(?alloc, ?child);
    if (R.is_err[subprocess.SubprocessTerminal, str](wait_r)) { fs.temp_remove(?temp); ret 1; }
    val terminal: subprocess.SubprocessTerminal = R.unwrap_ok[subprocess.SubprocessTerminal, str](wait_r);
    val capture_r: R.Result[subprocess.CaptureIoResult, str] = subprocess.finish_capture(?alloc, ?child, true);
    if (R.is_err[subprocess.CaptureIoResult, str](capture_r)) { fs.temp_remove(?temp); ret 1; }
    val capture: subprocess.CaptureIoResult = R.unwrap_ok[subprocess.CaptureIoResult, str](capture_r);
    var captured: usize = 0;
    subprocess.capture_bytes(?child, ?captured);
    val released: R.Result[R.Void, str] = subprocess.release_capture(?alloc, ?child);
    fs.temp_remove(?temp);
    if (terminal.kind != subprocess.STATE_EXITED || terminal.code != 0 || capture.read_failed || captured != 0 || R.is_err[R.Void, str](released)) { ret 1; }
    ret 0;
}

test "mach.lang.driver.config.execute_step_invocation:failure_states" {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    var empty_env: [1]*u8;
    empty_env[0] = nil;
    var invocation: StepInvocation;
    invocation.env = StepStrings{items: ?empty_env[0], count: 0};

    var missing_argv: [2]*u8;
    missing_argv[0] = "definitely-not-a-mach-step-executable";
    missing_argv[1] = nil;
    invocation.argv = StepStrings{items: ?missing_argv[0], count: 1};
    val missing: R.Result[str, str] = resolve_step_program(?alloc, "/", ?invocation);
    if (R.is_ok[str, str](missing) || !cfg_contains(R.unwrap_err[str, str](missing), "planner PATH")) { ret 1; }

    var spawn_argv: [2]*u8;
    spawn_argv[0] = "/definitely/not/a/mach-step-executable";
    spawn_argv[1] = nil;
    invocation.argv = StepStrings{items: ?spawn_argv[0], count: 1};
    val spawn_program_r: R.Result[str, str] = resolve_step_program(?alloc, "/", ?invocation);
    if (R.is_err[str, str](spawn_program_r)) { ret 1; }
    val spawn_program: str = R.unwrap_ok[str, str](spawn_program_r);
    val spawn_failed: R.Result[R.Void, str] = execute_step_invocation(?alloc, "/", spawn_program, ?invocation, "probe", 0);
    str_free(?alloc, spawn_program);
    if (R.is_ok[R.Void, str](spawn_failed) || !cfg_contains(R.unwrap_err[R.Void, str](spawn_failed), "code 127")) { ret 1; }

    var exit_argv: [4]*u8;
    exit_argv[0] = "sh";
    exit_argv[1] = "-c";
    exit_argv[2] = "exit 7";
    exit_argv[3] = nil;
    invocation.argv = StepStrings{items: ?exit_argv[0], count: 3};
    val exit_program_r: R.Result[str, str] = resolve_step_program(?alloc, "/", ?invocation);
    if (R.is_err[str, str](exit_program_r)) { ret 1; }
    val exit_program: str = R.unwrap_ok[str, str](exit_program_r);
    val exited: R.Result[R.Void, str] = execute_step_invocation(?alloc, "/", exit_program, ?invocation, "probe", 0);
    str_free(?alloc, exit_program);
    if (R.is_ok[R.Void, str](exited) || !cfg_contains(R.unwrap_err[R.Void, str](exited), "code 7")) { ret 1; }

    var signal_argv: [4]*u8;
    signal_argv[0] = "sh";
    signal_argv[1] = "-c";
    signal_argv[2] = "kill -TERM $$";
    signal_argv[3] = nil;
    invocation.argv = StepStrings{items: ?signal_argv[0], count: 3};
    val signal_program_r: R.Result[str, str] = resolve_step_program(?alloc, "/", ?invocation);
    if (R.is_err[str, str](signal_program_r)) { ret 1; }
    val signal_program: str = R.unwrap_ok[str, str](signal_program_r);
    val signaled: R.Result[R.Void, str] = execute_step_invocation(?alloc, "/", signal_program, ?invocation, "probe", 0);
    str_free(?alloc, signal_program);
    if (R.is_ok[R.Void, str](signaled) || !cfg_contains(R.unwrap_err[R.Void, str](signaled), "terminated by signal")) { ret 1; }
    ret 0;
}

test "mach.lang.driver.config.glob:dot_names_errors_and_symlinks" {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "mach_step_glob");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);
    val root_r: R.Result[str, str] = str_dup(?alloc, fs.temp_path(?tf));
    fs.temp_close_and_remove(?tf);
    if (R.is_err[str, str](root_r)) { ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);
    if (O.is_some[str](fs.create_dir(root, 0o700))) { str_free(?alloc, root); ret 1; }

    val hidden: str = sfmt(?alloc, "{}/.hidden", root);
    val visible: str = sfmt(?alloc, "{}/visible", root);
    if (O.is_some[str](fs.write_bytes(hidden, "h", 1, 0o600))
        || O.is_some[str](fs.write_bytes(visible, "v", 1, 0o600))) {
        fs.remove_all(?alloc, root);
        str_free(?alloc, root);
        ret 1;
    }

    var matches: vector.Vector[str] = vector.init[str](?alloc);
    val dot_r: R.Result[R.Void, str] = glob_expand_pattern(?alloc, root, ".*", ?matches);
    var bad: bool = R.is_err[R.Void, str](dot_r) || matches.len != 1;
    if (!bad && !cfg_contains(matches.data[0], ".hidden")) { bad = true; }
    step_free_inputs(?alloc, ?matches);

    var missing: vector.Vector[str] = vector.init[str](?alloc);
    val missing_r: R.Result[R.Void, str] = glob_expand_pattern(?alloc, root, "missing/*.c", ?missing);
    if (R.is_ok[R.Void, str](missing_r) || !cfg_contains(R.unwrap_err[R.Void, str](missing_r), "does not exist")) { bad = true; }
    step_free_inputs(?alloc, ?missing);

    val link: str = sfmt(?alloc, "{}/link", root);
    if (O.is_some[str](fs.symlink(hidden, link))) { bad = true; }
    or {
        var linked: vector.Vector[str] = vector.init[str](?alloc);
        val linked_r: R.Result[R.Void, str] = glob_expand_pattern(?alloc, root, "*", ?linked);
        if (R.is_ok[R.Void, str](linked_r) || !cfg_contains(R.unwrap_err[R.Void, str](linked_r), "symlink")) { bad = true; }
        step_free_inputs(?alloc, ?linked);
    }

    val real: str = sfmt(?alloc, "{}/real", root);
    val real_file: str = sfmt(?alloc, "{}/real/input.c", root);
    val jump: str = sfmt(?alloc, "{}/jump", root);
    if (O.is_some[str](fs.create_dir(real, 0o700)) || O.is_some[str](fs.write_bytes(real_file, "c", 1, 0o600)) || O.is_some[str](fs.symlink(real, jump))) { bad = true; }
    or {
        var escaped: vector.Vector[str] = vector.init[str](?alloc);
        val escaped_r: R.Result[R.Void, str] = glob_expand_pattern(?alloc, root, "jump/*.c", ?escaped);
        if (R.is_ok[R.Void, str](escaped_r) || !cfg_contains(R.unwrap_err[R.Void, str](escaped_r), "symlink component")) { bad = true; }
        step_free_inputs(?alloc, ?escaped);
    }

    val plain_ok: R.Result[R.Void, str] = validate_physical_path(?alloc, root, "visible", PHYSICAL_REGULAR, "build step input");
    if (R.is_err[R.Void, str](plain_ok)) { bad = true; }
    val plain_dir: R.Result[R.Void, str] = validate_physical_path(?alloc, root, "real", PHYSICAL_REGULAR, "build step input");
    if (R.is_ok[R.Void, str](plain_dir)) { bad = true; }

    str_free(?alloc, jump);
    str_free(?alloc, real_file);
    str_free(?alloc, real);
    str_free(?alloc, link);
    str_free(?alloc, hidden);
    str_free(?alloc, visible);
    fs.remove_all(?alloc, root);
    str_free(?alloc, root);
    if (bad) { ret 1; }
    ret 0;
}

test "mach.lang.driver.config.glob:implicit_pattern_skips_hidden_file_and_hidden_directory" {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "mach_step_glob_implicit");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);
    val root_r: R.Result[str, str] = str_dup(?alloc, fs.temp_path(?tf));
    fs.temp_close_and_remove(?tf);
    if (R.is_err[str, str](root_r)) { ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);
    if (O.is_some[str](fs.create_dir(root, 0o700))) { str_free(?alloc, root); ret 1; }

    val hidden_file: str = sfmt(?alloc, "{}/.hidden.c", root);
    val visible_file: str = sfmt(?alloc, "{}/visible.c", root);
    val hidden_dir: str = sfmt(?alloc, "{}/.hidden_dir", root);
    val nested_file: str = sfmt(?alloc, "{}/.hidden_dir/nested.c", root);
    var bad: bool = false;
    if (O.is_some[str](fs.write_bytes(hidden_file, "h", 1, 0o600))
        || O.is_some[str](fs.write_bytes(visible_file, "v", 1, 0o600))
        || O.is_some[str](fs.create_dir(hidden_dir, 0o700))
        || O.is_some[str](fs.write_bytes(nested_file, "n", 1, 0o600))) { bad = true; }

    var top: vector.Vector[str] = vector.init[str](?alloc);
    val top_r: R.Result[R.Void, str] = glob_expand_pattern(?alloc, root, "*.c", ?top);
    if (R.is_err[R.Void, str](top_r) || top.len != 1) { bad = true; }
    if (!bad && !cfg_contains(top.data[0], "visible.c")) { bad = true; }
    if (!bad && cfg_contains(top.data[0], "hidden")) { bad = true; }
    step_free_inputs(?alloc, ?top);

    var deep: vector.Vector[str] = vector.init[str](?alloc);
    val deep_r: R.Result[R.Void, str] = glob_expand_pattern(?alloc, root, "**/*.c", ?deep);
    if (R.is_err[R.Void, str](deep_r) || deep.len != 1) { bad = true; }
    if (!bad && !cfg_contains(deep.data[0], "visible.c")) { bad = true; }
    step_free_inputs(?alloc, ?deep);

    str_free(?alloc, nested_file);
    str_free(?alloc, hidden_dir);
    str_free(?alloc, visible_file);
    str_free(?alloc, hidden_file);
    fs.remove_all(?alloc, root);
    str_free(?alloc, root);
    if (bad) { ret 1; }
    ret 0;
}

test "mach.lang.driver.config.path_in_module_obj_tree:boundaries" {
    val tree: str = "out/linux/debug/obj/vend";
    if (!path_in_module_obj_tree("out/linux/debug/obj/vend", tree))            { ret 1; }
    if (!path_in_module_obj_tree("out/linux/debug/obj/vend/window.o", tree))   { ret 2; }
    if (!path_in_module_obj_tree("out/linux/debug/obj/vend/gl/ctx.o", tree))   { ret 3; }
    if (path_in_module_obj_tree("out/linux/debug/obj/vend-c/window.o", tree))  { ret 4; }
    if (path_in_module_obj_tree("out/linux/debug/obj/other/window.o", tree))   { ret 5; }
    if (path_in_module_obj_tree("out/linux/debug/vendor/window.o", tree))      { ret 6; }
    ret 0;
}

test "mach.lang.driver.config.validate_declared_step_output_collisions:deterministic" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    var outputs: Vector[DeclaredStepOutput] = vector.init[DeclaredStepOutput](?alloc);
    if (R.is_err[usize, str](vector.push[DeclaredStepOutput](?outputs, DeclaredStepOutput{path: "out/generated", step: "zeta"}))) { ret 1; }
    if (R.is_err[usize, str](vector.push[DeclaredStepOutput](?outputs, DeclaredStepOutput{path: "out/generated", step: "alpha"}))) { vector.dnit[DeclaredStepOutput](?outputs); ret 1; }
    val exact: R.Result[R.Void, str] = validate_declared_step_output_collisions(?alloc, ?outputs);
    var bad: bool = R.is_ok[R.Void, str](exact);
    if (!bad) {
        val msg: str = R.unwrap_err[R.Void, str](exact);
        if (!cfg_contains(msg, "[step.alpha]") || !cfg_contains(msg, "[step.zeta]")) { bad = true; }
        str_free(?alloc, msg);
    }
    vector.dnit[DeclaredStepOutput](?outputs);

    outputs = vector.init[DeclaredStepOutput](?alloc);
    if (R.is_err[usize, str](vector.push[DeclaredStepOutput](?outputs, DeclaredStepOutput{path: "out/generated/file", step: "zeta"}))) { ret 1; }
    if (R.is_err[usize, str](vector.push[DeclaredStepOutput](?outputs, DeclaredStepOutput{path: "out/generated", step: "alpha"}))) { vector.dnit[DeclaredStepOutput](?outputs); ret 1; }
    val nested: R.Result[R.Void, str] = validate_declared_step_output_collisions(?alloc, ?outputs);
    if (R.is_ok[R.Void, str](nested)) { bad = true; }
    or {
        val msg: str = R.unwrap_err[R.Void, str](nested);
        if (!cfg_contains(msg, "collides")) { bad = true; }
        str_free(?alloc, msg);
    }
    vector.dnit[DeclaredStepOutput](?outputs);

    outputs = vector.init[DeclaredStepOutput](?alloc);
    if (R.is_err[usize, str](vector.push[DeclaredStepOutput](?outputs, DeclaredStepOutput{path: "out/generated/file", step: "alpha"}))) { ret 1; }
    if (R.is_err[usize, str](vector.push[DeclaredStepOutput](?outputs, DeclaredStepOutput{path: "out/generated", step: "alpha"}))) { vector.dnit[DeclaredStepOutput](?outputs); ret 1; }
    val same_step_nested: R.Result[R.Void, str] = validate_declared_step_output_collisions(?alloc, ?outputs);
    if (R.is_ok[R.Void, str](same_step_nested)) { bad = true; }
    or {
        val msg: str = R.unwrap_err[R.Void, str](same_step_nested);
        if (!cfg_contains(msg, "collides")) { bad = true; }
        str_free(?alloc, msg);
    }
    vector.dnit[DeclaredStepOutput](?outputs);

    outputs = vector.init[DeclaredStepOutput](?alloc);
    if (R.is_err[usize, str](vector.push[DeclaredStepOutput](?outputs, DeclaredStepOutput{path: "out/a", step: "alpha"}))) { ret 1; }
    if (R.is_err[usize, str](vector.push[DeclaredStepOutput](?outputs, DeclaredStepOutput{path: "out/b", step: "beta"}))) { vector.dnit[DeclaredStepOutput](?outputs); ret 1; }
    val separate: R.Result[R.Void, str] = validate_declared_step_output_collisions(?alloc, ?outputs);
    if (R.is_err[R.Void, str](separate)) { bad = true; }
    vector.dnit[DeclaredStepOutput](?outputs);
    if (bad) { ret 1; }
    ret 0;
}

test "mach.lang.driver.config.step_outputs:physical_and_declared_effects" {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "mach_step_outputs");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);
    val root_r: R.Result[str, str] = str_dup(?alloc, fs.temp_path(?tf));
    fs.temp_close_and_remove(?tf);
    if (R.is_err[str, str](root_r)) { ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);
    if (O.is_some[str](fs.create_dir(root, 0o700))) { str_free(?alloc, root); ret 1; }
    var bad: bool = false;

    val make_r: R.Result[R.Void, str] = ensure_physical_directory_path(?alloc, root, "out/declared", "build step output directory");
    if (R.is_err[R.Void, str](make_r)) { bad = true; }
    val result_file: str = sfmt(?alloc, "{}/out/result", root);
    if (O.is_some[str](fs.write_bytes(result_file, "ok", 2, 0o600))) { bad = true; }
    var declared_rel: Vector[str] = vector.init[str](?alloc);
    if (R.is_err[usize, str](vector.push[str](?declared_rel, "out/result"))) { bad = true; }
    val valid_file: R.Result[R.Void, str] = validate_declared_step_outputs(?alloc, root, ?declared_rel, "generate");
    if (R.is_err[R.Void, str](valid_file)) { bad = true; }
    vector.dnit[str](?declared_rel);

    declared_rel = vector.init[str](?alloc);
    if (R.is_err[usize, str](vector.push[str](?declared_rel, "out/missing"))) { bad = true; }
    val missing: R.Result[R.Void, str] = validate_declared_step_outputs(?alloc, root, ?declared_rel, "generate");
    if (R.is_ok[R.Void, str](missing) || !cfg_contains(R.unwrap_err[R.Void, str](missing), "did not publish")) { bad = true; }
    vector.dnit[str](?declared_rel);

    val linked_output: str = sfmt(?alloc, "{}/out/linked", root);
    if (O.is_some[str](fs.symlink(result_file, linked_output))) { bad = true; }
    or {
        declared_rel = vector.init[str](?alloc);
        if (R.is_err[usize, str](vector.push[str](?declared_rel, "out/linked"))) { bad = true; }
        val linked: R.Result[R.Void, str] = validate_declared_step_outputs(?alloc, root, ?declared_rel, "generate");
        if (R.is_ok[R.Void, str](linked) || !cfg_contains(R.unwrap_err[R.Void, str](linked), "symlink")) { bad = true; }
        vector.dnit[str](?declared_rel);
        fs.remove_file(linked_output);
    }

    val outside: str = sfmt(?alloc, "{}/outside", root);
    val bridge: str = sfmt(?alloc, "{}/out/bridge", root);
    if (O.is_some[str](fs.create_dir(outside, 0o700)) || O.is_some[str](fs.symlink(outside, bridge))) { bad = true; }
    or {
        val escaped: R.Result[R.Void, str] = ensure_physical_directory_path(?alloc, root, "out/bridge/nested", "build step output directory");
        if (R.is_ok[R.Void, str](escaped) || !cfg_contains(R.unwrap_err[R.Void, str](escaped), "symlink")) { bad = true; }
        fs.remove_file(bridge);
    }

    val output_root: str = sfmt(?alloc, "{}/out", root);
    var before: Vector[TreeFile] = vector.init[TreeFile](?alloc);
    if (R.is_err[R.Void, str](collect_tree_files(?alloc, output_root, ?before))) { bad = true; }
    val declared_file: str = sfmt(?alloc, "{}/out/declared/result", root);
    val rogue_file: str = sfmt(?alloc, "{}/out/rogue", root);
    if (O.is_some[str](fs.write_bytes(declared_file, "yes", 3, 0o600)) || O.is_some[str](fs.write_bytes(rogue_file, "no", 2, 0o600))) { bad = true; }
    var declared_abs: Vector[str] = vector.init[str](?alloc);
    val declared_dir: str = sfmt(?alloc, "{}/out/declared", root);
    if (R.is_err[usize, str](vector.push[str](?declared_abs, declared_dir))) { bad = true; }
    val effects: R.Result[R.Void, str] = check_step_output_effects(?alloc, ?before, output_root, ?declared_abs, "generate");
    if (R.is_ok[R.Void, str](effects) || !cfg_contains(R.unwrap_err[R.Void, str](effects), "rogue")) { bad = true; }
    val failed_combined: R.Result[R.Void, str] = combine_step_terminal_results(?alloc, R.ok_void[str](), effects, R.err[R.Void, str]("build step exited with code 9"));
    if (R.is_ok[R.Void, str](failed_combined) || !str_starts_with(R.unwrap_err[R.Void, str](failed_combined), "build step 'generate' created or modified undeclared output") || !cfg_contains(R.unwrap_err[R.Void, str](failed_combined), "execution outcome: build step exited with code 9")) { bad = true; }
    fs.remove_file(rogue_file);
    val allowed: R.Result[R.Void, str] = check_step_output_effects(?alloc, ?before, output_root, ?declared_abs, "generate");
    if (R.is_err[R.Void, str](allowed)) { bad = true; }

    val empty_added: str = sfmt(?alloc, "{}/out/empty-added", root);
    if (O.is_some[str](fs.create_dir(empty_added, 0o700))) { bad = true; }
    val added_dir_effect: R.Result[R.Void, str] = check_step_output_effects(?alloc, ?before, output_root, ?declared_abs, "generate");
    if (R.is_ok[R.Void, str](added_dir_effect) || !cfg_contains(R.unwrap_err[R.Void, str](added_dir_effect), "empty-added")) { bad = true; }
    fs.remove_all(?alloc, empty_added);

    val empty_removed: str = sfmt(?alloc, "{}/out/empty-removed", root);
    if (O.is_some[str](fs.create_dir(empty_removed, 0o700))) { bad = true; }
    var before_removed: Vector[TreeFile] = vector.init[TreeFile](?alloc);
    if (R.is_err[R.Void, str](collect_tree_files(?alloc, output_root, ?before_removed))) { bad = true; }
    fs.remove_all(?alloc, empty_removed);
    val removed_dir_effect: R.Result[R.Void, str] = check_step_output_effects(?alloc, ?before_removed, output_root, ?declared_abs, "generate");
    if (R.is_ok[R.Void, str](removed_dir_effect) || !cfg_contains(R.unwrap_err[R.Void, str](removed_dir_effect), "empty-removed")) { bad = true; }
    free_tree_files(?alloc, ?before_removed);

    val empty_old: str = sfmt(?alloc, "{}/out/empty-old", root);
    val empty_new: str = sfmt(?alloc, "{}/out/empty-new", root);
    if (O.is_some[str](fs.create_dir(empty_old, 0o700))) { bad = true; }
    var before_renamed: Vector[TreeFile] = vector.init[TreeFile](?alloc);
    if (R.is_err[R.Void, str](collect_tree_files(?alloc, output_root, ?before_renamed))) { bad = true; }
    if (O.is_some[str](fs.rename(empty_old, empty_new))) { bad = true; }
    val renamed_dir_effect: R.Result[R.Void, str] = check_step_output_effects(?alloc, ?before_renamed, output_root, ?declared_abs, "generate");
    if (R.is_ok[R.Void, str](renamed_dir_effect) || !cfg_contains(R.unwrap_err[R.Void, str](renamed_dir_effect), "empty-new")) { bad = true; }
    free_tree_files(?alloc, ?before_renamed);

    free_tree_files(?alloc, ?before);
    step_free_inputs(?alloc, ?declared_abs);
    str_free(?alloc, empty_new);
    str_free(?alloc, empty_old);
    str_free(?alloc, empty_removed);
    str_free(?alloc, empty_added);
    str_free(?alloc, rogue_file);
    str_free(?alloc, declared_file);
    str_free(?alloc, output_root);
    str_free(?alloc, bridge);
    str_free(?alloc, outside);
    str_free(?alloc, linked_output);
    str_free(?alloc, result_file);
    fs.remove_all(?alloc, root);
    str_free(?alloc, root);
    if (bad) { ret 1; }
    ret 0;
}

test "mach.lang.driver.config.check_step_left_obj_tree:new_file_only" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "mach_steptree_test");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);
    val dup_r: R.Result[str, str] = str_dup(?alloc, fs.temp_path(?tf));
    fs.temp_close_and_remove(?tf);
    if (R.is_err[str, str](dup_r)) { ret 1; }
    val tree: str = R.unwrap_ok[str, str](dup_r);
    if (O.is_some[str](fs.create_dir_all(?alloc, tree, 493))) { ret 1; }

    var bad: i32 = 0;

    val stale: str = sfmt(?alloc, "{}/main.o", tree);
    fs.write_bytes(stale, "x", 1::usize, 420);

    var not_dir: vector.Vector[TreeFile] = vector.init[TreeFile](?alloc);
    if (R.is_ok[R.Void, str](collect_tree_files(?alloc, stale, ?not_dir))) { bad = 1; }
    free_tree_files(?alloc, ?not_dir);

    val link: str = sfmt(?alloc, "{}/linked.o", tree);
    if (O.is_none[str](fs.symlink(stale, link))) {
        var linked_tree: vector.Vector[TreeFile] = vector.init[TreeFile](?alloc);
        if (R.is_ok[R.Void, str](collect_tree_files(?alloc, tree, ?linked_tree))) { bad = 1; }
        free_tree_files(?alloc, ?linked_tree);
        fs.remove_file(link);
    }
    str_free(?alloc, link);

    var before: vector.Vector[TreeFile] = vector.init[TreeFile](?alloc);
    if (R.is_err[R.Void, str](collect_tree_files(?alloc, tree, ?before))) { ret 1; }

    val clean: R.Result[R.Void, str] = check_step_left_obj_tree(?alloc, ?before, tree, "vendor");
    if (R.is_err[R.Void, str](clean)) { bad = 1; }

    val dropped: str = sfmt(?alloc, "{}/window.o", tree);
    fs.write_bytes(dropped, "x", 1::usize, 420);

    val dirty: R.Result[R.Void, str] = check_step_left_obj_tree(?alloc, ?before, tree, "vendor");
    if (R.is_ok[R.Void, str](dirty)) { bad = 1; }
    or {
        val msg: str = R.unwrap_err[R.Void, str](dirty);
        if (!cfg_contains(msg, "vendor"))            { bad = 1; }
        or (!cfg_contains(msg, "window.o"))          { bad = 1; }
        or (!cfg_contains(msg, "module object tree")) { bad = 1; }
    }

    val nonzero_dirty: R.Result[R.Void, str] = combine_step_terminal_results(?alloc, dirty, R.ok_void[str](), R.err[R.Void, str]("build step exited with code 7"));
    if (R.is_ok[R.Void, str](nonzero_dirty)) { bad = 1; }
    or {
        val msg: str = R.unwrap_err[R.Void, str](nonzero_dirty);
        if (!str_starts_with(msg, "build step 'vendor'") || !cfg_contains(msg, "execution outcome: build step exited with code 7")) { bad = 1; }
    }
    val signal_dirty: R.Result[R.Void, str] = combine_step_terminal_results(?alloc, dirty, R.ok_void[str](), R.err[R.Void, str]("build step terminated by signal 15"));
    if (R.is_ok[R.Void, str](signal_dirty) || !cfg_contains(R.unwrap_err[R.Void, str](signal_dirty), "execution outcome: build step terminated by signal 15")) { bad = 1; }
    val wait_dirty: R.Result[R.Void, str] = combine_step_terminal_results(?alloc, dirty, R.ok_void[str](), R.err[R.Void, str]("failed to wait for build step executable"));
    if (R.is_ok[R.Void, str](wait_dirty) || !cfg_contains(R.unwrap_err[R.Void, str](wait_dirty), "execution outcome: failed to wait")) { bad = 1; }

    free_tree_files(?alloc, ?before);
    fs.remove_file(dropped);
    var before2: vector.Vector[TreeFile] = vector.init[TreeFile](?alloc);
    if (R.is_err[R.Void, str](collect_tree_files(?alloc, tree, ?before2))) { ret 1; }
    fs.write_bytes(stale, "yy", 2::usize, 420);
    val rewritten: R.Result[R.Void, str] = check_step_left_obj_tree(?alloc, ?before2, tree, "vendor");
    if (R.is_ok[R.Void, str](rewritten)) { bad = 1; }
    or {
        val msg2: str = R.unwrap_err[R.Void, str](rewritten);
        if (!cfg_contains(msg2, "main.o")) { bad = 1; }
    }
    free_tree_files(?alloc, ?before2);
    var before_content: vector.Vector[TreeFile] = vector.init[TreeFile](?alloc);
    if (R.is_err[R.Void, str](collect_tree_files(?alloc, tree, ?before_content))) { ret 1; }
    fs.write_bytes(stale, "zz", 2::usize, 420);
    val post_write_r: R.Result[fs.Metadata, str] = fs.metadata_link(stale);
    if (R.is_err[fs.Metadata, str](post_write_r)) { ret 1; }
    val post_write: fs.Metadata = R.unwrap_ok[fs.Metadata, str](post_write_r);
    var bi: usize = 0;
    for (bi < before_content.len) {
        if (str_equals(before_content.data[bi].path, stale)) {
            before_content.data[bi].sec = post_write.modified.sec;
            before_content.data[bi].nsec = post_write.modified.nsec;
            before_content.data[bi].size = post_write.size;
        }
        bi = bi + 1;
    }
    val content_changed: R.Result[R.Void, str] = check_step_left_obj_tree(?alloc, ?before_content, tree, "vendor");
    if (R.is_ok[R.Void, str](content_changed)) { bad = 1; }
    free_tree_files(?alloc, ?before_content);
    var before3: vector.Vector[TreeFile] = vector.init[TreeFile](?alloc);
    if (R.is_err[R.Void, str](collect_tree_files(?alloc, tree, ?before3))) { ret 1; }
    fs.remove_file(stale);
    val removed: R.Result[R.Void, str] = check_step_left_obj_tree(?alloc, ?before3, tree, "vendor");
    if (R.is_ok[R.Void, str](removed)) { bad = 1; }
    or {
        val msg3: str = R.unwrap_err[R.Void, str](removed);
        if (!cfg_contains(msg3, "removed") || !cfg_contains(msg3, "main.o")) { bad = 1; }
    }
    free_tree_files(?alloc, ?before3);

    var before_added_dir: vector.Vector[TreeFile] = vector.init[TreeFile](?alloc);
    if (R.is_err[R.Void, str](collect_tree_files(?alloc, tree, ?before_added_dir))) { ret 1; }
    val empty_added: str = sfmt(?alloc, "{}/empty-added", tree);
    if (O.is_some[str](fs.create_dir(empty_added, 0o700))) { bad = 1; }
    val added_dir: R.Result[R.Void, str] = check_step_left_obj_tree(?alloc, ?before_added_dir, tree, "vendor");
    if (R.is_ok[R.Void, str](added_dir) || !cfg_contains(R.unwrap_err[R.Void, str](added_dir), "empty-added")) { bad = 1; }
    free_tree_files(?alloc, ?before_added_dir);
    fs.remove_all(?alloc, empty_added);

    val empty_removed: str = sfmt(?alloc, "{}/empty-removed", tree);
    if (O.is_some[str](fs.create_dir(empty_removed, 0o700))) { bad = 1; }
    var before_removed_dir: vector.Vector[TreeFile] = vector.init[TreeFile](?alloc);
    if (R.is_err[R.Void, str](collect_tree_files(?alloc, tree, ?before_removed_dir))) { ret 1; }
    fs.remove_all(?alloc, empty_removed);
    val removed_dir: R.Result[R.Void, str] = check_step_left_obj_tree(?alloc, ?before_removed_dir, tree, "vendor");
    if (R.is_ok[R.Void, str](removed_dir) || !cfg_contains(R.unwrap_err[R.Void, str](removed_dir), "empty-removed")) { bad = 1; }
    free_tree_files(?alloc, ?before_removed_dir);

    val empty_old: str = sfmt(?alloc, "{}/empty-old", tree);
    val empty_new: str = sfmt(?alloc, "{}/empty-new", tree);
    if (O.is_some[str](fs.create_dir(empty_old, 0o700))) { bad = 1; }
    var before_renamed_dir: vector.Vector[TreeFile] = vector.init[TreeFile](?alloc);
    if (R.is_err[R.Void, str](collect_tree_files(?alloc, tree, ?before_renamed_dir))) { ret 1; }
    if (O.is_some[str](fs.rename(empty_old, empty_new))) { bad = 1; }
    val renamed_dir: R.Result[R.Void, str] = check_step_left_obj_tree(?alloc, ?before_renamed_dir, tree, "vendor");
    if (R.is_ok[R.Void, str](renamed_dir) || !cfg_contains(R.unwrap_err[R.Void, str](renamed_dir), "empty-new")) { bad = 1; }
    free_tree_files(?alloc, ?before_renamed_dir);
    val missing_tree: str = sfmt(?alloc, "{}-new", tree);
    var before_root_dir: vector.Vector[TreeFile] = vector.init[TreeFile](?alloc);
    if (R.is_err[R.Void, str](collect_tree_files(?alloc, missing_tree, ?before_root_dir))) { ret 1; }
    if (O.is_some[str](fs.create_dir(missing_tree, 0o700))) { bad = 1; }
    val added_root: R.Result[R.Void, str] = check_step_left_obj_tree(?alloc, ?before_root_dir, missing_tree, "vendor");
    if (R.is_ok[R.Void, str](added_root) || !cfg_contains(R.unwrap_err[R.Void, str](added_root), "module object tree")) { bad = 1; }
    free_tree_files(?alloc, ?before_root_dir);
    fs.remove_all(?alloc, missing_tree);
    str_free(?alloc, missing_tree);
    str_free(?alloc, empty_new);
    str_free(?alloc, empty_old);
    str_free(?alloc, empty_removed);
    str_free(?alloc, empty_added);
    str_free(?alloc, stale);
    str_free(?alloc, dropped);
    fs.remove_all(?alloc, tree);
    ret bad;
}

fun t_digest_check(alloc: *A.Allocator, path: str, data: *u8, len: usize) bool {
    var expect: [32]u8;
    sha256.hash(data, len, ?expect[0]);
    var got: [32]u8;
    val r: R.Result[R.Void, str] = fingerprint.file_sha256(path, ?got[0]);
    if (R.is_err[R.Void, str](r)) { ret false; }
    var i: usize = 0;
    for (i < 32) {
        if (expect[i] != got[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

test "mach.lang.build.fingerprint.file_sha256:matches_the_one_shot_hash_across_chunk_boundaries" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "mach_streamdigest_test");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);
    val dup_r: R.Result[str, str] = str_dup(?alloc, fs.temp_path(?tf));
    fs.temp_close_and_remove(?tf);
    if (R.is_err[str, str](dup_r)) { ret 1; }
    val tree: str = R.unwrap_ok[str, str](dup_r);
    if (O.is_some[str](fs.create_dir_all(?alloc, tree, 493))) { ret 1; }

    var bad: i32 = 0;

    val empty_path: str = sfmt(?alloc, "{}/empty", tree);
    fs.write_bytes(empty_path, "", 0::usize, 420);
    var empty_byte: u8 = 0;
    if (!t_digest_check(?alloc, empty_path, ?empty_byte, 0::usize)) { bad = 1; }

    val exact_path: str = sfmt(?alloc, "{}/exact", tree);
    val exact_r: R.Result[*u8, str] = A.allocate[u8](?alloc, fingerprint.FILE_DIGEST_CHUNK);
    if (R.is_err[*u8, str](exact_r)) { ret 1; }
    val exact_buf: *u8 = R.unwrap_ok[*u8, str](exact_r);
    var i: usize = 0;
    for (i < fingerprint.FILE_DIGEST_CHUNK) { exact_buf[i] = (i % 251)::u8; i = i + 1; }
    fs.write_bytes(exact_path, exact_buf, fingerprint.FILE_DIGEST_CHUNK, 420);
    if (!t_digest_check(?alloc, exact_path, exact_buf, fingerprint.FILE_DIGEST_CHUNK)) { bad = 1; }
    A.deallocate[u8](?alloc, exact_buf, fingerprint.FILE_DIGEST_CHUNK);

    val multi_path: str = sfmt(?alloc, "{}/multi", tree);
    val multi_len: usize = fingerprint.FILE_DIGEST_CHUNK * 3 + 17;
    val multi_r: R.Result[*u8, str] = A.allocate[u8](?alloc, multi_len);
    if (R.is_err[*u8, str](multi_r)) { ret 1; }
    val multi_buf: *u8 = R.unwrap_ok[*u8, str](multi_r);
    i = 0;
    for (i < multi_len) { multi_buf[i] = (i % 197)::u8; i = i + 1; }
    fs.write_bytes(multi_path, multi_buf, multi_len, 420);
    if (!t_digest_check(?alloc, multi_path, multi_buf, multi_len)) { bad = 1; }
    A.deallocate[u8](?alloc, multi_buf, multi_len);

    str_free(?alloc, empty_path);
    str_free(?alloc, exact_path);
    str_free(?alloc, multi_path);
    fs.remove_all(?alloc, tree);
    ret bad;
}

test "mach.lang.driver.config.absolute_execution_root:relative_becomes_cwd_anchored" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    var bad: bool = false;
    val abs_r: R.Result[str, str] = absolute_execution_root(?alloc, "/already/abs");
    if (R.is_err[str, str](abs_r)) { bad = true; }
    or {
        val kept: str = R.unwrap_ok[str, str](abs_r);
        if (!str_equals(kept, "/already/abs")) { bad = true; }
        str_free(?alloc, kept);
    }
    val rel_r: R.Result[str, str] = absolute_execution_root(?alloc, ".");
    if (R.is_err[str, str](rel_r)) { bad = true; }
    or {
        val anchored: str = R.unwrap_ok[str, str](rel_r);
        if (!spath.is_abs(anchored)) { bad = true; }
        val cwd_r: R.Result[str, str] = env.current_dir(?alloc);
        if (R.is_err[str, str](cwd_r)) { bad = true; }
        or {
            val cwd: str = R.unwrap_ok[str, str](cwd_r);
            if (!str_equals(anchored, cwd)) { bad = true; }
            str_free(?alloc, cwd);
        }
        str_free(?alloc, anchored);
    }
    if (bad) { ret 1; }
    ret 0;
}

test "mach.lang.driver.config.resolve_step_path:root_and_dep_two_root" {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    var bad: bool = false;
    var v: manifest.TmplVars = manifest.TmplVars{target: "t", isa: "x86_64", os: "linux", abi: "gnu", profile: "debug", reqs: nil, req_count: 0};

    val root_exec: str = "/proj";
    val root_out: str = "/proj/out";
    val ordinary_r: R.Result[StepPath, str] = resolve_step_path(?alloc, "src/gen.c", root_out, ?v, root_exec, root_out, "a build step input", true);
    if (R.is_err[StepPath, str](ordinary_r)) { bad = true; }
    or {
        var sp: StepPath = R.unwrap_ok[StepPath, str](ordinary_r);
        if (!str_equals(sp.root, root_exec) || !str_equals(sp.rel, "src/gen.c") || !str_equals(sp.abs, "/proj/src/gen.c")) { bad = true; }
        step_path_free(?alloc, ?sp);
    }

    val marker_r: R.Result[StepPath, str] = resolve_step_path(?alloc, "{project.out}/gen.c", root_out, ?v, root_exec, root_out, "a build step output", false);
    if (R.is_err[StepPath, str](marker_r)) { bad = true; }
    or {
        var sp2: StepPath = R.unwrap_ok[StepPath, str](marker_r);
        if (!str_equals(sp2.root, root_out) || !str_equals(sp2.rel, "gen.c") || !str_equals(sp2.abs, "/proj/out/gen.c")) { bad = true; }
        step_path_free(?alloc, ?sp2);
    }

    val dep_exec: str = "/vendor/dep";
    val dep_out: str = "/home/user/proj/out";
    val dep_in_r: R.Result[StepPath, str] = resolve_step_path(?alloc, "build.sh", dep_out, ?v, dep_exec, dep_out, "a build step input", true);
    if (R.is_err[StepPath, str](dep_in_r)) { bad = true; }
    or {
        var sp3: StepPath = R.unwrap_ok[StepPath, str](dep_in_r);
        if (!str_equals(sp3.root, dep_exec) || !str_equals(sp3.rel, "build.sh") || !str_equals(sp3.abs, "/vendor/dep/build.sh")) { bad = true; }
        step_path_free(?alloc, ?sp3);
    }

    val dep_out_r: R.Result[StepPath, str] = resolve_step_path(?alloc, "{project.out}/vendor/dep/out.o", dep_out, ?v, dep_exec, dep_out, "a build step output", false);
    if (R.is_err[StepPath, str](dep_out_r)) { bad = true; }
    or {
        var sp4: StepPath = R.unwrap_ok[StepPath, str](dep_out_r);
        if (!str_equals(sp4.root, dep_out) || !str_equals(sp4.rel, "vendor/dep/out.o") || !str_equals(sp4.abs, "/home/user/proj/out/vendor/dep/out.o")) { bad = true; }
        step_path_free(?alloc, ?sp4);
    }

    if (bad) { ret 1; }
    ret 0;
}

test "mach.lang.driver.config.resolve_step_path:escapes_and_malformed_markers" {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    var bad: bool = false;
    var v: manifest.TmplVars = manifest.TmplVars{target: "t", isa: "x86_64", os: "linux", abi: "gnu", profile: "debug", reqs: nil, req_count: 0};
    val exec_root: str = "/proj";
    val out_root: str = "/proj/out";

    val parent_r: R.Result[StepPath, str] = resolve_step_path(?alloc, "../../etc/passwd", out_root, ?v, exec_root, out_root, "a build step input", true);
    if (R.is_ok[StepPath, str](parent_r)) { bad = true; }

    val marker_parent_r: R.Result[StepPath, str] = resolve_step_path(?alloc, "{project.out}/../../escape", out_root, ?v, exec_root, out_root, "a build step input", true);
    if (R.is_ok[StepPath, str](marker_parent_r)) { bad = true; }

    val no_sep_r: R.Result[StepPath, str] = resolve_step_path(?alloc, "{project.out}x", out_root, ?v, exec_root, out_root, "a build step input", true);
    if (R.is_ok[StepPath, str](no_sep_r)) { bad = true; }

    val mid_string_r: R.Result[StepPath, str] = resolve_step_path(?alloc, "foo/{project.out}/bar", out_root, ?v, exec_root, out_root, "a build step input", true);
    if (R.is_ok[StepPath, str](mid_string_r)) { bad = true; }

    val root_disallowed_r: R.Result[StepPath, str] = resolve_step_path(?alloc, "{project.out}", out_root, ?v, exec_root, out_root, "a build step output", false);
    if (R.is_ok[StepPath, str](root_disallowed_r)) { bad = true; }

    val root_allowed_r: R.Result[StepPath, str] = resolve_step_path(?alloc, "{project.out}", out_root, ?v, exec_root, out_root, "a build step input", true);
    if (R.is_err[StepPath, str](root_allowed_r)) { bad = true; }
    or {
        var sp: StepPath = R.unwrap_ok[StepPath, str](root_allowed_r);
        if (!str_equals(sp.root, out_root) || !str_equals(sp.rel, ".") || !str_equals(sp.abs, out_root)) { bad = true; }
        step_path_free(?alloc, ?sp);
    }

    if (bad) { ret 1; }
    ret 0;
}

test "mach.lang.driver.config.absolute_path_in_root:sibling_prefix_and_equal_root" {
    var bad: bool = false;
    if (absolute_path_in_root("/home/user/proj/out-sibling/x", "/home/user/proj/out", false)) { bad = true; }
    if (absolute_path_in_root("/home/user/proj/out-sibling", "/home/user/proj/out", true)) { bad = true; }
    if (!absolute_path_in_root("/home/user/proj/out/x", "/home/user/proj/out", false)) { bad = true; }
    if (absolute_path_in_root("/home/user/proj/out", "/home/user/proj/out", false)) { bad = true; }
    if (!absolute_path_in_root("/home/user/proj/out", "/home/user/proj/out", true)) { bad = true; }
    if (absolute_path_in_root("out/x", "/home/user/proj/out", true)) { bad = true; }
    if (bad) { ret 1; }
    ret 0;
}

test "mach.lang.driver.config.resolve_step_path:prior_output_consumed_as_input" {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    var bad: bool = false;

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "mach_step_two_root");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);
    val root_r: R.Result[str, str] = str_dup(?alloc, fs.temp_path(?tf));
    fs.temp_close_and_remove(?tf);
    if (R.is_err[str, str](root_r)) { ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);
    if (O.is_some[str](fs.create_dir(root, 0o700))) { str_free(?alloc, root); ret 1; }

    val exec_root: str = sfmt(?alloc, "{}/dep", root);
    val out_root: str = sfmt(?alloc, "{}/out", root);
    if (O.is_some[str](fs.create_dir(exec_root, 0o700)) || O.is_some[str](fs.create_dir(out_root, 0o700))) { bad = true; }

    val generated: str = sfmt(?alloc, "{}/generated.txt", out_root);
    if (O.is_some[str](fs.write_bytes(generated, "ok", 2, 0o600))) { bad = true; }

    var v: manifest.TmplVars = manifest.TmplVars{target: "t", isa: "x86_64", os: "linux", abi: "gnu", profile: "debug", reqs: nil, req_count: 0};
    val sp_r: R.Result[StepPath, str] = resolve_step_path(?alloc, "{project.out}/generated.txt", out_root, ?v, exec_root, out_root, "a build step input", true);
    if (R.is_err[StepPath, str](sp_r)) { bad = true; }
    or {
        var sp: StepPath = R.unwrap_ok[StepPath, str](sp_r);
        if (!str_equals(sp.abs, generated)) { bad = true; }
        val physical_r: R.Result[R.Void, str] = validate_physical_path(?alloc, sp.root, sp.rel, PHYSICAL_REGULAR, "build step input");
        if (R.is_err[R.Void, str](physical_r)) { bad = true; }
        step_path_free(?alloc, ?sp);
    }

    val missing_r: R.Result[StepPath, str] = resolve_step_path(?alloc, "{project.out}/missing.txt", out_root, ?v, exec_root, out_root, "a build step input", true);
    if (R.is_err[StepPath, str](missing_r)) { bad = true; }
    or {
        var sp2: StepPath = R.unwrap_ok[StepPath, str](missing_r);
        val missing_physical_r: R.Result[R.Void, str] = validate_physical_path(?alloc, sp2.root, sp2.rel, PHYSICAL_REGULAR, "build step input");
        if (R.is_ok[R.Void, str](missing_physical_r)) { bad = true; }
        step_path_free(?alloc, ?sp2);
    }

    str_free(?alloc, generated);
    str_free(?alloc, out_root);
    str_free(?alloc, exec_root);
    fs.remove_all(?alloc, root);
    str_free(?alloc, root);
    if (bad) { ret 1; }
    ret 0;
}

fun t_temp_project(a: *A.Allocator, prefix: str, toml_body: str) R.Result[str, str] {
    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(a, prefix);
    if (R.is_err[fs.TempFile, str](tf_r)) { ret R.err[str, str](R.unwrap_err[fs.TempFile, str](tf_r)); }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);
    val root: str = fs.temp_path(?tf);
    fs.temp_close_and_remove(?tf);
    if (O.is_some[str](fs.create_dir_all(a, root, 0o755))) { ret R.err[str, str]("could not create temp project dir"); }

    val toml_path_r: R.Result[str, str] = load.join_path(a, root, "mach.toml");
    if (R.is_err[str, str](toml_path_r)) { ret toml_path_r; }
    val toml_path: str = R.unwrap_ok[str, str](toml_path_r);
    if (O.is_some[str](fs.write_bytes(toml_path, toml_body::*u8, str_len(toml_body), 0o644))) {
        ret R.err[str, str]("could not write mach.toml");
    }
    ret R.ok[str, str](root);
}

test "mach.lang.driver.config.resolve_run_artifact:rejects_library_selection" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }

    val body: str = "[project]\nid = \"libonly\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out\"\n\n[artifact.libonly]\nkind = \"static\"\nentry = \"src/lib.mach\"\nout = \"lib/libonly.a\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
    val root_r: R.Result[str, str] = t_temp_project(?alloc, "mach_run_artifact_lib", body);
    if (R.is_err[str, str](root_r)) { ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);

    var sel: manifest.Selection = manifest.Selection{target: "", profile: "", artifact: "", want_lib: false, has_artifact: false};
    val rr: R.Result[RunArtifact, str] = resolve_run_artifact(?alloc, root, ?sel, nil);

    var bad: i32 = 0;
    if (R.is_ok[RunArtifact, str](rr)) { bad = 1; }
    or {
        if (!str_contains(R.unwrap_err[RunArtifact, str](rr), "library")) { bad = 1; }
    }

    fs.remove_all(?alloc, root);
    ret bad;
}

test "mach.lang.driver.config.resolve_run_artifact:o_override_resolves_relative_and_absolute" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }

    val body: str = "[project]\nid = \"runbin\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out\"\n\n[artifact.runbin]\nkind = \"bin\"\nentry = \"src/main.mach\"\nout = \"bin/runbin\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
    val root_r: R.Result[str, str] = t_temp_project(?alloc, "mach_run_artifact_o", body);
    if (R.is_err[str, str](root_r)) { ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);

    var bad: i32 = 0;

    var sel_default: manifest.Selection = manifest.Selection{target: "", profile: "", artifact: "", want_lib: false, has_artifact: false};
    val default_r: R.Result[RunArtifact, str] = resolve_run_artifact(?alloc, root, ?sel_default, nil);
    if (R.is_err[RunArtifact, str](default_r)) { bad = 1; }
    or {
        val ra: RunArtifact = R.unwrap_ok[RunArtifact, str](default_r);
        if (!str_equals(ra.path, sfmt(?alloc, "{}/out/bin/runbin", root))) { bad = 1; }
        if (!ra.host_runnable) { bad = 1; }
    }

    var sel_rel: manifest.Selection = manifest.Selection{target: "", profile: "", artifact: "", want_lib: false, has_artifact: false};
    val rel_r: R.Result[RunArtifact, str] = resolve_run_artifact(?alloc, root, ?sel_rel, "custom/copy");
    if (R.is_err[RunArtifact, str](rel_r)) { bad = 1; }
    or {
        val ra: RunArtifact = R.unwrap_ok[RunArtifact, str](rel_r);
        if (!str_equals(ra.path, sfmt(?alloc, "{}/custom/copy", root))) { bad = 1; }
    }

    var sel_abs: manifest.Selection = manifest.Selection{target: "", profile: "", artifact: "", want_lib: false, has_artifact: false};
    val abs_r: R.Result[RunArtifact, str] = resolve_run_artifact(?alloc, root, ?sel_abs, "/tmp/somewhere/else");
    if (R.is_err[RunArtifact, str](abs_r)) { bad = 1; }
    or {
        val ra: RunArtifact = R.unwrap_ok[RunArtifact, str](abs_r);
        if (!str_equals(ra.path, "/tmp/somewhere/else")) { bad = 1; }
    }

    var sel_empty: manifest.Selection = manifest.Selection{target: "", profile: "", artifact: "", want_lib: false, has_artifact: false};
    val empty_r: R.Result[RunArtifact, str] = resolve_run_artifact(?alloc, root, ?sel_empty, "");
    if (R.is_ok[RunArtifact, str](empty_r)) { bad = 1; }

    fs.remove_all(?alloc, root);
    ret bad;
}

test "mach.lang.driver.config.resolve_run_artifact:host_runnable_reflects_the_resolved_target" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }

    val host_body: str = "[project]\nid = \"hostrun\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out\"\n\n[artifact.hostrun]\nkind = \"bin\"\nentry = \"src/main.mach\"\nout = \"bin/hostrun\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
    val host_root_r: R.Result[str, str] = t_temp_project(?alloc, "mach_run_artifact_host", host_body);
