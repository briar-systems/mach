# a module's lowered surface: its source text without the bodies no importer
# compiles, which are the bodies of test declarations and of functions that
# are neither generic nor take a comptime parameter. what remains is every
# declaration an importer reads, and every body an importer instantiates.
# the in-process lowered-surface query and the persistent cache key read it
use mach.lang.fail;
use dq: mach.lang.driver.query;
use mach.lang.fe.ast;
use mach.lang.fe.ast.decl;
use mach.lang.fe.ast.id;
use mach.lang.fe.ast.module;
use mach.lang.fe.ast.stmt;
use mach.lang.fe.token;
use A: std.allocator;
use std.collections.vector;
use std.collections.vector.Vector;
use std.crypto.hash.sha256;
use std.types.bool.bool;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

# the omitted bodies of `a`, in source order
pub fun omitted(a: *ast.Ast, text: str, out: *Vector[token.Span]) err[fail.Fail] {
    val m_opt: opt[*module.Module] = ast.get_module(a, a.root_module);
    if (sel m_opt.none) { ret err[fail.Fail].ok{}; }
    val mod_node: *module.Module = m_opt.some;
    var cursor:   usize          = 0;
    var i:        u32            = 0;
    for (i < mod_node.decls_len) {
        val did: id.DeclId      = a.decl_ids[mod_node.decls_start + i];
        val w:   err[fail.Fail] = omitted_in_decl(a, text, did, ?cursor, out);
        if (sel w.err) { ret w; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun omitted_in_decl(a: *ast.Ast, text: str, did: id.DeclId, cursor: *usize, out: *Vector[token.Span]) err[fail.Fail] {
    val d_opt: opt[*decl.Decl] = ast.get_decl(a, did);
    if (sel d_opt.none) {
        ret err[fail.Fail].err{fail.message("lowered surface: declaration id out of range")};
    }
    val d: *decl.Decl = d_opt.some;

    val bs_o: opt[token.Span] = omitted_body_span(a, d);
    if (sel bs_o.some) {
        val bs: token.Span = bs_o.some;
        if (bs.offset < @cursor || bs.offset + bs.len > str_len(text)) {
            ret err[fail.Fail].err{fail.message("lowered surface: declaration body spans overlap")};
        }
        val pushed: res[usize, A.Error] = vector.push[token.Span](out, bs);
        if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
        @cursor = bs.offset + bs.len;
        ret err[fail.Fail].ok{};
    }

    if (d.kind != decl.DECL_KIND_COMPTIME_IF) { ret err[fail.Fail].ok{}; }
    var bi: u32 = 0;
    for (bi < d.data.comptime_if.branches_len) {
        val branch_ix: u32 = d.data.comptime_if.branches_start + bi;
        if (branch_ix::usize >= a.comptime_branch_len) {
            ret err[fail.Fail].err{fail.message("lowered surface: comptime branch index out of range")};
        }
        val branch: *decl.ComptimeBranch = ?a.comptime_branches[branch_ix];
        var di:     u32                  = 0;
        for (di < branch.body_len) {
            val pool_ix: u32 = branch.body_start + di;
            if (pool_ix::usize >= a.decl_id_len) {
                ret err[fail.Fail].err{fail.message("lowered surface: comptime declaration index out of range")};
            }
            val w: err[fail.Fail] = omitted_in_decl(a, text, a.decl_ids[pool_ix], cursor, out);
            if (sel w.err) { ret w; }
            di = di + 1;
        }
        bi = bi + 1;
    }
    ret err[fail.Fail].ok{};
}

fun omitted_body_span(a: *ast.Ast, d: *decl.Decl) opt[token.Span] {
    var body: id.StmtId = id.STMT_NIL;
    if (d.kind == decl.DECL_KIND_TEST) {
        body = d.data.test_.body;
    }
    or (d.kind == decl.DECL_KIND_FUN) {
        if (d.data.fun_.generics_len > 0) { ret opt[token.Span].none{}; }
        var pi: u32 = 0;
        for (pi < d.data.fun_.params_len) {
            if (a.typed_names[d.data.fun_.params_start + pi].comptime) { ret opt[token.Span].none{}; }
            pi = pi + 1;
        }
        body = d.data.fun_.body;
    }
    if (body == id.STMT_NIL) { ret opt[token.Span].none{}; }

    val st_o: opt[*stmt.Stmt] = ast.get_stmt(a, body);
    if (sel st_o.none) { ret opt[token.Span].none{}; }
    ret opt[token.Span].some{st_o.some.span};
}

# the surface's bytes: the text with every omitted span removed
pub fun write(fb: *dq.FpBuf, text: str, spans: *Vector[token.Span]) err[fail.Fail] {
    val base:   *u8   = text::*u8;
    var cursor: usize = 0;
    var i:      usize = 0;
    for (i < spans.len) {
        val s: token.Span     = spans.data[i];
        val w: err[fail.Fail] = dq.fp_bytes(fb, ?base[cursor], (s.offset - cursor)::u32);
        if (sel w.err) { ret w; }
        cursor = s.offset + s.len;
        i      = i + 1;
    }
    ret dq.fp_bytes(fb, ?base[cursor], (str_len(text) - cursor)::u32);
}

fun hash_u64(st: *sha256.State, v: u64) {
    var wire: [8]u8;
    var i:    usize = 0;
    for (i < 8) {
        wire[i] = (v >> (i * 8))::u8;
        i       = i + 1;
    }
    sha256.update(st, ?wire[0], 8);
}

# the digest of the surface. `placed` also takes each omitted span's line
# count and the length of its last line, so the digest moves whenever a
# retained declaration moves to another line or column: debug information an
# importer generates from a retained body names where that body is
pub fun digest(text: str, spans: *Vector[token.Span], placed: bool, out: *[32]u8) {
    var st:     sha256.State = sha256.init();
    val base:   *u8          = text::*u8;
    var cursor: usize        = 0;
    var i:      usize        = 0;
    for (i < spans.len) {
        val s: token.Span = spans.data[i];
        hash_u64(?st, (s.offset - cursor)::u64);
        if (s.offset > cursor) { sha256.update(?st, ?base[cursor], s.offset - cursor); }
        if (placed) {
            var lines: u64   = 0;
            var tail:  u64   = 0;
            var k:     usize = s.offset;
            for (k < s.offset + s.len) {
                if (base[k] == '\n') {
                    lines = lines + 1;
                    tail  = 0;
                }
                or { tail = tail + 1; }
                k = k + 1;
            }
            hash_u64(?st, lines);
            hash_u64(?st, tail);
        }
        cursor = s.offset + s.len;
        i      = i + 1;
    }
    val total: usize = str_len(text);
    hash_u64(?st, (total - cursor)::u64);
    if (total > cursor) { sha256.update(?st, ?base[cursor], total - cursor); }
    sha256.final(?st, ?(@out)[0]);
}
