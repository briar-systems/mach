# what of a module's source text a reader of it depends on, as the spans a walk of its syntax
# omits. an importer's object holds none of the module's function bodies: its code calls them,
# and an instance's code lives in its unit, so an importer reads the text without any function
# or test body. an instance reads its declaring module's template text: the text without the
# bodies of tests and of functions that are not templates (generic, comptime-parameter or pack,
# growth.fun_is_template), since the instance is that body typed. the same walk also finds a
# module's test declarations, which only its test object compiles, so its normal object is keyed
# without them
use diagnostic_kind: mach.lang.diagnostic.kind;
use crypto.hash.sha256;
use mach.lang.fail;
use mach.lang.fe.ast;
use ast_decl:   mach.lang.fe.ast.decl;
use ast_id:     mach.lang.fe.ast.id;
use ast_module: mach.lang.fe.ast.module;
use ast_stmt:   mach.lang.fe.ast.stmt;
use mach.lang.fe.sema.growth;
use lang_source: mach.lang.source;
use mach.lang.stack;
use A:                  std.allocator;
use collections_vector: std.collections.vector;
use std.collections.vector.Vector;
use std.types.bool.bool;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

# what a walk omits: every function and test body, the bodies of tests and of functions that
# are not templates, or the test declarations
def Omission: u8;

val OMIT_BODIES: Omission = 0;
val OMIT_PLAIN:  Omission = 1;
val OMIT_TESTS:  Omission = 2;

# every function and test body of `a`, in source order: what its importers do not read
pub fun bodies(a: *ast.Ast, text: str, out: *Vector[lang_source.Span]) err[fail.Fail] {
    ret omitted_by(a, text, OMIT_BODIES, out);
}

# the bodies of `a`'s tests and of its functions that are not templates, in source order: what
# an instance of one of its templates does not read
pub fun plain_bodies(a: *ast.Ast, text: str, out: *Vector[lang_source.Span]) err[fail.Fail] {
    ret omitted_by(a, text, OMIT_PLAIN, out);
}

# the test declarations of `a`, whole, in source order
pub fun tests(a: *ast.Ast, text: str, out: *Vector[lang_source.Span]) err[fail.Fail] {
    ret omitted_by(a, text, OMIT_TESTS, out);
}

fun omitted_by(a: *ast.Ast, text: str, what: Omission, out: *Vector[lang_source.Span]) err[fail.Fail] {
    val opt_module: opt[*ast_module.Module] = ast.get_module(a, a.root_module);
    if (sel opt_module.none) { ret err[fail.Fail].ok{}; }
    val mod_node: *ast_module.Module = opt_module.some;
    val length:   usize              = str_len(text);
    var cursor:   usize              = 0;
    var i:        u32                = 0;
    for (i < mod_node.decls_len) {
        val did:                 ast_id.DeclId  = a.decl_ids.data[mod_node.decls_start + i];
        val err_omitted_in_decl: err[fail.Fail] = omitted_in_decl(a, length, what, did, ?cursor, out);
        if (sel err_omitted_in_decl.err) { ret err_omitted_in_decl; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# the walk recurses as deep as declaring chains nest, so it asks for stack before it
# descends and refuses the declaration it stands on, which the caller places in its file
fun nesting() fail.Fail {
    ret fail.user(diagnostic_kind.SYNTAX_NESTING_DEPTH, "input nests deeper than reading a module's surface descends; the stack has no room left to go deeper");
}

# length: the bytes of the module's text, read once by the caller
fun omitted_in_decl(a: *ast.Ast, length: usize, what: Omission, did: ast_id.DeclId, cursor: *usize, out: *Vector[lang_source.Span]) err[fail.Fail] {
    val opt_decl: opt[*ast_decl.Decl] = ast.get_decl(a, did);
    if (sel opt_decl.none) {
        ret err[fail.Fail].err{fail.message("lowered surface: declaration id out of range")};
    }
    val d: *ast_decl.Decl = opt_decl.some;
    if (stack.exhausted()) { ret err[fail.Fail].err{fail.spanned(nesting(), d.span)}; }

    var opt_omitted_body_span: opt[lang_source.Span] = opt[lang_source.Span].none{};
    if (what != OMIT_TESTS)                { opt_omitted_body_span = omitted_body_span(a, d, what); }
    or (d.kind == ast_decl.DECL_KIND_TEST) { opt_omitted_body_span = opt[lang_source.Span].some{d.span}; }
    if (sel opt_omitted_body_span.some) {
        val bs: lang_source.Span = opt_omitted_body_span.some;
        if (bs.offset < @cursor || bs.offset + bs.len > length) {
            ret err[fail.Fail].err{fail.message("lowered surface: declaration body spans overlap")};
        }
        val res_pushed: res[usize, A.Error] = collections_vector.push[lang_source.Span](out, bs);
        if (sel res_pushed.err) { ret err[fail.Fail].err{fail.refused(res_pushed.err)}; }
        @cursor = bs.offset + bs.len;
        ret err[fail.Fail].ok{};
    }

    if (d.kind != ast_decl.DECL_KIND_COMPTIME_IF) { ret err[fail.Fail].ok{}; }
    var bi: u32 = 0;
    for (bi < d.data.comptime_if.branches_len) {
        val branch_ix: u32 = d.data.comptime_if.branches_start + bi;
        if (branch_ix::usize >= a.comptime_branches.len) {
            ret err[fail.Fail].err{fail.message("lowered surface: comptime branch index out of range")};
        }
        val branch: *ast_decl.ComptimeBranch = ?a.comptime_branches.data[branch_ix];
        var di:     u32                      = 0;
        for (di < branch.body_len) {
            val pool_ix: u32 = branch.body_start + di;
            if (pool_ix::usize >= a.decl_ids.len) {
                ret err[fail.Fail].err{fail.message("lowered surface: comptime declaration index out of range")};
            }
            val err_omitted_in_decl: err[fail.Fail] = omitted_in_decl(a, length, what, a.decl_ids.data[pool_ix], cursor, out);
            if (sel err_omitted_in_decl.err) { ret err_omitted_in_decl; }
            di = di + 1;
        }
        bi = bi + 1;
    }
    ret err[fail.Fail].ok{};
}

fun omitted_body_span(a: *ast.Ast, d: *ast_decl.Decl, what: Omission) opt[lang_source.Span] {
    var body: ast_id.StmtId = ast_id.STMT_NIL;
    if (d.kind == ast_decl.DECL_KIND_TEST) {
        body = d.data.test_.body;
    }
    or (d.kind == ast_decl.DECL_KIND_FUN) {
        if (what == OMIT_PLAIN && growth.fun_is_template(a, d)) { ret opt[lang_source.Span].none{}; }
        body = d.data.fun_.body;
    }
    if (ast_id.stmt_is_nil(body)) { ret opt[lang_source.Span].none{}; }

    val opt_stmt: opt[*ast_stmt.Stmt] = ast.get_stmt(a, body);
    if (sel opt_stmt.none) { ret opt[lang_source.Span].none{}; }
    ret opt[lang_source.Span].some{opt_stmt.some.span};
}

fun hash_u64(st: *sha256.State, v: u64) {
    var word: [8]u8;
    var i:    usize = 0;
    for (i < 8) {
        word[i] = (v >> (i * 8))::u8;
        i       = i + 1;
    }
    sha256.update(st, ?word[0], 8);
}

# the digest of the text without `spans`. `placed` also takes each omitted span's line count and
# the length of its last line, so the digest moves whenever retained text moves to another line
# or column: debug information an object generates from a retained body names where it is
pub fun digest(text: str, spans: *Vector[lang_source.Span], placed: bool, out: *[32]u8) {
    var st:     sha256.State = sha256.make();
    val base:   *u8          = text::*u8;
    var cursor: usize        = 0;
    var i:      usize        = 0;
    for (i < spans.len) {
        val s: lang_source.Span = spans.data[i];
        hash_u64(?st, (s.offset - cursor)::u64);
        if (s.offset > cursor) { sha256.update(?st, ?base[cursor], s.offset - cursor); }
        if (placed) {
            var lines: u64   = 0;
            var tail:  u64   = 0;
            var k:     usize = s.offset;
            for (k < s.offset + s.len) {
                if (base[k] == '\n') {
                    lines = lines + 1;
                    tail  = 0;
                }
                or { tail = tail + 1; }
                k = k + 1;
            }
            hash_u64(?st, lines);
            hash_u64(?st, tail);
        }
        cursor = s.offset + s.len;
        i      = i + 1;
    }
    val total: usize = str_len(text);
    hash_u64(?st, (total - cursor)::u64);
    if (total > cursor) { sha256.update(?st, ?base[cursor], total - cursor); }
    sha256.final(?st, ?(@out)[0]);
}
