use std_format: std.format;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;

use mach.lang.diagnostic;
use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.fail;
use fe_load: mach.lang.fe.load;
use mach.lang.growth;
use mach.lang.intern;
use mach.lang.manifest;
use mach.lang.module;
use lang_target:  mach.lang.target;
use catalog_arch: mach.lang.target.catalog.arch;
use catalog_os:   mach.lang.target.catalog.os;

use mach.lang.driver.project;
use mach.lang.driver.toolchain;
use mach.lang.target.resolved;

fun warn_union_target_skipped(p: *project.Project, os_name: str, isa_name: str, why: str) {
    val res_msg: res[str, std_format.FormatError] = std_format.sprint(p.alloc, "target '{}-{}' is not supported by this build; skipped in multi-target analysis: {}", os_name, isa_name, why);
    if (sel res_msg.err) { ret; }
    val buf: str = res_msg.ok;

    diagnostic.record_unlocated(?p.diags, diagnostic_kind.TARGET_SKIPPED, buf);

    str_free(p.alloc, buf);
}

pub fun populate_union_tuples(p: *project.Project, m: *manifest.Manifest) err[fail.Fail] {
    val toolchain_r: res[*lang_target.TargetRegistry, fail.Fail] = toolchain.registry();
    if (sel toolchain_r.err) { ret err[fail.Fail].err{toolchain_r.err}; }
    val toolchain: *lang_target.TargetRegistry = toolchain_r.ok;
    val n:         u32                         = m.target_count;
    if (n == 0) { ret err[fail.Fail].ok{}; }
    val tr: res[*fe_load.Tuple, A.Error] = A.allocate[fe_load.Tuple](p.alloc, n::usize);
    if (sel tr.err) { ret err[fail.Fail].err{fail.refused(tr.err)}; }
    val tuples: *fe_load.Tuple = tr.ok;
    var k:      u32            = 0;
    var fill:   u32            = 0;
    for (k < n) {
        val td:       *manifest.TargetDef                 = ?m.targets[k];
        val os_name:  str                                 = intern.text(?p.s.interner, td.sys);
        val isa_name: str                                 = intern.text(?p.s.interner, td.arch);
        val abi_name: str                                 = intern.text(?p.s.interner, td.abi);
        val os_id:    u32                                 = catalog_os.id_for(os_name);
        val arch_id:  u32                                 = catalog_arch.id_for(isa_name);
        val sr:       res[lang_target.Binding, fail.Fail] = manifest.resolve_declared(p.s.alloc, ?p.s.interner, toolchain, td);
        if (sel sr.err) {
            warn_union_target_skipped(p, os_name, isa_name, fail.describe(sr.err));
        }
        if (sel sr.ok) {
            val selected: lang_target.Binding = sr.ok;
            tuples[fill].target         = resolved.facts(?selected.target);
            tuples[fill].target.os_id   = os_id;
            tuples[fill].target.arch_id = arch_id;
            tuples[fill].os_name        = td.sys;
            tuples[fill].isa_name       = td.arch;
            tuples[fill].abi_name       = td.abi;
            tuples[fill].platform_name  = td.platform;
            fill                        = fill + 1;
        }
        k = k + 1;
    }
    fe_load.tuples_set(?p.loader, tuples, fill, n);
    ret err[fail.Fail].ok{};
}

# the artifact entries of this project, split by whether the selected target builds them:
# an artifact this target does not declare is another target's, and the modules only it
# reaches are not this build's to compile. each entry carries its artifact, the one the
# modules its walk first reaches are attributed to; two artifacts sharing an entry keep
# the first in manifest order
pub fun populate_union_entries(p: *project.Project, m: *manifest.Manifest) err[fail.Fail] {
    if (m.artifact_count == 0) { ret err[fail.Fail].ok{}; }

    var cap: u32 = m.artifact_count;

    val er: res[*project.ArtifactEntry, A.Error] = A.allocate[project.ArtifactEntry](p.alloc, cap::usize);
    if (sel er.err) { ret err[fail.Fail].err{fail.refused(er.err)}; }
    val entries:        *project.ArtifactEntry = er.ok;
    var entries_handed: bool                   = false;
    fin {
        if (!entries_handed) { A.deallocate[project.ArtifactEntry](p.alloc, entries, cap::usize); }
    }

    val fr: res[*project.ArtifactEntry, A.Error] = A.allocate[project.ArtifactEntry](p.alloc, cap::usize);
    if (sel fr.err) { ret err[fail.Fail].err{fail.refused(fr.err)}; }
    val foreign:        *project.ArtifactEntry = fr.ok;
    var foreign_handed: bool                   = false;
    fin {
        if (!foreign_handed) { A.deallocate[project.ArtifactEntry](p.alloc, foreign, cap::usize); }
    }

    val id_opt: opt[str] = intern.get(?p.s.interner, p.config.id);
    if (sel id_opt.none) { ret err[fail.Fail].err{fail.message("internal: union project id not interned")}; }
    val id_text: str = id_opt.some;

    var selected: intern.StrId = intern.STR_NIL;
    if (p.target_entry != nil) { selected = p.target_entry.name; }

    var w: u32 = 0;
    var f: u32 = 0;
    var k: u32 = 0;
    for (k < m.artifact_count) {
        val a:    *manifest.ArtifactDef  = ?m.artifacts[k];
        var into: *project.ArtifactEntry = entries;
        var at:   *u32                   = ?w;
        if (!intern.str_is_nil(selected) && !manifest.artifact_supports_target(?p.s.interner, a, selected)) {
            into = foreign;
            at   = ?f;
        }
        val br: res[u32, fail.Fail] = add_union_entry(p, into, @at, cap, id_text, a);
        if (sel br.err) { ret err[fail.Fail].err{br.err}; }
        @at = br.ok;
        k   = k + 1;
    }

    entries_handed = true;
    val kept: err[fail.Fail] = keep_entries(p, entries, w, cap, ?p.union_entries, ?p.union_entry_count);
    if (sel kept.err) { ret kept; }
    foreign_handed = true;
    ret keep_entries(p, foreign, f, cap, ?p.foreign_entries, ?p.foreign_entry_count);
}

# hand a filled entry array to the project at its final length
fun keep_entries(p: *project.Project, entries: *project.ArtifactEntry, used: u32, cap: u32,
    out: **project.ArtifactEntry, out_count: *u32) err[fail.Fail] {
    @out       = nil;
    @out_count = 0;
    var kept:     *project.ArtifactEntry = entries;
    var kept_cap: u32                    = cap;
    val fitted:   err[A.Error]           = growth.resize[project.ArtifactEntry](p.alloc, ?kept, ?kept_cap, used::usize);
    if (sel fitted.err) {
        A.deallocate[project.ArtifactEntry](p.alloc, entries, cap::usize);
        ret err[fail.Fail].err{fail.refused(fitted.err)};
    }
    @out       = kept;
    @out_count = used;
    ret err[fail.Fail].ok{};
}

fun add_union_entry(p: *project.Project, entries: *project.ArtifactEntry, w: u32, cap: u32, id_text: str, a: *manifest.ArtifactDef) res[u32, fail.Fail] {
    val ep_opt: opt[str] = intern.get(?p.s.interner, a.entry);
    if (sel ep_opt.none) { ret res[u32, fail.Fail].err{fail.message("internal: union artifact entry not interned")}; }
    val fqn_r: res[intern.StrId, fail.Fail] = module.compose_fqn(p.alloc, ?p.s.interner, id_text, ep_opt.some);
    if (sel fqn_r.err) { ret res[u32, fail.Fail].err{fqn_r.err}; }
    val fqn: intern.StrId = fqn_r.ok;

    var i: u32 = 0;
    for (i < w) {
        if (intern.str_same(entries[i].fqn, fqn)) { ret res[u32, fail.Fail].ok{w}; }
        i = i + 1;
    }
    if (w >= cap) { ret res[u32, fail.Fail].err{fail.message("internal: union entry count exceeded capacity")}; }
    entries[w] = project.ArtifactEntry{fqn: fqn, artifact: a.name, at: a.entry_at};
    ret res[u32, fail.Fail].ok{w + 1};
}
