use std.collections.map;
use std.collections.sort;
use std.collections.vector;
use std.format;
use fs: std.filesystem;
use std.collections.vector.Vector;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_compare;
use std.types.string.str_ends_with;
use std.types.string.str_join;
use std.types.string.str_len;
use std.types.string.str_region_equals;

use A: std.allocator;
use O: std.types.option;
use R: std.types.result;
use sysos: std.system.os;

use mach.lang.diagnostic;
use mach.lang.embed;
use mach.lang.fe.ast;
use mach.lang.fe.comptime;
use mach.lang.fe.ast.decl;
use mach.lang.fe.ast.expr;
use mach.lang.fe.ast.id;
use mach.lang.fe.ast.module;
use mach.lang.fe.token;
use mach.lang.intern;
use mach.lang.manifest;
use mach.lang.session;
use src: mach.lang.source;
use mach.lang.target;
use mach.lang.target.isa;
use mach.lang.target.os;

use mach.lang.driver.project;
use mach.lang.driver.load;

rec SrcMod {
    text: str;
    fqn:  intern.StrId;
}

fun cmp_src_mod(a: *SrcMod, b: *SrcMod) i64 {
    ret str_compare(a.text, b.text);
}

pub fun count_target_gated(p: *project.Project) u32 {
    var n: u32 = 0;
    var i: u32 = 0;
    for (i < p.module_len) {
        if ((?p.modules[i]).target_gated) { n = n + 1; }
        i = i + 1;
    }
    ret n;
}

pub fun load_all_own_src(p: *project.Project) R.Result[R.Void, str] {
    val root_opt: O.Option[str] = intern.lookup(?p.s.interner, p.config.project_root);
    if (O.is_none[str](root_opt)) { ret R.err[R.Void, str]("project_root StrId not interned"); }
    val src_opt: O.Option[str] = intern.lookup(?p.s.interner, p.config.dir_src);
    if (O.is_none[str](src_opt)) { ret R.err[R.Void, str]("dir_src StrId not interned"); }
    val id_opt: O.Option[str] = intern.lookup(?p.s.interner, p.config.id);
    if (O.is_none[str](id_opt)) { ret R.err[R.Void, str]("project id StrId not interned"); }

    val src_abs_r: R.Result[str, str] = load.join_path(p.alloc, O.unwrap[str](root_opt), O.unwrap[str](src_opt));
    if (R.is_err[str, str](src_abs_r)) { ret R.err[R.Void, str](R.unwrap_err[str, str](src_abs_r)); }
    val src_abs: str = R.unwrap_ok[str, str](src_abs_r);

    var mods: vector.Vector[SrcMod] = vector.init[SrcMod](p.alloc);
    val walk_r: R.Result[R.Void, str] = collect_src_modules(p, src_abs, str_len(src_abs), O.unwrap[str](id_opt), ?mods);
    str_free(p.alloc, src_abs);
    if (R.is_err[R.Void, str](walk_r)) { vector.dnit[SrcMod](?mods); ret walk_r; }

    sort.sort[SrcMod](mods.data, mods.len, cmp_src_mod);

    p.loading_orphans = true;
    var i: usize = 0;
    for (i < mods.len) {
        val lr: R.Result[session.ModuleId, str] = load.dfs_load(p, mods.data[i].fqn);
        if (R.is_err[session.ModuleId, str](lr)) {
            p.loading_orphans = false;
            vector.dnit[SrcMod](?mods);
            ret R.err[R.Void, str](R.unwrap_err[session.ModuleId, str](lr));
        }
        i = i + 1;
    }
    p.loading_orphans = false;
    vector.dnit[SrcMod](?mods);
    ret R.ok_void[str]();
}

fun collect_src_modules(p: *project.Project, dir_abs: str, src_prefix_len: usize, id_text: str, out: *vector.Vector[SrcMod]) R.Result[R.Void, str] {
    val fd_raw: i64 = sysos.open(sysos.AT_FDCWD, dir_abs, sysos.O_RDONLY | sysos.O_DIRECTORY, 0);
    if (fd_raw < 0) { ret R.err[R.Void, str](sysos.message(fd_raw)); }
    val fd: i32 = fd_raw::i32;

    var dbuf: [8192]u8;
    var result: R.Result[R.Void, str] = R.ok_void[str]();
    var reading: bool = true;
    for (reading) {
        val n: i64 = sysos.read_dir(fd, (?dbuf[0])::*sysos.dirent64, 8192);
        if (n < 0)  { result = R.err[R.Void, str](sysos.message(n)); reading = false; }
        or (n == 0) { reading = false; }
        or {
            var pos: usize = 0;
            for (reading && pos < n::usize) {
                val ent:    *sysos.dirent64 = ((?dbuf[0])::usize + pos)::*sysos.dirent64;
                val reclen: usize           = ent.d_reclen::usize;
                if (reclen == 0) { reading = false; }
                or {
                    val name: *u8 = ?ent.d_name[0];
                    if (!is_hidden_name(name)) {
                        val rr: R.Result[R.Void, str] = visit_src_entry(p, dir_abs, name::str, src_prefix_len, id_text, out);
                        if (R.is_err[R.Void, str](rr)) { result = rr; reading = false; }
                    }
                    pos = pos + reclen;
                }
            }
        }
    }
    sysos.close(fd);
    ret result;
}

fun visit_src_entry(p: *project.Project, dir_abs: str, name: str, src_prefix_len: usize, id_text: str, out: *vector.Vector[SrcMod]) R.Result[R.Void, str] {
    val child_r: R.Result[str, str] = load.join_path(p.alloc, dir_abs, name);
    if (R.is_err[str, str](child_r)) { ret R.err[R.Void, str](R.unwrap_err[str, str](child_r)); }
    val child: str = R.unwrap_ok[str, str](child_r);

    var result: R.Result[R.Void, str] = R.ok_void[str]();
    val fi_r: R.Result[fs.Metadata, str] = fs.metadata_link(child);
    if (R.is_ok[fs.Metadata, str](fi_r)) {
        val fi: fs.Metadata = R.unwrap_ok[fs.Metadata, str](fi_r);
        if (fs.meta_is_dir(?fi)) {
            result = collect_src_modules(p, child, src_prefix_len, id_text, out);
        }
        or (fs.meta_is_file(?fi) && str_ends_with(name, ".mach")) {
            val rel: str = (child::usize + src_prefix_len + 1)::str;
            val fqn_r: R.Result[intern.StrId, str] = load.compose_module_fqn(p.alloc, ?p.s.interner, id_text, rel);
            if (R.is_err[intern.StrId, str](fqn_r)) { result = R.err[R.Void, str](R.unwrap_err[intern.StrId, str](fqn_r)); }
            or {
                val fqn: intern.StrId = R.unwrap_ok[intern.StrId, str](fqn_r);
                val tx:  O.Option[str] = intern.lookup(?p.s.interner, fqn);
                if (O.is_some[str](tx)) {
                    var sm: SrcMod;
                    sm.text = O.unwrap[str](tx);
                    sm.fqn  = fqn;
                    val pr: R.Result[usize, str] = vector.push[SrcMod](out, sm);
                    if (R.is_err[usize, str](pr)) { result = R.err[R.Void, str](R.unwrap_err[usize, str](pr)); }
                }
            }
        }
    }
    str_free(p.alloc, child);
    ret result;
}

fun is_hidden_name(name: *u8) bool {
    ret name[0] == '.';
}

fun warn_union_target_skipped(p: *project.Project, os_name: str, isa_name: str, why: str) {
    val res_msg: R.Result[str, str] = format.sprint(p.alloc, "target '{}-{}' is not supported by this build; skipped in multi-target analysis: {}", os_name, isa_name, why);
    if (R.is_err[str, str](res_msg)) { ret; }
    val buf: str = R.unwrap_ok[str, str](res_msg);

    var span: token.Span;
    span.offset = 0;
    span.len    = 0;
    diagnostic.record_warning(?p.s.diags, 0xFFFFFFFF::src.FileId, span, buf);

    str_free(p.alloc, buf);
}

pub fun populate_union_tuples(p: *project.Project, m: *manifest.Manifest) R.Result[R.Void, str] {
    val n: u32 = m.target_count;
    if (n == 0) { ret R.ok_void[str](); }
    val tr: R.Result[*project.TargetTuple, str] = A.allocate[project.TargetTuple](p.alloc, n::usize);
    if (R.is_err[*project.TargetTuple, str](tr)) { ret R.err[R.Void, str](R.unwrap_err[*project.TargetTuple, str](tr)); }
    val tuples: *project.TargetTuple = R.unwrap_ok[*project.TargetTuple, str](tr);
    var k:    u32 = 0;
    var fill: u32 = 0;
    for (k < n) {
        val td: *manifest.TargetDef = ?m.targets[k];
        val os_opt:  O.Option[str] = intern.lookup(?p.s.interner, td.os);
        val isa_opt: O.Option[str] = intern.lookup(?p.s.interner, td.isa);
        val abi_opt: O.Option[str] = intern.lookup(?p.s.interner, td.abi);
        if (O.is_none[str](os_opt) || O.is_none[str](isa_opt) || O.is_none[str](abi_opt)) {
            A.deallocate[project.TargetTuple](p.alloc, tuples, n::usize);
            ret R.err[R.Void, str]("internal: union target tuple name not interned");
        }
        val os_name:  str = O.unwrap[str](os_opt);
        val isa_name: str = O.unwrap[str](isa_opt);
        val abi_name: str = O.unwrap[str](abi_opt);
        val os_id:   u32 = os.os_id_for(os_name);
        val arch_id: u32 = isa.arch_id_for(isa_name);
        var of_name: str = "";
        val of_opt: O.Option[str] = intern.lookup(?p.s.interner, td.of);
        if (O.is_some[str](of_opt)) { of_name = O.unwrap[str](of_opt); }
        val sr: R.Result[target.Target, str] = target.select_of(?p.s.registry, isa_name, os_name, abi_name, of_name);
        if (R.is_err[target.Target, str](sr)) {
            warn_union_target_skipped(p, os_name, isa_name, R.unwrap_err[target.Target, str](sr));
        } or {
            val selected: target.Target = R.unwrap_ok[target.Target, str](sr);
            tuples[fill].os_id         = os_id;
            tuples[fill].arch_id       = arch_id;
            tuples[fill].abi_id        = selected.abi_id;
            tuples[fill].pointer_width = selected.isa.pointer_width;
            tuples[fill].vector_bits   = selected.model.vector_bits;
            tuples[fill].has_float     = selected.model.has_float;
            tuples[fill].target_defs   = selected.isa.defs;
            tuples[fill].va_list_size  = selected.va_list_size;
            tuples[fill].va_list_align = selected.va_list_align;
            tuples[fill].os_name       = td.os;
            tuples[fill].isa_name      = td.isa;
            tuples[fill].abi_name      = td.abi;
            tuples[fill].platform_name = td.platform;
            fill = fill + 1;
        }
        k = k + 1;
    }
    p.union_tuples      = tuples;
    p.union_tuple_count = fill;
    p.union_tuple_cap   = n;
    p.union             = true;
    ret R.ok_void[str]();
}

pub fun populate_union_entries(p: *project.Project, m: *manifest.Manifest) R.Result[R.Void, str] {
    if (m.artifact_count == 0) { ret R.ok_void[str](); }

    var cap: u32 = m.artifact_count;

    val er: R.Result[*intern.StrId, str] = A.allocate[intern.StrId](p.alloc, cap::usize);
    if (R.is_err[*intern.StrId, str](er)) { ret R.err[R.Void, str](R.unwrap_err[*intern.StrId, str](er)); }
    val entries: *intern.StrId = R.unwrap_ok[*intern.StrId, str](er);

    val id_opt: O.Option[str] = intern.lookup(?p.s.interner, p.config.id);
    if (O.is_none[str](id_opt)) {
        A.deallocate[intern.StrId](p.alloc, entries, cap::usize);
        ret R.err[R.Void, str]("internal: union project id not interned");
    }
    val id_text: str = O.unwrap[str](id_opt);

    var w: u32 = 0;
    var k: u32 = 0;
    for (k < m.artifact_count) {
        val a: *manifest.ArtifactDef = ?m.artifacts[k];
        val br: R.Result[u32, str] = add_union_entry(p, entries, w, cap, id_text, a.entry);
        if (R.is_err[u32, str](br)) { A.deallocate[intern.StrId](p.alloc, entries, cap::usize); ret R.err[R.Void, str](R.unwrap_err[u32, str](br)); }
        w = R.unwrap_ok[u32, str](br);
        k = k + 1;
    }

    if (w < cap) {
        val sr: R.Result[*intern.StrId, str] = A.reallocate[intern.StrId](p.alloc, entries, cap::usize, w::usize);
        if (R.is_err[*intern.StrId, str](sr)) {
            A.deallocate[intern.StrId](p.alloc, entries, cap::usize);
            ret R.err[R.Void, str](R.unwrap_err[*intern.StrId, str](sr));
        }
        p.union_entries = R.unwrap_ok[*intern.StrId, str](sr);
    }
    or {
        p.union_entries = entries;
    }
    p.union_entry_count = w;
    ret R.ok_void[str]();
}

fun add_union_entry(p: *project.Project, entries: *intern.StrId, w: u32, cap: u32, id_text: str, entry_id: intern.StrId) R.Result[u32, str] {
    val ep_opt: O.Option[str] = intern.lookup(?p.s.interner, entry_id);
    if (O.is_none[str](ep_opt)) { ret R.err[u32, str]("internal: union artifact entry not interned"); }
    val fqn_r: R.Result[intern.StrId, str] = load.compose_module_fqn(p.alloc, ?p.s.interner, id_text, O.unwrap[str](ep_opt));
    if (R.is_err[intern.StrId, str](fqn_r)) { ret R.err[u32, str](R.unwrap_err[intern.StrId, str](fqn_r)); }
    val fqn: intern.StrId = R.unwrap_ok[intern.StrId, str](fqn_r);

    var i: u32 = 0;
    for (i < w) {
        if (entries[i] == fqn) { ret R.ok[u32, str](w); }
        i = i + 1;
    }
    if (w >= cap) { ret R.err[u32, str]("internal: union entry count exceeded capacity"); }
    entries[w] = fqn;
    ret R.ok[u32, str](w + 1);
}

pub fun register_export_names(p: *project.Project) R.Result[R.Void, str] {
    var i: u32 = 0;
    for (i < p.module_len) {
        val r: R.Result[R.Void, str] = register_module_export_names(p, i::session.ModuleId);
        if (R.is_err[R.Void, str](r)) { ret r; }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

fun register_module_export_names(p: *project.Project, mid: session.ModuleId) R.Result[R.Void, str] {
    val m: *project.ModuleEntry = ?p.modules[mid::u32];
    val m_opt: O.Option[*module.Module] = ast.get_module(m.a, m.a.root_module);
    if (O.is_none[*module.Module](m_opt)) { ret R.ok_void[str](); }
    val mod_node: *module.Module = O.unwrap[*module.Module](m_opt);

    val src_opt: O.Option[*src.SourceFile] = src.get(?p.s.sources, m.file_id);
    if (O.is_none[*src.SourceFile](src_opt)) { ret R.ok_void[str](); }
    val source: str = O.unwrap[*src.SourceFile](src_opt).text;

    ret scan_export_directives(p, mid, source, mod_node.decls_start, mod_node.decls_len);
}

rec ImportAttribution {
    module: intern.StrId;
    decl:   intern.StrId;
    lib:    intern.StrId;
}

pub fun register_import_libraries(p: *project.Project) R.Result[R.Void, str] {
    var attrs: map.Map[intern.StrId, ImportAttribution] =
        map.init[intern.StrId, ImportAttribution](p.alloc, map.hash_u32, map.eq_u32);
    var ti: u32 = 0;
    for (ti < p.emit_len) {
        val mid: session.ModuleId = p.topo[ti];
        val m: *project.ModuleEntry = ?p.modules[mid::u32];
        val m_opt: O.Option[*module.Module] = ast.get_module(m.a, m.a.root_module);
        if (O.is_some[*module.Module](m_opt)) {
            val mod_node: *module.Module = O.unwrap[*module.Module](m_opt);
            var source: str = "";
            val src_opt: O.Option[*src.SourceFile] = src.get(?p.s.sources, m.file_id);
            if (O.is_some[*src.SourceFile](src_opt)) {
                source = O.unwrap[*src.SourceFile](src_opt).text;
            }
            val r: R.Result[R.Void, str] = bind_import_libraries(p, mid,
                source, ?attrs, mod_node.decls_start, mod_node.decls_len);
            if (R.is_err[R.Void, str](r)) {
                map.dnit[intern.StrId, ImportAttribution](?attrs);
                ret r;
            }
        }
        ti = ti + 1;
    }
    map.dnit[intern.StrId, ImportAttribution](?attrs);
    ret R.ok_void[str]();
}

fun bind_import_libraries(p: *project.Project, mid: session.ModuleId, source: str,
                          attrs: *map.Map[intern.StrId, ImportAttribution],
                          start: u32, len: u32) R.Result[R.Void, str] {
    val m: *project.ModuleEntry = ?p.modules[mid::u32];
    var i: u32 = 0;
    for (i < len) {
        val did: id.DeclId = m.a.decl_ids[start + i];
        if (!comptime.load_walked(?m.ctx, did)) { i = i + 1; cnt; }
        val d_opt: O.Option[*decl.Decl] = ast.get_decl(m.a, did);
        if (O.is_some[*decl.Decl](d_opt)) {
            val d: *decl.Decl = O.unwrap[*decl.Decl](d_opt);
            if ((d.kind == decl.DECL_KIND_FUN
                 || d.kind == decl.DECL_KIND_VAL || d.kind == decl.DECL_KIND_VAR)
                && (d.flags & decl.DECL_FLAG_EXT) != 0) {
                val lib_opt: O.Option[intern.StrId] = session.export_library(p.s, mid, did::u32);
                if (O.is_some[intern.StrId](lib_opt)) {
                    val name_opt: O.Option[intern.StrId] = session.export_name(p.s, mid, did::u32);
                    if (O.is_none[intern.StrId](name_opt)) {
                        ret R.err[R.Void, str]("internal: ext decl carries a #[library] attribution but no link name");
                    }
                    val r: R.Result[R.Void, str] = bind_one_import_library(p, mid, source,
                        attrs, d, O.unwrap[intern.StrId](name_opt),
                        O.unwrap[intern.StrId](lib_opt));
                    if (R.is_err[R.Void, str](r)) { ret r; }
                }
            }
            or (d.kind == decl.DECL_KIND_COMPTIME_IF) {
                val ci: *decl.DeclComptimeIf = ?d.data.comptime_if;
                var bi: u32 = 0;
                for (bi < ci.branches_len) {
                    val br: *decl.ComptimeBranch = ?m.a.comptime_branches[ci.branches_start + bi];
                    val rb: R.Result[R.Void, str] = bind_import_libraries(p, mid, source, attrs,
                                                                       br.body_start, br.body_len);
                    if (R.is_err[R.Void, str](rb)) { ret rb; }
                    bi = bi + 1;
                }
            }
        }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

fun bind_one_import_library(p: *project.Project, mid: session.ModuleId, source: str,
                            attrs: *map.Map[intern.StrId, ImportAttribution],
                            d: *decl.Decl, name: intern.StrId,
                            lib: intern.StrId) R.Result[R.Void, str] {
    var here: ImportAttribution;
    here.module = session.module_fqn(p.s, mid);
    here.decl   = attribution_decl_name(p, source, d);
    here.lib    = lib;

    val prev: R.Result[*ImportAttribution, str] =
        map.get[intern.StrId, ImportAttribution](attrs, ?name);
    if (R.is_ok[*ImportAttribution, str](prev)) {
        val had: *ImportAttribution = R.unwrap_ok[*ImportAttribution, str](prev);
        if (had.lib == lib) { ret R.ok_void[str](); }
        ret R.err[R.Void, str](attribution_conflict_message(p, name, had, ?here));
    }

    val ins: R.Result[bool, str] =
        map.insert[intern.StrId, ImportAttribution](attrs, name, here);
    if (R.is_err[bool, str](ins)) { ret R.void_of[bool, str](ins); }
    ret session.register_import_library(p.s, name, lib);
}

fun attribution_decl_name(p: *project.Project, source: str, d: *decl.Decl) intern.StrId {
    if (str_len(source) == 0) { ret intern.STR_NIL; }
    var span: token.Span;
    if (d.kind == decl.DECL_KIND_FUN) { span = d.data.fun_.name; }
    or { span = d.data.bind.name; }
    val r: R.Result[intern.StrId, str] = intern.intern_span(?p.s.interner, source, span);
    if (R.is_err[intern.StrId, str](r)) { ret intern.STR_NIL; }
    ret R.unwrap_ok[intern.StrId, str](r);
}

fun attribution_conflict_message(p: *project.Project, name: intern.StrId,
                                 first: *ImportAttribution,
                                 second: *ImportAttribution) str {
    val n:  O.Option[str] = intern.lookup(?p.s.interner, name);
    val am: O.Option[str] = intern.lookup(?p.s.interner, first.module);
    val ad: O.Option[str] = intern.lookup(?p.s.interner, first.decl);
    val al: O.Option[str] = intern.lookup(?p.s.interner, first.lib);
    val bm: O.Option[str] = intern.lookup(?p.s.interner, second.module);
    val bd: O.Option[str] = intern.lookup(?p.s.interner, second.decl);
    val bl: O.Option[str] = intern.lookup(?p.s.interner, second.lib);
    if (!O.is_some[str](n) || !O.is_some[str](am) || !O.is_some[str](ad)
        || !O.is_some[str](al) || !O.is_some[str](bm) || !O.is_some[str](bd)
        || !O.is_some[str](bl)) {
        ret "one import is attributed to two libraries by #[library]";
    }
    val r: R.Result[str, str] = str_join(p.s.build_alloc,
        "import '", O.unwrap[str](n), "' is attributed to library '",
        O.unwrap[str](al), "' by declaration '", O.unwrap[str](ad),
        "' in module '", O.unwrap[str](am), "' and to library '",
        O.unwrap[str](bl), "' by declaration '", O.unwrap[str](bd),
        "' in module '", O.unwrap[str](bm),
        "'; a symbol may name only one providing library");
    if (R.is_err[str, str](r)) { ret R.unwrap_err[str, str](r); }
    ret R.unwrap_ok[str, str](r);
}

fun scan_export_directives(p: *project.Project, mid: session.ModuleId, source: str, start: u32, len: u32) R.Result[R.Void, str] {
    val m: *project.ModuleEntry = ?p.modules[mid::u32];
    var i: u32 = 0;
    for (i < len) {
        val did: id.DeclId = m.a.decl_ids[start + i];
        if (!comptime.load_walked(?m.ctx, did)) { i = i + 1; cnt; }
        val d_opt: O.Option[*decl.Decl] = ast.get_decl(m.a, did);
        if (O.is_some[*decl.Decl](d_opt)) {
            val d: *decl.Decl = O.unwrap[*decl.Decl](d_opt);
            if (d.kind == decl.DECL_KIND_FUN && (d.flags & decl.DECL_FLAG_EXT) != 0) {
                val r: R.Result[R.Void, str] = register_ext_fun(p, mid, source, d, did);
                if (R.is_err[R.Void, str](r)) { ret r; }
            }
            or ((d.kind == decl.DECL_KIND_VAL || d.kind == decl.DECL_KIND_VAR)
                && (d.flags & decl.DECL_FLAG_EXT) != 0) {
                val r: R.Result[R.Void, str] = register_ext_global(p, mid, source, d, did);
                if (R.is_err[R.Void, str](r)) { ret r; }
            }
            or (d.kind == decl.DECL_KIND_COMPTIME_IF) {
                val ci: *decl.DeclComptimeIf = ?d.data.comptime_if;
                var bi: u32 = 0;
                for (bi < ci.branches_len) {
                    val br: *decl.ComptimeBranch = ?m.a.comptime_branches[ci.branches_start + bi];
                    val rb: R.Result[R.Void, str] = scan_export_directives(p, mid, source, br.body_start, br.body_len);
                    if (R.is_err[R.Void, str](rb)) { ret rb; }
                    bi = bi + 1;
                }
            }

            if (d.decorators_len > 0::u32) {
                val rd: R.Result[R.Void, str] = register_decl_decorators(p, mid, source, d, did);
                if (R.is_err[R.Void, str](rd)) { ret rd; }
            }
        }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

fun register_decl_decorators(p: *project.Project, mid: session.ModuleId, source: str, d: *decl.Decl, did: id.DeclId) R.Result[R.Void, str] {
    val m: *project.ModuleEntry = ?p.modules[mid::u32];
    var k: u32 = 0;
    for (k < d.decorators_len) {
        val dec: *decl.Decorator = ?m.a.decorators[d.decorators_start + k];
        val is_symbol:  bool = project.span_eq_str(source, dec.name, "symbol");
        val is_library: bool = project.span_eq_str(source, dec.name, "library");

        if ((is_symbol || is_library) && dec.args_len == 1::u32) {
            val eid: id.ExprId = m.a.expr_ids[dec.args_start];
            val ve_opt: O.Option[*expr.Expr] = ast.get_expr(m.a, eid);
            if (O.is_some[*expr.Expr](ve_opt)) {
                val ve: *expr.Expr = O.unwrap[*expr.Expr](ve_opt);
                if (ve.kind == expr.EXPR_KIND_LIT_STR && ve.span.len >= 2::usize) {
                    var inner: token.Span = ve.span;
                    inner.offset = inner.offset + 1::usize;
                    inner.len    = inner.len - 2::usize;

                    val name_r: R.Result[intern.StrId, str] = intern.intern_span(?p.s.interner, source, inner);
                    if (R.is_err[intern.StrId, str](name_r)) { ret R.err[R.Void, str](R.unwrap_err[intern.StrId, str](name_r)); }
                    val sid: intern.StrId = R.unwrap_ok[intern.StrId, str](name_r);

                    if (is_library) {
                        val rl: R.Result[R.Void, str] = session.register_export_library(p.s, mid, did::u32, sid);
                        if (R.is_err[R.Void, str](rl)) { ret rl; }
                    } or {
                        val rn: R.Result[R.Void, str] = session.register_export_name(p.s, mid, did::u32, sid);
                        if (R.is_err[R.Void, str](rn)) { ret rn; }
                    }
                }
            }
        }
        k = k + 1;
    }
    ret R.ok_void[str]();
}

fun ext_link_name(p: *project.Project, source: str, span: token.Span) R.Result[intern.StrId, str] {
    val bare_r: R.Result[intern.StrId, str] = intern.intern_span(?p.s.interner, source, span);
    if (R.is_err[intern.StrId, str](bare_r)) { ret bare_r; }
    ret project.link_name_for(p, R.unwrap_ok[intern.StrId, str](bare_r));
}

fun register_ext_fun(p: *project.Project, mid: session.ModuleId, source: str, d: *decl.Decl, did: id.DeclId) R.Result[R.Void, str] {
    if (O.is_some[intern.StrId](session.export_name(p.s, mid, did::u32))) { ret R.ok_void[str](); }
    val name_r: R.Result[intern.StrId, str] = ext_link_name(p, source, d.data.fun_.name);
    if (R.is_err[intern.StrId, str](name_r)) { ret R.err[R.Void, str](R.unwrap_err[intern.StrId, str](name_r)); }
    ret session.register_export_name(p.s, mid, did::u32, R.unwrap_ok[intern.StrId, str](name_r));
}

fun register_ext_global(p: *project.Project, mid: session.ModuleId, source: str, d: *decl.Decl, did: id.DeclId) R.Result[R.Void, str] {
    if (O.is_some[intern.StrId](session.export_name(p.s, mid, did::u32))) { ret R.ok_void[str](); }
    val name_r: R.Result[intern.StrId, str] = ext_link_name(p, source, d.data.bind.name);
    if (R.is_err[intern.StrId, str](name_r)) { ret R.err[R.Void, str](R.unwrap_err[intern.StrId, str](name_r)); }
    ret session.register_export_name(p.s, mid, did::u32, R.unwrap_ok[intern.StrId, str](name_r));
}

pub fun register_embed_inputs(p: *project.Project) R.Result[R.Void, str] {
    var i: u32 = 0;
    for (i < p.module_len) {
        val m: *project.ModuleEntry = ?p.modules[i];
        val m_opt: O.Option[*module.Module] = ast.get_module(m.a, m.a.root_module);
        if (O.is_some[*module.Module](m_opt)) {
            val mod_node: *module.Module = O.unwrap[*module.Module](m_opt);
            val r: R.Result[R.Void, str] = refresh_embeds_in(p, m, mod_node.decls_start, mod_node.decls_len);
            if (R.is_err[R.Void, str](r)) { ret r; }
        }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

fun refresh_embeds_in(p: *project.Project, m: *project.ModuleEntry, start: u32, len: u32) R.Result[R.Void, str] {
    var i: u32 = 0;
    for (i < len) {
        val did: id.DeclId = m.a.decl_ids[start + i];
        if (!comptime.load_walked(?m.ctx, did)) { i = i + 1; cnt; }
        val d_opt: O.Option[*decl.Decl] = ast.get_decl(m.a, did);
        if (O.is_none[*decl.Decl](d_opt)) { i = i + 1; cnt; }
        val d: *decl.Decl = O.unwrap[*decl.Decl](d_opt);

        if (d.kind == decl.DECL_KIND_COMPTIME_IF) {
            var b: u32 = 0;
            for (b < d.data.comptime_if.branches_len) {
                val br: *decl.ComptimeBranch = ?m.a.comptime_branches[d.data.comptime_if.branches_start + b];
                val r: R.Result[R.Void, str] = refresh_embeds_in(p, m, br.body_start, br.body_len);
                if (R.is_err[R.Void, str](r)) { ret r; }
                b = b + 1;
            }
            i = i + 1;
            cnt;
        }

        var di: u32 = 0;
        for (di < d.decorators_len) {
            val dec: *decl.Decorator = ?m.a.decorators[d.decorators_start + di];
            if (embed_named(p, m, dec)) {
                val r: R.Result[R.Void, str] = refresh_one(p, m, dec);
                if (R.is_err[R.Void, str](r)) { ret r; }
            }
            di = di + 1;
        }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

fun embed_named(p: *project.Project, m: *project.ModuleEntry, dec: *decl.Decorator) bool {
    val src_opt: O.Option[*src.SourceFile] = src.get(?p.s.sources, m.file_id);
    if (O.is_none[*src.SourceFile](src_opt)) { ret false; }
    val source: str = O.unwrap[*src.SourceFile](src_opt).text;
    ret str_region_equals(source, dec.name.offset, dec.name.len, "embed");
}

fun refresh_one(p: *project.Project, m: *project.ModuleEntry, dec: *decl.Decorator) R.Result[R.Void, str] {
    val src_opt: O.Option[*src.SourceFile] = src.get(?p.s.sources, m.file_id);
    if (O.is_none[*src.SourceFile](src_opt)) { ret R.ok_void[str](); }
    val f: *src.SourceFile = O.unwrap[*src.SourceFile](src_opt);
    if (f.path == nil) { ret R.ok_void[str](); }

    val span_opt: O.Option[token.Span] = embed.path_arg_span(m.a, dec);
    if (O.is_none[token.Span](span_opt)) { ret R.ok_void[str](); }
    val span: token.Span = O.unwrap[token.Span](span_opt);

    val ir: R.Result[intern.StrId, str] = intern.intern_span(?p.s.interner, f.text, span);
    if (R.is_err[intern.StrId, str](ir)) { ret R.err[R.Void, str](R.unwrap_err[intern.StrId, str](ir)); }
    val arg_opt: O.Option[str] = intern.lookup(?p.s.interner, R.unwrap_ok[intern.StrId, str](ir));
    if (O.is_none[str](arg_opt)) { ret R.ok_void[str](); }

    val pr: R.Result[str, str] = embed.resolve_arg(p.s.alloc, ?p.s.embeds, f.path, O.unwrap[str](arg_opt));
    if (R.is_err[str, str](pr)) { ret R.ok_void[str](); }
    val resolved: str = R.unwrap_ok[str, str](pr);

    val rr: R.Result[intern.StrId, str] = embed.refresh(?p.s.embeds, ?p.s.queries, ?p.s.interner, resolved);
    str_free(p.s.alloc, resolved);
    if (R.is_err[intern.StrId, str](rr)) { ret R.err[R.Void, str](R.unwrap_err[intern.StrId, str](rr)); }
    ret R.ok_void[str]();
}
