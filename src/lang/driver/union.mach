use mach.lang.driver.load;

rec SrcMod {
    text: str;
    fqn:  intern.StrId;
}

fun cmp_src_mod(a: *SrcMod, b: *SrcMod) i64 {
    ret str_compare(a.text, b.text);
}

pub fun count_target_gated(p: *project.Project) u32 {
    var n: u32 = 0;
    var i: u32 = 0;
    for (i < p.module_len) {
        if ((?p.modules[i]).target_gated) { n = n + 1; }
        i = i + 1;
    }
    ret n;
}

pub fun load_all_own_src(p: *project.Project) err[fail.Fail] {
    val root_opt: opt[str] = intern.lookup_typed(?p.s.interner, p.config.project_root);
    if (sel root_opt.none) { ret err[fail.Fail].err{fail.message("project_root StrId not interned")}; }
    val src_opt: opt[str] = intern.lookup_typed(?p.s.interner, p.config.dir_src);
    if (sel src_opt.none) { ret err[fail.Fail].err{fail.message("dir_src StrId not interned")}; }
    val id_opt: opt[str] = intern.lookup_typed(?p.s.interner, p.config.id);
    if (sel id_opt.none) { ret err[fail.Fail].err{fail.message("project id StrId not interned")}; }

    val src_abs_r: res[str, fail.Fail] = load.join_path(p.alloc, root_opt.some, src_opt.some);
    if (sel src_abs_r.err) { ret err[fail.Fail].err{src_abs_r.err}; }
    val src_abs: str = src_abs_r.ok;

    var mods: vector.Vector[SrcMod] = vector.init[SrcMod](p.alloc);
    val walk_r: err[fail.Fail] = collect_src_modules(p, src_abs, str_len(src_abs), id_opt.some, ?mods);
    str_free(p.alloc, src_abs);
    if (sel walk_r.err) { vector.dnit[SrcMod](?mods); ret walk_r; }

    sort.sort[SrcMod](mods.data, mods.len, cmp_src_mod);

    p.loading_orphans = true;
    var i: usize = 0;
    for (i < mods.len) {
        val lr: res[session.ModuleId, fail.Fail] = load.dfs_load(p, mods.data[i].fqn);
        if (sel lr.err) {
            p.loading_orphans = false;
            vector.dnit[SrcMod](?mods);
            ret err[fail.Fail].err{lr.err};
        }
        i = i + 1;
    }
    p.loading_orphans = false;
    vector.dnit[SrcMod](?mods);
    ret err[fail.Fail].ok{};
}

fun collect_src_modules(p: *project.Project, dir_abs: str, src_prefix_len: usize, id_text: str, out: *vector.Vector[SrcMod]) err[fail.Fail] {
    val fd_raw: i64 = sysos.open(sysos.AT_FDCWD, dir_abs, sysos.O_RDONLY | sysos.O_DIRECTORY, 0);
    if (fd_raw < 0) { ret err[fail.Fail].err{fail.message(sysos.message(fd_raw))}; }
    val fd: i32 = fd_raw::i32;

    var cursor: sysos.DirectoryCursor = sysos.DirectoryCursor{};
    val opened: sysos.DirectoryInitResult = sysos.directory_init(?cursor, fd);
    if (opened.code < 0) { sysos.close(fd); ret err[fail.Fail].err{fail.message(sysos.message(opened.code))}; }
    var result: err[fail.Fail] = err[fail.Fail].ok{};
    var reading: bool = true;
    for (reading) {
        var entry: sysos.DirectoryEntry;
        val n: i64 = sysos.directory_next(?cursor, ?entry);
        if (n < 0)  { result = err[fail.Fail].err{fail.message(sysos.message(n))}; reading = false; }
        or (n == 0) { reading = false; }
        or (!is_hidden_name(entry.name::*u8)) {
            val rr: err[fail.Fail] = visit_src_entry(p, dir_abs, entry.name, src_prefix_len, id_text, out);
            if (sel rr.err) { result = rr; reading = false; }
        }
    }
    sysos.directory_close(?cursor);
    sysos.close(fd);
    ret result;
}

fun visit_src_entry(p: *project.Project, dir_abs: str, name: str, src_prefix_len: usize, id_text: str, out: *vector.Vector[SrcMod]) err[fail.Fail] {
    val child_r: res[str, fail.Fail] = load.join_path(p.alloc, dir_abs, name);
    if (sel child_r.err) { ret err[fail.Fail].err{child_r.err}; }
    val child: str = child_r.ok;

    var result: err[fail.Fail] = err[fail.Fail].ok{};
    val fi_r: res[fs.Metadata, io_error.Error] = fs.metadata_link(child);
    if (sel fi_r.ok) {
        val fi: fs.Metadata = fi_r.ok;
        if (fs.meta_is_dir(?fi)) {
            result = collect_src_modules(p, child, src_prefix_len, id_text, out);
        }
        or (fs.meta_is_file(?fi) && str_ends_with(name, ".mach")) {
            val rel: str = (child::usize + src_prefix_len + 1)::str;
            val fqn_r: res[intern.StrId, fail.Fail] = load.compose_module_fqn(p.alloc, ?p.s.interner, id_text, rel);
            if (sel fqn_r.err) { result = err[fail.Fail].err{fqn_r.err}; }
            if (sel fqn_r.ok) {
                val fqn: intern.StrId = fqn_r.ok;
                val tx: opt[str] = intern.lookup_typed(?p.s.interner, fqn);
                if (sel tx.some) {
                    var sm: SrcMod;
                    sm.text = tx.some;
                    sm.fqn  = fqn;
                    val pr: res[usize, A.Error] = vector.push[SrcMod](out, sm);
                    if (sel pr.err) { result = err[fail.Fail].err{fail.refused(pr.err)}; }
                }
            }
        }
    }
    str_free(p.alloc, child);
    ret result;
}

fun is_hidden_name(name: *u8) bool {
    ret name[0] == '.';
}

fun warn_union_target_skipped(p: *project.Project, os_name: str, isa_name: str, why: str) {
    val res_msg: res[str, format.FormatError] = format.sprint(p.alloc, "target '{}-{}' is not supported by this build; skipped in multi-target analysis: {}", os_name, isa_name, why);
    if (sel res_msg.err) { ret; }
    val buf: str = res_msg.ok;

    var span: token.Span;
    span.offset = 0;
    span.len    = 0;
    diagnostic.record_warning(?p.diags, 0xFFFFFFFF::src.FileId, span, buf);

    str_free(p.alloc, buf);
}

pub fun populate_union_tuples(p: *project.Project, m: *manifest.Manifest) err[fail.Fail] {
    val n: u32 = m.target_count;
    if (n == 0) { ret err[fail.Fail].ok{}; }
    val tr: res[*project.TargetTuple, A.Error] = A.allocate[project.TargetTuple](p.alloc, n::usize);
    if (sel tr.err) { ret err[fail.Fail].err{fail.refused(tr.err)}; }
    val tuples: *project.TargetTuple = tr.ok;
    var k:    u32 = 0;
    var fill: u32 = 0;
    for (k < n) {
        val td: *manifest.TargetDef = ?m.targets[k];
        val os_opt: opt[str] = intern.lookup_typed(?p.s.interner, td.os);
        val isa_opt: opt[str] = intern.lookup_typed(?p.s.interner, td.isa);
        val abi_opt: opt[str] = intern.lookup_typed(?p.s.interner, td.abi);
        if (sel os_opt.none) {
            A.deallocate[project.TargetTuple](p.alloc, tuples, n::usize);
            ret err[fail.Fail].err{fail.message("internal: union target tuple name not interned")};
        }
        if (sel isa_opt.none) {
            A.deallocate[project.TargetTuple](p.alloc, tuples, n::usize);
            ret err[fail.Fail].err{fail.message("internal: union target tuple name not interned")};
        }
        if (sel abi_opt.none) {
            A.deallocate[project.TargetTuple](p.alloc, tuples, n::usize);
            ret err[fail.Fail].err{fail.message("internal: union target tuple name not interned")};
        }
        val os_name:  str = os_opt.some;
        val isa_name: str = isa_opt.some;
        val abi_name: str = abi_opt.some;
        val os_id:   u32 = os.os_id_for(os_name);
        val arch_id: u32 = isa.arch_id_for(isa_name);
        var of_name: str = "";
        val of_opt: opt[str] = intern.lookup_typed(?p.s.interner, td.of);
        if (sel of_opt.some) { of_name = of_opt.some; }
        val sr: R.Result[target.Target, str] = target.select_of(?p.s.registry, isa_name, os_name, abi_name, of_name);
        if (R.is_err[target.Target, str](sr)) {
            warn_union_target_skipped(p, os_name, isa_name, R.unwrap_err[target.Target, str](sr));
        } or {
            val selected: target.Target = R.unwrap_ok[target.Target, str](sr);
            tuples[fill].os_id         = os_id;
            tuples[fill].arch_id       = arch_id;
            tuples[fill].abi_id        = selected.abi_id;
            tuples[fill].pointer_width = selected.isa.pointer_width;
            tuples[fill].vector_bits   = selected.model.vector_bits;
            tuples[fill].has_float     = selected.model.has_float;
            tuples[fill].target_defs   = selected.isa.defs;
            tuples[fill].va_list_size  = selected.va_list_size;
            tuples[fill].va_list_align = selected.va_list_align;
            tuples[fill].os_name       = td.os;
            tuples[fill].isa_name      = td.isa;
            tuples[fill].abi_name      = td.abi;
            tuples[fill].platform_name = td.platform;
            fill = fill + 1;
        }
        k = k + 1;
    }
    p.union_tuples      = tuples;
    p.union_tuple_count = fill;
    p.union_tuple_cap   = n;
    p.union             = true;
    ret err[fail.Fail].ok{};
}

pub fun populate_union_entries(p: *project.Project, m: *manifest.Manifest) err[fail.Fail] {
    if (m.artifact_count == 0) { ret err[fail.Fail].ok{}; }

    var cap: u32 = m.artifact_count;

    val er: res[*intern.StrId, A.Error] = A.allocate[intern.StrId](p.alloc, cap::usize);
    if (sel er.err) { ret err[fail.Fail].err{fail.refused(er.err)}; }
    val entries: *intern.StrId = er.ok;

    val id_opt: opt[str] = intern.lookup_typed(?p.s.interner, p.config.id);
    if (sel id_opt.none) {
        A.deallocate[intern.StrId](p.alloc, entries, cap::usize);
        ret err[fail.Fail].err{fail.message("internal: union project id not interned")};
    }
    val id_text: str = id_opt.some;

    var w: u32 = 0;
    var k: u32 = 0;
    for (k < m.artifact_count) {
        val a: *manifest.ArtifactDef = ?m.artifacts[k];
        val br: res[u32, fail.Fail] = add_union_entry(p, entries, w, cap, id_text, a.entry);
        if (sel br.err) { A.deallocate[intern.StrId](p.alloc, entries, cap::usize); ret err[fail.Fail].err{br.err}; }
        w = br.ok;
        k = k + 1;
    }

    if (w < cap) {
        val sr: res[*intern.StrId, A.Error] = A.reallocate[intern.StrId](p.alloc, entries, cap::usize, w::usize);
        if (sel sr.err) {
            A.deallocate[intern.StrId](p.alloc, entries, cap::usize);
            ret err[fail.Fail].err{fail.refused(sr.err)};
        }
        p.union_entries = sr.ok;
    }
    or {
        p.union_entries = entries;
    }
    p.union_entry_count = w;
    ret err[fail.Fail].ok{};
}

fun add_union_entry(p: *project.Project, entries: *intern.StrId, w: u32, cap: u32, id_text: str, entry_id: intern.StrId) res[u32, fail.Fail] {
    val ep_opt: opt[str] = intern.lookup_typed(?p.s.interner, entry_id);
    if (sel ep_opt.none) { ret res[u32, fail.Fail].err{fail.message("internal: union artifact entry not interned")}; }
    val fqn_r: res[intern.StrId, fail.Fail] = load.compose_module_fqn(p.alloc, ?p.s.interner, id_text, ep_opt.some);
    if (sel fqn_r.err) { ret res[u32, fail.Fail].err{fqn_r.err}; }
    val fqn: intern.StrId = fqn_r.ok;

    var i: u32 = 0;
    for (i < w) {
        if (entries[i] == fqn) { ret res[u32, fail.Fail].ok{w}; }
        i = i + 1;
    }
    if (w >= cap) { ret res[u32, fail.Fail].err{fail.message("internal: union entry count exceeded capacity")}; }
    entries[w] = fqn;
    ret res[u32, fail.Fail].ok{w + 1};
}

pub fun register_export_names(p: *project.Project) err[fail.Fail] {
    var i: u32 = 0;
    for (i < p.module_len) {
        val r: err[fail.Fail] = register_module_export_names(p, i::session.ModuleId);
        if (sel r.err) { ret r; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun register_module_export_names(p: *project.Project, mid: session.ModuleId) err[fail.Fail] {
    val m: *project.ModuleEntry = ?p.modules[mid::u32];
    val m_opt: opt[*module.Module] = ast.get_module_typed(m.a, m.a.root_module);
    if (sel m_opt.none) { ret err[fail.Fail].ok{}; }
    val mod_node: *module.Module = m_opt.some;

    val src_opt: O.Option[*src.SourceFile] = src.get(?p.s.sources, m.file_id);
    if (O.is_none[*src.SourceFile](src_opt)) { ret err[fail.Fail].ok{}; }
    val source: str = O.unwrap[*src.SourceFile](src_opt).text;

    ret scan_export_directives(p, mid, source, mod_node.decls_start, mod_node.decls_len);
}

rec ImportAttribution {
    module: intern.StrId;
    decl:   intern.StrId;
    lib:    intern.StrId;
}

pub fun register_import_libraries(p: *project.Project) err[fail.Fail] {
    var attrs: map.Map[intern.StrId, ImportAttribution] =
        map.init[intern.StrId, ImportAttribution](p.alloc, map.hash_u32, map.eq_u32);
    var ti: u32 = 0;
    for (ti < p.emit_len) {
        val mid: session.ModuleId = p.topo[ti];
        val m: *project.ModuleEntry = ?p.modules[mid::u32];
        val m_opt: opt[*module.Module] = ast.get_module_typed(m.a, m.a.root_module);
        if (sel m_opt.some) {
            val mod_node: *module.Module = m_opt.some;
            var source: str = "";
            val src_opt: O.Option[*src.SourceFile] = src.get(?p.s.sources, m.file_id);
            if (O.is_some[*src.SourceFile](src_opt)) {
                source = O.unwrap[*src.SourceFile](src_opt).text;
            }
            val r: err[fail.Fail] = bind_import_libraries(p, mid,
                source, ?attrs, mod_node.decls_start, mod_node.decls_len);
            if (sel r.err) {
                map.dnit[intern.StrId, ImportAttribution](?attrs);
                ret r;
            }
        }
        ti = ti + 1;
    }
    map.dnit[intern.StrId, ImportAttribution](?attrs);
    ret err[fail.Fail].ok{};
}

fun bind_import_libraries(p: *project.Project, mid: session.ModuleId, source: str,
                          attrs: *map.Map[intern.StrId, ImportAttribution],
                          start: u32, len: u32) err[fail.Fail] {
    val m: *project.ModuleEntry = ?p.modules[mid::u32];
    var i: u32 = 0;
    for (i < len) {
        val did: id.DeclId = m.a.decl_ids[start + i];
        if (!comptime.load_walked(?m.ctx, did)) { i = i + 1; cnt; }
        val d_opt: opt[*decl.Decl] = ast.get_decl_typed(m.a, did);
        if (sel d_opt.some) {
            val d: *decl.Decl = d_opt.some;
            if ((d.kind == decl.DECL_KIND_FUN
                 || d.kind == decl.DECL_KIND_VAL || d.kind == decl.DECL_KIND_VAR)
                && (d.flags & decl.DECL_FLAG_EXT) != 0) {
                val lib_opt: opt[intern.StrId] = session.export_library(p.s, mid, did::u32);
                if (sel lib_opt.some) {
                    val name_opt: opt[intern.StrId] = session.export_name_typed(p.s, mid, did::u32);
                    if (sel name_opt.none) {
                        ret err[fail.Fail].err{fail.message("internal: ext decl carries a #[library] attribution but no link name")};
                    }
                    val r: err[fail.Fail] = bind_one_import_library(p, mid, source,
                        attrs, d, name_opt.some,
                        lib_opt.some);
                    if (sel r.err) { ret r; }
                }
            }
            or (d.kind == decl.DECL_KIND_COMPTIME_IF) {
                val ci: *decl.DeclComptimeIf = ?d.data.comptime_if;
                var bi: u32 = 0;
                for (bi < ci.branches_len) {
                    val br: *decl.ComptimeBranch = ?m.a.comptime_branches[ci.branches_start + bi];
                    val rb: err[fail.Fail] = bind_import_libraries(p, mid, source, attrs,
                                                                       br.body_start, br.body_len);
                    if (sel rb.err) { ret rb; }
                    bi = bi + 1;
                }
            }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun bind_one_import_library(p: *project.Project, mid: session.ModuleId, source: str,
                            attrs: *map.Map[intern.StrId, ImportAttribution],
                            d: *decl.Decl, name: intern.StrId,
                            lib: intern.StrId) err[fail.Fail] {
    var here: ImportAttribution;
    here.module = session.module_fqn(p.s, mid);
    here.decl   = attribution_decl_name(p, source, d);
    here.lib    = lib;

    val prev: opt[*ImportAttribution] = map.get[intern.StrId, ImportAttribution](attrs, ?name);
    if (sel prev.some) {
        val had: *ImportAttribution = prev.some;
        if (had.lib == lib) { ret err[fail.Fail].ok{}; }
        ret err[fail.Fail].err{fail.message(attribution_conflict_message(p, name, had, ?here))};
    }

    val ins: res[bool, A.Error] = map.insert[intern.StrId, ImportAttribution](attrs, name, here);
    if (sel ins.err) { ret err[fail.Fail].err{fail.refused(ins.err)}; }
    ret session.register_import_library_typed(p.s, name, lib);
}

fun attribution_decl_name(p: *project.Project, source: str, d: *decl.Decl) intern.StrId {
    if (str_len(source) == 0) { ret intern.STR_NIL; }
    var span: token.Span;
    if (d.kind == decl.DECL_KIND_FUN) { span = d.data.fun_.name; }
    or { span = d.data.bind.name; }
    val r: res[intern.StrId, A.Error] = intern.intern_span_typed(?p.s.interner, source, span);
    if (sel r.err) { ret intern.STR_NIL; }
    ret r.ok;
}

fun attribution_conflict_message(p: *project.Project, name: intern.StrId,
                                 first: *ImportAttribution,
                                 second: *ImportAttribution) str {
    val n: opt[str] = intern.lookup_typed(?p.s.interner, name);
    val am: opt[str] = intern.lookup_typed(?p.s.interner, first.module);
    val ad: opt[str] = intern.lookup_typed(?p.s.interner, first.decl);
    val al: opt[str] = intern.lookup_typed(?p.s.interner, first.lib);
    val bm: opt[str] = intern.lookup_typed(?p.s.interner, second.module);
    val bd: opt[str] = intern.lookup_typed(?p.s.interner, second.decl);
    val bl: opt[str] = intern.lookup_typed(?p.s.interner, second.lib);
    if (!sel n.some) {
        ret "one import is attributed to two libraries by #[library]";
    }
    if (!sel am.some) {
        ret "one import is attributed to two libraries by #[library]";
    }
    if (!sel ad.some) {
        ret "one import is attributed to two libraries by #[library]";
    }
    if (!sel al.some) {
        ret "one import is attributed to two libraries by #[library]";
    }
    if (!sel bm.some) {
        ret "one import is attributed to two libraries by #[library]";
    }
    if (!sel bd.some) {
        ret "one import is attributed to two libraries by #[library]";
    }
    if (!sel bl.some) {
        ret "one import is attributed to two libraries by #[library]";
    }
    val r: res[str, string.StrError] = str_join(p.s.build_alloc,
        "import '", n.some, "' is attributed to library '",
        al.some, "' by declaration '", ad.some,
        "' in module '", am.some, "' and to library '",
        bl.some, "' by declaration '", bd.some,
        "' in module '", bm.some,
        "'; a symbol may name only one providing library");
    if (sel r.err) { ret outcome.str_text(r.err); }
    ret r.ok;
}

fun scan_export_directives(p: *project.Project, mid: session.ModuleId, source: str, start: u32, len: u32) err[fail.Fail] {
    val m: *project.ModuleEntry = ?p.modules[mid::u32];
    var i: u32 = 0;
    for (i < len) {
        val did: id.DeclId = m.a.decl_ids[start + i];
        if (!comptime.load_walked(?m.ctx, did)) { i = i + 1; cnt; }
        val d_opt: opt[*decl.Decl] = ast.get_decl_typed(m.a, did);
        if (sel d_opt.some) {
            val d: *decl.Decl = d_opt.some;
            if (d.kind == decl.DECL_KIND_FUN && (d.flags & decl.DECL_FLAG_EXT) != 0) {
                val r: err[fail.Fail] = register_ext_fun(p, mid, source, d, did);
                if (sel r.err) { ret r; }
            }
            or ((d.kind == decl.DECL_KIND_VAL || d.kind == decl.DECL_KIND_VAR)
                && (d.flags & decl.DECL_FLAG_EXT) != 0) {
                val r: err[fail.Fail] = register_ext_global(p, mid, source, d, did);
                if (sel r.err) { ret r; }
            }
            or (d.kind == decl.DECL_KIND_COMPTIME_IF) {
                val ci: *decl.DeclComptimeIf = ?d.data.comptime_if;
                var bi: u32 = 0;
                for (bi < ci.branches_len) {
                    val br: *decl.ComptimeBranch = ?m.a.comptime_branches[ci.branches_start + bi];
                    val rb: err[fail.Fail] = scan_export_directives(p, mid, source, br.body_start, br.body_len);
                    if (sel rb.err) { ret rb; }
                    bi = bi + 1;
                }
            }

            if (d.decorators_len > 0::u32) {
                val rd: err[fail.Fail] = register_decl_decorators(p, mid, source, d, did);
                if (sel rd.err) { ret rd; }
            }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun register_decl_decorators(p: *project.Project, mid: session.ModuleId, source: str, d: *decl.Decl, did: id.DeclId) err[fail.Fail] {
    val m: *project.ModuleEntry = ?p.modules[mid::u32];
    var k: u32 = 0;
    for (k < d.decorators_len) {
        val dec: *decl.Decorator = ?m.a.decorators[d.decorators_start + k];
        val is_symbol:  bool = project.span_eq_str(source, dec.name, "symbol");
        val is_library: bool = project.span_eq_str(source, dec.name, "library");

        if ((is_symbol || is_library) && dec.args_len == 1::u32) {
            val eid: id.ExprId = m.a.expr_ids[dec.args_start];
            val ve_opt: opt[*expr.Expr] = ast.get_expr_typed(m.a, eid);
            if (sel ve_opt.some) {
                val ve: *expr.Expr = ve_opt.some;
                if (ve.kind == expr.EXPR_KIND_LIT_STR && ve.span.len >= 2::usize) {
                    var inner: token.Span = ve.span;
                    inner.offset = inner.offset + 1::usize;
                    inner.len    = inner.len - 2::usize;

                    val name_r: res[intern.StrId, A.Error] = intern.intern_span_typed(?p.s.interner, source, inner);
                    if (sel name_r.err) { ret err[fail.Fail].err{fail.refused(name_r.err)}; }
                    val sid: intern.StrId = name_r.ok;

                    if (is_library) {
                        val rl: err[fail.Fail] = session.register_export_library(p.s, mid, did::u32, sid);
                        if (sel rl.err) { ret rl; }
                    } or {
                        val rn: err[fail.Fail] = session.register_export_name(p.s, mid, did::u32, sid);
                        if (sel rn.err) { ret rn; }
                    }
                }
            }
        }
        k = k + 1;
    }
    ret err[fail.Fail].ok{};
}

fun ext_link_name(p: *project.Project, source: str, span: token.Span) res[intern.StrId, fail.Fail] {
    val bare_r: res[intern.StrId, A.Error] = intern.intern_span_typed(?p.s.interner, source, span);
    if (sel bare_r.err) { ret res[intern.StrId, fail.Fail].err{fail.refused(bare_r.err)}; }
    ret project.link_name_for(p, bare_r.ok);
}

fun register_ext_fun(p: *project.Project, mid: session.ModuleId, source: str, d: *decl.Decl, did: id.DeclId) err[fail.Fail] {
    val export_name_typed_r: opt[intern.StrId] = session.export_name_typed(p.s, mid, did::u32);
    if (sel export_name_typed_r.some) { ret err[fail.Fail].ok{}; }
    val name_r: res[intern.StrId, fail.Fail] = ext_link_name(p, source, d.data.fun_.name);
    if (sel name_r.err) { ret err[fail.Fail].err{name_r.err}; }
    ret session.register_export_name(p.s, mid, did::u32, name_r.ok);
}

fun register_ext_global(p: *project.Project, mid: session.ModuleId, source: str, d: *decl.Decl, did: id.DeclId) err[fail.Fail] {
    val export_name_typed_r: opt[intern.StrId] = session.export_name_typed(p.s, mid, did::u32);
    if (sel export_name_typed_r.some) { ret err[fail.Fail].ok{}; }
    val name_r: res[intern.StrId, fail.Fail] = ext_link_name(p, source, d.data.bind.name);
    if (sel name_r.err) { ret err[fail.Fail].err{name_r.err}; }
    ret session.register_export_name(p.s, mid, did::u32, name_r.ok);
}

pub fun register_embed_inputs(p: *project.Project) err[fail.Fail] {
    var paths: vector.Vector[str] = vector.init[str](p.s.alloc);
    fin {
        var i: usize = 0;
        for (i < paths.len) { str_free(p.s.alloc, paths.data[i]); i = i + 1; }
        vector.dnit[str](?paths);
    }
    var i: u32 = 0;
    for (i < p.module_len) {
        val m: *project.ModuleEntry = ?p.modules[i];
        val m_opt: opt[*module.Module] = ast.get_module_typed(m.a, m.a.root_module);
        if (sel m_opt.some) {
            val mod_node: *module.Module = m_opt.some;
            val r: err[fail.Fail] = collect_embeds_in(p, m, mod_node.decls_start, mod_node.decls_len, ?paths);
            if (sel r.err) { ret r; }
        }
        i = i + 1;
    }
    var pi: usize = 0;
    for (pi < paths.len) {
        val refreshed: R.Result[intern.StrId, str] = embed.refresh(?p.s.embeds, ?p.s.queries, ?p.s.interner, paths.data[pi]);
        if (R.is_err[intern.StrId, str](refreshed)) { ret err[fail.Fail].err{fail.message(R.unwrap_err[intern.StrId, str](refreshed))}; }
        pi = pi + 1;
    }
    ret err[fail.Fail].ok{};
}

fun collect_embeds_in(p: *project.Project, m: *project.ModuleEntry, start: u32, len: u32, paths: *vector.Vector[str]) err[fail.Fail] {
    var i: u32 = 0;
    for (i < len) {
        val did: id.DeclId = m.a.decl_ids[start + i];
        if (!comptime.load_walked(?m.ctx, did)) { i = i + 1; cnt; }
        val d_opt: opt[*decl.Decl] = ast.get_decl_typed(m.a, did);
        if (sel d_opt.none) { i = i + 1; cnt; }
        val d: *decl.Decl = d_opt.some;

        if (d.kind == decl.DECL_KIND_COMPTIME_IF) {
            var b: u32 = 0;
            for (b < d.data.comptime_if.branches_len) {
                val br: *decl.ComptimeBranch = ?m.a.comptime_branches[d.data.comptime_if.branches_start + b];
                val r: err[fail.Fail] = collect_embeds_in(p, m, br.body_start, br.body_len, paths);
                if (sel r.err) { ret r; }
                b = b + 1;
            }
            i = i + 1;
            cnt;
        }

        var di: u32 = 0;
        for (di < d.decorators_len) {
            val dec: *decl.Decorator = ?m.a.decorators[d.decorators_start + di];
            if (embed_named(p, m, dec)) {
                val r: err[fail.Fail] = collect_embed_path(p, m, dec, paths);
                if (sel r.err) { ret r; }
            }
            di = di + 1;
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun embed_named(p: *project.Project, m: *project.ModuleEntry, dec: *decl.Decorator) bool {
    val src_opt: O.Option[*src.SourceFile] = src.get(?p.s.sources, m.file_id);
    if (O.is_none[*src.SourceFile](src_opt)) { ret false; }
    val source: str = O.unwrap[*src.SourceFile](src_opt).text;
    ret str_region_equals(source, dec.name.offset, dec.name.len, "embed");
}

fun collect_embed_path(p: *project.Project, m: *project.ModuleEntry, dec: *decl.Decorator, paths: *vector.Vector[str]) err[fail.Fail] {
    val src_opt: O.Option[*src.SourceFile] = src.get(?p.s.sources, m.file_id);
    if (O.is_none[*src.SourceFile](src_opt)) { ret err[fail.Fail].ok{}; }
    val f: *src.SourceFile = O.unwrap[*src.SourceFile](src_opt);
    if (f.path == nil) { ret err[fail.Fail].ok{}; }

    val span_opt: O.Option[token.Span] = embed.path_arg_span(m.a, dec);
    if (O.is_none[token.Span](span_opt)) { ret err[fail.Fail].ok{}; }
    val span: token.Span = O.unwrap[token.Span](span_opt);

    val ir: res[intern.StrId, A.Error] = intern.intern_span_typed(?p.s.interner, f.text, span);
    if (sel ir.err) { ret err[fail.Fail].err{fail.refused(ir.err)}; }
    val arg_opt: opt[str] = intern.lookup_typed(?p.s.interner, ir.ok);
    if (sel arg_opt.none) { ret err[fail.Fail].ok{}; }

    val pr: R.Result[str, manifest.TemplateError] = embed.resolve_arg(p.s.alloc, ?p.s.embeds, f.path, arg_opt.some);
    if (R.is_err[str, manifest.TemplateError](pr)) {
        val e: manifest.TemplateError = R.unwrap_err[str, manifest.TemplateError](pr);
        if (sel e.internal) {
            fail.internal(?m.load_status, e.internal);
            ret err[fail.Fail].err{fail.message(e.internal)};
        }
        manifest.template_error_dnit(p.s.alloc, e);
        ret err[fail.Fail].ok{};
    }
    val resolved: str = R.unwrap_ok[str, manifest.TemplateError](pr);

    val saved: res[usize, A.Error] = vector.push[str](paths, resolved);
    if (sel saved.err) {
        str_free(p.s.alloc, resolved);
        ret err[fail.Fail].err{fail.refused(saved.err)};
    }
    ret err[fail.Fail].ok{};
}
