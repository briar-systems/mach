# what the loaded modules declare for the phases after the load: each
# declaration's export and import link names, the strings its decorators
# evaluate to, and the files it embeds, recorded once the load walk has bound
# every constant a live declaration can name
use std.collections.map;
use collections_vector: std.collections.vector;
use std.text.string.str_dup;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use types_string: std.types.string;
use std.types.string.str;
use std.types.string.str_join;
use std.types.string.str_len;

use A: std.allocator;

use mach.lang.diagnostic;
use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.fail;
use mach.lang.fe.ast;
use ast_decl:   mach.lang.fe.ast.decl;
use ast_id:     mach.lang.fe.ast.id;
use ast_module: mach.lang.fe.ast.module;
use mach.lang.fe.decorator;
use fe_load: mach.lang.fe.load;
use mach.lang.intern;
use mach.lang.linkage;
use session_embed: mach.lang.session.embed;
use lang_source:   mach.lang.source;
use mach.lang.stack;

use mach.lang.driver.frontend;
use driver_load: mach.lang.driver.load;
use mach.lang.driver.project;
use comptime_scope: mach.lang.fe.comptime.scope;
use lang_module:    mach.lang.module;

pub fun register_export_names(p: *project.Project) err[fail.Fail] {
    var i: u32 = 0;
    for (i < project.module_count(p)) {
        val r: err[fail.Fail] = register_module_export_names(p, i::lang_module.ModuleId);
        if (sel r.err) { ret r; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun register_module_export_names(p: *project.Project, mid: lang_module.ModuleId) err[fail.Fail] {
    val m:   *project.ModuleEntry = project.module_at(p, mid::u32);
    val syn: *ast.Ast             = frontend.syntax(p, m);
    if (syn == nil) { ret err[fail.Fail].ok{}; }
    val m_opt: opt[*ast_module.Module] = ast.get_module(syn, syn.root_module);
    if (sel m_opt.none) { ret err[fail.Fail].ok{}; }
    val mod_node: *ast_module.Module = m_opt.some;

    val src_opt: opt[*lang_source.SourceFile] = lang_source.get(p.s.sources, m.file_id);
    if (sel src_opt.none) { ret err[fail.Fail].ok{}; }
    val source: str = src_opt.some.text;

    ret scan_export_directives(p, mid, source, mod_node.decls_start, mod_node.decls_len);
}

rec ImportAttribution {
    module: intern.StrId;
    decl:   intern.StrId;
    lib:    intern.StrId;
}

pub fun register_import_libraries(p: *project.Project) err[fail.Fail] {
    var attrs: map.Map[intern.StrId, ImportAttribution] =
        map.init[intern.StrId, ImportAttribution](p.alloc);
    fin { map.dnit[intern.StrId, ImportAttribution](?attrs); }
    var ti: u32 = 0;
    for (ti < p.emit_len) {
        val mid:   lang_module.ModuleId    = p.topo[ti];
        val m:     *project.ModuleEntry    = project.module_at(p, mid::u32);
        val syn:   *ast.Ast                = frontend.syntax(p, m);
        var m_opt: opt[*ast_module.Module] = opt[*ast_module.Module].none{};
        if (syn != nil) { m_opt = ast.get_module(syn, syn.root_module); }
        if (sel m_opt.some) {
            val mod_node: *ast_module.Module           = m_opt.some;
            var source:   str                          = "";
            val src_opt:  opt[*lang_source.SourceFile] = lang_source.get(p.s.sources, m.file_id);
            if (sel src_opt.some) {
                source = src_opt.some.text;
            }
            val r: err[fail.Fail] = bind_import_libraries(p, mid,
                source, ?attrs, mod_node.decls_start, mod_node.decls_len);
            if (sel r.err) { ret r; }
        }
        ti = ti + 1;
    }
    ret err[fail.Fail].ok{};
}

# the scans recurse as deep as declaring chains nest, so each asks for stack before it
# descends and refuses the chain it stands on
fun refuse_nesting(p: *project.Project, m: *project.ModuleEntry, span: lang_source.Span) fail.Fail {
    val r: err[fail.Fail] = diagnostic.report(?p.s.diags, diagnostic_kind.SYNTAX_NESTING_DEPTH, m.file_id, span,
        "input nests deeper than scanning a module's declarations descends; the stack has no room left to go deeper");
    if (sel r.err) { ret r.err; }
    ret fail.reported();
}

fun bind_import_libraries(p: *project.Project, mid: lang_module.ModuleId, source: str,
    attrs: *map.Map[intern.StrId, ImportAttribution],
    start: u32, len: u32) err[fail.Fail] {
    val m:   *project.ModuleEntry = project.module_at(p, mid::u32);
    val syn: *ast.Ast             = frontend.syntax(p, m);
    var i:   u32                  = 0;
    for (i < len) {
        val did: ast_id.DeclId = syn.decl_ids.data[start + i];
        if (!fe_load.walked(?m.load, did)) {
            i = i + 1;
            cnt;
        }
        val d_opt: opt[*ast_decl.Decl] = ast.get_decl(syn, did);
        if (sel d_opt.some) {
            val d: *ast_decl.Decl = d_opt.some;
            if ((d.kind == ast_decl.DECL_KIND_FUN
                || d.kind == ast_decl.DECL_KIND_VAL || d.kind == ast_decl.DECL_KIND_VAR)
                && (d.flags & ast_decl.DECL_FLAG_EXT) != 0) {
                val lib_opt: intern.StrId = linkage.export_library(?p.linkage, mid, did::u32);
                if (!intern.str_is_nil(lib_opt)) {
                    val name_opt: intern.StrId = linkage.export_name(?p.linkage, mid, did::u32);
                    if (intern.str_is_nil(name_opt)) {
                        ret err[fail.Fail].err{fail.message("internal: ext decl carries a #[library] attribution but no link name")};
                    }
                    val r: err[fail.Fail] = bind_one_import_library(p, mid, source,
                        attrs, d, name_opt,
                        lib_opt);
                    if (sel r.err) { ret r; }
                }
            }
            or (d.kind == ast_decl.DECL_KIND_COMPTIME_IF && stack.exhausted()) { ret err[fail.Fail].err{refuse_nesting(p, m, d.span)}; }
            or (d.kind == ast_decl.DECL_KIND_COMPTIME_IF) {
                val ci: *ast_decl.DeclComptimeIf = ?d.data.comptime_if;
                var bi: u32                      = 0;
                for (bi < ci.branches_len) {
                    val br: *ast_decl.ComptimeBranch = ?syn.comptime_branches.data[ci.branches_start + bi];
                    val rb: err[fail.Fail]           = bind_import_libraries(p, mid, source, attrs,
                        br.body_start, br.body_len);
                    if (sel rb.err) { ret rb; }
                    bi = bi + 1;
                }
            }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun bind_one_import_library(p: *project.Project, mid: lang_module.ModuleId, source: str,
    attrs: *map.Map[intern.StrId, ImportAttribution],
    d: *ast_decl.Decl, name: intern.StrId,
    lib: intern.StrId) err[fail.Fail] {
    val decl: res[intern.StrId, fail.Fail] = attribution_decl_name(p, source, d);
    if (sel decl.err) { ret err[fail.Fail].err{decl.err}; }
    var here: ImportAttribution;
    here.module = lang_module.module_fqn(?p.s.modules, mid);
    here.decl   = decl.ok;
    here.lib    = lib;

    val prev: opt[*ImportAttribution] = map.get[intern.StrId, ImportAttribution](attrs, ?name);
    if (sel prev.some) {
        val had: *ImportAttribution = prev.some;
        if (intern.str_same(had.lib, lib)) { ret err[fail.Fail].ok{}; }
        ret err[fail.Fail].err{fail.message_of(attribution_conflict_message(p, name, had, ?here))};
    }

    val ins: res[bool, A.Error] = map.insert[intern.StrId, ImportAttribution](attrs, name, here);
    if (sel ins.err) { ret err[fail.Fail].err{fail.refused(ins.err)}; }
    var sort: linkage.Sort = linkage.DATA;
    if (d.kind == ast_decl.DECL_KIND_FUN) { sort = linkage.CODE; }
    ret linkage.register_import_library(?p.linkage, name, lib, sort);
}

# the declaration's name, STR_NIL when no source names it
fun attribution_decl_name(p: *project.Project, source: str, d: *ast_decl.Decl) res[intern.StrId, fail.Fail] {
    if (str_len(source) == 0) { ret res[intern.StrId, fail.Fail].ok{intern.STR_NIL}; }
    var span: lang_source.Span;
    if (d.kind == ast_decl.DECL_KIND_FUN) { span = d.data.fun_.name; }
    or                                    { span = d.data.bind.name; }
    val r: res[intern.StrId, A.Error] = intern.range_add(?p.s.interner, source, span.offset, span.len);
    if (sel r.err) { ret res[intern.StrId, fail.Fail].err{fail.refused(r.err)}; }
    ret res[intern.StrId, fail.Fail].ok{r.ok};
}

fun attribution_decl_text(p: *project.Project, decl: intern.StrId) str {
    if (intern.str_is_nil(decl)) { ret ""; }
    ret intern.text(?p.s.interner, decl);
}

fun attribution_conflict_message(p: *project.Project, name: intern.StrId,
    first: *ImportAttribution,
    second: *ImportAttribution) res[str, fail.Fail] {
    val itn: *intern.Interner                = ?p.s.interner;
    val r:   res[str, types_string.StrError] = str_join(p.s.build_alloc,
        "import '", intern.text(itn, name), "' is attributed to library '",
        intern.text(itn, first.lib), "' by declaration '", attribution_decl_text(p, first.decl),
        "' in module '", intern.text(itn, first.module), "' and to library '",
        intern.text(itn, second.lib), "' by declaration '", attribution_decl_text(p, second.decl),
        "' in module '", intern.text(itn, second.module),
        "'; a symbol may name only one providing library");
    if (sel r.err) { ret res[str, fail.Fail].err{fail.str_refused(r.err)}; }
    ret res[str, fail.Fail].ok{r.ok};
}

fun scan_export_directives(p: *project.Project, mid: lang_module.ModuleId, source: str, start: u32, len: u32) err[fail.Fail] {
    val m:   *project.ModuleEntry = project.module_at(p, mid::u32);
    val syn: *ast.Ast             = frontend.syntax(p, m);
    var i:   u32                  = 0;
    for (i < len) {
        val did: ast_id.DeclId = syn.decl_ids.data[start + i];
        if (!fe_load.walked(?m.load, did)) {
            i = i + 1;
            cnt;
        }
        val d_opt: opt[*ast_decl.Decl] = ast.get_decl(syn, did);
        if (sel d_opt.some) {
            val d: *ast_decl.Decl = d_opt.some;
            if (d.kind == ast_decl.DECL_KIND_FUN && (d.flags & ast_decl.DECL_FLAG_EXT) != 0) {
                val r: err[fail.Fail] = register_ext_fun(p, mid, source, d, did);
                if (sel r.err) { ret r; }
            }
            or ((d.kind == ast_decl.DECL_KIND_VAL || d.kind == ast_decl.DECL_KIND_VAR)
                && (d.flags & ast_decl.DECL_FLAG_EXT) != 0) {
                val r: err[fail.Fail] = register_ext_global(p, mid, source, d, did);
                if (sel r.err) { ret r; }
            }
            or (d.kind == ast_decl.DECL_KIND_COMPTIME_IF && stack.exhausted()) { ret err[fail.Fail].err{refuse_nesting(p, m, d.span)}; }
            or (d.kind == ast_decl.DECL_KIND_COMPTIME_IF) {
                val ci: *ast_decl.DeclComptimeIf = ?d.data.comptime_if;
                var bi: u32                      = 0;
                for (bi < ci.branches_len) {
                    val br: *ast_decl.ComptimeBranch = ?syn.comptime_branches.data[ci.branches_start + bi];
                    val rb: err[fail.Fail]           = scan_export_directives(p, mid, source, br.body_start, br.body_len);
                    if (sel rb.err) { ret rb; }
                    bi = bi + 1;
                }
            }

            if (d.decorators_len > 0::u32) {
                val rd: err[fail.Fail] = register_decl_decorators(p, mid, d, did);
                if (sel rd.err) { ret rd; }
            }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun register_decl_decorators(p: *project.Project, mid: lang_module.ModuleId, d: *ast_decl.Decl, did: ast_id.DeclId) err[fail.Fail] {
    val m:   *project.ModuleEntry = project.module_at(p, mid::u32);
    val syn: *ast.Ast             = frontend.syntax(p, m);
    var k:   u32                  = 0;
    for (k < d.decorators_len) {
        val dec:        *ast_decl.Decorator = ?syn.decorators.data[d.decorators_start + k];
        val is_symbol:  bool                = dec.id == decorator.SYMBOL || dec.id == decorator.WEAK;
        val is_library: bool                = dec.id == decorator.LIBRARY;

        if ((is_symbol || is_library) && dec.args_len == 1::u32) {
            val named: intern.StrId = decorator.string_id(?m.load.ctx, syn, dec, 0);
            if (!intern.str_is_nil(named)) {
                if (is_library) {
                    val rl: err[fail.Fail] = linkage.register_export_library(?p.linkage, mid, did::u32, named);
                    if (sel rl.err) { ret rl; }
                }
                or {
                    # a symbol's name is a C name, which the target's objects spell with its prefix
                    val linked: res[intern.StrId, fail.Fail] = project.link_name_for(p, named);
                    if (sel linked.err) { ret err[fail.Fail].err{linked.err}; }
                    val rn: err[fail.Fail] = linkage.register_export_name(?p.linkage, mid, did::u32, linked.ok);
                    if (sel rn.err) { ret rn; }
                }
            }
        }
        k = k + 1;
    }
    ret err[fail.Fail].ok{};
}

fun ext_link_name(p: *project.Project, source: str, span: lang_source.Span) res[intern.StrId, fail.Fail] {
    val bare_r: res[intern.StrId, A.Error] = intern.range_add(?p.s.interner, source, span.offset, span.len);
    if (sel bare_r.err) { ret res[intern.StrId, fail.Fail].err{fail.refused(bare_r.err)}; }
    ret project.link_name_for(p, bare_r.ok);
}

fun register_ext_fun(p: *project.Project, mid: lang_module.ModuleId, source: str, d: *ast_decl.Decl, did: ast_id.DeclId) err[fail.Fail] {
    val export_name_r: intern.StrId = linkage.export_name(?p.linkage, mid, did::u32);
    if (!intern.str_is_nil(export_name_r)) { ret err[fail.Fail].ok{}; }
    val name_r: res[intern.StrId, fail.Fail] = ext_link_name(p, source, d.data.fun_.name);
    if (sel name_r.err) { ret err[fail.Fail].err{name_r.err}; }
    ret linkage.register_export_name(?p.linkage, mid, did::u32, name_r.ok);
}

fun register_ext_global(p: *project.Project, mid: lang_module.ModuleId, source: str, d: *ast_decl.Decl, did: ast_id.DeclId) err[fail.Fail] {
    val export_name_r: intern.StrId = linkage.export_name(?p.linkage, mid, did::u32);
    if (!intern.str_is_nil(export_name_r)) { ret err[fail.Fail].ok{}; }
    val name_r: res[intern.StrId, fail.Fail] = ext_link_name(p, source, d.data.bind.name);
    if (sel name_r.err) { ret err[fail.Fail].err{name_r.err}; }
    ret linkage.register_export_name(?p.linkage, mid, did::u32, name_r.ok);
}

# the string every decorator argument that takes one evaluates to, recorded for
# each later phase to read. it runs once the load walk has bound every constant
# a live declaration can name; an argument that is not a constant string is
# left out, and type checking reports it where it stands
pub fun decorator_strings_register(p: *project.Project) err[fail.Fail] {
    var i: u32 = 0;
    for (i < project.module_count(p)) {
        val r: err[fail.Fail] = driver_load.decorators_record(p, i::lang_module.ModuleId);
        if (sel r.err) { ret r; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

pub fun register_embed_inputs(p: *project.Project) err[fail.Fail] {
    var paths: collections_vector.Vector[str] = collections_vector.init[str](p.s.alloc);
    fin {
        var i: usize = 0;
        for (i < paths.len) {
            str_free(p.s.alloc, paths.data[i]);
            i = i + 1;
        }
        collections_vector.dnit[str](?paths);
    }
    var i: u32 = 0;
    for (i < project.module_count(p)) {
        val m:     *project.ModuleEntry    = project.module_at(p, i);
        val syn:   *ast.Ast                = frontend.syntax(p, m);
        var m_opt: opt[*ast_module.Module] = opt[*ast_module.Module].none{};
        if (syn != nil) { m_opt = ast.get_module(syn, syn.root_module); }
        if (sel m_opt.some) {
            val mod_node: *ast_module.Module = m_opt.some;
            val r:        err[fail.Fail]     = collect_embeds_in(p, i::lang_module.ModuleId, mod_node.decls_start, mod_node.decls_len, ?paths);
            if (sel r.err) { ret r; }
        }
        i = i + 1;
    }
    var pi: usize = 0;
    for (pi < paths.len) {
        val refreshed: res[intern.StrId, fail.Fail] = session_embed.refresh(?p.s.embeds, ?p.s.queries, ?p.s.interner, paths.data[pi]);
        if (sel refreshed.err) { ret err[fail.Fail].err{refreshed.err}; }
        pi = pi + 1;
    }
    ret err[fail.Fail].ok{};
}

# the resolved paths of the files module m embeds, each owned by the caller in p.s.alloc
pub fun module_embeds(p: *project.Project, mid: lang_module.ModuleId, paths: *collections_vector.Vector[str]) err[fail.Fail] {
    val m:   *project.ModuleEntry = project.module_at(p, mid::u32);
    val syn: *ast.Ast             = frontend.syntax(p, m);
    if (syn == nil) { ret err[fail.Fail].ok{}; }
    val m_opt: opt[*ast_module.Module] = ast.get_module(syn, syn.root_module);
    if (sel m_opt.none) { ret err[fail.Fail].ok{}; }
    ret collect_embeds_in(p, mid, m_opt.some.decls_start, m_opt.some.decls_len, paths);
}

fun collect_embeds_in(p: *project.Project, mid: lang_module.ModuleId, start: u32, len: u32, paths: *collections_vector.Vector[str]) err[fail.Fail] {
    val m:   *project.ModuleEntry = project.module_at(p, mid::u32);
    val syn: *ast.Ast             = frontend.syntax(p, m);
    var i:   u32                  = 0;
    for (i < len) {
        val did: ast_id.DeclId = syn.decl_ids.data[start + i];
        if (!fe_load.walked(?m.load, did)) {
            i = i + 1;
            cnt;
        }
        val d_opt: opt[*ast_decl.Decl] = ast.get_decl(syn, did);
        if (sel d_opt.none) {
            i = i + 1;
            cnt;
        }
        val d: *ast_decl.Decl = d_opt.some;

        if (d.kind == ast_decl.DECL_KIND_COMPTIME_IF) {
            if (stack.exhausted()) { ret err[fail.Fail].err{refuse_nesting(p, m, d.span)}; }
            var b: u32 = 0;
            for (b < d.data.comptime_if.branches_len) {
                val br: *ast_decl.ComptimeBranch = ?syn.comptime_branches.data[d.data.comptime_if.branches_start + b];
                val r:  err[fail.Fail]           = collect_embeds_in(p, mid, br.body_start, br.body_len, paths);
                if (sel r.err) { ret r; }
                b = b + 1;
            }
            i = i + 1;
            cnt;
        }

        var di: u32 = 0;
        for (di < d.decorators_len) {
            val dec: *ast_decl.Decorator = ?syn.decorators.data[d.decorators_start + di];
            if (dec.id == decorator.EMBED) {
                val r: err[fail.Fail] = collect_embed_path(p, mid, dec, paths);
                if (sel r.err) { ret r; }
            }
            di = di + 1;
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# the path the load resolved an `embed` argument to, when it names a file the build reads
fun collect_embed_path(p: *project.Project, mid: lang_module.ModuleId, dec: *ast_decl.Decorator, paths: *collections_vector.Vector[str]) err[fail.Fail] {
    val m:   *project.ModuleEntry = project.module_at(p, mid::u32);
    val syn: *ast.Ast             = frontend.syntax(p, m);
    if (dec.args_len == 0) { ret err[fail.Fail].ok{}; }
    val file: intern.StrId = comptime_scope.decorator_embed_file(?m.load.ctx, syn.expr_ids.data[dec.args_start]);
    if (intern.str_is_nil(file)) { ret err[fail.Fail].ok{}; }
    val copied: res[str, A.Error] = str_dup(p.s.alloc, intern.text(?p.s.interner, file));
    if (sel copied.err) { ret err[fail.Fail].err{fail.refused(copied.err)}; }
    val saved: res[usize, A.Error] = collections_vector.push[str](paths, copied.ok);
    if (sel saved.err) {
        str_free(p.s.alloc, copied.ok);
        ret err[fail.Fail].err{fail.refused(saved.err)};
    }
    ret err[fail.Fail].ok{};
}
