rec GitEntry {
    path: str;
    mode: str;
}

# one checked-out tree's committed entries, as `git ls-tree -r -t --full-tree HEAD` lists
# them: repository-relative paths with their object modes, sorted by path
rec GitTree {
    dir:     str;
    entries: Vector[GitEntry];
}

# an inspector spawns git with one environment and answers every committed-mode question
# about a checkout from one tree listing, so verification costs a constant number of git
# processes per checkout rather than one per walked path (#3471). a command that can move
# a checkout drops the listings.
rec GitInspector {
    program:       str;
    inherited_env: **u8;
    alloc:         *A.Allocator;
    env_ready:     bool;
    env_config:    **u8;
    env_inherited: **u8;
    env:           child_env.Strings;
    trees:         Vector[GitTree];
    trees_ready:   bool;
}

fun git_inspector_init(alloc: *A.Allocator) res[GitInspector, outcome.Fail] {
    val rr: res[str, exec.Error] = exec.resolve(alloc, "git");
    if (sel rr.err) { ret res[GitInspector, outcome.Fail].err{outcome.user("git not found on PATH; dependency verification requires Git")}; }
    val inherited: **u8 = env.environ();
    if (inherited == nil) {
        str_free(alloc, rr.ok);
        ret res[GitInspector, outcome.Fail].err{outcome.user("Git dependency environment unavailable")};
    }
    ret res[GitInspector, outcome.Fail].ok{GitInspector{program: rr.ok, inherited_env: inherited, alloc: alloc}};
}

fun git_tree_free(alloc: *A.Allocator, t: *GitTree) {
    str_free(alloc, t.dir);
    var i: usize = 0;
    for (i < t.entries.len) {
        str_free(alloc, t.entries.data[i].path);
        str_free(alloc, t.entries.data[i].mode);
        i = i + 1;
    }
    vector.dnit[GitEntry](?t.entries);
}

fun git_inspector_drop_trees(gi: *GitInspector) {
    if (!gi.trees_ready) { ret; }
    var i: usize = 0;
    for (i < gi.trees.len) {
        git_tree_free(gi.alloc, ?gi.trees.data[i]);
        i = i + 1;
    }
    vector.dnit[GitTree](?gi.trees);
    gi.trees_ready = false;
}

fun git_inspector_dnit(alloc: *A.Allocator, gi: *GitInspector) {
    git_inspector_drop_trees(gi);
    if (gi.env_ready) { child_env.strings_free(gi.alloc, ?gi.env); }
    gi.env_ready = false;
    str_free(alloc, gi.program);
    gi.program       = nil;
    gi.inherited_env = nil;
}

rec GitBytes {
    data: *u8;
    len:  usize;
}

fun git_bytes_free(alloc: *A.Allocator, bytes: *GitBytes) {
    if (bytes.data != nil) { A.deallocate[u8](alloc, bytes.data, bytes.len + 1); }
    bytes.data = nil;
    bytes.len  = 0;
}

fun captured_bytes(alloc: *A.Allocator, p: *subprocess.OwnedSubprocess, trim_line_end: bool) res[GitBytes, outcome.Fail] {
    var n:   usize = 0;
    val src: *u8   = subprocess.capture_bytes(p, ?n);
    for (trim_line_end && n > 0 && (src[n - 1] == '\n' || src[n - 1] == '\r')) { n = n - 1; }
    val ar: res[*u8, A.Error] = A.allocate[u8](alloc, n + 1);
    if (sel ar.err) { ret res[GitBytes, outcome.Fail].err{outcome.refused(ar.err)}; }
    val out: *u8   = ar.ok;
    var i:   usize = 0;
    for (i < n) {
        out[i] = src[i];
        i      = i + 1;
    }
    out[n] = 0;
    ret res[GitBytes, outcome.Fail].ok{GitBytes{data: out, len: n}};
}

fun git_capture_cleanup(alloc: *A.Allocator, temp: *fs.TempFile, child: *subprocess.OwnedSubprocess, release: bool) {
    if (release) { subprocess.release_capture(alloc, child); }
    subprocess.dnit(alloc, child);
    fs.temp_remove(temp);
    str_free(alloc, fs.temp_path(temp));
}

fun count_nil_terminated(arr: **u8) usize {
    if (arr == nil) { ret 0; }
    var n: usize = 0;
    for (arr[n] != nil) { n = n + 1; }
    ret n;
}

var git_config_env: **u8 = nil;

pub fun set_git_config_env(env: **u8) {
    git_config_env = env;
}

# compare reserved key segments through the host's environment name identity
fun git_env_prefix(alloc: *A.Allocator, entry: *u8, prefix: str) res[bool, outcome.Fail] {
    val prefix_size: usize = str_len(prefix);
    val exact:       bool  = prefix[prefix_size - 1] == '=';
    var wanted:      usize = 0;
    var i:           usize = 0;
    for (i < prefix_size) {
        if (prefix[i] == '_') { wanted = wanted + 1; }
        i = i + 1;
    }
    var size:  usize = 0;
    var parts: usize = 0;
    for (entry[size] != 0 && entry[size] != '=') {
        if (!exact && entry[size] == '_') {
            parts = parts + 1;
            if (parts == wanted) {
                size = size + 1;
                brk;
            }
        }
        size = size + 1;
    }
    var compared: usize = prefix_size;
    if (exact) {
        if (entry[size] != '=') { ret res[bool, outcome.Fail].ok{false}; }
        compared = compared - 1;
    }
    or (parts != wanted) { ret res[bool, outcome.Fail].ok{false}; }
    val lr: res[str, string.StrError] = str_copy_slice(alloc, entry::str, 0, size);
    if (sel lr.err) { ret res[bool, outcome.Fail].err{outcome.user(outcome.str_text(lr.err))}; }
    val left: str = lr.ok;
    fin { str_free(alloc, left); }
    val rr: res[str, string.StrError] = str_copy_slice(alloc, prefix, 0, compared);
    if (sel rr.err) { ret res[bool, outcome.Fail].err{outcome.user(outcome.str_text(rr.err))}; }
    val right: str = rr.ok;
    fin { str_free(alloc, right); }
    val order: res[i32, env.EnvError] = env.compare_names(left, right);
    if (sel order.err) { ret res[bool, outcome.Fail].err{outcome.user(outcome.env_text(order.err))}; }
    ret res[bool, outcome.Fail].ok{order.ok == 0};
}

fun env_names_git_config(alloc: *A.Allocator, entry: *u8) res[bool, outcome.Fail] {
    var prefixes: [3]str = [3]str{"GIT_CONFIG_COUNT=", "GIT_CONFIG_KEY_", "GIT_CONFIG_VALUE_"};
    var i:        usize  = 0;
    for (i < 3) {
        val found: res[bool, outcome.Fail] = git_env_prefix(alloc, entry, prefixes[i]);
        if (sel found.err) { ret found; }
        if (found.ok)      { ret found; }
        i = i + 1;
    }
    ret res[bool, outcome.Fail].ok{false};
}

fun git_inherits_env(alloc: *A.Allocator, entry: *u8, config_override: bool) res[bool, outcome.Fail] {
    val family: res[bool, outcome.Fail] = git_env_prefix(alloc, entry, "GIT_");
    if (sel family.err) { ret res[bool, outcome.Fail].err{family.err}; }
    if (!family.ok)     { ret res[bool, outcome.Fail].ok{true}; }
    val config: res[bool, outcome.Fail] = env_names_git_config(alloc, entry);
    if (sel config.err) { ret res[bool, outcome.Fail].err{config.err}; }
    if (config.ok)      { ret res[bool, outcome.Fail].ok{!config_override}; }
    var allowed: [5]str = [5]str{"GIT_CONFIG_GLOBAL=", "GIT_CONFIG_SYSTEM=", "GIT_CONFIG_NOSYSTEM=", "GIT_ATTR_NOSYSTEM=", "GIT_CONFIG_PARAMETERS="};
    var count:   usize  = 5;
    if (config_override) { count = 4; }
    var i: usize = 0;
    for (i < count) {
        val found: res[bool, outcome.Fail] = git_env_prefix(alloc, entry, allowed[i]);
        if (sel found.err) { ret found; }
        if (found.ok)      { ret found; }
        i = i + 1;
    }
    ret res[bool, outcome.Fail].ok{false};
}

fun git_environment(alloc: *A.Allocator, inherited: **u8, extras: **u8) res[child_env.Strings, outcome.Fail] {
    var values: child_env.Environment = child_env.init(alloc);
    fin { child_env.dnit(?values); }
    var override: bool  = false;
    var i:        usize = 0;
    for (extras != nil && extras[i] != nil) {
        val config: res[bool, outcome.Fail] = env_names_git_config(alloc, extras[i]);
        if (sel config.err) { ret res[child_env.Strings, outcome.Fail].err{config.err}; }
        if (config.ok)      { override = true; }
        i = i + 1;
    }
    var configured: **u8 = git_config_env;
    if (override) { configured = nil; }
    val inherited_override: bool              = override || count_nil_terminated(configured) != 0;
    val locks:              err[outcome.Fail] = child_env.put(?values, "GIT_OPTIONAL_LOCKS", "0", true);
    if (sel locks.err) { ret res[child_env.Strings, outcome.Fail].err{locks.err}; }
    val prompt: err[outcome.Fail] = child_env.put(?values, "GIT_TERMINAL_PROMPT", "0", true);
    if (sel prompt.err) { ret res[child_env.Strings, outcome.Fail].err{prompt.err}; }
    var layers: [3]**u8 = [3]**u8{inherited, extras, configured};
    var layer:  usize   = 0;
    for (layer < 3) {
        val entries: **u8 = layers[layer];
        i = 0;
        for (entries != nil && entries[i] != nil) {
            val suppress_config: bool                    = layer == 0 && inherited_override;
            val keep:            res[bool, outcome.Fail] = git_inherits_env(alloc, entries[i], suppress_config);
            if (sel keep.err) { ret res[child_env.Strings, outcome.Fail].err{keep.err}; }
            if (keep.ok) {
                val added: err[outcome.Fail] = child_env.put_entry(?values, entries[i]::str, layer != 0);
                if (sel added.err) { ret res[child_env.Strings, outcome.Fail].err{added.err}; }
            }
            i = i + 1;
        }
        layer = layer + 1;
    }
    ret child_env.to_strings(?values);
}

fun git_command_text(alloc: *A.Allocator, args: **u8) res[str, format.FormatError] {
    val first: res[str, format.FormatError] = format.sprint(alloc, "git");
    if (sel first.err) { ret first; }
    var text: str   = first.ok;
    var i:    usize = 0;
    for (args[i] != nil) {
        val longer: res[str, format.FormatError] = format.sprint(alloc, "{} {}", text, args[i]::str);
        str_free(alloc, text);
        if (sel longer.err) { ret longer; }
        text = longer.ok;
        i    = i + 1;
    }
    ret res[str, format.FormatError].ok{text};
}

# the failure of a git command names the command, how it ended, and what git printed
fun git_failure(alloc: *A.Allocator, child: *subprocess.OwnedSubprocess, args: **u8,
    terminal: subprocess.SubprocessTerminal) outcome.Fail {
    val command: res[str, format.FormatError] = git_command_text(alloc, args);
    if (sel command.err) { ret outcome.user("a Git dependency command failed"); }
    fin { str_free(alloc, command.ok); }
    var ended: res[str, format.FormatError];
    if (terminal.kind == subprocess.STATE_EXITED) { ended = format.sprint(alloc, "`{}` exited with status {}", command.ok, terminal.code); }
    or                                            { ended = format.sprint(alloc, "`{}` did not exit normally", command.ok); }
    if (sel ended.err)                            { ret outcome.user("a Git dependency command failed"); }
    val output: res[GitBytes, outcome.Fail] = captured_bytes(alloc, child, true);
    if (sel output.err) { ret outcome.user(ended.ok); }
    var bytes: GitBytes = output.ok;
    fin { git_bytes_free(alloc, ?bytes); }
    var start: usize = 0;
    for (start < bytes.len && (bytes.data[start] == '\n' || bytes.data[start] == '\r' || bytes.data[start] == ' ')) { start = start + 1; }
    if (start == bytes.len || str_len(bytes.data::str) != bytes.len) { ret outcome.user(ended.ok); }
    val full: res[str, format.FormatError] = format.sprint(alloc, "{}: {}", ended.ok, (?bytes.data[start])::str);
    if (sel full.err) { ret outcome.user(ended.ok); }
    str_free(alloc, ended.ok);
    ret outcome.user(full.ok);
}

fun git_run_capture(alloc: *A.Allocator, gi: *GitInspector, argv: **u8, shown: **u8, trim_line_end: bool, extra_env: **u8, stdin_fd: usize, capture_stderr: bool) res[GitBytes, outcome.Fail] {
    val tr: res[fs.TempFile, fs.FsError] = fs.temp_create(alloc, "mach_dep_verify");
    if (sel tr.err) { ret res[GitBytes, outcome.Fail].err{outcome.user(outcome.fs_text(tr.err))}; }
    var temp:         fs.TempFile         = tr.ok;
    val temp_close_r: err[io_error.Error] = fs.temp_close(?temp);
    if (sel temp_close_r.err) {
        fs.temp_remove(?temp);
        str_free(alloc, fs.temp_path(?temp));
        ret res[GitBytes, outcome.Fail].err{outcome.user("failed to close dependency verification capture")};
    }

    var child: subprocess.OwnedSubprocess;
    subprocess.init(?child);
    if (!git_argv_reads_only(argv)) { git_inspector_drop_trees(gi); }
    var shared: bool = extra_env == nil && gi.alloc != nil;
    if (shared && gi.env_ready && (gi.env_config != git_config_env || gi.env_inherited != gi.inherited_env)) {
        child_env.strings_free(gi.alloc, ?gi.env);
        gi.env_ready = false;
    }
    if (shared && !gi.env_ready) {
        val built: res[child_env.Strings, outcome.Fail] = git_environment(gi.alloc, gi.inherited_env, nil);
        if (sel built.err) {
            git_capture_cleanup(alloc, ?temp, ?child, false);
            ret res[GitBytes, outcome.Fail].err{built.err};
        }
        gi.env           = built.ok;
        gi.env_config    = git_config_env;
        gi.env_inherited = gi.inherited_env;
        gi.env_ready     = true;
    }
    var git_env: child_env.Strings;
    if (shared) { git_env = gi.env; }
    or {
        val env_r: res[child_env.Strings, outcome.Fail] = git_environment(alloc, gi.inherited_env, extra_env);
        if (sel env_r.err) {
            git_capture_cleanup(alloc, ?temp, ?child, false);
            ret res[GitBytes, outcome.Fail].err{env_r.err};
        }
        git_env = env_r.ok;
    }
    fin {
        if (!shared) { child_env.strings_free(alloc, ?git_env); }
    }
    val sr: err[subprocess.Error] = subprocess.spawn_captured_input(alloc, ?child, gi.program, argv,
        git_env.items, stdin_fd, capture_stderr, fs.temp_path(?temp), 1048576);
    if (sel sr.err) {
        git_capture_cleanup(alloc, ?temp, ?child, false);
        ret res[GitBytes, outcome.Fail].err{outcome.user(subprocess.text(alloc, sr.err))};
    }
    val wr: res[subprocess.SubprocessTerminal, subprocess.Error] = subprocess.wait(alloc, ?child);
    if (sel wr.err) {
        subprocess.abandon_capture(?child);
        git_capture_cleanup(alloc, ?temp, ?child, false);
        ret res[GitBytes, outcome.Fail].err{outcome.user(subprocess.text(alloc, wr.err))};
    }
    val terminal: subprocess.SubprocessTerminal                     = wr.ok;
    val cr:       res[subprocess.CaptureIoResult, subprocess.Error] = subprocess.finish_capture(alloc, ?child, true);
    if (sel cr.err) {
        git_capture_cleanup(alloc, ?temp, ?child, false);
        ret res[GitBytes, outcome.Fail].err{outcome.user(subprocess.text(alloc, cr.err))};
    }
    val cap: subprocess.CaptureIoResult = cr.ok;
    if (cap.read_failed || cap.write_failed || cap.close_failed || cap.short_read || cap.truncated) {
        git_capture_cleanup(alloc, ?temp, ?child, true);
        ret res[GitBytes, outcome.Fail].err{outcome.user("Git dependency inspection output could not be captured completely")};
    }
    if (terminal.kind != subprocess.STATE_EXITED || terminal.code != 0) {
        val failed: outcome.Fail = git_failure(alloc, ?child, shown, terminal);
        git_capture_cleanup(alloc, ?temp, ?child, true);
        ret res[GitBytes, outcome.Fail].err{failed};
    }
    val out_r: res[GitBytes, outcome.Fail] = captured_bytes(alloc, ?child, trim_line_end);
    git_capture_cleanup(alloc, ?temp, ?child, true);
    ret out_r;
}

# the subcommand after git's leading `-c <k=v>` and `-C <dir>` options
fun git_argv_subcommand(argv: **u8) str {
    var i: usize = 1;
    for (argv[i] != nil && (str_equals(argv[i]::str, "-c") || str_equals(argv[i]::str, "-C"))) {
        if (argv[i + 1] == nil) { ret ""; }
        i = i + 2;
    }
    if (argv[i] == nil) { ret ""; }
    ret argv[i]::str;
}

# whether a git command leaves every checkout's HEAD and tree where they were
fun git_argv_reads_only(argv: **u8) bool {
    val sub: str = git_argv_subcommand(argv);
    ret str_equals(sub, "ls-tree") || str_equals(sub, "rev-parse") || str_equals(sub, "status")
        || str_equals(sub, "ls-files") || str_equals(sub, "cat-file") || str_equals(sub, "config");
}

fun git_query_capture(alloc: *A.Allocator, gi: *GitInspector, dir: str, args: *str, count: usize,
    trim_line_end: bool, extra_env: **u8, stdin_fd: usize, capture_stderr: bool) res[GitBytes, outcome.Fail] {
    val ar: res[**u8, A.Error] = A.allocate[*u8](alloc, count + 8);
    if (sel ar.err) { ret res[GitBytes, outcome.Fail].err{outcome.refused(ar.err)}; }
    val argv: **u8 = ar.ok;
    argv[0] = gi.program::*u8;
    argv[1] = "-c";
    argv[2] = "core.fsmonitor=false";
    argv[3] = "-c";
    argv[4] = "core.untrackedCache=false";
    argv[5] = "-C";
    argv[6] = dir::*u8;
    var i: usize = 0;
    for (i < count) {
        argv[i + 7] = args[i]::*u8;
        i           = i + 1;
    }
    argv[count + 7] = nil;
    val rr: res[GitBytes, outcome.Fail] = git_run_capture(alloc, gi, argv, ?argv[7], trim_line_end, extra_env, stdin_fd, capture_stderr);
    A.deallocate[*u8](alloc, argv, count + 8);
    ret rr;
}

fun git_query_mode(alloc: *A.Allocator, gi: *GitInspector, dir: str, args: *str, count: usize,
    trim_line_end: bool, extra_env: **u8) res[str, outcome.Fail] {
    val r: res[GitBytes, outcome.Fail] = git_query_capture(alloc, gi, dir, args, count, trim_line_end, extra_env, os.INVALID_HANDLE, true);
    if (sel r.err) { ret res[str, outcome.Fail].err{r.err}; }
    var bytes: GitBytes = r.ok;
    if (str_len(bytes.data::str) != bytes.len) {
        git_bytes_free(alloc, ?bytes);
        ret res[str, outcome.Fail].err{outcome.user("Git text output contains an embedded nul byte")};
    }
    ret res[str, outcome.Fail].ok{bytes.data::str};
}

fun git_query(alloc: *A.Allocator, gi: *GitInspector, dir: str, args: *str, count: usize) res[str, outcome.Fail] {
    ret git_query_mode(alloc, gi, dir, args, count, true, nil);
}

fun git_query_raw(alloc: *A.Allocator, gi: *GitInspector, dir: str, args: *str, count: usize) res[str, outcome.Fail] {
    ret git_query_mode(alloc, gi, dir, args, count, false, nil);
}

fun git_op(alloc: *A.Allocator, gi: *GitInspector, dir: str, args: *str, count: usize, extra_env: **u8) res[str, outcome.Fail] {
    ret git_query_mode(alloc, gi, dir, args, count, true, extra_env);
}

fun free_name_vector(alloc: *A.Allocator, names: *Vector[str]) {
    var i: usize = 0;
    for (i < names.len) {
        str_free(alloc, names.data[i]);
        i = i + 1;
    }
    vector.dnit[str](names);
}

fun cmp_dep_name(a: *str, b: *str) i64 {
    ret str_compare(@a, @b);
}

fun symlink_seen(links: *Vector[str], rel: str) bool {
    var i: usize = 0;
    for (i < links.len) {
        if (str_equals(links.data[i], rel)) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun git_symlink_target(s: *session.Session, gi: *GitInspector, alias: str, git_dir: str,
    git_prefix: str, rel: str) res[str, outcome.Fail] {
    val spec_r: res[str, format.FormatError] = format.sprint(s.build_alloc, "HEAD:{}{}", git_prefix, rel);
    if (sel spec_r.err) { ret res[str, outcome.Fail].err{outcome.user(outcome.format_text(spec_r.err))}; }
    val spec: str = spec_r.ok;
    var args: [3]str;
    args[0] = "cat-file";
    args[1] = "-p";
    args[2] = spec;
    val raw_r: res[str, outcome.Fail] = git_query_raw(s.build_alloc, gi, git_dir, ?args[0], 3);
    str_free(s.build_alloc, spec);
    if (sel raw_r.ok) { ret raw_r; }
    val msg_r: res[str, format.FormatError] = format.sprint(s.build_alloc,
        "dependency '{}': cannot verify tracked symlink target: {}", alias, outcome.describe(raw_r.err));
    if (sel msg_r.err) { ret res[str, outcome.Fail].err{raw_r.err}; }
    ret res[str, outcome.Fail].err{outcome.user(msg_r.ok)};
}

fun git_symlink_tracked(s: *session.Session, gi: *GitInspector, alias: str, git_dir: str,
    git_prefix: str, rel: str) res[bool, outcome.Fail] {
    val mode_r: res[str, outcome.Fail] = git_path_mode(s, gi, alias, git_dir, git_prefix, rel);
    if (sel mode_r.err) { ret res[bool, outcome.Fail].err{mode_r.err}; }
    val mode:    str  = mode_r.ok;
    val tracked: bool = str_equals(mode, "120000");
    str_free(s.build_alloc, mode);
    ret res[bool, outcome.Fail].ok{tracked};
}

fun cmp_git_entry(a: *GitEntry, b: *GitEntry) i64 {
    ret str_compare(a.path, b.path);
}

# list a checkout's committed tree once: `<mode> <path>` records, nul-terminated
fun git_tree_load(s: *session.Session, gi: *GitInspector, alias: str, git_dir: str) res[usize, outcome.Fail] {
    var args: [6]str;
    args[0] = "ls-tree";
    args[1] = "-r";
    args[2] = "-t";
    args[3] = "-z";
    args[4] = "--full-tree";
    args[5] = "--format=%(objectmode) %(path)";
    var argv: [7]str;
    var k:    usize = 0;
    for (k < 6) {
        argv[k] = args[k];
        k       = k + 1;
    }
    argv[6] = "HEAD";
    val listed: res[GitBytes, outcome.Fail] = git_query_capture(gi.alloc, gi, git_dir, ?argv[0], 7, false, nil, os.INVALID_HANDLE, true);
    if (sel listed.err) {
        val mr: res[str, format.FormatError] = format.sprint(s.build_alloc,
            "dependency '{}': cannot verify nested dependency gitlink: {}", alias, outcome.describe(listed.err));
        if (sel mr.err) { ret res[usize, outcome.Fail].err{listed.err}; }
        ret res[usize, outcome.Fail].err{outcome.user(mr.ok)};
    }
    var bytes: GitBytes = listed.ok;
    fin { git_bytes_free(gi.alloc, ?bytes); }
    val dir_r: res[str, string.StrError] = str_copy_slice(gi.alloc, git_dir, 0, str_len(git_dir));
    if (sel dir_r.err) { ret res[usize, outcome.Fail].err{outcome.user(outcome.str_text(dir_r.err))}; }
    var tree: GitTree = GitTree{dir: dir_r.ok, entries: vector.init[GitEntry](gi.alloc)};
    var ok:   bool    = false;
    fin {
        if (!ok) { git_tree_free(gi.alloc, ?tree); }
    }
    var at: usize = 0;
    for (at < bytes.len) {
        var end: usize = at;
        for (end < bytes.len && bytes.data[end] != 0) { end = end + 1; }
        var space: usize = at;
        for (space < end && bytes.data[space] != ' ') { space = space + 1; }
        if (space == end) { ret res[usize, outcome.Fail].err{outcome.user("Git tree listing has a malformed record")}; }
        val mode_r: res[str, string.StrError] = str_copy_slice(gi.alloc, (?bytes.data[at])::str, 0, space - at);
        if (sel mode_r.err) { ret res[usize, outcome.Fail].err{outcome.user(outcome.str_text(mode_r.err))}; }
        val path_r: res[str, string.StrError] = str_copy_slice(gi.alloc, (?bytes.data[space + 1])::str, 0, end - space - 1);
        if (sel path_r.err) {
            str_free(gi.alloc, mode_r.ok);
            ret res[usize, outcome.Fail].err{outcome.user(outcome.str_text(path_r.err))};
        }
        val pushed_entry: res[usize, A.Error] = vector.push[GitEntry](?tree.entries, GitEntry{path: path_r.ok, mode: mode_r.ok});
        if (sel pushed_entry.err) {
            str_free(gi.alloc, mode_r.ok);
            str_free(gi.alloc, path_r.ok);
            ret res[usize, outcome.Fail].err{outcome.refused(pushed_entry.err)};
        }
        at = end + 1;
    }
    # git orders a tree as if its name ended in a separator, so the listing is re-sorted plainly
    sort.sort[GitEntry](tree.entries.data, tree.entries.len, cmp_git_entry);
    if (!gi.trees_ready) {
        gi.trees       = vector.init[GitTree](gi.alloc);
        gi.trees_ready = true;
    }
    val pushed: res[usize, A.Error] = vector.push[GitTree](?gi.trees, tree);
    if (sel pushed.err) { ret res[usize, outcome.Fail].err{outcome.refused(pushed.err)}; }
    ok = true;
    ret res[usize, outcome.Fail].ok{gi.trees.len - 1};
}

fun git_tree_for(s: *session.Session, gi: *GitInspector, alias: str, git_dir: str) res[usize, outcome.Fail] {
    if (gi.trees_ready) {
        var i: usize = 0;
        for (i < gi.trees.len) {
            if (str_equals(gi.trees.data[i].dir, git_dir)) { ret res[usize, outcome.Fail].ok{i}; }
            i = i + 1;
        }
    }
    ret git_tree_load(s, gi, alias, git_dir);
}

# the committed mode of `<prefix><rel>` at HEAD, or "" when HEAD has no such entry
fun git_path_mode(s: *session.Session, gi: *GitInspector, alias: str,
    git_dir: str, git_prefix: str, rel: str) res[str, outcome.Fail] {
    val tree_r: res[usize, outcome.Fail] = git_tree_for(s, gi, alias, git_dir);
    if (sel tree_r.err) { ret res[str, outcome.Fail].err{tree_r.err}; }
    val tree:   *GitTree                     = ?gi.trees.data[tree_r.ok];
    val path_r: res[str, format.FormatError] = format.sprint(s.build_alloc, "{}{}", git_prefix, rel);
    if (sel path_r.err) { ret res[str, outcome.Fail].err{outcome.user(outcome.format_text(path_r.err))}; }
    var want: str = path_r.ok;
    fin { str_free(s.build_alloc, want); }
    # a directory is asked for with a trailing separator; the listing names it without one
    var n: usize = str_len(want);
    for (n > 0 && want[n - 1] == '/') { n = n - 1; }
    want[n] = 0;
    var lo: usize = 0;
    var hi: usize = tree.entries.len;
    for (lo < hi) {
        val mid: usize = lo + (hi - lo) / 2;
        val c:   i64   = str_compare(tree.entries.data[mid].path, want);
        if (c == 0) {
            val mode:   str                       = tree.entries.data[mid].mode;
            val copied: res[str, string.StrError] = str_copy_slice(s.build_alloc, mode, 0, str_len(mode));
            if (sel copied.err) { ret res[str, outcome.Fail].err{outcome.user(outcome.str_text(copied.err))}; }
            ret res[str, outcome.Fail].ok{copied.ok};
        }
        if (c < 0) { lo = mid + 1; }
        or         { hi = mid; }
    }
    val empty: res[str, string.StrError] = str_copy_slice(s.build_alloc, "", 0, 0);
    if (sel empty.err) { ret res[str, outcome.Fail].err{outcome.user(outcome.str_text(empty.err))}; }
    ret res[str, outcome.Fail].ok{empty.ok};
}

fun symlink_target_rel(s: *session.Session, rel: str, target: str) res[str, outcome.Fail] {
    if (str_empty(target) || target[0] == '/' || target[0] == '\\'
        || (str_len(target) > 1 && target[1] == ':')) {
        ret res[str, outcome.Fail].err{outcome.user("tracked symlink target must be relative")};
    }
    var base_len: usize = str_len(rel);
    for (base_len > 0 && rel[base_len - 1] != '/') { base_len = base_len - 1; }
    val base_r: res[str, string.StrError] = str_copy_slice(s.build_alloc, rel, 0, base_len);
    if (sel base_r.err) { ret res[str, outcome.Fail].err{outcome.user(outcome.str_text(base_r.err))}; }
    val base:     str                          = base_r.ok;
    val joined_r: res[str, format.FormatError] = format.sprint(s.build_alloc, "{}{}", base, target);
    str_free(s.build_alloc, base);
    if (sel joined_r.err) { ret res[str, outcome.Fail].err{outcome.user(outcome.format_text(joined_r.err))}; }
    val joined:  str                     = joined_r.ok;
    val clean_r: res[path.Path, A.Error] = path.clean(s.build_alloc, joined);
    str_free(s.build_alloc, joined);
    if (sel clean_r.err) { ret res[str, outcome.Fail].err{outcome.refused(clean_r.err)}; }
    val clean:   str  = clean_r.ok;
    val escaped: bool = str_equals(clean, "..")
        || (str_len(clean) > 2 && clean[0] == '.' && clean[1] == '.' && path.is_separator(clean[2]));
    if (escaped) {
        str_free(s.build_alloc, clean);
        ret res[str, outcome.Fail].err{outcome.user("tracked symlink target escapes dependency package")};
    }
    $if ($mach.build.os == $mach.os.windows) {
        var i: usize = 0;
        for (clean[i] != 0) {
            if (path.is_separator(clean[i])) { clean[i] = '/'; }
            i = i + 1;
        }
    }
    ret res[str, outcome.Fail].ok{clean};
}

fun verify_symlink_chain(s: *session.Session, gi: *GitInspector, alias: str,
    git_dir: str, git_prefix: str, root: str, rel: str,
    links: *Vector[str]) err[outcome.Fail] {
    if (symlink_seen(links, rel)) { ret err[outcome.Fail].err{outcome.user("tracked symlink cycle in dependency package")}; }
    val copied_r: res[str, string.StrError] = str_copy_slice(s.build_alloc, rel, 0, str_len(rel));
    if (sel copied_r.err) { ret err[outcome.Fail].err{outcome.user(outcome.str_text(copied_r.err))}; }
    val pushed_r: res[usize, A.Error] = vector.push[str](links, copied_r.ok);
    if (sel pushed_r.err) {
        str_free(s.build_alloc, copied_r.ok);
        ret err[outcome.Fail].err{outcome.refused(pushed_r.err)};
    }

    val target_r: res[str, outcome.Fail] = git_symlink_target(s, gi, alias, git_dir, git_prefix, rel);
    if (sel target_r.err) { ret err[outcome.Fail].err{target_r.err}; }
    val target: str                    = target_r.ok;
    val next_r: res[str, outcome.Fail] = symlink_target_rel(s, rel, target);
    str_free(s.build_alloc, target);
    if (sel next_r.err) { ret err[outcome.Fail].err{next_r.err}; }
    val next: str = next_r.ok;
    fin { str_free(s.build_alloc, next); }
    val resolved_r: res[str, fail.Fail] = load.join_path(s.build_alloc, root, next);
    if (sel resolved_r.err) { ret err[outcome.Fail].err{outcome.from_fail(resolved_r.err)}; }
    val resolved: str = resolved_r.ok;
    fin { str_free(s.build_alloc, resolved); }
    val meta_r: res[fs.Metadata, io_error.Error] = fs.metadata_link(resolved);
    if (sel meta_r.err) { ret err[outcome.Fail].ok{}; }
    val meta: fs.Metadata = meta_r.ok;
    if (!fs.meta_is_symlink(?meta)) { ret err[outcome.Fail].ok{}; }
    val next_tracked_r: res[bool, outcome.Fail] = git_symlink_tracked(s, gi, alias, git_dir, git_prefix, next);
    if (sel next_tracked_r.err) { ret err[outcome.Fail].err{next_tracked_r.err}; }
    if (!next_tracked_r.ok)     { ret err[outcome.Fail].ok{}; }
    ret verify_symlink_chain(s, gi, alias, git_dir, git_prefix, root, next, links);
}

fun verify_realization_symlinks_walk(s: *session.Session, gi: *GitInspector, alias: str,
    git_dir: str, git_prefix: str, root: str, rel: str) err[outcome.Fail] {
    val at_r: res[str, fail.Fail] = load.join_path(s.build_alloc, root, rel);
    if (sel at_r.err) { ret err[outcome.Fail].err{outcome.from_fail(at_r.err)}; }
    val at:      str                          = at_r.ok;
    val names_r: res[Vector[str], fs.FsError] = fs.read_dir(s.build_alloc, at);
    str_free(s.build_alloc, at);
    if (sel names_r.err) { ret err[outcome.Fail].err{outcome.user(outcome.fs_text(names_r.err))}; }
    var names: Vector[str] = names_r.ok;
    sort.sort[str](names.data, names.len, cmp_dep_name);
    var i: usize = 0;
    for (i < names.len) {
        val child_r: res[str, format.FormatError] = format.sprint(s.build_alloc, "{}{}", rel, names.data[i]);
        if (sel child_r.err) {
            free_name_vector(s.build_alloc, ?names);
            ret err[outcome.Fail].err{outcome.user(outcome.format_text(child_r.err))};
        }
        val child:  str                 = child_r.ok;
        val path_r: res[str, fail.Fail] = load.join_path(s.build_alloc, root, child);
        if (sel path_r.err) {
            str_free(s.build_alloc, child);
            free_name_vector(s.build_alloc, ?names);
            ret err[outcome.Fail].err{outcome.from_fail(path_r.err)};
        }
        val child_path: str                              = path_r.ok;
        val meta_r:     res[fs.Metadata, io_error.Error] = fs.metadata_link(child_path);
        if (sel meta_r.err) {
            str_free(s.build_alloc, child_path);
            str_free(s.build_alloc, child);
            free_name_vector(s.build_alloc, ?names);
            ret err[outcome.Fail].err{outcome.user(outcome.io_text(meta_r.err))};
        }
        val meta: fs.Metadata = meta_r.ok;
        if (fs.meta_is_dir(?meta)) {
            val mode_r: res[str, outcome.Fail] = git_path_mode(s, gi, alias, git_dir, git_prefix, child);
            if (sel mode_r.err) {
                str_free(s.build_alloc, child_path);
                str_free(s.build_alloc, child);
                free_name_vector(s.build_alloc, ?names);
                ret err[outcome.Fail].err{mode_r.err};
            }
            val mode: str = mode_r.ok;
            if (str_empty(mode) || str_equals(mode, "160000")) {
                str_free(s.build_alloc, mode);
                str_free(s.build_alloc, child_path);
                str_free(s.build_alloc, child);
                i = i + 1;
                cnt;
            }
            if (!str_equals(mode, "040000")) {
                str_free(s.build_alloc, mode);
                str_free(s.build_alloc, child_path);
                str_free(s.build_alloc, child);
                free_name_vector(s.build_alloc, ?names);
                ret err[outcome.Fail].err{outcome.user("dependency directory does not match its committed tree")};
            }
            str_free(s.build_alloc, mode);
            str_free(s.build_alloc, child_path);
            val nested_r: res[str, format.FormatError] = format.sprint(s.build_alloc, "{}/", child);
            str_free(s.build_alloc, child);
            if (sel nested_r.err) {
                free_name_vector(s.build_alloc, ?names);
                ret err[outcome.Fail].err{outcome.user(outcome.format_text(nested_r.err))};
            }
            val nested: str               = nested_r.ok;
            val walk_r: err[outcome.Fail] = verify_realization_symlinks_walk(s, gi, alias, git_dir, git_prefix, root, nested);
            str_free(s.build_alloc, nested);
            if (sel walk_r.err) {
                free_name_vector(s.build_alloc, ?names);
                ret walk_r;
            }
        }
        or (fs.meta_is_symlink(?meta)) {
            var links:     Vector[str]             = vector.init[str](s.build_alloc);
            var verify_r:  err[outcome.Fail]       = err[outcome.Fail].ok{};
            val tracked_r: res[bool, outcome.Fail] = git_symlink_tracked(s, gi, alias, git_dir, git_prefix, child);
            if (sel tracked_r.err) { verify_r = err[outcome.Fail].err{tracked_r.err}; }
            or (sel tracked_r.ok) {
                if (tracked_r.ok) {
                    verify_r = verify_symlink_chain(s, gi, alias, git_dir, git_prefix, root, child, ?links);
                }
            }
            free_name_vector(s.build_alloc, ?links);
            str_free(s.build_alloc, child_path);
            str_free(s.build_alloc, child);
            if (sel verify_r.err) {
                free_name_vector(s.build_alloc, ?names);
                ret verify_r;
            }
        }
        or {
            str_free(s.build_alloc, child_path);
            str_free(s.build_alloc, child);
        }
        i = i + 1;
    }
    free_name_vector(s.build_alloc, ?names);
    ret err[outcome.Fail].ok{};
}

fun verify_realization_symlinks(s: *session.Session, gi: *GitInspector, alias: str,
    git_dir: str, git_prefix: str, root: str) err[outcome.Fail] {
    ret verify_realization_symlinks_walk(s, gi, alias, git_dir, git_prefix, root, "");
}

fun module_file_present(alloc: *A.Allocator, root: str, src_dir: str, module_rel: str) res[bool, outcome.Fail] {
    val a: res[str, fail.Fail] = load.join_path(alloc, root, src_dir);
    if (sel a.err) { ret res[bool, outcome.Fail].err{outcome.from_fail(a.err)}; }
    val mid: str                 = a.ok;
    val b:   res[str, fail.Fail] = load.join_path(alloc, mid, module_rel);
    str_free(alloc, mid);
    if (sel b.err) { ret res[bool, outcome.Fail].err{outcome.from_fail(b.err)}; }
    val full:      str                       = b.ok;
    val is_file_r: res[bool, io_error.Error] = fs.is_file(full);
    val ok_:       bool                      = (sel is_file_r.ok && is_file_r.ok);
    str_free(alloc, full);
    ret res[bool, outcome.Fail].ok{ok_};
}

fun id_text_or(s: *session.Session, id: intern.StrId, default: str) str {
    if (id == intern.STR_NIL) { ret default; }
    val o: opt[str] = intern.lookup(?s.interner, id);
    if (sel o.some) { ret o.some; }
    ret default;
}

fun dep_source_label(s: *session.Session, d: *manifest.DepDef) res[intern.StrId, outcome.Fail] {
    var label_r: res[str, format.FormatError];
    if (d.git != intern.STR_NIL) {
        val u: opt[str] = intern.lookup(?s.interner, d.git);
        if (sel u.none) { ret res[intern.StrId, outcome.Fail].err{outcome.user("dependency Git source is not interned")}; }
        label_r = format.sprint(s.build_alloc, "git {}", u.some);
    }
    or (d.path != intern.STR_NIL) {
        val pth: opt[str] = intern.lookup(?s.interner, d.path);
        if (sel pth.none) { ret res[intern.StrId, outcome.Fail].err{outcome.user("dependency path source is not interned")}; }
        label_r = format.sprint(s.build_alloc, "path {}", pth.some);
    }
    or                   { ret res[intern.StrId, outcome.Fail].err{outcome.user("dependency has no source")}; }
    if (sel label_r.err) { ret res[intern.StrId, outcome.Fail].err{outcome.user(outcome.format_text(label_r.err))}; }
    val label: str                        = label_r.ok;
    val ir:    res[intern.StrId, A.Error] = intern.intern(?s.interner, label);
    str_free(s.build_alloc, label);
    if (sel ir.err) { ret res[intern.StrId, outcome.Fail].err{outcome.refused(ir.err)}; }
    ret res[intern.StrId, outcome.Fail].ok{ir.ok};
}

fun discard_dep_entry(alloc: *A.Allocator, entry: *project.DepEntry) {
    if (entry.direct != nil && entry.direct_count > 0) {
        A.deallocate[intern.StrId](alloc, entry.direct, entry.direct_count::usize);
    }
    manifest.dnit(?entry.manifest, alloc);
}

fun root_dependency(root_m: *manifest.Manifest, name: intern.StrId) *manifest.DepDef {
    var i: u32 = 0;
    for (i < root_m.dep_count) {
        if (root_m.deps[i].name == name) { ret ?root_m.deps[i]; }
        i = i + 1;
    }
    ret nil;
}

# a requirer's selector that the root's own declaration replaced. a root `ref` or `path`
# wins over every requirer with no check that the dependency supports it; a root
# `version` intersects with the requirers' ranges instead, so it is never one
# ---
# name:      the dependency key both declarations use
# chain:     the requiring chain, ending at the dependency
# requested: the requirer's selector, as `ref = "..."`, `version = "..."` or `path = "..."`
# declared:  the root's selector, in the same form
pub rec RootOverride {
    name:      intern.StrId;
    chain:     intern.StrId;
    requested: intern.StrId;
    declared:  intern.StrId;
}

# every edge of a realized closure whose selector a root override replaced, in closure order
# ---
# s:         the session; the returned ids are interned in it
# root_m:    the root manifest
# deps:      the realized closure
# dep_count: its length
# out:       receives one RootOverride per replaced edge
pub fun root_overrides(s: *session.Session, root_m: *manifest.Manifest, deps: *project.DepEntry, dep_count: u32,
    out: *Vector[RootOverride]) err[outcome.Fail] {
    var i: u32 = 0;
    for (i < dep_count) {
        val requirer: *project.DepEntry = ?deps[i];
        i = i + 1;
        var k: u32 = 0;
        for (k < requirer.manifest.dep_count) {
            val asked: *manifest.DepDef = ?requirer.manifest.deps[k];
            k = k + 1;
            val root_dep: *manifest.DepDef = root_dependency(root_m, asked.name);
            if (root_dep == nil || root_dep.version != intern.STR_NIL) { cnt; }
            if (same_selector(asked, root_dep))                        { cnt; }
            val chain: res[intern.StrId, outcome.Fail] = intern_formatted(s, format.sprint(s.build_alloc, "{} -> {}", intern_text(s, requirer.chain), intern_text(s, asked.name)));
            if (sel chain.err) { ret err[outcome.Fail].err{chain.err}; }
            val requested: res[intern.StrId, outcome.Fail] = selector_id(s, asked);
            if (sel requested.err) { ret err[outcome.Fail].err{requested.err}; }
            val declared: res[intern.StrId, outcome.Fail] = selector_id(s, root_dep);
            if (sel declared.err) { ret err[outcome.Fail].err{declared.err}; }
            val pushed: res[usize, A.Error] = vector.push[RootOverride](out, RootOverride{name: asked.name, chain: chain.ok,
                requested: requested.ok, declared: declared.ok});
            if (sel pushed.err) { ret err[outcome.Fail].err{outcome.refused(pushed.err)}; }
        }
    }
    ret err[outcome.Fail].ok{};
}

# the note `mach dep verify` prints for one override
pub fun root_override_text(s: *session.Session, o: *RootOverride) res[str, outcome.Fail] {
    val r: res[str, format.FormatError] = format.sprint(s.build_alloc,
        "note: dependency '{}': the root declares {}, overriding {} which requires {}; nothing checks that '{}' supports the root's selection",
        intern_text(s, o.name), intern_text(s, o.declared), intern_text(s, o.chain), intern_text(s, o.requested), intern_text(s, o.name));
    if (sel r.err) { ret res[str, outcome.Fail].err{outcome.user(outcome.format_text(r.err))}; }
    ret res[str, outcome.Fail].ok{r.ok};
}

fun same_selector(a: *manifest.DepDef, b: *manifest.DepDef) bool {
    ret a.git == b.git && a.path == b.path && a.ref == b.ref && a.version == b.version;
}

fun selector_id(s: *session.Session, d: *manifest.DepDef) res[intern.StrId, outcome.Fail] {
    if (d.version != intern.STR_NIL) { ret intern_formatted(s, format.sprint(s.build_alloc, "version = \"{}\"", intern_text(s, d.version))); }
    if (d.ref != intern.STR_NIL)     { ret intern_formatted(s, format.sprint(s.build_alloc, "ref = \"{}\"", intern_text(s, d.ref))); }
    if (d.path != intern.STR_NIL)    { ret intern_formatted(s, format.sprint(s.build_alloc, "path = \"{}\"", intern_text(s, d.path))); }
    ret intern_formatted(s, format.sprint(s.build_alloc, "git = \"{}\"", intern_text(s, d.git)));
}

fun intern_formatted(s: *session.Session, r: res[str, format.FormatError]) res[intern.StrId, outcome.Fail] {
    if (sel r.err) { ret res[intern.StrId, outcome.Fail].err{outcome.user(outcome.format_text(r.err))}; }
    val id: res[intern.StrId, A.Error] = intern.intern(?s.interner, r.ok);
    str_free(s.build_alloc, r.ok);
    if (sel id.err) { ret res[intern.StrId, outcome.Fail].err{outcome.refused(id.err)}; }
    ret res[intern.StrId, outcome.Fail].ok{id.ok};
}

fun resolve_dep_edge(p: *project.Project, gi: *GitInspector, root_m: *manifest.Manifest, current_root: str, d: *manifest.DepDef,
    deps: *project.DepEntry, active: *bool, dep_count_ptr: *u32, max_deps: usize,
    dir_dep: str, requirer_chain: str) res[u32, outcome.Fail] {
    val alias_opt: opt[str] = intern.lookup(?p.s.interner, d.name);
    if (sel alias_opt.none) { ret res[u32, outcome.Fail].err{outcome.user("dep alias StrId not interned")}; }
    val alias:   str                          = alias_opt.some;
    val chain_r: res[str, format.FormatError] = format.sprint(p.alloc, "{} -> {}", requirer_chain, alias);
    if (sel chain_r.err) { ret res[u32, outcome.Fail].err{outcome.user(outcome.format_text(chain_r.err))}; }
    val chain_here: str = chain_r.ok;

    val root_dep: *manifest.DepDef = root_dependency(root_m, d.name);
    var selected: *manifest.DepDef = d;
    if (root_dep != nil) { selected = root_dep; }
    val rd: res[project.DepEntry, outcome.Fail] = resolve_dep(p.s, gi, alias, current_root, dir_dep, selected);
    if (sel rd.err) {
        str_free(p.alloc, chain_here);
        ret res[u32, outcome.Fail].err{rd.err};
    }
    var entry:      project.DepEntry           = rd.ok;
    val chain_id_r: res[intern.StrId, A.Error] = intern.intern(?p.s.interner, chain_here);
    if (sel chain_id_r.err) {
        discard_dep_entry(p.alloc, ?entry);
        str_free(p.alloc, chain_here);
        ret res[u32, outcome.Fail].err{outcome.refused(chain_id_r.err)};
    }
    entry.chain = chain_id_r.ok;
    # a root `ref` or `path` overrides the requirers' selectors, a root `version` intersects with them
    val overridden: bool = root_dep != nil && root_dep.version == intern.STR_NIL;
    entry.root_declared = root_dep != nil;
    val release_r: err[outcome.Fail] = edge_release_rule(p.s, chain_here, selected, ?entry.manifest, root_m);
    if (sel release_r.err) {
        discard_dep_entry(p.alloc, ?entry);
        str_free(p.alloc, chain_here);
        ret res[u32, outcome.Fail].err{release_r.err};
    }
    var j: u32 = 0;
    for (j < dep_count_ptr[0]) {
        if (deps[j].project_id == entry.project_id) {
            if (!overridden) {
                val esel_r: err[outcome.Fail] = requirer_selector_satisfied(p.s, gi, alias, chain_here, current_root, dir_dep, d, deps[j].content);
                if (sel esel_r.err) {
                    discard_dep_entry(p.alloc, ?entry);
                    str_free(p.alloc, chain_here);
                    ret res[u32, outcome.Fail].err{esel_r.err};
                }
            }
            if (active[j]) {
                val msg_r: res[str, format.FormatError] = format.sprint(p.alloc,
                    "dependency cycle: {} reaches project '{}' while it is already being resolved",
                    chain_here, id_text_or(p.s, entry.project_id, "?"));
                discard_dep_entry(p.alloc, ?entry);
                str_free(p.alloc, chain_here);
                if (sel msg_r.err) { ret res[u32, outcome.Fail].err{outcome.user(outcome.format_text(msg_r.err))}; }
                ret res[u32, outcome.Fail].err{outcome.user(msg_r.ok)};
            }
            discard_dep_entry(p.alloc, ?entry);
            str_free(p.alloc, chain_here);
            ret res[u32, outcome.Fail].ok{j};
        }
        j = j + 1;
    }

    if (dep_count_ptr[0] >= max_deps::u32) {
        discard_dep_entry(p.alloc, ?entry);
        str_free(p.alloc, chain_here);
        ret res[u32, outcome.Fail].err{outcome.user("exceeded maximum dependency limit of 128")};
    }
    if (!overridden) {
        val add_sel_r: err[outcome.Fail] = requirer_selector_satisfied(p.s, gi, alias, chain_here, current_root, dir_dep, d, entry.content);
        if (sel add_sel_r.err) {
            discard_dep_entry(p.alloc, ?entry);
            str_free(p.alloc, chain_here);
            ret res[u32, outcome.Fail].err{add_sel_r.err};
        }
    }
    val idx: u32 = dep_count_ptr[0];
    deps[idx]        = entry;
    active[idx]      = true;
    dep_count_ptr[0] = dep_count_ptr[0] + 1;

    val child_count: u32 = deps[idx].manifest.dep_count;
    if (child_count > 0) {
        val ar: res[*intern.StrId, A.Error] = A.allocate[intern.StrId](p.alloc, child_count::usize);
        if (sel ar.err) {
            str_free(p.alloc, chain_here);
            ret res[u32, outcome.Fail].err{outcome.refused(ar.err)};
        }
        deps[idx].direct       = ar.ok;
        deps[idx].direct_count = child_count;
        var k: u32 = 0;
        for (k < child_count) {
            val child_r: res[u32, outcome.Fail] = resolve_dep_edge(p, gi, root_m, current_root,
                ?deps[idx].manifest.deps[k], deps, active, dep_count_ptr, max_deps, dir_dep, chain_here);
            if (sel child_r.err) {
                str_free(p.alloc, chain_here);
                ret child_r;
            }
            deps[idx].direct[k] = deps[child_r.ok].project_id;
            k                   = k + 1;
        }
    }
    active[idx] = false;
    str_free(p.alloc, chain_here);
    ret res[u32, outcome.Fail].ok{idx};
}

# the git candidate source (#3500): releases are the `v`-prefixed semver tags at a url,
# listed with one `ls-remote` each; the manifest of a release is read from a scratch bare
# repository after a shallow fetch of its tag. offline, both come from `local`, an existing
# repository, and nothing reaches the network
# a url's tag listing, read once per command
rec CachedListing {
    url:  str;
    text: str;
}

# offline, each url's releases come from its own local repository
rec LocalRepo {
    url: str;
    dir: str;
}

pub rec GitCandidates {
    s:        *session.Session;
    gi:       GitInspector;
    listings: Vector[CachedListing];
    locals:   Vector[LocalRepo];
    offline:  bool;
    local:    str;
    # the project whose dep/<id> checkouts serve offline listings of transitive identities
    local_root: str;
    # the root manifest, borrowed; an identity it declares is the root's to select, not a release's
    root:          *manifest.Manifest;
    scratch:       str;
    scratch_ready: bool;
}

pub fun git_candidates_init(s: *session.Session, offline: bool, local: str) res[GitCandidates, outcome.Fail] {
    val gi_r: res[GitInspector, outcome.Fail] = git_inspector_init(s.build_alloc);
    if (sel gi_r.err) { ret res[GitCandidates, outcome.Fail].err{gi_r.err}; }
    ret res[GitCandidates, outcome.Fail].ok{GitCandidates{s: s, gi: gi_r.ok, listings: vector.init[CachedListing](s.build_alloc),
        locals: vector.init[LocalRepo](s.build_alloc), offline: offline, local: local, local_root: "", root: nil, scratch: "", scratch_ready: false}};
}

pub fun git_candidates_dnit(c: *GitCandidates) {
    if (c.scratch_ready) {
        fs.remove_all(c.s.build_alloc, c.scratch);
        str_free(c.s.build_alloc, c.scratch);
        c.scratch_ready = false;
    }
    var i: usize = 0;
    for (i < c.listings.len) {
        str_free(c.s.build_alloc, c.listings.data[i].url);
        str_free(c.s.build_alloc, c.listings.data[i].text);
        i = i + 1;
    }
    vector.dnit[CachedListing](?c.listings);
    i = 0;
    for (i < c.locals.len) {
        str_free(c.s.build_alloc, c.locals.data[i].url);
        str_free(c.s.build_alloc, c.locals.data[i].dir);
        i = i + 1;
    }
    vector.dnit[LocalRepo](?c.locals);
    git_inspector_dnit(c.s.build_alloc, ?c.gi);
}

# the local repository offline resolution reads `url`'s releases from; the first existing one
# named wins, so a url with no checkout yet is refused by offline_dir and not by git
pub fun git_candidates_add_local(c: *GitCandidates, url: str, dir: str) err[outcome.Fail] {
    if (!str_empty(local_dir_for(c, url))) { ret err[outcome.Fail].ok{}; }
    val present: res[bool, io_error.Error] = fs.exists(dir);
    if (!(sel present.ok && present.ok)) { ret err[outcome.Fail].ok{}; }
    val a:  *A.Allocator      = c.s.build_alloc;
    val ur: res[str, A.Error] = str_dup_range(a, url, 0, str_len(url));
    if (sel ur.err) { ret err[outcome.Fail].err{outcome.refused(ur.err)}; }
    val dr: res[str, A.Error] = str_dup_range(a, dir, 0, str_len(dir));
    if (sel dr.err) {
        str_free(a, ur.ok);
        ret err[outcome.Fail].err{outcome.refused(dr.err)};
    }
    val pushed: res[usize, A.Error] = vector.push[LocalRepo](?c.locals, LocalRepo{url: ur.ok, dir: dr.ok});
    if (sel pushed.err) {
        str_free(a, ur.ok);
        str_free(a, dr.ok);
        ret err[outcome.Fail].err{outcome.refused(pushed.err)};
    }
    ret err[outcome.Fail].ok{};
}

fun local_dir_for(c: *GitCandidates, url: str) str {
    var i: usize = 0;
    for (i < c.locals.len) {
        if (str_equals(c.locals.data[i].url, url)) { ret c.locals.data[i].dir; }
        i = i + 1;
    }
    ret c.local;
}

fun offline_dir(c: *GitCandidates, url: str) res[str, outcome.Fail] {
    val dir: str = local_dir_for(c, url);
    if (str_empty(dir)) {
        val msg: res[str, format.FormatError] = format.sprint(c.s.build_alloc, "offline: no local checkout of {} to read its releases from; run without --offline once", url);
        if (sel msg.err) { ret res[str, outcome.Fail].err{outcome.user("offline: a dependency has no local checkout")}; }
        ret res[str, outcome.Fail].err{outcome.user(msg.ok)};
    }
    ret res[str, outcome.Fail].ok{dir};
}

pub fun git_candidate_source(c: *GitCandidates) cand.CandidateSource {
    ret cand.CandidateSource{ctx: c::ptr, releases: git_releases, manifest_at: git_manifest_at};
}

fun is_hex_id(p: *u8, n: usize) bool {
    if (n != 40 && n != 64) { ret false; }
    var i: usize = 0;
    for (i < n) {
        val b: u8 = p[i];
        if (!((b >= '0' && b <= '9') || (b >= 'a' && b <= 'f'))) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun release_index(out: *Vector[cand.Release], tag: *u8, tag_len: usize) i64 {
    var i: usize = 0;
    for (i < out.len) {
        val t: str = out.data[i].tag;
        if (str_len(t) == tag_len) {
            var k: usize = 0;
            for (k < tag_len && t[k] == tag[k]) { k = k + 1; }
            if (k == tag_len) { ret i::i64; }
        }
        i = i + 1;
    }
    ret -1;
}

# one listing line, `<object id><space or tab>refs/tags/<tag>[^{}]`; a peeled line gives the
# commit an annotated tag points at and replaces the tag object's id
fun take_release_line(a: *A.Allocator, line: *u8, n: usize, out: *Vector[cand.Release]) err[outcome.Fail] {
    var sp: usize = 0;
    for (sp < n && line[sp] != ' ' && line[sp] != '\t') { sp = sp + 1; }
    if (sp == n || !is_hex_id(line, sp)) { ret err[outcome.Fail].ok{}; }
    var ref_at: usize = sp;
    for (ref_at < n && (line[ref_at] == ' ' || line[ref_at] == '\t')) { ref_at = ref_at + 1; }
    val prefix: str   = "refs/tags/";
    var k:      usize = 0;
    for (k < 10) {
        if (ref_at + k >= n || line[ref_at + k] != prefix[k]) { ret err[outcome.Fail].ok{}; }
        k = k + 1;
    }
    val tag_at:  usize = ref_at + 10;
    var tag_len: usize = n - tag_at;
    var peeled:  bool  = false;
    if (tag_len > 3 && line[n - 3] == '^' && line[n - 2] == '{' && line[n - 1] == '}') {
        tag_len = tag_len - 3;
        peeled  = true;
    }
    if (tag_len < 6 || line[tag_at] != 'v') { ret err[outcome.Fail].ok{}; }
    val commit_r: res[str, A.Error] = str_dup_range(a, line::str, 0, sp);
    if (sel commit_r.err) { ret err[outcome.Fail].err{outcome.refused(commit_r.err)}; }
    val seen: i64 = release_index(out, ?line[tag_at], tag_len);
    if (seen >= 0) {
        if (peeled) {
            str_free(a, out.data[seen::usize].commit);
            out.data[seen::usize].commit = commit_r.ok;
        }
        or { str_free(a, commit_r.ok); }
        ret err[outcome.Fail].ok{};
    }
    val tag_r: res[str, A.Error] = str_dup_range(a, line::str, tag_at, tag_len);
    if (sel tag_r.err) {
        str_free(a, commit_r.ok);
        ret err[outcome.Fail].err{outcome.refused(tag_r.err)};
    }
    val text_r: res[str, A.Error] = str_dup_range(a, line::str, tag_at + 1, tag_len - 1);
    if (sel text_r.err) {
        str_free(a, commit_r.ok);
        str_free(a, tag_r.ok);
        ret err[outcome.Fail].err{outcome.refused(text_r.err)};
    }
    val parsed: res[range.Version, str] = range.parse_version(text_r.ok);
    if (sel parsed.err) {
        str_free(a, commit_r.ok);
        str_free(a, tag_r.ok);
        str_free(a, text_r.ok);
        ret err[outcome.Fail].ok{};
    }
    if (sel parsed.ok) {
        val pushed: res[usize, A.Error] = vector.push[cand.Release](out,
            cand.Release{version: parsed.ok, text: text_r.ok, tag: tag_r.ok, commit: commit_r.ok});
        if (sel pushed.err) {
            str_free(a, commit_r.ok);
            str_free(a, tag_r.ok);
            str_free(a, text_r.ok);
            ret err[outcome.Fail].err{outcome.refused(pushed.err)};
        }
    }
    ret err[outcome.Fail].ok{};
}

fun git_releases(ctx: ptr, url: str, out: *Vector[cand.Release]) err[outcome.Fail] {
    val c:      *GitCandidates         = ctx::*GitCandidates;
    val a:      *A.Allocator           = c.s.build_alloc;
    val listed: res[str, outcome.Fail] = cached_listing(c, url);
    if (sel listed.err) { ret err[outcome.Fail].err{listed.err}; }
    val text: str   = listed.ok;
    val n:    usize = str_len(text);
    var at:   usize = 0;
    for (at < n) {
        var end: usize = at;
        for (end < n && text[end] != '\n') { end = end + 1; }
        val taken: err[outcome.Fail] = take_release_line(a, ?text[at], end - at, out);
        if (sel taken.err) { ret taken; }
        at = end + 1;
    }
    ret err[outcome.Fail].ok{};
}

# the listing stays owned by the cache
fun cached_listing(c: *GitCandidates, url: str) res[str, outcome.Fail] {
    val a: *A.Allocator = c.s.build_alloc;
    var i: usize        = 0;
    for (i < c.listings.len) {
        if (str_equals(c.listings.data[i].url, url)) { ret res[str, outcome.Fail].ok{c.listings.data[i].text}; }
        i = i + 1;
    }
    var listed: res[str, outcome.Fail] = res[str, outcome.Fail].err{outcome.user("unset")};
    if (c.offline) {
        var args: [3]str;
        args[0] = "for-each-ref";
        args[1] = "--format=%(objectname) %(refname)%0a%(*objectname) %(refname)^{}";
        args[2] = "refs/tags";
        val dir: res[str, outcome.Fail] = offline_dir(c, url);
        if (sel dir.err) { ret res[str, outcome.Fail].err{dir.err}; }
        listed = git_query_raw(a, ?c.gi, dir.ok, ?args[0], 3);
    }
    or {
        var args: [3]str;
        args[0] = "ls-remote";
        args[1] = "--tags";
        args[2] = url;
        listed  = git_query_raw(a, ?c.gi, ".", ?args[0], 3);
    }
    if (sel listed.err) { ret listed; }
    val url_r: res[str, A.Error] = str_dup_range(a, url, 0, str_len(url));
    if (sel url_r.err) {
        str_free(a, listed.ok);
        ret res[str, outcome.Fail].err{outcome.refused(url_r.err)};
    }
    val pushed: res[usize, A.Error] = vector.push[CachedListing](?c.listings, CachedListing{url: url_r.ok, text: listed.ok});
    if (sel pushed.err) {
        str_free(a, url_r.ok);
        str_free(a, listed.ok);
        ret res[str, outcome.Fail].err{outcome.refused(pushed.err)};
    }
    ret listed;
}

fun ensure_scratch(c: *GitCandidates) err[outcome.Fail] {
    if (c.scratch_ready) { ret err[outcome.Fail].ok{}; }
    val a:    *A.Allocator                 = c.s.build_alloc;
    val tf_r: res[fs.TempFile, fs.FsError] = fs.temp_create(a, "mach_candidates");
    if (sel tf_r.err) { ret err[outcome.Fail].err{outcome.user(outcome.fs_text(tf_r.err))}; }
    var tf:    fs.TempFile       = tf_r.ok;
    val dup_r: res[str, A.Error] = str_dup_range(a, fs.temp_path(?tf), 0, str_len(fs.temp_path(?tf)));
    fs.temp_close_and_remove(?tf);
    if (sel dup_r.err) { ret err[outcome.Fail].err{outcome.refused(dup_r.err)}; }
    val made: err[fs.FsError] = fs.create_dir_all(a, dup_r.ok, 448);
    if (sel made.err) {
        str_free(a, dup_r.ok);
        ret err[outcome.Fail].err{outcome.user(outcome.fs_text(made.err))};
    }
    c.scratch       = dup_r.ok;
    c.scratch_ready = true;
    var args: [3]str;
    args[0] = "init";
    args[1] = "--bare";
    args[2] = "-q";
    val init_r: res[str, outcome.Fail] = git_op(a, ?c.gi, c.scratch, ?args[0], 3, nil);
    if (sel init_r.err) { ret err[outcome.Fail].err{init_r.err}; }
    str_free(a, init_r.ok);
    ret err[outcome.Fail].ok{};
}

fun git_manifest_at(ctx: ptr, url: str, rel: *cand.Release) res[manifest.Manifest, outcome.Fail] {
    val c:   *GitCandidates = ctx::*GitCandidates;
    val a:   *A.Allocator   = c.s.build_alloc;
    var dir: str            = c.local;
    if (c.offline) {
        val od: res[str, outcome.Fail] = offline_dir(c, url);
        if (sel od.err) { ret res[manifest.Manifest, outcome.Fail].err{od.err}; }
        dir = od.ok;
    }
    or {
        val ready: err[outcome.Fail] = ensure_scratch(c);
        if (sel ready.err) { ret res[manifest.Manifest, outcome.Fail].err{ready.err}; }
        dir = c.scratch;
        val refspec_r: res[str, format.FormatError] = format.sprint(a, "+refs/tags/{}:refs/tags/{}", rel.tag, rel.tag);
        if (sel refspec_r.err) { ret res[manifest.Manifest, outcome.Fail].err{outcome.user(outcome.format_text(refspec_r.err))}; }
        var args: [5]str;
        args[0] = "fetch";
        args[1] = "-q";
        args[2] = "--depth=1";
        args[3] = url;
        args[4] = refspec_r.ok;
        val fetched: res[str, outcome.Fail] = git_op(a, ?c.gi, dir, ?args[0], 5, nil);
        str_free(a, refspec_r.ok);
        if (sel fetched.err) { ret res[manifest.Manifest, outcome.Fail].err{fetched.err}; }
        str_free(a, fetched.ok);
    }
    val spec_r: res[str, format.FormatError] = format.sprint(a, "{}:{}", rel.commit, manifest.MANIFEST_FILE);
    if (sel spec_r.err) { ret res[manifest.Manifest, outcome.Fail].err{outcome.user(outcome.format_text(spec_r.err))}; }
    var show: [2]str;
    show[0] = "show";
    show[1] = spec_r.ok;
    val shown: res[str, outcome.Fail] = git_query_raw(a, ?c.gi, dir, ?show[0], 2);
    str_free(a, spec_r.ok);
    if (sel shown.err) { ret res[manifest.Manifest, outcome.Fail].err{shown.err}; }
    val text: str = shown.ok;
    fin { str_free(a, text); }
    val clean: err[outcome.Fail] = manifest.validate_source_bytes(text::*u8, str_len(text));
    if (sel clean.err) { ret res[manifest.Manifest, outcome.Fail].err{clean.err}; }
    val table_r: res[toml.Table, toml.TomlError] = toml.parse(a, text);
    if (sel table_r.err) { ret res[manifest.Manifest, outcome.Fail].err{outcome.user(release_msg(a, rel, "its mach.toml is not valid TOML"))}; }
    var table: toml.Table = table_r.ok;
    fin { toml.dnit(a, ?table); }
    val parsed: res[manifest.Manifest, outcome.Fail] = manifest.parse(a, ?c.s.interner, ?table, false);
    if (sel parsed.err) { ret parsed; }
    var m:        manifest.Manifest = parsed.ok;
    val declared: opt[str]          = intern.lookup(?c.s.interner, m.version);
    var agrees:   bool              = false;
    if (sel declared.some) { agrees = str_equals(declared.some, rel.text); }
    if (!agrees) {
        manifest.dnit(?m, a);
        ret res[manifest.Manifest, outcome.Fail].err{outcome.user(release_msg(a, rel, "its [project].version does not match the tag"))};
    }
    ret res[manifest.Manifest, outcome.Fail].ok{m};
}

# a release's requirements as the resolver reads them: its compiler range and its dependencies
# selected by version range, or by an exact release tag. a release selecting anything else
# (a branch, a commit, a path) is not reproducible from its tag and is refused (#3496 §7),
# unless the root declares that identity and so selects it itself (#3553)
pub fun release_needs(ctx: ptr, id: str, url: str, rel: *cand.Release, out: *resolver.ReleaseNeeds) err[outcome.Fail] {
    val c:  *GitCandidates                       = ctx::*GitCandidates;
    val a:  *A.Allocator                         = c.s.build_alloc;
    val mr: res[manifest.Manifest, outcome.Fail] = git_manifest_at(ctx, url, rel);
    if (sel mr.err) { ret err[outcome.Fail].err{mr.err}; }
    var m: manifest.Manifest = mr.ok;
    fin { manifest.dnit(?m, a); }
    if (m.mach != intern.STR_NIL) {
        val mach: opt[str] = intern.lookup(?c.s.interner, m.mach);
        if (sel mach.some) { out.mach = mach.some; }
    }
    var i: u32 = 0;
    for (i < m.dep_count) {
        val d:    *manifest.DepDef = ?m.deps[i];
        val name: str              = intern_text(c.s, d.name);
        i = i + 1;
        # an unreproducible selector the root overrides is not a requirement: the root's own selector is
        val overridden: bool = c.root != nil && root_dependency(c.root, d.name) != nil;
        if (d.git == intern.STR_NIL) {
            if (overridden) { cnt; }
            ret err[outcome.Fail].err{outcome.user(unreproducible(a, id, rel, name, "a path"))};
        }
        val dep_url: str = intern_text(c.s, d.git);
        var want:    str = "";
        if (d.version != intern.STR_NIL) { want = intern_text(c.s, d.version); }
        or {
            val ref: str = intern_text(c.s, d.ref);
            if (!str_starts_with(ref, "tag/v")) {
                if (overridden) { cnt; }
                ret err[outcome.Fail].err{outcome.user(unreproducible(a, id, rel, name, ref))};
            }
            val exact: res[str, format.FormatError] = format.sprint(a, "={}", (?ref[5])::str);
            if (sel exact.err) { ret err[outcome.Fail].err{outcome.user(outcome.format_text(exact.err))}; }
            want = exact.ok;
        }
        val pushed: res[usize, A.Error] = vector.push[resolver.Need](?out.needs, resolver.Need{id: name, url: dep_url, range: want});
        if (sel pushed.err)          { ret err[outcome.Fail].err{outcome.refused(pushed.err)}; }
        if (str_empty(c.local_root)) { cnt; }
        val local_r: res[str, outcome.Fail] = dep_full_of(a, c.local_root, name);
        if (sel local_r.ok) {
            val noted: err[outcome.Fail] = git_candidates_add_local(c, dep_url, local_r.ok);
            if (sel noted.err) { ret noted; }
        }
    }
    ret err[outcome.Fail].ok{};
}

fun intern_text(s: *session.Session, id: intern.StrId) str {
    val t: opt[str] = intern.lookup(?s.interner, id);
    if (sel t.some) { ret t.some; }
    ret "";
}

fun unreproducible(a: *A.Allocator, id: str, rel: *cand.Release, name: str, selector: str) str {
    val r: res[str, format.FormatError] = format.sprint(a,
        "release {} of {} selects dependency '{}' by {}; a release may select its dependencies only by `version` or an exact `tag/`, so it cannot be reproduced from its tag. declare [dep.{}] in your root manifest to select it yourself, or have {} cut a release that selects it by `version` or an exact `tag/`",
        rel.tag, id, name, selector, name, id);
    if (sel r.err) { ret "a release selects a dependency by something other than a version or a tag"; }
    ret r.ok;
}

fun release_msg(a: *A.Allocator, rel: *cand.Release, why: str) str {
    val r: res[str, format.FormatError] = format.sprint(a, "release {} ({}) is not a candidate: {}", rel.tag, rel.commit, why);
    if (sel r.err) { ret why; }
    ret r.ok;
}

# whether the running compiler satisfies `text`; a range that no longer parses counts as unmet
fun compiler_admitted(text: str) bool {
    val want: res[range.Range, range.RangeError] = range.parse_range(text);
    val have: res[range.Version, str]            = range.parse_version(compiler.MACH_VERSION);
    if (sel want.ok) {
        if (sel have.ok) {
            var r: range.Range   = want.ok;
            var v: range.Version = have.ok;
            ret range.satisfies(?r, ?v);
        }
    }
    ret false;
}

fun append_line(p: *project.Project, acc: str, who: str, text: str) str {
    val line_r: res[str, format.FormatError] = format.sprint(p.alloc, "{}\n    {} requires mach {}", acc, who, text);
    if (sel line_r.err) { ret acc; }
    ret line_r.ok;
}

fun root_label(p: *project.Project, m: *manifest.Manifest) str {
    val rn_o: opt[str] = intern.lookup(?p.s.interner, m.id);
    if (sel rn_o.some) {
        if (!str_empty(rn_o.some)) { ret rn_o.some; }
    }
    ret "root";
}

# every manifest in the closure states the compiler range it builds with ([project].mach,
# #3496). all unmet requirements are reported together with who states them; a root without
# the key warns and prints the line to add, and a dependency without it states no constraint
fun check_compiler_requirements(p: *project.Project, m: *manifest.Manifest, deps: *project.DepEntry,
    dep_count: u32, root_name: str) err[outcome.Fail] {
    var unmet: str  = "";
    var any:   bool = false;
    if (m.mach == intern.STR_NIL) { warn_missing_compiler_range(p); }
    or {
        val text: opt[str] = intern.lookup(?p.s.interner, m.mach);
        if (sel text.some) {
            if (!compiler_admitted(text.some)) {
                val who_r: res[str, format.FormatError] = format.sprint(p.alloc, "{} (mach.toml)", root_name);
                var who:   str                          = root_name;
                if (sel who_r.ok) { who = who_r.ok; }
                unmet = append_line(p, unmet, who, text.some);
                any   = true;
            }
        }
    }
    var i: u32 = 0;
    for (i < dep_count) {
        val d: *project.DepEntry = ?deps[i];
        i = i + 1;
        if (d.manifest.mach == intern.STR_NIL) { cnt; }
        val text: opt[str] = intern.lookup(?p.s.interner, d.manifest.mach);
        if (sel text.none)                { cnt; }
        if (compiler_admitted(text.some)) { cnt; }
        var who:   str      = "?";
        val chain: opt[str] = intern.lookup(?p.s.interner, d.chain);
        if (sel chain.some) { who = chain.some; }
        unmet = append_line(p, unmet, who, text.some);
        any   = true;
    }
    if (!any) { ret err[outcome.Fail].ok{}; }
    val msg_r: res[str, format.FormatError] = format.sprint(p.alloc,
        "this is mach {}, and the dependency closure does not accept it:{}", compiler.MACH_VERSION, unmet);
    if (sel msg_r.err) { ret err[outcome.Fail].err{outcome.user("the dependency closure does not accept this compiler")}; }
    ret err[outcome.Fail].err{outcome.user(msg_r.ok)};
}

# the first release that reads `[project].mach`; an earlier compiler refuses the key as unknown
pub val MACH_KEY_SINCE: str = "5.3.0";

# the compiler range a project is told to declare when `running` is the compiler: the oldest
# release of its major that reads the key, since a caret cannot span majors. it depends only on
# the running major, so two authors on one project write the same range (#3572). owned by `a`
pub fun mach_range_floor(a: *A.Allocator, running: str) res[str, format.FormatError] {
    val have:  res[range.Version, str] = range.parse_version(running);
    val since: res[range.Version, str] = range.parse_version(MACH_KEY_SINCE);
    if (sel have.err)  { ret format.sprint(a, "={}", running); }
    if (sel since.err) { ret format.sprint(a, "={}", running); }
    val major: u64 = have.ok.major;
    val floor: u64 = since.ok.major;
    if (major > floor) { ret format.sprint(a, "^{}.0", major); }
    ret format.sprint(a, "^{}.{}", floor, since.ok.minor);
}

# mach_range_floor for this compiler
pub fun running_mach_range_floor(a: *A.Allocator) res[str, format.FormatError] {
    ret mach_range_floor(a, compiler.MACH_VERSION);
}

fun warn_missing_compiler_range(p: *project.Project) {
    val floor_r: res[str, format.FormatError] = running_mach_range_floor(p.alloc);
    if (sel floor_r.err) { ret; }
    val floor: str = floor_r.ok;
    fin { str_free(p.alloc, floor); }
    val msg_r: res[str, format.FormatError] = format.sprint(p.alloc,
        "mach.toml: [project] states no compiler range; add `mach = \"{}\"`, the oldest release that reads the key, and raise it when the project uses a later feature. A later release requires it", floor);
    if (sel msg_r.err) { ret; }
    diagnostic.record_unlocated_warning(?p.diags, msg_r.ok);
    str_free(p.alloc, msg_r.ok);
}

# `dep` is the project's reserved dependency root: absent, or a physical directory. a
# symlink there would resolve the closure from another tree, so every command that reads
# or realizes the closure refuses it through this one check (#3478)
pub val DEP_ROOT_REFUSED: str = "dependency root 'dep' must be a physical directory, not a symlink or another kind of entry";

# whether the dependency root exists; err when it is anything but a physical directory
pub fun check_dep_root(project_root: str) res[bool, outcome.Fail] {
    var root_fd: usize = os.INVALID_HANDLE;
    val opened:  i64   = remove.open_path(project_root, ?root_fd);
    if (opened < 0) { ret res[bool, outcome.Fail].err{outcome.user(os.error_message(opened))}; }
    fin { os.close(root_fd); }
    var st:     os.stat_t;
    val probed: i64 = os.stat_path(root_fd, REALIZE_DEP_DIR, ?st, os.AT_SYMLINK_NOFOLLOW);
    if (os.error_kind(probed) == io_error.NOT_FOUND)       { ret res[bool, outcome.Fail].ok{false}; }
    if (probed < 0)                                        { ret res[bool, outcome.Fail].err{outcome.user(os.error_message(probed))}; }
    if ((native.stat_mode(?st) & os.S_IFMT) != os.S_IFDIR) { ret res[bool, outcome.Fail].err{outcome.user(DEP_ROOT_REFUSED)}; }
    ret res[bool, outcome.Fail].ok{true};
}

pub fun resolve_deps(p: *project.Project, m: *manifest.Manifest, project_root: str) err[outcome.Fail] {
    val root_r: res[bool, outcome.Fail] = check_dep_root(project_root);
    if (sel root_r.err) { ret err[outcome.Fail].err{root_r.err}; }
    if (m.dep_count == 0) {
        if (p.config.deps != nil && p.config.dep_count > 0) {
            project.free_dep_entries(p.alloc, p.config.deps, p.config.dep_count, p.config.dep_count::usize);
        }
        p.config.deps      = nil;
        p.config.dep_count = 0;
        ret check_compiler_requirements(p, m, nil, 0, root_label(p, m));
    }

    val max_deps: usize                           = 128;
    val r:        res[*project.DepEntry, A.Error] = A.allocate[project.DepEntry](p.alloc, max_deps);
    if (sel r.err) { ret err[outcome.Fail].err{outcome.refused(r.err)}; }
    val deps:      *project.DepEntry = r.ok;
    var dep_count: u32               = 0;

    val ar: res[*bool, A.Error] = A.allocate[bool](p.alloc, max_deps);
    if (sel ar.err) {
        A.deallocate[project.DepEntry](p.alloc, deps, max_deps);
        ret err[outcome.Fail].err{outcome.refused(ar.err)};
    }
    val active: *bool = ar.ok;

    val dir_dep_opt: opt[str] = intern.lookup(?p.s.interner, p.config.dir_dep);
    if (sel dir_dep_opt.none) {
        A.deallocate[project.DepEntry](p.alloc, deps, max_deps);
        A.deallocate[bool](p.alloc, active, max_deps);
        ret err[outcome.Fail].err{outcome.user("dep dir StrId not interned")};
    }
    val dir_dep: str = dir_dep_opt.some;

    val root_name: str = root_label(p, m);

    var gi:     GitInspector = GitInspector{program: nil};
    var root_i: u32          = 0;
    for (root_i < m.dep_count) {
        val edge_r: res[u32, outcome.Fail] = resolve_dep_edge(p, ?gi, m, project_root, ?m.deps[root_i],
            deps, active, ?dep_count, max_deps, dir_dep, root_name);
        if (sel edge_r.err) {
            git_inspector_dnit(p.alloc, ?gi);
            A.deallocate[bool](p.alloc, active, max_deps);
            project.free_dep_entries(p.alloc, deps, dep_count, max_deps);
            ret err[outcome.Fail].err{edge_r.err};
        }
        root_i = root_i + 1;
    }
    git_inspector_dnit(p.alloc, ?gi);
    A.deallocate[bool](p.alloc, active, max_deps);

    val needs: err[outcome.Fail] = check_compiler_requirements(p, m, deps, dep_count, root_name);
    if (sel needs.err) {
        project.free_dep_entries(p.alloc, deps, dep_count, max_deps);
        ret needs;
    }

    if (dep_count == 0) {
        A.deallocate[project.DepEntry](p.alloc, deps, max_deps);
        if (p.config.deps != nil && p.config.dep_count > 0) {
            project.free_dep_entries(p.alloc, p.config.deps, p.config.dep_count, p.config.dep_count::usize);
        }
        p.config.deps      = nil;
        p.config.dep_count = 0;
    }
    or {
        val r_shrink: res[*project.DepEntry, A.Error] = A.allocate[project.DepEntry](p.alloc, dep_count::usize);
        if (sel r_shrink.err) {
            project.free_dep_entries(p.alloc, deps, dep_count, max_deps);
            ret err[outcome.Fail].err{outcome.refused(r_shrink.err)};
        }
        val shrunk: *project.DepEntry = r_shrink.ok;
        var idx:    u32               = 0;
        for (idx < dep_count) {
            shrunk[idx] = deps[idx];
            idx         = idx + 1;
        }
        A.deallocate[project.DepEntry](p.alloc, deps, max_deps);
        if (p.config.deps != nil && p.config.dep_count > 0) {
            project.free_dep_entries(p.alloc, p.config.deps, p.config.dep_count, p.config.dep_count::usize);
        }
        p.config.deps      = shrunk;
        p.config.dep_count = dep_count;
    }
    ret err[outcome.Fail].ok{};
}

fun mark_closure(p: *project.Project, keep: *bool, i: u32) {
    if (keep[i]) { ret; }
    keep[i] = true;
    var k: u32 = 0;
    for (k < p.config.deps[i].direct_count) {
        val next: i64 = dep_graph_index(p, p.config.deps[i].direct[k]);
        if (next >= 0) { mark_closure(p, keep, next::u32); }
        k = k + 1;
    }
}

# make a resolved closure the closure of one of its dependencies: the dependency's
# entry moves to `p.config.owner` and `p.config.deps` keeps only what it reaches
# through its own edges, in closure order
# ---
# p:     a project whose `p.config.deps` holds the root's resolved closure
# owner: the dependency's project id
# ret:   ok; err when the closure holds no such dependency
pub fun scope_closure_to_dependency(p: *project.Project, owner: str) err[outcome.Fail] {
    val n:     u32 = p.config.dep_count;
    var found: i64 = -1;
    var i:     u32 = 0;
    for (i < n) {
        if (str_equals(id_text_or(p.s, p.config.deps[i].project_id, ""), owner)) { found = i::i64; }
        i = i + 1;
    }
    if (found < 0) {
        val msg: res[str, format.FormatError] = format.sprint(p.alloc,
            "dependency '{}' is not in the resolved dependency closure", owner);
        if (sel msg.err) { ret err[outcome.Fail].err{outcome.user(outcome.format_text(msg.err))}; }
        ret err[outcome.Fail].err{outcome.user(msg.ok)};
    }
    val oi: u32 = found::u32;

    val kr: res[*bool, A.Error] = A.allocate[bool](p.alloc, n::usize);
    if (sel kr.err) { ret err[outcome.Fail].err{outcome.refused(kr.err)}; }
    val keep: *bool = kr.ok;
    fin { A.deallocate[bool](p.alloc, keep, n::usize); }
    i = 0;
    for (i < n) {
        keep[i] = false;
        i       = i + 1;
    }
    var k: u32 = 0;
    for (k < p.config.deps[oi].direct_count) {
        val next: i64 = dep_graph_index(p, p.config.deps[oi].direct[k]);
        if (next < 0) { ret err[outcome.Fail].err{outcome.internal("verified dependency graph contains an unresolved direct edge")}; }
        mark_closure(p, keep, next::u32);
        k = k + 1;
    }

    var kept: u32 = 0;
    i = 0;
    for (i < n) {
        if (keep[i]) { kept = kept + 1; }
        i = i + 1;
    }
    var scoped: *project.DepEntry = nil;
    if (kept > 0) {
        val sr: res[*project.DepEntry, A.Error] = A.allocate[project.DepEntry](p.alloc, kept::usize);
        if (sel sr.err) { ret err[outcome.Fail].err{outcome.refused(sr.err)}; }
        scoped = sr.ok;
    }
    var w: u32 = 0;
    i = 0;
    for (i < n) {
        if (keep[i]) {
            scoped[w] = p.config.deps[i];
            w         = w + 1;
        }
        or (i == oi) { p.config.owner = p.config.deps[i]; }
        or           { project.free_dep_entries_in_place(p.alloc, ?p.config.deps[i], 1); }
        i = i + 1;
    }
    A.deallocate[project.DepEntry](p.alloc, p.config.deps, n::usize);
    p.config.dependency_owned = true;
    p.config.deps             = scoped;
    p.config.dep_count        = kept;
    ret err[outcome.Fail].ok{};
}

# the requirement scope of each project a configured cell compiles: the declaring
# project's, holding the cell artifact's requirements, then one per closure
# dependency, holding what its default library artifacts require
# ---
# p:       a configured project whose `art_reqs` and `deps` are resolved
# root:    the root manifest, whose out and profile the dependencies' outputs expand in
# profile: the resolved profile name
# ret:     ok with `p.config.req_scopes` set; err from output expansion
pub fun resolve_requirement_scopes(p: *project.Project, root: *manifest.Manifest, profile: str) err[outcome.Fail] {
    val n:  u32                                      = p.config.dep_count + 1;
    val sr: res[*manifest.RequirementScope, A.Error] = A.allocate[manifest.RequirementScope](p.alloc, n::usize);
    if (sel sr.err) { ret err[outcome.Fail].err{outcome.refused(sr.err)}; }
    val scopes: *manifest.RequirementScope = sr.ok;
    scopes[0] = manifest.RequirementScope{owner: p.config.id, dependency: false,
        reqs: p.config.art_reqs, req_count: p.config.art_req_count};
    p.config.req_scopes      = scopes;
    p.config.req_scope_count = 1;

    var i: u32 = 0;
    for (i < p.config.dep_count) {
        val dep:   *project.DepEntry     = ?p.config.deps[i];
        var scope: manifest.Scope        = manifest.dependency_scope(root, ?dep.manifest);
        var items: *manifest.ArtifactReq = nil;
        var count: u32                   = 0;
        val rr:    err[outcome.Fail]     = manifest.resolve_default_library_reqs(p.alloc, ?p.s.interner, p.s.registry,
            ?scope, profile, ?items, ?count);
        if (sel rr.err) { ret rr; }
        scopes[i + 1] = manifest.RequirementScope{owner: dep.project_id, dependency: true,
            reqs: items, req_count: count};
        p.config.req_scope_count = i + 2;
        i                        = i + 1;
    }
    ret err[outcome.Fail].ok{};
}

fun free_cascade_scratch(alloc: *A.Allocator, order: *u32, state: *u8, n: u32) {
    A.deallocate[u32](alloc, order, n::usize);
    A.deallocate[u8](alloc, state, n::usize);
}

fun dep_graph_index(p: *project.Project, id: intern.StrId) i64 {
    var i: u32 = 0;
    for (i < p.config.dep_count) {
        if (p.config.deps[i].project_id == id) { ret i::i64; }
        i = i + 1;
    }
    ret -1;
}

fun cascade_dfs(p: *project.Project, state: *u8, order: *u32, order_len: *u32, i: u32) err[outcome.Fail] {
    if (state[i] == 2) { ret err[outcome.Fail].ok{}; }
    if (state[i] == 1) { ret err[outcome.Fail].err{outcome.user("dependency graph contains a cycle")}; }
    state[i] = 1;
    var k: u32 = 0;
    for (k < p.config.deps[i].direct_count) {
        val next: i64 = dep_graph_index(p, p.config.deps[i].direct[k]);
        if (next < 0) { ret err[outcome.Fail].err{outcome.user("verified dependency graph contains an unresolved direct edge")}; }
        val rr: err[outcome.Fail] = cascade_dfs(p, state, order, order_len, next::u32);
        if (sel rr.err) { ret err[outcome.Fail].err{rr.err}; }
        k = k + 1;
    }
    state[i]          = 2;
    order[@order_len] = i;
    @order_len        = @order_len + 1;
    ret err[outcome.Fail].ok{};
}

pub fun resolve_cascade_libs(p: *project.Project, isa: str, os: str, abi: str,
    own_libs: *manifest.LinkRequirement, own_count: u32) err[outcome.Fail] {
    if (p.config.cascade_libs != nil && p.config.cascade_lib_count > 0) {
        manifest.free_link_claims(p.alloc, p.config.cascade_libs, p.config.cascade_lib_count);
        A.deallocate[manifest.LinkRequirement](p.alloc, p.config.cascade_libs, p.config.cascade_lib_count::usize);
    }
    p.config.cascade_libs      = nil;
    p.config.cascade_lib_count = 0;
    val n: u32 = p.config.dep_count;
    if (n == 0) { ret err[outcome.Fail].ok{}; }

    val ov: res[*u32, A.Error] = A.allocate[u32](p.alloc, n::usize);
    if (sel ov.err) { ret err[outcome.Fail].err{outcome.refused(ov.err)}; }
    val order: *u32              = ov.ok;
    val vv:    res[*u8, A.Error] = A.allocate[u8](p.alloc, n::usize);
    if (sel vv.err) {
        A.deallocate[u32](p.alloc, order, n::usize);
        ret err[outcome.Fail].err{outcome.refused(vv.err)};
    }
    val state: *u8 = vv.ok;
    var i:     u32 = 0;
    for (i < n) {
        state[i] = 0;
        i        = i + 1;
    }
    var order_len: u32 = 0;
    i = 0;
    for (i < n) {
        val dr: err[outcome.Fail] = cascade_dfs(p, state, order, ?order_len, i);
        if (sel dr.err) {
            free_cascade_scratch(p.alloc, order, state, n);
            ret dr;
        }
        i = i + 1;
    }

    var tgt:         manifest.TargetDef;
    val res_tgt_isa: res[intern.StrId, A.Error] = intern.intern(?p.s.interner, isa);
    if (sel res_tgt_isa.err) {
        free_cascade_scratch(p.alloc, order, state, n);
        ret err[outcome.Fail].err{outcome.refused(res_tgt_isa.err)};
    }
    tgt.isa = res_tgt_isa.ok;

    val res_tgt_os: res[intern.StrId, A.Error] = intern.intern(?p.s.interner, os);
    if (sel res_tgt_os.err) {
        free_cascade_scratch(p.alloc, order, state, n);
        ret err[outcome.Fail].err{outcome.refused(res_tgt_os.err)};
    }
    tgt.os = res_tgt_os.ok;

    val res_tgt_abi: res[intern.StrId, A.Error] = intern.intern(?p.s.interner, abi);
    if (sel res_tgt_abi.err) {
        free_cascade_scratch(p.alloc, order, state, n);
        ret err[outcome.Fail].err{outcome.refused(res_tgt_abi.err)};
    }
    tgt.abi = res_tgt_abi.ok;

    var max: u32 = 0;
    i = 0;
    for (i < n) {
        val mfd: *manifest.Manifest = ?p.config.deps[i].manifest;
        max = max + mfd.link_count;
        i   = i + 1;
    }

    if (max == 0) {
        free_cascade_scratch(p.alloc, order, state, n);
        ret err[outcome.Fail].ok{};
    }

    val br: res[*manifest.LinkRequirement, A.Error] = A.allocate[manifest.LinkRequirement](p.alloc, max::usize);
    if (sel br.err) {
        free_cascade_scratch(p.alloc, order, state, n);
        ret err[outcome.Fail].err{outcome.refused(br.err)};
    }
    val buf: *manifest.LinkRequirement = br.ok;
    var w:   u32                       = 0;

    var oi: u32 = 0;
    for (oi < order_len) {
        val di:  u32                = order[oi];
        val mfd: *manifest.Manifest = ?p.config.deps[di].manifest;

        var li: u32 = 0;
        for (li < mfd.link_count) {
            val l: *manifest.LinkDef = ?mfd.links[li];
            if (l.export && manifest.link_matches_target(?p.s.interner, l, ?tgt)) {
                val root_out_opt: opt[str] = intern.lookup(?p.s.interner, p.config.project_out);
                if (sel root_out_opt.none) {
                    free_cascade_scratch(p.alloc, order, state, n);
                    manifest.free_link_claims(p.alloc, buf, w);
                    A.deallocate[manifest.LinkRequirement](p.alloc, buf, max::usize);
                    ret err[outcome.Fail].err{outcome.user("internal: project output not interned")};
                }
                var cv:    manifest.TmplVars                           = cell_tmpl_vars(p);
                val req_r: res[manifest.LinkRequirement, outcome.Fail] = manifest.link_requirement(p.alloc, ?p.s.interner, l, root_out_opt.some, ?cv);
                if (sel req_r.err) {
                    free_cascade_scratch(p.alloc, order, state, n);
                    manifest.free_link_claims(p.alloc, buf, w);
                    A.deallocate[manifest.LinkRequirement](p.alloc, buf, max::usize);
                    ret err[outcome.Fail].err{req_r.err};
                }
                var req:           manifest.LinkRequirement = req_r.ok;
                val own_duplicate: i64                      = requirement_index(own_libs, own_count, ?req);
                val dep_duplicate: i64                      = requirement_index(buf, w, ?req);
                if (own_duplicate < 0 && dep_duplicate < 0) {
                    buf[w] = req;
                    w      = w + 1;
                }
                or {
                    var retained: *manifest.LinkRequirement = nil;
                    if (own_duplicate >= 0) { retained = ?own_libs[own_duplicate::u32]; }
                    or                      { retained = ?buf[dep_duplicate::u32]; }
                    val mr: err[outcome.Fail] = manifest.merge_link_claims(p.alloc, retained, ?req);
                    if (sel mr.err) {
                        manifest.free_link_claims(p.alloc, ?req, 1);
                        free_cascade_scratch(p.alloc, order, state, n);
                        manifest.free_link_claims(p.alloc, buf, w);
                        A.deallocate[manifest.LinkRequirement](p.alloc, buf, max::usize);
                        ret mr;
                    }
                    manifest.free_link_claims(p.alloc, ?req, 1);
                }
            }
            li = li + 1;
        }
        oi = oi + 1;
    }

    free_cascade_scratch(p.alloc, order, state, n);
    ret manifest.finish_link_requirements(p.alloc, buf, max, w,
        ?p.config.cascade_libs, ?p.config.cascade_lib_count);
}

fun requirement_index(arr: *manifest.LinkRequirement, count: u32,
    req: *manifest.LinkRequirement) i64 {
    if (arr == nil) { ret -1; }
    var k: u32 = 0;
    for (k < count) {
        if (arr[k].source == req.source && arr[k].text == req.text
            && arr[k].library == req.library) { ret k::i64; }
        k = k + 1;
    }
    ret -1;
}

fun diag_dep_manifest_error(s: *session.Session, alias: str, dep_dir: str, root: str, read_err: str) str {
    val fallback: str                       = "dep manifest unreadable; run `mach dep pull <path>`";
    var res_msg:  res[str, format.FormatError];
    val exists_r: res[bool, io_error.Error] = fs.exists(dep_dir);
    if (!(sel exists_r.ok && exists_r.ok)) {
        res_msg = format.sprint(s.build_alloc,
            "dependency '{}' is not resolved (missing '{}'); run `mach dep pull <path>` for project '{}'", alias, dep_dir, root);
    }
    or {
        res_msg = format.sprint(s.build_alloc, "dep '{}': {}", alias, read_err);
    }
    if (sel res_msg.err) { ret fallback; }
    val buf: str = res_msg.ok;

    val ir: res[intern.StrId, A.Error] = intern.intern(?s.interner, buf);
    str_free(s.build_alloc, buf);
    if (sel ir.err) { ret fallback; }

    val nm: opt[str] = intern.lookup(?s.interner, ir.ok);
    if (sel nm.some) { ret nm.some; }
    ret fallback;
}

fun git_inspector_require(alloc: *A.Allocator, gi: *GitInspector) err[outcome.Fail] {
    if (!str_empty(gi.program)) { ret err[outcome.Fail].ok{}; }
    val ir: res[GitInspector, outcome.Fail] = git_inspector_init(alloc);
    if (sel ir.err) { ret err[outcome.Fail].err{ir.err}; }
    @gi = ir.ok;
    ret err[outcome.Fail].ok{};
}

fun git_query_named(s: *session.Session, gi: *GitInspector, alias: str, dir: str,
    args: *str, count: usize, fact: str) res[str, outcome.Fail] {
    val qr: res[str, outcome.Fail] = git_query(s.build_alloc, gi, dir, args, count);
    if (sel qr.ok) { ret qr; }
    val mr: res[str, format.FormatError] = format.sprint(s.build_alloc,
        "dependency '{}': cannot verify {}: {}", alias, fact, outcome.describe(qr.err));
    if (sel mr.err) { ret res[str, outcome.Fail].err{qr.err}; }
    ret res[str, outcome.Fail].err{outcome.user(mr.ok)};
}

fun require_git_root(s: *session.Session, gi: *GitInspector, alias: str, dir: str,
    subject: str) err[outcome.Fail] {
    var inside_args: [2]str;
    inside_args[0] = "rev-parse";
    inside_args[1] = "--is-inside-work-tree";
    val inside_r: res[str, outcome.Fail] = git_query_named(s, gi, alias, dir, ?inside_args[0], 2, subject);
    if (sel inside_r.err) { ret err[outcome.Fail].err{inside_r.err}; }
    val inside: str = inside_r.ok;
    if (!str_equals(inside, "true")) {
        str_free(s.build_alloc, inside);
        ret err[outcome.Fail].err{outcome.user("dependency declaring package is not a Git work tree")};
    }
    str_free(s.build_alloc, inside);

    ret err[outcome.Fail].ok{};
}

val DEP_AUTHORITY_REPO:   u8 = 0;
val DEP_AUTHORITY_NESTED: u8 = 1;

fun project_root_authority(s: *session.Session, gi: *GitInspector, alias: str,
    project_root: str) res[u8, outcome.Fail] {
    val marker_r: res[str, fail.Fail] = load.join_path(s.build_alloc, project_root, ".git");
    if (sel marker_r.err) { ret res[u8, outcome.Fail].err{outcome.from_fail(marker_r.err)}; }
    val marker: str = marker_r.ok;
    fin { str_free(s.build_alloc, marker); }
    var st:       os.stat_t;
    val observed: i64 = os.stat_path(os.working_dir(), marker, ?st, os.AT_SYMLINK_NOFOLLOW);
    if (os.error_kind(observed) == io_error.NOT_FOUND) { ret res[u8, outcome.Fail].ok{DEP_AUTHORITY_NESTED}; }
    if (observed < 0)                                  { ret res[u8, outcome.Fail].err{outcome.user(os.error_message(observed))}; }
    val required: err[outcome.Fail] = git_inspector_require(s.build_alloc, gi);
    if (sel required.err) { ret res[u8, outcome.Fail].err{required.err}; }
    var inside_args: [2]str;
    inside_args[0] = "rev-parse";
    inside_args[1] = "--is-inside-work-tree";
    val inside_r: res[str, outcome.Fail] = git_query(s.build_alloc, gi, project_root, ?inside_args[0], 2);
    if (sel inside_r.err) {
        val nr: res[str, format.FormatError] = format.sprint(s.build_alloc,
            "dependency '{}': project root '{}' is not inside a Git repository; dependency realization is verified from Git",
            alias, project_root);
        if (sel nr.err) { ret res[u8, outcome.Fail].err{outcome.user("project root is not inside a Git repository")}; }
        ret res[u8, outcome.Fail].err{outcome.user(nr.ok)};
    }
    val inside:  str  = inside_r.ok;
    val is_tree: bool = str_equals(inside, "true");
    str_free(s.build_alloc, inside);
    if (!is_tree) {
        val nr: res[str, format.FormatError] = format.sprint(s.build_alloc,
            "dependency '{}': project root '{}' is not inside a Git repository; dependency realization is verified from Git",
            alias, project_root);
        if (sel nr.err) { ret res[u8, outcome.Fail].err{outcome.user("project root is not inside a Git repository")}; }
        ret res[u8, outcome.Fail].err{outcome.user(nr.ok)};
    }
    val prefix_r: res[str, outcome.Fail] = declaring_prefix(s, gi, alias, project_root);
    if (sel prefix_r.err) { ret res[u8, outcome.Fail].err{prefix_r.err}; }
    val prefix: str  = prefix_r.ok;
    val nested: bool = !str_empty(prefix);
    str_free(s.build_alloc, prefix);
    if (nested) { ret res[u8, outcome.Fail].ok{DEP_AUTHORITY_NESTED}; }
    ret res[u8, outcome.Fail].ok{DEP_AUTHORITY_REPO};
}

fun declaring_prefix(s: *session.Session, gi: *GitInspector, alias: str, dir: str) res[str, outcome.Fail] {
    var args: [2]str;
    args[0] = "rev-parse";
    args[1] = "--show-prefix";
    ret git_query_named(s, gi, alias, dir, ?args[0], 2, "declaring package identity");
}

fun git_object_id_valid(id: str) bool {
    val n: usize = str_len(id);
    if (n != 40 && n != 64) { ret false; }
    var i: usize = 0;
    for (i < n) {
        val c: u8 = id[i];
        if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun index_entry_field(s: *session.Session, gi: *GitInspector, alias: str, root: str,
    rel: str, field: usize, fact: str) res[str, outcome.Fail] {
    var args: [4]str;
    args[0] = "ls-files";
    args[1] = "--stage";
    args[2] = "--";
    args[3] = rel;
    val q: res[str, outcome.Fail] = git_query_named(s, gi, alias, root, ?args[0], 4, fact);
    if (sel q.err) { ret res[str, outcome.Fail].err{q.err}; }
    val line:    str   = q.ok;
    val n:       usize = str_len(line);
    var start_i: usize = 0;
    var f:       usize = 0;
    for (f < field) {
        for (start_i < n && line[start_i] != ' ') { start_i = start_i + 1; }
        if (start_i < n) { start_i = start_i + 1; }
        f = f + 1;
    }
    var end_i: usize = start_i;
    for (end_i < n && line[end_i] != ' ' && line[end_i] != '\t') { end_i = end_i + 1; }
    val out: res[str, string.StrError] = str_copy_slice(s.build_alloc, line, start_i, end_i - start_i);
    str_free(s.build_alloc, line);
    if (sel out.err) { ret res[str, outcome.Fail].err{outcome.user(outcome.str_text(out.err))}; }
    ret res[str, outcome.Fail].ok{out.ok};
}

fun porcelain_has_worktree_change(text: str) bool {
    val n: usize = str_len(text);
    var i: usize = 0;
    for (i < n) {
        var j: usize = i;
        for (j < n && text[j] != '\n') { j = j + 1; }
        if (j - i >= 2 && text[i + 1] != ' ') { ret true; }
        i = j + 1;
    }
    ret false;
}

fun require_matches_index(s: *session.Session, gi: *GitInspector, alias: str, root: str,
    rel: str, subject: str) err[outcome.Fail] {
    var args: [5]str;
    args[0] = "status";
    args[1] = "--porcelain=v1";
    args[2] = "--untracked-files=all";
    args[3] = "--";
    args[4] = rel;
    val q: res[str, outcome.Fail] = git_query_raw(s.build_alloc, gi, root, ?args[0], 5);
    if (sel q.err) {
        val er: res[str, outcome.Fail] = git_query_named(s, gi, alias, root, ?args[0], 5, subject);
        if (sel er.err) { ret err[outcome.Fail].err{er.err}; }
        str_free(s.build_alloc, er.ok);
        ret err[outcome.Fail].ok{};
    }
    val out:   str  = q.ok;
    val dirty: bool = porcelain_has_worktree_change(out);
    str_free(s.build_alloc, out);
    if (!dirty) { ret err[outcome.Fail].ok{}; }
    val msg_r: res[str, format.FormatError] = format.sprint(s.build_alloc,
        "dependency '{}': '{}' in the working tree does not match what is staged", alias, rel);
    if (sel msg_r.err) { ret err[outcome.Fail].err{outcome.user("a dependency record does not match what is staged")}; }
    ret err[outcome.Fail].err{outcome.user(msg_r.ok)};
}

fun require_tracked(s: *session.Session, gi: *GitInspector, alias: str, root: str,
    rel: str, subject: str) err[outcome.Fail] {
    var args: [4]str;
    args[0] = "ls-files";
    args[1] = "--";
    args[2] = rel;
    args[3] = "";
    val q: res[str, outcome.Fail] = git_query_named(s, gi, alias, root, ?args[0], 3, subject);
    if (sel q.err) { ret err[outcome.Fail].err{q.err}; }
    val out:     str  = q.ok;
    val present: bool = !str_empty(out);
    str_free(s.build_alloc, out);
    if (present) { ret err[outcome.Fail].ok{}; }
    val msg_r: res[str, format.FormatError] = format.sprint(s.build_alloc,
        "dependency '{}': '{}' is not staged; run `mach dep pull <path>` for project '{}'", alias, rel, root);
    if (sel msg_r.err) { ret err[outcome.Fail].err{outcome.user("a dependency record is not staged")}; }
    ret err[outcome.Fail].err{outcome.user(msg_r.ok)};
}

fun verify_declaring_manifest(s: *session.Session, gi: *GitInspector, alias: str,
    parent_root: str) err[outcome.Fail] {
    ret require_git_root(s, gi, alias, parent_root, "declaring package identity");
}

fun verify_parent_gitlink(s: *session.Session, gi: *GitInspector, alias: str,
    parent_root: str, dir_dep: str, d: *manifest.DepDef) res[intern.StrId, outcome.Fail] {
    val manifest_r: err[outcome.Fail] = verify_declaring_manifest(s, gi, alias, parent_root);
    if (sel manifest_r.err) { ret res[intern.StrId, outcome.Fail].err{manifest_r.err}; }

    val gm_tracked: err[outcome.Fail] = require_tracked(s, gi, alias, parent_root, ".gitmodules", "staged dependency metadata");
    if (sel gm_tracked.err) { ret res[intern.StrId, outcome.Fail].err{gm_tracked.err}; }
    val gm_clean: err[outcome.Fail] = require_matches_index(s, gi, alias, parent_root, ".gitmodules", "staged dependency metadata");
    if (sel gm_clean.err) { ret res[intern.StrId, outcome.Fail].err{gm_clean.err}; }

    val rel_r: res[str, format.FormatError] = format.sprint(s.build_alloc, "{}/{}", dir_dep, alias);
    if (sel rel_r.err) { ret res[intern.StrId, outcome.Fail].err{outcome.user(outcome.format_text(rel_r.err))}; }
    val rel: str = rel_r.ok;

    val gm_sha_r: res[str, outcome.Fail] = index_entry_field(s, gi, alias, parent_root, ".gitmodules", 1, "staged dependency metadata");
    if (sel gm_sha_r.err) {
        str_free(s.build_alloc, rel);
        ret res[intern.StrId, outcome.Fail].err{gm_sha_r.err};
    }
    val gm_sha:         str                          = gm_sha_r.ok;
    val modules_spec_r: res[str, format.FormatError] = format.sprint(s.build_alloc, "--blob={}", gm_sha);
    str_free(s.build_alloc, gm_sha);
    if (sel modules_spec_r.err) {
        str_free(s.build_alloc, rel);
        ret res[intern.StrId, outcome.Fail].err{outcome.user(outcome.format_text(modules_spec_r.err))};
    }
    val modules_spec: str = modules_spec_r.ok;

    val path_key_r: res[str, format.FormatError] = format.sprint(s.build_alloc, "submodule.{}.path", rel);
    if (sel path_key_r.err) {
        str_free(s.build_alloc, modules_spec);
        str_free(s.build_alloc, rel);
        ret res[intern.StrId, outcome.Fail].err{outcome.user(outcome.format_text(path_key_r.err))};
    }
    val path_key:    str = path_key_r.ok;
    var config_args: [4]str;
    config_args[0] = "config";
    config_args[1] = modules_spec;
    config_args[2] = "--get-all";
    config_args[3] = path_key;
    val path_r: res[str, outcome.Fail] = git_query_named(s, gi, alias, parent_root, ?config_args[0], 4, ".gitmodules path");
    str_free(s.build_alloc, path_key);
    if (sel path_r.err) {
        str_free(s.build_alloc, modules_spec);
        str_free(s.build_alloc, rel);
        ret res[intern.StrId, outcome.Fail].err{path_r.err};
    }
    val observed_path: str = path_r.ok;
    if (!str_equals(observed_path, rel)) {
        str_free(s.build_alloc, observed_path);
        str_free(s.build_alloc, modules_spec);
        str_free(s.build_alloc, rel);
        ret res[intern.StrId, outcome.Fail].err{outcome.user("dependency .gitmodules path does not match its package-owned realization")};
    }
    str_free(s.build_alloc, observed_path);

    val url_key_r: res[str, format.FormatError] = format.sprint(s.build_alloc, "submodule.{}.url", rel);
    if (sel url_key_r.err) {
        str_free(s.build_alloc, modules_spec);
        str_free(s.build_alloc, rel);
        ret res[intern.StrId, outcome.Fail].err{outcome.user(outcome.format_text(url_key_r.err))};
    }
    val url_key: str = url_key_r.ok;
    config_args[3] = url_key;
    val url_r: res[str, outcome.Fail] = git_query_named(s, gi, alias, parent_root, ?config_args[0], 4, ".gitmodules URL");
    str_free(s.build_alloc, url_key);
    str_free(s.build_alloc, modules_spec);
    if (sel url_r.err) {
        str_free(s.build_alloc, rel);
        ret res[intern.StrId, outcome.Fail].err{url_r.err};
    }
    val observed_url: str      = url_r.ok;
    val source_opt:   opt[str] = intern.lookup(?s.interner, d.git);
    if (sel source_opt.none) {
        str_free(s.build_alloc, observed_url);
        str_free(s.build_alloc, rel);
        ret res[intern.StrId, outcome.Fail].err{outcome.user("dependency Git source is not interned")};
    }
    if (!str_equals(observed_url, source_opt.some)) {
        str_free(s.build_alloc, observed_url);
        str_free(s.build_alloc, rel);
        ret res[intern.StrId, outcome.Fail].err{outcome.user("dependency .gitmodules URL does not match manifest source")};
    }
    str_free(s.build_alloc, observed_url);

    val mode_r: res[str, outcome.Fail] = index_entry_field(s, gi, alias, parent_root, rel, 0, "staged gitlink");
    if (sel mode_r.err) {
        str_free(s.build_alloc, rel);
        ret res[intern.StrId, outcome.Fail].err{mode_r.err};
    }
    val mode_text:  str  = mode_r.ok;
    val is_gitlink: bool = str_equals(mode_text, "160000");
    str_free(s.build_alloc, mode_text);
    if (!is_gitlink) {
        str_free(s.build_alloc, rel);
        ret res[intern.StrId, outcome.Fail].err{outcome.user("dependency path is not a staged gitlink")};
    }
    val sha_r: res[str, outcome.Fail] = index_entry_field(s, gi, alias, parent_root, rel, 1, "staged gitlink");
    str_free(s.build_alloc, rel);
    if (sel sha_r.err) { ret res[intern.StrId, outcome.Fail].err{sha_r.err}; }
    val gitlink: str = sha_r.ok;
    if (!git_object_id_valid(gitlink)) {
        str_free(s.build_alloc, gitlink);
        ret res[intern.StrId, outcome.Fail].err{outcome.user("dependency path is not a staged gitlink")};
    }
    val content_r: res[intern.StrId, A.Error] = intern.intern(?s.interner, gitlink);
    str_free(s.build_alloc, gitlink);
    if (sel content_r.err) { ret res[intern.StrId, outcome.Fail].err{outcome.refused(content_r.err)}; }
    ret res[intern.StrId, outcome.Fail].ok{content_r.ok};
}

fun selector_satisfied(s: *session.Session, gi: *GitInspector, alias: str, chain: str, project_root: str, dep_dir: str, ref: str, pin: str) err[outcome.Fail] {
    if (str_empty(ref) || str_starts_with(ref, "branch/")) { ret err[outcome.Fail].ok{}; }
    var want:  str  = "";
    var owned: bool = false;
    if (str_starts_with(ref, "commit/")) { want = (?ref[7])::str; }
    or (str_starts_with(ref, "tag/")) {
        val spec_r: res[str, format.FormatError] = format.sprint(s.build_alloc, "refs/tags/{}^{{commit}}", (?ref[4])::str);
        if (sel spec_r.err) { ret err[outcome.Fail].err{outcome.user(outcome.format_text(spec_r.err))}; }
        val spec: str = spec_r.ok;
        var args: [4]str;
        args[0] = "rev-parse";
        args[1] = "--verify";
        args[2] = "--quiet";
        args[3] = spec;
        val r: res[str, outcome.Fail] = git_query(s.build_alloc, gi, dep_dir, ?args[0], 4);
        str_free(s.build_alloc, spec);
        if (sel r.err) {
            val mr: res[str, format.FormatError] = format.sprint(s.build_alloc,
                "dependency '{}': exact ref '{}' required by {} names a tag the checkout does not have; run `mach dep update <path> {}` or `mach dep pull <path>` for project '{}'", alias, ref, chain, alias, project_root);
            if (sel mr.err) { ret err[outcome.Fail].err{outcome.user("dependency tag ref is not present in the checkout")}; }
            ret err[outcome.Fail].err{outcome.user(mr.ok)};
        }
        want  = r.ok;
        owned = true;
    }
    or { ret err[outcome.Fail].err{outcome.user("dependency ref kind is invalid")}; }
    val ok: bool = str_equals(want, pin);
    if (ok) {
        if (owned) { str_free(s.build_alloc, want); }
        ret err[outcome.Fail].ok{};
    }
    val mr: res[str, format.FormatError] = format.sprint(s.build_alloc,
        "dependency '{}': exact ref '{}' required by {} resolves to '{}' but the realized commit is '{}'; run `mach dep update <path> {}` for project '{}' to re-pin it, or declare the identity at the root to override",
        alias, ref, chain, want, pin, alias, project_root);
    if (owned)      { str_free(s.build_alloc, want); }
    if (sel mr.err) { ret err[outcome.Fail].err{outcome.user("dependency exact ref is not satisfied by the realized commit")}; }
    ret err[outcome.Fail].err{outcome.user(mr.ok)};
}

fun requirer_selector_satisfied(s: *session.Session, gi: *GitInspector, alias: str, chain: str, project_root: str,
    dir_dep: str, d: *manifest.DepDef, content: intern.StrId) err[outcome.Fail] {
    if (d.git == intern.STR_NIL) { ret err[outcome.Fail].ok{}; }
    val content_opt: opt[str] = intern.lookup(?s.interner, content);
    if (sel content_opt.none) { ret err[outcome.Fail].ok{}; }
    val content_text: str = content_opt.some;
    if (!str_starts_with(content_text, "git/")) { ret err[outcome.Fail].ok{}; }
    val pin:       str                    = (?content_text[4])::str;
    val dep_dir_r: res[str, outcome.Fail] = build_dep_root(s.build_alloc, project_root, dir_dep, alias);
    if (sel dep_dir_r.err) { ret err[outcome.Fail].err{dep_dir_r.err}; }
    val dep_dir: str = dep_dir_r.ok;
    fin { str_free(s.build_alloc, dep_dir); }
    if (d.version != intern.STR_NIL) {
        ret range_satisfied(s, gi, alias, chain, project_root, dep_dir, intern_text(s, d.version), pin);
    }
    val ref_opt: opt[str] = intern.lookup(?s.interner, d.ref);
    if (sel ref_opt.none) { ret err[outcome.Fail].ok{}; }
    ret selector_satisfied(s, gi, alias, chain, project_root, dep_dir, ref_opt.some, pin);
}

# a version selection holds when the pinned commit carries a release tag, read offline
# from the checkout's refs, whose version the requirer's range contains (#3496 §4)
fun range_satisfied(s: *session.Session, gi: *GitInspector, alias: str, chain: str, project_root: str,
    dep_dir: str, want: str, pin: str) err[outcome.Fail] {
    val a:   *A.Allocator           = s.build_alloc;
    val rel: res[str, outcome.Fail] = release_at(a, gi, dep_dir, pin);
    if (sel rel.err) { ret err[outcome.Fail].err{rel.err}; }
    val have: str = rel.ok;
    fin { str_free(a, have); }
    var mr: res[str, format.FormatError];
    if (str_empty(have)) {
        mr = format.sprint(a,
            "dependency '{}': {} requires version '{}' but the pinned commit '{}' carries no release tag; run `mach dep update <path> {}` for project '{}' to pin a release",
            alias, chain, want, pin, alias, project_root);
    }
    or {
        val rr: res[range.Range, range.RangeError] = range.parse_range(want);
        if (sel rr.err) { ret err[outcome.Fail].err{outcome.user(rr.err.reason)}; }
        val vr: res[range.Version, str] = range.parse_version(have);
        if (sel vr.err) { ret err[outcome.Fail].err{outcome.user(vr.err)}; }
        var r: range.Range   = rr.ok;
        var v: range.Version = vr.ok;
        if (range.satisfies(?r, ?v)) { ret err[outcome.Fail].ok{}; }
        mr = format.sprint(a,
            "dependency '{}': {} requires version '{}' but the pinned release is {}; run `mach dep update <path> {}` for project '{}' to re-pin it, or declare the identity at the root to override",
            alias, chain, want, have, alias, project_root);
    }
    if (sel mr.err) { ret err[outcome.Fail].err{outcome.user("a dependency's pinned release is outside a requirer's range")}; }
    ret err[outcome.Fail].err{outcome.user(mr.ok)};
}

# a manifest reached through a release (a version range or a `tag/`) may itself select only
# releases, so the release is reproducible from its tag all the way down (#3496 §7)
# ---
# s:     the session
# chain: the requirer chain that reached `m`, or the root's name
# what:  how `m` was selected, as its manifest line spells it
# m:     the manifest to check
# ret:   err naming the first dependency selected by a branch, a commit or a path
pub fun release_selects_releases(s: *session.Session, chain: str, what: str, m: *manifest.Manifest,
    root: *manifest.Manifest) err[outcome.Fail] {
    var i: u32 = 0;
    for (i < m.dep_count) {
        val d: *manifest.DepDef = ?m.deps[i];
        i = i + 1;
        if (root != nil && root_dependency(root, d.name) != nil) { cnt; }
        var line_r: res[str, format.FormatError];
        if (d.git == intern.STR_NIL) {
            line_r = format.sprint(s.build_alloc, "path = \"{}\"", intern_text(s, d.path));
        }
        or (d.version != intern.STR_NIL || str_starts_with(intern_text(s, d.ref), "tag/")) { cnt; }
        or                                                                                 { line_r = format.sprint(s.build_alloc, "ref = \"{}\"", intern_text(s, d.ref)); }
        if (sel line_r.err)                                                                { ret err[outcome.Fail].err{outcome.user(outcome.format_text(line_r.err))}; }
        val mr: res[str, format.FormatError] = format.sprint(s.build_alloc,
            "{} is a release ({}), and its manifest selects [dep.{}] by {}; a release may select its dependencies only by `version` or an exact `tag/`, so it cannot be reproduced from its tag",
            chain, what, intern_text(s, d.name), line_r.ok);
        str_free(s.build_alloc, line_r.ok);
        if (sel mr.err) { ret err[outcome.Fail].err{outcome.user("a release selects a dependency by something other than a version or a tag")}; }
        var remedy: res[str, format.FormatError];
        if (root == nil) {
            remedy = format.sprint(s.build_alloc, "{}; select [dep.{}] by `version` or an exact `tag/` before tagging", mr.ok, intern_text(s, d.name));
        }
        or {
            remedy = format.sprint(s.build_alloc,
                "{}; declare [dep.{}] in your root manifest to select it yourself, or have the dependency cut a release that selects it by `version` or an exact `tag/`",
                mr.ok, intern_text(s, d.name));
        }
        str_free(s.build_alloc, mr.ok);
        if (sel remedy.err) { ret err[outcome.Fail].err{outcome.user("a release selects a dependency by something other than a version or a tag")}; }
        ret err[outcome.Fail].err{outcome.user(remedy.ok)};
    }
    ret err[outcome.Fail].ok{};
}

# how a dependency line selects its target when that target is a release ("" otherwise)
fun release_selection(s: *session.Session, d: *manifest.DepDef) res[str, outcome.Fail] {
    var r: res[str, format.FormatError];
    if (d.git == intern.STR_NIL)     { ret res[str, outcome.Fail].ok{""}; }
    if (d.version != intern.STR_NIL) { r = format.sprint(s.build_alloc, "version = \"{}\"", intern_text(s, d.version)); }
    or {
        val ref: str = intern_text(s, d.ref);
        if (!str_starts_with(ref, "tag/")) { ret res[str, outcome.Fail].ok{""}; }
        r = format.sprint(s.build_alloc, "ref = \"{}\"", ref);
    }
    if (sel r.err) { ret res[str, outcome.Fail].err{outcome.user(outcome.format_text(r.err))}; }
    ret res[str, outcome.Fail].ok{r.ok};
}

# a release reached through `selected` selects only releases, apart from identities the root
# declares: the root's selector replaces the release's there, so the closure stays reproducible (#3553)
fun edge_release_rule(s: *session.Session, chain: str, selected: *manifest.DepDef, m: *manifest.Manifest,
    root_m: *manifest.Manifest) err[outcome.Fail] {
    val what: res[str, outcome.Fail] = release_selection(s, selected);
    if (sel what.err)       { ret err[outcome.Fail].err{what.err}; }
    if (str_empty(what.ok)) { ret err[outcome.Fail].ok{}; }
    val r: err[outcome.Fail] = release_selects_releases(s, chain, what.ok, m, root_m);
    str_free(s.build_alloc, what.ok);
    ret r;
}

fun verify_git_checkout(s: *session.Session, gi: *GitInspector, alias: str,
    parent_root: str, dep_dir: str, dir_dep: str,
    d: *manifest.DepDef, authority: u8) res[intern.StrId, outcome.Fail] {
    var gitlink: str = "";
    if (authority == DEP_AUTHORITY_REPO) {
        val gitlink_r: res[intern.StrId, outcome.Fail] = verify_parent_gitlink(s, gi, alias, parent_root, dir_dep, d);
        if (sel gitlink_r.err) { ret res[intern.StrId, outcome.Fail].err{gitlink_r.err}; }
        val gitlink_id:  intern.StrId = gitlink_r.ok;
        val gitlink_opt: opt[str]     = intern.lookup(?s.interner, gitlink_id);
        if (sel gitlink_opt.none) { ret res[intern.StrId, outcome.Fail].err{outcome.user("dependency gitlink is not interned")}; }
        gitlink = gitlink_opt.some;
    }

    val child_root_r: err[outcome.Fail] = require_git_root(s, gi, alias, dep_dir, "checkout identity");
    if (sel child_root_r.err) { ret res[intern.StrId, outcome.Fail].err{child_root_r.err}; }
    val child_prefix_r: res[str, outcome.Fail] = declaring_prefix(s, gi, alias, dep_dir);
    if (sel child_prefix_r.err) { ret res[intern.StrId, outcome.Fail].err{child_prefix_r.err}; }
    val child_prefix: str = child_prefix_r.ok;
    if (!str_empty(child_prefix)) {
        str_free(s.build_alloc, child_prefix);
        ret res[intern.StrId, outcome.Fail].err{outcome.user("dependency checkout must be the repository root")};
    }
    str_free(s.build_alloc, child_prefix);

    var head_args: [2]str;
    head_args[0] = "rev-parse";
    head_args[1] = "HEAD";
    val head_r: res[str, outcome.Fail] = git_query_named(s, gi, alias, dep_dir, ?head_args[0], 2, "checkout HEAD");
    if (sel head_r.err) { ret res[intern.StrId, outcome.Fail].err{head_r.err}; }
    val head: str = head_r.ok;
    if (!str_empty(gitlink) && !str_equals(head, gitlink)) {
        val mr: res[str, format.FormatError] = format.sprint(s.build_alloc,
            "dependency '{}': HEAD mismatch, parent gitlink is '{}' but checkout is '{}'", alias, gitlink, head);
        str_free(s.build_alloc, head);
        if (sel mr.err) { ret res[intern.StrId, outcome.Fail].err{outcome.user("dependency HEAD does not match parent gitlink")}; }
        ret res[intern.StrId, outcome.Fail].err{outcome.user(mr.ok)};
    }
    var pin: str = gitlink;
    if (str_empty(pin)) { pin = head; }

    # a version range selects releases; whether the pin is one the range accepts is checked with the closure's ranges
    var ref: str = "tag/";
    if (d.version == intern.STR_NIL) {
        val ref_opt: opt[str] = intern.lookup(?s.interner, d.ref);
        if (sel ref_opt.none) {
            str_free(s.build_alloc, head);
            ret res[intern.StrId, outcome.Fail].err{outcome.user("dependency Git ref is not interned")};
        }
        ref = ref_opt.some;
    }
    if (str_starts_with(ref, "commit/")) {
        if (!str_equals((?ref[7])::str, pin)) {
            val mr: res[str, format.FormatError] = format.sprint(s.build_alloc,
                "dependency '{}': exact commit ref '{}' is not satisfied by the realized commit '{}'",
                alias, ref, pin);
            str_free(s.build_alloc, head);
            if (sel mr.err) { ret res[intern.StrId, outcome.Fail].err{outcome.user("dependency commit ref does not match the realized commit")}; }
            ret res[intern.StrId, outcome.Fail].err{outcome.user(mr.ok)};
        }
    }
    or (str_starts_with(ref, "tag/") || str_starts_with(ref, "branch/")) {}
    or {
        str_free(s.build_alloc, head);
        ret res[intern.StrId, outcome.Fail].err{outcome.user("dependency ref kind is invalid")};
    }

    var status_args: [3]str;
    status_args[0] = "status";
    status_args[1] = "--porcelain=v1";
    status_args[2] = "--untracked-files=all";
    val status_r: res[str, outcome.Fail] = git_query_named(s, gi, alias, dep_dir, ?status_args[0], 3, "checkout cleanliness");
    if (sel status_r.err) {
        str_free(s.build_alloc, head);
        ret res[intern.StrId, outcome.Fail].err{status_r.err};
    }
    val status: str = status_r.ok;
    if (!str_empty(status)) {
        val mr: res[str, format.FormatError] = format.sprint(s.build_alloc,
            "dependency '{}': checkout is dirty: {}", alias, status);
        str_free(s.build_alloc, status);
        str_free(s.build_alloc, head);
        if (sel mr.err) { ret res[intern.StrId, outcome.Fail].err{outcome.user("dependency checkout is dirty")}; }
        ret res[intern.StrId, outcome.Fail].err{outcome.user(mr.ok)};
    }
    str_free(s.build_alloc, status);
    val links_r: err[outcome.Fail] = verify_realization_symlinks(s, gi, alias, dep_dir, "", dep_dir);
    if (sel links_r.err) {
        str_free(s.build_alloc, head);
        ret res[intern.StrId, outcome.Fail].err{links_r.err};
    }
    val content_text_r: res[str, format.FormatError] = format.sprint(s.build_alloc, "git/{}", pin);
    str_free(s.build_alloc, head);
    if (sel content_text_r.err) { ret res[intern.StrId, outcome.Fail].err{outcome.user(outcome.format_text(content_text_r.err))}; }
    val content_text: str                        = content_text_r.ok;
    val content_r:    res[intern.StrId, A.Error] = intern.intern(?s.interner, content_text);
    str_free(s.build_alloc, content_text);
    if (sel content_r.err) { ret res[intern.StrId, outcome.Fail].err{outcome.refused(content_r.err)}; }
    ret res[intern.StrId, outcome.Fail].ok{content_r.ok};
}

fun contained_tree_walk(alloc: *A.Allocator, root: str, rel: str) err[outcome.Fail] {
    val at_r: res[str, fail.Fail] = load.join_path(alloc, root, rel);
    if (sel at_r.err) { ret err[outcome.Fail].err{outcome.from_fail(at_r.err)}; }
    val at:      str                          = at_r.ok;
    val names_r: res[Vector[str], fs.FsError] = fs.read_dir(alloc, at);
    str_free(alloc, at);
    if (sel names_r.err) { ret err[outcome.Fail].err{outcome.user(outcome.fs_text(names_r.err))}; }
    var names: Vector[str] = names_r.ok;
    sort.sort[str](names.data, names.len, cmp_dep_name);
    var i: usize = 0;
    for (i < names.len) {
        val child_r: res[str, format.FormatError] = format.sprint(alloc, "{}{}", rel, names.data[i]);
        if (sel child_r.err) {
            free_name_vector(alloc, ?names);
            ret err[outcome.Fail].err{outcome.user(outcome.format_text(child_r.err))};
        }
        val child:  str                 = child_r.ok;
        val full_r: res[str, fail.Fail] = load.join_path(alloc, root, child);
        if (sel full_r.err) {
            str_free(alloc, child);
            free_name_vector(alloc, ?names);
            ret err[outcome.Fail].err{outcome.from_fail(full_r.err)};
        }
        val full:   str                              = full_r.ok;
        val meta_r: res[fs.Metadata, io_error.Error] = fs.metadata_link(full);
        if (sel meta_r.err) {
            str_free(alloc, full);
            str_free(alloc, child);
            free_name_vector(alloc, ?names);
            ret err[outcome.Fail].err{outcome.user(outcome.io_text(meta_r.err))};
        }
        val meta: fs.Metadata = meta_r.ok;
        if (fs.meta_is_symlink(?meta)) {
            str_free(alloc, full);
            str_free(alloc, child);
            free_name_vector(alloc, ?names);
            ret err[outcome.Fail].err{outcome.user("path dependency realization must contain no symlinks")};
        }
        if (fs.meta_is_dir(?meta)) {
            str_free(alloc, full);
            val nested_r: res[str, format.FormatError] = format.sprint(alloc, "{}/", child);
            str_free(alloc, child);
            if (sel nested_r.err) {
                free_name_vector(alloc, ?names);
                ret err[outcome.Fail].err{outcome.user(outcome.format_text(nested_r.err))};
            }
            val nested: str               = nested_r.ok;
            val walk_r: err[outcome.Fail] = contained_tree_walk(alloc, root, nested);
            str_free(alloc, nested);
            if (sel walk_r.err) {
                free_name_vector(alloc, ?names);
                ret walk_r;
            }
        }
        or {
            str_free(alloc, full);
            str_free(alloc, child);
        }
        i = i + 1;
    }
    free_name_vector(alloc, ?names);
    ret err[outcome.Fail].ok{};
}

fun verify_path_checkout_nested(s: *session.Session, alias: str, dep_dir: str) res[intern.StrId, outcome.Fail] {
    val meta_r: res[str, fail.Fail] = load.join_path(s.build_alloc, dep_dir, ".git");
    if (sel meta_r.err) { ret res[intern.StrId, outcome.Fail].err{outcome.from_fail(meta_r.err)}; }
    val meta:     str                       = meta_r.ok;
    val exists_r: res[bool, io_error.Error] = fs.exists(meta);
    val has_meta: bool                      = (sel exists_r.ok && exists_r.ok);
    str_free(s.build_alloc, meta);
    if (has_meta) { ret res[intern.StrId, outcome.Fail].err{outcome.user("path dependency realization contains forbidden repository metadata")}; }
    val walk_r: err[outcome.Fail] = contained_tree_walk(s.build_alloc, dep_dir, "");
    if (sel walk_r.err) { ret res[intern.StrId, outcome.Fail].err{walk_r.err}; }
    val content_text_r: res[str, format.FormatError] = format.sprint(s.build_alloc, "path/{}", alias);
    if (sel content_text_r.err) { ret res[intern.StrId, outcome.Fail].err{outcome.user(outcome.format_text(content_text_r.err))}; }
    val content_text: str                        = content_text_r.ok;
    val content_r:    res[intern.StrId, A.Error] = intern.intern(?s.interner, content_text);
    str_free(s.build_alloc, content_text);
    if (sel content_r.err) { ret res[intern.StrId, outcome.Fail].err{outcome.refused(content_r.err)}; }
    ret res[intern.StrId, outcome.Fail].ok{content_r.ok};
}

fun realized_content(s: *session.Session, gi: *GitInspector, alias: str, parent_root: str,
    dep_dir: str, dir_dep: str, d: *manifest.DepDef) res[intern.StrId, outcome.Fail] {
    if (d.git == intern.STR_NIL) { ret verify_path_checkout_nested(s, alias, dep_dir); }
    val er: err[outcome.Fail] = git_inspector_require(s.build_alloc, gi);
    if (sel er.err) { ret res[intern.StrId, outcome.Fail].err{er.err}; }
    val auth_r: res[u8, outcome.Fail] = project_root_authority(s, gi, alias, parent_root);
    if (sel auth_r.err) { ret res[intern.StrId, outcome.Fail].err{auth_r.err}; }
    val authority: u8 = auth_r.ok;
    ret verify_git_checkout(s, gi, alias, parent_root, dep_dir, dir_dep, d, authority);
}

fun resolve_dep(s: *session.Session, gi: *GitInspector, alias: str, project_root: str,
    dir_dep: str, d: *manifest.DepDef) res[project.DepEntry, outcome.Fail] {
    val dep_dir_r: res[str, outcome.Fail] = build_dep_root(s.build_alloc, project_root, dir_dep, alias);
    if (sel dep_dir_r.err) { ret res[project.DepEntry, outcome.Fail].err{dep_dir_r.err}; }
    val dep_dir: str = dep_dir_r.ok;

    val exists_r: res[bool, io_error.Error] = fs.exists(dep_dir);
    if (sel exists_r.err) {
        val msg: str = diag_dep_manifest_error(s, alias, dep_dir, project_root, "dependency directory is missing");
        str_free(s.build_alloc, dep_dir);
        ret res[project.DepEntry, outcome.Fail].err{outcome.user(msg)};
    }
    if (!(exists_r.ok)) {
        val msg: str = diag_dep_manifest_error(s, alias, dep_dir, project_root, "dependency directory is missing");
        str_free(s.build_alloc, dep_dir);
        ret res[project.DepEntry, outcome.Fail].err{outcome.user(msg)};
    }
    val is_symlink_r: res[bool, io_error.Error] = fs.is_symlink(dep_dir);
    val is_dir_r:     res[bool, io_error.Error] = fs.is_dir(dep_dir);
    if ((sel is_symlink_r.ok && is_symlink_r.ok) || !(sel is_dir_r.ok && is_dir_r.ok)) {
        str_free(s.build_alloc, dep_dir);
        ret res[project.DepEntry, outcome.Fail].err{outcome.user("dependency realization must be a physical directory, not a symlink or other entry")};
    }

    val content_r: res[intern.StrId, outcome.Fail] = realized_content(s, gi, alias, project_root, dep_dir, dir_dep, d);
    if (sel content_r.err) {
        str_free(s.build_alloc, dep_dir);
        ret res[project.DepEntry, outcome.Fail].err{content_r.err};
    }

    val toml_path_r: res[str, fail.Fail] = load.join_path(s.build_alloc, dep_dir, manifest.MANIFEST_FILE);
    if (sel toml_path_r.err) {
        str_free(s.build_alloc, dep_dir);
        ret res[project.DepEntry, outcome.Fail].err{outcome.from_fail(toml_path_r.err)};
    }
    val toml_path: str = toml_path_r.ok;

    val tr: res[toml.Table, outcome.Fail] = parse_toml_file(s.build_alloc, toml_path);
    str_free(s.build_alloc, toml_path);
    if (sel tr.err) {
        val msg: str = diag_dep_manifest_error(s, alias, dep_dir, project_root, outcome.describe(tr.err));
        str_free(s.build_alloc, dep_dir);
        ret res[project.DepEntry, outcome.Fail].err{outcome.user(msg)};
    }
    var t: toml.Table = tr.ok;

    val mr: res[manifest.Manifest, outcome.Fail] = manifest.parse(s.build_alloc, ?s.interner, ?t, false);
    toml.dnit(s.build_alloc, ?t);
    if (sel mr.err) {
        val msg_r: res[str, format.FormatError] = format.sprint(s.build_alloc, "dep '{}': {}", alias,
            outcome.describe(mr.err));
        str_free(s.build_alloc, dep_dir);
        if (sel msg_r.err) { ret res[project.DepEntry, outcome.Fail].err{mr.err}; }
        ret res[project.DepEntry, outcome.Fail].err{outcome.user(msg_r.ok)};
    }
    var parsed: manifest.Manifest = mr.ok;

    val declared_opt: opt[str] = intern.lookup(?s.interner, parsed.id);
    if (sel declared_opt.none) {
        str_free(s.build_alloc, dep_dir);
        manifest.dnit(?parsed, s.build_alloc);
        ret res[project.DepEntry, outcome.Fail].err{outcome.user("dependency manifest declares no readable project id")};
    }
    val identity: err[outcome.Fail] = check_dep_identity(s, alias, declared_opt.some);
    if (sel identity.err) {
        str_free(s.build_alloc, dep_dir);
        manifest.dnit(?parsed, s.build_alloc);
        ret res[project.DepEntry, outcome.Fail].err{identity.err};
    }
    val nested: err[outcome.Fail] = refuse_nested_realization(s, alias, dep_dir);
    if (sel nested.err) {
        str_free(s.build_alloc, dep_dir);
        manifest.dnit(?parsed, s.build_alloc);
        ret res[project.DepEntry, outcome.Fail].err{nested.err};
    }

    var entry: project.DepEntry;
    entry.direct          = nil;
    entry.direct_count    = 0;
    entry.chain           = intern.STR_NIL;
    entry.manifest        = parsed;
    entry.project_id      = parsed.id;
    entry.project_dir_src = parsed.src;
    entry.ref             = d.ref;
    entry.content         = content_r.ok;

    val ra: res[intern.StrId, A.Error] = intern.intern(?s.interner, alias);
    if (sel ra.err) {
        str_free(s.build_alloc, dep_dir);
        manifest.dnit(?entry.manifest, s.build_alloc);
        ret res[project.DepEntry, outcome.Fail].err{outcome.refused(ra.err)};
    }
    entry.alias = ra.ok;

    val source_r: res[intern.StrId, outcome.Fail] = dep_source_label(s, d);
    if (sel source_r.err) {
        str_free(s.build_alloc, dep_dir);
        manifest.dnit(?entry.manifest, s.build_alloc);
        ret res[project.DepEntry, outcome.Fail].err{source_r.err};
    }
    entry.source = source_r.ok;

    # the public entry is only ever an explicitly defaulted library artifact's
    entry.project_module = manifest.canonical_module(?parsed);

    val dep_src_opt: opt[str] = intern.lookup(?s.interner, entry.project_dir_src);
    if (sel dep_src_opt.none) {
        str_free(s.build_alloc, dep_dir);
        manifest.dnit(?entry.manifest, s.build_alloc);
        ret res[project.DepEntry, outcome.Fail].err{outcome.user("dependency source directory is not interned")};
    }
    val dep_src_text: str = dep_src_opt.some;
    if (entry.project_module != intern.STR_NIL) {
        val entry_opt: opt[str] = intern.lookup(?s.interner, entry.project_module);
        if (sel entry_opt.none) {
            str_free(s.build_alloc, dep_dir);
            manifest.dnit(?entry.manifest, s.build_alloc);
            ret res[project.DepEntry, outcome.Fail].err{outcome.user("dependency canonical module is not interned")};
        }
        val dep_entry_file: str                     = entry_opt.some;
        val present_r:      res[bool, outcome.Fail] = module_file_present(s.build_alloc, dep_dir, dep_src_text, dep_entry_file);
        if (sel present_r.err) {
            str_free(s.build_alloc, dep_dir);
            manifest.dnit(?entry.manifest, s.build_alloc);
            ret res[project.DepEntry, outcome.Fail].err{present_r.err};
        }
        if (!present_r.ok) {
            val msg: str = load.diag_join_named(s, "dep '", entry.alias, "' mach.toml: public entry names no file", "dep mach.toml: public entry names no file");
            str_free(s.build_alloc, dep_dir);
            manifest.dnit(?entry.manifest, s.build_alloc);
            ret res[project.DepEntry, outcome.Fail].err{outcome.user(msg)};
        }
    }

    val rvr: res[intern.StrId, A.Error] = intern.intern(?s.interner, dep_dir);
    if (sel rvr.err) {
        str_free(s.build_alloc, dep_dir);
        manifest.dnit(?entry.manifest, s.build_alloc);
        ret res[project.DepEntry, outcome.Fail].err{outcome.refused(rvr.err)};
    }
    entry.vendor_root = rvr.ok;

    str_free(s.build_alloc, dep_dir);
    ret res[project.DepEntry, outcome.Fail].ok{entry};
}

fun build_dep_root(alloc: *A.Allocator, project_root: str, dir_dep: str, alias: str) res[str, outcome.Fail] {
    val a: res[str, fail.Fail] = load.join_path(alloc, project_root, dir_dep);
    if (sel a.err) { ret res[str, outcome.Fail].err{outcome.from_fail(a.err)}; }
    val mid: str                 = a.ok;
    val b:   res[str, fail.Fail] = load.join_path(alloc, mid, alias);
    str_free(alloc, mid);
    if (sel b.err) { ret res[str, outcome.Fail].err{outcome.from_fail(b.err)}; }
    ret res[str, outcome.Fail].ok{b.ok};
}

pub fun parse_toml_file(alloc: *A.Allocator, path: str) res[toml.Table, outcome.Fail] {
    val rb: res[Vector[u8], fs.FsError] = fs.read_bytes(alloc, path);
    if (sel rb.err) {
        val res_msg: res[str, format.FormatError] = format.sprint(alloc, "cannot read '{}': {}", path, outcome.fs_text(rb.err));
        if (sel res_msg.err) { ret res[toml.Table, outcome.Fail].err{outcome.user(outcome.fs_text(rb.err))}; }
        ret res[toml.Table, outcome.Fail].err{outcome.user(res_msg.ok)};
    }
    var src:      Vector[u8]        = rb.ok;
    val source_r: err[outcome.Fail] = manifest.validate_source_bytes(src.data, src.len);
    if (sel source_r.err) {
        vector.dnit[u8](?src);
        ret res[toml.Table, outcome.Fail].err{source_r.err};
    }
    val reserve_r: res[usize, A.Error] = vector.reserve[u8](?src, 1);
    if (sel reserve_r.err) {
        vector.dnit[u8](?src);
        ret res[toml.Table, outcome.Fail].err{outcome.refused(reserve_r.err)};
    }
    src.data[src.len] = 0;
    val rt: res[toml.Table, toml.TomlError] = toml.parse(alloc, src.data::str);
    vector.dnit[u8](?src);
    if (sel rt.err) { ret res[toml.Table, outcome.Fail].err{outcome.user(outcome.toml_text(rt.err))}; }
    ret res[toml.Table, outcome.Fail].ok{rt.ok};
}

pub fun cell_tmpl_vars(p: *project.Project) manifest.TmplVars {
    var v: manifest.TmplVars;
    v.target  = project.fqn_name(p, p.target_entry.name);
    v.isa     = project.fqn_name(p, p.target_entry.isa_name);
    v.os      = project.fqn_name(p, p.target_entry.os_name);
    v.abi     = project.fqn_name(p, p.target_entry.abi_name);
    v.profile = project.fqn_name(p, p.config.profile);
    v.format  = "";
    val format: opt[str] = intern.lookup(?p.s.interner, p.target_entry.of_name);
    if (sel format.some) { v.format = format.some; }
    v.artifact_suffix = nil;
    v.reqs            = p.config.art_reqs;
    v.req_count       = p.config.art_req_count;
    ret v;
}

# `cell_tmpl_vars` whose `{artifact.<id>.out}` resolves in the requirement scope
# of the project `owner` names, empty when the cell binds no scope for it
pub fun owner_tmpl_vars(p: *project.Project, owner: str) manifest.TmplVars {
    var v: manifest.TmplVars = cell_tmpl_vars(p);
    v.reqs      = nil;
    v.req_count = 0;
    var i: u32 = 0;
    for (i < p.config.req_scope_count) {
        if (str_equals(id_text_or(p.s, p.config.req_scopes[i].owner, ""), owner)) {
            v.reqs      = p.config.req_scopes[i].reqs;
            v.req_count = p.config.req_scopes[i].req_count;
        }
        i = i + 1;
    }
    ret v;
}

val REALIZE_DEP_DIR: str = "dep";

fun git_is_work_tree(alloc: *A.Allocator, gi: *GitInspector, dir: str) bool {
    var args: [2]str;
    args[0] = "rev-parse";
    args[1] = "--is-inside-work-tree";
    val r: res[str, outcome.Fail] = git_query(alloc, gi, dir, ?args[0], 2);
    if (sel r.err) { ret false; }
    val v:  str  = r.ok;
    val ok: bool = str_equals(v, "true");
    str_free(alloc, v);
    ret ok;
}

pub fun initialize_repository(s: *session.Session, root: str) err[outcome.Fail] {
    var gi:       GitInspector;
    val required: err[outcome.Fail] = git_inspector_require(s.build_alloc, ?gi);
    if (sel required.err) { ret err[outcome.Fail].err{required.err}; }
    fin { git_inspector_dnit(s.build_alloc, ?gi); }
    if (git_is_work_tree(s.build_alloc, ?gi, root)) { ret err[outcome.Fail].ok{}; }
    var args:        [1]str                 = [1]str{"init"};
    val initialized: res[str, outcome.Fail] = git_op(s.build_alloc, ?gi, root, ?args[0], 1, nil);
    if (sel initialized.err) { ret err[outcome.Fail].err{initialized.err}; }
    str_free(s.build_alloc, initialized.ok);
    ret err[outcome.Fail].ok{};
}

fun realize_checkout_target(alloc: *A.Allocator, ref: str) res[str, outcome.Fail] {
    if (str_starts_with(ref, "branch/")) {
        val name: str = (?ref[7])::str;
        if (str_empty(name)) { ret res[str, outcome.Fail].err{outcome.user("empty branch selector")}; }
        val sprint_r: res[str, format.FormatError] = format.sprint(alloc, "origin/{}", name);
        if (sel sprint_r.err) { ret res[str, outcome.Fail].err{outcome.user(outcome.format_text(sprint_r.err))}; }
        ret res[str, outcome.Fail].ok{sprint_r.ok};
    }
    if (str_starts_with(ref, "tag/")) {
        val name: str = (?ref[4])::str;
        if (str_empty(name)) { ret res[str, outcome.Fail].err{outcome.user("empty tag selector")}; }
        val sprint_r2: res[str, format.FormatError] = format.sprint(alloc, "refs/tags/{}", name);
        if (sel sprint_r2.err) { ret res[str, outcome.Fail].err{outcome.user(outcome.format_text(sprint_r2.err))}; }
        ret res[str, outcome.Fail].ok{sprint_r2.ok};
    }
    if (str_starts_with(ref, "commit/")) {
        val name: str = (?ref[7])::str;
        if (str_empty(name)) { ret res[str, outcome.Fail].err{outcome.user("empty commit selector")}; }
        val str_copy_slice_r: res[str, string.StrError] = str_copy_slice(alloc, name, 0, str_len(name));
        if (sel str_copy_slice_r.err) { ret res[str, outcome.Fail].err{outcome.user(outcome.str_text(str_copy_slice_r.err))}; }
        ret res[str, outcome.Fail].ok{str_copy_slice_r.ok};
    }
    ret res[str, outcome.Fail].err{outcome.user("dependency ref must be 'branch/<name>', 'tag/<name>', or 'commit/<id>'")};
}

fun realize_selector_ref(alloc: *A.Allocator, gi: *GitInspector, dep_dir: str, ref: str, extra_env: **u8) err[outcome.Fail] {
    val target_r: res[str, outcome.Fail] = realize_checkout_target(alloc, ref);
    if (sel target_r.err) { ret err[outcome.Fail].err{target_r.err}; }
    val target: str                    = target_r.ok;
    var args:   [3]str                 = [3]str{"checkout", "--detach", target};
    val r:      res[str, outcome.Fail] = git_op(alloc, gi, dep_dir, ?args[0], 3, extra_env);
    str_free(alloc, target);
    if (sel r.err) { ret err[outcome.Fail].err{r.err}; }
    str_free(alloc, r.ok);
    ret err[outcome.Fail].ok{};
}

# the manifest key, the directory under dep/ and the project id are one name
pub fun check_dep_identity(s: *session.Session, key: str, declared: str) err[outcome.Fail] {
    if (str_equals(key, declared)) { ret err[outcome.Fail].ok{}; }
    val msg_r: res[str, format.FormatError] = format.sprint(s.build_alloc,
        "[dep.{}] realizes project '{}': the manifest key, the directory under dep/, and the project id are one name, so rename the table to [dep.{}] and the directory to dep/{}",
        key, declared, declared, declared);
    if (sel msg_r.err) { ret err[outcome.Fail].err{outcome.user("dependency manifest id does not match its declared identity")}; }
    ret err[outcome.Fail].err{outcome.user(msg_r.ok)};
}

# a realized nested dependency (`dep/<id>/dep/<x>/mach.toml`) is refused: the
# root owns the flat closure and a dependency's own dep/ is never realized.
# an empty directory git materializes for a consumed dependency's gitlink is not
# a realization and passes
pub fun refuse_nested_realization(s: *session.Session, alias: str, dep_dir: str) err[outcome.Fail] {
    val nested_r: res[str, fail.Fail] = load.join_path(s.build_alloc, dep_dir, REALIZE_DEP_DIR);
    if (sel nested_r.err) { ret err[outcome.Fail].err{outcome.from_fail(nested_r.err)}; }
    val nested: str = nested_r.ok;
    fin { str_free(s.build_alloc, nested); }
    val is_dir_r: res[bool, io_error.Error] = fs.is_dir(nested);
    if (!(sel is_dir_r.ok && is_dir_r.ok)) { ret err[outcome.Fail].ok{}; }
    val names_r: res[Vector[str], fs.FsError] = fs.read_dir(s.build_alloc, nested);
    if (sel names_r.err) { ret err[outcome.Fail].err{outcome.user(outcome.fs_text(names_r.err))}; }
    var names: Vector[str] = names_r.ok;
    fin { free_name_vector(s.build_alloc, ?names); }
    var i: usize = 0;
    for (i < names.len) {
        val child_r: res[str, fail.Fail] = load.join_path(s.build_alloc, nested, names.data[i]);
        if (sel child_r.err) { ret err[outcome.Fail].err{outcome.from_fail(child_r.err)}; }
        val child: str                 = child_r.ok;
        val mf_r:  res[str, fail.Fail] = load.join_path(s.build_alloc, child, manifest.MANIFEST_FILE);
        str_free(s.build_alloc, child);
        if (sel mf_r.err) { ret err[outcome.Fail].err{outcome.from_fail(mf_r.err)}; }
        val mf:       str                       = mf_r.ok;
        val exists_r: res[bool, io_error.Error] = fs.exists(mf);
        str_free(s.build_alloc, mf);
        if (sel exists_r.ok && exists_r.ok) {
            val msg_r: res[str, format.FormatError] = format.sprint(s.build_alloc,
                "dependency '{}': {}/{}/{}/{} is a nested realization: the root's dep/ owns the flat closure and a dependency's own dep/ is never realized, so delete {}/{}/{}",
                alias, REALIZE_DEP_DIR, alias, REALIZE_DEP_DIR, names.data[i], REALIZE_DEP_DIR, alias, REALIZE_DEP_DIR);
            if (sel msg_r.err) { ret err[outcome.Fail].err{outcome.user("nested dependency realization is refused")}; }
            ret err[outcome.Fail].err{outcome.user(msg_r.ok)};
        }
        i = i + 1;
    }
    ret err[outcome.Fail].ok{};
}

pub fun declared_dep_id(s: *session.Session, dep_full: str) res[str, outcome.Fail] {
    val toml_path_r: res[str, fail.Fail] = load.join_path(s.build_alloc, dep_full, manifest.MANIFEST_FILE);
    if (sel toml_path_r.err) { ret res[str, outcome.Fail].err{outcome.from_fail(toml_path_r.err)}; }
    val toml_path: str                           = toml_path_r.ok;
    val tr:        res[toml.Table, outcome.Fail] = parse_toml_file(s.build_alloc, toml_path);
    str_free(s.build_alloc, toml_path);
    if (sel tr.err) { ret res[str, outcome.Fail].err{tr.err}; }
    var t:  toml.Table                           = tr.ok;
    val mr: res[manifest.Manifest, outcome.Fail] = manifest.parse(s.build_alloc, ?s.interner, ?t, false);
    toml.dnit(s.build_alloc, ?t);
    if (sel mr.err) { ret res[str, outcome.Fail].err{mr.err}; }
    var parsed: manifest.Manifest = mr.ok;
    val id_opt: opt[str]          = intern.lookup(?s.interner, parsed.id);
    if (sel id_opt.none) {
        manifest.dnit(?parsed, s.build_alloc);
        ret res[str, outcome.Fail].err{outcome.user("dependency manifest declares no readable project id")};
    }
    val copy_r: res[str, string.StrError] = str_copy_slice(s.build_alloc, id_opt.some, 0, str_len(id_opt.some));
    manifest.dnit(?parsed, s.build_alloc);
    if (sel copy_r.err) { ret res[str, outcome.Fail].err{outcome.user(outcome.str_text(copy_r.err))}; }
    ret res[str, outcome.Fail].ok{copy_r.ok};
}

pub fun verify_dep_manifest_id(s: *session.Session, dep_full: str, id: str) err[outcome.Fail] {
    val toml_path_r: res[str, fail.Fail] = load.join_path(s.build_alloc, dep_full, manifest.MANIFEST_FILE);
    if (sel toml_path_r.err) { ret err[outcome.Fail].err{outcome.from_fail(toml_path_r.err)}; }
    val toml_path: str                           = toml_path_r.ok;
    val tr:        res[toml.Table, outcome.Fail] = parse_toml_file(s.build_alloc, toml_path);
    str_free(s.build_alloc, toml_path);
    if (sel tr.err) { ret err[outcome.Fail].err{tr.err}; }
    var t:  toml.Table                           = tr.ok;
    val mr: res[manifest.Manifest, outcome.Fail] = manifest.parse(s.build_alloc, ?s.interner, ?t, false);
    toml.dnit(s.build_alloc, ?t);
    if (sel mr.err) { ret err[outcome.Fail].err{mr.err}; }
    var parsed: manifest.Manifest = mr.ok;
    val id_opt: opt[str]          = intern.lookup(?s.interner, parsed.id);
    if (sel id_opt.none) {
        manifest.dnit(?parsed, s.build_alloc);
        ret err[outcome.Fail].err{outcome.user("dependency manifest declares no readable project id")};
    }
    val declared: str               = id_opt.some;
    val check:    err[outcome.Fail] = check_dep_identity(s, id, declared);
    manifest.dnit(?parsed, s.build_alloc);
    ret check;
}

# add dep/<id> as a submodule at the declared selector, refreshing a reused store or checkout from the declared source
fun add_git_submodule(s: *session.Session, gi: *GitInspector, root: str, id: str, rel: str, dep_full: str,
    url: str, ref: str, reuse_store: bool, refresh: bool, extra_env: **u8) err[outcome.Fail] {
    if (!git_is_work_tree(s.build_alloc, gi, root)) {
        ret err[outcome.Fail].err{outcome.user("dependency registration requires an existing Git repository; create it explicitly with mach init or git init")};
    }
    val metadata: err[outcome.Fail] = require_matches_index(s, gi, id, root, ".gitmodules", "dependency metadata before registration");
    if (sel metadata.err) { ret metadata; }

    var add_args: [5]str = [5]str{"submodule", "add", url, rel, ""};
    var add_n:    usize  = 4;
    if (reuse_store) {
        add_args = [5]str{"submodule", "add", "--force", url, rel};
        add_n    = 5;
    }
    val add_r: res[str, outcome.Fail] = git_op(s.build_alloc, gi, root, ?add_args[0], add_n, extra_env);
    if (sel add_r.err) {
        print.eprintlnf("note: git submodule add dep/{} failed; inspect native Git state before retrying", id);
        ret err[outcome.Fail].err{add_r.err};
    }
    str_free(s.build_alloc, add_r.ok);

    if (refresh) {
        var sync_args: [4]str                 = [4]str{"submodule", "sync", "--", rel};
        val sync_r:    res[str, outcome.Fail] = git_op(s.build_alloc, gi, root, ?sync_args[0], 4, extra_env);
        if (sel sync_r.err) {
            print.eprintlnf("note: dep/{} was registered; pointing it at the declared source failed; checkout and Git changes retained", id);
            ret err[outcome.Fail].err{sync_r.err};
        }
        str_free(s.build_alloc, sync_r.ok);
        var fetch_args: [4]str                 = [4]str{"fetch", "--tags", "origin", "+refs/heads/*:refs/remotes/origin/*"};
        val fetch_r:    res[str, outcome.Fail] = git_op(s.build_alloc, gi, dep_full, ?fetch_args[0], 4, extra_env);
        if (sel fetch_r.err) {
            print.eprintlnf("note: dep/{} was registered; fetching the declared source failed; checkout and Git changes retained", id);
            ret err[outcome.Fail].err{fetch_r.err};
        }
        str_free(s.build_alloc, fetch_r.ok);
    }

    val sel_r: err[outcome.Fail] = realize_selector_ref(s.build_alloc, gi, dep_full, ref, extra_env);
    if (sel sel_r.err) {
        print.eprintlnf("note: dep/{} was registered; selector checkout failed; checkout and Git changes retained", id);
        val msg_r: res[str, format.FormatError] = format.sprint(s.build_alloc, "checkout of '{}': {}", ref, outcome.describe(sel_r.err));
        if (sel msg_r.err) { ret err[outcome.Fail].err{outcome.user("dependency checkout failed")}; }
        ret err[outcome.Fail].err{outcome.user(msg_r.ok)};
    }

    val id_r: err[outcome.Fail] = verify_dep_manifest_id(s, dep_full, id);
    if (sel id_r.err) {
        print.eprintlnf("note: dep/{} was registered and checked out; manifest validation failed; checkout and Git changes retained", id);
        ret id_r;
    }

    var stage_args: [3]str                 = [3]str{"add", "--", rel};
    val stage_r:    res[str, outcome.Fail] = git_op(s.build_alloc, gi, root, ?stage_args[0], 3, extra_env);
    if (sel stage_r.err) {
        print.eprintlnf("note: dep/{} was registered and checked out; staging its selected gitlink failed; native state retained", id);
        val msg_r: res[str, format.FormatError] = format.sprint(s.build_alloc, "staging dependency gitlink: {}", outcome.describe(stage_r.err));
        if (sel msg_r.err) { ret err[outcome.Fail].err{outcome.user("staging dependency gitlink failed")}; }
        ret err[outcome.Fail].err{outcome.user(msg_r.ok)};
    }
    str_free(s.build_alloc, stage_r.ok);
    ret err[outcome.Fail].ok{};
}

# record a gitlink the index already holds in .gitmodules from the manifest's source;
# `top` is the repository's top level and `rel` the gitlink's path from there
fun register_gitlink(s: *session.Session, gi: *GitInspector, root: str, id: str, rel: str, url: str,
    extra_env: **u8) err[outcome.Fail] {
    val metadata: err[outcome.Fail] = require_matches_index(s, gi, id, root, ".gitmodules", "dependency metadata before registration");
    if (sel metadata.err) { ret metadata; }
    val path_key_r: res[str, format.FormatError] = format.sprint(s.build_alloc, "submodule.{}.path", rel);
    if (sel path_key_r.err) { ret err[outcome.Fail].err{outcome.user(outcome.format_text(path_key_r.err))}; }
    fin { str_free(s.build_alloc, path_key_r.ok); }
    val url_key_r: res[str, format.FormatError] = format.sprint(s.build_alloc, "submodule.{}.url", rel);
    if (sel url_key_r.err) { ret err[outcome.Fail].err{outcome.user(outcome.format_text(url_key_r.err))}; }
    fin { str_free(s.build_alloc, url_key_r.ok); }

    var path_args: [5]str                 = [5]str{"config", "-f", ".gitmodules", path_key_r.ok, rel};
    val path_r:    res[str, outcome.Fail] = git_op(s.build_alloc, gi, root, ?path_args[0], 5, extra_env);
    if (sel path_r.err) { ret err[outcome.Fail].err{path_r.err}; }
    str_free(s.build_alloc, path_r.ok);
    var url_args: [5]str                 = [5]str{"config", "-f", ".gitmodules", url_key_r.ok, url};
    val url_r:    res[str, outcome.Fail] = git_op(s.build_alloc, gi, root, ?url_args[0], 5, extra_env);
    if (sel url_r.err) {
        print.eprintlnf("note: .gitmodules names dep/{} without its URL; inspect native Git state before retrying", id);
        ret err[outcome.Fail].err{url_r.err};
    }
    str_free(s.build_alloc, url_r.ok);
    var stage_args: [3]str                 = [3]str{"add", "--", ".gitmodules"};
    val stage_r:    res[str, outcome.Fail] = git_op(s.build_alloc, gi, root, ?stage_args[0], 3, extra_env);
    if (sel stage_r.err) {
        print.eprintlnf("note: .gitmodules registers dep/{}; staging it failed; native state retained", id);
        ret err[outcome.Fail].err{stage_r.err};
    }
    str_free(s.build_alloc, stage_r.ok);
    ret err[outcome.Fail].ok{};
}

pub val REALIZE_REPO_ROOT: u8 = 0;
pub val REALIZE_NESTED:    u8 = 1;

pub fun realization_mode(s: *session.Session, root: str) res[u8, outcome.Fail] {
    var gi: GitInspector          = GitInspector{program: nil};
    val r:  res[u8, outcome.Fail] = project_root_authority(s, ?gi, "project", root);
    git_inspector_dnit(s.build_alloc, ?gi);
    if (sel r.err)                  { ret res[u8, outcome.Fail].err{r.err}; }
    if (r.ok == DEP_AUTHORITY_REPO) { ret res[u8, outcome.Fail].ok{REALIZE_REPO_ROOT}; }
    ret res[u8, outcome.Fail].ok{REALIZE_NESTED};
}

pub fun dep_rel_of(alloc: *A.Allocator, id: str) res[str, outcome.Fail] {
    val sprint_r: res[str, format.FormatError] = format.sprint(alloc, "{}/{}", REALIZE_DEP_DIR, id);
    if (sel sprint_r.err) { ret res[str, outcome.Fail].err{outcome.user(outcome.format_text(sprint_r.err))}; }
    ret res[str, outcome.Fail].ok{sprint_r.ok};
}

pub fun dep_full_of(alloc: *A.Allocator, root: str, id: str) res[str, outcome.Fail] {
    val rel_r: res[str, outcome.Fail] = dep_rel_of(alloc, id);
    if (sel rel_r.err) { ret res[str, outcome.Fail].err{rel_r.err}; }
    val rel:    str                 = rel_r.ok;
    val full_r: res[str, fail.Fail] = load.join_path(alloc, root, rel);
    str_free(alloc, rel);
    if (sel full_r.err) { ret res[str, outcome.Fail].err{outcome.from_fail(full_r.err)}; }
    ret res[str, outcome.Fail].ok{full_r.ok};
}

fun parse_staged_gitlink(alloc: *A.Allocator, bytes: *GitBytes, rel: str) res[opt[str], outcome.Fail] {
    var selected:     usize = 0;
    var selected_len: usize = 0;
    var start:        usize = 0;
    for (start < bytes.len) {
        var end: usize = start;
        for (end < bytes.len && bytes.data[end] != 0) { end = end + 1; }
        if (end == bytes.len) { ret res[opt[str], outcome.Fail].err{outcome.user("Git index record is not nul terminated")}; }
        var mode_end: usize = start;
        for (mode_end < end && bytes.data[mode_end] != ' ') { mode_end = mode_end + 1; }
        var oid_end: usize = mode_end + 1;
        for (oid_end < end && bytes.data[oid_end] != ' ') { oid_end = oid_end + 1; }
        if (mode_end == start || oid_end <= mode_end + 1 || oid_end + 3 > end ||
            bytes.data[oid_end + 1] < '0' || bytes.data[oid_end + 1] > '3' || bytes.data[oid_end + 2] != '\t') {
            ret res[opt[str], outcome.Fail].err{outcome.user("Git index record has invalid mode, object, or stage fields")};
        }
        val name: str = (?bytes.data[oid_end + 3])::str;
        if (str_equals(name, rel)) {
            if (bytes.data[oid_end + 1] != '0') { ret res[opt[str], outcome.Fail].err{outcome.user("dependency index entry has unresolved conflict stages")}; }
            var i: usize = mode_end + 1;
            for (i < oid_end) {
                val c: u8 = bytes.data[i];
                if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) {
                    ret res[opt[str], outcome.Fail].err{outcome.user("Git index object id is not hexadecimal")};
                }
                i = i + 1;
            }
            if (mode_end - start == 6 && bytes.data[start] == '1' && bytes.data[start + 1] == '6' &&
                bytes.data[start + 2] == '0' && bytes.data[start + 3] == '0' && bytes.data[start + 4] == '0' && bytes.data[start + 5] == '0') {
                if (selected_len != 0) { ret res[opt[str], outcome.Fail].err{outcome.user("Git index contains duplicate dependency entries")}; }
                selected     = mode_end + 1;
                selected_len = oid_end - selected;
            }
        }
        start = end + 1;
    }
    if (selected_len == 0) { ret res[opt[str], outcome.Fail].ok{opt[str].none{}}; }
    val copied: res[str, string.StrError] = str_copy_slice(alloc, (?bytes.data[selected])::str, 0, selected_len);
    if (sel copied.err) { ret res[opt[str], outcome.Fail].err{outcome.user(outcome.str_text(copied.err))}; }
    ret res[opt[str], outcome.Fail].ok{opt[str].some{copied.ok}};
}

pub fun staged_gitlink(s: *session.Session, root: str, id: str) res[opt[str], outcome.Fail] {
    var gi: GitInspector      = GitInspector{program: nil};
    val er: err[outcome.Fail] = git_inspector_require(s.build_alloc, ?gi);
    if (sel er.err) { ret res[opt[str], outcome.Fail].err{er.err}; }
    fin { git_inspector_dnit(s.build_alloc, ?gi); }
    val rel_r: res[str, outcome.Fail] = dep_rel_of(s.build_alloc, id);
    if (sel rel_r.err) { ret res[opt[str], outcome.Fail].err{rel_r.err}; }
    val rel: str = rel_r.ok;
    fin { str_free(s.build_alloc, rel); }
    var args: [5]str                      = [5]str{"ls-files", "--stage", "-z", "--", rel};
    val q:    res[GitBytes, outcome.Fail] = git_query_capture(s.build_alloc, ?gi, root, ?args[0], 5, false, nil, os.INVALID_HANDLE, false);
    if (sel q.err) { ret res[opt[str], outcome.Fail].err{q.err}; }
    var bytes: GitBytes = q.ok;
    fin { git_bytes_free(s.build_alloc, ?bytes); }
    ret parse_staged_gitlink(s.build_alloc, ?bytes, rel);
}

pub fun staged_paths(s: *session.Session, root: str, rel: str) res[str, outcome.Fail] {
    var gi: GitInspector      = GitInspector{program: nil};
    val er: err[outcome.Fail] = git_inspector_require(s.build_alloc, ?gi);
    if (sel er.err) { ret res[str, outcome.Fail].err{er.err}; }
    var args: [4]str;
    args[0] = "ls-files";
    args[1] = "--stage";
    args[2] = "--";
    args[3] = rel;
    val q: res[str, outcome.Fail] = git_query_raw(s.build_alloc, ?gi, root, ?args[0], 4);
    git_inspector_dnit(s.build_alloc, ?gi);
    ret q;
}

pub fun own_work_tree(alloc: *A.Allocator, dep_full: str) bool {
    val marker_r: res[str, fail.Fail] = load.join_path(alloc, dep_full, ".git");
    if (sel marker_r.err) { ret false; }
    val marker:   str                       = marker_r.ok;
    val exists_r: res[bool, io_error.Error] = fs.exists(marker);
    val present:  bool                      = (sel exists_r.ok && exists_r.ok);
    str_free(alloc, marker);
    ret present;
}

fun require_own_work_tree(s: *session.Session, dep_full: str) err[outcome.Fail] {
    if (own_work_tree(s.build_alloc, dep_full)) { ret err[outcome.Fail].ok{}; }
    val msg_r: res[str, format.FormatError] = format.sprint(s.build_alloc,
        "dependency at '{}' is an uninitialized gitlink, not a checkout of its own; run `mach dep pull <path>` on its owning project to realize it", dep_full);
    if (sel msg_r.err) { ret err[outcome.Fail].err{outcome.user("dependency path is an uninitialized gitlink, not a checkout")}; }
    ret err[outcome.Fail].err{outcome.user(msg_r.ok)};
}

pub fun checkout_commit(s: *session.Session, dep_full: str, commit: str) err[outcome.Fail] {
    val own: err[outcome.Fail] = require_own_work_tree(s, dep_full);
    if (sel own.err) { ret err[outcome.Fail].err{own.err}; }
    var gi: GitInspector      = GitInspector{program: nil};
    val er: err[outcome.Fail] = git_inspector_require(s.build_alloc, ?gi);
    if (sel er.err) { ret err[outcome.Fail].err{er.err}; }
    var args: [3]str;
    args[0] = "checkout";
    args[1] = "--detach";
    args[2] = commit;
    val r: res[str, outcome.Fail] = git_op(s.build_alloc, ?gi, dep_full, ?args[0], 3, nil);
    git_inspector_dnit(s.build_alloc, ?gi);
    if (sel r.err) { ret err[outcome.Fail].err{r.err}; }
    str_free(s.build_alloc, r.ok);
    ret err[outcome.Fail].ok{};
}

pub fun checkout_head(s: *session.Session, dep_full: str) res[str, outcome.Fail] {
    val own: err[outcome.Fail] = require_own_work_tree(s, dep_full);
    if (sel own.err) { ret res[str, outcome.Fail].err{own.err}; }
    var gi: GitInspector      = GitInspector{program: nil};
    val er: err[outcome.Fail] = git_inspector_require(s.build_alloc, ?gi);
    if (sel er.err) { ret res[str, outcome.Fail].err{er.err}; }
    var args: [2]str;
    args[0] = "rev-parse";
    args[1] = "HEAD";
    val r: res[str, outcome.Fail] = git_query(s.build_alloc, ?gi, dep_full, ?args[0], 2);
    git_inspector_dnit(s.build_alloc, ?gi);
    ret r;
}

# the release version a checkout's HEAD is tagged with ("" when no `v`-prefixed semver tag
# points at it); the highest wins when several do
pub fun release_at_head(s: *session.Session, dep_full: str) res[str, outcome.Fail] {
    val own: err[outcome.Fail] = require_own_work_tree(s, dep_full);
    if (sel own.err) { ret res[str, outcome.Fail].err{own.err}; }
    var gi: GitInspector = GitInspector{program: nil};
    fin { git_inspector_dnit(s.build_alloc, ?gi); }
    ret release_at(s.build_alloc, ?gi, dep_full, "HEAD");
}

# the release version the commit `rev` of the repository at `dir` is tagged with, read from
# its local refs ("" when no `v`-prefixed semver tag points at it); the highest wins
fun release_at(a: *A.Allocator, gi: *GitInspector, dir: str, rev: str) res[str, outcome.Fail] {
    val er: err[outcome.Fail] = git_inspector_require(a, gi);
    if (sel er.err) { ret res[str, outcome.Fail].err{er.err}; }
    var args: [3]str;
    args[0] = "tag";
    args[1] = "--points-at";
    args[2] = rev;
    val r: res[str, outcome.Fail] = git_query_raw(a, gi, dir, ?args[0], 3);
    if (sel r.err) { ret r; }
    val text: str   = r.ok;
    val n:    usize = str_len(text);
    var best: str   = "";
    var bv:   range.Version;
    var at:   usize = 0;
    for (at < n) {
        var end: usize = at;
        for (end < n && text[end] != '\n') { end = end + 1; }
        if (end - at > 1 && text[at] == 'v') {
            val cut: res[str, A.Error] = str_dup_range(a, text, at + 1, end - at - 1);
            if (sel cut.err) {
                str_free(a, text);
                if (!str_empty(best)) { str_free(a, best); }
                ret res[str, outcome.Fail].err{outcome.refused(cut.err)};
            }
            var kept: bool                    = false;
            val v:    res[range.Version, str] = range.parse_version(cut.ok);
            if (sel v.ok) {
                var cand_v: range.Version = v.ok;
                if (str_empty(best) || range.compare(?cand_v, ?bv) > 0) {
                    if (!str_empty(best)) { str_free(a, best); }
                    best = cut.ok;
                    bv   = cand_v;
                    kept = true;
                }
            }
            if (!kept) { str_free(a, cut.ok); }
        }
        at = end + 1;
    }
    str_free(a, text);
    ret res[str, outcome.Fail].ok{best};
}

fun realize_git_clone_env(s: *session.Session, root: str, id: str, url: str, ref: str,
    extra_env: **u8) err[outcome.Fail] {
    val gi_r: res[GitInspector, outcome.Fail] = git_inspector_init(s.build_alloc);
    if (sel gi_r.err) { ret err[outcome.Fail].err{gi_r.err}; }
    var gi: GitInspector = gi_r.ok;

    val dep_full_r: res[str, outcome.Fail] = dep_full_of(s.build_alloc, root, id);
    if (sel dep_full_r.err) {
        git_inspector_dnit(s.build_alloc, ?gi);
        ret err[outcome.Fail].err{dep_full_r.err};
    }
    val dep_full:   str                 = dep_full_r.ok;
    val dep_root_r: res[str, fail.Fail] = load.join_path(s.build_alloc, root, REALIZE_DEP_DIR);
    if (sel dep_root_r.err) {
        str_free(s.build_alloc, dep_full);
        git_inspector_dnit(s.build_alloc, ?gi);
        ret err[outcome.Fail].err{outcome.from_fail(dep_root_r.err)};
    }
    val dep_root:         str             = dep_root_r.ok;
    val create_dir_all_r: err[fs.FsError] = fs.create_dir_all(s.build_alloc, dep_root, 0o755);
    if (sel create_dir_all_r.err) {
        str_free(s.build_alloc, dep_root);
        str_free(s.build_alloc, dep_full);
        git_inspector_dnit(s.build_alloc, ?gi);
        ret err[outcome.Fail].err{outcome.user("cannot create the dependency directory")};
    }

    var clone_args: [3]str;
    clone_args[0] = "clone";
    clone_args[1] = url;
    clone_args[2] = id;
    val clone_r: res[str, outcome.Fail] = git_op(s.build_alloc, ?gi, dep_root, ?clone_args[0], 3, extra_env);
    str_free(s.build_alloc, dep_root);
    if (sel clone_r.err) {
        print.eprintlnf("note: cloning dep/{} failed; existing and partial checkouts retained", id);
        str_free(s.build_alloc, dep_full);
        git_inspector_dnit(s.build_alloc, ?gi);
        ret err[outcome.Fail].err{clone_r.err};
    }
    str_free(s.build_alloc, clone_r.ok);

    val sel_r: err[outcome.Fail] = realize_selector_ref(s.build_alloc, ?gi, dep_full, ref, extra_env);
    if (sel sel_r.err) {
        print.eprintlnf("note: dep/{} was cloned; selector checkout failed; clone retained", id);
        val fault: str                          = outcome.describe(sel_r.err);
        val msg_r: res[str, format.FormatError] = format.sprint(s.build_alloc, "checkout of '{}': {}", ref, fault);
        str_free(s.build_alloc, dep_full);
        git_inspector_dnit(s.build_alloc, ?gi);
        if (sel msg_r.err) { ret err[outcome.Fail].err{outcome.user("dependency checkout failed")}; }
        ret err[outcome.Fail].err{outcome.user(msg_r.ok)};
    }

    val id_r: err[outcome.Fail] = verify_dep_manifest_id(s, dep_full, id);
    if (sel id_r.err) {
        print.eprintlnf("note: dep/{} was cloned and checked out; manifest validation failed; clone retained", id);
        val fault: str = outcome.describe(id_r.err);
        str_free(s.build_alloc, dep_full);
        git_inspector_dnit(s.build_alloc, ?gi);
        ret err[outcome.Fail].err{outcome.user(fault)};
    }

    str_free(s.build_alloc, dep_full);
    git_inspector_dnit(s.build_alloc, ?gi);
    ret err[outcome.Fail].ok{};
}

# what occupies dep/<id>
pub val SLOT_ABSENT:   u8 = 0;
pub val SLOT_EMPTY:    u8 = 1;
pub val SLOT_CHECKOUT: u8 = 2;
pub val SLOT_OCCUPIED: u8 = 3;
pub val SLOT_SYMLINK:  u8 = 4;
pub val SLOT_ENTRY:    u8 = 5;

# a git dependency's slot: what dep/<id> holds, and its record in the enclosing
# repository. the record lives at `top`, the repository's top level where
# .gitmodules is, under the path `record`: dep/<id> when the project root is the
# repository root, and the project's prefix ahead of it when the project is a
# subdirectory of a repository, so a committed gitlink under a subproject is
# its pin exactly as the root's is. `top` is empty when the root is in no work
# tree, and then there is no record to read
pub rec GitSlot {
    tree:       u8;
    top:        str;
    record:     str;
    gitlink:    opt[str];
    registered: bool;
    store:      bool;
}

# what realizing a git dependency changed
pub val REALIZED_NOTHING:     u8 = 0;
pub val REALIZED_INITIALIZED: u8 = 1;
pub val REALIZED_PINNED:      u8 = 2;
pub val REALIZED_REGISTERED:  u8 = 3;
pub val REALIZED_ADOPTED:     u8 = 4;
pub val REALIZED_CLONED:      u8 = 5;

pub fun git_slot_dnit(alloc: *A.Allocator, slot: *GitSlot) {
    val gitlink: opt[str] = slot.gitlink;
    if (sel gitlink.some) { str_free(alloc, gitlink.some); }
    slot.gitlink = opt[str].none{};
    if (!str_empty(slot.top))    { str_free(alloc, slot.top); }
    if (!str_empty(slot.record)) { str_free(alloc, slot.record); }
    slot.top    = "";
    slot.record = "";
}

# whether the slot has a record to read or write: the project root is a
# repository root, or a subdirectory of one
pub fun git_slot_recorded(slot: *GitSlot) bool {
    ret !str_empty(slot.top);
}

# where dep/<id>'s record lives: the repository root records at dep/<id>
# itself; a subproject records at the repository's top level under its prefix.
# `top` and `record` come back empty for a root in no work tree
fun slot_record_place(s: *session.Session, gi: *GitInspector, root: str, rel: str, mode: u8,
    top: *str, record: *str) err[outcome.Fail] {
    @top    = "";
    @record = "";
    if (mode == REALIZE_REPO_ROOT) {
        val top_r: res[str, string.StrError] = string.str_copy(s.build_alloc, root);
        if (sel top_r.err) { ret err[outcome.Fail].err{outcome.user(outcome.str_text(top_r.err))}; }
        val rec_r: res[str, string.StrError] = string.str_copy(s.build_alloc, rel);
        if (sel rec_r.err) {
            str_free(s.build_alloc, top_r.ok);
            ret err[outcome.Fail].err{outcome.user(outcome.str_text(rec_r.err))};
        }
        @top    = top_r.ok;
        @record = rec_r.ok;
        ret err[outcome.Fail].ok{};
    }
    if (!git_is_work_tree(s.build_alloc, gi, root)) { ret err[outcome.Fail].ok{}; }
    var top_args: [2]str                 = [2]str{"rev-parse", "--show-toplevel"};
    val top_r:    res[str, outcome.Fail] = git_query(s.build_alloc, gi, root, ?top_args[0], 2);
    if (sel top_r.err) { ret err[outcome.Fail].err{top_r.err}; }
    val prefix_r: res[str, outcome.Fail] = declaring_prefix(s, gi, "project", root);
    if (sel prefix_r.err) {
        str_free(s.build_alloc, top_r.ok);
        ret err[outcome.Fail].err{prefix_r.err};
    }
    val record_r: res[str, format.FormatError] = format.sprint(s.build_alloc, "{}{}", prefix_r.ok, rel);
    str_free(s.build_alloc, prefix_r.ok);
    if (sel record_r.err) {
        str_free(s.build_alloc, top_r.ok);
        ret err[outcome.Fail].err{outcome.user(outcome.format_text(record_r.err))};
    }
    @top    = top_r.ok;
    @record = record_r.ok;
    ret err[outcome.Fail].ok{};
}

fun slot_tree(alloc: *A.Allocator, dep_full: str) res[u8, outcome.Fail] {
    val link_r: res[bool, io_error.Error] = fs.is_symlink(dep_full);
    if ((sel link_r.ok && link_r.ok)) { ret res[u8, outcome.Fail].ok{SLOT_SYMLINK}; }
    val exists_r: res[bool, io_error.Error] = fs.exists(dep_full);
    if (sel exists_r.err) { ret res[u8, outcome.Fail].err{outcome.user(outcome.io_text(exists_r.err))}; }
    if (!exists_r.ok)     { ret res[u8, outcome.Fail].ok{SLOT_ABSENT}; }
    val dir_r: res[bool, io_error.Error] = fs.is_dir(dep_full);
    if (!(sel dir_r.ok && dir_r.ok))    { ret res[u8, outcome.Fail].ok{SLOT_ENTRY}; }
    if (own_work_tree(alloc, dep_full)) { ret res[u8, outcome.Fail].ok{SLOT_CHECKOUT}; }
    val names_r: res[Vector[str], fs.FsError] = fs.read_dir(alloc, dep_full);
    if (sel names_r.err) { ret res[u8, outcome.Fail].err{outcome.user(outcome.fs_text(names_r.err))}; }
    var names: Vector[str] = names_r.ok;
    val empty: bool        = names.len == 0;
    free_name_vector(alloc, ?names);
    if (empty) { ret res[u8, outcome.Fail].ok{SLOT_EMPTY}; }
    ret res[u8, outcome.Fail].ok{SLOT_OCCUPIED};
}

pub fun observe_git_slot(s: *session.Session, root: str, id: str, mode: u8) res[GitSlot, outcome.Fail] {
    var slot:       GitSlot                = GitSlot{tree: SLOT_ABSENT, top: "", record: "", gitlink: opt[str].none{}, registered: false, store: false};
    val dep_full_r: res[str, outcome.Fail] = dep_full_of(s.build_alloc, root, id);
    if (sel dep_full_r.err) { ret res[GitSlot, outcome.Fail].err{dep_full_r.err}; }
    val dep_full: str = dep_full_r.ok;
    fin { str_free(s.build_alloc, dep_full); }
    val tree_r: res[u8, outcome.Fail] = slot_tree(s.build_alloc, dep_full);
    if (sel tree_r.err) { ret res[GitSlot, outcome.Fail].err{tree_r.err}; }
    slot.tree = tree_r.ok;

    val rel_r: res[str, outcome.Fail] = dep_rel_of(s.build_alloc, id);
    if (sel rel_r.err) { ret res[GitSlot, outcome.Fail].err{rel_r.err}; }
    val rel: str = rel_r.ok;
    fin { str_free(s.build_alloc, rel); }
    var gi:       GitInspector      = GitInspector{program: nil};
    val required: err[outcome.Fail] = git_inspector_require(s.build_alloc, ?gi);
    if (sel required.err) { ret res[GitSlot, outcome.Fail].err{required.err}; }
    fin { git_inspector_dnit(s.build_alloc, ?gi); }
    val placed: err[outcome.Fail] = slot_record_place(s, ?gi, root, rel, mode, ?slot.top, ?slot.record);
    if (sel placed.err)            { ret res[GitSlot, outcome.Fail].err{placed.err}; }
    if (!git_slot_recorded(?slot)) { ret res[GitSlot, outcome.Fail].ok{slot}; }
    var placed_slot: bool = false;
    fin {
        if (!placed_slot) { git_slot_dnit(s.build_alloc, ?slot); }
    }

    val key_r: res[str, format.FormatError] = format.sprint(s.build_alloc, "submodule.{}.path", slot.record);
    if (sel key_r.err) { ret res[GitSlot, outcome.Fail].err{outcome.user(outcome.format_text(key_r.err))}; }
    fin { str_free(s.build_alloc, key_r.ok); }
    var config_args: [7]str                 = [7]str{"config", "-f", ".gitmodules", "--default", "", "--get", key_r.ok};
    val config_r:    res[str, outcome.Fail] = git_query(s.build_alloc, ?gi, slot.top, ?config_args[0], 7);
    if (sel config_r.err) { ret res[GitSlot, outcome.Fail].err{config_r.err}; }
    slot.registered = str_equals(config_r.ok, slot.record);
    str_free(s.build_alloc, config_r.ok);

    val module_r: res[str, format.FormatError] = format.sprint(s.build_alloc, "modules/{}", slot.record);
    if (sel module_r.err) { ret res[GitSlot, outcome.Fail].err{outcome.user(outcome.format_text(module_r.err))}; }
    fin { str_free(s.build_alloc, module_r.ok); }
    var store_args: [3]str                 = [3]str{"rev-parse", "--git-path", module_r.ok};
    val store_r:    res[str, outcome.Fail] = git_query(s.build_alloc, ?gi, slot.top, ?store_args[0], 3);
    if (sel store_r.err) { ret res[GitSlot, outcome.Fail].err{store_r.err}; }
    fin { str_free(s.build_alloc, store_r.ok); }
    var store: str = store_r.ok;
    if (!path.is_abs(store)) {
        val joined: res[str, fail.Fail] = load.join_path(s.build_alloc, slot.top, store);
        if (sel joined.err) { ret res[GitSlot, outcome.Fail].err{outcome.from_fail(joined.err)}; }
        store = joined.ok;
    }
    val store_dir: res[bool, io_error.Error] = fs.is_dir(store);
    if (store != store_r.ok) { str_free(s.build_alloc, store); }
    slot.store = (sel store_dir.ok && store_dir.ok);

    val link_r: res[opt[str], outcome.Fail] = staged_gitlink(s, root, id);
    if (sel link_r.err) { ret res[GitSlot, outcome.Fail].err{link_r.err}; }
    slot.gitlink = link_r.ok;
    placed_slot  = true;
    ret res[GitSlot, outcome.Fail].ok{slot};
}

# refuse a slot whose realization would replace or record work mach did not make
pub fun refuse_git_slot(s: *session.Session, root: str, id: str, mode: u8, slot: *GitSlot, accept: bool) err[outcome.Fail] {
    if (slot.tree == SLOT_SYMLINK) { ret err[outcome.Fail].err{outcome.user("dependency checkout is a symlink; existing entry retained")}; }
    if (slot.tree == SLOT_ENTRY) {
        val msg_r: res[str, format.FormatError] = format.sprint(s.build_alloc, "dep/{} is not a directory; existing entry retained", id);
        if (sel msg_r.err) { ret err[outcome.Fail].err{outcome.user("dependency path is not a directory; existing entry retained")}; }
        ret err[outcome.Fail].err{outcome.user(msg_r.ok)};
    }
    if (slot.tree == SLOT_OCCUPIED) {
        val msg_r: res[str, format.FormatError] = format.sprint(s.build_alloc,
            "dep/{} exists but is neither a checkout of its own nor an empty gitlink placeholder; move it aside and run `mach dep pull <path>` for project '{}'", id, root);
        if (sel msg_r.err) { ret err[outcome.Fail].err{outcome.user("dependency directory is neither a checkout nor an empty placeholder")}; }
        ret err[outcome.Fail].err{outcome.user(msg_r.ok)};
    }
    if (slot.tree != SLOT_CHECKOUT) { ret err[outcome.Fail].ok{}; }
    val pinned:   opt[str] = slot.gitlink;
    val adopting: bool     = mode == REALIZE_REPO_ROOT && (sel pinned.none);
    if (!accept && !adopting) { ret err[outcome.Fail].ok{}; }

    val dep_full_r: res[str, outcome.Fail] = dep_full_of(s.build_alloc, root, id);
    if (sel dep_full_r.err) { ret err[outcome.Fail].err{dep_full_r.err}; }
    fin { str_free(s.build_alloc, dep_full_r.ok); }
    var gi:       GitInspector      = GitInspector{program: nil};
    val required: err[outcome.Fail] = git_inspector_require(s.build_alloc, ?gi);
    if (sel required.err) { ret required; }
    fin { git_inspector_dnit(s.build_alloc, ?gi); }
    var status_args: [3]str                 = [3]str{"status", "--porcelain=v1", "--untracked-files=all"};
    val status_r:    res[str, outcome.Fail] = git_query_named(s, ?gi, id, dep_full_r.ok, ?status_args[0], 3, "checkout cleanliness");
    if (sel status_r.err) { ret err[outcome.Fail].err{status_r.err}; }
    val status: str = status_r.ok;
    if (str_empty(status)) {
        str_free(s.build_alloc, status);
        ret err[outcome.Fail].ok{};
    }
    val msg_r: res[str, format.FormatError] = format.sprint(s.build_alloc,
        "dependency '{}': checkout is dirty; commit or discard its changes, existing checkout retained:\n{}", id, status);
    str_free(s.build_alloc, status);
    if (sel msg_r.err) { ret err[outcome.Fail].err{outcome.user("dependency checkout is dirty; existing checkout retained")}; }
    ret err[outcome.Fail].err{outcome.user(msg_r.ok)};
}

# bring a slot `refuse_git_slot` accepted to the realization a build verifies
pub fun realize_git_slot(s: *session.Session, root: str, id: str, url: str, ref: str, mode: u8,
    slot: *GitSlot) res[u8, outcome.Fail] {
    ret realize_git_slot_env(s, root, id, url, ref, mode, slot, nil);
}

fun realize_git_slot_env(s: *session.Session, root: str, id: str, url: str, ref: str, mode: u8,
    slot: *GitSlot, extra_env: **u8) res[u8, outcome.Fail] {
    # a subproject's dependency is a plain clone unless the enclosing repository
    # commits a gitlink for it, and then that gitlink is its pin like the root's
    val recorded_pin: opt[str] = slot.gitlink;
    if (mode != REALIZE_REPO_ROOT && (sel recorded_pin.none)) {
        if (slot.tree == SLOT_CHECKOUT) { ret res[u8, outcome.Fail].ok{REALIZED_NOTHING}; }
        val cloned: err[outcome.Fail] = realize_git_clone_env(s, root, id, url, ref, extra_env);
        if (sel cloned.err) { ret res[u8, outcome.Fail].err{cloned.err}; }
        ret res[u8, outcome.Fail].ok{REALIZED_CLONED};
    }

    var gi:       GitInspector      = GitInspector{program: nil};
    val required: err[outcome.Fail] = git_inspector_require(s.build_alloc, ?gi);
    if (sel required.err) { ret res[u8, outcome.Fail].err{required.err}; }
    fin { git_inspector_dnit(s.build_alloc, ?gi); }
    val rel_r: res[str, outcome.Fail] = dep_rel_of(s.build_alloc, id);
    if (sel rel_r.err) { ret res[u8, outcome.Fail].err{rel_r.err}; }
    val rel: str = rel_r.ok;
    fin { str_free(s.build_alloc, rel); }
    val dep_full_r: res[str, outcome.Fail] = dep_full_of(s.build_alloc, root, id);
    if (sel dep_full_r.err) { ret res[u8, outcome.Fail].err{dep_full_r.err}; }
    val dep_full: str = dep_full_r.ok;
    fin { str_free(s.build_alloc, dep_full); }

    val pinned: opt[str] = slot.gitlink;
    if (sel pinned.some) {
        var effect: u8 = REALIZED_NOTHING;
        if (!slot.registered) {
            val registered: err[outcome.Fail] = register_gitlink(s, ?gi, slot.top, id, slot.record, url, extra_env);
            if (sel registered.err) { ret res[u8, outcome.Fail].err{registered.err}; }
            effect = REALIZED_REGISTERED;
        }
        if (slot.tree != SLOT_CHECKOUT) {
            var init_args: [5]str                 = [5]str{"submodule", "update", "--init", "--", rel};
            val init_r:    res[str, outcome.Fail] = git_op(s.build_alloc, ?gi, root, ?init_args[0], 5, extra_env);
            if (sel init_r.err) { ret res[u8, outcome.Fail].err{init_r.err}; }
            str_free(s.build_alloc, init_r.ok);
            ret res[u8, outcome.Fail].ok{REALIZED_INITIALIZED};
        }
        var head_args: [2]str                 = [2]str{"rev-parse", "HEAD"};
        val head_r:    res[str, outcome.Fail] = git_query(s.build_alloc, ?gi, dep_full, ?head_args[0], 2);
        if (sel head_r.err) { ret res[u8, outcome.Fail].err{head_r.err}; }
        val at_pin: bool = str_equals(head_r.ok, pinned.some);
        str_free(s.build_alloc, head_r.ok);
        if (at_pin) { ret res[u8, outcome.Fail].ok{effect}; }
        var checkout_args: [3]str                 = [3]str{"checkout", "--detach", pinned.some};
        val checkout_r:    res[str, outcome.Fail] = git_op(s.build_alloc, ?gi, dep_full, ?checkout_args[0], 3, extra_env);
        if (sel checkout_r.err) { ret res[u8, outcome.Fail].err{checkout_r.err}; }
        str_free(s.build_alloc, checkout_r.ok);
        ret res[u8, outcome.Fail].ok{REALIZED_PINNED};
    }

    # git adds a submodule only where nothing is, so an empty placeholder goes first
    if (slot.tree == SLOT_EMPTY) {
        val cleared: err[io_error.Error] = fs.remove_dir(dep_full);
        if (sel cleared.err) { ret res[u8, outcome.Fail].err{outcome.user(outcome.io_text(cleared.err))}; }
    }
    val adopting: bool              = slot.tree == SLOT_CHECKOUT;
    val added:    err[outcome.Fail] = add_git_submodule(s, ?gi, root, id, rel, dep_full, url, ref,
        slot.store && !adopting, slot.store || adopting, extra_env);
    if (sel added.err) { ret res[u8, outcome.Fail].err{added.err}; }
    if (adopting)      { ret res[u8, outcome.Fail].ok{REALIZED_ADOPTED}; }
    ret res[u8, outcome.Fail].ok{REALIZED_CLONED};
}

# observe, refuse and realize one git dependency
pub fun realize_git_dependency(s: *session.Session, root: str, id: str, url: str, ref: str, mode: u8,
    accept: bool) res[u8, outcome.Fail] {
    ret realize_git_dependency_env(s, root, id, url, ref, mode, accept, nil);
}

fun realize_git_dependency_env(s: *session.Session, root: str, id: str, url: str, ref: str, mode: u8,
    accept: bool, extra_env: **u8) res[u8, outcome.Fail] {
    val observed: res[GitSlot, outcome.Fail] = observe_git_slot(s, root, id, mode);
    if (sel observed.err) { ret res[u8, outcome.Fail].err{observed.err}; }
    var slot: GitSlot = observed.ok;
    fin { git_slot_dnit(s.build_alloc, ?slot); }
    val refused: err[outcome.Fail] = refuse_git_slot(s, root, id, mode, ?slot, accept);
    if (sel refused.err) { ret res[u8, outcome.Fail].err{refused.err}; }
    ret realize_git_slot_env(s, root, id, url, ref, mode, ?slot, extra_env);
}

pub fun remove_dependency_index(s: *session.Session, root: str, id: str, mode: u8) err[outcome.Fail] {
    if (mode == REALIZE_NESTED) { ret err[outcome.Fail].ok{}; }
    val rel_r: res[str, outcome.Fail] = dep_rel_of(s.build_alloc, id);
    if (sel rel_r.err) { ret err[outcome.Fail].err{rel_r.err}; }
    val rel: str = rel_r.ok;
    fin { str_free(s.build_alloc, rel); }
    val selected: res[opt[str], outcome.Fail] = staged_gitlink(s, root, id);
    if (sel selected.err) { ret err[outcome.Fail].err{selected.err}; }
    val gitlink: opt[str] = selected.ok;
    if (sel gitlink.none) { ret err[outcome.Fail].ok{}; }
    fin { str_free(s.build_alloc, gitlink.some); }
    var gi:       GitInspector;
    val required: err[outcome.Fail] = git_inspector_require(s.build_alloc, ?gi);
    if (sel required.err) { ret err[outcome.Fail].err{required.err}; }
    fin { git_inspector_dnit(s.build_alloc, ?gi); }
    val clean: err[outcome.Fail] = require_matches_index(s, ?gi, id, root, ".gitmodules", "dependency metadata before removal");
    if (sel clean.err) { ret err[outcome.Fail].err{clean.err}; }
    val key_r: res[str, format.FormatError] = format.sprint(s.build_alloc, "submodule.{}.path", rel);
    if (sel key_r.err) { ret err[outcome.Fail].err{outcome.user(outcome.format_text(key_r.err))}; }
    val key: str = key_r.ok;
    fin { str_free(s.build_alloc, key); }
    var query:   [5]str                 = [5]str{"config", "-f", ".gitmodules", "--get", key};
    val checked: res[str, outcome.Fail] = git_query(s.build_alloc, ?gi, root, ?query[0], 5);
    if (sel checked.err) { ret err[outcome.Fail].err{checked.err}; }
    val registered: str = checked.ok;
    fin { str_free(s.build_alloc, registered); }
    if (!str_equals(registered, rel)) { ret err[outcome.Fail].err{outcome.user("dependency submodule registration does not match its path")}; }

    var remove:  [5]str                      = [5]str{"rm", "--force", "--cached", "--", rel};
    val removed: res[GitBytes, outcome.Fail] = git_query_capture(s.build_alloc, ?gi, root, ?remove[0], 5, true, nil, os.INVALID_HANDLE, false);
    if (sel removed.err) {
        print.eprintlnf("note: dep/{} was not removed from the index; checkout retained", id);
        ret err[outcome.Fail].err{removed.err};
    }
    var removed_output: GitBytes = removed.ok;
    git_bytes_free(s.build_alloc, ?removed_output);
    val section_r: res[str, format.FormatError] = format.sprint(s.build_alloc, "submodule.{}", rel);
    if (sel section_r.err) { ret err[outcome.Fail].err{outcome.user("dependency removed from the index; could not allocate its submodule section name; checkout retained")}; }
    val section: str = section_r.ok;
    fin { str_free(s.build_alloc, section); }
    var unregister:   [5]str                 = [5]str{"config", "-f", ".gitmodules", "--remove-section", section};
    val unregistered: res[str, outcome.Fail] = git_op(s.build_alloc, ?gi, root, ?unregister[0], 5, nil);
    if (sel unregistered.err) { ret err[outcome.Fail].err{outcome.user("dependency removed from the index; updating .gitmodules failed; checkout retained")}; }
    str_free(s.build_alloc, unregistered.ok);
    var stage:  [3]str                 = [3]str{"add", "--", ".gitmodules"};
    val staged: res[str, outcome.Fail] = git_op(s.build_alloc, ?gi, root, ?stage[0], 3, nil);
    if (sel staged.err) { ret err[outcome.Fail].err{outcome.user("dependency removed from the index and .gitmodules; staging .gitmodules failed; checkout retained")}; }
    str_free(s.build_alloc, staged.ok);
    ret err[outcome.Fail].ok{};
}

rec CopyEntry {
    rel:       str;
    directory: bool;
    mode:      i32;
}

fun cmp_copy_entry(a: *CopyEntry, b: *CopyEntry) i64 {
    ret str_compare(a.rel, b.rel);
}

fun copy_entries_free(alloc: *A.Allocator, entries: *Vector[CopyEntry]) {
    var i: usize = 0;
    for (i < entries.len) {
        str_free(alloc, entries.data[i].rel);
        i = i + 1;
    }
    vector.dnit[CopyEntry](entries);
}

# the directory a project's `[project].out` names, which is the template's leading
# segment: `out/{target.name}/{profile.name}` is written under `out`. a template that
# opens with a variable names no directory this can exclude, and falls back to the
# conventional name
fun out_dir_segment(alloc: *A.Allocator, template: str, out: *str, owned: *bool) {
    @out   = "out";
    @owned = false;
    val n: usize = str_len(template);
    var i: usize = 0;
    for (i < n && template[i] != '/' && template[i] != '\\' && template[i] != '{') { i = i + 1; }
    if (i == 0)                      { ret; }
    if (i < n && template[i] == '{') { ret; }
    val copied: res[str, string.StrError] = str_copy_slice(alloc, template, 0::usize, i);
    if (sel copied.err) { ret; }
    @out   = copied.ok;
    @owned = true;
}

# the build output of a project directory: its manifest's `out`, or the
# conventional name when there is no readable manifest. a directory without
# a manifest is not a project and excludes nothing
fun project_out_name(alloc: *A.Allocator, dir: str, out: *str, owned: *bool) bool {
    val mf_r: res[str, fail.Fail] = load.join_path(alloc, dir, manifest.MANIFEST_FILE);
    if (sel mf_r.err) { ret false; }
    val mf: str = mf_r.ok;
    fin { str_free(alloc, mf); }
    val present: res[bool, io_error.Error] = fs.is_file(mf);
    if (sel present.err) { ret false; }
    if (!present.ok)     { ret false; }
    @out   = "out";
    @owned = false;
    val table_r: res[toml.Table, outcome.Fail] = parse_toml_file(alloc, mf);
    if (sel table_r.err) { ret true; }
    var table: toml.Table = table_r.ok;
    fin { toml.dnit(alloc, ?table); }
    val declared: opt[str] = toml.get_str(?table, "project.out");
    if (sel declared.some) {
        if (!str_empty(declared.some)) { out_dir_segment(alloc, declared.some, out, owned); }
    }
    ret true;
}

# what git considers part of a path dependency's source: its tracked files and the
# untracked ones its ignore rules keep, listed once (#3491). inactive outside a work tree,
# and for a source the enclosing repository ignores, which that repository does not hold (#3565)
rec PathFilter {
    active: bool;
    paths:  Vector[str];
    top:    str;
}

val FILTER_SKIP:  u8 = 0;
val FILTER_WALK:  u8 = 1;
val FILTER_WHOLE: u8 = 2;

# a path order that reads `\` as `/`, so a joined path compares with git's
fun cmp_rel(a: str, b: str) i64 {
    var i: usize = 0;
    for (true) {
        var ca: u8 = a[i];
        var cb: u8 = b[i];
        if (ca == '\\') { ca = '/'; }
        if (cb == '\\') { cb = '/'; }
        if (ca != cb)   { ret ca::i64 - cb::i64; }
        if (ca == 0)    { ret 0; }
        i = i + 1;
    }
    ret 0;
}

fun cmp_rel_ptr(a: *str, b: *str) i64 {
    ret cmp_rel(@a, @b);
}

fun path_filter_free(alloc: *A.Allocator, f: *PathFilter) {
    if (f.active)     { free_name_vector(alloc, ?f.paths); }
    if (f.top != nil) { str_free(alloc, f.top); }
    f.active = false;
    f.top    = nil;
}

# whether `git status` from a subdirectory reports it, or a directory holding it, as ignored.
# entries are relative to the work tree top, as `prefix` is, and an ignored directory ends in `/`
fun status_ignores_prefix(bytes: *GitBytes, prefix: str) bool {
    val n:  usize = str_len(prefix);
    var at: usize = 0;
    for (at < bytes.len) {
        var end: usize = at;
        for (end < bytes.len && bytes.data[end] != 0) { end = end + 1; }
        val len: usize = end - at;
        if (len > 3 && len - 3 <= n && bytes.data[at] == '!' && bytes.data[at + 1] == '!' && bytes.data[end - 1] == '/') {
            var k: usize = 0;
            for (k < len - 3 && bytes.data[at + 3 + k] == prefix[k]) { k = k + 1; }
            if (k == len - 3) { ret true; }
        }
        at = end + 1;
    }
    ret false;
}

fun path_filter_refusal(alloc: *A.Allocator, what: str, src: str, top: str, cause: outcome.Fail) outcome.Fail {
    val mr: res[str, format.FormatError] = format.sprint(alloc,
        "path dependency '{}': cannot {} the git repository at '{}': {}", src, what, top, outcome.describe(cause));
    if (sel mr.err) { ret cause; }
    ret outcome.user(mr.ok);
}

# the kept listing of a source, from the repository that holds it. an empty listing below the
# top of a work tree is the one case where the source may be ignored rather than empty, and only
# then is the ignore state asked for, so a source costs two git processes, or three in that case
fun path_filter_load(alloc: *A.Allocator, src: str) res[PathFilter, outcome.Fail] {
    var f:    PathFilter                      = PathFilter{active: false, top: nil};
    val gi_r: res[GitInspector, outcome.Fail] = git_inspector_init(alloc);
    if (sel gi_r.err) { ret res[PathFilter, outcome.Fail].ok{f}; }
    var gi: GitInspector = gi_r.ok;
    fin { git_inspector_dnit(alloc, ?gi); }
    var where_args: [4]str;
    where_args[0] = "rev-parse";
    where_args[1] = "--is-inside-work-tree";
    where_args[2] = "--show-prefix";
    where_args[3] = "--show-toplevel";
    # a source outside any repository is an expected answer, so git's complaint about it is captured, not shown
    val where_r: res[GitBytes, outcome.Fail] = git_query_capture(alloc, ?gi, src, ?where_args[0], 4, false, nil, os.INVALID_HANDLE, true);
    if (sel where_r.err) { ret res[PathFilter, outcome.Fail].ok{f}; }
    var where: GitBytes = where_r.ok;
    fin { git_bytes_free(alloc, ?where); }
    var first: usize = 0;
    for (first < where.len && where.data[first] != '\n') { first = first + 1; }
    if (first >= where.len) { ret res[PathFilter, outcome.Fail].ok{f}; }
    where.data[first] = 0;
    if (!str_equals(where.data::str, "true")) { ret res[PathFilter, outcome.Fail].ok{f}; }
    val prefix_at: usize = first + 1;
    var second:    usize = prefix_at;
    for (second < where.len && where.data[second] != '\n') { second = second + 1; }
    if (second >= where.len) { ret res[PathFilter, outcome.Fail].ok{f}; }
    where.data[second] = 0;
    val prefix:  str   = (?where.data[prefix_at])::str;
    var top_end: usize = where.len;
    for (top_end > second + 1 && (where.data[top_end - 1] == '\n' || where.data[top_end - 1] == '\r')) { top_end = top_end - 1; }
    val top_r: res[str, string.StrError] = str_copy_slice(alloc, (?where.data[second + 1])::str, 0, top_end - second - 1);
    if (sel top_r.err) { ret res[PathFilter, outcome.Fail].err{outcome.user(outcome.str_text(top_r.err))}; }
    f.top = top_r.ok;
    var list_args: [5]str;
    list_args[0] = "ls-files";
    list_args[1] = "--cached";
    list_args[2] = "--others";
    list_args[3] = "--exclude-standard";
    list_args[4] = "-z";
    val listed: res[GitBytes, outcome.Fail] = git_query_capture(alloc, ?gi, src, ?list_args[0], 5, false, nil, os.INVALID_HANDLE, true);
    if (sel listed.err) {
        val refusal: outcome.Fail = path_filter_refusal(alloc, "list the files kept by", src, f.top, listed.err);
        path_filter_free(alloc, ?f);
        ret res[PathFilter, outcome.Fail].err{refusal};
    }
    var bytes: GitBytes = listed.ok;
    fin { git_bytes_free(alloc, ?bytes); }
    if (bytes.len == 0 && !str_empty(prefix)) {
        var status_args: [6]str;
        status_args[0] = "status";
        status_args[1] = "--porcelain=v1";
        status_args[2] = "-z";
        status_args[3] = "--ignored=matching";
        status_args[4] = "--";
        status_args[5] = ".";
        val status_r: res[GitBytes, outcome.Fail] = git_query_capture(alloc, ?gi, src, ?status_args[0], 6, false, nil, os.INVALID_HANDLE, true);
        if (sel status_r.err) {
            val refusal: outcome.Fail = path_filter_refusal(alloc, "read the ignore state from", src, f.top, status_r.err);
            path_filter_free(alloc, ?f);
            ret res[PathFilter, outcome.Fail].err{refusal};
        }
        var status:  GitBytes = status_r.ok;
        val ignored: bool     = status_ignores_prefix(?status, prefix);
        git_bytes_free(alloc, ?status);
        if (ignored) {
            path_filter_free(alloc, ?f);
            ret res[PathFilter, outcome.Fail].ok{f};
        }
    }
    f.paths  = vector.init[str](alloc);
    f.active = true;
    var at: usize = 0;
    for (at < bytes.len) {
        var end: usize = at;
        for (end < bytes.len && bytes.data[end] != 0) { end = end + 1; }
        if (end > at) {
            val one: res[str, string.StrError] = str_copy_slice(alloc, (?bytes.data[at])::str, 0, end - at);
            if (sel one.err) {
                path_filter_free(alloc, ?f);
                ret res[PathFilter, outcome.Fail].err{outcome.user(outcome.str_text(one.err))};
            }
            val pushed: res[usize, A.Error] = vector.push[str](?f.paths, one.ok);
            if (sel pushed.err) {
                str_free(alloc, one.ok);
                path_filter_free(alloc, ?f);
                ret res[PathFilter, outcome.Fail].err{outcome.refused(pushed.err)};
            }
        }
        at = end + 1;
    }
    sort.sort[str](f.paths.data, f.paths.len, cmp_rel_ptr);
    ret res[PathFilter, outcome.Fail].ok{f};
}

# `path` against `rel` followed by a separator, in cmp_rel's order
fun cmp_rel_below(path: str, rel: str) i64 {
    var i: usize = 0;
    for (rel[i] != 0) {
        var ca: u8 = path[i];
        var cb: u8 = rel[i];
        if (ca == '\\') { ca = '/'; }
        if (cb == '\\') { cb = '/'; }
        if (ca != cb)   { ret ca::i64 - cb::i64; }
        i = i + 1;
    }
    var ca: u8 = path[i];
    if (ca == '\\') { ca = '/'; }
    ret ca::i64 - '/'::i64;
}

# a listed path is kept, and a directory is walked when a listed path lies beneath it; a listed
# directory is a submodule gitlink, whose content git does not list, so it is kept whole
fun filter_decides(f: *PathFilter, rel: str) u8 {
    var lo: usize = 0;
    var hi: usize = f.paths.len;
    for (lo < hi) {
        val mid: usize = lo + (hi - lo) / 2;
        if (cmp_rel(f.paths.data[mid], rel) < 0) { lo = mid + 1; }
        or                                       { hi = mid; }
    }
    if (lo < f.paths.len && cmp_rel(f.paths.data[lo], rel) == 0) { ret FILTER_WHOLE; }
    # the first listed path at or after `rel/`, which lies beneath `rel` exactly when it starts so
    lo = 0;
    hi = f.paths.len;
    for (lo < hi) {
        val mid: usize = lo + (hi - lo) / 2;
        if (cmp_rel_below(f.paths.data[mid], rel) < 0) { lo = mid + 1; }
        or                                             { hi = mid; }
    }
    if (lo >= f.paths.len) { ret FILTER_SKIP; }
    val n: usize = str_len(rel);
    if (str_len(f.paths.data[lo]) <= n) { ret FILTER_SKIP; }
    var k: usize = 0;
    for (k < n) {
        var ca: u8 = f.paths.data[lo][k];
        var cb: u8 = rel[k];
        if (ca == '\\') { ca = '/'; }
        if (cb == '\\') { cb = '/'; }
        if (ca != cb)   { ret FILTER_SKIP; }
        k = k + 1;
    }
    val sep: u8 = f.paths.data[lo][n];
    if (sep == '/' || sep == '\\') { ret FILTER_WALK; }
    ret FILTER_SKIP;
}

# the inventory of a path dependency is its source: at every project
# boundary (a directory holding a manifest) the realized dependencies and
# the build output are left behind, so a re-pull copies what the first did.
# `keep`, when active, narrows it to what git keeps
fun copy_inventory(alloc: *A.Allocator, root: str, rel: str, source: bool,
    excluded: *fs.Identity, entries: *Vector[CopyEntry], keep: *PathFilter) err[outcome.Fail] {
    val dir_r: res[str, fail.Fail] = load.join_path(alloc, root, rel);
    if (sel dir_r.err) { ret err[outcome.Fail].err{outcome.from_fail(dir_r.err)}; }
    val dir: str = dir_r.ok;
    fin { str_free(alloc, dir); }
    var out:     str  = nil;
    var owned:   bool = false;
    var project: bool = false;
    if (source) { project = project_out_name(alloc, dir, ?out, ?owned); }
    fin {
        if (owned) { str_free(alloc, out); }
    }
    val names_r: res[Vector[str], fs.FsError] = fs.read_dir(alloc, dir);
    if (sel names_r.err) { ret err[outcome.Fail].err{outcome.user(outcome.fs_text(names_r.err))}; }
    var names: Vector[str] = names_r.ok;
    fin { free_name_vector(alloc, ?names); }
    sort.sort[str](names.data, names.len, cmp_dep_name);
    var i: usize = 0;
    for (i < names.len) {
        val name: str = names.data[i];
        i = i + 1;
        if (source && str_equals(name, ".git"))                                                      { cnt; }
        if (project && (str_equals(name, REALIZE_DEP_DIR) || (out != nil && str_equals(name, out)))) { cnt; }
        val child_r: res[str, fail.Fail] = load.join_path(alloc, rel, name);
        if (sel child_r.err) { ret err[outcome.Fail].err{outcome.from_fail(child_r.err)}; }
        val child:       str  = child_r.ok;
        var transferred: bool = false;
        fin {
            if (!transferred) { str_free(alloc, child); }
        }
        var decision: u8 = FILTER_WHOLE;
        if (keep != nil && keep.active) { decision = filter_decides(keep, child); }
        if (decision == FILTER_SKIP)    { cnt; }
        val full_r: res[str, fail.Fail] = load.join_path(alloc, root, child);
        if (sel full_r.err) { ret err[outcome.Fail].err{outcome.from_fail(full_r.err)}; }
        val full: str = full_r.ok;
        fin { str_free(alloc, full); }
        val mr: res[fs.Metadata, io_error.Error] = fs.metadata_link(full);
        if (sel mr.err) { ret err[outcome.Fail].err{outcome.user(outcome.io_text(mr.err))}; }
        val meta:      fs.Metadata = mr.ok;
        val directory: bool        = fs.meta_is_dir(?meta);
        if (!directory && !fs.meta_is_file(?meta)) {
            ret err[outcome.Fail].err{outcome.user("path dependency inventory contains a symlink or non-regular entry; existing files retained")};
        }
        if (directory && excluded != nil) {
            var identity: fs.Identity;
            if (os.identity_at(os.working_dir(), full::*u8, ?identity) < 0) { ret err[outcome.Fail].err{outcome.user("cannot observe path dependency source directory identity")}; }
            if (fs.identity_equal(identity, excluded[0]))                   { cnt; }
        }
        val pushed: res[usize, A.Error] = vector.push[CopyEntry](entries, CopyEntry{rel: child, directory: directory, mode: (meta.mode & 0o777)::i32});
        if (sel pushed.err) { ret err[outcome.Fail].err{outcome.refused(pushed.err)}; }
        transferred = true;
        if (directory) {
            var nested_keep: *PathFilter = keep;
            if (decision == FILTER_WHOLE) { nested_keep = nil; }
            val nested: err[outcome.Fail] = copy_inventory(alloc, root, child, source, excluded, entries, nested_keep);
            if (sel nested.err) { ret err[outcome.Fail].err{nested.err}; }
        }
    }
    ret err[outcome.Fail].ok{};
}

# the entry of a sorted inventory at `rel`, or nil
fun inventory_find(entries: *Vector[CopyEntry], rel: str) *CopyEntry {
    var lo: usize = 0;
    var hi: usize = entries.len;
    for (lo < hi) {
        val mid: usize = lo + (hi - lo) / 2;
        val cmp: i64   = str_compare(entries.data[mid].rel, rel);
        if (cmp == 0) { ret ?entries.data[mid]; }
        if (cmp < 0)  { lo = mid + 1; }
        or            { hi = mid; }
    }
    ret nil;
}

# whether the source inventory holds `prior` with the same kind
fun source_has(entries: *Vector[CopyEntry], prior: *CopyEntry) bool {
    val found: *CopyEntry = inventory_find(entries, prior.rel);
    ret found != nil && found.directory == prior.directory;
}

fun bytes_equal(a: *Vector[u8], b: *Vector[u8]) bool {
    if (a.len != b.len) { ret false; }
    var i: usize = 0;
    for (i < a.len) {
        if (a.data[i] != b.data[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# a source's inventory is never silently empty, and a project source keeps its manifest,
# since an empty or manifest-less copy fails later with a cause that points elsewhere (#3565)
fun inventory_keeps_source(alloc: *A.Allocator, src: str, entries: *Vector[CopyEntry], keep: *PathFilter) err[outcome.Fail] {
    var wanted: CopyEntry = CopyEntry{rel: manifest.MANIFEST_FILE, directory: false, mode: 0};
    var holds:  bool      = entries.len != 0;
    if (holds) {
        val mf_r: res[str, fail.Fail] = load.join_path(alloc, src, manifest.MANIFEST_FILE);
        if (sel mf_r.err) { ret err[outcome.Fail].err{outcome.from_fail(mf_r.err)}; }
        val present: res[bool, io_error.Error] = fs.is_file(mf_r.ok);
        str_free(alloc, mf_r.ok);
        if (sel present.ok && present.ok) { holds = source_has(entries, ?wanted); }
    }
    if (holds) { ret err[outcome.Fail].ok{}; }
    var mr: res[str, format.FormatError];
    if (keep.active) {
        mr = format.sprint(alloc,
            "path dependency source '{}' keeps no {} under the rules of the git repository at '{}', which ignores it; un-ignore or track it there, or make the source its own repository",
            src, manifest.MANIFEST_FILE, keep.top);
    }
    or              { mr = format.sprint(alloc, "path dependency source '{}' has nothing to copy", src); }
    if (sel mr.err) { ret err[outcome.Fail].err{outcome.user("path dependency source has nothing to copy")}; }
    ret err[outcome.Fail].err{outcome.user(mr.ok)};
}

fun copy_tree(alloc: *A.Allocator, src: str, dst: str) err[outcome.Fail] {
    val sm: res[fs.Metadata, io_error.Error] = fs.metadata_link(src);
    if (sel sm.err) { ret err[outcome.Fail].err{outcome.user(outcome.io_text(sm.err))}; }
    val source_meta: fs.Metadata = sm.ok;
    if (!fs.meta_is_dir(?source_meta)) { ret err[outcome.Fail].err{outcome.user("path dependency source must be a physical directory")}; }
    var destination_identity: fs.Identity;
    val observed:             i64 = os.identity_at(os.working_dir(), dst::*u8, ?destination_identity);
    if (observed < 0 && os.error_kind(observed) != io_error.NOT_FOUND) { ret err[outcome.Fail].err{outcome.user("cannot inspect the path dependency destination")}; }
    var excluded: *fs.Identity = nil;
    if (observed == 0) {
        val dm: res[fs.Metadata, io_error.Error] = fs.metadata_link(dst);
        if (sel dm.err) { ret err[outcome.Fail].err{outcome.user(outcome.io_text(dm.err))}; }
        val destination_meta: fs.Metadata = dm.ok;
        if (!fs.meta_is_dir(?destination_meta)) { ret err[outcome.Fail].err{outcome.user("path dependency destination must be a physical directory")}; }
        var source_identity: fs.Identity;
        if (os.identity_at(os.working_dir(), src::*u8, ?source_identity) < 0) { ret err[outcome.Fail].err{outcome.user("cannot inspect the path dependency source identity")}; }
        if (fs.identity_equal(source_identity, destination_identity))         { ret err[outcome.Fail].err{outcome.user("path dependency source and destination are the same directory")}; }
        excluded = ?destination_identity;
    }
    var entries: Vector[CopyEntry] = vector.init[CopyEntry](alloc);
    fin { copy_entries_free(alloc, ?entries); }
    val filter_r: res[PathFilter, outcome.Fail] = path_filter_load(alloc, src);
    if (sel filter_r.err) { ret err[outcome.Fail].err{filter_r.err}; }
    var keep: PathFilter = filter_r.ok;
    fin { path_filter_free(alloc, ?keep); }
    val collected: err[outcome.Fail] = copy_inventory(alloc, src, "", true, excluded, ?entries, ?keep);
    if (sel collected.err) { ret err[outcome.Fail].err{collected.err}; }
    sort.sort[CopyEntry](entries.data, entries.len, cmp_copy_entry);
    val kept: err[outcome.Fail] = inventory_keeps_source(alloc, src, ?entries, ?keep);
    if (sel kept.err) { ret kept; }
    var existing: Vector[CopyEntry] = vector.init[CopyEntry](alloc);
    fin { copy_entries_free(alloc, ?existing); }
    if (observed == 0) {
        val collected_dst: err[outcome.Fail] = copy_inventory(alloc, dst, "", false, nil, ?existing, nil);
        if (sel collected_dst.err) { ret err[outcome.Fail].err{collected_dst.err}; }
    }
    sort.sort[CopyEntry](existing.data, existing.len, cmp_copy_entry);
    # the realization is its source: an entry the source no longer has is removed rather
    # than kept, and every removal is named, since the destination is mach's own copy
    var i: usize = existing.len;
    for (i > 0) {
        i = i - 1;
        val prior: CopyEntry = existing.data[i];
        if (source_has(?entries, ?prior)) { cnt; }
        val full_r: res[str, fail.Fail] = load.join_path(alloc, dst, prior.rel);
        if (sel full_r.err) { ret err[outcome.Fail].err{outcome.from_fail(full_r.err)}; }
        val full: str = full_r.ok;
        fin { str_free(alloc, full); }
        var why: str = nil;
        if (prior.directory) {
            val pruned: err[fs.FsError] = fs.remove_all(alloc, full);
            if (sel pruned.err) { why = outcome.fs_text(pruned.err); }
        }
        or {
            val unlinked: err[io_error.Error] = fs.remove_file(full);
            if (sel unlinked.err) { why = outcome.io_text(unlinked.err); }
        }
        if (why != nil) {
            val msg: res[str, format.FormatError] = format.sprint(alloc,
                "path dependency destination '{}' holds '{}', which the source no longer has, and it could not be removed: {}", dst, prior.rel, why);
            if (sel msg.err) { ret err[outcome.Fail].err{outcome.user("path dependency destination holds an entry the source no longer has, and it could not be removed")}; }
            ret err[outcome.Fail].err{outcome.user(msg.ok)};
        }
        print.eprintlnf("note: path dependency '{}': removed '{}', which its source no longer has", dst, prior.rel);
    }
    val create_dir_all_r: err[fs.FsError] = fs.create_dir_all(alloc, dst, 0o755);
    if (sel create_dir_all_r.err) { ret err[outcome.Fail].err{outcome.user("cannot create the copy destination")}; }
    i = 0;
    var complete: bool = false;
    fin {
        if (!complete) { print.eprintlnf("note: path dependency copy stopped after {} entries; destination '{}' retained for inspection", i, dst); }
    }
    for (i < entries.len) {
        val entry:  CopyEntry           = entries.data[i];
        val from_r: res[str, fail.Fail] = load.join_path(alloc, src, entry.rel);
        if (sel from_r.err) { ret err[outcome.Fail].err{outcome.from_fail(from_r.err)}; }
        val from: str = from_r.ok;
        fin { str_free(alloc, from); }
        val to_r: res[str, fail.Fail] = load.join_path(alloc, dst, entry.rel);
        if (sel to_r.err) { ret err[outcome.Fail].err{outcome.from_fail(to_r.err)}; }
        val to: str = to_r.ok;
        fin { str_free(alloc, to); }
        if (entry.directory) {
            val made: err[fs.FsError] = fs.create_dir_all(alloc, to, 0o755);
            if (sel made.err) { ret err[outcome.Fail].err{outcome.user(outcome.fs_text(made.err))}; }
        }
        or {
            val bytes_r: res[Vector[u8], fs.FsError] = fs.read_bytes(alloc, from);
            if (sel bytes_r.err) { ret err[outcome.Fail].err{outcome.user(outcome.fs_text(bytes_r.err))}; }
            var bytes: Vector[u8] = bytes_r.ok;
            fin { vector.dnit[u8](?bytes); }
            # a file the copy already holds is left alone when it matches, and named when replaced,
            # since a re-pull overwrites whatever the copy was edited to (#3566)
            val prior:    *CopyEntry = inventory_find(?existing, entry.rel);
            var replaced: bool       = false;
            if (prior != nil && !prior.directory) {
                val held_r: res[Vector[u8], fs.FsError] = fs.read_bytes(alloc, to);
                if (sel held_r.err) { ret err[outcome.Fail].err{outcome.user(outcome.fs_text(held_r.err))}; }
                var held: Vector[u8] = held_r.ok;
                val same: bool       = bytes_equal(?held, ?bytes);
                vector.dnit[u8](?held);
                if (same && prior.mode == entry.mode) {
                    i = i + 1;
                    cnt;
                }
                replaced = !same;
            }
            val written: err[fs.FsError] = fs.write_bytes(to, bytes.data, bytes.len, entry.mode);
            if (sel written.err) { ret err[outcome.Fail].err{outcome.user(outcome.fs_text(written.err))}; }
            if (replaced)        { print.eprintlnf("note: path dependency '{}': replaced '{}' with its source's content", dst, entry.rel); }
        }
        i = i + 1;
    }
    complete = true;
    ret err[outcome.Fail].ok{};
}

pub fun realize_path_dependency(s: *session.Session, root: str, id: str, src_dir: str,
    mode: u8) err[outcome.Fail] {
    val id_r: err[outcome.Fail] = verify_dep_manifest_id(s, src_dir, id);
    if (sel id_r.err) { ret err[outcome.Fail].err{id_r.err}; }
    val dep_full_r: res[str, outcome.Fail] = dep_full_of(s.build_alloc, root, id);
    if (sel dep_full_r.err) { ret err[outcome.Fail].err{dep_full_r.err}; }
    val dep_full: str = dep_full_r.ok;
    fin { str_free(s.build_alloc, dep_full); }
    ret copy_tree(s.build_alloc, src_dir, dep_full);
}

# a dependency slot is a directory under dep/ named by a valid project id
pub fun realized_ids(alloc: *A.Allocator, root: str) res[Vector[str], outcome.Fail] {
    val dep_root_r: res[str, fail.Fail] = load.join_path(alloc, root, REALIZE_DEP_DIR);
    if (sel dep_root_r.err) { ret res[Vector[str], outcome.Fail].err{outcome.from_fail(dep_root_r.err)}; }
    val dep_root: str = dep_root_r.ok;
    fin { str_free(alloc, dep_root); }
    val is_dir_r: res[bool, io_error.Error] = fs.is_dir(dep_root);
    if (!(sel is_dir_r.ok && is_dir_r.ok)) { ret res[Vector[str], outcome.Fail].ok{vector.init[str](alloc)}; }
    val names_r: res[Vector[str], fs.FsError] = fs.read_dir(alloc, dep_root);
    if (sel names_r.err) { ret res[Vector[str], outcome.Fail].err{outcome.user(outcome.fs_text(names_r.err))}; }
    var names: Vector[str] = names_r.ok;
    val total: usize       = names.len;
    var kept:  usize       = 0;
    var i:     usize       = 0;
    for (i < total) {
        val name: str  = names.data[i];
        var slot: bool = manifest.is_valid_id(name);
        if (slot) {
            val full_r: res[str, fail.Fail] = load.join_path(alloc, dep_root, name);
            if (sel full_r.err) {
                names.len = kept;
                for (i < total) {
                    str_free(alloc, names.data[i]);
                    i = i + 1;
                }
                free_name_vector(alloc, ?names);
                ret res[Vector[str], outcome.Fail].err{outcome.from_fail(full_r.err)};
            }
            val entry_r: res[bool, io_error.Error] = fs.is_dir(full_r.ok);
            str_free(alloc, full_r.ok);
            slot = (sel entry_r.ok && entry_r.ok);
        }
        if (slot) {
            names.data[kept] = name;
            kept             = kept + 1;
        }
        or { str_free(alloc, name); }
        i = i + 1;
    }
    names.len = kept;
    sort.sort[str](names.data, names.len, cmp_dep_name);
    ret res[Vector[str], outcome.Fail].ok{names};
}

pub fun fetch_and_checkout(s: *session.Session, dep_full: str, ref: str) err[outcome.Fail] {
    val own: err[outcome.Fail] = require_own_work_tree(s, dep_full);
    if (sel own.err) { ret err[outcome.Fail].err{own.err}; }
    var gi: GitInspector      = GitInspector{program: nil};
    val er: err[outcome.Fail] = git_inspector_require(s.build_alloc, ?gi);
    if (sel er.err) { ret err[outcome.Fail].err{er.err}; }
    var fetch_args: [3]str;
    fetch_args[0] = "fetch";
    fetch_args[1] = "--all";
    fetch_args[2] = "--tags";
    val f: res[str, outcome.Fail] = git_op(s.build_alloc, ?gi, dep_full, ?fetch_args[0], 3, nil);
    if (sel f.err) {
        git_inspector_dnit(s.build_alloc, ?gi);
        ret err[outcome.Fail].err{f.err};
    }
    str_free(s.build_alloc, f.ok);
    val r: err[outcome.Fail] = realize_selector_ref(s.build_alloc, ?gi, dep_full, ref, nil);
    git_inspector_dnit(s.build_alloc, ?gi);
    if (sel r.err) { print.eprintlnf("note: fetched {}; selector checkout failed; fetched objects and existing checkout retained", dep_full); }
    ret r;
}

# whether a moved checkout of dep/<id> is to be staged: always in a repository
# root, where the gitlink is the pin, and in a subproject exactly when the
# enclosing repository already records a gitlink for it (#3686)
pub fun gitlink_recorded(s: *session.Session, root: str, id: str, mode: u8) res[bool, outcome.Fail] {
    if (mode == REALIZE_REPO_ROOT) { ret res[bool, outcome.Fail].ok{true}; }
    val observed: res[GitSlot, outcome.Fail] = observe_git_slot(s, root, id, mode);
    if (sel observed.err) { ret res[bool, outcome.Fail].err{observed.err}; }
    var slot: GitSlot = observed.ok;
    fin { git_slot_dnit(s.build_alloc, ?slot); }
    val pinned: opt[str] = slot.gitlink;
    ret res[bool, outcome.Fail].ok{sel pinned.some};
}

pub fun stage_dependency(s: *session.Session, root: str, id: str) err[outcome.Fail] {
    val rel_r: res[str, outcome.Fail] = dep_rel_of(s.build_alloc, id);
    if (sel rel_r.err) { ret err[outcome.Fail].err{rel_r.err}; }
    val rel: str               = rel_r.ok;
    var gi:  GitInspector      = GitInspector{program: nil};
    val er:  err[outcome.Fail] = git_inspector_require(s.build_alloc, ?gi);
    if (sel er.err) {
        str_free(s.build_alloc, rel);
        ret er;
    }
    var args: [3]str                 = [3]str{"add", "--", rel};
    val r:    res[str, outcome.Fail] = git_op(s.build_alloc, ?gi, root, ?args[0], 3, nil);
    git_inspector_dnit(s.build_alloc, ?gi);
    str_free(s.build_alloc, rel);
    if (sel r.err) { ret err[outcome.Fail].err{r.err}; }
    str_free(s.build_alloc, r.ok);
    ret err[outcome.Fail].ok{};
}

fun t_floor_is(a: *A.Allocator, running: str, want: str) bool {
    val got: res[str, format.FormatError] = mach_range_floor(a, running);
    if (sel got.err) { ret false; }
    val same: bool = str_equals(got.ok, want);
    str_free(a, got.ok);
    ret same;
}

# the suggested compiler range is the key's floor within its major, and `^N.0` past it (#3572)
test "mach.lang.driver.deps.mach_range_floor:depends_only_on_the_running_major" {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err)                    { ret 1; }
    if (!t_floor_is(?a, "5.3.0", "^5.3"))  { ret 2; }
    if (!t_floor_is(?a, "5.4.0", "^5.3"))  { ret 3; }
    if (!t_floor_is(?a, "5.99.1", "^5.3")) { ret 4; }
    if (!t_floor_is(?a, "6.0.0", "^6.0"))  { ret 5; }
    if (!t_floor_is(?a, "7.2.3", "^7.0"))  { ret 6; }
    ret 0;
}

fun t_scratch_dir(alloc: *A.Allocator, prefix: str) res[str, outcome.Fail] {
    val tf_r: res[fs.TempFile, fs.FsError] = fs.temp_create(alloc, prefix);
    if (sel tf_r.err) { ret res[str, outcome.Fail].err{outcome.user(outcome.fs_text(tf_r.err))}; }
    var tf:     fs.TempFile               = tf_r.ok;
    val root_r: res[str, string.StrError] = str_copy_slice(alloc, fs.temp_path(?tf), 0, str_len(fs.temp_path(?tf)));
    fs.temp_close_and_remove(?tf);
    if (sel root_r.err) { ret res[str, outcome.Fail].err{outcome.user(outcome.str_text(root_r.err))}; }
    val root:         str                 = root_r.ok;
    val create_dir_r: err[io_error.Error] = fs.create_dir(root, 0o755);
    if (sel create_dir_r.err) { ret res[str, outcome.Fail].err{outcome.user("cannot create scratch root")}; }
    ret res[str, outcome.Fail].ok{root};
}

fun t_write_file(alloc: *A.Allocator, dir: str, leaf: str, content: str) err[outcome.Fail] {
    val path_r: res[str, A.Error] = path.join(alloc, dir, leaf);
    if (sel path_r.err) { ret err[outcome.Fail].err{outcome.refused(path_r.err)}; }
    val p: str             = path_r.ok;
    val w: err[fs.FsError] = fs.write_bytes(p, content::*u8, str_len(content), 420);
    str_free(alloc, p);
    if (sel w.err) { ret err[outcome.Fail].err{outcome.user(outcome.fs_text(w.err))}; }
    ret err[outcome.Fail].ok{};
}

fun t_make_fixture_repo(alloc: *A.Allocator, gi: *GitInspector, project_id: str) res[str, outcome.Fail] {
    val dir_r: res[str, outcome.Fail] = t_scratch_dir(alloc, "mach_dep_fixture");
    if (sel dir_r.err) { ret res[str, outcome.Fail].err{dir_r.err}; }
    val dir: str = dir_r.ok;

    var init_args: [3]str;
    init_args[0] = "init";
    init_args[1] = "-b";
    init_args[2] = "main";
    val init_r: res[str, outcome.Fail] = git_op(alloc, gi, dir, ?init_args[0], 3, nil);
    if (sel init_r.err) { ret res[str, outcome.Fail].err{init_r.err}; }
    str_free(alloc, init_r.ok);

    val toml_r: res[str, format.FormatError] = format.sprint(alloc,
        "[project]\nid = \"{}\"\nversion = \"0.1.0\"\nsrc = \"src\"\nout = \"out\"\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n", project_id);
    if (sel toml_r.err) { ret res[str, outcome.Fail].err{outcome.user(outcome.format_text(toml_r.err))}; }
    val toml_text: str               = toml_r.ok;
    val wr:        err[outcome.Fail] = t_write_file(alloc, dir, "mach.toml", toml_text);
    str_free(alloc, toml_text);
    if (sel wr.err) { ret res[str, outcome.Fail].err{wr.err}; }

    var add_args: [2]str;
    add_args[0] = "add";
    add_args[1] = "-A";
    val add_r: res[str, outcome.Fail] = git_op(alloc, gi, dir, ?add_args[0], 2, nil);
    if (sel add_r.err) { ret res[str, outcome.Fail].err{add_r.err}; }
    str_free(alloc, add_r.ok);

    var commit_args: [7]str;
    commit_args[0] = "-c";
    commit_args[1] = "user.email=t@t";
    commit_args[2] = "-c";
    commit_args[3] = "user.name=t";
    commit_args[4] = "commit";
    commit_args[5] = "-m";
    commit_args[6] = "init";
    val commit_r: res[str, outcome.Fail] = git_op(alloc, gi, dir, ?commit_args[0], 7, nil);
    if (sel commit_r.err) { ret res[str, outcome.Fail].err{commit_r.err}; }
    str_free(alloc, commit_r.ok);

    ret res[str, outcome.Fail].ok{dir};
}

fun t_mode_is(s: *session.Session, gi: *GitInspector, dir: str, rel: str, want: str) bool {
    val r: res[str, outcome.Fail] = git_path_mode(s, gi, "fixture", dir, "", rel);
    if (sel r.err) { ret false; }
    val same: bool = str_equals(r.ok, want);
    str_free(s.build_alloc, r.ok);
    ret same;
}

fun t_write_ok(alloc: *A.Allocator, dir: str, leaf: str, content: str) bool {
    val w: err[outcome.Fail] = t_write_file(alloc, dir, leaf, content);
    ret sel w.ok;
}

fun t_commit_all(alloc: *A.Allocator, gi: *GitInspector, dir: str, message: str) bool {
    var add_args: [2]str;
    add_args[0] = "add";
    add_args[1] = "-A";
    val add_r: res[str, outcome.Fail] = git_op(alloc, gi, dir, ?add_args[0], 2, nil);
    if (sel add_r.err) { ret false; }
    str_free(alloc, add_r.ok);
    var commit_args: [7]str;
    commit_args[0] = "-c";
    commit_args[1] = "user.email=t@t";
    commit_args[2] = "-c";
    commit_args[3] = "user.name=t";
    commit_args[4] = "commit";
    commit_args[5] = "-m";
    commit_args[6] = message;
    val commit_r: res[str, outcome.Fail] = git_op(alloc, gi, dir, ?commit_args[0], 7, nil);
    if (sel commit_r.err) { ret false; }
    str_free(alloc, commit_r.ok);
    ret true;
}

# one listing answers every path, in git's tree order and not only in plain byte order,
# and a command that moves HEAD re-lists (#3471)
test "mach.lang.driver.deps.git_path_mode:one_listing_per_checkout_until_head_moves" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    val gi_r: res[GitInspector, outcome.Fail] = git_inspector_init(?alloc);
    if (sel gi_r.err) { ret 2; }
    var gi: GitInspector = gi_r.ok;
    fin { git_inspector_dnit(?alloc, ?gi); }
    val fixture_r: res[str, outcome.Fail] = t_make_fixture_repo(?alloc, ?gi, "tree");
    if (sel fixture_r.err) { ret 3; }
    val dir: str = fixture_r.ok;
    fin {
        fs.remove_all(?alloc, dir);
        str_free(?alloc, dir);
    }
    val a_r: res[str, A.Error] = path.join(?alloc, dir, "a");
    if (sel a_r.err) { ret 4; }
    val made: err[fs.FsError] = fs.create_dir_all(?alloc, a_r.ok, 0o755);
    str_free(?alloc, a_r.ok);
    if (sel made.err)                               { ret 4; }
    if (!t_write_ok(?alloc, dir, "a/inner", "x\n")) { ret 5; }
    if (!t_write_ok(?alloc, dir, "a-b", "x\n"))     { ret 5; }
    if (!t_write_ok(?alloc, dir, "a.x", "x\n"))     { ret 5; }
    if (!t_commit_all(?alloc, ?gi, dir, "tree"))    { ret 6; }

    if (!t_mode_is(?s, ?gi, dir, "a", "040000"))         { ret 7; }
    if (!t_mode_is(?s, ?gi, dir, "a/", "040000"))        { ret 8; }
    if (!t_mode_is(?s, ?gi, dir, "a/inner", "100644"))   { ret 9; }
    if (!t_mode_is(?s, ?gi, dir, "a-b", "100644"))       { ret 10; }
    if (!t_mode_is(?s, ?gi, dir, "a.x", "100644"))       { ret 11; }
    if (!t_mode_is(?s, ?gi, dir, "mach.toml", "100644")) { ret 12; }
    if (!t_mode_is(?s, ?gi, dir, "missing", ""))         { ret 13; }
    if (!gi.trees_ready || gi.trees.len != 1)            { ret 14; }

    # a lookup answered from the listing spawns nothing: an unrunnable git proves it
    val program: str = gi.program;
    gi.program = "/nonexistent/mach-test-git";
    val cached: bool = t_mode_is(?s, ?gi, dir, "a.x", "100644");
    gi.program = program;
    if (!cached) { ret 15; }

    # a new commit moves HEAD, so the listing must not answer for the old tree
    if (!t_write_ok(?alloc, dir, "later", "x\n"))    { ret 16; }
    if (!t_commit_all(?alloc, ?gi, dir, "later"))    { ret 17; }
    if (gi.trees_ready)                              { ret 18; }
    if (!t_mode_is(?s, ?gi, dir, "later", "100644")) { ret 19; }
    ret 0;
}

fun t_env_allow_file_protocol(env: **u8) {
    env[0] = "GIT_CONFIG_COUNT=1";
    env[1] = "GIT_CONFIG_KEY_0=protocol.file.allow";
    env[2] = "GIT_CONFIG_VALUE_0=always";
    env[3] = nil;
}

test "mach.lang.driver.deps.realize_git_dependency:succeeds_and_stages_gitlink" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val gi_r: res[GitInspector, outcome.Fail] = git_inspector_init(?alloc);
    if (sel gi_r.err) { ret 1; }
    var gi: GitInspector = gi_r.ok;

    val fixture_r: res[str, outcome.Fail] = t_make_fixture_repo(?alloc, ?gi, "std");
    if (sel fixture_r.err) {
        git_inspector_dnit(?alloc, ?gi);
        ret 1;
    }
    val fixture: str = fixture_r.ok;

    val root_r: res[str, outcome.Fail] = t_scratch_dir(?alloc, "mach_dep_realize_root");
    if (sel root_r.err) {
        git_inspector_dnit(?alloc, ?gi);
        ret 1;
    }
    val root: str = root_r.ok;

    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) {
        git_inspector_dnit(?alloc, ?gi);
        ret 1;
    }
    var s: session.Session = sr.ok;

    val initialize_repository_r: err[outcome.Fail] = initialize_repository(?s, root);
    if (sel initialize_repository_r.err) { ret 1; }
    var env: [4]*u8;
    t_env_allow_file_protocol(?env[0]);
    val real_r: res[u8, outcome.Fail] = realize_git_dependency_env(?s, root, "std", fixture, "branch/main", REALIZE_REPO_ROOT, false, ?env[0]);
    var bad:    i32                   = 0;
    if (sel real_r.err) { bad = 1; }

    if (bad == 0) {
        val dep_full_r: res[str, A.Error] = path.join(?alloc, root, "dep/std");
        if (sel dep_full_r.err) { ret 99; }
        val dep_full: str                       = dep_full_r.ok;
        val is_dir_r: res[bool, io_error.Error] = fs.is_dir(dep_full);
        if (sel is_dir_r.err)                  { ret 99; }
        if (!(sel is_dir_r.ok && is_dir_r.ok)) { bad = 1; }
        val dep_toml_r: res[str, A.Error] = path.join(?alloc, dep_full, "mach.toml");
        if (sel dep_toml_r.err) { ret 99; }
        val dep_toml: str                       = dep_toml_r.ok;
        val exists_r: res[bool, io_error.Error] = fs.exists(dep_toml);
        if (sel exists_r.err)                  { ret 99; }
        if (!(sel exists_r.ok && exists_r.ok)) { bad = 1; }
        str_free(?alloc, dep_toml);
        str_free(?alloc, dep_full);

        var link_args: [4]str;
        link_args[0] = "ls-files";
        link_args[1] = "--stage";
        link_args[2] = "--";
        link_args[3] = "dep/std";
        val link_r: res[str, outcome.Fail] = git_query(?alloc, ?gi, root, ?link_args[0], 4);
        if (sel link_r.err) { bad = 1; }
        if (sel link_r.ok) {
            val link: str = link_r.ok;
            if (!str_starts_with(link, "160000")) { bad = 1; }
            str_free(?alloc, link);
        }

        var gm_args: [4]str;
        gm_args[0] = "ls-files";
        gm_args[1] = "--stage";
        gm_args[2] = "--";
        gm_args[3] = ".gitmodules";
        val gm_r: res[str, outcome.Fail] = git_query(?alloc, ?gi, root, ?gm_args[0], 4);
        if (sel gm_r.err) { bad = 1; }
        if (sel gm_r.ok) {
            val gm: str = gm_r.ok;
            if (str_empty(gm)) { bad = 1; }
            str_free(?alloc, gm);
        }
    }

    session.dnit(?s);
    fs.remove_all(?alloc, root);
    fs.remove_all(?alloc, fixture);
    str_free(?alloc, root);
    str_free(?alloc, fixture);
    git_inspector_dnit(?alloc, ?gi);
    ret bad;
}

# realizing a fixture whose id differs from its key is refused after checkout,
# naming the one-name rule
test "mach.lang.driver.deps.realize_git_dependency:alias_key_is_refused_after_checkout" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val gi_r: res[GitInspector, outcome.Fail] = git_inspector_init(?alloc);
    if (sel gi_r.err) { ret 1; }
    var gi: GitInspector = gi_r.ok;

    val fixture_r: res[str, outcome.Fail] = t_make_fixture_repo(?alloc, ?gi, "other");
    if (sel fixture_r.err) {
        git_inspector_dnit(?alloc, ?gi);
        ret 1;
    }
    val fixture: str = fixture_r.ok;

    val root_r: res[str, outcome.Fail] = t_scratch_dir(?alloc, "mach_dep_mismatch_root");
    if (sel root_r.err) {
        git_inspector_dnit(?alloc, ?gi);
        ret 1;
    }
    val root: str = root_r.ok;

    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) {
        git_inspector_dnit(?alloc, ?gi);
        ret 1;
    }
    var s: session.Session = sr.ok;

    val initialize_repository_r: err[outcome.Fail] = initialize_repository(?s, root);
    if (sel initialize_repository_r.err) { ret 1; }
    var env: [4]*u8;
    t_env_allow_file_protocol(?env[0]);
    val real_r: res[u8, outcome.Fail] = realize_git_dependency_env(?s, root, "std", fixture, "branch/main", REALIZE_REPO_ROOT, false, ?env[0]);
    var bad:    i32                   = 0;
    if (sel real_r.ok) { bad = 1; }
    if (sel real_r.err) {
        val text: str = outcome.describe(real_r.err);
        if (!str_contains(text, "[dep.std] realizes project 'other': the manifest key, the directory under dep/, and the project id are one name")) { bad = 2; }
        if (!str_contains(text, "rename the table to [dep.other] and the directory to dep/other"))                                                  { bad = 3; }
    }

    # the checkout is retained for the user to rename, and its manifest still says `other`
    val dep_full_r: res[str, A.Error] = path.join(?alloc, root, "dep/std");
    if (sel dep_full_r.err) { ret 99; }
    val dep_full:   str                    = dep_full_r.ok;
    val declared_r: res[str, outcome.Fail] = declared_dep_id(?s, dep_full);
    if (sel declared_r.err)                                         { ret 99; }
    if (!(sel declared_r.ok && str_equals(declared_r.ok, "other"))) { bad = 4; }
    str_free(?alloc, dep_full);

    val check_dep_identity_r: err[outcome.Fail] = check_dep_identity(?s, "std", "std");
    if (sel check_dep_identity_r.err) { bad = 5; }
    val check_dep_identity_r2: err[outcome.Fail] = check_dep_identity(?s, "mach-std", "std");
    if (sel check_dep_identity_r2.ok) { bad = 6; }

    session.dnit(?s);
    fs.remove_all(?alloc, root);
    fs.remove_all(?alloc, fixture);
    str_free(?alloc, root);
    str_free(?alloc, fixture);
    git_inspector_dnit(?alloc, ?gi);
    ret bad;
}

test "mach.lang.driver.deps.realize_git_dependency:failing_clone_leaves_scaffold_intact_and_dep_clean" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val gi_r: res[GitInspector, outcome.Fail] = git_inspector_init(?alloc);
    if (sel gi_r.err) { ret 1; }
    var gi: GitInspector = gi_r.ok;

    val root_r: res[str, outcome.Fail] = t_scratch_dir(?alloc, "mach_dep_failclone_root");
    if (sel root_r.err) {
        git_inspector_dnit(?alloc, ?gi);
        ret 1;
    }
    val root: str = root_r.ok;

    val scaffold_text: str               = "[project]\nid = \"proj\"\nversion = \"0.1.0\"\nsrc = \"src\"\nout = \"out\"\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n";
    val write_err:     err[outcome.Fail] = t_write_file(?alloc, root, "mach.toml", scaffold_text);
    var bad:           i32               = 0;
    if (sel write_err.err) { bad = 1; }

    val bogus_r: res[str, A.Error] = path.join(?alloc, root, "does-not-exist");
    if (sel bogus_r.err) { ret 99; }
    val bogus: str = bogus_r.ok;

    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) {
        git_inspector_dnit(?alloc, ?gi);
        ret 1;
    }
    var s: session.Session = sr.ok;

    val initialize_repository_r: err[outcome.Fail] = initialize_repository(?s, root);
    if (sel initialize_repository_r.err) { ret 1; }
    var env: [4]*u8;
    t_env_allow_file_protocol(?env[0]);
    val real_r: res[u8, outcome.Fail] = realize_git_dependency_env(?s, root, "std", bogus, "branch/main", REALIZE_REPO_ROOT, false, ?env[0]);
    if (sel real_r.ok) { bad = 1; }
    if (sel real_r.err) {
        val text: str = outcome.describe(real_r.err);
        if (!str_starts_with(text, "`git submodule add ")) { bad = 2; }
        if (!str_contains(text, "` exited with status "))  { bad = 3; }
        # git's output order varies by platform, so only its presence is asserted
        if (!str_contains(text, "fatal: ")) { bad = 4; }
    }

    val dep_full_r: res[str, A.Error] = path.join(?alloc, root, "dep/std");
    if (sel dep_full_r.err) { ret 99; }
    val dep_full: str                       = dep_full_r.ok;
    val exists_r: res[bool, io_error.Error] = fs.exists(dep_full);
    if (sel exists_r.err)                 { ret 99; }
    if ((sel exists_r.ok && exists_r.ok)) { bad = 1; }
    str_free(?alloc, dep_full);

    val manifest_path_r: res[str, A.Error] = path.join(?alloc, root, "mach.toml");
    if (sel manifest_path_r.err) { ret 99; }
    val manifest_path: str                         = manifest_path_r.ok;
    val read_r:        res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, manifest_path);
    if (sel read_r.err) { bad = 1; }
    if (sel read_r.ok) {
        var v: Vector[u8] = read_r.ok;
        if (v.len != str_len(scaffold_text)) { bad = 1; }
        vector.dnit[u8](?v);
    }
    str_free(?alloc, manifest_path);

    session.dnit(?s);
    fs.remove_all(?alloc, root);
    str_free(?alloc, root);
    str_free(?alloc, bogus);
    git_inspector_dnit(?alloc, ?gi);
    ret bad;
}

test "mach.lang.driver.deps.git_failure:names_the_command_status_and_gits_output" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val gi_r: res[GitInspector, outcome.Fail] = git_inspector_init(?alloc);
    if (sel gi_r.err) { ret 1; }
    var gi:    GitInspector           = gi_r.ok;
    val dir_r: res[str, outcome.Fail] = t_scratch_dir(?alloc, "mach_dep_git_failure");
    if (sel dir_r.err) {
        git_inspector_dnit(?alloc, ?gi);
        ret 1;
    }
    val dir: str = dir_r.ok;
    var bad: i32 = 0;

    var args:   [3]str                 = [3]str{"rev-parse", "--verify", "HEAD"};
    val merged: res[str, outcome.Fail] = git_query(?alloc, ?gi, dir, ?args[0], 3);
    if (sel merged.ok) { bad = 2; }
    if (sel merged.err) {
        val text: str = outcome.describe(merged.err);
        if (!str_starts_with(text, "`git rev-parse --verify HEAD` exited with status 128: ")) { bad = 3; }
        if (!str_contains(text, "not a git repository"))                                      { bad = 4; }
        if (str_contains(text, "\n\n"))                                                       { bad = 5; }
    }

    # a command whose stderr is not captured still names itself and its status
    val quiet: res[GitBytes, outcome.Fail] = git_query_capture(?alloc, ?gi, dir, ?args[0], 3, true, nil, os.INVALID_HANDLE, false);
    if (sel quiet.ok) { bad = 6; }
    if (sel quiet.err) {
        if (!str_equals(outcome.describe(quiet.err), "`git rev-parse --verify HEAD` exited with status 128")) { bad = 7; }
    }

    fs.remove_all(?alloc, dir);
    str_free(?alloc, dir);
    git_inspector_dnit(?alloc, ?gi);
    ret bad;
}

fun t_mkdirs(alloc: *A.Allocator, base: str, rel: str) res[str, outcome.Fail] {
    val p_r: res[str, A.Error] = path.join(alloc, base, rel);
    if (sel p_r.err) { ret res[str, outcome.Fail].err{outcome.refused(p_r.err)}; }
    val p:                str             = p_r.ok;
    val create_dir_all_r: err[fs.FsError] = fs.create_dir_all(alloc, p, 0o755);
    if (sel create_dir_all_r.err) {
        str_free(alloc, p);
        ret res[str, outcome.Fail].err{outcome.user("cannot create directory")};
    }
    ret res[str, outcome.Fail].ok{p};
}

test "mach.lang.driver.deps.project_root_authority:repo_root_nested_and_absent" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val gi_r: res[GitInspector, outcome.Fail] = git_inspector_init(?alloc);
    if (sel gi_r.err) { ret 1; }
    var gi: GitInspector = gi_r.ok;

    val outer_r: res[str, outcome.Fail] = t_make_fixture_repo(?alloc, ?gi, "outer");
    if (sel outer_r.err) {
        git_inspector_dnit(?alloc, ?gi);
        ret 1;
    }
    val outer: str = outer_r.ok;

    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) {
        git_inspector_dnit(?alloc, ?gi);
        ret 1;
    }
    var s: session.Session = sr.ok;

    var bad: i32 = 0;

    val top_r: res[u8, outcome.Fail] = project_root_authority(?s, ?gi, "x", outer);
    if (sel top_r.err)                                     { ret 99; }
    if (!(sel top_r.ok && top_r.ok == DEP_AUTHORITY_REPO)) { bad = 1; }

    val sub_r: res[str, outcome.Fail] = t_mkdirs(?alloc, outer, "cases/one");
    if (sel sub_r.err) { bad = 1; }
    if (sel sub_r.ok) {
        val sub:      str                   = sub_r.ok;
        val nested_r: res[u8, outcome.Fail] = project_root_authority(?s, ?gi, "x", sub);
        if (sel nested_r.err)                                          { ret 99; }
        if (!(sel nested_r.ok && nested_r.ok == DEP_AUTHORITY_NESTED)) { bad = 1; }
        str_free(?alloc, sub);
    }

    val bare_r: res[str, outcome.Fail] = t_scratch_dir(?alloc, "mach_dep_no_repo");
    if (sel bare_r.err) { bad = 1; }
    if (sel bare_r.ok) {
        val bare:     str                   = bare_r.ok;
        val absent_r: res[u8, outcome.Fail] = project_root_authority(?s, ?gi, "x", bare);
        if (sel absent_r.err)                                          { ret 99; }
        if (!(sel absent_r.ok && absent_r.ok == DEP_AUTHORITY_NESTED)) { bad = 1; }
        fs.remove_all(?alloc, bare);
        str_free(?alloc, bare);
    }

    session.dnit(?s);
    fs.remove_all(?alloc, outer);
    str_free(?alloc, outer);
    git_inspector_dnit(?alloc, ?gi);
    ret bad;
}

test "mach.lang.driver.deps.realized_content:nested_project_verifies_checkout" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val gi_r: res[GitInspector, outcome.Fail] = git_inspector_init(?alloc);
    if (sel gi_r.err) { ret 1; }
    var gi: GitInspector = gi_r.ok;

    val fixture_r: res[str, outcome.Fail] = t_make_fixture_repo(?alloc, ?gi, "std");
    if (sel fixture_r.err) {
        git_inspector_dnit(?alloc, ?gi);
        ret 1;
    }
    val fixture: str = fixture_r.ok;

    val outer_r: res[str, outcome.Fail] = t_make_fixture_repo(?alloc, ?gi, "outer");
    if (sel outer_r.err) {
        git_inspector_dnit(?alloc, ?gi);
        ret 1;
    }
    val outer: str = outer_r.ok;

    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) {
        git_inspector_dnit(?alloc, ?gi);
        ret 1;
    }
    var s: session.Session = sr.ok;

    var bad:    i32                    = 0;
    val proj_r: res[str, outcome.Fail] = t_mkdirs(?alloc, outer, "cases/one");
    if (sel proj_r.err) { ret 99; }
    if (bad == 0) {
        val proj:     str                    = proj_r.ok;
        val depdir_r: res[str, outcome.Fail] = t_mkdirs(?alloc, proj, "dep");
        if (sel depdir_r.err) { bad = 1; }
        if (sel depdir_r.ok) {
            val depdir:     str = depdir_r.ok;
            var clone_args: [3]str;
            clone_args[0] = "clone";
            clone_args[1] = fixture;
            clone_args[2] = "std";
            var env: [4]*u8;
            t_env_allow_file_protocol(?env[0]);
            val clone_r: res[str, outcome.Fail] = git_op(?alloc, ?gi, depdir, ?clone_args[0], 3, ?env[0]);
            if (sel clone_r.err) { bad = 1; }
            if (sel clone_r.ok)  { str_free(?alloc, clone_r.ok); }
            str_free(?alloc, depdir);
        }

        if (bad == 0) {
            var d: manifest.DepDef;
            d.path    = intern.STR_NIL;
            d.version = intern.STR_NIL;
            val nr: res[intern.StrId, A.Error] = intern.intern(?s.interner, "std");
            val ur: res[intern.StrId, A.Error] = intern.intern(?s.interner, fixture);
            val rr: res[intern.StrId, A.Error] = intern.intern(?s.interner, "branch/main");
            if (sel nr.err) { ret 99; }
            if (sel ur.err) { ret 99; }
            if (sel rr.ok) {
                d.name = nr.ok;
                d.git  = ur.ok;
                d.ref  = rr.ok;
                val dep_full_r: res[str, A.Error] = path.join(?alloc, proj, "dep/std");
                if (sel dep_full_r.err) { ret 99; }
                val dep_full:  str                             = dep_full_r.ok;
                var gi2:       GitInspector                    = GitInspector{program: nil};
                val content_r: res[intern.StrId, outcome.Fail] = realized_content(?s, ?gi2, "std", proj, dep_full, "dep", ?d);
                git_inspector_dnit(?alloc, ?gi2);
                if (sel content_r.err) { bad = 1; }
                if (sel content_r.ok) {
                    val text_o: opt[str] = intern.lookup(?s.interner, content_r.ok);
                    if (sel text_o.none)                       { ret 99; }
                    if (!str_starts_with(text_o.some, "git/")) { bad = 1; }
                }
                str_free(?alloc, dep_full);
            }
        }
        str_free(?alloc, proj);
    }

    session.dnit(?s);
    fs.remove_all(?alloc, outer);
    fs.remove_all(?alloc, fixture);
    str_free(?alloc, outer);
    str_free(?alloc, fixture);
    git_inspector_dnit(?alloc, ?gi);
    ret bad;
}

fun git_test_inheritance(alloc: *A.Allocator, entry: *u8, override: bool, expected: bool) bool {
    val result: res[bool, outcome.Fail] = git_inherits_env(alloc, entry, override);
    ret sel result.ok && result.ok == expected;
}

test "mach.lang.driver.deps.git_environment:configuration_survives_repository_redirection_does_not" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err)                                                                       { ret 20; }
    if (!git_test_inheritance(?alloc, "HOME=/checkout-owner", false, true))                   { ret 1; }
    if (!git_test_inheritance(?alloc, "XDG_CONFIG_HOME=/checkout-config", false, true))       { ret 2; }
    if (!git_test_inheritance(?alloc, "GIT_CONFIG_GLOBAL=/checkout-config/git", false, true)) { ret 3; }
    if (!git_test_inheritance(?alloc, "GIT_CONFIG_SYSTEM=/system-config/git", false, true))   { ret 4; }
    if (!git_test_inheritance(?alloc, "GIT_CONFIG_NOSYSTEM=1", false, true))                  { ret 5; }
    if (!git_test_inheritance(?alloc, "GIT_CONFIG_COUNT=1", false, true))                     { ret 6; }
    if (!git_test_inheritance(?alloc, "GIT_CONFIG_COUNT=1", true, false))                     { ret 7; }
    if (!git_test_inheritance(?alloc, "GIT_CONFIG_KEY_0=core.autocrlf", true, false))         { ret 8; }
    if (!git_test_inheritance(?alloc, "GIT_CONFIG_VALUE_0=true", true, false))                { ret 9; }
    if (!git_test_inheritance(?alloc, "GIT_DIR=/another/repo", false, false))                 { ret 10; }
    if (!git_test_inheritance(?alloc, "GIT_WORK_TREE=/another/tree", false, false))           { ret 11; }
    if (!git_test_inheritance(?alloc, "GIT_INDEX_FILE=/another/index", false, false))         { ret 12; }
    if (!git_test_inheritance(?alloc, "GIT_COMMON_DIR=/another/repo", false, false))          { ret 13; }
    if (!git_test_inheritance(?alloc, "GIT_OBJECT_DIRECTORY=/another/objects", false, false)) { ret 14; }
    if (!git_test_inheritance(?alloc, "GIT_OPTIONAL_LOCKS=1", false, false))                  { ret 15; }
    if (!git_test_inheritance(?alloc, "GIT_TERMINAL_PROMPT=1", false, false))                 { ret 16; }
    $if ($mach.build.os == $mach.os.windows) {
        if (!git_test_inheritance(?alloc, "git_dir=C:/another/repo", false, false)) { ret 17; }
        val ordinal: res[i32, env.EnvError] = env.compare_names("gıt", "GIT");
        if (sel ordinal.err) { ret 18; }
        val ordinary: bool = ordinal.ok != 0;
        if (!git_test_inheritance(?alloc, "gıt_dir=C:/another/repo", false, ordinary)) { ret 19; }
    }
    ret 0;
}

test "mach.lang.driver.deps.git_environment:inherited_configuration_keeps_first_native_name" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var inherited: [7]*u8 = [7]*u8{"GIT_CONFIG_COUNT=1", "GIT_CONFIG_COUNT=0",
        "GIT_CONFIG_KEY_0=mach.probe", "GIT_CONFIG_VALUE_0=first",
        "GIT_CONFIG_VALUE_0=ignored", "MACH_PROBE=inherited", nil};
    $if ($mach.build.os == $mach.os.windows) {
        inherited[1] = "git_config_count=0";
        inherited[2] = "git_config_key_0=mach.probe";
        inherited[3] = "git_config_value_0=first";
    }
    val result: res[child_env.Strings, outcome.Fail] = git_environment(?alloc, ?inherited[0], nil);
    if (sel result.err) { ret 2; }
    var strings: child_env.Strings = result.ok;
    fin { child_env.strings_free(?alloc, ?strings); }
    if (strings.count != 6)                                          { ret 3; }
    if (!str_equals(strings.items[0]::str, inherited[0]::str))       { ret 4; }
    if (!str_equals(strings.items[1]::str, inherited[2]::str))       { ret 5; }
    if (!str_equals(strings.items[2]::str, inherited[3]::str))       { ret 6; }
    if (!str_equals(strings.items[3]::str, "GIT_OPTIONAL_LOCKS=0"))  { ret 7; }
    if (!str_equals(strings.items[4]::str, "GIT_TERMINAL_PROMPT=0")) { ret 8; }
    if (!str_equals(strings.items[5]::str, "MACH_PROBE=inherited"))  { ret 9; }
    ret 0;
}

test "mach.lang.driver.deps.git_environment:clean_crlf_checkout_verifies_and_real_edit_is_refused" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val gi_r: res[GitInspector, outcome.Fail] = git_inspector_init(?alloc);
    if (sel gi_r.err) { ret 2; }
    var gi: GitInspector = gi_r.ok;
    fin { git_inspector_dnit(?alloc, ?gi); }
    val fixture_r: res[str, outcome.Fail] = t_make_fixture_repo(?alloc, ?gi, "std");
    if (sel fixture_r.err) { ret 3; }
    val fixture: str = fixture_r.ok;
    fin {
        fs.remove_all(?alloc, fixture);
        str_free(?alloc, fixture);
    }
    val root_r: res[str, outcome.Fail] = t_scratch_dir(?alloc, "mach_git_config");
    if (sel root_r.err) { ret 4; }
    val root: str = root_r.ok;
    fin {
        fs.remove_all(?alloc, root);
        str_free(?alloc, root);
    }
    val t_write_file_r: err[outcome.Fail] = t_write_file(?alloc, root, "global",
        "[core]\n\tautocrlf = true\n");
    if (sel t_write_file_r.err) { ret 5; }
    val config_r: res[str, format.FormatError] = format.sprint(?alloc, "GIT_CONFIG_GLOBAL={}/global", root);
    if (sel config_r.err) { ret 6; }
    val config: str = config_r.ok;
    fin { str_free(?alloc, config); }
    val ambient_n: usize              = count_nil_terminated(gi.inherited_env);
    val env_r:     res[**u8, A.Error] = A.allocate[*u8](?alloc, ambient_n + 7);
    if (sel env_r.err) { ret 7; }
    val inherited: **u8 = env_r.ok;
    fin { A.deallocate[*u8](?alloc, inherited, ambient_n + 7); }
    var count: usize = 0;
    var i:     usize = 0;
    for (i < ambient_n) {
        val reserved: res[bool, outcome.Fail] = git_env_prefix(?alloc, gi.inherited_env[i], "GIT_");
        if (sel reserved.err) { ret 41; }
        if (!reserved.ok) {
            inherited[count] = gi.inherited_env[i];
            count            = count + 1;
        }
        i = i + 1;
    }
    inherited[count]     = config::*u8;
    inherited[count + 1] = "GIT_CONFIG_NOSYSTEM=1";
    inherited[count + 2] = nil;
    var ordinary_args: [7]*u8;
    ordinary_args[0] = gi.program::*u8;
    ordinary_args[1] = "-C";
    ordinary_args[2] = root::*u8;
    ordinary_args[3] = "clone";
    ordinary_args[4] = fixture::*u8;
    ordinary_args[5] = "std";
    ordinary_args[6] = nil;
    val cloned: res[exec.ExitStatus, exec.Error] = exec.run(gi.program, ?ordinary_args[0], inherited);
    if (sel cloned.err) { ret 8; }
    val clone_status: exec.ExitStatus = cloned.ok;
    if (!exec.exited(clone_status) || exec.code(clone_status) != 0) { ret 8; }
    val clone_r: res[str, A.Error] = path.join(?alloc, root, "std");
    if (sel clone_r.err) { ret 9; }
    val clone: str = clone_r.ok;
    fin { str_free(?alloc, clone); }
    ordinary_args[2] = clone::*u8;
    ordinary_args[3] = "diff";
    ordinary_args[4] = "--exit-code";
    ordinary_args[5] = "--quiet";
    val ordinary_clean: res[exec.ExitStatus, exec.Error] = exec.run(gi.program, ?ordinary_args[0], inherited);
    if (sel ordinary_clean.err) { ret 22; }
    val ordinary_status: exec.ExitStatus = ordinary_clean.ok;
    if (!exec.exited(ordinary_status) || exec.code(ordinary_status) != 0) { ret 22; }
    val toml_r: res[str, A.Error] = path.join(?alloc, clone, "mach.toml");
    if (sel toml_r.err) { ret 10; }
    val toml_path: str = toml_r.ok;
    fin { str_free(?alloc, toml_path); }
    val text_r: res[str, fs.FsError] = fs.read_string(?alloc, toml_path);
    if (sel text_r.err) { ret 11; }
    val text: str = text_r.ok;
    fin { str_free(?alloc, text); }
    if (!str_contains(text, "\r\n")) { ret 12; }
    val t_write_file_r2: err[outcome.Fail] = t_write_file(?alloc, root, "global",
        "[core]\n\tautocrlf = true\n\tfsmonitor = missing-mach-test-monitor\n\tuntrackedCache = true\n");
    if (sel t_write_file_r2.err) { ret 23; }
    inherited[count + 2] = "GIT_DIR=/missing-mach-test-repository";
    inherited[count + 3] = "GIT_WORK_TREE=/missing-mach-test-worktree";
    inherited[count + 4] = "GIT_INDEX_FILE=/missing-mach-test-index";
    inherited[count + 5] = "MACH_ENV_PROBE=inherited";
    inherited[count + 6] = nil;
    gi.inherited_env     = inherited;
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 13; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var d: manifest.DepDef;
    d.version = intern.STR_NIL;
    d.ref     = project.intern_unwrap(?s.interner, "branch/main");
    val clean: res[intern.StrId, outcome.Fail] = verify_git_checkout(?s, ?gi, "std", root, clone, "dep", ?d, DEP_AUTHORITY_NESTED);
    if (sel clean.err) { ret 14; }
    var config_args: [3]str;
    config_args[0] = "config";
    config_args[1] = "--get";
    config_args[2] = "core.fsmonitor";
    val monitor_r: res[str, outcome.Fail] = git_query(?alloc, ?gi, clone, ?config_args[0], 3);
    if (sel monitor_r.err) { ret 18; }
    val monitor:          str  = monitor_r.ok;
    val monitor_disabled: bool = str_equals(monitor, "false");
    str_free(?alloc, monitor);
    if (!monitor_disabled) { ret 19; }
    config_args[2] = "core.untrackedCache";
    val cache_r: res[str, outcome.Fail] = git_query(?alloc, ?gi, clone, ?config_args[0], 3);
    if (sel cache_r.err) { ret 20; }
    val cache:          str  = cache_r.ok;
    val cache_disabled: bool = str_equals(cache, "false");
    str_free(?alloc, cache);
    if (!cache_disabled) { ret 21; }
    val t_write_file_r3: err[outcome.Fail] = t_write_file(?alloc, clone, "mach.toml", "edited\r\n");
    if (sel t_write_file_r3.err) { ret 15; }
    val dirty: res[intern.StrId, outcome.Fail] = verify_git_checkout(?s, ?gi, "std", root, clone, "dep", ?d, DEP_AUTHORITY_NESTED);
    if (sel dirty.ok) { ret 16; }
    val error: str  = outcome.describe(dirty.err);
    val named: bool = str_contains(error, "checkout is dirty:") && str_contains(error, "mach.toml");
    str_free(?alloc, error);
    if (!named) { ret 17; }
    val t_write_file_r4: err[outcome.Fail] = t_write_file(?alloc, root, "override", "[mach]\n\torigin = explicit\n");
    if (sel t_write_file_r4.err) { ret 24; }
    val override_r: res[str, format.FormatError] = format.sprint(?alloc, "GIT_CONFIG_GLOBAL={}/override", root);
    if (sel override_r.err) { ret 25; }
    val override: str = override_r.ok;
    fin { str_free(?alloc, override); }
    var extras: [9]*u8;
    extras[0] = override::*u8;
    extras[1] = "GIT_OPTIONAL_LOCKS=1";
    extras[2] = "GIT_TERMINAL_PROMPT=1";
    extras[3] = "GIT_DIR=/missing-mach-test-repository";
    extras[4] = "GIT_WORK_TREE=/missing-mach-test-worktree";
    extras[5] = "GIT_INDEX_FILE=/missing-mach-test-index";
    extras[6] = "MACH_ENV_PROBE=first";
    extras[7] = "MACH_ENV_PROBE=explicit";
    extras[8] = nil;
    var probe_args: [3]str;
    probe_args[0] = "-c";
    probe_args[1] = "alias.mach-env=!test \"$GIT_OPTIONAL_LOCKS\" = 0 && test \"$GIT_TERMINAL_PROMPT\" = 0 && test \"$MACH_ENV_PROBE\" = explicit && git config --get mach.origin";
    probe_args[2] = "mach-env";
    val probe_r: res[str, outcome.Fail] = git_op(?alloc, ?gi, clone, ?probe_args[0], 3, ?extras[0]);
    if (sel probe_r.err) { ret 26; }
    val probe:         str  = probe_r.ok;
    val override_seen: bool = str_equals(probe, "explicit");
    str_free(?alloc, probe);
    if (!override_seen) { ret 27; }
    ret 0;
}

fun t_symlink_rel_is(s: *session.Session, rel: str, target: str, expected: str) bool {
    val r: res[str, outcome.Fail] = symlink_target_rel(s, rel, target);
    if (sel r.err) { ret false; }
    val actual: str = r.ok;
    fin { str_free(s.build_alloc, actual); }
    ret str_equals(actual, expected);
}

test "mach.lang.driver.deps.symlink_target_rel:canonical_git_names_preserve_native_components" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    if (!t_symlink_rel_is(?s, "src/link", "lib.mach", "src/lib.mach"))           { ret 2; }
    if (!t_symlink_rel_is(?s, "src/nested/link", "../lib.mach", "src/lib.mach")) { ret 3; }
    if (!t_symlink_rel_is(?s, "src/link", "..", "."))                            { ret 4; }
    if (!t_symlink_rel_is(?s, "src/link", "./a/../lib.mach", "src/lib.mach"))    { ret 5; }
    if (!t_symlink_rel_is(?s, "src/link", "../..hidden", "..hidden"))            { ret 6; }
    $if ($mach.build.os == $mach.os.windows) {
        if (!t_symlink_rel_is(?s, "src/link", "nested\\..\\lib.mach", "src/lib.mach")) { ret 7; }
    }
    $or {
        if (!t_symlink_rel_is(?s, "src/link", "nested\\leaf", "src/nested\\leaf")) { ret 7; }
    }
    ret 0;
}

test "mach.lang.driver.deps.symlink_target_rel:rejects_parent_escapes_and_absolute_anchors" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var targets: [3]str = [3]str{"../../outside", "../..", "../../package-sibling/file"};
    var i:       usize  = 0;
    for (i < 3) {
        val r: res[str, outcome.Fail] = symlink_target_rel(?s, "src/link", targets[i]);
        if (sel r.ok) {
            str_free(s.build_alloc, r.ok);
            ret 2;
        }
        if (!str_equals(outcome.describe(r.err), "tracked symlink target escapes dependency package")) { ret 3; }
        i = i + 1;
    }
    var absolute: [6]str = [6]str{"", "/outside", "C:relative", "C:/outside", "\\outside", "\\\\server\\share\\outside"};
    i = 0;
    for (i < 6) {
        val r: res[str, outcome.Fail] = symlink_target_rel(?s, "src/link", absolute[i]);
        if (sel r.ok) {
            str_free(s.build_alloc, r.ok);
            ret 4;
        }
        if (!str_equals(outcome.describe(r.err), "tracked symlink target must be relative")) { ret 5; }
        i = i + 1;
    }
    ret 0;
}

fun t_symlink_commit(alloc: *A.Allocator, gi: *GitInspector, root: str, message: str) bool {
    var add: [2]str                 = [2]str{"add", "-A"};
    val ar:  res[str, outcome.Fail] = git_op(alloc, gi, root, ?add[0], 2, nil);
    if (sel ar.err) { ret false; }
    str_free(alloc, ar.ok);
    var commit: [7]str                 = [7]str{"-c", "user.email=t@t", "-c", "user.name=t", "commit", "-m", message};
    val cr:     res[str, outcome.Fail] = git_op(alloc, gi, root, ?commit[0], 7, nil);
    if (sel cr.err) { ret false; }
    str_free(alloc, cr.ok);
    ret true;
}

test "mach.lang.driver.deps.verify_symlinks:contained_chain_uses_git_names_and_rejects_cycles_and_escapes" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val gr: res[GitInspector, outcome.Fail] = git_inspector_init(?alloc);
    if (sel gr.err) { ret 1; }
    var gi: GitInspector = gr.ok;
    fin { git_inspector_dnit(?alloc, ?gi); }
    val root_r: res[str, outcome.Fail] = t_make_fixture_repo(?alloc, ?gi, "symlinkcase");
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    fin {
        fs.remove_all(?alloc, root);
        str_free(?alloc, root);
    }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    val dr: res[str, outcome.Fail] = t_mkdirs(?alloc, root, "src/deep");
    if (sel dr.err) { ret 1; }
    str_free(?alloc, dr.ok);
    val t_write_file_r: err[outcome.Fail] = t_write_file(?alloc, root, "src/value.mach", "pub fun value() i32 { ret 0; }\n");
    if (sel t_write_file_r.err) { ret 1; }
    val first_r: res[path.Path, A.Error] = path.join(?alloc, root, "src/start.mach");
    if (sel first_r.err) { ret 1; }
    val first: str = first_r.ok;
    fin { str_free(?alloc, first); }
    val next_r: res[path.Path, A.Error] = path.join(?alloc, root, "src/deep/next.mach");
    if (sel next_r.err) { ret 1; }
    val next: str = next_r.ok;
    fin { str_free(?alloc, next); }
    val symlink_r2: err[io_error.Error] = fs.symlink("deep/next.mach", first);
    if (sel symlink_r2.err) { ret 2; }
    val symlink_r: err[io_error.Error] = fs.symlink("../value.mach", next);
    if (sel symlink_r.err)                                       { ret 2; }
    if (!t_symlink_commit(?alloc, ?gi, root, "contained chain")) { ret 2; }
    val contained: err[outcome.Fail] = verify_realization_symlinks(?s, ?gi, "symlinkcase", root, "", root);
    if (sel contained.err) {
        print.eprintln(outcome.describe(contained.err));
        ret 3;
    }
    val remove_file_r: err[io_error.Error] = fs.remove_file(next);
    if (sel remove_file_r.err) { ret 4; }
    val symlink_r3: err[io_error.Error] = fs.symlink("../../src/start.mach", next);
    if (sel symlink_r3.err)                            { ret 4; }
    if (!t_symlink_commit(?alloc, ?gi, root, "cycle")) { ret 4; }
    val cycle: err[outcome.Fail] = verify_realization_symlinks(?s, ?gi, "symlinkcase", root, "", root);
    if (sel cycle.ok)                                                                            { ret 5; }
    if (!str_equals(outcome.describe(cycle.err), "tracked symlink cycle in dependency package")) { ret 5; }
    val remove_file_r2: err[io_error.Error] = fs.remove_file(next);
    if (sel remove_file_r2.err) { ret 6; }
    val symlink_r4: err[io_error.Error] = fs.symlink("../../../outside", next);
    if (sel symlink_r4.err)                             { ret 6; }
    if (!t_symlink_commit(?alloc, ?gi, root, "escape")) { ret 6; }
    val escape: err[outcome.Fail] = verify_realization_symlinks(?s, ?gi, "symlinkcase", root, "", root);
    if (sel escape.ok)                                                                                  { ret 7; }
    if (!str_equals(outcome.describe(escape.err), "tracked symlink target escapes dependency package")) { ret 7; }
    ret 0;
}

test "mach.lang.driver.deps.staged_gitlink:complete_object_and_exact_stage_zero_record" {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val oid:       str                          = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef";
    val formatted: res[str, format.FormatError] = format.sprint(?a,
        "100644 {} 0\tdep/a/child\n160000 {} 0\tdep/a\n", oid, oid);
    if (sel formatted.err) { ret 1; }
    val text:   str   = formatted.ok;
    val length: usize = str_len(text);
    fin { A.deallocate[u8](?a, text::*u8, length + 1); }
    var i: usize = 0;
    for (i < length) {
        if (text[i] == '\n') { text[i] = 0; }
        i = i + 1;
    }
    var bytes: GitBytes                    = GitBytes{data: text::*u8, len: length};
    val found: res[opt[str], outcome.Fail] = parse_staged_gitlink(?a, ?bytes, "dep/a");
    if (sel found.err) { ret 2; }
    val selected: opt[str] = found.ok;
    if (sel selected.none) { ret 3; }
    val actual: str = selected.some;
    fin { str_free(?a, actual); }
    if (!str_equals(actual, oid)) { ret 4; }
    val sibling: res[opt[str], outcome.Fail] = parse_staged_gitlink(?a, ?bytes, "dep/ab");
    if (sel sibling.err)     { ret 5; }
    if (sel sibling.ok.some) { ret 5; }
    i = 0;
    for (i < length) {
        if (text[i] == '\t' && i > 0) { text[i - 1] = '2'; }
        i = i + 1;
    }
    val parse_staged_gitlink_r: res[opt[str], outcome.Fail] = parse_staged_gitlink(?a, ?bytes, "dep/a");
    if (sel parse_staged_gitlink_r.ok) { ret 6; }
    ret 0;
}

test "mach.lang.driver.deps.metadata:registration_refuses_unstaged_edits_and_pin_staging_leaves_them_unstaged" {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?a);
    if (sel sr.err) { ret 2; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    val gr: res[GitInspector, outcome.Fail] = git_inspector_init(?a);
    if (sel gr.err) { ret 3; }
    var gi: GitInspector = gr.ok;
    fin { git_inspector_dnit(?a, ?gi); }
    val fr: res[str, outcome.Fail] = t_make_fixture_repo(?a, ?gi, "std");
    if (sel fr.err) { ret 4; }
    val fixture: str = fr.ok;
    fin {
        fs.remove_all(?a, fixture);
        str_free(?a, fixture);
    }
    val rr: res[str, outcome.Fail] = t_make_fixture_repo(?a, ?gi, "root");
    if (sel rr.err) { ret 5; }
    val root: str = rr.ok;
    fin {
        fs.remove_all(?a, root);
        str_free(?a, root);
    }
    val original:       str               = "# staged metadata\n";
    val edited:         str               = "# unstaged user metadata\n";
    val t_write_file_r: err[outcome.Fail] = t_write_file(?a, root, ".gitmodules", original);
    if (sel t_write_file_r.err) { ret 6; }
    var add:   [3]str                 = [3]str{"add", "--", ".gitmodules"};
    val added: res[str, outcome.Fail] = git_op(?a, ?gi, root, ?add[0], 3, nil);
    if (sel added.err) { ret 7; }
    str_free(?a, added.ok);
    val t_write_file_r2: err[outcome.Fail] = t_write_file(?a, root, ".gitmodules", edited);
    if (sel t_write_file_r2.err) { ret 8; }
    var env: [4]*u8;
    t_env_allow_file_protocol(?env[0]);
    val refused: res[u8, outcome.Fail] = realize_git_dependency_env(?s, root, "std", fixture, "branch/main", REALIZE_REPO_ROOT, false, ?env[0]);
    if (sel refused.ok) { ret 9; }
    val dr: res[str, outcome.Fail] = dep_full_of(?a, root, "std");
    if (sel dr.err) { ret 10; }
    val dep: str = dr.ok;
    fin { str_free(?a, dep); }
    val exists_r: res[bool, io_error.Error] = fs.exists(dep);
    if (sel exists_r.err)                 { ret 99; }
    if ((sel exists_r.ok && exists_r.ok)) { ret 11; }
    var show:      [2]str                 = [2]str{"show", ":.gitmodules"};
    val unchanged: res[str, outcome.Fail] = git_query_raw(?a, ?gi, root, ?show[0], 2);
    if (sel unchanged.err) { ret 12; }
    val before: str = unchanged.ok;
    fin { str_free(?a, before); }
    if (!str_equals(before, original)) { ret 13; }
    val t_write_file_r3: err[outcome.Fail] = t_write_file(?a, root, ".gitmodules", original);
    if (sel t_write_file_r3.err) { ret 14; }
    val realized: res[u8, outcome.Fail] = realize_git_dependency_env(?s, root, "std", fixture, "branch/main", REALIZE_REPO_ROOT, false, ?env[0]);
    if (sel realized.err) { ret 15; }
    val staged: res[str, outcome.Fail] = git_query_raw(?a, ?gi, root, ?show[0], 2);
    if (sel staged.err) { ret 16; }
    val baseline: str = staged.ok;
    fin { str_free(?a, baseline); }
    val t_write_file_r4: err[outcome.Fail] = t_write_file(?a, root, ".gitmodules", edited);
    if (sel t_write_file_r4.err) { ret 17; }
    val stage_dependency_r: err[outcome.Fail] = stage_dependency(?s, root, "std");
    if (sel stage_dependency_r.err) { ret 18; }
    val final: res[str, outcome.Fail] = git_query_raw(?a, ?gi, root, ?show[0], 2);
    if (sel final.err) { ret 19; }
    val actual: str = final.ok;
    fin { str_free(?a, actual); }
    if (!str_equals(actual, baseline)) { ret 20; }
    ret 0;
}

fun t_put(a: *A.Allocator, dir: str, leaf: str, content: str) bool {
    val written: err[outcome.Fail] = t_write_file(a, dir, leaf, content);
    ret sel written.ok;
}

# a path dependency's inventory is its source: the source's build output and
# the realized dependencies and output of every nested project are left
# behind, so a re-pull is identical to the first and a symlink under a
# skipped directory never reaches the copy (#3356)
fun t_exists(alloc: *A.Allocator, root: str, rel: str) bool {
    val full: res[str, A.Error] = path.join(alloc, root, rel);
    if (sel full.err) { ret false; }
    val there: res[bool, io_error.Error] = fs.exists(full.ok);
    str_free(alloc, full.ok);
    ret sel there.ok && there.ok;
}

# a path dependency inside a git work tree copies what git keeps: tracked files and untracked
# ones its ignore rules keep, never an ignored file, directory or symlink (#3491)
test "mach.lang.driver.deps.path_copy:a_git_source_copies_what_git_keeps" {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val gi_r: res[GitInspector, outcome.Fail] = git_inspector_init(?a);
    if (sel gi_r.err) { ret 2; }
    var gi: GitInspector = gi_r.ok;
    fin { git_inspector_dnit(?a, ?gi); }
    val repo_r: res[str, outcome.Fail] = t_make_fixture_repo(?a, ?gi, "kept");
    if (sel repo_r.err) { ret 3; }
    val repo: str = repo_r.ok;
    fin {
        fs.remove_all(?a, repo);
        str_free(?a, repo);
    }
    if (!t_put(?a, repo, ".gitignore", "scratch/\n*.swp\nlink\n")) { ret 4; }
    if (!t_put(?a, repo, "tracked.txt", "tracked\n"))              { ret 4; }
    # a file sorting between a directory's name and its contents (`data.mach` < `data/`)
    val data_r: res[str, outcome.Fail] = t_mkdirs(?a, repo, "src/data");
    if (sel data_r.err) { ret 4; }
    str_free(?a, data_r.ok);
    if (!t_put(?a, repo, "src/data.mach", ""))       { ret 4; }
    if (!t_put(?a, repo, "src/data/toml.mach", ""))  { ret 4; }
    if (!t_commit_all(?a, ?gi, repo, "tracked"))     { ret 5; }
    if (!t_put(?a, repo, "untracked.txt", "kept\n")) { ret 6; }
    if (!t_put(?a, repo, "editor.swp", "junk\n"))    { ret 6; }
    val scratch_r: res[str, outcome.Fail] = t_mkdirs(?a, repo, "scratch/deep");
    if (sel scratch_r.err) { ret 6; }
    str_free(?a, scratch_r.ok);
    if (!t_put(?a, repo, "scratch/deep/big.bin", "junk\n")) { ret 6; }
    $if ($mach.build.os != $mach.os.windows) {
        val link_r: res[str, A.Error] = path.join(?a, repo, "link");
        if (sel link_r.err) { ret 7; }
        val linked: err[io_error.Error] = fs.symlink("nowhere", link_r.ok);
        str_free(?a, link_r.ok);
        if (sel linked.err) { ret 7; }
    }
    val dst_r: res[str, outcome.Fail] = t_scratch_dir(?a, "mach_dep_kept_copy");
    if (sel dst_r.err) { ret 8; }
    val dst_root: str = dst_r.ok;
    fin {
        fs.remove_all(?a, dst_root);
        str_free(?a, dst_root);
    }
    val dst_j: res[str, A.Error] = path.join(?a, dst_root, "kept");
    if (sel dst_j.err) { ret 8; }
    val dst: str = dst_j.ok;
    fin { str_free(?a, dst); }

    val copied: err[outcome.Fail] = copy_tree(?a, repo, dst);
    if (sel copied.err) { ret 9; }
    var bad: i32 = 0;
    if (!t_exists(?a, dst, "mach.toml"))          { bad = bad | 1; }
    if (!t_exists(?a, dst, "tracked.txt"))        { bad = bad | 2; }
    if (!t_exists(?a, dst, "untracked.txt"))      { bad = bad | 4; }
    if (!t_exists(?a, dst, ".gitignore"))         { bad = bad | 8; }
    if (t_exists(?a, dst, "editor.swp"))          { bad = bad | 16; }
    if (t_exists(?a, dst, "scratch"))             { bad = bad | 32; }
    if (t_exists(?a, dst, "link"))                { bad = bad | 64; }
    if (t_exists(?a, dst, ".git"))                { bad = bad | 128; }
    if (!t_exists(?a, dst, "src/data.mach"))      { bad = bad | 1024; }
    if (!t_exists(?a, dst, "src/data/toml.mach")) { bad = bad | 2048; }

    # a re-pull after a file stops being kept removes it from the copy
    if (!t_put(?a, repo, ".gitignore", "scratch/\n*.swp\nlink\nuntracked.txt\n")) { ret 10; }
    val again: err[outcome.Fail] = copy_tree(?a, repo, dst);
    if (sel again.err)                      { ret 11; }
    if (t_exists(?a, dst, "untracked.txt")) { bad = bad | 256; }
    if (!t_exists(?a, dst, "tracked.txt"))  { bad = bad | 512; }
    ret bad;
}

# a path dependency below an enclosing repository copies by the rules of the repository it
# belongs to: a source that repository ignores is walked, a tracked one is filtered, and an
# inventory that keeps no manifest is refused rather than realized empty (#3565)
test "mach.lang.driver.deps.path_copy:a_source_under_an_enclosing_repository" {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val gi_r: res[GitInspector, outcome.Fail] = git_inspector_init(?a);
    if (sel gi_r.err) { ret 2; }
    var gi: GitInspector = gi_r.ok;
    fin { git_inspector_dnit(?a, ?gi); }
    val repo_r: res[str, outcome.Fail] = t_make_fixture_repo(?a, ?gi, "outer");
    if (sel repo_r.err) { ret 3; }
    val repo: str = repo_r.ok;
    fin {
        fs.remove_all(?a, repo);
        str_free(?a, repo);
    }
    val project: str = "[project]\nid = \"inner\"\nversion = \"0.1.0\"\nsrc = \"src\"\n";
    if (!t_put(?a, repo, ".gitignore", "ign/\n*.swp\ndrop/mach.toml\n")) { ret 4; }
    val dirs: [5]str = [5]str{"ign/base/src", "ign/deep/proj/src", "sub/src", "drop/src", "none"};
    var d:    usize  = 0;
    for (d < 5) {
        val made: res[str, outcome.Fail] = t_mkdirs(?a, repo, dirs[d]);
        if (sel made.err) { ret 4; }
        str_free(?a, made.ok);
        d = d + 1;
    }
    if (!t_put(?a, repo, "sub/mach.toml", project))      { ret 4; }
    if (!t_put(?a, repo, "sub/src/lib.mach", ""))        { ret 4; }
    if (!t_commit_all(?a, ?gi, repo, "tracked"))         { ret 5; }
    if (!t_put(?a, repo, "sub/junk.swp", "junk\n"))      { ret 6; }
    if (!t_put(?a, repo, "ign/base/mach.toml", project)) { ret 6; }
    if (!t_put(?a, repo, "ign/base/src/lib.mach", ""))   { ret 6; }
    # a source below an ignored directory rather than the ignored directory itself
    if (!t_put(?a, repo, "ign/deep/proj/mach.toml", project)) { ret 6; }
    if (!t_put(?a, repo, "ign/deep/proj/src/lib.mach", ""))   { ret 6; }
    if (!t_put(?a, repo, "drop/mach.toml", project))          { ret 6; }
    if (!t_put(?a, repo, "drop/src/lib.mach", ""))            { ret 6; }
    if (!t_put(?a, repo, "none/only.swp", "junk\n"))          { ret 6; }
    val dst_r: res[str, outcome.Fail] = t_scratch_dir(?a, "mach_dep_enclosed_copy");
    if (sel dst_r.err) { ret 7; }
    val dst_root: str = dst_r.ok;
    fin {
        fs.remove_all(?a, dst_root);
        str_free(?a, dst_root);
    }
    val sources: [5]str = [5]str{"ign/base", "ign/deep/proj", "sub", "drop", "none"};
    var i:       usize  = 0;
    for (i < 5) {
        val src_j: res[str, A.Error] = path.join(?a, repo, sources[i]);
        if (sel src_j.err) { ret 8; }
        val src: str = src_j.ok;
        fin { str_free(?a, src); }
        val dst_j: res[str, A.Error] = path.join(?a, dst_root, sources[i]);
        if (sel dst_j.err) { ret 8; }
        val dst: str = dst_j.ok;
        fin { str_free(?a, dst); }
        val copied: err[outcome.Fail] = copy_tree(?a, src, dst);
        var flags:  i32               = 0;
        if (i < 3) {
            if (sel copied.err)                     { flags = flags | 1; }
            if (!t_exists(?a, dst, "mach.toml"))    { flags = flags | 2; }
            if (!t_exists(?a, dst, "src/lib.mach")) { flags = flags | 4; }
            if (t_exists(?a, dst, "junk.swp"))      { flags = flags | 8; }
        }
        or (sel copied.ok) { flags = 1; }
        if (flags != 0)    { ret 16 * (i::i32 + 1) + flags; }
        i = i + 1;
    }
    ret 0;
}

test "mach.lang.driver.deps.path_copy:project_boundaries_leave_out_and_nested_dep_behind" {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val rr: res[str, outcome.Fail] = t_scratch_dir(?a, "mach_dep_boundaries");
    if (sel rr.err) { ret 2; }
    val source: str = rr.ok;
    fin {
        fs.remove_all(?a, source);
        str_free(?a, source);
    }
    val manifest_text: str = "[project]\nid = \"crypto\"\nversion = \"0.1.0\"\nsrc = \"src\"\nout = \"build\"\n";
    if (!t_put(?a, source, "mach.toml", manifest_text)) { ret 3; }
    val src_r: res[str, outcome.Fail] = t_mkdirs(?a, source, "src");
    if (sel src_r.err) { ret 3; }
    str_free(?a, src_r.ok);
    if (!t_put(?a, source, "src/lib.mach", "")) { ret 3; }
    # the source's own build output, declared as `build`, holding a symlink
    val build_r: res[str, outcome.Fail] = t_mkdirs(?a, source, "build/assurance");
    if (sel build_r.err) { ret 4; }
    val build: str = build_r.ok;
    fin { str_free(?a, build); }
    $if ($mach.build.os != $mach.os.windows) {
        val link_r: res[str, A.Error] = path.join(?a, build, "current");
        if (sel link_r.err) { ret 4; }
        val linked: err[io_error.Error] = fs.symlink("nowhere", link_r.ok);
        str_free(?a, link_r.ok);
        if (sel linked.err) { ret 4; }
    }
    # a nested test project with its own realized dependency and output
    val nested_r: res[str, outcome.Fail] = t_mkdirs(?a, source, "test/aead");
    if (sel nested_r.err) { ret 5; }
    val nested: str = nested_r.ok;
    fin { str_free(?a, nested); }
    if (!t_put(?a, nested, "mach.toml", "[project]\nid = \"aead\"\nversion = \"0.1.0\"\nsrc = \"src\"\nout = \"out\"\n")) { ret 5; }
    val nested_dep_r: res[str, outcome.Fail] = t_mkdirs(?a, nested, "dep/other");
    if (sel nested_dep_r.err) { ret 5; }
    str_free(?a, nested_dep_r.ok);
    val nested_out_r: res[str, outcome.Fail] = t_mkdirs(?a, nested, "out/x");
    if (sel nested_out_r.err) { ret 5; }
    str_free(?a, nested_out_r.ok);
    if (!t_put(?a, nested, "dep/other/stale", "copied last time")) { ret 5; }
    if (!t_put(?a, nested, "out/x/artifact", "built"))             { ret 5; }
    if (!t_put(?a, nested, "keep.txt", "source"))                  { ret 5; }
    # a plain directory named out beneath a non-project directory is source
    val plain_r: res[str, outcome.Fail] = t_mkdirs(?a, source, "src/out");
    if (sel plain_r.err) { ret 6; }
    str_free(?a, plain_r.ok);
    if (!t_put(?a, source, "src/out/data.mach", "")) { ret 6; }

    val dr: res[str, outcome.Fail] = dep_full_of(?a, nested, "crypto");
    if (sel dr.err) { ret 7; }
    val dst: str = dr.ok;
    fin { str_free(?a, dst); }
    val first: err[outcome.Fail] = copy_tree(?a, source, dst);
    if (sel first.err) { ret 8; }
    val second: err[outcome.Fail] = copy_tree(?a, source, dst);
    if (sel second.err) { ret 9; }
    val present: [4]str = [4]str{"mach.toml", "src/lib.mach", "src/out/data.mach", "test/aead/keep.txt"};
    val absent:  [4]str = [4]str{"build", "test/aead/dep", "test/aead/out", "test/aead/dep/other/stale"};
    var i:       usize  = 0;
    for (i < 4) {
        val p: res[str, A.Error] = path.join(?a, dst, present[i]);
        if (sel p.err) { ret 10; }
        val p_exists: res[bool, io_error.Error] = fs.exists(p.ok);
        str_free(?a, p.ok);
        if (!(sel p_exists.ok && p_exists.ok)) { ret 11; }
        val q: res[str, A.Error] = path.join(?a, dst, absent[i]);
        if (sel q.err) { ret 10; }
        val q_exists: res[bool, io_error.Error] = fs.exists(q.ok);
        str_free(?a, q.ok);
        if (sel q_exists.ok && q_exists.ok) { ret 12; }
        i = i + 1;
    }
    ret 0;
}

test "mach.lang.driver.deps.path_copy:ancestor_source_uses_finite_inventory_and_excludes_its_destination" {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val rr: res[str, outcome.Fail] = t_scratch_dir(?a, "mach_dep_ancestor");
    if (sel rr.err) { ret 2; }
    val source: str = rr.ok;
    fin {
        fs.remove_all(?a, source);
        str_free(?a, source);
    }
    val nested_r: res[str, outcome.Fail] = t_mkdirs(?a, source, "test/err");
    if (sel nested_r.err) { ret 3; }
    val nested: str = nested_r.ok;
    fin { str_free(?a, nested); }
    val dr: res[str, outcome.Fail] = dep_full_of(?a, nested, "std");
    if (sel dr.err) { ret 4; }
    val dst: str = dr.ok;
    fin { str_free(?a, dst); }
    val t_write_file_r2: err[outcome.Fail] = t_write_file(?a, source, "payload", "original");
    if (sel t_write_file_r2.err) { ret 5; }
    val copy_tree_r: err[outcome.Fail] = copy_tree(?a, source, dst);
    if (sel copy_tree_r.err) { ret 6; }
    val loop_r: res[str, A.Error] = path.join(?a, dst, "test/err/dep/std");
    if (sel loop_r.err) { ret 7; }
    val loop: str = loop_r.ok;
    fin { str_free(?a, loop); }
    val exists_r: res[bool, io_error.Error] = fs.exists(loop);
    if (sel exists_r.err)                 { ret 99; }
    if ((sel exists_r.ok && exists_r.ok)) { ret 8; }
    val t_write_file_r3: err[outcome.Fail] = t_write_file(?a, source, "payload", "updated");
    if (sel t_write_file_r3.err) { ret 11; }
    val copy_tree_r2: err[outcome.Fail] = copy_tree(?a, source, dst);
    if (sel copy_tree_r2.err) { ret 12; }
    val exists_r3: res[bool, io_error.Error] = fs.exists(loop);
    if (sel exists_r3.err)                  { ret 99; }
    if ((sel exists_r3.ok && exists_r3.ok)) { ret 13; }
    val payload_r: res[str, A.Error] = path.join(?a, dst, "payload");
    if (sel payload_r.err) { ret 14; }
    val payload: str = payload_r.ok;
    fin { str_free(?a, payload); }
    val read: res[str, fs.FsError] = fs.read_string(?a, payload);
    if (sel read.err) { ret 15; }
    val text: str = read.ok;
    fin { str_free(?a, text); }
    if (!str_equals(text, "updated")) { ret 16; }
    ret 0;
}

# the realization is its source: an entry the source no longer has is removed, so a
# dependency refreshed after an upstream delete keeps nothing the source dropped (#3429)
test "mach.lang.driver.deps.path_copy:a_destination_entry_the_source_dropped_is_removed" {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val sr: res[str, outcome.Fail] = t_scratch_dir(?a, "mach_dep_copy_source");
    if (sel sr.err) { ret 2; }
    val source: str = sr.ok;
    fin {
        fs.remove_all(?a, source);
        str_free(?a, source);
    }
    val dr: res[str, outcome.Fail] = t_scratch_dir(?a, "mach_dep_copy_destination");
    if (sel dr.err) { ret 3; }
    val dst: str = dr.ok;
    fin {
        fs.remove_all(?a, dst);
        str_free(?a, dst);
    }
    val w1: err[outcome.Fail] = t_write_file(?a, source, "selected", "new");
    if (sel w1.err) { ret 4; }
    val w2: err[outcome.Fail] = t_write_file(?a, dst, "selected", "old");
    if (sel w2.err) { ret 4; }
    val w3: err[outcome.Fail] = t_write_file(?a, dst, "stale", "dropped upstream");
    if (sel w3.err) { ret 4; }
    val nested_r: res[str, outcome.Fail] = t_mkdirs(?a, dst, "gone/deeper");
    if (sel nested_r.err) { ret 4; }
    str_free(?a, nested_r.ok);
    val w4: err[outcome.Fail] = t_write_file(?a, dst, "gone/deeper/leaf", "also dropped");
    if (sel w4.err) { ret 4; }

    val copied: err[outcome.Fail] = copy_tree(?a, source, dst);
    if (sel copied.err) { ret 5; }

    val selected_r: res[str, A.Error] = path.join(?a, dst, "selected");
    if (sel selected_r.err) { ret 6; }
    val selected: str = selected_r.ok;
    fin { str_free(?a, selected); }
    val new_r: res[str, fs.FsError] = fs.read_string(?a, selected);
    if (sel new_r.err) { ret 7; }
    val updated: str = new_r.ok;
    fin { str_free(?a, updated); }
    if (!str_equals(updated, "new")) { ret 8; }

    val absent: [2]str = [2]str{"stale", "gone"};
    var i:      usize  = 0;
    for (i < 2) {
        val q: res[str, A.Error] = path.join(?a, dst, absent[i]);
        if (sel q.err) { ret 9; }
        val q_exists: res[bool, io_error.Error] = fs.exists(q.ok);
        str_free(?a, q.ok);
        if (sel q_exists.ok && q_exists.ok) { ret 10; }
        i = i + 1;
    }

    val again: err[outcome.Fail] = copy_tree(?a, source, dst);
    if (sel again.err) { ret 11; }
    val same_source: err[outcome.Fail] = copy_tree(?a, source, source);
    if (sel same_source.ok) { ret 12; }
    ret 0;
}

# `[project].out` is a template, and the directory it leaves behind is the template's
# leading segment rather than the template text (#3429)
test "mach.lang.driver.deps.path_copy:a_templated_out_directory_is_left_behind" {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val rr: res[str, outcome.Fail] = t_scratch_dir(?a, "mach_dep_out_template");
    if (sel rr.err) { ret 2; }
    val source: str = rr.ok;
    fin {
        fs.remove_all(?a, source);
        str_free(?a, source);
    }
    if (!t_put(?a, source, "mach.toml", "[project]\nid = \"tmpl\"\nversion = \"0.1.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n")) { ret 3; }
    val src_r: res[str, outcome.Fail] = t_mkdirs(?a, source, "src");
    if (sel src_r.err) { ret 3; }
    str_free(?a, src_r.ok);
    if (!t_put(?a, source, "src/lib.mach", "")) { ret 3; }
    val out_r: res[str, outcome.Fail] = t_mkdirs(?a, source, "out/host/debug");
    if (sel out_r.err) { ret 4; }
    str_free(?a, out_r.ok);
    if (!t_put(?a, source, "out/host/debug/artifact", "built")) { ret 4; }

    val dr: res[str, outcome.Fail] = t_scratch_dir(?a, "mach_dep_out_destination");
    if (sel dr.err) { ret 5; }
    val dst: str = dr.ok;
    fin {
        fs.remove_all(?a, dst);
        str_free(?a, dst);
    }
    val copied: err[outcome.Fail] = copy_tree(?a, source, dst);
    if (sel copied.err) { ret 6; }

    val kept_r: res[str, A.Error] = path.join(?a, dst, "src/lib.mach");
    if (sel kept_r.err) { ret 7; }
    val kept_exists: res[bool, io_error.Error] = fs.exists(kept_r.ok);
    str_free(?a, kept_r.ok);
    if (!(sel kept_exists.ok && kept_exists.ok)) { ret 8; }

    val out_q: res[str, A.Error] = path.join(?a, dst, "out");
    if (sel out_q.err) { ret 7; }
    val out_exists: res[bool, io_error.Error] = fs.exists(out_q.ok);
    str_free(?a, out_q.ok);
    if (sel out_exists.ok && out_exists.ok) { ret 9; }
    ret 0;
}
