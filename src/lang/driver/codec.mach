use collections_vector: std.collections.vector;
use std.system.panic.panic;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;

use lang_catalog: mach.lang.catalog;
use mach.lang.deprecation;
use mach.lang.fail;
use comptime_value: mach.lang.fe.comptime.value;
use mach.lang.fe.resolve;
use sema_fields:  mach.lang.fe.sema.fields;
use sema_product: mach.lang.fe.sema.product;
use mach.lang.float;
use mach.lang.intern;
use mach.lang.module;
use mach.lang.query;
use mach.lang.session;
use lang_source: mach.lang.source;
use type_field:  mach.lang.type.field;
use type_kind:   mach.lang.type.kind;
use mach.lang.wide;
use mach.lang.wire;

# the bytes of a handle product, which its encoder wrote `need` bytes long and the query
# engine hands back only as published, so the read is total: a product shorter than its
# encoding is a broken invariant of the driver, and it stops the compiler
pub fun handle_bytes(value: *u8, value_len: u32, need: usize) *u8 {
    if (value == nil || value_len::usize < need) { panic("driver: a handle product is shorter than its encoding\n"); }
    ret value;
}

pub fun resolve_handle_encode(alloc: *A.Allocator, r: *resolve.ResolveResult) res[query.QueryOutput, fail.Fail] {
    val n:  u32               = $size_of(ptr)::u32;
    val rb: res[*u8, A.Error] = A.allocate[u8](alloc, n::usize);
    if (sel rb.err) {
        resolve.result_dnit(r);
        A.deallocate[resolve.ResolveResult](alloc, r, 1::usize);
        ret res[query.QueryOutput, fail.Fail].err{fail.refused(rb.err)};
    }
    val buf:  *u8  = rb.ok;
    val slot: *ptr = buf::ptr::*ptr;
    slot[0] = r::ptr;
    var out: query.QueryOutput;
    out.bytes = buf;
    out.len   = n;
    ret res[query.QueryOutput, fail.Fail].ok{out};
}

pub fun resolve_handle_decode(e: query.QueryView) *resolve.ResolveResult {
    val slot: *ptr = handle_bytes(e.value, e.value_len, $size_of(ptr))::ptr::*ptr;
    ret slot[0]::*resolve.ResolveResult;
}

# a grown fingerprint sink's bytes as a query output owned by the caller; the
# sink is left empty
pub fun output(s: *wire.Sink) res[query.QueryOutput, fail.Fail] {
    var out: query.QueryOutput;
    out.bytes = nil;
    out.len   = 0;
    if (!s.failed && s.len > 0xFFFFFFFF::usize) {
        wire.dnit(s);
        ret res[query.QueryOutput, fail.Fail].err{fail.message("fingerprint exceeds 32-bit query input length")};
    }
    val n:     u32                 = s.len::u32;
    val bytes: res[*u8, fail.Fail] = wire.release(s);
    if (sel bytes.err) { ret res[query.QueryOutput, fail.Fail].err{bytes.err}; }
    out.bytes = bytes.ok;
    if (bytes.ok != nil) { out.len = n; }
    ret res[query.QueryOutput, fail.Fail].ok{out};
}

fun constant_encode(s: *wire.Sink, item: *resolve.ExportConstant, origin: module.StableModuleId,
    definition_revision: query.Revision) err[fail.Fail] {
    wire.put_u32(s, item.name::u32);
    var present: u8 = 0;
    if (item.present) { present = 1; }
    wire.put_u8(s, present);
    if (!item.present) { ret err[fail.Fail].ok{}; }
    ret ct_value_encode(s, ?item.value, origin, definition_revision);
}

# a CONST_ELEM value names an element of its origin's definition, so it folds that definition's revision
pub fun ct_value_encode(s: *wire.Sink, value: *comptime_value.CTValue, origin: module.StableModuleId,
    definition_revision: query.Revision) err[fail.Fail] {
    wire.put_u8(s, value.kind);
    var low:      u64 = 0;
    var high:     u64 = 0;
    var width:    u8  = 0;
    var unsigned: u8  = 0;
    if (value.kind == comptime_value.CT_KIND_INT) {
        low   = value.data.w.lo;
        high  = value.data.w.hi;
        width = value.int_width;
        if (value.int_unsigned) { unsigned = 1; }
    }
    or (value.kind == comptime_value.CT_KIND_FLOAT) {
        low   = float.f64_bits(value.data.f);
        width = value.float_width;
    }
    or (value.kind == comptime_value.CT_KIND_STR || value.kind == comptime_value.CT_KIND_NON_INTEGER) {
        low = intern.str_index(value.data.s)::u64;
    }
    or (value.kind == comptime_value.CT_KIND_TYPE) {
        low = value.data.t::u64;
    }
    or (value.kind == comptime_value.CT_KIND_FIELD || value.kind == comptime_value.CT_KIND_CASE) {
        low  = value.data.fld.owner::u64;
        high = value.data.fld.index::u64;
    }
    or (value.kind == comptime_value.CT_KIND_PACK_ELEM) {
        low  = value.data.pelem.index::u64;
        high = value.data.pelem.ty::u64;
    }
    or (value.kind == comptime_value.CT_KIND_NODE) {
        low  = (value.data.node.module::u64 << 32) | value.data.node.node::u64;
        high = value.data.node.ty::u64;
    }
    or (value.kind == comptime_value.CT_KIND_CONST_ELEM) {
        low  = value.data.celem.elem::u64;
        high = value.data.celem.ty::u64;
        if (definition_revision == 0 || module.stable_is_nil(origin)) {
            ret err[fail.Fail].err{fail.message("constant element surface requires its current definition revision")};
        }
    }
    or { ret err[fail.Fail].err{fail.message("constant surface has an unknown CTKind")}; }
    wire.put_u8(s, unsigned);
    wire.put_u8(s, width);
    wire.put_u64(s, low);
    wire.put_u64(s, high);
    if (value.kind == comptime_value.CT_KIND_CONST_ELEM) {
        wire.put_u32(s, origin::u32);
        wire.put_u64(s, definition_revision);
    }
    ret err[fail.Fail].ok{};
}

pub fun public_surface_encode(s: *wire.Sink, rr: *resolve.ResolveResult, origin: module.StableModuleId,
    definition_revision: query.Revision) err[fail.Fail] {
    wire.put_u32(s, rr.pub_count);
    var i: u32 = 0;
    for (i < rr.pub_count) {
        val symbol: *resolve.Symbol = ?rr.symbols[i];
        wire.put_u8(s, symbol.definition_kind);
        wire.put_u32(s, symbol.name::u32);
        wire.put_u32(s, symbol.canon::u32);
        wire.put_u32(s, symbol.definition_file::u32);
        wire.put_u32(s, symbol.generic_arity);
        wire.put_u8(s, symbol.has_comptime_params::u8);
        wire.put_u8(s, symbol.has_pack_param::u8);
        deprecation_encode(s, symbol.deprecation);
        wire.put_u8(s, symbol.testing::u8);
        wire.put_u32(s, symbol.slot);
        wire.put_u32(s, symbol.origin::u32);
        i = i + 1;
    }
    # a refusal changes what an importer reports about a missing name
    wire.put_u8(s, rr.refused::u8);
    wire.put_u32(s, rr.public_constant_count);
    i = 0;
    for (i < rr.public_constant_count) {
        val item: err[fail.Fail] = constant_encode(s, ?rr.public_constants[i], origin, definition_revision);
        if (sel item.err) { ret item; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun deprecation_encode(s: *wire.Sink, notice: deprecation.Deprecation) {
    wire.put_u8(s, notice.present::u8);
    wire.put_u32(s, notice.owner::u32);
    wire.put_u32(s, notice.message::u32);
}

fun deprecation_decode(r: *wire.Source) res[deprecation.Deprecation, fail.Fail] {
    val present: u8  = wire.take_u8(r);
    val owner:   u32 = wire.take_u32(r);
    val message: u32 = wire.take_u32(r);
    if (r.bad)       { ret res[deprecation.Deprecation, fail.Fail].err{fail.message("deprecation notice is truncated")}; }
    if (present > 1) { ret res[deprecation.Deprecation, fail.Fail].err{fail.message("deprecation notice flag is invalid")}; }
    ret res[deprecation.Deprecation, fail.Fail].ok{deprecation.Deprecation{present: present != 0,
        owner: owner::lang_source.FileId, message: message::intern.StrId}};
}

# what the exports product of module `stable` says an importer reads, its symbols allocated from `a`
pub fun public_symbols_decode(a: *A.Allocator, s: *session.Session, bytes: *u8, len: u32,
    path: intern.StrId, stable: module.StableModuleId) res[resolve.ModuleExports, fail.Fail] {
    if (len < 9) { ret res[resolve.ModuleExports, fail.Fail].err{fail.message("public symbol surface is truncated")}; }
    var r: wire.Source = wire.source(bytes, len::usize);
    val n: u32         = wire.take_u32(?r);
    if (n > (len - 9) / 36) { ret res[resolve.ModuleExports, fail.Fail].err{fail.message("public symbol surface is truncated")}; }
    var out: resolve.ModuleExports = resolve.ModuleExports{path: path, module: stable};
    if (n == 0) { ret symbols_refusal(?r, out); }
    val allocated: res[*resolve.PublicSymbol, A.Error] = A.allocate[resolve.PublicSymbol](a, n::usize);
    if (sel allocated.err) { ret res[resolve.ModuleExports, fail.Fail].err{fail.refused(allocated.err)}; }
    val symbols:     *resolve.PublicSymbol = allocated.ok;
    var transferred: bool                  = false;
    fin {
        if (!transferred) { A.deallocate[resolve.PublicSymbol](a, symbols, n::usize); }
    }
    var i: u32 = 0;
    for (i < n) {
        val kind:     u8                                      = wire.take_u8(?r);
        val name:     u32                                     = wire.take_u32(?r);
        val canon:    u32                                     = wire.take_u32(?r);
        val file:     u32                                     = wire.take_u32(?r);
        val arity:    u32                                     = wire.take_u32(?r);
        val comptime: u8                                      = wire.take_u8(?r);
        val pack:     u8                                      = wire.take_u8(?r);
        val notice:   res[deprecation.Deprecation, fail.Fail] = deprecation_decode(?r);
        val testing:  u8                                      = wire.take_u8(?r);
        val slot:     u32                                     = wire.take_u32(?r);
        val origin:   u32                                     = wire.take_u32(?r);
        if (r.bad)          { ret res[resolve.ModuleExports, fail.Fail].err{fail.message("public symbol surface is truncated")}; }
        if (sel notice.err) { ret res[resolve.ModuleExports, fail.Fail].err{notice.err}; }
        var symbol: resolve.PublicSymbol = resolve.PublicSymbol{};
        symbol.kind = kind;
        if (!resolve.sym_kind_valid(symbol.kind)) {
            ret res[resolve.ModuleExports, fail.Fail].err{fail.message_of(lang_catalog.catalog_interned(?s.interner, a, lang_catalog.malformed_member("SymKind", symbol.kind::u32)))};
        }
        symbol.name          = name::intern.StrId;
        symbol.canon         = canon::intern.StrId;
        symbol.file          = file::lang_source.FileId;
        symbol.generic_arity = arity;
        if (comptime > 1 || pack > 1) { ret res[resolve.ModuleExports, fail.Fail].err{fail.message("public symbol call shape is invalid")}; }
        symbol.has_comptime_params = comptime != 0;
        symbol.has_pack_param      = pack != 0;
        symbol.deprecation         = notice.ok;
        if (testing > 1) { ret res[resolve.ModuleExports, fail.Fail].err{fail.message("public symbol testing flag is invalid")}; }
        symbol.testing = testing != 0;
        symbol.slot    = slot;
        symbol.origin  = origin::module.StableModuleId;
        symbols[i]     = symbol;
        i              = i + 1;
    }
    out.symbols = symbols;
    out.count   = n;
    val refusal: res[resolve.ModuleExports, fail.Fail] = symbols_refusal(?r, out);
    if (sel refusal.ok) { transferred = true; }
    ret refusal;
}

fun symbols_refusal(r: *wire.Source, exports: resolve.ModuleExports) res[resolve.ModuleExports, fail.Fail] {
    var out:     resolve.ModuleExports = exports;
    val refused: u8                    = wire.take_u8(r);
    if (r.bad)       { ret res[resolve.ModuleExports, fail.Fail].err{fail.message("public symbol surface is truncated")}; }
    if (refused > 1) { ret res[resolve.ModuleExports, fail.Fail].err{fail.message("public symbol refusal flag is invalid")}; }
    out.refused = refused != 0;
    ret res[resolve.ModuleExports, fail.Fail].ok{out};
}

# `itn` and `a` own a catalog rejection's text; a caller without them (a test
# fixture) still refuses the member with a static text naming the catalog
fun constant_decode(itn: *intern.Interner, a: *A.Allocator, r: *wire.Source, origin: module.StableModuleId,
    incarnation: *u64) res[resolve.ExportConstant, fail.Fail] {
    var item: resolve.ExportConstant = resolve.ExportConstant{};
    @incarnation = 0;
    val name:     u32 = wire.take_u32(r);
    val presence: u8  = wire.take_u8(r);
    if (r.bad) { ret res[resolve.ExportConstant, fail.Fail].err{fail.message("constant surface is truncated")}; }
    item.name = name::intern.StrId;
    if (presence > 1)  { ret res[resolve.ExportConstant, fail.Fail].err{fail.message("constant presence is invalid")}; }
    if (presence == 0) { ret res[resolve.ExportConstant, fail.Fail].ok{item}; }
    item.present = true;
    val kind:     u8  = wire.take_u8(r);
    val unsigned: u8  = wire.take_u8(r);
    val bits:     u8  = wire.take_u8(r);
    val lo:       u64 = wire.take_u64(r);
    val hi:       u64 = wire.take_u64(r);
    if (r.bad)        { ret res[resolve.ExportConstant, fail.Fail].err{fail.message("constant surface is truncated")}; }
    if (unsigned > 1) { ret res[resolve.ExportConstant, fail.Fail].err{fail.message("constant flags are invalid")}; }
    item.value.kind = kind;
    if (item.value.kind == comptime_value.CT_KIND_INT) {
        item.value.data.w       = wide.make(lo, hi);
        item.value.int_unsigned = unsigned != 0;
        item.value.int_width    = bits;
    }
    or (item.value.kind == comptime_value.CT_KIND_FLOAT) {
        item.value.data.f      = float.bits_f64(lo);
        item.value.float_width = bits;
    }
    or (item.value.kind == comptime_value.CT_KIND_STR || item.value.kind == comptime_value.CT_KIND_NON_INTEGER) {
        item.value.data.s = intern.str_id(lo::u32);
    }
    or (item.value.kind == comptime_value.CT_KIND_TYPE) {
        item.value.data.t = lo::u32;
    }
    or (item.value.kind == comptime_value.CT_KIND_FIELD || item.value.kind == comptime_value.CT_KIND_CASE) {
        item.value.data.fld.owner = lo::u32;
        item.value.data.fld.index = hi::u32;
    }
    or (item.value.kind == comptime_value.CT_KIND_PACK_ELEM) {
        item.value.data.pelem.index = lo::u32;
        item.value.data.pelem.ty    = hi::u32;
    }
    or (item.value.kind == comptime_value.CT_KIND_NODE) {
        item.value.data.node.module = (lo >> 32)::u32;
        item.value.data.node.node   = (lo & 0xFFFFFFFF)::u32;
        item.value.data.node.ty     = hi::u32;
    }
    or (item.value.kind == comptime_value.CT_KIND_CONST_ELEM) {
        item.value.data.celem.elem = lo::u32;
        item.value.data.celem.ty   = hi::u32;
        val module:   u32 = wire.take_u32(r);
        val revision: u64 = wire.take_u64(r);
        if (r.bad || module != origin::u32 || revision == 0) {
            ret res[resolve.ExportConstant, fail.Fail].err{fail.message("constant element has no matching parsed definition")};
        }
        @incarnation = revision;
    }
    or {
        ret res[resolve.ExportConstant, fail.Fail].err{fail.message_of(lang_catalog.catalog_interned(itn, a, lang_catalog.malformed_member("CTKind", item.value.kind::u32)))};
    }
    ret res[resolve.ExportConstant, fail.Fail].ok{item};
}

# a field recipe's fixed header (type, flags, align, disc, field count) and one field (name, type, deprecation)
val RECIPE_HEAD:  usize = 17;
val RECIPE_FIELD: usize = 17;

pub fun typed_surface_encode(s: *wire.Sink, surface: *sema_product.ModuleSema) err[fail.Fail] {
    if (surface.exports.len > 0xFFFFFFFF::usize || surface.graph.nodes.len > 0xFFFFFFFF::usize) {
        ret err[fail.Fail].err{fail.message("typed surface exceeds its row count extent")};
    }
    wire.put_u32(s, surface.exports.len::u32);
    var i: usize = 0;
    for (i < surface.exports.len) {
        val row: *sema_product.TypeExport = ?surface.exports.data[i];
        wire.put_u32(s, row.origin::u32);
        wire.put_u32(s, row.canon::u32);
        wire.put_u32(s, row.ty::u32);
        val constant: err[fail.Fail] = constant_encode(s, ?row.constant, row.origin, 0);
        if (sel constant.err) { ret constant; }
        i = i + 1;
    }
    wire.put_u32(s, surface.graph.nodes.len::u32);
    i = 0;
    for (i < surface.graph.nodes.len) {
        val node: *sema_fields.Node = ?surface.graph.nodes.data[i];
        if (node.entries.len > (0xFFFFFFFF::usize - RECIPE_HEAD) / RECIPE_FIELD) {
            ret err[fail.Fail].err{fail.message("typed field recipe exceeds its field count extent")};
        }
        var flags: u8 = 0;
        if (node.decoration.align != 0) { flags = flags | 1; }
        if (node.decoration.packed)     { flags = flags | 2; }
        if (node.decoration.volatile_)  { flags = flags | 4; }
        wire.put_u32(s, node.ty::u32);
        wire.put_u8(s, flags);
        wire.put_u32(s, node.decoration.align);
        wire.put_u32(s, node.disc::u32);
        wire.put_u32(s, node.entries.len::u32);
        var j: usize = 0;
        for (j < node.entries.len) {
            val field: *type_field.Entry = ?node.entries.data[j];
            wire.put_u32(s, field.name::u32);
            wire.put_u32(s, field.ty::u32);
            deprecation_encode(s, field.deprecation);
            j = j + 1;
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

pub fun typed_surface_decode(itn: *intern.Interner, a: *A.Allocator, bytes: *u8, len: u32,
    path: intern.StrId, mid: module.ModuleId) res[sema_product.ModuleSema, fail.Fail] {
    var surface:     sema_product.ModuleSema = sema_product.module_sema_init(a, path, mid);
    var transferred: bool                    = false;
    fin {
        if (!transferred) { sema_product.module_sema_dnit(?surface); }
    }
    var r:    wire.Source = wire.source(bytes, len::usize);
    val rows: u32         = wire.take_u32(?r);
    if (r.bad)                                 { ret res[sema_product.ModuleSema, fail.Fail].err{fail.message("typed surface is truncated")}; }
    if (rows::usize > wire.remaining(?r) / 17) { ret res[sema_product.ModuleSema, fail.Fail].err{fail.message("typed symbol rows are truncated")}; }
    val rows_reserved: res[usize, A.Error] = collections_vector.reserve[sema_product.TypeExport](?surface.exports, rows::usize);
    if (sel rows_reserved.err) { ret res[sema_product.ModuleSema, fail.Fail].err{fail.refused(rows_reserved.err)}; }
    var i: u32 = 0;
    for (i < rows) {
        val origin: u32 = wire.take_u32(?r);
        val canon:  u32 = wire.take_u32(?r);
        val ty:     u32 = wire.take_u32(?r);
        if (r.bad) { ret res[sema_product.ModuleSema, fail.Fail].err{fail.message("typed symbol row is truncated")}; }
        var row: sema_product.TypeExport = sema_product.TypeExport{
            origin: origin::module.StableModuleId,
            canon:  canon::intern.StrId,
            ty:     ty::type_kind.TypeId
        };
        var incarnation: u64                                    = 0;
        val constant:    res[resolve.ExportConstant, fail.Fail] = constant_decode(itn, a, ?r, row.origin, ?incarnation);
        if (sel constant.err) { ret res[sema_product.ModuleSema, fail.Fail].err{constant.err}; }
        row.constant = constant.ok;
        val appended: res[usize, A.Error] = collections_vector.push[sema_product.TypeExport](?surface.exports, row);
        if (sel appended.err) { ret res[sema_product.ModuleSema, fail.Fail].err{fail.refused(appended.err)}; }
        i = i + 1;
    }
    val nodes: u32 = wire.take_u32(?r);
    if (r.bad)                                           { ret res[sema_product.ModuleSema, fail.Fail].err{fail.message("typed recipe count is truncated")}; }
    if (nodes::usize > wire.remaining(?r) / RECIPE_HEAD) { ret res[sema_product.ModuleSema, fail.Fail].err{fail.message("typed recipes are truncated")}; }
    val nodes_reserved: res[usize, A.Error] = collections_vector.reserve[sema_fields.Node](?surface.graph.nodes, nodes::usize);
    if (sel nodes_reserved.err) { ret res[sema_product.ModuleSema, fail.Fail].err{fail.refused(nodes_reserved.err)}; }
    i = 0;
    for (i < nodes) {
        val head: *u8 = wire.take_bytes(?r, RECIPE_HEAD);
        if (head == nil) { ret res[sema_product.ModuleSema, fail.Fail].err{fail.message("typed recipe is truncated")}; }
        var h:           wire.Source = wire.source(head, RECIPE_HEAD);
        val node_ty:     u32         = wire.take_u32(?h);
        val attributes:  u8          = wire.take_u8(?h);
        val node_align:  u32         = wire.take_u32(?h);
        val node_disc:   u32         = wire.take_u32(?h);
        val field_count: u32         = wire.take_u32(?h);
        if (attributes > 7 || ((attributes & 1) != 0) != (node_align != 0) || field_count::usize > wire.remaining(?r) / RECIPE_FIELD) {
            ret res[sema_product.ModuleSema, fail.Fail].err{fail.message("typed recipe attributes or field extent are invalid")};
        }
        var node: sema_fields.Node = sema_fields.Node{
            ty:         node_ty::type_kind.TypeId,
            entries:    collections_vector.init[type_field.Entry](a),
            decoration: type_field.Decoration{align: node_align, packed: (attributes & 2) != 0, volatile_: (attributes & 4) != 0},
            disc:       node_disc::type_kind.TypeId
        };
        var node_transferred: bool = false;
        fin {
            if (!node_transferred) { collections_vector.dnit[type_field.Entry](?node.entries); }
        }
        if (field_count > 0) {
            val body: *u8 = wire.take_bytes(?r, field_count::usize * RECIPE_FIELD);
            if (body == nil) { ret res[sema_product.ModuleSema, fail.Fail].err{fail.message("typed field is truncated")}; }
            val entries_reserved: res[usize, A.Error] = collections_vector.reserve[type_field.Entry](?node.entries, field_count::usize);
            if (sel entries_reserved.err) { ret res[sema_product.ModuleSema, fail.Fail].err{fail.refused(entries_reserved.err)}; }
            var f: wire.Source = wire.source(body, field_count::usize * RECIPE_FIELD);
            var j: u32         = 0;
            for (j < field_count) {
                val field_name: u32                                     = wire.take_u32(?f);
                val field_ty:   u32                                     = wire.take_u32(?f);
                val notice:     res[deprecation.Deprecation, fail.Fail] = deprecation_decode(?f);
                if (sel notice.err) { ret res[sema_product.ModuleSema, fail.Fail].err{notice.err}; }
                node.entries.data[j::usize] = type_field.Entry{name: field_name::intern.StrId, ty: field_ty::type_kind.TypeId,
                    deprecation: notice.ok};
                j = j + 1;
            }
            collections_vector.commit[type_field.Entry](?node.entries, field_count::usize);
        }
        val added: res[usize, A.Error] = collections_vector.push[sema_fields.Node](?surface.graph.nodes, node);
        if (sel added.err) { ret res[sema_product.ModuleSema, fail.Fail].err{fail.refused(added.err)}; }
        node_transferred = true;
        i                = i + 1;
    }
    if (!wire.done(?r)) { ret res[sema_product.ModuleSema, fail.Fail].err{fail.message("typed surface has trailing bytes")}; }
    transferred = true;
    ret res[sema_product.ModuleSema, fail.Fail].ok{surface};
}
