# the union configuration of a project, checked through its manifest
use A: std.allocator;
use std.allocator.page;
use fs: std.filesystem;
use std.types.error.err;
use types_path: std.types.path;
use std.types.result.res;
use std.types.string.str;
use std.types.string.str_empty;
use std.types.string.str_equals;
use std.types.string.str_len;

use mach.lang.driver;
use mach.lang.driver.passes;
use mach.lang.driver.project;
use mach.lang.fail;
use mach.lang.manifest;
use mach.lang.module;
use mach.lang.session;
use mach.lang.toolchain;

use mach.lang.driver.tests.testing.ut_analyze_lessons;
use mach.lang.driver.tests.testing.ut_cc3;
use mach.lang.driver.tests.testing.ut_count_errors;
use mach.lang.driver.tests.testing.ut_diag_has;
use mach.lang.driver.tests.testing.ut_has;
use mach.lang.driver.tests.testing.ut_scaffold_lessons;

# a union analysis resolves `{artifact.<id>.out}` over every artifact some artifact
# needs: an open `shaded.mach` beside the default `hello` embeds the shader output
# `shaded` needs, and an artifact nobody needs is still refused
test union_analysis__resolves_artifact_requirements_project_wide {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }

    val shaded: str                 = "#[embed(\"{artifact.shader-vert.out}\")]\nval VERT: [_]u8;\n\nfun main() i32 { ret VERT[0]::i32; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold_lessons(?alloc, shaded);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?alloc, root); }

    val mr: res[manifest.Manifest, fail.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) { ret 1; }
    var mf: manifest.Manifest = mr.ok;
    fin { manifest.dnit(?mf, ?alloc); }

    var bad: i32 = 0;

    # the artifact root set checks shaded.mach against hello's `need`, which is empty
    val narrow: res[project.Project, fail.Fail] = ut_analyze_lessons(?s, ?mf, root, project.ROOT_ARTIFACT);
    if (sel narrow.err) { ret 2; }
    var np: project.Project = narrow.ok;
    if (!ut_diag_has(?s.diags, "does not require")) { bad = 3; }
    project.dnit_project(?np);

    # the union resolves the template in the requirements of the artifact that needs it;
    # the only complaint left is the output no check ever writes
    val wide: res[project.Project, fail.Fail] = ut_analyze_lessons(?s, ?mf, root, project.ROOT_UNION);
    if (sel wide.err) { ret 4; }
    var wp: project.Project = wide.ok;
    if (ut_diag_has(?s.diags, "does not require"))                 { bad = 5; }
    if (!ut_diag_has(?s.diags, "required artifact `shader-vert`")) { bad = 6; }
    if (!ut_has(?wp, ?s, "lessons.hello"))                         { bad = 7; }
    if (!ut_has(?wp, ?s, "lessons.shaded"))                        { bad = 8; }
    var vert_out: str = "";
    var ri:       u32 = 0;
    for (ri < wp.config.art_req_count) {
        if (str_equals(wp.config.art_reqs[ri].name, "shader-vert")) { vert_out = wp.config.art_reqs[ri].out; }
        ri = ri + 1;
    }
    if (str_empty(vert_out)) { bad = 9; }
    var vert_path: str = "";
    if (!str_empty(vert_out)) { vert_path = ut_cc3(?alloc, root, "/", vert_out); }
    project.dnit_project(?wp);
    if (bad != 0) { ret bad; }

    # with the shader output on disk the embed reads it and the union is clean
    val vert_dir_r: res[types_path.Path, A.Error] = types_path.parent(?alloc, vert_path);
    if (sel vert_dir_r.err) { ret 10; }
    val made: err[fs.FsError] = fs.create_dir_all(?alloc, vert_dir_r.ok, 493);
    if (sel made.err) { ret 10; }
    val bytes: str             = "spv!";
    val wrote: err[fs.FsError] = fs.write_bytes(vert_path, bytes, str_len(bytes), 420);
    if (sel wrote.err) { ret 11; }
    val clean: res[project.Project, fail.Fail] = ut_analyze_lessons(?s, ?mf, root, project.ROOT_UNION);
    if (sel clean.err) { ret 12; }
    var cp: project.Project = clean.ok;
    if (ut_count_errors(?s.diags) != 0)                 { bad = 13; }
    if (!fail.is_accepted(passes.frontend_status(?cp))) { bad = 14; }
    project.dnit_project(?cp);
    if (bad != 0) { ret bad; }

    # `hello` is required by nobody, so no artifact's module may name its output
    val shaded_path: str            = ut_cc3(?alloc, root, "/", "src/shaded.mach");
    val overlay:     str            = "#[embed(\"{artifact.hello.out}\")]\nval HELLO: [_]u8;\n\nfun main() i32 { ret HELLO[0]::i32; }\n";
    val laid:        err[fail.Fail] = session.set_overlay(?s, shaded_path, overlay);
    if (sel laid.err) { ret 15; }
    val refused: res[project.Project, fail.Fail] = ut_analyze_lessons(?s, ?mf, root, project.ROOT_UNION);
    if (sel refused.err) { ret 16; }
    var rp: project.Project = refused.ok;
    if (!ut_diag_has(?s.diags, "does not require")) { bad = 17; }
    project.dnit_project(?rp);
    ret bad;
}
