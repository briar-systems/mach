# the union of a project's artifacts and targets: its tuples, entries and export names
use A: std.allocator;
use std.allocator.page;
use fs: std.filesystem;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.string.str;
use std.types.string.str_equals;

use mach.lang.driver;
use mach.lang.driver.passes;
use mach.lang.driver.project;
use mach.lang.fail;
use ast_decl: mach.lang.fe.ast.decl;
use mach.lang.intern;
use mach.lang.manifest;
use mach.lang.module;
use mach.lang.session;
use mach.lang.step;
use mach.lang.toolchain;

use mach.lang.driver.tests.testing.ut_analyze_lessons;
use mach.lang.driver.tests.testing.ut_attr_probe;
use mach.lang.driver.tests.testing.ut_count_errors;
use mach.lang.driver.tests.testing.ut_diag_has;
use mach.lang.driver.tests.testing.ut_has;
use mach.lang.driver.tests.testing.ut_load_test_goal;
use mach.lang.driver.tests.testing.ut_manifest_multi;
use mach.lang.driver.tests.testing.ut_mid;
use mach.lang.driver.tests.testing.ut_module_bin_name;
use mach.lang.driver.tests.testing.ut_scaffold;
use mach.lang.driver.tests.testing.ut_scaffold_lessons;
use mach.lang.driver.tests.testing.ut_scaffold_m;
use mach.lang.driver.tests.testing.ut_str_contains;

test comptime_arm__does_not_mask_a_cross_module_import_conflict {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [3]str;
    names[0] = "main.mach";
    names[1] = "a.mach";
    names[2] = "b.mach";
    var texts: [3]str;
    texts[0] = "use uniontest.a;\nuse uniontest.b;\nfun main() i32 { a.call(); b.call(); ret 0; }\n";
    texts[1] = "$if ($mach.build.os == $mach.os.windows) {\n    #[library(\"kernel32\")]\n    ext fun cx_probe();\n}\n$or {\n    #[library(\"kernel32\")]\n    ext fun cx_probe();\n}\n\npub fun call() { cx_probe(); }\n";
    texts[2] = "#[library(\"user32\")]\next fun cx_probe();\npub fun call() { cx_probe(); }\n";

    var bad: i32                 = 0;
    val pr:  res[str, fail.Fail] = ut_attr_probe(?s, ?alloc, ?names[0], ?texts[0], 3, "windows", "cx_probe");
    if (sel pr.ok) { bad = 1; }
    if (sel pr.err) {
        val msg: str = fail.describe(pr.err);
        if (!ut_str_contains(msg, "import 'cx_probe'")) { bad = 1; }
        if (!ut_str_contains(msg, "'kernel32'"))        { bad = 1; }
        if (!ut_str_contains(msg, "'user32'"))          { bad = 1; }
        if (!ut_str_contains(msg, "uniontest.a"))       { bad = 1; }
        if (!ut_str_contains(msg, "uniontest.b"))       { bad = 1; }
    }

    session.dnit(?s);
    ret bad;
}

# under the union each module reads `$bin.name` as the artifact whose entry reached it
# first: `shaded.mach` refusing any other artifact is clean in a session rooted at
# `hello`, where the artifact root set still reads `hello` for it
test union_analysis__attributes_bin_name_to_the_reaching_artifact {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }

    val shaded: str                 = "$if ($bin.name != \"shaded\") { $error(\"wrong artifact\"); }\n\nfun main() i32 { ret 0; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold_lessons(?alloc, shaded);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?alloc, root); }

    val mr: res[manifest.Manifest, fail.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) { ret 1; }
    var mf: manifest.Manifest = mr.ok;
    fin { manifest.dnit(?mf, ?alloc); }

    var bad: i32 = 0;

    # the artifact root set is one cell: every module is `hello`'s
    val narrow: res[project.Project, fail.Fail] = ut_analyze_lessons(?s, ?mf, root, project.ROOT_ARTIFACT);
    if (sel narrow.err) { ret 2; }
    var np: project.Project = narrow.ok;
    if (!ut_diag_has(?s.diags, "wrong artifact"))                            { bad = 3; }
    if (!str_equals(ut_module_bin_name(?np, ?s, "lessons.shaded"), "hello")) { bad = 4; }
    project.dnit_project(?np);
    if (bad != 0) { ret bad; }

    # the union attributes `shaded.mach` to the artifact whose entry it is
    val wide: res[project.Project, fail.Fail] = ut_analyze_lessons(?s, ?mf, root, project.ROOT_UNION);
    if (sel wide.err) { ret 5; }
    var wp: project.Project = wide.ok;
    if (ut_count_errors(?s.diags) != 0)                                       { bad = 6; }
    if (!fail.is_accepted(passes.frontend_status(?wp)))                       { bad = 7; }
    if (!str_equals(ut_module_bin_name(?wp, ?s, "lessons.hello"), "hello"))   { bad = 8; }
    if (!str_equals(ut_module_bin_name(?wp, ?s, "lessons.shaded"), "shaded")) { bad = 9; }
    project.dnit_project(?wp);
    ret bad;
}

test union__skips_an_uncoverable_target {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    val mf:    str = "[project]\nmach = \">=5\"\nid = \"uskip\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.good]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[target.bad]\nisa = \"aarch64\"\nos = \"windows\"\nabi = \"aapcs64\"\n\n[artifact.uskip]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"{project.out}/bin/uskip\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n";
    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "fun main() i32 { ret 0; }\n";

    val root_r: res[str, fail.Fail] = ut_scaffold_m(?alloc, mf, ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    val pur: res[project.Project, fail.Fail] = driver.build_project_union_for(?s, root, "good");
    fs.remove_all(?alloc, root);
    if (sel pur.err) {
        session.dnit(?s);
        ret 1;
    }
    var pu: project.Project = pur.ok;

    var bad: i32 = 0;
    if (pu.loader.tuple_count != 1)     { bad = 1; }
    or (pu.loader.tuple_cap != 2)       { bad = 1; }
    or (!ut_has(?pu, ?s, "uskip.main")) { bad = 1; }

    project.dnit_project(?pu);
    session.dnit(?s);
    ret bad;
}

# with two artifacts and no selection a build takes the one marked default, a selection
# narrows to one artifact's closure, and the union loads every artifact's entry and closure
test union__loads_every_artifact_entry_and_a_selection_narrows {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [4]str;
    names[0] = "alpha.mach";
    names[1] = "beta.mach";
    names[2] = "shared_a.mach";
    names[3] = "beta_only.mach";
    var texts: [4]str;
    texts[0] = "use uniontest.shared_a;\n\nfun main() i32 { ret 0; }\n";
    texts[1] = "use uniontest.beta_only;\n\nfun main() i32 { ret 0; }\n";
    texts[2] = "pub fun sa() i32 { ret 1; }\n";
    texts[3] = "pub fun bo() i32 { ret 2; }\n";

    val root_r: res[str, fail.Fail] = ut_scaffold_m(?alloc, ut_manifest_multi(), ?names[0], ?texts[0], 4);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    var bad: i32 = 0;

    var sel_none: manifest.Selectors              = manifest.t_selectors("", "linux", "");
    val p0r:      res[project.Project, fail.Fail] = step.project_build(?s, root, ?sel_none);
    if (sel p0r.ok) {
        var p0: project.Project = p0r.ok;
        if (!ut_has(?p0, ?s, "uniontest.beta") || ut_has(?p0, ?s, "uniontest.alpha")) { bad = 1; }
        project.dnit_project(?p0);
    }

    var sel_alpha: manifest.Selectors              = manifest.t_selectors("alpha", "linux", "");
    val par:       res[project.Project, fail.Fail] = step.project_build(?s, root, ?sel_alpha);
    if (sel par.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var pa: project.Project = par.ok;
    if (!ut_has(?pa, ?s, "uniontest.alpha"))    { bad = 1; }
    or (!ut_has(?pa, ?s, "uniontest.shared_a")) { bad = 1; }
    or (ut_has(?pa, ?s, "uniontest.beta"))      { bad = 1; }
    or (ut_has(?pa, ?s, "uniontest.beta_only")) { bad = 1; }
    project.dnit_project(?pa);

    val pur: res[project.Project, fail.Fail] = driver.build_project_union_for(?s, root, "linux");
    if (sel pur.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var pu: project.Project = pur.ok;
    if (!ut_has(?pu, ?s, "uniontest.alpha"))     { bad = 1; }
    or (!ut_has(?pu, ?s, "uniontest.beta"))      { bad = 1; }
    or (!ut_has(?pu, ?s, "uniontest.shared_a"))  { bad = 1; }
    or (!ut_has(?pu, ?s, "uniontest.beta_only")) { bad = 1; }
    project.dnit_project(?pu);

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

# a module's load walks past a gate only layout decides, so an `ext` declared after it
# keeps its C name and its library
test layout_gate__a_later_ext_keeps_its_link_name {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }

    var names: [2]str;
    var texts: [2]str;
    names[0] = "main.mach";
    texts[0] = "use uniontest.sys;\n\npub fun main() i64 { ret 0; }\n";
    names[1] = "sys.mach";
    texts[1] = "pub rec Pair { a: u64; b: u64; }\n\n$if ($size_of(Pair) != 16) {\n    $error(\"pair layout\");\n}\n\n#[library(\"libsystem\")]\npub ext fun getppid() i32;\n";
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 2);
    if (sel root_r.err) { ret 2; }
    val root: str = root_r.ok;

    val pr: res[project.Project, fail.Fail] = ut_load_test_goal(?s, root, "", "linux");
    fs.remove_all(?alloc, root);
    if (sel pr.err) { ret 3; }
    var p: project.Project = pr.ok;
    fin { project.dnit_project(?p); }

    val mid: session.ModuleId = ut_mid(?p, ?s, "uniontest.sys");
    if (module.is_nil(mid)) { ret 4; }
    val m:     *project.ModuleEntry = project.module_at(?p, mid::u32);
    var found: bool                 = false;
    var di:    u32                  = 0;
    for (di < m.a.decl_len::u32) {
        val d: *ast_decl.Decl = ?m.a.decls[di];
        if (d.kind == ast_decl.DECL_KIND_FUN && (d.flags & ast_decl.DECL_FLAG_EXT) != 0) {
            found = true;
            val link: intern.StrId = session.export_name(?s, mid, di);
            if (intern.str_is_nil(link)) { ret 5; }
            val text: opt[str] = intern.get(?s.interner, link);
            if (!(sel text.some && str_equals(text.some, "getppid"))) { ret 6; }
            val library: intern.StrId = session.export_library(?s, mid, di);
            if (intern.str_is_nil(library)) { ret 7; }
        }
        di = di + 1;
    }
    if (!found) { ret 8; }
    ret 0;
}
