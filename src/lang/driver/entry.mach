# an entry build: one artifact of one entry file built with no mach.toml, the command line
# stating the whole project. the project it states is written as manifest text and read
# through the manifest's own parser, so an entry build is held to every rule a declared
# project is, and the build that follows cannot tell the two apart
use std.collections.vector.Vector;
use collections_vector: std.collections.vector;
use std_format:         std.format;
use std.text.string.str_dup_range;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.error.err;
use std.types.option.opt;
use types_path: std.types.path;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_empty;
use std.types.string.str_ends_with;
use std.types.string.str_equals;
use std.types.string.str_index_char;
use std.types.string.str_len;
use std.types.string.str_starts_with;

use A: std.allocator;

use diagnostic_kind: mach.lang.diagnostic.kind;
use driver_closure:  mach.lang.driver.closure;
use mach.lang.fail;
use mach.lang.intern;
use mach.lang.manifest;
use mach.lang.query;
use mach.lang.session;
use lang_source: mach.lang.source;
use lang_target: mach.lang.target;
use target_host: mach.lang.target.host;
use mach.lang.textbuild;
use mink_fail:      mink.base.fail;
use mink_arch:      mink.catalog.arch;
use mink_arch_list: mink.catalog.arch.list;
use mink_os:        mink.catalog.os;
use mink_os_list:   mink.catalog.os.list;
use mink.catalog.output.linkage.Linkage;
use mink_product: mink.catalog.output.product;
use mink.catalog.output.product.Product;
use mink_target: mink.catalog.target;

# the flags that narrow an entry build's target, each as written and nil when absent
# ---
# env:        `--env`
# abi:        `--abi`
# isa:        `--isa`
# exts:       every `--ext`, in argv order
# ext_count:  length of `exts`
# code_model: `--code-model`
pub rec Narrowing {
    env:        str;
    abi:        str;
    isa:        str;
    exts:       *str;
    ext_count:  usize;
    code_model: str;
}

# whether any narrowing flag is given
pub fun narrowed(n: *Narrowing) bool {
    ret n.env != nil || n.abi != nil || n.isa != nil || n.ext_count > 0 || n.code_model != nil;
}

# what the command line states of an entry build
# ---
# entry:        the entry file, a canonical path under the current directory
# kind:         the artifact's product, mink's spelling
# linkage:      the `--linkage` spelling, nil for the target's default
# sources:      each `-s` value, `name=dir` as written
# source_count: length of `sources`
# target:       the `-t` spelling, nil for the host's system and architecture
# narrowing:    the flags that narrow the target
# optimize:     the build runs the optimization pass set
# debug:        the build emits debug information
pub rec EntryRequest {
    entry:        str;
    kind:         str;
    linkage:      str;
    sources:      *str;
    source_count: usize;
    target:       str;
    narrowing:    Narrowing;
    optimize:     bool;
    debug:        bool;
}

# the path an entry build's manifest text reads as in a refusal
val ENTRY_PATH: str = "(entry build)";

# the work directory an entry build lays its intermediates in, `mach init`'s
val ENTRY_WORK: str = "out/{target.name}/{profile.name}";

# the rule an entry build's entry keeps
val ENTRY_CONSTRAINT: str = "an entry build's entry must be a .mach file inside the current directory, named by a relative path with no . or .. component";

# one `-s` binding, split
rec Binding {
    name: str;
    dir:  str;
}

# the project an entry build states, read as its manifest. the project root is the current
# directory, so `-o` and `-w` keep the rules they keep in a project
# ---
# s:   the session the manifest is read in, which holds its text
# r:   what the command line states
# ret: the manifest, owned by the session's build allocator; err as the command line names
#      no buildable project
pub fun entry_manifest(s: *session.Session, r: *EntryRequest) res[manifest.Manifest, fail.Fail] {
    val a: *A.Allocator = s.build_alloc;
    if (!manifest.is_project_path(r.entry) || !str_ends_with(r.entry, ".mach")) {
        ret res[manifest.Manifest, fail.Fail].err{fail.user(diagnostic_kind.CLI_OPERAND, ENTRY_CONSTRAINT)};
    }

    var bindings: Vector[Binding] = collections_vector.init[Binding](a);
    fin { collections_vector.dnit[Binding](?bindings); }
    var i: usize = 0;
    for (i < r.source_count) {
        val split: res[Binding, fail.Fail] = binding_of(a, r.sources[i]);
        if (sel split.err) { ret res[manifest.Manifest, fail.Fail].err{split.err}; }
        var k: usize = 0;
        for (k < bindings.len) {
            if (str_equals(bindings.data[k].name, split.ok.name)) {
                ret res[manifest.Manifest, fail.Fail].err{fail.formatted_user(a, diagnostic_kind.CLI_FLAG_VALUE, "-s binds '{}' twice", split.ok.name)};
            }
            k = k + 1;
        }
        val pushed: res[usize, A.Error] = collections_vector.push[Binding](?bindings, split.ok);
        if (sel pushed.err) { ret res[manifest.Manifest, fail.Fail].err{fail.refused(pushed.err)}; }
        i = i + 1;
    }

    # the entry's own package is the binding whose directory holds it, else the entry's
    # directory under the entry's stem
    val file:   str               = types_path.filename(r.entry);
    val stem_r: res[str, A.Error] = str_dup_range(a, file, 0, str_len(file) - 5);
    if (sel stem_r.err) { ret res[manifest.Manifest, fail.Fail].err{fail.refused(stem_r.err)}; }
    val stem:  str   = stem_r.ok;
    var id:    str   = stem;
    var src:   str   = ".";
    var entry: str   = file;
    var own:   usize = bindings.len;
    i = 0;
    for (i < bindings.len) {
        val dir: str = bindings.data[i].dir;
        if (str_equals(dir, "."))                                                                           { own = i; }
        or (manifest.is_project_path(dir) && str_starts_with(r.entry, dir) && r.entry[str_len(dir)] == '/') { own = i; }
        i = i + 1;
    }
    if (own < bindings.len) {
        id  = bindings.data[own].name;
        src = bindings.data[own].dir;
        if (!str_equals(src, ".")) { entry = (?r.entry[str_len(src) + 1])::str; }
        or                         { entry = r.entry; }
    }
    or {
        if (!manifest.is_valid_id(stem)) {
            ret res[manifest.Manifest, fail.Fail].err{fail.formatted_user(a, diagnostic_kind.CLI_OPERAND,
                "the entry's stem '{}' is no project id; name the entry's source root with -s <name>=<dir>", stem)};
        }
        val parent: res[str, A.Error] = types_path.parent(a, r.entry);
        if (sel parent.err)        { ret res[manifest.Manifest, fail.Fail].err{fail.refused(parent.err)}; }
        if (!str_empty(parent.ok)) { src = parent.ok; }
    }

    val text: res[str, fail.Fail] = manifest_text(a, r, id, src, entry, stem);
    if (sel text.err) { ret res[manifest.Manifest, fail.Fail].err{text.err}; }
    val loaded: res[lang_source.FileId, fail.Fail] = session.load_source(s, ENTRY_PATH, text.ok);
    if (sel loaded.err) { ret res[manifest.Manifest, fail.Fail].err{loaded.err}; }
    val parsed: res[manifest.Manifest, fail.Fail] = manifest.parse_text(a, ?s.interner, ENTRY_PATH, text.ok);
    str_free(a, text.ok);
    if (sel parsed.err) { ret parsed; }
    var m: manifest.Manifest = parsed.ok;
    m.source          = loaded.ok;
    m.source_revision = query.peek_revision(?s.queries, ?session.FILE_TEXT, lang_source.file_index(loaded.ok)::u64);

    # a manifest cannot state the project root as its source directory, an entry build can
    if (str_equals(src, ".")) {
        val dot: res[intern.StrId, A.Error] = intern.add(?s.interner, ".");
        if (sel dot.err) {
            manifest.dnit(?m, a);
            ret res[manifest.Manifest, fail.Fail].err{fail.refused(dot.err)};
        }
        m.src = dot.ok;
    }

    val roots: err[fail.Fail] = source_roots(s, ?m, ?bindings, own);
    if (sel roots.err) {
        manifest.dnit(?m, a);
        ret res[manifest.Manifest, fail.Fail].err{roots.err};
    }
    ret res[manifest.Manifest, fail.Fail].ok{m};
}

# `name=dir`, split at its first `=`, its directory cleaned
fun binding_of(a: *A.Allocator, written: str) res[Binding, fail.Fail] {
    val found: opt[usize] = str_index_char(written, '=');
    var at:    usize      = 0;
    if (sel found.some) { at = found.some; }
    if (at == 0 || at + 1 >= str_len(written)) {
        ret res[Binding, fail.Fail].err{fail.formatted_user(a, diagnostic_kind.CLI_FLAG_VALUE, "-s '{}' must be written <name>=<dir>", written)};
    }
    val name: res[str, A.Error] = str_dup_range(a, written, 0, at);
    if (sel name.err) { ret res[Binding, fail.Fail].err{fail.refused(name.err)}; }
    if (!manifest.is_valid_id(name.ok)) {
        ret res[Binding, fail.Fail].err{fail.formatted_user(a, diagnostic_kind.CLI_FLAG_VALUE, "-s '{}' must name a portable identifier (letters, digits, '_', '-')", written)};
    }
    # `./src` and `src/` bind the directory `src` does
    val dir: res[str, A.Error] = types_path.clean(a, (?written[at + 1])::str);
    if (sel dir.err) { ret res[Binding, fail.Fail].err{fail.refused(dir.err)}; }
    ret res[Binding, fail.Fail].ok{Binding{name: name.ok, dir: dir.ok}};
}

# every binding but the entry's own, as the manifest's source roots
fun source_roots(s: *session.Session, m: *manifest.Manifest, bindings: *Vector[Binding], own: usize) err[fail.Fail] {
    var n: usize = bindings.len;
    if (own < bindings.len) { n = n - 1; }
    if (n == 0)             { ret err[fail.Fail].ok{}; }
    val made: res[*manifest.SourceRoot, A.Error] = A.allocate[manifest.SourceRoot](s.build_alloc, n);
    if (sel made.err) { ret err[fail.Fail].err{fail.refused(made.err)}; }
    m.sources      = made.ok;
    m.source_count = n::u32;
    var at: usize = 0;
    var i:  usize = 0;
    for (i < bindings.len) {
        if (i == own) {
            i = i + 1;
            cnt;
        }
        val name: res[intern.StrId, A.Error] = intern.add(?s.interner, bindings.data[i].name);
        if (sel name.err) { ret err[fail.Fail].err{fail.refused(name.err)}; }
        val dir: res[intern.StrId, A.Error] = intern.add(?s.interner, bindings.data[i].dir);
        if (sel dir.err) { ret err[fail.Fail].err{fail.refused(dir.err)}; }
        m.sources[at] = manifest.SourceRoot{name: name.ok, dir: dir.ok};
        at            = at + 1;
        i             = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# the manifest text of the project an entry build states
fun manifest_text(a: *A.Allocator, r: *EntryRequest, id: str, src: str, entry: str, stem: str) res[str, fail.Fail] {
    var b: textbuild.TextBuilder = textbuild.tb_init(a);
    fin { textbuild.tb_dnit(?b); }

    val floor: res[str, std_format.FormatError] = driver_closure.running_mach_range_floor(a);
    if (sel floor.err) { ret res[str, fail.Fail].err{fail.message(fail.format_text(floor.err))}; }
    put(?b, "[project]\nid = ");
    quoted(?b, id);
    put(?b, "\nversion = \"0.0.0\"\nmach = ");
    quoted(?b, floor.ok);
    str_free(a, floor.ok);
    # a manifest's src is a child of the root, which the entry build's may not be; it is set after
    put(?b, "\nsrc = ");
    if (str_equals(src, ".")) { quoted(?b, "src"); }
    or                        { quoted(?b, src); }
    put(?b, "\nwork = ");
    quoted(?b, ENTRY_WORK);
    put(?b, "\n\n");

    if (r.optimize) { put(?b, "[profile.release]\n"); }
    or              { put(?b, "[profile.debug]\n"); }
    put(?b, "default = true\noptimize = ");
    flag(?b, r.optimize);
    put(?b, "\ndebug = ");
    flag(?b, r.debug);
    put(?b, "\nsimd = \"scalarize\"\n\n");

    val target: res[mink_target.Target, fail.Fail] = target_of(a, r);
    if (sel target.err) { ret res[str, fail.Fail].err{target.err}; }
    val stated: err[fail.Fail] = target_text(a, ?b, ?target.ok);
    if (sel stated.err) { ret res[str, fail.Fail].err{stated.err}; }
    val linked: err[fail.Fail] = linkage_admitted(a, r, ?target.ok);
    if (sel linked.err) { ret res[str, fail.Fail].err{linked.err}; }

    var libraries: *str  = nil;
    var library_n: usize = 0;
    if (!str_equals(r.kind, "static")) {
        libraries = target.ok.host.libraries;
        library_n = target.ok.host.library_count;
    }

    put(?b, "[artifact.");
    put(?b, id);
    put(?b, "]\nkind = ");
    quoted(?b, r.kind);
    if (r.linkage != nil) {
        put(?b, "\nlinkage = ");
        quoted(?b, r.linkage);
    }
    put(?b, "\ndefault = true\nentry = ");
    quoted(?b, entry);
    put(?b, "\nout = \"");
    put(?b, stem);
    put(?b, "{artifact.suffix}\"\ntargets = [\"*\"]\n");
    var k: usize = 0;
    for (k < library_n) {
        if (k == 0) { put(?b, "link = ["); }
        or          { put(?b, ", "); }
        put(?b, "\"");
        stem_of(?b, libraries[k]);
        put(?b, "\"");
        k = k + 1;
    }
    if (library_n > 0) { put(?b, "]\n"); }
    put(?b, "\n");
    k = 0;
    for (k < library_n) {
        put(?b, "[link.");
        stem_of(?b, libraries[k]);
        put(?b, "]\nsource = \"system\"\nname = ");
        quoted(?b, libraries[k]);
        put(?b, "\nsys = [\"*\"]\narch = [\"*\"]\nabi = [\"*\"]\n\n");
        k = k + 1;
    }

    val made: res[str, textbuild.Error] = textbuild.tb_finish(?b);
    if (sel made.err) { ret res[str, fail.Fail].err{fail.message(textbuild.text(made.err))}; }
    ret res[str, fail.Fail].ok{made.ok};
}

# `--linkage` as mink's catalog resolves it against the target: refused for a product other
# than bin, which no linkage applies to, and in mink's words where the target's loader runs no
# executable of it. a `-k` naming no product is the manifest's to refuse
fun linkage_admitted(a: *A.Allocator, r: *EntryRequest, t: *mink_target.Target) err[fail.Fail] {
    if (r.linkage == nil) { ret err[fail.Fail].ok{}; }
    val product: res[*Product, mink_fail.Fail] = mink_product.by_name(r.kind);
    if (sel product.err) { ret err[fail.Fail].ok{}; }
    if (!lang_target.is_executable(product.ok)) {
        ret err[fail.Fail].err{fail.formatted_user(a, diagnostic_kind.CLI_FLAG_INAPPLICABLE,
            "--linkage applies only to -k bin, as only an executable is linked as one, and -k {} makes no executable", r.kind)};
    }
    val l: res[*Linkage, mink_target.Refusal] = mink_target.linkage(t, r.linkage);
    if (sel l.err) { ret err[fail.Fail].err{target_host.refused(a, diagnostic_kind.CLI_FLAG_VALUE, ?l.err)}; }
    ret err[fail.Fail].ok{};
}

# the target the command line states, resolved by mink's catalog: `-t`, or the host's own system
# and architecture where it is left out, narrowed by the narrowing flags. every part they leave
# out is the catalog's
fun target_of(a: *A.Allocator, r: *EntryRequest) res[mink_target.Target, fail.Fail] {
    var spec: mink_target.Spec;
    if (r.target != nil) {
        val parsed: res[mink_target.Spec, mink_target.Refusal] = mink_target.parse(r.target);
        if (sel parsed.err) { ret res[mink_target.Target, fail.Fail].err{target_host.refused(a, diagnostic_kind.CLI_FLAG_VALUE, ?parsed.err)}; }
        spec = parsed.ok;
    }
    or {
        val sys: res[*mink_os.System, mink_fail.Fail] = mink_os_list.by_name(lang_target.host_sys_name());
        if (sel sys.err) { ret res[mink_target.Target, fail.Fail].err{target_host.refusal(a, sys.err)}; }
        val arch: res[*mink_arch.Arch, mink_fail.Fail] = mink_arch_list.by_name(lang_target.host_arch_name());
        if (sel arch.err) { ret res[mink_target.Target, fail.Fail].err{target_host.refusal(a, arch.err)}; }
        spec = mink_target.Spec{sys: sys.ok, arch: arch.ok};
    }
    val n:        *Narrowing                                   = ?r.narrowing;
    var narrowed: mink_target.Narrowing                        = mink_target.Narrowing{env: n.env, abi: n.abi, isa: n.isa, ext: n.exts, ext_count: n.ext_count, code_model: n.code_model};
    val resolved: res[mink_target.Target, mink_target.Refusal] = mink_target.resolve(spec, ?narrowed);
    if (sel resolved.err) { ret res[mink_target.Target, fail.Fail].err{target_host.refused(a, diagnostic_kind.CLI_FLAG_VALUE, ?resolved.err)}; }
    ret res[mink_target.Target, fail.Fail].ok{resolved.ok};
}

# the one `[target]` table of an entry build, every key as mink's catalog resolved it. the object
# format is the system's, so the table states none
fun target_text(a: *A.Allocator, b: *textbuild.TextBuilder, t: *mink_target.Target) err[fail.Fail] {
    val isa: res[str, mink_target.Refusal] = mink_target.isa(t);
    if (sel isa.err) { ret err[fail.Fail].err{target_host.refused(a, diagnostic_kind.CLI_FLAG_VALUE, ?isa.err)}; }
    val abi: res[opt[*mink_arch.Abi], mink_target.Refusal] = mink_target.abi(t);
    if (sel abi.err) { ret err[fail.Fail].err{target_host.refused(a, diagnostic_kind.CLI_FLAG_VALUE, ?abi.err)}; }
    put(b, "[target.");
    put_name(b, t.sys.name);
    put(b, "-");
    put_name(b, t.arch.name);
    put(b, "]\n");
    key(b, "arch", t.arch.name);
    key(b, "sys", t.sys.name);
    if (sel abi.ok.some) { key(b, "abi", abi.ok.some.name); }
    if (sel t.env.some)  { key(b, "env", t.env.some.name); }
    key(b, "isa", isa.ok);
    if (sel t.code_model.some) { key(b, "code_model", t.code_model.some.name); }
    var i: usize = 0;
    for (i < t.ext_count) {
        if (i == 0) { put(b, "ext = ["); }
        or          { put(b, ", "); }
        quoted(b, t.ext[i]);
        i = i + 1;
    }
    if (t.ext_count > 0) { put(b, "]\n"); }
    put(b, "\n");
    ret err[fail.Fail].ok{};
}

# `name = "value"` on a line of its own
fun key(b: *textbuild.TextBuilder, name: str, value: str) {
    put(b, name);
    put(b, " = ");
    quoted(b, value);
    put(b, "\n");
}

fun put(b: *textbuild.TextBuilder, text: str) {
    textbuild.tb_append(b, text);
}

fun flag(b: *textbuild.TextBuilder, on: bool) {
    if (on) { put(b, "true"); }
    or      { put(b, "false"); }
}

# `text` as a toml basic string
fun quoted(b: *textbuild.TextBuilder, text: str) {
    var one: [3]u8;
    one[2] = 0;
    put(b, "\"");
    var i: usize = 0;
    for (text[i] != 0) {
        val c: u8 = text[i];
        if (c == '"' || c == '\\') {
            one[0] = '\\';
            one[1] = c;
        }
        or {
            one[0] = c;
            one[1] = 0;
        }
        put(b, (?one[0])::str);
        i = i + 1;
    }
    put(b, "\"");
}

# `text` as a table key: every byte a bare key does not take as '_'
fun put_name(b: *textbuild.TextBuilder, text: str) {
    var one: [2]u8;
    one[1] = 0;
    var i: usize = 0;
    for (text[i] != 0) {
        val c: u8 = text[i];
        one[0] = '_';
        if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '-' || c == '_') { one[0] = c; }
        put(b, (?one[0])::str);
        i = i + 1;
    }
}

# a library's name up to its first '.', the key its link table goes by
fun stem_of(b: *textbuild.TextBuilder, library: str) {
    var one: [2]u8;
    one[1] = 0;
    var n: usize = 0;
    for (library[n] != 0 && library[n] != '.') {
        one[0] = library[n];
        put(b, (?one[0])::str);
        n = n + 1;
    }
}
