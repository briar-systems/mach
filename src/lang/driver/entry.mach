# an entry build: one artifact of one entry file built with no mach.toml, the command line
# stating the whole project. the project it states is made as the manifest's model and held to
# the checks every manifest passes, so the build that follows cannot tell the two apart
use std.collections.vector.Vector;
use collections_vector: std.collections.vector;
use std_format:         std.format;
use std.text.string.str_dup_range;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use types_path: std.types.path;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_empty;
use std.types.string.str_ends_with;
use std.types.string.str_equals;
use std.types.string.str_index_char;
use std.types.string.str_len;
use std.types.string.str_starts_with;

use A: std.allocator;

use diagnostic_kind: mach.lang.diagnostic.kind;
use driver_closure:  mach.lang.driver.closure;
use mach.lang.fail;
use mach.lang.intern;
use mach.lang.manifest;
use mach.lang.session;
use lang_target: mach.lang.target;
use mach.lang.target.resolved;
use mach.lang.textbuild;
use mink_fail: mink.base.fail;
use mink_arch: mink.catalog.arch;
use mink.catalog.output.linkage.Linkage;
use mink_product: mink.catalog.output.product;
use mink.catalog.output.product.Product;
use mink_target: mink.catalog.target;

# the flags that narrow an entry build's target, each as written and nil when absent
# ---
# env:        `--env`
# abi:        `--abi`
# isa:        `--isa`
# exts:       every `--ext`, in argv order
# ext_count:  length of `exts`
# code_model: `--code-model`
pub rec Narrowing {
    env:        str;
    abi:        str;
    isa:        str;
    exts:       *str;
    ext_count:  usize;
    code_model: str;
}

# whether any narrowing flag is given
pub fun narrowed(n: *Narrowing) bool {
    ret n.env != nil || n.abi != nil || n.isa != nil || n.ext_count > 0 || n.code_model != nil;
}

# what the command line states of an entry build
# ---
# entry:        the entry file, a canonical path under the current directory
# kind:         the artifact's product, mink's spelling
# linkage:      the `--linkage` spelling, nil for the target's default
# sources:      each `-s` value, `name=dir` as written
# source_count: length of `sources`
# target:       the `-t` spelling, nil for the host's system and architecture
# narrowing:    the flags that narrow the target
# optimize:     the build runs the optimization pass set
# debug:        the build emits debug information
pub rec EntryRequest {
    entry:        str;
    kind:         str;
    linkage:      str;
    sources:      *str;
    source_count: usize;
    target:       str;
    narrowing:    Narrowing;
    optimize:     bool;
    debug:        bool;
}

# the work directory an entry build lays its intermediates in, `mach init`'s
val ENTRY_WORK: str = "out/{target.name}/{profile.name}";

# the rule an entry build's entry keeps
val ENTRY_CONSTRAINT: str = "an entry build's entry must be a .mach file inside the current directory, named by a relative path with no . or .. component";

# one `-s` binding, split
rec Binding {
    name: str;
    dir:  str;
}

# the project an entry build states, made as its manifest. the project root is the current
# directory, so `-o` and `-w` keep the rules they keep in a project
# ---
# s:   the session whose build allocator owns the manifest and whose interner holds its names
# r:   what the command line states
# ret: the manifest, owned by the session's build allocator; err as the command line names
#      no buildable project
pub fun entry_manifest(s: *session.Session, r: *EntryRequest) res[manifest.Manifest, fail.Fail] {
    val a: *A.Allocator = s.build_alloc;
    if (!manifest.is_project_path(r.entry) || !str_ends_with(r.entry, ".mach")) {
        ret res[manifest.Manifest, fail.Fail].err{fail.user(diagnostic_kind.CLI_OPERAND, ENTRY_CONSTRAINT)};
    }

    var bindings: Vector[Binding] = collections_vector.init[Binding](a);
    fin { collections_vector.dnit[Binding](?bindings); }
    var i: usize = 0;
    for (i < r.source_count) {
        val split: res[Binding, fail.Fail] = binding_of(a, r.sources[i]);
        if (sel split.err) { ret res[manifest.Manifest, fail.Fail].err{split.err}; }
        var k: usize = 0;
        for (k < bindings.len) {
            if (str_equals(bindings.data[k].name, split.ok.name)) {
                ret res[manifest.Manifest, fail.Fail].err{fail.formatted_user(a, diagnostic_kind.CLI_FLAG_VALUE, "-s binds '{}' twice", split.ok.name)};
            }
            k = k + 1;
        }
        val pushed: res[usize, A.Error] = collections_vector.push[Binding](?bindings, split.ok);
        if (sel pushed.err) { ret res[manifest.Manifest, fail.Fail].err{fail.refused(pushed.err)}; }
        i = i + 1;
    }

    # the entry's own package is the binding whose directory holds it, else the entry's
    # directory under the entry's stem
    val file:   str               = types_path.filename(r.entry);
    val stem_r: res[str, A.Error] = str_dup_range(a, file, 0, str_len(file) - 5);
    if (sel stem_r.err) { ret res[manifest.Manifest, fail.Fail].err{fail.refused(stem_r.err)}; }
    val stem:  str   = stem_r.ok;
    var id:    str   = stem;
    var src:   str   = ".";
    var entry: str   = file;
    var own:   usize = bindings.len;
    i = 0;
    for (i < bindings.len) {
        val dir: str = bindings.data[i].dir;
        if (str_equals(dir, "."))                                                                           { own = i; }
        or (manifest.is_project_path(dir) && str_starts_with(r.entry, dir) && r.entry[str_len(dir)] == '/') { own = i; }
        i = i + 1;
    }
    if (own < bindings.len) {
        id  = bindings.data[own].name;
        src = bindings.data[own].dir;
        if (!str_equals(src, ".")) { entry = (?r.entry[str_len(src) + 1])::str; }
        or                         { entry = r.entry; }
    }
    or {
        if (!manifest.is_valid_id(stem)) {
            ret res[manifest.Manifest, fail.Fail].err{fail.formatted_user(a, diagnostic_kind.CLI_OPERAND,
                "the entry's stem '{}' is no project id; name the entry's source root with -s <name>=<dir>", stem)};
        }
        val parent: res[str, A.Error] = types_path.parent(a, r.entry);
        if (sel parent.err)        { ret res[manifest.Manifest, fail.Fail].err{fail.refused(parent.err)}; }
        if (!str_empty(parent.ok)) { src = parent.ok; }
    }

    var m:      manifest.Manifest = manifest.empty();
    var handed: bool              = false;
    fin {
        if (!handed) { manifest.dnit(?m, a); }
    }
    val made: err[fail.Fail] = entry_model(s, r, id, src, entry, stem, ?m);
    if (sel made.err) { ret res[manifest.Manifest, fail.Fail].err{made.err}; }
    val roots: err[fail.Fail] = source_roots(s, ?m, ?bindings, own);
    if (sel roots.err) { ret res[manifest.Manifest, fail.Fail].err{roots.err}; }
    val checked: err[fail.Fail] = manifest.check(a, ?s.interner, ?m);
    if (sel checked.err) { ret res[manifest.Manifest, fail.Fail].err{checked.err}; }
    handed = true;
    ret res[manifest.Manifest, fail.Fail].ok{m};
}

# `name=dir`, split at its first `=`, its directory cleaned
fun binding_of(a: *A.Allocator, written: str) res[Binding, fail.Fail] {
    val found: opt[usize] = str_index_char(written, '=');
    var at:    usize      = 0;
    if (sel found.some) { at = found.some; }
    if (at == 0 || at + 1 >= str_len(written)) {
        ret res[Binding, fail.Fail].err{fail.formatted_user(a, diagnostic_kind.CLI_FLAG_VALUE, "-s '{}' must be written <name>=<dir>", written)};
    }
    val name: res[str, A.Error] = str_dup_range(a, written, 0, at);
    if (sel name.err) { ret res[Binding, fail.Fail].err{fail.refused(name.err)}; }
    if (!manifest.is_valid_id(name.ok)) {
        ret res[Binding, fail.Fail].err{fail.formatted_user(a, diagnostic_kind.CLI_FLAG_VALUE, "-s '{}' must name a portable identifier (letters, digits, '_', '-')", written)};
    }
    # `./src` and `src/` bind the directory `src` does
    val dir: res[str, A.Error] = types_path.clean(a, (?written[at + 1])::str);
    if (sel dir.err) { ret res[Binding, fail.Fail].err{fail.refused(dir.err)}; }
    ret res[Binding, fail.Fail].ok{Binding{name: name.ok, dir: dir.ok}};
}

# every binding but the entry's own, as the manifest's source roots
fun source_roots(s: *session.Session, m: *manifest.Manifest, bindings: *Vector[Binding], own: usize) err[fail.Fail] {
    var n: usize = bindings.len;
    if (own < bindings.len) { n = n - 1; }
    if (n == 0)             { ret err[fail.Fail].ok{}; }
    val made: res[*manifest.SourceRoot, A.Error] = A.allocate[manifest.SourceRoot](s.build_alloc, n);
    if (sel made.err) { ret err[fail.Fail].err{fail.refused(made.err)}; }
    m.sources      = made.ok;
    m.source_count = n::u32;
    var at: usize = 0;
    var i:  usize = 0;
    for (i < bindings.len) {
        if (i == own) {
            i = i + 1;
            cnt;
        }
        val name: res[intern.StrId, A.Error] = intern.add(?s.interner, bindings.data[i].name);
        if (sel name.err) { ret err[fail.Fail].err{fail.refused(name.err)}; }
        val dir: res[intern.StrId, A.Error] = intern.add(?s.interner, bindings.data[i].dir);
        if (sel dir.err) { ret err[fail.Fail].err{fail.refused(dir.err)}; }
        m.sources[at] = manifest.SourceRoot{name: name.ok, dir: dir.ok};
        at            = at + 1;
        i             = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# the project an entry build states, made into `m`: the project, one profile, the one target
# the command line resolves to, one artifact, and a system link of each library the target's
# host links an executable against
fun entry_model(s: *session.Session, r: *EntryRequest, id: str, src: str, entry: str, stem: str, m: *manifest.Manifest) err[fail.Fail] {
    val a:   *A.Allocator     = s.build_alloc;
    val itn: *intern.Interner = ?s.interner;

    val floor: res[str, std_format.FormatError] = driver_closure.running_mach_range_floor(a);
    if (sel floor.err) { ret err[fail.Fail].err{fail.message(fail.format_text(floor.err))}; }
    val mach: res[intern.StrId, fail.Fail] = id_of(itn, floor.ok);
    str_free(a, floor.ok);
    if (sel mach.err) { ret err[fail.Fail].err{mach.err}; }
    m.mach = mach.ok;
    var texts: [5]str = [5]str{id, "0.0.0", src, ENTRY_WORK, "*"};
    var ids:   [5]intern.StrId;
    var k:     usize  = 0;
    for (k < 5) {
        val got: res[intern.StrId, fail.Fail] = id_of(itn, texts[k]);
        if (sel got.err) { ret err[fail.Fail].err{got.err}; }
        ids[k] = got.ok;
        k      = k + 1;
    }
    m.id        = ids[0];
    m.version   = ids[1];
    m.src       = ids[2];
    m.work_tmpl = ids[3];
    val any: intern.StrId = ids[4];

    var profile_name: str = "debug";
    if (r.optimize) { profile_name = "release"; }
    val profiled: err[fail.Fail] = entry_profile(a, itn, r, profile_name, m);
    if (sel profiled.err) { ret profiled; }

    val product: res[*Product, mink_fail.Fail] = mink_product.by_name(r.kind);
    if (sel product.err) {
        val choices: res[str, fail.Fail] = manifest.product_choices(a);
        if (sel choices.err) { ret err[fail.Fail].err{choices.err}; }
        ret err[fail.Fail].err{fail.formatted_user(a, diagnostic_kind.CLI_FLAG_VALUE, "-k {} names no product; write {}, mink's products", r.kind, choices.ok)};
    }
    if (r.linkage != nil && !lang_target.is_executable(product.ok)) {
        ret err[fail.Fail].err{fail.formatted_user(a, diagnostic_kind.CLI_FLAG_INAPPLICABLE,
            "--linkage applies only to -k bin, as only an executable is linked as one, and -k {} makes no executable", r.kind)};
    }
    val target: res[mink_target.Target, fail.Fail] = target_of(a, r);
    if (sel target.err) { ret err[fail.Fail].err{target.err}; }
    val stated: err[fail.Fail] = entry_target(a, itn, ?target.ok, m);
    if (sel stated.err) { ret stated; }
    # `--linkage` narrowed the target, so mink resolved it against the host
    var linked: opt[*Linkage] = opt[*Linkage].none{};
    if (r.linkage != nil) { linked = target.ok.linkage; }

    var libraries: *str  = nil;
    var library_n: usize = 0;
    if (!str_equals(r.kind, "static")) {
        libraries = target.ok.host.libraries;
        library_n = target.ok.host.library_count;
    }
    val links: err[fail.Fail] = entry_links(a, itn, libraries, library_n, any, m);
    if (sel links.err) { ret links; }
    ret entry_artifact(a, itn, id, product.ok, linked, entry, stem, any, m);
}

# the one profile, the default, as the command line states it
fun entry_profile(a: *A.Allocator, itn: *intern.Interner, r: *EntryRequest, name: str, m: *manifest.Manifest) err[fail.Fail] {
    val named: res[intern.StrId, fail.Fail] = id_of(itn, name);
    if (sel named.err) { ret err[fail.Fail].err{named.err}; }
    val made: res[*manifest.ProfileDef, A.Error] = A.allocate[manifest.ProfileDef](a, 1);
    if (sel made.err) { ret err[fail.Fail].err{fail.refused(made.err)}; }
    var pf: manifest.ProfileDef = manifest.profile_def();
    pf.name         = named.ok;
    pf.is_default   = true;
    pf.optimize     = r.optimize;
    pf.debug        = r.debug;
    made.ok[0]      = pf;
    m.profiles      = made.ok;
    m.profile_count = 1;
    ret err[fail.Fail].ok{};
}

# the one target, every key as mink's catalog resolved it, named `<sys>-<arch>`. the object
# format is the system's, so the target states none
fun entry_target(a: *A.Allocator, itn: *intern.Interner, t: *mink_target.Target, m: *manifest.Manifest) err[fail.Fail] {
    val isa: res[str, mink_target.Refusal] = mink_target.isa(t);
    if (sel isa.err) { ret err[fail.Fail].err{resolved.refused(a, diagnostic_kind.CLI_FLAG_VALUE, ?isa.err)}; }
    val abi: res[opt[*mink_arch.Abi], mink_target.Refusal] = mink_target.abi(t);
    if (sel abi.err) { ret err[fail.Fail].err{resolved.refused(a, diagnostic_kind.CLI_FLAG_VALUE, ?abi.err)}; }
    if (t.ext_count > resolved.MAX_ADDED::usize) {
        ret err[fail.Fail].err{fail.formatted_user(a, diagnostic_kind.EXTENSION_TOO_MANY, "--ext names more than {} extensions", resolved.MAX_ADDED)};
    }
    var d:    manifest.TargetDef           = manifest.target_def();
    val name: res[intern.StrId, fail.Fail] = target_name(a, itn, t);
    if (sel name.err) { ret err[fail.Fail].err{name.err}; }
    d.name = name.ok;
    var abi_name: str = "";
    if (sel abi.ok.some) { abi_name = abi.ok.some.name; }
    var texts: [4]str = [4]str{t.arch.name, t.sys.name, abi_name, isa.ok};
    var ids:   [4]intern.StrId;
    var k:     usize  = 0;
    for (k < 4) {
        val got: res[intern.StrId, fail.Fail] = id_of(itn, texts[k]);
        if (sel got.err) { ret err[fail.Fail].err{got.err}; }
        ids[k] = got.ok;
        k      = k + 1;
    }
    d.arch = ids[0];
    d.sys  = ids[1];
    d.abi  = ids[2];
    d.isa  = ids[3];
    if (sel t.env.some) {
        val env: res[intern.StrId, fail.Fail] = id_of(itn, t.env.some.name);
        if (sel env.err) { ret err[fail.Fail].err{env.err}; }
        d.env = env.ok;
    }
    if (sel t.code_model.some) {
        val model: res[intern.StrId, fail.Fail] = id_of(itn, t.code_model.some.name);
        if (sel model.err) { ret err[fail.Fail].err{model.err}; }
        d.code_model = model.ok;
    }
    var i: usize = 0;
    for (i < t.ext_count) {
        val ext: res[intern.StrId, fail.Fail] = id_of(itn, t.ext[i]);
        if (sel ext.err) { ret err[fail.Fail].err{ext.err}; }
        d.ext[i] = ext.ok;
        i        = i + 1;
    }
    d.ext_count = t.ext_count::u32;
    val made: res[*manifest.TargetDef, A.Error] = A.allocate[manifest.TargetDef](a, 1);
    if (sel made.err) { ret err[fail.Fail].err{fail.refused(made.err)}; }
    made.ok[0]     = d;
    m.targets      = made.ok;
    m.target_count = 1;
    ret err[fail.Fail].ok{};
}

# `<sys>-<arch>`, every byte a portable identifier does not take as '_'
fun target_name(a: *A.Allocator, itn: *intern.Interner, t: *mink_target.Target) res[intern.StrId, fail.Fail] {
    var b: textbuild.TextBuilder = textbuild.tb_init(a);
    fin { textbuild.tb_dnit(?b); }
    put_name(?b, t.sys.name);
    textbuild.tb_append(?b, "-");
    put_name(?b, t.arch.name);
    val made: res[str, textbuild.Error] = textbuild.tb_finish(?b);
    if (sel made.err) { ret res[intern.StrId, fail.Fail].err{fail.message(textbuild.text(made.err))}; }
    val name: res[intern.StrId, fail.Fail] = id_of(itn, made.ok);
    str_free(a, made.ok);
    ret name;
}

# a system link of each of the `n` libraries, keyed by its name up to its first '.', on every
# target
fun entry_links(a: *A.Allocator, itn: *intern.Interner, libraries: *str, n: usize, any: intern.StrId, m: *manifest.Manifest) err[fail.Fail] {
    if (n == 0) { ret err[fail.Fail].ok{}; }
    val made: res[*manifest.LinkDef, A.Error] = A.allocate[manifest.LinkDef](a, n);
    if (sel made.err) { ret err[fail.Fail].err{fail.refused(made.err)}; }
    m.links      = made.ok;
    m.link_count = n::u32;
    var i: usize = 0;
    for (i < n) {
        m.links[i] = manifest.link_def();
        i          = i + 1;
    }
    i = 0;
    for (i < n) {
        var l:    manifest.LinkDef  = manifest.link_def();
        val stem: res[str, A.Error] = str_dup_range(a, libraries[i], 0, stem_len(libraries[i]));
        if (sel stem.err) { ret err[fail.Fail].err{fail.refused(stem.err)}; }
        val name: res[intern.StrId, fail.Fail] = id_of(itn, stem.ok);
        str_free(a, stem.ok);
        if (sel name.err) { ret err[fail.Fail].err{name.err}; }
        val lib: res[intern.StrId, fail.Fail] = id_of(itn, libraries[i]);
        if (sel lib.err) { ret err[fail.Fail].err{lib.err}; }
        l.name     = name.ok;
        l.source   = manifest.LINK_SYSTEM;
        l.lib_name = lib.ok;
        m.links[i] = l;
        val sys: err[fail.Fail] = every(a, any, ?m.links[i].sys, ?m.links[i].sys_count);
        if (sel sys.err) { ret sys; }
        val arch: err[fail.Fail] = every(a, any, ?m.links[i].arch, ?m.links[i].arch_count);
        if (sel arch.err) { ret arch; }
        val abi: err[fail.Fail] = every(a, any, ?m.links[i].abi, ?m.links[i].abi_count);
        if (sel abi.err) { ret abi; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# the one artifact, the default, which builds for every target and links every link
fun entry_artifact(a: *A.Allocator, itn: *intern.Interner, id: str, kind: *Product, linkage: opt[*Linkage], entry: str, stem: str,
    any: intern.StrId, m: *manifest.Manifest) err[fail.Fail] {
    var d: manifest.ArtifactDef  = manifest.artifact_def();
    var b: textbuild.TextBuilder = textbuild.tb_init(a);
    fin { textbuild.tb_dnit(?b); }
    textbuild.tb_append(?b, stem);
    textbuild.tb_append(?b, "{artifact.suffix}");
    val out: res[str, textbuild.Error] = textbuild.tb_finish(?b);
    if (sel out.err) { ret err[fail.Fail].err{fail.message(textbuild.text(out.err))}; }
    var texts: [3]str = [3]str{id, entry, out.ok};
    var ids:   [3]intern.StrId;
    var k:     usize  = 0;
    for (k < 3) {
        val got: res[intern.StrId, fail.Fail] = id_of(itn, texts[k]);
        if (sel got.err) { ret err[fail.Fail].err{got.err}; }
        ids[k] = got.ok;
        k      = k + 1;
    }
    str_free(a, out.ok);
    d.name               = ids[0];
    d.kind               = kind;
    d.entry              = ids[1];
    d.out                = ids[2];
    d.is_default         = true;
    d.linkage            = linkage;
    d.linkage_from.named = "--linkage";
    val made: res[*manifest.ArtifactDef, A.Error] = A.allocate[manifest.ArtifactDef](a, 1);
    if (sel made.err) { ret err[fail.Fail].err{fail.refused(made.err)}; }
    made.ok[0]       = d;
    m.artifacts      = made.ok;
    m.artifact_count = 1;
    val targets: err[fail.Fail] = every(a, any, ?made.ok.targets, ?made.ok.target_count);
    if (sel targets.err)   { ret targets; }
    if (m.link_count == 0) { ret err[fail.Fail].ok{}; }
    val links: res[*intern.StrId, A.Error] = A.allocate[intern.StrId](a, m.link_count::usize);
    if (sel links.err) { ret err[fail.Fail].err{fail.refused(links.err)}; }
    made.ok.link       = links.ok;
    made.ok.link_count = m.link_count;
    var i: u32 = 0;
    for (i < m.link_count) {
        links.ok[i] = m.links[i].name;
        i           = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# a list of the one entry `any`, `*`, over `items` and `count`
fun every(a: *A.Allocator, any: intern.StrId, items: **intern.StrId, count: *u32) err[fail.Fail] {
    val made: res[*intern.StrId, A.Error] = A.allocate[intern.StrId](a, 1);
    if (sel made.err) { ret err[fail.Fail].err{fail.refused(made.err)}; }
    made.ok[0] = any;
    @items     = made.ok;
    @count     = 1;
    ret err[fail.Fail].ok{};
}

# the id of `text`, interned in `itn`
fun id_of(itn: *intern.Interner, text: str) res[intern.StrId, fail.Fail] {
    val r: res[intern.StrId, A.Error] = intern.add(itn, text);
    if (sel r.err) { ret res[intern.StrId, fail.Fail].err{fail.refused(r.err)}; }
    ret res[intern.StrId, fail.Fail].ok{r.ok};
}

# the target the command line states, resolved by mink's catalog: `-t`, or the host's own system
# and architecture where it is left out, narrowed by the narrowing flags and `--linkage`. every
# part they leave out is the catalog's
fun target_of(a: *A.Allocator, r: *EntryRequest) res[mink_target.Target, fail.Fail] {
    var spec: mink_target.Spec;
    if (r.target != nil) {
        val parsed: res[mink_target.Spec, mink_target.Refusal] = mink_target.parse(r.target);
        if (sel parsed.err) { ret res[mink_target.Target, fail.Fail].err{resolved.refused(a, diagnostic_kind.CLI_FLAG_VALUE, ?parsed.err)}; }
        spec = parsed.ok;
    }
    or {
        val host: res[mink_target.Spec, mink_target.Refusal] = resolved.spec_of(lang_target.host_sys_name(), lang_target.host_arch_name());
        if (sel host.err) { ret res[mink_target.Target, fail.Fail].err{resolved.refused(a, diagnostic_kind.CLI_FLAG_VALUE, ?host.err)}; }
        spec = host.ok;
    }
    val n:        *Narrowing                                   = ?r.narrowing;
    var narrowed: mink_target.Narrowing                        = mink_target.Narrowing{env: n.env, abi: n.abi, isa: n.isa, ext: n.exts, ext_count: n.ext_count, code_model: n.code_model, linkage: r.linkage, format: nil};
    val got:      res[mink_target.Target, mink_target.Refusal] = mink_target.resolve(spec, ?narrowed);
    if (sel got.err) { ret res[mink_target.Target, fail.Fail].err{resolved.refused(a, diagnostic_kind.CLI_FLAG_VALUE, ?got.err)}; }
    ret res[mink_target.Target, fail.Fail].ok{got.ok};
}

# `text` as a portable identifier: every byte one does not take as '_'
fun put_name(b: *textbuild.TextBuilder, text: str) {
    var one: [2]u8;
    one[1] = 0;
    var i: usize = 0;
    for (text[i] != 0) {
        val c: u8 = text[i];
        one[0] = '_';
        if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '-' || c == '_') { one[0] = c; }
        textbuild.tb_append(b, (?one[0])::str);
        i = i + 1;
    }
}

# the length of a library's name up to its first '.', the key its link goes by
fun stem_len(library: str) usize {
    var n: usize = 0;
    for (library[n] != 0 && library[n] != '.') { n = n + 1; }
    ret n;
}
