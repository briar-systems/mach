# the record an `obj/` object carries for the object cache in its `.mach.cache`
# section: the key the object was built under and what the engine reads from a
# module's lowered unit besides its object, so a module whose object is reused
# never has to lower. the object itself is what mink reads back from the file.
# the layout is `"MCRB"`, the 32-byte key, the 32-byte digest of the
# source its back half's warnings are placed in, zero when it holds none, the test count, then per test its qualified name and
# its line, then the length and bytes of the module's warnings (driver/cache
# encodes them), then the count of the instances the module's code asks for and
# per instance its symbol, its reach and the offset and length of where the
# module's source asks for it, then the count of the symbols the module defines
# for its test object to declare and per symbol its name, then the count of the
# instances the object holds a copy of and per instance its symbol, its
# 32-byte key and the count and names of the modules it reads, every number a
# little-endian u32 and every name its length then its bytes

use mach.lang.fail;
use mach.lang.intern;
use lang_source: mach.lang.source;
use mach.lang.wire;
use A:                  std.allocator;
use collections_vector: std.collections.vector;
use std.memory;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

val MAGIC: u32 = 0x4252434D;
val FIXED: u32 = 76;

pub rec TestFact {
    name: intern.StrId;
    line: u32;
}

pub rec Facts {
    # the digest of the source the object's back half's warnings are placed in, all
    # zero when it reported none: an instance unit is keyed without its origin's
    # other code, so it is reused across an edit there, and its recorded warnings
    # stand only for the source they were reported in
    source:     [32]u8;
    tests:      *TestFact;
    test_count: u32;
    # the diagnostics short of errors building the module reported, which a
    # build that reuses the object reports again
    warnings:     *u8;
    warnings_len: u32;
    # every instance the module's code asks for, as its typing found them: a build that
    # skips the module's front end reads its demand here. a test object's record holds none
    asked:       *Asked;
    asked_count: u32;
    # every symbol the module defines under a binding other objects see, which its test object
    # declares instead: kept for a module that declares tests, none otherwise
    defined:       *intern.StrId;
    defined_count: u32;
    # every instance the object holds a copy of, which constant-time code calls, under the key it
    # had when the object was built: the object stands only while each keys the same
    copies:      *Copy;
    copy_count:  u32;
    copy_reads:  *intern.StrId;
    reads_count: u32;
}

# an instance the object holds a copy of: its symbol, its key (driver/cache, instance_key) and the
# modules it reads, the `count` names of `copy_reads` from `first`, its declaring module first
pub rec Copy {
    name:  intern.StrId;
    key:   [32]u8;
    first: u32;
    count: u32;
}

# an instance the module's code asks for: its symbol, the objects the module's code reaches it
# from (a sema_instance.Reach) and where in the module's source it is asked for
pub rec Asked {
    name:  intern.StrId;
    reach: u8;
    span:  lang_source.Span;
}

pub rec Record {
    key:   [32]u8;
    facts: Facts;
}

# release recorded facts; nil facts hold nothing
pub fun facts_dnit(alloc: *A.Allocator, f: *Facts) {
    if (f == nil)                                                  { ret; }
    if (f.tests != nil && f.test_count != 0 && alloc != nil)       { A.deallocate[TestFact](alloc, f.tests, f.test_count::usize); }
    if (f.warnings != nil && f.warnings_len != 0 && alloc != nil)  { A.deallocate[u8](alloc, f.warnings, f.warnings_len::usize); }
    if (f.asked != nil && f.asked_count != 0 && alloc != nil)      { A.deallocate[Asked](alloc, f.asked, f.asked_count::usize); }
    if (f.defined != nil && f.defined_count != 0 && alloc != nil)  { A.deallocate[intern.StrId](alloc, f.defined, f.defined_count::usize); }
    if (f.copies != nil && f.copy_count != 0 && alloc != nil)      { A.deallocate[Copy](alloc, f.copies, f.copy_count::usize); }
    if (f.copy_reads != nil && f.reads_count != 0 && alloc != nil) { A.deallocate[intern.StrId](alloc, f.copy_reads, f.reads_count::usize); }
    f.warnings      = nil;
    f.warnings_len  = 0;
    f.tests         = nil;
    f.test_count    = 0;
    f.asked         = nil;
    f.asked_count   = 0;
    f.defined       = nil;
    f.defined_count = 0;
    f.copies        = nil;
    f.copy_count    = 0;
    f.copy_reads    = nil;
    f.reads_count   = 0;
}

# release a record; a nil record holds nothing
pub fun record_dnit(alloc: *A.Allocator, r: *Record) {
    if (r == nil) { ret; }
    facts_dnit(alloc, ?r.facts);
}

fun name_text(itn: *intern.Interner, id: intern.StrId) opt[str] {
    if (intern.str_is_nil(id)) { ret opt[str].none{}; }
    ret intern.get(itn, id);
}

fun put_record(w: *wire.Sink, itn: *intern.Interner, key: *[32]u8, facts: *Facts) {
    wire.put_u32(w, MAGIC);
    wire.put_bytes(w, ?(@key)[0], 32);
    wire.put_bytes(w, ?facts.source[0], 32);
    wire.put_u32(w, facts.test_count);
    var i: u32 = 0;
    for (i < facts.test_count) {
        val t:        *TestFact = ?facts.tests[i];
        val opt_text: opt[str]  = name_text(itn, t.name);
        if (sel opt_text.none) {
            wire.refuse(w, fail.message("cache record test has no name"));
            ret;
        }
        wire.put_sized(w, opt_text.some::*u8, str_len(opt_text.some));
        wire.put_u32(w, t.line);
        i = i + 1;
    }
    wire.put_sized(w, facts.warnings, facts.warnings_len::usize);
    wire.put_u32(w, facts.asked_count);
    i = 0;
    for (i < facts.asked_count) {
        val a:        *Asked   = ?facts.asked[i];
        val opt_text: opt[str] = name_text(itn, a.name);
        if (sel opt_text.none) {
            wire.refuse(w, fail.message("cache record instance has no name"));
            ret;
        }
        if (a.span.offset > 0xFFFFFFFF || a.span.len > 0xFFFFFFFF) {
            wire.refuse(w, fail.message("cache record instance lies past the record's reach"));
            ret;
        }
        wire.put_sized(w, opt_text.some::*u8, str_len(opt_text.some));
        wire.put_u32(w, a.reach::u32);
        wire.put_u32(w, a.span.offset::u32);
        wire.put_u32(w, a.span.len::u32);
        i = i + 1;
    }
    wire.put_u32(w, facts.defined_count);
    i = 0;
    for (i < facts.defined_count) {
        val opt_text: opt[str] = name_text(itn, facts.defined[i]);
        if (sel opt_text.none) {
            wire.refuse(w, fail.message("cache record symbol has no name"));
            ret;
        }
        wire.put_sized(w, opt_text.some::*u8, str_len(opt_text.some));
        i = i + 1;
    }
    wire.put_u32(w, facts.copy_count);
    i = 0;
    for (i < facts.copy_count) {
        val c:        *Copy    = ?facts.copies[i];
        val opt_text: opt[str] = name_text(itn, c.name);
        if (sel opt_text.none) {
            wire.refuse(w, fail.message("cache record copy has no name"));
            ret;
        }
        if (c.first::u64 + c.count::u64 > facts.reads_count::u64) {
            wire.refuse(w, fail.message("cache record copy reads past its modules"));
            ret;
        }
        wire.put_sized(w, opt_text.some::*u8, str_len(opt_text.some));
        wire.put_bytes(w, ?c.key[0], 32);
        wire.put_u32(w, c.count);
        var k: u32 = 0;
        for (k < c.count) {
            val opt_read: opt[str] = name_text(itn, facts.copy_reads[c.first + k]);
            if (sel opt_read.none) {
                wire.refuse(w, fail.message("cache record copy reads a module with no name"));
                ret;
            }
            wire.put_sized(w, opt_read.some::*u8, str_len(opt_read.some));
            k = k + 1;
        }
        i = i + 1;
    }
}

# the record for an object built under `key` whose module lowered to `facts`;
# the caller owns the bytes, allocated in alloc
pub fun encode(alloc: *A.Allocator, itn: *intern.Interner, key: *[32]u8, facts: *Facts,
    out_bytes: **u8, out_len: *u32) err[fail.Fail] {
    @out_bytes = nil;
    @out_len   = 0;
    var i: u32 = 0;
    for (i < facts.test_count) {
        val opt_text: opt[str] = name_text(itn, facts.tests[i].name);
        if (sel opt_text.none) { ret err[fail.Fail].err{fail.message("cache record test has no name")}; }
        i = i + 1;
    }
    var measure: wire.Sink = wire.measure();
    put_record(?measure, itn, key, facts);
    val opt_refused: opt[fail.Fail] = wire.failure(?measure);
    if (sel opt_refused.some)                       { ret err[fail.Fail].err{opt_refused.some}; }
    if (measure.failed || measure.len > 0xFFFFFFFF) { ret err[fail.Fail].err{fail.message("cache record exceeds the section size field")}; }
    val res_allocated: res[*u8, A.Error] = A.allocate[u8](alloc, measure.len);
    if (sel res_allocated.err) { ret err[fail.Fail].err{fail.refused(res_allocated.err)}; }
    var w: wire.Sink = wire.fixed(res_allocated.ok, measure.len);
    put_record(?w, itn, key, facts);
    @out_bytes = res_allocated.ok;
    @out_len   = measure.len::u32;
    ret err[fail.Fail].ok{};
}

# a recorded name, a test's or an instance's: nonempty and free of nul bytes, interned
fun take_name(r: *wire.Source, itn: *intern.Interner, oom: *bool) intern.StrId {
    var len:   usize = 0;
    val bytes: *u8   = wire.take_sized(r, ?len);
    if (bytes == nil || len == 0) {
        wire.reject(r);
        ret intern.STR_NIL;
    }
    var i: usize = 0;
    for (i < len) {
        if (bytes[i] == 0) {
            wire.reject(r);
            ret intern.STR_NIL;
        }
        i = i + 1;
    }
    val res_bytes_add: res[intern.StrId, A.Error] = intern.bytes_add(itn, bytes, len);
    if (sel res_bytes_add.err) {
        @oom = true;
        wire.reject(r);
        ret intern.STR_NIL;
    }
    ret res_bytes_add.ok;
}

# the record in `bytes`, or none when it is missing, truncated or malformed:
# an object whose record cannot be read is not reused. err only when
# allocation fails
pub fun decode(alloc: *A.Allocator, itn: *intern.Interner, bytes: *u8, len: usize) res[opt[Record], fail.Fail] {
    if (bytes == nil || len < FIXED::usize) { ret res[opt[Record], fail.Fail].ok{opt[Record].none{}}; }
    var r: wire.Source = wire.source(bytes, len);
    if (wire.take_u32(?r) != MAGIC) { ret res[opt[Record], fail.Fail].ok{opt[Record].none{}}; }
    var out: Record = Record{};
    wire.take_into(?r, ?out.key[0], 32);
    wire.take_into(?r, ?out.facts.source[0], 32);
    # every test takes at least its name length and its line
    val tests: u32 = wire.take_count(?r, 8);
    if (r.bad) { ret res[opt[Record], fail.Fail].ok{opt[Record].none{}}; }
    if (tests > 0) {
        val res_allocated: res[*TestFact, A.Error] = A.allocate[TestFact](alloc, tests::usize);
        if (sel res_allocated.err) { ret res[opt[Record], fail.Fail].err{fail.refused(res_allocated.err)}; }
        out.facts.tests      = res_allocated.ok;
        out.facts.test_count = tests;
    }
    var handed: bool = false;
    fin {
        if (!handed) { facts_dnit(alloc, ?out.facts); }
    }
    var oom: bool = false;
    var i:   u32  = 0;
    for (i < tests && !r.bad) {
        val nm:   intern.StrId = take_name(?r, itn, ?oom);
        val line: u32          = wire.take_u32(?r);
        out.facts.tests[i] = TestFact{name: nm, line: line};
        i                  = i + 1;
    }
    var warnings_len: usize = 0;
    val warnings:     *u8   = wire.take_sized(?r, ?warnings_len);
    if (!r.bad && warnings_len != 0) {
        val res_kept: res[*u8, A.Error] = A.allocate[u8](alloc, warnings_len);
        if (sel res_kept.err) { ret res[opt[Record], fail.Fail].err{fail.refused(res_kept.err)}; }
        memory.raw_copy(res_kept.ok::ptr, warnings::ptr, warnings_len);
        out.facts.warnings     = res_kept.ok;
        out.facts.warnings_len = warnings_len::u32;
    }
    # every instance takes at least its name length, one name byte, its reach and its place
    val asked: u32 = wire.take_count(?r, 17);
    if (!r.bad && asked > 0) {
        val res_allocated: res[*Asked, A.Error] = A.allocate[Asked](alloc, asked::usize);
        if (sel res_allocated.err) { ret res[opt[Record], fail.Fail].err{fail.refused(res_allocated.err)}; }
        out.facts.asked       = res_allocated.ok;
        out.facts.asked_count = asked;
    }
    i = 0;
    for (i < asked && !r.bad) {
        val nm:     intern.StrId = take_name(?r, itn, ?oom);
        val reach:  u32          = wire.take_u32(?r);
        val offset: u32          = wire.take_u32(?r);
        val len:    u32          = wire.take_u32(?r);
        if (reach > 0xFF) { wire.reject(?r); }
        out.facts.asked[i] = Asked{name: nm, reach: reach::u8, span: lang_source.Span{offset: offset::usize, len: len::usize}};
        i                  = i + 1;
    }
    # every symbol takes at least its name length and one name byte
    val defined: u32 = wire.take_count(?r, 5);
    if (!r.bad && defined > 0) {
        val res_allocated: res[*intern.StrId, A.Error] = A.allocate[intern.StrId](alloc, defined::usize);
        if (sel res_allocated.err) { ret res[opt[Record], fail.Fail].err{fail.refused(res_allocated.err)}; }
        out.facts.defined       = res_allocated.ok;
        out.facts.defined_count = defined;
    }
    i = 0;
    for (i < defined && !r.bad) {
        out.facts.defined[i] = take_name(?r, itn, ?oom);
        i                    = i + 1;
    }
    val err_taken: err[A.Error] = take_copies(?r, alloc, itn, ?out.facts, ?oom);
    if (sel err_taken.err) { ret res[opt[Record], fail.Fail].err{fail.refused(err_taken.err)}; }
    if (!wire.done(?r))    { wire.reject(?r); }
    if (r.bad) {
        if (oom) { ret res[opt[Record], fail.Fail].err{fail.message("out of memory decoding a cache record")}; }
        ret res[opt[Record], fail.Fail].ok{opt[Record].none{}};
    }
    handed = true;
    ret res[opt[Record], fail.Fail].ok{opt[Record].some{out}};
}

# the copies a record lists, into `facts`. every copy takes at least its name length, one name
# byte, its key and its read count, and every read at least its name length and one byte
fun take_copies(r: *wire.Source, alloc: *A.Allocator, itn: *intern.Interner, facts: *Facts, oom: *bool) err[A.Error] {
    val count: u32 = wire.take_count(r, 41);
    if (r.bad || count == 0) { ret err[A.Error].ok{}; }
    val res_allocated: res[*Copy, A.Error] = A.allocate[Copy](alloc, count::usize);
    if (sel res_allocated.err) { ret err[A.Error].err{res_allocated.err}; }
    facts.copies     = res_allocated.ok;
    facts.copy_count = count;
    var reads: collections_vector.Vector[intern.StrId] = collections_vector.init[intern.StrId](alloc);
    fin { collections_vector.dnit[intern.StrId](?reads); }
    var i: u32 = 0;
    for (i < count) {
        var c: Copy = Copy{name: take_name(r, itn, oom), first: reads.len::u32};
        wire.take_into(r, ?c.key[0], 32);
        c.count = wire.take_count(r, 5);
        var k: u32 = 0;
        for (k < c.count && !r.bad) {
            val res_pushed: res[usize, A.Error] = collections_vector.push[intern.StrId](?reads, take_name(r, itn, oom));
            if (sel res_pushed.err) { ret err[A.Error].err{res_pushed.err}; }
            k = k + 1;
        }
        if (r.bad) { c.count = 0; }
        facts.copies[i] = c;
        i               = i + 1;
    }
    if (reads.len == 0) { ret err[A.Error].ok{}; }
    val res_kept: res[*intern.StrId, A.Error] = A.allocate[intern.StrId](alloc, reads.len);
    if (sel res_kept.err) { ret err[A.Error].err{res_kept.err}; }
    memory.raw_copy(res_kept.ok::ptr, reads.data::ptr, reads.len * $size_of(intern.StrId));
    facts.copy_reads  = res_kept.ok;
    facts.reads_count = reads.len::u32;
    ret err[A.Error].ok{};
}
