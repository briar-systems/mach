# the digest memo: the surface digests of a source text, remembered under the
# sha-256 of that text, so a text the build has seen costs one hash and not
# the walk and three hashes its surfaces take. nothing about the file decides
# anything: the text load read is hashed every build and only its digest finds
# an entry. the memo lives at `<out>/.cache/digests` and belongs to one
# compiler identity, whose parser decides the surface digests; a memo written
# by another compiler, or one that is missing, truncated or damaged, reads as
# empty. a stored memo holds the texts the build that stored it keyed. the
# layout is `"MDM4"`, the 32-byte compiler digest, the entry count, the
# entries, then the sha-256 of everything before it. an entry is the text's
# digest then its three surface digests, every number little endian
use mach.lang.fail;
use crypto.hash.sha256;
use mach.lang.output;
use mach.lang.wire;
use A: std.allocator;
use std.collections.map;
use collections_vector: std.collections.vector;
use std.collections.vector.Vector;
use fs: std.filesystem;
use std.memory;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

val MAGIC:       u32   = 0x344D444D;
val HEADER:      usize = 40;
val ENTRY_FIXED: usize = 128;
val TRAILER:     usize = 32;

# what a source text digests to: its bytes, its surface without positions, its
# surface with the positions of what it omits, and its code without its test
# declarations, with their positions
pub rec Digests {
    content:       [32]u8;
    surface:       [32]u8;
    placed:        [32]u8;
    normal_placed: [32]u8;
}

# used: a text this build keyed holds it, so a store keeps it
rec Entry {
    digests: Digests;
    used:    bool;
}

pub rec Memo {
    alloc:    *A.Allocator;
    compiler: [32]u8;
    entries:  Vector[Entry];
    index:    map.Map[u64, u32];
    dirty:    bool;
}

pub fun init(a: *A.Allocator, compiler: *[32]u8) Memo {
    var m: Memo = Memo{alloc: a, entries: collections_vector.init[Entry](a), index: map.init[u64, u32](a)};
    memory.raw_copy((?m.compiler[0])::ptr, (?(@compiler)[0])::ptr, 32);
    ret m;
}

pub fun dnit(m: *Memo) {
    collections_vector.dnit[Entry](?m.entries);
    map.dnit[u64, u32](?m.index);
}

# the index key of a text's digest: its first eight bytes
fun head(content: *[32]u8) u64 {
    var h: u64   = 0;
    var i: usize = 0;
    for (i < 8) {
        h = (h << 8) | (@content)[i]::u64;
        i = i + 1;
    }
    ret h;
}

fun find(m: *Memo, content: *[32]u8) opt[u32] {
    var h:         u64       = head(content);
    val opt_found: opt[*u32] = map.get[u64, u32](?m.index, ?h);
    if (sel opt_found.none) { ret opt[u32].none{}; }
    val at: u32 = @opt_found.some;
    if (!memory.raw_equal((?m.entries.data[at].digests.content[0])::ptr, (?(@content)[0])::ptr, 32)) { ret opt[u32].none{}; }
    ret opt[u32].some{at};
}

# the surface digests remembered for the text whose digest `out.content` holds,
# written into `out`; false when the memo holds none
pub fun lookup(m: *Memo, out: *Digests) bool {
    val opt_at: opt[u32] = find(m, ?out.content);
    if (sel opt_at.none) { ret false; }
    val e: *Entry = ?m.entries.data[opt_at.some];
    e.used = true;
    @out   = e.digests;
    ret true;
}

# remember the digests of a text, under its digest
pub fun record(m: *Memo, d: *Digests) err[A.Error] {
    var h:         u64       = head(?d.content);
    val opt_taken: opt[*u32] = map.get[u64, u32](?m.index, ?h);
    # a text whose digest shares its head with another's is simply not remembered
    if (sel opt_taken.some) { ret err[A.Error].ok{}; }
    val res_push: res[usize, A.Error] = collections_vector.push[Entry](?m.entries, Entry{digests: @d, used: true});
    if (sel res_push.err) { ret err[A.Error].err{res_push.err}; }
    val res_insert: res[bool, A.Error] = map.insert[u64, u32](?m.index, h, (m.entries.len - 1)::u32);
    if (sel res_insert.err) { ret err[A.Error].err{res_insert.err}; }
    m.dirty = true;
    ret err[A.Error].ok{};
}

fun take_digest(r: *wire.Source, out: *[32]u8) {
    wire.take_into(r, ?(@out)[0], 32);
}

# the memo `bytes` hold for `compiler`: every entry, or none at all when the
# bytes are not a complete memo of that compiler. err only when allocation fails
pub fun decode(a: *A.Allocator, compiler: *[32]u8, bytes: *u8, len: usize) res[Memo, A.Error] {
    var m:      Memo = init(a, compiler);
    var handed: bool = false;
    fin {
        if (!handed) { dnit(?m); }
    }
    if (bytes == nil || len < HEADER + TRAILER) {
        handed = true;
        ret res[Memo, A.Error].ok{m};
    }
    var sum: [32]u8;
    sha256.hash(bytes, len - TRAILER, ?sum[0]);
    if (!memory.raw_equal((?sum[0])::ptr, (bytes::usize + len - TRAILER)::ptr, 32)) {
        handed = true;
        ret res[Memo, A.Error].ok{m};
    }
    var r: wire.Source = wire.source(bytes, len - TRAILER);
    if (wire.take_u32(?r) != MAGIC) {
        handed = true;
        ret res[Memo, A.Error].ok{m};
    }
    val written_by: *u8 = wire.take_bytes(?r, 32);
    if (!memory.raw_equal(written_by::ptr, (?(@compiler)[0])::ptr, 32)) {
        handed = true;
        ret res[Memo, A.Error].ok{m};
    }
    val count: u32 = wire.take_count(?r, ENTRY_FIXED);
    if (r.bad) {
        handed = true;
        ret res[Memo, A.Error].ok{m};
    }
    var i: u32 = 0;
    for (i < count && !r.bad) {
        var d: Digests;
        take_digest(?r, ?d.content);
        take_digest(?r, ?d.surface);
        take_digest(?r, ?d.placed);
        take_digest(?r, ?d.normal_placed);
        if (r.bad) { brk; }
        var h:         u64       = head(?d.content);
        val opt_clash: opt[*u32] = map.get[u64, u32](?m.index, ?h);
        if (sel opt_clash.some) {
            wire.reject(?r);
            brk;
        }
        val res_push: res[usize, A.Error] = collections_vector.push[Entry](?m.entries, Entry{digests: d, used: false});
        if (sel res_push.err) { ret res[Memo, A.Error].err{res_push.err}; }
        val res_insert: res[bool, A.Error] = map.insert[u64, u32](?m.index, h, (m.entries.len - 1)::u32);
        if (sel res_insert.err) { ret res[Memo, A.Error].err{res_insert.err}; }
        i = i + 1;
    }
    if (!wire.done(?r)) { ret res[Memo, A.Error].ok{init(a, compiler)}; }
    handed = true;
    ret res[Memo, A.Error].ok{m};
}

fun used_count(m: *Memo) u32 {
    var n: u32   = 0;
    var i: usize = 0;
    for (i < m.entries.len) {
        if (m.entries.data[i].used) { n = n + 1; }
        i = i + 1;
    }
    ret n;
}

fun put_memo(w: *wire.Sink, m: *Memo) {
    wire.put_u32(w, MAGIC);
    wire.put_bytes(w, ?m.compiler[0], 32);
    wire.put_u32(w, used_count(m));
    var i: usize = 0;
    for (i < m.entries.len) {
        val e: *Entry = ?m.entries.data[i];
        if (e.used) {
            wire.put_bytes(w, ?e.digests.content[0], 32);
            wire.put_bytes(w, ?e.digests.surface[0], 32);
            wire.put_bytes(w, ?e.digests.placed[0], 32);
            wire.put_bytes(w, ?e.digests.normal_placed[0], 32);
        }
        i = i + 1;
    }
}

# the memo's used entries as bytes, res_allocate in a and owned by the caller
pub fun encode(m: *Memo, a: *A.Allocator, out_len: *usize) res[*u8, A.Error] {
    var measure: wire.Sink = wire.measure();
    put_memo(?measure, m);
    val total:        usize             = measure.len + TRAILER;
    val res_allocate: res[*u8, A.Error] = A.allocate[u8](a, total);
    if (sel res_allocate.err) { ret res[*u8, A.Error].err{res_allocate.err}; }
    val buf: *u8       = res_allocate.ok;
    var w:   wire.Sink = wire.fixed(buf, measure.len);
    put_memo(?w, m);
    sha256.hash(buf, w.len, (buf::usize + w.len)::*u8);
    @out_len = total;
    ret res[*u8, A.Error].ok{buf};
}

# the memo stored at `file`, empty when there is none or it cannot be read;
# the file's bytes pass through `a` and are released before return
pub fun load(a: *A.Allocator, compiler: *[32]u8, file: str) res[Memo, A.Error] {
    val res_read: res[Vector[u8], fs.FsError] = fs.read_bytes(a, file);
    if (sel res_read.err) { ret res[Memo, A.Error].ok{init(a, compiler)}; }
    var bytes: Vector[u8] = res_read.ok;
    fin { collections_vector.dnit[u8](?bytes); }
    ret decode(a, compiler, bytes.data, bytes.len);
}

rec MemoWrite {
    bytes: *u8;
    len:   usize;
}

fun write_memo(w: *MemoWrite, t: *output.Temporary) err[fail.Fail] {
    ret output.fill(t, w.bytes, w.len, 0o644);
}

# write the memo to `file` through a sibling temporary when it would change: an
# entry was added or one went unused. the encoding passes through the memo's
# allocator
pub fun store(m: *Memo, out_dir: str, file: str) err[fail.Fail] {
    if (!m.dirty && used_count(m)::usize == m.entries.len) { ret err[fail.Fail].ok{}; }
    val err_reserve: err[fail.Fail] = output.reserve(m.alloc, out_dir, file);
    if (sel err_reserve.err) { ret err_reserve; }
    var len:        usize             = 0;
    val res_encode: res[*u8, A.Error] = encode(m, m.alloc, ?len);
    if (sel res_encode.err) { ret err[fail.Fail].err{fail.refused(res_encode.err)}; }
    var write:     MemoWrite      = MemoWrite{bytes: res_encode.ok, len: len};
    val err_write: err[fail.Fail] = output.through_temporary[MemoWrite](m.alloc, file, ?write, write_memo);
    A.deallocate[u8](m.alloc, res_encode.ok, len);
    if (sel err_write.err) { ret err_write; }
    m.dirty = false;
    ret err[fail.Fail].ok{};
}
