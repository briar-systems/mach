# the per-file digest memo: what a source file's bytes digest to, remembered
# under the path, size, modification time and identity the file had when it
# was hashed, so an unchanged file costs a stat and not a hash. the memo lives
# at `<out>/.cache/digests` and belongs to one compiler identity, whose
# parser decides the surface digests; a memo written by another compiler, or
# one that is missing, truncated or damaged, reads as empty. the layout is
# `"MDM3"`, the 32-byte compiler digest, the entry count, the entries, then
# the sha-256 of everything before it. an entry is its path (length then
# bytes), its size, modification seconds and nanoseconds, its 41-byte
# identity, then its four digests, every number little endian
use mach.lang.fail;
use mach.lang.output;
use mach.lang.wire;
use A: std.allocator;
use std.chrono.time;
use std.collections.map;
use collections_vector: std.collections.vector;
use std.collections.vector.Vector;
use std.crypto.hash.fnv1a;
use std.crypto.hash.sha256;
use fs:       std.filesystem;
use io_error: std.io.error;
use std.memory;
use std.text.string.str_dup;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;

val MAGIC:         u32   = 0x334D444D;
val HEADER:        usize = 40;
val IDENTITY_SIZE: usize = 41;
val ENTRY_FIXED:   usize = 4 + 24 + 41 + 160;
val TRAILER:       usize = 32;

# a file modified this close to the moment it is stamped could be modified
# again within the same timestamp tick, so it is hashed again next time rather
# than remembered
val RACY_SECONDS: i64 = 2;

# what the memo remembers of one file: the digest of its bytes, of its surface
# without positions, of its surface with the positions of what it omits, and of
# its code without its test declarations, with their positions
pub rec Digests {
    content:       [32]u8;
    surface:       [32]u8;
    placed:        [32]u8;
    normal_placed: [32]u8;
}

# what a file looked like when it was observed
pub rec Stamp {
    size:     u64;
    sec:      i64;
    nsec:     i64;
    identity: [41]u8;
}

rec Entry {
    path:    str;
    stamp:   Stamp;
    digests: Digests;
}

pub rec Memo {
    alloc:    *A.Allocator;
    compiler: [32]u8;
    entries:  Vector[Entry];
    index:    map.Map[u64, u32];
    dirty:    bool;
}

pub fun init(a: *A.Allocator, compiler: *[32]u8) Memo {
    var m: Memo = Memo{alloc: a, entries: collections_vector.init[Entry](a), index: map.init[u64, u32](a)};
    memory.raw_copy((?m.compiler[0])::ptr, (?(@compiler)[0])::ptr, 32);
    ret m;
}

pub fun dnit(m: *Memo) {
    var i: usize = 0;
    for (i < m.entries.len) {
        str_free(m.alloc, m.entries.data[i].path);
        i = i + 1;
    }
    collections_vector.dnit[Entry](?m.entries);
    map.dnit[u64, u32](?m.index);
}

fun path_hash(p: str) u64 {
    ret fnv1a.step_bytes(fnv1a.FNV_INIT, p::*u8, str_len(p));
}

fun find(m: *Memo, p: str) opt[u32] {
    var h:     u64       = path_hash(p);
    val found: opt[*u32] = map.get[u64, u32](?m.index, ?h);
    if (sel found.none) { ret opt[u32].none{}; }
    val at: u32 = @found.some;
    if (!str_equals(m.entries.data[at].path, p)) { ret opt[u32].none{}; }
    ret opt[u32].some{at};
}

fun stamp_equal(a: *Stamp, b: *Stamp) bool {
    ret a.size == b.size && a.sec == b.sec && a.nsec == b.nsec
        && memory.raw_equal((?a.identity[0])::ptr, (?b.identity[0])::ptr, IDENTITY_SIZE);
}

# how the file at `p` looks now, none when it cannot be opened or observed
pub fun stamp(p: str) opt[Stamp] {
    val opened: res[fs.File, io_error.Error] = fs.open(p);
    if (sel opened.err) { ret opt[Stamp].none{}; }
    var f: fs.File = opened.ok;
    # a file opened read-only loses nothing to a refused close
    fin { fs.close(?f); }
    val meta: res[fs.Metadata, io_error.Error] = fs.stat_of(f);
    if (sel meta.err) { ret opt[Stamp].none{}; }
    val ident: res[fs.Identity, io_error.Error] = fs.identity_of(f);
    if (sel ident.err) { ret opt[Stamp].none{}; }
    var s:  Stamp       = Stamp{size: meta.ok.size::u64, sec: meta.ok.modified.sec, nsec: meta.ok.modified.nsec};
    var id: fs.Identity = ident.ok;
    memory.raw_copy((?s.identity[0])::ptr, (?id.representation[0])::ptr, IDENTITY_SIZE);
    ret opt[Stamp].some{s};
}

# the digests remembered for `p` when the file still looks as it did
pub fun lookup(m: *Memo, p: str, s: *Stamp) opt[Digests] {
    val at: opt[u32] = find(m, p);
    if (sel at.none) { ret opt[Digests].none{}; }
    val e: *Entry = ?m.entries.data[at.some];
    if (!stamp_equal(?e.stamp, s)) { ret opt[Digests].none{}; }
    ret opt[Digests].some{e.digests};
}

# remember the digests of `p` as stamped, unless it was modified so recently
# (relative to `now`) that a second edit could share its timestamp
pub fun record(m: *Memo, p: str, s: *Stamp, d: *Digests, now: time.Time) err[A.Error] {
    if (s.sec > now.sec - RACY_SECONDS) { ret err[A.Error].ok{}; }
    val at: opt[u32] = find(m, p);
    if (sel at.some) {
        val e: *Entry = ?m.entries.data[at.some];
        e.stamp   = @s;
        e.digests = @d;
        m.dirty   = true;
        ret err[A.Error].ok{};
    }
    var h:     u64       = path_hash(p);
    val taken: opt[*u32] = map.get[u64, u32](?m.index, ?h);
    # a colliding path is simply not remembered
    if (sel taken.some) { ret err[A.Error].ok{}; }
    val copied: res[str, A.Error] = str_dup(m.alloc, p);
    if (sel copied.err) { ret err[A.Error].err{copied.err}; }
    val pushed: res[usize, A.Error] = collections_vector.push[Entry](?m.entries, Entry{path: copied.ok, stamp: @s, digests: @d});
    if (sel pushed.err) {
        str_free(m.alloc, copied.ok);
        ret err[A.Error].err{pushed.err};
    }
    val indexed: res[bool, A.Error] = map.insert[u64, u32](?m.index, h, (m.entries.len - 1)::u32);
    if (sel indexed.err) { ret err[A.Error].err{indexed.err}; }
    m.dirty = true;
    ret err[A.Error].ok{};
}

fun take_digest(r: *wire.Source, out: *[32]u8) {
    wire.take_into(r, ?(@out)[0], 32);
}

# the memo `bytes` hold for `compiler`: every entry, or none at all when the
# bytes are not a complete memo of that compiler. err only when allocation fails
pub fun decode(a: *A.Allocator, compiler: *[32]u8, bytes: *u8, len: usize) res[Memo, A.Error] {
    var m:      Memo = init(a, compiler);
    var handed: bool = false;
    fin {
        if (!handed) { dnit(?m); }
    }
    if (bytes == nil || len < HEADER + TRAILER) {
        handed = true;
        ret res[Memo, A.Error].ok{m};
    }
    var sum: [32]u8;
    sha256.hash(bytes, len - TRAILER, ?sum[0]);
    if (!memory.raw_equal((?sum[0])::ptr, (bytes::usize + len - TRAILER)::ptr, 32)) {
        handed = true;
        ret res[Memo, A.Error].ok{m};
    }
    var r: wire.Source = wire.source(bytes, len - TRAILER);
    if (wire.take_u32(?r) != MAGIC) {
        handed = true;
        ret res[Memo, A.Error].ok{m};
    }
    val written_by: *u8 = wire.take_bytes(?r, 32);
    if (!memory.raw_equal(written_by::ptr, (?(@compiler)[0])::ptr, 32)) {
        handed = true;
        ret res[Memo, A.Error].ok{m};
    }
    val count: u32 = wire.take_count(?r, ENTRY_FIXED);
    if (r.bad) {
        handed = true;
        ret res[Memo, A.Error].ok{m};
    }
    var i: u32 = 0;
    for (i < count && !r.bad) {
        var path_len: usize = 0;
        val path_at:  *u8   = wire.take_sized(?r, ?path_len);
        var s:        Stamp;
        s.size = wire.take_u64(?r);
        s.sec  = wire.take_u64(?r)::i64;
        s.nsec = wire.take_u64(?r)::i64;
        wire.take_into(?r, ?s.identity[0], IDENTITY_SIZE);
        var d: Digests;
        take_digest(?r, ?d.content);
        take_digest(?r, ?d.surface);
        take_digest(?r, ?d.placed);
        take_digest(?r, ?d.normal_placed);
        if (r.bad || path_len == 0) {
            wire.reject(?r);
            brk;
        }
        val copied: res[str, A.Error] = str_dup_bytes(a, path_at, path_len);
        if (sel copied.err) { ret res[Memo, A.Error].err{copied.err}; }
        var stored: bool = false;
        fin {
            if (!stored) { str_free(a, copied.ok); }
        }
        var h:     u64       = path_hash(copied.ok);
        val clash: opt[*u32] = map.get[u64, u32](?m.index, ?h);
        if (sel clash.some) {
            wire.reject(?r);
            brk;
        }
        val pushed: res[usize, A.Error] = collections_vector.push[Entry](?m.entries, Entry{path: copied.ok, stamp: s, digests: d});
        if (sel pushed.err) { ret res[Memo, A.Error].err{pushed.err}; }
        stored = true;
        val indexed: res[bool, A.Error] = map.insert[u64, u32](?m.index, h, (m.entries.len - 1)::u32);
        if (sel indexed.err) { ret res[Memo, A.Error].err{indexed.err}; }
        i = i + 1;
    }
    if (!wire.done(?r)) { ret res[Memo, A.Error].ok{init(a, compiler)}; }
    handed = true;
    ret res[Memo, A.Error].ok{m};
}

fun str_dup_bytes(a: *A.Allocator, bytes: *u8, len: usize) res[str, A.Error] {
    val allocated: res[*u8, A.Error] = A.allocate[u8](a, len + 1);
    if (sel allocated.err) { ret res[str, A.Error].err{allocated.err}; }
    val buf: *u8 = allocated.ok;
    memory.raw_copy(buf::ptr, bytes::ptr, len);
    buf[len] = 0;
    ret res[str, A.Error].ok{buf::str};
}

fun put_memo(w: *wire.Sink, m: *Memo) {
    wire.put_u32(w, MAGIC);
    wire.put_bytes(w, ?m.compiler[0], 32);
    wire.put_u32(w, m.entries.len::u32);
    var i: usize = 0;
    for (i < m.entries.len) {
        val e: *Entry = ?m.entries.data[i];
        wire.put_sized(w, e.path::*u8, str_len(e.path));
        wire.put_u64(w, e.stamp.size);
        wire.put_u64(w, e.stamp.sec::u64);
        wire.put_u64(w, e.stamp.nsec::u64);
        wire.put_bytes(w, ?e.stamp.identity[0], IDENTITY_SIZE);
        wire.put_bytes(w, ?e.digests.content[0], 32);
        wire.put_bytes(w, ?e.digests.surface[0], 32);
        wire.put_bytes(w, ?e.digests.placed[0], 32);
        wire.put_bytes(w, ?e.digests.normal_placed[0], 32);
        i = i + 1;
    }
}

# the memo as bytes, allocated in a and owned by the caller
pub fun encode(m: *Memo, a: *A.Allocator, out_len: *usize) res[*u8, A.Error] {
    var measure: wire.Sink = wire.measure();
    put_memo(?measure, m);
    val total:     usize             = measure.len + TRAILER;
    val allocated: res[*u8, A.Error] = A.allocate[u8](a, total);
    if (sel allocated.err) { ret res[*u8, A.Error].err{allocated.err}; }
    val buf: *u8       = allocated.ok;
    var w:   wire.Sink = wire.fixed(buf, measure.len);
    put_memo(?w, m);
    sha256.hash(buf, w.len, (buf::usize + w.len)::*u8);
    @out_len = total;
    ret res[*u8, A.Error].ok{buf};
}

# the memo stored at `file`, empty when there is none or it cannot be read;
# the file's bytes pass through `a` and are released before return
pub fun load(a: *A.Allocator, compiler: *[32]u8, file: str) res[Memo, A.Error] {
    val read: res[Vector[u8], fs.FsError] = fs.read_bytes(a, file);
    if (sel read.err) { ret res[Memo, A.Error].ok{init(a, compiler)}; }
    var bytes: Vector[u8] = read.ok;
    fin { collections_vector.dnit[u8](?bytes); }
    ret decode(a, compiler, bytes.data, bytes.len);
}

rec MemoWrite {
    bytes: *u8;
    len:   usize;
}

fun write_memo(w: *MemoWrite, t: *output.Temporary) err[fail.Fail] {
    ret output.fill(t, w.bytes, w.len, 0o644);
}

# write the memo to `file` through a sibling temporary when it changed; the
# encoding passes through the memo's allocator
pub fun store(m: *Memo, out_dir: str, file: str) err[fail.Fail] {
    if (!m.dirty) { ret err[fail.Fail].ok{}; }
    val reserved: err[fail.Fail] = output.reserve(m.alloc, out_dir, file);
    if (sel reserved.err) { ret reserved; }
    var len:     usize             = 0;
    val encoded: res[*u8, A.Error] = encode(m, m.alloc, ?len);
    if (sel encoded.err) { ret err[fail.Fail].err{fail.refused(encoded.err)}; }
    var write:   MemoWrite      = MemoWrite{bytes: encoded.ok, len: len};
    val written: err[fail.Fail] = output.through_temporary[MemoWrite](m.alloc, file, ?write, write_memo);
    A.deallocate[u8](m.alloc, encoded.ok, len);
    if (sel written.err) { ret written; }
    m.dirty = false;
    ret err[fail.Fail].ok{};
}
