use mach.lang.fail;
use mach.lang.intern;
use mach.lang.wire;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

# a cache key: the sha-256 of a domain then each input, every number a u64
# and every byte run its length then its bytes
pub rec Builder {
    sink: wire.Sink;
}

pub fun begin(domain: str) Builder {
    var b: Builder = Builder{sink: wire.digest()};
    text(?b, domain);
    ret b;
}

pub fun number(b: *Builder, value: u64) {
    wire.put_u64(?b.sink, value);
}

pub fun bytes(b: *Builder, data: *u8, len: usize) {
    if (data == nil && len != 0) {
        wire.refuse(?b.sink, fail.message("cache key has a nonempty input without bytes"));
        ret;
    }
    number(b, len::u64);
    wire.put_bytes(?b.sink, data, len);
}

pub fun text(b: *Builder, value: str) {
    if (value == nil) {
        number(b, 0);
        ret;
    }
    number(b, 1);
    bytes(b, value, str_len(value));
}

pub fun name(b: *Builder, itn: *intern.Interner, id: intern.StrId) {
    if (intern.str_is_nil(id)) {
        text(b, nil);
        ret;
    }
    val value: opt[str] = intern.get(itn, id);
    if (sel value.none) {
        wire.refuse(?b.sink, fail.message("cache key name is absent from its interner"));
        ret;
    }
    text(b, value.some);
}

pub fun finish(b: *Builder, digest: *[32]u8) err[fail.Fail] {
    val failed: opt[fail.Fail] = wire.failure(?b.sink);
    if (sel failed.some) { ret err[fail.Fail].err{failed.some}; }
    if (digest == nil)   { ret err[fail.Fail].err{fail.message("cache key has no digest destination")}; }
    wire.digest_final(?b.sink, digest);
    ret err[fail.Fail].ok{};
}

pub fun equal(left: *[32]u8, right: *[32]u8) bool {
    var i: usize = 0;
    for (i < 32) {
        if ((@left)[i] != (@right)[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the key of a module's object: the module's key and its name
pub fun object(module_key: *[32]u8, module: str, out: *[32]u8) err[fail.Fail] {
    var b: Builder = begin("mach.object-image");
    bytes(?b, ?(@module_key)[0], 32);
    text(?b, module);
    ret finish(?b, out);
}

# the key of a module's test object: the key of the normal object it is lowered
# against, which covers the module's whole source, tests included
pub fun test_object(object_key: *[32]u8, out: *[32]u8) err[fail.Fail] {
    var b: Builder = begin("mach.test-object-image");
    bytes(?b, ?(@object_key)[0], 32);
    ret finish(?b, out);
}

pub fun step(prior: *[32]u8, owner: str, name: str, inputs: *[32]u8) err[fail.Fail] {
    var b: Builder = begin("mach.executed-step");
    bytes(?b, ?(@prior)[0], 32);
    text(?b, owner);
    text(?b, name);
    bytes(?b, ?(@inputs)[0], 32);
    ret finish(?b, prior);
}
