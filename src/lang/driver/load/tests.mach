# the driver's module loading: the overlay and the load slots of a project
use A: std.allocator;
use std.allocator.page;
use T:          std.allocator.testing;
use fs:         std.filesystem;
use std_format: std.format;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use mach.lang.build.request;
use mach.lang.driver;
use driver_load: mach.lang.driver.load;
use mach.lang.driver.project;
use mach.lang.fail;
use mach.lang.intern;
use mach.lang.manifest;
use mach.lang.me.pipeline;
use mach.lang.module;
use mach.lang.session;
use mach.lang.target.of.bin;
use mach.lang.toolchain;

use mach.lang.driver.tests.testing.ut_cc3;
use mach.lang.driver.tests.testing.ut_count_errors;
use mach.lang.driver.tests.testing.ut_has;
use mach.lang.driver.tests.testing.ut_scaffold;
use mach.lang.driver.tests.testing.ut_scaffold_m;

# one refused load of the module past a full 63-module table, with the session,
# the project and its module table all over `t`; the request `fail_at` counts
# from the start of the load
#[testing]
fun refused_slot_load(alloc: *A.Allocator, t: *T.Testing, root: str, preload: u32, fail_at: u32) i32 {
    val ta: *A.Allocator                    = T.allocator_of(t);
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(ta);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    val pr: res[project.Project, fail.Fail] = driver.build_project_union(?s, root);
    if (sel pr.err) { ret 1; }
    var p: project.Project = pr.ok;
    fin { project.dnit_project(?p); }
    if (project.module_count(?p) != 1) { ret 1; }

    var pj: u32 = 0;
    for (pj < preload) {
        val nm_r: res[str, std_format.FormatError] = std_format.sprint(alloc, "uniontest.c{}", pj);
        if (sel nm_r.err) { ret 1; }
        val nm:    str                        = nm_r.ok;
        val fqn_r: res[intern.StrId, A.Error] = intern.add(?s.interner, nm);
        A.deallocate[u8](alloc, nm::*u8, str_len(nm) + 1);
        if (sel fqn_r.err) { ret 1; }
        val lr: res[session.ModuleId, fail.Fail] = driver_load.module_load(?p, fqn_r.ok);
        if (sel lr.err) { ret 1; }
        pj = pj + 1;
    }
    if (project.module_count(?p) != 1 + preload) { ret 1; }

    val fqn_r: res[intern.StrId, A.Error] = intern.add(?s.interner, "uniontest.c63");
    if (sel fqn_r.err) { ret 1; }
    val fqn:      intern.StrId = fqn_r.ok;
    val baseline: u32          = project.module_count(?p);

    val chunks_before: usize = p.modules.chunks.len;
    val live_before:   usize = T.live_count(t);
    T.fail_at_ordinal(t, T.attempt_count(t) + fail_at::usize);
    val cr: res[session.ModuleId, fail.Fail] = driver_load.module_load(?p, fqn);
    T.clear_failure(t);

    if (sel cr.ok) { ret 2; }
    # a chunk the table kept is owned capacity, not a leak; everything else is released
    val kept: usize = p.modules.chunks.len - chunks_before;
    if (project.module_count(?p) != baseline)  { ret 3; }
    if (ut_has(?p, ?s, "uniontest.c63"))       { ret 3; }
    if (T.live_count(t) != live_before + kept) { ret 4; }
    ret 0;
}

test dfs_load__allocation_failure_leaks_nothing {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }

    var base_names: [1]str;
    base_names[0] = "main.mach";
    var base_texts: [1]str;
    base_texts[0] = "fun main() i32 { ret 0; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?base_names[0], ?base_texts[0], 1);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;

    # one module short of a full 64-entry chunk, so the probed load grows the table
    val preload:   u32 = 63;
    var pi:        u32 = 0;
    var setup_bad: i32 = 0;
    for (pi < preload + 1 && setup_bad == 0) {
        val name_r: res[str, std_format.FormatError] = std_format.sprint(?alloc, "c{}.mach", pi);
        if (sel name_r.err) {
            setup_bad = 1;
            brk;
        }
        val name:     str             = name_r.ok;
        val name_cap: usize           = str_len(name) + 1;
        val text:     str             = "pub fun leaf() i32 { ret 0; }\n";
        val fp:       str             = ut_cc3(?alloc, root, "/src/", name);
        val we:       err[fs.FsError] = fs.write_bytes(fp, text, str_len(text), 420);
        A.deallocate[u8](?alloc, name::*u8, name_cap);
        if (sel we.err) {
            setup_bad = 1;
            brk;
        }
        pi = pi + 1;
    }
    if (setup_bad != 0) {
        fs.remove_all(?alloc, root);
        ret 1;
    }

    var bad:         i32 = 0;
    var fail_at:     u32 = 1;
    val max_fail_at: u32 = 2;
    for (fail_at <= max_fail_at && bad == 0) {
        var t:      T.Testing;
        val made_t: err[A.Error] = T.make(?t);
        if (sel made_t.err) {
            bad = 1;
            brk;
        }
        bad = refused_slot_load(?alloc, ?t, root, preload, fail_at);
        # teardown released everything the load and the project held
        if (bad == 0 && !T.clean(?t)) { bad = 4; }
        T.dnit(?t);
        fail_at = fail_at + 1;
    }

    if (bad == 0) {
        val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
        if (sel sr.err) { bad = 5; }
        if (sel sr.ok) {
            var s:  session.Session                 = sr.ok;
            val pr: res[project.Project, fail.Fail] = driver.build_project_union(?s, root);
            if (sel pr.err) {
                session.dnit(?s);
                bad = 5;
            }
            if (sel pr.ok) {
                var p:  project.Project = pr.ok;
                var pj: u32             = 0;
                for (pj < preload && bad == 0) {
                    val nm_r: res[str, std_format.FormatError] = std_format.sprint(?alloc, "uniontest.c{}", pj);
                    if (sel nm_r.err) {
                        bad = 5;
                        brk;
                    }
                    val nm:    str                        = nm_r.ok;
                    val fqn_r: res[intern.StrId, A.Error] = intern.add(?s.interner, nm);
                    A.deallocate[u8](?alloc, nm::*u8, str_len(nm) + 1);
                    if (sel fqn_r.err) {
                        bad = 5;
                        brk;
                    }
                    val lr: res[session.ModuleId, fail.Fail] = driver_load.module_load(?p, fqn_r.ok);
                    if (sel lr.err) {
                        bad = 5;
                        brk;
                    }
                    pj = pj + 1;
                }
                if (bad == 0) {
                    val fqn_r: res[intern.StrId, A.Error] = intern.add(?s.interner, "uniontest.c63");
                    if (sel fqn_r.ok) {
                        val lr: res[session.ModuleId, fail.Fail] = driver_load.module_load(?p, fqn_r.ok);
                        if (sel lr.err || project.module_count(?p) != 2 + preload) { bad = 5; }
                    }
                }
                project.dnit_project(?p);
            }
            session.dnit(?s);
        }
    }

    fs.remove_all(?alloc, root);
    ret bad;
}

#[testing]
fun t_manifest_overlay_src() str {
    ret "[project]\nmach = \">=5\"\nid = \"ctxcase\"\nversion = \"1.2.3\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.windows]\nisa = \"x86_64\"\nos = \"windows\"\nabi = \"win64\"\n\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n\n[artifact.beta]\nkind = \"bin\"\nentry = \"beta.mach\"\nout = \"{project.out}/bin/beta\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
}

test overlay__is_found_through_the_manifest_src {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "beta.mach";
    var texts: [1]str;
    texts[0] = "fun main() i32 { ret no_such_symbol(); }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold_m(?alloc, t_manifest_overlay_src(), ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 2;
    }
    val root: str = root_r.ok;

    val ov_path: str            = ut_cc3(?alloc, root, "/src/", "beta.mach");
    val osr:     err[fail.Fail] = session.set_overlay(?s, ov_path, "fun main() i32 { ret 0; }\n");
    if (sel osr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 3;
    }

    var bad: i32                               = 0;
    val mr:  res[manifest.Manifest, fail.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) { bad = 4; }
    if (sel mr.ok) {
        var mf:  manifest.Manifest    = mr.ok;
        var req: request.BuildRequest = request.defaults();
        req.project_root = root;
        req.target       = "windows";
        req.profile      = "release";
        req.artifact     = "beta";
        req.goal         = request.GOAL_OBJECTS;
        req.opt          = pipeline.OPT_RELEASE;

        val pr: res[project.Project, fail.Fail] = driver.analyze_project(?s, ?mf, ?req, project.ROOT_ARTIFACT, nil, 0);
        if (sel pr.err) { bad = 5; }
        if (sel pr.ok) {
            var p: project.Project = pr.ok;
            if (ut_count_errors(?p.s.diags) != 0) { bad = 6; }
            project.dnit_project(?p);
        }
        manifest.dnit(?mf, ?alloc);
    }

    session.dnit(?s);
    fs.remove_all(?alloc, root);
    ret bad;
}
