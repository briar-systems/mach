# one diagnostic carrying the whole trail: the message, the primary span at the
# instantiation that asked for the instance, and a related span at the operator in
# the template the instance was checked against
fun ut_instantiation_trail(src: str, needle: str, site_offset: usize, site_len: usize,
    body_offset: usize, body_len: usize) bool {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret false; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret false; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = src;
    val pr: res[project.Project, outcome.Fail] = ut_build(?s, ?alloc, ?names[0], ?texts[0], 1);
    if (sel pr.err) { ret false; }
    var p: project.Project = pr.ok;
    fin { project.dnit_project(?p); }

    val se: err[outcome.Fail] = driver.run_sema_pass(?p);
    if (!(sel se.err && outcome.is_reported(se.err))) { ret false; }

    var i: usize = 0;
    for (i < diagnostic.len(?s.diags)) {
        val d: *diagnostic.Diagnostic = ?s.diags.items.data[i];
        if (d.severity == diagnostic.SEVERITY_ERROR
            && ut_str_contains(d.message, needle)
            && d.loc.span.offset == site_offset
            && d.loc.span.len == site_len) {
            var r: usize = 0;
            for (r < d.related.len) {
                val rel: *diagnostic.Related = ?d.related.data[r];
                if (rel.loc.span.offset == body_offset && rel.loc.span.len == body_len) { ret true; }
                r = r + 1;
            }
        }
        i = i + 1;
    }
    ret false;
}

test "mach.lang.driver:addr_of_uninstantiated_generic_rejected" {
    var bad:  i32 = 0;
    val need: str = "cannot take the address of an uninstantiated generic function";

    if (!ut_sema_rejects_with("pub fun ident[T](s: T) T { ret s; }\nfun main() i64 { val p: ptr = ?ident; ret p::i64; }\n", need))                                                { bad = 1; }
    if (!ut_sema_rejects_with("pub fun pick[A, B](a: A, b: B) A { ret a; }\nfun main() i64 { val p: ptr = ?pick; ret p::i64; }\n", need))                                         { bad = 1; }
    if (!ut_sema_rejects_with("pub fun ident[T](s: T) T { ret s; }\nfun outer[U](u: U) i64 { val p: ptr = ?ident; ret p::i64; }\nfun main() i64 { ret outer[i64](0); }\n", need)) { bad = 1; }

    if (!ut_sema_clean("pub fun plain(s: i64) i64 { ret s; }\nfun main() i64 { val p: ptr = ?plain; ret p::i64; }\n")) { bad = 1; }
    if (!ut_sema_clean("pub fun ident[T](s: T) T { ret s; }\nfun main() i64 { ret ident[i64](3); }\n"))                { bad = 1; }
    if (!ut_sema_clean("fun outer[T](f: fun(T) T) i64 { val p: ptr = ?f; ret p::i64; }\nfun main() i64 { ret 0; }\n")) { bad = 1; }

    if (!ut_sema_rejects_with("pub fun ident[T](s: T) T { ret s; }\nfun main() i64 { val p: ptr = ?ident[0]; ret p::i64; }\n",
        "not indexable: a function has no elements")) { bad = 1; }
    ret bad;
}

test "mach.lang.driver:addr_of_cross_module_generic_rejected" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var bad: i32 = 0;

    val a_src: str = "pub fun ident[T](s: T) T { ret s; }\npub fun plain(s: i64) i64 { ret s; }\n";

    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:  session.Session                    = sr.ok;
    val pr: res[project.Project, outcome.Fail] = ut_sema2(?s, ?alloc,
        "use a: uniontest.a;\nfun main() i64 { val p: ptr = ?a.ident; ret p::i64; }\n", a_src);
    if (!ut_project_was_rejected(pr)) {
        session.dnit(?s);
        ret 1;
    }
    if (!ut_diag_has(?s.diags, "cannot take the address of an uninstantiated generic function")) { bad = 1; }
    session.dnit(?s);

    val sr2: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr2.err) { ret 1; }
    var s2:  session.Session                    = sr2.ok;
    val pr2: res[project.Project, outcome.Fail] = ut_sema2(?s2, ?alloc,
        "use a: uniontest.a;\nfun main() i64 { val p: ptr = ?a.plain; ret p::i64; }\n", a_src);
    if (sel pr2.err) {
        session.dnit(?s2);
        ret 1;
    }
    var p2: project.Project = pr2.ok;
    if (ut_count_errors(?s2.diags) != 0) { bad = 1; }
    project.dnit_project(?p2);
    session.dnit(?s2);
    ret bad;
}

test "mach.lang.driver:generic_instance_as_value" {
    var bad: i32 = 0;

    if (!ut_sema_clean("pub fun ident[T](s: T) T { ret s; }\nfun main() i64 { val f: fun(i64) i64 = ident[i64]; ret f(3); }\n"))                                     { bad = 1; }
    if (!ut_sema_clean("pub fun ident[T](s: T) T { ret s; }\nfun apply(f: fun(i64) i64, x: i64) i64 { ret f(x); }\nfun main() i64 { ret apply(ident[i64], 3); }\n")) { bad = 1; }
    if (!ut_sema_clean("pub fun ident[T](s: T) T { ret s; }\nfun pick() fun(i64) i64 { ret ident[i64]; }\nfun main() i64 { ret pick()(3); }\n"))                     { bad = 1; }
    if (!ut_sema_clean("pub fun ident[T](s: T) T { ret s; }\nfun main() i64 { val t: [1]fun(i64) i64 = [1]fun(i64) i64{ident[i64]}; ret t[0](3); }\n"))              { bad = 1; }
    if (!ut_sema_clean("pub fun ident[T](s: T) T { ret s; }\nfun main() i64 { val p: ptr = ?ident[i64]; ret p::i64; }\n"))                                           { bad = 1; }
    if (!ut_lower_clean("pub fun ident[T](s: T) T { ret s; }\nfun main() i64 { val f: fun(i64) i64 = ident[i64]; ret f(3); }\n"))                                    { bad = 1; }

    if (!ut_sema_clean("pub fun ident[T](s: T) T { ret s; }\nfun main() i64 { val f: fun(u32) u32 = ident[u32]; ret f(3::u32)::i64; }\n"))   { bad = 1; }
    if (!ut_sema_rejects("pub fun ident[T](s: T) T { ret s; }\nfun main() i64 { val f: fun(u32) u32 = ident[i64]; ret f(3::u32)::i64; }\n")) { bad = 1; }

    if (!ut_sema_rejects("pub fun ident[T](s: T) T { ret s; }\nfun main() i64 { val f: fun(i64) i64 = ident[i64, u32]; ret f(3); }\n")) { bad = 1; }
    if (!ut_sema_rejects("pub fun plain(s: i64) i64 { ret s; }\nfun main() i64 { val f: fun(i64) i64 = plain[i64]; ret f(3); }\n"))     { bad = 1; }
    if (!ut_sema_clean("pub fun plain(s: i64) i64 { ret s; }\nfun main() i64 { val f: fun(i64) i64 = plain; ret f(3); }\n"))            { bad = 1; }
    ret bad;
}

test "mach.lang.driver:generic_instance_as_value_cross_module" {
    var bad:   i32 = 0;
    val a_src: str = "pub fun ident[T](s: T) T { ret s; }\npub val ARR: [4]i64 = [4]i64{1, 2, 3, 4};\n";

    if (!ut_sema_clean2("use a: uniontest.lib;\nfun main() i64 { val f: fun(i64) i64 = a.ident[i64]; ret f(3); }\n", a_src)) { bad = 1; }
    if (!ut_sema_clean2("use a: uniontest.lib;\nfun main() i64 { val i: u64 = 1; ret a.ARR[i]; }\n", a_src))                 { bad = 1; }
    ret bad;
}

test "mach.lang.driver:generic_param_identity_isolated_per_module" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [2]str;
    names[0] = "main.mach";
    names[1] = "lib.mach";
    var texts: [2]str;
    texts[0] = "fun second_generic[Beta](u: Beta) i64 { val y: i64 = u; ret y; }\nuse lib: uniontest.lib;\nfun main() i64 { var b: u32 = 1; second_generic[u32](b); ret lib.anchor(); }\n";
    texts[1] = "fun first_generic[Alpha](t: Alpha) i64 { val x: Alpha = t; ret 0; }\npub fun anchor() i64 { var a: u16 = 2; ret first_generic[u16](a); }\n";

    val pr: res[project.Project, outcome.Fail] = ut_vec_sema_n(?s, ?alloc, ?names[0], ?texts[0], 2);
    if (!ut_project_was_rejected(pr)) {
        session.dnit(?s);
        ret 1;
    }

    # each module's parameter is bound by its own instantiation: the refusal names the
    # argument main supplied, never a parameter and never the argument lib supplied
    val alpha_hits: u32 = ut_diag_count(?s.diags, "found Alpha");
    val beta_hits:  u32 = ut_diag_count(?s.diags, "found Beta");
    val lib_hits:   u32 = ut_diag_count(?s.diags, "found u16");
    val main_hits:  u32 = ut_diag_count(?s.diags, "found u32");

    session.dnit(?s);

    if (alpha_hits == 0 && beta_hits == 0 && lib_hits == 0 && main_hits == 1) { ret 0; }
    ret 1;
}

test "mach.lang.driver:generic_instance_ct_reinfer" {
    var bad: i32 = 0;

    val cb: str = "fun cb[T](a: T, b: T) u32 { if (a == b) { ret 1; } ret 0; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var x: ^u32 = 1; var y: ^u32 = 1; cb[^u32](x, y); ret 0; }\n";
    if (!ut_sema_rejects(cb))                                            { bad = 1; }
    if (ut_vec_diag(cb, "secret value used as a branch condition") != 0) { bad = 1; }

    if (!ut_sema_clean("fun cb[T](a: T, b: T) u32 { if (a == b) { ret 1; } ret 0; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var x: u32 = 1; var y: u32 = 2; cb[u32](x, y); ret 0; }\n")) { bad = 1; }

    if (!ut_sema_rejects("fun cb[T](a: T, b: T) u32 { if (a == b) { ret 1; } ret 0; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var p: u32 = 1; var q: u32 = 2; var x: ^u32 = 1; var y: ^u32 = 1; cb[u32](p, q); cb[^u32](x, y); ret 0; }\n")) { bad = 1; }

    if (!ut_sema_rejects("fun cb[T](a: T, b: T) u32 { if (a == b) { ret 1; } ret 0; }\nfun outer[T](a: T, b: T) u32 { ret cb[T](a, b); }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var x: ^u32 = 1; var y: ^u32 = 1; outer[^u32](x, y); ret 0; }\n")) { bad = 1; }

    if (!ut_sema_rejects("rec Pt { x: u32; y: u32; }\nfun eq[T](a: T, b: T) u32 { if (a == b) { ret 1; } ret 0; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var p: Pt; var q: Pt; eq[Pt](p, q); ret 0; }\n")) { bad = 1; }

    if (ut_lower_rejects("fun mk[T](a: T, b: T) ^u8 { ret a == b; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var x: ^u32 = 1; var y: ^u32 = 1; mk[^u32](x, y); ret 0; }\n",
        "constant-time comparison on a secret value") != 0) { bad = 1; }
    if (ut_lower_ok("#[oblivious]\nfun mk[T](a: T, b: T) ^u8 { ret a == b; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var x: ^u32 = 1; var y: ^u32 = 1; mk[^u32](x, y); ret 0; }\n") != 0) { bad = 1; }

    ret bad;
}

test "mach.lang.driver:generic_each_body_revalidated" {
    var bad: i32 = 0;

    if (ut_vec_diag("rec P { a: u32; }\nfun leak[T, U](v: T, s: U) u32 { var acc: u32 = 0; $each f in $fields(T) { if (s == 5) { acc = 1; } } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var p: P; var s: ^u32 = 5; leak[P, ^u32](p, s); ret 0; }\n",
        "secret value used as a branch condition") != 0) { bad = 1; }

    if (ut_vec_diag("rec P { a: u32; }\nvar t: [8]u32;\nfun leak[T, U](v: T, s: U) u32 { var acc: u32 = 0; $each f in $fields(T) { acc = t[s]; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var p: P; var s: ^u64 = 3; leak[P, ^u64](p, s); ret 0; }\n",
        "secret value used as a memory index") != 0) { bad = 1; }

    if (ut_vec_diag("rec P { x: ^u32; }\nfun leak[T](v: *T) u32 { var acc: u32 = 0; $each f in $fields(T) { val b: *u8 = v::ptr::*u8; acc = @((?b[f.offset])::ptr::*u32); } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var p: P; leak[P](?p); ret 0; }\n",
        "secret-welded pointer cannot be erased") != 0) { bad = 1; }

    if (ut_vec_diag("rec P { x: ^u32; }\nfun leak[T](v: *T, base: *u8) u32 { var acc: u32 = 0; $each f in $fields(T) { acc = v.[f]; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var p: P; var b: u8; leak[P](?p, ?b); ret 0; }\n",
        "expected u32, found ^u32") != 0) { bad = 1; }

    if (!ut_sema_clean("rec P { a: u32; }\nfun ok[T, U](v: T, s: U) u32 { var acc: u32 = 0; $each f in $fields(T) { if (s == 5) { acc = 1; } } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var p: P; var s: u32 = 5; ok[P, u32](p, s); ret 0; }\n")) { bad = 1; }

    ret bad;
}

test "mach.lang.driver:generic_instance_reached_through_generic" {
    var bad: i32 = 0;

    if (ut_vec_diag("fun fmt(va: ...) u32 { ret 0; }\nfun inner[T, U](v: T, s: U) u32 { ret fmt(s); }\nfun outer[T](v: T, s: ^u32) u32 { ret inner[T, ^u32](v, s); }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var s: ^u32 = 1; outer[u32](7, s); ret 0; }\n",
        "secret value cannot be passed to a variadic") != 0) { bad = 1; }

    if (ut_vec_diag("fun inner[T, U](v: T, s: U) u32 { if (s == s) { ret 1; } ret 0; }\nfun outer[T](v: T, s: ^u32) u32 { ret inner[T, ^u32](v, s); }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var s: ^u32 = 1; outer[u32](7, s); ret 0; }\n",
        "secret value used as a branch condition") != 0) { bad = 1; }

    if (!ut_sema_clean("fun inner[T, U](v: T, s: U) u32 { if (s == s) { ret 1; } ret 0; }\nfun outer[T](v: T, s: u32) u32 { ret inner[T, u32](v, s); }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { outer[u32](7, 5); ret 0; }\n")) { bad = 1; }

    if (ut_vec_diag("fun cb[U](a: U, b: U) u32 { if (a == b) { ret 1; } ret 0; }\nfun mid[T](x: ^T, y: ^T) u32 { ret cb[^T](x, y); }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var s: ^u32 = 1; mid[u32](s, s); ret 0; }\n",
        "secret value used as a branch condition") != 0) { bad = 1; }

    if (!ut_sema_clean("fun cb[U](a: U, b: U) u32 { if (a == b) { ret 1; } ret 0; }\nfun mid[T](x: T, y: T) u32 { ret cb[T](x, y); }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { mid[u32](1, 2); ret 0; }\n")) { bad = 1; }

    if (ut_sema_errs("fun inner[U](v: U) u32 { var acc: *u8 = nil; acc = 7; ret 0; }\nfun outer[T](v: T) u32 { ret inner[T](v); }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { outer[u32](1); ret 0; }\n") != 1) { bad = 1; }

    ret bad;
}

test "mach.lang.driver:growing_pointer_generic_family_has_finite_concrete_layout" {
    if (!ut_sema_clean("rec Node[T] { next: *Node[*T]; value: T; }\nfun main() i32 { var n: Node[u32]; n.next = nil; n.value = 7; ret n.value::i32; }\n")) { ret 1; }
    ret 0;
}

test "mach.lang.driver:fields_over_generic_instance" {
    var bad: i32 = 0;

    if (!ut_sema_clean("rec Box[T] { v: T; w: T; }\nfun count[T](b: T) u32 { var acc: u32 = 0; $each f in $fields(T) { acc = acc + 1; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var b: Box[u32]; count[Box[u32]](b); ret 0; }\n")) { bad = 1; }

    if (!ut_sema_clean("rec Box[T] { v: T; w: T; }\nfun count[T](b: T) u32 { var acc: u32 = 0; $each f in $fields(T) { acc = acc + 1; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var b: Box[*u32]; count[Box[*u32]](b); ret 0; }\n"))         { bad = 1; }
    if (!ut_sema_clean("rec Box[T] { v: T; w: T; }\nfun count[T](b: T) u32 { var acc: u32 = 0; $each f in $fields(T) { acc = acc + 1; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var b: Box[Box[u32]]; count[Box[Box[u32]]](b); ret 0; }\n")) { bad = 1; }

    ret bad;
}

test "mach.lang.driver:generic_named_without_type_arguments" {
    var bad: i32 = 0;

    if (ut_vec_diag("rec Box[T] { v: T; w: T; }\nfun f() u32 { var b: Box; ret 0; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { f(); ret 0; }\n",
        "generic type `Box` named without type arguments: expected 1, found 0") != 0) { bad = 1; }
    if (ut_vec_diag("rec Box[T] { v: T; w: T; }\nfun f(b: Box) u32 { ret 0; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "generic type `Box` named without type arguments: expected 1, found 0") != 0) { bad = 2; }
    if (ut_vec_diag("rec Box[T] { v: T; w: T; }\nfun f(p: *Box) u32 { ret 0; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "generic type `Box` named without type arguments: expected 1, found 0") != 0) { bad = 3; }
    if (ut_vec_diag("rec Box[T] { v: T; w: T; }\nfun f() Box { var b: Box[u32]; ret b; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "generic type `Box` named without type arguments: expected 1, found 0") != 0) { bad = 4; }
    if (ut_vec_diag("rec Box[T] { v: T; w: T; }\nrec Outer { b: Box; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "generic type `Box` named without type arguments: expected 1, found 0") != 0) { bad = 5; }
    if (ut_vec_diag("rec Box[T] { v: T; w: T; }\ndef Alias: Box;\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "generic type `Box` named without type arguments: expected 1, found 0") != 0) { bad = 6; }

    if (ut_vec_diag("rec Box[T] { v: T; w: T; }\nfun f() u64 { ret $size_of(Box); }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { f(); ret 0; }\n",
        "generic type `Box` named without type arguments: expected 1, found 0") != 0) { bad = 7; }
    if (ut_vec_diag("rec Box[T] { v: T; w: T; }\nfun f() u64 { ret $align_of(Box); }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { f(); ret 0; }\n",
        "generic type `Box` named without type arguments: expected 1, found 0") != 0) { bad = 8; }
    if (ut_vec_diag("rec Box[T] { v: T; w: T; }\nfun f() u64 { ret $offset_of(Box, w); }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { f(); ret 0; }\n",
        "generic type `Box` named without type arguments: expected 1, found 0") != 0) { bad = 9; }
    if (ut_vec_diag("rec Box[T] { v: T; w: T; }\nfun f() u64 { var n: u64 = 0; $each g in $fields(Box) { n = n + 1; } ret n; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { f(); ret 0; }\n",
        "generic type `Box` named without type arguments: expected 1, found 0") != 0) { bad = 10; }

    if (ut_vec_diag("rec Box[T] { v: T; w: T; }\nfun f() u8 { var buf: [$size_of(Box)]u8; ret buf[0]; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { f(); ret 0; }\n",
        "generic type `Box` named without type arguments: expected 1, found 0") != 0) { bad = 11; }

    if (ut_vec_diag("rec Box[T] { v: T; w: T; }\nfun f() i64 { var b: Box[u32]; $if ($type_of(b) == Box) { ret 1; } $or { ret 0; } }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { f(); ret 0; }\n",
        "generic type `Box` named without type arguments: expected 1, found 0") != 0) { bad = 12; }

    if (ut_vec_diag("rec Pair[A, B] { a: A; b: B; }\nfun f() u64 { ret $size_of(Pair); }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { f(); ret 0; }\n",
        "generic type `Pair` named without type arguments: expected 2, found 0") != 0) { bad = 13; }
    if (ut_vec_diag("uni U[T] { a: T; b: u32; }\nfun f() u64 { ret $size_of(U); }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { f(); ret 0; }\n",
        "generic type `U` named without type arguments: expected 1, found 0") != 0) { bad = 14; }

    if (ut_sema_errs("rec Box[T] { v: T; }\nfun f(b: Box) u32 { ret b.v; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n") != 1) { bad = 15; }

    if (!ut_sema_clean("rec Plain { v: u32; }\ndef PA: Plain;\nfun f(p: Plain, q: *Plain) u64 { var r: Plain; var a: PA; var n: u64 = 0; $each g in $fields(Plain) { n = n + 1; } ret $size_of(Plain) + $align_of(Plain) + $offset_of(Plain, v) + n; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var p: Plain; f(p, ?p); ret 0; }\n")) { bad = 16; }
    if (!ut_sema_clean("rec Plain { v: u32; }\nfun f() i64 { var p: Plain; $if ($type_of(p) == Plain) { ret 1; } $or { ret 0; } }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { f(); ret 0; }\n"))                                                                                                                                         { bad = 17; }
    if (!ut_sema_clean("uni V { a: u32; b: u32; }\nfun f(v: V) u64 { ret $size_of(V); }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var v: V; f(v); ret 0; }\n"))                                                                                                                                                                        { bad = 18; }

    if (!ut_sema_clean("fun f[T](v: T) T { var x: T; var p: *T; var a: [2]T; x = v; ret x; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { f[u32](1); ret 0; }\n"))                                                                       { bad = 19; }
    if (!ut_sema_clean("rec P { x: u32; }\nfun f[T](v: T) u64 { var n: u64 = 0; $each g in $fields(T) { n = n + 1; } ret $size_of(T) + $align_of(T) + n; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var p: P; f[P](p); ret 0; }\n")) { bad = 20; }

    if (!ut_sema_clean("rec Box[T] { v: T; w: T; }\nrec In[T] { x: T; }\nrec Pair[A, B] { a: A; b: B; }\ndef BA: Box[u32];\nfun a[T](b: Box[T]) u64 { ret $size_of(Box[T]) + $offset_of(Box[T], w); }\nfun b[T](x: Box[In[T]]) u64 { ret $size_of(Box[In[T]]); }\nfun c[A, B](p: Pair[A, B]) u64 { ret $size_of(Pair[A, B]); }\nfun d() u64 { var z: BA; ret $size_of(BA); }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var x: Box[u32]; var y: Box[In[u32]]; var p: Pair[u32, u64]; a[u32](x); b[u32](y); c[u32, u64](p); d(); ret 0; }\n")) { bad = 21; }

    if (ut_vec_diag2("use uniontest.lib.Box;\nfun f() u64 { var b: Box; ret $size_of(Box); }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { f(); ret 0; }\n",
        "pub rec Box[T] { v: T; w: T; }\n",
        "generic type `Box` named without type arguments: expected 1, found 0") != 0) { bad = 22; }
    if (!ut_sema_clean2("use uniontest.lib.Box;\nuse uniontest.lib.Flat;\nfun f() u64 { var b: Box[u32]; var p: Flat; ret $size_of(Box[u32]) + $size_of(Flat); }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { f(); ret 0; }\n",
        "pub rec Box[T] { v: T; w: T; }\npub rec Flat { v: u32; }\n")) { bad = 23; }

    ret bad;
}

test "mach.lang.driver:instance_body_typed_by_instantiated_types" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var bad: i32 = 0;

    val mixed: str = ut_cc3(?alloc,
        "fun sink(va: ...) u32 { var acc: u32 = 0; $each a in va { acc = acc + a; } ret acc; }\n#[symbol(\"",
        ut_entry_symbol(), "\")]\nfun start() i32 { sink(7i64, 8i64); ret 0; }\n");
    if (!ut_sema_clean(mixed))             { bad = 1; }
    if (ut_engine_build_fails(mixed) != 0) { bad = 1; }

    val cast: str = ut_cc3(?alloc,
        "fun sink(va: ...) u32 { var acc: u32 = 0; $each a in va { acc = acc + a::u32; } ret acc; }\n#[symbol(\"",
        ut_entry_symbol(), "\")]\nfun start() i32 { sink(7i64, 8i64); ret 0; }\n");
    if (!ut_sema_clean(cast))             { bad = 1; }
    if (ut_engine_build_fails(cast) == 0) { bad = 1; }

    val hetero: str = ut_cc3(?alloc,
        "fun sum(va: ...) i64 { var t: i64 = 0; $each a in va { t = t + a::i64; } ret t; }\n#[symbol(\"",
        ut_entry_symbol(), "\")]\nfun start() i32 { sum(1000, 50::i32, 7::u8); ret 0; }\n");
    if (!ut_sema_clean(hetero))             { bad = 1; }
    if (ut_engine_build_fails(hetero) == 0) { bad = 1; }

    ret bad;
}

# with the untyped `:^` gone, a generic body names the public type it expects and
# the template defers the equality to each instance
test "mach.lang.driver:generic_strip_target_is_checked_per_instance" {
    if (!ut_ct_lower_clean("var g: ^u32 = 99;\nfun show[U](s: U) u32 { ret s:>u32; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { show[^u32](g); ret 0; }\n")) { ret 1; }
    if (ut_ct_lower_diag("var h: ^u64 = 99;\nfun show[U](s: U) u32 { ret s:>u32; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { show[^u64](h); ret 0; }\n",
        "must name the operand's stripped (public) type") != 0) { ret 2; }
    if (ut_ct_lower_diag("var g: ^u32 = 99;\nfun show[U](s: U) ^u32 { ret s:>^u32; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { show[^u32](g); ret 0; }\n",
        "target type must be public") != 0) { ret 3; }
    ret 0;
}

test "mach.lang.driver:uni_instance_walk_scales_with_the_type_graph" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var bad: i32 = 0;

    val n: u32 = 320;

    val tr: res[str, format.FormatError] = format.sprint(?alloc, "uni U[T] {{ a: T; b: u32; }}\nfun e(p: *R{}) u32 {{ ret 0; }}\nfun main() i32 {{ ret 0; }}\n", n - 1);
    if (sel tr.err) { ret 1; }
    val tail: str = tr.ok;

    val br: res[str, format.FormatError] = format.sprint(?alloc, "a: ^u32; b: *R{};", n - 1);
    if (sel br.err) { ret 1; }
    val back: str = br.ok;

    val plain_src: err[fail.Fail] = ut_chain_src(?alloc, n, "a: ^u32;", tail);
    if (sel plain_src.ok) { bad = 1; }
    if (sel plain_src.err) {
        val src: str = fail.describe(plain_src.err);
        if (!ut_sema_clean(src)) { bad = 1; }
        A.deallocate[char](?alloc, src::*char, str_len(src) + 1);
    }

    val mixed_src: err[fail.Fail] = ut_chain_src(?alloc, n, "a: ^u32; u: U[^u32];", tail);
    if (sel mixed_src.ok) { bad = 1; }
    if (sel mixed_src.err) {
        val src: str = fail.describe(mixed_src.err);
        if (ut_vec_diag(src, "union variants must agree on secrecy") != 0) { bad = 1; }
        if (ut_vec_diag(src, "too large") == 0)                            { bad = 1; }
        A.deallocate[char](?alloc, src::*char, str_len(src) + 1);
    }

    val ok_src: err[fail.Fail] = ut_chain_src(?alloc, n, "a: ^u32; u: U[u32];", tail);
    if (sel ok_src.ok) { bad = 1; }
    if (sel ok_src.err) {
        val src: str = fail.describe(ok_src.err);
        if (!ut_sema_clean(src)) { bad = 1; }
        A.deallocate[char](?alloc, src::*char, str_len(src) + 1);
    }

    val cyc_src: err[fail.Fail] = ut_chain_src(?alloc, n, back, tail);
    if (sel cyc_src.ok) { bad = 1; }
    if (sel cyc_src.err) {
        val src: str = fail.describe(cyc_src.err);
        if (!ut_sema_clean(src)) { bad = 1; }
        A.deallocate[char](?alloc, src::*char, str_len(src) + 1);
    }

    A.deallocate[char](?alloc, back::*char, str_len(back) + 1);
    A.deallocate[char](?alloc, tail::*char, str_len(tail) + 1);
    ret bad;
}

test "mach.lang.driver:generic_type_gate_folds_per_instance" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "fun byloc[T](s: T) i64 { var out: T = s;\n$if ($type_of(out) == u32) { ret 111; }\n$or ($type_of(out) == u64) { ret 333; }\n$or { ret 999; } }\nfun bypar[T](s: T) i64 {\n$if ($type_of(s) == u32) { ret 222; }\n$or ($type_of(s) == u64) { ret 444; }\n$or { ret 999; } }\npub fun p1(x: u32) i64 { ret byloc[u32](x); }\npub fun p2(y: u64) i64 { ret byloc[u64](y); }\npub fun p3(x: u32) i64 { ret bypar[u32](x); }\npub fun p4(y: u64) i64 { ret bypar[u64](y); }\nfun main() i32 { ret 0; }\n";

    val pr: res[project.Project, outcome.Fail] = ut_lower_n(?s, ?alloc, ?names[0], ?texts[0], 1);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    var bad: i32        = 0;
    val m:   *ir.Module = ut_ir_of(?p, ?s, "uniontest.main");
    if (m == nil) { bad = 1; }
    or {
        if (ut_const_uses(m, 111) != 1) { bad = 1; }
        if (ut_const_uses(m, 333) != 1) { bad = 1; }
        if (ut_const_uses(m, 222) != 1) { bad = 1; }
        if (ut_const_uses(m, 444) != 1) { bad = 1; }
    }

    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

# every row of the #3432 matrix, written once against a type parameter and accepted
# at each instantiation; the corpus case generic/operators anchors the values these
# rows compute against a C control
test "mach.lang.driver:generic_operator_resolves_at_the_instantiation" {
    var bad: i32 = 0;

    if (!ut_sema_clean("fun f[T](a: T, b: T) T { if (a < b) { ret a; } if (a <= b) { ret b; } if (a > b) { ret a; } if (a >= b) { ret b; } ret a; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var x: i64 = 3; var y: i64 = 5; f[i64](x, y); var u: u32 = 3; var v: u32 = 5; f[u32](u, v); ret 0; }\n")) { bad = 1; }
    if (!ut_sema_clean("fun f[T](a: T, b: T) T { ret a + b - a * b / (b + 1) % (b + 1); }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var x: i64 = 3; var y: i64 = 5; f[i64](x, y); var u: u32 = 3; var v: u32 = 5; f[u32](u, v); ret 0; }\n"))                                                           { bad = 2; }
    if (!ut_sema_clean("fun f[T](a: T, b: T) T { ret (a & b) | (a ^ b); }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var x: i64 = 3; var y: i64 = 5; f[i64](x, y); var u: u32 = 3; var v: u32 = 5; f[u32](u, v); ret 0; }\n"))                                                                           { bad = 3; }
    if (!ut_sema_clean("fun f[T](a: T, b: T) T { ret (a << 2) >> 1; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var x: i64 = 3; var y: i64 = 5; f[i64](x, y); var u: u32 = 3; var v: u32 = 5; f[u32](u, v); ret 0; }\n"))                                                                               { bad = 4; }
    if (!ut_sema_clean("fun f[T](a: T, b: T) T { ret ~a; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var x: i64 = 3; var y: i64 = 5; f[i64](x, y); var u: u32 = 3; var v: u32 = 5; f[u32](u, v); ret 0; }\n"))                                                                                          { bad = 5; }
    if (!ut_sema_clean("fun f[T](a: T, b: T) T { ret (0::T) - a; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var x: i64 = 3; var y: i64 = 5; f[i64](x, y); var u: u32 = 3; var v: u32 = 5; f[u32](u, v); ret 0; }\n"))                                                                                  { bad = 6; }
    if (!ut_sema_clean("fun f[T](a: T, b: T) T { if (a == 0) { ret b; } ret a; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var x: i64 = 3; var y: i64 = 5; f[i64](x, y); var u: u32 = 3; var v: u32 = 5; f[u32](u, v); ret 0; }\n"))                                                                    { bad = 7; }
    if (!ut_sema_clean("fun f[T](a: T, b: T) T { ret (a::i64)::T; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var x: i64 = 3; var y: i64 = 5; f[i64](x, y); var u: u32 = 3; var v: u32 = 5; f[u32](u, v); ret 0; }\n"))                                                                                 { bad = 8; }
    if (!ut_sema_clean("fun f[T](a: T, b: T) T { ret (1::T) + a; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var x: i64 = 3; var y: i64 = 5; f[i64](x, y); var u: u32 = 3; var v: u32 = 5; f[u32](u, v); ret 0; }\n"))                                                                                  { bad = 9; }
    if (!ut_sema_clean("fun f[T](a: T, b: T) T { if (a < b) { ret a; } if (a <= b) { ret b; } if (a > b) { ret a; } if (a >= b) { ret b; } ret a; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var p: f64 = 3.0; var q: f64 = 5.0; f[f64](p, q); ret 0; }\n"))                                           { bad = 10; }
    if (!ut_sema_clean("fun f[T](a: T, b: T) T { ret a + b - a * b / (b + 1.0); }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var p: f64 = 3.0; var q: f64 = 5.0; f[f64](p, q); ret 0; }\n"))                                                                                                             { bad = 11; }
    if (!ut_sema_clean("fun f[T](a: T, b: T) T { ret (0.0::T) - a; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var p: f64 = 3.0; var q: f64 = 5.0; f[f64](p, q); ret 0; }\n"))                                                                                                                          { bad = 12; }
    if (!ut_sema_clean("fun f[T](a: T, b: T) T { if (a == 0.0) { ret b; } ret a; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var p: f64 = 3.0; var q: f64 = 5.0; f[f64](p, q); ret 0; }\n"))                                                                                                            { bad = 13; }
    if (!ut_sema_clean("fun f[T](a: T, b: T) T { ret (a::i64)::T; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var p: f64 = 3.0; var q: f64 = 5.0; f[f64](p, q); ret 0; }\n"))                                                                                                                           { bad = 14; }
    if (!ut_sema_clean("fun f[T](a: T, b: T) T { ret (1.0::T) + a; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var p: f64 = 3.0; var q: f64 = 5.0; f[f64](p, q); ret 0; }\n"))                                                                                                                          { bad = 15; }
    if (!ut_sema_clean("fun f[T](a: T, b: T) T { ret (a:~i64):~T; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var p: f64 = 3.0; var q: f64 = 5.0; f[f64](p, q); ret 0; }\n"))                                                                                                                           { bad = 16; }

    # ordering with no comparator parameter
    if (!ut_sema_clean("fun sort[T](p: *T, n: u64) { var i: u64 = 1; for (i < n) { val key: T = p[i]; var j: u64 = i; for (j > 0 && p[j - 1] > key) { p[j] = p[j - 1]; j = j - 1; } p[j] = key; i = i + 1; } }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var a: [4]i64; a[0] = 3; a[1] = 1; a[2] = 4; a[3] = 2; sort[i64](?a[0], 4); ret 0; }\n")) { bad = 17; }

    ret bad;
}

# a refusal belongs to the instantiation that asked for the instance: it names the
# concrete type, points at the call, and carries the operator in the template
test "mach.lang.driver:generic_operator_refused_at_the_instantiation_names_both" {
    var bad: i32 = 0;

    if (!ut_instantiation_trail("rec Point { x: i64; y: i64; }\nfun maxof[T](a: T, b: T) T { if (a > b) { ret a; } ret b; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var p: Point; var q: Point; maxof[Point](p, q); ret 0; }\n",
        "`Point` has no ordering", 174, 18, 63, 5)) { bad = 1; }

    # the template says nothing of its own, so the refusal fires once
    if (ut_sema_errs("rec Point { x: i64; y: i64; }\nfun maxof[T](a: T, b: T) T { if (a > b) { ret a; } ret b; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var p: Point; var q: Point; maxof[Point](p, q); ret 0; }\n") != 1) { bad = 2; }

    ret bad;
}

# `$is_integer` and `$is_float` answer per instance, and each arm reaches lowering
# alone: the constant of the arm the instance selects is the only one emitted
test "mach.lang.driver:generic_shape_predicates_answer_integer_and_float" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "rec P { x: i64; }\nfun kind[T](a: T) i64 { $if ($is_integer(T)) { ret 171; } $or ($is_float(T)) { ret 272; } $or { ret 373; } }\nfun main() i32 { var i: i64 = 1; var f: f64 = 1.0; var p: P; kind[i64](i); kind[f64](f); kind[P](p); ret 0; }\n";

    val pr: res[project.Project, outcome.Fail] = ut_lower_n(?s, ?alloc, ?names[0], ?texts[0], 1);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    var bad: i32        = 0;
    val m:   *ir.Module = ut_ir_of(?p, ?s, "uniontest.main");
    if (m == nil) { bad = 1; }
    or {
        if (ut_const_uses(m, 171) != 1) { bad = 2; }
        if (ut_const_uses(m, 272) != 1) { bad = 3; }
        if (ut_const_uses(m, 373) != 1) { bad = 4; }
    }

    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

# the cost accepted with #3432: a generic nothing instantiates is not checked, and
# the same body at a type that cannot serve it is refused the moment one asks
test "mach.lang.driver:an_uninstantiated_generic_body_is_not_checked" {
    var bad: i32 = 0;

    if (!ut_sema_clean("fun never_used[T](a: T) T { ret a + a; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n"))                                                   { bad = 1; }
    if (ut_sema_errs("rec Point { x: i64; }\nfun used[T](a: T) T { ret a + a; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var p: Point; used[Point](p); ret 0; }\n") != 1) { bad = 2; }

    ret bad;
}

# `:~` reads a type parameter through the instance, so it agrees with `$size_of`
# rather than reading the parameter as zero bytes
test "mach.lang.driver:reinterpret_reads_a_type_parameter_at_the_instance" {
    var bad: i32 = 0;

    if (!ut_sema_clean("fun bits[T](a: T) u64 { ret a:~u64; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var a: i64 = 1; var b: f64 = 1.0; bits[i64](a); bits[f64](b); ret 0; }\n"))     { bad = 1; }
    if (ut_vec_diag("fun bits[T](a: T) u64 { ret a:~u64; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var a: u32 = 1; bits[u32](a); ret 0; }\n", "u32 (4 bytes) vs u64 (8 bytes)") != 0) { bad = 2; }

    ret bad;
}

test "mach.lang.driver:generic_type_gate_prunes_error_arm" {
    var bad: i32 = 0;

    if (!ut_ct_lower_clean("fun write_any[T](a: T) i64 {\n$if ($type_of(a) == i64) { ret 1; }\n$or ($type_of(a) == u32) { ret 2; }\n$or { $error(\"unsupported type\"); } }\npub fun run(x: i64) i64 { ret write_any[i64](x); }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n")) { bad = 1; }

    if (!ut_ct_lower_clean("fun write_any[T](a: T) i64 {\n$if ($type_of(a) == i64) { ret 1; }\n$or ($type_of(a) != i64) { $error(\"unsupported type\"); }\n$or { ret 0; } }\npub fun run(x: i64) i64 { ret write_any[i64](x); }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n")) { bad = 2; }

    if (!ut_ct_lower_clean("fun write_any[T](a: T) i64 {\n$if ($type_of(a) == i64) { ret a; }\n$or ($type_of(a) == u32) { ret a::i64; }\n$or { $error(\"unsupported type\"); } }\npub fun p(x: i64) i64 { ret write_any[i64](x); }\npub fun q(y: u32) i64 { ret write_any[u32](y); }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n")) { bad = 3; }

    ret bad;
}

