test "mach.lang.driver:generic_type_gate_with_error_arm_selects_matching_arm" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "fun write_any[T](a: T) i64 {\n$if ($type_of(a) == i64) { ret 171; }\n$or ($type_of(a) == u32) { ret 272; }\n$or { $error(\"unsupported type\"); } }\npub fun p1(x: i64) i64 { ret write_any[i64](x); }\npub fun p2(y: u32) i64 { ret write_any[u32](y); }\nfun main() i32 { ret 0; }\n";

    val pr: res[project.Project, outcome.Fail] = ut_lower_n(?s, ?alloc, ?names[0], ?texts[0], 1);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    var bad: i32        = 0;
    val m:   *ir.Module = ut_ir_of(?p, ?s, "uniontest.main");
    if (m == nil) { bad = 1; }
    or {
        if (ut_const_uses(m, 171) != 1) { bad = 2; }
        if (ut_const_uses(m, 272) != 1) { bad = 3; }
    }

    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

# #3711: a type parameter is replaced by the argument at ITS declaration's
# position, never by the caller's parameter that shares its index, so a caller
# whose list is reordered or longer than the callee's hands the callee the types
# the source names, and a type substituted once reads as itself under a second pass
fun ut_reorder_src(alloc: *A.Allocator, callers: str, calls: str) str {
    val joined: res[str, format.FormatError] = format.sprint(alloc, "{}{}{}{}{}{}",
        "rec Natural {}\nrec Custom {}\nrec A[K, V] { k: K; v: V; policy: Natural; }\nrec B[K, V] { k: K; v: V; policy: Custom; }\n",
        "fun hk[K, M, P](m: *M, p: P, key: *K) u64 {\n$if ($type_of(p) == Natural) { ret (@key)::u64 + 3711; }\n$or ($type_of(p) == Custom) { ret m.k::u64 + 7113; }\n$or { $error(\"no arm\"); } }\n",
        callers,
        "pub fun run(a: *A[i64, u8], b: *B[i64, u8], key: *i64) u64 { ",
        calls,
        " }\nfun main() i32 { ret 0; }\n");
    if (sel joined.err) { ret ""; }
    ret joined.ok;
}

test "mach.lang.driver:generic_arguments_map_to_the_callee_parameters_not_the_caller_positions" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    # the extra parameter after the callee's first (`find_extra`) and before it
    # (`find_first`); each reaches hk through a concrete two-layer instance
    val callers: str = "fun find_extra[K, V, M, P](m: *M, p: P, key: *K) u64 { ret hk[K, M, P](m, p, key); }\nfun find_first[V, K, M, P](m: *M, p: P, key: *K) u64 { ret hk[K, M, P](m, p, key); }\npub fun get_extra[K, V](m: *A[K, V], key: *K) u64 { var p: Natural; ret find_extra[K, V, A[K, V], Natural](m, p, key); }\npub fun get_first[K, V](m: *B[K, V], key: *K) u64 { var p: Custom; ret find_first[V, K, B[K, V], Custom](m, p, key); }\n";
    var names:   [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = ut_reorder_src(?alloc, callers, "ret get_extra[i64, u8](a, key) + get_first[i64, u8](b, key);");
    if (str_len(texts[0]) == 0) { ret 1; }

    val pr: res[project.Project, outcome.Fail] = ut_lower_n(?s, ?alloc, ?names[0], ?texts[0], 1);
    if (sel pr.err) {
        session.dnit(?s);
        ret 2;
    }
    var p: project.Project = pr.ok;

    var bad: i32        = 0;
    val m:   *ir.Module = ut_ir_of(?p, ?s, "uniontest.main");
    if (m == nil) { bad = 3; }
    or {
        # hk[i64, A[i64, u8], Natural] lowers its Natural arm and hk[i64, B[i64, u8], Custom] its Custom arm
        if (ut_const_uses(m, 3711) != 1) { bad = 4; }
        if (ut_const_uses(m, 7113) != 1) { bad = 5; }
    }

    project.dnit_project(?p);
    session.dnit(?s);
    if (bad != 0) { ret bad; }

    # the gate still judges the concrete instance: a Custom policy on a record
    # without the field the Custom arm reads is refused there, with the trail
    val refused: str = "fun find_extra[K, V, M, P](m: *M, p: P, key: *K) u64 { ret hk[K, M, P](m, p, key); }\npub fun get_bad[K, V](m: *Natural, key: *K) u64 { var p: Custom; ret find_extra[K, V, Natural, Custom](m, p, key); }\n";
    val src_bad: str = ut_reorder_src(?alloc, refused, "var n: Natural; ret get_bad[i64, u8](?n, key);");
    if (str_len(src_bad) == 0)                                               { ret 6; }
    if (ut_ct_lower_diag(src_bad, "no such field `k` on type Natural") != 0) { ret 7; }
    ret 0;
}

# #3710: an instance whose arguments are the caller's own type parameters is
# the template under other names, so it is judged as the template is (not at
# all: nothing in it is decided until the caller is instantiated); the closed
# instance the caller's own instantiation records is still judged, with the trail
test "mach.lang.driver:an_open_instance_is_judged_as_its_template" {
    var bad: i32 = 0;

    # the two templates alone, no call site
    if (!ut_sema_clean("rec Min {}\nrec Max {}\nrec H[T, D] { v: T; order: D; }\nfun before[T, X](h: *X, a: *T, b: *T) i64 {\n$if ($type_of(h.order) == Max) { ret @b - @a; }\n$or ($type_of(h.order) == Min) { ret @a - @b; }\n$or { $error(\"bad\"); } }\nfun mid[T, X](h: *X, a: *T, b: *T) i64 { ret before[T, X](h, a, b); }\nfun main() i32 { ret 0; }\n")) { bad = 1; }
    # the concrete call through the forwarding layer selects the Max arm
    if (!ut_ct_lower_clean("rec Min {}\nrec Max {}\nrec H[T, D] { v: T; order: D; }\nfun before[T, X](h: *X, a: *T, b: *T) i64 {\n$if ($type_of(h.order) == Max) { ret @b - @a; }\n$or ($type_of(h.order) == Min) { ret @a - @b; }\n$or { $error(\"bad\"); } }\nfun mid[T, X](h: *X, a: *T, b: *T) i64 { ret before[T, X](h, a, b); }\nfun go2[T, D](h: *H[T, D], a: *T, b: *T) i64 { ret mid[T, H[T, D]](h, a, b); }\npub fun run(h: *H[i64, Max], a: *i64, b: *i64) i64 { ret go2[i64, Max](h, a, b); }\nfun main() i32 { ret 0; }\n")) { bad = 2; }
    # a closed instance whose X has no `order` is refused, at the instantiation
    val refused: str = "rec Min {}\nrec Max {}\nrec H[T, D] { v: T; order: D; }\nrec Bare { v: i64; }\nfun before[T, X](h: *X, a: *T, b: *T) i64 {\n$if ($type_of(h.order) == Max) { ret @b - @a; }\n$or ($type_of(h.order) == Min) { ret @a - @b; }\n$or { $error(\"bad\"); } }\nfun mid[T, X](h: *X, a: *T, b: *T) i64 { ret before[T, X](h, a, b); }\npub fun run(h: *Bare, a: *i64, b: *i64) i64 { ret mid[i64, Bare](h, a, b); }\nfun main() i32 { ret 0; }\n";
    if (ut_ct_lower_diag(refused, "no such field `order` on type Bare") != 0)                    { bad = 3; }
    if (!ut_instantiation_trail(refused, "no such field `order` on type Bare", 285, 21, 133, 7)) { bad = 4; }

    ret bad;
}

test "mach.lang.driver:pack_each_body_instance_revalidated" {
    var bad: i32 = 0;

    if (ut_ct_lower_diag("var g: ^u32 = 99;\nfun fmt(va: ...) u32 { ret 0; }\nfun show[U](s: U) u32 { ret fmt(s); }\nfun sink(va: ...) u32 { var acc: u32 = 0; $each a in va { acc = acc + show[^u32](g) + a; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var one: u32 = 1; sink(one); ret 0; }\n",
        "secret value cannot be passed to a variadic") != 0) { bad = 1; }

    if (ut_ct_lower_diag("var g: ^u32 = 99;\nfun fmt(va: ...) u32 { ret 0; }\nfun show[U](s: U) u32 { ret fmt(s); }\nfun sink() u32 { ret show[^u32](g); }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { sink(); ret 0; }\n",
        "secret value cannot be passed to a variadic") != 0) { bad = 1; }

    if (ut_ct_lower_diag("rec Pt { x: u32; y: u32; }\nvar p: Pt;\nvar q: Pt;\nfun eq[T](a: T, b: T) u32 { if (a == b) { ret 1; } ret 0; }\nfun sink(va: ...) u32 { var acc: u32 = 0; $each e in va { acc = acc + eq[Pt](p, q) + e; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var one: u32 = 1; sink(one); ret 0; }\n",
        "aggregate equality is not structural") != 0) { bad = 1; }

    if (ut_ct_lower_diag("var g: ^u32 = 99;\n#[oblivious]\nfun eq[T](a: T, b: T) u8 { ret a == b; }\nfun sink(va: ...) u32 { var acc: u32 = 0; $each e in va { acc = acc + eq[^u32](g, g)::u32 + e; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var one: u32 = 1; sink(one); ret 0; }\n",
        "expected u8, found ^u8") != 0) { bad = 1; }

    if (ut_ct_lower_diag("var g: ^u32 = 99;\n#[oblivious]\nfun br[T](a: T, b: T) u32 { if (a == b) { ret 1; } ret 0; }\nfun sink(va: ...) u32 { var acc: u32 = 0; $each e in va { acc = acc + br[^u32](g, g) + e; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var one: u32 = 1; sink(one); ret 0; }\n",
        "secret value used as a branch condition") != 0) { bad = 1; }

    if (ut_ct_lower_diag("var g: ^u32 = 99;\n#[oblivious]\nfun inner[V](a: V, b: V) u32 { if (a == b) { ret 1; } ret 0; }\n#[oblivious]\nfun outer[U](a: U, b: U) u32 { ret inner[U](a, b); }\nfun sink(va: ...) u32 { var acc: u32 = 0; $each e in va { acc = acc + outer[^u32](g, g) + e; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var one: u32 = 1; sink(one); ret 0; }\n",
        "secret value used as a branch condition") != 0) { bad = 1; }

    if (ut_ct_lower_diag("var g: ^u32 = 99;\n#[oblivious]\nfun br[T](a: T, b: T) u32 { if (a == b) { ret 1; } ret 0; }\nfun inr(va: ...) u32 { var acc: u32 = 0; $each b in va { acc = acc + br[^u32](g, g) + b; } ret acc; }\nfun otr(va: ...) u32 { var acc: u32 = 0; $each a in va { acc = acc + inr(a); } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var one: u32 = 1; otr(one); ret 0; }\n",
        "secret value used as a branch condition") != 0) { bad = 1; }

    if (ut_ct_lower_diag("var g: ^u32 = 99;\n#[oblivious]\nfun br[T](a: T, b: T) u32 { if (a == b) { ret 1; } ret 0; }\nfun tail(va: ...) u32 { var acc: u32 = 0; $each b in va { acc = acc + br[^u32](g, g) + b; } ret acc; }\nfun head(va: ...) u32 { ret tail(va...); }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var one: u32 = 1; head(one); ret 0; }\n",
        "secret value used as a branch condition") != 0) { bad = 1; }

    if (!ut_ct_lower_clean("fun show[U](s: U) u32 { ret 1; }\nfun sink(va: ...) u32 { var acc: u32 = 0; $each a in va { acc = acc + show[u32](a); } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var one: u32 = 1; sink(one); ret 0; }\n"))                                                                    { bad = 1; }
    if (!ut_ct_lower_clean("var g: ^u32 = 99;\nfun fmt(va: ...) u32 { ret 0; }\nfun show[U](s: U) u32 { ret fmt(s:>u32); }\nfun sink(va: ...) u32 { var acc: u32 = 0; $each a in va { acc = acc + show[^u32](g) + a; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var one: u32 = 1; sink(one); ret 0; }\n")) { bad = 1; }

    if (!ut_ct_lower_clean("rec Rc { a: u32; }\nvar g: Rc;\nfun take[T](x: T) u32 { ret 1u32; }\nfun sink(va: ...) u32 { var acc: u32 = 0; $each e in va { acc = acc + take[Rc](g); $if ($type_of(e) == u32) { acc = acc + e; } $or { $error(\"sink: unsupported element type\"); } } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var one: u32 = 1; sink(one); ret 0; }\n")) { bad = 1; }

    ret bad;
}

fun ut_defined_fn_sig(s: *session.Session, m: *ir.Module, needle: str) ir_type.IrTypeId {
    if (m == nil) { ret ir_type.IRT_NIL; }
    var fi: u32 = 0;
    for (fi < m.function_len) {
        val f: *ir.Function = ?m.functions[fi];
        if ((f.flags & ir.FN_FLAG_EXTERN) == 0) {
            val nm: opt[str] = intern.lookup(?s.interner, f.name);
            if (sel nm.some && ut_str_contains(nm.some, needle)) { ret f.sig; }
        }
        fi = fi + 1;
    }
    ret ir_type.IRT_NIL;
}

fun ut_sig_ret_kind(m: *ir.Module, sig: ir_type.IrTypeId) ir_type.IrTypeKind {
    if (m == nil || sig == ir_type.IRT_NIL) { ret ir_type.IRT_VOID; }
    val t: opt[*ir_type.IrType] = ir_type.get(?m.types, sig);
    if (sel t.none)                    { ret ir_type.IRT_VOID; }
    if (t.some.kind != ir_type.IRT_FN) { ret ir_type.IRT_VOID; }
    val rt: ir_type.IrTypeId     = t.some.data.fn.ret_type;
    val r:  opt[*ir_type.IrType] = ir_type.get(?m.types, rt);
    if (sel r.none) { ret ir_type.IRT_VOID; }
    ret r.some.kind;
}

fun ut_sig_param_kind(m: *ir.Module, sig: ir_type.IrTypeId, ix: u32) ir_type.IrTypeKind {
    if (m == nil || sig == ir_type.IRT_NIL) { ret ir_type.IRT_VOID; }
    val t: opt[*ir_type.IrType] = ir_type.get(?m.types, sig);
    if (sel t.none) { ret ir_type.IRT_VOID; }
    val ft: *ir_type.IrType = t.some;
    if (ft.kind != ir_type.IRT_FN)    { ret ir_type.IRT_VOID; }
    if (ix >= ft.data.fn.param_count) { ret ir_type.IRT_VOID; }
    val p: opt[*ir_type.IrType] = ir_type.get(?m.types, ft.data.fn.params[ix]);
    if (sel p.none) { ret ir_type.IRT_VOID; }
    ret p.some.kind;
}

test "mach.lang.driver:pack_generic_body_typed_at_instance" {
    var bad: i32 = 0;

    if (ut_ct_lower_diag("fun logf(va: ...) u32 { ret 0; }\nfun sink[T](va: ...) u32 { var acc: u32 = 0; $each a in va { var z: T; acc = acc + logf(z); acc = acc + a; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var one: u32 = 1; sink[^u32](one); ret 0; }\n",
        "secret value cannot be passed to a variadic") != 0) { bad = 1; }
    if (!ut_ct_lower_clean("fun logf(va: ...) u32 { ret 0; }\nfun sink[T](va: ...) u32 { var acc: u32 = 0; $each a in va { var z: T; acc = acc + logf(z); acc = acc + a; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var one: u32 = 1; sink[u32](one); ret 0; }\n")) { bad = 1; }

    if (ut_ct_lower_diag("fun logf(va: ...) u32 { ret 0; }\nfun sink[T, U](va: ...) u32 { var acc: u32 = 0; $each a in va { var z: U; acc = acc + logf(z); acc = acc + a; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var one: u32 = 1; sink[u32, ^u32](one); ret 0; }\n",
        "secret value cannot be passed to a variadic") != 0) { bad = 1; }
    if (!ut_ct_lower_clean("fun logf(va: ...) u32 { ret 0; }\nfun sink[T, U](va: ...) u32 { var acc: u32 = 0; $each a in va { var z: U; acc = acc + logf(z); acc = acc + a; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var one: u32 = 1; sink[u32, u32](one); ret 0; }\n")) { bad = 1; }

    if (ut_ct_lower_diag("fun logf(va: ...) u32 { ret 0; }\nfun sink[T](t: T, va: ...) u32 { var acc: u32 = 0; $each a in va { acc = acc + logf(t); acc = acc + a; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var s: ^u32 = 9; var one: u32 = 1; sink[^u32](s, one); ret 0; }\n",
        "secret value cannot be passed to a variadic") != 0) { bad = 1; }
    if (!ut_ct_lower_clean("fun logf(va: ...) u32 { ret 0; }\nfun sink[T](t: T, va: ...) u32 { var acc: u32 = 0; $each a in va { acc = acc + logf(t); acc = acc + a; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var p: u32 = 9; var one: u32 = 1; sink[u32](p, one); ret 0; }\n")) { bad = 1; }

    if (ut_ct_lower_diag("fun probe[U](a: U, b: U) u32 { if (a == b) { ret 1; } ret 0; }\nfun sink[T](va: ...) u32 { var acc: u32 = 0; $each e in va { var x: T; var y: T; acc = acc + probe[T](x, y); } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var one: u32 = 1; sink[^u32](one); ret 0; }\n",
        "secret value used as a branch condition") != 0) { bad = 1; }
    if (!ut_ct_lower_clean("fun probe[U](a: U, b: U) u32 { if (a == b) { ret 1; } ret 0; }\nfun sink[T](va: ...) u32 { var acc: u32 = 0; $each e in va { var x: T; var y: T; acc = acc + probe[T](x, y); } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var one: u32 = 1; sink[u32](one); ret 0; }\n")) { bad = 1; }

    if (ut_ct_lower_diag("fun logf(va: ...) u32 { ret 0; }\nfun inner[U](va: ...) u32 { var acc: u32 = 0; $each b in va { var z: U; acc = acc + logf(z); acc = acc + b; } ret acc; }\nfun outer[T](va: ...) u32 { var acc: u32 = 0; $each a in va { acc = acc + inner[T](a); } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var one: u32 = 1; outer[^u32](one); ret 0; }\n",
        "secret value cannot be passed to a variadic") != 0) { bad = 1; }
    if (!ut_ct_lower_clean("fun logf(va: ...) u32 { ret 0; }\nfun inner[U](va: ...) u32 { var acc: u32 = 0; $each b in va { var z: U; acc = acc + logf(z); acc = acc + b; } ret acc; }\nfun outer[T](va: ...) u32 { var acc: u32 = 0; $each a in va { acc = acc + inner[T](a); } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var one: u32 = 1; outer[u32](one); ret 0; }\n")) { bad = 1; }

    if (ut_ct_lower_diag("fun logf(va: ...) u32 { ret 0; }\nfun tail[U](va: ...) u32 { var acc: u32 = 0; $each b in va { var z: U; acc = acc + logf(z); acc = acc + b; } ret acc; }\nfun fwd[T](va: ...) u32 { ret tail[T](va...); }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var one: u32 = 1; fwd[^u32](one); ret 0; }\n",
        "secret value cannot be passed to a variadic") != 0) { bad = 1; }
    if (!ut_ct_lower_clean("fun logf(va: ...) u32 { ret 0; }\nfun tail[U](va: ...) u32 { var acc: u32 = 0; $each b in va { var z: U; acc = acc + logf(z); acc = acc + b; } ret acc; }\nfun fwd[T](va: ...) u32 { ret tail[T](va...); }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var one: u32 = 1; fwd[u32](one); ret 0; }\n")) { bad = 1; }

    if (ut_ct_lower_diag("rec P { x: ^u32; }\nfun logf(va: ...) u32 { ret 0; }\nfun sink[T](v: T, va: ...) u32 { var acc: u32 = 0; $each e in va { $each f in $fields(T) { acc = acc + logf(v.[f]); } acc = acc + e; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var p: P; var one: u32 = 1; sink[P](p, one); ret 0; }\n",
        "secret value cannot be passed to a variadic") != 0) { bad = 1; }
    if (!ut_ct_lower_clean("rec Q { x: u32; }\nfun logf(va: ...) u32 { ret 0; }\nfun sink[T](v: T, va: ...) u32 { var acc: u32 = 0; $each e in va { $each f in $fields(T) { acc = acc + logf(v.[f]); } acc = acc + e; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var q: Q; var one: u32 = 1; sink[Q](q, one); ret 0; }\n")) { bad = 1; }

    if (ut_ct_lower_diag("rec P { x: ^u32; }\nfun logf(va: ...) u32 { ret 0; }\nfun sink[T](va: ...) u32 { var acc: u32 = 0; $each a in va { var z: T; acc = acc + logf(z); acc = acc + a; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var one: u32 = 1; sink[P](one); ret 0; }\n",
        "secret value cannot be passed to a variadic") != 0) { bad = 1; }
    if (!ut_ct_lower_clean("rec Q { x: u32; }\nfun logf(va: ...) u32 { ret 0; }\nfun sink[T](va: ...) u32 { var acc: u32 = 0; $each a in va { var z: T; acc = acc + logf(z); acc = acc + a; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var one: u32 = 1; sink[Q](one); ret 0; }\n")) { bad = 1; }

    if (ut_ct_lower_diag("fun logf(va: ...) u32 { ret 0; }\nfun sink[T](va: ...) u32 { var acc: u32 = 0; $each a in va { var z: T; acc = acc + logf(z); acc = acc + a; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var one: u32 = 1; sink[u32](one); sink[^u32](one); ret 0; }\n",
        "secret value cannot be passed to a variadic") != 0) { bad = 1; }
    if (ut_ct_lower_diag("fun logf(va: ...) u32 { ret 0; }\nfun sink[T](va: ...) u32 { var acc: u32 = 0; $each a in va { var z: T; acc = acc + logf(z); acc = acc + a; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var one: u32 = 1; sink[^u32](one); sink[u32](one); ret 0; }\n",
        "secret value cannot be passed to a variadic") != 0) { bad = 1; }

    val cmp_pack: str = "fun cmp[T](a: T, b: T, va: ...) u32 { var acc: u32 = 0; $each e in va { var m: ^u8 = a == b; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var s: ^u32 = 1; var one: u32 = 1; cmp[^u32](s, s, one); ret 0; }\n";
    if (ut_ct_lower_diag(cmp_pack,
        "`cmp` performs a constant-time comparison") != 0) { bad = 1; }

    ret bad;
}

test "mach.lang.driver:pack_generic_instance_names" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:   session.Session = sr.ok;
    var bad: i32             = 0;

    var n1: [1]str;
    n1[0] = "main.mach";
    var t1: [1]str;
    t1[0] = "fun sink[T](va: ...) u32 { var acc: u32 = 0; $each a in va { acc = acc + a; } ret acc; }\nfun main() i32 { var one: u32 = 1; sink[u32](one); sink[^u32](one); ret 0; }\n";
    val p1: res[project.Project, outcome.Fail] = ut_lower_n(?s, ?alloc, ?n1[0], ?t1[0], 1);
    if (sel p1.err) { bad = 1; }
    if (sel p1.ok) {
        var pp: project.Project = p1.ok;
        val m:  *ir.Module      = ut_ir_of(?pp, ?s, "uniontest.main");
        if (ut_defined_fn_count(?s, m, ".sink$") != 2)                               { bad = 1; }
        if (ut_defined_fn_exact(?s, m, "uniontest.main.sink$u32$pack$u32") != 1)     { bad = 1; }
        if (ut_defined_fn_exact(?s, m, "uniontest.main.sink$sec$u32$pack$u32") != 1) { bad = 1; }
        project.dnit_project(?pp);
    }

    var n2: [1]str;
    n2[0] = "main.mach";
    var t2: [1]str;
    t2[0] = "fun sink[T](va: ...) u32 { var acc: u32 = 0; $each a in va { acc = acc + 1; } ret acc; }\nfun main() i32 { var a: u32 = 1; var b: u64 = 2; sink[u32](a); sink[u64](a); sink[u32](a, b); sink[u64](a, b); sink[u32](a); ret 0; }\n";
    val p2: res[project.Project, outcome.Fail] = ut_lower_n(?s, ?alloc, ?n2[0], ?t2[0], 1);
    if (sel p2.err) { bad = 1; }
    if (sel p2.ok) {
        var pp: project.Project = p2.ok;
        val m:  *ir.Module      = ut_ir_of(?pp, ?s, "uniontest.main");
        if (ut_defined_fn_count(?s, m, ".sink$") != 4)                               { bad = 1; }
        if (ut_defined_fn_exact(?s, m, "uniontest.main.sink$u32$pack$u32") != 1)     { bad = 1; }
        if (ut_defined_fn_exact(?s, m, "uniontest.main.sink$u64$pack$u32") != 1)     { bad = 1; }
        if (ut_defined_fn_exact(?s, m, "uniontest.main.sink$u32$pack$u32$u64") != 1) { bad = 1; }
        if (ut_defined_fn_exact(?s, m, "uniontest.main.sink$u64$pack$u32$u64") != 1) { bad = 1; }
        project.dnit_project(?pp);
    }

    var n3: [1]str;
    n3[0] = "main.mach";
    var t3: [1]str;
    t3[0] = "fun sum(va: ...) u32 { var acc: u32 = 0; $each a in va { acc = acc + a; } ret acc; }\nfun main() i32 { var one: u32 = 1; sum(one); ret 0; }\n";
    val p3: res[project.Project, outcome.Fail] = ut_lower_n(?s, ?alloc, ?n3[0], ?t3[0], 1);
    if (sel p3.err) { bad = 1; }
    if (sel p3.ok) {
        var pp: project.Project = p3.ok;
        val m:  *ir.Module      = ut_ir_of(?pp, ?s, "uniontest.main");
        if (ut_defined_fn_exact(?s, m, "uniontest.main.sum$pack$u32") != 1) { bad = 1; }
        if (ut_defined_fn_count(?s, m, ".sum$") != 1)                       { bad = 1; }
        project.dnit_project(?pp);
    }

    var n4: [2]str;
    n4[0] = "main.mach";
    n4[1] = "lib.mach";
    var t4: [2]str;
    t4[0] = "use uniontest.lib;\nfun main() i32 { var one: u32 = 1; lib.sink[u32](one); lib.sink[^u32](one); ret 0; }\n";
    t4[1] = "pub fun sink[T](va: ...) u32 { var acc: u32 = 0; $each a in va { acc = acc + a; } ret acc; }\n";
    val p4: res[project.Project, outcome.Fail] = ut_lower_n(?s, ?alloc, ?n4[0], ?t4[0], 2);
    if (sel p4.err) { bad = 1; }
    if (sel p4.ok) {
        var pp: project.Project = p4.ok;
        val m:  *ir.Module      = ut_ir_of(?pp, ?s, "uniontest.main");
        if (ut_defined_fn_count(?s, m, "uniontest.lib.") != 2)                      { bad = 1; }
        if (ut_defined_fn_exact(?s, m, "uniontest.lib.sink$u32$pack$u32") != 1)     { bad = 1; }
        if (ut_defined_fn_exact(?s, m, "uniontest.lib.sink$sec$u32$pack$u32") != 1) { bad = 1; }
        project.dnit_project(?pp);
    }

    session.dnit(?s);
    ret bad;
}

test "mach.lang.driver:pack_generic_signature_substituted" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var bad: i32 = 0;

    val lead: str = ut_cc3(?alloc,
        "fun sink[T](t: T, va: ...) u32 { var acc: u32 = 0; $each a in va { acc = acc + a; } ret acc; }\n#[symbol(\"",
        ut_entry_symbol(), "\")]\nfun start() i32 { var t: u32 = 3; var one: u32 = 1; sink[u32](t, one); ret 0; }\n");
    if (ut_engine_build_fails(lead) == 0) { bad = 1; }

    val broken: str = ut_cc3(?alloc,
        "fun sink[T](t: T, va: ...) u32 { var acc: *u8 = nil; $each a in va { acc = a; } ret 0; }\n#[symbol(\"",
        ut_entry_symbol(), "\")]\nfun start() i32 { var t: u32 = 3; var one: u32 = 1; sink[u32](t, one); ret 0; }\n");
    if (ut_engine_build_fails(broken) != 0) { bad = 1; }

    if (!ut_ct_lower_clean("rec Box { a: u32; b: u32; c: u32; d: u32; }\nfun mk[T](seed: T, va: ...) T { $each a in va { ret seed; } ret seed; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var b: Box; var one: u32 = 1; mk[Box](b, one); ret 0; }\n")) { bad = 1; }
    if (ut_ct_lower_diag("rec Box { a: u32; b: u32; c: u32; d: u32; }\nfun mk[T](seed: T, va: ...) T { $each a in va { ret a; } ret seed; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var b: Box; var one: u32 = 1; mk[Box](b, one); ret 0; }\n",
        "expected Box, found u32") != 0) { bad = 1; }

    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "rec Box { a: u32; b: u32; c: u32; d: u32; }\nfun mk[T](seed: T, va: ...) T { $each a in va { ret seed; } ret seed; }\nfun main() i32 { var b: Box; var one: u32 = 1; mk[Box](b, one); ret 0; }\n";
    val pr: res[project.Project, outcome.Fail] = ut_lower_n(?s, ?alloc, ?names[0], ?texts[0], 1);
    if (sel pr.err) { bad = 1; }
    if (sel pr.ok) {
        var p:   project.Project  = pr.ok;
        val m:   *ir.Module       = ut_ir_of(?p, ?s, "uniontest.main");
        val sig: ir_type.IrTypeId = ut_defined_fn_sig(?s, m, "uniontest.main.mk$");
        if (sig == ir_type.IRT_NIL)                             { bad = 1; }
        if (ut_sig_param_kind(m, sig, 0) != ir_type.IRT_STRUCT) { bad = 1; }
        if (ut_sig_ret_kind(m, sig) != ir_type.IRT_STRUCT)      { bad = 1; }
        project.dnit_project(?p);
    }

    session.dnit(?s);
    ret bad;
}

test "mach.lang.driver:pack_instance_enclosing_body_typed" {
    var bad: i32 = 0;

    if (ut_ct_lower_diag("fun logf(va: ...) u32 { ret 0; }\nfun sink[T](va: ...) u32 { var acc: u32 = 0; var z: T; $each a in va { acc = acc + logf(z); acc = acc + a; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var one: u32 = 1; sink[^u32](one); ret 0; }\n",
        "secret value cannot be passed to a variadic") != 0) { bad = 1; }
    if (!ut_ct_lower_clean("fun logf(va: ...) u32 { ret 0; }\nfun sink[T](va: ...) u32 { var acc: u32 = 0; var z: T; $each a in va { acc = acc + logf(z); acc = acc + a; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var one: u32 = 1; sink[u32](one); ret 0; }\n")) { bad = 1; }

    if (ut_ct_lower_diag("fun logf(va: ...) u32 { ret 0; }\nfun sink[T](t: T, va: ...) u32 { var acc: u32 = 0; var z: T = t; $each a in va { acc = acc + logf(z); acc = acc + a; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var s: ^u32 = 9; var one: u32 = 1; sink[^u32](s, one); ret 0; }\n",
        "secret value cannot be passed to a variadic") != 0) { bad = 1; }

    if (ut_ct_lower_diag("fun logf(va: ...) u32 { ret 0; }\nfun sink[T, U](va: ...) u32 { var acc: u32 = 0; var z: U; $each a in va { acc = acc + logf(z); acc = acc + a; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var one: u32 = 1; sink[u32, ^u32](one); ret 0; }\n",
        "secret value cannot be passed to a variadic") != 0) { bad = 1; }

    if (ut_ct_lower_diag("fun logf(va: ...) u32 { ret 0; }\nfun sink[T](va: ...) u32 { var acc: u32 = 0; { var z: T; $each a in va { acc = acc + logf(z); acc = acc + a; } } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var one: u32 = 1; sink[^u32](one); ret 0; }\n",
        "secret value cannot be passed to a variadic") != 0) { bad = 1; }

    if (ut_ct_lower_diag("fun logf(va: ...) u32 { ret 0; }\nfun sink[T](n: u32, va: ...) u32 { var acc: u32 = 0; if (n > 0) { var z: T; $each a in va { acc = acc + logf(z); acc = acc + a; } } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var one: u32 = 1; sink[^u32](one, one); ret 0; }\n",
        "secret value cannot be passed to a variadic") != 0) { bad = 1; }

    if (ut_ct_lower_diag("fun logf(va: ...) u32 { ret 0; }\nfun sink[T](va: ...) u32 { var acc: u32 = 0; var z: T; var i: u32 = 0; for (i < 2) { $each a in va { acc = acc + logf(z) + a; } i = i + 1; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var one: u32 = 1; sink[^u32](one); ret 0; }\n",
        "secret value cannot be passed to a variadic") != 0) { bad = 1; }

    if (ut_ct_lower_diag("fun logf(va: ...) u32 { ret 0; }\nfun sink[T](va: ...) u32 { var acc: u32 = 0; var z: T; { fin { $each a in va { acc = acc + logf(z) + a; } } acc = acc + 1; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var one: u32 = 1; sink[^u32](one); ret 0; }\n",
        "secret value cannot be passed to a variadic") != 0) { bad = 1; }

    var xn: [2]str;
    xn[0] = "main.mach";
    xn[1] = "lib.mach";
    var xt: [2]str;
    xt[0] = "use uniontest.lib;\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var one: u32 = 1; lib.sink[^u32](one); ret 0; }\n";
    xt[1] = "pub fun logf(va: ...) u32 { ret 0; }\npub fun sink[T](va: ...) u32 { var acc: u32 = 0; var z: T; $each a in va { acc = acc + logf(z); acc = acc + a; } ret acc; }\n";
    if (ut_ct_lower_diag_n(?xn[0], ?xt[0], 2, "secret value cannot be passed to a variadic") != 0) { bad = 1; }

    if (!ut_ct_lower_lacks("fun logf(va: ...) u32 { ret 0; }\nfun inner[U](x: U, va: ...) u32 { var acc: u32 = 0; $each b in va { acc = acc + logf(x) + b; } ret acc; }\nfun outer[T](va: ...) u32 { var acc: u32 = 0; var z: T; $each a in va { acc = acc + inner[T](z, a); } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var one: u32 = 1; outer[^u32](one); ret 0; }\n",
        "found T")) { bad = 1; }
    if (ut_ct_lower_diag("fun logf(va: ...) u32 { ret 0; }\nfun inner[U](x: U, va: ...) u32 { var acc: u32 = 0; $each b in va { acc = acc + logf(x) + b; } ret acc; }\nfun outer[T](va: ...) u32 { var acc: u32 = 0; var z: T; $each a in va { acc = acc + inner[T](z, a); } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var one: u32 = 1; outer[^u32](one); ret 0; }\n",
        "secret value cannot be passed to a variadic") != 0) { bad = 1; }

    if (!ut_ct_lower_clean("rec Box { a: u32; b: u32; c: u32; d: u32; }\nfun mk[T](seed: T, va: ...) T { var out: T = seed; $each a in va { ret out; } ret out; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var b: Box; var one: u32 = 1; mk[Box](b, one); ret 0; }\n")) { bad = 1; }
    if (!ut_ct_lower_clean("rec Box { a: u32; b: u32; c: u32; d: u32; }\nfun mk[T](seed: T, va: ...) T { var out: T; $each a in va { out = seed; } ret out; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var b: Box; var one: u32 = 1; mk[Box](b, one); ret 0; }\n"))     { bad = 1; }

    if (ut_ct_lower_diag("rec Box { a: u32; b: u32; c: u32; d: u32; }\nfun mk[T](seed: T, va: ...) u32 { var out: T = seed; $each a in va { ret out; } ret 0; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var b: Box; var one: u32 = 1; mk[Box](b, one); ret 0; }\n",
        "expected u32, found Box") != 0) { bad = 1; }

    if (ut_ct_lower_errs("fun sink[T](va: ...) u32 { var acc: u32 = 0; var z: T; if (z) { acc = 1; } $each a in va { acc = acc + 1; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var one: u32 = 1; var two: u64 = 2; sink[^u32](one); sink[^u32](one, two); ret 0; }\n") != 1)                                                   { bad = 1; }
    if (ut_ct_lower_errs("fun sink[T](va: ...) u32 { var acc: u32 = 0; var z: T; $error(\"boom\"); $each a in va { acc = acc + 1; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var one: u32 = 1; var two: u64 = 2; sink[^u32](one); sink[^u32](one, two); ret 0; }\n") != 1)                                                     { bad = 1; }
    if (ut_ct_lower_errs("#[oblivious]\nfun br[V](a: V, b: V) u32 { if (a == b) { ret 1; } ret 0; }\nfun sink[T](va: ...) u32 { var acc: u32 = 0; var x: T; var y: T; acc = acc + br[T](x, y); $each a in va { acc = acc + 1; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var one: u32 = 1; sink[^u32](one); ret 0; }\n") != 1) { bad = 1; }

    ret bad;
}

test "mach.lang.driver:pack_instance_enclosing_typeof_folds" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:   session.Session = sr.ok;
    var bad: i32             = 0;

    var n1: [1]str;
    n1[0] = "main.mach";
    var t1: [1]str;
    t1[0] = "fun pick[T](seed: T, va: ...) u32 { var out: T = seed; var r: u32 = 0; $each a in va { $if ($type_of(out) == u32) { r = r + 4001; } $or { r = r + 4002; } } ret r; }\nfun main() i32 { var p: u32 = 5; var one: u32 = 1; pick[u32](p, one); ret 0; }\n";
    val p1: res[project.Project, outcome.Fail] = ut_lower_n(?s, ?alloc, ?n1[0], ?t1[0], 1);
    if (sel p1.err) { bad = 1; }
    if (sel p1.ok) {
        var pp: project.Project = p1.ok;
        val m:  *ir.Module      = ut_ir_of(?pp, ?s, "uniontest.main");
        if (ut_const_uses(m, 4001) != 1) { bad = 1; }
        if (ut_const_uses(m, 4002) != 0) { bad = 1; }
        project.dnit_project(?pp);
    }

    var n2: [1]str;
    n2[0] = "main.mach";
    var t2: [1]str;
    t2[0] = "fun pick[T](seed: T, va: ...) u32 { var out: T = seed; var r: u32 = 0; $if ($type_of(out) == u32) { r = r + 4001; } $or { r = r + 4002; } $each a in va { r = r + a; } ret r; }\nfun main() i32 { var p: u32 = 5; var one: u32 = 1; pick[u32](p, one); ret 0; }\n";
    val p2: res[project.Project, outcome.Fail] = ut_lower_n(?s, ?alloc, ?n2[0], ?t2[0], 1);
    if (sel p2.err) { bad = 1; }
    if (sel p2.ok) {
        var pp: project.Project = p2.ok;
        val m:  *ir.Module      = ut_ir_of(?pp, ?s, "uniontest.main");
        if (ut_const_uses(m, 4001) != 1) { bad = 1; }
        if (ut_const_uses(m, 4002) != 0) { bad = 1; }
        project.dnit_project(?pp);
    }

    var n3: [1]str;
    n3[0] = "main.mach";
    var t3: [1]str;
    t3[0] = "fun pick[T](seed: T, va: ...) u32 { var out: T = seed; var r: u32 = 0; $each a in va { $if ($type_of(out) == u32) { r = r + 4001; } $or { r = r + 4002; } } ret r; }\nfun main() i32 { var p: u64 = 5; var one: u32 = 1; pick[u64](p, one); ret 0; }\n";
    val p3: res[project.Project, outcome.Fail] = ut_lower_n(?s, ?alloc, ?n3[0], ?t3[0], 1);
    if (sel p3.err) { bad = 1; }
    if (sel p3.ok) {
        var pp: project.Project = p3.ok;
        val m:  *ir.Module      = ut_ir_of(?pp, ?s, "uniontest.main");
        if (ut_const_uses(m, 4001) != 0) { bad = 1; }
        if (ut_const_uses(m, 4002) != 1) { bad = 1; }
        project.dnit_project(?pp);
    }

    session.dnit(?s);
    ret bad;
}

fun ut_appd(buf: *u8, w: usize, v: u32) usize {
    if (v >= 10) {
        val k: usize = ut_appd(buf, w, v / 10);
        buf[k] = ('0'::u32 + v % 10)::u8;
        ret k + 1;
    }
    buf[w] = ('0'::u32 + v)::u8;
    ret w + 1;
}
