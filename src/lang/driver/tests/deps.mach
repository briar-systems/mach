fun ut_git_commit_all(alloc: *A.Allocator, dir: str, message: str) bool {
    var add: [4]str;
    add[0] = "-C";
    add[1] = dir;
    add[2] = "add";
    add[3] = "-A";
    if (!ut_git(alloc, ?add[0], 4)) { ret false; }
    var commit: [5]str;
    commit[0] = "-C";
    commit[1] = dir;
    commit[2] = "commit";
    commit[3] = "-qm";
    commit[4] = message;
    ret ut_git(alloc, ?commit[0], 5);
}

fun ut_write_gitmodules2(alloc: *A.Allocator, root: str, a1: str, s1: str, a2: str, s2: str) bool {
    val path:          str             = ut_cc3(alloc, root, "/", ".gitmodules");
    val text:          str             = ut_cc3(alloc, ut_gitmodules(alloc, a1, s1), ut_gitmodules(alloc, a2, s2), "");
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(path, text, str_len(text), 420);
    ret sel write_bytes_r.ok;
}

fun ut_git_ref(alloc: *A.Allocator, root: str, rel: str) res[str, fail.Fail] {
    val path:  str                  = ut_cc3(alloc, root, "/.git/", rel);
    val raw_r: res[str, fs.FsError] = fs.read_string(alloc, path);
    if (sel raw_r.err) { ret res[str, fail.Fail].err{fail.fs_refused(raw_r.err)}; }
    val raw: str   = raw_r.ok;
    var n:   usize = str_len(raw);
    for (n > 0 && (raw[n - 1] == 10 || raw[n - 1] == 13)) { n = n - 1; }
    val copy_r: res[str, string.StrError] = str_copy_slice(alloc, raw, 0, n);
    str_free(alloc, raw);
    if (sel copy_r.err) { ret res[str, fail.Fail].err{fail.str_refused(copy_r.err)}; }
    ret res[str, fail.Fail].ok{copy_r.ok};
}

fun ut_dep_root_one(alloc: *A.Allocator, alias: str, path: str) str {
    val head: str = "[project]\nmach = \">=5\"\nid = \"app\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.linux]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[profile.debug]\nopt = 0\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n\n[artifact.app]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/app\"\ntargets = [\"*\"]\nlink = []\nneed = []\n\n[dep.";
    val mid:  str = ut_cc3(alloc, head, alias, "]\npath = \"");
    ret ut_cc3(alloc, mid, path, "\"\n");
}

fun ut_dep_root_git_ref(alloc: *A.Allocator, alias: str, source: str, ref: str) str {
    val head:        str = "[project]\nmach = \">=5\"\nid = \"app\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.linux]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[profile.debug]\nopt = 0\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n\n[artifact.app]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/app\"\ntargets = [\"*\"]\nlink = []\nneed = []\n\n[dep.";
    val mid:         str = ut_cc3(alloc, head, alias, "]\ngit = \"");
    val with_source: str = ut_cc3(alloc, mid, source, "\"\nref = \"");
    ret ut_cc3(alloc, with_source, ref, "\"\n");
}

fun ut_dep_root_git(alloc: *A.Allocator, alias: str, source: str) str {
    ret ut_dep_root_git_ref(alloc, alias, source, "branch/main");
}

fun ut_dep_root_two(alloc: *A.Allocator, alias1: str, path1: str, alias2: str, path2: str) str {
    val first: str = ut_dep_root_one(alloc, alias1, path1);
    val mid:   str = ut_cc3(alloc, first, "\n[dep.", alias2);
    val tail:  str = ut_cc3(alloc, mid, "]\npath = \"", path2);
    ret ut_cc3(alloc, tail, "\"\n", "");
}

fun ut_dep_lib_with_export(alloc: *A.Allocator, id: str) str {
    ret ut_cc3(alloc, "[project]\nmach = \">=5\"\nid = \"", id,
        "\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[link.mylink]\nsource = \"local\"\npath = \"{project.out}/mylink.o\"\nos = [\"*\"]\nisa = [\"*\"]\nabi = [\"*\"]\nexport = true\n\n[artifact.lib]\nkind = \"static\"\nentry = \"lib.mach\"\nout = \"lib/l\"\ntargets = [\"*\"]\nlink = []\nneed = []\n");
}

fun ut_dep_build_ok(s: *session.Session, root: str) bool {
    val pr: res[project.Project, outcome.Fail] = driver.build_project_union(s, root);
    if (sel pr.err) { ret false; }
    var p: project.Project = pr.ok;
    project.dnit_project(?p);
    ret true;
}

fun ut_dep_build_fails(s: *session.Session, root: str, needle: str) bool {
    val pr: res[project.Project, outcome.Fail] = driver.build_project_union(s, root);
    if (sel pr.ok) {
        var p: project.Project = pr.ok;
        project.dnit_project(?p);
        ret false;
    }
    ret ut_str_contains(outcome.describe(pr.err), needle);
}

rec DepsScratchProbe {
    backing:    A.Allocator;
    live:       i64;
    live_count: i64;
    calls:      u32;
    fail_at:    u32;
}

fun deps_scratch_probe_allocate(ctx: ptr, size: usize, align: usize) opt[ptr] {
    val p: *DepsScratchProbe = ctx::*DepsScratchProbe;
    p.calls = p.calls + 1;
    if (p.fail_at != 0 && p.calls == p.fail_at) { ret opt[ptr].none{}; }
    val r: opt[ptr] = p.backing.fn_allocate(p.backing.ctx, size, align);
    if (sel r.some) {
        p.live       = p.live + size::i64;
        p.live_count = p.live_count + 1;
        memory.raw_fill(r.some, 0xAA, size);
    }
    ret r;
}

fun deps_scratch_probe_reallocate(ctx: ptr, item: ptr, old_size: usize, new_size: usize, align: usize) opt[ptr] {
    val p: *DepsScratchProbe = ctx::*DepsScratchProbe;
    p.calls = p.calls + 1;
    if (p.fail_at != 0 && p.calls == p.fail_at) { ret opt[ptr].none{}; }
    val r: opt[ptr] = p.backing.fn_reallocate(p.backing.ctx, item, old_size, new_size, align);
    if (sel r.some) {
        p.live = p.live - old_size::i64 + new_size::i64;
        if (new_size > old_size) {
            val grown: ptr = r.some;
            memory.raw_fill((grown::usize + old_size)::ptr, 0xAA, new_size - old_size);
        }
    }
    ret r;
}

fun deps_scratch_probe_deallocate(ctx: ptr, item: ptr, size: usize, align: usize) i64 {
    val p: *DepsScratchProbe = ctx::*DepsScratchProbe;
    p.live       = p.live - size::i64;
    p.live_count = p.live_count - 1;
    ret p.backing.fn_deallocate(p.backing.ctx, item, size, align);
}

fun deps_scratch_probe_make(p: *DepsScratchProbe, alloc: *A.Allocator, fail_at: u32) bool {
    val make_r: err[A.Error] = page.make(?p.backing);
    if (sel make_r.err) { ret false; }
    p.live       = 0;
    p.live_count = 0;
    p.calls      = 0;
    p.fail_at    = fail_at;
    val probe: *DepsScratchProbe = p;
    alloc.ctx           = probe::ptr;
    alloc.fn_allocate   = deps_scratch_probe_allocate;
    alloc.fn_reallocate = deps_scratch_probe_reallocate;
    alloc.fn_deallocate = deps_scratch_probe_deallocate;
    ret true;
}

test "mach.lang.driver:dep_out_home" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var code: i32 = 0;

    val rel: res[str, outcome.Fail] = dcfg.dep_out_home(?alloc, ".", "out/linux/debug");
    if (!(sel rel.ok && path.is_abs(rel.ok))) { code = 1; }
    val cwd_r: res[string.OwnedString, env.EnvError] = env.current_dir(?alloc);
    if (sel cwd_r.err) { ret 1; }
    var cwd: string.OwnedString     = cwd_r.ok;
    val abs: res[str, outcome.Fail] = dcfg.dep_out_home(?alloc, cwd.data, "out/linux/debug");
    if (!(sel abs.ok && path.is_abs(abs.ok)))                        { code = 1; }
    if (sel rel.ok && (sel abs.ok && (!str_equals(rel.ok, abs.ok)))) { code = 1; }

    val abs_sub_r: res[str, A.Error] = path.resolve(?alloc, cwd.data, "subdir");
    if (sel abs_sub_r.err) { ret 1; }
    val rel_sub: res[str, outcome.Fail] = dcfg.dep_out_home(?alloc, "./subdir", "out/linux/debug");
    val abs_sub: res[str, outcome.Fail] = dcfg.dep_out_home(?alloc, abs_sub_r.ok, "out/linux/debug");
    val folded:  res[str, outcome.Fail] = dcfg.dep_out_home(?alloc, "./subdir/../subdir", "out/linux/debug");
    if (sel rel_sub.err)                     { ret 1; }
    if (sel abs_sub.err)                     { ret 1; }
    if (sel folded.err)                      { ret 1; }
    if (!str_equals(rel_sub.ok, abs_sub.ok)) { code = 1; }
    if (!str_equals(folded.ok, abs_sub.ok))  { code = 1; }
    ret code;
}

# two keys realizing one project id are not a content conflict to reconcile:
# the first is a key that is not the project id and is refused
test "mach.lang.driver:dep_closure_refuses_an_alias_key_before_any_conflict" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:  session.Session   = sr.ok;
    val rr: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "fun main() i32 { ret 0; }\n";
    val root_manifest: str = ut_cc3(?alloc, ut_dep_root_one(?alloc, "foo", "./vendor/foo"),
        "\n[dep.bar]\npath = \"./vendor/bar\"\n", "");
    val root_r: res[str, fail.Fail] = ut_scaffold_m(?alloc, root_manifest, ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    var bad: i32            = 0;
    val lib: str            = ut_lib_manifest(?alloc, "libx");
    val wf:  err[fail.Fail] = ut_write_node(?alloc, ut_cc3(?alloc, root, "/", "dep/foo"),
        lib, "lib.mach", "pub fun v() i32 { ret 1; }\n");
    val wb: err[fail.Fail] = ut_write_node(?alloc, ut_cc3(?alloc, root, "/", "dep/bar"),
        lib, "lib.mach", "pub fun v() i32 { ret 2; }\n");
    if (sel wf.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    if (sel wb.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    if (!ut_git_repo(?alloc, root, "https://example.invalid/app.git")) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }

    val pr: res[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
    if (sel pr.ok) {
        var p: project.Project = pr.ok;
        project.dnit_project(?p);
        bad = 1;
    }
    if (sel pr.err) {
        val msg: str = outcome.describe(pr.err);
        if (!ut_str_contains(msg, "[dep.foo] realizes project 'libx': the manifest key, the directory under dep/, and the project id are one name")) { bad = 1; }
        if (!ut_str_contains(msg, "rename the table to [dep.libx] and the directory to dep/libx"))                                                   { bad = 1; }
    }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.driver:dep_git_checkout_uses_parent_gitlink_authority" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }

    val origin: str = "https://example.invalid/verified.git";
    var names:  [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "fun main() i32 { ret 0; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold_m(?alloc,
        ut_dep_root_git(?alloc, "verified", origin), ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root:     str            = root_r.ok;
    val dep_root: str            = ut_cc3(?alloc, root, "/", "dep/verified");
    val wr:       err[fail.Fail] = ut_write_node(?alloc, dep_root,
        ut_lib_manifest(?alloc, "verified"), "lib.mach", "pub fun v() i32 { ret 1; }\n");
    if (sel wr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    if (!ut_git_repo(?alloc, dep_root, origin)) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    val contained_link: str                 = ut_cc3(?alloc, dep_root, "/src/", "contained.mach");
    val symlink_r:      err[io_error.Error] = fs.symlink("lib.mach", contained_link);
    if (sel symlink_r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    if (!ut_git_commit_all(?alloc, dep_root, "add contained symlink")) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }

    var tag: [4]str;
    tag[0] = "-C";
    tag[1] = dep_root;
    tag[2] = "tag";
    tag[3] = "v1";
    if (!ut_git(?alloc, ?tag[0], 4) || !ut_write_gitmodules(?alloc, root, "verified", origin)
        || !ut_git_repo(?alloc, root, "https://example.invalid/app.git")) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    val initial_r: res[str, fail.Fail] = ut_git_ref(?alloc, dep_root, "refs/tags/v1");
    if (sel initial_r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    val initial: str = initial_r.ok;

    var bad:             i32                         = 0;
    val lib_path:        str                         = ut_cc3(?alloc, dep_root, "/", "src/lib.mach");
    val child_index:     str                         = ut_cc3(?alloc, dep_root, "/", ".git/index");
    val parent_index:    str                         = ut_cc3(?alloc, root, "/", ".git/index");
    val child_before_r:  res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, child_index);
    val parent_before_r: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, parent_index);
    if (!ut_dep_build_ok(?s, root)) { bad = 1; }
    val parent_after_r: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, parent_index);
    if (sel parent_after_r.err) { ret 99; }
    val child_after_r: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, child_index);
    if (sel child_before_r.err) { ret 99; }
    if (sel child_after_r.err) {
        var released: Vector[u8] = child_before_r.ok;
        vector.dnit[u8](?released);
        ret 99;
    }
    if (sel parent_before_r.err) {
        var released_before: Vector[u8] = child_before_r.ok;
        vector.dnit[u8](?released_before);
        var released_after: Vector[u8] = child_after_r.ok;
        vector.dnit[u8](?released_after);
        ret 99;
    }
    {
        var child_before:  Vector[u8] = child_before_r.ok;
        var child_after:   Vector[u8] = child_after_r.ok;
        var parent_before: Vector[u8] = parent_before_r.ok;
        var parent_after:  Vector[u8] = parent_after_r.ok;
        if (child_before.len != child_after.len
            || !memory.raw_equal(child_before.data::ptr, child_after.data::ptr, child_before.len)
            || parent_before.len != parent_after.len
            || !memory.raw_equal(parent_before.data::ptr, parent_after.data::ptr, parent_before.len)) { bad = 1; }
        vector.dnit[u8](?child_before);
        vector.dnit[u8](?child_after);
        vector.dnit[u8](?parent_before);
        vector.dnit[u8](?parent_after);
    }

    val moved_source: str = "pub fun v() i32 { ret 2; }\n";
    var add:          [4]str;
    add[0] = "-C";
    add[1] = dep_root;
    add[2] = "add";
    add[3] = "-A";
    var commit: [5]str;
    commit[0] = "-C";
    commit[1] = dep_root;
    commit[2] = "commit";
    commit[3] = "-qm";
    commit[4] = "moved";
    var moved_tag: [4]str;
    moved_tag[0] = "-C";
    moved_tag[1] = dep_root;
    moved_tag[2] = "tag";
    moved_tag[3] = "moved";
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(lib_path, moved_source, str_len(moved_source), 420);
    if (sel write_bytes_r.err
        || !ut_git(?alloc, ?add[0], 4) || !ut_git(?alloc, ?commit[0], 5)
        || !ut_git(?alloc, ?moved_tag[0], 4)) { bad = 1; }
    val moved_r: res[str, fail.Fail] = ut_git_ref(?alloc, dep_root, "refs/tags/moved");
    if (sel moved_r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    val moved: str = moved_r.ok;
    var track: [6]str;
    track[0] = "-C";
    track[1] = dep_root;
    track[2] = "update-ref";
    track[3] = "refs/remotes/origin/main";
    track[4] = moved;
    track[5] = "";
    var reset: [5]str;
    reset[0] = "-C";
    reset[1] = dep_root;
    reset[2] = "reset";
    reset[3] = "--hard";
    reset[4] = initial;
    if (!ut_git(?alloc, ?track[0], 5) || !ut_git(?alloc, ?reset[0], 5)
        || !ut_dep_build_ok(?s, root)) { bad = 1; }

    val root_manifest_path: str             = ut_cc3(?alloc, root, "/", manifest.MANIFEST_FILE);
    val tag_manifest:       str             = ut_dep_root_git_ref(?alloc, "verified", origin, "tag/v1");
    val write_bytes_r2:     err[fs.FsError] = fs.write_bytes(root_manifest_path, tag_manifest, str_len(tag_manifest), 420);
    if (sel write_bytes_r2.err
        || !ut_git_commit_all(?alloc, root, "select tag") || !ut_dep_build_ok(?s, root)) { bad = 1; }
    var force_tag: [6]str;
    force_tag[0] = "-C";
    force_tag[1] = dep_root;
    force_tag[2] = "tag";
    force_tag[3] = "-f";
    force_tag[4] = "v1";
    force_tag[5] = moved;
    # the gitlink now lies outside the root's own `tag/`, which is refused naming the re-pin (#3455)
    if (!ut_git(?alloc, ?force_tag[0], 6)
        || !ut_dep_build_fails(?s, root, "run `mach dep update <path> verified` for project")) { bad = 1; }
    force_tag[5] = initial;
    if (!ut_git(?alloc, ?force_tag[0], 6)) { bad = 1; }

    val initial_commit_ref:      str             = ut_cc3(?alloc, "commit/", initial, "");
    val initial_commit_manifest: str             = ut_dep_root_git_ref(?alloc, "verified", origin, initial_commit_ref);
    val write_bytes_r3:          err[fs.FsError] = fs.write_bytes(root_manifest_path, initial_commit_manifest, str_len(initial_commit_manifest), 420);
    if (sel write_bytes_r3.err
        || !ut_git_commit_all(?alloc, root, "select commit") || !ut_dep_build_ok(?s, root)) { bad = 1; }
    val moved_commit_ref:      str             = ut_cc3(?alloc, "commit/", moved, "");
    val moved_commit_manifest: str             = ut_dep_root_git_ref(?alloc, "verified", origin, moved_commit_ref);
    val write_bytes_r4:        err[fs.FsError] = fs.write_bytes(root_manifest_path, moved_commit_manifest, str_len(moved_commit_manifest), 420);
    if (sel write_bytes_r4.err
        || !ut_git_commit_all(?alloc, root, "mismatch commit")
        || !ut_dep_build_fails(?s, root, "commit ref")) { bad = 1; }
    val write_bytes_r5: err[fs.FsError] = fs.write_bytes(root_manifest_path, initial_commit_manifest, str_len(initial_commit_manifest), 420);
    if (sel write_bytes_r5.err
        || !ut_git_commit_all(?alloc, root, "restore commit")) { bad = 1; }

    if (!ut_write_gitmodules(?alloc, root, "verified", "https://example.invalid/substituted.git")
        || !ut_git_commit_all(?alloc, root, "substitute metadata")
        || !ut_dep_build_fails(?s, root, ".gitmodules URL")) { bad = 1; }
    if (!ut_write_gitmodules(?alloc, root, "verified", origin)
        || !ut_git_commit_all(?alloc, root, "restore metadata")) { bad = 1; }

    val wrong_path_metadata: str             = ut_cc3(?alloc, "[submodule \"dep/verified\"]\n\tpath = dep/not-verified\n\turl = ", origin, "\n");
    val gitmodules_path:     str             = ut_cc3(?alloc, root, "/", ".gitmodules");
    val write_bytes_r6:      err[fs.FsError] = fs.write_bytes(gitmodules_path, wrong_path_metadata, str_len(wrong_path_metadata), 420);
    if (sel write_bytes_r6.err
        || !ut_git_commit_all(?alloc, root, "move dependency mapping")
        || !ut_dep_build_fails(?s, root, ".gitmodules path")) { bad = 1; }
    if (!ut_write_gitmodules(?alloc, root, "verified", origin)
        || !ut_git_commit_all(?alloc, root, "restore dependency mapping")) { bad = 1; }

    var mirror_origin: [6]str;
    mirror_origin[0] = "-C";
    mirror_origin[1] = dep_root;
    mirror_origin[2] = "remote";
    mirror_origin[3] = "set-url";
    mirror_origin[4] = "origin";
    mirror_origin[5] = "https://example.invalid/verified";
    if (!ut_git(?alloc, ?mirror_origin[0], 6) || !ut_dep_build_ok(?s, root)) { bad = 1; }
    mirror_origin[5] = "https://mirror.example.invalid/elsewhere/verified.git";
    if (!ut_git(?alloc, ?mirror_origin[0], 6) || !ut_dep_build_ok(?s, root)) { bad = 1; }
    mirror_origin[5] = origin;
    if (!ut_git(?alloc, ?mirror_origin[0], 6)) { bad = 1; }

    val dirty_path:  str             = ut_cc3(?alloc, dep_root, "/", "untracked.txt");
    val dirty_write: err[fs.FsError] = fs.write_bytes(dirty_path, "dirty\n", 6, 420);
    if (sel dirty_write.err || !ut_dep_build_fails(?s, root, "checkout is dirty")) { bad = 1; }
    val remove_file_r: err[io_error.Error] = fs.remove_file(dirty_path);
    if (sel remove_file_r.err) { bad = 1; }

    reset[4] = moved;
    if (!ut_git(?alloc, ?reset[0], 5) || !ut_dep_build_fails(?s, root, "run `mach dep pull <path>` for project")) { bad = 1; }
    reset[4] = initial;
    if (!ut_git(?alloc, ?reset[0], 5)) { bad = 1; }

    val branch_manifest: str             = ut_dep_root_git(?alloc, "verified", origin);
    val write_bytes_r7:  err[fs.FsError] = fs.write_bytes(root_manifest_path, branch_manifest, str_len(branch_manifest), 420);
    if (sel write_bytes_r7.err
        || !ut_git_commit_all(?alloc, root, "restore branch policy")) { bad = 1; }

    var link_index: [8]str;
    link_index[0] = "-C";
    link_index[1] = root;
    link_index[2] = "update-index";
    link_index[3] = "--add";
    link_index[4] = "--cacheinfo";
    link_index[5] = "160000";
    link_index[6] = moved;
    link_index[7] = "dep/verified";
    if (!ut_git(?alloc, ?link_index[0], 8) || !ut_dep_build_fails(?s, root, "but the recorded gitlink is")) { bad = 1; }
    link_index[6] = initial;
    if (!ut_git(?alloc, ?link_index[0], 8)) { bad = 1; }

    link_index[6] = moved;
    var parent_commit: [5]str;
    parent_commit[0] = "-C";
    parent_commit[1] = root;
    parent_commit[2] = "commit";
    parent_commit[3] = "-qm";
    parent_commit[4] = "move gitlink";
    if (!ut_git(?alloc, ?link_index[0], 8) || !ut_git(?alloc, ?parent_commit[0], 5)
        || !ut_dep_build_fails(?s, root, "but the recorded gitlink is")) { bad = 1; }
    link_index[6]    = initial;
    parent_commit[4] = "restore gitlink";
    if (!ut_git(?alloc, ?link_index[0], 8) || !ut_git(?alloc, ?parent_commit[0], 5)) { bad = 1; }

    val child_git:    str             = ut_cc3(?alloc, dep_root, "/", ".git");
    val dep_parent:   str             = ut_cc3(?alloc, root, "/", "dep");
    val remove_all_r: err[fs.FsError] = fs.remove_all(?alloc, child_git);
    if (sel remove_all_r.err
        || !ut_git_repo(?alloc, dep_parent, origin)
        || !ut_dep_build_fails(?s, root, "repository root")) { bad = 1; }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

fun ut_path_copy_revision(s: *session.Session, root: str, expected: str) res[query.Revision, fail.Fail] {
    val built: res[project.Project, outcome.Fail] = driver.build_project_union(s, root);
    if (sel built.err) {
        ret res[query.Revision, fail.Fail].err{fail.message(outcome.describe(built.err))};
    }
    var p: project.Project = built.ok;
    fin { project.dnit_project(?p); }
    var i: u32 = 0;
    for (i < project.module_count(?p)) {
        val file: opt[*src.SourceFile] = src.get(?s.sources, project.module_at(?p, i).file_id);
        if (sel file.some && str_equals(file.some.text, expected)) {
            val qr: res[UtQuerySnapshot, fail.Fail] = ut_query_snapshot(p.alloc, ?p, query.Q_FILE_TEXT, project.module_at(?p, i).file_id::u64);
            if (sel qr.err) { ret res[query.Revision, fail.Fail].err{qr.err}; }
            val q: UtQuerySnapshot = qr.ok;
            fin {
                if (q.value != nil) { A.deallocate[u8](p.alloc, q.value, q.value_len::usize); }
            }
            if (q.value_len::usize != str_len(expected)
                || !memory.raw_equal(q.value::ptr, expected::ptr, str_len(expected))) {
                ret res[query.Revision, fail.Fail].err{fail.message("dependency query does not contain the realized source bytes")};
            }
            ret res[query.Revision, fail.Fail].ok{q.last_changed};
        }
        i = i + 1;
    }
    ret res[query.Revision, fail.Fail].err{fail.message("dependency source bytes were not loaded")};
}

test "mach.lang.driver:path_dependency_verifies_filesystem_content_without_changing_git" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }

    var root_names: [1]str;
    root_names[0] = "main.mach";
    var root_texts: [1]str;
    root_texts[0] = "use uniontest.alpha.alpha;\nfun main() i32 { ret alpha(); }\n";
    val root_manifest: str                 = ut_dep_root_one(?alloc, "uniontest", "../source-not-read");
    val root_r:        res[str, fail.Fail] = ut_scaffold_m(?alloc, root_manifest, ?root_names[0], ?root_texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root:      str = root_r.ok;
    val dep_root:  str = ut_cc3(?alloc, root, "/", "dep/uniontest");
    var dep_names: [2]str;
    dep_names[0] = "alpha.mach";
    dep_names[1] = "beta.mach";
    var dep_texts: [2]str;
    dep_texts[0] = "pub fun alpha() i32 { ret 1; }\n";
    dep_texts[1] = "pub fun beta() i32 { ret 2; }\n";
    val ut_write_node_multi_r: err[fail.Fail] = ut_write_node_multi(?alloc, dep_root, ut_manifest_multi(), ?dep_names[0], ?dep_texts[0], 2);
    if (sel ut_write_node_multi_r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }

    var bad:     i32                                = 0;
    val first_r: res[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
    if (sel first_r.err) { bad = 1; }
    if (sel first_r.ok) {
        var p: project.Project = first_r.ok;
        if (p.config.dep_count != 1 || p.config.deps[0].project_module != intern.STR_NIL) { bad = 1; }
        val content_opt: opt[str] = intern.lookup(?s.interner, p.config.deps[0].content);
        val root_opt:    opt[str] = intern.lookup(?s.interner, p.config.deps[0].vendor_root);
        if (!(sel content_opt.some && (sel root_opt.some && !(str_equals(content_opt.some, root_opt.some))))) { bad = 1; }
        project.dnit_project(?p);
    }

    val project_git: str                            = ut_cc3(?alloc, root, "/", ".git");
    val initial_r:   res[query.Revision, fail.Fail] = ut_path_copy_revision(?s, root, dep_texts[0]);
    val exists_r:    res[bool, io_error.Error]      = fs.exists(project_git);
    if (sel exists_r.err) { ret 99; }
    if ((sel exists_r.ok && exists_r.ok)) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 2;
    }
    if (sel initial_r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 2;
    }
    val initial: query.Revision = initial_r.ok;
    if (!ut_git_repo(?alloc, root, "https://example.invalid/app.git")) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 3;
    }
    val index_path:    str               = ut_cc3(?alloc, project_git, "/", "index");
    var index_before:  [32]u8;
    var index_after:   [32]u8;
    val file_sha256_r: err[outcome.Fail] = bfingerprint.file_sha256(index_path, ?index_before[0]);
    if (sel file_sha256_r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 4;
    }
    val head_r: res[str, fail.Fail] = ut_git_ref(?alloc, root, "HEAD");
    if (sel head_r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 5;
    }
    val head: str = head_r.ok;
    fin { str_free(?alloc, head); }
    if (str_len(head) <= 5 || !memory.raw_equal(head::ptr, "ref: "::ptr, 5)) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 6;
    }
    val commit_r: res[str, fail.Fail] = ut_git_ref(?alloc, root, (?head[5])::str);
    if (sel commit_r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 6;
    }
    val commit: str = commit_r.ok;
    fin { str_free(?alloc, commit); }

    val changed:          str             = ut_cc3(?alloc, dep_root, "/src/", "alpha.mach");
    val worktree_changed: str             = "pub fun alpha() i32 { ret 3; }\n";
    val write_bytes_r:    err[fs.FsError] = fs.write_bytes(changed, worktree_changed, str_len(worktree_changed), 420);
    if (sel write_bytes_r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 7;
    }
    val edited_r: res[query.Revision, fail.Fail] = ut_path_copy_revision(?s, root, worktree_changed);
    if (sel edited_r.err)                             { ret 99; }
    if (!(sel edited_r.ok && edited_r.ok != initial)) { bad = 8; }
    val repeated_r: res[query.Revision, fail.Fail] = ut_path_copy_revision(?s, root, worktree_changed);
    if (sel repeated_r.err) { ret 99; }
    if (!(sel repeated_r.ok && !((sel edited_r.ok
        && repeated_r.ok != edited_r.ok)))) { bad = 15; }
    val file_sha256_r2: err[outcome.Fail] = bfingerprint.file_sha256(index_path, ?index_after[0]);
    if (sel file_sha256_r2.err
        || !ut_digest_eq(?index_before[0], ?index_after[0])) { bad = 9; }
    var restore: [5]str;
    restore[0] = "-C";
    restore[1] = root;
    restore[2] = "restore";
    restore[3] = "--";
    restore[4] = "dep/uniontest";
    if (!ut_git(?alloc, ?restore[0], 5)) { bad = 1; }

    var stage: [5]str;
    stage[0] = "-C";
    stage[1] = root;
    stage[2] = "add";
    stage[3] = "--";
    stage[4] = "dep/uniontest";
    val staged_changed: str             = "pub fun alpha() i32 { ret 4; }\n";
    val write_bytes_r2: err[fs.FsError] = fs.write_bytes(changed, staged_changed, str_len(staged_changed), 420);
    if (sel write_bytes_r2.err)        { bad = 10; }
    or (!ut_git(?alloc, ?stage[0], 5)) { bad = 10; }
    or {
        val file_sha256_r3: err[outcome.Fail] = bfingerprint.file_sha256(index_path, ?index_before[0]);
        if (sel file_sha256_r3.err) { bad = 10; }
    }
    val staged_r: res[query.Revision, fail.Fail] = ut_path_copy_revision(?s, root, staged_changed);
    if (sel staged_r.err) { ret 99; }
    if (!(sel staged_r.ok && !((sel edited_r.ok
        && staged_r.ok == edited_r.ok)))) { bad = 11; }
    val file_sha256_r4: err[outcome.Fail] = bfingerprint.file_sha256(index_path, ?index_after[0]);
    if (sel file_sha256_r4.err
        || !ut_digest_eq(?index_before[0], ?index_after[0])) { bad = 12; }
    var restore_staged: [6]str;
    restore_staged[0] = "-C";
    restore_staged[1] = root;
    restore_staged[2] = "restore";
    restore_staged[3] = "--staged";
    restore_staged[4] = "--";
    restore_staged[5] = "dep/uniontest";
    if (!ut_git(?alloc, ?restore_staged[0], 6) || !ut_git(?alloc, ?restore[0], 5)) { bad = 1; }

    val untracked:      str               = ut_cc3(?alloc, dep_root, "/", "untracked.txt");
    val file_sha256_r6: err[outcome.Fail] = bfingerprint.file_sha256(index_path, ?index_before[0]);
    val write_bytes_r3: err[fs.FsError]   = fs.write_bytes(untracked, "untracked\n", 10, 420);
    if (sel file_sha256_r6.err || sel write_bytes_r3.err) { bad = 13; }
    or (!ut_dep_build_ok(?s, root))                       { bad = 13; }
    or {
        val file_sha256_r5: err[outcome.Fail] = bfingerprint.file_sha256(index_path, ?index_after[0]);
        if (sel file_sha256_r5.err || !ut_digest_eq(?index_before[0], ?index_after[0])) { bad = 13; }
        or {
            val remove_file_r: err[io_error.Error] = fs.remove_file(untracked);
            if (sel remove_file_r.err) { bad = 13; }
        }
    }
    val commit_after_r: res[str, fail.Fail] = ut_git_ref(?alloc, root, (?head[5])::str);
    if (sel commit_after_r.err) { ret 99; }
    val head_after_r: res[str, fail.Fail] = ut_git_ref(?alloc, root, "HEAD");
    if (!(sel head_after_r.ok && (sel commit_after_r.ok && str_equals(head_after_r.ok, head) && str_equals(commit_after_r.ok, commit)))) { bad = 14; }
    if (sel head_after_r.ok)                                                                                                             { str_free(?alloc, head_after_r.ok); }
    if (sel commit_after_r.ok)                                                                                                           { str_free(?alloc, commit_after_r.ok); }

    val root_manifest_path: str             = ut_cc3(?alloc, root, "/", manifest.MANIFEST_FILE);
    val dirty_manifest:     str             = ut_cc3(?alloc, root_manifest, "\n", "");
    val write_bytes_r4:     err[fs.FsError] = fs.write_bytes(root_manifest_path, dirty_manifest, str_len(dirty_manifest), 420);
    if (sel write_bytes_r4.err
        || !ut_dep_build_ok(?s, root)) { bad = 1; }
    var restore_manifest: [5]str;
    restore_manifest[0] = "-C";
    restore_manifest[1] = root;
    restore_manifest[2] = "restore";
    restore_manifest[3] = "--";
    restore_manifest[4] = manifest.MANIFEST_FILE;
    if (!ut_git(?alloc, ?restore_manifest[0], 5) || !ut_dep_build_ok(?s, root)) { bad = 1; }

    val ignore_path:    str             = ut_cc3(?alloc, dep_root, "/", ".gitignore");
    val ignored_dir:    str             = ut_cc3(?alloc, dep_root, "/", "out");
    val ignored_file:   str             = ut_cc3(?alloc, ignored_dir, "/", "generated.mach");
    val write_bytes_r6: err[fs.FsError] = fs.write_bytes(ignore_path, "out/\n", 5, 420);
    if (sel write_bytes_r6.err)                                        { bad = 1; }
    or (!ut_git_commit_all(?alloc, root, "ignore dependency outputs")) { bad = 1; }
    or {
        val create_dir_all_r: err[fs.FsError] = fs.create_dir_all(?alloc, ignored_dir, 493);
        val write_bytes_r5:   err[fs.FsError] = fs.write_bytes(ignored_file, "generated\n", 10, 420);
        if (sel create_dir_all_r.err || sel write_bytes_r5.err || !ut_dep_build_ok(?s, root)) { bad = 1; }
    }

    val injected_git:   str             = ut_cc3(?alloc, dep_root, "/", ".git");
    val write_bytes_r7: err[fs.FsError] = fs.write_bytes(injected_git, "ignored\n", 8, 420);
    if (sel write_bytes_r7.err)                                         { bad = 1; }
    or (!ut_dep_build_fails(?s, root, "forbidden repository metadata")) { bad = 1; }
    or {
        val remove_file_r2: err[io_error.Error] = fs.remove_file(injected_git);
        if (sel remove_file_r2.err || !ut_dep_build_ok(?s, root)) { bad = 1; }
    }

    val contained_link: str                 = ut_cc3(?alloc, dep_root, "/src/", "contained.mach");
    val symlink_r:      err[io_error.Error] = fs.symlink("alpha.mach", contained_link);
    if (sel symlink_r.err
        || !ut_git_commit_all(?alloc, root, "add a contained dependency symlink")
        || !ut_dep_build_fails(?s, root, "must contain no symlinks")) { bad = 1; }

    val remove_file_r3: err[io_error.Error] = fs.remove_file(contained_link);
    val symlink_r2:     err[io_error.Error] = fs.symlink("/etc/passwd", contained_link);
    if (sel remove_file_r3.err
        || sel symlink_r2.err
        || !ut_git_commit_all(?alloc, root, "add an absolute dependency symlink")
        || !ut_dep_build_fails(?s, root, "must contain no symlinks")) { bad = 1; }

    val remove_file_r4: err[io_error.Error] = fs.remove_file(contained_link);
    val symlink_r3:     err[io_error.Error] = fs.symlink("../../outside", contained_link);
    if (sel remove_file_r4.err
        || sel symlink_r3.err
        || !ut_git_commit_all(?alloc, root, "add an escaping dependency symlink")
        || !ut_dep_build_fails(?s, root, "must contain no symlinks")) { bad = 1; }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.driver:path_package_resolves_nested_git_dependency" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }

    val source: str = "https://example.invalid/b.git";
    var names:  [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "fun main() i32 { ret 0; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold_m(?alloc,
        ut_dep_root_one(?alloc, "a", "../external-not-read"), ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root:       str = root_r.ok;
    val a_root:     str = ut_cc3(?alloc, root, "/", "dep/a");
    val b_root:     str = ut_cc3(?alloc, root, "/", "dep/b");
    val a_manifest: str = ut_cc3(?alloc, ut_lib_manifest(?alloc, "a"),
        "\n[dep.b]\ngit = \"https://example.invalid/b.git\"\nref = \"branch/main\"\n", "");
    val ut_write_node_r: err[fail.Fail] = ut_write_node(?alloc, a_root, a_manifest,
        "lib.mach", "pub fun a() i32 { ret 1; }\n");
    val ut_write_node_r2: err[fail.Fail] = ut_write_node(?alloc, b_root, ut_lib_manifest(?alloc, "b"),
        "lib.mach", "pub fun b() i32 { ret 2; }\n");
    if (sel ut_write_node_r2.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    if (!ut_git_repo(?alloc, b_root, source)) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    if (sel ut_write_node_r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    if (!ut_write_gitmodules(?alloc, a_root, "b", source)) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    if (!ut_write_gitmodules(?alloc, root, "b", source)) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    if (!ut_git_repo(?alloc, root, "https://example.invalid/app.git")) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var bad: i32                                = 0;
    val pr:  res[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
    if (sel pr.err) { bad = 1; }
    if (sel pr.ok) {
        var p: project.Project = pr.ok;
        if (p.config.dep_count != 2) { bad = 1; }
        project.dnit_project(?p);
    }
    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.driver:dep_transitive_gitlink_resolves_flat_and_the_nested_placeholder_is_ignored" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val a_source: str = "https://example.invalid/a.git";
    val b_source: str = "https://example.invalid/b.git";
    var names:    [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "fun main() i32 { ret 0; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold_m(?alloc,
        ut_dep_root_git(?alloc, "a", a_source), ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root:               str = root_r.ok;
    val a_root:             str = ut_cc3(?alloc, root, "/", "dep/a");
    val b_root:             str = ut_cc3(?alloc, root, "/", "dep/b");
    val nested_placeholder: str = ut_cc3(?alloc, a_root, "/", "dep/b");
    val a_manifest:         str = ut_cc3(?alloc, ut_lib_manifest(?alloc, "a"),
        "\n[dep.b]\ngit = \"https://example.invalid/b.git\"\nref = \"branch/main\"\n", "");
    val create_dir_all_r: err[fs.FsError] = fs.create_dir_all(?alloc, nested_placeholder, 493);
    val ut_write_node_r:  err[fail.Fail]  = ut_write_node(?alloc, a_root, a_manifest,
        "lib.mach", "pub fun a() i32 { ret 1; }\n");
    val ut_write_node_r2: err[fail.Fail] = ut_write_node(?alloc, b_root, ut_lib_manifest(?alloc, "b"),
        "lib.mach", "pub fun b() i32 { ret 2; }\n");
    if (sel ut_write_node_r2.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    if (!ut_git_repo(?alloc, b_root, b_source)) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    if (sel ut_write_node_r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    if (!ut_write_gitmodules(?alloc, a_root, "b", b_source)) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    if (sel create_dir_all_r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    if (!ut_git_repo(?alloc, a_root, a_source)) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    if (!ut_write_gitmodules2(?alloc, root, "a", a_source, "b", b_source)) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    if (!ut_git_repo(?alloc, root, "https://example.invalid/app.git")) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var bad: i32                                = 0;
    val pr:  res[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
    if (sel pr.err) { bad = 1; }
    if (sel pr.ok) {
        var p: project.Project = pr.ok;
        if (p.config.dep_count != 2) { bad = 1; }
        var saw_flat_b: bool = false;
        var i:          u32  = 0;
        for (i < p.config.dep_count) {
            val vr_opt: opt[str] = intern.lookup(?s.interner, p.config.deps[i].vendor_root);
            if (sel vr_opt.some) {
                if (ut_native_path_is(?alloc, vr_opt.some, root, "dep/a/dep/b")) { bad = 1; }
                if (ut_native_path_is(?alloc, vr_opt.some, root, "dep/b"))       { saw_flat_b = true; }
            }
            i = i + 1;
        }
        if (!saw_flat_b) { bad = 1; }
        project.dnit_project(?p);
    }
    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

fun ut_dep_root_override(nested: bool, root_git: bool, child_git: bool, root_first: bool) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) { ret 1; }

    val a_decl:           str = "\n[dep.a]\npath = \"./vendor/a\"\n";
    val initial_manifest: str = ut_dep_root_one(?alloc, "a", "./vendor/a");
    var names:            [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "use a.lib;\nfun main() i32 { ret lib.v(); }\n";
    val outer_r: res[str, fail.Fail] = ut_scaffold_m(?alloc, initial_manifest, ?names[0], ?texts[0], 1);
    if (sel outer_r.err) { ret 1; }
    val outer: str = outer_r.ok;
    fin { fs.remove_all(?alloc, outer); }
    var root: str = outer;
    if (nested) {
        root = ut_cc3(?alloc, outer, "/", "project");
        val ut_write_node_r: err[fail.Fail] = ut_write_node(?alloc, root, initial_manifest, "main.mach", texts[0]);
        if (sel ut_write_node_r.err) { ret 2; }
    }

    val a_root:     str = ut_cc3(?alloc, root, "/", "dep/a");
    val b_root:     str = ut_cc3(?alloc, root, "/", "dep/b");
    var child_decl: str = "\n[dep.b]\npath = \"../transitive-b\"\n";
    if (child_git) {
        child_decl = "\n[dep.b]\ngit = \"https://example.invalid/transitive-b.git\"\nref = \"commit/0000000000000000000000000000000000000000\"\n";
    }
    val a_manifest:       str            = ut_cc3(?alloc, ut_lib_manifest(?alloc, "a"), child_decl, "");
    val ut_write_node_r2: err[fail.Fail] = ut_write_node(?alloc, b_root, ut_lib_manifest(?alloc, "b"),
        "lib.mach", "pub fun v() i32 { ret 42; }\n");
    val ut_write_node_r3: err[fail.Fail] = ut_write_node(?alloc, a_root, a_manifest, "lib.mach",
        "use b.lib;\npub fun v() i32 { ret lib.v(); }\n");
    if (sel ut_write_node_r3.err) { ret 3; }
    if (sel ut_write_node_r2.err) { ret 3; }

    val root_source:     str = "https://example.invalid/root-b.git";
    var root_ref:        str = "";
    var b_decl:          str = "\n[dep.b]\npath = \"./vendor/b\"\n";
    var root_manifest:   str = ut_dep_root_one(?alloc, "b", "./vendor/b");
    var expected_source: str = "path ./vendor/b";
    if (root_git) {
        if (!ut_git_repo(?alloc, b_root, root_source)
            || !ut_write_gitmodules(?alloc, root, "b", root_source)) { ret 4; }
        val head_r: res[str, fail.Fail] = ut_git_ref(?alloc, b_root, "refs/remotes/origin/main");
        if (sel head_r.err) { ret 5; }
        root_ref        = ut_cc3(?alloc, "commit/", head_r.ok, "");
        b_decl          = ut_cc3(?alloc, "\n[dep.b]\ngit = \"https://example.invalid/root-b.git\"\nref = \"", root_ref, "\"\n");
        root_manifest   = ut_dep_root_git_ref(?alloc, "b", root_source, root_ref);
        expected_source = "git https://example.invalid/root-b.git";
    }
    if (root_first) { root_manifest = ut_cc3(?alloc, root_manifest, a_decl, ""); }
    or              { root_manifest = ut_cc3(?alloc, initial_manifest, b_decl, ""); }
    val root_manifest_path: str             = ut_cc3(?alloc, root, "/", manifest.MANIFEST_FILE);
    val write_bytes_r:      err[fs.FsError] = fs.write_bytes(root_manifest_path, root_manifest, str_len(root_manifest), 420);
    if (sel write_bytes_r.err)                                          { ret 6; }
    if (!ut_git_repo(?alloc, outer, "https://example.invalid/app.git")) { ret 6; }

    val pr: res[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
    if (sel pr.err) { ret 7; }
    var p:   project.Project = pr.ok;
    var bad: i32             = 0;
    if (p.config.dep_count != 2) { bad = 8; }
    val a_id:  intern.StrId = project.intern_unwrap(?s.interner, "a");
    val b_id:  intern.StrId = project.intern_unwrap(?s.interner, "b");
    var saw_a: bool         = false;
    var saw_b: bool         = false;
    var i:     u32          = 0;
    for (i < p.config.dep_count) {
        val entry: *project.DepEntry = ?p.config.deps[i];
        if (entry.project_id == a_id) {
            saw_a = true;
            if (entry.direct_count != 1 || entry.direct[0] != b_id) { bad = 9; }
        }
        if (entry.project_id == b_id) {
            saw_b = true;
            if (!entry.root_declared || entry.source != project.intern_unwrap(?s.interner, expected_source)) { bad = 10; }
            if (root_git && entry.ref != project.intern_unwrap(?s.interner, root_ref))                       { bad = 11; }
            var expected_chain: str = "app -> a -> b";
            if (root_first)                                                        { expected_chain = "app -> b"; }
            if (entry.chain != project.intern_unwrap(?s.interner, expected_chain)) { bad = 12; }
        }
        i = i + 1;
    }
    if (!saw_a || !saw_b) { bad = 13; }
    project.dnit_project(?p);

    if (root_git) {
        val b_source:       str             = ut_cc3(?alloc, b_root, "/src/", "lib.mach");
        val dirty:          str             = "pub fun v() i32 { ret 7; }\n";
        val write_bytes_r2: err[fs.FsError] = fs.write_bytes(b_source, dirty, str_len(dirty), 420);
        if (sel write_bytes_r2.err)                             { ret 14; }
        if (!ut_dep_build_fails(?s, root, "checkout is dirty")) { bad = 15; }
    }
    ret bad;
}

test "mach.lang.driver:dep_root_override_path_replaces_transitive_git" {
    if (ut_dep_root_override(false, false, true, false) != 0) { ret 1; }
    if (ut_dep_root_override(false, false, true, true) != 0)  { ret 2; }
    if (ut_dep_root_override(true, false, true, false) != 0)  { ret 3; }
    ret ut_dep_root_override(true, false, true, true);
}

test "mach.lang.driver:dep_root_override_git_replaces_transitive_url_and_commit" {
    if (ut_dep_root_override(false, true, true, false) != 0) { ret 1; }
    if (ut_dep_root_override(false, true, true, true) != 0)  { ret 2; }
    if (ut_dep_root_override(true, true, true, false) != 0)  { ret 3; }
    ret ut_dep_root_override(true, true, true, true);
}

test "mach.lang.driver:dep_root_override_git_replaces_transitive_path" {
    if (ut_dep_root_override(false, true, false, false) != 0) { ret 1; }
    if (ut_dep_root_override(false, true, false, true) != 0)  { ret 2; }
    if (ut_dep_root_override(true, true, false, false) != 0)  { ret 3; }
    ret ut_dep_root_override(true, true, false, true);
}

test "mach.lang.driver:dep_transitive_manifest_failures_are_not_leaves" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "fun main() i32 { ret 0; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold_m(?alloc,
        ut_dep_root_one(?alloc, "a", "../source-a"), ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root:       str = root_r.ok;
    val a_manifest: str = ut_cc3(?alloc, ut_lib_manifest(?alloc, "a"),
        "\n[dep.b]\npath = \"../source-b\"\n", "");
    val a_root:           str            = ut_cc3(?alloc, root, "/", "dep/a");
    val b_root:           str            = ut_cc3(?alloc, root, "/", "dep/b");
    val ut_write_node_r2: err[fail.Fail] = ut_write_node(?alloc, a_root, a_manifest, "lib.mach", "pub fun a() i32 { ret 1; }\n");
    val ut_write_node_r:  err[fail.Fail] = ut_write_node(?alloc, b_root, "not = [", "lib.mach", "pub fun b() i32 { ret 2; }\n");
    if (sel ut_write_node_r2.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    if (sel ut_write_node_r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    if (!ut_git_repo(?alloc, root, "https://example.invalid/app.git")) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }

    var bad: i32 = 0;
    if (!ut_dep_build_fails(?s, root, "dep 'b'")) { bad = 1; }
    val b_manifest:        str                 = ut_cc3(?alloc, b_root, "/", manifest.MANIFEST_FILE);
    val b_manifest_marker: str                 = ut_cc3(?alloc, b_manifest, "/", "keep");
    val remove_file_r:     err[io_error.Error] = fs.remove_file(b_manifest);
    val create_dir_all_r:  err[fs.FsError]     = fs.create_dir_all(?alloc, b_manifest, 493);
    val write_bytes_r:     err[fs.FsError]     = fs.write_bytes(b_manifest_marker, "keep\n", 5, 420);
    if (sel remove_file_r.err
        || sel create_dir_all_r.err
        || sel write_bytes_r.err
        || !ut_git_commit_all(?alloc, root, "replace transitive manifest with directory")
        || !ut_dep_build_fails(?s, root, "cannot read")) { bad = 1; }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.driver:undeclared_use_root_names_the_missing_dep" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "use std.print;\n#[symbol(\"_start\")]\nfun start() i32 { ret 0; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    var bad: i32                                = 0;
    val pr:  res[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
    # the tolerant load keeps the project standing rejected; the report is what is checked
    if (sel pr.ok) {
        var p:        project.Project  = pr.ok;
        val standing: fail.PhaseStatus = passes.frontend_status(?p);
        if (!sel standing.kind.rejected) { bad = 1; }
        project.dnit_project(?p);
    }
    {
        var seen: bool  = false;
        var i:    usize = 0;
        for (i < diagnostic.len(?s.diags)) {
            val d: *diagnostic.Diagnostic = ?s.diags.items.data[i];
            if (d.severity == diagnostic.SEVERITY_ERROR && ut_str_contains(d.message, "module root 'std'")) {
                seen = true;
                if (!ut_str_contains(d.message, "declared dependency"))     { bad = 1; }
                if (!ut_str_contains(d.message, "declare it in mach.toml")) { bad = 1; }
                if (ut_str_contains(d.message, "does not name a module"))   { bad = 1; }
            }
            i = i + 1;
        }
        if (!seen) { bad = 1; }
    }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.driver:dep_closure_registers_transitive" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:  session.Session   = sr.ok;
    val rr: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "fun main() i32 { ret 0; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold_m(?alloc, ut_dep_root_one(?alloc, "a", "./vendor/a"), ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    var bad:        i32            = 0;
    val a_manifest: str            = ut_cc3(?alloc, ut_lib_manifest(?alloc, "a"), "\n[dep.b]\npath = \"./vendor/b\"\n", "");
    val libsrc:     str            = "pub fun v() i32 { ret 1; }\n";
    val wa:         err[fail.Fail] = ut_write_node(?alloc, ut_cc3(?alloc, root, "/", "dep/a"), a_manifest, "lib.mach", libsrc);
    val wb:         err[fail.Fail] = ut_write_node(?alloc, ut_cc3(?alloc, root, "/", "dep/b"), ut_lib_manifest(?alloc, "b"), "lib.mach", libsrc);
    if (sel wa.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    if (sel wb.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    if (!ut_git_repo(?alloc, root, "https://example.invalid/app.git")) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }

    val pr: res[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
    if (sel pr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    if (p.config.dep_count != 2) { bad = 1; }
    or {
        val a_id:  intern.StrId = project.intern_unwrap(?s.interner, "a");
        val b_id:  intern.StrId = project.intern_unwrap(?s.interner, "b");
        var saw_a: bool         = false;
        var saw_b: bool         = false;
        var a_idx: u32          = 0;
        var b_idx: u32          = 0;
        var i:     u32          = 0;
        for (i < p.config.dep_count) {
            if (p.config.deps[i].project_id == a_id) {
                saw_a = true;
                a_idx = i;
            }
            if (p.config.deps[i].project_id == b_id) {
                saw_b = true;
                b_idx = i;
            }
            i = i + 1;
        }
        if (!saw_a || !saw_b) { bad = 1; }
        or {
            if (p.config.deps[a_idx].direct_count != 1
                || p.config.deps[a_idx].direct[0] != b_id) { bad = 1; }
            val b_root_opt: opt[str] = intern.lookup(?s.interner, p.config.deps[b_idx].vendor_root);
            if (!(sel b_root_opt.some && ut_native_path_is(?alloc, b_root_opt.some, root, "dep/b"))) { bad = 1; }
        }
    }

    val a_manifest_path: str             = ut_cc3(?alloc, root, "/", "dep/a/mach.toml");
    val write_bytes_r:   err[fs.FsError] = fs.write_bytes(a_manifest_path, "not = [", 7, 420);
    if (sel write_bytes_r.err) { bad = 1; }
    if (sel write_bytes_r.ok) {
        val isa_opt: opt[str] = intern.lookup(?s.interner, p.target_entry.isa_name);
        val os_opt:  opt[str] = intern.lookup(?s.interner, p.target_entry.os_name);
        val abi_opt: opt[str] = intern.lookup(?s.interner, p.target_entry.abi_name);
        if (sel isa_opt.none) { ret 99; }
        if (sel os_opt.none)  { ret 99; }
        if (sel abi_opt.some) {
            val step_r: err[outcome.Fail] = dcfg.execute_dep_steps(?p,
                isa_opt.some, os_opt.some, abi_opt.some);
            if (sel step_r.err) { bad = 1; }
        }
    }

    project.dnit_project(?p);
    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.driver:cascade_libs_fail_at_n_releases_scratch" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:  session.Session   = sr.ok;
    val rr: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "fun main() i32 { ret 0; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold_m(?alloc,
        ut_dep_root_two(?alloc, "a", "./vendor/a", "b", "./vendor/b"), ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    val a_manifest: str            = ut_dep_lib_with_export(?alloc, "a");
    val b_manifest: str            = ut_lib_manifest(?alloc, "b");
    val libsrc:     str            = "pub fun v() i32 { ret 1; }\n";
    val wa:         err[fail.Fail] = ut_write_node(?alloc, ut_cc3(?alloc, root, "/", "dep/a"), a_manifest, "lib.mach", libsrc);
    if (sel wa.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    val wb: err[fail.Fail] = ut_write_node(?alloc, ut_cc3(?alloc, root, "/", "dep/b"), b_manifest, "lib.mach", libsrc);
    if (sel wb.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    if (!ut_git_repo(?alloc, root, "https://example.invalid/app.git")) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }

    val pr: res[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
    if (sel pr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    var bad: i32 = 0;
    if (p.config.dep_count != 2) { bad = 1; }
    or {
        val isa_opt: opt[str] = intern.lookup(?s.interner, p.target_entry.isa_name);
        val os_opt:  opt[str] = intern.lookup(?s.interner, p.target_entry.os_name);
        val abi_opt: opt[str] = intern.lookup(?s.interner, p.target_entry.abi_name);
        if (sel isa_opt.none) { ret 99; }
        if (sel os_opt.none)  { ret 99; }
        if (sel abi_opt.some) {
            val isa_s:      str          = isa_opt.some;
            val os_s:       str          = os_opt.some;
            val abi_s:      str          = abi_opt.some;
            val orig_alloc: *A.Allocator = p.alloc;

            var fail_at:                          u32 = 1;
            val scratch_construction_fail_at_max: u32 = 3;
            for (fail_at <= scratch_construction_fail_at_max && bad == 0) {
                if (p.config.cascade_libs != nil && p.config.cascade_lib_count > 0) {
                    manifest.free_link_claims(orig_alloc, p.config.cascade_libs, p.config.cascade_lib_count);
                    A.deallocate[manifest.LinkRequirement](orig_alloc, p.config.cascade_libs, p.config.cascade_lib_count::usize);
                    p.config.cascade_libs      = nil;
                    p.config.cascade_lib_count = 0;
                }

                var probe:       DepsScratchProbe;
                var probe_alloc: A.Allocator;
                if (!deps_scratch_probe_make(?probe, ?probe_alloc, fail_at)) {
                    bad = 1;
                    brk;
                }
                p.alloc = ?probe_alloc;
                val cr: err[outcome.Fail] = ddep.resolve_cascade_libs(?p, isa_s, os_s, abi_s,
                    p.target_entry.libs, p.target_entry.lib_count);
                p.alloc = orig_alloc;

                val pre_diagnostic_fail_at_max: u32 = 3;
                if (sel cr.ok) { bad = 1; }
                if (sel cr.err) {
                    if (fail_at <= pre_diagnostic_fail_at_max) {
                        if (probe.live != 0 || probe.live_count != 0) { bad = 1; }
                    }
                    or {
                        val retained_diagnostic_string_count: i64 = 1;
                        if (probe.live_count > retained_diagnostic_string_count) { bad = 1; }
                    }
                }

                fail_at = fail_at + 1;
            }
        }
    }

    project.dnit_project(?p);
    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.driver:dep_unresolved_names_dep_and_fix" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:  session.Session   = sr.ok;
    val rr: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "fun main() i32 { ret 0; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold_m(?alloc, ut_dep_root_one(?alloc, "absdep", "./vendor/absdep"), ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    var bad: i32                                = 0;
    val pr:  res[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
    if (sel pr.ok) {
        var p: project.Project = pr.ok;
        project.dnit_project(?p);
        bad = 1;
    }
    if (sel pr.err) {
        val msg: str = outcome.describe(pr.err);
        if (!ut_str_contains(msg, "'absdep'"))                                            { bad = 1; }
        if (!ut_str_contains(msg, "not realized"))                                        { bad = 1; }
        if (!ut_str_contains(msg, "mach dep pull"))                                       { bad = 1; }
        if (!ut_str_contains(msg, "mach dep pull <path>") || !ut_str_contains(msg, root)) { bad = 1; }
        if (ut_str_contains(msg, "no such file"))                                         { bad = 1; }
    }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

fun ut_refused_dep_root(f: outcome.Fail) bool {
    ret ut_str_contains(outcome.describe(f), ddep.DEP_ROOT_REFUSED);
}

# build, test and dependency verification refuse a symlinked dependency root with one
# message, and accept the same project once dep is a physical directory (#3478)
test "mach.lang.driver:every_entry_point_refuses_a_symlinked_dep_root" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "fun main() i64 { ret 0; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 1);
    if (sel root_r.err) { ret 2; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?alloc, root); }
    val setup_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_r.err) { ret 3; }
    val elsewhere: str             = ut_cc3(?alloc, root, "/", "elsewhere");
    val made:      err[fs.FsError] = fs.create_dir_all(?alloc, elsewhere, 493);
    if (sel made.err) { ret 4; }
    val link:   str                 = ut_cc3(?alloc, root, "/", "dep");
    val linked: err[io_error.Error] = fs.symlink(elsewhere, link);
    if (sel linked.err) { ret 5; }

    var pick:  manifest.Selection                 = ut_target_sel("");
    var bad:   i32                                = 0;
    val built: res[project.Project, outcome.Fail] = driver.build_project(?s, root, ?pick);
    if (sel built.ok) {
        var p: project.Project = built.ok;
        project.dnit_project(?p);
        bad = bad | 1;
    }
    if (sel built.err && !ut_refused_dep_root(built.err)) { bad = bad | 2; }
    val tested: res[project.Project, outcome.Fail] = ut_load_test_goal(?s, root, pick);
    if (sel tested.ok) {
        var p: project.Project = tested.ok;
        project.dnit_project(?p);
        bad = bad | 4;
    }
    if (sel tested.err && !ut_refused_dep_root(tested.err)) { bad = bad | 8; }
    val verified: err[outcome.Fail] = driver.verify_dependencies(?s, root, false, nil);
    if (sel verified.ok)                                        { bad = bad | 16; }
    if (sel verified.err && !ut_refused_dep_root(verified.err)) { bad = bad | 32; }

    # a physical dep is accepted by the same entry points
    val unlinked: err[io_error.Error] = fs.remove_file(link);
    if (sel unlinked.err) { ret 6; }
    val physical: err[fs.FsError] = fs.create_dir_all(?alloc, link, 493);
    if (sel physical.err) { ret 7; }
    val accepted: err[outcome.Fail] = driver.verify_dependencies(?s, root, false, nil);
    if (sel accepted.err) { bad = bad | 64; }
    val rebuilt: res[project.Project, outcome.Fail] = driver.build_project(?s, root, ?pick);
    if (sel rebuilt.err) { bad = bad | 128; }
    if (sel rebuilt.ok) {
        var p: project.Project = rebuilt.ok;
        project.dnit_project(?p);
    }
    ret bad;
}

fun ut_git_in(alloc: *A.Allocator, dir: str, a1: str, a2: str, a3: str, a4: str, a5: str) bool {
    var args: [7]str;
    args[0] = "-C";
    args[1] = dir;
    var n: usize = 2;
    if (!str_empty(a1)) {
        args[n] = a1;
        n       = n + 1;
    }
    if (!str_empty(a2)) {
        args[n] = a2;
        n       = n + 1;
    }
    if (!str_empty(a3)) {
        args[n] = a3;
        n       = n + 1;
    }
    if (!str_empty(a4)) {
        args[n] = a4;
        n       = n + 1;
    }
    if (!str_empty(a5)) {
        args[n] = a5;
        n       = n + 1;
    }
    ret ut_git(alloc, ?args[0], n);
}

fun ut_release_manifest(alloc: *A.Allocator, version: str) str {
    ret ut_cc3(alloc, "[project]\nid = \"relib\"\nversion = \"", version, "\"\nsrc = \"src\"\nout = \"out\"\n");
}

# a repository with an annotated v1.0.0 and a lightweight v1.0.1 on one commit, a pre-release,
# a tag that is no release, and a v1.2.0 whose manifest names another version
fun ut_release_repo(alloc: *A.Allocator, dir: str) bool {
    val w1: err[fail.Fail] = ut_write_node(alloc, dir, ut_release_manifest(alloc, "1.0.0"), "lib.mach", "pub val X: u64 = 1;\n");
    if (sel w1.err)                                                 { ret false; }
    if (!ut_git_repo(alloc, dir, dir))                              { ret false; }
    if (!ut_git_in(alloc, dir, "tag", "-a", "v1.0.0", "-m", "one")) { ret false; }
    if (!ut_git_in(alloc, dir, "tag", "v1.0.1", "", "", ""))        { ret false; }
    if (!ut_git_in(alloc, dir, "tag", "nightly", "", "", ""))       { ret false; }
    val w2: err[fail.Fail] = ut_write_node(alloc, dir, ut_release_manifest(alloc, "2.0.0-rc.1"), "lib.mach", "pub val X: u64 = 2;\n");
    if (sel w2.err)                                               { ret false; }
    if (!ut_git_commit_all(alloc, dir, "rc"))                     { ret false; }
    if (!ut_git_in(alloc, dir, "tag", "v2.0.0-rc.1", "", "", "")) { ret false; }
    val w3: err[fail.Fail] = ut_write_node(alloc, dir, ut_release_manifest(alloc, "1.2.1"), "lib.mach", "pub val X: u64 = 3;\n");
    if (sel w3.err)                                 { ret false; }
    if (!ut_git_commit_all(alloc, dir, "mismatch")) { ret false; }
    ret ut_git_in(alloc, dir, "tag", "v1.2.0", "", "", "");
}

fun ut_find_release(list: *Vector[cand.Release], tag: str) i64 {
    var i: usize = 0;
    for (i < list.len) {
        if (str_equals(list.data[i].tag, tag)) { ret i::i64; }
        i = i + 1;
    }
    ret -1;
}

# 0 when the source lists exactly the four release tags and reads their manifests (#3500)
fun ut_check_candidates(s: *session.Session, src: *cand.CandidateSource, url: str) i32 {
    var list: Vector[cand.Release] = vector.init[cand.Release](s.build_alloc);
    fin { cand.releases_free(s.build_alloc, ?list); }
    val listed: err[outcome.Fail] = src.releases(src.ctx, url, ?list);
    if (sel listed.err) { ret 1; }
    if (list.len != 4)  { ret 2; }
    val one:  i64 = ut_find_release(?list, "v1.0.0");
    val oneb: i64 = ut_find_release(?list, "v1.0.1");
    val rc:   i64 = ut_find_release(?list, "v2.0.0-rc.1");
    val bad:  i64 = ut_find_release(?list, "v1.2.0");
    if (one < 0 || oneb < 0 || rc < 0 || bad < 0) { ret 3; }
    # the annotated tag resolves to its commit, the one the lightweight tag names
    if (!str_equals(list.data[one::usize].commit, list.data[oneb::usize].commit))              { ret 4; }
    if (list.data[rc::usize].version.pre_len != 4 || list.data[one::usize].version.major != 1) { ret 5; }
    val m1: res[manifest.Manifest, outcome.Fail] = src.manifest_at(src.ctx, url, ?list.data[one::usize]);
    if (sel m1.err) { ret 6; }
    if (sel m1.ok) {
        var m: manifest.Manifest = m1.ok;
        val v: opt[str]          = intern.lookup(?s.interner, m.version);
        if (sel v.none) { ret 7; }
        if (sel v.some) {
            if (!str_equals(v.some, "1.0.0")) { ret 7; }
        }
        manifest.dnit(?m, s.build_alloc);
    }
    val m2: res[manifest.Manifest, outcome.Fail] = src.manifest_at(src.ctx, url, ?list.data[rc::usize]);
    if (sel m2.err) { ret 8; }
    if (sel m2.ok) {
        var m: manifest.Manifest = m2.ok;
        manifest.dnit(?m, s.build_alloc);
    }
    val m3: res[manifest.Manifest, outcome.Fail] = src.manifest_at(src.ctx, url, ?list.data[bad::usize]);
    if (sel m3.ok) { ret 9; }
    if (sel m3.err) {
        if (!ut_str_contains(outcome.describe(m3.err), "release v1.2.0")
            || !ut_str_contains(outcome.describe(m3.err), "does not match the tag")) { ret 10; }
    }
    # the same commit is also the lightweight tag's manifest
    val m4: res[manifest.Manifest, outcome.Fail] = src.manifest_at(src.ctx, url, ?list.data[oneb::usize]);
    if (sel m4.ok) { ret 11; }
    ret 0;
}

test "mach.lang.driver:the_git_candidate_source_lists_release_tags_and_reads_their_manifests" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val tf_r: res[fs.TempFile, fs.FsError] = fs.temp_create(?alloc, "mach_release_repo");
    if (sel tf_r.err) { ret 2; }
    var tf:    fs.TempFile       = tf_r.ok;
    val dup_r: res[str, A.Error] = str_dup(?alloc, fs.temp_path(?tf));
    fs.temp_close_and_remove(?tf);
    if (sel dup_r.err) { ret 2; }
    val repo: str = dup_r.ok;
    fin { fs.remove_all(?alloc, repo); }
    if (!ut_release_repo(?alloc, repo)) { ret 3; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 4; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var code: i32 = 0;
    var pass: u32 = 0;
    for (pass < 2) {
        val offline: bool                                  = pass == 1;
        val gc_r:    res[ddep.GitCandidates, outcome.Fail] = ddep.git_candidates_init(?s, offline, repo);
        if (sel gc_r.err) { ret 5; }
        var gc:  ddep.GitCandidates   = gc_r.ok;
        var src: cand.CandidateSource = ddep.git_candidate_source(?gc);
        val r:   i32                  = ut_check_candidates(?s, ?src, repo);
        ddep.git_candidates_dnit(?gc);
        if (r != 0) { code = 10 * (pass::i32 + 1) + r; }
        pass = pass + 1;
    }
    ret code;
}

# the root manifest of ut_manifest with a [project].mach line, and optionally a path dependency
fun ut_manifest_mach(alloc: *A.Allocator, range: str, dep_path: str) str {
    # ut_manifest opens with "[project]\nmach = \">=5\"\n", which this replaces
    val base: str = ut_manifest();
    val rest: str = (?base[23])::str;
    var text: str = ut_cc3(alloc, "[project]\n", rest, "");
    if (!str_empty(range)) {
        text = ut_cc3(alloc, ut_cc3(alloc, "[project]\nmach = \"", range, "\"\n"), "", rest);
    }
    if (!str_empty(dep_path)) {
        text = ut_cc3(alloc, text, ut_cc3(alloc, "\n[dep.libx]\npath = \"", dep_path, "\"\n"), "");
    }
    ret text;
}

# a path dependency `libx` stating `range` (empty for no key), realized under root/dep/libx from its source beside the root
fun ut_mach_dep(alloc: *A.Allocator, root: str, range: str) bool {
    var mach_line: str = "";
    if (!str_empty(range)) { mach_line = ut_cc3(alloc, "mach = \"", range, "\"\n"); }
    val manifest_text: str            = ut_cc3(alloc, ut_cc3(alloc, "[project]\nid = \"libx\"\nversion = \"1.0.0\"\n", mach_line, ""), "src = \"src\"\nout = \"out\"\n", "");
    val lib_text:      str            = "pub val X: u64 = 1;\n";
    val src_dir:       str            = ut_cc3(alloc, root, "/", "libx-src");
    val real_dir:      str            = ut_cc3(alloc, root, "/", "dep/libx");
    val a:             err[fail.Fail] = ut_write_node(alloc, src_dir, manifest_text, "lib.mach", lib_text);
    if (sel a.err) { ret false; }
    val b: err[fail.Fail] = ut_write_node(alloc, real_dir, manifest_text, "lib.mach", lib_text);
    if (sel b.err) { ret false; }
    ret true;
}

fun ut_compiler_refusal(f: outcome.Fail, needle: str) bool {
    val text: str = outcome.describe(f);
    ret ut_str_contains(text, "and the dependency closure does not accept it") && ut_str_contains(text, needle);
}

# [project].mach is checked for the root and every realized dependency by the one driver
# check every entry point runs, naming who requires what; a root without it is refused (#3671)
test "mach.lang.driver:the_compiler_range_of_every_manifest_is_checked_on_every_entry_point" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var pick:  manifest.Selection = ut_target_sel("");
    var bad:   i32                = 0;
    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "fun main() i64 { ret 0; }\n";
    var dep_texts: [1]str;
    dep_texts[0] = "use libx.lib;\nfun main() i64 { ret lib.X::i64; }\n";

    var round: u32 = 0;
    for (round < 5) {
        val sr: res[session.Session, fail.Fail] = session.init(?alloc);
        if (sel sr.err) { ret 2; }
        var s:       session.Session   = sr.ok;
        val setup_r: err[outcome.Fail] = driver.setup_registry(s.registry);
        if (sel setup_r.err) { ret 3; }
        # 0: the root excludes this compiler; 1: a dependency does; 2: both accept; 3: the root states
        # nothing; 4: the dependency states nothing
        var root_range: str  = "<1";
        var dep_range:  str  = "";
        val with_dep:   bool = round == 1 || round == 2 || round == 4;
        if (round == 1) {
            root_range = ">=5";
            dep_range  = "<1, >=0.1";
        }
        if (round == 2) {
            root_range = ">=5";
            dep_range  = "^5";
        }
        if (round == 3) { root_range = ""; }
        if (round == 4) { root_range = ">=5"; }
        var dep_path: str = "";
        if (with_dep) { dep_path = "libx-src"; }
        val mtext: str  = ut_manifest_mach(?alloc, root_range, dep_path);
        var src:   *str = ?texts[0];
        if (with_dep) { src = ?dep_texts[0]; }
        val root_r: res[str, fail.Fail] = ut_scaffold_m(?alloc, mtext, ?names[0], src, 1);
        if (sel root_r.err) { ret 4; }
        val root: str = root_r.ok;
        if (with_dep && !ut_mach_dep(?alloc, root, dep_range)) { ret 5; }

        # a failure's text lives until the session's next failure, so each is read before the next call
        val built: res[project.Project, outcome.Fail] = driver.build_project(?s, root, ?pick);
        if (round == 0) {
            if (sel built.ok)                                                                               { bad = bad | 1; }
            if (sel built.err && !ut_compiler_refusal(built.err, "uniontest (mach.toml) requires mach <1")) { bad = bad | 2; }
        }
        if (round == 1) {
            if (sel built.ok) { bad = bad | 16; }
            if (sel built.err) {
                if (!ut_compiler_refusal(built.err, "-> libx requires mach <1, >=0.1")) { bad = bad | 32; }
                if (ut_str_contains(outcome.describe(built.err), "(mach.toml)"))        { bad = bad | 64; }
            }
        }
        if ((round == 2 || round == 4) && sel built.err) { bad = bad | 128; }
        # a 5.x compiler suggests the key's own floor, not its own minor (#3572)
        var want: str = "mach.toml: [project] states no compiler range; add `mach = \"^";
        if (string.str_starts_with(compiler.MACH_VERSION, "5.")) { want = "mach.toml: [project] states no compiler range; add `mach = \"^5.3\"`, the oldest release that reads the key"; }
        if (round == 3) {
            if (sel built.ok)                                                         { bad = bad | 1024; }
            if (sel built.err && !ut_str_contains(outcome.describe(built.err), want)) { bad = bad | 2048; }
        }
        if (sel built.ok) {
            var p: project.Project = built.ok;
            project.dnit_project(?p);
        }
        val verified: err[outcome.Fail] = driver.verify_dependencies(?s, root, false, nil);
        if (round == 0) {
            if (sel verified.ok)                                                            { bad = bad | 4; }
            if (sel verified.err && !ut_compiler_refusal(verified.err, "requires mach <1")) { bad = bad | 8; }
        }
        if (round == 1 && !(sel verified.err && ut_compiler_refusal(verified.err, "-> libx requires mach <1, >=0.1"))) { bad = bad | 4096; }
        if ((round == 2 || round == 4) && sel verified.err)                                                            { bad = bad | 256; }
        if (round == 3 && !(sel verified.err && ut_str_contains(outcome.describe(verified.err), want)))                { bad = bad | 8192; }
        session.dnit(?s);
        fs.remove_all(?alloc, root);
        round = round + 1;
    }
    ret bad;
}

test "mach.lang.driver:bare_import_of_a_dependency_whose_artifacts_name_different_entries_says_so" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }

    val origin: str = "https://example.invalid/split.git";
    var names:  [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "use split;\n\nfun main() i32 { ret 0; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold_m(?alloc,
        ut_dep_root_git(?alloc, "split", origin), ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root:         str = root_r.ok;
    val dep_root:     str = ut_cc3(?alloc, root, "/", "dep/split");
    val dep_manifest: str = "[project]\nmach = \">=5\"\nid = \"split\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[artifact.one]\nkind = \"static\"\nentry = \"one.mach\"\nout = \"lib/one\"\ntargets = [\"*\"]\nlink = []\nneed = []\n\n[artifact.two]\nkind = \"static\"\nentry = \"two.mach\"\nout = \"lib/two\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n";
    var dep_names:    [2]str;
    dep_names[0] = "one.mach";
    dep_names[1] = "two.mach";
    var dep_texts: [2]str;
    dep_texts[0] = "pub fun v() i32 { ret 1; }\n";
    dep_texts[1] = "pub fun v() i32 { ret 2; }\n";
    val wr: err[fail.Fail] = ut_write_node_multi(?alloc, dep_root, dep_manifest, ?dep_names[0], ?dep_texts[0], 2);
    if (sel wr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    if (!ut_git_repo(?alloc, dep_root, origin)) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    if (!ut_write_gitmodules(?alloc, root, "split", origin)) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    if (!ut_git_repo(?alloc, root, "https://example.invalid/app.git")) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }

    var bad:    i32                                = 0;
    val needle: str                                = "project 'split' has no public module: a bare import binds the entry shared by its library artifacts marked `default = true`";
    val pr:     res[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
    # the tolerant load keeps the project standing rejected; the report is what is checked
    if (sel pr.ok) {
        var p:        project.Project  = pr.ok;
        val standing: fail.PhaseStatus = passes.frontend_status(?p);
        if (!sel standing.kind.rejected) { bad = 1; }
        project.dnit_project(?p);
    }
    {
        var seen: bool = false;
        if (sel pr.err) { seen = ut_str_contains(outcome.describe(pr.err), needle); }
        var i: usize = 0;
        for (i < diagnostic.len(?s.diags)) {
            if (ut_str_contains(s.diags.items.data[i].message, needle)) { seen = true; }
            i = i + 1;
        }
        if (!seen) { bad = 2; }
    }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

# an artifact-less dependency has no public module and the refusal says so,
# while a full-path import of the same module still binds
test "mach.lang.driver:bare_import_of_an_artifact_less_dependency_is_refused_naming_the_default_artifact" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }

    val origin: str = "https://example.invalid/bare.git";
    var names:  [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "use bare;\n\nfun main() i32 { ret bare.v(); }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold_m(?alloc,
        ut_dep_root_git(?alloc, "bare", origin), ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root:         str            = root_r.ok;
    val dep_root:     str            = ut_cc3(?alloc, root, "/", "dep/bare");
    val dep_manifest: str            = "[project]\nmach = \">=5\"\nid = \"bare\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n";
    val wr:           err[fail.Fail] = ut_write_node(?alloc, dep_root, dep_manifest, "lib.mach", "pub fun v() i32 { ret 0; }\n");
    if (sel wr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    if (!ut_git_repo(?alloc, dep_root, origin)) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    if (!ut_write_gitmodules(?alloc, root, "bare", origin)) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    if (!ut_git_repo(?alloc, root, "https://example.invalid/app.git")) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }

    var bad:    i32                                = 0;
    val needle: str                                = "project 'bare' declares no artifact, so it has no public module: import a full path, or declare a static or shared [artifact.*] table marked default = true in its manifest";
    val pr:     res[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
    # the tolerant load keeps the project standing rejected; the report is what is checked
    if (sel pr.ok) {
        var p:        project.Project  = pr.ok;
        val standing: fail.PhaseStatus = passes.frontend_status(?p);
        if (!sel standing.kind.rejected) { bad = 1; }
        project.dnit_project(?p);
    }
    {
        var seen: bool = false;
        if (sel pr.err) { seen = ut_str_contains(outcome.describe(pr.err), needle); }
        var i: usize = 0;
        for (i < diagnostic.len(?s.diags)) {
            if (ut_str_contains(s.diags.items.data[i].message, needle)) { seen = true; }
            i = i + 1;
        }
        if (!seen) { bad = 2; }
    }

    # the full-path import needs no default artifact
    if (bad == 0) {
        val main_path: str             = ut_cc3(?alloc, root, "/src/", "main.mach");
        val full:      str             = "use bare.lib;\n\nfun main() i32 { ret lib.v(); }\n";
        val ww:        err[fs.FsError] = fs.write_bytes(main_path, full, str_len(full), 420);
        if (sel ww.err) { bad = 3; }
        or {
            val pr2: res[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
            if (sel pr2.err) { bad = 4; }
            if (sel pr2.ok) {
                var p2: project.Project = pr2.ok;
                project.dnit_project(?p2);
            }
        }
    }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}
