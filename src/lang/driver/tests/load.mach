# a module reached by two artifacts is the primary artifact's when the primary reaches
# it. when an edit makes the primary reach modules only `shaded` reached before, in the
# same walk order as before, they are attributed again and typed again rather than
# replayed from the session: the cell's configuration (same root, same request) and the
# module numbering are unchanged, so only the attribution says the answer moved (#3776)
test a_module_the_primary_artifact_comes_to_reach_is_typed_under_it {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }

    val shaded: str                 = "use lessons.common;\n\npub fun run() i32 { ret common.check(); }\n\nfun main() i32 { ret run(); }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold_lessons(?alloc, shaded);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?alloc, root); }
    # a body gate is decided by sema, so the attribution reaches it through no load product
    val common_path: str             = ut_cc3(?alloc, root, "/", "src/common.mach");
    val common:      str             = "pub fun check() i32 {\n    $if ($bin.name != \"hello\") { $error(\"wrong artifact\"); }\n    ret 0;\n}\n";
    val wrote:       err[fs.FsError] = fs.write_bytes(common_path, common, str_len(common), 420);
    if (sel wrote.err) { ret 1; }

    val mr: res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) { ret 1; }
    var mf: manifest.Manifest = mr.ok;
    fin { manifest.dnit(?mf, ?alloc); }

    var bad: i32 = 0;

    # only `shaded` reaches `common`, so it reads `shaded` and refuses
    val first: res[project.Project, outcome.Fail] = ut_analyze_lessons(?s, ?mf, root, project.ROOT_UNION);
    if (sel first.err) { ret 2; }
    var fp: project.Project = first.ok;
    if (!ut_diag_has(?s.diags, "wrong artifact"))                             { bad = 3; }
    if (!str_equals(ut_module_bin_name(?fp, ?s, "lessons.common"), "shaded")) { bad = 4; }
    val stable: session.StableModuleId = ut_stable(?fp, ?s, "lessons.common");
    val number: session.ModuleId       = ut_mid(?fp, ?s, "lessons.common");
    val sema_1: query.Revision         = ut_sema_lc(?s, stable);
    project.dnit_project(?fp);
    if (bad != 0) { ret bad; }

    # `hello` now reaches `shaded` and through it `common`, in the order the union walk
    # already registered them: the primary's attribution wins and the body types clean
    val hello_path: str            = ut_cc3(?alloc, root, "/", "src/hello.mach");
    val overlay:    str            = "use lessons.shaded;\n\nfun main() i32 { ret shaded.run(); }\n";
    val laid:       err[fail.Fail] = session.set_overlay(?s, hello_path, overlay);
    if (sel laid.err) { ret 5; }
    val second: res[project.Project, outcome.Fail] = ut_analyze_lessons(?s, ?mf, root, project.ROOT_UNION);
    if (sel second.err) { ret 6; }
    var sp: project.Project = second.ok;
    if (ut_mid(?sp, ?s, "lessons.common") != number)                         { bad = 7; }
    if (ut_count_errors(?s.diags) != 0)                                      { bad = 8; }
    if (!str_equals(ut_module_bin_name(?sp, ?s, "lessons.common"), "hello")) { bad = 9; }
    if (!str_equals(ut_module_bin_name(?sp, ?s, "lessons.shaded"), "hello")) { bad = 10; }
    if (ut_sema_lc(?s, stable) == sema_1)                                    { bad = 11; }
    project.dnit_project(?sp);
    ret bad;
}

# a module first reached behind a gate that reads a constant a later `use` imports is
# attributed to the importing module's artifact rather than the cell's: `late.mach`
# enters through `shaded.mach`'s gate and reads `shaded` (#3776)
test a_module_reached_behind_a_gate_on_a_later_use_reads_its_importer_artifact {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }

    val shaded: str                 = "$if (flags.LATE == 1) {\n    use lessons.late;\n}\n\nuse lessons.flags;\n\nfun main() i32 { ret late.answer(); }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold_lessons(?alloc, shaded);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?alloc, root); }
    val flags_path: str             = ut_cc3(?alloc, root, "/", "src/flags.mach");
    val flags:      str             = "pub val LATE: u8 = 1;\n";
    val wrote_f:    err[fs.FsError] = fs.write_bytes(flags_path, flags, str_len(flags), 420);
    if (sel wrote_f.err) { ret 1; }
    val late_path: str             = ut_cc3(?alloc, root, "/", "src/late.mach");
    val late:      str             = "$if ($bin.name != \"shaded\") { $error(\"wrong artifact\"); }\n\npub fun answer() i32 { ret 0; }\n";
    val wrote_l:   err[fs.FsError] = fs.write_bytes(late_path, late, str_len(late), 420);
    if (sel wrote_l.err) { ret 1; }

    val mr: res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) { ret 1; }
    var mf: manifest.Manifest = mr.ok;
    fin { manifest.dnit(?mf, ?alloc); }

    var bad:  i32                                = 0;
    val wide: res[project.Project, outcome.Fail] = ut_analyze_lessons(?s, ?mf, root, project.ROOT_UNION);
    if (sel wide.err) { ret 2; }
    var wp: project.Project = wide.ok;
    if (!ut_has(?wp, ?s, "lessons.late"))                                   { bad = 3; }
    if (ut_count_errors(?s.diags) != 0)                                     { bad = 4; }
    if (!str_equals(ut_module_bin_name(?wp, ?s, "lessons.late"), "shaded")) { bad = 5; }
    project.dnit_project(?wp);
    ret bad;
}

rec LoadSlotProbe {
    backing:    A.Allocator;
    live:       i64;
    live_count: i64;
    calls:      u32;
    fail_at:    u32;
}

fun load_slot_probe_allocate(ctx: ptr, size: usize, align: usize) opt[ptr] {
    val p: *LoadSlotProbe = ctx::*LoadSlotProbe;
    p.calls = p.calls + 1;
    if (p.fail_at != 0 && p.calls == p.fail_at) { ret opt[ptr].none{}; }
    val r: opt[ptr] = p.backing.fn_allocate(p.backing.ctx, size, align);
    if (sel r.some) {
        p.live       = p.live + size::i64;
        p.live_count = p.live_count + 1;
        memory.raw_fill(r.some, 0xAA, size);
    }
    ret r;
}

fun load_slot_probe_reallocate(ctx: ptr, item: ptr, old_size: usize, new_size: usize, align: usize) opt[ptr] {
    val p: *LoadSlotProbe = ctx::*LoadSlotProbe;
    p.calls = p.calls + 1;
    if (p.fail_at != 0 && p.calls == p.fail_at) { ret opt[ptr].none{}; }
    val r: opt[ptr] = p.backing.fn_reallocate(p.backing.ctx, item, old_size, new_size, align);
    if (sel r.some) {
        p.live = p.live - old_size::i64 + new_size::i64;
        if (new_size > old_size) {
            val grown: ptr = r.some;
            memory.raw_fill((grown::usize + old_size)::ptr, 0xAA, new_size - old_size);
        }
    }
    ret r;
}

fun load_slot_probe_deallocate(ctx: ptr, item: ptr, size: usize, align: usize) i64 {
    val p: *LoadSlotProbe = ctx::*LoadSlotProbe;
    p.live       = p.live - size::i64;
    p.live_count = p.live_count - 1;
    ret p.backing.fn_deallocate(p.backing.ctx, item, size, align);
}

fun load_slot_probe_make(p: *LoadSlotProbe, alloc: *A.Allocator, backing: *A.Allocator, fail_at: u32) {
    p.backing    = @backing;
    p.live       = 0;
    p.live_count = 0;
    p.calls      = 0;
    p.fail_at    = fail_at;
    val probe: *LoadSlotProbe = p;
    alloc.ctx           = probe::ptr;
    alloc.fn_allocate   = load_slot_probe_allocate;
    alloc.fn_reallocate = load_slot_probe_reallocate;
    alloc.fn_deallocate = load_slot_probe_deallocate;
}

test load_module_registration_fail_at_n_no_leak {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }

    var base_names: [1]str;
    base_names[0] = "main.mach";
    var base_texts: [1]str;
    base_texts[0] = "fun main() i32 { ret 0; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?base_names[0], ?base_texts[0], 1);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;

    # one module short of a full 64-entry chunk, so the probed load grows the table
    val preload:   u32 = 63;
    var pi:        u32 = 0;
    var setup_bad: i32 = 0;
    for (pi < preload + 1 && setup_bad == 0) {
        val name_r: res[str, format.FormatError] = format.sprint(?alloc, "c{}.mach", pi);
        if (sel name_r.err) {
            setup_bad = 1;
            brk;
        }
        val name:     str             = name_r.ok;
        val name_cap: usize           = str_len(name) + 1;
        val text:     str             = "pub fun leaf() i32 { ret 0; }\n";
        val fp:       str             = ut_cc3(?alloc, root, "/src/", name);
        val we:       err[fs.FsError] = fs.write_bytes(fp, text, str_len(text), 420);
        A.deallocate[u8](?alloc, name::*u8, name_cap);
        if (sel we.err) {
            setup_bad = 1;
            brk;
        }
        pi = pi + 1;
    }
    if (setup_bad != 0) {
        fs.remove_all(?alloc, root);
        ret 1;
    }

    var bad:         i32  = 0;
    var saw_success: bool = false;
    var fail_at:     u32  = 1;
    val max_fail_at: u32  = 2;
    for (fail_at <= max_fail_at && bad == 0) {
        val sr: res[session.Session, fail.Fail] = session.init(?alloc);
        if (sel sr.err) {
            bad = 1;
            brk;
        }
        var s:  session.Session   = sr.ok;
        val rr: err[outcome.Fail] = driver.setup_registry(s.registry);
        if (sel rr.err) {
            session.dnit(?s);
            bad = 1;
            brk;
        }

        val pr: res[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
        if (sel pr.err) {
            session.dnit(?s);
            bad = 1;
            brk;
        }
        var p: project.Project = pr.ok;
        if (project.module_count(?p) != 1) {
            project.dnit_project(?p);
            session.dnit(?s);
            bad = 1;
            brk;
        }

        var pj: u32 = 0;
        for (pj < preload && bad == 0) {
            val nm_r: res[str, format.FormatError] = format.sprint(?alloc, "uniontest.c{}", pj);
            if (sel nm_r.err) {
                bad = 1;
                brk;
            }
            val nm:    str                        = nm_r.ok;
            val fqn_r: res[intern.StrId, A.Error] = intern.intern(?s.interner, nm);
            A.deallocate[u8](?alloc, nm::*u8, str_len(nm) + 1);
            if (sel fqn_r.err) {
                bad = 1;
                brk;
            }
            val lr: res[session.ModuleId, fail.Fail] = load.dfs_load(?p, fqn_r.ok);
            if (sel lr.err) {
                bad = 1;
                brk;
            }
            pj = pj + 1;
        }
        if (bad != 0) {
            project.dnit_project(?p);
            session.dnit(?s);
            brk;
        }
        if (project.module_count(?p) != 1 + preload) {
            project.dnit_project(?p);
            session.dnit(?s);
            bad = 1;
            brk;
        }

        val fqn_r: res[intern.StrId, A.Error] = intern.intern(?s.interner, "uniontest.c63");
        if (sel fqn_r.err) {
            project.dnit_project(?p);
            session.dnit(?s);
            bad = 1;
            brk;
        }
        val fqn:      intern.StrId = fqn_r.ok;
        val baseline: u32          = project.module_count(?p);

        var probe:       LoadSlotProbe;
        var probe_alloc: A.Allocator;
        load_slot_probe_make(?probe, ?probe_alloc, ?alloc, fail_at);
        # the module table grows through its own allocator; route it through the
        # probe as well so a refused chunk is the first failure the load can see
        val chunks_before: usize = p.modules.chunks.len;
        p.alloc     = ?probe_alloc;
        p.modules.a = ?probe_alloc;
        val cr: res[session.ModuleId, fail.Fail] = load.dfs_load(?p, fqn);
        p.alloc     = ?alloc;
        p.modules.a = ?alloc;

        if (sel cr.ok) { bad = 2; }
        if (sel cr.err) {
            # a chunk the table kept is owned capacity, not a leak; everything else is released
            val kept: i64 = (p.modules.chunks.len - chunks_before)::i64;
            if (project.module_count(?p) != baseline) { bad = 3; }
            if (ut_has(?p, ?s, "uniontest.c63"))      { bad = 3; }
            if (probe.live_count != kept)             { bad = 4; }
        }

        project.dnit_project(?p);
        session.dnit(?s);
        fail_at = fail_at + 1;
    }

    if (bad == 0) {
        val sr: res[session.Session, fail.Fail] = session.init(?alloc);
        if (sel sr.err) { bad = 5; }
        if (sel sr.ok) {
            var s:  session.Session   = sr.ok;
            val rr: err[outcome.Fail] = driver.setup_registry(s.registry);
            if (sel rr.err) {
                session.dnit(?s);
                bad = 5;
            }
            if (sel rr.ok) {
                val pr: res[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
                if (sel pr.err) {
                    session.dnit(?s);
                    bad = 5;
                }
                if (sel pr.ok) {
                    var p:  project.Project = pr.ok;
                    var pj: u32             = 0;
                    for (pj < preload && bad == 0) {
                        val nm_r: res[str, format.FormatError] = format.sprint(?alloc, "uniontest.c{}", pj);
                        if (sel nm_r.err) {
                            bad = 5;
                            brk;
                        }
                        val nm:    str                        = nm_r.ok;
                        val fqn_r: res[intern.StrId, A.Error] = intern.intern(?s.interner, nm);
                        A.deallocate[u8](?alloc, nm::*u8, str_len(nm) + 1);
                        if (sel fqn_r.err) {
                            bad = 5;
                            brk;
                        }
                        val lr: res[session.ModuleId, fail.Fail] = load.dfs_load(?p, fqn_r.ok);
                        if (sel lr.err) {
                            bad = 5;
                            brk;
                        }
                        pj = pj + 1;
                    }
                    if (bad == 0) {
                        val fqn_r: res[intern.StrId, A.Error] = intern.intern(?s.interner, "uniontest.c63");
                        if (sel fqn_r.ok) {
                            val lr: res[session.ModuleId, fail.Fail] = load.dfs_load(?p, fqn_r.ok);
                            if (sel lr.err || project.module_count(?p) != 2 + preload) { bad = 5; }
                        }
                    }
                    project.dnit_project(?p);
                }
            }
            session.dnit(?s);
        }
    }

    fs.remove_all(?alloc, root);
    ret bad;
}

test module_level_layout_gate_awaits_registration {
    var bad: i32 = 0;

    if (ut_vec_diag("rec Pair { a: u64; b: u64; }\n$if ($size_of(Pair) == 16) { $error(\"Y\"); } $or { $error(\"N\"); }\nfun main() i32 { ret 0; }\n",
        "Y") != 0) { bad = 1; }
    if (ut_vec_diag("rec Pair { a: u64; b: u64; }\n$if ($size_of(Pair) == 16) { $error(\"Y\"); } $or { $error(\"N\"); }\nfun main() i32 { ret 0; }\n",
        "N") == 0) { bad = 2; }

    if (ut_vec_diag("rec Pair { a: u64; b: u64; }\n$if ($size_of(Pair) == 8) { $error(\"Y\"); } $or { $error(\"N\"); }\nfun main() i32 { ret 0; }\n",
        "N") != 0) { bad = 3; }
    if (ut_vec_diag("rec Pair { a: u64; b: u64; }\n$if ($size_of(Pair) == 8) { $error(\"Y\"); } $or { $error(\"N\"); }\nfun main() i32 { ret 0; }\n",
        "Y") == 0) { bad = 4; }

    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    # `$offset_of` answers from the checked layout once types are registered, like `$size_of`
    val src: str                                = "rec Pair { a: u64; b: u64; }\n$if ($offset_of(Pair, b) == 8) { $error(\"Y\"); } $or { $error(\"N\"); }\nfun main() i32 { ret 0; }\n";
    val pr:  res[project.Project, outcome.Fail] = ut_vec_sema(?s, ?alloc, src);
    if (!ut_project_was_rejected(pr)) {
        session.dnit(?s);
        ret 5;
    }
    if (!ut_diag_has(?s.diags, "Y"))   { bad = 6; }
    if (diagnostic.len(?s.diags) != 1) { bad = 7; }
    session.dnit(?s);

    ret bad;
}

# builds main, flags and the chain modules, and checks main's gates were decided by the load
fun ut_def_chain_gate(flags: str, want_diag: str) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var names: [5]str = [5]str{"main.mach", "flags.mach", "word.mach", "bits.mach", "raw.mach"};
    var texts: [5]str = [5]str{
        "use uniontest.flags;\n$if (flags.ON) {\n    fun pick() i32 { ret 1; }\n}\n$or {\n    use uniontest.missing;\n    fun pick() i32 { ret missing.value(); }\n}\n$if (flags.ON == 1) {\n    fun again() i32 { ret 2; }\n}\nfun main() i32 { ret pick() + again(); }\n",
        flags,
        "use uniontest.bits.Byte;\npub def Word: Byte;\npub def Wide: i32;\npub rec Pair { a: u8; b: u8; }\n",
        "fwd uniontest.raw.Byte;\n",
        "pub def Byte: u8;\n"
    };
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 5);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?alloc, root); }
    val rr: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.err) { ret 1; }
    var pick: manifest.Selection                 = ut_target_sel("linux");
    val pr:   res[project.Project, outcome.Fail] = driver.build_project(?s, root, ?pick);
    if (sel pr.err) {
        if (str_len(want_diag) > 0 && ut_diag_has(?s.diags, want_diag)) { ret 0; }
        ret 2;
    }
    var p: project.Project = pr.ok;
    fin { project.dnit_project(?p); }
    if (str_len(want_diag) > 0) {
        if (ut_diag_has(?s.diags, want_diag)) { ret 0; }
        ret 3;
    }
    if (ut_count_errors(?s.diags) != 0) { ret 4; }
    val mid: session.ModuleId = ut_mid(?p, ?s, "uniontest.main");
    if (mid == session.MODULE_NIL) { ret 5; }
    val m: *project.ModuleEntry = project.module_at(?p, mid::u32);
    if (comptime.gate_state(?m.ctx, ut_first_gate_cond(m.a)) == comptime.GATE_STATE_UNKNOWN) { ret 6; }
    val se: err[outcome.Fail] = driver.run_sema_pass(?p);
    if (sel se.err)                     { ret 7; }
    if (ut_count_errors(?s.diags) != 0) { ret 8; }
    ret 0;
}

test a_gate_reading_a_def_chain_across_modules_is_decided_at_load {
    # Flag -> word.Word -> Byte (a symbol import) -> raw.Byte (a fwd) -> u8
    val chain: i32 = ut_def_chain_gate("use uniontest.word;\npub def Flag: word.Word;\npub val ON: Flag = 1;\n", "");
    if (chain != 0) { ret 10 + chain; }
    # the same chain read from a constant in the gate's own module's import
    val direct: i32 = ut_def_chain_gate("use uniontest.word.Word;\npub val ON: Word = 1;\n", "");
    if (direct != 0) { ret 20 + direct; }
    # a chain ending at a signed primitive keeps its width, so the gate refuses it as not u8
    val wide: i32 = ut_def_chain_gate("use uniontest.word;\npub def Flag: word.Wide;\npub val ON: Flag = 1;\n", "condition must have type u8");
    if (wide != 0) { ret 30 + wide; }
    # a chain ending outside the integers is refused at the gate, naming the chain
    val pair: i32 = ut_def_chain_gate("use uniontest.word;\npub def Flag: word.Pair;\npub val ON: Flag = 1;\n",
        "`ON` is not an integer constant, so no gate can read it: its type follows the def chain `Flag` -> `word.Pair`");
    if (pair != 0) { ret 40 + pair; }
    val pointer: i32 = ut_def_chain_gate("pub def Flag: Handle;\ndef Handle: *u8;\npub val ON: Flag = 1;\n",
        "its type follows the def chain `Flag` -> `Handle` -> `*u8`, which ends outside the integer primitives");
    if (pointer != 0) { ret 50 + pointer; }
    # a def declared under a gate is read in the arm the gate selects, decided on demand
    val gated: i32 = ut_def_chain_gate("pub val ON: Flag = 1;\n$if ($mach.build.os == $mach.os.linux) { pub def Flag: u8; } $or { pub def Flag: u16; }\n", "");
    if (gated != 0) { ret 60 + gated; }
    val gated_wide: i32 = ut_def_chain_gate("pub val ON: Flag = 1;\n$if ($mach.build.os != $mach.os.linux) { pub def Flag: u8; } $or { pub def Flag: u16; }\n", "condition must have type u8");
    if (gated_wide != 0) { ret 70 + gated_wide; }
    ret 0;
}

test deferred_dependency_does_not_erase_invalid_gate_diagnostic {
    var names: [2]str;
    names[0] = "main.mach";
    names[1] = "dep.mach";
    var texts: [2]str;
    texts[0] = "use uniontest.dep;\n$if (NOPE) { }\nfun main() i32 { ret 0; }\n";
    texts[1] = "def Flag: u8;\nval C: Flag = 1;\n$if (C) { pub fun ready() i32 { ret 1; } }\n";
    if (ut_union_gate_result_n(?names[0], ?texts[0], 2, "NOPE", "") != 0) { ret 1; }
    ret 0;
}

test gate_diagnostic_dedups_across_decl_and_body_inference {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:     session.Session = sr.ok;
    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "def Flag: u8x4;\nval C: Flag = u8x4{1, 2, 3, 4};\n$if (C) { }\nfun main() i32 { ret 0; }\n";
    val pr: res[project.Project, outcome.Fail] = ut_single_sema_n(?s, ?alloc, ?names[0], ?texts[0], 1);
    if (sel pr.ok) {
        var p: project.Project = pr.ok;
        project.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }
    if (!outcome.is_reported(pr.err)) {
        session.dnit(?s);
        ret 1;
    }
    var bad: i32 = 0;
    if (!ut_diag_has(?s.diags, "a vector is not a truth value")) { bad = 2; }
    if (diagnostic.len(?s.diags) != 1)                           { bad = 3; }
    session.dnit(?s);
    ret bad;
}

# a gate the load decides on another module's constant, beside a positional case payload the
# same ast resolves: the payload binds whatever decided the gate (#3469)
test a_loaded_gate_leaves_a_nested_case_payload_bound {
    val lib:  str = "pub def flag: u8;\npub val ON: flag = 1;\n";
    val main: str = "use uniontest.lib;\n$if (lib.ON) { fun selected() i64 { ret 1; } }\ntag wrap[E]: u8 { err: E; ok; }\ntag Cause: u8 { missing; refused: i32; }\nfun check(key: i64) wrap[Cause] {\n    if (key == 0) { ret wrap[Cause].err{Cause.missing{}}; }\n    if (key < 0)  { ret wrap[Cause].err{Cause.refused{-1}}; }\n    ret wrap[Cause].ok{};\n}\nfun main() i64 { val r: wrap[Cause] = check(0); if (!sel r.err) { ret 1; } ret 0; }\n";
    if (!ut_sema_clean2(main, lib)) { ret 1; }
    ret 0;
}

# a lib that refuses itself in a decided arm, beside every way an importer reaches its names
fun ut_refusal_counts(lib: str, main: str, needles: *str, counts: *u32, n: u32) bool {
    var names: [2]str;
    names[0] = "main.mach";
    names[1] = "lib.mach";
    var texts: [2]str;
    texts[0] = main;
    texts[1] = lib;
    ret ut_refusal_counts_n(?names[0], ?texts[0], 2, needles, counts, n);
}

# the modules' project is rejected, with counts[i] errors naming needles[i]
fun ut_refusal_counts_n(names: *str, texts: *str, modules: u32, needles: *str, counts: *u32, n: u32) bool {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret false; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret false; }
    var s:        session.Session                    = sr.ok;
    val pr:       res[project.Project, outcome.Fail] = ut_vec_sema_n(?s, ?alloc, names, texts, modules);
    val rejected: bool                               = ut_project_was_rejected(pr);
    var i:        u32                                = 0;
    for (i < n) {
        counts[i] = ut_diag_count(?s.diags, needles[i]);
        i         = i + 1;
    }
    session.dnit(?s);
    ret rejected;
}

test a_module_refusal_is_its_only_diagnostic {
    val lib:     str = "$if (0 == 1) { use impl: uniontest.main; }\n$or { $error(\"LIB REFUSED\"); }\nfwd impl.X;\nfwd nowhere.thing;\npub val X: u64 = 1;\npub fun h() u64 { ret impl.X; }\n";
    val main:    str = "use lib: uniontest.lib;\nuse sx: uniontest.lib.X;\nfwd uniontest.lib.Y;\nuse T: uniontest.lib.Ty;\nfun f(t: T) u64 { ret lib.X + sx + Y + lib.Z; }\nfun main() i64 { ret nope; }\n";
    var needles: [7]str;
    needles[0] = "LIB REFUSED";
    needles[1] = "unresolved identifier `nope`";
    needles[2] = "unresolved";
    needles[3] = "exported";
    needles[4] = "dep set";
    needles[5] = "`sx`";
    needles[6] = "`T`";
    var counts: [7]u32;
    if (!ut_refusal_counts(lib, main, ?needles[0], ?counts[0], 7))            { ret 1; }
    if (counts[0] != 1)                                                       { ret 2; }
    if (counts[1] != 1 || counts[2] != 1)                                     { ret 3; }
    if (counts[3] != 0 || counts[4] != 0 || counts[5] != 0 || counts[6] != 0) { ret 4; }
    ret 0;
}

test a_module_refusal_is_reported_whatever_its_position {
    val lib:     str = "fwd nowhere.thing;\npub val X: u64 = 1;\n$if (1 == 1) { $if (0 == 1) { pub val Y: u64 = 2; } $or { $error(\"NESTED REFUSED\"); } }\n";
    var needles: [2]str;
    needles[0] = "NESTED REFUSED";
    needles[1] = "dep set";
    var counts: [2]u32;
    if (!ut_refusal_counts(lib, "use lib: uniontest.lib;\nfun main() i64 { ret lib.X::i64; }\n", ?needles[0], ?counts[0], 2)) { ret 1; }
    if (counts[0] != 1 || counts[1] != 0)                                                                                     { ret 2; }
    ret 0;
}

test an_unselected_module_refusal_does_not_fire {
    val lib: str = "$if (1 == 1) { pub val X: u64 = 1; }\n$or { $error(\"NOT FIRED\"); }\n$if (0 == 1) { $error(\"NOT FIRED EITHER\"); }\n";
    if (!ut_sema_clean2("use uniontest.lib;\nfun main() i64 { ret lib.X::i64; }\n", lib)) { ret 1; }
    ret 0;
}

# a module-scope gate on another module's constant, which the load decides (#3522)
fun ut_fixpoint_refusal_texts(cap: str, names: *str, texts: *str) {
    names[0] = "main.mach";
    names[1] = "b.mach";
    names[2] = "c.mach";
    names[3] = "cap.mach";
    texts[0] = "use uniontest.b;\nuse bx: uniontest.b.X;\nfun main() i64 { ret b.g() + bx + b.missing + nope; }\n";
    texts[1] = "use uniontest.cap;\n$if (cap.ON == 1) { use uniontest.c; fwd c.X; }\n$or { $error(\"B REFUSED\"); }\npub fun g() i64 { ret c.X + X; }\n";
    texts[2] = "pub val X: i64 = 1;\n";
    texts[3] = cap;
}

fun ut_fixpoint_refusal(cap: str, b: str) i32 {
    var names: [4]str;
    var texts: [4]str;
    ut_fixpoint_refusal_texts(cap, ?names[0], ?texts[0]);
    if (b != nil) { texts[1] = b; }
    var needles: [6]str;
    needles[0] = "B REFUSED";
    needles[1] = "unresolved identifier `nope`";
    needles[2] = "unresolved";
    needles[3] = "`c`";
    needles[4] = "`X`";
    needles[5] = "missing";
    var counts: [6]u32;
    if (!ut_refusal_counts_n(?names[0], ?texts[0], 4, ?needles[0], ?counts[0], 6)) { ret 1; }
    if (counts[0] != 1)                                                            { ret 2; }
    if (counts[1] != 1 || counts[2] != 1)                                          { ret 3; }
    if (counts[3] != 0 || counts[4] != 0 || counts[5] != 0)                        { ret 4; }
    ret 0;
}

test a_load_decided_module_refusal_is_its_only_diagnostic {
    ret ut_fixpoint_refusal("pub val ON: u8 = 0;\n", nil);
}

test a_load_decided_module_refusal_through_a_def_alias {
    ret ut_fixpoint_refusal("pub def flag: u8;\npub val ON: flag = 0;\n", nil);
}

test a_load_decided_true_gate_refuses_in_its_own_arm {
    ret ut_fixpoint_refusal("pub val ON: u8 = 1;\n",
        "use uniontest.cap;\n$if (cap.ON == 1) { $error(\"B REFUSED\"); }\n$or { use uniontest.c; fwd c.X; }\npub fun g() i64 { ret c.X + X; }\n");
}

test a_load_decided_selected_arm_still_builds {
    var names: [4]str;
    var texts: [4]str;
    ut_fixpoint_refusal_texts("pub def flag: u8;\npub val ON: flag = 1;\n", ?names[0], ?texts[0]);
    texts[0] = "use uniontest.b;\nfun main() i64 { ret b.g(); }\n";
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    val pr: res[project.Project, outcome.Fail] = ut_vec_sema_n(?s, ?alloc, ?names[0], ?texts[0], 4);
    if (sel pr.err) { ret 2; }
    var p: project.Project = pr.ok;
    project.dnit_project(?p);
    if (ut_count_errors(?s.diags) != 0) { ret 3; }
    ret 0;
}

val UT_DEFERRED_LIB: str = "pub val ON: u8 = 1;\npub val OFF: u8 = 0;\n";

# every unresolved name in the arm sema selects is reported exactly once, whatever position
# it sits in, and none of them as the unbound-identifier internal error (#3485)
test a_selected_deferred_arm_reports_each_unresolved_name_once {
    val main:    str = "use lib: uniontest.lib;\nrec Box[T] { v: T; }\nfun f(k: u64) u64 {\n    $if (lib.ON) {\n        var a: NoA = 0;\n        val b: u64 = k::NoB;\n        var c: Box[NoC];\n        {\n            var d: [2]NoD;\n        }\n        ret nope_e;\n    }\n    ret 0;\n}\nfun main() i64 { ret f(1)::i64; }\n";
    var needles: [7]str;
    needles[0] = "unresolved type name `NoA`";
    needles[1] = "unresolved type name `NoB`";
    needles[2] = "unresolved type name `NoC`";
    needles[3] = "unresolved type name `NoD`";
    needles[4] = "unresolved identifier `nope_e`";
    needles[5] = "internal";
    needles[6] = "unresolved";
    var counts: [7]u32;
    if (!ut_refusal_counts(UT_DEFERRED_LIB, main, ?needles[0], ?counts[0], 7)) { ret 1; }
    var i: u32 = 0;
    for (i < 5) {
        if (counts[i] != 1) { ret 10 + i::i32; }
        i = i + 1;
    }
    if (counts[5] != 0) { ret 20; }
    if (counts[6] != 5) { ret 21; }
    ret 0;
}

test a_discarded_deferred_arm_reports_nothing {
    val main: str = "use lib: uniontest.lib;\nrec Box[T] { v: T; }\nfun f(k: u64) u64 {\n    $if (lib.OFF) {\n        var a: NoA = nope;\n        var c: Box[NoC];\n        ret lib.missing;\n    }\n    $or {\n        ret k;\n    }\n    ret 0;\n}\nfun main() i64 { ret f(1)::i64; }\n";
    if (!ut_sema_clean2(main, UT_DEFERRED_LIB)) { ret 1; }
    ret 0;
}

test nested_deferred_gates_report_only_the_selected_path {
    var bad: i32 = 0;
    # outer selected, inner discarded
    if (!ut_sema_clean2("use lib: uniontest.lib;\nfun f(k: u64) u64 {\n    $if (lib.ON) {\n        $if (lib.OFF) { ret nope; }\n        $or { ret k; }\n    }\n    ret 0;\n}\nfun main() i64 { ret f(1)::i64; }\n", UT_DEFERRED_LIB)) { bad = bad | 1; }
    # outer discarded, inner selected
    if (!ut_sema_clean2("use lib: uniontest.lib;\nfun f(k: u64) u64 {\n    $if (lib.OFF) {\n        $if (lib.ON) { ret nope; }\n    }\n    ret k;\n}\nfun main() i64 { ret f(1)::i64; }\n", UT_DEFERRED_LIB)) { bad = bad | 2; }
    # both selected
    var needles: [2]str;
    needles[0] = "unresolved identifier `nope`";
    needles[1] = "internal";
    var counts: [2]u32;
    if (!ut_refusal_counts(UT_DEFERRED_LIB, "use lib: uniontest.lib;\nfun f(k: u64) u64 {\n    $if (lib.ON) {\n        $if (lib.ON) { ret nope; }\n    }\n    ret k;\n}\nfun main() i64 { ret f(1)::i64; }\n", ?needles[0], ?counts[0], 2)) { bad = bad | 4; }
    if (counts[0] != 1 || counts[1] != 0)                                                                                                                                                                                                   { bad = bad | 8; }
    ret bad;
}

test a_deferred_gate_in_a_generic_reports_once_across_instances {
    val main:    str = "use lib: uniontest.lib;\nfun g[T](x: T) T {\n    $if (lib.ON) {\n        ret nope_g;\n    }\n    ret x;\n}\nfun main() i64 {\n    val a: u64 = g[u64](1);\n    val b: i64 = g[i64](2);\n    ret b;\n}\n";
    var needles: [2]str;
    needles[0] = "unresolved identifier `nope_g`";
    needles[1] = "internal";
    var counts: [2]u32;
    if (!ut_refusal_counts(UT_DEFERRED_LIB, main, ?needles[0], ?counts[0], 2)) { ret 1; }
    if (counts[0] != 1)                                                        { ret 2; }
    if (counts[1] != 0)                                                        { ret 3; }
    val clean: str = "use lib: uniontest.lib;\nfun g[T](x: T) T {\n    $if (lib.ON) {\n        ret x;\n    }\n    ret x;\n}\nfun main() i64 {\n    val a: u64 = g[u64](1);\n    ret g[i64](2);\n}\n";
    if (!ut_sema_clean2(clean, UT_DEFERRED_LIB)) { ret 4; }
    ret 0;
}

# a statement gate only type checking decides binds beside a declaration-level gate the load
# decides on the same constant
test a_deferred_statement_gate_binds_beside_a_loaded_declaration_gate {
    val lib:  str = "pub def flag: u8;\npub val ON: flag = 1;\n";
    val main: str = "use lib: uniontest.lib;\n$if (lib.ON) { fun selected() i64 { ret 1; } }\nfun f(k: u64) u64 {\n    $if (lib.ON) {\n        var r: u64 = k;\n        ret r;\n    }\n    ret 0;\n}\nfun main() i64 { ret f(1)::i64 + selected(); }\n";
    if (!ut_sema_clean2(main, lib)) { ret 1; }
    ret 0;
}

fun ut_module_gate_state(p: *project.Project, s: *session.Session, fqn: str, cond: aid.ExprId) comptime.GateState {
    val idr: res[intern.StrId, A.Error] = intern.intern(?s.interner, fqn);
    if (sel idr.err) { ret comptime.GATE_STATE_UNKNOWN; }
    var name: intern.StrId           = idr.ok;
    val mr:   opt[*session.ModuleId] = map.get[intern.StrId, session.ModuleId](?p.by_fqn, ?name);
    if (sel mr.none) { ret comptime.GATE_STATE_UNKNOWN; }
    val mid: session.ModuleId = mr.some[0];
    ret comptime.gate_state(?project.module_at(p, mid::u32).ctx, cond);
}

test one_gate_decides_the_same_in_every_phase {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [2]str;
    names[0] = "main.mach";
    names[1] = "lib.mach";
    var texts: [2]str;
    texts[0] = "val FLAG: u8 = 1;\n$if (FLAG) { use uniontest.lib; fun picked() i32 { ret lib.value(); } } $or { use uniontest.missing; }\nfun probe[T](x: T) i32 { $if (FLAG) { ret 1; } ret 0; }\nfun main() i32 { ret picked() + probe[i32](1); }\n";
    texts[1] = "pub fun value() i32 { ret 7; }\n";

    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 2);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root:             str               = root_r.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 2;
    }
    var tsel_19516: manifest.Selection                 = ut_target_sel("linux");
    val pr:         res[project.Project, outcome.Fail] = driver.build_project(?s, root, ?tsel_19516);
    fs.remove_all(?alloc, root);
    if (sel pr.err) {
        session.dnit(?s);
        ret 3;
    }
    var p: project.Project = pr.ok;

    var bad: i32      = 0;
    val a:   *ast.Ast = ut_ast(?p, ?s, "uniontest.main");
    if (a == nil) { bad = 4; }
    val cond: aid.ExprId = ut_first_gate_cond(a);
    if (bad == 0 && cond == aid.EXPR_NIL) { bad = 5; }

    if (bad == 0 && !ut_has(?p, ?s, "uniontest.lib"))                                                 { bad = 6; }
    if (bad == 0 && ut_has(?p, ?s, "uniontest.missing"))                                              { bad = 7; }
    if (bad == 0 && ut_module_gate_state(?p, ?s, "uniontest.main", cond) != comptime.GATE_STATE_TRUE) { bad = 8; }

    if (bad == 0) {
        val se: err[outcome.Fail] = driver.run_sema_pass(?p);
        if (sel se.err)                                                                       { bad = 9; }
        or (ut_count_errors(?p.s.diags) != 0)                                                 { bad = 10; }
        or (ut_module_gate_state(?p, ?s, "uniontest.main", cond) != comptime.GATE_STATE_TRUE) { bad = 11; }
    }
    if (bad == 0) {
        val le: err[outcome.Fail] = driver.run_lower_pass(?p);
        if (sel le.err)                                                                       { bad = 12; }
        or (ut_module_gate_state(?p, ?s, "uniontest.main", cond) != comptime.GATE_STATE_TRUE) { bad = 13; }
    }

    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

test undecided_gate_is_retried_when_its_dependency_binds {
    if (ut_single_ok("$if (LATER) { fun picked() i32 { ret 3; } }\nval LATER: u8 = 1;\nfun main() i32 { ret picked(); }\n") != 0)                                     { ret 1; }
    if (ut_single_ok("$if (LATER == 1) { fun picked() i32 { ret 3; } } $or { use uniontest.missing; }\nval LATER: u8 = 1;\nfun main() i32 { ret picked(); }\n") != 0) { ret 2; }
    if (ut_single_ok2("$if (lib.LATER) { fun picked() i32 { ret 3; } }\nuse uniontest.lib;\nfun main() i32 { ret picked(); }\n", "pub val LATER: u8 = 1;\n") != 0)    { ret 3; }
    ret 0;
}

test a_gate_whose_dependency_never_binds_is_located_and_named {
    ret ut_gate_diag_located(
        "val OTHER: u8 = 1;\nfun helper() i32 { ret 0; }\n$if (NEVER_BOUND) { fun picked() i32 { ret 3; } }\nfun main() i32 { ret helper(); }\n",
        "is never decided: `NEVER_BOUND`", "main.mach", 3, 6, "NEVER_BOUND");
}

# a declaring gate reads its constants in the order they depend on each other, not the order they
# are written in: a constant declared later, one declared under a later gate, and one read through a
# later constant are all decided in the one load walk; gates that lead back to themselves are refused
test a_gate_is_decided_over_its_constants_in_demand_order {
    if (!ut_sema_clean("$if (C == 4) { pub val B: u32 = 4; }\nval C: u32 = 4;\nfun main() i32 { ret B::i32; }\n"))                                                                        { ret 1; }
    if (!ut_sema_clean("$if (D == 5) { pub val B: u32 = 4; }\nval D: u32 = C + 1;\nval C: u32 = 4;\nfun main() i32 { ret B::i32; }\n"))                                                   { ret 2; }
    if (!ut_sema_clean("$if (C == 4) { pub val B: u32 = 4; }\n$if ($mach.build.os == $mach.os.linux) { val C: u32 = 4; } $or { val C: u32 = 2 + 2; }\nfun main() i32 { ret B::i32; }\n")) { ret 3; }
    if (ut_gate_diag_located("$if (A == 4) { pub val B: u32 = 4; }\n$if (B == 4) { pub val A: u32 = 4; }\nfun main() i32 { ret 0; }\n",
        "no order decides them: `$if (A == 4)` -> `$if (B == 4)` -> `$if (A == 4)`", "main.mach", 1, 6, "A == 4") != 0) { ret 4; }
    if (ut_gate_diag_located("$if (X == 4) { pub val B: u32 = 4; }\nval X: u32 = Y;\nval Y: u32 = X;\nfun main() i32 { ret 0; }\n",
        "no order decides them: `X` -> `Y` -> `X`", "main.mach", 1, 6, "X == 4") != 0) { ret 5; }
    ret 0;
}

# the load refuses a gate it cannot decide as it refuses any other declaration: the load is rejected,
# and its report is located at the gate, with no unlocated line beside it
test an_undecidable_gate_rejects_the_load_with_no_unlocated_line {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:     session.Session = sr.ok;
    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "val OTHER: u8 = 1;\nfun helper() i32 { ret 0; }\n$if (NEVER_BOUND) { fun picked() i32 { ret 3; } }\nfun main() i32 { ret helper(); }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root:             str               = root_r.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 2;
    }
    var tsel_19625: manifest.Selection                 = ut_target_sel("linux");
    val pr:         res[project.Project, outcome.Fail] = driver.build_project(?s, root, ?tsel_19625);
    fs.remove_all(?alloc, root);

    var code: i32 = 0;
    if (sel pr.ok) {
        var p:        project.Project  = pr.ok;
        val standing: fail.PhaseStatus = driver.frontend_status(?p);
        if (sel standing.kind.accepted) { code = 3; }
        project.dnit_project(?p);
    }
    if (sel pr.err) {
        val f: outcome.Fail = pr.err;
        if (!sel f.reported) { code = 4; }
    }
    var located: bool  = false;
    var i:       usize = 0;
    for (i < diagnostic.len(?s.diags)) {
        val d: *diagnostic.Diagnostic = ?s.diags.items.data[i];
        if (ut_str_contains(d.message, "could not be resolved"))                                                      { code = 6; }
        if (d.severity == diagnostic.SEVERITY_ERROR && ut_str_contains(d.message, "is never decided: `NEVER_BOUND`")) { located = true; }
        i = i + 1;
    }
    if (!located && code == 0) { code = 7; }
    session.dnit(?s);
    ret code;
}

# a union analysis that keeps the project when only sema rejects, so the gate products it ran stay readable
fun ut_gate_rebuild_rejected(s: *session.Session, root: str, out: *project.Project) i32 {
    val pr: res[project.Project, outcome.Fail] = driver.build_project_union(s, root);
    if (sel pr.err) { ret 1; }
    @out = pr.ok;
    val se: err[outcome.Fail] = driver.run_sema_pass(out);
    if (sel se.ok) { ret 2; }
    ret 0;
}

# helper's gate reads a constant of a module it imports only after the gate, so the load walks that
# `use` on demand; main has no gate of its own, so only helper's view tells the two states apart
test a_gate_reads_a_constant_behind_a_later_use {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var names: [3]str = [3]str{"main.mach", "helper.mach", "cfg.mach"};
    var texts: [3]str = [3]str{
        "use uniontest.helper;\nfun main() i32 { ret helper.one(); }\n",
        "$if (cfg.FLAG == 1) {\n    pub fun one() i32 { ret 1; }\n}\n\nuse uniontest.cfg;\n",
        UT_VIEW_CFG_ON
    };
    var s:      session.Session;
    val root_r: res[str, fail.Fail] = ut_gate_session(?alloc, ?names[0], ?texts[0], 3, ?s);
    if (sel root_r.err) { ret 2; }
    val root: str = root_r.ok;
    fin {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
    }
    val cold: res[project.Project, outcome.Fail] = ut_gate_rebuild(?s, root);
    if (sel cold.err) { ret 3; }
    var p: project.Project = cold.ok;
    project.dnit_project(?p);
    if (ut_count_errors(?s.diags) != 0) { ret 4; }

    # the arm goes away: main's call no longer resolves
    if (!ut_write_source(?alloc, root, "cfg.mach", UT_VIEW_CFG_OFF)) { ret 5; }
    var off: project.Project;
    if (ut_gate_rebuild_rejected(?s, root, ?off) != 0) { ret 6; }
    project.dnit_project(?off);
    if (!ut_diag_has(?s.diags, "one")) { ret 7; }

    # and back: the warm build resolves it again
    if (!ut_write_source(?alloc, root, "cfg.mach", UT_VIEW_CFG_ON)) { ret 8; }
    val on: res[project.Project, outcome.Fail] = ut_gate_rebuild(?s, root);
    if (sel on.err) { ret 9; }
    p = on.ok;
    project.dnit_project(?p);
    ret 0;
}
