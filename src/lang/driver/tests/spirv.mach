}

# two entry points share a helper that draws callees in from a local module and a dependency:
# each module emits what an entry point reaches and nothing more, and a drawn-in body is not
# exported where it is drawn in, while a library module exports what it defines
test link_closure__draws_in_only_what_an_entry_point_reaches {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    val pr: res[project.Project, outcome.Fail] = ut_spv_fixture(?s, ?alloc);
    if (sel pr.err) { ret 2; }
    var p: project.Project = pr.ok;
    fin { project.dnit_project(?p); }

    var img:   of.ObjectImage;
    var fault: str = nil;
    if (!ut_spv_codegen(?p, ?s, "spvcase.main", ?img, ?fault)) { ret 3; }
    fin { obj.dnit(?img); }
    var n: u32  = 0;
    val w: *u32 = ut_spv_words(?img, ?n);
    if (w == nil)                                                                                    { ret 4; }
    if (ut_spv_count(w, n, spirv.OP_ENTRY_POINT) != 2 || ut_spv_count(w, n, spirv.OP_FUNCTION) != 6) { ret 5; }
    if (ut_spv_arity_count(w, n, 1) != 1 || ut_spv_arity_count(w, n, 2) != 1
        || ut_spv_arity_count(w, n, 3) != 1 || ut_spv_arity_count(w, n, 4) != 1) { ret 6; }
    if (ut_spv_arity_count(w, n, 5) != 0 || ut_spv_arity_count(w, n, 6) != 0) { ret 7; }
    if (!ut_spv_calls_all_resolve(w, n) || ut_spv_export_count(w, n) != 0)    { ret 8; }
    val e0: u32 = ut_spv_entry_fn(w, n, 0);
    val e1: u32 = ut_spv_entry_fn(w, n, 1);
    val i0: u32 = ut_spv_fn_index_of(w, n, e0);
    val i1: u32 = ut_spv_fn_index_of(w, n, e1);
    if (e0 == 0 || e1 == 0 || e0 == e1 || i0 == UT_SPV_NO_FN || i1 == UT_SPV_NO_FN) { ret 9; }
    val c0: u32 = ut_spv_first_callee_in(w, n, i0);
    if (c0 == 0 || c0 != ut_spv_first_callee_in(w, n, i1)) { ret 10; }

    var lib: of.ObjectImage;
    if (!ut_spv_codegen(?p, ?s, "spvcase.local", ?lib, ?fault)) { ret 11; }
    fin { obj.dnit(?lib); }
    var ln: u32  = 0;
    val lw: *u32 = ut_spv_words(?lib, ?ln);
    if (lw == nil) { ret 12; }
    if (ut_spv_count(lw, ln, spirv.OP_FUNCTION) != 2 || ut_spv_arity_count(lw, ln, 5) != 1
        || ut_spv_export_count(lw, ln) != 2) { ret 13; }

    var dep: of.ObjectImage;
    if (!ut_spv_codegen(?p, ?s, "shlib.tone", ?dep, ?fault)) { ret 14; }
    fin { obj.dnit(?dep); }
    var dn: u32  = 0;
    val dw: *u32 = ut_spv_words(?dep, ?dn);
    if (dw == nil) { ret 15; }
    if (ut_spv_count(dw, dn, spirv.OP_ENTRY_POINT) != 0 || ut_spv_count(dw, dn, spirv.OP_FUNCTION) != 3
        || ut_spv_arity_count(dw, dn, 4) != 1) { ret 16; }
    if (ut_spv_export_count(dw, dn) != 2 || !ut_spv_calls_all_resolve(dw, dn)) { ret 17; }
    ret 0;
}

test link_closure__refuses_recursion_drawn_in_from_another_module {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [2]str;
    var texts: [2]str;
    names[0] = "main.mach";
    texts[0] = "use h: spvcase.helper;\n\n#[input(0)]  var in_n:  i32;\n#[output(0)] var out_n: i32;\n\n#[stage(\"vertex\")]\nfun vert_main() { out_n = h.step(in_n); }\n\nfun main() i32 { ret 0; }\n";
    names[1] = "helper.mach";
    texts[1] = "#[builtin(\"position\")] var position: f32x4;\n\n#[stage(\"vertex\")]\nfun pass() { position = f32x4{0.0, 0.0, 0.0, 1.0}; }\n\n#[noinline]\npub fun step(n: i32) i32 {\n    if (n <= 1) { ret 1; }\n    ret n * step(n - 1);\n}\n";
    var dn: [1]str;
    var dt: [1]str;
    val pr: res[project.Project, outcome.Fail] = ut_spv_lower(?s, ?alloc, ?names[0], ?texts[0], 2, "", ?dn[0], ?dt[0], 0);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    var bad:   i32 = 0;
    var img:   of.ObjectImage;
    var fault: str = nil;

    if (!ut_spv_codegen(?p, ?s, "spvcase.helper", ?img, ?fault)) { bad = 1; }
    or                                                           { obj.dnit(?img); }

    var img2: of.ObjectImage;
    var err2: str = nil;
    if (ut_spv_codegen(?p, ?s, "spvcase.main", ?img2, ?err2)) {
        bad = 1;
        obj.dnit(?img2);
    }
    or {
        if (err2 == nil) { bad = 1; }
        or {
            if (!ut_str_contains(err2, "cycle"))                                      { bad = 1; }
            if (!ut_str_contains(err2, "has no call stack"))                          { bad = 1; }
            if (!ut_str_contains(err2, "spvcase.helper.step -> spvcase.helper.step")) { bad = 1; }
        }
    }

    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

# a call to an `ext` function is refused by name, as a located error at the call site in `vs`
test ext_call__refused_by_name_at_the_call_site {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }

    var names: [1]str;
    var texts: [1]str;
    names[0] = "main.mach";
    texts[0] = "ext fun host_sqrtf(x: u32) u32;\n\n#[output(0)] var o: u32;\n\n#[stage(\"vertex\")]\nfun vs() {\n    o = host_sqrtf(1);\n}\n\nfun main() i32 { ret 0; }\n";
    val pr: res[project.Project, outcome.Fail] = ut_spv_lower(?s, ?alloc, ?names[0], ?texts[0], 1, "", nil, nil, 0);
    if (sel pr.err) { ret 2; }
    var p: project.Project = pr.ok;
    fin { project.dnit_project(?p); }

    var img:   of.ObjectImage;
    var fault: str = nil;
    if (ut_spv_codegen(?p, ?s, "spvcase.main", ?img, ?fault)) {
        obj.dnit(?img);
        ret 3;
    }
    if (fault == nil) { ret 4; }
    if (!ut_str_contains(fault, "host_sqrtf") || !ut_str_contains(fault, "declared `ext`")
        || !ut_str_contains(fault, "self-contained")) { ret 5; }
    if (ut_str_contains(fault, "defined outside the module"))    { ret 6; }
    if (!ut_str_contains(fault, "(in `vs`)"))                    { ret 7; }
    if (!ut_diag_located_at(?s, "(in `vs`)", "main.mach", 7, 9)) { ret 8; }
    ret 0;
}

#[testing]
fun ut_spv_decorated_id(w: *u32, n: u32, decor: u32, value: u32) u32 {
    var i: u32 = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0) { ret 0; }
        if ((w[i] & 0xFFFF) == spirv.OP_DECORATE && len >= 4
            && w[i + 2] == decor && w[i + 3] == value) { ret w[i + 1]; }
        i = i + len;
    }
    ret 0;
}

#[testing]
fun ut_spv_decor_count(w: *u32, n: u32, decor: u32) u32 {
    var i: u32 = 0;
    var c: u32 = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0)                                                              { ret c; }
        if ((w[i] & 0xFFFF) == spirv.OP_DECORATE && len >= 3 && w[i + 2] == decor) { c = c + 1; }
        i = i + len;
    }
    ret c;
}

#[testing]
fun ut_spv_descriptor_var(w: *u32, n: u32, set: u32, bind: u32) u32 {
    var i: u32 = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0) { ret 0; }
        if ((w[i] & 0xFFFF) == spirv.OP_DECORATE && len >= 4
            && w[i + 2] == spirv.DECOR_DESCRIPTOR_SET && w[i + 3] == set) {
            val cand: u32 = w[i + 1];
            var j:    u32 = 0;
            for (j < n) {
                val jl: u32 = w[j] >> 16;
                if (jl == 0) {
                    j = n;
                    cnt;
                }
                if ((w[j] & 0xFFFF) == spirv.OP_DECORATE && jl >= 4 && w[j + 1] == cand
                    && w[j + 2] == spirv.DECOR_BINDING && w[j + 3] == bind) { ret cand; }
                j = j + jl;
            }
        }
        i = i + len;
    }
    ret 0;
}

#[testing]
fun ut_spv_entry_iface_has(w: *u32, n: u32, k: u32, id: u32) bool {
    var i:    u32 = 0;
    var seen: u32 = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0) { ret false; }
        if ((w[i] & 0xFFFF) == spirv.OP_ENTRY_POINT) {
            if (seen == k) {
                var j:     u32  = i + 3;
                var ended: bool = false;
                for (j < i + len && !ended) {
                    if ((w[j] & 0xFF000000) == 0 || (w[j] & 0x00FF0000) == 0
                        || (w[j] & 0x0000FF00) == 0 || (w[j] & 0x000000FF) == 0) { ended = true; }
                    j = j + 1;
                }
                for (j < i + len) {
                    if (w[j] == id) { ret true; }
                    j = j + 1;
                }
                ret false;
            }
            seen = seen + 1;
        }
        i = i + len;
    }
    ret false;
}

#[testing]
fun ut_spv_iface_lib_src() str {
    ret "rec Used   { a: f32; b: f32; c: f32; d: f32; }\nrec Unused { a: f32; b: f32; c: f32; d: f32; }\n\n#[uniform(0, 0)] pub var used_cam:   Used;\n#[uniform(0, 3)] pub var unused_cam: Unused;\n#[input(6)]      pub var lib_in:     f32;\n#[input(7)]      pub var unused_in:  f32;\n\n#[noinline]\npub fun touch_used(v: f32) f32 { ret v * used_cam.a + lib_in; }\n\n#[noinline]\npub fun touch_nothing(v: f32) f32 { ret v * 2.0; }\n\n#[noinline]\npub fun never_called(v: f32) f32 { ret v * unused_cam.a + unused_in; }\n";
}

#[testing]
fun ut_spv_iface_root_src() str {
    ret "use l: spvcase.ilib;\n\n#[input(0)]  var in_x:  f32;\n#[output(0)] var out_a: f32;\n#[output(1)] var out_b: f32;\n\n#[stage(\"vertex\")]\nfun vert_main() { out_a = l.touch_used(in_x); }\n\n#[stage(\"fragment\")]\nfun frag_main() { out_b = l.touch_nothing(in_x); }\n\nfun main() i32 { ret 0; }\n";
}

#[testing]
fun ut_spv_iface_fixture(s: *session.Session, alloc: *A.Allocator) res[project.Project, outcome.Fail] {
    var names: [2]str;
    var texts: [2]str;
    names[0] = "main.mach";
    texts[0] = ut_spv_iface_root_src();
    names[1] = "ilib.mach";
    texts[1] = ut_spv_iface_lib_src();
    var dn: [1]str;
    var dt: [1]str;
    ret ut_spv_lower(s, alloc, ?names[0], ?texts[0], 2, "", ?dn[0], ?dt[0], 0);
}

# interface globals a library module declares follow reachability: the entry module emits the
# ones its stages reach, each entry point lists only what it reaches, and the library itself
# still emits and exports every one
test interface__globals_follow_reachability_across_modules {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    val pr: res[project.Project, outcome.Fail] = ut_spv_iface_fixture(?s, ?alloc);
    if (sel pr.err) { ret 2; }
    var p: project.Project = pr.ok;
    fin { project.dnit_project(?p); }

    var img:   of.ObjectImage;
    var fault: str = nil;
    if (!ut_spv_codegen(?p, ?s, "spvcase.main", ?img, ?fault)) { ret 3; }
    fin { obj.dnit(?img); }
    var n: u32  = 0;
    val w: *u32 = ut_spv_words(?img, ?n);
    if (w == nil) { ret 4; }
    val cam: u32 = ut_spv_descriptor_var(w, n, 0, 0);
    val lin: u32 = ut_spv_decorated_id(w, n, spirv.DECOR_LOCATION, 6);
    val ob:  u32 = ut_spv_decorated_id(w, n, spirv.DECOR_LOCATION, 1);
    if (cam == 0 || lin == 0 || ob == 0 || ut_spv_decorated_id(w, n, spirv.DECOR_LOCATION, 0) == 0) { ret 5; }
    if (!ut_spv_calls_all_resolve(w, n) || ut_spv_export_count(w, n) != 0)                          { ret 6; }
    if (ut_spv_descriptor_var(w, n, 0, 3) != 0 || ut_spv_decorated_id(w, n, spirv.DECOR_LOCATION, 7) != 0
        || ut_spv_decor_count(w, n, spirv.DECOR_DESCRIPTOR_SET) != 1) { ret 7; }
    var vx: u32 = 0;
    if (ut_spv_entry_iface_has(w, n, 0, ob)) { vx = 1; }
    val fx: u32 = 1 - vx;
    if (!ut_spv_entry_iface_has(w, n, vx, cam) || !ut_spv_entry_iface_has(w, n, vx, lin)) { ret 8; }
    if (ut_spv_entry_iface_has(w, n, fx, cam) || ut_spv_entry_iface_has(w, n, fx, lin))   { ret 9; }
    if (!ut_spv_entry_iface_has(w, n, fx, ob))                                            { ret 10; }

    var lib: of.ObjectImage;
    if (!ut_spv_codegen(?p, ?s, "spvcase.ilib", ?lib, ?fault)) { ret 11; }
    fin { obj.dnit(?lib); }
    var ln: u32  = 0;
    val lw: *u32 = ut_spv_words(?lib, ?ln);
    if (lw == nil) { ret 12; }
    if (ut_spv_descriptor_var(lw, ln, 0, 0) == 0 || ut_spv_descriptor_var(lw, ln, 0, 3) == 0
        || ut_spv_decorated_id(lw, ln, spirv.DECOR_LOCATION, 7) == 0) { ret 13; }
    if (ut_spv_export_count(lw, ln) != 3) { ret 14; }
    ret 0;
}

# a built-in used by a stage its execution model does not define it in is refused naming the
# built-in and both stages, and its own stages accept it. `own` 3 is every stage
#[testing]
rec UtBiCase {
    name: str;
    ty:   str;
    use:  str;
    own:  usize;
    only: str;
}

#[testing]
val UT_BUILTINS: [14]UtBiCase = [14]UtBiCase{
    UtBiCase{name: "position", ty: "f32x4", use: "b = sink.f;", own: 0, only: "only as an output of a vertex stage"},
    UtBiCase{name: "point_size", ty: "f32", use: "b = sink.f[0];", own: 0, only: "only as an output of a vertex stage"},
    UtBiCase{name: "vertex_index", ty: "u32", use: "sink.u = b;", own: 0, only: "only in a vertex stage"},
    UtBiCase{name: "instance_index", ty: "u32", use: "sink.u = b;", own: 0, only: "only in a vertex stage"},
    UtBiCase{name: "frag_coord", ty: "f32x4", use: "sink.f = b;", own: 1, only: "only in a fragment stage"},
    UtBiCase{name: "global_invocation", ty: "u32x3", use: "sink.u = b[0];", own: 2, only: "only in a compute stage"},
    UtBiCase{name: "local_invocation", ty: "u32x3", use: "sink.u = b[1];", own: 2, only: "only in a compute stage"},
    UtBiCase{name: "workgroup_id", ty: "u32x3", use: "sink.u = b[2];", own: 2, only: "only in a compute stage"},
    UtBiCase{name: "num_workgroups", ty: "u32x3", use: "sink.u = b[0];", own: 2, only: "only in a compute stage"},
    UtBiCase{name: "local_invocation_index", ty: "u32", use: "sink.u = b;", own: 2, only: "only in a compute stage"},
    UtBiCase{name: "subgroup_size", ty: "u32", use: "sink.u = b;", own: 3, only: ""},
    UtBiCase{name: "subgroup_invocation", ty: "u32", use: "sink.u = b;", own: 3, only: ""},
    UtBiCase{name: "subgroup_id", ty: "u32", use: "sink.u = b;", own: 2, only: "only in a compute stage"},
    UtBiCase{name: "num_subgroups", ty: "u32", use: "sink.u = b;", own: 2, only: "only in a compute stage"}
};

# indexed by UtBiCase.own
#[testing]
val UT_STAGES: [3]str = [3]str{"vertex", "fragment", "compute"};

#[testing]
fun ut_spv_builtin_stage_case(alloc: *A.Allocator, c: *UtBiCase, sx: usize) i32 {
    val stage: str                             = UT_STAGES[sx];
    val sr:    res[session.Session, fail.Fail] = session.init(alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    val rt: res[str, format.FormatError] = format.sprint(alloc,
        "rec Sink {{ f: f32x4; u: u32; }}\n#[storage(0, 0)] var sink: Sink;\n#[builtin(\"{}\")] var b: {};\n\n#[stage(\"{}\")]\nfun st() {{ {} }}\n\nfun main() i32 {{ ret 0; }}\n",
        c.name, c.ty, stage, c.use);
    if (sel rt.err) { ret 2; }
    var names: [1]str                             = [1]str{"main.mach"};
    var texts: [1]str                             = [1]str{rt.ok};
    val pr:    res[project.Project, outcome.Fail] = ut_spv_lower(?s, alloc, ?names[0], ?texts[0], 1, "", nil, nil, 0);
    if (sel pr.err) { ret 3; }
    var p: project.Project = pr.ok;
    fin { project.dnit_project(?p); }

    var img:   of.ObjectImage;
    var fault: str  = nil;
    val ok:    bool = ut_spv_codegen(?p, ?s, "spvcase.main", ?img, ?fault);
    if (ok) { obj.dnit(?img); }
    if (sx == c.own || c.own == 3) {
        if (!ok) {
            if (fault != nil) { print.eprintlnf("{}", fault); }
            ret 4;
        }
        ret 0;
    }
    if (ok) { ret 5; }
    val tag: res[str, format.FormatError] = format.sprint(alloc, "{} stage `st`", stage);
    if (sel tag.err) { ret 6; }
    if (fault == nil || !ut_str_contains(fault, c.name) || !ut_str_contains(fault, tag.ok)
        || !ut_str_contains(fault, c.only)) { ret 7; }
    ret 0;
}

test builtin__each_is_refused_outside_its_stage {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var i: usize = 0;
    for (i < 14) {
        var j: usize = 0;
        for (j < 3) {
            val r: i32 = ut_spv_builtin_stage_case(?alloc, ?UT_BUILTINS[i], j);
            if (r != 0) {
                print.eprintlnf("built-in {} in a {} stage: case failed with {}", UT_BUILTINS[i].name, UT_STAGES[j], r);
                ret 10 + r;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    ret 0;
}

# two modules' descriptors at one set and binding are refused naming both, at distinct bindings
# they are two variables
#[testing]
fun ut_spv_binding_case(alloc: *A.Allocator, libb_binding: str, collide: bool) i32 {
    val sr: res[session.Session, fail.Fail] = session.init(alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var names: [3]str;
    var texts: [3]str;
    names[0] = "main.mach";
    texts[0] = "use a: spvcase.liba;\nuse b: spvcase.libb;\n\n#[input(0)]  var in_x:  f32;\n#[output(0)] var out_a: f32;\n\n#[stage(\"vertex\")]\nfun vert_main() { out_a = a.from_a(in_x) + b.from_b(in_x); }\n\nfun main() i32 { ret 0; }\n";
    names[1] = "liba.mach";
    texts[1] = "rec CamA { x: f32; y: f32; z: f32; w: f32; }\n#[uniform(0, 0)] pub var cam_a: CamA;\n\n#[noinline]\npub fun from_a(v: f32) f32 { ret v * cam_a.x; }\n";
    names[2] = "libb.mach";
    texts[2] = ut_cc3(alloc, "rec CamB { p: f32; q: f32; r: f32; s: f32; }\n#[uniform(", libb_binding, ")] pub var cam_b: CamB;\n\n#[noinline]\npub fun from_b(v: f32) f32 { ret v * cam_b.p; }\n");
    val pr: res[project.Project, outcome.Fail] = ut_spv_lower(?s, alloc, ?names[0], ?texts[0], 3, "", nil, nil, 0);
    if (sel pr.err) { ret 2; }
    var p: project.Project = pr.ok;
    fin { project.dnit_project(?p); }

    var img:   of.ObjectImage;
    var fault: str = nil;
    if (collide) {
        var la: of.ObjectImage;
        if (!ut_spv_codegen(?p, ?s, "spvcase.liba", ?la, ?fault)) { ret 3; }
        obj.dnit(?la);
        if (ut_spv_codegen(?p, ?s, "spvcase.main", ?img, ?fault)) {
            obj.dnit(?img);
            ret 4;
        }
        if (fault == nil || !ut_str_contains(fault, "set = 0, binding = 0")
            || !ut_str_contains(fault, "spvcase.liba") || !ut_str_contains(fault, "spvcase.libb")) { ret 5; }
        ret 0;
    }
    if (!ut_spv_codegen(?p, ?s, "spvcase.main", ?img, ?fault)) { ret 6; }
    fin { obj.dnit(?img); }
    var n: u32  = 0;
    val w: *u32 = ut_spv_words(?img, ?n);
    if (w == nil) { ret 7; }
    val va: u32 = ut_spv_descriptor_var(w, n, 0, 0);
    val vb: u32 = ut_spv_descriptor_var(w, n, 0, 1);
    if (va == 0 || vb == 0 || va == vb)                            { ret 8; }
    if (ut_spv_decor_count(w, n, spirv.DECOR_DESCRIPTOR_SET) != 2) { ret 9; }
    ret 0;
}

test descriptor__bindings_across_modules_collide_or_coexist {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val collide: i32 = ut_spv_binding_case(?alloc, "0, 0", true);
    if (collide != 0) { ret 10 + collide; }
    val apart: i32 = ut_spv_binding_case(?alloc, "0, 1", false);
    if (apart != 0) { ret 20 + apart; }
    ret 0;
}

#[testing]
fun ut_spv_has_bare_decor(w: *u32, n: u32, id: u32, decor: u32) bool {
    var i: u32 = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0) { ret false; }
        if ((w[i] & 0xFFFF) == spirv.OP_DECORATE && len == 3
            && w[i + 1] == id && w[i + 2] == decor) { ret true; }
        i = i + len;
    }
    ret false;
}

#[testing]
fun ut_spv_nonwritable_src() str {
    ret "rec P { c: [8]f32x4; }\n\n#[storage(0, 3)] var ro: P;\n#[storage(0, 4)] var rw: P;\n#[storage(0, 5, \"readonly\")] var ro_marked: P;\n\n#[input(0)] var in_x: f32x4;\n#[builtin(\"position\")] var position: f32x4;\n\n#[stage(\"vertex\")]\nfun vert_main() {\n    rw.c[1] = in_x;\n    position = ro.c[2] + rw.c[3] + ro_marked.c[4];\n}\n";
}

test storage__unwritten_binding_is_nonwritable {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    var texts: [1]str;
    names[0] = "main.mach";
    texts[0] = ut_spv_nonwritable_src();
    var dn: [1]str;
    var dt: [1]str;
    val pr: res[project.Project, outcome.Fail] = ut_spv_lower(?s, ?alloc, ?names[0], ?texts[0], 1, "", ?dn[0], ?dt[0], 0);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    var bad:   i32 = 0;
    var img:   of.ObjectImage;
    var fault: str = nil;
    if (!ut_spv_codegen(?p, ?s, "spvcase.main", ?img, ?fault)) {
        project.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }
    var n: u32  = 0;
    val w: *u32 = ut_spv_words(?img, ?n);
    if (w == nil) {
        obj.dnit(?img);
        project.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }

    val ro: u32 = ut_spv_descriptor_var(w, n, 0, 3);
    val rw: u32 = ut_spv_descriptor_var(w, n, 0, 4);
    val mk: u32 = ut_spv_descriptor_var(w, n, 0, 5);
    if (ro == 0 || rw == 0 || mk == 0) { bad = 1; }
    or {
        if (!ut_spv_has_bare_decor(w, n, ro, spirv.DECOR_NON_WRITABLE)) { bad = 1; }
        if (ut_spv_has_bare_decor(w, n, rw, spirv.DECOR_NON_WRITABLE))  { bad = 1; }
        if (!ut_spv_has_bare_decor(w, n, mk, spirv.DECOR_NON_WRITABLE)) { bad = 1; }
    }

    obj.dnit(?img);
    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

# a `readonly` storage binding refuses a store, and the qualifier is checked on `storage` and refused on `uniform`
test storage__readonly_qualifier_is_checked {
    if (!ut_sema_rejects_with("rec P { c: [8]f32x4; }\n\n#[storage(0, 3, \"readonly\")] var ro: P;\n\nfun poke(v: f32x4) { ro.c[1] = v; }\n\nfun main() i32 { ret 0; }\n",
        "cannot store through a `#[storage(set, binding, \"readonly\")]` binding")) { ret 1; }
    if (ut_sema_rejects_with("rec P { c: [8]f32x4; }\n\n#[storage(0, 3)] var rw: P;\n\nfun poke(v: f32x4) { rw.c[1] = v; }\n\nfun main() i32 { ret 0; }\n",
        "cannot store through")) { ret 2; }
    if (!ut_sema_rejects_with("rec P { c: [8]f32x4; }\n\n#[storage(0, 3, \"readonlyy\")] var ro: P;\n\nfun main() i32 { ret 0; }\n",
        "unknown `storage` memory qualifier")) { ret 3; }
    if (!ut_sema_rejects_with("rec P { c: [8]f32x4; }\n\n#[uniform(0, 3, \"readonly\")] var u: P;\n\nfun main() i32 { ret 0; }\n",
        "takes two arguments")) { ret 4; }
    ret 0;
}

# a `writeonly` binding refuses a read at the name that reads it, while a store into it and its address are no read
test storage__writeonly_qualifier_refuses_a_read {
    if (!ut_sema_rejects_at("rec P { c: [8]f32x4; n: u32; }\n\n#[storage(0, 3, \"writeonly\")] var wo: P;\n\nfun peek() f32x4 { ret wo.c[1]; }\n\nfun main() i32 { ret 0; }\n",
        "cannot read a `#[storage(set, binding, \"writeonly\")]` binding", 97, 2)) { ret 1; }
    if (!ut_sema_rejects_with("rec P { c: [8]f32x4; n: u32; }\n\n#[storage(0, 3, \"writeonly\")] var wo: P;\n\nfun poke(v: f32x4) { wo.c[wo.n] = v; }\n\nfun main() i32 { ret 0; }\n",
        "cannot read a `#[storage(set, binding, \"writeonly\")]` binding")) { ret 2; }
    if (!ut_sema_rejects_with("rec P { v: f32x4; }\n\n#[storage(0, 3, \"writeonly\")] var wo: P;\n\nfun poke() { wo.v[1] = 2.0; }\n\nfun main() i32 { ret 0; }\n",
        "cannot write one lane of a vector in a `#[storage(set, binding, \"writeonly\")]` binding")) { ret 6; }
    if (ut_sema_rejects_with("rec P { c: [8]f32x4; n: u32; }\n\n#[storage(0, 3, \"writeonly\")] var wo: P;\n\nfun fill(p: *f32x4, v: f32x4) { @p = v; }\n\nfun poke(v: f32x4, i: u32) { wo.c[i] = v; wo.n = i; fill(?wo.c[0], v); }\n\nfun main() i32 { ret 0; }\n",
        "cannot read")) { ret 3; }
    if (!ut_sema_rejects_with("rec P { c: [8]f32x4; }\n\n#[storage(0, 3, \"readonly\", \"writeonly\")] var both: P;\n\nfun main() i32 { ret 0; }\n",
        "`\"readonly\"` and `\"writeonly\"` together")) { ret 4; }
    if (ut_sema_rejects("rec P { c: [8]f32x4; }\n\n#[storage(0, 3, \"coherent\")] var co: P;\n#[storage(0, 4, \"writeonly\", \"coherent\")] var wc: P;\n\nfun poke(v: f32x4) { co.c[1] = co.c[0] + v; wc.c[1] = v; }\n\nfun main() i32 { ret 0; }\n")) { ret 5; }
    ret 0;
}

# `writeonly` decorates its variable `NonReadable`, and a compute stage using each qualifier
# validates. a module naming no environment takes the Vulkan memory model, where `coherent`
# is no decoration (#4308)
test storage__writeonly_and_coherent_qualify_a_compute_stage {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var img:   of.ObjectImage;
    var fault: str = nil;
    if (ut_l6_module(?alloc, "rec In { v: [4]f32x4; }\nrec Out { v: [4]f32x4; n: u32; }\nrec Acc { total: u32; }\n\n#[storage(0, 0, \"readonly\")] var src_buf: In;\n#[storage(0, 1, \"writeonly\")] var dst_buf: Out;\n#[storage(0, 2, \"coherent\")] var acc_buf: Acc;\n#[builtin(\"global_invocation\")] var gid: u32x3;\n\n#[stage(\"compute\")]\n#[workgroup(4, 1, 1)]\nfun kmain() {\n    val i: u32 = gid[0];\n    dst_buf.v[i] = src_buf.v[i];\n    dst_buf.n = i;\n    acc_buf.total = acc_buf.total + i;\n}\n\nfun main() i32 { ret 0; }\n", false, ?img, ?fault) != 0) {
        if (fault != nil) { print.eprintlnf("{}", fault); }
        ret 2;
    }
    fin { obj.dnit(?img); }
    if (!ut_l6_validates(?img)) { ret 3; }
    var n: u32  = 0;
    val w: *u32 = ut_spv_words(?img, ?n);
    if (w == nil) { ret 4; }
    val ro: u32 = ut_spv_descriptor_var(w, n, 0, 0);
    val wo: u32 = ut_spv_descriptor_var(w, n, 0, 1);
    val co: u32 = ut_spv_descriptor_var(w, n, 0, 2);
    if (ro == 0 || wo == 0 || co == 0)                                                                                       { ret 5; }
    if (!ut_spv_has_bare_decor(w, n, wo, spirv.DECOR_NON_READABLE) || ut_spv_has_bare_decor(w, n, wo, spirv.DECOR_COHERENT)) { ret 6; }
    if (ut_spv_has_bare_decor(w, n, co, spirv.DECOR_COHERENT) || ut_spv_has_bare_decor(w, n, co, spirv.DECOR_NON_READABLE))  { ret 7; }
    if (ut_spv_has_bare_decor(w, n, ro, spirv.DECOR_NON_READABLE) || ut_spv_has_bare_decor(w, n, ro, spirv.DECOR_COHERENT))  { ret 8; }
    var dis: str = nil;
    if (ut_l6_external(?alloc, ?img, "vulkan1.3", ?dis) == 2) { ret 9; }
    ret 0;
}

#[testing]
val UT_VMM_PRELUDE: str = "#[handle(\"spirv\", \"image\", 2, 1, 0, 0, 0, 2, 33)]\npub def Counts;\n#[op(\"spirv\", \"core\", \"OpImageRead\")] fun texel_read(img: Counts, at: i32x2) u32x4;\n#[op(\"spirv\", \"core\", \"OpImageWrite\")] fun texel_write(img: Counts, at: i32x2, texel: u32x4);\n#[op(\"spirv\", \"core\", \"OpControlBarrier\")] fun barrier(exec: u32, mem: u32, sem: u32);\n#[op(\"spirv\", \"core\", \"OpMemoryBarrier\")] fun memory_barrier(mem: u32, sem: u32);\n#[op(\"spirv\", \"core\", \"OpAtomicIAdd\")] fun atomic_add(p: *u32, scope: u32, sem: u32, v: u32) u32;\n#[op(\"spirv\", \"core\", \"OpAtomicLoad\")] fun atomic_load(p: *u32, scope: u32, sem: u32) u32;\n#[op(\"spirv\", \"core\", \"OpAtomicStore\")] fun atomic_store(p: *u32, scope: u32, sem: u32, v: u32);\nval DEVICE: u32 = 1;\nval WORKGROUP: u32 = 2;\nval QUEUE_FAMILY: u32 = 5;\nrec Cells { v: [64]u32; flag: u32; }\n#[storage(0, 0, \"coherent\")] var cells: Cells;\n#[storage(0, 1, \"coherent\")] var counts: Counts;\n#[shared] var tile: [64]u32;\n#[builtin(\"local_invocation_index\")] var lid: u32;\n";

# a compute stage sharing a coherent buffer, a coherent storage image and workgroup memory
# across invocations, through barriers and acquire and release atomics
#[testing]
val UT_VMM_STAGE: str = "#[stage(\"compute\")]\n#[workgroup(64, 1, 1)]\nfun cs() {\n    val i: u32 = lid;\n    tile[i] = cells.v[i];\n    barrier(WORKGROUP, WORKGROUP, 0x148);\n    cells.v[i] = tile[63 - i];\n    memory_barrier(WORKGROUP, 0x48);\n    atomic_store(?cells.flag, WORKGROUP, 0x44, 1);\n    val seen: u32 = atomic_load(?cells.flag, WORKGROUP, 0x42);\n    atomic_add(?tile[0], WORKGROUP, 0x108, seen);\n    val at: i32x2 = i32x2{i::i32, 0};\n    texel_write(counts, at, texel_read(counts, at));\n}\n";

# what a module says about its memory model: the model, the Coherent decorations, the
# loads and stores making their pointer visible or available, the image reads and writes
# doing the same for their texels, and whether it declares the model's extension and the
# device-scope capability
#[testing]
rec UtVmm {
    model:         u32;
    coherent:      u32;
    visible:       u32;
    available:     u32;
    texel_visible: u32;
    texel_avail:   u32;
    extension:     bool;
    device_scope:  bool;
}

#[testing]
fun ut_vmm_scan(w: *u32, n: u32) UtVmm {
    var v: UtVmm;
    v.coherent     = ut_spv_decor_count(w, n, spirv.DECOR_COHERENT);
    v.extension    = ut_spv_count(w, n, spirv.OP_EXTENSION) != 0;
    v.device_scope = ut_spv_has_cap(w, n, spirv.CAP_VULKAN_MEMORY_MODEL_DEVICE_SCOPE);
    var i: u32 = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        val op:  u32 = w[i] & 0xFFFF;
        if (len == 0)                                                                                             { ret v; }
        if (op == spirv.OP_MEMORY_MODEL && len == 3)                                                              { v.model = w[i + 2]; }
        if (op == spirv.OP_LOAD && len >= 5 && (w[i + 4] & spirv.MEMORY_ACCESS_MAKE_POINTER_VISIBLE) != 0)        { v.visible = v.visible + 1; }
        if (op == spirv.OP_STORE && len >= 4 && (w[i + 3] & spirv.MEMORY_ACCESS_MAKE_POINTER_AVAILABLE) != 0)     { v.available = v.available + 1; }
        if (op == spirv.OP_IMAGE_READ && len >= 6 && (w[i + 5] & defs.IMAGE_OPERANDS_MAKE_TEXEL_VISIBLE) != 0)    { v.texel_visible = v.texel_visible + 1; }
        if (op == spirv.OP_IMAGE_WRITE && len >= 5 && (w[i + 4] & defs.IMAGE_OPERANDS_MAKE_TEXEL_AVAILABLE) != 0) { v.texel_avail = v.texel_avail + 1; }
        i = i + len;
    }
    ret v;
}

# builds UT_VMM_PRELUDE and `stage` under `env_line` and either expects `needle` in the
# refusal, located at `line` and `col` of the stage when `line` is not 0, or, with an empty
# needle, a module that validates under `target_env`, scanned into `out`
#[testing]
fun ut_vmm_module(alloc: *A.Allocator, stage: str, env_line: str, target_env: str, needle: str, line: usize, col: usize, out: *UtVmm) i32 {
    val sr: res[session.Session, fail.Fail] = session.init(alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) { ret 1; }
    val src: res[str, format.FormatError] = format.sprint(alloc, "{}{}", UT_VMM_PRELUDE, stage);
    if (sel src.err) { ret 1; }
    var names:  [1]str              = [1]str{"k.mach"};
    var texts:  [1]str              = [1]str{src.ok};
    val root_r: res[str, fail.Fail] = ut_scaffold_m(alloc, ut_spirv_env_manifest(alloc, env_line), ?names[0], ?texts[0], 1);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    fin { fs.remove_all(alloc, root); }
    var pick: manifest.Selection                 = ut_target_sel("gpu");
    val pr:   res[project.Project, outcome.Fail] = driver.build_project_sel(?s, root, ?pick);
    if (sel pr.err) { ret 2; }
    var p: project.Project = pr.ok;
    fin { project.dnit_project(?p); }
    val run_sema_pass_r: err[outcome.Fail] = driver.run_sema_pass(?p);
    if (sel run_sema_pass_r.err) { ret 3; }
    val run_lower_pass_r: err[outcome.Fail] = driver.run_lower_pass(?p);
    if (sel run_lower_pass_r.err) { ret 3; }
    val ce: err[outcome.Fail] = driver.run_codegen_pass(?p);
    if (!str_empty(needle)) {
        if (sel ce.ok) { ret 4; }
        if (!ut_str_contains(ut_codegen_outcome_text(?s, ce.err), needle)) {
            print.eprintlnf("{}", ut_codegen_outcome_text(?s, ce.err));
            ret 5;
        }
        var lines: usize = 0;
        var c:     usize = 0;
        for (c < str_len(UT_VMM_PRELUDE)) {
            if (UT_VMM_PRELUDE[c] == '\n') { lines = lines + 1; }
            c = c + 1;
        }
        if (line != 0 && !ut_diag_located_at(?s, needle, "k.mach", lines + line, col)) { ret 11; }
        ret 0;
    }
    if (sel ce.err) {
        print.eprintlnf("{}", ut_codegen_outcome_text(?s, ce.err));
        ret 6;
    }
    val mid: session.ModuleId = ut_mid(?p, ?s, "envtest.k");
    if (mid == session.MODULE_NIL) { ret 7; }
    val m: *project.ModuleEntry = project.module_at(?p, mid::u32);
    if (m.object_image == nil || !ut_l6_validates(m.object_image)) { ret 8; }
    var n: u32  = 0;
    val w: *u32 = ut_spv_words(m.object_image, ?n);
    if (w == nil || n == 0) { ret 9; }
    @out = ut_vmm_scan(w, n);
    var dis: str = nil;
    if (ut_l6_external(alloc, m.object_image, target_env, ?dis) == 2) { ret 10; }
    ret 0;
}

# GLSL450 holds below the memory model feature, decorating coherent bindings. the Vulkan
# model is selected where the target holds the feature: named on vulkan1.1 or vulkan1.2,
# guaranteed by vulkan1.3. under it no binding is decorated Coherent, coherent and
# workgroup accesses carry their availability and visibility, and the extension is declared
# below SPIR-V 1.5. vulkan1.0's SPIR-V 1.0 predates the model (#4308)
test vulkan_memory_model__selected_by_the_environment_and_the_declared_feature {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var v: UtVmm;
    var r: i32 = ut_vmm_module(?alloc, UT_VMM_STAGE, "env = \"vulkan1.2\"\n", "vulkan1.2", "", 0, 0, ?v);
    if (r != 0)                                                                                                                              { ret 10 + r; }
    if (v.model != spirv.MEMORY_GLSL450 || v.coherent != 2 || v.visible + v.available + v.texel_visible + v.texel_avail != 0 || v.extension) { ret 20; }
    var e: u32 = 0;
    for (e < 3) {
        var env_line: str = "env = \"vulkan1.3\"\n";
        var target:   str = "vulkan1.3";
        if (e == 1) {
            env_line = "env = \"vulkan1.2\"\nextensions = [\"vulkan_memory_model\"]\n";
            target   = "vulkan1.2";
        }
        or (e == 2) {
            env_line = "env = \"vulkan1.1\"\nextensions = [\"vulkan_memory_model\"]\n";
            target   = "vulkan1.1";
        }
        r = ut_vmm_module(?alloc, UT_VMM_STAGE, env_line, target, "", 0, 0, ?v);
        if (r != 0)                                                                                         { ret 30 + 10 * e::i32 + r; }
        if (v.model != spirv.MEMORY_VULKAN || v.coherent != 0 || v.extension != (e == 2) || v.device_scope) { ret 61 + e::i32; }
        if (v.visible < 2 || v.available < 2 || v.texel_visible != 1 || v.texel_avail != 1)                 { ret 64 + e::i32; }
        e = e + 1;
    }
    r = ut_vmm_module(?alloc, UT_VMM_STAGE, "env = \"vulkan1.0\"\nextensions = [\"vulkan_memory_model\"]\n", "", "the Vulkan memory model is defined from SPIR-V 1.3", 0, 0, ?v);
    if (r != 0) { ret 70 + r; }
    ret 0;
}

# a memory scope or semantics is held to the model: under the Vulkan model the Device scope
# needs vulkanMemoryModelDeviceScope, which vulkan1.3 guarantees and an earlier environment
# names, and under GLSL450 the QueueFamily scope and the availability semantics are the
# Vulkan model's own
test vulkan_memory_model__scopes_and_semantics_follow_the_model {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val device: str = "#[stage(\"compute\")]\n#[workgroup(64, 1, 1)]\nfun cs() { atomic_add(?cells.flag, DEVICE, 0x48, 1); }\n";
    var v:      UtVmm;
    var r:      i32 = ut_vmm_module(?alloc, device, "env = \"vulkan1.2\"\nextensions = [\"vulkan_memory_model\"]\n", "",
        "`OpAtomicIAdd` with the Device memory scope under the Vulkan memory model needs the `vulkan_memory_model_device_scope` extension", 0, 0, ?v);
    if (r != 0) { ret 10 + r; }
    r = ut_vmm_module(?alloc, device, "env = \"vulkan1.2\"\nextensions = [\"vulkan_memory_model_device_scope\"]\n", "vulkan1.2", "", 0, 0, ?v);
    if (r != 0)                                            { ret 20 + r; }
    if (v.model != spirv.MEMORY_VULKAN || !v.device_scope) { ret 30; }
    r = ut_vmm_module(?alloc, device, "env = \"vulkan1.3\"\n", "vulkan1.3", "", 0, 0, ?v);
    if (r != 0)                                            { ret 40 + r; }
    if (v.model != spirv.MEMORY_VULKAN || !v.device_scope) { ret 50; }
    r = ut_vmm_module(?alloc, device, "env = \"vulkan1.2\"\n", "vulkan1.2", "", 0, 0, ?v);
    if (r != 0)                                            { ret 60 + r; }
    if (v.model != spirv.MEMORY_GLSL450 || v.device_scope) { ret 70; }
    r = ut_vmm_module(?alloc, "#[stage(\"compute\")]\n#[workgroup(64, 1, 1)]\nfun cs() { memory_barrier(QUEUE_FAMILY, 0x48); }\n", "env = \"vulkan1.2\"\n", "",
        "`OpMemoryBarrier` with the QueueFamily memory scope, which only the Vulkan memory model defines, needs the `vulkan_memory_model` extension", 0, 0, ?v);
    if (r != 0) { ret 80 + r; }
    r = ut_vmm_module(?alloc, "#[stage(\"compute\")]\n#[workgroup(64, 1, 1)]\nfun cs() { memory_barrier(WORKGROUP, 0x2048); }\n", "env = \"vulkan1.2\"\n", "",
        "`OpMemoryBarrier` with MakeAvailable, MakeVisible or Volatile memory semantics, which only the Vulkan memory model defines, needs the `vulkan_memory_model` extension", 0, 0, ?v);
    if (r != 0) { ret 90 + r; }
    r = ut_vmm_module(?alloc, "#[stage(\"compute\")]\n#[workgroup(64, 1, 1)]\nfun cs() { memory_barrier(QUEUE_FAMILY, 0x6048); }\n", "env = \"vulkan1.3\"\n", "vulkan1.3", "", 0, 0, ?v);
    if (r != 0) { ret 100 + r; }
    ret 0;
}

# SequentiallyConsistent semantics are refused in a Vulkan environment under either model,
# located at the call (VUID-StandaloneSpirv-MemorySemantics-10866)
test vulkan_memory_model__sequentially_consistent_is_refused {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val stage:  str = "#[stage(\"compute\")]\n#[workgroup(64, 1, 1)]\nfun cs() { memory_barrier(WORKGROUP, 0x50); }\n";
    val needle: str = "`OpMemoryBarrier` with SequentiallyConsistent memory semantics is not allowed in a Vulkan environment (VUID-StandaloneSpirv-MemorySemantics-10866)";
    var v:      UtVmm;
    var r:      i32 = ut_vmm_module(?alloc, stage, "env = \"vulkan1.2\"\n", "", needle, 3, 12, ?v);
    if (r != 0) { ret 10 + r; }
    r = ut_vmm_module(?alloc, stage, "env = \"vulkan1.3\"\n", "", needle, 3, 12, ?v);
    if (r != 0) { ret 20 + r; }
    r = ut_vmm_module(?alloc, "#[stage(\"compute\")]\n#[workgroup(64, 1, 1)]\nfun cs() { atomic_add(?tile[0], WORKGROUP, 0x110, 1); }\n", "", "", "`OpAtomicIAdd` with SequentiallyConsistent memory semantics", 3, 12, ?v);
    if (r != 0) { ret 30 + r; }
    ret 0;
}

# a load the emitter can follow to a `writeonly` binding through its escaped address is refused
test storage__escaping_writeonly_address_is_refused {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var img:   of.ObjectImage;
    var fault: str = nil;
    val r:     i32 = ut_l6_module(?alloc, "rec P { c: [8]f32x4; }\n\n#[storage(0, 3, \"writeonly\")] var wo: P;\n\n#[input(0)] var in_x: f32x4;\n#[builtin(\"position\")] var position: f32x4;\n\n#[stage(\"vertex\")]\nfun vert_main() {\n    val p: *f32x4 = ?wo.c[1];\n    position = @p + in_x;\n}\n\nfun main() i32 { ret 0; }\n", false, ?img, ?fault);
    if (r == 0) {
        obj.dnit(?img);
        ret 2;
    }
    if (r != 2 || fault == nil || !ut_str_contains(fault, "a load reaches the `#[storage(0, 3, \"writeonly\")]` binding")) {
        if (fault != nil) { print.eprintlnf("{}", fault); }
        ret 3;
    }
    ret 0;
}

test storage__escaping_readonly_address_is_refused {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    var texts: [1]str;
    names[0] = "main.mach";
    texts[0] = "rec P { c: [8]f32x4; }\n\n#[storage(0, 3, \"readonly\")] var ro: P;\n\n#[input(0)] var in_x: f32x4;\n#[builtin(\"position\")] var position: f32x4;\n\n#[noinline]\nfun bump(p: *f32x4, v: f32x4) { @p = v; }\n\n#[stage(\"vertex\")]\nfun vert_main() {\n    bump(?ro.c[1], in_x);\n    position = ro.c[2];\n}\n";
    var dn: [1]str;
    var dt: [1]str;
    val pr: res[project.Project, outcome.Fail] = ut_spv_lower(?s, ?alloc, ?names[0], ?texts[0], 1, "", ?dn[0], ?dt[0], 0);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    var bad:   i32 = 0;
    var img:   of.ObjectImage;
    var fault: str = nil;
    if (ut_spv_codegen(?p, ?s, "spvcase.main", ?img, ?fault)) {
        bad = 1;
        obj.dnit(?img);
    }
    or {
        if (fault == nil)                                                                            { bad = 1; }
        or (!ut_str_contains(fault, "a store reaches the `#[storage(0, 3, \"readonly\")]` binding")) { bad = 1; }
    }

    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

#[testing]
val UT_SHARED_SRC: str = "rec Counts { hits: [64]u32; }\nrec Pair { a: u32; b: f32; }\n\n#[storage(0, 0)] var counts: Counts;\n#[builtin(\"global_invocation\")] var global_id: u32x3;\n\n#[shared] var tile: [256]f32;\n#[shared] var pair: Pair;\n\n#[stage(\"compute\")]\n#[workgroup(8, 2, 1)]\nfun count_main() {\n    val i: u32 = global_id[0];\n    tile[i] = tile[i] + 1.0;\n    pair.a = pair.a + i;\n    counts.hits[i] = tile[i]::u32 + pair.a;\n}\n";

# the Workgroup variables of the module, and how many carry an initializer
#[testing]
fun ut_spv_workgroup_vars(w: *u32, n: u32, out_init: *u32) u32 {
    @out_init = 0;
    var i: u32 = 0;
    var c: u32 = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0) { ret c; }
        if ((w[i] & 0xFFFF) == spirv.OP_VARIABLE && len >= 4 && w[i + 3] == spirv.STORAGE_WORKGROUP) {
            c = c + 1;
            if (len == 5) { @out_init = @out_init + 1; }
        }
        i = i + len;
    }
    ret c;
}

#[testing]
val UT_SHARED_SPEC_SRC: str = "rec Counts { hits: [64]u32; }\n\n#[storage(0, 0)] var counts: Counts;\n#[builtin(\"global_invocation\")] var global_id: u32x3;\n#[spec(0)] var tile_x: u32 = 8;\n\n#[shared] var tile: [256]f32;\n\n#[stage(\"compute\")]\n#[workgroup(tile_x, 2, 1)]\nfun count_main() {\n    val i: u32 = global_id[0];\n    tile[i] = tile[i] + 1.0;\n    counts.hits[i] = tile[i]::u32;\n}\n";

# whether a loop increment steps by a product of specialization constants: an
# OpIAdd whose last operand is an OpIMul result derived from an OpSpecConstant
#[testing]
fun ut_spv_spec_stride(alloc: *A.Allocator, w: *u32, n: u32) bool {
    var bound: u32 = 0;
    var i:     u32 = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0)                      { brk; }
        if (len >= 3 && w[i + 2] >= bound) { bound = w[i + 2] + 1; }
        i = i + len;
    }
    val rd: res[*u8, A.Error] = A.allocate[u8](alloc, bound::usize);
    if (sel rd.err) { ret false; }
    val derived: *u8 = rd.ok;
    var k:       u32 = 0;
    for (k < bound) {
        derived[k] = 0;
        k          = k + 1;
    }
    var found: bool = false;
    i = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0) { brk; }
        val op: u32 = w[i] & 0xFFFF;
        if (op == spirv.OP_SPEC_CONSTANT && len >= 3)                                               { derived[w[i + 2]] = 1; }
        if (op == spirv.OP_I_MUL && len == 5 && (derived[w[i + 3]] != 0 || derived[w[i + 4]] != 0)) { derived[w[i + 2]] = 2; }
        if (op == spirv.OP_I_ADD && len == 5 && w[i + 4] < bound && derived[w[i + 4]] == 2)         { found = true; }
        i = i + len;
    }
    A.deallocate[u8](alloc, derived, bound::usize);
    ret found;
}

# builds `src` under `env_line` and checks the zeroing form the selection takes:
# an OpConstantNull initializer on each of its `vars` Workgroup variables where the
# environment or a declared feature zeroes workgroup memory, and otherwise the
# inserted loop per variable and one barrier, stepping by the specialized size when
# `spec`. spirv-val judges the module under `target_env`
#[testing]
fun ut_spirv_shared_build(alloc: *A.Allocator, env_line: str, target_env: str, src: str, vars_want: u32,
    native: bool, spec: bool) i32 {
    val sr: res[session.Session, fail.Fail] = session.init(alloc);
    if (sel sr.err) { ret 1; }
    var s:  session.Session   = sr.ok;
    val rr: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.err) {
        session.dnit(?s);
        ret 1;
    }
    var names:  [1]str              = [1]str{"k.mach"};
    var texts:  [1]str              = [1]str{src};
    val root_r: res[str, fail.Fail] = ut_scaffold_m(alloc, ut_spirv_env_manifest(alloc, env_line), ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    var bad:  i32 = 0;
    var pick: manifest.Selection;
    pick.target       = "gpu";
    pick.profile      = "";
    pick.artifact     = "";
    pick.want_lib     = false;
    pick.has_artifact = false;
    val pr: res[project.Project, outcome.Fail] = driver.build_project_sel(?s, root, ?pick);
    if (sel pr.err) {
        print.print(outcome.describe(pr.err));
        print.print("\n");
        bad = 2;
    }
    if (sel pr.ok) {
        var p:  project.Project   = pr.ok;
        val se: err[outcome.Fail] = driver.run_sema_pass(?p);
        val le: err[outcome.Fail] = driver.run_lower_pass(?p);
        val ce: err[outcome.Fail] = driver.run_codegen_pass(?p);
        if (sel se.err || sel le.err) { bad = 3; }
        or (sel ce.err) {
            print.print(ut_codegen_outcome_text(?s, ce.err));
            print.print("\n");
            bad = 4;
        }
        or {
            var m:     *project.ModuleEntry       = nil;
            val fqn_r: res[intern.StrId, A.Error] = intern.intern(?s.interner, "envtest.k");
            if (sel fqn_r.ok) {
                val mo: opt[*project.ModuleEntry] = project.module_by_fqn(?p, fqn_r.ok);
                if (sel mo.some) { m = mo.some; }
            }
            if (m == nil || m.object_image == nil) { bad = 5; }
            or {
                var n:    u32  = 0;
                val w:    *u32 = ut_spv_words(m.object_image, ?n);
                var init: u32  = 0;
                val vars: u32  = ut_spv_workgroup_vars(w, n, ?init);
                val bars: u32  = ut_spv_count(w, n, spirv.OP_CONTROL_BARRIER);
                if (vars != vars_want)                                                                           { bad = 6; }
                or (native && (init != vars || bars != 0))                                                       { bad = 7; }
                or (!native && (init != 0 || bars != 1 || ut_spv_count(w, n, spirv.OP_LOOP_MERGE) != vars_want)) { bad = 8; }
                or (spec && !ut_spv_spec_stride(alloc, w, n))                                                    { bad = 10; }
                or {
                    var dis: str = nil;
                    if (ut_l6_external(alloc, m.object_image, target_env, ?dis) == 2) { bad = 9; }
                }
            }
        }
        project.dnit_project(?p);
    }
    fs.remove_all(alloc, root);
    session.dnit(?s);
    ret bad;
}

test shared__zeroed_on_every_environment {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var r: i32 = ut_spirv_shared_build(?alloc, "env = \"vulkan1.3\"\n", "vulkan1.3", UT_SHARED_SRC, 2, true, false);
    if (r != 0) { ret 10 + r; }
    r = ut_spirv_shared_build(?alloc, "env = \"vulkan1.0\"\n", "vulkan1.0", UT_SHARED_SRC, 2, false, false);
    if (r != 0) { ret 20 + r; }
    r = ut_spirv_shared_build(?alloc, "env = \"vulkan1.2\"\n", "vulkan1.2", UT_SHARED_SRC, 2, false, false);
    if (r != 0) { ret 30 + r; }
    r = ut_spirv_shared_build(?alloc, "env = \"vulkan1.0\"\nextensions = [\"zero_init_workgroup\"]\n", "vulkan1.0", UT_SHARED_SRC, 2, true, false);
    if (r != 0) { ret 40 + r; }
    r = ut_spirv_shared_build(?alloc, "env = \"vulkan1.0\"\n", "vulkan1.0", UT_SHARED_SPEC_SRC, 1, false, true);
    if (r != 0) { ret 50 + r; }
    ret 0;
}

test shared__misuse_is_refused {
    if (!ut_sema_rejects_with("#[shared] #[storage(0, 0)] var t: [4]u32;\n\nfun main() i32 { ret 0; }\n",
        "and `shared` are mutually exclusive")) { ret 1; }
    if (!ut_sema_rejects_with("#[shared] var t: u32 = 3;\n\nfun main() i32 { ret 0; }\n",
        "a `#[shared]` variable cannot have an initializer")) { ret 2; }
    if (!ut_sema_rejects_with("#[shared] val t: u32;\n\nfun main() i32 { ret 0; }\n",
        "`#[shared]` applies to a `var`: workgroup memory is written by the stage")) { ret 10; }
    if (!ut_sema_rejects_with("#[shared]\nfun f() {}\n\nfun main() i32 { ret 0; }\n",
        "apply only to module-level `val` / `var` bindings")) { ret 3; }
    if (!ut_sema_rejects_with("fun f() i32 {\n    #[shared] var t: u32;\n    t = 1;\n    ret t;\n}\n\nfun main() i32 { ret 0; }\n",
        "`#[shared]` applies only to module-level declarations")) { ret 4; }

    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 5; }
    var img:   of.ObjectImage;
    var fault: str = nil;
    val vert:  i32 = ut_l6_module(?alloc, "#[shared] var t: u32;\n#[builtin(\"position\")] var pos: f32x4;\n\nfun helper() { t = 2; }\n\n#[stage(\"vertex\")]\nfun vs() {\n    helper();\n    pos = f32x4{0.0, 0.0, 0.0, 1.0};\n}\n", false, ?img, ?fault);
    if (vert == 0) {
        obj.dnit(?img);
        ret 6;
    }
    if (fault == nil || !ut_str_contains(fault, "is used by the stage `vs`, which is not a compute stage")) { ret 7; }
    fault = nil;
    val frag: i32 = ut_l6_module(?alloc, "#[shared] var t: u32;\n#[output(0)] var o: u32;\n\n#[stage(\"fragment\")]\nfun fs_main() { o = t; }\n", false, ?img, ?fault);
    if (frag == 0) {
        obj.dnit(?img);
        ret 8;
    }
    if (fault == nil || !ut_str_contains(fault, "is used by the stage `fs_main`, which is not a compute stage")) { ret 9; }
    ret 0;
}

# the opcode of the instruction whose result is `id`, and its first operand word after the result
#[testing]
fun ut_spv_result_op(w: *u32, n: u32, id: u32, out_word: *u32) u32 {
    var i: u32 = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0) { ret 0; }
        if (len >= 3 && w[i + 2] == id) {
            @out_word = 0;
            if (len >= 4) { @out_word = w[i + 3]; }
            ret w[i] & 0xFFFF;
        }
        i = i + len;
    }
    ret 0;
}

#[testing]
val UT_OUTPUT_INIT_SRC: str = "#[output(0)] var color: f32x4 = f32x4{1.0, 0.5, 0.0, 1.0};\n#[output(1)] var plain: u32;\n#[builtin(\"position\")] var pos: f32x4 = f32x4{0.0, 0.0, 0.0, 1.0};\n\n#[stage(\"vertex\")]\nfun vs() { plain = 1; }\n\nfun main() i32 { ret 0; }\n";

test iface__initializer_rule_per_role {
    # a role whose value the host, the pipeline or the stage supplies refuses an initializer
    if (!ut_sema_rejects_with("#[input(0)] var i: f32 = 1.0;\nfun main() i32 { ret 0; }\n", "an `#[input]` variable cannot have an initializer"))                          { ret 1; }
    if (!ut_sema_rejects_with("#[builtin(\"vertex_index\")] var v: u32 = 1;\nfun main() i32 { ret 0; }\n", "an input `#[builtin]` cannot have an initializer"))            { ret 2; }
    if (!ut_sema_rejects_with("rec U { a: u32; }\n#[uniform(0, 0)] var u: U = U{a: 1};\nfun main() i32 { ret 0; }\n", "`#[sampler]` variable cannot have an initializer")) { ret 3; }
    if (!ut_sema_rejects_with("rec B { a: u32; }\n#[storage(0, 1)] var b: B = B{a: 1};\nfun main() i32 { ret 0; }\n", "`#[sampler]` variable cannot have an initializer")) { ret 4; }
    if (!ut_sema_rejects_with("#[sampler(0, 2)] var t: u32 = 1;\nfun main() i32 { ret 0; }\n", "`#[sampler]` variable cannot have an initializer"))                        { ret 5; }
    if (!ut_sema_rejects_with("rec P { a: u32; }\n#[push] var p: P = P{a: 1};\nfun main() i32 { ret 0; }\n", "a `#[push]` block cannot have an initializer"))              { ret 6; }
    # a specialization constant's initializer is its default, so one is required
    if (!ut_sema_rejects_with("#[spec(0)] var n: u32;\nfun main() i32 { ret 0; }\n", "a `#[spec(id)]` var needs an initializer")) { ret 7; }

    # an output starts at its initializer, and at OpConstantNull without one
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 10; }
    var img:   of.ObjectImage;
    var fault: str = nil;
    if (ut_l6_module(?alloc, UT_OUTPUT_INIT_SRC, false, ?img, ?fault) != 0) {
        if (fault != nil) { print.eprintlnf("{}", fault); }
        ret 11;
    }
    var n:     u32  = 0;
    val w:     *u32 = ut_spv_words(?img, ?n);
    var outs:  u32  = 0;
    var nulls: u32  = 0;
    var comps: u32  = 0;
    var bad:   i32  = 0;
    var i:     u32  = 0;
    for (w != nil && i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0) { brk; }
        if ((w[i] & 0xFFFF) == spirv.OP_VARIABLE && len >= 4 && w[i + 3] == spirv.STORAGE_OUTPUT) {
            outs = outs + 1;
            if (len != 5) { bad = 12; }
            or {
                var first: u32 = 0;
                val op:    u32 = ut_spv_result_op(w, n, w[i + 4], ?first);
                if (op == spirv.OP_CONSTANT_NULL) { nulls = nulls + 1; }
                or (op == spirv.OP_CONSTANT_COMPOSITE) {
                    comps = comps + 1;
                    var bits: u32 = 0;
                    val lane: u32 = ut_spv_result_op(w, n, first, ?bits);
                    if (lane != spirv.OP_CONSTANT_NULL && (lane != spirv.OP_CONSTANT || bits != 0x3F800000)) { bad = 13; }
                }
                or { bad = 14; }
            }
        }
        i = i + len;
    }
    if (bad == 0 && (outs != 3 || nulls != 1 || comps != 2)) { bad = 15; }
    obj.dnit(?img);
    if (bad != 0) { ret bad; }
    val env: i32 = ut_l6_env(?alloc, UT_OUTPUT_INIT_SRC, "env = \"vulkan1.0\"\n", "vulkan1.0", "", 0, nil);
    if (env != 0) { ret 20 + env; }
    ret 0;
}

#[testing]
fun ut_spv_bool_type(w: *u32, n: u32) u32 {
    var i: u32 = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0)                              { ret 0; }
        if ((w[i] & 0xFFFF) == spirv.OP_TYPE_BOOL) { ret w[i + 1]; }
        i = i + len;
    }
    ret 0;
}

#[testing]
fun ut_spv_is_bool_value(w: *u32, n: u32, bool_ty: u32, id: u32) bool {
    if (bool_ty == 0 || id == 0) { ret false; }
    var i: u32 = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0)                                          { ret false; }
        if (len >= 3 && w[i + 1] == bool_ty && w[i + 2] == id) { ret true; }
        i = i + len;
    }
    ret false;
}

#[testing]
fun ut_spv_bool_call_args(w: *u32, n: u32, bool_ty: u32) u32 {
    var i: u32 = 0;
    var c: u32 = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0) { ret c; }
        if ((w[i] & 0xFFFF) == spirv.OP_FUNCTION_CALL) {
            var k: u32 = 4;
            for (k < len) {
                if (ut_spv_is_bool_value(w, n, bool_ty, w[i + k])) { c = c + 1; }
                k = k + 1;
            }
        }
        i = i + len;
    }
    ret c;
}

#[testing]
fun ut_spv_bool_returns(w: *u32, n: u32, bool_ty: u32) u32 {
    var i:      u32 = 0;
    var c:      u32 = 0;
    var fn_ret: u32 = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0) { ret c; }
        val op: u32 = w[i] & 0xFFFF;
        if (op == spirv.OP_FUNCTION) { fn_ret = w[i + 1]; }
        if (op == spirv.OP_RETURN_VALUE && fn_ret != bool_ty
            && ut_spv_is_bool_value(w, n, bool_ty, w[i + 1])) { c = c + 1; }
        i = i + len;
    }
    ret c;
}

#[testing]
fun ut_spv_bool_conditions(w: *u32, n: u32, bool_ty: u32) u32 {
    var i: u32 = 0;
    var c: u32 = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0) { ret c; }
        if ((w[i] & 0xFFFF) == spirv.OP_BRANCH_CONDITIONAL
            && ut_spv_is_bool_value(w, n, bool_ty, w[i + 1])) { c = c + 1; }
        i = i + len;
    }
    ret c;
}

#[testing]
fun ut_spv_cmp_boundary_src() str {
    ret "fun mix(h: u64, b: u8) u64 { ret h * 31 + b::u64; }\n\npub fun crosses(seed: u32) u64 {\n    val x: u32 = 7 + seed;\n    ret mix(1, x == x);\n}\n\npub fun returns_cmp(seed: u32) u8 {\n    val x: u32 = 7 + seed;\n    ret x == x;\n}\n\npub fun branches(seed: u32) u64 {\n    val x: u32 = 7 + seed;\n    if (x == x) { ret 1; }\n    ret 0;\n}\n";
}

test comparison__converted_at_a_call_boundary {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    var texts: [1]str;
    names[0] = "main.mach";
    texts[0] = ut_spv_cmp_boundary_src();
    var dn: [1]str;
    var dt: [1]str;
    val pr: res[project.Project, outcome.Fail] = ut_spv_lower(?s, ?alloc, ?names[0], ?texts[0], 1, "", ?dn[0], ?dt[0], 0);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    var bad:   i32 = 0;
    var img:   of.ObjectImage;
    var fault: str = nil;
    if (!ut_spv_codegen(?p, ?s, "spvcase.main", ?img, ?fault)) {
        project.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }
    var n: u32  = 0;
    val w: *u32 = ut_spv_words(?img, ?n);
    if (w == nil) {
        obj.dnit(?img);
        project.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }

    val bt: u32 = ut_spv_bool_type(w, n);
    if (bt == 0)                                   { bad = 1; }
    if (ut_spv_count(w, n, spirv.OP_I_EQUAL) != 3) { bad = 1; }
    or {
        if (ut_spv_bool_call_args(w, n, bt) != 0)     { bad = 1; }
        if (ut_spv_bool_returns(w, n, bt) != 0)       { bad = 1; }
        if (ut_spv_bool_conditions(w, n, bt) != 1)    { bad = 1; }
        if (ut_spv_count(w, n, spirv.OP_SELECT) != 2) { bad = 1; }
    }

    obj.dnit(?img);
    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

#[testing]
fun ut_spv_array_init_src() str {
    ret "#[output(0)] var o_lit: u32;\n#[output(1)] var o_elem: u32;\n\n#[stage(\"vertex\")]\nfun vs() {\n    val lit: [4]u32 = [4]u32{7, 6, 5, 4};\n    var elem: [4]u32;\n    elem[0] = 7; elem[1] = 6; elem[2] = 5; elem[3] = 4;\n    o_lit  = lit[0]  + lit[1]  * 10 + lit[2]  * 100 + lit[3]  * 1000;\n    o_elem = elem[0] + elem[1] * 10 + elem[2] * 100 + elem[3] * 1000;\n}\n\nfun main() i32 { ret 0; }\n";
}

test aggregate__array_literal_reaches_a_local {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    var texts: [1]str;
    names[0] = "main.mach";
    texts[0] = ut_spv_array_init_src();
    val pr: res[project.Project, outcome.Fail] = ut_spv_lower(?s, ?alloc, ?names[0], ?texts[0], 1, "", nil, nil, 0);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    var img:   of.ObjectImage;
    var fault: str = nil;
    if (!ut_spv_codegen(?p, ?s, "spvcase.main", ?img, ?fault)) {
        project.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }
    var bad: i32 = 0;
    if (ut_spv_read_location(?alloc, ?img, 0) != 4567) { bad = 1; }
    if (ut_spv_read_location(?alloc, ?img, 1) != 4567) { bad = 1; }

    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

#[testing]
val UT_AGG_IDS:     u32 = 1024;
#[testing]
val UT_AGG_WORDS:   u32 = 16;
#[testing]
val UT_AGG_MEMBERS: u32 = 8;
#[testing]
val UT_AGG_DEPTH:   u32 = 4;

#[testing]
val UT_AGG_BAD: u64 = 0xFFFFFFFFFFFFFFFF;

#[testing]
val UT_AGG_TY_NONE:   u8 = 0;
#[testing]
val UT_AGG_TY_SCALAR: u8 = 1;
#[testing]
val UT_AGG_TY_SEQ:    u8 = 2;
#[testing]
val UT_AGG_TY_STRUCT: u8 = 3;
#[testing]
val UT_AGG_TY_PTR:    u8 = 4;
#[testing]
val UT_AGG_TY_VOID:   u8 = 5;

#[testing]
rec UtAggEval {
    ty_kind:  [1024]u8;
    ty_words: [1024]u32;
    ty_bits:  [1024]u32;
    ty_elem:  [1024]u32;
    ty_mcnt:  [1024]u32;
    ty_mem:   [8192]u32;
    val:      [16384]u64;
    val_ty:   [1024]u32;
    is_ptr:   [1024]bool;
    ptr_blk:  [1024]u32;
    ptr_off:  [1024]u32;
    ptr_ty:   [1024]u32;
    fn_at:    [1024]u32;
}

#[testing]
fun ut_agg_reset(st: *UtAggEval) {
    var i: u32 = 0;
    for (i < UT_AGG_IDS) {
        st.ty_kind[i]  = UT_AGG_TY_NONE;
        st.ty_words[i] = 0;
        st.ty_bits[i]  = 0;
        st.ty_elem[i]  = 0;
        st.ty_mcnt[i]  = 0;
        st.val_ty[i]   = 0;
        st.is_ptr[i]   = false;
        st.ptr_blk[i]  = 0;
        st.ptr_off[i]  = 0;
        st.ptr_ty[i]   = 0;
        st.fn_at[i]    = 0;
        i              = i + 1;
    }
    i = 0;
    for (i < UT_AGG_IDS * UT_AGG_MEMBERS) {
        st.ty_mem[i] = 0;
        i            = i + 1;
    }
    i = 0;
    for (i < UT_AGG_IDS * UT_AGG_WORDS) {
        st.val[i] = 0;
        i         = i + 1;
    }
}

#[testing]
fun ut_agg_member(st: *UtAggEval, ty: u32, k: u32, out_off: *u32, out_ty: *u32) bool {
    if (ty >= UT_AGG_IDS || k >= st.ty_mcnt[ty]) { ret false; }
    if (st.ty_kind[ty] == UT_AGG_TY_SEQ) {
        @out_off = k * st.ty_words[st.ty_elem[ty]];
        @out_ty  = st.ty_elem[ty];
        ret true;
    }
    if (st.ty_kind[ty] == UT_AGG_TY_STRUCT) {
        var off: u32 = 0;
        var j:   u32 = 0;
        for (j < k) {
            off = off + st.ty_words[st.ty_mem[ty * UT_AGG_MEMBERS + j]];
            j   = j + 1;
        }
        @out_off = off;
        @out_ty  = st.ty_mem[ty * UT_AGG_MEMBERS + k];
        ret true;
    }
    ret false;
}

#[testing]
fun ut_agg_copy(st: *UtAggEval, dblk: u32, doff: u32, sblk: u32, soff: u32, words: u32) bool {
    if (words == 0 || dblk >= UT_AGG_IDS || sblk >= UT_AGG_IDS)     { ret false; }
    if (doff + words > UT_AGG_WORDS || soff + words > UT_AGG_WORDS) { ret false; }
    var k: u32 = 0;
    for (k < words) {
        st.val[dblk * UT_AGG_WORDS + doff + k] = st.val[sblk * UT_AGG_WORDS + soff + k];
        k                                      = k + 1;
    }
    ret true;
}

#[testing]
fun ut_agg_mask(st: *UtAggEval, ty: u32, v: u64) u64 {
    if (ty >= UT_AGG_IDS) { ret v; }
    val bits: u32 = st.ty_bits[ty];
    if (bits == 0 || bits >= 64) { ret v; }
    ret v & ((1::u64 << bits::u64) - 1);
}

#[testing]
fun ut_agg_prepare(st: *UtAggEval, w: *u32, n: u32) bool {
    var i: u32 = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0) { ret false; }
        val op: u32 = w[i] & 0xFFFF;

        if (op == spirv.OP_TYPE_VOID || op == spirv.OP_TYPE_BOOL) {
            val r: u32 = w[i + 1];
            if (r >= UT_AGG_IDS)          { ret false; }
            if (op == spirv.OP_TYPE_VOID) { st.ty_kind[r] = UT_AGG_TY_VOID; }
            or {
                st.ty_kind[r]  = UT_AGG_TY_SCALAR;
                st.ty_words[r] = 1;
                st.ty_bits[r]  = 32;
            }
        }
        or (op == spirv.OP_TYPE_INT || op == spirv.OP_TYPE_FLOAT) {
            val r: u32 = w[i + 1];
            if (r >= UT_AGG_IDS) { ret false; }
            st.ty_kind[r]  = UT_AGG_TY_SCALAR;
            st.ty_words[r] = 1;
            st.ty_bits[r]  = w[i + 2];
        }
        or (op == spirv.OP_TYPE_VECTOR || op == spirv.OP_TYPE_ARRAY) {
            val r: u32 = w[i + 1];
            val e: u32 = w[i + 2];
            if (r >= UT_AGG_IDS || e >= UT_AGG_IDS) { ret false; }
            var cnt: u32 = w[i + 3];
            if (op == spirv.OP_TYPE_ARRAY) {
                if (cnt >= UT_AGG_IDS) { ret false; }
                cnt = st.val[cnt * UT_AGG_WORDS]::u32;
            }
            if (cnt == 0 || cnt > UT_AGG_WORDS) { ret false; }
            st.ty_kind[r]  = UT_AGG_TY_SEQ;
            st.ty_elem[r]  = e;
            st.ty_mcnt[r]  = cnt;
            st.ty_words[r] = cnt * st.ty_words[e];
        }
        or (op == spirv.OP_TYPE_STRUCT) {
            val r: u32 = w[i + 1];
            val m: u32 = len - 2;
            if (r >= UT_AGG_IDS || m == 0 || m > UT_AGG_MEMBERS) { ret false; }
            var words: u32 = 0;
            var k:     u32 = 0;
            for (k < m) {
                val mt: u32 = w[i + 2 + k];
                if (mt >= UT_AGG_IDS || st.ty_words[mt] == 0) { ret false; }
                st.ty_mem[r * UT_AGG_MEMBERS + k] = mt;
                words                             = words + st.ty_words[mt];
                k                                 = k + 1;
            }
            if (words > UT_AGG_WORDS) { ret false; }
            st.ty_kind[r]  = UT_AGG_TY_STRUCT;
            st.ty_mcnt[r]  = m;
            st.ty_words[r] = words;
        }
        or (op == spirv.OP_TYPE_POINTER) {
            val r: u32 = w[i + 1];
            if (r >= UT_AGG_IDS || w[i + 3] >= UT_AGG_IDS) { ret false; }
            st.ty_kind[r]  = UT_AGG_TY_PTR;
            st.ty_elem[r]  = w[i + 3];
            st.ty_words[r] = 1;
        }
        or (op == spirv.OP_CONSTANT) {
            val r: u32 = w[i + 2];
            if (r >= UT_AGG_IDS || len < 4) { ret false; }
            var v: u64 = w[i + 3]::u64;
            if (len >= 5) { v = v | (w[i + 4]::u64 << 32); }
            st.val[r * UT_AGG_WORDS] = v;
            st.val_ty[r]             = w[i + 1];
        }
        or (op == spirv.OP_CONSTANT_NULL) {
            val t: u32 = w[i + 1];
            val r: u32 = w[i + 2];
            if (r >= UT_AGG_IDS || t >= UT_AGG_IDS || st.ty_words[t] > UT_AGG_WORDS) { ret false; }
            var k: u32 = 0;
            for (k < st.ty_words[t]) {
                st.val[r * UT_AGG_WORDS + k] = 0;
                k                            = k + 1;
            }
            st.val_ty[r] = t;
        }
        or (op == spirv.OP_CONSTANT_COMPOSITE) {
            val t: u32 = w[i + 1];
            val r: u32 = w[i + 2];
            if (r >= UT_AGG_IDS || t >= UT_AGG_IDS) { ret false; }
            var off: u32 = 0;
            var k:   u32 = 0;
            for (k < len - 3) {
                val c: u32 = w[i + 3 + k];
                if (c >= UT_AGG_IDS || st.val_ty[c] == 0) { ret false; }
                val cw: u32 = st.ty_words[st.val_ty[c]];
                if (!ut_agg_copy(st, r, off, c, 0, cw)) { ret false; }
                off = off + cw;
                k   = k + 1;
            }
            st.val_ty[r] = t;
        }
        or (op == spirv.OP_VARIABLE) {
            val pt: u32 = w[i + 1];
            val r:  u32 = w[i + 2];
            if (r >= UT_AGG_IDS || pt >= UT_AGG_IDS || st.ty_kind[pt] != UT_AGG_TY_PTR) { ret false; }
            st.is_ptr[r]  = true;
            st.ptr_blk[r] = r;
            st.ptr_off[r] = 0;
            st.ptr_ty[r]  = st.ty_elem[pt];
        }
        or (op == spirv.OP_FUNCTION) {
            val r: u32 = w[i + 2];
            if (r >= UT_AGG_IDS) { ret false; }
            st.fn_at[r] = i;
        }

        i = i + len;
    }
    ret true;
}

#[testing]
fun ut_agg_location_var(w: *u32, n: u32, loc: u32) u32 {
    var i: u32 = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0) { ret 0; }
        if ((w[i] & 0xFFFF) == spirv.OP_DECORATE && len == 4
            && w[i + 2] == spirv.DECOR_LOCATION && w[i + 3] == loc) { ret w[i + 1]; }
        i = i + len;
    }
    ret 0;
}

#[testing]
fun ut_agg_entry_fn(w: *u32, n: u32) u32 {
    var i: u32 = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0)                                            { ret 0; }
        if ((w[i] & 0xFFFF) == spirv.OP_ENTRY_POINT && len >= 4) { ret w[i + 2]; }
        i = i + len;
    }
    ret 0;
}

#[testing]
fun ut_agg_body_start(st: *UtAggEval, w: *u32, n: u32, fn: u32) u32 {
    if (fn >= UT_AGG_IDS || st.fn_at[fn] == 0) { ret 0; }
    var i: u32 = st.fn_at[fn];
    i = i + (w[i] >> 16);
    for (i < n) {
        if ((w[i] & 0xFFFF) != spirv.OP_FUNCTION_PARAMETER) { ret i; }
        i = i + (w[i] >> 16);
    }
    ret 0;
}

#[testing]
fun ut_agg_bind_params(st: *UtAggEval, w: *u32, n: u32, fn: u32, arg_first: u32, argc: u32) bool {
    if (fn >= UT_AGG_IDS || st.fn_at[fn] == 0) { ret false; }
    var i: u32 = st.fn_at[fn];
    i = i + (w[i] >> 16);
    var k: u32 = 0;
    for (i < n) {
        if ((w[i] & 0xFFFF) != spirv.OP_FUNCTION_PARAMETER) { ret k == argc; }
        if (k >= argc)                                      { ret false; }
        val pty: u32 = w[i + 1];
        val pid: u32 = w[i + 2];
        val aid: u32 = w[arg_first + k];
        if (pty >= UT_AGG_IDS || pid >= UT_AGG_IDS || aid >= UT_AGG_IDS) { ret false; }
        if (st.ty_kind[pty] == UT_AGG_TY_PTR) {
            if (!st.is_ptr[aid] || st.ptr_ty[aid] != st.ty_elem[pty]) { ret false; }
            st.is_ptr[pid]  = true;
            st.ptr_blk[pid] = st.ptr_blk[aid];
            st.ptr_off[pid] = st.ptr_off[aid];
            st.ptr_ty[pid]  = st.ptr_ty[aid];
        }
        or {
            if (!ut_agg_copy(st, pid, 0, aid, 0, st.ty_words[pty])) { ret false; }
        }
        st.val_ty[pid] = pty;
        k              = k + 1;
        i              = i + (w[i] >> 16);
    }
    ret false;
}

#[testing]
fun ut_agg_exec(st: *UtAggEval, w: *u32, n: u32, entry: u32) bool {
    var i: u32 = ut_agg_body_start(st, w, n, entry);
    if (i == 0) { ret false; }

    var sp:    u32 = 0;
    var r_ix:  [4]u32;
    var r_res: [4]u32;
    var r_ty:  [4]u32;
    var steps: u32 = 0;

    for (i < n) {
        steps = steps + 1;
        if (steps > 100000) { ret false; }
        val len: u32 = w[i] >> 16;
        if (len == 0) { ret false; }
        val op: u32 = w[i] & 0xFFFF;

        if (op == spirv.OP_LABEL || op == spirv.OP_VARIABLE) {
            i = i + len;
            cnt;
        }

        if (op == spirv.OP_ACCESS_CHAIN) {
            val outcome_r: u32 = w[i + 2];
            val base:      u32 = w[i + 3];
            if (outcome_r >= UT_AGG_IDS || base >= UT_AGG_IDS || !st.is_ptr[base]) { ret false; }
            var cur_off: u32 = st.ptr_off[base];
            var cur_ty:  u32 = st.ptr_ty[base];
            var k:       u32 = 0;
            for (k < len - 4) {
                val ixid: u32 = w[i + 4 + k];
                if (ixid >= UT_AGG_IDS) { ret false; }
                var moff: u32 = 0;
                var mty:  u32 = 0;
                if (!ut_agg_member(st, cur_ty, st.val[ixid * UT_AGG_WORDS]::u32, ?moff, ?mty)) { ret false; }
                cur_off = cur_off + moff;
                cur_ty  = mty;
                k       = k + 1;
            }
            st.is_ptr[outcome_r]  = true;
            st.ptr_blk[outcome_r] = st.ptr_blk[base];
            st.ptr_off[outcome_r] = cur_off;
            st.ptr_ty[outcome_r]  = cur_ty;
            i                     = i + len;
            cnt;
        }

        if (op == spirv.OP_LOAD) {
            val ty:        u32 = w[i + 1];
            val outcome_r: u32 = w[i + 2];
            val ptr:       u32 = w[i + 3];
            if (ty >= UT_AGG_IDS || outcome_r >= UT_AGG_IDS || ptr >= UT_AGG_IDS || !st.is_ptr[ptr]) { ret false; }
            if (!ut_agg_copy(st, outcome_r, 0, st.ptr_blk[ptr], st.ptr_off[ptr], st.ty_words[ty]))   { ret false; }
            st.val_ty[outcome_r] = ty;
            i                    = i + len;
            cnt;
        }

        if (op == spirv.OP_STORE) {
            val ptr: u32 = w[i + 1];
            val v:   u32 = w[i + 2];
            if (ptr >= UT_AGG_IDS || v >= UT_AGG_IDS || !st.is_ptr[ptr])                               { ret false; }
            if (!ut_agg_copy(st, st.ptr_blk[ptr], st.ptr_off[ptr], v, 0, st.ty_words[st.ptr_ty[ptr]])) { ret false; }
            i = i + len;
            cnt;
        }

        if (op == spirv.OP_I_ADD || op == spirv.OP_I_MUL) {
            val ty:        u32 = w[i + 1];
            val outcome_r: u32 = w[i + 2];
            val a:         u32 = w[i + 3];
            val b:         u32 = w[i + 4];
            if (ty >= UT_AGG_IDS || outcome_r >= UT_AGG_IDS || a >= UT_AGG_IDS || b >= UT_AGG_IDS) { ret false; }
            if (st.ty_words[ty] != 1)                                                              { ret false; }
            val x: u64 = st.val[a * UT_AGG_WORDS];
            val y: u64 = st.val[b * UT_AGG_WORDS];
            if (op == spirv.OP_I_ADD) { st.val[outcome_r * UT_AGG_WORDS] = ut_agg_mask(st, ty, x + y); }
            or                        { st.val[outcome_r * UT_AGG_WORDS] = ut_agg_mask(st, ty, x * y); }
            st.val_ty[outcome_r] = ty;
            i                    = i + len;
            cnt;
        }

        if (op == spirv.OP_U_CONVERT || op == spirv.OP_BITCAST) {
            val ty:        u32 = w[i + 1];
            val outcome_r: u32 = w[i + 2];
            val src:       u32 = w[i + 3];
            if (ty >= UT_AGG_IDS || outcome_r >= UT_AGG_IDS || src >= UT_AGG_IDS) { ret false; }
            if (st.ty_words[ty] != 1)                                             { ret false; }
            st.val[outcome_r * UT_AGG_WORDS] = ut_agg_mask(st, ty, st.val[src * UT_AGG_WORDS]);
            st.val_ty[outcome_r]             = ty;
            i                                = i + len;
            cnt;
        }

        if (op == spirv.OP_COPY_LOGICAL) {
            val ty:        u32 = w[i + 1];
            val outcome_r: u32 = w[i + 2];
            val src:       u32 = w[i + 3];
            if (ty >= UT_AGG_IDS || outcome_r >= UT_AGG_IDS || src >= UT_AGG_IDS)      { ret false; }
            if (st.val_ty[src] == 0 || st.ty_words[st.val_ty[src]] != st.ty_words[ty]) { ret false; }
            if (!ut_agg_copy(st, outcome_r, 0, src, 0, st.ty_words[ty]))               { ret false; }
            st.val_ty[outcome_r] = ty;
            i                    = i + len;
            cnt;
        }

        if (op == spirv.OP_COMPOSITE_EXTRACT) {
            val ty:        u32 = w[i + 1];
            val outcome_r: u32 = w[i + 2];
            val c:         u32 = w[i + 3];
            if (ty >= UT_AGG_IDS || outcome_r >= UT_AGG_IDS || c >= UT_AGG_IDS || st.val_ty[c] == 0) { ret false; }
            var cur_off: u32 = 0;
            var cur_ty:  u32 = st.val_ty[c];
            var k:       u32 = 0;
            for (k < len - 4) {
                var moff: u32 = 0;
                var mty:  u32 = 0;
                if (!ut_agg_member(st, cur_ty, w[i + 4 + k], ?moff, ?mty)) { ret false; }
                cur_off = cur_off + moff;
                cur_ty  = mty;
                k       = k + 1;
            }
            if (!ut_agg_copy(st, outcome_r, 0, c, cur_off, st.ty_words[ty])) { ret false; }
            st.val_ty[outcome_r] = ty;
            i                    = i + len;
            cnt;
        }

        if (op == spirv.OP_COMPOSITE_CONSTRUCT) {
            val ty:        u32 = w[i + 1];
            val outcome_r: u32 = w[i + 2];
            if (ty >= UT_AGG_IDS || outcome_r >= UT_AGG_IDS) { ret false; }
            var off: u32 = 0;
            var k:   u32 = 0;
            for (k < len - 3) {
                val c: u32 = w[i + 3 + k];
                if (c >= UT_AGG_IDS || st.val_ty[c] == 0) { ret false; }
                val cw: u32 = st.ty_words[st.val_ty[c]];
                if (!ut_agg_copy(st, outcome_r, off, c, 0, cw)) { ret false; }
                off = off + cw;
                k   = k + 1;
            }
            st.val_ty[outcome_r] = ty;
            i                    = i + len;
            cnt;
        }

        if (op == spirv.OP_FUNCTION_CALL) {
            if (sp >= UT_AGG_DEPTH || len < 4) { ret false; }
            r_ix[sp]  = i + len;
            r_res[sp] = w[i + 2];
            r_ty[sp]  = w[i + 1];
            sp        = sp + 1;
            if (!ut_agg_bind_params(st, w, n, w[i + 3], i + 4, len - 4)) { ret false; }
            val b: u32 = ut_agg_body_start(st, w, n, w[i + 3]);
            if (b == 0) { ret false; }
            i = b;
            cnt;
        }

        if (op == spirv.OP_RETURN_VALUE) {
            val v: u32 = w[i + 1];
            if (sp == 0) { ret true; }
            sp = sp - 1;
            if (v >= UT_AGG_IDS || r_res[sp] >= UT_AGG_IDS || r_ty[sp] >= UT_AGG_IDS) { ret false; }
            if (!ut_agg_copy(st, r_res[sp], 0, v, 0, st.ty_words[r_ty[sp]]))          { ret false; }
            st.val_ty[r_res[sp]] = r_ty[sp];
            i                    = r_ix[sp];
            cnt;
        }

        if (op == spirv.OP_RETURN) {
            if (sp == 0) { ret true; }
            sp = sp - 1;
            if (r_ty[sp] >= UT_AGG_IDS || st.ty_kind[r_ty[sp]] != UT_AGG_TY_VOID) { ret false; }
            i = r_ix[sp];
            cnt;
        }

        print.eprintlnf("SPIR-V fixture cannot interpret opcode {} at word {}", op, i);
        ret false;
    }
    ret false;
}

#[testing]
fun ut_spv_read_location(alloc: *A.Allocator, img: *of.ObjectImage, loc: u32) u64 {
    var n: u32  = 0;
    val w: *u32 = ut_spv_words(img, ?n);
    if (w == nil || n == 0) { ret UT_AGG_BAD; }

    val ar: res[*UtAggEval, A.Error] = A.allocate[UtAggEval](alloc, 1::usize);
    if (sel ar.err) { ret UT_AGG_BAD; }
    val st: *UtAggEval = ar.ok;
    ut_agg_reset(st);

    var out:   u64 = UT_AGG_BAD;
    val tgt:   u32 = ut_agg_location_var(w, n, loc);
    val entry: u32 = ut_agg_entry_fn(w, n);
    if (ut_agg_prepare(st, w, n) && tgt != 0 && tgt < UT_AGG_IDS && entry != 0
        && ut_agg_exec(st, w, n, entry)) {
        if (st.is_ptr[tgt] && st.ty_words[st.ptr_ty[tgt]] == 1) {
            out = st.val[st.ptr_blk[tgt] * UT_AGG_WORDS + st.ptr_off[tgt]];
        }
    }

    A.deallocate[UtAggEval](alloc, st, 1::usize);
    ret out;
}

test aggregate__crosses_a_call_by_value {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    var texts: [1]str;
    names[0] = "main.mach";
    texts[0] = ut_agg_call_src();
    val pr: res[project.Project, outcome.Fail] = ut_spv_lower(?s, ?alloc, ?names[0], ?texts[0], 1, "", nil, nil, 0);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    var img:   of.ObjectImage;
    var fault: str = nil;
    if (!ut_spv_codegen(?p, ?s, "spvcase.main", ?img, ?fault)) {
        project.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }

    var bad: i32 = 0;
    if (ut_spv_read_location(?alloc, ?img, 0) != 67)       { bad = 1; }
    if (ut_spv_read_location(?alloc, ?img, 1) != 67)       { bad = 1; }
    if (ut_spv_read_location(?alloc, ?img, 2) != 67)       { bad = 1; }
    if (ut_spv_read_location(?alloc, ?img, 3) != 87654321) { bad = 1; }
    if (ut_spv_read_location(?alloc, ?img, 4) != 87654321) { bad = 1; }
    if (ut_spv_read_location(?alloc, ?img, 5) != 234)      { bad = 1; }
    if (ut_spv_read_location(?alloc, ?img, 6) != 234)      { bad = 1; }
    if (ut_spv_read_location(?alloc, ?img, 7) != 56789)    { bad = 1; }
    if (ut_spv_read_location(?alloc, ?img, 8) != 56789)    { bad = 1; }
    if (ut_spv_read_location(?alloc, ?img, 9) != 15432)    { bad = 1; }
    if (ut_spv_read_location(?alloc, ?img, 10) != 15432)   { bad = 1; }

    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

#[testing]
fun ut_release_vector_count(alloc: *A.Allocator, src: str, tname: str, out: *u32) i32 {
    val sr: res[session.Session, fail.Fail] = session.init(alloc);
    if (sel sr.err) { ret 1; }
    var s:  session.Session                    = sr.ok;
    val pr: res[project.Project, outcome.Fail] = ut_vec_lower(?s, alloc, src, tname);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    var mi: u32 = 0;
    for (mi < project.module_count(?p)) {
        val me: *project.ModuleEntry = project.module_at(?p, mi);
        if (me.ir_module == nil) {
            mi = mi + 1;
            cnt;
        }
        var preq: pipeline.PipelineRequest;
        preq.module            = me.ir_module;
        preq.target            = ?p.target;
        preq.level             = pipeline.OPT_RELEASE;
        preq.vectorize_enabled = pipeline.VectorizeEnabledOption{v: true};
        preq.simd_require      = pipeline.SimdRequireOption{v: false};
        preq.float_reassoc     = pipeline.FloatReassocOption{v: false};
        preq.interner          = ?s.interner;
        preq.source_map        = ?s.sources;
        preq.diags             = ?s.diags;
        val rr: res[bool, fail.Fail] = pipeline.run(?preq);
        if (sel rr.err) {
            project.dnit_project(?p);
            session.dnit(?s);
            ret 1;
        }
        mi = mi + 1;
    }
    @out = ut_count_vector_typed_instrs(?p);
    project.dnit_project(?p);
    session.dnit(?s);
    ret 0;
}

test vectorize__off_under_logical_addressing {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val src: str = "fun scale(a: *u32, b: *u32, n: u64) {\n    var i: u64 = 0;\n    for (i < n) { b[i] = a[i] + 1; i = i + 1; }\n}\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { scale(argv:~*u32, argv:~*u32, 8); ret 0; }\n";

    var flat:    u32 = 0;
    var logical: u32 = 0;
    if (ut_release_vector_count(?alloc, src, "linux", ?flat) != 0)    { ret 2; }
    if (ut_release_vector_count(?alloc, src, "spirv", ?logical) != 0) { ret 3; }
    if (flat == 0)                                                    { ret 4; }
    if (logical != 0)                                                 { ret 5; }
    ret 0;
}

#[testing]
fun ut_spv_defines_typed_value(op: u32) bool {
    ret op == spirv.OP_LOAD || op == spirv.OP_CONSTANT || op == spirv.OP_FUNCTION_PARAMETER
        || op == spirv.OP_I_ADD || op == spirv.OP_I_SUB || op == spirv.OP_I_MUL
        || op == spirv.OP_BITCAST || op == spirv.OP_COMPOSITE_EXTRACT;
}

#[testing]
fun ut_spv_value_type(w: *u32, n: u32, id: u32) u32 {
    if (id == 0) { ret 0; }
    var i: u32 = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0) { ret 0; }
        if (len >= 3 && w[i + 2] == id && ut_spv_defines_typed_value(w[i] & 0xFFFF)) {
            ret w[i + 1];
        }
        i = i + len;
    }
    ret 0;
}

#[testing]
fun ut_spv_is_binary_int(op: u32) bool {
    ret op == spirv.OP_I_ADD || op == spirv.OP_I_SUB || op == spirv.OP_I_MUL
        || op == spirv.OP_U_LESS_THAN || op == spirv.OP_S_LESS_THAN
        || op == spirv.OP_I_EQUAL || op == spirv.OP_I_NOT_EQUAL;
}

#[testing]
fun ut_spv_mixed_operand_types(w: *u32, n: u32) u32 {
    var i: u32 = 0;
    var c: u32 = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0) { ret c; }
        if (len == 5 && ut_spv_is_binary_int(w[i] & 0xFFFF)) {
            val ta: u32 = ut_spv_value_type(w, n, w[i + 3]);
            val tb: u32 = ut_spv_value_type(w, n, w[i + 4]);
            if (ta != 0 && tb != 0 && ta != tb) { c = c + 1; }
        }
        i = i + len;
    }
    ret c;
}

#[testing]
fun ut_spv_int_type_count(w: *u32, n: u32, bits: u32) u32 {
    var i: u32 = 0;
    var c: u32 = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0)                                                             { ret c; }
        if ((w[i] & 0xFFFF) == spirv.OP_TYPE_INT && len >= 3 && w[i + 2] == bits) { c = c + 1; }
        i = i + len;
    }
    ret c;
}

#[testing]
fun ut_spv_bitcasts_keeping_source_type(w: *u32, n: u32) u32 {
    var i: u32 = 0;
    var c: u32 = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0) { ret c; }
        if ((w[i] & 0xFFFF) == spirv.OP_BITCAST && len == 4) {
            val st: u32 = ut_spv_value_type(w, n, w[i + 3]);
            if (st != 0 && st == w[i + 1]) { c = c + 1; }
        }
        i = i + len;
    }
    ret c;
}

test int_width__narrow_loop_counter_keeps_its_width {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    var texts: [1]str;
    names[0] = "main.mach";
    texts[0] = "pub fun c8() u8 { var i: u8 = 0; for (i < 32) { i = i + 1; } ret i; }\n\npub fun s8() i8 { var i: i8 = 0; for (i < 32) { i = i + 1; } ret i; }\n\npub fun c16() u16 { var i: u16 = 0; for (i < 32) { i = i + 1; } ret i; }\n\npub fun s16() i16 { var i: i16 = 0; for (i < 32) { i = i + 1; } ret i; }\n";
    val pr: res[project.Project, outcome.Fail] = ut_spv_lower(?s, ?alloc, ?names[0], ?texts[0], 1, "", nil, nil, 0);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    var bad:   i32 = 0;
    var img:   of.ObjectImage;
    var fault: str = nil;
    if (!ut_spv_codegen(?p, ?s, "spvcase.main", ?img, ?fault)) {
        project.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }
    var n: u32  = 0;
    val w: *u32 = ut_spv_words(?img, ?n);
    if (w == nil) {
        obj.dnit(?img);
        project.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }

    if (ut_spv_count(w, n, spirv.OP_U_LESS_THAN) != 2) { bad = 1; }
    if (ut_spv_count(w, n, spirv.OP_S_LESS_THAN) != 2) { bad = 1; }
    if (ut_spv_int_type_count(w, n, 8) != 1)           { bad = 1; }
    if (ut_spv_int_type_count(w, n, 16) != 1)          { bad = 1; }
    or {
        if (ut_spv_mixed_operand_types(w, n) != 0) { bad = 1; }
        if (ut_spv_int_type_count(w, n, 64) != 0)  { bad = 1; }
    }

    obj.dnit(?img);
    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

test int_width__loop_carried_scalar_keeps_its_type {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    var texts: [1]str;
    names[0] = "main.mach";
    texts[0] = "#[input(0)] var in_uv: f32x2;\n#[output(0)] var out_colour: f32x4;\n\n#[stage(\"fragment\")]\nfun frag_main() {\n    var state: i32 = 0;\n    if (in_uv[0] < 0.5) { state = 1; }\n    var i: i32 = 0;\n    for (i < 2) {\n        if (state != 0::i32) { state = 0; }\n        i = i + 1;\n    }\n    out_colour = f32x4{state::f32, 0.0, 0.0, 1.0};\n}\n";
    val pr: res[project.Project, outcome.Fail] = ut_spv_lower(?s, ?alloc, ?names[0], ?texts[0], 1, "", nil, nil, 0);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    var bad:   i32 = 0;
    var img:   of.ObjectImage;
    var fault: str = nil;
    if (!ut_spv_codegen(?p, ?s, "spvcase.main", ?img, ?fault)) {
        project.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }
    var n: u32  = 0;
    val w: *u32 = ut_spv_words(?img, ?n);
    if (w == nil) {
        obj.dnit(?img);
        project.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }

    if (ut_spv_count(w, n, spirv.OP_I_NOT_EQUAL) != 1) { bad = 1; }
    or {
        if (ut_spv_mixed_operand_types(w, n) != 0) { bad = 1; }
        if (ut_spv_int_type_count(w, n, 32) != 1)  { bad = 1; }
        if (ut_spv_int_type_count(w, n, 64) != 0)  { bad = 1; }
    }

    obj.dnit(?img);
    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

