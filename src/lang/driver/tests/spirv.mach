#[testing]
rec UtSeed {
    set:   u32;
    bind:  u32;
    words: *u64;
    n:     u32;
}

#[testing]
fun ut_spv_read_seeded(alloc: *A.Allocator, img: *of.ObjectImage, loc: u32,
    seeds: *UtSeed, ns: u32) u64 {
    var n: u32  = 0;
    val w: *u32 = ut_spv_words(img, ?n);
    if (w == nil || n == 0) { ret UT_AGG_BAD; }

    val ar: res[*UtAggEval, A.Error] = A.allocate[UtAggEval](alloc, 1::usize);
    if (sel ar.err) { ret UT_AGG_BAD; }
    val st: *UtAggEval = ar.ok;
    ut_agg_reset(st);

    var out:    u64  = UT_AGG_BAD;
    val tgt:    u32  = ut_agg_location_var(w, n, loc);
    val entry:  u32  = ut_agg_entry_fn(w, n);
    var seeded: bool = true;
    if (ut_agg_prepare(st, w, n)) {
        var i: u32 = 0;
        for (i < ns) {
            val sd: *UtSeed = ?seeds[i];
            val v:  u32     = ut_spv_descriptor_var(w, n, sd.set, sd.bind);
            if (v == 0 || v >= UT_AGG_IDS || sd.n > UT_AGG_WORDS) {
                seeded = false;
                i      = ns;
                cnt;
            }
            var k: u32 = 0;
            for (k < sd.n) {
                st.val[v * UT_AGG_WORDS + k] = sd.words[k];
                k                            = k + 1;
            }
            i = i + 1;
        }
    }
    or { seeded = false; }
    if (seeded && tgt != 0 && tgt < UT_AGG_IDS && entry != 0 && ut_agg_exec(st, w, n, entry)) {
        if (st.is_ptr[tgt] && st.ty_words[st.ptr_ty[tgt]] == 1) {
            out = st.val[st.ptr_blk[tgt] * UT_AGG_WORDS + st.ptr_off[tgt]];
        }
    }

    A.deallocate[UtAggEval](alloc, st, 1::usize);
    ret out;
}

#[testing]
fun ut_spv_descriptor_value_src() str {
    ret "rec Blk { a: u32; b: u32; c: u32; }\nrec Plain { tag: u8; v: u32; tail: u8; }\n\n#[uniform(0, 0)] var ub: Blk;\n#[storage(1, 0, \"readonly\")] var sb: Blk;\n\nfun sum_blk(p: Blk) u32 { ret p.a + p.b * 10 + p.c * 100; }\nfun sum_plain(p: Plain) u32 { ret p.tag::u32 + p.v * 10 + p.tail::u32 * 100; }\n\n#[output(0)] var o_ub: u32;\n#[output(1)] var o_ub_ctl: u32;\n#[output(2)] var o_sb: u32;\n#[output(3)] var o_sb_ctl: u32;\n#[output(4)] var o_ub_copy: u32;\n#[output(5)] var o_rec: u32;\n#[output(6)] var o_rec_ctl: u32;\n\n#[stage(\"vertex\")]\nfun vs() {\n    o_ub = sum_blk(ub);\n    o_ub_ctl = ub.a + ub.b * 10 + ub.c * 100;\n    o_sb = sum_blk(sb);\n    o_sb_ctl = sb.a + sb.b * 10 + sb.c * 100;\n    var l: Blk = ub;\n    o_ub_copy = l.a + l.b * 10 + l.c * 100;\n    var r: Plain;\n    r.tag = ub.a::u8;\n    r.v = ub.b;\n    r.tail = ub.c::u8;\n    var r2: Plain = r;\n    o_rec = sum_plain(r2);\n    o_rec_ctl = r.tag::u32 + r.v * 10 + r.tail::u32 * 100;\n}\n\nfun main() i32 { ret 0; }\n";
}

test aggregate__descriptor_block_crosses_a_call_by_value {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    var texts: [1]str;
    names[0] = "main.mach";
    texts[0] = ut_spv_descriptor_value_src();
    val pr: res[project.Project, outcome.Fail] = ut_spv_lower(?s, ?alloc, ?names[0], ?texts[0], 1, "", nil, nil, 0);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    var img:   of.ObjectImage;
    var fault: str = nil;
    if (!ut_spv_codegen(?p, ?s, "spvcase.main", ?img, ?fault)) {
        project.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }

    var uw: [3]u64;
    uw[0] = 3::u64;
    uw[1] = 4::u64;
    uw[2] = 5::u64;
    var sw: [3]u64;
    sw[0] = 6::u64;
    sw[1] = 7::u64;
    sw[2] = 8::u64;
    var seeds: [2]UtSeed;
    seeds[0].set   = 0;
    seeds[0].bind  = 0;
    seeds[0].words = ?uw[0];
    seeds[0].n     = 3;
    seeds[1].set   = 1;
    seeds[1].bind  = 0;
    seeds[1].words = ?sw[0];
    seeds[1].n     = 3;

    var bad: i32  = 0;
    var wn:  u32  = 0;
    val ww:  *u32 = ut_spv_words(?img, ?wn);
    if (ww == nil || wn == 0 || !ut_spv_var_loads_typed(ww, wn)) { bad = 1; }

    if (ut_spv_read_seeded(?alloc, ?img, 0, ?seeds[0], 2) != 543) { bad = 1; }
    if (ut_spv_read_seeded(?alloc, ?img, 1, ?seeds[0], 2) != 543) { bad = 1; }
    if (ut_spv_read_seeded(?alloc, ?img, 2, ?seeds[0], 2) != 876) { bad = 1; }
    if (ut_spv_read_seeded(?alloc, ?img, 3, ?seeds[0], 2) != 876) { bad = 1; }
    if (ut_spv_read_seeded(?alloc, ?img, 4, ?seeds[0], 2) != 543) { bad = 1; }
    if (ut_spv_read_seeded(?alloc, ?img, 5, ?seeds[0], 2) != 543) { bad = 1; }
    if (ut_spv_read_seeded(?alloc, ?img, 6, ?seeds[0], 2) != 543) { bad = 1; }

    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

#[testing]
fun ut_spv_var_pointee(w: *u32, n: u32, var_id: u32) u32 {
    var ptr_ty: u32 = 0;
    var i:      u32 = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0) { ret 0; }
        if ((w[i] & 0xFFFF) == spirv.OP_VARIABLE && len >= 3 && w[i + 2] == var_id) {
            ptr_ty = w[i + 1];
            i      = n;
            cnt;
        }
        i = i + len;
    }
    if (ptr_ty == 0) { ret 0; }
    i = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0) { ret 0; }
        if ((w[i] & 0xFFFF) == spirv.OP_TYPE_POINTER && len == 4 && w[i + 1] == ptr_ty) {
            ret w[i + 3];
        }
        i = i + len;
    }
    ret 0;
}

#[testing]
fun ut_spv_var_loads_typed(w: *u32, n: u32) bool {
    var i: u32 = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0) { ret false; }
        if ((w[i] & 0xFFFF) == spirv.OP_LOAD && len >= 4) {
            val pointee: u32 = ut_spv_var_pointee(w, n, w[i + 3]);
            if (pointee != 0 && pointee != w[i + 1]) { ret false; }
        }
        i = i + len;
    }
    ret true;
}

