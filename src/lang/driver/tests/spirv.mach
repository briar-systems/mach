# the error carrying `needle` is located somewhere in the file whose path ends
# with `path_suffix`
#[testing]
fun ut_diag_located_in(s: *session.Session, needle: str, path_suffix: str) bool {
    var i: usize = 0;
    for (i < diagnostic.len(?s.diags)) {
        val d: *diagnostic.Diagnostic = ?s.diags.items.data[i];
        i = i + 1;
        if (d.severity != diagnostic.SEVERITY_ERROR) { cnt; }
        if (!ut_str_contains(d.message, needle))     { cnt; }
        val sf: opt[*src.SourceFile] = src.get(?s.sources, d.loc.file_id);
        if (sel sf.none)                                 { cnt; }
        if (ut_str_ends_with(sf.some.path, path_suffix)) { ret true; }
    }
    ret false;
}

#[testing]
rec UtMirShape {
    modules:     u32;
    max_gep:     u32;
    memzero:     u32;
    typed_slots: u32;
    memcpy:      u32;
    loads:       u32;
    sym_addr:    u32;
    aggregate:   u32;
}

#[testing]
fun ut_mir_count(mm: *mir.MirModule, flat: bool, out: *UtMirShape) {
    var fi: u32 = 0;
    for (fi < mm.function_len) {
        val mf: *mir.MirFunction = ?mm.functions[fi];
        var si: u32              = 0;
        for (si < mf.frame.slot_count) {
            val sl: *mir.MirSlot = ?mf.frame.slots[si];
            if (sl.kind == mir.SLOT_ALLOCA && sl.ty != mir.SLOT_TY_NIL) { out.typed_slots = out.typed_slots + 1; }
            si = si + 1;
        }
        var bi: u32 = 0;
        for (bi < mf.block_count) {
            val blk: *mir.MirBlock = ?mf.blocks[bi];
            var ii:  u32           = 0;
            for (ii < blk.instr_count) {
                val mi: *mir.MirInstr = ?blk.instrs[ii];
                if (mi.opcode == mir.MIR_GEP && mi.operand_count > out.max_gep) { out.max_gep = mi.operand_count; }
                if (mi.opcode == mir.MIR_MEMZERO)                               { out.memzero = out.memzero + 1; }
                if (mi.opcode == mir.MIR_MEMCPY)                                { out.memcpy = out.memcpy + 1; }
                if (mi.opcode == mir.MIR_LOAD)                                  { out.loads = out.loads + 1; }
                if (mi.opcode == mir.MIR_GEP && mi.operand_count == 2
                    && mi.operands[1].kind == mir.MIR_OP_SYM) { out.sym_addr = out.sym_addr + 1; }
                if (flat && mi.opcode == mir.MIR_LOAD && mi.operand_count == 2
                    && mi.operands[1].kind == mir.MIR_OP_SYM) { out.sym_addr = out.sym_addr + 1; }
                if (flat && mi.opcode == mir.MIR_STORE && mi.operand_count == 2
                    && mi.operands[0].kind == mir.MIR_OP_SYM) { out.sym_addr = out.sym_addr + 1; }
                if (mi.opcode == mir.MIR_VALUE_CALL || mi.opcode == mir.MIR_VALUE_PARAM
                    || mi.opcode == mir.MIR_MEMCPY || mi.opcode == mir.MIR_MEMZERO) { out.aggregate = out.aggregate + 1; }
                ii = ii + 1;
            }
            bi = bi + 1;
        }
        fi = fi + 1;
    }
}

# lowers `src` for `tname` to MIR and counts its shapes over every module; false when nothing lowered
#[testing]
fun ut_mir_shape(alloc: *A.Allocator, src: str, tname: str, out: *UtMirShape) bool {
    @out = UtMirShape{modules: 0, max_gep: 0, memzero: 0, typed_slots: 0, memcpy: 0, loads: 0, sym_addr: 0, aggregate: 0};
    val sr: res[session.Session, fail.Fail] = session.init(alloc);
    if (sel sr.err) { ret false; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    val pr: res[project.Project, outcome.Fail] = ut_vec_lower(?s, alloc, src, tname);
    if (sel pr.err) { ret false; }
    var p: project.Project = pr.ok;
    fin { project.dnit_project(?p); }
    var mi: u32 = 0;
    for (mi < project.module_count(?p)) {
        val me: *project.ModuleEntry = project.module_at(?p, mi);
        mi = mi + 1;
        if (me.ir_module == nil) { cnt; }
        val mr: res[mir.MirModule, fail.Fail] = mirlower.lower_module(?p.target, me.ir_module, alloc, ?s.interner, ?s.sources, ?s.diags);
        if (sel mr.err) { cnt; }
        var mm: mir.MirModule = mr.ok;
        out.modules = out.modules + 1;
        ut_mir_count(?mm, p.target.isa.model.flat_addressing, out);
    }
    ret out.modules > 0;
}

# logical addressing keeps typed allocas, whole aggregate copies, gep index lists and symbol
# addresses as aggregates, where a flat target zeroes, loads, flattens and materializes them
test mir_lower__logical_addressing_keeps_typed_shapes {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var sh: UtMirShape;

    val zs: str = "rec Pair { a: i64; b: i64; }\n#[output(0)] var o: i32;\n#[stage(\"vertex\")]\nfun vs() { var p: Pair; var v: f32x4; o = p.a::i32; }\nfun main() i32 { ret 0; }\n";
    val zf: str = "rec Pair { a: i64; b: i64; }\nfun rd() i64 { var p: Pair; var q: Pair; ret p.a + q.b; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret rd()::i32; }\n";
    if (!ut_mir_shape(?alloc, zs, "spirv", ?sh) || sh.memzero < 1 || sh.typed_slots < 1)  { ret 2; }
    if (!ut_mir_shape(?alloc, zf, "linux", ?sh) || sh.memzero != 0 || sh.typed_slots < 1) { ret 3; }

    val gs: str = "rec Inner { a: i64; b: i64; }\nrec Outer { x: Inner; y: i64; }\n#[uniform(0, 0)] var g: Outer;\n#[output(0)] var o: i32;\n#[stage(\"vertex\")]\nfun vs() { o = g.x.a::i32; }\nfun main() i32 { ret 0; }\n";
    val gf: str = "rec Inner { a: i64; b: i64; }\nrec Outer { x: Inner; y: i64; }\nvar g: Outer;\nfun rd() i64 { ret g.x.a; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret rd()::i32; }\n";
    if (!ut_mir_shape(?alloc, gs, "spirv", ?sh) || sh.max_gep <= 2) { ret 4; }
    if (!ut_mir_shape(?alloc, gf, "linux", ?sh) || sh.max_gep != 2) { ret 5; }

    val cf: str = "fun rd() u32 {\n    val lit: [4]u32 = [4]u32{7, 6, 5, 4};\n    ret lit[0] + lit[1] * 10 + lit[2] * 100 + lit[3] * 1000;\n}\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret rd()::i32; }\n";
    if (!ut_mir_shape(?alloc, ut_spv_array_init_src(), "spirv", ?sh) || sh.memcpy < 1) { ret 6; }
    if (!ut_mir_shape(?alloc, cf, "linux", ?sh) || sh.memcpy != 0 || sh.loads < 2)     { ret 7; }

    val ss: str = "rec P { a: u32; b: u32; }\n#[uniform(0, 0)] var blk: P;\nfun sum(p: P) u32 { ret p.a + p.b * 10; }\n#[output(0)] var o: u32;\n#[stage(\"vertex\")]\nfun vs() { o = sum(blk); }\nfun main() i32 { ret 0; }\n";
    val sf: str = "rec P { a: u32; b: u32; }\nvar g: P;\nfun sum(p: P) u32 { ret p.a + p.b * 10; }\nfun rd() u32 { ret sum(g); }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret rd()::i32; }\n";
    if (!ut_mir_shape(?alloc, ss, "spirv", ?sh) || sh.sym_addr != 0 || sh.aggregate < 1) { ret 8; }
    if (!ut_mir_shape(?alloc, sf, "linux", ?sh) || sh.sym_addr < 1 || sh.aggregate != 0) { ret 9; }
    ret 0;
}

test oblivious__refused_on_spirv {
    var bad:    i32          = 0;
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    val obl: str = "#[oblivious]\nfun mask(a: ^u32, b: ^u32) ^u32 { ret a ^ b; }\nfun main() i32 { ret 0; }\n";

    if (ut_codegen_target_ok(obl, "linux") != 0) { bad = 1; }

    val ps: res[project.Project, outcome.Fail] = ut_ct_edge_project(?s, ?alloc, obl, "spv");
    if (sel ps.err) { bad = 1; }
    if (sel ps.ok) {
        var p: project.Project = ps.ok;
        if (ut_run_codegen_err(?p, "cannot be compiled for the `spirv` target") != 0) { bad = 1; }
        project.dnit_project(?p);
    }

    val pt: res[project.Project, outcome.Fail] = ut_ct_edge_project(?s, ?alloc,
        "fun down(a: ^u32) u32 { ret a:>u32; }\nfun main() i32 { ret 0; }\n", "spv");
    if (sel pt.err) { bad = 1; }
    if (sel pt.ok) {
        var p2: project.Project = pt.ok;
        if (ut_run_codegen_ok(?p2) != 0) { bad = 1; }
        project.dnit_project(?p2);
    }

    session.dnit(?s);
    ret bad;
}

#[testing]
fun ut_spirv_env_manifest(alloc: *A.Allocator, env_line: str) str {
    ret ut_cc3(alloc, "[project]\nmach = \">=5\"\nid = \"envtest\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.gpu]\nisa = \"spirv\"\nos = \"freestanding\"\nabi = \"spirv\"\n", env_line, "\n[artifact.k]\nkind = \"bin\"\nentry = \"k.mach\"\nout = \"k.spv\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n");
}

#[testing]
fun ut_spirv_env_build(alloc: *A.Allocator, env_line: str, needle: str, want_version: u32) i32 {
    val sr: res[session.Session, fail.Fail] = session.init(alloc);
    if (sel sr.err) { ret 1; }
    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [1]str;
    names[0] = "k.mach";
    var texts: [1]str;
    texts[0] = "#[output(0)] var out_colour: f32x4;\n\n#[stage(\"fragment\")]\nfun frag_main() {\n    var small: u8 = 3;\n    small = small + 1;\n    out_colour = f32x4{small::f32, 0.0, 0.0, 1.0};\n}\n";
    val root_r: res[str, fail.Fail] = ut_scaffold_m(alloc, ut_spirv_env_manifest(alloc, env_line), ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    var bad:  i32 = 0;
    var pick: manifest.Selection;
    pick.target       = "gpu";
    pick.profile      = "";
    pick.artifact     = "";
    pick.want_lib     = false;
    pick.has_artifact = false;
    val pr: res[project.Project, outcome.Fail] = driver.build_project_sel(?s, root, ?pick);
    if (sel pr.err) {
        val f: outcome.Fail = pr.err;
        if (str_empty(needle) || sel f.reported || !ut_str_contains(outcome.describe(f), needle)) {
            print.print(outcome.describe(f));
            print.print("\n");
            bad = 2;
        }
    }
    if (sel pr.ok) {
        var p:  project.Project   = pr.ok;
        val se: err[outcome.Fail] = driver.run_sema_pass(?p);
        val le: err[outcome.Fail] = driver.run_lower_pass(?p);
        val ce: err[outcome.Fail] = driver.run_codegen_pass(?p);
        if (sel se.err || sel le.err) { bad = 3; }
        or (!str_empty(needle)) {
            if (sel ce.ok) { bad = 4; }
            or (sel ce.err) {
                if (!ut_str_contains(ut_codegen_outcome_text(?s, ce.err), needle)) {
                    print.print(ut_codegen_outcome_text(?s, ce.err));
                    print.print("\n");
                    bad = 5;
                }
            }
        }
        or {
            if (sel ce.err) {
                print.print(outcome.describe(ce.err));
                print.print("\n");
                bad = 6;
            }
            if (sel ce.ok) {
                var m:     *project.ModuleEntry       = nil;
                val fqn_r: res[intern.StrId, A.Error] = intern.intern(?s.interner, "envtest.k");
                if (sel fqn_r.ok) {
                    val mo: opt[*project.ModuleEntry] = project.module_by_fqn(?p, fqn_r.ok);
                    if (sel mo.some) { m = mo.some; }
                }
                if (m == nil || m.object_image == nil || m.object_image.section_count == 0 || m.object_image.sections[0].len < 8) { bad = 7; }
                or {
                    val d:       *u8 = m.object_image.sections[0].bytes;
                    val version: u32 = d[4]::u32 | (d[5]::u32 << 8) | (d[6]::u32 << 16) | (d[7]::u32 << 24);
                    if (version != want_version) {
                        print.printf("spirv env: header version {}\n", version);
                        bad = 8;
                    }
                }
            }
        }
        project.dnit_project(?p);
    }
    fs.remove_all(alloc, root);
    session.dnit(?s);
    ret bad;
}

test env__pins_the_version_and_caps_the_capabilities {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err)                                                           { ret 1; }
    if (ut_spirv_env_build(?alloc, "env = \"vulkan1.0\"\n", "Int8", 0) != 0)      { ret 2; }
    if (ut_spirv_env_build(?alloc, "env = \"vulkan1.2\"\n", "", 0x00010500) != 0) { ret 3; }
    if (ut_spirv_env_build(?alloc, "", "", 0x00010600) != 0)                      { ret 4; }
    if (ut_spirv_env_build(?alloc, "env = \"vulkan9.9\"\n", "vulkan1.3", 0) != 0) { ret 5; }
    ret 0;
}

#[testing]
fun ut_spv_codegen(p: *project.Project, s: *session.Session, fqn: str,
    out_img: *of.ObjectImage, out_err: *str) bool {
    val mid: session.ModuleId = ut_mid(p, s, fqn);
    if (mid == session.MODULE_NIL) {
        @out_err = "module not loaded";
        ret false;
    }
    val m: *project.ModuleEntry = project.module_at(p, mid::u32);
    if (m.ir_module == nil) {
        @out_err = "module has no lowered IR";
        ret false;
    }

    val sr: res[passes.CodeSources, fail.Fail] = passes.code_sources(p, mid, s.alloc);
    if (sel sr.err) {
        @out_err = fail.describe(sr.err);
        ret false;
    }
    var srcs: passes.CodeSources = sr.ok;

    val cg: res[of.ObjectImage, fail.Fail] = codegen.codegen_unit(s, ?p.target, m.ir_module, srcs.set, nil, codegen.PLACEMENT_POLICY_VERSION, codegen.no_debug(), ?s.diags);
    passes.sources_dnit(s.alloc, ?srcs);
    if (sel cg.err) {
        @out_err = ut_codegen_fail_text(s, cg.err);
        ret false;
    }
    @out_img = cg.ok;
    ret true;
}

# a rejection's text is the first error on the session store; an internal
# failure's is its own
#[testing]
fun ut_codegen_fail_text(s: *session.Session, f: fail.Fail) str {
    if (!fail.is_reported(f)) { ret fail.describe(f); }
    var i: usize = 0;
    for (i < diagnostic.len(?s.diags)) {
        val d: *diagnostic.Diagnostic = ?s.diags.items.data[i];
        if (d.severity == diagnostic.SEVERITY_ERROR) { ret d.message; }
        i = i + 1;
    }
    ret fail.describe(f);
}

#[testing]
fun ut_spv_words(img: *of.ObjectImage, out_n: *u32) *u32 {
    @out_n = 0;
    var i: u32 = 0;
    for (i < img.section_count) {
        val sec: *of.Section = ?img.sections[i];
        if (sec.len >= 20 && sec.bytes != nil) {
            val w: *u32 = sec.bytes::ptr::*u32;
            @out_n = sec.len / 4 - 5;
            ret ?w[5];
        }
        i = i + 1;
    }
    ret nil;
}

#[testing]
fun ut_spv_count(w: *u32, n: u32, opcode: u32) u32 {
    var i: u32 = 0;
    var c: u32 = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0)                  { ret c; }
        if ((w[i] & 0xFFFF) == opcode) { c = c + 1; }
        i = i + len;
    }
    ret c;
}

#[testing]
fun ut_spv_fn_arity(w: *u32, n: u32, fn_ix: u32) u32 {
    var i:    u32  = 0;
    var seen: u32  = 0;
    var ty:   u32  = 0;
    var got:  bool = false;
    for (i < n && !got) {
        val len: u32 = w[i] >> 16;
        if (len == 0) { ret UT_SPV_NO_FN; }
        if ((w[i] & 0xFFFF) == spirv.OP_FUNCTION) {
            if (seen == fn_ix) {
                ty  = w[i + 4];
                got = true;
            }
            seen = seen + 1;
        }
        i = i + len;
    }
    if (!got) { ret UT_SPV_NO_FN; }
    i = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0)                                                    { ret UT_SPV_NO_FN; }
        if ((w[i] & 0xFFFF) == spirv.OP_TYPE_FUNCTION && w[i + 1] == ty) { ret len - 3; }
        i = i + len;
    }
    ret UT_SPV_NO_FN;
}

#[testing]
val UT_SPV_NO_FN: u32 = 0xFFFFFFFF;

#[testing]
fun ut_spv_arity_count(w: *u32, n: u32, arity: u32) u32 {
    val fns: u32 = ut_spv_count(w, n, spirv.OP_FUNCTION);
    var i:   u32 = 0;
    var c:   u32 = 0;
    for (i < fns) {
        if (ut_spv_fn_arity(w, n, i) == arity) { c = c + 1; }
        i = i + 1;
    }
    ret c;
}

#[testing]
fun ut_spv_calls_all_resolve(w: *u32, n: u32) bool {
    var i: u32 = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0) { ret true; }
        if ((w[i] & 0xFFFF) == spirv.OP_FUNCTION_CALL) {
            if (!ut_spv_defines_fn(w, n, w[i + 3])) { ret false; }
        }
        i = i + len;
    }
    ret true;
}

#[testing]
fun ut_spv_defines_fn(w: *u32, n: u32, id: u32) bool {
    var i: u32 = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0)                                               { ret false; }
        if ((w[i] & 0xFFFF) == spirv.OP_FUNCTION && w[i + 2] == id) { ret true; }
        i = i + len;
    }
    ret false;
}

#[testing]
fun ut_spv_first_callee_in(w: *u32, n: u32, fn_ix: u32) u32 {
    var i:       u32  = 0;
    var seen:    u32  = 0;
    var started: bool = false;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0) { ret 0; }
        val op: u32 = w[i] & 0xFFFF;
        if (op == spirv.OP_FUNCTION) {
            if (started) { seen = seen + 1; }
            started = true;
        }
        if (op == spirv.OP_FUNCTION_CALL && started && seen == fn_ix) { ret w[i + 3]; }
        i = i + len;
    }
    ret 0;
}

#[testing]
fun ut_spv_entry_fn(w: *u32, n: u32, k: u32) u32 {
    var i:    u32 = 0;
    var seen: u32 = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0) { ret 0; }
        if ((w[i] & 0xFFFF) == spirv.OP_ENTRY_POINT) {
            if (seen == k) { ret w[i + 2]; }
            seen = seen + 1;
        }
        i = i + len;
    }
    ret 0;
}

#[testing]
fun ut_spv_fn_index_of(w: *u32, n: u32, id: u32) u32 {
    var i:    u32 = 0;
    var seen: u32 = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0) { ret UT_SPV_NO_FN; }
        if ((w[i] & 0xFFFF) == spirv.OP_FUNCTION) {
            if (w[i + 2] == id) { ret seen; }
            seen = seen + 1;
        }
        i = i + len;
    }
    ret UT_SPV_NO_FN;
}

#[testing]
fun ut_spv_export_count(w: *u32, n: u32) u32 {
    var i: u32 = 0;
    var c: u32 = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0) { ret c; }
        if ((w[i] & 0xFFFF) == spirv.OP_DECORATE && len >= 3
            && w[i + 2] == spirv.DECOR_LINKAGE_ATTRIBUTES) { c = c + 1; }
        i = i + len;
    }
    ret c;
}

#[testing]
val UT_H_PRELUDE: str = "#[handle(\"spirv\", \"image\", 0, 1, 0, 0, 0, 1)]\npub def Texture2D;\n#[handle(\"spirv\", \"sampled_image\", Texture2D)]\npub def Sampler2D;\n#[handle(\"spirv\", \"sampler\")]\npub def Sampler;\n#[op(\"spirv\", \"core\", \"OpImageSampleImplicitLod\")]\nfun sample2(s: Sampler2D, uv: f32x2) f32x4;\n#[sampler(0, 0)] var albedo: Sampler2D;\n#[input(0)] var in_uv: f32x2;\n#[output(0)] var out_colour: f32x4;\n";

#[testing]
fun ut_h_diag(alloc: *A.Allocator, tail: str, needle: str) bool {
    val rj: res[str, format.FormatError] = format.sprint(alloc, "{}{}", UT_H_PRELUDE, tail);
    if (sel rj.err) { ret false; }
    val src:   str  = rj.ok;
    val fired: bool = ut_spv_diag_fired(alloc, src, needle);
    A.deallocate[char](alloc, src::*char, str_len(src) + 1);
    ret fired;
}

# each refusal a handle declaration or use can draw; a handle operand is one 32-bit word, so
# 2^32 and 2^64 are refused rather than truncated (#3511), and a type-name argument is scoped
# to `handle`, so anywhere else it is still not a value
#[testing]
rec UtHCase {
    tail:   str;
    needle: str;
}

#[testing]
val UT_H_REFUSALS: [20]UtHCase = [20]UtHCase{
    UtHCase{tail: "fun f() i32 { val x: i32 = Sampler2D; ret 0; }\n\nfun main() i32 { ret 0; }\n", needle: "is a handle type, not a value"},
    UtHCase{tail: "#[stage(\"fragment\")]\nfun frag_main() { val s: Sampler2D = albedo; out_colour = sample2(s, in_uv); }\n\nfun main() i32 { ret 0; }\n", needle: "cannot be a local binding"},
    UtHCase{tail: "rec Material { tex: Sampler2D; }\n\nfun main() i32 { ret 0; }\n", needle: "cannot be a record or union field"},
    UtHCase{tail: "uni Either { tex: Sampler2D; n: i32; }\n\nfun main() i32 { ret 0; }\n", needle: "cannot be a record or union field"},
    UtHCase{tail: "var unbound: Sampler2D;\n\nfun main() i32 { ret 0; }\n", needle: "needs a `#[sampler(set, binding)]` decorator"},
    UtHCase{tail: "#[sampler(0, 1)] var p: *Sampler2D;\n\nfun main() i32 { ret 0; }\n", needle: "cannot sit behind a pointer or inside an array"},
    UtHCase{tail: "#[sampler(0, 1)] var a: [4]Sampler2D;\n\nfun main() i32 { ret 0; }\n", needle: "cannot sit behind a pointer or inside an array"},
    UtHCase{tail: "#[handle(\"spirv\", \"image\", 0, 1, 1, 0, 0, 1)]\npub def T;\n\nfun main() i32 { ret 0; }\n", needle: "`Depth` operand is not `0`"},
    UtHCase{tail: "#[handle(\"spirv\", \"image\", 0, 1, 0, 0, 1, 1)]\npub def T;\n\nfun main() i32 { ret 0; }\n", needle: "`MS` operand is not `0`"},
    UtHCase{tail: "#[handle(\"spirv\", \"image\", 0, 4, 0, 0, 0, 1)]\npub def T;\n\nfun main() i32 { ret 0; }\n", needle: "`Dim` operand names a dimensionality"},
    UtHCase{tail: "#[handle(\"spirv\", \"image\", 0, 1, 0, 0, 0, 2)]\npub def T;\n\nfun main() i32 { ret 0; }\n", needle: "`Sampled` operand is not `1`"},
    UtHCase{tail: "#[handle(\"spirv\", \"image\", 4294967296, 1, 0, 0, 0, 1)]\npub def T;\n\nfun main() i32 { ret 0; }\n", needle: "must fit one 32-bit word"},
    UtHCase{tail: "#[handle(\"spirv\", \"image\", 18446744073709551616, 1, 0, 0, 0, 1)]\npub def T;\n\nfun main() i32 { ret 0; }\n", needle: "must fit one 32-bit word"},
    UtHCase{tail: "#[handle(\"spirv\", \"image\", 0, 1, 0)]\npub def T;\n\nfun main() i32 { ret 0; }\n", needle: "operand count does not match the constructor's"},
    UtHCase{tail: "#[handle(\"spirv\", \"image\", 0, 1, 0, 0, 0, 1, 1)]\npub def T;\n\nfun main() i32 { ret 0; }\n", needle: "operand count does not match the constructor's"},
    UtHCase{tail: "#[handle(\"spirv\", \"sampled_imag\", Texture2D)]\npub def T;\n\nfun main() i32 { ret 0; }\n", needle: "defines no type constructor of this name"},
    UtHCase{tail: "#[handle(\"spirv\", \"sampled_image\", Sampler)]\npub def T;\n\nfun main() i32 { ret 0; }\n", needle: "minted by the target's `image` constructor"},
    UtHCase{tail: "rec Plain { a: i32; }\n#[handle(\"spirv\", \"sampled_image\", Plain)]\npub def T;\n\nfun main() i32 { ret 0; }\n", needle: "must name a handle the same target mints"},
    UtHCase{tail: "rec Inner { a: i32; }\n#[align(Inner)]\nvar g: i32;\n\nfun main() i32 { ret 0; }\n", needle: "is a record type, not a value"},
    UtHCase{tail: "#[handle(\"spirv\", \"sampler\")]\npub def T: i32;\n\nfun main() i32 { ret 0; }\n", needle: "a `handle` declaration has no body"}
};

# the accepting counterpart of every refusal above builds with no error at all
#[testing]
val UT_H_ACCEPTED: str = "def Alias: i32;\nrec Material { tex: Alias; }\n#[sampler(0, 1)] var bound: Sampler2D;\n#[handle(\"spirv\", \"image\", 0, 3, 0, 0, 0, 1)]\npub def Texture3D;\n#[handle(\"spirv\", \"sampled_image\", Texture2D)]\npub def Composed;\n#[handle(\"spirv\", \"sampler\")]\npub def Bare;\n#[stage(\"fragment\")]\nfun frag_main() { out_colour = sample2(albedo, in_uv); }\n\nfun main() i32 { ret 0; }\n";

#[testing]
fun ut_h_clean(alloc: *A.Allocator, tail: str) bool {
    val rj: res[str, format.FormatError] = format.sprint(alloc, "{}{}", UT_H_PRELUDE, tail);
    if (sel rj.err) { ret false; }
    val sr: res[session.Session, fail.Fail] = session.init(alloc);
    if (sel sr.err) { ret false; }
    var s:     session.Session                    = sr.ok;
    var names: [1]str                             = [1]str{"main.mach"};
    var texts: [1]str                             = [1]str{rj.ok};
    val pr:    res[project.Project, outcome.Fail] = ut_spv_lower(?s, alloc, ?names[0], ?texts[0], 1, "", nil, nil, 0);
    var clean: bool                               = sel pr.ok;
    if (sel pr.ok) {
        var p: project.Project = pr.ok;
        project.dnit_project(?p);
    }
    var i: usize = 0;
    for (i < diagnostic.len(?s.diags)) {
        val d: *diagnostic.Diagnostic = ?s.diags.items.data[i];
        if (d.severity == diagnostic.SEVERITY_ERROR) {
            print.eprintlnf("handle: {}", d.message);
            clean = false;
        }
        i = i + 1;
    }
    session.dnit(?s);
    A.deallocate[char](alloc, rj.ok::*char, str_len(rj.ok) + 1);
    ret clean;
}

test handle__declarations_and_uses_are_checked {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var i: usize = 0;
    for (i < 20) {
        if (!ut_h_diag(?alloc, UT_H_REFUSALS[i].tail, UT_H_REFUSALS[i].needle)) {
            print.eprintlnf("handle refusal {} did not fire: {}", i, UT_H_REFUSALS[i].needle);
            ret 2;
        }
        i = i + 1;
    }
    if (!ut_h_clean(?alloc, UT_H_ACCEPTED)) { ret 3; }
    ret 0;
}

#[testing]
fun ut_spv_has_cap(w: *u32, n: u32, cap: u32) bool {
    var i: u32 = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0)                                                              { ret false; }
        if ((w[i] & 0xFFFF) == spirv.OP_CAPABILITY && len >= 2 && w[i + 1] == cap) { ret true; }
        i = i + len;
    }
    ret false;
}

#[testing]
fun ut_spv_declares_int64(s: *session.Session, alloc: *A.Allocator, src: str, out_has: *bool) bool {
    var names: [1]str;
    var texts: [1]str;
    names[0] = "main.mach";
    texts[0] = src;
    val pr: res[project.Project, outcome.Fail] = ut_spv_lower(s, alloc, ?names[0], ?texts[0], 1, "", nil, nil, 0);
    if (sel pr.err) { ret false; }
    var p: project.Project = pr.ok;

    var img:   of.ObjectImage;
    var fault: str = nil;
    if (!ut_spv_codegen(?p, s, "spvcase.main", ?img, ?fault)) {
        project.dnit_project(?p);
        ret false;
    }
    var n: u32  = 0;
    val w: *u32 = ut_spv_words(?img, ?n);
    if (w == nil) {
        obj.dnit(?img);
        project.dnit_project(?p);
        ret false;
    }

    @out_has = ut_spv_has_cap(w, n, spirv.CAP_INT64);
    obj.dnit(?img);
    project.dnit_project(?p);
    ret true;
}

test capability__u32_index_declares_no_int64 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    val narrow: str = "rec Palette { columns: [64]f32x4; }\n#[storage(0, 0)] var palette: Palette;\n\n#[input(0)]            var in_ix:    u32;\n#[builtin(\"position\")] var position: f32x4;\n\n#[stage(\"vertex\")]\nfun vs() { position = palette.columns[in_ix * 2]; }\n\nfun main() i32 { ret 0; }\n";
    val wide:   str = "rec Palette { columns: [64]f32x4; }\n#[storage(0, 0)] var palette: Palette;\n\n#[input(0)]            var in_ix:    u32;\n#[builtin(\"position\")] var position: f32x4;\n\n#[stage(\"vertex\")]\nfun vs() { val w: u64 = in_ix::u64 * 2::u64; position = palette.columns[w]; }\n\nfun main() i32 { ret 0; }\n";

    var bad:        i32  = 0;
    var has_narrow: bool = false;
    var has_wide:   bool = false;
    if (!ut_spv_declares_int64(?s, ?alloc, narrow, ?has_narrow)) {
        session.dnit(?s);
        ret 1;
    }
    if (!ut_spv_declares_int64(?s, ?alloc, wide, ?has_wide)) {
        session.dnit(?s);
        ret 1;
    }

    if (has_narrow) { bad = 1; }
    if (!has_wide)  { bad = 1; }

    session.dnit(?s);
    ret bad;
}

#[testing]
fun ut_spv_root_src() str {
    ret "use lo: spvcase.local;\nuse tn: shlib.tone;\n\n#[input(0)]  var in_x:  f32;\n#[output(0)] var out_a: f32;\n#[output(1)] var out_b: f32;\n\n#[stage(\"vertex\")]\nfun vert_main() { out_a = shared(in_x); }\n\n#[stage(\"fragment\")]\nfun frag_main() { out_b = shared(in_x); }\n\n#[noinline]\nfun shared(v: f32) f32 { ret tn.curve(lo.scale(v, 2.0), 3.0, 4.0); }\n\nfun main() i32 { ret 0; }\n";
}

#[testing]
fun ut_spv_local_src() str {
    ret "#[noinline]\npub fun scale(a: f32, b: f32) f32 { ret a * b; }\n\n#[noinline]\npub fun unused(a: f32, b: f32, c: f32, d: f32, e: f32) f32 { ret a + b + c + d + e; }\n";
}

#[testing]
fun ut_spv_dep_lib_src() str {
    ret "fwd shlib.tone;\nfwd shlib.base;\n";
}

#[testing]
fun ut_spv_dep_tone_src() str {
    ret "use b: shlib.base;\n\n#[noinline]\npub fun curve(a: f32, c: f32, d: f32) f32 { ret b.gain(a, c, d, 2.0); }\n\n#[noinline]\npub fun never_used(a: f32, b_: f32, c: f32, d: f32, e: f32, f: f32) f32 { ret a + b_ + c + d + e + f; }\n";
}

#[testing]
fun ut_spv_dep_base_src() str {
    ret "#[noinline]\npub fun gain(a: f32, b: f32, c: f32, d: f32) f32 { ret a * b + c * d; }\n";
}

#[testing]
fun ut_spv_fixture(s: *session.Session, alloc: *A.Allocator) res[project.Project, outcome.Fail] {
    var names: [2]str;
    var texts: [2]str;
    names[0] = "main.mach";
    texts[0] = ut_spv_root_src();
    names[1] = "local.mach";
    texts[1] = ut_spv_local_src();
    var dnames: [3]str;
    var dtexts: [3]str;
    dnames[0] = "lib.mach";
    dtexts[0] = ut_spv_dep_lib_src();
    dnames[1] = "tone.mach";
    dtexts[1] = ut_spv_dep_tone_src();
    dnames[2] = "base.mach";
    dtexts[2] = ut_spv_dep_base_src();
    ret ut_spv_lower(s, alloc, ?names[0], ?texts[0], 2, "shlib", ?dnames[0], ?dtexts[0], 3);
}

# two entry points share a helper that draws callees in from a local module and a dependency:
# each module emits what an entry point reaches and nothing more, and a drawn-in body is not
# exported where it is drawn in, while a library module exports what it defines
test link_closure__draws_in_only_what_an_entry_point_reaches {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    val pr: res[project.Project, outcome.Fail] = ut_spv_fixture(?s, ?alloc);
    if (sel pr.err) { ret 2; }
    var p: project.Project = pr.ok;
    fin { project.dnit_project(?p); }

    var img:   of.ObjectImage;
    var fault: str = nil;
    if (!ut_spv_codegen(?p, ?s, "spvcase.main", ?img, ?fault)) { ret 3; }
    fin { obj.dnit(?img); }
    var n: u32  = 0;
    val w: *u32 = ut_spv_words(?img, ?n);
    if (w == nil)                                                                                    { ret 4; }
    if (ut_spv_count(w, n, spirv.OP_ENTRY_POINT) != 2 || ut_spv_count(w, n, spirv.OP_FUNCTION) != 6) { ret 5; }
    if (ut_spv_arity_count(w, n, 1) != 1 || ut_spv_arity_count(w, n, 2) != 1
        || ut_spv_arity_count(w, n, 3) != 1 || ut_spv_arity_count(w, n, 4) != 1) { ret 6; }
    if (ut_spv_arity_count(w, n, 5) != 0 || ut_spv_arity_count(w, n, 6) != 0) { ret 7; }
    if (!ut_spv_calls_all_resolve(w, n) || ut_spv_export_count(w, n) != 0)    { ret 8; }
    val e0: u32 = ut_spv_entry_fn(w, n, 0);
    val e1: u32 = ut_spv_entry_fn(w, n, 1);
    val i0: u32 = ut_spv_fn_index_of(w, n, e0);
    val i1: u32 = ut_spv_fn_index_of(w, n, e1);
    if (e0 == 0 || e1 == 0 || e0 == e1 || i0 == UT_SPV_NO_FN || i1 == UT_SPV_NO_FN) { ret 9; }
    val c0: u32 = ut_spv_first_callee_in(w, n, i0);
    if (c0 == 0 || c0 != ut_spv_first_callee_in(w, n, i1)) { ret 10; }

    var lib: of.ObjectImage;
    if (!ut_spv_codegen(?p, ?s, "spvcase.local", ?lib, ?fault)) { ret 11; }
    fin { obj.dnit(?lib); }
    var ln: u32  = 0;
    val lw: *u32 = ut_spv_words(?lib, ?ln);
    if (lw == nil) { ret 12; }
    if (ut_spv_count(lw, ln, spirv.OP_FUNCTION) != 2 || ut_spv_arity_count(lw, ln, 5) != 1
        || ut_spv_export_count(lw, ln) != 2) { ret 13; }

    var dep: of.ObjectImage;
    if (!ut_spv_codegen(?p, ?s, "shlib.tone", ?dep, ?fault)) { ret 14; }
    fin { obj.dnit(?dep); }
    var dn: u32  = 0;
    val dw: *u32 = ut_spv_words(?dep, ?dn);
    if (dw == nil) { ret 15; }
    if (ut_spv_count(dw, dn, spirv.OP_ENTRY_POINT) != 0 || ut_spv_count(dw, dn, spirv.OP_FUNCTION) != 3
        || ut_spv_arity_count(dw, dn, 4) != 1) { ret 16; }
    if (ut_spv_export_count(dw, dn) != 2 || !ut_spv_calls_all_resolve(dw, dn)) { ret 17; }
    ret 0;
}

test link_closure__refuses_recursion_drawn_in_from_another_module {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [2]str;
    var texts: [2]str;
    names[0] = "main.mach";
    texts[0] = "use h: spvcase.helper;\n\n#[input(0)]  var in_n:  i32;\n#[output(0)] var out_n: i32;\n\n#[stage(\"vertex\")]\nfun vert_main() { out_n = h.step(in_n); }\n\nfun main() i32 { ret 0; }\n";
    names[1] = "helper.mach";
    texts[1] = "#[builtin(\"position\")] var position: f32x4;\n\n#[stage(\"vertex\")]\nfun pass() { position = f32x4{0.0, 0.0, 0.0, 1.0}; }\n\n#[noinline]\npub fun step(n: i32) i32 {\n    if (n <= 1) { ret 1; }\n    ret n * step(n - 1);\n}\n";
    var dn: [1]str;
    var dt: [1]str;
    val pr: res[project.Project, outcome.Fail] = ut_spv_lower(?s, ?alloc, ?names[0], ?texts[0], 2, "", ?dn[0], ?dt[0], 0);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    var bad:   i32 = 0;
    var img:   of.ObjectImage;
    var fault: str = nil;

    if (!ut_spv_codegen(?p, ?s, "spvcase.helper", ?img, ?fault)) { bad = 1; }
    or                                                           { obj.dnit(?img); }

    var img2: of.ObjectImage;
    var err2: str = nil;
    if (ut_spv_codegen(?p, ?s, "spvcase.main", ?img2, ?err2)) {
        bad = 1;
        obj.dnit(?img2);
    }
    or {
        if (err2 == nil) { bad = 1; }
        or {
            if (!ut_str_contains(err2, "cycle"))                                      { bad = 1; }
            if (!ut_str_contains(err2, "has no call stack"))                          { bad = 1; }
            if (!ut_str_contains(err2, "spvcase.helper.step -> spvcase.helper.step")) { bad = 1; }
        }
    }

    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

# a call to an `ext` function is refused by name, as a located error at the call site in `vs`
test ext_call__refused_by_name_at_the_call_site {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }

    var names: [1]str;
    var texts: [1]str;
    names[0] = "main.mach";
    texts[0] = "ext fun host_sqrtf(x: u32) u32;\n\n#[output(0)] var o: u32;\n\n#[stage(\"vertex\")]\nfun vs() {\n    o = host_sqrtf(1);\n}\n\nfun main() i32 { ret 0; }\n";
    val pr: res[project.Project, outcome.Fail] = ut_spv_lower(?s, ?alloc, ?names[0], ?texts[0], 1, "", nil, nil, 0);
    if (sel pr.err) { ret 2; }
    var p: project.Project = pr.ok;
    fin { project.dnit_project(?p); }

    var img:   of.ObjectImage;
    var fault: str = nil;
    if (ut_spv_codegen(?p, ?s, "spvcase.main", ?img, ?fault)) {
        obj.dnit(?img);
        ret 3;
    }
    if (fault == nil) { ret 4; }
    if (!ut_str_contains(fault, "host_sqrtf") || !ut_str_contains(fault, "declared `ext`")
        || !ut_str_contains(fault, "self-contained")) { ret 5; }
    if (ut_str_contains(fault, "defined outside the module"))    { ret 6; }
    if (!ut_str_contains(fault, "(in `vs`)"))                    { ret 7; }
    if (!ut_diag_located_at(?s, "(in `vs`)", "main.mach", 7, 9)) { ret 8; }
    ret 0;
}

#[testing]
fun ut_spv_decorated_id(w: *u32, n: u32, decor: u32, value: u32) u32 {
    var i: u32 = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0) { ret 0; }
        if ((w[i] & 0xFFFF) == spirv.OP_DECORATE && len >= 4
            && w[i + 2] == decor && w[i + 3] == value) { ret w[i + 1]; }
        i = i + len;
    }
    ret 0;
}

#[testing]
fun ut_spv_decor_count(w: *u32, n: u32, decor: u32) u32 {
    var i: u32 = 0;
    var c: u32 = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0)                                                              { ret c; }
        if ((w[i] & 0xFFFF) == spirv.OP_DECORATE && len >= 3 && w[i + 2] == decor) { c = c + 1; }
        i = i + len;
    }
    ret c;
}

#[testing]
fun ut_spv_descriptor_var(w: *u32, n: u32, set: u32, bind: u32) u32 {
    var i: u32 = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0) { ret 0; }
        if ((w[i] & 0xFFFF) == spirv.OP_DECORATE && len >= 4
            && w[i + 2] == spirv.DECOR_DESCRIPTOR_SET && w[i + 3] == set) {
            val cand: u32 = w[i + 1];
            var j:    u32 = 0;
            for (j < n) {
                val jl: u32 = w[j] >> 16;
                if (jl == 0) {
                    j = n;
                    cnt;
                }
                if ((w[j] & 0xFFFF) == spirv.OP_DECORATE && jl >= 4 && w[j + 1] == cand
                    && w[j + 2] == spirv.DECOR_BINDING && w[j + 3] == bind) { ret cand; }
                j = j + jl;
            }
        }
        i = i + len;
    }
    ret 0;
}

#[testing]
fun ut_spv_entry_iface_has(w: *u32, n: u32, k: u32, id: u32) bool {
    var i:    u32 = 0;
    var seen: u32 = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0) { ret false; }
        if ((w[i] & 0xFFFF) == spirv.OP_ENTRY_POINT) {
            if (seen == k) {
                var j:     u32  = i + 3;
                var ended: bool = false;
                for (j < i + len && !ended) {
                    if ((w[j] & 0xFF000000) == 0 || (w[j] & 0x00FF0000) == 0
                        || (w[j] & 0x0000FF00) == 0 || (w[j] & 0x000000FF) == 0) { ended = true; }
                    j = j + 1;
                }
                for (j < i + len) {
                    if (w[j] == id) { ret true; }
                    j = j + 1;
                }
                ret false;
            }
            seen = seen + 1;
        }
        i = i + len;
    }
    ret false;
}

#[testing]
fun ut_spv_iface_lib_src() str {
    ret "rec Used   { a: f32; b: f32; c: f32; d: f32; }\nrec Unused { a: f32; b: f32; c: f32; d: f32; }\n\n#[uniform(0, 0)] pub var used_cam:   Used;\n#[uniform(0, 3)] pub var unused_cam: Unused;\n#[input(6)]      pub var lib_in:     f32;\n#[input(7)]      pub var unused_in:  f32;\n\n#[noinline]\npub fun touch_used(v: f32) f32 { ret v * used_cam.a + lib_in; }\n\n#[noinline]\npub fun touch_nothing(v: f32) f32 { ret v * 2.0; }\n\n#[noinline]\npub fun never_called(v: f32) f32 { ret v * unused_cam.a + unused_in; }\n";
}

#[testing]
fun ut_spv_iface_root_src() str {
    ret "use l: spvcase.ilib;\n\n#[input(0)]  var in_x:  f32;\n#[output(0)] var out_a: f32;\n#[output(1)] var out_b: f32;\n\n#[stage(\"vertex\")]\nfun vert_main() { out_a = l.touch_used(in_x); }\n\n#[stage(\"fragment\")]\nfun frag_main() { out_b = l.touch_nothing(in_x); }\n\nfun main() i32 { ret 0; }\n";
}

#[testing]
fun ut_spv_iface_fixture(s: *session.Session, alloc: *A.Allocator) res[project.Project, outcome.Fail] {
    var names: [2]str;
    var texts: [2]str;
    names[0] = "main.mach";
