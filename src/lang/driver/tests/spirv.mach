}

# interface globals a library module declares follow reachability: the entry module emits the
# ones its stages reach, each entry point lists only what it reaches, and the library itself
# still emits and exports every one
test interface__globals_follow_reachability_across_modules {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    val pr: res[project.Project, outcome.Fail] = ut_spv_iface_fixture(?s, ?alloc);
    if (sel pr.err) { ret 2; }
    var p: project.Project = pr.ok;
    fin { project.dnit_project(?p); }

    var img:   of.ObjectImage;
    var fault: str = nil;
    if (!ut_spv_codegen(?p, ?s, "spvcase.main", ?img, ?fault)) { ret 3; }
    fin { obj.dnit(?img); }
    var n: u32  = 0;
    val w: *u32 = ut_spv_words(?img, ?n);
    if (w == nil) { ret 4; }
    val cam: u32 = ut_spv_descriptor_var(w, n, 0, 0);
    val lin: u32 = ut_spv_decorated_id(w, n, spirv.DECOR_LOCATION, 6);
    val ob:  u32 = ut_spv_decorated_id(w, n, spirv.DECOR_LOCATION, 1);
    if (cam == 0 || lin == 0 || ob == 0 || ut_spv_decorated_id(w, n, spirv.DECOR_LOCATION, 0) == 0) { ret 5; }
    if (!ut_spv_calls_all_resolve(w, n) || ut_spv_export_count(w, n) != 0)                          { ret 6; }
    if (ut_spv_descriptor_var(w, n, 0, 3) != 0 || ut_spv_decorated_id(w, n, spirv.DECOR_LOCATION, 7) != 0
        || ut_spv_decor_count(w, n, spirv.DECOR_DESCRIPTOR_SET) != 1) { ret 7; }
    var vx: u32 = 0;
    if (ut_spv_entry_iface_has(w, n, 0, ob)) { vx = 1; }
    val fx: u32 = 1 - vx;
    if (!ut_spv_entry_iface_has(w, n, vx, cam) || !ut_spv_entry_iface_has(w, n, vx, lin)) { ret 8; }
    if (ut_spv_entry_iface_has(w, n, fx, cam) || ut_spv_entry_iface_has(w, n, fx, lin))   { ret 9; }
    if (!ut_spv_entry_iface_has(w, n, fx, ob))                                            { ret 10; }

    var lib: of.ObjectImage;
    if (!ut_spv_codegen(?p, ?s, "spvcase.ilib", ?lib, ?fault)) { ret 11; }
    fin { obj.dnit(?lib); }
    var ln: u32  = 0;
    val lw: *u32 = ut_spv_words(?lib, ?ln);
    if (lw == nil) { ret 12; }
    if (ut_spv_descriptor_var(lw, ln, 0, 0) == 0 || ut_spv_descriptor_var(lw, ln, 0, 3) == 0
        || ut_spv_decorated_id(lw, ln, spirv.DECOR_LOCATION, 7) == 0) { ret 13; }
    if (ut_spv_export_count(lw, ln) != 3) { ret 14; }
    ret 0;
}

# two modules' descriptors at one set and binding are refused naming both, at distinct bindings
# they are two variables
#[testing]
fun ut_spv_binding_case(alloc: *A.Allocator, libb_binding: str, collide: bool) i32 {
    val sr: res[session.Session, fail.Fail] = session.init(alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var names: [3]str;
    var texts: [3]str;
    names[0] = "main.mach";
    texts[0] = "use a: spvcase.liba;\nuse b: spvcase.libb;\n\n#[input(0)]  var in_x:  f32;\n#[output(0)] var out_a: f32;\n\n#[stage(\"vertex\")]\nfun vert_main() { out_a = a.from_a(in_x) + b.from_b(in_x); }\n\nfun main() i32 { ret 0; }\n";
    names[1] = "liba.mach";
    texts[1] = "rec CamA { x: f32; y: f32; z: f32; w: f32; }\n#[uniform(0, 0)] pub var cam_a: CamA;\n\n#[noinline]\npub fun from_a(v: f32) f32 { ret v * cam_a.x; }\n";
    names[2] = "libb.mach";
    texts[2] = ut_cc3(alloc, "rec CamB { p: f32; q: f32; r: f32; s: f32; }\n#[uniform(", libb_binding, ")] pub var cam_b: CamB;\n\n#[noinline]\npub fun from_b(v: f32) f32 { ret v * cam_b.p; }\n");
    val pr: res[project.Project, outcome.Fail] = ut_spv_lower(?s, alloc, ?names[0], ?texts[0], 3, "", nil, nil, 0);
    if (sel pr.err) { ret 2; }
    var p: project.Project = pr.ok;
    fin { project.dnit_project(?p); }

    var img:   of.ObjectImage;
    var fault: str = nil;
    if (collide) {
        var la: of.ObjectImage;
        if (!ut_spv_codegen(?p, ?s, "spvcase.liba", ?la, ?fault)) { ret 3; }
        obj.dnit(?la);
        if (ut_spv_codegen(?p, ?s, "spvcase.main", ?img, ?fault)) {
            obj.dnit(?img);
            ret 4;
        }
        if (fault == nil || !ut_str_contains(fault, "set = 0, binding = 0")
            || !ut_str_contains(fault, "spvcase.liba") || !ut_str_contains(fault, "spvcase.libb")) { ret 5; }
        ret 0;
    }
    if (!ut_spv_codegen(?p, ?s, "spvcase.main", ?img, ?fault)) { ret 6; }
    fin { obj.dnit(?img); }
    var n: u32  = 0;
    val w: *u32 = ut_spv_words(?img, ?n);
    if (w == nil) { ret 7; }
    val va: u32 = ut_spv_descriptor_var(w, n, 0, 0);
    val vb: u32 = ut_spv_descriptor_var(w, n, 0, 1);
    if (va == 0 || vb == 0 || va == vb)                            { ret 8; }
    if (ut_spv_decor_count(w, n, spirv.DECOR_DESCRIPTOR_SET) != 2) { ret 9; }
    ret 0;
}

test descriptor__bindings_across_modules_collide_or_coexist {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val collide: i32 = ut_spv_binding_case(?alloc, "0, 0", true);
    if (collide != 0) { ret 10 + collide; }
    val apart: i32 = ut_spv_binding_case(?alloc, "0, 1", false);
    if (apart != 0) { ret 20 + apart; }
    ret 0;
}

#[testing]
fun ut_spv_has_bare_decor(w: *u32, n: u32, id: u32, decor: u32) bool {
    var i: u32 = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0) { ret false; }
        if ((w[i] & 0xFFFF) == spirv.OP_DECORATE && len == 3
            && w[i + 1] == id && w[i + 2] == decor) { ret true; }
        i = i + len;
    }
    ret false;
}

#[testing]
fun ut_spv_nonwritable_src() str {
    ret "rec P { c: [8]f32x4; }\n\n#[storage(0, 3)] var ro: P;\n#[storage(0, 4)] var rw: P;\n#[storage(0, 5, \"readonly\")] var ro_marked: P;\n\n#[input(0)] var in_x: f32x4;\n#[builtin(\"position\")] var position: f32x4;\n\n#[stage(\"vertex\")]\nfun vert_main() {\n    rw.c[1] = in_x;\n    position = ro.c[2] + rw.c[3] + ro_marked.c[4];\n}\n";
}

test storage__unwritten_binding_is_nonwritable {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    var texts: [1]str;
    names[0] = "main.mach";
    texts[0] = ut_spv_nonwritable_src();
    var dn: [1]str;
    var dt: [1]str;
    val pr: res[project.Project, outcome.Fail] = ut_spv_lower(?s, ?alloc, ?names[0], ?texts[0], 1, "", ?dn[0], ?dt[0], 0);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    var bad:   i32 = 0;
    var img:   of.ObjectImage;
    var fault: str = nil;
    if (!ut_spv_codegen(?p, ?s, "spvcase.main", ?img, ?fault)) {
        project.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }
    var n: u32  = 0;
    val w: *u32 = ut_spv_words(?img, ?n);
    if (w == nil) {
        obj.dnit(?img);
        project.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }

    val ro: u32 = ut_spv_descriptor_var(w, n, 0, 3);
    val rw: u32 = ut_spv_descriptor_var(w, n, 0, 4);
    val mk: u32 = ut_spv_descriptor_var(w, n, 0, 5);
    if (ro == 0 || rw == 0 || mk == 0) { bad = 1; }
    or {
        if (!ut_spv_has_bare_decor(w, n, ro, spirv.DECOR_NON_WRITABLE)) { bad = 1; }
        if (ut_spv_has_bare_decor(w, n, rw, spirv.DECOR_NON_WRITABLE))  { bad = 1; }
        if (!ut_spv_has_bare_decor(w, n, mk, spirv.DECOR_NON_WRITABLE)) { bad = 1; }
    }

    obj.dnit(?img);
    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

# a `readonly` storage binding refuses a store, and the qualifier is checked on `storage` and refused on `uniform`
test storage__readonly_qualifier_is_checked {
    if (!ut_sema_rejects_with("rec P { c: [8]f32x4; }\n\n#[storage(0, 3, \"readonly\")] var ro: P;\n\nfun poke(v: f32x4) { ro.c[1] = v; }\n\nfun main() i32 { ret 0; }\n",
        "cannot store through a `#[storage(set, binding, \"readonly\")]` binding")) { ret 1; }
    if (ut_sema_rejects_with("rec P { c: [8]f32x4; }\n\n#[storage(0, 3)] var rw: P;\n\nfun poke(v: f32x4) { rw.c[1] = v; }\n\nfun main() i32 { ret 0; }\n",
        "cannot store through")) { ret 2; }
    if (!ut_sema_rejects_with("rec P { c: [8]f32x4; }\n\n#[storage(0, 3, \"readonlyy\")] var ro: P;\n\nfun main() i32 { ret 0; }\n",
        "unknown `storage` memory qualifier")) { ret 3; }
    if (!ut_sema_rejects_with("rec P { c: [8]f32x4; }\n\n#[uniform(0, 3, \"readonly\")] var u: P;\n\nfun main() i32 { ret 0; }\n",
        "takes two arguments")) { ret 4; }
    ret 0;
}

