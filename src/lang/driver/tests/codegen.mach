    var bad: i32 = 0;

    if (!ut_sema_clean("fun main() i64 { var v: f32x7; ret 0; }\n"))  { bad = 1; }
    if (!ut_sema_clean("fun main() i64 { var v: f64x3; ret 0; }\n"))  { bad = 1; }
