test "mach.lang.driver:generic_template_emits_no_bare_body" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "fun plain(x: i32) i32 { ret x; }\nfun gen[T](x: T) T { ret x; }\nfun cval($n: i32, x: i32) i32 { ret x; }\nfun packf(x: i32, va: ...) i32 { ret x; }\nfun main() i32 { ret plain(1) + gen[i32](7) + cval(1, 2) + packf(3, 4); }\n";

    val pr: res[project.Project, outcome.Fail] = ut_build(?s, ?alloc, ?names[0], ?texts[0], 1);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    var bad:             i32               = 1;
    val run_sema_pass_r: err[outcome.Fail] = driver.run_sema_pass(?p);
    if (sel run_sema_pass_r.err) {
        project.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }
    val run_lower_pass_r: err[outcome.Fail] = driver.run_lower_pass(?p);
    if (sel run_lower_pass_r.err) {
        project.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }

    val mid: session.ModuleId = ut_mid(?p, ?s, "uniontest.main");
    if (mid != session.MODULE_NIL) {
        val me: *project.ModuleEntry = project.module_at(?p, mid::u32);
        if (me.ir_module != nil) {
            val m:        *ir.Module = me.ir_module;
            val template: u32        = ut_defined_fn_exact(?s, m, "uniontest.main.gen");
            val instance: u32        = ut_defined_fn_exact(?s, m, "uniontest.main.gen$i32");
            val nongen:   u32        = ut_defined_fn_exact(?s, m, "uniontest.main.plain");
            val cvali:    u32        = ut_defined_fn_exact(?s, m, "uniontest.main.cval$1");
            val packi:    u32        = ut_defined_fn_exact(?s, m, "uniontest.main.packf$pack$i64");
            if (template == 0 && instance == 1 && nongen == 1 && cvali == 1 && packi == 1) { bad = 0; }
        }
    }

    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

fun ut_noinline_survives_object(target_name: str) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "#[noinline]\nfun helper(x: i64) i64 { ret x + 1; }\nfun main() i64 { ret helper(41); }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str               = root_r.ok;
    val rr:   err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var tsel_6836: manifest.Selection                 = ut_target_sel(target_name);
    val pr:        res[project.Project, outcome.Fail] = driver.build_project(?s, root, ?tsel_6836);
    fs.remove_all(?alloc, root);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    var bad:             i32               = 1;
    val run_sema_pass_r: err[outcome.Fail] = driver.run_sema_pass(?p);
    if (sel run_sema_pass_r.err) {
        project.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }
    val run_lower_pass_r: err[outcome.Fail] = driver.run_lower_pass(?p);
    if (sel run_lower_pass_r.err) {
        project.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }

    val mid: session.ModuleId = ut_mid(?p, ?s, "uniontest.main");
    if (mid != session.MODULE_NIL) {
        val me: *project.ModuleEntry = project.module_at(?p, mid::u32);
        if (me.ir_module != nil) {
            val m:  *ir.Module           = me.ir_module;
            val ri: res[bool, fail.Fail] = inline.run(m, ?p.target, nil);
            if (sel ri.ok) {
                val callee_name: intern.StrId = ut_single_local_callee_name(m);
                if (callee_name != intern.STR_NIL) {
                    val cg: res[of.ObjectImage, fail.Fail] = codegen.codegen_unit(?s, ?p.target, m, unit.ir_set_empty(), nil, codegen.PLACEMENT_POLICY_VERSION, codegen.no_debug(), ?s.diags);
                    if (sel cg.ok) {
                        var image: of.ObjectImage = cg.ok;
                        if (ut_has_direct_call_reloc(?image, callee_name)) { bad = 0; }
                        obj.dnit(?image);
                    }
                }
            }
        }
    }

    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

fun ut_single_local_callee_name(m: *ir.Module) intern.StrId {
    var found: intern.StrId = intern.STR_NIL;
    var hits:  u32          = 0;
    var fi:    u32          = 0;
    for (fi < m.function_len) {
        val fn: *ir.Function = ?m.functions[fi];
        var bi: u32          = 0;
        for (bi < fn.block_count) {
            val blk: *ir.Block = ?fn.blocks[bi];
            var ii:  u32       = 0;
            for (ii < blk.instr_count) {
                val oi: opt[*instruction.Instruction] = ir.instruction_get(fn, blk.instructions[ii]);
                if (sel oi.some) {
                    val inst: *instruction.Instruction = oi.some;
                    if (inst.kind == instruction.OP_CALL && inst.operand_count >= 1) {
                        val callee: value.Value = inst.operands[0];
                        if (callee.kind == value.VAL_FN && callee.data.fn_ix < m.function_len) {
                            val cfn: *ir.Function = ?m.functions[callee.data.fn_ix];
                            if ((cfn.flags & ir.FN_FLAG_EXTERN) == 0 && cfn.block_count > 0) {
                                found = cfn.name;
                                hits  = hits + 1;
                            }
                        }
                    }
                }
                ii = ii + 1;
            }
            bi = bi + 1;
        }
        fi = fi + 1;
    }
    if (hits != 1) { ret intern.STR_NIL; }
    ret found;
}

fun ut_has_direct_call_reloc(image: *of.ObjectImage, callee_name: intern.StrId) bool {
    var i: u32 = 0;
    for (i < image.reloc_count) {
        val rel: *of.Relocation = ?image.relocations[i];
        if ((rel.kind == of.RK_PLT32 || rel.kind == of.RK_PC32)
            && of.reloc_symbol_name(image, rel) == callee_name) { ret true; }
        i = i + 1;
    }
    ret false;
}

test "mach.lang.driver:noinline_decorator_survives_object_all_isas" {
    if (ut_noinline_survives_object("linux") != 0)         { ret 1; }
    if (ut_noinline_survives_object("linux-arm64") != 0)   { ret 1; }
    if (ut_noinline_survives_object("linux-riscv64") != 0) { ret 1; }
    ret 0;
}

fun ut_fn_text_span(image: *of.ObjectImage, name: intern.StrId) i64 {
    var sec: u32 = 0xFFFFFFFF;
    var lo:  u32 = 0;
    var i:   u32 = 0;
    for (i < image.symbol_count) {
        val sym: *of.Symbol = ?image.symbols[i];
        if ((sym.flags & of.SYM_OBJ_FLAG_FUNCTION) != 0 && sym.name == name) {
            sec = of.section_index(sym.section);
            lo  = sym.offset;
        }
        i = i + 1;
    }
    if (sec == 0xFFFFFFFF)          { ret -1; }
    if (sec >= image.section_count) { ret -1; }

    var hi: u32 = image.sections[sec].len;
    var j:  u32 = 0;
    for (j < image.symbol_count) {
        val sym: *of.Symbol = ?image.symbols[j];
        if ((sym.flags & of.SYM_OBJ_FLAG_FUNCTION) != 0 && of.section_index(sym.section) == sec
            && sym.offset > lo && sym.offset < hi) { hi = sym.offset; }
        j = j + 1;
    }
    ret (hi - lo)::i64;
}

fun ut_naked_spans(target_name: str, src: str, naked_out: *i64, bare_out: *i64) i32 {
    @naked_out = -1;
    @bare_out  = -1;

    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = src;
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str               = root_r.ok;
    val rr:   err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var tsel_6966: manifest.Selection                 = ut_target_sel(target_name);
    val pr:        res[project.Project, outcome.Fail] = driver.build_project(?s, root, ?tsel_6966);
    fs.remove_all(?alloc, root);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    var bad:             i32               = 1;
    val run_sema_pass_r: err[outcome.Fail] = driver.run_sema_pass(?p);
    if (sel run_sema_pass_r.err) {
        project.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }
    val run_lower_pass_r: err[outcome.Fail] = driver.run_lower_pass(?p);
    if (sel run_lower_pass_r.err) {
        project.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }

    val mid: session.ModuleId = ut_mid(?p, ?s, "uniontest.main");
    if (mid != session.MODULE_NIL) {
        val me: *project.ModuleEntry = project.module_at(?p, mid::u32);
        if (me.ir_module != nil) {
            val cg: res[of.ObjectImage, fail.Fail] = codegen.codegen_unit(?s, ?p.target, me.ir_module, unit.ir_set_empty(), nil, codegen.PLACEMENT_POLICY_VERSION, codegen.no_debug(), ?s.diags);
            if (sel cg.ok) {
                var image: of.ObjectImage             = cg.ok;
                val nk:    res[intern.StrId, A.Error] = intern.intern(?s.interner, "nk");
                val br:    res[intern.StrId, A.Error] = intern.intern(?s.interner, "bare");
                if (sel nk.ok) {
                    if (sel br.ok) {
                        @naked_out = ut_fn_text_span(?image, nk.ok);
                        @bare_out  = ut_fn_text_span(?image, br.ok);
                        if (@naked_out >= 0 && @bare_out >= 0) { bad = 0; }
                    }
                }
                obj.dnit(?image);
            }
        }
    }

    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.driver:naked_emits_only_its_asm_all_isas" {
    var nk: i64 = -1;
    var br: i64 = -1;

    val x64: str = "#[naked] #[symbol(\"nk\")]\npub fun nk() { asm x86_64 { nop } }\n#[symbol(\"bare\")]\npub fun bare() { asm x86_64 { nop } }\nfun main() i64 { ret 0; }\n";
    val a64: str = "#[naked] #[symbol(\"nk\")]\npub fun nk() { asm aarch64 { nop } }\n#[symbol(\"bare\")]\npub fun bare() { asm aarch64 { nop } }\nfun main() i64 { ret 0; }\n";
    val rv:  str = "#[naked] #[symbol(\"nk\")]\npub fun nk() { asm riscv64 { nop } }\n#[symbol(\"bare\")]\npub fun bare() { asm riscv64 { nop } }\nfun main() i64 { ret 0; }\n";

    if (ut_naked_spans("linux", x64, ?nk, ?br) != 0) { ret 1; }
    if (nk != 1 || br != 2)                          { ret 1; }

    if (ut_naked_spans("linux-arm64", a64, ?nk, ?br) != 0) { ret 1; }
    if (nk != 4 || br != 8)                                { ret 1; }

    if (ut_naked_spans("linux-riscv64", rv, ?nk, ?br) != 0) { ret 1; }
    if (nk != 4 || br != 8)                                 { ret 1; }
    ret 0;
}

test "mach.lang.driver:naked_propagates_to_a_generic_instance" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "#[naked]\npub fun nk[T]() { asm x86_64 { nop } }\nfun main() i64 { nk[i64](); ret 0; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str               = root_r.ok;
    val rr:   err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var tsel_7035: manifest.Selection                 = ut_target_sel("linux");
    val pr:        res[project.Project, outcome.Fail] = driver.build_project(?s, root, ?tsel_7035);
    fs.remove_all(?alloc, root);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    var bad:             i32               = 1;
    val run_sema_pass_r: err[outcome.Fail] = driver.run_sema_pass(?p);
    if (sel run_sema_pass_r.err) {
        project.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }
    val run_lower_pass_r: err[outcome.Fail] = driver.run_lower_pass(?p);
    if (sel run_lower_pass_r.err) {
        project.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }

    val mid: session.ModuleId = ut_mid(?p, ?s, "uniontest.main");
    if (mid != session.MODULE_NIL) {
        val me: *project.ModuleEntry = project.module_at(?p, mid::u32);
        if (me.ir_module != nil) {
            val m:         *ir.Module = me.ir_module;
            var instances: u32        = 0;
            var flagged:   u32        = 0;
            var fi:        u32        = 0;
            for (fi < m.function_len) {
                val fn: *ir.Function = ?m.functions[fi];
                if ((fn.flags & ir.FN_FLAG_WEAK) != 0 && fn.block_count > 0) {
                    instances = instances + 1;
                    if ((fn.flags & ir.FN_FLAG_NAKED) != 0) { flagged = flagged + 1; }
                }
                fi = fi + 1;
            }
            if (instances == 1 && flagged == 1) { bad = 0; }
        }
    }

    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.driver:naked_body_admits_only_asm" {
    val restrict: str = "a `naked` function's body may contain only inline `asm` statements";

    if (ut_vec_diag("#[naked]\nfun f() { var x: i64 = 0; }\n", restrict) != 0)                                                                               { ret 1; }
    if (ut_vec_diag("#[naked]\nfun f() { g(); }\nfun g() {}\n", restrict) != 0)                                                                              { ret 1; }
    if (ut_vec_diag("#[naked]\nfun f() i64 { ret 1; }\n", restrict) != 0)                                                                                    { ret 1; }
    if (ut_vec_diag("#[naked]\nfun f() { for (false) {} }\n", restrict) != 0)                                                                                { ret 1; }
    if (ut_vec_diag("#[naked]\nfun f() { if (false) {} }\n", restrict) != 0)                                                                                 { ret 1; }
    if (ut_vec_diag("#[naked]\next fun f();\n", "`naked` decorator applies only to a function with a body") != 0)                                            { ret 1; }
    if (!ut_sema_clean("#[naked]\nfun f() { asm x86_64 { nop } }\n"))                                                                                        { ret 1; }
    if (!ut_sema_clean("#[naked]\nfun f() {\n    $if ($mach.build.arch == $mach.arch.x86_64) { asm x86_64 { nop } }\n    $or { asm aarch64 { nop } }\n}\n")) { ret 1; }
    ret 0;
}

test "mach.lang.driver:naked_decorator_rejections" {
    if (ut_vec_diag("#[naked] #[inline]\nfun f() { asm x86_64 { nop } }\n",
        "`naked` and `inline` decorators are mutually exclusive; a naked function cannot be inlined") != 0) { ret 1; }
    if (ut_vec_diag("#[naked] #[oblivious]\nfun f() { asm x86_64 { nop } }\n",
        "`naked` and `oblivious` decorators are mutually exclusive; a naked body is inline asm, which `oblivious` forbids") != 0) { ret 1; }
    if (ut_vec_diag("#[naked]\nvar g: i64 = 0;\n",
        "`naked` decorator applies only to functions") != 0) { ret 1; }
    if (ut_vec_diag("#[naked(1)]\nfun f() { asm x86_64 { nop } }\n",
        "`naked` decorator takes no arguments") != 0) { ret 1; }
    ret 0;
}

test "mach.lang.driver:vector_named_type_declaration_rejected" {
    var bad:  i32 = 0;
    val need: str = "cannot also name a type";

    if (!ut_sema_rejects_with("rec u8x16 { a: i64; }\nfun main() i64 { ret 0; }\n", need)) { bad = 1; }
    if (!ut_sema_rejects_with("uni i32x4 { a: i64; }\nfun main() i64 { ret 0; }\n", need)) { bad = 1; }
    if (!ut_sema_rejects_with("def f32x4: i64;\nfun main() i64 { ret 0; }\n", need))       { bad = 1; }

    if (!ut_sema_rejects_with("rec f32x3 { a: i64; }\nfun main() i64 { ret 0; }\n", need)) { bad = 1; }
    if (!ut_sema_rejects_with("rec f32x7 { a: i64; }\nfun main() i64 { ret 0; }\n", need)) { bad = 1; }

    if (!ut_sema_clean("rec matrix4 { a: i64; }\nfun main() i64 { ret 0; }\n"))  { bad = 1; }
    if (!ut_sema_clean("rec Vertex { pos: i64; }\nfun main() i64 { ret 0; }\n")) { bad = 1; }
    if (!ut_sema_clean("rec f32x04 { a: i64; }\nfun main() i64 { ret 0; }\n"))   { bad = 1; }
    if (!ut_sema_clean("def ptrx2: i64;\nfun main() i64 { ret 0; }\n"))          { bad = 1; }

    if (!ut_sema_clean("fun main() i64 { val f32x4: i64 = 7; ret f32x4; }\n"))           { bad = 1; }
    if (!ut_sema_clean("fun i32x4() i64 { ret 3; }\nfun main() i64 { ret i32x4(); }\n")) { bad = 1; }
    if (!ut_sema_clean("var u8x16: i64;\nfun main() i64 { ret u8x16; }\n"))              { bad = 1; }

    ret bad;
}

