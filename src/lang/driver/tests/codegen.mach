fun ut_codegen_failure_rejected(status: CodegenTestStatus, phase: CodegenTestPhase) bool {
    val got: CodegenTestOutcome = ut_codegen_outcome(status, phase,
        CODEGEN_CASE_PUBLIC_MUL, "mutation");
    ret !ut_codegen_outcome_matches(got, CODEGEN_EXPECT_PASS, CODEGEN_CASE_PUBLIC_MUL)
        && !ut_codegen_outcome_matches(got, CODEGEN_EXPECT_EXCLUSION, CODEGEN_CASE_PUBLIC_MUL);
}

test "mach.lang.driver:codegen_test_outcome_exact" {
    if (!ut_codegen_failure_rejected(CODEGEN_TEST_SETUP_FAILURE, CODEGEN_TEST_SETUP))        { ret 1; }
    if (!ut_codegen_failure_rejected(CODEGEN_TEST_TARGET_UNAVAILABLE, CODEGEN_TEST_SETUP))   { ret 1; }
    if (!ut_codegen_failure_rejected(CODEGEN_TEST_EMPTY_SELECTION, CODEGEN_TEST_SELECT))     { ret 1; }
    if (!ut_codegen_failure_rejected(CODEGEN_TEST_NAMED_CASE_MISSING, CODEGEN_TEST_SELECT))  { ret 1; }
    if (!ut_codegen_failure_rejected(CODEGEN_TEST_NAMED_CASE_EXECUTED, CODEGEN_TEST_SELECT)) { ret 1; }
    if (!ut_codegen_failure_rejected(CODEGEN_TEST_COMPILER_REJECTION, CODEGEN_TEST_CODEGEN)) { ret 1; }
    if (!ut_codegen_failure_rejected(CODEGEN_TEST_ARTIFACT_FAILURE, CODEGEN_TEST_ARTIFACT))  { ret 1; }

    val pass: CodegenTestOutcome = ut_codegen_outcome(CODEGEN_TEST_PASS, CODEGEN_TEST_ARTIFACT,
        CODEGEN_CASE_PUBLIC_MUL, "public multiply");
    if (!ut_codegen_outcome_matches(pass, CODEGEN_EXPECT_PASS, CODEGEN_CASE_PUBLIC_MUL))     { ret 1; }
    if (ut_codegen_outcome_matches(pass, CODEGEN_EXPECT_EXCLUSION, CODEGEN_CASE_PUBLIC_MUL)) { ret 1; }
    if (ut_codegen_outcome_matches(pass, CODEGEN_EXPECT_PASS, CODEGEN_CASE_VECTOR_ADD))      { ret 1; }

    val early: CodegenTestOutcome = ut_codegen_outcome(CODEGEN_TEST_PASS, CODEGEN_TEST_CODEGEN,
        CODEGEN_CASE_PUBLIC_MUL, "early pass");
    if (ut_codegen_outcome_matches(early, CODEGEN_EXPECT_PASS, CODEGEN_CASE_PUBLIC_MUL)) { ret 1; }

    val exclusion: CodegenTestOutcome = ut_codegen_outcome(CODEGEN_TEST_EXPECTED_EXCLUSION,
        CODEGEN_TEST_ARTIFACT, CODEGEN_CASE_PUBLIC_SHIFT, "public shift");
    if (!ut_codegen_outcome_matches(exclusion, CODEGEN_EXPECT_EXCLUSION,
        CODEGEN_CASE_PUBLIC_SHIFT)) { ret 1; }
    if (ut_codegen_outcome_matches(exclusion, CODEGEN_EXPECT_PASS,
        CODEGEN_CASE_PUBLIC_SHIFT)) { ret 1; }
    ret 0;
}

# the same oracle on one named target of the union manifest
fun ut_vec_codegen_defined_on(src: str, target_name: str, case_name: str, case_id: CodegenTestCase) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) {
        ret ut_codegen_result(ut_codegen_outcome(CODEGEN_TEST_SETUP_FAILURE, CODEGEN_TEST_SETUP,
            case_id, case_name), CODEGEN_EXPECT_PASS, case_id);
    }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) {
        ret ut_codegen_result(ut_codegen_outcome(CODEGEN_TEST_SETUP_FAILURE, CODEGEN_TEST_SETUP,
            case_id, case_name), CODEGEN_EXPECT_PASS, case_id);
    }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = src;
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        ret ut_codegen_result(ut_codegen_outcome(CODEGEN_TEST_SETUP_FAILURE, CODEGEN_TEST_SETUP,
            case_id, case_name), CODEGEN_EXPECT_PASS, case_id);
    }
    val root: str = root_r.ok;
    fin { fs.remove_all(?alloc, root); }
    val rr: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.err) {
        ret ut_codegen_result(ut_codegen_outcome(CODEGEN_TEST_SETUP_FAILURE, CODEGEN_TEST_SETUP,
            case_id, case_name), CODEGEN_EXPECT_PASS, case_id);
    }
    var pick: manifest.Selection                 = ut_target_sel(target_name);
    val pr:   res[project.Project, outcome.Fail] = driver.build_project(?s, root, ?pick);
    if (sel pr.err) {
        ret ut_codegen_result(ut_codegen_outcome(CODEGEN_TEST_SETUP_FAILURE, CODEGEN_TEST_SETUP,
            case_id, case_name), CODEGEN_EXPECT_PASS, case_id);
    }
    var p: project.Project = pr.ok;
    fin { project.dnit_project(?p); }
    val got: CodegenTestOutcome = ut_run_codegen_case(?p, case_name, case_id,
        CODEGEN_CASE_NONE, CODEGEN_EXPECT_PASS);
    ret ut_codegen_result(got, CODEGEN_EXPECT_PASS, case_id);
}

fun ut_run_codegen_without(p: *project.Project, case_name: str, case_id: CodegenTestCase,
    excluded: CodegenTestCase) i32 {
    val got: CodegenTestOutcome = ut_run_codegen_case(p, case_name, case_id,
        excluded, CODEGEN_EXPECT_EXCLUSION);
    ret ut_codegen_result(got, CODEGEN_EXPECT_EXCLUSION, case_id);
}

# codegen rejects the program with an error located at path_suffix:line:col
fun ut_codegen_rejects_at(src: str, needle: str, path_suffix: str, line: usize, col: usize) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = src;
    val pr: res[project.Project, outcome.Fail] = ut_build(?s, ?alloc, ?names[0], ?texts[0], 1);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    var code: i32 = ut_run_codegen_err(?p, needle);
    if (code == 0 && !ut_diag_located_at(?s, needle, path_suffix, line, col)) { code = 5; }
    project.dnit_project(?p);
    session.dnit(?s);
    ret code;
}

fun ut_codegen_rejects(src: str, needle: str) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = src;
    val pr: res[project.Project, outcome.Fail] = ut_build(?s, ?alloc, ?names[0], ?texts[0], 1);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    val code: i32 = ut_run_codegen_err(?p, needle);
    project.dnit_project(?p);
    session.dnit(?s);
    ret code;
}

test "mach.lang.driver:vector_isel_defined" {
    var bad: i32 = 0;
    if (ut_vec_codegen_defined("fun addv(a: *f32x4, b: *f32x4, out: *f32x4) { @out = @a + @b; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { addv(argv:~*f32x4, argv:~*f32x4, argv:~*f32x4); ret 0; }\n",
        "vector add", CODEGEN_CASE_VECTOR_ADD) != 0) { bad = 1; }
    if (ut_vec_codegen_defined("fun mk(out: *f32x4) { @out = f32x4{1.0, 2.0, 3.0, 4.0}; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { mk(argv:~*f32x4); ret 0; }\n",
        "vector literal", CODEGEN_CASE_VECTOR_BUILD) != 0) { bad = 1; }
    ret bad;
}

test "mach.lang.driver:codegen_terminal_oracle_rejects_mutations" {
    if (ut_vec_codegen_defined("#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "missing multiply", CODEGEN_CASE_PUBLIC_MUL) == 0) { ret 1; }

    # the secret multiply is refused on aarch64 where the OS declares no DIT
    # guarantee (freestanding); linux declares it and x86_64 admits it
    # unconditionally (#3508)
    if (ut_vec_codegen_defined_on("#[oblivious]\nfun bad(a: ^u32, b: ^u32) ^u32 { ret a * b; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { bad(1, 2); ret 0; }\n",
        "bare-arm64", "rejected secret multiply", CODEGEN_CASE_SECRET_MUL) == 0) { ret 1; }
    if (ut_vec_codegen_defined_on("#[oblivious]\nfun ok(a: ^u32, b: ^u32) ^u32 { ret a * b; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ok(1, 2); ret 0; }\n",
        "linux", "admitted secret multiply", CODEGEN_CASE_SECRET_MUL) != 0) { ret 1; }
    if (ut_vec_codegen_defined_on("#[oblivious]\nfun ok(a: ^u32, b: ^u32) ^u32 { ret a * b; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ok(1, 2); ret 0; }\n",
        "linux-arm64", "admitted secret multiply under DIT", CODEGEN_CASE_SECRET_MUL) != 0) { ret 1; }

    if (ut_vec_codegen_defined_on("fun good(a: u32, b: u32) u32 { ret a * b; }\n#[oblivious]\nfun bad(a: ^u32, b: ^u32) ^u32 { ret a * b; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { good(1, 2); bad(1, 2); ret 0; }\n",
        "bare-arm64", "public multiply with unrelated rejection", CODEGEN_CASE_PUBLIC_MUL) == 0) { ret 1; }
    ret 0;
}

fun ut_count_geps_into_vector(p: *project.Project, total: *u32, into_vec: *u32, lane_ops: *u32) {
    @total    = 0;
    @into_vec = 0;
    @lane_ops = 0;
    var ti: u32 = 0;
    for (ti < p.topo_len) {
        val m: *ir.Module = project.module_at(p, p.topo[ti]::u32).ir_module;
        if (m != nil) {
            var fi: u32 = 0;
            for (fi < m.function_len) {
                val fn: *ir.Function = ?m.functions[fi];
                var bi: u32          = 0;
                for (bi < fn.block_count) {
                    val blk: *ir.Block = ?fn.blocks[bi];
                    var ix:  u32       = 0;
                    for (ix < blk.instr_count) {
                        val ins: *instruction.Instruction = ?fn.instrs[blk.instructions[ix]];
                        if (ins.kind == instruction.OP_GEP) {
                            @total = @total + 1;
                            if (ir_type.is_vector(?m.types, ins.aux_ty)) { @into_vec = @into_vec + 1; }
                        }
                        if (ins.kind == instruction.OP_VEC_EXTRACT || ins.kind == instruction.OP_VEC_INSERT) {
                            @lane_ops = @lane_ops + 1;
                        }
                        ix = ix + 1;
                    }
                    bi = bi + 1;
                }
                fi = fi + 1;
            }
        }
        ti = ti + 1;
    }
}

fun ut_has_vec_compare_operands(p: *project.Project, want_float: bool, want_bytes: u8) bool {
    var ti: u32 = 0;
    for (ti < p.topo_len) {
        val m: *ir.Module = project.module_at(p, p.topo[ti]::u32).ir_module;
        if (m != nil) {
            var fi: u32 = 0;
            for (fi < m.function_len) {
                val fn: *ir.Function = ?m.functions[fi];
                var bi: u32          = 0;
                for (bi < fn.block_count) {
                    val blk: *ir.Block = ?fn.blocks[bi];
                    var ix:  u32       = 0;
                    for (ix < blk.instr_count) {
                        val ins: *instruction.Instruction = ?fn.instrs[blk.instructions[ix]];
                        if (ins.kind == instruction.OP_CMP_EQ && ins.operand_count >= 2) {
                            var f0: bool = false;
                            var b0: u8   = 0;
                            var n0: u32  = 0;
                            var f1: bool = false;
                            var b1: u8   = 0;
                            var n1: u32  = 0;
                            if (ir_type.vector_lane(?m.types, ins.operands[0].ty, ?f0, ?b0, ?n0)
                                && ir_type.vector_lane(?m.types, ins.operands[1].ty, ?f1, ?b1, ?n1)
                                && f0 == want_float && b0 == want_bytes
                                && f1 == want_float && b1 == want_bytes) { ret true; }
                        }
                        ix = ix + 1;
                    }
                    bi = bi + 1;
                }
                fi = fi + 1;
            }
        }
        ti = ti + 1;
    }
    ret false;
}

test "mach.lang.driver:vector_lane_access_round_trip" {
    val src:     str = "fun lane_rw(p: *i32x4, out: *i32) {\n    @out = (@p)[2];\n    (@p)[0] = 7;\n}\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { lane_rw(argv:~*i32x4, argv:~*i32); ret 0; }\n";
    var targets: [3]str;
    targets[0] = "linux";
    targets[1] = "linux-arm64";
    targets[2] = "linux-riscv64";
    var bad: i32 = 0;
    var t:   u32 = 0;
    for (t < 3) {
        var alloc:  A.Allocator;
        val make_r: err[A.Error] = page.make(?alloc);
        if (sel make_r.err) { ret 1; }
        val sr: res[session.Session, fail.Fail] = session.init(?alloc);
        if (sel sr.err) { ret 1; }
        var s:  session.Session                    = sr.ok;
        val pr: res[project.Project, outcome.Fail] = ut_vec_lower(?s, ?alloc, src, targets[t]);
        if (sel pr.err) {
            session.dnit(?s);
            ret 1;
        }
        var p:        project.Project = pr.ok;
        var total:    u32             = 0;
        var into_vec: u32             = 0;
        var lane_ops: u32             = 0;
        ut_count_geps_into_vector(?p, ?total, ?into_vec, ?lane_ops);
        if (lane_ops == 0 && total == 0) { bad = 1; }
        if (lane_ops != 0 && total != 0) { bad = 1; }
        if (into_vec != 0)               { bad = 1; }
        project.dnit_project(?p);
        session.dnit(?s);
        t = t + 1;
    }
    ret bad;
}

test "mach.lang.driver:vector_compare_operand_shape" {
    val src:     str = "fun vcmp(a: *f32x4, b: *f32x4, out: *u32x4) { @out = @a == @b; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { vcmp(argv:~*f32x4, argv:~*f32x4, argv:~*u32x4); ret 0; }\n";
    var targets: [2]str;
    targets[0] = "linux";
    targets[1] = "linux-arm64";
    var bad: i32 = 0;
    var t:   u32 = 0;
    for (t < 2) {
        var alloc:  A.Allocator;
        val make_r: err[A.Error] = page.make(?alloc);
        if (sel make_r.err) { ret 1; }
        val sr: res[session.Session, fail.Fail] = session.init(?alloc);
        if (sel sr.err) { ret 1; }
        var s:  session.Session                    = sr.ok;
        val pr: res[project.Project, outcome.Fail] = ut_vec_lower(?s, ?alloc, src, targets[t]);
        if (sel pr.err) {
            session.dnit(?s);
            ret 1;
        }
        var p: project.Project = pr.ok;
        if (!ut_has_vec_compare_operands(?p, true, 4)) { bad = 1; }
        project.dnit_project(?p);
        session.dnit(?s);
        t = t + 1;
    }
    ret bad;
}

fun ut_vector_local_wellformed(p: *project.Project) i32 {
    var seen_memzero: bool = false;
    var bad:          bool = false;
    var ti:           u32  = 0;
    for (ti < p.topo_len) {
        val m: *ir.Module = project.module_at(p, p.topo[ti]::u32).ir_module;
        if (m != nil) {
            var fi: u32 = 0;
            for (fi < m.function_len) {
                val fn: *ir.Function = ?m.functions[fi];
                var bi: u32          = 0;
                for (bi < fn.block_count) {
                    val blk: *ir.Block = ?fn.blocks[bi];
                    var ix:  u32       = 0;
                    for (ix < blk.instr_count) {
                        val ins: *instruction.Instruction = ?fn.instrs[blk.instructions[ix]];
                        if (ins.kind == instruction.OP_MEMZERO) {
                            seen_memzero = true;
                            if (!ir_type.is_vector(?m.types, ins.aux_ty)) { bad = true; }
                        }
                        var oi: u32 = 0;
                        for (oi < ins.operand_count) {
                            if (ins.operands[oi].kind == value.VAL_CONST_INT
                                && ir_type.is_vector(?m.types, ins.operands[oi].ty)) { bad = true; }
                            oi = oi + 1;
                        }
                        ix = ix + 1;
                    }
                    bi = bi + 1;
                }
                fi = fi + 1;
            }
        }
        ti = ti + 1;
    }
    if (bad)           { ret 1; }
    if (!seen_memzero) { ret 1; }
    ret 0;
}

fun ut_vector_load_matches_alloca(p: *project.Project) i32 {
    var mi: u32 = 0;
    for (mi < project.module_count(p)) {
        val me: *project.ModuleEntry = project.module_at(p, mi);
        if (me.ir_module == nil) {
            mi = mi + 1;
            cnt;
        }
        val m:  *ir.Module = me.ir_module;
        var fi: u32        = 0;
        for (fi < m.function_len) {
            val fn: *ir.Function = ?m.functions[fi];
            var ii: u32          = 0;
            for (ii < fn.instr_len) {
                var ins: *instruction.Instruction = ?fn.instrs[ii];
                if (ins.kind == instruction.OP_LOAD && ir_type.is_vector(?m.types, ins.ty)
                    && ins.operand_count >= 1 && ins.operands[0].kind == value.VAL_INSTR) {
                    val did: ir.InstructionId = ins.operands[0].data.instr;
                    if (did != ir.INSTR_NIL && did::u32 < fn.instr_len) {
                        val def: *instruction.Instruction = ?fn.instrs[did];
                        if (def.kind == instruction.OP_ALLOCA && def.aux_ty != ins.ty) { ret 1; }
                    }
                }
                ii = ii + 1;
            }
            fi = fi + 1;
        }
        mi = mi + 1;
    }
    ret 0;
}

