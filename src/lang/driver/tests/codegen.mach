    if (!ut_sema_clean("fun main() i64 { var v: f32x3; ret 0; }\n")) { bad = 1; }
    if (!ut_sema_clean("fun main() i64 { var v: f32x2; ret 0; }\n")) { bad = 1; }
    if (!ut_sema_clean("fun main() i64 { var v: i32x3; ret 0; }\n")) { bad = 1; }
    if (!ut_sema_clean("fun main() i64 { var v: i8x9;  ret 0; }\n")) { bad = 1; }
    if (!ut_sema_clean("fun main() i64 { var v: i16x5; ret 0; }\n")) { bad = 1; }
    if (!ut_sema_clean("fun main() i64 { var v: i16x7; ret 0; }\n")) { bad = 1; }
    if (ut_sema_rejects_with("fun main() i64 { var v: f32x3; ret 0; }\n",
        "narrower than this target")) { bad = 1; }

    if (!ut_sema_rejects_with("fun main() i64 { var v: f32x1; ret 0; }\n",
        "needs at least 2 lanes")) { bad = 1; }

    if (!ut_sema_rejects_with("fun main() i64 { var v: matrix4; ret 0; }\n",
        "unresolved type name")) { bad = 1; }
    if (!ut_sema_rejects_with("fun main() i64 { var v: f32x04; ret 0; }\n",
        "unresolved type name")) { bad = 1; }
    if (!ut_sema_rejects_with("fun main() i64 { var v: ptrx2; ret 0; }\n",
        "unresolved type name")) { bad = 1; }

    if (!ut_sema_clean("fun main() i64 { var a: f32x4; var b: f64x2; ret 0; }\n")) { bad = 1; }
    if (!ut_sema_clean("fun main() i64 { var a: i8x16; var b: i16x8; ret 0; }\n")) { bad = 1; }
    if (!ut_sema_clean("fun main() i64 { var a: i32x4; var b: i64x2; ret 0; }\n")) { bad = 1; }
    if (!ut_sema_clean("fun main() i64 { var a: u8x16; var b: u16x8; ret 0; }\n")) { bad = 1; }
    if (!ut_sema_clean("fun main() i64 { var a: u32x4; var b: u64x2; ret 0; }\n")) { bad = 1; }
    if (!ut_sema_clean("fun main() i64 { val f32x4: i64 = 3; ret f32x4; }\n"))     { bad = 1; }

    ret bad;
}

test "mach.lang.driver:array_vector_cast" {
    var bad: i32 = 0;

    if (!ut_sema_clean("fun main() i64 { val a: [4]f32 = [4]f32{1.0, 2.0, 3.0, 4.0}; val v: f32x4 = a::f32x4; val b: [4]f32 = v::[4]f32; ret b[0]::i64; }\n")) { bad = 1; }
    if (!ut_sema_rejects_with("fun main() i64 { val a: [4]i32 = [4]i32{1, 2, 3, 4}; val v: f32x4 = a::f32x4; ret 0; }\n",
        "cast: array and vector element types differ")) { bad = 2; }
    if (!ut_sema_rejects_with("fun main() i64 { val a: [8]i16 = [8]i16{1, 2, 3, 4, 5, 6, 7, 8}; val v: i32x4 = a::i32x4; ret 0; }\n",
        "cast: array length and vector lane count differ")) { bad = 3; }
    if (!ut_sema_rejects_with("fun main() i64 { val v: f32x4 = f32x4{1.0, 2.0, 3.0, 4.0}; val a: [4]f64 = v::[4]f64; ret 0; }\n",
        "cast: array and vector element types differ")) { bad = 4; }
    if (!ut_lower_clean("fun main() i64 { var a: [4]f32 = [4]f32{1.0, 2.0, 3.0, 4.0}; val v: f32x4 = a[0, 4]::f32x4; a[0, 4] = (v * v)::[4]f32; ret a[3]::i64; }\n")) { bad = 5; }
    ret bad;
}

# how many `kind` instructions the lowered `fn_name` holds on a target with the
# given extensions, 0xFFFFFFFF when the program does not lower
fun ut_ext_lowered_ops(isa_name: str, os_name: str, abi_name: str, exts: str, program: str, fn_name: str, kind: instruction.InstrKind) u32 {
    ret ut_ext_lowered_count(isa_name, os_name, abi_name, exts, program, fn_name, kind, 0, 0);
}

# how many stack slots of `lanes` integers of `bits` bits, as a vector or as
# the array scalarization makes of one, the lowered `fn_name` holds on a
# target with no extensions
fun ut_ext_lowered_vector_slots(isa_name: str, os_name: str, abi_name: str, program: str, fn_name: str, lanes: u32, bits: u32) u32 {
    ret ut_ext_lowered_count(isa_name, os_name, abi_name, "", program, fn_name, instruction.OP_ALLOCA, lanes, bits);
}

# `kind` instructions in the lowered `fn_name`, or the slots of `slot_lanes`
# integers of `slot_bits` bits when `slot_lanes` is not 0
fun ut_ext_lowered_count(isa_name: str, os_name: str, abi_name: str, exts: str, program: str, fn_name: str, kind: instruction.InstrKind, slot_lanes: u32, slot_bits: u32) u32 {
    var alloc: A.Allocator;
    val made:  err[A.Error] = page.make(?alloc);
    if (sel made.err) { ret 0xFFFFFFFF; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 0xFFFFFFFF; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    val rr: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.err) { ret 0xFFFFFFFF; }
    var names:  [1]str              = [1]str{"main.mach"};
    var texts:  [1]str              = [1]str{program};
    val root_r: res[str, fail.Fail] = ut_scaffold_m(?alloc, ut_ext_manifest(?alloc, isa_name, os_name, abi_name, exts), ?names[0], ?texts[0], 1);
    if (sel root_r.err) { ret 0xFFFFFFFF; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?alloc, root); }
    var pick: manifest.Selection                 = ut_target_sel("t");
    val bp:   res[project.Project, outcome.Fail] = driver.build_project(?s, root, ?pick);
    if (sel bp.err) { ret 0xFFFFFFFF; }
    var p: project.Project = bp.ok;
    fin { project.dnit_project(?p); }
    val typed: err[outcome.Fail] = driver.run_sema_pass(?p);
    if (sel typed.err) { ret 0xFFFFFFFF; }
    val lowered: err[outcome.Fail] = driver.run_lower_pass(?p);
    if (sel lowered.err) { ret 0xFFFFFFFF; }
    val mid: session.ModuleId = ut_mid(?p, ?s, "exts.main");
    if (mid == session.MODULE_NIL) { ret 0xFFFFFFFF; }
    val me: *project.ModuleEntry = project.module_at(?p, mid::u32);
    if (me.ir_module == nil) { ret 0xFFFFFFFF; }
    val fn: *ir.Function = ut_inline_function(?s, me.ir_module, fn_name);
    if (slot_lanes == 0) { ret ut_inline_ops(fn, kind); }
    ret ut_vector_slots(me.ir_module, fn, slot_lanes, slot_bits);
}

fun ut_is_vector_slot(m: *ir.Module, ins: opt[*instruction.Instruction], lanes: u32, bits: u32) bool {
    if (sel ins.none) { ret false; }
    val slot: *instruction.Instruction = ins.some;
    if (slot.kind != instruction.OP_ALLOCA) { ret false; }
    val t: opt[*ir_type.IrType] = ir_type.get(?m.types, slot.aux_ty);
    if (sel t.none) { ret false; }
    val st:   *ir_type.IrType = t.some;
    var elem: ir_type.IrTypeId;
    if (st.kind == ir_type.IRT_VECTOR) {
        if (st.data.vector_.lanes != lanes) { ret false; }
        elem = st.data.vector_.element;
    }
    or (st.kind == ir_type.IRT_ARRAY) {
        if (st.data.array_.count != lanes) { ret false; }
        elem = st.data.array_.element;
    }
    or {
        ret false;
    }
    val e: opt[*ir_type.IrType] = ir_type.get(?m.types, elem);
    if (sel e.none) { ret false; }
    val et: *ir_type.IrType = e.some;
    ret et.kind == ir_type.IRT_INT && et.data.bits == bits;
}

fun ut_vector_slots(m: *ir.Module, fn: *ir.Function, lanes: u32, bits: u32) u32 {
    if (fn == nil) { ret 0xFFFFFFFF; }
    var count: u32 = 0;
    var bi:    u32 = 0;
    for (bi < fn.block_count) {
        val block: *ir.Block = ?fn.blocks[bi];
        var ii:    u32       = 0;
        for (ii < block.instr_count) {
            if (ut_is_vector_slot(m, ir.instruction_get(fn, block.instructions[ii]), lanes, bits)) { count = count + 1; }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    ret count;
}

# a range of memory cast to a vector is one vector load and the reverse one
# vector store, with no slot and no lane insert; a half of a vector widened by
# `::` is one lane-halving widen where the target packs it (x86-64 baseline and
# sse41 alike, aarch64), and on a target that does not each lane extended
# straight from the source, with no slot for the half in between
test "mach.lang.driver:range_casts_lower_to_one_vector_op" {
    val mem:  str    = "pub fun ld(p: *f32, i: u64) f32x4 { ret p[i, 4]::f32x4; }\npub fun st(p: *f32, i: u64, v: f32x4) { p[i, 4] = v::[4]f32; }\n";
    val half: str    = "pub fun lo(v: i16x8) i32x4 { ret v[0, 4]::i32x4; }\npub fun hi(v: u16x8) u32x4 { ret v[4, 4]::u32x4; }\n";
    var isas: [2]str = [2]str{"x86_64", "aarch64"};
    var abis: [2]str = [2]str{"sysv64", "aapcs64"};
    var t:    u32    = 0;
    for (t < 2) {
        val x: str = isas[t];
        val a: str = abis[t];
        if (ut_ext_lowered_ops(x, "linux", a, "", mem, "exts.main.ld", instruction.OP_LOAD) != 1)         { ret 1; }
        if (ut_ext_lowered_ops(x, "linux", a, "", mem, "exts.main.ld", instruction.OP_ALLOCA) != 0)       { ret 2; }
        if (ut_ext_lowered_ops(x, "linux", a, "", mem, "exts.main.ld", instruction.OP_VEC_INSERT) != 0)   { ret 3; }
        if (ut_ext_lowered_ops(x, "linux", a, "", mem, "exts.main.st", instruction.OP_STORE) != 1)        { ret 4; }
        if (ut_ext_lowered_ops(x, "linux", a, "", mem, "exts.main.st", instruction.OP_ALLOCA) != 0)       { ret 5; }
        if (ut_ext_lowered_ops(x, "linux", a, "", mem, "exts.main.st", instruction.OP_VEC_EXTRACT) != 0)  { ret 6; }
        if (ut_ext_lowered_ops(x, "linux", a, "", half, "exts.main.lo", instruction.OP_VEC_WIDEN_S) != 1) { ret 7; }
        if (ut_ext_lowered_ops(x, "linux", a, "", half, "exts.main.hi", instruction.OP_VEC_WIDEN_U) != 1) { ret 8; }
        if (ut_ext_lowered_ops(x, "linux", a, "", half, "exts.main.lo", instruction.OP_VEC_EXTRACT) != 0) { ret 9; }
        t = t + 1;
    }
    if (ut_ext_lowered_ops("x86_64", "linux", "sysv64", "[\"sse41\"]", half, "exts.main.lo", instruction.OP_VEC_WIDEN_S) != 1) { ret 10; }
    if (ut_ext_lowered_ops("x86_64", "linux", "sysv64", "[\"sse41\"]", half, "exts.main.hi", instruction.OP_VEC_WIDEN_U) != 1) { ret 11; }
    if (ut_ext_lowered_ops("riscv64", "linux", "lp64d", "", half, "exts.main.lo", instruction.OP_VEC_WIDEN_S) != 0)            { ret 12; }
    if (ut_ext_lowered_ops("riscv64", "linux", "lp64d", "", half, "exts.main.lo", instruction.OP_SEXT) != 4)                   { ret 13; }
    if (ut_ext_lowered_ops("riscv64", "linux", "lp64d", "", half, "exts.main.hi", instruction.OP_ZEXT) != 4)                   { ret 14; }
    if (ut_ext_lowered_vector_slots("riscv64", "linux", "lp64d", half, "exts.main.lo", 4, 16) != 0)                            { ret 15; }
    if (ut_ext_lowered_vector_slots("riscv64", "linux", "lp64d", half, "exts.main.hi", 4, 16) != 0)                            { ret 16; }
    ret 0;
}

test "mach.lang.driver:packed_vector_field_rejected" {
    var bad:  i32 = 0;
    val need: str = "a vector field is not allowed in a `#[packed]` record";

    if (!ut_sema_rejects_with("#[packed]\nrec P { a: u8; v: f32x4; }\nfun main() i64 { var r: P; ret 0; }\n", need))                    { bad = 1; }
    if (!ut_sema_rejects_with("#[packed]\nrec P { a: u8; v: [2]f32x4; }\nfun main() i64 { var r: P; ret 0; }\n", need))                 { bad = 1; }
    if (!ut_sema_rejects_with("rec In { v: f32x4; }\n#[packed]\nrec P { a: u8; i: In; }\nfun main() i64 { var r: P; ret 0; }\n", need)) { bad = 1; }
    if (!ut_sema_rejects_with("#[packed]\nrec P { a: u8; v: f32x4; }\nfun main() i64 { var r: P; ret 0; }\n", "#2687"))                 { bad = 1; }

    if (!ut_sema_clean("rec In { v: f32x4; }\n#[packed]\nrec P { a: u8; i: *In; }\nfun main() i64 { var r: P; ret 0; }\n")) { bad = 1; }
    if (!ut_sema_clean("rec R { a: u8; v: f32x4; }\nfun main() i64 { var r: R; ret 0; }\n"))                                { bad = 1; }
    if (!ut_sema_clean("#[packed]\nrec P { a: u8; b: u32; c: f64; }\nfun main() i64 { var r: P; ret 0; }\n"))               { bad = 1; }
    ret bad;
}

test "mach.lang.driver:volatile_decorator_rejections" {
    if (ut_vec_diag("#[volatile(1)]\nrec V { reg: u32; }\nfun main() i64 { ret 0; }\n",
        "`volatile` decorator takes no arguments") != 0) { ret 1; }
    if (ut_vec_diag("#[volatile]\nvar g: i64 = 0;\nfun main() i64 { ret 0; }\n",
        "`volatile` decorator applies only to records, unions, and tags") != 0) { ret 1; }
    if (ut_vec_diag("#[volatile]\nfun f() {}\nfun main() i64 { ret 0; }\n",
        "`volatile` decorator applies only to records, unions, and tags") != 0) { ret 1; }
    if (!ut_sema_clean("#[volatile]\nrec V { reg: u32; }\nfun main() i64 { var v: V; ret v.reg::i64; }\n"))     { ret 1; }
    if (!ut_sema_clean("#[volatile]\nuni U { a: u32; b: u32; }\nfun main() i64 { var u: U; ret u.a::i64; }\n")) { ret 1; }
    ret 0;
}

fun ut_volatile_counts(src: str, vol_loads: *u32, vol_stores: *u32,
    total_loads: *u32, total_stores: *u32) bool {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret false; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret false; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = src;
    val pr: res[project.Project, outcome.Fail] = ut_build(?s, ?alloc, ?names[0], ?texts[0], 1);
    if (sel pr.err) {
        print.print(outcome.describe(pr.err));
        print.print("\n");
        session.dnit(?s);
        ret false;
    }
    var p: project.Project = pr.ok;

    var ok: bool              = false;
    val se: err[outcome.Fail] = driver.run_sema_pass(?p);
    if (sel se.err) {
        print.print(outcome.describe(se.err));
        print.print("\n");
    }
    if (sel se.ok) {
        val le: err[outcome.Fail] = driver.run_lower_pass(?p);
        if (sel le.err) {
            print.print(outcome.describe(le.err));
            print.print("\n");
        }
        if (sel le.ok) {
            ut_count_volatile_mem_ops(?p, vol_loads, vol_stores, total_loads, total_stores);
            ok = true;
        }
    }

    project.dnit_project(?p);
    session.dnit(?s);
    ret ok;
}

fun ut_count_volatile_mem_ops(p: *project.Project, vol_loads: *u32, vol_stores: *u32,
    total_loads: *u32, total_stores: *u32) {
    @vol_loads    = 0;
    @vol_stores   = 0;
    @total_loads  = 0;
    @total_stores = 0;
    var ti: u32 = 0;
    for (ti < p.topo_len) {
        val m: *ir.Module = project.module_at(p, p.topo[ti]::u32).ir_module;
        if (m != nil) {
            var fi: u32 = 0;
            for (fi < m.function_len) {
                val fn: *ir.Function = ?m.functions[fi];
                var ii: u32          = 0;
                for (ii < fn.instr_len) {
                    val ins: *instruction.Instruction = ?fn.instrs[ii];
                    val vol: bool                     = (ins.flags & instruction.INSTR_FLAG_VOLATILE) != 0;
                    if (ins.kind == instruction.OP_LOAD) {
                        @total_loads = @total_loads + 1;
                        if (vol) { @vol_loads = @vol_loads + 1; }
                    }
                    if (ins.kind == instruction.OP_STORE) {
                        @total_stores = @total_stores + 1;
                        if (vol) { @vol_stores = @vol_stores + 1; }
                    }
                    ii = ii + 1;
                }
                fi = fi + 1;
            }
        }
        ti = ti + 1;
    }
}

test "mach.lang.driver:volatile_direct_access_flags_load_and_store" {
    var vl:  u32;
    var vs:  u32;
    var tl:  u32;
    var ts:  u32;
    val src: str = "#[volatile]\nrec V { reg: u32; }\nrec N { reg: u32; }\nfun main() i64 { var v: V; var n: N; v.reg = 1; n.reg = 2; ret (v.reg + n.reg)::i64; }\n";
    if (!ut_volatile_counts(src, ?vl, ?vs, ?tl, ?ts)) { ret 1; }
    if (vl != 1 || vs != 1 || tl != 2 || ts != 2)     { ret 1; }
    ret 0;
}

test "mach.lang.driver:volatile_pointer_parameter_flags_every_access" {
    var vl:  u32;
    var vs:  u32;
    var tl:  u32;
    var ts:  u32;
    val src: str = "#[volatile]\nrec V { reg: u32; }\nfun bump(p: *V) i64 { p.reg = p.reg + 1; ret p.reg::i64; }\nfun main() i64 { var v: V; ret bump(?v); }\n";
    if (!ut_volatile_counts(src, ?vl, ?vs, ?tl, ?ts)) { ret 1; }
    if (vl != 2 || vs != 1)                           { ret 1; }
    ret 0;
}

test "mach.lang.driver:volatile_record_copied_by_value_is_a_volatile_copy" {
    var vl:  u32;
    var vs:  u32;
    var tl:  u32;
    var ts:  u32;
    val src: str = "#[volatile]\nrec V { reg: u32; }\nfun take(d: V) i64 { ret 0; }\nfun main() i64 { var v: V; var c: V = v; c = v; ret take(v); }\n";
    if (!ut_volatile_counts(src, ?vl, ?vs, ?tl, ?ts)) { ret 1; }
    if (vs != 5 || ts != 5)                           { ret 1; }
    val plain: str = "rec N { reg: u32; }\nfun take(d: N) i64 { ret 0; }\nfun main() i64 { var v: N; var c: N = v; c = v; ret take(v); }\n";
    if (!ut_volatile_counts(plain, ?vl, ?vs, ?tl, ?ts)) { ret 1; }
    # a plain record nothing later writes is passed in place, so its call makes no copy (#3460)
    if (vs != 0 || ts != 4) { ret 1; }
    ret 0;
}

test "mach.lang.driver:volatile_copied_pointer_flags_access" {
    var vl:  u32;
    var vs:  u32;
    var tl:  u32;
    var ts:  u32;
    val src: str = "#[volatile]\nrec V { reg: u32; }\nfun main() i64 { var v: V; val p: *V = ?v; val q: *V = p; q.reg = 5; ret q.reg::i64; }\n";
    if (!ut_volatile_counts(src, ?vl, ?vs, ?tl, ?ts)) { ret 1; }
    if (vl != 1 || vs != 1)                           { ret 1; }
    ret 0;
}

test "mach.lang.driver:volatile_array_element_flags_field_access" {
    var vl:  u32;
    var vs:  u32;
    var tl:  u32;
    var ts:  u32;
    val src: str = "#[volatile]\nrec V { reg: u32; }\nfun main() i64 { var arr: [4]V; var i: u32 = 2; arr[i].reg = 7; ret arr[i].reg::i64; }\n";
    if (!ut_volatile_counts(src, ?vl, ?vs, ?tl, ?ts)) { ret 1; }
    if (vl != 1 || vs != 1)                           { ret 1; }
    ret 0;
}

test "mach.lang.driver:volatile_nested_record_field_flags_access" {
    var vl:  u32;
    var vs:  u32;
    var tl:  u32;
    var ts:  u32;
    val src: str = "#[volatile]\nrec Inner { reg: u32; }\nrec Outer { i: Inner; tag: u32; }\nfun main() i64 { var o: Outer; o.i.reg = 9; o.tag = 3; ret (o.i.reg + o.tag)::i64; }\n";
    if (!ut_volatile_counts(src, ?vl, ?vs, ?tl, ?ts)) { ret 1; }
    if (vl != 1 || vs != 1 || tl != 2 || ts != 2)     { ret 1; }
    ret 0;
}

test "mach.lang.driver:volatile_generic_instantiation_flags_access" {
    var vl:  u32;
    var vs:  u32;
    var tl:  u32;
    var ts:  u32;
    val src: str = "#[volatile]\nrec V { reg: u32; }\nrec Box[T] { v: T; }\nfun bump(b: *Box[V]) i64 { b.v.reg = 11; ret b.v.reg::i64; }\nfun main() i64 { var box: Box[V]; ret bump(?box); }\n";
    if (!ut_volatile_counts(src, ?vl, ?vs, ?tl, ?ts)) { ret 1; }
    if (vl != 1 || vs != 1)                           { ret 1; }
    ret 0;
}

# an index into a volatile record's array field is a volatile access on both sides:
# a framebuffer loop `fb.px[i] = c` stores volatile each iteration and two reads of
# `fb.px[i]` are two volatile loads (#3364)
test "mach.lang.driver:volatile_index_access_flags_load_and_store" {
    var vl:  u32;
    var vs:  u32;
    var tl:  u32;
    var ts:  u32;
    val src: str = "#[volatile]\nrec Fb { status: u32; px: [16]u32; }\nfun fill(fb: *Fb, c: u32) { var i: u64 = 0; for (i < 16) { fb.px[i] = c; i = i + 1; } }\nfun read(fb: *Fb, i: u64) u32 { val a: u32 = fb.px[i]; val b: u32 = fb.px[i]; ret a + b; }\nfun main() i64 { var fb: Fb; fill(?fb, 7); ret read(?fb, 3)::i64; }\n";
    if (!ut_volatile_counts(src, ?vl, ?vs, ?tl, ?ts)) { ret 1; }
    if (vl != 2 || vs != 1)                           { ret 2; }
    ret 0;
}

# a dereference of a pointer to a volatile aggregate is a volatile access, whole
# record or scalar field, and so is a field of a plain record stored inside one:
# the storage decides, not the form of the access (#3364)
test "mach.lang.driver:volatile_deref_and_nested_plain_field_flag_access" {
    var vl:    u32;
    var vs:    u32;
    var tl:    u32;
    var ts:    u32;
    val whole: str = "#[volatile]\nrec V { reg: u32; }\nfun copy(p: *V, q: *V) { @q = @p; }\nfun main() i64 { var a: V; var b: V; copy(?a, ?b); ret 0; }\n";
    if (!ut_volatile_counts(whole, ?vl, ?vs, ?tl, ?ts)) { ret 1; }
    # the snapshot of @p and the store into @q
    if (vs != 2) { ret 2; }
    val nested: str = "rec Ctl { bits: u32; }\n#[volatile]\nrec Blk { ctl: Ctl; data: [4]Ctl; }\nfun poke(b: *Blk) u32 { b.ctl.bits = 1; b.data[2].bits = 2; val d: Ctl = (@b).ctl; ret b.ctl.bits + d.bits; }\nfun main() i64 { var b: Blk; ret poke(?b)::i64; }\n";
    if (!ut_volatile_counts(nested, ?vl, ?vs, ?tl, ?ts)) { ret 3; }
    if (vl != 1 || vs != 3)                              { ret 4; }
    ret 0;
}

# a raw scalar pointer traces to no declaration, and a pointer stored in a volatile
# record reaches ordinary storage through it: neither access is volatile, so the
# declaration-rooted contract is pinned rather than assumed (#3364)
test "mach.lang.driver:volatile_stops_at_a_raw_pointer_and_an_indirection" {
    var vl:  u32;
    var vs:  u32;
    var tl:  u32;
    var ts:  u32;
    val raw: str = "fun twice(p: *u32) u32 { @p = 1; @p = 1; val a: u32 = @p; val b: u32 = p[0]; ret a + b; }\nfun main() i64 { var x: u32 = 0; ret twice(?x)::i64; }\n";
    if (!ut_volatile_counts(raw, ?vl, ?vs, ?tl, ?ts)) { ret 1; }
    if (vl != 0 || vs != 0 || tl < 2 || ts < 2)       { ret 2; }
    val through: str = "rec Plain { n: u32; }\n#[volatile]\nrec Dev { target: *Plain; }\nfun go(d: *Dev) u32 { d.target.n = 4; ret d.target.n; }\nfun main() i64 { var p: Plain; var d: Dev; d.target = ?p; ret go(?d)::i64; }\n";
    if (!ut_volatile_counts(through, ?vl, ?vs, ?tl, ?ts)) { ret 3; }
    # the two reads of the pointer field and the one store of it are volatile; the
    # accesses to `n` through it are not
    if (vl != 2 || vs != 1) { ret 4; }
    ret 0;
}

fun ut_volatile_counts_release(src: str, vol_loads: *u32, vol_stores: *u32,
    total_loads: *u32, total_stores: *u32) bool {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret false; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret false; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    var texts: [1]str;
    names[0] = "main.mach";
    texts[0] = src;
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret false;
    }
    val root: str = root_r.ok;

    val rr: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret false;
    }

    var pick: manifest.Selection;
    pick.target       = "";
    pick.profile      = "release";
    pick.artifact     = "";
    pick.want_lib     = false;
    pick.has_artifact = false;

    val pr: res[project.Project, outcome.Fail] = driver.build_project_sel(?s, root, ?pick);
    fs.remove_all(?alloc, root);
    if (sel pr.err) {
        print.print(outcome.describe(pr.err));
        print.print("\n");
        session.dnit(?s);
        ret false;
    }
    var p: project.Project = pr.ok;

    var ok: bool              = false;
    val se: err[outcome.Fail] = driver.run_sema_pass(?p);
    if (sel se.err) {
        print.print(outcome.describe(se.err));
        print.print("\n");
    }
    if (sel se.ok) {
        val le: err[outcome.Fail] = driver.run_lower_pass(?p);
        if (sel le.err) {
            print.print(outcome.describe(le.err));
            print.print("\n");
        }
        if (sel le.ok) {
            ut_count_volatile_mem_ops(?p, vol_loads, vol_stores, total_loads, total_stores);
            ok = true;
        }
    }

    project.dnit_project(?p);
    session.dnit(?s);
    ret ok;
}

test "mach.lang.driver:volatile_survives_optimizing_pipeline_in_a_loop" {
    val src: str = "#[volatile]\nrec V { reg: u32; }\nfun main() i64 {\n    var v: V;\n    var w: V;\n    var i: u32 = 0;\n    var acc: u32 = 0;\n    for (i < 8) {\n        v.reg = v.reg + 1;\n        acc = acc + w.reg;\n        i = i + 1;\n    }\n    ret (acc + v.reg)::i64;\n}\n";

    var dvl: u32;
    var dvs: u32;
    var dtl: u32;
    var dts: u32;
    if (!ut_volatile_counts(src, ?dvl, ?dvs, ?dtl, ?dts)) { ret 1; }
    if (dvl == 0 || dvs == 0)                             { ret 1; }

    var rvl: u32;
    var rvs: u32;
    var rtl: u32;
    var rts: u32;
    if (!ut_volatile_counts_release(src, ?rvl, ?rvs, ?rtl, ?rts)) { ret 1; }

    if (rvl != dvl || rvs != dvs) { ret 1; }
    ret 0;
}

# mach-std#925's zeroize shape: an #[oblivious] caller runs sha512 rounds on
# secret words, then inlines std's looping asm wipe over its digest, in
# release where the inliner expands it. the caller's secrets are live in the
# registers the kernel redefines from the public address and length, so the
# kernel's compares are public and the build is accepted. LEN_TYPE is the
# kernel's length type: declared secret, the same compares read a secret
val UT_ZEROIZE_SHAPE: str = "#[oblivious]\n#[inline]\nfun wipe(p: *^u8, n: LEN_TYPE) {\n    $if ($mach.build.arch == $mach.arch.x86_64) {\n        asm x86_64 {\n            mov r10, {p}\n            mov rcx, {n}\n            xor edx, edx\n            cmp rcx, 16\n            jae 5f\n            cmp rcx, 8\n            jb 2f\n            mov [r10], rdx\n            add r10, rcx\n            sub r10, 8\n            mov [r10], rdx\n            jmp 9f\n        2:\n            cmp rcx, 4\n            jb 3f\n            mov [r10], edx\n            add r10, rcx\n            sub r10, 4\n            mov [r10], edx\n            jmp 9f\n        3:\n            cmp rcx, 2\n            jb 4f\n            mov [r10], dx\n            add r10, rcx\n            sub r10, 2\n            mov [r10], dx\n            jmp 9f\n        4:\n            test rcx, rcx\n            jz 9f\n            mov [r10], dl\n            jmp 9f\n        5:\n            pxor xmm0, xmm0\n            mov r8, r10\n            add r8, rcx\n            sub r8, 16\n            movups [r10], xmm0\n            movups [r8], xmm0\n            mov rax, r10\n            mov r9, 15\n            not r9\n            and rax, r9\n            add rax, 16\n        6:\n            mov r9, rax\n            add r9, 48\n            cmp r9, r8\n            jae 7f\n            movaps [rax], xmm0\n            movaps [rax + 16], xmm0\n            movaps [rax + 32], xmm0\n            movaps [rax + 48], xmm0\n            add rax, 64\n            jmp 6b\n        7:\n            cmp rax, r8\n            jae 9f\n            movaps [rax], xmm0\n            add rax, 16\n            jmp 7b\n        9:\n        }\n    }\n    $or ($mach.build.arch == $mach.arch.aarch64) {\n        asm aarch64 {\n            ldr x9, {p}\n            ldr x10, {n}\n            cmp x10, 16\n            b.hs 5f\n            add x11, x9, x10\n            cmp x10, 8\n            b.lo 2f\n            sub x11, x11, 8\n            str xzr, [x9]\n            str xzr, [x11]\n            b 9f\n        2:\n            cmp x10, 4\n            b.lo 3f\n            sub x11, x11, 4\n            str wzr, [x9]\n            str wzr, [x11]\n            b 9f\n        3:\n            cmp x10, 2\n            b.lo 4f\n            sub x11, x11, 2\n            strh wzr, [x9]\n            strh wzr, [x11]\n            b 9f\n        4:\n            cbz x10, 9f\n            strb wzr, [x9]\n            b 9f\n        5:\n            add x11, x9, x10\n            sub x11, x11, 16\n            stp xzr, xzr, [x9]\n            stp xzr, xzr, [x11]\n            add x12, x9, 16\n            mov x13, 16\n            sub x13, xzr, x13\n            and x12, x12, x13\n        6:\n            add x13, x12, 48\n            cmp x13, x11\n            b.hs 7f\n            stp xzr, xzr, [x12]\n            stp xzr, xzr, [x12, 16]\n            stp xzr, xzr, [x12, 32]\n            stp xzr, xzr, [x12, 48]\n            add x12, x12, 64\n            b 6b\n        7:\n            cmp x12, x11\n            b.hs 9f\n            stp xzr, xzr, [x12]\n            add x12, x12, 16\n            b 7b\n        9:\n        }\n    }\n    $or ($mach.build.arch == $mach.arch.riscv64) {\n        asm riscv64 {\n            ld t0, {p}\n            ld t1, {n}\n            add t2, t0, t1\n            li t3, 16\n            bltu t1, t3, 8f\n        1:\n            andi t4, t0, 7\n            beqz t4, 2f\n            sb zero, 0(t0)\n            addi t0, t0, 1\n            j 1b\n        2:\n            andi t5, t2, -8\n        3:\n            addi t4, t0, 32\n            bltu t5, t4, 4f\n            sd zero, 0(t0)\n            sd zero, 8(t0)\n            sd zero, 16(t0)\n            sd zero, 24(t0)\n            mv t0, t4\n            j 3b\n        4:\n            bgeu t0, t5, 8f\n            sd zero, 0(t0)\n            addi t0, t0, 8\n            j 4b\n        8:\n            bgeu t0, t2, 9f\n            sb zero, 0(t0)\n            addi t0, t0, 1\n            j 8b\n        9:\n        }\n    }\n}\n\n#[oblivious]\nfun digest(state: *^u64, out: *u8) {\n    var a: ^u64 = state[0];\n    var b: ^u64 = state[1];\n    var c: ^u64 = state[2];\n    var d: ^u64 = state[3];\n    var e: ^u64 = state[4];\n    var f: ^u64 = state[5];\n    var g: ^u64 = state[6];\n    var h: ^u64 = state[7];\n    var r: u32  = 0;\n    for (r < 4) {\n        val s1: ^u64 = ((e >> 14) | (e << 50)) ^ ((e >> 18) | (e << 46)) ^ ((e >> 41) | (e << 23));\n        val ch: ^u64 = (e & f) ^ (~e & g);\n        val t1: ^u64 = h + s1 + ch + 0x428a2f98d728ae22;\n        val s0: ^u64 = ((a >> 28) | (a << 36)) ^ ((a >> 34) | (a << 30)) ^ ((a >> 39) | (a << 25));\n        val mj: ^u64 = (a & b) ^ (a & c) ^ (b & c);\n        h = g;\n        g = f;\n        f = e;\n        e = d + t1;\n        d = c;\n        c = b;\n        b = a;\n        a = t1 + s0 + mj;\n        r = r + 1;\n    }\n    var words: [8]^u64;\n    words[0] = a;\n    words[1] = b;\n    words[2] = c;\n    words[3] = d;\n    words[4] = e;\n    words[5] = f;\n    words[6] = g;\n    words[7] = h;\n    var bytes: [64]^u8;\n    var i: u64 = 0;\n    for (i < 64) {\n        bytes[i] = (words[i / 8] >> ((i % 8) * 8)::u64)::^u8;\n        i        = i + 1;\n    }\n    i = 0;\n    for (i < 64) {\n        out[i] = bytes[i]:>u8;\n        i      = i + 1;\n    }\n    wipe((?bytes[0])::*^u8, 64);\n    wipe((?words[0])::*^u8, 64);\n}\n\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 {\n    var st: [8]^u64;\n    var k: u64 = 0;\n    for (k < 8) {\n        val v: u64 = k * 0x9e3779b97f4a7c15;\n        st[k] = v;\n        k     = k + 1;\n    }\n    var out: [64]u8;\n    digest(?st[0], ?out[0]);\n    ret out[0]::i32 & 1;\n}\n";

fun ut_zeroize_shape(len_type: str) str {
    var alloc: A.Allocator;
    val made:  err[A.Error] = page.make(?alloc);
    if (sel made.err) { ret nil; }
    val r: res[str, string.StrError] = str_replace(?alloc, UT_ZEROIZE_SHAPE, "LEN_TYPE", len_type);
    if (sel r.err) { ret nil; }
    ret r.ok;
}

test "mach.lang.driver:an_inlined_asm_loop_compares_public_values_under_a_caller_holding_secrets" {
    val public: str = ut_zeroize_shape("u64");
    val secret: str = ut_zeroize_shape("^u64");
    if (public == nil || secret == nil) { ret 1; }
    val targets: [3]str = [3]str{"linux", "linux-arm64", "linux-riscv64"};
    var t:       usize  = 0;
    for (t < 3) {
        if (ut_codegen_profile_ok(public, targets[t], "release") != 0)                     { ret 10 + t::i32; }
        if (ut_codegen_profile_ok(public, targets[t], "debug") != 0)                       { ret 20 + t::i32; }
        if (ut_codegen_profile_rejects(secret, targets[t], "release", "branches on") != 0) { ret 30 + t::i32; }
        t = t + 1;
    }
    ret 0;
}

test "mach.lang.driver:codegen_exclusion_oracle_rejects_mutations" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:   session.Session = sr.ok;
    var bad: i32             = 0;

    val selected: res[project.Project, outcome.Fail] = ut_ct_edge_project(?s, ?alloc,
        "#[oblivious]\nfun good(v: ^u8, n: u8) ^u8 { ret v << n; }\n#[oblivious]\nfun excluded(v: ^u8, n: ^u8) ^u8 { ret v << n; }\nfun main() i32 { ret 0; }\n", "rv32s");
    if (sel selected.err) { bad = 1; }
    if (sel selected.ok) {
        var p: project.Project = selected.ok;
        if (ut_run_codegen_without(?p, "selected secret shift", CODEGEN_CASE_PUBLIC_SHIFT,
            CODEGEN_CASE_SECRET_SHIFT) == 0) { bad = 1; }
        project.dnit_project(?p);
    }

    val unrelated: res[project.Project, outcome.Fail] = ut_ct_edge_project(?s, ?alloc,
        "#[oblivious]\nfun good(v: ^u8, n: u8) ^u8 { ret v << n; }\n#[oblivious]\nfun rejected(a: ^u8, b: ^u8) ^u8 { ret a * b; }\nfun main() i32 { ret 0; }\n", "rv32s");
    if (sel unrelated.err) { bad = 1; }
    if (sel unrelated.ok) {
        var p: project.Project = unrelated.ok;
        if (ut_run_codegen_without(?p, "public shift with unrelated rejection",
            CODEGEN_CASE_PUBLIC_SHIFT, CODEGEN_CASE_SECRET_SHIFT) == 0) { bad = 1; }
        project.dnit_project(?p);
    }

    val missing: res[project.Project, outcome.Fail] = ut_ct_edge_project(?s, ?alloc,
        "fun main() i32 { ret 0; }\n", "rv32s");
    if (sel missing.err) { bad = 1; }
    if (sel missing.ok) {
        var p: project.Project = missing.ok;
        if (ut_run_codegen_without(?p, "missing public shift", CODEGEN_CASE_PUBLIC_SHIFT,
            CODEGEN_CASE_SECRET_SHIFT) == 0) { bad = 1; }
        project.dnit_project(?p);
    }

    session.dnit(?s);
    ret bad;
}

