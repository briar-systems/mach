test "mach.lang.driver:vector_cast_converts_each_lane_like_the_scalar_cast_on_every_native_backend" {
    $if ($mach.build.os != $mach.os.linux || $mach.build.arch != $mach.arch.x86_64) { ret 0; }
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    ret ut_tag_native_all(?alloc, ut_vector_cast_program(), "vector cast");
}

test "mach.lang.driver:vector_cast_needs_matching_lane_counts_and_accepts_every_lane_pair" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err)                                                                                                                  { ret 1; }
    if (ut_pipeline_verdict(?alloc, "fun f(v: i32x4) i64x4 { ret v::i64x4; }\n", pipeline.OPT_DEBUG) != 0)                               { ret 2; }
    if (ut_pipeline_verdict(?alloc, "fun f(v: i32x4) f32x4 { ret v::f32x4; }\n", pipeline.OPT_DEBUG) != 0)                               { ret 3; }
    if (ut_pipeline_verdict(?alloc, "fun f(v: f64x2) u8x2 { ret v::u8x2; }\n", pipeline.OPT_DEBUG) != 0)                                 { ret 4; }
    if (ut_pipeline_verdict(?alloc, "fun f(v: i32x4) i64x2 { ret v:~i64x2; }\n", pipeline.OPT_DEBUG) != 0)                               { ret 5; }
    if (!ut_pipeline_rejects_with(?alloc, "fun f(v: i32x4) i64x2 { ret v::i64x2; }\n", "cast: vector lane counts differ"))               { ret 6; }
    if (!ut_pipeline_rejects_with(?alloc, "fun f(v: i8x16) i16x8 { ret v::i16x8; }\n", "cast: vector lane counts differ"))               { ret 7; }
    if (!ut_pipeline_rejects_with(?alloc, "fun f(v: f32x4) u32 { ret v::u32; }\n", "cast: conversion is invalid"))                       { ret 8; }
    if (!ut_pipeline_rejects_with(?alloc, "fun f(v: ^f32x4) ^i32x4 { ret v::^i32x4; }\n", "variable-latency floating-point conversion")) { ret 9; }
    ret 0;
}

fun ut_asm_fn_terminator(p: *project.Project, disp: str) i32 {
    var mi: u32 = 0;
    for (mi < project.module_count(p)) {
        val me: *project.ModuleEntry = project.module_at(p, mi);
        if (me.ir_module == nil) {
            mi = mi + 1;
            cnt;
        }
        val m:  *ir.Module = me.ir_module;
        var fi: u32        = 0;
        for (fi < m.function_len) {
            val fn: *ir.Function = ?m.functions[fi];
            if (fn.block_count == 0) {
                fi = fi + 1;
                cnt;
            }
            val nm_o: opt[str] = intern.lookup(?p.s.interner, fn.disp);
            if (sel nm_o.none) {
                fi = fi + 1;
                cnt;
            }
            if (!str_equals(nm_o.some, disp)) {
                fi = fi + 1;
                cnt;
            }
            var found: i32 = 0;
            var bi:    u32 = 0;
            for (bi < fn.block_count) {
                val blk: *ir.Block = ?fn.blocks[bi];
                if (blk.terminator == ir.INSTR_NIL) {
                    bi = bi + 1;
                    cnt;
                }
                val t: *instruction.Instruction = ?fn.instrs[blk.terminator::u32];
                if (t.kind == instruction.OP_UNREACHABLE)       { found = 1; }
                or (t.kind == instruction.OP_RET && found == 0) { found = 2; }
                bi = bi + 1;
            }
            ret found;
        }
        mi = mi + 1;
    }
    ret 0;
}

test "mach.lang.driver:asm_that_cannot_return_terminates_its_block" {
    val src:    str          = "fun dies(v: i64) i64 { asm x86_64 { mov eax, 231\nsyscall\nhlt } ret v; }\nfun lives(v: i64) i64 { asm x86_64 { nop } ret v; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret dies(argc)::i32 + lives(argc)::i32; }\n";
    var bad:    i32          = 0;
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:  session.Session                    = sr.ok;
    val pr: res[project.Project, outcome.Fail] = ut_vec_lower(?s, ?alloc, src, "linux");
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    if (ut_asm_fn_terminator(?p, "dies") != 1)  { bad = 1; }
    if (ut_asm_fn_terminator(?p, "lives") != 2) { bad = 1; }

    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

# the callee of a by-value aggregate uses the memory it was handed, and copies nothing
# at entry (mach #3416). #3418 ruled that the caller owns the copy on every ABI, as C
# does, so the callee's entry copy was a second one. `read_one` reads a single field of
# a 64-byte record: after the ruling its body is that one load, on every convention,
# and the whole-object move it used to make first is gone
fun ut_byval_copy_src() str {
    ret "rec W { a: u64; b: u64; c: u64; d: u64; e: u64; f: u64; g: u64; h: u64; }\n#[noinline] fun read_one(v: W) u64 { ret v.a; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var w: W; w.a = argc::u64; ret read_one(w)::i32; }\n";
}

fun ut_entry_moves(mm: *mir.MirModule, interner: *intern.Interner, suffix: str, out_stores: *u32) i64 {
    var fi: u32 = 0;
    for (fi < mm.function_len) {
        val mf:   *mir.MirFunction = ?mm.functions[fi];
        val name: opt[str]         = intern.lookup(interner, mf.name);
        if (sel name.none) {
            fi = fi + 1;
            cnt;
        }
        if (!ut_str_contains(name.some, suffix)) {
            fi = fi + 1;
            cnt;
        }
        var loads:  u32 = 0;
        var stores: u32 = 0;
        var bi:     u32 = 0;
        for (bi < mf.block_count) {
            val blk: *mir.MirBlock = ?mf.blocks[bi];
            var ii:  u32           = 0;
            for (ii < blk.instr_count) {
                val op: mir.MirOpcode = blk.instrs[ii].opcode;
                if (op == mir.MIR_LOAD || op == mir.MIR_MEMCPY) { loads = loads + 1; }
                if (op == mir.MIR_STORE)                        { stores = stores + 1; }
                ii = ii + 1;
            }
            bi = bi + 1;
        }
        @out_stores = stores;
        ret loads::i64;
    }
    ret -1;
}

fun ut_entry_move_shape(alloc: *A.Allocator, src: str, tname: str, suffix: str, out_stores: *u32) i64 {
    val sr: res[session.Session, fail.Fail] = session.init(alloc);
    if (sel sr.err) { ret -1; }
    var s:  session.Session                    = sr.ok;
    val pr: res[project.Project, outcome.Fail] = ut_vec_lower(?s, alloc, src, tname);
    if (sel pr.err) {
        session.dnit(?s);
        ret -1;
    }
    var p:   project.Project = pr.ok;
    var out: i64             = -1;
    var mi:  u32             = 0;
    for (mi < project.module_count(?p)) {
        val me: *project.ModuleEntry = project.module_at(?p, mi);
        if (me.ir_module == nil) {
            mi = mi + 1;
            cnt;
        }
        val mr: res[mir.MirModule, fail.Fail] = mirlower.lower_module(?p.target, me.ir_module, alloc, ?s.interner, ?s.sources, ?s.diags);
        if (sel mr.err) {
            mi = mi + 1;
            cnt;
        }
        var mm:    mir.MirModule = mr.ok;
        var found: i64           = ut_entry_moves(?mm, ?s.interner, suffix, out_stores);
        if (found >= 0) { out = found; }
        mir.dnit_module(?mm);
        mi = mi + 1;
    }
    project.dnit_project(?p);
    session.dnit(?s);
    ret out;
}

test "mach.lang.driver:a_by_value_aggregate_parameter_is_not_copied_at_entry" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val src: str = ut_byval_copy_src();

    var bad: i32 = 0;

    # every convention is its own arm: a code naming only the last one to fail hides
    # the two that did not run differently
    var sysv_st: u32 = 0;
    var arm_st:  u32 = 0;
    var rv_st:   u32 = 0;
    val sysv:    i64 = ut_entry_move_shape(?alloc, src, "linux", ".read_one", ?sysv_st);
    val arm:     i64 = ut_entry_move_shape(?alloc, src, "linux-arm64", ".read_one", ?arm_st);
    val rv:      i64 = ut_entry_move_shape(?alloc, src, "linux-riscv64", ".read_one", ?rv_st);
    if (sysv != 1 || sysv_st != 0) { bad = bad + 1; }
    if (arm != 1 || arm_st != 0)   { bad = bad + 2; }
    if (rv != 1 || rv_st != 0)     { bad = bad + 4; }
    if (bad != 0) {
        print.printf("entry moves: sysv={}/{} aapcs64={}/{} lp64d={}/{}\n",
            sysv, sysv_st, arm, arm_st, rv, rv_st);
    }

    ret bad;
}

# a call argument read where nothing later can write its source is passed as the source
# itself, so the call's ABI placement is its only copy, as it is for a temporary; an
# argument a later one can write, by a call or by an assignment, keeps its evaluation-point
# copy (mach #3460). `before`
# and `after` are the same instructions in two argument orders: the writing call runs
# before the read in one and after it in the other, so their moves differ by the copy
fun ut_arg_capture_src() str {
    ret "rec W { a: u64; b: u64; c: u64; d: u64; e: u64; f: u64; g: u64; h: u64; }\n#[noinline] fun take(v: W, k: u64) u64 { ret v.a + k; }\n#[noinline] fun take_rev(k: u64, v: W) u64 { ret v.a + k; }\n#[noinline] fun make(k: u64) W { var w: W; w.a = k; ret w; }\n#[noinline] fun poke(p: *W) u64 { p.a = 1; ret 2; }\n#[noinline] fun from_call(k: u64) u64 { ret take(make(k), k); }\n#[noinline] fun from_lit(k: u64) u64 { ret take(W{ a: k, b: 0, c: 0, d: 0, e: 0, f: 0, g: 0, h: 0 }, k); }\n#[noinline] fun from_local(k: u64) u64 { var w: W; w.a = k; ret take(w, k + 1); }\n#[noinline] fun from_before(k: u64) u64 { var w: W; w.a = k; val p: *W = ?w; ret take_rev(poke(p), w); }\n#[noinline] fun from_after(k: u64) u64 { var w: W; w.a = k; val p: *W = ?w; ret take(w, poke(p)); }\n#[noinline] fun from_assign(k: u64) u64 { var w: W; w.a = k; ret take(w, w.a = k + 3); }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { val k: u64 = argc::u64; ret (from_call(k) + from_lit(k) + from_local(k) + from_before(k) + from_after(k) + from_assign(k))::i32; }\n";
}

val UT_ARG_FNS: u32 = 6;

# whole-aggregate copies in an ir function: a store whose value is an aggregate
fun ut_ir_agg_copies(m: *ir.Module, interner: *intern.Interner, suffix: str) i64 {
    var fi: u32 = 0;
    for (fi < m.function_len) {
        val f:     *ir.Function = ?m.functions[fi];
        val name:  opt[str]     = intern.lookup(interner, f.name);
        var named: bool         = false;
        if (sel name.some) { named = ut_str_contains(name.some, suffix); }
        if (named && f.block_count > 0) {
            var copies: i64 = 0;
            var ii:     u32 = 0;
            for (ii < f.instr_len) {
                val ins: *instruction.Instruction = ?f.instrs[ii];
                if (ins.kind == instruction.OP_STORE && ins.operand_count == 2
                    && ir_type.is_aggregate(?m.types, ins.operands[0].ty)) { copies = copies + 1; }
                ii = ii + 1;
            }
            ret copies;
        }
        fi = fi + 1;
    }
    ret -1;
}

# memory moves in a mir function: loads, stores and block copies
fun ut_mir_moves(mm: *mir.MirModule, interner: *intern.Interner, suffix: str) i64 {
    var fi: u32 = 0;
    for (fi < mm.function_len) {
        val mf:    *mir.MirFunction = ?mm.functions[fi];
        val name:  opt[str]         = intern.lookup(interner, mf.name);
        var named: bool             = false;
        if (sel name.some) { named = ut_str_contains(name.some, suffix); }
        if (named) {
            var moves: i64 = 0;
            var bi:    u32 = 0;
            for (bi < mf.block_count) {
                val blk: *mir.MirBlock = ?mf.blocks[bi];
                var ii:  u32           = 0;
                for (ii < blk.instr_count) {
                    val op: mir.MirOpcode = blk.instrs[ii].opcode;
                    if (op == mir.MIR_MEMCPY || op == mir.MIR_LOAD || op == mir.MIR_STORE) { moves = moves + 1; }
                    ii = ii + 1;
                }
                bi = bi + 1;
            }
            ret moves;
        }
        fi = fi + 1;
    }
    ret -1;
}

fun ut_arg_counts(alloc: *A.Allocator, src: str, tname: str, suffixes: *str, ir_out: *i64, mir_out: *i64) bool {
    val sr: res[session.Session, fail.Fail] = session.init(alloc);
    if (sel sr.err) { ret false; }
    var s:  session.Session                    = sr.ok;
    val pr: res[project.Project, outcome.Fail] = ut_vec_lower(?s, alloc, src, tname);
    if (sel pr.err) {
        session.dnit(?s);
        ret false;
    }
    var p: project.Project = pr.ok;
    var k: u32             = 0;
    for (k < UT_ARG_FNS) {
        ir_out[k]  = -1;
        mir_out[k] = -1;
        k          = k + 1;
    }
    var mi: u32 = 0;
    for (mi < project.module_count(?p)) {
        val me: *project.ModuleEntry = project.module_at(?p, mi);
        if (me.ir_module != nil) {
            k = 0;
            for (k < UT_ARG_FNS) {
                val found: i64 = ut_ir_agg_copies(me.ir_module, ?s.interner, suffixes[k]);
                if (found >= 0) { ir_out[k] = found; }
                k = k + 1;
            }
            val mr: res[mir.MirModule, fail.Fail] = mirlower.lower_module(?p.target, me.ir_module, alloc, ?s.interner, ?s.sources, ?s.diags);
            if (sel mr.ok) {
                var mm: mir.MirModule = mr.ok;
                k = 0;
                for (k < UT_ARG_FNS) {
                    val found: i64 = ut_mir_moves(?mm, ?s.interner, suffixes[k]);
                    if (found >= 0) { mir_out[k] = found; }
                    k = k + 1;
                }
                mir.dnit_module(?mm);
            }
        }
        mi = mi + 1;
    }
    project.dnit_project(?p);
    session.dnit(?s);
    ret true;
}

test "mach.lang.driver:an_argument_nothing_later_writes_is_copied_only_by_its_placement" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val src:      str    = ut_arg_capture_src();
    var suffixes: [6]str = [6]str{".from_call", ".from_lit", ".from_local", ".from_before", ".from_after", ".from_assign"};
    var targets:  [3]str = [3]str{"linux", "linux-arm64", "linux-riscv64"};
    var bad:      i32    = 0;
    var t:        u32    = 0;
    for (t < 3) {
        var ir_got:  [6]i64;
        var mir_got: [6]i64;
        if (!ut_arg_counts(?alloc, src, targets[t], ?suffixes[0], ?ir_got[0], ?mir_got[0])) { ret 16; }
        # a temporary and an in-place read make no copy before the call's own placement, and
        # only the reads a later call or a later assignment can write keep one, which shows
        # in the emitted moves
        val ir_ok:  bool = ir_got[0] == 0 && ir_got[1] == 0 && ir_got[2] == 0 && ir_got[3] == 0 && ir_got[4] == 1 && ir_got[5] == 1;
        val mir_ok: bool = mir_got[3] >= 0 && mir_got[4] > mir_got[3];
        if (!ir_ok || !mir_ok) {
            print.printf("{}: ir copies {} {} {} {} {} {}, mir moves {} {} {} {} {} {}\n", targets[t],
                ir_got[0], ir_got[1], ir_got[2], ir_got[3], ir_got[4], ir_got[5],
                mir_got[0], mir_got[1], mir_got[2], mir_got[3], mir_got[4], mir_got[5]);
            bad = bad | (1::i32 << t::i32);
        }
        t = t + 1;
    }
    ret bad;
}

var ut_fp2u_one:  f64 = 1.0;
var ut_fp2u_onef: f32 = 1.0;

test "mach.lang.driver:float_to_unsigned_spans_the_whole_destination_range" {
    val one:  f64  = ut_fp2u_one;
    val onef: f32  = ut_fp2u_onef;
    var bad:  bool = false;

    if ((2147483647.0 * one)::u32 != 2147483647)             { bad = true; }
    if ((2147483520.0::f32 * onef)::u32 != 2147483520)       { bad = true; }
    if ((1.0e18 * one)::u64 != 1000000000000000000)          { bad = true; }
    if ((1099511627776.0::f32 * onef)::u64 != 1099511627776) { bad = true; }

    if ((2147483648.0 * one)::u32 != 2147483648)                    { bad = true; }
    if ((9223372036854775808.0 * one)::u64 != (1::u64 << 63))       { bad = true; }
    if ((9223372036854775808.0::f32 * onef)::u64 != (1::u64 << 63)) { bad = true; }

    if ((3000000000.0 * one)::u32 != 3000000000)       { bad = true; }
    if ((4294967295.0 * one)::u32 != 4294967295)       { bad = true; }
    if ((3000000000.0::f32 * onef)::u32 != 3000000000) { bad = true; }
    if ((4294967040.0::f32 * onef)::u32 != 4294967040) { bad = true; }

    if ((1.0e19 * one)::u64 != 1000000000::u64 * 10000000000::u64) { bad = true; }
    if ((18446744073709549568.0 * one)::u64 != ~(2047::u64))       { bad = true; }
    if ((9223373136366403584.0::f32 * onef)::u64
        != (1::u64 << 63) + (1::u64 << 40)) { bad = true; }
    if ((18446742974197923840.0::f32 * onef)::u64
        != ~((1::u64 << 40) - 1)) { bad = true; }

    if ((250.0 * one)::u8 != 250)      { bad = true; }
    if ((65535.0 * one)::u16 != 65535) { bad = true; }

    if (bad) { ret 1; }
    ret 0;
}

fun ut_agg_ops_and_loads(mm: *mir.MirModule, out_loads: *u32) u32 {
    var ac: u32 = 0;
    var ld: u32 = 0;
    var fi: u32 = 0;
    for (fi < mm.function_len) {
        val mf: *mir.MirFunction = ?mm.functions[fi];
        var bi: u32              = 0;
        for (bi < mf.block_count) {
            val blk: *mir.MirBlock = ?mf.blocks[bi];
            var ii:  u32           = 0;
            for (ii < blk.instr_count) {
                if (blk.instrs[ii].opcode == mir.MIR_VALUE_CALL)  { ac = ac + 1; }
                if (blk.instrs[ii].opcode == mir.MIR_VALUE_PARAM) { ac = ac + 1; }
                if (blk.instrs[ii].opcode == mir.MIR_LOAD)        { ld = ld + 1; }
                ii = ii + 1;
            }
            bi = bi + 1;
        }
        fi = fi + 1;
    }
    @out_loads = ld;
    ret ac;
}

fun ut_agg_shape(alloc: *A.Allocator, src: str, tname: str, out_loads: *u32) i64 {
    val sr: res[session.Session, fail.Fail] = session.init(alloc);
    if (sel sr.err) { ret -1; }
    var s:  session.Session                    = sr.ok;
    val pr: res[project.Project, outcome.Fail] = ut_vec_lower(?s, alloc, src, tname);
    if (sel pr.err) {
        session.dnit(?s);
        ret -1;
    }
    var p:     project.Project = pr.ok;
    var out:   i64             = -1;
    var loads: u32             = 0;
    var mi:    u32             = 0;
    for (mi < project.module_count(?p)) {
        val me: *project.ModuleEntry = project.module_at(?p, mi);
        if (me.ir_module == nil) {
            mi = mi + 1;
            cnt;
        }
        val mr: res[mir.MirModule, fail.Fail] = mirlower.lower_module(?p.target, me.ir_module, alloc, ?s.interner, ?s.sources, ?s.diags);
        if (sel mr.err) {
            mi = mi + 1;
            cnt;
        }
        var mm: mir.MirModule = mr.ok;
        var lc: u32           = 0;
        val c:  u32           = ut_agg_ops_and_loads(?mm, ?lc);
        if (out < 0) { out = 0; }
        out   = out + c::i64;
        loads = loads + lc;
        mi    = mi + 1;
    }
    @out_loads = loads;
    project.dnit_project(?p);
    session.dnit(?s);
    ret out;
}

test "mach.lang.driver:an_aggregate_call_is_classified_by_the_convention" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val src:  str = ut_agg_call_src();
    val nsrc: str = "rec Small { a: u32; b: u32; }\nfun sum_small(p: Small) u32 { ret p.a + p.b * 10; }\nfun make_small() Small { ret Small{a: 7, b: 6}; }\nfun rd() u32 {\n    val s: Small = Small{a: 7, b: 6};\n    val r: Small = make_small();\n    ret sum_small(s) + r.a;\n}\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret rd()::i32; }\n";

    var bad: i32 = 0;

    var sl: u32 = 0;
    if (ut_agg_shape(?alloc, src, "spirv", ?sl) < 6) { bad = 1; }

    var fl: u32 = 0;
    if (ut_agg_shape(?alloc, nsrc, "linux", ?fl) != 0)         { bad = 1; }
    if (fl < 2)                                                { bad = 1; }
    if (ut_agg_shape(?alloc, nsrc, "linux-arm64", ?fl) != 0)   { bad = 1; }
    if (fl < 2)                                                { bad = 1; }
    if (ut_agg_shape(?alloc, nsrc, "linux-riscv64", ?fl) != 0) { bad = 1; }
    if (fl < 2)                                                { bad = 1; }

    ret bad;
}

fun ut_rv32_xbank_src() str {
    ret "#[symbol(\"_start\")]\nfun probe(pick: i32, v: i64) i64 {\n    val f: f64 = v :~ f64;\n    if (pick == 0) { ret f :~ i64; }\n    # a round trip through the float bank and back, so BOTH directions run in one\n    # image and a lowering that is wrong in only one of them cannot pass.\n    if (pick == 1) { val g: f64 = (f :~ i64) :~ f64; ret g :~ i64; }\n    # the width the register form DOES exist at on rv32 (fmv.w.x / fmv.x.w), so a\n    # change that routed everything through memory would still be caught here.\n    val n: i32 = v::i32;\n    val s: f32 = n :~ f32;\n    ret (s :~ i32)::i64;\n}\n";
}

test "mach.lang.driver:an_rv32_cross_bank_reinterpret_round_trips_on_the_core" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    val mr: res[*u8, A.Error] = A.allocate[u8](?alloc, UT_RV32_MEM);
    if (sel mr.err) {
        session.dnit(?s);
        ret 1;
    }
    val mem: *u8 = mr.ok;

    var bad: i32 = 0;
    var len: u32 = 0;
    if (!ut_rv32_build_linked(?s, ?alloc, ut_rv32_xbank_src(), "rv32", mem, ?len)) { bad = 2; }
    or {
        val payload: u64 = 0xC0FFEE0D_DEADBEEF;
        var steps:   u32 = 0;

        var got: u64 = 0;
        if (!ut_rv32_run_pick(mem, 0, payload, ?got, ?steps)) { bad = 3; }
        or (got != payload)                                   { bad = 4; }

        if (bad == 0) {
            var got2: u64 = 0;
            if (!ut_rv32_run_pick(mem, 1, payload, ?got2, ?steps)) { bad = 5; }
            or (got2 != payload)                                   { bad = 6; }
        }

        if (bad == 0) {
            var got3: u64 = 0;
            if (!ut_rv32_run_pick(mem, 2, payload, ?got3, ?steps)) { bad = 7; }
            or (got3 != 0xFFFFFFFFDEADBEEF)                        { bad = 8; }
        }
    }

    A.deallocate[u8](?alloc, mem, UT_RV32_MEM);
    session.dnit(?s);
    ret bad;
}

fun ut_manifest_stack_two() str {
    ret "[project]\nmach = \">=5\"\nid = \"stk\"\nversion = \"0.1.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.small]\nisa = \"x86_64\"\nos = \"windows\"\nabi = \"win64\"\nstack_reserve = 1048576\n\n[target.big]\nisa = \"x86_64\"\nos = \"windows\"\nabi = \"win64\"\nstack_reserve = 8388608\n\n[target.lin]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[profile.debug]\nopt = 0\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n\n[artifact.stk]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/stk\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
}

test "mach.lang.driver:a_frame_larger_than_the_stack_reserve_is_refused" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "#[symbol(\"mainCRTStartup\")]\nfun main() i32 { var big: [2000000]u8; big[0] = 1; ret big[0]::i32; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold_m(?alloc, ut_manifest_stack_two(), ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 2;
    }
    val root: str = root_r.ok;

    var bad: i32               = 0;
    val rr:  err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.err) { bad = 3; }
    if (sel rr.ok) {
        if (!ut_build_names_frame_refusal(?s, root, "small") && bad == 0) { bad = 4; }
        if (ut_build_fails(?s, root, "big") && bad == 0)                  { bad = 5; }
        if (ut_build_names_frame_refusal(?s, root, "lin") && bad == 0)    { bad = 6; }
    }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

fun ut_build_names_frame_refusal(s: *session.Session, root: str, tgt: str) bool {
    val msg: str = ut_codegen_fail_msg(s, root, tgt);
    ret str_contains(msg, "stack reserve cannot hold") && str_contains(msg, "1048576");
}

fun ut_codegen_fail_msg(s: *session.Session, root: str, tgt: str) str {
    var tsel_18657: manifest.Selection                 = ut_target_sel(tgt);
    val pr:         res[project.Project, outcome.Fail] = driver.build_project(s, root, ?tsel_18657);
    if (sel pr.err) {
        ret outcome.describe(pr.err);
    }
    var p:   project.Project   = pr.ok;
    var out: str               = "";
    val se:  err[outcome.Fail] = driver.run_sema_pass(?p);
    if (sel se.err) { out = outcome.describe(se.err); }
    if (sel se.ok) {
        val le: err[outcome.Fail] = driver.run_lower_pass(?p);
        if (sel le.err) { out = outcome.describe(le.err); }
        if (sel le.ok) {
            val ce: err[outcome.Fail] = driver.run_codegen_pass(?p);
            if (sel ce.err) { out = ut_codegen_outcome_text(s, ce.err); }
        }
    }
    project.dnit_project(?p);
    ret out;
}

fun ut_build_fails(s: *session.Session, root: str, tgt: str) bool {
    ret str_len(ut_codegen_fail_msg(s, root, tgt)) != 0;
}

fun ut_w64uw_manifest() str {
    ret "[project]\nmach = \">=5\"\nid = \"w64uw\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.win]\nisa = \"x86_64\"\nos = \"windows\"\nabi = \"win64\"\n\n[profile.debug]\nopt = 0\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n\n[artifact.w64uw]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/w64uw\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
}

fun ut_w64uw_src() str {
    ret "fun probe_small(x: i64) i64 {\n    var buf: [64]u8;\n    buf[0] = x::u8;\n    buf[63] = (x >> 8)::u8;\n    ret buf[0]::i64 + buf[63]::i64;\n}\n\nfun probe_mid(x: i64) i64 {\n    var buf: [4000]u8;\n    buf[0] = x::u8;\n    buf[3999] = (x >> 8)::u8;\n    ret buf[0]::i64 + buf[3999]::i64;\n}\n\nfun probe_big(x: i64) i64 {\n    var buf: [12000]u8;\n    buf[0] = x::u8;\n    buf[11999] = (x >> 8)::u8;\n    ret probe_small(buf[0]::i64) + buf[11999]::i64;\n}\n\n#[symbol(\"mainCRTStartup\")]\nfun start() i32 {\n    ret (probe_big(7) + probe_mid(9))::i32;\n}\n";
}

fun ut_w64uw_image(alloc: *A.Allocator, out: *Vector[u8]) bool {
    val sr: res[session.Session, fail.Fail] = session.init(alloc);
    if (sel sr.err) { ret false; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = ut_w64uw_src();
    val root_r: res[str, fail.Fail] = ut_scaffold_m(alloc, ut_w64uw_manifest(), ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret false;
    }
    val root: str = root_r.ok;

    var ok: bool              = false;
    val rr: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.ok) {
        var tsel_18705: manifest.Selection                 = ut_target_sel("win");
        val pr:         res[project.Project, outcome.Fail] = driver.build_project(?s, root, ?tsel_18705);
        if (sel pr.ok) {
            var p: project.Project = pr.ok;
            if (ut_run_codegen_ok(?p) == 0) { ok = ut_w64uw_link(?p, out); }
            project.dnit_project(?p);
        }
    }
    fs.remove_all(alloc, root);
    session.dnit(?s);
    ret ok;
}

fun ut_w64uw_link(p: *project.Project, out: *Vector[u8]) bool {
    val alloc: *A.Allocator = p.alloc;
    if (p.emit_len == 0) { ret false; }

    val ir: res[*of.ObjectImage, A.Error] = A.allocate[of.ObjectImage](alloc, p.emit_len::usize);
    if (sel ir.err) { ret false; }
    val images:  *of.ObjectImage = ir.ok;
    var missing: bool            = false;
    var i:       u32             = 0;
    for (i < p.emit_len) {
        val m: *project.ModuleEntry = project.module_at(p, (p.topo[i])::u32);
        if (m.object_image == nil) { missing = true; }
        or                         { images[i] = @m.object_image; }
        i = i + 1;
    }

    val tf_r: res[fixture.Output, outcome.Fail] = fixture.create(alloc, "w64uw_pe");
    if (sel tf_r.err) {
        A.deallocate[of.ObjectImage](alloc, images, p.emit_len::usize);
        ret false;
    }
    var tf: fixture.Output = tf_r.ok;
    fin { fixture.dnit(?tf); }

    var linked: bool = false;
    if (!missing) {
        val lr: err[fail.Fail] = ut_planned_link_images(p.s, ?p.target, images,
            p.emit_len, nil::*of.DynLib, 0, fixture.path(?tf)::*u8, "w64uw"::*u8,
            linker.LINK_EXE, false, of.image_options_default(of.SUBSYSTEM_CONSOLE));
        linked = sel lr.ok;
    }
    A.deallocate[of.ObjectImage](alloc, images, p.emit_len::usize);
    if (!linked) { ret false; }

    val rb: res[Vector[u8], fs.FsError] = fs.read_bytes(alloc, fixture.path(?tf));

    if (sel rb.err) { ret false; }
    @out = rb.ok;
    ret true;
}

rec UtPeSec {
    rva:   u32;
    vsize: u32;
    raw:   u32;
}

fun ut_pe_find_sec(img: *Vector[u8], name: str, sec: *UtPeSec) bool {
    if (img.len < 0x40) { ret false; }
    val b:      *u8   = img.data;
    val pe_off: usize = ut_le32(b, 0x3C)::usize;
    val nsec:   u64   = ut_le16(b, pe_off + 4 + 2);
    val optsz:  u64   = ut_le16(b, pe_off + 4 + 16);
    var sh:     usize = pe_off + 4 + 20 + optsz::usize;
    val nlen:   usize = str_len(name);
    if (nlen > 7) { ret false; }
    val np: *u8 = name::*u8;
    var i:  u64 = 0;
    for (i < nsec) {
        if (sh + 40 > img.len) { ret false; }
        var matches: bool  = true;
        var k:       usize = 0;
        for (k < nlen) {
            if (b[sh + k] != np[k]) { matches = false; }
            k = k + 1;
        }
        if (matches && b[sh + nlen] == 0) {
            sec.vsize = ut_le32(b, sh + 8)::u32;
            sec.rva   = ut_le32(b, sh + 12)::u32;
            sec.raw   = ut_le32(b, sh + 20)::u32;
            ret true;
        }
        sh = sh + 40;
        i  = i + 1;
    }
    ret false;
}

fun ut_pe_sec_off(sec: *UtPeSec, rva: u32) i64 {
    if (rva < sec.rva) { ret -1; }
    ret sec.raw::i64 + (rva - sec.rva)::i64;
}

test "mach.lang.driver:w64_xdata_declares_every_prologue_shape" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }

    var img: Vector[u8];
    if (!ut_w64uw_image(?alloc, ?img)) { ret 2; }

    var text_sec:  UtPeSec;
    var pdata_sec: UtPeSec;
    var xdata_sec: UtPeSec;
    if (!ut_pe_find_sec(?img, ".text", ?text_sec))   { ret 3; }
    if (!ut_pe_find_sec(?img, ".pdata", ?pdata_sec)) { ret 4; }
    if (!ut_pe_find_sec(?img, ".xdata", ?xdata_sec)) { ret 5; }

    val b: *u8 = img.data;
    val n: u32 = pdata_sec.vsize / 12;
    if (n < 4) { ret 6; }

    var saw_imm8:   u32 = 0;
    var saw_imm32:  u32 = 0;
    var saw_probed: u32 = 0;

    var i: u32 = 0;
    for (i < n) {
        val row:    usize = pdata_sec.raw::usize + i::usize * 12;
        val begin:  u32   = ut_le32(b, row)::u32;
        val fin:    u32   = ut_le32(b, row + 4)::u32;
        val uw_rva: u32   = ut_le32(b, row + 8)::u32;
        if (begin == 0 || fin <= begin) { ret 7; }

        val fo_s: i64 = ut_pe_sec_off(?text_sec, begin);
        if (fo_s < 0) { ret 8; }
        val fo: usize = fo_s::usize;

        if (b[fo] != 0x55)                                               { ret 9; }
        if (b[fo + 1] != 0x48 || b[fo + 2] != 0x89 || b[fo + 3] != 0xE5) { ret 10; }
        var total:     u64 = 0;
        var alloc_end: u32 = 0;
        if (b[fo + 4] == 0x48 && b[fo + 5] == 0x83 && b[fo + 6] == 0xEC) {
            total     = b[fo + 7]::u64;
            alloc_end = 8;
            saw_imm8  = saw_imm8 + 1;
        }
        or (b[fo + 4] == 0x48 && b[fo + 5] == 0x81 && b[fo + 6] == 0xEC) {
            total     = ut_le32(b, fo + 7);
            alloc_end = 11;
            saw_imm32 = saw_imm32 + 1;
        }
        or (b[fo + 4] == 0x49 && b[fo + 5] == 0xC7 && b[fo + 6] == 0xC3) {
            total = ut_le32(b, fo + 7);
            var k: u32 = 11;
            for (k < 64 && alloc_end == 0) {
                if (b[fo + k::usize] == 0x4C && b[fo + k::usize + 1] == 0x29 && b[fo + k::usize + 2] == 0xDC) {
                    alloc_end = k + 3;
                }
                k = k + 1;
            }
            if (alloc_end == 0) { ret 1; }
            saw_probed = saw_probed + 1;
        }
        or { ret 12; }

        val xo_s: i64 = ut_pe_sec_off(?xdata_sec, uw_rva);
        if (xo_s < 0) { ret 2; }
        val xo: usize = xo_s::usize;
        if (b[xo] != 0x01) { ret 3; }
        val psz: u32 = b[xo + 1]::u32;
        val cnt: u32 = b[xo + 2]::u32;
        if (b[xo + 3] != 0)  { ret 15; }
        if (psz < alloc_end) { ret 16; }

        var push_rbp_ok: bool = false;
        var alloc_codes: u32  = 0;
        var alloc_size:  u64  = 0;
        var alloc_at:    u32  = 0;
        var j:           u32  = 0;
        for (j < cnt) {
            val slot: usize = xo + 4 + j::usize * 2;
            val eo:   u32   = b[slot]::u32;
            val op:   u8    = b[slot + 1] & 0x0F;
            val info: u8    = b[slot + 1] >> 4;
            if (eo > psz) { ret 17; }
            if (op == 0) {
                if (info == 5 && eo == 1) { push_rbp_ok = true; }
            }
            or (op == 2) {
                alloc_codes = alloc_codes + 1;
                alloc_size  = (info::u64 + 1) * 8;
                alloc_at    = eo;
            }
            or (op == 1) {
                alloc_codes = alloc_codes + 1;
                if (info == 0) {
                    alloc_size = ut_le16(b, xo + 4 + (j::usize + 1) * 2) * 8;
                    j          = j + 1;
                }
                or {
                    alloc_size = ut_le32(b, xo + 4 + (j::usize + 1) * 2);
                    j          = j + 2;
                }
                alloc_at = eo;
            }
            or (op == 4 || op == 8) { j = j + 1; }
            or (op == 5 || op == 9) { j = j + 2; }
            or (op == 3)            {}
            or                      { ret 18; }
            j = j + 1;
        }

        if (!push_rbp_ok)          { ret 19; }
        if (alloc_codes != 1)      { ret 20; }
        if (alloc_size != total)   { ret 21; }
        if (alloc_at != alloc_end) { ret 22; }

        i = i + 1;
    }

    if (saw_imm8 == 0 || saw_imm32 == 0 || saw_probed == 0) { ret 23; }

    vector.dnit[u8](?img);
    ret 0;
}

fun ut_w64realign_src() str {
    ret "fun sink(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64) i64 {\n    ret a+b+c+d+e+f+g+h;\n}\n\n#[align(64)]\nrec Wide { pad: [64]u8; }\n\n#[symbol(\"mainCRTStartup\")]\nfun start() i32 {\n    var w: Wide;\n    w.pad[0] = 1;\n    var a: i64 = 1; var b: i64 = 2; var c: i64 = 3; var d: i64 = 4;\n    var e: i64 = 5; var f: i64 = 6; var g: i64 = 7; var h: i64 = 8;\n    var s: i64 = sink(a,b,c,d,e,f,g,h) + sink(h,g,f,e,d,c,b,a);\n    var va: i64x2 = i64x2{ s, w.pad[0]::i64 };\n    var vb: i64x2 = i64x2{ 0, 0 };\n    var vr: u64x2 = va < vb;\n    ret (s + w.pad[0]::i64 + vr[0]::i64)::i32;\n}\n";
}

