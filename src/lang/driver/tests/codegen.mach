test "mach.lang.driver:inline_asm_unknown_mnemonic_located" {
    var bad: i32 = 0;
    val src: str = "#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 {\n    $if ($mach.build.arch == $mach.arch.x86_64) { asm x86_64 { frobnicate } }\n    $or ($mach.build.arch == $mach.arch.aarch64) { asm aarch64 { frobnicate } }\n    $or { asm riscv64 { frobnicate } }\n    ret 0;\n}\n";
    if (ut_codegen_rejects(src, "'frobnicate'") != 0) { bad = 1; }
    $if ($mach.build.arch == $mach.arch.x86_64) {
        if (ut_codegen_rejects_at("#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 {\n    asm x86_64 { frobnicate }\n    ret 0;\n}\n",
            "unknown x86_64 inline-asm instruction 'frobnicate'", "main.mach", 3, 5) != 0) { bad = 1; }
    }
    ret bad;
}

fun ut_shift_value(i: u32) u64 {
    if (i == 0) { ret 0; }
    if (i == 1) { ret 0xFFFFFFFFFFFFFFFF; }
    if (i == 2) { ret 0xAA55AA55AA55AA55; }
    if (i == 3) { ret 0x0102040810204080; }
    if (i == 4) { ret 0x8000000080008080; }
    if (i == 5) { ret 1; }
    var seed: u64 = 0x243F6A8885A308D3 + i::u64;
    seed = seed ^ (seed << 13);
    seed = seed ^ (seed >> 7);
    seed = seed ^ (seed << 17);
    ret seed;
}

val UT_SHIFT_VALUES: u32 = 16;

fun ut_mul_ref(bits: u32, v: u64, w: u64) u64 {
    var mask: u64 = 0xFFFFFFFFFFFFFFFF;
    if (bits < 64) { mask = (1::u64 << bits::u64) - 1; }
    ret ((v & mask) * (w & mask)) & mask;
}

