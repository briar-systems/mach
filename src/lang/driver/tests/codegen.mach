    var texts: [1]str;
    texts[0] = "rec Two { a: i64; b: i64; }\nvar g: Two = Two{ a: 3, b: 4 };\nfun sum(t: Two) i64 { ret t.a + t.b; }\nfun main() i32 { ret sum(g)::i32; }\n";

    val pr: res[project.Project, outcome.Fail] = ut_build(?s, ?alloc, ?names[0], ?texts[0], 1);
    if (sel pr.err) {
