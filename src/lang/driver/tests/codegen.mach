test "mach.lang.driver:w64_vector_compare_saves_xmm_scratch" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }

    var img: Vector[u8];
    if (!ut_w64xmmscratch_image(?alloc, ?img)) { ret 2; }

    var text_sec:  UtPeSec;
    var pdata_sec: UtPeSec;
    var xdata_sec: UtPeSec;
    if (!ut_pe_find_sec(?img, ".text", ?text_sec))   { ret 3; }
    if (!ut_pe_find_sec(?img, ".pdata", ?pdata_sec)) { ret 4; }
    if (!ut_pe_find_sec(?img, ".xdata", ?xdata_sec)) { ret 5; }

    val b: *u8 = img.data;
    val n: u32 = pdata_sec.vsize / 12;
    if (n < 1) { ret 6; }

    var saw14: bool = false;
    var saw15: bool = false;

    var i: u32 = 0;
    for (i < n) {
        val row:    usize = pdata_sec.raw::usize + i::usize * 12;
        val uw_rva: u32   = ut_le32(b, row + 8)::u32;
        val xo_s:   i64   = ut_pe_sec_off(?xdata_sec, uw_rva);
        if (xo_s < 0) { ret 7; }
        val xo: usize = xo_s::usize;
        if (b[xo] != 0x01) { ret 8; }
        val cnt: u32 = b[xo + 2]::u32;

        var j: u32 = 0;
        for (j < cnt) {
            val slot: usize = xo + 4 + j::usize * 2;
            val op:   u8    = b[slot + 1] & 0x0F;
            val info: u8    = b[slot + 1] >> 4;
            if (op == 8) {
                if (info == 14) { saw14 = true; }
                or (info == 15) { saw15 = true; }
                j = j + 1;
            }
            or (op == 9) { j = j + 2; }
            or (op == 1) { j = j + 2; }
            j = j + 1;
        }
        i = i + 1;
    }

    if (!saw14 || !saw15) { ret 9; }

    vector.dnit[u8](?img);
    ret 0;
}

fun ut_float_zero_program() str {
    ret "val CT_N_D64: u64 = (-6.0f64 % 3.0f64):~u64;\nval CT_N_ND64: u64 = (-6.0f64 % -3.0f64):~u64;\nval CT_P_D64: u64 = (6.0f64 % 3.0f64):~u64;\nval CT_P_ND64: u64 = (6.0f64 % -3.0f64):~u64;\nval CT_NZ_D64: u64 = (-0.0f64 % 3.0f64):~u64;\nval CT_NZ_ND64: u64 = (-0.0f64 % -3.0f64):~u64;\nval CT_Z_D64: u64 = (0.0f64 % 3.0f64):~u64;\nval CT_Z_ND64: u64 = (0.0f64 % -3.0f64):~u64;\nval CT_N_D32: u32 = (-6.0f32 % 3.0f32):~u32;\nval CT_N_ND32: u32 = (-6.0f32 % -3.0f32):~u32;\nval CT_P_D32: u32 = (6.0f32 % 3.0f32):~u32;\nval CT_P_ND32: u32 = (6.0f32 % -3.0f32):~u32;\nval CT_NZ_D32: u32 = (-0.0f32 % 3.0f32):~u32;\nval CT_NZ_ND32: u32 = (-0.0f32 % -3.0f32):~u32;\nval CT_Z_D32: u32 = (0.0f32 % 3.0f32):~u32;\nval CT_Z_ND32: u32 = (0.0f32 % -3.0f32):~u32;\npub var N64: f64 = -6.0f64;\npub var P64: f64 = 6.0f64;\npub var Z64: f64 = 0.0f64;\npub var NZ64: f64 = -0.0f64;\npub var D64: f64 = 3.0f64;\npub var ND64: f64 = -3.0f64;\npub var N32: f32 = -6.0f32;\npub var P32: f32 = 6.0f32;\npub var Z32: f32 = 0.0f32;\npub var NZ32: f32 = -0.0f32;\npub var D32: f32 = 3.0f32;\npub var ND32: f32 = -3.0f32;\nfun check64(a: f64, b: f64, bits: u64) i32 {\n    if ((a % b):~u64 != bits) { ret 1; }\n    ret 0;\n}\nfun check32(a: f32, b: f32, bits: u32) i32 {\n    if ((a % b):~u32 != bits) { ret 1; }\n    ret 0;\n}\n#[symbol(\"probe\")]\nfun probe() i32 {\n    if (CT_N_D64 != 0x8000000000000000) { ret 1; }\n    if (check64(N64, D64, CT_N_D64) != 0) { ret 2; }\n    if (CT_N_ND64 != 0x8000000000000000) { ret 3; }\n    if (check64(N64, ND64, CT_N_ND64) != 0) { ret 4; }\n    if (CT_P_D64 != 0) { ret 5; }\n    if (check64(P64, D64, CT_P_D64) != 0) { ret 6; }\n    if (CT_P_ND64 != 0) { ret 7; }\n    if (check64(P64, ND64, CT_P_ND64) != 0) { ret 8; }\n    if (CT_NZ_D64 != 0x8000000000000000) { ret 9; }\n    if (check64(NZ64, D64, CT_NZ_D64) != 0) { ret 10; }\n    if (CT_NZ_ND64 != 0x8000000000000000) { ret 11; }\n    if (check64(NZ64, ND64, CT_NZ_ND64) != 0) { ret 12; }\n    if (CT_Z_D64 != 0) { ret 13; }\n    if (check64(Z64, D64, CT_Z_D64) != 0) { ret 14; }\n    if (CT_Z_ND64 != 0) { ret 15; }\n    if (check64(Z64, ND64, CT_Z_ND64) != 0) { ret 16; }\n    if (CT_N_D32 != 0x80000000) { ret 17; }\n    if (check32(N32, D32, CT_N_D32) != 0) { ret 18; }\n    if (CT_N_ND32 != 0x80000000) { ret 19; }\n    if (check32(N32, ND32, CT_N_ND32) != 0) { ret 20; }\n    if (CT_P_D32 != 0) { ret 21; }\n    if (check32(P32, D32, CT_P_D32) != 0) { ret 22; }\n    if (CT_P_ND32 != 0) { ret 23; }\n    if (check32(P32, ND32, CT_P_ND32) != 0) { ret 24; }\n    if (CT_NZ_D32 != 0x80000000) { ret 25; }\n    if (check32(NZ32, D32, CT_NZ_D32) != 0) { ret 26; }\n    if (CT_NZ_ND32 != 0x80000000) { ret 27; }\n    if (check32(NZ32, ND32, CT_NZ_ND32) != 0) { ret 28; }\n    if (CT_Z_D32 != 0) { ret 29; }\n    if (check32(Z32, D32, CT_Z_D32) != 0) { ret 30; }\n    if (CT_Z_ND32 != 0) { ret 31; }\n    if (check32(Z32, ND32, CT_Z_ND32) != 0) { ret 32; }\n    ret 0;\n}\n$if ($mach.build.os == $mach.os.windows) {\n    #[symbol(\"mainCRTStartup\")]\n    fun start() i32 { ret probe(); }\n}\n$or {\n    #[symbol(\"_start\")]\n    pub fun start() {\n        $if ($mach.build.arch == $mach.arch.x86_64) {\n            asm x86_64 {\n                and rsp, -16\n                call probe\n                mov edi, eax\n                mov rax, 60\n                syscall\n            }\n        }\n        $or ($mach.build.arch == $mach.arch.aarch64) {\n            asm aarch64 {\n                bl probe\n                mov x8, 93\n                svc 0\n            }\n        }\n        $or {\n            asm riscv64 {\n                call probe\n                li a7, 93\n                ecall\n            }\n        }\n    }\n}\n";
}

fun ut_float_zero_manifest() str {
    ret "[project]\nid=\"remainder\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out/{target.name}/{profile.name}\"\n[target.linux]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[target.windows]\nisa=\"x86_64\"\nos=\"windows\"\nabi=\"win64\"\n[target.linux-arm64]\nisa=\"aarch64\"\nos=\"linux\"\nabi=\"aapcs64\"\n[target.linux-riscv64]\nisa=\"riscv64\"\nos=\"linux\"\nabi=\"lp64d\"\n[profile.debug]\nopt=0\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n[artifact.probe]\nkind=\"bin\"\nentry=\"main.mach\"\nout=\"bin/probe.exe\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n";
}

fun ut_float_zero_profile(alloc: *A.Allocator, root: str, profile_name: str) i32 {
    val sr: res[session.Session, fail.Fail] = session.init(alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) { ret 2; }
    val mr: res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) { ret 3; }
    var m:  manifest.Manifest    = mr.ok;
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    rq.target       = "native";
    rq.profile      = profile_name;
    val pr: res[bplan.BuildPlan, outcome.Fail] = bplan.plan(alloc, ?s.interner, s.registry, ?m, rq);
    if (sel pr.err) { ret 4; }
    var bp: bplan.BuildPlan                         = pr.ok;
    val br: res[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, alloc, nil);
    if (sel br.err) { ret 5; }
    val bo: outcome.BuildOutcome = br.ok;
    if (bo.severity != outcome.BUILD_OK || bo.artifacts.len != 1) { ret 6; }
    var trapped: bool = false;
    var code:    i32  = 0;
    if (!ut_run_with_argc(root, "", bo.artifacts.data[0].path, 1, ?trapped, ?code)) { ret 7; }
    if (trapped || code != 0) {
        print.printf("float remainder {} child exit {}\n", profile_name, code);
        ret 8;
    }
    ret 0;
}

test "mach.lang.driver: floating remainder preserves signed zero in emitted native programs" {
    $if ($mach.build.os != $mach.os.linux && $mach.build.os != $mach.os.windows) { ret 0; }
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    val make_r:  err[A.Error] = page.make(?backing);
    if (sel make_r.err) { ret 1; }
    val init_r: err[A.Error] = arena.init(?ar, ?backing, 0);
    if (sel init_r.err) { ret 2; }
    fin { arena.dnit(?ar); }
    val make_r2: err[A.Error] = arena.make(?alloc, ?ar);
    if (sel make_r2.err) { ret 3; }
    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = ut_float_zero_program();
    val root_r: res[str, fail.Fail] = ut_scaffold_m(?alloc, ut_float_zero_manifest(), ?names[0], ?texts[0], 1);
    if (sel root_r.err) { ret 4; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?alloc, root); }
    val debug: i32 = ut_float_zero_profile(?alloc, root, "debug");
    if (debug != 0) {
        print.printf("float remainder debug build/run exit {}\n", debug);
        ret 5;
    }
    val release: i32 = ut_float_zero_profile(?alloc, root, "release");
    if (release != 0) {
        print.printf("float remainder release build/run exit {}\n", release);
        ret 6;
    }
    ret 0;
}

# a loop-carried value that is the right operand of a non-commutative op and
# is then overwritten by the result: `x = a - x` runs 5, 95, 5, ... and the
# seventh step leaves 95 (#3647). the shift keeps the count in a register
# operand and the address form reads x through memory
fun ut_right_operand_overwrite_program() str {
    ret "#[noinline]\nfun sub_loop(a: u64, n: u64) u64 {\n    var x: u64 = 5;\n    var i: u64 = 0;\n    for (i < n) {\n        x = a - x;\n        i = i + 1;\n    }\n    ret x;\n}\n#[noinline]\nfun shl_loop(a: u64, n: u64) u64 {\n    var x: u64 = 1;\n    var i: u64 = 0;\n    for (i < n) {\n        x = a << (x & 3);\n        i = i + 1;\n    }\n    ret x;\n}\n#[noinline]\nfun mem_loop(t: *u64, n: u64) u64 {\n    var x: u64 = 0;\n    var i: u64 = 0;\n    for (i < n) {\n        x = t[x] - x;\n        i = i + 1;\n    }\n    ret x;\n}\n#[symbol(\"main\")]\nfun main(argc: i64) i64 {\n    if (sub_loop(100, 7) != 95) { ret 1; }\n    if (sub_loop(100, 6) != 5)  { ret 2; }\n    if (shl_loop(3, 2) != 12)   { ret 3; }\n    var t: [8]u64;\n    var k: u64 = 0;\n    for (k < 8) { t[k] = k + 3; k = k + 1; }\n    if (mem_loop(?t[0], 3) != 3) { ret 4; }\n    ret 0;\n}\n";
}

test "mach.lang.driver:a_right_operand_overwritten_by_the_result_survives_both_pipelines" {
    $if ($mach.build.os != $mach.os.linux || $mach.build.arch != $mach.arch.x86_64) { ret 0; }
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err)                                                                                                              { ret 1; }
    if (ut_tag_native_case(?alloc, "linux-x86_64", "", false, ut_right_operand_overwrite_program(), "right operand overwrite") != 0) { ret 2; }
    if (ut_tag_native_case(?alloc, "linux-x86_64", "", true, ut_right_operand_overwrite_program(), "right operand overwrite") != 0)  { ret 3; }
    ret 0;
}

fun ut_ext_inline_asm(s: *session.Session, fn: *ir.Function, needle: str) bool {
    if (fn == nil) { ret false; }
    var k: u32 = 0;
    for (k < ut_inline_ops(fn, instruction.OP_ASM)) {
        if (ut_inline_asm_body_has(s, fn, k, needle)) { ret true; }
        k = k + 1;
    }
    ret false;
}

# the release pipeline keeps an outlier out of a narrower caller, #[inline]
# included, so the caller holds a call and none of the outlier's instructions;
# a baseline body still joins an outlier, and an outlier joins a caller that
# admits every extension it does
test "mach.lang.driver:inline_keeps_an_outlier_out_of_a_narrower_caller" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val initialized: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel initialized.err) { ret 2; }
    var s: session.Session = initialized.ok;
    fin { session.dnit(?s); }
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) { ret 3; }
    var names: [2]str = [2]str{"main.mach", "helper.mach"};
    var texts: [2]str;
    texts[1] = "#[extensions(sha)]\npub fun far() { asm x86_64 { sha256msg1 xmm0, xmm1 } }\npub fun plain(v: i32) i32 { ret v + 1; }\n";
    texts[0] = "use h: uniontest.helper;\npub fun far_caller() { h.far(); }\npub fun near_caller() i32 { ret h.plain(1); }\n#[extensions(sha)]\nfun outlier() { asm x86_64 { sha256msg1 xmm0, xmm1 } }\n#[inline]\n#[extensions(sha)]\nfun forced() { asm x86_64 { sha256msg2 xmm0, xmm1 } }\nfun helper(v: i32) i32 { ret v + 1; }\n#[extensions(sha)]\npub fun wide(v: i32) i32 { ret helper(v); }\npub fun caller() { outlier(); }\npub fun forcer() { forced(); }\n#[extensions(sse41, sha)]\npub fun wider() { outlier(); }\n#[extensions(sse41)]\npub fun sibling() { outlier(); }\n#[extensions(sha)]\nfun gen[T](v: T) T { asm x86_64 { sha256msg1 xmm0, xmm1 } ret v; }\npub fun generic_caller() i64 { ret gen[i64](1); }\n#[extensions(sha)]\nfun packed(args: ...) i64 { asm x86_64 { sha256msg1 xmm0, xmm1 } ret 0; }\npub fun pack_caller() i64 { ret packed(1, 2); }\nfun main() i32 { ret 0; }\n";
    val scaffold: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 2);
    if (sel scaffold.err) { ret 4; }
    val root: str = scaffold.ok;
    fin {
        fs.remove_all(?alloc, root);
        str_free(?alloc, root);
    }
    val lowered: res[project.Project, outcome.Fail] = ut_inline_prepare(?s, root, 0);
    if (sel lowered.err) { ret 5; }
    var p: project.Project = lowered.ok;
    fin { project.dnit_project(?p); }
    val mid: session.ModuleId = ut_mid(?p, ?s, "uniontest.main");
    if (mid == session.MODULE_NIL) { ret 7; }
    val m: *ir.Module = project.module_at(?p, mid::u32).ir_module;
    # across modules the copied body keeps the set: the outlier stays a call,
    # while a baseline helper beside it inlines
    val far: *ir.Function = ut_inline_function(?s, m, "uniontest.main.far_caller");
    if (ut_inline_ops(far, instruction.OP_CALL) != 1 || ut_inline_ops(far, instruction.OP_ASM) != 0) { ret 24; }
    if (ut_inline_calls_of(?s, m, "uniontest.main.near_caller") != 0)                                { ret 25; }
    val caller: *ir.Function = ut_inline_function(?s, m, "uniontest.main.caller");
    if (ut_inline_ops(caller, instruction.OP_CALL) != 1) { ret 8; }
    if (ut_inline_ops(caller, instruction.OP_ASM) != 0)  { ret 9; }
    if (ut_ext_inline_asm(?s, caller, "sha256msg1"))     { ret 10; }
    val forcer: *ir.Function = ut_inline_function(?s, m, "uniontest.main.forcer");
    if (ut_inline_ops(forcer, instruction.OP_CALL) != 1)       { ret 11; }
    if (ut_ext_inline_asm(?s, forcer, "sha256msg2"))           { ret 12; }
    if (ut_inline_calls_of(?s, m, "uniontest.main.wide") != 0) { ret 13; }
    val wider: *ir.Function = ut_inline_function(?s, m, "uniontest.main.wider");
    if (ut_inline_ops(wider, instruction.OP_CALL) != 0)           { ret 14; }
    if (!ut_ext_inline_asm(?s, wider, "sha256msg1"))              { ret 15; }
    if (ut_inline_calls_of(?s, m, "uniontest.main.sibling") != 1) { ret 16; }
    val outlier: *ir.Function = ut_inline_function(?s, m, "uniontest.main.outlier");
    if (outlier == nil || outlier.extensions != x64.EXT_SHA) { ret 17; }
    # the decorator's set is closed too: sse41 brings ssse3
    if (wider.extensions != (x64.EXT_SHA | x64.EXT_SSE41 | x64.EXT_SSSE3))  { ret 18; }
    if (ut_inline_function(?s, m, "uniontest.main.caller").extensions != 0) { ret 19; }
    # a generic or pack outlier's instance carries the set and stays out of its baseline caller
    val generic: *ir.Function = ut_inline_function(?s, m, "uniontest.main.generic_caller");
    if (ut_inline_ops(generic, instruction.OP_CALL) != 1 || ut_inline_ops(generic, instruction.OP_ASM) != 0) { ret 20; }
    var instances: u32 = 0;
    var fi:        u32 = 0;
    for (fi < m.function_len) {
        val fn: *ir.Function = ?m.functions[fi];
        if ((fn.flags & ir.FN_FLAG_WEAK) != 0 && fn.block_count > 0) {
            if (fn.extensions != x64.EXT_SHA) { ret 21; }
            instances = instances + 1;
        }
        fi = fi + 1;
    }
    # the generic instance and the pack instance
    if (instances != 2) { ret 22; }
    val pack: *ir.Function = ut_inline_function(?s, m, "uniontest.main.pack_caller");
    if (ut_inline_ops(pack, instruction.OP_CALL) != 1 || ut_inline_ops(pack, instruction.OP_ASM) != 0) { ret 23; }
    ret 0;
}

# the inliner's predicate is over the admitted sets, target selection
# included: an outlier the target already selects joins a baseline caller, the
# same predicate the encoder applies to the inlined body afterwards
test "mach.lang.driver:inline_admits_an_outlier_the_target_selects" {
    var alloc: A.Allocator;
    val made:  err[A.Error] = page.make(?alloc);
    if (sel made.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    val rr: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.err) { ret 1; }
    var names:  [1]str              = [1]str{"main.mach"};
    var texts:  [1]str              = [1]str{"#[inline]\n#[extensions(sha)]\nfun outlier() { asm x86_64 { sha256msg1 xmm0, xmm1 } }\npub fun caller() { outlier(); }\nfun main() i32 { ret 0; }\n"};
    val root_r: res[str, fail.Fail] = ut_scaffold_m(?alloc, ut_ext_manifest(?alloc, "x86_64", "linux", "sysv64", "[\"sha\"]"), ?names[0], ?texts[0], 1);
    if (sel root_r.err) { ret 2; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?alloc, root); }
    var pick: manifest.Selection = ut_target_sel("t");
    pick.profile = "release";
    val bp: res[project.Project, outcome.Fail] = driver.build_project(?s, root, ?pick);
    if (sel bp.err) { ret 3; }
    var p: project.Project = bp.ok;
    fin { project.dnit_project(?p); }
    val se: err[outcome.Fail] = driver.run_sema_pass(?p);
    if (sel se.err) { ret 4; }
    val le: err[outcome.Fail] = driver.run_lower_pass(?p);
    if (sel le.err) { ret 5; }
    val mid: session.ModuleId = ut_mid(?p, ?s, "exts.main");
    if (mid == session.MODULE_NIL) { ret 6; }
    val caller: *ir.Function = ut_inline_function(?s, project.module_at(?p, mid::u32).ir_module, "exts.main.caller");
    if (ut_inline_ops(caller, instruction.OP_CALL) != 0 || ut_inline_ops(caller, instruction.OP_ASM) != 1) { ret 7; }
    if (!ut_ext_inline_asm(?s, caller, "sha256msg1"))                                                      { ret 8; }
    # the inlined body encodes in its new home: the encoder reads the same admitted set
    val ce: err[outcome.Fail] = driver.run_codegen_pass(?p);
    if (sel ce.err) { ret 9; }
    ret 0;
}
