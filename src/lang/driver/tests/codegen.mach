    texts[0] = ut_w64realign_src();
    val root_r: res[str, fail.Fail] = ut_scaffold_m(alloc, ut_w64uw_manifest(), ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret false;
    }
    val root: str = root_r.ok;

    var ok: bool              = false;
    val rr: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.ok) {
        var tsel_18936: manifest.Selection                 = ut_target_sel("win");
        val pr:         res[project.Project, outcome.Fail] = driver.build_project(?s, root, ?tsel_18936);
        if (sel pr.ok) {
            var p: project.Project = pr.ok;
            if (ut_run_codegen_ok(?p) == 0) { ok = ut_w64uw_link(?p, out); }
            project.dnit_project(?p);
        }
    }
    fs.remove_all(alloc, root);
    session.dnit(?s);
    ret ok;
}

test "mach.lang.driver:w64_realigned_frame_records_callee_saves" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }

    var img: Vector[u8];
    if (!ut_w64realign_image(?alloc, ?img)) { ret 2; }

    var text_sec:  UtPeSec;
    var pdata_sec: UtPeSec;
    var xdata_sec: UtPeSec;
    if (!ut_pe_find_sec(?img, ".text", ?text_sec))   { ret 3; }
    if (!ut_pe_find_sec(?img, ".pdata", ?pdata_sec)) { ret 4; }
    if (!ut_pe_find_sec(?img, ".xdata", ?xdata_sec)) { ret 5; }

    val b: *u8 = img.data;
    val n: u32 = pdata_sec.vsize / 12;
    if (n < 1) { ret 6; }

    var found_realigned:   bool = false;
    var save_nonvol_count: u32  = 0;
    var save_xmm_count:    u32  = 0;

    var i: u32 = 0;
    for (i < n) {
        val row:    usize = pdata_sec.raw::usize + i::usize * 12;
        val uw_rva: u32   = ut_le32(b, row + 8)::u32;
        val xo_s:   i64   = ut_pe_sec_off(?xdata_sec, uw_rva);
        if (xo_s < 0) { ret 7; }
        val xo: usize = xo_s::usize;
        if (b[xo] != 0x01) { ret 8; }
        val psz: u32 = b[xo + 1]::u32;
        val cnt: u32 = b[xo + 2]::u32;

        var has_set_fpreg:   bool = false;
        var local_saves:     u32  = 0;
        var local_xmm_saves: u32  = 0;
        var j:               u32  = 0;
        for (j < cnt) {
            val slot: usize = xo + 4 + j::usize * 2;
            val eo:   u32   = b[slot]::u32;
            val op:   u8    = b[slot + 1] & 0x0F;
            if (eo > psz) { ret 9; }
            if (op == 3)  { has_set_fpreg = true; }
            or (op == 4) {
                local_saves = local_saves + 1;
                j           = j + 1;
            }
            or (op == 5) {
                local_saves = local_saves + 1;
                j           = j + 2;
            }
            or (op == 8) {
                local_xmm_saves = local_xmm_saves + 1;
                j               = j + 1;
            }
            or (op == 9) {
                local_xmm_saves = local_xmm_saves + 1;
                j               = j + 2;
            }
            or (op == 1) { j = j + 2; }
            j = j + 1;
        }

        if (has_set_fpreg) {
            found_realigned   = true;
            save_nonvol_count = local_saves;
            save_xmm_count    = local_xmm_saves;
        }
        i = i + 1;
    }

    if (!found_realigned)      { ret 10; }
    if (save_nonvol_count < 2) { ret 1; }
    if (save_xmm_count < 2)    { ret 12; }

    vector.dnit[u8](?img);
    ret 0;
}

