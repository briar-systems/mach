    ret bad;
}

fun ut_rv32_run2(mem: *u8, off: u32, a: u64, b: u64, out: *u64, steps: *u32) bool {
    var args: [4]u32;
    args[0] = (a & 0xFFFFFFFF)::u32;
    args[1] = (a >> 32)::u32;
    args[2] = (b & 0xFFFFFFFF)::u32;
    args[3] = (b >> 32)::u32;
    var lo: u32 = 0;
    var hi: u32 = 0;
    if (!ut_rv32_run(mem, off, ?args[0], 4, ?lo, ?hi, steps)) { ret false; }
    @out = lo::u64 | (hi::u64 << 32);
    ret true;
}

fun ut_rv32_probe_src(buf: *u8) usize {
    var w: usize = 0;
    w      = ut_app(buf, w, "#[symbol(\"_start\")]\nfun start() i32 { ret 0; }\n");
    w      = ut_app(buf, w, "fun mul64(a: i64, b: i64) i64 { ret a * b; }\n");
    w      = ut_app(buf, w, "fun xor64(a: i64, b: i64) i64 { ret a ^ b; }\n");
    w      = ut_app(buf, w, "fun add64(a: i64, b: i64) i64 { ret a + b; }\n");
    w      = ut_app(buf, w, "fun eq64(a: i64, b: i64) i64 { if (a == b) { ret 1; } ret 0; }\n");
    w      = ut_app(buf, w, "fun ltu64(a: u64, b: u64) i64 { if (a < b) { ret 1; } ret 0; }\n");
    w      = ut_app(buf, w, "fun lts64(a: i64, b: i64) i64 { if (a < b) { ret 1; } ret 0; }\n");
    w      = ut_app(buf, w, "fun shl64(a: u64, n: u64) u64 { ret a << n; }\n");
    w      = ut_app(buf, w, "fun shru64(a: u64, n: u64) u64 { ret a >> n; }\n");
    w      = ut_app(buf, w, "fun shrs64(a: i64, n: i64) i64 { ret a >> n; }\n");
    w      = ut_app(buf, w, "fun divu64(a: u64, b: u64) u64 { ret a / b; }\n");
    w      = ut_app(buf, w, "fun remu64(a: u64, b: u64) u64 { ret a % b; }\n");
    buf[w] = 0;
    ret w;
}

val UT_RV32_REMU: u32 = 10;

test "mach.lang.driver:wide_integer_executes_on_an_rv32_core_riscv32" {
    var bad:    i32          = 0;
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    val bufr: res[*u8, A.Error] = A.allocate[u8](?alloc, 8192);
    if (sel bufr.err) { ret 1; }
    val srcbuf: *u8 = bufr.ok;
    ut_rv32_probe_src(srcbuf);

    val memr: res[*u8, A.Error] = A.zallocate[u8](?alloc, UT_RV32_MEM);
    if (sel memr.err) {
        A.deallocate[u8](?alloc, srcbuf, 8192);
        ret 1;
    }
    val mem: *u8 = memr.ok;

    val pr: res[project.Project, outcome.Fail] = ut_ct_edge_project(?s, ?alloc, srcbuf::str, "rv32");
    if (sel pr.err) { bad = 1; }
    if (sel pr.ok) {
        var p: project.Project = pr.ok;
        if (ut_run_codegen_ok(?p) != 0) { bad = 1; }
        or {
            var tlen: u32 = 0;
            var offs: [16]u32;
            if (!ut_rv32_link_captured(?p, mem, ?tlen, ?offs[0])) { bad = 1; }
            or {
                if (ut_rv32_sweep(mem, ?offs[0]) != 0) { bad = 1; }
            }
        }
        project.dnit_project(?p);
    }

    A.deallocate[u8](?alloc, mem, UT_RV32_MEM);
    A.deallocate[u8](?alloc, srcbuf, 8192);
    ret bad;
}

test "mach.lang.driver:legalized_wide_local_has_a_piece_location_riscv32" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:  session.Session   = sr.ok;
    val rr: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "#[noinline]\nfun take(v: u64) u32 { ret (v >> 32)::u32; }\n\n#[noinline]\npub fun keep(seed: u64) u64 {\n    var a: u64 = seed * 7;\n    var b: u64 = seed * 11;\n    val h: u32 = take(a);\n    a = a + h::u64 + b;\n    ret a;\n}\n";
    val mtext:  str                 = "[project]\nmach = \">=5\"\nid = \"lanedbg\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.rv32]\nisa = \"rv32imafdc\"\nos = \"freestanding\"\nabi = \"ilp32d\"\nof = \"elf\"\nbase = 0x10000\n\n[artifact.app]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/app\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n";
    val root_r: res[str, fail.Fail] = ut_scaffold_m(?alloc, mtext, ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    var pick: manifest.Selection                 = ut_target_sel("rv32");
    val pr:   res[project.Project, outcome.Fail] = driver.build_project_sel(?s, root, ?pick);
    fs.remove_all(?alloc, root);
    if (sel pr.err) {
        print.eprintln(outcome.describe(pr.err));
        session.dnit(?s);
        ret 1;
    }
    var p:   project.Project = pr.ok;
    var bad: i32             = 0;
    if (p.target.debug == nil || p.target.debug.id != of.DBG_DWARF) { bad = 2; }
    p.req.debug = true;
    if (bad == 0 && ut_run_codegen_ok(?p) != 0) { bad = 3; }
    val mid: session.ModuleId = ut_mid(?p, ?s, "lanedbg.main");
    if (bad == 0 && mid == session.MODULE_NIL) { bad = 4; }
    if (bad == 0) {
        val img:    *of.ObjectImage = project.module_at(?p, mid::u32).object_image;
        var pieces: u32             = 0;
        var si:     u32             = 0;
        for (si < img.section_count) {
            val sec: *of.Section = ?img.sections[si];
            val nm:  opt[str]    = intern.lookup(img.interner, sec.name);
            if (sel nm.some && str_equals(nm.some, ".debug_loclists")) {
                var j: u32 = 1;
                for (j + 1 < sec.len) {
                    # a register lane, then DW_OP_piece 4
                    val op: u8 = sec.bytes[j - 1];
                    if (op >= 0x50 && op <= 0x6f && sec.bytes[j] == 0x93 && sec.bytes[j + 1] == 4) { pieces = pieces + 1; }
                    j = j + 1;
                }
            }
            si = si + 1;
        }
        # five composites of two lanes: keep's seed, a in two homes, b, and take's v,
        # whose binding rides a copy the allocator deletes and whose low lane that
        # copy overwrites, so it alone contributes one register lane
        if (pieces < 9) { bad = 5; }
    }
    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

fun ut_uleb32(bytes: *u8, len: u32, pos: *u32, out: *u32) bool {
    var v:     u32 = 0;
    var shift: u32 = 0;
    for (@pos < len) {
        val b: u8 = bytes[@pos];
        @pos = @pos + 1;
        v    = v | ((b & 0x7f)::u32 << shift);
        if ((b & 0x80) == 0) {
            @out = v;
            ret true;
        }
        shift = shift + 7;
        if (shift > 28) { ret false; }
    }
    ret false;
}

# one location list of the parsed section: where its base address sits (the
# relocation there names the function), its entry count and, for a single
# offset pair, the pair's bounds and the one-byte expression it carries
rec UtLocList {
    addr_at: u32;
    entries: u32;
    start:   u32;
    end:     u32;
    op:      u8;
    op_len:  u32;
}

# walks a DWARF 5 .debug_loclists body: each list opens with a base address
# and holds offset pairs until its end-of-list; anything else fails the parse
fun ut_parse_loclists(sec: *of.Section, out: *UtLocList, cap: u32, count: *u32) bool {
    @count = 0;
    if (sec.len < 12) { ret false; }
    val addr_size: u32 = sec.bytes[6]::u32;
    var pos:       u32 = 12;
    for (pos < sec.len) {
        if (sec.bytes[pos] != 0x06 || @count >= cap) { ret false; }
        var l: UtLocList;
        l.addr_at = pos + 1;
        pos       = pos + 1 + addr_size;
        l.entries = 0;
        l.start   = 0;
        l.end     = 0;
        l.op      = 0;
        l.op_len  = 0;
        var closed: bool = false;
        for (!closed && pos < sec.len) {
            val kind: u8 = sec.bytes[pos];
            pos = pos + 1;
            if (kind == 0x00) { closed = true; }
            or (kind == 0x04) {
                var s: u32 = 0;
                var e: u32 = 0;
                var n: u32 = 0;
                if (!ut_uleb32(sec.bytes, sec.len, ?pos, ?s)) { ret false; }
                if (!ut_uleb32(sec.bytes, sec.len, ?pos, ?e)) { ret false; }
                if (!ut_uleb32(sec.bytes, sec.len, ?pos, ?n)) { ret false; }
                if (pos + n > sec.len)                        { ret false; }
                l.start   = s;
                l.end     = e;
                l.op      = sec.bytes[pos];
                l.op_len  = n;
                pos       = pos + n;
                l.entries = l.entries + 1;
            }
            or { ret false; }
        }
        if (!closed) { ret false; }
        out[@count] = l;
        @count      = @count + 1;
    }
    ret true;
}

# the defined function symbol whose name ends in `tail`, or -1
fun ut_image_function(img: *of.ObjectImage, tail: str) i32 {
    var found: i32 = -1;
    var sy:    u32 = 0;
    for (sy < img.symbol_count) {
        val sym:     *of.Symbol = ?img.symbols[sy];
        val looked:  opt[str]   = intern.lookup(img.interner, sym.name);
        val defined: bool       = (sym.flags & of.SYM_OBJ_FLAG_FUNCTION) != 0 && !of.section_is_external(sym.section);
        if (sel looked.some) {
            if (defined && ut_name_tail_is(looked.some, tail)) {
                if (found >= 0) { ret -1; }
                found = sy::i32;
            }
        }
        sy = sy + 1;
    }
    ret found;
}

# the text offset, relative to `fn`, of the one relocation inside it that
# names `callee`: where the call instruction's target field sits
fun ut_call_reloc_offset(img: *of.ObjectImage, fn: *of.Symbol, callee: u32, out: *u32) bool {
    var hits: u32 = 0;
    var ri:   u32 = 0;
    for (ri < img.reloc_count) {
        val rl: *of.Relocation = ?img.relocations[ri];
        if (rl.section.index == fn.section.index && rl.sym == callee && rl.offset >= fn.offset && rl.offset < fn.offset + fn.size) {
            @out = rl.offset - fn.offset;
            hits = hits + 1;
        }
        ri = ri + 1;
    }
    ret hits == 1;
}

# whether the base address at `at` of the location list section is relocated
# against the function symbol `sym`
fun ut_loclist_owner_is(img: *of.ObjectImage, section: u32, at: u32, sym: u32) bool {
    var ri: u32 = 0;
    for (ri < img.reloc_count) {
        val rl: *of.Relocation = ?img.relocations[ri];
        if (rl.section.index == section && rl.offset == at) { ret rl.sym == sym; }
        ri = ri + 1;
    }
    ret false;
}

# compiles a function at -g whose first parameter's register is taken by a
# temporary before a call and whose second parameter's register is caller-saved
# and left alone until that call, then reads .debug_loclists back from the
# object image: the three lists (a, b and the temporary t) each hold one
# register offset pair, a's ends at the clobber, before the call, and b's and
# t's end at the instruction after the call
fun ut_clobbered_register_loclists(target_name: str) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    val rr: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.err) { ret 1; }

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "#[noinline]\nfun spend(v: u64) u64 { ret v + 1; }\n\n#[noinline]\npub fun clobbered(a: u64, b: u64) u64 {\n    val t: u64 = a * 3;\n    val r: u64 = spend(t + b);\n    ret r;\n}\n";
    val mtext:  str                 = "[project]\nmach = \">=5\"\nid = \"clobdbg\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.x64]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[target.arm64]\nisa = \"aarch64\"\nos = \"linux\"\nabi = \"aapcs64\"\n\n[target.rv64]\nisa = \"riscv64\"\nos = \"linux\"\nabi = \"lp64d\"\n\n[artifact.app]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/app\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n";
    val root_r: res[str, fail.Fail] = ut_scaffold_m(?alloc, mtext, ?names[0], ?texts[0], 1);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;

    var pick: manifest.Selection                 = ut_target_sel(target_name);
    val pr:   res[project.Project, outcome.Fail] = driver.build_project_sel(?s, root, ?pick);
    fs.remove_all(?alloc, root);
    if (sel pr.err) {
        print.eprintln(outcome.describe(pr.err));
        ret 1;
    }
    var p: project.Project = pr.ok;
    fin { project.dnit_project(?p); }
    if (p.target.debug == nil || p.target.debug.id != of.DBG_DWARF) { ret 2; }
    p.req.debug = true;
    if (ut_run_codegen_ok(?p) != 0) { ret 3; }
    val mid: session.ModuleId = ut_mid(?p, ?s, "clobdbg.main");
    if (mid == session.MODULE_NIL) { ret 4; }
    val img: *of.ObjectImage = project.module_at(?p, mid::u32).object_image;

    val fi: i32 = ut_image_function(img, "clobbered");
    val ci: i32 = ut_image_function(img, "spend");
    if (fi < 0 || ci < 0) { ret 5; }
    val fn: *of.Symbol = ?img.symbols[fi::u32];
    if (fn.size == 0) { ret 5; }
    var call_at: u32 = 0;
    if (!ut_call_reloc_offset(img, fn, ci::u32, ?call_at)) { ret 6; }

    var lists: [8]UtLocList;
    var count: u32 = 0;
    var lsec:  i32 = -1;
    var si:    u32 = 0;
    for (si < img.section_count) {
        val sec: *of.Section = ?img.sections[si];
        val nm:  opt[str]    = intern.lookup(img.interner, sec.name);
        if (sel nm.some && str_equals(nm.some, ".debug_loclists")) {
            if (!ut_parse_loclists(sec, ?lists[0], 8, ?count)) { ret 7; }
            lsec = si::i32;
        }
        si = si + 1;
    }
    if (lsec < 0) { ret 8; }

    # a call's target field ends the instruction within eight bytes on every
    # target here: rel32 after the opcode, one bl word, or auipc then jalr
    var owned:   u32 = 0;
    var at_call: u32 = 0;
    var at_temp: u32 = 0;
    var li:      u32 = 0;
    for (li < count) {
        val l: *UtLocList = ?lists[li];
        if (!ut_loclist_owner_is(img, lsec::u32, l.addr_at, fi::u32)) {
            li = li + 1;
            cnt;
        }
        owned = owned + 1;
        if (l.entries != 1)                          { ret 10; }
        if (l.op_len != 1)                           { ret 11; }
        if (l.op < 0x50 || l.op > 0x6f)              { ret 12; }
        if (l.start >= l.end || l.end > fn.size)     { ret 13; }
        if (l.end > call_at && l.end <= call_at + 8) { at_call = at_call + 1; }
        or (l.end <= call_at)                        { at_temp = at_temp + 1; }
        li = li + 1;
    }
    if (owned != 3)   { ret 9; }
    if (at_call != 2) { ret 14; }
    if (at_temp != 1) { ret 15; }
    ret 0;
}

test "mach.lang.driver:clobbered_parameter_register_ends_its_location_list_on_x86_64_aarch64_and_riscv64" {
    val x86: i32 = ut_clobbered_register_loclists("x64");
    if (x86 != 0) { ret 20 + x86; }
    val arm: i32 = ut_clobbered_register_loclists("arm64");
    if (arm != 0) { ret 40 + arm; }
    val rv: i32 = ut_clobbered_register_loclists("rv64");
    if (rv != 0) { ret 60 + rv; }
    ret 0;
}

fun ut_rv32_sweep(mem: *u8, offs: *u32) i32 {
    var bad:   i32 = 0;
    var steps: u32 = 0;
    var vi:    u32 = 0;
    for (vi < UT_SHIFT_VALUES) {
        val a:   u64 = ut_shift_value(vi);
        val b:   u64 = ut_shift_value((vi + 5) % UT_SHIFT_VALUES);
        var got: u64 = 0;

        if (!ut_rv32_run2(mem, offs[UT_RV32_MUL], a, b, ?got, ?steps)) { bad = 1; }
        or (got != ut_mul_ref(64, a, b))                               { bad = 1; }

        if (!ut_rv32_run2(mem, offs[UT_RV32_XOR], a, b, ?got, ?steps)) { bad = 1; }
        or (got != (a ^ b))                                            { bad = 1; }

        if (!ut_rv32_run2(mem, offs[UT_RV32_ADD], a, b, ?got, ?steps)) { bad = 1; }
        or (got != a + b)                                              { bad = 1; }

        if (!ut_rv32_run2(mem, offs[UT_RV32_EQ], a, a, ?got, ?steps)) { bad = 1; }
        or (got != 1)                                                 { bad = 1; }
        if (!ut_rv32_run2(mem, offs[UT_RV32_EQ], a, b, ?got, ?steps)) { bad = 1; }
        or (got != ut_rv32_bool(a == b))                              { bad = 1; }

        if (!ut_rv32_run2(mem, offs[UT_RV32_LTU], a, b, ?got, ?steps)) { bad = 1; }
        or (got != ut_rv32_bool(a < b))                                { bad = 1; }
        if (!ut_rv32_run2(mem, offs[UT_RV32_LTS], a, b, ?got, ?steps)) { bad = 1; }
        or (got != ut_rv32_bool(a::i64 < b::i64))                      { bad = 1; }

        if (b != 0) {
            if (!ut_rv32_run2(mem, offs[UT_RV32_DIVU], a, b, ?got, ?steps)) { bad = 1; }
            or (got != a / b)                                               { bad = 1; }
            if (!ut_rv32_run2(mem, offs[UT_RV32_REMU], a, b, ?got, ?steps)) { bad = 1; }
            or (got != a % b)                                               { bad = 1; }
        }
        vi = vi + 1;
    }

    var n: u64 = 0;
    for (n < 64) {
        var vj: u32 = 0;
        for (vj < 4) {
            val v:   u64 = ut_shift_value(vj);
            var got: u64 = 0;
            if (!ut_rv32_run2(mem, offs[UT_RV32_SHL], v, n, ?got, ?steps))  { bad = 1; }
            or (got != (v << n))                                            { bad = 1; }
            if (!ut_rv32_run2(mem, offs[UT_RV32_SHRU], v, n, ?got, ?steps)) { bad = 1; }
            or (got != (v >> n))                                            { bad = 1; }
            if (!ut_rv32_run2(mem, offs[UT_RV32_SHRS], v, n, ?got, ?steps)) { bad = 1; }
            or (got != (v::i64 >> n::i64)::u64)                             { bad = 1; }
            vj = vj + 1;
        }
        n = n + 1;
    }
    ret bad;
}

fun ut_rv32_bool(b: bool) u64 {
    if (b) { ret 1; }
    ret 0;
}

val UT_RV32_GA: u64 = 0x0123456789ABCDEF;

val UT_RV32_GN: u64 = 0xFFFFFFFF80000000;

fun ut_rv32_globals_src(buf: *u8) usize {
    var w: usize = 0;
    w      = ut_app(buf, w, "var ga: i64 = 0x0123456789ABCDEF;\n");
    w      = ut_app(buf, w, "var gn: i64 = -2147483648;\n");
    w      = ut_app(buf, w, "var gb: i64 = 0;\n");
    w      = ut_app(buf, w, "#[symbol(\"_start\")]\n");
    w      = ut_app(buf, w, "fun probe(pick: i32, v: i64) i64 {\n");
    w      = ut_app(buf, w, "    if (pick == 0) { ret ga; }\n");
    w      = ut_app(buf, w, "    if (pick == 1) { gb = v; ret gb; }\n");
    w      = ut_app(buf, w, "    if (pick == 2) { ret ga + v; }\n");
    w      = ut_app(buf, w, "    if (pick == 3) { ret ga - v; }\n");
    w      = ut_app(buf, w, "    if (pick == 4) { ret gb; }\n");
    w      = ut_app(buf, w, "    if (pick == 5) { ret gn; }\n");
    w      = ut_app(buf, w, "    if (pick == 6) { ret gn + v; }\n");
    w      = ut_app(buf, w, "    if (pick == 7) { ret gn - v; }\n");
    w      = ut_app(buf, w, "    ret 0;\n");
    w      = ut_app(buf, w, "}\n");
    buf[w] = 0;
    ret w;
}

val UT_RV32_G_LOAD:  u32 = 0;
val UT_RV32_G_STORE: u32 = 1;
val UT_RV32_G_ADD:   u32 = 2;
val UT_RV32_G_SUB:   u32 = 3;
val UT_RV32_G_READ:  u32 = 4;
val UT_RV32_G_NLOAD: u32 = 5;
val UT_RV32_G_NADD:  u32 = 6;
val UT_RV32_G_NSUB:  u32 = 7;

# runs the dispatcher case `pick` on a u64 split across two argument words
fun ut_rv32_run_pick(mem: *u8, pick: u32, v: u64, out: *u64, steps: *u32) bool {
    var args: [3]u32;
    args[0] = pick;
    args[1] = (v & 0xFFFFFFFF)::u32;
    args[2] = (v >> 32)::u32;
    var lo: u32 = 0;
    var hi: u32 = 0;
    if (!ut_rv32_run(mem, 0, ?args[0], 3, ?lo, ?hi, steps)) { ret false; }
    @out = lo::u64 | (hi::u64 << 32);
    ret true;
}

test "mach.lang.driver:wide_global_executes_on_an_rv32_core_riscv32" {
    var bad:    i32          = 0;
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    val bufr: res[*u8, A.Error] = A.allocate[u8](?alloc, 8192);
    if (sel bufr.err) {
        session.dnit(?s);
        ret 1;
    }
    val srcbuf: *u8 = bufr.ok;
    ut_rv32_globals_src(srcbuf);

    val memr: res[*u8, A.Error] = A.zallocate[u8](?alloc, UT_RV32_MEM);
    if (sel memr.err) {
        session.dnit(?s);
        ret 1;
    }
    val mem: *u8 = memr.ok;

    var ilen: u32 = 0;
    if (!ut_rv32_build_linked(?s, ?alloc, srcbuf::str, "rv32", mem, ?ilen)) { bad = 1; }
    or {
        if (ut_rv32_globals_sweep(mem) != 0) { bad = 1; }
    }

    A.deallocate[u8](?alloc, mem, UT_RV32_MEM);
    A.deallocate[u8](?alloc, srcbuf, 8192);
    session.dnit(?s);
    ret bad;
}

fun ut_rv32_globals_sweep(mem: *u8) i32 {
    var bad:   i32 = 0;
    var steps: u32 = 0;
    var got:   u64 = 0;

    if (!ut_rv32_run_pick(mem, UT_RV32_G_LOAD, 0, ?got, ?steps))  { ret 1; }
    or (got != UT_RV32_GA)                                        { bad = 1; }
    if (!ut_rv32_run_pick(mem, UT_RV32_G_NLOAD, 0, ?got, ?steps)) { ret 1; }
    or (got != UT_RV32_GN)                                        { bad = 1; }

    var vi: u32 = 0;
    for (vi < UT_SHIFT_VALUES) {
        val v: u64 = ut_shift_value(vi);

        if (!ut_rv32_run_pick(mem, UT_RV32_G_STORE, v, ?got, ?steps)) { bad = 1; }
        or (got != v)                                                 { bad = 1; }

        if (!ut_rv32_run_pick(mem, UT_RV32_G_READ, 0, ?got, ?steps)) { bad = 1; }
        or (got != v)                                                { bad = 1; }

        if (!ut_rv32_run_pick(mem, UT_RV32_G_LOAD, 0, ?got, ?steps)) { bad = 1; }
        or (got != UT_RV32_GA)                                       { bad = 1; }

        if (!ut_rv32_run_pick(mem, UT_RV32_G_ADD, v, ?got, ?steps)) { bad = 1; }
        or (got != UT_RV32_GA + v)                                  { bad = 1; }
        if (!ut_rv32_run_pick(mem, UT_RV32_G_SUB, v, ?got, ?steps)) { bad = 1; }
        or (got != UT_RV32_GA - v)                                  { bad = 1; }

        if (!ut_rv32_run_pick(mem, UT_RV32_G_NADD, v, ?got, ?steps)) { bad = 1; }
        or (got != UT_RV32_GN + v)                                   { bad = 1; }
        if (!ut_rv32_run_pick(mem, UT_RV32_G_NSUB, v, ?got, ?steps)) { bad = 1; }
        or (got != UT_RV32_GN - v)                                   { bad = 1; }

        vi = vi + 1;
    }
    ret bad;
}

# the #3615 repro: a u64 index is a wide value on rv32, and the address it
# forms reads the index's low lane, never a register nothing assigned
fun ut_rv32_index_src(buf: *u8) usize {
    var w: usize = 0;
    w      = ut_app(buf, w, "#[symbol(\"_start\")]\n");
    w      = ut_app(buf, w, "fun probe(seed: u64, salt: u32) u32 {\n");
    w      = ut_app(buf, w, "    var av: [8]u32;\n");
    w      = ut_app(buf, w, "    var i: u32 = 0;\n");
    w      = ut_app(buf, w, "    for (i < 8) {\n");
    w      = ut_app(buf, w, "        av[i] = salt + i * 7;\n");
    w      = ut_app(buf, w, "        i     = i + 1;\n");
    w      = ut_app(buf, w, "    }\n");
    w      = ut_app(buf, w, "    ret pick(av, seed);\n");
    w      = ut_app(buf, w, "}\n");
    w      = ut_app(buf, w, "#[noinline]\n");
    w      = ut_app(buf, w, "fun pick(av: [8]u32, seed: u64) u32 {\n");
    w      = ut_app(buf, w, "    var k: u64 = seed + 3;\n");
    w      = ut_app(buf, w, "    ret av[k];\n");
    w      = ut_app(buf, w, "}\n");
    buf[w] = 0;
    ret w;
}

# the rv32 target with a debug (o0, default) and a release (o2) profile
fun ut_rv32_index_manifest() str {
    ret "[project]\nmach = \">=5\"\nid = \"ix\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.rv32]\nisa = \"rv32imafdc\"\nos = \"freestanding\"\nabi = \"ilp32d\"\n\n[profile.debug]\ndefault = true\nopt = 0\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n\n[artifact.ix]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/ix\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
}

fun ut_rv32_index_sweep(mem: *u8) i32 {
    var bad:   i32 = 0;
    var steps: u32 = 0;
    var seed:  u32 = 0;
    for (seed < 5) {
        val salt: u32 = 1000 + seed * 13;
        var args: [3]u32;
        args[0] = seed;
        args[1] = 0;
        args[2] = salt;
        var lo: u32 = 0;
        var hi: u32 = 0;
        if (!ut_rv32_run(mem, 0, ?args[0], 3, ?lo, ?hi, ?steps)) { bad = 1; }
        or (lo != salt + (seed + 3) * 7)                         { bad = 1; }
        seed = seed + 1;
    }
    ret bad;
}

test "mach.lang.driver:wide_index_addresses_by_its_low_lane_on_an_rv32_core_riscv32" {
    var bad:    i32          = 0;
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    val bufr: res[*u8, A.Error] = A.allocate[u8](?alloc, 8192);
    if (sel bufr.err) {
        session.dnit(?s);
        ret 1;
    }
    val srcbuf: *u8 = bufr.ok;
    ut_rv32_index_src(srcbuf);

    val memr: res[*u8, A.Error] = A.zallocate[u8](?alloc, UT_RV32_MEM);
    if (sel memr.err) {
        session.dnit(?s);
        ret 1;
    }
    val mem: *u8 = memr.ok;

    var ilen: u32 = 0;
    if (!ut_rv32_build_linked_at(?s, ?alloc, ut_rv32_index_manifest(), "debug", srcbuf::str, "rv32", mem, ?ilen))   { bad = 1; }
    or (ut_rv32_index_sweep(mem) != 0)                                                                              { bad = 1; }
    if (!ut_rv32_build_linked_at(?s, ?alloc, ut_rv32_index_manifest(), "release", srcbuf::str, "rv32", mem, ?ilen)) { bad = 1; }
    or (ut_rv32_index_sweep(mem) != 0)                                                                              { bad = 1; }

    A.deallocate[u8](?alloc, mem, UT_RV32_MEM);
    A.deallocate[u8](?alloc, srcbuf, 8192);
    session.dnit(?s);
    ret bad;
}

# the #3616 repro and its signed and 16-bit kin: sub-word arithmetic wraps in
# a lane-wide register, and the widen to 64 bits masks or sign-extends what is
# there. which selects the pair, s is the summand
fun ut_rv32_widen_src(buf: *u8) usize {
    var w: usize = 0;
    w      = ut_app(buf, w, "#[symbol(\"_start\")]\n");
    w      = ut_app(buf, w, "fun probe(which: u32, s: u32) u64 {\n");
    w      = ut_app(buf, w, "    if (which == 0) { ret u8_u64(s::u8); }\n");
    w      = ut_app(buf, w, "    if (which == 1) { ret i8_i64(s::i8)::u64; }\n");
    w      = ut_app(buf, w, "    if (which == 2) { ret u16_u64(s::u16); }\n");
    w      = ut_app(buf, w, "    if (which == 3) { ret i16_i64(s::i16)::u64; }\n");
    w      = ut_app(buf, w, "    if (which == 4) { ret u8_i64(s::u8)::u64; }\n");
    w      = ut_app(buf, w, "    ret i16_u64(s::i16);\n");
    w      = ut_app(buf, w, "}\n");
    w      = ut_app(buf, w, "#[noinline]\n");
    w      = ut_app(buf, w, "fun u8_u64(s: u8) u64 { var a: u8 = 240 + s; a = a + 8; ret a::u64; }\n");
    w      = ut_app(buf, w, "#[noinline]\n");
    w      = ut_app(buf, w, "fun i8_i64(s: i8) i64 { var a: i8 = 100 + s; a = a + 100; ret a::i64; }\n");
    w      = ut_app(buf, w, "#[noinline]\n");
    w      = ut_app(buf, w, "fun u16_u64(s: u16) u64 { var a: u16 = 65000 + s; a = a + 600; ret a::u64; }\n");
    w      = ut_app(buf, w, "#[noinline]\n");
    w      = ut_app(buf, w, "fun i16_i64(s: i16) i64 { var a: i16 = 30000 + s; a = a + 30000; ret a::i64; }\n");
    w      = ut_app(buf, w, "#[noinline]\n");
    w      = ut_app(buf, w, "fun u8_i64(s: u8) i64 { var a: u8 = 240 + s; a = a + 8; ret a::i64; }\n");
    w      = ut_app(buf, w, "#[noinline]\n");
    w      = ut_app(buf, w, "fun i16_u64(s: i16) u64 { var a: i16 = 30000 + s; a = a + 30000; ret a::u64; }\n");
    buf[w] = 0;
    ret w;
}

fun ut_rv32_widen_expect(which: u32, s: u32) u64 {
    if (which == 0 || which == 4) { ret ((248 + s) & 0xFF)::u64; }
    if (which == 2)               { ret ((65600 + s) & 0xFFFF)::u64; }
    if (which == 1)               { ret ((200 + s)::i32 - 256)::i64::u64; }
    ret ((60000 + s)::i32 - 65536)::i64::u64;
}

fun ut_rv32_widen_sweep(mem: *u8) i32 {
    var bad:   i32 = 0;
    var steps: u32 = 0;
    var which: u32 = 0;
    for (which < 6) {
        var s: u32 = 0;
        for (s < 24) {
            var args: [2]u32;
            args[0] = which;
            args[1] = s;
            var lo: u32 = 0;
            var hi: u32 = 0;
            if (!ut_rv32_run(mem, 0, ?args[0], 2, ?lo, ?hi, ?steps))           { bad = 1; }
            or ((lo::u64 | (hi::u64 << 32)) != ut_rv32_widen_expect(which, s)) { bad = 1; }
            s = s + 3;
        }
        which = which + 1;
    }
    ret bad;
}

test "mach.lang.driver:a_widened_sub_word_value_is_masked_on_an_rv32_core_riscv32" {
    var bad:    i32          = 0;
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    val bufr: res[*u8, A.Error] = A.allocate[u8](?alloc, 8192);
    if (sel bufr.err) {
        session.dnit(?s);
        ret 1;
    }
    val srcbuf: *u8 = bufr.ok;
    ut_rv32_widen_src(srcbuf);

    val memr: res[*u8, A.Error] = A.zallocate[u8](?alloc, UT_RV32_MEM);
    if (sel memr.err) {
        session.dnit(?s);
        ret 1;
    }
    val mem: *u8 = memr.ok;

    var ilen: u32 = 0;
    if (!ut_rv32_build_linked_at(?s, ?alloc, ut_rv32_index_manifest(), "debug", srcbuf::str, "rv32", mem, ?ilen))   { bad = 1; }
    or (ut_rv32_widen_sweep(mem) != 0)                                                                              { bad = 1; }
    if (!ut_rv32_build_linked_at(?s, ?alloc, ut_rv32_index_manifest(), "release", srcbuf::str, "rv32", mem, ?ilen)) { bad = 1; }
    or (ut_rv32_widen_sweep(mem) != 0)                                                                              { bad = 1; }

    A.deallocate[u8](?alloc, mem, UT_RV32_MEM);
    A.deallocate[u8](?alloc, srcbuf, 8192);
    session.dnit(?s);
    ret bad;
}

# a double constant passed straight to a float parameter arrives whole in fa0:
# the callee reads its bit pattern back, so two integer halves in fa0 and fa1
# (the register-id guess of #3602 on the float bank) cannot pass
fun ut_rv32_fconst_src(buf: *u8) usize {
    var w: usize = 0;
    w      = ut_app(buf, w, "#[symbol(\"_start\")]\n");
    w      = ut_app(buf, w, "fun probe(salt: u32) u64 {\n");
    w      = ut_app(buf, w, "    ret bits(0.15625) + salt::u64;\n");
    w      = ut_app(buf, w, "}\n");
    w      = ut_app(buf, w, "#[noinline]\n");
    w      = ut_app(buf, w, "fun bits(v: f64) u64 {\n");
    w      = ut_app(buf, w, "    ret v:~u64;\n");
    w      = ut_app(buf, w, "}\n");
    buf[w] = 0;
    ret w;
}

fun ut_rv32_fconst_sweep(mem: *u8) i32 {
    var bad:   i32 = 0;
    var steps: u32 = 0;
    var salt:  u32 = 0;
    for (salt < 3) {
        var args: [1]u32;
        args[0] = salt;
        var lo: u32 = 0;
        var hi: u32 = 0;
        if (!ut_rv32_run(mem, 0, ?args[0], 1, ?lo, ?hi, ?steps))           { bad = 1; }
        or ((lo::u64 | (hi::u64 << 32)) != 0x3FC4000000000000 + salt::u64) { bad = 1; }
        salt = salt + 1;
    }
    ret bad;
}

test "mach.lang.driver:a_double_constant_argument_arrives_whole_on_an_rv32_core_riscv32" {
    var bad:    i32          = 0;
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    val bufr: res[*u8, A.Error] = A.allocate[u8](?alloc, 8192);
    if (sel bufr.err) {
        session.dnit(?s);
        ret 1;
    }
    val srcbuf: *u8 = bufr.ok;
    ut_rv32_fconst_src(srcbuf);

    val memr: res[*u8, A.Error] = A.zallocate[u8](?alloc, UT_RV32_MEM);
    if (sel memr.err) {
        session.dnit(?s);
        ret 1;
    }
    val mem: *u8 = memr.ok;

    var ilen: u32 = 0;
    if (!ut_rv32_build_linked_at(?s, ?alloc, ut_rv32_index_manifest(), "debug", srcbuf::str, "rv32", mem, ?ilen))   { bad = 1; }
    or (ut_rv32_fconst_sweep(mem) != 0)                                                                             { bad = 1; }
    if (!ut_rv32_build_linked_at(?s, ?alloc, ut_rv32_index_manifest(), "release", srcbuf::str, "rv32", mem, ?ilen)) { bad = 1; }
    or (ut_rv32_fconst_sweep(mem) != 0)                                                                             { bad = 1; }

    A.deallocate[u8](?alloc, mem, UT_RV32_MEM);
    A.deallocate[u8](?alloc, srcbuf, 8192);
    session.dnit(?s);
    ret bad;
}

fun ut_rv32_float_src(buf: *u8) usize {
    var w: usize = 0;
    w      = ut_app(buf, w, "var fb: i64 = 0;\n");
    w      = ut_app(buf, w, "#[symbol(\"_start\")]\n");
    w      = ut_app(buf, w, "fun probe(pick: i32, v: i64) i64 {\n");
    w      = ut_app(buf, w, "    val pd: *f64 = (?fb)::*f64;\n");
    w      = ut_app(buf, w, "    val ps: *f32 = (?fb)::*f32;\n");
    w      = ut_app(buf, w, "    if (pick == 0)  { @pd = v::f64;        ret fb; }\n");
    w      = ut_app(buf, w, "    if (pick == 1)  { @pd = (v::u64)::f64; ret fb; }\n");
    w      = ut_app(buf, w, "    if (pick == 2)  { @ps = v::f32;        ret fb; }\n");
    w      = ut_app(buf, w, "    if (pick == 3)  { @ps = (v::u64)::f32; ret fb; }\n");
    w      = ut_app(buf, w, "    if (pick == 4)  { fb = v; ret (@pd)::i64; }\n");
    w      = ut_app(buf, w, "    if (pick == 5)  { fb = v; ret ((@pd)::u64)::i64; }\n");
    w      = ut_app(buf, w, "    if (pick == 6)  { fb = v; ret (@ps)::i64; }\n");
    w      = ut_app(buf, w, "    if (pick == 7)  { fb = v; ret ((@ps)::u64)::i64; }\n");
    w      = ut_app(buf, w, "    if (pick == 8)  { fb = v; @pd = (@pd) + (@pd); ret fb; }\n");
    w      = ut_app(buf, w, "    if (pick == 9)  { fb = v; @pd = (@pd) * (@pd); ret fb; }\n");
    w      = ut_app(buf, w, "    if (pick == 10) { fb = v; @pd = (@pd) - 1.5; ret fb; }\n");
    w      = ut_app(buf, w, "    if (pick == 11) { fb = v; @pd = (@pd) / 3.0; ret fb; }\n");
    w      = ut_app(buf, w, "    if (pick == 12) { fb = v; @ps = (@ps) + (@ps); ret fb; }\n");
    w      = ut_app(buf, w, "    if (pick == 13) { fb = v; @ps = (@ps) * 0.5; ret fb; }\n");
    w      = ut_app(buf, w, "    if (pick == 14) { fb = v; if ((@pd) < 1.0) { ret 1; } ret 0; }\n");
    w      = ut_app(buf, w, "    if (pick == 15) { fb = v; if ((@pd) == (@pd)) { ret 1; } ret 0; }\n");
    w      = ut_app(buf, w, "    if (pick == 16) { fb = v; @pd = ((@ps))::f64; ret fb; }\n");
    w      = ut_app(buf, w, "    if (pick == 17) { fb = v; @ps = ((@pd))::f32; ret fb; }\n");
    w      = ut_app(buf, w, "    ret 0;\n");
    w      = ut_app(buf, w, "}\n");
    buf[w] = 0;
    ret w;
}

val UT_RV32_F_I64_F64: u32 = 0;
val UT_RV32_F_U64_F64: u32 = 1;
val UT_RV32_F_I64_F32: u32 = 2;
val UT_RV32_F_U64_F32: u32 = 3;
val UT_RV32_F_F64_I64: u32 = 4;
val UT_RV32_F_F64_U64: u32 = 5;
val UT_RV32_F_F32_I64: u32 = 6;
val UT_RV32_F_F32_U64: u32 = 7;
val UT_RV32_F_ADD_D:   u32 = 8;
val UT_RV32_F_MUL_D:   u32 = 9;
val UT_RV32_F_SUB_D:   u32 = 10;
val UT_RV32_F_DIV_D:   u32 = 11;
val UT_RV32_F_ADD_S:   u32 = 12;
val UT_RV32_F_MUL_S:   u32 = 13;
val UT_RV32_F_LT_D:    u32 = 14;
val UT_RV32_F_EQ_D:    u32 = 15;
val UT_RV32_F_EXT:     u32 = 16;
val UT_RV32_F_TRUNC:   u32 = 17;

val UT_RV32_FV: u32 = 8;

fun ut_rv32_fvalue(i: u32) u64 {
    if (i == 0) { ret 0; }
    if (i == 1) { ret 1; }
    if (i == 2) { ret 0xFFFFFFFFFFFFFFFF; }
    if (i == 3) { ret 0x8000000000000000; }
    if (i == 4) { ret 0x0020000000000000; }
    if (i == 5) { ret 0x0020000000000001; }
    if (i == 6) { ret 0x7FFFFFFFFFFFFFFF; }
    ret 0xFFFFFFFFFFFFFFFF;
}

val UT_RV32_FB: u32 = 14;

fun ut_rv32_fbits(i: u32) u64 {
    if (i == 0)  { ret 0x7FF8000000000000; }
    if (i == 1)  { ret 0x7FF0000000000000; }
    if (i == 2)  { ret 0xFFF0000000000000; }
    if (i == 3)  { ret 0x0000000000000000; }
    if (i == 4)  { ret 0x8000000000000000; }
    if (i == 5)  { ret 0x0000000000000001; }
    if (i == 6)  { ret 0x43E0000000000000; }
    if (i == 7)  { ret 0xC3E0000000000000; }
    if (i == 8)  { ret 0x43F0000000000000; }
    if (i == 9)  { ret 0xBFE0000000000000; }
    if (i == 10) { ret 0x4004000000000000; }
    if (i == 11) { ret 0xC004000000000000; }
    if (i == 12) { ret 0x4330000000000001; }
    if (i == 13) { ret 0x7E37E43C8800759C; }
    ret 0;
}

fun ut_rv32_f2i_ref(x: f64, unsigned: bool) u64 {
    if (x != x) {
        if (unsigned) { ret 0xFFFFFFFFFFFFFFFF; }
        ret 0x7FFFFFFFFFFFFFFF;
    }
    if (unsigned) {
        if (x >= 18446744073709551616.0) { ret 0xFFFFFFFFFFFFFFFF; }
        if (x <= -1.0)                   { ret 0; }
        if (x < 1.0)                     { ret 0; }
        ret x::u64;
    }
    if (x >= 9223372036854775808.0)  { ret 0x7FFFFFFFFFFFFFFF; }
    if (x <= -9223372036854775808.0) { ret 0x8000000000000000; }
    ret (x::i64)::u64;
}

fun ut_rv32_float_sweep(mem: *u8) i32 {
    var bad:   i32 = 0;
    var got:   u64 = 0;
    var steps: u32 = 0;

    var i: u32 = 0;
    for (i < UT_RV32_FV) {
        val v:  u64 = ut_rv32_fvalue(i);
        val sv: i64 = v::i64;

        val hd: f64 = sv::f64;
        if (!ut_rv32_run_pick(mem, UT_RV32_F_I64_F64, v, ?got, ?steps)) { ret 2; }
        or (got != (hd:~i64)::u64)                                      { bad = 1; }

        val hu: f64 = v::f64;
        if (!ut_rv32_run_pick(mem, UT_RV32_F_U64_F64, v, ?got, ?steps)) { ret 2; }
        or (got != (hu:~i64)::u64)                                      { bad = 1; }

        val hs: f32 = sv::f32;
        if (!ut_rv32_run_pick(mem, UT_RV32_F_I64_F32, v, ?got, ?steps)) { ret 2; }
        or ((got & 0xFFFFFFFF) != ((hs:~i32)::u32)::u64)                { bad = 1; }

        val hsu: f32 = v::f32;
        if (!ut_rv32_run_pick(mem, UT_RV32_F_U64_F32, v, ?got, ?steps)) { ret 2; }
        or ((got & 0xFFFFFFFF) != ((hsu:~i32)::u32)::u64)               { bad = 1; }

        i = i + 1;
    }

    i = 0;
    for (i < UT_RV32_FB) {
        val b: u64 = ut_rv32_fbits(i);
        val x: f64 = (b::i64):~f64;

        if (!ut_rv32_run_pick(mem, UT_RV32_F_F64_I64, b, ?got, ?steps)) { ret 2; }
        or (got != ut_rv32_f2i_ref(x, false))                           { bad = 1; }
        if (!ut_rv32_run_pick(mem, UT_RV32_F_F64_U64, b, ?got, ?steps)) { ret 2; }
        or (got != ut_rv32_f2i_ref(x, true))                            { bad = 1; }

        val s:  f32 = x::f32;
        val sb: u64 = ((s:~i32)::u32)::u64;
        val sx: f64 = s::f64;
        if (!ut_rv32_run_pick(mem, UT_RV32_F_F32_I64, sb, ?got, ?steps)) { ret 2; }
        or (got != ut_rv32_f2i_ref(sx, false))                           { bad = 1; }
        if (!ut_rv32_run_pick(mem, UT_RV32_F_F32_U64, sb, ?got, ?steps)) { ret 2; }
        or (got != ut_rv32_f2i_ref(sx, true))                            { bad = 1; }

        val two: f64 = x + x;
        if (!ut_rv32_run_pick(mem, UT_RV32_F_ADD_D, b, ?got, ?steps)) { ret 2; }
        or (got != (two:~i64)::u64)                                   { bad = 1; }
        val sq: f64 = x * x;
        if (!ut_rv32_run_pick(mem, UT_RV32_F_MUL_D, b, ?got, ?steps)) { ret 2; }
        or (got != (sq:~i64)::u64)                                    { bad = 1; }
        val dn: f64 = x - 1.5;
        if (!ut_rv32_run_pick(mem, UT_RV32_F_SUB_D, b, ?got, ?steps)) { ret 2; }
        or (got != (dn:~i64)::u64)                                    { bad = 1; }
        val dv: f64 = x / 3.0;
        if (!ut_rv32_run_pick(mem, UT_RV32_F_DIV_D, b, ?got, ?steps)) { ret 2; }
        or (got != (dv:~i64)::u64)                                    { bad = 1; }

        val s2: f32 = s + s;
        if (!ut_rv32_run_pick(mem, UT_RV32_F_ADD_S, sb, ?got, ?steps)) { ret 2; }
        or ((got & 0xFFFFFFFF) != ((s2:~i32)::u32)::u64)               { bad = 1; }
        val sh2: f32 = s * 0.5;
        if (!ut_rv32_run_pick(mem, UT_RV32_F_MUL_S, sb, ?got, ?steps)) { ret 2; }
        or ((got & 0xFFFFFFFF) != ((sh2:~i32)::u32)::u64)              { bad = 1; }

        var lt: u64 = 0;
        if (x < 1.0)                                                 { lt = 1; }
        if (!ut_rv32_run_pick(mem, UT_RV32_F_LT_D, b, ?got, ?steps)) { ret 2; }
        or (got != lt)                                               { bad = 1; }
        var eq: u64 = 0;
        if (x == x)                                                  { eq = 1; }
        if (!ut_rv32_run_pick(mem, UT_RV32_F_EQ_D, b, ?got, ?steps)) { ret 2; }
        or (got != eq)                                               { bad = 1; }

        val wide: f64 = s::f64;
        if (!ut_rv32_run_pick(mem, UT_RV32_F_EXT, sb, ?got, ?steps)) { ret 2; }
        or (got != (wide:~i64)::u64)                                 { bad = 1; }
        val narrow: f32 = x::f32;
        if (!ut_rv32_run_pick(mem, UT_RV32_F_TRUNC, b, ?got, ?steps)) { ret 2; }
        or ((got & 0xFFFFFFFF) != ((narrow:~i32)::u32)::u64)          { bad = 1; }

        i = i + 1;
    }
    ret bad;
}

test "mach.lang.driver:float_executes_on_an_rv32_core_riscv32" {
    var bad:    i32          = 0;
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    val mr: res[*u8, A.Error] = A.zallocate[u8](?alloc, UT_RV32_MEM);
    if (sel mr.err) { ret 1; }
    val mem: *u8 = mr.ok;

    val br: res[*u8, A.Error] = A.zallocate[u8](?alloc, 4096::usize);
    if (sel br.err) { ret 1; }
    val srcbuf: *u8 = br.ok;
    ut_rv32_float_src(srcbuf);

    var t: u32 = 0;
    for (t < 3) {
        var name: str = "rv32";
        if (t == 1) { name = "rv32f"; }
        or (t == 2) { name = "rv32s"; }
        var ilen: u32 = 0;
        if (!ut_rv32_build_linked(?s, ?alloc, srcbuf::str, name, mem, ?ilen)) { bad = 3; }
        or {
            val r: i32 = ut_rv32_float_sweep(mem);
            if (r > bad) { bad = r; }
        }
        t = t + 1;
    }
    ret bad;
}

test "mach.lang.driver:debug_info_on_windows_is_dwarf_with_section_relative_offsets" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "fun twice(v: i32) i32 {\n    val r: i32 = v + v;\n    ret r;\n}\n\nfun main() i32 { ret twice(4); }\n";
    val mtext:  str                 = "[project]\nmach = \">=5\"\nid = \"nodbg\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.windows]\nisa = \"x86_64\"\nos = \"windows\"\nabi = \"win64\"\n\n[artifact.app]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/app.exe\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n";
    val root_r: res[str, fail.Fail] = ut_scaffold_m(?alloc, mtext, ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    var pick: manifest.Selection;
    pick.target       = "windows";
    pick.profile      = "";
    pick.artifact     = "";
    pick.want_lib     = false;
    pick.has_artifact = false;
    val pr: res[project.Project, outcome.Fail] = driver.build_project_sel(?s, root, ?pick);
    if (sel pr.err) {
        print.print(outcome.describe(pr.err));
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var p:   project.Project = pr.ok;
    var bad: i32             = 0;
    if (p.target.debug == nil || p.target.debug.id != of.DBG_DWARF) { bad = 1; }
    p.req.debug = true;
    if (bad == 0 && ut_run_codegen_ok(?p) != 0) { bad = 2; }
    val mid: session.ModuleId = ut_mid(?p, ?s, "nodbg.main");
    if (bad == 0 && mid == session.MODULE_NIL) { bad = 3; }
    if (bad == 0) {
        val img:      *of.ObjectImage = project.module_at(?p, mid::u32).object_image;
        var info:     bool            = false;
        var secrel:   u32             = 0;
        var absolute: u32             = 0;
        var ri:       u32             = 0;
        var si:       u32             = 0;
        for (si < img.section_count) {
            val nm: opt[str] = intern.lookup(img.interner, img.sections[si].name);
            if (sel nm.some && str_equals(nm.some, ".debug_info")) { info = true; }
            si = si + 1;
        }
        for (ri < img.reloc_count) {
            val r:  *of.Relocation = ?img.relocations[ri];
            val sn: opt[str]       = intern.lookup(img.interner, img.sections[r.section.index].name);
            if (sel sn.some && string.str_starts_with(sn.some, ".debug_")) {
                if (r.kind == of.RK_SECREL32) { secrel = secrel + 1; }
                if (r.kind == of.RK_ABS32)    { absolute = absolute + 1; }
            }
            ri = ri + 1;
        }
        if (!info)        { bad = 4; }
        if (secrel == 0)  { bad = 5; }
        if (absolute > 0) { bad = 6; }
    }
    project.dnit_project(?p);
    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

fun ut_divide_program() str {
    ret "pub var Z: i32 = 0;\npub var N: i32 = 1;\npub var M: i32 = -2147483648;\npub var Q: i32 = -1;\npub var ZL: i64 = 0;\npub var ML: i64 = -9223372036854775807 - 1;\npub var QL: i64 = -1;\n\n#[symbol(\"main\")]\nfun main(argc: i64) i64 {\n    if (argc == 1) { val q: i32x4 = i32x4{-10, 10, -10, 1} / i32x4{3, -3, -3, 2}; if (q[0] != -3 || q[1] != -3 || q[2] != 3 || q[3] != 0) { ret 4; } if (100 / N == 100) { ret 0; } ret 3; }\n    if (argc == 2) { ret (100 / Z)::i64; }\n    if (argc == 3) { ret (M / Q)::i64; }\n    if (argc == 4) { ret 100 / ZL; }\n    if (argc == 5) { ret ML / QL; }\n    if (argc == 6) { val q: i32x4 = i32x4{100, 200, 300, 400} / i32x4{N, Z, N, N}; ret q[0]::i64; }\n    if (argc == 7) { val q: u64x2 = u64x2{18446744073709551615, 80} / u64x2{N::u64, ZL::u64}; ret q[0]::i64; }\n    if (argc == 8) { val q: i32x4 = i32x4{N, M, N, N} / i32x4{N, Q, N, N}; ret q[0]::i64; }\n    val q: i64x2 = i64x2{N::i64, ML} / i64x2{N::i64, QL}; ret q[0];\n}\n\n#[symbol(\"_start\")]\npub fun start() {\n    $if ($mach.build.arch == $mach.arch.x86_64) {\n        asm x86_64 {\n            mov rdi, [rsp]\n            and rsp, -16\n            call main\n            mov rdi, rax\n            mov rax, 60\n            syscall\n        }\n    }\n    $or ($mach.build.arch == $mach.arch.aarch64) {\n        asm aarch64 {\n            ldr x0, [sp]\n            bl main\n            mov x8, 93\n            svc 0\n        }\n    }\n    $or {\n        asm riscv64 {\n            ld a0, 0(sp)\n            call main\n            li a7, 93\n            ecall\n        }\n    }\n}\n";
}

fun ut_divide_trap_target(alloc: *A.Allocator, target_name: str, runner_name: str) i32 {
    var runner: str = "";
    if (!str_empty(runner_name)) {
        val rr: res[str, exec.Error] = exec.resolve(alloc, runner_name);
        if (sel rr.err) {
            print.print("divide-trap: runner absent, arm skipped: ");
            print.print(runner_name);
            print.print("\n");
            ret 0;
        }
        runner = rr.ok;
    }
    val sr: res[session.Session, fail.Fail] = session.init(alloc);
    if (sel sr.err) { ret 1; }
    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = ut_divide_program();
    val root_r: res[str, fail.Fail] = ut_scaffold_m(alloc, ut_divide_manifest(), ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    var bad: i32                                  = 0;
    val mr:  res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) {
        fs.remove_all(alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var m:  manifest.Manifest    = mr.ok;
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    rq.target       = target_name;
    val pr: res[bplan.BuildPlan, outcome.Fail] = bplan.plan(alloc, ?s.interner, s.registry, ?m, rq);
    if (sel pr.err) {
        fs.remove_all(alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var bp: bplan.BuildPlan                         = pr.ok;
    val br: res[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, alloc, nil);
    if (sel br.err) { bad = 1; }
    if (sel br.ok) {
        val bo: outcome.BuildOutcome = br.ok;
        if (bo.severity != outcome.BUILD_OK || bo.artifacts.len != 1) { bad = 1; }
        or {
            val program: str  = bo.artifacts.data[0].path;
            var trapped: bool = false;
            var code:    i32  = 0;
            if (!ut_run_with_argc(root, runner, program, 1, ?trapped, ?code) || trapped || code != 0) { bad = 2; }
            var argc: usize = 2;
            for (argc <= 9) {
                if (!ut_run_with_argc(root, runner, program, argc, ?trapped, ?code) || !trapped) {
                    print.print("divide-trap: no trap on ");
                    print.print(target_name);
                    print.printf(" for argc {} (exit {})\n", argc, code);
                    bad = 3;
                }
                argc = argc + 1;
            }
        }
    }
    val remove_all_r: err[fs.FsError] = fs.remove_all(alloc, root);
    if (sel remove_all_r.err) { bad = 4; }
    session.dnit(?s);
    ret bad;
}

test "mach.lang.driver:exceptional_division_traps_identically_on_every_native_backend" {
    $if ($mach.build.os != $mach.os.linux || $mach.build.arch != $mach.arch.x86_64) { ret 0; }
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err)                                                      { ret 1; }
    if (ut_divide_trap_target(?alloc, "linux-x86_64", "") != 0)              { ret 1; }
    if (ut_divide_trap_target(?alloc, "linux-arm64", "qemu-aarch64") != 0)   { ret 2; }
    if (ut_divide_trap_target(?alloc, "linux-riscv64", "qemu-riscv64") != 0) { ret 3; }
    ret 0;
}

fun ut_native_start_stub() str {
    ret "\n#[symbol(\"_start\")]\npub fun start() {\n    $if ($mach.build.arch == $mach.arch.x86_64) {\n        asm x86_64 {\n            mov rdi, [rsp]\n            and rsp, -16\n            call main\n            mov rdi, rax\n            mov rax, 60\n            syscall\n        }\n    }\n    $or ($mach.build.arch == $mach.arch.aarch64) {\n        asm aarch64 {\n            ldr x0, [sp]\n            bl main\n            mov x8, 93\n            svc 0\n        }\n    }\n    $or {\n        asm riscv64 {\n            ld a0, 0(sp)\n            call main\n            li a7, 93\n            ecall\n        }\n    }\n}\n";
}

# builds a freestanding fixture for one target and profile and runs it; the fixture exits 0 when every check holds
fun ut_native_fixture_case(alloc: *A.Allocator, target_name: str, runner_name: str, release: bool, program: str, label: str) i32 {
    var runner: str = "";
    if (!str_empty(runner_name)) {
        val rr: res[str, exec.Error] = exec.resolve(alloc, runner_name);
        if (sel rr.err) {
            print.print("native-fixture: runner absent, arm skipped: ");
            print.print(runner_name);
            print.print("\n");
            ret 0;
        }
        runner = rr.ok;
    }
    val sr: res[session.Session, fail.Fail] = session.init(alloc);
    if (sel sr.err) { ret 1; }
    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = ut_cc3(alloc, program, "\n", ut_native_start_stub());
    val root_r: res[str, fail.Fail] = ut_scaffold_m(alloc, ut_divide_manifest(), ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    var bad: i32                                  = 0;
    val mr:  res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) {
        fs.remove_all(alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var m:  manifest.Manifest    = mr.ok;
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    rq.target       = target_name;
    if (release) {
        rq.profile = "release";
        rq.opt     = pipeline.OPT_RELEASE;
    }
    val pr: res[bplan.BuildPlan, outcome.Fail] = bplan.plan(alloc, ?s.interner, s.registry, ?m, rq);
    if (sel pr.err) {
        fs.remove_all(alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var bp: bplan.BuildPlan                         = pr.ok;
    val br: res[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, alloc, nil);
    if (sel br.err) {
        print.print("native-fixture: build failed for ");
        print.print(label);
        print.print(" on ");
        print.print(target_name);
        print.print("\n");
        bad = 2;
    }
    if (sel br.ok) {
        val bo: outcome.BuildOutcome = br.ok;
        if (bo.severity != outcome.BUILD_OK || bo.artifacts.len != 1) { bad = 3; }
        or {
            var trapped: bool = false;
            var code:    i32  = 0;
            if (!ut_run_with_argc(root, runner, bo.artifacts.data[0].path, 1, ?trapped, ?code)) { bad = 4; }
            or (trapped || code != 0) {
                print.print("native-fixture: ");
                print.print(label);
                print.print(" on ");
                print.print(target_name);
                var profile_name: str = "debug";
                if (release) { profile_name = "release"; }
                print.print(" ");
                print.print(profile_name);
                print.printf(" (trapped {}, exit {})\n", trapped::u8, code);
                bad = 5;
            }
        }
    }
    val remove_all_r: err[fs.FsError] = fs.remove_all(alloc, root);
    if (sel remove_all_r.err) { bad = 6; }
    session.dnit(?s);
    ret bad;
}

# runs one fixture on the three native linux targets in both profiles
fun ut_native_fixture_all(alloc: *A.Allocator, program: str, label: str) i32 {
    var release: bool = false;
    var pass:    u32  = 0;
    for (pass < 2) {
        if (ut_native_fixture_case(alloc, "linux-x86_64", "", release, program, label) != 0)              { ret 1; }
        if (ut_native_fixture_case(alloc, "linux-arm64", "qemu-aarch64", release, program, label) != 0)   { ret 2; }
        if (ut_native_fixture_case(alloc, "linux-riscv64", "qemu-riscv64", release, program, label) != 0) { ret 3; }
        release = true;
        pass    = pass + 1;
    }
    ret 0;
}

# record transport extents (#3263): every carrier class on a poisoned stack, the callee never reads carrier padding
# as payload, a returned carrier never writes beyond the logical object, and padding, including the eightbyte no
# register delivered, is zero after the round trip
fun ut_record_extents_program() str {
    ret "rec P1 { a: u8; }\nrec T3 { a: u8; b: [2]u8; }\nrec T9 { a: u8; b: [8]u8; }\nrec S4 { a: u8; b: u16; }\nrec Nest { a: u8; b: S4; }\n#[packed]\nrec PK9 { a: u8; b: u64; }\n#[align(16)]\nrec AL16 { a: u8; b: u8; }\nrec TF { a: u8; b: f64; }\nrec TFM { b: f64; c: i64; }\nrec Mid { a: u8; b: [3]u8; c: [10]u8; }\n#[packed]\nrec Cell { lo: u8; t: T3; hi: u8; }\nrec Row { lo: u8; t: T9; hi: u8; }\n\n#[noinline] fun byte_at(p: *u8, i: u64) u8 { ret p[i]; }\n#[noinline] fun sink(p: *u8) u8 { ret p[0]; }\n# dirties the stack region a following callee's frame and its carrier homes will occupy\n#[noinline] fun dirty() u8 { var junk: [2048]u8; var i: u64 = 0; for (i < 2048) { junk[i] = 0xAA; i = i + 1; } ret sink(?junk[0]); }\n#[noinline] fun zeros_from(p: *u8, from: u64, to: u64) u8 { var i: u64 = from; for (i < to) { if (p[i] != 0) { ret 0; } i = i + 1; } ret 1; }\n\n#[noinline] fun mk_p1(x: u8) P1 { var r: P1; r.a = x; ret r; }\n#[noinline] fun mk_t3(x: u8) T3 { var r: T3; r.a = 1; r.b[0] = x; r.b[1] = x + 1; ret r; }\n#[noinline] fun mk_t9(x: u8) T9 { var r: T9; r.a = 1; r.b[0] = x; r.b[7] = x + 1; ret r; }\n#[noinline] fun mk_s4(x: u16) S4 { var r: S4; r.a = 1; r.b = x; ret r; }\n#[noinline] fun mk_nest(x: u16) Nest { var r: Nest; r.a = 1; r.b = mk_s4(x); ret r; }\n#[noinline] fun mk_pk9(x: u64) PK9 { var r: PK9; r.a = 1; r.b = x; ret r; }\n#[noinline] fun mk_al16(x: u8) AL16 { var r: AL16; r.a = 1; r.b = x; ret r; }\n#[noinline] fun mk_tf(x: f64) TF { var r: TF; r.a = 1; r.b = x; ret r; }\n#[noinline] fun mk_tfm(x: i64) TFM { var r: TFM; r.b = 2.5; r.c = x; ret r; }\n#[noinline] fun mk_mid(x: u8) Mid { var r: Mid; r.a = 1; r.b[0] = x; r.b[2] = x + 2; ret r; }\n\n# callee-side checks: the carrier's padding never becomes payload, and a copy of the parameter keeps its zero suffix\n#[noinline] fun t_p1(v: P1) u8 { ret v.a; }\n#[noinline] fun t_t3(v: T3) u8 { val c: T3 = v; if (c.a != 1) { ret 0xFF; } ret c.b[0] + c.b[1]; }\n#[noinline] fun t_t9(v: T9) u8 { val c: T9 = v; val p: *u8 = (?c)::*u8; if (byte_at(p, 0) != 1) { ret 0xFE; } ret c.b[0] + c.b[7]; }\n#[noinline] fun t_s4(v: S4) u16 { val p: *u8 = (?v)::*u8; if (byte_at(p, 1) != 0) { ret 0xFFFE; } if (v.a != 1) { ret 0xFFFF; } ret v.b; }\n#[noinline] fun t_nest(v: Nest) u16 { val p: *u8 = (?v)::*u8; if (byte_at(p, 1) != 0 || byte_at(p, 3) != 0) { ret 0xFFFE; } if (v.a != 1) { ret 0xFFFF; } ret t_s4(v.b); }\n#[noinline] fun t_pk9(v: PK9) u64 { val c: PK9 = v; if (c.a != 1) { ret 0; } ret c.b; }\n#[noinline] fun t_al16(v: AL16) u8 { val p: *u8 = (?v)::*u8; if (zeros_from(p, 2, 16) == 0) { ret 0xFE; } val c: AL16 = v; val q: *u8 = (?c)::*u8; if (zeros_from(q, 2, 16) == 0) { ret 0xFD; } if (c.a != 1) { ret 0xFF; } ret c.b; }\n#[noinline] fun t_tf(v: TF) f64 { val p: *u8 = (?v)::*u8; if (zeros_from(p, 1, 8) == 0) { ret -2.0; } if (v.a != 1) { ret -1.0; } ret v.b; }\n#[noinline] fun t_tfm(v: TFM) i64 { if (v.b != 2.5) { ret -1; } ret v.c; }\n#[noinline] fun t_mid(v: Mid) u8 { val p: *u8 = (?v)::*u8; if (zeros_from(p, 4, 14) == 0) { ret 0xFE; } if (v.a != 1) { ret 0xFF; } ret v.b[0] + v.b[2]; }\n#[noinline] fun many9(a: T9, b: T9, c: T9, d: T9, e: T9, f: T9, g: T9, h: T9, i: T9) u64 { ret t_t9(a)::u64 + t_t9(b)::u64 + t_t9(c)::u64 + t_t9(d)::u64 + t_t9(e)::u64 + t_t9(f)::u64 + t_t9(g)::u64 + t_t9(h)::u64 + t_t9(i)::u64; }\n#[noinline] fun many_al(a: AL16, b: AL16, c: AL16, d: AL16, e: AL16, f: AL16, g: AL16, h: AL16, i: AL16) u64 { ret t_al16(a)::u64 + t_al16(b)::u64 + t_al16(c)::u64 + t_al16(d)::u64 + t_al16(e)::u64 + t_al16(f)::u64 + t_al16(g)::u64 + t_al16(h)::u64 + t_al16(i)::u64; }\n#[noinline] fun after_al(a: AL16, next: i64) i64 { if (a.a != 1) { ret -1; } ret a.b::i64 + next; }\n#[noinline] fun al_after(first: i64, a: AL16, next: i64) i64 { if (a.a != 1) { ret -1; } ret a.b::i64 + next + first; }\n\n#[symbol(\"main\")]\nfun main(argc: i64) i64 {\n    if ($size_of(T3) != 3 || $size_of(T9) != 9 || $size_of(S4) != 4 || $size_of(Nest) != 6 || $size_of(PK9) != 9 || $size_of(AL16) != 16 || $align_of(AL16) != 16 || $size_of(TF) != 16 || $size_of(Mid) != 14) { ret 100; }\n    # round trips through carriers wider than the object, on a poisoned stack\n    dirty();\n    if (t_p1(mk_p1(0)) != 0 || t_p1(mk_p1(1)) != 1) { ret 1; }\n    dirty();\n    if (t_t3(mk_t3(3)) != 7) { ret 2; }\n    dirty();\n    if (t_t9(mk_t9(4)) != 9) { ret 3; }\n    dirty();\n    if (t_s4(mk_s4(0x1234)) != 0x1234) { ret 4; }\n    dirty();\n    if (t_nest(mk_nest(0x0506)) != 0x0506) { ret 5; }\n    dirty();\n    if (t_pk9(mk_pk9(0x1122334455667788)) != 0x1122334455667788) { ret 6; }\n    dirty();\n    if (t_al16(mk_al16(9)) != 9) { ret 7; }\n    dirty();\n    if (t_tf(mk_tf(2.5)) != 2.5) { ret 8; }\n    dirty();\n    if (t_tfm(mk_tfm(-77)) != -77) { ret 9; }\n    dirty();\n    if (t_mid(mk_mid(1)) != 4) { ret 10; }\n    dirty();\n    if (many9(mk_t9(1), mk_t9(2), mk_t9(3), mk_t9(4), mk_t9(5), mk_t9(6), mk_t9(7), mk_t9(8), mk_t9(9)) != 99) { ret 11; }\n    dirty();\n    if (many_al(mk_al16(1), mk_al16(2), mk_al16(3), mk_al16(4), mk_al16(5), mk_al16(6), mk_al16(7), mk_al16(8), mk_al16(9)) != 45) { ret 12; }\n    # the argument after an over-aligned record lands where the convention puts it\n    if (after_al(mk_al16(3), 40) != 43 || al_after(100, mk_al16(3), 40) != 143) { ret 13; }\n    # storing a returned carrier never writes beyond the logical object\n    var cell: Cell;\n    cell.lo = 0x5A; cell.hi = 0xA5;\n    dirty();\n    cell.t = mk_t3(1);\n    if (cell.lo != 0x5A || cell.hi != 0xA5 || t_t3(cell.t) != 3) { ret 20; }\n    var row: Row;\n    row.lo = 0x5A; row.hi = 0xA5;\n    dirty();\n    row.t = mk_t9(1);\n    if (row.lo != 0x5A || row.hi != 0xA5 || t_t9(row.t) != 3) { ret 21; }\n    var arr: [3]T9;\n    val pa: *u8 = (?arr)::*u8;\n    var i: u64 = 0;\n    for (i < 27) { pa[i] = 0xCC; i = i + 1; }\n    dirty();\n    arr[1] = mk_t9(2);\n    if (byte_at(pa, 8) != 0xCC || byte_at(pa, 18) != 0xCC || byte_at(pa, 9) != 1 || t_t9(arr[1]) != 5) { ret 22; }\n    var cells: [3]T3;\n    val pc: *u8 = (?cells)::*u8;\n    i = 0;\n    for (i < 9) { pc[i] = 0xCC; i = i + 1; }\n    dirty();\n    cells[1] = mk_t3(2);\n    if (byte_at(pc, 2) != 0xCC || byte_at(pc, 6) != 0xCC || byte_at(pc, 3) != 1 || byte_at(pc, 4) != 2 || byte_at(pc, 5) != 3) { ret 23; }\n    # the padding of a returned object is zero after the round trip, including the eightbyte no register delivered\n    dirty();\n    var s: S4 = mk_s4(7);\n    val ps: *u8 = (?s)::*u8;\n    if (byte_at(ps, 1) != 0) { ret 30; }\n    dirty();\n    var n: Nest = mk_nest(8);\n    val pn: *u8 = (?n)::*u8;\n    if (byte_at(pn, 1) != 0 || byte_at(pn, 3) != 0) { ret 31; }\n    dirty();\n    var al: AL16 = mk_al16(1);\n    if (zeros_from((?al)::*u8, 2, 16) == 0) { ret 32; }\n    dirty();\n    var tf: TF = mk_tf(1.0);\n    if (zeros_from((?tf)::*u8, 1, 8) == 0) { ret 33; }\n    dirty();\n    var m: Mid = mk_mid(0);\n    if (zeros_from((?m)::*u8, 4, 14) == 0) { ret 34; }\n    ret 0;\n}\n";
}

test "mach.lang.driver:record_transport_preserves_logical_extents_through_wider_carriers_on_every_native_backend" {
    $if ($mach.build.os != $mach.os.linux || $mach.build.arch != $mach.arch.x86_64) { ret 0; }
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    ret ut_native_fixture_all(?alloc, ut_record_extents_program(), "transport extents");
}

# vector `::` against the scalar `::` of each lane on every native backend (#3493)
fun ut_vector_cast_program() str {
