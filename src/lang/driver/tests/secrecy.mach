#[testing]
fun ut_codegen_target_rejects(src: str, target_name: str, needle: str) i32 {
    ret ut_codegen_profile_rejects(src, target_name, "", needle);
}

test secret_vector_division__refuses_either_secret_operand {
    if (!ut_sema_clean("fun signed(a: i32x4, b: i32x4) i32x4 { ret a / b; }\nfun unsigned(a: u64x2, b: u64x2) u64x2 { ret a / b; }\nfun main() i32 { ret 0; }\n")) { ret 1; }
    if (ut_vec_diag("#[oblivious]\nfun f(a: ^i32x4, b: i32x4) ^i32x4 { ret a / b; }\nfun main() i32 { ret 0; }\n",
        "secret divisor or dividend leaks through timing") != 0) { ret 2; }
    if (ut_vec_diag("#[oblivious]\nfun f(a: u64x2, b: ^u64x2) ^u64x2 { ret a / b; }\nfun main() i32 { ret 0; }\n",
        "secret divisor or dividend leaks through timing") != 0) { ret 3; }
    ret 0;
}

test is_secret__answers_the_outer_qualifier {
    var bad: i32 = 0;

    if (ut_arm("fun main() i32 { $if ($is_secret(^u64)) { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n", "Y", "N") != 0)                  { bad = 1; }
    if (ut_arm("rec P { a: u64; }\nfun main() i32 { $if ($is_secret(^P)) { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n", "Y", "N") != 0) { bad = 1; }
    if (ut_arm("fun main() i32 { $if ($is_secret(^*u8)) { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n", "Y", "N") != 0)                  { bad = 1; }
    if (ut_arm("fun main() i32 { $if ($is_secret(^^u64)) { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n", "Y", "N") != 0)                 { bad = 1; }

    if (ut_arm("fun main() i32 { $if ($is_secret(u64)) { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n", "N", "Y") != 0)                  { bad = 1; }
    if (ut_arm("rec P { a: u64; }\nfun main() i32 { $if ($is_secret(P)) { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n", "N", "Y") != 0) { bad = 1; }

    if (ut_arm("fun main() i32 { $if ($is_secret(*^u8)) { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n", "N", "Y") != 0)                                                 { bad = 1; }
    if (ut_arm("fun main() i32 { $if ($is_secret($pointee_of(*^u8))) { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n", "Y", "N") != 0)                                    { bad = 1; }
    if (ut_arm("fun main() i32 { $if ($is_secret([4]^u8)) { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n", "N", "Y") != 0)                                               { bad = 1; }
    if (ut_arm("rec S { k: ^u64; n: u64; }\nfun main() i32 { $if ($is_secret(S)) { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n", "N", "Y") != 0)                        { bad = 1; }
    if (ut_arm("rec S { k: ^u64; }\nfun main() i32 { $each f in $fields(S) { $if ($is_secret(f.type)) { $error(\"Y\"); } $or { $error(\"N\"); } } ret 0; }\n", "Y", "N") != 0) { bad = 1; }
    if (ut_arm("rec S { n: u64; }\nfun main() i32 { $each f in $fields(S) { $if ($is_secret(f.type)) { $error(\"Y\"); } $or { $error(\"N\"); } } ret 0; }\n", "N", "Y") != 0)  { bad = 1; }
    if (ut_arm("rec Box[T] { v: T; }\nfun main() i32 { $if ($is_secret(Box[^u64])) { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n", "N", "Y") != 0)                      { bad = 1; }

    if (ut_arm("rec P { a: u64; }\nfun main() i32 { $if ($is_record(^P)) { $error(\"REC\"); } $or { $if ($is_secret(^P)) { $error(\"SEC\"); } $or { $error(\"NEITHER\"); } } ret 0; }\n", "SEC", "NEITHER") != 0) { bad = 1; }

    if (ut_vec_diag("fun probe[T]() i32 { $if ($is_secret(T)) { $error(\"SEC\"); } $or { $error(\"PUB\"); } ret 0; }\nfun main() i32 { ret probe[^u64]() + probe[u64](); }\n", "SEC") != 0) { bad = 1; }
    if (ut_vec_diag("fun probe[T]() i32 { $if ($is_secret(T)) { $error(\"SEC\"); } $or { $error(\"PUB\"); } ret 0; }\nfun main() i32 { ret probe[^u64]() + probe[u64](); }\n", "PUB") != 0) { bad = 1; }

    if (ut_vec_diag("fun main() i32 { val b: u8 = $is_secret(^u64); ret 0; }\n",
        "comptime type predicate is comptime-only") != 0) { bad = 1; }
    if (ut_vec_diag("fun main() i32 { $if ($is_secret()) { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n",
        "expected 1 argument") != 0) { bad = 1; }

    ret bad;
}

# an #[oblivious] provider body is expanded only into an #[oblivious] importer
test inline__oblivious_callee_stays_a_call_in_a_public_caller {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val initialized: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel initialized.err) { ret 2; }
    var s: session.Session = initialized.ok;
    fin { session.dnit(?s); }
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) { ret 3; }
    var names: [2]str = [2]str{"main.mach", "helper.mach"};
    var texts: [2]str;
    texts[0] = "use h: uniontest.helper;\npub fun open(v: ^i32) ^i32 { ret h.classified(v); }\n#[oblivious] pub fun closed(v: ^i32) ^i32 { ret h.classified(v); }\nfun main() i32 { ret 0; }\n";
    texts[1] = "#[oblivious] pub fun classified(v: ^i32) ^i32 { ret v + 1; }\n";
    val scaffold: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 2);
    if (sel scaffold.err) { ret 4; }
    val root: str = scaffold.ok;
    fin {
        fs.remove_all(?alloc, root);
        str_free(?alloc, root);
    }
    val lowered: res[project.Project, outcome.Fail] = ut_inline_prepare(?s, root, 0);
    if (sel lowered.err) { ret 5; }
    var p: project.Project = lowered.ok;
    fin { project.dnit_project(?p); }
    val mid: session.ModuleId = ut_mid(?p, ?s, "uniontest.main");
    if (mid == session.MODULE_NIL) { ret 6; }
    val m: *ir.Module = project.module_at(?p, mid::u32).ir_module;
    if (ut_inline_calls_of(?s, m, "uniontest.main.open") != 1) { ret 7; }
    val closed: *ir.Function = ut_inline_function(?s, m, "uniontest.main.closed");
    if (ut_inline_ops(closed, instruction.OP_CALL) != 0) { ret 8; }
    var secret_add: bool = false;
    var ii:         u32  = 0;
    for (ii < closed.instr_len) {
        if (closed.instrs[ii].kind == instruction.OP_ADD && closed.instrs[ii].secret) { secret_add = true; }
        ii = ii + 1;
    }
    if (!secret_add) { ret 9; }
    ret 0;
}

#[testing]
fun ut_ir_param_extent_is(
    s: *session.Session,
    m: *ir.Module,
    tgt: *target.Target,
    symbol: str,
    param: u32,
    size: u32,
    align: u32) bool {
    val nr: res[intern.StrId, A.Error] = intern.intern(?s.interner, symbol);
    if (sel nr.err) { ret false; }
    val fi: opt[u32] = ir.function_lookup(m, nr.ok);
    if (sel fi.none) { ret false; }
    val f:  *ir.Function         = ?m.functions[fi.some];
    val st: opt[*ir_type.IrType] = ir_type.get(?m.types, f.sig);
    if (sel st.none) { ret false; }
    val sig: *ir_type.IrType = st.some;
    if (sig.kind != ir_type.IRT_FN || param >= sig.data.fn.param_count) { ret false; }
    val ty: ir_type.IrTypeId = sig.data.fn.params[param];
    ret ir_type.byte_size_for_machine(?m.types, ty, resolved.layout_machine(tgt)) == size
        && ir_type.byte_align_for_machine(?m.types, ty, resolved.layout_machine(tgt)) == align;
}

test secrecy__join_coerce_and_strip_are_clean {
    val src: str = "rec Key { d: ^[32]u8; }\nuni Both { a: ^u32; b: ^u32; }\nfun join(a: ^u32, b: ^u32) ^u32 { ret a + b; }\nfun join_pub(a: ^u32) ^u32 { ret a * 2; }\nfun up(p: u32) ^u32 { ret p; }\nfun down(a: ^u32) u32 { ret a:>u32; }\nfun down_typed(a: ^u32) u32 { ret a:>u32; }\nfun store_ok(p: *^u8, v: u8) { @p = v; }\nfun field_read(k: Key) ^u8 { ret k.d[0]; }\nfun main() i32 { ret 0; }\n";
    if (!ut_sema_clean(src)) { ret 1; }
    ret 0;
}

test secret_gate__refuses_branch_index_division_and_logic {
    var bad: i32 = 0;
    if (!ut_sema_rejects("fun f(a: ^u32) i32 { if (a) { ret 1; } ret 0; }\nfun main() i32 { ret 0; }\n"))  { bad = 1; }
    if (!ut_sema_rejects("fun f(a: ^u32) i32 { for (a) { ret 1; } ret 0; }\nfun main() i32 { ret 0; }\n")) { bad = 1; }
    if (!ut_sema_rejects("fun f(t: *u8, i: ^u64) u8 { ret t[i]; }\nfun main() i32 { ret 0; }\n"))          { bad = 1; }
    if (!ut_sema_rejects("fun f(a: ^u32, b: ^u32) ^u32 { ret a / b; }\nfun main() i32 { ret 0; }\n"))      { bad = 1; }
    if (!ut_sema_rejects("fun f(a: ^u32, b: ^u32) ^u32 { ret a % b; }\nfun main() i32 { ret 0; }\n"))      { bad = 1; }
    if (!ut_sema_rejects("fun f(a: ^u32, b: u32) ^u8 { ret a && b; }\nfun main() i32 { ret 0; }\n"))       { bad = 1; }
    if (!ut_sema_clean("fun f(a: u8) i32 { if (a) { ret 1; } ret 0; }\nfun main() i32 { ret 0; }\n"))      { bad = 1; }
    if (!ut_sema_clean("fun f(t: *u8, i: u64) u8 { ret t[i]; }\nfun main() i32 { ret 0; }\n"))             { bad = 1; }
    if (!ut_sema_clean("fun f(a: u32, b: u32) u32 { ret a / b; }\nfun main() i32 { ret 0; }\n"))           { bad = 1; }
    if (!ut_sema_clean("fun f(a: u8, b: ^u8) ^u8 { ret a && b; }\nfun main() i32 { ret 0; }\n"))           { bad = 1; }
    ret bad;
}

test secret_address__refused_as_a_memory_address {
    var bad:    i32 = 0;
    val needle: str = "secret value used as a memory address";

    if (!ut_sema_rejects_with("fun f(p: ^*u8) ^u8 { ret @p; }\nfun main() i32 { ret 0; }\n", needle))                   { bad = 1; }
    if (!ut_sema_rejects_with("fun f(p: ^*u8) { @p = 7; }\nfun main() i32 { ret 0; }\n", needle))                       { bad = 1; }
    if (!ut_sema_rejects_with("fun f(p: ^*u8) ^u8 { ret p[0]; }\nfun main() i32 { ret 0; }\n", needle))                 { bad = 1; }
    if (!ut_sema_rejects_with("rec R { x: u8; }\nfun f(p: ^*R) ^u8 { ret p.x; }\nfun main() i32 { ret 0; }\n", needle)) { bad = 1; }
    if (!ut_sema_rejects_with("fun f(q: **u8) ^u8 { val p: ^*u8 = @q; ret @p; }\nfun main() i32 { ret 0; }\n", needle)) { bad = 1; }

    if (!ut_sema_clean("fun f(t: ^[8]u8) ^u8 { ret t[3]; }\nfun main() i32 { ret 0; }\n"))             { bad = 1; }
    if (!ut_sema_clean("fun f(p: *^u8) ^u8 { ret @p; }\nfun main() i32 { ret 0; }\n"))                 { bad = 1; }
    if (!ut_sema_clean("fun f(p: *u8) u8 { ret p[0]; }\nfun main() i32 { ret 0; }\n"))                 { bad = 1; }
    if (!ut_sema_clean("rec R { x: u8; }\nfun f(p: *R) u8 { ret p.x; }\nfun main() i32 { ret 0; }\n")) { bad = 1; }
    if (!ut_sema_clean("fun f(p: ^*u8) u8 { ret @(p:>*u8); }\nfun main() i32 { ret 0; }\n"))           { bad = 1; }
    if (!ut_sema_clean("fun f(p: ^*u8) ^*u8 { ret p; }\nfun main() i32 { ret 0; }\n"))                 { bad = 1; }
    ret bad;
}

test secret_union__variants_agree_by_byte_extent {
    val need: str = "union variants must agree on secrecy";

    var bad: i32 = 0;
    if (!ut_sema_rejects_with("rec A { x: ^u8; y: u8; }\nrec B { x: ^u32; y: u8; }\nuni U { a: A; b: B; }\nfun main() i32 { ret 0; }\n", need))                                   { bad = 1; }
    if (!ut_sema_rejects("rec A { x: ^u8; y: u8; }\nrec B { x: ^u32; y: u8; }\nfun f(p: *A) *B { ret p:~*B; }\nfun main() i32 { ret 0; }\n"))                                     { bad = 1; }
    if (!ut_sema_rejects_with("rec A { x: ^[1]u8; y: u8; }\nrec B { x: ^[4]u8; y: u8; }\nuni U { a: A; b: B; }\nfun main() i32 { ret 0; }\n", need))                              { bad = 1; }
    if (!ut_sema_rejects_with("rec S { v: ^u8; }\nrec T { v: ^u64; }\nrec A { x: S; y: u8; }\nrec B { x: T; y: u8; }\nuni U { a: A; b: B; }\nfun main() i32 { ret 0; }\n", need)) { bad = 1; }
    if (!ut_sema_rejects_with("rec A { x: ^f32; y: u8; }\nrec B { x: ^f64; y: u8; }\nuni U { a: A; b: B; }\nfun main() i32 { ret 0; }\n", need))                                  { bad = 1; }
    if (!ut_sema_rejects_with("rec A { x: ^[4]u8; y: u8; }\nrec B { x: ^u32; y: u8; }\nuni U { a: A; b: B; }\nfun main() i32 { ret 0; }\n", need))                                { bad = 1; }

    if (!ut_sema_clean("rec A { x: ^u32; }\nrec B { x: ^u32; y: u32; }\nuni U { a: A; b: B; }\nfun main() i32 { ret 0; }\n"))               { bad = 1; }
    if (!ut_sema_clean("rec A { x: ^u32; y: u8; }\nrec B { x: ^u32; y: u8; z: u64; }\nuni U { a: A; b: B; }\nfun main() i32 { ret 0; }\n")) { bad = 1; }
    if (!ut_sema_clean("rec A { x: ^u32; }\nrec B { x: ^u32; y: u32; }\nfun f(p: *A) *B { ret p:~*B; }\nfun main() i32 { ret 0; }\n"))      { bad = 1; }

    if (!ut_sema_rejects_with("rec A { x: ^u32; y: u32; }\nrec B { x: u32; y: ^u32; }\nuni U { a: A; b: B; }\nfun main() i32 { ret 0; }\n", need)) { bad = 1; }
    if (!ut_sema_rejects_with("rec A { x: u32; }\nrec B { x: ^u32; y: u32; }\nuni U { a: A; b: B; }\nfun main() i32 { ret 0; }\n", need))          { bad = 1; }
    if (!ut_sema_rejects("uni V { p: ^u32; }\nrec B { x: ^u32; y: u32; }\nfun f(p: *V) *B { ret p:~*B; }\nfun main() i32 { ret 0; }\n"))           { bad = 1; }
    if (!ut_sema_clean("rec A { x: ^u32; }\nrec B { x: ^u32; y: u32; }\nfun f(p: *A) *B { ret p:~*B; }\nfun main() i32 { ret 0; }\n"))             { bad = 1; }

    if (!ut_sema_clean("rec A { x: ^u8; }\nrec B { x: ^u32; y: ^u32; }\nuni U { a: A; b: B; }\nfun main() i32 { ret 0; }\n")) { bad = 1; }
    if (!ut_sema_clean("rec A { x: u8; }\nrec B { x: u32; y: u32; }\nuni U { a: A; b: B; }\nfun main() i32 { ret 0; }\n"))    { bad = 1; }
    ret bad;
}

test layout__sema_extent_matches_lowering {
    var bad: i32 = 0;

    if (ut_sema_extent_is("rec R { a: u8; }\nfun main() i32 { ret 0; }\n", "R", 1, 1) != 0)                                  { bad = 1; }
    if (ut_sema_extent_is("rec R { a: u8; b: u32; }\nfun main() i32 { ret 0; }\n", "R", 8, 4) != 0)                          { bad = 1; }
    if (ut_sema_extent_is("rec R { a: u32; b: u8; }\nfun main() i32 { ret 0; }\n", "R", 8, 4) != 0)                          { bad = 1; }
    if (ut_sema_extent_is("rec R { a: u8; b: u64; }\nfun main() i32 { ret 0; }\n", "R", 16, 8) != 0)                         { bad = 1; }
    if (ut_sema_extent_is("rec I { a: u8; b: u32; }\nrec R { x: I; y: u8; }\nfun main() i32 { ret 0; }\n", "R", 12, 4) != 0) { bad = 1; }
    if (ut_sema_extent_is("rec R { a: [3]u16; b: u8; }\nfun main() i32 { ret 0; }\n", "R", 8, 2) != 0)                       { bad = 1; }
    if (ut_sema_extent_is("uni U { a: u8; b: u32; }\nfun main() i32 { ret 0; }\n", "U", 4, 4) != 0)                          { bad = 1; }
    if (ut_sema_extent_is("rec R { a: *u8; b: u8; }\nfun main() i32 { ret 0; }\n", "R", 16, 8) != 0)                         { bad = 1; }
    if (ut_sema_extent_is("#[align(16)]\nrec R { a: u32; }\nfun main() i32 { ret 0; }\n", "R", 16, 16) != 0)                 { bad = 1; }
    if (ut_sema_extent_is("rec R { a: ^u8; b: ^u32; }\nfun main() i32 { ret 0; }\n", "R", 8, 4) != 0)                        { bad = 1; }

    if (ut_sema_extent_is("uni G[T] { a: T; b: u8; }\nfun f(g: G[u64]) i32 { ret 0; }\nfun main() i32 { ret 0; }\n", "G", 8, 8) != 0)  { bad = 1; }
    if (ut_sema_extent_is("uni G[T] { a: T; b: T; }\nfun f(g: G[u32]) i32 { ret 0; }\nfun main() i32 { ret 0; }\n", "G", 4, 4) != 0)   { bad = 1; }
    if (ut_sema_extent_is("rec P[T] { a: T; b: u8; }\nfun f(p: P[u64]) i32 { ret 0; }\nfun main() i32 { ret 0; }\n", "P", 16, 8) != 0) { bad = 1; }

    val probe: str = "rec R1 { a: u8; }\nrec R2 { a: u8; b: u32; }\nrec R3 { a: u32; b: u8; }\nrec R4 { a: u8; b: u64; }\nrec I  { a: u8; b: u32; }\nrec R5 { x: I; y: u8; }\nrec R6 { a: [3]u16; b: u8; }\nuni U1 { a: u8; b: u32; }\nrec R7 { a: *u8; b: u8; }\n#[align(16)]\nrec R8 { a: u32; }\nrec R9 { a: ^u8; b: ^u32; }\nuni G1[T] { a: T; b: u8; }\nrec P1[T] { a: T; b: u8; }\n#[symbol(\"layout_probe\")]\nfun layout_probe(r1: R1, r2: R2, r3: R3, r4: R4, r5: R5, r6: R6, u1: U1, r7: R7, r8: R8, r9: R9, g64: G1[u64], g32: G1[u32], p64: P1[u64]) { }\nfun main() i32 { ret 0; }\n";

    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:     session.Session = sr.ok;
    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = probe;
    val pr: res[project.Project, outcome.Fail] = ut_build(?s, ?alloc, ?names[0], ?texts[0], 1);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p:                project.Project   = pr.ok;
    val run_sema_pass_r:  err[outcome.Fail] = driver.run_sema_pass(?p);
    val run_lower_pass_r: err[outcome.Fail] = driver.run_lower_pass(?p);
    if (sel run_sema_pass_r.err) {
        project.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }
    if (sel run_lower_pass_r.err) {
        project.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }
    val mid: session.ModuleId = ut_mid(?p, ?s, "uniontest.main");
    if (mid == session.MODULE_NIL || project.module_at(?p, mid::u32).ir_module == nil) { bad = 1; }
    or {
        val m: *ir.Module = project.module_at(?p, mid::u32).ir_module;
        if (!ut_ir_param_extent_is(?s, m, ?p.target, "layout_probe", 0, 1, 1))   { bad = 1; }
        if (!ut_ir_param_extent_is(?s, m, ?p.target, "layout_probe", 1, 8, 4))   { bad = 1; }
        if (!ut_ir_param_extent_is(?s, m, ?p.target, "layout_probe", 2, 8, 4))   { bad = 1; }
        if (!ut_ir_param_extent_is(?s, m, ?p.target, "layout_probe", 3, 16, 8))  { bad = 1; }
        if (!ut_ir_param_extent_is(?s, m, ?p.target, "layout_probe", 4, 12, 4))  { bad = 1; }
        if (!ut_ir_param_extent_is(?s, m, ?p.target, "layout_probe", 5, 8, 2))   { bad = 1; }
        if (!ut_ir_param_extent_is(?s, m, ?p.target, "layout_probe", 6, 4, 4))   { bad = 1; }
        if (!ut_ir_param_extent_is(?s, m, ?p.target, "layout_probe", 7, 16, 8))  { bad = 1; }
        if (!ut_ir_param_extent_is(?s, m, ?p.target, "layout_probe", 8, 16, 16)) { bad = 1; }
        if (!ut_ir_param_extent_is(?s, m, ?p.target, "layout_probe", 9, 8, 4))   { bad = 1; }
        if (!ut_ir_param_extent_is(?s, m, ?p.target, "layout_probe", 10, 8, 8))  { bad = 1; }
        if (!ut_ir_param_extent_is(?s, m, ?p.target, "layout_probe", 11, 4, 4))  { bad = 1; }
        if (!ut_ir_param_extent_is(?s, m, ?p.target, "layout_probe", 12, 16, 8)) { bad = 1; }
    }
    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

test secret_literal__stays_public {
    var bad: i32 = 0;

    if (!ut_sema_clean("fun f() i32 { var s: ^u32 = 5; ret 0; }\nfun main() i32 { ret 0; }\n"))                      { bad = 1; }
    if (!ut_sema_clean("fun g(s: ^u32) ^u32 { ret s; }\nfun f() i32 { g(5); ret 0; }\nfun main() i32 { ret 0; }\n")) { bad = 1; }
    if (!ut_sema_rejects("fun f() i32 { var s: ^u8 = 300; ret 0; }\nfun main() i32 { ret 0; }\n"))                   { bad = 1; }

    if (!ut_sema_rejects("fun f(v: ^u8) u8 { ret v + 3; }\nfun main() i32 { ret 0; }\n"))                { bad = 1; }
    if (!ut_sema_rejects("fun f(v: ^u8) u8 { ret v << 3; }\nfun main() i32 { ret 0; }\n"))               { bad = 1; }
    if (!ut_sema_rejects("fun f(v: ^u8) u8 { var x: u8 = v & 3; ret x; }\nfun main() i32 { ret 0; }\n")) { bad = 1; }
    if (!ut_sema_rejects_with("fun f(v: ^u8) u8 { if (v << 3) { ret 1; } ret 0; }\nfun main() i32 { ret 0; }\n",
        "secret value used as a branch condition")) { bad = 1; }
    if (!ut_sema_rejects_with("fun f(v: ^u8, t: *u8) u8 { ret t[v << 3]; }\nfun main() i32 { ret 0; }\n",
        "secret value used as a memory index")) { bad = 1; }
    if (!ut_sema_clean("fun f(v: ^u8) u8 { ret (v << 3):>u8; }\nfun main() i32 { ret 0; }\n")) { bad = 1; }
    ret bad;
}

# no conversion adds or drops the qualifier: a cast, a reinterpret, a secret float
# conversion, and a pointer to secret storage erased or stored through a public pointer
test secret_conversion__refuses_laundering {
    var bad: i32 = 0;
    if (!ut_sema_rejects("fun f(a: ^u32) u32 { ret a::u32; }\nfun main() i32 { ret 0; }\n"))                  { bad = 1; }
    if (!ut_sema_rejects("fun f(a: u32) i32 { var s: ^u32 = a::^u32; ret 0; }\nfun main() i32 { ret 0; }\n")) { bad = 2; }
    if (!ut_sema_rejects("fun f(a: ^u32) u32 { ret a:~u32; }\nfun main() i32 { ret 0; }\n"))                  { bad = 3; }
    if (!ut_sema_clean("fun f(a: ^u32) ^u64 { ret a::^u64; }\nfun main() i32 { ret 0; }\n"))                  { bad = 4; }
    if (!ut_sema_rejects("fun f(a: ^f64) ^i64 { ret a::^i64; }\nfun main() i32 { ret 0; }\n"))                { bad = 5; }
    if (!ut_sema_rejects("fun f(a: ^f32) ^f64 { ret a::^f64; }\nfun main() i32 { ret 0; }\n"))                { bad = 6; }
    if (!ut_sema_rejects("fun f(a: ^i64) ^f64 { ret a::^f64; }\nfun main() i32 { ret 0; }\n"))                { bad = 7; }
    if (!ut_sema_clean("fun f(a: f64) i64 { ret a::i64; }\nfun main() i32 { ret 0; }\n"))                     { bad = 8; }
    if (!ut_sema_rejects("fun f(p: *^u8) ptr { ret p:~ptr; }\nfun main() i32 { ret 0; }\n"))                  { bad = 9; }
    if (!ut_sema_rejects("fun f(p: *u8, s: ^u8) { @p = s; }\nfun main() i32 { ret 0; }\n"))                   { bad = 10; }
    if (!ut_sema_clean("fun f(p: *u8) ptr { ret p; }\nfun main() i32 { ret 0; }\n"))                          { bad = 11; }
    ret bad;
}

test secret_container__field_reads_stay_secret {
    var bad: i32 = 0;

    if (!ut_lower_clean("rec R { x: u8; y: u8; }\nfun f(r: ^R) ^u8 { ret r.x; }\nfun main() i32 { ret 0; }\n"))                                      { bad = 1; }
    if (!ut_lower_clean("rec R { x: u8; y: u8; }\nfun f(q: *^R) ^u8 { ret q.x; }\nfun main() i32 { ret 0; }\n"))                                     { bad = 1; }
    if (!ut_lower_clean("rec R { x: u8; y: u8; }\nfun f(r: ^R) ^u8 { ret r.y; }\nfun main() i32 { ret 0; }\n"))                                      { bad = 1; }
    if (!ut_lower_clean("rec R { x: u8; y: u8; }\nrec O { r: R; }\nfun f(o: ^O) ^u8 { ret o.r.x; }\nfun main() i32 { ret 0; }\n"))                   { bad = 1; }
    if (!ut_lower_clean("rec R { x: u8; y: u8; }\ndef S: ^R;\nval N: u64 = $offset_of(S, y);\nfun f() u64 { ret N; }\nfun main() i32 { ret 0; }\n")) { bad = 1; }
    if (!ut_lower_clean("rec K { d: ^[4]u8; }\nfun f(k: *K) ^u8 { ret k.d[2]; }\nfun main() i32 { ret 0; }\n"))                                      { bad = 1; }

    if (!ut_sema_rejects_with("rec R { x: u8; y: u8; }\nfun f(r: ^R) u8 { ret r.x; }\nfun main() i32 { ret 0; }\n",
        "expected u8, found ^u8")) { bad = 1; }
    if (!ut_sema_rejects_with("rec R { x: u8; y: u8; }\nfun f(r: ^R) u8 { if (r.x == 1) { ret 1; } ret 0; }\nfun main() i32 { ret 0; }\n",
        "secret value used as a branch condition")) { bad = 1; }
    if (!ut_sema_rejects_with("rec R { x: u8; y: u8; }\nfun f(r: ^R, a: *u8) u8 { ret a[r.x]; }\nfun main() i32 { ret 0; }\n",
        "secret value used as a memory index")) { bad = 1; }
    ret bad;
}

