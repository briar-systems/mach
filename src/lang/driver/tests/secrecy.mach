    ret bad;
}

test secret_union__generic_instance_refused {
    var bad: i32 = 0;

    if (ut_sema_errs("uni U[T] { a: T; b: u32; }\nfun f() u32 { var u: U[^u32]; u.a = 5; ret u.b; }\nfun main() i32 { ret 0; }\n") != 1)                                                                                                         { bad = 1; }
    if (ut_sema_errs("uni U[T] { a: T; b: u32; }\nrec Box[T] { u: U[T]; }\nfun f() u32 { var b: Box[^u32]; ret b.u.b; }\nfun main() i32 { ret 0; }\n") != 1)                                                                                     { bad = 1; }
    if (ut_sema_errs("uni U[T] { a: T; b: u32; }\nrec Box[T] { f: fun(*U[T]) u32; }\nfun g() i32 { var b: Box[^u32]; b.f = nil; ret 0; }\nfun main() i32 { ret 0; }\n") != 1)                                                                    { bad = 1; }
    if (ut_sema_errs("rec Loc[T, E] { v: uni { a: T; b: E; }; }\nfun f() u32 { var l: Loc[^u32, u32]; ret l.v.b; }\nfun main() i32 { ret 0; }\n") != 1)                                                                                          { bad = 1; }
    if (ut_sema_errs("uni U[T] { a: T; b: u32; }\nfun sink[T](n: u32) u32 { var u: U[T]; u.b = n; ret u.b; }\nfun main() i32 { ret sink[^u32](1)::i32; }\n") != 1)                                                                               { bad = 1; }
    if (ut_sema_errs("fun sink[T](n: u32) u32 { var v: uni { a: T; b: u32; }; v.b = n; ret v.b; }\nfun main() i32 { ret sink[^u32](1)::i32; }\n") != 1)                                                                                          { bad = 1; }
    if (ut_sema_errs("uni U2[A, B] { a: A; b: B; }\nfun sink[T](n: u32) u32 { var u: U2[T, ^u32]; u.b = 0; ret n; }\nfun main() i32 { ret sink[u32](1)::i32; }\n") != 1)                                                                         { bad = 1; }
    if (ut_sema_errs("uni U[T] { a: T; b: u32; }\nfun mk[T]() U[T] { var r: U[T]; r.b = 0; ret r; }\nfun main() i32 { ret mk[^u32]().b::i32; }\n") != 1)                                                                                         { bad = 1; }
    if (ut_sema_errs("uni U[T] { a: T; b: u32; }\nfun take[T](p: *U[T]) u32 { ret 1; }\nfun main() i32 { ret take[^u32](nil)::i32; }\n") != 1)                                                                                                   { bad = 1; }
    if (ut_sema_errs("uni U[T] { a: T; b: u32; }\ndef L: U[^u32];\nfun f() u32 { var u: L; var v: L; u.b = 0; ret v.b; }\nfun main() i32 { ret 0; }\n") != 1)                                                                                    { bad = 1; }
    if (ut_sema_errs("uni U[T] { a: T; b: u32; }\nrec Node[T] { next: *Node[T]; u: U[T]; }\nfun f() i32 { var n: Node[^u32]; n.next = nil; ret 0; }\nfun main() i32 { ret 0; }\n") != 1)                                                         { bad = 1; }
    if (ut_sema_errs("rec Hold[X] { x: X; }\nrec Outer[T] { h: Hold[uni { a: T; b: u32; }]; }\nfun f() i32 { var o: Outer[^u32]; o.h.x.b = 0; ret 0; }\nfun main() i32 { ret 0; }\n") != 1)                                                      { bad = 1; }
    if (ut_sema_errs("uni U[T] { a: T; b: u32; }\nrec Box[T] { u: U[T]; }\nrec Loc[T, E] { v: uni { a: T; b: E; }; }\nfun f() i32 { var b: Box[^u32]; var l: Loc[^u32, u32]; b.u.b = 0; l.v.b = 0; ret 0; }\nfun main() i32 { ret 0; }\n") != 2) { bad = 1; }
    if (ut_vec_diag("uni U[T] { a: T; b: u32; }\nfun f() u32 { var u: U[^u32]; ret u.b; }\nfun main() i32 { ret 0; }\n", "this instantiation makes overlapping fields") != 0)                                                                    { bad = 1; }
    if (ut_sema_errs("uni N { a: ^u32; b: u32; }\nfun f() u32 { var n: N; ret n.b; }\nfun main() i32 { ret 0; }\n") != 1)                                                                                                                        { bad = 1; }
    if (ut_sema_errs("fun f() u32 { var v: uni { a: ^u32; b: u32; }; ret v.b; }\nfun main() i32 { ret 0; }\n") != 1)                                                                                                                             { bad = 1; }
    if (ut_sema_errs("uni U[T] { a: T; b: u32; }\nrec P[T] { x: U[u32]; y: U[T]; }\nfun f() i32 { var p: P[^u32]; p.y.b = 0; ret 0; }\nfun main() i32 { ret 0; }\n") != 1)                                                                       { bad = 1; }
    ret bad;
}

test secret_union__generic_instance_accepted {
    var bad: i32 = 0;

    if (!ut_sema_clean("uni U[T] { a: T; b: u32; }\nfun f() u32 { var u: U[u32]; ret u.b; }\nfun main() i32 { ret 0; }\n"))                                                                                                            { bad = 1; }
    if (!ut_sema_clean("uni U2[A, B] { a: A; b: B; }\nfun f() i32 { var u: U2[^u32, ^u32]; u.a = 0; ret 0; }\nfun main() i32 { ret 0; }\n"))                                                                                           { bad = 1; }
    if (!ut_sema_clean("uni Us[T] { a: T; b: T; }\nrec W[T] { u: Us[T]; }\nfun f() i32 { var p: W[u32]; var s: W[^u32]; p.u.a = 0; s.u.a = 0; ret 0; }\nfun main() i32 { ret 0; }\n"))                                                 { bad = 1; }
    if (!ut_sema_clean("uni U2[A, B] { a: A; b: B; }\nrec Outer[T] { u: U2[T, ^u32]; }\nfun f() i32 { var o: Outer[^u32]; o.u.a = 0; ret 0; }\nfun main() i32 { ret 0; }\n"))                                                          { bad = 1; }
    if (ut_sema_errs("uni U2[A, B] { a: A; b: B; }\nrec Outer[T] { u: U2[T, ^u32]; }\nfun f() i32 { var o: Outer[u32]; o.u.b = 0; ret 0; }\nfun main() i32 { ret 0; }\n") != 1)                                                        { bad = 1; }
    if (!ut_sema_clean("uni U2[A, B] { a: A; b: B; }\nrec Outer[T] { u: U2[T, ^u32]; }\nfun f() i32 { ret 0; }\nfun main() i32 { ret 0; }\n"))                                                                                         { bad = 1; }
    if (!ut_sema_clean("rec Ctx[T] { key: T; id: u32; }\nrec N[T] { c: Ctx[T]; f: fun(*Ctx[T]) u32; }\nfun f() i32 { var n: N[^u32]; n.f = nil; ret 0; }\nfun main() i32 { ret 0; }\n"))                                               { bad = 1; }
    if (!ut_sema_clean("uni U[T] { a: T; b: u32; }\nfun f() i32 { var s: ^u32; s = 1; $if ($mach.build.os != $mach.build.os) { var b1: U[^u32]; b1.b = 0; } $or { var ok: U[u32]; ok.b = 0; } ret 0; }\nfun main() i32 { ret 0; }\n")) { bad = 1; }
    if (!ut_sema_clean("uni U[T] { a: T; b: u32; }\nrec Node[T] { next: *Node[T]; u: U[T]; }\nfun f() i32 { var s: ^u32; s = 1; var n: Node[u32]; n.next = nil; ret 0; }\nfun main() i32 { ret 0; }\n"))                               { bad = 1; }
    ret bad;
}

test secret_float__refused {
    var bad: i32 = 0;
    if (!ut_sema_rejects("fun f(a: ^f64, b: ^f64) ^f64 { ret a + b; }\nfun main() i32 { ret 0; }\n"))                                    { bad = 1; }
    if (!ut_sema_rejects("fun f(a: ^f64, b: ^f64) ^f64 { ret a * b; }\nfun main() i32 { ret 0; }\n"))                                    { bad = 1; }
    if (!ut_sema_rejects("fun f(a: ^f32, b: ^f32) ^u8 { ret a < b; }\nfun main() i32 { ret 0; }\n"))                                     { bad = 1; }
    if (!ut_sema_clean("fun f(a: f64, b: f64) f64 { ret a + b; }\nfun main() i32 { ret 0; }\n"))                                         { bad = 1; }
    if (!ut_sema_clean("fun f(a: f32, b: f32) u8 { ret a < b; }\nfun main() i32 { ret 0; }\n"))                                          { bad = 1; }
    if (ut_vec_diag("fun f(a: ^f64, b: ^f64) ^f64 { ret a * b; }\nfun main() i32 { ret 0; }\n", "variable-latency floating-point") != 0) { bad = 1; }
    if (!ut_sema_rejects("fun f(a: ^f32x4, b: ^f32x4) ^f32x4 { ret a / b; }\nfun main() i32 { ret 0; }\n"))                              { bad = 1; }
    if (!ut_sema_rejects("fun f(a: ^f64x2, b: ^f64x2) ^f64x2 { ret a * b; }\nfun main() i32 { ret 0; }\n"))                              { bad = 1; }
    if (!ut_sema_clean("fun f(a: f32x4, b: f32x4) f32x4 { ret a / b; }\nfun main() i32 { ret 0; }\n"))                                   { bad = 1; }
    ret bad;
}

test oblivious__decorator_applies_to_functions_only {
    var bad: i32 = 0;
    if (!ut_sema_clean("#[oblivious]\nfun f(a: ^u32) ^u32 { ret a + a; }\nfun main() i32 { ret 0; }\n"))               { bad = 1; }
    if (!ut_sema_clean("#[oblivious]\nfun f() i32 { ret 0; }\nfun main() i32 { ret 0; }\n"))                           { bad = 1; }
    if (!ut_sema_rejects("#[oblivious(1)]\nfun f() i32 { ret 0; }\nfun main() i32 { ret 0; }\n"))                      { bad = 1; }
    if (ut_vec_diag("#[oblivious]\nrec R { x: u32; }\nfun main() i32 { ret 0; }\n", "applies only to functions") != 0) { bad = 1; }
    ret bad;
}

# the DIT refusal is a diagnostic on the store like any other backend
# refusal: the pass answers `reported` with no text of its own, and the store
# holds exactly one error located at the multiply (main.mach:3:9) that names
# the instruction set's DIT rows and the operating system (#3508)
test secret_mul__dit_refusal_is_a_located_error {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "#[oblivious]\nfun f(a: ^u32, b: ^u32) ^u32 {\n    ret a * b;\n}\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { f(1, 2); ret 0; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str               = root_r.ok;
    val rr:   err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var tsel: manifest.Selection                 = ut_target_sel("bare-arm64");
    val pr:   res[project.Project, outcome.Fail] = driver.build_project(?s, root, ?tsel);
    fs.remove_all(?alloc, root);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    var bad: i32               = 0;
    val se:  err[outcome.Fail] = driver.run_sema_pass(?p);
    if (sel se.err) { bad = 2; }
    val le: err[outcome.Fail] = driver.run_lower_pass(?p);
    if (sel le.err && bad == 0) { bad = 3; }
    val ce: err[outcome.Fail] = driver.run_codegen_pass(?p);
    if (sel ce.ok) { bad = 4; }
    if (sel ce.err) {
        if (bad == 0) { bad = ut_dit_rejection_shape(?s, ce.err); }
    }

    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

#[testing]
fun ut_dit_rejection_shape(s: *session.Session, failure: outcome.Fail) i32 {
    if (!outcome.is_reported(failure)) { ret 5; }
    val carried: opt[str] = outcome.text(failure);
    if (sel carried.some)                      { ret 6; }
    if (diagnostic.error_count(?s.diags) != 1) { ret 7; }
    val d: opt[*diagnostic.Diagnostic] = diagnostic.get(?s.diags, 0);
    if (sel d.none) { ret 8; }
    val found: *diagnostic.Diagnostic = d.some;
    if (found.severity != diagnostic.SEVERITY_ERROR)                                                                { ret 9; }
    if (!ut_str_contains(found.message, "integer multiply whose timing is data-independent only under PSTATE.DIT")) { ret 10; }
    if (!ut_str_contains(found.message, "`aarch64` instruction set declares the multiply under that mode"))         { ret 11; }
    if (!ut_str_contains(found.message, "`freestanding` operating system declares no guarantee"))                   { ret 12; }
    if (found.loc.file_id == src.FILE_NIL)                                                                          { ret 13; }
    if (!ut_diag_located_at(s, "PSTATE.DIT", "main.mach", 3, 9))                                                    { ret 14; }
    ret 0;
}

test declassify__lowers_on_spirv_and_rv32 {
    var bad:    i32          = 0;
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    val ps: res[project.Project, outcome.Fail] = ut_ct_edge_project(?s, ?alloc,
        "fun down(a: ^u32) u32 { ret a:>u32; }\nfun main() i32 { ret 0; }\n", "spv");
    if (sel ps.err) { bad = 1; }
    if (sel ps.ok) {
        var p: project.Project = ps.ok;
        if (ut_run_codegen_ok(?p) != 0) { bad = 1; }
        project.dnit_project(?p);
    }

    val pm: res[project.Project, outcome.Fail] = ut_ct_edge_project(?s, ?alloc,
        "fun down(a: ^u32) u32 { ret a:>u32; }\nfun main() i32 { ret 0; }\n", "rv32s");
    if (sel pm.err) { bad = 1; }
    if (sel pm.ok) {
        var p2: project.Project = pm.ok;
        if (ut_run_codegen_ok(?p2) != 0) { bad = 1; }
        project.dnit_project(?p2);
    }

    session.dnit(?s);
    ret bad;
}

#[testing]
fun ut_count_op(p: *project.Project, kind: instruction.InstrKind) u32 {
    var n:  u32 = 0;
    var ti: u32 = 0;
    for (ti < p.topo_len) {
        val m: *ir.Module = project.module_at(p, p.topo[ti]::u32).ir_module;
        if (m != nil) {
            var fi: u32 = 0;
            for (fi < m.function_len) {
                val fn: *ir.Function = ?m.functions[fi];
                var bi: u32          = 0;
                for (bi < fn.block_count) {
                    val blk: *ir.Block = ?fn.blocks[bi];
                    var ix:  u32       = 0;
                    for (ix < blk.instr_count) {
                        if ((?fn.instrs[blk.instructions[ix]]).kind == kind) { n = n + 1; }
                        ix = ix + 1;
                    }
                    bi = bi + 1;
                }
                fi = fi + 1;
            }
        }
        ti = ti + 1;
    }
    ret n;
}

# a declassify lowers to a barrier, and the value past it is public: its multiply is an
# ordinary one, while the same multiply of the secret is still refused
test declassify__emits_a_barrier_that_is_not_retainted {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:  session.Session                    = sr.ok;
    val pr: res[project.Project, outcome.Fail] = ut_vec_lower(?s, ?alloc,
        "fun f(a: ^u32) u32 { ret a:>u32; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { f(1); ret 0; }\n", "linux");
    if (sel pr.err) {
        session.dnit(?s);
        ret 2;
    }
    var p: project.Project = pr.ok;
    val n: u32             = ut_count_op(?p, instruction.OP_DECLASSIFY);
    project.dnit_project(?p);
    session.dnit(?s);
    if (n == 0) { ret 3; }
    if (ut_vec_codegen_defined("fun f(a: ^u32) u32 { var x: ^u32 = a; ret (x:>u32) * (x:>u32); }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "declassified integer multiply", CODEGEN_CASE_DECLASSIFIED_MUL) != 0) { ret 4; }
    if (ut_codegen_target_rejects("#[oblivious]\nfun f(a: ^u32) ^u32 { var x: ^u32 = a; ret x * x; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "bare-arm64", "data-independent only under PSTATE.DIT") != 0) { ret 5; }
    ret 0;
}

# a secret vector multiply is gated where riscv64 scalarizes it and where x86_64 and
# aarch64 fuse a widening one; the public forms build
test secret_vector_mul__gated_when_scalarized_or_widened {
    val secret: str = "#[oblivious]\nfun f(a: ^i16x4, b: ^i16x4) ^i32x4 { ret a::^i32x4 * b::^i32x4; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n";
    val public: str = "fun f(a: i16x4, b: i16x4) i32x4 { ret a::i32x4 * b::i32x4; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n";
    if (ut_codegen_target_rejects("#[oblivious]\nfun f(a: ^i16x8, b: ^i16x8) ^i16x8 { ret a * b; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "linux-riscv64", "variable-latency integer multiply") != 0) { ret 1; }
    if (ut_codegen_target_rejects("fun f(a: i16x8, b: i16x8) i16x8 { ret a * b; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "linux-riscv64", "variable-latency integer multiply") == 0) { ret 2; }
    if (ut_codegen_target_ok("fun f(a: ^f32x4) f32x4 { ret a:>f32x4; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "linux-riscv64") != 0) { ret 3; }
    if (ut_codegen_target_rejects(secret, "linux", "variable-latency integer multiply") != 0)       { ret 4; }
    if (ut_codegen_target_rejects(secret, "linux-arm64", "variable-latency integer multiply") != 0) { ret 5; }
    if (ut_codegen_target_ok(public, "linux") != 0)                                                 { ret 6; }
    if (ut_codegen_target_ok(public, "linux-arm64") != 0)                                           { ret 7; }
    ret 0;
}

test secret_local__is_zeroized {
    var bad: i32 = 0;
    if (!ut_sema_clean("fun f() i32 { var k: ^[4]u8; ret 0; }\nfun main() i32 { ret 0; }\n")) { bad = 1; }
    if (ut_vec_codegen_defined("fun f() { var k: ^[4]u8; var s: ^u32; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { f(); ret 0; }\n",
        "secret local zeroization", CODEGEN_CASE_MEMZERO) != 0) { bad = 1; }
    ret bad;
}

test oblivious__required_for_secret_arithmetic {
    var bad: i32 = 0;

    if (ut_lower_rejects("fun f(a: ^u32, b: ^u32) ^u32 { ret a + b; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { f(1, 2); ret 0; }\n",
        "not declared `#[oblivious]`") != 0) { bad = 1; }
    if (ut_lower_rejects("fun secret_add(a: ^u32, b: ^u32) ^u32 { ret a + b; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { secret_add(1, 2); ret 0; }\n",
        "`secret_add` performs a constant-time arithmetic operation") != 0) { bad = 1; }
    if (ut_lower_rejects("fun pick(m: ^u32, a: ^u32, b: ^u32) ^u32 { ret (a & m) | (b & ~m); }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { pick(1, 2, 3); ret 0; }\n",
        "bitwise operation") != 0) { bad = 1; }
    if (ut_lower_rejects("fun eq(a: ^u32, b: ^u32) ^u8 { ret a == b; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { eq(1, 2); ret 0; }\n",
        "comparison") != 0) { bad = 1; }

    if (ut_lower_ok("#[oblivious]\nfun f(a: ^u32, b: ^u32) ^u32 { ret a + b; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { f(1, 2); ret 0; }\n") != 0) { bad = 1; }

    if (ut_lower_ok("fun declassify(x: ^u32) u32 { ret x:>u32; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { declassify(1); ret 0; }\n") != 0)               { bad = 1; }
    if (ut_lower_ok("fun roundtrip(x: u32) u32 { val s: ^u32 = x; ret s:>u32; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { roundtrip(7); ret 0; }\n") != 0) { bad = 1; }
    if (ut_lower_ok("fun wipe() { var z: ^u32 = 9; z = 0; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { wipe(); ret 0; }\n") != 0)                           { bad = 1; }

    if (ut_lower_ok("fun copy[T](dst: *T, src: *T) { @dst = @src; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var a: ^u32 = 5; var b: ^u32 = 0; copy[^u32](?b, ?a); ret 0; }\n") != 0) { bad = 1; }

    if (ut_lower_ok("fun f(a: u32, b: u32) u32 { ret a * b + (a & b); }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { f(1, 2); ret 0; }\n") != 0) { bad = 1; }

    ret bad;
}

test reflection__projection_keeps_secrecy {
    var bad: i32 = 0;

    if (ut_vec_diag("rec P { x: ^u32; }\nfun leak[T](v: T) u32 { var acc: u32 = 0; $each f in $fields(T) { acc = v.[f]; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var p: P; leak[P](p); ret 0; }\n",
        "expected u32, found ^u32") != 0) { bad = 1; }

    if (!ut_sema_rejects("rec I { s: ^u32; }\nrec O { i: I; }\nfun leak[T](v: T) u32 { var acc: u32 = 0; $each f in $fields(T) { acc = v.[f].s; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var o: O; leak[O](o); ret 0; }\n")) { bad = 1; }

    if (!ut_sema_rejects("uni U { s: ^u32; }\nrec P { u: U; }\nfun leak[T](v: T) u32 { var acc: u32 = 0; $each f in $fields(T) { acc = v.[f].s; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var p: P; leak[P](p); ret 0; }\n")) { bad = 1; }

    if (!ut_sema_rejects("rec P { a: [4]^u32; }\nfun leak[T](v: T) u32 { var acc: u32 = 0; $each f in $fields(T) { acc = v.[f][2]; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var p: P; leak[P](p); ret 0; }\n")) { bad = 1; }

    if (ut_vec_diag("rec Box[T] { v: T; }\nfun leak[T](b: T) u32 { var acc: u32 = 0; $each f in $fields(T) { acc = b.[f]; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var b: Box[^u32]; leak[Box[^u32]](b); ret 0; }\n",
        "expected u32, found ^u32") != 0) { bad = 1; }

    if (!ut_sema_rejects("rec P { x: ^u32; }\nfun leak[T](v: *T) u32 { var acc: u32 = 0; $each f in $fields(T) { acc = v.[f]; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var p: P; leak[P](?p); ret 0; }\n")) { bad = 1; }

    if (!ut_sema_rejects("rec P { x: ^u32; }\nfun leak[T](v: *T) u32 { var acc: u32 = 0; $each f in $fields(T) { val q: *u32 = ?v.[f]; acc = @q; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var p: P; leak[P](?p); ret 0; }\n")) { bad = 1; }

    val br: str = "rec P { x: ^u32; }\nfun leak[T](v: T) u32 { var acc: u32 = 0; $each f in $fields(T) { if (v.[f] == 7) { acc = 1; } } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var p: P; leak[P](p); ret 0; }\n";
    if (ut_vec_diag(br, "secret value used as a branch condition") != 0) { bad = 1; }
    val ix: str = "rec P { x: ^u32; }\nvar t: [8]u32;\nfun leak[T](v: T) u32 { var acc: u32 = 0; $each f in $fields(T) { acc = t[v.[f]]; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var p: P; leak[P](p); ret 0; }\n";
    if (ut_vec_diag(ix, "secret value used as a memory index") != 0) { bad = 1; }
    val dv: str = "rec P { x: ^u32; }\nfun leak[T](v: T) u32 { var acc: u32 = 0; $each f in $fields(T) { acc = 9 / v.[f]; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var p: P; leak[P](p); ret 0; }\n";
    if (ut_vec_diag(dv, "variable-latency") != 0) { bad = 1; }

    if (!ut_sema_rejects("rec P { x: ^u32; }\nfun leak[T](v: T) u32 { var acc: u32 = 0; $each f in $fields(T) { acc = v.[f]:~u32; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var p: P; leak[P](p); ret 0; }\n"))                               { bad = 1; }
    if (!ut_sema_rejects("rec P { x: ^u32; }\nfun leak[T](v: *T) u32 { var acc: u32 = 0; $each f in $fields(T) { val r: ptr = (?v.[f])::ptr; acc = @(r::*u32); } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var p: P; leak[P](?p); ret 0; }\n")) { bad = 1; }

    if (!ut_sema_rejects("rec P { x: ^u32; }\nfun sink(va: ...) u32 { ret 0; }\nfun leak[T](v: T) u32 { var acc: u32 = 0; $each f in $fields(T) { acc = sink(v.[f]); } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var p: P; leak[P](p); ret 0; }\n")) { bad = 1; }

    if (!ut_sema_rejects("rec P { x: u32; }\nfun leak[T](v: T) u32 { var acc: u32 = 0; $each f in $fields(T) { acc = v.[f]; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var p: ^P; leak[^P](p); ret 0; }\n")) { bad = 1; }

    if (!ut_sema_clean("rec P { x: u32; y: u32; }\nfun total[T](v: T) u32 { var acc: u32 = 0; $each f in $fields(T) { acc = acc + v.[f]; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var p: P; total[P](p); ret 0; }\n")) { bad = 1; }
    if (!ut_sema_clean("rec P { x: ^u32; }\nfun ok[T](v: T) u32 { var acc: u32 = 0; $each f in $fields(T) { acc = v.[f]:>u32; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var p: P; ok[P](p); ret 0; }\n"))               { bad = 1; }

    ret bad;
}

# a `*^T` is a public address to secret storage, so ordering two pointers is a
# comparison of public addresses whatever the pointee's secrecy. the result is
# `u8` (`bool` is the stdlib alias) and no address comes back out of it
test pointer_ordering__compiles_across_pointee_secrecy {
    var bad: i32 = 0;

    if (!ut_sema_clean("fun f(a: *^u8, b: *^u8) u8 { ret a < b; }\nfun main() i32 { ret 0; }\n"))  { bad = 1; }
    if (!ut_sema_clean("fun f(a: *^u8, b: *^u8) u8 { ret a >= b; }\nfun main() i32 { ret 0; }\n")) { bad = 4; }

    if (!ut_sema_clean("fun f(a: *^u8, b: *u8) u8 { ret a < b; }\nfun main() i32 { ret 0; }\n"))  { bad = 5; }
    if (!ut_sema_clean("fun f(a: *u8, b: *^u8) u8 { ret a >= b; }\nfun main() i32 { ret 0; }\n")) { bad = 6; }

    # a differing pointee type and `nil` order like any other address, the same
    # pairs `==` already accepts
    if (!ut_sema_clean("fun f(a: *^u8, b: *u32) u8 { ret a < b; }\nfun main() i32 { ret 0; }\n"))       { bad = 8; }
    if (!ut_sema_clean("fun f(a: *^u8) u8 { ret a > nil; }\nfun main() i32 { ret 0; }\n"))              { bad = 9; }
    if (!ut_sema_clean("fun f(a: *^[4]u8, b: *^[4]u8) u8 { ret a < b; }\nfun main() i32 { ret 0; }\n")) { bad = 10; }

    # the overlap check the downstream consumer writes (briar-systems/mach-tls#56)
    if (!ut_sema_clean("fun overlap(first: *^u8, first_len: u64, second: *^u8, second_len: u64) u8 {\n    ret first <= ?second[second_len - 1] && second <= ?first[first_len - 1];\n}\nfun main() i32 { ret 0; }\n")) { bad = 11; }

    # the result is public even where both pointees are secret: it feeds a
    # branch and a short-circuiting `&&`, neither of which admits a secret
    if (!ut_sema_clean("#[oblivious]\nfun f(a: *^u8, b: *^u8) u8 { if (a < b) { ret 1; } ret 0; }\nfun main() i32 { ret 0; }\n")) { bad = 12; }
    if (!ut_sema_clean("fun f(a: *^u8, b: *^u8, c: *^u8) u8 { ret (a < b) && (b < c); }\nfun main() i32 { ret 0; }\n"))           { bad = 13; }

    # a secret *pointer* is a secret value, so the order of two of them is
    # secret and still cannot steer control flow
    if (!ut_sema_rejects_with("fun f(a: ^*u8, b: ^*u8) u8 { if (a < b) { ret 1; } ret 0; }\nfun main() i32 { ret 0; }\n",
        "secret value used as a branch condition")) { bad = 14; }

    ret bad;
}

# widening the relational operators must open no route from a `*^T` to an
# integer, a `ptr` or a public pointer: a laundered address comes back as a
# `*T` and reads the secret storage (#1645, #2165)
test pointer_ordering__opens_no_secret_conversion {
    var bad: i32 = 0;

    if (!ut_sema_rejects_with("fun f(a: *^u8) u64 { ret a::u64; }\nfun main() i32 { ret 0; }\n",
        "cannot add or drop the secret qualifier")) { bad = 1; }
    if (!ut_sema_rejects_with("fun f(a: *^u8) u64 { ret a:~u64; }\nfun main() i32 { ret 0; }\n",
        "cannot add or drop the secret qualifier")) { bad = 2; }
    if (!ut_sema_rejects_with("fun f(a: *^u8) *u8 { ret a:>*u8; }\nfun main() i32 { ret 0; }\n",
        "a `:>T` target must name the operand's stripped (public) type")) { bad = 3; }
    if (!ut_sema_rejects_with("fun f(slot: *^u8) *u64 { ret @((?slot):~*u64); }\nfun main() i32 { ret 0; }\n",
        "cannot add or drop the secret qualifier")) { bad = 4; }
    if (!ut_sema_rejects_with("fun f(a: *^u8) i64 { val e: ptr = a; ret 0; }\nfun main() i32 { ret 0; }\n",
        "expected ptr, found *^u8")) { bad = 5; }

    # ordering relates two addresses and nothing else: an integer operand is
    # still a mismatch, so no address arrives in an integer through it
    if (!ut_sema_rejects_with("fun f(a: *^u8, n: u64) u8 { ret a < n; }\nfun main() i32 { ret 0; }\n",
        "incompatible operand types")) { bad = 6; }
    if (!ut_sema_rejects_with("fun f(a: *^u8) u8 { ret a < 0; }\nfun main() i32 { ret 0; }\n",
        "incompatible operand types")) { bad = 7; }

    # the result is a `u8`, not an address
    if (!ut_sema_rejects_with("fun f(a: *^u8, b: *^u8) *^u8 { ret a < b; }\nfun main() i32 { ret 0; }\n",
        "expected *^u8, found u8")) { bad = 8; }
    if (!ut_sema_rejects_with("fun f(a: *^u8, b: *^u8) i32 { ret a < b; }\nfun main() i32 { ret 0; }\n",
        "expected i32, found u8")) { bad = 9; }

    ret bad;
}

# an aggregate declassify is one barrier; a record, an array and a nested record lower, and a
# record and a record holding welded pointers build on every native backend
test declassify__aggregate_lowers_on_every_backend {
    val rec_new:  str = "rec K { d: [4]u8; }\nfun down(a: ^K) K { ret a:>K; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n";
    val arr_new:  str = "fun down(a: ^[4]u32) [4]u32 { ret a:>[4]u32; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n";
    val nest_new: str = "rec Inner { x: u32; y: u32; }\nrec Outer { a: [2]Inner; b: u8; }\nfun down(a: ^Outer) Outer { ret a:>Outer; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n";
    val mixed:    str = "rec Inner { x: u32; y: u32; }\nrec M { n: Inner; p: *u8; q: ^*u8; v: u64; }\nfun down(a: ^M) M { ret a:>M; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n";
    if (ut_lower_ok(arr_new) != 0)         { ret 1; }
    if (ut_lower_ok(nest_new) != 0)        { ret 2; }
    if (ut_count_declassify(rec_new) != 1) { ret 3; }
    var targets: [3]str = [3]str{"linux", "linux-arm64", "linux-riscv64"};
    var ti:      usize  = 0;
    for (ti < 3) {
        if (ut_codegen_target_ok(rec_new, targets[ti]) != 0) { ret 10 + ti::i32; }
        if (ut_codegen_target_ok(mixed, targets[ti]) != 0)   { ret 20 + ti::i32; }
        ti = ti + 1;
    }
    ret 0;
}

#[testing]
fun ut_count_declassify(src: str) u32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 0; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 0; }
    var s:  session.Session                    = sr.ok;
    val pr: res[project.Project, outcome.Fail] = ut_vec_lower(?s, ?alloc, src, "linux");
    if (sel pr.err) {
        session.dnit(?s);
        ret 0;
    }
    var p: project.Project = pr.ok;
    val n: u32             = ut_count_op(?p, instruction.OP_DECLASSIFY);
    project.dnit_project(?p);
    session.dnit(?s);
    ret n;
}

#[testing]
val UT_AGG_SEL_REC: u32 = 0;
#[testing]
val UT_AGG_SEL_ARR: u32 = 1;
#[testing]
val UT_AGG_SEL_MIX: u32 = 2;

#[testing]
fun ut_agg_strip_src(buf: *u8) usize {
    var w: usize = 0;
    w      = ut_app(buf, w, "rec K { a: u32; b: u32; }\n");
    w      = ut_app(buf, w, "rec Inner { x: u32; y: u32; }\n");
    w      = ut_app(buf, w, "rec M { n: Inner; p: *u8; q: ^*u8; v: u32; }\n");
    w      = ut_app(buf, w, "#[symbol(\"_start\")]\n");
    w      = ut_app(buf, w, "fun probe(pick: i32, v: i32) i32 {\n");
    w      = ut_app(buf, w, "    val v0: u32 = v::u32;\n");
    w      = ut_app(buf, w, "    val v1: u32 = (v + 1)::u32;\n");
    w      = ut_app(buf, w, "    val v2: u32 = (v + 2)::u32;\n");
    w      = ut_app(buf, w, "    val v3: u32 = (v + 3)::u32;\n");
    w      = ut_app(buf, w, "    var k: ^K;\n");
    w      = ut_app(buf, w, "    k.a = v0;\n");
    w      = ut_app(buf, w, "    k.b = v1;\n");
    w      = ut_app(buf, w, "    if (pick == 0) { ret sum_k(k)::i32; }\n");
    w      = ut_app(buf, w, "    var arr: ^[4]u32;\n");
    w      = ut_app(buf, w, "    arr[0] = v0; arr[1] = v1; arr[2] = v2; arr[3] = v3;\n");
    w      = ut_app(buf, w, "    if (pick == 1) { ret sum_arr(arr)::i32; }\n");
    w      = ut_app(buf, w, "    var b1: u8 = 7;\n");
    w      = ut_app(buf, w, "    var b2: u8 = 9;\n");
    w      = ut_app(buf, w, "    var m: ^M;\n");
    w      = ut_app(buf, w, "    m.n.x = v0;\n");
    w      = ut_app(buf, w, "    m.n.y = v1;\n");
    w      = ut_app(buf, w, "    m.p = ?b1;\n");
    w      = ut_app(buf, w, "    m.q = ?b2;\n");
    w      = ut_app(buf, w, "    m.v = 5;\n");
    w      = ut_app(buf, w, "    if (pick == 2) { ret sum_m(m)::i32; }\n");
    w      = ut_app(buf, w, "    ret 0 - 1;\n");
    w      = ut_app(buf, w, "}\n");
    w      = ut_app(buf, w, "fun sum_k(s: ^K) u32 { val p: K = s:>K; ret p.a + p.b; }\n");
    w      = ut_app(buf, w, "fun sum_arr(s: ^[4]u32) u32 { val p: [4]u32 = s:>[4]u32; ret p[0] + p[1] + p[2] + p[3]; }\n");
    w      = ut_app(buf, w, "fun sum_m(s: ^M) u32 {\n");
    w      = ut_app(buf, w, "    val p: M = s:>M;\n");
    w      = ut_app(buf, w, "    var acc: u32 = p.n.x + p.n.y + p.v;\n");
    w      = ut_app(buf, w, "    acc = acc + (@p.p)::u32;\n");
    w      = ut_app(buf, w, "    val qq: *u8 = p.q:>*u8;\n");
    w      = ut_app(buf, w, "    ret acc + (@qq)::u32 * 10;\n");
    w      = ut_app(buf, w, "}\n");
    buf[w] = 0;
    ret w;
}

#[testing]
fun ut_agg_strip_run(mem: *u8, pick: u32, v: u32, out: *u32) bool {
    var args: [2]u32;
    args[0] = pick;
    args[1] = v;
    var lo:    u32 = 0;
    var hi:    u32 = 0;
    var steps: u32 = 0;
    if (!ut_rv32_run(mem, 0, ?args[0], 2, ?lo, ?hi, ?steps)) { ret false; }
    @out = lo;
    ret true;
}

test declassify__aggregate_executes_on_an_rv32_core {
    var bad:    i32          = 0;
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    val bufr: res[*u8, A.Error] = A.allocate[u8](?alloc, 8192);
    if (sel bufr.err) {
        session.dnit(?s);
        ret 1;
    }
    val srcbuf: *u8 = bufr.ok;
    ut_agg_strip_src(srcbuf);

    val memr: res[*u8, A.Error] = A.zallocate[u8](?alloc, UT_RV32_MEM);
    if (sel memr.err) {
        A.deallocate[u8](?alloc, srcbuf, 8192);
        session.dnit(?s);
        ret 1;
    }
    val mem: *u8 = memr.ok;

    var ilen: u32 = 0;
    if (!ut_rv32_build_linked(?s, ?alloc, srcbuf::str, "rv32", mem, ?ilen)) { bad = 1; }
    or {
        var got: u32 = 0;
        if (!ut_agg_strip_run(mem, UT_AGG_SEL_REC, 100, ?got)) { bad = bad + 2; }
        or (got != 201)                                        { bad = bad + 2; }
        if (!ut_agg_strip_run(mem, UT_AGG_SEL_ARR, 100, ?got)) { bad = bad + 8; }
        or (got != 406)                                        { bad = bad + 8; }
        if (!ut_agg_strip_run(mem, UT_AGG_SEL_MIX, 100, ?got)) { bad = bad + 16; }
        or (got != 303)                                        { bad = bad + 16; }
    }

    A.deallocate[u8](?alloc, mem, UT_RV32_MEM);
    A.deallocate[u8](?alloc, srcbuf, 8192);
    session.dnit(?s);
    ret bad;
}

test declassify__aggregate_leaves_welded_fields_secret {
    var bad: i32 = 0;

    val welded: str = "rec M { p: *u8; q: ^*u8; }\nfun f(a: ^M) u8 { val p: M = a:>M; ret @p.q; }\nfun main() i32 { ret 0; }\n";
    if (!ut_sema_rejects(welded)) { bad = bad + 1; }

    val plain: str = "rec M { p: *u8; q: ^*u8; }\nfun f(a: ^M) u8 { val p: M = a:>M; ret @p.p; }\nfun main() i32 { ret 0; }\n";
    if (!ut_sema_clean(plain)) { bad = bad + 2; }

    val unstripped: str = "rec M { p: *u8; q: ^*u8; }\nfun f(a: ^M) u8 { ret @a.p; }\nfun main() i32 { ret 0; }\n";
    if (!ut_sema_rejects(unstripped)) { bad = bad + 4; }

    ret bad;
}

test declassify__diagnostics_name_colon_gt {
    var bad: i32 = 0;

    if (ut_vec_note("fun logf(va: ...) u32 { ret 0; }\nfun f(a: ^u32) u32 { ret logf(a); }\nfun main() i32 { ret 0; }\n",
        "declassify with `:>T` first") != 0) { bad = bad + 1; }

    if (ut_vec_note("ext fun printf(fmt: *u8, ...) i32;\nfun f(a: ^u32) i32 { ret printf(\"%u\"::*u8, a); }\nfun main() i32 { ret 0; }\n",
        "declassify with `:>T` first") != 0) { bad = bad + 2; }

    if (ut_vec_note("fun f(p: ^*u8) u8 { ret @p; }\nfun main() i32 { ret 0; }\n",
        "`:>T`-declassify the pointer when disclosure is intended") != 0) { bad = bad + 4; }

    if (!ut_sema_rejects_with("fun f(a: ^u32) u32 { ret a:>^u32; }\nfun main() i32 { ret 0; }\n",
        "a `:>T` target type must be public")) { bad = bad + 8; }

    if (!ut_sema_rejects_with("fun f(a: ^u32) u64 { ret a:>u64; }\nfun main() i32 { ret 0; }\n",
        "a `:>T` target must name the operand's stripped (public) type")) { bad = bad + 16; }

    ret bad;
}

test secret_variadic__refused_through_every_container {
    var bad: i32 = 0;

    val sec: str = "fun logf(va: ...) u32 { ret 0; }\nfun f(a: ^u32) u32 { ret logf(a); }\nfun main() i32 { ret 0; }\n";
    if (ut_vec_diag(sec, "secret value cannot be passed to a variadic") != 0) { bad = 1; }

    if (!ut_sema_clean("fun logf(va: ...) u32 { ret 0; }\nfun f(a: ^u32) u32 { ret logf(a:>u32); }\nfun main() i32 { ret 0; }\n"))                                    { bad = 1; }
    if (!ut_sema_clean("fun logf(va: ...) u32 { ret 0; }\nfun f(a: u32) u32 { ret logf(a); }\nfun main() i32 { ret 0; }\n"))                                          { bad = 1; }
    if (!ut_sema_rejects("fun logf(va: ...) u32 { ret 0; }\nrec P { x: ^u32; }\nfun f(a: P) u32 { ret logf(a); }\nfun main() i32 { ret 0; }\n"))                      { bad = 1; }
    if (!ut_sema_rejects("fun logf(va: ...) u32 { ret 0; }\nrec I { s: ^u32; }\nrec O { inner: I; }\nfun f(a: O) u32 { ret logf(a); }\nfun main() i32 { ret 0; }\n")) { bad = 1; }
    if (!ut_sema_rejects("fun logf(va: ...) u32 { ret 0; }\nuni U { s: ^u32; t: ^u32; }\nfun f(a: U) u32 { ret logf(a); }\nfun main() i32 { ret 0; }\n"))             { bad = 1; }
    if (!ut_sema_rejects("fun logf(va: ...) u32 { ret 0; }\nfun f(a: [4]^u32) u32 { ret logf(a); }\nfun main() i32 { ret 0; }\n"))                                    { bad = 1; }
    if (!ut_sema_rejects("fun logf(va: ...) u32 { ret 0; }\nfun f(a: *^u8) u32 { ret logf(a); }\nfun main() i32 { ret 0; }\n"))                                       { bad = 1; }

    if (!ut_sema_clean("fun logf(va: ...) u32 { ret 0; }\nrec Q { x: u32; y: u32; }\nfun f(a: Q) u32 { ret logf(a); }\nfun main() i32 { ret 0; }\n")) { bad = 1; }

    if (!ut_sema_rejects("fun logf(va: ...) u32 { ret 0; }\nrec Box[T] { v: T; }\nfun mk[T](x: T) Box[T] { var b: Box[T]; b.v = x; ret b; }\nfun f(s: ^u32) u32 { ret logf(mk[^u32](s)); }\nfun main() i32 { ret 0; }\n")) { bad = 1; }
    if (!ut_sema_rejects("fun logf(va: ...) u32 { ret 0; }\nrec Box[T] { v: T; }\nfun f(s: ^u32) u32 { var b: Box[^u32]; ret logf(b); }\nfun main() i32 { ret 0; }\n"))                                                    { bad = 1; }
    if (!ut_sema_rejects("fun logf(va: ...) u32 { ret 0; }\nrec Box[T] { v: T; }\nfun f(s: ^u32) u32 { var b: Box[Box[^u32]]; ret logf(b); }\nfun main() i32 { ret 0; }\n"))                                               { bad = 1; }
    if (!ut_sema_clean("fun logf(va: ...) u32 { ret 0; }\nrec Box[T] { v: T; }\nfun mk[T](x: T) Box[T] { var b: Box[T]; b.v = x; ret b; }\nfun f() u32 { ret logf(mk[u32](5)); }\nfun main() i32 { ret 0; }\n"))           { bad = 1; }
    if (!ut_sema_rejects("fun logf(va: ...) u32 { ret 0; }\nrec N { next: *N; s: ^u32; }\nfun f(a: N) u32 { ret logf(a); }\nfun main() i32 { ret 0; }\n"))                                                                 { bad = 1; }
    if (!ut_sema_clean("fun logf(va: ...) u32 { ret 0; }\nrec N { next: *N; v: u32; }\nfun f(a: N) u32 { ret logf(a); }\nfun main() i32 { ret 0; }\n"))                                                                    { bad = 1; }

    if (!ut_sema_clean("fun takes(a: ^u32) u32 { ret a:>u32; }\nfun f(a: ^u32) u32 { ret takes(a); }\nfun main() i32 { ret 0; }\n")) { bad = 1; }
    ret bad;
}

test secret_welding__pointer_casts_and_unions {
    var bad: i32 = 0;

    val erase: str = "rec P { x: ^u32; }\nfun e(p: *P) ptr { ret p::ptr; }\nfun main() i32 { ret 0; }\n";
    if (ut_vec_diag(erase, "secret-welded pointer cannot be erased") != 0)                                               { bad = 1; }
    if (!ut_sema_rejects("rec Box[T] { v: T; }\nfun e(p: *Box[^u32]) ptr { ret p::ptr; }\nfun main() i32 { ret 0; }\n")) { bad = 1; }
    if (!ut_sema_clean("rec R { x: u32; }\nfun e(p: *R) ptr { ret p::ptr; }\nfun main() i32 { ret 0; }\n"))              { bad = 1; }

    if (!ut_sema_rejects("rec P { x: ^u32; }\nrec Q { x: u32; }\nfun f(p: *P) *Q { ret p:~*Q; }\nfun main() i32 { ret 0; }\n"))           { bad = 1; }
    if (!ut_sema_rejects("rec P { x: ^u32; }\nrec Q { x: u32; }\nfun f(p: *P) *Q { ret p::*Q; }\nfun main() i32 { ret 0; }\n"))           { bad = 1; }
    if (!ut_sema_rejects("rec Box[T] { v: T; }\nrec Q { x: u32; }\nfun f(p: *Box[^u32]) *Q { ret p:~*Q; }\nfun main() i32 { ret 0; }\n")) { bad = 1; }
    if (!ut_sema_clean("fun f(a: ^u32) ^i32 { ret a:~^i32; }\nfun main() i32 { ret 0; }\n"))                                              { bad = 1; }
    if (!ut_sema_clean("rec A { x: u32; }\nrec B { y: u32; }\nfun f(p: *A) *B { ret p:~*B; }\nfun main() i32 { ret 0; }\n"))              { bad = 1; }

    val pun: str = "rec P { x: ^u32; }\nrec Q { x: u32; }\nuni U { a: P; b: Q; }\nfun main() i32 { ret 0; }\n";
    if (ut_vec_diag(pun, "union variants must agree on secrecy") != 0)                                                           { bad = 1; }
    if (!ut_sema_rejects("rec Box[T] { v: T; }\nrec Q { x: u32; }\nuni U { a: Box[^u32]; b: Q; }\nfun main() i32 { ret 0; }\n")) { bad = 1; }
    if (!ut_sema_rejects("uni U { a: ^u32; b: u32; }\nfun main() i32 { ret 0; }\n"))                                             { bad = 1; }
    if (!ut_sema_clean("uni U { a: ^u32; b: ^u32; }\nfun main() i32 { ret 0; }\n"))                                              { bad = 1; }
    if (!ut_sema_clean("rec A { x: u32; }\nrec B { y: u32; }\nuni U { a: A; b: B; }\nfun main() i32 { ret 0; }\n"))              { bad = 1; }
    if (!ut_sema_clean("rec A { x: ^u32; }\nrec B { x: ^u32; y: ^u32; }\nuni U { a: A; b: B; }\nfun main() i32 { ret 0; }\n"))   { bad = 1; }

    if (!ut_sema_rejects("rec P { x: ^u32; }\nfun f(a: *P) u64 { ret a:~u64; }\nfun main() i32 { ret 0; }\n")) { bad = 1; }
    if (!ut_sema_clean("fun f(a: *u32) u64 { ret a:~u64; }\nfun main() i32 { ret 0; }\n"))                     { bad = 1; }
    if (!ut_sema_clean("fun f(a: *^u32) *^i32 { ret a:~*^i32; }\nfun main() i32 { ret 0; }\n"))                { bad = 1; }

    # a type holding no value is no secrecy layout, so casting through one gets the direct verdict (#3875)
    if (!ut_sema_rejects_with("rec E {}\nrec Z { e: E; n: [0]u64; }\nrec R { a: ^u64; b: ^u64; }\nrec P { a: u64; }\nfun f(p: *^u8) *^R { ret p::*^R; }\nfun main() i32 { ret 0; }\n", "cannot add or drop the secret qualifier")) { bad = 2; }
    if (!ut_sema_rejects_with("rec E {}\nrec Z { e: E; n: [0]u64; }\nrec R { a: ^u64; b: ^u64; }\nrec P { a: u64; }\nfun f(p: *^E) *^R { ret p::*^R; }\nfun main() i32 { ret 0; }\n", "cannot add or drop the secret qualifier")) { bad = 3; }
    if (!ut_sema_rejects_with("rec E {}\nrec Z { e: E; n: [0]u64; }\nrec R { a: ^u64; b: ^u64; }\nrec P { a: u64; }\nfun f(p: *^Z) *^R { ret p::*^R; }\nfun main() i32 { ret 0; }\n", "cannot add or drop the secret qualifier")) { bad = 4; }
    if (!ut_sema_rejects_with("rec E {}\nrec Z { e: E; n: [0]u64; }\nrec R { a: ^u64; b: ^u64; }\nrec P { a: u64; }\nfun f(p: *E) *R { ret p::*R; }\nfun main() i32 { ret 0; }\n", "cannot add or drop the secret qualifier")) { bad = 5; }
    if (!ut_sema_clean("rec E {}\nrec Z { e: E; n: [0]u64; }\nrec R { a: ^u64; b: ^u64; }\nrec P { a: u64; }\nfun f(p: *^u8) *^E { ret p::*^E; }\nfun main() i32 { ret 0; }\n")) { bad = 6; }
    if (!ut_sema_clean("rec E {}\nrec Z { e: E; n: [0]u64; }\nrec R { a: ^u64; b: ^u64; }\nrec P { a: u64; }\nfun f(p: *^u8) *^P { ret p::*^P; }\nfun main() i32 { ret 0; }\n")) { bad = 7; }
    if (!ut_sema_clean("rec E {}\nrec Z { e: E; n: [0]u64; }\nrec R { a: ^u64; b: ^u64; }\nrec P { a: u64; }\nfun f(p: *^E) *^P { ret p::*^P; }\nfun main() i32 { ret 0; }\n")) { bad = 8; }
    if (!ut_sema_rejects_with("rec R { a: ^u64; b: ^u64; }\nfun f(p: *^rec{}) *^R { ret p::*^R; }\nfun main() i32 { ret 0; }\n", "cannot add or drop the secret qualifier")) { bad = 9; }
    if (!ut_sema_clean("fun f(p: *^u8) *^rec{} { ret p::*^rec{}; }\nfun main() i32 { ret 0; }\n")) { bad = 10; }

    if (!ut_sema_rejects("fun id(x: u32) u32 { ret x; }\nfun f() fun(^u32) u32 { ret id :~ fun(^u32) u32; }\nfun main() i32 { ret 0; }\n"))                 { bad = 1; }
    if (!ut_sema_rejects("fun id(x: u32) u32 { ret x; }\nfun f() fun(^u32) u32 { ret id :: fun(^u32) u32; }\nfun main() i32 { ret 0; }\n"))                 { bad = 1; }
    if (!ut_sema_rejects("fun sr(x: u32) ^u32 { var y: ^u32 = x; ret y; }\nfun f() fun(u32) u32 { ret sr :~ fun(u32) u32; }\nfun main() i32 { ret 0; }\n")) { bad = 1; }
    if (!ut_sema_rejects("fun id(x: ^u32) u32 { ret x:>u32; }\nfun f() u64 { ret id :~ u64; }\nfun main() i32 { ret 0; }\n"))                               { bad = 1; }
    if (!ut_sema_clean("fun id(x: ^u32) u32 { ret x:>u32; }\nfun f() fun(^u32) u32 { ret id :~ fun(^u32) u32; }\nfun main() i32 { ret 0; }\n"))             { bad = 1; }
    if (!ut_sema_clean("fun id(x: u32) u32 { ret x; }\nfun f() fun(u32) u32 { ret id :~ fun(u32) u32; }\nfun main() i32 { ret 0; }\n"))                     { bad = 1; }

    ret bad;
}

test regression__deep_secret_walk_scales_with_the_type_graph {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var bad: i32 = 0;

    val n: u32 = 320;

    val tr: res[str, format.FormatError] = format.sprint(?alloc, "fun e(p: *R{}) ptr {{ ret p::ptr; }}\nfun main() i32 {{ ret 0; }}\n", n - 1);
    if (sel tr.err) { ret 1; }
    val tail: str = tr.ok;

    val br: res[str, format.FormatError] = format.sprint(?alloc, "a: *R{};", n - 1);
    if (sel br.err) { ret 1; }
    val back: str = br.ok;

    val pub_src: err[fail.Fail] = ut_chain_src(?alloc, n, "a: u32;", tail);
    if (sel pub_src.ok) { bad = 1; }
    if (sel pub_src.err) {
        val src: str = fail.describe(pub_src.err);
        if (!ut_sema_clean(src)) { bad = 1; }
        A.deallocate[char](?alloc, src::*char, str_len(src) + 1);
    }

    val sec_src: err[fail.Fail] = ut_chain_src(?alloc, n, "a: ^u32;", tail);
    if (sel sec_src.ok) { bad = 1; }
    if (sel sec_src.err) {
        val src: str = fail.describe(sec_src.err);
        if (ut_vec_diag(src, "secret-welded pointer cannot be erased") != 0) { bad = 1; }
        A.deallocate[char](?alloc, src::*char, str_len(src) + 1);
    }

    val cyc_src: err[fail.Fail] = ut_chain_src(?alloc, n, back, tail);
    if (sel cyc_src.ok) { bad = 1; }
    if (sel cyc_src.err) {
        val src: str = fail.describe(cyc_src.err);
        if (!ut_sema_clean(src)) { bad = 1; }
        A.deallocate[char](?alloc, src::*char, str_len(src) + 1);
    }

    A.deallocate[char](?alloc, back::*char, str_len(back) + 1);
    A.deallocate[char](?alloc, tail::*char, str_len(tail) + 1);
    ret bad;
}

#[testing]
fun ut_fanout_src(alloc: *A.Allocator, p: str, n: u32, last: str) err[fail.Fail] {
    var acc: str = "";
    var i:   u32 = 0;
    for (i < n) {
        var body: str = "a: u32; b: u32;";
        if (i == n - 1) { body = last; }
        val next: res[str, format.FormatError] = format.sprint(alloc, "{}rec {}{} {{ {} }}\n", acc, p, i, body);
        if (i > 0)        { A.deallocate[char](alloc, acc::*char, str_len(acc) + 1); }
        if (sel next.err) { ret err[fail.Fail].ok{}; }
        acc = next.ok;
        i   = i + 1;
    }

    val open: res[str, format.FormatError] = format.sprint(alloc, "{}rec {}P {{", acc, p);
    if (n > 0)        { A.deallocate[char](alloc, acc::*char, str_len(acc) + 1); }
    if (sel open.err) { ret err[fail.Fail].ok{}; }
    acc = open.ok;

    i = 0;
    for (i < n) {
        val fld: res[str, format.FormatError] = format.sprint(alloc, "{} f{}: {}{};", acc, i, p, i);
        A.deallocate[char](alloc, acc::*char, str_len(acc) + 1);
        if (sel fld.err) { ret err[fail.Fail].ok{}; }
        acc = fld.ok;
        i   = i + 1;
    }

    val close: res[str, format.FormatError] = format.sprint(alloc, "{} }}\n", acc);
    A.deallocate[char](alloc, acc::*char, str_len(acc) + 1);
    if (sel close.err) { ret err[fail.Fail].ok{}; }
    ret err[fail.Fail].err{fail.message(close.ok)};
}

#[testing]
fun ut_pair_src(alloc: *A.Allocator, n: u32, a_last: str, b_last: str, tail: str) err[fail.Fail] {
    val fa: err[fail.Fail] = ut_fanout_src(alloc, "A", n, a_last);
    if (sel fa.ok) { ret err[fail.Fail].ok{}; }
    val sa: str = fail.describe(fa.err);

    val fb: err[fail.Fail] = ut_fanout_src(alloc, "B", n, b_last);
    if (sel fb.ok) {
        A.deallocate[char](alloc, sa::*char, str_len(sa) + 1);
        ret err[fail.Fail].ok{};
    }
    val sb: str = fail.describe(fb.err);

    val whole: res[str, format.FormatError] = format.sprint(alloc, "{}{}{}", sa, sb, tail);
    A.deallocate[char](alloc, sa::*char, str_len(sa) + 1);
    A.deallocate[char](alloc, sb::*char, str_len(sb) + 1);
    if (sel whole.err) { ret err[fail.Fail].ok{}; }
    ret err[fail.Fail].err{fail.message(whole.ok)};
}

test regression__secrecy_pair_walk_scales_with_the_type_graph {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var bad: i32 = 0;

    val n: u32 = 200;

    val same_src: err[fail.Fail] = ut_pair_src(?alloc, n, "a: ^u32; b: u32;", "a: ^u32; b: u32;",
        "uni V { x: AP; y: BP; }\nfun main() i32 { var v: V; ret 0; }\n");
    if (sel same_src.ok) { bad = 1; }
    if (sel same_src.err) {
        val src: str = fail.describe(same_src.err);
        if (!ut_sema_clean(src)) { bad = 1; }
        A.deallocate[char](?alloc, src::*char, str_len(src) + 1);
    }

    val diff_src: err[fail.Fail] = ut_pair_src(?alloc, n, "a: ^u32; b: u32;", "a: u32; b: ^u32;",
        "uni V { x: AP; y: BP; }\nfun main() i32 { var v: V; ret 0; }\n");
    if (sel diff_src.ok) { bad = 1; }
    if (sel diff_src.err) {
        val src: str = fail.describe(diff_src.err);
        if (ut_vec_diag(src, "union variants must agree on secrecy") != 0) { bad = 1; }
        if (ut_vec_diag(src, "ran out of room") == 0)                      { bad = 1; }
        A.deallocate[char](?alloc, src::*char, str_len(src) + 1);
    }

    val cast_ok: err[fail.Fail] = ut_pair_src(?alloc, n, "a: ^u32; b: u32;", "a: ^u32; b: u32;",
        "fun f(p: *AP) *BP { ret p :~ *BP; }\nfun main() i32 { ret 0; }\n");
    if (sel cast_ok.ok) { bad = 1; }
    if (sel cast_ok.err) {
        val src: str = fail.describe(cast_ok.err);
        if (!ut_sema_clean(src)) { bad = 1; }
        A.deallocate[char](?alloc, src::*char, str_len(src) + 1);
    }

    val cast_bad: err[fail.Fail] = ut_pair_src(?alloc, n, "a: ^u32; b: u32;", "a: u32; b: ^u32;",
        "fun f(p: *AP) *BP { ret p :~ *BP; }\nfun main() i32 { ret 0; }\n");
    if (sel cast_bad.ok) { bad = 1; }
    if (sel cast_bad.err) {
        val src: str = fail.describe(cast_bad.err);
        if (ut_vec_diag(src, "cannot add or drop the secret qualifier") != 0) { bad = 1; }
        A.deallocate[char](?alloc, src::*char, str_len(src) + 1);
    }

    val cyc_src: err[fail.Fail] = ut_pair_src(?alloc, n, "a: ^u32; b: u32; p: *AP;", "a: ^u32; b: u32; p: *BP;",
        "uni V { x: AP; y: BP; }\nfun main() i32 { var v: V; ret 0; }\n");
    if (sel cyc_src.ok) { bad = 1; }
    if (sel cyc_src.err) {
        val src: str = fail.describe(cyc_src.err);
        if (!ut_sema_clean(src)) { bad = 1; }
        A.deallocate[char](?alloc, src::*char, str_len(src) + 1);
    }

    ret bad;
}

test secret_union__generic_instance_refused_after_deferral {
    var bad: i32 = 0;

    if (ut_ct_lower_diag("uni U[T] { a: T; b: u32; }\nfun sink[T](va: ...) u32 { var acc: u32 = 0; $each a in va { var u: U[T]; u.b = acc; acc = acc + u.b; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var one: u32 = 1; sink[^u32](one); ret 0; }\n",
        "this instantiation makes overlapping fields") != 0) { bad = 1; }
    if (!ut_ct_lower_clean("uni U[T] { a: T; b: u32; }\nfun sink[T](va: ...) u32 { var acc: u32 = 0; $each a in va { var u: U[T]; u.b = acc; acc = acc + u.b; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var one: u32 = 1; sink[u32](one); ret 0; }\n")) { bad = 1; }

    var xn: [2]str;
    xn[0] = "main.mach";
    xn[1] = "lib.mach";
    var xt: [2]str;
    xt[0] = "use uniontest.lib;\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var b: lib.XBox[^u32]; b.u.b = 0; ret 0; }\n";
    xt[1] = "pub uni XU[T] { a: T; b: u32; }\npub rec XBox[T] { u: XU[T]; }\n";
    if (ut_ct_lower_diag_n(?xn[0], ?xt[0], 2, "this instantiation makes overlapping fields") != 0) { bad = 1; }

    var yn: [2]str;
    yn[0] = "main.mach";
    yn[1] = "lib.mach";
    var yt: [2]str;
    yt[0] = "use uniontest.lib;\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var o: lib.YOuter[u32]; o.u.b = 0; ret 0; }\n";
    yt[1] = "pub uni YU[A, B] { a: A; b: B; }\npub rec YOuter[T] { u: YU[T, ^u32]; }\n";
    if (ut_ct_lower_diag_n(?yn[0], ?yt[0], 2, "this instantiation makes overlapping fields") != 0) { bad = 1; }
    ret bad;
}

#[testing]
fun ut_tally_secret_stores(p: *project.Project, stores: *u32, marked: *u32) {
    @stores = 0;
    @marked = 0;
    var ti: u32 = 0;
    for (ti < p.topo_len) {
        val m: *ir.Module = project.module_at(p, p.topo[ti]::u32).ir_module;
        if (m != nil) {
            var fi: u32 = 0;
            for (fi < m.function_len) {
                val fn: *ir.Function = ?m.functions[fi];
                var bi: u32          = 0;
                for (bi < fn.block_count) {
                    val blk: *ir.Block = ?fn.blocks[bi];
                    var ix:  u32       = 0;
                    for (ix < blk.instr_count) {
                        val ins: *instruction.Instruction = ?fn.instrs[blk.instructions[ix]];
                        if (ins.kind == instruction.OP_STORE || ins.kind == instruction.OP_MEMZERO) {
                            @stores = @stores + 1;
                            if (ins.secret) { @marked = @marked + 1; }
                        }
                        ix = ix + 1;
                    }
                    bi = bi + 1;
                }
                fi = fi + 1;
            }
        }
        ti = ti + 1;
    }
}

test secret_store__taint_survives_lowering {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    val ssrc: str                                = "fun wipe(q: *^u8, n: u64) { var i: u64 = 0; for (i < n) { q[i] = 0; i = i + 1; } }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n";
    val spr:  res[project.Project, outcome.Fail] = ut_vec_lower(?s, ?alloc, ssrc, "linux");
    if (sel spr.err) { ret 1; }
    var sp:      project.Project = spr.ok;
    var sstores: u32             = 0;
    var smarked: u32             = 0;
    ut_tally_secret_stores(?sp, ?sstores, ?smarked);

    val psrc: str                                = "fun wipe(q: *u8, n: u64) { var i: u64 = 0; for (i < n) { q[i] = 0; i = i + 1; } }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n";
    val ppr:  res[project.Project, outcome.Fail] = ut_vec_lower(?s, ?alloc, psrc, "linux");
    if (sel ppr.err) { ret 4; }
    var pp:      project.Project = ppr.ok;
    var pstores: u32             = 0;
    var pmarked: u32             = 0;
    ut_tally_secret_stores(?pp, ?pstores, ?pmarked);

    val vsrc: str                                = "fun mk(k: ^u8) [2]^u8 { var a: [2]^u8 = [2]^u8{k, k}; ret a; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n";
    val vpr:  res[project.Project, outcome.Fail] = ut_vec_lower(?s, ?alloc, vsrc, "linux");
    if (sel vpr.err) { ret 6; }
    var vp:      project.Project = vpr.ok;
    var vstores: u32             = 0;
    var vmarked: u32             = 0;
    ut_tally_secret_stores(?vp, ?vstores, ?vmarked);

    if (sstores == 0 || pstores == 0) { ret 3; }
    if (smarked == 0)                 { ret 2; }
    if (pmarked != 0)                 { ret 5; }
    if (vmarked == 0)                 { ret 7; }
    ret 0;
}

test oblivious_asm__validated_not_refused {
    var bad: i32 = 0;

    if (ut_codegen_target_ok("#[oblivious]\nfun f(x: ^u64) ^u64 { var r: ^u64 = x; asm x86_64 { nop } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n", "linux") != 0) { bad = 1; }

    if (ut_codegen_target_ok("#[oblivious]\nfun f(x: ^u64) ^u64 { var r: ^u64 = x; asm x86_64 { jmp 1f\n1:\n nop } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n", "linux") != 0) { bad = 1; }

    if (ut_codegen_target_ok("#[oblivious]\nfun f(p: *i64) i64 { var v: i64 = 1; asm x86_64 { mov rax, {v}\n lock xadd {p}, rax\n mov {v}, rax } ret v; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n", "linux") != 0) { bad = 1; }

    if (ut_codegen_target_ok("#[oblivious]\nfun ll(p: *i64) i64 { var v: i64 = 0; asm aarch64 { ldr x12, {p}\n ldaxr x9, [x12]\n stlxr w10, x9, [x12]\n cbnz w10, 1f\n1:\n nop } ret v; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n", "linux-arm64") != 0) { bad = 1; }

    # the compared registers are defined inside the block: at o0 the secret
    # parameter lives in whichever register the allocator chose, and the
    # post-expansion walk sees a compare on it for what it is
    if (ut_codegen_target_ok("#[oblivious]\nfun f(x: ^u64) ^u64 { var r: ^u64 = x; asm x86_64 { mov rax, 1\n mov rcx, 2\n cmp rax, rcx\n je 1f\n1:\n nop } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n", "linux") != 0) { bad = 1; }

    if (ut_codegen_target_ok("#[oblivious]\nfun f(x: ^u64) ^u64 { var r: ^u64 = x; asm x86_64 { cmp rax, rbx\n setb bl\n mov rcx, [rbx] } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n", "linux") != 0) { bad = 1; }

    ret bad;
}

# a codegen refusal of the program is a diagnostic on the store, not text on
# the failure: the pass answers `reported`, the store holds one located error
# at the asm block, and the failure itself carries no message (#3656)
test oblivious_asm__refusal_is_a_located_error {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "#[oblivious]\nfun f(k: *^u64) ^u64 {\n    var r: ^u64 = @k;\n    asm x86_64 {\n        mov rax, {r}\n        inc rax\n        je 1f\n    1:\n        nop\n    }\n    ret r;\n}\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str               = root_r.ok;
    val rr:   err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var tsel: manifest.Selection                 = ut_target_sel("linux");
    val pr:   res[project.Project, outcome.Fail] = driver.build_project(?s, root, ?tsel);
    fs.remove_all(?alloc, root);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    var bad: i32               = 0;
    val se:  err[outcome.Fail] = driver.run_sema_pass(?p);
    if (sel se.err) { bad = 2; }
    val le: err[outcome.Fail] = driver.run_lower_pass(?p);
    if (sel le.err && bad == 0) { bad = 3; }
    val ce: err[outcome.Fail] = driver.run_codegen_pass(?p);
    if (sel ce.ok) { bad = 4; }
    if (sel ce.err) {
        if (bad == 0) { bad = ut_codegen_rejection_shape(?s, ce.err); }
    }

    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

# the failure reports nothing of its own and the store carries exactly one
# error, located at the asm block (main.mach:4:5); 0 when so
#[testing]
fun ut_codegen_rejection_shape(s: *session.Session, failure: outcome.Fail) i32 {
    if (!outcome.is_reported(failure)) { ret 5; }
    val carried: opt[str] = outcome.text(failure);
    if (sel carried.some)                      { ret 6; }
    if (diagnostic.error_count(?s.diags) != 1) { ret 7; }
    val d: opt[*diagnostic.Diagnostic] = diagnostic.get(?s.diags, 0);
    if (sel d.none) { ret 8; }
    val found: *diagnostic.Diagnostic = d.some;
    if (found.severity != diagnostic.SEVERITY_ERROR)                                 { ret 9; }
    if (!ut_str_contains(found.message, "branches on a secret value"))               { ret 10; }
    if (!ut_str_contains(found.message, "#[oblivious] function `uniontest.main.f`")) { ret 11; }
    if (found.loc.file_id == src.FILE_NIL)                                           { ret 12; }
    if (!ut_diag_located_at(s, "branches on a secret value", "main.mach", 4, 5))     { ret 13; }
    ret 0;
}

# a branch on secret flags, a flag-setting rmw on a secret, a setcc address, a raw payload,
# a secret branch or division on each isa, and a secret parameter bound straight into the block
test oblivious_asm__leaks_refused {
    var bad: i32 = 0;

    if (ut_codegen_target_rejects("#[oblivious]\nfun f(k: ^u64) ^u64 { var r: ^u64 = k; asm x86_64 { cmp {r}, rbx\n je 1f\n1:\n nop } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "linux", "its condition rides the flags register") != 0) { bad = 1; }
    if (ut_codegen_target_rejects("#[oblivious]\nfun f(k: ^u64) ^u64 { var r: ^u64 = k; asm x86_64 { mov rax, {r}\n cmpxchg [rbx], rcx\n je 1f\n1:\n nop } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "linux", "branches on a secret value") != 0) { bad = 2; }
    if (ut_codegen_target_rejects("#[oblivious]\nfun f(k: ^u64) ^u64 { var r: ^u64 = k; asm x86_64 { mov rax, {r}\n cmp rax, 1\n setb bl\n mov rcx, [rbx] } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "linux", "addresses memory with a secret value") != 0) { bad = 3; }

    if (ut_codegen_target_rejects("#[oblivious]\nfun f(x: ^u64) ^u64 { var r: ^u64 = x; asm x86_64 { .byte 0x90 } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "linux", "its payload can encode any instruction") != 0) { bad = 4; }
    if (ut_codegen_target_rejects("#[oblivious]\nfun f(x: ^u64) ^u64 { var r: ^u64 = x; asm aarch64 { .word 0xd503201f } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "linux-arm64", "its payload can encode any instruction") != 0) { bad = 5; }
    if (ut_codegen_target_rejects("#[oblivious]\nfun f(x: ^u64) ^u64 { var r: ^u64 = x; asm riscv64 { .quad 0x0000001300000013 } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "linux-riscv64", "its payload can encode any instruction") != 0) { bad = 6; }

    if (ut_codegen_target_rejects("#[oblivious]\nfun bc(k: ^u64) ^u64 { var r: ^u64 = k; asm aarch64 { ldr x9, {r}\n cmp x9, x1\n b.eq 1f\n1:\n nop } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "linux-arm64", "its condition rides the flags register") != 0) { bad = 7; }
    if (ut_codegen_target_rejects("#[oblivious]\nfun f(k: ^u64) ^u64 { var r: ^u64 = k; asm aarch64 { ldr x9, {r}\n cbnz x9, 1f\n1:\n nop } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "linux-arm64", "branches on a secret value inside an inline-asm block") != 0) { bad = 8; }
    if (ut_codegen_target_rejects("#[oblivious]\nfun f(k: ^u64) ^u64 { var r: ^u64 = k; asm riscv64 { ld a0, {r}\n div a1, a0, a0\n nop } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "linux-riscv64", "variable-latency inline-asm operation on a secret value") != 0) { bad = 9; }

    if (ut_codegen_target_rejects("#[oblivious]\nfun f(k: ^u64) ^u64 { asm x86_64 { mov rax, {k}\n inc rax\n je 1f\n1:\n nop } ret k; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "linux", "branches on a secret value") != 0) { bad = 10; }
    if (ut_codegen_target_ok("#[oblivious]\nfun f(k: u64) u64 { asm x86_64 { mov rax, {k}\n inc rax\n je 1f\n1:\n nop } ret k; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n", "linux") != 0) { bad = 11; }

    ret bad;
}

# the aes rounds and the carry-less multiplies run in data-independent time, so
# an #[oblivious] body may carry a secret through them; the result is still a
# secret, so an address built from it is refused (#3835)
test oblivious_asm__admits_the_aes_and_carry_less_multiply_rows {
    var bad: i32 = 0;
    val x86: str = "#[oblivious]\n#[extensions(aes, pclmul, sse41)]\nfun f(p: *^u8) *^u8 { var q: *^u8 = p; asm x86_64 { mov rax, {q}\n movdqu xmm0, [rax]\n movdqu xmm1, [rax + 16]\n aesenc xmm1, xmm0\n aesenclast xmm1, xmm0\n aesdec xmm1, xmm0\n aesdeclast xmm1, xmm0\n aesimc xmm2, xmm1\n aeskeygenassist xmm3, xmm2, 0x1b\n pclmulqdq xmm3, xmm0, 0x11\n movdqu [rax], xmm3 } ret q; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n";
    if (ut_codegen_target_ok(x86, "linux") != 0) { bad = bad + 1; }
    val x86_leak: str = "#[oblivious]\n#[extensions(aes, pclmul, sse41)]\nfun f(p: *^u8) *^u8 { var q: *^u8 = p; asm x86_64 { mov rax, {q}\n movdqu xmm0, [rax]\n aesenc xmm1, xmm0\n pclmulqdq xmm1, xmm0, 0\n pextrd ecx, xmm1, 0\n mov rdx, [rcx] } ret q; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n";
    if (ut_codegen_target_rejects(x86_leak, "linux", "addresses memory with a secret value") != 0) { bad = bad + 2; }

    val arm: str = "#[oblivious]\n#[extensions(aes, pmull)]\nfun f(p: *^u8) *^u8 { var q: *^u8 = p; asm aarch64 { ldr x0, {q}\n ld1 {v0.16b}, [x0]\n aese v1.16b, v0.16b\n aesmc v1.16b, v1.16b\n aesd v1.16b, v0.16b\n aesimc v1.16b, v1.16b\n pmull v2.1q, v1.1d, v0.1d\n pmull2 v3.1q, v1.2d, v0.2d\n eor v2.16b, v2.16b, v3.16b\n st1 {v2.16b}, [x0] } ret q; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n";
    if (ut_codegen_target_ok(arm, "linux-arm64") != 0) { bad = bad + 4; }
    ret bad;
}

#[testing]
rec UtAsmCase {
    target: str;
    src:    str;
    needle: str;
}

# binding a secret is not an address; a pointer to a secret is a public address, as a
# parameter or a local, on each isa (#3640); a secret value is a secret address whatever
# it points at, including the secret pointer `^*u32` and a segment base
#[testing]
val UT_ASM_ADDRESSES: [11]UtAsmCase = [11]UtAsmCase{
    UtAsmCase{target: "linux", src: "#[oblivious]\nfun f(k: ^u64) ^u64 { var r: ^u64 = k; asm x86_64 { mov rax, {r} } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n", needle: ""},
    UtAsmCase{target: "linux", src: "#[oblivious]\nfun f(state: *^u32) { asm x86_64 { mov rax, {state}\n mov ecx, [rax]\n add ecx, 1\n mov [rax], ecx } }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n", needle: ""},
    UtAsmCase{target: "linux", src: "#[oblivious]\nfun f(state: *^u32, block: *^u8) { asm x86_64 { mov rax, {state}\n mov rcx, {block}\n movdqu xmm1, [rax]\n movdqu xmm2, [rax + 16]\n movdqu xmm0, [rcx]\n paddd xmm1, xmm0\n pxor xmm2, xmm0\n movdqu [rax], xmm1\n movdqu [rax + 16], xmm2 } }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n", needle: ""},
    UtAsmCase{target: "linux-arm64", src: "#[oblivious]\nfun f(state: *^u32) { asm aarch64 { ldr x0, {state}\n ldr w1, [x0]\n add w1, w1, 1\n str w1, [x0] } }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n", needle: ""},
    UtAsmCase{target: "linux-riscv64", src: "#[oblivious]\nfun f(state: *^u32) { asm riscv64 { ld a0, {state}\n lw a1, 0(a0)\n addi a1, a1, 1\n sw a1, 0(a0) } }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n", needle: ""},
    UtAsmCase{target: "linux", src: "#[oblivious]\nfun f(state: *^u32) { var p: *^u32 = state; asm x86_64 { mov rax, {p}\n mov ecx, [rax]\n mov [rax], ecx } }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n", needle: ""},
    UtAsmCase{target: "linux", src: "#[oblivious]\nfun f(k: ^u64) ^u64 { var r: ^u64 = k; asm x86_64 { mov rax, {r}\n mov rbx, [rax] } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n", needle: "addresses memory with a secret value"},
    UtAsmCase{target: "linux", src: "#[oblivious]\nfun f(k: ^u64) { asm x86_64 { mov rax, {k}\n mov ecx, [rax] } }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n", needle: "addresses memory with a secret value"},
    UtAsmCase{target: "linux", src: "#[oblivious]\nfun f(q: ^*u32) { asm x86_64 { mov rax, {q}\n mov ecx, [rax] } }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n", needle: "addresses memory with a secret value"},
    UtAsmCase{target: "linux", src: "#[oblivious]\n#[extensions(fsgsbase)]\nfun f(q: ^*u32) { asm x86_64 { mov rax, {q}\n wrgsbase rax } }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n", needle: "installs a secret value as an address base"},
    UtAsmCase{target: "linux-arm64", src: "#[oblivious]\nfun f(q: ^*u32) { asm aarch64 { ldr x0, {q}\n ldr w1, [x0] } }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n", needle: "addresses memory with a secret value"}
};

# 0 when every case builds, or is refused naming its needle
#[testing]
fun ut_asm_cases(cases: *UtAsmCase, len: usize) i32 {
    var i: usize = 0;
    for (i < len) {
        val c:    *UtAsmCase = ?cases[i];
        var code: i32        = 0;
        if (str_len(c.needle) == 0) { code = ut_codegen_target_ok(c.src, c.target); }
        or                          { code = ut_codegen_target_rejects(c.src, c.target, c.needle); }
        if (code != 0) {
            print.printf("oblivious asm case {} on {}: {}\n", i, c.target, code);
            ret (i::i32 + 1) * 100 + code;
        }
        i = i + 1;
    }
    ret 0;
}

test oblivious_asm__secret_address {
    ret ut_asm_cases(?UT_ASM_ADDRESSES[0], 11);
}

# a load through `*^T` taints its destination: a branch or an address on the loaded value
# is refused; a store of a public value through the pointer is not, and neither is a store
# of the loaded secret through a public pointer, inline asm being a trusted crossing (#3640)
test oblivious_asm__load_through_pointer_to_secret_taints {
    var bad: i32 = 0;

    if (ut_codegen_target_rejects("#[oblivious]\nfun f(p: *^u32) { asm x86_64 { mov rax, {p}\n mov ecx, [rax]\n cmp ecx, 1\n je 1f\n1:\n nop } }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "linux", "branches on a secret value") != 0) { bad = bad + 1; }
    if (ut_codegen_target_rejects("#[oblivious]\nfun f(p: *^u64) { asm x86_64 { mov rax, {p}\n mov rcx, [rax]\n mov rdx, [rcx] } }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "linux", "addresses memory with a secret value") != 0) { bad = bad + 2; }
    if (ut_codegen_target_rejects("#[oblivious]\nfun f(p: *^u32) { asm aarch64 { ldr x0, {p}\n ldr w1, [x0]\n cbnz w1, 1f\n1:\n nop } }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "linux-arm64", "branches on a secret value") != 0) { bad = bad + 4; }
    if (ut_codegen_target_rejects("#[oblivious]\nfun f(p: *^u32) { asm riscv64 { ld a0, {p}\n lw a1, 0(a0)\n beq a1, a2, 1f\n1:\n nop } }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "linux-riscv64", "branches on a secret value") != 0) { bad = bad + 8; }

    if (ut_codegen_target_ok("#[oblivious]\nfun f(p: *^u32) { asm x86_64 { mov rax, {p}\n mov dword [rax], 7 } }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n", "linux") != 0)                                      { bad = bad + 16; }
    if (ut_codegen_target_ok("#[oblivious]\nfun f(p: *^u32, q: *u32) { asm x86_64 { mov rax, {p}\n mov rbx, {q}\n mov ecx, [rax]\n mov [rbx], ecx } }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n", "linux") != 0) { bad = bad + 32; }

    ret bad;
}

# secret content in an aggregate is a property of its bytes, not of the home that holds them (#3263)
test secret_record__transport_keeps_content_secrecy {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val head:   str    = "rec Rec { a: u64; b: u64; } rec S { d: u64; p: ^u64; } rec P { d: u64; p: u64; } ";
    var bodies: [9]str = [9]str{
        "#[oblivious] fun f(v: ^Rec) u64 { ret (v.a):>u64; }",
        "#[oblivious] #[noinline] fun c(v: ^Rec) ^Rec { val u: ^Rec = v; ret u; }",
        "#[oblivious] #[noinline] fun mk() ^Rec { var r: ^Rec; ret r; } #[oblivious] fun use() u64 { val r: ^Rec = mk(); ret (r.a):>u64; }",
        "#[oblivious] fun g(v: S) u64 { ret (v.p):>u64; }",
        "#[oblivious] #[noinline] fun k(v: S) S { ret v; } #[oblivious] fun m() u64 { var t: S; t.d = 1; t.p = 5; val u: S = k(t); ret (u.p):>u64; }",
        "#[oblivious] fun q(v: P) u64 { if (v.p > 3) { ret 1; } ret 0; }",
        "#[oblivious] fun d(v: S) u64 { if (v.d > 3) { ret 1; } ret 0; }",
        "#[oblivious] fun h(v: S) u64 { if (v.p > 3) { ret 1; } ret 0; }",
        "#[oblivious] fun x(v: S, p: *u8) u8 { ret p[v.p]; }"
    };
    var want: [9]i32 = [9]i32{0, 0, 0, 0, 0, 0, 0, 1, 1};
    var i:    usize  = 0;
    for (i < 9) {
        val text:      str = ut_cc3(?alloc, head, " ", bodies[i]);
        val debug_v:   i32 = ut_pipeline_verdict(?alloc, text, pipeline.OPT_DEBUG);
        val release_v: i32 = ut_pipeline_verdict(?alloc, text, pipeline.OPT_RELEASE);
        str_free(?alloc, text);
        if (debug_v != want[i]) {
            print.printf("record-secrecy: debug verdict {} for fixture {}\n", debug_v, i);
            ret 2;
        }
        if (release_v != want[i]) {
            print.printf("record-secrecy: release verdict {} for fixture {}\n", release_v, i);
            ret 3;
        }
        i = i + 1;
    }
    ret 0;
}

#[testing]
fun ut_record_secrecy_program() str {
    ret "rec S { d: u64; p: ^u64; }\nrec P { d: u64; p: u64; }\n#[noinline] fun take_s(v: S) u64 { if (v.d == 1) { ret (v.p):>u64; } ret 0; }\n#[noinline] fun take_p(v: P) u64 { if (v.d == 1) { ret v.p; } ret 0; }\n#[noinline] fun give_s(x: ^u64) S { var r: S; r.d = 1; r.p = x; ret r; }\n#[noinline] fun give_p(x: u64) P { var r: P; r.d = 1; r.p = x; ret r; }\nfun call_s(x: ^u64) u64 { ret take_s(give_s(x)); }\nfun call_p(x: u64) u64 { ret take_p(give_p(x)); }\n";
}

# counts the argument moves of a vreg into a physical register (those ahead of a block's last call) in the function
# whose name ends with `suffix`, and how many of those vregs are secret; also whether any conditional branch in it
# reads a secret vreg. a function without a call has only return moves, which count as its argument moves here
#[testing]
fun ut_transport_moves(s: *session.Session, mm: *mir.MirModule, suffix: str, moves: *u32, secret: *u32, branch_secret: *bool) bool {
    var vregs: u32 = 0;
    ret ut_transport_moves_v(s, mm, suffix, moves, secret, branch_secret, ?vregs);
}

# the same, also counting the function's secret vregs of any role
#[testing]
fun ut_transport_moves_v(s: *session.Session, mm: *mir.MirModule, suffix: str, moves: *u32, secret: *u32, branch_secret: *bool, secret_vregs: *u32) bool {
    @moves         = 0;
    @secret        = 0;
    @branch_secret = false;
    @secret_vregs  = 0;
    var fi: u32 = 0;
    for (fi < mm.function_len) {
        val mf:   *mir.MirFunction = ?mm.functions[fi];
        val name: opt[str]         = intern.lookup(?s.interner, mf.name);
        if (sel name.none) {
            fi = fi + 1;
            cnt;
        }
        if (!ut_str_ends_with(name.some, suffix)) {
            fi = fi + 1;
            cnt;
        }
        var vi: u32 = 0;
        for (vi < mf.vreg_count) {
            if (mf.vregs[vi].secret) { @secret_vregs = @secret_vregs + 1; }
            vi = vi + 1;
        }
        var bi: u32 = 0;
        for (bi < mf.block_count) {
            val blk:       *mir.MirBlock = ?mf.blocks[bi];
            var last_call: u32           = 0;
            var has_call:  bool          = false;
            var ci:        u32           = 0;
            for (ci < blk.instr_count) {
                if (blk.instrs[ci].opcode == mir.MIR_CALL) {
                    last_call = ci;
                    has_call  = true;
                }
                ci = ci + 1;
            }
            var ii: u32 = 0;
            for (ii < blk.instr_count) {
                val mi: *mir.MirInstr = ?blk.instrs[ii];
                if (mi.opcode == mir.MIR_MOV && mi.operand_count >= 2
                    && mi.operands[0].kind == mir.MIR_OP_PREG && mi.operands[1].kind == mir.MIR_OP_VREG
                    && (!has_call || ii < last_call)) {
                    @moves = @moves + 1;
                    if (mf.vregs[mi.operands[1].vreg.n].secret) { @secret = @secret + 1; }
                }
                if (mi.opcode == mir.MIR_CBR || mir.is_fused_cbr(mi.opcode)) {
                    var k: u32 = 0;
                    for (k < mi.operand_count) {
                        if (mi.operands[k].kind == mir.MIR_OP_VREG && mf.vregs[mi.operands[k].vreg.n].secret) { @branch_secret = true; }
                        k = k + 1;
                    }
                }
                ii = ii + 1;
            }
            bi = bi + 1;
        }
        ret true;
    }
    ret false;
}

#[testing]
fun ut_record_secrecy_carriers(alloc: *A.Allocator, target_name: str, found: pipeline.OptLevel) i32 {
    val sr: res[session.Session, fail.Fail] = session.init(alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    val pr: res[project.Project, outcome.Fail] = ut_vec_lower_opt(?s, alloc, ut_record_secrecy_program(), target_name, found);
    if (sel pr.err) { ret 2; }
    var p: project.Project = pr.ok;
    fin { project.dnit_project(?p); }
    var bad: i32 = 0;
    var mi:  u32 = 0;
    for (mi < project.module_count(?p)) {
        val me: *project.ModuleEntry = project.module_at(?p, mi);
        if (me.ir_module == nil) {
            mi = mi + 1;
            cnt;
        }
        val mr: res[mir.MirModule, fail.Fail] = mirlower.lower_module(?p.target, me.ir_module, alloc, ?s.interner, ?s.sources, ?s.diags);
        if (sel mr.err) { ret 3; }
        var mm:     mir.MirModule = mr.ok;
        var moves:  u32           = 0;
        var secret: u32           = 0;
        var branch: bool          = false;
        # the secret argument and both carrier pieces of the secret-content record are secret at the call
        if (!ut_transport_moves(?s, ?mm, ".call_s", ?moves, ?secret, ?branch)) { ret 4; }
        if (moves < 3 || secret != moves) {
            print.printf("record-secrecy: call_s moved {} vregs, {} secret\n", moves, secret);
            bad = 5;
        }
        # the public record's carriers and the public argument stay public
        if (!ut_transport_moves(?s, ?mm, ".call_p", ?moves, ?secret, ?branch)) { ret 6; }
        if (secret != 0) {
            print.printf("record-secrecy: call_p moved {} vregs, {} secret\n", moves, secret);
            bad = 7;
        }
        # the returned carriers of a secret-content record are secret; a public record's are not
        if (!ut_transport_moves(?s, ?mm, ".give_s", ?moves, ?secret, ?branch)) { ret 8; }
        if (moves < 2 || secret != moves) {
            print.printf("record-secrecy: give_s moved {} vregs, {} secret\n", moves, secret);
            bad = 9;
        }
        if (!ut_transport_moves(?s, ?mm, ".give_p", ?moves, ?secret, ?branch)) { ret 10; }
        if (secret != 0)                                                       { bad = 11; }
        # reading the public field keeps its public provenance: the test on it never branches on a secret, while the
        # secret field's value still reaches the function as a secret vreg after the profile's own passes ran over
        # the by-value copy (release splits it into per-field slots and promotes them)
        var vregs: u32 = 0;
        if (!ut_transport_moves_v(?s, ?mm, ".take_s", ?moves, ?secret, ?branch, ?vregs)) { ret 12; }
        if (branch)                                                                      { bad = 13; }
        if (vregs == 0) {
            print.print("record-secrecy: take_s holds no secret vreg\n");
            bad = 16;
        }
        if (!ut_transport_moves_v(?s, ?mm, ".take_p", ?moves, ?secret, ?branch, ?vregs)) { ret 14; }
        if (branch || vregs != 0)                                                        { bad = 15; }
        mir.dnit_module(?mm);
        mi = mi + 1;
    }
    ret bad;
}

test secret_record__carriers_are_secret_on_x86_64_and_aarch64 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val x86: i32 = ut_record_secrecy_carriers(?alloc, "linux", pipeline.OPT_DEBUG);
    if (x86 != 0) { ret 20 + x86; }
    val arm: i32 = ut_record_secrecy_carriers(?alloc, "linux-arm64", pipeline.OPT_DEBUG);
    if (arm != 0) { ret 40 + arm; }
    val x86r: i32 = ut_record_secrecy_carriers(?alloc, "linux", pipeline.OPT_RELEASE);
    if (x86r != 0) { ret 60 + x86r; }
    val armr: i32 = ut_record_secrecy_carriers(?alloc, "linux-arm64", pipeline.OPT_RELEASE);
    if (armr != 0) { ret 80 + armr; }
    ret 0;
}

# secret content in an aggregate is a property of its bytes, not of the home that holds them
test secret_tag__transport_keeps_content_secrecy {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val head:   str    = "tag T: u8 { a; b: ^u64; } tag P: u8 { a; b: u64; } ";
    var bodies: [6]str = [6]str{
        "#[oblivious] #[noinline] fun c(v: ^T) ^T { val u: ^T = v; ret u; }",
        "#[oblivious] fun g(v: T) u64 { if (sel v.b) { ret (v.b):>u64; } ret 0; }",
        "#[oblivious] #[noinline] fun k(v: T) T { ret v; } #[oblivious] fun m() u64 { val t: T = T.b{5}; val u: T = k(t); if (sel u.b) { ret (u.b):>u64; } ret 0; }",
        "#[oblivious] fun q(v: P) u64 { if (sel v.b) { if (v.b > 3) { ret 1; } } ret 0; }",
        "#[oblivious] fun h(v: T) u64 { if (sel v.b) { if (v.b > 3) { ret 1; } } ret 0; }",
        "#[oblivious] fun x(v: T, p: *u8) u8 { if (sel v.b) { ret p[v.b]; } ret 0; }"
    };
    var want: [6]i32 = [6]i32{0, 0, 0, 0, 1, 1};
    var i:    usize  = 0;
    for (i < 6) {
        val text:      str = ut_cc3(?alloc, head, " ", bodies[i]);
        val debug_v:   i32 = ut_pipeline_verdict(?alloc, text, pipeline.OPT_DEBUG);
        val release_v: i32 = ut_pipeline_verdict(?alloc, text, pipeline.OPT_RELEASE);
        str_free(?alloc, text);
        if (debug_v != want[i]) {
            print.printf("tag-secrecy: debug verdict {} for fixture {}\n", debug_v, i);
            ret 2;
        }
        if (release_v != want[i]) {
            print.printf("tag-secrecy: release verdict {} for fixture {}\n", release_v, i);
            ret 3;
        }
        i = i + 1;
    }
    ret 0;
}

#[testing]
fun ut_l5_secrecy_program() str {
    ret "tag T: u8 { a; b: ^u64; }\ntag P: u8 { a; b: u64; }\n#[noinline] fun take_t(v: T) u64 { if (sel v.b) { ret (v.b):>u64; } ret 0; }\n#[noinline] fun take_p(v: P) u64 { if (sel v.b) { ret v.b; } ret 0; }\n#[noinline] fun give_t(x: ^u64) T { ret T.b{x}; }\n#[noinline] fun give_p(x: u64) P { ret P.b{x}; }\nfun call_t(x: ^u64) u64 { ret take_t(give_t(x)); }\nfun call_p(x: u64) u64 { ret take_p(give_p(x)); }\n";
}

#[testing]
fun ut_l5_secrecy_carriers(alloc: *A.Allocator, target_name: str) i32 {
    val sr: res[session.Session, fail.Fail] = session.init(alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    val pr: res[project.Project, outcome.Fail] = ut_vec_lower(?s, alloc, ut_l5_secrecy_program(), target_name);
    if (sel pr.err) { ret 2; }
    var p: project.Project = pr.ok;
    fin { project.dnit_project(?p); }
    var bad: i32 = 0;
    var mi:  u32 = 0;
    for (mi < project.module_count(?p)) {
        val me: *project.ModuleEntry = project.module_at(?p, mi);
        if (me.ir_module == nil) {
            mi = mi + 1;
            cnt;
        }
        val mr: res[mir.MirModule, fail.Fail] = mirlower.lower_module(?p.target, me.ir_module, alloc, ?s.interner, ?s.sources, ?s.diags);
        if (sel mr.err) { ret 3; }
        var mm:     mir.MirModule = mr.ok;
        var moves:  u32           = 0;
        var secret: u32           = 0;
        var branch: bool          = false;
        # the secret argument and both carrier pieces of the secret-payload tag are secret at the call
        if (!ut_transport_moves(?s, ?mm, ".call_t", ?moves, ?secret, ?branch)) { ret 4; }
        if (moves < 3 || secret != moves) {
            print.printf("tag-secrecy: call_t moved {} vregs, {} secret\n", moves, secret);
            bad = 5;
        }
        # the public tag's carriers and the public argument stay public
        if (!ut_transport_moves(?s, ?mm, ".call_p", ?moves, ?secret, ?branch)) { ret 6; }
        if (secret != 0) {
            print.printf("tag-secrecy: call_p moved {} vregs, {} secret\n", moves, secret);
            bad = 7;
        }
        # the returned carriers of a secret-payload tag are secret; a public tag's are not
        if (!ut_transport_moves(?s, ?mm, ".give_t", ?moves, ?secret, ?branch)) { ret 8; }
        if (moves < 2 || secret != moves) {
            print.printf("tag-secrecy: give_t moved {} vregs, {} secret\n", moves, secret);
            bad = 9;
        }
        if (!ut_transport_moves(?s, ?mm, ".give_p", ?moves, ?secret, ?branch)) { ret 10; }
        if (secret != 0)                                                       { bad = 11; }
        # extracting the public discriminator keeps its public provenance: the case test never branches on a secret
        if (!ut_transport_moves(?s, ?mm, ".take_t", ?moves, ?secret, ?branch)) { ret 12; }
        if (branch)                                                            { bad = 13; }
        if (!ut_transport_moves(?s, ?mm, ".take_p", ?moves, ?secret, ?branch)) { ret 14; }
        if (branch)                                                            { bad = 15; }
        mir.dnit_module(?mm);
        mi = mi + 1;
    }
    ret bad;
}

test secret_tag__carriers_are_secret_on_x86_64_and_aarch64 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val x86: i32 = ut_l5_secrecy_carriers(?alloc, "linux");
    if (x86 != 0) { ret 20 + x86; }
    val arm: i32 = ut_l5_secrecy_carriers(?alloc, "linux-arm64");
    if (arm != 0) { ret 40 + arm; }
    ret 0;
}

#[testing]
rec UtAsmFlagRow {
    head:    str;
    row:     str;
    refused: bool;
}

# secret flags survive a row that leaves them (a move, a partial writer on public operands,
# a push, a setcc, and each control transfer); a defining row on public operands clears
# them; a flag-writing row on a secret operand and a row whose flag effect is opaque taint them
#[testing]
val UT_ASM_FLAG_ROWS: [17]UtAsmFlagRow = [17]UtAsmFlagRow{
    UtAsmFlagRow{head: "mov rsi, {r}\n cmp rsi, 1\n ", row: "mov rbx, rdx", refused: true},
    UtAsmFlagRow{head: "mov rsi, {r}\n cmp rsi, 1\n ", row: "inc rbx", refused: true},
    UtAsmFlagRow{head: "mov rsi, {r}\n cmp rsi, 1\n ", row: "push rbx", refused: true},
    UtAsmFlagRow{head: "mov rsi, {r}\n cmp rsi, 1\n ", row: "setb bl", refused: true},
    UtAsmFlagRow{head: "mov rsi, {r}\n cmp rsi, 1\n ", row: "jmp 1f", refused: true},
    UtAsmFlagRow{head: "mov rsi, {r}\n cmp rsi, 1\n ", row: "call 1f", refused: true},
    UtAsmFlagRow{head: "mov rsi, {r}\n cmp rsi, 1\n ", row: "ret", refused: true},
    UtAsmFlagRow{head: "mov rsi, {r}\n cmp rsi, 1\n ", row: "hlt", refused: true},
    UtAsmFlagRow{head: "mov rsi, {r}\n cmp rsi, 1\n ", row: "add rbx, rdx", refused: false},
    UtAsmFlagRow{head: "mov rsi, {r}\n cmp rsi, 1\n ", row: "cmp rbx, rdx", refused: false},
    UtAsmFlagRow{head: "mov rsi, {r}\n cmp rsi, 1\n ", row: "neg rbx", refused: false},
    UtAsmFlagRow{head: "mov rsi, {r}\n cmp rsi, 1\n ", row: "cmpxchg rbx, rdx", refused: false},
    UtAsmFlagRow{head: "mov rax, {r}\n ", row: "add rax, rbx", refused: true},
    UtAsmFlagRow{head: "mov rax, {r}\n ", row: "inc rax", refused: true},
    UtAsmFlagRow{head: "mov rax, {r}\n ", row: "cmpxchg rbx, rax", refused: true},
    UtAsmFlagRow{head: "mov rax, {r}\n ", row: "popfq", refused: true},
    UtAsmFlagRow{head: "mov rax, {r}\n ", row: "syscall", refused: true}
};

test oblivious_asm__flag_taint {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var i: usize = 0;
    for (i < 17) {
        val row: *UtAsmFlagRow                = ?UT_ASM_FLAG_ROWS[i];
        val pr:  res[str, format.FormatError] = format.sprint(?alloc,
            "#[oblivious]\nfun f(k: ^u64) ^u64 {{ var r: ^u64 = k; asm x86_64 {{ {}{}\n jc 1f\n 1:\n nop }} ret r; }}\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 {{ ret 0; }}\n",
            row.head, row.row);
        if (sel pr.err) { ret 2; }
        var code: i32 = 0;
        if (row.refused) { code = ut_codegen_target_rejects(pr.ok, "linux", "branches on a secret value"); }
        or               { code = ut_codegen_target_ok(pr.ok, "linux"); }
        str_free(?alloc, pr.ok);
        if (code != 0) {
            print.printf("oblivious asm flag row {} `{}`: {}\n", i, row.row, code);
            ret (i::i32 + 1) * 100 + code;
        }
        i = i + 1;
    }
    ret 0;
}
