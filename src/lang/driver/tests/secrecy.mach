#[testing]
fun ut_codegen_target_rejects(src: str, target_name: str, needle: str) i32 {
    ret ut_codegen_profile_rejects(src, target_name, "", needle);
}

# an #[oblivious] provider body is expanded only into an #[oblivious] importer
test inline__oblivious_callee_stays_a_call_in_a_public_caller {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val initialized: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel initialized.err) { ret 2; }
    var s: session.Session = initialized.ok;
    fin { session.dnit(?s); }
    var names: [2]str = [2]str{"main.mach", "helper.mach"};
    var texts: [2]str;
    texts[0] = "use h: uniontest.helper;\npub fun open(v: ^i32) ^i32 { ret h.classified(v); }\n#[oblivious] pub fun closed(v: ^i32) ^i32 { ret h.classified(v); }\nfun main() i32 { ret 0; }\n";
    texts[1] = "#[oblivious] pub fun classified(v: ^i32) ^i32 { ret v + 1; }\n";
    val scaffold: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 2);
    if (sel scaffold.err) { ret 4; }
    val root: str = scaffold.ok;
    fin {
        fs.remove_all(?alloc, root);
        str_free(?alloc, root);
    }
    val lowered: res[project.Project, fail.Fail] = ut_inline_prepare(?s, root, 0);
    if (sel lowered.err) { ret 5; }
    var p: project.Project = lowered.ok;
    fin { project.dnit_project(?p); }
    val mid: session.ModuleId = ut_mid(?p, ?s, "uniontest.main");
    if (module.is_nil(mid)) { ret 6; }
    val m: *me_ir.Module = project.module_at(?p, mid::u32).ir_module;
    if (ut_inline_calls_of(?s, m, "uniontest.main.open") != 1) { ret 7; }
    val closed: *me_ir.Function = ut_inline_function(?s, m, "uniontest.main.closed");
    if (ut_inline_ops(closed, ir_instruction.OP_CALL) != 0) { ret 8; }
    var secret_add: bool = false;
    var ii:         u32  = 0;
    for (ii < closed.instr_len) {
        if (closed.instrs[ii].kind == ir_instruction.OP_ADD && closed.instrs[ii].secret) { secret_add = true; }
        ii = ii + 1;
    }
    if (!secret_add) { ret 9; }
    ret 0;
}

# the DIT refusal is a diagnostic on the store like any other backend
# refusal: the pass answers `reported` with no text of its own, and the store
# holds exactly one error located at the multiply (main.mach:3:9) that names
# the instruction set's DIT rows and the operating system
test secret_mul__dit_refusal_is_a_located_error {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "#[oblivious]\nfun f(a: ^u32, b: ^u32) ^u32 {\n    ret a * b;\n}\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { f(1, 2); ret 0; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str                             = root_r.ok;
    var tsel: manifest.Selectors              = ut_target_sel("bare-arm64");
    val pr:   res[project.Project, fail.Fail] = driver.build_project(?s, root, ?tsel);
    fs.remove_all(?alloc, root);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    var bad: i32            = 0;
    val se:  err[fail.Fail] = driver.run_sema_pass(?p);
    if (sel se.err) { bad = 2; }
    val le: err[fail.Fail] = driver.run_lower_pass(?p);
    if (sel le.err && bad == 0) { bad = 3; }
    val ce: err[fail.Fail] = driver.run_codegen_pass(?p);
    if (sel ce.ok) { bad = 4; }
    if (sel ce.err) {
        if (bad == 0) { bad = ut_dit_rejection_shape(?s, ce.err); }
    }

    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

#[testing]
fun ut_dit_rejection_shape(s: *session.Session, failure: fail.Fail) i32 {
    if (!fail.is_reported(failure)) { ret 5; }
    val carried: opt[str] = fail.text(failure);
    if (sel carried.some)                      { ret 6; }
    if (diagnostic.error_count(?s.diags) != 1) { ret 7; }
    val d: opt[*diagnostic.Diagnostic] = diagnostic.get(?s.diags, 0);
    if (sel d.none) { ret 8; }
    val found: *diagnostic.Diagnostic = d.some;
    if (!diagnostic_kind.is_error(found.kind))                                                                      { ret 9; }
    if (!ut_str_contains(found.message, "integer multiply whose timing is data-independent only under PSTATE.DIT")) { ret 10; }
    if (!ut_str_contains(found.message, "`aarch64` instruction set declares the multiply under that mode"))         { ret 11; }
    if (!ut_str_contains(found.message, "`freestanding` operating system declares no guarantee"))                   { ret 12; }
    if (lang_source.file_is_nil(found.loc.file))                                                                    { ret 13; }
    if (!ut_diag_located_at(s, "PSTATE.DIT", "main.mach", 3, 9))                                                    { ret 14; }
    ret 0;
}

test declassify__lowers_on_spirv_and_rv32 {
    var bad:    i32          = 0;
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    val ps: res[project.Project, fail.Fail] = ut_ct_edge_project(?s, ?alloc,
        "fun down(a: ^u32) u32 { ret a:>u32; }\nfun main() i32 { ret 0; }\n", "spv");
    if (sel ps.err) { bad = 1; }
    if (sel ps.ok) {
        var p: project.Project = ps.ok;
        if (ut_run_codegen_ok(?p) != 0) { bad = 1; }
        project.dnit_project(?p);
    }

    val pm: res[project.Project, fail.Fail] = ut_ct_edge_project(?s, ?alloc,
        "fun down(a: ^u32) u32 { ret a:>u32; }\nfun main() i32 { ret 0; }\n", "rv32s");
    if (sel pm.err) { bad = 1; }
    if (sel pm.ok) {
        var p2: project.Project = pm.ok;
        if (ut_run_codegen_ok(?p2) != 0) { bad = 1; }
        project.dnit_project(?p2);
    }

    session.dnit(?s);
    ret bad;
}

#[testing]
fun ut_count_op(p: *project.Project, kind: ir_instruction.InstrKind) u32 {
    var n:  u32 = 0;
    var ti: u32 = 0;
    for (ti < p.topo_len) {
        val m: *me_ir.Module = project.module_at(p, p.topo[ti]::u32).ir_module;
        if (m != nil) {
            var fi: u32 = 0;
            for (fi < m.function_len) {
                val fn: *me_ir.Function = ?m.functions[fi];
                var bi: u32             = 0;
                for (bi < fn.block_count) {
                    val blk: *me_ir.Block = ?fn.blocks[bi];
                    var ix:  u32          = 0;
                    for (ix < blk.instr_count) {
                        if ((?fn.instrs[ir_id.instruction_index(blk.instructions[ix])]).kind == kind) { n = n + 1; }
                        ix = ix + 1;
                    }
                    bi = bi + 1;
                }
                fi = fi + 1;
            }
        }
        ti = ti + 1;
    }
    ret n;
}

# a declassify lowers to a barrier, and the value past it is public: its multiply is an
# ordinary one, while the same multiply of the secret is still refused
test declassify__emits_a_barrier_that_is_not_retainted {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:  session.Session                 = sr.ok;
    val pr: res[project.Project, fail.Fail] = ut_vec_lower(?s, ?alloc,
        "fun f(a: ^u32) u32 { ret a:>u32; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { f(1); ret 0; }\n", "linux");
    if (sel pr.err) {
        session.dnit(?s);
        ret 2;
    }
    var p: project.Project = pr.ok;
    val n: u32             = ut_count_op(?p, ir_instruction.OP_DECLASSIFY);
    project.dnit_project(?p);
    session.dnit(?s);
    if (n == 0) { ret 3; }
    if (ut_vec_codegen_defined("fun f(a: ^u32) u32 { var x: ^u32 = a; ret (x:>u32) * (x:>u32); }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "declassified integer multiply", CODEGEN_CASE_DECLASSIFIED_MUL) != 0) { ret 4; }
    if (ut_codegen_target_rejects("#[oblivious]\nfun f(a: ^u32) ^u32 { var x: ^u32 = a; ret x * x; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "bare-arm64", "data-independent only under PSTATE.DIT") != 0) { ret 5; }
    ret 0;
}

# a secret vector multiply is gated where riscv64 scalarizes it and where x86_64 and
# aarch64 fuse a widening one; the public forms build
test secret_vector_mul__gated_when_scalarized_or_widened {
    val secret: str = "#[oblivious]\nfun f(a: ^i16x4, b: ^i16x4) ^i32x4 { ret a::^i32x4 * b::^i32x4; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n";
    val public: str = "fun f(a: i16x4, b: i16x4) i32x4 { ret a::i32x4 * b::i32x4; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n";
    if (ut_codegen_target_rejects("#[oblivious]\nfun f(a: ^i16x8, b: ^i16x8) ^i16x8 { ret a * b; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "linux-riscv64", "variable-latency integer multiply") != 0) { ret 1; }
    if (ut_codegen_target_rejects("fun f(a: i16x8, b: i16x8) i16x8 { ret a * b; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "linux-riscv64", "variable-latency integer multiply") == 0) { ret 2; }
    if (ut_codegen_target_ok("fun f(a: ^f32x4) f32x4 { ret a:>f32x4; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "linux-riscv64") != 0) { ret 3; }
    if (ut_codegen_target_rejects(secret, "linux", "variable-latency integer multiply") != 0)       { ret 4; }
    if (ut_codegen_target_rejects(secret, "linux-arm64", "variable-latency integer multiply") != 0) { ret 5; }
    if (ut_codegen_target_ok(public, "linux") != 0)                                                 { ret 6; }
    if (ut_codegen_target_ok(public, "linux-arm64") != 0)                                           { ret 7; }
    ret 0;
}

# a secret vector wider than one register keeps its taint on every piece it is
# split into: a widening multiply whose product is split into halves is
# still refused where the register-width one is, and lane-wise operations on
# secret pieces, joined across the call boundary, build. a secret the convention
# passes through memory arrives at a public address, and its bytes stay
# secret: a lane or a field of it used as an address is refused
test secret_wide_vector__keeps_its_taint_across_pieces {
    val w16: str = "#[oblivious]\nfun f(a: ^i16x8, b: ^i16x8) ^i32x8 { ret a::^i32x8 * b::^i32x8; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n";
    val w8:  str = "#[oblivious]\nfun f(a: ^u8x16, b: ^u8x16) ^u16x16 { ret a::^u16x16 * b::^u16x16; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n";
    val add: str = "#[oblivious]\nfun f(a: ^i32x9, b: ^i32x9) ^i32x9 { ret (a + b) ^ a; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n";
    if (ut_codegen_target_rejects(w16, "linux", "variable-latency integer multiply") != 0)       { ret 1; }
    if (ut_codegen_target_rejects(w16, "linux-arm64", "variable-latency integer multiply") != 0) { ret 2; }
    if (ut_codegen_target_rejects(w8, "linux", "variable-latency integer multiply") != 0)        { ret 3; }
    if (ut_codegen_target_rejects(w8, "linux-arm64", "variable-latency integer multiply") != 0)  { ret 4; }
    if (ut_codegen_target_ok(add, "linux") != 0)                                                 { ret 5; }
    if (ut_codegen_target_ok(add, "linux-arm64") != 0)                                           { ret 6; }
    val lane:  str = "#[oblivious]\nfun f(a: ^u32x8) ^u32x8 { var r: ^u64 = a[3]::^u64; asm x86_64 { mov rax, {r}\n mov rbx, [rax] } ret a; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n";
    val field: str = "rec Big { a: u64; b: u64; c: u64; d: u64; e: u64; }\n#[oblivious]\nfun f(a: ^Big) ^Big { var r: ^u64 = a.c; asm x86_64 { mov rax, {r}\n mov rbx, [rax] } ret a; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n";
    if (ut_codegen_target_rejects(lane, "linux", "addresses memory with a secret value") != 0)  { ret 7; }
    if (ut_codegen_target_rejects(field, "linux", "addresses memory with a secret value") != 0) { ret 8; }
    ret 0;
}

test secret_local__is_zeroized {
    var bad: i32 = 0;
    if (!ut_sema_clean("fun f() i32 { var k: ^[4]u8; ret 0; }\nfun main() i32 { ret 0; }\n")) { bad = 1; }
    if (ut_vec_codegen_defined("fun f() { var k: ^[4]u8; var s: ^u32; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { f(); ret 0; }\n",
        "secret local zeroization", CODEGEN_CASE_MEMZERO) != 0) { bad = 1; }
    ret bad;
}

# an aggregate declassify is one barrier; a record, an array and a nested record lower, and a
# record and a record holding welded pointers build on every native backend
test declassify__aggregate_lowers_on_every_backend {
    val rec_new:  str = "rec K { d: [4]u8; }\nfun down(a: ^K) K { ret a:>K; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n";
    val arr_new:  str = "fun down(a: ^[4]u32) [4]u32 { ret a:>[4]u32; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n";
    val nest_new: str = "rec Inner { x: u32; y: u32; }\nrec Outer { a: [2]Inner; b: u8; }\nfun down(a: ^Outer) Outer { ret a:>Outer; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n";
    val mixed:    str = "rec Inner { x: u32; y: u32; }\nrec M { n: Inner; p: *u8; q: ^*u8; v: u64; }\nfun down(a: ^M) M { ret a:>M; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n";
    if (ut_lower_ok(arr_new) != 0)         { ret 1; }
    if (ut_lower_ok(nest_new) != 0)        { ret 2; }
    if (ut_count_declassify(rec_new) != 1) { ret 3; }
    var targets: [3]str = [3]str{"linux", "linux-arm64", "linux-riscv64"};
    var ti:      usize  = 0;
    for (ti < 3) {
        if (ut_codegen_target_ok(rec_new, targets[ti]) != 0) { ret 10 + ti::i32; }
        if (ut_codegen_target_ok(mixed, targets[ti]) != 0)   { ret 20 + ti::i32; }
        ti = ti + 1;
    }
    ret 0;
}

#[testing]
fun ut_count_declassify(src: str) u32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 0; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 0; }
    var s:  session.Session                 = sr.ok;
    val pr: res[project.Project, fail.Fail] = ut_vec_lower(?s, ?alloc, src, "linux");
    if (sel pr.err) {
        session.dnit(?s);
        ret 0;
    }
    var p: project.Project = pr.ok;
    val n: u32             = ut_count_op(?p, ir_instruction.OP_DECLASSIFY);
    project.dnit_project(?p);
    session.dnit(?s);
    ret n;
}

#[testing]
val UT_AGG_SEL_REC: u32 = 0;
#[testing]
val UT_AGG_SEL_ARR: u32 = 1;
#[testing]
val UT_AGG_SEL_MIX: u32 = 2;

#[testing]
fun ut_agg_strip_src(buf: *u8) usize {
    var w: usize = 0;
    w      = ut_app(buf, w, "rec K { a: u32; b: u32; }\n");
    w      = ut_app(buf, w, "rec Inner { x: u32; y: u32; }\n");
    w      = ut_app(buf, w, "rec M { n: Inner; p: *u8; q: ^*u8; v: u32; }\n");
    w      = ut_app(buf, w, "#[symbol(\"_start\")]\n");
    w      = ut_app(buf, w, "fun probe(pick: i32, v: i32) i32 {\n");
    w      = ut_app(buf, w, "    val v0: u32 = v::u32;\n");
    w      = ut_app(buf, w, "    val v1: u32 = (v + 1)::u32;\n");
    w      = ut_app(buf, w, "    val v2: u32 = (v + 2)::u32;\n");
    w      = ut_app(buf, w, "    val v3: u32 = (v + 3)::u32;\n");
    w      = ut_app(buf, w, "    var k: ^K;\n");
    w      = ut_app(buf, w, "    k.a = v0;\n");
    w      = ut_app(buf, w, "    k.b = v1;\n");
    w      = ut_app(buf, w, "    if (pick == 0) { ret sum_k(k)::i32; }\n");
    w      = ut_app(buf, w, "    var arr: ^[4]u32;\n");
    w      = ut_app(buf, w, "    arr[0] = v0; arr[1] = v1; arr[2] = v2; arr[3] = v3;\n");
    w      = ut_app(buf, w, "    if (pick == 1) { ret sum_arr(arr)::i32; }\n");
    w      = ut_app(buf, w, "    var b1: u8 = 7;\n");
    w      = ut_app(buf, w, "    var b2: u8 = 9;\n");
    w      = ut_app(buf, w, "    var m: ^M;\n");
    w      = ut_app(buf, w, "    m.n.x = v0;\n");
    w      = ut_app(buf, w, "    m.n.y = v1;\n");
    w      = ut_app(buf, w, "    m.p = ?b1;\n");
    w      = ut_app(buf, w, "    m.q = ?b2;\n");
    w      = ut_app(buf, w, "    m.v = 5;\n");
    w      = ut_app(buf, w, "    if (pick == 2) { ret sum_m(m)::i32; }\n");
    w      = ut_app(buf, w, "    ret 0 - 1;\n");
    w      = ut_app(buf, w, "}\n");
    w      = ut_app(buf, w, "fun sum_k(s: ^K) u32 { val p: K = s:>K; ret p.a + p.b; }\n");
    w      = ut_app(buf, w, "fun sum_arr(s: ^[4]u32) u32 { val p: [4]u32 = s:>[4]u32; ret p[0] + p[1] + p[2] + p[3]; }\n");
    w      = ut_app(buf, w, "fun sum_m(s: ^M) u32 {\n");
    w      = ut_app(buf, w, "    val p: M = s:>M;\n");
    w      = ut_app(buf, w, "    var acc: u32 = p.n.x + p.n.y + p.v;\n");
    w      = ut_app(buf, w, "    acc = acc + (@p.p)::u32;\n");
    w      = ut_app(buf, w, "    val qq: *u8 = p.q:>*u8;\n");
    w      = ut_app(buf, w, "    ret acc + (@qq)::u32 * 10;\n");
    w      = ut_app(buf, w, "}\n");
    buf[w] = 0;
    ret w;
}

#[testing]
fun ut_agg_strip_run(mem: *u8, pick: u32, v: u32, out: *u32) bool {
    var args: [2]u32;
    args[0] = pick;
    args[1] = v;
    var lo:    u32 = 0;
    var hi:    u32 = 0;
    var steps: u32 = 0;
    if (!ut_rv32_run(mem, 0, ?args[0], 2, ?lo, ?hi, ?steps)) { ret false; }
    @out = lo;
    ret true;
}

test declassify__aggregate_executes_on_an_rv32_core {
    var bad:    i32          = 0;
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    val bufr: res[*u8, A.Error] = A.allocate[u8](?alloc, 8192);
    if (sel bufr.err) {
        session.dnit(?s);
        ret 1;
    }
    val srcbuf: *u8 = bufr.ok;
    ut_agg_strip_src(srcbuf);

    val memr: res[*u8, A.Error] = A.zallocate[u8](?alloc, UT_RV32_MEM);
    if (sel memr.err) {
        A.deallocate[u8](?alloc, srcbuf, 8192);
        session.dnit(?s);
        ret 1;
    }
    val mem: *u8 = memr.ok;

    var ilen: u32 = 0;
    if (!ut_rv32_build_linked(?s, ?alloc, srcbuf::str, "rv32", mem, ?ilen)) { bad = 1; }
    or {
        var got: u32 = 0;
        if (!ut_agg_strip_run(mem, UT_AGG_SEL_REC, 100, ?got)) { bad = bad + 2; }
        or (got != 201)                                        { bad = bad + 2; }
        if (!ut_agg_strip_run(mem, UT_AGG_SEL_ARR, 100, ?got)) { bad = bad + 8; }
        or (got != 406)                                        { bad = bad + 8; }
        if (!ut_agg_strip_run(mem, UT_AGG_SEL_MIX, 100, ?got)) { bad = bad + 16; }
        or (got != 303)                                        { bad = bad + 16; }
    }

    A.deallocate[u8](?alloc, mem, UT_RV32_MEM);
    A.deallocate[u8](?alloc, srcbuf, 8192);
    session.dnit(?s);
    ret bad;
}

test oblivious_asm__validated_not_refused {
    var bad: i32 = 0;

    if (ut_codegen_target_ok("#[oblivious]\nfun f(x: ^u64) ^u64 { var r: ^u64 = x; asm x86_64 { nop } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n", "linux") != 0) { bad = 1; }

    if (ut_codegen_target_ok("#[oblivious]\nfun f(x: ^u64) ^u64 { var r: ^u64 = x; asm x86_64 { jmp 1f\n1:\n nop } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n", "linux") != 0) { bad = 1; }

    if (ut_codegen_target_ok("#[oblivious]\nfun f(p: *i64) i64 { var v: i64 = 1; asm x86_64 { mov rax, {v}\n lock xadd {p}, rax\n mov {v}, rax } ret v; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n", "linux") != 0) { bad = 1; }

    if (ut_codegen_target_ok("#[oblivious]\nfun ll(p: *i64) i64 { var v: i64 = 0; asm aarch64 { ldr x12, {p}\n ldaxr x9, [x12]\n stlxr w10, x9, [x12]\n cbnz w10, 1f\n1:\n nop } ret v; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n", "linux-arm64") != 0) { bad = 1; }

    # the compared registers are defined inside the block: at o0 the secret
    # parameter lives in whichever register the allocator chose, and the
    # post-expansion walk sees a compare on it for what it is
    if (ut_codegen_target_ok("#[oblivious]\nfun f(x: ^u64) ^u64 { var r: ^u64 = x; asm x86_64 { mov rax, 1\n mov rcx, 2\n cmp rax, rcx\n je 1f\n1:\n nop } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n", "linux") != 0) { bad = 1; }

    if (ut_codegen_target_ok("#[oblivious]\nfun f(x: ^u64) ^u64 { var r: ^u64 = x; asm x86_64 { cmp rax, rbx\n setb bl\n mov rcx, [rbx] } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n", "linux") != 0) { bad = 1; }

    ret bad;
}

# a codegen refusal of the program is a diagnostic on the store, not text on
# the failure: the pass answers `reported`, the store holds one located error
# at the asm block, and the failure itself carries no message
test oblivious_asm__refusal_is_a_located_error {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "#[oblivious]\nfun f(k: *^u64) ^u64 {\n    var r: ^u64 = @k;\n    asm x86_64 {\n        mov rax, {r}\n        inc rax\n        je 1f\n    1:\n        nop\n    }\n    ret r;\n}\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str                             = root_r.ok;
    var tsel: manifest.Selectors              = ut_target_sel("linux");
    val pr:   res[project.Project, fail.Fail] = driver.build_project(?s, root, ?tsel);
    fs.remove_all(?alloc, root);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    var bad: i32            = 0;
    val se:  err[fail.Fail] = driver.run_sema_pass(?p);
    if (sel se.err) { bad = 2; }
    val le: err[fail.Fail] = driver.run_lower_pass(?p);
    if (sel le.err && bad == 0) { bad = 3; }
    val ce: err[fail.Fail] = driver.run_codegen_pass(?p);
    if (sel ce.ok) { bad = 4; }
    if (sel ce.err) {
        if (bad == 0) { bad = ut_codegen_rejection_shape(?s, ce.err); }
    }

    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

# the failure reports nothing of its own and the store carries exactly one
# error, located at the asm block (main.mach:4:5); 0 when so
#[testing]
fun ut_codegen_rejection_shape(s: *session.Session, failure: fail.Fail) i32 {
    if (!fail.is_reported(failure)) { ret 5; }
    val carried: opt[str] = fail.text(failure);
    if (sel carried.some)                      { ret 6; }
    if (diagnostic.error_count(?s.diags) != 1) { ret 7; }
    val d: opt[*diagnostic.Diagnostic] = diagnostic.get(?s.diags, 0);
    if (sel d.none) { ret 8; }
    val found: *diagnostic.Diagnostic = d.some;
    if (!diagnostic_kind.is_error(found.kind))                                       { ret 9; }
    if (!ut_str_contains(found.message, "branches on a secret value"))               { ret 10; }
    if (!ut_str_contains(found.message, "#[oblivious] function `uniontest.main.f`")) { ret 11; }
    if (lang_source.file_is_nil(found.loc.file))                                     { ret 12; }
    if (!ut_diag_located_at(s, "branches on a secret value", "main.mach", 4, 5))     { ret 13; }
    ret 0;
}

# a branch on secret flags, a flag-setting rmw on a secret, a setcc address, a raw payload,
# a secret branch or division on each isa, and a secret parameter bound straight into the block
test oblivious_asm__leaks_refused {
    var bad: i32 = 0;

    if (ut_codegen_target_rejects("#[oblivious]\nfun f(k: ^u64) ^u64 { var r: ^u64 = k; asm x86_64 { cmp {r}, rbx\n je 1f\n1:\n nop } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "linux", "its condition rides the flags register") != 0) { bad = 1; }
    if (ut_codegen_target_rejects("#[oblivious]\nfun f(k: ^u64) ^u64 { var r: ^u64 = k; asm x86_64 { mov rax, {r}\n cmpxchg [rbx], rcx\n je 1f\n1:\n nop } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "linux", "branches on a secret value") != 0) { bad = 2; }
    if (ut_codegen_target_rejects("#[oblivious]\nfun f(k: ^u64) ^u64 { var r: ^u64 = k; asm x86_64 { mov rax, {r}\n cmp rax, 1\n setb bl\n mov rcx, [rbx] } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "linux", "addresses memory with a secret value") != 0) { bad = 3; }

    if (ut_codegen_target_rejects("#[oblivious]\nfun f(x: ^u64) ^u64 { var r: ^u64 = x; asm x86_64 { .byte 0x90 } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "linux", "its payload can encode any instruction") != 0) { bad = 4; }
    if (ut_codegen_target_rejects("#[oblivious]\nfun f(x: ^u64) ^u64 { var r: ^u64 = x; asm aarch64 { .word 0xd503201f } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "linux-arm64", "its payload can encode any instruction") != 0) { bad = 5; }
    if (ut_codegen_target_rejects("#[oblivious]\nfun f(x: ^u64) ^u64 { var r: ^u64 = x; asm riscv64 { .quad 0x0000001300000013 } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "linux-riscv64", "its payload can encode any instruction") != 0) { bad = 6; }

    if (ut_codegen_target_rejects("#[oblivious]\nfun bc(k: ^u64) ^u64 { var r: ^u64 = k; asm aarch64 { ldr x9, {r}\n cmp x9, x1\n b.eq 1f\n1:\n nop } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "linux-arm64", "its condition rides the flags register") != 0) { bad = 7; }
    if (ut_codegen_target_rejects("#[oblivious]\nfun f(k: ^u64) ^u64 { var r: ^u64 = k; asm aarch64 { ldr x9, {r}\n cbnz x9, 1f\n1:\n nop } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "linux-arm64", "branches on a secret value inside an inline-asm block") != 0) { bad = 8; }
    if (ut_codegen_target_rejects("#[oblivious]\nfun f(k: ^u64) ^u64 { var r: ^u64 = k; asm riscv64 { ld a0, {r}\n div a1, a0, a0\n nop } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "linux-riscv64", "uses a secret value in a variable-latency integer divide or remainder") != 0) { bad = 9; }

    if (ut_codegen_target_rejects("#[oblivious]\nfun f(k: ^u64) ^u64 { asm x86_64 { mov rax, {k}\n inc rax\n je 1f\n1:\n nop } ret k; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "linux", "branches on a secret value") != 0) { bad = 10; }
    if (ut_codegen_target_ok("#[oblivious]\nfun f(k: u64) u64 { asm x86_64 { mov rax, {k}\n inc rax\n je 1f\n1:\n nop } ret k; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n", "linux") != 0) { bad = 11; }

    ret bad;
}

# the aes rounds and the carry-less multiplies run in data-independent time, so
# an #[oblivious] body may carry a secret through them; the result is still a
# secret, so an address built from it is refused
test oblivious_asm__admits_the_aes_and_carry_less_multiply_rows {
    var bad: i32 = 0;
    val x86: str = "#[oblivious]\n#[extensions(aes, pclmul, sse41)]\nfun f(p: *^u8) *^u8 { var q: *^u8 = p; asm x86_64 { mov rax, {q}\n movdqu xmm0, [rax]\n movdqu xmm1, [rax + 16]\n aesenc xmm1, xmm0\n aesenclast xmm1, xmm0\n aesdec xmm1, xmm0\n aesdeclast xmm1, xmm0\n aesimc xmm2, xmm1\n aeskeygenassist xmm3, xmm2, 0x1b\n pclmulqdq xmm3, xmm0, 0x11\n movdqu [rax], xmm3 } ret q; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n";
    if (ut_codegen_target_ok(x86, "linux") != 0) { bad = bad + 1; }
    val x86_leak: str = "#[oblivious]\n#[extensions(aes, pclmul, sse41)]\nfun f(p: *^u8) *^u8 { var q: *^u8 = p; asm x86_64 { mov rax, {q}\n movdqu xmm0, [rax]\n aesenc xmm1, xmm0\n pclmulqdq xmm1, xmm0, 0\n pextrd ecx, xmm1, 0\n mov rdx, [rcx] } ret q; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n";
    if (ut_codegen_target_rejects(x86_leak, "linux", "addresses memory with a secret value") != 0) { bad = bad + 2; }

    val arm: str = "#[oblivious]\n#[extensions(aes, pmull)]\nfun f(p: *^u8) *^u8 { var q: *^u8 = p; asm aarch64 { ldr x0, {q}\n ld1 {v0.16b}, [x0]\n aese v1.16b, v0.16b\n aesmc v1.16b, v1.16b\n aesd v1.16b, v0.16b\n aesimc v1.16b, v1.16b\n pmull v2.1q, v1.1d, v0.1d\n pmull2 v3.1q, v1.2d, v0.2d\n eor v2.16b, v2.16b, v3.16b\n st1 {v2.16b}, [x0] } ret q; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n";
    if (ut_codegen_target_ok(arm, "linux-arm64") != 0) { bad = bad + 4; }
    ret bad;
}

#[testing]
rec UtAsmCase {
    target: str;
    src:    str;
    needle: str;
}

# binding a secret is not an address; a pointer to a secret is a public address, as a
# parameter or a local, on each isa; a secret value is a secret address whatever
# it points at, including the secret pointer `^*u32` and a segment base
#[testing]
val UT_ASM_ADDRESSES: [11]UtAsmCase = [11]UtAsmCase{
    UtAsmCase{target: "linux", src: "#[oblivious]\nfun f(k: ^u64) ^u64 { var r: ^u64 = k; asm x86_64 { mov rax, {r} } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n", needle: ""},
    UtAsmCase{target: "linux", src: "#[oblivious]\nfun f(state: *^u32) { asm x86_64 { mov rax, {state}\n mov ecx, [rax]\n add ecx, 1\n mov [rax], ecx } }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n", needle: ""},
    UtAsmCase{target: "linux", src: "#[oblivious]\nfun f(state: *^u32, block: *^u8) { asm x86_64 { mov rax, {state}\n mov rcx, {block}\n movdqu xmm1, [rax]\n movdqu xmm2, [rax + 16]\n movdqu xmm0, [rcx]\n paddd xmm1, xmm0\n pxor xmm2, xmm0\n movdqu [rax], xmm1\n movdqu [rax + 16], xmm2 } }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n", needle: ""},
    UtAsmCase{target: "linux-arm64", src: "#[oblivious]\nfun f(state: *^u32) { asm aarch64 { ldr x0, {state}\n ldr w1, [x0]\n add w1, w1, 1\n str w1, [x0] } }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n", needle: ""},
    UtAsmCase{target: "linux-riscv64", src: "#[oblivious]\nfun f(state: *^u32) { asm riscv64 { ld a0, {state}\n lw a1, 0(a0)\n addi a1, a1, 1\n sw a1, 0(a0) } }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n", needle: ""},
    UtAsmCase{target: "linux", src: "#[oblivious]\nfun f(state: *^u32) { var p: *^u32 = state; asm x86_64 { mov rax, {p}\n mov ecx, [rax]\n mov [rax], ecx } }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n", needle: ""},
    UtAsmCase{target: "linux", src: "#[oblivious]\nfun f(k: ^u64) ^u64 { var r: ^u64 = k; asm x86_64 { mov rax, {r}\n mov rbx, [rax] } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n", needle: "addresses memory with a secret value"},
    UtAsmCase{target: "linux", src: "#[oblivious]\nfun f(k: ^u64) { asm x86_64 { mov rax, {k}\n mov ecx, [rax] } }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n", needle: "addresses memory with a secret value"},
    UtAsmCase{target: "linux", src: "#[oblivious]\nfun f(q: ^*u32) { asm x86_64 { mov rax, {q}\n mov ecx, [rax] } }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n", needle: "addresses memory with a secret value"},
    UtAsmCase{target: "linux", src: "#[oblivious]\n#[extensions(fsgsbase)]\nfun f(q: ^*u32) { asm x86_64 { mov rax, {q}\n wrgsbase rax } }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n", needle: "installs a secret value as an address base"},
    UtAsmCase{target: "linux-arm64", src: "#[oblivious]\nfun f(q: ^*u32) { asm aarch64 { ldr x0, {q}\n ldr w1, [x0] } }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n", needle: "addresses memory with a secret value"}
};

# 0 when every case builds, or is refused naming its needle
#[testing]
fun ut_asm_cases(cases: *UtAsmCase, len: usize) i32 {
    var i: usize = 0;
    for (i < len) {
        val c:    *UtAsmCase = ?cases[i];
        var code: i32        = 0;
        if (str_len(c.needle) == 0) { code = ut_codegen_target_ok(c.src, c.target); }
        or                          { code = ut_codegen_target_rejects(c.src, c.target, c.needle); }
        if (code != 0) {
            print.printf("oblivious asm case {} on {}: {}\n", i, c.target, code);
            ret (i::i32 + 1) * 100 + code;
        }
        i = i + 1;
    }
    ret 0;
}

test oblivious_asm__secret_address {
    ret ut_asm_cases(?UT_ASM_ADDRESSES[0], 11);
}

# a load through `*^T` taints its destination: a branch or an address on the loaded value
# is refused; a store of a public value through the pointer is not, and neither is a store
# of the loaded secret through a public pointer, inline asm being a trusted crossing
test oblivious_asm__load_through_pointer_to_secret_taints {
    var bad: i32 = 0;

    if (ut_codegen_target_rejects("#[oblivious]\nfun f(p: *^u32) { asm x86_64 { mov rax, {p}\n mov ecx, [rax]\n cmp ecx, 1\n je 1f\n1:\n nop } }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "linux", "branches on a secret value") != 0) { bad = bad + 1; }
    if (ut_codegen_target_rejects("#[oblivious]\nfun f(p: *^u64) { asm x86_64 { mov rax, {p}\n mov rcx, [rax]\n mov rdx, [rcx] } }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "linux", "addresses memory with a secret value") != 0) { bad = bad + 2; }
    if (ut_codegen_target_rejects("#[oblivious]\nfun f(p: *^u32) { asm aarch64 { ldr x0, {p}\n ldr w1, [x0]\n cbnz w1, 1f\n1:\n nop } }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "linux-arm64", "branches on a secret value") != 0) { bad = bad + 4; }
    if (ut_codegen_target_rejects("#[oblivious]\nfun f(p: *^u32) { asm riscv64 { ld a0, {p}\n lw a1, 0(a0)\n beq a1, a2, 1f\n1:\n nop } }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "linux-riscv64", "branches on a secret value") != 0) { bad = bad + 8; }

    if (ut_codegen_target_ok("#[oblivious]\nfun f(p: *^u32) { asm x86_64 { mov rax, {p}\n mov dword [rax], 7 } }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n", "linux") != 0)                                      { bad = bad + 16; }
    if (ut_codegen_target_ok("#[oblivious]\nfun f(p: *^u32, q: *u32) { asm x86_64 { mov rax, {p}\n mov rbx, {q}\n mov ecx, [rax]\n mov [rbx], ecx } }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n", "linux") != 0) { bad = bad + 32; }

    ret bad;
}

# secret content in an aggregate is a property of its bytes, not of the home that holds them
test secret_record__transport_keeps_content_secrecy {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val head:   str    = "rec Rec { a: u64; b: u64; } rec S { d: u64; p: ^u64; } rec P { d: u64; p: u64; } ";
    var bodies: [9]str = [9]str{
        "#[oblivious] fun f(v: ^Rec) u64 { ret (v.a):>u64; }",
        "#[oblivious] #[noinline] fun c(v: ^Rec) ^Rec { val u: ^Rec = v; ret u; }",
        "#[oblivious] #[noinline] fun mk() ^Rec { var r: ^Rec; ret r; } #[oblivious] fun use() u64 { val r: ^Rec = mk(); ret (r.a):>u64; }",
        "#[oblivious] fun g(v: S) u64 { ret (v.p):>u64; }",
        "#[oblivious] #[noinline] fun k(v: S) S { ret v; } #[oblivious] fun m() u64 { var t: S; t.d = 1; t.p = 5; val u: S = k(t); ret (u.p):>u64; }",
        "#[oblivious] fun q(v: P) u64 { if (v.p > 3) { ret 1; } ret 0; }",
        "#[oblivious] fun d(v: S) u64 { if (v.d > 3) { ret 1; } ret 0; }",
        "#[oblivious] fun h(v: S) u64 { if (v.p > 3) { ret 1; } ret 0; }",
        "#[oblivious] fun x(v: S, p: *u8) u8 { ret p[v.p]; }"
    };
    var want: [9]i32 = [9]i32{0, 0, 0, 0, 0, 0, 0, 1, 1};
    var i:    usize  = 0;
    for (i < 9) {
        val text:      str = ut_cc3(?alloc, head, " ", bodies[i]);
        val debug_v:   i32 = ut_pipeline_verdict(?alloc, text, pipeline.OPT_DEBUG);
        val release_v: i32 = ut_pipeline_verdict(?alloc, text, pipeline.OPT_RELEASE);
        str_free(?alloc, text);
        if (debug_v != want[i]) {
            print.printf("record-secrecy: debug verdict {} for fixture {}\n", debug_v, i);
            ret 2;
        }
        if (release_v != want[i]) {
            print.printf("record-secrecy: release verdict {} for fixture {}\n", release_v, i);
            ret 3;
        }
        i = i + 1;
    }
    ret 0;
}

#[testing]
fun ut_record_secrecy_program() str {
    ret "rec S { d: u64; p: ^u64; }\nrec P { d: u64; p: u64; }\n#[noinline] fun take_s(v: S) u64 { if (v.d == 1) { ret (v.p):>u64; } ret 0; }\n#[noinline] fun take_p(v: P) u64 { if (v.d == 1) { ret v.p; } ret 0; }\n#[noinline] fun give_s(x: ^u64) S { var r: S; r.d = 1; r.p = x; ret r; }\n#[noinline] fun give_p(x: u64) P { var r: P; r.d = 1; r.p = x; ret r; }\nfun call_s(x: ^u64) u64 { ret take_s(give_s(x)); }\nfun call_p(x: u64) u64 { ret take_p(give_p(x)); }\n";
}

# counts the argument moves of a vreg into a physical register (those ahead of a block's last call) in the function
# whose name ends with `suffix`, and how many of those vregs are secret; also whether any conditional branch in it
# reads a secret vreg. a function without a call has only return moves, which count as its argument moves here
#[testing]
fun ut_transport_moves(s: *session.Session, mm: *lang_mir.MirModule, suffix: str, moves: *u32, secret: *u32, branch_secret: *bool) bool {
    var vregs: u32 = 0;
    ret ut_transport_moves_v(s, mm, suffix, moves, secret, branch_secret, ?vregs);
}

# the same, also counting the function's secret vregs of any role
#[testing]
fun ut_transport_moves_v(s: *session.Session, mm: *lang_mir.MirModule, suffix: str, moves: *u32, secret: *u32, branch_secret: *bool, secret_vregs: *u32) bool {
    @moves         = 0;
    @secret        = 0;
    @branch_secret = false;
    @secret_vregs  = 0;
    var fi: u32 = 0;
    for (fi < mm.function_len) {
        val mf:   *lang_mir.MirFunction = ?mm.functions[fi];
        val name: opt[str]              = intern.get(?s.interner, mf.name);
        if (sel name.none) {
            fi = fi + 1;
            cnt;
        }
        if (!ut_str_ends_with(name.some, suffix)) {
            fi = fi + 1;
            cnt;
        }
        var vi: u32 = 0;
        for (vi < mf.vreg_count) {
            if (mf.vregs[vi].secret) { @secret_vregs = @secret_vregs + 1; }
            vi = vi + 1;
        }
        var bi: u32 = 0;
        for (bi < mf.block_count) {
            val blk:       *lang_mir.MirBlock = ?mf.blocks[bi];
            var last_call: u32                = 0;
            var has_call:  bool               = false;
            var ci:        u32                = 0;
            for (ci < blk.instr_count) {
                if (blk.instrs[ci].opcode == lang_mir.MIR_CALL) {
                    last_call = ci;
                    has_call  = true;
                }
                ci = ci + 1;
            }
            var ii: u32 = 0;
            for (ii < blk.instr_count) {
                val mi: *lang_mir.MirInstr = ?blk.instrs[ii];
                if (mi.opcode == lang_mir.MIR_MOV && mi.operand_count >= 2
                    && mi.operands[0].kind == lang_mir.MIR_OP_PREG && mi.operands[1].kind == lang_mir.MIR_OP_VREG
                    && (!has_call || ii < last_call)) {
                    @moves = @moves + 1;
                    if (mf.vregs[mi.operands[1].vreg.n].secret) { @secret = @secret + 1; }
                }
                if (mi.opcode == lang_mir.MIR_CBR || lang_mir.is_fused_cbr(mi.opcode)) {
                    var k: u32 = 0;
                    for (k < mi.operand_count) {
                        if (mi.operands[k].kind == lang_mir.MIR_OP_VREG && mf.vregs[mi.operands[k].vreg.n].secret) { @branch_secret = true; }
                        k = k + 1;
                    }
                }
                ii = ii + 1;
            }
            bi = bi + 1;
        }
        ret true;
    }
    ret false;
}

#[testing]
fun ut_record_secrecy_carriers(alloc: *A.Allocator, target_name: str, found: pipeline.OptLevel) i32 {
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    val pr: res[project.Project, fail.Fail] = ut_vec_lower_opt(?s, alloc, ut_record_secrecy_program(), target_name, found);
    if (sel pr.err) { ret 2; }
    var p: project.Project = pr.ok;
    fin { project.dnit_project(?p); }
    var bad: i32 = 0;
    var mi:  u32 = 0;
    for (mi < project.module_count(?p)) {
        val me: *project.ModuleEntry = project.module_at(?p, mi);
        if (me.ir_module == nil) {
            mi = mi + 1;
            cnt;
        }
        val mr: res[lang_mir.MirModule, fail.Fail] = mir_lower.lower_module(?p.target, me.ir_module, alloc, ?s.interner, ?s.sources, ?s.diags);
        if (sel mr.err) { ret 3; }
        var mm:     lang_mir.MirModule = mr.ok;
        var moves:  u32                = 0;
        var secret: u32                = 0;
        var branch: bool               = false;
        # the secret argument and both carrier pieces of the secret-content record are secret at the call
        if (!ut_transport_moves(?s, ?mm, ".call_s", ?moves, ?secret, ?branch)) { ret 4; }
        if (moves < 3 || secret != moves) {
            print.printf("record-secrecy: call_s moved {} vregs, {} secret\n", moves, secret);
            bad = 5;
        }
        # the public record's carriers and the public argument stay public
        if (!ut_transport_moves(?s, ?mm, ".call_p", ?moves, ?secret, ?branch)) { ret 6; }
        if (secret != 0) {
            print.printf("record-secrecy: call_p moved {} vregs, {} secret\n", moves, secret);
            bad = 7;
        }
        # the returned carriers of a secret-content record are secret; a public record's are not
        if (!ut_transport_moves(?s, ?mm, ".give_s", ?moves, ?secret, ?branch)) { ret 8; }
        if (moves < 2 || secret != moves) {
            print.printf("record-secrecy: give_s moved {} vregs, {} secret\n", moves, secret);
            bad = 9;
        }
        if (!ut_transport_moves(?s, ?mm, ".give_p", ?moves, ?secret, ?branch)) { ret 10; }
        if (secret != 0)                                                       { bad = 11; }
        # reading the public field keeps its public provenance: the test on it never branches on a secret, while the
        # secret field's value still reaches the function as a secret vreg after the profile's own passes ran over
        # the by-value copy (release splits it into per-field slots and promotes them)
        var vregs: u32 = 0;
        if (!ut_transport_moves_v(?s, ?mm, ".take_s", ?moves, ?secret, ?branch, ?vregs)) { ret 12; }
        if (branch)                                                                      { bad = 13; }
        if (vregs == 0) {
            print.print("record-secrecy: take_s holds no secret vreg\n");
            bad = 16;
        }
        if (!ut_transport_moves_v(?s, ?mm, ".take_p", ?moves, ?secret, ?branch, ?vregs)) { ret 14; }
        if (branch || vregs != 0)                                                        { bad = 15; }
        lang_mir.dnit_module(?mm);
        mi = mi + 1;
    }
    ret bad;
}

test secret_record__carriers_are_secret_on_x86_64_and_aarch64 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val x86: i32 = ut_record_secrecy_carriers(?alloc, "linux", pipeline.OPT_DEBUG);
    if (x86 != 0) { ret 20 + x86; }
    val arm: i32 = ut_record_secrecy_carriers(?alloc, "linux-arm64", pipeline.OPT_DEBUG);
    if (arm != 0) { ret 40 + arm; }
    val x86r: i32 = ut_record_secrecy_carriers(?alloc, "linux", pipeline.OPT_RELEASE);
    if (x86r != 0) { ret 60 + x86r; }
    val armr: i32 = ut_record_secrecy_carriers(?alloc, "linux-arm64", pipeline.OPT_RELEASE);
    if (armr != 0) { ret 80 + armr; }
    ret 0;
}

# secret content in an aggregate is a property of its bytes, not of the home that holds them
test secret_tag__transport_keeps_content_secrecy {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val head:   str    = "tag T: u8 { a; b: ^u64; } tag P: u8 { a; b: u64; } ";
    var bodies: [6]str = [6]str{
        "#[oblivious] #[noinline] fun c(v: ^T) ^T { val u: ^T = v; ret u; }",
        "#[oblivious] fun g(v: T) u64 { if (sel v.b) { ret (v.b):>u64; } ret 0; }",
        "#[oblivious] #[noinline] fun k(v: T) T { ret v; } #[oblivious] fun m() u64 { val t: T = T.b{5}; val u: T = k(t); if (sel u.b) { ret (u.b):>u64; } ret 0; }",
        "#[oblivious] fun q(v: P) u64 { if (sel v.b) { if (v.b > 3) { ret 1; } } ret 0; }",
        "#[oblivious] fun h(v: T) u64 { if (sel v.b) { if (v.b > 3) { ret 1; } } ret 0; }",
        "#[oblivious] fun x(v: T, p: *u8) u8 { if (sel v.b) { ret p[v.b]; } ret 0; }"
    };
    var want: [6]i32 = [6]i32{0, 0, 0, 0, 1, 1};
    var i:    usize  = 0;
    for (i < 6) {
        val text:      str = ut_cc3(?alloc, head, " ", bodies[i]);
        val debug_v:   i32 = ut_pipeline_verdict(?alloc, text, pipeline.OPT_DEBUG);
        val release_v: i32 = ut_pipeline_verdict(?alloc, text, pipeline.OPT_RELEASE);
        str_free(?alloc, text);
        if (debug_v != want[i]) {
            print.printf("tag-secrecy: debug verdict {} for fixture {}\n", debug_v, i);
            ret 2;
        }
        if (release_v != want[i]) {
            print.printf("tag-secrecy: release verdict {} for fixture {}\n", release_v, i);
            ret 3;
        }
        i = i + 1;
    }
    ret 0;
}

#[testing]
fun ut_l5_secrecy_program() str {
    ret "tag T: u8 { a; b: ^u64; }\ntag P: u8 { a; b: u64; }\n#[noinline] fun take_t(v: T) u64 { if (sel v.b) { ret (v.b):>u64; } ret 0; }\n#[noinline] fun take_p(v: P) u64 { if (sel v.b) { ret v.b; } ret 0; }\n#[noinline] fun give_t(x: ^u64) T { ret T.b{x}; }\n#[noinline] fun give_p(x: u64) P { ret P.b{x}; }\nfun call_t(x: ^u64) u64 { ret take_t(give_t(x)); }\nfun call_p(x: u64) u64 { ret take_p(give_p(x)); }\n";
}

#[testing]
fun ut_l5_secrecy_carriers(alloc: *A.Allocator, target_name: str) i32 {
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    val pr: res[project.Project, fail.Fail] = ut_vec_lower(?s, alloc, ut_l5_secrecy_program(), target_name);
    if (sel pr.err) { ret 2; }
    var p: project.Project = pr.ok;
    fin { project.dnit_project(?p); }
    var bad: i32 = 0;
    var mi:  u32 = 0;
    for (mi < project.module_count(?p)) {
        val me: *project.ModuleEntry = project.module_at(?p, mi);
        if (me.ir_module == nil) {
            mi = mi + 1;
            cnt;
        }
        val mr: res[lang_mir.MirModule, fail.Fail] = mir_lower.lower_module(?p.target, me.ir_module, alloc, ?s.interner, ?s.sources, ?s.diags);
        if (sel mr.err) { ret 3; }
        var mm:     lang_mir.MirModule = mr.ok;
        var moves:  u32                = 0;
        var secret: u32                = 0;
        var branch: bool               = false;
        # the secret argument and both carrier pieces of the secret-payload tag are secret at the call
        if (!ut_transport_moves(?s, ?mm, ".call_t", ?moves, ?secret, ?branch)) { ret 4; }
        if (moves < 3 || secret != moves) {
            print.printf("tag-secrecy: call_t moved {} vregs, {} secret\n", moves, secret);
            bad = 5;
        }
        # the public tag's carriers and the public argument stay public
        if (!ut_transport_moves(?s, ?mm, ".call_p", ?moves, ?secret, ?branch)) { ret 6; }
        if (secret != 0) {
            print.printf("tag-secrecy: call_p moved {} vregs, {} secret\n", moves, secret);
            bad = 7;
        }
        # the returned carriers of a secret-payload tag are secret; a public tag's are not
        if (!ut_transport_moves(?s, ?mm, ".give_t", ?moves, ?secret, ?branch)) { ret 8; }
        if (moves < 2 || secret != moves) {
            print.printf("tag-secrecy: give_t moved {} vregs, {} secret\n", moves, secret);
            bad = 9;
        }
        if (!ut_transport_moves(?s, ?mm, ".give_p", ?moves, ?secret, ?branch)) { ret 10; }
        if (secret != 0)                                                       { bad = 11; }
        # extracting the public discriminator keeps its public provenance: the case test never branches on a secret
        if (!ut_transport_moves(?s, ?mm, ".take_t", ?moves, ?secret, ?branch)) { ret 12; }
        if (branch)                                                            { bad = 13; }
        if (!ut_transport_moves(?s, ?mm, ".take_p", ?moves, ?secret, ?branch)) { ret 14; }
        if (branch)                                                            { bad = 15; }
        lang_mir.dnit_module(?mm);
        mi = mi + 1;
    }
    ret bad;
}

test secret_tag__carriers_are_secret_on_x86_64_and_aarch64 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val x86: i32 = ut_l5_secrecy_carriers(?alloc, "linux");
    if (x86 != 0) { ret 20 + x86; }
    val arm: i32 = ut_l5_secrecy_carriers(?alloc, "linux-arm64");
    if (arm != 0) { ret 40 + arm; }
    ret 0;
}

#[testing]
rec UtAsmFlagRow {
    head:    str;
    row:     str;
    refused: bool;
}

# secret flags survive a row that leaves them (a move, a partial writer on public operands,
# a push, a setcc, and each control transfer); a defining row on public operands clears
# them; a flag-writing row on a secret operand and a row whose flag effect is opaque taint them
#[testing]
val UT_ASM_FLAG_ROWS: [17]UtAsmFlagRow = [17]UtAsmFlagRow{
    UtAsmFlagRow{head: "mov rsi, {r}\n cmp rsi, 1\n ", row: "mov rbx, rdx", refused: true},
    UtAsmFlagRow{head: "mov rsi, {r}\n cmp rsi, 1\n ", row: "inc rbx", refused: true},
    UtAsmFlagRow{head: "mov rsi, {r}\n cmp rsi, 1\n ", row: "push rbx", refused: true},
    UtAsmFlagRow{head: "mov rsi, {r}\n cmp rsi, 1\n ", row: "setb bl", refused: true},
    UtAsmFlagRow{head: "mov rsi, {r}\n cmp rsi, 1\n ", row: "jmp 1f", refused: true},
    UtAsmFlagRow{head: "mov rsi, {r}\n cmp rsi, 1\n ", row: "call 1f", refused: true},
    UtAsmFlagRow{head: "mov rsi, {r}\n cmp rsi, 1\n ", row: "ret", refused: true},
    UtAsmFlagRow{head: "mov rsi, {r}\n cmp rsi, 1\n ", row: "hlt", refused: true},
    UtAsmFlagRow{head: "mov rsi, {r}\n cmp rsi, 1\n ", row: "add rbx, rdx", refused: false},
    UtAsmFlagRow{head: "mov rsi, {r}\n cmp rsi, 1\n ", row: "cmp rbx, rdx", refused: false},
    UtAsmFlagRow{head: "mov rsi, {r}\n cmp rsi, 1\n ", row: "neg rbx", refused: false},
    UtAsmFlagRow{head: "mov rsi, {r}\n cmp rsi, 1\n ", row: "cmpxchg rbx, rdx", refused: false},
    UtAsmFlagRow{head: "mov rax, {r}\n ", row: "add rax, rbx", refused: true},
    UtAsmFlagRow{head: "mov rax, {r}\n ", row: "inc rax", refused: true},
    UtAsmFlagRow{head: "mov rax, {r}\n ", row: "cmpxchg rbx, rax", refused: true},
    UtAsmFlagRow{head: "mov rax, {r}\n ", row: "popfq", refused: true},
    UtAsmFlagRow{head: "mov rax, {r}\n ", row: "syscall", refused: true}
};

test oblivious_asm__flag_taint {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var i: usize = 0;
    for (i < 17) {
        val row: *UtAsmFlagRow                    = ?UT_ASM_FLAG_ROWS[i];
        val pr:  res[str, std_format.FormatError] = std_format.sprint(?alloc,
            "#[oblivious]\nfun f(k: ^u64) ^u64 {{ var r: ^u64 = k; asm x86_64 {{ {}{}\n jc 1f\n 1:\n nop }} ret r; }}\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 {{ ret 0; }}\n",
            row.head, row.row);
        if (sel pr.err) { ret 2; }
        var code: i32 = 0;
        if (row.refused) { code = ut_codegen_target_rejects(pr.ok, "linux", "branches on a secret value"); }
        or               { code = ut_codegen_target_ok(pr.ok, "linux"); }
        str_free(?alloc, pr.ok);
        if (code != 0) {
            print.printf("oblivious asm flag row {} `{}`: {}\n", i, row.row, code);
            ret (i::i32 + 1) * 100 + code;
        }
        i = i + 1;
    }
    ret 0;
}
