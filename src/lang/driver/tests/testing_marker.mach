# runs sema over a scaffolded project and counts the `#[testing]` refusals; each must sit on a
# bare name, and any other error fails the fixture so a refusal cannot hide behind one
#[testing]
fun ut_testing_refusals(names: *str, texts: *str, count: u32, expected: u32) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val initialized: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel initialized.err) { ret 2; }
    var s: session.Session = initialized.ok;
    fin { session.dnit(?s); }
    val built: res[project.Project, outcome.Fail] = ut_build(?s, ?alloc, names, texts, count);
    if (sel built.err) { ret 3; }
    var p: project.Project = built.ok;
    fin { project.dnit_project(?p); }
    val checked: err[outcome.Fail] = driver.run_sema_pass(?p);
    if (sel checked.err && !outcome.is_reported(checked.err)) { ret 4; }
    if (sel checked.ok && expected != 0)                      { ret 5; }
    var refusals: u32   = 0;
    var i:        usize = 0;
    for (i < diagnostic.len(?s.diags)) {
        val d: *diagnostic.Diagnostic = ?s.diags.items.data[i];
        i = i + 1;
        if (d.severity != diagnostic.SEVERITY_ERROR)                      { cnt; }
        if (!ut_str_contains(d.message, "is a `#[testing]` declaration")) { ret 6; }
        val file: opt[*src.SourceFile] = src.get(?s.sources, d.loc.file_id);
        if (sel file.none) { ret 7; }
        val text: str        = file.some.text;
        val span: token.Span = d.loc.span;
        if (span.len == 0 || span.offset + span.len > str_len(text)) { ret 8; }
        var j: usize = 0;
        for (j < span.len) {
            val c: u8 = text[span.offset + j];
            if (c == '[' || c == '(' || c == '{' || c == ' ' || c == ';') { ret 9; }
            j = j + 1;
        }
        refusals = refusals + 1;
    }
    if (refusals != expected) { ret 10; }
    ret 0;
}

#[testing]
fun ut_testing_refusals1(text: str, expected: u32) i32 {
    var names: [1]str = [1]str{"main.mach"};
    var texts: [1]str = [1]str{text};
    ret ut_testing_refusals(?names[0], ?texts[0], 1, expected);
}

#[testing]
rec UtTestingCase {
    text:     str;
    expected: u32;
}

# every way production code can name a testing declaration: a call, a value, an address,
# a field, parameter and return type, a generic instance, a generic argument, comptime
# evaluation and a decorator argument
#[testing]
val UT_TESTING_REFERENCES: [8]UtTestingCase = [8]UtTestingCase{
    UtTestingCase{text: "#[testing]\nfun helper() i32 { ret 1; }\nfun prod() i32 { ret helper(); }\n", expected: 1},
    UtTestingCase{text: "#[testing]\nval FIXTURE: i32 = 3;\nfun prod() i32 { ret FIXTURE; }\n", expected: 1},
    UtTestingCase{text: "#[testing]\nvar slot: i32 = 0;\nfun prod() *i32 { ret ?slot; }\n", expected: 1},
    UtTestingCase{text: "#[testing]\nrec Fixture { n: i32; }\nrec Prod { f: Fixture; }\nfun take(x: *Fixture) {}\nfun give() *Fixture { ret nil; }\n", expected: 3},
    UtTestingCase{text: "#[testing]\nfun make[T](x: T) T { ret x; }\nfun prod() i32 { ret make[i32](1); }\n", expected: 1},
    UtTestingCase{text: "#[testing]\nrec Fixture { n: i32; }\nrec Box[T] { v: T; }\nfun id[T](x: T) T { ret x; }\nfun prod() i32 { var b: Box[i32]; var f: Fixture; ret id[Box[i32]](b).v; }\n", expected: 1},
    UtTestingCase{text: "#[testing]\nval N: i32 = 4;\nval M: i32 = N + 1;\n$if (N == 4) {\n    fun prod() i32 { ret M; }\n}\nfun size() u64 { ret $size_of([N]u8)::u64; }\n", expected: 3},
    UtTestingCase{text: "#[testing]\nval WIDTH: u32 = 16;\n#[align(WIDTH)]\nvar g: i32 = 0;\n", expected: 1}
};

test testing_mark__refuses_every_production_reference {
    var i: usize = 0;
    for (i < 8) {
        val code: i32 = ut_testing_refusals1(UT_TESTING_REFERENCES[i].text, UT_TESTING_REFERENCES[i].expected);
        if (code != 0) { ret (i::i32 + 1) * 100 + code; }
        i = i + 1;
    }
    ret 0;
}

# an off-by-one region boundary would let a production declaration that abuts a testing one
# borrow its exemption, so neither side has a blank line or decorator between them
test testing_mark__region_ends_exactly_at_an_abutting_declaration {
    if (ut_testing_refusals1("#[testing] val V: i32 = 1;val W: i32 = V;", 1) != 0)                                                    { ret 1; }
    if (ut_testing_refusals1("val W: i32 = V;#[testing] val V: i32 = 1;", 1) != 0)                                                    { ret 2; }
    if (ut_testing_refusals1("test t { ret V; }val W: i32 = V;#[testing] val V: i32 = 1;", 1) != 0)                                   { ret 3; }
    if (ut_testing_refusals1("#[testing] fun a() i32 { ret 1; }fun b() i32 { ret a(); }#[testing] fun c() i32 { ret a(); }", 1) != 0) { ret 4; }
    ret 0;
}

# the mark follows imports: a module path and a plain `use` carry it, a `#[testing] use`
# confines even an ordinary target, and an unmarked `fwd` of a testing declaration is refused
test testing_mark__follows_imports {
    var names: [2]str = [2]str{"main.mach", "api.mach"};
    var texts: [2]str;
    texts[0] = "use uniontest.api;\nuse uniontest.api.helper;\nfun prod() i32 { ret api.helper() + helper(); }\n";
    texts[1] = "#[testing]\npub fun helper() i32 { ret 1; }\n";
    val through: i32 = ut_testing_refusals(?names[0], ?texts[0], 2, 2);
    if (through != 0) { ret 10 + through; }

    texts[0] = "#[testing]\nuse fixture: uniontest.api.plain;\nuse uniontest.api.plain;\nfun prod() i32 { ret fixture() + plain(); }\n";
    texts[1] = "pub fun plain() i32 { ret 1; }\n";
    val alias: i32 = ut_testing_refusals(?names[0], ?texts[0], 2, 1);
    if (alias != 0) { ret 20 + alias; }

    var fnames: [3]str = [3]str{"main.mach", "api.mach", "mid.mach"};
    var ftexts: [3]str;
    ftexts[0] = "use uniontest.mid;\nfun main() i32 { ret 0; }\n";
    ftexts[1] = "#[testing]\npub fun helper() i32 { ret 1; }\n";
    ftexts[2] = "fwd uniontest.api.helper;\n";
    val fwd: i32 = ut_testing_refusals(?fnames[0], ?ftexts[0], 3, 1);
    if (fwd != 0) { ret 30 + fwd; }
    ret 0;
}

test testing_mark__accepts_references_from_tests_and_testing_declarations {
    var names: [4]str = [4]str{"main.mach", "api.mach", "mid.mach", "bridge.mach"};
    var texts: [4]str;
    texts[0] = "use uniontest.api;\nuse uniontest.api.helper;\nuse uniontest.mid;\n#[testing]\nuse fixture: uniontest.api.plain;\n#[testing]\nval N: i32 = 4;\n#[testing]\nval WIDTH: u32 = 16;\n#[testing]\nvar slot: i32 = 0;\n#[testing]\nrec Fixture { n: i32; }\nrec Box[T] { v: T; }\n#[testing]\nfun make[T](x: T) T { ret x; }\n#[testing]\n#[align(WIDTH)]\nvar aligned: i32 = 0;\n#[testing]\nrec Holder { f: Fixture; }\n#[testing]\nfun give(x: *Fixture) *Fixture { ret x; }\n#[testing]\nfun uses() i32 { var b: Box[Fixture]; val p: *i32 = ?slot; ret api.helper() + helper() + mid.helper() + fixture() + make[i32](N) + $size_of([N]u8)::i32 + b.v.n + @p; }\ntest uses { var b: Box[Fixture]; val p: *i32 = ?slot; var h: Holder; ret api.helper() + helper() + mid.helper() + fixture() + make[i32](N) + $size_of([N]u8)::i32 + b.v.n + @p + uses() + give(?h.f).n; }\nfun main() i32 { ret api.plain(); }\n";
    texts[1] = "#[testing]\npub fun helper() i32 { ret 1; }\npub fun plain() i32 { ret 1; }\n";
    texts[2] = "#[testing]\nfwd uniontest.api.helper;\n";
    texts[3] = "#[testing]\nfwd uniontest.mid.helper;\n";
    ret ut_testing_refusals(?names[0], ?texts[0], 4, 0);
}

test testing_mark__declaration_is_type_checked_in_every_build {
    if (!ut_sema_rejects_with("#[testing]\nval i: i32 = 0;\n#[testing]\nfun bad() { i = 2; }\nfun main() i32 { ret 0; }\n",
        "cannot assign to `i`: a `val` is immutable")) { ret 1; }
    ret 0;
}

#[testing]
val UT_TESTING_HELPER: u32 = 1;
#[testing]
val UT_TESTING_SLOT: u32 = 2;
#[testing]
val UT_TESTING_CALLED: u32 = 4;
#[testing]
val UT_TESTING_PLAIN: u32 = 8;
# the normal object carried a `#[testing]` declaration, which only a test object may
#[testing]
val UT_TESTING_LEAKED: u32 = 16;
# the test object defined what its normal object defines instead of declaring it
#[testing]
val UT_TESTING_REDEFINED: u32 = 32;
# the test object reads and writes the private global its normal object defines
#[testing]
val UT_TESTING_SHARED: u32 = 64;

#[testing]
fun ut_image_names(image: *of.ObjectImage, itn: *intern.Interner, want: str) bool {
    var i: u32 = 0;
    for (i < image.symbol_count) {
        val found: opt[str] = intern.lookup(itn, image.symbols[i].name);
        if (sel found.some && str_contains(found.some, want) && !of.section_is_external(image.symbols[i].section)) { ret true; }
        i = i + 1;
    }
    ret false;
}

#[testing]
fun ut_image_calls(image: *of.ObjectImage, itn: *intern.Interner, want: str) bool {
    var i: u32 = 0;
    for (i < image.reloc_count) {
        val found: opt[str] = intern.lookup(itn, of.reloc_symbol_name(image, ?image.relocations[i]));
        if (sel found.some && str_contains(found.some, want)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# builds a fixture whose test calls a `#[testing]` function of another module, whose own
# test touches a private global, and reports which symbols the normal and test objects
# define or reference
#[testing]
fun ut_testing_objects(test_mode: bool, seen: *u32) i32 {
    @seen = 0;
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 2; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var names: [2]str = [2]str{"main.mach", "api.mach"};
    var texts: [2]str;
    texts[0] = "use uniontest.api;\n#[symbol(\"_start\")]\npub fun start() { if (api.plain() == 0) { ret; } }\ntest calls_the_fixture { ret api.fixture_helper() + api.fixture_slot; }\n";
    texts[1] = "#[testing]\npub fun fixture_helper() i32 { ret 0; }\n#[testing]\npub var fixture_slot: i32 = 0;\nvar hits: i32 = 0;\npub fun plain() i32 { hits = hits + 1; ret 1; }\ntest sees_the_normal_state { hits = 0; plain(); if (hits != 1) { ret 1; } ret 0; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold_m(?alloc, ut_manifest_x64_linux(), ?names[0], ?texts[0], 2);
    if (sel root_r.err) { ret 3; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?alloc, root); }
    val rr: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.err) { ret 4; }
    var target_sel: manifest.Selection                 = ut_target_sel("lx64");
    val pr:         res[project.Project, outcome.Fail] = driver.build_project(?s, root, ?target_sel);
    if (sel pr.err) { ret 5; }
    var p: project.Project = pr.ok;
    fin { project.dnit_project(?p); }
    if (test_mode) { p.req.goal = request.GOAL_TESTS; }
    val checked: err[outcome.Fail] = driver.run_sema_pass(?p);
    if (sel checked.err) { ret 6; }
    val lowered: err[outcome.Fail] = driver.run_lower_pass(?p);
    if (sel lowered.err) { ret 7; }
    val generated: err[outcome.Fail] = driver.run_codegen_pass(?p);
    if (sel generated.err) { ret 8; }
    if (test_mode) {
        val tested: err[outcome.Fail] = driver.run_test_pass(?p);
        if (sel tested.err) { ret 9; }
    }
    val main_mid: session.ModuleId = ut_mid(?p, ?s, "uniontest.main");
    val api_mid:  session.ModuleId = ut_mid(?p, ?s, "uniontest.api");
    if (main_mid == session.MODULE_NIL || api_mid == session.MODULE_NIL) { ret 10; }
    val main: *project.ModuleEntry = project.module_at(?p, main_mid::u32);
    val api:  *project.ModuleEntry = project.module_at(?p, api_mid::u32);
    if (main.object_image == nil || api.object_image == nil)    { ret 11; }
    if (ut_image_names(api.object_image, ?s.interner, "plain")) { @seen = @seen | UT_TESTING_PLAIN; }
    if (ut_image_names(api.object_image, ?s.interner, "fixture_")
        || ut_image_calls(main.object_image, ?s.interner, "fixture_")) { @seen = @seen | UT_TESTING_LEAKED; }
    if (!test_mode) { ret 0; }

    if (main.test.object_image == nil || api.test.object_image == nil)         { ret 12; }
    if (ut_image_calls(main.test.object_image, ?s.interner, "fixture_helper")) { @seen = @seen | UT_TESTING_CALLED; }
    if (ut_image_names(api.test.object_image, ?s.interner, "fixture_helper"))  { @seen = @seen | UT_TESTING_HELPER; }
    if (ut_image_names(api.test.object_image, ?s.interner, "fixture_slot"))    { @seen = @seen | UT_TESTING_SLOT; }
    if (ut_image_names(api.test.object_image, ?s.interner, "plain")
        || ut_image_names(api.test.object_image, ?s.interner, "hits")
        || ut_image_names(main.test.object_image, ?s.interner, "start")) { @seen = @seen | UT_TESTING_REDEFINED; }
    if (ut_image_names(api.object_image, ?s.interner, "uniontest.api.hits")
        && ut_image_calls(api.test.object_image, ?s.interner, "uniontest.api.hits")) { @seen = @seen | UT_TESTING_SHARED; }
    ret 0;
}

# a testing declaration is absent from ordinary objects and emitted in the test objects,
# beside normal objects a test build leaves unchanged and reaches through their symbols
test testing_mark__emitted_only_for_tests {
    var seen:     u32 = 0;
    val ordinary: i32 = ut_testing_objects(false, ?seen);
    if (ordinary != 0)            { ret ordinary; }
    if (seen != UT_TESTING_PLAIN) { ret 20; }
    val tested: i32 = ut_testing_objects(true, ?seen);
    if (tested != 0)                                                                                              { ret tested; }
    if (seen != (UT_TESTING_PLAIN | UT_TESTING_HELPER | UT_TESTING_SLOT | UT_TESTING_CALLED | UT_TESTING_SHARED)) { ret 30; }
    ret 0;
}

# scaffolds a consumer whose path dependency `leaf` exposes a `pub #[testing]` helper, and
# builds it through the planned engine for `goal` in a fresh session
#[testing]
fun ut_testing_dep_build(alloc: *A.Allocator, root: str, goal: request.BuildGoal, tests: *outcome.BuildOutcome, refused: *bool) i32 {
    val sr: res[session.Session, fail.Fail] = session.init(alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    val registered: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel registered.err) { ret 2; }
    val mr: res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) { ret 3; }
    var m:  manifest.Manifest    = mr.ok;
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    rq.target       = "linux";
    rq.goal         = goal;
    val pr: res[bplan.BuildPlan, outcome.Fail] = bplan.plan(alloc, ?s.interner, s.registry, ?m, rq);
    if (sel pr.err) { ret 4; }
    var bp: bplan.BuildPlan                         = pr.ok;
    val r:  res[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, alloc, nil);
    if (sel r.err) { ret 5; }
    @tests   = r.ok;
    @refused = ut_diag_has(?s.diags, "is a `#[testing]` declaration");
    ret 0;
}

#[testing]
fun ut_testing_dep_scaffold(alloc: *A.Allocator, main_text: str) res[str, fail.Fail] {
    var names:    [1]str              = [1]str{"main.mach"};
    var texts:    [1]str              = [1]str{ut_cc3(alloc, main_text, ut_dispatcher_start_stub(), "")};
    val consumer: str                 = ut_cc3(alloc, ut_manifest(), "\n[dep.leaf]\npath = \"dep/leaf\"\n", "");
    val scaffold: res[str, fail.Fail] = ut_scaffold_m(alloc, consumer, ?names[0], ?texts[0], 1);
    if (sel scaffold.err) { ret scaffold; }
    val root:    str             = scaffold.ok;
    val dep_src: str             = ut_cc3(alloc, root, "/", "dep/leaf/src");
    val made:    err[fs.FsError] = fs.create_dir_all(alloc, dep_src, 493);
    if (sel made.err) { ret res[str, fail.Fail].err{fail.fs_refused(made.err)}; }
    val dep_manifest: str             = ut_lib_manifest(alloc, "leaf");
    val mf:           str             = ut_cc3(alloc, root, "/dep/leaf/", manifest.MANIFEST_FILE);
    val w0:           err[fs.FsError] = fs.write_bytes(mf, dep_manifest, str_len(dep_manifest), 420);
    if (sel w0.err) { ret res[str, fail.Fail].err{fail.fs_refused(w0.err)}; }
    val lib_text: str             = "#[testing]\npub fun helper() i32 { ret 42; }\npub fun plain() i32 { ret 0; }\n";
    val w1:       err[fs.FsError] = fs.write_bytes(ut_cc3(alloc, dep_src, "/", "lib.mach"), lib_text, str_len(lib_text), 420);
    if (sel w1.err) { ret res[str, fail.Fail].err{fail.fs_refused(w1.err)}; }
    ret res[str, fail.Fail].ok{root};
}

# a dependency's modules are built in the consumer's mode: after an ordinary build has
# produced and cached the dependency's objects without the helper, `mach test` in a fresh
# session still links the helper the consumer's test calls, and the test passes
test testing_mark__dependency_helper_serves_consumer_tests {
    $if ($mach.build.os != $mach.os.linux || $mach.build.arch != $mach.arch.x86_64) { ret 0; }
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val scaffold: res[str, fail.Fail] = ut_testing_dep_scaffold(?alloc, "use leaf.lib;\npub fun main() i32 { ret lib.plain(); }\ntest leaf_helper { if (lib.helper() != 42) { ret 1; } ret 0; }\n");
    if (sel scaffold.err) { ret 2; }
    val root: str = scaffold.ok;
    fin { fs.remove_all(?alloc, root); }
    var ordinary:         outcome.BuildOutcome;
    var ordinary_refused: bool = false;
    val first:            i32  = ut_testing_dep_build(?alloc, root, request.GOAL_OBJECTS, ?ordinary, ?ordinary_refused);
    if (first != 0)                            { ret 10 + first; }
    if (ordinary.severity != outcome.BUILD_OK) { ret 3; }
    outcome.outcome_dnit(?ordinary);
    var tested:         outcome.BuildOutcome;
    var tested_refused: bool = false;
    val second:         i32  = ut_testing_dep_build(?alloc, root, request.GOAL_TESTS, ?tested, ?tested_refused);
    if (second != 0) { ret 20 + second; }
    fin { outcome.outcome_dnit(?tested); }
    if (tested.severity != outcome.BUILD_OK || tested.tests.len != 1) { ret 4; }
    val art: *outcome.TestArtifact = ?tested.tests.data[0];
    if (ut_dispatch_status(art.exe::str, art.idx) != 0) { ret 5; }
    ret 0;
}

test testing_mark__dependency_helper_is_refused_to_consumer_production {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val scaffold: res[str, fail.Fail] = ut_testing_dep_scaffold(?alloc, "use leaf.lib;\npub fun main() i32 { ret lib.helper(); }\n");
    if (sel scaffold.err) { ret 2; }
    val root: str = scaffold.ok;
    fin { fs.remove_all(?alloc, root); }
    var built:   outcome.BuildOutcome;
    var refused: bool = false;
    val status:  i32  = ut_testing_dep_build(?alloc, root, request.GOAL_OBJECTS, ?built, ?refused);
    if (status != 0) { ret 10 + status; }
    fin { outcome.outcome_dnit(?built); }
    if (built.severity == outcome.BUILD_OK || !refused) { ret 3; }
    ret 0;
}

# the mark refuses an `ext` declaration, a directive naming an outside consumer (the first
# and last of the exclusive table), a test, a comptime directive, a local, arguments and a
# second mark
test testing_mark__refuses_misplaced_or_malformed {
    val only: str = "`testing` applies only to fun, rec, uni, tag, def, val, var, use, or fwd declarations";
    if (!ut_sema_rejects_with("#[testing]\next fun outside() i32;\nfun main() i32 { ret 0; }\n", "`testing` cannot apply to an `ext` declaration"))       { ret 1; }
    if (!ut_sema_rejects_with("#[testing]\n#[symbol(\"exported\")]\nfun f() {}\nfun main() i32 { ret 0; }\n", "`testing` cannot combine with `symbol`"))  { ret 2; }
    if (!ut_sema_rejects_with("#[testing]\n#[sampler(0, 1)]\nvar f: f32 = 0.0;\nfun main() i32 { ret 0; }\n", "`testing` cannot combine with `sampler`")) { ret 3; }
    if (!ut_sema_rejects_with("#[testing]\ntest already_test_only { ret 0; }\nfun main() i32 { ret 0; }\n", only))                                        { ret 4; }
    if (!ut_sema_rejects_with("#[testing]\n$if ($mach.build.pointer_width == 8) {\n    fun f() {}\n}\nfun main() i32 { ret 0; }\n", only))                { ret 5; }
    # a local binding takes no decorator at all, so the grammar refuses the mark before sema sees it
    if (!ut_sema_rejects_with("fun main() i32 {\n    #[testing]\n    val n: i32 = 0;\n    ret n;\n}\n", "expected an expression"))                   { ret 6; }
    if (!ut_sema_rejects_with("#[testing(1)]\nfun f() {}\nfun main() i32 { ret 0; }\n", "`testing` decorator takes no arguments"))                   { ret 7; }
    if (!ut_sema_rejects_with("#[testing]\n#[testing]\nfun f() {}\nfun main() i32 { ret 0; }\n", "`testing` may appear only once on a declaration")) { ret 8; }
    ret 0;
}
