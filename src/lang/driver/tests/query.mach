    val run_sema_pass_r: err[outcome.Fail] = driver.run_sema_pass(?p1);
    if (sel run_sema_pass_r.err) {
        project.dnit_project(?p1);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    val run_lower_pass_r: err[outcome.Fail] = driver.run_lower_pass(?p1);
