test "mach.lang.driver:reload_rebuild_dedup_sources_by_path" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    val rr: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [2]str;
    names[0] = "main.mach";
    names[1] = "a.mach";
    var texts: [2]str;
    texts[0] = "use uniontest.a;\n\nfun main() i32 { ret 0; }\n";
    texts[1] = "pub fun fa() i32 { ret 1; }\n";

    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 2);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    var bad: i32 = 0;

    val p1r: res[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
    if (sel p1r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var p1: project.Project = p1r.ok;
    if (!ut_has(?p1, ?s, "uniontest.main")) { bad = 1; }
    or (!ut_has(?p1, ?s, "uniontest.a"))    { bad = 1; }
    val len1: usize = src.count(?s.sources);
    if (len1 == 0) { bad = 1; }
    project.dnit_project(?p1);

    val src_dir: str             = ut_cc3(?alloc, root, "/", "src");
    val a_path:  str             = ut_cc3(?alloc, src_dir, "/", "a.mach");
    val new_a:   str             = "pub fun fa() i32 { ret 2; }\n";
    val wr:      err[fs.FsError] = fs.write_bytes(a_path, new_a, str_len(new_a), 420);
    if (sel wr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }

    val p2r: res[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
    if (sel p2r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var p2: project.Project = p2r.ok;
    if (!ut_has(?p2, ?s, "uniontest.main")) { bad = 1; }
    or (!ut_has(?p2, ?s, "uniontest.a"))    { bad = 1; }
    val len2: usize = src.count(?s.sources);

    if (len2 != len1) { bad = 1; }

    project.dnit_project(?p2);
    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.driver:incremental_qparse_ast_reuse_and_reparse" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    val rr: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [2]str;
    names[0] = "main.mach";
    names[1] = "a.mach";
    var texts: [2]str;
    texts[0] = "use uniontest.a;\n\nfun main() i32 { ret 0; }\n";
    texts[1] = "pub fun fa() i32 { ret 1; }\n";

    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 2);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    var bad: i32 = 0;

    val p1r: res[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
    if (sel p1r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var p1:    project.Project = p1r.ok;
    val main1: *ast.Ast        = ut_ast(?p1, ?s, "uniontest.main");
    val a1:    *ast.Ast        = ut_ast(?p1, ?s, "uniontest.a");
    if (main1 == nil || a1 == nil) { bad = 1; }
    project.dnit_project(?p1);

    val p2r: res[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
    if (sel p2r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var p2: project.Project = p2r.ok;
    if (ut_ast(?p2, ?s, "uniontest.main") != main1) { bad = 1; }
    if (ut_ast(?p2, ?s, "uniontest.a") != a1)       { bad = 1; }
    project.dnit_project(?p2);

    val src_dir: str             = ut_cc3(?alloc, root, "/", "src");
    val a_path:  str             = ut_cc3(?alloc, src_dir, "/", "a.mach");
    val new_a:   str             = "pub fun fa() i32 { ret 2; }\n";
    val wr:      err[fs.FsError] = fs.write_bytes(a_path, new_a, str_len(new_a), 420);
    if (sel wr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }

    val p3r: res[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
    if (sel p3r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var p3: project.Project = p3r.ok;
    if (ut_ast(?p3, ?s, "uniontest.main") != main1) { bad = 1; }
    if (ut_ast(?p3, ?s, "uniontest.a") == a1)       { bad = 1; }
    project.dnit_project(?p3);

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.driver:incremental_reused_phase_replays_diagnostics" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    val rr: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "fun dup() i32 { ret 1; }\nfun dup() i32 { ret 2; }\n\nfun main() i32 { ret 0; }\n";

    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    var bad: i32 = 0;

    val p1r: res[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
    if (sel p1r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var p1: project.Project = p1r.ok;

    val cold_r: res[*diagnostic.DiagnosticStore, fail.Fail] = diagnostic.snapshot_from(?s.diags, 0, ?alloc);
    if (sel cold_r.err) {
        project.dnit_project(?p1);
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    val cold: *diagnostic.DiagnosticStore = cold_r.ok;
    if (diagnostic.len(cold) == 0) { bad = 1; }
    project.dnit_project(?p1);

    diagnostic.store_dnit(?s.diags);
    s.diags = diagnostic.store_init(?alloc);

    val p2r: res[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
    if (sel p2r.err) {
        diagnostic.store_dnit(cold);
        A.deallocate[diagnostic.DiagnosticStore](?alloc, cold, 1::usize);
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var p2: project.Project = p2r.ok;
    if (!ut_diag_list_eq(?s.diags, cold)) { bad = 1; }
    project.dnit_project(?p2);

    diagnostic.store_dnit(cold);
    A.deallocate[diagnostic.DiagnosticStore](?alloc, cold, 1::usize);
    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.driver:incremental_overlay_reparses_exactly_overlaid_module" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    val rr: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [2]str;
    names[0] = "main.mach";
    names[1] = "a.mach";
    var texts: [2]str;
    texts[0] = "use uniontest.a;\n\nfun main() i32 { ret 0; }\n";
    texts[1] = "pub fun fa() i32 { ret 1; }\n";

    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 2);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    var bad: i32 = 0;

    val p1r: res[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
    if (sel p1r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var p1:    project.Project = p1r.ok;
    val main1: *ast.Ast        = ut_ast(?p1, ?s, "uniontest.main");
    val a1:    *ast.Ast        = ut_ast(?p1, ?s, "uniontest.a");
    if (main1 == nil || a1 == nil) { bad = 1; }
    val a_mid: session.ModuleId = ut_mid(?p1, ?s, "uniontest.a");
    if (a_mid == session.MODULE_NIL) {
        fs.remove_all(?alloc, root);
        project.dnit_project(?p1);
        session.dnit(?s);
        ret 1;
    }
    val a_fid: src.FileId = project.module_at(?p1, a_mid::u32).file_id;
    project.dnit_project(?p1);

    val sf_opt: opt[*src.SourceFile] = src.get(?s.sources, a_fid);
    if (sel sf_opt.none) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    val a_path: str = sf_opt.some.path;

    val ov_text:       str            = "pub fun fa() i32 { ret 2; }\n";
    val set_overlay_r: err[fail.Fail] = session.set_overlay(?s, a_path, ov_text);
    if (sel set_overlay_r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    val p2r: res[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
    if (sel p2r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var p2: project.Project = p2r.ok;
    if (ut_ast(?p2, ?s, "uniontest.main") != main1) { bad = 1; }
    if (ut_ast(?p2, ?s, "uniontest.a") == a1)       { bad = 1; }
    val a2: *ast.Ast = ut_ast(?p2, ?s, "uniontest.a");
    project.dnit_project(?p2);

    val set_overlay_r2: err[fail.Fail] = session.set_overlay(?s, a_path, ov_text);
    if (sel set_overlay_r2.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    val p3r: res[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
    if (sel p3r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var p3: project.Project = p3r.ok;
    if (ut_ast(?p3, ?s, "uniontest.main") != main1) { bad = 1; }
    if (ut_ast(?p3, ?s, "uniontest.a") != a2)       { bad = 1; }
    project.dnit_project(?p3);

    val cleared: res[bool, fail.Fail] = session.clear_overlay(?s, a_path);
    if (!(sel cleared.ok && !(!cleared.ok))) { bad = 1; }
    val p4r: res[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
    if (sel p4r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var p4: project.Project = p4r.ok;
    if (ut_ast(?p4, ?s, "uniontest.main") != main1) { bad = 1; }
    if (ut_ast(?p4, ?s, "uniontest.a") == a2)       { bad = 1; }
    project.dnit_project(?p4);

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.driver:incremental_stable_identity_across_reshape" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    val rr: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [3]str;
    names[0] = "main.mach";
    names[1] = "a.mach";
    names[2] = "b.mach";
    var texts: [3]str;
    texts[0] = "use uniontest.a;\nuse uniontest.b;\n\nfun main() i32 { ret 0; }\n";
    texts[1] = "pub fun fa() i32 { ret 1; }\n";
    texts[2] = "pub fun fb() i32 { ret 2; }\n";

    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 3);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    var bad: i32 = 0;

    val p1r: res[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
    if (sel p1r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var p1:        project.Project        = p1r.ok;
    val mid_a1:    session.ModuleId       = ut_mid(?p1, ?s, "uniontest.a");
    val mid_b1:    session.ModuleId       = ut_mid(?p1, ?s, "uniontest.b");
    val sid_main1: session.StableModuleId = ut_stable(?p1, ?s, "uniontest.main");
    val sid_a1:    session.StableModuleId = ut_stable(?p1, ?s, "uniontest.a");
    val sid_b1:    session.StableModuleId = ut_stable(?p1, ?s, "uniontest.b");
    if (mid_a1 == session.MODULE_NIL || mid_b1 == session.MODULE_NIL)               { bad = 1; }
    if (sid_a1 == session.STABLE_MODULE_NIL || sid_b1 == session.STABLE_MODULE_NIL) { bad = 1; }
    project.dnit_project(?p1);

    val src_dir:   str             = ut_cc3(?alloc, root, "/", "src");
    val main_path: str             = ut_cc3(?alloc, src_dir, "/", "main.mach");
    val new_main:  str             = "use uniontest.b;\nuse uniontest.a;\n\nfun main() i32 { ret 0; }\n";
    val wr:        err[fs.FsError] = fs.write_bytes(main_path, new_main, str_len(new_main), 420);
    if (sel wr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }

    val p2r: res[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
    if (sel p2r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var p2:        project.Project        = p2r.ok;
    val mid_a2:    session.ModuleId       = ut_mid(?p2, ?s, "uniontest.a");
    val mid_b2:    session.ModuleId       = ut_mid(?p2, ?s, "uniontest.b");
    val sid_main2: session.StableModuleId = ut_stable(?p2, ?s, "uniontest.main");
    val sid_a2:    session.StableModuleId = ut_stable(?p2, ?s, "uniontest.a");
    val sid_b2:    session.StableModuleId = ut_stable(?p2, ?s, "uniontest.b");

    if (mid_a1 == mid_a2 && mid_b1 == mid_b2) { bad = 1; }
    if (sid_main2 != sid_main1)               { bad = 1; }
    if (sid_a2 != sid_a1)                     { bad = 1; }
    if (sid_b2 != sid_b1)                     { bad = 1; }
    project.dnit_project(?p2);

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.driver:incremental_qexports_firewalls_body_edit" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    val rr: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "pub fun f(a: i32) i32 { ret a; }\n";

    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    var bad: i32 = 0;

    val p1r: res[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
    if (sel p1r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var p1:     project.Project        = p1r.ok;
    val stable: session.StableModuleId = ut_stable(?p1, ?s, "uniontest.main");
    if (stable == session.STABLE_MODULE_NIL) { bad = 1; }
    val q1: res[UtQuerySnapshot, fail.Fail] = ut_query_snapshot(?alloc, ?p1, query.Q_EXPORTS, stable::u64);
    if (sel q1.err) {
        project.dnit_project(?p1);
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    val ent1: UtQuerySnapshot = q1.ok;
    val lc1:  query.Revision  = ent1.last_changed;
    val len1: u32             = ent1.value_len;
    val fp1:  *u8             = ent1.value;
    if (len1 == 0) { bad = 1; }
    project.dnit_project(?p1);

    val src_dir:   str             = ut_cc3(?alloc, root, "/", "src");
    val main_path: str             = ut_cc3(?alloc, src_dir, "/", "main.mach");
    val body_edit: str             = "pub fun f(a: i32) i32 { val t: i32 = a; ret t; }\n";
    val w2:        err[fs.FsError] = fs.write_bytes(main_path, body_edit, str_len(body_edit), 420);
    if (sel w2.err) {
        A.deallocate[u8](?alloc, fp1, len1::usize);
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }

    val p2r: res[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
    if (sel p2r.err) {
        A.deallocate[u8](?alloc, fp1, len1::usize);
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var p2: project.Project                 = p2r.ok;
    val q2: res[UtQuerySnapshot, fail.Fail] = ut_query_snapshot(?alloc, ?p2, query.Q_EXPORTS, stable::u64);
    if (sel q2.err) {
        project.dnit_project(?p2);
        A.deallocate[u8](?alloc, fp1, len1::usize);
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    val ent2: UtQuerySnapshot = q2.ok;
    if (ent2.last_changed != lc1)                                  { bad = 1; }
    if (ent2.value_len != len1)                                    { bad = 1; }
    or (!memory.raw_equal(ent2.value::ptr, fp1::ptr, len1::usize)) { bad = 1; }
    if (ent2.value != nil)                                         { A.deallocate[u8](?alloc, ent2.value, ent2.value_len::usize); }
    project.dnit_project(?p2);

    val surf_edit: str             = "pub fun f(a: i32) i32 { ret a; }\npub fun g() i32 { ret 0; }\n";
    val w3:        err[fs.FsError] = fs.write_bytes(main_path, surf_edit, str_len(surf_edit), 420);
    if (sel w3.err) {
        A.deallocate[u8](?alloc, fp1, len1::usize);
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }

    val p3r: res[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
    if (sel p3r.err) {
        A.deallocate[u8](?alloc, fp1, len1::usize);
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var p3: project.Project                 = p3r.ok;
    val q3: res[UtQuerySnapshot, fail.Fail] = ut_query_snapshot(?alloc, ?p3, query.Q_EXPORTS, stable::u64);
    if (sel q3.err) {
        project.dnit_project(?p3);
        A.deallocate[u8](?alloc, fp1, len1::usize);
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    val ent3: UtQuerySnapshot = q3.ok;
    if (ent3.last_changed == lc1)                                                           { bad = 1; }
    if (ent3.value_len == len1 && memory.raw_equal(ent3.value::ptr, fp1::ptr, len1::usize)) { bad = 1; }
    if (ent3.value != nil)                                                                  { A.deallocate[u8](?alloc, ent3.value, ent3.value_len::usize); }
    project.dnit_project(?p3);

    A.deallocate[u8](?alloc, fp1, len1::usize);
    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

fun ut_resolve_lc(s: *session.Session, stable: session.StableModuleId) query.Revision {
    val revision: query.Revision = query.peek_revision(?s.queries, query.Q_RESOLVE, stable::u64);
    if (revision == 0) { ret 0xFFFFFFFFFFFFFFFF; }
    ret revision;
}

fun ut_name_text_equal(sa: *session.Session, na: intern.StrId, sb: *session.Session, nb: intern.StrId) bool {
    val oa: opt[str] = intern.lookup(?sa.interner, na);
    val ob: opt[str] = intern.lookup(?sb.interner, nb);
    if (sel oa.none && sel ob.none) { ret true; }
    if (sel oa.none)                { ret false; }
    if (sel ob.none)                { ret false; }
    val ta: str   = oa.some;
    val tb: str   = ob.some;
    val la: usize = str_len(ta);
    if (la != str_len(tb)) { ret false; }
    ret memory.raw_equal(ta::ptr, tb::ptr, la);
}

fun rr_struct_equal(sa: *session.Session, ra: *resolve.ResolveResult, sb: *session.Session, rb: *resolve.ResolveResult) bool {
    if (ra == nil || rb == nil)             { ret false; }
    if (ra.symbol_count != rb.symbol_count) { ret false; }
    if (ra.pub_count != rb.pub_count)       { ret false; }
    if (ra.expr_count != rb.expr_count)     { ret false; }
    if (ra.type_count != rb.type_count)     { ret false; }
    if (ra.decl_count != rb.decl_count)     { ret false; }

    var i: u32 = 0;
    for (i < ra.expr_count) {
        if (ra.expr_resolved[i] != rb.expr_resolved[i]) { ret false; }
        i = i + 1;
    }
    i = 0;
    for (i < ra.type_count) {
        if (ra.type_resolved[i] != rb.type_resolved[i]) { ret false; }
        i = i + 1;
    }
    i = 0;
    for (i < ra.decl_count) {
        if (ra.decl_symbol[i] != rb.decl_symbol[i]) { ret false; }
        i = i + 1;
    }
    i = 0;
    for (i < ra.symbol_count) {
        val xa: *resolve.Symbol = ?ra.symbols[i];
        val xb: *resolve.Symbol = ?rb.symbols[i];
        if (xa.kind != xb.kind)                              { ret false; }
        if (xa.flags != xb.flags)                            { ret false; }
        if (xa.decl != xb.decl)                              { ret false; }
        if (xa.slot != xb.slot)                              { ret false; }
        if (xa.origin != xb.origin)                          { ret false; }
        if (!ut_name_text_equal(sa, xa.name, sb, xb.name))   { ret false; }
        if (!ut_name_text_equal(sa, xa.canon, sb, xb.canon)) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun ut_rr_of(p: *project.Project, s: *session.Session, fqn: str) *resolve.ResolveResult {
    val mid: session.ModuleId = ut_mid(p, s, fqn);
    if (mid == session.MODULE_NIL) { ret nil; }
    ret project.module_at(p, mid::u32).resolve_result;
}

test "mach.lang.driver:incremental_resolve_firewall_body_edit_equals_scratch" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var sA:               session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(sA.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?sA);
        ret 1;
    }

    var names: [2]str;
    names[0] = "main.mach";
    names[1] = "leaf.mach";
    var texts: [2]str;
    texts[0] = "use uniontest.leaf.fa;\nfun main() i32 { ret fa(); }\n";
    texts[1] = "pub fun fa() i32 { ret 1; }\n";

    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 2);
    if (sel root_r.err) {
        session.dnit(?sA);
        ret 1;
    }
    val root: str = root_r.ok;

    var bad: i32 = 0;

    val pA1r: res[project.Project, outcome.Fail] = driver.build_project_union(?sA, root);
    if (sel pA1r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var pA1:       project.Project        = pA1r.ok;
    val st_main:   session.StableModuleId = ut_stable(?pA1, ?sA, "uniontest.main");
    val st_leaf:   session.StableModuleId = ut_stable(?pA1, ?sA, "uniontest.leaf");
    val lc_main_1: query.Revision         = ut_resolve_lc(?sA, st_main);
    val lc_leaf_1: query.Revision         = ut_resolve_lc(?sA, st_leaf);
    project.dnit_project(?pA1);

    val src_dir:       str             = ut_cc3(?alloc, root, "/", "src");
    val leaf_path:     str             = ut_cc3(?alloc, src_dir, "/", "leaf.mach");
    val leaf_v2:       str             = "pub fun fa() i32 { val t: i32 = 1; ret t; }\n";
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(leaf_path, leaf_v2, str_len(leaf_v2), 420);
    if (sel write_bytes_r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }

    val pA2r: res[project.Project, outcome.Fail] = driver.build_project_union(?sA, root);
    if (sel pA2r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var pA2:       project.Project = pA2r.ok;
    val lc_main_2: query.Revision  = ut_resolve_lc(?sA, st_main);
    val lc_leaf_2: query.Revision  = ut_resolve_lc(?sA, st_leaf);

    if (lc_main_2 != lc_main_1) { bad = 1; }
    if (lc_leaf_2 == lc_leaf_1) { bad = 1; }

    val sr2: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr2.err) {
        project.dnit_project(?pA2);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var sB:                session.Session   = sr2.ok;
    val setup_registry_r2: err[outcome.Fail] = driver.setup_registry(sB.registry);
    if (sel setup_registry_r2.err) {
        session.dnit(?sB);
        project.dnit_project(?pA2);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    val pBr: res[project.Project, outcome.Fail] = driver.build_project_union(?sB, root);
    if (sel pBr.err) {
        session.dnit(?sB);
        project.dnit_project(?pA2);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var pB: project.Project = pBr.ok;

    if (!rr_struct_equal(?sA, ut_rr_of(?pA2, ?sA, "uniontest.main"), ?sB, ut_rr_of(?pB, ?sB, "uniontest.main"))) { bad = 1; }
    if (!rr_struct_equal(?sA, ut_rr_of(?pA2, ?sA, "uniontest.leaf"), ?sB, ut_rr_of(?pB, ?sB, "uniontest.leaf"))) { bad = 1; }

    project.dnit_project(?pB);
    session.dnit(?sB);
    project.dnit_project(?pA2);
    fs.remove_all(?alloc, root);
    session.dnit(?sA);
    ret bad;
}

test "mach.lang.driver:incremental_resolve_pub_surface_change_equals_scratch" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var sA:               session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(sA.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?sA);
        ret 1;
    }

    var names: [2]str;
    names[0] = "main.mach";
    names[1] = "leaf.mach";
    var texts: [2]str;
    texts[0] = "use uniontest.leaf.fa;\nfun main() i32 { ret fa(); }\n";
    texts[1] = "pub fun fa() i32 { ret 1; }\n";

    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 2);
    if (sel root_r.err) {
        session.dnit(?sA);
        ret 1;
    }
    val root: str = root_r.ok;

    var bad: i32 = 0;

    val pA1r: res[project.Project, outcome.Fail] = driver.build_project_union(?sA, root);
    if (sel pA1r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var pA1:        project.Project        = pA1r.ok;
    val st_main:    session.StableModuleId = ut_stable(?pA1, ?sA, "uniontest.main");
    val lc_main_1:  query.Revision         = ut_resolve_lc(?sA, st_main);
    val rr_main_1:  *resolve.ResolveResult = ut_rr_of(?pA1, ?sA, "uniontest.main");
    var fa_found_1: bool                   = false;
    var si:         u32                    = 0;
    for (si < rr_main_1.symbol_count) {
        val lookup_r: opt[str] = intern.lookup(?sA.interner, rr_main_1.symbols[si].canon);
        if (sel lookup_r.none) { ret 99; }
        if (rr_main_1.symbols[si].kind == resolve.SYM_IMPORTED
            && str_equals(lookup_r.some, "fa")) {
            fa_found_1 = true;
            if (rr_main_1.symbols[si].decl != aid.DECL_NIL) { bad = 1; }
        }
        si = si + 1;
    }
    project.dnit_project(?pA1);

    val src_dir:       str             = ut_cc3(?alloc, root, "/", "src");
    val leaf_path:     str             = ut_cc3(?alloc, src_dir, "/", "leaf.mach");
    val leaf_v2:       str             = "pub fun fz() *u8 { ret nil; }\npub fun fa() i32 { ret 1; }\n";
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(leaf_path, leaf_v2, str_len(leaf_v2), 420);
    if (sel write_bytes_r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }

    val pA2r: res[project.Project, outcome.Fail] = driver.build_project_union(?sA, root);
    if (sel pA2r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var pA2:       project.Project = pA2r.ok;
    val lc_main_2: query.Revision  = ut_resolve_lc(?sA, st_main);

    if (lc_main_2 == lc_main_1) { bad = 1; }
    val rr_main_2:  *resolve.ResolveResult = ut_rr_of(?pA2, ?sA, "uniontest.main");
    var fa_found_2: bool                   = false;
    si = 0;
    for (si < rr_main_2.symbol_count) {
        val lookup_r2: opt[str] = intern.lookup(?sA.interner, rr_main_2.symbols[si].canon);
        if (sel lookup_r2.none) { ret 99; }
        if (rr_main_2.symbols[si].kind == resolve.SYM_IMPORTED
            && str_equals(lookup_r2.some, "fa")) {
            fa_found_2 = true;
            if (rr_main_2.symbols[si].decl != aid.DECL_NIL) { bad = 1; }
        }
        si = si + 1;
    }
    if (!fa_found_1 || !fa_found_2) { bad = 1; }

    val run_sema_pass_r: err[outcome.Fail] = driver.run_sema_pass(?pA2);
    if (sel run_sema_pass_r.err) { bad = 1; }

    val sr2: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr2.err) {
        project.dnit_project(?pA2);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var sB:                session.Session   = sr2.ok;
    val setup_registry_r2: err[outcome.Fail] = driver.setup_registry(sB.registry);
    if (sel setup_registry_r2.err) {
        session.dnit(?sB);
        project.dnit_project(?pA2);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    val pBr: res[project.Project, outcome.Fail] = driver.build_project_union(?sB, root);
    if (sel pBr.err) {
        session.dnit(?sB);
        project.dnit_project(?pA2);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var pB: project.Project = pBr.ok;

    if (!rr_struct_equal(?sA, rr_main_2, ?sB, ut_rr_of(?pB, ?sB, "uniontest.main")))                             { bad = 1; }
    if (!rr_struct_equal(?sA, ut_rr_of(?pA2, ?sA, "uniontest.leaf"), ?sB, ut_rr_of(?pB, ?sB, "uniontest.leaf"))) { bad = 1; }

    project.dnit_project(?pB);
    session.dnit(?sB);
    project.dnit_project(?pA2);
    fs.remove_all(?alloc, root);
    session.dnit(?sA);
    ret bad;
}

test "mach.lang.driver:incremental_resolve_const_value_change_equals_scratch" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var sA:               session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(sA.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?sA);
        ret 1;
    }

    var names: [2]str;
    names[0] = "main.mach";
    names[1] = "leaf.mach";
    var texts: [2]str;
    texts[0] = "use uniontest.leaf.FLAG;\n$if (FLAG) {\n  fun extra() i32 { ret 1; }\n}\nfun main() i32 { ret 0; }\n";
    texts[1] = "pub val FLAG: u8 = 1;\n";

    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 2);
    if (sel root_r.err) {
        session.dnit(?sA);
        ret 1;
    }
    val root: str = root_r.ok;

    var bad: i32 = 0;

    val pA1r: res[project.Project, outcome.Fail] = driver.build_project_union(?sA, root);
    if (sel pA1r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var pA1:       project.Project        = pA1r.ok;
    val st_main:   session.StableModuleId = ut_stable(?pA1, ?sA, "uniontest.main");
    val lc_main_1: query.Revision         = ut_resolve_lc(?sA, st_main);
    val sc_main_1: u32                    = ut_rr_of(?pA1, ?sA, "uniontest.main").symbol_count;
    project.dnit_project(?pA1);

    val src_dir:       str             = ut_cc3(?alloc, root, "/", "src");
    val leaf_path:     str             = ut_cc3(?alloc, src_dir, "/", "leaf.mach");
    val leaf_v2:       str             = "pub val FLAG: u8 = 0;\n";
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(leaf_path, leaf_v2, str_len(leaf_v2), 420);
    if (sel write_bytes_r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }

    val pA2r: res[project.Project, outcome.Fail] = driver.build_project_union(?sA, root);
    if (sel pA2r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var pA2: project.Project = pA2r.ok;

    if (ut_resolve_lc(?sA, st_main) == lc_main_1)                        { bad = 1; }
    if (ut_rr_of(?pA2, ?sA, "uniontest.main").symbol_count == sc_main_1) { bad = 1; }

    val sr2: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr2.err) {
        project.dnit_project(?pA2);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var sB:                session.Session   = sr2.ok;
    val setup_registry_r2: err[outcome.Fail] = driver.setup_registry(sB.registry);
    if (sel setup_registry_r2.err) {
        session.dnit(?sB);
        project.dnit_project(?pA2);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    val pBr: res[project.Project, outcome.Fail] = driver.build_project_union(?sB, root);
    if (sel pBr.err) {
        session.dnit(?sB);
        project.dnit_project(?pA2);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var pB: project.Project = pBr.ok;

    if (!rr_struct_equal(?sA, ut_rr_of(?pA2, ?sA, "uniontest.main"), ?sB, ut_rr_of(?pB, ?sB, "uniontest.main"))) { bad = 1; }
    if (!rr_struct_equal(?sA, ut_rr_of(?pA2, ?sA, "uniontest.leaf"), ?sB, ut_rr_of(?pB, ?sB, "uniontest.leaf"))) { bad = 1; }

    project.dnit_project(?pB);
    session.dnit(?sB);
    project.dnit_project(?pA2);
    fs.remove_all(?alloc, root);
    session.dnit(?sA);
    ret bad;
}

test "mach.lang.driver:incremental_resolve_reexport_two_hop_propagation" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var sA:               session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(sA.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?sA);
        ret 1;
    }

    var names: [3]str;
    names[0] = "main.mach";
    names[1] = "mid.mach";
    names[2] = "leaf.mach";
    var texts: [3]str;
    texts[0] = "use uniontest.mid;\nfun main() i32 { ret mid.fa(); }\n";
    texts[1] = "fwd uniontest.leaf.fa;\n";
    texts[2] = "pub fun fa() i32 { ret 1; }\n";

    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 3);
    if (sel root_r.err) {
        session.dnit(?sA);
        ret 1;
    }
    val root: str = root_r.ok;

    var bad:       i32 = 0;
    val src_dir:   str = ut_cc3(?alloc, root, "/", "src");
    val leaf_path: str = ut_cc3(?alloc, src_dir, "/", "leaf.mach");

    val pA1r: res[project.Project, outcome.Fail] = driver.build_project_union(?sA, root);
    if (sel pA1r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var pA1:       project.Project        = pA1r.ok;
    val st_main:   session.StableModuleId = ut_stable(?pA1, ?sA, "uniontest.main");
    val st_mid:    session.StableModuleId = ut_stable(?pA1, ?sA, "uniontest.mid");
    val lc_main_1: query.Revision         = ut_resolve_lc(?sA, st_main);
    val lc_mid_1:  query.Revision         = ut_resolve_lc(?sA, st_mid);
    project.dnit_project(?pA1);

    val leaf_priv:     str             = "pub fun fa() i32 { val t: i32 = 1; ret t; }\n";
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(leaf_path, leaf_priv, str_len(leaf_priv), 420);
    if (sel write_bytes_r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    val pPr: res[project.Project, outcome.Fail] = driver.build_project_union(?sA, root);
    if (sel pPr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var pP: project.Project = pPr.ok;
    if (ut_resolve_lc(?sA, st_mid) != lc_mid_1)   { bad = 1; }
    if (ut_resolve_lc(?sA, st_main) != lc_main_1) { bad = 1; }
    project.dnit_project(?pP);

    val leaf_pub:       str             = "pub fun fz() i32 { ret 0; }\npub fun fa() i32 { ret 1; }\n";
    val write_bytes_r2: err[fs.FsError] = fs.write_bytes(leaf_path, leaf_pub, str_len(leaf_pub), 420);
    if (sel write_bytes_r2.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    val pA2r: res[project.Project, outcome.Fail] = driver.build_project_union(?sA, root);
    if (sel pA2r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var pA2: project.Project = pA2r.ok;
    if (ut_resolve_lc(?sA, st_mid) == lc_mid_1)   { bad = 1; }
    if (ut_resolve_lc(?sA, st_main) != lc_main_1) { bad = 1; }

    val sr2: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr2.err) {
        project.dnit_project(?pA2);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var sB:                session.Session   = sr2.ok;
    val setup_registry_r2: err[outcome.Fail] = driver.setup_registry(sB.registry);
    if (sel setup_registry_r2.err) {
        session.dnit(?sB);
        project.dnit_project(?pA2);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    val pBr: res[project.Project, outcome.Fail] = driver.build_project_union(?sB, root);
    if (sel pBr.err) {
        session.dnit(?sB);
        project.dnit_project(?pA2);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var pB: project.Project = pBr.ok;

    if (!rr_struct_equal(?sA, ut_rr_of(?pA2, ?sA, "uniontest.main"), ?sB, ut_rr_of(?pB, ?sB, "uniontest.main"))) { bad = 1; }
    if (!rr_struct_equal(?sA, ut_rr_of(?pA2, ?sA, "uniontest.mid"), ?sB, ut_rr_of(?pB, ?sB, "uniontest.mid")))   { bad = 1; }
    if (!rr_struct_equal(?sA, ut_rr_of(?pA2, ?sA, "uniontest.leaf"), ?sB, ut_rr_of(?pB, ?sB, "uniontest.leaf"))) { bad = 1; }

    project.dnit_project(?pB);
    session.dnit(?sB);
    project.dnit_project(?pA2);
    fs.remove_all(?alloc, root);
    session.dnit(?sA);
    ret bad;
}

fun ut_surface_lc(s: *session.Session, stable: session.StableModuleId) query.Revision {
    val revision: query.Revision = query.peek_revision(?s.queries, query.Q_LOWERED_SURFACE, stable::u64);
    if (revision == 0) { ret 0xFFFFFFFFFFFFFFFF; }
    ret revision;
}

fun ut_codegen_lc(s: *session.Session, stable: session.StableModuleId) query.Revision {
    val revision: query.Revision = query.peek_revision(?s.queries, query.Q_CODEGEN, stable::u64);
    if (revision == 0) { ret 0xFFFFFFFFFFFFFFFF; }
    ret revision;
}

fun ut_lower_lc_key(s: *session.Session, key: u64) query.Revision {
    val revision: query.Revision = query.peek_revision(?s.queries, query.Q_LOWER, key);
    if (revision == 0) { ret 0xFFFFFFFFFFFFFFFF; }
    ret revision;
}

fun ut_mod_main_neutralized(s: *session.Session, m: *ir.Module) i32 {
    val mr: res[intern.StrId, A.Error] = intern.intern(?s.interner, "main");
    if (sel mr.err) { ret -1; }
    val main_id: intern.StrId = mr.ok;

    var i: u32 = 0;
    for (i < m.function_len) {
        val fn: *ir.Function = ?m.functions[i];
        if (fn.name == main_id) {
            if ((fn.flags & ir.FN_FLAG_EXTERN) != 0 && fn.block_count == 0) { ret 1; }
            ret 0;
        }
        i = i + 1;
    }
    ret -1;
}

fun ut_mod_function_defined(s: *session.Session, m: *ir.Module, name: str) bool {
    val nr: res[intern.StrId, A.Error] = intern.intern(?s.interner, name);
    if (sel nr.err) { ret false; }
    val name_id: intern.StrId = nr.ok;

    var i: u32 = 0;
    for (i < m.function_len) {
        val fn: *ir.Function = ?m.functions[i];
        if (fn.name == name_id) {
            ret (fn.flags & ir.FN_FLAG_EXTERN) == 0 && fn.block_count > 0;
        }
        i = i + 1;
    }
    ret false;
}

fun ut_mod_test_count(m: *ir.Module) u32 {
    var count: u32 = 0;
    var i:     u32 = 0;
    for (i < m.function_len) {
        if ((m.functions[i].flags & ir.FN_FLAG_TEST) != 0) { count = count + 1; }
        i = i + 1;
    }
    ret count;
}

fun ut_mod_flag_count(m: *ir.Module, flag: u32) u32 {
    var count: u32 = 0;
    var i:     u32 = 0;
    for (i < m.function_len) {
        if ((m.functions[i].flags & flag) != 0) { count = count + 1; }
        i = i + 1;
    }
    ret count;
}

fun ut_link_lc(s: *session.Session) query.Revision {
    val revision: query.Revision = query.peek_revision(?s.queries, query.Q_LINK, 0);
    if (revision == 0) { ret 0xFFFFFFFFFFFFFFFF; }
    ret revision;
}

fun ut_type_owner_equal(sa: *session.Session, a: type.TypeOwner, sb: *session.Session, b: type.TypeOwner) bool {
    if ((a.module == session.STABLE_MODULE_NIL) != (b.module == session.STABLE_MODULE_NIL)) { ret false; }
    if (a.module != session.STABLE_MODULE_NIL) {
        val ma: session.ModuleId = session.module_id_for_stable(sa, a.module);
        val mb: session.ModuleId = session.module_id_for_stable(sb, b.module);
        if (ma == session.MODULE_NIL || mb == session.MODULE_NIL) { ret false; }
        val fa: intern.StrId = session.module_fqn(sa, ma);
        val fb: intern.StrId = session.module_fqn(sb, mb);
        if (fa == intern.STR_NIL || fb == intern.STR_NIL || !ut_name_text_equal(sa, fa, sb, fb)) { ret false; }
    }
    if ((a.file == src.FILE_NIL) != (b.file == src.FILE_NIL)) { ret false; }
    if (a.file == src.FILE_NIL)                               { ret true; }
    val fa: opt[*src.SourceFile] = src.get(?sa.sources, a.file);
    val fb: opt[*src.SourceFile] = src.get(?sb.sources, b.file);
    if (sel fa.none) { ret false; }
    if (sel fb.none) { ret false; }
    ret str_equals(fa.some.path, fb.some.path);
}

fun ty_struct_equal(sa: *session.Session, ta: type.TypeId, sb: *session.Session, tb: type.TypeId) bool {
    if (ta == type.TYPE_NIL && tb == type.TYPE_NIL)     { ret true; }
    if (ta == type.TYPE_ERROR && tb == type.TYPE_ERROR) { ret true; }
    if (ta == type.TYPE_NIL || tb == type.TYPE_NIL)     { ret false; }
    if (ta == type.TYPE_ERROR || tb == type.TYPE_ERROR) { ret false; }

    val oa: opt[*type.Type] = type.get(?sa.types, ta);
    val ob: opt[*type.Type] = type.get(?sb.types, tb);
    if (sel oa.none) { ret false; }
    if (sel ob.none) { ret false; }
    val a: *type.Type = oa.some;
    val b: *type.Type = ob.some;
    if (a.kind != b.kind) { ret false; }
    val k: type.TypeKind = a.kind;

    if (type.is_prim(k))     { ret true; }
    if (k == type.TYPE_PACK) { ret true; }
    if (k == type.TYPE_POINTER) {
        ret ty_struct_equal(sa, a.data.pointer.base, sb, b.data.pointer.base);
    }
    if (k == type.TYPE_ARRAY) {
        if (a.data.array.count != b.data.array.count) { ret false; }
        ret ty_struct_equal(sa, a.data.array.base, sb, b.data.array.base);
    }
    if (k == type.TYPE_FUN) {
        if (a.data.fn.params_len != b.data.fn.params_len)                     { ret false; }
        if (!ty_struct_equal(sa, a.data.fn.ret_type, sb, b.data.fn.ret_type)) { ret false; }
        var i: u32 = 0;
        for (i < a.data.fn.params_len) {
            val pa: opt[type.TypeId] = type.get_param(?sa.types, a.data.fn.params_start + i);
            val pb: opt[type.TypeId] = type.get_param(?sb.types, b.data.fn.params_start + i);
            if (sel pa.none)                                { ret false; }
            if (sel pb.none)                                { ret false; }
            if (!ty_struct_equal(sa, pa.some, sb, pb.some)) { ret false; }
            i = i + 1;
        }
        ret true;
    }
    if (k == type.TYPE_REC || k == type.TYPE_UNI) {
        if ((a.data.nominal.incarnation == 0) != (b.data.nominal.incarnation == 0))    { ret false; }
        if (!ut_name_text_equal(sa, a.data.nominal.name, sb, b.data.nominal.name))     { ret false; }
        if (!ut_name_text_equal(sa, a.data.nominal.syntax, sb, b.data.nominal.syntax)) { ret false; }
        ret ut_type_owner_equal(sa, a.data.nominal.owner, sb, b.data.nominal.owner);
    }
    if (k == type.TYPE_GENERIC_PARAM) {
        if (a.data.generic_param.owner_kind != b.data.generic_param.owner_kind)                            { ret false; }
        if (a.data.generic_param.index != b.data.generic_param.index)                                      { ret false; }
        if (!ut_name_text_equal(sa, a.data.generic_param.name, sb, b.data.generic_param.name))             { ret false; }
        if (!ut_name_text_equal(sa, a.data.generic_param.owner_name, sb, b.data.generic_param.owner_name)) { ret false; }
        ret ut_type_owner_equal(sa, a.data.generic_param.owner, sb, b.data.generic_param.owner);
    }
    if (k == type.TYPE_INSTANCE) {
        if (a.data.instance.args_len != b.data.instance.args_len)                       { ret false; }
        if (!ty_struct_equal(sa, a.data.instance.nominal, sb, b.data.instance.nominal)) { ret false; }
        var i: u32 = 0;
        for (i < a.data.instance.args_len) {
            val pa: opt[type.TypeId] = type.get_param(?sa.types, a.data.instance.args_start + i);
            val pb: opt[type.TypeId] = type.get_param(?sb.types, b.data.instance.args_start + i);
            if (sel pa.none)                                { ret false; }
            if (sel pb.none)                                { ret false; }
            if (!ty_struct_equal(sa, pa.some, sb, pb.some)) { ret false; }
            i = i + 1;
        }
        ret true;
    }
    ret false;
}

fun sr_struct_equal(sa: *session.Session, sra: *sema.SemaResult, sb: *session.Session, srb: *sema.SemaResult) bool {
    if (sra == nil || srb == nil)                     { ret false; }
    if (sra.expr_count != srb.expr_count)             { ret false; }
    if (sra.type_count != srb.type_count)             { ret false; }
    if (sra.decl_count != srb.decl_count)             { ret false; }
    if (sra.embed_path_count != srb.embed_path_count) { ret false; }

    var i: u32 = 0;
    for (i < sra.expr_count) {
        if (!ty_struct_equal(sa, sra.expr_type[i], sb, srb.expr_type[i])) { ret false; }
        i = i + 1;
    }
    i = 0;
    for (i < sra.type_count) {
        if (!ty_struct_equal(sa, sra.type_resolved_ty[i], sb, srb.type_resolved_ty[i])) { ret false; }
        i = i + 1;
    }
    i = 0;
    for (i < sra.decl_count) {
        if (!ty_struct_equal(sa, sra.decl_type[i], sb, srb.decl_type[i])) { ret false; }
        i = i + 1;
    }
    i = 0;
    for (i < sra.embed_path_count) {
        val pa: opt[str] = intern.lookup(?sa.interner, sra.embed_paths[i]);
        val pb: opt[str] = intern.lookup(?sb.interner, srb.embed_paths[i]);
        if (sel pa.none)                   { ret false; }
        if (sel pb.none)                   { ret false; }
        if (!str_equals(pa.some, pb.some)) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun ut_sr_of(p: *project.Project, s: *session.Session, fqn: str) *sema.SemaResult {
    val mid: session.ModuleId = ut_mid(p, s, fqn);
    if (mid == session.MODULE_NIL) { ret nil; }
    ret project.module_at(p, mid::u32).sema_result;
}

test "mach.lang.driver:incremental_sema_firewall_body_edit_equals_scratch" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var sA:               session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(sA.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?sA);
        ret 1;
    }

    var names: [2]str;
    names[0] = "main.mach";
    names[1] = "leaf.mach";
    var texts: [2]str;
    texts[0] = "use uniontest.leaf.fa;\nfun main() i32 { val x: i32 = fa(); ret x; }\n";
    texts[1] = "pub fun fa() i32 { ret 1; }\n";

    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 2);
    if (sel root_r.err) {
        session.dnit(?sA);
        ret 1;
    }
    val root: str = root_r.ok;

    var bad: i32 = 0;

    val pA1r: res[project.Project, outcome.Fail] = driver.build_project_union(?sA, root);
    if (sel pA1r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var pA1:             project.Project   = pA1r.ok;
    val run_sema_pass_r: err[outcome.Fail] = driver.run_sema_pass(?pA1);
    if (sel run_sema_pass_r.err) {
        project.dnit_project(?pA1);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    val st_main:   session.StableModuleId = ut_stable(?pA1, ?sA, "uniontest.main");
    val st_leaf:   session.StableModuleId = ut_stable(?pA1, ?sA, "uniontest.leaf");
    val lc_main_1: query.Revision         = ut_sema_lc(?sA, st_main);
    val lc_leaf_1: query.Revision         = ut_sema_lc(?sA, st_leaf);
    project.dnit_project(?pA1);

    val src_dir:       str             = ut_cc3(?alloc, root, "/", "src");
    val leaf_path:     str             = ut_cc3(?alloc, src_dir, "/", "leaf.mach");
    val leaf_v2:       str             = "pub fun fa() i32 { val t: i32 = 1; ret t; }\n";
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(leaf_path, leaf_v2, str_len(leaf_v2), 420);
    if (sel write_bytes_r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }

    val pA2r: res[project.Project, outcome.Fail] = driver.build_project_union(?sA, root);
    if (sel pA2r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var pA2:              project.Project   = pA2r.ok;
    val run_sema_pass_r2: err[outcome.Fail] = driver.run_sema_pass(?pA2);
    if (sel run_sema_pass_r2.err) {
        project.dnit_project(?pA2);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    val lc_main_2: query.Revision = ut_sema_lc(?sA, st_main);
    val lc_leaf_2: query.Revision = ut_sema_lc(?sA, st_leaf);

    if (lc_main_2 != lc_main_1) { bad = 2; }
    if (lc_leaf_2 == lc_leaf_1) { bad = 3; }

    val sr2: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr2.err) {
        project.dnit_project(?pA2);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var sB:                session.Session   = sr2.ok;
    val setup_registry_r2: err[outcome.Fail] = driver.setup_registry(sB.registry);
    if (sel setup_registry_r2.err) {
        session.dnit(?sB);
        project.dnit_project(?pA2);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    val pBr: res[project.Project, outcome.Fail] = driver.build_project_union(?sB, root);
    if (sel pBr.err) {
        session.dnit(?sB);
        project.dnit_project(?pA2);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var pB:               project.Project   = pBr.ok;
    val run_sema_pass_r3: err[outcome.Fail] = driver.run_sema_pass(?pB);
    if (sel run_sema_pass_r3.err) {
        project.dnit_project(?pB);
        session.dnit(?sB);
        project.dnit_project(?pA2);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }

    if (!sr_struct_equal(?sA, ut_sr_of(?pA2, ?sA, "uniontest.main"), ?sB, ut_sr_of(?pB, ?sB, "uniontest.main"))) { bad = 4; }
    if (!sr_struct_equal(?sA, ut_sr_of(?pA2, ?sA, "uniontest.leaf"), ?sB, ut_sr_of(?pB, ?sB, "uniontest.leaf"))) { bad = 5; }

    project.dnit_project(?pB);
    session.dnit(?sB);
    project.dnit_project(?pA2);
    fs.remove_all(?alloc, root);
    session.dnit(?sA);
    ret bad;
}

test "mach.lang.driver:incremental_sema_return_type_change_equals_scratch" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
