    texts[1] = "pub rec Q { x: i32; }\n";
    texts[2] = "pub fun fb() i32 { ret 2; }\n";

    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 3);
    if (sel root_r.err) {
