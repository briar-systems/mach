        session.dnit(?sA);
        ret 1;
    }

    var names: [3]str;
    names[0] = "main.mach";
    names[1] = "a.mach";
    names[2] = "b.mach";
    var texts: [3]str;
    texts[0] = "use uniontest.a.fa;\nuse uniontest.b.fb;\nfun main() i32 { ret fa() + fb(); }\n";
    texts[1] = "pub fun fa() i32 { ret 1; }\n";
    texts[2] = "pub fun fb() i32 { ret 2; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 3);
    if (sel root_r.err) {
        session.dnit(?sA);
        ret 1;
    }
    val root: str = root_r.ok;

    var bad: i32 = 0;

    val p1r: res[project.Project, outcome.Fail] = driver.build_project_union(?sA, root);
    if (sel p1r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var p1:              project.Project   = p1r.ok;
    val run_sema_pass_r: err[outcome.Fail] = driver.run_sema_pass(?p1);
    if (sel run_sema_pass_r.err) {
        project.dnit_project(?p1);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    val run_lower_pass_r: err[outcome.Fail] = driver.run_lower_pass(?p1);
    if (sel run_lower_pass_r.err) {
        project.dnit_project(?p1);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    val run_codegen_pass_r: err[outcome.Fail] = driver.run_codegen_pass(?p1);
    if (sel run_codegen_pass_r.err) {
        project.dnit_project(?p1);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    val st_main:   session.StableModuleId = ut_stable(?p1, ?sA, "uniontest.main");
    val st_a:      session.StableModuleId = ut_stable(?p1, ?sA, "uniontest.a");
    val st_b:      session.StableModuleId = ut_stable(?p1, ?sA, "uniontest.b");
    val cg_main_1: query.Revision         = ut_codegen_lc(?sA, st_main);
    val cg_a_1:    query.Revision         = ut_codegen_lc(?sA, st_a);
    val cg_b_1:    query.Revision         = ut_codegen_lc(?sA, st_b);
    project.dnit_project(?p1);

    val p2r: res[project.Project, outcome.Fail] = driver.build_project_union(?sA, root);
    if (sel p2r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var p2:               project.Project   = p2r.ok;
    val run_sema_pass_r2: err[outcome.Fail] = driver.run_sema_pass(?p2);
    if (sel run_sema_pass_r2.err) {
        project.dnit_project(?p2);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    val run_lower_pass_r2: err[outcome.Fail] = driver.run_lower_pass(?p2);
    if (sel run_lower_pass_r2.err) {
        project.dnit_project(?p2);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    val run_codegen_pass_r2: err[outcome.Fail] = driver.run_codegen_pass(?p2);
    if (sel run_codegen_pass_r2.err) {
        project.dnit_project(?p2);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    if (ut_codegen_lc(?sA, st_main) != cg_main_1) { bad = 1; }
    if (ut_codegen_lc(?sA, st_a) != cg_a_1)       { bad = 1; }
    if (ut_codegen_lc(?sA, st_b) != cg_b_1)       { bad = 1; }
    project.dnit_project(?p2);

    val src_dir:       str             = ut_cc3(?alloc, root, "/", "src");
    val a_path:        str             = ut_cc3(?alloc, src_dir, "/", "a.mach");
    val a_v2:          str             = "pub fun fa() i32 { val t: i32 = 1; ret t; }\n";
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(a_path, a_v2, str_len(a_v2), 420);
    if (sel write_bytes_r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }

    val p3r: res[project.Project, outcome.Fail] = driver.build_project_union(?sA, root);
    if (sel p3r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var p3:               project.Project   = p3r.ok;
    val run_sema_pass_r3: err[outcome.Fail] = driver.run_sema_pass(?p3);
    if (sel run_sema_pass_r3.err) {
        project.dnit_project(?p3);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    val run_lower_pass_r3: err[outcome.Fail] = driver.run_lower_pass(?p3);
    if (sel run_lower_pass_r3.err) {
        project.dnit_project(?p3);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    val run_codegen_pass_r3: err[outcome.Fail] = driver.run_codegen_pass(?p3);
    if (sel run_codegen_pass_r3.err) {
        project.dnit_project(?p3);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    if (ut_codegen_lc(?sA, st_a) == cg_a_1) { bad = 1; }
    if (ut_codegen_lc(?sA, st_b) != cg_b_1) { bad = 1; }
    project.dnit_project(?p3);

    fs.remove_all(?alloc, root);
    session.dnit(?sA);
    ret bad;
}

test "mach.lang.driver.cache:repeated_project_operations_publish_under_current_source_key" {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    var names:    [1]str              = [1]str{"main.mach"};
    var texts:    [1]str              = [1]str{"pub fun main() i32 { ret 7; }\n"};
    val scaffold: res[str, fail.Fail] = ut_scaffold(?a, ?names[0], ?texts[0], 1);
    if (sel scaffold.err) { ret 2; }
    val root: str = scaffold.ok;
    fin { fs.remove_all(?a, root); }
    val file: res[str, A.Error] = path.join(?a, root, "src/main.mach");
    if (sel file.err) { ret 3; }
    val filename: str = file.ok;
    fin { str_free(?a, filename); }
    var snapshots: [2][32]u8;
    var images:    [2][32]u8;
    var round:     u32 = 0;
    for (round < 2) {
        val write_bytes_r: err[fs.FsError] = fs.write_bytes(filename, texts[0], str_len(texts[0]), 420);
        if (sel write_bytes_r.err) { ret 4; }
        val initialized: res[session.Session, fail.Fail] = session.init(?a);
        if (sel initialized.err) { ret 5; }
        var s: session.Session = initialized.ok;
        fin { session.dnit(?s); }
        val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
        if (sel setup_registry_r.err) { ret 6; }
        val built: res[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
        if (sel built.err) { ret 7; }
        var p: project.Project = built.ok;
        fin { project.dnit_project(?p); }
        p.req.object_cache = true;
        val out: opt[str] = intern.lookup(?s.interner, p.config.project_out);
        if (sel out.none) { ret 8; }
        val resolved: res[str, A.Error] = path.resolve(?a, root, out.some);
        if (sel resolved.err) { ret 9; }
        val directory: str             = resolved.ok;
        val made:      err[fs.FsError] = fs.create_dir_all(?a, directory, 493);
        str_free(?a, directory);
        if (sel made.err) { ret 10; }
        var revision: u32 = 0;
        for (revision < 2) {
            if (revision == 1) {
                val changed: res[src.FileId, fail.Fail] = session.load_source(?s, filename,
                    "pub fun main() i32 { ret 99; }\n");
                if (sel changed.err) { ret 11; }
            }
            if (ut_run_codegen_ok(?p) != 0 || p.emit_len != 1) { ret 12; }
            # the counters span the project: every revision of round 0 misses and
            # publishes, every revision of round 1 restores what round 0 published
            if (p.cache_hits != round * (revision + 1) || p.cache_misses != (1 - round) * (revision + 1)) { ret 13; }
            val m: *project.ModuleEntry = project.module_at(?p, p.topo[0]::u32);
            if (m.object_image == nil)            { ret 14; }
            if (round == 1 && m.ir_module != nil) { ret 14; }
            val encoded: res[Vector[u8], cache_image.Error] = cache_image.encode(?a, m.object_image, nil);
            if (sel encoded.err) { ret 15; }
            var wire: Vector[u8] = encoded.ok;
            fin { vector.dnit[u8](?wire); }
            var hasher: cache_key.Builder = cache_key.begin("test.image");
            cache_key.bytes(?hasher, wire.data, wire.len);
            var digest:   [32]u8;
            val finish_r: err[fail.Fail] = cache_key.finish(?hasher, ?digest);
            if (sel finish_r.err) { ret 16; }
            if (round == 0) {
                snapshots[revision] = p.cache_snapshot;
                images[revision]    = digest;
            }
            or {
                if (!cache_key.equal(?snapshots[revision], ?p.cache_snapshot)
                    || !cache_key.equal(?images[revision], ?digest)) { ret 17; }
            }
            revision = revision + 1;
        }
        round = round + 1;
    }
    if (cache_key.equal(?snapshots[0], ?snapshots[1]) || cache_key.equal(?images[0], ?images[1])) { ret 18; }
    ret 0;
}

# a cached back half on an existing session: the cache directory exists, the
# request carries the given optimization level and debug flag, and the target
# input reflects them
fun ut_cached_back_half(s: *session.Session, root: str, debug: bool) res[project.Project, outcome.Fail] {
    val pr: res[project.Project, outcome.Fail] = driver.build_project_union(s, root);
    if (sel pr.err) { ret pr; }
    var p: project.Project = pr.ok;
    p.req.object_cache = true;
    if (p.req.debug != debug) {
        p.req.debug = debug;
        val configured: err[fail.Fail] = passes.set_build_config_input(?p);
        if (sel configured.err) {
            project.dnit_project(?p);
            ret res[project.Project, outcome.Fail].err{outcome.from_fail(configured.err)};
        }
    }
    val out: opt[str] = intern.lookup(?s.interner, p.config.project_out);
    if (sel out.none) {
        project.dnit_project(?p);
        ret res[project.Project, outcome.Fail].err{outcome.internal("no project out")};
    }
    val resolved: res[str, A.Error] = path.resolve(p.alloc, root, out.some);
    if (sel resolved.err) {
        project.dnit_project(?p);
        ret res[project.Project, outcome.Fail].err{outcome.refused(resolved.err)};
    }
    val made: err[fs.FsError] = fs.create_dir_all(p.alloc, resolved.ok, 493);
    str_free(p.alloc, resolved.ok);
    if (sel made.err) {
        project.dnit_project(?p);
        ret res[project.Project, outcome.Fail].err{outcome.internal("cannot create the output directory")};
    }
    val rs: err[outcome.Fail] = driver.run_sema_pass(?p);
    if (sel rs.err) {
        project.dnit_project(?p);
        ret res[project.Project, outcome.Fail].err{rs.err};
    }
    val rl: err[outcome.Fail] = driver.run_lower_pass(?p);
    if (sel rl.err) {
        project.dnit_project(?p);
        ret res[project.Project, outcome.Fail].err{rl.err};
    }
    val rc: err[outcome.Fail] = driver.run_codegen_pass(?p);
    if (sel rc.err) {
        project.dnit_project(?p);
        ret res[project.Project, outcome.Fail].err{rc.err};
    }
    ret res[project.Project, outcome.Fail].ok{p};
}

fun ut_lowered(p: *project.Project, s: *session.Session, fqn: str) bool {
    val mid: session.ModuleId = ut_mid(p, s, fqn);
    if (mid == session.MODULE_NIL) { ret false; }
    ret project.module_at(p, mid::u32).ir_module != nil;
}

# one cached round: build, then report the codegen revisions and whether the
# modules lowered; a restored module never lowers, a generated one always does
rec UtCachedRound {
    ok:           bool;
    hits:         u32;
    misses:       u32;
    lowered_main: bool;
    lowered_leaf: bool;
    cg_main:      query.Revision;
    cg_leaf:      query.Revision;
}

fun ut_cached_round(s: *session.Session, root: str, debug: bool) UtCachedRound {
    var r:  UtCachedRound                      = UtCachedRound{};
    val pr: res[project.Project, outcome.Fail] = ut_cached_back_half(s, root, debug);
    if (sel pr.err) {
        print.eprintln(outcome.describe(pr.err));
        ret r;
    }
    var p: project.Project = pr.ok;
    r.hits         = p.cache_hits;
    r.misses       = p.cache_misses;
    r.lowered_main = ut_lowered(?p, s, "uniontest.main");
    r.lowered_leaf = ut_lowered(?p, s, "uniontest.leaf");
    r.cg_main      = ut_codegen_lc(s, ut_stable(?p, s, "uniontest.main"));
    r.cg_leaf      = ut_codegen_lc(s, ut_stable(?p, s, "uniontest.leaf"));
    r.ok           = true;
    project.dnit_project(?p);
    ret r;
}

# the in-process image of the persistent key: a product restored from the store
# is invalidated by an edit to its own source, to a module whose inline body it
# absorbed, and to the request, and the store then misses under the new key
test "mach.lang.driver.cache:restored_product_is_invalidated_by_each_keyed_input_edit" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var names: [2]str;
    names[0] = "main.mach";
    names[1] = "leaf.mach";
    var texts: [2]str;
    texts[0] = "use uniontest.leaf.inl;\nfun main() i32 { ret inl(); }\n";
    texts[1] = "#[inline]\npub fun inl() i32 { ret 3; }\n";
    # the default profile is the release pipeline without debug information, so
    # the request the loader records is the request every round builds with
    val manifest_text: str                 = "[project]\nmach = \">=5\"\nid = \"uniontest\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.linux]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[artifact.uniontest]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/uniontest\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.release]\ndefault = true\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n";
    val root_r:        res[str, fail.Fail] = ut_scaffold_m(?alloc, manifest_text, ?names[0], ?texts[0], 2);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?alloc, root); }
    val src_dir:   str = ut_cc3(?alloc, root, "/", "src");
    val leaf_path: str = ut_cc3(?alloc, src_dir, "/", "leaf.mach");
    val main_path: str = ut_cc3(?alloc, src_dir, "/", "main.mach");

    # a first process publishes both objects
    val first_r: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel first_r.err) { ret 2; }
    var first:      session.Session   = first_r.ok;
    val registered: err[outcome.Fail] = driver.setup_registry(first.registry);
    if (sel registered.err) {
        session.dnit(?first);
        ret 2;
    }
    val published: UtCachedRound = ut_cached_round(?first, root, false);
    session.dnit(?first);
    if (!published.ok || published.hits != 0 || published.misses != 2 || !published.lowered_main || !published.lowered_leaf) { ret 3; }

    # a second process restores both without lowering
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 4; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    val registered2: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel registered2.err) { ret 4; }
    val restored: UtCachedRound = ut_cached_round(?s, root, false);
    if (!restored.ok || restored.hits != 2 || restored.misses != 0 || restored.lowered_main || restored.lowered_leaf) { ret 5; }

    # the same session, an inline body edited: the importer's own typed surface
    # is unchanged, yet its restored object absorbed the old body
    val leaf_v2:    str             = "#[inline]\npub fun inl() i32 { ret 4; }\n";
    val wrote_leaf: err[fs.FsError] = fs.write_bytes(leaf_path, leaf_v2, str_len(leaf_v2), 420);
    if (sel wrote_leaf.err) { ret 6; }
    val after_leaf: UtCachedRound = ut_cached_round(?s, root, false);
    if (!after_leaf.ok || after_leaf.cg_main == restored.cg_main || after_leaf.cg_leaf == restored.cg_leaf)     { ret 7; }
    if (after_leaf.hits != 0 || after_leaf.misses != 2 || !after_leaf.lowered_main || !after_leaf.lowered_leaf) { ret 8; }

    # the module's own source: the leaf's generated product is held by the
    # session and neither restores nor regenerates, main misses under the new key
    val main_v2:    str             = "use uniontest.leaf.inl;\nfun main() i32 { ret inl() + 1; }\n";
    val wrote_main: err[fs.FsError] = fs.write_bytes(main_path, main_v2, str_len(main_v2), 420);
    if (sel wrote_main.err) { ret 9; }
    val after_main: UtCachedRound = ut_cached_round(?s, root, false);
    if (!after_main.ok || after_main.cg_main == after_leaf.cg_main || after_main.cg_leaf != after_leaf.cg_leaf) { ret 10; }
    if (after_main.hits != 0 || after_main.misses != 1 || !after_main.lowered_main)                             { ret 11; }

    # the request: what was just published restores, then a debug flip misses
    val again: UtCachedRound = ut_cached_round(?s, root, false);
    if (!again.ok || again.hits != 0 || again.misses != 0 || again.cg_main != after_main.cg_main) { ret 12; }
    val debug: UtCachedRound = ut_cached_round(?s, root, true);
    if (!debug.ok || debug.cg_main == again.cg_main || debug.cg_leaf == again.cg_leaf)      { ret 13; }
    if (debug.hits != 0 || debug.misses != 2 || !debug.lowered_main || !debug.lowered_leaf) { ret 14; }

    # a fresh session under the edited inputs restores what the edits published
    val third_r: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel third_r.err) { ret 15; }
    var third: session.Session = third_r.ok;
    fin { session.dnit(?third); }
    val registered3: err[outcome.Fail] = driver.setup_registry(third.registry);
    if (sel registered3.err) { ret 15; }
    val final: UtCachedRound = ut_cached_round(?third, root, true);
    if (!final.ok || final.hits != 2 || final.misses != 0 || final.lowered_main || final.lowered_leaf) { ret 16; }
    ret 0;
}

test "mach.lang.driver:incremental_link_reuse_and_fingerprint" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var sA:               session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(sA.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?sA);
        ret 1;
    }

    var names: [3]str;
    names[0] = "main.mach";
    names[1] = "a.mach";
    names[2] = "b.mach";
    var texts: [3]str;
    texts[0] = "use uniontest.a.fa;\nuse uniontest.b.fb;\nfun main() i32 { ret fa() + fb(); }\n";
    texts[1] = "pub fun fa() i32 { ret 1; }\n";
    texts[2] = "pub fun fb() i32 { ret 2; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 3);
    if (sel root_r.err) {
        session.dnit(?sA);
        ret 1;
    }
    val root: str = root_r.ok;

    var bad: i32 = 0;

    val p1r: res[project.Project, outcome.Fail] = ut_back_half(?sA, root);
    if (sel p1r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var p1:                      project.Project        = p1r.ok;
    val st_a:                    session.StableModuleId = ut_stable(?p1, ?sA, "uniontest.a");
    val st_b:                    session.StableModuleId = ut_stable(?p1, ?sA, "uniontest.b");
    val st_main:                 session.StableModuleId = ut_stable(?p1, ?sA, "uniontest.main");
    val set_link_config_input_r: err[outcome.Fail]      = bengine.set_link_config_input(?p1, "out/app"::*u8, "app"::*u8, 0, nil, 0, nil, 0, nil);
    if (sel set_link_config_input_r.err) {
        project.dnit_project(?p1);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    val r1: res[bool, outcome.Fail] = driver.run_link_pass(?p1);
    if (sel r1.err) {
        project.dnit_project(?p1);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    if (!r1.ok) { bad = 1; }
    val lk1: query.Revision = ut_link_lc(?sA);
    project.dnit_project(?p1);

    val p2r: res[project.Project, outcome.Fail] = ut_back_half(?sA, root);
    if (sel p2r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var p2:                       project.Project   = p2r.ok;
    val set_link_config_input_r2: err[outcome.Fail] = bengine.set_link_config_input(?p2, "out/app"::*u8, "app"::*u8, 0, nil, 0, nil, 0, nil);
    if (sel set_link_config_input_r2.err) {
        project.dnit_project(?p2);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    val r2: res[bool, outcome.Fail] = driver.run_link_pass(?p2);
    if (sel r2.err) {
        project.dnit_project(?p2);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    if (r2.ok) { bad = 1; }
    val lk2: query.Revision = ut_link_lc(?sA);
    if (lk2 != lk1) { bad = 1; }
    project.dnit_project(?p2);

    val src_dir:       str             = ut_cc3(?alloc, root, "/", "src");
    val a_path:        str             = ut_cc3(?alloc, src_dir, "/", "a.mach");
    val a_v2:          str             = "pub fun fa() i32 { val t: i32 = 1; ret t; }\n";
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(a_path, a_v2, str_len(a_v2), 420);
    if (sel write_bytes_r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }

    val p3r: res[project.Project, outcome.Fail] = ut_back_half(?sA, root);
    if (sel p3r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var p3:                       project.Project   = p3r.ok;
    val set_link_config_input_r3: err[outcome.Fail] = bengine.set_link_config_input(?p3, "out/app"::*u8, "app"::*u8, 0, nil, 0, nil, 0, nil);
    if (sel set_link_config_input_r3.err) {
        project.dnit_project(?p3);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    val r3: res[bool, outcome.Fail] = driver.run_link_pass(?p3);
    if (sel r3.err) {
        project.dnit_project(?p3);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    if (!r3.ok) { bad = 1; }
    val lk3: query.Revision = ut_link_lc(?sA);
    if (lk3 == lk2) { bad = 1; }
    project.dnit_project(?p3);

    val p4r: res[project.Project, outcome.Fail] = ut_back_half(?sA, root);
    if (sel p4r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var p4:                       project.Project   = p4r.ok;
    val cg_a_before:              query.Revision    = ut_codegen_lc(?sA, st_a);
    val cg_b_before:              query.Revision    = ut_codegen_lc(?sA, st_b);
    val cg_main_before:           query.Revision    = ut_codegen_lc(?sA, st_main);
    val set_link_config_input_r4: err[outcome.Fail] = bengine.set_link_config_input(?p4, "out/other"::*u8, "app"::*u8, 0, nil, 0, nil, 0, nil);
    if (sel set_link_config_input_r4.err) {
        project.dnit_project(?p4);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    val r4: res[bool, outcome.Fail] = driver.run_link_pass(?p4);
    if (sel r4.err) {
        project.dnit_project(?p4);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    if (!r4.ok)                                        { bad = 1; }
    if (ut_link_lc(?sA) == lk3)                        { bad = 1; }
    if (ut_codegen_lc(?sA, st_a) != cg_a_before)       { bad = 1; }
    if (ut_codegen_lc(?sA, st_b) != cg_b_before)       { bad = 1; }
    if (ut_codegen_lc(?sA, st_main) != cg_main_before) { bad = 1; }
    project.dnit_project(?p4);

    var icon_bytes: [4]u8;
    icon_bytes[0] = 1;
    icon_bytes[1] = 2;
    icon_bytes[2] = 3;
    icon_bytes[3] = 4;
    var ri: of.ResourceInfo;
    ri.icon              = ?icon_bytes[0];
    ri.icon_len          = 4;
    ri.app_manifest      = nil;
    ri.app_manifest_len  = 0;
    ri.version           = "1.0";
    ri.internal_name     = "app";
    ri.original_filename = "other.exe";
    ri.product_name      = "app";
    var loaded: bemit.LoadedImageOptions;
    loaded.options           = of.image_options_default(of.SUBSYSTEM_CONSOLE);
    loaded.options.resources = ?ri;
    loaded.resource          = ?ri;
    loaded.icon_bytes        = vector.init[u8](?alloc);
    loaded.icon_bytes.data   = ?icon_bytes[0];
    loaded.icon_bytes.len    = 4;
    loaded.icon_bytes.cap    = 4;
    loaded.manifest_bytes    = vector.init[u8](?alloc);
    loaded.icon_path         = "assets/app.ico";
    loaded.manifest_path     = nil;

    val p5r: res[project.Project, outcome.Fail] = ut_back_half(?sA, root);
    if (sel p5r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var p5:                       project.Project   = p5r.ok;
    val set_link_config_input_r5: err[outcome.Fail] = bengine.set_link_config_input(?p5, "out/other"::*u8, "app"::*u8, 0, nil, 0, nil, 0, ?loaded);
    if (sel set_link_config_input_r5.err) {
        project.dnit_project(?p5);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    val r5: res[bool, outcome.Fail] = driver.run_link_pass(?p5);
    if (!(sel r5.ok && !(!r5.ok))) { bad = 1; }
    val lk5: query.Revision = ut_link_lc(?sA);
    project.dnit_project(?p5);

    val p6r: res[project.Project, outcome.Fail] = ut_back_half(?sA, root);
    if (sel p6r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var p6:                       project.Project   = p6r.ok;
    val set_link_config_input_r6: err[outcome.Fail] = bengine.set_link_config_input(?p6, "out/other"::*u8, "app"::*u8, 0, nil, 0, nil, 0, ?loaded);
    if (sel set_link_config_input_r6.err) {
        project.dnit_project(?p6);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    val r6: res[bool, outcome.Fail] = driver.run_link_pass(?p6);
    if (!(sel r6.ok && (!(r6.ok) && ut_link_lc(?sA) == lk5))) { bad = 1; }
    project.dnit_project(?p6);

    icon_bytes[3] = 5;
    val p7r: res[project.Project, outcome.Fail] = ut_back_half(?sA, root);
    if (sel p7r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var p7:                       project.Project   = p7r.ok;
    val set_link_config_input_r7: err[outcome.Fail] = bengine.set_link_config_input(?p7, "out/other"::*u8, "app"::*u8, 0, nil, 0, nil, 0, ?loaded);
    if (sel set_link_config_input_r7.err) {
        project.dnit_project(?p7);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    val r7: res[bool, outcome.Fail] = driver.run_link_pass(?p7);
    if (!(sel r7.ok && (!(!r7.ok) && ut_link_lc(?sA) != lk5))) { bad = 1; }
    project.dnit_project(?p7);

    fs.remove_all(?alloc, root);
    session.dnit(?sA);
    ret bad;
}

test "mach.lang.driver:incremental_link_external_content_fingerprint" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var sA:               session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(sA.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?sA);
        ret 1;
    }

    var names: [3]str;
    names[0] = "main.mach";
    names[1] = "a.mach";
    names[2] = "b.mach";
    var texts: [3]str;
    texts[0] = "use uniontest.a.fa;\nuse uniontest.b.fb;\nfun main() i32 { ret fa() + fb(); }\n";
    texts[1] = "pub fun fa() i32 { ret 1; }\n";
    texts[2] = "pub fun fb() i32 { ret 2; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 3);
    if (sel root_r.err) {
        session.dnit(?sA);
        ret 1;
    }
    val root: str = root_r.ok;

    val ext1:          str             = ut_cc3(?alloc, root, "/", "libx.a");
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(ext1, "AAAA", 4, 420);
    if (sel write_bytes_r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var ext_a: [1]*u8;
    ext_a[0] = ext1::*u8;

    var bad: i32 = 0;

    val pAr: res[project.Project, outcome.Fail] = ut_back_half(?sA, root);
    if (sel pAr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var pA:                      project.Project   = pAr.ok;
    val set_link_config_input_r: err[outcome.Fail] = bengine.set_link_config_input(?pA, "out/app"::*u8, "app"::*u8, 0, ?ext_a[0], 1, nil, 0, nil);
    if (sel set_link_config_input_r.err) {
        project.dnit_project(?pA);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    val rlA: res[bool, outcome.Fail] = driver.run_link_pass(?pA);
    if (sel rlA.err) {
        project.dnit_project(?pA);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    if (!rlA.ok) { bad = 1; }
    val lkA: query.Revision = ut_link_lc(?sA);
    project.dnit_project(?pA);

    val pBr: res[project.Project, outcome.Fail] = ut_back_half(?sA, root);
    if (sel pBr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var pB:                       project.Project   = pBr.ok;
    val set_link_config_input_r2: err[outcome.Fail] = bengine.set_link_config_input(?pB, "out/app"::*u8, "app"::*u8, 0, ?ext_a[0], 1, nil, 0, nil);
    if (sel set_link_config_input_r2.err) {
        project.dnit_project(?pB);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    val rlB: res[bool, outcome.Fail] = driver.run_link_pass(?pB);
    if (sel rlB.err) {
        project.dnit_project(?pB);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    if (rlB.ok)                 { bad = 1; }
    if (ut_link_lc(?sA) != lkA) { bad = 1; }
    project.dnit_project(?pB);

    val write_bytes_r2: err[fs.FsError] = fs.write_bytes(ext1, "BBBB", 4, 420);
    if (sel write_bytes_r2.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    val pCr: res[project.Project, outcome.Fail] = ut_back_half(?sA, root);
    if (sel pCr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var pC:                       project.Project   = pCr.ok;
    val set_link_config_input_r3: err[outcome.Fail] = bengine.set_link_config_input(?pC, "out/app"::*u8, "app"::*u8, 0, ?ext_a[0], 1, nil, 0, nil);
    if (sel set_link_config_input_r3.err) {
        project.dnit_project(?pC);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    val rlC: res[bool, outcome.Fail] = driver.run_link_pass(?pC);
    if (sel rlC.err) {
        project.dnit_project(?pC);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    if (!rlC.ok) { bad = 1; }
    val lkC: query.Revision = ut_link_lc(?sA);
    if (lkC == lkA) { bad = 1; }
    project.dnit_project(?pC);

    val ext2:           str             = ut_cc3(?alloc, root, "/", "liby.a");
    val write_bytes_r3: err[fs.FsError] = fs.write_bytes(ext2, "CCCC", 4, 420);
    if (sel write_bytes_r3.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var ext_b: [1]*u8;
    ext_b[0] = ext2::*u8;
    val pDr: res[project.Project, outcome.Fail] = ut_back_half(?sA, root);
    if (sel pDr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var pD:                       project.Project   = pDr.ok;
    val set_link_config_input_r4: err[outcome.Fail] = bengine.set_link_config_input(?pD, "out/app"::*u8, "app"::*u8, 0, ?ext_b[0], 1, nil, 0, nil);
    if (sel set_link_config_input_r4.err) {
        project.dnit_project(?pD);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    val rlD: res[bool, outcome.Fail] = driver.run_link_pass(?pD);
    if (sel rlD.err) {
        project.dnit_project(?pD);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    if (!rlD.ok) { bad = 1; }
    val lkD: query.Revision = ut_link_lc(?sA);
    if (lkD == lkC) { bad = 1; }
    project.dnit_project(?pD);

    val sn_r: res[intern.StrId, A.Error] = intern.intern(?sA.interner, "libfoo");
    if (sel sn_r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var libs: [1]of.DynLib;
    libs[0].name   = sn_r.ok;
    libs[0].soname = libs[0].name;
    libs[0].rpath  = intern.STR_NIL;
    val pEr: res[project.Project, outcome.Fail] = ut_back_half(?sA, root);
    if (sel pEr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var pE:                       project.Project   = pEr.ok;
    val set_link_config_input_r5: err[outcome.Fail] = bengine.set_link_config_input(?pE, "out/app"::*u8, "app"::*u8, 0, ?ext_b[0], 1, ?libs[0], 1, nil);
    if (sel set_link_config_input_r5.err) {
        project.dnit_project(?pE);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    val rlE: res[bool, outcome.Fail] = driver.run_link_pass(?pE);
    if (sel rlE.err) {
        project.dnit_project(?pE);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    if (!rlE.ok) { bad = 1; }
    val lkE: query.Revision = ut_link_lc(?sA);
    if (lkE == lkD) { bad = 1; }
    project.dnit_project(?pE);

    val rp_r: res[intern.StrId, A.Error] = intern.intern(?sA.interner, "/opt/lib");
    if (sel rp_r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    libs[0].rpath = rp_r.ok;
    val pFr: res[project.Project, outcome.Fail] = ut_back_half(?sA, root);
    if (sel pFr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var pF:                       project.Project   = pFr.ok;
    val set_link_config_input_r6: err[outcome.Fail] = bengine.set_link_config_input(?pF, "out/app"::*u8, "app"::*u8, 0, ?ext_b[0], 1, ?libs[0], 1, nil);
    if (sel set_link_config_input_r6.err) {
        project.dnit_project(?pF);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    val rlF: res[bool, outcome.Fail] = driver.run_link_pass(?pF);
    if (sel rlF.err) {
        project.dnit_project(?pF);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    if (!rlF.ok)                { bad = 1; }
    if (ut_link_lc(?sA) == lkE) { bad = 1; }
    project.dnit_project(?pF);

    fs.remove_all(?alloc, root);
    session.dnit(?sA);
    ret bad;
}

test "mach.lang.driver:incremental_test_mode_neutralization_variant" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var sA:               session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(sA.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?sA);
        ret 1;
    }

    var names: [2]str;
    names[0] = "main.mach";
    names[1] = "leaf.mach";
    var texts: [2]str;
    texts[0] = "use uniontest.leaf.fa;\n#[symbol(\"main\")]\nfun runtime_entry() i32 { ret fa(); }\npub fun main() i32 { ret fa(); }\nfun test_only[T](x: T) T { ret x; }\n$if ($mach.build.pointer_width == 8) {\n    test \"variant probe\" { if (test_only[i32](7) != 7) { ret 1; } ret 0; }\n}\n";
    texts[1] = "pub fun fa() i32 { ret 1; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 2);
    if (sel root_r.err) {
        session.dnit(?sA);
        ret 1;
    }
    val root: str = root_r.ok;

    var bad: i32 = 0;

    val p1r: res[project.Project, outcome.Fail] = driver.build_project_union(?sA, root);
    if (sel p1r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var p1: project.Project = p1r.ok;
    p1.req.goal = request.GOAL_TESTS;
    val run_sema_pass_r: err[outcome.Fail] = driver.run_sema_pass(?p1);
    if (sel run_sema_pass_r.err) {
        project.dnit_project(?p1);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    val run_lower_pass_r: err[outcome.Fail] = driver.run_lower_pass(?p1);
    if (sel run_lower_pass_r.err) {
        project.dnit_project(?p1);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    val st_main: session.StableModuleId = ut_stable(?p1, ?sA, "uniontest.main");
    val mid1:    session.ModuleId       = ut_mid(?p1, ?sA, "uniontest.main");
    if (mid1 == session.MODULE_NIL) {
        project.dnit_project(?p1);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    if (ut_mod_main_neutralized(?sA, project.module_at(?p1, mid1::u32).ir_module) != 1)                    { bad = 2; }
    if (!ut_mod_function_defined(?sA, project.module_at(?p1, mid1::u32).ir_module, "uniontest.main.main")) { bad = 10; }
    if (ut_mod_test_count(project.module_at(?p1, mid1::u32).ir_module) != 1)                               { bad = 6; }
    if (ut_mod_flag_count(project.module_at(?p1, mid1::u32).ir_module, ir.FN_FLAG_WEAK) != 1)              { bad = 8; }
    val key_test: u64            = passes.back_half_key(st_main, true);
    val key_norm: u64            = passes.back_half_key(st_main, false);
    val lc_test1: query.Revision = ut_lower_lc_key(?sA, key_test);
    project.dnit_project(?p1);

    val p2r: res[project.Project, outcome.Fail] = driver.build_project_union(?sA, root);
    if (sel p2r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var p2: project.Project = p2r.ok;
    p2.req.goal = request.GOAL_EXECUTE;
    val run_sema_pass_r2: err[outcome.Fail] = driver.run_sema_pass(?p2);
    if (sel run_sema_pass_r2.err) {
        project.dnit_project(?p2);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    val run_lower_pass_r2: err[outcome.Fail] = driver.run_lower_pass(?p2);
    if (sel run_lower_pass_r2.err) {
        project.dnit_project(?p2);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    val mid2: session.ModuleId = ut_mid(?p2, ?sA, "uniontest.main");
    if (mid2 == session.MODULE_NIL) {
        project.dnit_project(?p2);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    if (ut_mod_main_neutralized(?sA, project.module_at(?p2, mid2::u32).ir_module) != 0)       { bad = 3; }
    if (ut_mod_test_count(project.module_at(?p2, mid2::u32).ir_module) != 0)                  { bad = 7; }
    if (ut_mod_flag_count(project.module_at(?p2, mid2::u32).ir_module, ir.FN_FLAG_WEAK) != 0) { bad = 9; }
    if (ut_lower_lc_key(?sA, key_test) != lc_test1)                                           { bad = 4; }
    if (ut_lower_lc_key(?sA, key_norm) == 0xFFFFFFFFFFFFFFFF)                                 { bad = 5; }
    project.dnit_project(?p2);

    fs.remove_all(?alloc, root);
    session.dnit(?sA);
    ret bad;
}

test "mach.lang.driver:embed_asset_edit_invalidates_sema" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    val rr: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [3]str;
    names[0] = "main.mach";
    names[1] = "asset.bin";
    names[2] = "other.mach";
    var texts: [3]str;
    texts[0] = "use uniontest.other;\n\n#[embed(\"asset.bin\")]\nval A: [_]u8;\n\nfun main() i32 { ret A[0]::i32; }\n";
    texts[1] = "abc";
    texts[2] = "pub fun untouched() i32 { ret 1; }\n";

    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 3);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    var bad: i32 = 0;

    val p1r: res[project.Project, outcome.Fail] = ut_sema_build(?s, root);
    if (sel p1r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var p1:         project.Project        = p1r.ok;
    val st_main:    session.StableModuleId = ut_stable(?p1, ?s, "uniontest.main");
    val st_other:   session.StableModuleId = ut_stable(?p1, ?s, "uniontest.other");
    val lc_main_1:  query.Revision         = ut_sema_lc(?s, st_main);
    val lc_other_1: query.Revision         = ut_sema_lc(?s, st_other);
    project.dnit_project(?p1);

    val p2r: res[project.Project, outcome.Fail] = ut_sema_build(?s, root);
    if (sel p2r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var p2: project.Project = p2r.ok;
    if (ut_sema_lc(?s, st_main) != lc_main_1) { bad = 1; }
    project.dnit_project(?p2);

    val src_dir: str             = ut_cc3(?alloc, root, "/", "src");
    val a_path:  str             = ut_cc3(?alloc, src_dir, "/", "asset.bin");
    val new_a:   str             = "wxyz";
    val wr:      err[fs.FsError] = fs.write_bytes(a_path, new_a, str_len(new_a), 420);
    if (sel wr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }

    val p3r: res[project.Project, outcome.Fail] = ut_sema_build(?s, root);
    if (sel p3r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var p3: project.Project = p3r.ok;
    if (ut_sema_lc(?s, st_main) == lc_main_1)   { bad = 1; }
    if (ut_sema_lc(?s, st_other) != lc_other_1) { bad = 1; }
    project.dnit_project(?p3);

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

fun ut_lower_build(s: *session.Session, root: str) res[project.Project, outcome.Fail] {
    val pr: res[project.Project, outcome.Fail] = driver.build_project_union(s, root);
    if (sel pr.err) { ret pr; }
    var p:  project.Project   = pr.ok;
    val se: err[outcome.Fail] = driver.run_sema_pass(?p);
    if (sel se.err) {
        project.dnit_project(?p);
        ret res[project.Project, outcome.Fail].err{se.err};
    }
    val le: err[outcome.Fail] = driver.run_lower_pass(?p);
    if (sel le.err) {
        project.dnit_project(?p);
        ret res[project.Project, outcome.Fail].err{le.err};
    }
    ret res[project.Project, outcome.Fail].ok{p};
}

fun ut_embed_global(p: *project.Project) *ir.Global {
    var ti: u32 = 0;
    for (ti < p.topo_len) {
        val m: *ir.Module = project.module_at(p, p.topo[ti]::u32).ir_module;
        if (m != nil) {
            var gi: u32 = 0;
            for (gi < m.global_len) {
                if (m.globals[gi].is_embed) { ret ?m.globals[gi]; }
                gi = gi + 1;
            }
        }
        ti = ti + 1;
    }
    ret nil;
}

fun ut_embed_bytes_equal(g: *ir.Global, want: str) bool {
    if (g == nil)                                      { ret false; }
    if (g.init.kind != value.VAL_CONST_BYTES)          { ret false; }
    if (g.init.data.bytes.len::usize != str_len(want)) { ret false; }
    if (g.init.data.bytes.ptr == nil)                  { ret str_len(want) == 0::usize; }
    var i: u32 = 0;
    for (i < g.init.data.bytes.len) {
        if (g.init.data.bytes.ptr[i] != want[i::usize]) { ret false; }
        i = i + 1;
    }
    ret true;
}

test "mach.lang.driver:embed_buffer_is_stable_across_warm_rebuilds" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    val rr: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [2]str;
    names[0] = "main.mach";
    names[1] = "asset.bin";
    var texts: [2]str;
    texts[0] = "#[embed(\"asset.bin\")]\nval A: [_]u8;\n\nfun main() i32 { ret A[0]::i32; }\n";
    texts[1] = "abc";

    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 2);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    var bad:     i32 = 0;
    val src_dir: str = ut_cc3(?alloc, root, "/", "src");
    val a_path:  str = ut_cc3(?alloc, src_dir, "/", "asset.bin");

    val p1r: res[project.Project, outcome.Fail] = ut_lower_build(?s, root);
    if (sel p1r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var p1: project.Project = p1r.ok;
    val g1: *ir.Global      = ut_embed_global(?p1);
    if (!ut_embed_bytes_equal(g1, "abc")) { bad = 1; }
    var ptr1: *u8 = nil;
    if (g1 == nil) { bad = 1; }
    or             { ptr1 = g1.init.data.bytes.ptr; }
    val st_main: session.StableModuleId = ut_stable(?p1, ?s, "uniontest.main");
    val lower_1: query.Revision         = ut_lower_lc(?s, st_main);
    project.dnit_project(?p1);

    val p2r: res[project.Project, outcome.Fail] = ut_lower_build(?s, root);
    if (sel p2r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var p2: project.Project = p2r.ok;
    val g2: *ir.Global      = ut_embed_global(?p2);
    if (!ut_embed_bytes_equal(g2, "abc"))            { bad = 1; }
    if (g2 != g1)                                    { bad = 1; }
    if (g2 == nil || g2.init.data.bytes.ptr != ptr1) { bad = 1; }
    if (ut_lower_lc(?s, st_main) != lower_1)         { bad = 1; }
    project.dnit_project(?p2);

    val w1: err[fs.FsError] = fs.write_bytes(a_path, "xyz", 3::usize, 420);
    if (sel w1.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    val p3r: res[project.Project, outcome.Fail] = ut_lower_build(?s, root);
    if (sel p3r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var p3: project.Project = p3r.ok;
    if (!ut_embed_bytes_equal(ut_embed_global(?p3), "xyz")) { bad = 1; }
    val lower_3: query.Revision = ut_lower_lc(?s, st_main);
    if (lower_3 == lower_1) { bad = 1; }
    project.dnit_project(?p3);

    val w2: err[fs.FsError] = fs.write_bytes(a_path, "wxyz!", 5::usize, 420);
    if (sel w2.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    val p4r: res[project.Project, outcome.Fail] = ut_lower_build(?s, root);
    if (sel p4r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var p4: project.Project = p4r.ok;
    if (!ut_embed_bytes_equal(ut_embed_global(?p4), "wxyz!")) { bad = 1; }
    if (ut_lower_lc(?s, st_main) == lower_3)                  { bad = 1; }
    project.dnit_project(?p4);

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.driver.readout:a_phase_counts_what_it_processed" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [2]str;
    names[0] = "main.mach";
    names[1] = "keep.mach";
    var texts: [2]str;
    texts[0] = ut_cc3(?alloc, "use uniontest.keep;\n\n#[symbol(\"", ut_entry_symbol(), "\")]\nfun start() i32 { ret 0; }\n");
    texts[1] = "pub fun keep() i32 { ret 1; }\n\ntest \"keep\" { ret 0; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 2);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    val mr: res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var m:  manifest.Manifest    = mr.ok;
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    rq.goal         = request.GOAL_TEST_LIST;
    val pr: res[bplan.BuildPlan, outcome.Fail] = bplan.plan(?alloc, ?s.interner, s.registry, ?m, rq);
    if (sel pr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var bp: bplan.BuildPlan = pr.ok;

    var ev: readout.Progress;
    readout.init(?ev, ?alloc, readout.LEVEL_PHASES);

    var bad: i32                                     = 0;
    val r:   res[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, ?alloc, ?ev);
    if (sel r.err) { bad = 2; }
    if (sel r.ok) {
        var listed: outcome.BuildOutcome = r.ok;
        if (listed.severity != outcome.BUILD_OK || listed.tests.len != 1) { bad = 3; }
        or {
            if (!str_empty(listed.tests.data[0].exe)) { bad = 4; }
        }
        outcome.outcome_dnit(?listed);
    }

    val ld: u32 = readout.PH_LOAD::u32;
    val rs: u32 = readout.PH_RESOLVE::u32;

    val lm: *readout.PhaseMetrics = ?ev.metrics[ld];
    val rm: *readout.PhaseMetrics = ?ev.metrics[rs];
    if (lm.occurrences == 0) { bad = 3; }
    if (rm.occurrences == 0) { bad = 4; }

    # a test build loads the artifact closure, and every module it loads resolves
    if (lm.dropped != 0) { bad = 5; }

    if (lm.processed != lm.item_count) { bad = 6; }

    if (lm.processed != rm.processed + lm.dropped) { bad = 7; }

    val sm:  *readout.PhaseMetrics = ?ev.metrics[readout.PH_SEMA::u32];
    val lwm: *readout.PhaseMetrics = ?ev.metrics[readout.PH_LOWER::u32];
    val om:  *readout.PhaseMetrics = ?ev.metrics[readout.PH_OPTIMIZE::u32];
    val cm:  *readout.PhaseMetrics = ?ev.metrics[readout.PH_CODEGEN::u32];
    val em:  *readout.PhaseMetrics = ?ev.metrics[readout.PH_EMIT::u32];
    if (sm.occurrences > 0 && sm.processed != sm.item_count)    { bad = 8; }
    if (lwm.occurrences > 0 && lwm.processed != lwm.item_count) { bad = 9; }
    if (om.occurrences > 0 && om.processed != om.item_count)    { bad = 10; }
    if (cm.occurrences != 0 || em.occurrences != 0
        || ev.metrics[readout.PH_LINK::u32].occurrences != 0) { bad = 11; }

    readout.dnit(?ev);
    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

# the ordinal of ph's row in the recorded readout, or -1 without one
fun ut_phase_row(ev: *readout.Progress, ph: u8) i64 {
    var i: usize = 0;
    for (i < ev.events.len) {
        val e: *readout.ProgressEvent = ?ev.events.data[i];
        if (e.kind == readout.PROGRESS_EVENT_PHASE && e.data.phase.phase == ph) { ret i::i64; }
        i = i + 1;
    }
    ret -1;
}

# a cached objects build of root in a fresh session, recorded into ev
fun ut_cached_readout(alloc: *A.Allocator, root: str, ev: *readout.Progress) i32 {
    val sr: res[session.Session, fail.Fail] = session.init(alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) { ret 1; }
    val mr: res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) { ret 1; }
    var m:  manifest.Manifest    = mr.ok;
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    rq.goal         = request.GOAL_OBJECTS;
    rq.object_cache = true;
    val pr: res[bplan.BuildPlan, outcome.Fail] = bplan.plan(alloc, ?s.interner, s.registry, ?m, rq);
    if (sel pr.err) { ret 1; }
    var bp: bplan.BuildPlan = pr.ok;
    readout.init(ev, alloc, readout.LEVEL_ITEMS);
    val r: res[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, alloc, ev);
    if (sel r.err) { ret 2; }
    var built:     outcome.BuildOutcome = r.ok;
    val succeeded: bool                 = built.severity == outcome.BUILD_OK;
    outcome.outcome_dnit(?built);
    if (!succeeded) { ret 2; }
    ret 0;
}

# the cache phase holds the cache items of the lowering operation and its row
# precedes lower's, which reports only the modules it lowered
fun ut_cache_split(ev: *readout.Progress, lowered: u32) i32 {
    val cm: *readout.PhaseMetrics = ?ev.metrics[readout.PH_CACHE::u32];
    val lm: *readout.PhaseMetrics = ?ev.metrics[readout.PH_LOWER::u32];
    if (cm.occurrences != 1 || lm.occurrences != 1) { ret 1; }
    if (cm.processed != lm.processed)               { ret 2; }
    if (lm.item_count != lowered)                   { ret 3; }
    if (cm.item_count < 1 + lm.processed - lowered) { ret 4; }
    if (cm.elapsed < cm.item_elapsed)               { ret 5; }
    val cache_row: i64 = ut_phase_row(ev, readout.PH_CACHE);
    val lower_row: i64 = ut_phase_row(ev, readout.PH_LOWER);
    if (cache_row < 0 || lower_row <= cache_row) { ret 6; }
    var i: usize = 0;
    for (i < ev.events.len) {
        val e: *readout.ProgressEvent = ?ev.events.data[i];
        if (e.kind == readout.PROGRESS_EVENT_ITEM) {
            val cache_item: bool = str_equals(e.data.item.name, "cell snapshot")
                || str_equals(e.data.item.name, "cached object")
                || string.str_starts_with(e.data.item.name, "compiler identity");
            # codegen revalidates the snapshot in its own operation and reports it there
            val home: u8 = e.data.item.phase;
            if (home == readout.PH_CACHE && !cache_item)                              { ret 7; }
            if (cache_item && home != readout.PH_CACHE && home != readout.PH_CODEGEN) { ret 8; }
        }
        i = i + 1;
    }
    ret 0;
}

test "mach.lang.driver.readout:lower_excludes_the_cache_setup_and_restore" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var names: [2]str;
    names[0] = "main.mach";
    names[1] = "leaf.mach";
    var texts: [2]str;
    texts[0] = ut_cc3(?alloc, "use uniontest.leaf;\n\n#[symbol(\"", ut_entry_symbol(), "\")]\nfun start() i32 { ret leaf.one(); }\n");
    texts[1] = "pub fun one() i32 { ret 1; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 2);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?alloc, root); }

    var cold: readout.Progress;
    var bad:  i32 = ut_cached_readout(?alloc, root, ?cold);
    if (bad == 0) {
        val split: i32 = ut_cache_split(?cold, cold.metrics[readout.PH_LOWER::u32].processed);
        if (split != 0) { bad = 10 + split; }
    }
    readout.dnit(?cold);
    if (bad != 0) { ret bad; }

    var warm: readout.Progress;
    bad = ut_cached_readout(?alloc, root, ?warm);
    if (bad == 0) {
        val split: i32 = ut_cache_split(?warm, 0);
        if (split != 0) { bad = 20 + split; }
    }
    readout.dnit(?warm);
    ret bad;
}

test "mach.lang.driver.readout:a_deferred_gate_resolves_each_module_once" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [3]str;
    names[0] = "main.mach";
    names[1] = "helper.mach";
    names[2] = "extra.mach";
    var texts: [3]str;
    # the gate reads a constant from a module imported below it, which the
    # load walks on demand
    texts[0] = ut_cc3(?alloc,
        "$if (helper.FLAG == 1) {\n    use uniontest.extra;\n}\n\nuse uniontest.helper;\n\n#[symbol(\"",
        ut_entry_symbol(), "\")]\nfun start() i32 { ret 0; }\n");
    texts[1] = "pub val FLAG: u8 = 1;\n\ntest \"flag\" { ret 0; }\n";
    texts[2] = "pub fun extra() i32 { ret 3; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 3);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    val mr: res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var m:  manifest.Manifest    = mr.ok;
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    rq.goal         = request.GOAL_OBJECTS;
    val pr: res[bplan.BuildPlan, outcome.Fail] = bplan.plan(?alloc, ?s.interner, s.registry, ?m, rq);
    if (sel pr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var bp: bplan.BuildPlan = pr.ok;

    var ev: readout.Progress;
    readout.init(?ev, ?alloc, readout.LEVEL_PHASES);

    var bad: i32                                     = 0;
    val r:   res[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, ?alloc, ?ev);
    if (sel r.err) { bad = 1; }
    if (sel r.ok) {
        var listed: outcome.BuildOutcome = r.ok;
        if (listed.severity != outcome.BUILD_OK) { bad = 1; }
        outcome.outcome_dnit(?listed);
    }

    val lm: *readout.PhaseMetrics = ?ev.metrics[readout.PH_LOAD::u32];
    val rm: *readout.PhaseMetrics = ?ev.metrics[readout.PH_RESOLVE::u32];

    # the gated arm brings its module in during the deferral loop, which is
    # what makes this fixture take a second resolve pass
    if (lm.processed != rm.processed) { bad = 1; }

    if (rm.occurrences != 1)           { bad = 1; }
    if (rm.processed != 3)             { bad = 1; }
    if (rm.item_count != rm.processed) { bad = 1; }

    readout.dnit(?ev);
    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.driver.readout:a_gate_deferred_module_is_counted_by_the_load_row" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [3]str;
    names[0] = "main.mach";
    names[1] = "helper.mach";
    names[2] = "extra.mach";
    var texts: [3]str;
    # extra enters the build only through a gate on a constant a later `use`
    # imports, which the load walks on demand
    texts[0] = ut_cc3(?alloc,
        "$if (helper.FLAG == 1) {\n    use uniontest.extra;\n}\n\nuse uniontest.helper;\n\n#[symbol(\"",
        ut_entry_symbol(), "\")]\nfun start() i32 { ret 0; }\n");
    texts[1] = "pub val FLAG: u8 = 1;\n\ntest \"flag\" { ret 0; }\n";
    texts[2] = "pub fun extra() i32 { ret 3; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 3);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    val mr: res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var m:  manifest.Manifest    = mr.ok;
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    rq.goal         = request.GOAL_OBJECTS;
    val pr: res[bplan.BuildPlan, outcome.Fail] = bplan.plan(?alloc, ?s.interner, s.registry, ?m, rq);
    if (sel pr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var bp: bplan.BuildPlan = pr.ok;

    var ev: readout.Progress;
    readout.init(?ev, ?alloc, readout.LEVEL_ITEMS);

    var bad: i32                                     = 0;
    val r:   res[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, ?alloc, ?ev);
    if (sel r.err) { bad = 1; }
    if (sel r.ok) {
        var listed: outcome.BuildOutcome = r.ok;
        if (listed.severity != outcome.BUILD_OK) { bad = 1; }
        outcome.outcome_dnit(?listed);
    }

    val lm: *readout.PhaseMetrics = ?ev.metrics[readout.PH_LOAD::u32];
    val rm: *readout.PhaseMetrics = ?ev.metrics[readout.PH_RESOLVE::u32];

    # one load row counts every module the build loaded, including the one
    # behind the gate, so it agrees with the resolve row
    if (lm.occurrences != 1)           { bad = 2; }
    if (lm.processed != 3)             { bad = 3; }
    if (lm.item_count != lm.processed) { bad = 4; }
    if (lm.processed != rm.processed)  { bad = 5; }

    # the load row is rendered before the resolve row
    var load_at:    i64   = -1;
    var resolve_at: i64   = -1;
    var i:          usize = 0;
    for (i < ev.events.len) {
        val e: *readout.ProgressEvent = ?ev.events.data[i];
        if (e.kind == readout.PROGRESS_EVENT_PHASE) {
            if (e.data.phase.phase == readout.PH_LOAD && load_at < 0)       { load_at = i::i64; }
            if (e.data.phase.phase == readout.PH_RESOLVE && resolve_at < 0) { resolve_at = i::i64; }
        }
        i = i + 1;
    }
    if (load_at < 0 || resolve_at < 0 || load_at > resolve_at) { bad = 6; }

    readout.dnit(?ev);
    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

rec LiveBytes {
    backing: A.Allocator;
    live:    i64;
}

fun live_alloc(ctx: ptr, size: usize, align: usize) opt[ptr] {
    val t: *LiveBytes = ctx::*LiveBytes;
    val r: opt[ptr]   = t.backing.fn_allocate(t.backing.ctx, size, align);
    if (sel r.some) { t.live = t.live + size::i64; }
    ret r;
}

fun live_realloc(ctx: ptr, p: ptr, old_size: usize, new_size: usize, align: usize) opt[ptr] {
    val t: *LiveBytes = ctx::*LiveBytes;
    val r: opt[ptr]   = t.backing.fn_reallocate(t.backing.ctx, p, old_size, new_size, align);
    if (sel r.some) { t.live = t.live - old_size::i64 + new_size::i64; }
    ret r;
}

fun live_dealloc(ctx: ptr, p: ptr, size: usize, align: usize) i64 {
    val t: *LiveBytes = ctx::*LiveBytes;
    t.live = t.live - size::i64;
    ret t.backing.fn_deallocate(t.backing.ctx, p, size, align);
}

fun live_bytes_make(t: *LiveBytes, a: *A.Allocator) bool {
    val make_r: err[A.Error] = page.make(?t.backing);
    if (sel make_r.err) { ret false; }
    t.live          = 0;
    a.ctx           = t::ptr;
    a.fn_allocate   = live_alloc;
    a.fn_reallocate = live_realloc;
    a.fn_deallocate = live_dealloc;
    ret true;
}

test "mach.lang.driver:retained_reload_cycle_reaches_steady_state" {
    var lb:    LiveBytes;
    var alloc: A.Allocator;
    if (!live_bytes_make(?lb, ?alloc)) { ret 1; }

    var names: [4]str;
    names[0] = "alpha.mach";
    names[1] = "beta.mach";
    names[2] = "model.mach";
    names[3] = "orphan.mach";
    var texts: [4]str;
    texts[0] = "fun main() i32 { ret no_such(); }\n";
    texts[1] = "use ctxcase.model;\nfun main() i32 { var b: model.Box[model.Leaf]; ret model.take[model.Leaf](b); }\n";
    texts[2] = "pub rec Leaf { n: i32; }\npub rec Box[T] { v: T; }\npub fun take[T](b: Box[T]) i32 { ret 7; }\n";
    texts[3] = "fun broken() NoSuch { var x: AlsoMissing; ret x; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold_m(
        ?alloc, ut_manifest_frontend(), ?names[0], ?texts[0], 4);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;

    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) {
        fs.remove_all(?alloc, root);
        ret 1;
    }
    var s: session.Session = sr.ok;

    var bad:     i32 = 0;
    var settled: i64 = 0;
    var round:   i32 = 0;
    for (round < 5) {
        val mr: res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, root);
        if (sel mr.err) {
            bad = 2;
            brk;
        }
        var mf: manifest.Manifest = mr.ok;

        var req: request.BuildRequest = request.defaults();
        req.project_root = root;
        req.target       = "windows";
        req.profile      = "release";
        req.artifact     = "beta";
        req.want_lib     = false;
        req.goal         = request.GOAL_OBJECTS;
        req.opt          = pipeline.OPT_RELEASE;
        req.pie          = true;

        val pr: res[project.Project, outcome.Fail] = driver.analyze_project(?s, ?mf, ?req, project.ROOT_ARTIFACT, nil, 0);
        if (sel pr.err) {
            manifest.dnit(?mf, ?alloc);
            bad = 3;
            brk;
        }
        var p: project.Project = pr.ok;
        project.dnit_project(?p);
        manifest.dnit(?mf, ?alloc);

        if (round == 2) { settled = lb.live; }
        if (round > 2 && lb.live != settled) {
            bad = 4;
            brk;
        }
        round = round + 1;
    }

    session.dnit(?s);
    fs.remove_all(?alloc, root);
    ret bad;
}

fun ut_manifest_with_dep() str {
    ret "[project]\nmach = \">=5\"\nid = \"ctxcase\"\nversion = \"1.2.3\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.windows]\nisa = \"x86_64\"\nos = \"windows\"\nabi = \"win64\"\n\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n\n[dep.leaf]\npath = \"dep/leaf\"\n\n[artifact.beta]\nkind = \"bin\"\nentry = \"beta.mach\"\nout = \"bin/beta\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
}

fun ut_scaffold_dep(alloc: *A.Allocator, root: str) bool {
    val dep_root:         str             = ut_cc3(alloc, root, "/dep/", "leaf");
    val create_dir_all_r: err[fs.FsError] = fs.create_dir_all(alloc, dep_root, 493);
    if (sel create_dir_all_r.err) { ret false; }
    val dep_src:           str             = ut_cc3(alloc, dep_root, "/", "src");
    val create_dir_all_r2: err[fs.FsError] = fs.create_dir_all(alloc, dep_src, 493);
    if (sel create_dir_all_r2.err) { ret false; }

    val dm:            str             = "[project]\nmach = \">=5\"\nid = \"leaf\"\nversion = \"0.1.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.windows]\nisa = \"x86_64\"\nos = \"windows\"\nabi = \"win64\"\n\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n\n[artifact.leaf]\nkind = \"static\"\nentry = \"leaf.mach\"\nout = \"lib/leaf.a\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
    val dmp:           str             = ut_cc3(alloc, dep_root, "/", manifest.MANIFEST_FILE);
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(dmp, dm, str_len(dm), 420);
    if (sel write_bytes_r.err) { ret false; }

    val ds:             str             = "pub fun leaf_value() i32 { ret 7; }\n";
    val dsp:            str             = ut_cc3(alloc, dep_src, "/", "leaf.mach");
    val write_bytes_r2: err[fs.FsError] = fs.write_bytes(dsp, ds, str_len(ds), 420);
    if (sel write_bytes_r2.err) { ret false; }
    ret true;
}

test "mach.lang.driver:retained_reload_cycle_with_a_dependency_is_steady" {
    var lb:    LiveBytes;
    var alloc: A.Allocator;
    if (!live_bytes_make(?lb, ?alloc)) { ret 1; }

    var names: [1]str;
    names[0] = "beta.mach";
    var texts: [1]str;
    texts[0] = "use leaf.leaf;\nfun main() i32 { ret leaf.leaf_value(); }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold_m(
        ?alloc, ut_manifest_with_dep(), ?names[0], ?texts[0], 1);
    if (sel root_r.err) { ret 2; }
    val root: str = root_r.ok;
    if (!ut_scaffold_dep(?alloc, root)
        || !ut_git_repo(?alloc, root, "https://example.invalid/app.git")) {
        fs.remove_all(?alloc, root);
        ret 3;
    }

    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) {
        fs.remove_all(?alloc, root);
        ret 4;
    }
    var s: session.Session = sr.ok;

    var bad:     i32 = 0;
    var settled: i64 = 0;
    var round:   i32 = 0;
    for (round < 5) {
        val mr: res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, root);
        if (sel mr.err) {
            bad = 5;
            brk;
        }
        var mf: manifest.Manifest = mr.ok;
        if (mf.dep_count == 0) {
            manifest.dnit(?mf, ?alloc);
            bad = 6;
            brk;
        }

        var req: request.BuildRequest = request.defaults();
        req.project_root = root;
        req.target       = "windows";
        req.profile      = "release";
        req.artifact     = "beta";
        req.want_lib     = false;
        req.goal         = request.GOAL_OBJECTS;
        req.opt          = pipeline.OPT_RELEASE;
        req.pie          = true;

        val pr: res[project.Project, outcome.Fail] = driver.analyze_project(?s, ?mf, ?req, project.ROOT_ARTIFACT, nil, 0);
        if (sel pr.err) {
            manifest.dnit(?mf, ?alloc);
            bad = 7;
            brk;
        }
        var p: project.Project = pr.ok;
        project.dnit_project(?p);
        manifest.dnit(?mf, ?alloc);

        if (round == 2) { settled = lb.live; }
        if (round > 2 && lb.live != settled) {
            print.eprintlnf("dependency reload {}: expected {} live bytes, found {}", round, settled, lb.live);
            bad = 8;
            brk;
        }
        round = round + 1;
    }

    session.dnit(?s);
    fs.remove_all(?alloc, root);
    ret bad;
}

rec UtL9Revisions {
    dep:        query.Revision;
    dep_public: query.Revision;
    main_sema:  query.Revision;
    disc_bytes: u32;
    case_count: u32;
}

# builds the scaffolded project once more in the same session, runs sema, and reads the revisions
# of the dependency's surfaces and the dependent's semantic product
fun ut_l9_revisions(alloc: *A.Allocator, s: *session.Session, root: str, out: *UtL9Revisions) i32 {
    val built: res[project.Project, outcome.Fail] = driver.build_project_union(s, root);
    if (sel built.err) { ret 1; }
    var p: project.Project = built.ok;
    fin { project.dnit_project(?p); }
    val run_sema_pass_r: err[outcome.Fail] = driver.run_sema_pass(?p);
    if (sel run_sema_pass_r.err) { ret 2; }
    val dep:  session.StableModuleId = ut_stable(?p, s, "uniontest.api");
    val main: session.StableModuleId = ut_stable(?p, s, "uniontest.main");
    if (dep == session.STABLE_MODULE_NIL || main == session.STABLE_MODULE_NIL) { ret 3; }
    val main_mid: session.ModuleId = ut_mid(?p, s, "uniontest.main");
    val sr:       *sema.SemaResult = project.module_at(?p, main_mid::u32).sema_result;
    if (sr == nil || sr.decl_count < 2) { ret 4; }
    # the projection is read while the pass's installation is live: a later query phase resets it
    out.disc_bytes = type.tag_discriminator_bytes(?s.types, sr.decl_type[1]);
    out.case_count = type.field_count(?s.types, sr.decl_type[1]);
    val typed: res[UtQuerySnapshot, fail.Fail] = ut_query_snapshot(alloc, ?p, query.Q_TYPED_EXPORTS, dep::u64);
    if (sel typed.err) { ret 5; }
    val typed_snapshot: UtQuerySnapshot = typed.ok;
    if (typed_snapshot.value != nil) { A.deallocate[u8](alloc, typed_snapshot.value, typed_snapshot.value_len::usize); }
    out.dep = typed_snapshot.last_changed;
    val public: res[UtQuerySnapshot, fail.Fail] = ut_query_snapshot(alloc, ?p, query.Q_EXPORTS, dep::u64);
    if (sel public.err) { ret 6; }
    val public_snapshot: UtQuerySnapshot = public.ok;
    if (public_snapshot.value != nil) { A.deallocate[u8](alloc, public_snapshot.value, public_snapshot.value_len::usize); }
    out.dep_public = public_snapshot.last_changed;
    val checked: res[UtQuerySnapshot, fail.Fail] = ut_query_snapshot(alloc, ?p, query.Q_SEMA, main::u64);
    if (sel checked.err) { ret 7; }
    val checked_snapshot: UtQuerySnapshot = checked.ok;
    if (checked_snapshot.value != nil) { A.deallocate[u8](alloc, checked_snapshot.value, checked_snapshot.value_len::usize); }
    out.main_sema = checked_snapshot.last_changed;
    ret 0;
}

fun ut_l9_write(alloc: *A.Allocator, root: str, name: str, text: str) bool {
    val src_dir:       str             = ut_cc3(alloc, root, "/", "src");
    val path:          str             = ut_cc3(alloc, src_dir, "/", name);
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(path, text, str_len(text), 420);
    ret sel write_bytes_r.ok;
}

test "mach.lang.driver:tag_discriminator_edit_advances_the_typed_surface_and_replays_dependents" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) { ret 1; }
    var names: [2]str = [2]str{"main.mach", "api.mach"};
    var texts: [2]str;
    texts[0] = "use uniontest.api;\nvar g: api.T;\nfun main() i32 { ret api.helper(); }\n";
    texts[1] = "pub tag T: u8 { a; b: i64; }\npub fun helper() i32 { ret 1; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 2);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?alloc, root); }
    var first: UtL9Revisions;
    val r1:    i32 = ut_l9_revisions(?alloc, ?s, root, ?first);
    if (r1 != 0)                                                                                                    { ret 10 + r1; }
    if (first.disc_bytes != 1)                                                                                      { ret 2; }
    if (!ut_l9_write(?alloc, root, "api.mach", "pub tag T: u16 { a; b: i64; }\npub fun helper() i32 { ret 1; }\n")) { ret 3; }
    var widened: UtL9Revisions;
    val r2:      i32 = ut_l9_revisions(?alloc, ?s, root, ?widened);
    if (r2 != 0)                                                                                                    { ret 20 + r2; }
    if (widened.dep == first.dep || widened.main_sema == first.main_sema)                                           { ret 4; }
    if (widened.disc_bytes != 2)                                                                                    { ret 5; }
    if (!ut_l9_write(?alloc, root, "api.mach", "pub tag T: u16 { a; b: i64; }\npub fun helper() i32 { ret 2; }\n")) { ret 6; }
    var body_only: UtL9Revisions;
    val r3:        i32 = ut_l9_revisions(?alloc, ?s, root, ?body_only);
    if (r3 != 0)                                                                                                                { ret 30 + r3; }
    if (body_only.dep != widened.dep || body_only.dep_public != widened.dep_public || body_only.main_sema != widened.main_sema) { ret 7; }
    if (!ut_l9_write(?alloc, root, "api.mach", "pub tag T: u8 { a; b: i64; }\npub fun helper() i32 { ret 2; }\n"))              { ret 8; }
    var reverted: UtL9Revisions;
    val r4:       i32 = ut_l9_revisions(?alloc, ?s, root, ?reverted);
    if (r4 != 0)                                                                    { ret 40 + r4; }
    if (reverted.dep == body_only.dep || reverted.main_sema == body_only.main_sema) { ret 9; }
    if (reverted.disc_bytes != 1)                                                   { ret 10; }
    ret 0;
}

test "mach.lang.driver:tag_case_list_edit_and_revert_replay_the_typed_surface_and_its_dependents" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) { ret 1; }
    var names: [2]str = [2]str{"main.mach", "api.mach"};
    var texts: [2]str;
    texts[0] = "use uniontest.api;\nvar g: api.T;\nfun main() i32 { g = api.T.b{4}; if (sel g.b) { ret g.b::i32; } ret 0; }\n";
    texts[1] = "pub tag T: u8 { a; b: i64; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 2);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?alloc, root); }
    var first: UtL9Revisions;
    val r1:    i32 = ut_l9_revisions(?alloc, ?s, root, ?first);
    if (r1 != 0)                                                                     { ret 10 + r1; }
    if (first.case_count != 2)                                                       { ret 2; }
    if (!ut_l9_write(?alloc, root, "api.mach", "pub tag T: u8 { a; b: i64; c; }\n")) { ret 3; }
    var grown: UtL9Revisions;
    val r2:    i32 = ut_l9_revisions(?alloc, ?s, root, ?grown);
    if (r2 != 0)                                                                  { ret 20 + r2; }
    if (grown.dep == first.dep || grown.main_sema == first.main_sema)             { ret 4; }
    if (grown.case_count != 3)                                                    { ret 5; }
    if (!ut_l9_write(?alloc, root, "api.mach", "pub tag T: u8 { a; b: i64; }\n")) { ret 6; }
    var reverted: UtL9Revisions;
    val r3:       i32 = ut_l9_revisions(?alloc, ?s, root, ?reverted);
    if (r3 != 0)                                                            { ret 30 + r3; }
    if (reverted.dep == grown.dep || reverted.main_sema == grown.main_sema) { ret 7; }
    if (reverted.case_count != 2)                                           { ret 8; }
    ret 0;
}

fun ut_l9_last_warning_index(s: *session.Session, needle: str) i64 {
    var found: i64   = -1;
    var i:     usize = 0;
    for (i < diagnostic.len(?s.diags)) {
        val d: *diagnostic.Diagnostic = ?s.diags.items.data[i];
        if (d.severity == diagnostic.SEVERITY_WARNING && ut_str_contains(d.message, needle)) { found = i::i64; }
        i = i + 1;
    }
    ret found;
}

test "mach.lang.driver:deprecation_message_edit_and_revert_replay_the_public_surface" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) { ret 1; }
    var names: [2]str = [2]str{"main.mach", "api.mach"};
    var texts: [2]str;
    texts[0] = "use uniontest.api;\nvar g: api.T;\nfun main() i32 { ret api.old(); }\n";
    texts[1] = "pub tag T: u8 { a; b: i64; }\n#[deprecated(\"first\")]\npub fun old() i32 { ret 0; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 2);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?alloc, root); }
    var first: UtL9Revisions;
    val r1:    i32 = ut_l9_revisions(?alloc, ?s, root, ?first);
    if (r1 != 0)                                                                                                                            { ret 10 + r1; }
    if (ut_l9_last_warning_index(?s, "`old` is deprecated: first") < 0 || ut_l9_last_warning_index(?s, "`old` is deprecated: second") >= 0) { ret 2; }
    if (!ut_l9_write(?alloc, root, "api.mach", "pub tag T: u8 { a; b: i64; }\n#[deprecated(\"second\")]\npub fun old() i32 { ret 0; }\n"))  { ret 3; }
    var changed: UtL9Revisions;
    val r2:      i32 = ut_l9_revisions(?alloc, ?s, root, ?changed);
    if (r2 != 0)                                                                                                                            { ret 20 + r2; }
    if (changed.dep_public == first.dep_public || changed.main_sema == first.main_sema)                                                     { ret 4; }
    if (ut_l9_last_warning_index(?s, "`old` is deprecated: second") < 0 || ut_l9_last_warning_index(?s, "`old` is deprecated: first") >= 0) { ret 5; }
    if (!ut_l9_write(?alloc, root, "api.mach", "pub tag T: u8 { a; b: i64; }\n#[deprecated(\"first\")]\npub fun old() i32 { ret 0; }\n"))   { ret 6; }
    var reverted: UtL9Revisions;
    val r3:       i32 = ut_l9_revisions(?alloc, ?s, root, ?reverted);
    if (r3 != 0)                                                                                                                            { ret 30 + r3; }
    if (reverted.dep_public == changed.dep_public || reverted.main_sema == changed.main_sema)                                               { ret 7; }
    if (ut_l9_last_warning_index(?s, "`old` is deprecated: first") < 0 || ut_l9_last_warning_index(?s, "`old` is deprecated: second") >= 0) { ret 8; }
    if (!ut_l9_write(?alloc, root, "api.mach", "pub tag T: u8 { a; b: i64; }\n#[deprecated(\"first\")]\npub fun old() i32 { ret 1; }\n"))   { ret 9; }
    var body_only: UtL9Revisions;
    val r4:        i32 = ut_l9_revisions(?alloc, ?s, root, ?body_only);
    if (r4 != 0)                                                                                  { ret 40 + r4; }
    if (body_only.dep_public != reverted.dep_public || body_only.main_sema != reverted.main_sema) { ret 10; }
    # a cached semantic product replays its warning into every later presentation
    if (ut_l9_last_warning_index(?s, "`old` is deprecated: first") < 0) { ret 11; }
    ret 0;
}

test "mach.lang.driver:gate_diagnostics_stay_visible_on_a_warm_rebuild" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var names:  [1]str              = [1]str{"main.mach"};
    var texts:  [1]str              = [1]str{"$if ($mach.build.os == NATIVE_OS) { def Flag: u8; } $or { def Flag: u16; }\nval C: Flag = 1;\n$if (C) { fun f() i32 { ret 1; } }\nfun main() i32 { ret 0; }\n"};
    var s:      session.Session;
    val root_r: res[str, fail.Fail] = ut_gate_session(?alloc, ?names[0], ?texts[0], 1, ?s);
    if (sel root_r.err) { ret 2; }
    val root: str = root_r.ok;
    fin {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
    }
    var round: u32 = 0;
    for (round < 2) {
        val built: res[project.Project, outcome.Fail] = ut_gate_rebuild(?s, root);
        if (sel built.err) { ret 3 + round::i32; }
        var p:   project.Project = built.ok;
        var bad: i32             = 0;
        # the warm build's hits present the diagnostic the cold build's walk reported
        if (!ut_diag_has(?s.diags, "condition must have type u8")) { bad = 5; }
        project.dnit_project(?p);
        if (bad != 0) { ret bad + round::i32 * 10; }
        round = round + 1;
    }

    # a rejected build: the gate's own `$error` is reported by the cold build and again by the warm one
    if (!ut_write_source(?alloc, root, "main.mach", "def Flag: u8;\nval C: Flag = 1;\n$if (C) { $error(\"gated boom\"); }\nfun main() i32 { ret 0; }\n")) { ret 30; }
    round = 0;
    for (round < 2) {
        val built: res[project.Project, outcome.Fail] = ut_gate_rebuild(?s, root);
        if (sel built.ok) {
            var p: project.Project = built.ok;
            project.dnit_project(?p);
            ret 31;
        }
        if (!ut_diag_has(?s.diags, "gated boom")) { ret 32 + round::i32; }
        round = round + 1;
    }
    ret 0;
}

test "mach.lang.driver:a_typed_gate_load_is_reused_on_a_warm_rebuild" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var names:  [1]str              = [1]str{"main.mach"};
    var texts:  [1]str              = [1]str{"$if ($mach.build.os == NATIVE_OS) { def Flag: u8; } $or { def Flag: u16; }\nval C: Flag = 1;\n$if (C) { fun f() i32 { ret 1; } }\nfun main() i32 { ret 0; }\n"};
    var s:      session.Session;
    val root_r: res[str, fail.Fail] = ut_gate_session(?alloc, ?names[0], ?texts[0], 1, ?s);
    if (sel root_r.err) { ret 2; }
    val root: str = root_r.ok;
    fin {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
    }
    var cold_diags: diagnostic.DiagnosticStore = diagnostic.store_init(?alloc);
    fin { diagnostic.store_dnit(?cold_diags); }
    var warm_diags: diagnostic.DiagnosticStore = diagnostic.store_init(?alloc);
    fin { diagnostic.store_dnit(?warm_diags); }

    val cold: res[project.Project, outcome.Fail] = ut_gate_rebuild(?s, root);
    if (sel cold.err) { ret 3; }
    var p:         project.Project = cold.ok;
    val cold_copy: err[fail.Fail]  = diagnostic.replay_into(?cold_diags, ?s.diags);
    project.dnit_project(?p);
    if (sel cold_copy.err) { ret 4; }

    # the warm build finds every product the cold build made (#3536)
    val warm: res[project.Project, outcome.Fail] = ut_gate_rebuild(?s, root);
    if (sel warm.err) { ret 6; }
    p = warm.ok;
    val warm_copy:  err[fail.Fail] = diagnostic.replay_into(?warm_diags, ?s.diags);
    val recomputed: u32            = ut_frontend_computes(?p);
    project.dnit_project(?p);
    if (sel warm_copy.err) { ret 7; }
    if (recomputed != 0)   { ret 12; }
    val same: res[bool, fail.Fail] = diagnostic.content_equal(?cold_diags, ?warm_diags);
    if (sel same.err)                                             { ret 9; }
    if (!same.ok)                                                 { ret 10; }
    if (!ut_diag_has(?warm_diags, "condition must have type u8")) { ret 11; }
    ret 0;
}

# the resolve, export and sema products a build computed rather than reused
fun ut_frontend_computes(p: *project.Project) u32 {
    ret p.computes[query.Q_RESOLVE::u32] + p.computes[query.Q_EXPORTS::u32] + p.computes[query.Q_SEMA::u32]
        + p.computes[query.Q_TYPED_EXPORTS::u32];
}

val UT_VIEW_MAIN: str = "$if (helper.FLAG == 1) {\n    use uniontest.extra;\n    fun pick() i32 { ret extra.extra(); }\n}\n$or {\n    fun pick() i32 { ret 7; }\n}\n\nuse uniontest.helper;\n\nfun main() i32 { ret pick(); }\n";

rec UtViewCounts {
    topo:    u32;
    extra:   bool;
    views:   u32;
    resolve: u32;
}

fun ut_view_counts(p: *project.Project, s: *session.Session) UtViewCounts {
    var c:     UtViewCounts     = UtViewCounts{topo: p.topo_len};
    val extra: session.ModuleId = ut_mid(p, s, "uniontest.extra");
    var i:     u32              = 0;
    for (i < p.topo_len) {
        if (p.topo[i] == extra) { c.extra = true; }
        i = i + 1;
    }
    c.views   = query.shard_len(?s.queries, query.Q_LOAD_VIEW);
    c.resolve = query.shard_len(?s.queries, query.Q_RESOLVE);
    ret c;
}

# the answer a fresh session gives for the same sources
fun ut_cold_view_counts(alloc: *A.Allocator, flag: str, out: *UtViewCounts) bool {
    var names:  [3]str              = [3]str{"main.mach", "helper.mach", "extra.mach"};
    var texts:  [3]str              = [3]str{UT_VIEW_MAIN, flag, "pub fun extra() i32 { ret 3; }\n"};
    var s:      session.Session;
    val root_r: res[str, fail.Fail] = ut_gate_session(alloc, ?names[0], ?texts[0], 3, ?s);
    if (sel root_r.err) { ret false; }
    val built: res[project.Project, outcome.Fail] = ut_gate_rebuild(?s, root_r.ok);
    var ok:    bool                               = sel built.ok;
    if (sel built.ok) {
        var p: project.Project = built.ok;
        @out = ut_view_counts(?p, ?s);
        project.dnit_project(?p);
    }
    fs.remove_all(alloc, root_r.ok);
    session.dnit(?s);
    ret ok;
}

# a typed input flipping back and forth reaches the cold answer every time, and the views and products the
# session holds return to the same count for the same sources, so a long-lived session does not accumulate them
test "mach.lang.driver:flipping_a_gate_input_reaches_the_cold_view_and_holds_a_steady_cache" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var want_on:  UtViewCounts;
    var want_off: UtViewCounts;
    if (!ut_cold_view_counts(?alloc, UT_VIEW_CFG_ON, ?want_on))   { ret 2; }
    if (!ut_cold_view_counts(?alloc, UT_VIEW_CFG_OFF, ?want_off)) { ret 3; }
    if (!want_on.extra || want_off.extra)                         { ret 4; }

    var names:  [3]str              = [3]str{"main.mach", "helper.mach", "extra.mach"};
    var texts:  [3]str              = [3]str{UT_VIEW_MAIN, UT_VIEW_CFG_ON, "pub fun extra() i32 { ret 3; }\n"};
    var s:      session.Session;
    val root_r: res[str, fail.Fail] = ut_gate_session(?alloc, ?names[0], ?texts[0], 3, ?s);
    if (sel root_r.err) { ret 5; }
    val root: str = root_r.ok;
    fin {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
    }
    var steady: [2]UtViewCounts;
    var round:  u32 = 0;
    for (round < 8) {
        val on:   bool = round % 2 == 0;
        var flag: str  = UT_VIEW_CFG_OFF;
        if (on)                                                               { flag = UT_VIEW_CFG_ON; }
        if (round > 0 && !ut_write_source(?alloc, root, "helper.mach", flag)) { ret 6; }
        val built: res[project.Project, outcome.Fail] = ut_gate_rebuild(?s, root);
        if (sel built.err) { ret 10 + round::i32; }
        var p:    project.Project = built.ok;
        val got:  UtViewCounts    = ut_view_counts(?p, ?s);
        var bad:  i32             = 0;
        var want: UtViewCounts    = want_off;
        if (on)                                               { want = want_on; }
        if (got.topo != want.topo || got.extra != want.extra) { bad = 20; }
        var k: u32 = 1;
        if (on) { k = 0; }
        # the first visit to each state may still hold the other state's views; from the second on they are steady
        if (round >= 2) {
            if (round < 4)                                                        { steady[k] = got; }
            or (got.views != steady[k].views || got.resolve != steady[k].resolve) { bad = 40; }
        }
        project.dnit_project(?p);
        if (bad != 0) { ret bad + round::i32; }
        round = round + 1;
    }
    ret 0;
}

# the products a module owns in the session, whether or not the last build loaded it
fun ut_owned(s: *session.Session, fqn: str) u32 {
    val idr: res[intern.StrId, A.Error] = intern.intern(?s.interner, fqn);
    if (sel idr.err) { ret 0; }
    val stable: session.StableModuleId = session.stable_module_id_lookup(s, idr.ok);
    if (stable == session.STABLE_MODULE_NIL) { ret 0; }
    ret query.owned_len(?s.queries, query.KEY_MODULE, stable::u32);
}

# the module's products counted from the kinds this test names, not from the query's own owner table
fun ut_keyed(s: *session.Session, fqn: str) u32 {
    val idr: res[intern.StrId, A.Error] = intern.intern(?s.interner, fqn);
    if (sel idr.err) { ret 0; }
    val stable: session.StableModuleId = session.stable_module_id_lookup(s, idr.ok);
    if (stable == session.STABLE_MODULE_NIL) { ret 0; }
    var kinds: [7]query.QueryKind = [7]query.QueryKind{query.Q_RESOLVE, query.Q_EXPORTS,
        query.Q_LOAD_VIEW, query.Q_SEMA, query.Q_TYPED_EXPORTS, query.Q_MODULE_NUMBER, query.Q_LOWERED_SURFACE};
    var total: u32 = 0;
    var k:     u32 = 0;
    for (k < 7) {
        if (kinds[k]::u32 < s.queries.kinds) {
            val sh: *query.QueryShard = ?s.queries.storage[kinds[k]::u32];
            var j:  usize             = 0;
            for (j < sh.index.len) {
                if (sh.index.data[j].key::u32 == stable::u32) { total = total + 1; }
                j = j + 1;
            }
        }
        k = k + 1;
    }
    ret total;
}

fun ut_held(s: *session.Session, fqn: str) bool {
    val idr: res[intern.StrId, A.Error] = intern.intern(?s.interner, fqn);
    if (sel idr.err) { ret false; }
    ret retention.holds(?s.retention, retention.RETAINER_SESSION, session.stable_module_id_lookup(s, idr.ok));
}

fun ut_products(s: *session.Session) u32 {
    var total: u32 = 0;
    var kind:  u32 = 0;
    for (kind < s.queries.kinds) {
        total = total + query.shard_len(?s.queries, kind::query.QueryKind);
        kind  = kind + 1;
    }
    ret total;
}

# main importing `name`, or importing nothing for an empty name
fun ut_retained_main(alloc: *A.Allocator, name: str) str {
    if (str_empty(name)) { ret "fun main() i32 { ret 0; }\n"; }
    val used: str = ut_cc3(alloc, "use uniontest.", name, ";\nfun main() i32 { ret ");
    ret ut_cc3(alloc, used, name, ".f(); }\n");
}

fun ut_retained_build(alloc: *A.Allocator, s: *session.Session, root: str, name: str) bool {
    if (!ut_write_source(alloc, root, "main.mach", ut_retained_main(alloc, name))) { ret false; }
    val built: res[project.Project, outcome.Fail] = ut_gate_rebuild(s, root);
    if (sel built.err) { ret false; }
    var p: project.Project = built.ok;
    project.dnit_project(?p);
    ret true;
}

test "mach.lang.driver.retention:a_module_that_leaves_the_build_releases_its_products_and_comes_back_cold" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var names: [4]str = [4]str{"main.mach", "a.mach", "b.mach", "c.mach"};
    var texts: [4]str = [4]str{"use uniontest.a;\nfun main() i32 { ret a.f(); }\n", "pub fun f() i32 { ret 1; }\n",
        "pub fun f() i32 { ret 2; }\n", "pub fun f() i32 { ret 3; }\n"};
    var s:      session.Session;
    val root_r: res[str, fail.Fail] = ut_gate_session(?alloc, ?names[0], ?texts[0], 4, ?s);
    if (sel root_r.err) { ret 2; }
    val root: str = root_r.ok;
    fin {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
    }

    val cold: res[project.Project, outcome.Fail] = ut_gate_rebuild(?s, root);
    if (sel cold.err) { ret 3; }
    var p:      project.Project  = cold.ok;
    val a_mid:  session.ModuleId = ut_mid(?p, ?s, "uniontest.a");
    var a_file: u32              = 0;
    if (a_mid != session.MODULE_NIL) { a_file = project.module_at(?p, a_mid::u32).file_id::u32; }
    project.dnit_project(?p);
    if (a_mid == session.MODULE_NIL || ut_owned(?s, "uniontest.a") == 0 || ut_keyed(?s, "uniontest.a") == 0) { ret 4; }
    if (query.owned_len(?s.queries, query.KEY_FILE, a_file) == 0)                                            { ret 5; }

    # the import goes: nothing of the module stays
    if (!ut_retained_build(?alloc, ?s, root, ""))                             { ret 6; }
    if (ut_owned(?s, "uniontest.a") != 0 || ut_keyed(?s, "uniontest.a") != 0) { ret 7; }
    if (query.owned_len(?s.queries, query.KEY_FILE, a_file) != 0)             { ret 8; }
    if (ut_owned(?s, "uniontest.main") == 0)                                  { ret 9; }
    if (retention.held_count(?s.retention) != 1)                              { ret 10; }

    # it comes back: resolve computes it again, beside the edited main, rather than finding a stale product
    if (!ut_write_source(?alloc, root, "main.mach", ut_retained_main(?alloc, "a"))) { ret 11; }
    val back: res[project.Project, outcome.Fail] = ut_gate_rebuild(?s, root);
    if (sel back.err) { ret 12; }
    p = back.ok;
    var bad: i32 = 0;
    if (p.computes[query.Q_RESOLVE::u32] < 2)                { bad = 13; }
    if (ut_mid(?p, ?s, "uniontest.a") == session.MODULE_NIL) { bad = 14; }
    project.dnit_project(?p);
    if (bad != 0)                         { ret bad; }
    if (ut_owned(?s, "uniontest.a") == 0) { ret 15; }

    # alternating imports hold the session at one size once every module has been seen
    var picks:    [3]str = [3]str{"b", "c", "a"};
    var baseline: u32    = 0;
    var round:    u32    = 0;
    for (round < 12) {
        if (!ut_retained_build(?alloc, ?s, root, picks[round % 3])) { ret 16; }
        if (!ut_retained_build(?alloc, ?s, root, ""))               { ret 17; }
        val products: u32 = ut_products(?s);
        if (round == 3)                                                                                               { baseline = products; }
        if (round > 3 && products != baseline)                                                                        { ret 18; }
        if (ut_owned(?s, "uniontest.a") != 0 || ut_owned(?s, "uniontest.b") != 0 || ut_owned(?s, "uniontest.c") != 0) { ret 19; }
        round = round + 1;
    }
    ret 0;
}

test "mach.lang.driver.retention:a_run_of_rejected_loads_holds_what_the_first_one_held" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    # each keystroke of an import names a module that exists, and a later import that does not rejects the load
    var typed: [15]str = [15]str{"p", "pa", "pac", "pack", "packa", "packag", "package", "package_", "package_m",
        "package_ma", "package_man", "package_mani", "package_manif", "package_manife", "package_manifes"};
    var names: [17]str;
    var texts: [17]str;
    names[0] = "main.mach";
    texts[0] = "use uniontest.a;\nfun main() i32 { ret a.f(); }\n";
    names[1] = "a.mach";
    texts[1] = "pub fun f() i32 { ret 1; }\n";
    var k: u32 = 0;
    for (k < 15) {
        names[k + 2] = ut_cc3(?alloc, typed[k], ".mach", "");
        texts[k + 2] = "pub fun f() i32 { ret 2; }\n";
        k            = k + 1;
    }
    var s:      session.Session;
    val root_r: res[str, fail.Fail] = ut_gate_session(?alloc, ?names[0], ?texts[0], 17, ?s);
    if (sel root_r.err) { ret 2; }
    val root: str = root_r.ok;
    fin {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
    }
    if (!ut_retained_build(?alloc, ?s, root, "a")) { ret 3; }

    var first: usize = 0;
    k = 0;
    for (k < 15) {
        val used: str = ut_cc3(?alloc, "use uniontest.", typed[k], ";\nuse uniontest.nope;\nfun main() i32 { ret 0; }\n");
        if (!ut_write_source(?alloc, root, "main.mach", used)) { ret 4; }
        val built: res[project.Project, outcome.Fail] = ut_gate_rebuild(?s, root);
        if (sel built.ok) {
            var p: project.Project = built.ok;
            project.dnit_project(?p);
            ret 5;
        }
        if (!ut_held(?s, ut_cc3(?alloc, "uniontest.", typed[k], ""))) { ret 6; }
        if (k == 0)                                                   { first = retention.held_count(?s.retention); }
        k = k + 1;
    }
    if (first == 0 || retention.held_count(?s.retention) != first) { ret 7; }
    # the last accepted build's modules stay, an earlier rejection's go
    if (ut_owned(?s, "uniontest.a") == 0)                                        { ret 8; }
    if (ut_held(?s, "uniontest.p") || !ut_held(?s, "uniontest.package_manifes")) { ret 9; }
    ret 0;
}
