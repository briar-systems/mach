test "mach.lang.driver:incremental_lower_surface_firewall" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var sA:               session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(sA.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?sA);
        ret 1;
    }

    var names: [2]str;
    names[0] = "main.mach";
    names[1] = "leaf.mach";
    var texts: [2]str;
    texts[0] = "use uniontest.leaf.plain;\nuse uniontest.leaf.wrap;\nfun main() i32 { ret plain() + wrap[i32](2); }\n";
    texts[1] = "pub fun plain() i32 { ret 1; }\npub fun wrap[T](x: T) T { ret x; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 2);
    if (sel root_r.err) {
        session.dnit(?sA);
        ret 1;
    }
    val root: str = root_r.ok;

    var bad: i32 = 0;

    val p1r: res[project.Project, outcome.Fail] = ut_back_half(?sA, root);
    if (sel p1r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var p1:        project.Project        = p1r.ok;
    val st_main:   session.StableModuleId = ut_stable(?p1, ?sA, "uniontest.main");
    val st_leaf:   session.StableModuleId = ut_stable(?p1, ?sA, "uniontest.leaf");
    val lo_main_1: query.Revision         = ut_lower_lc(?sA, st_main);
    val cg_main_1: query.Revision         = ut_codegen_lc(?sA, st_main);
    val lo_leaf_1: query.Revision         = ut_lower_lc(?sA, st_leaf);
    val sf_leaf_1: query.Revision         = ut_surface_lc(?sA, st_leaf);
    project.dnit_project(?p1);

    val src_dir:   str = ut_cc3(?alloc, root, "/", "src");
    val leaf_path: str = ut_cc3(?alloc, src_dir, "/", "leaf.mach");

    val leaf_v2:       str             = "pub fun plain() i32 { ret 2; }\npub fun wrap[T](x: T) T { ret x; }\n";
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(leaf_path, leaf_v2, str_len(leaf_v2), 420);
    if (sel write_bytes_r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    val p2r: res[project.Project, outcome.Fail] = ut_back_half(?sA, root);
    if (sel p2r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var p2:        project.Project = p2r.ok;
    val lo_main_2: query.Revision  = ut_lower_lc(?sA, st_main);
    val cg_main_2: query.Revision  = ut_codegen_lc(?sA, st_main);
    val lo_leaf_2: query.Revision  = ut_lower_lc(?sA, st_leaf);
    val sf_leaf_2: query.Revision  = ut_surface_lc(?sA, st_leaf);
    project.dnit_project(?p2);
    if (sf_leaf_2 != sf_leaf_1) { bad = 1; }
    if (lo_leaf_2 == lo_leaf_1) { bad = 1; }
    if (lo_main_2 != lo_main_1) { bad = 1; }
    if (cg_main_2 != cg_main_1) { bad = 1; }

    val leaf_v3:        str             = "pub fun plain() i32 { ret 2; }\npub fun wrap[T](x: T) T { val y: T = x; ret y; }\n";
    val write_bytes_r2: err[fs.FsError] = fs.write_bytes(leaf_path, leaf_v3, str_len(leaf_v3), 420);
    if (sel write_bytes_r2.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    val p3r: res[project.Project, outcome.Fail] = ut_back_half(?sA, root);
    if (sel p3r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var p3:        project.Project = p3r.ok;
    val lo_main_3: query.Revision  = ut_lower_lc(?sA, st_main);
    val sf_leaf_3: query.Revision  = ut_surface_lc(?sA, st_leaf);
    project.dnit_project(?p3);
    if (sf_leaf_3 == sf_leaf_2) { bad = 1; }
    if (lo_main_3 == lo_main_2) { bad = 1; }

    fs.remove_all(?alloc, root);
    session.dnit(?sA);
    ret bad;
}

