    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(sA.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?sA);
        ret 1;
    }

    var names: [2]str;
    names[0] = "main.mach";
    names[1] = "leaf.mach";
    var texts: [2]str;
    texts[0] = "use uniontest.leaf.fa;\nfun main() i32 { ret fa()::i32; }\n";
    texts[1] = "pub fun fa() i32 { ret 1; }\n";

    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 2);
    if (sel root_r.err) {
        session.dnit(?sA);
        ret 1;
    }
    val root: str = root_r.ok;

    var bad: i32 = 0;

    val pA1r: res[project.Project, outcome.Fail] = driver.build_project_union(?sA, root);
    if (sel pA1r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var pA1:             project.Project   = pA1r.ok;
    val run_sema_pass_r: err[outcome.Fail] = driver.run_sema_pass(?pA1);
    if (sel run_sema_pass_r.err) {
        project.dnit_project(?pA1);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    val st_main:   session.StableModuleId = ut_stable(?pA1, ?sA, "uniontest.main");
    val lc_main_1: query.Revision         = ut_sema_lc(?sA, st_main);
    project.dnit_project(?pA1);

    val src_dir:       str             = ut_cc3(?alloc, root, "/", "src");
    val leaf_path:     str             = ut_cc3(?alloc, src_dir, "/", "leaf.mach");
    val leaf_v2:       str             = "pub fun fa() i64 { ret 1; }\n";
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(leaf_path, leaf_v2, str_len(leaf_v2), 420);
    if (sel write_bytes_r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }

    val pA2r: res[project.Project, outcome.Fail] = driver.build_project_union(?sA, root);
    if (sel pA2r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var pA2:              project.Project   = pA2r.ok;
    val run_sema_pass_r2: err[outcome.Fail] = driver.run_sema_pass(?pA2);
    if (sel run_sema_pass_r2.err) {
        project.dnit_project(?pA2);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }

    if (ut_sema_lc(?sA, st_main) == lc_main_1) { bad = 1; }

    val sr2: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr2.err) {
        project.dnit_project(?pA2);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var sB:                session.Session   = sr2.ok;
    val setup_registry_r2: err[outcome.Fail] = driver.setup_registry(sB.registry);
    if (sel setup_registry_r2.err) {
        session.dnit(?sB);
        project.dnit_project(?pA2);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    val pBr: res[project.Project, outcome.Fail] = driver.build_project_union(?sB, root);
    if (sel pBr.err) {
        session.dnit(?sB);
        project.dnit_project(?pA2);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var pB:               project.Project   = pBr.ok;
    val run_sema_pass_r3: err[outcome.Fail] = driver.run_sema_pass(?pB);
    if (sel run_sema_pass_r3.err) {
        project.dnit_project(?pB);
        session.dnit(?sB);
        project.dnit_project(?pA2);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }

    if (!sr_struct_equal(?sA, ut_sr_of(?pA2, ?sA, "uniontest.main"), ?sB, ut_sr_of(?pB, ?sB, "uniontest.main"))) { bad = 1; }
    if (!sr_struct_equal(?sA, ut_sr_of(?pA2, ?sA, "uniontest.leaf"), ?sB, ut_sr_of(?pB, ?sB, "uniontest.leaf"))) { bad = 1; }

    project.dnit_project(?pB);
    session.dnit(?sB);
    project.dnit_project(?pA2);
    fs.remove_all(?alloc, root);
    session.dnit(?sA);
    ret bad;
}

test "mach.lang.driver:incremental_sema_field_type_change_equals_scratch" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var sA:               session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(sA.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?sA);
        ret 1;
    }

    var names: [2]str;
    names[0] = "main.mach";
    names[1] = "leaf.mach";
    var texts: [2]str;
    texts[0] = "use uniontest.leaf.P;\nfun main() i64 { var p: P; p.x = 1; ret p.x::i64; }\n";
    texts[1] = "pub rec P { x: i32; }\n";

    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 2);
    if (sel root_r.err) {
        session.dnit(?sA);
        ret 1;
    }
    val root: str = root_r.ok;

    var bad: i32 = 0;

    val pA1r: res[project.Project, outcome.Fail] = driver.build_project_union(?sA, root);
    if (sel pA1r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var pA1:             project.Project   = pA1r.ok;
    val run_sema_pass_r: err[outcome.Fail] = driver.run_sema_pass(?pA1);
    if (sel run_sema_pass_r.err) {
        project.dnit_project(?pA1);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    val st_main:        session.StableModuleId = ut_stable(?pA1, ?sA, "uniontest.main");
    val lc_sema_main_1: query.Revision         = ut_sema_lc(?sA, st_main);
    val lc_res_main_1:  query.Revision         = ut_resolve_lc(?sA, st_main);
    project.dnit_project(?pA1);

    val src_dir:       str             = ut_cc3(?alloc, root, "/", "src");
    val leaf_path:     str             = ut_cc3(?alloc, src_dir, "/", "leaf.mach");
    val leaf_v2:       str             = "pub rec P { x: i64; }\n";
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(leaf_path, leaf_v2, str_len(leaf_v2), 420);
    if (sel write_bytes_r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }

    val pA2r: res[project.Project, outcome.Fail] = driver.build_project_union(?sA, root);
    if (sel pA2r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var pA2:              project.Project   = pA2r.ok;
    val run_sema_pass_r2: err[outcome.Fail] = driver.run_sema_pass(?pA2);
    if (sel run_sema_pass_r2.err) {
        project.dnit_project(?pA2);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }

    if (ut_resolve_lc(?sA, st_main) != lc_res_main_1) { bad = 1; }
    if (ut_sema_lc(?sA, st_main) == lc_sema_main_1)   { bad = 1; }

    val sr2: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr2.err) {
        project.dnit_project(?pA2);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var sB:                session.Session   = sr2.ok;
    val setup_registry_r2: err[outcome.Fail] = driver.setup_registry(sB.registry);
    if (sel setup_registry_r2.err) {
        session.dnit(?sB);
        project.dnit_project(?pA2);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    val pBr: res[project.Project, outcome.Fail] = driver.build_project_union(?sB, root);
    if (sel pBr.err) {
        session.dnit(?sB);
        project.dnit_project(?pA2);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var pB:               project.Project   = pBr.ok;
    val run_sema_pass_r3: err[outcome.Fail] = driver.run_sema_pass(?pB);
    if (sel run_sema_pass_r3.err) {
        project.dnit_project(?pB);
        session.dnit(?sB);
        project.dnit_project(?pA2);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }

    if (!sr_struct_equal(?sA, ut_sr_of(?pA2, ?sA, "uniontest.main"), ?sB, ut_sr_of(?pB, ?sB, "uniontest.main"))) { bad = 1; }
    if (!sr_struct_equal(?sA, ut_sr_of(?pA2, ?sA, "uniontest.leaf"), ?sB, ut_sr_of(?pB, ?sB, "uniontest.leaf"))) { bad = 1; }

    project.dnit_project(?pB);
    session.dnit(?sB);
    project.dnit_project(?pA2);
    fs.remove_all(?alloc, root);
    session.dnit(?sA);
    ret bad;
}

