pub fun ut_scaffold(alloc: *A.Allocator, names: *str, texts: *str, n: u32) res[str, fail.Fail] {
    ret ut_scaffold_m(alloc, ut_manifest(), names, texts, n);
}

pub fun ut_union_native_os_id() u32 {
    ret target.host_os_id();
}

# text with NATIVE_OS spelled as the host os and FOREIGN_OS as another the union builds
pub fun ut_union_native_text(alloc: *A.Allocator, text: str) res[str, fail.Fail] {
    val native:  u32 = ut_union_native_os_id();
    var name:    str = "$mach.os.linux";
    var foreign: str = "$mach.os.windows";
    if (native == os.OS_WINDOWS) {
        name    = "$mach.os.windows";
        foreign = "$mach.os.linux";
    }
    or (native == os.OS_DARWIN) { name = "$mach.os.darwin"; }
    val native_r: res[str, string.StrError] = str_replace(alloc, text, "NATIVE_OS", name);
    if (sel native_r.err) { ret res[str, fail.Fail].err{fail.str_refused(native_r.err)}; }
    val foreign_r: res[str, string.StrError] = str_replace(alloc, native_r.ok, "FOREIGN_OS", foreign);
    if (sel foreign_r.err) { ret res[str, fail.Fail].err{fail.str_refused(foreign_r.err)}; }
    ret res[str, fail.Fail].ok{foreign_r.ok};
}

pub fun ut_target_sel(target_name: str) manifest.Selection {
    var pick: manifest.Selection;
    pick.target       = target_name;
    pick.profile      = "";
    pick.artifact     = "";
    pick.want_lib     = false;
    pick.has_artifact = false;
    ret pick;
}

pub fun ut_scaffold_m(alloc: *A.Allocator, manifest_text: str, names: *str, texts: *str, n: u32) res[str, fail.Fail] {
    val tf_r: res[fs.TempFile, fs.FsError] = fs.temp_create(alloc, "mach_union_test");
    if (sel tf_r.err) { ret res[str, fail.Fail].err{fail.fs_refused(tf_r.err)}; }
    var tf:    fs.TempFile       = tf_r.ok;
    val dup_r: res[str, A.Error] = str_dup(alloc, fs.temp_path(?tf));
    fs.temp_close_and_remove(?tf);
    if (sel dup_r.err) { ret res[str, fail.Fail].err{fail.refused(dup_r.err)}; }
    val root: str = dup_r.ok;

    val d1: err[fs.FsError] = fs.create_dir_all(alloc, root, 493);
    if (sel d1.err) { ret res[str, fail.Fail].err{fail.fs_refused(d1.err)}; }
    val src_dir: str             = ut_cc3(alloc, root, "/", "src");
    val d2:      err[fs.FsError] = fs.create_dir_all(alloc, src_dir, 493);
    if (sel d2.err) { ret res[str, fail.Fail].err{fail.fs_refused(d2.err)}; }

    val mf: str             = ut_cc3(alloc, root, "/", manifest.MANIFEST_FILE);
    val w0: err[fs.FsError] = fs.write_bytes(mf, manifest_text, str_len(manifest_text), 420);
    if (sel w0.err) { ret res[str, fail.Fail].err{fail.fs_refused(w0.err)}; }

    var i: u32 = 0;
    for (i < n) {
        val fp: str             = ut_cc3(alloc, src_dir, "/", names[i]);
        val w:  err[fs.FsError] = fs.write_bytes(fp, texts[i], str_len(texts[i]), 420);
        if (sel w.err) { ret res[str, fail.Fail].err{fail.fs_refused(w.err)}; }
        i = i + 1;
    }
    ret res[str, fail.Fail].ok{root};
}

pub fun ut_str_contains(hay: str, needle: str) bool {
    val hn: usize = str_len(hay);
    val nn: usize = str_len(needle);
    if (nn == 0) { ret true; }
    if (nn > hn) { ret false; }
    var i: usize = 0;
    for (i + nn <= hn) {
        var k: usize = 0;
        for (k < nn && hay[i + k] == needle[k]) { k = k + 1; }
        if (k == nn) { ret true; }
        i = i + 1;
    }
    ret false;
}

pub fun ut_write_node(alloc: *A.Allocator, dir: str, manifest_text: str, src_name: str, src_text: str) err[fail.Fail] {
    val d1: err[fs.FsError] = fs.create_dir_all(alloc, dir, 493);
    if (sel d1.err) { ret err[fail.Fail].err{fail.fs_refused(d1.err)}; }
    val src_dir: str             = ut_cc3(alloc, dir, "/", "src");
    val d2:      err[fs.FsError] = fs.create_dir_all(alloc, src_dir, 493);
    if (sel d2.err) { ret err[fail.Fail].err{fail.fs_refused(d2.err)}; }
    val mf: str             = ut_cc3(alloc, dir, "/", manifest.MANIFEST_FILE);
    val w0: err[fs.FsError] = fs.write_bytes(mf, manifest_text, str_len(manifest_text), 420);
    if (sel w0.err) { ret err[fail.Fail].err{fail.fs_refused(w0.err)}; }
    val sf:            str             = ut_cc3(alloc, src_dir, "/", src_name);
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(sf, src_text, str_len(src_text), 420);
    if (sel write_bytes_r.err) { ret err[fail.Fail].err{fail.fs_refused(write_bytes_r.err)}; }
    ret err[fail.Fail].ok{};
}

pub fun ut_git(alloc: *A.Allocator, args: *str, count: usize) bool {
    val pr: res[str, exec.Error] = exec.resolve(alloc, "git");
    if (sel pr.err) { ret false; }
    val program: str                = pr.ok;
    val ar:      res[**u8, A.Error] = A.allocate[*u8](alloc, count + 2);
    if (sel ar.err) {
        str_free(alloc, program);
        ret false;
    }
    val argv: **u8 = ar.ok;
    argv[0] = program::*u8;
    var i: usize = 0;
    for (i < count) {
        argv[i + 1] = args[i]::*u8;
        i           = i + 1;
    }
    argv[count + 1] = nil;
    val rr: res[exec.ExitStatus, exec.Error] = exec.run(program, argv, env.environ());
    A.deallocate[*u8](alloc, argv, count + 2);
    str_free(alloc, program);
    if (sel rr.err) { ret false; }
    val status: exec.ExitStatus = rr.ok;
    ret exec.exited(status) && exec.code(status) == 0;
}

pub fun ut_git_repo(alloc: *A.Allocator, dir: str, origin: str) bool {
    var init: [3]str;
    init[0] = "init";
    init[1] = "-q";
    init[2] = dir;
    if (!ut_git(alloc, ?init[0], 3)) { ret false; }
    var name: [5]str;
    name[0] = "-C";
    name[1] = dir;
    name[2] = "config";
    name[3] = "user.name";
    name[4] = "mach-test";
    if (!ut_git(alloc, ?name[0], 5)) { ret false; }
    var email: [5]str;
    email[0] = "-C";
    email[1] = dir;
    email[2] = "config";
    email[3] = "user.email";
    email[4] = "mach-test@example.invalid";
    if (!ut_git(alloc, ?email[0], 5)) { ret false; }
    var remote: [6]str;
    remote[0] = "-C";
    remote[1] = dir;
    remote[2] = "remote";
    remote[3] = "add";
    remote[4] = "origin";
    remote[5] = origin;
    if (!ut_git(alloc, ?remote[0], 6)) { ret false; }
    var add: [4]str;
    add[0] = "-C";
    add[1] = dir;
    add[2] = "add";
    add[3] = "-A";
    if (!ut_git(alloc, ?add[0], 4)) { ret false; }
    var commit: [5]str;
    commit[0] = "-C";
    commit[1] = dir;
    commit[2] = "commit";
    commit[3] = "-qm";
    commit[4] = "initial";
    if (!ut_git(alloc, ?commit[0], 5)) { ret false; }
    var track: [6]str;
    track[0] = "-C";
    track[1] = dir;
    track[2] = "update-ref";
    track[3] = "refs/remotes/origin/main";
    track[4] = "HEAD";
    track[5] = "";
    ret ut_git(alloc, ?track[0], 5);
}

pub fun ut_gitmodules(alloc: *A.Allocator, alias: str, source: str) str {
    val head: str = ut_cc3(alloc, "[submodule \"dep/", alias, "\"]\n\tpath = dep/");
    val path: str = ut_cc3(alloc, head, alias, "\n\turl = ");
    ret ut_cc3(alloc, path, source, "\n");
}

pub fun ut_write_gitmodules(alloc: *A.Allocator, root: str, alias: str, source: str) bool {
    val path:          str             = ut_cc3(alloc, root, "/", ".gitmodules");
    val text:          str             = ut_gitmodules(alloc, alias, source);
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(path, text, str_len(text), 420);
    ret sel write_bytes_r.ok;
}

pub fun ut_lib_manifest(alloc: *A.Allocator, id: str) str {
    ret ut_cc3(alloc, "[project]\nmach = \">=5\"\nid = \"", id,
        "\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[artifact.lib]\nkind = \"static\"\nentry = \"lib.mach\"\nout = \"lib/l\"\ntargets = [\"*\"]\nlink = []\nneed = []\n");
}

pub fun ut_build(s: *session.Session, alloc: *A.Allocator, names: *str, texts: *str, n: u32) res[project.Project, outcome.Fail] {
    val root_r: res[str, fail.Fail] = ut_scaffold(alloc, names, texts, n);
    if (sel root_r.err) { ret res[project.Project, outcome.Fail].err{outcome.from_fail(root_r.err)}; }
    val root: str               = root_r.ok;
    val rr:   err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.err) {
        fs.remove_all(alloc, root);
        ret res[project.Project, outcome.Fail].err{rr.err};
    }
    val pr: res[project.Project, outcome.Fail] = driver.build_project_union(s, root);
    fs.remove_all(alloc, root);
    ret pr;
}

# load the project a test goal builds for the selected cell
pub fun ut_load_test_goal(s: *session.Session, root: str, pick: manifest.Selection) res[project.Project, outcome.Fail] {
    var req: request.BuildRequest = request.defaults();
    req.project_root = root;
    req.target       = pick.target;
    req.profile      = pick.profile;
    req.artifact     = pick.artifact;
    req.want_lib     = pick.want_lib;
    req.goal         = request.GOAL_TESTS;
    var sel_: manifest.Selection = pick;
    ret driver.build_project_sel_req(s, root, ?sel_, ?req);
}

pub fun ut_in_topo(p: *project.Project, s: *session.Session, fqn: str) bool {
    val mid: session.ModuleId = ut_mid(p, s, fqn);
    if (mid == session.MODULE_NIL) { ret false; }
    var i: u32 = 0;
    for (i < p.topo_len) {
        if (p.topo[i] == mid) { ret true; }
        i = i + 1;
    }
    ret false;
}

pub fun ut_sema_rejects_at(src: str, needle: str, want_offset: usize, want_len: usize) bool {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret false; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret false; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = src;
    val pr: res[project.Project, outcome.Fail] = ut_build(?s, ?alloc, ?names[0], ?texts[0], 1);
    if (sel pr.err) { ret false; }
    var p: project.Project = pr.ok;
    fin { project.dnit_project(?p); }

    val se: err[outcome.Fail] = driver.run_sema_pass(?p);
    if (!(sel se.err && outcome.is_reported(se.err))) { ret false; }
    var i: usize = 0;
    for (i < diagnostic.len(?s.diags)) {
        val d: *diagnostic.Diagnostic = ?s.diags.items.data[i];
        if (d.severity == diagnostic.SEVERITY_ERROR
            && ut_str_contains(d.message, needle)
            && d.loc.span.offset == want_offset
            && d.loc.span.len == want_len) { ret true; }
        i = i + 1;
    }
    ret false;
}

pub fun ut_dispatcher_start_stub() str {
    ret "\n#[symbol(\"_start\")]\npub fun start() {\n    asm x86_64 {\n        mov rax, rsp\n        mov rdi, [rax]\n        lea rsi, [rax+8]\n        and rsp, -16\n        call main\n        mov rdi, rax\n        mov rax, 60\n        syscall\n    }\n}\n";
}

# runs the built dispatcher on one test index and returns its exit code, or -1
pub fun ut_dispatch_status(exe: str, idx: u32) i32 {
    var ibuf: [16]u8;
    var len:  usize = 0;
    var v:    u32   = idx;
    if (v == 0) {
        ibuf[0] = 48;
        len     = 1;
    }
    for (v > 0) {
        ibuf[len] = 48 + (v % 10)::u8;
        v         = v / 10;
        len       = len + 1;
    }
    # the digits were written least significant first
    var lo: usize = 0;
    var hi: usize = len;
    for (lo + 1 < hi) {
        val t: u8 = ibuf[lo];
        ibuf[lo]     = ibuf[hi - 1];
        ibuf[hi - 1] = t;
        lo           = lo + 1;
        hi           = hi - 1;
    }
    ibuf[len] = 0;
    var argv: [3]*u8;
    argv[0] = exe::*u8;
    argv[1] = ?ibuf[0];
    argv[2] = nil;
    val spawned: res[exec.Child, exec.Error] = exec.spawn(exe, ?argv[0], env.environ());
    if (sel spawned.err) { ret -1; }
    val rr: res[exec.ExitStatus, exec.Error] = exec.wait(spawned.ok);
    if (sel rr.err)          { ret -1; }
    if (!exec.exited(rr.ok)) { ret -1; }
    ret exec.code(rr.ok)::i32;
}

pub fun ut_has(p: *project.Project, s: *session.Session, fqn: str) bool {
    val idr: res[intern.StrId, A.Error] = intern.intern(?s.interner, fqn);
    if (sel idr.err) { ret false; }
    var id:    intern.StrId           = idr.ok;
    val get_r: opt[*session.ModuleId] = map.get[intern.StrId, session.ModuleId](?p.by_fqn, ?id);
    if (sel get_r.none) { ret false; }
    ret sel get_r.some;
}

pub fun ut_ast(p: *project.Project, s: *session.Session, fqn: str) *ast.Ast {
    val idr: res[intern.StrId, A.Error] = intern.intern(?s.interner, fqn);
    if (sel idr.err) { ret nil; }
    var id: intern.StrId           = idr.ok;
    val mr: opt[*session.ModuleId] = map.get[intern.StrId, session.ModuleId](?p.by_fqn, ?id);
    if (sel mr.none) { ret nil; }
    val mid: session.ModuleId = @mr.some;
    ret project.module_at(p, mid::u32).a;
}

pub fun ut_mid(p: *project.Project, s: *session.Session, fqn: str) session.ModuleId {
    val idr: res[intern.StrId, A.Error] = intern.intern(?s.interner, fqn);
    if (sel idr.err) { ret session.MODULE_NIL; }
    var id: intern.StrId           = idr.ok;
    val mr: opt[*session.ModuleId] = map.get[intern.StrId, session.ModuleId](?p.by_fqn, ?id);
    if (sel mr.none) { ret session.MODULE_NIL; }
    ret @mr.some;
}

pub fun ut_stable(p: *project.Project, s: *session.Session, fqn: str) session.StableModuleId {
    val mid: session.ModuleId = ut_mid(p, s, fqn);
    if (mid == session.MODULE_NIL) { ret session.STABLE_MODULE_NIL; }
    ret project.module_at(p, mid::u32).stable_id;
}

pub fun ut_id_is(s: *session.Session, id: intern.StrId, text: str) bool {
    val found: opt[str] = intern.lookup(?s.interner, id);
    ret sel found.some && str_equals(found.some, text);
}

pub fun ut_topo_index(p: *project.Project, mid: session.ModuleId) u32 {
    var i: u32 = 0;
    for (i < p.topo_len) {
        if (p.topo[i] == mid) { ret i; }
        i = i + 1;
    }
    ret p.topo_len;
}

# the fixture of #3774: a default `hello` that needs nothing, a `shaded` that
# needs every shader artifact, and a spirv-only `shader-vert` whose output
# `shaded` embeds
fun ut_manifest_lessons() str {
    ret "[project]\nmach = \">=5\"\nid = \"lessons\"\nversion = \"0.1.0\"\nsrc = \"src\"\nout = \"out\"\n\n[target.spirv]\nisa = \"spirv\"\nos = \"freestanding\"\nabi = \"spirv\"\nenv = \"vulkan1.0\"\n\n[target.linux-x86_64]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\ndefault = true\n\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n\n[artifact.hello]\ndefault = true\nkind = \"bin\"\nentry = \"hello.mach\"\nout = \"bin/hello\"\ntargets = [\"*\"]\nlink = []\nneed = []\n\n[artifact.shaded]\nkind = \"bin\"\nentry = \"shaded.mach\"\nout = \"bin/shaded\"\ntargets = [\"*\"]\nlink = []\nneed = [\"artifact.shader-*\"]\n\n[artifact.shader-vert]\nkind = \"bin\"\nentry = \"shaders/vert.mach\"\nout = \"spv/vert{artifact.suffix}\"\ntargets = [\"spirv\"]\nlink = []\nneed = []\n";
}

# the fixture on disk, with the shader entry under `src/shaders`
pub fun ut_scaffold_lessons(alloc: *A.Allocator, shaded_text: str) res[str, fail.Fail] {
    var names: [2]str;
    names[0] = "hello.mach";
    names[1] = "shaded.mach";
    var texts: [2]str;
    texts[0] = "fun main() i32 { ret 0; }\n";
    texts[1] = shaded_text;
    val root_r: res[str, fail.Fail] = ut_scaffold_m(alloc, ut_manifest_lessons(), ?names[0], ?texts[0], 2);
    if (sel root_r.err) { ret root_r; }
    val root:    str             = root_r.ok;
    val shaders: str             = ut_cc3(alloc, root, "/", "src/shaders");
    val made:    err[fs.FsError] = fs.create_dir_all(alloc, shaders, 493);
    if (sel made.err) { ret res[str, fail.Fail].err{fail.fs_refused(made.err)}; }
    val vert: str             = ut_cc3(alloc, shaders, "/", "vert.mach");
    val text: str             = "#[output(0)] var out_colour: f32x4;\n\n#[stage(\"fragment\")]\nfun frag_main() { out_colour = f32x4{1.0, 1.0, 1.0, 1.0}; }\n";
    val w:    err[fs.FsError] = fs.write_bytes(vert, text, str_len(text), 420);
    if (sel w.err) { ret res[str, fail.Fail].err{fail.fs_refused(w.err)}; }
    ret res[str, fail.Fail].ok{root};
}

# analyze the fixture rooted at the default artifact `hello` with `lessons.shaded`
# as an extra root, the way an editor session holds an open buffer of another
# artifact; the project comes back whatever sema decided
pub fun ut_analyze_lessons(s: *session.Session, mf: *manifest.Manifest, root: str,
    roots: project.RootSet) res[project.Project, outcome.Fail] {
    var req: request.BuildRequest = request.defaults();
    req.project_root = root;
    req.target       = "linux-x86_64";
    req.artifact     = "hello";
    req.goal         = request.GOAL_CHECK;
    val xid_r: res[intern.StrId, A.Error] = intern.intern(?s.interner, "lessons.shaded");
    if (sel xid_r.err) { ret res[project.Project, outcome.Fail].err{outcome.refused(xid_r.err)}; }
    var extra_roots: [1]intern.StrId;
    extra_roots[0] = xid_r.ok;
    ret driver.analyze_project_tolerant(s, mf, ?req, roots, ?extra_roots[0], 1, driver.FRONTEND_SEMA);
}

# the artifact a module is attributed to, as its comptime context reads `$bin.name`
pub fun ut_module_bin_name(p: *project.Project, s: *session.Session, fqn: str) str {
    val mid: session.ModuleId = ut_mid(p, s, fqn);
    if (mid == session.MODULE_NIL) { ret ""; }
    val m: *project.ModuleEntry = project.module_at(p, mid::u32);
    if (m.artifact != m.ctx.env.bin_name) { ret ""; }
    val text: opt[str] = intern.lookup(?s.interner, m.artifact);
    if (sel text.none) { ret ""; }
    ret text.some;
}

pub fun ut_count_errors(d: *diagnostic.DiagnosticStore) u32 {
    var c: u32   = 0;
    var i: usize = 0;
    for (i < diagnostic.len(d)) {
        if (d.items.data[i].severity == diagnostic.SEVERITY_ERROR) { c = c + 1; }
        i = i + 1;
    }
    ret c;
}

pub fun ut_project_was_rejected(result: res[project.Project, outcome.Fail]) bool {
    if (sel result.ok) {
        var accepted: project.Project = result.ok;
        project.dnit_project(?accepted);
        ret false;
    }
    ret outcome.is_reported(result.err);
}

pub fun ut_diag_has(d: *diagnostic.DiagnosticStore, needle: str) bool {
    var i: usize = 0;
    for (i < diagnostic.len(d)) {
        if (d.items.data[i].severity == diagnostic.SEVERITY_ERROR
            && ut_str_contains(d.items.data[i].message, needle)) { ret true; }
        i = i + 1;
    }
    ret false;
}

pub fun ut_diag_count(d: *diagnostic.DiagnosticStore, needle: str) u32 {
    var hits: u32   = 0;
    var i:    usize = 0;
    for (i < diagnostic.len(d)) {
        if (d.items.data[i].severity == diagnostic.SEVERITY_ERROR
            && ut_str_contains(d.items.data[i].message, needle)) { hits = hits + 1; }
        i = i + 1;
    }
    ret hits;
}

pub fun ut_diag_note_has(d: *diagnostic.DiagnosticStore, needle: str) bool {
    var i: usize = 0;
    for (i < diagnostic.len(d)) {
        val di: *diagnostic.Diagnostic = ?d.items.data[i];
        if (di.severity == diagnostic.SEVERITY_ERROR) {
            var c: usize = 0;
            for (c < di.children.len) {
                if (di.children.data[c].kind == diagnostic.CHILD_NOTE
                    && ut_str_contains(di.children.data[c].text, needle)) { ret true; }
                c = c + 1;
            }
        }
        i = i + 1;
    }
    ret false;
}

pub fun ut_vec_sema(s: *session.Session, alloc: *A.Allocator, src: str) res[project.Project, outcome.Fail] {
    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = src;
    ret ut_vec_sema_n(s, alloc, ?names[0], ?texts[0], 1);
}

pub fun ut_vec_sema_n(s: *session.Session, alloc: *A.Allocator, names: *str, texts: *str, n: u32) res[project.Project, outcome.Fail] {
    val pr: res[project.Project, outcome.Fail] = ut_build(s, alloc, names, texts, n);
    if (sel pr.err) { ret pr; }
    var p:  project.Project   = pr.ok;
    val se: err[outcome.Fail] = driver.run_sema_pass(?p);
    if (sel se.err) {
        project.dnit_project(?p);
        ret res[project.Project, outcome.Fail].err{se.err};
    }
    ret res[project.Project, outcome.Fail].ok{p};
}

pub fun ut_single_sema_n(s: *session.Session, alloc: *A.Allocator, names: *str, texts: *str, n: u32) res[project.Project, outcome.Fail] {
    val root_r: res[str, fail.Fail] = ut_scaffold(alloc, names, texts, n);
    if (sel root_r.err) { ret res[project.Project, outcome.Fail].err{outcome.from_fail(root_r.err)}; }
    val root: str               = root_r.ok;
    val rr:   err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.err) {
        fs.remove_all(alloc, root);
        ret res[project.Project, outcome.Fail].err{rr.err};
    }
    var tsel_1294: manifest.Selection                 = ut_target_sel("linux");
    val pr:        res[project.Project, outcome.Fail] = driver.build_project(s, root, ?tsel_1294);
    fs.remove_all(alloc, root);
    if (sel pr.err) { ret pr; }
    var p:  project.Project   = pr.ok;
    val se: err[outcome.Fail] = driver.run_sema_pass(?p);
    if (sel se.err) {
        project.dnit_project(?p);
        ret res[project.Project, outcome.Fail].err{se.err};
    }
    ret res[project.Project, outcome.Fail].ok{p};
}

pub fun ut_single_result_n(names: *str, texts: *str, n: u32, needle: str, want_diag: bool) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:  session.Session                    = sr.ok;
    val pr: res[project.Project, outcome.Fail] = ut_single_sema_n(?s, ?alloc, names, texts, n);
    if (sel pr.err) {
        val expected: bool = want_diag
            && outcome.is_reported(pr.err)
            && ut_diag_has(?s.diags, needle);
        session.dnit(?s);
        if (expected) { ret 0; }
        ret 1;
    }
    var p:  project.Project = pr.ok;
    var ok: bool            = ut_count_errors(?p.s.diags) == 0;
    if (want_diag) { ok = false; }
    project.dnit_project(?p);
    session.dnit(?s);
    if (ok) { ret 0; }
    ret 1;
}

pub fun ut_single_ok(src: str) i32 {
    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = src;
    ret ut_single_result_n(?names[0], ?texts[0], 1, "", false);
}

pub fun ut_single_ok2(main: str, lib: str) i32 {
    var names: [2]str;
    names[0] = "main.mach";
    names[1] = "lib.mach";
    var texts: [2]str;
    texts[0] = main;
    texts[1] = lib;
    ret ut_single_result_n(?names[0], ?texts[0], 2, "", false);
}

fun ut_vec_diagnostic_n(names: *str, texts: *str, n: u32, needle: str, note: bool) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    val pr: res[project.Project, outcome.Fail] = ut_build(?s, ?alloc, names, texts, n);
    if (sel pr.err) {
        if (!outcome.is_reported(pr.err)) { ret 1; }
        if (note) {
            if (ut_diag_note_has(?s.diags, needle)) { ret 0; }
        }
        or {
            if (ut_diag_has(?s.diags, needle)) { ret 0; }
        }
        ret 1;
    }
    var p: project.Project = pr.ok;
    fin { project.dnit_project(?p); }
    val checked: err[outcome.Fail] = driver.run_sema_pass(?p);
    if (sel checked.ok) {
        if (!note) { ret 1; }
    }
    or (sel checked.err) {
        if (!outcome.is_reported(checked.err)) { ret 1; }
    }
    var hit: bool = ut_diag_has(?s.diags, needle);
    if (note) { hit = ut_diag_note_has(?s.diags, needle); }
    if (hit)  { ret 0; }
    var di: usize = 0;
    for (di < diagnostic.len(?s.diags)) {
        print.println(s.diags.items.data[di].message);
        di = di + 1;
    }
    ret 1;
}

pub fun ut_vec_diag(src: str, needle: str) i32 {
    var names: [1]str = [1]str{"main.mach"};
    var texts: [1]str = [1]str{src};
    ret ut_vec_diagnostic_n(?names[0], ?texts[0], 1, needle, false);
}

pub fun ut_vec_note(src: str, needle: str) i32 {
    var names: [1]str = [1]str{"main.mach"};
    var texts: [1]str = [1]str{src};
    ret ut_vec_diagnostic_n(?names[0], ?texts[0], 1, needle, true);
}

pub fun ut_vec_diag2(main: str, lib: str, needle: str) i32 {
    var names: [2]str = [2]str{"main.mach", "lib.mach"};
    var texts: [2]str = [2]str{main, lib};
    ret ut_vec_diagnostic_n(?names[0], ?texts[0], 2, needle, false);
}

pub fun ut_sema_clean2(main: str, lib: str) bool {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret false; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret false; }
    var s: session.Session = sr.ok;

    var names: [2]str;
    names[0] = "main.mach";
    names[1] = "lib.mach";
    var texts: [2]str;
    texts[0] = main;
    texts[1] = lib;

    val pr: res[project.Project, outcome.Fail] = ut_vec_sema_n(?s, ?alloc, ?names[0], ?texts[0], 2);
    if (sel pr.err) {
        session.dnit(?s);
        ret false;
    }
    var p:     project.Project = pr.ok;
    val clean: bool            = ut_count_errors(?s.diags) == 0;
    project.dnit_project(?p);
    session.dnit(?s);
    ret clean;
}

pub def CodegenTestPhase: u8;

pub val CODEGEN_TEST_SETUP:    CodegenTestPhase = 0;
val     CODEGEN_TEST_SEMA:     CodegenTestPhase = 1;
val     CODEGEN_TEST_LOWER:    CodegenTestPhase = 2;
pub val CODEGEN_TEST_SELECT:   CodegenTestPhase = 3;
pub val CODEGEN_TEST_CODEGEN:  CodegenTestPhase = 4;
pub val CODEGEN_TEST_ARTIFACT: CodegenTestPhase = 5;

pub def CodegenTestStatus: u8;

pub val CODEGEN_TEST_SETUP_FAILURE:       CodegenTestStatus = 0;
pub val CODEGEN_TEST_TARGET_UNAVAILABLE:  CodegenTestStatus = 1;
pub val CODEGEN_TEST_EMPTY_SELECTION:     CodegenTestStatus = 2;
pub val CODEGEN_TEST_NAMED_CASE_MISSING:  CodegenTestStatus = 3;
pub val CODEGEN_TEST_NAMED_CASE_EXECUTED: CodegenTestStatus = 4;
pub val CODEGEN_TEST_EXPECTED_EXCLUSION:  CodegenTestStatus = 5;
pub val CODEGEN_TEST_COMPILER_REJECTION:  CodegenTestStatus = 6;
pub val CODEGEN_TEST_ARTIFACT_FAILURE:    CodegenTestStatus = 7;
pub val CODEGEN_TEST_PASS:                CodegenTestStatus = 8;

def CodegenTestExpected: u8;

pub val CODEGEN_EXPECT_PASS:      CodegenTestExpected = 0;
pub val CODEGEN_EXPECT_EXCLUSION: CodegenTestExpected = 1;

pub def CodegenTestCase: u8;

pub val CODEGEN_CASE_NONE:                  CodegenTestCase = 0;
pub val CODEGEN_CASE_VECTOR_ADD:            CodegenTestCase = 1;
pub val CODEGEN_CASE_VECTOR_BUILD:          CodegenTestCase = 2;
pub val CODEGEN_CASE_PUBLIC_MUL:            CodegenTestCase = 3;
pub val CODEGEN_CASE_DECLASSIFIED_MUL:      CodegenTestCase = 4;
pub val CODEGEN_CASE_MEMZERO:               CodegenTestCase = 5;
pub val CODEGEN_CASE_PUBLIC_SHIFT:          CodegenTestCase = 6;
pub val CODEGEN_CASE_SECRET_SHIFT:          CodegenTestCase = 7;
val     CODEGEN_CASE_WIDE_SECRET_RETURN:    CodegenTestCase = 8;
val     CODEGEN_CASE_WIDE_SECRET_CALL:      CodegenTestCase = 9;
val     CODEGEN_CASE_SECRET_MEMORY_ADDRESS: CodegenTestCase = 10;
pub val CODEGEN_CASE_SECRET_MUL:            CodegenTestCase = 11;

pub rec CodegenTestOutcome {
    status:    CodegenTestStatus;
    phase:     CodegenTestPhase;
    case_id:   CodegenTestCase;
    case_name: str;
}

pub fun ut_codegen_outcome(status: CodegenTestStatus, phase: CodegenTestPhase,
    case_id: CodegenTestCase, case_name: str) CodegenTestOutcome {
    var out: CodegenTestOutcome;
    out.status    = status;
    out.phase     = phase;
    out.case_id   = case_id;
    out.case_name = case_name;
    ret out;
}

fun ut_codegen_phase_name(phase: CodegenTestPhase) str {
    if (phase == CODEGEN_TEST_SETUP)    { ret "setup"; }
    if (phase == CODEGEN_TEST_SEMA)     { ret "sema"; }
    if (phase == CODEGEN_TEST_LOWER)    { ret "lower"; }
    if (phase == CODEGEN_TEST_SELECT)   { ret "selection"; }
    if (phase == CODEGEN_TEST_CODEGEN)  { ret "codegen"; }
    if (phase == CODEGEN_TEST_ARTIFACT) { ret "artifact"; }
    ret "unknown";
}

fun ut_codegen_status_name(status: CodegenTestStatus) str {
    if (status == CODEGEN_TEST_SETUP_FAILURE)       { ret "setup failure"; }
    if (status == CODEGEN_TEST_TARGET_UNAVAILABLE)  { ret "target unavailable"; }
    if (status == CODEGEN_TEST_EMPTY_SELECTION)     { ret "empty selection"; }
    if (status == CODEGEN_TEST_NAMED_CASE_MISSING)  { ret "named case missing"; }
    if (status == CODEGEN_TEST_NAMED_CASE_EXECUTED) { ret "excluded case executed"; }
    if (status == CODEGEN_TEST_EXPECTED_EXCLUSION)  { ret "expected exclusion"; }
    if (status == CODEGEN_TEST_COMPILER_REJECTION)  { ret "compiler rejection"; }
    if (status == CODEGEN_TEST_ARTIFACT_FAILURE)    { ret "artifact failure"; }
    if (status == CODEGEN_TEST_PASS)                { ret "pass"; }
    ret "unknown";
}

fun ut_codegen_expected_name(expected: CodegenTestExpected) str {
    if (expected == CODEGEN_EXPECT_PASS)      { ret "generated artifact"; }
    if (expected == CODEGEN_EXPECT_EXCLUSION) { ret "generated artifact without excluded case"; }
    ret "unknown";
}

pub fun ut_codegen_outcome_matches(got: CodegenTestOutcome, expected: CodegenTestExpected,
    case_id: CodegenTestCase) bool {
    if (got.case_id != case_id || got.phase != CODEGEN_TEST_ARTIFACT) { ret false; }
    if (expected == CODEGEN_EXPECT_PASS)                              { ret got.status == CODEGEN_TEST_PASS; }
    if (expected == CODEGEN_EXPECT_EXCLUSION)                         { ret got.status == CODEGEN_TEST_EXPECTED_EXCLUSION; }
    ret false;
}

pub fun ut_codegen_result(got: CodegenTestOutcome, expected: CodegenTestExpected,
    case_id: CodegenTestCase) i32 {
    if (ut_codegen_outcome_matches(got, expected, case_id)) { ret 0; }
    print.eprintlnf("codegen oracle '{}': expected {}, reached {} with {}",
        got.case_name, ut_codegen_expected_name(expected), ut_codegen_phase_name(got.phase),
        ut_codegen_status_name(got.status));
    ret 1;
}

fun ut_codegen_case_selected(p: *project.Project, case_id: CodegenTestCase) bool {
    if (case_id == CODEGEN_CASE_NONE) { ret false; }
    var saw_public_mul: bool = false;
    var saw_declassify: bool = false;
    var ti:             u32  = 0;
    for (ti < p.topo_len) {
        val m: *ir.Module = project.module_at(p, p.topo[ti]::u32).ir_module;
        if (m != nil) {
            var fi: u32 = 0;
            for (fi < m.function_len) {
                val fn: *ir.Function = ?m.functions[fi];
                var ii: u32          = 0;
                for (ii < fn.instr_len) {
                    val ins: *instruction.Instruction = ?fn.instrs[ii];
                    if (ins.kind == instruction.OP_DECLASSIFY) { saw_declassify = true; }

                    var operands_public: bool = true;
                    var oi:              u32  = 0;
                    for (oi < ins.operand_count) {
                        if (ins.operands[oi].secret) { operands_public = false; }
                        oi = oi + 1;
                    }
                    if (ins.kind == instruction.OP_MUL && !ins.secret && operands_public) {
                        saw_public_mul = true;
                    }
                    if (case_id == CODEGEN_CASE_SECRET_MUL
                        && ins.kind == instruction.OP_MUL && !operands_public) { ret true; }

                    if (case_id == CODEGEN_CASE_VECTOR_ADD
                        && ins.kind == instruction.OP_ADD
                        && ir_type.is_vector(?m.types, ins.ty)) { ret true; }
                    if (case_id == CODEGEN_CASE_VECTOR_BUILD
                        && ins.kind == instruction.OP_VEC_BUILD) { ret true; }
                    if (case_id == CODEGEN_CASE_VECTOR_BUILD
                        && ins.kind == instruction.OP_STORE && ins.operand_count >= 1
                        && ins.operands[0].kind == value.VAL_CONST_AGG
                        && ir_type.is_vector(?m.types, ins.operands[0].ty)) { ret true; }
                    if (case_id == CODEGEN_CASE_VECTOR_BUILD
                        && ins.kind == instruction.OP_LOAD
                        && ir_type.is_vector(?m.types, ins.ty)) { ret true; }
                    if (case_id == CODEGEN_CASE_PUBLIC_MUL && saw_public_mul) { ret true; }
                    if (case_id == CODEGEN_CASE_MEMZERO
                        && ins.kind == instruction.OP_MEMZERO) { ret true; }
                    if ((case_id == CODEGEN_CASE_PUBLIC_SHIFT || case_id == CODEGEN_CASE_SECRET_SHIFT)
                        && (ins.kind == instruction.OP_SHL || ins.kind == instruction.OP_SHR_S
                        || ins.kind == instruction.OP_SHR_U)
                        && ins.operand_count >= 2) {
                        val count_secret: bool = ins.operands[1].secret;
                        if (case_id == CODEGEN_CASE_SECRET_SHIFT && count_secret)  { ret true; }
                        if (case_id == CODEGEN_CASE_PUBLIC_SHIFT && !count_secret) { ret true; }
                    }
                    if (case_id == CODEGEN_CASE_WIDE_SECRET_RETURN
                        && ins.kind == instruction.OP_RET && ins.operand_count >= 1
                        && ins.operands[0].secret
                        && ir_type.byte_size_for_machine(?m.types, ins.operands[0].ty, resolved.layout_machine(?p.target))
                        > p.target.isa.pointer_width) { ret true; }
                    if (case_id == CODEGEN_CASE_WIDE_SECRET_CALL
                        && ins.kind == instruction.OP_CALL && ins.secret
                        && ir_type.byte_size_for_machine(?m.types, ins.ty, resolved.layout_machine(?p.target))
                        > p.target.isa.pointer_width) { ret true; }
                    if (case_id == CODEGEN_CASE_SECRET_MEMORY_ADDRESS) {
                        if (ins.kind == instruction.OP_LOAD && ins.operand_count >= 1
                            && ins.operands[0].secret) { ret true; }
                        if (ins.kind == instruction.OP_STORE && ins.operand_count >= 2
                            && ins.operands[1].secret) { ret true; }
                        if (ins.kind == instruction.OP_MEMZERO && ins.operand_count >= 1
                            && ins.operands[0].secret) { ret true; }
                    }
                    ii = ii + 1;
                }
                fi = fi + 1;
            }
        }
        ti = ti + 1;
    }
    if (case_id == CODEGEN_CASE_DECLASSIFIED_MUL) {
        ret saw_declassify && saw_public_mul;
    }
    ret false;
}

fun ut_codegen_artifact_valid(p: *project.Project) bool {
    if (p.emit_len == 0) { ret false; }
    var i: u32 = 0;
    for (i < p.emit_len) {
        val m: *project.ModuleEntry = project.module_at(p, p.topo[i]::u32);
        if (m.object_image == nil || m.object_image.sections == nil
            || m.object_image.section_count == 0) { ret false; }
        i = i + 1;
    }
    ret true;
}

pub fun ut_run_codegen_case(p: *project.Project, case_name: str, case_id: CodegenTestCase,
    excluded: CodegenTestCase, expected: CodegenTestExpected) CodegenTestOutcome {
    val se: err[outcome.Fail] = driver.run_sema_pass(p);
    if (sel se.err) {
        ret ut_codegen_outcome(CODEGEN_TEST_COMPILER_REJECTION, CODEGEN_TEST_SEMA, case_id, case_name);
    }
    val le: err[outcome.Fail] = driver.run_lower_pass(p);
    if (sel le.err) {
        ret ut_codegen_outcome(CODEGEN_TEST_COMPILER_REJECTION, CODEGEN_TEST_LOWER, case_id, case_name);
    }
    if (p.emit_len == 0) {
        ret ut_codegen_outcome(CODEGEN_TEST_EMPTY_SELECTION, CODEGEN_TEST_SELECT, case_id, case_name);
    }
    if (!ut_codegen_case_selected(p, case_id)) {
        ret ut_codegen_outcome(CODEGEN_TEST_NAMED_CASE_MISSING, CODEGEN_TEST_SELECT, case_id, case_name);
    }
    if (expected == CODEGEN_EXPECT_EXCLUSION
        && (excluded == CODEGEN_CASE_NONE || ut_codegen_case_selected(p, excluded))) {
        ret ut_codegen_outcome(CODEGEN_TEST_NAMED_CASE_EXECUTED, CODEGEN_TEST_SELECT, case_id, case_name);
    }

    val ce: err[outcome.Fail] = driver.run_codegen_pass(p);
    if (sel ce.err) {
        ret ut_codegen_outcome(CODEGEN_TEST_COMPILER_REJECTION, CODEGEN_TEST_CODEGEN, case_id, case_name);
    }
    if (!ut_codegen_artifact_valid(p)) {
        ret ut_codegen_outcome(CODEGEN_TEST_ARTIFACT_FAILURE, CODEGEN_TEST_ARTIFACT, case_id, case_name);
    }
    if (expected == CODEGEN_EXPECT_EXCLUSION) {
        ret ut_codegen_outcome(CODEGEN_TEST_EXPECTED_EXCLUSION, CODEGEN_TEST_ARTIFACT, case_id, case_name);
    }
    ret ut_codegen_outcome(CODEGEN_TEST_PASS, CODEGEN_TEST_ARTIFACT, case_id, case_name);
}

pub fun ut_vec_codegen_defined(src: str, case_name: str, case_id: CodegenTestCase) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) {
        ret ut_codegen_result(ut_codegen_outcome(CODEGEN_TEST_SETUP_FAILURE, CODEGEN_TEST_SETUP,
            case_id, case_name), CODEGEN_EXPECT_PASS, case_id);
    }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) {
        ret ut_codegen_result(ut_codegen_outcome(CODEGEN_TEST_SETUP_FAILURE, CODEGEN_TEST_SETUP,
            case_id, case_name), CODEGEN_EXPECT_PASS, case_id);
    }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = src;
    val pr: res[project.Project, outcome.Fail] = ut_build(?s, ?alloc, ?names[0], ?texts[0], 1);
    if (sel pr.err) {
        session.dnit(?s);
        ret ut_codegen_result(ut_codegen_outcome(CODEGEN_TEST_SETUP_FAILURE, CODEGEN_TEST_SETUP,
            case_id, case_name), CODEGEN_EXPECT_PASS, case_id);
    }
    var p:   project.Project    = pr.ok;
    val got: CodegenTestOutcome = ut_run_codegen_case(?p, case_name, case_id,
        CODEGEN_CASE_NONE, CODEGEN_EXPECT_PASS);
    project.dnit_project(?p);
    session.dnit(?s);
    ret ut_codegen_result(got, CODEGEN_EXPECT_PASS, case_id);
}

# codegen rejects the program: the pass answers `reported` and the refusal is
# an error on the session's diagnostic store, never text on the failure
pub fun ut_run_codegen_err(p: *project.Project, needle: str) i32 {
    val se: err[outcome.Fail] = driver.run_sema_pass(p);
    if (sel se.err) { ret 1; }
    val le: err[outcome.Fail] = driver.run_lower_pass(p);
    if (sel le.err) { ret 1; }
    val ce: err[outcome.Fail] = driver.run_codegen_pass(p);
    if (sel ce.ok)                               { ret 1; }
    if (!outcome.is_reported(ce.err))            { ret 2; }
    if (diagnostic.error_count(?p.s.diags) == 0) { ret 3; }
    if (!ut_diag_has(?p.s.diags, needle))        { ret 4; }
    ret 0;
}

pub fun ut_run_codegen_ok(p: *project.Project) i32 {
    val se: err[outcome.Fail] = driver.run_sema_pass(p);
    if (sel se.err) { ret 1; }
    val le: err[outcome.Fail] = driver.run_lower_pass(p);
    if (sel le.err) { ret 1; }
    val ce: err[outcome.Fail] = driver.run_codegen_pass(p);
    if (sel ce.err) { ret 1; }
    ret 0;
}

