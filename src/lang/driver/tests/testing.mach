pub fun ut_native_path_is(a: *A.Allocator, actual: str, base: str, leaf: str) bool {
    val joined_r: res[path.Path, A.Error] = path.join(a, base, leaf);
    if (sel joined_r.err) { ret false; }
    val joined:     str                     = joined_r.ok;
    val expected_r: res[path.Path, A.Error] = path.clean(a, joined);
    str_free(a, joined);
    if (sel expected_r.err) { ret false; }
    val expected: str                     = expected_r.ok;
    val actual_r: res[path.Path, A.Error] = path.clean(a, actual);
    if (sel actual_r.err) {
        str_free(a, expected);
        ret false;
    }
    val normalized: str  = actual_r.ok;
    val same:       bool = str_equals(normalized, expected);
    str_free(a, normalized);
    str_free(a, expected);
    ret same;
}

pub rec UtQuerySnapshot {
    value:        *u8;
    value_len:    u32;
    last_changed: query.Revision;
}

pub fun ut_query_snapshot(a: *A.Allocator, p: *project.Project, kind: query.QueryKind, key: u64) res[UtQuerySnapshot, fail.Fail] {
    val begun: res[query.Operation, outcome.Fail] = project.begin_query_phase(p);
    if (sel begun.err) { ret res[UtQuerySnapshot, fail.Fail].err{fail.message(outcome.describe(begun.err))}; }
    val operation: query.Operation                 = begun.ok;
    var snapshot:  UtQuerySnapshot;
    var error:     str                             = nil;
    val acquired:  res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, kind, key);
    if (sel acquired.err) { error = "query snapshot acquisition failed"; }
    if (sel acquired.ok) {
        val view: query.QueryView = acquired.ok;
        snapshot.value_len    = view.value_len;
        snapshot.last_changed = view.last_changed;
        if (view.value_len != 0) {
            val allocated: res[*u8, A.Error] = A.allocate[u8](a, view.value_len::usize);
            if (sel allocated.err) { error = "query snapshot allocation failed"; }
            if (sel allocated.ok) {
                snapshot.value = allocated.ok;
                memory.raw_copy(snapshot.value::ptr, view.value::ptr, view.value_len::usize);
            }
        }
    }
    val ended: err[fail.Fail] = query.end(?p.s.queries, operation);
    if (sel ended.err) { error = "query snapshot operation failed"; }
    val discarded: err[fail.Fail] = query.discard(?p.s.queries, operation);
    if (sel discarded.err) { error = "query snapshot presentation discard failed"; }
    if (error != nil) {
        if (snapshot.value != nil) { A.deallocate[u8](a, snapshot.value, snapshot.value_len::usize); }
        ret res[UtQuerySnapshot, fail.Fail].err{fail.message(error)};
    }
    ret res[UtQuerySnapshot, fail.Fail].ok{snapshot};
}

fun ut_opt_str_eq(a: str, b: str) bool {
    if (a == nil && b == nil) { ret true; }
    if (a == nil || b == nil) { ret false; }
    ret str_equals(a, b);
}

pub fun ut_diag_list_eq(x: *diagnostic.DiagnosticStore, y: *diagnostic.DiagnosticStore) bool {
    if (diagnostic.len(x) != diagnostic.len(y)) { ret false; }
    var i: usize = 0;
    for (i < diagnostic.len(x)) {
        val dx: *diagnostic.Diagnostic = ?x.items.data[i];
        val dy: *diagnostic.Diagnostic = ?y.items.data[i];
        if (dx.severity != dy.severity)               { ret false; }
        if (dx.loc.file_id != dy.loc.file_id)         { ret false; }
        if (dx.loc.span.offset != dy.loc.span.offset) { ret false; }
        if (dx.loc.span.len != dy.loc.span.len)       { ret false; }
        if (!ut_opt_str_eq(dx.message, dy.message))   { ret false; }
        if (dx.children.len != dy.children.len)       { ret false; }
        var c: usize = 0;
        for (c < dx.children.len) {
            if (dx.children.data[c].kind != dy.children.data[c].kind)               { ret false; }
            if (!ut_opt_str_eq(dx.children.data[c].text, dy.children.data[c].text)) { ret false; }
            c = c + 1;
        }
        if (dx.related.len != dy.related.len) { ret false; }
        var r: usize = 0;
        for (r < dx.related.len) {
            val rx: *diagnostic.Related = ?dx.related.data[r];
            val ry: *diagnostic.Related = ?dy.related.data[r];
            if (rx.loc.file_id != ry.loc.file_id)         { ret false; }
            if (rx.loc.span.offset != ry.loc.span.offset) { ret false; }
            if (rx.loc.span.len != ry.loc.span.len)       { ret false; }
            if (!ut_opt_str_eq(rx.label, ry.label))       { ret false; }
            r = r + 1;
        }
        i = i + 1;
    }
    ret true;
}

pub fun ut_sema_lc(s: *session.Session, stable: session.StableModuleId) query.Revision {
    val revision: query.Revision = query.peek_revision(?s.queries, query.Q_SEMA, stable::u64);
    if (revision == 0) { ret 0xFFFFFFFFFFFFFFFF; }
    ret revision;
}

pub fun ut_lower_lc(s: *session.Session, stable: session.StableModuleId) query.Revision {
    val revision: query.Revision = query.peek_revision(?s.queries, query.Q_LOWER, stable::u64);
    if (revision == 0) { ret 0xFFFFFFFFFFFFFFFF; }
    ret revision;
}

pub fun ut_inline_prepare(s: *session.Session, root: str, jobs: u32) res[project.Project, outcome.Fail] {
    var selection: manifest.Selection = ut_target_sel("linux");
    selection.profile = "release";
    val opened: res[project.Project, outcome.Fail] = driver.build_project(s, root, ?selection);
    if (sel opened.err) { ret opened; }
    var p: project.Project = opened.ok;
    p.req.jobs = jobs;
    val typed: err[outcome.Fail] = driver.run_sema_pass(?p);
    if (sel typed.err) {
        project.dnit_project(?p);
        ret res[project.Project, outcome.Fail].err{typed.err};
    }
    val lowered: err[outcome.Fail] = driver.run_lower_pass(?p);
    if (sel lowered.err) {
        project.dnit_project(?p);
        ret res[project.Project, outcome.Fail].err{lowered.err};
    }
    ret res[project.Project, outcome.Fail].ok{p};
}

pub fun ut_inline_function(s: *session.Session, m: *ir.Module, name: str) *ir.Function {
    if (m == nil) { ret nil; }
    var i: u32 = 0;
    for (i < m.function_len) {
        if (ut_id_is(s, m.functions[i].name, name)) { ret ?m.functions[i]; }
        i = i + 1;
    }
    ret nil;
}

pub fun ut_inline_ops(fn: *ir.Function, kind: instruction.InstrKind) u32 {
    if (fn == nil) { ret 0xFFFFFFFF; }
    var count: u32 = 0;
    var bi:    u32 = 0;
    for (bi < fn.block_count) {
        val block: *ir.Block = ?fn.blocks[bi];
        var ii:    u32       = 0;
        for (ii < block.instr_count) {
            val ins: opt[*instruction.Instruction] = ir.instruction_get(fn, block.instructions[ii]);
            if (sel ins.some && ins.some.kind == kind) { count = count + 1; }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    ret count;
}

pub fun ut_inline_calls_of(s: *session.Session, m: *ir.Module, name: str) u32 {
    ret ut_inline_ops(ut_inline_function(s, m, name), instruction.OP_CALL);
}

pub fun ut_inline_asm_body_has(s: *session.Session, fn: *ir.Function, ordinal: u32, needle: str) bool {
    var seen: u32 = 0;
    var bi:   u32 = 0;
    for (bi < fn.block_count) {
        var ii: u32 = 0;
        for (ii < fn.blocks[bi].instr_count) {
            val iid: ir.InstructionId              = fn.blocks[bi].instructions[ii];
            val ins: opt[*instruction.Instruction] = ir.instruction_get(fn, iid);
            if (sel ins.some && ins.some.kind == instruction.OP_ASM) {
                if (seen == ordinal) {
                    var key:     ir.InstructionId = iid;
                    val payload: opt[*ir.IrAsm]   = map.get[ir.InstructionId, ir.IrAsm](?fn.asm_blocks, ?key);
                    if (sel payload.none) { ret false; }
                    val body: opt[str] = intern.lookup(?s.interner, payload.some.body);
                    ret sel body.some && str_contains(body.some, needle);
                }
                seen = seen + 1;
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    ret false;
}

# the repository root, found from the working directory the way the format tree test
# finds it: the directory holding src/cli/args.mach
pub fun ut_repo_root(alloc: *A.Allocator) opt[str] {
    var prefix: str   = ".";
    var depth:  usize = 0;
    for (depth < 8) {
        val probe: res[str, A.Error] = path.join(alloc, prefix, "src/cli/args.mach");
        if (sel probe.err) { ret opt[str].none{}; }
        val is_file: res[bool, io_error.Error] = fs.is_file(probe.ok);
        if (sel is_file.ok && is_file.ok) { ret opt[str].some{prefix}; }
        val up: res[str, A.Error] = path.join(alloc, prefix, "..");
        if (sel up.err) { ret opt[str].none{}; }
        prefix = up.ok;
        depth  = depth + 1;
    }
    ret opt[str].none{};
}

# the text of a file under the repository root
pub fun ut_repo_file(alloc: *A.Allocator, root: str, rel: str) opt[str] {
    val joined: res[str, A.Error] = path.join(alloc, root, rel);
    if (sel joined.err) { ret opt[str].none{}; }
    val bytes_r: res[Vector[u8], fs.FsError] = fs.read_bytes(alloc, joined.ok);
    if (sel bytes_r.err) { ret opt[str].none{}; }
    var bytes: Vector[u8]        = bytes_r.ok;
    val buf_r: res[*u8, A.Error] = A.allocate[u8](alloc, bytes.len + 1);
    if (sel buf_r.err) {
        vector.dnit[u8](?bytes);
        ret opt[str].none{};
    }
    val buf: *u8   = buf_r.ok;
    var i:   usize = 0;
    for (i < bytes.len) {
        buf[i] = bytes.data[i];
        i      = i + 1;
    }
    buf[bytes.len] = 0;
    vector.dnit[u8](?bytes);
    ret opt[str].some{buf::str};
}

# one call to each of the eight std.sync.atomic wrappers, in the order atomic.mach
# documents them, from a module in another project
fun ut_atomic_probe_text() str {
    ret "use std.sync.atomic;\nuse std.types.bool.bool;\npub fun probe(cell: *i64, expected: *i64) i64 { val a: i64 = atomic.load(cell); atomic.store(cell, a + 1); val swapped: bool = atomic.cas(cell, expected, 10); val b: i64 = atomic.fetch_add(cell, 5); val c: i64 = atomic.fetch_sub(cell, 3); val d: i64 = atomic.exchange(cell, 100); atomic.fence(); atomic.spin_hint(); var s: i64 = 0; if (swapped) { s = 1; } ret a + b * 10 + c * 100 + d * 1000 + s * 10000; }\nfun main() i32 { ret 0; }\n";
}

fun ut_atomic_std_manifest() str {
    ret "[project]\nmach = \">=5\"\nid = \"std\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.linux]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n";
}

# a project importing std.sync.atomic from a `std` dependency that holds the real
# wrappers: `dep/std/src/sync/atomic.mach` and the `std.types.bool` it uses are read
# from the repository's own pinned std, not restated here, so the test measures the
# wrappers std ships. returns the scaffold root; `atomic_path` receives the path of
# the dependency's copy of atomic.mach so a test can edit it between rounds.
pub fun ut_atomic_scaffold(alloc: *A.Allocator, atomic_path: *str) res[str, fail.Fail] {
    val repo: opt[str] = ut_repo_root(alloc);
    if (sel repo.none) { ret res[str, fail.Fail].err{fail.message("cannot locate the repository root from the working directory")}; }
    val atomic_src_r: opt[str] = ut_repo_file(alloc, repo.some, "dep/std/src/sync/atomic.mach");
    val bool_src_r:   opt[str] = ut_repo_file(alloc, repo.some, "dep/std/src/types/bool.mach");
    if (sel atomic_src_r.none) { ret res[str, fail.Fail].err{fail.message("cannot read the pinned std atomic.mach")}; }
    if (sel bool_src_r.none)   { ret res[str, fail.Fail].err{fail.message("cannot read the pinned std bool.mach")}; }
    val atomic_src:    str                 = atomic_src_r.some;
    val bool_src:      str                 = bool_src_r.some;
    var names:         [1]str              = [1]str{"main.mach"};
    var texts:         [1]str              = [1]str{ut_atomic_probe_text()};
    val manifest_text: str                 = ut_cc3(alloc, ut_manifest(), "\n[dep.std]\npath = \"dep/std\"\n", "");
    val scaffold:      res[str, fail.Fail] = ut_scaffold_m(alloc, manifest_text, ?names[0], ?texts[0], 1);
    if (sel scaffold.err) { ret scaffold; }
    val root:      str             = scaffold.ok;
    val dep_root:  str             = ut_cc3(alloc, root, "/", "dep/std");
    val sync_dir:  str             = ut_cc3(alloc, dep_root, "/", "src/sync");
    val types_dir: str             = ut_cc3(alloc, dep_root, "/", "src/types");
    val d1:        err[fs.FsError] = fs.create_dir_all(alloc, sync_dir, 493);
    if (sel d1.err) { ret res[str, fail.Fail].err{fail.fs_refused(d1.err)}; }
    val d2: err[fs.FsError] = fs.create_dir_all(alloc, types_dir, 493);
    if (sel d2.err) { ret res[str, fail.Fail].err{fail.fs_refused(d2.err)}; }
    val mf: str             = ut_cc3(alloc, dep_root, "/", manifest.MANIFEST_FILE);
    val w0: err[fs.FsError] = fs.write_bytes(mf, ut_atomic_std_manifest(), str_len(ut_atomic_std_manifest()), 420);
    if (sel w0.err) { ret res[str, fail.Fail].err{fail.fs_refused(w0.err)}; }
    val ap: str             = ut_cc3(alloc, sync_dir, "/", "atomic.mach");
    val w1: err[fs.FsError] = fs.write_bytes(ap, atomic_src, str_len(atomic_src), 420);
    if (sel w1.err) { ret res[str, fail.Fail].err{fail.fs_refused(w1.err)}; }
    val bp: str             = ut_cc3(alloc, types_dir, "/", "bool.mach");
    val w2: err[fs.FsError] = fs.write_bytes(bp, bool_src, str_len(bool_src), 420);
    if (sel w2.err) { ret res[str, fail.Fail].err{fail.fs_refused(w2.err)}; }
    @atomic_path = ap;
    ret res[str, fail.Fail].ok{root};
}

pub fun ut_back_half(s: *session.Session, root: str) res[project.Project, outcome.Fail] {
    val pr: res[project.Project, outcome.Fail] = driver.build_project_union(s, root);
    if (sel pr.err) { ret pr; }
    var p:  project.Project   = pr.ok;
    val rs: err[outcome.Fail] = driver.run_sema_pass(?p);
    if (sel rs.err) {
        project.dnit_project(?p);
        ret res[project.Project, outcome.Fail].err{rs.err};
    }
    val rl: err[outcome.Fail] = driver.run_lower_pass(?p);
    if (sel rl.err) {
        project.dnit_project(?p);
        ret res[project.Project, outcome.Fail].err{rl.err};
    }
    val rc: err[outcome.Fail] = driver.run_codegen_pass(?p);
    if (sel rc.err) {
        project.dnit_project(?p);
        ret res[project.Project, outcome.Fail].err{rc.err};
    }
    ret res[project.Project, outcome.Fail].ok{p};
}

pub fun ut_back_half_opt(s: *session.Session, root: str, found: pipeline.OptLevel) res[project.Project, outcome.Fail] {
    val pr: res[project.Project, outcome.Fail] = driver.build_project_union(s, root);
    if (sel pr.err) { ret pr; }
    var p: project.Project = pr.ok;
    p.req.opt = found;
    val rs: err[outcome.Fail] = driver.run_sema_pass(?p);
    if (sel rs.err) {
        project.dnit_project(?p);
        ret res[project.Project, outcome.Fail].err{rs.err};
    }
    val rl: err[outcome.Fail] = driver.run_lower_pass(?p);
    if (sel rl.err) {
        project.dnit_project(?p);
        ret res[project.Project, outcome.Fail].err{rl.err};
    }
    val rc: err[outcome.Fail] = driver.run_codegen_pass(?p);
    if (sel rc.err) {
        project.dnit_project(?p);
        ret res[project.Project, outcome.Fail].err{rc.err};
    }
    ret res[project.Project, outcome.Fail].ok{p};
}

pub fun ut_sema_errs(text: str) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret -1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret -1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = text;

    val pr: res[project.Project, outcome.Fail] = ut_build(?s, ?alloc, ?names[0], ?texts[0], 1);
    if (sel pr.err) {
        session.dnit(?s);
        ret -1;
    }
    var p: project.Project = pr.ok;

    var errs: i32 = ut_count_errors(?s.diags)::i32;
    if (errs == 0) {
        errs = -1;
        val sem: err[outcome.Fail] = driver.run_sema_pass(?p);
        if (sel sem.ok) { errs = ut_count_errors(?s.diags)::i32; }
        or (sel sem.err) {
            if (outcome.is_reported(sem.err)) {
                val reported: u32 = ut_count_errors(?s.diags);
                if (reported > 0) { errs = reported::i32; }
            }
        }
    }

    project.dnit_project(?p);
    session.dnit(?s);
    ret errs;
}

pub fun ut_sema_clean(text: str) bool {
    ret ut_sema_errs(text) == 0;
}

fun ut_lower_errs(text: str) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret -1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret -1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = text;

    val pr: res[project.Project, outcome.Fail] = ut_build(?s, ?alloc, ?names[0], ?texts[0], 1);
    if (sel pr.err) {
        session.dnit(?s);
        ret -1;
    }
    var p: project.Project = pr.ok;

    var errs: i32 = ut_count_errors(?s.diags)::i32;
    if (errs == 0) {
        errs = -1;
        val sem: err[outcome.Fail] = driver.run_sema_pass(?p);
        if (sel sem.ok) {
            val low: err[outcome.Fail] = driver.run_lower_pass(?p);
            errs = ut_count_errors(?s.diags)::i32;
            if (sel low.err && errs == 0) { errs = 1; }
        }
    }

    project.dnit_project(?p);
    session.dnit(?s);
    ret errs;
}

pub fun ut_lower_clean(text: str) bool {
    ret ut_lower_errs(text) == 0;
}

pub fun ut_sema_rejects(text: str) bool {
    ret ut_sema_errs(text) > 0;
}

fun ut_nominal_typeid(s: *session.Session, name: str) opt[type.TypeId] {
    val ir: res[intern.StrId, A.Error] = intern.intern(?s.interner, name);
    if (sel ir.err) { ret opt[type.TypeId].none{}; }
    val want: intern.StrId = ir.ok;

    val type_cap: u32 = type.type_count(?s.types);

    var i: u32 = 0;
    for (i < type_cap) {
        val tid: type.TypeId     = i::type.TypeId;
        val ot:  opt[*type.Type] = type.get(?s.types, tid);
        if (sel ot.none) {
            i = i + 1;
            cnt;
        }
        val t: *type.Type = ot.some;
        if (t.kind == type.TYPE_INSTANCE) {
            val nom: type.TypeId     = type.aggregate_nominal(?s.types, tid);
            val on:  opt[*type.Type] = type.get(?s.types, nom);
            if (sel on.some &&
                on.some.data.nominal.name == want) {
                ret opt[type.TypeId].some{tid};
            }
        }
        i = i + 1;
    }
    var j: u32 = 0;
    for (j < type_cap) {
        val ot: opt[*type.Type] = type.get(?s.types, j::type.TypeId);
        if (sel ot.none) {
            j = j + 1;
            cnt;
        }
        val t: *type.Type = ot.some;
        if (t.kind == type.TYPE_REC || t.kind == type.TYPE_UNI || t.kind == type.TYPE_TAG) {
            if (t.data.nominal.name == want) { ret opt[type.TypeId].some{j::type.TypeId}; }
        }
        j = j + 1;
    }
    ret opt[type.TypeId].none{};
}

pub fun ut_sema_extent_is(text: str, name: str, size: u32, align: u32) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = text;

    val pr: res[project.Project, outcome.Fail] = ut_build(?s, ?alloc, ?names[0], ?texts[0], 1);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    var bad: i32               = 1;
    val sem: err[outcome.Fail] = driver.run_sema_pass(?p);
    if (sel sem.ok) {
        val tid: opt[type.TypeId] = ut_nominal_typeid(?s, name);
        if (sel tid.some) {
            val er: res[layout.Extent, fail.Fail] = generics.type_extent(?s, layout.machine(8, 128), tid.some);
            if (sel er.ok) {
                val e: layout.Extent = er.ok;
                if (e.ok && e.size == size && e.align == align) { bad = 0; }
            }
        }
    }

    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

pub fun ut_sema_rejects_with(text: str, needle: str) bool {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret false; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret false; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = text;

    val pr: res[project.Project, outcome.Fail] = ut_build(?s, ?alloc, ?names[0], ?texts[0], 1);
    if (sel pr.err) {
        ret outcome.is_reported(pr.err)
            && ut_diag_has(?s.diags, needle);
    }
    var p: project.Project = pr.ok;
    fin { project.dnit_project(?p); }

    val sem: err[outcome.Fail] = driver.run_sema_pass(?p);
    ret sel sem.err
        && outcome.is_reported(sem.err)
        && ut_diag_has(?s.diags, needle);
}

fun ut_ct_edge_manifest() str {
    ret "[project]\nmach = \">=5\"\nid = \"ct\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.x64]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[target.spv]\nisa = \"spirv\"\nos = \"freestanding\"\nabi = \"spirv\"\n\n[target.rv32]\nisa = \"rv32imafdc\"\nos = \"freestanding\"\nabi = \"ilp32d\"\n\n[target.rv32f]\nisa = \"rv32imafdc\"\nos = \"freestanding\"\nabi = \"ilp32f\"\n\n[target.rv32s]\nisa = \"rv32imafdc\"\nos = \"freestanding\"\nabi = \"ilp32\"\n\n[target.rv32nf]\nisa = \"rv32imc\"\nos = \"freestanding\"\nabi = \"ilp32\"\n\n[profile.debug]\nopt = 0\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n\n[artifact.ct]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/ct\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
}

pub fun ut_ct_edge_project(s: *session.Session, alloc: *A.Allocator, src: str, target_name: str) res[project.Project, outcome.Fail] {
    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = src;
    val root_r: res[str, fail.Fail] = ut_scaffold_m(alloc, ut_ct_edge_manifest(), ?names[0], ?texts[0], 1);
    if (sel root_r.err) { ret res[project.Project, outcome.Fail].err{outcome.from_fail(root_r.err)}; }
    val root: str               = root_r.ok;
    val rr:   err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.err) {
        fs.remove_all(alloc, root);
        ret res[project.Project, outcome.Fail].err{rr.err};
    }
    var tsel_9040: manifest.Selection                 = ut_target_sel(target_name);
    val pr:        res[project.Project, outcome.Fail] = driver.build_project(s, root, ?tsel_9040);
    fs.remove_all(alloc, root);
    ret pr;
}

pub fun ut_engine_build_fails(src: str) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = src;
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    val mr: res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var m:  manifest.Manifest    = mr.ok;
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    val pr: res[bplan.BuildPlan, outcome.Fail] = bplan.plan(?alloc, ?s.interner, s.registry, ?m, rq);
    if (sel pr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var bp: bplan.BuildPlan = pr.ok;

    var bad: i32                                     = 0;
    val r:   res[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, ?alloc, nil);
    if (sel r.err) { bad = 1; }
    if (sel r.ok) {
        val bo: outcome.BuildOutcome = r.ok;
        if (bo.severity == outcome.BUILD_OK) { bad = 1; }
        if (bo.artifacts.len != 0)           { bad = 1; }
    }
    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

pub rec UtIrTextBuf {
    data: *u8;
    len:  usize;
    cap:  usize;
}

pub fun ut_ir_text_write(ctx: ptr, buf: *u8, len: usize) res[usize, writer.WriteError] {
    val b: *UtIrTextBuf = ctx::*UtIrTextBuf;
    var i: usize        = 0;
    for (i < len) {
        if (b.len >= b.cap) { ret res[usize, writer.WriteError].err{writer.native_failure(0, io_error.make(io_error.IO, io_error.OP_WRITE))}; }
        b.data[b.len] = buf[i];
        b.len         = b.len + 1;
        i             = i + 1;
    }
    ret res[usize, writer.WriteError].ok{len};
}

pub fun ut_chain_src(alloc: *A.Allocator, n: u32, r0: str, tail: str) err[fail.Fail] {
    val head: res[str, format.FormatError] = format.sprint(alloc, "rec R0 {{ {} }}\n", r0);
    if (sel head.err) { ret err[fail.Fail].ok{}; }
    var acc: str = head.ok;

    var i: u32 = 1;
    for (i < n) {
        val next: res[str, format.FormatError] = format.sprint(alloc, "{}rec R{} {{ a: R{}; }}\n", acc, i, i - 1);
        A.deallocate[char](alloc, acc::*char, str_len(acc) + 1);
        if (sel next.err) { ret err[fail.Fail].ok{}; }
        acc = next.ok;
        i   = i + 1;
    }

    val whole: res[str, format.FormatError] = format.sprint(alloc, "{}{}", acc, tail);
    A.deallocate[char](alloc, acc::*char, str_len(acc) + 1);
    if (sel whole.err) { ret err[fail.Fail].ok{}; }
    ret err[fail.Fail].err{fail.message(whole.ok)};
}

pub fun ut_lower_n(s: *session.Session, alloc: *A.Allocator, names: *str, texts: *str, n: u32) res[project.Project, outcome.Fail] {
    val root_r: res[str, fail.Fail] = ut_scaffold(alloc, names, texts, n);
    if (sel root_r.err) { ret res[project.Project, outcome.Fail].err{outcome.from_fail(root_r.err)}; }
    val root: str               = root_r.ok;
    val rr:   err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.err) {
        fs.remove_all(alloc, root);
        ret res[project.Project, outcome.Fail].err{rr.err};
    }
    var tsel_11572: manifest.Selection                 = ut_target_sel("linux");
    val pr:         res[project.Project, outcome.Fail] = driver.build_project(s, root, ?tsel_11572);
    fs.remove_all(alloc, root);
    if (sel pr.err) { ret pr; }
    var p:  project.Project   = pr.ok;
    val se: err[outcome.Fail] = driver.run_sema_pass(?p);
    if (sel se.err) {
        project.dnit_project(?p);
        ret res[project.Project, outcome.Fail].err{se.err};
    }
    val le: err[outcome.Fail] = driver.run_lower_pass(?p);
    if (sel le.err) {
        project.dnit_project(?p);
        ret res[project.Project, outcome.Fail].err{le.err};
    }
    ret res[project.Project, outcome.Fail].ok{p};
}

pub fun ut_ir_of(p: *project.Project, s: *session.Session, fqn: str) *ir.Module {
    val mid: session.ModuleId = ut_mid(p, s, fqn);
    if (mid == session.MODULE_NIL) { ret nil; }
    ret project.module_at(p, mid::u32).ir_module;
}

pub fun ut_const_uses(m: *ir.Module, want: u64) u32 {
    ret ut_operand_uses(m, value.VAL_CONST_INT, want);
}

pub fun ut_operand_uses(m: *ir.Module, kind: value.ValueKind, want: u64) u32 {
    if (m == nil) { ret 0; }
    var hits: u32 = 0;
    var fi:   u32 = 0;
    for (fi < m.function_len) {
        val f:  *ir.Function = ?m.functions[fi];
        var bi: u32          = 0;
        for (bi < f.block_count) {
            val b: *ir.Block = ?f.blocks[bi];
            var k: u32       = 0;
            for (k < b.phi_count) {
                hits = hits + ut_instr_uses(f, b.phis[k], kind, want);
                k    = k + 1;
            }
            k = 0;
            for (k < b.instr_count) {
                hits = hits + ut_instr_uses(f, b.instructions[k], kind, want);
                k    = k + 1;
            }
            hits = hits + ut_instr_uses(f, b.terminator, kind, want);
            bi   = bi + 1;
        }
        fi = fi + 1;
    }
    ret hits;
}

fun ut_instr_uses(f: *ir.Function, iid: ir.InstructionId, kind: value.ValueKind, want: u64) u32 {
    val opt_ins: opt[*instruction.Instruction] = ir.instruction_get(f, iid);
    if (sel opt_ins.none) { ret 0; }
    val ins:  *instruction.Instruction = opt_ins.some;
    var hits: u32                      = 0;
    var oi:   u32                      = 0;
    for (oi < ins.operand_count) {
        val v: *value.Value = ?ins.operands[oi];
        if (v.kind == kind) {
            if (kind == value.VAL_CONST_INT && v.data.int_lit == want)     { hits = hits + 1; }
            if (kind == value.VAL_GLOBAL && v.data.global_ix::u64 == want) { hits = hits + 1; }
        }
        oi = oi + 1;
    }
    ret hits;
}

pub fun ut_global_ix(s: *session.Session, m: *ir.Module, needle: str) i64 {
    if (m == nil) { ret -1; }
    var gi: u32 = 0;
    for (gi < m.global_len) {
        val nm: opt[str] = intern.lookup(?s.interner, (?m.globals[gi]).name);
        if (sel nm.some && ut_str_contains(nm.some, needle)) { ret gi::i64; }
        gi = gi + 1;
    }
    ret -1;
}

pub fun ut_ct_lower_errs(src: str) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret -1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret -1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = src;
    val pr: res[project.Project, outcome.Fail] = ut_build(?s, ?alloc, ?names[0], ?texts[0], 1);
    if (sel pr.err) {
        session.dnit(?s);
        ret -1;
    }
    var p: project.Project = pr.ok;

    var checked:    err[outcome.Fail] = driver.run_sema_pass(?p);
    val checked_ok: bool              = sel checked.ok;
    if (checked_ok) { checked = driver.run_lower_pass(?p); }
    var errs: i32 = ut_count_errors(?s.diags)::i32;
    if (sel checked.err
        && (!outcome.is_reported(checked.err) || errs == 0)) { errs = -1; }

    project.dnit_project(?p);
    session.dnit(?s);
    ret errs;
}

pub fun ut_ct_lower_diag(src: str, needle: str) i32 {
    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = src;
    ret ut_ct_lower_diag_n(?names[0], ?texts[0], 1, needle);
}

pub fun ut_ct_lower_diag_n(names: *str, texts: *str, n: u32, needle: str) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    val pr: res[project.Project, outcome.Fail] = ut_build(?s, ?alloc, names, texts, n);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    var checked:    err[outcome.Fail] = driver.run_sema_pass(?p);
    val checked_ok: bool              = sel checked.ok;
    if (checked_ok) { checked = driver.run_lower_pass(?p); }
    var code:    i32  = 1;
    var settled: bool = sel checked.ok;
    if (sel checked.err)                          { settled = outcome.is_reported(checked.err); }
    if (settled && ut_diag_has(?s.diags, needle)) { code = 0; }

    project.dnit_project(?p);
    session.dnit(?s);
    ret code;
}

pub fun ut_ct_lower_lacks(src: str, needle: str) bool {
    ret ut_ct_lower_errs(src) >= 0 && ut_ct_lower_diag(src, needle) != 0;
}

pub fun ut_ct_lower_clean(src: str) bool {
    ret ut_ct_lower_errs(src) == 0;
}

pub fun ut_defined_fn_count(s: *session.Session, m: *ir.Module, needle: str) u32 {
    if (m == nil) { ret 0; }
    var hits: u32 = 0;
    var fi:   u32 = 0;
    for (fi < m.function_len) {
        val f: *ir.Function = ?m.functions[fi];
        if ((f.flags & ir.FN_FLAG_EXTERN) == 0) {
            val nm: opt[str] = intern.lookup(?s.interner, f.name);
            if (sel nm.some && ut_str_contains(nm.some, needle)) { hits = hits + 1; }
        }
        fi = fi + 1;
    }
    ret hits;
}

pub fun ut_defined_fn_exact(s: *session.Session, m: *ir.Module, name: str) u32 {
    if (m == nil) { ret 0; }
    var hits: u32 = 0;
    var fi:   u32 = 0;
    for (fi < m.function_len) {
        val f: *ir.Function = ?m.functions[fi];
        if ((f.flags & ir.FN_FLAG_EXTERN) == 0) {
            val nm: opt[str] = intern.lookup(?s.interner, f.name);
            if (sel nm.some && str_equals(nm.some, name)) { hits = hits + 1; }
        }
        fi = fi + 1;
    }
    ret hits;
}

pub fun ut_app(buf: *u8, w: usize, text: str) usize {
    var i: usize = 0;
    var k: usize = w;
    for (i < str_len(text)) {
        buf[k] = text[i];
        k      = k + 1;
        i      = i + 1;
    }
    ret k;
}

pub val UT_RV32_MEM:   usize = 262144;
val     UT_RV32_CODE:  u32   = 0x1000;
val     UT_RV32_STACK: u32   = 0x3FFF0;

pub fun ut_rv32_run(mem: *u8, off: u32, args: *u32, nargs: u32,
    lo: *u32, hi: *u32, steps: *u32) bool {
    var core: rv32.Core;
    var i:    usize = 0;
    for (i < 32) {
        core.x[i] = 0;
        core.f[i] = 0;
        i         = i + 1;
    }
    core.frm     = 0;
    core.refused = "";

    core.x[1] = rv32.RETURN_SENTINEL;
    core.x[2] = UT_RV32_STACK;
    core.pc   = UT_RV32_CODE + off;

    var k: u32 = 0;
    for (k < nargs && k < 8) {
        core.x[(10 + k)::usize] = args[k];
        k                       = k + 1;
    }
    for (k < nargs) {
        val at: u32 = UT_RV32_STACK + (k - 8) * 4;
        var b:  u32 = 0;
        for (b < 4) {
            mem[(at + b)::usize] = ((args[k] >> (b * 8)) & 0xFF)::u8;
            b                    = b + 1;
        }
        k = k + 1;
    }

    if (!rv32.exec_reference(mem, UT_RV32_MEM, ?core)) { ret false; }
    @lo    = core.x[10];
    @hi    = core.x[11];
    @steps = core.steps;
    ret true;
}

pub val UT_RV32_MUL:  u32 = 0;
pub val UT_RV32_XOR:  u32 = 1;
pub val UT_RV32_ADD:  u32 = 2;
pub val UT_RV32_EQ:   u32 = 3;
pub val UT_RV32_LTU:  u32 = 4;
pub val UT_RV32_LTS:  u32 = 5;
pub val UT_RV32_SHL:  u32 = 6;
pub val UT_RV32_SHRU: u32 = 7;
pub val UT_RV32_SHRS: u32 = 8;
pub val UT_RV32_DIVU: u32 = 9;

val UT_RV32_FNS: u32 = 11;

fun ut_rv32_probe_name(slot: u32) str {
    if (slot == UT_RV32_MUL)  { ret "mul64"; }
    if (slot == UT_RV32_XOR)  { ret "xor64"; }
    if (slot == UT_RV32_ADD)  { ret "add64"; }
    if (slot == UT_RV32_EQ)   { ret "eq64"; }
    if (slot == UT_RV32_LTU)  { ret "ltu64"; }
    if (slot == UT_RV32_LTS)  { ret "lts64"; }
    if (slot == UT_RV32_SHL)  { ret "shl64"; }
    if (slot == UT_RV32_SHRU) { ret "shru64"; }
    if (slot == UT_RV32_SHRS) { ret "shrs64"; }
    if (slot == UT_RV32_DIVU) { ret "divu64"; }
    ret "remu64";
}

# the linkage name of the one defined function a probe name tails, which the
# captured link must keep because only the sweep reaches it
fun ut_rv32_probe_symbol(images: *of.ObjectImage, count: u32, itn: *intern.Interner, want: str, out: *str) bool {
    var hits: u32 = 0;
    var m:    u32 = 0;
    for (m < count) {
        var sy: u32 = 0;
        for (sy < images[m].symbol_count) {
            val sym:     *of.Symbol = ?images[m].symbols[sy];
            val looked:  opt[str]   = intern.lookup(itn, sym.name);
            val defined: bool       = (sym.flags & of.SYM_OBJ_FLAG_FUNCTION) != 0 && !of.section_is_external(sym.section);
            if (sel looked.some) {
                val nm: str = looked.some;
                if (defined && ut_name_tail_is(nm, want)) {
                    hits = hits + 1;
                    @out = nm;
                }
            }
            sy = sy + 1;
        }
        m = m + 1;
    }
    ret hits == 1;
}

fun ut_rv32_probe_offset(img: *linker.LinkedImage, itn: *intern.Interner, want: str, off: *u32) bool {
    var hits:  u32 = 0;
    var found: u64 = 0;
    var i:     u32 = 0;
    for (i < img.symbol_count) {
        val looked: opt[str] = intern.lookup(itn, img.symbols[i].name);
        if (sel looked.some) {
            val nm: str = looked.some;
            if (ut_name_tail_is(nm, want)) {
                hits  = hits + 1;
                found = img.symbols[i].vaddr;
            }
        }
        i = i + 1;
    }
    if (hits != 1) { ret false; }
    @off = (found - img.base)::u32;
    ret true;
}

pub fun ut_name_tail_is(name: str, tail: str) bool {
    val n: usize = str_len(name);
    val t: usize = str_len(tail);
    if (t == 0 || t > n)                 { ret false; }
    if (n > t && name[n - t - 1] != '.') { ret false; }
    var i: usize = 0;
    for (i < t) {
        if (name[n - t + i] != tail[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

pub fun ut_rv32_link_captured(p: *project.Project, mem: *u8, len_out: *u32, offs: *u32) bool {
    val alloc: *A.Allocator = p.alloc;
    if (p.emit_len == 0) { ret false; }

    val ir: res[*of.ObjectImage, A.Error] = A.allocate[of.ObjectImage](alloc, p.emit_len::usize);
    if (sel ir.err) { ret false; }
    val images:  *of.ObjectImage = ir.ok;
    var missing: bool            = false;
    var i:       u32             = 0;
    for (i < p.emit_len) {
        val m: *project.ModuleEntry = project.module_at(p, (p.topo[i])::u32);
        if (m.object_image == nil) { missing = true; }
        or                         { images[i] = @m.object_image; }
        i = i + 1;
    }

    var probes:      [UT_RV32_FNS]str;
    var probe_count: u32 = 0;
    if (offs != nil) { probe_count = UT_RV32_FNS; }
    var pk: u32 = 0;
    for (!missing && pk < probe_count) {
        if (!ut_rv32_probe_symbol(images, p.emit_len, ?p.s.interner, ut_rv32_probe_name(pk), ?probes[pk])) {
            missing = true;
        }
        pk = pk + 1;
    }
    var cap:    linker.LinkedImage;
    var linked: bool = false;
    if (!missing) {
        val lr: err[fail.Fail] = linker.link_images_captured(p.s, ?p.target, images,
            p.emit_len, nil::*of.DynLib, 0, "rv32probe"::*u8, false,
            of.image_options_default(of.SUBSYSTEM_CONSOLE), ?probes[0], probe_count, ?cap);
        linked = sel lr.ok;
    }
    A.deallocate[of.ObjectImage](alloc, images, p.emit_len::usize);
    if (!linked) { ret false; }

    var ok: bool = cap.len > 0 && UT_RV32_CODE::usize + cap.len < UT_RV32_STACK::usize;
    if (ok && offs != nil) {
        var k: u32 = 0;
        for (k < UT_RV32_FNS) {
            if (!ut_rv32_probe_offset(?cap, ?p.s.interner, ut_rv32_probe_name(k), ?offs[k])) { ok = false; }
            k = k + 1;
        }
    }
    if (ok) {
        var z: usize = 0;
        for (z < UT_RV32_MEM) {
            mem[z] = 0;
            z      = z + 1;
        }
        z = 0;
        for (z < cap.len) {
            mem[UT_RV32_CODE::usize + z] = cap.bytes[z];
            z                            = z + 1;
        }
        @len_out = cap.len::u32;
    }
    linker.linked_image_dnit(?cap, alloc);
    ret ok;
}

pub fun ut_rv32_build_linked(s: *session.Session, alloc: *A.Allocator, src: str, tgt: str,
    mem: *u8, len_out: *u32) bool {
    ret ut_rv32_build_linked_at(s, alloc, ut_ct_edge_manifest(), "", src, tgt, mem, len_out);
}

pub fun ut_rv32_build_linked_at(s: *session.Session, alloc: *A.Allocator, manifest_text: str, profile: str,
    src: str, tgt: str, mem: *u8, len_out: *u32) bool {
    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = src;
    val root_r: res[str, fail.Fail] = ut_scaffold_m(alloc, manifest_text, ?names[0], ?texts[0], 1);
    if (sel root_r.err) { ret false; }
    val root: str = root_r.ok;

    var ok: bool              = false;
    val rr: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.ok) {
        var tsel_12976: manifest.Selection = ut_target_sel(tgt);
        tsel_12976.profile = profile;
        val pr: res[project.Project, outcome.Fail] = driver.build_project(s, root, ?tsel_12976);
        if (sel pr.ok) {
            var p: project.Project = pr.ok;
            if (ut_run_codegen_ok(?p) == 0) { ok = ut_rv32_link_captured(?p, mem, len_out, nil::*u32); }
            project.dnit_project(?p);
        }
    }
    fs.remove_all(alloc, root);
    ret ok;
}

pub fun ut_diag_has_warning(d: *diagnostic.DiagnosticStore, needle: str) bool {
    var i: usize = 0;
    for (i < diagnostic.len(d)) {
        if (d.items.data[i].severity == diagnostic.SEVERITY_WARNING
            && ut_str_contains(d.items.data[i].message, needle)) { ret true; }
        i = i + 1;
    }
    ret false;
}

pub fun ut_divide_manifest() str {
    ret "[project]\nmach = \">=5\"\nid = \"divtrap\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.linux-x86_64]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[target.linux-arm64]\nisa = \"aarch64\"\nos = \"linux\"\nabi = \"aapcs64\"\n\n[target.linux-riscv64]\nisa = \"riscv64\"\nos = \"linux\"\nabi = \"lp64d\"\n\n[artifact.divtrap]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/divtrap\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n";
}

pub fun ut_run_with_argc(cwd: str, runner: str, program: str, argc: usize, trapped: *bool, exit_code: *i32) bool {
    var argv:   [12]*u8;
    var n:      usize = 0;
    var launch: str   = program;
    if (!str_empty(runner)) {
        argv[n] = runner::*u8;
        n       = n + 1;
        launch  = runner;
    }
    argv[n] = program::*u8;
    n       = n + 1;
    var extra: usize = 1;
    for (extra < argc) {
        argv[n] = "x"::*u8;
        n       = n + 1;
        extra   = extra + 1;
    }
    argv[n] = nil;
    val spawned: res[exec.Child, exec.Error] = exec.spawn_in(launch, ?argv[0], env.environ(), cwd);
    if (sel spawned.err) { ret false; }
    val rr: res[exec.ExitStatus, exec.Error] = exec.wait(spawned.ok);
    if (sel rr.err) { ret false; }
    val status: exec.ExitStatus = rr.ok;
    @trapped   = false;
    @exit_code = -1;
    if (exec.signaled(status)) {
        val sig: i32 = exec.signal(status);
        @trapped = sig == 4 || sig == 5 || sig == 8;
        ret true;
    }
    if (!exec.exited(status)) { ret false; }
    @exit_code = exec.code(status)::i32;
    @trapped   = @exit_code == 132 || @exit_code == 133 || @exit_code == 136;
    ret true;
}

# the pipeline's verdict on one program: 0 accepted, 1 rejected (a reported diagnostic, or the constant-time
# validator's refusal, which the backend still surfaces as an internal failure naming the oblivious function), -1 apparatus
pub fun ut_pipeline_verdict(alloc: *A.Allocator, text: str, found: pipeline.OptLevel) i32 {
    val sr: res[session.Session, fail.Fail] = session.init(alloc);
    if (sel sr.err) { ret -1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) { ret -1; }
    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = text;
    val root_r: res[str, fail.Fail] = ut_scaffold(alloc, ?names[0], ?texts[0], 1);
    if (sel root_r.err) { ret -1; }
    val root: str = root_r.ok;
    fin { fs.remove_all(alloc, root); }
    val pr: res[project.Project, outcome.Fail] = ut_back_half_opt(?s, root, found);
    if (sel pr.err) {
        val f: outcome.Fail = pr.err;
        if (sel f.reported)                                                         { ret 1; }
        if (sel f.internal && ut_str_contains(outcome.describe(f), "#[oblivious]")) { ret 1; }
        ret -1;
    }
    var p: project.Project = pr.ok;
    project.dnit_project(?p);
    ret 0;
}

pub fun ut_str_ends_with(hay: str, needle: str) bool {
    val hn: usize = str_len(hay);
    val nn: usize = str_len(needle);
    if (nn > hn) { ret false; }
    var k: usize = 0;
    for (k < nn) {
        if (hay[hn - nn + k] != needle[k]) { ret false; }
        k = k + 1;
    }
    ret true;
}

# the freestanding entry stub shared by the native tag fixtures
pub fun ut_tag_start_stub() str {
    ret "\n#[symbol(\"_start\")]\npub fun start() {\n    $if ($mach.build.arch == $mach.arch.x86_64) {\n        asm x86_64 {\n            mov rdi, [rsp]\n            and rsp, -16\n            call main\n            mov rdi, rax\n            mov rax, 60\n            syscall\n        }\n    }\n    $or ($mach.build.arch == $mach.arch.aarch64) {\n        asm aarch64 {\n            ldr x0, [sp]\n            bl main\n            mov x8, 93\n            svc 0\n        }\n    }\n    $or {\n        asm riscv64 {\n            ld a0, 0(sp)\n            call main\n            li a7, 93\n            ecall\n        }\n    }\n}\n";
}

# builds a freestanding tag fixture for one target and profile and runs it; the fixture exits 0 when every check holds
pub fun ut_tag_native_case(alloc: *A.Allocator, target_name: str, runner_name: str, release: bool, program: str, label: str) i32 {
    ret ut_tag_native_case_files(alloc, ut_divide_manifest(), nil, nil, 0, target_name, runner_name, release, program, label);
}

# the same with the project's manifest and extra files at the project root (a C probe and the script that compiles it)
pub fun ut_tag_native_case_files(alloc: *A.Allocator, manifest_text: str, root_names: *str, root_texts: *str, root_count: u32,
    target_name: str, runner_name: str, release: bool, program: str, label: str) i32 {
    var runner: str = "";
    if (!str_empty(runner_name)) {
        val rr: res[str, exec.Error] = exec.resolve(alloc, runner_name);
        if (sel rr.err) {
            print.print("tag-native: runner absent, arm skipped: ");
            print.print(runner_name);
            print.print("\n");
            ret 0;
        }
        runner = rr.ok;
    }
    val sr: res[session.Session, fail.Fail] = session.init(alloc);
    if (sel sr.err) { ret 1; }
    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = program;
    if (root_count == 0) { texts[0] = ut_cc3(alloc, program, "\n", ut_tag_start_stub()); }
    val root_r: res[str, fail.Fail] = ut_scaffold_m(alloc, manifest_text, ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;
    var ri:   u32 = 0;
    for (ri < root_count) {
        val fp:            str             = ut_cc3(alloc, root, "/", root_names[ri]);
        val write_bytes_r: err[fs.FsError] = fs.write_bytes(fp, root_texts[ri], str_len(root_texts[ri]), 420);
        if (sel write_bytes_r.err) {
            fs.remove_all(alloc, root);
            session.dnit(?s);
            ret 1;
        }
        ri = ri + 1;
    }

    var bad: i32                                  = 0;
    val mr:  res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) {
        fs.remove_all(alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var m:  manifest.Manifest    = mr.ok;
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    rq.target       = target_name;
    if (release) {
        rq.profile = "release";
        rq.opt     = pipeline.OPT_RELEASE;
    }
    val pr: res[bplan.BuildPlan, outcome.Fail] = bplan.plan(alloc, ?s.interner, s.registry, ?m, rq);
    if (sel pr.err) {
        fs.remove_all(alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var bp: bplan.BuildPlan                         = pr.ok;
    val br: res[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, alloc, nil);
    if (sel br.err) {
        print.print("tag-native: build failed for ");
        print.print(label);
        print.print(" on ");
        print.print(target_name);
        print.print("\n");
        bad = 2;
    }
    if (sel br.ok) {
        val bo: outcome.BuildOutcome = br.ok;
        if (bo.severity != outcome.BUILD_OK || bo.artifacts.len != 1) { bad = 3; }
        or {
            var trapped: bool = false;
            var code:    i32  = 0;
            if (!ut_run_with_argc(root, runner, bo.artifacts.data[0].path, 1, ?trapped, ?code)) { bad = 4; }
            or (trapped || code != 0) {
                print.print("tag-native: ");
                print.print(label);
                print.print(" on ");
                print.print(target_name);
                var profile_name: str = "debug";
                if (release) { profile_name = "release"; }
                print.print(" ");
                print.print(profile_name);
                print.printf(" (trapped {}, exit {})\n", trapped::u8, code);
                bad = 5;
            }
        }
    }
    val remove_all_r: err[fs.FsError] = fs.remove_all(alloc, root);
    if (sel remove_all_r.err) { bad = 6; }
    session.dnit(?s);
    ret bad;
}

# runs one fixture on the three native linux targets in both profiles
pub fun ut_tag_native_all(alloc: *A.Allocator, program: str, label: str) i32 {
    var release: bool = false;
    var pass:    u32  = 0;
    for (pass < 2) {
        if (ut_tag_native_case(alloc, "linux-x86_64", "", release, program, label) != 0)              { ret 1; }
        if (ut_tag_native_case(alloc, "linux-arm64", "qemu-aarch64", release, program, label) != 0)   { ret 2; }
        if (ut_tag_native_case(alloc, "linux-riscv64", "qemu-riscv64", release, program, label) != 0) { ret 3; }
        release = true;
        pass    = pass + 1;
    }
    ret 0;
}

# true when sema, lowering or codegen rejects the text with a diagnostic carrying the needle
pub fun ut_pipeline_rejects_with(alloc: *A.Allocator, text: str, needle: str) bool {
    val sr: res[session.Session, fail.Fail] = session.init(alloc);
    if (sel sr.err) { ret false; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) { ret false; }
    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = text;
    val root_r: res[str, fail.Fail] = ut_scaffold(alloc, ?names[0], ?texts[0], 1);
    if (sel root_r.err) { ret false; }
    val root: str = root_r.ok;
    fin { fs.remove_all(alloc, root); }
    val pr: res[project.Project, outcome.Fail] = ut_back_half_opt(?s, root, pipeline.OPT_DEBUG);
    if (sel pr.ok) {
        var p: project.Project = pr.ok;
        project.dnit_project(?p);
        ret false;
    }
    ret outcome.is_reported(pr.err) && ut_diag_has(?s.diags, needle);
}

pub fun ut_sema_build(s: *session.Session, root: str) res[project.Project, outcome.Fail] {
    val pr: res[project.Project, outcome.Fail] = driver.build_project_union(s, root);
    if (sel pr.err) { ret pr; }
    var p:  project.Project   = pr.ok;
    val se: err[outcome.Fail] = driver.run_sema_pass(?p);
    if (sel se.err) {
        project.dnit_project(?p);
        ret res[project.Project, outcome.Fail].err{se.err};
    }
    ret res[project.Project, outcome.Fail].ok{p};
}

pub fun ut_attr_probe(s: *session.Session, alloc: *A.Allocator, names: *str, texts: *str,
    n: u32, target_name: str, sym: str) res[str, outcome.Fail] {
    val root_r: res[str, fail.Fail] = ut_scaffold(alloc, names, texts, n);
    if (sel root_r.err) {
        ret res[str, outcome.Fail].err{outcome.from_fail(root_r.err)};
    }
    val root: str               = root_r.ok;
    val rr:   err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.err) {
        fs.remove_all(alloc, root);
        ret res[str, outcome.Fail].err{rr.err};
    }
    var tsel_14044: manifest.Selection                 = ut_target_sel(target_name);
    val pr:         res[project.Project, outcome.Fail] = driver.build_project(s, root, ?tsel_14044);
    fs.remove_all(alloc, root);
    if (sel pr.err) {
        ret res[str, outcome.Fail].err{pr.err};
    }
    var p: project.Project = pr.ok;

    val se: err[outcome.Fail] = driver.run_sema_pass(?p);
    if (sel se.err) {
        project.dnit_project(?p);
        ret res[str, outcome.Fail].err{se.err};
    }
    val le: err[outcome.Fail] = driver.run_lower_pass(?p);
    if (sel le.err) {
        project.dnit_project(?p);
        ret res[str, outcome.Fail].err{le.err};
    }

    var out: str                        = "";
    val sid: res[intern.StrId, A.Error] = intern.intern(?s.interner, sym);
    if (sel sid.ok) {
        val got: opt[intern.StrId] = session.import_library(s, sid.ok);
        if (sel got.some) {
            val nm: opt[str] = intern.lookup(?s.interner, got.some);
            if (sel nm.some) { out = nm.some; }
        }
    }
    project.dnit_project(?p);
    ret res[str, outcome.Fail].ok{out};
}

pub fun ut_spv_manifest(alloc: *A.Allocator, dep_alias: str) str {
    val head: str = "[project]\nmach = \">=5\"\nid = \"spvcase\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.spirv]\nisa = \"spirv\"\nos = \"freestanding\"\nabi = \"spirv\"\n\n[profile.debug]\nopt = 0\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n\n[artifact.spvcase]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/spvcase\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
    if (str_len(dep_alias) == 0::usize) { ret head; }
    val a: str = ut_cc3(alloc, head, "\n[dep.", dep_alias);
    val b: str = ut_cc3(alloc, a, "]\npath = \"", dep_alias);
    ret ut_cc3(alloc, b, "\"\n", "");
}

fun ut_spv_dep_manifest(alloc: *A.Allocator, id: str) str {
    ret ut_cc3(alloc, "[project]\nmach = \">=5\"\nid = \"", id, "\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.spirv]\nisa = \"spirv\"\nos = \"freestanding\"\nabi = \"spirv\"\n\n[profile.debug]\nopt = 0\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n");
}

pub fun ut_write_node_multi(alloc: *A.Allocator, dir: str, manifest_text: str,
    names: *str, texts: *str, n: u32) err[fail.Fail] {
    val d1: err[fs.FsError] = fs.create_dir_all(alloc, dir, 493);
    if (sel d1.err) { ret err[fail.Fail].err{fail.fs_refused(d1.err)}; }
    val src_dir: str             = ut_cc3(alloc, dir, "/", "src");
    val d2:      err[fs.FsError] = fs.create_dir_all(alloc, src_dir, 493);
    if (sel d2.err) { ret err[fail.Fail].err{fail.fs_refused(d2.err)}; }
    val mf: str             = ut_cc3(alloc, dir, "/", manifest.MANIFEST_FILE);
    val w0: err[fs.FsError] = fs.write_bytes(mf, manifest_text, str_len(manifest_text), 420);
    if (sel w0.err) { ret err[fail.Fail].err{fail.fs_refused(w0.err)}; }
    var i: u32 = 0;
    for (i < n) {
        val sf: str             = ut_cc3(alloc, src_dir, "/", names[i]);
        val w:  err[fs.FsError] = fs.write_bytes(sf, texts[i], str_len(texts[i]), 420);
        if (sel w.err) { ret err[fail.Fail].err{fail.fs_refused(w.err)}; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

pub fun ut_spv_lower(s: *session.Session, alloc: *A.Allocator,
    names: *str, texts: *str, n: u32,
    dep_id: str, dep_names: *str, dep_texts: *str, dep_n: u32) res[project.Project, outcome.Fail] {
    ret ut_spv_lower_debug(s, alloc, names, texts, n, dep_id, dep_names, dep_texts, dep_n, false);
}

pub fun ut_spv_lower_debug(s: *session.Session, alloc: *A.Allocator,
    names: *str, texts: *str, n: u32,
    dep_id: str, dep_names: *str, dep_texts: *str, dep_n: u32, debug: bool) res[project.Project, outcome.Fail] {
    val tf_r: res[fs.TempFile, fs.FsError] = fs.temp_create(alloc, "mach_spv_test");
    if (sel tf_r.err) { ret res[project.Project, outcome.Fail].err{outcome.internal(outcome.fs_text(tf_r.err))}; }
    var tf:    fs.TempFile       = tf_r.ok;
    val dup_r: res[str, A.Error] = str_dup(alloc, fs.temp_path(?tf));
    fs.temp_close_and_remove(?tf);
    if (sel dup_r.err) { ret res[project.Project, outcome.Fail].err{outcome.refused(dup_r.err)}; }
    val root: str = dup_r.ok;

    var alias: str = "";
    if (dep_n > 0) { alias = dep_id; }
    val wr: err[fail.Fail] = ut_write_node_multi(alloc, root, ut_spv_manifest(alloc, alias), names, texts, n);
    if (sel wr.err) {
        fs.remove_all(alloc, root);
        ret res[project.Project, outcome.Fail].err{outcome.from_fail(wr.err)};
    }

    if (dep_n > 0) {
        val dep_dir: str            = ut_cc3(alloc, root, "/dep/", dep_id);
        val dw:      err[fail.Fail] = ut_write_node_multi(alloc, dep_dir, ut_spv_dep_manifest(alloc, dep_id), dep_names, dep_texts, dep_n);
        if (sel dw.err) {
            fs.remove_all(alloc, root);
            ret res[project.Project, outcome.Fail].err{outcome.from_fail(dw.err)};
        }
        if (!ut_git_repo(alloc, root, "https://example.invalid/spvcase.git")) {
            fs.remove_all(alloc, root);
            ret res[project.Project, outcome.Fail].err{outcome.user("failed to initialize SPIR-V dependency fixture repository")};
        }
    }

    val rr: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.err) {
        fs.remove_all(alloc, root);
        ret res[project.Project, outcome.Fail].err{rr.err};
    }
    var tsel_14660: manifest.Selection                 = ut_target_sel("spirv");
    val pr:         res[project.Project, outcome.Fail] = driver.build_project(s, root, ?tsel_14660);
    fs.remove_all(alloc, root);
    if (sel pr.err) { ret pr; }
    var p: project.Project = pr.ok;
    p.req.debug = debug;

    val sr2: err[outcome.Fail] = driver.run_sema_pass(?p);
    if (sel sr2.err) {
        project.dnit_project(?p);
        ret res[project.Project, outcome.Fail].err{sr2.err};
    }
    val lr: err[outcome.Fail] = driver.run_lower_pass(?p);
    if (sel lr.err) {
        project.dnit_project(?p);
        ret res[project.Project, outcome.Fail].err{lr.err};
    }
    ret res[project.Project, outcome.Fail].ok{p};
}

pub fun ut_spv_diag_fired(alloc: *A.Allocator, src: str, needle: str) bool {
    val sr: res[session.Session, fail.Fail] = session.init(alloc);
    if (sel sr.err) { ret false; }
    var s:     session.Session = sr.ok;
    var names: [1]str;
    var texts: [1]str;
    names[0] = "main.mach";
    texts[0] = src;
    val pr: res[project.Project, outcome.Fail] = ut_spv_lower(?s, alloc, ?names[0], ?texts[0], 1, "", nil, nil, 0);
    if (sel pr.ok) {
        var p: project.Project = pr.ok;
        project.dnit_project(?p);
    }
    val fired: bool = ut_diag_has(?s.diags, needle);
    session.dnit(?s);
    ret fired;
}

pub fun ut_manifest_x64_linux() str {
    ret "[project]\nmach = \">=5\"\nid = \"uniontest\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.lx64]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[artifact.uniontest]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/uniontest\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n";
}

pub fun ut_le16(b: *u8, off: usize) u64 {
    ret b[off]::u64 | (b[off + 1]::u64 << 8);
}

pub fun ut_le32(b: *u8, off: usize) u64 {
    ret b[off]::u64 | (b[off + 1]::u64 << 8) | (b[off + 2]::u64 << 16) | (b[off + 3]::u64 << 24);
}

pub fun ut_agg_call_src() str {
    ret "rec Small { a: u32; b: u32; }\nrec Big { a: u32; b: u32; c: u32; d: u32; e: u32; f: u32; g: u32; h: u32; }\nrec Inner { x: u32; y: u32; }\nrec Nest { i: Inner; z: u32; }\nrec WithArr { v: [4]u32; t: u32; }\nrec WithVec { v: u32x4; t: u32; }\n\nfun sum_small(p: Small) u32 { ret p.a + p.b * 10; }\nfun make_small() Small { ret Small{a: 7, b: 6}; }\nfun sum_big(p: Big) u32 { ret p.a + p.b * 10 + p.c * 100 + p.d * 1000 + p.e * 10000 + p.f * 100000 + p.g * 1000000 + p.h * 10000000; }\nfun sum_nest(p: Nest) u32 { ret p.i.x + p.i.y * 10 + p.z * 100; }\nfun sum_arr(p: WithArr) u32 { ret p.v[0] + p.v[1] * 10 + p.v[2] * 100 + p.v[3] * 1000 + p.t * 10000; }\nfun sum_vec(p: WithVec) u32 { ret p.v[0] + p.v[1] * 10 + p.v[2] * 100 + p.v[3] * 1000 + p.t * 10000; }\n\n#[output(0)] var o_small: u32;\n#[output(1)] var o_small_ctl: u32;\n#[output(2)] var o_ret: u32;\n#[output(3)] var o_big: u32;\n#[output(4)] var o_big_ctl: u32;\n#[output(5)] var o_nest: u32;\n#[output(6)] var o_nest_ctl: u32;\n#[output(7)] var o_arr: u32;\n#[output(8)] var o_arr_ctl: u32;\n#[output(9)] var o_vec: u32;\n#[output(10)] var o_vec_ctl: u32;\n\n#[stage(\"vertex\")]\nfun vs() {\n    val s: Small = Small{a: 7, b: 6};\n    o_small = sum_small(s);\n    o_small_ctl = s.a + s.b * 10;\n\n    val r: Small = make_small();\n    o_ret = r.a + r.b * 10;\n\n    val b: Big = Big{a: 1, b: 2, c: 3, d: 4, e: 5, f: 6, g: 7, h: 8};\n    o_big = sum_big(b);\n    o_big_ctl = b.a + b.b * 10 + b.c * 100 + b.d * 1000 + b.e * 10000 + b.f * 100000 + b.g * 1000000 + b.h * 10000000;\n\n    val nn: Nest = Nest{i: Inner{x: 4, y: 3}, z: 2};\n    o_nest = sum_nest(nn);\n    o_nest_ctl = nn.i.x + nn.i.y * 10 + nn.z * 100;\n\n    val wa: WithArr = WithArr{v: [4]u32{9, 8, 7, 6}, t: 5};\n    o_arr = sum_arr(wa);\n    o_arr_ctl = wa.v[0] + wa.v[1] * 10 + wa.v[2] * 100 + wa.v[3] * 1000 + wa.t * 10000;\n\n    val qv: WithVec = WithVec{v: u32x4{2, 3, 4, 5}, t: 1};\n    o_vec = sum_vec(qv);\n    o_vec_ctl = qv.v[0] + qv.v[1] * 10 + qv.v[2] * 100 + qv.v[3] * 1000 + qv.t * 10000;\n}\n\nfun main() i32 { ret 0; }\n";
}

# the first error the store holds after a rejected pass, or the failure's
# own text when the pass failed without reporting
pub fun ut_codegen_outcome_text(s: *session.Session, f: outcome.Fail) str {
    if (!outcome.is_reported(f)) { ret outcome.describe(f); }
    var i: usize = 0;
    for (i < diagnostic.len(?s.diags)) {
        val d: *diagnostic.Diagnostic = ?s.diags.items.data[i];
        if (d.severity == diagnostic.SEVERITY_ERROR) { ret d.message; }
        i = i + 1;
    }
    ret outcome.describe(f);
}

pub fun ut_digest_eq(a: *u8, b: *u8) bool {
    var i: usize = 0;
    for (i < 32) {
        if (a[i] != b[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

pub fun ut_first_gate_cond(a: *ast.Ast) aid.ExprId {
    val m_opt: opt[*amodule.Module] = ast.get_module(a, a.root_module);
    if (sel m_opt.none) { ret aid.EXPR_NIL; }
    val mnode: *amodule.Module = m_opt.some;
    var i:     u32             = 0;
    for (i < mnode.decls_len) {
        val did:   aid.DeclId      = a.decl_ids[mnode.decls_start + i];
        val d_opt: opt[*decl.Decl] = ast.get_decl(a, did);
        if (sel d_opt.some) {
            val d: *decl.Decl = d_opt.some;
            if (d.kind == decl.DECL_KIND_COMPTIME_IF && d.data.comptime_if.branches_len > 0) {
                ret (?a.comptime_branches[d.data.comptime_if.branches_start]).cond;
            }
        }
        i = i + 1;
    }
    ret aid.EXPR_NIL;
}

pub fun ut_gate_diag_located(text: str, needle: str, want_file: str, want_line: usize,
    want_col: usize, want_text: str) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:     session.Session = sr.ok;
    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = text;
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root:             str               = root_r.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 2;
    }
    var tsel_19570: manifest.Selection                 = ut_target_sel("linux");
    val pr:         res[project.Project, outcome.Fail] = driver.build_project(?s, root, ?tsel_19570);
    fs.remove_all(?alloc, root);

    var code: i32   = 3;
    var i:    usize = 0;
    for (i < diagnostic.len(?s.diags)) {
        val d: *diagnostic.Diagnostic = ?s.diags.items.data[i];
        if (d.severity == diagnostic.SEVERITY_ERROR && ut_str_contains(d.message, needle)) {
            code = 0;
            val f_opt: opt[*src.SourceFile] = src.get(?s.sources, d.loc.file_id);
            if (sel f_opt.some) {
                val f: *src.SourceFile = f_opt.some;
                if (!str_contains(f.path, want_file)) { code = 5; }
                or {
                    val pos: src.Position = src.position(f, d.loc.span.offset);
                    if (pos.line != want_line)                                                    { code = 6; }
                    or (pos.col != want_col)                                                      { code = 7; }
                    or (!str_region_equals(f.text, d.loc.span.offset, d.loc.span.len, want_text)) { code = 8; }
                }
            }
            i = diagnostic.len(?s.diags);
        }
        or { i = i + 1; }
    }

    if (sel pr.ok) {
        var p: project.Project = pr.ok;
        project.dnit_project(?p);
    }
    session.dnit(?s);
    ret code;
}

pub fun ut_planned_link_images(s: *session.Session, tgt: *target.Target, images: *of.ObjectImage,
    image_count: u32, dynlibs: *of.DynLib, dynlib_count: u32,
    out_path: *u8, name: *u8, mode: linker.LinkMode, pie: bool,
    image_options: of.ImageOptions) err[fail.Fail] {
    if (out_path == nil || str_len(out_path::str) == 0) { ret linker.link_images(s, tgt, images, image_count, dynlibs, dynlib_count, nil, name, mode, pie, image_options); }
    ret linker.link_images(s, tgt, images, image_count, dynlibs, dynlib_count, out_path::str, name, mode, pie, image_options);
}

# the std failure tags exactly as std declares them: the compiler knows nothing about these
# names, so a fixture that uses `outcome_r`, `found` or `fault` declares them beneath this prelude
val TAG_STD_PRELUDE: str = "tag res[T, E]: u8 { err: E; ok: T; } tag opt[T]: u8 { none; some: T; } tag err[E]: u8 { err: E; ok; }\n";

# `text` beneath the std tag prelude; released with ut_std_tags_free
pub fun ut_std_tags(alloc: *A.Allocator, text: str) err[fail.Fail] {
    val r: res[str, format.FormatError] = format.sprint(alloc, "{}{}", TAG_STD_PRELUDE, text);
    if (sel r.err) { ret err[fail.Fail].ok{}; }
    ret err[fail.Fail].err{fail.message(r.ok)};
}

pub fun ut_std_tags_free(alloc: *A.Allocator, text: str) {
    A.deallocate[char](alloc, text::*char, str_len(text) + 1);
}

# every plain single-module tag fixture the sema tests carry, in one spelling: the per-topic tests
# index it by range and the profile-agreement test builds every row beneath the std tag prelude
pub rec TagFixture {
    text:   str;
    needle: str;
    accept: bool;
    code:   i32;
}

