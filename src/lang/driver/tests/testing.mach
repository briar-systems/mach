pub fun ut_cc3(alloc: *A.Allocator, a: str, b: str, c: str) str {
    val la: usize             = str_len(a);
    val lb: usize             = str_len(b);
    val lc: usize             = str_len(c);
    val r:  res[*u8, A.Error] = A.allocate[u8](alloc, la + lb + lc + 1);
    if (sel r.err) { ret a; }
    val buf: *u8   = r.ok;
    var k:   usize = 0;
    var j:   usize = 0;
    for (j < la) {
        buf[k] = a[j];
        k      = k + 1;
        j      = j + 1;
    }
    j = 0;
    for (j < lb) {
        buf[k] = b[j];
        k      = k + 1;
        j      = j + 1;
    }
    j = 0;
    for (j < lc) {
        buf[k] = c[j];
        k      = k + 1;
        j      = j + 1;
    }
    buf[k] = 0;
    ret buf::str;
}

pub fun ut_entry_symbol() str {
    $if ($mach.build.os == $mach.os.windows) { ret "mainCRTStartup"; }
    $or ($mach.build.os == $mach.os.darwin)  { ret "start"; }
    ret "_start";
}

