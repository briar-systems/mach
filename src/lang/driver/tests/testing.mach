    ret ut_codegen_profile_ok(src, target_name, "");
}

pub fun ut_codegen_profile_ok(src: str, target_name: str, profile: str) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = src;
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str               = root_r.ok;
    val rr:   err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var tsel_1773: manifest.Selection = ut_target_sel(target_name);
    tsel_1773.profile = profile;
    val pr: res[project.Project, outcome.Fail] = driver.build_project(?s, root, ?tsel_1773);
    fs.remove_all(?alloc, root);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    val code: i32 = ut_run_codegen_ok(?p);
    project.dnit_project(?p);
    session.dnit(?s);
    ret code;
}

# the error carrying `needle` is located in the file whose path ends with
# `path_suffix`, at line:col
pub fun ut_diag_located_at(s: *session.Session, needle: str, path_suffix: str, line: usize, col: usize) bool {
    var i: usize = 0;
    for (i < diagnostic.len(?s.diags)) {
        val d: *diagnostic.Diagnostic = ?s.diags.items.data[i];
        i = i + 1;
        if (d.severity != diagnostic.SEVERITY_ERROR) { cnt; }
        if (!ut_str_contains(d.message, needle))     { cnt; }
        val sf: opt[*src.SourceFile] = src.get(?s.sources, d.loc.file_id);
        if (sel sf.none)                                  { cnt; }
        if (!ut_str_ends_with(sf.some.path, path_suffix)) { cnt; }
        val pos: src.Position = src.position(sf.some, d.loc.span.offset);
        if (pos.line == line && pos.col == col) { ret true; }
    }
    ret false;
}

