# a union analysis on a live session, as the editor rebuilds it after each edit
pub fun ut_gate_rebuild(s: *session.Session, root: str) res[project.Project, outcome.Fail] {
    val pr: res[project.Project, outcome.Fail] = driver.build_project_union(s, root);
    if (sel pr.err) { ret pr; }
    var p:  project.Project   = pr.ok;
    val se: err[outcome.Fail] = driver.run_sema_pass(?p);
    if (sel se.err) {
        project.dnit_project(?p);
        ret res[project.Project, outcome.Fail].err{se.err};
    }
    ret res[project.Project, outcome.Fail].ok{p};
}

pub fun ut_write_source(alloc: *A.Allocator, root: str, name: str, text: str) bool {
    val dir:   str             = ut_cc3(alloc, root, "/", "src");
    val file:  str             = ut_cc3(alloc, dir, "/", name);
    val wrote: err[fs.FsError] = fs.write_bytes(file, text, str_len(text), 420);
    ret sel wrote.ok;
}

# texts may name NATIVE_OS and FOREIGN_OS, spelled per host by ut_union_native_text
pub fun ut_gate_session(alloc: *A.Allocator, names: *str, texts: *str, n: u32, s: *session.Session) res[str, fail.Fail] {
    var i: u32 = 0;
    for (i < n) {
        val spelled: res[str, fail.Fail] = ut_union_native_text(alloc, texts[i]);
        if (sel spelled.err) { ret spelled; }
        texts[i] = spelled.ok;
        i        = i + 1;
    }
    val sr: res[session.Session, fail.Fail] = session.init(alloc);
    if (sel sr.err) { ret res[str, fail.Fail].err{sr.err}; }
    @s = sr.ok;
    val root_r: res[str, fail.Fail] = ut_scaffold(alloc, names, texts, n);
    if (sel root_r.err) {
        session.dnit(s);
        ret root_r;
    }
    val registered: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel registered.err) {
        fs.remove_all(alloc, root_r.ok);
        session.dnit(s);
        ret res[str, fail.Fail].err{fail.message("registry setup failed")};
    }
    ret root_r;
}

pub val UT_VIEW_CFG_ON:  str = "pub val FLAG: u8 = 1;\n";
pub val UT_VIEW_CFG_OFF: str = "pub val FLAG: u8 = 0;\n";

pub fun ut_ext_manifest(alloc: *A.Allocator, isa_name: str, os_name: str, abi_name: str, exts: str) str {
    var line: str = "";
    if (str_len(exts) != 0) {
        val l: res[str, format.FormatError] = format.sprint(alloc, "extensions = {}\n", exts);
        if (sel l.err) { ret ""; }
        line = l.ok;
    }
    val r: res[str, format.FormatError] = format.sprint(alloc,
        "[project]\nmach = \">=5\"\nid = \"exts\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{{target.name}}/{{profile.name}}\"\n\n[target.t]\nisa = \"{}\"\nos = \"{}\"\nabi = \"{}\"\n{}\n[artifact.exts]\nkind = \"static\"\nentry = \"main.mach\"\nout = \"lib/exts.a\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\ndefault = true\nopt = 0\ndebug = false\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n",
        isa_name, os_name, abi_name, line);
    if (sel r.err) { ret ""; }
    ret r.ok;
}
