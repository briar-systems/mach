fun ut_tuple_of_os(p: *project.Project, os_id: u32, same: bool) u32 {
    var ti: u32 = 0;
    for (ti < p.union_tuple_count) {
        if ((p.union_tuples[ti].os_id == os_id) == same) { ret ti; }
        ti = ti + 1;
    }
    ret project.FRAME_BUILD;
}

# the load decides each chain once in every tuple's frame and once in the build target's, which
# resolve reads; a constant a tuple's arm declares is that tuple's value in its own frame
test union_tuple_gates_are_keyed_apart_from_the_build_target {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var names:  [1]str              = [1]str{"main.mach"};
    var texts:  [1]str              = [1]str{"$if ($mach.build.os == $mach.os.linux) { def Flag: u8; val C: Flag = 1; } $or { def Flag: u8; val C: Flag = 0; }\n$if (C) { fun f() i32 { ret 1; } }\nfun main() i32 { ret 0; }\n"};
    var s:      session.Session;
    val root_r: res[str, fail.Fail] = ut_gate_session(?alloc, ?names[0], ?texts[0], 1, ?s);
    if (sel root_r.err) { ret 2; }
    val root: str = root_r.ok;
    fin {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
    }
    val built: res[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
    if (sel built.err) { ret 3; }
    var p: project.Project = built.ok;
    fin { project.dnit_project(?p); }
    val linux: u32 = ut_tuple_of_os(?p, os.OS_LINUX, true);
    val other: u32 = ut_tuple_of_os(?p, os.OS_LINUX, false);
    if (linux == project.FRAME_BUILD || other == project.FRAME_BUILD) { ret 4; }
    val a:    *ast.Ast   = ut_ast(?p, ?s, "uniontest.main");
    val cond: aid.ExprId = ut_first_gate_cond_after(a, 1);
    if (cond == aid.EXPR_NIL) { ret 5; }
    val m: *project.ModuleEntry = project.module_at(?p, ut_mid(?p, ?s, "uniontest.main")::u32);
    if (m.tuple_frames == nil || m.tuple_frame_count != p.union_tuple_count)            { ret 6; }
    if (comptime.gate_state(?m.tuple_frames[other], cond) != comptime.GATE_STATE_FALSE) { ret 7; }
    if (comptime.gate_state(?m.tuple_frames[linux], cond) != comptime.GATE_STATE_TRUE)  { ret 8; }
    if (comptime.gate_state(?m.ctx, cond) == comptime.GATE_STATE_UNKNOWN)               { ret 9; }
    if (ut_count_errors(?s.diags) != 0)                                                 { ret 10; }
    ret 0;
}

test union_tuple_gates_follow_an_imported_constant {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var names: [2]str = [2]str{"main.mach", "dep.mach"};
    var texts: [2]str = [2]str{
        "use uniontest.dep.ON;\n$if (ON) { fun selected() i32 { ret 1; } } $or { fun selected() i32 { ret 2; } }\nfun main() i32 { ret selected(); }\n",
        "pub val ON: u8 = 1;\n"
    };
    var s:      session.Session;
    val root_r: res[str, fail.Fail] = ut_gate_session(?alloc, ?names[0], ?texts[0], 2, ?s);
    if (sel root_r.err) { ret 2; }
    val root: str = root_r.ok;
    fin {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
    }
    val cold: res[project.Project, outcome.Fail] = ut_gate_rebuild(?s, root);
    if (sel cold.err) { ret 3; }
    var p: project.Project = cold.ok;
    project.dnit_project(?p);
    if (!ut_write_source(?alloc, root, "dep.mach", "pub val ON: u8 = 0;\n")) { ret 4; }
    val flipped: res[project.Project, outcome.Fail] = ut_gate_rebuild(?s, root);
    if (sel flipped.err) { ret 5; }
    p = flipped.ok;
    fin { project.dnit_project(?p); }
    val m:    *project.ModuleEntry = project.module_at(?p, ut_mid(?p, ?s, "uniontest.main")::u32);
    val cond: aid.ExprId           = ut_first_gate_cond(m.a);
    if (m.const_import_count == 0)                                      { ret 6; }
    if (comptime.gate_state(?m.ctx, cond) != comptime.GATE_STATE_FALSE) { ret 7; }
    var reached: u32 = 0;
    var ti:      u32 = 0;
    for (ti < p.union_tuple_count) {
        if (m.tuple_reachable != nil && m.tuple_reachable[ti]) {
            reached = reached + 1;
            if (m.tuple_frames == nil)                                                       { ret 8; }
            if (comptime.gate_state(?m.tuple_frames[ti], cond) != comptime.GATE_STATE_FALSE) { ret 9; }
        }
        ti = ti + 1;
    }
    if (reached == 0) { ret 10; }
    ret 0;
}

val UT_PAGE_NATIVE_FIRST: str = "$if ($mach.build.os == NATIVE_OS) { val PAGE: u64 = 4096; } $or { val PAGE: u64 = 16384; }\n$if (PAGE != 4096) { $error(\"PAGE read from another tuple's arm\"); }\nfun main() i32 { ret 0; }\n";
val UT_PAGE_NATIVE_LAST:  str = "$if ($mach.build.os != NATIVE_OS) { val PAGE: u64 = 16384; } $or { val PAGE: u64 = 4096; }\n$if (PAGE != 4096) { $error(\"PAGE read from another tuple's arm\"); }\nfun main() i32 { ret 0; }\n";

# a union analysis resolves a constant its tuples' arms declare differently from the arm the build
# target selects, whichever arm the load walks last (#3873)
test a_union_build_resolves_a_gated_constant_from_the_build_targets_arm {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var order: u32 = 0;
    for (order < 2) {
        var names: [1]str = [1]str{"main.mach"};
        var texts: [1]str = [1]str{UT_PAGE_NATIVE_FIRST};
        if (order == 1) { texts[0] = UT_PAGE_NATIVE_LAST; }
        var s:      session.Session;
        val root_r: res[str, fail.Fail] = ut_gate_session(?alloc, ?names[0], ?texts[0], 1, ?s);
        if (sel root_r.err) { ret 2 + order::i32 * 10; }
        val root:  str                                = root_r.ok;
        val built: res[project.Project, outcome.Fail] = ut_gate_rebuild(?s, root);
        var bad:   i32                                = 0;
        if (ut_diag_has(?s.diags, "another tuple's arm")) { bad = 3; }
        or (ut_count_errors(?s.diags) != 0)               { bad = 4; }
        if (sel built.ok) {
            var p: project.Project = built.ok;
            project.dnit_project(?p);
        }
        or (bad == 0) { bad = 5; }
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        if (bad != 0) { ret bad + order::i32 * 10; }
        order = order + 1;
    }
    ret 0;
}

val UT_PAGE_IMPORT_NATIVE_FIRST: str = "$if ($mach.build.os == NATIVE_OS) { val PAGE: u64 = 4096; } $or { use uniontest.foreign.PAGE; }\n$if (PAGE == 4096) { fun native_page() u64 { ret PAGE; } }\nfun main() i32 { ret native_page()::i32 - 4096; }\n";
val UT_PAGE_IMPORT_NATIVE_LAST:  str = "$if ($mach.build.os != NATIVE_OS) { use uniontest.foreign.PAGE; } $or { val PAGE: u64 = 4096; }\n$if (PAGE == 4096) { fun native_page() u64 { ret PAGE; } }\nfun main() i32 { ret native_page()::i32 - 4096; }\n";

# two arms bind one name to different values, one by a `val` and one by an import: the build
# target's frame binds only its own arm's value, and each tuple's frame reads its own (#3873)
test each_union_frame_binds_only_the_arm_it_selects {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var order: u32 = 0;
    for (order < 2) {
        var names: [2]str = [2]str{"main.mach", "foreign.mach"};
        var texts: [2]str = [2]str{UT_PAGE_IMPORT_NATIVE_FIRST, "pub val PAGE: u64 = 16384;\n"};
        if (order == 1) { texts[0] = UT_PAGE_IMPORT_NATIVE_LAST; }
        var s:      session.Session;
        val root_r: res[str, fail.Fail] = ut_gate_session(?alloc, ?names[0], ?texts[0], 2, ?s);
        if (sel root_r.err) { ret 2 + order::i32 * 20; }
        val root:  str                                = root_r.ok;
        val built: res[project.Project, outcome.Fail] = ut_gate_rebuild(?s, root);
        var bad:   i32                                = 0;
        if (sel built.ok) {
            var p: project.Project = built.ok;
            bad = ut_page_frames(?p, ?s);
            project.dnit_project(?p);
        }
        or                                              { bad = 3; }
        if (bad == 0 && ut_count_errors(?s.diags) != 0) { bad = 4; }
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        if (bad != 0) { ret bad + order::i32 * 20; }
        order = order + 1;
    }
    ret 0;
}

fun ut_page_frames(p: *project.Project, s: *session.Session) i32 {
    val native:  u32 = ut_tuple_of_os(p, ut_union_native_os_id(), true);
    val foreign: u32 = ut_tuple_of_os(p, ut_union_native_os_id(), false);
    if (native == project.FRAME_BUILD || foreign == project.FRAME_BUILD) { ret 5; }
    val m: *project.ModuleEntry = project.module_at(p, ut_mid(p, s, "uniontest.main")::u32);
    if (m.tuple_frames == nil || m.tuple_frame_count != p.union_tuple_count) { ret 6; }
    val name_r: res[intern.StrId, A.Error] = intern.intern(?s.interner, "PAGE");
    if (sel name_r.err) { ret 7; }
    # every binding of the name in the build target's frame is its own arm's
    var seen: u32 = 0;
    var i:    u32 = 0;
    for (i < m.ctx.entries_len) {
        if (m.ctx.entries[i].name == name_r.ok) {
            if (m.ctx.entries[i].value.data.i != 4096) { ret 8; }
            seen = seen + 1;
        }
        i = i + 1;
    }
    if (seen == 0) { ret 9; }
    val cond: aid.ExprId = ut_first_gate_cond_after(m.a, 1);
    if (cond == aid.EXPR_NIL)                                                             { ret 10; }
    if (comptime.gate_state(?m.ctx, cond) != comptime.GATE_STATE_TRUE)                    { ret 11; }
    if (comptime.gate_state(?m.tuple_frames[native], cond) != comptime.GATE_STATE_TRUE)   { ret 12; }
    if (comptime.gate_state(?m.tuple_frames[foreign], cond) != comptime.GATE_STATE_FALSE) { ret 13; }
    ret 0;
}

fun ut_first_gate_cond_after(a: *ast.Ast, skip: u32) aid.ExprId {
    if (a == nil) { ret aid.EXPR_NIL; }
    val m_opt: opt[*amodule.Module] = ast.get_module(a, a.root_module);
    if (sel m_opt.none) { ret aid.EXPR_NIL; }
    var seen: u32 = 0;
    var i:    u32 = 0;
    for (i < m_opt.some.decls_len) {
        val d_opt: opt[*decl.Decl] = ast.get_decl(a, a.decl_ids[m_opt.some.decls_start + i]);
        if (sel d_opt.some) {
            val d: *decl.Decl = d_opt.some;
            if (d.kind == decl.DECL_KIND_COMPTIME_IF && d.data.comptime_if.branches_len > 0) {
                if (seen == skip) { ret (?a.comptime_branches[d.data.comptime_if.branches_start]).cond; }
                seen = seen + 1;
            }
        }
        i = i + 1;
    }
    ret aid.EXPR_NIL;
}

test an_unresolved_name_in_one_tuple_is_reported_once {
    # a name only one tuple's arm references is not reported at all, as before the gate query; one every
    # target references is reported once, however many tuples resolve it
    if (ut_count_named_diag("$if ($mach.build.os == FOREIGN_OS) { fun only_foreign() i32 { ret no_such(); } }\nfun main() i32 { ret 0; }\n", false) != 0)                                             { ret 1; }
    if (ut_count_named_diag("$if ($mach.build.os == FOREIGN_OS) { fun picked() i32 { ret no_such(); } } $or { fun picked() i32 { ret no_such(); } }\nfun main() i32 { ret picked(); }\n", true) != 0) { ret 2; }
    ret 0;
}

fun ut_count_named_diag(text: str, want_one: bool) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var names:  [1]str              = [1]str{"main.mach"};
    var texts:  [1]str              = [1]str{text};
    var s:      session.Session;
    val root_r: res[str, fail.Fail] = ut_gate_session(?alloc, ?names[0], ?texts[0], 1, ?s);
    if (sel root_r.err) { ret 2; }
    val root: str = root_r.ok;
    fin {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
    }
    var round: i32 = 0;
    for (round < 2) {
        val built: res[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
        if (sel built.ok) {
            var p: project.Project = built.ok;
            project.dnit_project(?p);
        }
        var seen: u32 = 0;
        var i:    u32 = 0;
        for (i < diagnostic.len(?s.diags)) {
            if (str_contains(s.diags.items.data[i].message, "no_such")) { seen = seen + 1; }
            i = i + 1;
        }
        if (want_one && seen != 1)  { ret 10 + round * 10 + seen::i32; }
        if (!want_one && seen != 0) { ret 30 + round * 10 + seen::i32; }
        round = round + 1;
    }
    ret 0;
}
