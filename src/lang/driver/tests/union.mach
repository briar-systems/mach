test union_malformed_condition_reported_once {
    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "$if (5) { use uniontest.a; }\n\nfun main() i32 { ret 0; }\n";

    var a1:     A.Allocator;
    val make_r: err[A.Error] = page.make(?a1);
    if (sel make_r.err) { ret 1; }
    val sr1: res[session.Session, fail.Fail] = session.init(?a1);
    if (sel sr1.err) { ret 1; }
    var s1:      session.Session     = sr1.ok;
    val root1_r: res[str, fail.Fail] = ut_scaffold(?a1, ?names[0], ?texts[0], 1);
    if (sel root1_r.err) {
        session.dnit(?s1);
        ret 1;
    }
    val root1: str               = root1_r.ok;
    val rr1:   err[outcome.Fail] = driver.setup_registry(s1.registry);
    if (sel rr1.err) {
        fs.remove_all(?a1, root1);
        session.dnit(?s1);
        ret 1;
    }
    var pick: manifest.Selection;
    pick.target       = "";
    pick.profile      = "";
    pick.artifact     = "";
    pick.want_lib     = false;
    pick.has_artifact = false;
    val p1r: res[project.Project, outcome.Fail] = driver.build_project_sel(?s1, root1, ?pick);
    fs.remove_all(?a1, root1);
    if (sel p1r.err) {
        session.dnit(?s1);
        ret 1;
    }
    var p1:          project.Project = p1r.ok;
    val single_errs: u32             = ut_count_errors(?s1.diags);

    var a2:      A.Allocator;
    val make_r2: err[A.Error] = page.make(?a2);
    if (sel make_r2.err) {
        project.dnit_project(?p1);
        session.dnit(?s1);
        ret 1;
    }
    val sr2: res[session.Session, fail.Fail] = session.init(?a2);
    if (sel sr2.err) {
        project.dnit_project(?p1);
        session.dnit(?s1);
        ret 1;
    }
    var s2:  session.Session                    = sr2.ok;
    val p2r: res[project.Project, outcome.Fail] = ut_build(?s2, ?a2, ?names[0], ?texts[0], 1);
    if (sel p2r.err) {
        project.dnit_project(?p1);
        session.dnit(?s1);
        session.dnit(?s2);
        ret 1;
    }
    var p2:         project.Project = p2r.ok;
    val union_errs: u32             = ut_count_errors(?s2.diags);

    var bad: i32 = 0;
    if (single_errs == 0)          { bad = 1; }
    or (union_errs != single_errs) { bad = 1; }

    project.dnit_project(?p1);
    project.dnit_project(?p2);
    session.dnit(?s1);
    session.dnit(?s2);
    ret bad;
}

