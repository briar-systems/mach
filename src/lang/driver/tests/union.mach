    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

test union_gated_walk_does_not_taint_freshly_loaded_dependency {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:     session.Session = sr.ok;
    var names: [2]str;
    names[0] = "main.mach";
    names[1] = "dep.mach";
    var texts: [2]str;
    texts[0] = "$if ($mach.build.os == NATIVE_OS) { use uniontest.dep.X;\n$if (X) { $error(\"XTRUE\"); } $or { $error(\"XFALSE\"); } }\nfun main() i32 { ret 0; }\n";
    texts[1] = "pub val X: u8 = 1;\n";
    val text0_r: res[str, fail.Fail] = ut_union_native_text(?alloc, texts[0]);
    if (sel text0_r.err) {
        session.dnit(?s);
        ret 1;
    }
    texts[0] = text0_r.ok;
    fin { str_free(?alloc, texts[0]); }
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 2);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;
    fin { str_free(?alloc, root); }
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    val pr: res[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
    fs.remove_all(?alloc, root);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p:   project.Project   = pr.ok;
    var bad: i32               = 0;
    val se:  err[outcome.Fail] = driver.run_sema_pass(?p);
    if (!(sel se.err && outcome.is_reported(se.err)))                                      { bad = 1; }
    if (ut_diag_has(?p.s.diags, "tuple-dependent public constants are not yet supported")) { bad = 1; }
    if (!ut_diag_has(?p.s.diags, "XTRUE"))                                                 { bad = 1; }
    if (ut_diag_has(?p.s.diags, "XFALSE"))                                                 { bad = 1; }
    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

