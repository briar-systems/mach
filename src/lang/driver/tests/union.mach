test union_ctx_restored_to_default_tuple {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [3]str;
    names[0] = "main.mach";
    names[1] = "a.mach";
    names[2] = "b.mach";
    var texts: [3]str;
    texts[0] = "$if ($mach.build.os == $mach.os.linux) { use uniontest.a; }\n$or ($mach.build.os == $mach.os.windows) { use uniontest.b; }\nval BAD: u16 = 1;\n$if (BAD) { }\nfun main() i32 { ret 0; }\n";
    texts[1] = "pub fun fa() i32 { ret 1; }\n";
    texts[2] = "pub fun fb() i32 { ret 2; }\n";

    val pr: res[project.Project, outcome.Fail] = ut_build(?s, ?alloc, ?names[0], ?texts[0], 3);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    val cm: *comptime.ComptimeCtx = ut_ctx(?p, ?s, "uniontest.main");
    val ca: *comptime.ComptimeCtx = ut_ctx(?p, ?s, "uniontest.a");
    val cb: *comptime.ComptimeCtx = ut_ctx(?p, ?s, "uniontest.b");

    var bad: i32 = 0;
    if (cm == nil || ca == nil || cb == nil)                    { bad = 1; }
    or (cm.env.target_os_id != ca.env.target_os_id)             { bad = 2; }
    or (cm.env.target_os_id != cb.env.target_os_id)             { bad = 3; }
    or (cm.env.target_arch_id != ca.env.target_arch_id)         { bad = 4; }
    or (cm.env.target_arch_id != cb.env.target_arch_id)         { bad = 5; }
    or (cm.env.target_abi_id != ca.env.target_abi_id)           { bad = 6; }
    or (cm.env.target_abi_id != cb.env.target_abi_id)           { bad = 7; }
    or (cm.env.pointer_width != ca.env.pointer_width)           { bad = 8; }
    or (cm.env.pointer_width != cb.env.pointer_width)           { bad = 9; }
    or (cm.env.vector_bits != ca.env.vector_bits)               { bad = 10; }
    or (cm.env.vector_bits != cb.env.vector_bits)               { bad = 11; }
    or (cm.env.target_defs != ca.env.target_defs)               { bad = 12; }
    or (cm.env.target_defs != cb.env.target_defs)               { bad = 13; }
    or (cm.env.va_list_size != ca.env.va_list_size)             { bad = 14; }
    or (cm.env.va_list_size != cb.env.va_list_size)             { bad = 15; }
    or (cm.env.va_list_align != ca.env.va_list_align)           { bad = 16; }
    or (cm.env.va_list_align != cb.env.va_list_align)           { bad = 17; }
    or (cm.env.target_os_id != target.host_os_id())             { bad = 18; }
    or (cm.env.target_arch_id != target.host_arch_id())         { bad = 19; }
    or (cm.env.target_abi_id != p.target.abi_id)                { bad = 20; }
    or (cm.env.target_os != p.target_entry.os_name)             { bad = 21; }
    or (cm.env.target_isa != p.target_entry.isa_name)           { bad = 22; }
    or (cm.env.target_abi != p.target_entry.abi_name)           { bad = 23; }
    or (cm.env.target_platform != p.target_entry.platform_name) { bad = 24; }
    or (cm.env.has_float != ca.env.has_float)                   { bad = 25; }
    or (cm.env.has_float != cb.env.has_float)                   { bad = 26; }

    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

