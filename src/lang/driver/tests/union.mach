fun ut_build_multi(s: *session.Session, alloc: *A.Allocator, names: *str, texts: *str, n: u32) res[project.Project, outcome.Fail] {
    val root_r: res[str, fail.Fail] = ut_scaffold_m(alloc, ut_manifest_multi(), names, texts, n);
    if (sel root_r.err) { ret res[project.Project, outcome.Fail].err{outcome.from_fail(root_r.err)}; }
    val root: str               = root_r.ok;
    val rr:   err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.err) {
        fs.remove_all(alloc, root);
        ret res[project.Project, outcome.Fail].err{rr.err};
    }
    val pr: res[project.Project, outcome.Fail] = driver.build_project_union(s, root);
    fs.remove_all(alloc, root);
    ret pr;
}

fun ut_ctx(p: *project.Project, s: *session.Session, fqn: str) *comptime.ComptimeCtx {
    val idr: res[intern.StrId, A.Error] = intern.intern(?s.interner, fqn);
    if (sel idr.err) { ret nil; }
    var id: intern.StrId           = idr.ok;
    val mr: opt[*session.ModuleId] = map.get[intern.StrId, session.ModuleId](?p.by_fqn, ?id);
    if (sel mr.none) { ret nil; }
    val mid: session.ModuleId     = @mr.some;
    val m:   *project.ModuleEntry = project.module_at(p, mid::u32);
    ret ?m.ctx;
}

# a union analysis resolves `{artifact.<id>.out}` over every artifact some artifact
# needs: an open `shaded.mach` beside the default `hello` embeds the shader output
# `shaded` needs, and an artifact nobody needs is still refused (#3774)
test union_analysis_resolves_artifact_requirements_project_wide {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }

    val shaded: str                 = "#[embed(\"{artifact.shader-vert.out}\")]\nval VERT: [_]u8;\n\nfun main() i32 { ret VERT[0]::i32; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold_lessons(?alloc, shaded);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?alloc, root); }

    val mr: res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) { ret 1; }
    var mf: manifest.Manifest = mr.ok;
    fin { manifest.dnit(?mf, ?alloc); }

    var bad: i32 = 0;

    # the artifact root set checks shaded.mach against hello's `need`, which is empty
    val narrow: res[project.Project, outcome.Fail] = ut_analyze_lessons(?s, ?mf, root, project.ROOT_ARTIFACT);
    if (sel narrow.err) { ret 2; }
    var np: project.Project = narrow.ok;
    if (!ut_diag_has(?s.diags, "does not require")) { bad = 3; }
    project.dnit_project(?np);

    # the union resolves the template in the requirements of the artifact that needs it;
    # the only complaint left is the output no check ever writes
    val wide: res[project.Project, outcome.Fail] = ut_analyze_lessons(?s, ?mf, root, project.ROOT_UNION);
    if (sel wide.err) { ret 4; }
    var wp: project.Project = wide.ok;
    if (ut_diag_has(?s.diags, "does not require"))                 { bad = 5; }
    if (!ut_diag_has(?s.diags, "required artifact `shader-vert`")) { bad = 6; }
    if (!ut_has(?wp, ?s, "lessons.hello"))                         { bad = 7; }
    if (!ut_has(?wp, ?s, "lessons.shaded"))                        { bad = 8; }
    var vert_out: str = "";
    var ri:       u32 = 0;
    for (ri < wp.config.art_req_count) {
        if (str_equals(wp.config.art_reqs[ri].name, "shader-vert")) { vert_out = wp.config.art_reqs[ri].out; }
        ri = ri + 1;
    }
    if (str_empty(vert_out)) { bad = 9; }
    var vert_path: str = "";
    if (!str_empty(vert_out)) { vert_path = ut_cc3(?alloc, root, "/", vert_out); }
    project.dnit_project(?wp);
    if (bad != 0) { ret bad; }

    # with the shader output on disk the embed reads it and the union is clean
    val vert_dir_r: res[path.Path, A.Error] = path.parent(?alloc, vert_path);
    if (sel vert_dir_r.err) { ret 10; }
    val made: err[fs.FsError] = fs.create_dir_all(?alloc, vert_dir_r.ok, 493);
    if (sel made.err) { ret 10; }
    val bytes: str             = "spv!";
    val wrote: err[fs.FsError] = fs.write_bytes(vert_path, bytes, str_len(bytes), 420);
    if (sel wrote.err) { ret 11; }
    val clean: res[project.Project, outcome.Fail] = ut_analyze_lessons(?s, ?mf, root, project.ROOT_UNION);
    if (sel clean.err) { ret 12; }
    var cp: project.Project = clean.ok;
    if (ut_count_errors(?s.diags) != 0)                 { bad = 13; }
    if (!fail.is_accepted(passes.frontend_status(?cp))) { bad = 14; }
    project.dnit_project(?cp);
    if (bad != 0) { ret bad; }

    # `hello` is required by nobody, so no artifact's module may name its output
    val shaded_path: str            = ut_cc3(?alloc, root, "/", "src/shaded.mach");
    val overlay:     str            = "#[embed(\"{artifact.hello.out}\")]\nval HELLO: [_]u8;\n\nfun main() i32 { ret HELLO[0]::i32; }\n";
    val laid:        err[fail.Fail] = session.set_overlay(?s, shaded_path, overlay);
    if (sel laid.err) { ret 15; }
    val refused: res[project.Project, outcome.Fail] = ut_analyze_lessons(?s, ?mf, root, project.ROOT_UNION);
    if (sel refused.err) { ret 16; }
    var rp: project.Project = refused.ok;
    if (!ut_diag_has(?s.diags, "does not require")) { bad = 17; }
    project.dnit_project(?rp);
    ret bad;
}

# under the union each module reads `$bin.name` as the artifact whose entry reached it
# first: `shaded.mach` refusing any other artifact is clean in a session rooted at
# `hello`, where the artifact root set still reads `hello` for it (#3776)
test union_analysis_attributes_bin_name_to_the_reaching_artifact {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }

    val shaded: str                 = "$if ($bin.name != \"shaded\") { $error(\"wrong artifact\"); }\n\nfun main() i32 { ret 0; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold_lessons(?alloc, shaded);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?alloc, root); }

    val mr: res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) { ret 1; }
    var mf: manifest.Manifest = mr.ok;
    fin { manifest.dnit(?mf, ?alloc); }

    var bad: i32 = 0;

    # the artifact root set is one cell: every module is `hello`'s
    val narrow: res[project.Project, outcome.Fail] = ut_analyze_lessons(?s, ?mf, root, project.ROOT_ARTIFACT);
    if (sel narrow.err) { ret 2; }
    var np: project.Project = narrow.ok;
    if (!ut_diag_has(?s.diags, "wrong artifact"))                            { bad = 3; }
    if (!str_equals(ut_module_bin_name(?np, ?s, "lessons.shaded"), "hello")) { bad = 4; }
    project.dnit_project(?np);
    if (bad != 0) { ret bad; }

    # the union attributes `shaded.mach` to the artifact whose entry it is
    val wide: res[project.Project, outcome.Fail] = ut_analyze_lessons(?s, ?mf, root, project.ROOT_UNION);
    if (sel wide.err) { ret 5; }
    var wp: project.Project = wide.ok;
    if (ut_count_errors(?s.diags) != 0)                                       { bad = 6; }
    if (!fail.is_accepted(passes.frontend_status(?wp)))                       { bad = 7; }
    if (!str_equals(ut_module_bin_name(?wp, ?s, "lessons.hello"), "hello"))   { bad = 8; }
    if (!str_equals(ut_module_bin_name(?wp, ?s, "lessons.shaded"), "shaded")) { bad = 9; }
    project.dnit_project(?wp);
    ret bad;
}

fun ut_union_gate_result(src_text: str, want_diag: str, forbid_diag: str) i32 {
    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = src_text;
    ret ut_union_gate_result_n(?names[0], ?texts[0], 1, want_diag, forbid_diag);
}

test union_alias_gates_are_typed_per_target_tuple {
    val uniform:         str = "def Flag: u8;\nval C: Flag = 1;\n$if (C) { fun selected() i32 { ret 1; } } $or { use uniontest.missing; }\nfun main() i32 { ret selected(); }\n";
    val selected_u8:     str = "$if ($mach.build.os == $mach.os.linux) { def Flag: u8; } $or { def Flag: u8; }\nval C: Flag = 1;\n$if (C) { fun selected() i32 { ret 1; } } $or { use uniontest.missing; }\nfun main() i32 { ret selected(); }\n";
    val true_import:     str = "$if ($mach.build.os == $mach.os.linux) { def Flag: u8; } $or { def Flag: u16; }\nval C: Flag = 1;\n$if (C) { } $or { use uniontest.missing; }\nfun main() i32 { ret 0; }\n";
    val false_embed:     str = "$if ($mach.build.os == $mach.os.linux) { def Flag: u8; } $or { def Flag: u16; }\nval C: Flag = 0;\n$if (C) { #[embed(\"missing.bin\")] val DATA: [_]u8; }\nfun main() i32 { ret 0; }\n";
    val false_library:   str = "$if ($mach.build.os == $mach.os.linux) { def Flag: u8; } $or { def Flag: u16; }\nval C: Flag = 0;\n$if (C) { #[library(\"missing\")] ext fun probe(); }\nfun main() i32 { ret 0; }\n";
    val nested:          str = "$if ($mach.build.os == $mach.os.linux) { def Flag: u8; } $or { def Flag: u16; }\nval C: Flag = 1;\n$if ($mach.build.os == $mach.os.windows) { $if (C) { use uniontest.missing; } }\nfun main() i32 { ret 0; }\n";
    val permanent_error: str = "def Flag: u8;\nval C: Flag = 1;\n$if (C) { fun selected() i32 { ret 1; } }\nfun main() i32 { ret selected() + no_such(); }\n";
    val u0:              i32 = ut_union_gate_result(uniform, "", "");
    if (u0 != 0) { ret 10 + u0; }
    val u1: i32 = ut_union_gate_result(selected_u8, "", "");
    if (u1 != 0) { ret 20 + u1; }
    val u2: i32 = ut_union_gate_result(true_import, "condition must have type u8", "no project or dep matches");
    if (u2 != 0) { ret 30 + u2; }
    val u3: i32 = ut_union_gate_result(false_embed, "condition must have type u8", "cannot read");
    if (u3 != 0) { ret 40 + u3; }
    val u4: i32 = ut_union_gate_result(false_library, "condition must have type u8", "cannot read");
    if (u4 != 0) { ret 50 + u4; }
    val u5: i32 = ut_union_gate_result(nested, "condition must have type u8", "no project or dep matches");
    if (u5 != 0) { ret 60 + u5; }
    val u6: i32 = ut_union_gate_result(permanent_error, "unresolved identifier `no_such`", "");
    if (u6 != 0) { ret 70 + u6; }
    ret 0;
}

test unresolved_union_gate_preserves_independent_diagnostics {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:     session.Session = sr.ok;
    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "fun condition() u8 { ret 1; }\n$if (condition()) { fun selected() i32 { ret 1; } }\nfun main() i32 { ret no_such(); }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 2;
    }
    val root:             str               = root_r.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 3;
    }
    val pr: res[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
    fs.remove_all(?alloc, root);
    var bad: i32 = 0;
    if (sel pr.err) {
        bad = 4;
    }
    if (sel pr.ok) {
        var p: project.Project = pr.ok;
        if (!ut_diag_has(?p.s.diags, "function calls are not comptime-evaluable")) { bad = 5; }
        if (!ut_diag_has(?p.s.diags, "unresolved identifier `no_such`"))           { bad = 6; }
        if (diagnostic.len(?p.s.diags) != 2)                                       { bad = 7; }
        project.dnit_project(?p);
    }
    session.dnit(?s);
    ret bad;
}

# a gate reading a constant nothing binds is refused although the constant beside it binds through an import
test union_gate_reading_an_unbound_constant_is_refused_beside_a_bound_import {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:     session.Session = sr.ok;
    var names: [2]str;
    names[0] = "main.mach";
    names[1] = "dep.mach";
    var texts: [2]str;
    texts[0] = "use uniontest.dep.K;\npub val UNSTUCK: u8 = K;\npub val A: u8 = totally_undefined;\n$if (A) { fun helper() i32 { ret 1; } }\nfun main() i32 { ret 0; }\n";
    texts[1] = "pub val K: u8 = 1;\n";
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 2);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root:             str               = root_r.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    val pr: res[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
    fs.remove_all(?alloc, root);
    var bad: i32 = 0;
    if (sel pr.ok) {
        var p:        project.Project  = pr.ok;
        val standing: fail.PhaseStatus = driver.frontend_status(?p);
        if (sel standing.kind.accepted) { bad = 1; }
        project.dnit_project(?p);
    }
    if (sel pr.err) {
        val f: outcome.Fail = pr.err;
        if (!sel f.reported) { bad = 1; }
    }
    if (!ut_diag_has(?s.diags, "is never decided: `A`")) { bad = 2; }
    session.dnit(?s);
    ret bad;
}

test union_tuple_dependent_dependency_const_fails_closed {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:     session.Session = sr.ok;
    var names: [2]str;
    names[0] = "main.mach";
    names[1] = "dep.mach";
    var texts: [2]str;
    texts[0] = "use uniontest.dep.X;\n$if (X) { $error(\"XTRUE\"); } $or { $error(\"XFALSE\"); }\nfun main() i32 { ret 0; }\n";
    texts[1] = "$if ($mach.build.os == $mach.os.linux) { pub val X: u8 = 1; } $or { pub val X: u8 = 0; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 2);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root:             str               = root_r.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    val pr: res[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
    fs.remove_all(?alloc, root);
    var bad: i32 = 0;
    if (sel pr.err) {
        val f: outcome.Fail = pr.err;
        if (outcome.describe(f) == nil || !ut_str_contains(outcome.describe(f), "tuple-dependent public constants are not yet supported")) { bad = 1; }
        session.dnit(?s);
        ret bad;
    }
    var p:  project.Project   = pr.ok;
    val se: err[outcome.Fail] = driver.run_sema_pass(?p);
    if (!(sel se.err && outcome.is_reported(se.err)))                                             { bad = 1; }
    if (ut_diag_count(?p.s.diags, "tuple-dependent public constants are not yet supported") != 1) { bad = 1; }
    if (ut_diag_has(?p.s.diags, "XTRUE"))                                                         { bad = 1; }
    if (ut_diag_has(?p.s.diags, "XFALSE"))                                                        { bad = 1; }
    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

