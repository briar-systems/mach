use mach.lang.driver.tests.testing.ut_tag_start_stub;
use mach.lang.module;
use mach.lang.toolchain;

test comptime_arm__does_not_mask_a_cross_module_import_conflict {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [3]str;
    names[0] = "main.mach";
    names[1] = "a.mach";
    names[2] = "b.mach";
    var texts: [3]str;
    texts[0] = "use uniontest.a;\nuse uniontest.b;\nfun main() i32 { a.call(); b.call(); ret 0; }\n";
    texts[1] = "$if ($mach.build.os == $mach.os.windows) {\n    #[library(\"kernel32\")]\n    ext fun cx_probe();\n}\n$or {\n    #[library(\"kernel32\")]\n    ext fun cx_probe();\n}\n\npub fun call() { cx_probe(); }\n";
    texts[2] = "#[library(\"user32\")]\next fun cx_probe();\npub fun call() { cx_probe(); }\n";

    var bad: i32                 = 0;
    val pr:  res[str, fail.Fail] = ut_attr_probe(?s, ?alloc, ?names[0], ?texts[0], 3, "windows", "cx_probe");
    if (sel pr.ok) { bad = 1; }
    if (sel pr.err) {
        val msg: str = fail.describe(pr.err);
        if (!ut_str_contains(msg, "import 'cx_probe'")) { bad = 1; }
        if (!ut_str_contains(msg, "'kernel32'"))        { bad = 1; }
        if (!ut_str_contains(msg, "'user32'"))          { bad = 1; }
        if (!ut_str_contains(msg, "uniontest.a"))       { bad = 1; }
        if (!ut_str_contains(msg, "uniontest.b"))       { bad = 1; }
    }

    session.dnit(?s);
    ret bad;
}

# a `$each` over a constant array reads each element from the array's published value, alike for
# an array the module imports, one of its own and one local to a body: record and nested fields,
# a field the literal leaves out, a string, a case payload under a folded `sel`, a whole record
# and a function-pointer field, which the value holds no compile-time value for and the array
# itself is read for
test each__reads_imported_own_and_local_arrays_alike {
    $if ($mach.build.os != $mach.os.linux || $mach.build.arch != $mach.arch.x86_64) { ret 0; }
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var names:   [1]str = [1]str{"src/a.mach"};
    var texts:   [1]str = [1]str{"pub tag Reply: u8 { empty; value: i64; }\npub rec P { x: i64; y: i64; }\npub rec Q { p: P; name: *u8; }\npub rec Rule { tag: i64; fn: fun(i64) i64; }\npub fun inc(n: i64) i64 { ret n + 1; }\npub fun dbl(n: i64) i64 { ret n * 2; }\npub val PS: [2]P = [2]P{P{x: 1, y: 2}, P{x: 30, y: 4}};\npub val QS: [2]Q = [2]Q{Q{p: P{x: 5, y: 6}, name: \"ab\"}, Q{p: P{x: 7}, name: \"cde\"}};\npub val TS: [2]Reply = [2]Reply{Reply.value{100}, Reply.empty{}};\npub val RULES: [2]Rule = [2]Rule{Rule{tag: 1, fn: inc}, Rule{tag: 2, fn: dbl}};\n"};
    val program: str    = ut_cc3(?alloc, "use divtrap.a;\nval PS: [2]a.P = [2]a.P{a.P{x: 1, y: 2}, a.P{x: 30, y: 4}};\nval QS: [2]a.Q = [2]a.Q{a.Q{p: a.P{x: 5, y: 6}, name: \"ab\"}, a.Q{p: a.P{x: 7}, name: \"cde\"}};\nval TS: [2]a.Reply = [2]a.Reply{a.Reply.value{100}, a.Reply.empty{}};\nval RULES: [2]a.Rule = [2]a.Rule{a.Rule{tag: 1, fn: a.inc}, a.Rule{tag: 2, fn: a.dbl}};\n\n#[noinline] fun take(p: a.P) i64 { ret p.x * 10 + p.y; }\n#[noinline] fun local($n: i64) i64 { val L: [2]a.P = [2]a.P{a.P{x: n, y: 1}, a.P{x: 2}}; var s: i64 = 0; $each p in L { s = s + take(p); } ret s; }\n\n#[symbol(\"main\")]\nfun main(argc: i64) i64 {\n    var s: i64 = 0;\n    $each p in a.PS { s = s + take(p); $if (p.x == 30) { s = s + 1000; } }\n    $each p in PS { s = s - take(p); $if (p.x == 30) { s = s - 1000; } }\n    if (s != 0) { ret 1; }\n    $each q in a.QS { s = s + q.p.x * 100 + q.p.y + q.name[1]::i64; }\n    $each q in QS { s = s - q.p.x * 100 - q.p.y - q.name[1]::i64; }\n    if (s != 0) { ret 2; }\n    $each t in a.TS { $if (sel t.value) { s = s + t.value; } $or { s = s + 1; } }\n    $each t in TS { if (sel t.value) { s = s - t.value; } or { s = s - 1; } }\n    if (s != 0) { ret 3; }\n    $each r in a.RULES { s = s + r.fn(10) + r.tag; }\n    $each r in RULES { s = s - r.fn(10) - r.tag; }\n    if (s != 0) { ret 4; }\n    if (local(5) != 71 || local(6) != 81) { ret 5; }\n    ret 0;\n}\n", "\n", ut_tag_start_stub());
    var release: bool   = false;
    var pass:    u32    = 0;
    for (pass < 2) {
        if (ut_tag_native_case_files(?alloc, ut_divide_manifest(), ?names[0], ?texts[0], 1, "linux-x86_64", "", release, program, "each arrays") != 0) { ret 2; }
        release = true;
        pass    = pass + 1;
    }
    ret 0;
}
