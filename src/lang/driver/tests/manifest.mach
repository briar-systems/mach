fun ut_manifest_notargets() str {
    ret "[project]\nmach = \">=5\"\nid = \"uniontest\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out\"\n\n[artifact.uniontest]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/uniontest\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n";
}

test "mach.lang.driver:empty_target_table_synthesizes_native" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "#[symbol(\"_start\")]\nfun start() i32 { ret 0; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold_m(?alloc, ut_manifest_notargets(), ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    var bad: i32                                = 0;
    val pr:  res[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
    if (sel pr.ok) {
        var p: project.Project = pr.ok;
        project.dnit_project(?p);
    }
    if (sel pr.err) {
        bad = 1;
    }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

# `$project.name` and `$project.description` are refused at their use site as
# unknown paths, the same as any other wrong path
test "mach.lang.driver:project_name_and_description_paths_are_refused_as_unknown" {
    if (!ut_sema_rejects_with("val n: *u8 = $project.name;\nfun main() i32 { ret 0; }\n",
        "unknown `$project.*` path")) { ret 1; }
    if (!ut_sema_rejects_with("val d: *u8 = $project.description;\nfun main() i32 { ret 0; }\n",
        "unknown `$project.*` path")) { ret 2; }
    if (!ut_sema_rejects_with("val d: *u8 = $project.bogus;\nfun main() i32 { ret 0; }\n",
        "unknown `$project.*` path")) { ret 3; }
    if (!ut_sema_clean("val i: *u8 = $project.id;\nval v: *u8 = $project.version;\nfun main() i32 { ret 0; }\n")) { ret 4; }
    ret 0;
}

fun ut_manifest_overlay_src() str {
    ret "[project]\nmach = \">=5\"\nid = \"ctxcase\"\nversion = \"1.2.3\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.windows]\nisa = \"x86_64\"\nos = \"windows\"\nabi = \"win64\"\n\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n\n[artifact.beta]\nkind = \"bin\"\nentry = \"beta.mach\"\nout = \"bin/beta\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
}

test "mach.lang.driver:an_overlay_is_found_through_the_manifest_src" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "beta.mach";
    var texts: [1]str;
    texts[0] = "fun main() i32 { ret no_such_symbol(); }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold_m(?alloc, ut_manifest_overlay_src(), ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 2;
    }
    val root: str = root_r.ok;

    val ov_path: str            = ut_cc3(?alloc, root, "/src/", "beta.mach");
    val osr:     err[fail.Fail] = session.set_overlay(?s, ov_path, "fun main() i32 { ret 0; }\n");
    if (sel osr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 3;
    }

    var bad: i32                                  = 0;
    val mr:  res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) { bad = 4; }
    if (sel mr.ok) {
        var mf:  manifest.Manifest    = mr.ok;
        var req: request.BuildRequest = request.defaults();
        req.project_root = root;
        req.target       = "windows";
        req.profile      = "release";
        req.artifact     = "beta";
        req.goal         = request.GOAL_OBJECTS;
        req.opt          = pipeline.OPT_RELEASE;

        val pr: res[project.Project, outcome.Fail] = driver.analyze_project(?s, ?mf, ?req, project.ROOT_ARTIFACT, nil, 0);
        if (sel pr.err) { bad = 5; }
        if (sel pr.ok) {
            var p: project.Project = pr.ok;
            if (ut_count_errors(?p.s.diags) != 0) { bad = 6; }
            project.dnit_project(?p);
        }
        manifest.dnit(?mf, ?alloc);
    }

    session.dnit(?s);
    fs.remove_all(?alloc, root);
    ret bad;
}

fun ut_manifest_stack_elf() str {
    ret "[project]\nmach = \">=5\"\nid = \"stk\"\nversion = \"0.1.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.win]\nisa = \"x86_64\"\nos = \"windows\"\nabi = \"win64\"\nstack_reserve = 8388608\n\n[target.lin]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\nstack_reserve = 8388608\n\n[profile.debug]\nopt = 0\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n\n[artifact.stk]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/stk\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
}

fun ut_manifest_stack_pe() str {
    ret "[project]\nmach = \">=5\"\nid = \"stk\"\nversion = \"0.1.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.win]\nisa = \"x86_64\"\nos = \"windows\"\nabi = \"win64\"\nstack_reserve = 8388608\nstack_commit = 8192\n\n[profile.debug]\nopt = 0\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n\n[artifact.stk]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/stk.exe\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
}

test "mach.lang.driver:a_stack_key_on_a_format_without_one_is_refused_at_load" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "fun main() i32 { ret 0; }\n";

    var bad: i32 = 0;

    val bad_root_r: res[str, fail.Fail] = ut_scaffold_m(?alloc, ut_manifest_stack_elf(), ?names[0], ?texts[0], 1);
    if (sel bad_root_r.err) {
        session.dnit(?s);
        ret 2;
    }
    val bad_root: str = bad_root_r.ok;

    val br: res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, bad_root);
    if (sel br.ok) {
        var m: manifest.Manifest = br.ok;
        manifest.dnit(?m, ?alloc);
        bad = 3;
    }
    if (sel br.err) {
        val msg: str = outcome.describe(br.err);
        if (!str_contains(msg, "stack_reserve") && bad == 0) { bad = 4; }
        if (!str_contains(msg, "lin") && bad == 0)           { bad = 5; }
        if (!str_contains(msg, "elf") && bad == 0)           { bad = 6; }
    }
    fs.remove_all(?alloc, bad_root);

    if (bad == 0) {
        val ok_root_r: res[str, fail.Fail] = ut_scaffold_m(?alloc, ut_manifest_stack_pe(), ?names[0], ?texts[0], 1);
        if (sel ok_root_r.err) {
            session.dnit(?s);
            ret 7;
        }
        val ok_root: str = ok_root_r.ok;

        val orr: res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, ok_root);
        if (sel orr.err) { bad = 8; }
        if (sel orr.ok) {
            var m2: manifest.Manifest = orr.ok;
            if (m2.target_count != 1)                   { bad = 9; }
            or (m2.targets[0].stack_reserve != 8388608) { bad = 10; }
            or (m2.targets[0].stack_commit != 8192)     { bad = 11; }
            manifest.dnit(?m2, ?alloc);
        }
        fs.remove_all(?alloc, ok_root);
    }

    session.dnit(?s);
    ret bad;
}

test "mach.lang.driver:a_manifest_stack_reserve_reaches_the_linked_pe" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "#[symbol(\"mainCRTStartup\")]\nfun main() i32 { ret 0; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold_m(?alloc, ut_manifest_stack_pe(), ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 2;
    }
    val root: str = root_r.ok;

    var bad: i32               = 0;
    val rr:  err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.err) { bad = 3; }
    if (sel rr.ok) {
        var tsel_18542: manifest.Selection                 = ut_target_sel("win");
        val pr:         res[project.Project, outcome.Fail] = driver.build_project(?s, root, ?tsel_18542);
        if (sel pr.err) { bad = 4; }
        if (sel pr.ok) {
            var p: project.Project = pr.ok;
            if (ut_run_codegen_ok(?p) != 0) { bad = 5; }
            or {
                if (p.target.stack_reserve != 8388608) { bad = 6; }
                or (p.target.stack_commit != 8192)     { bad = 7; }
                or {
                    var outcome_r: u64 = 0;
                    var com:       u64 = 0;
                    if (!ut_pe_stack_of(?p, ?outcome_r, ?com)) { bad = 8; }
                    or (outcome_r != 8388608)                  { bad = 9; }
                    or (com != 8192)                           { bad = 10; }
                }
            }
            project.dnit_project(?p);
        }
    }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

fun ut_pe_stack_of(p: *project.Project, outcome_r: *u64, com: *u64) bool {
    val alloc: *A.Allocator = p.alloc;
    if (p.emit_len == 0) { ret false; }

    val ir: res[*of.ObjectImage, A.Error] = A.allocate[of.ObjectImage](alloc, p.emit_len::usize);
    if (sel ir.err) { ret false; }
    val images:  *of.ObjectImage = ir.ok;
    var missing: bool            = false;
    var i:       u32             = 0;
    for (i < p.emit_len) {
        val m: *project.ModuleEntry = project.module_at(p, (p.topo[i])::u32);
        if (m.object_image == nil) { missing = true; }
        or                         { images[i] = @m.object_image; }
        i = i + 1;
    }

    val tf_r: res[fixture.Output, outcome.Fail] = fixture.create(alloc, "stk_pe");
    if (sel tf_r.err) {
        A.deallocate[of.ObjectImage](alloc, images, p.emit_len::usize);
        ret false;
    }
    var tf: fixture.Output = tf_r.ok;
    fin { fixture.dnit(?tf); }

    var linked: bool = false;
    if (!missing) {
        val lr: err[fail.Fail] = ut_planned_link_images(p.s, ?p.target, images,
            p.emit_len, nil::*of.DynLib, 0, fixture.path(?tf)::*u8, "stkprobe"::*u8,
            linker.LINK_EXE, false, of.image_options_default(of.SUBSYSTEM_CONSOLE));
        linked = sel lr.ok;
    }
    A.deallocate[of.ObjectImage](alloc, images, p.emit_len::usize);
    if (!linked) { ret false; }

    val rb: res[Vector[u8], fs.FsError] = fs.read_bytes(alloc, fixture.path(?tf));

    if (sel rb.err) { ret false; }
    val img: Vector[u8] = rb.ok;

    var ok: bool = false;
    if (img.len > 0x100) {
        val pe_off: usize = bin.read_u32_le(img.data, 0x3C)::usize;
        val oh:     usize = pe_off + 24;
        if (oh + 96 + 8 <= img.len) {
            @outcome_r = bin.read_u64_le(img.data, oh + 72);
            @com       = bin.read_u64_le(img.data, oh + 80);
            ok         = true;
        }
    }
    ret ok;
}

# an unknown manifest key is refused for the root and for a dependency, each
# diagnostic naming the key and the table
test "mach.lang.driver:unknown_manifest_keys_are_refused_for_the_root_and_each_dependency" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }

    val origin: str = "https://example.invalid/old.git";
    var names:  [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "fun main() i32 { ret 0; }\n";
    val clean_head:    str                 = "[project]\nmach = \">=5\"\nid = \"app\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.linux]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[profile.debug]\nopt = 0\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n";
    val root_tail:     str                 = "\n[artifact.app]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/app\"\ntargets = [\"*\"]\nlink = []\nneed = []\n\n[dep.old]\ngit = \"https://example.invalid/old.git\"\nref = \"branch/main\"\n";
    val root_manifest: str                 = ut_cc3(?alloc, clean_head, "emit_ir = true\n", root_tail);
    val root_r:        res[str, fail.Fail] = ut_scaffold_m(?alloc, root_manifest, ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root:            str            = root_r.ok;
    val dep_root:        str            = ut_cc3(?alloc, root, "/", "dep/old");
    val dep_manifest:    str            = "[project]\nmach = \">=5\"\nid = \"old\"\ndescription = \"an old library\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[artifact.lib]\nkind = \"static\"\nentry = \"lib.mach\"\nout = \"lib/l\"\ntargets = [\"*\"]\nlink = []\nneed = []\ndefault = true\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n";
    val ut_write_node_r: err[fail.Fail] = ut_write_node(?alloc, dep_root, dep_manifest, "lib.mach", "pub fun v() i32 { ret 1; }\n");
    if (sel ut_write_node_r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    if (!ut_git_repo(?alloc, dep_root, origin)) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    if (!ut_write_gitmodules(?alloc, root, "old", origin)) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    if (!ut_git_repo(?alloc, root, "https://example.invalid/app.git")) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }

    var bad: i32                                = 0;
    val pr:  res[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
    if (sel pr.ok) {
        var p: project.Project = pr.ok;
        project.dnit_project(?p);
        bad = 2;
    }
    if (sel pr.err) {
        if (!ut_str_contains(outcome.describe(pr.err), "mach.toml: unknown key 'emit_ir' in [profile.debug]")) { bad = 3; }
    }

    # with the root clean, the dependency's unknown key is refused under its name
    if (bad == 0) {
        val fixed: str             = ut_cc3(?alloc, clean_head, "", root_tail);
        val mpath: str             = ut_cc3(?alloc, root, "/", "mach.toml");
        val wr:    err[fs.FsError] = fs.write_bytes(mpath, fixed, str_len(fixed), 420);
        if (sel wr.err) { bad = 4; }
        or {
            val pr2: res[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
            if (sel pr2.ok) {
                var p2: project.Project = pr2.ok;
                project.dnit_project(?p2);
                bad = 5;
            }
            if (sel pr2.err) {
                if (!ut_str_contains(outcome.describe(pr2.err), "dep 'old': mach.toml: unknown key 'description' in [project]")) { bad = 6; }
            }
        }
    }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}
