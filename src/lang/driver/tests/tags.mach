}

fun ut_l8_trap_target(alloc: *A.Allocator, target_name: str, runner_name: str, release: bool) i32 {
    var runner: str = "";
    if (!str_empty(runner_name)) {
        val rr: res[str, exec.Error] = exec.resolve(alloc, runner_name);
        if (sel rr.err) {
            print.print("tag-trap: runner absent, arm skipped: ");
            print.print(runner_name);
            print.print("\n");
            ret 0;
        }
        runner = rr.ok;
    }
    val sr: res[session.Session, fail.Fail] = session.init(alloc);
    if (sel sr.err) { ret 1; }
    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = ut_cc3(alloc, ut_l8_trap_program(), "\n", ut_tag_start_stub());
    val root_r: res[str, fail.Fail] = ut_scaffold_m(alloc, ut_divide_manifest(), ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    var bad: i32                                  = 0;
    val mr:  res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) {
        fs.remove_all(alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var m:  manifest.Manifest    = mr.ok;
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    rq.target       = target_name;
    if (release) {
        rq.profile = "release";
        rq.opt     = pipeline.OPT_RELEASE;
    }
    val pr: res[bplan.BuildPlan, outcome.Fail] = bplan.plan(alloc, ?s.interner, s.registry, ?m, rq);
    if (sel pr.err) {
        fs.remove_all(alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var bp: bplan.BuildPlan                         = pr.ok;
    val br: res[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, alloc, nil);
    if (sel br.err) { bad = 1; }
    if (sel br.ok) {
        val bo: outcome.BuildOutcome = br.ok;
        if (bo.severity != outcome.BUILD_OK || bo.artifacts.len != 1) { bad = 1; }
        or {
            val program: str = bo.artifacts.data[0].path;
            # release reads through: argc 2 lands the write on the payload, every other access sees 42
            var release_exit: [8]i32 = [8]i32{42, 7, 42, 42, 42, 42, 42, 42};
            var argc:         usize  = 1;
            for (argc <= 8) {
                var trapped: bool = false;
                var code:    i32  = 0;
                if (!ut_run_with_argc(root, runner, program, argc, ?trapped, ?code)) { bad = 2; }
                or (release || argc == 8) {
                    if (trapped || code != release_exit[argc - 1]) { bad = 3; }
                }
                or (!trapped) { bad = 4; }
                if (bad != 0) {
                    print.print("tag-trap: unexpected outcome on ");
                    print.print(target_name);
                    print.printf(" (argc {}, step {}, trapped {}, exit {})\n", argc, bad, trapped::u8, code);
                    brk;
                }
                argc = argc + 1;
            }
        }
    }
    val remove_all_r: err[fs.FsError] = fs.remove_all(alloc, root);
    if (sel remove_all_r.err) { bad = 5; }
    session.dnit(?s);
    ret bad;
}

test "mach.lang.driver:tag_debug_trap_fires_for_every_guarded_access_kind_on_every_native_backend" {
    $if ($mach.build.os != $mach.os.linux || $mach.build.arch != $mach.arch.x86_64) { ret 0; }
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var release: bool = false;
    var pass:    u32  = 0;
    for (pass < 2) {
        if (ut_l8_trap_target(?alloc, "linux-x86_64", "", release) != 0)              { ret 2; }
        if (ut_l8_trap_target(?alloc, "linux-arm64", "qemu-aarch64", release) != 0)   { ret 3; }
        if (ut_l8_trap_target(?alloc, "linux-riscv64", "qemu-riscv64", release) != 0) { ret 4; }
        release = true;
        pass    = pass + 1;
    }
    ret 0;
}

val TAG_CORPUS_LEN: usize = 187;

# a generic instantiated over a user-declared res reaches the mangler with a real owner module
fun ut_generic_over_user_res_program() str {
    ret "tag res[T, E]: u8 { err: E; ok: T; }\nrec Vector[T] { items: [4]T; len: u64; }\n#[noinline] fun push[T](v: *Vector[T], x: T) { (@v).items[(@v).len] = x; (@v).len = (@v).len + 1; }\n#[noinline] fun at[T](v: *Vector[T], i: u64) T { ret (@v).items[i]; }\n#[noinline] fun sum(v: *Vector[res[i32, u8]]) i64 { var t: i64 = 0; var i: u64 = 0; for (i < (@v).len) { val e: res[i32, u8] = at[res[i32, u8]](v, i); if (sel e.ok) { t = t + e.ok::i64; } or (sel e.err) { t = t - e.err::i64; } i = i + 1; } ret t; }\n#[symbol(\"main\")]\nfun main(argc: i64) i64 {\n    var v: Vector[res[i32, u8]];\n    push[res[i32, u8]](?v, res[i32, u8].ok{7});\n    push[res[i32, u8]](?v, res[i32, u8].err{3});\n    if (v.len != 2 || $size_of(Vector[res[i32, u8]]) != 40) { ret 1; }\n    val a: res[i32, u8] = at[res[i32, u8]](?v, 0);\n    if (sel a.ok) { if (a.ok != 7) { ret 2; } } or { ret 2; }\n    val b: res[i32, u8] = at[res[i32, u8]](?v, 1);\n    if (sel b.err) { if (b.err != 3) { ret 3; } } or { ret 3; }\n    if (sum(?v) != 4) { ret 4; }\n    ret 0;\n}\n";
}

test "mach.lang.driver:a_generic_instantiated_over_a_user_declared_res_builds_and_runs" {
    $if ($mach.build.os != $mach.os.linux || $mach.build.arch != $mach.arch.x86_64) { ret 0; }
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err)                                                                                                            { ret 1; }
    if (ut_tag_native_case(?alloc, "linux-x86_64", "", false, ut_generic_over_user_res_program(), "generic over a user res") != 0) { ret 2; }
    if (ut_tag_native_case(?alloc, "linux-x86_64", "", true, ut_generic_over_user_res_program(), "generic over a user res") != 0)  { ret 3; }
    ret 0;
}
