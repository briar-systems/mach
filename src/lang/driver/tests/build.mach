test build_steps_repeat_cache_hit_skips_reexecution {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:  session.Session   = sr.ok;
    val rr: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "fun main() i32 { ret 0; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold_m(?alloc, ut_manifest_step_repeat(), ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    var pick: manifest.Selection;
    pick.target       = "linux";
    pick.profile      = "";
    pick.artifact     = "app";
    pick.want_lib     = false;
    pick.has_artifact = true;
    var bad:     bool                               = false;
    val first_r: res[project.Project, outcome.Fail] = driver.build_project_sel(?s, root, ?pick);
    if (sel first_r.err) { bad = true; }
    if (sel first_r.ok) {
        var first: project.Project = first_r.ok;
        project.dnit_project(?first);
    }
    val second_r: res[project.Project, outcome.Fail] = driver.build_project_sel(?s, root, ?pick);
    if (sel second_r.err) { bad = true; }
    if (sel second_r.ok) {
        var second: project.Project = second_r.ok;
        project.dnit_project(?second);
    }

    val counter_r: res[str, A.Error] = path.resolve(?alloc, root, "counter");
    if (sel counter_r.err) { bad = true; }
    if (sel counter_r.ok) {
        val counter: str                  = counter_r.ok;
        val text_r:  res[str, fs.FsError] = fs.read_string(?alloc, counter);
        if (sel text_r.err) { bad = true; }
        if (sel text_r.ok) {
            if (!str_equals(text_r.ok, "1")) { bad = true; }
        }
    }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    if (bad) { ret 1; }
    ret 0;
}

test build_steps_repeat_no_cache_reexecutes_a_stamped_step {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) { ret 1; }

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "fun main() i32 { ret 0; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold_m(?alloc, ut_manifest_step_repeat(), ?names[0], ?texts[0], 1);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?alloc, root); }
    val counter_r: res[str, A.Error] = path.resolve(?alloc, root, "counter");
    if (sel counter_r.err) { ret 2; }
    val counter: str = counter_r.ok;
    fin { str_free(?alloc, counter); }

    var pick: manifest.Selection;
    pick.target       = "linux";
    pick.profile      = "";
    pick.artifact     = "app";
    pick.want_lib     = false;
    pick.has_artifact = true;
    var round: u32 = 0;
    for (round < 3) {
        var req: request.BuildRequest = request.defaults();
        req.project_root = root;
        req.no_cache     = round == 1;
        val built: res[project.Project, outcome.Fail] = driver.build_project_sel_req(?s, root, ?pick, ?req);
        if (sel built.err) { ret 3; }
        var p: project.Project = built.ok;
        project.dnit_project(?p);
        val text_r: res[str, fs.FsError] = fs.read_string(?alloc, counter);
        if (sel text_r.err) { ret 4; }
        val text:     str = text_r.ok;
        var expected: str = "1";
        # round 0 runs the step, round 1 forces it again, round 2 reuses the round-1 stamp
        if (round == 1 || round == 2) { expected = "2"; }
        val same: bool = str_equals(text, expected);
        str_free(?alloc, text);
        if (!same) { ret (10 + round)::i32; }
        round = round + 1;
    }
    ret 0;
}

test build_steps_repeat_reexecutes_on_stale_input {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:  session.Session   = sr.ok;
    val rr: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "fun main() i32 { ret 0; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold_m(?alloc, ut_manifest_step_repeat_watched(), ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    var bad:       bool              = false;
    val watched_r: res[str, A.Error] = path.resolve(?alloc, root, "watched");
    if (sel watched_r.err) { bad = true; }
    if (sel watched_r.ok) {
        val watched:       str             = watched_r.ok;
        val write_bytes_r: err[fs.FsError] = fs.write_bytes(watched, "a"::*u8, 1, 420);
        if (sel write_bytes_r.err) { bad = true; }
    }

    var pick: manifest.Selection;
    pick.target       = "linux";
    pick.profile      = "";
    pick.artifact     = "app";
    pick.want_lib     = false;
    pick.has_artifact = true;
    val first_r: res[project.Project, outcome.Fail] = driver.build_project_sel(?s, root, ?pick);
    if (sel first_r.err) { bad = true; }
    if (sel first_r.ok) {
        var first: project.Project = first_r.ok;
        project.dnit_project(?first);
    }

    val watched2_r: res[str, A.Error] = path.resolve(?alloc, root, "watched");
    if (sel watched2_r.err) { bad = true; }
    if (sel watched2_r.ok) {
        val watched2:       str             = watched2_r.ok;
        val write_bytes_r2: err[fs.FsError] = fs.write_bytes(watched2, "b"::*u8, 1, 420);
        if (sel write_bytes_r2.err) { bad = true; }
    }

    val second_r: res[project.Project, outcome.Fail] = driver.build_project_sel(?s, root, ?pick);
    if (sel second_r.err) { bad = true; }
    if (sel second_r.ok) {
        var second: project.Project = second_r.ok;
        project.dnit_project(?second);
    }

    val counter_r: res[str, A.Error] = path.resolve(?alloc, root, "counter");
    if (sel counter_r.err) { bad = true; }
    if (sel counter_r.ok) {
        val counter: str                  = counter_r.ok;
        val text_r:  res[str, fs.FsError] = fs.read_string(?alloc, counter);
        if (sel text_r.err) { bad = true; }
        if (sel text_r.ok) {
            if (!str_equals(text_r.ok, "2")) { bad = true; }
        }
    }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    if (bad) { ret 1; }
    ret 0;
}

test build_steps_stale_staging_discarded_before_run {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:  session.Session   = sr.ok;
    val rr: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [2]str;
    names[0] = "main.mach";
    names[1] = "window.mach";
    var texts: [2]str;
    texts[0] = "fun main() i32 { ret 0; }\n";
    texts[1] = "pub fun w() i32 { ret 1; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold_m(?alloc, ut_manifest_step_never_writes(), ?names[0], ?texts[0], 2);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    var bad:     bool              = false;
    val stale_r: res[str, A.Error] = path.resolve(?alloc, root, "out/linux/debug/.stage/vendor/obj/vend-c/window.o");
    if (sel stale_r.err) { bad = true; }
    if (sel stale_r.ok) {
        val stale:       str               = stale_r.ok;
        val stale_dir_r: res[str, A.Error] = path.resolve(?alloc, root, "out/linux/debug/.stage/vendor/obj/vend-c");
        if (sel stale_dir_r.err) { bad = true; }
        if (sel stale_dir_r.ok) {
            val stale_dir:        str             = stale_dir_r.ok;
            val create_dir_all_r: err[fs.FsError] = fs.create_dir_all(?alloc, stale_dir, 493);
            if (sel create_dir_all_r.err) { bad = true; }
        }
        val write_bytes_r: err[fs.FsError] = fs.write_bytes(stale, "stale-from-a-crashed-run"::*u8, 24, 420);
        if (sel write_bytes_r.err) { bad = true; }
    }

    var pick: manifest.Selection;
    pick.target       = "linux";
    pick.profile      = "";
    pick.artifact     = "app";
    pick.want_lib     = false;
    pick.has_artifact = true;
    val pr: res[project.Project, outcome.Fail] = driver.build_project_sel(?s, root, ?pick);
    if (sel pr.ok) {
        var p: project.Project = pr.ok;
        project.dnit_project(?p);
        bad = true;
    }
    if (sel pr.err) {
        val f: outcome.Fail = pr.err;
        if (!ut_str_contains(outcome.describe(f), "did not publish valid declared output")) { bad = true; }
    }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    if (bad) { ret 1; }
    ret 0;
}

test resolve_artifact_path {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "fun main() i32 { ret 0; }\n";

    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 1);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;

    var bad: i32 = 0;

    var pick: manifest.Selection;
    pick.target       = "linux";
    pick.profile      = "";
    pick.artifact     = "";
    pick.want_lib     = false;
    pick.has_artifact = false;
    val pr: res[str, outcome.Fail] = dcfg.resolve_artifact_path(?alloc, root, ?pick);
    if (sel pr.err) { bad = 1; }
    if (sel pr.ok) {
        if (!ut_native_path_is(?alloc, pr.ok, root,
            "out/linux/debug/bin/uniontest")) { bad = 1; }
    }

    var sel_bad: manifest.Selection;
    sel_bad.target       = "linux";
    sel_bad.profile      = "";
    sel_bad.artifact     = "nope";
    sel_bad.want_lib     = false;
    sel_bad.has_artifact = true;
    val pr_bad: res[str, outcome.Fail] = dcfg.resolve_artifact_path(?alloc, root, ?sel_bad);
    if (sel pr_bad.ok) { bad = 1; }

    fs.remove_all(?alloc, root);

    val split_root_r: res[str, fail.Fail] = ut_scaffold_m(
        ?alloc, ut_manifest_split(), ?names[0], ?texts[0], 1);
    if (sel split_root_r.err) { ret 1; }
    val split_root: str = split_root_r.ok;
    var split_sel:  manifest.Selection;
    split_sel.target       = "windows";
    split_sel.profile      = "";
    split_sel.artifact     = "";
    split_sel.want_lib     = false;
    split_sel.has_artifact = false;
    val split_pr: res[str, outcome.Fail] = dcfg.resolve_artifact_path(
        ?alloc, split_root, ?split_sel);
    if (sel split_pr.err) { bad = 1; }
    if (sel split_pr.ok) {
        if (!ut_native_path_is(?alloc, split_pr.ok, split_root,
            "out/windows/debug/bin/uniontest.exe")) { bad = 1; }
    }
    fs.remove_all(?alloc, split_root);
    ret bad;
}

# a test goal names no artifact: the plan tests the one the selected target builds
test test_primary_artifact_matches_target {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    val rr: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.err) { ret 1; }

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "fun main() i32 { ret 0; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold_m(?alloc, ut_manifest_split(), ?names[0], ?texts[0], 1);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?alloc, root); }

    val mr: res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) { ret 1; }
    var m:  manifest.Manifest    = mr.ok;
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    rq.target       = "windows";
    rq.goal         = request.GOAL_TESTS;
    val pr: res[bplan.BuildPlan, outcome.Fail] = bplan.plan(?alloc, ?s.interner, s.registry, ?m, rq);
    if (sel pr.err) { ret 2; }
    var bp: bplan.BuildPlan = pr.ok;
    if (bp.units.len != 1)                                               { ret 3; }
    if (!str_equals(bp.units.data[0].sel_artifact, "uniontest-windows")) { ret 4; }
    ret 0;
}

