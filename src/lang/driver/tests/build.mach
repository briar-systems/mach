        val text_r: res[str, fs.FsError] = fs.read_string(?alloc, seen_r.ok);
        if (sel text_r.err)                                  { ret 99; }
        if (!(sel text_r.ok && str_equals(text_r.ok, "ok"))) { bad = 1; }
    }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

fun ut_manifest_two_artifacts() str {
    ret "[project]\nmach = \">=5\"\nid = \"lessons\"\nversion = \"0.1.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.linux]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[profile.debug]\ndefault = true\nopt = 0\ndebug = false\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n\n[artifact.hello]\ndefault = true\nkind = \"bin\"\nentry = \"hello.mach\"\nout = \"bin/hello\"\ntargets = [\"*\"]\nlink = []\nneed = []\n\n[artifact.shaded]\nkind = \"bin\"\nentry = \"shaded.mach\"\nout = \"bin/shaded\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
}

# a two-artifact project: `common` is shared, `stray` is reached by neither and does not
# type-check, and `shaded` refuses to be compiled for any artifact but its own (#3778)
fun ut_scaffold_two_artifacts(alloc: *A.Allocator) res[str, fail.Fail] {
    val start: str = ut_dispatcher_start_stub();
    var names: [4]str;
    var texts: [4]str;
    names[0] = "hello.mach";
    texts[0] = ut_cc3(alloc, "use lessons.common;\n\n", start, "\ntest own { ret common.zero(); }\n");
    names[1] = "shaded.mach";
    texts[1] = ut_cc3(alloc, "$if ($bin.name != \"shaded\") { $error(\"wrong artifact\"); }\n\nuse lessons.common;\n\n", start,
        "\ntest own { ret common.zero(); }\n");
    names[2] = "common.mach";
    texts[2] = "pub fun zero() i32 { ret 0; }\n\ntest names_its_artifact {\n    $if ($bin.name == \"hello\") { ret 11; }\n    $or ($bin.name == \"shaded\") { ret 12; }\n    ret 13;\n}\n";
    names[3] = "stray.mach";
    texts[3] = "pub fun broken() i32 { ret lessons_undefined_symbol(); }\n\ntest never { ret 0; }\n";
    ret ut_scaffold_m(alloc, ut_manifest_two_artifacts(), ?names[0], ?texts[0], 4);
}

# the tests `mach test` builds for `artifact` ("" selects the default), each label
# with the status its dispatcher exits with, or the build's failure
fun ut_artifact_test_statuses(alloc: *A.Allocator, s: *session.Session, root: str, artifact: str,
    labels: *Vector[str], statuses: *Vector[i32]) i32 {
    val mr: res[manifest.Manifest, outcome.Fail] = driver.load_manifest(s, root);
    if (sel mr.err) { ret 1; }
    var m:  manifest.Manifest    = mr.ok;
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    rq.target       = "linux";
    rq.artifact     = artifact;
    rq.debug        = false;
    rq.goal         = request.GOAL_TESTS;
    val pr: res[bplan.BuildPlan, outcome.Fail] = bplan.plan(alloc, ?s.interner, s.registry, ?m, rq);
    if (sel pr.err) {
        print.eprintln(outcome.describe(pr.err));
        ret 2;
    }
    var bp: bplan.BuildPlan                         = pr.ok;
    val r:  res[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, s, alloc, nil);
    if (sel r.err) {
        print.eprintln(outcome.describe(r.err));
        ret 3;
    }
    var bo: outcome.BuildOutcome = r.ok;
    fin { outcome.outcome_dnit(?bo); }
    if (bo.severity != outcome.BUILD_OK) {
        var di: usize = 0;
        for (di < diagnostic.len(?s.diags)) {
            print.eprintln(s.diags.items.data[di].message);
            di = di + 1;
        }
        ret 4;
    }
    var t: usize = 0;
    for (t < bo.tests.len) {
        val art:   *outcome.TestArtifact = ?bo.tests.data[t];
        val label: res[str, A.Error]     = str_dup(alloc, art.name::str);
        if (sel label.err) { ret 5; }
        val pl: res[usize, A.Error] = vector.push[str](labels, label.ok);
        if (sel pl.err) { ret 5; }
        val ps: res[usize, A.Error] = vector.push[i32](statuses, ut_dispatch_status(art.exe::str, art.idx));
        if (sel ps.err) { ret 5; }
        t = t + 1;
    }
    ret 0;
}

fun ut_status_of(labels: *Vector[str], statuses: *Vector[i32], label: str) i32 {
    var i: usize = 0;
    for (i < labels.len) {
        if (str_equals(labels.data[i], label)) { ret statuses.data[i]; }
        i = i + 1;
    }
    ret -2;
}

# `mach test` tests one artifact's closure, the way `mach build` builds it: the default
# artifact's tests without a selector, the named artifact's under `--bin`, never a module
# neither reaches, and `$bin.name` in a test block is the artifact under test (#3813, #3778)
test test_goal_tests_the_selected_artifacts_closure {
    $if ($mach.build.os != $mach.os.linux || $mach.build.arch != $mach.arch.x86_64) { ret 0; }
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) { ret 1; }

    val root_r: res[str, fail.Fail] = ut_scaffold_two_artifacts(?alloc);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?alloc, root); }

    var labels:   Vector[str] = vector.init[str](?alloc);
    var statuses: Vector[i32] = vector.init[i32](?alloc);
    fin {
        vector.dnit[str](?labels);
        vector.dnit[i32](?statuses);
    }

    # the default artifact
    val dr: i32 = ut_artifact_test_statuses(?alloc, ?s, root, "", ?labels, ?statuses);
    if (dr != 0)                                                                     { ret 10 + dr; }
    if (labels.len != 2)                                                             { ret 20; }
    if (ut_status_of(?labels, ?statuses, "lessons.hello#own") != 0)                  { ret 21; }
    if (ut_status_of(?labels, ?statuses, "lessons.common#names_its_artifact") != 11) { ret 22; }

    # the other artifact, which a default run never compiles
    labels.len   = 0;
    statuses.len = 0;
    val sr2: i32 = ut_artifact_test_statuses(?alloc, ?s, root, "shaded", ?labels, ?statuses);
    if (sr2 != 0)                                                                    { ret 30 + sr2; }
    if (labels.len != 2)                                                             { ret 40; }
    if (ut_status_of(?labels, ?statuses, "lessons.shaded#own") != 0)                 { ret 41; }
    if (ut_status_of(?labels, ?statuses, "lessons.common#names_its_artifact") != 12) { ret 42; }
    ret 0;
}

