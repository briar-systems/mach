    texts[1] = "$if ($mach.build.os == $mach.os.windows) {\n    #[library(\"kernel32\")]\n    ext fun Sleep(ms: u32);\n}\n$or {\n    #[library(\"c\")]\n    ext fun Sleep(ms: u32);\n}\n\npub fun call() { Sleep(0); }\n";

    var bad: i32                    = 0;
