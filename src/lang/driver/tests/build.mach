    if (!(sel win.ok && str_equals(win.ok, "kernel32"))) { bad = 1; }

    val lin: res[str, outcome.Fail] = ut_attr_probe(?s, ?alloc, ?names[0], ?texts[0], 2, "linux", "Sleep");
    if (!(sel lin.ok && str_equals(lin.ok, "c"))) { bad = 1; }

    val mac: res[str, outcome.Fail] = ut_attr_probe(?s, ?alloc, ?names[0], ?texts[0], 2, "darwin-x86_64", "_Sleep");
    if (!(sel mac.ok && str_equals(mac.ok, "c"))) { bad = 1; }

    session.dnit(?s);
    ret bad;
}

fun ut_fs_elf_manifest() str {
    ret "[project]\nmach = \">=5\"\nid = \"fself\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.fsx]\nisa = \"x86_64\"\nos = \"freestanding\"\nabi = \"sysv64\"\nof = \"elf\"\n\n[target.fsa]\nisa = \"aarch64\"\nos = \"freestanding\"\nabi = \"aapcs64\"\nof = \"elf\"\n\n[target.fsr]\nisa = \"riscv64\"\nos = \"freestanding\"\nabi = \"lp64d\"\nof = \"elf\"\n\n[target.fsr32]\nisa = \"rv32imafdc\"\nos = \"freestanding\"\nabi = \"ilp32d\"\nof = \"elf\"\n\n[target.lx]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[profile.debug]\nopt = 0\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n\n[artifact.fself]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/fself\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
}

fun ut_fs_elf_src() str {
    ret "val table: [4]u32 = [4]u32{11, 22, 33, 44};\nvar counter: u32 = 0;\nvar scratch: [16]u32;\n#[symbol(\"_start\")]\npub fun start() {\n    var i: u32 = 0;\n    for (i < 4) {\n        counter = counter + table[i];\n        scratch[i] = counter;\n        i = i + 1;\n    }\n}\n";
}

rec UtLoadSeg {
    off:    u64;
    vaddr:  u64;
    filesz: u64;
}

fun ut_le64(b: *u8, off: usize) u64 {
    ret ut_le32(b, off) | (ut_le32(b, off + 4) << 32);
}

fun ut_elf_loads(img: *Vector[u8], segs: *UtLoadSeg, cap: u32, entry_out: *u64) u32 {
    if (img.len < 64) { ret 0; }
    val b:     *u8  = img.data;
    val elf32: bool = b[4] == 1;

    var phoff:     u64 = 0;
    var phentsize: u64 = 0;
    var phnum:     u64 = 0;
    if (elf32) {
        @entry_out = ut_le32(b, 24);
        phoff      = ut_le32(b, 28);
        phentsize  = ut_le16(b, 42);
        phnum      = ut_le16(b, 44);
    }
    or {
        @entry_out = ut_le64(b, 24);
        phoff      = ut_le64(b, 32);
        phentsize  = ut_le16(b, 54);
        phnum      = ut_le16(b, 56);
    }

    var n: u32 = 0;
    var i: u64 = 0;
    for (i < phnum && n < cap) {
        val p: usize = (phoff + i * phentsize)::usize;
        if (p + phentsize::usize > img.len) { ret n; }
        if (ut_le32(b, p) == 1) {
            if (elf32) {
                segs[n].off    = ut_le32(b, p + 4);
                segs[n].vaddr  = ut_le32(b, p + 8);
                segs[n].filesz = ut_le32(b, p + 16);
            }
            or {
                segs[n].off    = ut_le64(b, p + 8);
                segs[n].vaddr  = ut_le64(b, p + 16);
                segs[n].filesz = ut_le64(b, p + 32);
            }
            n = n + 1;
        }
        i = i + 1;
    }
    ret n;
}

fun ut_link_exe_image(p: *project.Project, root: str, out: *Vector[u8]) bool {
    val alloc: *A.Allocator = p.alloc;
    if (p.emit_len == 0) { ret false; }

    val ir: res[*of.ObjectImage, A.Error] = A.allocate[of.ObjectImage](alloc, p.emit_len::usize);
    if (sel ir.err) { ret false; }
    val images:  *of.ObjectImage = ir.ok;
    var missing: bool            = false;
    var i:       u32             = 0;
    for (i < p.emit_len) {
        val m: *project.ModuleEntry = project.module_at(p, (p.topo[i])::u32);
        if (m.object_image == nil) { missing = true; }
        or                         { images[i] = @m.object_image; }
        i = i + 1;
    }

    var linked: bool = false;
    val path:   str  = ut_cc3(alloc, root, "/", "image.elf");
    if (!missing) {
        val lr: err[fail.Fail] = ut_planned_link_images(p.s, ?p.target, images, p.emit_len,
            nil::*of.DynLib, 0, path::*u8, "fself"::*u8, linker.LINK_EXE, false,
            of.image_options_default(of.SUBSYSTEM_CONSOLE));
        linked = sel lr.ok;
    }
    A.deallocate[of.ObjectImage](alloc, images, p.emit_len::usize);
    if (!linked) { ret false; }

    val br: res[Vector[u8], fs.FsError] = fs.read_bytes(alloc, path);
    if (sel br.err) { ret false; }
    @out = br.ok;
    ret true;
}

fun ut_fs_elf_image(alloc: *A.Allocator, target_name: str, out: *Vector[u8]) bool {
    val sr: res[session.Session, fail.Fail] = session.init(alloc);
    if (sel sr.err) { ret false; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = ut_fs_elf_src();
    val root_r: res[str, fail.Fail] = ut_scaffold_m(alloc, ut_fs_elf_manifest(), ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret false;
    }
    val root: str = root_r.ok;

    var ok: bool              = false;
    val rr: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.ok) {
        var tsel_16525: manifest.Selection                 = ut_target_sel(target_name);
        val pr:         res[project.Project, outcome.Fail] = driver.build_project(?s, root, ?tsel_16525);
        if (sel pr.ok) {
            var p: project.Project = pr.ok;
            if (ut_run_codegen_ok(?p) == 0) { ok = ut_link_exe_image(?p, root, out); }
            project.dnit_project(?p);
        }
    }
    fs.remove_all(alloc, root);
    session.dnit(?s);
    ret ok;
}

val UT_FS_VADDR_CEIL: u64 = 0x100000;

fun ut_fs_elf_unmapped_header(alloc: *A.Allocator, target_name: str) bool {
    var img: Vector[u8];
    if (!ut_fs_elf_image(alloc, target_name, ?img)) { ret false; }

    var segs:  [16]UtLoadSeg;
    var entry: u64 = 0;
    val n:     u32 = ut_elf_loads(?img, ?segs[0], 16, ?entry);

    var ok:           bool = n > 0;
    var covers_entry: bool = false;
    var i:            u32  = 0;
    for (i < n) {
        if (segs[i].off == 0)                                                 { ok = false; }
        if (segs[i].vaddr >= UT_FS_VADDR_CEIL)                                { ok = false; }
        if (segs[i].off + segs[i].filesz > img.len::u64)                      { ok = false; }
        if (entry >= segs[i].vaddr && entry < segs[i].vaddr + segs[i].filesz) { covers_entry = true; }
        i = i + 1;
    }
    if (!covers_entry) { ok = false; }

    vector.dnit[u8](?img);
    ret ok;
}

fun ut_linux_elf_maps_header(alloc: *A.Allocator) bool {
    var img: Vector[u8];
    if (!ut_fs_elf_image(alloc, "lx", ?img)) { ret false; }

    var segs:  [16]UtLoadSeg;
    var entry: u64 = 0;
    val n:     u32 = ut_elf_loads(?img, ?segs[0], 16, ?entry);

    var headers: u32  = 0;
    var content: u32  = 0;
    var ok:      bool = n > 1;
    var i:       u32  = 0;
    for (i < n) {
        if (segs[i].off == 0) {
            headers = headers + 1;
            if (segs[i].vaddr != oslinux.LINUX_BASE_ADDR - oslinux.LINUX_PAGE_SIZE) { ok = false; }
        }
        or {
            content = content + 1;
            if (segs[i].vaddr < oslinux.LINUX_BASE_ADDR) { ok = false; }
        }
        i = i + 1;
    }
    if (headers != 1 || content == 0) { ok = false; }

    vector.dnit[u8](?img);
    ret ok;
}

test freestanding_elf_links_with_no_header_segment {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }

    var bad: bool = false;
    if (!ut_fs_elf_unmapped_header(?alloc, "fsx"))   { bad = true; }
    if (!ut_fs_elf_unmapped_header(?alloc, "fsa"))   { bad = true; }
    if (!ut_fs_elf_unmapped_header(?alloc, "fsr"))   { bad = true; }
    if (!ut_fs_elf_unmapped_header(?alloc, "fsr32")) { bad = true; }
    if (!ut_linux_elf_maps_header(?alloc))           { bad = true; }

    if (bad) { ret 1; }
    ret 0;
}

# a test build links every module's normal object and each test object beside it
test q_link__records_the_normal_and_test_codegen_keys {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [2]str;
    names[0] = "main.mach";
    names[1] = "a.mach";
    var texts: [2]str;
    texts[0] = ut_cc3(?alloc, "use uniontest.a.fa;\n#[symbol(\"", ut_entry_symbol(), "\")]\nfun start() i32 { ret fa(); }\n");
    texts[1] = "pub fun fa() i32 { ret 0; }\n\ntest a_zero { ret fa(); }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 2);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    val mr: res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var m:  manifest.Manifest    = mr.ok;
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    rq.goal         = request.GOAL_TESTS;
    val pr: res[bplan.BuildPlan, outcome.Fail] = bplan.plan(?alloc, ?s.interner, s.registry, ?m, rq);
    if (sel pr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var bp: bplan.BuildPlan = pr.ok;

    var bad: i32                                     = 0;
    val r1:  res[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, ?alloc, nil);
    if (sel r1.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    if (r1.ok.severity != outcome.BUILD_OK) { bad = 1; }

    val keys_r: res[Vector[query.QueryKey], fail.Fail] = query.cached_dependency_keys(?s.queries, query.Q_LINK, 0, ?alloc);
    if (sel keys_r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var keys: Vector[query.QueryKey] = keys_r.ok;
    fin { vector.dnit[query.QueryKey](?keys); }

    var normal_deps: u32   = 0;
    var test_deps:   u32   = 0;
    var i:           usize = 0;
    for (i < keys.len) {
        val d: query.QueryKey = keys.data[i];
        if (d.kind == query.Q_CODEGEN) {
            if (passes.back_half_key_is_test(d.key)) { test_deps = test_deps + 1; }
            or                                       { normal_deps = normal_deps + 1; }
        }
        i = i + 1;
    }
    # only uniontest.a declares a test
    if (normal_deps < 2 || test_deps != 1) { bad = 1; }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

fun ut_manifest_step_target_env() str {
    ret "[project]\nmach = \">=5\"\nid = \"tenv\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.linux]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[step.probe]\nargv = [\"sh\", \"-c\", 'test \"$MACH_TARGET_ISA\" = x86_64 && test \"$MACH_TARGET_OS\" = linux && test \"$MACH_TARGET_ABI\" = sysv64 && printf ok > seen']\nenv = { MACH_TARGET_ISA = \"spoofed\", CARRIED = \"through\" }\nin = []\nout = [\"seen\"]\nneed = []\n\n[artifact.app]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/app\"\ntargets = [\"*\"]\nlink = []\nneed = [\"step.probe\"]\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n";
}

test step_target_environment_replaces_a_declared_override {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "fun main() i32 { ret 0; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold_m(?alloc, ut_manifest_step_target_env(), ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    var bad:  i32 = 0;
    var pick: manifest.Selection;
    pick.target       = "linux";
    pick.profile      = "";
    pick.artifact     = "app";
    pick.want_lib     = false;
    pick.has_artifact = true;
    val pr: res[project.Project, outcome.Fail] = driver.build_project_sel(?s, root, ?pick);
    if (sel pr.err) { bad = 1; }
    if (sel pr.ok) {
        var p: project.Project = pr.ok;
        project.dnit_project(?p);
    }

    val seen_r: res[str, A.Error] = path.resolve(?alloc, root, "seen");
    if (sel seen_r.err) { bad = 1; }
