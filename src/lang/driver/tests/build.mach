test setup_registry__idempotent_across_repeated_calls_on_one_session {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val isa_count: u32 = isa.registered_count(?s.registry.isa);
    val abi_count: u32 = abi.registered_count(?s.registry.abi);
    val of_count:  u32 = of.registered_count(?s.registry.of);
    val os_count:  u32 = os.registered_count(?s.registry.os);
    if (isa_count == 0) {
        session.dnit(?s);
        ret 1;
    }

    val setup_registry_r2: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r2.err) {
        session.dnit(?s);
        ret 1;
    }
    val setup_registry_r3: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r3.err) {
        session.dnit(?s);
        ret 1;
    }
    if (isa.registered_count(?s.registry.isa) != isa_count) {
        session.dnit(?s);
        ret 1;
    }
    if (abi.registered_count(?s.registry.abi) != abi_count) {
        session.dnit(?s);
        ret 1;
    }
    if (of.registered_count(?s.registry.of) != of_count) {
        session.dnit(?s);
        ret 1;
    }
    if (os.registered_count(?s.registry.os) != os_count) {
        session.dnit(?s);
        ret 1;
    }

    session.dnit(?s);
    ret 0;
}

# a manifest naming an isa the registry does not carry is refused through the
# registry's own lookup, for any source
test mos6502_target_is_refused_as_unregistered {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "fun main() i32 { ret 0; }\n";
    val manifest_text: str                 = "[project]\nmach = \">=5\"\nid = \"mos\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.mos]\nisa = \"mos6502\"\nos = \"freestanding\"\nabi = \"mos6502\"\n\n[profile.debug]\nopt = 0\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n\n[artifact.mos]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/mos\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
    val root_r:        res[str, fail.Fail] = ut_scaffold_m(?alloc, manifest_text, ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    var bad:  i32                                = 0;
    var pick: manifest.Selection                 = ut_target_sel("mos");
    val pr:   res[project.Project, outcome.Fail] = driver.build_project(?s, root, ?pick);
    if (sel pr.ok) {
        var p: project.Project = pr.ok;
        project.dnit_project(?p);
        bad = 1;
    }
    if (sel pr.err) {
        if (!outcome.is_user(pr.err))                                                                                   { bad = 2; }
        if (!ut_str_contains(outcome.describe(pr.err), "no isa implementation registered for 'mos6502' (registered: ")) { bad = 3; }
    }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

test lower_diagnostic_fails_build {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var bad: i32 = 0;

    val pk: str = ut_cc3(?alloc,
        "fun sink(va: ...) u32 { var acc: *u8 = nil; $each a in va { acc = a; } ret 0; }\n#[symbol(\"",
        ut_entry_symbol(), "\")]\nfun start() i32 { sink(7u32); ret 0; }\n");
    val ok: str = ut_cc3(?alloc,
        "fun sink(va: ...) u32 { var acc: u32 = 0; $each a in va { acc = acc + a; } ret acc; }\n#[symbol(\"",
        ut_entry_symbol(), "\")]\nfun start() i32 { sink(7::u32, 8::u32); ret 0; }\n");
    val ok_suffixed: str = ut_cc3(?alloc,
        "fun sink(va: ...) u32 { var acc: u32 = 0; $each a in va { acc = acc + a; } ret acc; }\n#[symbol(\"",
        ut_entry_symbol(), "\")]\nfun start() i32 { sink(7u32, 8u32); ret 0; }\n");

    if (!ut_sema_clean(pk))             { bad = 1; }
    if (ut_engine_build_fails(pk) != 0) { bad = 1; }

    if (ut_engine_build_fails(ok) == 0) { bad = 1; }
    if (!ut_sema_clean(ok))             { bad = 1; }

    if (ut_engine_build_fails(ok_suffixed) == 0) { bad = 1; }
    if (!ut_sema_clean(ok_suffixed))             { bad = 1; }

    ret bad;
}

