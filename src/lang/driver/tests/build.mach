fun ut_build_test(s: *session.Session, alloc: *A.Allocator, names: *str, texts: *str, n: u32) res[project.Project, outcome.Fail] {
    val root_r: res[str, fail.Fail] = ut_scaffold(alloc, names, texts, n);
    if (sel root_r.err) { ret res[project.Project, outcome.Fail].err{outcome.from_fail(root_r.err)}; }
    val root: str               = root_r.ok;
    val rr:   err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.err) {
        fs.remove_all(alloc, root);
        ret res[project.Project, outcome.Fail].err{rr.err};
    }
    val pick: manifest.Selection                 = ut_target_sel("");
    val pr:   res[project.Project, outcome.Fail] = ut_load_test_goal(s, root, pick);
    fs.remove_all(alloc, root);
    ret pr;
}

test wildcard_match {
    var bad: i32 = 0;
    if (!dcfg.wildcard_match("*.c", "mad.c"))           { bad = 1; }
    if (!dcfg.wildcard_match("*.c", ".c"))              { bad = 1; }
    if (!dcfg.wildcard_match("mini*.h", "miniaudio.h")) { bad = 1; }
    if (!dcfg.wildcard_match("a*b*c", "axxbyyc"))       { bad = 1; }
    if (!dcfg.wildcard_match("*", "anything"))          { bad = 1; }
    if (!dcfg.wildcard_match("exact.c", "exact.c"))     { bad = 1; }
    if (dcfg.wildcard_match("*.c", "mad.h"))            { bad = 1; }
    if (dcfg.wildcard_match("*.c", "mad.cpp"))          { bad = 1; }
    if (dcfg.wildcard_match("mini*.h", "audio.h"))      { bad = 1; }
    if (dcfg.wildcard_match("exact.c", "exact.cc"))     { bad = 1; }
    ret bad;
}

test glob_shape_ok {
    var bad: i32 = 0;
    if (!dcfg.glob_shape_ok("dir/*.c"))    { bad = 1; }
    if (!dcfg.glob_shape_ok("dir/**/*.c")) { bad = 1; }
    if (!dcfg.glob_shape_ok("*.c"))        { bad = 1; }
    if (!dcfg.glob_shape_ok("a/b/c.c"))    { bad = 1; }
    if (dcfg.glob_shape_ok("a/*/b.c"))     { bad = 1; }
    if (dcfg.glob_shape_ok("a/**/**/*.c")) { bad = 1; }
    ret bad;
}

# a test build loads the selected artifact's closure only: the modules only another
# target's artifact reaches are never loaded, and a module both reach is compiled here
# (#3428, #3813)
test test_leaves_out_another_targets_artifact_modules {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    val setup_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_r.err) { ret 1; }

    val mtext: str = "[project]\nmach = \">=5\"\nid = \"split\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.host]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[target.gpu]\nisa = \"spirv\"\nos = \"freestanding\"\nabi = \"spirv\"\n\n[profile.debug]\ndefault = true\nopt = 0\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n\n[artifact.app]\nkind = \"static\"\nentry = \"main.mach\"\nout = \"lib/app\"\ntargets = [\"host\"]\nlink = []\nneed = []\n\n[artifact.shader]\nkind = \"bin\"\nentry = \"frag.mach\"\nout = \"spv/frag.spv\"\ntargets = [\"gpu\"]\nlink = []\nneed = []\n";
    var names: [4]str;
    var texts: [4]str;
    names[0] = "main.mach";
    texts[0] = "use split.shared;\n\ntest host { ret 0; }\n";
    names[1] = "frag.mach";
    texts[1] = "use split.shaderlib;\nuse split.shared;\n\n#[output(0)] var out_colour: f32x4;\n\n#[stage(\"fragment\")]\nfun frag_main() { out_colour = shaderlib.tint(shared.gain()); }\n";
    names[2] = "shaderlib.mach";
    texts[2] = "pub fun tint(v: f32) f32x4 { ret f32x4{v, v, v, 1.0}; }\n";
    names[3] = "shared.mach";
    texts[3] = "pub fun gain() f32 { ret 0.5; }\n";

    val root_r: res[str, fail.Fail] = ut_scaffold_m(?alloc, mtext, ?names[0], ?texts[0], 4);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;

    var pick: manifest.Selection = ut_target_sel("host");
    pick.artifact     = "app";
    pick.want_lib     = true;
    pick.has_artifact = true;
    val pr: res[project.Project, outcome.Fail] = ut_load_test_goal(?s, root, pick);
    fs.remove_all(?alloc, root);
    if (sel pr.err) { ret 2; }
    var p: project.Project = pr.ok;
    fin { project.dnit_project(?p); }

    var bad: i32 = 0;
    # the shader artifact's own modules belong to the gpu target
    if (ut_has(?p, ?s, "split.frag"))      { bad = 1; }
    if (ut_has(?p, ?s, "split.shaderlib")) { bad = 2; }
    # a module both artifacts reach is this build's
    if (!ut_in_topo(?p, ?s, "split.shared")) { bad = 4; }
    if (!ut_in_topo(?p, ?s, "split.main"))   { bad = 5; }
    val se: err[outcome.Fail] = driver.run_sema_pass(?p);
    if (sel se.err)                       { bad = 6; }
    if (ut_count_errors(?p.s.diags) != 0) { bad = 6; }
    ret bad;
}

test test_reachable_error_still_fatal {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [2]str;
    names[0] = "main.mach";
    names[1] = "bad.mach";
    var texts: [2]str;
    texts[0] = "use uniontest.bad;\n\nfun main() i32 { ret 0; }\n";
    texts[1] = "$error(\"reachable boom\");\n\npub fun f() i32 { ret 0; }\n";

    val pr: res[project.Project, outcome.Fail] = ut_build_test(?s, ?alloc, ?names[0], ?texts[0], 2);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    var bad: i32 = 0;
    if (!ut_in_topo(?p, ?s, "uniontest.bad")) { bad = 1; }
    val se: err[outcome.Fail] = driver.run_sema_pass(?p);
    if (!(sel se.err && outcome.is_reported(se.err))) { bad = 1; }
    if (ut_count_errors(?p.s.diags) == 0)             { bad = 1; }

    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

# a test body's literal `ret` is refused at the ret when it is outside 0..255, with
# the value in the message; an ordinary function returning the same value is not
test test_result_outside_the_status_range_is_refused_at_the_ret {
    val src: str = "fun main() i32 { ret 0; }\nfun wide() i32 { ret 256; }\ntest a { ret 256; }\ntest b { ret 300; }\ntest c { ret -1; }\n";
    if (!ut_sema_rejects_at(src, "test result 256 is outside the status range 0..255", 63, 8)) { ret 1; }
    if (!ut_sema_rejects_at(src, "test result 300 is outside the status range 0..255", 83, 8)) { ret 2; }
    if (!ut_sema_rejects_at(src, "test result -1 is outside the status range 0..255", 103, 7)) { ret 3; }

    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 4; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 4; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = src;
    val pr: res[project.Project, outcome.Fail] = ut_build(?s, ?alloc, ?names[0], ?texts[0], 1);
    if (sel pr.err) { ret 4; }
    var p: project.Project = pr.ok;
    fin { project.dnit_project(?p); }
    driver.run_sema_pass(?p);
    # exactly the three test rets, not `wide`
    if (ut_diag_count(?s.diags, "outside the status range 0..255") != 3) { ret 5; }
    if (!ut_diag_note_has(?s.diags, "eight bits on every host"))         { ret 6; }

    # the range itself, and a run-time value, are the dispatcher's business
    if (!ut_sema_clean("fun main() i32 { ret 0; }\nfun wide() i32 { ret 256; }\ntest d { ret 255; }\ntest e { ret 0; }\ntest f { ret wide(); }\ntest g { ret 200 + 55; }\n")) { ret 7; }
    ret 0;
}

# a run-time result outside 0..255 exits 255 instead of its low eight bits, so it
# can never read as a pass; a result inside the range is the exit code as is
test dispatcher_folds_a_wide_run_time_result_to_255 {
    $if ($mach.build.os != $mach.os.linux || $mach.build.arch != $mach.arch.x86_64) { ret 0; }
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) { ret 1; }

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = ut_cc3(?alloc,
        "#[noinline]\nfun wide(v: i32) i32 { ret v; }\n",
        "test r256 { ret wide(256); }\ntest r300 { ret wide(300); }\ntest rneg1 { ret wide(-1); }\ntest r3 { ret 3; }\ntest r0 { ret 0; }\ntest r255 { ret 255; }\n",
        ut_dispatcher_start_stub());
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 1);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?alloc, root); }

    val mr: res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) { ret 1; }
    var m:  manifest.Manifest    = mr.ok;
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    rq.target       = "linux";
    rq.goal         = request.GOAL_TESTS;
    val pr: res[bplan.BuildPlan, outcome.Fail] = bplan.plan(?alloc, ?s.interner, s.registry, ?m, rq);
    if (sel pr.err) { ret 1; }
    var bp: bplan.BuildPlan                         = pr.ok;
    val r:  res[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, ?alloc, nil);
    if (sel r.err) {
        print.eprintln(outcome.describe(r.err));
        ret 1;
    }
    var bo: outcome.BuildOutcome = r.ok;
    if (bo.severity != outcome.BUILD_OK) { ret 2; }
    if (bo.tests.len != 6)               { ret 3; }

    var labels: [6]str;
    labels[0] = "uniontest.main#r256";
    labels[1] = "uniontest.main#r300";
    labels[2] = "uniontest.main#rneg1";
    labels[3] = "uniontest.main#r3";
    labels[4] = "uniontest.main#r0";
    labels[5] = "uniontest.main#r255";
    var want: [6]i32;
    want[0] = 255;
    want[1] = 255;
    want[2] = 255;
    want[3] = 3;
    want[4] = 0;
    want[5] = 255;
    var i: usize = 0;
    for (i < 6) {
        var found: bool  = false;
        var t:     usize = 0;
        for (t < bo.tests.len) {
            val art: *outcome.TestArtifact = ?bo.tests.data[t];
            if (str_equals(art.name::str, labels[i])) {
                found = true;
                val got: i32 = ut_dispatch_status(art.exe::str, art.idx);
                if (got != want[i]) {
                    print.eprintlnf("{}: exit {} (want {})", labels[i], got::i64, want[i]::i64);
                    ret 10 + i::i32;
                }
            }
            t = t + 1;
        }
        if (!found) { ret 4; }
        i = i + 1;
    }
    ret 0;
}

