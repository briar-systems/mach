# analyze the fixture with `extra` loaded beside the artifact closure, the way an
# editor holds a module the artifact never compiles, then lower what it compiles
fun ut_attr_probe_uncompiled(s: *session.Session, alloc: *A.Allocator, names: *str, texts: *str,
    n: u32, target_name: str, extra: str, sym: str) res[str, outcome.Fail] {
    val root_r: res[str, fail.Fail] = ut_scaffold(alloc, names, texts, n);
    if (sel root_r.err) {
        ret res[str, outcome.Fail].err{outcome.from_fail(root_r.err)};
    }
    val root: str = root_r.ok;
    fin { fs.remove_all(alloc, root); }
    val rr: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.err) { ret res[str, outcome.Fail].err{rr.err}; }
    val mr: res[manifest.Manifest, outcome.Fail] = driver.load_manifest(s, root);
    if (sel mr.err) { ret res[str, outcome.Fail].err{mr.err}; }
    var mf: manifest.Manifest = mr.ok;
    fin { manifest.dnit(?mf, alloc); }
    val xid_r: res[intern.StrId, A.Error] = intern.intern(?s.interner, extra);
    if (sel xid_r.err) { ret res[str, outcome.Fail].err{outcome.refused(xid_r.err)}; }
    var extra_roots: [1]intern.StrId;
    extra_roots[0] = xid_r.ok;

    var req: request.BuildRequest = request.defaults();
    req.project_root = root;
    req.target       = target_name;
    val pr: res[project.Project, outcome.Fail] = driver.analyze_project(s, ?mf, ?req, project.ROOT_ARTIFACT, ?extra_roots[0], 1);
    if (sel pr.err) {
        ret res[str, outcome.Fail].err{pr.err};
    }
    var p: project.Project = pr.ok;

    if (p.emit_len >= project.module_count(?p)) {
        project.dnit_project(?p);
        ret res[str, outcome.Fail].err{outcome.user("fixture loaded no uncompiled module")};
    }

    val le: err[outcome.Fail] = driver.run_lower_pass(?p);
    if (sel le.err) {
        project.dnit_project(?p);
        ret res[str, outcome.Fail].err{le.err};
    }

    var out: str                        = "";
    val sid: res[intern.StrId, A.Error] = intern.intern(?s.interner, sym);
    if (sel sid.ok) {
        val got: opt[intern.StrId] = session.import_library(s, sid.ok);
        if (sel got.some) {
            val nm: opt[str] = intern.lookup(?s.interner, got.some);
            if (sel nm.some) { out = nm.some; }
        }
    }
    project.dnit_project(?p);
    ret res[str, outcome.Fail].ok{out};
}

