    names[1] = "orphan.mach";
    var texts: [2]str;
    texts[0] = "fun main() i32 { ret 0; }\n";
    texts[1] = "#[library(\"user32\")]\next fun Sleep(ms: u32);\npub fun call() { Sleep(0); }\n";

