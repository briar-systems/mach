    if (ut_vec_diag("fun f() u32 { val x: u32 = -1u32; ret x; }\nfun main() i32 { ret 0; }\n",
        "literal -1 is out of range for") != 0) { bad = 2; }
    if (ut_vec_diag("fun f() i16 { val x: i16 = 40000i16; ret x; }\nfun main() i32 { ret 0; }\n",
        "literal 40000 is out of range for") != 0) { bad = 3; }
    if (ut_vec_diag("fun f() i8 { val x: i8 = 128i8; ret x; }\nfun main() i32 { ret 0; }\n",
        "literal 128 is out of range for") != 0) { bad = 4; }

    ret bad;
}

test literal_suffix_unknown_spelling_names_the_valid_set {
