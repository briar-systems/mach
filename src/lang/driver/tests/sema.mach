    var s: session.Session = sr.ok;

    var names: [2]str;
    names[0] = "main.mach";
    names[1] = "a.mach";
    var texts: [2]str;
    texts[0] = "use uniontest.a;\nval B: u64 = A + 8;\nval A: u64 = a.BASE + 0x48;\nfun main() i32 { ret 0; }\n";
    texts[1] = "pub rec P { x: u64; y: u64; }\npub val BASE: u64 = $size_of(P);\n";

    val pr: res[project.Project, fail.Fail] = ut_lower_n(?s, ?alloc, ?names[0], ?texts[0], 2);
