#[testing]
fun ut_rodata_globals(m: *ir.Module) u32 {
    if (m == nil) { ret 0; }
    var n:  u32 = 0;
    var gi: u32 = 0;
    for (gi < m.global_len) {
        if ((?m.globals[gi]).init.kind == value.VAL_CONST_BYTES) { n = n + 1; }
        gi = gi + 1;
    }
    ret n;
}

test each__deferred_body_is_typed_per_instance {
    var bad: i32 = 0;

    val src: str = "rec Rc { a: u32; b: u32; }\nvar g: Rc;\nfun walk[Tp](x: Tp) u32 { var acc: u32 = 0; $each f in $fields(Tp) { acc = acc + x; } ret acc; }\nfun sink(va: ...) u32 { var acc: u32 = 0; $each e in va { acc = acc + walk[Rc](g) + e; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var one: u32 = 1; sink(one); ret 0; }\n";
    if (ut_ct_lower_diag(src, "operand types `u32` and `Rc`") != 0) { bad = 1; }
    if (!ut_ct_lower_lacks(src, "and `Tp`"))                        { bad = 1; }

    if (!ut_ct_lower_clean("rec Rc { a: u32; b: u32; }\nvar g: Rc;\nfun walk[Tp](x: Tp) u32 { var acc: u32 = 0; $each f in $fields(Tp) { acc = acc + x.a; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { walk[Rc](g); ret 0; }\n")) { bad = 1; }

    if (ut_ct_lower_diag("rec Rc { a: ^u32; }\nvar g: Rc;\nfun walk[Tp](x: Tp) u32 { var acc: u32 = 0; $each f in $fields(Tp) { acc = acc + x.a; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { walk[Rc](g); ret 0; }\n",
        "expected u32, found ^u32") != 0) { bad = 1; }

    ret bad;
}

#[testing]
fun ut_fn_name_of(s: *session.Session, m: *ir.Module, needle: str, want_extern: bool) intern.StrId {
    if (m == nil) { ret intern.STR_NIL; }
    var fi: u32 = 0;
    for (fi < m.function_len) {
        val f: *ir.Function = ?m.functions[fi];
        if (((f.flags & ir.FN_FLAG_EXTERN) != 0) == want_extern) {
            val nm: opt[str] = intern.lookup(?s.interner, f.name);
            if (sel nm.some && ut_str_contains(nm.some, needle)) { ret f.name; }
        }
        fi = fi + 1;
    }
    ret intern.STR_NIL;
}

test linkage_name__dotted_shapes {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:   session.Session = sr.ok;
    var bad: i32             = 0;

    var names: [2]str;
    names[0] = "main.mach";
    names[1] = "lib.mach";
    var texts: [2]str;
    texts[1] = "pub rec Leaf { n: i64; }\npub rec Box[T] { v: T; }\npub def BinOp: fun(i64, i64) i64;\npub fun wrap[T](x: T) i64 { ret 0; }\npub fun pair[A, B](a: A, b: B) i64 { ret 0; }\npub fun plain(x: i64) i64 { ret x; }\npub fun tag($n: i64, x: i64) i64 { ret x + n; }\npub fun gsum[T](va: ...) i64 { var a: i64 = 0; $each e in va { a = a + 1; } ret a; }\n";
    texts[0] = "use uniontest.lib;\nfun main() i32 {\n    var l: lib.Leaf;\n    var bl: lib.Box[lib.Leaf];\n    var bbl: lib.Box[lib.Box[lib.Leaf]];\n    var arr: [4]u8;\n    var sec: ^u32 = 1;\n    var f: lib.BinOp = nil;\n    var acc: i64 = 0;\n    acc = acc + lib.wrap[lib.Leaf](l);\n    acc = acc + lib.wrap[lib.Box[lib.Leaf]](bl);\n    acc = acc + lib.wrap[lib.Box[lib.Box[lib.Leaf]]](bbl);\n    acc = acc + lib.wrap[*lib.Leaf](?l);\n    acc = acc + lib.wrap[[4]u8](arr);\n    acc = acc + lib.wrap[^u32](sec);\n    acc = acc + lib.wrap[lib.BinOp](f);\n    acc = acc + lib.pair[lib.Box[lib.Leaf], i64](bl, 1);\n    acc = acc + lib.pair[*lib.Box[lib.Leaf], u8](?bl, 2);\n    acc = acc + lib.plain(1);\n    acc = acc + lib.tag(7, 1);\n    acc = acc + lib.tag(-3, 1);\n    acc = acc + lib.gsum[u32](1, 2);\n    if (acc > 0) { ret 1; }\n    ret 0;\n}\n";

    val pr: res[project.Project, outcome.Fail] = ut_lower_n(?s, ?alloc, ?names[0], ?texts[0], 2);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    val m: *ir.Module = ut_ir_of(?p, ?s, "uniontest.main");

    if (ut_defined_fn_exact(?s, m, "uniontest.lib.wrap$uniontest.lib.Leaf") != 1)                                        { bad = 2; }
    if (ut_defined_fn_exact(?s, m, "uniontest.lib.wrap$uniontest.lib.Box$$uniontest.lib.Leaf") != 1)                     { bad = 3; }
    if (ut_defined_fn_exact(?s, m, "uniontest.lib.wrap$uniontest.lib.Box$$uniontest.lib.Box$$$uniontest.lib.Leaf") != 1) { bad = 4; }
    if (ut_defined_fn_exact(?s, m, "uniontest.lib.wrap$p$uniontest.lib.Leaf") != 1)                                      { bad = 5; }
    if (ut_defined_fn_exact(?s, m, "uniontest.lib.wrap$arr4$u8") != 1)                                                   { bad = 6; }
    if (ut_defined_fn_exact(?s, m, "uniontest.lib.wrap$sec$u32") != 1)                                                   { bad = 7; }
    if (ut_defined_fn_exact(?s, m, "uniontest.lib.wrap$fn$$i64$$i64$$i64") != 1)                                         { bad = 8; }
    if (ut_defined_fn_exact(?s, m, "uniontest.lib.pair$uniontest.lib.Box$$uniontest.lib.Leaf$i64") != 1)                 { bad = 9; }
    if (ut_defined_fn_exact(?s, m, "uniontest.lib.pair$p$uniontest.lib.Box$$uniontest.lib.Leaf$u8") != 1)                { bad = 10; }
    if (ut_defined_fn_exact(?s, m, "uniontest.lib.tag$7") != 1)                                                          { bad = 11; }
    if (ut_defined_fn_exact(?s, m, "uniontest.lib.tag$n3") != 1)                                                         { bad = 12; }
    if (ut_defined_fn_exact(?s, m, "uniontest.lib.gsum$u32$pack$i64$i64") != 1)                                          { bad = 13; }

    if (ut_defined_fn_count(?s, m, "uniontest.lib.wrap$") != 7) { bad = 14; }

    val lib_m:  *ir.Module   = ut_ir_of(?p, ?s, "uniontest.lib");
    val def_id: intern.StrId = ut_fn_name_of(?s, lib_m, ".plain", false);
    val ref_id: intern.StrId = ut_fn_name_of(?s, m, ".plain", true);
    if (def_id == intern.STR_NIL || def_id != ref_id)               { bad = 15; }
    if (ut_defined_fn_exact(?s, lib_m, "uniontest.lib.plain") != 1) { bad = 16; }

    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

test linkage_name__test_declaration {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "fun probe() i32 { ret 0; }\ntest probe { ret probe(); }\nfun main() i32 { ret probe(); }\n";

    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    var bad: i32                                = 0;
    val pr:  res[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
    if (sel pr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;
    p.req.goal = request.GOAL_TESTS;
    val run_sema_pass_r:    err[outcome.Fail] = driver.run_sema_pass(?p);
    val run_lower_pass_r:   err[outcome.Fail] = driver.run_lower_pass(?p);
    val run_codegen_pass_r: err[outcome.Fail] = driver.run_codegen_pass(?p);
    val run_test_pass_r:    err[outcome.Fail] = driver.run_test_pass(?p);
    if (sel run_sema_pass_r.err)    { bad = 1; }
    or (sel run_lower_pass_r.err)   { bad = 2; }
    or (sel run_codegen_pass_r.err) { bad = 3; }
    or (sel run_test_pass_r.err)    { bad = 4; }
    or {
        # the test is its qualified name in the test object; the function of the same
        # name is the normal object's
        val m:      *ir.Module       = ut_ir_of(?p, ?s, "uniontest.main");
        val mid:    session.ModuleId = ut_mid(?p, ?s, "uniontest.main");
        val tested: *ir.Module       = project.module_at(?p, mid::u32).test.ir_module;
        if (tested == nil)                                                { bad = 5; }
        or (ut_defined_fn_exact(?s, tested, "uniontest.main#probe") != 1) { bad = 6; }
        or (ut_defined_fn_exact(?s, tested, "uniontest.main.probe") != 0) { bad = 7; }
        if (ut_defined_fn_exact(?s, m, "uniontest.main.probe") != 1)      { bad = 8; }
        if (ut_defined_fn_exact(?s, m, "uniontest.main#probe") != 0)      { bad = 9; }
    }

    project.dnit_project(?p);
    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

#[testing]
fun ut_embed_diag(main_src: str, asset: str, needle: str) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [2]str;
    names[0] = "main.mach";
    names[1] = "asset.bin";
    var texts: [2]str;
    texts[0] = main_src;
    texts[1] = asset;

    val pr: res[project.Project, outcome.Fail] = ut_vec_sema_n(?s, ?alloc, ?names[0], ?texts[0], 2);
    if (sel pr.ok) {
        var p: project.Project = pr.ok;
        project.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }
    val hit: bool = outcome.is_reported(pr.err) && ut_diag_has(?s.diags, needle);
    session.dnit(?s);
    if (hit) { ret 0; }
    ret 1;
}

#[testing]
fun ut_embed_unreadable_diag() i32 {
    $if ($mach.build.os != $mach.os.linux) { ret 0; }

    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [2]str;
    names[0] = "main.mach";
    names[1] = "asset.bin";
    var texts: [2]str;
    texts[0] = "#[embed(\"asset.bin\")]\nval A: [_]u8;\nfun main() i32 { ret 0; }\n";
    texts[1] = "abc";

    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 2);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root:    str = root_r.ok;
    val src_dir: str = ut_cc3(?alloc, root, "/", "src");
    val a_path:  str = ut_cc3(?alloc, src_dir, "/", "asset.bin");

    val remove_file_r: err[io_error.Error] = fs.remove_file(a_path);
    if (sel remove_file_r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(a_path, "abc", 3::usize, 0);
    if (sel write_bytes_r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }

    val pr: res[project.Project, outcome.Fail] = ut_sema_build(?s, root);
    if (sel pr.ok) {
        var p: project.Project = pr.ok;
        project.dnit_project(?p);
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    val hit: bool = outcome.is_reported(pr.err) && ut_diag_has(?s.diags, "permission denied");
    fs.remove_all(?alloc, root);
    session.dnit(?s);
    if (hit) { ret 0; }
    ret 1;
}

#[testing]
rec UtEmbedCase {
    main:   str;
    needle: str;
}

# each embed refusal: the size against the annotation, a missing file and a directory, the
# declaration kind and annotation, the decorator's arguments, and a `[_]` outside an embed
#[testing]
val UT_EMBED_REFUSALS: [13]UtEmbedCase = [13]UtEmbedCase{
    UtEmbedCase{main: "#[embed(\"asset.bin\")]\nval A: [_]u8;\nfun main() i32 { val b: [9]u8 = A; ret b[0]::i32; }\n", needle: "found [3]u8"},
    UtEmbedCase{main: "#[embed(\"asset.bin\")]\nval A: [4]u8;\nfun main() i32 { ret A[0]::i32; }\n", needle: "declares 4 bytes but the file holds 3"},
    UtEmbedCase{main: "#[embed(\"nope.bin\")]\nval A: [_]u8;\nfun main() i32 { ret A[0]::i32; }\n", needle: "`embed` on `A` cannot read"},
    UtEmbedCase{main: "#[embed(\"nope.bin\")]\nval A: [_]u8;\nfun main() i32 { ret A[0]::i32; }\n", needle: "no such file or directory"},
    UtEmbedCase{main: "#[embed(\".\")]\nval A: [_]u8;\nfun main() i32 { ret A[0]::i32; }\n", needle: "is a directory"},
    UtEmbedCase{main: "#[embed(\"asset.bin\")]\nvar A: [_]u8;\nfun main() i32 { ret A[0]::i32; }\n", needle: "applies only to a `val`"},
    UtEmbedCase{main: "#[embed(\"asset.bin\")]\nval A: [_]u32;\nfun main() i32 { ret 0; }\n", needle: "element type must be `u8`"},
    UtEmbedCase{main: "#[embed(\"asset.bin\")]\nval A: u8;\nfun main() i32 { ret A::i32; }\n", needle: "must be annotated `[_]u8` or `[N]u8`"},
    UtEmbedCase{main: "#[embed()]\nval A: [_]u8;\nfun main() i32 { ret A[0]::i32; }\n", needle: "takes one string argument"},
    UtEmbedCase{main: "#[embed(\"asset.bin\")]\nfun f() i32 { ret 0; }\nfun main() i32 { ret f(); }\n", needle: "applies only to a `val`"},
    UtEmbedCase{main: "#[embed(\"asset.bin\")]\n#[embed(\"asset.bin\")]\nval A: [_]u8;\nfun main() i32 { ret A[0]::i32; }\n", needle: "only one `embed` decorator"},
    UtEmbedCase{main: "val A: [_]u8 = [1]u8{1};\nfun main() i32 { ret A[0]::i32; }\n", needle: "only valid on an `#[embed(...)]` declaration"},
    UtEmbedCase{main: "#[embed(\"asset.bin\")]\nval A: [_][_]u8;\nfun main() i32 { ret 0; }\n", needle: "element type must be `u8`"}
};

test embed__refusals {
    var i: usize = 0;
    for (i < 13) {
        if (ut_embed_diag(UT_EMBED_REFUSALS[i].main, "abc", UT_EMBED_REFUSALS[i].needle) != 0) { ret (i + 1)::i32; }
        i = i + 1;
    }
    if (ut_embed_unreadable_diag() != 0) { ret 20; }
    ret 0;
}

# a malformed embed annotation is reported once, never again as a `[_]` outside an embed,
# while a `[_]` local beside a failed embed still is
test embed__rejection_does_not_cascade {
    val needle: str = "only valid on an `#[embed(...)]` declaration";
    if (ut_embed_diag("#[embed(\"asset.bin\")]\nval A: [_][_]u8;\nfun main() i32 { ret 0; }\n", "abc", needle) == 0)           { ret 1; }
    if (ut_embed_diag("#[embed(\"asset.bin\")]\nval A: *[_]u8;\nfun main() i32 { ret 0; }\n", "abc", needle) == 0)             { ret 2; }
    if (ut_embed_diag("#[embed(\"asset.bin\")]\nval A: [3][_]u8;\nfun main() i32 { ret 0; }\n", "abc", needle) == 0)           { ret 3; }
    if (ut_embed_diag("#[embed(\"nope.bin\")]\nval A: [_]u8;\nfun main() i32 { var q: [_]u8; ret 0; }\n", "abc", needle) != 0) { ret 4; }
    ret 0;
}

#[testing]
fun ut_embed_escape_arm(alloc: *A.Allocator, escaped: bool) i32 {
    val sr: res[session.Session, fail.Fail] = session.init(alloc);
    if (sel sr.err) { ret 1; }
    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [2]str;
    names[0] = "main.mach";
    names[1] = "asset.bin";
    var texts: [2]str;
    texts[0] = "#[embed(\"asset.bin\")]\nval A: [_]u8;\nfun main() i32 { ret A[0]::i32; }\n";
    texts[1] = "abc";
    val root_r: res[str, fail.Fail] = ut_scaffold(alloc, ?names[0], ?texts[0], 2);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root:    str = root_r.ok;
    val outside: str = ut_cc3(alloc, root, "-outside", ".bin");
    if (escaped) {
        val leaf:          str             = path.filename(outside);
        val main_path:     str             = ut_cc3(alloc, root, "/src/", "main.mach");
        val src:           str             = ut_cc3(alloc, "#[embed(\"../../", leaf, "\")]\nval A: [_]u8;\nfun main() i32 { ret A[0]::i32; }\n");
        val write_bytes_r: err[fs.FsError] = fs.write_bytes(main_path, src, str_len(src), 420);
        if (sel write_bytes_r.err) {
            fs.remove_all(alloc, root);
            session.dnit(?s);
            ret 1;
        }
        val write_bytes_r2: err[fs.FsError] = fs.write_bytes(outside, "xyz", 3::usize, 420);
        if (sel write_bytes_r2.err) {
            fs.remove_all(alloc, root);
            session.dnit(?s);
            ret 1;
        }
    }

    var bad: i32                                = 0;
    val pr:  res[project.Project, outcome.Fail] = ut_sema_build(?s, root);
    if (escaped) {
        # refused at the decorator, and the outside file's bytes were never read
        if (sel pr.ok) {
            var p: project.Project = pr.ok;
            project.dnit_project(?p);
            bad = 1;
        }
        if (!ut_diag_has(?s.diags, "`embed` path escapes the project root"))                 { bad = 2; }
        if (!ut_diag_has(?s.diags, "must live inside the project and the file is not read")) { bad = 3; }
        val outside_r: res[intern.StrId, A.Error] = intern.intern(?s.interner, outside);
        if (sel outside_r.ok) {
            val cached: opt[*embed.EmbedFile] = embed.get(?s.embeds, outside_r.ok);
            if (sel cached.some) { bad = 4; }
        }
    }
    or {
        if (sel pr.err) { bad = 5; }
        if (sel pr.ok) {
            var p: project.Project = pr.ok;
            if (diagnostic.has_errors(?s.diags)) { bad = 6; }
            project.dnit_project(?p);
        }
    }
    if (escaped) { fs.remove_file(outside); }
    fs.remove_all(alloc, root);
    session.dnit(?s);
    ret bad;
}

# an embed outside the project root is a refusal that never reads the file
test embed__outside_the_project_root_is_refused_unread {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val escaped: i32 = ut_embed_escape_arm(?alloc, true);
    if (escaped != 0) { ret 10 + escaped; }
    val inside: i32 = ut_embed_escape_arm(?alloc, false);
    if (inside != 0) { ret 20 + inside; }
    ret 0;
}

#[testing]
fun ut_probe_bad_zero_ret(m: *ir.Module) i32 {
    var fi: u32 = 0;
    for (fi < m.function_len) {
        val fn: *ir.Function = ?m.functions[fi];
        var ii: u32          = 0;
        for (ii < fn.instr_len) {
            val inst: *instruction.Instruction = ?fn.instrs[ii];
            if (inst.kind == instruction.OP_RET && inst.operand_count > 0) {
                val op: value.Value = inst.operands[0];
                if (op.kind == value.VAL_CONST_INT) {
                    if (ir_type.is_aggregate(?m.types, op.ty))    { ret 1; }
                    if (ir_type.is_float_scalar(?m.types, op.ty)) { ret 1; }
                }
            }
            ii = ii + 1;
        }
        fi = fi + 1;
    }
    ret 0;
}

#[testing]
fun ut_agg_address_rets(m: *ir.Module) u32 {
    var n:  u32 = 0;
    var fi: u32 = 0;
    for (fi < m.function_len) {
        val fn: *ir.Function = ?m.functions[fi];
        var ii: u32          = 0;
        for (ii < fn.instr_len) {
            val inst: *instruction.Instruction = ?fn.instrs[ii];
            if (inst.kind == instruction.OP_RET && inst.operand_count > 0) {
                val op: value.Value = inst.operands[0];
                if (!value.is_constant(op) && ir_type.is_aggregate(?m.types, op.ty)) { n = n + 1; }
            }
            ii = ii + 1;
        }
        fi = fi + 1;
    }
    ret n;
}

#[testing]
fun ut_fn_ret_count(m: *ir.Module, itn: *intern.Interner, want: str) i64 {
    var fi: u32 = 0;
    for (fi < m.function_len) {
        val fn: *ir.Function = ?m.functions[fi];
        val nm: opt[str]     = intern.lookup(itn, fn.disp);
        if (sel nm.some && str_equals(nm.some, want)) {
            var n:  i64 = 0;
            var ii: u32 = 0;
            for (ii < fn.instr_len) {
                if (fn.instrs[ii].kind == instruction.OP_RET) { n = n + 1; }
                ii = ii + 1;
            }
            ret n;
        }
        fi = fi + 1;
    }
    ret -1;
}

test fallthrough_return__is_well_typed {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "rec P { a: u64; b: u64; }\nfun rec_loop() P { var p: P; for { p.a = 1; ret p; } }\nfun f64_loop() f64 { var i: i64 = 0; for { i = i + 1; ret 1.5; } }\nfun u64_loop() u64 { var i: u64 = 0; for { i = i + 1; ret i; } }\nfun rec_fall() P { var p: P; p.a = 1; }\nfun f64_fall() f64 { var i: i64 = 0; i = i + 1; }\nfun main() i32 { var a: P = rec_loop(); var b: P = rec_fall(); ret (a.a + b.a + u64_loop())::i32; }\n";

    val pr: res[project.Project, outcome.Fail] = ut_build(?s, ?alloc, ?names[0], ?texts[0], 1);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    val run_sema_pass_r: err[outcome.Fail] = driver.run_sema_pass(?p);
    if (sel run_sema_pass_r.err) {
        project.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }
    val run_lower_pass_r: err[outcome.Fail] = driver.run_lower_pass(?p);
    if (sel run_lower_pass_r.err) {
        project.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }

    var bad: i32              = 1;
    val mid: session.ModuleId = ut_mid(?p, ?s, "uniontest.main");
    if (mid != session.MODULE_NIL) {
        val m: *project.ModuleEntry = project.module_at(?p, mid::u32);
        if (m.ir_module != nil) {
            bad = ut_probe_bad_zero_ret(m.ir_module);
            if (ut_agg_address_rets(m.ir_module) == 0)                      { bad = 1; }
            if (ut_fn_ret_count(m.ir_module, ?s.interner, "rec_loop") != 1) { bad = 1; }
        }
    }

    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

test comptime_gate__reads_a_float_at_its_width {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "val K: f32 = 16777217.0;\n$if (K - 16777216.0 == 0.0) { val G: i64 = 1; }\n$or { val G: i64 = 0; }\nval K64: f64 = 16777217.0;\n$if (K64 - 16777216.0 == 0.0) { val G64: i64 = 1; }\n$or { val G64: i64 = 0; }\nval P: f32 = 0.1;\n$if (P > 0.1) { val GT: i64 = 1; }\n$or { val GT: i64 = 0; }\nval P64: f64 = 0.1;\n$if (P64 > 0.1) { val GT64: i64 = 1; }\n$or { val GT64: i64 = 0; }\nfun main() i32 { ret 0; }\n";

    val pr: res[project.Project, outcome.Fail] = ut_lower_n(?s, ?alloc, ?names[0], ?texts[0], 1);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    var bad: i32        = 0;
    val m:   *ir.Module = ut_ir_of(?p, ?s, "uniontest.main");
    if (m == nil) { bad = 1; }
    or {
        val gg: i64 = ut_global_ix(?s, m, "uniontest.main.G");
        if (gg < 0) { bad = 1; }
        or {
            if ((?m.globals[gg::u32]).init.data.int_lit != 1) { bad = 1; }
        }

        val gg64: i64 = ut_global_ix(?s, m, "uniontest.main.G64");
        if (gg64 < 0) { bad = 1; }
        or {
            if ((?m.globals[gg64::u32]).init.data.int_lit != 0) { bad = 1; }
        }

        val gt: i64 = ut_global_ix(?s, m, "uniontest.main.GT");
        if (gt < 0) { bad = 1; }
        or {
            if ((?m.globals[gt::u32]).init.data.int_lit != 0) { bad = 1; }
        }

        val gt64: i64 = ut_global_ix(?s, m, "uniontest.main.GT64");
        if (gt64 < 0) { bad = 1; }
        or {
            if ((?m.globals[gt64::u32]).init.data.int_lit != 0) { bad = 1; }
        }
    }

    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

# the C-variadic promotion contract is re-checked at each instance, through a chain of
# generic calls and a mutual recursion, and an error inside a generic chain is reported once
test c_variadic__promotion_checked_through_generic_calls {
    val promote: str = "is promoted to a 32-bit integer in a C-variadic argument";
    val decls:   str = "ext fun printf(fmt: *u8, ...) i32;\nfun log1[A](fmt: *u8, a: A) i32 { ret printf(fmt, a); }\n";
    if (ut_vec_diag(ut_cc_src(decls, "fun use_it() i32 { var c: u8 = 65; ret log1[u8](\"%d\\n\", c); }\n"), promote) != 0)                                 { ret 1; }
    if (ut_vec_diag(ut_cc_src(decls, "fun use_it() i32 { ret log1[f32](\"%f\\n\", 1.5::f32); }\n"), "is promoted to `f64` in a C-variadic argument") != 0) { ret 2; }
    if (!ut_sema_clean(ut_cc_src(decls, "fun use_it() i32 { ret log1[i32](\"%d\\n\", 7::i32) + log1[f64](\"%f\\n\", 2.5); }\n")))                          { ret 3; }

    val d2: str = "ext fun printf(fmt: *u8, ...) i32;\nfun log2[A, B](fmt: *u8, a: A, b: B) i32 { ret printf(fmt, a, b); }\n";
    if (ut_vec_diag(ut_cc_src(d2, "fun use_it() i32 { var c: u8 = 65; ret log2[i32, u8](\"%d %d\\n\", 1::i32, c); }\n"), promote) != 0) { ret 4; }

    val chain: str = "ext fun printf(fmt: *u8, ...) i32;\nfun log1[A](fmt: *u8, a: A) i32 { ret printf(fmt, a); }\nfun wrap2[A](fmt: *u8, a: A) i32 { ret log1[A](fmt, a); }\nfun wrap3[A](fmt: *u8, a: A) i32 { ret wrap2[A](fmt, a); }\n";
    if (ut_vec_diag(ut_cc_src(chain, "fun use_it() i32 { var c: u8 = 65; ret wrap3[u8](\"%d\\n\", c); }\n"), promote) != 0) { ret 5; }
    if (!ut_sema_clean(ut_cc_src(chain, "fun use_it() i32 { ret wrap3[i32](\"%d\\n\", 7::i32); }\n")))                      { ret 6; }

    val mutual: str = "ext fun printf(fmt: *u8, ...) i32;\nfun ping[A](n: i32, a: A) i32 { if (n <= 0) { ret printf(\"%d\\n\", a); } ret pong[A](n - 1, a); }\nfun pong[A](n: i32, a: A) i32 { ret ping[A](n - 1, a); }\n";
    if (ut_vec_diag(ut_cc_src(mutual, "fun use_it() i32 { var c: u8 = 65; ret ping[u8](4, c); }\n"), promote) != 0) { ret 7; }
    if (!ut_sema_clean(ut_cc_src(mutual, "fun use_it() i32 { ret ping[i32](4, 7::i32); }\n")))                      { ret 8; }

    if (ut_sema_errs("fun leaf[U](v: U) u32 { var acc: *u8 = nil; acc = 7; ret 0; }\nfun mid[T](v: T) u32 { ret leaf[T](v); }\nfun top[T](v: T) u32 { ret mid[T](v); }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { top[u32](1); ret 0; }\n") != 1) { ret 9; }
    ret 0;
}

test comptime_gate__cast_resolves_local_and_imported_aliases {
    ret ut_single_ok2(
        "use Flag: uniontest.lib.Flag;\ndef Local: u8;\n$if ((1::Local) == 1u8) { fun local_selected() i32 { ret 1; } } $or { use uniontest.missing; }\n$if ((0::Flag) == 1u8) { use uniontest.missing; } $or { fun imported_selected() i32 { ret 2; } }\nfun main() i32 { ret local_selected() + imported_selected(); }\n",
        "pub def Flag: u8;\n");
}

#[testing]
fun ut_deprecated_notices(names: *str, texts: *str, count: u32, expected: u32, decoded: str) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val initialized: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel initialized.err) { ret 2; }
    var s: session.Session = initialized.ok;
    fin { session.dnit(?s); }
    val built: res[project.Project, outcome.Fail] = ut_build(?s, ?alloc, names, texts, count);
    if (sel built.err) { ret 3; }
    var p: project.Project = built.ok;
    fin { project.dnit_project(?p); }
    val run_sema_pass_r: err[outcome.Fail] = driver.run_sema_pass(?p);
    if (sel run_sema_pass_r.err)         { ret 4; }
    if (diagnostic.has_errors(?s.diags)) { ret 5; }
    var notices:     u32   = 0;
    var saw_decoded: bool  = str_len(decoded) == 0;
    var i:           usize = 0;
    for (i < diagnostic.len(?s.diags)) {
        val d: *diagnostic.Diagnostic = ?s.diags.items.data[i];
        if (d.severity == diagnostic.SEVERITY_WARNING && ut_str_contains(d.message, "is deprecated")) {
            val file: opt[*src.SourceFile] = src.get(?s.sources, d.loc.file_id);
            if (sel file.none)                         { ret 6; }
            if (!str_equals(file.some.text, texts[0])) { ret 6; }
            val span: token.Span = d.loc.span;
            if (span.len == 0 || span.offset + span.len > str_len(texts[0])) { ret 7; }
            var j: usize = 0;
            for (j < span.len) {
                val c: u8 = texts[0][span.offset + j];
                if (c == '.' || c == '[' || c == '(' || c == '{' || c == ' ') { ret 8; }
                j = j + 1;
            }
            j = 0;
            for (j < i) {
                val prior: *diagnostic.Diagnostic = ?s.diags.items.data[j];
                if (prior.severity == diagnostic.SEVERITY_WARNING && ut_str_contains(prior.message, "is deprecated")
                    && prior.loc.file_id == d.loc.file_id && prior.loc.span.offset == span.offset) { ret 9; }
                j = j + 1;
            }
            if (ut_str_contains(d.message, decoded)) { saw_decoded = true; }
            notices = notices + 1;
        }
        i = i + 1;
    }
    if (notices != expected || !saw_decoded) { ret 10; }
    ret 0;
}

test deprecated__external_sites_decode_and_count_generics_once {
    var names: [2]str = [2]str{"main.mach", "api.mach"};
    var texts: [2]str;
    texts[0] = "use uniontest.api;\nfun local[T](x: T) i32 { ret api.CONST; }\nfun main() i32 { var r: api.OldRec; var u: api.OldUni; val n: api.OldId = 0; ret api.old[i32](1) + api.old[i64](2)::i32 + api.CONST + api.mutable + local[i32](1) + local[i64](2); }\n";
    texts[1] = "#[deprecated(\"use \\\"new\\\"\\nnext\")]\npub fun old[T](x: T) T { ret x; }\n#[deprecated]\npub rec OldRec { n: i32; }\n#[deprecated]\npub uni OldUni { n: i32; }\n#[deprecated]\npub def OldId: i32;\n#[deprecated]\npub val CONST: i32 = 1;\n#[deprecated]\npub var mutable: i32 = 2;\nfun own() i32 { var r: OldRec; var u: OldUni; val n: OldId = 0; ret old[i32](CONST) + mutable; }\n";
    ret ut_deprecated_notices(?names[0], ?texts[0], 2, 8, "use \"new\"\nnext");
}

test deprecated__reexports_keep_their_owner_and_spare_clean_aliases {
    var names: [4]str = [4]str{"main.mach", "mid.mach", "leaf.mach", "bridge.mach"};
    var texts: [4]str;
    texts[0] = "use uniontest.mid;\nuse alias: uniontest.mid.retired;\nuse clean: uniontest.mid.clean;\nuse uniontest.bridge;\nfun main() i32 { ret mid.clean() + mid.retired() + alias() + bridge.retired() + mid.clean(); }\n";
    texts[1] = "#[deprecated(\"use clean\")]\nfwd retired: uniontest.leaf.current;\nfwd clean: uniontest.leaf.current;\npub fun own() i32 { ret retired(); }\n";
    texts[2] = "pub fun current() i32 { ret 0; }\n";
    texts[3] = "fwd uniontest.mid.retired;\n";
    val first: i32 = ut_deprecated_notices(?names[0], ?texts[0], 4, 3, "use clean");
    if (first != 0) { ret first; }
    texts[0] = "use uniontest.mid;\nuse clean: uniontest.mid.clean;\nuse alias: uniontest.mid.retired;\nuse uniontest.bridge;\nfun main() i32 { ret mid.retired() + mid.clean() + alias() + bridge.retired() + mid.clean(); }\n";
    ret ut_deprecated_notices(?names[0], ?texts[0], 4, 3, "use clean");
}

# 0 when main builds without error and warns `unused import` exactly at `unused`, or not at all when it
# is empty. the project depends on `leaf`, whose own unused import is never reported
#[testing]
fun ut_unused_import(main: str, unused: str) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val initialized: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel initialized.err) { ret 2; }
    var s: session.Session = initialized.ok;
    fin { session.dnit(?s); }
    var names:    [2]str              = [2]str{"main.mach", "lib.mach"};
    var texts:    [2]str              = [2]str{main, "pub fun f() i32 { ret 1; }\npub val ON: u8 = 1;\n"};
    val consumer: str                 = ut_cc3(?alloc, ut_manifest(), "\n[dep.leaf]\npath = \"dep/leaf\"\n", "");
    val scaffold: res[str, fail.Fail] = ut_scaffold_m(?alloc, consumer, ?names[0], ?texts[0], 2);
    if (sel scaffold.err) { ret 3; }
    val root: str = scaffold.ok;
    fin { fs.remove_all(?alloc, root); }
    val dep_src: str             = ut_cc3(?alloc, root, "/", "dep/leaf/src");
    val made:    err[fs.FsError] = fs.create_dir_all(?alloc, dep_src, 493);
    if (sel made.err) { ret 3; }
    val dep_manifest: str             = ut_lib_manifest(?alloc, "leaf");
    val dep_lib:      str             = "use leaf.util.u;\npub fun plain() i32 { ret 0; }\n";
    val dep_util:     str             = "pub fun u() i32 { ret 1; }\n";
    val w0:           err[fs.FsError] = fs.write_bytes(ut_cc3(?alloc, root, "/dep/leaf/", manifest.MANIFEST_FILE), dep_manifest, str_len(dep_manifest), 420);
    val w1:           err[fs.FsError] = fs.write_bytes(ut_cc3(?alloc, dep_src, "/", "lib.mach"), dep_lib, str_len(dep_lib), 420);
    val w2:           err[fs.FsError] = fs.write_bytes(ut_cc3(?alloc, dep_src, "/", "util.mach"), dep_util, str_len(dep_util), 420);
    if (sel w0.err) { ret 3; }
    if (sel w1.err) { ret 3; }
    if (sel w2.err) { ret 3; }
    val registry: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel registry.err) { ret 3; }
    val built: res[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
    if (sel built.err) { ret 3; }
    var p: project.Project = built.ok;
    fin { project.dnit_project(?p); }
    val checked: err[outcome.Fail] = driver.run_sema_pass(?p);
    if (sel checked.err)                 { ret 4; }
    if (diagnostic.has_errors(?s.diags)) { ret 5; }
    var warned: u32   = 0;
    var i:      usize = 0;
    for (i < diagnostic.len(?s.diags)) {
        val d: *diagnostic.Diagnostic = ?s.diags.items.data[i];
        if (d.severity == diagnostic.SEVERITY_WARNING && ut_str_contains(d.message, "unused import")) {
            val file: opt[*src.SourceFile] = src.get(?s.sources, d.loc.file_id);
            if (sel file.none)                                                       { ret 6; }
            if (!str_equals(file.some.text, main))                                   { ret 7; }
            if (!str_region_equals(main, d.loc.span.offset, d.loc.span.len, unused)) { ret 8; }
            warned = warned + 1;
        }
        i = i + 1;
    }
    if (str_len(unused) == 0 && warned != 0) { ret 9; }
    if (str_len(unused) != 0 && warned != 1) { ret 10; }
    ret 0;
}

test resolve__unused_symbol_imports_warn_and_module_imports_never_do {
    if (ut_unused_import("use uniontest.lib.f;\nfun main() i32 { ret 0; }\n", "f") != 0)                                                      { ret 1; }
    if (ut_unused_import("use g: uniontest.lib.f;\nuse uniontest.lib.ON;\nfun main() i32 { ret ON::i32; }\n", "g") != 0)                      { ret 2; }
    if (ut_unused_import("use uniontest.lib;\nuse other: uniontest.lib;\nfun main() i32 { ret 0; }\n", "") != 0)                              { ret 3; }
    if (ut_unused_import("use uniontest.lib.f;\nval C: u8 = 0;\n$if (C) { fun g() i32 { ret f(); } }\nfun main() i32 { ret 0; }\n", "") != 0) { ret 4; }
    if (ut_unused_import("use uniontest.lib.f;\nval C: u8 = 0;\nfun main() i32 { $if (C) { ret f(); } ret 0; }\n", "") != 0)                  { ret 5; }
    if (ut_unused_import("use leaf.lib.plain;\nfun main() i32 { ret plain(); }\n", "") != 0)                                                  { ret 6; }
    ret 0;
}

test deprecated__refuses_malformed_arguments {
    if (!ut_sema_rejects_with("#[deprecated(1)]\nfun old() {}\nfun main() i32 { ret 0; }\n", "message must be a string literal"))                                                                      { ret 1; }
    if (!ut_sema_rejects_with("#[deprecated(\"a\", \"b\")]\nfun old() {}\nfun main() i32 { ret 0; }\n", "takes zero or one string literal"))                                                           { ret 2; }
    if (!ut_sema_rejects_with("#[deprecated]\n#[deprecated(\"again\")]\nfun old() {}\nfun main() i32 { ret 0; }\n", "may appear only once"))                                                           { ret 3; }
    if (!ut_sema_rejects_with("#[deprecated]\ntest unsupported { ret 0; }\nfun main() i32 { ret 0; }\n", "applies only to fun, rec, uni, tag, def, val, var, use, or fwd declarations and tag cases")) { ret 4; }
    if (!ut_sema_rejects_with("tag Reply: u8 { #[inline] empty; value: i64; }\nfun main() i32 { ret 0; }\n", "a tag case takes only the `deprecated` decorator"))                                      { ret 5; }
    if (!ut_sema_rejects_with("tag Reply: u8 { #[deprecated(2)] empty; value: i64; }\nfun main() i32 { ret 0; }\n", "message must be a string literal"))                                               { ret 6; }
    if (!ut_sema_rejects_with("tag Reply: u8 { #[deprecated] #[deprecated] empty; value: i64; }\nfun main() i32 { ret 0; }\n", "may appear only once"))                                                { ret 7; }
    ret 0;
}

# a deprecated tag, generic tag and ext fun warn once per external site, and a deprecated
# tag case warns at construction, `sel` and payload places, `$cases` included
test deprecated__tags_cases_and_ext_funs_warn_once_per_site {
    var names: [2]str = [2]str{"main.mach", "api.mach"};
    var texts: [2]str;
    texts[0] = "use uniontest.api;\nfun main() i32 { var r: api.Reply = api.Reply.value{1}; var b: api.Box[i32] = api.Box[i32].some{2}; if (sel r.value) { if (sel b.some) { ret r.value::i32 + b.some + api.exit_code(); } } ret 0; }\n";
    texts[1] = "#[deprecated(\"tag gone\")]\npub tag Reply: u8 { empty; value: i64; }\n#[deprecated]\npub tag Box[T]: u8 { none; some: T; }\n#[deprecated(\"ext gone\")]\npub ext fun exit_code() i32;\nfun own() i32 { var r: Reply = Reply.value{1}; var b: Box[i32] = Box[i32].some{2}; if (sel r.value) { if (sel b.some) { ret r.value::i32 + b.some + exit_code(); } } ret 0; }\n";
    val decls: i32 = ut_deprecated_notices(?names[0], ?texts[0], 2, 5, "tag gone");
    if (decls != 0) { ret decls; }
    texts[0] = "use uniontest.api;\nfun main() i32 { var r: api.Reply = api.Reply.value{1}; var b: api.Box[i32] = api.Box[i32].some{2}; var f: api.Reply = api.Reply.fresh{3}; if (sel r.value) { if (sel b.some) { if (sel f.fresh) { ret r.value::i32 + b.some + f.fresh::i32; } } } $each c in $cases(api.Reply) { if (sel r.[c]) { ret 1; } } ret 0; }\n";
    texts[1] = "pub tag Reply: u8 { empty; #[deprecated(\"use fresh\")] value: i64; fresh: i64; }\npub tag Box[T]: u8 { none; #[deprecated] some: T; }\nfun own() i32 { var r: Reply = Reply.value{1}; var b: Box[i32] = Box[i32].some{2}; if (sel r.value) { if (sel b.some) { ret r.value::i32 + b.some; } } ret 0; }\n";
    val cases: i32 = ut_deprecated_notices(?names[0], ?texts[0], 2, 6, "use fresh");
    if (cases != 0) { ret 30 + cases; }
    ret 0;
}

# a deprecated leaf identifier written after a line comment inside a dotted type path is
# reported at the identifier itself, never at the comment's dot
test deprecated__dotted_type_locates_the_leaf_after_a_comment {
    var names: [2]str = [2]str{"main.mach", "api.mach"};
    var texts: [2]str;
    texts[0] = "use uniontest.api;\nfun stale() api.  # a note. with dots\n    Old { ret api.Old.empty{}; }\n";
    texts[1] = "#[deprecated(\"tag gone\")]\npub tag Old: u8 { empty; }\n";
    val counted: i32 = ut_deprecated_notices(?names[0], ?texts[0], 2, 2, "tag gone");
    if (counted != 0) { ret counted; }
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 20; }
    val initialized: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel initialized.err) { ret 21; }
    var s: session.Session = initialized.ok;
    fin { session.dnit(?s); }
    val built: res[project.Project, outcome.Fail] = ut_build(?s, ?alloc, ?names[0], ?texts[0], 2);
    if (sel built.err) { ret 22; }
    var p: project.Project = built.ok;
    fin { project.dnit_project(?p); }
    val run_sema_pass_r: err[outcome.Fail] = driver.run_sema_pass(?p);
    if (sel run_sema_pass_r.err) { ret 23; }
    # the return-type leaf is the `Old` that opens line 3 after four spaces
    val line3:       usize = str_len("use uniontest.api;\nfun stale() api.  # a note. with dots\n");
    val leaf_offset: usize = line3 + 4;
    var located:     bool  = false;
    var i:           usize = 0;
    for (i < diagnostic.len(?s.diags)) {
        val d: *diagnostic.Diagnostic = ?s.diags.items.data[i];
        if (d.severity == diagnostic.SEVERITY_WARNING && ut_str_contains(d.message, "is deprecated")
            && d.loc.span.offset == leaf_offset && d.loc.span.len == 3) {
            val file: opt[*src.SourceFile] = src.get(?s.sources, d.loc.file_id);
            if (sel file.none) { ret 24; }
            val pos: src.Position = src.position(file.some, d.loc.span.offset);
            if (pos.line != 3 || pos.col != 5) { ret 24; }
            located = true;
        }
        i = i + 1;
    }
    if (!located) { ret 25; }
    ret 0;
}
