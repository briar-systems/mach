# a renamed re-export links across the module boundary whichever order its names are imported in
test fwd__renamed_reexport_links {
    val qualified: i32 = ut_fwd_renamed_links("use uniontest.mid;\nfun main() i32 { ret mid.renamed_alias() - mid.original_name(); }\n");
    if (qualified != 0) { ret 10 + qualified; }
    val leaves: i32 = ut_fwd_renamed_links("use uniontest.mid.renamed_alias;\nuse uniontest.mid.original_name;\nfun main() i32 { ret renamed_alias() - original_name(); }\n");
    if (leaves != 0) { ret 20 + leaves; }
    ret 0;
}

#[testing]
fun ut_arith_operand_mismatches(text: str) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret -1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret -1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = text;

    val pr: res[project.Project, outcome.Fail] = ut_build(?s, ?alloc, ?names[0], ?texts[0], 1);
    if (sel pr.err) {
        session.dnit(?s);
        ret -1;
    }
    var p: project.Project = pr.ok;

    var out: i32               = -1;
    val sem: err[outcome.Fail] = driver.run_sema_pass(?p);
    if (sel sem.ok && ut_count_errors(?s.diags) == 0) {
        val low: err[outcome.Fail] = driver.run_lower_pass(?p);
        if (sel low.ok && ut_count_errors(?s.diags) == 0) {
            var arith:      u32 = 0;
            var mismatched: u32 = 0;
            var ti:         u32 = 0;
            for (ti < p.topo_len) {
                val m: *ir.Module = project.module_at(?p, p.topo[ti]::u32).ir_module;
                if (m != nil) {
                    var fi: u32 = 0;
                    for (fi < m.function_len) {
                        val fn: *ir.Function = ?m.functions[fi];
                        var ii: u32          = 0;
                        for (ii < fn.instr_len) {
                            val ins: *instruction.Instruction = ?fn.instrs[ii];
                            if (ins.kind == instruction.OP_ADD || ins.kind == instruction.OP_SUB
                                || ins.kind == instruction.OP_MUL || ins.kind == instruction.OP_DIV_S
                                || ins.kind == instruction.OP_DIV_U) {
                                arith = arith + 1;
                                var oi: u32 = 0;
                                for (oi < ins.operand_count) {
                                    if (ins.operands[oi].ty != ins.ty) { mismatched = mismatched + 1; }
                                    oi = oi + 1;
                                }
                            }
                            ii = ii + 1;
                        }
                        fi = fi + 1;
                    }
                }
                ti = ti + 1;
            }
            out = mismatched::i32;
            if (arith == 0) { out = -2; }
        }
    }

    project.dnit_project(?p);
    session.dnit(?s);
    ret out;
}

# a `val` refuses assignment directly, into a field or element, locally and through an
# import; a `var`, a parameter and a store through a pointer stay clean
test val__assignment_is_refused {
    if (!ut_sema_rejects_with("val i: i32 = 0;\nfun main() i32 { i = 2; ret 0; }\n", "cannot assign to `i`: a `val` is immutable"))                                                                                                                                                                                                                         { ret 1; }
    if (!ut_sema_rejects_with("fun main() i32 { val x: i32 = 0; x = 2; ret x; }\n", "cannot assign to `x`: a `val` is immutable"))                                                                                                                                                                                                                          { ret 2; }
    if (!ut_sema_rejects_with("rec P { a: i32; }\nval g: P = P{ a: 1 };\nfun main() i32 { g.a = 9; ret 0; }\n", "cannot assign into `g`: a `val` is immutable"))                                                                                                                                                                                            { ret 3; }
    if (!ut_sema_rejects_with("val arr: [2]i32 = [2]i32{1, 2};\nfun main() i32 { arr[1] = 9; ret 0; }\n", "cannot assign into `arr`: a `val` is immutable"))                                                                                                                                                                                                { ret 4; }
    if (!ut_sema_rejects_with("rec P { a: i32; }\nfun main() i32 { val r: P = P{ a: 1 }; r.a = 9; ret 0; }\n", "cannot assign into `r`: a `val` is immutable"))                                                                                                                                                                                             { ret 5; }
    if (ut_vec_diag2("use uniontest.lib;\nfun main() i32 { lib.K = 1; ret 0; }\n", "pub val K: i32 = 7;\n", "cannot assign to `K`: a `val` is immutable") != 0)                                                                                                                                                                                             { ret 6; }
    if (!ut_sema_clean2("use uniontest.lib;\nfun main() i32 { lib.M = 1; ret 0; }\n", "pub var M: i32 = 7;\n"))                                                                                                                                                                                                                                             { ret 7; }
    if (!ut_sema_clean("rec P { a: i32; }\nvar gv: i32 = 0;\nvar gr: P = P{ a: 1 };\nvar ga: [2]i32 = [2]i32{1, 2};\nval kv: i32 = 7;\nfun f(n: i32) i32 { n = 1; ret n; }\nfun main() i32 { gv = kv; gr.a = 2; ga[1] = 3; var lv: i32 = 0; lv = gv; val p: *i32 = ?gv; @p = 4; val pr: *P = ?gr; pr.a = 5; val pa: *i32 = ?ga[0]; pa[1] = 6; ret 0; }\n")) { ret 8; }
    ret 0;
}

test condition__requires_u8 {
    var bad: i32 = 0;
    if (!ut_sema_clean("fun f(a: u8, b: u8) u8 { if (a) { ret !b; } for (b) { ret a && b; } ret a || b; }\nfun main() i32 { ret 0; }\n"))                  { bad = 1; }
    if (!ut_sema_rejects_with("fun f(a: u16) i32 { if (a) { ret 1; } ret 0; }\nfun main() i32 { ret 0; }\n", "condition must have type u8"))               { bad = 1; }
    if (!ut_sema_rejects_with("fun f(a: i8) i32 { for (a) { ret 1; } ret 0; }\nfun main() i32 { ret 0; }\n", "condition must have type u8"))               { bad = 1; }
    if (!ut_sema_rejects_with("fun f(a: u8, b: u32) u8 { ret a && b; }\nfun main() i32 { ret 0; }\n", "logical operands must have type u8"))               { bad = 1; }
    if (!ut_sema_rejects_with("fun f(a: u32) u8 { ret !a; }\nfun main() i32 { ret 0; }\n", "unary ! requires a u8 operand"))                               { bad = 1; }
    if (!ut_sema_rejects_with("fun none() {}\nfun f() i32 { if (none()) { ret 1; } ret 0; }\nfun main() i32 { ret 0; }\n", "condition must have type u8")) { bad = 1; }
    if (!ut_sema_rejects_with("fun none() {}\nfun f(a: u8) u8 { ret none() && a; }\nfun main() i32 { ret 0; }\n", "logical operands must have type u8"))   { bad = 1; }
    if (!ut_sema_rejects_with("fun none() {}\nfun f(a: u8) u8 { ret a || none(); }\nfun main() i32 { ret 0; }\n", "logical operands must have type u8"))   { bad = 1; }
    if (!ut_sema_rejects_with("fun none() {}\nfun f() u8 { ret !none(); }\nfun main() i32 { ret 0; }\n", "unary ! requires a u8 operand"))                 { bad = 1; }
    ret bad;
}

#[testing]
fun ut_condition_truth_ops(text: str, cbrs: *u32, nots: *u32) bool {
    @cbrs = 0;
    @nots = 0;
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret false; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret false; }
    var s:     session.Session = sr.ok;
    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = text;
    val pr: res[project.Project, outcome.Fail] = ut_build(?s, ?alloc, ?names[0], ?texts[0], 1);
    if (sel pr.err) {
        session.dnit(?s);
        ret false;
    }
    var p:                project.Project   = pr.ok;
    val run_sema_pass_r:  err[outcome.Fail] = driver.run_sema_pass(?p);
    val run_lower_pass_r: err[outcome.Fail] = driver.run_lower_pass(?p);
    if (sel run_sema_pass_r.err) {
        project.dnit_project(?p);
        session.dnit(?s);
        ret false;
    }
    if (sel run_lower_pass_r.err) {
        project.dnit_project(?p);
        session.dnit(?s);
        ret false;
    }
    var ok: bool = true;
    var mi: u32  = 0;
    for (mi < project.module_count(?p)) {
        val m: *ir.Module = project.module_at(?p, mi).ir_module;
        if (m == nil) {
            mi = mi + 1;
            cnt;
        }
        var fi: u32 = 0;
        for (fi < m.function_len) {
            val fn: *ir.Function = ?m.functions[fi];
            var ii: u32          = 0;
            for (ii < fn.instr_len) {
                var ins:     *instruction.Instruction = ?fn.instrs[ii];
                var inspect: bool                     = false;
                if (ins.kind == instruction.OP_CBR && ins.operand_count == 3) {
                    @cbrs = @cbrs + 1;
                    if (ins.operands[0].kind != value.VAL_INSTR) { ok = false; }
                    or {
                        val cmp: *instruction.Instruction = ?fn.instrs[ins.operands[0].data.instr];
                        inspect = cmp.kind == instruction.OP_CMP_EQ;
                        ins     = cmp;
                    }
                }
                or (ins.kind == instruction.OP_CMP_NE) {
                    inspect = true;
                    @nots   = @nots + 1;
                }
                if (inspect) {
                    if (ins.operand_count != 2) { ok = false; }
                    or {
                        val a_one: bool = ins.operands[0].kind == value.VAL_CONST_INT && ins.operands[0].data.int_lit == 1;
                        val b_one: bool = ins.operands[1].kind == value.VAL_CONST_INT && ins.operands[1].data.int_lit == 1;
                        if (!a_one && !b_one) { ok = false; }
                    }
                }
                ii = ii + 1;
            }
            fi = fi + 1;
        }
        mi = mi + 1;
    }
    project.dnit_project(?p);
    session.dnit(?s);
    ret ok;
}

test condition__truth_is_a_compare_with_one {
    val text: str = "fun choose(v: u8) u8 { if (v) { ret 1; } ret 0; }\nfun repeat(v: u8) u8 { for (v) { ret 1; } ret 0; }\nfun both(a: u8, b: u8) u8 { ret a && b; }\nfun either(a: u8, b: u8) u8 { ret a || b; }\nfun invert(v: u8) u8 { ret !v; }\nfun main() i32 { choose(0); choose(1); choose(2); ret 0; }\n";
    var cbrs: u32 = 0;
    var nots: u32 = 0;
    if (!ut_condition_truth_ops(text, ?cbrs, ?nots)) { ret 1; }
    if (cbrs != 4 || nots != 1)                      { ret 1; }
    ret 0;
}

# 0 when the two-module project is rejected with `diag` (none when empty), every note in
# `notes`, and not the note `absent` (none when empty)
#[testing]
fun ut_mismatch_notes(main_s: str, a_src: str, diag: str, notes: *str, notes_len: usize, absent: str) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    val pr: res[project.Project, outcome.Fail] = ut_sema2(?s, ?alloc, main_s, a_src);
    if (!ut_project_was_rejected(pr))                       { ret 2; }
    if (str_len(diag) != 0 && !ut_diag_has(?s.diags, diag)) { ret 3; }
    var i: usize = 0;
    for (i < notes_len) {
        if (!ut_diag_note_has(?s.diags, notes[i])) { ret 4; }
        i = i + 1;
    }
    if (str_len(absent) != 0 && ut_diag_note_has(?s.diags, absent)) { ret 5; }
    ret 0;
}

# a mismatch between two types that share a name notes both declaring modules, for a
# record, a generic instance and a reinterpret; distinct names get only the widening
# note; records are nominal, so an identity record is neither another record nor an index
test type_mismatch__notes_same_named_types {
    val need:  str    = "two different types that share the name";
    val a_src: str    = "pub rec P { a: u8; }\npub rec Other { a: u8; }\npub rec Box[T] { a: T; }\n";
    var named: [3]str = [3]str{need, "the first is declared in `uniontest.main`", "the second in `uniontest.a`"};
    if (ut_mismatch_notes("use a: uniontest.a;\nrec P { a: u8; }\nfun main() i64 { var x: P; var y: a.P; x = y; ret 0; }\n", a_src, "", ?named[0], 3, "") != 0)                 { ret 1; }
    if (ut_mismatch_notes("use a: uniontest.a;\nrec Box[T] { a: T; }\nfun main() i64 { var x: Box[u8]; var y: a.Box[u8]; x = y; ret 0; }\n", a_src, "", ?named[0], 1, "") != 0) { ret 2; }
    if (ut_mismatch_notes("use a: uniontest.a;\nrec P { a: u8; b: u64; }\nfun cast(x: P) a.P { ret x:~a.P; }\nfun main() i64 { ret 0; }\n", a_src, "", ?named[0], 1, "") != 0)  { ret 3; }
    var widen: [1]str = [1]str{"mach has no implicit widening"};
    if (ut_mismatch_notes("use a: uniontest.a;\nrec P { a: u8; }\nfun main() i64 { var x: P; var y: a.Other; x = y; ret 0; }\n", a_src, "type mismatch: expected P, found Other", ?widen[0], 1, need) != 0) { ret 4; }
    if (ut_mismatch_notes("fun main() i64 { var x: u8; var y: i64; x = y; ret 0; }\n", a_src, "type mismatch: expected u8, found i64", ?widen[0], 1, need) != 0)                                            { ret 5; }
    val ids: str = "rec SectionId { index: u32; }\nrec SymbolId { index: u32; }\nfun symbol_at(id: SymbolId) u32 { ret id.index; }\n";
    if (!ut_sema_rejects_with(ut_cc_src(ids, "fun probe() i64 { var s: SectionId; ret symbol_at(s)::i64; }\n"), "type mismatch: expected SymbolId, found SectionId")) { ret 6; }
    if (!ut_sema_rejects_with(ut_cc_src(ids, "fun probe() i64 { var s: SectionId; var t: [4]u32; ret t[s]::i64; }\n"), "index must be an integer"))                   { ret 7; }
    if (!ut_sema_clean(ut_cc_src(ids, "fun probe() i64 { var s: SectionId; var t: [4]u32; ret t[s.index]::i64; }\n")))                                                { ret 8; }
    ret 0;
}

test bracket__value_keeps_subscripts {
    var bad: i32 = 0;

    if (!ut_sema_clean("fun main() i64 { val i: u64 = 1; val a: [4]i64 = [4]i64{1, 2, 3, 4}; ret a[i]; }\n"))              { bad = 1; }
    if (!ut_sema_clean("fun main() i64 { val i: u64 = 0; var a: [4]i64; val p: *i64 = ?a[0]; ret p[i]; }\n"))              { bad = 1; }
    if (!ut_sema_clean("def T: i64;\nfun main() i64 { val T: u64 = 1; val a: [4]i64 = [4]i64{1, 2, 3, 4}; ret a[T]; }\n")) { bad = 1; }
    if (!ut_sema_clean("fun main() i64 { val i: u64 = 0; val j: u64 = 1; var m: [2][2]i64; ret m[i][j]; }\n"))             { bad = 1; }

    if (!ut_sema_rejects_with("fun main() i64 { var a: [4]i64; ret a[*i32]; }\n",
        "does not name a generic function")) { bad = 1; }

    if (!ut_sema_rejects_with("pub fun ident[T](s: T) T { ret s; }\nfun main() i64 { ret ident[0]; }\n",
        "not indexable: a function has no elements")) { bad = 1; }
    ret bad;
}

# `x[start, count]`: two names read both ways and name resolution picks by what the
# object is, in callee and value position alike
test range__bracket_readings {
    var bad: i32 = 0;

    if (!ut_sema_clean("val N: u64 = 2;\nfun main() i64 { val s: u64 = 1; val a: [4]i64 = [4]i64{1, 2, 3, 4}; val r: [2]i64 = a[s, N]; ret r[1]; }\n")) { bad = 1; }
    if (!ut_sema_clean("fun main() i64 { val a: [4]i64 = [4]i64{1, 2, 3, 4}; val r: [2]i64 = a[1, 2]; ret r[0]; }\n"))                                  { bad = 2; }
    if (!ut_sema_rejects_with("val N: u64 = 2;\nfun id(x: i64) i64 { ret x; }\nfun main() i64 { val s: u64 = 0; val t: [2]fun(i64) i64 = [2]fun(i64) i64{id, id}; ret t[s, N](3); }\n",
        "not callable")) { bad = 3; }
    if (!ut_sema_clean("pub fun first[T, U](a: T, b: U) T { ret a; }\nfun main() i64 { ret first[i64, u64](3, 4); }\n"))                                 { bad = 4; }
    if (!ut_sema_clean("pub fun first[T, U](a: T, b: U) T { ret a; }\nfun main() i64 { val f: fun(i64, u64) i64 = first[i64, u64]; ret f(3, 4); }\n"))   { bad = 5; }
    if (!ut_lower_clean("val N: u64 = 2;\nfun main() i64 { val s: u64 = 1; val a: [4]i64 = [4]i64{1, 2, 3, 4}; val r: [2]i64 = a[s, N]; ret r[1]; }\n")) { bad = 6; }
    ret bad;
}

test range__types_and_bounds {
    var bad: i32 = 0;

    # the result types: a vector of the lanes, an array of the elements
    if (!ut_sema_clean("fun main() i64 { val v: i16x8 = i16x8{1, 2, 3, 4, 5, 6, 7, 8}; val h: i16x4 = v[4, 4]; ret h[0]::i64; }\n"))                 { bad = 1; }
    if (!ut_sema_clean("fun main() i64 { var a: [4]f32; val p: *f32 = ?a[0]; val r: [3]f32 = p[1, 3]; ret r[0]::i64; }\n"))                          { bad = 2; }
    if (!ut_sema_clean("fun main() i64 { var a: [4]f32; val p: *f32 = ?a[0]; val v: f32x4 = p[0, 4]::f32x4; p[0, 4] = (v * v)::[4]f32; ret 0; }\n")) { bad = 3; }
    if (!ut_sema_clean("fun main() i64 { var v: u32x4 = u32x4{1, 2, 3, 4}; v[2, 2] = v[0, 2]; ret v[3]::i64; }\n"))                                  { bad = 4; }

    # the count is a positive comptime constant
    if (!ut_sema_rejects_with("fun main() i64 { val n: u64 = 2; val a: [4]i64 = [4]i64{1, 2, 3, 4}; val r: [2]i64 = a[0, n]; ret r[0]; }\n",
        "range count is not a comptime constant")) { bad = 5; }
    if (!ut_sema_rejects_with("fun main() i64 { val a: [4]i64 = [4]i64{1, 2, 3, 4}; val r: [2]i64 = a[0, -1]; ret r[0]; }\n",
        "range count -1 is negative")) { bad = 6; }
    if (!ut_sema_rejects_with("fun main() i64 { val a: [4]i64 = [4]i64{1, 2, 3, 4}; val r: [2]i64 = a[0, 0]; ret r[0]; }\n",
        "range count 0 is empty")) { bad = 7; }

    # a constant start keeps the range inside an array or a vector, and may end at its length
    if (!ut_sema_clean("fun main() i64 { val a: [4]i64 = [4]i64{1, 2, 3, 4}; val r: [2]i64 = a[2, 2]; ret r[0]; }\n")) { bad = 8; }
    if (!ut_sema_rejects_with("fun main() i64 { val a: [4]i64 = [4]i64{1, 2, 3, 4}; val r: [2]i64 = a[3, 2]; ret r[0]; }\n",
        "range [3, 2] is out of bounds for `[4]i64` of length 4")) { bad = 9; }
    if (!ut_sema_clean("fun main() i64 { val v: u32x4 = u32x4{1, 2, 3, 4}; val r: u32x2 = v[2, 2]; ret r[0]::i64; }\n")) { bad = 10; }
    if (!ut_sema_rejects_with("fun main() i64 { val v: u32x4 = u32x4{1, 2, 3, 4}; val r: u32x3 = v[2, 3]; ret r[0]::i64; }\n",
        "range [2, 3] is out of bounds for `u32x4` of length 4")) { bad = 11; }
    if (!ut_sema_rejects_with("fun main() i64 { val v: u32x4 = u32x4{1, 2, 3, 4}; val r: u32x2 = v[5, 2]; ret r[0]::i64; }\n",
        "range [5, 2] is out of bounds for `u32x4` of length 4")) { bad = 12; }

    # a vector range's start is a constant, as a lane index is, and it takes two lanes or more
    if (!ut_sema_rejects_with("fun main() i64 { val i: u64 = 0; val v: u32x4 = u32x4{1, 2, 3, 4}; val r: u32x2 = v[i, 2]; ret r[0]::i64; }\n",
        "a vector range's start must be a comptime constant")) { bad = 13; }
    if (!ut_sema_rejects_with("fun main() i64 { val v: u32x4 = u32x4{1, 2, 3, 4}; val r: u32 = v[1, 1]; ret r::i64; }\n",
        "a vector range needs at least 2 lanes")) { bad = 14; }

    # the stored value has the range's type
    if (!ut_sema_rejects("fun main() i64 { var a: [4]i64; val b: [3]i64 = [3]i64{1, 2, 3}; a[0, 2] = b; ret a[0]; }\n"))        { bad = 15; }
    if (!ut_sema_rejects("fun main() i64 { var v: u32x4 = u32x4{1, 2, 3, 4}; v[0, 2] = u32x4{1, 2, 3, 4}; ret v[0]::i64; }\n")) { bad = 16; }

    # a range is a value, not a view
    if (!ut_sema_rejects_with("fun main() i64 { var a: [4]i64; val p: *[2]i64 = ?a[0, 2]; ret 0; }\n", "a range")) { bad = 17; }
    if (!ut_sema_rejects("fun main() i64 { var a: [4]i64; a[0, 2][1] = 3; ret a[1]; }\n"))                         { bad = 18; }
    ret bad;
}

# the same parsed bracket is read as a generic call or an index as its names change, and the
# reused syntax tree is never rewritten
test bracket__reinterprets_without_rewriting_the_tree {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val initialized: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel initialized.err) { ret 2; }
    var s: session.Session = initialized.ok;
    fin { session.dnit(?s); }
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) { ret 3; }
    var names:    [2]str = [2]str{"main.mach", "lib.mach"};
    var versions: [2]str = [2]str{
        "pub def Key: i64;\npub fun item[T](v: T) T { ret v; }\n",
        "pub val Key: u64 = 0;\nfun identity(v: i64) i64 { ret v; }\npub val item: [1]fun(i64) i64 = [1]fun(i64) i64{identity};\n"
    };
    var texts: [2]str = [2]str{
        "use uniontest.lib.item;\nuse uniontest.lib.Key;\nfun main() i64 { ret item[Key](3); }\n", versions[0]
    };
    val scaffold: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 2);
    if (sel scaffold.err) { ret 4; }
    val root: str = scaffold.ok;
    fin {
        fs.remove_all(?alloc, root);
        str_free(?alloc, root);
    }
    val joined: res[str, A.Error] = path.join(?alloc, root, "src/lib.mach");
    if (sel joined.err) { ret 5; }
    val filename: str = joined.ok;
    fin { str_free(?alloc, filename); }
    var saved: *aexpr.Expr = nil;
    var count: usize       = 0;
    fin {
        if (saved != nil) { A.deallocate[aexpr.Expr](?alloc, saved, count); }
    }
    var owner:       *ast.Ast       = nil;
    var incarnation: u64            = 0;
    var selected:    aid.ExprId     = aid.EXPR_NIL;
    var revision:    query.Revision = 0;
    var round:       u32            = 0;
    for (round < 3) {
        val version:       u32             = round % 2;
        val write_bytes_r: err[fs.FsError] = fs.write_bytes(filename, versions[version], str_len(versions[version]), 420);
        if (sel write_bytes_r.err) { ret 6; }
        val opened: res[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
        if (sel opened.err) { ret 7; }
        var p: project.Project = opened.ok;
        fin { project.dnit_project(?p); }
        val mid: session.ModuleId = ut_mid(?p, ?s, "uniontest.main");
        if (mid == session.MODULE_NIL) { ret 8; }
        val parsed: *ast.Ast = project.module_at(?p, mid::u32).a;
        if (parsed == nil) { ret 9; }
        val current: query.Revision = query.peek_revision(?s.queries, query.Q_PARSE, project.module_at(?p, mid::u32).file_id::u64);
        if (round == 0) {
            owner       = parsed;
            incarnation = parsed.incarnation;
            revision    = current;
            count       = parsed.expr_len;
            val storage: res[*aexpr.Expr, A.Error] = A.allocate[aexpr.Expr](?alloc, count);
            if (sel storage.err) { ret 10; }
            saved = storage.ok;
            memory.copy[aexpr.Expr](saved, parsed.exprs, count);
            var i: usize = 0;
            for (i < count) {
                if (saved[i].kind == aexpr.EXPR_KIND_CALL && saved[i].data.call.index_callee != aid.EXPR_NIL) {
                    if (selected != aid.EXPR_NIL) { ret 11; }
                    selected = i::aid.ExprId;
                }
                i = i + 1;
            }
            if (selected == aid.EXPR_NIL || revision == 0) { ret 12; }
        }
        if (parsed != owner || parsed.incarnation != incarnation || parsed.expr_len != count || current != revision
            || !memory.equal[aexpr.Expr](saved, parsed.exprs, count)) { ret 13; }
        val run_sema_pass_r: err[outcome.Fail] = driver.run_sema_pass(?p);
        if (sel run_sema_pass_r.err) {
            var di: usize = 0;
            for (di < diagnostic.len(?s.diags)) {
                print.eprintln(s.diags.items.data[di].message);
                di = di + 1;
            }
            ret 14;
        }
        val interpreted: res[aexpr.Expr, fail.Fail] = resolve.expression(project.module_at(?p, mid::u32).resolve_result, parsed, selected);
        if (sel interpreted.err) { ret 15; }
        val node: aexpr.Expr = interpreted.ok;
        if (node.kind != aexpr.EXPR_KIND_CALL || node.data.call.index_callee != aid.EXPR_NIL)                                       { ret 16; }
        if (version == 0 && (node.data.call.type_args_len != 1 || node.data.call.callee != saved[selected].data.call.callee))       { ret 17; }
        if (version == 1 && (node.data.call.type_args_len != 0 || node.data.call.callee != saved[selected].data.call.index_callee)) { ret 18; }
        val run_lower_pass_r: err[outcome.Fail] = driver.run_lower_pass(?p);
        if (sel run_lower_pass_r.err)                              { ret 19; }
        if (!memory.equal[aexpr.Expr](saved, parsed.exprs, count)) { ret 20; }
        round = round + 1;
    }
    ret 0;
}

test qualified_const__folds_into_val {
    var bad: i32 = 0;
    val lib: str = "pub val KINDS: u64 = 2;\npub val ACTIONS: u64 = 11;\npub val SLOTS: u64 = KINDS * ACTIONS;\n";

    if (!ut_sema_clean2("use uniontest.lib;\nval CAP: u64 = lib.SLOTS;\nrec C { slots: [CAP]u8; }\nfun main() i64 { ret 0; }\n", lib)) { bad = 1; }

    if (!ut_sema_clean2("use a: uniontest.lib;\nval CAP: u64 = a.SLOTS * 2;\nrec C { slots: [CAP]u8; }\nfun main() i64 { ret 0; }\n", lib)) { bad = 1; }

    if (!ut_sema_clean2("use uniontest.lib;\nval CAP: u64 = lib.SLOTS;\nval MORE: u64 = CAP + 1;\nfun main() i64 { $if (MORE != 23) { $error(\"WRONG\"); } ret 0; }\n", lib)) { bad = 1; }

    if (ut_vec_diag2("use uniontest.lib;\nval CAP: u64 = lib.SLOTS;\nfun main() i64 { $if (CAP != 99) { $error(\"FIRED\"); } ret 0; }\n", lib, "FIRED") != 0) { bad = 1; }

    if (ut_vec_diag2("use uniontest.lib;\nval CAP: u64 = lib.HIDDEN;\nrec C { slots: [CAP]u8; }\nfun main() i64 { ret 0; }\n",
        "val HIDDEN: u64 = 4;\n", "exported by") != 0) { bad = 1; }

    ret bad;
}

test packed_field__address_is_refused {
    var bad:  i32 = 0;
    val need: str = "cannot take the address of a field of a `#[packed]` record";

    if (!ut_sema_rejects_with("#[packed]\nrec P { a: u8; b: u32; arr: [2]u32; }\nrec In { x: u32; }\n#[packed]\nrec Q { a: u8; i: In; }\nfun main() i64 { var r: P; val p: ptr = ?r.b; ret p::i64; }\n", need))                 { bad = 1; }
    if (!ut_sema_rejects_with("#[packed]\nrec P { a: u8; b: u32; arr: [2]u32; }\nrec In { x: u32; }\n#[packed]\nrec Q { a: u8; i: In; }\nfun main() i64 { var r: P; val p: ptr = ?r.arr[0]; ret p::i64; }\n", need))            { bad = 1; }
    if (!ut_sema_rejects_with("#[packed]\nrec P { a: u8; b: u32; arr: [2]u32; }\nrec In { x: u32; }\n#[packed]\nrec Q { a: u8; i: In; }\nfun main() i64 { var q: Q; val p: ptr = ?q.i.x; ret p::i64; }\n", need))               { bad = 1; }
    if (!ut_sema_rejects_with("#[packed]\nrec P { a: u8; b: u32; arr: [2]u32; }\nrec In { x: u32; }\n#[packed]\nrec Q { a: u8; i: In; }\nfun main() i64 { var r: P; val q: *P = ?r; val p: ptr = ?q.b; ret p::i64; }\n", need)) { bad = 1; }

    if (!ut_sema_clean("#[packed]\nrec P { a: u8; b: u32; arr: [2]u32; }\nrec In { x: u32; }\n#[packed]\nrec Q { a: u8; i: In; }\nfun main() i64 { var r: P; val p: ptr = ?r; ret p::i64; }\n")) { bad = 1; }
    if (!ut_sema_clean("rec R { a: u8; b: u32; }\nfun main() i64 { var r: R; val p: ptr = ?r.b; ret p::i64; }\n"))                                                                               { bad = 1; }
    if (!ut_sema_clean("rec In { x: u32; }\nrec R { a: u8; i: In; }\nfun main() i64 { var r: R; val p: ptr = ?r.i.x; ret p::i64; }\n"))                                                          { bad = 1; }
    if (!ut_sema_clean("#[packed]\nrec P { a: u8; b: u32; arr: [2]u32; }\nrec In { x: u32; }\n#[packed]\nrec Q { a: u8; i: In; }\nfun main() i64 { var r: P; r.b = 7; ret r.b::i64; }\n"))       { bad = 1; }

    if (!ut_sema_rejects_with("#[packed]\nrec P { a: u8; b: u32; }\ndef PA: P;\nfun main() i64 { var r: PA; val p: ptr = ?r.b; ret p::i64; }\n", need))                                            { bad = 1; }
    if (!ut_sema_rejects_with("#[packed]\nrec Box[T] { a: u8; v: T; }\nfun main() i64 { var b: Box[u32]; val p: ptr = ?b.v; ret p::i64; }\n", need))                                               { bad = 1; }
    if (!ut_sema_rejects_with("#[packed]\nrec Box[T] { a: u8; v: T; }\nfun f[T](b: *Box[T]) i64 { val p: ptr = ?b.v; ret p::i64; }\nfun main() i64 { var b: Box[u32]; ret f[u32](?b); }\n", need)) { bad = 1; }
    if (!ut_sema_clean("rec Box[T] { a: u8; v: T; }\nfun main() i64 { var b: Box[u32]; val p: ptr = ?b.v; ret p::i64; }\n"))                                                                       { bad = 1; }
    ret bad;
}

test c_variadic__tail_contract {
    var bad: i32 = 0;

    if (!ut_sema_clean("ext fun p(t: *u8, ...) i64;\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var b: u8; p(?b); p(?b, 1::i32); p(?b, 1::i32, 2::i64, 3.5::f64, ?b); ret 0; }\n")) { bad = 1; }

    if (ut_vec_diag("ext fun p(t: *u8, n: i64, ...) i64;\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var b: u8; p(?b); ret 0; }\n",
        "expected at least 2") != 0) { bad = 1; }

    if (ut_vec_diag("ext fun p(t: *u8, ...) i64;\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var b: u8; var c: u8 = 65; p(?b, c); ret 0; }\n",
        "promoted to a 32-bit integer") != 0) { bad = 1; }
    if (ut_vec_diag("ext fun p(t: *u8, ...) i64;\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var b: u8; var f: f32 = 1.5; p(?b, f); ret 0; }\n",
        "promoted to `f64`") != 0) { bad = 1; }
    if (!ut_sema_clean("ext fun p(t: *u8, ...) i64;\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var b: u8; var c: u8 = 65; var f: f32 = 1.5; p(?b, c::i32, f::f64); ret 0; }\n")) { bad = 1; }

    if (ut_vec_diag("ext fun p(t: *u8, ...) i64;\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var b: u8; var s: ^i64 = 1; p(?b, s); ret 0; }\n",
        "secret value cannot be passed to a C-variadic") != 0) { bad = 1; }

    if (ut_vec_diag("ext fun q(t: *u8) i64;\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var b: u8; q(?b, 1::i64); ret 0; }\n",
        "arity mismatch") != 0) { bad = 1; }

    if (ut_vec_diag("ext fun r(t: *u8, ...) i64 { ret 0; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "cannot have a body") != 0) { bad = 1; }

    ret bad;
}

test recursive_type__occurs_check {
    val need: str = "recursive type has infinite size";

    var bad: i32 = 0;
    if (!ut_sema_rejects_with("rec R { next: R; }\nfun main() i32 { ret 0; }\n", need))                                      { bad = 1; }
    if (!ut_sema_rejects_with("uni U { a: u32; b: U; }\nfun main() i32 { ret 0; }\n", need))                                 { bad = 1; }
    if (!ut_sema_rejects_with("rec R { a: [4]R; }\nfun main() i32 { ret 0; }\n", need))                                      { bad = 1; }
    if (!ut_sema_rejects_with("rec A { b: B; }\nrec B { a: A; }\nfun main() i32 { ret 0; }\n", need))                        { bad = 1; }
    if (!ut_sema_rejects_with("rec R { a: rec { b: R; }; }\nfun main() i32 { ret 0; }\n", need))                             { bad = 1; }
    if (!ut_sema_rejects_with("rec W[T] { v: T; inner: W[T]; }\nfun main() i32 { var w: W[i32]; ret 0; }\n", need))          { bad = 1; }
    if (!ut_sema_rejects_with("rec Wrap[T] { inner: Wrap[Wrap[T]]; }\nfun main() i32 { var w: Wrap[i32]; ret 0; }\n", need)) { bad = 1; }

    if (!ut_sema_clean("rec Node { next: *Node; }\nfun main() i32 { var n: Node; ret 0; }\n"))                                                         { bad = 1; }
    if (!ut_sema_clean("rec A { b: *B; }\nrec B { a: *A; }\nfun main() i32 { var a: A; ret 0; }\n"))                                                   { bad = 1; }
    if (!ut_sema_clean("uni U { a: u32; b: *U; }\nfun main() i32 { var u: U; ret 0; }\n"))                                                             { bad = 1; }
    if (!ut_sema_clean("rec R { a: [4]*R; }\nfun main() i32 { var r: R; ret 0; }\n"))                                                                  { bad = 1; }
    if (!ut_sema_clean("rec Leaf { v: u8; }\nrec L { l: Leaf; }\nrec Rt { r: Leaf; }\nrec D { x: L; y: Rt; }\nfun main() i32 { var d: D; ret 0; }\n")) { bad = 1; }
    ret bad;
}

test recursive_union__reports_its_real_defect {
    var bad: i32 = 0;

    val rec_uni: str = "uni U[T] { a: u32; b: U[U[T]]; }\nfun main() i32 { var u: U[i32]; ret 0; }\n";
    if (!ut_sema_rejects_with(rec_uni, "recursive type has infinite size")) { bad = 1; }
    if (ut_sema_errs(rec_uni) != 1)                                         { bad = 1; }

    val need: str = "union variants must agree on secrecy";
    if (!ut_sema_rejects_with("uni M { a: ^u32; b: u32; }\nfun main() i32 { ret 0; }\n", need))                                   { bad = 1; }
    if (!ut_sema_rejects_with("rec P { s: ^u32; }\nrec Q { s: u32; }\nuni D { a: P; b: Q; }\nfun main() i32 { ret 0; }\n", need)) { bad = 1; }
    if (!ut_sema_rejects_with("uni S { a: ^u32; b: S; c: u32; }\nfun main() i32 { ret 0; }\n", need))                             { bad = 1; }
    ret bad;
}

test contains_float_deep__finds_a_float_through_an_array {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var bad:     i32              = 0;
    val f32_opt: opt[type.TypeId] = type.prim(?s.types, type.TYPE_F32);
    if (sel f32_opt.some) {
        val arr_r: res[type.TypeId, fail.Fail] = type.intern_array(?s.types, f32_opt.some, 4);
        if (sel arr_r.ok) {
            val found: res[bool, fail.Fail] = generics.contains_float_deep(?s, arr_r.ok);
            if (sel found.err) { ret 99; }
            if (!found.ok)     { bad = 1; }
        }
    }

    session.dnit(?s);
    ret bad;
}

test fields__refuses_a_union {
    var bad: i32 = 0;

    if (!ut_sema_rejects("uni U[T] { a: T; b: u32; }\nfun walk[T](u: T) u32 { var acc: u32 = 0; $each f in $fields(T) { acc = acc + 1; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var u: U[u32]; walk[U[u32]](u); ret 0; }\n")) { bad = 1; }

    if (!ut_sema_rejects("uni V { a: u32; b: u32; }\nfun walk(v: V) u32 { var acc: u32 = 0; $each f in $fields(V) { acc = acc + 1; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var v: V; walk(v); ret 0; }\n")) { bad = 1; }

    ret bad;
}

test intrinsic__type_operand_is_a_type {
    var bad: i32 = 0;

    if (ut_vec_diag("rec Box[T] { v: T; }\nfun leak[T](b: Box[T]) u32 { var acc: u32 = 0; $each f in $fields(Box[T]) { acc = b.[f]; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var s: ^u32 = 1234; var b: Box[^u32]; b.v = s; leak[^u32](b); ret 0; }\n",
        "expected u32, found ^u32") != 0) { bad = 1; }

    if (ut_vec_diag("rec In[T] { x: T; }\nrec Box[T] { v: T; }\nfun leak[T](b: Box[In[T]]) u32 { var acc: u32 = 0; $each f in $fields(Box[In[T]]) { acc = b.[f]; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var b: Box[In[u32]]; leak[u32](b); ret 0; }\n",
        "expected u32, found In[u32]") != 0) { bad = 2; }
    if (ut_vec_diag("rec Box[T] { v: T; }\nfun leak(b: Box[^u32]) u32 { var acc: u32 = 0; $each f in $fields(Box[^u32]) { acc = b.[f]; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var b: Box[^u32]; leak(b); ret 0; }\n",
        "expected u32, found ^u32") != 0) { bad = 4; }

    if (ut_vec_diag("rec Box[T] { v: T; }\nfun leak[T](b: Box[T]) u32 { var acc: u32 = 0; $each g in $fields(Box[T]) { $each f in $fields(Box[T]) { acc = b.[f]; } } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var b: Box[^u32]; leak[^u32](b); ret 0; }\n",
        "expected u32, found ^u32") != 0) { bad = 5; }

    if (!ut_sema_clean("rec Box[T] { v: T; }\nfun get[T](b: Box[T]) T { var r: T; $each f in $fields(Box[T]) { r = b.[f]; } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var b: Box[u32]; get[u32](b); ret 0; }\n"))                                                    { bad = 6; }
    if (!ut_sema_clean("rec Box[T] { v: T; }\nfun count[T](b: Box[T]) u32 { var acc: u32 = 0; $each g in $fields(Box[T]) { $each f in $fields(Box[T]) { acc = acc + 1; } } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var b: Box[u32]; count[u32](b); ret 0; }\n")) { bad = 9; }

    if (ut_lower_ok("rec Box[T] { v: T; }\nfun sz[T]() u64 { ret $size_of(Box[T]); }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { sz[u32](); ret 0; }\n") != 0)                          { bad = 10; }
    if (!ut_sema_clean("rec Pair[A, B] { a: A; b: B; }\nfun of[A, B]() u64 { ret $offset_of(Pair[A, B], b); }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { of[u32, u64](); ret 0; }\n")) { bad = 12; }

    if (!ut_sema_clean("rec Box[T] { v: T; }\nfun sz[T]() u64 { ret $size_of(*Box[T]); }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { sz[u32](); ret 0; }\n")) { bad = 13; }
    if (!ut_sema_clean("fun sz() u64 { ret $size_of(^u32); }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { sz(); ret 0; }\n"))                                  { bad = 15; }

    if (!ut_sema_rejects("fun count() u32 { var acc: u32 = 0; $each f in $fields(NoSuch) { acc = acc + 1; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { count(); ret 0; }\n"))      { bad = 16; }
    if (!ut_sema_rejects("fun count() u32 { var acc: u32 = 0; $each f in $fields(NoSuch[u32]) { acc = acc + 1; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { count(); ret 0; }\n")) { bad = 17; }
    if (ut_vec_diag("fun count() u32 { var acc: u32 = 0; $each f in $fields(u32) { acc = acc + 1; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { count(); ret 0; }\n",
        "$fields requires a record type") != 0) { bad = 18; }

    if (ut_vec_diag("rec Box { v: u32; }\nfun f() u64 { var n: u64 = 0; n = $fields(Box); ret n; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { f(); ret 0; }\n",
        "a type name is not a value") != 0) { bad = 20; }

    if (ut_sema_errs("fun f() i64 { ret nosuchname; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { f(); ret 0; }\n") != 1) { bad = 23; }

    if (!ut_sema_clean("fun count() u32 { var acc: u32 = 0; $each f in $fields(rec { x: u32; y: u64; }) { acc = acc + 1; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { count(); ret 0; }\n")) { bad = 21; }
    if (!ut_sema_clean("rec Empty { }\nfun count() u32 { var acc: u32 = 0; $each f in $fields(Empty) { acc = acc + 1; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { count(); ret 0; }\n"))    { bad = 22; }

    ret bad;
}

test type_diagnostic__fires_once_per_site {
    var bad: i32 = 0;

    if (ut_sema_errs("rec Box[T] { v: T; w: T; }\nfun f() u64 { ret $size_of(Box[u32, u32]); }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { f(); ret 0; }\n") != 1)                                  { bad = 1; }
    if (ut_sema_errs("rec Box[T] { v: T; w: T; }\nfun f() u64 { ret $size_of(Box); }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { f(); ret 0; }\n") != 1)                                            { bad = 2; }
    if (ut_sema_errs("rec Box[T] { v: T; w: T; }\nfun f() u64 { var n: u64 = 0; $each g in $fields(Box) { n = n + 1; } ret n; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { f(); ret 0; }\n") != 1) { bad = 3; }

    if (ut_sema_errs("rec Box[T] { v: T; w: T; }\nfun ptr(p: *Box[u32, u32]) u32 { ret 0; }\nfun ret_ty() Box[u32, u32] { var b: Box[u32]; ret b; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n") != 2) { bad = 4; }

    if (ut_sema_errs("rec Box[T] { v: T; }\nfun f(p: *Box) u32 { ret 0; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n") != 1)           { bad = 5; }
    if (ut_sema_errs("rec Box[T] { v: T; }\nfun f(cb: fun(*Box) u32) u32 { ret 0; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n") != 1) { bad = 8; }

    if (ut_sema_errs("rec Box[T] { v: T; w: T; }\nrec Outer { b: Box; }\ndef Alias: Box;\nfun a(p: *Box) u64 { ret $size_of(Box) + $align_of(Box) + $offset_of(Box, w); }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n") != 6) { bad = 9; }

    if (ut_sema_errs("rec Box[T] { v: T; }\nfun g[T](b: Box[T]) u32 { var x: u32 = 0; x = b.v; ret x; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var p: Box[^u32]; var q: Box[^u64]; var r: Box[u64]; g[^u32](p); g[^u64](q); g[u64](r); ret 0; }\n") != 3) { bad = 10; }

    if (!ut_sema_clean("rec Box[T] { v: T; w: T; }\nfun sz[T]() u64 { ret $size_of(Box[T]); }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { if (sz[u8]() == sz[u64]()) { ret 1; } ret 0; }\n")) { bad = 11; }

    if (ut_sema_errs("fun f() u64 { ret $size_of(NoSuch); }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { f(); ret 0; }\n") != 1) { bad = 12; }
    if (ut_vec_diag("rec Box[T] { v: T; }\nfun f() u64 { ret $size_of(Box); }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { f(); ret 0; }\n",
        "internal: could not intern the type named by this comptime intrinsic argument") == 0) { bad = 13; }

    ret bad;
}

# a suffix is the literal's type, out of range names the range, and an unknown spelling is
# refused as an integer or a float suffix
test literal_suffix__types_ranges_and_spellings {
    if (!ut_sema_clean(ut_cc_src("fun f() u32 { val x: u32 = 7u32; ret x; }", "\n")))                                      { ret 1; }
    if (!ut_sema_clean(ut_cc_src("fun f() f32 { val x: f32 = 1.5f32; ret x; }", "\n")))                                    { ret 2; }
    if (!ut_sema_clean(ut_cc_src("fun f() i8 { val x: i8 = -128i8; ret x; }", "\n")))                                      { ret 3; }
    if (ut_vec_diag(ut_cc_src("fun f() u64 { val x: u64 = 7u32; ret x; }", "\n"), "type mismatch: expected") != 0)         { ret 4; }
    if (ut_vec_diag(ut_cc_src("fun f() f64 { val x: f64 = 1.5f32; ret x; }", "\n"), "type mismatch: expected") != 0)       { ret 5; }
    if (ut_vec_diag(ut_cc_src("fun f() u32 { val x: u32 = 7u32 + 8u64; ret x; }", "\n"), "are different types") != 0)      { ret 6; }
    if (ut_vec_diag(ut_cc_src("fun f() u8 { val x: u8 = 256u8; ret x; }", "\n"), "literal 256 is out of range for") != 0)  { ret 7; }
    if (ut_vec_diag(ut_cc_src("fun f() u32 { val x: u32 = -1u32; ret x; }", "\n"), "literal -1 is out of range for") != 0) { ret 8; }
    if (ut_vec_diag(ut_cc_src("fun f() i8 { val x: i8 = 128i8; ret x; }", "\n"), "literal 128 is out of range for") != 0)  { ret 9; }
    if (ut_vec_diag(ut_cc_src("fun f() u32 { val x: u32 = 7u7; ret x; }", "\n"), "unknown integer literal suffix") != 0)   { ret 10; }
    if (ut_vec_diag(ut_cc_src("fun f() u32 { val x: u32 = 7u; ret x; }", "\n"), "unknown integer literal suffix") != 0)    { ret 11; }
    if (ut_vec_diag(ut_cc_src("fun f() f32 { val x: f32 = 1f32; ret x; }", "\n"), "unknown integer literal suffix") != 0)  { ret 12; }
    if (ut_vec_diag(ut_cc_src("fun f() f32 { val x: f32 = 1.5f16; ret x; }", "\n"), "unknown float literal suffix") != 0)  { ret 13; }
    ret 0;
}

test binary_op__operands_need_one_type {
    if (!ut_sema_rejects_with(ut_cc_src("fun f(a: u32, b: i64) u32 { ret a + b; }", "\n"), "cast one operand explicitly")) { ret 1; }
    if (!ut_sema_rejects(ut_cc_src("fun f(a: u32, b: i64) u32 { ret b + a; }", "\n")))                                     { ret 2; }
    if (!ut_sema_rejects(ut_cc_src("fun f(a: u32, b: u64) u32 { ret a & b; }", "\n")))                                     { ret 3; }
    # an explicit cast, a shift count, a comparison, a secret mix and a literal are clean
    if (!ut_sema_clean(ut_cc_src("fun f(a: u32, b: i64) u32 { ret a + b::u32; }", "\n")))         { ret 4; }
    if (!ut_sema_clean(ut_cc_src("fun f(a: u32, b: u8) u32 { ret (a << b) + (a >> b); }", "\n"))) { ret 5; }
    if (!ut_sema_clean(ut_cc_src("fun f(a: u32, b: i64) u8 { ret a < b || a == b; }", "\n")))     { ret 6; }
    if (!ut_sema_clean(ut_cc_src("fun f(a: ^u32, b: u32) ^u32 { ret a + b; }", "\n")))            { ret 7; }
    if (!ut_sema_clean(ut_cc_src("fun f(a: u32) u32 { ret a + 1; }", "\n")))                      { ret 8; }
    ret 0;
}

#[testing]
fun ut_ir_text(text: str, out: *u8, cap: usize, out_len: *usize) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = text;
    val pr: res[project.Project, outcome.Fail] = ut_build(?s, ?alloc, ?names[0], ?texts[0], 1);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    var code: i32               = 1;
    val se:   err[outcome.Fail] = driver.run_sema_pass(?p);
    if (sel se.ok) {
        val le: err[outcome.Fail] = driver.run_lower_pass(?p);
        if (sel le.ok) {
            var b: UtIrTextBuf;
            b.data = out;
            b.len  = 0;
            b.cap  = cap;
            var w: writer.Writer;
            w.ctx     = (?b)::ptr;
            w.f_write = ut_ir_text_write;

            code = 0;
            var ti: u32 = 0;
            for (ti < p.topo_len) {
                val m: *ir.Module = project.module_at(?p, p.topo[ti]::u32).ir_module;
                if (m != nil) {
                    var d: printer.IrWriter = printer.ir_writer(?w, m, ?p.s.interner, ?p.s.sources,
                        printer.ir_context("post-lower", "t", "i", "o", "a", "f"), printer.IR_FORM_DEBUG);
                    val write_debug_r: err[fail.Fail] = printer.write_ir(?d);
                    if (sel write_debug_r.err) { code = 1; }
                }
                ti = ti + 1;
            }
            @out_len = b.len;
        }
    }
    project.dnit_project(?p);
    session.dnit(?s);
    ret code;
}

# `:^` and `:^T` are no operator: the parse stops at the colon and the statement's
# terminator check reports it; `:>T` builds
test colon_caret__is_refused_at_the_colon {
    val msg: str = "expected ';' after 'ret'";
    if (!ut_sema_rejects_with("fun down(a: ^u32) u32 { ret a:^u32; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { down(1); ret 0; }\n", msg))       { ret 1; }
    if (!ut_sema_rejects_with("fun down(a: ^u32) u32 { ret a:^; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { down(1); ret 0; }\n", msg))          { ret 2; }
    if (!ut_sema_rejects_with("rec K { d: [4]u8; }\nfun down(a: ^K) K { ret a:^K; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n", msg)) { ret 3; }
    if (ut_lower_ok("fun down(a: ^u32) u32 { ret a:>u32; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { down(1); ret 0; }\n") != 0)                 { ret 4; }
    ret 0;
}

# whether the post-lower ir text of `src` contains `needle`
#[testing]
fun ut_ir_text_has(src: str, needle: str) bool {
    val CAP: usize = 262144;
    var buf: [262144]u8;
    var len: usize = 0;
    if (ut_ir_text(src, ?buf[0], CAP, ?len) != 0) { ret false; }
    val n:  usize = str_len(needle);
    val np: *u8   = needle::*u8;
    if (n == 0 || n > len) { ret false; }
    var i: usize = 0;
    for (i + n <= len) {
        var j: usize = 0;
        for (j < n && buf[i + j] == np[j]) { j = j + 1; }
        if (j == n) { ret true; }
        i = i + 1;
    }
    ret false;
}

# ordering compares public addresses, so it lowers to the same unsigned integer
# compare a `usize` would, with no widening and no signed form
test pointer_compare__lowers_to_an_unsigned_compare {
    val src: str = "fun f(a: *^u8, b: *^u8) u8 { ret a < b; }\n#[symbol(\"main\")]\nfun main() i32 { ret 0; }\n";
    if (!ut_ir_text_has(src, "cmp_lt_u")) { ret 1; }
    if (ut_ir_text_has(src, "cmp_lt_s"))  { ret 2; }
    ret 0;
}

# `$mach.build.*` has no manifest-defined members: a name outside the
# known set is refused at the use site as an unknown path, and a known member
# on the line before it still resolves
test mach_build__unknown_member_is_refused_at_the_use_site {
    val src: str = "val w: u64 = $mach.build.pointer_width;\nval n: u64 = $mach.build.nosuch;\nfun main() i32 { ret 0; }\n";
    if (!ut_sema_rejects_at(src, "unknown `$mach.*` path", 53, 18))                             { ret 1; }
    if (!ut_sema_clean("val w: u64 = $mach.build.pointer_width;\nfun main() i32 { ret 0; }\n")) { ret 2; }
    ret 0;
}

test fin__refuses_control_flow_out_of_its_body {
    var bad: i32 = 0;
    if (!ut_sema_rejects("fun f() i64 { fin { ret 1; } ret 0; }\nfun main() i32 { ret 0; }\n"))                                                        { bad = 1; }
    if (!ut_sema_rejects("fun f() { fin { fin { ret; } } }\nfun main() i32 { ret 0; }\n"))                                                             { bad = 1; }
    if (!ut_sema_rejects("fun f() { var i: i64 = 0; for (i < 3) { fin { brk; } i = i + 1; } }\nfun main() i32 { ret 0; }\n"))                          { bad = 1; }
    if (!ut_sema_rejects("fun f() { var i: i64 = 0; for (i < 3) { fin { cnt; } i = i + 1; } }\nfun main() i32 { ret 0; }\n"))                          { bad = 1; }
    if (!ut_sema_rejects("fun f() { fin { var j: i64 = 0; for (j < 2) { fin { brk; } j = j + 1; } } }\nfun main() i32 { ret 0; }\n"))                  { bad = 1; }
    if (!ut_sema_clean("fun f() { fin { var j: i64 = 0; for (j < 4) { if (j == 2) { brk; } j = j + 1; } } }\nfun main() i32 { ret 0; }\n"))            { bad = 1; }
    if (!ut_sema_clean("fun f() { fin { var j: i64 = 0; for (j < 4) { j = j + 1; cnt; } } }\nfun main() i32 { ret 0; }\n"))                            { bad = 1; }
    if (!ut_sema_clean("fun f() i64 { var i: i64 = 0; for (i < 3) { fin { i = i + 1; } if (i == 2) { brk; } } ret i; }\nfun main() i32 { ret 0; }\n")) { bad = 1; }
    ret bad;
}

#[testing]
fun ut_global_uses(m: *ir.Module, gi: u32) u32 {
    ret ut_operand_uses(m, value.VAL_GLOBAL, gi::u64);
}

#[testing]
fun ut_has_extern_global(s: *session.Session, m: *ir.Module, needle: str) bool {
    if (m == nil) { ret false; }
    var gi: u32 = 0;
    for (gi < m.global_len) {
        val g: *ir.Global = ?m.globals[gi];
        if (g.is_extern) {
            val nm: opt[str] = intern.lookup(?s.interner, g.name);
            if (sel nm.some && ut_str_contains(nm.some, needle)) { ret true; }
        }
        gi = gi + 1;
    }
    ret false;
}

#[testing]
fun ut_has_extern_fn(s: *session.Session, m: *ir.Module, needle: str) bool {
    if (m == nil) { ret false; }
    var fi: u32 = 0;
    for (fi < m.function_len) {
        val f: *ir.Function = ?m.functions[fi];
        if ((f.flags & ir.FN_FLAG_EXTERN) != 0) {
            val nm: opt[str] = intern.lookup(?s.interner, f.name);
            if (sel nm.some && ut_str_contains(nm.some, needle)) { ret true; }
        }
        fi = fi + 1;
    }
    ret false;
}

# how a module value reaches an importer: a qualified or leaf-imported `val` folds to its
# own module's value whatever shadows it, a same-module global folds through a cross-module
# base, an own `val` folds and its global goes unused, an aliased import folds, a `fun`, a
# `var`, a pointer `val` and a string `val` stay references to one definition, and a `def`
# is the declaring module's
test module_const__folds_across_modules {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }

    var names: [4]str = [4]str{"main.mach", "a.mach", "b.mach", "c.mach"};
    var texts: [4]str;
    texts[0] = "use uniontest.a;\nuse uniontest.a.K;\nuse uniontest.a.MSG;\nuse x: uniontest.c;\nuse uniontest.b;\nval X: i64 = 707;\nval A: u64 = a.BASE + 0x48;\nval B: u64 = A + 8;\ndef T: [9]u8;\nfun f() i64 { ret 101; }\nvar G: i64 = 404;\npub val N: i64 = 6543;\npub fun p1() i64 { ret a.X; }\npub fun p2() i64 { ret X; }\npub fun p3() i64 { ret b.Y; }\npub fun p4() i64 { ret b.K; }\npub fun p5() i64 { ret K; }\npub fun p6() u64 { ret B; }\npub fun p7() i64 { ret a.f(); }\npub fun p8() i64 { ret a.G; }\npub fun p9() u64 { ret $size_of(a.T); }\npub fun p10() i64 { val L: i64 = 808; ret a.L + L; }\npub fun p11() i64 { ret N; }\npub fun p12() i64 { ret x.N; }\npub fun p13() ptr { ret x.PH; }\npub fun p14() ptr { ret a.MSG; }\npub fun p15() ptr { ret MSG; }\nfun main() i32 { ret 0; }\n";
    texts[1] = "pub val X: i64 = 909;\npub val K: i64 = 303;\npub rec P { x: u64; y: u64; }\npub val BASE: u64 = $size_of(P);\npub def T: [7]u8;\npub fun f() i64 { ret 202; }\npub var G: i64 = 505;\npub val L: i64 = 616;\npub val MSG: ptr = \"hello\";\n";
    texts[2] = "pub val Y: i64 = 1505;\npub val K: i64 = 606;\n";
    texts[3] = "pub val N: i64 = 4321;\npub var H: i64 = 1;\npub val PH: ptr = ?H;\n";

    val pr: res[project.Project, outcome.Fail] = ut_lower_n(?s, ?alloc, ?names[0], ?texts[0], 4);
    if (sel pr.err) { ret 2; }
    var p: project.Project = pr.ok;
    fin { project.dnit_project(?p); }
    if (ut_count_errors(?p.s.diags) != 0) { ret 3; }
    val m: *ir.Module = ut_ir_of(?p, ?s, "uniontest.main");
    if (m == nil) { ret 4; }

    var folded: [9]u64 = [9]u64{909, 707, 1505, 606, 303, 0x60, 1424, 6543, 4321};
    var i:      usize  = 0;
    for (i < 9) {
        if (ut_const_uses(m, folded[i]) != 1) { ret (10 + i)::i32; }
        i = i + 1;
    }
    val gx: i64 = ut_global_ix(?s, m, "uniontest.main.X");
    if (gx < 0 || ut_global_uses(m, gx::u32) != 0 || (?m.globals[gx::u32]).init.data.int_lit != 707) { ret 20; }
    val gn: i64 = ut_global_ix(?s, m, "uniontest.main.N");
    if (gn < 0 || ut_global_uses(m, gn::u32) != 0 || (?m.globals[gn::u32]).init.data.int_lit != 6543) { ret 21; }
    if (!ut_has_extern_fn(?s, m, "uniontest.a.f"))                                                    { ret 22; }
    if (!ut_has_extern_global(?s, m, "uniontest.a.G"))                                                { ret 23; }
    if (ut_const_uses(m, 7) != 1 || ut_const_uses(m, 9) != 0)                                         { ret 24; }
    if (ut_has_extern_global(?s, m, "uniontest.c.N"))                                                 { ret 25; }
    if (!ut_has_extern_global(?s, m, "uniontest.c.PH"))                                               { ret 26; }
    if (!ut_has_extern_global(?s, m, "uniontest.a.MSG"))                                              { ret 27; }
    if (ut_rodata_globals(m) != 0)                                                                    { ret 28; }
    ret 0;
}

test global_init__folds_nested_scalar_casts {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "def Word: u64;\nval ALL: Word = ~(0::Word);\nval BYTE: u8 = ~((0::u8) | (0::u8));\nval SIGNED: i8 = (255u8:~i8);\nval HIGH: u64 = (128u8:~i8)::u64;\nval EXP: u64 = ((5.0:~u64) >> 52);\nfun main() i32 { $if ((~((0::u8) + (0::u8))) != 255u8) { $error(\"nested bitwise width\"); } $if (((5.0:~u64) >> 52) != 1025) { $error(\"nested cast gate\"); } ret 0; }\n";
    val pr: res[project.Project, outcome.Fail] = ut_lower_n(?s, ?alloc, ?names[0], ?texts[0], 1);
    if (sel pr.err) { ret 2; }
    var p: project.Project = pr.ok;
    fin { project.dnit_project(?p); }
    if (ut_count_errors(?s.diags) != 0) { ret 3; }
    val m: *ir.Module = ut_ir_of(?p, ?s, "uniontest.main");
    if (m == nil) { ret 4; }
    var labels: [5]str;
    labels[0] = "uniontest.main.ALL";
    labels[1] = "uniontest.main.BYTE";
    labels[2] = "uniontest.main.SIGNED";
    labels[3] = "uniontest.main.HIGH";
    labels[4] = "uniontest.main.EXP";
    var expected: [5]u64;
    expected[0] = 0xFFFFFFFFFFFFFFFF;
    expected[1] = 255;
    expected[2] = 0xFFFFFFFFFFFFFFFF;
    expected[3] = 0xFFFFFFFFFFFFFF80;
    expected[4] = 1025;
    var i: u32 = 0;
    for (i < 5) {
        val gi: i64 = ut_global_ix(?s, m, labels[i]);
        if (gi < 0) { ret 5; }
        val init: value.Value = m.globals[gi::u32].init;
        if (init.kind != value.VAL_CONST_INT || init.data.int_lit != expected[i]) { ret (6 + i)::i32; }
        i = i + 1;
    }
    ret 0;
}

# a same-module global cycle is refused at each global, and the rejected module leaves no
# lower query product behind
test global_init__cycle_is_refused_with_no_lower_product {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "val X: u64 = Y;\nval Y: u64 = X;\nfun main() i32 { ret 0; }\n";
    val rooted: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 1);
    if (sel rooted.err) { ret 2; }
    val root: str = rooted.ok;
    fin { fs.remove_all(?alloc, root); }
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) { ret 3; }
    var selection: manifest.Selection                 = ut_target_sel("linux");
    val built:     res[project.Project, outcome.Fail] = driver.build_project(?s, root, ?selection);
    if (sel built.err) { ret 4; }
    var p: project.Project = built.ok;
    fin { project.dnit_project(?p); }
    val run_sema_pass_r: err[outcome.Fail] = driver.run_sema_pass(?p);
    if (sel run_sema_pass_r.err) { ret 5; }
    val lowered: err[outcome.Fail] = driver.run_lower_pass(?p);
    if (sel lowered.ok)                                                                    { ret 6; }
    if (!outcome.is_reported(lowered.err))                                                 { ret 7; }
    if (ut_count_errors(?s.diags) != 2)                                                    { ret 8; }
    if (!ut_diag_has(?s.diags, "global initialiser of `X` must be a constant expression")) { ret 17; }
    if (!ut_diag_has(?s.diags, "global initialiser of `Y` must be a constant expression")) { ret 18; }
    val mid: session.ModuleId = ut_mid(?p, ?s, "uniontest.main");
    if (mid == session.MODULE_NIL || project.module_at(?p, mid::u32).ir_module != nil) { ret 9; }
    val stable: session.StableModuleId             = ut_stable(?p, ?s, "uniontest.main");
    val begun:  res[query.Operation, outcome.Fail] = project.begin_query_phase(?p);
    if (sel begun.err) { ret 10; }
    val operation: query.Operation                 = begun.ok;
    val acquired:  res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, ?p, query.Q_LOWER, passes.back_half_key(stable, false));
    val ended:     err[fail.Fail]                  = query.end(?s.queries, operation);
    val discarded: err[fail.Fail]                  = query.discard(?s.queries, operation);
    if (sel acquired.ok)                                  { ret 11; }
    if (!fail.is_reported(acquired.err))                  { ret 12; }
    if (sel ended.ok)                                     { ret 13; }
    if (!fail.is_reported(ended.err))                     { ret 14; }
    if (sel discarded.err)                                { ret 15; }
    if (project.module_at(?p, mid::u32).ir_module != nil) { ret 16; }
    ret 0;
}

