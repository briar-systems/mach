# a grouped name or literal spans its parentheses, and every reader takes its name or value from
# the token it keeps: a comptime gate, a layout member, a decorator string
test grouped_expr__keeps_its_text {
    val src: str = "rec R { a: u8; b: u32; }\nval N: i32 = (4);\n$if ((N) != 4) { $error(\"name\"); }\n$if ((0x10) != 16) { $error(\"int\"); }\n$if (('a') != 97) { $error(\"char\"); }\n$if ((2.5) != 2.5) { $error(\"float\"); }\n$if ((\"ab\") != \"ab\") { $error(\"str\"); }\n$if ($offset_of(R, (b)) != 4) { $error(\"member\"); }\n#[section((\".text.grouped\"))]\nfun g() i32 { ret (N); }\nfun main() i32 {\n    var x: i32 = (N);\n    (x) = g();\n    ret (x) - 4;\n}\n";
    if (!ut_sema_clean(src))   { ret 1; }
    if (ut_lower_ok(src) != 0) { ret 2; }
    # an unresolved grouped name is reported by its own spelling, at the name
    if (!ut_sema_rejects_at("fun main() i32 { ret (nope); }\n", "unresolved identifier `nope`", 22, 4)) { ret 3; }

    # the values a grouped literal and a grouped assignment target carry at run time
    $if ($mach.build.os != $mach.os.linux || $mach.build.arch != $mach.arch.x86_64) { ret 0; }
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 4; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 4; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = ut_cc3(?alloc,
        "val N: i32 = (4);\n",
        "test grouped {\n    var x: i32 = (N);\n    (x) = ('a')::i32 + (1);\n    val s: *u8 = (\"hi\");\n    val p: *u8 = (nil);\n    val f: f64 = (2.5);\n    if (p != nil) { ret 11; }\n    if (f != 2.5) { ret 12; }\n    if (s[0] != 104 || s[1] != 105 || s[2] != 0) { ret 13; }\n    ret (x) - 98;\n}\n",
        ut_dispatcher_start_stub());
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 1);
    if (sel root_r.err) { ret 4; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?alloc, root); }

    val mr: res[manifest.Manifest, fail.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) { ret 4; }
    var m:  manifest.Manifest    = mr.ok;
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    rq.target       = "linux";
    rq.goal         = request.GOAL_TESTS;
    val pr: res[build_plan.BuildPlan, fail.Fail] = build_plan.plan(?alloc, ?s.interner, toolchain.t_registry(), ?m, rq);
    if (sel pr.err) { ret 4; }
    var bp: build_plan.BuildPlan                 = pr.ok;
    val r:  res[outcome.BuildOutcome, fail.Fail] = engine.execute_warm(?bp, 0, ?s, ?alloc, nil);
    if (sel r.err) {
        print.eprintln(fail.describe(r.err));
        ret 4;
    }
    var bo: outcome.BuildOutcome = r.ok;
    if (bo.severity != outcome.BUILD_OK) { ret 5; }
    if (bo.tests.len != 1)               { ret 6; }
    val art: *outcome.TestArtifact = ?bo.tests.data[0];
    val got: i32                   = ut_dispatch_status(art.exe::str, art.idx);
    if (got != 0) {
        print.eprintlnf("grouped: exit {}", got::i64);
        ret 7;
    }
    ret 0;
}

#[testing]
fun ut_lower_rejects_at(src: str, needle: str, want_offset: usize, want_len: usize) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = src;
    val pr: res[project.Project, fail.Fail] = ut_build(?s, ?alloc, ?names[0], ?texts[0], 1);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    var code: i32            = 1;
    val se:   err[fail.Fail] = driver.run_sema_pass(?p);
    if (sel se.ok) {
        val le: err[fail.Fail] = driver.run_lower_pass(?p);
        if (sel le.err) {
            var i: usize = 0;
            for (i < diagnostic.len(?p.s.diags)) {
                if (diagnostic_kind.is_error(p.s.diags.items.data[i].kind)
                    && ut_str_contains(p.s.diags.items.data[i].message, needle)
                    && p.s.diags.items.data[i].loc.span.offset == want_offset
                    && p.s.diags.items.data[i].loc.span.len == want_len) {
                    code = 0;
                }
                i = i + 1;
            }
        }
    }
    project.dnit_project(?p);
    session.dnit(?s);
    ret code;
}

test string_literal__unknown_escape_is_located {
    var bad: i32 = 0;
    if (ut_lower_rejects_at("fun main() i32 { val s: *u8 = \"\\b\"; ret 0; }\n",
        "lower: unknown escape sequence in string literal", 30, 4) != 0) { bad = 1; }
    if (ut_lower_ok("fun main() i32 { val s: *u8 = \"\\x08\"; ret 0; }\n") != 0) { bad = 1; }
    ret bad;
}

test char_literal__lowers_at_its_context_width {
    var bad: i32 = 0;
    if (!ut_lower_clean("fun f() u64 { ret '0'; }\nfun main() i32 { ret 0; }\n"))                             { bad = 1; }
    if (!ut_lower_clean("fun f(v: u64) u8 { ret ('0' + v % 10)::u8; }\nfun main() i32 { ret f(2)::i32; }\n")) { bad = 1; }
    if (!ut_lower_clean("fun f(v: u64) u8 { ret (v % 10 + '0')::u8; }\nfun main() i32 { ret f(2)::i32; }\n")) { bad = 1; }
    if (!ut_lower_clean("fun f(v: u64) u64 { ret ('0' + v)::u64; }\nfun main() i32 { ret f(2)::i32; }\n"))    { bad = 1; }
    ret bad;
}

test literal_coercion__leaves_no_stale_subtree_type {
    var bad: i32 = 0;
    if (ut_arith_operand_mismatches("fun f(a: f32, b: f32) f32 { ret a * (3.0 - 2.0 * b); }\nfun main() i32 { ret 0; }\n") != 0)         { bad = 1; }
    if (ut_arith_operand_mismatches("fun f(a: f32, b: f32) f32 { ret a * (1.0 + (3.0 - 2.0 * b)); }\nfun main() i32 { ret 0; }\n") != 0) { bad = 1; }
    if (ut_arith_operand_mismatches("fun f(a: i32, b: i32) i32 { ret a * (3 - 2 * b); }\nfun main() i32 { ret 0; }\n") != 0)             { bad = 1; }
    ret bad;
}

#[testing]
fun ut_rd_u32(b: *u8, off: u32) u32 {
    ret b[off]::u32 | (b[off + 1]::u32 << 8) | (b[off + 2]::u32 << 16) | (b[off + 3]::u32 << 24);
}

#[testing]
fun ut_rd_u64(b: *u8, off: u32) u64 {
    var v: u64 = 0;
    var i: u32 = 0;
    for (i < 8) {
        v = v | (b[off + i]::u64 << (i::u64 * 8::u64));
        i = i + 1;
    }
    ret v;
}

test const_aggregate__folds_cast_leaves {
    val src: str = "val BIG: u32 = 0x1CAFE;\nval SMALL: u8 = 200;\nval PI64: f64 = 3.5;\nval HALFf: f32 = 0.5;\nval QRTf: f32 = 0.25;\npub val IPACK: [2]u32 = [2]u32{BIG::u16::u32, SMALL::u32};\npub val FNARROW: [1]f32 = [1]f32{PI64::f32};\npub val FWIDE: [2]f64 = [2]f64{HALFf::f64, QRTf::f64};\n#[symbol(\"main\")]\npub fun main(argc: i64, argv: **u8) i32 { ret 0; }\n";

    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    val pr: res[project.Project, fail.Fail] = ut_vec_lower(?s, ?alloc, src, "linux");
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    var saw_ipack:   bool = false;
    var saw_fnarrow: bool = false;
    var saw_fwide:   bool = false;
    var ti:          u32  = 0;
    for (ti < p.topo_len) {
        val m: *me_ir.Module = project.module_at(?p, p.topo[ti]::u32).ir_module;
        if (m != nil) {
            var gi: u32 = 0;
            for (gi < m.global_len) {
                val g: *me_ir.Global = ?m.globals[gi];
                if (g.init.kind == value.VAL_CONST_AGG) {
                    val bytes: *u8 = g.init.data.agg.bytes;
                    val len:   u32 = g.init.data.agg.len;
                    if (len == 8 && ut_rd_u32(bytes, 0) == 51966 && ut_rd_u32(bytes, 4) == 200)                              { saw_ipack = true; }
                    if (len == 4 && ut_rd_u32(bytes, 0) == 0x40600000)                                                       { saw_fnarrow = true; }
                    if (len == 16 && ut_rd_u64(bytes, 0) == 0x3FE0000000000000 && ut_rd_u64(bytes, 8) == 0x3FD0000000000000) { saw_fwide = true; }
                }
                gi = gi + 1;
            }
        }
        ti = ti + 1;
    }

    var bad: i32 = 0;
    if (!saw_ipack)   { bad = 1; }
    if (!saw_fnarrow) { bad = 1; }
    if (!saw_fwide)   { bad = 1; }

    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

# 0 when a project whose mid module forwards leaf.original_name under two names links
#[testing]
fun ut_fwd_renamed_links(main_text: str) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var names:  [3]str              = [3]str{"main.mach", "mid.mach", "leaf.mach"};
    var texts:  [3]str              = [3]str{main_text, "fwd renamed_alias: uniontest.leaf.original_name;\nfwd uniontest.leaf.original_name;\n", "pub fun original_name() i32 { ret 42; }\n"};
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 3);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?alloc, root); }
    val pr: res[project.Project, fail.Fail] = ut_back_half(?s, root);
    if (sel pr.err) { ret 1; }
    var p: project.Project = pr.ok;
    fin { project.dnit_project(?p); }
    val set_link_config_input_r: err[fail.Fail] = engine.set_link_config_input(?p, "out/app"::*u8, "app"::*u8, 0, nil, 0, nil, 0, nil);
    if (sel set_link_config_input_r.err) { ret 1; }
    val rl: res[bool, fail.Fail] = driver.run_link_pass(?p);
    if (sel rl.err) { ret 2; }
    ret 0;
}

# a renamed re-export links across the module boundary whichever order its names are imported in
test fwd__renamed_reexport_links {
    val qualified: i32 = ut_fwd_renamed_links("use uniontest.mid;\nfun main() i32 { ret mid.renamed_alias() - mid.original_name(); }\n");
    if (qualified != 0) { ret 10 + qualified; }
    val leaves: i32 = ut_fwd_renamed_links("use uniontest.mid.renamed_alias;\nuse uniontest.mid.original_name;\nfun main() i32 { ret renamed_alias() - original_name(); }\n");
    if (leaves != 0) { ret 20 + leaves; }
    ret 0;
}

#[testing]
fun ut_arith_operand_mismatches(text: str) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret -1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret -1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = text;

    val pr: res[project.Project, fail.Fail] = ut_build(?s, ?alloc, ?names[0], ?texts[0], 1);
    if (sel pr.err) {
        session.dnit(?s);
        ret -1;
    }
    var p: project.Project = pr.ok;

    var out: i32            = -1;
    val sem: err[fail.Fail] = driver.run_sema_pass(?p);
    if (sel sem.ok && ut_count_errors(?s.diags) == 0) {
        val low: err[fail.Fail] = driver.run_lower_pass(?p);
        if (sel low.ok && ut_count_errors(?s.diags) == 0) {
            var arith:      u32 = 0;
            var mismatched: u32 = 0;
            var ti:         u32 = 0;
            for (ti < p.topo_len) {
                val m: *me_ir.Module = project.module_at(?p, p.topo[ti]::u32).ir_module;
                if (m != nil) {
                    var fi: u32 = 0;
                    for (fi < m.function_len) {
                        val fn: *me_ir.Function = ?m.functions[fi];
                        var ii: u32             = 0;
                        for (ii < fn.instr_len) {
                            val ins: *ir_instruction.Instruction = ?fn.instrs[ii];
                            if (ins.kind == ir_instruction.OP_ADD || ins.kind == ir_instruction.OP_SUB
                                || ins.kind == ir_instruction.OP_MUL || ins.kind == ir_instruction.OP_DIV_S
                                || ins.kind == ir_instruction.OP_DIV_U) {
                                arith = arith + 1;
                                var oi: u32 = 0;
                                for (oi < ins.operand_count) {
                                    if (!ir_type.same(ins.operands[oi].ty, ins.ty)) { mismatched = mismatched + 1; }
                                    oi = oi + 1;
                                }
                            }
                            ii = ii + 1;
                        }
                        fi = fi + 1;
                    }
                }
                ti = ti + 1;
            }
            out = mismatched::i32;
            if (arith == 0) { out = -2; }
        }
    }

    project.dnit_project(?p);
    session.dnit(?s);
    ret out;
}

#[testing]
fun ut_condition_truth_ops(text: str, cbrs: *u32, nots: *u32) bool {
    @cbrs = 0;
    @nots = 0;
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret false; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret false; }
    var s:     session.Session = sr.ok;
    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = text;
    val pr: res[project.Project, fail.Fail] = ut_build(?s, ?alloc, ?names[0], ?texts[0], 1);
    if (sel pr.err) {
        session.dnit(?s);
        ret false;
    }
    var p:                project.Project = pr.ok;
    val run_sema_pass_r:  err[fail.Fail]  = driver.run_sema_pass(?p);
    val run_lower_pass_r: err[fail.Fail]  = driver.run_lower_pass(?p);
    if (sel run_sema_pass_r.err) {
        project.dnit_project(?p);
        session.dnit(?s);
        ret false;
    }
    if (sel run_lower_pass_r.err) {
        project.dnit_project(?p);
        session.dnit(?s);
        ret false;
    }
    var ok: bool = true;
    var mi: u32  = 0;
    for (mi < project.module_count(?p)) {
        val m: *me_ir.Module = project.module_at(?p, mi).ir_module;
        if (m == nil) {
            mi = mi + 1;
            cnt;
        }
        var fi: u32 = 0;
        for (fi < m.function_len) {
            val fn: *me_ir.Function = ?m.functions[fi];
            var ii: u32             = 0;
            for (ii < fn.instr_len) {
                var ins:     *ir_instruction.Instruction = ?fn.instrs[ii];
                var inspect: bool                        = false;
                if (ins.kind == ir_instruction.OP_CBR && ins.operand_count == 3) {
                    @cbrs = @cbrs + 1;
                    if (ins.operands[0].kind != value.VAL_INSTR) { ok = false; }
                    or {
                        val cmp: *ir_instruction.Instruction = ?fn.instrs[ir_id.instruction_index(ins.operands[0].data.instr)];
                        inspect = cmp.kind == ir_instruction.OP_CMP_EQ;
                        ins     = cmp;
                    }
                }
                or (ins.kind == ir_instruction.OP_CMP_NE) {
                    inspect = true;
                    @nots   = @nots + 1;
                }
                if (inspect) {
                    if (ins.operand_count != 2) { ok = false; }
                    or {
                        val a_one: bool = ins.operands[0].kind == value.VAL_CONST_INT && ins.operands[0].data.int_lit == 1;
                        val b_one: bool = ins.operands[1].kind == value.VAL_CONST_INT && ins.operands[1].data.int_lit == 1;
                        if (!a_one && !b_one) { ok = false; }
                    }
                }
                ii = ii + 1;
            }
            fi = fi + 1;
        }
        mi = mi + 1;
    }
    project.dnit_project(?p);
    session.dnit(?s);
    ret ok;
}

test condition__truth_is_a_compare_with_one {
    val text: str = "fun choose(v: u8) u8 { if (v) { ret 1; } ret 0; }\nfun repeat(v: u8) u8 { for (v) { ret 1; } ret 0; }\nfun both(a: u8, b: u8) u8 { ret a && b; }\nfun either(a: u8, b: u8) u8 { ret a || b; }\nfun invert(v: u8) u8 { ret !v; }\nfun main() i32 { choose(0); choose(1); choose(2); ret 0; }\n";
    var cbrs: u32 = 0;
    var nots: u32 = 0;
    if (!ut_condition_truth_ops(text, ?cbrs, ?nots)) { ret 1; }
    if (cbrs != 4 || nots != 1)                      { ret 1; }
    ret 0;
}

# the same parsed bracket is read as a generic call or an index as its names change, and the
# reused syntax tree is never rewritten
test bracket__reinterprets_without_rewriting_the_tree {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val initialized: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel initialized.err) { ret 2; }
    var s: session.Session = initialized.ok;
    fin { session.dnit(?s); }
    var names:    [2]str = [2]str{"main.mach", "lib.mach"};
    var versions: [2]str = [2]str{
        "pub def Key: i64;\npub fun item[T](v: T) T { ret v; }\n",
        "pub val Key: u64 = 0;\nfun identity(v: i64) i64 { ret v; }\npub val item: [1]fun(i64) i64 = [1]fun(i64) i64{identity};\n"
    };
    var texts: [2]str = [2]str{
        "use uniontest.lib.item;\nuse uniontest.lib.Key;\nfun main() i64 { ret item[Key](3); }\n", versions[0]
    };
    val scaffold: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 2);
    if (sel scaffold.err) { ret 4; }
    val root: str = scaffold.ok;
    fin {
        fs.remove_all(?alloc, root);
        str_free(?alloc, root);
    }
    val joined: res[str, A.Error] = types_path.join(?alloc, root, "src/lib.mach");
    if (sel joined.err) { ret 5; }
    val filename: str = joined.ok;
    fin { str_free(?alloc, filename); }
    var saved: *ast_expr.Expr = nil;
    var count: usize          = 0;
    fin {
        if (saved != nil) { A.deallocate[ast_expr.Expr](?alloc, saved, count); }
    }
    var owner:       *ast.Ast       = nil;
    var incarnation: u64            = 0;
    var selected:    ast_id.ExprId  = ast_id.EXPR_NIL;
    var revision:    query.Revision = 0;
    var round:       u32            = 0;
    for (round < 3) {
        val version:       u32             = round % 2;
        val write_bytes_r: err[fs.FsError] = fs.write_bytes(filename, versions[version], str_len(versions[version]), 420);
        if (sel write_bytes_r.err) { ret 6; }
        val opened: res[project.Project, fail.Fail] = driver.build_project_union(?s, root);
        if (sel opened.err) { ret 7; }
        var p: project.Project = opened.ok;
        fin { project.dnit_project(?p); }
        val mid: session.ModuleId = ut_mid(?p, ?s, "uniontest.main");
        if (module.is_nil(mid)) { ret 8; }
        val parsed: *ast.Ast = project.module_at(?p, mid::u32).a;
        if (parsed == nil) { ret 9; }
        val current: query.Revision = query.peek_revision(?s.queries, query.Q_PARSE, lang_source.file_index(project.module_at(?p, mid::u32).file_id)::u64);
        if (round == 0) {
            owner       = parsed;
            incarnation = parsed.incarnation;
            revision    = current;
            count       = parsed.exprs.len;
            val storage: res[*ast_expr.Expr, A.Error] = A.allocate[ast_expr.Expr](?alloc, count);
            if (sel storage.err) { ret 10; }
            saved = storage.ok;
            memory.copy[ast_expr.Expr](saved, parsed.exprs.data, count);
            var i: usize = 0;
            for (i < count) {
                if (saved[i].kind == ast_expr.EXPR_KIND_CALL && !ast_id.expr_is_nil(saved[i].data.call.index_callee)) {
                    if (!ast_id.expr_is_nil(selected)) { ret 11; }
                    selected = ast_id.expr(i::u32);
                }
                i = i + 1;
            }
            if (ast_id.expr_is_nil(selected) || revision == 0) { ret 12; }
        }
        if (parsed != owner || parsed.incarnation != incarnation || parsed.exprs.len != count || current != revision
            || !memory.equal[ast_expr.Expr](saved, parsed.exprs.data, count)) { ret 13; }
        val run_sema_pass_r: err[fail.Fail] = driver.run_sema_pass(?p);
        if (sel run_sema_pass_r.err) {
            var di: usize = 0;
            for (di < diagnostic.len(?s.diags)) {
                print.eprintln(s.diags.items.data[di].message);
                di = di + 1;
            }
            ret 14;
        }
        val interpreted: res[ast_expr.Expr, fail.Fail] = resolve.expression(project.module_at(?p, mid::u32).resolve_result, parsed, selected);
        if (sel interpreted.err) { ret 15; }
        val node: ast_expr.Expr = interpreted.ok;
        if (node.kind != ast_expr.EXPR_KIND_CALL || !ast_id.expr_is_nil(node.data.call.index_callee))                                                                   { ret 16; }
        if (version == 0 && (node.data.call.type_args_len != 1 || !ast_id.expr_same(node.data.call.callee, saved[ast_id.expr_index(selected)].data.call.callee)))       { ret 17; }
        if (version == 1 && (node.data.call.type_args_len != 0 || !ast_id.expr_same(node.data.call.callee, saved[ast_id.expr_index(selected)].data.call.index_callee))) { ret 18; }
        val run_lower_pass_r: err[fail.Fail] = driver.run_lower_pass(?p);
        if (sel run_lower_pass_r.err)                                      { ret 19; }
        if (!memory.equal[ast_expr.Expr](saved, parsed.exprs.data, count)) { ret 20; }
        round = round + 1;
    }
    ret 0;
}

#[testing]
fun ut_ir_text(text: str, out: *u8, cap: usize, out_len: *usize) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = text;
    val pr: res[project.Project, fail.Fail] = ut_build(?s, ?alloc, ?names[0], ?texts[0], 1);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    var code: i32            = 1;
    val se:   err[fail.Fail] = driver.run_sema_pass(?p);
    if (sel se.ok) {
        val le: err[fail.Fail] = driver.run_lower_pass(?p);
        if (sel le.ok) {
            var b: io_writer.Memory;
            var w: io_writer.Writer = io_writer.memory(?b, out, cap);

            code = 0;
            var ti: u32 = 0;
            for (ti < p.topo_len) {
                val m: *me_ir.Module = project.module_at(?p, p.topo[ti]::u32).ir_module;
                if (m != nil) {
                    var d: ir_printer.IrWriter = ir_printer.ir_writer(?w, m, ?p.s.interner, ?p.s.sources,
                        ir_printer.ir_context("post-lower", "t", "i", "o", "a", "f"), ir_printer.IR_FORM_DEBUG);
                    val write_debug_r: err[fail.Fail] = ir_printer.write_ir(?d);
                    if (sel write_debug_r.err) { code = 1; }
                }
                ti = ti + 1;
            }
            @out_len = b.len;
        }
    }
    project.dnit_project(?p);
    session.dnit(?s);
    ret code;
}

# whether the post-lower ir text of `src` contains `needle`
#[testing]
fun ut_ir_text_has(src: str, needle: str) bool {
    val CAP: usize = 262144;
    var buf: [262144]u8;
    var len: usize = 0;
    if (ut_ir_text(src, ?buf[0], CAP, ?len) != 0) { ret false; }
    val n:  usize = str_len(needle);
    val np: *u8   = needle::*u8;
    if (n == 0 || n > len) { ret false; }
    var i: usize = 0;
    for (i + n <= len) {
        var j: usize = 0;
        for (j < n && buf[i + j] == np[j]) { j = j + 1; }
        if (j == n) { ret true; }
        i = i + 1;
    }
    ret false;
}

# ordering compares public addresses, so it lowers to the same unsigned integer
# compare a `usize` would, with no widening and no signed form
test pointer_compare__lowers_to_an_unsigned_compare {
    val src: str = "fun f(a: *^u8, b: *^u8) u8 { ret a < b; }\n#[symbol(\"main\")]\nfun main() i32 { ret 0; }\n";
    if (!ut_ir_text_has(src, "cmp_lt_u")) { ret 1; }
    if (ut_ir_text_has(src, "cmp_lt_s"))  { ret 2; }
    ret 0;
}

#[testing]
fun ut_global_uses(m: *me_ir.Module, gi: u32) u32 {
    ret ut_operand_uses(m, value.VAL_GLOBAL, gi::u64);
}

#[testing]
fun ut_has_extern_global(s: *session.Session, m: *me_ir.Module, needle: str) bool {
    if (m == nil) { ret false; }
    var gi: u32 = 0;
    for (gi < m.global_len) {
        val g: *me_ir.Global = ?m.globals[gi];
        if (g.is_extern) {
            val nm: opt[str] = intern.get(?s.interner, g.name);
            if (sel nm.some && ut_str_contains(nm.some, needle)) { ret true; }
        }
        gi = gi + 1;
    }
    ret false;
}

#[testing]
fun ut_has_extern_fn(s: *session.Session, m: *me_ir.Module, needle: str) bool {
    if (m == nil) { ret false; }
    var fi: u32 = 0;
    for (fi < m.function_len) {
        val f: *me_ir.Function = ?m.functions[fi];
        if ((f.flags & me_ir.FN_FLAG_EXTERN) != 0) {
            val nm: opt[str] = intern.get(?s.interner, f.name);
            if (sel nm.some && ut_str_contains(nm.some, needle)) { ret true; }
        }
        fi = fi + 1;
    }
    ret false;
}

# how a module value reaches an importer: a qualified or leaf-imported `val` folds to its
# own module's value whatever shadows it, a same-module global folds through a cross-module
# base, an own `val` folds and its global goes unused, an aliased import folds, a `fun`, a
# `var`, a pointer `val` and a string `val` stay references to one definition, and a `def`
# is the declaring module's
test module_const__folds_across_modules {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }

    var names: [4]str = [4]str{"main.mach", "a.mach", "b.mach", "c.mach"};
    var texts: [4]str;
    texts[0] = "use uniontest.a;\nuse uniontest.a.K;\nuse uniontest.a.MSG;\nuse x: uniontest.c;\nuse uniontest.b;\nval X: i64 = 707;\nval A: u64 = a.BASE + 0x48;\nval B: u64 = A + 8;\ndef T: [9]u8;\nfun f() i64 { ret 101; }\nvar G: i64 = 404;\npub val N: i64 = 6543;\npub fun p1() i64 { ret a.X; }\npub fun p2() i64 { ret X; }\npub fun p3() i64 { ret b.Y; }\npub fun p4() i64 { ret b.K; }\npub fun p5() i64 { ret K; }\npub fun p6() u64 { ret B; }\npub fun p7() i64 { ret a.f(); }\npub fun p8() i64 { ret a.G; }\npub fun p9() u64 { ret $size_of(a.T); }\npub fun p10() i64 { val L: i64 = 808; ret a.L + L; }\npub fun p11() i64 { ret N; }\npub fun p12() i64 { ret x.N; }\npub fun p13() ptr { ret x.PH; }\npub fun p14() ptr { ret a.MSG; }\npub fun p15() ptr { ret MSG; }\nfun main() i32 { ret 0; }\n";
    texts[1] = "pub val X: i64 = 909;\npub val K: i64 = 303;\npub rec P { x: u64; y: u64; }\npub val BASE: u64 = $size_of(P);\npub def T: [7]u8;\npub fun f() i64 { ret 202; }\npub var G: i64 = 505;\npub val L: i64 = 616;\npub val MSG: ptr = \"hello\";\n";
    texts[2] = "pub val Y: i64 = 1505;\npub val K: i64 = 606;\n";
    texts[3] = "pub val N: i64 = 4321;\npub var H: i64 = 1;\npub val PH: ptr = ?H;\n";

    val pr: res[project.Project, fail.Fail] = ut_lower_n(?s, ?alloc, ?names[0], ?texts[0], 4);
    if (sel pr.err) { ret 2; }
    var p: project.Project = pr.ok;
    fin { project.dnit_project(?p); }
    if (ut_count_errors(?p.s.diags) != 0) { ret 3; }
    val m: *me_ir.Module = ut_ir_of(?p, ?s, "uniontest.main");
    if (m == nil) { ret 4; }

    var folded: [9]u64 = [9]u64{909, 707, 1505, 606, 303, 0x60, 1424, 6543, 4321};
    var i:      usize  = 0;
    for (i < 9) {
        if (ut_const_uses(m, folded[i]) != 1) { ret (10 + i)::i32; }
        i = i + 1;
    }
    val gx: i64 = ut_global_ix(?s, m, "uniontest.main.X");
    if (gx < 0 || ut_global_uses(m, gx::u32) != 0 || (?m.globals[gx::u32]).init.data.int_lit != 707) { ret 20; }
    val gn: i64 = ut_global_ix(?s, m, "uniontest.main.N");
    if (gn < 0 || ut_global_uses(m, gn::u32) != 0 || (?m.globals[gn::u32]).init.data.int_lit != 6543) { ret 21; }
    if (!ut_has_extern_fn(?s, m, "uniontest.a.f"))                                                    { ret 22; }
    if (!ut_has_extern_global(?s, m, "uniontest.a.G"))                                                { ret 23; }
    if (ut_const_uses(m, 7) != 1 || ut_const_uses(m, 9) != 0)                                         { ret 24; }
    if (ut_has_extern_global(?s, m, "uniontest.c.N"))                                                 { ret 25; }
    if (!ut_has_extern_global(?s, m, "uniontest.c.PH"))                                               { ret 26; }
    if (!ut_has_extern_global(?s, m, "uniontest.a.MSG"))                                              { ret 27; }
    if (ut_rodata_globals(m) != 0)                                                                    { ret 28; }
    ret 0;
}

test global_init__folds_nested_scalar_casts {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "def Word: u64;\nval ALL: Word = ~(0::Word);\nval BYTE: u8 = ~((0::u8) | (0::u8));\nval SIGNED: i8 = (255u8:~i8);\nval HIGH: u64 = (128u8:~i8)::u64;\nval EXP: u64 = ((5.0:~u64) >> 52);\nfun main() i32 { $if ((~((0::u8) + (0::u8))) != 255u8) { $error(\"nested bitwise width\"); } $if (((5.0:~u64) >> 52) != 1025) { $error(\"nested cast gate\"); } ret 0; }\n";
    val pr: res[project.Project, fail.Fail] = ut_lower_n(?s, ?alloc, ?names[0], ?texts[0], 1);
    if (sel pr.err) { ret 2; }
    var p: project.Project = pr.ok;
    fin { project.dnit_project(?p); }
    if (ut_count_errors(?s.diags) != 0) { ret 3; }
    val m: *me_ir.Module = ut_ir_of(?p, ?s, "uniontest.main");
    if (m == nil) { ret 4; }
    var labels: [5]str;
    labels[0] = "uniontest.main.ALL";
    labels[1] = "uniontest.main.BYTE";
    labels[2] = "uniontest.main.SIGNED";
    labels[3] = "uniontest.main.HIGH";
    labels[4] = "uniontest.main.EXP";
    var expected: [5]u64;
    expected[0] = 0xFFFFFFFFFFFFFFFF;
    expected[1] = 255;
    expected[2] = 0xFFFFFFFFFFFFFFFF;
    expected[3] = 0xFFFFFFFFFFFFFF80;
    expected[4] = 1025;
    var i: u32 = 0;
    for (i < 5) {
        val gi: i64 = ut_global_ix(?s, m, labels[i]);
        if (gi < 0) { ret 5; }
        val init: value.Value = m.globals[gi::u32].init;
        if (init.kind != value.VAL_CONST_INT || init.data.int_lit != expected[i]) { ret (6 + i)::i32; }
        i = i + 1;
    }
    ret 0;
}

# a same-module global cycle is refused at each global, and the rejected module leaves no
# lower query product behind
test global_init__cycle_is_refused_with_no_lower_product {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "val X: u64 = Y;\nval Y: u64 = X;\nfun main() i32 { ret 0; }\n";
    val rooted: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 1);
    if (sel rooted.err) { ret 2; }
    val root: str = rooted.ok;
    fin { fs.remove_all(?alloc, root); }
    var selection: manifest.Selectors              = ut_target_sel("linux");
    val built:     res[project.Project, fail.Fail] = driver.build_project(?s, root, ?selection);
    if (sel built.err) { ret 4; }
    var p: project.Project = built.ok;
    fin { project.dnit_project(?p); }
    val run_sema_pass_r: err[fail.Fail] = driver.run_sema_pass(?p);
    if (sel run_sema_pass_r.err) { ret 5; }
    val lowered: err[fail.Fail] = driver.run_lower_pass(?p);
    if (sel lowered.ok)                                                                    { ret 6; }
    if (!fail.is_reported(lowered.err))                                                    { ret 7; }
    if (ut_count_errors(?s.diags) != 2)                                                    { ret 8; }
    if (!ut_diag_has(?s.diags, "global initialiser of `X` must be a constant expression")) { ret 17; }
    if (!ut_diag_has(?s.diags, "global initialiser of `Y` must be a constant expression")) { ret 18; }
    val mid: session.ModuleId = ut_mid(?p, ?s, "uniontest.main");
    if (module.is_nil(mid) || project.module_at(?p, mid::u32).ir_module != nil) { ret 9; }
    val stable: session.StableModuleId          = ut_stable(?p, ?s, "uniontest.main");
    val begun:  res[query.Operation, fail.Fail] = project.begin_query_phase(?p);
    if (sel begun.err) { ret 10; }
    val operation: query.Operation                 = begun.ok;
    val acquired:  res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, ?p, query.Q_LOWER, passes.back_half_key(stable, false));
    val ended:     err[fail.Fail]                  = query.end(?s.queries, operation);
    val discarded: err[fail.Fail]                  = query.discard(?s.queries, operation);
    if (sel acquired.ok)                                  { ret 11; }
    if (!fail.is_reported(acquired.err))                  { ret 12; }
    if (sel ended.ok)                                     { ret 13; }
    if (!fail.is_reported(ended.err))                     { ret 14; }
    if (sel discarded.err)                                { ret 15; }
    if (project.module_at(?p, mid::u32).ir_module != nil) { ret 16; }
    ret 0;
}

test global_init__same_module_forward_reference_is_refused {
