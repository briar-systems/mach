test conditions_require_u8 {
    var bad: i32 = 0;
    if (!ut_sema_clean("fun f(a: u8, b: u8) u8 { if (a) { ret !b; } for (b) { ret a && b; } ret a || b; }\nfun main() i32 { ret 0; }\n"))                  { bad = 1; }
    if (!ut_sema_rejects_with("fun f(a: u16) i32 { if (a) { ret 1; } ret 0; }\nfun main() i32 { ret 0; }\n", "condition must have type u8"))               { bad = 1; }
    if (!ut_sema_rejects_with("fun f(a: i8) i32 { for (a) { ret 1; } ret 0; }\nfun main() i32 { ret 0; }\n", "condition must have type u8"))               { bad = 1; }
    if (!ut_sema_rejects_with("fun f(a: u8, b: u32) u8 { ret a && b; }\nfun main() i32 { ret 0; }\n", "logical operands must have type u8"))               { bad = 1; }
    if (!ut_sema_rejects_with("fun f(a: u32) u8 { ret !a; }\nfun main() i32 { ret 0; }\n", "unary ! requires a u8 operand"))                               { bad = 1; }
    if (!ut_sema_rejects_with("fun none() {}\nfun f() i32 { if (none()) { ret 1; } ret 0; }\nfun main() i32 { ret 0; }\n", "condition must have type u8")) { bad = 1; }
    if (!ut_sema_rejects_with("fun none() {}\nfun f(a: u8) u8 { ret none() && a; }\nfun main() i32 { ret 0; }\n", "logical operands must have type u8"))   { bad = 1; }
    if (!ut_sema_rejects_with("fun none() {}\nfun f(a: u8) u8 { ret a || none(); }\nfun main() i32 { ret 0; }\n", "logical operands must have type u8"))   { bad = 1; }
    if (!ut_sema_rejects_with("fun none() {}\nfun f() u8 { ret !none(); }\nfun main() i32 { ret 0; }\n", "unary ! requires a u8 operand"))                 { bad = 1; }
    ret bad;
}

fun ut_condition_truth_ops(text: str, cbrs: *u32, nots: *u32) bool {
    @cbrs = 0;
    @nots = 0;
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret false; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret false; }
    var s:     session.Session = sr.ok;
    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = text;
    val pr: res[project.Project, outcome.Fail] = ut_build(?s, ?alloc, ?names[0], ?texts[0], 1);
    if (sel pr.err) {
        session.dnit(?s);
        ret false;
    }
    var p:                project.Project   = pr.ok;
    val run_sema_pass_r:  err[outcome.Fail] = driver.run_sema_pass(?p);
    val run_lower_pass_r: err[outcome.Fail] = driver.run_lower_pass(?p);
    if (sel run_sema_pass_r.err) {
        project.dnit_project(?p);
        session.dnit(?s);
        ret false;
    }
    if (sel run_lower_pass_r.err) {
        project.dnit_project(?p);
        session.dnit(?s);
        ret false;
    }
    var ok: bool = true;
    var mi: u32  = 0;
    for (mi < project.module_count(?p)) {
        val m: *ir.Module = project.module_at(?p, mi).ir_module;
        if (m == nil) {
            mi = mi + 1;
            cnt;
        }
        var fi: u32 = 0;
        for (fi < m.function_len) {
            val fn: *ir.Function = ?m.functions[fi];
            var ii: u32          = 0;
            for (ii < fn.instr_len) {
                var ins:     *instruction.Instruction = ?fn.instrs[ii];
                var inspect: bool                     = false;
                if (ins.kind == instruction.OP_CBR && ins.operand_count == 3) {
                    @cbrs = @cbrs + 1;
                    if (ins.operands[0].kind != value.VAL_INSTR) { ok = false; }
                    or {
                        val cmp: *instruction.Instruction = ?fn.instrs[ins.operands[0].data.instr];
                        inspect = cmp.kind == instruction.OP_CMP_EQ;
                        ins     = cmp;
                    }
                }
                or (ins.kind == instruction.OP_CMP_NE) {
                    inspect = true;
                    @nots   = @nots + 1;
                }
                if (inspect) {
                    if (ins.operand_count != 2) { ok = false; }
                    or {
                        val a_one: bool = ins.operands[0].kind == value.VAL_CONST_INT && ins.operands[0].data.int_lit == 1;
                        val b_one: bool = ins.operands[1].kind == value.VAL_CONST_INT && ins.operands[1].data.int_lit == 1;
                        if (!a_one && !b_one) { ok = false; }
                    }
                }
                ii = ii + 1;
            }
            fi = fi + 1;
        }
        mi = mi + 1;
    }
    project.dnit_project(?p);
    session.dnit(?s);
    ret ok;
}

test condition_truth_is_exactly_one {
    val text: str = "fun choose(v: u8) u8 { if (v) { ret 1; } ret 0; }\nfun repeat(v: u8) u8 { for (v) { ret 1; } ret 0; }\nfun both(a: u8, b: u8) u8 { ret a && b; }\nfun either(a: u8, b: u8) u8 { ret a || b; }\nfun invert(v: u8) u8 { ret !v; }\nfun main() i32 { choose(0); choose(1); choose(2); ret 0; }\n";
    var cbrs: u32 = 0;
    var nots: u32 = 0;
    if (!ut_condition_truth_ops(text, ?cbrs, ?nots)) { ret 1; }
    if (cbrs != 4 || nots != 1)                      { ret 1; }
    ret 0;
}

test same_name_type_mismatch_names_its_modules {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var bad:   i32 = 0;
    val need:  str = "two different types that share the name";
    val a_src: str = "pub rec P { a: u8; }\npub rec Other { a: u8; }\npub rec Box[T] { a: T; }\n";

    bad = bad | 1 * ut_pair_note(?alloc, "use a: uniontest.a;\nrec P { a: u8; }\nfun main() i64 { var x: P; var y: a.P; x = y; ret 0; }\n", a_src, need);
    bad = bad | 2 * ut_pair_note(?alloc, "use a: uniontest.a;\nrec P { a: u8; }\nfun main() i64 { var x: P; var y: a.P; x = y; ret 0; }\n", a_src, "the first is declared in `uniontest.main`");
    bad = bad | 4 * ut_pair_note(?alloc, "use a: uniontest.a;\nrec P { a: u8; }\nfun main() i64 { var x: P; var y: a.P; x = y; ret 0; }\n", a_src, "the second in `uniontest.a`");

    bad = bad | 8 * ut_pair_note(?alloc, "use a: uniontest.a;\nrec Box[T] { a: T; }\nfun main() i64 { var x: Box[u8]; var y: a.Box[u8]; x = y; ret 0; }\n", a_src, need);

    bad = bad | 16 * ut_pair_note(?alloc, "use a: uniontest.a;\nrec P { a: u8; b: u64; }\nfun cast(x: P) a.P { ret x:~a.P; }\nfun main() i64 { ret 0; }\n", a_src, need);

    ret bad;
}

# the negative interchange check behind `of.SectionId` (#3113): a section
# identity is a record, so handing it where a symbol index, a table index or a
# plain u32 is meant is a type error, not a silent reinterpretation. the records
# mirror the object model's shape because a snippet project cannot import the
# compiler's own modules; the rule pinned here is the one the real type rests on.
test section_identity_is_not_another_identity_domain {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var bad:   i32 = 0;
    val a_src: str = "pub rec SectionId { index: u32; }\npub rec SymbolId { index: u32; }\npub rec Symbol { name: u32; section: SectionId; }\npub fun symbol_at(id: SymbolId) u32 { ret id.index; }\npub fun section_index(id: SectionId) u32 { ret id.index; }\n";

    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:  session.Session                    = sr.ok;
    val pr: res[project.Project, outcome.Fail] = ut_sema2(?s, ?alloc,
        "use a: uniontest.a;\nfun main() i64 { var sym: a.Symbol; val n: u32 = a.symbol_at(sym.section); ret n::i64; }\n", a_src);
    if (!ut_project_was_rejected(pr)) {
        session.dnit(?s);
        ret 2;
    }
    if (!ut_diag_has(?s.diags, "type mismatch: expected SymbolId, found SectionId")) { bad = 1; }
    session.dnit(?s);

    val sr2: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr2.err) { ret 1; }
    var s2:  session.Session                    = sr2.ok;
    val pr2: res[project.Project, outcome.Fail] = ut_sema2(?s2, ?alloc,
        "use a: uniontest.a;\nfun main() i64 { var sym: a.Symbol; var table: [4]u32; ret table[sym.section]::i64; }\n", a_src);
    if (!ut_project_was_rejected(pr2)) {
        session.dnit(?s2);
        ret 3;
    }
    if (!ut_diag_has(?s2.diags, "index must be an integer")) { bad = bad | 2; }
    session.dnit(?s2);

    val sr3: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr3.err) { ret 1; }
    var s3:  session.Session                    = sr3.ok;
    val pr3: res[project.Project, outcome.Fail] = ut_sema2(?s3, ?alloc,
        "use a: uniontest.a;\nfun main() i64 { var sym: a.Symbol; val raw: u32 = 3; sym.section = raw; ret 0; }\n", a_src);
    if (!ut_project_was_rejected(pr3)) {
        session.dnit(?s3);
        ret 4;
    }
    if (!ut_diag_has(?s3.diags, "type mismatch: expected SectionId, found u32")) { bad = bad | 4; }
    session.dnit(?s3);

    val sr4: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr4.err) { ret 1; }
    var s4:  session.Session                    = sr4.ok;
    val pr4: res[project.Project, outcome.Fail] = ut_sema2(?s4, ?alloc,
        "use a: uniontest.a;\nfun main() i64 { var sym: a.Symbol; var table: [4]u32; ret table[a.section_index(sym.section)]::i64; }\n", a_src);
    if (ut_project_was_rejected(pr4)) {
        session.dnit(?s4);
        ret 5;
    }
    session.dnit(?s4);
    ret bad;
}

# the negative interchange check behind `mir.VRegId` / `mir.PRegId` (#2212,
# the #3114 acceptance): a virtual register cannot be assigned where a
# physical one is meant, a physical one cannot stand in for a virtual one, a
# vreg number cannot become a memory index without naming its case, and
# neither identity indexes a table without the unwrap. the records and the
# tag mirror the operand's shape because a snippet project cannot import the
# compiler's own modules; the rule pinned here is the one MirOperand rests on.
test register_identity_is_not_another_identity_domain {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var bad:   i32 = 0;
    val a_src: str = "pub rec VRegId { n: u32; }\npub rec PRegId { n: u32; }\npub tag MirIndex: u8 { none; vreg: VRegId; preg: PRegId; }\npub rec MirOperand { vreg: VRegId; preg: PRegId; index: MirIndex; }\npub fun vreg_id(n: u32) VRegId { var v: VRegId; v.n = n; ret v; }\npub fun preg_id(regid: i32) PRegId { var p: PRegId; p.n = regid::u32; ret p; }\n";

    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:  session.Session                    = sr.ok;
    val pr: res[project.Project, outcome.Fail] = ut_sema2(?s, ?alloc,
        "use a: uniontest.a;\nfun main() i64 { var op: a.MirOperand; op.preg = op.vreg; ret 0; }\n", a_src);
    if (!ut_project_was_rejected(pr)) {
        session.dnit(?s);
        ret 2;
    }
    if (!ut_diag_has(?s.diags, "type mismatch: expected PRegId, found VRegId")) { bad = 1; }
    session.dnit(?s);

    val sr2: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr2.err) { ret 1; }
    var s2:  session.Session                    = sr2.ok;
    val pr2: res[project.Project, outcome.Fail] = ut_sema2(?s2, ?alloc,
        "use a: uniontest.a;\nfun main() i64 { var op: a.MirOperand; op.vreg = a.preg_id(3); ret 0; }\n", a_src);
    if (!ut_project_was_rejected(pr2)) {
        session.dnit(?s2);
        ret 3;
    }
    if (!ut_diag_has(?s2.diags, "type mismatch: expected VRegId, found PRegId")) { bad = bad | 2; }
    session.dnit(?s2);

    val sr3: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr3.err) { ret 1; }
    var s3:  session.Session                    = sr3.ok;
    val pr3: res[project.Project, outcome.Fail] = ut_sema2(?s3, ?alloc,
        "use a: uniontest.a;\nfun main() i64 { var op: a.MirOperand; val raw: u32 = 3; op.preg = raw; ret 0; }\n", a_src);
    if (!ut_project_was_rejected(pr3)) {
        session.dnit(?s3);
        ret 4;
    }
    if (!ut_diag_has(?s3.diags, "type mismatch: expected PRegId, found u32")) { bad = bad | 4; }
    session.dnit(?s3);

    val sr4: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr4.err) { ret 1; }
    var s4:  session.Session                    = sr4.ok;
    val pr4: res[project.Project, outcome.Fail] = ut_sema2(?s4, ?alloc,
        "use a: uniontest.a;\nfun main() i64 { var op: a.MirOperand; op.index = op.vreg; ret 0; }\n", a_src);
    if (!ut_project_was_rejected(pr4)) {
        session.dnit(?s4);
        ret 5;
    }
    if (!ut_diag_has(?s4.diags, "type mismatch: expected MirIndex, found VRegId")) { bad = bad | 8; }
    session.dnit(?s4);

    val sr5: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr5.err) { ret 1; }
    var s5:  session.Session                    = sr5.ok;
    val pr5: res[project.Project, outcome.Fail] = ut_sema2(?s5, ?alloc,
        "use a: uniontest.a;\nfun main() i64 { var op: a.MirOperand; var table: [4]u32; ret table[op.vreg]::i64; }\n", a_src);
    if (!ut_project_was_rejected(pr5)) {
        session.dnit(?s5);
        ret 6;
    }
    if (!ut_diag_has(?s5.diags, "index must be an integer")) { bad = bad | 16; }
    session.dnit(?s5);

    val sr6: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr6.err) { ret 1; }
    var s6:  session.Session                    = sr6.ok;
    val pr6: res[project.Project, outcome.Fail] = ut_sema2(?s6, ?alloc,
        "use a: uniontest.a;\nfun main() i64 { var op: a.MirOperand; op.preg = a.preg_id(3); op.index = a.MirIndex.vreg{op.vreg}; var table: [4]u32; ret table[op.vreg.n]::i64; }\n", a_src);
    if (ut_project_was_rejected(pr6)) {
        session.dnit(?s6);
        ret 7;
    }
    session.dnit(?s6);
    ret bad;
}

test distinct_name_type_mismatch_keeps_its_note {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var bad:   i32 = 0;
    val need:  str = "two different types that share the name";
    val a_src: str = "pub rec P { a: u8; }\npub rec Other { a: u8; }\npub rec Box[T] { a: T; }\n";

    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:  session.Session                    = sr.ok;
    val pr: res[project.Project, outcome.Fail] = ut_sema2(?s, ?alloc,
        "use a: uniontest.a;\nrec P { a: u8; }\nfun main() i64 { var x: P; var y: a.Other; x = y; ret 0; }\n", a_src);
    if (!ut_project_was_rejected(pr)) {
        session.dnit(?s);
        ret 1;
    }
    if (!ut_diag_has(?s.diags, "type mismatch: expected P, found Other")) { bad = 1; }
    if (!ut_diag_note_has(?s.diags, "mach has no implicit widening"))     { bad = 1; }
    if (ut_diag_note_has(?s.diags, need))                                 { bad = 1; }
    session.dnit(?s);

    val sr2: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr2.err) { ret 1; }
    var s2:  session.Session                    = sr2.ok;
    val pr2: res[project.Project, outcome.Fail] = ut_sema2(?s2, ?alloc,
        "fun main() i64 { var x: u8; var y: i64; x = y; ret 0; }\n", a_src);
    if (!ut_project_was_rejected(pr2)) {
        session.dnit(?s2);
        ret 1;
    }
    if (!ut_diag_has(?s2.diags, "type mismatch: expected u8, found i64")) { bad = 1; }
    if (!ut_diag_note_has(?s2.diags, "mach has no implicit widening"))    { bad = 1; }
    if (ut_diag_note_has(?s2.diags, need))                                { bad = 1; }
    session.dnit(?s2);
    ret bad;
}

fun ut_pair_note(alloc: *A.Allocator, main_s: str, a_src: str, needle: str) i32 {
    val sr: res[session.Session, fail.Fail] = session.init(alloc);
    if (sel sr.err) { ret 1; }
    var s:  session.Session                    = sr.ok;
    val pr: res[project.Project, outcome.Fail] = ut_sema2(?s, alloc, main_s, a_src);
    if (!ut_project_was_rejected(pr)) {
        session.dnit(?s);
        ret 1;
    }
    var rc: i32 = 1;
    if (ut_diag_note_has(?s.diags, needle)) { rc = 0; }
    session.dnit(?s);
    ret rc;
}

test bracket_value_keeps_subscripts {
    var bad: i32 = 0;

    if (!ut_sema_clean("fun main() i64 { val i: u64 = 1; val a: [4]i64 = [4]i64{1, 2, 3, 4}; ret a[i]; }\n"))              { bad = 1; }
    if (!ut_sema_clean("fun main() i64 { val i: u64 = 0; var a: [4]i64; val p: *i64 = ?a[0]; ret p[i]; }\n"))              { bad = 1; }
    if (!ut_sema_clean("def T: i64;\nfun main() i64 { val T: u64 = 1; val a: [4]i64 = [4]i64{1, 2, 3, 4}; ret a[T]; }\n")) { bad = 1; }
    if (!ut_sema_clean("fun main() i64 { val i: u64 = 0; val j: u64 = 1; var m: [2][2]i64; ret m[i][j]; }\n"))             { bad = 1; }

    if (!ut_sema_rejects_with("fun main() i64 { var a: [4]i64; ret a[*i32]; }\n",
        "does not name a generic function")) { bad = 1; }

    if (!ut_sema_rejects_with("pub fun ident[T](s: T) T { ret s; }\nfun main() i64 { ret ident[0]; }\n",
        "not indexable: a function has no elements")) { bad = 1; }
    ret bad;
}

# `x[start, count]` (#3779): two names read both ways and name resolution picks
# by what the object is, in callee and value position alike
test range_bracket_readings {
    var bad: i32 = 0;

    if (!ut_sema_clean("val N: u64 = 2;\nfun main() i64 { val s: u64 = 1; val a: [4]i64 = [4]i64{1, 2, 3, 4}; val r: [2]i64 = a[s, N]; ret r[1]; }\n")) { bad = 1; }
    if (!ut_sema_clean("fun main() i64 { val a: [4]i64 = [4]i64{1, 2, 3, 4}; val r: [2]i64 = a[1, 2]; ret r[0]; }\n"))                                  { bad = 2; }
    if (!ut_sema_rejects_with("val N: u64 = 2;\nfun id(x: i64) i64 { ret x; }\nfun main() i64 { val s: u64 = 0; val t: [2]fun(i64) i64 = [2]fun(i64) i64{id, id}; ret t[s, N](3); }\n",
        "not callable")) { bad = 3; }
    if (!ut_sema_clean("pub fun first[T, U](a: T, b: U) T { ret a; }\nfun main() i64 { ret first[i64, u64](3, 4); }\n"))                                 { bad = 4; }
    if (!ut_sema_clean("pub fun first[T, U](a: T, b: U) T { ret a; }\nfun main() i64 { val f: fun(i64, u64) i64 = first[i64, u64]; ret f(3, 4); }\n"))   { bad = 5; }
    if (!ut_lower_clean("val N: u64 = 2;\nfun main() i64 { val s: u64 = 1; val a: [4]i64 = [4]i64{1, 2, 3, 4}; val r: [2]i64 = a[s, N]; ret r[1]; }\n")) { bad = 6; }
    ret bad;
}

test range_types_and_bounds {
    var bad: i32 = 0;

    # the result types: a vector of the lanes, an array of the elements
    if (!ut_sema_clean("fun main() i64 { val v: i16x8 = i16x8{1, 2, 3, 4, 5, 6, 7, 8}; val h: i16x4 = v[4, 4]; ret h[0]::i64; }\n"))                 { bad = 1; }
    if (!ut_sema_clean("fun main() i64 { var a: [4]f32; val p: *f32 = ?a[0]; val r: [3]f32 = p[1, 3]; ret r[0]::i64; }\n"))                          { bad = 2; }
    if (!ut_sema_clean("fun main() i64 { var a: [4]f32; val p: *f32 = ?a[0]; val v: f32x4 = p[0, 4]::f32x4; p[0, 4] = (v * v)::[4]f32; ret 0; }\n")) { bad = 3; }
    if (!ut_sema_clean("fun main() i64 { var v: u32x4 = u32x4{1, 2, 3, 4}; v[2, 2] = v[0, 2]; ret v[3]::i64; }\n"))                                  { bad = 4; }

    # the count is a positive comptime constant
    if (!ut_sema_rejects_with("fun main() i64 { val n: u64 = 2; val a: [4]i64 = [4]i64{1, 2, 3, 4}; val r: [2]i64 = a[0, n]; ret r[0]; }\n",
        "range count is not a comptime constant")) { bad = 5; }
    if (!ut_sema_rejects_with("fun main() i64 { val a: [4]i64 = [4]i64{1, 2, 3, 4}; val r: [2]i64 = a[0, -1]; ret r[0]; }\n",
        "range count -1 is negative")) { bad = 6; }
    if (!ut_sema_rejects_with("fun main() i64 { val a: [4]i64 = [4]i64{1, 2, 3, 4}; val r: [2]i64 = a[0, 0]; ret r[0]; }\n",
        "range count 0 is empty")) { bad = 7; }

    # a constant start keeps the range inside an array or a vector, and may end at its length
    if (!ut_sema_clean("fun main() i64 { val a: [4]i64 = [4]i64{1, 2, 3, 4}; val r: [2]i64 = a[2, 2]; ret r[0]; }\n")) { bad = 8; }
    if (!ut_sema_rejects_with("fun main() i64 { val a: [4]i64 = [4]i64{1, 2, 3, 4}; val r: [2]i64 = a[3, 2]; ret r[0]; }\n",
        "range [3, 2] is out of bounds for `[4]i64` of length 4")) { bad = 9; }
    if (!ut_sema_clean("fun main() i64 { val v: u32x4 = u32x4{1, 2, 3, 4}; val r: u32x2 = v[2, 2]; ret r[0]::i64; }\n")) { bad = 10; }
    if (!ut_sema_rejects_with("fun main() i64 { val v: u32x4 = u32x4{1, 2, 3, 4}; val r: u32x3 = v[2, 3]; ret r[0]::i64; }\n",
        "range [2, 3] is out of bounds for `u32x4` of length 4")) { bad = 11; }
    if (!ut_sema_rejects_with("fun main() i64 { val v: u32x4 = u32x4{1, 2, 3, 4}; val r: u32x2 = v[5, 2]; ret r[0]::i64; }\n",
        "range [5, 2] is out of bounds for `u32x4` of length 4")) { bad = 12; }

    # a vector range's start is a constant, as a lane index is, and it takes two lanes or more
    if (!ut_sema_rejects_with("fun main() i64 { val i: u64 = 0; val v: u32x4 = u32x4{1, 2, 3, 4}; val r: u32x2 = v[i, 2]; ret r[0]::i64; }\n",
        "a vector range's start must be a comptime constant")) { bad = 13; }
    if (!ut_sema_rejects_with("fun main() i64 { val v: u32x4 = u32x4{1, 2, 3, 4}; val r: u32 = v[1, 1]; ret r::i64; }\n",
        "a vector range needs at least 2 lanes")) { bad = 14; }

    # the stored value has the range's type
    if (!ut_sema_rejects("fun main() i64 { var a: [4]i64; val b: [3]i64 = [3]i64{1, 2, 3}; a[0, 2] = b; ret a[0]; }\n"))        { bad = 15; }
    if (!ut_sema_rejects("fun main() i64 { var v: u32x4 = u32x4{1, 2, 3, 4}; v[0, 2] = u32x4{1, 2, 3, 4}; ret v[0]::i64; }\n")) { bad = 16; }

    # a range is a value, not a view
    if (!ut_sema_rejects_with("fun main() i64 { var a: [4]i64; val p: *[2]i64 = ?a[0, 2]; ret 0; }\n", "a range")) { bad = 17; }
    if (!ut_sema_rejects("fun main() i64 { var a: [4]i64; a[0, 2][1] = 3; ret a[1]; }\n"))                         { bad = 18; }
    ret bad;
}

test bracket_interpretation_changes_without_rewriting_reused_syntax {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val initialized: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel initialized.err) { ret 2; }
    var s: session.Session = initialized.ok;
    fin { session.dnit(?s); }
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) { ret 3; }
    var names:    [2]str = [2]str{"main.mach", "lib.mach"};
    var versions: [2]str = [2]str{
        "pub def Key: i64;\npub fun item[T](v: T) T { ret v; }\n",
        "pub val Key: u64 = 0;\nfun identity(v: i64) i64 { ret v; }\npub val item: [1]fun(i64) i64 = [1]fun(i64) i64{identity};\n"
    };
    var texts: [2]str = [2]str{
        "use uniontest.lib.item;\nuse uniontest.lib.Key;\nfun main() i64 { ret item[Key](3); }\n", versions[0]
    };
    val scaffold: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 2);
    if (sel scaffold.err) { ret 4; }
    val root: str = scaffold.ok;
    fin {
        fs.remove_all(?alloc, root);
        str_free(?alloc, root);
    }
    val joined: res[str, A.Error] = path.join(?alloc, root, "src/lib.mach");
    if (sel joined.err) { ret 5; }
    val filename: str = joined.ok;
    fin { str_free(?alloc, filename); }
    var saved: *aexpr.Expr = nil;
    var count: usize       = 0;
    fin {
        if (saved != nil) { A.deallocate[aexpr.Expr](?alloc, saved, count); }
    }
    var owner:       *ast.Ast       = nil;
    var incarnation: u64            = 0;
    var selected:    aid.ExprId     = aid.EXPR_NIL;
    var revision:    query.Revision = 0;
    var round:       u32            = 0;
    for (round < 3) {
        val version:       u32             = round % 2;
        val write_bytes_r: err[fs.FsError] = fs.write_bytes(filename, versions[version], str_len(versions[version]), 420);
        if (sel write_bytes_r.err) { ret 6; }
        val opened: res[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
        if (sel opened.err) { ret 7; }
        var p: project.Project = opened.ok;
        fin { project.dnit_project(?p); }
        val mid: session.ModuleId = ut_mid(?p, ?s, "uniontest.main");
        if (mid == session.MODULE_NIL) { ret 8; }
        val parsed: *ast.Ast = project.module_at(?p, mid::u32).a;
        if (parsed == nil) { ret 9; }
        val current: query.Revision = query.peek_revision(?s.queries, query.Q_PARSE, project.module_at(?p, mid::u32).file_id::u64);
        if (round == 0) {
            owner       = parsed;
            incarnation = parsed.incarnation;
            revision    = current;
            count       = parsed.expr_len;
            val storage: res[*aexpr.Expr, A.Error] = A.allocate[aexpr.Expr](?alloc, count);
            if (sel storage.err) { ret 10; }
            saved = storage.ok;
            memory.copy[aexpr.Expr](saved, parsed.exprs, count);
            var i: usize = 0;
            for (i < count) {
                if (saved[i].kind == aexpr.EXPR_KIND_CALL && saved[i].data.call.index_callee != aid.EXPR_NIL) {
                    if (selected != aid.EXPR_NIL) { ret 11; }
                    selected = i::aid.ExprId;
                }
                i = i + 1;
            }
            if (selected == aid.EXPR_NIL || revision == 0) { ret 12; }
        }
        if (parsed != owner || parsed.incarnation != incarnation || parsed.expr_len != count || current != revision
            || !memory.equal[aexpr.Expr](saved, parsed.exprs, count)) { ret 13; }
        val run_sema_pass_r: err[outcome.Fail] = driver.run_sema_pass(?p);
        if (sel run_sema_pass_r.err) {
            var di: usize = 0;
            for (di < diagnostic.len(?s.diags)) {
                print.eprintln(s.diags.items.data[di].message);
                di = di + 1;
            }
            ret 14;
        }
        val interpreted: res[aexpr.Expr, fail.Fail] = resolve.expression(project.module_at(?p, mid::u32).resolve_result, parsed, selected);
        if (sel interpreted.err) { ret 15; }
        val node: aexpr.Expr = interpreted.ok;
        if (node.kind != aexpr.EXPR_KIND_CALL || node.data.call.index_callee != aid.EXPR_NIL)                                       { ret 16; }
        if (version == 0 && (node.data.call.type_args_len != 1 || node.data.call.callee != saved[selected].data.call.callee))       { ret 17; }
        if (version == 1 && (node.data.call.type_args_len != 0 || node.data.call.callee != saved[selected].data.call.index_callee)) { ret 18; }
        val run_lower_pass_r: err[outcome.Fail] = driver.run_lower_pass(?p);
        if (sel run_lower_pass_r.err)                              { ret 19; }
        if (!memory.equal[aexpr.Expr](saved, parsed.exprs, count)) { ret 20; }
        round = round + 1;
    }
    ret 0;
}

test qualified_module_const_folds_into_val {
    var bad: i32 = 0;
    val lib: str = "pub val KINDS: u64 = 2;\npub val ACTIONS: u64 = 11;\npub val SLOTS: u64 = KINDS * ACTIONS;\n";

    if (!ut_sema_clean2("use uniontest.lib;\nval CAP: u64 = lib.SLOTS;\nrec C { slots: [CAP]u8; }\nfun main() i64 { ret 0; }\n", lib)) { bad = 1; }

    if (!ut_sema_clean2("use a: uniontest.lib;\nval CAP: u64 = a.SLOTS * 2;\nrec C { slots: [CAP]u8; }\nfun main() i64 { ret 0; }\n", lib)) { bad = 1; }

    if (!ut_sema_clean2("use uniontest.lib;\nval CAP: u64 = lib.SLOTS;\nval MORE: u64 = CAP + 1;\nfun main() i64 { $if (MORE != 23) { $error(\"WRONG\"); } ret 0; }\n", lib)) { bad = 1; }

    if (ut_vec_diag2("use uniontest.lib;\nval CAP: u64 = lib.SLOTS;\nfun main() i64 { $if (CAP != 99) { $error(\"FIRED\"); } ret 0; }\n", lib, "FIRED") != 0) { bad = 1; }

    if (ut_vec_diag2("use uniontest.lib;\nval CAP: u64 = lib.HIDDEN;\nrec C { slots: [CAP]u8; }\nfun main() i64 { ret 0; }\n",
        "val HIDDEN: u64 = 4;\n", "exported by") != 0) { bad = 1; }

    ret bad;
}

test addr_of_packed_field_rejected {
    var bad:  i32 = 0;
    val need: str = "cannot take the address of a field of a `#[packed]` record";

    if (!ut_sema_rejects_with("#[packed]\nrec P { a: u8; b: u32; arr: [2]u32; }\nrec In { x: u32; }\n#[packed]\nrec Q { a: u8; i: In; }\nfun main() i64 { var r: P; val p: ptr = ?r.b; ret p::i64; }\n", need))                 { bad = 1; }
    if (!ut_sema_rejects_with("#[packed]\nrec P { a: u8; b: u32; arr: [2]u32; }\nrec In { x: u32; }\n#[packed]\nrec Q { a: u8; i: In; }\nfun main() i64 { var r: P; val p: ptr = ?r.arr[0]; ret p::i64; }\n", need))            { bad = 1; }
    if (!ut_sema_rejects_with("#[packed]\nrec P { a: u8; b: u32; arr: [2]u32; }\nrec In { x: u32; }\n#[packed]\nrec Q { a: u8; i: In; }\nfun main() i64 { var q: Q; val p: ptr = ?q.i.x; ret p::i64; }\n", need))               { bad = 1; }
    if (!ut_sema_rejects_with("#[packed]\nrec P { a: u8; b: u32; arr: [2]u32; }\nrec In { x: u32; }\n#[packed]\nrec Q { a: u8; i: In; }\nfun main() i64 { var r: P; val q: *P = ?r; val p: ptr = ?q.b; ret p::i64; }\n", need)) { bad = 1; }

    if (!ut_sema_clean("#[packed]\nrec P { a: u8; b: u32; arr: [2]u32; }\nrec In { x: u32; }\n#[packed]\nrec Q { a: u8; i: In; }\nfun main() i64 { var r: P; val p: ptr = ?r; ret p::i64; }\n")) { bad = 1; }
    if (!ut_sema_clean("rec R { a: u8; b: u32; }\nfun main() i64 { var r: R; val p: ptr = ?r.b; ret p::i64; }\n"))                                                                               { bad = 1; }
    if (!ut_sema_clean("rec In { x: u32; }\nrec R { a: u8; i: In; }\nfun main() i64 { var r: R; val p: ptr = ?r.i.x; ret p::i64; }\n"))                                                          { bad = 1; }
    if (!ut_sema_clean("#[packed]\nrec P { a: u8; b: u32; arr: [2]u32; }\nrec In { x: u32; }\n#[packed]\nrec Q { a: u8; i: In; }\nfun main() i64 { var r: P; r.b = 7; ret r.b::i64; }\n"))       { bad = 1; }

    if (!ut_sema_rejects_with("#[packed]\nrec P { a: u8; b: u32; }\ndef PA: P;\nfun main() i64 { var r: PA; val p: ptr = ?r.b; ret p::i64; }\n", need))                                            { bad = 1; }
    if (!ut_sema_rejects_with("#[packed]\nrec Box[T] { a: u8; v: T; }\nfun main() i64 { var b: Box[u32]; val p: ptr = ?b.v; ret p::i64; }\n", need))                                               { bad = 1; }
    if (!ut_sema_rejects_with("#[packed]\nrec Box[T] { a: u8; v: T; }\nfun f[T](b: *Box[T]) i64 { val p: ptr = ?b.v; ret p::i64; }\nfun main() i64 { var b: Box[u32]; ret f[u32](?b); }\n", need)) { bad = 1; }
    if (!ut_sema_clean("rec Box[T] { a: u8; v: T; }\nfun main() i64 { var b: Box[u32]; val p: ptr = ?b.v; ret p::i64; }\n"))                                                                       { bad = 1; }
    ret bad;
}

test c_variadic_tail_contract {
    var bad: i32 = 0;

    if (!ut_sema_clean("ext fun p(t: *u8, ...) i64;\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var b: u8; p(?b); p(?b, 1::i32); p(?b, 1::i32, 2::i64, 3.5::f64, ?b); ret 0; }\n")) { bad = 1; }

    if (ut_vec_diag("ext fun p(t: *u8, n: i64, ...) i64;\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var b: u8; p(?b); ret 0; }\n",
        "expected at least 2") != 0) { bad = 1; }

    if (ut_vec_diag("ext fun p(t: *u8, ...) i64;\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var b: u8; var c: u8 = 65; p(?b, c); ret 0; }\n",
        "promoted to a 32-bit integer") != 0) { bad = 1; }
    if (ut_vec_diag("ext fun p(t: *u8, ...) i64;\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var b: u8; var f: f32 = 1.5; p(?b, f); ret 0; }\n",
        "promoted to `f64`") != 0) { bad = 1; }
    if (!ut_sema_clean("ext fun p(t: *u8, ...) i64;\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var b: u8; var c: u8 = 65; var f: f32 = 1.5; p(?b, c::i32, f::f64); ret 0; }\n")) { bad = 1; }

    if (ut_vec_diag("ext fun p(t: *u8, ...) i64;\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var b: u8; var s: ^i64 = 1; p(?b, s); ret 0; }\n",
        "secret value cannot be passed to a C-variadic") != 0) { bad = 1; }

    if (ut_vec_diag("ext fun q(t: *u8) i64;\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var b: u8; q(?b, 1::i64); ret 0; }\n",
        "arity mismatch") != 0) { bad = 1; }

    if (ut_vec_diag("ext fun r(t: *u8, ...) i64 { ret 0; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "cannot have a body") != 0) { bad = 1; }

    ret bad;
}

test recursive_type_occurs_check {
    val need: str = "recursive type has infinite size";

    var bad: i32 = 0;
    if (!ut_sema_rejects_with("rec R { next: R; }\nfun main() i32 { ret 0; }\n", need))                                      { bad = 1; }
    if (!ut_sema_rejects_with("rec R { next: R; }\nfun main() i32 { var r: R; ret 0; }\n", need))                            { bad = 1; }
    if (!ut_sema_rejects_with("uni U { a: u32; b: U; }\nfun main() i32 { ret 0; }\n", need))                                 { bad = 1; }
    if (!ut_sema_rejects_with("rec R { a: [4]R; }\nfun main() i32 { ret 0; }\n", need))                                      { bad = 1; }
    if (!ut_sema_rejects_with("rec A { b: B; }\nrec B { a: A; }\nfun main() i32 { ret 0; }\n", need))                        { bad = 1; }
    if (!ut_sema_rejects_with("rec A { b: B; }\nrec B { c: C; }\nrec C { a: A; }\nfun main() i32 { ret 0; }\n", need))       { bad = 1; }
    if (!ut_sema_rejects_with("rec R { a: rec { b: R; }; }\nfun main() i32 { ret 0; }\n", need))                             { bad = 1; }
    if (!ut_sema_rejects_with("rec W[T] { v: T; inner: W[T]; }\nfun main() i32 { var w: W[i32]; ret 0; }\n", need))          { bad = 1; }
    if (!ut_sema_rejects_with("rec Wrap[T] { inner: Wrap[Wrap[T]]; }\nfun main() i32 { var w: Wrap[i32]; ret 0; }\n", need)) { bad = 1; }

    if (!ut_sema_clean("rec Node { next: *Node; }\nfun main() i32 { var n: Node; ret 0; }\n"))                                                         { bad = 1; }
    if (!ut_sema_clean("rec A { b: *B; }\nrec B { a: *A; }\nfun main() i32 { var a: A; ret 0; }\n"))                                                   { bad = 1; }
    if (!ut_sema_clean("uni U { a: u32; b: *U; }\nfun main() i32 { var u: U; ret 0; }\n"))                                                             { bad = 1; }
    if (!ut_sema_clean("rec R { a: [4]*R; }\nfun main() i32 { var r: R; ret 0; }\n"))                                                                  { bad = 1; }
    if (!ut_sema_clean("rec Leaf { v: u8; }\nrec L { l: Leaf; }\nrec Rt { r: Leaf; }\nrec D { x: L; y: Rt; }\nfun main() i32 { var d: D; ret 0; }\n")) { bad = 1; }
    if (!ut_sema_clean("rec N0 { v: u8; }\nrec N1 { v: N0; }\nrec N2 { v: N1; }\nrec N3 { v: N2; }\nfun main() i32 { var n: N3; ret 0; }\n"))          { bad = 1; }
    ret bad;
}

test recursive_union_reports_its_real_defect {
    var bad: i32 = 0;

    val rec_uni: str = "uni U[T] { a: u32; b: U[U[T]]; }\nfun main() i32 { var u: U[i32]; ret 0; }\n";
    if (!ut_sema_rejects_with(rec_uni, "recursive type has infinite size")) { bad = 1; }
    if (ut_sema_errs(rec_uni) != 1)                                         { bad = 1; }

    val need: str = "union variants must agree on secrecy";
    if (!ut_sema_rejects_with("uni M { a: ^u32; b: u32; }\nfun main() i32 { ret 0; }\n", need))                                   { bad = 1; }
    if (!ut_sema_rejects_with("rec P { s: ^u32; }\nrec Q { s: u32; }\nuni D { a: P; b: Q; }\nfun main() i32 { ret 0; }\n", need)) { bad = 1; }
    if (!ut_sema_rejects_with("uni S { a: ^u32; b: S; c: u32; }\nfun main() i32 { ret 0; }\n", need))                             { bad = 1; }
    ret bad;
}

test contains_float_deep_finds_float_through_an_array {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var bad:     i32              = 0;
    val f32_opt: opt[type.TypeId] = type.prim(?s.types, type.TYPE_F32);
    if (sel f32_opt.some) {
        val arr_r: res[type.TypeId, fail.Fail] = type.intern_array(?s.types, f32_opt.some, 4);
        if (sel arr_r.ok) {
            val found: res[bool, fail.Fail] = generics.contains_float_deep(?s, arr_r.ok);
            if (sel found.err) { ret 99; }
            if (!found.ok)     { bad = 1; }
        }
    }

    session.dnit(?s);
    ret bad;
}

