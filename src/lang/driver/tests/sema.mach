        "unknown float literal suffix") != 0) { bad = 4; }
    if (ut_vec_diag("fun f() f32 { val x: f32 = 1.5f; ret x; }\nfun main() i32 { ret 0; }\n",
        "unknown float literal suffix") != 0) { bad = 5; }

    ret bad;
}

test binary_operands_need_one_type {
    var bad: i32 = 0;

    if (!ut_sema_rejects("fun f(a: u32, b: i64) u32 { ret a + b; }\nfun main() i32 { ret 0; }\n")) { bad = 1; }
    if (!ut_sema_rejects_with("fun f(a: u32, b: i64) u32 { ret a + b; }\nfun main() i32 { ret 0; }\n",
        "cast one operand explicitly")) { bad = 1; }
    if (!ut_sema_rejects("fun f(a: u32, b: u8) u32 { ret a - b; }\nfun main() i32 { ret 0; }\n"))  { bad = 1; }
    if (!ut_sema_rejects("fun f(a: u32, b: i32) u32 { ret a * b; }\nfun main() i32 { ret 0; }\n")) { bad = 1; }
    if (!ut_sema_rejects("fun f(a: u32, b: u64) u32 { ret a & b; }\nfun main() i32 { ret 0; }\n")) { bad = 1; }
    if (!ut_sema_rejects("fun f(a: u32, b: u64) u32 { ret a | b; }\nfun main() i32 { ret 0; }\n")) { bad = 1; }
    if (!ut_sema_rejects("fun f(a: u32, b: u64) u32 { ret a ^ b; }\nfun main() i32 { ret 0; }\n")) { bad = 1; }
    if (!ut_sema_rejects("fun f(a: u32, b: i64) u32 { ret b + a; }\nfun main() i32 { ret 0; }\n")) { bad = 1; }

    if (!ut_sema_clean("fun f(a: u32, b: i64) u32 { ret a + b::u32; }\nfun main() i32 { ret 0; }\n")) { bad = 1; }
    if (!ut_sema_clean("fun f(a: u32, b: u8) u32 { ret a << b; }\nfun main() i32 { ret 0; }\n"))      { bad = 1; }
    if (!ut_sema_clean("fun f(a: u32, b: u8) u32 { ret a >> b; }\nfun main() i32 { ret 0; }\n"))      { bad = 1; }
    if (!ut_sema_clean("fun f(a: u32, b: i64) u8 { ret a < b; }\nfun main() i32 { ret 0; }\n"))       { bad = 1; }
    if (!ut_sema_clean("fun f(a: u32, b: i64) u8 { ret a == b; }\nfun main() i32 { ret 0; }\n"))      { bad = 1; }
    if (!ut_sema_clean("fun f(a: ^u32, b: u32) ^u32 { ret a + b; }\nfun main() i32 { ret 0; }\n"))    { bad = 1; }
    if (!ut_sema_clean("fun f(a: u32) u32 { ret a + 1; }\nfun main() i32 { ret 0; }\n"))              { bad = 1; }

    ret bad;
}

fun ut_ir_text(text: str, out: *u8, cap: usize, out_len: *usize) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = text;
    val pr: res[project.Project, outcome.Fail] = ut_build(?s, ?alloc, ?names[0], ?texts[0], 1);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    var code: i32               = 1;
    val se:   err[outcome.Fail] = driver.run_sema_pass(?p);
    if (sel se.ok) {
        val le: err[outcome.Fail] = driver.run_lower_pass(?p);
        if (sel le.ok) {
            var b: UtIrTextBuf;
            b.data = out;
            b.len  = 0;
            b.cap  = cap;
            var w: writer.Writer;
            w.ctx     = (?b)::ptr;
            w.f_write = ut_ir_text_write;

            code = 0;
            var ti: u32 = 0;
            for (ti < p.topo_len) {
                val m: *ir.Module = project.module_at(?p, p.topo[ti]::u32).ir_module;
                if (m != nil) {
                    var d: printer.IrWriter = printer.ir_writer(?w, m, ?p.s.interner, ?p.s.sources,
                        printer.ir_context("post-lower", "t", "i", "o", "a", "f"), printer.IR_FORM_DEBUG);
                    val write_debug_r: err[fail.Fail] = printer.write_ir(?d);
                    if (sel write_debug_r.err) { code = 1; }
                }
                ti = ti + 1;
            }
            @out_len = b.len;
        }
    }
    project.dnit_project(?p);
    session.dnit(?s);
    ret code;
}

fun ut_ir_text_equal(a_src: str, b_src: str) i32 {
    val CAP: usize = 262144;
    var ba:  [262144]u8;
    var bb:  [262144]u8;
    var la:  usize = 0;
    var lb:  usize = 0;
    if (ut_ir_text(a_src, ?ba[0], CAP, ?la) != 0) { ret 2; }
    if (ut_ir_text(b_src, ?bb[0], CAP, ?lb) != 0) { ret 2; }
    if (la == 0)                                  { ret 2; }
    if (la != lb)                                 { ret 1; }
    var i: usize = 0;
    for (i < la) {
        if (ba[i] != bb[i]) { ret 1; }
        i = i + 1;
    }
    ret 0;
}

# `:^` and `:^T` are no operator on any operand shape: the parse stops at the
# colon and the statement's terminator check reports it; `:>T` builds
test colon_caret_is_refused_at_the_colon {
    val msg: str = "expected ';' after 'ret'";
    if (!ut_sema_rejects_with("fun down(a: ^u32) u32 { ret a:^u32; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { down(1); ret 0; }\n", msg))       { ret 1; }
    if (!ut_sema_rejects_with("fun down(a: ^u32) u32 { ret a:^; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { down(1); ret 0; }\n", msg))          { ret 2; }
    if (!ut_sema_rejects_with("fun down(a: ^*u8) *u8 { ret a:^*u8; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n", msg))                { ret 3; }
    if (!ut_sema_rejects_with("fun down(a: ^u32x4) u32x4 { ret a:^u32x4; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n", msg))          { ret 4; }
    if (!ut_sema_rejects_with("rec K { d: [4]u8; }\nfun down(a: ^K) K { ret a:^K; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n", msg)) { ret 5; }
    if (!ut_sema_rejects_with("fun down(a: ^[4]u32) [4]u32 { ret a:^[4]u32; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n", msg))       { ret 6; }

    val scalar_new: str = "fun down(a: ^u32) u32 { ret a:>u32; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { down(1); ret 0; }\n";
    val other:      str = "fun down(a: ^u32) u32 { ret (a:>u32) + 1; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { down(1); ret 0; }\n";
    if (ut_ir_text_equal(scalar_new, scalar_new) != 0) { ret 7; }
    if (ut_ir_text_equal(scalar_new, other) != 1)      { ret 8; }
    ret 0;
}

# whether the post-lower ir text of `src` contains `needle`
fun ut_ir_text_has(src: str, needle: str) bool {
    val CAP: usize = 262144;
    var buf: [262144]u8;
    var len: usize = 0;
    if (ut_ir_text(src, ?buf[0], CAP, ?len) != 0) { ret false; }
    val n:  usize = str_len(needle);
    val np: *u8   = needle::*u8;
    if (n == 0 || n > len) { ret false; }
    var i: usize = 0;
    for (i + n <= len) {
        var j: usize = 0;
        for (j < n && buf[i + j] == np[j]) { j = j + 1; }
        if (j == n) { ret true; }
        i = i + 1;
    }
    ret false;
}

# ordering compares public addresses, so it lowers to the same unsigned integer
# compare a `usize` would, with no widening and no signed form
test pointer_ordering_lowers_to_an_unsigned_compare {
    val src: str = "fun f(a: *^u8, b: *^u8) u8 { ret a < b; }\n#[symbol(\"main\")]\nfun main() i32 { ret 0; }\n";
    if (!ut_ir_text_has(src, "cmp_lt_u")) { ret 1; }
    if (ut_ir_text_has(src, "cmp_lt_s"))  { ret 2; }
    ret 0;
}

# `$mach.build.*` has no manifest-defined members (#3131): a name outside the
# known set is refused at the use site as an unknown path, and a known member
# on the line before it still resolves
test unknown_mach_build_member_is_refused_at_the_use_site {
    val src: str = "val w: u64 = $mach.build.pointer_width;\nval n: u64 = $mach.build.nosuch;\nfun main() i32 { ret 0; }\n";
    if (!ut_sema_rejects_at(src, "unknown `$mach.*` path", 53, 18))                             { ret 1; }
    if (!ut_sema_clean("val w: u64 = $mach.build.pointer_width;\nfun main() i32 { ret 0; }\n")) { ret 2; }
    ret 0;
}

test fin_boundary_control_flow_rejected {
    var bad: i32 = 0;
    if (!ut_sema_rejects("fun f() i64 { fin { ret 1; } ret 0; }\nfun main() i32 { ret 0; }\n"))                                                        { bad = 1; }
    if (!ut_sema_rejects("fun f() { fin { fin { ret; } } }\nfun main() i32 { ret 0; }\n"))                                                             { bad = 1; }
    if (!ut_sema_rejects("fun f() { var i: i64 = 0; for (i < 3) { fin { brk; } i = i + 1; } }\nfun main() i32 { ret 0; }\n"))                          { bad = 1; }
    if (!ut_sema_rejects("fun f() { var i: i64 = 0; for (i < 3) { fin { cnt; } i = i + 1; } }\nfun main() i32 { ret 0; }\n"))                          { bad = 1; }
    if (!ut_sema_rejects("fun f() { fin { var j: i64 = 0; for (j < 2) { fin { brk; } j = j + 1; } } }\nfun main() i32 { ret 0; }\n"))                  { bad = 1; }
    if (!ut_sema_clean("fun f() { fin { var j: i64 = 0; for (j < 4) { if (j == 2) { brk; } j = j + 1; } } }\nfun main() i32 { ret 0; }\n"))            { bad = 1; }
    if (!ut_sema_clean("fun f() { fin { var j: i64 = 0; for (j < 4) { j = j + 1; cnt; } } }\nfun main() i32 { ret 0; }\n"))                            { bad = 1; }
    if (!ut_sema_clean("fun f() i64 { var i: i64 = 0; for (i < 3) { fin { i = i + 1; } if (i == 2) { brk; } } ret i; }\nfun main() i32 { ret 0; }\n")) { bad = 1; }
    ret bad;
}

fun ut_global_uses(m: *ir.Module, gi: u32) u32 {
    ret ut_operand_uses(m, value.VAL_GLOBAL, gi::u64);
}

fun ut_has_extern_global(s: *session.Session, m: *ir.Module, needle: str) bool {
    if (m == nil) { ret false; }
    var gi: u32 = 0;
    for (gi < m.global_len) {
        val g: *ir.Global = ?m.globals[gi];
        if (g.is_extern) {
            val nm: opt[str] = intern.lookup(?s.interner, g.name);
            if (sel nm.some && ut_str_contains(nm.some, needle)) { ret true; }
        }
        gi = gi + 1;
    }
    ret false;
}

fun ut_has_extern_fn(s: *session.Session, m: *ir.Module, needle: str) bool {
    if (m == nil) { ret false; }
    var fi: u32 = 0;
    for (fi < m.function_len) {
        val f: *ir.Function = ?m.functions[fi];
        if ((f.flags & ir.FN_FLAG_EXTERN) != 0) {
            val nm: opt[str] = intern.lookup(?s.interner, f.name);
            if (sel nm.some && ut_str_contains(nm.some, needle)) { ret true; }
        }
        fi = fi + 1;
    }
    ret false;
}

test qualified_const_ignores_local_val_shadow {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [3]str;
    names[0] = "main.mach";
    names[1] = "a.mach";
    names[2] = "b.mach";
    var texts: [3]str;
    texts[0] = "use uniontest.a;\nuse uniontest.b;\nval X: i64 = 707;\npub fun p1() i64 { ret a.X; }\npub fun p2() i64 { ret X; }\npub fun p3() i64 { ret b.Y; }\nfun main() i32 { ret 0; }\n";
    texts[1] = "pub val X: i64 = 909;\n";
    texts[2] = "pub val Y: i64 = 505;\n";

    val pr: res[project.Project, outcome.Fail] = ut_lower_n(?s, ?alloc, ?names[0], ?texts[0], 3);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    var bad: i32        = 0;
    val m:   *ir.Module = ut_ir_of(?p, ?s, "uniontest.main");
    if (m == nil) { bad = 1; }
    or {
        if (ut_const_uses(m, 909) != 1) { bad = 1; }
        if (ut_const_uses(m, 707) != 1) { bad = 1; }

        val gx: i64 = ut_global_ix(?s, m, "uniontest.main.X");
        if (gx < 0) { bad = 1; }
        or {
            if (ut_global_uses(m, gx::u32) != 0)                { bad = 1; }
            if ((?m.globals[gx::u32]).init.data.int_lit != 707) { bad = 1; }
        }

        if (ut_const_uses(m, 505) != 1) { bad = 1; }
    }

    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

