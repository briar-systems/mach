    ret bad;
}

#[testing]
fun ut_rodata_globals(m: *me_ir.Module) u32 {
    if (m == nil) { ret 0; }
    var n:  u32 = 0;
    var gi: u32 = 0;
    for (gi < m.global_len) {
        if ((?m.globals[gi]).init.kind == value.VAL_CONST_BYTES) { n = n + 1; }
        gi = gi + 1;
    }
    ret n;
}

test each__deferred_body_is_typed_per_instance {
    var bad: i32 = 0;

    val src: str = "rec Rc { a: u32; b: u32; }\nvar g: Rc;\nfun walk[Tp](x: Tp) u32 { var acc: u32 = 0; $each f in $fields(Tp) { acc = acc + x; } ret acc; }\nfun sink(va: ...) u32 { var acc: u32 = 0; $each e in va { acc = acc + walk[Rc](g) + e; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var one: u32 = 1; sink(one); ret 0; }\n";
    if (ut_ct_lower_diag(src, "operand types `u32` and `Rc`") != 0) { bad = 1; }
    if (!ut_ct_lower_lacks(src, "and `Tp`"))                        { bad = 1; }

    if (!ut_ct_lower_clean("rec Rc { a: u32; b: u32; }\nvar g: Rc;\nfun walk[Tp](x: Tp) u32 { var acc: u32 = 0; $each f in $fields(Tp) { acc = acc + x.a; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { walk[Rc](g); ret 0; }\n")) { bad = 1; }

    if (ut_ct_lower_diag("rec Rc { a: ^u32; }\nvar g: Rc;\nfun walk[Tp](x: Tp) u32 { var acc: u32 = 0; $each f in $fields(Tp) { acc = acc + x.a; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { walk[Rc](g); ret 0; }\n",
        "expected u32, found ^u32") != 0) { bad = 1; }

    ret bad;
}

#[testing]
fun ut_fn_name_of(s: *session.Session, m: *me_ir.Module, needle: str, want_extern: bool) intern.StrId {
    if (m == nil) { ret intern.STR_NIL; }
    var fi: u32 = 0;
    for (fi < m.function_len) {
        val f: *me_ir.Function = ?m.functions[fi];
        if (((f.flags & me_ir.FN_FLAG_EXTERN) != 0) == want_extern) {
            val nm: opt[str] = intern.get(?s.interner, f.name);
            if (sel nm.some && ut_str_contains(nm.some, needle)) { ret f.name; }
        }
        fi = fi + 1;
    }
    ret intern.STR_NIL;
}

test linkage_name__dotted_shapes {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:   session.Session = sr.ok;
    var bad: i32             = 0;

    var names: [2]str;
    names[0] = "main.mach";
    names[1] = "lib.mach";
    var texts: [2]str;
    texts[1] = "pub rec Leaf { n: i64; }\npub rec Box[T] { v: T; }\npub def BinOp: fun(i64, i64) i64;\npub fun wrap[T](x: T) i64 { ret 0; }\npub fun pair[A, B](a: A, b: B) i64 { ret 0; }\npub fun plain(x: i64) i64 { ret x; }\npub fun tag($n: i64, x: i64) i64 { ret x + n; }\npub fun gsum[T](va: ...) i64 { var a: i64 = 0; $each e in va { a = a + 1; } ret a; }\n";
    texts[0] = "use uniontest.lib;\nfun main() i32 {\n    var l: lib.Leaf;\n    var bl: lib.Box[lib.Leaf];\n    var bbl: lib.Box[lib.Box[lib.Leaf]];\n    var arr: [4]u8;\n    var sec: ^u32 = 1;\n    var f: lib.BinOp = nil;\n    var acc: i64 = 0;\n    acc = acc + lib.wrap[lib.Leaf](l);\n    acc = acc + lib.wrap[lib.Box[lib.Leaf]](bl);\n    acc = acc + lib.wrap[lib.Box[lib.Box[lib.Leaf]]](bbl);\n    acc = acc + lib.wrap[*lib.Leaf](?l);\n    acc = acc + lib.wrap[[4]u8](arr);\n    acc = acc + lib.wrap[^u32](sec);\n    acc = acc + lib.wrap[lib.BinOp](f);\n    acc = acc + lib.pair[lib.Box[lib.Leaf], i64](bl, 1);\n    acc = acc + lib.pair[*lib.Box[lib.Leaf], u8](?bl, 2);\n    acc = acc + lib.plain(1);\n    acc = acc + lib.tag(7, 1);\n    acc = acc + lib.tag(-3, 1);\n    acc = acc + lib.gsum[u32](1, 2);\n    if (acc > 0) { ret 1; }\n    ret 0;\n}\n";

    val pr: res[project.Project, fail.Fail] = ut_lower_n(?s, ?alloc, ?names[0], ?texts[0], 2);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    val m: *me_ir.Module = ut_ir_of(?p, ?s, "uniontest.main");

    if (ut_defined_fn_exact(?s, m, "uniontest.lib.wrap$uniontest.lib.Leaf") != 1)                                        { bad = 2; }
    if (ut_defined_fn_exact(?s, m, "uniontest.lib.wrap$uniontest.lib.Box$$uniontest.lib.Leaf") != 1)                     { bad = 3; }
    if (ut_defined_fn_exact(?s, m, "uniontest.lib.wrap$uniontest.lib.Box$$uniontest.lib.Box$$$uniontest.lib.Leaf") != 1) { bad = 4; }
    if (ut_defined_fn_exact(?s, m, "uniontest.lib.wrap$p$uniontest.lib.Leaf") != 1)                                      { bad = 5; }
    if (ut_defined_fn_exact(?s, m, "uniontest.lib.wrap$arr4$u8") != 1)                                                   { bad = 6; }
    if (ut_defined_fn_exact(?s, m, "uniontest.lib.wrap$sec$u32") != 1)                                                   { bad = 7; }
    if (ut_defined_fn_exact(?s, m, "uniontest.lib.wrap$fn$$i64$$i64$$i64") != 1)                                         { bad = 8; }
    if (ut_defined_fn_exact(?s, m, "uniontest.lib.pair$uniontest.lib.Box$$uniontest.lib.Leaf$i64") != 1)                 { bad = 9; }
    if (ut_defined_fn_exact(?s, m, "uniontest.lib.pair$p$uniontest.lib.Box$$uniontest.lib.Leaf$u8") != 1)                { bad = 10; }
    if (ut_defined_fn_exact(?s, m, "uniontest.lib.tag$7") != 1)                                                          { bad = 11; }
    if (ut_defined_fn_exact(?s, m, "uniontest.lib.tag$n3") != 1)                                                         { bad = 12; }
    if (ut_defined_fn_exact(?s, m, "uniontest.lib.gsum$u32$pack$i64$i64") != 1)                                          { bad = 13; }

    if (ut_defined_fn_count(?s, m, "uniontest.lib.wrap$") != 7) { bad = 14; }

    val lib_m:  *me_ir.Module = ut_ir_of(?p, ?s, "uniontest.lib");
    val def_id: intern.StrId  = ut_fn_name_of(?s, lib_m, ".plain", false);
    val ref_id: intern.StrId  = ut_fn_name_of(?s, m, ".plain", true);
    if (intern.str_is_nil(def_id) || !intern.str_same(def_id, ref_id)) { bad = 15; }
    if (ut_defined_fn_exact(?s, lib_m, "uniontest.lib.plain") != 1)    { bad = 16; }

    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

test linkage_name__test_declaration {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "fun probe() i32 { ret 0; }\ntest probe { ret probe(); }\nfun main() i32 { ret probe(); }\n";

    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    var bad: i32                             = 0;
    val pr:  res[project.Project, fail.Fail] = driver.build_project_union(?s, root);
    if (sel pr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;
    p.req.goal = request.GOAL_TESTS;
    val run_sema_pass_r:    err[fail.Fail] = driver.run_sema_pass(?p);
    val run_lower_pass_r:   err[fail.Fail] = driver.run_lower_pass(?p);
    val run_codegen_pass_r: err[fail.Fail] = driver.run_codegen_pass(?p);
    val run_test_pass_r:    err[fail.Fail] = driver.run_test_pass(?p);
    if (sel run_sema_pass_r.err)    { bad = 1; }
    or (sel run_lower_pass_r.err)   { bad = 2; }
    or (sel run_codegen_pass_r.err) { bad = 3; }
    or (sel run_test_pass_r.err)    { bad = 4; }
    or {
        # the test is its qualified name in the test object; the function of the same
        # name is the normal object's
        val m:      *me_ir.Module    = ut_ir_of(?p, ?s, "uniontest.main");
        val mid:    session.ModuleId = ut_mid(?p, ?s, "uniontest.main");
        val tested: *me_ir.Module    = project.module_at(?p, mid::u32).test.ir_module;
        if (tested == nil)                                                { bad = 5; }
        or (ut_defined_fn_exact(?s, tested, "uniontest.main#probe") != 1) { bad = 6; }
        or (ut_defined_fn_exact(?s, tested, "uniontest.main.probe") != 0) { bad = 7; }
        if (ut_defined_fn_exact(?s, m, "uniontest.main.probe") != 1)      { bad = 8; }
        if (ut_defined_fn_exact(?s, m, "uniontest.main#probe") != 0)      { bad = 9; }
    }

    project.dnit_project(?p);
    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

#[testing]
fun ut_embed_diag(main_src: str, asset: str, needle: str) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [2]str;
    names[0] = "main.mach";
    names[1] = "asset.bin";
    var texts: [2]str;
    texts[0] = main_src;
    texts[1] = asset;

    val pr: res[project.Project, fail.Fail] = ut_vec_sema_n(?s, ?alloc, ?names[0], ?texts[0], 2);
    if (sel pr.ok) {
        var p: project.Project = pr.ok;
        project.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }
    val hit: bool = fail.is_reported(pr.err) && ut_diag_has(?s.diags, needle);
    session.dnit(?s);
    if (hit) { ret 0; }
    ret 1;
}

#[testing]
fun ut_embed_unreadable_diag() i32 {
    $if ($mach.build.os != $mach.os.linux) { ret 0; }

    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [2]str;
    names[0] = "main.mach";
    names[1] = "asset.bin";
    var texts: [2]str;
    texts[0] = "#[embed(\"asset.bin\")]\nval A: [_]u8;\nfun main() i32 { ret 0; }\n";
    texts[1] = "abc";

    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 2);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root:    str = root_r.ok;
    val src_dir: str = ut_cc3(?alloc, root, "/", "src");
    val a_path:  str = ut_cc3(?alloc, src_dir, "/", "asset.bin");

    val remove_file_r: err[io_error.Error] = fs.remove_file(a_path);
    if (sel remove_file_r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(a_path, "abc", 3::usize, 0);
    if (sel write_bytes_r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }

    val pr: res[project.Project, fail.Fail] = ut_sema_build(?s, root);
    if (sel pr.ok) {
        var p: project.Project = pr.ok;
        project.dnit_project(?p);
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    val hit: bool = fail.is_reported(pr.err) && ut_diag_has(?s.diags, "permission denied");
    fs.remove_all(?alloc, root);
    session.dnit(?s);
    if (hit) { ret 0; }
    ret 1;
}

#[testing]
rec UtEmbedCase {
    main:   str;
    needle: str;
}

# each embed refusal: the size against the annotation, a missing file and a directory, the
# declaration kind and annotation, the decorator's arguments, and a `[_]` outside an embed
#[testing]
val UT_EMBED_REFUSALS: [13]UtEmbedCase = [13]UtEmbedCase{
    UtEmbedCase{main: "#[embed(\"asset.bin\")]\nval A: [_]u8;\nfun main() i32 { val b: [9]u8 = A; ret b[0]::i32; }\n", needle: "found [3]u8"},
    UtEmbedCase{main: "#[embed(\"asset.bin\")]\nval A: [4]u8;\nfun main() i32 { ret A[0]::i32; }\n", needle: "declares 4 bytes but the file holds 3"},
    UtEmbedCase{main: "#[embed(\"nope.bin\")]\nval A: [_]u8;\nfun main() i32 { ret A[0]::i32; }\n", needle: "`embed` on `A` cannot read"},
    UtEmbedCase{main: "#[embed(\"nope.bin\")]\nval A: [_]u8;\nfun main() i32 { ret A[0]::i32; }\n", needle: "no such file or directory"},
    UtEmbedCase{main: "#[embed(\".\")]\nval A: [_]u8;\nfun main() i32 { ret A[0]::i32; }\n", needle: "is a directory"},
    UtEmbedCase{main: "#[embed(\"asset.bin\")]\nvar A: [_]u8;\nfun main() i32 { ret A[0]::i32; }\n", needle: "applies only to a `val`"},
    UtEmbedCase{main: "#[embed(\"asset.bin\")]\nval A: [_]u32;\nfun main() i32 { ret 0; }\n", needle: "element type must be `u8`"},
    UtEmbedCase{main: "#[embed(\"asset.bin\")]\nval A: u8;\nfun main() i32 { ret A::i32; }\n", needle: "must be annotated `[_]u8` or `[N]u8`"},
    UtEmbedCase{main: "#[embed()]\nval A: [_]u8;\nfun main() i32 { ret A[0]::i32; }\n", needle: "takes one string argument"},
    UtEmbedCase{main: "#[embed(\"asset.bin\")]\nfun f() i32 { ret 0; }\nfun main() i32 { ret f(); }\n", needle: "applies only to a `val`"},
    UtEmbedCase{main: "#[embed(\"asset.bin\")]\n#[embed(\"asset.bin\")]\nval A: [_]u8;\nfun main() i32 { ret A[0]::i32; }\n", needle: "only one `embed` decorator"},
    UtEmbedCase{main: "val A: [_]u8 = [1]u8{1};\nfun main() i32 { ret A[0]::i32; }\n", needle: "only valid on an `#[embed(...)]` declaration"},
    UtEmbedCase{main: "#[embed(\"asset.bin\")]\nval A: [_][_]u8;\nfun main() i32 { ret 0; }\n", needle: "element type must be `u8`"}
};

test embed__refusals {
    var i: usize = 0;
    for (i < 13) {
        if (ut_embed_diag(UT_EMBED_REFUSALS[i].main, "abc", UT_EMBED_REFUSALS[i].needle) != 0) { ret (i + 1)::i32; }
        i = i + 1;
    }
    if (ut_embed_unreadable_diag() != 0) { ret 20; }
    ret 0;
}

# a malformed embed annotation is reported once, never again as a `[_]` outside an embed,
# while a `[_]` local beside a failed embed still is
test embed__rejection_does_not_cascade {
    val needle: str = "only valid on an `#[embed(...)]` declaration";
    if (ut_embed_diag("#[embed(\"asset.bin\")]\nval A: [_][_]u8;\nfun main() i32 { ret 0; }\n", "abc", needle) == 0)           { ret 1; }
    if (ut_embed_diag("#[embed(\"asset.bin\")]\nval A: *[_]u8;\nfun main() i32 { ret 0; }\n", "abc", needle) == 0)             { ret 2; }
    if (ut_embed_diag("#[embed(\"asset.bin\")]\nval A: [3][_]u8;\nfun main() i32 { ret 0; }\n", "abc", needle) == 0)           { ret 3; }
    if (ut_embed_diag("#[embed(\"nope.bin\")]\nval A: [_]u8;\nfun main() i32 { var q: [_]u8; ret 0; }\n", "abc", needle) != 0) { ret 4; }
    ret 0;
}

#[testing]
fun ut_embed_escape_arm(alloc: *A.Allocator, escaped: bool) i32 {
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [2]str;
    names[0] = "main.mach";
    names[1] = "asset.bin";
    var texts: [2]str;
    texts[0] = "#[embed(\"asset.bin\")]\nval A: [_]u8;\nfun main() i32 { ret A[0]::i32; }\n";
    texts[1] = "abc";
    val root_r: res[str, fail.Fail] = ut_scaffold(alloc, ?names[0], ?texts[0], 2);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root:    str = root_r.ok;
    val outside: str = ut_cc3(alloc, root, "-outside", ".bin");
    if (escaped) {
        val leaf:          str             = types_path.filename(outside);
        val main_path:     str             = ut_cc3(alloc, root, "/src/", "main.mach");
        val src:           str             = ut_cc3(alloc, "#[embed(\"../../", leaf, "\")]\nval A: [_]u8;\nfun main() i32 { ret A[0]::i32; }\n");
        val write_bytes_r: err[fs.FsError] = fs.write_bytes(main_path, src, str_len(src), 420);
        if (sel write_bytes_r.err) {
            fs.remove_all(alloc, root);
            session.dnit(?s);
            ret 1;
        }
        val write_bytes_r2: err[fs.FsError] = fs.write_bytes(outside, "xyz", 3::usize, 420);
        if (sel write_bytes_r2.err) {
            fs.remove_all(alloc, root);
            session.dnit(?s);
            ret 1;
        }
    }

    var bad: i32                             = 0;
    val pr:  res[project.Project, fail.Fail] = ut_sema_build(?s, root);
    if (escaped) {
        # refused at the decorator, and the outside file's bytes were never read
        if (sel pr.ok) {
            var p: project.Project = pr.ok;
            project.dnit_project(?p);
            bad = 1;
        }
        if (!ut_diag_has(?s.diags, "`embed` path escapes the project root"))                 { bad = 2; }
        if (!ut_diag_has(?s.diags, "must live inside the project and the file is not read")) { bad = 3; }
        val outside_r: res[intern.StrId, A.Error] = intern.add(?s.interner, outside);
        if (sel outside_r.ok) {
            val cached: opt[*session_embed.EmbedFile] = session_embed.get(?s.embeds, outside_r.ok);
            if (sel cached.some) { bad = 4; }
        }
    }
    or {
        if (sel pr.err) { bad = 5; }
        if (sel pr.ok) {
            var p: project.Project = pr.ok;
            if (diagnostic.has_errors(?s.diags)) { bad = 6; }
            project.dnit_project(?p);
        }
    }
    if (escaped) { fs.remove_file(outside); }
    fs.remove_all(alloc, root);
    session.dnit(?s);
    ret bad;
}

# an embed outside the project root is a refusal that never reads the file
test embed__outside_the_project_root_is_refused_unread {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val escaped: i32 = ut_embed_escape_arm(?alloc, true);
    if (escaped != 0) { ret 10 + escaped; }
    val inside: i32 = ut_embed_escape_arm(?alloc, false);
    if (inside != 0) { ret 20 + inside; }
    ret 0;
}

#[testing]
fun ut_probe_bad_zero_ret(m: *me_ir.Module) i32 {
    var fi: u32 = 0;
    for (fi < m.function_len) {
        val fn: *me_ir.Function = ?m.functions[fi];
        var ii: u32             = 0;
        for (ii < fn.instr_len) {
            val inst: *ir_instruction.Instruction = ?fn.instrs[ii];
            if (inst.kind == ir_instruction.OP_RET && inst.operand_count > 0) {
                val op: value.Value = inst.operands[0];
                if (op.kind == value.VAL_CONST_INT) {
                    if (ir_type.is_aggregate(?m.types, op.ty))    { ret 1; }
                    if (ir_type.is_float_scalar(?m.types, op.ty)) { ret 1; }
                }
            }
            ii = ii + 1;
        }
        fi = fi + 1;
    }
    ret 0;
}

#[testing]
fun ut_agg_address_rets(m: *me_ir.Module) u32 {
    var n:  u32 = 0;
    var fi: u32 = 0;
    for (fi < m.function_len) {
        val fn: *me_ir.Function = ?m.functions[fi];
        var ii: u32             = 0;
        for (ii < fn.instr_len) {
            val inst: *ir_instruction.Instruction = ?fn.instrs[ii];
            if (inst.kind == ir_instruction.OP_RET && inst.operand_count > 0) {
                val op: value.Value = inst.operands[0];
                if (!value.is_constant(op) && ir_type.is_aggregate(?m.types, op.ty)) { n = n + 1; }
            }
            ii = ii + 1;
        }
        fi = fi + 1;
    }
    ret n;
}

#[testing]
fun ut_fn_ret_count(m: *me_ir.Module, itn: *intern.Interner, want: str) i64 {
    var fi: u32 = 0;
    for (fi < m.function_len) {
        val fn: *me_ir.Function = ?m.functions[fi];
        val nm: opt[str]        = intern.get(itn, fn.disp);
        if (sel nm.some && str_equals(nm.some, want)) {
            var n:  i64 = 0;
            var ii: u32 = 0;
            for (ii < fn.instr_len) {
                if (fn.instrs[ii].kind == ir_instruction.OP_RET) { n = n + 1; }
                ii = ii + 1;
            }
            ret n;
        }
        fi = fi + 1;
    }
    ret -1;
}

test fallthrough_return__is_well_typed {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "rec P { a: u64; b: u64; }\nfun rec_loop() P { var p: P; for { p.a = 1; ret p; } }\nfun f64_loop() f64 { var i: i64 = 0; for { i = i + 1; ret 1.5; } }\nfun u64_loop() u64 { var i: u64 = 0; for { i = i + 1; ret i; } }\nfun rec_fall() P { var p: P; p.a = 1; }\nfun f64_fall() f64 { var i: i64 = 0; i = i + 1; }\nfun main() i32 { var a: P = rec_loop(); var b: P = rec_fall(); ret (a.a + b.a + u64_loop())::i32; }\n";

    val pr: res[project.Project, fail.Fail] = ut_build(?s, ?alloc, ?names[0], ?texts[0], 1);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    val run_sema_pass_r: err[fail.Fail] = driver.run_sema_pass(?p);
    if (sel run_sema_pass_r.err) {
        project.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }
    val run_lower_pass_r: err[fail.Fail] = driver.run_lower_pass(?p);
    if (sel run_lower_pass_r.err) {
        project.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }

    var bad: i32              = 1;
    val mid: session.ModuleId = ut_mid(?p, ?s, "uniontest.main");
    if (!module.is_nil(mid)) {
        val m: *project.ModuleEntry = project.module_at(?p, mid::u32);
        if (m.ir_module != nil) {
            bad = ut_probe_bad_zero_ret(m.ir_module);
            if (ut_agg_address_rets(m.ir_module) == 0)                      { bad = 1; }
            if (ut_fn_ret_count(m.ir_module, ?s.interner, "rec_loop") != 1) { bad = 1; }
        }
    }

    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

test comptime_gate__reads_a_float_at_its_width {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "val K: f32 = 16777217.0;\n$if (K - 16777216.0 == 0.0) { val G: i64 = 1; }\n$or { val G: i64 = 0; }\nval K64: f64 = 16777217.0;\n$if (K64 - 16777216.0 == 0.0) { val G64: i64 = 1; }\n$or { val G64: i64 = 0; }\nval P: f32 = 0.1;\n$if (P > 0.1) { val GT: i64 = 1; }\n$or { val GT: i64 = 0; }\nval P64: f64 = 0.1;\n$if (P64 > 0.1) { val GT64: i64 = 1; }\n$or { val GT64: i64 = 0; }\nfun main() i32 { ret 0; }\n";

    val pr: res[project.Project, fail.Fail] = ut_lower_n(?s, ?alloc, ?names[0], ?texts[0], 1);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    var bad: i32           = 0;
    val m:   *me_ir.Module = ut_ir_of(?p, ?s, "uniontest.main");
    if (m == nil) { bad = 1; }
    or {
        val gg: i64 = ut_global_ix(?s, m, "uniontest.main.G");
        if (gg < 0) { bad = 1; }
        or {
            if ((?m.globals[gg::u32]).init.data.int_lit != 1) { bad = 1; }
        }

        val gg64: i64 = ut_global_ix(?s, m, "uniontest.main.G64");
        if (gg64 < 0) { bad = 1; }
        or {
            if ((?m.globals[gg64::u32]).init.data.int_lit != 0) { bad = 1; }
        }

        val gt: i64 = ut_global_ix(?s, m, "uniontest.main.GT");
        if (gt < 0) { bad = 1; }
        or {
            if ((?m.globals[gt::u32]).init.data.int_lit != 0) { bad = 1; }
        }

        val gt64: i64 = ut_global_ix(?s, m, "uniontest.main.GT64");
        if (gt64 < 0) { bad = 1; }
        or {
            if ((?m.globals[gt64::u32]).init.data.int_lit != 0) { bad = 1; }
        }
    }

    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}
