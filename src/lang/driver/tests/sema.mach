# a grouped literal and a grouped assignment target keep their values in a built program
test grouped_expr__values_survive_to_run_time {
    # the values a grouped literal and a grouped assignment target carry at run time
    $if ($mach.build.os != $mach.os.linux || $mach.build.arch != $mach.arch.x86_64) { ret 0; }
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 4; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 4; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = ut_cc3(?alloc,
        "val N: i32 = (4);\n",
        "test grouped {\n    var x: i32 = (N);\n    (x) = ('a')::i32 + (1);\n    val s: *u8 = (\"hi\");\n    val p: *u8 = (nil);\n    val f: f64 = (2.5);\n    if (p != nil) { ret 11; }\n    if (f != 2.5) { ret 12; }\n    if (s[0] != 104 || s[1] != 105 || s[2] != 0) { ret 13; }\n    ret (x) - 98;\n}\n",
        ut_dispatcher_start_stub());
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 1);
    if (sel root_r.err) { ret 4; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?alloc, root); }

    val mr: res[manifest.Manifest, fail.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) { ret 4; }
    var m:  manifest.Manifest    = mr.ok;
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    rq.target       = "linux";
    rq.goal         = request.GOAL_TESTS;
    val pr: res[build_plan.BuildPlan, fail.Fail] = build_plan.plan(?alloc, ?s.interner, toolchain.t_registry(), ?m, rq);
    if (sel pr.err) { ret 4; }
    var bp: build_plan.BuildPlan                 = pr.ok;
    val r:  res[outcome.BuildOutcome, fail.Fail] = engine.execute_warm(?bp, 0, ?s, ?alloc, nil);
    if (sel r.err) {
        print.eprintln(fail.describe(r.err));
        ret 4;
    }
    var bo: outcome.BuildOutcome = r.ok;
    if (bo.severity != outcome.BUILD_OK) { ret 5; }
    if (bo.tests.len != 1)               { ret 6; }
    val art: *outcome.TestArtifact = ?bo.tests.data[0];
    val got: i32                   = ut_dispatch_status(art.exe::str, art.idx);
    if (got != 0) {
        print.eprintlnf("grouped: exit {}", got::i64);
        ret 7;
    }
    ret 0;
}

# 0 when a project whose mid module forwards leaf.original_name under two names links
#[testing]
fun ut_fwd_renamed_links(main_text: str) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var names:  [3]str              = [3]str{"main.mach", "mid.mach", "leaf.mach"};
    var texts:  [3]str              = [3]str{main_text, "fwd renamed_alias: uniontest.leaf.original_name;\nfwd uniontest.leaf.original_name;\n", "pub fun original_name() i32 { ret 42; }\n"};
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 3);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?alloc, root); }
    val pr: res[project.Project, fail.Fail] = ut_back_half(?s, root);
    if (sel pr.err) { ret 1; }
    var p: project.Project = pr.ok;
    fin { project.dnit_project(?p); }
    val set_link_config_input_r: err[fail.Fail] = engine.set_link_config_input(?p, "out/app"::*u8, "app"::*u8, 0, nil, 0, nil, 0, nil);
    if (sel set_link_config_input_r.err) { ret 1; }
    val rl: res[bool, fail.Fail] = driver.run_link_pass(?p);
    if (sel rl.err) { ret 2; }
    ret 0;
}

# a renamed re-export links across the module boundary whichever order its names are imported in
test fwd__renamed_reexport_links {
    val qualified: i32 = ut_fwd_renamed_links("use uniontest.mid;\nfun main() i32 { ret mid.renamed_alias() - mid.original_name(); }\n");
    if (qualified != 0) { ret 10 + qualified; }
    val leaves: i32 = ut_fwd_renamed_links("use uniontest.mid.renamed_alias;\nuse uniontest.mid.original_name;\nfun main() i32 { ret renamed_alias() - original_name(); }\n");
    if (leaves != 0) { ret 20 + leaves; }
    ret 0;
}

# the same parsed bracket is read as a generic call or an index as its names change, and the
# reused syntax tree is never rewritten
test bracket__reinterprets_without_rewriting_the_tree {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val initialized: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel initialized.err) { ret 2; }
    var s: session.Session = initialized.ok;
    fin { session.dnit(?s); }
    var names:    [2]str = [2]str{"main.mach", "lib.mach"};
    var versions: [2]str = [2]str{
        "pub def Key: i64;\npub fun item[T](v: T) T { ret v; }\n",
        "pub val Key: u64 = 0;\nfun identity(v: i64) i64 { ret v; }\npub val item: [1]fun(i64) i64 = [1]fun(i64) i64{identity};\n"
    };
    var texts: [2]str = [2]str{
        "use uniontest.lib.item;\nuse uniontest.lib.Key;\nfun main() i64 { ret item[Key](3); }\n", versions[0]
    };
    val scaffold: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 2);
    if (sel scaffold.err) { ret 4; }
    val root: str = scaffold.ok;
    fin {
        fs.remove_all(?alloc, root);
        str_free(?alloc, root);
    }
    val joined: res[str, A.Error] = types_path.join(?alloc, root, "src/lib.mach");
    if (sel joined.err) { ret 5; }
    val filename: str = joined.ok;
    fin { str_free(?alloc, filename); }
    var saved: *ast_expr.Expr = nil;
    var count: usize          = 0;
    fin {
        if (saved != nil) { A.deallocate[ast_expr.Expr](?alloc, saved, count); }
    }
    var owner:       *ast.Ast       = nil;
    var incarnation: u64            = 0;
    var selected:    ast_id.ExprId  = ast_id.EXPR_NIL;
    var revision:    query.Revision = 0;
    var round:       u32            = 0;
    for (round < 3) {
        val version:       u32             = round % 2;
        val write_bytes_r: err[fs.FsError] = fs.write_bytes(filename, versions[version], str_len(versions[version]), 420);
        if (sel write_bytes_r.err) { ret 6; }
        val opened: res[project.Project, fail.Fail] = driver.build_project_union(?s, root);
        if (sel opened.err) { ret 7; }
        var p: project.Project = opened.ok;
        fin { project.dnit_project(?p); }
        val mid: session.ModuleId = ut_mid(?p, ?s, "uniontest.main");
        if (module.is_nil(mid)) { ret 8; }
        val parsed: *ast.Ast = project.module_at(?p, mid::u32).a;
        if (parsed == nil) { ret 9; }
        val current: query.Revision = query.peek_revision(?s.queries, query.Q_PARSE, lang_source.file_index(project.module_at(?p, mid::u32).file_id)::u64);
        if (round == 0) {
            owner       = parsed;
            incarnation = parsed.incarnation;
            revision    = current;
            count       = parsed.exprs.len;
            val storage: res[*ast_expr.Expr, A.Error] = A.allocate[ast_expr.Expr](?alloc, count);
            if (sel storage.err) { ret 10; }
            saved = storage.ok;
            memory.copy[ast_expr.Expr](saved, parsed.exprs.data, count);
            var i: usize = 0;
            for (i < count) {
                if (saved[i].kind == ast_expr.EXPR_KIND_CALL && !ast_id.expr_is_nil(saved[i].data.call.index_callee)) {
                    if (!ast_id.expr_is_nil(selected)) { ret 11; }
                    selected = ast_id.expr(i::u32);
                }
                i = i + 1;
            }
            if (ast_id.expr_is_nil(selected) || revision == 0) { ret 12; }
        }
        if (parsed != owner || parsed.incarnation != incarnation || parsed.exprs.len != count || current != revision
            || !memory.equal[ast_expr.Expr](saved, parsed.exprs.data, count)) { ret 13; }
        val run_sema_pass_r: err[fail.Fail] = driver.run_sema_pass(?p);
        if (sel run_sema_pass_r.err) {
            var di: usize = 0;
            for (di < diagnostic.len(?s.diags)) {
                print.eprintln(s.diags.items.data[di].message);
                di = di + 1;
            }
            ret 14;
        }
        val interpreted: res[ast_expr.Expr, fail.Fail] = resolve.expression(project.module_at(?p, mid::u32).resolve_result, parsed, selected);
        if (sel interpreted.err) { ret 15; }
        val node: ast_expr.Expr = interpreted.ok;
        if (node.kind != ast_expr.EXPR_KIND_CALL || !ast_id.expr_is_nil(node.data.call.index_callee))                                                                   { ret 16; }
        if (version == 0 && (node.data.call.type_args_len != 1 || !ast_id.expr_same(node.data.call.callee, saved[ast_id.expr_index(selected)].data.call.callee)))       { ret 17; }
        if (version == 1 && (node.data.call.type_args_len != 0 || !ast_id.expr_same(node.data.call.callee, saved[ast_id.expr_index(selected)].data.call.index_callee))) { ret 18; }
        val run_lower_pass_r: err[fail.Fail] = driver.run_lower_pass(?p);
        if (sel run_lower_pass_r.err)                                      { ret 19; }
        if (!memory.equal[ast_expr.Expr](saved, parsed.exprs.data, count)) { ret 20; }
        round = round + 1;
    }
    ret 0;
}

# a same-module global cycle is refused at each global, and the rejected module leaves no
# lower query product behind
test global_init__cycle_is_refused_with_no_lower_product {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "val X: u64 = Y;\nval Y: u64 = X;\nfun main() i32 { ret 0; }\n";
    val rooted: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 1);
    if (sel rooted.err) { ret 2; }
    val root: str = rooted.ok;
    fin { fs.remove_all(?alloc, root); }
    var selection: manifest.Selectors              = ut_target_sel("linux");
    val built:     res[project.Project, fail.Fail] = driver.build_project(?s, root, ?selection);
    if (sel built.err) { ret 4; }
    var p: project.Project = built.ok;
    fin { project.dnit_project(?p); }
    val run_sema_pass_r: err[fail.Fail] = driver.run_sema_pass(?p);
    if (sel run_sema_pass_r.err) { ret 5; }
    val lowered: err[fail.Fail] = driver.run_lower_pass(?p);
    if (sel lowered.ok)                                                                    { ret 6; }
    if (!fail.is_reported(lowered.err))                                                    { ret 7; }
    if (ut_count_errors(?s.diags) != 2)                                                    { ret 8; }
    if (!ut_diag_has(?s.diags, "global initialiser of `X` must be a constant expression")) { ret 17; }
    if (!ut_diag_has(?s.diags, "global initialiser of `Y` must be a constant expression")) { ret 18; }
    val mid: session.ModuleId = ut_mid(?p, ?s, "uniontest.main");
    if (module.is_nil(mid) || project.module_at(?p, mid::u32).ir_module != nil) { ret 9; }
    val stable: session.StableModuleId          = ut_stable(?p, ?s, "uniontest.main");
    val begun:  res[query.Operation, fail.Fail] = project.begin_query_phase(?p);
    if (sel begun.err) { ret 10; }
    val operation: query.Operation                 = begun.ok;
    val acquired:  res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, ?p, query.Q_LOWER, passes.back_half_key(stable, false));
    val ended:     err[fail.Fail]                  = query.end(?s.queries, operation);
    val discarded: err[fail.Fail]                  = query.discard(?s.queries, operation);
    if (sel acquired.ok)                                  { ret 11; }
    if (!fail.is_reported(acquired.err))                  { ret 12; }
    if (sel ended.ok)                                     { ret 13; }
    if (!fail.is_reported(ended.err))                     { ret 14; }
    if (sel discarded.err)                                { ret 15; }
    if (project.module_at(?p, mid::u32).ir_module != nil) { ret 16; }
    ret 0;
}

test linkage_name__test_declaration {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "fun probe() i32 { ret 0; }\ntest probe { ret probe(); }\nfun main() i32 { ret probe(); }\n";

    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    var bad: i32                             = 0;
    val pr:  res[project.Project, fail.Fail] = driver.build_project_union(?s, root);
    if (sel pr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;
    p.req.goal = request.GOAL_TESTS;
    val run_sema_pass_r:    err[fail.Fail] = driver.run_sema_pass(?p);
    val run_lower_pass_r:   err[fail.Fail] = driver.run_lower_pass(?p);
    val run_codegen_pass_r: err[fail.Fail] = driver.run_codegen_pass(?p);
    val run_test_pass_r:    err[fail.Fail] = driver.run_test_pass(?p);
    if (sel run_sema_pass_r.err)    { bad = 1; }
    or (sel run_lower_pass_r.err)   { bad = 2; }
    or (sel run_codegen_pass_r.err) { bad = 3; }
    or (sel run_test_pass_r.err)    { bad = 4; }
    or {
        # the test is its qualified name in the test object; the function of the same
        # name is the normal object's
        val m:      *me_ir.Module    = ut_ir_of(?p, ?s, "uniontest.main");
        val mid:    session.ModuleId = ut_mid(?p, ?s, "uniontest.main");
        val tested: *me_ir.Module    = project.module_at(?p, mid::u32).test.ir_module;
        if (tested == nil)                                                { bad = 5; }
        or (ut_defined_fn_exact(?s, tested, "uniontest.main#probe") != 1) { bad = 6; }
        or (ut_defined_fn_exact(?s, tested, "uniontest.main.probe") != 0) { bad = 7; }
        if (ut_defined_fn_exact(?s, m, "uniontest.main.probe") != 1)      { bad = 8; }
        if (ut_defined_fn_exact(?s, m, "uniontest.main#probe") != 0)      { bad = 9; }
    }

    project.dnit_project(?p);
    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

#[testing]
fun ut_embed_diag(main_src: str, asset: str, needle: str) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [2]str;
    names[0] = "main.mach";
    names[1] = "asset.bin";
    var texts: [2]str;
    texts[0] = main_src;
    texts[1] = asset;

    val pr: res[project.Project, fail.Fail] = ut_vec_sema_n(?s, ?alloc, ?names[0], ?texts[0], 2);
    if (sel pr.ok) {
        var p: project.Project = pr.ok;
        project.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }
    val hit: bool = fail.is_reported(pr.err) && ut_diag_has(?s.diags, needle);
    session.dnit(?s);
    if (hit) { ret 0; }
    ret 1;
}

#[testing]
fun ut_embed_unreadable_diag() i32 {
    $if ($mach.build.os != $mach.os.linux) { ret 0; }

    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [2]str;
    names[0] = "main.mach";
    names[1] = "asset.bin";
    var texts: [2]str;
    texts[0] = "#[embed(\"asset.bin\")]\nval A: [_]u8;\nfun main() i32 { ret 0; }\n";
    texts[1] = "abc";

    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 2);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root:    str = root_r.ok;
    val src_dir: str = ut_cc3(?alloc, root, "/", "src");
    val a_path:  str = ut_cc3(?alloc, src_dir, "/", "asset.bin");

    val remove_file_r: err[io_error.Error] = fs.remove_file(a_path);
    if (sel remove_file_r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(a_path, "abc", 3::usize, 0);
    if (sel write_bytes_r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }

    val pr: res[project.Project, fail.Fail] = ut_sema_build(?s, root);
    if (sel pr.ok) {
        var p: project.Project = pr.ok;
        project.dnit_project(?p);
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    val hit: bool = fail.is_reported(pr.err) && ut_diag_has(?s.diags, "permission denied");
    fs.remove_all(?alloc, root);
    session.dnit(?s);
    if (hit) { ret 0; }
    ret 1;
}

#[testing]
rec UtEmbedCase {
    main:   str;
    needle: str;
}

# each embed refusal: the size against the annotation, a missing file and a directory, the
# declaration kind and annotation, the decorator's arguments, and a `[_]` outside an embed
#[testing]
val UT_EMBED_REFUSALS: [13]UtEmbedCase = [13]UtEmbedCase{
    UtEmbedCase{main: "#[embed(\"asset.bin\")]\nval A: [_]u8;\nfun main() i32 { val b: [9]u8 = A; ret b[0]::i32; }\n", needle: "found [3]u8"},
    UtEmbedCase{main: "#[embed(\"asset.bin\")]\nval A: [4]u8;\nfun main() i32 { ret A[0]::i32; }\n", needle: "declares 4 bytes but the file holds 3"},
    UtEmbedCase{main: "#[embed(\"nope.bin\")]\nval A: [_]u8;\nfun main() i32 { ret A[0]::i32; }\n", needle: "`embed` on `A` cannot read"},
    UtEmbedCase{main: "#[embed(\"nope.bin\")]\nval A: [_]u8;\nfun main() i32 { ret A[0]::i32; }\n", needle: "no such file or directory"},
    UtEmbedCase{main: "#[embed(\".\")]\nval A: [_]u8;\nfun main() i32 { ret A[0]::i32; }\n", needle: "is a directory"},
    UtEmbedCase{main: "#[embed(\"asset.bin\")]\nvar A: [_]u8;\nfun main() i32 { ret A[0]::i32; }\n", needle: "applies only to a `val`"},
    UtEmbedCase{main: "#[embed(\"asset.bin\")]\nval A: [_]u32;\nfun main() i32 { ret 0; }\n", needle: "element type must be `u8`"},
    UtEmbedCase{main: "#[embed(\"asset.bin\")]\nval A: u8;\nfun main() i32 { ret A::i32; }\n", needle: "must be annotated `[_]u8` or `[N]u8`"},
    UtEmbedCase{main: "#[embed()]\nval A: [_]u8;\nfun main() i32 { ret A[0]::i32; }\n", needle: "takes one string argument"},
    UtEmbedCase{main: "#[embed(\"asset.bin\")]\nfun f() i32 { ret 0; }\nfun main() i32 { ret f(); }\n", needle: "applies only to a `val`"},
    UtEmbedCase{main: "#[embed(\"asset.bin\")]\n#[embed(\"asset.bin\")]\nval A: [_]u8;\nfun main() i32 { ret A[0]::i32; }\n", needle: "only one `embed` decorator"},
    UtEmbedCase{main: "val A: [_]u8 = [1]u8{1};\nfun main() i32 { ret A[0]::i32; }\n", needle: "only valid on an `#[embed(...)]` declaration"},
    UtEmbedCase{main: "#[embed(\"asset.bin\")]\nval A: [_][_]u8;\nfun main() i32 { ret 0; }\n", needle: "element type must be `u8`"}
};

test embed__refusals {
    var i: usize = 0;
    for (i < 13) {
        if (ut_embed_diag(UT_EMBED_REFUSALS[i].main, "abc", UT_EMBED_REFUSALS[i].needle) != 0) { ret (i + 1)::i32; }
        i = i + 1;
    }
    if (ut_embed_unreadable_diag() != 0) { ret 20; }
    ret 0;
}

# a malformed embed annotation is reported once, never again as a `[_]` outside an embed,
# while a `[_]` local beside a failed embed still is
test embed__rejection_does_not_cascade {
    val needle: str = "only valid on an `#[embed(...)]` declaration";
    if (ut_embed_diag("#[embed(\"asset.bin\")]\nval A: [_][_]u8;\nfun main() i32 { ret 0; }\n", "abc", needle) == 0)           { ret 1; }
    if (ut_embed_diag("#[embed(\"asset.bin\")]\nval A: *[_]u8;\nfun main() i32 { ret 0; }\n", "abc", needle) == 0)             { ret 2; }
    if (ut_embed_diag("#[embed(\"asset.bin\")]\nval A: [3][_]u8;\nfun main() i32 { ret 0; }\n", "abc", needle) == 0)           { ret 3; }
    if (ut_embed_diag("#[embed(\"nope.bin\")]\nval A: [_]u8;\nfun main() i32 { var q: [_]u8; ret 0; }\n", "abc", needle) != 0) { ret 4; }
    ret 0;
}

#[testing]
fun ut_embed_escape_arm(alloc: *A.Allocator, escaped: bool) i32 {
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [2]str;
    names[0] = "main.mach";
    names[1] = "asset.bin";
    var texts: [2]str;
    texts[0] = "#[embed(\"asset.bin\")]\nval A: [_]u8;\nfun main() i32 { ret A[0]::i32; }\n";
    texts[1] = "abc";
    val root_r: res[str, fail.Fail] = ut_scaffold(alloc, ?names[0], ?texts[0], 2);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root:    str = root_r.ok;
    val outside: str = ut_cc3(alloc, root, "-outside", ".bin");
    if (escaped) {
        val leaf:          str             = types_path.filename(outside);
        val main_path:     str             = ut_cc3(alloc, root, "/src/", "main.mach");
        val src:           str             = ut_cc3(alloc, "#[embed(\"../../", leaf, "\")]\nval A: [_]u8;\nfun main() i32 { ret A[0]::i32; }\n");
        val write_bytes_r: err[fs.FsError] = fs.write_bytes(main_path, src, str_len(src), 420);
        if (sel write_bytes_r.err) {
            fs.remove_all(alloc, root);
            session.dnit(?s);
            ret 1;
        }
        val write_bytes_r2: err[fs.FsError] = fs.write_bytes(outside, "xyz", 3::usize, 420);
        if (sel write_bytes_r2.err) {
            fs.remove_all(alloc, root);
            session.dnit(?s);
            ret 1;
        }
    }

    var bad: i32                             = 0;
    val pr:  res[project.Project, fail.Fail] = ut_sema_build(?s, root);
    if (escaped) {
        # refused at the decorator, and the outside file's bytes were never read
        if (sel pr.ok) {
            var p: project.Project = pr.ok;
            project.dnit_project(?p);
            bad = 1;
        }
        if (!ut_diag_has(?s.diags, "`embed` path escapes the project root"))                 { bad = 2; }
        if (!ut_diag_has(?s.diags, "must live inside the project and the file is not read")) { bad = 3; }
        val outside_r: res[intern.StrId, A.Error] = intern.add(?s.interner, outside);
        if (sel outside_r.ok) {
            val cached: opt[*session_embed.EmbedFile] = session_embed.get(?s.embeds, outside_r.ok);
            if (sel cached.some) { bad = 4; }
        }
    }
    or {
        if (sel pr.err) { bad = 5; }
        if (sel pr.ok) {
            var p: project.Project = pr.ok;
            if (diagnostic.has_errors(?s.diags)) { bad = 6; }
            project.dnit_project(?p);
        }
    }
    if (escaped) { fs.remove_file(outside); }
    fs.remove_all(alloc, root);
    session.dnit(?s);
    ret bad;
}

# an embed outside the project root is a refusal that never reads the file
test embed__outside_the_project_root_is_refused_unread {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val escaped: i32 = ut_embed_escape_arm(?alloc, true);
    if (escaped != 0) { ret 10 + escaped; }
    val inside: i32 = ut_embed_escape_arm(?alloc, false);
    if (inside != 0) { ret 20 + inside; }
    ret 0;
}
