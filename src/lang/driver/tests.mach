    val mf: str = "[project]\nid = \"tuplefacts\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out\"\n\n[target.linux]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\nplatform = \"alpha\"\n\n[target.windows]\nisa = \"x86_64\"\nos = \"windows\"\nabi = \"win64\"\nplatform = \"beta\"\n\n[artifact.tuplefacts]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/tuplefacts\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
    var names: [5]str;
    names[0] = "main.mach"; names[1] = "sysv.mach"; names[2] = "win.mach";
    names[3] = "alpha.mach"; names[4] = "beta.mach";
    var texts: [5]str;
    texts[0] = "$if ($mach.build.abi == $mach.abi.sysv64) { use tuplefacts.sysv; } $or ($mach.build.abi == $mach.abi.win64) { use tuplefacts.win; }\n$if ($mach.build.platform == \"alpha\") { use tuplefacts.alpha; } $or ($mach.build.platform == \"beta\") { use tuplefacts.beta; }\nfun main() i32 { ret 0; }\n";
    texts[1] = "pub fun selected() i32 { ret 1; }\n";
    texts[2] = "pub fun selected() i32 { ret 2; }\n";
    texts[3] = "pub fun selected() i32 { ret 3; }\n";
    texts[4] = "pub fun selected() i32 { ret 4; }\n";
    val root_r: R.Result[str, str] = ut_scaffold_m(?alloc, mf, ?names[0], ?texts[0], 5);
    if (R.is_err[str, str](root_r)) { session.dnit(?s); ret 2; }
