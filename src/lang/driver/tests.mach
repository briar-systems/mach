test "mach.lang.driver:union_ambiguous_multi_artifact_default" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:  session.Session   = sr.ok;
    val rr: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [4]str;
    names[0] = "alpha.mach";
    names[1] = "beta.mach";
    names[2] = "shared_a.mach";
    names[3] = "beta_only.mach";
    var texts: [4]str;
    texts[0] = "use uniontest.shared_a;\n\nfun main() i32 { ret 0; }\n";
    texts[1] = "use uniontest.beta_only;\n\nfun main() i32 { ret 0; }\n";
    texts[2] = "pub fun sa() i32 { ret 1; }\n";
    texts[3] = "pub fun bo() i32 { ret 2; }\n";

    val root_r: res[str, fail.Fail] = ut_scaffold_m(?alloc, ut_manifest_multi(), ?names[0], ?texts[0], 4);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    var bad: i32 = 0;

    var sel_none: manifest.Selection;
    sel_none.target       = "";
    sel_none.profile      = "";
    sel_none.artifact     = "";
    sel_none.want_lib     = false;
    sel_none.has_artifact = false;
    val p0r: res[project.Project, outcome.Fail] = driver.build_project_sel(?s, root, ?sel_none);
    if (sel p0r.ok) {
        var p0: project.Project = p0r.ok;
        project.dnit_project(?p0);
        bad = 1;
    }

    var sel_alpha: manifest.Selection;
    sel_alpha.target       = "";
    sel_alpha.profile      = "";
    sel_alpha.artifact     = "alpha";
    sel_alpha.want_lib     = false;
    sel_alpha.has_artifact = true;
    val par: res[project.Project, outcome.Fail] = driver.build_project_sel(?s, root, ?sel_alpha);
    if (sel par.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var pa: project.Project = par.ok;
    if (!ut_has(?pa, ?s, "uniontest.alpha"))    { bad = 1; }
    or (!ut_has(?pa, ?s, "uniontest.shared_a")) { bad = 1; }
    or (ut_has(?pa, ?s, "uniontest.beta"))      { bad = 1; }
    or (ut_has(?pa, ?s, "uniontest.beta_only")) { bad = 1; }
    project.dnit_project(?pa);

    val pur: res[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
    if (sel pur.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var pu: project.Project = pur.ok;
    if (!ut_has(?pu, ?s, "uniontest.alpha"))     { bad = 1; }
    or (!ut_has(?pu, ?s, "uniontest.beta"))      { bad = 1; }
    or (!ut_has(?pu, ?s, "uniontest.beta_only")) { bad = 1; }
    project.dnit_project(?pu);

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

