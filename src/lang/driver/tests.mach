}

fun ut_readout_rows_case(jobs: u32) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [17]str;
    var texts: [17]str;
    ut_ro_files(?alloc, ?names[0], ?texts[0]);

    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 17);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    val mr: res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var m:  manifest.Manifest    = mr.ok;
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    rq.jobs         = jobs;
    val pr_r: res[bplan.BuildPlan, outcome.Fail] = bplan.plan(?alloc, ?s.interner, s.registry, ?m, rq);
    if (sel pr_r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var bp: bplan.BuildPlan = pr_r.ok;

    var ev: readout.Progress;
    readout.init(?ev, ?alloc, readout.LEVEL_PHASES);

    val t0: readout.Instant = readout.sample();
    readout.unit_begin(?ev);
    val r:    res[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, ?alloc, ?ev);
    val wall: cdur.Duration                           = readout.elapsed(t0);

    var bad: i32 = 0;
    if (sel r.err) { bad = 1; }
    if (sel r.ok) {
        val bo: outcome.BuildOutcome = r.ok;
        if (bo.severity != outcome.BUILD_OK) { bad = 1; }
        if (bo.artifacts.len != 1)           { bad = 1; }
    }

    var phs: [8]u8;
    phs[0] = readout.PH_LOAD;
    phs[1] = readout.PH_RESOLVE;
    phs[2] = readout.PH_SEMA;
    phs[3] = readout.PH_LOWER;
    phs[4] = readout.PH_OPTIMIZE;
    phs[5] = readout.PH_CODEGEN;
    phs[6] = readout.PH_EMIT;
    phs[7] = readout.PH_LINK;

    var sum: cdur.Duration = 0;
    var i:   u32           = 0;
    for (i < 8) {
        val ph: u32                   = phs[i]::u32;
        val pm: *readout.PhaseMetrics = ?ev.metrics[ph];
        if (pm.occurrences != 1)  { bad = 10 + i::i32; }
        if (pm.elapsed <= 0)      { bad = 20 + i::i32; }
        if (pm.item_count == 0)   { bad = 30 + i::i32; }
        if (pm.item_elapsed <= 0) { bad = 40 + i::i32; }
        if (pm.workers == 0)      { bad = 50 + i::i32; }

        if (pm.elapsed * pm.workers::cdur.Duration < pm.item_elapsed) { bad = 60 + i::i32; }

        sum = sum + pm.elapsed;
        i   = i + 1;
    }

    if (ev.other < 0) { bad = 1; }
    val acc: cdur.Duration = sum + ev.other;
    if (acc > wall)     { bad = 70; }
    if (acc * 2 < wall) { bad = 71; }

    readout.dnit(?ev);
    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.readout:serial_build_rows_are_one_per_phase_and_bound_their_work" {
    ret ut_readout_rows_case(0);
}

test "mach.lang.readout:pooled_build_rows_are_one_per_phase_and_bound_their_work" {
    ret ut_readout_rows_case(4);
}

test "mach.lang.readout:the_monotonic_clock_runs" {
    val t0: readout.Instant = readout.sample();
    if (sel t0.none)                           { ret 1; }
    if (t0.some.sec == 0 && t0.some.nsec == 0) { ret 1; }

    var acc: i64 = 1;
    var i:   i64 = 0;
    for (i < 1000000) {
        acc = (acc * 31 + i) % 1000003;
        i   = i + 1;
    }
    if (acc < 0) { ret 1; }

    if (readout.elapsed(t0) <= 0) { ret 1; }
    ret 0;
}

test "mach.lang.build.engine.execute_warm:sema_phase_diagnostic_fails_build" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = ut_cc3(?alloc, "#[symbol(\"", ut_entry_symbol(), "\")]\nfun start() i32 { val x: u32 = \"not a u32\"; ret 0; }\n");
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    val mr: res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var m:  manifest.Manifest    = mr.ok;
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    val pr: res[bplan.BuildPlan, outcome.Fail] = bplan.plan(?alloc, ?s.interner, s.registry, ?m, rq);
    if (sel pr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var bp: bplan.BuildPlan = pr.ok;

    var bad: i32                                     = 0;
    val r:   res[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, ?alloc, nil);
    if (sel r.err) { bad = 1; }
    if (sel r.ok) {
        val bo: outcome.BuildOutcome = r.ok;
        if (bo.severity == outcome.BUILD_OK) { bad = 1; }
        if (bo.artifacts.len != 0)           { bad = 1; }
    }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

fun ut_lower_n(s: *session.Session, alloc: *A.Allocator, names: *str, texts: *str, n: u32) res[project.Project, outcome.Fail] {
    val root_r: res[str, fail.Fail] = ut_scaffold(alloc, names, texts, n);
    if (sel root_r.err) { ret res[project.Project, outcome.Fail].err{outcome.from_fail(root_r.err)}; }
    val root: str               = root_r.ok;
    val rr:   err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.err) {
        fs.remove_all(alloc, root);
        ret res[project.Project, outcome.Fail].err{rr.err};
    }
    var tsel_11572: manifest.Selection                 = ut_target_sel("linux");
    val pr:         res[project.Project, outcome.Fail] = driver.build_project(s, root, ?tsel_11572);
    fs.remove_all(alloc, root);
    if (sel pr.err) { ret pr; }
    var p:  project.Project   = pr.ok;
    val se: err[outcome.Fail] = driver.run_sema_pass(?p);
    if (sel se.err) {
        project.dnit_project(?p);
        ret res[project.Project, outcome.Fail].err{se.err};
    }
    val le: err[outcome.Fail] = driver.run_lower_pass(?p);
    if (sel le.err) {
        project.dnit_project(?p);
        ret res[project.Project, outcome.Fail].err{le.err};
    }
    ret res[project.Project, outcome.Fail].ok{p};
}

fun ut_ir_of(p: *project.Project, s: *session.Session, fqn: str) *ir.Module {
    val mid: session.ModuleId = ut_mid(p, s, fqn);
    if (mid == session.MODULE_NIL) { ret nil; }
    ret p.modules[mid::u32].ir_module;
}

fun ut_const_uses(m: *ir.Module, want: u64) u32 {
    ret ut_operand_uses(m, value.VAL_CONST_INT, want);
}

fun ut_operand_uses(m: *ir.Module, kind: value.ValueKind, want: u64) u32 {
    if (m == nil) { ret 0; }
    var hits: u32 = 0;
    var fi:   u32 = 0;
    for (fi < m.function_len) {
        val f:  *ir.Function = ?m.functions[fi];
        var bi: u32          = 0;
        for (bi < f.block_count) {
            val b: *ir.Block = ?f.blocks[bi];
            var k: u32       = 0;
            for (k < b.phi_count) {
                hits = hits + ut_instr_uses(f, b.phis[k], kind, want);
                k    = k + 1;
            }
            k = 0;
            for (k < b.instr_count) {
                hits = hits + ut_instr_uses(f, b.instructions[k], kind, want);
                k    = k + 1;
            }
            hits = hits + ut_instr_uses(f, b.terminator, kind, want);
            bi   = bi + 1;
        }
        fi = fi + 1;
    }
    ret hits;
}

fun ut_instr_uses(f: *ir.Function, iid: ir.InstructionId, kind: value.ValueKind, want: u64) u32 {
    val opt_ins: opt[*instruction.Instruction] = ir.instruction_get(f, iid);
    if (sel opt_ins.none) { ret 0; }
    val ins:  *instruction.Instruction = opt_ins.some;
    var hits: u32                      = 0;
    var oi:   u32                      = 0;
    for (oi < ins.operand_count) {
        val v: *value.Value = ?ins.operands[oi];
        if (v.kind == kind) {
            if (kind == value.VAL_CONST_INT && v.data.int_lit == want)     { hits = hits + 1; }
            if (kind == value.VAL_GLOBAL && v.data.global_ix::u64 == want) { hits = hits + 1; }
        }
        oi = oi + 1;
    }
    ret hits;
}

fun ut_global_ix(s: *session.Session, m: *ir.Module, needle: str) i64 {
    if (m == nil) { ret -1; }
    var gi: u32 = 0;
    for (gi < m.global_len) {
        val nm: opt[str] = intern.lookup(?s.interner, (?m.globals[gi]).name);
        if (sel nm.some && ut_str_contains(nm.some, needle)) { ret gi::i64; }
        gi = gi + 1;
    }
    ret -1;
}

fun ut_global_uses(m: *ir.Module, gi: u32) u32 {
    ret ut_operand_uses(m, value.VAL_GLOBAL, gi::u64);
}

fun ut_has_extern_global(s: *session.Session, m: *ir.Module, needle: str) bool {
    if (m == nil) { ret false; }
    var gi: u32 = 0;
    for (gi < m.global_len) {
        val g: *ir.Global = ?m.globals[gi];
        if (g.is_extern) {
            val nm: opt[str] = intern.lookup(?s.interner, g.name);
            if (sel nm.some && ut_str_contains(nm.some, needle)) { ret true; }
        }
        gi = gi + 1;
    }
    ret false;
}

fun ut_has_extern_fn(s: *session.Session, m: *ir.Module, needle: str) bool {
    if (m == nil) { ret false; }
    var fi: u32 = 0;
    for (fi < m.function_len) {
        val f: *ir.Function = ?m.functions[fi];
        if ((f.flags & ir.FN_FLAG_EXTERN) != 0) {
            val nm: opt[str] = intern.lookup(?s.interner, f.name);
            if (sel nm.some && ut_str_contains(nm.some, needle)) { ret true; }
        }
        fi = fi + 1;
    }
    ret false;
}

test "mach.lang.driver:qualified_const_ignores_local_val_shadow" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [3]str;
    names[0] = "main.mach";
    names[1] = "a.mach";
    names[2] = "b.mach";
    var texts: [3]str;
    texts[0] = "use uniontest.a;\nuse uniontest.b;\nval X: i64 = 707;\npub fun p1() i64 { ret a.X; }\npub fun p2() i64 { ret X; }\npub fun p3() i64 { ret b.Y; }\nfun main() i32 { ret 0; }\n";
    texts[1] = "pub val X: i64 = 909;\n";
    texts[2] = "pub val Y: i64 = 505;\n";

    val pr: res[project.Project, outcome.Fail] = ut_lower_n(?s, ?alloc, ?names[0], ?texts[0], 3);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    var bad: i32        = 0;
    val m:   *ir.Module = ut_ir_of(?p, ?s, "uniontest.main");
    if (m == nil) { bad = 1; }
    or {
        if (ut_const_uses(m, 909) != 1) { bad = 1; }
        if (ut_const_uses(m, 707) != 1) { bad = 1; }

        val gx: i64 = ut_global_ix(?s, m, "uniontest.main.X");
        if (gx < 0) { bad = 1; }
        or {
            if (ut_global_uses(m, gx::u32) != 0)                { bad = 1; }
            if ((?m.globals[gx::u32]).init.data.int_lit != 707) { bad = 1; }
        }

        if (ut_const_uses(m, 505) != 1) { bad = 1; }
    }

    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

