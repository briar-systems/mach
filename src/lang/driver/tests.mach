test "mach.lang.driver:w64_vector_compare_saves_xmm_scratch" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }

    var img: Vector[u8];
    if (!ut_w64xmmscratch_image(?alloc, ?img)) { ret 2; }

    var text_sec: UtPeSec;
    var pdata_sec: UtPeSec;
    var xdata_sec: UtPeSec;
    if (!ut_pe_find_sec(?img, ".text", ?text_sec))   { ret 3; }
    if (!ut_pe_find_sec(?img, ".pdata", ?pdata_sec)) { ret 4; }
    if (!ut_pe_find_sec(?img, ".xdata", ?xdata_sec)) { ret 5; }

    val b: *u8 = img.data;
    val n: u32 = pdata_sec.vsize / 12;
    if (n < 1) { ret 6; }

    var saw14: bool = false;
    var saw15: bool = false;

    var i: u32 = 0;
    for (i < n) {
        val row: usize = pdata_sec.raw::usize + i::usize * 12;
        val uw_rva: u32 = ut_le32(b, row + 8)::u32;
        val xo_s: i64 = ut_pe_sec_off(?xdata_sec, uw_rva);
        if (xo_s < 0) { ret 7; }
        val xo: usize = xo_s::usize;
        if (b[xo] != 0x01) { ret 8; }
        val cnt: u32 = b[xo + 2]::u32;

        var j: u32 = 0;
        for (j < cnt) {
            val slot: usize = xo + 4 + j::usize * 2;
            val op: u8 = b[slot + 1] & 0x0F;
            val info: u8 = b[slot + 1] >> 4;
            if (op == 8) {
                if (info == 14) { saw14 = true; }
                or (info == 15) { saw15 = true; }
                j = j + 1;
            }
            or (op == 9) { j = j + 2; }
            or (op == 1) { j = j + 2; }
            j = j + 1;
        }
        i = i + 1;
    }

    if (!saw14 || !saw15) { ret 9; }

    vector.dnit[u8](?img);
    ret 0;
}

test "mach.lang.driver.passes.q_link:records_the_test_qualified_codegen_key" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    if (R.is_err[R.Void, str](driver.setup_registry(?s.registry))) { session.dnit(?s); ret 1; }

    var names: [2]str;
    names[0] = "main.mach"; names[1] = "a.mach";
    var texts: [2]str;
    texts[0] = ut_cc3(?alloc, "use uniontest.a.fa;\n#[symbol(\"", ut_entry_symbol(), "\")]\nfun start() i32 { ret fa(); }\n");
    texts[1] = "pub fun fa() i32 { ret 0; }\n\ntest \"a.zero\" { ret fa(); }\n";
    val root_r: R.Result[str, str] = ut_scaffold(?alloc, ?names[0], ?texts[0], 2);
    if (R.is_err[str, str](root_r)) { session.dnit(?s); ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);

    val mr: R.Result[manifest.Manifest, str] = driver.load_manifest(?s, root);
    if (R.is_err[manifest.Manifest, str](mr)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    var m: manifest.Manifest = R.unwrap_ok[manifest.Manifest, str](mr);
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    rq.goal         = request.GOAL_TESTS;
    val pr: R.Result[bplan.BuildPlan, outcome.Fail] = bplan.plan(?alloc, ?s.interner, ?s.registry, ?m, rq);
    if (R.is_err[bplan.BuildPlan, outcome.Fail](pr)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    var bp: bplan.BuildPlan = R.unwrap_ok[bplan.BuildPlan, outcome.Fail](pr);

    var bad: i32 = 0;
    val r1: R.Result[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, ?alloc, nil);
    if (R.is_err[outcome.BuildOutcome, outcome.Fail](r1)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    if (R.unwrap_ok[outcome.BuildOutcome, outcome.Fail](r1).severity != outcome.BUILD_OK) { bad = 1; }

    val e_r: R.Result[*query.QueryEntry, str] = query.peek(?s.queries, query.Q_LINK, 0);
    if (R.is_err[*query.QueryEntry, str](e_r)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    val e: *query.QueryEntry = R.unwrap_ok[*query.QueryEntry, str](e_r);

    var codegen_deps: u32 = 0;
    var i: u32 = 0;
    for (i < e.dep_len) {
        val d: *query.Dep = ?e.deps[i];
        if (d.kind == query.Q_CODEGEN) {
            codegen_deps = codegen_deps + 1;
            if (!passes.back_half_key_is_test(d.key)) { bad = 1; }
        }
        i = i + 1;
    }
    if (codegen_deps == 0) { bad = 1; }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.build.engine.artifact_reusable:a_tampered_test_dispatcher_is_relinked" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    if (R.is_err[R.Void, str](driver.setup_registry(?s.registry))) { session.dnit(?s); ret 1; }

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = ut_cc3(?alloc, "#[symbol(\"", ut_entry_symbol(), "\")]\nfun start() i32 { ret 0; }\n");
    val root_r: R.Result[str, str] = ut_scaffold(?alloc, ?names[0], ?texts[0], 1);
    if (R.is_err[str, str](root_r)) { session.dnit(?s); ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);

    val mr: R.Result[manifest.Manifest, str] = driver.load_manifest(?s, root);
    if (R.is_err[manifest.Manifest, str](mr)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    var m: manifest.Manifest = R.unwrap_ok[manifest.Manifest, str](mr);
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    val pr: R.Result[bplan.BuildPlan, outcome.Fail] = bplan.plan(?alloc, ?s.interner, ?s.registry, ?m, rq);
    if (R.is_err[bplan.BuildPlan, outcome.Fail](pr)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    var bp: bplan.BuildPlan = R.unwrap_ok[bplan.BuildPlan, outcome.Fail](pr);

    var bad: i32 = 0;
    val r1: R.Result[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, ?alloc, nil);
    if (R.is_err[outcome.BuildOutcome, outcome.Fail](r1)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    val bo1: outcome.BuildOutcome = R.unwrap_ok[outcome.BuildOutcome, outcome.Fail](r1);
    if (bo1.severity != outcome.BUILD_OK || bo1.artifacts.len != 1) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    val exe: str = bo1.artifacts.data[0].path;

    var good: [32]u8;
    if (R.is_err[R.Void, str](bfingerprint.file_sha256(exe, ?good[0]))) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }

    val junk: str = "not an executable";
    if (O.is_some[str](fs.write_bytes(exe, junk::*u8, str_len(junk), 493))) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    var corrupt: [32]u8;
    if (R.is_err[R.Void, str](bfingerprint.file_sha256(exe, ?corrupt[0]))) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    if (ut_digest_eq(?good[0], ?corrupt[0])) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }

    val r2: R.Result[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, ?alloc, nil);
    if (R.is_err[outcome.BuildOutcome, outcome.Fail](r2)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    if (R.unwrap_ok[outcome.BuildOutcome, outcome.Fail](r2).severity != outcome.BUILD_OK) { bad = 1; }

    var after: [32]u8;
    if (R.is_err[R.Void, str](bfingerprint.file_sha256(exe, ?after[0]))) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    if (!ut_digest_eq(?good[0], ?after[0])) { bad = 1; }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

fun ut_digest_eq(a: *u8, b: *u8) bool {
    var i: usize = 0;
    for (i < 32) {
        if (a[i] != b[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun ut_manifest_renamed_artifact() str {
    ret "[project]\nid = \"uniontest\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.linux]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[artifact.uniontest]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/renamed\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
}

test "mach.lang.build.engine.execute_warm:refuses_a_manifest_that_changed_after_planning" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    if (R.is_err[R.Void, str](driver.setup_registry(?s.registry))) { session.dnit(?s); ret 1; }

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = ut_cc3(?alloc, "#[symbol(\"", ut_entry_symbol(), "\")]\nfun start() i32 { ret 0; }\n");
    val root_r: R.Result[str, str] = ut_scaffold(?alloc, ?names[0], ?texts[0], 1);
    if (R.is_err[str, str](root_r)) { session.dnit(?s); ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);

    val mr: R.Result[manifest.Manifest, str] = driver.load_manifest(?s, root);
    if (R.is_err[manifest.Manifest, str](mr)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    var m: manifest.Manifest = R.unwrap_ok[manifest.Manifest, str](mr);
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    val pr: R.Result[bplan.BuildPlan, outcome.Fail] = bplan.plan(?alloc, ?s.interner, ?s.registry, ?m, rq);
    if (R.is_err[bplan.BuildPlan, outcome.Fail](pr)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    var bp: bplan.BuildPlan = R.unwrap_ok[bplan.BuildPlan, outcome.Fail](pr);

    val mf: str = ut_cc3(?alloc, root, "/", manifest.MANIFEST_FILE);
    val alt: str = ut_manifest_renamed_artifact();
    if (O.is_some[str](fs.write_bytes(mf, alt, str_len(alt), 420))) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }

    var bad: i32 = 0;
    val r: R.Result[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, ?alloc, nil);
    if (R.is_err[outcome.BuildOutcome, outcome.Fail](r)) { bad = 1; }
    or {
        var bo: outcome.BuildOutcome = R.unwrap_ok[outcome.BuildOutcome, outcome.Fail](r);
        if (bo.severity != outcome.BUILD_USER) { bad = 1; }
        or (bo.events.len == 0)                { bad = 1; }
        or (!ut_str_contains(bo.events.data[0].data.fail.message, "changed after this build was planned")) { bad = 1; }
        outcome.outcome_dnit(?bo);
    }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

fun ut_manifest_step_target_env() str {
    ret "[project]\nid = \"tenv\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.linux]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[step.probe]\nargv = [\"sh\", \"-c\", 'test \"$MACH_TARGET_ISA\" = x86_64 && test \"$MACH_TARGET_OS\" = linux && test \"$MACH_TARGET_ABI\" = sysv64 && printf ok > seen']\nenv = { MACH_TARGET_ISA = \"spoofed\", CARRIED = \"through\" }\nin = []\nout = [\"seen\"]\nneed = []\n\n[artifact.app]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/app\"\ntargets = [\"*\"]\nlink = []\nneed = [\"probe\"]\n";
}

test "mach.lang.driver:step_target_environment_replaces_a_declared_override" {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    if (R.is_err[R.Void, str](driver.setup_registry(?s.registry))) { session.dnit(?s); ret 1; }

    var names: [1]str; names[0] = "main.mach";
    var texts: [1]str; texts[0] = "fun main() i32 { ret 0; }\n";
    val root_r: R.Result[str, str] = ut_scaffold_m(?alloc, ut_manifest_step_target_env(), ?names[0], ?texts[0], 1);
    if (R.is_err[str, str](root_r)) { session.dnit(?s); ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);

    var bad: i32 = 0;
    var sel: manifest.Selection;
    sel.target = "linux"; sel.profile = ""; sel.artifact = "app"; sel.want_lib = false; sel.has_artifact = true;
    val pr: R.Result[project.Project, outcome.Fail] = driver.build_project_sel(?s, root, ?sel);
    if (R.is_err[project.Project, outcome.Fail](pr)) { bad = 1; }
    or { var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr); project.dnit_project(?p); }

    val seen_r: R.Result[str, str] = path.resolve(?alloc, root, "seen");
    if (R.is_err[str, str](seen_r)) { bad = 1; }
    or {
        val text_r: R.Result[str, str] = fs.read_string(?alloc, R.unwrap_ok[str, str](seen_r));
        if (R.is_err[str, str](text_r)) { bad = 1; }
        or (!str_equals(R.unwrap_ok[str, str](text_r), "ok")) { bad = 1; }
    }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.session.register_module_identity:allocation_failure_publishes_nothing" {
    var bad: i32 = 0;
    var saw_failure: bool = false;
    var n: u64 = 1;
    for (n <= 400) {
        var backing: A.Allocator;
        if (O.is_some[str](page.make(?backing))) { ret 1; }
        var failing: T.Testing;
        if (O.is_some[str](T.make(?failing))) { ret 1; }
        T.fail_at_ordinal(?failing, n::usize);

        val sr: R.Result[session.Session, str] = session.init(T.allocator_of(?failing));
        if (R.is_err[session.Session, str](sr)) { n = n + 1; cnt; }
        var s: session.Session = R.unwrap_ok[session.Session, str](sr);

        val r: R.Result[R.Void, str] = session.register_module_identity(?s, 3, nil, 9, 5);
        if (R.is_err[R.Void, str](r)) {
            saw_failure = true;
            if (session.module_count(?s) != 0)                       { bad = 1; }
            if (session.module_fqn(?s, 3) != intern.STR_NIL)          { bad = 1; }
            if (session.module_id_for_stable(?s, 5) != session.MODULE_NIL) { bad = 1; }
        }
        or {
            if (session.module_count(?s) != 4)                        { bad = 1; }
            if (session.module_fqn(?s, 3) != 9)                       { bad = 1; }
            if (session.module_id_for_stable(?s, 5) != 3)             { bad = 1; }
        }
        session.dnit(?s);
        if (T.tracking_exhausted(?failing)) { T.dnit(?failing); ret 1; }
        if (T.leaked(?failing) || T.double_free_count(?failing) != 0) { T.dnit(?failing); ret 1; }
        T.dnit(?failing);
        n = n + 1;
    }
    if (!saw_failure) { bad = 1; }
    ret bad;
}

test "mach.lang.session.register_module_phase:allocation_failure_publishes_nothing" {
    var bad: i32 = 0;
    var saw_failure: bool = false;
    var n: u64 = 1;
    for (n <= 400) {
        var backing: A.Allocator;
        if (O.is_some[str](page.make(?backing))) { ret 1; }
        var failing: T.Testing;
        if (O.is_some[str](T.make(?failing))) { ret 1; }
        T.fail_at_ordinal(?failing, n::usize);

        val sr: R.Result[session.Session, str] = session.init(T.allocator_of(?failing));
        if (R.is_err[session.Session, str](sr)) { n = n + 1; cnt; }
        var s: session.Session = R.unwrap_ok[session.Session, str](sr);

        var a_marker: u64 = 0xA;
        var b_marker: u64 = 0xB;
        var c_marker: u64 = 0xC;
        val r: R.Result[R.Void, str] = session.register_module_phase(?s, 2,
            (?a_marker)::ptr, (?b_marker)::ptr, (?c_marker)::ptr);
        if (R.is_err[R.Void, str](r)) {
            saw_failure = true;
            if (session.module_sema_ptr(?s, 2) != nil)     { bad = 1; }
            if (session.module_resolve_ptr(?s, 2) != nil)  { bad = 1; }
            if (session.module_comptime_ptr(?s, 2) != nil) { bad = 1; }
        }
        or {
            if (session.module_sema_ptr(?s, 2) != (?a_marker)::ptr)     { bad = 1; }
            if (session.module_resolve_ptr(?s, 2) != (?b_marker)::ptr)  { bad = 1; }
            if (session.module_comptime_ptr(?s, 2) != (?c_marker)::ptr) { bad = 1; }
        }
        session.dnit(?s);
        if (T.tracking_exhausted(?failing)) { T.dnit(?failing); ret 1; }
        if (T.leaked(?failing) || T.double_free_count(?failing) != 0) { T.dnit(?failing); ret 1; }
        T.dnit(?failing);
        n = n + 1;
    }
    if (!saw_failure) { bad = 1; }
    ret bad;
}

fun ut_orphan_goal(target_name: str, expected_count: usize, expected_skipped: u32) i32 {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    if (R.is_err[R.Void, str](driver.setup_registry(?s.registry))) { session.dnit(?s); ret 1; }

    var names: [2]str;
    names[0] = "main.mach"; names[1] = "gated.mach";
    var texts: [2]str;
    texts[0] = ut_cc3(?alloc, "#[symbol(\"", ut_entry_symbol(), "\")]\nfun start() i32 { ret 0; }\n\ntest \"main.runs\" { ret 0; }\n");
    texts[1] = "$if ($mach.build.os != $mach.os.windows) {\n    $error(\"uniontest.gated: requires windows target\");\n}\n\npub val HANDLE: u32 = 7;\n\ntest \"gated.never_runs\" { ret 0; }\n";
    val root_r: R.Result[str, str] = ut_scaffold(?alloc, ?names[0], ?texts[0], 2);
    if (R.is_err[str, str](root_r)) { session.dnit(?s); ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);

    val mr: R.Result[manifest.Manifest, str] = driver.load_manifest(?s, root);
    if (R.is_err[manifest.Manifest, str](mr)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    var m: manifest.Manifest = R.unwrap_ok[manifest.Manifest, str](mr);
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    rq.target       = target_name;
    rq.debug        = false;
    rq.goal         = request.GOAL_TESTS;
    val pr: R.Result[bplan.BuildPlan, outcome.Fail] = bplan.plan(?alloc, ?s.interner, ?s.registry, ?m, rq);
    if (R.is_err[bplan.BuildPlan, outcome.Fail](pr)) {
        print.eprintlnf("orphan target {} planning failed: {}", target_name, R.unwrap_err[bplan.BuildPlan, outcome.Fail](pr).message);
        fs.remove_all(?alloc, root); session.dnit(?s); ret 1;
    }
    var bp: bplan.BuildPlan = R.unwrap_ok[bplan.BuildPlan, outcome.Fail](pr);

    var bad: i32 = 0;
    val r: R.Result[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, ?alloc, nil);
    if (R.is_err[outcome.BuildOutcome, outcome.Fail](r)) {
        print.eprintlnf("orphan target {} execution failed: {}", target_name, R.unwrap_err[outcome.BuildOutcome, outcome.Fail](r).message);
        bad = 1;
    }
    or {
        var bo: outcome.BuildOutcome = R.unwrap_ok[outcome.BuildOutcome, outcome.Fail](r);
        if (bo.severity != outcome.BUILD_OK)   { bad = 1; }
        or (bo.tests.len != expected_count) { bad = 1; }
        or {
            var found_main: bool = false;
            var found_gated: bool = false;
            var index: usize = 0;
            for (index < bo.tests.len) {
                val label: str = bo.tests.data[index].label::str;
                if (str_equals(label, "main.runs")) { found_main = true; }
                or (str_equals(label, "gated.never_runs")) { found_gated = true; }
                or { bad = 1; }
                index = index + 1;
            }
            if (!found_main || found_gated != (expected_skipped == 0)) { bad = 1; }
        }
        if (bo.tests_skipped != expected_skipped) { bad = 1; }
        if (bad != 0) {
            print.eprintlnf("orphan target {}: severity {}, tests {}/{}, skipped {}/{}", target_name,
                bo.severity, bo.tests.len, expected_count, bo.tests_skipped, expected_skipped);
        }
        outcome.outcome_dnit(?bo);
    }

    if (bad != 0) {
        var di: usize = 0;
        for (di < diagnostic.len(?s.diags)) { print.eprintln(s.diags.items.data[di].message); di = di + 1; }
    }
    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.driver:test_goal_skips_a_target_gated_orphan_module" {
    if (ut_orphan_goal("linux", 1, 1) != 0) { ret 1; }
    if (ut_orphan_goal("windows", 2, 0) != 0) { ret 2; }
    ret 0;
}

test "mach.lang.driver:test_goal_reports_a_compile_error_and_collects_no_tests" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    if (R.is_err[R.Void, str](driver.setup_registry(?s.registry))) { session.dnit(?s); ret 1; }

    var names: [2]str;
    names[0] = "main.mach"; names[1] = "bad.mach";
    var texts: [2]str;
    texts[0] = ut_cc3(?alloc, "#[symbol(\"", ut_entry_symbol(), "\")]\nfun start() i32 { ret 0; }\n\ntest \"main.runs\" { ret 0; }\n");
    texts[1] = "pub fun oops() i32 { ret uniontest_undefined_symbol(); }\n";
    val root_r: R.Result[str, str] = ut_scaffold(?alloc, ?names[0], ?texts[0], 2);
    if (R.is_err[str, str](root_r)) { session.dnit(?s); ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);

    val mr: R.Result[manifest.Manifest, str] = driver.load_manifest(?s, root);
    if (R.is_err[manifest.Manifest, str](mr)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    var m: manifest.Manifest = R.unwrap_ok[manifest.Manifest, str](mr);
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    rq.goal         = request.GOAL_TESTS;
    val pr: R.Result[bplan.BuildPlan, outcome.Fail] = bplan.plan(?alloc, ?s.interner, ?s.registry, ?m, rq);
    if (R.is_err[bplan.BuildPlan, outcome.Fail](pr)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    var bp: bplan.BuildPlan = R.unwrap_ok[bplan.BuildPlan, outcome.Fail](pr);

    var bad: i32 = 0;
    val r: R.Result[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, ?alloc, nil);
    if (R.is_err[outcome.BuildOutcome, outcome.Fail](r)) { bad = 1; }
    or {
        var bo: outcome.BuildOutcome = R.unwrap_ok[outcome.BuildOutcome, outcome.Fail](r);
        if (bo.severity == outcome.BUILD_OK) { bad = 1; }
        or (bo.tests.len != 0)               { bad = 1; }
        outcome.outcome_dnit(?bo);
    }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

fun ut_first_gate_cond(a: *ast.Ast) aid.ExprId {
    val m_opt: O.Option[*amodule.Module] = ast.get_module(a, a.root_module);
    if (O.is_none[*amodule.Module](m_opt)) { ret aid.EXPR_NIL; }
    val mnode: *amodule.Module = O.unwrap[*amodule.Module](m_opt);
    var i: u32 = 0;
    for (i < mnode.decls_len) {
        val did: aid.DeclId = a.decl_ids[mnode.decls_start + i];
        val d_opt: O.Option[*decl.Decl] = ast.get_decl(a, did);
        if (O.is_some[*decl.Decl](d_opt)) {
            val d: *decl.Decl = O.unwrap[*decl.Decl](d_opt);
            if (d.kind == decl.DECL_KIND_COMPTIME_IF && d.data.comptime_if.branches_len > 0) {
                ret (?a.comptime_branches[d.data.comptime_if.branches_start]).cond;
            }
        }
        i = i + 1;
    }
    ret aid.EXPR_NIL;
}

fun ut_module_gate_state(p: *project.Project, s: *session.Session, fqn: str, cond: aid.ExprId) comptime.GateState {
    val idr: R.Result[intern.StrId, str] = intern.intern(?s.interner, fqn);
    if (R.is_err[intern.StrId, str](idr)) { ret comptime.GATE_STATE_UNKNOWN; }
    var name: intern.StrId = R.unwrap_ok[intern.StrId, str](idr);
    val mr: R.Result[*session.ModuleId, str] = map.get[intern.StrId, session.ModuleId](?p.by_fqn, ?name);
    if (R.is_err[*session.ModuleId, str](mr)) { ret comptime.GATE_STATE_UNKNOWN; }
    val mid: session.ModuleId = R.unwrap_ok[*session.ModuleId, str](mr)[0];
    ret comptime.gate_state(?(?p.modules[mid::u32]).ctx, cond);
}

test "mach.lang.driver:one_gate_decides_the_same_in_every_phase" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    var names: [2]str; names[0] = "main.mach"; names[1] = "lib.mach";
    var texts: [2]str;
    texts[0] = "val FLAG: u8 = 1;\n$if (FLAG) { use uniontest.lib; fun picked() i32 { ret lib.value(); } } $or { use uniontest.missing; }\nfun probe[T](x: T) i32 { $if (FLAG) { ret 1; } ret 0; }\nfun main() i32 { ret picked() + probe[i32](1); }\n";
    texts[1] = "pub fun value() i32 { ret 7; }\n";

    val root_r: R.Result[str, str] = ut_scaffold(?alloc, ?names[0], ?texts[0], 2);
    if (R.is_err[str, str](root_r)) { session.dnit(?s); ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);
    if (R.is_err[R.Void, str](driver.setup_registry(?s.registry))) {
        fs.remove_all(?alloc, root); session.dnit(?s); ret 2;
    }
    var tsel_19516: manifest.Selection = ut_target_sel("linux");
    val pr: R.Result[project.Project, outcome.Fail] = driver.build_project(?s, root, ?tsel_19516);
    fs.remove_all(?alloc, root);
    if (R.is_err[project.Project, outcome.Fail](pr)) { session.dnit(?s); ret 3; }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);

    var bad: i32 = 0;
    val a: *ast.Ast = ut_ast(?p, ?s, "uniontest.main");
    if (a == nil) { bad = 4; }
    val cond: aid.ExprId = ut_first_gate_cond(a);
    if (bad == 0 && cond == aid.EXPR_NIL) { bad = 5; }

    if (bad == 0 && !ut_has(?p, ?s, "uniontest.lib")) { bad = 6; }
    if (bad == 0 && ut_has(?p, ?s, "uniontest.missing")) { bad = 7; }
    if (bad == 0 && ut_module_gate_state(?p, ?s, "uniontest.main", cond) != comptime.GATE_STATE_TRUE) { bad = 8; }

    if (bad == 0) {
        val se: R.Result[R.Void, outcome.Fail] = passes.run_sema_pass(?p);
        if (R.is_err[R.Void, outcome.Fail](se)) { bad = 9; }
        or (ut_count_errors(?p.s.diags) != 0) { bad = 10; }
        or (ut_module_gate_state(?p, ?s, "uniontest.main", cond) != comptime.GATE_STATE_TRUE) { bad = 11; }
    }
    if (bad == 0) {
        val le: R.Result[R.Void, outcome.Fail] = passes.run_lower_pass(?p);
        if (R.is_err[R.Void, outcome.Fail](le)) { bad = 12; }
        or (ut_module_gate_state(?p, ?s, "uniontest.main", cond) != comptime.GATE_STATE_TRUE) { bad = 13; }
    }

    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.driver:undecided_gate_is_retried_when_its_dependency_binds" {
    if (ut_single_ok("$if (LATER) { fun picked() i32 { ret 3; } }\nval LATER: u8 = 1;\nfun main() i32 { ret picked(); }\n") != 0) { ret 1; }
    if (ut_single_ok("$if (LATER == 1) { fun picked() i32 { ret 3; } } $or { use uniontest.missing; }\nval LATER: u8 = 1;\nfun main() i32 { ret picked(); }\n") != 0) { ret 2; }
    if (ut_single_ok2("$if (lib.LATER) { fun picked() i32 { ret 3; } }\nuse uniontest.lib;\nfun main() i32 { ret picked(); }\n", "pub val LATER: u8 = 1;\n") != 0) { ret 3; }
    ret 0;
}

fun ut_gate_diag_located(text: str, needle: str, want_file: str, want_line: usize,
                         want_col: usize, want_text: str) i32 {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    var names: [1]str; names[0] = "main.mach";
    var texts: [1]str; texts[0] = text;
    val root_r: R.Result[str, str] = ut_scaffold(?alloc, ?names[0], ?texts[0], 1);
    if (R.is_err[str, str](root_r)) { session.dnit(?s); ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);
    if (R.is_err[R.Void, str](driver.setup_registry(?s.registry))) {
        fs.remove_all(?alloc, root); session.dnit(?s); ret 2;
    }
    var tsel_19570: manifest.Selection = ut_target_sel("linux");
    val pr: R.Result[project.Project, outcome.Fail] = driver.build_project(?s, root, ?tsel_19570);
    fs.remove_all(?alloc, root);

    var code: i32 = 3;
    var i: usize = 0;
    for (i < diagnostic.len(?s.diags)) {
        val d: *diagnostic.Diagnostic = ?s.diags.items.data[i];
        if (d.severity == diagnostic.SEVERITY_ERROR && ut_str_contains(d.message, needle)) {
            code = 0;
            val f_opt: O.Option[*src.SourceFile] = src.get(?s.sources, d.loc.file_id);
            if (O.is_none[*src.SourceFile](f_opt)) { code = 4; }
            or {
                val f: *src.SourceFile = O.unwrap[*src.SourceFile](f_opt);
                if (!str_contains(f.path, want_file)) { code = 5; }
                or {
                    val pos: src.Position = src.position(f, d.loc.span.offset);
                    if (pos.line != want_line) { code = 6; }
                    or (pos.col != want_col)   { code = 7; }
                    or (!str_region_equals(f.text, d.loc.span.offset, d.loc.span.len, want_text)) { code = 8; }
                }
            }
            i = diagnostic.len(?s.diags);
        }
        or { i = i + 1; }
    }

    if (R.is_ok[project.Project, outcome.Fail](pr)) {
        var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);
        project.dnit_project(?p);
    }
    session.dnit(?s);
    ret code;
}

test "mach.lang.driver:a_gate_whose_dependency_never_binds_is_located_and_named" {
    ret ut_gate_diag_located(
        "val OTHER: u8 = 1;\nfun helper() i32 { ret 0; }\n$if (NEVER_BOUND) { fun picked() i32 { ret 3; } }\nfun main() i32 { ret helper(); }\n",
        "is never decided: `NEVER_BOUND`", "main.mach", 3, 6, "NEVER_BOUND");
}

test "mach.lang.driver:a_stalled_gate_fixpoint_fails_as_reported_with_no_unlocated_line" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    var names: [1]str; names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "val OTHER: u8 = 1;\nfun helper() i32 { ret 0; }\n$if (NEVER_BOUND) { fun picked() i32 { ret 3; } }\nfun main() i32 { ret helper(); }\n";
    val root_r: R.Result[str, str] = ut_scaffold(?alloc, ?names[0], ?texts[0], 1);
    if (R.is_err[str, str](root_r)) { session.dnit(?s); ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);
    if (R.is_err[R.Void, str](driver.setup_registry(?s.registry))) {
        fs.remove_all(?alloc, root); session.dnit(?s); ret 2;
    }
    var tsel_19625: manifest.Selection = ut_target_sel("linux");
    val pr: R.Result[project.Project, outcome.Fail] = driver.build_project(?s, root, ?tsel_19625);
    fs.remove_all(?alloc, root);

    var code: i32 = 0;
    if (R.is_ok[project.Project, outcome.Fail](pr)) {
        var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);
        project.dnit_project(?p);
        code = 3;
    }
    or {
        val f: outcome.Fail = R.unwrap_err[project.Project, outcome.Fail](pr);
        if (f.kind != outcome.FAIL_REPORTED) { code = 4; }
        or (f.message != nil)               { code = 5; }
    }
    var located: bool = false;
    var i: usize = 0;
    for (i < diagnostic.len(?s.diags)) {
        val d: *diagnostic.Diagnostic = ?s.diags.items.data[i];
        if (ut_str_contains(d.message, "could not be resolved")) { code = 6; }
        if (d.severity == diagnostic.SEVERITY_ERROR && ut_str_contains(d.message, "is never decided: `NEVER_BOUND`")) { located = true; }
        i = i + 1;
    }
    if (!located && code == 0) { code = 7; }
    session.dnit(?s);
    ret code;
}

test "mach.lang.driver:bare_import_of_a_dependency_whose_artifacts_name_different_entries_says_so" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    if (R.is_err[R.Void, str](driver.setup_registry(?s.registry))) { session.dnit(?s); ret 1; }

    val origin: str = "https://example.invalid/split.git";
    var names: [1]str; names[0] = "main.mach";
    var texts: [1]str; texts[0] = "use split;\n\nfun main() i32 { ret 0; }\n";
    val root_r: R.Result[str, str] = ut_scaffold_m(?alloc,
        ut_dep_root_git(?alloc, "split", origin), ?names[0], ?texts[0], 1);
    if (R.is_err[str, str](root_r)) { session.dnit(?s); ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);
    val dep_root: str = ut_cc3(?alloc, root, "/", "dep/split");
    val dep_manifest: str = "[project]\nid = \"split\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[artifact.one]\nkind = \"static\"\nentry = \"one.mach\"\nout = \"lib/one\"\ntargets = [\"*\"]\nlink = []\nneed = []\n\n[artifact.two]\nkind = \"static\"\nentry = \"two.mach\"\nout = \"lib/two\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
    var dep_names: [2]str; dep_names[0] = "one.mach"; dep_names[1] = "two.mach";
    var dep_texts: [2]str; dep_texts[0] = "pub fun v() i32 { ret 1; }\n"; dep_texts[1] = "pub fun v() i32 { ret 2; }\n";
    val wr: O.Option[str] = ut_write_node_multi(?alloc, dep_root, dep_manifest, ?dep_names[0], ?dep_texts[0], 2);
    if (O.is_some[str](wr) || !ut_git_repo(?alloc, dep_root, origin)
        || !ut_write_gitmodules(?alloc, root, "split", origin)
        || !ut_git_repo(?alloc, root, "https://example.invalid/app.git")) {
        fs.remove_all(?alloc, root); session.dnit(?s); ret 1;
    }

    var bad: i32 = 0;
    val needle: str = "project 'split' has no public module because its artifacts name different entries; import a full path, or give every [artifact.*] table in its manifest the same entry";
    val pr: R.Result[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
    if (R.is_ok[project.Project, outcome.Fail](pr)) {
        var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);
        project.dnit_project(?p);
        bad = 1;
    }
    or {
        var seen: bool = ut_str_contains(R.unwrap_err[project.Project, outcome.Fail](pr).message, needle);
        var i: usize = 0;
        for (i < diagnostic.len(?s.diags)) {
            if (ut_str_contains(s.diags.items.data[i].message, needle)) { seen = true; }
            i = i + 1;
        }
        if (!seen) { bad = 2; }
    }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.driver:a_test_build_that_picks_the_first_declared_artifact_records_the_deprecation_warning" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    if (R.is_err[R.Void, str](driver.setup_registry(?s.registry))) { session.dnit(?s); ret 1; }

    var names: [1]str; names[0] = "main.mach";
    var texts: [1]str; texts[0] = "fun main() i32 { ret 0; }\n\ntest \"t\" { ret 0; }\n";
    val manifest_text: str = "[project]\nid = \"legacyprimary\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.linux]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[profile.debug]\nopt = 0\ndebug = false\nsimd = \"scalarize\"\n\n[artifact.first]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/first\"\ntargets = [\"*\"]\nlink = []\nneed = []\n\n[artifact.second]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/second\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
    val root_r: R.Result[str, str] = ut_scaffold_m(?alloc, manifest_text, ?names[0], ?texts[0], 1);
    if (R.is_err[str, str](root_r)) { session.dnit(?s); ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);

    var bad: i32 = 0;
    val mr: R.Result[manifest.Manifest, str] = driver.load_manifest(?s, root);
    if (R.is_err[manifest.Manifest, str](mr)) { bad = 1; }
    or {
        var m: manifest.Manifest = R.unwrap_ok[manifest.Manifest, str](mr);
        var cli: request.CliArgs;
        cli.verbosity = 0; cli.quiet = false; cli.target = "linux"; cli.output = nil; cli.emit_asm = false; cli.emit_ir = false;
        cli.profile = nil; cli.bin = nil; cli.lib = nil; cli.all_targets = false; cli.pie = false; cli.subsystem = nil; cli.g = false;
        cli.opt_set = false; cli.opt_release = false; cli.jobs = "1"; cli.include_deps = false;
        cli.link_tokens = vector.init[*u8](?alloc); cli.lib_dirs = vector.init[*u8](?alloc);
        var sel: manifest.Selection = ut_target_sel("linux");
        val rr: R.Result[request.BuildRequest, outcome.Fail] = request.compose(?alloc, ?s.interner, ?m, ?cli, root, request.GOAL_TESTS, ?sel);
        val br: R.Result[plan.BuildPlan, outcome.Fail] = plan.plan(?alloc, ?s.interner, ?s.registry, ?m, R.unwrap_ok[request.BuildRequest, outcome.Fail](rr));
        if (R.is_err[request.BuildRequest, outcome.Fail](rr) || R.is_err[plan.BuildPlan, outcome.Fail](br)) { bad = 2; }
        or {
            var bp: plan.BuildPlan = R.unwrap_ok[plan.BuildPlan, outcome.Fail](br);
            var req: request.BuildRequest = bp.request;
            if (!str_equals(req.artifact, "first") || !req.artifact_by_table_order) { bad = 3; }
            val pr: R.Result[project.Project, outcome.Fail] = driver.begin_build(?s, ?m, ?req, nil);
            if (R.is_err[project.Project, outcome.Fail](pr)) { bad = 4; }
            or {
                var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);
                var seen: bool = false;
                var i: usize = 0;
                for (i < diagnostic.len(?s.diags)) {
                    if (s.diags.items.data[i].severity == diagnostic.SEVERITY_WARNING
                        && ut_str_contains(s.diags.items.data[i].message, "several artifacts are declared and none is marked `default = true`")) { seen = true; }
                    i = i + 1;
                }
                if (!seen) { bad = 5; }
                project.dnit_project(?p);
            }
        }
        manifest.dnit(?m, s.build_alloc);
    }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.driver:deprecated_manifest_keys_warn_for_the_root_and_each_dependency_naming_the_refusal" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    if (R.is_err[R.Void, str](driver.setup_registry(?s.registry))) { session.dnit(?s); ret 1; }

    val origin: str = "https://example.invalid/old.git";
    var names: [1]str; names[0] = "main.mach";
    var texts: [1]str; texts[0] = "fun main() i32 { ret 0; }\n";
    val root_manifest: str = "[project]\nid = \"app\"\nname = \"App\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.linux]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[profile.debug]\nopt = 0\ndebug = false\nsimd = \"scalarize\"\nemit_ir = true\n\n[artifact.app]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/app\"\ntargets = [\"*\"]\nlink = []\nneed = []\n\n[dep.old]\ngit = \"https://example.invalid/old.git\"\nref = \"branch/main\"\n";
    val root_r: R.Result[str, str] = ut_scaffold_m(?alloc, root_manifest, ?names[0], ?texts[0], 1);
    if (R.is_err[str, str](root_r)) { session.dnit(?s); ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);
    val dep_root: str = ut_cc3(?alloc, root, "/", "dep/old");
    val dep_manifest: str = "[project]\nid = \"old\"\ndescription = \"an old library\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[artifact.lib]\nkind = \"static\"\nentry = \"lib.mach\"\nout = \"lib/l\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
    if (O.is_some[str](ut_write_node(?alloc, dep_root, dep_manifest, "lib.mach", "pub fun v() i32 { ret 1; }\n"))
        || !ut_git_repo(?alloc, dep_root, origin)
        || !ut_write_gitmodules(?alloc, root, "old", origin)
        || !ut_git_repo(?alloc, root, "https://example.invalid/app.git")) {
        fs.remove_all(?alloc, root); session.dnit(?s); ret 1;
    }

    var bad: i32 = 0;
    val pr: R.Result[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
    if (R.is_err[project.Project, outcome.Fail](pr)) { bad = 1; }
    or {
        var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);
        var seen_name: bool = false; var seen_emit: bool = false; var seen_dep: bool = false;
        var i: usize = 0;
        for (i < diagnostic.len(?s.diags)) {
            val d: *diagnostic.Diagnostic = ?s.diags.items.data[i];
            if (d.severity != diagnostic.SEVERITY_WARNING) { i = i + 1; cnt; }
            if (ut_str_contains(d.message, "mach.toml: [project] key 'name' is accepted and ignored; 5.0.0 refuses it: remove the key") && !ut_str_contains(d.message, "dep '")) { seen_name = true; }
            if (ut_str_contains(d.message, "mach.toml: [profile.debug] key 'emit_ir' is accepted and ignored; 5.0.0 refuses it")) { seen_emit = true; }
            if (ut_str_contains(d.message, "dep 'old' mach.toml: [project] key 'description' is accepted and ignored; 5.0.0 refuses it")) { seen_dep = true; }
            i = i + 1;
        }
        if (!seen_name) { bad = 2; }
        if (!seen_emit) { bad = 3; }
        if (!seen_dep)  { bad = 4; }
        project.dnit_project(?p);
    }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

fun ut_spirv_float_remainder(src: str) i32 {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    var names: [1]str; names[0] = "main.mach";
    var texts: [1]str; texts[0] = src;
    val pr: R.Result[project.Project, outcome.Fail] = ut_spv_lower(?s, ?alloc, ?names[0], ?texts[0], 1, "", nil, nil, 0);
    if (R.is_err[project.Project, outcome.Fail](pr)) { session.dnit(?s); ret 1; }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);
    var image: of.ObjectImage;
    var err: str = nil;
    var bad: i32 = 0;
    if (!ut_spv_codegen(?p, ?s, "spvcase.main", ?image, ?err)) {
        print.println(err);
        bad = 2;
    }
    or { obj.dnit(?image); }
    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.driver:spirv_float_remainder_f32_has_structured_control_flow" {
    ret ut_spirv_float_remainder("pub fun remainder(a: f32, b: f32) f32 { ret a % b; }\n");
}

test "mach.lang.driver:spirv_float_remainder_f64_has_structured_control_flow" {
    ret ut_spirv_float_remainder("pub fun remainder(a: f64, b: f64) f64 { ret a % b; }\n");
}


fun ut_float_zero_program() str {
    ret "val CT_N_D64: u64 = (-6.0f64 % 3.0f64):~u64;\nval CT_N_ND64: u64 = (-6.0f64 % -3.0f64):~u64;\nval CT_P_D64: u64 = (6.0f64 % 3.0f64):~u64;\nval CT_P_ND64: u64 = (6.0f64 % -3.0f64):~u64;\nval CT_NZ_D64: u64 = (-0.0f64 % 3.0f64):~u64;\nval CT_NZ_ND64: u64 = (-0.0f64 % -3.0f64):~u64;\nval CT_Z_D64: u64 = (0.0f64 % 3.0f64):~u64;\nval CT_Z_ND64: u64 = (0.0f64 % -3.0f64):~u64;\nval CT_N_D32: u32 = (-6.0f32 % 3.0f32):~u32;\nval CT_N_ND32: u32 = (-6.0f32 % -3.0f32):~u32;\nval CT_P_D32: u32 = (6.0f32 % 3.0f32):~u32;\nval CT_P_ND32: u32 = (6.0f32 % -3.0f32):~u32;\nval CT_NZ_D32: u32 = (-0.0f32 % 3.0f32):~u32;\nval CT_NZ_ND32: u32 = (-0.0f32 % -3.0f32):~u32;\nval CT_Z_D32: u32 = (0.0f32 % 3.0f32):~u32;\nval CT_Z_ND32: u32 = (0.0f32 % -3.0f32):~u32;\npub var N64: f64 = -6.0f64;\npub var P64: f64 = 6.0f64;\npub var Z64: f64 = 0.0f64;\npub var NZ64: f64 = -0.0f64;\npub var D64: f64 = 3.0f64;\npub var ND64: f64 = -3.0f64;\npub var N32: f32 = -6.0f32;\npub var P32: f32 = 6.0f32;\npub var Z32: f32 = 0.0f32;\npub var NZ32: f32 = -0.0f32;\npub var D32: f32 = 3.0f32;\npub var ND32: f32 = -3.0f32;\nfun check64(a: f64, b: f64, bits: u64) i32 {\n    if ((a % b):~u64 != bits) { ret 1; }\n    ret 0;\n}\nfun check32(a: f32, b: f32, bits: u32) i32 {\n    if ((a % b):~u32 != bits) { ret 1; }\n    ret 0;\n}\n#[symbol(\"probe\")]\nfun probe() i32 {\n    if (CT_N_D64 != 0x8000000000000000) { ret 1; }\n    if (check64(N64, D64, CT_N_D64) != 0) { ret 2; }\n    if (CT_N_ND64 != 0x8000000000000000) { ret 3; }\n    if (check64(N64, ND64, CT_N_ND64) != 0) { ret 4; }\n    if (CT_P_D64 != 0) { ret 5; }\n    if (check64(P64, D64, CT_P_D64) != 0) { ret 6; }\n    if (CT_P_ND64 != 0) { ret 7; }\n    if (check64(P64, ND64, CT_P_ND64) != 0) { ret 8; }\n    if (CT_NZ_D64 != 0x8000000000000000) { ret 9; }\n    if (check64(NZ64, D64, CT_NZ_D64) != 0) { ret 10; }\n    if (CT_NZ_ND64 != 0x8000000000000000) { ret 11; }\n    if (check64(NZ64, ND64, CT_NZ_ND64) != 0) { ret 12; }\n    if (CT_Z_D64 != 0) { ret 13; }\n    if (check64(Z64, D64, CT_Z_D64) != 0) { ret 14; }\n    if (CT_Z_ND64 != 0) { ret 15; }\n    if (check64(Z64, ND64, CT_Z_ND64) != 0) { ret 16; }\n    if (CT_N_D32 != 0x80000000) { ret 17; }\n    if (check32(N32, D32, CT_N_D32) != 0) { ret 18; }\n    if (CT_N_ND32 != 0x80000000) { ret 19; }\n    if (check32(N32, ND32, CT_N_ND32) != 0) { ret 20; }\n    if (CT_P_D32 != 0) { ret 21; }\n    if (check32(P32, D32, CT_P_D32) != 0) { ret 22; }\n    if (CT_P_ND32 != 0) { ret 23; }\n    if (check32(P32, ND32, CT_P_ND32) != 0) { ret 24; }\n    if (CT_NZ_D32 != 0x80000000) { ret 25; }\n    if (check32(NZ32, D32, CT_NZ_D32) != 0) { ret 26; }\n    if (CT_NZ_ND32 != 0x80000000) { ret 27; }\n    if (check32(NZ32, ND32, CT_NZ_ND32) != 0) { ret 28; }\n    if (CT_Z_D32 != 0) { ret 29; }\n    if (check32(Z32, D32, CT_Z_D32) != 0) { ret 30; }\n    if (CT_Z_ND32 != 0) { ret 31; }\n    if (check32(Z32, ND32, CT_Z_ND32) != 0) { ret 32; }\n    ret 0;\n}\n$if ($mach.build.os == $mach.os.windows) {\n    #[symbol(\"mainCRTStartup\")]\n    fun start() i32 { ret probe(); }\n}\n$or {\n    #[symbol(\"_start\")]\n    pub fun start() {\n        $if ($mach.build.arch == $mach.arch.x86_64) {\n            asm x86_64 {\n                and rsp, -16\n                call probe\n                mov edi, eax\n                mov rax, 60\n                syscall\n            }\n        }\n        $or ($mach.build.arch == $mach.arch.aarch64) {\n            asm aarch64 {\n                bl probe\n                mov x8, 93\n                svc 0\n            }\n        }\n        $or {\n            asm riscv64 {\n                call probe\n                li a7, 93\n                ecall\n            }\n        }\n    }\n}\n";
}

fun ut_float_zero_manifest() str {
    ret "[project]\nid=\"remainder\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out/{target.name}/{profile.name}\"\n[target.linux]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[target.windows]\nisa=\"x86_64\"\nos=\"windows\"\nabi=\"win64\"\n[target.linux-arm64]\nisa=\"aarch64\"\nos=\"linux\"\nabi=\"aapcs64\"\n[target.linux-riscv64]\nisa=\"riscv64\"\nos=\"linux\"\nabi=\"lp64d\"\n[profile.debug]\nopt=0\ndebug=false\nsimd=\"scalarize\"\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\n[artifact.probe]\nkind=\"bin\"\nentry=\"main.mach\"\nout=\"bin/probe.exe\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n";
}

fun ut_float_zero_profile(alloc: *A.Allocator, root: str, profile_name: str) i32 {
    val sr: R.Result[session.Session, str] = session.init(alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    fin { session.dnit(?s); }
    if (R.is_err[R.Void, str](driver.setup_registry(?s.registry))) { ret 2; }
    val mr: R.Result[manifest.Manifest, str] = driver.load_manifest(?s, root);
    if (R.is_err[manifest.Manifest, str](mr)) { ret 3; }
    var m: manifest.Manifest = R.unwrap_ok[manifest.Manifest, str](mr);
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    rq.target = "native";
    rq.profile = profile_name;
    val pr: R.Result[bplan.BuildPlan, outcome.Fail] = bplan.plan(alloc, ?s.interner, ?s.registry, ?m, rq);
    if (R.is_err[bplan.BuildPlan, outcome.Fail](pr)) { ret 4; }
    var bp: bplan.BuildPlan = R.unwrap_ok[bplan.BuildPlan, outcome.Fail](pr);
    val br: R.Result[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, alloc, nil);
    if (R.is_err[outcome.BuildOutcome, outcome.Fail](br)) { ret 5; }
    val bo: outcome.BuildOutcome = R.unwrap_ok[outcome.BuildOutcome, outcome.Fail](br);
    if (bo.severity != outcome.BUILD_OK || bo.artifacts.len != 1) { ret 6; }
    var trapped: bool = false;
    var code: i32 = 0;
    if (!ut_run_with_argc(alloc, "", bo.artifacts.data[0].path, 1, ?trapped, ?code)) { ret 7; }
    if (trapped || code != 0) {
        print.printf("float remainder {} child exit {}\n", profile_name, code);
        ret 8;
    }
    ret 0;
}

test "mach.lang.driver: floating remainder preserves signed zero in emitted native programs" {
    $if ($mach.build.os != $mach.os.linux && $mach.build.os != $mach.os.windows) { ret 0; }
    var backing: A.Allocator;
    var ar: arena.Arena;
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?backing))) { ret 1; }
    if (O.is_some[str](arena.init(?ar, ?backing, 0))) { ret 2; }
    fin { arena.dnit(?ar); }
    if (O.is_some[str](arena.make(?alloc, ?ar))) { ret 3; }
    var names: [1]str; names[0] = "main.mach";
    var texts: [1]str; texts[0] = ut_float_zero_program();
    val root_r: R.Result[str, str] = ut_scaffold_m(?alloc, ut_float_zero_manifest(), ?names[0], ?texts[0], 1);
    if (R.is_err[str, str](root_r)) { ret 4; }
    val root: str = R.unwrap_ok[str, str](root_r);
    fin { fs.remove_all(?alloc, root); }
    val debug: i32 = ut_float_zero_profile(?alloc, root, "debug");
    if (debug != 0) { print.printf("float remainder debug build/run exit {}\n", debug); ret 5; }
    val release: i32 = ut_float_zero_profile(?alloc, root, "release");
    if (release != 0) { print.printf("float remainder release build/run exit {}\n", release); ret 6; }
    ret 0;
}
