test "mach.lang.driver:union_tuple_gate_bindings_are_isolated" {
    var names: [5]str;
    names[0] = "main.mach";
    names[1] = "linux_flag.mach";
    names[2] = "windows_flag.mach";
    names[3] = "yes.mach";
    names[4] = "no.mach";
    var texts: [5]str;
    texts[0] = "$if ($mach.build.os == $mach.os.linux) { use chosen: uniontest.linux_flag; } $or { use chosen: uniontest.windows_flag; }\n$if (chosen.ENABLED) { use uniontest.yes; } $or { use uniontest.no; }\nfun main() i32 { ret 0; }\n";
    texts[1] = "pub def Flag: u8;\npub val ENABLED: Flag = 1;\n";
    texts[2] = "pub def Flag: u8;\npub val ENABLED: Flag = 0;\n";
    texts[3] = "pub fun yes() i32 { ret 1; }\n";
    texts[4] = "pub fun no() i32 { ret 0; }\n";
    if (ut_union_gate_result_n(?names[0], ?texts[0], 5, "", "") != 0) { ret 1; }

    names[0] = "main.mach";
    names[1] = "linux_flag.mach";
    names[2] = "yes.mach";
    texts[0] = "$if ($mach.build.os == $mach.os.linux) { use chosen: uniontest.linux_flag; $if (chosen.ENABLED) { use uniontest.yes; } }\nfun main() i32 { ret 0; }\n";
    texts[1] = "pub val ENABLED: u8 = 1;\n";
    texts[2] = "pub fun yes() i32 { ret 1; }\n";
    if (ut_union_gate_result_n(?names[0], ?texts[0], 3, "", "unresolved identifier") != 0) { ret 2; }
    ret 0;
}

test "mach.lang.driver:union_tuple_reach_propagates_transitively" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:     session.Session = sr.ok;
    var names: [3]str;
    names[0] = "main.mach";
    names[1] = "a.mach";
    names[2] = "b.mach";
    var texts: [3]str;
    texts[0] = "$if ($mach.build.os == NATIVE_OS) { use uniontest.a; }\nfun main() i32 { ret 0; }\n";
    texts[1] = "use uniontest.b;\npub fun a() i32 { ret 1; }\n";
    texts[2] = "$if ($mach.build.os != NATIVE_OS) { def Word: u16; val BAD: Word = 1; $if (BAD) { use uniontest.missing; } }\npub fun b() i32 { ret 2; }\n";
    val text0_r: res[str, fail.Fail] = ut_union_native_text(?alloc, texts[0]);
    if (sel text0_r.err) {
        session.dnit(?s);
        ret 1;
    }
    texts[0] = text0_r.ok;
    fin { str_free(?alloc, texts[0]); }
    val text2_r: res[str, fail.Fail] = ut_union_native_text(?alloc, texts[2]);
    if (sel text2_r.err) {
        session.dnit(?s);
        ret 1;
    }
    texts[2] = text2_r.ok;
    fin { str_free(?alloc, texts[2]); }
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 3);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;
    fin { str_free(?alloc, root); }
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    val pr: res[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
    fs.remove_all(?alloc, root);
    if (sel pr.err) {
        session.dnit(?s);
        ret 2;
    }
    var p:   project.Project = pr.ok;
    var bad: i32             = 0;
    if (ut_count_errors(?s.diags) != 0) { bad = 3; }
    val bmid: session.ModuleId = ut_mid(?p, ?s, "uniontest.b");
    if (bmid == session.MODULE_NIL) { bad = 4; }
    or {
        val bm: *project.ModuleEntry = ?p.modules[bmid::u32];
        if (bm.tuple_reachable == nil || bm.tuple_reach_count != p.union_tuple_count) { bad = 5; }
        or {
            var ti: u32 = 0;
            for (ti < p.union_tuple_count) {
                val should_reach: bool = p.union_tuples[ti].os_id == ut_union_native_os_id();
                if (bm.tuple_reachable[ti] != should_reach) { bad = 6; }
                ti = ti + 1;
            }
        }
    }
    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.driver:same_alias_distinct_failures_per_tuple_both_visible" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:     session.Session = sr.ok;
    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "$if ($mach.build.os == $mach.os.linux) { def Flag: u8x4; val C: Flag = u8x4{1, 2, 3, 4}; } $or { def Flag: u16; val C: Flag = 1; }\n$if (C) { } $or { use uniontest.missing; }\nfun main() i32 { ret 0; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 2;
    }
    val root:             str               = root_r.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 3;
    }
    val pr: res[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
    fs.remove_all(?alloc, root);
    if (sel pr.err) {
        session.dnit(?s);
        ret 4;
    }
    var p:   project.Project = pr.ok;
    var bad: i32             = 0;
    if (!ut_diag_has(?p.s.diags, "a vector is not a truth value")) { bad = 5; }
    if (!ut_diag_has(?p.s.diags, "condition must have type u8"))   { bad = 6; }
    if (diagnostic.len(?p.s.diags) != 2)                           { bad = 7; }
    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.driver:gate_diagnostic_dedups_across_decl_and_body_inference" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:     session.Session = sr.ok;
    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "def Flag: u8x4;\nval C: Flag = u8x4{1, 2, 3, 4};\n$if (C) { }\nfun main() i32 { ret 0; }\n";
    val pr: res[project.Project, outcome.Fail] = ut_single_sema_n(?s, ?alloc, ?names[0], ?texts[0], 1);
    if (sel pr.ok) {
        var p: project.Project = pr.ok;
        project.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }
    if (!outcome.is_reported(pr.err)) {
        session.dnit(?s);
        ret 1;
    }
    var bad: i32 = 0;
    if (!ut_diag_has(?s.diags, "a vector is not a truth value")) { bad = 2; }
