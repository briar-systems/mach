fun ut_mos_unavailable(s: *session.Session, alloc: *A.Allocator, src: str) i32 {
    val pr: R.Result[project.Project, outcome.Fail] = ut_ct_edge_project(s, alloc, src, "mos");
    if (R.is_ok[project.Project, outcome.Fail](pr)) {
        var built: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);
        project.dnit_project(?built);
        ret 1;
    }
    val f: outcome.Fail = R.unwrap_err[project.Project, outcome.Fail](pr);
    if (f.kind != outcome.FAIL_USER) { ret 1; }
    if (!ut_str_contains(f.message, "mos6502")) { ret 1; }
    if (!ut_str_contains(f.message, "unavailable")) { ret 1; }
    ret 0;
}

test "mach.lang.driver:mos6502_target_unavailable_for_every_known_source_shape" {
    var bad: i32 = 0;
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    if (ut_mos_unavailable(?s, ?alloc, "#[oblivious]\nfun f(v: ^u8, n: ^u8) ^u8 { ret v << n; }\nfun main() i32 { ret 0; }\n") != 0) { bad = 1; }
    if (ut_mos_unavailable(?s, ?alloc, "#[oblivious]\nfun f(v: ^u8, n: u8) ^u8 { ret v << n; }\nfun main() i32 { ret 0; }\n") != 0) { bad = 1; }
    if (ut_mos_unavailable(?s, ?alloc, "#[oblivious]\nfun f(v: ^u8) ^u8 { ret v << 3; }\nfun main() i32 { ret 0; }\n") != 0) { bad = 1; }
    if (ut_mos_unavailable(?s, ?alloc, "#[oblivious]\nfun f(v: ^u8) ^u8 { ret v << (1 + 2); }\nfun main() i32 { ret 0; }\n") != 0) { bad = 1; }
    if (ut_mos_unavailable(?s, ?alloc, "#[oblivious]\nfun f(v: ^u8, s: ^u8) ^u8 { ret v << (s + 1); }\nfun main() i32 { ret 0; }\n") != 0) { bad = 1; }
    if (ut_mos_unavailable(?s, ?alloc, "fun main() i32 { val x: f32 = 1.0; ret 0; }\n") != 0) { bad = 1; }
    if (ut_mos_unavailable(?s, ?alloc, "rec Point { x: f32; y: f32; }\nfun main() i32 { var p: Point; ret p.x::i32; }\n") != 0) { bad = 1; }
    if (ut_mos_unavailable(?s, ?alloc, "fun main() i32 { var a: [4]f64; ret a[0]::i32; }\n") != 0) { bad = 1; }
    if (ut_mos_unavailable(?s, ?alloc, "rec Box[T] { v: T; }\nfun main() i32 { var b: Box[f32]; ret b.v::i32; }\n") != 0) { bad = 1; }
    if (ut_mos_unavailable(?s, ?alloc, "fun f(v: u16) u16 { ret v; }\nfun main() i32 { ret 0; }\n") != 0) { bad = 1; }
    if (ut_mos_unavailable(?s, ?alloc, "fun f(v: u32) u32 { ret v; }\nfun main() i32 { ret 0; }\n") != 0) { bad = 1; }
    if (ut_mos_unavailable(?s, ?alloc, "fun f(v: u64) u64 { ret v; }\nfun main() i32 { ret 0; }\n") != 0) { bad = 1; }
    if (ut_mos_unavailable(?s, ?alloc, "fun g(v: u8) u8 { ret v; }\nfun f(v: u8) u8 { ret g(v); }\nfun main() i32 { ret 0; }\n") != 0) { bad = 1; }
    if (ut_mos_unavailable(?s, ?alloc, "fun main() i32 { ret 0; }\n") != 0) { bad = 1; }

    session.dnit(?s);
    ret bad;
}

