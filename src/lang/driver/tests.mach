    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    var texts: [1]str;
    names[0] = "main.mach";
    texts[0] = "rec P { c: [8]f32x4; }\n\n#[storage(0, 3, \"readonly\")] var ro: P;\n\n#[input(0)] var in_x: f32x4;\n#[builtin(\"position\")] var position: f32x4;\n\n#[noinline]\nfun bump(p: *f32x4, v: f32x4) { @p = v; }\n\n#[stage(\"vertex\")]\nfun vert_main() {\n    bump(?ro.c[1], in_x);\n    position = ro.c[2];\n}\n";
    var dn: [1]str;
    var dt: [1]str;
    val pr: res[project.Project, outcome.Fail] = ut_spv_lower(?s, ?alloc, ?names[0], ?texts[0], 1, "", ?dn[0], ?dt[0], 0);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    var bad:   i32 = 0;
    var img:   of.ObjectImage;
    var fault: str = nil;
    if (ut_spv_codegen(?p, ?s, "spvcase.main", ?img, ?fault)) {
        bad = 1;
        obj.dnit(?img);
    }
    or {
        if (fault == nil)                                                                            { bad = 1; }
        or (!ut_str_contains(fault, "a store reaches the `#[storage(0, 3, \"readonly\")]` binding")) { bad = 1; }
    }

    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

fun ut_spv_bool_type(w: *u32, n: u32) u32 {
    var i: u32 = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0)                              { ret 0; }
        if ((w[i] & 0xFFFF) == spirv.OP_TYPE_BOOL) { ret w[i + 1]; }
        i = i + len;
    }
    ret 0;
}

fun ut_spv_is_bool_value(w: *u32, n: u32, bool_ty: u32, id: u32) bool {
    if (bool_ty == 0 || id == 0) { ret false; }
    var i: u32 = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0)                                          { ret false; }
        if (len >= 3 && w[i + 1] == bool_ty && w[i + 2] == id) { ret true; }
        i = i + len;
    }
    ret false;
}

fun ut_spv_bool_call_args(w: *u32, n: u32, bool_ty: u32) u32 {
    var i: u32 = 0;
    var c: u32 = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0) { ret c; }
        if ((w[i] & 0xFFFF) == spirv.OP_FUNCTION_CALL) {
            var k: u32 = 4;
            for (k < len) {
                if (ut_spv_is_bool_value(w, n, bool_ty, w[i + k])) { c = c + 1; }
                k = k + 1;
            }
        }
        i = i + len;
    }
    ret c;
}

fun ut_spv_bool_returns(w: *u32, n: u32, bool_ty: u32) u32 {
    var i:      u32 = 0;
    var c:      u32 = 0;
    var fn_ret: u32 = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0) { ret c; }
        val op: u32 = w[i] & 0xFFFF;
        if (op == spirv.OP_FUNCTION) { fn_ret = w[i + 1]; }
        if (op == spirv.OP_RETURN_VALUE && fn_ret != bool_ty
            && ut_spv_is_bool_value(w, n, bool_ty, w[i + 1])) { c = c + 1; }
        i = i + len;
    }
    ret c;
}

fun ut_spv_bool_conditions(w: *u32, n: u32, bool_ty: u32) u32 {
    var i: u32 = 0;
    var c: u32 = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0) { ret c; }
        if ((w[i] & 0xFFFF) == spirv.OP_BRANCH_CONDITIONAL
            && ut_spv_is_bool_value(w, n, bool_ty, w[i + 1])) { c = c + 1; }
        i = i + len;
    }
    ret c;
}

fun ut_spv_cmp_boundary_src() str {
    ret "fun mix(h: u64, b: u8) u64 { ret h * 31 + b::u64; }\n\npub fun crosses(seed: u32) u64 {\n    val x: u32 = 7 + seed;\n    ret mix(1, x == x);\n}\n\npub fun returns_cmp(seed: u32) u8 {\n    val x: u32 = 7 + seed;\n    ret x == x;\n}\n\npub fun branches(seed: u32) u64 {\n    val x: u32 = 7 + seed;\n    if (x == x) { ret 1; }\n    ret 0;\n}\n";
}

test "mach.lang.driver:spirv_converts_a_comparison_at_a_call_boundary" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    var texts: [1]str;
    names[0] = "main.mach";
    texts[0] = ut_spv_cmp_boundary_src();
    var dn: [1]str;
    var dt: [1]str;
    val pr: res[project.Project, outcome.Fail] = ut_spv_lower(?s, ?alloc, ?names[0], ?texts[0], 1, "", ?dn[0], ?dt[0], 0);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    var bad:   i32 = 0;
    var img:   of.ObjectImage;
    var fault: str = nil;
    if (!ut_spv_codegen(?p, ?s, "spvcase.main", ?img, ?fault)) {
        project.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }
    var n: u32  = 0;
    val w: *u32 = ut_spv_words(?img, ?n);
    if (w == nil) {
        obj.dnit(?img);
        project.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }

    val bt: u32 = ut_spv_bool_type(w, n);
    if (bt == 0)                                   { bad = 1; }
    if (ut_spv_count(w, n, spirv.OP_I_EQUAL) != 3) { bad = 1; }
    or {
        if (ut_spv_bool_call_args(w, n, bt) != 0)     { bad = 1; }
        if (ut_spv_bool_returns(w, n, bt) != 0)       { bad = 1; }
        if (ut_spv_bool_conditions(w, n, bt) != 1)    { bad = 1; }
        if (ut_spv_count(w, n, spirv.OP_SELECT) != 2) { bad = 1; }
    }

    obj.dnit(?img);
    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

fun ut_manifest_riscv_pair() str {
    ret "[project]\nid = \"uniontest\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.rv32]\nisa = \"rv32imafdc\"\nos = \"freestanding\"\nabi = \"ilp32d\"\nof = \"elf\"\n\n[target.rv64]\nisa = \"riscv64\"\nos = \"freestanding\"\nabi = \"lp64d\"\nof = \"elf\"\n\n[artifact.uniontest]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/uniontest\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n";
}

fun ut_debug_abs_width(image: *of.ObjectImage, itn: *intern.Interner, section: str) u32 {
    var sec: i32 = -1;
    var s:   u32 = 0;
    for (s < image.section_count) {
        val lo: opt[str] = intern.lookup(itn, image.sections[s].name);
        if (sel lo.some && str_equals(lo.some, section)) { sec = s::i32; }
        s = s + 1;
    }
    if (sec < 0) { ret 0; }

    var widest: u32 = 0;
    var r:      u32 = 0;
    for (r < image.reloc_count) {
        if (of.section_index(image.relocations[r].section) == sec::u32) {
            if (image.relocations[r].kind == of.RK_ABS64)                { widest = 8; }
            or (image.relocations[r].kind == of.RK_ABS32 && widest == 0) { widest = 4; }
        }
        r = r + 1;
    }
    ret widest;
}

fun ut_dwarf_addr_reloc_width(target_name: str, section: str) u32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 0; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 0; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "fun helper(x: i32) i32 { ret x + 1; }\n#[symbol(\"_start\")]\npub fun start() { val a: i32 = helper(41); }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold_m(?alloc, ut_manifest_riscv_pair(), ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 0;
    }
    val root: str               = root_r.ok;
    val rr:   err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 0;
    }
    var tsel_16211: manifest.Selection                 = ut_target_sel(target_name);
    val pr:         res[project.Project, outcome.Fail] = driver.build_project(?s, root, ?tsel_16211);
    fs.remove_all(?alloc, root);
    if (sel pr.err) {
        session.dnit(?s);
        ret 0;
    }
    var p: project.Project = pr.ok;

    var width:            u32               = 0;
    val run_sema_pass_r:  err[outcome.Fail] = driver.run_sema_pass(?p);
    val run_lower_pass_r: err[outcome.Fail] = driver.run_lower_pass(?p);
    if (sel run_sema_pass_r.ok
        && sel run_lower_pass_r.ok) {
        val mid: session.ModuleId = ut_mid(?p, ?s, "uniontest.main");
        if (mid != session.MODULE_NIL) {
            val me: *project.ModuleEntry = ?p.modules[mid::u32];
            if (me.ir_module != nil) {
                var dbg: codegen.DebugInfo;
                dbg.emit = true;
                val pd: res[intern.StrId, A.Error] = intern.intern(?s.interner, "mach test");
                val cd: res[intern.StrId, A.Error] = intern.intern(?s.interner, root);
                if (sel pd.ok) {
                    if (sel cd.ok) {
                        dbg.producer = pd.ok;
                        dbg.comp_dir = cd.ok;
                        val prep: err[fail.Fail] = codegen.prepare_debug(?s);
                        var cg:   res[of.ObjectImage, fail.Fail];
                        if (sel prep.ok) {
                            cg = codegen.codegen_unit(?s, ?p.target, me.ir_module, unit.ir_set_empty(), nil, codegen.PLACEMENT_POLICY_VERSION, dbg);
                        }
                        if (sel prep.err) { cg = res[of.ObjectImage, fail.Fail].err{prep.err}; }
                        if (sel cg.ok) {
                            var image: of.ObjectImage = cg.ok;
                            width = ut_debug_abs_width(?image, ?s.interner, section);
                            obj.dnit(?image);
                        }
                    }
                }
            }
        }
    }

    project.dnit_project(?p);
    session.dnit(?s);
    ret width;
}

test "mach.lang.be.codegen.dwarf.produce:address_reloc_matches_pointer_width" {
    var bad: bool = false;

    if (ut_dwarf_addr_reloc_width("rv64", ".debug_line") != 8) { bad = true; }
    if (ut_dwarf_addr_reloc_width("rv64", ".debug_info") != 8) { bad = true; }
    if (ut_dwarf_addr_reloc_width("rv32", ".debug_line") != 4) { bad = true; }
    if (ut_dwarf_addr_reloc_width("rv32", ".debug_info") != 4) { bad = true; }

    if (bad) { ret 1; }
    ret 0;
}

fun ut_manifest_x64_linux() str {
    ret "[project]\nid = \"uniontest\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.lx64]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[artifact.uniontest]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/uniontest\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n";
}

fun ut_dwarf_nested_inline_debug_build() bool {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret false; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret false; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "fun leaf(x: i32) i32 { ret x + 1; }\nfun a1(x: i32) i32 { ret leaf(x) + leaf(x+1); }\nfun a2(x: i32) i32 { ret leaf(x) + leaf(x+1); }\nfun a3(x: i32) i32 { ret leaf(x) + leaf(x+1); }\nfun a4(x: i32) i32 { ret leaf(x) + leaf(x+1); }\nfun mid(x: i32) i32 { ret a1(x) + a2(x) + a3(x) + a4(x); }\nfun outer(x: i32) i32 { ret mid(x) + mid(x+1) + mid(x+2); }\nfun top(x: i32) i32 { ret outer(x) + outer(x+1) + outer(x+2) + outer(x+3); }\n#[symbol(\"_start\")]\npub fun start() { val a: i32 = top(41) + top(1) + top(2); if (a == 0) { ret; } }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold_m(?alloc, ut_manifest_x64_linux(), ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret false;
    }
    val root: str               = root_r.ok;
    val rr:   err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret false;
    }
    var tsel_16282: manifest.Selection                 = ut_target_sel("lx64");
    val pr:         res[project.Project, outcome.Fail] = driver.build_project(?s, root, ?tsel_16282);
    fs.remove_all(?alloc, root);
    if (sel pr.err) {
        session.dnit(?s);
        ret false;
    }
    var p: project.Project = pr.ok;

    var ok:               bool              = false;
    val run_sema_pass_r:  err[outcome.Fail] = driver.run_sema_pass(?p);
    val run_lower_pass_r: err[outcome.Fail] = driver.run_lower_pass(?p);
    if (sel run_sema_pass_r.ok
        && sel run_lower_pass_r.ok) {
        val mid: session.ModuleId = ut_mid(?p, ?s, "uniontest.main");
        if (mid != session.MODULE_NIL) {
            val me: *project.ModuleEntry = ?p.modules[mid::u32];
            if (me.ir_module != nil) {
                var preq: pipeline.PipelineRequest;
                preq.module            = me.ir_module;
                preq.target            = ?p.target;
                preq.level             = pipeline.OPT_RELEASE;
                preq.vectorize_enabled = pipeline.VectorizeEnabledOption{v: false};
                preq.simd_require      = pipeline.SimdRequireOption{v: false};
                preq.float_reassoc     = pipeline.FloatReassocOption{v: false};
                preq.interner          = ?s.interner;
                preq.source_map        = ?s.sources;
                val rp: res[bool, fail.Fail] = pipeline.run(?preq);
                if (sel rp.ok) {
                    var tot_sites: u32 = 0;
                    var fi:        u32 = 0;
                    for (fi < me.ir_module.function_len) {
                        tot_sites = tot_sites + (?me.ir_module.functions[fi]).inline_site_len;
                        fi        = fi + 1;
                    }
                    if (tot_sites > 1) {
                        var dbg: codegen.DebugInfo;
                        dbg.emit = true;
                        val pd: res[intern.StrId, A.Error] = intern.intern(?s.interner, "mach test");
                        val cd: res[intern.StrId, A.Error] = intern.intern(?s.interner, root);
                        if (sel pd.ok) {
                            if (sel cd.ok) {
                                dbg.producer = pd.ok;
                                dbg.comp_dir = cd.ok;
                                val prep: err[fail.Fail] = codegen.prepare_debug(?s);
                                var cg:   res[of.ObjectImage, fail.Fail];
                                if (sel prep.ok) {
                                    cg = codegen.codegen_unit(?s, ?p.target, me.ir_module, unit.ir_set_empty(), nil, codegen.PLACEMENT_POLICY_VERSION, dbg);
                                }
                                if (sel prep.err) { cg = res[of.ObjectImage, fail.Fail].err{prep.err}; }
                                if (sel cg.ok) {
                                    var image: of.ObjectImage = cg.ok;
                                    ok = image.section_count > 0;
                                    obj.dnit(?image);
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    project.dnit_project(?p);
    session.dnit(?s);
    ret ok;
}

test "mach.lang.be.codegen.dwarf.produce:nested_inline_debug_build_survives_real_inlining" {
    if (!ut_dwarf_nested_inline_debug_build()) { ret 1; }
    ret 0;
}

fun ut_fn_symbol_size(image: *of.ObjectImage, itn: *intern.Interner, want: str) u32 {
    var i: u32 = 0;
    for (i < image.symbol_count) {
        val sym: *of.Symbol = ?image.symbols[i];
        if ((sym.flags & of.SYM_OBJ_FLAG_FUNCTION) == 0) {
            i = i + 1;
            cnt;
        }
        val lo: opt[str] = intern.lookup(itn, sym.name);
        if (sel lo.some && str_contains(lo.some, want)) { ret sym.size; }
        i = i + 1;
    }
    ret 0;
}

test "mach.lang.be.codegen.pack_symbols:emitted_function_symbol_carries_its_real_length" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "fun small_a(x: i32) i32 { ret x + 1; }\nfun small_b(x: i32) i32 { ret x + 2; }\n#[symbol(\"_start\")]\npub fun start() { val a: i32 = small_a(1) + small_b(2); if (a == 0) { ret; } }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold_m(?alloc, ut_manifest_x64_linux(), ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str               = root_r.ok;
    val rr:   err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var tsel_16374: manifest.Selection                 = ut_target_sel("lx64");
    val pr:         res[project.Project, outcome.Fail] = driver.build_project(?s, root, ?tsel_16374);
    fs.remove_all(?alloc, root);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    var bad:              i32               = 1;
    val run_sema_pass_r:  err[outcome.Fail] = driver.run_sema_pass(?p);
    val run_lower_pass_r: err[outcome.Fail] = driver.run_lower_pass(?p);
    if (sel run_sema_pass_r.ok
        && sel run_lower_pass_r.ok) {
        val mid: session.ModuleId = ut_mid(?p, ?s, "uniontest.main");
        if (mid != session.MODULE_NIL) {
            val me: *project.ModuleEntry = ?p.modules[mid::u32];
            if (me.ir_module != nil) {
                var dbg: codegen.DebugInfo;
                dbg.emit = false;
                val cg: res[of.ObjectImage, fail.Fail] = codegen.codegen_unit(?s, ?p.target, me.ir_module, unit.ir_set_empty(), nil, codegen.PLACEMENT_POLICY_VERSION, dbg);
                if (sel cg.ok) {
                    var image: of.ObjectImage = cg.ok;
                    val sa:    u32            = ut_fn_symbol_size(?image, ?s.interner, "small_a");
                    val sb:    u32            = ut_fn_symbol_size(?image, ?s.interner, "small_b");
                    if (sa > 0 && sa < 64 && sb > 0 && sb < 64) { bad = 0; }
                    obj.dnit(?image);
                }
            }
        }
    }

    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

fun ut_fs_elf_manifest() str {
    ret "[project]\nid = \"fself\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.fsx]\nisa = \"x86_64\"\nos = \"freestanding\"\nabi = \"sysv64\"\nof = \"elf\"\n\n[target.fsa]\nisa = \"aarch64\"\nos = \"freestanding\"\nabi = \"aapcs64\"\nof = \"elf\"\n\n[target.fsr]\nisa = \"riscv64\"\nos = \"freestanding\"\nabi = \"lp64d\"\nof = \"elf\"\n\n[target.fsr32]\nisa = \"rv32imafdc\"\nos = \"freestanding\"\nabi = \"ilp32d\"\nof = \"elf\"\n\n[target.lx]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[profile.debug]\nopt = 0\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n\n[artifact.fself]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/fself\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
}

fun ut_fs_elf_src() str {
    ret "val table: [4]u32 = [4]u32{11, 22, 33, 44};\nvar counter: u32 = 0;\nvar scratch: [16]u32;\n#[symbol(\"_start\")]\npub fun start() {\n    var i: u32 = 0;\n    for (i < 4) {\n        counter = counter + table[i];\n        scratch[i] = counter;\n        i = i + 1;\n    }\n}\n";
}

rec UtLoadSeg {
    off:    u64;
    vaddr:  u64;
    filesz: u64;
}

fun ut_le16(b: *u8, off: usize) u64 {
    ret b[off]::u64 | (b[off + 1]::u64 << 8);
}

fun ut_le32(b: *u8, off: usize) u64 {
    ret b[off]::u64 | (b[off + 1]::u64 << 8) | (b[off + 2]::u64 << 16) | (b[off + 3]::u64 << 24);
}

fun ut_le64(b: *u8, off: usize) u64 {
    ret ut_le32(b, off) | (ut_le32(b, off + 4) << 32);
}

fun ut_elf_loads(img: *Vector[u8], segs: *UtLoadSeg, cap: u32, entry_out: *u64) u32 {
    if (img.len < 64) { ret 0; }
    val b:     *u8  = img.data;
    val elf32: bool = b[4] == 1;

    var phoff:     u64 = 0;
    var phentsize: u64 = 0;
    var phnum:     u64 = 0;
    if (elf32) {
        @entry_out = ut_le32(b, 24);
        phoff      = ut_le32(b, 28);
        phentsize  = ut_le16(b, 42);
        phnum      = ut_le16(b, 44);
    }
    or {
        @entry_out = ut_le64(b, 24);
        phoff      = ut_le64(b, 32);
        phentsize  = ut_le16(b, 54);
        phnum      = ut_le16(b, 56);
    }

    var n: u32 = 0;
    var i: u64 = 0;
    for (i < phnum && n < cap) {
        val p: usize = (phoff + i * phentsize)::usize;
        if (p + phentsize::usize > img.len) { ret n; }
        if (ut_le32(b, p) == 1) {
            if (elf32) {
                segs[n].off    = ut_le32(b, p + 4);
                segs[n].vaddr  = ut_le32(b, p + 8);
                segs[n].filesz = ut_le32(b, p + 16);
            }
            or {
                segs[n].off    = ut_le64(b, p + 8);
                segs[n].vaddr  = ut_le64(b, p + 16);
                segs[n].filesz = ut_le64(b, p + 32);
            }
            n = n + 1;
        }
        i = i + 1;
    }
    ret n;
}

fun ut_link_exe_image(p: *project.Project, root: str, out: *Vector[u8]) bool {
    val alloc: *A.Allocator = p.alloc;
    if (p.emit_len == 0) { ret false; }

    val ir: res[*of.ObjectImage, A.Error] = A.allocate[of.ObjectImage](alloc, p.emit_len::usize);
    if (sel ir.err) { ret false; }
    val images:  *of.ObjectImage = ir.ok;
    var missing: bool            = false;
    var i:       u32             = 0;
    for (i < p.emit_len) {
        val m: *project.ModuleEntry = ?p.modules[(p.topo[i])::u32];
        if (m.object_image == nil) { missing = true; }
        or                         { images[i] = @m.object_image; }
        i = i + 1;
    }

    var linked: bool = false;
    val path:   str  = ut_cc3(alloc, root, "/", "image.elf");
    if (!missing) {
        val lr: err[fail.Fail] = ut_planned_link_images(p.s, ?p.target, images, p.emit_len,
            nil::*of.DynLib, 0, path::*u8, "fself"::*u8, linker.LINK_EXE, false,
            of.image_options_default(of.SUBSYSTEM_CONSOLE));
        linked = sel lr.ok;
    }
    A.deallocate[of.ObjectImage](alloc, images, p.emit_len::usize);
    if (!linked) { ret false; }

    val br: res[Vector[u8], fs.FsError] = fs.read_bytes(alloc, path);
    if (sel br.err) { ret false; }
    @out = br.ok;
    ret true;
}

fun ut_fs_elf_image(alloc: *A.Allocator, target_name: str, out: *Vector[u8]) bool {
    val sr: res[session.Session, fail.Fail] = session.init(alloc);
    if (sel sr.err) { ret false; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = ut_fs_elf_src();
    val root_r: res[str, fail.Fail] = ut_scaffold_m(alloc, ut_fs_elf_manifest(), ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret false;
    }
    val root: str = root_r.ok;

    var ok: bool              = false;
    val rr: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.ok) {
        var tsel_16525: manifest.Selection                 = ut_target_sel(target_name);
        val pr:         res[project.Project, outcome.Fail] = driver.build_project(?s, root, ?tsel_16525);
        if (sel pr.ok) {
            var p: project.Project = pr.ok;
            if (ut_run_codegen_ok(?p) == 0) { ok = ut_link_exe_image(?p, root, out); }
            project.dnit_project(?p);
        }
    }
    fs.remove_all(alloc, root);
    session.dnit(?s);
    ret ok;
}

val UT_FS_VADDR_CEIL: u64 = 0x100000;

fun ut_fs_elf_unmapped_header(alloc: *A.Allocator, target_name: str) bool {
    var img: Vector[u8];
    if (!ut_fs_elf_image(alloc, target_name, ?img)) { ret false; }

    var segs:  [16]UtLoadSeg;
    var entry: u64 = 0;
    val n:     u32 = ut_elf_loads(?img, ?segs[0], 16, ?entry);

    var ok:           bool = n > 0;
    var covers_entry: bool = false;
    var i:            u32  = 0;
    for (i < n) {
        if (segs[i].off == 0)                                                 { ok = false; }
        if (segs[i].vaddr >= UT_FS_VADDR_CEIL)                                { ok = false; }
        if (segs[i].off + segs[i].filesz > img.len::u64)                      { ok = false; }
        if (entry >= segs[i].vaddr && entry < segs[i].vaddr + segs[i].filesz) { covers_entry = true; }
        i = i + 1;
    }
    if (!covers_entry) { ok = false; }

    vector.dnit[u8](?img);
    ret ok;
}

fun ut_linux_elf_maps_header(alloc: *A.Allocator) bool {
    var img: Vector[u8];
    if (!ut_fs_elf_image(alloc, "lx", ?img)) { ret false; }

    var segs:  [16]UtLoadSeg;
    var entry: u64 = 0;
    val n:     u32 = ut_elf_loads(?img, ?segs[0], 16, ?entry);

    var headers: u32  = 0;
    var content: u32  = 0;
    var ok:      bool = n > 1;
    var i:       u32  = 0;
    for (i < n) {
        if (segs[i].off == 0) {
            headers = headers + 1;
            if (segs[i].vaddr != oslinux.LINUX_BASE_ADDR - oslinux.LINUX_PAGE_SIZE) { ok = false; }
        }
        or {
            content = content + 1;
            if (segs[i].vaddr < oslinux.LINUX_BASE_ADDR) { ok = false; }
        }
        i = i + 1;
    }
    if (headers != 1 || content == 0) { ok = false; }

    vector.dnit[u8](?img);
    ret ok;
}

test "mach.lang.driver:freestanding_elf_links_with_no_header_segment" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }

    var bad: bool = false;
    if (!ut_fs_elf_unmapped_header(?alloc, "fsx"))   { bad = true; }
    if (!ut_fs_elf_unmapped_header(?alloc, "fsa"))   { bad = true; }
    if (!ut_fs_elf_unmapped_header(?alloc, "fsr"))   { bad = true; }
    if (!ut_fs_elf_unmapped_header(?alloc, "fsr32")) { bad = true; }
    if (!ut_linux_elf_maps_header(?alloc))           { bad = true; }

    if (bad) { ret 1; }
    ret 0;
}

fun ut_spv_array_init_src() str {
    ret "#[output(0)] var o_lit: u32;\n#[output(1)] var o_elem: u32;\n\n#[stage(\"vertex\")]\nfun vs() {\n    val lit: [4]u32 = [4]u32{7, 6, 5, 4};\n    var elem: [4]u32;\n    elem[0] = 7; elem[1] = 6; elem[2] = 5; elem[3] = 4;\n    o_lit  = lit[0]  + lit[1]  * 10 + lit[2]  * 100 + lit[3]  * 1000;\n    o_elem = elem[0] + elem[1] * 10 + elem[2] * 100 + elem[3] * 1000;\n}\n\nfun main() i32 { ret 0; }\n";
}

