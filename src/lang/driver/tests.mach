test "mach.lang.driver:test_reachable_error_still_fatal" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    var names: [2]str;
    names[0] = "main.mach"; names[1] = "bad.mach";
    var texts: [2]str;
    texts[0] = "use uniontest.bad;\n\nfun main() i32 { ret 0; }\n";
    texts[1] = "$error(\"reachable boom\");\n\npub fun f() i32 { ret 0; }\n";

    val pr: R.Result[project.Project, outcome.Fail] = ut_build_test(?s, ?alloc, ?names[0], ?texts[0], 2);
    if (R.is_err[project.Project, outcome.Fail](pr)) { session.dnit(?s); ret 1; }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);

    var bad: i32 = 0;
    if (ut_gated(?p, ?s, "uniontest.bad"))    { bad = 1; }
    if (!ut_in_topo(?p, ?s, "uniontest.bad")) { bad = 1; }
    if (union.count_target_gated(?p) != 0)          { bad = 1; }
    val se: R.Result[R.Void, outcome.Fail] = passes.run_sema_pass(?p);
    if (R.is_err[R.Void, outcome.Fail](se))              { bad = 1; }
    if (ut_count_errors(?p.s.diags) == 0)     { bad = 1; }

    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

fun ut_has(p: *project.Project, s: *session.Session, fqn: str) bool {
    val idr: R.Result[intern.StrId, str] = intern.intern(?s.interner, fqn);
    if (R.is_err[intern.StrId, str](idr)) { ret false; }
    var id: intern.StrId = R.unwrap_ok[intern.StrId, str](idr);
    ret R.is_ok[*session.ModuleId, str](map.get[intern.StrId, session.ModuleId](?p.by_fqn, ?id));
}

fun ut_ast(p: *project.Project, s: *session.Session, fqn: str) *ast.Ast {
    val idr: R.Result[intern.StrId, str] = intern.intern(?s.interner, fqn);
    if (R.is_err[intern.StrId, str](idr)) { ret nil; }
    var id: intern.StrId = R.unwrap_ok[intern.StrId, str](idr);
    val mr: R.Result[*session.ModuleId, str] = map.get[intern.StrId, session.ModuleId](?p.by_fqn, ?id);
    if (R.is_err[*session.ModuleId, str](mr)) { ret nil; }
    val mid: session.ModuleId = @R.unwrap_ok[*session.ModuleId, str](mr);
    ret p.modules[mid::u32].a;
}

fun ut_mid(p: *project.Project, s: *session.Session, fqn: str) session.ModuleId {
    val idr: R.Result[intern.StrId, str] = intern.intern(?s.interner, fqn);
    if (R.is_err[intern.StrId, str](idr)) { ret session.MODULE_NIL; }
    var id: intern.StrId = R.unwrap_ok[intern.StrId, str](idr);
    val mr: R.Result[*session.ModuleId, str] = map.get[intern.StrId, session.ModuleId](?p.by_fqn, ?id);
    if (R.is_err[*session.ModuleId, str](mr)) { ret session.MODULE_NIL; }
    ret @R.unwrap_ok[*session.ModuleId, str](mr);
}

fun ut_stable(p: *project.Project, s: *session.Session, fqn: str) session.StableModuleId {
    val mid: session.ModuleId = ut_mid(p, s, fqn);
    if (mid == session.MODULE_NIL) { ret session.STABLE_MODULE_NIL; }
    ret p.modules[mid::u32].stable_id;
}

fun ut_ctx(p: *project.Project, s: *session.Session, fqn: str) *comptime.ComptimeCtx {
    val idr: R.Result[intern.StrId, str] = intern.intern(?s.interner, fqn);
    if (R.is_err[intern.StrId, str](idr)) { ret nil; }
    var id: intern.StrId = R.unwrap_ok[intern.StrId, str](idr);
    val mr: R.Result[*session.ModuleId, str] = map.get[intern.StrId, session.ModuleId](?p.by_fqn, ?id);
    if (R.is_err[*session.ModuleId, str](mr)) { ret nil; }
    val mid: session.ModuleId = @R.unwrap_ok[*session.ModuleId, str](mr);
    val m: *project.ModuleEntry = ?p.modules[mid::u32];
    ret ?m.ctx;
}

fun ut_id_is(s: *session.Session, id: intern.StrId, text: str) bool {
    val found: O.Option[str] = intern.lookup(?s.interner, id);
    ret O.is_some[str](found) && str_equals(O.unwrap[str](found), text);
}

test "mach.lang.driver:analyze_project_retains_selected_frontend" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    var names: [4]str;
    names[0] = "alpha.mach"; names[1] = "beta.mach";
    names[2] = "model.mach"; names[3] = "orphan.mach";
    var texts: [4]str;
    texts[0] = "fun main() i32 { ret no_such(); }\n";
    texts[1] = "use ctxcase.model;\nfun main() i32 { var b: model.Box[model.Leaf]; ret model.take[model.Leaf](b); }\n";
    texts[2] = "pub rec Leaf { n: i32; }\npub rec Box[T] { v: T; }\npub fun take[T](b: Box[T]) i32 { ret 7; }\n";
    texts[3] = "fun broken() NoSuch { var x: AlsoMissing; ret x; }\n";
    val root_r: R.Result[str, str] = ut_scaffold_m(
        ?alloc, ut_manifest_frontend(), ?names[0], ?texts[0], 4);
    if (R.is_err[str, str](root_r)) { session.dnit(?s); ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);

    val mr: R.Result[manifest.Manifest, str] = driver.load_manifest(?s, root);
    if (R.is_err[manifest.Manifest, str](mr)) {
        fs.remove_all(?alloc, root); session.dnit(?s); ret 1;
    }
    var mf: manifest.Manifest = R.unwrap_ok[manifest.Manifest, str](mr);
    var req: request.BuildRequest = request.defaults();
    req.project_root = root;
    req.target       = "windows";
    req.profile      = "release";
    req.artifact     = "beta";
    req.want_lib     = false;
    req.goal         = request.GOAL_OBJECTS;
    req.opt          = pipeline.OPT_RELEASE;
    req.pie          = true;

    val pr: R.Result[project.Project, outcome.Fail] =
        driver.analyze_project(?s, ?mf, ?req, nil, 0);
    if (R.is_err[project.Project, outcome.Fail](pr)) {
        manifest.dnit(?mf, ?alloc); fs.remove_all(?alloc, root);
        session.dnit(?s); ret 1;
    }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);
    manifest.dnit(?mf, ?alloc);

    var bad: i32 = 0;
    if (p.queries.db != ?s.queries || p.queries.diags != ?s.diags) { bad = 2; }
    if (ut_count_errors(?s.diags) != 0) { bad = 3; }
    if (ut_has(?p, ?s, "ctxcase.alpha"))  { bad = 4; }
    if (ut_has(?p, ?s, "ctxcase.orphan")) { bad = 5; }

    val beta:  session.ModuleId = ut_mid(?p, ?s, "ctxcase.beta");
    val model: session.ModuleId = ut_mid(?p, ?s, "ctxcase.model");
    if (beta == session.MODULE_NIL || model == session.MODULE_NIL) { bad = 6; }
    or {
        val bm: *project.ModuleEntry = ?p.modules[beta::u32];
        val mm: *project.ModuleEntry = ?p.modules[model::u32];
        if (!bm.resolved || bm.resolve_result == nil || bm.sema_result == nil) { bad = 7; }
        if (!mm.resolved || mm.resolve_result == nil || mm.sema_result == nil) { bad = 8; }
        if (bm.ir_module != nil || bm.object_image != nil) { bad = 9; }
        if (mm.ir_module != nil || mm.object_image != nil) { bad = 10; }

        val c: *comptime.ComptimeCtx = ?bm.ctx;
        if (c.env.build_mode_id != comptime.MODE_RELEASE || c.env.build_pie != 1) { bad = 11; }
        if (c.env.pointer_width != 8) { bad = 12; }
        if (!ut_id_is(?s, c.env.project_id, "ctxcase")) { bad = 13; }
        if (!ut_id_is(?s, c.env.project_ver, "1.2.3")) { bad = 14; }
        if (!ut_id_is(?s, c.env.target_os, "windows")) { bad = 15; }
        if (!ut_id_is(?s, c.env.target_isa, "x86_64")) { bad = 16; }
        if (!ut_id_is(?s, c.env.target_abi, "win64")) { bad = 17; }
        if (!ut_id_is(?s, c.env.bin_name, "beta")) { bad = 18; }
    }

    project.dnit_project(?p);
    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.driver:analyze_project_loads_overlay_extra_root_through_pub_const_gate" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    var names: [4]str;
    names[0] = "main.mach"; names[1] = "extra.mach";
    names[2] = "flags.mach"; names[3] = "model.mach";
    var texts: [4]str;
    texts[0] = "fun main() i32 { ret 0; }\n";
    texts[1] = "fun broken() NoSuch { var x: AlsoMissing; ret x; }\n";
    texts[2] = "pub val ENABLE: i32 = 1;\n";
    texts[3] = "pub rec Leaf { n: i32; }\npub rec Box[T] { v: T; }\npub fun take[T](b: Box[T]) i32 { ret 7; }\n";
    val root_r: R.Result[str, str] = ut_scaffold(?alloc, ?names[0], ?texts[0], 4);
    if (R.is_err[str, str](root_r)) { session.dnit(?s); ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);

    val mr: R.Result[manifest.Manifest, str] = driver.load_manifest(?s, root);
    if (R.is_err[manifest.Manifest, str](mr)) {
        fs.remove_all(?alloc, root); session.dnit(?s); ret 1;
    }
    var mf: manifest.Manifest = R.unwrap_ok[manifest.Manifest, str](mr);
    var req: request.BuildRequest = request.defaults();
    req.project_root = root;
    req.target       = "linux";
    req.artifact     = "uniontest";
    req.goal         = request.GOAL_OBJECTS;

    val base_r: R.Result[project.Project, outcome.Fail] =
        driver.analyze_project(?s, ?mf, ?req, nil, 0);
    if (R.is_err[project.Project, outcome.Fail](base_r)) {
        manifest.dnit(?mf, ?alloc); fs.remove_all(?alloc, root);
        session.dnit(?s); ret 1;
    }
    var base: project.Project = R.unwrap_ok[project.Project, outcome.Fail](base_r);
    var bad: i32 = 0;
    if (ut_has(?base, ?s, "uniontest.extra")) { bad = 1; }
    if (ut_has(?base, ?s, "uniontest.flags")) { bad = 1; }
    if (ut_has(?base, ?s, "uniontest.model")) { bad = 1; }
    project.dnit_project(?base);

    val extra_path: str = ut_cc3(?alloc, root, "/", "src/extra.mach");
    val overlay: str = "use uniontest.flags.ENABLE;\n$if (ENABLE == 1) { use uniontest.model; }\npub fun probe() i32 { ret 7; }\n";
    if (R.is_err[R.Void, str](session.set_overlay(?s, extra_path, overlay))) {
        manifest.dnit(?mf, ?alloc); fs.remove_all(?alloc, root);
        session.dnit(?s); ret 1;
    }
    val xid_r: R.Result[intern.StrId, str] = intern.intern(?s.interner, "uniontest.extra");
    if (R.is_err[intern.StrId, str](xid_r)) {
        manifest.dnit(?mf, ?alloc); fs.remove_all(?alloc, root);
        session.dnit(?s); ret 1;
    }
    var extra_roots: [1]intern.StrId;
    extra_roots[0] = R.unwrap_ok[intern.StrId, str](xid_r);

    val rooted_r: R.Result[project.Project, outcome.Fail] =
        driver.analyze_project(?s, ?mf, ?req, ?extra_roots[0], 1);
    if (R.is_err[project.Project, outcome.Fail](rooted_r)) {
        manifest.dnit(?mf, ?alloc); fs.remove_all(?alloc, root);
        session.dnit(?s); ret 1;
    }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](rooted_r);
    if (ut_count_errors(?s.diags) != 0) { bad = 2; }
    if (!ut_has(?p, ?s, "uniontest.extra")) { bad = 3; }
    if (!ut_has(?p, ?s, "uniontest.flags")) { bad = 4; }
    if (!ut_has(?p, ?s, "uniontest.model")) { bad = 5; }
    if (p.emit_len != 1 || p.topo_len <= p.emit_len) { bad = 6; }

    val extra_mid: session.ModuleId = ut_mid(?p, ?s, "uniontest.extra");
    val model_mid: session.ModuleId = ut_mid(?p, ?s, "uniontest.model");
    if (extra_mid == session.MODULE_NIL || model_mid == session.MODULE_NIL) { bad = 7; }
    or {
        val em: *project.ModuleEntry = ?p.modules[extra_mid::u32];
        val mm: *project.ModuleEntry = ?p.modules[model_mid::u32];
        if (!em.resolved || em.resolve_result == nil || em.sema_result == nil) { bad = 8; }
        if (!mm.resolved || mm.resolve_result == nil || mm.sema_result == nil) { bad = 9; }
        val eid_r: R.Result[intern.StrId, str] = intern.intern(?s.interner, "ENABLE");
        if (R.is_err[intern.StrId, str](eid_r)) { bad = 10; }
        or {
            val enabled: O.Option[comptime.NamedConst] = comptime.lookup(
                ?em.ctx, R.unwrap_ok[intern.StrId, str](eid_r));
            if (O.is_none[comptime.NamedConst](enabled)) { bad = 11; }
            or {
                val nc: comptime.NamedConst = O.unwrap[comptime.NamedConst](enabled);
                if (nc.value.kind != comptime.CT_KIND_INT || nc.value.data.i != 1) { bad = 12; }
            }
        }
    }

    project.dnit_project(?p);
    manifest.dnit(?mf, ?alloc);
    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.driver:analyze_project_resets_and_replays_cached_diagnostics" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    var names: [1]str; names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "fun dup() i32 { ret 1; }\nfun dup() i32 { ret 2; }\nfun main() i32 { ret 0; }\n";
    val root_r: R.Result[str, str] = ut_scaffold(?alloc, ?names[0], ?texts[0], 1);
    if (R.is_err[str, str](root_r)) { session.dnit(?s); ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);
    val mr: R.Result[manifest.Manifest, str] = driver.load_manifest(?s, root);
    if (R.is_err[manifest.Manifest, str](mr)) {
        fs.remove_all(?alloc, root); session.dnit(?s); ret 1;
    }
    var mf: manifest.Manifest = R.unwrap_ok[manifest.Manifest, str](mr);
    var req: request.BuildRequest = request.defaults();
    req.project_root = root;
    req.target       = "linux";
    req.artifact     = "uniontest";
    req.goal         = request.GOAL_OBJECTS;

    val cold_r: R.Result[project.Project, outcome.Fail] =
        driver.analyze_project(?s, ?mf, ?req, nil, 0);
    if (R.is_err[project.Project, outcome.Fail](cold_r)) {
        manifest.dnit(?mf, ?alloc); fs.remove_all(?alloc, root);
        session.dnit(?s); ret 1;
    }
    var cold_p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](cold_r);
    val mid: session.ModuleId = ut_mid(?cold_p, ?s, "uniontest.main");
    if (mid == session.MODULE_NIL || diagnostic.len(?s.diags) == 0) {
        project.dnit_project(?cold_p); manifest.dnit(?mf, ?alloc);
        fs.remove_all(?alloc, root); session.dnit(?s); ret 1;
    }
    val stable: session.StableModuleId = cold_p.modules[mid::u32].stable_id;
    val resolve_rev: query.Revision = query.peek_revision(?s.queries, query.Q_RESOLVE, stable::u64);
    val sema_rev: query.Revision = query.peek_revision(?s.queries, query.Q_SEMA, stable::u64);
    if (resolve_rev == 0 || sema_rev == 0) {
        project.dnit_project(?cold_p); manifest.dnit(?mf, ?alloc);
        fs.remove_all(?alloc, root); session.dnit(?s); ret 1;
    }
    val snapshot_r: R.Result[*diagnostic.DiagnosticStore, str] =
        diagnostic.snapshot_from(?s.diags, 0, ?alloc);
    if (R.is_err[*diagnostic.DiagnosticStore, str](snapshot_r)) {
        project.dnit_project(?cold_p); manifest.dnit(?mf, ?alloc);
        fs.remove_all(?alloc, root); session.dnit(?s); ret 1;
    }
    val snapshot: *diagnostic.DiagnosticStore = R.unwrap_ok[*diagnostic.DiagnosticStore, str](snapshot_r);
    project.dnit_project(?cold_p);

    val warm_r: R.Result[project.Project, outcome.Fail] =
        driver.analyze_project(?s, ?mf, ?req, nil, 0);
    if (R.is_err[project.Project, outcome.Fail](warm_r)) {
        diagnostic.store_dnit(snapshot); A.deallocate[diagnostic.DiagnosticStore](?alloc, snapshot, 1::usize);
        manifest.dnit(?mf, ?alloc); fs.remove_all(?alloc, root);
        session.dnit(?s); ret 1;
    }
    var warm_p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](warm_r);
    var bad: i32 = 0;
    if (!ut_diag_list_eq(?s.diags, snapshot)) { bad = 1; }
    if (query.peek_revision(?s.queries, query.Q_RESOLVE, stable::u64) != resolve_rev) { bad = 1; }
    if (query.peek_revision(?s.queries, query.Q_SEMA, stable::u64) != sema_rev) { bad = 1; }

    project.dnit_project(?warm_p);
    diagnostic.store_dnit(snapshot);
    A.deallocate[diagnostic.DiagnosticStore](?alloc, snapshot, 1::usize);
    manifest.dnit(?mf, ?alloc);
    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.driver:analyze_project_rejects_missing_extra_root_array" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    val invalid: R.Result[project.Project, outcome.Fail] =
        driver.analyze_project(?s, nil, nil, nil, 1);
    var bad: i32 = 0;
    if (R.is_ok[project.Project, outcome.Fail](invalid)) {
        var stray: project.Project = R.unwrap_ok[project.Project, outcome.Fail](invalid);
        project.dnit_project(?stray);
        bad = 1;
    }
    or {
        val failure: outcome.Fail = R.unwrap_err[project.Project, outcome.Fail](invalid);
        if (failure.kind != outcome.FAIL_INTERNAL
            || !str_equals(failure.message,
                "driver: frontend analysis root count requires a root array")) { bad = 1; }
    }
    if (session.module_count(?s) != 0) { bad = 1; }
    if (isa.registered_count(?s.registry.isa) != 0) { bad = 1; }

    session.dnit(?s);
    ret bad;
}

test "mach.lang.driver:analyze_project_failure_cleans_partial_state" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    var names: [1]str; names[0] = "other.mach";
    var texts: [1]str; texts[0] = "pub fun other() i32 { ret 1; }\n";
    val root_r: R.Result[str, str] = ut_scaffold(?alloc, ?names[0], ?texts[0], 1);
    if (R.is_err[str, str](root_r)) { session.dnit(?s); ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);
    val mr: R.Result[manifest.Manifest, str] = driver.load_manifest(?s, root);
    if (R.is_err[manifest.Manifest, str](mr)) {
        fs.remove_all(?alloc, root); session.dnit(?s); ret 1;
    }
    var mf: manifest.Manifest = R.unwrap_ok[manifest.Manifest, str](mr);
    var req: request.BuildRequest = request.defaults();
    req.project_root = root;
    req.target       = "linux";
    req.artifact     = "uniontest";
    req.goal         = request.GOAL_OBJECTS;

    var bad: i32 = 0;
    val failed: R.Result[project.Project, outcome.Fail] =
        driver.analyze_project(?s, ?mf, ?req, nil, 0);
    if (R.is_ok[project.Project, outcome.Fail](failed)) {
        var stray: project.Project = R.unwrap_ok[project.Project, outcome.Fail](failed);
        project.dnit_project(?stray);
        bad = 1;
    }
    if (session.module_count(?s) != 0) { bad = 1; }

    val main_path: str = ut_cc3(?alloc, root, "/", "src/main.mach");
    val repaired_text: str = "fun main() i32 { ret 0; }\n";
    val write_err: O.Option[str] = fs.write_bytes(
        main_path, repaired_text, str_len(repaired_text), 420);
    if (O.is_some[str](write_err)) { bad = 1; }
    or {
        val repaired: R.Result[project.Project, outcome.Fail] =
            driver.analyze_project(?s, ?mf, ?req, nil, 0);
        if (R.is_err[project.Project, outcome.Fail](repaired)) { bad = 1; }
        or {
            var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](repaired);
            val mid: session.ModuleId = ut_mid(?p, ?s, "uniontest.main");
            if (mid == session.MODULE_NIL) { bad = 1; }
            or {
                val me: *project.ModuleEntry = ?p.modules[mid::u32];
                if (!me.resolved || me.resolve_result == nil || me.sema_result == nil) { bad = 1; }
            }
            if (p.queries.db != ?s.queries || p.queries.diags != ?s.diags) { bad = 1; }
            project.dnit_project(?p);
        }
    }

    manifest.dnit(?mf, ?alloc);
    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

rec LoadSlotProbe {
    backing:    A.Allocator;
    live:       i64;
    live_count: i64;
    calls:      u32;
    fail_at:    u32;
}

fun load_slot_probe_allocate(ctx: ptr, size: usize, align: usize) O.Option[ptr] {
    val p: *LoadSlotProbe = ctx::*LoadSlotProbe;
    p.calls = p.calls + 1;
    if (p.fail_at != 0 && p.calls == p.fail_at) { ret O.none[ptr](); }
    val r: O.Option[ptr] = p.backing.fn_allocate(p.backing.ctx, size, align);
    if (O.is_some[ptr](r)) {
        p.live = p.live + size::i64;
        p.live_count = p.live_count + 1;
        memory.raw_fill(O.unwrap[ptr](r), 0xAA, size);
    }
    ret r;
}

fun load_slot_probe_reallocate(ctx: ptr, item: ptr, old_size: usize, new_size: usize, align: usize) O.Option[ptr] {
    val p: *LoadSlotProbe = ctx::*LoadSlotProbe;
    p.calls = p.calls + 1;
    if (p.fail_at != 0 && p.calls == p.fail_at) { ret O.none[ptr](); }
    val r: O.Option[ptr] = p.backing.fn_reallocate(p.backing.ctx, item, old_size, new_size, align);
    if (O.is_some[ptr](r)) {
        p.live = p.live - old_size::i64 + new_size::i64;
        if (new_size > old_size) {
            val grown: ptr = O.unwrap[ptr](r);
            memory.raw_fill((grown::usize + old_size)::ptr, 0xAA, new_size - old_size);
        }
    }
    ret r;
}

fun load_slot_probe_deallocate(ctx: ptr, item: ptr, size: usize, align: usize) i64 {
    val p: *LoadSlotProbe = ctx::*LoadSlotProbe;
    p.live = p.live - size::i64;
    p.live_count = p.live_count - 1;
    ret p.backing.fn_deallocate(p.backing.ctx, item, size, align);
}

fun load_slot_probe_make(p: *LoadSlotProbe, alloc: *A.Allocator, backing: *A.Allocator, fail_at: u32) {
    p.backing    = @backing;
    p.live       = 0;
    p.live_count = 0;
    p.calls      = 0;
    p.fail_at    = fail_at;
    val probe: *LoadSlotProbe = p;
    alloc.ctx          = probe::ptr;
    alloc.fn_allocate   = load_slot_probe_allocate;
    alloc.fn_reallocate = load_slot_probe_reallocate;
    alloc.fn_deallocate = load_slot_probe_deallocate;
}

test "mach.lang.driver:load_module_registration_fail_at_n_no_leak" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }

    var base_names: [1]str; base_names[0] = "main.mach";
    var base_texts: [1]str; base_texts[0] = "fun main() i32 { ret 0; }\n";
    val root_r: R.Result[str, str] = ut_scaffold(?alloc, ?base_names[0], ?base_texts[0], 1);
    if (R.is_err[str, str](root_r)) { ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);

    val preload: u32 = 15;
    var pi: u32 = 0;
    var setup_bad: i32 = 0;
    for (pi < preload + 1 && setup_bad == 0) {
        val name_r: R.Result[str, str] = format.sprint(?alloc, "c{}.mach", pi);
        if (R.is_err[str, str](name_r)) { setup_bad = 1; brk; }
        val name: str = R.unwrap_ok[str, str](name_r);
        val name_cap: usize = str_len(name) + 1;
        val text: str = "pub fun leaf() i32 { ret 0; }\n";
        val fp: str = ut_cc3(?alloc, root, "/src/", name);
        val we: O.Option[str] = fs.write_bytes(fp, text, str_len(text), 420);
        A.deallocate[u8](?alloc, name::*u8, name_cap);
        if (O.is_some[str](we)) { setup_bad = 1; brk; }
        pi = pi + 1;
    }
    if (setup_bad != 0) { fs.remove_all(?alloc, root); ret 1; }

    var bad: i32 = 0;
    var saw_success: bool = false;
    var fail_at: u32 = 1;
    val max_fail_at: u32 = 2;
    for (fail_at <= max_fail_at && bad == 0) {
        val sr: R.Result[session.Session, str] = session.init(?alloc);
        if (R.is_err[session.Session, str](sr)) { bad = 1; brk; }
        var s: session.Session = R.unwrap_ok[session.Session, str](sr);
        val rr: R.Result[R.Void, str] = driver.setup_registry(?s.registry);
        if (R.is_err[R.Void, str](rr)) { session.dnit(?s); bad = 1; brk; }

        val pr: R.Result[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
        if (R.is_err[project.Project, outcome.Fail](pr)) { session.dnit(?s); bad = 1; brk; }
        var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);
        if (p.module_len != 1) { project.dnit_project(?p); session.dnit(?s); bad = 1; brk; }

        var pj: u32 = 0;
        for (pj < preload && bad == 0) {
            val nm_r: R.Result[str, str] = format.sprint(?alloc, "uniontest.c{}", pj);
            if (R.is_err[str, str](nm_r)) { bad = 1; brk; }
            val nm: str = R.unwrap_ok[str, str](nm_r);
            val fqn_r: R.Result[intern.StrId, str] = intern.intern(?s.interner, nm);
            A.deallocate[u8](?alloc, nm::*u8, str_len(nm) + 1);
            if (R.is_err[intern.StrId, str](fqn_r)) { bad = 1; brk; }
            val lr: R.Result[session.ModuleId, str] = load.dfs_load(?p, R.unwrap_ok[intern.StrId, str](fqn_r));
            if (R.is_err[session.ModuleId, str](lr)) { bad = 1; brk; }
            pj = pj + 1;
        }
        if (bad != 0) { project.dnit_project(?p); session.dnit(?s); brk; }
        if (p.module_len != 1 + preload) { project.dnit_project(?p); session.dnit(?s); bad = 1; brk; }

        val fqn_r: R.Result[intern.StrId, str] = intern.intern(?s.interner, "uniontest.c15");
        if (R.is_err[intern.StrId, str](fqn_r)) { project.dnit_project(?p); session.dnit(?s); bad = 1; brk; }
        val fqn: intern.StrId = R.unwrap_ok[intern.StrId, str](fqn_r);
        val baseline: u32 = p.module_len;

        var probe: LoadSlotProbe;
        var probe_alloc: A.Allocator;
        load_slot_probe_make(?probe, ?probe_alloc, ?alloc, fail_at);
        p.alloc = ?probe_alloc;
        val cr: R.Result[session.ModuleId, str] = load.dfs_load(?p, fqn);
        p.alloc = ?alloc;

        if (R.is_ok[session.ModuleId, str](cr)) { bad = 2; }
        or {
            if (p.module_len != baseline)  { bad = 3; }
            if (ut_has(?p, ?s, "uniontest.c15")) { bad = 3; }
            if (probe.live_count != 0)     { bad = 4; }
        }

        project.dnit_project(?p);
        session.dnit(?s);
        fail_at = fail_at + 1;
    }

    if (bad == 0) {
        val sr: R.Result[session.Session, str] = session.init(?alloc);
        if (R.is_err[session.Session, str](sr)) { bad = 5; }
        or {
            var s: session.Session = R.unwrap_ok[session.Session, str](sr);
            val rr: R.Result[R.Void, str] = driver.setup_registry(?s.registry);
            if (R.is_err[R.Void, str](rr)) { session.dnit(?s); bad = 5; }
            or {
                val pr: R.Result[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
                if (R.is_err[project.Project, outcome.Fail](pr)) { session.dnit(?s); bad = 5; }
                or {
                    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);
                    var pj: u32 = 0;
                    for (pj < preload && bad == 0) {
                        val nm_r: R.Result[str, str] = format.sprint(?alloc, "uniontest.c{}", pj);
                        if (R.is_err[str, str](nm_r)) { bad = 5; brk; }
                        val nm: str = R.unwrap_ok[str, str](nm_r);
                        val fqn_r: R.Result[intern.StrId, str] = intern.intern(?s.interner, nm);
                        A.deallocate[u8](?alloc, nm::*u8, str_len(nm) + 1);
                        if (R.is_err[intern.StrId, str](fqn_r)) { bad = 5; brk; }
                        val lr: R.Result[session.ModuleId, str] = load.dfs_load(?p, R.unwrap_ok[intern.StrId, str](fqn_r));
                        if (R.is_err[session.ModuleId, str](lr)) { bad = 5; brk; }
                        pj = pj + 1;
                    }
                    if (bad == 0) {
                        val fqn_r: R.Result[intern.StrId, str] = intern.intern(?s.interner, "uniontest.c15");
                        if (R.is_err[intern.StrId, str](fqn_r)) { bad = 5; }
                        or {
                            val lr: R.Result[session.ModuleId, str] = load.dfs_load(?p, R.unwrap_ok[intern.StrId, str](fqn_r));
                            if (R.is_err[session.ModuleId, str](lr) || p.module_len != 2 + preload) { bad = 5; }
                        }
                    }
                    project.dnit_project(?p);
                }
            }
            session.dnit(?s);
        }
    }

    fs.remove_all(?alloc, root);
    ret bad;
}

fun ut_count_errors(d: *diagnostic.DiagnosticStore) u32 {
    var c: u32 = 0;
    var i: usize = 0;
    for (i < diagnostic.len(d)) {
        if (d.items.data[i].severity == diagnostic.SEVERITY_ERROR) { c = c + 1; }
        i = i + 1;
    }
    ret c;
}

fun ut_diag_has(d: *diagnostic.DiagnosticStore, needle: str) bool {
    var i: usize = 0;
    for (i < diagnostic.len(d)) {
        if (d.items.data[i].severity == diagnostic.SEVERITY_ERROR
            && ut_str_contains(d.items.data[i].message, needle)) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun ut_diag_count(d: *diagnostic.DiagnosticStore, needle: str) u32 {
    var hits: u32 = 0;
    var i: usize = 0;
    for (i < diagnostic.len(d)) {
        if (d.items.data[i].severity == diagnostic.SEVERITY_ERROR
            && ut_str_contains(d.items.data[i].message, needle)) { hits = hits + 1; }
        i = i + 1;
    }
    ret hits;
}

fun ut_diag_note_has(d: *diagnostic.DiagnosticStore, needle: str) bool {
    var i: usize = 0;
    for (i < diagnostic.len(d)) {
        val di: *diagnostic.Diagnostic = ?d.items.data[i];
        if (di.severity == diagnostic.SEVERITY_ERROR) {
            var c: usize = 0;
            for (c < di.children.len) {
                if (di.children.data[c].kind == diagnostic.CHILD_NOTE
                    && ut_str_contains(di.children.data[c].text, needle)) { ret true; }
                c = c + 1;
            }
        }
        i = i + 1;
    }
    ret false;
}

fun ut_vec_sema(s: *session.Session, alloc: *A.Allocator, src: str) R.Result[project.Project, outcome.Fail] {
    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = src;
    ret ut_vec_sema_n(s, alloc, ?names[0], ?texts[0], 1);
}

fun ut_vec_sema_n(s: *session.Session, alloc: *A.Allocator, names: *str, texts: *str, n: u32) R.Result[project.Project, outcome.Fail] {
    val pr: R.Result[project.Project, outcome.Fail] = ut_build(s, alloc, names, texts, n);
    if (R.is_err[project.Project, outcome.Fail](pr)) { ret pr; }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);
    val se: R.Result[R.Void, outcome.Fail] = passes.run_sema_pass(?p);
    if (R.is_err[R.Void, outcome.Fail](se)) { project.dnit_project(?p); ret R.err[project.Project, outcome.Fail](R.unwrap_err[R.Void, outcome.Fail](se)); }
    ret R.ok[project.Project, outcome.Fail](p);
}

fun ut_single_sema_n(s: *session.Session, alloc: *A.Allocator, names: *str, texts: *str, n: u32) R.Result[project.Project, outcome.Fail] {
    val root_r: R.Result[str, str] = ut_scaffold(alloc, names, texts, n);
    if (R.is_err[str, str](root_r)) { ret R.err[project.Project, outcome.Fail](outcome.user(R.unwrap_err[str, str](root_r))); }
    val root: str = R.unwrap_ok[str, str](root_r);
    val rr: R.Result[R.Void, str] = driver.setup_registry(?s.registry);
    if (R.is_err[R.Void, str](rr)) { fs.remove_all(alloc, root); ret R.err[project.Project, outcome.Fail](outcome.user(R.unwrap_err[R.Void, str](rr))); }
    var tsel_1294: manifest.Selection = ut_target_sel("linux");
    val pr: R.Result[project.Project, outcome.Fail] = driver.build_project(s, root, ?tsel_1294);
    fs.remove_all(alloc, root);
    if (R.is_err[project.Project, outcome.Fail](pr)) { ret pr; }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);
    val se: R.Result[R.Void, outcome.Fail] = passes.run_sema_pass(?p);
    if (R.is_err[R.Void, outcome.Fail](se)) { project.dnit_project(?p); ret R.err[project.Project, outcome.Fail](R.unwrap_err[R.Void, outcome.Fail](se)); }
    ret R.ok[project.Project, outcome.Fail](p);
}

fun ut_single_result_n(names: *str, texts: *str, n: u32, needle: str, want_diag: bool) i32 {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    val pr: R.Result[project.Project, outcome.Fail] = ut_single_sema_n(?s, ?alloc, names, texts, n);
    if (R.is_err[project.Project, outcome.Fail](pr)) { session.dnit(?s); ret 1; }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);
    var ok: bool = ut_count_errors(?p.s.diags) == 0;
    if (want_diag) { ok = ut_diag_has(?p.s.diags, needle); }
    project.dnit_project(?p);
    session.dnit(?s);
    if (ok) { ret 0; }
    ret 1;
}

fun ut_single_ok(src: str) i32 {
    var names: [1]str; names[0] = "main.mach";
    var texts: [1]str; texts[0] = src;
    ret ut_single_result_n(?names[0], ?texts[0], 1, "", false);
}

