    names[1] = "liba.mach";
    texts[1] = "rec CamA { x: f32; y: f32; z: f32; w: f32; }\n#[uniform(0, 0)] pub var cam_a: CamA;\n\n#[noinline]\npub fun from_a(v: f32) f32 { ret v * cam_a.x; }\n";
    names[2] = "libb.mach";
    texts[2] = "rec CamB { p: f32; q: f32; r: f32; s: f32; }\n#[uniform(0, 1)] pub var cam_b: CamB;\n\n#[noinline]\npub fun from_b(v: f32) f32 { ret v * cam_b.p; }\n";
    var dn: [1]str;
    var dt: [1]str;
    val pr: res[project.Project, outcome.Fail] = ut_spv_lower(?s, ?alloc, ?names[0], ?texts[0], 3, "", ?dn[0], ?dt[0], 0);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    var bad:   i32 = 0;
    var img:   of.ObjectImage;
    var fault: str = nil;
    if (!ut_spv_codegen(?p, ?s, "spvcase.main", ?img, ?fault)) {
        project.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }
    var n: u32  = 0;
    val w: *u32 = ut_spv_words(?img, ?n);
    if (w == nil) {
        obj.dnit(?img);
        project.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }

    val va: u32 = ut_spv_descriptor_var(w, n, 0, 0);
    val vb: u32 = ut_spv_descriptor_var(w, n, 0, 1);
    if (va == 0 || vb == 0 || va == vb)                            { bad = 1; }
    if (ut_spv_decor_count(w, n, spirv.DECOR_DESCRIPTOR_SET) != 2) { bad = 1; }

    obj.dnit(?img);
    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.driver.readout:a_phase_counts_what_it_processed" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [3]str;
    names[0] = "main.mach";
    names[1] = "keep.mach";
    names[2] = "gated.mach";
    var texts: [3]str;
    texts[0] = ut_cc3(?alloc, "#[symbol(\"", ut_entry_symbol(), "\")]\nfun start() i32 { ret 0; }\n");
    texts[1] = "pub fun keep() i32 { ret 1; }\n\ntest \"keep\" { ret 0; }\n";
    texts[2] = "$error(\"gated: not for this target\");\n\npub fun gated() i32 { ret 2; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 3);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    val mr: res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var m:  manifest.Manifest    = mr.ok;
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    rq.goal         = request.GOAL_TEST_LIST;
    val pr: res[bplan.BuildPlan, outcome.Fail] = bplan.plan(?alloc, ?s.interner, s.registry, ?m, rq);
    if (sel pr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var bp: bplan.BuildPlan = pr.ok;

    var ev: readout.Progress;
    readout.init(?ev, ?alloc, readout.LEVEL_PHASES);

    var bad: i32                                     = 0;
    val r:   res[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, ?alloc, ?ev);
    if (sel r.err) { bad = 2; }
    if (sel r.ok) {
        var listed: outcome.BuildOutcome = r.ok;
        if (listed.severity != outcome.BUILD_OK || listed.tests.len != 1) { bad = 3; }
        or {
            if (!str_empty(listed.tests.data[0].exe)) { bad = 4; }
        }
        outcome.outcome_dnit(?listed);
    }

    val ld: u32 = readout.PH_LOAD::u32;
    val rs: u32 = readout.PH_RESOLVE::u32;

    val lm: *readout.PhaseMetrics = ?ev.metrics[ld];
    val rm: *readout.PhaseMetrics = ?ev.metrics[rs];
    if (lm.occurrences == 0) { bad = 3; }
    if (rm.occurrences == 0) { bad = 4; }

    if (lm.dropped == 0) { bad = 5; }

    if (lm.processed != lm.item_count) { bad = 6; }

    if (lm.processed != rm.processed + lm.dropped) { bad = 7; }

    val sm:  *readout.PhaseMetrics = ?ev.metrics[readout.PH_SEMA::u32];
    val lwm: *readout.PhaseMetrics = ?ev.metrics[readout.PH_LOWER::u32];
    val om:  *readout.PhaseMetrics = ?ev.metrics[readout.PH_OPTIMIZE::u32];
    val cm:  *readout.PhaseMetrics = ?ev.metrics[readout.PH_CODEGEN::u32];
    val em:  *readout.PhaseMetrics = ?ev.metrics[readout.PH_EMIT::u32];
    if (sm.occurrences > 0 && sm.processed != sm.item_count)    { bad = 8; }
    if (lwm.occurrences > 0 && lwm.processed != lwm.item_count) { bad = 9; }
    if (om.occurrences > 0 && om.processed != om.item_count)    { bad = 10; }
    if (cm.occurrences != 0 || em.occurrences != 0
        || ev.metrics[readout.PH_LINK::u32].occurrences != 0) { bad = 11; }

    readout.dnit(?ev);
    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.driver.readout:a_deferred_gate_resolves_each_module_once" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [3]str;
    names[0] = "main.mach";
    names[1] = "helper.mach";
    names[2] = "extra.mach";
    var texts: [3]str;
    # the gate reads a constant from a module bound below it, so the first
    # resolve pass defers the gate and a second pass decides it
    texts[0] = ut_cc3(?alloc,
        "$if (helper.FLAG == 1) {\n    use uniontest.extra;\n}\n\nuse uniontest.helper;\n\n#[symbol(\"",
        ut_entry_symbol(), "\")]\nfun start() i32 { ret 0; }\n");
    texts[1] = "pub val FLAG: u8 = 1;\n\ntest \"flag\" { ret 0; }\n";
    texts[2] = "pub fun extra() i32 { ret 3; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 3);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    val mr: res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var m:  manifest.Manifest    = mr.ok;
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    rq.goal         = request.GOAL_OBJECTS;
    val pr: res[bplan.BuildPlan, outcome.Fail] = bplan.plan(?alloc, ?s.interner, s.registry, ?m, rq);
    if (sel pr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var bp: bplan.BuildPlan = pr.ok;

    var ev: readout.Progress;
    readout.init(?ev, ?alloc, readout.LEVEL_PHASES);

    var bad: i32                                     = 0;
    val r:   res[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, ?alloc, ?ev);
    if (sel r.err) { bad = 1; }
    if (sel r.ok) {
        var listed: outcome.BuildOutcome = r.ok;
        if (listed.severity != outcome.BUILD_OK) { bad = 1; }
        outcome.outcome_dnit(?listed);
    }

    val lm: *readout.PhaseMetrics = ?ev.metrics[readout.PH_LOAD::u32];
    val rm: *readout.PhaseMetrics = ?ev.metrics[readout.PH_RESOLVE::u32];

    # the gated arm brings its module in during the deferral loop, which is
    # what makes this fixture take a second resolve pass
    if (lm.processed != rm.processed) { bad = 1; }

    if (rm.occurrences != 1)           { bad = 1; }
    if (rm.processed != 3)             { bad = 1; }
    if (rm.item_count != rm.processed) { bad = 1; }

    readout.dnit(?ev);
    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.driver.readout:a_gate_deferred_module_is_counted_by_the_load_row" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [3]str;
    names[0] = "main.mach";
    names[1] = "helper.mach";
    names[2] = "extra.mach";
    var texts: [3]str;
    # extra enters the build only through a gate the first resolve pass
    # defers, so the loader brings it in from inside the deferral loop
    texts[0] = ut_cc3(?alloc,
        "$if (helper.FLAG == 1) {\n    use uniontest.extra;\n}\n\nuse uniontest.helper;\n\n#[symbol(\"",
        ut_entry_symbol(), "\")]\nfun start() i32 { ret 0; }\n");
    texts[1] = "pub val FLAG: u8 = 1;\n\ntest \"flag\" { ret 0; }\n";
    texts[2] = "pub fun extra() i32 { ret 3; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 3);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    val mr: res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var m:  manifest.Manifest    = mr.ok;
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    rq.goal         = request.GOAL_OBJECTS;
    val pr: res[bplan.BuildPlan, outcome.Fail] = bplan.plan(?alloc, ?s.interner, s.registry, ?m, rq);
    if (sel pr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var bp: bplan.BuildPlan = pr.ok;

    var ev: readout.Progress;
    readout.init(?ev, ?alloc, readout.LEVEL_ITEMS);

    var bad: i32                                     = 0;
    val r:   res[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, ?alloc, ?ev);
    if (sel r.err) { bad = 1; }
    if (sel r.ok) {
        var listed: outcome.BuildOutcome = r.ok;
        if (listed.severity != outcome.BUILD_OK) { bad = 1; }
        outcome.outcome_dnit(?listed);
    }

    val lm: *readout.PhaseMetrics = ?ev.metrics[readout.PH_LOAD::u32];
    val rm: *readout.PhaseMetrics = ?ev.metrics[readout.PH_RESOLVE::u32];

    # one load row counts every module the build loaded, including the one
    # behind the gate, so it agrees with the resolve row
    if (lm.occurrences != 1)           { bad = 2; }
    if (lm.processed != 3)             { bad = 3; }
    if (lm.item_count != lm.processed) { bad = 4; }
    if (lm.processed != rm.processed)  { bad = 5; }

    # the load row is rendered before the resolve row
    var load_at:    i64   = -1;
    var resolve_at: i64   = -1;
    var i:          usize = 0;
    for (i < ev.events.len) {
        val e: *readout.ProgressEvent = ?ev.events.data[i];
        if (e.kind == readout.PROGRESS_EVENT_PHASE) {
            if (e.data.phase.phase == readout.PH_LOAD && load_at < 0)       { load_at = i::i64; }
            if (e.data.phase.phase == readout.PH_RESOLVE && resolve_at < 0) { resolve_at = i::i64; }
        }
        i = i + 1;
    }
    if (load_at < 0 || resolve_at < 0 || load_at > resolve_at) { bad = 6; }

    readout.dnit(?ev);
    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

fun ut_spv_has_bare_decor(w: *u32, n: u32, id: u32, decor: u32) bool {
    var i: u32 = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0) { ret false; }
        if ((w[i] & 0xFFFF) == spirv.OP_DECORATE && len == 3
            && w[i + 1] == id && w[i + 2] == decor) { ret true; }
        i = i + len;
    }
    ret false;
}

fun ut_spv_nonwritable_src() str {
    ret "rec P { c: [8]f32x4; }\n\n#[storage(0, 3)] var ro: P;\n#[storage(0, 4)] var rw: P;\n#[storage(0, 5, \"readonly\")] var ro_marked: P;\n\n#[input(0)] var in_x: f32x4;\n#[builtin(\"position\")] var position: f32x4;\n\n#[stage(\"vertex\")]\nfun vert_main() {\n    rw.c[1] = in_x;\n    position = ro.c[2] + rw.c[3] + ro_marked.c[4];\n}\n";
}

test "mach.lang.driver:spirv_marks_an_unwritten_storage_binding_nonwritable" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    var texts: [1]str;
    names[0] = "main.mach";
    texts[0] = ut_spv_nonwritable_src();
    var dn: [1]str;
    var dt: [1]str;
    val pr: res[project.Project, outcome.Fail] = ut_spv_lower(?s, ?alloc, ?names[0], ?texts[0], 1, "", ?dn[0], ?dt[0], 0);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    var bad:   i32 = 0;
    var img:   of.ObjectImage;
    var fault: str = nil;
    if (!ut_spv_codegen(?p, ?s, "spvcase.main", ?img, ?fault)) {
        project.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }
    var n: u32  = 0;
    val w: *u32 = ut_spv_words(?img, ?n);
    if (w == nil) {
        obj.dnit(?img);
        project.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }

    val ro: u32 = ut_spv_descriptor_var(w, n, 0, 3);
    val rw: u32 = ut_spv_descriptor_var(w, n, 0, 4);
    val mk: u32 = ut_spv_descriptor_var(w, n, 0, 5);
    if (ro == 0 || rw == 0 || mk == 0) { bad = 1; }
    or {
        if (!ut_spv_has_bare_decor(w, n, ro, spirv.DECOR_NON_WRITABLE)) { bad = 1; }
        if (ut_spv_has_bare_decor(w, n, rw, spirv.DECOR_NON_WRITABLE))  { bad = 1; }
        if (!ut_spv_has_bare_decor(w, n, mk, spirv.DECOR_NON_WRITABLE)) { bad = 1; }
    }

    obj.dnit(?img);
    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.driver:storage_readonly_refuses_a_store" {
    val src: str = "rec P { c: [8]f32x4; }\n\n#[storage(0, 3, \"readonly\")] var ro: P;\n\nfun poke(v: f32x4) { ro.c[1] = v; }\n\nfun main() i32 { ret 0; }\n";
    if (!ut_sema_rejects_with(src, "cannot store through a `#[storage(set, binding, \"readonly\")]` binding")) { ret 1; }
    val ok: str = "rec P { c: [8]f32x4; }\n\n#[storage(0, 3)] var rw: P;\n\nfun poke(v: f32x4) { rw.c[1] = v; }\n\nfun main() i32 { ret 0; }\n";
    if (ut_sema_rejects_with(ok, "cannot store through")) { ret 1; }
    ret 0;
}

test "mach.lang.driver:storage_refuses_an_unknown_qualifier" {
    val src: str = "rec P { c: [8]f32x4; }\n\n#[storage(0, 3, \"readonlyy\")] var ro: P;\n\nfun main() i32 { ret 0; }\n";
    if (!ut_sema_rejects_with(src, "unknown `storage` memory qualifier")) { ret 1; }
    val un: str = "rec P { c: [8]f32x4; }\n\n#[uniform(0, 3, \"readonly\")] var u: P;\n\nfun main() i32 { ret 0; }\n";
    if (!ut_sema_rejects_with(un, "takes two arguments")) { ret 1; }
    ret 0;
}

