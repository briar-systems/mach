    var yt: [2]str;
    yt[0] = "use uniontest.lib;\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var o: lib.YOuter[u32]; o.u.b = 0; ret 0; }\n";
    yt[1] = "pub uni YU[A, B] { a: A; b: B; }\npub rec YOuter[T] { u: YU[T, ^u32]; }\n";
    if (ut_ct_lower_diag_n(?yn[0], ?yt[0], 2, "this instantiation makes overlapping fields") != 0) { bad = 1; }
    ret bad;
}

test "mach.lang.driver:pack_instance_enclosing_typeof_folds" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    var bad: i32 = 0;

    var n1: [1]str;
    n1[0] = "main.mach";
    var t1: [1]str;
    t1[0] = "fun pick[T](seed: T, va: ...) u32 { var out: T = seed; var r: u32 = 0; $each a in va { $if ($type_of(out) == u32) { r = r + 4001; } $or { r = r + 4002; } } ret r; }\nfun main() i32 { var p: u32 = 5; var one: u32 = 1; pick[u32](p, one); ret 0; }\n";
    val p1: R.Result[project.Project, outcome.Fail] = ut_lower_n(?s, ?alloc, ?n1[0], ?t1[0], 1);
    if (R.is_err[project.Project, outcome.Fail](p1)) { bad = 1; }
    or {
        var pp: project.Project = R.unwrap_ok[project.Project, outcome.Fail](p1);
        val m: *ir.Module = ut_ir_of(?pp, ?s, "uniontest.main");
        if (ut_const_uses(m, 4001) != 1) { bad = 1; }
        if (ut_const_uses(m, 4002) != 0) { bad = 1; }
        project.dnit_project(?pp);
    }

    var n2: [1]str;
    n2[0] = "main.mach";
    var t2: [1]str;
    t2[0] = "fun pick[T](seed: T, va: ...) u32 { var out: T = seed; var r: u32 = 0; $if ($type_of(out) == u32) { r = r + 4001; } $or { r = r + 4002; } $each a in va { r = r + a; } ret r; }\nfun main() i32 { var p: u32 = 5; var one: u32 = 1; pick[u32](p, one); ret 0; }\n";
    val p2: R.Result[project.Project, outcome.Fail] = ut_lower_n(?s, ?alloc, ?n2[0], ?t2[0], 1);
    if (R.is_err[project.Project, outcome.Fail](p2)) { bad = 1; }
    or {
        var pp: project.Project = R.unwrap_ok[project.Project, outcome.Fail](p2);
        val m: *ir.Module = ut_ir_of(?pp, ?s, "uniontest.main");
        if (ut_const_uses(m, 4001) != 1) { bad = 1; }
        if (ut_const_uses(m, 4002) != 0) { bad = 1; }
        project.dnit_project(?pp);
    }

    var n3: [1]str;
    n3[0] = "main.mach";
    var t3: [1]str;
    t3[0] = "fun pick[T](seed: T, va: ...) u32 { var out: T = seed; var r: u32 = 0; $each a in va { $if ($type_of(out) == u32) { r = r + 4001; } $or { r = r + 4002; } } ret r; }\nfun main() i32 { var p: u64 = 5; var one: u32 = 1; pick[u64](p, one); ret 0; }\n";
    val p3: R.Result[project.Project, outcome.Fail] = ut_lower_n(?s, ?alloc, ?n3[0], ?t3[0], 1);
    if (R.is_err[project.Project, outcome.Fail](p3)) { bad = 1; }
    or {
        var pp: project.Project = R.unwrap_ok[project.Project, outcome.Fail](p3);
        val m: *ir.Module = ut_ir_of(?pp, ?s, "uniontest.main");
        if (ut_const_uses(m, 4001) != 0) { bad = 1; }
        if (ut_const_uses(m, 4002) != 1) { bad = 1; }
        project.dnit_project(?pp);
    }

    session.dnit(?s);
    ret bad;
}

fun ut_app(buf: *u8, w: usize, text: str) usize {
    var i: usize = 0;
    var k: usize = w;
    for (i < str_len(text)) { buf[k] = text[i]; k = k + 1; i = i + 1; }
    ret k;
}

fun ut_appd(buf: *u8, w: usize, v: u32) usize {
    if (v >= 10) {
        val k: usize = ut_appd(buf, w, v / 10);
        buf[k] = ('0'::u32 + v % 10)::u8;
        ret k + 1;
    }
    buf[w] = ('0'::u32 + v)::u8;
    ret w + 1;
}

fun ut_shift_value(i: u32) u64 {
    if (i == 0) { ret 0; }
    if (i == 1) { ret 0xFFFFFFFFFFFFFFFF; }
    if (i == 2) { ret 0xAA55AA55AA55AA55; }
    if (i == 3) { ret 0x0102040810204080; }
    if (i == 4) { ret 0x8000000080008080; }
    if (i == 5) { ret 1; }
    var seed: u64 = 0x243F6A8885A308D3 + i::u64;
    seed = seed ^ (seed << 13);
    seed = seed ^ (seed >> 7);
    seed = seed ^ (seed << 17);
    ret seed;
}

val UT_SHIFT_VALUES: u32 = 16;

fun ut_mul_ref(bits: u32, v: u64, w: u64) u64 {
    var mask: u64 = 0xFFFFFFFFFFFFFFFF;
    if (bits < 64) { mask = (1::u64 << bits::u64) - 1; }
    ret ((v & mask) * (w & mask)) & mask;
}

