test "mach.lang.driver:tag_comptime_sel_and_payload_reads_agree_with_runtime_on_every_native_backend" {
    $if ($mach.build.os != $mach.os.linux || $mach.build.arch != $mach.arch.x86_64) { ret 0; }
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    ret ut_tag_native_all(?alloc, ut_l8_comptime_program(), "comptime parity");
}

fun ut_l8_trap_target(alloc: *A.Allocator, target_name: str, runner_name: str, release: bool) i32 {
    var runner: str = "";
    if (!str_empty(runner_name)) {
        val rr: res[str, exec.Error] = exec.resolve(alloc, runner_name);
        if (sel rr.err) {
            print.print("tag-trap: runner absent, arm skipped: ");
            print.print(runner_name);
            print.print("\n");
            ret 0;
        }
        runner = rr.ok;
    }
    val sr: res[session.Session, fail.Fail] = session.init(alloc);
    if (sel sr.err) { ret 1; }
    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = ut_cc3(alloc, ut_l8_trap_program(), "\n", ut_tag_start_stub());
    val root_r: res[str, fail.Fail] = ut_scaffold_m(alloc, ut_divide_manifest(), ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    var bad: i32                                  = 0;
    val mr:  res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) {
        fs.remove_all(alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var m:  manifest.Manifest    = mr.ok;
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    rq.target       = target_name;
    if (release) {
        rq.profile = "release";
        rq.opt     = pipeline.OPT_RELEASE;
    }
    val pr: res[bplan.BuildPlan, outcome.Fail] = bplan.plan(alloc, ?s.interner, s.registry, ?m, rq);
    if (sel pr.err) {
        fs.remove_all(alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var bp: bplan.BuildPlan                         = pr.ok;
    val br: res[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, alloc, nil);
    if (sel br.err) { bad = 1; }
    if (sel br.ok) {
        val bo: outcome.BuildOutcome = br.ok;
        if (bo.severity != outcome.BUILD_OK || bo.artifacts.len != 1) { bad = 1; }
        or {
            val program: str = bo.artifacts.data[0].path;
            # release reads through: argc 2 lands the write on the payload, every other access sees 42
            var release_exit: [8]i32 = [8]i32{42, 7, 42, 42, 42, 42, 42, 42};
            var argc:         usize  = 1;
            for (argc <= 8) {
                var trapped: bool = false;
                var code:    i32  = 0;
                if (!ut_run_with_argc(root, runner, program, argc, ?trapped, ?code)) { bad = 2; }
                or (release || argc == 8) {
                    if (trapped || code != release_exit[argc - 1]) { bad = 3; }
                }
                or (!trapped) { bad = 4; }
                if (bad != 0) {
                    print.print("tag-trap: unexpected outcome on ");
                    print.print(target_name);
                    print.printf(" (argc {}, step {}, trapped {}, exit {})\n", argc, bad, trapped::u8, code);
                    brk;
                }
                argc = argc + 1;
            }
        }
    }
    val remove_all_r: err[fs.FsError] = fs.remove_all(alloc, root);
    if (sel remove_all_r.err) { bad = 5; }
    session.dnit(?s);
    ret bad;
}

test "mach.lang.driver:tag_debug_trap_fires_for_every_guarded_access_kind_on_every_native_backend" {
    $if ($mach.build.os != $mach.os.linux || $mach.build.arch != $mach.arch.x86_64) { ret 0; }
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var release: bool = false;
    var pass:    u32  = 0;
    for (pass < 2) {
        if (ut_l8_trap_target(?alloc, "linux-x86_64", "", release) != 0)              { ret 2; }
        if (ut_l8_trap_target(?alloc, "linux-arm64", "qemu-aarch64", release) != 0)   { ret 3; }
        if (ut_l8_trap_target(?alloc, "linux-riscv64", "qemu-riscv64", release) != 0) { ret 4; }
        release = true;
        pass    = pass + 1;
    }
    ret 0;
}

fun ut_spirv_env_manifest(alloc: *A.Allocator, env_line: str) str {
    ret ut_cc3(alloc, "[project]\nid = \"envtest\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.gpu]\nisa = \"spirv\"\nos = \"freestanding\"\nabi = \"spirv\"\n", env_line, "\n[artifact.k]\nkind = \"bin\"\nentry = \"k.mach\"\nout = \"k.spv\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n");
}

fun ut_spirv_env_build(alloc: *A.Allocator, env_line: str, needle: str, want_version: u32) i32 {
    val sr: res[session.Session, fail.Fail] = session.init(alloc);
    if (sel sr.err) { ret 1; }
    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [1]str;
    names[0] = "k.mach";
    var texts: [1]str;
    texts[0] = "#[output(0)] var out_colour: f32x4;\n\n#[stage(\"fragment\")]\nfun frag_main() {\n    var small: u8 = 3;\n    small = small + 1;\n    out_colour = f32x4{small::f32, 0.0, 0.0, 1.0};\n}\n";
    val root_r: res[str, fail.Fail] = ut_scaffold_m(alloc, ut_spirv_env_manifest(alloc, env_line), ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    var bad:  i32 = 0;
    var pick: manifest.Selection;
    pick.target       = "gpu";
    pick.profile      = "";
    pick.artifact     = "";
    pick.want_lib     = false;
    pick.has_artifact = false;
    val pr: res[project.Project, outcome.Fail] = driver.build_project_sel(?s, root, ?pick);
    if (sel pr.err) {
        val f: outcome.Fail = pr.err;
        if (str_empty(needle) || sel f.reported || !ut_str_contains(outcome.describe(f), needle)) {
            print.print(outcome.describe(f));
            print.print("\n");
            bad = 2;
        }
    }
    if (sel pr.ok) {
        var p:  project.Project   = pr.ok;
        val se: err[outcome.Fail] = driver.run_sema_pass(?p);
        val le: err[outcome.Fail] = driver.run_lower_pass(?p);
        val ce: err[outcome.Fail] = driver.run_codegen_pass(?p);
        if (sel se.err || sel le.err) { bad = 3; }
        or (!str_empty(needle)) {
            if (sel ce.ok) { bad = 4; }
            or (sel ce.err) {
                if (!ut_str_contains(outcome.describe(ce.err), needle)) {
                    print.print(outcome.describe(ce.err));
                    print.print("\n");
                    bad = 5;
                }
            }
        }
        or {
            if (sel ce.err) {
                print.print(outcome.describe(ce.err));
                print.print("\n");
                bad = 6;
            }
            if (sel ce.ok) {
                var m:     *project.ModuleEntry       = nil;
                val fqn_r: res[intern.StrId, A.Error] = intern.intern(?s.interner, "envtest.k");
                if (sel fqn_r.ok) {
                    val mo: opt[*project.ModuleEntry] = project.module_by_fqn(?p, fqn_r.ok);
                    if (sel mo.some) { m = mo.some; }
                }
                if (m == nil || m.object_image == nil || m.object_image.section_count == 0 || m.object_image.sections[0].len < 8) { bad = 7; }
                or {
                    val d:       *u8 = m.object_image.sections[0].bytes;
                    val version: u32 = d[4]::u32 | (d[5]::u32 << 8) | (d[6]::u32 << 16) | (d[7]::u32 << 24);
                    if (version != want_version) {
                        print.printf("spirv env: header version {}\n", version);
                        bad = 8;
                    }
                }
            }
        }
        project.dnit_project(?p);
    }
    fs.remove_all(alloc, root);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.driver:spirv_env_pins_the_version_and_caps_the_capabilities" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err)                                                           { ret 1; }
    if (ut_spirv_env_build(?alloc, "env = \"vulkan1.0\"\n", "Int8", 0) != 0)      { ret 2; }
    if (ut_spirv_env_build(?alloc, "env = \"vulkan1.2\"\n", "", 0x00010500) != 0) { ret 3; }
    if (ut_spirv_env_build(?alloc, "", "", 0x00010600) != 0)                      { ret 4; }
    if (ut_spirv_env_build(?alloc, "env = \"vulkan9.9\"\n", "vulkan1.3", 0) != 0) { ret 5; }
    ret 0;
}

test "mach.lang.driver:embed_target_rules" {
    var bad: i32 = 0;

    if (ut_embed_diag("#[embed(\"asset.bin\")]\nvar A: [_]u8;\nfun main() i32 { ret A[0]::i32; }\n",
        "abc", "applies only to a `val`") != 0) { bad = 1; }
    if (ut_embed_diag("#[embed(\"asset.bin\")]\nval A: [_]u32;\nfun main() i32 { ret 0; }\n",
        "abc", "element type must be `u8`") != 0) { bad = 1; }
    if (ut_embed_diag("#[embed(\"asset.bin\")]\nval A: u8;\nfun main() i32 { ret A::i32; }\n",
        "abc", "must be annotated `[_]u8` or `[N]u8`") != 0) { bad = 1; }
    if (ut_embed_diag("#[embed()]\nval A: [_]u8;\nfun main() i32 { ret A[0]::i32; }\n",
        "abc", "takes one string argument") != 0) { bad = 1; }
    if (ut_embed_diag("#[embed(\"asset.bin\")]\nfun f() i32 { ret 0; }\nfun main() i32 { ret f(); }\n",
        "abc", "applies only to a `val`") != 0) { bad = 1; }
    if (ut_embed_diag("#[embed(\"asset.bin\")]\n#[embed(\"asset.bin\")]\nval A: [_]u8;\nfun main() i32 { ret A[0]::i32; }\n",
        "abc", "only one `embed` decorator") != 0) { bad = 1; }

    if (ut_embed_diag("val A: [_]u8 = [1]u8{1};\nfun main() i32 { ret A[0]::i32; }\n",
        "abc", "only valid on an `#[embed(...)]` declaration") != 0) { bad = 1; }

    ret bad;
}

test "mach.lang.driver:embed_rejection_does_not_cascade" {
    var bad: i32 = 0;

    if (ut_embed_diag("#[embed(\"asset.bin\")]\nval A: [_][_]u8;\nfun main() i32 { ret 0; }\n",
        "abc", "only valid on an `#[embed(...)]` declaration") == 0) { bad = 1; }
    if (ut_embed_diag("#[embed(\"asset.bin\")]\nval A: *[_]u8;\nfun main() i32 { ret 0; }\n",
        "abc", "only valid on an `#[embed(...)]` declaration") == 0) { bad = 1; }
    if (ut_embed_diag("#[embed(\"asset.bin\")]\nval A: [3][_]u8;\nfun main() i32 { ret 0; }\n",
        "abc", "only valid on an `#[embed(...)]` declaration") == 0) { bad = 1; }

    if (ut_embed_diag("#[embed(\"asset.bin\")]\nval A: [_][_]u8;\nfun main() i32 { ret 0; }\n",
        "abc", "element type must be `u8`") != 0) { bad = 1; }

    if (ut_embed_diag("#[embed(\"nope.bin\")]\nval A: [_]u8;\nfun main() i32 { var q: [_]u8; ret 0; }\n",
        "abc", "only valid on an `#[embed(...)]` declaration") != 0) { bad = 1; }

    ret bad;
}

test "mach.lang.driver:embed_asset_edit_invalidates_sema" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    val rr: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [3]str;
    names[0] = "main.mach";
    names[1] = "asset.bin";
    names[2] = "other.mach";
    var texts: [3]str;
    texts[0] = "use uniontest.other;\n\n#[embed(\"asset.bin\")]\nval A: [_]u8;\n\nfun main() i32 { ret A[0]::i32; }\n";
    texts[1] = "abc";
    texts[2] = "pub fun untouched() i32 { ret 1; }\n";

    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 3);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    var bad: i32 = 0;

    val p1r: res[project.Project, outcome.Fail] = ut_sema_build(?s, root);
    if (sel p1r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var p1:         project.Project        = p1r.ok;
    val st_main:    session.StableModuleId = ut_stable(?p1, ?s, "uniontest.main");
    val st_other:   session.StableModuleId = ut_stable(?p1, ?s, "uniontest.other");
    val lc_main_1:  query.Revision         = ut_sema_lc(?s, st_main);
    val lc_other_1: query.Revision         = ut_sema_lc(?s, st_other);
    project.dnit_project(?p1);

    val p2r: res[project.Project, outcome.Fail] = ut_sema_build(?s, root);
    if (sel p2r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var p2: project.Project = p2r.ok;
    if (ut_sema_lc(?s, st_main) != lc_main_1) { bad = 1; }
    project.dnit_project(?p2);

    val src_dir: str             = ut_cc3(?alloc, root, "/", "src");
    val a_path:  str             = ut_cc3(?alloc, src_dir, "/", "asset.bin");
    val new_a:   str             = "wxyz";
    val wr:      err[fs.FsError] = fs.write_bytes(a_path, new_a, str_len(new_a), 420);
    if (sel wr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }

    val p3r: res[project.Project, outcome.Fail] = ut_sema_build(?s, root);
    if (sel p3r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var p3: project.Project = p3r.ok;
    if (ut_sema_lc(?s, st_main) == lc_main_1)   { bad = 1; }
    if (ut_sema_lc(?s, st_other) != lc_other_1) { bad = 1; }
    project.dnit_project(?p3);

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

fun ut_sema_build(s: *session.Session, root: str) res[project.Project, outcome.Fail] {
    val pr: res[project.Project, outcome.Fail] = driver.build_project_union(s, root);
    if (sel pr.err) { ret pr; }
    var p:  project.Project   = pr.ok;
    val se: err[outcome.Fail] = driver.run_sema_pass(?p);
    if (sel se.err) {
        project.dnit_project(?p);
        ret res[project.Project, outcome.Fail].err{se.err};
    }
    ret res[project.Project, outcome.Fail].ok{p};
}

fun ut_lower_build(s: *session.Session, root: str) res[project.Project, outcome.Fail] {
    val pr: res[project.Project, outcome.Fail] = driver.build_project_union(s, root);
    if (sel pr.err) { ret pr; }
    var p:  project.Project   = pr.ok;
    val se: err[outcome.Fail] = driver.run_sema_pass(?p);
    if (sel se.err) {
        project.dnit_project(?p);
        ret res[project.Project, outcome.Fail].err{se.err};
    }
    val le: err[outcome.Fail] = driver.run_lower_pass(?p);
    if (sel le.err) {
        project.dnit_project(?p);
        ret res[project.Project, outcome.Fail].err{le.err};
    }
    ret res[project.Project, outcome.Fail].ok{p};
}

fun ut_embed_global(p: *project.Project) *ir.Global {
    var ti: u32 = 0;
    for (ti < p.topo_len) {
        val m: *ir.Module = p.modules[p.topo[ti]::u32].ir_module;
        if (m != nil) {
            var gi: u32 = 0;
            for (gi < m.global_len) {
                if (m.globals[gi].is_embed) { ret ?m.globals[gi]; }
                gi = gi + 1;
            }
        }
        ti = ti + 1;
    }
    ret nil;
}

fun ut_embed_bytes_equal(g: *ir.Global, want: str) bool {
    if (g == nil)                                      { ret false; }
    if (g.init.kind != value.VAL_CONST_BYTES)          { ret false; }
    if (g.init.data.bytes.len::usize != str_len(want)) { ret false; }
    if (g.init.data.bytes.ptr == nil)                  { ret str_len(want) == 0::usize; }
    var i: u32 = 0;
    for (i < g.init.data.bytes.len) {
        if (g.init.data.bytes.ptr[i] != want[i::usize]) { ret false; }
        i = i + 1;
    }
    ret true;
}

test "mach.lang.driver:embed_buffer_is_stable_across_warm_rebuilds" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    val rr: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [2]str;
    names[0] = "main.mach";
    names[1] = "asset.bin";
    var texts: [2]str;
    texts[0] = "#[embed(\"asset.bin\")]\nval A: [_]u8;\n\nfun main() i32 { ret A[0]::i32; }\n";
    texts[1] = "abc";

    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 2);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    var bad:     i32 = 0;
    val src_dir: str = ut_cc3(?alloc, root, "/", "src");
    val a_path:  str = ut_cc3(?alloc, src_dir, "/", "asset.bin");

    val p1r: res[project.Project, outcome.Fail] = ut_lower_build(?s, root);
    if (sel p1r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var p1: project.Project = p1r.ok;
    val g1: *ir.Global      = ut_embed_global(?p1);
    if (!ut_embed_bytes_equal(g1, "abc")) { bad = 1; }
    var ptr1: *u8 = nil;
    if (g1 == nil) { bad = 1; }
    or             { ptr1 = g1.init.data.bytes.ptr; }
    val st_main: session.StableModuleId = ut_stable(?p1, ?s, "uniontest.main");
    val lower_1: query.Revision         = ut_lower_lc(?s, st_main);
    project.dnit_project(?p1);

    val p2r: res[project.Project, outcome.Fail] = ut_lower_build(?s, root);
    if (sel p2r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var p2: project.Project = p2r.ok;
    val g2: *ir.Global      = ut_embed_global(?p2);
    if (!ut_embed_bytes_equal(g2, "abc"))            { bad = 1; }
    if (g2 != g1)                                    { bad = 1; }
    if (g2 == nil || g2.init.data.bytes.ptr != ptr1) { bad = 1; }
    if (ut_lower_lc(?s, st_main) != lower_1)         { bad = 1; }
    project.dnit_project(?p2);

    val w1: err[fs.FsError] = fs.write_bytes(a_path, "xyz", 3::usize, 420);
    if (sel w1.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    val p3r: res[project.Project, outcome.Fail] = ut_lower_build(?s, root);
    if (sel p3r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var p3: project.Project = p3r.ok;
    if (!ut_embed_bytes_equal(ut_embed_global(?p3), "xyz")) { bad = 1; }
    val lower_3: query.Revision = ut_lower_lc(?s, st_main);
    if (lower_3 == lower_1) { bad = 1; }
    project.dnit_project(?p3);

    val w2: err[fs.FsError] = fs.write_bytes(a_path, "wxyz!", 5::usize, 420);
    if (sel w2.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    val p4r: res[project.Project, outcome.Fail] = ut_lower_build(?s, root);
    if (sel p4r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var p4: project.Project = p4r.ok;
    if (!ut_embed_bytes_equal(ut_embed_global(?p4), "wxyz!")) { bad = 1; }
    if (ut_lower_lc(?s, st_main) == lower_3)                  { bad = 1; }
    project.dnit_project(?p4);

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

fun ut_attr_probe(s: *session.Session, alloc: *A.Allocator, names: *str, texts: *str,
    n: u32, target_name: str, sym: str) res[str, outcome.Fail] {
    val root_r: res[str, fail.Fail] = ut_scaffold(alloc, names, texts, n);
    if (sel root_r.err) {
        ret res[str, outcome.Fail].err{outcome.from_fail(root_r.err)};
    }
    val root: str               = root_r.ok;
    val rr:   err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.err) {
        fs.remove_all(alloc, root);
        ret res[str, outcome.Fail].err{rr.err};
    }
    var tsel_14044: manifest.Selection                 = ut_target_sel(target_name);
    val pr:         res[project.Project, outcome.Fail] = driver.build_project(s, root, ?tsel_14044);
    fs.remove_all(alloc, root);
    if (sel pr.err) {
        ret res[str, outcome.Fail].err{pr.err};
    }
    var p: project.Project = pr.ok;

    val se: err[outcome.Fail] = driver.run_sema_pass(?p);
    if (sel se.err) {
        project.dnit_project(?p);
        ret res[str, outcome.Fail].err{se.err};
    }
    val le: err[outcome.Fail] = driver.run_lower_pass(?p);
    if (sel le.err) {
        project.dnit_project(?p);
        ret res[str, outcome.Fail].err{le.err};
    }

    var out: str                        = "";
    val sid: res[intern.StrId, A.Error] = intern.intern(?s.interner, sym);
    if (sel sid.ok) {
        val got: opt[intern.StrId] = session.import_library(s, sid.ok);
        if (sel got.some) {
            val nm: opt[str] = intern.lookup(?s.interner, got.some);
            if (sel nm.some) { out = nm.some; }
        }
    }
    project.dnit_project(?p);
    ret res[str, outcome.Fail].ok{out};
}

fun ut_attr_probe_allsrc(s: *session.Session, alloc: *A.Allocator, names: *str, texts: *str,
    n: u32, target_name: str, sym: str) res[str, outcome.Fail] {
    val root_r: res[str, fail.Fail] = ut_scaffold(alloc, names, texts, n);
    if (sel root_r.err) {
        ret res[str, outcome.Fail].err{outcome.from_fail(root_r.err)};
    }
    val root: str               = root_r.ok;
    val rr:   err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.err) {
        fs.remove_all(alloc, root);
        ret res[str, outcome.Fail].err{rr.err};
    }

    var pick: manifest.Selection;
    pick.target       = target_name;
    pick.profile      = "";
    pick.artifact     = "";
    pick.want_lib     = false;
    pick.has_artifact = false;
    val pr: res[project.Project, outcome.Fail] = driver.build_project_test(s, root, ?pick);
    fs.remove_all(alloc, root);
    if (sel pr.err) {
        ret res[str, outcome.Fail].err{pr.err};
    }
    var p: project.Project = pr.ok;

    if (p.emit_len >= p.module_len) {
        project.dnit_project(?p);
        ret res[str, outcome.Fail].err{outcome.user("fixture loaded no uncompiled module")};
    }

    val se: err[outcome.Fail] = driver.run_sema_pass(?p);
    if (sel se.err) {
        project.dnit_project(?p);
        ret res[str, outcome.Fail].err{se.err};
    }
    val le: err[outcome.Fail] = driver.run_lower_pass(?p);
    if (sel le.err) {
        project.dnit_project(?p);
        ret res[str, outcome.Fail].err{le.err};
    }

    var out: str                        = "";
    val sid: res[intern.StrId, A.Error] = intern.intern(?s.interner, sym);
    if (sel sid.ok) {
        val got: opt[intern.StrId] = session.import_library(s, sid.ok);
        if (sel got.some) {
            val nm: opt[str] = intern.lookup(?s.interner, got.some);
            if (sel nm.some) { out = nm.some; }
        }
    }
    project.dnit_project(?p);
    ret res[str, outcome.Fail].ok{out};
}

test "mach.lang.driver:uncompiled_module_attribution_not_projected" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [2]str;
    names[0] = "main.mach";
    names[1] = "orphan.mach";
    var texts: [2]str;
    texts[0] = "fun main() i32 { ret 0; }\n";
    texts[1] = "#[library(\"user32\")]\next fun Sleep(ms: u32);\npub fun call() { Sleep(0); }\n";

    var bad: i32                    = 0;
    val pr:  res[str, outcome.Fail] = ut_attr_probe_allsrc(?s, ?alloc, ?names[0], ?texts[0], 2, "linux", "Sleep");
    if (sel pr.err) { bad = 1; }
    if (sel pr.ok) {
        val got: str = pr.ok;
        if (!str_equals(got, "")) { bad = 1; }
    }

    session.dnit(?s);
    ret bad;
}

