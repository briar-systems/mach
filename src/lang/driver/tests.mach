fun ut_volatile_counts_release(src: str, vol_loads: *u32, vol_stores: *u32,
                               total_loads: *u32, total_stores: *u32) bool {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret false; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret false; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    var names: [1]str;
    var texts: [1]str;
    names[0] = "main.mach";
    texts[0] = src;
    val root_r: R.Result[str, str] = ut_scaffold(?alloc, ?names[0], ?texts[0], 1);
    if (R.is_err[str, str](root_r)) { session.dnit(?s); ret false; }
    val root: str = R.unwrap_ok[str, str](root_r);

    val rr: R.Result[R.Void, str] = driver.setup_registry(?s.registry);
    if (R.is_err[R.Void, str](rr)) { fs.remove_all(?alloc, root); session.dnit(?s); ret false; }

    var sel: manifest.Selection;
    sel.target       = "";
    sel.profile      = "release";
    sel.artifact     = "";
    sel.want_lib     = false;
    sel.has_artifact = false;

    val pr: R.Result[project.Project, outcome.Fail] = driver.build_project_test(?s, root, ?sel);
    fs.remove_all(?alloc, root);
    if (R.is_err[project.Project, outcome.Fail](pr)) {
        print.print(R.unwrap_err[project.Project, outcome.Fail](pr).message);
        print.print("\n");
        session.dnit(?s);
        ret false;
    }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);

    var ok: bool = false;
    val se: R.Result[R.Void, outcome.Fail] = passes.run_sema_pass(?p);
    if (R.is_err[R.Void, outcome.Fail](se)) {
        print.print(R.unwrap_err[R.Void, outcome.Fail](se).message);
        print.print("\n");
    }
    or {
        val le: R.Result[R.Void, outcome.Fail] = passes.run_lower_pass(?p);
        if (R.is_err[R.Void, outcome.Fail](le)) {
            print.print(R.unwrap_err[R.Void, outcome.Fail](le).message);
            print.print("\n");
        }
        or {
            ut_count_volatile_mem_ops(?p, vol_loads, vol_stores, total_loads, total_stores);
            ok = true;
        }
    }

    project.dnit_project(?p);
    session.dnit(?s);
    ret ok;
}

test "mach.lang.driver:volatile_survives_optimizing_pipeline_in_a_loop" {
    val src: str = "#[volatile]\nrec V { reg: u32; }\nfun main() i64 {\n    var v: V;\n    var w: V;\n    var i: u32 = 0;\n    var acc: u32 = 0;\n    for (i < 8) {\n        v.reg = v.reg + 1;\n        acc = acc + w.reg;\n        i = i + 1;\n    }\n    ret (acc + v.reg)::i64;\n}\n";

    var dvl: u32; var dvs: u32; var dtl: u32; var dts: u32;
    if (!ut_volatile_counts(src, ?dvl, ?dvs, ?dtl, ?dts)) { ret 1; }
    if (dvl == 0 || dvs == 0) { ret 1; }

    var rvl: u32; var rvs: u32; var rtl: u32; var rts: u32;
    if (!ut_volatile_counts_release(src, ?rvl, ?rvs, ?rtl, ?rts)) { ret 1; }

    if (rvl != dvl || rvs != dvs) { ret 1; }
    ret 0;
}

test "mach.lang.driver:secret_address_gated" {
    var bad: i32 = 0;
    val needle: str = "secret value used as a memory address";

    if (!ut_sema_rejects_with("fun f(p: ^*u8) ^u8 { ret @p; }\nfun main() i32 { ret 0; }\n", needle))            { bad = 1; }
    if (!ut_sema_rejects_with("fun f(p: ^*u8) { @p = 7; }\nfun main() i32 { ret 0; }\n", needle))                { bad = 1; }
    if (!ut_sema_rejects_with("fun f(p: ^*u8) ^u8 { ret p[0]; }\nfun main() i32 { ret 0; }\n", needle))          { bad = 1; }
    if (!ut_sema_rejects_with("rec R { x: u8; }\nfun f(p: ^*R) ^u8 { ret p.x; }\nfun main() i32 { ret 0; }\n", needle)) { bad = 1; }
    if (!ut_sema_rejects_with("fun f(q: **u8) ^u8 { val p: ^*u8 = @q; ret @p; }\nfun main() i32 { ret 0; }\n", needle)) { bad = 1; }

    if (!ut_sema_clean("fun f(t: ^[8]u8) ^u8 { ret t[3]; }\nfun main() i32 { ret 0; }\n"))     { bad = 1; }
    if (!ut_sema_clean("fun f(p: *^u8) ^u8 { ret @p; }\nfun main() i32 { ret 0; }\n"))         { bad = 1; }
    if (!ut_sema_clean("fun f(p: *u8) u8 { ret p[0]; }\nfun main() i32 { ret 0; }\n"))         { bad = 1; }
    if (!ut_sema_clean("rec R { x: u8; }\nfun f(p: *R) u8 { ret p.x; }\nfun main() i32 { ret 0; }\n")) { bad = 1; }
    if (!ut_sema_clean("fun f(p: ^*u8) u8 { ret @(p:^); }\nfun main() i32 { ret 0; }\n"))      { bad = 1; }
    if (!ut_sema_clean("fun f(p: ^*u8) ^*u8 { ret p; }\nfun main() i32 { ret 0; }\n"))         { bad = 1; }
    ret bad;
}

test "mach.lang.driver:c_variadic_tail_contract" {
    var bad: i32 = 0;

    if (!ut_sema_clean("ext fun p(t: *u8, ...) i64;\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var b: u8; p(?b); p(?b, 1::i32); p(?b, 1::i32, 2::i64, 3.5::f64, ?b); ret 0; }\n")) { bad = 1; }

    if (ut_vec_diag("ext fun p(t: *u8, n: i64, ...) i64;\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var b: u8; p(?b); ret 0; }\n",
        "expected at least 2") != 0) { bad = 1; }

    if (ut_vec_diag("ext fun p(t: *u8, ...) i64;\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var b: u8; var c: u8 = 65; p(?b, c); ret 0; }\n",
        "promoted to a 32-bit integer") != 0) { bad = 1; }
    if (ut_vec_diag("ext fun p(t: *u8, ...) i64;\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var b: u8; var f: f32 = 1.5; p(?b, f); ret 0; }\n",
        "promoted to `f64`") != 0) { bad = 1; }
    if (!ut_sema_clean("ext fun p(t: *u8, ...) i64;\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var b: u8; var c: u8 = 65; var f: f32 = 1.5; p(?b, c::i32, f::f64); ret 0; }\n")) { bad = 1; }

    if (ut_vec_diag("ext fun p(t: *u8, ...) i64;\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var b: u8; var s: ^i64 = 1; p(?b, s); ret 0; }\n",
        "secret value cannot be passed to a C-variadic") != 0) { bad = 1; }

    if (ut_vec_diag("ext fun q(t: *u8) i64;\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var b: u8; q(?b, 1::i64); ret 0; }\n",
        "arity mismatch") != 0) { bad = 1; }

    if (ut_vec_diag("ext fun r(t: *u8, ...) i64 { ret 0; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "cannot have a body") != 0) { bad = 1; }

    ret bad;
}

test "mach.lang.driver:secrecy_placement_byte_extent" {
    val need: str = "union variants must agree on secrecy";

    var bad: i32 = 0;
    if (!ut_sema_rejects_with("rec A { x: ^u8; y: u8; }\nrec B { x: ^u32; y: u8; }\nuni U { a: A; b: B; }\nfun main() i32 { ret 0; }\n", need)) { bad = 1; }
    if (!ut_sema_rejects("rec A { x: ^u8; y: u8; }\nrec B { x: ^u32; y: u8; }\nfun f(p: *A) *B { ret p:~*B; }\nfun main() i32 { ret 0; }\n")) { bad = 1; }
    if (!ut_sema_rejects_with("rec A { x: ^[1]u8; y: u8; }\nrec B { x: ^[4]u8; y: u8; }\nuni U { a: A; b: B; }\nfun main() i32 { ret 0; }\n", need)) { bad = 1; }
    if (!ut_sema_rejects_with("rec S { v: ^u8; }\nrec T { v: ^u64; }\nrec A { x: S; y: u8; }\nrec B { x: T; y: u8; }\nuni U { a: A; b: B; }\nfun main() i32 { ret 0; }\n", need)) { bad = 1; }
    if (!ut_sema_rejects_with("rec A { x: ^f32; y: u8; }\nrec B { x: ^f64; y: u8; }\nuni U { a: A; b: B; }\nfun main() i32 { ret 0; }\n", need)) { bad = 1; }
    if (!ut_sema_rejects_with("rec A { x: ^[4]u8; y: u8; }\nrec B { x: ^u32; y: u8; }\nuni U { a: A; b: B; }\nfun main() i32 { ret 0; }\n", need)) { bad = 1; }

    if (!ut_sema_clean("rec A { x: ^u32; }\nrec B { x: ^u32; y: u32; }\nuni U { a: A; b: B; }\nfun main() i32 { ret 0; }\n"))                        { bad = 1; }
    if (!ut_sema_clean("rec A { x: ^u32; y: u8; }\nrec B { x: ^u32; y: u8; z: u64; }\nuni U { a: A; b: B; }\nfun main() i32 { ret 0; }\n"))          { bad = 1; }
    if (!ut_sema_clean("rec A { x: ^u32; }\nrec B { x: ^u32; y: u32; }\nfun f(p: *A) *B { ret p:~*B; }\nfun main() i32 { ret 0; }\n"))               { bad = 1; }

    if (!ut_sema_rejects_with("rec A { x: ^u32; y: u32; }\nrec B { x: u32; y: ^u32; }\nuni U { a: A; b: B; }\nfun main() i32 { ret 0; }\n", need))   { bad = 1; }
    if (!ut_sema_rejects_with("rec A { x: u32; }\nrec B { x: ^u32; y: u32; }\nuni U { a: A; b: B; }\nfun main() i32 { ret 0; }\n", need))            { bad = 1; }
    if (!ut_sema_rejects("uni V { p: ^u32; }\nrec B { x: ^u32; y: u32; }\nfun f(p: *V) *B { ret p:~*B; }\nfun main() i32 { ret 0; }\n")) { bad = 1; }
    if (!ut_sema_clean("rec A { x: ^u32; }\nrec B { x: ^u32; y: u32; }\nfun f(p: *A) *B { ret p:~*B; }\nfun main() i32 { ret 0; }\n"))   { bad = 1; }

    if (!ut_sema_clean("rec A { x: ^u8; }\nrec B { x: ^u32; y: ^u32; }\nuni U { a: A; b: B; }\nfun main() i32 { ret 0; }\n")) { bad = 1; }
    if (!ut_sema_clean("rec A { x: u8; }\nrec B { x: u32; y: u32; }\nuni U { a: A; b: B; }\nfun main() i32 { ret 0; }\n"))    { bad = 1; }
    ret bad;
}

test "mach.lang.driver:recursive_type_occurs_check" {
    val need: str = "recursive type has infinite size";

    var bad: i32 = 0;
    if (!ut_sema_rejects_with("rec R { next: R; }\nfun main() i32 { ret 0; }\n", need))                       { bad = 1; }
    if (!ut_sema_rejects_with("rec R { next: R; }\nfun main() i32 { var r: R; ret 0; }\n", need))             { bad = 1; }
    if (!ut_sema_rejects_with("uni U { a: u32; b: U; }\nfun main() i32 { ret 0; }\n", need))                  { bad = 1; }
    if (!ut_sema_rejects_with("rec R { a: [4]R; }\nfun main() i32 { ret 0; }\n", need))                       { bad = 1; }
    if (!ut_sema_rejects_with("rec A { b: B; }\nrec B { a: A; }\nfun main() i32 { ret 0; }\n", need))         { bad = 1; }
    if (!ut_sema_rejects_with("rec A { b: B; }\nrec B { c: C; }\nrec C { a: A; }\nfun main() i32 { ret 0; }\n", need)) { bad = 1; }
    if (!ut_sema_rejects_with("rec R { a: rec { b: R; }; }\nfun main() i32 { ret 0; }\n", need))              { bad = 1; }
    if (!ut_sema_rejects_with("rec W[T] { v: T; inner: W[T]; }\nfun main() i32 { var w: W[i32]; ret 0; }\n", need))    { bad = 1; }
    if (!ut_sema_rejects_with("rec Wrap[T] { inner: Wrap[Wrap[T]]; }\nfun main() i32 { var w: Wrap[i32]; ret 0; }\n", need)) { bad = 1; }

    if (!ut_sema_clean("rec Node { next: *Node; }\nfun main() i32 { var n: Node; ret 0; }\n"))                { bad = 1; }
    if (!ut_sema_clean("rec A { b: *B; }\nrec B { a: *A; }\nfun main() i32 { var a: A; ret 0; }\n"))          { bad = 1; }
    if (!ut_sema_clean("uni U { a: u32; b: *U; }\nfun main() i32 { var u: U; ret 0; }\n"))                    { bad = 1; }
    if (!ut_sema_clean("rec R { a: [4]*R; }\nfun main() i32 { var r: R; ret 0; }\n"))                         { bad = 1; }
    if (!ut_sema_clean("rec Leaf { v: u8; }\nrec L { l: Leaf; }\nrec Rt { r: Leaf; }\nrec D { x: L; y: Rt; }\nfun main() i32 { var d: D; ret 0; }\n")) { bad = 1; }
    if (!ut_sema_clean("rec N0 { v: u8; }\nrec N1 { v: N0; }\nrec N2 { v: N1; }\nrec N3 { v: N2; }\nfun main() i32 { var n: N3; ret 0; }\n")) { bad = 1; }
    ret bad;
}

test "mach.lang.driver:recursive_union_reports_its_real_defect" {
    var bad: i32 = 0;

    val rec_uni: str = "uni U[T] { a: u32; b: U[U[T]]; }\nfun main() i32 { var u: U[i32]; ret 0; }\n";
    if (!ut_sema_rejects_with(rec_uni, "recursive type has infinite size"))     { bad = 1; }
    if (ut_sema_errs(rec_uni) != 1)                                            { bad = 1; }

    val need: str = "union variants must agree on secrecy";
    if (!ut_sema_rejects_with("uni M { a: ^u32; b: u32; }\nfun main() i32 { ret 0; }\n", need))                        { bad = 1; }
    if (!ut_sema_rejects_with("rec P { s: ^u32; }\nrec Q { s: u32; }\nuni D { a: P; b: Q; }\nfun main() i32 { ret 0; }\n", need)) { bad = 1; }
    if (!ut_sema_rejects_with("uni S { a: ^u32; b: S; c: u32; }\nfun main() i32 { ret 0; }\n", need))                  { bad = 1; }
    ret bad;
}

test "mach.lang.driver:secrecy_layout_matches_lowering" {
    var bad: i32 = 0;

    if (ut_sema_extent_is("rec R { a: u8; }\nfun main() i32 { ret 0; }\n", "R", 1, 1) != 0)                     { bad = 1; }
    if (ut_sema_extent_is("rec R { a: u8; b: u32; }\nfun main() i32 { ret 0; }\n", "R", 8, 4) != 0)            { bad = 1; }
    if (ut_sema_extent_is("rec R { a: u32; b: u8; }\nfun main() i32 { ret 0; }\n", "R", 8, 4) != 0)            { bad = 1; }
    if (ut_sema_extent_is("rec R { a: u8; b: u64; }\nfun main() i32 { ret 0; }\n", "R", 16, 8) != 0)           { bad = 1; }
    if (ut_sema_extent_is("rec I { a: u8; b: u32; }\nrec R { x: I; y: u8; }\nfun main() i32 { ret 0; }\n", "R", 12, 4) != 0) { bad = 1; }
    if (ut_sema_extent_is("rec R { a: [3]u16; b: u8; }\nfun main() i32 { ret 0; }\n", "R", 8, 2) != 0)         { bad = 1; }
    if (ut_sema_extent_is("uni U { a: u8; b: u32; }\nfun main() i32 { ret 0; }\n", "U", 4, 4) != 0)            { bad = 1; }
    if (ut_sema_extent_is("rec R { a: *u8; b: u8; }\nfun main() i32 { ret 0; }\n", "R", 16, 8) != 0)           { bad = 1; }
    if (ut_sema_extent_is("#[align(16)]\nrec R { a: u32; }\nfun main() i32 { ret 0; }\n", "R", 16, 16) != 0)   { bad = 1; }
    if (ut_sema_extent_is("rec R { a: ^u8; b: ^u32; }\nfun main() i32 { ret 0; }\n", "R", 8, 4) != 0)          { bad = 1; }

    if (ut_sema_extent_is("uni G[T] { a: T; b: u8; }\nfun f(g: G[u64]) i32 { ret 0; }\nfun main() i32 { ret 0; }\n", "G", 8, 8) != 0)  { bad = 1; }
    if (ut_sema_extent_is("uni G[T] { a: T; b: T; }\nfun f(g: G[u32]) i32 { ret 0; }\nfun main() i32 { ret 0; }\n", "G", 4, 4) != 0)   { bad = 1; }
    if (ut_sema_extent_is("rec P[T] { a: T; b: u8; }\nfun f(p: P[u64]) i32 { ret 0; }\nfun main() i32 { ret 0; }\n", "P", 16, 8) != 0) { bad = 1; }

    val probe: str = "rec R1 { a: u8; }\nrec R2 { a: u8; b: u32; }\nrec R3 { a: u32; b: u8; }\nrec R4 { a: u8; b: u64; }\nrec I  { a: u8; b: u32; }\nrec R5 { x: I; y: u8; }\nrec R6 { a: [3]u16; b: u8; }\nuni U1 { a: u8; b: u32; }\nrec R7 { a: *u8; b: u8; }\n#[align(16)]\nrec R8 { a: u32; }\nrec R9 { a: ^u8; b: ^u32; }\nuni G1[T] { a: T; b: u8; }\nrec P1[T] { a: T; b: u8; }\n#[symbol(\"layout_probe\")]\nfun layout_probe(r1: R1, r2: R2, r3: R3, r4: R4, r5: R5, r6: R6, u1: U1, r7: R7, r8: R8, r9: R9, g64: G1[u64], g32: G1[u32], p64: P1[u64]) { }\nfun main() i32 { ret 0; }\n";

    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = probe;
    val pr: R.Result[project.Project, outcome.Fail] = ut_build(?s, ?alloc, ?names[0], ?texts[0], 1);
    if (R.is_err[project.Project, outcome.Fail](pr)) { session.dnit(?s); ret 1; }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);
    if (R.is_err[R.Void, outcome.Fail](passes.run_sema_pass(?p)) ||
        R.is_err[R.Void, outcome.Fail](passes.run_lower_pass(?p))) {
        project.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }
    val mid: session.ModuleId = ut_mid(?p, ?s, "uniontest.main");
    if (mid == session.MODULE_NIL || p.modules[mid::u32].ir_module == nil) { bad = 1; }
    or {
        val m: *ir.Module = p.modules[mid::u32].ir_module;
        if (!ut_ir_param_extent_is(?s, m, ?p.target, "layout_probe", 0, 1, 1))    { bad = 1; }
        if (!ut_ir_param_extent_is(?s, m, ?p.target, "layout_probe", 1, 8, 4))    { bad = 1; }
        if (!ut_ir_param_extent_is(?s, m, ?p.target, "layout_probe", 2, 8, 4))    { bad = 1; }
        if (!ut_ir_param_extent_is(?s, m, ?p.target, "layout_probe", 3, 16, 8))   { bad = 1; }
        if (!ut_ir_param_extent_is(?s, m, ?p.target, "layout_probe", 4, 12, 4))   { bad = 1; }
        if (!ut_ir_param_extent_is(?s, m, ?p.target, "layout_probe", 5, 8, 2))    { bad = 1; }
        if (!ut_ir_param_extent_is(?s, m, ?p.target, "layout_probe", 6, 4, 4))    { bad = 1; }
        if (!ut_ir_param_extent_is(?s, m, ?p.target, "layout_probe", 7, 16, 8))   { bad = 1; }
        if (!ut_ir_param_extent_is(?s, m, ?p.target, "layout_probe", 8, 16, 16))  { bad = 1; }
        if (!ut_ir_param_extent_is(?s, m, ?p.target, "layout_probe", 9, 8, 4))    { bad = 1; }
        if (!ut_ir_param_extent_is(?s, m, ?p.target, "layout_probe", 10, 8, 8))   { bad = 1; }
        if (!ut_ir_param_extent_is(?s, m, ?p.target, "layout_probe", 11, 4, 4))   { bad = 1; }
        if (!ut_ir_param_extent_is(?s, m, ?p.target, "layout_probe", 12, 16, 8))  { bad = 1; }
    }
    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.driver:secret_literal_stays_public" {
    var bad: i32 = 0;

    if (!ut_sema_clean("fun f() i32 { var s: ^u32 = 5; ret 0; }\nfun main() i32 { ret 0; }\n"))          { bad = 1; }
    if (!ut_sema_clean("fun g(s: ^u32) ^u32 { ret s; }\nfun f() i32 { g(5); ret 0; }\nfun main() i32 { ret 0; }\n")) { bad = 1; }
    if (!ut_sema_rejects("fun f() i32 { var s: ^u8 = 300; ret 0; }\nfun main() i32 { ret 0; }\n"))       { bad = 1; }

    if (!ut_sema_rejects("fun f(v: ^u8) u8 { ret v + 3; }\nfun main() i32 { ret 0; }\n"))                { bad = 1; }
    if (!ut_sema_rejects("fun f(v: ^u8) u8 { ret v << 3; }\nfun main() i32 { ret 0; }\n"))               { bad = 1; }
    if (!ut_sema_rejects("fun f(v: ^u8) u8 { var x: u8 = v & 3; ret x; }\nfun main() i32 { ret 0; }\n")) { bad = 1; }
    if (!ut_sema_rejects_with("fun f(v: ^u8) u8 { if (v << 3) { ret 1; } ret 0; }\nfun main() i32 { ret 0; }\n",
        "secret value used as a branch condition")) { bad = 1; }
    if (!ut_sema_rejects_with("fun f(v: ^u8, t: *u8) u8 { ret t[v << 3]; }\nfun main() i32 { ret 0; }\n",
        "secret value used as a memory index")) { bad = 1; }
    if (!ut_sema_clean("fun f(v: ^u8) u8 { ret (v << 3):^; }\nfun main() i32 { ret 0; }\n"))             { bad = 1; }
    ret bad;
}

