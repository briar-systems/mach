test "mach.lang.driver:secret_generic_uni_instance_secrecy" {
    var bad: i32 = 0;

    if (ut_sema_errs("uni U[T] { a: T; b: u32; }\nfun f() u32 { var u: U[^u32]; u.a = 5; ret u.b; }\nfun main() i32 { ret 0; }\n") != 1) { bad = 1; }
    if (ut_sema_errs("uni U[T] { a: T; b: u32; }\nrec Box[T] { u: U[T]; }\nfun f() u32 { var b: Box[^u32]; ret b.u.b; }\nfun main() i32 { ret 0; }\n") != 1) { bad = 1; }
    if (ut_sema_errs("uni U[T] { a: T; b: u32; }\nrec Box[T] { f: fun(*U[T]) u32; }\nfun g() i32 { var b: Box[^u32]; b.f = nil; ret 0; }\nfun main() i32 { ret 0; }\n") != 1) { bad = 1; }
    if (ut_sema_errs("rec Loc[T, E] { v: uni { a: T; b: E; }; }\nfun f() u32 { var l: Loc[^u32, u32]; ret l.v.b; }\nfun main() i32 { ret 0; }\n") != 1) { bad = 1; }
    if (ut_sema_errs("uni U[T] { a: T; b: u32; }\nfun sink[T](n: u32) u32 { var u: U[T]; u.b = n; ret u.b; }\nfun main() i32 { ret sink[^u32](1)::i32; }\n") != 1) { bad = 1; }
    if (ut_sema_errs("fun sink[T](n: u32) u32 { var v: uni { a: T; b: u32; }; v.b = n; ret v.b; }\nfun main() i32 { ret sink[^u32](1)::i32; }\n") != 1) { bad = 1; }
    if (ut_sema_errs("uni U2[A, B] { a: A; b: B; }\nfun sink[T](n: u32) u32 { var u: U2[T, ^u32]; u.b = 0; ret n; }\nfun main() i32 { ret sink[u32](1)::i32; }\n") != 1) { bad = 1; }
    if (ut_sema_errs("uni U[T] { a: T; b: u32; }\nfun mk[T]() U[T] { var r: U[T]; r.b = 0; ret r; }\nfun main() i32 { ret mk[^u32]().b::i32; }\n") != 1) { bad = 1; }
    if (ut_sema_errs("uni U[T] { a: T; b: u32; }\nfun take[T](p: *U[T]) u32 { ret 1; }\nfun main() i32 { ret take[^u32](nil)::i32; }\n") != 1) { bad = 1; }
    if (ut_sema_errs("uni U[T] { a: T; b: u32; }\ndef L: U[^u32];\nfun f() u32 { var u: L; var v: L; u.b = 0; ret v.b; }\nfun main() i32 { ret 0; }\n") != 1) { bad = 1; }
    if (ut_sema_errs("uni U[T] { a: T; b: u32; }\nrec Node[T] { next: *Node[T]; u: U[T]; }\nfun f() i32 { var n: Node[^u32]; n.next = nil; ret 0; }\nfun main() i32 { ret 0; }\n") != 1) { bad = 1; }
    if (ut_sema_errs("rec Hold[X] { x: X; }\nrec Outer[T] { h: Hold[uni { a: T; b: u32; }]; }\nfun f() i32 { var o: Outer[^u32]; o.h.x.b = 0; ret 0; }\nfun main() i32 { ret 0; }\n") != 1) { bad = 1; }
    if (ut_sema_errs("uni U[T] { a: T; b: u32; }\nrec Box[T] { u: U[T]; }\nrec Loc[T, E] { v: uni { a: T; b: E; }; }\nfun f() i32 { var b: Box[^u32]; var l: Loc[^u32, u32]; b.u.b = 0; l.v.b = 0; ret 0; }\nfun main() i32 { ret 0; }\n") != 2) { bad = 1; }
    if (ut_vec_diag("uni U[T] { a: T; b: u32; }\nfun f() u32 { var u: U[^u32]; ret u.b; }\nfun main() i32 { ret 0; }\n", "this instantiation makes overlapping fields") != 0) { bad = 1; }
    if (ut_sema_errs("uni N { a: ^u32; b: u32; }\nfun f() u32 { var n: N; ret n.b; }\nfun main() i32 { ret 0; }\n") != 1) { bad = 1; }
    if (ut_sema_errs("fun f() u32 { var v: uni { a: ^u32; b: u32; }; ret v.b; }\nfun main() i32 { ret 0; }\n") != 1) { bad = 1; }
    if (ut_sema_errs("uni U[T] { a: T; b: u32; }\nrec P[T] { x: U[u32]; y: U[T]; }\nfun f() i32 { var p: P[^u32]; p.y.b = 0; ret 0; }\nfun main() i32 { ret 0; }\n") != 1) { bad = 1; }
    ret bad;
}

test "mach.lang.driver:secret_generic_uni_instance_accepted" {
    var bad: i32 = 0;

    if (!ut_sema_clean("uni U[T] { a: T; b: u32; }\nfun f() u32 { var u: U[u32]; ret u.b; }\nfun main() i32 { ret 0; }\n"))       { bad = 1; }
    if (!ut_sema_clean("uni U2[A, B] { a: A; b: B; }\nfun f() i32 { var u: U2[^u32, ^u32]; u.a = 0; ret 0; }\nfun main() i32 { ret 0; }\n")) { bad = 1; }
    if (!ut_sema_clean("uni Us[T] { a: T; b: T; }\nrec W[T] { u: Us[T]; }\nfun f() i32 { var p: W[u32]; var s: W[^u32]; p.u.a = 0; s.u.a = 0; ret 0; }\nfun main() i32 { ret 0; }\n")) { bad = 1; }
    if (!ut_sema_clean("uni U2[A, B] { a: A; b: B; }\nrec Outer[T] { u: U2[T, ^u32]; }\nfun f() i32 { var o: Outer[^u32]; o.u.a = 0; ret 0; }\nfun main() i32 { ret 0; }\n")) { bad = 1; }
    if (ut_sema_errs("uni U2[A, B] { a: A; b: B; }\nrec Outer[T] { u: U2[T, ^u32]; }\nfun f() i32 { var o: Outer[u32]; o.u.b = 0; ret 0; }\nfun main() i32 { ret 0; }\n") != 1) { bad = 1; }
    if (!ut_sema_clean("uni U2[A, B] { a: A; b: B; }\nrec Outer[T] { u: U2[T, ^u32]; }\nfun f() i32 { ret 0; }\nfun main() i32 { ret 0; }\n")) { bad = 1; }
    if (!ut_sema_clean("rec Ctx[T] { key: T; id: u32; }\nrec N[T] { c: Ctx[T]; f: fun(*Ctx[T]) u32; }\nfun f() i32 { var n: N[^u32]; n.f = nil; ret 0; }\nfun main() i32 { ret 0; }\n")) { bad = 1; }
    if (!ut_sema_clean("uni U[T] { a: T; b: u32; }\nfun f() i32 { var s: ^u32; s = 1; $if ($mach.build.os != $mach.build.os) { var b1: U[^u32]; b1.b = 0; } $or { var ok: U[u32]; ok.b = 0; } ret 0; }\nfun main() i32 { ret 0; }\n")) { bad = 1; }
    if (!ut_sema_clean("uni U[T] { a: T; b: u32; }\nrec Node[T] { next: *Node[T]; u: U[T]; }\nfun f() i32 { var s: ^u32; s = 1; var n: Node[u32]; n.next = nil; ret 0; }\nfun main() i32 { ret 0; }\n")) { bad = 1; }
    ret bad;
}

test "mach.lang.driver:secret_float_gate_rejected" {
    var bad: i32 = 0;
    if (!ut_sema_rejects("fun f(a: ^f64, b: ^f64) ^f64 { ret a + b; }\nfun main() i32 { ret 0; }\n")) { bad = 1; }
    if (!ut_sema_rejects("fun f(a: ^f64, b: ^f64) ^f64 { ret a - b; }\nfun main() i32 { ret 0; }\n")) { bad = 1; }
    if (!ut_sema_rejects("fun f(a: ^f64, b: ^f64) ^f64 { ret a * b; }\nfun main() i32 { ret 0; }\n")) { bad = 1; }
    if (!ut_sema_rejects("fun f(a: ^f32, b: ^f32) ^u8 { ret a < b; }\nfun main() i32 { ret 0; }\n"))  { bad = 1; }
    if (!ut_sema_clean("fun f(a: f64, b: f64) f64 { ret a + b; }\nfun main() i32 { ret 0; }\n"))       { bad = 1; }
    if (!ut_sema_clean("fun f(a: f32, b: f32) u8 { ret a < b; }\nfun main() i32 { ret 0; }\n"))        { bad = 1; }
    if (ut_vec_diag("fun f(a: ^f64, b: ^f64) ^f64 { ret a * b; }\nfun main() i32 { ret 0; }\n", "variable-latency floating-point") != 0) { bad = 1; }
    if (!ut_sema_rejects("fun f(a: ^f32x4, b: ^f32x4) ^f32x4 { ret a / b; }\nfun main() i32 { ret 0; }\n")) { bad = 1; }
    if (!ut_sema_rejects("fun f(a: ^f64x2, b: ^f64x2) ^f64x2 { ret a * b; }\nfun main() i32 { ret 0; }\n")) { bad = 1; }
    if (!ut_sema_clean("fun f(a: f32x4, b: f32x4) f32x4 { ret a / b; }\nfun main() i32 { ret 0; }\n"))       { bad = 1; }
    ret bad;
}

test "mach.lang.driver:oblivious_decorator" {
    var bad: i32 = 0;
    if (!ut_sema_clean("#[oblivious]\nfun f(a: ^u32) ^u32 { ret a + a; }\nfun main() i32 { ret 0; }\n"))    { bad = 1; }
    if (!ut_sema_clean("#[oblivious]\nfun f() i32 { ret 0; }\nfun main() i32 { ret 0; }\n"))                { bad = 1; }
    if (!ut_sema_rejects("#[oblivious]\nrec R { x: u32; }\nfun main() i32 { ret 0; }\n"))                   { bad = 1; }
    if (!ut_sema_rejects("#[oblivious(1)]\nfun f() i32 { ret 0; }\nfun main() i32 { ret 0; }\n"))           { bad = 1; }
    if (ut_vec_diag("#[oblivious]\nrec R { x: u32; }\nfun main() i32 { ret 0; }\n", "applies only to functions") != 0) { bad = 1; }
    ret bad;
}

test "mach.lang.driver:secret_mul_codegen_rejected" {
    var bad: i32 = 0;
    if (!ut_sema_clean("fun f(a: ^u32, b: ^u32) ^u32 { ret a * b; }\nfun main() i32 { ret 0; }\n")) { bad = 1; }
    if (ut_codegen_rejects("#[oblivious]\nfun f(a: ^u32, b: ^u32) ^u32 { ret a * b; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { f(1, 2); ret 0; }\n",
        "variable-latency integer multiply") != 0) { bad = 1; }
    if (ut_vec_codegen_defined("fun f(a: u32, b: u32) u32 { ret a * b; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { f(1, 2); ret 0; }\n",
        "public integer multiply", CODEGEN_CASE_PUBLIC_MUL) != 0) { bad = 1; }
    ret bad;
}

fun ut_ct_edge_manifest() str {
    ret "[project]\nid = \"ct\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.x64]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[target.spv]\nisa = \"spirv\"\nos = \"freestanding\"\nabi = \"spirv\"\n\n[target.mos]\nisa = \"mos6502\"\nos = \"freestanding\"\nabi = \"mos6502\"\n\n[target.rv32]\nisa = \"riscv32\"\nos = \"freestanding\"\nabi = \"ilp32d\"\n\n[target.rv32f]\nisa = \"riscv32\"\nos = \"freestanding\"\nabi = \"ilp32f\"\n\n[target.rv32s]\nisa = \"riscv32\"\nos = \"freestanding\"\nabi = \"ilp32\"\n\n[profile.debug]\nopt = 0\ndebug = false\nsimd = \"scalarize\"\n\n[artifact.ct]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/ct\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
}

fun ut_ct_edge_project(s: *session.Session, alloc: *A.Allocator, src: str, target_name: str) R.Result[project.Project, outcome.Fail] {
    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = src;
    val root_r: R.Result[str, str] = ut_scaffold_m(alloc, ut_ct_edge_manifest(), ?names[0], ?texts[0], 1);
    if (R.is_err[str, str](root_r)) { ret R.err[project.Project, outcome.Fail](outcome.user(R.unwrap_err[str, str](root_r))); }
    val root: str = R.unwrap_ok[str, str](root_r);
    val rr: R.Result[R.Void, str] = driver.setup_registry(?s.registry);
    if (R.is_err[R.Void, str](rr)) { fs.remove_all(alloc, root); ret R.err[project.Project, outcome.Fail](outcome.user(R.unwrap_err[R.Void, str](rr))); }
    var tsel_9040: manifest.Selection = ut_target_sel(target_name);
    val pr: R.Result[project.Project, outcome.Fail] = driver.build_project(s, root, ?tsel_9040);
    fs.remove_all(alloc, root);
    ret pr;
}

test "mach.lang.driver.setup_registry:idempotent_across_repeated_calls_on_one_session" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    if (R.is_err[R.Void, str](driver.setup_registry(?s.registry))) { session.dnit(?s); ret 1; }
    val isa_count: u32 = isa.registered_count(?s.registry.isa);
    val abi_count: u32 = abi.registered_count(?s.registry.abi);
    val of_count:  u32 = of.registered_count(?s.registry.of);
    val os_count:  u32 = os.registered_count(?s.registry.os);
    if (isa_count == 0) { session.dnit(?s); ret 1; }

    if (R.is_err[R.Void, str](driver.setup_registry(?s.registry))) { session.dnit(?s); ret 1; }
    if (R.is_err[R.Void, str](driver.setup_registry(?s.registry))) { session.dnit(?s); ret 1; }
    if (isa.registered_count(?s.registry.isa) != isa_count) { session.dnit(?s); ret 1; }
    if (abi.registered_count(?s.registry.abi) != abi_count) { session.dnit(?s); ret 1; }
    if (of.registered_count(?s.registry.of)   != of_count)  { session.dnit(?s); ret 1; }
    if (os.registered_count(?s.registry.os)   != os_count)  { session.dnit(?s); ret 1; }

    session.dnit(?s);
    ret 0;
}

test "mach.lang.driver:codegen_exclusion_oracle_rejects_mutations" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    var bad: i32 = 0;

    val selected: R.Result[project.Project, outcome.Fail] = ut_ct_edge_project(?s, ?alloc,
        "#[oblivious]\nfun good(v: ^u8, n: u8) ^u8 { ret v << n; }\n#[oblivious]\nfun excluded(v: ^u8, n: ^u8) ^u8 { ret v << n; }\nfun main() i32 { ret 0; }\n", "rv32s");
    if (R.is_err[project.Project, outcome.Fail](selected)) { bad = 1; }
    or {
        var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](selected);
        if (ut_run_codegen_without(?p, "selected secret shift", CODEGEN_CASE_PUBLIC_SHIFT,
            CODEGEN_CASE_SECRET_SHIFT) == 0) { bad = 1; }
        project.dnit_project(?p);
    }

    val unrelated: R.Result[project.Project, outcome.Fail] = ut_ct_edge_project(?s, ?alloc,
        "#[oblivious]\nfun good(v: ^u8, n: u8) ^u8 { ret v << n; }\n#[oblivious]\nfun rejected(a: ^u8, b: ^u8) ^u8 { ret a * b; }\nfun main() i32 { ret 0; }\n", "rv32s");
    if (R.is_err[project.Project, outcome.Fail](unrelated)) { bad = 1; }
    or {
        var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](unrelated);
        if (ut_run_codegen_without(?p, "public shift with unrelated rejection",
            CODEGEN_CASE_PUBLIC_SHIFT, CODEGEN_CASE_SECRET_SHIFT) == 0) { bad = 1; }
        project.dnit_project(?p);
    }

    val missing: R.Result[project.Project, outcome.Fail] = ut_ct_edge_project(?s, ?alloc,
        "fun main() i32 { ret 0; }\n", "rv32s");
    if (R.is_err[project.Project, outcome.Fail](missing)) { bad = 1; }
    or {
        var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](missing);
        if (ut_run_codegen_without(?p, "missing public shift", CODEGEN_CASE_PUBLIC_SHIFT,
            CODEGEN_CASE_SECRET_SHIFT) == 0) { bad = 1; }
        project.dnit_project(?p);
    }

    session.dnit(?s);
    ret bad;
}

