}

test "mach.lang.driver:resolve_fwd_renamed_reexport_links_across_module_boundary" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [3]str;
    names[0] = "main.mach";
    names[1] = "mid.mach";
    names[2] = "leaf.mach";
    var texts: [3]str;
    texts[0] = "use uniontest.mid;\nfun main() i32 { ret mid.renamed_alias() - mid.original_name(); }\n";
    texts[1] = "fwd renamed_alias: uniontest.leaf.original_name;\nfwd uniontest.leaf.original_name;\n";
    texts[2] = "pub fun original_name() i32 { ret 42; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 3);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    var bad: i32                                = 0;
    val pr:  res[project.Project, outcome.Fail] = ut_back_half(?s, root);
    if (sel pr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var p:                       project.Project   = pr.ok;
    val set_link_config_input_r: err[outcome.Fail] = bengine.set_link_config_input(?p, "out/app"::*u8, "app"::*u8, 0, nil, 0, nil, 0, nil);
    if (sel set_link_config_input_r.err) {
        project.dnit_project(?p);
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    val rl: res[bool, outcome.Fail] = driver.run_link_pass(?p);
    if (sel rl.err) { bad = 1; }
    project.dnit_project(?p);
    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

