test "mach.lang.driver:dep_closure_conflict_names_chains" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    val rr: R.Result[R.Void, str] = driver.setup_registry(?s.registry);
    if (R.is_err[R.Void, str](rr)) { session.dnit(?s); ret 1; }

    var names: [1]str; names[0] = "main.mach";
    var texts: [1]str; texts[0] = "fun main() i32 { ret 0; }\n";
    val root_manifest: str = ut_cc3(?alloc, ut_dep_root_one(?alloc, "foo", "./vendor/foo"),
        "\n[dep.bar]\npath = \"./vendor/bar\"\n", "");
    val root_r: R.Result[str, str] = ut_scaffold_m(?alloc, root_manifest, ?names[0], ?texts[0], 1);
    if (R.is_err[str, str](root_r)) { session.dnit(?s); ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);

    var bad: i32 = 0;
    val lib: str = ut_lib_manifest(?alloc, "libx");
    val wf: O.Option[str] = ut_write_node(?alloc, ut_cc3(?alloc, root, "/", "dep/foo"),
        lib, "lib.mach", "pub fun v() i32 { ret 1; }\n");
    val wb: O.Option[str] = ut_write_node(?alloc, ut_cc3(?alloc, root, "/", "dep/bar"),
        lib, "lib.mach", "pub fun v() i32 { ret 2; }\n");
    if (O.is_some[str](wf) || O.is_some[str](wb)
        || !ut_git_repo(?alloc, root, "https://example.invalid/app.git")) {
        fs.remove_all(?alloc, root); session.dnit(?s); ret 1;
    }

    val pr: R.Result[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
    if (R.is_ok[project.Project, outcome.Fail](pr)) {
        var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);
        project.dnit_project(?p);
        bad = 1;
    }
    or {
        val msg: str = R.unwrap_err[project.Project, outcome.Fail](pr).message;
        if (!ut_str_contains(msg, "dependency conflict")) { bad = 1; }
        if (!ut_str_contains(msg, "libx"))                { bad = 1; }
        if (!ut_str_contains(msg, "app -> foo"))          { bad = 1; }
        if (!ut_str_contains(msg, "app -> bar"))          { bad = 1; }
    }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.driver:dep_git_checkout_uses_parent_gitlink_authority" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    if (R.is_err[R.Void, str](driver.setup_registry(?s.registry))) { session.dnit(?s); ret 1; }

    val origin: str = "https://example.invalid/verified.git";
    var names: [1]str; names[0] = "main.mach";
    var texts: [1]str; texts[0] = "fun main() i32 { ret 0; }\n";
    val root_r: R.Result[str, str] = ut_scaffold_m(?alloc,
        ut_dep_root_git(?alloc, "verified", origin), ?names[0], ?texts[0], 1);
    if (R.is_err[str, str](root_r)) { session.dnit(?s); ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);
    val dep_root: str = ut_cc3(?alloc, root, "/", "dep/verified");
    val wr: O.Option[str] = ut_write_node(?alloc, dep_root,
        ut_lib_manifest(?alloc, "verified"), "lib.mach", "pub fun v() i32 { ret 1; }\n");
    if (O.is_some[str](wr) || !ut_git_repo(?alloc, dep_root, origin)) {
        fs.remove_all(?alloc, root); session.dnit(?s); ret 1;
    }
    val contained_link: str = ut_cc3(?alloc, dep_root, "/src/", "contained.mach");
    if (O.is_some[str](fs.symlink("lib.mach", contained_link))
        || !ut_git_commit_all(?alloc, dep_root, "add contained symlink")) {
        fs.remove_all(?alloc, root); session.dnit(?s); ret 1;
    }

    var tag: [4]str;
    tag[0] = "-C"; tag[1] = dep_root; tag[2] = "tag"; tag[3] = "v1";
    if (!ut_git(?alloc, ?tag[0], 4) || !ut_write_gitmodules(?alloc, root, "verified", origin)
        || !ut_git_repo(?alloc, root, "https://example.invalid/app.git")) {
        fs.remove_all(?alloc, root); session.dnit(?s); ret 1;
    }
    val initial_r: R.Result[str, str] = ut_git_ref(?alloc, dep_root, "refs/tags/v1");
    if (R.is_err[str, str](initial_r)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    val initial: str = R.unwrap_ok[str, str](initial_r);

    var bad: i32 = 0;
    val lib_path: str = ut_cc3(?alloc, dep_root, "/", "src/lib.mach");
    val child_index: str = ut_cc3(?alloc, dep_root, "/", ".git/index");
    val parent_index: str = ut_cc3(?alloc, root, "/", ".git/index");
    val child_before_r: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, child_index);
    val parent_before_r: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, parent_index);
    if (!ut_dep_build_ok(?s, root)) { bad = 1; }
    val child_after_r: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, child_index);
    val parent_after_r: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, parent_index);
    if (R.is_ok[Vector[u8], str](child_before_r) && R.is_ok[Vector[u8], str](child_after_r)
        && R.is_ok[Vector[u8], str](parent_before_r) && R.is_ok[Vector[u8], str](parent_after_r)) {
        var child_before: Vector[u8] = R.unwrap_ok[Vector[u8], str](child_before_r);
        var child_after: Vector[u8] = R.unwrap_ok[Vector[u8], str](child_after_r);
        var parent_before: Vector[u8] = R.unwrap_ok[Vector[u8], str](parent_before_r);
        var parent_after: Vector[u8] = R.unwrap_ok[Vector[u8], str](parent_after_r);
        if (child_before.len != child_after.len
            || !memory.raw_equal(child_before.data::ptr, child_after.data::ptr, child_before.len)
            || parent_before.len != parent_after.len
            || !memory.raw_equal(parent_before.data::ptr, parent_after.data::ptr, parent_before.len)) { bad = 1; }
        vector.dnit[u8](?child_before); vector.dnit[u8](?child_after);
        vector.dnit[u8](?parent_before); vector.dnit[u8](?parent_after);
    }
    or {
        bad = 1;
        if (R.is_ok[Vector[u8], str](child_before_r)) {
            var child_before: Vector[u8] = R.unwrap_ok[Vector[u8], str](child_before_r); vector.dnit[u8](?child_before);
        }
        if (R.is_ok[Vector[u8], str](child_after_r)) {
            var child_after: Vector[u8] = R.unwrap_ok[Vector[u8], str](child_after_r); vector.dnit[u8](?child_after);
        }
        if (R.is_ok[Vector[u8], str](parent_before_r)) {
            var parent_before: Vector[u8] = R.unwrap_ok[Vector[u8], str](parent_before_r); vector.dnit[u8](?parent_before);
        }
        if (R.is_ok[Vector[u8], str](parent_after_r)) {
            var parent_after: Vector[u8] = R.unwrap_ok[Vector[u8], str](parent_after_r); vector.dnit[u8](?parent_after);
        }
    }

    val moved_source: str = "pub fun v() i32 { ret 2; }\n";
    var add: [4]str;
    add[0] = "-C"; add[1] = dep_root; add[2] = "add"; add[3] = "-A";
    var commit: [5]str;
    commit[0] = "-C"; commit[1] = dep_root; commit[2] = "commit"; commit[3] = "-qm"; commit[4] = "moved";
    var moved_tag: [4]str;
    moved_tag[0] = "-C"; moved_tag[1] = dep_root; moved_tag[2] = "tag"; moved_tag[3] = "moved";
    if (O.is_some[str](fs.write_bytes(lib_path, moved_source, str_len(moved_source), 420))
        || !ut_git(?alloc, ?add[0], 4) || !ut_git(?alloc, ?commit[0], 5)
        || !ut_git(?alloc, ?moved_tag[0], 4)) { bad = 1; }
    val moved_r: R.Result[str, str] = ut_git_ref(?alloc, dep_root, "refs/tags/moved");
    if (R.is_err[str, str](moved_r)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    val moved: str = R.unwrap_ok[str, str](moved_r);
    var track: [6]str;
    track[0] = "-C"; track[1] = dep_root; track[2] = "update-ref";
    track[3] = "refs/remotes/origin/main"; track[4] = moved; track[5] = "";
    var reset: [5]str;
    reset[0] = "-C"; reset[1] = dep_root; reset[2] = "reset"; reset[3] = "--hard"; reset[4] = initial;
    if (!ut_git(?alloc, ?track[0], 5) || !ut_git(?alloc, ?reset[0], 5)
        || !ut_dep_build_ok(?s, root)) { bad = 1; }

    val root_manifest_path: str = ut_cc3(?alloc, root, "/", manifest.MANIFEST_FILE);
    val tag_manifest: str = ut_dep_root_git_ref(?alloc, "verified", origin, "tag/v1");
    if (O.is_some[str](fs.write_bytes(root_manifest_path, tag_manifest, str_len(tag_manifest), 420))
        || !ut_git_commit_all(?alloc, root, "select tag") || !ut_dep_build_ok(?s, root)) { bad = 1; }
    var force_tag: [6]str;
    force_tag[0] = "-C"; force_tag[1] = dep_root; force_tag[2] = "tag";
    force_tag[3] = "-f"; force_tag[4] = "v1"; force_tag[5] = moved;
    if (!ut_git(?alloc, ?force_tag[0], 6) || !ut_dep_build_ok(?s, root)) { bad = 1; }
    force_tag[5] = initial;
    if (!ut_git(?alloc, ?force_tag[0], 6)) { bad = 1; }

    val initial_commit_ref: str = ut_cc3(?alloc, "commit/", initial, "");
    val initial_commit_manifest: str = ut_dep_root_git_ref(?alloc, "verified", origin, initial_commit_ref);
    if (O.is_some[str](fs.write_bytes(root_manifest_path, initial_commit_manifest, str_len(initial_commit_manifest), 420))
        || !ut_git_commit_all(?alloc, root, "select commit") || !ut_dep_build_ok(?s, root)) { bad = 1; }
    val moved_commit_ref: str = ut_cc3(?alloc, "commit/", moved, "");
    val moved_commit_manifest: str = ut_dep_root_git_ref(?alloc, "verified", origin, moved_commit_ref);
    if (O.is_some[str](fs.write_bytes(root_manifest_path, moved_commit_manifest, str_len(moved_commit_manifest), 420))
        || !ut_git_commit_all(?alloc, root, "mismatch commit")
        || !ut_dep_build_fails(?s, root, "commit ref")) { bad = 1; }
    if (O.is_some[str](fs.write_bytes(root_manifest_path, initial_commit_manifest, str_len(initial_commit_manifest), 420))
        || !ut_git_commit_all(?alloc, root, "restore commit")) { bad = 1; }

    if (!ut_write_gitmodules(?alloc, root, "verified", "https://example.invalid/substituted.git")
        || !ut_git_commit_all(?alloc, root, "substitute metadata")
        || !ut_dep_build_fails(?s, root, ".gitmodules URL")) { bad = 1; }
    if (!ut_write_gitmodules(?alloc, root, "verified", origin)
        || !ut_git_commit_all(?alloc, root, "restore metadata")) { bad = 1; }

    val wrong_path_metadata: str = ut_cc3(?alloc, "[submodule \"dep/verified\"]\n\tpath = dep/not-verified\n\turl = ", origin, "\n");
    val gitmodules_path: str = ut_cc3(?alloc, root, "/", ".gitmodules");
    if (O.is_some[str](fs.write_bytes(gitmodules_path, wrong_path_metadata, str_len(wrong_path_metadata), 420))
        || !ut_git_commit_all(?alloc, root, "move dependency mapping")
        || !ut_dep_build_fails(?s, root, ".gitmodules path")) { bad = 1; }
    if (!ut_write_gitmodules(?alloc, root, "verified", origin)
        || !ut_git_commit_all(?alloc, root, "restore dependency mapping")) { bad = 1; }

    var mirror_origin: [6]str;
    mirror_origin[0] = "-C"; mirror_origin[1] = dep_root; mirror_origin[2] = "remote";
    mirror_origin[3] = "set-url"; mirror_origin[4] = "origin"; mirror_origin[5] = "https://example.invalid/verified";
    if (!ut_git(?alloc, ?mirror_origin[0], 6) || !ut_dep_build_ok(?s, root)) { bad = 1; }
    mirror_origin[5] = "https://mirror.example.invalid/elsewhere/verified.git";
    if (!ut_git(?alloc, ?mirror_origin[0], 6) || !ut_dep_build_ok(?s, root)) { bad = 1; }
    mirror_origin[5] = origin;
    if (!ut_git(?alloc, ?mirror_origin[0], 6)) { bad = 1; }

    val dirty_path: str = ut_cc3(?alloc, dep_root, "/", "untracked.txt");
    val dirty_write: O.Option[str] = fs.write_bytes(dirty_path, "dirty\n", 6, 420);
    if (O.is_some[str](dirty_write) || !ut_dep_build_fails(?s, root, "checkout is dirty")) { bad = 1; }
    if (O.is_some[str](fs.remove_file(dirty_path))) { bad = 1; }

    reset[4] = moved;
    if (!ut_git(?alloc, ?reset[0], 5) || !ut_dep_build_fails(?s, root, "HEAD mismatch")) { bad = 1; }
    reset[4] = initial;
    if (!ut_git(?alloc, ?reset[0], 5)) { bad = 1; }

    val branch_manifest: str = ut_dep_root_git(?alloc, "verified", origin);
    if (O.is_some[str](fs.write_bytes(root_manifest_path, branch_manifest, str_len(branch_manifest), 420))
        || !ut_git_commit_all(?alloc, root, "restore branch policy")) { bad = 1; }

    var link_index: [8]str;
    link_index[0] = "-C"; link_index[1] = root; link_index[2] = "update-index";
    link_index[3] = "--add"; link_index[4] = "--cacheinfo"; link_index[5] = "160000";
    link_index[6] = moved; link_index[7] = "dep/verified";
    if (!ut_git(?alloc, ?link_index[0], 8) || !ut_dep_build_fails(?s, root, "HEAD mismatch")) { bad = 1; }
    link_index[6] = initial;
    if (!ut_git(?alloc, ?link_index[0], 8)) { bad = 1; }

    link_index[6] = moved;
    var parent_commit: [5]str;
    parent_commit[0] = "-C"; parent_commit[1] = root; parent_commit[2] = "commit";
    parent_commit[3] = "-qm"; parent_commit[4] = "move gitlink";
    if (!ut_git(?alloc, ?link_index[0], 8) || !ut_git(?alloc, ?parent_commit[0], 5)
        || !ut_dep_build_fails(?s, root, "HEAD mismatch")) { bad = 1; }
    link_index[6] = initial;
    parent_commit[4] = "restore gitlink";
    if (!ut_git(?alloc, ?link_index[0], 8) || !ut_git(?alloc, ?parent_commit[0], 5)) { bad = 1; }

    val child_git: str = ut_cc3(?alloc, dep_root, "/", ".git");
    val dep_parent: str = ut_cc3(?alloc, root, "/", "dep");
    if (O.is_some[str](fs.remove_all(?alloc, child_git))
        || !ut_git_repo(?alloc, dep_parent, origin)
        || !ut_dep_build_fails(?s, root, "repository root")) { bad = 1; }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.driver:path_dependency_verifies_against_the_index" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    if (R.is_err[R.Void, str](driver.setup_registry(?s.registry))) { session.dnit(?s); ret 1; }

    var root_names: [1]str; root_names[0] = "main.mach";
    var root_texts: [1]str; root_texts[0] = "fun main() i32 { ret 0; }\n";
    val root_manifest: str = ut_dep_root_one(?alloc, "snapshot", "../source-not-read");
    val root_r: R.Result[str, str] = ut_scaffold_m(?alloc, root_manifest, ?root_names[0], ?root_texts[0], 1);
    if (R.is_err[str, str](root_r)) { session.dnit(?s); ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);
    val dep_root: str = ut_cc3(?alloc, root, "/", "dep/snapshot");
    var dep_names: [2]str; dep_names[0] = "alpha.mach"; dep_names[1] = "beta.mach";
    var dep_texts: [2]str; dep_texts[0] = "pub fun alpha() i32 { ret 1; }\n"; dep_texts[1] = "pub fun beta() i32 { ret 2; }\n";
    if (O.is_some[str](ut_write_node_multi(?alloc, dep_root, ut_manifest_multi(), ?dep_names[0], ?dep_texts[0], 2))
        || !ut_git_repo(?alloc, root, "https://example.invalid/app.git")) {
        fs.remove_all(?alloc, root); session.dnit(?s); ret 1;
    }

    var bad: i32 = 0;
    val first_r: R.Result[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
    if (R.is_err[project.Project, outcome.Fail](first_r)) { bad = 1; }
    or {
        var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](first_r);
        if (p.config.dep_count != 1 || p.config.deps[0].project_module != intern.STR_NIL) { bad = 1; }
        val content_opt: O.Option[str] = intern.lookup(?s.interner, p.config.deps[0].content);
        val root_opt: O.Option[str] = intern.lookup(?s.interner, p.config.deps[0].vendor_root);
        if (O.is_none[str](content_opt) || O.is_none[str](root_opt)
            || str_equals(O.unwrap[str](content_opt), O.unwrap[str](root_opt))) { bad = 1; }
        project.dnit_project(?p);
    }

    val changed: str = ut_cc3(?alloc, dep_root, "/src/", "alpha.mach");
    val worktree_changed: str = "pub fun alpha() i32 { ret 3; }\n";
    if (O.is_some[str](fs.write_bytes(changed, worktree_changed, str_len(worktree_changed), 420))
        || !ut_dep_build_fails(?s, root, "does not match what is staged")) { bad = 1; }
    var restore: [5]str;
    restore[0] = "-C"; restore[1] = root; restore[2] = "restore"; restore[3] = "--"; restore[4] = "dep/snapshot";
    if (!ut_git(?alloc, ?restore[0], 5)) { bad = 1; }

    var stage: [5]str;
    stage[0] = "-C"; stage[1] = root; stage[2] = "add"; stage[3] = "--"; stage[4] = "dep/snapshot";
    val staged_changed: str = "pub fun alpha() i32 { ret 4; }\n";
    if (O.is_some[str](fs.write_bytes(changed, staged_changed, str_len(staged_changed), 420))
        || !ut_git(?alloc, ?stage[0], 5)
        || !ut_dep_build_ok(?s, root)) { bad = 1; }
    var restore_staged: [6]str;
    restore_staged[0] = "-C"; restore_staged[1] = root; restore_staged[2] = "restore";
    restore_staged[3] = "--staged"; restore_staged[4] = "--"; restore_staged[5] = "dep/snapshot";
    if (!ut_git(?alloc, ?restore_staged[0], 6) || !ut_git(?alloc, ?restore[0], 5)) { bad = 1; }

    val untracked: str = ut_cc3(?alloc, dep_root, "/", "untracked.txt");
    if (O.is_some[str](fs.write_bytes(untracked, "untracked\n", 10, 420))
        || !ut_dep_build_fails(?s, root, "does not match what is staged")
        || O.is_some[str](fs.remove_file(untracked))) { bad = 1; }

    val root_manifest_path: str = ut_cc3(?alloc, root, "/", manifest.MANIFEST_FILE);
    val dirty_manifest: str = ut_cc3(?alloc, root_manifest, "\n", "");
    if (O.is_some[str](fs.write_bytes(root_manifest_path, dirty_manifest, str_len(dirty_manifest), 420))
        || !ut_dep_build_ok(?s, root)) { bad = 1; }
    var restore_manifest: [5]str;
    restore_manifest[0] = "-C"; restore_manifest[1] = root; restore_manifest[2] = "restore";
    restore_manifest[3] = "--"; restore_manifest[4] = manifest.MANIFEST_FILE;
    if (!ut_git(?alloc, ?restore_manifest[0], 5) || !ut_dep_build_ok(?s, root)) { bad = 1; }

    val ignore_path: str = ut_cc3(?alloc, dep_root, "/", ".gitignore");
    val ignored_dir: str = ut_cc3(?alloc, dep_root, "/", "out");
    val ignored_file: str = ut_cc3(?alloc, ignored_dir, "/", "generated.mach");
    if (O.is_some[str](fs.write_bytes(ignore_path, "out/\n", 5, 420))
        || !ut_git_commit_all(?alloc, root, "ignore dependency outputs")
        || O.is_some[str](fs.create_dir_all(?alloc, ignored_dir, 493))
        || O.is_some[str](fs.write_bytes(ignored_file, "generated\n", 10, 420))
        || !ut_dep_build_ok(?s, root)) { bad = 1; }

    val injected_git: str = ut_cc3(?alloc, dep_root, "/", ".git");
    if (O.is_some[str](fs.write_bytes(injected_git, "ignored\n", 8, 420))
        || !ut_dep_build_fails(?s, root, "forbidden repository metadata")
        || O.is_some[str](fs.remove_file(injected_git))
        || !ut_dep_build_ok(?s, root)) { bad = 1; }

    val contained_link: str = ut_cc3(?alloc, dep_root, "/src/", "contained.mach");
    if (O.is_some[str](fs.symlink("alpha.mach", contained_link))
        || !ut_git_commit_all(?alloc, root, "add a contained dependency symlink")
        || !ut_dep_build_fails(?s, root, "must contain no symlinks")) { bad = 1; }

    if (O.is_some[str](fs.remove_file(contained_link))
        || O.is_some[str](fs.symlink("/etc/passwd", contained_link))
        || !ut_git_commit_all(?alloc, root, "add an absolute dependency symlink")
        || !ut_dep_build_fails(?s, root, "must contain no symlinks")) { bad = 1; }

    if (O.is_some[str](fs.remove_file(contained_link))
        || O.is_some[str](fs.symlink("../../outside", contained_link))
        || !ut_git_commit_all(?alloc, root, "add an escaping dependency symlink")
        || !ut_dep_build_fails(?s, root, "must contain no symlinks")) { bad = 1; }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.driver:path_package_resolves_nested_git_dependency" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    if (R.is_err[R.Void, str](driver.setup_registry(?s.registry))) { session.dnit(?s); ret 1; }

    val source: str = "https://example.invalid/b.git";
    var names: [1]str; names[0] = "main.mach";
    var texts: [1]str; texts[0] = "fun main() i32 { ret 0; }\n";
    val root_r: R.Result[str, str] = ut_scaffold_m(?alloc,
        ut_dep_root_one(?alloc, "a", "../external-not-read"), ?names[0], ?texts[0], 1);
    if (R.is_err[str, str](root_r)) { session.dnit(?s); ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);
    val a_root: str = ut_cc3(?alloc, root, "/", "dep/a");
    val b_root: str = ut_cc3(?alloc, root, "/", "dep/b");
    val a_manifest: str = ut_cc3(?alloc, ut_lib_manifest(?alloc, "a"),
        "\n[dep.b]\ngit = \"https://example.invalid/b.git\"\nref = \"branch/main\"\n", "");
    if (O.is_some[str](ut_write_node(?alloc, b_root, ut_lib_manifest(?alloc, "b"),
            "lib.mach", "pub fun b() i32 { ret 2; }\n"))
        || !ut_git_repo(?alloc, b_root, source)
        || O.is_some[str](ut_write_node(?alloc, a_root, a_manifest,
            "lib.mach", "pub fun a() i32 { ret 1; }\n"))
        || !ut_write_gitmodules(?alloc, a_root, "b", source)
        || !ut_write_gitmodules(?alloc, root, "b", source)
        || !ut_git_repo(?alloc, root, "https://example.invalid/app.git")) {
        fs.remove_all(?alloc, root); session.dnit(?s); ret 1;
    }
    var bad: i32 = 0;
    val pr: R.Result[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
    if (R.is_err[project.Project, outcome.Fail](pr)) { bad = 1; }
    or {
        var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);
        if (p.config.dep_count != 2) { bad = 1; }
        project.dnit_project(?p);
    }
    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.driver:dep_transitive_gitlink_resolves_flat_and_the_nested_placeholder_is_ignored" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    if (R.is_err[R.Void, str](driver.setup_registry(?s.registry))) { session.dnit(?s); ret 1; }
    val a_source: str = "https://example.invalid/a.git";
    val b_source: str = "https://example.invalid/b.git";
    var names: [1]str; names[0] = "main.mach";
    var texts: [1]str; texts[0] = "fun main() i32 { ret 0; }\n";
    val root_r: R.Result[str, str] = ut_scaffold_m(?alloc,
        ut_dep_root_git(?alloc, "a", a_source), ?names[0], ?texts[0], 1);
    if (R.is_err[str, str](root_r)) { session.dnit(?s); ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);
    val a_root: str = ut_cc3(?alloc, root, "/", "dep/a");
    val b_root: str = ut_cc3(?alloc, root, "/", "dep/b");
    val nested_placeholder: str = ut_cc3(?alloc, a_root, "/", "dep/b");
    val a_manifest: str = ut_cc3(?alloc, ut_lib_manifest(?alloc, "a"),
        "\n[dep.b]\ngit = \"https://example.invalid/b.git\"\nref = \"branch/main\"\n", "");
    if (O.is_some[str](ut_write_node(?alloc, b_root, ut_lib_manifest(?alloc, "b"),
            "lib.mach", "pub fun b() i32 { ret 2; }\n"))
        || !ut_git_repo(?alloc, b_root, b_source)
        || O.is_some[str](ut_write_node(?alloc, a_root, a_manifest,
            "lib.mach", "pub fun a() i32 { ret 1; }\n"))
        || !ut_write_gitmodules(?alloc, a_root, "b", b_source)
        || O.is_some[str](fs.create_dir_all(?alloc, nested_placeholder, 493))
        || !ut_git_repo(?alloc, a_root, a_source)
        || !ut_write_gitmodules2(?alloc, root, "a", a_source, "b", b_source)
        || !ut_git_repo(?alloc, root, "https://example.invalid/app.git")) {
        fs.remove_all(?alloc, root); session.dnit(?s); ret 1;
    }
    var bad: i32 = 0;
    val pr: R.Result[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
    if (R.is_err[project.Project, outcome.Fail](pr)) { bad = 1; }
    or {
        var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);
        if (p.config.dep_count != 2) { bad = 1; }
        var saw_flat_b: bool = false;
        var i: u32 = 0;
        for (i < p.config.dep_count) {
            val vr_opt: O.Option[str] = intern.lookup(?s.interner, p.config.deps[i].vendor_root);
            if (O.is_some[str](vr_opt)) {
                if (ut_native_path_is(?alloc, O.unwrap[str](vr_opt), root, "dep/a/dep/b")) { bad = 1; }
                if (ut_native_path_is(?alloc, O.unwrap[str](vr_opt), root, "dep/b")) { saw_flat_b = true; }
            }
            i = i + 1;
        }
        if (!saw_flat_b) { bad = 1; }
        project.dnit_project(?p);
    }
    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}
fun ut_dep_root_override(nested: bool, root_git: bool, child_git: bool, root_first: bool) i32 {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    fin { session.dnit(?s); }
    if (R.is_err[R.Void, str](driver.setup_registry(?s.registry))) { ret 1; }

    val a_decl: str = "\n[dep.a]\npath = \"./vendor/a\"\n";
    val initial_manifest: str = ut_dep_root_one(?alloc, "a", "./vendor/a");
    var names: [1]str; names[0] = "main.mach";
    var texts: [1]str; texts[0] = "use a.lib;\nfun main() i32 { ret lib.v(); }\n";
    val outer_r: R.Result[str, str] = ut_scaffold_m(?alloc, initial_manifest, ?names[0], ?texts[0], 1);
    if (R.is_err[str, str](outer_r)) { ret 1; }
    val outer: str = R.unwrap_ok[str, str](outer_r);
    fin { fs.remove_all(?alloc, outer); }
    var root: str = outer;
    if (nested) {
        root = ut_cc3(?alloc, outer, "/", "project");
        if (O.is_some[str](ut_write_node(?alloc, root, initial_manifest, "main.mach", texts[0]))) { ret 2; }
    }

    val a_root: str = ut_cc3(?alloc, root, "/", "dep/a");
    val b_root: str = ut_cc3(?alloc, root, "/", "dep/b");
    var child_decl: str = "\n[dep.b]\npath = \"../transitive-b\"\n";
    if (child_git) {
        child_decl = "\n[dep.b]\ngit = \"https://example.invalid/transitive-b.git\"\nref = \"commit/0000000000000000000000000000000000000000\"\n";
    }
    val a_manifest: str = ut_cc3(?alloc, ut_lib_manifest(?alloc, "a"), child_decl, "");
    if (O.is_some[str](ut_write_node(?alloc, a_root, a_manifest, "lib.mach",
            "use b.lib;\npub fun v() i32 { ret lib.v(); }\n"))
        || O.is_some[str](ut_write_node(?alloc, b_root, ut_lib_manifest(?alloc, "b"),
            "lib.mach", "pub fun v() i32 { ret 42; }\n"))) { ret 3; }

    val root_source: str = "https://example.invalid/root-b.git";
    var root_ref: str = "";
    var b_decl: str = "\n[dep.b]\npath = \"./vendor/b\"\n";
    var root_manifest: str = ut_dep_root_one(?alloc, "b", "./vendor/b");
    var expected_source: str = "path ./vendor/b";
    if (root_git) {
        if (!ut_git_repo(?alloc, b_root, root_source)
            || !ut_write_gitmodules(?alloc, root, "b", root_source)) { ret 4; }
        val head_r: R.Result[str, str] = ut_git_ref(?alloc, b_root, "refs/remotes/origin/main");
        if (R.is_err[str, str](head_r)) { ret 5; }
        root_ref = ut_cc3(?alloc, "commit/", R.unwrap_ok[str, str](head_r), "");
        b_decl = ut_cc3(?alloc, "\n[dep.b]\ngit = \"https://example.invalid/root-b.git\"\nref = \"", root_ref, "\"\n");
        root_manifest = ut_dep_root_git_ref(?alloc, "b", root_source, root_ref);
        expected_source = "git https://example.invalid/root-b.git";
    }
    if (root_first) { root_manifest = ut_cc3(?alloc, root_manifest, a_decl, ""); }
    or { root_manifest = ut_cc3(?alloc, initial_manifest, b_decl, ""); }
    val root_manifest_path: str = ut_cc3(?alloc, root, "/", manifest.MANIFEST_FILE);
    if (O.is_some[str](fs.write_bytes(root_manifest_path, root_manifest, str_len(root_manifest), 420))
        || !ut_git_repo(?alloc, outer, "https://example.invalid/app.git")) { ret 6; }

    val pr: R.Result[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
    if (R.is_err[project.Project, outcome.Fail](pr)) { ret 7; }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);
    var bad: i32 = 0;
    if (p.config.dep_count != 2) { bad = 8; }
    val a_id: intern.StrId = project.intern_unwrap(?s.interner, "a");
    val b_id: intern.StrId = project.intern_unwrap(?s.interner, "b");
    var saw_a: bool = false;
    var saw_b: bool = false;
    var i: u32 = 0;
    for (i < p.config.dep_count) {
        val entry: *project.DepEntry = ?p.config.deps[i];
        if (entry.project_id == a_id) {
            saw_a = true;
            if (entry.direct_count != 1 || entry.direct[0] != b_id) { bad = 9; }
        }
        if (entry.project_id == b_id) {
            saw_b = true;
            if (!entry.root_declared || entry.source != project.intern_unwrap(?s.interner, expected_source)) { bad = 10; }
            if (root_git && entry.ref != project.intern_unwrap(?s.interner, root_ref)) { bad = 11; }
            var expected_chain: str = "app -> a -> b";
            if (root_first) { expected_chain = "app -> b"; }
            if (entry.chain != project.intern_unwrap(?s.interner, expected_chain)) { bad = 12; }
        }
        i = i + 1;
    }
    if (!saw_a || !saw_b) { bad = 13; }
    project.dnit_project(?p);

    if (root_git) {
        val b_source: str = ut_cc3(?alloc, b_root, "/src/", "lib.mach");
        val dirty: str = "pub fun v() i32 { ret 7; }\n";
        if (O.is_some[str](fs.write_bytes(b_source, dirty, str_len(dirty), 420))) { ret 14; }
        if (!ut_dep_build_fails(?s, root, "checkout is dirty")) { bad = 15; }
    }
    ret bad;
}

