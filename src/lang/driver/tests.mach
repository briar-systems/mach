test "mach.lang.driver:reload_rebuild_dedup_sources_by_path" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    val rr: R.Result[R.Void, str] = driver.setup_registry(?s.registry);
    if (R.is_err[R.Void, str](rr)) { session.dnit(?s); ret 1; }

    var names: [2]str;
    names[0] = "main.mach"; names[1] = "a.mach";
    var texts: [2]str;
    texts[0] = "use uniontest.a;\n\nfun main() i32 { ret 0; }\n";
    texts[1] = "pub fun fa() i32 { ret 1; }\n";

    val root_r: R.Result[str, str] = ut_scaffold(?alloc, ?names[0], ?texts[0], 2);
    if (R.is_err[str, str](root_r)) { session.dnit(?s); ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);

    var bad: i32 = 0;

    val p1r: R.Result[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
    if (R.is_err[project.Project, outcome.Fail](p1r)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    var p1: project.Project = R.unwrap_ok[project.Project, outcome.Fail](p1r);
    if (!ut_has(?p1, ?s, "uniontest.main")) { bad = 1; }
    or (!ut_has(?p1, ?s, "uniontest.a"))    { bad = 1; }
    val len1: usize = s.sources.len;
    if (len1 == 0) { bad = 1; }
    project.dnit_project(?p1);

    val src_dir: str = ut_cc3(?alloc, root, "/", "src");
    val a_path: str = ut_cc3(?alloc, src_dir, "/", "a.mach");
    val new_a: str = "pub fun fa() i32 { ret 2; }\n";
    val wr: O.Option[str] = fs.write_bytes(a_path, new_a, str_len(new_a), 420);
    if (O.is_some[str](wr)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }

    val p2r: R.Result[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
    if (R.is_err[project.Project, outcome.Fail](p2r)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    var p2: project.Project = R.unwrap_ok[project.Project, outcome.Fail](p2r);
    if (!ut_has(?p2, ?s, "uniontest.main")) { bad = 1; }
    or (!ut_has(?p2, ?s, "uniontest.a"))    { bad = 1; }
    val len2: usize = s.sources.len;

    if (len2 != len1) { bad = 1; }

    project.dnit_project(?p2);
    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.driver:incremental_qparse_ast_reuse_and_reparse" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    val rr: R.Result[R.Void, str] = driver.setup_registry(?s.registry);
    if (R.is_err[R.Void, str](rr)) { session.dnit(?s); ret 1; }

    var names: [2]str;
    names[0] = "main.mach"; names[1] = "a.mach";
    var texts: [2]str;
    texts[0] = "use uniontest.a;\n\nfun main() i32 { ret 0; }\n";
    texts[1] = "pub fun fa() i32 { ret 1; }\n";

    val root_r: R.Result[str, str] = ut_scaffold(?alloc, ?names[0], ?texts[0], 2);
    if (R.is_err[str, str](root_r)) { session.dnit(?s); ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);

    var bad: i32 = 0;

    val p1r: R.Result[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
    if (R.is_err[project.Project, outcome.Fail](p1r)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    var p1: project.Project = R.unwrap_ok[project.Project, outcome.Fail](p1r);
    val main1: *ast.Ast = ut_ast(?p1, ?s, "uniontest.main");
    val a1:    *ast.Ast = ut_ast(?p1, ?s, "uniontest.a");
    if (main1 == nil || a1 == nil) { bad = 1; }
    project.dnit_project(?p1);

    val p2r: R.Result[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
    if (R.is_err[project.Project, outcome.Fail](p2r)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    var p2: project.Project = R.unwrap_ok[project.Project, outcome.Fail](p2r);
    if (ut_ast(?p2, ?s, "uniontest.main") != main1) { bad = 1; }
    if (ut_ast(?p2, ?s, "uniontest.a")    != a1)    { bad = 1; }
    project.dnit_project(?p2);

    val src_dir: str = ut_cc3(?alloc, root, "/", "src");
    val a_path: str = ut_cc3(?alloc, src_dir, "/", "a.mach");
    val new_a: str = "pub fun fa() i32 { ret 2; }\n";
    val wr: O.Option[str] = fs.write_bytes(a_path, new_a, str_len(new_a), 420);
    if (O.is_some[str](wr)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }

    val p3r: R.Result[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
    if (R.is_err[project.Project, outcome.Fail](p3r)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    var p3: project.Project = R.unwrap_ok[project.Project, outcome.Fail](p3r);
    if (ut_ast(?p3, ?s, "uniontest.main") != main1) { bad = 1; }
    if (ut_ast(?p3, ?s, "uniontest.a")    == a1)    { bad = 1; }
    project.dnit_project(?p3);

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

fun ut_opt_str_eq(a: str, b: str) bool {
    if (a == nil && b == nil) { ret true; }
    if (a == nil || b == nil) { ret false; }
    ret str_equals(a, b);
}

fun ut_diag_list_eq(x: *diagnostic.DiagnosticStore, y: *diagnostic.DiagnosticStore) bool {
    if (diagnostic.len(x) != diagnostic.len(y)) { ret false; }
    var i: usize = 0;
    for (i < diagnostic.len(x)) {
        val dx: *diagnostic.Diagnostic = ?x.items.data[i];
        val dy: *diagnostic.Diagnostic = ?y.items.data[i];
        if (dx.severity != dy.severity)               { ret false; }
        if (dx.loc.file_id != dy.loc.file_id)         { ret false; }
        if (dx.loc.span.offset != dy.loc.span.offset) { ret false; }
        if (dx.loc.span.len != dy.loc.span.len)       { ret false; }
        if (!ut_opt_str_eq(dx.message, dy.message))   { ret false; }
        if (dx.children.len != dy.children.len)       { ret false; }
        var c: usize = 0;
        for (c < dx.children.len) {
            if (dx.children.data[c].kind != dy.children.data[c].kind)                     { ret false; }
            if (!ut_opt_str_eq(dx.children.data[c].text, dy.children.data[c].text))       { ret false; }
            c = c + 1;
        }
        if (dx.related.len != dy.related.len)         { ret false; }
        var r: usize = 0;
        for (r < dx.related.len) {
            val rx: *diagnostic.Related = ?dx.related.data[r];
            val ry: *diagnostic.Related = ?dy.related.data[r];
            if (rx.loc.file_id != ry.loc.file_id)         { ret false; }
            if (rx.loc.span.offset != ry.loc.span.offset) { ret false; }
            if (rx.loc.span.len != ry.loc.span.len)       { ret false; }
            if (!ut_opt_str_eq(rx.label, ry.label))       { ret false; }
            r = r + 1;
        }
        i = i + 1;
    }
    ret true;
}

test "mach.lang.driver:incremental_reused_phase_replays_diagnostics" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    val rr: R.Result[R.Void, str] = driver.setup_registry(?s.registry);
    if (R.is_err[R.Void, str](rr)) { session.dnit(?s); ret 1; }

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "fun dup() i32 { ret 1; }\nfun dup() i32 { ret 2; }\n\nfun main() i32 { ret 0; }\n";

    val root_r: R.Result[str, str] = ut_scaffold(?alloc, ?names[0], ?texts[0], 1);
    if (R.is_err[str, str](root_r)) { session.dnit(?s); ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);

    var bad: i32 = 0;

    val p1r: R.Result[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
    if (R.is_err[project.Project, outcome.Fail](p1r)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    var p1: project.Project = R.unwrap_ok[project.Project, outcome.Fail](p1r);

    val cold_r: R.Result[*diagnostic.DiagnosticStore, str] = diagnostic.snapshot_from(?s.diags, 0, ?alloc);
    if (R.is_err[*diagnostic.DiagnosticStore, str](cold_r)) { project.dnit_project(?p1); fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    val cold: *diagnostic.DiagnosticStore = R.unwrap_ok[*diagnostic.DiagnosticStore, str](cold_r);
    if (diagnostic.len(cold) == 0) { bad = 1; }
    project.dnit_project(?p1);

    diagnostic.store_dnit(?s.diags);
    s.diags = diagnostic.store_init(?alloc);

    val p2r: R.Result[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
    if (R.is_err[project.Project, outcome.Fail](p2r)) {
        diagnostic.store_dnit(cold);
        A.deallocate[diagnostic.DiagnosticStore](?alloc, cold, 1::usize);
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var p2: project.Project = R.unwrap_ok[project.Project, outcome.Fail](p2r);
    if (!ut_diag_list_eq(?s.diags, cold)) { bad = 1; }
    project.dnit_project(?p2);

    diagnostic.store_dnit(cold);
    A.deallocate[diagnostic.DiagnosticStore](?alloc, cold, 1::usize);
    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.driver:incremental_overlay_reparses_exactly_overlaid_module" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    val rr: R.Result[R.Void, str] = driver.setup_registry(?s.registry);
    if (R.is_err[R.Void, str](rr)) { session.dnit(?s); ret 1; }

    var names: [2]str;
    names[0] = "main.mach"; names[1] = "a.mach";
    var texts: [2]str;
    texts[0] = "use uniontest.a;\n\nfun main() i32 { ret 0; }\n";
    texts[1] = "pub fun fa() i32 { ret 1; }\n";

    val root_r: R.Result[str, str] = ut_scaffold(?alloc, ?names[0], ?texts[0], 2);
    if (R.is_err[str, str](root_r)) { session.dnit(?s); ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);

    var bad: i32 = 0;

    val p1r: R.Result[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
    if (R.is_err[project.Project, outcome.Fail](p1r)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    var p1: project.Project = R.unwrap_ok[project.Project, outcome.Fail](p1r);
    val main1: *ast.Ast = ut_ast(?p1, ?s, "uniontest.main");
    val a1:    *ast.Ast = ut_ast(?p1, ?s, "uniontest.a");
    if (main1 == nil || a1 == nil) { bad = 1; }
    val a_mid: session.ModuleId = ut_mid(?p1, ?s, "uniontest.a");
    if (a_mid == session.MODULE_NIL) { fs.remove_all(?alloc, root); project.dnit_project(?p1); session.dnit(?s); ret 1; }
    val a_fid: src.FileId = p1.modules[a_mid::u32].file_id;
    project.dnit_project(?p1);

    val sf_opt: O.Option[*src.SourceFile] = src.get(?s.sources, a_fid);
    if (O.is_none[*src.SourceFile](sf_opt)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    val a_path: str = O.unwrap[*src.SourceFile](sf_opt).path;

    val ov_text: str = "pub fun fa() i32 { ret 2; }\n";
    if (R.is_err[R.Void, str](session.set_overlay(?s, a_path, ov_text))) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    val p2r: R.Result[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
    if (R.is_err[project.Project, outcome.Fail](p2r)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    var p2: project.Project = R.unwrap_ok[project.Project, outcome.Fail](p2r);
    if (ut_ast(?p2, ?s, "uniontest.main") != main1) { bad = 1; }
    if (ut_ast(?p2, ?s, "uniontest.a")    == a1)    { bad = 1; }
    val a2: *ast.Ast = ut_ast(?p2, ?s, "uniontest.a");
    project.dnit_project(?p2);

    if (R.is_err[R.Void, str](session.set_overlay(?s, a_path, ov_text))) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    val p3r: R.Result[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
    if (R.is_err[project.Project, outcome.Fail](p3r)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    var p3: project.Project = R.unwrap_ok[project.Project, outcome.Fail](p3r);
    if (ut_ast(?p3, ?s, "uniontest.main") != main1) { bad = 1; }
    if (ut_ast(?p3, ?s, "uniontest.a")    != a2)    { bad = 1; }
    project.dnit_project(?p3);

    if (!session.clear_overlay(?s, a_path)) { bad = 1; }
    val p4r: R.Result[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
    if (R.is_err[project.Project, outcome.Fail](p4r)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    var p4: project.Project = R.unwrap_ok[project.Project, outcome.Fail](p4r);
    if (ut_ast(?p4, ?s, "uniontest.main") != main1) { bad = 1; }
    if (ut_ast(?p4, ?s, "uniontest.a")    == a2)    { bad = 1; }
    project.dnit_project(?p4);

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.driver:incremental_stable_identity_across_reshape" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    val rr: R.Result[R.Void, str] = driver.setup_registry(?s.registry);
    if (R.is_err[R.Void, str](rr)) { session.dnit(?s); ret 1; }

    var names: [3]str;
    names[0] = "main.mach"; names[1] = "a.mach"; names[2] = "b.mach";
    var texts: [3]str;
    texts[0] = "use uniontest.a;\nuse uniontest.b;\n\nfun main() i32 { ret 0; }\n";
    texts[1] = "pub fun fa() i32 { ret 1; }\n";
    texts[2] = "pub fun fb() i32 { ret 2; }\n";

    val root_r: R.Result[str, str] = ut_scaffold(?alloc, ?names[0], ?texts[0], 3);
    if (R.is_err[str, str](root_r)) { session.dnit(?s); ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);

    var bad: i32 = 0;

    val p1r: R.Result[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
    if (R.is_err[project.Project, outcome.Fail](p1r)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    var p1: project.Project = R.unwrap_ok[project.Project, outcome.Fail](p1r);
    val mid_a1: session.ModuleId = ut_mid(?p1, ?s, "uniontest.a");
    val mid_b1: session.ModuleId = ut_mid(?p1, ?s, "uniontest.b");
    val sid_main1: session.StableModuleId = ut_stable(?p1, ?s, "uniontest.main");
    val sid_a1: session.StableModuleId = ut_stable(?p1, ?s, "uniontest.a");
    val sid_b1: session.StableModuleId = ut_stable(?p1, ?s, "uniontest.b");
    if (mid_a1 == session.MODULE_NIL || mid_b1 == session.MODULE_NIL)               { bad = 1; }
    if (sid_a1 == session.STABLE_MODULE_NIL || sid_b1 == session.STABLE_MODULE_NIL) { bad = 1; }
    project.dnit_project(?p1);

    val src_dir: str = ut_cc3(?alloc, root, "/", "src");
    val main_path: str = ut_cc3(?alloc, src_dir, "/", "main.mach");
    val new_main: str = "use uniontest.b;\nuse uniontest.a;\n\nfun main() i32 { ret 0; }\n";
    val wr: O.Option[str] = fs.write_bytes(main_path, new_main, str_len(new_main), 420);
    if (O.is_some[str](wr)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }

    val p2r: R.Result[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
    if (R.is_err[project.Project, outcome.Fail](p2r)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    var p2: project.Project = R.unwrap_ok[project.Project, outcome.Fail](p2r);
    val mid_a2: session.ModuleId = ut_mid(?p2, ?s, "uniontest.a");
    val mid_b2: session.ModuleId = ut_mid(?p2, ?s, "uniontest.b");
    val sid_main2: session.StableModuleId = ut_stable(?p2, ?s, "uniontest.main");
    val sid_a2: session.StableModuleId = ut_stable(?p2, ?s, "uniontest.a");
    val sid_b2: session.StableModuleId = ut_stable(?p2, ?s, "uniontest.b");

    if (mid_a1 == mid_a2 && mid_b1 == mid_b2) { bad = 1; }
    if (sid_main2 != sid_main1) { bad = 1; }
    if (sid_a2 != sid_a1)       { bad = 1; }
    if (sid_b2 != sid_b1)       { bad = 1; }
    project.dnit_project(?p2);

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.driver:incremental_qexports_firewalls_body_edit" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    val rr: R.Result[R.Void, str] = driver.setup_registry(?s.registry);
    if (R.is_err[R.Void, str](rr)) { session.dnit(?s); ret 1; }

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "pub fun f(a: i32) i32 { ret a; }\n";

    val root_r: R.Result[str, str] = ut_scaffold(?alloc, ?names[0], ?texts[0], 1);
    if (R.is_err[str, str](root_r)) { session.dnit(?s); ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);

    var bad: i32 = 0;

    val p1r: R.Result[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
    if (R.is_err[project.Project, outcome.Fail](p1r)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    var p1: project.Project = R.unwrap_ok[project.Project, outcome.Fail](p1r);
    val stable: session.StableModuleId = ut_stable(?p1, ?s, "uniontest.main");
    if (stable == session.STABLE_MODULE_NIL) { bad = 1; }
    val q1: R.Result[*query.QueryEntry, str] = query.peek(?s.queries, query.Q_EXPORTS, stable::u64);
    if (R.is_err[*query.QueryEntry, str](q1)) { project.dnit_project(?p1); fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    val ent1: *query.QueryEntry = R.unwrap_ok[*query.QueryEntry, str](q1);
    val lc1: query.Revision = ent1.last_changed;
    val len1: u32 = ent1.value_len;
    val fr: R.Result[*u8, str] = A.allocate[u8](?alloc, len1::usize);
    if (R.is_err[*u8, str](fr)) { project.dnit_project(?p1); fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    val fp1: *u8 = R.unwrap_ok[*u8, str](fr);
    memory.raw_copy(fp1::ptr, ent1.value::ptr, len1::usize);
    if (len1 == 0) { bad = 1; }
    project.dnit_project(?p1);

    val src_dir: str = ut_cc3(?alloc, root, "/", "src");
    val main_path: str = ut_cc3(?alloc, src_dir, "/", "main.mach");
    val body_edit: str = "pub fun f(a: i32) i32 { val t: i32 = a; ret t; }\n";
    val w2: O.Option[str] = fs.write_bytes(main_path, body_edit, str_len(body_edit), 420);
    if (O.is_some[str](w2)) { A.deallocate[u8](?alloc, fp1, len1::usize); fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }

    val p2r: R.Result[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
    if (R.is_err[project.Project, outcome.Fail](p2r)) { A.deallocate[u8](?alloc, fp1, len1::usize); fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    var p2: project.Project = R.unwrap_ok[project.Project, outcome.Fail](p2r);
    val q2: R.Result[*query.QueryEntry, str] = query.peek(?s.queries, query.Q_EXPORTS, stable::u64);
    if (R.is_err[*query.QueryEntry, str](q2)) { project.dnit_project(?p2); A.deallocate[u8](?alloc, fp1, len1::usize); fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    val ent2: *query.QueryEntry = R.unwrap_ok[*query.QueryEntry, str](q2);
    if (ent2.last_changed != lc1) { bad = 1; }
    if (ent2.value_len != len1) { bad = 1; }
    or (!memory.raw_equal(ent2.value::ptr, fp1::ptr, len1::usize)) { bad = 1; }
    project.dnit_project(?p2);

    val surf_edit: str = "pub fun f(a: i32) i32 { ret a; }\npub fun g() i32 { ret 0; }\n";
    val w3: O.Option[str] = fs.write_bytes(main_path, surf_edit, str_len(surf_edit), 420);
    if (O.is_some[str](w3)) { A.deallocate[u8](?alloc, fp1, len1::usize); fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }

    val p3r: R.Result[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
    if (R.is_err[project.Project, outcome.Fail](p3r)) { A.deallocate[u8](?alloc, fp1, len1::usize); fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    var p3: project.Project = R.unwrap_ok[project.Project, outcome.Fail](p3r);
    val q3: R.Result[*query.QueryEntry, str] = query.peek(?s.queries, query.Q_EXPORTS, stable::u64);
    if (R.is_err[*query.QueryEntry, str](q3)) { project.dnit_project(?p3); A.deallocate[u8](?alloc, fp1, len1::usize); fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    val ent3: *query.QueryEntry = R.unwrap_ok[*query.QueryEntry, str](q3);
    if (ent3.last_changed == lc1) { bad = 1; }
    if (ent3.value_len == len1 && memory.raw_equal(ent3.value::ptr, fp1::ptr, len1::usize)) { bad = 1; }
    project.dnit_project(?p3);

    A.deallocate[u8](?alloc, fp1, len1::usize);
    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

fun ut_resolve_lc(s: *session.Session, stable: session.StableModuleId) query.Revision {
    val e: R.Result[*query.QueryEntry, str] = query.peek(?s.queries, query.Q_RESOLVE, stable::u64);
    if (R.is_err[*query.QueryEntry, str](e)) { ret 0xFFFFFFFFFFFFFFFF; }
    ret R.unwrap_ok[*query.QueryEntry, str](e).last_changed;
}

fun ut_name_text_equal(sa: *session.Session, na: intern.StrId, sb: *session.Session, nb: intern.StrId) bool {
    val oa: O.Option[str] = intern.lookup(?sa.interner, na);
    val ob: O.Option[str] = intern.lookup(?sb.interner, nb);
    if (O.is_none[str](oa) && O.is_none[str](ob)) { ret true; }
    if (O.is_none[str](oa) || O.is_none[str](ob)) { ret false; }
    val ta: str = O.unwrap[str](oa);
    val tb: str = O.unwrap[str](ob);
    val la: usize = str_len(ta);
    if (la != str_len(tb)) { ret false; }
    ret memory.raw_equal(ta::ptr, tb::ptr, la);
}

fun rr_struct_equal(sa: *session.Session, ra: *resolve.ResolveResult, sb: *session.Session, rb: *resolve.ResolveResult) bool {
    if (ra == nil || rb == nil)             { ret false; }
    if (ra.symbol_count != rb.symbol_count) { ret false; }
    if (ra.pub_count != rb.pub_count)       { ret false; }
    if (ra.expr_count != rb.expr_count)     { ret false; }
    if (ra.type_count != rb.type_count)     { ret false; }
    if (ra.decl_count != rb.decl_count)     { ret false; }

    var i: u32 = 0;
    for (i < ra.expr_count) {
        if (ra.expr_resolved[i] != rb.expr_resolved[i]) { ret false; }
        i = i + 1;
    }
    i = 0;
    for (i < ra.type_count) {
        if (ra.type_resolved[i] != rb.type_resolved[i]) { ret false; }
        i = i + 1;
    }
    i = 0;
    for (i < ra.decl_count) {
        if (ra.decl_symbol[i] != rb.decl_symbol[i]) { ret false; }
        i = i + 1;
    }
    i = 0;
    for (i < ra.symbol_count) {
        val xa: *resolve.Symbol = ?ra.symbols[i];
        val xb: *resolve.Symbol = ?rb.symbols[i];
        if (xa.kind != xb.kind)                            { ret false; }
        if (xa.flags != xb.flags)                          { ret false; }
        if (xa.decl != xb.decl)                            { ret false; }
        if (xa.slot != xb.slot)                            { ret false; }
        if (xa.origin != xb.origin)                        { ret false; }
        if (!ut_name_text_equal(sa, xa.name, sb, xb.name))   { ret false; }
        if (!ut_name_text_equal(sa, xa.canon, sb, xb.canon)) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun ut_rr_of(p: *project.Project, s: *session.Session, fqn: str) *resolve.ResolveResult {
    val mid: session.ModuleId = ut_mid(p, s, fqn);
    if (mid == session.MODULE_NIL) { ret nil; }
    ret p.modules[mid::u32].resolve_result;
}

test "mach.lang.driver:incremental_resolve_firewall_body_edit_equals_scratch" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var sA: session.Session = R.unwrap_ok[session.Session, str](sr);
    if (R.is_err[R.Void, str](driver.setup_registry(?sA.registry))) { session.dnit(?sA); ret 1; }

    var names: [2]str;
    names[0] = "main.mach"; names[1] = "leaf.mach";
    var texts: [2]str;
    texts[0] = "use uniontest.leaf.fa;\nfun main() i32 { ret fa(); }\n";
    texts[1] = "pub fun fa() i32 { ret 1; }\n";

    val root_r: R.Result[str, str] = ut_scaffold(?alloc, ?names[0], ?texts[0], 2);
    if (R.is_err[str, str](root_r)) { session.dnit(?sA); ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);

    var bad: i32 = 0;

    val pA1r: R.Result[project.Project, outcome.Fail] = driver.build_project_union(?sA, root);
    if (R.is_err[project.Project, outcome.Fail](pA1r)) { fs.remove_all(?alloc, root); session.dnit(?sA); ret 1; }
    var pA1: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pA1r);
    val st_main: session.StableModuleId = ut_stable(?pA1, ?sA, "uniontest.main");
    val st_leaf: session.StableModuleId = ut_stable(?pA1, ?sA, "uniontest.leaf");
    val lc_main_1: query.Revision = ut_resolve_lc(?sA, st_main);
    val lc_leaf_1: query.Revision = ut_resolve_lc(?sA, st_leaf);
    project.dnit_project(?pA1);

    val src_dir: str = ut_cc3(?alloc, root, "/", "src");
    val leaf_path: str = ut_cc3(?alloc, src_dir, "/", "leaf.mach");
    val leaf_v2: str = "pub fun fa() i32 { val t: i32 = 1; ret t; }\n";
    if (O.is_some[str](fs.write_bytes(leaf_path, leaf_v2, str_len(leaf_v2), 420))) { fs.remove_all(?alloc, root); session.dnit(?sA); ret 1; }

    val pA2r: R.Result[project.Project, outcome.Fail] = driver.build_project_union(?sA, root);
    if (R.is_err[project.Project, outcome.Fail](pA2r)) { fs.remove_all(?alloc, root); session.dnit(?sA); ret 1; }
    var pA2: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pA2r);
    val lc_main_2: query.Revision = ut_resolve_lc(?sA, st_main);
    val lc_leaf_2: query.Revision = ut_resolve_lc(?sA, st_leaf);

    if (lc_main_2 != lc_main_1) { bad = 1; }
    if (lc_leaf_2 == lc_leaf_1) { bad = 1; }

    val sr2: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr2)) { project.dnit_project(?pA2); fs.remove_all(?alloc, root); session.dnit(?sA); ret 1; }
    var sB: session.Session = R.unwrap_ok[session.Session, str](sr2);
    if (R.is_err[R.Void, str](driver.setup_registry(?sB.registry))) { session.dnit(?sB); project.dnit_project(?pA2); fs.remove_all(?alloc, root); session.dnit(?sA); ret 1; }
    val pBr: R.Result[project.Project, outcome.Fail] = driver.build_project_union(?sB, root);
    if (R.is_err[project.Project, outcome.Fail](pBr)) { session.dnit(?sB); project.dnit_project(?pA2); fs.remove_all(?alloc, root); session.dnit(?sA); ret 1; }
    var pB: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pBr);

    if (!rr_struct_equal(?sA, ut_rr_of(?pA2, ?sA, "uniontest.main"), ?sB, ut_rr_of(?pB, ?sB, "uniontest.main"))) { bad = 1; }
    if (!rr_struct_equal(?sA, ut_rr_of(?pA2, ?sA, "uniontest.leaf"), ?sB, ut_rr_of(?pB, ?sB, "uniontest.leaf"))) { bad = 1; }

    project.dnit_project(?pB);
    session.dnit(?sB);
    project.dnit_project(?pA2);
    fs.remove_all(?alloc, root);
    session.dnit(?sA);
    ret bad;
}

test "mach.lang.driver:incremental_resolve_pub_surface_change_equals_scratch" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var sA: session.Session = R.unwrap_ok[session.Session, str](sr);
    if (R.is_err[R.Void, str](driver.setup_registry(?sA.registry))) { session.dnit(?sA); ret 1; }

    var names: [2]str;
    names[0] = "main.mach"; names[1] = "leaf.mach";
    var texts: [2]str;
    texts[0] = "use uniontest.leaf.fa;\nfun main() i32 { ret fa(); }\n";
    texts[1] = "pub fun fa() i32 { ret 1; }\n";

    val root_r: R.Result[str, str] = ut_scaffold(?alloc, ?names[0], ?texts[0], 2);
    if (R.is_err[str, str](root_r)) { session.dnit(?sA); ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);

    var bad: i32 = 0;

    val pA1r: R.Result[project.Project, outcome.Fail] = driver.build_project_union(?sA, root);
    if (R.is_err[project.Project, outcome.Fail](pA1r)) { fs.remove_all(?alloc, root); session.dnit(?sA); ret 1; }
    var pA1: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pA1r);
    val st_main: session.StableModuleId = ut_stable(?pA1, ?sA, "uniontest.main");
    val lc_main_1: query.Revision = ut_resolve_lc(?sA, st_main);
    val rr_main_1: *resolve.ResolveResult = ut_rr_of(?pA1, ?sA, "uniontest.main");
    var fa_decl_1: u32 = 0xFFFFFFFF;
    var si: u32 = 0;
    for (si < rr_main_1.symbol_count) {
        if (rr_main_1.symbols[si].kind == resolve.SYM_IMPORTED) { fa_decl_1 = rr_main_1.symbols[si].decl::u32; }
        si = si + 1;
    }
    project.dnit_project(?pA1);

    val src_dir: str = ut_cc3(?alloc, root, "/", "src");
    val leaf_path: str = ut_cc3(?alloc, src_dir, "/", "leaf.mach");
    val leaf_v2: str = "pub fun fz() i32 { ret 0; }\npub fun fa() i32 { ret 1; }\n";
    if (O.is_some[str](fs.write_bytes(leaf_path, leaf_v2, str_len(leaf_v2), 420))) { fs.remove_all(?alloc, root); session.dnit(?sA); ret 1; }

    val pA2r: R.Result[project.Project, outcome.Fail] = driver.build_project_union(?sA, root);
    if (R.is_err[project.Project, outcome.Fail](pA2r)) { fs.remove_all(?alloc, root); session.dnit(?sA); ret 1; }
    var pA2: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pA2r);
    val lc_main_2: query.Revision = ut_resolve_lc(?sA, st_main);

    if (lc_main_2 == lc_main_1) { bad = 1; }
    val rr_main_2: *resolve.ResolveResult = ut_rr_of(?pA2, ?sA, "uniontest.main");
    var fa_decl_2: u32 = 0xFFFFFFFF;
    si = 0;
    for (si < rr_main_2.symbol_count) {
        if (rr_main_2.symbols[si].kind == resolve.SYM_IMPORTED) { fa_decl_2 = rr_main_2.symbols[si].decl::u32; }
        si = si + 1;
    }
    if (fa_decl_2 == fa_decl_1) { bad = 1; }

    val sr2: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr2)) { project.dnit_project(?pA2); fs.remove_all(?alloc, root); session.dnit(?sA); ret 1; }
    var sB: session.Session = R.unwrap_ok[session.Session, str](sr2);
    if (R.is_err[R.Void, str](driver.setup_registry(?sB.registry))) { session.dnit(?sB); project.dnit_project(?pA2); fs.remove_all(?alloc, root); session.dnit(?sA); ret 1; }
    val pBr: R.Result[project.Project, outcome.Fail] = driver.build_project_union(?sB, root);
    if (R.is_err[project.Project, outcome.Fail](pBr)) { session.dnit(?sB); project.dnit_project(?pA2); fs.remove_all(?alloc, root); session.dnit(?sA); ret 1; }
    var pB: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pBr);

    if (!rr_struct_equal(?sA, rr_main_2, ?sB, ut_rr_of(?pB, ?sB, "uniontest.main")))                             { bad = 1; }
    if (!rr_struct_equal(?sA, ut_rr_of(?pA2, ?sA, "uniontest.leaf"), ?sB, ut_rr_of(?pB, ?sB, "uniontest.leaf"))) { bad = 1; }

    project.dnit_project(?pB);
    session.dnit(?sB);
    project.dnit_project(?pA2);
    fs.remove_all(?alloc, root);
    session.dnit(?sA);
    ret bad;
}

test "mach.lang.driver:incremental_resolve_const_value_change_equals_scratch" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var sA: session.Session = R.unwrap_ok[session.Session, str](sr);
    if (R.is_err[R.Void, str](driver.setup_registry(?sA.registry))) { session.dnit(?sA); ret 1; }

    var names: [2]str;
    names[0] = "main.mach"; names[1] = "leaf.mach";
    var texts: [2]str;
    texts[0] = "use uniontest.leaf.FLAG;\n$if (FLAG) {\n  fun extra() i32 { ret 1; }\n}\nfun main() i32 { ret 0; }\n";
    texts[1] = "pub val FLAG: u8 = 1;\n";

    val root_r: R.Result[str, str] = ut_scaffold(?alloc, ?names[0], ?texts[0], 2);
    if (R.is_err[str, str](root_r)) { session.dnit(?sA); ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);

    var bad: i32 = 0;

    val pA1r: R.Result[project.Project, outcome.Fail] = driver.build_project_union(?sA, root);
    if (R.is_err[project.Project, outcome.Fail](pA1r)) { fs.remove_all(?alloc, root); session.dnit(?sA); ret 1; }
    var pA1: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pA1r);
    val st_main: session.StableModuleId = ut_stable(?pA1, ?sA, "uniontest.main");
    val lc_main_1: query.Revision = ut_resolve_lc(?sA, st_main);
    val sc_main_1: u32 = ut_rr_of(?pA1, ?sA, "uniontest.main").symbol_count;
    project.dnit_project(?pA1);

    val src_dir: str = ut_cc3(?alloc, root, "/", "src");
    val leaf_path: str = ut_cc3(?alloc, src_dir, "/", "leaf.mach");
    val leaf_v2: str = "pub val FLAG: u8 = 0;\n";
    if (O.is_some[str](fs.write_bytes(leaf_path, leaf_v2, str_len(leaf_v2), 420))) { fs.remove_all(?alloc, root); session.dnit(?sA); ret 1; }

    val pA2r: R.Result[project.Project, outcome.Fail] = driver.build_project_union(?sA, root);
    if (R.is_err[project.Project, outcome.Fail](pA2r)) { fs.remove_all(?alloc, root); session.dnit(?sA); ret 1; }
    var pA2: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pA2r);

    if (ut_resolve_lc(?sA, st_main) == lc_main_1)                        { bad = 1; }
    if (ut_rr_of(?pA2, ?sA, "uniontest.main").symbol_count == sc_main_1) { bad = 1; }

    val sr2: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr2)) { project.dnit_project(?pA2); fs.remove_all(?alloc, root); session.dnit(?sA); ret 1; }
    var sB: session.Session = R.unwrap_ok[session.Session, str](sr2);
    if (R.is_err[R.Void, str](driver.setup_registry(?sB.registry))) { session.dnit(?sB); project.dnit_project(?pA2); fs.remove_all(?alloc, root); session.dnit(?sA); ret 1; }
    val pBr: R.Result[project.Project, outcome.Fail] = driver.build_project_union(?sB, root);
    if (R.is_err[project.Project, outcome.Fail](pBr)) { session.dnit(?sB); project.dnit_project(?pA2); fs.remove_all(?alloc, root); session.dnit(?sA); ret 1; }
    var pB: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pBr);

    if (!rr_struct_equal(?sA, ut_rr_of(?pA2, ?sA, "uniontest.main"), ?sB, ut_rr_of(?pB, ?sB, "uniontest.main"))) { bad = 1; }
    if (!rr_struct_equal(?sA, ut_rr_of(?pA2, ?sA, "uniontest.leaf"), ?sB, ut_rr_of(?pB, ?sB, "uniontest.leaf"))) { bad = 1; }

    project.dnit_project(?pB);
    session.dnit(?sB);
    project.dnit_project(?pA2);
    fs.remove_all(?alloc, root);
    session.dnit(?sA);
    ret bad;
}

test "mach.lang.driver:incremental_resolve_reexport_two_hop_propagation" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var sA: session.Session = R.unwrap_ok[session.Session, str](sr);
    if (R.is_err[R.Void, str](driver.setup_registry(?sA.registry))) { session.dnit(?sA); ret 1; }

    var names: [3]str;
    names[0] = "main.mach"; names[1] = "mid.mach"; names[2] = "leaf.mach";
    var texts: [3]str;
    texts[0] = "use uniontest.mid;\nfun main() i32 { ret mid.fa(); }\n";
    texts[1] = "fwd uniontest.leaf.fa;\n";
    texts[2] = "pub fun fa() i32 { ret 1; }\n";

    val root_r: R.Result[str, str] = ut_scaffold(?alloc, ?names[0], ?texts[0], 3);
    if (R.is_err[str, str](root_r)) { session.dnit(?sA); ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);

    var bad: i32 = 0;
    val src_dir: str = ut_cc3(?alloc, root, "/", "src");
    val leaf_path: str = ut_cc3(?alloc, src_dir, "/", "leaf.mach");

    val pA1r: R.Result[project.Project, outcome.Fail] = driver.build_project_union(?sA, root);
    if (R.is_err[project.Project, outcome.Fail](pA1r)) { fs.remove_all(?alloc, root); session.dnit(?sA); ret 1; }
    var pA1: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pA1r);
    val st_main: session.StableModuleId = ut_stable(?pA1, ?sA, "uniontest.main");
    val st_mid:  session.StableModuleId = ut_stable(?pA1, ?sA, "uniontest.mid");
    val lc_main_1: query.Revision = ut_resolve_lc(?sA, st_main);
    val lc_mid_1:  query.Revision = ut_resolve_lc(?sA, st_mid);
    project.dnit_project(?pA1);

    val leaf_priv: str = "pub fun fa() i32 { val t: i32 = 1; ret t; }\n";
    if (O.is_some[str](fs.write_bytes(leaf_path, leaf_priv, str_len(leaf_priv), 420))) { fs.remove_all(?alloc, root); session.dnit(?sA); ret 1; }
    val pPr: R.Result[project.Project, outcome.Fail] = driver.build_project_union(?sA, root);
    if (R.is_err[project.Project, outcome.Fail](pPr)) { fs.remove_all(?alloc, root); session.dnit(?sA); ret 1; }
    var pP: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pPr);
    if (ut_resolve_lc(?sA, st_mid)  != lc_mid_1)  { bad = 1; }
    if (ut_resolve_lc(?sA, st_main) != lc_main_1) { bad = 1; }
    project.dnit_project(?pP);

    val leaf_pub: str = "pub fun fz() i32 { ret 0; }\npub fun fa() i32 { ret 1; }\n";
    if (O.is_some[str](fs.write_bytes(leaf_path, leaf_pub, str_len(leaf_pub), 420))) { fs.remove_all(?alloc, root); session.dnit(?sA); ret 1; }
    val pA2r: R.Result[project.Project, outcome.Fail] = driver.build_project_union(?sA, root);
    if (R.is_err[project.Project, outcome.Fail](pA2r)) { fs.remove_all(?alloc, root); session.dnit(?sA); ret 1; }
    var pA2: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pA2r);
    if (ut_resolve_lc(?sA, st_mid)  == lc_mid_1)  { bad = 1; }
    if (ut_resolve_lc(?sA, st_main) == lc_main_1) { bad = 1; }

    val sr2: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr2)) { project.dnit_project(?pA2); fs.remove_all(?alloc, root); session.dnit(?sA); ret 1; }
    var sB: session.Session = R.unwrap_ok[session.Session, str](sr2);
    if (R.is_err[R.Void, str](driver.setup_registry(?sB.registry))) { session.dnit(?sB); project.dnit_project(?pA2); fs.remove_all(?alloc, root); session.dnit(?sA); ret 1; }
    val pBr: R.Result[project.Project, outcome.Fail] = driver.build_project_union(?sB, root);
    if (R.is_err[project.Project, outcome.Fail](pBr)) { session.dnit(?sB); project.dnit_project(?pA2); fs.remove_all(?alloc, root); session.dnit(?sA); ret 1; }
    var pB: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pBr);

    if (!rr_struct_equal(?sA, ut_rr_of(?pA2, ?sA, "uniontest.main"), ?sB, ut_rr_of(?pB, ?sB, "uniontest.main"))) { bad = 1; }
    if (!rr_struct_equal(?sA, ut_rr_of(?pA2, ?sA, "uniontest.mid"),  ?sB, ut_rr_of(?pB, ?sB, "uniontest.mid")))  { bad = 1; }
    if (!rr_struct_equal(?sA, ut_rr_of(?pA2, ?sA, "uniontest.leaf"), ?sB, ut_rr_of(?pB, ?sB, "uniontest.leaf"))) { bad = 1; }

    project.dnit_project(?pB);
    session.dnit(?sB);
    project.dnit_project(?pA2);
    fs.remove_all(?alloc, root);
    session.dnit(?sA);
    ret bad;
}

test "mach.lang.driver:resolve_fwd_reference_visible_before_textual_declaration" {
    var names: [3]str;
    names[0] = "main.mach"; names[1] = "mid.mach"; names[2] = "leaf.mach";
    var texts: [3]str;
    texts[0] = "use uniontest.mid;\nfun main() i32 { ret mid.before() + mid.after(); }\n";
    texts[1] = "pub fun before() i32 { ret fa(); }\nfwd uniontest.leaf.fa;\npub fun after() i32 { ret fa(); }\n";
    texts[2] = "pub fun fa() i32 { ret 3; }\n";
    ret ut_single_result_n(?names[0], ?texts[0], 3, "", false);
}

test "mach.lang.driver:resolve_fwd_does_not_admit_unrelated_unresolved_names" {
