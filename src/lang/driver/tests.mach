    var names: [2]str;
    names[0] = "main.mach";
    names[1] = "bad.mach";
    var texts: [2]str;
    texts[0] = "use uniontest.bad;\n\nfun main() i32 { ret 0; }\n";
    texts[1] = "$error(\"reachable boom\");\n\npub fun f() i32 { ret 0; }\n";

    val pr: res[project.Project, outcome.Fail] = ut_build_test(?s, ?alloc, ?names[0], ?texts[0], 2);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    var bad: i32 = 0;
    if (ut_gated(?p, ?s, "uniontest.bad"))    { bad = 1; }
    if (!ut_in_topo(?p, ?s, "uniontest.bad")) { bad = 1; }
    if (union.count_target_gated(?p) != 0)    { bad = 1; }
    val se: err[outcome.Fail] = driver.run_sema_pass(?p);
    if (!(sel se.err && outcome.is_reported(se.err))) { bad = 1; }
    if (ut_count_errors(?p.s.diags) == 0)             { bad = 1; }

    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

fun ut_sema_rejects_at(src: str, needle: str, want_offset: usize, want_len: usize) bool {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret false; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret false; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = src;
    val pr: res[project.Project, outcome.Fail] = ut_build(?s, ?alloc, ?names[0], ?texts[0], 1);
    if (sel pr.err) { ret false; }
    var p: project.Project = pr.ok;
    fin { project.dnit_project(?p); }

    val se: err[outcome.Fail] = driver.run_sema_pass(?p);
    if (!(sel se.err && outcome.is_reported(se.err))) { ret false; }
    var i: usize = 0;
    for (i < diagnostic.len(?s.diags)) {
        val d: *diagnostic.Diagnostic = ?s.diags.items.data[i];
        if (d.severity == diagnostic.SEVERITY_ERROR
            && ut_str_contains(d.message, needle)
            && d.loc.span.offset == want_offset
            && d.loc.span.len == want_len) { ret true; }
        i = i + 1;
    }
    ret false;
}

# a test body's literal `ret` is refused at the ret when it is outside 0..255, with
# the value in the message; an ordinary function returning the same value is not
test "mach.lang.driver:test_result_outside_the_status_range_is_refused_at_the_ret" {
    val src: str = "fun main() i32 { ret 0; }\nfun wide() i32 { ret 256; }\ntest \"a\" { ret 256; }\ntest \"b\" { ret 300; }\ntest \"c\" { ret -1; }\n";
    if (!ut_sema_rejects_at(src, "test result 256 is outside the status range 0..255", 65, 8)) { ret 1; }
    if (!ut_sema_rejects_at(src, "test result 300 is outside the status range 0..255", 87, 8)) { ret 2; }
    if (!ut_sema_rejects_at(src, "test result -1 is outside the status range 0..255", 109, 7)) { ret 3; }

    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 4; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 4; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = src;
    val pr: res[project.Project, outcome.Fail] = ut_build(?s, ?alloc, ?names[0], ?texts[0], 1);
    if (sel pr.err) { ret 4; }
    var p: project.Project = pr.ok;
    fin { project.dnit_project(?p); }
    driver.run_sema_pass(?p);
    # exactly the three test rets, not `wide`
    if (ut_diag_count(?s.diags, "outside the status range 0..255") != 3) { ret 5; }
    if (!ut_diag_note_has(?s.diags, "eight bits on every host"))         { ret 6; }

    # the range itself, and a run-time value, are the dispatcher's business
    if (!ut_sema_clean("fun main() i32 { ret 0; }\nfun wide() i32 { ret 256; }\ntest \"d\" { ret 255; }\ntest \"e\" { ret 0; }\ntest \"f\" { ret wide(); }\ntest \"g\" { ret 200 + 55; }\n")) { ret 7; }
    ret 0;
}

fun ut_dispatcher_start_stub() str {
    ret "\n#[symbol(\"_start\")]\npub fun start() {\n    asm x86_64 {\n        mov rax, rsp\n        mov rdi, [rax]\n        lea rsi, [rax+8]\n        and rsp, -16\n        call main\n        mov rdi, rax\n        mov rax, 60\n        syscall\n    }\n}\n";
}

# runs the built dispatcher on one test index and returns its exit code, or -1
fun ut_dispatch_status(exe: str, idx: u32) i32 {
    var ibuf: [16]u8;
    var len:  usize = 0;
    var v:    u32   = idx;
    if (v == 0) {
        ibuf[0] = 48;
        len     = 1;
    }
    for (v > 0) {
        ibuf[len] = 48 + (v % 10)::u8;
        v         = v / 10;
        len       = len + 1;
    }
    # the digits were written least significant first
    var lo: usize = 0;
    var hi: usize = len;
    for (lo + 1 < hi) {
        val t: u8 = ibuf[lo];
        ibuf[lo]     = ibuf[hi - 1];
        ibuf[hi - 1] = t;
        lo           = lo + 1;
        hi           = hi - 1;
    }
    ibuf[len] = 0;
    var argv: [3]*u8;
    argv[0] = exe::*u8;
    argv[1] = ?ibuf[0];
    argv[2] = nil;
    val spawned: res[exec.Child, exec.Error] = exec.spawn(exe, ?argv[0], env.environ());
    if (sel spawned.err) { ret -1; }
    val rr: res[exec.ExitStatus, exec.Error] = exec.wait(spawned.ok);
    if (sel rr.err)          { ret -1; }
    if (!exec.exited(rr.ok)) { ret -1; }
    ret exec.code(rr.ok)::i32;
}

# a run-time result outside 0..255 exits 255 instead of its low eight bits, so it
# can never read as a pass; a result inside the range is the exit code as is
test "mach.lang.driver:dispatcher_folds_a_wide_run_time_result_to_255" {
    $if ($mach.build.os != $mach.os.linux || $mach.build.arch != $mach.arch.x86_64) { ret 0; }
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) { ret 1; }

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = ut_cc3(?alloc,
        "#[noinline]\nfun wide(v: i32) i32 { ret v; }\n",
        "test \"r256\" { ret wide(256); }\ntest \"r300\" { ret wide(300); }\ntest \"rneg1\" { ret wide(-1); }\ntest \"r3\" { ret 3; }\ntest \"r0\" { ret 0; }\ntest \"r255\" { ret 255; }\n",
        ut_dispatcher_start_stub());
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 1);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?alloc, root); }

    val mr: res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) { ret 1; }
    var m:  manifest.Manifest    = mr.ok;
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    rq.target       = "linux";
    rq.goal         = request.GOAL_TESTS;
    val pr: res[bplan.BuildPlan, outcome.Fail] = bplan.plan(?alloc, ?s.interner, s.registry, ?m, rq);
    if (sel pr.err) { ret 1; }
    var bp: bplan.BuildPlan                         = pr.ok;
    val r:  res[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, ?alloc, nil);
    if (sel r.err) {
        print.eprintln(outcome.describe(r.err));
        ret 1;
    }
    var bo: outcome.BuildOutcome = r.ok;
    if (bo.severity != outcome.BUILD_OK) { ret 2; }
    if (bo.tests.len != 6)               { ret 3; }

    var labels: [6]str;
    labels[0] = "r256";
    labels[1] = "r300";
    labels[2] = "rneg1";
    labels[3] = "r3";
    labels[4] = "r0";
    labels[5] = "r255";
    var want: [6]i32;
    want[0] = 255;
    want[1] = 255;
    want[2] = 255;
    want[3] = 3;
    want[4] = 0;
    want[5] = 255;
    var i: usize = 0;
    for (i < 6) {
        var found: bool  = false;
        var t:     usize = 0;
        for (t < bo.tests.len) {
            val art: *outcome.TestArtifact = ?bo.tests.data[t];
            if (str_equals(art.label::str, labels[i])) {
                found = true;
                val got: i32 = ut_dispatch_status(art.exe::str, art.idx);
                if (got != want[i]) {
                    print.eprintlnf("{}: exit {} (want {})", labels[i], got::i64, want[i]::i64);
                    ret 10 + i::i32;
                }
            }
            t = t + 1;
        }
        if (!found) { ret 4; }
        i = i + 1;
    }
    ret 0;
}

fun ut_has(p: *project.Project, s: *session.Session, fqn: str) bool {
    val idr: res[intern.StrId, A.Error] = intern.intern(?s.interner, fqn);
    if (sel idr.err) { ret false; }
    var id:    intern.StrId           = idr.ok;
    val get_r: opt[*session.ModuleId] = map.get[intern.StrId, session.ModuleId](?p.by_fqn, ?id);
    if (sel get_r.none) { ret false; }
    ret sel get_r.some;
}

fun ut_ast(p: *project.Project, s: *session.Session, fqn: str) *ast.Ast {
    val idr: res[intern.StrId, A.Error] = intern.intern(?s.interner, fqn);
    if (sel idr.err) { ret nil; }
    var id: intern.StrId           = idr.ok;
    val mr: opt[*session.ModuleId] = map.get[intern.StrId, session.ModuleId](?p.by_fqn, ?id);
    if (sel mr.none) { ret nil; }
    val mid: session.ModuleId = @mr.some;
    ret p.modules[mid::u32].a;
}

fun ut_mid(p: *project.Project, s: *session.Session, fqn: str) session.ModuleId {
    val idr: res[intern.StrId, A.Error] = intern.intern(?s.interner, fqn);
    if (sel idr.err) { ret session.MODULE_NIL; }
    var id: intern.StrId           = idr.ok;
    val mr: opt[*session.ModuleId] = map.get[intern.StrId, session.ModuleId](?p.by_fqn, ?id);
    if (sel mr.none) { ret session.MODULE_NIL; }
    ret @mr.some;
}

fun ut_stable(p: *project.Project, s: *session.Session, fqn: str) session.StableModuleId {
    val mid: session.ModuleId = ut_mid(p, s, fqn);
    if (mid == session.MODULE_NIL) { ret session.STABLE_MODULE_NIL; }
    ret p.modules[mid::u32].stable_id;
}

fun ut_ctx(p: *project.Project, s: *session.Session, fqn: str) *comptime.ComptimeCtx {
    val idr: res[intern.StrId, A.Error] = intern.intern(?s.interner, fqn);
    if (sel idr.err) { ret nil; }
    var id: intern.StrId           = idr.ok;
    val mr: opt[*session.ModuleId] = map.get[intern.StrId, session.ModuleId](?p.by_fqn, ?id);
    if (sel mr.none) { ret nil; }
    val mid: session.ModuleId     = @mr.some;
    val m:   *project.ModuleEntry = ?p.modules[mid::u32];
    ret ?m.ctx;
}

fun ut_id_is(s: *session.Session, id: intern.StrId, text: str) bool {
    val found: opt[str] = intern.lookup(?s.interner, id);
    ret sel found.some && str_equals(found.some, text);
}

test "mach.lang.driver:analyze_project_retains_selected_frontend" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [4]str;
    names[0] = "alpha.mach";
    names[1] = "beta.mach";
    names[2] = "model.mach";
    names[3] = "orphan.mach";
    var texts: [4]str;
    texts[0] = "fun main() i32 { ret no_such(); }\n";
    texts[1] = "use ctxcase.model;\nfun main() i32 { var b: model.Box[model.Leaf]; ret model.take[model.Leaf](b); }\n";
    texts[2] = "pub rec Leaf { n: i32; }\npub rec Box[T] { v: T; }\npub fun take[T](b: Box[T]) i32 { ret 7; }\n";
    texts[3] = "fun broken() NoSuch { var x: AlsoMissing; ret x; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold_m(
        ?alloc, ut_manifest_frontend(), ?names[0], ?texts[0], 4);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    val mr: res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var mf:  manifest.Manifest    = mr.ok;
    var req: request.BuildRequest = request.defaults();
    req.project_root = root;
    req.target       = "windows";
    req.profile      = "release";
    req.artifact     = "beta";
    req.want_lib     = false;
    req.goal         = request.GOAL_OBJECTS;
    req.opt          = pipeline.OPT_RELEASE;
    req.pie          = true;

    val pr: res[project.Project, outcome.Fail] = driver.analyze_project(?s, ?mf, ?req, nil, 0);
    if (sel pr.err) {
        manifest.dnit(?mf, ?alloc);
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;
    manifest.dnit(?mf, ?alloc);

    var bad: i32 = 0;
    if (p.queries.db != ?s.queries)       { bad = 2; }
    if (ut_count_errors(?s.diags) != 0)   { bad = 3; }
    if (ut_has(?p, ?s, "ctxcase.alpha"))  { bad = 4; }
    if (ut_has(?p, ?s, "ctxcase.orphan")) { bad = 5; }

    val beta:  session.ModuleId = ut_mid(?p, ?s, "ctxcase.beta");
    val model: session.ModuleId = ut_mid(?p, ?s, "ctxcase.model");
    if (beta == session.MODULE_NIL || model == session.MODULE_NIL) { bad = 6; }
    or {
        val bm: *project.ModuleEntry = ?p.modules[beta::u32];
        val mm: *project.ModuleEntry = ?p.modules[model::u32];
        if (!bm.resolved || bm.resolve_result == nil || bm.sema_result == nil) { bad = 7; }
        if (!mm.resolved || mm.resolve_result == nil || mm.sema_result == nil) { bad = 8; }
        if (bm.ir_module != nil || bm.object_image != nil)                     { bad = 9; }
        if (mm.ir_module != nil || mm.object_image != nil)                     { bad = 10; }

        val c: *comptime.ComptimeCtx = ?bm.ctx;
        if (c.env.build_mode_id != comptime.MODE_RELEASE || c.env.build_pie != 1) { bad = 11; }
        if (c.env.pointer_width != 8)                                             { bad = 12; }
        if (!ut_id_is(?s, c.env.project_id, "ctxcase"))                           { bad = 13; }
        if (!ut_id_is(?s, c.env.project_ver, "1.2.3"))                            { bad = 14; }
        if (!ut_id_is(?s, c.env.target_os, "windows"))                            { bad = 15; }
        if (!ut_id_is(?s, c.env.target_isa, "x86_64"))                            { bad = 16; }
        if (!ut_id_is(?s, c.env.target_abi, "win64"))                             { bad = 17; }
        if (!ut_id_is(?s, c.env.bin_name, "beta"))                                { bad = 18; }
    }

    project.dnit_project(?p);
    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.driver:analyze_project_loads_overlay_extra_root_through_pub_const_gate" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [4]str;
    names[0] = "main.mach";
    names[1] = "extra.mach";
    names[2] = "flags.mach";
    names[3] = "model.mach";
    var texts: [4]str;
    texts[0] = "fun main() i32 { ret 0; }\n";
    texts[1] = "fun broken() NoSuch { var x: AlsoMissing; ret x; }\n";
    texts[2] = "pub val ENABLE: i32 = 1;\n";
    texts[3] = "pub rec Leaf { n: i32; }\npub rec Box[T] { v: T; }\npub fun take[T](b: Box[T]) i32 { ret 7; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 4);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    val mr: res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var mf:  manifest.Manifest    = mr.ok;
    var req: request.BuildRequest = request.defaults();
    req.project_root = root;
    req.target       = "linux";
    req.artifact     = "uniontest";
    req.goal         = request.GOAL_OBJECTS;

    val base_r: res[project.Project, outcome.Fail] = driver.analyze_project(?s, ?mf, ?req, nil, 0);
    if (sel base_r.err) {
        manifest.dnit(?mf, ?alloc);
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var base: project.Project = base_r.ok;
    var bad:  i32             = 0;
    if (ut_has(?base, ?s, "uniontest.extra")) { bad = 1; }
    if (ut_has(?base, ?s, "uniontest.flags")) { bad = 1; }
    if (ut_has(?base, ?s, "uniontest.model")) { bad = 1; }
    project.dnit_project(?base);

    val extra_path:    str            = ut_cc3(?alloc, root, "/", "src/extra.mach");
    val overlay:       str            = "use uniontest.flags.ENABLE;\n$if (ENABLE == 1) { use uniontest.model; }\npub fun probe() i32 { ret 7; }\n";
    val set_overlay_r: err[fail.Fail] = session.set_overlay(?s, extra_path, overlay);
    if (sel set_overlay_r.err) {
        manifest.dnit(?mf, ?alloc);
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    val xid_r: res[intern.StrId, A.Error] = intern.intern(?s.interner, "uniontest.extra");
    if (sel xid_r.err) {
        manifest.dnit(?mf, ?alloc);
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var extra_roots: [1]intern.StrId;
    extra_roots[0] = xid_r.ok;

    val rooted_r: res[project.Project, outcome.Fail] = driver.analyze_project(?s, ?mf, ?req, ?extra_roots[0], 1);
    if (sel rooted_r.err) {
        manifest.dnit(?mf, ?alloc);
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = rooted_r.ok;
    if (ut_count_errors(?s.diags) != 0)              { bad = 2; }
    if (!ut_has(?p, ?s, "uniontest.extra"))          { bad = 3; }
    if (!ut_has(?p, ?s, "uniontest.flags"))          { bad = 4; }
    if (!ut_has(?p, ?s, "uniontest.model"))          { bad = 5; }
    if (p.emit_len != 1 || p.topo_len <= p.emit_len) { bad = 6; }

    val extra_mid: session.ModuleId = ut_mid(?p, ?s, "uniontest.extra");
    val model_mid: session.ModuleId = ut_mid(?p, ?s, "uniontest.model");
    if (extra_mid == session.MODULE_NIL || model_mid == session.MODULE_NIL) { bad = 7; }
    or {
        val em: *project.ModuleEntry = ?p.modules[extra_mid::u32];
        val mm: *project.ModuleEntry = ?p.modules[model_mid::u32];
        if (!em.resolved || em.resolve_result == nil || em.sema_result == nil) { bad = 8; }
        if (!mm.resolved || mm.resolve_result == nil || mm.sema_result == nil) { bad = 9; }
        val eid_r: res[intern.StrId, A.Error] = intern.intern(?s.interner, "ENABLE");
        if (sel eid_r.ok) {
            val enabled: opt[comptime.NamedConst] = comptime.lookup(
                ?em.ctx, eid_r.ok);
            if (sel enabled.some) {
                val nc: comptime.NamedConst = enabled.some;
                if (nc.value.kind != comptime.CT_KIND_INT || nc.value.data.i != 1) { bad = 12; }
            }
        }
    }

    project.dnit_project(?p);
    manifest.dnit(?mf, ?alloc);
    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.driver:analyze_project_selected_target_change_invalidates_typed_products" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "$if ($mach.build.os == $mach.os.windows) { val K: i32 = 2; } $or { val K: i32 = 1; }\nfun main() i32 { ret K; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 1);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?alloc, root); }
    val mr: res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) { ret 1; }
    var mf: manifest.Manifest = mr.ok;
    fin { manifest.dnit(?mf, ?alloc); }
    var req: request.BuildRequest = request.defaults();
    req.project_root = root;
    req.target       = "linux";
    req.artifact     = "uniontest";
    req.goal         = request.GOAL_OBJECTS;

    val host_r: res[project.Project, outcome.Fail] = driver.analyze_project(?s, ?mf, ?req, nil, 0);
    if (sel host_r.err) { ret 2; }
    var host:   project.Project        = host_r.ok;
    val stable: session.StableModuleId = ut_stable(?host, ?s, "uniontest.main");
    if (stable == session.STABLE_MODULE_NIL) {
        project.dnit_project(?host);
        ret 3;
    }
    if (host.modules[ut_mid(?host, ?s, "uniontest.main")::u32].ctx.env.target_os_id != os.OS_LINUX::u32) {
        project.dnit_project(?host);
        ret 4;
    }
    project.dnit_project(?host);
    val target_1: query.Revision = query.peek_revision(?s.queries, query.Q_TARGET, 0);
    val sema_1:   query.Revision = ut_sema_lc(?s, stable);
    if (target_1 == 0 || sema_1 == 0) { ret 5; }

    req.target = "windows";
    val other_r: res[project.Project, outcome.Fail] = driver.analyze_project(?s, ?mf, ?req, nil, 0);
    if (sel other_r.err) { ret 6; }
    var other: project.Project = other_r.ok;
    val os_2:  u32             = other.modules[ut_mid(?other, ?s, "uniontest.main")::u32].ctx.env.target_os_id;
    project.dnit_project(?other);
    if (os_2 != os.OS_WINDOWS::u32) { ret 7; }
    val target_2: query.Revision = query.peek_revision(?s.queries, query.Q_TARGET, 0);
    val sema_2:   query.Revision = ut_sema_lc(?s, stable);
    if (target_2 == target_1 || sema_2 == sema_1) { ret 8; }

    val again_r: res[project.Project, outcome.Fail] = driver.analyze_project(?s, ?mf, ?req, nil, 0);
    if (sel again_r.err) { ret 9; }
    var again: project.Project = again_r.ok;
    project.dnit_project(?again);
    if (query.peek_revision(?s.queries, query.Q_TARGET, 0) != target_2 || ut_sema_lc(?s, stable) != sema_2) { ret 10; }
    ret 0;
}

test "mach.lang.driver:analyze_project_resets_and_replays_cached_diagnostics" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "fun dup() i32 { ret 1; }\nfun dup() i32 { ret 2; }\nfun main() i32 { ret 0; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str                                  = root_r.ok;
    val mr:   res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var mf:  manifest.Manifest    = mr.ok;
    var req: request.BuildRequest = request.defaults();
    req.project_root = root;
    req.target       = "linux";
    req.artifact     = "uniontest";
    req.goal         = request.GOAL_OBJECTS;

    val cold_r: res[project.Project, outcome.Fail] = driver.analyze_project(?s, ?mf, ?req, nil, 0);
    if (!ut_project_was_rejected(cold_r)) {
        manifest.dnit(?mf, ?alloc);
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    val fqn_r: res[intern.StrId, A.Error] = intern.intern(?s.interner, "uniontest.main");
    if (sel fqn_r.err) {
        manifest.dnit(?mf, ?alloc);
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    val stable: session.StableModuleId = session.stable_module_id_lookup(?s, fqn_r.ok);
    if (stable == session.STABLE_MODULE_NIL || diagnostic.len(?s.diags) == 0) {
        manifest.dnit(?mf, ?alloc);
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    val resolve_rev: query.Revision = query.peek_revision(?s.queries, query.Q_RESOLVE, stable::u64);
    val sema_rev:    query.Revision = query.peek_revision(?s.queries, query.Q_SEMA, stable::u64);
    if (resolve_rev == 0 || sema_rev == 0) {
        manifest.dnit(?mf, ?alloc);
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    val snapshot_r: res[*diagnostic.DiagnosticStore, fail.Fail] = diagnostic.snapshot_from(?s.diags, 0, ?alloc);
    if (sel snapshot_r.err) {
        manifest.dnit(?mf, ?alloc);
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    val snapshot: *diagnostic.DiagnosticStore = snapshot_r.ok;

    val warm_r: res[project.Project, outcome.Fail] = driver.analyze_project(?s, ?mf, ?req, nil, 0);
    if (!ut_project_was_rejected(warm_r)) {
        diagnostic.store_dnit(snapshot);
        A.deallocate[diagnostic.DiagnosticStore](?alloc, snapshot, 1::usize);
        manifest.dnit(?mf, ?alloc);
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var bad: i32 = 0;
    if (!ut_diag_list_eq(?s.diags, snapshot))                                         { bad = 1; }
    if (query.peek_revision(?s.queries, query.Q_RESOLVE, stable::u64) != resolve_rev) { bad = 1; }
    if (query.peek_revision(?s.queries, query.Q_SEMA, stable::u64) != sema_rev)       { bad = 1; }

    diagnostic.store_dnit(snapshot);
    A.deallocate[diagnostic.DiagnosticStore](?alloc, snapshot, 1::usize);
    manifest.dnit(?mf, ?alloc);
    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.driver:analyze_project_rejects_missing_extra_root_array" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    val invalid: res[project.Project, outcome.Fail] = driver.analyze_project(?s, nil, nil, nil, 1);
    var bad:     i32                                = 0;
    if (sel invalid.ok) {
        var stray: project.Project = invalid.ok;
        project.dnit_project(?stray);
        bad = 1;
    }
    if (sel invalid.err) {
        val failure: outcome.Fail = invalid.err;
        if (!sel failure.internal
            || !str_equals(outcome.describe(failure),
            "driver: frontend analysis root count requires a root array")) { bad = 1; }
    }
    if (session.module_count(?s) != 0)              { bad = 1; }
    if (isa.registered_count(?s.registry.isa) != 0) { bad = 1; }

    session.dnit(?s);
    ret bad;
}

test "mach.lang.driver:analyze_project_failure_cleans_partial_state" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "other.mach";
    var texts: [1]str;
    texts[0] = "pub fun other() i32 { ret 1; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str                                  = root_r.ok;
    val mr:   res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var mf:  manifest.Manifest    = mr.ok;
    var req: request.BuildRequest = request.defaults();
    req.project_root = root;
    req.target       = "linux";
    req.artifact     = "uniontest";
    req.goal         = request.GOAL_OBJECTS;

    var bad:    i32                                = 0;
    val failed: res[project.Project, outcome.Fail] = driver.analyze_project(?s, ?mf, ?req, nil, 0);
    if (sel failed.ok) {
        var stray: project.Project = failed.ok;
        project.dnit_project(?stray);
        bad = 1;
    }
    if (session.module_count(?s) != 0) { bad = 1; }

    val main_path:     str             = ut_cc3(?alloc, root, "/", "src/main.mach");
    val repaired_text: str             = "fun main() i32 { ret 0; }\n";
    val write_err:     err[fs.FsError] = fs.write_bytes(
        main_path, repaired_text, str_len(repaired_text), 420);
    if (sel write_err.err) { bad = 1; }
    if (sel write_err.ok) {
        val repaired: res[project.Project, outcome.Fail] = driver.analyze_project(?s, ?mf, ?req, nil, 0);
        if (sel repaired.err) { bad = 1; }
        if (sel repaired.ok) {
            var p:   project.Project  = repaired.ok;
            val mid: session.ModuleId = ut_mid(?p, ?s, "uniontest.main");
            if (mid == session.MODULE_NIL) { bad = 1; }
            or {
                val me: *project.ModuleEntry = ?p.modules[mid::u32];
                if (!me.resolved || me.resolve_result == nil || me.sema_result == nil) { bad = 1; }
            }
            if (p.queries.db != ?s.queries) { bad = 1; }
            project.dnit_project(?p);
        }
    }

    manifest.dnit(?mf, ?alloc);
    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

rec LoadSlotProbe {
    backing:    A.Allocator;
    live:       i64;
    live_count: i64;
    calls:      u32;
    fail_at:    u32;
}

fun load_slot_probe_allocate(ctx: ptr, size: usize, align: usize) opt[ptr] {
    val p: *LoadSlotProbe = ctx::*LoadSlotProbe;
    p.calls = p.calls + 1;
    if (p.fail_at != 0 && p.calls == p.fail_at) { ret opt[ptr].none{}; }
    val r: opt[ptr] = p.backing.fn_allocate(p.backing.ctx, size, align);
    if (sel r.some) {
        p.live       = p.live + size::i64;
        p.live_count = p.live_count + 1;
        memory.raw_fill(r.some, 0xAA, size);
    }
    ret r;
}

fun load_slot_probe_reallocate(ctx: ptr, item: ptr, old_size: usize, new_size: usize, align: usize) opt[ptr] {
    val p: *LoadSlotProbe = ctx::*LoadSlotProbe;
    p.calls = p.calls + 1;
    if (p.fail_at != 0 && p.calls == p.fail_at) { ret opt[ptr].none{}; }
    val r: opt[ptr] = p.backing.fn_reallocate(p.backing.ctx, item, old_size, new_size, align);
    if (sel r.some) {
        p.live = p.live - old_size::i64 + new_size::i64;
        if (new_size > old_size) {
            val grown: ptr = r.some;
            memory.raw_fill((grown::usize + old_size)::ptr, 0xAA, new_size - old_size);
        }
    }
    ret r;
}

fun load_slot_probe_deallocate(ctx: ptr, item: ptr, size: usize, align: usize) i64 {
    val p: *LoadSlotProbe = ctx::*LoadSlotProbe;
    p.live       = p.live - size::i64;
    p.live_count = p.live_count - 1;
    ret p.backing.fn_deallocate(p.backing.ctx, item, size, align);
}

fun load_slot_probe_make(p: *LoadSlotProbe, alloc: *A.Allocator, backing: *A.Allocator, fail_at: u32) {
    p.backing    = @backing;
    p.live       = 0;
    p.live_count = 0;
    p.calls      = 0;
    p.fail_at    = fail_at;
    val probe: *LoadSlotProbe = p;
    alloc.ctx           = probe::ptr;
    alloc.fn_allocate   = load_slot_probe_allocate;
    alloc.fn_reallocate = load_slot_probe_reallocate;
    alloc.fn_deallocate = load_slot_probe_deallocate;
}

test "mach.lang.driver:load_module_registration_fail_at_n_no_leak" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }

    var base_names: [1]str;
    base_names[0] = "main.mach";
    var base_texts: [1]str;
    base_texts[0] = "fun main() i32 { ret 0; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?base_names[0], ?base_texts[0], 1);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;

    val preload:   u32 = 15;
    var pi:        u32 = 0;
    var setup_bad: i32 = 0;
    for (pi < preload + 1 && setup_bad == 0) {
        val name_r: res[str, format.FormatError] = format.sprint(?alloc, "c{}.mach", pi);
        if (sel name_r.err) {
            setup_bad = 1;
            brk;
        }
        val name:     str             = name_r.ok;
        val name_cap: usize           = str_len(name) + 1;
        val text:     str             = "pub fun leaf() i32 { ret 0; }\n";
        val fp:       str             = ut_cc3(?alloc, root, "/src/", name);
        val we:       err[fs.FsError] = fs.write_bytes(fp, text, str_len(text), 420);
        A.deallocate[u8](?alloc, name::*u8, name_cap);
        if (sel we.err) {
            setup_bad = 1;
            brk;
        }
        pi = pi + 1;
    }
    if (setup_bad != 0) {
        fs.remove_all(?alloc, root);
        ret 1;
    }

    var bad:         i32  = 0;
    var saw_success: bool = false;
    var fail_at:     u32  = 1;
    val max_fail_at: u32  = 2;
    for (fail_at <= max_fail_at && bad == 0) {
        val sr: res[session.Session, fail.Fail] = session.init(?alloc);
        if (sel sr.err) {
            bad = 1;
            brk;
        }
        var s:  session.Session   = sr.ok;
        val rr: err[outcome.Fail] = driver.setup_registry(s.registry);
        if (sel rr.err) {
            session.dnit(?s);
            bad = 1;
            brk;
        }

        val pr: res[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
        if (sel pr.err) {
            session.dnit(?s);
            bad = 1;
            brk;
        }
        var p: project.Project = pr.ok;
        if (p.module_len != 1) {
            project.dnit_project(?p);
            session.dnit(?s);
            bad = 1;
            brk;
        }

        var pj: u32 = 0;
        for (pj < preload && bad == 0) {
            val nm_r: res[str, format.FormatError] = format.sprint(?alloc, "uniontest.c{}", pj);
            if (sel nm_r.err) {
                bad = 1;
                brk;
            }
            val nm:    str                        = nm_r.ok;
            val fqn_r: res[intern.StrId, A.Error] = intern.intern(?s.interner, nm);
            A.deallocate[u8](?alloc, nm::*u8, str_len(nm) + 1);
            if (sel fqn_r.err) {
                bad = 1;
                brk;
            }
            val lr: res[session.ModuleId, fail.Fail] = load.dfs_load(?p, fqn_r.ok);
            if (sel lr.err) {
                bad = 1;
                brk;
            }
            pj = pj + 1;
        }
        if (bad != 0) {
            project.dnit_project(?p);
            session.dnit(?s);
            brk;
        }
        if (p.module_len != 1 + preload) {
            project.dnit_project(?p);
            session.dnit(?s);
            bad = 1;
            brk;
        }

        val fqn_r: res[intern.StrId, A.Error] = intern.intern(?s.interner, "uniontest.c15");
        if (sel fqn_r.err) {
            project.dnit_project(?p);
            session.dnit(?s);
            bad = 1;
            brk;
        }
        val fqn:      intern.StrId = fqn_r.ok;
        val baseline: u32          = p.module_len;

        var probe:       LoadSlotProbe;
        var probe_alloc: A.Allocator;
        load_slot_probe_make(?probe, ?probe_alloc, ?alloc, fail_at);
        p.alloc = ?probe_alloc;
        val cr: res[session.ModuleId, fail.Fail] = load.dfs_load(?p, fqn);
        p.alloc = ?alloc;

        if (sel cr.ok) { bad = 2; }
        if (sel cr.err) {
            if (p.module_len != baseline)        { bad = 3; }
            if (ut_has(?p, ?s, "uniontest.c15")) { bad = 3; }
            if (probe.live_count != 0)           { bad = 4; }
        }

        project.dnit_project(?p);
        session.dnit(?s);
        fail_at = fail_at + 1;
    }

    if (bad == 0) {
        val sr: res[session.Session, fail.Fail] = session.init(?alloc);
        if (sel sr.err) { bad = 5; }
        if (sel sr.ok) {
            var s:  session.Session   = sr.ok;
            val rr: err[outcome.Fail] = driver.setup_registry(s.registry);
            if (sel rr.err) {
                session.dnit(?s);
                bad = 5;
            }
            if (sel rr.ok) {
                val pr: res[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
                if (sel pr.err) {
                    session.dnit(?s);
                    bad = 5;
                }
                if (sel pr.ok) {
                    var p:  project.Project = pr.ok;
                    var pj: u32             = 0;
                    for (pj < preload && bad == 0) {
                        val nm_r: res[str, format.FormatError] = format.sprint(?alloc, "uniontest.c{}", pj);
                        if (sel nm_r.err) {
                            bad = 5;
                            brk;
                        }
                        val nm:    str                        = nm_r.ok;
                        val fqn_r: res[intern.StrId, A.Error] = intern.intern(?s.interner, nm);
                        A.deallocate[u8](?alloc, nm::*u8, str_len(nm) + 1);
                        if (sel fqn_r.err) {
                            bad = 5;
                            brk;
                        }
                        val lr: res[session.ModuleId, fail.Fail] = load.dfs_load(?p, fqn_r.ok);
                        if (sel lr.err) {
                            bad = 5;
                            brk;
                        }
                        pj = pj + 1;
                    }
                    if (bad == 0) {
                        val fqn_r: res[intern.StrId, A.Error] = intern.intern(?s.interner, "uniontest.c15");
                        if (sel fqn_r.ok) {
                            val lr: res[session.ModuleId, fail.Fail] = load.dfs_load(?p, fqn_r.ok);
                            if (sel lr.err || p.module_len != 2 + preload) { bad = 5; }
                        }
                    }
                    project.dnit_project(?p);
                }
            }
            session.dnit(?s);
        }
    }

    fs.remove_all(?alloc, root);
    ret bad;
}

fun ut_count_errors(d: *diagnostic.DiagnosticStore) u32 {
    var c: u32   = 0;
    var i: usize = 0;
    for (i < diagnostic.len(d)) {
        if (d.items.data[i].severity == diagnostic.SEVERITY_ERROR) { c = c + 1; }
        i = i + 1;
    }
    ret c;
}

fun ut_project_was_rejected(result: res[project.Project, outcome.Fail]) bool {
    if (sel result.ok) {
        var accepted: project.Project = result.ok;
        project.dnit_project(?accepted);
        ret false;
    }
    ret outcome.is_reported(result.err);
}

fun ut_diag_has(d: *diagnostic.DiagnosticStore, needle: str) bool {
    var i: usize = 0;
    for (i < diagnostic.len(d)) {
        if (d.items.data[i].severity == diagnostic.SEVERITY_ERROR
            && ut_str_contains(d.items.data[i].message, needle)) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun ut_diag_count(d: *diagnostic.DiagnosticStore, needle: str) u32 {
    var hits: u32   = 0;
    var i:    usize = 0;
    for (i < diagnostic.len(d)) {
        if (d.items.data[i].severity == diagnostic.SEVERITY_ERROR
            && ut_str_contains(d.items.data[i].message, needle)) { hits = hits + 1; }
        i = i + 1;
    }
    ret hits;
}

fun ut_diag_note_has(d: *diagnostic.DiagnosticStore, needle: str) bool {
    var i: usize = 0;
    for (i < diagnostic.len(d)) {
        val di: *diagnostic.Diagnostic = ?d.items.data[i];
        if (di.severity == diagnostic.SEVERITY_ERROR) {
            var c: usize = 0;
            for (c < di.children.len) {
                if (di.children.data[c].kind == diagnostic.CHILD_NOTE
                    && ut_str_contains(di.children.data[c].text, needle)) { ret true; }
                c = c + 1;
            }
        }
        i = i + 1;
    }
    ret false;
}

fun ut_vec_sema(s: *session.Session, alloc: *A.Allocator, src: str) res[project.Project, outcome.Fail] {
    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = src;
    ret ut_vec_sema_n(s, alloc, ?names[0], ?texts[0], 1);
}

fun ut_vec_sema_n(s: *session.Session, alloc: *A.Allocator, names: *str, texts: *str, n: u32) res[project.Project, outcome.Fail] {
    val pr: res[project.Project, outcome.Fail] = ut_build(s, alloc, names, texts, n);
    if (sel pr.err) { ret pr; }
    var p:  project.Project   = pr.ok;
    val se: err[outcome.Fail] = driver.run_sema_pass(?p);
    if (sel se.err) {
        project.dnit_project(?p);
        ret res[project.Project, outcome.Fail].err{se.err};
    }
    ret res[project.Project, outcome.Fail].ok{p};
}

fun ut_single_sema_n(s: *session.Session, alloc: *A.Allocator, names: *str, texts: *str, n: u32) res[project.Project, outcome.Fail] {
    val root_r: res[str, fail.Fail] = ut_scaffold(alloc, names, texts, n);
    if (sel root_r.err) { ret res[project.Project, outcome.Fail].err{outcome.from_fail(root_r.err)}; }
    val root: str               = root_r.ok;
    val rr:   err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.err) {
        fs.remove_all(alloc, root);
        ret res[project.Project, outcome.Fail].err{rr.err};
    }
    var tsel_1294: manifest.Selection                 = ut_target_sel("linux");
    val pr:        res[project.Project, outcome.Fail] = driver.build_project(s, root, ?tsel_1294);
    fs.remove_all(alloc, root);
    if (sel pr.err) { ret pr; }
    var p:  project.Project   = pr.ok;
    val se: err[outcome.Fail] = driver.run_sema_pass(?p);
    if (sel se.err) {
        project.dnit_project(?p);
        ret res[project.Project, outcome.Fail].err{se.err};
    }
    ret res[project.Project, outcome.Fail].ok{p};
}

fun ut_single_result_n(names: *str, texts: *str, n: u32, needle: str, want_diag: bool) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:  session.Session                    = sr.ok;
    val pr: res[project.Project, outcome.Fail] = ut_single_sema_n(?s, ?alloc, names, texts, n);
    if (sel pr.err) {
        val expected: bool = want_diag
            && outcome.is_reported(pr.err)
            && ut_diag_has(?s.diags, needle);
        session.dnit(?s);
        if (expected) { ret 0; }
        ret 1;
    }
    var p:  project.Project = pr.ok;
    var ok: bool            = ut_count_errors(?p.s.diags) == 0;
    if (want_diag) { ok = false; }
    project.dnit_project(?p);
    session.dnit(?s);
    if (ok) { ret 0; }
    ret 1;
}

fun ut_single_ok(src: str) i32 {
    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = src;
    ret ut_single_result_n(?names[0], ?texts[0], 1, "", false);
}

fun ut_single_ok2(main: str, lib: str) i32 {
    var names: [2]str;
    names[0] = "main.mach";
    names[1] = "lib.mach";
    var texts: [2]str;
    texts[0] = main;
    texts[1] = lib;
    ret ut_single_result_n(?names[0], ?texts[0], 2, "", false);
}

fun ut_single_diag(src: str, needle: str) i32 {
    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = src;
    ret ut_single_result_n(?names[0], ?texts[0], 1, needle, true);
}

fun ut_single_diag2(main: str, lib: str, needle: str) i32 {
    var names: [2]str;
    names[0] = "main.mach";
    names[1] = "lib.mach";
    var texts: [2]str;
    texts[0] = main;
    texts[1] = lib;
    ret ut_single_result_n(?names[0], ?texts[0], 2, needle, true);
}

fun ut_vec_diagnostic_n(names: *str, texts: *str, n: u32, needle: str, note: bool) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    val pr: res[project.Project, outcome.Fail] = ut_build(?s, ?alloc, names, texts, n);
    if (sel pr.err) {
        if (!outcome.is_reported(pr.err)) { ret 1; }
        if (note) {
            if (ut_diag_note_has(?s.diags, needle)) { ret 0; }
        }
        or {
            if (ut_diag_has(?s.diags, needle)) { ret 0; }
        }
        ret 1;
    }
    var p: project.Project = pr.ok;
    fin { project.dnit_project(?p); }
    val checked: err[outcome.Fail] = driver.run_sema_pass(?p);
    if (sel checked.ok) {
        if (!note) { ret 1; }
    }
    or (sel checked.err) {
        if (!outcome.is_reported(checked.err)) { ret 1; }
    }
    var hit: bool = ut_diag_has(?s.diags, needle);
    if (note) { hit = ut_diag_note_has(?s.diags, needle); }
    if (hit)  { ret 0; }
    var di: usize = 0;
    for (di < diagnostic.len(?s.diags)) {
        print.println(s.diags.items.data[di].message);
        di = di + 1;
    }
    ret 1;
}

fun ut_vec_diag(src: str, needle: str) i32 {
    var names: [1]str = [1]str{"main.mach"};
    var texts: [1]str = [1]str{src};
    ret ut_vec_diagnostic_n(?names[0], ?texts[0], 1, needle, false);
}

fun ut_vec_note(src: str, needle: str) i32 {
    var names: [1]str = [1]str{"main.mach"};
    var texts: [1]str = [1]str{src};
    ret ut_vec_diagnostic_n(?names[0], ?texts[0], 1, needle, true);
}

fun ut_vec_diag2(main: str, lib: str, needle: str) i32 {
    var names: [2]str = [2]str{"main.mach", "lib.mach"};
    var texts: [2]str = [2]str{main, lib};
    ret ut_vec_diagnostic_n(?names[0], ?texts[0], 2, needle, false);
}

fun ut_sema_clean2(main: str, lib: str) bool {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret false; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret false; }
    var s: session.Session = sr.ok;

    var names: [2]str;
    names[0] = "main.mach";
    names[1] = "lib.mach";
    var texts: [2]str;
    texts[0] = main;
    texts[1] = lib;

    val pr: res[project.Project, outcome.Fail] = ut_vec_sema_n(?s, ?alloc, ?names[0], ?texts[0], 2);
    if (sel pr.err) {
        session.dnit(?s);
        ret false;
    }
    var p:     project.Project = pr.ok;
    val clean: bool            = ut_count_errors(?s.diags) == 0;
    project.dnit_project(?p);
    session.dnit(?s);
    ret clean;
}

def CodegenTestPhase: u8;

val CODEGEN_TEST_SETUP:    CodegenTestPhase = 0;
val CODEGEN_TEST_SEMA:     CodegenTestPhase = 1;
val CODEGEN_TEST_LOWER:    CodegenTestPhase = 2;
val CODEGEN_TEST_SELECT:   CodegenTestPhase = 3;
val CODEGEN_TEST_CODEGEN:  CodegenTestPhase = 4;
val CODEGEN_TEST_ARTIFACT: CodegenTestPhase = 5;

def CodegenTestStatus: u8;

val CODEGEN_TEST_SETUP_FAILURE:       CodegenTestStatus = 0;
val CODEGEN_TEST_TARGET_UNAVAILABLE:  CodegenTestStatus = 1;
val CODEGEN_TEST_EMPTY_SELECTION:     CodegenTestStatus = 2;
val CODEGEN_TEST_NAMED_CASE_MISSING:  CodegenTestStatus = 3;
val CODEGEN_TEST_NAMED_CASE_EXECUTED: CodegenTestStatus = 4;
val CODEGEN_TEST_EXPECTED_EXCLUSION:  CodegenTestStatus = 5;
val CODEGEN_TEST_COMPILER_REJECTION:  CodegenTestStatus = 6;
val CODEGEN_TEST_ARTIFACT_FAILURE:    CodegenTestStatus = 7;
val CODEGEN_TEST_PASS:                CodegenTestStatus = 8;

def CodegenTestExpected: u8;

val CODEGEN_EXPECT_PASS:      CodegenTestExpected = 0;
val CODEGEN_EXPECT_EXCLUSION: CodegenTestExpected = 1;

def CodegenTestCase: u8;

val CODEGEN_CASE_NONE:                  CodegenTestCase = 0;
val CODEGEN_CASE_VECTOR_ADD:            CodegenTestCase = 1;
val CODEGEN_CASE_VECTOR_BUILD:          CodegenTestCase = 2;
val CODEGEN_CASE_PUBLIC_MUL:            CodegenTestCase = 3;
val CODEGEN_CASE_DECLASSIFIED_MUL:      CodegenTestCase = 4;
val CODEGEN_CASE_MEMZERO:               CodegenTestCase = 5;
val CODEGEN_CASE_PUBLIC_SHIFT:          CodegenTestCase = 6;
val CODEGEN_CASE_SECRET_SHIFT:          CodegenTestCase = 7;
val CODEGEN_CASE_WIDE_SECRET_RETURN:    CodegenTestCase = 8;
val CODEGEN_CASE_WIDE_SECRET_CALL:      CodegenTestCase = 9;
val CODEGEN_CASE_SECRET_MEMORY_ADDRESS: CodegenTestCase = 10;
val CODEGEN_CASE_SECRET_MUL:            CodegenTestCase = 11;

rec CodegenTestOutcome {
    status:    CodegenTestStatus;
    phase:     CodegenTestPhase;
    case_id:   CodegenTestCase;
    case_name: str;
}

fun ut_codegen_outcome(status: CodegenTestStatus, phase: CodegenTestPhase,
    case_id: CodegenTestCase, case_name: str) CodegenTestOutcome {
    var out: CodegenTestOutcome;
    out.status    = status;
    out.phase     = phase;
    out.case_id   = case_id;
    out.case_name = case_name;
    ret out;
}

fun ut_codegen_phase_name(phase: CodegenTestPhase) str {
    if (phase == CODEGEN_TEST_SETUP)    { ret "setup"; }
    if (phase == CODEGEN_TEST_SEMA)     { ret "sema"; }
    if (phase == CODEGEN_TEST_LOWER)    { ret "lower"; }
    if (phase == CODEGEN_TEST_SELECT)   { ret "selection"; }
    if (phase == CODEGEN_TEST_CODEGEN)  { ret "codegen"; }
    if (phase == CODEGEN_TEST_ARTIFACT) { ret "artifact"; }
    ret "unknown";
}

fun ut_codegen_status_name(status: CodegenTestStatus) str {
    if (status == CODEGEN_TEST_SETUP_FAILURE)       { ret "setup failure"; }
    if (status == CODEGEN_TEST_TARGET_UNAVAILABLE)  { ret "target unavailable"; }
    if (status == CODEGEN_TEST_EMPTY_SELECTION)     { ret "empty selection"; }
    if (status == CODEGEN_TEST_NAMED_CASE_MISSING)  { ret "named case missing"; }
    if (status == CODEGEN_TEST_NAMED_CASE_EXECUTED) { ret "excluded case executed"; }
    if (status == CODEGEN_TEST_EXPECTED_EXCLUSION)  { ret "expected exclusion"; }
    if (status == CODEGEN_TEST_COMPILER_REJECTION)  { ret "compiler rejection"; }
    if (status == CODEGEN_TEST_ARTIFACT_FAILURE)    { ret "artifact failure"; }
    if (status == CODEGEN_TEST_PASS)                { ret "pass"; }
    ret "unknown";
}

fun ut_codegen_expected_name(expected: CodegenTestExpected) str {
    if (expected == CODEGEN_EXPECT_PASS)      { ret "generated artifact"; }
    if (expected == CODEGEN_EXPECT_EXCLUSION) { ret "generated artifact without excluded case"; }
    ret "unknown";
}

fun ut_codegen_outcome_matches(got: CodegenTestOutcome, expected: CodegenTestExpected,
    case_id: CodegenTestCase) bool {
    if (got.case_id != case_id || got.phase != CODEGEN_TEST_ARTIFACT) { ret false; }
    if (expected == CODEGEN_EXPECT_PASS)                              { ret got.status == CODEGEN_TEST_PASS; }
    if (expected == CODEGEN_EXPECT_EXCLUSION)                         { ret got.status == CODEGEN_TEST_EXPECTED_EXCLUSION; }
    ret false;
}

fun ut_codegen_result(got: CodegenTestOutcome, expected: CodegenTestExpected,
    case_id: CodegenTestCase) i32 {
    if (ut_codegen_outcome_matches(got, expected, case_id)) { ret 0; }
    print.eprintlnf("codegen oracle '{}': expected {}, reached {} with {}",
        got.case_name, ut_codegen_expected_name(expected), ut_codegen_phase_name(got.phase),
        ut_codegen_status_name(got.status));
    ret 1;
}

fun ut_codegen_failure_rejected(status: CodegenTestStatus, phase: CodegenTestPhase) bool {
    val got: CodegenTestOutcome = ut_codegen_outcome(status, phase,
        CODEGEN_CASE_PUBLIC_MUL, "mutation");
    ret !ut_codegen_outcome_matches(got, CODEGEN_EXPECT_PASS, CODEGEN_CASE_PUBLIC_MUL)
        && !ut_codegen_outcome_matches(got, CODEGEN_EXPECT_EXCLUSION, CODEGEN_CASE_PUBLIC_MUL);
}

test "mach.lang.driver:codegen_test_outcome_exact" {
    if (!ut_codegen_failure_rejected(CODEGEN_TEST_SETUP_FAILURE, CODEGEN_TEST_SETUP))        { ret 1; }
    if (!ut_codegen_failure_rejected(CODEGEN_TEST_TARGET_UNAVAILABLE, CODEGEN_TEST_SETUP))   { ret 1; }
    if (!ut_codegen_failure_rejected(CODEGEN_TEST_EMPTY_SELECTION, CODEGEN_TEST_SELECT))     { ret 1; }
    if (!ut_codegen_failure_rejected(CODEGEN_TEST_NAMED_CASE_MISSING, CODEGEN_TEST_SELECT))  { ret 1; }
    if (!ut_codegen_failure_rejected(CODEGEN_TEST_NAMED_CASE_EXECUTED, CODEGEN_TEST_SELECT)) { ret 1; }
    if (!ut_codegen_failure_rejected(CODEGEN_TEST_COMPILER_REJECTION, CODEGEN_TEST_CODEGEN)) { ret 1; }
    if (!ut_codegen_failure_rejected(CODEGEN_TEST_ARTIFACT_FAILURE, CODEGEN_TEST_ARTIFACT))  { ret 1; }

    val pass: CodegenTestOutcome = ut_codegen_outcome(CODEGEN_TEST_PASS, CODEGEN_TEST_ARTIFACT,
        CODEGEN_CASE_PUBLIC_MUL, "public multiply");
    if (!ut_codegen_outcome_matches(pass, CODEGEN_EXPECT_PASS, CODEGEN_CASE_PUBLIC_MUL))     { ret 1; }
    if (ut_codegen_outcome_matches(pass, CODEGEN_EXPECT_EXCLUSION, CODEGEN_CASE_PUBLIC_MUL)) { ret 1; }
    if (ut_codegen_outcome_matches(pass, CODEGEN_EXPECT_PASS, CODEGEN_CASE_VECTOR_ADD))      { ret 1; }

    val early: CodegenTestOutcome = ut_codegen_outcome(CODEGEN_TEST_PASS, CODEGEN_TEST_CODEGEN,
        CODEGEN_CASE_PUBLIC_MUL, "early pass");
    if (ut_codegen_outcome_matches(early, CODEGEN_EXPECT_PASS, CODEGEN_CASE_PUBLIC_MUL)) { ret 1; }

    val exclusion: CodegenTestOutcome = ut_codegen_outcome(CODEGEN_TEST_EXPECTED_EXCLUSION,
        CODEGEN_TEST_ARTIFACT, CODEGEN_CASE_PUBLIC_SHIFT, "public shift");
    if (!ut_codegen_outcome_matches(exclusion, CODEGEN_EXPECT_EXCLUSION,
        CODEGEN_CASE_PUBLIC_SHIFT)) { ret 1; }
    if (ut_codegen_outcome_matches(exclusion, CODEGEN_EXPECT_PASS,
        CODEGEN_CASE_PUBLIC_SHIFT)) { ret 1; }
    ret 0;
}

fun ut_codegen_case_selected(p: *project.Project, case_id: CodegenTestCase) bool {
    if (case_id == CODEGEN_CASE_NONE) { ret false; }
    var saw_public_mul: bool = false;
    var saw_declassify: bool = false;
    var ti:             u32  = 0;
    for (ti < p.topo_len) {
        val m: *ir.Module = p.modules[p.topo[ti]::u32].ir_module;
        if (m != nil) {
            var fi: u32 = 0;
            for (fi < m.function_len) {
                val fn: *ir.Function = ?m.functions[fi];
                var ii: u32          = 0;
                for (ii < fn.instr_len) {
                    val ins: *instruction.Instruction = ?fn.instrs[ii];
                    if (ins.kind == instruction.OP_DECLASSIFY) { saw_declassify = true; }

                    var operands_public: bool = true;
                    var oi:              u32  = 0;
                    for (oi < ins.operand_count) {
                        if (ins.operands[oi].secret) { operands_public = false; }
                        oi = oi + 1;
                    }
                    if (ins.kind == instruction.OP_MUL && !ins.secret && operands_public) {
                        saw_public_mul = true;
                    }
                    if (case_id == CODEGEN_CASE_SECRET_MUL
                        && ins.kind == instruction.OP_MUL && !operands_public) { ret true; }

                    if (case_id == CODEGEN_CASE_VECTOR_ADD
                        && ins.kind == instruction.OP_ADD
                        && ir_type.is_vector(?m.types, ins.ty)) { ret true; }
                    if (case_id == CODEGEN_CASE_VECTOR_BUILD
                        && ins.kind == instruction.OP_VEC_BUILD) { ret true; }
                    if (case_id == CODEGEN_CASE_VECTOR_BUILD
                        && ins.kind == instruction.OP_STORE && ins.operand_count >= 1
                        && ins.operands[0].kind == value.VAL_CONST_AGG
                        && ir_type.is_vector(?m.types, ins.operands[0].ty)) { ret true; }
                    if (case_id == CODEGEN_CASE_VECTOR_BUILD
                        && ins.kind == instruction.OP_LOAD
                        && ir_type.is_vector(?m.types, ins.ty)) { ret true; }
                    if (case_id == CODEGEN_CASE_PUBLIC_MUL && saw_public_mul) { ret true; }
                    if (case_id == CODEGEN_CASE_MEMZERO
                        && ins.kind == instruction.OP_MEMZERO) { ret true; }
                    if ((case_id == CODEGEN_CASE_PUBLIC_SHIFT || case_id == CODEGEN_CASE_SECRET_SHIFT)
                        && (ins.kind == instruction.OP_SHL || ins.kind == instruction.OP_SHR_S
                        || ins.kind == instruction.OP_SHR_U)
                        && ins.operand_count >= 2) {
                        val count_secret: bool = ins.operands[1].secret;
                        if (case_id == CODEGEN_CASE_SECRET_SHIFT && count_secret)  { ret true; }
                        if (case_id == CODEGEN_CASE_PUBLIC_SHIFT && !count_secret) { ret true; }
                    }
                    if (case_id == CODEGEN_CASE_WIDE_SECRET_RETURN
                        && ins.kind == instruction.OP_RET && ins.operand_count >= 1
                        && ins.operands[0].secret
                        && ir_type.byte_size_for_machine(?m.types, ins.operands[0].ty, resolved.layout_machine(?p.target))
                        > p.target.isa.pointer_width) { ret true; }
                    if (case_id == CODEGEN_CASE_WIDE_SECRET_CALL
                        && ins.kind == instruction.OP_CALL && ins.secret
                        && ir_type.byte_size_for_machine(?m.types, ins.ty, resolved.layout_machine(?p.target))
                        > p.target.isa.pointer_width) { ret true; }
                    if (case_id == CODEGEN_CASE_SECRET_MEMORY_ADDRESS) {
                        if (ins.kind == instruction.OP_LOAD && ins.operand_count >= 1
                            && ins.operands[0].secret) { ret true; }
                        if (ins.kind == instruction.OP_STORE && ins.operand_count >= 2
                            && ins.operands[1].secret) { ret true; }
                        if (ins.kind == instruction.OP_MEMZERO && ins.operand_count >= 1
                            && ins.operands[0].secret) { ret true; }
                    }
                    ii = ii + 1;
                }
                fi = fi + 1;
            }
        }
        ti = ti + 1;
    }
    if (case_id == CODEGEN_CASE_DECLASSIFIED_MUL) {
        ret saw_declassify && saw_public_mul;
    }
    ret false;
}

fun ut_codegen_artifact_valid(p: *project.Project) bool {
    if (p.emit_len == 0) { ret false; }
    var i: u32 = 0;
    for (i < p.emit_len) {
        val m: *project.ModuleEntry = ?p.modules[p.topo[i]::u32];
        if (m.object_image == nil || m.object_image.sections == nil
            || m.object_image.section_count == 0) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun ut_run_codegen_case(p: *project.Project, case_name: str, case_id: CodegenTestCase,
    excluded: CodegenTestCase, expected: CodegenTestExpected) CodegenTestOutcome {
    val se: err[outcome.Fail] = driver.run_sema_pass(p);
    if (sel se.err) {
        ret ut_codegen_outcome(CODEGEN_TEST_COMPILER_REJECTION, CODEGEN_TEST_SEMA, case_id, case_name);
    }
    val le: err[outcome.Fail] = driver.run_lower_pass(p);
    if (sel le.err) {
        ret ut_codegen_outcome(CODEGEN_TEST_COMPILER_REJECTION, CODEGEN_TEST_LOWER, case_id, case_name);
    }
    if (p.emit_len == 0) {
        ret ut_codegen_outcome(CODEGEN_TEST_EMPTY_SELECTION, CODEGEN_TEST_SELECT, case_id, case_name);
    }
    if (!ut_codegen_case_selected(p, case_id)) {
        ret ut_codegen_outcome(CODEGEN_TEST_NAMED_CASE_MISSING, CODEGEN_TEST_SELECT, case_id, case_name);
    }
    if (expected == CODEGEN_EXPECT_EXCLUSION
        && (excluded == CODEGEN_CASE_NONE || ut_codegen_case_selected(p, excluded))) {
        ret ut_codegen_outcome(CODEGEN_TEST_NAMED_CASE_EXECUTED, CODEGEN_TEST_SELECT, case_id, case_name);
    }

    val ce: err[outcome.Fail] = driver.run_codegen_pass(p);
    if (sel ce.err) {
        ret ut_codegen_outcome(CODEGEN_TEST_COMPILER_REJECTION, CODEGEN_TEST_CODEGEN, case_id, case_name);
    }
    if (!ut_codegen_artifact_valid(p)) {
        ret ut_codegen_outcome(CODEGEN_TEST_ARTIFACT_FAILURE, CODEGEN_TEST_ARTIFACT, case_id, case_name);
    }
    if (expected == CODEGEN_EXPECT_EXCLUSION) {
        ret ut_codegen_outcome(CODEGEN_TEST_EXPECTED_EXCLUSION, CODEGEN_TEST_ARTIFACT, case_id, case_name);
    }
    ret ut_codegen_outcome(CODEGEN_TEST_PASS, CODEGEN_TEST_ARTIFACT, case_id, case_name);
}

fun ut_vec_codegen_defined(src: str, case_name: str, case_id: CodegenTestCase) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) {
        ret ut_codegen_result(ut_codegen_outcome(CODEGEN_TEST_SETUP_FAILURE, CODEGEN_TEST_SETUP,
            case_id, case_name), CODEGEN_EXPECT_PASS, case_id);
    }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) {
        ret ut_codegen_result(ut_codegen_outcome(CODEGEN_TEST_SETUP_FAILURE, CODEGEN_TEST_SETUP,
            case_id, case_name), CODEGEN_EXPECT_PASS, case_id);
    }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = src;
    val pr: res[project.Project, outcome.Fail] = ut_build(?s, ?alloc, ?names[0], ?texts[0], 1);
    if (sel pr.err) {
        session.dnit(?s);
        ret ut_codegen_result(ut_codegen_outcome(CODEGEN_TEST_SETUP_FAILURE, CODEGEN_TEST_SETUP,
            case_id, case_name), CODEGEN_EXPECT_PASS, case_id);
    }
    var p:   project.Project    = pr.ok;
    val got: CodegenTestOutcome = ut_run_codegen_case(?p, case_name, case_id,
        CODEGEN_CASE_NONE, CODEGEN_EXPECT_PASS);
    project.dnit_project(?p);
    session.dnit(?s);
    ret ut_codegen_result(got, CODEGEN_EXPECT_PASS, case_id);
}

fun ut_run_codegen_err(p: *project.Project, needle: str) i32 {
    val se: err[outcome.Fail] = driver.run_sema_pass(p);
    if (sel se.err) { ret 1; }
    val le: err[outcome.Fail] = driver.run_lower_pass(p);
    if (sel le.err) { ret 1; }
    val ce: err[outcome.Fail] = driver.run_codegen_pass(p);
    if (sel ce.err
        && ut_str_contains(outcome.describe(ce.err), needle)) { ret 0; }
    ret 1;
}

fun ut_run_codegen_without(p: *project.Project, case_name: str, case_id: CodegenTestCase,
    excluded: CodegenTestCase) i32 {
    val got: CodegenTestOutcome = ut_run_codegen_case(p, case_name, case_id,
        excluded, CODEGEN_EXPECT_EXCLUSION);
    ret ut_codegen_result(got, CODEGEN_EXPECT_EXCLUSION, case_id);
}

fun ut_run_codegen_ok(p: *project.Project) i32 {
    val se: err[outcome.Fail] = driver.run_sema_pass(p);
    if (sel se.err) { ret 1; }
    val le: err[outcome.Fail] = driver.run_lower_pass(p);
    if (sel le.err) { ret 1; }
    val ce: err[outcome.Fail] = driver.run_codegen_pass(p);
    if (sel ce.err) { ret 1; }
    ret 0;
}

fun ut_codegen_target_ok(src: str, target_name: str) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = src;
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str               = root_r.ok;
    val rr:   err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var tsel_1773: manifest.Selection                 = ut_target_sel(target_name);
    val pr:        res[project.Project, outcome.Fail] = driver.build_project(?s, root, ?tsel_1773);
    fs.remove_all(?alloc, root);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    val code: i32 = ut_run_codegen_ok(?p);
    project.dnit_project(?p);
    session.dnit(?s);
    ret code;
}

fun ut_codegen_rejects(src: str, needle: str) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = src;
    val pr: res[project.Project, outcome.Fail] = ut_build(?s, ?alloc, ?names[0], ?texts[0], 1);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    val code: i32 = ut_run_codegen_err(?p, needle);
    project.dnit_project(?p);
    session.dnit(?s);
    ret code;
}

fun ut_codegen_target_rejects(src: str, target_name: str, needle: str) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = src;
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str               = root_r.ok;
    val rr:   err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var tsel_1821: manifest.Selection                 = ut_target_sel(target_name);
    val pr:        res[project.Project, outcome.Fail] = driver.build_project(?s, root, ?tsel_1821);
    fs.remove_all(?alloc, root);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    val code: i32 = ut_run_codegen_err(?p, needle);
    project.dnit_project(?p);
    session.dnit(?s);
    ret code;
}

fun ut_lower_rejects(src: str, needle: str) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = src;
    val pr: res[project.Project, outcome.Fail] = ut_build(?s, ?alloc, ?names[0], ?texts[0], 1);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    var code: i32               = 1;
    val se:   err[outcome.Fail] = driver.run_sema_pass(?p);
    if (sel se.ok) {
        val le: err[outcome.Fail] = driver.run_lower_pass(?p);
        if (sel le.err && ut_diag_has(?p.s.diags, needle)) { code = 0; }
    }
    project.dnit_project(?p);
    session.dnit(?s);
    ret code;
}

fun ut_cc_src(pre: str, body: str) str {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret body; }
    val head: str = ut_cc3(?alloc, pre, body, "fun main() i32 { ret 0; }\n");
    ret head;
}

fun ut_lower_ok(src: str) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = src;
    val pr: res[project.Project, outcome.Fail] = ut_build(?s, ?alloc, ?names[0], ?texts[0], 1);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    var code: i32               = 1;
    val se:   err[outcome.Fail] = driver.run_sema_pass(?p);
    if (sel se.ok) {
        val le: err[outcome.Fail] = driver.run_lower_pass(?p);
        if (sel le.ok) { code = 0; }
    }
    project.dnit_project(?p);
    session.dnit(?s);
    ret code;
}

fun ut_lower_rejects_at(src: str, needle: str, want_offset: usize, want_len: usize) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = src;
    val pr: res[project.Project, outcome.Fail] = ut_build(?s, ?alloc, ?names[0], ?texts[0], 1);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    var code: i32               = 1;
    val se:   err[outcome.Fail] = driver.run_sema_pass(?p);
    if (sel se.ok) {
        val le: err[outcome.Fail] = driver.run_lower_pass(?p);
        if (sel le.err) {
            var i: usize = 0;
            for (i < diagnostic.len(?p.s.diags)) {
                if (p.s.diags.items.data[i].severity == diagnostic.SEVERITY_ERROR
                    && ut_str_contains(p.s.diags.items.data[i].message, needle)
                    && p.s.diags.items.data[i].loc.span.offset == want_offset
                    && p.s.diags.items.data[i].loc.span.len == want_len) {
                    code = 0;
                }
                i = i + 1;
            }
        }
    }
    project.dnit_project(?p);
    session.dnit(?s);
    ret code;
}

test "mach.lang.driver:unknown_escape_has_location" {
    var bad: i32 = 0;
    if (ut_lower_rejects_at("fun main() i32 { val s: *u8 = \"\\b\"; ret 0; }\n",
        "lower: unknown escape sequence in string literal", 30, 4) != 0) { bad = 1; }
    if (ut_lower_ok("fun main() i32 { val s: *u8 = \"\\x08\"; ret 0; }\n") != 0) { bad = 1; }
    ret bad;
}

test "mach.lang.driver:coerced_char_literal_lowers_at_context_width" {
    var bad: i32 = 0;
    if (!ut_lower_clean("fun f() u64 { ret '0'; }\nfun main() i32 { ret 0; }\n"))                             { bad = 1; }
    if (!ut_lower_clean("fun f(v: u64) u8 { ret ('0' + v % 10)::u8; }\nfun main() i32 { ret f(2)::i32; }\n")) { bad = 1; }
    if (!ut_lower_clean("fun f(v: u64) u8 { ret (v % 10 + '0')::u8; }\nfun main() i32 { ret f(2)::i32; }\n")) { bad = 1; }
    if (!ut_lower_clean("fun f(v: u64) u64 { ret ('0' + v)::u64; }\nfun main() i32 { ret f(2)::i32; }\n"))    { bad = 1; }
    ret bad;
}

test "mach.lang.driver:literal_subtree_partial_coercion_leaves_no_stale_type" {
    var bad: i32 = 0;
    if (ut_arith_operand_mismatches("fun f(a: f32, b: f32) f32 { ret a * (3.0 - 2.0 * b); }\nfun main() i32 { ret 0; }\n") != 0)         { bad = 1; }
    if (ut_arith_operand_mismatches("fun f(a: f32, b: f32) f32 { ret a * (1.0 + (3.0 - 2.0 * b)); }\nfun main() i32 { ret 0; }\n") != 0) { bad = 1; }
    if (ut_arith_operand_mismatches("fun f(a: i32, b: i32) i32 { ret a * (3 - 2 * b); }\nfun main() i32 { ret 0; }\n") != 0)             { bad = 1; }
    ret bad;
}

test "mach.lang.driver:vector_isel_defined" {
    var bad: i32 = 0;
    if (ut_vec_codegen_defined("fun addv(a: *f32x4, b: *f32x4, out: *f32x4) { @out = @a + @b; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { addv(argv:~*f32x4, argv:~*f32x4, argv:~*f32x4); ret 0; }\n",
        "vector add", CODEGEN_CASE_VECTOR_ADD) != 0) { bad = 1; }
    if (ut_vec_codegen_defined("fun mk(out: *f32x4) { @out = f32x4{1.0, 2.0, 3.0, 4.0}; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { mk(argv:~*f32x4); ret 0; }\n",
        "vector literal", CODEGEN_CASE_VECTOR_BUILD) != 0) { bad = 1; }
    ret bad;
}

test "mach.lang.driver:codegen_terminal_oracle_rejects_mutations" {
    if (ut_vec_codegen_defined("#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "missing multiply", CODEGEN_CASE_PUBLIC_MUL) == 0) { ret 1; }

    if (ut_vec_codegen_defined("#[oblivious]\nfun bad(a: ^u32, b: ^u32) ^u32 { ret a * b; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { bad(1, 2); ret 0; }\n",
        "rejected secret multiply", CODEGEN_CASE_SECRET_MUL) == 0) { ret 1; }

    if (ut_vec_codegen_defined("fun good(a: u32, b: u32) u32 { ret a * b; }\n#[oblivious]\nfun bad(a: ^u32, b: ^u32) ^u32 { ret a * b; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { good(1, 2); bad(1, 2); ret 0; }\n",
        "public multiply with unrelated rejection", CODEGEN_CASE_PUBLIC_MUL) == 0) { ret 1; }
    ret 0;
}

fun ut_vec_lower(s: *session.Session, alloc: *A.Allocator, src: str, target_name: str) res[project.Project, outcome.Fail] {
    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = src;
    val root_r: res[str, fail.Fail] = ut_scaffold_m(alloc, ut_manifest_spirv(), ?names[0], ?texts[0], 1);
    if (sel root_r.err) { ret res[project.Project, outcome.Fail].err{outcome.from_fail(root_r.err)}; }
    val root: str               = root_r.ok;
    val rr:   err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.err) {
        fs.remove_all(alloc, root);
        ret res[project.Project, outcome.Fail].err{rr.err};
    }
    var tsel_1984: manifest.Selection                 = ut_target_sel(target_name);
    val pr:        res[project.Project, outcome.Fail] = driver.build_project(s, root, ?tsel_1984);
    fs.remove_all(alloc, root);
    if (sel pr.err) { ret pr; }
    var p:  project.Project   = pr.ok;
    val se: err[outcome.Fail] = driver.run_sema_pass(?p);
    if (sel se.err) {
        project.dnit_project(?p);
        ret res[project.Project, outcome.Fail].err{se.err};
    }
    val le: err[outcome.Fail] = driver.run_lower_pass(?p);
    if (sel le.err) {
        project.dnit_project(?p);
        ret res[project.Project, outcome.Fail].err{le.err};
    }
    ret res[project.Project, outcome.Fail].ok{p};
}

# the same through a chosen optimization level, so the release pipeline's SROA and mem2reg run before inspection
fun ut_vec_lower_opt(s: *session.Session, alloc: *A.Allocator, src: str, target_name: str, found: pipeline.OptLevel) res[project.Project, outcome.Fail] {
    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = src;
    val root_r: res[str, fail.Fail] = ut_scaffold_m(alloc, ut_manifest_spirv(), ?names[0], ?texts[0], 1);
    if (sel root_r.err) { ret res[project.Project, outcome.Fail].err{outcome.from_fail(root_r.err)}; }
    val root: str               = root_r.ok;
    val rr:   err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.err) {
        fs.remove_all(alloc, root);
        ret res[project.Project, outcome.Fail].err{rr.err};
    }
    var tsel: manifest.Selection                 = ut_target_sel(target_name);
    val pr:   res[project.Project, outcome.Fail] = driver.build_project(s, root, ?tsel);
    fs.remove_all(alloc, root);
    if (sel pr.err) { ret pr; }
    var p: project.Project = pr.ok;
    p.req.opt = found;
    val se: err[outcome.Fail] = driver.run_sema_pass(?p);
    if (sel se.err) {
        project.dnit_project(?p);
        ret res[project.Project, outcome.Fail].err{se.err};
    }
    val le: err[outcome.Fail] = driver.run_lower_pass(?p);
    if (sel le.err) {
        project.dnit_project(?p);
        ret res[project.Project, outcome.Fail].err{le.err};
    }
    ret res[project.Project, outcome.Fail].ok{p};
}

fun ut_count_geps_into_vector(p: *project.Project, total: *u32, into_vec: *u32, lane_ops: *u32) {
    @total    = 0;
    @into_vec = 0;
    @lane_ops = 0;
    var ti: u32 = 0;
    for (ti < p.topo_len) {
        val m: *ir.Module = p.modules[p.topo[ti]::u32].ir_module;
        if (m != nil) {
            var fi: u32 = 0;
            for (fi < m.function_len) {
                val fn: *ir.Function = ?m.functions[fi];
                var bi: u32          = 0;
                for (bi < fn.block_count) {
                    val blk: *ir.Block = ?fn.blocks[bi];
                    var ix:  u32       = 0;
                    for (ix < blk.instr_count) {
                        val ins: *instruction.Instruction = ?fn.instrs[blk.instructions[ix]];
                        if (ins.kind == instruction.OP_GEP) {
                            @total = @total + 1;
                            if (ir_type.is_vector(?m.types, ins.aux_ty)) { @into_vec = @into_vec + 1; }
                        }
                        if (ins.kind == instruction.OP_VEC_EXTRACT || ins.kind == instruction.OP_VEC_INSERT) {
                            @lane_ops = @lane_ops + 1;
                        }
                        ix = ix + 1;
                    }
                    bi = bi + 1;
                }
                fi = fi + 1;
            }
        }
        ti = ti + 1;
    }
}

fun ut_count_vector_typed_instrs(p: *project.Project) u32 {
    var n:  u32 = 0;
    var ti: u32 = 0;
    for (ti < p.topo_len) {
        val m: *ir.Module = p.modules[p.topo[ti]::u32].ir_module;
        if (m != nil) {
            var fi: u32 = 0;
            for (fi < m.function_len) {
                val fn: *ir.Function = ?m.functions[fi];
                var bi: u32          = 0;
                for (bi < fn.block_count) {
                    val blk: *ir.Block = ?fn.blocks[bi];
                    var ix:  u32       = 0;
                    for (ix < blk.instr_count) {
                        val ins: *instruction.Instruction = ?fn.instrs[blk.instructions[ix]];
                        if (ir_type.is_vector(?m.types, ins.ty)) { n = n + 1; }
                        ix = ix + 1;
                    }
                    bi = bi + 1;
                }
                fi = fi + 1;
            }
        }
        ti = ti + 1;
    }
    ret n;
}

test "mach.lang.me.pass.scalarize:vector_bitcast_does_not_survive" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    val src: str = "pub fun pick(m: u8x16, a: i8x16, b: i8x16) i8x16 {\n    ret ((m & a:~u8x16) | (~m & b:~u8x16)):~i8x16;\n}\nfun main() i32 { ret 0; }\n";

    var bad: i32                                = 0;
    val pr:  res[project.Project, outcome.Fail] = ut_vec_lower(?s, ?alloc, src, "linux-riscv64");
    if (sel pr.err) { bad = 1; }
    if (sel pr.ok) {
        var p: project.Project = pr.ok;
        if (ut_count_vector_typed_instrs(?p) != 0) { bad = 1; }
        project.dnit_project(?p);
    }

    session.dnit(?s);
    ret bad;
}

