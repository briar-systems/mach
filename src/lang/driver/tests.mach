test "mach.lang.driver:union_tuple_gate_bindings_are_isolated" {
    var names: [5]str;
    names[0] = "main.mach";
    names[1] = "linux_flag.mach";
    names[2] = "windows_flag.mach";
    names[3] = "yes.mach";
    names[4] = "no.mach";
    var texts: [5]str;
    texts[0] = "$if ($mach.build.os == $mach.os.linux) { use chosen: uniontest.linux_flag; } $or { use chosen: uniontest.windows_flag; }\n$if (chosen.ENABLED) { use uniontest.yes; } $or { use uniontest.no; }\nfun main() i32 { ret 0; }\n";
    texts[1] = "pub def Flag: u8;\npub val ENABLED: Flag = 1;\n";
    texts[2] = "pub def Flag: u8;\npub val ENABLED: Flag = 0;\n";
    texts[3] = "pub fun yes() i32 { ret 1; }\n";
    texts[4] = "pub fun no() i32 { ret 0; }\n";
    if (ut_union_gate_result_n(?names[0], ?texts[0], 5, "", "") != 0) { ret 1; }

    names[0] = "main.mach";
    names[1] = "linux_flag.mach";
    names[2] = "yes.mach";
    texts[0] = "$if ($mach.build.os == $mach.os.linux) { use chosen: uniontest.linux_flag; $if (chosen.ENABLED) { use uniontest.yes; } }\nfun main() i32 { ret 0; }\n";
    texts[1] = "pub val ENABLED: u8 = 1;\n";
    texts[2] = "pub fun yes() i32 { ret 1; }\n";
    if (ut_union_gate_result_n(?names[0], ?texts[0], 3, "", "unresolved identifier") != 0) { ret 2; }
    ret 0;
}

test "mach.lang.driver:union_tuple_reach_propagates_transitively" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    var names: [3]str;
    names[0] = "main.mach"; names[1] = "a.mach"; names[2] = "b.mach";
    var texts: [3]str;
    texts[0] = "$if ($mach.build.os == $mach.os.linux) { use uniontest.a; }\nfun main() i32 { ret 0; }\n";
    texts[1] = "use uniontest.b;\npub fun a() i32 { ret 1; }\n";
    texts[2] = "$if ($mach.build.os == $mach.os.windows) { def Word: u16; val BAD: Word = 1; $if (BAD) { use uniontest.missing; } }\npub fun b() i32 { ret 2; }\n";
    val pr: R.Result[project.Project, outcome.Fail] = ut_build(?s, ?alloc, ?names[0], ?texts[0], 3);
    if (R.is_err[project.Project, outcome.Fail](pr)) { session.dnit(?s); ret 2; }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);
    var bad: i32 = 0;
    if (ut_count_errors(?s.diags) != 0) { bad = 3; }
    val bmid: session.ModuleId = ut_mid(?p, ?s, "uniontest.b");
    if (bmid == session.MODULE_NIL) { bad = 4; }
    or {
        val bm: *project.ModuleEntry = ?p.modules[bmid::u32];
        if (bm.tuple_reachable == nil || bm.tuple_reach_count != p.union_tuple_count) { bad = 5; }
        or {
            var ti: u32 = 0;
            for (ti < p.union_tuple_count) {
                val should_reach: bool = p.union_tuples[ti].os_id == os.OS_LINUX;
                if (bm.tuple_reachable[ti] != should_reach) { bad = 6; }
                ti = ti + 1;
            }
        }
    }
    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

