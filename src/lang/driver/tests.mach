    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [2]str;
    names[0] = "main.mach";
    names[1] = "bad.mach";
    var texts: [2]str;
    texts[0] = ut_cc3(?alloc, "#[symbol(\"", ut_entry_symbol(), "\")]\nfun start() i32 { ret 0; }\n\ntest \"main.runs\" { ret 0; }\n");
    texts[1] = "pub fun oops() i32 { ret uniontest_undefined_symbol(); }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 2);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    val mr: res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var m:  manifest.Manifest    = mr.ok;
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    rq.goal         = request.GOAL_TESTS;
    val pr: res[bplan.BuildPlan, outcome.Fail] = bplan.plan(?alloc, ?s.interner, s.registry, ?m, rq);
    if (sel pr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var bp: bplan.BuildPlan = pr.ok;

    var bad: i32                                     = 0;
    val r:   res[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, ?alloc, nil);
    if (sel r.err) { bad = 1; }
    if (sel r.ok) {
        var bo: outcome.BuildOutcome = r.ok;
        if (bo.severity == outcome.BUILD_OK) { bad = 1; }
        or (bo.tests.len != 0)               { bad = 1; }
        outcome.outcome_dnit(?bo);
    }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

fun ut_first_gate_cond(a: *ast.Ast) aid.ExprId {
    val m_opt: opt[*amodule.Module] = ast.get_module(a, a.root_module);
    if (sel m_opt.none) { ret aid.EXPR_NIL; }
    val mnode: *amodule.Module = m_opt.some;
    var i:     u32             = 0;
    for (i < mnode.decls_len) {
        val did:   aid.DeclId      = a.decl_ids[mnode.decls_start + i];
        val d_opt: opt[*decl.Decl] = ast.get_decl(a, did);
        if (sel d_opt.some) {
            val d: *decl.Decl = d_opt.some;
            if (d.kind == decl.DECL_KIND_COMPTIME_IF && d.data.comptime_if.branches_len > 0) {
                ret (?a.comptime_branches[d.data.comptime_if.branches_start]).cond;
            }
        }
        i = i + 1;
    }
    ret aid.EXPR_NIL;
}

fun ut_module_gate_state(p: *project.Project, s: *session.Session, fqn: str, cond: aid.ExprId) comptime.GateState {
    val idr: res[intern.StrId, A.Error] = intern.intern(?s.interner, fqn);
    if (sel idr.err) { ret comptime.GATE_STATE_UNKNOWN; }
    var name: intern.StrId           = idr.ok;
    val mr:   opt[*session.ModuleId] = map.get[intern.StrId, session.ModuleId](?p.by_fqn, ?name);
    if (sel mr.none) { ret comptime.GATE_STATE_UNKNOWN; }
    val mid: session.ModuleId = mr.some[0];
    ret comptime.gate_state(?(?p.modules[mid::u32]).ctx, cond);
}

test "mach.lang.driver:one_gate_decides_the_same_in_every_phase" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [2]str;
    names[0] = "main.mach";
    names[1] = "lib.mach";
    var texts: [2]str;
    texts[0] = "val FLAG: u8 = 1;\n$if (FLAG) { use uniontest.lib; fun picked() i32 { ret lib.value(); } } $or { use uniontest.missing; }\nfun probe[T](x: T) i32 { $if (FLAG) { ret 1; } ret 0; }\nfun main() i32 { ret picked() + probe[i32](1); }\n";
    texts[1] = "pub fun value() i32 { ret 7; }\n";

    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 2);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root:             str               = root_r.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 2;
    }
    var tsel_19516: manifest.Selection                 = ut_target_sel("linux");
    val pr:         res[project.Project, outcome.Fail] = driver.build_project(?s, root, ?tsel_19516);
    fs.remove_all(?alloc, root);
    if (sel pr.err) {
        session.dnit(?s);
        ret 3;
    }
    var p: project.Project = pr.ok;

    var bad: i32      = 0;
    val a:   *ast.Ast = ut_ast(?p, ?s, "uniontest.main");
    if (a == nil) { bad = 4; }
    val cond: aid.ExprId = ut_first_gate_cond(a);
    if (bad == 0 && cond == aid.EXPR_NIL) { bad = 5; }

    if (bad == 0 && !ut_has(?p, ?s, "uniontest.lib"))                                                 { bad = 6; }
    if (bad == 0 && ut_has(?p, ?s, "uniontest.missing"))                                              { bad = 7; }
    if (bad == 0 && ut_module_gate_state(?p, ?s, "uniontest.main", cond) != comptime.GATE_STATE_TRUE) { bad = 8; }

    if (bad == 0) {
        val se: err[outcome.Fail] = driver.run_sema_pass(?p);
        if (sel se.err)                                                                       { bad = 9; }
        or (ut_count_errors(?p.s.diags) != 0)                                                 { bad = 10; }
        or (ut_module_gate_state(?p, ?s, "uniontest.main", cond) != comptime.GATE_STATE_TRUE) { bad = 11; }
    }
    if (bad == 0) {
        val le: err[outcome.Fail] = driver.run_lower_pass(?p);
        if (sel le.err)                                                                       { bad = 12; }
        or (ut_module_gate_state(?p, ?s, "uniontest.main", cond) != comptime.GATE_STATE_TRUE) { bad = 13; }
    }

    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.driver:undecided_gate_is_retried_when_its_dependency_binds" {
    if (ut_single_ok("$if (LATER) { fun picked() i32 { ret 3; } }\nval LATER: u8 = 1;\nfun main() i32 { ret picked(); }\n") != 0)                                     { ret 1; }
    if (ut_single_ok("$if (LATER == 1) { fun picked() i32 { ret 3; } } $or { use uniontest.missing; }\nval LATER: u8 = 1;\nfun main() i32 { ret picked(); }\n") != 0) { ret 2; }
    if (ut_single_ok2("$if (lib.LATER) { fun picked() i32 { ret 3; } }\nuse uniontest.lib;\nfun main() i32 { ret picked(); }\n", "pub val LATER: u8 = 1;\n") != 0)    { ret 3; }
    ret 0;
}

fun ut_gate_diag_located(text: str, needle: str, want_file: str, want_line: usize,
    want_col: usize, want_text: str) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:     session.Session = sr.ok;
    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = text;
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root:             str               = root_r.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 2;
    }
    var tsel_19570: manifest.Selection                 = ut_target_sel("linux");
    val pr:         res[project.Project, outcome.Fail] = driver.build_project(?s, root, ?tsel_19570);
    fs.remove_all(?alloc, root);

    var code: i32   = 3;
    var i:    usize = 0;
    for (i < diagnostic.len(?s.diags)) {
        val d: *diagnostic.Diagnostic = ?s.diags.items.data[i];
        if (d.severity == diagnostic.SEVERITY_ERROR && ut_str_contains(d.message, needle)) {
            code = 0;
            val f_opt: opt[*src.SourceFile] = src.get(?s.sources, d.loc.file_id);
            if (sel f_opt.some) {
                val f: *src.SourceFile = f_opt.some;
                if (!str_contains(f.path, want_file)) { code = 5; }
                or {
                    val pos: src.Position = src.position(f, d.loc.span.offset);
                    if (pos.line != want_line)                                                    { code = 6; }
                    or (pos.col != want_col)                                                      { code = 7; }
                    or (!str_region_equals(f.text, d.loc.span.offset, d.loc.span.len, want_text)) { code = 8; }
                }
            }
            i = diagnostic.len(?s.diags);
        }
        or { i = i + 1; }
    }

    if (sel pr.ok) {
        var p: project.Project = pr.ok;
        project.dnit_project(?p);
    }
    session.dnit(?s);
    ret code;
}

test "mach.lang.driver:a_gate_whose_dependency_never_binds_is_located_and_named" {
    ret ut_gate_diag_located(
        "val OTHER: u8 = 1;\nfun helper() i32 { ret 0; }\n$if (NEVER_BOUND) { fun picked() i32 { ret 3; } }\nfun main() i32 { ret helper(); }\n",
        "is never decided: `NEVER_BOUND`", "main.mach", 3, 6, "NEVER_BOUND");
}

test "mach.lang.driver:a_stalled_gate_fixpoint_fails_as_reported_with_no_unlocated_line" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:     session.Session = sr.ok;
    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "val OTHER: u8 = 1;\nfun helper() i32 { ret 0; }\n$if (NEVER_BOUND) { fun picked() i32 { ret 3; } }\nfun main() i32 { ret helper(); }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root:             str               = root_r.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 2;
    }
    var tsel_19625: manifest.Selection                 = ut_target_sel("linux");
    val pr:         res[project.Project, outcome.Fail] = driver.build_project(?s, root, ?tsel_19625);
    fs.remove_all(?alloc, root);

    var code: i32 = 0;
    if (sel pr.ok) {
        var p: project.Project = pr.ok;
        project.dnit_project(?p);
        code = 3;
    }
    if (sel pr.err) {
        val f: outcome.Fail = pr.err;
        if (!sel f.reported) { code = 4; }
    }
    var located: bool  = false;
    var i:       usize = 0;
    for (i < diagnostic.len(?s.diags)) {
        val d: *diagnostic.Diagnostic = ?s.diags.items.data[i];
        if (ut_str_contains(d.message, "could not be resolved"))                                                      { code = 6; }
        if (d.severity == diagnostic.SEVERITY_ERROR && ut_str_contains(d.message, "is never decided: `NEVER_BOUND`")) { located = true; }
        i = i + 1;
    }
    if (!located && code == 0) { code = 7; }
    session.dnit(?s);
    ret code;
}

test "mach.lang.driver:bare_import_of_a_dependency_whose_artifacts_name_different_entries_says_so" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }

    val origin: str = "https://example.invalid/split.git";
    var names:  [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "use split;\n\nfun main() i32 { ret 0; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold_m(?alloc,
        ut_dep_root_git(?alloc, "split", origin), ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root:         str = root_r.ok;
    val dep_root:     str = ut_cc3(?alloc, root, "/", "dep/split");
    val dep_manifest: str = "[project]\nid = \"split\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[artifact.one]\nkind = \"static\"\nentry = \"one.mach\"\nout = \"lib/one\"\ntargets = [\"*\"]\nlink = []\nneed = []\n\n[artifact.two]\nkind = \"static\"\nentry = \"two.mach\"\nout = \"lib/two\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n";
    var dep_names:    [2]str;
    dep_names[0] = "one.mach";
    dep_names[1] = "two.mach";
    var dep_texts: [2]str;
    dep_texts[0] = "pub fun v() i32 { ret 1; }\n";
    dep_texts[1] = "pub fun v() i32 { ret 2; }\n";
    val wr: err[fail.Fail] = ut_write_node_multi(?alloc, dep_root, dep_manifest, ?dep_names[0], ?dep_texts[0], 2);
    if (sel wr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    if (!ut_git_repo(?alloc, dep_root, origin)) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    if (!ut_write_gitmodules(?alloc, root, "split", origin)) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    if (!ut_git_repo(?alloc, root, "https://example.invalid/app.git")) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }

    var bad:    i32                                = 0;
    val needle: str                                = "project 'split' has no public module: a bare import binds the entry shared by its library artifacts marked `default = true`";
    val pr:     res[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
    if (sel pr.ok) {
        var p: project.Project = pr.ok;
        project.dnit_project(?p);
        bad = 1;
    }
    if (sel pr.err) {
        var seen: bool  = ut_str_contains(outcome.describe(pr.err), needle);
        var i:    usize = 0;
        for (i < diagnostic.len(?s.diags)) {
            if (ut_str_contains(s.diags.items.data[i].message, needle)) { seen = true; }
            i = i + 1;
        }
        if (!seen) { bad = 2; }
    }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

# intentional removal test (#3226, #3112): an artifact-less dependency has no
# public module; the implicit lib.mach entry is gone and the refusal says so,
# while a full-path import of the same module still binds
test "mach.lang.driver:bare_import_of_an_artifact_less_dependency_names_the_removed_lib_mach_fallback" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }

    val origin: str = "https://example.invalid/bare.git";
    var names:  [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "use bare;\n\nfun main() i32 { ret bare.v(); }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold_m(?alloc,
        ut_dep_root_git(?alloc, "bare", origin), ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root:         str            = root_r.ok;
    val dep_root:     str            = ut_cc3(?alloc, root, "/", "dep/bare");
    val dep_manifest: str            = "[project]\nid = \"bare\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n";
    val wr:           err[fail.Fail] = ut_write_node(?alloc, dep_root, dep_manifest, "lib.mach", "pub fun v() i32 { ret 0; }\n");
    if (sel wr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    if (!ut_git_repo(?alloc, dep_root, origin)) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    if (!ut_write_gitmodules(?alloc, root, "bare", origin)) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    if (!ut_git_repo(?alloc, root, "https://example.invalid/app.git")) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }

    var bad:    i32                                = 0;
    val needle: str                                = "project 'bare' declares no artifact, so it has no public module; the implicit `lib.mach` entry of an artifact-less dependency was removed in 5.0.0";
    val pr:     res[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
    if (sel pr.ok) {
        var p: project.Project = pr.ok;
        project.dnit_project(?p);
        bad = 1;
    }
    if (sel pr.err) {
        var seen: bool  = ut_str_contains(outcome.describe(pr.err), needle);
        var i:    usize = 0;
        for (i < diagnostic.len(?s.diags)) {
            if (ut_str_contains(s.diags.items.data[i].message, needle)) { seen = true; }
            i = i + 1;
        }
        if (!seen) { bad = 2; }
    }

    # the full-path import needs no default artifact
    if (bad == 0) {
        val main_path: str             = ut_cc3(?alloc, root, "/src/", "main.mach");
        val full:      str             = "use bare.lib;\n\nfun main() i32 { ret lib.v(); }\n";
        val ww:        err[fs.FsError] = fs.write_bytes(main_path, full, str_len(full), 420);
        if (sel ww.err) { bad = 3; }
        or {
            val pr2: res[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
            if (sel pr2.err) { bad = 4; }
            if (sel pr2.ok) {
                var p2: project.Project = pr2.ok;
                project.dnit_project(?p2);
            }
        }
    }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

# intentional removal test (#3226, #3112): a test build over several artifacts
# with none marked default is refused at planning, naming the default key
test "mach.lang.driver:a_test_build_over_several_artifacts_without_a_default_is_refused_at_planning" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "fun main() i32 { ret 0; }\n\ntest \"t\" { ret 0; }\n";
    val manifest_text: str                 = "[project]\nid = \"twobins\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.linux]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[profile.debug]\nopt = 0\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n\n[artifact.first]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/first\"\ntargets = [\"*\"]\nlink = []\nneed = []\n\n[artifact.second]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/second\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
    val root_r:        res[str, fail.Fail] = ut_scaffold_m(?alloc, manifest_text, ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    var bad: i32                                  = 0;
    val mr:  res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) { bad = 1; }
    if (sel mr.ok) {
        var m:   manifest.Manifest = mr.ok;
        var cli: request.CliArgs;
        cli.verbosity    = 0;
        cli.quiet        = false;
        cli.target       = "linux";
        cli.output       = nil;
        cli.emit_asm     = false;
        cli.emit_ir      = false;
        cli.profile      = nil;
        cli.bin          = nil;
        cli.lib          = nil;
        cli.all_targets  = false;
        cli.pie          = false;
        cli.subsystem    = nil;
        cli.g            = false;
        cli.opt_set      = false;
        cli.opt_release  = false;
        cli.jobs         = "1";
        cli.include_deps = false;
        cli.link_tokens  = vector.init[*u8](?alloc);
        cli.lib_dirs     = vector.init[*u8](?alloc);
        var pick: manifest.Selection                      = ut_target_sel("linux");
        val rr:   res[request.BuildRequest, outcome.Fail] = request.compose(?alloc, ?s.interner, ?m, ?cli, root, request.GOAL_TESTS, ?pick);
        if (sel rr.err) { bad = 2; }
        if (sel rr.ok) {
            val br: res[plan.BuildPlan, outcome.Fail] = plan.plan(?alloc, ?s.interner, s.registry, ?m, rr.ok);
            if (sel br.ok) { bad = 3; }
            if (sel br.err) {
                if (!outcome.is_user(br.err))                                                                                                        { bad = 4; }
                if (!ut_str_contains(outcome.describe(br.err), "several artifacts support the selected target and none is marked `default = true`")) { bad = 5; }
            }
        }
        manifest.dnit(?m, ?alloc);
    }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

# intentional removal test (#3226, #3112): a removed manifest key is refused for
# the root and for a dependency, each diagnostic naming the removal
test "mach.lang.driver:removed_manifest_keys_are_refused_for_the_root_and_each_dependency_naming_the_removal" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }

    val origin: str = "https://example.invalid/old.git";
    var names:  [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "fun main() i32 { ret 0; }\n";
    val clean_head:    str                 = "[project]\nid = \"app\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.linux]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[profile.debug]\nopt = 0\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n";
    val root_tail:     str                 = "\n[artifact.app]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/app\"\ntargets = [\"*\"]\nlink = []\nneed = []\n\n[dep.old]\ngit = \"https://example.invalid/old.git\"\nref = \"branch/main\"\n";
    val root_manifest: str                 = ut_cc3(?alloc, clean_head, "emit_ir = true\n", root_tail);
    val root_r:        res[str, fail.Fail] = ut_scaffold_m(?alloc, root_manifest, ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root:            str            = root_r.ok;
    val dep_root:        str            = ut_cc3(?alloc, root, "/", "dep/old");
    val dep_manifest:    str            = "[project]\nid = \"old\"\ndescription = \"an old library\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[artifact.lib]\nkind = \"static\"\nentry = \"lib.mach\"\nout = \"lib/l\"\ntargets = [\"*\"]\nlink = []\nneed = []\ndefault = true\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n";
    val ut_write_node_r: err[fail.Fail] = ut_write_node(?alloc, dep_root, dep_manifest, "lib.mach", "pub fun v() i32 { ret 1; }\n");
    if (sel ut_write_node_r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    if (!ut_git_repo(?alloc, dep_root, origin)) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    if (!ut_write_gitmodules(?alloc, root, "old", origin)) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    if (!ut_git_repo(?alloc, root, "https://example.invalid/app.git")) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }

    var bad: i32                                = 0;
    val pr:  res[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
    if (sel pr.ok) {
        var p: project.Project = pr.ok;
        project.dnit_project(?p);
        bad = 2;
    }
    if (sel pr.err) {
        if (!ut_str_contains(outcome.describe(pr.err), "mach.toml: [profile.debug] key 'emit_ir' was removed in 5.0.0; it was accepted and never read: remove the key")) { bad = 3; }
    }

    # with the root clean, the dependency's removed key is refused under its name
    if (bad == 0) {
        val fixed: str             = ut_cc3(?alloc, clean_head, "", root_tail);
        val mpath: str             = ut_cc3(?alloc, root, "/", "mach.toml");
        val wr:    err[fs.FsError] = fs.write_bytes(mpath, fixed, str_len(fixed), 420);
        if (sel wr.err) { bad = 4; }
        or {
            val pr2: res[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
            if (sel pr2.ok) {
                var p2: project.Project = pr2.ok;
                project.dnit_project(?p2);
                bad = 5;
            }
            if (sel pr2.err) {
                if (!ut_str_contains(outcome.describe(pr2.err), "dep 'old': mach.toml: [project] key 'description' was removed in 5.0.0")) { bad = 6; }
            }
        }
    }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

fun ut_spirv_float_remainder(src: str) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:     session.Session = sr.ok;
    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = src;
    val pr: res[project.Project, outcome.Fail] = ut_spv_lower(?s, ?alloc, ?names[0], ?texts[0], 1, "", nil, nil, 0);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p:     project.Project = pr.ok;
    var image: of.ObjectImage;
    var fault: str             = nil;
    var bad:   i32             = 0;
    if (!ut_spv_codegen(?p, ?s, "spvcase.main", ?image, ?fault)) {
        print.println(fault);
        bad = 2;
    }
    or { obj.dnit(?image); }
    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.driver:spirv_float_remainder_f32_has_structured_control_flow" {
    ret ut_spirv_float_remainder("pub fun remainder(a: f32, b: f32) f32 { ret a % b; }\n");
}

test "mach.lang.driver:spirv_float_remainder_f64_has_structured_control_flow" {
    ret ut_spirv_float_remainder("pub fun remainder(a: f64, b: f64) f64 { ret a % b; }\n");
}

fun ut_float_zero_program() str {
    ret "val CT_N_D64: u64 = (-6.0f64 % 3.0f64):~u64;\nval CT_N_ND64: u64 = (-6.0f64 % -3.0f64):~u64;\nval CT_P_D64: u64 = (6.0f64 % 3.0f64):~u64;\nval CT_P_ND64: u64 = (6.0f64 % -3.0f64):~u64;\nval CT_NZ_D64: u64 = (-0.0f64 % 3.0f64):~u64;\nval CT_NZ_ND64: u64 = (-0.0f64 % -3.0f64):~u64;\nval CT_Z_D64: u64 = (0.0f64 % 3.0f64):~u64;\nval CT_Z_ND64: u64 = (0.0f64 % -3.0f64):~u64;\nval CT_N_D32: u32 = (-6.0f32 % 3.0f32):~u32;\nval CT_N_ND32: u32 = (-6.0f32 % -3.0f32):~u32;\nval CT_P_D32: u32 = (6.0f32 % 3.0f32):~u32;\nval CT_P_ND32: u32 = (6.0f32 % -3.0f32):~u32;\nval CT_NZ_D32: u32 = (-0.0f32 % 3.0f32):~u32;\nval CT_NZ_ND32: u32 = (-0.0f32 % -3.0f32):~u32;\nval CT_Z_D32: u32 = (0.0f32 % 3.0f32):~u32;\nval CT_Z_ND32: u32 = (0.0f32 % -3.0f32):~u32;\npub var N64: f64 = -6.0f64;\npub var P64: f64 = 6.0f64;\npub var Z64: f64 = 0.0f64;\npub var NZ64: f64 = -0.0f64;\npub var D64: f64 = 3.0f64;\npub var ND64: f64 = -3.0f64;\npub var N32: f32 = -6.0f32;\npub var P32: f32 = 6.0f32;\npub var Z32: f32 = 0.0f32;\npub var NZ32: f32 = -0.0f32;\npub var D32: f32 = 3.0f32;\npub var ND32: f32 = -3.0f32;\nfun check64(a: f64, b: f64, bits: u64) i32 {\n    if ((a % b):~u64 != bits) { ret 1; }\n    ret 0;\n}\nfun check32(a: f32, b: f32, bits: u32) i32 {\n    if ((a % b):~u32 != bits) { ret 1; }\n    ret 0;\n}\n#[symbol(\"probe\")]\nfun probe() i32 {\n    if (CT_N_D64 != 0x8000000000000000) { ret 1; }\n    if (check64(N64, D64, CT_N_D64) != 0) { ret 2; }\n    if (CT_N_ND64 != 0x8000000000000000) { ret 3; }\n    if (check64(N64, ND64, CT_N_ND64) != 0) { ret 4; }\n    if (CT_P_D64 != 0) { ret 5; }\n    if (check64(P64, D64, CT_P_D64) != 0) { ret 6; }\n    if (CT_P_ND64 != 0) { ret 7; }\n    if (check64(P64, ND64, CT_P_ND64) != 0) { ret 8; }\n    if (CT_NZ_D64 != 0x8000000000000000) { ret 9; }\n    if (check64(NZ64, D64, CT_NZ_D64) != 0) { ret 10; }\n    if (CT_NZ_ND64 != 0x8000000000000000) { ret 11; }\n    if (check64(NZ64, ND64, CT_NZ_ND64) != 0) { ret 12; }\n    if (CT_Z_D64 != 0) { ret 13; }\n    if (check64(Z64, D64, CT_Z_D64) != 0) { ret 14; }\n    if (CT_Z_ND64 != 0) { ret 15; }\n    if (check64(Z64, ND64, CT_Z_ND64) != 0) { ret 16; }\n    if (CT_N_D32 != 0x80000000) { ret 17; }\n    if (check32(N32, D32, CT_N_D32) != 0) { ret 18; }\n    if (CT_N_ND32 != 0x80000000) { ret 19; }\n    if (check32(N32, ND32, CT_N_ND32) != 0) { ret 20; }\n    if (CT_P_D32 != 0) { ret 21; }\n    if (check32(P32, D32, CT_P_D32) != 0) { ret 22; }\n    if (CT_P_ND32 != 0) { ret 23; }\n    if (check32(P32, ND32, CT_P_ND32) != 0) { ret 24; }\n    if (CT_NZ_D32 != 0x80000000) { ret 25; }\n    if (check32(NZ32, D32, CT_NZ_D32) != 0) { ret 26; }\n    if (CT_NZ_ND32 != 0x80000000) { ret 27; }\n    if (check32(NZ32, ND32, CT_NZ_ND32) != 0) { ret 28; }\n    if (CT_Z_D32 != 0) { ret 29; }\n    if (check32(Z32, D32, CT_Z_D32) != 0) { ret 30; }\n    if (CT_Z_ND32 != 0) { ret 31; }\n    if (check32(Z32, ND32, CT_Z_ND32) != 0) { ret 32; }\n    ret 0;\n}\n$if ($mach.build.os == $mach.os.windows) {\n    #[symbol(\"mainCRTStartup\")]\n    fun start() i32 { ret probe(); }\n}\n$or {\n    #[symbol(\"_start\")]\n    pub fun start() {\n        $if ($mach.build.arch == $mach.arch.x86_64) {\n            asm x86_64 {\n                and rsp, -16\n                call probe\n                mov edi, eax\n                mov rax, 60\n                syscall\n            }\n        }\n        $or ($mach.build.arch == $mach.arch.aarch64) {\n            asm aarch64 {\n                bl probe\n                mov x8, 93\n                svc 0\n            }\n        }\n        $or {\n            asm riscv64 {\n                call probe\n                li a7, 93\n                ecall\n            }\n        }\n    }\n}\n";
}

fun ut_float_zero_manifest() str {
    ret "[project]\nid=\"remainder\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out/{target.name}/{profile.name}\"\n[target.linux]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[target.windows]\nisa=\"x86_64\"\nos=\"windows\"\nabi=\"win64\"\n[target.linux-arm64]\nisa=\"aarch64\"\nos=\"linux\"\nabi=\"aapcs64\"\n[target.linux-riscv64]\nisa=\"riscv64\"\nos=\"linux\"\nabi=\"lp64d\"\n[profile.debug]\nopt=0\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n[artifact.probe]\nkind=\"bin\"\nentry=\"main.mach\"\nout=\"bin/probe.exe\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n";
}

fun ut_float_zero_profile(alloc: *A.Allocator, root: str, profile_name: str) i32 {
    val sr: res[session.Session, fail.Fail] = session.init(alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) { ret 2; }
    val mr: res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) { ret 3; }
    var m:  manifest.Manifest    = mr.ok;
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    rq.target       = "native";
    rq.profile      = profile_name;
    val pr: res[bplan.BuildPlan, outcome.Fail] = bplan.plan(alloc, ?s.interner, s.registry, ?m, rq);
    if (sel pr.err) { ret 4; }
    var bp: bplan.BuildPlan                         = pr.ok;
    val br: res[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, alloc, nil);
    if (sel br.err) { ret 5; }
    val bo: outcome.BuildOutcome = br.ok;
    if (bo.severity != outcome.BUILD_OK || bo.artifacts.len != 1) { ret 6; }
    var trapped: bool = false;
    var code:    i32  = 0;
    if (!ut_run_with_argc(root, "", bo.artifacts.data[0].path, 1, ?trapped, ?code)) { ret 7; }
    if (trapped || code != 0) {
        print.printf("float remainder {} child exit {}\n", profile_name, code);
        ret 8;
    }
    ret 0;
}

test "mach.lang.driver: floating remainder preserves signed zero in emitted native programs" {
    $if ($mach.build.os != $mach.os.linux && $mach.build.os != $mach.os.windows) { ret 0; }
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    val make_r:  err[A.Error] = page.make(?backing);
    if (sel make_r.err) { ret 1; }
    val init_r: err[A.Error] = arena.init(?ar, ?backing, 0);
    if (sel init_r.err) { ret 2; }
    fin { arena.dnit(?ar); }
    val make_r2: err[A.Error] = arena.make(?alloc, ?ar);
    if (sel make_r2.err) { ret 3; }
    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = ut_float_zero_program();
    val root_r: res[str, fail.Fail] = ut_scaffold_m(?alloc, ut_float_zero_manifest(), ?names[0], ?texts[0], 1);
    if (sel root_r.err) { ret 4; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?alloc, root); }
    val debug: i32 = ut_float_zero_profile(?alloc, root, "debug");
    if (debug != 0) {
        print.printf("float remainder debug build/run exit {}\n", debug);
        ret 5;
    }
    val release: i32 = ut_float_zero_profile(?alloc, root, "release");
    if (release != 0) {
        print.printf("float remainder release build/run exit {}\n", release);
        ret 6;
    }
    ret 0;
}

fun ut_publication_open(operation: *publication.Plan, alloc: *A.Allocator, name: str) res[*publication.Destination, fail.Fail] {
    val initialized: err[txn.Error] = publication.plan_init(operation, alloc);
    if (sel initialized.err) { ret res[*publication.Destination, fail.Fail].err{fail.message(txn.error_message(initialized.err))}; }
    val destination: res[*publication.Destination, outcome.Fail] = publication.plan_add(operation, name, false);
    if (sel destination.err) { ret res[*publication.Destination, fail.Fail].err{fail.message(outcome.describe(destination.err))}; }
    val sealed: err[txn.Error] = publication.plan_seal(operation);
    if (sel sealed.err)      { ret res[*publication.Destination, fail.Fail].err{fail.message(txn.error_message(sealed.err))}; }
    if (sel destination.err) { ret res[*publication.Destination, fail.Fail].err{fail.message(outcome.describe(destination.err))}; }
    ret res[*publication.Destination, fail.Fail].ok{destination.ok};
}

fun ut_publication_close(operation: *publication.Plan, result: err[fail.Fail]) err[fail.Fail] {
    val closed: err[txn.Error] = publication.plan_dnit(operation);
    if (sel result.err) { ret result; }
    if (sel closed.err) { ret err[fail.Fail].err{fail.message(txn.error_message(closed.err))}; }
    ret result;
}

fun ut_planned_link_images(s: *session.Session, tgt: *target.Target, images: *of.ObjectImage,
    image_count: u32, dynlibs: *of.DynLib, dynlib_count: u32,
    out_path: *u8, name: *u8, mode: linker.LinkMode, pie: bool,
    image_options: of.ImageOptions) err[fail.Fail] {
    if (out_path == nil || str_len(out_path::str) == 0) { ret linker.link_images(s, tgt, images, image_count, dynlibs, dynlib_count, nil::*publication.Destination, name, mode, pie, image_options); }
    var operation: publication.Plan;
    val opened:    res[*publication.Destination, fail.Fail] = ut_publication_open(?operation, s.alloc, out_path::str);
    if (sel opened.err) { ret ut_publication_close(?operation, err[fail.Fail].err{opened.err}); }
    ret ut_publication_close(?operation, linker.link_images(s, tgt, images, image_count, dynlibs, dynlib_count, opened.ok, name, mode, pie, image_options));
}

test "mach.lang.driver:declaration_cast_gates_resolve_local_and_imported_type_aliases" {
    ret ut_single_ok2(
        "use Flag: uniontest.lib.Flag;\ndef Local: u8;\n$if ((1::Local) == 1u8) { fun local_selected() i32 { ret 1; } } $or { use uniontest.missing; }\n$if ((0::Flag) == 1u8) { use uniontest.missing; } $or { fun imported_selected() i32 { ret 2; } }\nfun main() i32 { ret local_selected() + imported_selected(); }\n",
        "pub def Flag: u8;\n");
}

# the std failure tags exactly as std declares them: the compiler knows nothing about these
# names, so a fixture that uses `outcome_r`, `found` or `fault` declares them beneath this prelude
val TAG_STD_PRELUDE: str = "tag res[T, E]: u8 { err: E; ok: T; } tag opt[T]: u8 { none; some: T; } tag err[E]: u8 { err: E; ok; }\n";

# `text` beneath the std tag prelude; released with ut_std_tags_free
fun ut_std_tags(alloc: *A.Allocator, text: str) err[fail.Fail] {
    val r: res[str, format.FormatError] = format.sprint(alloc, "{}{}", TAG_STD_PRELUDE, text);
    if (sel r.err) { ret err[fail.Fail].ok{}; }
    ret err[fail.Fail].err{fail.message(r.ok)};
}

fun ut_std_tags_free(alloc: *A.Allocator, text: str) {
    A.deallocate[char](alloc, text::*char, str_len(text) + 1);
}

