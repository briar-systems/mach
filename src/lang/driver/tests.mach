fun ut_asm_fn_terminator(p: *project.Project, disp: str) i32 {
    var mi: u32 = 0;
    for (mi < p.module_len) {
        val me: *project.ModuleEntry = ?p.modules[mi];
        if (me.ir_module == nil) {
            mi = mi + 1;
            cnt;
        }
        val m:  *ir.Module = me.ir_module;
        var fi: u32        = 0;
        for (fi < m.function_len) {
            val fn: *ir.Function = ?m.functions[fi];
            if (fn.block_count == 0) {
                fi = fi + 1;
                cnt;
            }
            val nm_o: opt[str] = intern.lookup(?p.s.interner, fn.disp);
            if (sel nm_o.none) {
                fi = fi + 1;
                cnt;
            }
            if (!str_equals(nm_o.some, disp)) {
                fi = fi + 1;
                cnt;
            }
            var found: i32 = 0;
            var bi:    u32 = 0;
            for (bi < fn.block_count) {
                val blk: *ir.Block = ?fn.blocks[bi];
                if (blk.terminator == ir.INSTR_NIL) {
                    bi = bi + 1;
                    cnt;
                }
                val t: *instruction.Instruction = ?fn.instrs[blk.terminator::u32];
                if (t.kind == instruction.OP_UNREACHABLE)       { found = 1; }
                or (t.kind == instruction.OP_RET && found == 0) { found = 2; }
                bi = bi + 1;
            }
            ret found;
        }
        mi = mi + 1;
    }
    ret 0;
}

test "mach.lang.driver:asm_that_cannot_return_terminates_its_block" {
    val src:    str          = "fun dies(v: i64) i64 { asm x86_64 { mov eax, 231\nsyscall\nhlt } ret v; }\nfun lives(v: i64) i64 { asm x86_64 { nop } ret v; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret dies(argc)::i32 + lives(argc)::i32; }\n";
    var bad:    i32          = 0;
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:  session.Session                    = sr.ok;
    val pr: res[project.Project, outcome.Fail] = ut_vec_lower(?s, ?alloc, src, "linux");
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    if (ut_asm_fn_terminator(?p, "dies") != 1)  { bad = 1; }
    if (ut_asm_fn_terminator(?p, "lives") != 2) { bad = 1; }

    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

fun ut_spv_manifest(alloc: *A.Allocator, dep_alias: str) str {
    val head: str = "[project]\nid = \"spvcase\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.spirv]\nisa = \"spirv\"\nos = \"freestanding\"\nabi = \"spirv\"\n\n[profile.debug]\nopt = 0\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n\n[artifact.spvcase]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/spvcase\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
    if (str_len(dep_alias) == 0::usize) { ret head; }
    val a: str = ut_cc3(alloc, head, "\n[dep.", dep_alias);
    val b: str = ut_cc3(alloc, a, "]\npath = \"", dep_alias);
    ret ut_cc3(alloc, b, "\"\n", "");
}

fun ut_spv_dep_manifest(alloc: *A.Allocator, id: str) str {
    ret ut_cc3(alloc, "[project]\nid = \"", id, "\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.spirv]\nisa = \"spirv\"\nos = \"freestanding\"\nabi = \"spirv\"\n\n[profile.debug]\nopt = 0\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n");
}

fun ut_write_node_multi(alloc: *A.Allocator, dir: str, manifest_text: str,
    names: *str, texts: *str, n: u32) err[fail.Fail] {
    val d1: err[fs.FsError] = fs.create_dir_all(alloc, dir, 493);
    if (sel d1.err) { ret err[fail.Fail].err{fail.fs_refused(d1.err)}; }
    val src_dir: str             = ut_cc3(alloc, dir, "/", "src");
    val d2:      err[fs.FsError] = fs.create_dir_all(alloc, src_dir, 493);
    if (sel d2.err) { ret err[fail.Fail].err{fail.fs_refused(d2.err)}; }
    val mf: str             = ut_cc3(alloc, dir, "/", manifest.MANIFEST_FILE);
    val w0: err[fs.FsError] = fs.write_bytes(mf, manifest_text, str_len(manifest_text), 420);
    if (sel w0.err) { ret err[fail.Fail].err{fail.fs_refused(w0.err)}; }
    var i: u32 = 0;
    for (i < n) {
        val sf: str             = ut_cc3(alloc, src_dir, "/", names[i]);
        val w:  err[fs.FsError] = fs.write_bytes(sf, texts[i], str_len(texts[i]), 420);
        if (sel w.err) { ret err[fail.Fail].err{fail.fs_refused(w.err)}; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun ut_spv_lower(s: *session.Session, alloc: *A.Allocator,
    names: *str, texts: *str, n: u32,
    dep_id: str, dep_names: *str, dep_texts: *str, dep_n: u32) res[project.Project, outcome.Fail] {
    val tf_r: res[fs.TempFile, fs.FsError] = fs.temp_create(alloc, "mach_spv_test");
    if (sel tf_r.err) { ret res[project.Project, outcome.Fail].err{outcome.internal(outcome.fs_text(tf_r.err))}; }
    var tf:    fs.TempFile       = tf_r.ok;
    val dup_r: res[str, A.Error] = str_dup(alloc, fs.temp_path(?tf));
    fs.temp_close_and_remove(?tf);
    if (sel dup_r.err) { ret res[project.Project, outcome.Fail].err{outcome.refused(dup_r.err)}; }
    val root: str = dup_r.ok;

    var alias: str = "";
    if (dep_n > 0) { alias = dep_id; }
    val wr: err[fail.Fail] = ut_write_node_multi(alloc, root, ut_spv_manifest(alloc, alias), names, texts, n);
    if (sel wr.err) {
        fs.remove_all(alloc, root);
        ret res[project.Project, outcome.Fail].err{outcome.from_fail(wr.err)};
    }

    if (dep_n > 0) {
        val dep_dir: str            = ut_cc3(alloc, root, "/dep/", dep_id);
        val dw:      err[fail.Fail] = ut_write_node_multi(alloc, dep_dir, ut_spv_dep_manifest(alloc, dep_id), dep_names, dep_texts, dep_n);
        if (sel dw.err) {
            fs.remove_all(alloc, root);
            ret res[project.Project, outcome.Fail].err{outcome.from_fail(dw.err)};
        }
        if (!ut_git_repo(alloc, root, "https://example.invalid/spvcase.git")) {
            fs.remove_all(alloc, root);
            ret res[project.Project, outcome.Fail].err{outcome.user("failed to initialize SPIR-V dependency fixture repository")};
        }
    }

    val rr: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.err) {
        fs.remove_all(alloc, root);
        ret res[project.Project, outcome.Fail].err{rr.err};
    }
    var tsel_14660: manifest.Selection                 = ut_target_sel("spirv");
    val pr:         res[project.Project, outcome.Fail] = driver.build_project(s, root, ?tsel_14660);
    fs.remove_all(alloc, root);
    if (sel pr.err) { ret pr; }
    var p: project.Project = pr.ok;

    val sr2: err[outcome.Fail] = driver.run_sema_pass(?p);
    if (sel sr2.err) {
        project.dnit_project(?p);
        ret res[project.Project, outcome.Fail].err{sr2.err};
    }
    val lr: err[outcome.Fail] = driver.run_lower_pass(?p);
    if (sel lr.err) {
        project.dnit_project(?p);
        ret res[project.Project, outcome.Fail].err{lr.err};
    }
    ret res[project.Project, outcome.Fail].ok{p};
}

fun ut_spv_codegen(p: *project.Project, s: *session.Session, fqn: str,
    out_img: *of.ObjectImage, out_err: *str) bool {
    val mid: session.ModuleId = ut_mid(p, s, fqn);
    if (mid == session.MODULE_NIL) {
        @out_err = "module not loaded";
        ret false;
    }
    val m: *project.ModuleEntry = ?p.modules[mid::u32];
    if (m.ir_module == nil) {
        @out_err = "module has no lowered IR";
        ret false;
    }

    val sr: res[passes.CodeSources, fail.Fail] = passes.code_sources(p, mid, s.alloc);
    if (sel sr.err) {
        @out_err = fail.describe(sr.err);
        ret false;
    }
    var srcs: passes.CodeSources = sr.ok;

    val cg: res[of.ObjectImage, fail.Fail] = codegen.codegen_unit(s, ?p.target, m.ir_module, srcs.set, nil, codegen.PLACEMENT_POLICY_VERSION, codegen.no_debug());
    passes.sources_dnit(s.alloc, ?srcs);
    if (sel cg.err) {
        @out_err = fail.describe(cg.err);
        ret false;
    }
    @out_img = cg.ok;
    ret true;
}

fun ut_spv_words(img: *of.ObjectImage, out_n: *u32) *u32 {
    @out_n = 0;
    var i: u32 = 0;
    for (i < img.section_count) {
        val sec: *of.Section = ?img.sections[i];
        if (sec.len >= 20 && sec.bytes != nil) {
            val w: *u32 = sec.bytes::ptr::*u32;
            @out_n = sec.len / 4 - 5;
            ret ?w[5];
        }
        i = i + 1;
    }
    ret nil;
}

fun ut_spv_count(w: *u32, n: u32, opcode: u32) u32 {
    var i: u32 = 0;
    var c: u32 = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0)                  { ret c; }
        if ((w[i] & 0xFFFF) == opcode) { c = c + 1; }
        i = i + len;
    }
    ret c;
}

fun ut_spv_fn_arity(w: *u32, n: u32, fn_ix: u32) u32 {
    var i:    u32  = 0;
    var seen: u32  = 0;
    var ty:   u32  = 0;
    var got:  bool = false;
    for (i < n && !got) {
        val len: u32 = w[i] >> 16;
        if (len == 0) { ret UT_SPV_NO_FN; }
        if ((w[i] & 0xFFFF) == spirv.OP_FUNCTION) {
            if (seen == fn_ix) {
                ty  = w[i + 4];
                got = true;
            }
            seen = seen + 1;
        }
        i = i + len;
    }
    if (!got) { ret UT_SPV_NO_FN; }
    i = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0)                                                    { ret UT_SPV_NO_FN; }
        if ((w[i] & 0xFFFF) == spirv.OP_TYPE_FUNCTION && w[i + 1] == ty) { ret len - 3; }
        i = i + len;
    }
    ret UT_SPV_NO_FN;
}

val UT_SPV_NO_FN: u32 = 0xFFFFFFFF;

fun ut_spv_arity_count(w: *u32, n: u32, arity: u32) u32 {
    val fns: u32 = ut_spv_count(w, n, spirv.OP_FUNCTION);
    var i:   u32 = 0;
    var c:   u32 = 0;
    for (i < fns) {
        if (ut_spv_fn_arity(w, n, i) == arity) { c = c + 1; }
        i = i + 1;
    }
    ret c;
}

fun ut_spv_calls_all_resolve(w: *u32, n: u32) bool {
    var i: u32 = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0) { ret true; }
        if ((w[i] & 0xFFFF) == spirv.OP_FUNCTION_CALL) {
            if (!ut_spv_defines_fn(w, n, w[i + 3])) { ret false; }
        }
        i = i + len;
    }
    ret true;
}

fun ut_spv_defines_fn(w: *u32, n: u32, id: u32) bool {
    var i: u32 = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0)                                               { ret false; }
        if ((w[i] & 0xFFFF) == spirv.OP_FUNCTION && w[i + 2] == id) { ret true; }
        i = i + len;
    }
    ret false;
}

fun ut_spv_first_callee_in(w: *u32, n: u32, fn_ix: u32) u32 {
    var i:       u32  = 0;
    var seen:    u32  = 0;
    var started: bool = false;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0) { ret 0; }
        val op: u32 = w[i] & 0xFFFF;
        if (op == spirv.OP_FUNCTION) {
            if (started) { seen = seen + 1; }
            started = true;
        }
        if (op == spirv.OP_FUNCTION_CALL && started && seen == fn_ix) { ret w[i + 3]; }
        i = i + len;
    }
    ret 0;
}

fun ut_spv_entry_fn(w: *u32, n: u32, k: u32) u32 {
    var i:    u32 = 0;
    var seen: u32 = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0) { ret 0; }
        if ((w[i] & 0xFFFF) == spirv.OP_ENTRY_POINT) {
            if (seen == k) { ret w[i + 2]; }
            seen = seen + 1;
        }
        i = i + len;
    }
    ret 0;
}

fun ut_spv_fn_index_of(w: *u32, n: u32, id: u32) u32 {
    var i:    u32 = 0;
    var seen: u32 = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0) { ret UT_SPV_NO_FN; }
        if ((w[i] & 0xFFFF) == spirv.OP_FUNCTION) {
            if (w[i + 2] == id) { ret seen; }
            seen = seen + 1;
        }
        i = i + len;
    }
    ret UT_SPV_NO_FN;
}

fun ut_spv_export_count(w: *u32, n: u32) u32 {
    var i: u32 = 0;
    var c: u32 = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0) { ret c; }
        if ((w[i] & 0xFFFF) == spirv.OP_DECORATE && len >= 3
            && w[i + 2] == spirv.DECOR_LINKAGE_ATTRIBUTES) { c = c + 1; }
        i = i + len;
    }
    ret c;
}

fun ut_spv_diag_fired(alloc: *A.Allocator, src: str, needle: str) bool {
    val sr: res[session.Session, fail.Fail] = session.init(alloc);
    if (sel sr.err) { ret false; }
    var s:     session.Session = sr.ok;
    var names: [1]str;
    var texts: [1]str;
    names[0] = "main.mach";
    texts[0] = src;
    val pr: res[project.Project, outcome.Fail] = ut_spv_lower(?s, alloc, ?names[0], ?texts[0], 1, "", nil, nil, 0);
    if (sel pr.ok) {
        var p: project.Project = pr.ok;
        project.dnit_project(?p);
    }
    val fired: bool = ut_diag_has(?s.diags, needle);
    session.dnit(?s);
    ret fired;
}

test "mach.lang.driver:a_target_op_arity_must_match_the_instruction" {
