}

test "mach.lang.driver:embed_path_diagnostics" {
    var bad: i32 = 0;

    if (ut_embed_diag("#[embed(\"nope.bin\")]\nval A: [_]u8;\nfun main() i32 { ret A[0]::i32; }\n",
        "abc", "`embed` on `A` cannot read") != 0) { bad = 1; }
    if (ut_embed_diag("#[embed(\"nope.bin\")]\nval A: [_]u8;\nfun main() i32 { ret A[0]::i32; }\n",
        "abc", "no such file or directory") != 0) { bad = 1; }

    if (ut_embed_diag("#[embed(\".\")]\nval A: [_]u8;\nfun main() i32 { ret A[0]::i32; }\n",
        "abc", "is a directory") != 0) { bad = 1; }
    if (ut_embed_unreadable_diag() != 0) { bad = 1; }

    ret bad;
}

fun ut_diag_has_warning(d: *diagnostic.DiagnosticStore, needle: str) bool {
    var i: usize = 0;
    for (i < diagnostic.len(d)) {
        if (d.items.data[i].severity == diagnostic.SEVERITY_WARNING
            && ut_str_contains(d.items.data[i].message, needle)) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun ut_embed_escape_arm(alloc: *A.Allocator, escaped: bool) i32 {
    val sr: R.Result[session.Session, str] = session.init(alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    if (R.is_err[R.Void, str](driver.setup_registry(?s.registry))) { session.dnit(?s); ret 1; }

    var names: [2]str; names[0] = "main.mach"; names[1] = "asset.bin";
    var texts: [2]str;
    texts[0] = "#[embed(\"asset.bin\")]\nval A: [_]u8;\nfun main() i32 { ret A[0]::i32; }\n";
    texts[1] = "abc";
    val root_r: R.Result[str, str] = ut_scaffold(alloc, ?names[0], ?texts[0], 2);
    if (R.is_err[str, str](root_r)) { session.dnit(?s); ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);
    val outside: str = ut_cc3(alloc, root, "-outside", ".bin");
    if (escaped) {
        val leaf: str = path.filename(outside);
        val main_path: str = ut_cc3(alloc, root, "/src/", "main.mach");
        val src: str = ut_cc3(alloc, "#[embed(\"../../", leaf, "\")]\nval A: [_]u8;\nfun main() i32 { ret A[0]::i32; }\n");
        if (O.is_some[str](fs.write_bytes(main_path, src, str_len(src), 420))) { fs.remove_all(alloc, root); session.dnit(?s); ret 1; }
        if (O.is_some[str](fs.write_bytes(outside, "xyz", 3::usize, 420))) { fs.remove_all(alloc, root); session.dnit(?s); ret 1; }
    }

    var bad: i32 = 0;
    val pr: R.Result[project.Project, outcome.Fail] = ut_sema_build(?s, root);
    if (R.is_err[project.Project, outcome.Fail](pr)) { bad = 1; }
    or {
        var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);
        val warned: bool = ut_diag_has_warning(?s.diags, "escapes the project root");
        if (warned != escaped) { bad = 1; }
        if (diagnostic.has_errors(?s.diags)) { bad = 1; }
        project.dnit_project(?p);
    }
    if (escaped) { fs.remove_file(outside); }
    fs.remove_all(alloc, root);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.driver:embed_outside_the_project_root_warns_until_5_0_0" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    if (ut_embed_escape_arm(?alloc, true) != 0)  { ret 1; }
    if (ut_embed_escape_arm(?alloc, false) != 0) { ret 1; }
    ret 0;
}

test "mach.lang.driver:debug_info_on_a_target_without_a_debug_model_fails_the_artifact" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    if (R.is_err[R.Void, str](driver.setup_registry(?s.registry))) { session.dnit(?s); ret 1; }

    var names: [1]str; names[0] = "main.mach";
    var texts: [1]str; texts[0] = "fun main() i32 { ret 0; }\n";
    val mtext: str = "[project]\nid = \"nodbg\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.windows]\nisa = \"x86_64\"\nos = \"windows\"\nabi = \"win64\"\n\n[artifact.app]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/app.exe\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
    val root_r: R.Result[str, str] = ut_scaffold_m(?alloc, mtext, ?names[0], ?texts[0], 1);
    if (R.is_err[str, str](root_r)) { session.dnit(?s); ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);

    var sel: manifest.Selection;
    sel.target = "windows"; sel.profile = ""; sel.artifact = ""; sel.want_lib = false; sel.has_artifact = false; sel.legacy_default = false;
    val pr: R.Result[project.Project, outcome.Fail] = driver.build_project_sel(?s, root, ?sel);
    if (R.is_err[project.Project, outcome.Fail](pr)) { print.print(R.unwrap_err[project.Project, outcome.Fail](pr).message); fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);
    var bad: i32 = 0;
    if (p.target.debug != nil) { bad = 1; }
    p.req.debug = true;
    if (ut_run_codegen_err(?p, "registers no debug model") != 0) { bad = 1; }
    project.dnit_project(?p);
    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

fun ut_divide_program() str {
    ret "pub var Z: i32 = 0;\npub var N: i32 = 1;\npub var M: i32 = -2147483648;\npub var Q: i32 = -1;\npub var ZL: i64 = 0;\npub var ML: i64 = -9223372036854775807 - 1;\npub var QL: i64 = -1;\n\n#[symbol(\"main\")]\nfun main(argc: i64) i64 {\n    if (argc == 1) { if (100 / N == 100) { ret 0; } ret 3; }\n    if (argc == 2) { ret (100 / Z)::i64; }\n    if (argc == 3) { ret (M / Q)::i64; }\n    if (argc == 4) { ret 100 / ZL; }\n    ret ML / QL;\n}\n\n#[symbol(\"_start\")]\npub fun start() {\n    $if ($mach.build.arch == $mach.arch.x86_64) {\n        asm x86_64 {\n            mov rdi, [rsp]\n            and rsp, -16\n            call main\n            mov rdi, rax\n            mov rax, 60\n            syscall\n        }\n    }\n    $or ($mach.build.arch == $mach.arch.aarch64) {\n        asm aarch64 {\n            ldr x0, [sp]\n            bl main\n            mov x8, 93\n            svc 0\n        }\n    }\n    $or {\n        asm riscv64 {\n            ld a0, 0(sp)\n            call main\n            li a7, 93\n            ecall\n        }\n    }\n}\n";
}

fun ut_divide_manifest() str {
    ret "[project]\nid = \"divtrap\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.linux-x86_64]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[target.linux-arm64]\nisa = \"aarch64\"\nos = \"linux\"\nabi = \"aapcs64\"\n\n[target.linux-riscv64]\nisa = \"riscv64\"\nos = \"linux\"\nabi = \"lp64d\"\n\n[artifact.divtrap]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/divtrap\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
}

fun ut_run_with_argc(alloc: *A.Allocator, runner: str, program: str, argc: usize, trapped: *bool, exit_code: *i32) bool {
    var argv: [8]*u8;
    var n: usize = 0;
    var launch: str = program;
    if (!str_empty(runner)) { argv[n] = runner::*u8; n = n + 1; launch = runner; }
    argv[n] = program::*u8; n = n + 1;
    var extra: usize = 1;
    for (extra < argc) { argv[n] = "x"::*u8; n = n + 1; extra = extra + 1; }
    argv[n] = nil;
    val rr: R.Result[exec.ExitStatus, str] = exec.run(launch, ?argv[0], env.environ());
    if (R.is_err[exec.ExitStatus, str](rr)) { ret false; }
    val status: exec.ExitStatus = R.unwrap_ok[exec.ExitStatus, str](rr);
    @trapped = false;
    @exit_code = -1;
    if (exec.signaled(status)) {
        val sig: i32 = exec.signal(status);
        @trapped = sig == 4 || sig == 5 || sig == 8;
        ret true;
    }
    if (!exec.exited(status)) { ret false; }
    @exit_code = exec.code(status);
    @trapped = @exit_code == 132 || @exit_code == 133 || @exit_code == 136;
    ret true;
}

fun ut_divide_trap_target(alloc: *A.Allocator, target_name: str, runner_name: str) i32 {
    var runner: str = "";
    if (!str_empty(runner_name)) {
        val rr: R.Result[str, str] = exec.resolve(alloc, runner_name);
        if (R.is_err[str, str](rr)) { print.print("divide-trap: runner absent, arm skipped: "); print.print(runner_name); print.print("\n"); ret 0; }
        runner = R.unwrap_ok[str, str](rr);
    }
    val sr: R.Result[session.Session, str] = session.init(alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    if (R.is_err[R.Void, str](driver.setup_registry(?s.registry))) { session.dnit(?s); ret 1; }

    var names: [1]str; names[0] = "main.mach";
    var texts: [1]str; texts[0] = ut_divide_program();
    val root_r: R.Result[str, str] = ut_scaffold_m(alloc, ut_divide_manifest(), ?names[0], ?texts[0], 1);
    if (R.is_err[str, str](root_r)) { session.dnit(?s); ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);

    var bad: i32 = 0;
    val mr: R.Result[manifest.Manifest, str] = driver.load_manifest(?s, root);
    if (R.is_err[manifest.Manifest, str](mr)) { fs.remove_all(alloc, root); session.dnit(?s); ret 1; }
    var m: manifest.Manifest = R.unwrap_ok[manifest.Manifest, str](mr);
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    rq.target = target_name;
    val pr: R.Result[bplan.BuildPlan, outcome.Fail] = bplan.plan(alloc, ?s.interner, ?s.registry, ?m, rq);
    if (R.is_err[bplan.BuildPlan, outcome.Fail](pr)) { fs.remove_all(alloc, root); session.dnit(?s); ret 1; }
    var bp: bplan.BuildPlan = R.unwrap_ok[bplan.BuildPlan, outcome.Fail](pr);
    val br: R.Result[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, alloc, nil);
    if (R.is_err[outcome.BuildOutcome, outcome.Fail](br)) { bad = 1; }
    or {
        val bo: outcome.BuildOutcome = R.unwrap_ok[outcome.BuildOutcome, outcome.Fail](br);
        if (bo.severity != outcome.BUILD_OK || bo.artifacts.len != 1) { bad = 1; }
        or {
            val program: str = bo.artifacts.data[0].path;
            var trapped: bool = false;
            var code: i32 = 0;
            if (!ut_run_with_argc(alloc, runner, program, 1, ?trapped, ?code) || trapped || code != 0) { bad = 2; }
            var argc: usize = 2;
            for (argc <= 5) {
                if (!ut_run_with_argc(alloc, runner, program, argc, ?trapped, ?code) || !trapped) {
                    print.print("divide-trap: no trap on "); print.print(target_name); print.printf(" for argc {} (exit {})\n", argc, code);
                    bad = 3;
                }
                argc = argc + 1;
            }
        }
    }
    fs.remove_all(alloc, root);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.driver:exceptional_division_traps_identically_on_every_native_backend" {
    $if ($mach.build.os != $mach.os.linux || $mach.build.arch != $mach.arch.x86_64) { ret 0; }
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    if (ut_divide_trap_target(?alloc, "linux-x86_64", "") != 0)                  { ret 1; }
    if (ut_divide_trap_target(?alloc, "linux-arm64", "qemu-aarch64") != 0)      { ret 2; }
    if (ut_divide_trap_target(?alloc, "linux-riscv64", "qemu-riscv64") != 0)    { ret 3; }
    ret 0;
}

fun ut_spirv_env_manifest(alloc: *A.Allocator, env_line: str) str {
    ret ut_cc3(alloc, "[project]\nid = \"envtest\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.gpu]\nisa = \"spirv\"\nos = \"freestanding\"\nabi = \"spirv\"\n", env_line, "\n[artifact.k]\nkind = \"bin\"\nentry = \"k.mach\"\nout = \"k.spv\"\ntargets = [\"*\"]\nlink = []\nneed = []\n");
}

fun ut_spirv_env_build(alloc: *A.Allocator, env_line: str, needle: str, want_version: u32) i32 {
    val sr: R.Result[session.Session, str] = session.init(alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    if (R.is_err[R.Void, str](driver.setup_registry(?s.registry))) { session.dnit(?s); ret 1; }

    var names: [1]str; names[0] = "k.mach";
    var texts: [1]str;
    texts[0] = "#[output(0)] var out_colour: f32x4;\n\n#[stage(\"fragment\")]\nfun frag_main() {\n    var small: u8 = 3;\n    small = small + 1;\n    out_colour = f32x4{small::f32, 0.0, 0.0, 1.0};\n}\n";
    val root_r: R.Result[str, str] = ut_scaffold_m(alloc, ut_spirv_env_manifest(alloc, env_line), ?names[0], ?texts[0], 1);
    if (R.is_err[str, str](root_r)) { session.dnit(?s); ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);

    var bad: i32 = 0;
    var sel: manifest.Selection;
    sel.target = "gpu"; sel.profile = ""; sel.artifact = ""; sel.want_lib = false; sel.has_artifact = false; sel.legacy_default = false;
    val pr: R.Result[project.Project, outcome.Fail] = driver.build_project_sel(?s, root, ?sel);
    if (R.is_err[project.Project, outcome.Fail](pr)) {
        val f: outcome.Fail = R.unwrap_err[project.Project, outcome.Fail](pr);
        if (str_empty(needle) || f.message == nil || !ut_str_contains(f.message, needle)) { print.print(f.message); print.print("\n"); bad = 2; }
    } or {
        var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);
        val se: R.Result[R.Void, outcome.Fail] = passes.run_sema_pass(?p);
        val le: R.Result[R.Void, outcome.Fail] = passes.run_lower_pass(?p);
        val ce: R.Result[R.Void, outcome.Fail] = passes.run_codegen_pass(?p);
        if (R.is_err[R.Void, outcome.Fail](se) || R.is_err[R.Void, outcome.Fail](le)) { bad = 3; }
        or (!str_empty(needle)) {
            if (R.is_ok[R.Void, outcome.Fail](ce)) { bad = 4; }
            or (!ut_str_contains(R.unwrap_err[R.Void, outcome.Fail](ce).message, needle)) { print.print(R.unwrap_err[R.Void, outcome.Fail](ce).message); print.print("\n"); bad = 5; }
        } or {
            if (R.is_err[R.Void, outcome.Fail](ce)) { print.print(R.unwrap_err[R.Void, outcome.Fail](ce).message); print.print("\n"); bad = 6; }
            or {
                var m: *project.ModuleEntry = nil;
                val fqn_r: R.Result[intern.StrId, str] = intern.intern(?s.interner, "envtest.k");
                if (R.is_ok[intern.StrId, str](fqn_r)) {
                    val mo: O.Option[*project.ModuleEntry] = project.module_by_fqn(?p, R.unwrap_ok[intern.StrId, str](fqn_r));
                    if (O.is_some[*project.ModuleEntry](mo)) { m = O.unwrap[*project.ModuleEntry](mo); }
                }
                if (m == nil || m.object_image == nil || m.object_image.section_count == 0 || m.object_image.sections[0].len < 8) { bad = 7; }
                or {
                    val d: *u8 = m.object_image.sections[0].bytes;
                    val version: u32 = d[4]::u32 | (d[5]::u32 << 8) | (d[6]::u32 << 16) | (d[7]::u32 << 24);
                    if (version != want_version) { print.printf("spirv env: header version {}\n", version); bad = 8; }
                }
            }
        }
        project.dnit_project(?p);
    }
    fs.remove_all(alloc, root);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.driver:spirv_env_pins_the_version_and_caps_the_capabilities" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    if (ut_spirv_env_build(?alloc, "env = \"vulkan1.0\"\n", "Int8", 0) != 0)           { ret 2; }
    if (ut_spirv_env_build(?alloc, "env = \"vulkan1.2\"\n", "", 0x00010500) != 0)       { ret 3; }
    if (ut_spirv_env_build(?alloc, "", "", 0x00010600) != 0)                             { ret 4; }
    if (ut_spirv_env_build(?alloc, "env = \"vulkan9.9\"\n", "vulkan1.3", 0) != 0)       { ret 5; }
    ret 0;
}

test "mach.lang.driver:embed_target_rules" {
    var bad: i32 = 0;

    if (ut_embed_diag("#[embed(\"asset.bin\")]\nvar A: [_]u8;\nfun main() i32 { ret A[0]::i32; }\n",
        "abc", "applies only to a `val`") != 0) { bad = 1; }
    if (ut_embed_diag("#[embed(\"asset.bin\")]\nval A: [_]u32;\nfun main() i32 { ret 0; }\n",
        "abc", "element type must be `u8`") != 0) { bad = 1; }
    if (ut_embed_diag("#[embed(\"asset.bin\")]\nval A: u8;\nfun main() i32 { ret A::i32; }\n",
        "abc", "must be annotated `[_]u8` or `[N]u8`") != 0) { bad = 1; }
    if (ut_embed_diag("#[embed()]\nval A: [_]u8;\nfun main() i32 { ret A[0]::i32; }\n",
        "abc", "takes one string argument") != 0) { bad = 1; }
    if (ut_embed_diag("#[embed(\"asset.bin\")]\nfun f() i32 { ret 0; }\nfun main() i32 { ret f(); }\n",
        "abc", "applies only to a `val`") != 0) { bad = 1; }
    if (ut_embed_diag("#[embed(\"asset.bin\")]\n#[embed(\"asset.bin\")]\nval A: [_]u8;\nfun main() i32 { ret A[0]::i32; }\n",
        "abc", "only one `embed` decorator") != 0) { bad = 1; }

    if (ut_embed_diag("val A: [_]u8 = [1]u8{1};\nfun main() i32 { ret A[0]::i32; }\n",
        "abc", "only valid on an `#[embed(...)]` declaration") != 0) { bad = 1; }

    ret bad;
}

test "mach.lang.driver:embed_rejection_does_not_cascade" {
    var bad: i32 = 0;

    if (ut_embed_diag("#[embed(\"asset.bin\")]\nval A: [_][_]u8;\nfun main() i32 { ret 0; }\n",
        "abc", "only valid on an `#[embed(...)]` declaration") == 0) { bad = 1; }
    if (ut_embed_diag("#[embed(\"asset.bin\")]\nval A: *[_]u8;\nfun main() i32 { ret 0; }\n",
        "abc", "only valid on an `#[embed(...)]` declaration") == 0) { bad = 1; }
    if (ut_embed_diag("#[embed(\"asset.bin\")]\nval A: [3][_]u8;\nfun main() i32 { ret 0; }\n",
        "abc", "only valid on an `#[embed(...)]` declaration") == 0) { bad = 1; }

    if (ut_embed_diag("#[embed(\"asset.bin\")]\nval A: [_][_]u8;\nfun main() i32 { ret 0; }\n",
        "abc", "element type must be `u8`") != 0) { bad = 1; }

    if (ut_embed_diag("#[embed(\"nope.bin\")]\nval A: [_]u8;\nfun main() i32 { var q: [_]u8; ret 0; }\n",
        "abc", "only valid on an `#[embed(...)]` declaration") != 0) { bad = 1; }

    ret bad;
}

test "mach.lang.driver:embed_asset_edit_invalidates_sema" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    val rr: R.Result[R.Void, str] = driver.setup_registry(?s.registry);
    if (R.is_err[R.Void, str](rr)) { session.dnit(?s); ret 1; }

    var names: [3]str;
    names[0] = "main.mach"; names[1] = "asset.bin"; names[2] = "other.mach";
    var texts: [3]str;
    texts[0] = "use uniontest.other;\n\n#[embed(\"asset.bin\")]\nval A: [_]u8;\n\nfun main() i32 { ret A[0]::i32; }\n";
    texts[1] = "abc";
    texts[2] = "pub fun untouched() i32 { ret 1; }\n";

    val root_r: R.Result[str, str] = ut_scaffold(?alloc, ?names[0], ?texts[0], 3);
    if (R.is_err[str, str](root_r)) { session.dnit(?s); ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);

    var bad: i32 = 0;

    val p1r: R.Result[project.Project, outcome.Fail] = ut_sema_build(?s, root);
    if (R.is_err[project.Project, outcome.Fail](p1r)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    var p1: project.Project = R.unwrap_ok[project.Project, outcome.Fail](p1r);
    val st_main:  session.StableModuleId = ut_stable(?p1, ?s, "uniontest.main");
    val st_other: session.StableModuleId = ut_stable(?p1, ?s, "uniontest.other");
    val lc_main_1:  query.Revision = ut_sema_lc(?s, st_main);
    val lc_other_1: query.Revision = ut_sema_lc(?s, st_other);
    project.dnit_project(?p1);

    val p2r: R.Result[project.Project, outcome.Fail] = ut_sema_build(?s, root);
    if (R.is_err[project.Project, outcome.Fail](p2r)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    var p2: project.Project = R.unwrap_ok[project.Project, outcome.Fail](p2r);
    if (ut_sema_lc(?s, st_main) != lc_main_1) { bad = 1; }
    project.dnit_project(?p2);

    val src_dir: str = ut_cc3(?alloc, root, "/", "src");
    val a_path: str = ut_cc3(?alloc, src_dir, "/", "asset.bin");
    val new_a: str = "wxyz";
    val wr: O.Option[str] = fs.write_bytes(a_path, new_a, str_len(new_a), 420);
    if (O.is_some[str](wr)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }

    val p3r: R.Result[project.Project, outcome.Fail] = ut_sema_build(?s, root);
    if (R.is_err[project.Project, outcome.Fail](p3r)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    var p3: project.Project = R.unwrap_ok[project.Project, outcome.Fail](p3r);
    if (ut_sema_lc(?s, st_main)  == lc_main_1)  { bad = 1; }
    if (ut_sema_lc(?s, st_other) != lc_other_1) { bad = 1; }
    project.dnit_project(?p3);

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

fun ut_sema_build(s: *session.Session, root: str) R.Result[project.Project, outcome.Fail] {
    val pr: R.Result[project.Project, outcome.Fail] = driver.build_project_union(s, root);
    if (R.is_err[project.Project, outcome.Fail](pr)) { ret pr; }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);
    val se: R.Result[R.Void, outcome.Fail] = passes.run_sema_pass(?p);
    if (R.is_err[R.Void, outcome.Fail](se)) { project.dnit_project(?p); ret R.err[project.Project, outcome.Fail](R.unwrap_err[R.Void, outcome.Fail](se)); }
    ret R.ok[project.Project, outcome.Fail](p);
}

fun ut_lower_build(s: *session.Session, root: str) R.Result[project.Project, outcome.Fail] {
    val pr: R.Result[project.Project, outcome.Fail] = driver.build_project_union(s, root);
    if (R.is_err[project.Project, outcome.Fail](pr)) { ret pr; }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);
    val se: R.Result[R.Void, outcome.Fail] = passes.run_sema_pass(?p);
    if (R.is_err[R.Void, outcome.Fail](se)) { project.dnit_project(?p); ret R.err[project.Project, outcome.Fail](R.unwrap_err[R.Void, outcome.Fail](se)); }
    val le: R.Result[R.Void, outcome.Fail] = passes.run_lower_pass(?p);
    if (R.is_err[R.Void, outcome.Fail](le)) { project.dnit_project(?p); ret R.err[project.Project, outcome.Fail](R.unwrap_err[R.Void, outcome.Fail](le)); }
    ret R.ok[project.Project, outcome.Fail](p);
}

fun ut_embed_global(p: *project.Project) *ir.Global {
    var ti: u32 = 0;
    for (ti < p.topo_len) {
        val m: *ir.Module = p.modules[p.topo[ti]::u32].ir_module;
        if (m != nil) {
            var gi: u32 = 0;
            for (gi < m.global_len) {
                if (m.globals[gi].is_embed) { ret ?m.globals[gi]; }
                gi = gi + 1;
            }
        }
        ti = ti + 1;
    }
    ret nil;
}

fun ut_embed_bytes_equal(g: *ir.Global, want: str) bool {
    if (g == nil)                                   { ret false; }
    if (g.init.kind != value.VAL_CONST_BYTES)       { ret false; }
    if (g.init.data.bytes.len::usize != str_len(want)) { ret false; }
    if (g.init.data.bytes.ptr == nil)               { ret str_len(want) == 0::usize; }
    var i: u32 = 0;
    for (i < g.init.data.bytes.len) {
        if (g.init.data.bytes.ptr[i] != want[i::usize]) { ret false; }
        i = i + 1;
    }
    ret true;
}

test "mach.lang.driver:embed_buffer_is_stable_across_warm_rebuilds" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    val rr: R.Result[R.Void, str] = driver.setup_registry(?s.registry);
    if (R.is_err[R.Void, str](rr)) { session.dnit(?s); ret 1; }

    var names: [2]str;
    names[0] = "main.mach"; names[1] = "asset.bin";
    var texts: [2]str;
    texts[0] = "#[embed(\"asset.bin\")]\nval A: [_]u8;\n\nfun main() i32 { ret A[0]::i32; }\n";
    texts[1] = "abc";

    val root_r: R.Result[str, str] = ut_scaffold(?alloc, ?names[0], ?texts[0], 2);
    if (R.is_err[str, str](root_r)) { session.dnit(?s); ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);

    var bad: i32 = 0;
    val src_dir: str = ut_cc3(?alloc, root, "/", "src");
    val a_path:  str = ut_cc3(?alloc, src_dir, "/", "asset.bin");

    val p1r: R.Result[project.Project, outcome.Fail] = ut_lower_build(?s, root);
    if (R.is_err[project.Project, outcome.Fail](p1r)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    var p1: project.Project = R.unwrap_ok[project.Project, outcome.Fail](p1r);
    val g1: *ir.Global = ut_embed_global(?p1);
    if (!ut_embed_bytes_equal(g1, "abc")) { bad = 1; }
    var ptr1: *u8 = nil;
    if (g1 == nil) { bad = 1; }
    or { ptr1 = g1.init.data.bytes.ptr; }
    val st_main: session.StableModuleId = ut_stable(?p1, ?s, "uniontest.main");
    val lower_1: query.Revision = ut_lower_lc(?s, st_main);
    project.dnit_project(?p1);

    val p2r: R.Result[project.Project, outcome.Fail] = ut_lower_build(?s, root);
    if (R.is_err[project.Project, outcome.Fail](p2r)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    var p2: project.Project = R.unwrap_ok[project.Project, outcome.Fail](p2r);
    val g2: *ir.Global = ut_embed_global(?p2);
    if (!ut_embed_bytes_equal(g2, "abc")) { bad = 1; }
    if (g2 != g1) { bad = 1; }
    if (g2 == nil || g2.init.data.bytes.ptr != ptr1) { bad = 1; }
    if (ut_lower_lc(?s, st_main) != lower_1) { bad = 1; }
    project.dnit_project(?p2);

    val w1: O.Option[str] = fs.write_bytes(a_path, "xyz", 3::usize, 420);
    if (O.is_some[str](w1)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    val p3r: R.Result[project.Project, outcome.Fail] = ut_lower_build(?s, root);
    if (R.is_err[project.Project, outcome.Fail](p3r)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    var p3: project.Project = R.unwrap_ok[project.Project, outcome.Fail](p3r);
    if (!ut_embed_bytes_equal(ut_embed_global(?p3), "xyz")) { bad = 1; }
    val lower_3: query.Revision = ut_lower_lc(?s, st_main);
    if (lower_3 == lower_1) { bad = 1; }
    project.dnit_project(?p3);

    val w2: O.Option[str] = fs.write_bytes(a_path, "wxyz!", 5::usize, 420);
    if (O.is_some[str](w2)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    val p4r: R.Result[project.Project, outcome.Fail] = ut_lower_build(?s, root);
    if (R.is_err[project.Project, outcome.Fail](p4r)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    var p4: project.Project = R.unwrap_ok[project.Project, outcome.Fail](p4r);
    if (!ut_embed_bytes_equal(ut_embed_global(?p4), "wxyz!")) { bad = 1; }
    if (ut_lower_lc(?s, st_main) == lower_3) { bad = 1; }
    project.dnit_project(?p4);

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

fun ut_attr_probe(s: *session.Session, alloc: *A.Allocator, names: *str, texts: *str,
                  n: u32, target_name: str, sym: str) R.Result[str, outcome.Fail] {
    val root_r: R.Result[str, str] = ut_scaffold(alloc, names, texts, n);
    if (R.is_err[str, str](root_r)) {
        ret R.err[str, outcome.Fail](outcome.user(R.unwrap_err[str, str](root_r)));
    }
    val root: str = R.unwrap_ok[str, str](root_r);
    val rr: R.Result[R.Void, str] = driver.setup_registry(?s.registry);
    if (R.is_err[R.Void, str](rr)) {
        fs.remove_all(alloc, root);
        ret R.err[str, outcome.Fail](outcome.user(R.unwrap_err[R.Void, str](rr)));
    }
    var tsel_14044: manifest.Selection = ut_target_sel(target_name);
    val pr: R.Result[project.Project, outcome.Fail] = driver.build_project(s, root, ?tsel_14044);
    fs.remove_all(alloc, root);
    if (R.is_err[project.Project, outcome.Fail](pr)) {
        ret R.err[str, outcome.Fail](R.unwrap_err[project.Project, outcome.Fail](pr));
    }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);

    val se: R.Result[R.Void, outcome.Fail] = passes.run_sema_pass(?p);
    if (R.is_err[R.Void, outcome.Fail](se)) {
        project.dnit_project(?p);
        ret R.err[str, outcome.Fail](R.unwrap_err[R.Void, outcome.Fail](se));
    }
    val le: R.Result[R.Void, outcome.Fail] = passes.run_lower_pass(?p);
    if (R.is_err[R.Void, outcome.Fail](le)) {
        project.dnit_project(?p);
        ret R.err[str, outcome.Fail](R.unwrap_err[R.Void, outcome.Fail](le));
    }

    var out: str = "";
    val sid: R.Result[intern.StrId, str] = intern.intern(?s.interner, sym);
    if (R.is_ok[intern.StrId, str](sid)) {
        val got: O.Option[intern.StrId] =
            session.import_library(s, R.unwrap_ok[intern.StrId, str](sid));
        if (O.is_some[intern.StrId](got)) {
            val nm: O.Option[str] = intern.lookup(?s.interner, O.unwrap[intern.StrId](got));
            if (O.is_some[str](nm)) { out = O.unwrap[str](nm); }
        }
    }
    project.dnit_project(?p);
    ret R.ok[str, outcome.Fail](out);
}

fun ut_attr_probe_allsrc(s: *session.Session, alloc: *A.Allocator, names: *str, texts: *str,
                         n: u32, target_name: str, sym: str) R.Result[str, outcome.Fail] {
    val root_r: R.Result[str, str] = ut_scaffold(alloc, names, texts, n);
    if (R.is_err[str, str](root_r)) {
        ret R.err[str, outcome.Fail](outcome.user(R.unwrap_err[str, str](root_r)));
    }
    val root: str = R.unwrap_ok[str, str](root_r);
    val rr: R.Result[R.Void, str] = driver.setup_registry(?s.registry);
    if (R.is_err[R.Void, str](rr)) {
        fs.remove_all(alloc, root);
        ret R.err[str, outcome.Fail](outcome.user(R.unwrap_err[R.Void, str](rr)));
    }

    var sel: manifest.Selection;
    sel.target = target_name; sel.profile = ""; sel.artifact = "";
    sel.want_lib = false; sel.has_artifact = false;
    val pr: R.Result[project.Project, outcome.Fail] = driver.build_project_test(s, root, ?sel);
    fs.remove_all(alloc, root);
    if (R.is_err[project.Project, outcome.Fail](pr)) {
        ret R.err[str, outcome.Fail](R.unwrap_err[project.Project, outcome.Fail](pr));
    }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);

    if (p.emit_len >= p.module_len) {
        project.dnit_project(?p);
        ret R.err[str, outcome.Fail](outcome.user("fixture loaded no uncompiled module"));
    }

    val se: R.Result[R.Void, outcome.Fail] = passes.run_sema_pass(?p);
    if (R.is_err[R.Void, outcome.Fail](se)) {
        project.dnit_project(?p);
        ret R.err[str, outcome.Fail](R.unwrap_err[R.Void, outcome.Fail](se));
    }
    val le: R.Result[R.Void, outcome.Fail] = passes.run_lower_pass(?p);
    if (R.is_err[R.Void, outcome.Fail](le)) {
        project.dnit_project(?p);
        ret R.err[str, outcome.Fail](R.unwrap_err[R.Void, outcome.Fail](le));
    }

    var out: str = "";
    val sid: R.Result[intern.StrId, str] = intern.intern(?s.interner, sym);
    if (R.is_ok[intern.StrId, str](sid)) {
        val got: O.Option[intern.StrId] =
            session.import_library(s, R.unwrap_ok[intern.StrId, str](sid));
        if (O.is_some[intern.StrId](got)) {
            val nm: O.Option[str] = intern.lookup(?s.interner, O.unwrap[intern.StrId](got));
            if (O.is_some[str](nm)) { out = O.unwrap[str](nm); }
        }
    }
    project.dnit_project(?p);
    ret R.ok[str, outcome.Fail](out);
}

test "mach.lang.driver:uncompiled_module_attribution_not_projected" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    var names: [2]str; names[0] = "main.mach"; names[1] = "orphan.mach";
    var texts: [2]str;
    texts[0] = "fun main() i32 { ret 0; }\n";
    texts[1] = "#[library(\"user32\")]\next fun Sleep(ms: u32);\npub fun call() { Sleep(0); }\n";

    var bad: i32 = 0;
    val pr: R.Result[str, outcome.Fail] =
        ut_attr_probe_allsrc(?s, ?alloc, ?names[0], ?texts[0], 2, "linux", "Sleep");
    if (R.is_err[str, outcome.Fail](pr)) { bad = 1; }
    or {
        val got: str = R.unwrap_ok[str, outcome.Fail](pr);
        if (!str_equals(got, "")) { bad = 1; }
    }

    session.dnit(?s);
    ret bad;
}

