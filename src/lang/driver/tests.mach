test "mach.lang.driver:union_skips_uncoverable_target" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    val mf:    str = "[project]\nid = \"uskip\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.good]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\ndefault = true\n\n[target.bad]\nisa = \"aarch64\"\nos = \"windows\"\nabi = \"aapcs64\"\n\n[artifact.uskip]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/uskip\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n";
    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "fun main() i32 { ret 0; }\n";

    val root_r: res[str, fail.Fail] = ut_scaffold_m(?alloc, mf, ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    val rr: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }

    val pur: res[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
    fs.remove_all(?alloc, root);
    if (sel pur.err) {
        session.dnit(?s);
        ret 1;
    }
    var pu: project.Project = pur.ok;

    var bad: i32 = 0;
    if (pu.union_tuple_count != 1)      { bad = 1; }
    or (pu.union_tuple_cap != 2)        { bad = 1; }
    or (!ut_has(?pu, ?s, "uskip.main")) { bad = 1; }

    project.dnit_project(?pu);
    session.dnit(?s);
    ret bad;
}

