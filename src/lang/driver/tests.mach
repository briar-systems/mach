fun ut_scaffold(alloc: *A.Allocator, names: *str, texts: *str, n: u32) res[str, fail.Fail] {
    ret ut_scaffold_m(alloc, ut_manifest(), names, texts, n);
}

fun ut_union_native_os_id() u32 {
    ret target.host_os_id();
}

fun ut_union_native_text(alloc: *A.Allocator, text: str) res[str, fail.Fail] {
    val native: u32 = ut_union_native_os_id();
    var name:   str = "$mach.os.linux";
    if (native == os.OS_WINDOWS) { name = "$mach.os.windows"; }
    or (native == os.OS_DARWIN)  { name = "$mach.os.darwin"; }
    val str_replace_r: res[str, string.StrError] = str_replace(alloc, text, "NATIVE_OS", name);
    if (sel str_replace_r.err) { ret res[str, fail.Fail].err{fail.str_refused(str_replace_r.err)}; }
    ret res[str, fail.Fail].ok{str_replace_r.ok};
}

fun ut_target_sel(target_name: str) manifest.Selection {
    var pick: manifest.Selection;
    pick.target       = target_name;
    pick.profile      = "";
    pick.artifact     = "";
    pick.want_lib     = false;
    pick.has_artifact = false;
    ret pick;
}

fun ut_scaffold_m(alloc: *A.Allocator, manifest_text: str, names: *str, texts: *str, n: u32) res[str, fail.Fail] {
    val tf_r: res[fs.TempFile, fs.FsError] = fs.temp_create(alloc, "mach_union_test");
    if (sel tf_r.err) { ret res[str, fail.Fail].err{fail.fs_refused(tf_r.err)}; }
    var tf:    fs.TempFile       = tf_r.ok;
    val dup_r: res[str, A.Error] = str_dup(alloc, fs.temp_path(?tf));
    fs.temp_close_and_remove(?tf);
    if (sel dup_r.err) { ret res[str, fail.Fail].err{fail.refused(dup_r.err)}; }
    val root: str = dup_r.ok;

    val d1: err[fs.FsError] = fs.create_dir_all(alloc, root, 493);
    if (sel d1.err) { ret res[str, fail.Fail].err{fail.fs_refused(d1.err)}; }
    val src_dir: str             = ut_cc3(alloc, root, "/", "src");
    val d2:      err[fs.FsError] = fs.create_dir_all(alloc, src_dir, 493);
    if (sel d2.err) { ret res[str, fail.Fail].err{fail.fs_refused(d2.err)}; }

    val mf: str             = ut_cc3(alloc, root, "/", manifest.MANIFEST_FILE);
    val w0: err[fs.FsError] = fs.write_bytes(mf, manifest_text, str_len(manifest_text), 420);
    if (sel w0.err) { ret res[str, fail.Fail].err{fail.fs_refused(w0.err)}; }

    var i: u32 = 0;
    for (i < n) {
        val fp: str             = ut_cc3(alloc, src_dir, "/", names[i]);
        val w:  err[fs.FsError] = fs.write_bytes(fp, texts[i], str_len(texts[i]), 420);
        if (sel w.err) { ret res[str, fail.Fail].err{fail.fs_refused(w.err)}; }
        i = i + 1;
    }
    ret res[str, fail.Fail].ok{root};
}

fun ut_str_contains(hay: str, needle: str) bool {
    val hn: usize = str_len(hay);
    val nn: usize = str_len(needle);
    if (nn == 0) { ret true; }
    if (nn > hn) { ret false; }
    var i: usize = 0;
    for (i + nn <= hn) {
        var k: usize = 0;
        for (k < nn && hay[i + k] == needle[k]) { k = k + 1; }
        if (k == nn) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun ut_write_node(alloc: *A.Allocator, dir: str, manifest_text: str, src_name: str, src_text: str) err[fail.Fail] {
    val d1: err[fs.FsError] = fs.create_dir_all(alloc, dir, 493);
    if (sel d1.err) { ret err[fail.Fail].err{fail.fs_refused(d1.err)}; }
    val src_dir: str             = ut_cc3(alloc, dir, "/", "src");
    val d2:      err[fs.FsError] = fs.create_dir_all(alloc, src_dir, 493);
    if (sel d2.err) { ret err[fail.Fail].err{fail.fs_refused(d2.err)}; }
    val mf: str             = ut_cc3(alloc, dir, "/", manifest.MANIFEST_FILE);
    val w0: err[fs.FsError] = fs.write_bytes(mf, manifest_text, str_len(manifest_text), 420);
    if (sel w0.err) { ret err[fail.Fail].err{fail.fs_refused(w0.err)}; }
    val sf:            str             = ut_cc3(alloc, src_dir, "/", src_name);
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(sf, src_text, str_len(src_text), 420);
    if (sel write_bytes_r.err) { ret err[fail.Fail].err{fail.fs_refused(write_bytes_r.err)}; }
    ret err[fail.Fail].ok{};
}

fun ut_git(alloc: *A.Allocator, args: *str, count: usize) bool {
    val pr: res[str, exec.Error] = exec.resolve(alloc, "git");
    if (sel pr.err) { ret false; }
    val program: str                = pr.ok;
    val ar:      res[**u8, A.Error] = A.allocate[*u8](alloc, count + 2);
    if (sel ar.err) {
        str_free(alloc, program);
        ret false;
    }
    val argv: **u8 = ar.ok;
    argv[0] = program::*u8;
    var i: usize = 0;
    for (i < count) {
        argv[i + 1] = args[i]::*u8;
        i           = i + 1;
    }
    argv[count + 1] = nil;
    val rr: res[exec.ExitStatus, exec.Error] = exec.run(program, argv, env.environ());
    A.deallocate[*u8](alloc, argv, count + 2);
    str_free(alloc, program);
    if (sel rr.err) { ret false; }
    val status: exec.ExitStatus = rr.ok;
    ret exec.exited(status) && exec.code(status) == 0;
}

fun ut_git_repo(alloc: *A.Allocator, dir: str, origin: str) bool {
    var init: [3]str;
    init[0] = "init";
    init[1] = "-q";
    init[2] = dir;
    if (!ut_git(alloc, ?init[0], 3)) { ret false; }
    var name: [5]str;
    name[0] = "-C";
    name[1] = dir;
    name[2] = "config";
    name[3] = "user.name";
    name[4] = "mach-test";
    if (!ut_git(alloc, ?name[0], 5)) { ret false; }
    var email: [5]str;
    email[0] = "-C";
    email[1] = dir;
    email[2] = "config";
    email[3] = "user.email";
    email[4] = "mach-test@example.invalid";
    if (!ut_git(alloc, ?email[0], 5)) { ret false; }
    var remote: [6]str;
    remote[0] = "-C";
    remote[1] = dir;
    remote[2] = "remote";
    remote[3] = "add";
    remote[4] = "origin";
    remote[5] = origin;
    if (!ut_git(alloc, ?remote[0], 6)) { ret false; }
    var add: [4]str;
    add[0] = "-C";
    add[1] = dir;
    add[2] = "add";
    add[3] = "-A";
    if (!ut_git(alloc, ?add[0], 4)) { ret false; }
    var commit: [5]str;
    commit[0] = "-C";
    commit[1] = dir;
    commit[2] = "commit";
    commit[3] = "-qm";
    commit[4] = "initial";
    if (!ut_git(alloc, ?commit[0], 5)) { ret false; }
    var track: [6]str;
    track[0] = "-C";
    track[1] = dir;
    track[2] = "update-ref";
    track[3] = "refs/remotes/origin/main";
    track[4] = "HEAD";
    track[5] = "";
    ret ut_git(alloc, ?track[0], 5);
}

fun ut_git_commit_all(alloc: *A.Allocator, dir: str, message: str) bool {
    var add: [4]str;
    add[0] = "-C";
    add[1] = dir;
    add[2] = "add";
    add[3] = "-A";
    if (!ut_git(alloc, ?add[0], 4)) { ret false; }
    var commit: [5]str;
    commit[0] = "-C";
    commit[1] = dir;
    commit[2] = "commit";
    commit[3] = "-qm";
    commit[4] = message;
    ret ut_git(alloc, ?commit[0], 5);
}

fun ut_gitmodules(alloc: *A.Allocator, alias: str, source: str) str {
    val head: str = ut_cc3(alloc, "[submodule \"dep/", alias, "\"]\n\tpath = dep/");
    val path: str = ut_cc3(alloc, head, alias, "\n\turl = ");
    ret ut_cc3(alloc, path, source, "\n");
}

fun ut_write_gitmodules(alloc: *A.Allocator, root: str, alias: str, source: str) bool {
    val path:          str             = ut_cc3(alloc, root, "/", ".gitmodules");
    val text:          str             = ut_gitmodules(alloc, alias, source);
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(path, text, str_len(text), 420);
    ret sel write_bytes_r.ok;
}

fun ut_write_gitmodules2(alloc: *A.Allocator, root: str, a1: str, s1: str, a2: str, s2: str) bool {
    val path:          str             = ut_cc3(alloc, root, "/", ".gitmodules");
    val text:          str             = ut_cc3(alloc, ut_gitmodules(alloc, a1, s1), ut_gitmodules(alloc, a2, s2), "");
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(path, text, str_len(text), 420);
    ret sel write_bytes_r.ok;
}

fun ut_git_ref(alloc: *A.Allocator, root: str, rel: str) res[str, fail.Fail] {
    val path:  str                  = ut_cc3(alloc, root, "/.git/", rel);
    val raw_r: res[str, fs.FsError] = fs.read_string(alloc, path);
    if (sel raw_r.err) { ret res[str, fail.Fail].err{fail.fs_refused(raw_r.err)}; }
    val raw: str   = raw_r.ok;
    var n:   usize = str_len(raw);
    for (n > 0 && (raw[n - 1] == 10 || raw[n - 1] == 13)) { n = n - 1; }
    val copy_r: res[str, string.StrError] = str_copy_slice(alloc, raw, 0, n);
    str_free(alloc, raw);
    if (sel copy_r.err) { ret res[str, fail.Fail].err{fail.str_refused(copy_r.err)}; }
    ret res[str, fail.Fail].ok{copy_r.ok};
}

fun ut_lib_manifest(alloc: *A.Allocator, id: str) str {
    ret ut_cc3(alloc, "[project]\nid = \"", id,
        "\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[artifact.lib]\nkind = \"static\"\nentry = \"lib.mach\"\nout = \"lib/l\"\ntargets = [\"*\"]\nlink = []\nneed = []\n");
}

fun ut_dep_root_one(alloc: *A.Allocator, alias: str, path: str) str {
    val head: str = "[project]\nid = \"app\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.linux]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[profile.debug]\nopt = 0\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n\n[artifact.app]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/app\"\ntargets = [\"*\"]\nlink = []\nneed = []\n\n[dep.";
    val mid:  str = ut_cc3(alloc, head, alias, "]\npath = \"");
    ret ut_cc3(alloc, mid, path, "\"\n");
}

fun ut_dep_root_git_ref(alloc: *A.Allocator, alias: str, source: str, ref: str) str {
    val head:        str = "[project]\nid = \"app\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.linux]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[profile.debug]\nopt = 0\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n\n[artifact.app]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/app\"\ntargets = [\"*\"]\nlink = []\nneed = []\n\n[dep.";
    val mid:         str = ut_cc3(alloc, head, alias, "]\ngit = \"");
    val with_source: str = ut_cc3(alloc, mid, source, "\"\nref = \"");
    ret ut_cc3(alloc, with_source, ref, "\"\n");
}

fun ut_dep_root_git(alloc: *A.Allocator, alias: str, source: str) str {
    ret ut_dep_root_git_ref(alloc, alias, source, "branch/main");
}

fun ut_dep_root_two(alloc: *A.Allocator, alias1: str, path1: str, alias2: str, path2: str) str {
    val first: str = ut_dep_root_one(alloc, alias1, path1);
    val mid:   str = ut_cc3(alloc, first, "\n[dep.", alias2);
    val tail:  str = ut_cc3(alloc, mid, "]\npath = \"", path2);
    ret ut_cc3(alloc, tail, "\"\n", "");
}

fun ut_dep_lib_with_export(alloc: *A.Allocator, id: str) str {
    ret ut_cc3(alloc, "[project]\nid = \"", id,
        "\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[link.mylink]\nsource = \"local\"\npath = \"{project.out}/mylink.o\"\nos = [\"*\"]\nisa = [\"*\"]\nabi = [\"*\"]\nexport = true\n\n[artifact.lib]\nkind = \"static\"\nentry = \"lib.mach\"\nout = \"lib/l\"\ntargets = [\"*\"]\nlink = []\nneed = []\n");
}

fun ut_dep_build_ok(s: *session.Session, root: str) bool {
    val pr: res[project.Project, outcome.Fail] = driver.build_project_union(s, root);
    if (sel pr.err) { ret false; }
    var p: project.Project = pr.ok;
    project.dnit_project(?p);
    ret true;
}

fun ut_dep_build_fails(s: *session.Session, root: str, needle: str) bool {
    val pr: res[project.Project, outcome.Fail] = driver.build_project_union(s, root);
    if (sel pr.ok) {
        var p: project.Project = pr.ok;
        project.dnit_project(?p);
        ret false;
    }
    ret ut_str_contains(outcome.describe(pr.err), needle);
}

rec DepsScratchProbe {
    backing:    A.Allocator;
    live:       i64;
    live_count: i64;
    calls:      u32;
    fail_at:    u32;
}

fun deps_scratch_probe_allocate(ctx: ptr, size: usize, align: usize) opt[ptr] {
    val p: *DepsScratchProbe = ctx::*DepsScratchProbe;
    p.calls = p.calls + 1;
    if (p.fail_at != 0 && p.calls == p.fail_at) { ret opt[ptr].none{}; }
    val r: opt[ptr] = p.backing.fn_allocate(p.backing.ctx, size, align);
    if (sel r.some) {
        p.live       = p.live + size::i64;
        p.live_count = p.live_count + 1;
        memory.raw_fill(r.some, 0xAA, size);
    }
    ret r;
}

fun deps_scratch_probe_reallocate(ctx: ptr, item: ptr, old_size: usize, new_size: usize, align: usize) opt[ptr] {
    val p: *DepsScratchProbe = ctx::*DepsScratchProbe;
    p.calls = p.calls + 1;
    if (p.fail_at != 0 && p.calls == p.fail_at) { ret opt[ptr].none{}; }
    val r: opt[ptr] = p.backing.fn_reallocate(p.backing.ctx, item, old_size, new_size, align);
    if (sel r.some) {
        p.live = p.live - old_size::i64 + new_size::i64;
        if (new_size > old_size) {
            val grown: ptr = r.some;
            memory.raw_fill((grown::usize + old_size)::ptr, 0xAA, new_size - old_size);
        }
    }
    ret r;
}

fun deps_scratch_probe_deallocate(ctx: ptr, item: ptr, size: usize, align: usize) i64 {
    val p: *DepsScratchProbe = ctx::*DepsScratchProbe;
    p.live       = p.live - size::i64;
    p.live_count = p.live_count - 1;
    ret p.backing.fn_deallocate(p.backing.ctx, item, size, align);
}

fun deps_scratch_probe_make(p: *DepsScratchProbe, alloc: *A.Allocator, fail_at: u32) bool {
    val make_r: err[A.Error] = page.make(?p.backing);
    if (sel make_r.err) { ret false; }
    p.live       = 0;
    p.live_count = 0;
    p.calls      = 0;
    p.fail_at    = fail_at;
    val probe: *DepsScratchProbe = p;
    alloc.ctx           = probe::ptr;
    alloc.fn_allocate   = deps_scratch_probe_allocate;
    alloc.fn_reallocate = deps_scratch_probe_reallocate;
    alloc.fn_deallocate = deps_scratch_probe_deallocate;
    ret true;
}

fun ut_build(s: *session.Session, alloc: *A.Allocator, names: *str, texts: *str, n: u32) res[project.Project, outcome.Fail] {
    val root_r: res[str, fail.Fail] = ut_scaffold(alloc, names, texts, n);
    if (sel root_r.err) { ret res[project.Project, outcome.Fail].err{outcome.from_fail(root_r.err)}; }
    val root: str               = root_r.ok;
    val rr:   err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.err) {
        fs.remove_all(alloc, root);
        ret res[project.Project, outcome.Fail].err{rr.err};
    }
    val pr: res[project.Project, outcome.Fail] = driver.build_project_union(s, root);
    fs.remove_all(alloc, root);
    ret pr;
}

fun ut_build_multi(s: *session.Session, alloc: *A.Allocator, names: *str, texts: *str, n: u32) res[project.Project, outcome.Fail] {
    val root_r: res[str, fail.Fail] = ut_scaffold_m(alloc, ut_manifest_multi(), names, texts, n);
    if (sel root_r.err) { ret res[project.Project, outcome.Fail].err{outcome.from_fail(root_r.err)}; }
    val root: str               = root_r.ok;
    val rr:   err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.err) {
        fs.remove_all(alloc, root);
        ret res[project.Project, outcome.Fail].err{rr.err};
    }
    val pr: res[project.Project, outcome.Fail] = driver.build_project_union(s, root);
    fs.remove_all(alloc, root);
    ret pr;
}

fun ut_build_test(s: *session.Session, alloc: *A.Allocator, names: *str, texts: *str, n: u32) res[project.Project, outcome.Fail] {
    val root_r: res[str, fail.Fail] = ut_scaffold(alloc, names, texts, n);
    if (sel root_r.err) { ret res[project.Project, outcome.Fail].err{outcome.from_fail(root_r.err)}; }
    val root: str               = root_r.ok;
    val rr:   err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.err) {
        fs.remove_all(alloc, root);
        ret res[project.Project, outcome.Fail].err{rr.err};
    }
    var pick: manifest.Selection;
    pick.target       = "";
    pick.profile      = "";
    pick.artifact     = "";
    pick.want_lib     = false;
    pick.has_artifact = false;
    val pr: res[project.Project, outcome.Fail] = driver.build_project_test(s, root, ?pick);
    fs.remove_all(alloc, root);
    ret pr;
}

fun ut_gated(p: *project.Project, s: *session.Session, fqn: str) bool {
    val mid: session.ModuleId = ut_mid(p, s, fqn);
    if (mid == session.MODULE_NIL) { ret false; }
    ret (?p.modules[mid::u32]).target_gated;
}

fun ut_in_topo(p: *project.Project, s: *session.Session, fqn: str) bool {
    val mid: session.ModuleId = ut_mid(p, s, fqn);
    if (mid == session.MODULE_NIL) { ret false; }
    var i: u32 = 0;
    for (i < p.topo_len) {
        if (p.topo[i] == mid) { ret true; }
        i = i + 1;
    }
    ret false;
}

test "mach.lang.driver:wildcard_match" {
    var bad: i32 = 0;
    if (!dcfg.wildcard_match("*.c", "mad.c"))           { bad = 1; }
    if (!dcfg.wildcard_match("*.c", ".c"))              { bad = 1; }
    if (!dcfg.wildcard_match("mini*.h", "miniaudio.h")) { bad = 1; }
    if (!dcfg.wildcard_match("a*b*c", "axxbyyc"))       { bad = 1; }
    if (!dcfg.wildcard_match("*", "anything"))          { bad = 1; }
    if (!dcfg.wildcard_match("exact.c", "exact.c"))     { bad = 1; }
    if (dcfg.wildcard_match("*.c", "mad.h"))            { bad = 1; }
    if (dcfg.wildcard_match("*.c", "mad.cpp"))          { bad = 1; }
    if (dcfg.wildcard_match("mini*.h", "audio.h"))      { bad = 1; }
    if (dcfg.wildcard_match("exact.c", "exact.cc"))     { bad = 1; }
    ret bad;
}

test "mach.lang.driver:glob_shape_ok" {
    var bad: i32 = 0;
    if (!dcfg.glob_shape_ok("dir/*.c"))    { bad = 1; }
    if (!dcfg.glob_shape_ok("dir/**/*.c")) { bad = 1; }
    if (!dcfg.glob_shape_ok("*.c"))        { bad = 1; }
    if (!dcfg.glob_shape_ok("a/b/c.c"))    { bad = 1; }
    if (dcfg.glob_shape_ok("a/*/b.c"))     { bad = 1; }
    if (dcfg.glob_shape_ok("a/**/**/*.c")) { bad = 1; }
    ret bad;
}

test "mach.lang.driver:dep_out_home" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var code: i32 = 0;

    val rel: res[str, outcome.Fail] = dcfg.dep_out_home(?alloc, ".", "out/linux/debug");
    if (!(sel rel.ok && path.is_abs(rel.ok))) { code = 1; }
    val cwd_r: res[string.OwnedString, env.EnvError] = env.current_dir(?alloc);
    if (sel cwd_r.err) { ret 1; }
    var cwd: string.OwnedString     = cwd_r.ok;
    val abs: res[str, outcome.Fail] = dcfg.dep_out_home(?alloc, cwd.data, "out/linux/debug");
    if (!(sel abs.ok && path.is_abs(abs.ok)))                        { code = 1; }
    if (sel rel.ok && (sel abs.ok && (!str_equals(rel.ok, abs.ok)))) { code = 1; }

    val abs_sub_r: res[str, A.Error] = path.resolve(?alloc, cwd.data, "subdir");
    if (sel abs_sub_r.err) { ret 1; }
    val rel_sub: res[str, outcome.Fail] = dcfg.dep_out_home(?alloc, "./subdir", "out/linux/debug");
    val abs_sub: res[str, outcome.Fail] = dcfg.dep_out_home(?alloc, abs_sub_r.ok, "out/linux/debug");
    val folded:  res[str, outcome.Fail] = dcfg.dep_out_home(?alloc, "./subdir/../subdir", "out/linux/debug");
    if (sel rel_sub.err)                     { ret 1; }
    if (sel abs_sub.err)                     { ret 1; }
    if (sel folded.err)                      { ret 1; }
    if (!str_equals(rel_sub.ok, abs_sub.ok)) { code = 1; }
    if (!str_equals(folded.ok, abs_sub.ok))  { code = 1; }
    ret code;
}

test "mach.lang.driver:test_gated_orphan_excluded" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [2]str;
    names[0] = "main.mach";
    names[1] = "gated.mach";
    var texts: [2]str;
    texts[0] = "fun main() i32 { ret 0; }\n";
    texts[1] = "$error(\"gated: not for this target\");\n\ntest \"gt\" { ret 0; }\n";

    val pr: res[project.Project, outcome.Fail] = ut_build_test(?s, ?alloc, ?names[0], ?texts[0], 2);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    var bad: i32 = 0;
    if (!ut_has(?p, ?s, "uniontest.gated"))    { bad = 1; }
    if (!ut_gated(?p, ?s, "uniontest.gated"))  { bad = 1; }
    if (ut_in_topo(?p, ?s, "uniontest.gated")) { bad = 1; }
    if (union.count_target_gated(?p) != 1)     { bad = 1; }
    if (!ut_in_topo(?p, ?s, "uniontest.main")) { bad = 1; }
    val se: err[outcome.Fail] = driver.run_sema_pass(?p);
    if (sel se.err)                       { bad = 1; }
    if (ut_count_errors(?p.s.diags) != 0) { bad = 1; }

    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

