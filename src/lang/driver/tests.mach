}

# driver union: a declared target this build cannot compose is skipped with a
# warning, not aborted, so the coverable targets still load (#1806). the strict
# `mach build <tuple>` path (select_target) is unaffected
test "mach.lang.driver:union_skips_uncoverable_target" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    # one coverable target (linux/x86_64) and one this build cannot emit
    val mf: str = "[project]\nid = \"uskip\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.good]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[target.bad]\nisa = \"aarch64\"\nos = \"windows\"\nabi = \"aapcs64\"\n\n[artifact.uskip]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/uskip\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "fun main() i32 { ret 0; }\n";

    val root_r: R.Result[str, str] = ut_scaffold_m(?alloc, mf, ?names[0], ?texts[0], 1);
    if (R.is_err[str, str](root_r)) { session.dnit(?s); ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);

    val rr: R.Result[bool, str] = driver.setup_registry(?s.registry);
    if (R.is_err[bool, str](rr)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }

    # the union does NOT abort on the uncoverable target; it keeps the coverable one.
    val pur: R.Result[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
    fs.remove_all(?alloc, root);
    if (R.is_err[project.Project, outcome.Fail](pur)) { session.dnit(?s); ret 1; }
    var pu: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pur);

    var bad: i32 = 0;
    if (pu.union_tuple_count != 1)      { bad = 1; }  # only [target.good] survived
    or (!ut_has(?pu, ?s, "uskip.main")) { bad = 1; }

    project.dnit_project(?pu);
    session.dnit(?s);
    ret bad;
}

# driver union: each target contributes only its first active branch (#1391)
test "mach.lang.driver:union_first_active_branch_per_target" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    var names: [3]str;
    names[0] = "main.mach"; names[1] = "a.mach"; names[2] = "b.mach";
    var texts: [3]str;
    # both targets are 64-bit, so the first branch (a) is every target's first active
    # one; b's condition is true on linux but b is never a FIRST match, so the union
    # includes a and excludes b (first-active per target, not include-every-true).
    texts[0] = "$if ($mach.build.pointer_width == 8) { use uniontest.a; }\n$or ($mach.build.os == $mach.os.linux) { use uniontest.b; }\n\nfun main() i32 { ret 0; }\n";
    texts[1] = "pub fun fa() i32 { ret 1; }\n";
    texts[2] = "pub fun fb() i32 { ret 2; }\n";

    val pr: R.Result[project.Project, outcome.Fail] = ut_build(?s, ?alloc, ?names[0], ?texts[0], 3);
    if (R.is_err[project.Project, outcome.Fail](pr)) { session.dnit(?s); ret 1; }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);

    var bad: i32 = 0;
    if (!ut_has(?p, ?s, "uniontest.a")) { bad = 1; }
    or (ut_has(?p, ?s, "uniontest.b"))  { bad = 1; }

    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

# driver union: every module's comptime ctx is restored to the default tuple (#1391)
test "mach.lang.driver:union_ctx_restored_to_default_tuple" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    var names: [3]str;
    names[0] = "main.mach"; names[1] = "a.mach"; names[2] = "b.mach";
    var texts: [3]str;
    texts[0] = "$if ($mach.build.os == $mach.os.linux) { use uniontest.a; }\n$or ($mach.build.os == $mach.os.windows) { use uniontest.b; }\n\nfun main() i32 { ret 0; }\n";
    texts[1] = "pub fun fa() i32 { ret 1; }\n";
    texts[2] = "pub fun fb() i32 { ret 2; }\n";

    val pr: R.Result[project.Project, outcome.Fail] = ut_build(?s, ?alloc, ?names[0], ?texts[0], 3);
    if (R.is_err[project.Project, outcome.Fail](pr)) { session.dnit(?s); ret 1; }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);

    # the per-target tuple is overridden then restored per union-walk iteration; no
    # module may carry a leaked non-default tuple afterward, so every loaded module's
    # ctx tuple must match and equal the host (native-resolved default) tuple.
    val cm: *comptime.ComptimeCtx = ut_ctx(?p, ?s, "uniontest.main");
    val ca: *comptime.ComptimeCtx = ut_ctx(?p, ?s, "uniontest.a");
    val cb: *comptime.ComptimeCtx = ut_ctx(?p, ?s, "uniontest.b");

    var bad: i32 = 0;
    if (cm == nil || ca == nil || cb == nil)        { bad = 1; }
    or (cm.target_os_id != ca.target_os_id)         { bad = 1; }
    or (cm.target_os_id != cb.target_os_id)         { bad = 1; }
    or (cm.target_arch_id != ca.target_arch_id)     { bad = 1; }
    or (cm.target_arch_id != cb.target_arch_id)     { bad = 1; }
    or (cm.pointer_width != ca.pointer_width)       { bad = 1; }
    or (cm.pointer_width != cb.pointer_width)       { bad = 1; }
    or (cm.target_os_id != target.host_os_id())     { bad = 1; }
    or (cm.target_arch_id != target.host_arch_id()) { bad = 1; }

    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

# driver union: a comptime const in a branch condition survives the tuple override (#1391)
test "mach.lang.driver:union_module_const_survives_tuple_override" {
