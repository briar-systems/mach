fun ut_instr_in_blocks(f: *ir.Function, iid: ir.InstructionId) bool {
    var bi: u32 = 0;
    for (bi < f.block_count) {
        val b: *ir.Block = ?f.blocks[bi];
        var k: u32       = 0;
        for (k < b.phi_count) {
            if (b.phis[k] == iid) { ret true; }
            k = k + 1;
        }
        k = 0;
        for (k < b.instr_count) {
            if (b.instructions[k] == iid) { ret true; }
            k = k + 1;
        }
        if (b.terminator == iid) { ret true; }
        bi = bi + 1;
    }
    ret false;
}

fun ut_dangling_ops(f: *ir.Function, iid: ir.InstructionId) u32 {
    val opt_ins: opt[*instruction.Instruction] = ir.instruction_get(f, iid);
    if (sel opt_ins.none) { ret 0; }
    val ins:  *instruction.Instruction = opt_ins.some;
    var hits: u32                      = 0;
    var oi:   u32                      = 0;
    for (oi < ins.operand_count) {
        val v: *value.Value = ?ins.operands[oi];
        if (v.kind == value.VAL_INSTR) {
            if (!ut_instr_in_blocks(f, v.data.instr)) { hits = hits + 1; }
        }
        oi = oi + 1;
    }
    ret hits;
}

fun ut_operand_audit(p: *project.Project, phis: *u32, dangling: *u32) {
    @phis     = 0;
    @dangling = 0;
    var ti: u32 = 0;
    for (ti < p.topo_len) {
        val m: *ir.Module = p.modules[p.topo[ti]::u32].ir_module;
        if (m != nil) {
            var fi: u32 = 0;
            for (fi < m.function_len) {
                val f:  *ir.Function = ?m.functions[fi];
                var bi: u32          = 0;
                for (bi < f.block_count) {
                    val b: *ir.Block = ?f.blocks[bi];
                    @phis = @phis + b.phi_count;
                    var k: u32 = 0;
                    for (k < b.phi_count) {
                        @dangling = @dangling + ut_dangling_ops(f, b.phis[k]);
                        k         = k + 1;
                    }
                    k = 0;
                    for (k < b.instr_count) {
                        @dangling = @dangling + ut_dangling_ops(f, b.instructions[k]);
                        k         = k + 1;
                    }
                    @dangling = @dangling + ut_dangling_ops(f, b.terminator);
                    bi        = bi + 1;
                }
                fi = fi + 1;
            }
        }
        ti = ti + 1;
    }
}

fun ut_lane_merge_src() str {
    ret "fun sink(h: u64, v: f32) u64 { ret h + 1; }\n\npub fun probe(seed: u64) f32 {\n    val z: f32 = seed::f32;\n    var a: f32x4 = f32x4{1.5, -2.25, 3.75, -0.5};\n    a[0] = a[0] + z;\n    var h: u64 = 0;\n    h = sink(h, a[0]);\n    var mx: f32 = a[0];\n    if (a[1] > mx) { mx = a[1]; }\n    ret mx;\n}\n\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n";
}

fun ut_manifest_o2() str {
    ret "[project]\nid = \"uniontest\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.linux]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[target.linux-arm64]\nisa = \"aarch64\"\nos = \"linux\"\nabi = \"aapcs64\"\n\n[target.linux-riscv64]\nisa = \"riscv64\"\nos = \"linux\"\nabi = \"lp64d\"\n\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n\n[artifact.uniontest]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/uniontest\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
}

fun ut_o2_lower(s: *session.Session, alloc: *A.Allocator, src: str, target_name: str) res[project.Project, outcome.Fail] {
    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = src;
    val root_r: res[str, fail.Fail] = ut_scaffold_m(alloc, ut_manifest_o2(), ?names[0], ?texts[0], 1);
    if (sel root_r.err) { ret res[project.Project, outcome.Fail].err{outcome.from_fail(root_r.err)}; }
    val root: str               = root_r.ok;
    val rr:   err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.err) {
        fs.remove_all(alloc, root);
        ret res[project.Project, outcome.Fail].err{rr.err};
    }
    var tsel_17664: manifest.Selection                 = ut_target_sel(target_name);
    val pr:         res[project.Project, outcome.Fail] = driver.build_project(s, root, ?tsel_17664);
    fs.remove_all(alloc, root);
    if (sel pr.err) { ret pr; }
    var p:  project.Project   = pr.ok;
    val se: err[outcome.Fail] = driver.run_sema_pass(?p);
    if (sel se.err) {
        project.dnit_project(?p);
        ret res[project.Project, outcome.Fail].err{se.err};
    }
    val le: err[outcome.Fail] = driver.run_lower_pass(?p);
    if (sel le.err) {
        project.dnit_project(?p);
        ret res[project.Project, outcome.Fail].err{le.err};
    }
    ret res[project.Project, outcome.Fail].ok{p};
}

fun ut_lane_merge_operands_ok(target_name: str) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    val pr: res[project.Project, outcome.Fail] = ut_o2_lower(?s, ?alloc, ut_lane_merge_src(), target_name);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    var bad:      i32 = 0;
    var phis:     u32 = 0;
    var dangling: u32 = 0;
    ut_operand_audit(?p, ?phis, ?dangling);
    if (phis == 0)     { bad = 1; }
    if (dangling != 0) { bad = 1; }

    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.me.pass.scalarize:lane_merge_phi_keeps_its_incoming" {
    var bad: i32 = 0;
    if (ut_lane_merge_operands_ok("linux-riscv64") != 0) { bad = 1; }
    if (ut_lane_merge_operands_ok("linux") != 0)         { bad = 1; }
    if (ut_lane_merge_operands_ok("linux-arm64") != 0)   { bad = 1; }
    ret bad;
}

fun ut_global_float_bits(s: *session.Session, m: *ir.Module, needle: str, is_f32: bool) i64 {
    val gi: i64 = ut_global_ix(s, m, needle);
    if (gi < 0) { ret 0 - 1; }
    val g: *ir.Global = ?m.globals[gi::u32];
    if (g.init.kind != value.VAL_CONST_FLOAT) { ret 0 - 1; }
    if (is_f32)                               { ret float.f64_to_f32_bits(float.f64_bits(g.init.data.float_lit))::i64; }
    ret float.f64_bits(g.init.data.float_lit)::i64;
}

test "mach.lang.driver:a_comptime_float_folds_at_its_declared_width" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "val A: f32 = 16777217.0;\nval B: f32 = A - 16777216.0;\nval C: f32 = 1.0 / 3.0 * 7.0 - 2.0;\nval H: f32 = 1.0 / 3.0 * 0.1;\nval N: f32 = 0.0 - (1.0 / 3.0);\nval D: f64 = 1.0 / 3.0 * 7.0 - 2.0;\nval E: f64 = 16777217.0 - 16777216.0;\nfun main() i32 { ret 0; }\n";

    val pr: res[project.Project, outcome.Fail] = ut_lower_n(?s, ?alloc, ?names[0], ?texts[0], 1);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    var ra: f32 = 16777217.0;
    var rb: f32 = ra - 16777216.0;
    var rc: f32 = 1.0 / 3.0 * 7.0 - 2.0;
    var rh: f32 = 1.0 / 3.0 * 0.1;
    var rn: f32 = 0.0 - (1.0 / 3.0);
    var rd: f64 = 1.0 / 3.0 * 7.0 - 2.0;
    var re: f64 = 16777217.0 - 16777216.0;

    var bad: i32        = 0;
    val m:   *ir.Module = ut_ir_of(?p, ?s, "uniontest.main");
    if (m == nil) { bad = 1; }
    or {
        if (ut_global_float_bits(?s, m, "uniontest.main.A", true) != 0x4B800000)     { bad = 1; }
        if (ut_global_float_bits(?s, m, "uniontest.main.A", true) != (ra:~u32)::i64) { bad = 1; }

        if (ut_global_float_bits(?s, m, "uniontest.main.B", true) != 0x00000000)     { bad = 1; }
        if (ut_global_float_bits(?s, m, "uniontest.main.B", true) != (rb:~u32)::i64) { bad = 1; }

        if (ut_global_float_bits(?s, m, "uniontest.main.C", true) != 0x3EAAAAB0)     { bad = 1; }
        if (ut_global_float_bits(?s, m, "uniontest.main.C", true) != (rc:~u32)::i64) { bad = 1; }

        if (ut_global_float_bits(?s, m, "uniontest.main.H", true) != 0x3D088889)     { bad = 1; }
        if (ut_global_float_bits(?s, m, "uniontest.main.H", true) != (rh:~u32)::i64) { bad = 1; }

        if (ut_global_float_bits(?s, m, "uniontest.main.N", true) != 0xBEAAAAAB)     { bad = 1; }
        if (ut_global_float_bits(?s, m, "uniontest.main.N", true) != (rn:~u32)::i64) { bad = 1; }

        if (ut_global_float_bits(?s, m, "uniontest.main.D", false) != 0x3FD5555555555550) { bad = 1; }
        if (ut_global_float_bits(?s, m, "uniontest.main.D", false) != (rd:~u64)::i64)     { bad = 1; }
        if (ut_global_float_bits(?s, m, "uniontest.main.E", false) != 0x3FF0000000000000) { bad = 1; }
        if (ut_global_float_bits(?s, m, "uniontest.main.E", false) != (re:~u64)::i64)     { bad = 1; }
    }

    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.driver:a_comptime_gate_on_a_float_reads_it_at_its_width" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "val K: f32 = 16777217.0;\n$if (K - 16777216.0 == 0.0) { val G: i64 = 1; }\n$or { val G: i64 = 0; }\nval K64: f64 = 16777217.0;\n$if (K64 - 16777216.0 == 0.0) { val G64: i64 = 1; }\n$or { val G64: i64 = 0; }\nval P: f32 = 0.1;\n$if (P > 0.1) { val GT: i64 = 1; }\n$or { val GT: i64 = 0; }\nval P64: f64 = 0.1;\n$if (P64 > 0.1) { val GT64: i64 = 1; }\n$or { val GT64: i64 = 0; }\nfun main() i32 { ret 0; }\n";

    val pr: res[project.Project, outcome.Fail] = ut_lower_n(?s, ?alloc, ?names[0], ?texts[0], 1);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    var bad: i32        = 0;
    val m:   *ir.Module = ut_ir_of(?p, ?s, "uniontest.main");
    if (m == nil) { bad = 1; }
    or {
        val gg: i64 = ut_global_ix(?s, m, "uniontest.main.G");
        if (gg < 0) { bad = 1; }
        or {
            if ((?m.globals[gg::u32]).init.data.int_lit != 1) { bad = 1; }
        }

        val gg64: i64 = ut_global_ix(?s, m, "uniontest.main.G64");
        if (gg64 < 0) { bad = 1; }
        or {
            if ((?m.globals[gg64::u32]).init.data.int_lit != 0) { bad = 1; }
        }

        val gt: i64 = ut_global_ix(?s, m, "uniontest.main.GT");
        if (gt < 0) { bad = 1; }
        or {
            if ((?m.globals[gt::u32]).init.data.int_lit != 0) { bad = 1; }
        }

        val gt64: i64 = ut_global_ix(?s, m, "uniontest.main.GT64");
        if (gt64 < 0) { bad = 1; }
        or {
            if ((?m.globals[gt64::u32]).init.data.int_lit != 0) { bad = 1; }
        }
    }

    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

rec UtSeed {
    set:   u32;
    bind:  u32;
    words: *u64;
    n:     u32;
}

fun ut_spv_read_seeded(alloc: *A.Allocator, img: *of.ObjectImage, loc: u32,
    seeds: *UtSeed, ns: u32) u64 {
    var n: u32  = 0;
    val w: *u32 = ut_spv_words(img, ?n);
    if (w == nil || n == 0) { ret UT_AGG_BAD; }

    val ar: res[*UtAggEval, A.Error] = A.allocate[UtAggEval](alloc, 1::usize);
    if (sel ar.err) { ret UT_AGG_BAD; }
    val st: *UtAggEval = ar.ok;
    ut_agg_reset(st);

    var out:    u64  = UT_AGG_BAD;
    val tgt:    u32  = ut_agg_location_var(w, n, loc);
    val entry:  u32  = ut_agg_entry_fn(w, n);
    var seeded: bool = true;
    if (ut_agg_prepare(st, w, n)) {
        var i: u32 = 0;
        for (i < ns) {
            val sd: *UtSeed = ?seeds[i];
            val v:  u32     = ut_spv_descriptor_var(w, n, sd.set, sd.bind);
            if (v == 0 || v >= UT_AGG_IDS || sd.n > UT_AGG_WORDS) {
                seeded = false;
                i      = ns;
                cnt;
            }
            var k: u32 = 0;
            for (k < sd.n) {
                st.val[v * UT_AGG_WORDS + k] = sd.words[k];
                k                            = k + 1;
            }
            i = i + 1;
        }
    }
    or { seeded = false; }
    if (seeded && tgt != 0 && tgt < UT_AGG_IDS && entry != 0 && ut_agg_exec(st, w, n, entry)) {
        if (st.is_ptr[tgt] && st.ty_words[st.ptr_ty[tgt]] == 1) {
            out = st.val[st.ptr_blk[tgt] * UT_AGG_WORDS + st.ptr_off[tgt]];
        }
    }

    A.deallocate[UtAggEval](alloc, st, 1::usize);
    ret out;
}

fun ut_spv_descriptor_value_src() str {
    ret "rec Blk { a: u32; b: u32; c: u32; }\nrec Plain { tag: u8; v: u32; tail: u8; }\n\n#[uniform(0, 0)] var ub: Blk;\n#[storage(1, 0, \"readonly\")] var sb: Blk;\n\nfun sum_blk(p: Blk) u32 { ret p.a + p.b * 10 + p.c * 100; }\nfun sum_plain(p: Plain) u32 { ret p.tag::u32 + p.v * 10 + p.tail::u32 * 100; }\n\n#[output(0)] var o_ub: u32;\n#[output(1)] var o_ub_ctl: u32;\n#[output(2)] var o_sb: u32;\n#[output(3)] var o_sb_ctl: u32;\n#[output(4)] var o_ub_copy: u32;\n#[output(5)] var o_rec: u32;\n#[output(6)] var o_rec_ctl: u32;\n\n#[stage(\"vertex\")]\nfun vs() {\n    o_ub = sum_blk(ub);\n    o_ub_ctl = ub.a + ub.b * 10 + ub.c * 100;\n    o_sb = sum_blk(sb);\n    o_sb_ctl = sb.a + sb.b * 10 + sb.c * 100;\n    var l: Blk = ub;\n    o_ub_copy = l.a + l.b * 10 + l.c * 100;\n    var r: Plain;\n    r.tag = ub.a::u8;\n    r.v = ub.b;\n    r.tail = ub.c::u8;\n    var r2: Plain = r;\n    o_rec = sum_plain(r2);\n    o_rec_ctl = r.tag::u32 + r.v * 10 + r.tail::u32 * 100;\n}\n\nfun main() i32 { ret 0; }\n";
}

test "mach.lang.driver:a_descriptor_block_crosses_a_call_by_value_on_spirv" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    var texts: [1]str;
    names[0] = "main.mach";
    texts[0] = ut_spv_descriptor_value_src();
    val pr: res[project.Project, outcome.Fail] = ut_spv_lower(?s, ?alloc, ?names[0], ?texts[0], 1, "", nil, nil, 0);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    var img:   of.ObjectImage;
    var fault: str = nil;
    if (!ut_spv_codegen(?p, ?s, "spvcase.main", ?img, ?fault)) {
        project.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }

    var uw: [3]u64;
    uw[0] = 3::u64;
    uw[1] = 4::u64;
    uw[2] = 5::u64;
    var sw: [3]u64;
    sw[0] = 6::u64;
    sw[1] = 7::u64;
    sw[2] = 8::u64;
    var seeds: [2]UtSeed;
    seeds[0].set   = 0;
    seeds[0].bind  = 0;
    seeds[0].words = ?uw[0];
    seeds[0].n     = 3;
    seeds[1].set   = 1;
    seeds[1].bind  = 0;
    seeds[1].words = ?sw[0];
    seeds[1].n     = 3;

    var bad: i32  = 0;
    var wn:  u32  = 0;
    val ww:  *u32 = ut_spv_words(?img, ?wn);
    if (ww == nil || wn == 0 || !ut_spv_var_loads_typed(ww, wn)) { bad = 1; }

    if (ut_spv_read_seeded(?alloc, ?img, 0, ?seeds[0], 2) != 543) { bad = 1; }
    if (ut_spv_read_seeded(?alloc, ?img, 1, ?seeds[0], 2) != 543) { bad = 1; }
    if (ut_spv_read_seeded(?alloc, ?img, 2, ?seeds[0], 2) != 876) { bad = 1; }
    if (ut_spv_read_seeded(?alloc, ?img, 3, ?seeds[0], 2) != 876) { bad = 1; }
    if (ut_spv_read_seeded(?alloc, ?img, 4, ?seeds[0], 2) != 543) { bad = 1; }
    if (ut_spv_read_seeded(?alloc, ?img, 5, ?seeds[0], 2) != 543) { bad = 1; }
    if (ut_spv_read_seeded(?alloc, ?img, 6, ?seeds[0], 2) != 543) { bad = 1; }

    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

fun ut_symaddr_and_agg(mm: *mir.MirModule, flat: bool, out_agg: *u32) u32 {
    var lea: u32 = 0;
    var ac:  u32 = 0;
    var fi:  u32 = 0;
    for (fi < mm.function_len) {
        val mf: *mir.MirFunction = ?mm.functions[fi];
        var bi: u32              = 0;
        for (bi < mf.block_count) {
            val blk: *mir.MirBlock = ?mf.blocks[bi];
            var ii:  u32           = 0;
            for (ii < blk.instr_count) {
                val mi: *mir.MirInstr = ?blk.instrs[ii];
                if (mi.opcode == mir.MIR_GEP && mi.operand_count == 2
                    && mi.operands[1].kind == mir.MIR_OP_SYM) { lea = lea + 1; }
                if (flat && mi.opcode == mir.MIR_LOAD && mi.operand_count == 2
                    && mi.operands[1].kind == mir.MIR_OP_SYM) { lea = lea + 1; }
                if (flat && mi.opcode == mir.MIR_STORE && mi.operand_count == 2
                    && mi.operands[0].kind == mir.MIR_OP_SYM) { lea = lea + 1; }
                if (mi.opcode == mir.MIR_VALUE_CALL)                             { ac = ac + 1; }
                if (mi.opcode == mir.MIR_VALUE_PARAM)                            { ac = ac + 1; }
                if (mi.opcode == mir.MIR_MEMCPY || mi.opcode == mir.MIR_MEMZERO) { ac = ac + 1; }
                ii = ii + 1;
            }
            bi = bi + 1;
        }
        fi = fi + 1;
    }
    @out_agg = ac;
    ret lea;
}

fun ut_symaddr_shape(alloc: *A.Allocator, src: str, tname: str, out_agg: *u32) i64 {
    val sr: res[session.Session, fail.Fail] = session.init(alloc);
    if (sel sr.err) { ret -1; }
    var s:  session.Session                    = sr.ok;
    val pr: res[project.Project, outcome.Fail] = ut_vec_lower(?s, alloc, src, tname);
    if (sel pr.err) {
        session.dnit(?s);
        ret -1;
    }
    var p:    project.Project = pr.ok;
    var out:  i64             = -1;
    var aggs: u32             = 0;
    var mi:   u32             = 0;
    for (mi < p.module_len) {
        val me: *project.ModuleEntry = ?p.modules[mi];
        if (me.ir_module == nil) {
            mi = mi + 1;
            cnt;
        }
        val mr: res[mir.MirModule, fail.Fail] = mirlower.lower_module(?p.target, me.ir_module, alloc, ?s.interner, ?s.sources);
        if (sel mr.err) {
            mi = mi + 1;
            cnt;
        }
        var mm: mir.MirModule = mr.ok;
        var ac: u32           = 0;
        val c:  u32           = ut_symaddr_and_agg(?mm, p.target.isa.model.flat_addressing, ?ac);
        if (out < 0) { out = 0; }
        out  = out + c::i64;
        aggs = aggs + ac;
        mi   = mi + 1;
    }
    @out_agg = aggs;
    project.dnit_project(?p);
    session.dnit(?s);
    ret out;
}

test "mach.lang.driver:a_symbol_address_materializes_only_on_a_flat_target" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }

    val ssrc: str = "rec P { a: u32; b: u32; }\n#[uniform(0, 0)] var blk: P;\nfun sum(p: P) u32 { ret p.a + p.b * 10; }\n#[output(0)] var o: u32;\n#[stage(\"vertex\")]\nfun vs() { o = sum(blk); }\nfun main() i32 { ret 0; }\n";
    val nsrc: str = "rec P { a: u32; b: u32; }\nvar g: P;\nfun sum(p: P) u32 { ret p.a + p.b * 10; }\nfun rd() u32 { ret sum(g); }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret rd()::i32; }\n";

    var bad: i32 = 0;

    var sa: u32 = 0;
    if (ut_symaddr_shape(?alloc, ssrc, "spirv", ?sa) != 0) { bad = 1; }
    if (sa < 1)                                            { bad = 1; }

    var fa: u32 = 0;
    if (ut_symaddr_shape(?alloc, nsrc, "linux", ?fa) < 1)         { bad = 1; }
    if (fa != 0)                                                  { bad = 1; }
    if (ut_symaddr_shape(?alloc, nsrc, "linux-arm64", ?fa) < 1)   { bad = 1; }
    if (fa != 0)                                                  { bad = 1; }
    if (ut_symaddr_shape(?alloc, nsrc, "linux-riscv64", ?fa) < 1) { bad = 1; }
    if (fa != 0)                                                  { bad = 1; }

    ret bad;
}

fun ut_spv_var_pointee(w: *u32, n: u32, var_id: u32) u32 {
    var ptr_ty: u32 = 0;
    var i:      u32 = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0) { ret 0; }
        if ((w[i] & 0xFFFF) == spirv.OP_VARIABLE && len >= 3 && w[i + 2] == var_id) {
            ptr_ty = w[i + 1];
            i      = n;
            cnt;
        }
        i = i + len;
    }
    if (ptr_ty == 0) { ret 0; }
    i = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0) { ret 0; }
        if ((w[i] & 0xFFFF) == spirv.OP_TYPE_POINTER && len == 4 && w[i + 1] == ptr_ty) {
            ret w[i + 3];
        }
        i = i + len;
    }
    ret 0;
}

fun ut_spv_var_loads_typed(w: *u32, n: u32) bool {
    var i: u32 = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0) { ret false; }
        if ((w[i] & 0xFFFF) == spirv.OP_LOAD && len >= 4) {
            val pointee: u32 = ut_spv_var_pointee(w, n, w[i + 3]);
            if (pointee != 0 && pointee != w[i + 1]) { ret false; }
        }
        i = i + len;
    }
    ret true;
}

rec LiveBytes {
    backing: A.Allocator;
    live:    i64;
}

fun live_alloc(ctx: ptr, size: usize, align: usize) opt[ptr] {
    val t: *LiveBytes = ctx::*LiveBytes;
    val r: opt[ptr]   = t.backing.fn_allocate(t.backing.ctx, size, align);
    if (sel r.some) { t.live = t.live + size::i64; }
    ret r;
}

fun live_realloc(ctx: ptr, p: ptr, old_size: usize, new_size: usize, align: usize) opt[ptr] {
    val t: *LiveBytes = ctx::*LiveBytes;
    val r: opt[ptr]   = t.backing.fn_reallocate(t.backing.ctx, p, old_size, new_size, align);
    if (sel r.some) { t.live = t.live - old_size::i64 + new_size::i64; }
    ret r;
}

fun live_dealloc(ctx: ptr, p: ptr, size: usize, align: usize) i64 {
    val t: *LiveBytes = ctx::*LiveBytes;
    t.live = t.live - size::i64;
    ret t.backing.fn_deallocate(t.backing.ctx, p, size, align);
}

fun live_bytes_make(t: *LiveBytes, a: *A.Allocator) bool {
    val make_r: err[A.Error] = page.make(?t.backing);
    if (sel make_r.err) { ret false; }
    t.live          = 0;
    a.ctx           = t::ptr;
    a.fn_allocate   = live_alloc;
    a.fn_reallocate = live_realloc;
    a.fn_deallocate = live_dealloc;
    ret true;
}

test "mach.lang.driver:retained_reload_cycle_reaches_steady_state" {
    var lb:    LiveBytes;
    var alloc: A.Allocator;
    if (!live_bytes_make(?lb, ?alloc)) { ret 1; }

    var names: [4]str;
    names[0] = "alpha.mach";
    names[1] = "beta.mach";
    names[2] = "model.mach";
    names[3] = "orphan.mach";
    var texts: [4]str;
    texts[0] = "fun main() i32 { ret no_such(); }\n";
    texts[1] = "use ctxcase.model;\nfun main() i32 { var b: model.Box[model.Leaf]; ret model.take[model.Leaf](b); }\n";
    texts[2] = "pub rec Leaf { n: i32; }\npub rec Box[T] { v: T; }\npub fun take[T](b: Box[T]) i32 { ret 7; }\n";
    texts[3] = "fun broken() NoSuch { var x: AlsoMissing; ret x; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold_m(
        ?alloc, ut_manifest_frontend(), ?names[0], ?texts[0], 4);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;

    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) {
        fs.remove_all(?alloc, root);
        ret 1;
    }
    var s: session.Session = sr.ok;

    var bad:     i32 = 0;
    var settled: i64 = 0;
    var round:   i32 = 0;
    for (round < 5) {
        val mr: res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, root);
        if (sel mr.err) {
            bad = 2;
            brk;
        }
        var mf: manifest.Manifest = mr.ok;

        var req: request.BuildRequest = request.defaults();
        req.project_root = root;
        req.target       = "windows";
        req.profile      = "release";
        req.artifact     = "beta";
        req.want_lib     = false;
        req.goal         = request.GOAL_OBJECTS;
        req.opt          = pipeline.OPT_RELEASE;
        req.pie          = true;

        val pr: res[project.Project, outcome.Fail] = driver.analyze_project(?s, ?mf, ?req, nil, 0);
        if (sel pr.err) {
            manifest.dnit(?mf, ?alloc);
            bad = 3;
            brk;
        }
        var p: project.Project = pr.ok;
        project.dnit_project(?p);
        manifest.dnit(?mf, ?alloc);

        if (round == 2) { settled = lb.live; }
        if (round > 2 && lb.live != settled) {
            bad = 4;
            brk;
        }
        round = round + 1;
    }

    session.dnit(?s);
    fs.remove_all(?alloc, root);
    ret bad;
}

fun ut_manifest_with_dep() str {
    ret "[project]\nid = \"ctxcase\"\nversion = \"1.2.3\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.windows]\nisa = \"x86_64\"\nos = \"windows\"\nabi = \"win64\"\n\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n\n[dep.leaf]\npath = \"dep/leaf\"\n\n[artifact.beta]\nkind = \"bin\"\nentry = \"beta.mach\"\nout = \"bin/beta\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
}

fun ut_scaffold_dep(alloc: *A.Allocator, root: str) bool {
    val dep_root:         str             = ut_cc3(alloc, root, "/dep/", "leaf");
    val create_dir_all_r: err[fs.FsError] = fs.create_dir_all(alloc, dep_root, 493);
    if (sel create_dir_all_r.err) { ret false; }
    val dep_src:           str             = ut_cc3(alloc, dep_root, "/", "src");
    val create_dir_all_r2: err[fs.FsError] = fs.create_dir_all(alloc, dep_src, 493);
    if (sel create_dir_all_r2.err) { ret false; }

    val dm:            str             = "[project]\nid = \"leaf\"\nversion = \"0.1.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.windows]\nisa = \"x86_64\"\nos = \"windows\"\nabi = \"win64\"\n\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n\n[artifact.leaf]\nkind = \"static\"\nentry = \"leaf.mach\"\nout = \"lib/leaf.a\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
    val dmp:           str             = ut_cc3(alloc, dep_root, "/", manifest.MANIFEST_FILE);
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(dmp, dm, str_len(dm), 420);
    if (sel write_bytes_r.err) { ret false; }

    val ds:             str             = "pub fun leaf_value() i32 { ret 7; }\n";
    val dsp:            str             = ut_cc3(alloc, dep_src, "/", "leaf.mach");
    val write_bytes_r2: err[fs.FsError] = fs.write_bytes(dsp, ds, str_len(ds), 420);
    if (sel write_bytes_r2.err) { ret false; }
    ret true;
}

test "mach.lang.driver:retained_reload_cycle_with_a_dependency_is_steady" {
    var lb:    LiveBytes;
    var alloc: A.Allocator;
    if (!live_bytes_make(?lb, ?alloc)) { ret 1; }

    var names: [1]str;
    names[0] = "beta.mach";
    var texts: [1]str;
    texts[0] = "use leaf.leaf;\nfun main() i32 { ret leaf.leaf_value(); }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold_m(
        ?alloc, ut_manifest_with_dep(), ?names[0], ?texts[0], 1);
    if (sel root_r.err) { ret 2; }
    val root: str = root_r.ok;
    if (!ut_scaffold_dep(?alloc, root)
        || !ut_git_repo(?alloc, root, "https://example.invalid/app.git")) {
        fs.remove_all(?alloc, root);
        ret 3;
    }

    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) {
        fs.remove_all(?alloc, root);
        ret 4;
    }
    var s: session.Session = sr.ok;

    var bad:     i32 = 0;
    var settled: i64 = 0;
    var round:   i32 = 0;
    for (round < 5) {
        val mr: res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, root);
        if (sel mr.err) {
            bad = 5;
            brk;
        }
        var mf: manifest.Manifest = mr.ok;
        if (mf.dep_count == 0) {
            manifest.dnit(?mf, ?alloc);
            bad = 6;
            brk;
        }

        var req: request.BuildRequest = request.defaults();
        req.project_root = root;
        req.target       = "windows";
        req.profile      = "release";
        req.artifact     = "beta";
        req.want_lib     = false;
        req.goal         = request.GOAL_OBJECTS;
        req.opt          = pipeline.OPT_RELEASE;
        req.pie          = true;

        val pr: res[project.Project, outcome.Fail] = driver.analyze_project(?s, ?mf, ?req, nil, 0);
        if (sel pr.err) {
            manifest.dnit(?mf, ?alloc);
            bad = 7;
            brk;
        }
        var p: project.Project = pr.ok;
        project.dnit_project(?p);
        manifest.dnit(?mf, ?alloc);

        if (round == 2) { settled = lb.live; }
        if (round > 2 && lb.live != settled) {
            print.eprintlnf("dependency reload {}: expected {} live bytes, found {}", round, settled, lb.live);
            bad = 8;
            brk;
        }
        round = round + 1;
    }

    session.dnit(?s);
    fs.remove_all(?alloc, root);
    ret bad;
}

fun ut_lower_diag(src: str, needle: str) i32 {
    var names: [1]str = [1]str{"main.mach"};
    var texts: [1]str = [1]str{src};
    ret ut_ct_lower_diag_n(?names[0], ?texts[0], 1, needle);
}

test "mach.lang.fe.sema:layout_intrinsic_adopts_the_binding_width" {
    var bad: i32 = 0;
    val pre: str = "rec P { x: i64; y: i64; }\n";

    if (!ut_sema_clean(ut_cc_src(pre, "val A: u8  = $size_of(P);\n"))) { bad = 1; }
    if (!ut_sema_clean(ut_cc_src(pre, "val A: u16 = $size_of(P);\n"))) { bad = 2; }
    if (!ut_sema_clean(ut_cc_src(pre, "val A: u32 = $size_of(P);\n"))) { bad = 3; }
    if (!ut_sema_clean(ut_cc_src(pre, "val A: u64 = $size_of(P);\n"))) { bad = 4; }
    if (!ut_sema_clean(ut_cc_src(pre, "val A: i32 = $size_of(P);\n"))) { bad = 5; }
    if (!ut_sema_clean(ut_cc_src(pre, "val A: i64 = $size_of(P);\n"))) { bad = 6; }

    if (!ut_sema_clean(ut_cc_src(pre, "val A: u8  = $align_of(P);\n")))      { bad = 7; }
    if (!ut_sema_clean(ut_cc_src("", "val A: u16 = $length_of([4]i32);\n"))) { bad = 8; }

    if (!ut_sema_clean(ut_cc_src(pre, "val N: u32 = 3;\nval A: u32 = N * $size_of(P);\n"))) { bad = 9; }

    if (!ut_sema_clean(ut_cc_src(pre,
        "fun sz[T]() u32 { var n: u32 = $size_of(T); ret n; }\nfun use_it() u32 { ret sz[P](); }\n"))) { bad = 10; }
    ret bad;
}

test "mach.lang.fe.sema:layout_intrinsic_too_wide_for_its_binding_is_refused" {
    var bad: i32 = 0;
    if (ut_vec_diag("rec Huge { a: [300]u8; }\nval A: u8 = $size_of(Huge);\nfun main() i32 { ret 0; }\n",
        "value 300 is out of range for u8") != 0) { bad = 1; }
    if (ut_vec_diag("rec Big { a: [200]u8; }\nval A: i8 = $size_of(Big);\nfun main() i32 { ret 0; }\n",
        "is out of range for i8") != 0) { bad = 2; }
    ret bad;
}

test "mach.lang.fe.sema:out_of_range_literal_operand_is_rejected_regardless_of_order" {
    var bad: i32 = 0;
    if (ut_vec_diag("fun f(x: u8) u8 { ret x + 300; }\nfun main() i32 { ret 0; }\n",
        "literal 300 is out of range for u8") != 0) { bad = 1; }
    if (ut_vec_diag("fun f(x: u8) u8 { ret 300 + x; }\nfun main() i32 { ret 0; }\n",
        "literal 300 is out of range for u8") != 0) { bad = 2; }
    if (!ut_sema_clean("fun f(x: u8) u8 { ret x + 5; }\nfun g(x: u8) u8 { ret 5 + x; }\nfun main() i32 { ret 0; }\n")) { bad = 3; }
    ret bad;
}

test "mach.lang.fe.sema:layout_intrinsic_declines_a_non_integer_binding" {
    var bad: i32 = 0;
    if (ut_vec_diag("rec P { x: i64; }\nval A: f64 = $size_of(P);\nfun main() i32 { ret 0; }\n",
        "type mismatch") != 0) { bad = 1; }
    ret bad;
}

test "mach.lang.fe.sema:offset_of_too_wide_for_its_binding_is_refused" {
    var bad: i32 = 0;
    # the offset folds during type checking from the checked layout, so the width check is the same one `$size_of` meets
    if (!ut_sema_rejects_with("rec Wide { pad: [300]u8; tail: i32; }\nval A: u8 = $offset_of(Wide, tail);\nfun main() i32 { ret 0; }\n",
        "value 300 is out of range for u8")) { bad = 1; }
    if (!ut_sema_clean("rec Wide { pad: [300]u8; tail: i32; }\nval A: u32 = $offset_of(Wide, tail);\nfun main() i32 { ret 0; }\n")) { bad = 2; }
    ret bad;
}

test "mach.lang.fe.sema:a_pack_on_a_body_less_fun_is_refused" {
    var bad: i32 = 0;

    if (ut_vec_diag("#[library(\"raylib\")]\next fun TextFormat(text: *u8, va: ...) *u8;\nfun main() i32 { ret 0; }\n",
        "cannot appear on a body-less `fun`") != 0) { bad = 1; }

    if (ut_vec_note("#[library(\"raylib\")]\next fun TextFormat(text: *u8, va: ...) *u8;\nfun main() i32 { ret 0; }\n",
        "ext fun f(a: T, ...)") != 0) { bad = 2; }

    if (ut_vec_diag("ext fun g(a: i32, va: ...) i32;\nfun main() i32 { ret 0; }\n",
        "cannot appear on a body-less `fun`") != 0) { bad = 3; }

    if (!ut_sema_clean("ext fun printf(fmt: *u8, ...) i32;\nfun main() i32 { ret 0; }\n"))       { bad = 4; }
    if (!ut_sema_clean("fun fold(h: u64, va: ...) u64 { ret h; }\nfun main() i32 { ret 0; }\n")) { bad = 5; }
    if (!ut_sema_clean("ext fun strlen(s: *u8) i64;\nfun main() i32 { ret 0; }\n"))              { bad = 6; }
    ret bad;
}

test "mach.lang.driver:c_variadic_promotion_survives_monomorphization" {
    var bad:   i32 = 0;
    val decls: str = "ext fun printf(fmt: *u8, ...) i32;\nfun log1[A](fmt: *u8, a: A) i32 { ret printf(fmt, a); }\n";

    if (ut_vec_diag(ut_cc_src(decls, "fun use_it() i32 { var c: u8 = 65; ret log1[u8](\"%d\\n\", c); }\n"),
        "is promoted to a 32-bit integer in a C-variadic argument") != 0) { bad = 1; }

    if (ut_vec_diag(ut_cc_src(decls, "fun use_it() i32 { ret log1[f32](\"%f\\n\", 1.5::f32); }\n"),
        "is promoted to `f64` in a C-variadic argument") != 0) { bad = 2; }

    if (!ut_sema_clean(ut_cc_src(decls, "fun use_it() i32 { ret log1[i32](\"%d\\n\", 7::i32); }\n")))  { bad = 3; }
    if (!ut_sema_clean(ut_cc_src(decls, "fun use_it() i32 { ret log1[f64](\"%f\\n\", 2.5); }\n")))     { bad = 4; }
    if (!ut_sema_clean(ut_cc_src(decls, "fun use_it() i32 { ret log1[i64](\"%ld\\n\", 9::i64); }\n"))) { bad = 5; }

    if (!ut_sema_clean(ut_cc_src(decls, "fun use_it() i32 { var p: *u8 = nil; ret log1[*u8](\"%s\\n\", p); }\n"))) { bad = 6; }

    val d2: str = "ext fun printf(fmt: *u8, ...) i32;\nfun log2[A, B](fmt: *u8, a: A, b: B) i32 { ret printf(fmt, a, b); }\n";
    if (ut_vec_diag(ut_cc_src(d2, "fun use_it() i32 { var c: u8 = 65; ret log2[i32, u8](\"%d %d\\n\", 1::i32, c); }\n"),
        "is promoted to a 32-bit integer in a C-variadic argument") != 0) { bad = 7; }
    if (!ut_sema_clean(ut_cc_src(d2, "fun use_it() i32 { ret log2[i32, f64](\"%d %f\\n\", 1::i32, 2.5); }\n"))) { bad = 8; }

    if (ut_sema_errs("fun inner[U](v: U) u32 { var acc: *u8 = nil; acc = 7; ret 0; }\nfun outer[T](v: T) u32 { ret inner[T](v); }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { outer[u32](1); ret 0; }\n") != 1) { bad = 9; }
    ret bad;
}

test "mach.lang.fe.sema:a_pack_forwards_into_a_c_variadic_tail" {
    val decls: str = "ext fun printf(fmt: *u8, ...) i32;\npub fun logf(fmt: *u8, va: ...) i32 { ret printf(fmt, va...); }\n";
    var bad:   i32 = 0;

    if (!ut_sema_clean(ut_cc_src(decls, "fun use_it() i32 { ret logf(\"%d %f\\n\", 1::i32, 2.5); }\n"))) { bad = 1; }
    if (!ut_sema_clean(ut_cc_src(decls, "fun use_it() i32 { ret logf(\"hi\\n\"); }\n")))                 { bad = 2; }

    if (ut_vec_diag(ut_cc_src(decls, "fun use_it() i32 { var c: u8 = 65; ret logf(\"%d\\n\", c); }\n"),
        "is promoted to a 32-bit integer in a C-variadic argument") != 0) { bad = 3; }
    if (ut_vec_diag(ut_cc_src(decls, "fun use_it() i32 { ret logf(\"%f\\n\", 1.5::f32); }\n"),
        "is promoted to `f64` in a C-variadic argument") != 0) { bad = 4; }
    if (ut_vec_diag(ut_cc_src(decls, "fun use_it() i32 { var c: u8 = 65; ret logf(\"%d %d\\n\", 1::i32, c); }\n"),
        "is promoted to a 32-bit integer in a C-variadic argument") != 0) { bad = 5; }

    if (!ut_sema_clean("fun plain(h: u64, va: ...) u64 { ret h; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var c: u8 = 65; plain(1, c); ret 0; }\n")) { bad = 6; }

    if (ut_vec_diag("fun fixed(a: i32) i32 { ret a; }\nfun fwd(va: ...) i32 { ret fixed(va...); }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { fwd(1::i32); ret 0; }\n",
        "cannot spread `...` into fixed parameters") != 0) { bad = 7; }

    if (ut_vec_diag(ut_cc_src(decls, "fun use_it() i32 { var s: ^i32 = 1; ret logf(\"%d\\n\", s); }\n"),
        "secret value cannot be passed to a") != 0) { bad = 8; }
    ret bad;
}

test "mach.lang.driver:c_variadic_contract_follows_the_call_chain" {
    var bad: i32 = 0;
    val d1:  str = "ext fun printf(fmt: *u8, ...) i32;\nfun log1[A](fmt: *u8, a: A) i32 { ret printf(fmt, a); }\nfun wrap2[A](fmt: *u8, a: A) i32 { ret log1[A](fmt, a); }\n";

    if (ut_vec_diag(ut_cc_src(d1, "fun use_it() i32 { var c: u8 = 65; ret wrap2[u8](\"%d\\n\", c); }\n"),
        "is promoted to a 32-bit integer in a C-variadic argument") != 0) { bad = 1; }

    val d2: str = "ext fun printf(fmt: *u8, ...) i32;\nfun log1[A](fmt: *u8, a: A) i32 { ret printf(fmt, a); }\nfun wrap2[A](fmt: *u8, a: A) i32 { ret log1[A](fmt, a); }\nfun wrap3[A](fmt: *u8, a: A) i32 { ret wrap2[A](fmt, a); }\n";
    if (ut_vec_diag(ut_cc_src(d2, "fun use_it() i32 { var c: u8 = 65; ret wrap3[u8](\"%d\\n\", c); }\n"),
        "is promoted to a 32-bit integer in a C-variadic argument") != 0) { bad = 2; }

    if (!ut_sema_clean(ut_cc_src(d2, "fun use_it() i32 { ret wrap3[i32](\"%d\\n\", 7::i32); }\n"))) { bad = 3; }

    val d3: str = "ext fun printf(fmt: *u8, ...) i32;\nfun ping[A](n: i32, a: A) i32 { if (n <= 0) { ret printf(\"%d\\n\", a); } ret pong[A](n - 1, a); }\nfun pong[A](n: i32, a: A) i32 { ret ping[A](n - 1, a); }\n";
    if (ut_vec_diag(ut_cc_src(d3, "fun use_it() i32 { var c: u8 = 65; ret ping[u8](4, c); }\n"),
        "is promoted to a 32-bit integer in a C-variadic argument") != 0) { bad = 4; }
    if (!ut_sema_clean(ut_cc_src(d3, "fun use_it() i32 { ret ping[i32](4, 7::i32); }\n"))) { bad = 5; }

    if (ut_sema_errs("fun leaf[U](v: U) u32 { var acc: *u8 = nil; acc = 7; ret 0; }\nfun mid[T](v: T) u32 { ret leaf[T](v); }\nfun top[T](v: T) u32 { ret mid[T](v); }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { top[u32](1); ret 0; }\n") != 1) { bad = 6; }
    ret bad;
}

fun ut_manifest_overlay_src() str {
    ret "[project]\nid = \"ctxcase\"\nversion = \"1.2.3\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.windows]\nisa = \"x86_64\"\nos = \"windows\"\nabi = \"win64\"\n\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n\n[artifact.beta]\nkind = \"bin\"\nentry = \"beta.mach\"\nout = \"bin/beta\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
}

test "mach.lang.driver:an_overlay_is_found_through_the_manifest_src" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "beta.mach";
    var texts: [1]str;
    texts[0] = "fun main() i32 { ret no_such_symbol(); }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold_m(?alloc, ut_manifest_overlay_src(), ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 2;
    }
    val root: str = root_r.ok;

    val ov_path: str            = ut_cc3(?alloc, root, "/src/", "beta.mach");
    val osr:     err[fail.Fail] = session.set_overlay(?s, ov_path, "fun main() i32 { ret 0; }\n");
    if (sel osr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 3;
    }

    var bad: i32                                  = 0;
    val mr:  res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) { bad = 4; }
    if (sel mr.ok) {
        var mf:  manifest.Manifest    = mr.ok;
        var req: request.BuildRequest = request.defaults();
        req.project_root = root;
        req.target       = "windows";
        req.profile      = "release";
        req.artifact     = "beta";
        req.goal         = request.GOAL_OBJECTS;
        req.opt          = pipeline.OPT_RELEASE;

        val pr: res[project.Project, outcome.Fail] = driver.analyze_project(?s, ?mf, ?req, nil, 0);
        if (sel pr.err) { bad = 5; }
        if (sel pr.ok) {
            var p: project.Project = pr.ok;
            if (ut_count_errors(?p.s.diags) != 0) { bad = 6; }
            project.dnit_project(?p);
        }
        manifest.dnit(?mf, ?alloc);
    }

    session.dnit(?s);
    fs.remove_all(?alloc, root);
    ret bad;
}

fun ut_rv32_xbank_src() str {
    ret "#[symbol(\"_start\")]\nfun probe(pick: i32, v: i64) i64 {\n    val f: f64 = v :~ f64;\n    if (pick == 0) { ret f :~ i64; }\n    # a round trip through the float bank and back, so BOTH directions run in one\n    # image and a lowering that is wrong in only one of them cannot pass.\n    if (pick == 1) { val g: f64 = (f :~ i64) :~ f64; ret g :~ i64; }\n    # the width the register form DOES exist at on rv32 (fmv.w.x / fmv.x.w), so a\n    # change that routed everything through memory would still be caught here.\n    val n: i32 = v::i32;\n    val s: f32 = n :~ f32;\n    ret (s :~ i32)::i64;\n}\n";
}

test "mach.lang.driver:an_rv32_cross_bank_reinterpret_round_trips_on_the_core" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    val mr: res[*u8, A.Error] = A.allocate[u8](?alloc, UT_RV32_MEM);
    if (sel mr.err) {
        session.dnit(?s);
        ret 1;
    }
    val mem: *u8 = mr.ok;

    var bad: i32 = 0;
    var len: u32 = 0;
    if (!ut_rv32_build_linked(?s, ?alloc, ut_rv32_xbank_src(), "rv32", mem, ?len)) { bad = 2; }
    or {
        val payload: u64 = 0xC0FFEE0D_DEADBEEF;
        var steps:   u32 = 0;

        var got: u64 = 0;
        if (!ut_rv32_run_g(mem, 0, payload, ?got, ?steps)) { bad = 3; }
        or (got != payload)                                { bad = 4; }

        if (bad == 0) {
            var got2: u64 = 0;
            if (!ut_rv32_run_g(mem, 1, payload, ?got2, ?steps)) { bad = 5; }
            or (got2 != payload)                                { bad = 6; }
        }

        if (bad == 0) {
            var got3: u64 = 0;
            if (!ut_rv32_run_g(mem, 2, payload, ?got3, ?steps)) { bad = 7; }
            or (got3 != 0xFFFFFFFFDEADBEEF)                     { bad = 8; }
        }
    }

    A.deallocate[u8](?alloc, mem, UT_RV32_MEM);
    session.dnit(?s);
    ret bad;
}

fun ut_manifest_stack_elf() str {
    ret "[project]\nid = \"stk\"\nversion = \"0.1.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.win]\nisa = \"x86_64\"\nos = \"windows\"\nabi = \"win64\"\nstack_reserve = 8388608\n\n[target.lin]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\nstack_reserve = 8388608\n\n[profile.debug]\nopt = 0\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n\n[artifact.stk]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/stk\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
}

fun ut_manifest_stack_pe() str {
    ret "[project]\nid = \"stk\"\nversion = \"0.1.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.win]\nisa = \"x86_64\"\nos = \"windows\"\nabi = \"win64\"\nstack_reserve = 8388608\nstack_commit = 8192\n\n[profile.debug]\nopt = 0\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n\n[artifact.stk]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/stk.exe\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
}

test "mach.lang.driver:a_stack_key_on_a_format_without_one_is_refused_at_load" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "fun main() i32 { ret 0; }\n";

    var bad: i32 = 0;

    val bad_root_r: res[str, fail.Fail] = ut_scaffold_m(?alloc, ut_manifest_stack_elf(), ?names[0], ?texts[0], 1);
    if (sel bad_root_r.err) {
        session.dnit(?s);
        ret 2;
    }
    val bad_root: str = bad_root_r.ok;

    val br: res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, bad_root);
    if (sel br.ok) {
        var m: manifest.Manifest = br.ok;
        manifest.dnit(?m, ?alloc);
        bad = 3;
    }
    if (sel br.err) {
        val msg: str = outcome.describe(br.err);
        if (!str_contains(msg, "stack_reserve") && bad == 0) { bad = 4; }
        if (!str_contains(msg, "lin") && bad == 0)           { bad = 5; }
        if (!str_contains(msg, "elf") && bad == 0)           { bad = 6; }
    }
    fs.remove_all(?alloc, bad_root);

    if (bad == 0) {
        val ok_root_r: res[str, fail.Fail] = ut_scaffold_m(?alloc, ut_manifest_stack_pe(), ?names[0], ?texts[0], 1);
        if (sel ok_root_r.err) {
            session.dnit(?s);
            ret 7;
        }
        val ok_root: str = ok_root_r.ok;

        val orr: res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, ok_root);
        if (sel orr.err) { bad = 8; }
        if (sel orr.ok) {
            var m2: manifest.Manifest = orr.ok;
            if (m2.target_count != 1)                   { bad = 9; }
            or (m2.targets[0].stack_reserve != 8388608) { bad = 10; }
            or (m2.targets[0].stack_commit != 8192)     { bad = 11; }
            manifest.dnit(?m2, ?alloc);
        }
        fs.remove_all(?alloc, ok_root);
    }

    session.dnit(?s);
    ret bad;
}

test "mach.lang.driver:a_manifest_stack_reserve_reaches_the_linked_pe" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "#[symbol(\"mainCRTStartup\")]\nfun main() i32 { ret 0; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold_m(?alloc, ut_manifest_stack_pe(), ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 2;
    }
    val root: str = root_r.ok;

    var bad: i32               = 0;
    val rr:  err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.err) { bad = 3; }
    if (sel rr.ok) {
        var tsel_18542: manifest.Selection                 = ut_target_sel("win");
        val pr:         res[project.Project, outcome.Fail] = driver.build_project(?s, root, ?tsel_18542);
        if (sel pr.err) { bad = 4; }
        if (sel pr.ok) {
            var p: project.Project = pr.ok;
            if (ut_run_codegen_ok(?p) != 0) { bad = 5; }
            or {
                if (p.target.stack_reserve != 8388608) { bad = 6; }
                or (p.target.stack_commit != 8192)     { bad = 7; }
                or {
                    var outcome_r: u64 = 0;
                    var com:       u64 = 0;
                    if (!ut_pe_stack_of(?p, ?outcome_r, ?com)) { bad = 8; }
                    or (outcome_r != 8388608)                  { bad = 9; }
                    or (com != 8192)                           { bad = 10; }
                }
            }
            project.dnit_project(?p);
        }
    }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

fun ut_pe_stack_of(p: *project.Project, outcome_r: *u64, com: *u64) bool {
    val alloc: *A.Allocator = p.alloc;
    if (p.emit_len == 0) { ret false; }

    val ir: res[*of.ObjectImage, A.Error] = A.allocate[of.ObjectImage](alloc, p.emit_len::usize);
    if (sel ir.err) { ret false; }
    val images:  *of.ObjectImage = ir.ok;
    var missing: bool            = false;
    var i:       u32             = 0;
    for (i < p.emit_len) {
        val m: *project.ModuleEntry = ?p.modules[(p.topo[i])::u32];
        if (m.object_image == nil) { missing = true; }
        or                         { images[i] = @m.object_image; }
        i = i + 1;
    }

    val tf_r: res[output.Output, outcome.Fail] = output.create(alloc, "stk_pe");
    if (sel tf_r.err) {
        A.deallocate[of.ObjectImage](alloc, images, p.emit_len::usize);
        ret false;
    }
    var tf: output.Output = tf_r.ok;
    fin { output.dnit(?tf); }

    var linked: bool = false;
    if (!missing) {
        val lr: err[fail.Fail] = ut_planned_link_images(p.s, ?p.target, images,
            p.emit_len, nil::*of.DynLib, 0, output.path(?tf)::*u8, "stkprobe"::*u8,
            linker.LINK_EXE, false, of.image_options_default(of.SUBSYSTEM_CONSOLE));
        linked = sel lr.ok;
    }
    A.deallocate[of.ObjectImage](alloc, images, p.emit_len::usize);
    if (!linked) { ret false; }

    val rb: res[Vector[u8], fs.FsError] = fs.read_bytes(alloc, output.path(?tf));

    if (sel rb.err) { ret false; }
    val img: Vector[u8] = rb.ok;

    var ok: bool = false;
    if (img.len > 0x100) {
        val pe_off: usize = bin.read_u32_le(img.data, 0x3C)::usize;
        val oh:     usize = pe_off + 24;
        if (oh + 96 + 8 <= img.len) {
            @outcome_r = bin.read_u64_le(img.data, oh + 72);
            @com       = bin.read_u64_le(img.data, oh + 80);
            ok         = true;
        }
    }
    ret ok;
}

fun ut_manifest_stack_two() str {
    ret "[project]\nid = \"stk\"\nversion = \"0.1.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.small]\nisa = \"x86_64\"\nos = \"windows\"\nabi = \"win64\"\nstack_reserve = 1048576\n\n[target.big]\nisa = \"x86_64\"\nos = \"windows\"\nabi = \"win64\"\nstack_reserve = 8388608\n\n[target.lin]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[profile.debug]\nopt = 0\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n\n[artifact.stk]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/stk\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
}

test "mach.lang.driver:a_frame_larger_than_the_stack_reserve_is_refused" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "#[symbol(\"mainCRTStartup\")]\nfun main() i32 { var big: [2000000]u8; big[0] = 1; ret big[0]::i32; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold_m(?alloc, ut_manifest_stack_two(), ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 2;
    }
    val root: str = root_r.ok;

    var bad: i32               = 0;
    val rr:  err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.err) { bad = 3; }
    if (sel rr.ok) {
        if (!ut_build_names_frame_refusal(?s, root, "small") && bad == 0) { bad = 4; }
        if (ut_build_fails(?s, root, "big") && bad == 0)                  { bad = 5; }
        if (ut_build_names_frame_refusal(?s, root, "lin") && bad == 0)    { bad = 6; }
    }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

fun ut_build_names_frame_refusal(s: *session.Session, root: str, tgt: str) bool {
    val msg: str = ut_codegen_fail_msg(s, root, tgt);
    ret str_contains(msg, "stack reserve cannot hold") && str_contains(msg, "1048576");
}

fun ut_codegen_fail_msg(s: *session.Session, root: str, tgt: str) str {
    var tsel_18657: manifest.Selection                 = ut_target_sel(tgt);
    val pr:         res[project.Project, outcome.Fail] = driver.build_project(s, root, ?tsel_18657);
    if (sel pr.err) {
        ret outcome.describe(pr.err);
    }
    var p:   project.Project   = pr.ok;
    var out: str               = "";
    val se:  err[outcome.Fail] = driver.run_sema_pass(?p);
    if (sel se.err) { out = outcome.describe(se.err); }
    if (sel se.ok) {
        val le: err[outcome.Fail] = driver.run_lower_pass(?p);
        if (sel le.err) { out = outcome.describe(le.err); }
        if (sel le.ok) {
            val ce: err[outcome.Fail] = driver.run_codegen_pass(?p);
            if (sel ce.err) { out = outcome.describe(ce.err); }
        }
    }
    project.dnit_project(?p);
    ret out;
}

fun ut_build_fails(s: *session.Session, root: str, tgt: str) bool {
    ret str_len(ut_codegen_fail_msg(s, root, tgt)) != 0;
}

fun ut_w64uw_manifest() str {
    ret "[project]\nid = \"w64uw\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.win]\nisa = \"x86_64\"\nos = \"windows\"\nabi = \"win64\"\n\n[profile.debug]\nopt = 0\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n\n[artifact.w64uw]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/w64uw\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
}

fun ut_w64uw_src() str {
    ret "fun probe_small(x: i64) i64 {\n    var buf: [64]u8;\n    buf[0] = x::u8;\n    buf[63] = (x >> 8)::u8;\n    ret buf[0]::i64 + buf[63]::i64;\n}\n\nfun probe_mid(x: i64) i64 {\n    var buf: [4000]u8;\n    buf[0] = x::u8;\n    buf[3999] = (x >> 8)::u8;\n    ret buf[0]::i64 + buf[3999]::i64;\n}\n\nfun probe_big(x: i64) i64 {\n    var buf: [12000]u8;\n    buf[0] = x::u8;\n    buf[11999] = (x >> 8)::u8;\n    ret probe_small(buf[0]::i64) + buf[11999]::i64;\n}\n\n#[symbol(\"mainCRTStartup\")]\nfun start() i32 {\n    ret (probe_big(7) + probe_mid(9))::i32;\n}\n";
}

fun ut_w64uw_image(alloc: *A.Allocator, out: *Vector[u8]) bool {
    val sr: res[session.Session, fail.Fail] = session.init(alloc);
    if (sel sr.err) { ret false; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = ut_w64uw_src();
    val root_r: res[str, fail.Fail] = ut_scaffold_m(alloc, ut_w64uw_manifest(), ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret false;
    }
    val root: str = root_r.ok;

    var ok: bool              = false;
    val rr: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.ok) {
        var tsel_18705: manifest.Selection                 = ut_target_sel("win");
        val pr:         res[project.Project, outcome.Fail] = driver.build_project(?s, root, ?tsel_18705);
        if (sel pr.ok) {
            var p: project.Project = pr.ok;
            if (ut_run_codegen_ok(?p) == 0) { ok = ut_w64uw_link(?p, out); }
            project.dnit_project(?p);
        }
    }
    fs.remove_all(alloc, root);
    session.dnit(?s);
    ret ok;
}

fun ut_w64uw_link(p: *project.Project, out: *Vector[u8]) bool {
    val alloc: *A.Allocator = p.alloc;
    if (p.emit_len == 0) { ret false; }

    val ir: res[*of.ObjectImage, A.Error] = A.allocate[of.ObjectImage](alloc, p.emit_len::usize);
    if (sel ir.err) { ret false; }
    val images:  *of.ObjectImage = ir.ok;
    var missing: bool            = false;
    var i:       u32             = 0;
    for (i < p.emit_len) {
        val m: *project.ModuleEntry = ?p.modules[(p.topo[i])::u32];
        if (m.object_image == nil) { missing = true; }
        or                         { images[i] = @m.object_image; }
        i = i + 1;
    }

    val tf_r: res[output.Output, outcome.Fail] = output.create(alloc, "w64uw_pe");
    if (sel tf_r.err) {
        A.deallocate[of.ObjectImage](alloc, images, p.emit_len::usize);
        ret false;
    }
    var tf: output.Output = tf_r.ok;
    fin { output.dnit(?tf); }

    var linked: bool = false;
    if (!missing) {
        val lr: err[fail.Fail] = ut_planned_link_images(p.s, ?p.target, images,
            p.emit_len, nil::*of.DynLib, 0, output.path(?tf)::*u8, "w64uw"::*u8,
            linker.LINK_EXE, false, of.image_options_default(of.SUBSYSTEM_CONSOLE));
        linked = sel lr.ok;
    }
    A.deallocate[of.ObjectImage](alloc, images, p.emit_len::usize);
    if (!linked) { ret false; }

    val rb: res[Vector[u8], fs.FsError] = fs.read_bytes(alloc, output.path(?tf));

    if (sel rb.err) { ret false; }
    @out = rb.ok;
    ret true;
}

rec UtPeSec {
    rva:   u32;
    vsize: u32;
    raw:   u32;
}

fun ut_pe_find_sec(img: *Vector[u8], name: str, sec: *UtPeSec) bool {
    if (img.len < 0x40) { ret false; }
    val b:      *u8   = img.data;
    val pe_off: usize = ut_le32(b, 0x3C)::usize;
    val nsec:   u64   = ut_le16(b, pe_off + 4 + 2);
    val optsz:  u64   = ut_le16(b, pe_off + 4 + 16);
    var sh:     usize = pe_off + 4 + 20 + optsz::usize;
    val nlen:   usize = str_len(name);
    if (nlen > 7) { ret false; }
    val np: *u8 = name::*u8;
    var i:  u64 = 0;
    for (i < nsec) {
        if (sh + 40 > img.len) { ret false; }
        var matches: bool  = true;
        var k:       usize = 0;
        for (k < nlen) {
            if (b[sh + k] != np[k]) { matches = false; }
            k = k + 1;
        }
        if (matches && b[sh + nlen] == 0) {
            sec.vsize = ut_le32(b, sh + 8)::u32;
            sec.rva   = ut_le32(b, sh + 12)::u32;
            sec.raw   = ut_le32(b, sh + 20)::u32;
            ret true;
        }
        sh = sh + 40;
        i  = i + 1;
    }
    ret false;
}

fun ut_pe_sec_off(sec: *UtPeSec, rva: u32) i64 {
    if (rva < sec.rva) { ret -1; }
    ret sec.raw::i64 + (rva - sec.rva)::i64;
}

test "mach.lang.driver:w64_xdata_declares_every_prologue_shape" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }

    var img: Vector[u8];
    if (!ut_w64uw_image(?alloc, ?img)) { ret 2; }

    var text_sec:  UtPeSec;
    var pdata_sec: UtPeSec;
    var xdata_sec: UtPeSec;
    if (!ut_pe_find_sec(?img, ".text", ?text_sec))   { ret 3; }
    if (!ut_pe_find_sec(?img, ".pdata", ?pdata_sec)) { ret 4; }
    if (!ut_pe_find_sec(?img, ".xdata", ?xdata_sec)) { ret 5; }

    val b: *u8 = img.data;
    val n: u32 = pdata_sec.vsize / 12;
    if (n < 4) { ret 6; }

    var saw_imm8:   u32 = 0;
    var saw_imm32:  u32 = 0;
    var saw_probed: u32 = 0;

    var i: u32 = 0;
    for (i < n) {
        val row:    usize = pdata_sec.raw::usize + i::usize * 12;
        val begin:  u32   = ut_le32(b, row)::u32;
        val fin:    u32   = ut_le32(b, row + 4)::u32;
        val uw_rva: u32   = ut_le32(b, row + 8)::u32;
        if (begin == 0 || fin <= begin) { ret 7; }

        val fo_s: i64 = ut_pe_sec_off(?text_sec, begin);
        if (fo_s < 0) { ret 8; }
        val fo: usize = fo_s::usize;

        if (b[fo] != 0x55)                                               { ret 9; }
        if (b[fo + 1] != 0x48 || b[fo + 2] != 0x89 || b[fo + 3] != 0xE5) { ret 10; }
        var total:     u64 = 0;
        var alloc_end: u32 = 0;
        if (b[fo + 4] == 0x48 && b[fo + 5] == 0x83 && b[fo + 6] == 0xEC) {
            total     = b[fo + 7]::u64;
            alloc_end = 8;
            saw_imm8  = saw_imm8 + 1;
        }
        or (b[fo + 4] == 0x48 && b[fo + 5] == 0x81 && b[fo + 6] == 0xEC) {
            total     = ut_le32(b, fo + 7);
            alloc_end = 11;
            saw_imm32 = saw_imm32 + 1;
        }
        or (b[fo + 4] == 0x49 && b[fo + 5] == 0xC7 && b[fo + 6] == 0xC3) {
            total = ut_le32(b, fo + 7);
            var k: u32 = 11;
            for (k < 64 && alloc_end == 0) {
                if (b[fo + k::usize] == 0x4C && b[fo + k::usize + 1] == 0x29 && b[fo + k::usize + 2] == 0xDC) {
                    alloc_end = k + 3;
                }
                k = k + 1;
            }
            if (alloc_end == 0) { ret 1; }
            saw_probed = saw_probed + 1;
        }
        or { ret 12; }

        val xo_s: i64 = ut_pe_sec_off(?xdata_sec, uw_rva);
        if (xo_s < 0) { ret 2; }
        val xo: usize = xo_s::usize;
        if (b[xo] != 0x01) { ret 3; }
        val psz: u32 = b[xo + 1]::u32;
        val cnt: u32 = b[xo + 2]::u32;
        if (b[xo + 3] != 0)  { ret 15; }
        if (psz < alloc_end) { ret 16; }

        var push_rbp_ok: bool = false;
        var alloc_codes: u32  = 0;
        var alloc_size:  u64  = 0;
        var alloc_at:    u32  = 0;
        var j:           u32  = 0;
        for (j < cnt) {
            val slot: usize = xo + 4 + j::usize * 2;
            val eo:   u32   = b[slot]::u32;
            val op:   u8    = b[slot + 1] & 0x0F;
            val info: u8    = b[slot + 1] >> 4;
            if (eo > psz) { ret 17; }
            if (op == 0) {
                if (info == 5 && eo == 1) { push_rbp_ok = true; }
            }
            or (op == 2) {
                alloc_codes = alloc_codes + 1;
                alloc_size  = (info::u64 + 1) * 8;
                alloc_at    = eo;
            }
            or (op == 1) {
                alloc_codes = alloc_codes + 1;
                if (info == 0) {
                    alloc_size = ut_le16(b, xo + 4 + (j::usize + 1) * 2) * 8;
                    j          = j + 1;
                }
                or {
                    alloc_size = ut_le32(b, xo + 4 + (j::usize + 1) * 2);
                    j          = j + 2;
                }
                alloc_at = eo;
            }
            or (op == 4 || op == 8) { j = j + 1; }
            or (op == 5 || op == 9) { j = j + 2; }
            or (op == 3)            {}
            or                      { ret 18; }
            j = j + 1;
        }

        if (!push_rbp_ok)          { ret 19; }
        if (alloc_codes != 1)      { ret 20; }
        if (alloc_size != total)   { ret 21; }
        if (alloc_at != alloc_end) { ret 22; }

        i = i + 1;
    }

    if (saw_imm8 == 0 || saw_imm32 == 0 || saw_probed == 0) { ret 23; }

    vector.dnit[u8](?img);
    ret 0;
}

fun ut_w64realign_src() str {
    ret "fun sink(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64) i64 {\n    ret a+b+c+d+e+f+g+h;\n}\n\n#[align(64)]\nrec Wide { pad: [64]u8; }\n\n#[symbol(\"mainCRTStartup\")]\nfun start() i32 {\n    var w: Wide;\n    w.pad[0] = 1;\n    var a: i64 = 1; var b: i64 = 2; var c: i64 = 3; var d: i64 = 4;\n    var e: i64 = 5; var f: i64 = 6; var g: i64 = 7; var h: i64 = 8;\n    var s: i64 = sink(a,b,c,d,e,f,g,h) + sink(h,g,f,e,d,c,b,a);\n    var va: i64x2 = i64x2{ s, w.pad[0]::i64 };\n    var vb: i64x2 = i64x2{ 0, 0 };\n    var vr: u64x2 = va < vb;\n    ret (s + w.pad[0]::i64 + vr[0]::i64)::i32;\n}\n";
}

fun ut_w64realign_image(alloc: *A.Allocator, out: *Vector[u8]) bool {
    val sr: res[session.Session, fail.Fail] = session.init(alloc);
    if (sel sr.err) { ret false; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = ut_w64realign_src();
    val root_r: res[str, fail.Fail] = ut_scaffold_m(alloc, ut_w64uw_manifest(), ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret false;
    }
    val root: str = root_r.ok;

    var ok: bool              = false;
    val rr: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.ok) {
        var tsel_18936: manifest.Selection                 = ut_target_sel("win");
        val pr:         res[project.Project, outcome.Fail] = driver.build_project(?s, root, ?tsel_18936);
        if (sel pr.ok) {
            var p: project.Project = pr.ok;
            if (ut_run_codegen_ok(?p) == 0) { ok = ut_w64uw_link(?p, out); }
            project.dnit_project(?p);
        }
    }
    fs.remove_all(alloc, root);
    session.dnit(?s);
    ret ok;
}

test "mach.lang.driver:w64_realigned_frame_records_callee_saves" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }

    var img: Vector[u8];
    if (!ut_w64realign_image(?alloc, ?img)) { ret 2; }

    var text_sec:  UtPeSec;
    var pdata_sec: UtPeSec;
    var xdata_sec: UtPeSec;
    if (!ut_pe_find_sec(?img, ".text", ?text_sec))   { ret 3; }
    if (!ut_pe_find_sec(?img, ".pdata", ?pdata_sec)) { ret 4; }
    if (!ut_pe_find_sec(?img, ".xdata", ?xdata_sec)) { ret 5; }

    val b: *u8 = img.data;
    val n: u32 = pdata_sec.vsize / 12;
    if (n < 1) { ret 6; }

    var found_realigned:   bool = false;
    var save_nonvol_count: u32  = 0;
    var save_xmm_count:    u32  = 0;

    var i: u32 = 0;
    for (i < n) {
        val row:    usize = pdata_sec.raw::usize + i::usize * 12;
        val uw_rva: u32   = ut_le32(b, row + 8)::u32;
        val xo_s:   i64   = ut_pe_sec_off(?xdata_sec, uw_rva);
        if (xo_s < 0) { ret 7; }
        val xo: usize = xo_s::usize;
        if (b[xo] != 0x01) { ret 8; }
        val psz: u32 = b[xo + 1]::u32;
        val cnt: u32 = b[xo + 2]::u32;

        var has_set_fpreg:   bool = false;
        var local_saves:     u32  = 0;
        var local_xmm_saves: u32  = 0;
        var j:               u32  = 0;
        for (j < cnt) {
            val slot: usize = xo + 4 + j::usize * 2;
            val eo:   u32   = b[slot]::u32;
            val op:   u8    = b[slot + 1] & 0x0F;
            if (eo > psz) { ret 9; }
            if (op == 3)  { has_set_fpreg = true; }
            or (op == 4) {
                local_saves = local_saves + 1;
                j           = j + 1;
            }
            or (op == 5) {
                local_saves = local_saves + 1;
                j           = j + 2;
            }
            or (op == 8) {
                local_xmm_saves = local_xmm_saves + 1;
                j               = j + 1;
            }
            or (op == 9) {
                local_xmm_saves = local_xmm_saves + 1;
                j               = j + 2;
            }
            or (op == 1) { j = j + 2; }
            j = j + 1;
        }

        if (has_set_fpreg) {
            found_realigned   = true;
            save_nonvol_count = local_saves;
            save_xmm_count    = local_xmm_saves;
        }
        i = i + 1;
    }

    if (!found_realigned)      { ret 10; }
    if (save_nonvol_count < 2) { ret 1; }
    if (save_xmm_count < 2)    { ret 12; }

    vector.dnit[u8](?img);
    ret 0;
}

fun ut_w64xmmscratch_src() str {
    ret "#[symbol(\"mainCRTStartup\")]\nfun start() i32 {\n    var a: i64x2 = i64x2{ 1, 2 };\n    var b: i64x2 = i64x2{ 3, 4 };\n    var r: u64x2 = a < b;\n    ret r[0]::i32;\n}\n";
}

fun ut_w64xmmscratch_image(alloc: *A.Allocator, out: *Vector[u8]) bool {
    val sr: res[session.Session, fail.Fail] = session.init(alloc);
    if (sel sr.err) { ret false; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = ut_w64xmmscratch_src();
    val root_r: res[str, fail.Fail] = ut_scaffold_m(alloc, ut_w64uw_manifest(), ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret false;
    }
    val root: str = root_r.ok;

    var ok: bool              = false;
    val rr: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.ok) {
        var tsel_19035: manifest.Selection                 = ut_target_sel("win");
        val pr:         res[project.Project, outcome.Fail] = driver.build_project(?s, root, ?tsel_19035);
        if (sel pr.ok) {
            var p: project.Project = pr.ok;
            if (ut_run_codegen_ok(?p) == 0) { ok = ut_w64uw_link(?p, out); }
            project.dnit_project(?p);
        }
    }
    fs.remove_all(alloc, root);
    session.dnit(?s);
    ret ok;
}

test "mach.lang.driver:w64_vector_compare_saves_xmm_scratch" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }

    var img: Vector[u8];
    if (!ut_w64xmmscratch_image(?alloc, ?img)) { ret 2; }

    var text_sec:  UtPeSec;
    var pdata_sec: UtPeSec;
    var xdata_sec: UtPeSec;
    if (!ut_pe_find_sec(?img, ".text", ?text_sec))   { ret 3; }
    if (!ut_pe_find_sec(?img, ".pdata", ?pdata_sec)) { ret 4; }
    if (!ut_pe_find_sec(?img, ".xdata", ?xdata_sec)) { ret 5; }

    val b: *u8 = img.data;
    val n: u32 = pdata_sec.vsize / 12;
    if (n < 1) { ret 6; }

    var saw14: bool = false;
    var saw15: bool = false;

    var i: u32 = 0;
    for (i < n) {
        val row:    usize = pdata_sec.raw::usize + i::usize * 12;
        val uw_rva: u32   = ut_le32(b, row + 8)::u32;
        val xo_s:   i64   = ut_pe_sec_off(?xdata_sec, uw_rva);
        if (xo_s < 0) { ret 7; }
        val xo: usize = xo_s::usize;
        if (b[xo] != 0x01) { ret 8; }
        val cnt: u32 = b[xo + 2]::u32;

        var j: u32 = 0;
        for (j < cnt) {
            val slot: usize = xo + 4 + j::usize * 2;
            val op:   u8    = b[slot + 1] & 0x0F;
            val info: u8    = b[slot + 1] >> 4;
            if (op == 8) {
                if (info == 14) { saw14 = true; }
                or (info == 15) { saw15 = true; }
                j = j + 1;
            }
            or (op == 9) { j = j + 2; }
            or (op == 1) { j = j + 2; }
            j = j + 1;
        }
        i = i + 1;
    }

    if (!saw14 || !saw15) { ret 9; }

    vector.dnit[u8](?img);
    ret 0;
}

test "mach.lang.driver.passes.q_link:records_the_test_qualified_codegen_key" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [2]str;
    names[0] = "main.mach";
    names[1] = "a.mach";
    var texts: [2]str;
    texts[0] = ut_cc3(?alloc, "use uniontest.a.fa;\n#[symbol(\"", ut_entry_symbol(), "\")]\nfun start() i32 { ret fa(); }\n");
    texts[1] = "pub fun fa() i32 { ret 0; }\n\ntest \"a.zero\" { ret fa(); }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 2);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    val mr: res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var m:  manifest.Manifest    = mr.ok;
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    rq.goal         = request.GOAL_TESTS;
    val pr: res[bplan.BuildPlan, outcome.Fail] = bplan.plan(?alloc, ?s.interner, s.registry, ?m, rq);
    if (sel pr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var bp: bplan.BuildPlan = pr.ok;

    var bad: i32                                     = 0;
    val r1:  res[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, ?alloc, nil);
    if (sel r1.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    if (r1.ok.severity != outcome.BUILD_OK) { bad = 1; }

    val keys_r: res[Vector[query.QueryKey], fail.Fail] = query.cached_dependency_keys(?s.queries, query.Q_LINK, 0, ?alloc);
    if (sel keys_r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var keys: Vector[query.QueryKey] = keys_r.ok;
    fin { vector.dnit[query.QueryKey](?keys); }

    var codegen_deps: u32   = 0;
    var i:            usize = 0;
    for (i < keys.len) {
        val d: query.QueryKey = keys.data[i];
        if (d.kind == query.Q_CODEGEN) {
            codegen_deps = codegen_deps + 1;
            if (!passes.back_half_key_is_test(d.key)) { bad = 1; }
        }
        i = i + 1;
    }
    if (codegen_deps == 0) { bad = 1; }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.build.engine.artifact_reusable:a_tampered_test_dispatcher_is_relinked" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = ut_cc3(?alloc, "#[symbol(\"", ut_entry_symbol(), "\")]\nfun start() i32 { ret 0; }\n");
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    val mr: res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var m:  manifest.Manifest    = mr.ok;
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    val pr: res[bplan.BuildPlan, outcome.Fail] = bplan.plan(?alloc, ?s.interner, s.registry, ?m, rq);
    if (sel pr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var bp: bplan.BuildPlan = pr.ok;

    var bad: i32                                     = 0;
    val r1:  res[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, ?alloc, nil);
    if (sel r1.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    val bo1: outcome.BuildOutcome = r1.ok;
    if (bo1.severity != outcome.BUILD_OK || bo1.artifacts.len != 1) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    val exe: str = bo1.artifacts.data[0].path;

    var good:          [32]u8;
    val file_sha256_r: err[outcome.Fail] = bfingerprint.file_sha256(exe, ?good[0]);
    if (sel file_sha256_r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }

    val junk:          str             = "not an executable";
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(exe, junk::*u8, str_len(junk), 493);
    if (sel write_bytes_r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var corrupt:        [32]u8;
    val file_sha256_r2: err[outcome.Fail] = bfingerprint.file_sha256(exe, ?corrupt[0]);
    if (sel file_sha256_r2.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    if (ut_digest_eq(?good[0], ?corrupt[0])) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }

    val r2: res[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, ?alloc, nil);
    if (sel r2.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    if (r2.ok.severity != outcome.BUILD_OK) { bad = 1; }

    var after:          [32]u8;
    val file_sha256_r3: err[outcome.Fail] = bfingerprint.file_sha256(exe, ?after[0]);
    if (sel file_sha256_r3.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    if (!ut_digest_eq(?good[0], ?after[0])) { bad = 1; }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

fun ut_digest_eq(a: *u8, b: *u8) bool {
    var i: usize = 0;
    for (i < 32) {
        if (a[i] != b[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun ut_manifest_renamed_artifact() str {
    ret "[project]\nid = \"uniontest\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.linux]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[artifact.uniontest]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/renamed\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n";
}

test "mach.lang.build.engine.execute_warm:refuses_a_manifest_that_changed_after_planning" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = ut_cc3(?alloc, "#[symbol(\"", ut_entry_symbol(), "\")]\nfun start() i32 { ret 0; }\n");
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    val mr: res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var m:  manifest.Manifest    = mr.ok;
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    val pr: res[bplan.BuildPlan, outcome.Fail] = bplan.plan(?alloc, ?s.interner, s.registry, ?m, rq);
    if (sel pr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var bp: bplan.BuildPlan = pr.ok;

    val mf:            str             = ut_cc3(?alloc, root, "/", manifest.MANIFEST_FILE);
    val alt:           str             = ut_manifest_renamed_artifact();
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(mf, alt, str_len(alt), 420);
    if (sel write_bytes_r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }

    var bad: i32                                     = 0;
    val r:   res[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, ?alloc, nil);
    if (sel r.err) { bad = 1; }
    if (sel r.ok) {
        var bo: outcome.BuildOutcome = r.ok;
        if (bo.severity != outcome.BUILD_USER)                                 { bad = 1; }
        or (bo.events.len == 0)                                                { bad = 1; }
        or (!ut_outcome_contains(?bo, "changed after this build was planned")) { bad = 1; }
        outcome.outcome_dnit(?bo);
    }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

fun ut_manifest_step_target_env() str {
    ret "[project]\nid = \"tenv\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.linux]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[step.probe]\nargv = [\"sh\", \"-c\", 'test \"$MACH_TARGET_ISA\" = x86_64 && test \"$MACH_TARGET_OS\" = linux && test \"$MACH_TARGET_ABI\" = sysv64 && printf ok > seen']\nenv = { MACH_TARGET_ISA = \"spoofed\", CARRIED = \"through\" }\nin = []\nout = [\"seen\"]\nneed = []\n\n[artifact.app]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/app\"\ntargets = [\"*\"]\nlink = []\nneed = [\"step.probe\"]\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n";
}

test "mach.lang.driver:step_target_environment_replaces_a_declared_override" {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "fun main() i32 { ret 0; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold_m(?alloc, ut_manifest_step_target_env(), ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    var bad:  i32 = 0;
    var pick: manifest.Selection;
    pick.target       = "linux";
    pick.profile      = "";
    pick.artifact     = "app";
    pick.want_lib     = false;
    pick.has_artifact = true;
    val pr: res[project.Project, outcome.Fail] = driver.build_project_sel(?s, root, ?pick);
    if (sel pr.err) { bad = 1; }
    if (sel pr.ok) {
        var p: project.Project = pr.ok;
        project.dnit_project(?p);
    }

    val seen_r: res[str, A.Error] = path.resolve(?alloc, root, "seen");
    if (sel seen_r.err) { bad = 1; }
    if (sel seen_r.ok) {
        val text_r: res[str, fs.FsError] = fs.read_string(?alloc, seen_r.ok);
        if (sel text_r.err)                                  { ret 99; }
        if (!(sel text_r.ok && str_equals(text_r.ok, "ok"))) { bad = 1; }
    }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.session.register_module_identity:allocation_failure_publishes_nothing" {
    var bad:         i32  = 0;
    var saw_failure: bool = false;
    var n:           u64  = 1;
    for (n <= 400) {
        var backing: A.Allocator;
        val make_r:  err[A.Error] = page.make(?backing);
        if (sel make_r.err) { ret 1; }
        var failing: T.Testing;
        val make_r2: err[A.Error] = T.make(?failing);
        if (sel make_r2.err) { ret 1; }
        T.fail_at_ordinal(?failing, n::usize);

        val sr: res[session.Session, fail.Fail] = session.init(T.allocator_of(?failing));
        if (sel sr.err) {
            n = n + 1;
            cnt;
        }
        var s: session.Session = sr.ok;

        val r: err[fail.Fail] = session.register_module_identity(?s, 3, nil, 9, 5);
        if (sel r.err) {
            saw_failure = true;
            if (session.module_count(?s) != 0)                             { bad = 1; }
            if (session.module_fqn(?s, 3) != intern.STR_NIL)               { bad = 1; }
            if (session.module_id_for_stable(?s, 5) != session.MODULE_NIL) { bad = 1; }
        }
        if (sel r.ok) {
            if (session.module_count(?s) != 4)            { bad = 1; }
            if (session.module_fqn(?s, 3) != 9)           { bad = 1; }
            if (session.module_id_for_stable(?s, 5) != 3) { bad = 1; }
        }
        session.dnit(?s);
        if (T.tracking_exhausted(?failing)) {
            T.dnit(?failing);
            ret 1;
        }
        if (T.leaked(?failing) || T.double_free_count(?failing) != 0) {
            T.dnit(?failing);
            ret 1;
        }
        T.dnit(?failing);
        n = n + 1;
    }
    if (!saw_failure) { bad = 1; }
    ret bad;
}

test "mach.lang.session.register_module_phase:allocation_failure_publishes_nothing" {
    var bad:         i32  = 0;
    var saw_failure: bool = false;
    var n:           u64  = 1;
    for (n <= 400) {
        var backing: A.Allocator;
        val make_r:  err[A.Error] = page.make(?backing);
        if (sel make_r.err) { ret 1; }
        var failing: T.Testing;
        val make_r2: err[A.Error] = T.make(?failing);
        if (sel make_r2.err) { ret 1; }
        T.fail_at_ordinal(?failing, n::usize);

        val sr: res[session.Session, fail.Fail] = session.init(T.allocator_of(?failing));
        if (sel sr.err) {
            n = n + 1;
            cnt;
        }
        var s: session.Session = sr.ok;

        var a_marker: u64            = 0xA;
        var b_marker: u64            = 0xB;
        var c_marker: u64            = 0xC;
        val r:        err[fail.Fail] = session.register_module_phase(?s, 2,
            (?a_marker)::ptr, (?b_marker)::ptr, (?c_marker)::ptr);
        if (sel r.err) {
            saw_failure = true;
            if (session.module_sema_ptr(?s, 2) != nil)     { bad = 1; }
            if (session.module_resolve_ptr(?s, 2) != nil)  { bad = 1; }
            if (session.module_comptime_ptr(?s, 2) != nil) { bad = 1; }
        }
        if (sel r.ok) {
            if (session.module_sema_ptr(?s, 2) != (?a_marker)::ptr)     { bad = 1; }
            if (session.module_resolve_ptr(?s, 2) != (?b_marker)::ptr)  { bad = 1; }
            if (session.module_comptime_ptr(?s, 2) != (?c_marker)::ptr) { bad = 1; }
        }
        session.dnit(?s);
        if (T.tracking_exhausted(?failing)) {
            T.dnit(?failing);
            ret 1;
        }
        if (T.leaked(?failing) || T.double_free_count(?failing) != 0) {
            T.dnit(?failing);
            ret 1;
        }
        T.dnit(?failing);
        n = n + 1;
    }
    if (!saw_failure) { bad = 1; }
    ret bad;
}

fun ut_orphan_goal(target_name: str, entry_symbol: str, expected_count: usize, expected_skipped: u32) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [2]str;
    names[0] = "main.mach";
    names[1] = "gated.mach";
    var texts: [2]str;
    texts[0] = ut_cc3(?alloc, "#[symbol(\"", entry_symbol, "\")]\nfun start() i32 { ret 0; }\n\ntest \"main.runs\" { ret 0; }\n");
    texts[1] = "$if ($mach.build.os != $mach.os.windows) {\n    $error(\"uniontest.gated: requires windows target\");\n}\n\npub val HANDLE: u32 = 7;\n\ntest \"gated.never_runs\" { ret 0; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 2);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    val mr: res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var m:  manifest.Manifest    = mr.ok;
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    rq.target       = target_name;
    rq.debug        = false;
    rq.goal         = request.GOAL_TESTS;
    val pr: res[bplan.BuildPlan, outcome.Fail] = bplan.plan(?alloc, ?s.interner, s.registry, ?m, rq);
    if (sel pr.err) {
        print.eprintlnf("orphan target {} planning failed: {}", target_name, outcome.describe(pr.err));
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var bp: bplan.BuildPlan = pr.ok;

    var bad: i32                                     = 0;
    val r:   res[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, ?alloc, nil);
    if (sel r.err) {
        print.eprintlnf("orphan target {} execution failed: {}", target_name, outcome.describe(r.err));
        bad = 1;
    }
    if (sel r.ok) {
        var bo: outcome.BuildOutcome = r.ok;
        if (bo.severity != outcome.BUILD_OK) { bad = 1; }
        or (bo.tests.len != expected_count)  { bad = 1; }
        or {
            var found_main:  bool  = false;
            var found_gated: bool  = false;
            var index:       usize = 0;
            for (index < bo.tests.len) {
                val label: str = bo.tests.data[index].label::str;
                if (str_equals(label, "main.runs"))        { found_main = true; }
                or (str_equals(label, "gated.never_runs")) { found_gated = true; }
                or                                         { bad = 1; }
                index = index + 1;
            }
            if (!found_main || found_gated != (expected_skipped == 0)) { bad = 1; }
        }
        if (bo.tests_skipped != expected_skipped) { bad = 1; }
        if (bad != 0) {
            print.eprintlnf("orphan target {}: severity {}, tests {}/{}, skipped {}/{}", target_name,
                bo.severity, bo.tests.len, expected_count, bo.tests_skipped, expected_skipped);
            var ei: usize = 0;
            for (ei < bo.events.len) {
                val event: *outcome.BuildEvent = ?bo.events.data[ei];
                if (sel event.fail) {
                    val carried: opt[str] = outcome.text(event.fail);
                    if (sel carried.some) { print.eprintlnf("orphan failure: {}", carried.some); }
                    if (sel carried.none) { print.eprintln("orphan failure: reported"); }
                }
                ei = ei + 1;
            }
        }
        outcome.outcome_dnit(?bo);
    }

    if (bad != 0) {
        var di: usize = 0;
        for (di < diagnostic.len(?s.diags)) {
            print.eprintln(s.diags.items.data[di].message);
            di = di + 1;
        }
    }
    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.driver:test_goal_skips_a_target_gated_orphan_module" {
    if (ut_orphan_goal("linux", "_start", 1, 1) != 0)           { ret 1; }
    if (ut_orphan_goal("windows", "mainCRTStartup", 2, 0) != 0) { ret 2; }
    ret 0;
}

test "mach.lang.driver:test_goal_reports_a_compile_error_and_collects_no_tests" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
