                    "array length is not a comptime constant") != 0) { bad = 1; }

    ret bad;
}

fun ut_arm(src: str, want: str, other: str) i32 {
    if (ut_vec_diag(src, want) != 0)  { ret 1; }
    if (ut_vec_diag(src, other) == 0) { ret 1; }
    ret 0;
}

test "mach.lang.driver:comptime_conditions_use_exact_u8_truth" {
    var bad: i32 = 0;
    if (ut_arm("val C: u8 = 0;\nfun main() i32 { $if (C) { $error(\"TRUE\"); } $or { $error(\"FALSE\"); } ret 0; }\n", "FALSE", "TRUE") != 0) { bad = 1; }
    if (ut_arm("val C: u8 = 1;\nfun main() i32 { $if (C) { $error(\"TRUE\"); } $or { $error(\"FALSE\"); } ret 0; }\n", "TRUE", "FALSE") != 0) { bad = 2; }
    if (ut_arm("val C: u8 = 2;\nfun main() i32 { $if (C) { $error(\"TRUE\"); } $or { $error(\"FALSE\"); } ret 0; }\n", "FALSE", "TRUE") != 0) { bad = 3; }
    if (ut_single_diag("def Flag: u8;\nval C: Flag = 1;\nfun main() i32 { $if (C) { $error(\"TRUE\"); } $or { $error(\"FALSE\"); } ret 0; }\n", "TRUE") != 0) { bad = 4; }
    if (!ut_sema_rejects_with("val C: u16 = 1;\nfun main() i32 { $if (C) { ret 1; } $or { ret 0; } }\n", "condition must have type u8")) { bad = 5; }
    if (!ut_sema_rejects_with("val C: i8 = 1;\nfun main() i32 { $if (C) { ret 1; } $or { ret 0; } }\n", "condition must have type u8")) { bad = 6; }
    if (ut_single_diag("def Word: u16;\nval C: Word = 1;\nfun main() i32 { $if (C) { ret 1; } $or { ret 0; } }\n", "condition must have type u8") != 0) { bad = 7; }
    if (!ut_sema_rejects_with("fun main() i32 { $if (1) { ret 1; } $or { ret 0; } }\n", "condition must have type u8")) { bad = 8; }
    if (!ut_sema_rejects_with("fun none() {}\nfun main() i32 { $if (none()) { ret 1; } $or { ret 0; } }\n", "condition must have type u8")) { bad = 9; }
    if (ut_vec_diag("$if (!0) { use uniontest.missing; }\nfun main() i32 { ret 0; }\n", "unary ! requires a u8 operand") != 0) { bad = 10; }
    if (ut_arm("$if (!0) { #[embed(\"missing.bin\")] val A: [_]u8; }\nfun main() i32 { ret 0; }\n", "unary ! requires a u8 operand", "cannot read") != 0) { bad = 11; }
    if (ut_vec_diag("val C: u8 = 1;\n$if (C && 1) { use uniontest.missing; }\nfun main() i32 { ret 0; }\n", "logical operator requires u8 operands") != 0) { bad = 12; }
    val sc_import: str = "val C: u8 = 0;\n$if (C || 1) { use uniontest.missing; }\nfun main() i32 { ret 0; }\n";
    if (ut_vec_diag(sc_import, "logical operator requires u8 operands") != 0) { ret 131; }
    if (ut_vec_diag(sc_import, "no project or dep matches") == 0) { ret 132; }
    if (ut_arm("val C: u8 = 0;\n$if (C && 1) { use uniontest.missing; }\nfun main() i32 { ret 0; }\n", "logical operator requires u8 operands", "no project or dep matches") != 0) { bad = 14; }
    val sc_embed: str = "val C: u8 = 1;\n$if (C || 1) { #[embed(\"missing.bin\")] val A: [_]u8; }\nfun main() i32 { ret 0; }\n";
    if (ut_vec_diag(sc_embed, "logical operator requires u8 operands") != 0) { ret 151; }
    if (ut_vec_diag(sc_embed, "cannot read") == 0) { ret 152; }
    if (ut_arm("val C: u8 = 0;\n$if ((C && 1) || C) { #[library(\"missing\")] ext fun probe(); }\nfun main() i32 { ret 0; }\n", "logical operator requires u8 operands", "cannot read") != 0) { ret 16; }
    if (ut_single_ok("val C: u8 = 0;\nval Z: u8 = 0;\n$if (C && (1 / Z)) { use uniontest.missing; }\nfun main() i32 { ret 0; }\n") != 0) { bad = 21; }
    if (ut_single_ok("val C: u8 = 1;\nval Z: u8 = 0;\n$if (C || (1 / Z)) { } $or { use uniontest.missing; }\nfun main() i32 { ret 0; }\n") != 0) { bad = 22; }
    ret bad;
}

test "mach.lang.driver:comptime_alias_gate_resolution" {
    if (ut_single_ok("def Flag: u8;\nval C: Flag = 1;\n$if (C) { fun selected() i32 { ret 7; } }\nfun main() i32 { ret selected(); }\n") != 0) { ret 1; }
    if (ut_single_ok("def Flag: u8;\nval C: Flag = 2;\n$if (C) { use uniontest.missing; }\nfun main() i32 { ret 0; }\n") != 0) { ret 2; }
    if (ut_single_diag("def Word: u16;\nval C: Word = 1;\n$if (C) { use uniontest.missing; }\nfun main() i32 { ret 0; }\n", "condition must have type u8") != 0) { ret 3; }
    if (ut_single_diag("def Word: u16;\nval C: Word = 2;\n$if (C) { } $or { use uniontest.missing; }\nfun main() i32 { ret 0; }\n", "condition must have type u8") != 0) { ret 4; }
    if (ut_single_ok("def Flag: u8;\nval OUTER: Flag = 1;\n$if (OUTER) { def Inner: u8; val INNER: Inner = 1; $if (INNER) { fun selected() i32 { ret 9; } } }\nfun main() i32 { ret selected(); }\n") != 0) { ret 5; }
    if (ut_single_ok2("use uniontest.lib;\n$if (lib.YES) { fun selected() i32 { ret 1; } }\nfun main() i32 { ret selected(); }\n", "pub def Flag: u8;\npub val YES: Flag = 1;\n") != 0) { ret 6; }
    if (ut_single_diag2("use uniontest.lib;\n$if (lib.BAD) { use uniontest.missing; }\nfun main() i32 { ret 0; }\n", "pub def Word: u16;\npub val BAD: Word = 1;\n", "condition must have type u8") != 0) { ret 7; }
    if (ut_single_ok2("use uniontest.lib.true;\n$if (true) { fun selected() i32 { ret 2; } }\nfun main() i32 { ret selected(); }\n", "pub def bool: u8;\npub val true: bool = 1;\n") != 0) { ret 8; }
    if (ut_single_ok2("use uniontest.lib.false;\n$if (false) { use uniontest.missing; }\nfun main() i32 { ret 0; }\n", "pub def bool: u8;\npub val false: bool = 0;\n") != 0) { ret 9; }
    if (ut_single_ok2("def Flag: u8;\nval C: Flag = 1;\n$if (C) { use uniontest.lib; }\nfun main() i32 { ret lib.selected(); }\n", "pub fun selected() i32 { ret 17; }\n") != 0) { ret 10; }
    var names: [3]str;
    names[0] = "main.mach";
    names[1] = "mid.mach";
    names[2] = "base.mach";
    var texts: [3]str;
    texts[0] = "use uniontest.mid;\n$if (mid.ENABLED) { fun selected() i32 { ret 19; } }\nfun main() i32 { ret selected(); }\n";
    texts[1] = "use uniontest.base;\n$if (base.ENABLE) { pub def Flag: u8; pub val ENABLED: Flag = 1; }\n";
    texts[2] = "pub def Flag: u8;\npub val ENABLE: Flag = 1;\n";
    if (ut_single_result_n(?names[0], ?texts[0], 3, "", false) != 0) { ret 1; }
    if (ut_single_diag("def Word: u16;\nval C: Word = 1;\n$if (!C) { use uniontest.missing; }\nfun main() i32 { ret 0; }\n", "unary ! requires a u8 operand") != 0) { ret 12; }
    if (ut_single_diag("def Word: u16;\nval C: Word = 1;\n$if (C && C) { use uniontest.missing; }\nfun main() i32 { ret 0; }\n", "logical operator requires u8 operands") != 0) { ret 2; }
    if (ut_single_diag("def Word: u16;\nval C: Word = 1;\n$if (C || C) { use uniontest.missing; }\nfun main() i32 { ret 0; }\n", "logical operator requires u8 operands") != 0) { ret 3; }
    ret 0;
}

fun ut_union_gate_result_n(names: *str, texts: *str, count: u32, want_diag: str, forbid_diag: str) i32 {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    val root_r: R.Result[str, str] = ut_scaffold(?alloc, names, texts, count);
    if (R.is_err[str, str](root_r)) { session.dnit(?s); ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);
    val rr: R.Result[R.Void, str] = driver.setup_registry(?s.registry);
    if (R.is_err[R.Void, str](rr)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    val pr: R.Result[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
    fs.remove_all(?alloc, root);
    if (R.is_err[project.Project, outcome.Fail](pr)) { session.dnit(?s); ret 1; }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);
    var bad: i32 = 0;
    if (str_len(want_diag) == 0 && ut_count_errors(?s.diags) != 0) { bad = 2; }
    if (str_len(want_diag) > 0 && !ut_diag_has(?s.diags, want_diag)) { bad = 3; }
    if (str_len(forbid_diag) > 0 && ut_diag_has(?s.diags, forbid_diag)) { bad = 4; }
    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

fun ut_union_gate_result(src_text: str, want_diag: str, forbid_diag: str) i32 {
    var names: [1]str; names[0] = "main.mach";
    var texts: [1]str; texts[0] = src_text;
    ret ut_union_gate_result_n(?names[0], ?texts[0], 1, want_diag, forbid_diag);
}

test "mach.lang.driver:union_alias_gates_are_typed_per_target_tuple" {
    val uniform: str = "def Flag: u8;\nval C: Flag = 1;\n$if (C) { fun selected() i32 { ret 1; } } $or { use uniontest.missing; }\nfun main() i32 { ret selected(); }\n";
    val selected_u8: str = "$if ($mach.build.os == $mach.os.linux) { def Flag: u8; } $or { def Flag: u8; }\nval C: Flag = 1;\n$if (C) { fun selected() i32 { ret 1; } } $or { use uniontest.missing; }\nfun main() i32 { ret selected(); }\n";
    val true_import: str = "$if ($mach.build.os == $mach.os.linux) { def Flag: u8; } $or { def Flag: u16; }\nval C: Flag = 1;\n$if (C) { } $or { use uniontest.missing; }\nfun main() i32 { ret 0; }\n";
    val false_embed: str = "$if ($mach.build.os == $mach.os.linux) { def Flag: u8; } $or { def Flag: u16; }\nval C: Flag = 0;\n$if (C) { #[embed(\"missing.bin\")] val DATA: [_]u8; }\nfun main() i32 { ret 0; }\n";
    val false_library: str = "$if ($mach.build.os == $mach.os.linux) { def Flag: u8; } $or { def Flag: u16; }\nval C: Flag = 0;\n$if (C) { #[library(\"missing\")] ext fun probe(); }\nfun main() i32 { ret 0; }\n";
    val nested: str = "$if ($mach.build.os == $mach.os.linux) { def Flag: u8; } $or { def Flag: u16; }\nval C: Flag = 1;\n$if ($mach.build.os == $mach.os.windows) { $if (C) { use uniontest.missing; } }\nfun main() i32 { ret 0; }\n";
    val permanent_error: str = "def Flag: u8;\nval C: Flag = 1;\n$if (C) { fun selected() i32 { ret 1; } }\nfun main() i32 { ret selected() + no_such(); }\n";
    val u0: i32 = ut_union_gate_result(uniform, "", ""); if (u0 != 0) { ret 10 + u0; }
    val u1: i32 = ut_union_gate_result(selected_u8, "", ""); if (u1 != 0) { ret 20 + u1; }
    val u2: i32 = ut_union_gate_result(true_import, "condition must have type u8", "no project or dep matches"); if (u2 != 0) { ret 30 + u2; }
    val u3: i32 = ut_union_gate_result(false_embed, "condition must have type u8", "cannot read"); if (u3 != 0) { ret 40 + u3; }
    val u4: i32 = ut_union_gate_result(false_library, "condition must have type u8", "cannot read"); if (u4 != 0) { ret 50 + u4; }
    val u5: i32 = ut_union_gate_result(nested, "condition must have type u8", "no project or dep matches"); if (u5 != 0) { ret 60 + u5; }
    val u6: i32 = ut_union_gate_result(permanent_error, "unresolved identifier `no_such`", ""); if (u6 != 0) { ret 70 + u6; }
    ret 0;
}

test "mach.lang.driver:unresolved_union_gate_preserves_independent_diagnostics" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    var names: [1]str; names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "fun condition() u8 { ret 1; }\n$if (condition()) { fun selected() i32 { ret 1; } }\nfun main() i32 { ret no_such(); }\n";
    val root_r: R.Result[str, str] = ut_scaffold(?alloc, ?names[0], ?texts[0], 1);
    if (R.is_err[str, str](root_r)) { session.dnit(?s); ret 2; }
    val root: str = R.unwrap_ok[str, str](root_r);
    if (R.is_err[R.Void, str](driver.setup_registry(?s.registry))) {
        fs.remove_all(?alloc, root); session.dnit(?s); ret 3;
    }
    val pr: R.Result[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
    fs.remove_all(?alloc, root);
    var bad: i32 = 0;
    if (R.is_err[project.Project, outcome.Fail](pr)) {
        bad = 4;
    }
    or {
        var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);
        if (!ut_diag_has(?p.s.diags, "function calls are not comptime-evaluable")) { bad = 5; }
        if (!ut_diag_has(?p.s.diags, "unresolved identifier `no_such`")) { bad = 6; }
        if (diagnostic.len(?p.s.diags) != 2) { bad = 7; }
        project.dnit_project(?p);
    }
    session.dnit(?s);
    ret bad;
}

test "mach.lang.driver:union_gate_fixpoint_gives_up_despite_const_import_progress" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    var names: [2]str;
    names[0] = "main.mach"; names[1] = "dep.mach";
    var texts: [2]str;
    texts[0] = "use uniontest.dep.K;\npub val UNSTUCK: u8 = K;\npub val A: u8 = totally_undefined;\n$if (A) { fun helper() i32 { ret 1; } }\nfun main() i32 { ret 0; }\n";
    texts[1] = "pub val K: u8 = 1;\n";
    val root_r: R.Result[str, str] = ut_scaffold(?alloc, ?names[0], ?texts[0], 2);
    if (R.is_err[str, str](root_r)) { session.dnit(?s); ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);
    if (R.is_err[R.Void, str](driver.setup_registry(?s.registry))) {
        fs.remove_all(?alloc, root); session.dnit(?s); ret 1;
    }
    val pr: R.Result[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
    fs.remove_all(?alloc, root);
    var bad: i32 = 0;
    if (R.is_ok[project.Project, outcome.Fail](pr)) {
        var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);
        project.dnit_project(?p);
        bad = 1;
    }
    or {
        val f: outcome.Fail = R.unwrap_err[project.Project, outcome.Fail](pr);
        if (f.kind != outcome.FAIL_REPORTED || f.message != nil) { bad = 1; }
        if (diagnostic.error_count(?s.diags) == 0) { bad = 2; }
    }
    session.dnit(?s);
    ret bad;
}

test "mach.lang.driver:union_tuple_dependent_dependency_const_fails_closed" {
