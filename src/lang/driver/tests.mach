fun ut_scaffold(alloc: *A.Allocator, names: *str, texts: *str, n: u32) R.Result[str, str] {
    ret ut_scaffold_m(alloc, ut_manifest(), names, texts, n);
}

fun ut_target_sel(target_name: str) manifest.Selection {
    var sel: manifest.Selection;
    sel.target       = target_name;
    sel.profile      = "";
    sel.artifact     = "";
    sel.want_lib     = false;
    sel.has_artifact = false;
    sel.legacy_default = false;
    ret sel;
}

fun ut_scaffold_m(alloc: *A.Allocator, manifest_text: str, names: *str, texts: *str, n: u32) R.Result[str, str] {
    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(alloc, "mach_union_test");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret R.err[str, str](R.unwrap_err[fs.TempFile, str](tf_r)); }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);
    val dup_r: R.Result[str, str] = str_dup(alloc, fs.temp_path(?tf));
    fs.temp_close_and_remove(?tf);
    if (R.is_err[str, str](dup_r)) { ret dup_r; }
    val root: str = R.unwrap_ok[str, str](dup_r);

    val d1: O.Option[str] = fs.create_dir_all(alloc, root, 493);
    if (O.is_some[str](d1)) { ret R.err[str, str](O.unwrap[str](d1)); }
    val src_dir: str = ut_cc3(alloc, root, "/", "src");
    val d2: O.Option[str] = fs.create_dir_all(alloc, src_dir, 493);
    if (O.is_some[str](d2)) { ret R.err[str, str](O.unwrap[str](d2)); }

    val mf: str = ut_cc3(alloc, root, "/", manifest.MANIFEST_FILE);
    val w0: O.Option[str] = fs.write_bytes(mf, manifest_text, str_len(manifest_text), 420);
    if (O.is_some[str](w0)) { ret R.err[str, str](O.unwrap[str](w0)); }

    var i: u32 = 0;
    for (i < n) {
        val fp: str = ut_cc3(alloc, src_dir, "/", names[i]);
        val w: O.Option[str] = fs.write_bytes(fp, texts[i], str_len(texts[i]), 420);
        if (O.is_some[str](w)) { ret R.err[str, str](O.unwrap[str](w)); }
        i = i + 1;
    }
    ret R.ok[str, str](root);
}

fun ut_str_contains(hay: str, needle: str) bool {
    val hn: usize = str_len(hay);
    val nn: usize = str_len(needle);
    if (nn == 0) { ret true; }
    if (nn > hn) { ret false; }
    var i: usize = 0;
    for (i + nn <= hn) {
        var k: usize = 0;
        for (k < nn && hay[i + k] == needle[k]) { k = k + 1; }
        if (k == nn) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun ut_write_node(alloc: *A.Allocator, dir: str, manifest_text: str, src_name: str, src_text: str) O.Option[str] {
    val d1: O.Option[str] = fs.create_dir_all(alloc, dir, 493);
    if (O.is_some[str](d1)) { ret d1; }
    val src_dir: str = ut_cc3(alloc, dir, "/", "src");
    val d2: O.Option[str] = fs.create_dir_all(alloc, src_dir, 493);
    if (O.is_some[str](d2)) { ret d2; }
    val mf: str = ut_cc3(alloc, dir, "/", manifest.MANIFEST_FILE);
    val w0: O.Option[str] = fs.write_bytes(mf, manifest_text, str_len(manifest_text), 420);
    if (O.is_some[str](w0)) { ret w0; }
    val sf: str = ut_cc3(alloc, src_dir, "/", src_name);
    ret fs.write_bytes(sf, src_text, str_len(src_text), 420);
}

fun ut_git(alloc: *A.Allocator, args: *str, count: usize) bool {
    val pr: R.Result[str, str] = exec.resolve(alloc, "git");
    if (R.is_err[str, str](pr)) { ret false; }
    val program: str = R.unwrap_ok[str, str](pr);
    val ar: R.Result[**u8, str] = A.allocate[*u8](alloc, count + 2);
    if (R.is_err[**u8, str](ar)) { str_free(alloc, program); ret false; }
    val argv: **u8 = R.unwrap_ok[**u8, str](ar);
    argv[0] = program::*u8;
    var i: usize = 0;
    for (i < count) { argv[i + 1] = args[i]::*u8; i = i + 1; }
    argv[count + 1] = nil;
    val rr: R.Result[exec.ExitStatus, str] = exec.run(program, argv, env.environ());
    A.deallocate[*u8](alloc, argv, count + 2);
    str_free(alloc, program);
    if (R.is_err[exec.ExitStatus, str](rr)) { ret false; }
    val status: exec.ExitStatus = R.unwrap_ok[exec.ExitStatus, str](rr);
    ret exec.exited(status) && exec.code(status) == 0;
}

fun ut_git_repo(alloc: *A.Allocator, dir: str, origin: str) bool {
    var init: [3]str;
    init[0] = "init"; init[1] = "-q"; init[2] = dir;
    if (!ut_git(alloc, ?init[0], 3)) { ret false; }
    var name: [5]str;
    name[0] = "-C"; name[1] = dir; name[2] = "config"; name[3] = "user.name"; name[4] = "mach-test";
    if (!ut_git(alloc, ?name[0], 5)) { ret false; }
    var email: [5]str;
    email[0] = "-C"; email[1] = dir; email[2] = "config"; email[3] = "user.email"; email[4] = "mach-test@example.invalid";
    if (!ut_git(alloc, ?email[0], 5)) { ret false; }
    var remote: [6]str;
    remote[0] = "-C"; remote[1] = dir; remote[2] = "remote"; remote[3] = "add"; remote[4] = "origin"; remote[5] = origin;
    if (!ut_git(alloc, ?remote[0], 6)) { ret false; }
    var add: [4]str;
    add[0] = "-C"; add[1] = dir; add[2] = "add"; add[3] = "-A";
    if (!ut_git(alloc, ?add[0], 4)) { ret false; }
    var commit: [5]str;
    commit[0] = "-C"; commit[1] = dir; commit[2] = "commit"; commit[3] = "-qm"; commit[4] = "initial";
    if (!ut_git(alloc, ?commit[0], 5)) { ret false; }
    var track: [6]str;
    track[0] = "-C"; track[1] = dir; track[2] = "update-ref"; track[3] = "refs/remotes/origin/main"; track[4] = "HEAD"; track[5] = "";
    ret ut_git(alloc, ?track[0], 5);
}

fun ut_git_commit_all(alloc: *A.Allocator, dir: str, message: str) bool {
    var add: [4]str;
    add[0] = "-C"; add[1] = dir; add[2] = "add"; add[3] = "-A";
    if (!ut_git(alloc, ?add[0], 4)) { ret false; }
    var commit: [5]str;
    commit[0] = "-C"; commit[1] = dir; commit[2] = "commit"; commit[3] = "-qm"; commit[4] = message;
    ret ut_git(alloc, ?commit[0], 5);
}

fun ut_gitmodules(alloc: *A.Allocator, alias: str, source: str) str {
    val head: str = ut_cc3(alloc, "[submodule \"dep/", alias, "\"]\n\tpath = dep/");
    val path: str = ut_cc3(alloc, head, alias, "\n\turl = ");
    ret ut_cc3(alloc, path, source, "\n");
}

fun ut_write_gitmodules(alloc: *A.Allocator, root: str, alias: str, source: str) bool {
    val path: str = ut_cc3(alloc, root, "/", ".gitmodules");
    val text: str = ut_gitmodules(alloc, alias, source);
    ret O.is_none[str](fs.write_bytes(path, text, str_len(text), 420));
}
fun ut_write_gitmodules2(alloc: *A.Allocator, root: str, a1: str, s1: str, a2: str, s2: str) bool {
    val path: str = ut_cc3(alloc, root, "/", ".gitmodules");
    val text: str = ut_cc3(alloc, ut_gitmodules(alloc, a1, s1), ut_gitmodules(alloc, a2, s2), "");
    ret O.is_none[str](fs.write_bytes(path, text, str_len(text), 420));
}

fun ut_git_ref(alloc: *A.Allocator, root: str, rel: str) R.Result[str, str] {
    val path: str = ut_cc3(alloc, root, "/.git/", rel);
    val raw_r: R.Result[str, str] = fs.read_string(alloc, path);
    if (R.is_err[str, str](raw_r)) { ret raw_r; }
    val raw: str = R.unwrap_ok[str, str](raw_r);
    var n: usize = str_len(raw);
    for (n > 0 && (raw[n - 1] == 10 || raw[n - 1] == 13)) { n = n - 1; }
    val copy_r: R.Result[str, str] = str_copy_slice(alloc, raw, 0, n);
    str_free(alloc, raw);
    ret copy_r;
}

fun ut_lib_manifest(alloc: *A.Allocator, id: str) str {
    ret ut_cc3(alloc, "[project]\nid = \"", id,
        "\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[artifact.lib]\nkind = \"static\"\nentry = \"lib.mach\"\nout = \"lib/l\"\ntargets = [\"*\"]\nlink = []\nneed = []\n");
}

fun ut_dep_root_one(alloc: *A.Allocator, alias: str, path: str) str {
    val head: str = "[project]\nid = \"app\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.linux]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[profile.debug]\nopt = 0\ndebug = false\nsimd = \"scalarize\"\n\n[artifact.app]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/app\"\ntargets = [\"*\"]\nlink = []\nneed = []\n\n[dep.";
    val mid: str = ut_cc3(alloc, head, alias, "]\npath = \"");
    ret ut_cc3(alloc, mid, path, "\"\n");
}

fun ut_dep_root_git_ref(alloc: *A.Allocator, alias: str, source: str, ref: str) str {
    val head: str = "[project]\nid = \"app\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.linux]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[profile.debug]\nopt = 0\ndebug = false\nsimd = \"scalarize\"\n\n[artifact.app]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/app\"\ntargets = [\"*\"]\nlink = []\nneed = []\n\n[dep.";
    val mid: str = ut_cc3(alloc, head, alias, "]\ngit = \"");
    val with_source: str = ut_cc3(alloc, mid, source, "\"\nref = \"");
    ret ut_cc3(alloc, with_source, ref, "\"\n");
}

fun ut_dep_root_git(alloc: *A.Allocator, alias: str, source: str) str {
    ret ut_dep_root_git_ref(alloc, alias, source, "branch/main");
}

fun ut_dep_root_two(alloc: *A.Allocator, alias1: str, path1: str, alias2: str, path2: str) str {
    val first: str = ut_dep_root_one(alloc, alias1, path1);
    val mid: str = ut_cc3(alloc, first, "\n[dep.", alias2);
    val tail: str = ut_cc3(alloc, mid, "]\npath = \"", path2);
    ret ut_cc3(alloc, tail, "\"\n", "");
}

fun ut_dep_lib_with_export(alloc: *A.Allocator, id: str) str {
    ret ut_cc3(alloc, "[project]\nid = \"", id,
        "\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[link.mylink]\nsource = \"local\"\npath = \"{project.out}/mylink.o\"\nos = [\"*\"]\nisa = [\"*\"]\nabi = [\"*\"]\nexport = true\n\n[artifact.lib]\nkind = \"static\"\nentry = \"lib.mach\"\nout = \"lib/l\"\ntargets = [\"*\"]\nlink = []\nneed = []\n");
}

fun ut_dep_build_ok(s: *session.Session, root: str) bool {
    val pr: R.Result[project.Project, outcome.Fail] = driver.build_project_union(s, root);
    if (R.is_err[project.Project, outcome.Fail](pr)) { ret false; }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);
    project.dnit_project(?p);
    ret true;
}

fun ut_dep_build_fails(s: *session.Session, root: str, needle: str) bool {
    val pr: R.Result[project.Project, outcome.Fail] = driver.build_project_union(s, root);
    if (R.is_ok[project.Project, outcome.Fail](pr)) {
        var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);
        project.dnit_project(?p);
        ret false;
    }
    ret ut_str_contains(R.unwrap_err[project.Project, outcome.Fail](pr).message, needle);
}

rec DepsScratchProbe {
    backing:    A.Allocator;
    live:       i64;
    live_count: i64;
    calls:      u32;
    fail_at:    u32;
}

fun deps_scratch_probe_allocate(ctx: ptr, size: usize, align: usize) O.Option[ptr] {
    val p: *DepsScratchProbe = ctx::*DepsScratchProbe;
    p.calls = p.calls + 1;
    if (p.fail_at != 0 && p.calls == p.fail_at) { ret O.none[ptr](); }
    val r: O.Option[ptr] = p.backing.fn_allocate(p.backing.ctx, size, align);
    if (O.is_some[ptr](r)) {
        p.live = p.live + size::i64;
        p.live_count = p.live_count + 1;
        memory.raw_fill(O.unwrap[ptr](r), 0xAA, size);
    }
    ret r;
}

fun deps_scratch_probe_reallocate(ctx: ptr, item: ptr, old_size: usize, new_size: usize, align: usize) O.Option[ptr] {
    val p: *DepsScratchProbe = ctx::*DepsScratchProbe;
    p.calls = p.calls + 1;
    if (p.fail_at != 0 && p.calls == p.fail_at) { ret O.none[ptr](); }
    val r: O.Option[ptr] = p.backing.fn_reallocate(p.backing.ctx, item, old_size, new_size, align);
    if (O.is_some[ptr](r)) {
        p.live = p.live - old_size::i64 + new_size::i64;
        if (new_size > old_size) {
            val grown: ptr = O.unwrap[ptr](r);
            memory.raw_fill((grown::usize + old_size)::ptr, 0xAA, new_size - old_size);
        }
    }
    ret r;
}

fun deps_scratch_probe_deallocate(ctx: ptr, item: ptr, size: usize, align: usize) i64 {
    val p: *DepsScratchProbe = ctx::*DepsScratchProbe;
    p.live = p.live - size::i64;
    p.live_count = p.live_count - 1;
    ret p.backing.fn_deallocate(p.backing.ctx, item, size, align);
}

fun deps_scratch_probe_make(p: *DepsScratchProbe, alloc: *A.Allocator, fail_at: u32) bool {
    if (O.is_some[str](page.make(?p.backing))) { ret false; }
    p.live = 0;
    p.live_count = 0;
    p.calls = 0;
    p.fail_at = fail_at;
    val probe: *DepsScratchProbe = p;
    alloc.ctx = probe::ptr;
    alloc.fn_allocate = deps_scratch_probe_allocate;
    alloc.fn_reallocate = deps_scratch_probe_reallocate;
    alloc.fn_deallocate = deps_scratch_probe_deallocate;
    ret true;
}

fun ut_build(s: *session.Session, alloc: *A.Allocator, names: *str, texts: *str, n: u32) R.Result[project.Project, outcome.Fail] {
    val root_r: R.Result[str, str] = ut_scaffold(alloc, names, texts, n);
    if (R.is_err[str, str](root_r)) { ret R.err[project.Project, outcome.Fail](outcome.user(R.unwrap_err[str, str](root_r))); }
    val root: str = R.unwrap_ok[str, str](root_r);
    val rr: R.Result[R.Void, str] = driver.setup_registry(?s.registry);
    if (R.is_err[R.Void, str](rr)) { fs.remove_all(alloc, root); ret R.err[project.Project, outcome.Fail](outcome.user(R.unwrap_err[R.Void, str](rr))); }
    val pr: R.Result[project.Project, outcome.Fail] = driver.build_project_union(s, root);
    fs.remove_all(alloc, root);
    ret pr;
}

fun ut_build_multi(s: *session.Session, alloc: *A.Allocator, names: *str, texts: *str, n: u32) R.Result[project.Project, outcome.Fail] {
    val root_r: R.Result[str, str] = ut_scaffold_m(alloc, ut_manifest_multi(), names, texts, n);
    if (R.is_err[str, str](root_r)) { ret R.err[project.Project, outcome.Fail](outcome.user(R.unwrap_err[str, str](root_r))); }
    val root: str = R.unwrap_ok[str, str](root_r);
    val rr: R.Result[R.Void, str] = driver.setup_registry(?s.registry);
    if (R.is_err[R.Void, str](rr)) { fs.remove_all(alloc, root); ret R.err[project.Project, outcome.Fail](outcome.user(R.unwrap_err[R.Void, str](rr))); }
    val pr: R.Result[project.Project, outcome.Fail] = driver.build_project_union(s, root);
    fs.remove_all(alloc, root);
    ret pr;
}

fun ut_build_test(s: *session.Session, alloc: *A.Allocator, names: *str, texts: *str, n: u32) R.Result[project.Project, outcome.Fail] {
    val root_r: R.Result[str, str] = ut_scaffold(alloc, names, texts, n);
    if (R.is_err[str, str](root_r)) { ret R.err[project.Project, outcome.Fail](outcome.user(R.unwrap_err[str, str](root_r))); }
    val root: str = R.unwrap_ok[str, str](root_r);
    val rr: R.Result[R.Void, str] = driver.setup_registry(?s.registry);
    if (R.is_err[R.Void, str](rr)) { fs.remove_all(alloc, root); ret R.err[project.Project, outcome.Fail](outcome.user(R.unwrap_err[R.Void, str](rr))); }
    var sel: manifest.Selection;
    sel.target       = "";
    sel.profile      = "";
    sel.artifact     = "";
    sel.want_lib     = false;
    sel.has_artifact = false;
    val pr: R.Result[project.Project, outcome.Fail] = driver.build_project_test(s, root, ?sel);
    fs.remove_all(alloc, root);
    ret pr;
}

fun ut_gated(p: *project.Project, s: *session.Session, fqn: str) bool {
    val mid: session.ModuleId = ut_mid(p, s, fqn);
    if (mid == session.MODULE_NIL) { ret false; }
    ret (?p.modules[mid::u32]).target_gated;
}

fun ut_in_topo(p: *project.Project, s: *session.Session, fqn: str) bool {
    val mid: session.ModuleId = ut_mid(p, s, fqn);
    if (mid == session.MODULE_NIL) { ret false; }
    var i: u32 = 0;
    for (i < p.topo_len) {
        if (p.topo[i] == mid) { ret true; }
        i = i + 1;
    }
    ret false;
}

test "mach.lang.driver:wildcard_match" {
    var bad: i32 = 0;
    if (!dcfg.wildcard_match("*.c", "mad.c"))          { bad = 1; }
    if (!dcfg.wildcard_match("*.c", ".c"))             { bad = 1; }
    if (!dcfg.wildcard_match("mini*.h", "miniaudio.h")) { bad = 1; }
    if (!dcfg.wildcard_match("a*b*c", "axxbyyc"))      { bad = 1; }
    if (!dcfg.wildcard_match("*", "anything"))         { bad = 1; }
    if (!dcfg.wildcard_match("exact.c", "exact.c"))    { bad = 1; }
    if (dcfg.wildcard_match("*.c", "mad.h"))           { bad = 1; }
    if (dcfg.wildcard_match("*.c", "mad.cpp"))         { bad = 1; }
    if (dcfg.wildcard_match("mini*.h", "audio.h"))     { bad = 1; }
    if (dcfg.wildcard_match("exact.c", "exact.cc"))    { bad = 1; }
    ret bad;
}

