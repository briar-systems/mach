    n1[0] = "main.mach";
    var t1: [1]str;
    t1[0] = "fun pick[T](seed: T, va: ...) u32 { var out: T = seed; var r: u32 = 0; $each a in va { $if ($type_of(out) == u32) { r = r + 4001; } $or { r = r + 4002; } } ret r; }\nfun main() i32 { var p: u32 = 5; var one: u32 = 1; pick[u32](p, one); ret 0; }\n";
    val p1: res[project.Project, outcome.Fail] = ut_lower_n(?s, ?alloc, ?n1[0], ?t1[0], 1);
    if (sel p1.err) { bad = 1; }
    if (sel p1.ok) {
        var pp: project.Project = p1.ok;
        val m:  *ir.Module      = ut_ir_of(?pp, ?s, "uniontest.main");
        if (ut_const_uses(m, 4001) != 1) { bad = 1; }
        if (ut_const_uses(m, 4002) != 0) { bad = 1; }
        project.dnit_project(?pp);
    }

    var n2: [1]str;
    n2[0] = "main.mach";
    var t2: [1]str;
    t2[0] = "fun pick[T](seed: T, va: ...) u32 { var out: T = seed; var r: u32 = 0; $if ($type_of(out) == u32) { r = r + 4001; } $or { r = r + 4002; } $each a in va { r = r + a; } ret r; }\nfun main() i32 { var p: u32 = 5; var one: u32 = 1; pick[u32](p, one); ret 0; }\n";
    val p2: res[project.Project, outcome.Fail] = ut_lower_n(?s, ?alloc, ?n2[0], ?t2[0], 1);
    if (sel p2.err) { bad = 1; }
    if (sel p2.ok) {
        var pp: project.Project = p2.ok;
        val m:  *ir.Module      = ut_ir_of(?pp, ?s, "uniontest.main");
        if (ut_const_uses(m, 4001) != 1) { bad = 1; }
        if (ut_const_uses(m, 4002) != 0) { bad = 1; }
        project.dnit_project(?pp);
    }

    var n3: [1]str;
    n3[0] = "main.mach";
    var t3: [1]str;
    t3[0] = "fun pick[T](seed: T, va: ...) u32 { var out: T = seed; var r: u32 = 0; $each a in va { $if ($type_of(out) == u32) { r = r + 4001; } $or { r = r + 4002; } } ret r; }\nfun main() i32 { var p: u64 = 5; var one: u32 = 1; pick[u64](p, one); ret 0; }\n";
    val p3: res[project.Project, outcome.Fail] = ut_lower_n(?s, ?alloc, ?n3[0], ?t3[0], 1);
    if (sel p3.err) { bad = 1; }
    if (sel p3.ok) {
        var pp: project.Project = p3.ok;
        val m:  *ir.Module      = ut_ir_of(?pp, ?s, "uniontest.main");
        if (ut_const_uses(m, 4001) != 0) { bad = 1; }
        if (ut_const_uses(m, 4002) != 1) { bad = 1; }
        project.dnit_project(?pp);
    }

    session.dnit(?s);
    ret bad;
}

fun ut_app(buf: *u8, w: usize, text: str) usize {
    var i: usize = 0;
    var k: usize = w;
    for (i < str_len(text)) {
        buf[k] = text[i];
        k      = k + 1;
        i      = i + 1;
    }
    ret k;
}

fun ut_appd(buf: *u8, w: usize, v: u32) usize {
    if (v >= 10) {
        val k: usize = ut_appd(buf, w, v / 10);
        buf[k] = ('0'::u32 + v % 10)::u8;
        ret k + 1;
    }
    buf[w] = ('0'::u32 + v)::u8;
    ret w + 1;
}

fun ut_shift_value(i: u32) u64 {
    if (i == 0) { ret 0; }
    if (i == 1) { ret 0xFFFFFFFFFFFFFFFF; }
    if (i == 2) { ret 0xAA55AA55AA55AA55; }
    if (i == 3) { ret 0x0102040810204080; }
    if (i == 4) { ret 0x8000000080008080; }
    if (i == 5) { ret 1; }
    var seed: u64 = 0x243F6A8885A308D3 + i::u64;
    seed = seed ^ (seed << 13);
    seed = seed ^ (seed >> 7);
    seed = seed ^ (seed << 17);
    ret seed;
}

val UT_SHIFT_VALUES: u32 = 16;

fun ut_mul_ref(bits: u32, v: u64, w: u64) u64 {
    var mask: u64 = 0xFFFFFFFFFFFFFFFF;
    if (bits < 64) { mask = (1::u64 << bits::u64) - 1; }
    ret ((v & mask) * (w & mask)) & mask;
}

test "mach.lang.driver:wide_global_feeds_wide_arithmetic" {
    var bad:    i32          = 0;
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    val src: str = "var trip: i64 = 3;\nvar sink: i64 = 0;\n#[noinline]\nfun bump(v: i64) i64 { ret v + trip; }\nfun main() i32 { sink = bump(5); ret 0; }\n";

    val pr: res[project.Project, outcome.Fail] = ut_ct_edge_project(?s, ?alloc, src, "rv32");
    if (sel pr.err) { bad = 1; }
    if (sel pr.ok) {
        var p: project.Project = pr.ok;
        if (ut_run_codegen_ok(?p) != 0) { bad = 1; }
        project.dnit_project(?p);
    }

    session.dnit(?s);
    ret bad;
}

val UT_RV32_MEM:   usize = 262144;
val UT_RV32_CODE:  u32   = 0x1000;
val UT_RV32_STACK: u32   = 0x3FFF0;

fun ut_rv32_run(mem: *u8, off: u32, args: *u32, nargs: u32,
    lo: *u32, hi: *u32, steps: *u32) bool {
    var core: rv32.Core;
    var i:    usize = 0;
    for (i < 32) {
        core.x[i] = 0;
        core.f[i] = 0;
        i         = i + 1;
    }
    core.frm     = 0;
    core.refused = "";

    core.x[1] = rv32.RETURN_SENTINEL;
    core.x[2] = UT_RV32_STACK;
    core.pc   = UT_RV32_CODE + off;

    var k: u32 = 0;
    for (k < nargs && k < 8) {
        core.x[(10 + k)::usize] = args[k];
        k                       = k + 1;
    }
    for (k < nargs) {
        val at: u32 = UT_RV32_STACK + (k - 8) * 4;
        var b:  u32 = 0;
        for (b < 4) {
            mem[(at + b)::usize] = ((args[k] >> (b * 8)) & 0xFF)::u8;
            b                    = b + 1;
        }
        k = k + 1;
    }

    if (!rv32.exec_reference(mem, UT_RV32_MEM, ?core)) { ret false; }
    @lo    = core.x[10];
    @hi    = core.x[11];
    @steps = core.steps;
    ret true;
}

fun ut_rv32_run2(mem: *u8, off: u32, a: u64, b: u64, out: *u64, steps: *u32) bool {
    var args: [4]u32;
    args[0] = (a & 0xFFFFFFFF)::u32;
    args[1] = (a >> 32)::u32;
    args[2] = (b & 0xFFFFFFFF)::u32;
    args[3] = (b >> 32)::u32;
    var lo: u32 = 0;
    var hi: u32 = 0;
    if (!ut_rv32_run(mem, off, ?args[0], 4, ?lo, ?hi, steps)) { ret false; }
    @out = lo::u64 | (hi::u64 << 32);
    ret true;
}

fun ut_rv32_probe_src(buf: *u8) usize {
    var w: usize = 0;
    w      = ut_app(buf, w, "#[symbol(\"_start\")]\nfun start() i32 { ret 0; }\n");
    w      = ut_app(buf, w, "fun mul64(a: i64, b: i64) i64 { ret a * b; }\n");
    w      = ut_app(buf, w, "fun xor64(a: i64, b: i64) i64 { ret a ^ b; }\n");
    w      = ut_app(buf, w, "fun add64(a: i64, b: i64) i64 { ret a + b; }\n");
    w      = ut_app(buf, w, "fun eq64(a: i64, b: i64) i64 { if (a == b) { ret 1; } ret 0; }\n");
    w      = ut_app(buf, w, "fun ltu64(a: u64, b: u64) i64 { if (a < b) { ret 1; } ret 0; }\n");
    w      = ut_app(buf, w, "fun lts64(a: i64, b: i64) i64 { if (a < b) { ret 1; } ret 0; }\n");
    w      = ut_app(buf, w, "fun shl64(a: u64, n: u64) u64 { ret a << n; }\n");
    w      = ut_app(buf, w, "fun shru64(a: u64, n: u64) u64 { ret a >> n; }\n");
    w      = ut_app(buf, w, "fun shrs64(a: i64, n: i64) i64 { ret a >> n; }\n");
    w      = ut_app(buf, w, "fun divu64(a: u64, b: u64) u64 { ret a / b; }\n");
    w      = ut_app(buf, w, "fun remu64(a: u64, b: u64) u64 { ret a % b; }\n");
    buf[w] = 0;
    ret w;
}

val UT_RV32_MUL:  u32 = 0;
val UT_RV32_XOR:  u32 = 1;
val UT_RV32_ADD:  u32 = 2;
val UT_RV32_EQ:   u32 = 3;
val UT_RV32_LTU:  u32 = 4;
val UT_RV32_LTS:  u32 = 5;
val UT_RV32_SHL:  u32 = 6;
val UT_RV32_SHRU: u32 = 7;
val UT_RV32_SHRS: u32 = 8;
val UT_RV32_DIVU: u32 = 9;
val UT_RV32_REMU: u32 = 10;
val UT_RV32_FNS:  u32 = 11;

fun ut_rv32_probe_name(slot: u32) str {
    if (slot == UT_RV32_MUL)  { ret "mul64"; }
    if (slot == UT_RV32_XOR)  { ret "xor64"; }
    if (slot == UT_RV32_ADD)  { ret "add64"; }
    if (slot == UT_RV32_EQ)   { ret "eq64"; }
    if (slot == UT_RV32_LTU)  { ret "ltu64"; }
    if (slot == UT_RV32_LTS)  { ret "lts64"; }
    if (slot == UT_RV32_SHL)  { ret "shl64"; }
    if (slot == UT_RV32_SHRU) { ret "shru64"; }
    if (slot == UT_RV32_SHRS) { ret "shrs64"; }
    if (slot == UT_RV32_DIVU) { ret "divu64"; }
    ret "remu64";
}

fun ut_rv32_probe_offset(img: *linker.LinkedImage, itn: *intern.Interner, want: str, off: *u32) bool {
    var hits:  u32 = 0;
    var found: u64 = 0;
    var i:     u32 = 0;
    for (i < img.symbol_count) {
        val looked: opt[str] = intern.lookup(itn, img.symbols[i].name);
        if (sel looked.some) {
            val nm: str = looked.some;
            if (ut_name_tail_is(nm, want)) {
                hits  = hits + 1;
                found = img.symbols[i].vaddr;
            }
        }
        i = i + 1;
    }
    if (hits != 1) { ret false; }
    @off = (found - img.base)::u32;
    ret true;
}

fun ut_name_tail_is(name: str, tail: str) bool {
    val n: usize = str_len(name);
    val t: usize = str_len(tail);
    if (t == 0 || t > n)                 { ret false; }
    if (n > t && name[n - t - 1] != '.') { ret false; }
    var i: usize = 0;
    for (i < t) {
        if (name[n - t + i] != tail[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

test "mach.lang.driver:wide_integer_executes_on_an_rv32_core_riscv32" {
    var bad:    i32          = 0;
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    val bufr: res[*u8, A.Error] = A.allocate[u8](?alloc, 8192);
    if (sel bufr.err) { ret 1; }
    val srcbuf: *u8 = bufr.ok;
    ut_rv32_probe_src(srcbuf);

    val memr: res[*u8, A.Error] = A.zallocate[u8](?alloc, UT_RV32_MEM);
    if (sel memr.err) {
        A.deallocate[u8](?alloc, srcbuf, 8192);
        ret 1;
    }
    val mem: *u8 = memr.ok;

    val pr: res[project.Project, outcome.Fail] = ut_ct_edge_project(?s, ?alloc, srcbuf::str, "rv32");
    if (sel pr.err) { bad = 1; }
    if (sel pr.ok) {
        var p: project.Project = pr.ok;
        if (ut_run_codegen_ok(?p) != 0) { bad = 1; }
        or {
            var tlen: u32 = 0;
            var offs: [16]u32;
            if (!ut_rv32_link_captured(?p, mem, ?tlen, ?offs[0])) { bad = 1; }
            or {
                if (ut_rv32_sweep(mem, ?offs[0]) != 0) { bad = 1; }
            }
        }
        project.dnit_project(?p);
    }

    A.deallocate[u8](?alloc, mem, UT_RV32_MEM);
    A.deallocate[u8](?alloc, srcbuf, 8192);
    ret bad;
}

fun ut_rv32_sweep(mem: *u8, offs: *u32) i32 {
    var bad:   i32 = 0;
    var steps: u32 = 0;
    var vi:    u32 = 0;
    for (vi < UT_SHIFT_VALUES) {
        val a:   u64 = ut_shift_value(vi);
        val b:   u64 = ut_shift_value((vi + 5) % UT_SHIFT_VALUES);
        var got: u64 = 0;

        if (!ut_rv32_run2(mem, offs[UT_RV32_MUL], a, b, ?got, ?steps)) { bad = 1; }
        or (got != ut_mul_ref(64, a, b))                               { bad = 1; }

        if (!ut_rv32_run2(mem, offs[UT_RV32_XOR], a, b, ?got, ?steps)) { bad = 1; }
        or (got != (a ^ b))                                            { bad = 1; }

        if (!ut_rv32_run2(mem, offs[UT_RV32_ADD], a, b, ?got, ?steps)) { bad = 1; }
        or (got != a + b)                                              { bad = 1; }

        if (!ut_rv32_run2(mem, offs[UT_RV32_EQ], a, a, ?got, ?steps)) { bad = 1; }
        or (got != 1)                                                 { bad = 1; }
        if (!ut_rv32_run2(mem, offs[UT_RV32_EQ], a, b, ?got, ?steps)) { bad = 1; }
        or (got != ut_rv32_bool(a == b))                              { bad = 1; }

        if (!ut_rv32_run2(mem, offs[UT_RV32_LTU], a, b, ?got, ?steps)) { bad = 1; }
        or (got != ut_rv32_bool(a < b))                                { bad = 1; }
        if (!ut_rv32_run2(mem, offs[UT_RV32_LTS], a, b, ?got, ?steps)) { bad = 1; }
        or (got != ut_rv32_bool(a::i64 < b::i64))                      { bad = 1; }

        if (b != 0) {
            if (!ut_rv32_run2(mem, offs[UT_RV32_DIVU], a, b, ?got, ?steps)) { bad = 1; }
            or (got != a / b)                                               { bad = 1; }
            if (!ut_rv32_run2(mem, offs[UT_RV32_REMU], a, b, ?got, ?steps)) { bad = 1; }
            or (got != a % b)                                               { bad = 1; }
        }
        vi = vi + 1;
    }

    var n: u64 = 0;
    for (n < 64) {
        var vj: u32 = 0;
        for (vj < 4) {
            val v:   u64 = ut_shift_value(vj);
            var got: u64 = 0;
            if (!ut_rv32_run2(mem, offs[UT_RV32_SHL], v, n, ?got, ?steps))  { bad = 1; }
            or (got != (v << n))                                            { bad = 1; }
            if (!ut_rv32_run2(mem, offs[UT_RV32_SHRU], v, n, ?got, ?steps)) { bad = 1; }
            or (got != (v >> n))                                            { bad = 1; }
            if (!ut_rv32_run2(mem, offs[UT_RV32_SHRS], v, n, ?got, ?steps)) { bad = 1; }
            or (got != (v::i64 >> n::i64)::u64)                             { bad = 1; }
            vj = vj + 1;
        }
        n = n + 1;
    }
    ret bad;
}

fun ut_rv32_bool(b: bool) u64 {
    if (b) { ret 1; }
    ret 0;
}

val UT_RV32_GA: u64 = 0x0123456789ABCDEF;

val UT_RV32_GN: u64 = 0xFFFFFFFF80000000;

fun ut_rv32_globals_src(buf: *u8) usize {
    var w: usize = 0;
    w      = ut_app(buf, w, "var ga: i64 = 0x0123456789ABCDEF;\n");
    w      = ut_app(buf, w, "var gn: i64 = -2147483648;\n");
    w      = ut_app(buf, w, "var gb: i64 = 0;\n");
    w      = ut_app(buf, w, "#[symbol(\"_start\")]\n");
    w      = ut_app(buf, w, "fun probe(pick: i32, v: i64) i64 {\n");
    w      = ut_app(buf, w, "    if (pick == 0) { ret ga; }\n");
    w      = ut_app(buf, w, "    if (pick == 1) { gb = v; ret gb; }\n");
    w      = ut_app(buf, w, "    if (pick == 2) { ret ga + v; }\n");
    w      = ut_app(buf, w, "    if (pick == 3) { ret ga - v; }\n");
    w      = ut_app(buf, w, "    if (pick == 4) { ret gb; }\n");
    w      = ut_app(buf, w, "    if (pick == 5) { ret gn; }\n");
    w      = ut_app(buf, w, "    if (pick == 6) { ret gn + v; }\n");
    w      = ut_app(buf, w, "    if (pick == 7) { ret gn - v; }\n");
    w      = ut_app(buf, w, "    ret 0;\n");
    w      = ut_app(buf, w, "}\n");
    buf[w] = 0;
    ret w;
}

val UT_RV32_G_LOAD:  u32 = 0;
val UT_RV32_G_STORE: u32 = 1;
val UT_RV32_G_ADD:   u32 = 2;
val UT_RV32_G_SUB:   u32 = 3;
val UT_RV32_G_READ:  u32 = 4;
val UT_RV32_G_NLOAD: u32 = 5;
val UT_RV32_G_NADD:  u32 = 6;
val UT_RV32_G_NSUB:  u32 = 7;

fun ut_rv32_link_captured(p: *project.Project, mem: *u8, len_out: *u32, offs: *u32) bool {
    val alloc: *A.Allocator = p.alloc;
    if (p.emit_len == 0) { ret false; }

    val ir: res[*of.ObjectImage, A.Error] = A.allocate[of.ObjectImage](alloc, p.emit_len::usize);
    if (sel ir.err) { ret false; }
    val images:  *of.ObjectImage = ir.ok;
    var missing: bool            = false;
    var i:       u32             = 0;
    for (i < p.emit_len) {
        val m: *project.ModuleEntry = ?p.modules[(p.topo[i])::u32];
        if (m.object_image == nil) { missing = true; }
        or                         { images[i] = @m.object_image; }
        i = i + 1;
    }

    var cap:    linker.LinkedImage;
    var linked: bool = false;
    if (!missing) {
        val lr: err[fail.Fail] = linker.link_images_captured(p.s, ?p.target, images,
            p.emit_len, nil::*of.DynLib, 0, "rv32probe"::*u8, false,
            of.image_options_default(of.SUBSYSTEM_CONSOLE), ?cap);
        linked = sel lr.ok;
    }
    A.deallocate[of.ObjectImage](alloc, images, p.emit_len::usize);
    if (!linked) { ret false; }

    var ok: bool = cap.len > 0 && UT_RV32_CODE::usize + cap.len < UT_RV32_STACK::usize;
    if (ok && offs != nil) {
        var k: u32 = 0;
        for (k < UT_RV32_FNS) {
            if (!ut_rv32_probe_offset(?cap, ?p.s.interner, ut_rv32_probe_name(k), ?offs[k])) { ok = false; }
            k = k + 1;
        }
    }
    if (ok) {
        var z: usize = 0;
        for (z < UT_RV32_MEM) {
            mem[z] = 0;
            z      = z + 1;
        }
        z = 0;
        for (z < cap.len) {
            mem[UT_RV32_CODE::usize + z] = cap.bytes[z];
            z                            = z + 1;
        }
        @len_out = cap.len::u32;
    }
    linker.linked_image_dnit(?cap, alloc);
    ret ok;
}

fun ut_rv32_build_linked(s: *session.Session, alloc: *A.Allocator, src: str, tgt: str,
    mem: *u8, len_out: *u32) bool {
    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = src;
    val root_r: res[str, fail.Fail] = ut_scaffold_m(alloc, ut_ct_edge_manifest(), ?names[0], ?texts[0], 1);
    if (sel root_r.err) { ret false; }
    val root: str = root_r.ok;

    var ok: bool              = false;
    val rr: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.ok) {
        var tsel_12976: manifest.Selection                 = ut_target_sel(tgt);
        val pr:         res[project.Project, outcome.Fail] = driver.build_project(s, root, ?tsel_12976);
        if (sel pr.ok) {
            var p: project.Project = pr.ok;
            if (ut_run_codegen_ok(?p) == 0) { ok = ut_rv32_link_captured(?p, mem, len_out, nil::*u32); }
            project.dnit_project(?p);
        }
    }
    fs.remove_all(alloc, root);
    ret ok;
}

fun ut_rv32_run_g(mem: *u8, pick: u32, v: u64, out: *u64, steps: *u32) bool {
    var args: [3]u32;
    args[0] = pick;
    args[1] = (v & 0xFFFFFFFF)::u32;
    args[2] = (v >> 32)::u32;
    var lo: u32 = 0;
    var hi: u32 = 0;
    if (!ut_rv32_run(mem, 0, ?args[0], 3, ?lo, ?hi, steps)) { ret false; }
    @out = lo::u64 | (hi::u64 << 32);
    ret true;
}

test "mach.lang.driver:wide_global_executes_on_an_rv32_core_riscv32" {
    var bad:    i32          = 0;
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    val bufr: res[*u8, A.Error] = A.allocate[u8](?alloc, 8192);
    if (sel bufr.err) {
        session.dnit(?s);
        ret 1;
    }
    val srcbuf: *u8 = bufr.ok;
    ut_rv32_globals_src(srcbuf);

    val memr: res[*u8, A.Error] = A.zallocate[u8](?alloc, UT_RV32_MEM);
    if (sel memr.err) {
        session.dnit(?s);
        ret 1;
    }
    val mem: *u8 = memr.ok;

    var ilen: u32 = 0;
    if (!ut_rv32_build_linked(?s, ?alloc, srcbuf::str, "rv32", mem, ?ilen)) { bad = 1; }
    or {
        if (ut_rv32_globals_sweep(mem) != 0) { bad = 1; }
    }

    A.deallocate[u8](?alloc, mem, UT_RV32_MEM);
    A.deallocate[u8](?alloc, srcbuf, 8192);
    session.dnit(?s);
    ret bad;
}

fun ut_rv32_globals_sweep(mem: *u8) i32 {
    var bad:   i32 = 0;
    var steps: u32 = 0;
    var got:   u64 = 0;

    if (!ut_rv32_run_g(mem, UT_RV32_G_LOAD, 0, ?got, ?steps))  { ret 1; }
    or (got != UT_RV32_GA)                                     { bad = 1; }
    if (!ut_rv32_run_g(mem, UT_RV32_G_NLOAD, 0, ?got, ?steps)) { ret 1; }
    or (got != UT_RV32_GN)                                     { bad = 1; }

    var vi: u32 = 0;
    for (vi < UT_SHIFT_VALUES) {
        val v: u64 = ut_shift_value(vi);

        if (!ut_rv32_run_g(mem, UT_RV32_G_STORE, v, ?got, ?steps)) { bad = 1; }
        or (got != v)                                              { bad = 1; }

        if (!ut_rv32_run_g(mem, UT_RV32_G_READ, 0, ?got, ?steps)) { bad = 1; }
        or (got != v)                                             { bad = 1; }

        if (!ut_rv32_run_g(mem, UT_RV32_G_LOAD, 0, ?got, ?steps)) { bad = 1; }
        or (got != UT_RV32_GA)                                    { bad = 1; }

        if (!ut_rv32_run_g(mem, UT_RV32_G_ADD, v, ?got, ?steps)) { bad = 1; }
        or (got != UT_RV32_GA + v)                               { bad = 1; }
        if (!ut_rv32_run_g(mem, UT_RV32_G_SUB, v, ?got, ?steps)) { bad = 1; }
        or (got != UT_RV32_GA - v)                               { bad = 1; }

        if (!ut_rv32_run_g(mem, UT_RV32_G_NADD, v, ?got, ?steps)) { bad = 1; }
        or (got != UT_RV32_GN + v)                                { bad = 1; }
        if (!ut_rv32_run_g(mem, UT_RV32_G_NSUB, v, ?got, ?steps)) { bad = 1; }
        or (got != UT_RV32_GN - v)                                { bad = 1; }

        vi = vi + 1;
    }
    ret bad;
}

fun ut_rv32_float_src(buf: *u8) usize {
    var w: usize = 0;
    w      = ut_app(buf, w, "var fb: i64 = 0;\n");
    w      = ut_app(buf, w, "#[symbol(\"_start\")]\n");
    w      = ut_app(buf, w, "fun probe(pick: i32, v: i64) i64 {\n");
    w      = ut_app(buf, w, "    val pd: *f64 = (?fb)::*f64;\n");
    w      = ut_app(buf, w, "    val ps: *f32 = (?fb)::*f32;\n");
    w      = ut_app(buf, w, "    if (pick == 0)  { @pd = v::f64;        ret fb; }\n");
    w      = ut_app(buf, w, "    if (pick == 1)  { @pd = (v::u64)::f64; ret fb; }\n");
    w      = ut_app(buf, w, "    if (pick == 2)  { @ps = v::f32;        ret fb; }\n");
    w      = ut_app(buf, w, "    if (pick == 3)  { @ps = (v::u64)::f32; ret fb; }\n");
    w      = ut_app(buf, w, "    if (pick == 4)  { fb = v; ret (@pd)::i64; }\n");
    w      = ut_app(buf, w, "    if (pick == 5)  { fb = v; ret ((@pd)::u64)::i64; }\n");
    w      = ut_app(buf, w, "    if (pick == 6)  { fb = v; ret (@ps)::i64; }\n");
    w      = ut_app(buf, w, "    if (pick == 7)  { fb = v; ret ((@ps)::u64)::i64; }\n");
    w      = ut_app(buf, w, "    if (pick == 8)  { fb = v; @pd = (@pd) + (@pd); ret fb; }\n");
    w      = ut_app(buf, w, "    if (pick == 9)  { fb = v; @pd = (@pd) * (@pd); ret fb; }\n");
    w      = ut_app(buf, w, "    if (pick == 10) { fb = v; @pd = (@pd) - 1.5; ret fb; }\n");
    w      = ut_app(buf, w, "    if (pick == 11) { fb = v; @pd = (@pd) / 3.0; ret fb; }\n");
    w      = ut_app(buf, w, "    if (pick == 12) { fb = v; @ps = (@ps) + (@ps); ret fb; }\n");
    w      = ut_app(buf, w, "    if (pick == 13) { fb = v; @ps = (@ps) * 0.5; ret fb; }\n");
    w      = ut_app(buf, w, "    if (pick == 14) { fb = v; if ((@pd) < 1.0) { ret 1; } ret 0; }\n");
    w      = ut_app(buf, w, "    if (pick == 15) { fb = v; if ((@pd) == (@pd)) { ret 1; } ret 0; }\n");
    w      = ut_app(buf, w, "    if (pick == 16) { fb = v; @pd = ((@ps))::f64; ret fb; }\n");
    w      = ut_app(buf, w, "    if (pick == 17) { fb = v; @ps = ((@pd))::f32; ret fb; }\n");
    w      = ut_app(buf, w, "    ret 0;\n");
    w      = ut_app(buf, w, "}\n");
    buf[w] = 0;
    ret w;
}

val UT_RV32_F_I64_F64: u32 = 0;
val UT_RV32_F_U64_F64: u32 = 1;
val UT_RV32_F_I64_F32: u32 = 2;
val UT_RV32_F_U64_F32: u32 = 3;
val UT_RV32_F_F64_I64: u32 = 4;
val UT_RV32_F_F64_U64: u32 = 5;
val UT_RV32_F_F32_I64: u32 = 6;
val UT_RV32_F_F32_U64: u32 = 7;
val UT_RV32_F_ADD_D:   u32 = 8;
val UT_RV32_F_MUL_D:   u32 = 9;
val UT_RV32_F_SUB_D:   u32 = 10;
val UT_RV32_F_DIV_D:   u32 = 11;
val UT_RV32_F_ADD_S:   u32 = 12;
val UT_RV32_F_MUL_S:   u32 = 13;
val UT_RV32_F_LT_D:    u32 = 14;
val UT_RV32_F_EQ_D:    u32 = 15;
val UT_RV32_F_EXT:     u32 = 16;
val UT_RV32_F_TRUNC:   u32 = 17;

val UT_RV32_FV: u32 = 8;

fun ut_rv32_fvalue(i: u32) u64 {
    if (i == 0) { ret 0; }
    if (i == 1) { ret 1; }
    if (i == 2) { ret 0xFFFFFFFFFFFFFFFF; }
    if (i == 3) { ret 0x8000000000000000; }
    if (i == 4) { ret 0x0020000000000000; }
    if (i == 5) { ret 0x0020000000000001; }
    if (i == 6) { ret 0x7FFFFFFFFFFFFFFF; }
    ret 0xFFFFFFFFFFFFFFFF;
}

val UT_RV32_FB: u32 = 14;

fun ut_rv32_fbits(i: u32) u64 {
    if (i == 0)  { ret 0x7FF8000000000000; }
    if (i == 1)  { ret 0x7FF0000000000000; }
    if (i == 2)  { ret 0xFFF0000000000000; }
    if (i == 3)  { ret 0x0000000000000000; }
    if (i == 4)  { ret 0x8000000000000000; }
    if (i == 5)  { ret 0x0000000000000001; }
    if (i == 6)  { ret 0x43E0000000000000; }
    if (i == 7)  { ret 0xC3E0000000000000; }
    if (i == 8)  { ret 0x43F0000000000000; }
    if (i == 9)  { ret 0xBFE0000000000000; }
    if (i == 10) { ret 0x4004000000000000; }
    if (i == 11) { ret 0xC004000000000000; }
    if (i == 12) { ret 0x4330000000000001; }
    if (i == 13) { ret 0x7E37E43C8800759C; }
    ret 0;
}

fun ut_rv32_run_f(mem: *u8, pick: u32, v: u64, out: *u64, steps: *u32) bool {
    var args: [3]u32;
    args[0] = pick;
    args[1] = (v & 0xFFFFFFFF)::u32;
    args[2] = (v >> 32)::u32;
    var lo: u32 = 0;
    var hi: u32 = 0;
    if (!ut_rv32_run(mem, 0, ?args[0], 3, ?lo, ?hi, steps)) { ret false; }
    @out = lo::u64 | (hi::u64 << 32);
    ret true;
}

fun ut_rv32_f2i_ref(x: f64, unsigned: bool) u64 {
    if (x != x) {
        if (unsigned) { ret 0xFFFFFFFFFFFFFFFF; }
        ret 0x7FFFFFFFFFFFFFFF;
    }
    if (unsigned) {
        if (x >= 18446744073709551616.0) { ret 0xFFFFFFFFFFFFFFFF; }
        if (x <= -1.0)                   { ret 0; }
        if (x < 1.0)                     { ret 0; }
        ret x::u64;
    }
    if (x >= 9223372036854775808.0)  { ret 0x7FFFFFFFFFFFFFFF; }
    if (x <= -9223372036854775808.0) { ret 0x8000000000000000; }
    ret (x::i64)::u64;
}

fun ut_rv32_float_sweep(mem: *u8) i32 {
    var bad:   i32 = 0;
    var got:   u64 = 0;
    var steps: u32 = 0;

    var i: u32 = 0;
    for (i < UT_RV32_FV) {
        val v:  u64 = ut_rv32_fvalue(i);
        val sv: i64 = v::i64;

        val hd: f64 = sv::f64;
        if (!ut_rv32_run_f(mem, UT_RV32_F_I64_F64, v, ?got, ?steps)) { ret 2; }
        or (got != (hd:~i64)::u64)                                   { bad = 1; }

        val hu: f64 = v::f64;
        if (!ut_rv32_run_f(mem, UT_RV32_F_U64_F64, v, ?got, ?steps)) { ret 2; }
        or (got != (hu:~i64)::u64)                                   { bad = 1; }

        val hs: f32 = sv::f32;
        if (!ut_rv32_run_f(mem, UT_RV32_F_I64_F32, v, ?got, ?steps)) { ret 2; }
        or ((got & 0xFFFFFFFF) != ((hs:~i32)::u32)::u64)             { bad = 1; }

        val hsu: f32 = v::f32;
        if (!ut_rv32_run_f(mem, UT_RV32_F_U64_F32, v, ?got, ?steps)) { ret 2; }
        or ((got & 0xFFFFFFFF) != ((hsu:~i32)::u32)::u64)            { bad = 1; }

        i = i + 1;
    }

    i = 0;
    for (i < UT_RV32_FB) {
        val b: u64 = ut_rv32_fbits(i);
        val x: f64 = (b::i64):~f64;

        if (!ut_rv32_run_f(mem, UT_RV32_F_F64_I64, b, ?got, ?steps)) { ret 2; }
        or (got != ut_rv32_f2i_ref(x, false))                        { bad = 1; }
        if (!ut_rv32_run_f(mem, UT_RV32_F_F64_U64, b, ?got, ?steps)) { ret 2; }
        or (got != ut_rv32_f2i_ref(x, true))                         { bad = 1; }

        val s:  f32 = x::f32;
        val sb: u64 = ((s:~i32)::u32)::u64;
        val sx: f64 = s::f64;
        if (!ut_rv32_run_f(mem, UT_RV32_F_F32_I64, sb, ?got, ?steps)) { ret 2; }
        or (got != ut_rv32_f2i_ref(sx, false))                        { bad = 1; }
        if (!ut_rv32_run_f(mem, UT_RV32_F_F32_U64, sb, ?got, ?steps)) { ret 2; }
        or (got != ut_rv32_f2i_ref(sx, true))                         { bad = 1; }

        val two: f64 = x + x;
        if (!ut_rv32_run_f(mem, UT_RV32_F_ADD_D, b, ?got, ?steps)) { ret 2; }
        or (got != (two:~i64)::u64)                                { bad = 1; }
        val sq: f64 = x * x;
        if (!ut_rv32_run_f(mem, UT_RV32_F_MUL_D, b, ?got, ?steps)) { ret 2; }
        or (got != (sq:~i64)::u64)                                 { bad = 1; }
        val dn: f64 = x - 1.5;
        if (!ut_rv32_run_f(mem, UT_RV32_F_SUB_D, b, ?got, ?steps)) { ret 2; }
        or (got != (dn:~i64)::u64)                                 { bad = 1; }
        val dv: f64 = x / 3.0;
        if (!ut_rv32_run_f(mem, UT_RV32_F_DIV_D, b, ?got, ?steps)) { ret 2; }
        or (got != (dv:~i64)::u64)                                 { bad = 1; }

        val s2: f32 = s + s;
        if (!ut_rv32_run_f(mem, UT_RV32_F_ADD_S, sb, ?got, ?steps)) { ret 2; }
        or ((got & 0xFFFFFFFF) != ((s2:~i32)::u32)::u64)            { bad = 1; }
        val sh2: f32 = s * 0.5;
        if (!ut_rv32_run_f(mem, UT_RV32_F_MUL_S, sb, ?got, ?steps)) { ret 2; }
        or ((got & 0xFFFFFFFF) != ((sh2:~i32)::u32)::u64)           { bad = 1; }

        var lt: u64 = 0;
        if (x < 1.0)                                              { lt = 1; }
        if (!ut_rv32_run_f(mem, UT_RV32_F_LT_D, b, ?got, ?steps)) { ret 2; }
        or (got != lt)                                            { bad = 1; }
        var eq: u64 = 0;
        if (x == x)                                               { eq = 1; }
        if (!ut_rv32_run_f(mem, UT_RV32_F_EQ_D, b, ?got, ?steps)) { ret 2; }
        or (got != eq)                                            { bad = 1; }

        val wide: f64 = s::f64;
        if (!ut_rv32_run_f(mem, UT_RV32_F_EXT, sb, ?got, ?steps)) { ret 2; }
        or (got != (wide:~i64)::u64)                              { bad = 1; }
        val narrow: f32 = x::f32;
        if (!ut_rv32_run_f(mem, UT_RV32_F_TRUNC, b, ?got, ?steps)) { ret 2; }
        or ((got & 0xFFFFFFFF) != ((narrow:~i32)::u32)::u64)       { bad = 1; }

        i = i + 1;
    }
    ret bad;
}

test "mach.lang.driver:float_executes_on_an_rv32_core_riscv32" {
    var bad:    i32          = 0;
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    val mr: res[*u8, A.Error] = A.zallocate[u8](?alloc, UT_RV32_MEM);
    if (sel mr.err) { ret 1; }
    val mem: *u8 = mr.ok;

    val br: res[*u8, A.Error] = A.zallocate[u8](?alloc, 4096::usize);
    if (sel br.err) { ret 1; }
    val srcbuf: *u8 = br.ok;
    ut_rv32_float_src(srcbuf);

    var t: u32 = 0;
    for (t < 3) {
        var name: str = "rv32";
        if (t == 1) { name = "rv32f"; }
        or (t == 2) { name = "rv32s"; }
        var ilen: u32 = 0;
        if (!ut_rv32_build_linked(?s, ?alloc, srcbuf::str, name, mem, ?ilen)) { bad = 3; }
        or {
            val r: i32 = ut_rv32_float_sweep(mem);
            if (r > bad) { bad = r; }
        }
        t = t + 1;
    }
    ret bad;
}

test "mach.lang.driver:setup_registry_publishes_only_complete_debug_descriptors" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }
    if (of.debug_registered_count(?s.registry.debug) == 0) {
        session.dnit(?s);
        ret 1;
    }
    session.dnit(?s);

    ret 0;
}

fun ut_tally_secret_stores(p: *project.Project, stores: *u32, marked: *u32) {
    @stores = 0;
    @marked = 0;
    var ti: u32 = 0;
    for (ti < p.topo_len) {
        val m: *ir.Module = p.modules[p.topo[ti]::u32].ir_module;
        if (m != nil) {
            var fi: u32 = 0;
            for (fi < m.function_len) {
                val fn: *ir.Function = ?m.functions[fi];
                var bi: u32          = 0;
                for (bi < fn.block_count) {
                    val blk: *ir.Block = ?fn.blocks[bi];
                    var ix:  u32       = 0;
                    for (ix < blk.instr_count) {
                        val ins: *instruction.Instruction = ?fn.instrs[blk.instructions[ix]];
                        if (ins.kind == instruction.OP_STORE || ins.kind == instruction.OP_MEMZERO) {
                            @stores = @stores + 1;
                            if (ins.secret) { @marked = @marked + 1; }
                        }
                        ix = ix + 1;
                    }
                    bi = bi + 1;
                }
                fi = fi + 1;
            }
        }
        ti = ti + 1;
    }
}

test "mach.lang.driver:secret_store_taint_survives_lower" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    val ssrc: str                                = "fun wipe(q: *^u8, n: u64) { var i: u64 = 0; for (i < n) { q[i] = 0; i = i + 1; } }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n";
    val spr:  res[project.Project, outcome.Fail] = ut_vec_lower(?s, ?alloc, ssrc, "linux");
    if (sel spr.err) { ret 1; }
    var sp:      project.Project = spr.ok;
    var sstores: u32             = 0;
    var smarked: u32             = 0;
    ut_tally_secret_stores(?sp, ?sstores, ?smarked);

    val psrc: str                                = "fun wipe(q: *u8, n: u64) { var i: u64 = 0; for (i < n) { q[i] = 0; i = i + 1; } }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n";
    val ppr:  res[project.Project, outcome.Fail] = ut_vec_lower(?s, ?alloc, psrc, "linux");
    if (sel ppr.err) { ret 4; }
    var pp:      project.Project = ppr.ok;
    var pstores: u32             = 0;
    var pmarked: u32             = 0;
    ut_tally_secret_stores(?pp, ?pstores, ?pmarked);

    val vsrc: str                                = "fun mk(k: ^u8) [2]^u8 { var a: [2]^u8 = [2]^u8{k, k}; ret a; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n";
    val vpr:  res[project.Project, outcome.Fail] = ut_vec_lower(?s, ?alloc, vsrc, "linux");
    if (sel vpr.err) { ret 6; }
    var vp:      project.Project = vpr.ok;
    var vstores: u32             = 0;
    var vmarked: u32             = 0;
    ut_tally_secret_stores(?vp, ?vstores, ?vmarked);

    if (sstores == 0 || pstores == 0) { ret 3; }
    if (smarked == 0)                 { ret 2; }
    if (pmarked != 0)                 { ret 5; }
    if (vmarked == 0)                 { ret 7; }
    ret 0;
}

test "mach.lang.driver:oblivious_asm_validated_not_refused" {
    var bad: i32 = 0;

    if (ut_codegen_target_ok("#[oblivious]\nfun f(x: ^u64) ^u64 { var r: ^u64 = x; asm x86_64 { nop } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n", "linux") != 0) { bad = 1; }

    if (ut_codegen_target_ok("#[oblivious]\nfun f(x: ^u64) ^u64 { var r: ^u64 = x; asm x86_64 { jmp 1f\n1:\n nop } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n", "linux") != 0) { bad = 1; }

    if (ut_codegen_target_ok("#[oblivious]\nfun f(p: *i64) i64 { var v: i64 = 1; asm x86_64 { mov rax, {v}\n lock xadd {p}, rax\n mov {v}, rax } ret v; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n", "linux") != 0) { bad = 1; }

    if (ut_codegen_target_ok("#[oblivious]\nfun f(x: ^u64) ^u64 { var r: ^u64 = x; asm aarch64 { nop } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n", "linux-arm64") != 0) { bad = 1; }

    if (ut_codegen_target_ok("#[oblivious]\nfun ll(p: *i64) i64 { var v: i64 = 0; asm aarch64 { ldr x12, {p}\n ldaxr x9, [x12]\n stlxr w10, x9, [x12]\n cbnz w10, 1f\n1:\n nop } ret v; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n", "linux-arm64") != 0) { bad = 1; }
    if (ut_codegen_target_ok("#[oblivious]\nfun f(x: ^u64) ^u64 { var r: ^u64 = x; asm riscv64 { nop } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n", "linux-riscv64") != 0)                                                                         { bad = 1; }

    # the compared registers are defined inside the block: at o0 the secret
    # parameter lives in whichever register the allocator chose, and the
    # post-expansion walk sees a compare on it for what it is
    if (ut_codegen_target_ok("#[oblivious]\nfun f(x: ^u64) ^u64 { var r: ^u64 = x; asm x86_64 { mov rax, 1\n mov rcx, 2\n cmp rax, rcx\n je 1f\n1:\n nop } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n", "linux") != 0) { bad = 1; }

    if (ut_codegen_target_ok("#[oblivious]\nfun f(k: ^u64) ^u64 { var r: ^u64 = k; asm x86_64 { mov rax, {r}\n cmp rax, 1\n cmp rbx, rcx\n je 1f\n1:\n nop } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n", "linux") != 0) { bad = 1; }

    if (ut_codegen_target_ok("#[oblivious]\nfun f(x: ^u64) ^u64 { var r: ^u64 = x; asm x86_64 { cmp rax, rbx\n setb bl\n mov rcx, [rbx] } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n", "linux") != 0) { bad = 1; }

    ret bad;
}

test "mach.lang.driver:oblivious_asm_leaks_refused" {
    var bad: i32 = 0;

    if (ut_codegen_target_rejects("#[oblivious]\nfun f(k: ^u64) ^u64 { var r: ^u64 = k; asm x86_64 { cmp {r}, rbx\n je 1f\n1:\n nop } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "linux", "its condition rides the flags register") != 0) { bad = 1; }
    if (ut_codegen_target_rejects("#[oblivious]\nfun f(k: ^u64) ^u64 { var r: ^u64 = k; asm x86_64 { cmp {r}, rbx\n je 1f\n1:\n nop } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "linux", "branches on a secret value") != 0) { bad = 1; }

    if (ut_codegen_target_rejects("#[oblivious]\nfun f(k: ^u64) ^u64 { var r: ^u64 = k; asm x86_64 { cmp {r}, rbx\n inc rax\n jc 1f\n1:\n nop } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "linux", "branches on a secret value") != 0) { bad = 1; }
    if (ut_codegen_target_rejects("#[oblivious]\nfun f(k: ^u64) ^u64 { var r: ^u64 = k; asm x86_64 { cmp {r}, rbx\n shl rax, 1\n jc 1f\n1:\n nop } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "linux", "branches on a secret value") != 0) { bad = 1; }

    if (ut_codegen_target_rejects("#[oblivious]\nfun f(k: ^u64) ^u64 { var r: ^u64 = k; asm x86_64 { mov rax, {r}\n inc rax\n je 1f\n1:\n nop } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "linux", "branches on a secret value") != 0) { bad = 1; }
    if (ut_codegen_target_rejects("#[oblivious]\nfun f(k: ^u64) ^u64 { var r: ^u64 = k; asm x86_64 { mov rax, {r}\n dec rax\n je 1f\n1:\n nop } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "linux", "branches on a secret value") != 0) { bad = 1; }
    if (ut_codegen_target_rejects("#[oblivious]\nfun f(k: ^u64) ^u64 { var r: ^u64 = k; asm x86_64 { mov rax, {r}\n shl rax, 1\n je 1f\n1:\n nop } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "linux", "branches on a secret value") != 0) { bad = 1; }
    if (ut_codegen_target_rejects("#[oblivious]\nfun f(k: ^u64) ^u64 { var r: ^u64 = k; asm x86_64 { mov rax, {r}\n shr rax, 1\n je 1f\n1:\n nop } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "linux", "branches on a secret value") != 0) { bad = 1; }
    if (ut_codegen_target_rejects("#[oblivious]\nfun f(k: ^u64) ^u64 { var r: ^u64 = k; asm x86_64 { mov rax, {r}\n sar rax, 1\n je 1f\n1:\n nop } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "linux", "branches on a secret value") != 0) { bad = 1; }

    if (ut_codegen_target_rejects("#[oblivious]\nfun f(k: ^u64) ^u64 { var r: ^u64 = k; asm x86_64 { popfq\n je 1f\n1:\n nop } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "linux", "branches on a secret value") != 0) { bad = 1; }

    if (ut_codegen_target_rejects("#[oblivious]\nfun f(k: ^u64) ^u64 { var r: ^u64 = k; asm x86_64 { mov rax, {r}\n cmpxchg [rbx], rcx\n je 1f\n1:\n nop } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "linux", "branches on a secret value") != 0) { bad = 1; }

    if (ut_codegen_target_rejects("#[oblivious]\nfun f(k: ^u64) ^u64 { var r: ^u64 = k; asm x86_64 { mov rax, {r}\n cmp rax, 1\n setb bl\n mov rcx, [rbx] } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "linux", "addresses memory with a secret value") != 0) { bad = 1; }

    if (ut_codegen_target_rejects("#[oblivious]\nfun f(x: ^u64) ^u64 { var r: ^u64 = x; asm x86_64 { .byte 0x90 } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "linux", "its payload can encode any instruction") != 0) { bad = 1; }
    if (ut_codegen_target_rejects("#[oblivious]\nfun f(x: ^u64) ^u64 { var r: ^u64 = x; asm aarch64 { .word 0xd503201f } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "linux-arm64", "its payload can encode any instruction") != 0) { bad = 1; }
    if (ut_codegen_target_rejects("#[oblivious]\nfun f(x: ^u64) ^u64 { var r: ^u64 = x; asm riscv64 { .quad 0x0000001300000013 } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "linux-riscv64", "its payload can encode any instruction") != 0) { bad = 1; }

    if (ut_codegen_target_rejects("#[oblivious]\nfun bc(k: ^u64) ^u64 { var r: ^u64 = k; asm aarch64 { ldr x9, {r}\n cmp x9, x1\n b.eq 1f\n1:\n nop } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "linux-arm64", "its condition rides the flags register") != 0) { bad = 1; }

    if (ut_codegen_target_rejects("#[oblivious]\nfun f(k: ^u64) ^u64 { var r: ^u64 = k; asm aarch64 { ldr x9, {r}\n cbnz x9, 1f\n1:\n nop } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "linux-arm64", "branches on a secret value inside an inline-asm block") != 0) { bad = 1; }

    if (ut_codegen_target_rejects("#[oblivious]\nfun f(k: ^u64) ^u64 { var r: ^u64 = k; asm riscv64 { ld a0, {r}\n div a1, a0, a0\n nop } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "linux-riscv64", "variable-latency inline-asm operation on a secret value") != 0) { bad = 1; }

    ret bad;
}

