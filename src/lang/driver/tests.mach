test "mach.lang.driver:union_realloc_midwalk_no_dangling_deref" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [26]str;
    var texts: [26]str;
    val n:     u32 = ut_realloc_fixture(?alloc, ?names[0], ?texts[0]);

    val pr: res[project.Project, outcome.Fail] = ut_build(?s, ?alloc, ?names[0], ?texts[0], n);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    var bad: i32 = 0;
    if (!ut_has(?p, ?s, "uniontest.main"))       { bad = 1; }
    or (!ut_has(?p, ?s, "uniontest.w00"))        { bad = 1; }
    or (!ut_has(?p, ?s, "uniontest.w23"))        { bad = 1; }
    or (!ut_has(?p, ?s, "uniontest.lx"))         { bad = 1; }
    or (p.module_len <= load.INITIAL_MODULE_CAP) { bad = 1; }

    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

