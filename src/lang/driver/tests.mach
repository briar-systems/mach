    val pr: res[project.Project, outcome.Fail] = ut_spv_fixture(?s, ?alloc);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    var bad:   i32 = 0;
    var img:   of.ObjectImage;
    var fault: str = nil;
    if (!ut_spv_codegen(?p, ?s, "spvcase.main", ?img, ?fault)) {
        project.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }
    var n: u32  = 0;
    val w: *u32 = ut_spv_words(?img, ?n);
    if (w == nil) {
        obj.dnit(?img);
        project.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }

    if (ut_spv_arity_count(w, n, 5) != 0)           { bad = 1; }
    if (ut_spv_arity_count(w, n, 6) != 0)           { bad = 1; }
    if (ut_spv_count(w, n, spirv.OP_FUNCTION) != 6) { bad = 1; }

    var lib: of.ObjectImage;
    if (!ut_spv_codegen(?p, ?s, "spvcase.local", ?lib, ?fault)) { bad = 1; }
    or {
        var ln: u32  = 0;
        val lw: *u32 = ut_spv_words(?lib, ?ln);
        if (lw == nil) { bad = 1; }
        or {
            if (ut_spv_count(lw, ln, spirv.OP_FUNCTION) != 2) { bad = 1; }
            if (ut_spv_arity_count(lw, ln, 5) != 1)           { bad = 1; }
            if (ut_spv_export_count(lw, ln) != 2)             { bad = 1; }
        }
        obj.dnit(?lib);
    }

    obj.dnit(?img);
    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.driver:spirv_shares_one_helper_between_two_entry_points" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    val pr: res[project.Project, outcome.Fail] = ut_spv_fixture(?s, ?alloc);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    var bad:   i32 = 0;
    var img:   of.ObjectImage;
    var fault: str = nil;
    if (!ut_spv_codegen(?p, ?s, "spvcase.main", ?img, ?fault)) {
        project.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }
    var n: u32  = 0;
    val w: *u32 = ut_spv_words(?img, ?n);
    if (w == nil) {
        obj.dnit(?img);
        project.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }

    if (ut_spv_count(w, n, spirv.OP_ENTRY_POINT) != 2) { bad = 1; }
    if (ut_spv_arity_count(w, n, 1) != 1)              { bad = 1; }
    if (ut_spv_arity_count(w, n, 2) != 1)              { bad = 1; }
    if (ut_spv_arity_count(w, n, 3) != 1)              { bad = 1; }
    if (ut_spv_arity_count(w, n, 4) != 1)              { bad = 1; }

    val e0: u32 = ut_spv_entry_fn(w, n, 0);
    val e1: u32 = ut_spv_entry_fn(w, n, 1);
    val i0: u32 = ut_spv_fn_index_of(w, n, e0);
    val i1: u32 = ut_spv_fn_index_of(w, n, e1);
    if (e0 == 0 || e1 == 0 || e0 == e1)           { bad = 1; }
    if (i0 == UT_SPV_NO_FN || i1 == UT_SPV_NO_FN) { bad = 1; }
    or {
        val c0: u32 = ut_spv_first_callee_in(w, n, i0);
        val c1: u32 = ut_spv_first_callee_in(w, n, i1);
        if (c0 == 0 || c0 != c1) { bad = 1; }
    }

    obj.dnit(?img);
    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

