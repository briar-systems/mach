    texts[5]  = body;
    names[6]  = "rm5.mach";
    texts[6]  = body;
    names[7]  = "rm6.mach";
    texts[7]  = body;
    names[8]  = "rm7.mach";
    texts[8]  = body;
    names[9]  = "rm8.mach";
