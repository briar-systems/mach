    rq.project_root = root;
    rq.jobs         = 1;
    val pr: R.Result[bplan.BuildPlan, outcome.Fail] = bplan.plan(?alloc, ?s.interner, ?s.registry, ?m, rq);
    if (R.is_err[bplan.BuildPlan, outcome.Fail](pr)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    var bp: bplan.BuildPlan = R.unwrap_ok[bplan.BuildPlan, outcome.Fail](pr);

    var bad: i32 = 0;

    val r1: R.Result[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, ?alloc, nil);
    if (R.is_err[outcome.BuildOutcome, outcome.Fail](r1)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    if (R.unwrap_ok[outcome.BuildOutcome, outcome.Fail](r1).severity != outcome.BUILD_OK) { bad = 1; }

    val st_main: session.StableModuleId = ut_stable_of(?s, "uniontest.main");
    val st_a:    session.StableModuleId = ut_stable_of(?s, "uniontest.a");
    val st_b:    session.StableModuleId = ut_stable_of(?s, "uniontest.b");
    if (st_main == session.STABLE_MODULE_NIL || st_a == session.STABLE_MODULE_NIL || st_b == session.STABLE_MODULE_NIL) { bad = 1; }

    val tgt_1:   query.Revision = query.peek_revision(?s.queries, query.Q_TARGET,  0);
    val res_a1:  query.Revision = query.peek_revision(?s.queries, query.Q_RESOLVE, st_a::u64);
    val sema_a1: query.Revision = query.peek_revision(?s.queries, query.Q_SEMA,    st_a::u64);
    val low_a1:  query.Revision = query.peek_revision(?s.queries, query.Q_LOWER,   st_a::u64);
    val cg_m1:   query.Revision = query.peek_revision(?s.queries, query.Q_CODEGEN, st_main::u64);
    val cg_a1:   query.Revision = query.peek_revision(?s.queries, query.Q_CODEGEN, st_a::u64);
    val cg_b1:   query.Revision = query.peek_revision(?s.queries, query.Q_CODEGEN, st_b::u64);
    val lk_1:    query.Revision = query.peek_revision(?s.queries, query.Q_LINK, 0);
    if (tgt_1 == 0 || res_a1 == 0 || sema_a1 == 0 || low_a1 == 0 || cg_m1 == 0 || cg_a1 == 0 || cg_b1 == 0 || lk_1 == 0) { bad = 1; }
    val n_parse_1: u32 = ut_shard_len(?s, query.Q_PARSE);
    val n_sema_1:  u32 = ut_shard_len(?s, query.Q_SEMA);
    val n_low_1:   u32 = ut_shard_len(?s, query.Q_LOWER);
    val n_cg_1:    u32 = ut_shard_len(?s, query.Q_CODEGEN);

    rq.jobs = 4;
    val r2: R.Result[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, ?alloc, nil);
    if (R.is_err[outcome.BuildOutcome, outcome.Fail](r2)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    if (R.unwrap_ok[outcome.BuildOutcome, outcome.Fail](r2).severity != outcome.BUILD_OK) { bad = 1; }

    if (query.peek_revision(?s.queries, query.Q_TARGET,  0)           != tgt_1)   { bad = 1; }
    if (query.peek_revision(?s.queries, query.Q_RESOLVE, st_a::u64)    != res_a1)  { bad = 1; }
    if (query.peek_revision(?s.queries, query.Q_SEMA,    st_a::u64)    != sema_a1) { bad = 1; }
    if (query.peek_revision(?s.queries, query.Q_LOWER,   st_a::u64)    != low_a1)  { bad = 1; }
    if (query.peek_revision(?s.queries, query.Q_CODEGEN, st_main::u64) != cg_m1)   { bad = 1; }
    if (query.peek_revision(?s.queries, query.Q_CODEGEN, st_a::u64)    != cg_a1)   { bad = 1; }
    if (query.peek_revision(?s.queries, query.Q_CODEGEN, st_b::u64)    != cg_b1)   { bad = 1; }
    if (query.peek_revision(?s.queries, query.Q_LINK, 0)               != lk_1)    { bad = 1; }
    if (ut_shard_len(?s, query.Q_PARSE)   != n_parse_1) { bad = 1; }
    if (ut_shard_len(?s, query.Q_SEMA)    != n_sema_1)  { bad = 1; }
    if (ut_shard_len(?s, query.Q_LOWER)   != n_low_1)   { bad = 1; }
    if (ut_shard_len(?s, query.Q_CODEGEN) != n_cg_1)    { bad = 1; }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.build.engine.execute_warm:parallel_pool_rebuilds_only_stale_modules" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    if (R.is_err[R.Void, str](driver.setup_registry(?s.registry))) { session.dnit(?s); ret 1; }

    var names: [4]str;
    names[0] = "main.mach"; names[1] = "a.mach"; names[2] = "b.mach"; names[3] = "c.mach";
    var texts: [4]str;
    texts[0] = ut_cc3(?alloc, "use uniontest.a.fa;\nuse uniontest.b.fb;\nuse uniontest.c.fc;\n#[symbol(\"", ut_entry_symbol(), "\")]\nfun start() i32 { ret fa() + fb() + fc(); }\n");
    texts[1] = "pub fun fa() i32 { ret 1; }\n";
    texts[2] = "pub fun fb() i32 { ret 2; }\n";
    texts[3] = "pub fun fc() i32 { ret 3; }\n";
    val root_r: R.Result[str, str] = ut_scaffold(?alloc, ?names[0], ?texts[0], 4);
    if (R.is_err[str, str](root_r)) { session.dnit(?s); ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);

    val mr: R.Result[manifest.Manifest, str] = driver.load_manifest(?s, root);
    if (R.is_err[manifest.Manifest, str](mr)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    var m: manifest.Manifest = R.unwrap_ok[manifest.Manifest, str](mr);
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    rq.jobs         = 2;
    val pr: R.Result[bplan.BuildPlan, outcome.Fail] = bplan.plan(?alloc, ?s.interner, ?s.registry, ?m, rq);
    if (R.is_err[bplan.BuildPlan, outcome.Fail](pr)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    var bp: bplan.BuildPlan = R.unwrap_ok[bplan.BuildPlan, outcome.Fail](pr);

    var bad: i32 = 0;

    val r1: R.Result[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, ?alloc, nil);
    if (R.is_err[outcome.BuildOutcome, outcome.Fail](r1)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    val bo1: outcome.BuildOutcome = R.unwrap_ok[outcome.BuildOutcome, outcome.Fail](r1);
    if (bo1.severity != outcome.BUILD_OK)                { bad = 1; }
    if (bo1.artifacts.len != 1) { bad = 1; }
    or (!fs.is_file(bo1.artifacts.data[0].path)) { bad = 1; }

    val st_main: session.StableModuleId = ut_stable_of(?s, "uniontest.main");
    val st_a:    session.StableModuleId = ut_stable_of(?s, "uniontest.a");
    val st_b:    session.StableModuleId = ut_stable_of(?s, "uniontest.b");
    val st_c:    session.StableModuleId = ut_stable_of(?s, "uniontest.c");
    if (st_main == session.STABLE_MODULE_NIL || st_a == session.STABLE_MODULE_NIL
        || st_b == session.STABLE_MODULE_NIL || st_c == session.STABLE_MODULE_NIL) { bad = 1; }

    val cg_m_1: query.Revision = query.peek_revision(?s.queries, query.Q_CODEGEN, st_main::u64);
    val cg_a_1: query.Revision = query.peek_revision(?s.queries, query.Q_CODEGEN, st_a::u64);
    val cg_b_1: query.Revision = query.peek_revision(?s.queries, query.Q_CODEGEN, st_b::u64);
    val cg_c_1: query.Revision = query.peek_revision(?s.queries, query.Q_CODEGEN, st_c::u64);
    val lk_1:   query.Revision = query.peek_revision(?s.queries, query.Q_LINK, 0);
    if (cg_m_1 == 0 || cg_a_1 == 0 || cg_b_1 == 0 || cg_c_1 == 0 || lk_1 == 0) { bad = 1; }
    val n_cg_1: u32 = ut_shard_len(?s, query.Q_CODEGEN);

    val r2: R.Result[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, ?alloc, nil);
    if (R.is_err[outcome.BuildOutcome, outcome.Fail](r2)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    if (R.unwrap_ok[outcome.BuildOutcome, outcome.Fail](r2).severity != outcome.BUILD_OK) { bad = 1; }
    if (query.peek_revision(?s.queries, query.Q_CODEGEN, st_a::u64) != cg_a_1) { bad = 1; }
    if (query.peek_revision(?s.queries, query.Q_CODEGEN, st_c::u64) != cg_c_1) { bad = 1; }
    if (query.peek_revision(?s.queries, query.Q_LINK, 0)            != lk_1)   { bad = 1; }

    val src_dir: str = ut_cc3(?alloc, root, "/", "src");
    val a_path:  str = ut_cc3(?alloc, src_dir, "/", "a.mach");
    val c_path:  str = ut_cc3(?alloc, src_dir, "/", "c.mach");
    val a_v2: str = "pub fun fa() i32 { val t: i32 = 1; ret t; }\n";
    val c_v2: str = "pub fun fc() i32 { val t: i32 = 3; ret t; }\n";
    if (O.is_some[str](fs.write_bytes(a_path, a_v2, str_len(a_v2), 420))) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    if (O.is_some[str](fs.write_bytes(c_path, c_v2, str_len(c_v2), 420))) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }

    val r3: R.Result[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, ?alloc, nil);
    if (R.is_err[outcome.BuildOutcome, outcome.Fail](r3)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    val bo3: outcome.BuildOutcome = R.unwrap_ok[outcome.BuildOutcome, outcome.Fail](r3);
    if (bo3.severity != outcome.BUILD_OK) { bad = 1; }
    if (bo3.artifacts.len != 1) { bad = 1; }
    or (!fs.is_file(bo3.artifacts.data[0].path)) { bad = 1; }
    if (query.peek_revision(?s.queries, query.Q_CODEGEN, st_a::u64)    == cg_a_1) { bad = 1; }
    if (query.peek_revision(?s.queries, query.Q_CODEGEN, st_c::u64)    == cg_c_1) { bad = 1; }
    if (query.peek_revision(?s.queries, query.Q_CODEGEN, st_main::u64) != cg_m_1) { bad = 1; }
    if (query.peek_revision(?s.queries, query.Q_CODEGEN, st_b::u64)    != cg_b_1) { bad = 1; }
    if (query.peek_revision(?s.queries, query.Q_LINK, 0)               == lk_1)   { bad = 1; }
    if (ut_shard_len(?s, query.Q_CODEGEN) != n_cg_1) { bad = 1; }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

fun ut_scale_names(alloc: *A.Allocator, names: *str, texts: *str) {
    names[0] = "main.mach";
    var uses: str = "";
    var calls: str = "";
    var i: u32 = 1;
    for (i <= 8) {
        val idx: str = ut_u32_str(alloc, i);
        val nm:  str = ut_cc3(alloc, "m", idx, ".mach");
        names[i] = nm;
        val head:  str = ut_cc3(alloc, "pub fun f", idx, "() i32 {\n    val x: f64 = ");
        val mid:   str = ut_cc3(alloc, idx, ".25;\n    val y: f64 = x * 2.0 + 0.5;\n    var acc: i32 = 0;\n    var j: i32 = 0;\n    for (j < 40) {\n        acc = acc + j * 2;\n        j = j + 1;\n    }\n    ret acc + (y::i32) + ", idx);
        val body:  str = ut_cc3(alloc, head, mid, ";\n}\n");
        texts[i] = body;
        uses  = ut_cc3(alloc, uses,  "use scaletest.m", ut_cc3(alloc, idx, ".f", idx));
        uses  = ut_cc3(alloc, uses, ";\n", "");
        calls = ut_cc3(alloc, calls, "acc = acc + f", ut_cc3(alloc, idx, "();\n", ""));
        i = i + 1;
    }
    texts[0] = ut_cc3(alloc, uses, ut_cc3(alloc, "#[symbol(\"", ut_entry_symbol(), "\")]\n"),
        ut_cc3(alloc, "fun start() i32 {\n    var acc: i32 = 0;\n", calls, "    ret acc;\n}\n"));
}

fun ut_u32_str(alloc: *A.Allocator, v: u32) str {
    var digits: [10]u8;
    var n: u32 = 0;
    var t: u32 = v;
    if (t == 0) { digits[0] = '0'; n = 1; }
    for (t > 0) { digits[n] = ('0'::u32 + (t % 10))::u8; t = t / 10; n = n + 1; }
    val r: R.Result[*u8, str] = A.allocate[u8](alloc, (n + 1)::usize);
    if (R.is_err[*u8, str](r)) { ret "0"; }
    val buf: *u8 = R.unwrap_ok[*u8, str](r);
    var i: u32 = 0;
    for (i < n) { buf[i] = digits[n - 1 - i]; i = i + 1; }
    buf[n] = 0;
    ret buf::str;
}

fun ut_build_scale(alloc: *A.Allocator, root: str, jobs: u32, out_bytes: *Vector[u8]) i32 {
    val sr: R.Result[session.Session, str] = session.init(alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    if (R.is_err[R.Void, str](driver.setup_registry(?s.registry))) { session.dnit(?s); ret 1; }

    val mr: R.Result[manifest.Manifest, str] = driver.load_manifest(?s, root);
    if (R.is_err[manifest.Manifest, str](mr)) { session.dnit(?s); ret 1; }
    var m: manifest.Manifest = R.unwrap_ok[manifest.Manifest, str](mr);
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    rq.jobs          = jobs;
    rq.opt            = pipeline.OPT_RELEASE;
    rq.debug          = true;
    val pr: R.Result[bplan.BuildPlan, outcome.Fail] = bplan.plan(alloc, ?s.interner, ?s.registry, ?m, rq);
    if (R.is_err[bplan.BuildPlan, outcome.Fail](pr)) { session.dnit(?s); ret 1; }
    var bp: bplan.BuildPlan = R.unwrap_ok[bplan.BuildPlan, outcome.Fail](pr);

    val r: R.Result[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, alloc, nil);
    if (R.is_err[outcome.BuildOutcome, outcome.Fail](r)) { session.dnit(?s); ret 1; }
    val bo: outcome.BuildOutcome = R.unwrap_ok[outcome.BuildOutcome, outcome.Fail](r);
    if (bo.severity != outcome.BUILD_OK || bo.artifacts.len != 1) { session.dnit(?s); ret 1; }
    if (!fs.is_file(bo.artifacts.data[0].path)) { session.dnit(?s); ret 1; }

    val rb: R.Result[Vector[u8], str] = fs.read_bytes(alloc, bo.artifacts.data[0].path);
    if (R.is_err[Vector[u8], str](rb)) { session.dnit(?s); ret 1; }
    @out_bytes = R.unwrap_ok[Vector[u8], str](rb);

    session.dnit(?s);
    ret 0;
}

fun ut_manifest_scale() str {
    ret "[project]\nid = \"scaletest\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.linux]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[artifact.scaletest]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/scaletest\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
}

test "mach.lang.build.engine.execute_warm:worker_count_does_not_change_the_artifact" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }

    var names: [9]str;
    var texts: [9]str;
    ut_scale_names(?alloc, ?names[0], ?texts[0]);
    val root_r: R.Result[str, str] = ut_scaffold_m(?alloc, ut_manifest_scale(), ?names[0], ?texts[0], 9);
    if (R.is_err[str, str](root_r)) { ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);

    var b1: Vector[u8];
    val c1: i32 = ut_build_scale(?alloc, root, 1::u32, ?b1);
    if (c1 != 0) { fs.remove_all(?alloc, root); ret 1; }
    var b6: Vector[u8];
    val c6: i32 = ut_build_scale(?alloc, root, 6::u32, ?b6);
    fs.remove_all(?alloc, root);
    if (c6 != 0) { ret 1; }

    if (b1.len != b6.len) { ret 1; }
    var i: usize = 0;
    for (i < b1.len) {
        if (b1.data[i] != b6.data[i]) { ret 1; }
        i = i + 1;
    }
    ret 0;
}

test "mach.lang.build.engine.execute_warm:replaced_image_owns_section_bytes" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    if (R.is_err[R.Void, str](driver.setup_registry(?s.registry))) { session.dnit(?s); ret 1; }

    val LIT: str = "warm-owned-section-bytes";

    var names: [3]str;
    names[0] = "main.mach"; names[1] = "a.mach"; names[2] = "b.mach";
    var texts: [3]str;
    texts[0] = ut_cc3(?alloc, "use uniontest.a.greeting;\n#[symbol(\"", ut_entry_symbol(), "\")]\nfun start() i32 { if (greeting[0] == 'w') { ret 0; } ret 1; }\n");
    texts[1] = "use uniontest.b.fb;\npub val greeting: *u8 = \"warm-owned-section-bytes\";\npub fun fa() i32 { ret fb(); }\n";
    texts[2] = "pub fun fb() i32 { ret 2; }\n";
    val root_r: R.Result[str, str] = ut_scaffold(?alloc, ?names[0], ?texts[0], 3);
    if (R.is_err[str, str](root_r)) { session.dnit(?s); ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);

    val mr: R.Result[manifest.Manifest, str] = driver.load_manifest(?s, root);
    if (R.is_err[manifest.Manifest, str](mr)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    var m: manifest.Manifest = R.unwrap_ok[manifest.Manifest, str](mr);
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    val pr: R.Result[bplan.BuildPlan, outcome.Fail] = bplan.plan(?alloc, ?s.interner, ?s.registry, ?m, rq);
    if (R.is_err[bplan.BuildPlan, outcome.Fail](pr)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    var bp: bplan.BuildPlan = R.unwrap_ok[bplan.BuildPlan, outcome.Fail](pr);

    var bad: i32 = 0;

    val r1: R.Result[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, ?alloc, nil);
    if (R.is_err[outcome.BuildOutcome, outcome.Fail](r1)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    if (R.unwrap_ok[outcome.BuildOutcome, outcome.Fail](r1).severity != outcome.BUILD_OK) { bad = 1; }

    val src_dir: str = ut_cc3(?alloc, root, "/", "src");
    val b_path:  str = ut_cc3(?alloc, src_dir, "/", "b.mach");
    val b_v2:    str = "pub fun fb() i32 { ret 2; }\npub fun fb2() i32 { ret 3; }\n";
    if (O.is_some[str](fs.write_bytes(b_path, b_v2, str_len(b_v2), 420))) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }

    val r2: R.Result[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, ?alloc, nil);
    if (R.is_err[outcome.BuildOutcome, outcome.Fail](r2)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    if (R.unwrap_ok[outcome.BuildOutcome, outcome.Fail](r2).severity != outcome.BUILD_OK) { bad = 1; }

    val id_r: R.Result[intern.StrId, str] = intern.intern(?s.interner, LIT);
    if (R.is_err[intern.StrId, str](id_r)) { bad = 1; }
    or {
        val lo: O.Option[str] = intern.lookup(?s.interner, R.unwrap_ok[intern.StrId, str](id_r));
        if (O.is_none[str](lo)) { bad = 1; }
        or (!str_equals(O.unwrap[str](lo), LIT)) { bad = 1; }
    }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

fun ut_outcome_fail_count(bo: *outcome.BuildOutcome) u32 {
    var total: u32 = 0;
    var i: usize = 0;
    for (i < bo.events.len) {
        if (bo.events.data[i].kind == outcome.BUILD_EVENT_FAIL) { total = total + 1; }
        i = i + 1;
    }
    ret total;
}

fun ut_outcome_contains(bo: *outcome.BuildOutcome, needle: str) bool {
    var i: usize = 0;
    for (i < bo.events.len) {
        val ev: *outcome.BuildEvent = ?bo.events.data[i];
        if (ev.kind == outcome.BUILD_EVENT_FAIL) {
            if (ev.data.fail.message != nil && ut_str_contains(ev.data.fail.message, needle)) { ret true; }
        }
        or (ev.kind == outcome.BUILD_EVENT_DIAGNOSTICS) {
            var d: usize = 0;
            for (d < ev.data.diagnostics.diags.items.len) {
                if (ut_str_contains(ev.data.diagnostics.diags.items.data[d].message, needle)) { ret true; }
                d = d + 1;
            }
            var f: usize = 1;
            for (f < ev.data.diagnostics.sources.len) {
                if (ut_str_contains(ev.data.diagnostics.sources.files[f].path, needle)) { ret true; }
                f = f + 1;
            }
        }
        i = i + 1;
    }
    ret false;
}

fun ut_manifest_two_bins() str {
    ret "[project]\nid = \"uniontest\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.linux]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[target.windows]\nisa = \"x86_64\"\nos = \"windows\"\nabi = \"win64\"\n\n[target.linux-arm64]\nisa = \"aarch64\"\nos = \"linux\"\nabi = \"aapcs64\"\n\n[target.linux-riscv64]\nisa = \"riscv64\"\nos = \"linux\"\nabi = \"lp64d\"\n\n[target.darwin-x86_64]\nisa = \"x86_64\"\nos = \"darwin\"\nabi = \"sysv64\"\n\n[target.darwin-arm64]\nisa = \"aarch64\"\nos = \"darwin\"\nabi = \"aapcs64\"\n\n[artifact.alpha]\nkind = \"bin\"\nentry = \"alpha.mach\"\nout = \"bin/alpha\"\ntargets = [\"*\"]\nlink = []\nneed = []\n\n[artifact.beta]\nkind = \"bin\"\nentry = \"beta.mach\"\nout = \"bin/beta\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
}

test "mach.lang.build.engine.execute_warm_all:two_artifacts_both_link" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    if (R.is_err[R.Void, str](driver.setup_registry(?s.registry))) { session.dnit(?s); ret 1; }

    var names: [2]str;
    names[0] = "alpha.mach"; names[1] = "beta.mach";
    var texts: [2]str;
    texts[0] = ut_cc3(?alloc, "#[symbol(\"", ut_entry_symbol(), "\")]\nfun sa() i32 { ret 1; }\n");
    texts[1] = ut_cc3(?alloc, "#[symbol(\"", ut_entry_symbol(), "\")]\nfun sb() i32 { ret 2; }\n");
    val root_r: R.Result[str, str] = ut_scaffold_m(?alloc, ut_manifest_two_bins(), ?names[0], ?texts[0], 2);
    if (R.is_err[str, str](root_r)) { session.dnit(?s); ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);

    val mr: R.Result[manifest.Manifest, str] = driver.load_manifest(?s, root);
    if (R.is_err[manifest.Manifest, str](mr)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    var m: manifest.Manifest = R.unwrap_ok[manifest.Manifest, str](mr);

    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    val pr: R.Result[bplan.BuildPlan, outcome.Fail] = bplan.plan(?alloc, ?s.interner, ?s.registry, ?m, rq);
    if (R.is_err[bplan.BuildPlan, outcome.Fail](pr)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    var bp: bplan.BuildPlan = R.unwrap_ok[bplan.BuildPlan, outcome.Fail](pr);

    var bad: i32 = 0;
    if (bp.units.len != 2) { bad = 1; }

    val r: R.Result[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm_all(?bp, ?s, ?alloc, nil);
    if (R.is_err[outcome.BuildOutcome, outcome.Fail](r)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    val bo: outcome.BuildOutcome = R.unwrap_ok[outcome.BuildOutcome, outcome.Fail](r);

    if (bo.severity != outcome.BUILD_OK)                { bad = 1; }
    if (bo.artifacts.len != 2) { bad = 1; }
    or {
        if (!fs.is_file(bo.artifacts.data[0].path)) { bad = 1; }
        if (!fs.is_file(bo.artifacts.data[1].path)) { bad = 1; }
        if (!ut_str_contains(bo.artifacts.data[0].path, "alpha")) { bad = 1; }
        if (!ut_str_contains(bo.artifacts.data[1].path, "beta"))  { bad = 1; }
        if (ut_str_contains(bo.artifacts.data[0].path, "beta"))   { bad = 1; }
    }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.build.engine.execute_warm:bin_name_keys_the_artifact_cache" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    if (R.is_err[R.Void, str](driver.setup_registry(?s.registry))) { session.dnit(?s); ret 1; }

    var names: [3]str;
    names[0] = "alpha.mach"; names[1] = "beta.mach"; names[2] = "shared.mach";
    var texts: [3]str;
    texts[0] = ut_cc3(?alloc, "use uniontest.shared.sh;\n#[symbol(\"", ut_entry_symbol(), "\")]\nfun sa() i32 { ret sh(); }\n");
    texts[1] = ut_cc3(?alloc, "use uniontest.shared.sh;\n#[symbol(\"", ut_entry_symbol(), "\")]\nfun sb() i32 { ret sh(); }\n");
    texts[2] = "pub fun sh() i32 { $if ($bin.name == \"alpha\") { ret 111; } ret 222; }\n";
    val root_r: R.Result[str, str] = ut_scaffold_m(?alloc, ut_manifest_two_bins(), ?names[0], ?texts[0], 3);
    if (R.is_err[str, str](root_r)) { session.dnit(?s); ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);

    val mr: R.Result[manifest.Manifest, str] = driver.load_manifest(?s, root);
    if (R.is_err[manifest.Manifest, str](mr)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    var m: manifest.Manifest = R.unwrap_ok[manifest.Manifest, str](mr);
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    val pr: R.Result[bplan.BuildPlan, outcome.Fail] = bplan.plan(?alloc, ?s.interner, ?s.registry, ?m, rq);
    if (R.is_err[bplan.BuildPlan, outcome.Fail](pr)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    var bp: bplan.BuildPlan = R.unwrap_ok[bplan.BuildPlan, outcome.Fail](pr);

    var bad: i32 = 0;
    if (bp.units.len != 2) { bad = 1; }

    val r0: R.Result[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, ?alloc, nil);
    if (R.is_err[outcome.BuildOutcome, outcome.Fail](r0)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    val bo0: outcome.BuildOutcome = R.unwrap_ok[outcome.BuildOutcome, outcome.Fail](r0);
    val r1: R.Result[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 1, ?s, ?alloc, nil);
    if (R.is_err[outcome.BuildOutcome, outcome.Fail](r1)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    val bo1: outcome.BuildOutcome = R.unwrap_ok[outcome.BuildOutcome, outcome.Fail](r1);

    if (bo0.severity != outcome.BUILD_OK || bo1.severity != outcome.BUILD_OK)                               { bad = 1; }
    if (bo0.artifacts.len != 1 || bo1.artifacts.len != 1) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }

    val f0: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, bo0.artifacts.data[0].path);
    val f1: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, bo1.artifacts.data[0].path);
    if (R.is_err[Vector[u8], str](f0) || R.is_err[Vector[u8], str](f1)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    val v0: Vector[u8] = R.unwrap_ok[Vector[u8], str](f0);
    val v1: Vector[u8] = R.unwrap_ok[Vector[u8], str](f1);

    var differ: bool = false;
    if (v0.len != v1.len) { differ = true; }
    or {
        var i: usize = 0;
        for (i < v0.len) {
            if (v0.data[i] != v1.data[i]) { differ = true; brk; }
            i = i + 1;
        }
    }
    if (!differ) { bad = 1; }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.build.engine.execute_warm:unit_failure_is_owned_after_teardown" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    if (R.is_err[R.Void, str](driver.setup_registry(?s.registry))) { session.dnit(?s); ret 1; }

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "#[symbol(\"_start\")]\nfun start() i32 { ret 0; }\n";
    val root_r: R.Result[str, str] = ut_scaffold(?alloc, ?names[0], ?texts[0], 1);
    if (R.is_err[str, str](root_r)) { session.dnit(?s); ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);

    val mr: R.Result[manifest.Manifest, str] = driver.load_manifest(?s, root);
    if (R.is_err[manifest.Manifest, str](mr)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    var m: manifest.Manifest = R.unwrap_ok[manifest.Manifest, str](mr);
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    val pr: R.Result[bplan.BuildPlan, outcome.Fail] = bplan.plan(?alloc, ?s.interner, ?s.registry, ?m, rq);
    if (R.is_err[bplan.BuildPlan, outcome.Fail](pr)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    var bp: bplan.BuildPlan = R.unwrap_ok[bplan.BuildPlan, outcome.Fail](pr);

    val mf: str = ut_cc3(?alloc, root, "/", manifest.MANIFEST_FILE);
    val broken: str = "[project]\nid = \"uniontest\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out\"\nbogus_key = 1\n";
    if (O.is_some[str](fs.write_bytes(mf, broken, str_len(broken), 420))) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }

    var bad: i32 = 0;
    val r: R.Result[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, ?alloc, nil);
    session.dnit(?s);
    if (R.is_err[outcome.BuildOutcome, outcome.Fail](r)) { bad = 1; }
    or {
        var bo: outcome.BuildOutcome = R.unwrap_ok[outcome.BuildOutcome, outcome.Fail](r);
        if (bo.severity == outcome.BUILD_OK)       { bad = 1; }
        if (bo.severity == outcome.BUILD_INTERNAL) { bad = 1; }
        if (ut_outcome_fail_count(?bo) != 1)       { bad = 1; }
        if (!ut_outcome_contains(?bo, "bogus_key")) { bad = 1; }
        outcome.outcome_dnit(?bo);
    }

    fs.remove_all(?alloc, root);
    ret bad;
}

test "mach.lang.driver:inline_asm_unknown_mnemonic_located" {
    var bad: i32 = 0;
    val src: str = "#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 {\n    $if ($mach.build.arch == $mach.arch.x86_64) { asm x86_64 { frobnicate } }\n    $or ($mach.build.arch == $mach.arch.aarch64) { asm aarch64 { frobnicate } }\n    $or { asm riscv64 { frobnicate } }\n    ret 0;\n}\n";
    if (ut_codegen_rejects(src, "'frobnicate'") != 0) { bad = 1; }
    if (ut_codegen_rejects(src, "main.mach:") != 0)   { bad = 1; }
    $if ($mach.build.arch == $mach.arch.x86_64) {
        if (ut_codegen_rejects("#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 {\n    asm x86_64 { frobnicate }\n    ret 0;\n}\n",
            "main.mach:3:5: unknown x86_64 inline-asm instruction 'frobnicate'") != 0) { bad = 1; }
    }
    ret bad;
}

test "mach.lang.build.engine.execute_warm:pool_error_message_survives_teardown" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    if (R.is_err[R.Void, str](driver.setup_registry(?s.registry))) { session.dnit(?s); ret 1; }

    var names: [4]str;
    names[0] = "main.mach"; names[1] = "a.mach"; names[2] = "b.mach"; names[3] = "c.mach";
    var texts: [4]str;
    texts[0] = ut_cc3(?alloc, "use uniontest.a.fa;\nuse uniontest.b.fb;\nuse uniontest.c.fc;\n#[symbol(\"", ut_entry_symbol(), "\")]\nfun start() i32 { ret fa() + fb() + fc(); }\n");
    texts[1] = "pub fun fa() i32 { ret 1; }\n";
    texts[2] = "pub fun fb() i32 { ret 2; }\n";
    texts[3] = "pub fun fc() i32 {\n    $if ($mach.build.arch == $mach.arch.x86_64) { asm x86_64 { frobnicate } }\n    $or ($mach.build.arch == $mach.arch.aarch64) { asm aarch64 { frobnicate } }\n    $or { asm riscv64 { frobnicate } }\n    ret 3;\n}\n";
    val root_r: R.Result[str, str] = ut_scaffold(?alloc, ?names[0], ?texts[0], 4);
    if (R.is_err[str, str](root_r)) { session.dnit(?s); ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);

    val mr: R.Result[manifest.Manifest, str] = driver.load_manifest(?s, root);
    if (R.is_err[manifest.Manifest, str](mr)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    var m: manifest.Manifest = R.unwrap_ok[manifest.Manifest, str](mr);
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    rq.jobs         = 2;
    val pr: R.Result[bplan.BuildPlan, outcome.Fail] = bplan.plan(?alloc, ?s.interner, ?s.registry, ?m, rq);
    if (R.is_err[bplan.BuildPlan, outcome.Fail](pr)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    var bp: bplan.BuildPlan = R.unwrap_ok[bplan.BuildPlan, outcome.Fail](pr);

    var bad: i32 = 0;
    val r: R.Result[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, ?alloc, nil);
    session.dnit(?s);
    if (R.is_err[outcome.BuildOutcome, outcome.Fail](r)) { bad = 1; }
    or {
        var bo: outcome.BuildOutcome = R.unwrap_ok[outcome.BuildOutcome, outcome.Fail](r);
        if (bo.severity == outcome.BUILD_OK) { bad = 1; }
        if (ut_outcome_fail_count(?bo) != 1) { bad = 1; }
        if (!ut_outcome_contains(?bo, "'frobnicate'")) { bad = 1; }
        if (!ut_outcome_contains(?bo, "c.mach"))       { bad = 1; }
        outcome.outcome_dnit(?bo);
    }

    fs.remove_all(?alloc, root);
    ret bad;
}

fun ut_ro_mod_text() str {
    ret "pub fun f0(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 1; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\npub fun f1(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 2; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\npub fun f2(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 3; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\npub fun f3(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 4; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\npub fun f4(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 5; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\npub fun f5(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 6; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\npub fun f6(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 7; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\npub fun f7(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 8; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\npub fun f8(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 9; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\npub fun f9(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 10; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\npub fun f10(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 11; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\npub fun f11(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 12; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\npub fun f12(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 13; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\npub fun f13(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 14; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\npub fun f14(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 15; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\npub fun f15(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 16; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\npub fun f16(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 17; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\npub fun f17(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 18; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\npub fun f18(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 19; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\npub fun f19(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 20; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\n";
}

fun ut_ro_main_text(alloc: *A.Allocator) str {
    ret ut_cc3(alloc, "use uniontest.rm0;\nuse uniontest.rm1;\nuse uniontest.rm2;\nuse uniontest.rm3;\nuse uniontest.rm4;\nuse uniontest.rm5;\nuse uniontest.rm6;\nuse uniontest.rm7;\nuse uniontest.rm8;\nuse uniontest.rm9;\nuse uniontest.rm10;\nuse uniontest.rm11;\nuse uniontest.rm12;\nuse uniontest.rm13;\nuse uniontest.rm14;\nuse uniontest.rm15;\n\n#[symbol(\"", ut_entry_symbol(), "\")]\nfun start() i32 {\n    var t: i32 = 1;\n    t = t + rm0.f0(t + 0);\n    t = t + rm1.f1(t + 1);\n    t = t + rm2.f2(t + 2);\n    t = t + rm3.f3(t + 3);\n    t = t + rm4.f4(t + 4);\n    t = t + rm5.f5(t + 5);\n    t = t + rm6.f6(t + 6);\n    t = t + rm7.f7(t + 7);\n    t = t + rm8.f8(t + 8);\n    t = t + rm9.f9(t + 9);\n    t = t + rm10.f10(t + 10);\n    t = t + rm11.f11(t + 11);\n    t = t + rm12.f12(t + 12);\n    t = t + rm13.f13(t + 13);\n    t = t + rm14.f14(t + 14);\n    t = t + rm15.f15(t + 15);\n    ret t;\n}\n");
}

fun ut_ro_files(alloc: *A.Allocator, names: *str, texts: *str) {
    names[0] = "main.mach";
    texts[0] = ut_ro_main_text(alloc);
    val body: str = ut_ro_mod_text();
    names[1] = "rm0.mach"; texts[1] = body;
    names[2] = "rm1.mach"; texts[2] = body;
    names[3] = "rm2.mach"; texts[3] = body;
    names[4] = "rm3.mach"; texts[4] = body;
    names[5] = "rm4.mach"; texts[5] = body;
    names[6] = "rm5.mach"; texts[6] = body;
    names[7] = "rm6.mach"; texts[7] = body;
    names[8] = "rm7.mach"; texts[8] = body;
    names[9] = "rm8.mach"; texts[9] = body;
    names[10] = "rm9.mach"; texts[10] = body;
    names[11] = "rm10.mach"; texts[11] = body;
    names[12] = "rm11.mach"; texts[12] = body;
    names[13] = "rm12.mach"; texts[13] = body;
    names[14] = "rm13.mach"; texts[14] = body;
    names[15] = "rm14.mach"; texts[15] = body;
    names[16] = "rm15.mach"; texts[16] = body;
}

fun ut_readout_rows_case(jobs: u32) i32 {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    if (R.is_err[R.Void, str](driver.setup_registry(?s.registry))) { session.dnit(?s); ret 1; }

    var names: [17]str;
    var texts: [17]str;
    ut_ro_files(?alloc, ?names[0], ?texts[0]);

    val root_r: R.Result[str, str] = ut_scaffold(?alloc, ?names[0], ?texts[0], 17);
    if (R.is_err[str, str](root_r)) { session.dnit(?s); ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);

    val mr: R.Result[manifest.Manifest, str] = driver.load_manifest(?s, root);
    if (R.is_err[manifest.Manifest, str](mr)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    var m: manifest.Manifest = R.unwrap_ok[manifest.Manifest, str](mr);
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    rq.jobs         = jobs;
    val pr_r: R.Result[bplan.BuildPlan, outcome.Fail] = bplan.plan(?alloc, ?s.interner, ?s.registry, ?m, rq);
    if (R.is_err[bplan.BuildPlan, outcome.Fail](pr_r)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    var bp: bplan.BuildPlan = R.unwrap_ok[bplan.BuildPlan, outcome.Fail](pr_r);

    var ev: readout.Progress;
    readout.init(?ev, ?alloc, readout.LEVEL_PHASES);

    val t0: ctime.Time = ctime.monotonic();
    readout.unit_begin(?ev);
    val r: R.Result[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, ?alloc, ?ev);
    val wall: cdur.Duration = ctime.time_sub(ctime.monotonic(), t0);

    var bad: i32 = 0;
    if (R.is_err[outcome.BuildOutcome, outcome.Fail](r)) { bad = 1; }
    or {
        val bo: outcome.BuildOutcome = R.unwrap_ok[outcome.BuildOutcome, outcome.Fail](r);
        if (bo.severity != outcome.BUILD_OK)                { bad = 1; }
        if (bo.artifacts.len != 1) { bad = 1; }
    }

    var phs: [8]u8;
    phs[0] = readout.PH_LOAD;
    phs[1] = readout.PH_RESOLVE;
    phs[2] = readout.PH_SEMA;
    phs[3] = readout.PH_LOWER;
    phs[4] = readout.PH_OPTIMIZE;
    phs[5] = readout.PH_CODEGEN;
    phs[6] = readout.PH_EMIT;
    phs[7] = readout.PH_LINK;

    var sum: cdur.Duration = 0;
    var i: u32 = 0;
    for (i < 8) {
        val ph: u32 = phs[i]::u32;
        val pm: *readout.PhaseMetrics = ?ev.metrics[ph];
        if (pm.occurrences != 1)  { bad = 1; }
        if (pm.elapsed <= 0)      { bad = 1; }
        if (pm.item_count == 0)   { bad = 1; }
        if (pm.item_elapsed <= 0) { bad = 1; }
        if (pm.workers == 0)      { bad = 1; }

        if (pm.elapsed * pm.workers::cdur.Duration < pm.item_elapsed) { bad = 1; }

        if (ph != readout.PH_EMIT::u32 && ph != readout.PH_LINK::u32) {
            if (pm.item_elapsed * 8 < pm.elapsed) { bad = 1; }
        }

        sum = sum + pm.elapsed;
        i = i + 1;
    }

    if (ev.other < 0) { bad = 1; }
    val acc: cdur.Duration = sum + ev.other;
    if (acc > wall)     { bad = 1; }
    if (acc * 2 < wall) { bad = 1; }

    readout.dnit(?ev);
    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.readout:serial_build_rows_are_one_per_phase_and_bound_their_work" {
    ret ut_readout_rows_case(0);
}

test "mach.lang.readout:pooled_build_rows_are_one_per_phase_and_bound_their_work" {
    ret ut_readout_rows_case(4);
}

test "mach.lang.readout:the_monotonic_clock_runs" {
    val t0: ctime.Time = ctime.monotonic();
    if (t0.sec == 0 && t0.nsec == 0) { ret 1; }

    var acc: i64 = 1;
    var i:   i64 = 0;
    for (i < 1000000) {
        acc = (acc * 31 + i) % 1000003;
        i = i + 1;
    }
    if (acc < 0) { ret 1; }

    if (ctime.time_sub(ctime.monotonic(), t0) <= 0) { ret 1; }
    ret 0;
}

test "mach.lang.build.engine.execute_warm:sema_phase_diagnostic_fails_build" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    if (R.is_err[R.Void, str](driver.setup_registry(?s.registry))) { session.dnit(?s); ret 1; }

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = ut_cc3(?alloc, "#[symbol(\"", ut_entry_symbol(), "\")]\nfun start() i32 { val x: u32 = \"not a u32\"; ret 0; }\n");
    val root_r: R.Result[str, str] = ut_scaffold(?alloc, ?names[0], ?texts[0], 1);
    if (R.is_err[str, str](root_r)) { session.dnit(?s); ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);

    val mr: R.Result[manifest.Manifest, str] = driver.load_manifest(?s, root);
    if (R.is_err[manifest.Manifest, str](mr)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    var m: manifest.Manifest = R.unwrap_ok[manifest.Manifest, str](mr);
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    val pr: R.Result[bplan.BuildPlan, outcome.Fail] = bplan.plan(?alloc, ?s.interner, ?s.registry, ?m, rq);
    if (R.is_err[bplan.BuildPlan, outcome.Fail](pr)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    var bp: bplan.BuildPlan = R.unwrap_ok[bplan.BuildPlan, outcome.Fail](pr);

    var bad: i32 = 0;
    val r: R.Result[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, ?alloc, nil);
    if (R.is_err[outcome.BuildOutcome, outcome.Fail](r)) { bad = 1; }
    or {
        val bo: outcome.BuildOutcome = R.unwrap_ok[outcome.BuildOutcome, outcome.Fail](r);
        if (bo.severity == outcome.BUILD_OK)                 { bad = 1; }
        if (bo.artifacts.len != 0) { bad = 1; }
    }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

fun ut_lower_n(s: *session.Session, alloc: *A.Allocator, names: *str, texts: *str, n: u32) R.Result[project.Project, outcome.Fail] {
    val root_r: R.Result[str, str] = ut_scaffold(alloc, names, texts, n);
    if (R.is_err[str, str](root_r)) { ret R.err[project.Project, outcome.Fail](outcome.user(R.unwrap_err[str, str](root_r))); }
    val root: str = R.unwrap_ok[str, str](root_r);
    val rr: R.Result[R.Void, str] = driver.setup_registry(?s.registry);
    if (R.is_err[R.Void, str](rr)) { fs.remove_all(alloc, root); ret R.err[project.Project, outcome.Fail](outcome.user(R.unwrap_err[R.Void, str](rr))); }
    var tsel_11572: manifest.Selection = ut_target_sel("linux");
    val pr: R.Result[project.Project, outcome.Fail] = driver.build_project(s, root, ?tsel_11572);
    fs.remove_all(alloc, root);
    if (R.is_err[project.Project, outcome.Fail](pr)) { ret pr; }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);
    val se: R.Result[R.Void, outcome.Fail] = passes.run_sema_pass(?p);
    if (R.is_err[R.Void, outcome.Fail](se)) { project.dnit_project(?p); ret R.err[project.Project, outcome.Fail](R.unwrap_err[R.Void, outcome.Fail](se)); }
    val le: R.Result[R.Void, outcome.Fail] = passes.run_lower_pass(?p);
    if (R.is_err[R.Void, outcome.Fail](le)) { project.dnit_project(?p); ret R.err[project.Project, outcome.Fail](R.unwrap_err[R.Void, outcome.Fail](le)); }
    ret R.ok[project.Project, outcome.Fail](p);
}

fun ut_ir_of(p: *project.Project, s: *session.Session, fqn: str) *ir.Module {
    val mid: session.ModuleId = ut_mid(p, s, fqn);
    if (mid == session.MODULE_NIL) { ret nil; }
    ret p.modules[mid::u32].ir_module;
}

fun ut_const_uses(m: *ir.Module, want: u64) u32 {
    ret ut_operand_uses(m, value.VAL_CONST_INT, want);
}

fun ut_operand_uses(m: *ir.Module, kind: value.ValueKind, want: u64) u32 {
    if (m == nil) { ret 0; }
    var hits: u32 = 0;
    var fi: u32 = 0;
    for (fi < m.function_len) {
        val f: *ir.Function = ?m.functions[fi];
        var bi: u32 = 0;
        for (bi < f.block_count) {
            val b: *ir.Block = ?f.blocks[bi];
            var k: u32 = 0;
            for (k < b.phi_count) {
                hits = hits + ut_instr_uses(f, b.phis[k], kind, want);
                k = k + 1;
            }
            k = 0;
            for (k < b.instr_count) {
                hits = hits + ut_instr_uses(f, b.instructions[k], kind, want);
                k = k + 1;
            }
            hits = hits + ut_instr_uses(f, b.terminator, kind, want);
            bi = bi + 1;
        }
        fi = fi + 1;
    }
    ret hits;
}

fun ut_instr_uses(f: *ir.Function, iid: ir.InstructionId, kind: value.ValueKind, want: u64) u32 {
    val opt_ins: O.Option[*instruction.Instruction] = ir.instruction_get(f, iid);
    if (O.is_none[*instruction.Instruction](opt_ins)) { ret 0; }
    val ins: *instruction.Instruction = O.unwrap[*instruction.Instruction](opt_ins);
    var hits: u32 = 0;
    var oi: u32 = 0;
    for (oi < ins.operand_count) {
        val v: *value.Value = ?ins.operands[oi];
        if (v.kind == kind) {
            if (kind == value.VAL_CONST_INT && v.data.int_lit == want)        { hits = hits + 1; }
            if (kind == value.VAL_GLOBAL && v.data.global_ix::u64 == want)    { hits = hits + 1; }
        }
        oi = oi + 1;
    }
    ret hits;
}

fun ut_global_ix(s: *session.Session, m: *ir.Module, needle: str) i64 {
    if (m == nil) { ret -1; }
    var gi: u32 = 0;
    for (gi < m.global_len) {
        val nm: O.Option[str] = intern.lookup(?s.interner, (?m.globals[gi]).name);
        if (O.is_some[str](nm) && ut_str_contains(O.unwrap[str](nm), needle)) { ret gi::i64; }
        gi = gi + 1;
    }
    ret -1;
}

fun ut_global_uses(m: *ir.Module, gi: u32) u32 {
    ret ut_operand_uses(m, value.VAL_GLOBAL, gi::u64);
}

fun ut_has_extern_global(s: *session.Session, m: *ir.Module, needle: str) bool {
    if (m == nil) { ret false; }
    var gi: u32 = 0;
    for (gi < m.global_len) {
        val g: *ir.Global = ?m.globals[gi];
        if (g.is_extern) {
            val nm: O.Option[str] = intern.lookup(?s.interner, g.name);
            if (O.is_some[str](nm) && ut_str_contains(O.unwrap[str](nm), needle)) { ret true; }
        }
        gi = gi + 1;
    }
    ret false;
}

fun ut_has_extern_fn(s: *session.Session, m: *ir.Module, needle: str) bool {
    if (m == nil) { ret false; }
    var fi: u32 = 0;
    for (fi < m.function_len) {
        val f: *ir.Function = ?m.functions[fi];
        if ((f.flags & ir.FN_FLAG_EXTERN) != 0) {
            val nm: O.Option[str] = intern.lookup(?s.interner, f.name);
            if (O.is_some[str](nm) && ut_str_contains(O.unwrap[str](nm), needle)) { ret true; }
        }
        fi = fi + 1;
    }
    ret false;
}

test "mach.lang.driver:qualified_const_ignores_local_val_shadow" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    var names: [3]str;
    names[0] = "main.mach"; names[1] = "a.mach"; names[2] = "b.mach";
    var texts: [3]str;
    texts[0] = "use uniontest.a;\nuse uniontest.b;\nval X: i64 = 707;\npub fun p1() i64 { ret a.X; }\npub fun p2() i64 { ret X; }\npub fun p3() i64 { ret b.Y; }\nfun main() i32 { ret 0; }\n";
    texts[1] = "pub val X: i64 = 909;\n";
    texts[2] = "pub val Y: i64 = 505;\n";

    val pr: R.Result[project.Project, outcome.Fail] = ut_lower_n(?s, ?alloc, ?names[0], ?texts[0], 3);
    if (R.is_err[project.Project, outcome.Fail](pr)) { session.dnit(?s); ret 1; }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);

    var bad: i32 = 0;
    val m: *ir.Module = ut_ir_of(?p, ?s, "uniontest.main");
    if (m == nil) { bad = 1; }
    or {
        if (ut_const_uses(m, 909) != 1) { bad = 1; }
        if (ut_const_uses(m, 707) != 1) { bad = 1; }

        val gx: i64 = ut_global_ix(?s, m, "uniontest.main.X");
        if (gx < 0) { bad = 1; }
        or {
            if (ut_global_uses(m, gx::u32) != 0)                        { bad = 1; }
            if ((?m.globals[gx::u32]).init.data.int_lit != 707)         { bad = 1; }
        }

        if (ut_const_uses(m, 505) != 1) { bad = 1; }
    }

    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

