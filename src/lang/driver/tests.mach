}

fun ut_ct_edge_manifest() str {
    ret "[project]\nid = \"ct\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.x64]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[target.spv]\nisa = \"spirv\"\nos = \"freestanding\"\nabi = \"spirv\"\n\n[target.rv32]\nisa = \"rv32imafdc\"\nos = \"freestanding\"\nabi = \"ilp32d\"\n\n[target.rv32f]\nisa = \"rv32imafdc\"\nos = \"freestanding\"\nabi = \"ilp32f\"\n\n[target.rv32s]\nisa = \"rv32imafdc\"\nos = \"freestanding\"\nabi = \"ilp32\"\n\n[target.rv32nf]\nisa = \"rv32imc\"\nos = \"freestanding\"\nabi = \"ilp32\"\n\n[profile.debug]\nopt = 0\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n\n[artifact.ct]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/ct\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
}

fun ut_ct_edge_project(s: *session.Session, alloc: *A.Allocator, src: str, target_name: str) res[project.Project, outcome.Fail] {
    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = src;
    val root_r: res[str, fail.Fail] = ut_scaffold_m(alloc, ut_ct_edge_manifest(), ?names[0], ?texts[0], 1);
    if (sel root_r.err) { ret res[project.Project, outcome.Fail].err{outcome.from_fail(root_r.err)}; }
    val root: str               = root_r.ok;
    val rr:   err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.err) {
        fs.remove_all(alloc, root);
        ret res[project.Project, outcome.Fail].err{rr.err};
    }
    var tsel_9040: manifest.Selection                 = ut_target_sel(target_name);
    val pr:        res[project.Project, outcome.Fail] = driver.build_project(s, root, ?tsel_9040);
    fs.remove_all(alloc, root);
    ret pr;
}

test "mach.lang.driver.setup_registry:idempotent_across_repeated_calls_on_one_session" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val isa_count: u32 = isa.registered_count(?s.registry.isa);
    val abi_count: u32 = abi.registered_count(?s.registry.abi);
    val of_count:  u32 = of.registered_count(?s.registry.of);
    val os_count:  u32 = os.registered_count(?s.registry.os);
    if (isa_count == 0) {
        session.dnit(?s);
        ret 1;
    }

    val setup_registry_r2: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r2.err) {
        session.dnit(?s);
        ret 1;
    }
    val setup_registry_r3: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r3.err) {
        session.dnit(?s);
        ret 1;
    }
    if (isa.registered_count(?s.registry.isa) != isa_count) {
        session.dnit(?s);
        ret 1;
    }
    if (abi.registered_count(?s.registry.abi) != abi_count) {
        session.dnit(?s);
        ret 1;
    }
    if (of.registered_count(?s.registry.of) != of_count) {
        session.dnit(?s);
        ret 1;
    }
    if (os.registered_count(?s.registry.os) != os_count) {
        session.dnit(?s);
        ret 1;
    }

    session.dnit(?s);
    ret 0;
}

test "mach.lang.driver:codegen_exclusion_oracle_rejects_mutations" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:   session.Session = sr.ok;
    var bad: i32             = 0;

    val selected: res[project.Project, outcome.Fail] = ut_ct_edge_project(?s, ?alloc,
        "#[oblivious]\nfun good(v: ^u8, n: u8) ^u8 { ret v << n; }\n#[oblivious]\nfun excluded(v: ^u8, n: ^u8) ^u8 { ret v << n; }\nfun main() i32 { ret 0; }\n", "rv32s");
    if (sel selected.err) { bad = 1; }
    if (sel selected.ok) {
        var p: project.Project = selected.ok;
        if (ut_run_codegen_without(?p, "selected secret shift", CODEGEN_CASE_PUBLIC_SHIFT,
            CODEGEN_CASE_SECRET_SHIFT) == 0) { bad = 1; }
        project.dnit_project(?p);
    }

    val unrelated: res[project.Project, outcome.Fail] = ut_ct_edge_project(?s, ?alloc,
        "#[oblivious]\nfun good(v: ^u8, n: u8) ^u8 { ret v << n; }\n#[oblivious]\nfun rejected(a: ^u8, b: ^u8) ^u8 { ret a * b; }\nfun main() i32 { ret 0; }\n", "rv32s");
    if (sel unrelated.err) { bad = 1; }
    if (sel unrelated.ok) {
        var p: project.Project = unrelated.ok;
        if (ut_run_codegen_without(?p, "public shift with unrelated rejection",
            CODEGEN_CASE_PUBLIC_SHIFT, CODEGEN_CASE_SECRET_SHIFT) == 0) { bad = 1; }
        project.dnit_project(?p);
    }

    val missing: res[project.Project, outcome.Fail] = ut_ct_edge_project(?s, ?alloc,
        "fun main() i32 { ret 0; }\n", "rv32s");
    if (sel missing.err) { bad = 1; }
    if (sel missing.ok) {
        var p: project.Project = missing.ok;
        if (ut_run_codegen_without(?p, "missing public shift", CODEGEN_CASE_PUBLIC_SHIFT,
            CODEGEN_CASE_SECRET_SHIFT) == 0) { bad = 1; }
        project.dnit_project(?p);
    }

    session.dnit(?s);
    ret bad;
}

test "mach.lang.driver:declassify_edge_consumers" {
    var bad:    i32          = 0;
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    val ps: res[project.Project, outcome.Fail] = ut_ct_edge_project(?s, ?alloc,
        "fun down(a: ^u32) u32 { ret a:>u32; }\nfun main() i32 { ret 0; }\n", "spv");
    if (sel ps.err) { bad = 1; }
    if (sel ps.ok) {
        var p: project.Project = ps.ok;
        if (ut_run_codegen_ok(?p) != 0) { bad = 1; }
        project.dnit_project(?p);
    }

    val pm: res[project.Project, outcome.Fail] = ut_ct_edge_project(?s, ?alloc,
        "fun down(a: ^u32) u32 { ret a:>u32; }\nfun main() i32 { ret 0; }\n", "rv32s");
    if (sel pm.err) { bad = 1; }
    if (sel pm.ok) {
        var p2: project.Project = pm.ok;
        if (ut_run_codegen_ok(?p2) != 0) { bad = 1; }
        project.dnit_project(?p2);
    }

    session.dnit(?s);
    ret bad;
}

fun ut_float_on_rv32(target_name: str, needle: str, want_refusal: bool) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    val pr: res[project.Project, outcome.Fail] = ut_ct_edge_project(?s, ?alloc,
        "fun main() i32 { val x: f32 = 1.0; ret x::i32; }\n", target_name);
    if (sel pr.err) { ret 2; }
    var p: project.Project = pr.ok;
    fin { project.dnit_project(?p); }
    val sem: err[outcome.Fail] = driver.run_sema_pass(?p);
    if (want_refusal) {
        if (sel sem.ok)                     { ret 3; }
        if (!outcome.is_reported(sem.err))  { ret 4; }
        if (!ut_diag_has(?s.diags, needle)) { ret 5; }
        ret 0;
    }
    if (sel sem.err)                   { ret 6; }
    if (ut_diag_has(?s.diags, needle)) { ret 7; }
    ret 0;
}

# the sema refusal of a float on a selection without F names the extension, not
# only the selection string; the same program on an F selection is clean
test "mach.lang.driver:float_refusal_on_a_no_f_selection_names_the_extension" {
    val no_f: i32 = ut_float_on_rv32("rv32nf",
        "which target `rv32imc` does not support: the selection lacks the F extension", true);
    if (no_f != 0) { ret no_f; }
    val with_f: i32 = ut_float_on_rv32("rv32s", "floating-point", false);
    if (with_f != 0) { ret 10 + with_f; }
    ret 0;
}

# intentional removal test (#3226, #3112): a manifest that still names the
# withdrawn MOS 6502 tuple is refused by name, for any source
test "mach.lang.driver:mos6502_target_is_refused_as_withdrawn" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "fun main() i32 { ret 0; }\n";
    val manifest_text: str                 = "[project]\nid = \"mos\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.mos]\nisa = \"mos6502\"\nos = \"freestanding\"\nabi = \"mos6502\"\n\n[profile.debug]\nopt = 0\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n\n[artifact.mos]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/mos\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
    val root_r:        res[str, fail.Fail] = ut_scaffold_m(?alloc, manifest_text, ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    var bad:  i32                                = 0;
    var pick: manifest.Selection                 = ut_target_sel("mos");
    val pr:   res[project.Project, outcome.Fail] = driver.build_project(?s, root, ?pick);
    if (sel pr.ok) {
        var p: project.Project = pr.ok;
        project.dnit_project(?p);
        bad = 1;
    }
    if (sel pr.err) {
        if (!outcome.is_user(pr.err))                                                                          { bad = 2; }
        if (!ut_str_contains(outcome.describe(pr.err), "target 'mos6502' was withdrawn and removed in 5.0.0")) { bad = 3; }
    }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

