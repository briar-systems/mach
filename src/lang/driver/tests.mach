test "mach.lang.driver:union_tuple_gate_frames_are_stable_across_passes" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    var names: [1]str; names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "def Flag: u8;\nval C: Flag = 1;\n$if (C) { fun selected() i32 { ret 1; } }\nfun main() i32 { ret selected(); }\n";
    val pr: R.Result[project.Project, outcome.Fail] = ut_build(?s, ?alloc, ?names[0], ?texts[0], 1);
    if (R.is_err[project.Project, outcome.Fail](pr)) { session.dnit(?s); ret 2; }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);
    val mid: session.ModuleId = ut_mid(?p, ?s, "uniontest.main");
    if (mid == session.MODULE_NIL) { project.dnit_project(?p); session.dnit(?s); ret 3; }
    val m: *project.ModuleEntry = ?p.modules[mid::u32];
    var entries_len: u32 = 0;
    var entries_cap: u32 = 0;
    var deferred_len: u32 = 0;
    var deferred_cap: u32 = 0;
    var ti: u32 = 0;
    for (ti < m.tuple_gate_count) {
        entries_len = entries_len + m.tuple_gates[ti].entries_len;
        entries_cap = entries_cap + m.tuple_gates[ti].entries_cap;
        deferred_len = deferred_len + m.tuple_gates[ti].deferred_len;
        deferred_cap = deferred_cap + m.tuple_gates[ti].deferred_cap;
        ti = ti + 1;
    }
    var bad: i32 = 0;
    val r1: R.Result[bool, str] = passes.run_gate_pass(?p);
    if (R.is_err[bool, str](r1)) { bad = 4; }
    val r2: R.Result[bool, str] = passes.run_gate_pass(?p);
    if (R.is_err[bool, str](r2)) { bad = 5; }
    ti = 0;
    var next_entries_len: u32 = 0;
    var next_entries_cap: u32 = 0;
    var next_deferred_len: u32 = 0;
    var next_deferred_cap: u32 = 0;
    for (ti < m.tuple_gate_count) {
        next_entries_len = next_entries_len + m.tuple_gates[ti].entries_len;
        next_entries_cap = next_entries_cap + m.tuple_gates[ti].entries_cap;
        next_deferred_len = next_deferred_len + m.tuple_gates[ti].deferred_len;
        next_deferred_cap = next_deferred_cap + m.tuple_gates[ti].deferred_cap;
        ti = ti + 1;
    }
    if (next_entries_len != entries_len || next_entries_cap != entries_cap
     || next_deferred_len != deferred_len || next_deferred_cap != deferred_cap) { bad = 6; }
    passes.clear_gate_results(?p);
    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.driver:comptime_type_query_per_instance" {
    var bad: i32 = 0;

    if (ut_layout_ok("rec P { a: u64; }\nfun probe[T]() i32 { $if ($is_record(T)) { } $or { $error(\"T must be a record\"); } ret 0; }\nfun main() i32 { ret probe[P](); }\n") != 0) { bad = 1; }

    if (ut_vec_diag("rec P { a: u64; }\nfun probe[T]() i32 { $if ($is_record(T)) { } $or { $error(\"T must be a record\"); } ret 0; }\nfun main() i32 { ret probe[u64](); }\n", "T must be a record") != 0) { bad = 1; }

    if (ut_vec_diag("rec P { a: u64; }\nfun probe[T]() i32 { $if ($is_record(T)) { } $or { $error(\"T must be a record\"); } ret 0; }\nfun main() i32 { ret probe[P]() + probe[u64](); }\n", "T must be a record") != 0) { bad = 1; }

    if (ut_layout_ok("fun probe[T]() i32 { $if ($is_record(T)) { } $or { $error(\"T must be a record\"); } ret 0; }\nfun main() i32 { ret 0; }\n") != 0) { bad = 1; }

    if (ut_layout_ok("rec P { a: u64; }\nfun probe[T]() i32 { fin { $if ($is_record(T)) { } $or { $error(\"T must be a record\"); } } ret 0; }\nfun main() i32 { ret probe[P](); }\n") != 0) { bad = 1; }
    if (ut_vec_diag("fun probe[T]() i32 { fin { $if ($is_record(T)) { } $or { $error(\"T must be a record\"); } } ret 0; }\nfun main() i32 { ret probe[u64](); }\n",
                    "T must be a record") != 0) { bad = 1; }

    if (ut_layout_ok("fun probe[T]() i32 { val n: *u8 = $type_name(T); ret 0; }\nfun main() i32 { ret probe[u64](); }\n") != 0) { bad = 1; }
    if (ut_layout_ok("fun probe[T]() i32 { $if ($type_name(T) == \"u64\") { } $or { $error(\"not u64\"); } ret 0; }\nfun main() i32 { ret probe[u64](); }\n") != 0) { bad = 1; }
    if (ut_vec_diag("fun probe[T]() i32 { $if ($type_name(T) == \"u64\") { } $or { $error(\"not u64\"); } ret 0; }\nfun main() i32 { ret probe[i32](); }\n",
                    "not u64") != 0) { bad = 1; }

    if (ut_vec_diag("rec P { a: u64; }\nfun probe[T]() i32 { $if ($is_record(T)) { } $or { $error(\"T must be a record\"); } ret 0; }\nfun main() i32 { ret probe[P](); }\n", "not evaluated per instantiation yet") == 0) { bad = 1; }

    ret bad;
}

test "mach.lang.driver:comptime_type_predicates" {
    var bad: i32 = 0;

    if (ut_arm("rec P { a: u64; }\nfun main() i32 { $if ($is_record(P)) { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n", "Y", "N") != 0) { bad = 1; }
    if (ut_arm("uni U { a: u64; b: u32; }\nfun main() i32 { $if ($is_record(U)) { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n", "N", "Y") != 0) { bad = 1; }
    if (ut_arm("fun main() i32 { $if ($is_record(u64)) { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n", "N", "Y") != 0) { bad = 1; }
    if (ut_arm("rec P { a: u64; }\nfun main() i32 { $if ($is_record(*P)) { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n", "N", "Y") != 0) { bad = 1; }
    if (ut_arm("rec Box[T] { v: T; }\nfun main() i32 { $if ($is_record(Box[i64])) { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n", "Y", "N") != 0) { bad = 1; }

    if (ut_arm("uni U { a: u64; b: u32; }\nfun main() i32 { $if ($is_union(U)) { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n", "Y", "N") != 0) { bad = 1; }
    if (ut_arm("rec P { a: u64; }\nfun main() i32 { $if ($is_union(P)) { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n", "N", "Y") != 0) { bad = 1; }
    if (ut_arm("uni Box[T] { v: T; w: u32; }\nfun main() i32 { $if ($is_union(Box[i64])) { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n", "Y", "N") != 0) { bad = 1; }

    if (ut_arm("rec P { a: u64; }\nfun main() i32 { $if ($is_pointer(*P)) { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n", "Y", "N") != 0) { bad = 1; }
    if (ut_arm("fun main() i32 { $if ($is_pointer(ptr)) { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n", "Y", "N") != 0) { bad = 1; }
    if (ut_arm("rec P { a: u64; }\nfun main() i32 { $if ($is_pointer(P)) { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n", "N", "Y") != 0) { bad = 1; }

    if (ut_arm("rec P { a: u64; }\nfun main() i32 { $if ($is_record(^P)) { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n", "N", "Y") != 0) { bad = 1; }
