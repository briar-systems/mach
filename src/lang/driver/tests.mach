    var texts: [3]str;
    texts[0] = "$if ($mach.build.os == $mach.os.linux) { use uniontest.a; }\n$or ($mach.build.os == $mach.os.windows) { use uniontest.b; }\n\nfun main() i32 { ret 0; }\n";
    texts[1] = "pub fun fa() i32 { ret 1; }\n";
    texts[2] = "pub fun fb() i32 { ret undefined_symbol_xyz; }\n";

    val pr: R.Result[project.Project, outcome.Fail] = ut_build(?s, ?alloc, ?names[0], ?texts[0], 3);
    if (R.is_err[project.Project, outcome.Fail](pr)) { session.dnit(?s); ret 1; }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);

    var bad: i32 = 0;
    if (!ut_has(?p, ?s, "uniontest.b"))   { bad = 1; }
    or (!diagnostic.has_errors(?s.diags)) { bad = 1; }

    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.driver:union_malformed_condition_reported_once" {
    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "$if (5) { use uniontest.a; }\n\nfun main() i32 { ret 0; }\n";

    var a1: A.Allocator;
    if (O.is_some[str](page.make(?a1))) { ret 1; }
    val sr1: R.Result[session.Session, str] = session.init(?a1);
    if (R.is_err[session.Session, str](sr1)) { ret 1; }
    var s1: session.Session = R.unwrap_ok[session.Session, str](sr1);
    val root1_r: R.Result[str, str] = ut_scaffold(?a1, ?names[0], ?texts[0], 1);
    if (R.is_err[str, str](root1_r)) { session.dnit(?s1); ret 1; }
    val root1: str = R.unwrap_ok[str, str](root1_r);
    val rr1: R.Result[R.Void, str] = driver.setup_registry(?s1.registry);
    if (R.is_err[R.Void, str](rr1)) { fs.remove_all(?a1, root1); session.dnit(?s1); ret 1; }
    var sel: manifest.Selection;
    sel.target = ""; sel.profile = ""; sel.artifact = ""; sel.want_lib = false; sel.has_artifact = false;
    val p1r: R.Result[project.Project, outcome.Fail] = driver.build_project_sel(?s1, root1, ?sel);
    fs.remove_all(?a1, root1);
    if (R.is_err[project.Project, outcome.Fail](p1r)) { session.dnit(?s1); ret 1; }
    var p1: project.Project = R.unwrap_ok[project.Project, outcome.Fail](p1r);
    val single_errs: u32 = ut_count_errors(?s1.diags);

    var a2: A.Allocator;
    if (O.is_some[str](page.make(?a2))) { project.dnit_project(?p1); session.dnit(?s1); ret 1; }
    val sr2: R.Result[session.Session, str] = session.init(?a2);
    if (R.is_err[session.Session, str](sr2)) { project.dnit_project(?p1); session.dnit(?s1); ret 1; }
    var s2: session.Session = R.unwrap_ok[session.Session, str](sr2);
    val p2r: R.Result[project.Project, outcome.Fail] = ut_build(?s2, ?a2, ?names[0], ?texts[0], 1);
    if (R.is_err[project.Project, outcome.Fail](p2r)) { project.dnit_project(?p1); session.dnit(?s1); session.dnit(?s2); ret 1; }
    var p2: project.Project = R.unwrap_ok[project.Project, outcome.Fail](p2r);
    val union_errs: u32 = ut_count_errors(?s2.diags);

    var bad: i32 = 0;
    if (single_errs == 0)          { bad = 1; }
    or (union_errs != single_errs) { bad = 1; }

    project.dnit_project(?p1);
    project.dnit_project(?p2);
    session.dnit(?s1);
    session.dnit(?s2);
    ret bad;
}

test "mach.lang.driver:union_string_tag_branch_selection_restores_strid_tuple" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    var names: [3]str;
    names[0] = "main.mach"; names[1] = "a.mach"; names[2] = "b.mach";
    var texts: [3]str;
    texts[0] = "$if ($project.target.os == \"linux\") { use uniontest.a; }\n$or ($project.target.os == \"windows\") { use uniontest.b; }\n\nfun main() i32 { ret 0; }\n";
    texts[1] = "pub fun fa() i32 { ret 1; }\n";
    texts[2] = "pub fun fb() i32 { ret 2; }\n";

    val pr: R.Result[project.Project, outcome.Fail] = ut_build(?s, ?alloc, ?names[0], ?texts[0], 3);
    if (R.is_err[project.Project, outcome.Fail](pr)) { session.dnit(?s); ret 1; }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);

    var bad: i32 = 0;
    if (!ut_has(?p, ?s, "uniontest.a")) { bad = 1; }
    or (!ut_has(?p, ?s, "uniontest.b")) { bad = 1; }

    val cm: *comptime.ComptimeCtx = ut_ctx(?p, ?s, "uniontest.main");
    val ca: *comptime.ComptimeCtx = ut_ctx(?p, ?s, "uniontest.a");
    val cb: *comptime.ComptimeCtx = ut_ctx(?p, ?s, "uniontest.b");
    if (cm == nil || ca == nil || cb == nil) { bad = 1; }
    or (cm.env.target_os != ca.env.target_os)        { bad = 1; }
    or (cm.env.target_os != cb.env.target_os)        { bad = 1; }
    or (cm.env.target_isa != ca.env.target_isa)      { bad = 1; }
    or (cm.env.target_isa != cb.env.target_isa)      { bad = 1; }
    or (cm.env.target_abi != ca.env.target_abi)      { bad = 1; }
    or (cm.env.target_abi != cb.env.target_abi)      { bad = 1; }

    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

