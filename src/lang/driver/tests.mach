    if (R.is_err[R.Void, str](driver.setup_registry(?s.registry))) {
        fs.remove_all(?alloc, root); session.dnit(?s); ret 3;
    }
    val pr: R.Result[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
    fs.remove_all(?alloc, root);
    if (R.is_err[project.Project, outcome.Fail](pr)) { session.dnit(?s); ret 4; }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);
    var bad: i32 = 0;
    if (ut_count_errors(?s.diags) != 0) { bad = 5; }
    if (!ut_has(?p, ?s, "tuplefacts.sysv") || !ut_has(?p, ?s, "tuplefacts.win")
     || !ut_has(?p, ?s, "tuplefacts.alpha") || !ut_has(?p, ?s, "tuplefacts.beta")) { bad = 6; }
    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

