    val dim_ok:  str = "#[handle(\"spirv\", \"image\", 0, 3, 0, 0, 0, 1)]\npub def T;\n\nfun main() i32 { ret 0; }\n";
    if (!ut_h_diag(?alloc, dim_bad, "`Dim` operand names a dimensionality")) { ret 1; }
    if (ut_h_diag(?alloc, dim_ok, "`Dim` operand names a dimensionality"))   { ret 1; }

    val store_bad: str = "#[handle(\"spirv\", \"image\", 0, 1, 0, 0, 0, 2)]\npub def T;\n\nfun main() i32 { ret 0; }\n";
    val store_ok:  str = "#[handle(\"spirv\", \"image\", 0, 1, 0, 0, 0, 1)]\npub def T;\n\nfun main() i32 { ret 0; }\n";
