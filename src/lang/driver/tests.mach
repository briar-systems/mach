fun ut_embed_diag(main_src: str, asset: str, needle: str) i32 {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    var names: [2]str;
    names[0] = "main.mach";
    names[1] = "asset.bin";
    var texts: [2]str;
    texts[0] = main_src;
    texts[1] = asset;

    val pr: R.Result[project.Project, outcome.Fail] = ut_vec_sema_n(?s, ?alloc, ?names[0], ?texts[0], 2);
    if (R.is_err[project.Project, outcome.Fail](pr)) { session.dnit(?s); ret 1; }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);
    val hit: bool = ut_diag_has(?p.s.diags, needle);
    project.dnit_project(?p);
    session.dnit(?s);
    if (hit) { ret 0; }
    ret 1;
}

fun ut_embed_unreadable_diag() i32 {
    $if ($mach.build.os != $mach.os.linux) { ret 0; }

    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    if (R.is_err[R.Void, str](driver.setup_registry(?s.registry))) { session.dnit(?s); ret 1; }

    var names: [2]str;
    names[0] = "main.mach"; names[1] = "asset.bin";
    var texts: [2]str;
    texts[0] = "#[embed(\"asset.bin\")]\nval A: [_]u8;\nfun main() i32 { ret 0; }\n";
    texts[1] = "abc";

    val root_r: R.Result[str, str] = ut_scaffold(?alloc, ?names[0], ?texts[0], 2);
    if (R.is_err[str, str](root_r)) { session.dnit(?s); ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);
    val src_dir: str = ut_cc3(?alloc, root, "/", "src");
    val a_path: str = ut_cc3(?alloc, src_dir, "/", "asset.bin");

    if (O.is_some[str](fs.remove_file(a_path))) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    if (O.is_some[str](fs.write_bytes(a_path, "abc", 3::usize, 0))) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }

    val pr: R.Result[project.Project, outcome.Fail] = ut_sema_build(?s, root);
    if (R.is_err[project.Project, outcome.Fail](pr)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);
    val hit: bool = ut_diag_has(?s.diags, "permission denied");
    project.dnit_project(?p);
    fs.remove_all(?alloc, root);
    session.dnit(?s);
    if (hit) { ret 0; }
    ret 1;
}

