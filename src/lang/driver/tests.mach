test analyze_project__retains_the_selected_frontend {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [4]str;
    names[0] = "alpha.mach";
    names[1] = "beta.mach";
    names[2] = "model.mach";
    names[3] = "orphan.mach";
    var texts: [4]str;
    texts[0] = "fun main() i32 { ret no_such(); }\n";
    texts[1] = "use ctxcase.model;\nfun main() i32 { var b: model.Box[model.Leaf]; ret model.take[model.Leaf](b); }\n";
    texts[2] = "pub rec Leaf { n: i32; }\npub rec Box[T] { v: T; }\npub fun take[T](b: Box[T]) i32 { ret 7; }\n";
    texts[3] = "fun broken() NoSuch { var x: AlsoMissing; ret x; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold_m(
        ?alloc, ut_manifest_frontend(), ?names[0], ?texts[0], 4);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    val mr: res[manifest.Manifest, fail.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var mf:  manifest.Manifest    = mr.ok;
    var req: request.BuildRequest = request.defaults();
    req.project_root = root;
    req.target       = "windows";
    req.profile      = "release";
    req.artifact     = "beta";
    req.goal         = request.GOAL_OBJECTS;
    req.opt          = pipeline.OPT_RELEASE;
    req.pie          = true;

    val pr: res[project.Project, fail.Fail] = driver.analyze_project(?s, ?mf, ?req, project.ROOT_ARTIFACT, nil, 0);
    if (sel pr.err) {
        manifest.dnit(?mf, ?alloc);
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;
    manifest.dnit(?mf, ?alloc);

    var bad: i32 = 0;
    if (p.queries.db != ?s.queries)       { bad = 2; }
    if (ut_count_errors(?s.diags) != 0)   { bad = 3; }
    if (ut_has(?p, ?s, "ctxcase.alpha"))  { bad = 4; }
    if (ut_has(?p, ?s, "ctxcase.orphan")) { bad = 5; }

    val beta:  session.ModuleId = ut_mid(?p, ?s, "ctxcase.beta");
    val model: session.ModuleId = ut_mid(?p, ?s, "ctxcase.model");
    if (module.is_nil(beta) || module.is_nil(model)) { bad = 6; }
    or {
        val bm: *project.ModuleEntry = project.module_at(?p, beta::u32);
        val mm: *project.ModuleEntry = project.module_at(?p, model::u32);
        if (!bm.resolved || bm.resolve_result == nil || bm.sema_result == nil) { bad = 7; }
        if (!mm.resolved || mm.resolve_result == nil || mm.sema_result == nil) { bad = 8; }
        if (bm.ir_module != nil || bm.object_image != nil)                     { bad = 9; }
        if (mm.ir_module != nil || mm.object_image != nil)                     { bad = 10; }

        val c: *comptime.ComptimeCtx = ?bm.load.ctx;
        if (c.env.build_mode_id != comptime_path.MODE_RELEASE || c.env.build_pie != 1) { bad = 11; }
        if (c.env.pointer_width != 8)                                                  { bad = 12; }
        if (!ut_id_is(?s, c.env.project_id, "ctxcase"))                                { bad = 13; }
        if (!ut_id_is(?s, c.env.project_ver, "1.2.3"))                                 { bad = 14; }
        if (!ut_id_is(?s, c.env.target_os, "windows"))                                 { bad = 15; }
        if (!ut_id_is(?s, c.env.target_isa, "x86_64"))                                 { bad = 16; }
        if (!ut_id_is(?s, c.env.target_abi, "win64"))                                  { bad = 17; }
        if (!ut_id_is(?s, c.env.bin_name, "beta"))                                     { bad = 18; }
    }

    project.dnit_project(?p);
    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

test analyze_project__loads_an_overlay_extra_root_through_a_pub_const_gate {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [4]str;
    names[0] = "main.mach";
    names[1] = "extra.mach";
    names[2] = "flags.mach";
    names[3] = "model.mach";
    var texts: [4]str;
    texts[0] = "fun main() i32 { ret 0; }\n";
    texts[1] = "fun broken() NoSuch { var x: AlsoMissing; ret x; }\n";
    texts[2] = "pub val ENABLE: i32 = 1;\n";
    texts[3] = "pub rec Leaf { n: i32; }\npub rec Box[T] { v: T; }\npub fun take[T](b: Box[T]) i32 { ret 7; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 4);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    val mr: res[manifest.Manifest, fail.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var mf:  manifest.Manifest    = mr.ok;
    var req: request.BuildRequest = request.defaults();
    req.project_root = root;
    req.target       = "linux";
    req.artifact     = "uniontest";
    req.goal         = request.GOAL_OBJECTS;

    val base_r: res[project.Project, fail.Fail] = driver.analyze_project(?s, ?mf, ?req, project.ROOT_ARTIFACT, nil, 0);
    if (sel base_r.err) {
        manifest.dnit(?mf, ?alloc);
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var base: project.Project = base_r.ok;
    var bad:  i32             = 0;
    if (ut_has(?base, ?s, "uniontest.extra")) { bad = 1; }
    if (ut_has(?base, ?s, "uniontest.flags")) { bad = 1; }
    if (ut_has(?base, ?s, "uniontest.model")) { bad = 1; }
    project.dnit_project(?base);

    val extra_path:    str            = ut_cc3(?alloc, root, "/", "src/extra.mach");
    val overlay:       str            = "use uniontest.flags.ENABLE;\n$if (ENABLE == 1) { use uniontest.model; }\npub fun probe() i32 { ret 7; }\n";
    val set_overlay_r: err[fail.Fail] = session.set_overlay(?s, extra_path, overlay);
    if (sel set_overlay_r.err) {
        manifest.dnit(?mf, ?alloc);
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    val xid_r: res[intern.StrId, A.Error] = intern.add(?s.interner, "uniontest.extra");
    if (sel xid_r.err) {
        manifest.dnit(?mf, ?alloc);
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var extra_roots: [1]intern.StrId;
    extra_roots[0] = xid_r.ok;

    val rooted_r: res[project.Project, fail.Fail] = driver.analyze_project(?s, ?mf, ?req, project.ROOT_ARTIFACT, ?extra_roots[0], 1);
    if (sel rooted_r.err) {
        manifest.dnit(?mf, ?alloc);
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = rooted_r.ok;
    if (ut_count_errors(?s.diags) != 0)              { bad = 2; }
    if (!ut_has(?p, ?s, "uniontest.extra"))          { bad = 3; }
    if (!ut_has(?p, ?s, "uniontest.flags"))          { bad = 4; }
    if (!ut_has(?p, ?s, "uniontest.model"))          { bad = 5; }
    if (p.emit_len != 1 || p.topo_len <= p.emit_len) { bad = 6; }

    val extra_mid: session.ModuleId = ut_mid(?p, ?s, "uniontest.extra");
    val model_mid: session.ModuleId = ut_mid(?p, ?s, "uniontest.model");
    if (module.is_nil(extra_mid) || module.is_nil(model_mid)) { bad = 7; }
    or {
        val em: *project.ModuleEntry = project.module_at(?p, extra_mid::u32);
        val mm: *project.ModuleEntry = project.module_at(?p, model_mid::u32);
        if (!em.resolved || em.resolve_result == nil || em.sema_result == nil) { bad = 8; }
        if (!mm.resolved || mm.resolve_result == nil || mm.sema_result == nil) { bad = 9; }
        val eid_r: res[intern.StrId, A.Error] = intern.add(?s.interner, "ENABLE");
        if (sel eid_r.ok) {
            val enabled: opt[comptime.NamedConst] = comptime.lookup(
                ?em.load.ctx, eid_r.ok);
            if (sel enabled.some) {
                val nc: comptime.NamedConst = enabled.some;
                if (nc.value.kind != comptime.CT_KIND_INT || nc.value.data.i != 1) { bad = 12; }
            }
        }
    }

    project.dnit_project(?p);
    manifest.dnit(?mf, ?alloc);
    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

test analyze_project__target_change_invalidates_typed_products {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "$if ($mach.build.os == $mach.os.windows) { val K: i32 = 2; } $or { val K: i32 = 1; }\nfun main() i32 { ret K; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 1);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?alloc, root); }
    val mr: res[manifest.Manifest, fail.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) { ret 1; }
    var mf: manifest.Manifest = mr.ok;
    fin { manifest.dnit(?mf, ?alloc); }
    var req: request.BuildRequest = request.defaults();
    req.project_root = root;
    req.target       = "linux";
    req.artifact     = "uniontest";
    req.goal         = request.GOAL_OBJECTS;

    val host_r: res[project.Project, fail.Fail] = driver.analyze_project(?s, ?mf, ?req, project.ROOT_ARTIFACT, nil, 0);
    if (sel host_r.err) { ret 2; }
    var host:   project.Project        = host_r.ok;
    val stable: session.StableModuleId = ut_stable(?host, ?s, "uniontest.main");
    if (module.stable_is_nil(stable)) {
        project.dnit_project(?host);
        ret 3;
    }
    if (project.module_at(?host, ut_mid(?host, ?s, "uniontest.main")::u32).load.ctx.env.target_os_id != catalog_os.LINUX::u32) {
        project.dnit_project(?host);
        ret 4;
    }
    project.dnit_project(?host);
    val target_1: query.Revision = query.peek_revision(?s.queries, query.Q_TARGET, 0);
    val sema_1:   query.Revision = ut_sema_lc(?s, stable);
    if (target_1 == 0 || sema_1 == 0) { ret 5; }

    req.target = "windows";
    val other_r: res[project.Project, fail.Fail] = driver.analyze_project(?s, ?mf, ?req, project.ROOT_ARTIFACT, nil, 0);
    if (sel other_r.err) { ret 6; }
    var other: project.Project = other_r.ok;
    val os_2:  u32             = project.module_at(?other, ut_mid(?other, ?s, "uniontest.main")::u32).load.ctx.env.target_os_id;
    project.dnit_project(?other);
    if (os_2 != catalog_os.WINDOWS::u32) { ret 7; }
    val target_2: query.Revision = query.peek_revision(?s.queries, query.Q_TARGET, 0);
    val sema_2:   query.Revision = ut_sema_lc(?s, stable);
    if (target_2 == target_1 || sema_2 == sema_1) { ret 8; }

    val again_r: res[project.Project, fail.Fail] = driver.analyze_project(?s, ?mf, ?req, project.ROOT_ARTIFACT, nil, 0);
    if (sel again_r.err) { ret 9; }
    var again: project.Project = again_r.ok;
    project.dnit_project(?again);
    if (query.peek_revision(?s.queries, query.Q_TARGET, 0) != target_2 || ut_sema_lc(?s, stable) != sema_2) { ret 10; }
    ret 0;
}

test analyze_project__replays_cached_diagnostics {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "fun dup() i32 { ret 1; }\nfun dup() i32 { ret 2; }\nfun main() i32 { ret 0; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str                               = root_r.ok;
    val mr:   res[manifest.Manifest, fail.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var mf:  manifest.Manifest    = mr.ok;
    var req: request.BuildRequest = request.defaults();
    req.project_root = root;
    req.target       = "linux";
    req.artifact     = "uniontest";
    req.goal         = request.GOAL_OBJECTS;

    val cold_r: res[project.Project, fail.Fail] = driver.analyze_project(?s, ?mf, ?req, project.ROOT_ARTIFACT, nil, 0);
    if (!ut_project_was_rejected(cold_r)) {
        manifest.dnit(?mf, ?alloc);
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    val fqn_r: res[intern.StrId, A.Error] = intern.add(?s.interner, "uniontest.main");
    if (sel fqn_r.err) {
        manifest.dnit(?mf, ?alloc);
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    val stable: session.StableModuleId = session.stable_module_id_lookup(?s, fqn_r.ok);
    if (module.stable_is_nil(stable) || diagnostic.len(?s.diags) == 0) {
        manifest.dnit(?mf, ?alloc);
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    val resolve_rev: query.Revision = query.peek_revision(?s.queries, query.Q_RESOLVE, module.stable_index(stable)::u64);
    val sema_rev:    query.Revision = query.peek_revision(?s.queries, query.Q_SEMA, module.stable_index(stable)::u64);
    if (resolve_rev == 0 || sema_rev == 0) {
        manifest.dnit(?mf, ?alloc);
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    val snapshot_r: res[*diagnostic.DiagnosticStore, fail.Fail] = diagnostic.snapshot_from(?s.diags, 0, ?alloc);
    if (sel snapshot_r.err) {
        manifest.dnit(?mf, ?alloc);
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    val snapshot: *diagnostic.DiagnosticStore = snapshot_r.ok;

    val warm_r: res[project.Project, fail.Fail] = driver.analyze_project(?s, ?mf, ?req, project.ROOT_ARTIFACT, nil, 0);
    if (!ut_project_was_rejected(warm_r)) {
        diagnostic.store_dnit(snapshot);
        A.deallocate[diagnostic.DiagnosticStore](?alloc, snapshot, 1::usize);
        manifest.dnit(?mf, ?alloc);
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var bad: i32 = 0;
    if (!ut_diag_list_eq(?s.diags, snapshot))                                                              { bad = 1; }
    if (query.peek_revision(?s.queries, query.Q_RESOLVE, module.stable_index(stable)::u64) != resolve_rev) { bad = 1; }
    if (query.peek_revision(?s.queries, query.Q_SEMA, module.stable_index(stable)::u64) != sema_rev)       { bad = 1; }

    diagnostic.store_dnit(snapshot);
    A.deallocate[diagnostic.DiagnosticStore](?alloc, snapshot, 1::usize);
    manifest.dnit(?mf, ?alloc);
    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

test analyze_project__failure_cleans_partial_state {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "other.mach";
    var texts: [1]str;
    texts[0] = "pub fun other() i32 { ret 1; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str                               = root_r.ok;
    val mr:   res[manifest.Manifest, fail.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var mf:  manifest.Manifest    = mr.ok;
    var req: request.BuildRequest = request.defaults();
    req.project_root = root;
    req.target       = "linux";
    req.artifact     = "uniontest";
    req.goal         = request.GOAL_OBJECTS;

    var bad:    i32                             = 0;
    val failed: res[project.Project, fail.Fail] = driver.analyze_project(?s, ?mf, ?req, project.ROOT_ARTIFACT, nil, 0);
    if (sel failed.ok) {
        var stray: project.Project = failed.ok;
        project.dnit_project(?stray);
        bad = 1;
    }
    if (session.module_count(?s) != 0) { bad = 1; }

    val main_path:     str             = ut_cc3(?alloc, root, "/", "src/main.mach");
    val repaired_text: str             = "fun main() i32 { ret 0; }\n";
    val write_err:     err[fs.FsError] = fs.write_bytes(
        main_path, repaired_text, str_len(repaired_text), 420);
    if (sel write_err.err) { bad = 1; }
    if (sel write_err.ok) {
        val repaired: res[project.Project, fail.Fail] = driver.analyze_project(?s, ?mf, ?req, project.ROOT_ARTIFACT, nil, 0);
        if (sel repaired.err) { bad = 1; }
        if (sel repaired.ok) {
            var p:   project.Project  = repaired.ok;
            val mid: session.ModuleId = ut_mid(?p, ?s, "uniontest.main");
            if (module.is_nil(mid)) { bad = 1; }
            or {
                val me: *project.ModuleEntry = project.module_at(?p, mid::u32);
                if (!me.resolved || me.resolve_result == nil || me.sema_result == nil) { bad = 1; }
            }
            if (p.queries.db != ?s.queries) { bad = 1; }
            project.dnit_project(?p);
        }
    }

    manifest.dnit(?mf, ?alloc);
    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

# a two-module project analyzed both ways: the tolerant entry point keeps the
# project and the phase products (a parse-rejected module still types on its
# recovered tree), the build-facing one answers reported
#[testing]
fun t_tolerant_pair(names: *str, texts: *str, defs_sema: bool, main_sema: bool) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, names, texts, 2);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str                               = root_r.ok;
    val mr:   res[manifest.Manifest, fail.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var mf:  manifest.Manifest    = mr.ok;
    var req: request.BuildRequest = request.defaults();
    req.project_root = root;
    req.target       = "linux";
    req.artifact     = "uniontest";
    req.goal         = request.GOAL_OBJECTS;

    var bad:    i32                             = 0;
    val strict: res[project.Project, fail.Fail] = driver.analyze_project(?s, ?mf, ?req, project.ROOT_ARTIFACT, nil, 0);
    if (!ut_project_was_rejected(strict)) { bad = 2; }

    val kept: res[project.Project, fail.Fail] = driver.analyze_project_tolerant(
        ?s, ?mf, ?req, project.ROOT_ARTIFACT, nil, 0, driver.FRONTEND_SEMA);
    if (sel kept.err) { bad = 3; }
    if (sel kept.ok) {
        var p:    project.Project  = kept.ok;
        val defs: session.ModuleId = ut_mid(?p, ?s, "uniontest.defs");
        val main: session.ModuleId = ut_mid(?p, ?s, "uniontest.main");
        if (module.is_nil(defs) || module.is_nil(main)) { bad = 4; }
        or {
            val dm: *project.ModuleEntry = project.module_at(?p, defs::u32);
            val mm: *project.ModuleEntry = project.module_at(?p, main::u32);
            if (dm.a == nil || mm.a == nil)                               { bad = 5; }
            if (dm.resolve_result == nil || mm.resolve_result == nil)     { bad = 6; }
            if ((dm.sema_result != nil) != defs_sema)                     { bad = 7; }
            if ((mm.sema_result != nil) != main_sema)                     { bad = 8; }
            if (session.module_sema_ptr(?s, main) != mm.sema_result::ptr) { bad = 11; }
        }
        if (!fail.is_rejected(passes.frontend_status(?p))) { bad = 9; }
        if (ut_count_errors(?s.diags) == 0)                { bad = 10; }
        project.dnit_project(?p);
    }

    manifest.dnit(?mf, ?alloc);
    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

# a rejection is one module's answer, not the pass's: a module later in topo
# order that does not depend on the rejected one still types
test analyze_project_tolerant__types_past_a_rejected_module {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [4]str;
    names[0] = "a.mach";
    names[1] = "b.mach";
    names[2] = "c.mach";
    names[3] = "main.mach";
    var texts: [4]str;
    texts[0] = "pub fun af() i32 { ret 1; }\n";
    texts[1] = "pub fun bf() i32 { val n: i32 = 1; val w: i64 = 4; ret n + w; }\n";
    texts[2] = "pub fun cf() i32 { ret 3; }\n";
    texts[3] = "use uniontest.a;\nuse uniontest.b;\nuse uniontest.c;\nfun main() i32 { ret a.af() + b.bf() + c.cf(); }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 4);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str                               = root_r.ok;
    val mr:   res[manifest.Manifest, fail.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var mf:  manifest.Manifest    = mr.ok;
    var req: request.BuildRequest = request.defaults();
    req.project_root = root;
    req.target       = "linux";
    req.artifact     = "uniontest";
    req.goal         = request.GOAL_OBJECTS;

    var bad:    i32                             = 0;
    val strict: res[project.Project, fail.Fail] = driver.analyze_project(?s, ?mf, ?req, project.ROOT_ARTIFACT, nil, 0);
    if (!ut_project_was_rejected(strict)) { bad = 2; }

    val kept: res[project.Project, fail.Fail] = driver.analyze_project_tolerant(
        ?s, ?mf, ?req, project.ROOT_ARTIFACT, nil, 0, driver.FRONTEND_SEMA);
    if (sel kept.err) { bad = 3; }
    if (sel kept.ok) {
        var p:  project.Project  = kept.ok;
        val ma: session.ModuleId = ut_mid(?p, ?s, "uniontest.a");
        val mb: session.ModuleId = ut_mid(?p, ?s, "uniontest.b");
        val mc: session.ModuleId = ut_mid(?p, ?s, "uniontest.c");
        if (module.is_nil(ma) || module.is_nil(mb) || module.is_nil(mc)) { bad = 4; }
        or {
            # the case only bites when the rejected module is typed first
            if (ut_topo_index(?p, mb) >= ut_topo_index(?p, mc))    { bad = 5; }
            if (project.module_at(?p, ma::u32).sema_result == nil) { bad = 6; }
            if (project.module_at(?p, mb::u32).sema_result == nil) { bad = 7; }
            if (project.module_at(?p, mc::u32).sema_result == nil) { bad = 8; }
        }
        if (!fail.is_rejected(passes.frontend_status(?p))) { bad = 9; }
        if (ut_count_errors(?s.diags) != 1)                { bad = 10; }
        project.dnit_project(?p);
    }

    manifest.dnit(?mf, ?alloc);
    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

test analyze_project_tolerant__keeps_products_through_type_and_parse_errors {
    var names: [2]str;
    names[0] = "defs.mach";
    names[1] = "main.mach";
    var texts: [2]str;
    texts[0] = "pub val watched: i64 = 4;\n";
    texts[1] = "use uniontest.defs;\nfun main() i32 { val n: i32 = 1; ret n + defs.watched; }\n";
    val typed: i32 = t_tolerant_pair(?names[0], ?texts[0], true, true);
    if (typed != 0) { ret 10 + typed; }
    texts[0] = "pub val watched: i32 = 4;\n";
    texts[1] = "use uniontest.defs;\nfun main() i32 { val n: i32 = 1\n ret n + defs.watched; }\n";
    val parsed: i32 = t_tolerant_pair(?names[0], ?texts[0], true, true);
    if (parsed != 0) { ret 20 + parsed; }
    ret 0;
}

#[testing]
fun t_manifest_stack_elf() str {
    ret "[project]\nmach = \">=5\"\nid = \"stk\"\nversion = \"0.1.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.win]\nisa = \"x86_64\"\nos = \"windows\"\nabi = \"win64\"\nstack_reserve = 8388608\n\n[target.lin]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\nstack_reserve = 8388608\n\n[profile.debug]\nopt = 0\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n\n[artifact.stk]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"{project.out}/bin/stk\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
}

# the pe case, which accepts the keys, is stack_reserve__reaches_the_linked_pe
test stack_reserve__refused_at_load_on_a_format_without_one {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "fun main() i32 { ret 0; }\n";

    var bad: i32 = 0;

    val bad_root_r: res[str, fail.Fail] = ut_scaffold_m(?alloc, t_manifest_stack_elf(), ?names[0], ?texts[0], 1);
    if (sel bad_root_r.err) {
        session.dnit(?s);
        ret 2;
    }
    val bad_root: str = bad_root_r.ok;

    val br: res[manifest.Manifest, fail.Fail] = driver.load_manifest(?s, bad_root);
    if (sel br.ok) {
        var m: manifest.Manifest = br.ok;
        manifest.dnit(?m, ?alloc);
        bad = 3;
    }
    if (sel br.err) {
        val msg: str = fail.describe(br.err);
        if (!str_contains(msg, "stack_reserve") && bad == 0) { bad = 4; }
        if (!str_contains(msg, "lin") && bad == 0)           { bad = 5; }
        if (!str_contains(msg, "elf") && bad == 0)           { bad = 6; }
    }
    fs.remove_all(?alloc, bad_root);
    session.dnit(?s);
    ret bad;
}
