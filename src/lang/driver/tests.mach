    ret bad;
}

test "mach.lang.driver:dep_out_home" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    var code: i32 = 0;

    val rel: R.Result[str, str] = dcfg.dep_out_home(?alloc, ".", "out/linux/debug");
    if (R.is_err[str, str](rel) || !path.is_abs(R.unwrap_ok[str, str](rel))) { code = 1; }
    val cwd_r: R.Result[str, str] = env.current_dir(?alloc);
    if (R.is_err[str, str](cwd_r)) { ret 1; }
    val abs: R.Result[str, str] = dcfg.dep_out_home(?alloc, R.unwrap_ok[str, str](cwd_r), "out/linux/debug");
    if (R.is_err[str, str](abs) || !path.is_abs(R.unwrap_ok[str, str](abs))) { code = 1; }
    if (R.is_ok[str, str](rel) && R.is_ok[str, str](abs) &&
        !str_equals(R.unwrap_ok[str, str](rel), R.unwrap_ok[str, str](abs))) { code = 1; }

    val abs_sub_r: R.Result[str, str] = path.resolve(?alloc, R.unwrap_ok[str, str](cwd_r), "subdir");
    if (R.is_err[str, str](abs_sub_r)) { ret 1; }
    val rel_sub: R.Result[str, str] = dcfg.dep_out_home(?alloc, "./subdir", "out/linux/debug");
    val abs_sub: R.Result[str, str] = dcfg.dep_out_home(?alloc, R.unwrap_ok[str, str](abs_sub_r), "out/linux/debug");
    val folded: R.Result[str, str] = dcfg.dep_out_home(?alloc, "./subdir/../subdir", "out/linux/debug");
    if (R.is_err[str, str](rel_sub) || R.is_err[str, str](abs_sub) || R.is_err[str, str](folded)) { ret 1; }
    if (!str_equals(R.unwrap_ok[str, str](rel_sub), R.unwrap_ok[str, str](abs_sub))) { code = 1; }
    if (!str_equals(R.unwrap_ok[str, str](folded), R.unwrap_ok[str, str](abs_sub)))  { code = 1; }
    ret code;
}

test "mach.lang.driver:test_gated_orphan_excluded" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    var names: [2]str;
    names[0] = "main.mach"; names[1] = "gated.mach";
    var texts: [2]str;
    texts[0] = "fun main() i32 { ret 0; }\n";
    texts[1] = "$error(\"gated: not for this target\");\n\ntest \"gt\" { ret 0; }\n";

    val pr: R.Result[project.Project, outcome.Fail] = ut_build_test(?s, ?alloc, ?names[0], ?texts[0], 2);
    if (R.is_err[project.Project, outcome.Fail](pr)) { session.dnit(?s); ret 1; }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);

    var bad: i32 = 0;
    if (!ut_has(?p, ?s, "uniontest.gated"))    { bad = 1; }
    if (!ut_gated(?p, ?s, "uniontest.gated"))  { bad = 1; }
    if (ut_in_topo(?p, ?s, "uniontest.gated")) { bad = 1; }
    if (union.count_target_gated(?p) != 1)           { bad = 1; }
    if (!ut_in_topo(?p, ?s, "uniontest.main")) { bad = 1; }
    val se: R.Result[R.Void, outcome.Fail] = passes.run_sema_pass(?p);
    if (R.is_err[R.Void, outcome.Fail](se))               { bad = 1; }
    if (ut_count_errors(?p.s.diags) != 0)      { bad = 1; }

    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

