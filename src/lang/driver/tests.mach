test "mach.lang.driver:oblivious_spirv_refused" {
    var bad:    i32          = 0;
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    val obl: str = "#[oblivious]\nfun mask(a: ^u32, b: ^u32) ^u32 { ret a ^ b; }\nfun main() i32 { ret 0; }\n";

    if (ut_codegen_target_ok(obl, "linux") != 0) { bad = 1; }

    val ps: res[project.Project, outcome.Fail] = ut_ct_edge_project(?s, ?alloc, obl, "spv");
    if (sel ps.err) { bad = 1; }
    if (sel ps.ok) {
        var p: project.Project = ps.ok;
        if (ut_run_codegen_err(?p, "cannot be compiled for the `spirv` target") != 0) { bad = 1; }
        project.dnit_project(?p);
    }

    val pt: res[project.Project, outcome.Fail] = ut_ct_edge_project(?s, ?alloc,
        "fun down(a: ^u32) u32 { ret a:>u32; }\nfun main() i32 { ret 0; }\n", "spv");
    if (sel pt.err) { bad = 1; }
    if (sel pt.ok) {
        var p2: project.Project = pt.ok;
        if (ut_run_codegen_ok(?p2) != 0) { bad = 1; }
        project.dnit_project(?p2);
    }

    session.dnit(?s);
    ret bad;
}

fun ut_count_op(p: *project.Project, kind: instruction.InstrKind) u32 {
    var n:  u32 = 0;
    var ti: u32 = 0;
    for (ti < p.topo_len) {
        val m: *ir.Module = p.modules[p.topo[ti]::u32].ir_module;
        if (m != nil) {
            var fi: u32 = 0;
            for (fi < m.function_len) {
                val fn: *ir.Function = ?m.functions[fi];
                var bi: u32          = 0;
                for (bi < fn.block_count) {
                    val blk: *ir.Block = ?fn.blocks[bi];
                    var ix:  u32       = 0;
                    for (ix < blk.instr_count) {
                        if ((?fn.instrs[blk.instructions[ix]]).kind == kind) { n = n + 1; }
                        ix = ix + 1;
                    }
                    bi = bi + 1;
                }
                fi = fi + 1;
            }
        }
        ti = ti + 1;
    }
    ret n;
}

test "mach.lang.driver:secret_fp_conversion_rejected" {
    var bad: i32 = 0;
    if (!ut_sema_rejects("fun f(a: ^f64) ^i64 { ret a::^i64; }\nfun main() i32 { ret 0; }\n")) { bad = 1; }
    if (!ut_sema_rejects("fun f(a: ^f32) ^f64 { ret a::^f64; }\nfun main() i32 { ret 0; }\n")) { bad = 1; }
    if (!ut_sema_rejects("fun f(a: ^i64) ^f64 { ret a::^f64; }\nfun main() i32 { ret 0; }\n")) { bad = 1; }
    if (!ut_sema_clean("fun f(a: f64) i64 { ret a::i64; }\nfun main() i32 { ret 0; }\n"))      { bad = 1; }
    if (!ut_sema_clean("fun f(a: ^i32) ^i64 { ret a::^i64; }\nfun main() i32 { ret 0; }\n"))   { bad = 1; }
    ret bad;
}

