    if (ut_arm("fun main() i32 { $if ($is_secret(^[4]u8)) { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n", "Y", "N") != 0) { bad = 1; }
    if (ut_arm("fun main() i32 { $if ($is_secret(^^u64)) { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n", "Y", "N") != 0) { bad = 1; }

