    val src: str = "pub fun sel(m: u8x16, a: i8x16, b: i8x16) i8x16 {\n    ret ((m & a:~u8x16) | (~m & b:~u8x16)):~i8x16;\n}\nfun main() i32 { ret 0; }\n";

