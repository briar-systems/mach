test "mach.lang.driver:instance_body_typed_by_instantiated_types" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var bad: i32 = 0;

    val mixed: str = ut_cc3(?alloc,
        "fun sink(va: ...) u32 { var acc: u32 = 0; $each a in va { acc = acc + a; } ret acc; }\n#[symbol(\"",
        ut_entry_symbol(), "\")]\nfun start() i32 { sink(7i64, 8i64); ret 0; }\n");
    if (!ut_sema_clean(mixed))             { bad = 1; }
    if (ut_engine_build_fails(mixed) != 0) { bad = 1; }

    val cast: str = ut_cc3(?alloc,
        "fun sink(va: ...) u32 { var acc: u32 = 0; $each a in va { acc = acc + a::u32; } ret acc; }\n#[symbol(\"",
        ut_entry_symbol(), "\")]\nfun start() i32 { sink(7i64, 8i64); ret 0; }\n");
    if (!ut_sema_clean(cast))             { bad = 1; }
    if (ut_engine_build_fails(cast) == 0) { bad = 1; }

    val hetero: str = ut_cc3(?alloc,
        "fun sum(va: ...) i64 { var t: i64 = 0; $each a in va { t = t + a::i64; } ret t; }\n#[symbol(\"",
        ut_entry_symbol(), "\")]\nfun start() i32 { sum(1000, 50::i32, 7::u8); ret 0; }\n");
    if (!ut_sema_clean(hetero))             { bad = 1; }
    if (ut_engine_build_fails(hetero) == 0) { bad = 1; }

    ret bad;
}

test "mach.lang.driver:binary_operands_need_one_type" {
    var bad: i32 = 0;

    if (!ut_sema_rejects("fun f(a: u32, b: i64) u32 { ret a + b; }\nfun main() i32 { ret 0; }\n")) { bad = 1; }
    if (!ut_sema_rejects_with("fun f(a: u32, b: i64) u32 { ret a + b; }\nfun main() i32 { ret 0; }\n",
        "cast one operand explicitly")) { bad = 1; }
    if (!ut_sema_rejects("fun f(a: u32, b: u8) u32 { ret a - b; }\nfun main() i32 { ret 0; }\n"))  { bad = 1; }
    if (!ut_sema_rejects("fun f(a: u32, b: i32) u32 { ret a * b; }\nfun main() i32 { ret 0; }\n")) { bad = 1; }
    if (!ut_sema_rejects("fun f(a: u32, b: u64) u32 { ret a & b; }\nfun main() i32 { ret 0; }\n")) { bad = 1; }
    if (!ut_sema_rejects("fun f(a: u32, b: u64) u32 { ret a | b; }\nfun main() i32 { ret 0; }\n")) { bad = 1; }
    if (!ut_sema_rejects("fun f(a: u32, b: u64) u32 { ret a ^ b; }\nfun main() i32 { ret 0; }\n")) { bad = 1; }
    if (!ut_sema_rejects("fun f(a: u32, b: i64) u32 { ret b + a; }\nfun main() i32 { ret 0; }\n")) { bad = 1; }

    if (!ut_sema_clean("fun f(a: u32, b: i64) u32 { ret a + b::u32; }\nfun main() i32 { ret 0; }\n")) { bad = 1; }
    if (!ut_sema_clean("fun f(a: u32, b: u8) u32 { ret a << b; }\nfun main() i32 { ret 0; }\n"))      { bad = 1; }
    if (!ut_sema_clean("fun f(a: u32, b: u8) u32 { ret a >> b; }\nfun main() i32 { ret 0; }\n"))      { bad = 1; }
    if (!ut_sema_clean("fun f(a: u32, b: i64) u8 { ret a < b; }\nfun main() i32 { ret 0; }\n"))       { bad = 1; }
    if (!ut_sema_clean("fun f(a: u32, b: i64) u8 { ret a == b; }\nfun main() i32 { ret 0; }\n"))      { bad = 1; }
    if (!ut_sema_clean("fun f(a: ^u32, b: u32) ^u32 { ret a + b; }\nfun main() i32 { ret 0; }\n"))    { bad = 1; }
    if (!ut_sema_clean("fun f(a: u32) u32 { ret a + 1; }\nfun main() i32 { ret 0; }\n"))              { bad = 1; }

    ret bad;
}

rec UtIrTextBuf {
    data: *u8;
    len:  usize;
    cap:  usize;
}

fun ut_ir_text_write(ctx: ptr, buf: *u8, len: usize) res[usize, writer.WriteError] {
    val b: *UtIrTextBuf = ctx::*UtIrTextBuf;
    var i: usize        = 0;
    for (i < len) {
        if (b.len >= b.cap) { ret res[usize, writer.WriteError].err{writer.native_failure(0, io_error.from_code(sysos.EIO, io_error.OP_WRITE))}; }
        b.data[b.len] = buf[i];
        b.len         = b.len + 1;
        i             = i + 1;
    }
    ret res[usize, writer.WriteError].ok{len};
}

fun ut_ir_text(text: str, out: *u8, cap: usize, out_len: *usize) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = text;
    val pr: res[project.Project, outcome.Fail] = ut_build(?s, ?alloc, ?names[0], ?texts[0], 1);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    var code: i32               = 1;
    val se:   err[outcome.Fail] = driver.run_sema_pass(?p);
    if (sel se.ok) {
        val le: err[outcome.Fail] = driver.run_lower_pass(?p);
        if (sel le.ok) {
            var b: UtIrTextBuf;
            b.data = out;
            b.len  = 0;
            b.cap  = cap;
            var w: writer.Writer;
            w.ctx     = (?b)::ptr;
            w.f_write = ut_ir_text_write;

            code = 0;
            var ti: u32 = 0;
            for (ti < p.topo_len) {
                val m: *ir.Module = p.modules[p.topo[ti]::u32].ir_module;
                if (m != nil) {
                    var d: printer.IrDebugWriter = printer.debug_writer(?w, m, ?p.s.interner,
                        printer.debug_context("post-lower", "t", "i", "o", "a", "f"));
                    val write_debug_r: err[fail.Fail] = printer.write_debug(?d);
                    if (sel write_debug_r.err) { code = 1; }
                }
                ti = ti + 1;
            }
            @out_len = b.len;
        }
    }
    project.dnit_project(?p);
    session.dnit(?s);
    ret code;
}

fun ut_ir_text_equal(a_src: str, b_src: str) i32 {
    val CAP: usize = 262144;
    var ba:  [262144]u8;
    var bb:  [262144]u8;
    var la:  usize = 0;
    var lb:  usize = 0;
    if (ut_ir_text(a_src, ?ba[0], CAP, ?la) != 0) { ret 2; }
    if (ut_ir_text(b_src, ?bb[0], CAP, ?lb) != 0) { ret 2; }
    if (la == 0)                                  { ret 2; }
    if (la != lb)                                 { ret 1; }
    var i: usize = 0;
    for (i < la) {
        if (ba[i] != bb[i]) { ret 1; }
        i = i + 1;
    }
    ret 0;
}

# `:^` and `:^T` are no operator on any operand shape: the parse stops at the
# colon and the statement's terminator check reports it; `:>T` builds
test "mach.lang.driver:colon_caret_is_refused_at_the_colon" {
    val msg: str = "expected ';' after 'ret'";
    if (!ut_sema_rejects_with("fun down(a: ^u32) u32 { ret a:^u32; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { down(1); ret 0; }\n", msg))       { ret 1; }
    if (!ut_sema_rejects_with("fun down(a: ^u32) u32 { ret a:^; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { down(1); ret 0; }\n", msg))          { ret 2; }
    if (!ut_sema_rejects_with("fun down(a: ^*u8) *u8 { ret a:^*u8; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n", msg))                { ret 3; }
    if (!ut_sema_rejects_with("fun down(a: ^u32x4) u32x4 { ret a:^u32x4; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n", msg))          { ret 4; }
    if (!ut_sema_rejects_with("rec K { d: [4]u8; }\nfun down(a: ^K) K { ret a:^K; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n", msg)) { ret 5; }
    if (!ut_sema_rejects_with("fun down(a: ^[4]u32) [4]u32 { ret a:^[4]u32; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n", msg))       { ret 6; }

    val scalar_new: str = "fun down(a: ^u32) u32 { ret a:>u32; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { down(1); ret 0; }\n";
    val other:      str = "fun down(a: ^u32) u32 { ret (a:>u32) + 1; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { down(1); ret 0; }\n";
    if (ut_ir_text_equal(scalar_new, scalar_new) != 0) { ret 7; }
    if (ut_ir_text_equal(scalar_new, other) != 1)      { ret 8; }
    ret 0;
}

# intentional removal test (#3226, #3112, #3128): the two paths are refused at
# their use site with the removal named, and a wrong path keeps its own message
test "mach.lang.driver:project_name_and_description_paths_are_refused_naming_the_removal" {
    if (!ut_sema_rejects_with("val n: *u8 = $project.name;\nfun main() i32 { ret 0; }\n",
        "`$project.name` was removed in 5.0.0 with the `[project] name` manifest key")) { ret 1; }
    if (!ut_sema_rejects_with("val d: *u8 = $project.description;\nfun main() i32 { ret 0; }\n",
        "`$project.description` was removed in 5.0.0 with the `[project] description` manifest key")) { ret 2; }
    if (!ut_sema_rejects_with("val d: *u8 = $project.bogus;\nfun main() i32 { ret 0; }\n",
        "unknown `$project.*` path")) { ret 3; }
    if (!ut_sema_clean("val i: *u8 = $project.id;\nval v: *u8 = $project.version;\nfun main() i32 { ret 0; }\n")) { ret 4; }
    ret 0;
}

# `$mach.build.*` has no manifest-defined members (#3131): a name outside the
# known set is refused at the use site as an unknown path, and a known member
# on the line before it still resolves
test "mach.lang.driver:unknown_mach_build_member_is_refused_at_the_use_site" {
    val src: str = "val w: u64 = $mach.build.pointer_width;\nval n: u64 = $mach.build.nosuch;\nfun main() i32 { ret 0; }\n";
    if (!ut_sema_rejects_at(src, "unknown `$mach.*` path", 53, 18))                             { ret 1; }
    if (!ut_sema_clean("val w: u64 = $mach.build.pointer_width;\nfun main() i32 { ret 0; }\n")) { ret 2; }
    ret 0;
}

# with the untyped `:^` gone, a generic body names the public type it expects and
# the template defers the equality to each instance
test "mach.lang.driver:generic_strip_target_is_checked_per_instance" {
    if (!ut_ct_lower_clean("var g: ^u32 = 99;\nfun show[U](s: U) u32 { ret s:>u32; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { show[^u32](g); ret 0; }\n")) { ret 1; }
    if (ut_ct_lower_diag("var h: ^u64 = 99;\nfun show[U](s: U) u32 { ret s:>u32; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { show[^u64](h); ret 0; }\n",
        "must name the operand's stripped (public) type") != 0) { ret 2; }
    if (ut_ct_lower_diag("var g: ^u32 = 99;\nfun show[U](s: U) ^u32 { ret s:>^u32; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { show[^u32](g); ret 0; }\n",
        "target type must be public") != 0) { ret 3; }
    ret 0;
}

fun ut_agg_strip_mixed() str {
    ret "rec Inner { x: u32; y: u32; }\nrec M { n: Inner; p: *u8; q: ^*u8; v: u64; }\nfun down(a: ^M) M { ret a:>M; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n";
}

test "mach.lang.driver:aggregate_declassify_lowers_and_verifies" {
    var bad: i32 = 0;

    val rec_new: str = "rec K { d: [4]u8; }\nfun down(a: ^K) K { ret a:>K; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n";
    if (ut_lower_ok(rec_new) != 0) { bad = bad + 1; }

    val arr_new: str = "fun down(a: ^[4]u32) [4]u32 { ret a:>[4]u32; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n";
    if (ut_lower_ok(arr_new) != 0) { bad = bad + 4; }

    val nest_new: str = "rec Inner { x: u32; y: u32; }\nrec Outer { a: [2]Inner; b: u8; }\nfun down(a: ^Outer) Outer { ret a:>Outer; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n";
    if (ut_lower_ok(nest_new) != 0) { bad = bad + 8; }

    if (ut_lower_ok(ut_agg_strip_mixed()) != 0) { bad = bad + 16; }

    if (ut_count_declassify(rec_new) != 1) { bad = bad + 32; }

    ret bad;
}

fun ut_count_declassify(src: str) u32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 0; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 0; }
    var s:  session.Session                    = sr.ok;
    val pr: res[project.Project, outcome.Fail] = ut_vec_lower(?s, ?alloc, src, "linux");
    if (sel pr.err) {
        session.dnit(?s);
        ret 0;
    }
    var p: project.Project = pr.ok;
    val n: u32             = ut_count_op(?p, instruction.OP_DECLASSIFY);
    project.dnit_project(?p);
    session.dnit(?s);
    ret n;
}

test "mach.lang.driver:aggregate_declassify_reaches_every_backend" {
    var bad: i32 = 0;

    val rec_new: str = "rec K { d: [4]u8; }\nfun down(a: ^K) K { ret a:>K; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n";
    if (ut_codegen_target_ok(rec_new, "linux") != 0)         { bad = bad + 1; }
    if (ut_codegen_target_ok(rec_new, "linux-arm64") != 0)   { bad = bad + 2; }
    if (ut_codegen_target_ok(rec_new, "linux-riscv64") != 0) { bad = bad + 4; }

    if (ut_codegen_target_ok(ut_agg_strip_mixed(), "linux") != 0)         { bad = bad + 8; }
    if (ut_codegen_target_ok(ut_agg_strip_mixed(), "linux-arm64") != 0)   { bad = bad + 16; }
    if (ut_codegen_target_ok(ut_agg_strip_mixed(), "linux-riscv64") != 0) { bad = bad + 32; }

    ret bad;
}

val UT_AGG_SEL_REC: u32 = 0;
val UT_AGG_SEL_ARR: u32 = 1;
val UT_AGG_SEL_MIX: u32 = 2;

fun ut_agg_strip_src(buf: *u8) usize {
    var w: usize = 0;
    w      = ut_app(buf, w, "rec K { a: u32; b: u32; }\n");
    w      = ut_app(buf, w, "rec Inner { x: u32; y: u32; }\n");
    w      = ut_app(buf, w, "rec M { n: Inner; p: *u8; q: ^*u8; v: u32; }\n");
    w      = ut_app(buf, w, "#[symbol(\"_start\")]\n");
    w      = ut_app(buf, w, "fun probe(pick: i32, v: i32) i32 {\n");
    w      = ut_app(buf, w, "    val v0: u32 = v::u32;\n");
    w      = ut_app(buf, w, "    val v1: u32 = (v + 1)::u32;\n");
    w      = ut_app(buf, w, "    val v2: u32 = (v + 2)::u32;\n");
    w      = ut_app(buf, w, "    val v3: u32 = (v + 3)::u32;\n");
    w      = ut_app(buf, w, "    var k: ^K;\n");
    w      = ut_app(buf, w, "    k.a = v0;\n");
    w      = ut_app(buf, w, "    k.b = v1;\n");
    w      = ut_app(buf, w, "    if (pick == 0) { ret sum_k(k)::i32; }\n");
    w      = ut_app(buf, w, "    var arr: ^[4]u32;\n");
    w      = ut_app(buf, w, "    arr[0] = v0; arr[1] = v1; arr[2] = v2; arr[3] = v3;\n");
    w      = ut_app(buf, w, "    if (pick == 1) { ret sum_arr(arr)::i32; }\n");
    w      = ut_app(buf, w, "    var b1: u8 = 7;\n");
    w      = ut_app(buf, w, "    var b2: u8 = 9;\n");
    w      = ut_app(buf, w, "    var m: ^M;\n");
    w      = ut_app(buf, w, "    m.n.x = v0;\n");
    w      = ut_app(buf, w, "    m.n.y = v1;\n");
    w      = ut_app(buf, w, "    m.p = ?b1;\n");
    w      = ut_app(buf, w, "    m.q = ?b2;\n");
    w      = ut_app(buf, w, "    m.v = 5;\n");
    w      = ut_app(buf, w, "    if (pick == 2) { ret sum_m(m)::i32; }\n");
    w      = ut_app(buf, w, "    ret 0 - 1;\n");
    w      = ut_app(buf, w, "}\n");
    w      = ut_app(buf, w, "fun sum_k(s: ^K) u32 { val p: K = s:>K; ret p.a + p.b; }\n");
    w      = ut_app(buf, w, "fun sum_arr(s: ^[4]u32) u32 { val p: [4]u32 = s:>[4]u32; ret p[0] + p[1] + p[2] + p[3]; }\n");
    w      = ut_app(buf, w, "fun sum_m(s: ^M) u32 {\n");
    w      = ut_app(buf, w, "    val p: M = s:>M;\n");
    w      = ut_app(buf, w, "    var acc: u32 = p.n.x + p.n.y + p.v;\n");
    w      = ut_app(buf, w, "    acc = acc + (@p.p)::u32;\n");
    w      = ut_app(buf, w, "    val qq: *u8 = p.q:>*u8;\n");
    w      = ut_app(buf, w, "    ret acc + (@qq)::u32 * 10;\n");
    w      = ut_app(buf, w, "}\n");
    buf[w] = 0;
    ret w;
}

fun ut_agg_strip_run(mem: *u8, pick: u32, v: u32, out: *u32) bool {
    var args: [2]u32;
    args[0] = pick;
    args[1] = v;
    var lo:    u32 = 0;
    var hi:    u32 = 0;
    var steps: u32 = 0;
    if (!ut_rv32_run(mem, 0, ?args[0], 2, ?lo, ?hi, ?steps)) { ret false; }
    @out = lo;
    ret true;
}

test "mach.lang.driver:aggregate_declassify_executes_on_an_rv32_core_riscv32" {
    var bad:    i32          = 0;
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    val bufr: res[*u8, A.Error] = A.allocate[u8](?alloc, 8192);
    if (sel bufr.err) {
        session.dnit(?s);
        ret 1;
    }
    val srcbuf: *u8 = bufr.ok;
    ut_agg_strip_src(srcbuf);

    val memr: res[*u8, A.Error] = A.zallocate[u8](?alloc, UT_RV32_MEM);
    if (sel memr.err) {
        A.deallocate[u8](?alloc, srcbuf, 8192);
        session.dnit(?s);
        ret 1;
    }
    val mem: *u8 = memr.ok;

    var ilen: u32 = 0;
    if (!ut_rv32_build_linked(?s, ?alloc, srcbuf::str, "rv32", mem, ?ilen)) { bad = 1; }
    or {
        var got: u32 = 0;
        if (!ut_agg_strip_run(mem, UT_AGG_SEL_REC, 100, ?got)) { bad = bad + 2; }
        or (got != 201)                                        { bad = bad + 2; }
        if (!ut_agg_strip_run(mem, UT_AGG_SEL_ARR, 100, ?got)) { bad = bad + 8; }
        or (got != 406)                                        { bad = bad + 8; }
        if (!ut_agg_strip_run(mem, UT_AGG_SEL_MIX, 100, ?got)) { bad = bad + 16; }
        or (got != 303)                                        { bad = bad + 16; }
    }

    A.deallocate[u8](?alloc, mem, UT_RV32_MEM);
    A.deallocate[u8](?alloc, srcbuf, 8192);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.driver:aggregate_declassify_leaves_welded_fields_secret" {
    var bad: i32 = 0;

    val welded: str = "rec M { p: *u8; q: ^*u8; }\nfun f(a: ^M) u8 { val p: M = a:>M; ret @p.q; }\nfun main() i32 { ret 0; }\n";
    if (!ut_sema_rejects(welded)) { bad = bad + 1; }

    val plain: str = "rec M { p: *u8; q: ^*u8; }\nfun f(a: ^M) u8 { val p: M = a:>M; ret @p.p; }\nfun main() i32 { ret 0; }\n";
    if (!ut_sema_clean(plain)) { bad = bad + 2; }

    val unstripped: str = "rec M { p: *u8; q: ^*u8; }\nfun f(a: ^M) u8 { ret @a.p; }\nfun main() i32 { ret 0; }\n";
    if (!ut_sema_rejects(unstripped)) { bad = bad + 4; }

    ret bad;
}

test "mach.lang.driver:declassify_diagnostics_name_colon_gt" {
    var bad: i32 = 0;

    if (ut_vec_note("fun logf(va: ...) u32 { ret 0; }\nfun f(a: ^u32) u32 { ret logf(a); }\nfun main() i32 { ret 0; }\n",
        "declassify with `:>T` first") != 0) { bad = bad + 1; }

    if (ut_vec_note("ext fun printf(fmt: *u8, ...) i32;\nfun f(a: ^u32) i32 { ret printf(\"%u\"::*u8, a); }\nfun main() i32 { ret 0; }\n",
        "declassify with `:>T` first") != 0) { bad = bad + 2; }

    if (ut_vec_note("fun f(p: ^*u8) u8 { ret @p; }\nfun main() i32 { ret 0; }\n",
        "`:>T`-declassify the pointer when disclosure is intended") != 0) { bad = bad + 4; }

    if (!ut_sema_rejects_with("fun f(a: ^u32) u32 { ret a:>^u32; }\nfun main() i32 { ret 0; }\n",
        "a `:>T` target type must be public")) { bad = bad + 8; }

    if (!ut_sema_rejects_with("fun f(a: ^u32) u64 { ret a:>u64; }\nfun main() i32 { ret 0; }\n",
        "a `:>T` target must name the operand's stripped (public) type")) { bad = bad + 16; }

    ret bad;
}

test "mach.lang.driver:secret_variadic_rejected" {
    var bad: i32 = 0;

    val sec: str = "fun logf(va: ...) u32 { ret 0; }\nfun f(a: ^u32) u32 { ret logf(a); }\nfun main() i32 { ret 0; }\n";
    if (!ut_sema_rejects(sec))                                                { bad = 1; }
    if (ut_vec_diag(sec, "secret value cannot be passed to a variadic") != 0) { bad = 1; }

    if (!ut_sema_clean("fun logf(va: ...) u32 { ret 0; }\nfun f(a: ^u32) u32 { ret logf(a:>u32); }\nfun main() i32 { ret 0; }\n"))                                    { bad = 1; }
    if (!ut_sema_clean("fun logf(va: ...) u32 { ret 0; }\nfun f(a: u32) u32 { ret logf(a); }\nfun main() i32 { ret 0; }\n"))                                          { bad = 1; }
    if (!ut_sema_rejects("fun logf(va: ...) u32 { ret 0; }\nrec P { x: ^u32; }\nfun f(a: P) u32 { ret logf(a); }\nfun main() i32 { ret 0; }\n"))                      { bad = 1; }
    if (!ut_sema_rejects("fun logf(va: ...) u32 { ret 0; }\nrec I { s: ^u32; }\nrec O { inner: I; }\nfun f(a: O) u32 { ret logf(a); }\nfun main() i32 { ret 0; }\n")) { bad = 1; }
    if (!ut_sema_rejects("fun logf(va: ...) u32 { ret 0; }\nuni U { s: ^u32; t: ^u32; }\nfun f(a: U) u32 { ret logf(a); }\nfun main() i32 { ret 0; }\n"))             { bad = 1; }
    if (!ut_sema_rejects("fun logf(va: ...) u32 { ret 0; }\nfun f(a: [4]^u32) u32 { ret logf(a); }\nfun main() i32 { ret 0; }\n"))                                    { bad = 1; }
    if (!ut_sema_rejects("fun logf(va: ...) u32 { ret 0; }\nfun f(a: *^u8) u32 { ret logf(a); }\nfun main() i32 { ret 0; }\n"))                                       { bad = 1; }

    if (!ut_sema_clean("fun logf(va: ...) u32 { ret 0; }\nrec Q { x: u32; y: u32; }\nfun f(a: Q) u32 { ret logf(a); }\nfun main() i32 { ret 0; }\n")) { bad = 1; }

    if (!ut_sema_rejects("fun logf(va: ...) u32 { ret 0; }\nrec Box[T] { v: T; }\nfun mk[T](x: T) Box[T] { var b: Box[T]; b.v = x; ret b; }\nfun f(s: ^u32) u32 { ret logf(mk[^u32](s)); }\nfun main() i32 { ret 0; }\n")) { bad = 1; }
    if (!ut_sema_rejects("fun logf(va: ...) u32 { ret 0; }\nrec Box[T] { v: T; }\nfun f(s: ^u32) u32 { var b: Box[^u32]; ret logf(b); }\nfun main() i32 { ret 0; }\n"))                                                    { bad = 1; }
    if (!ut_sema_rejects("fun logf(va: ...) u32 { ret 0; }\nrec Box[T] { v: T; }\nfun f(s: ^u32) u32 { var b: Box[Box[^u32]]; ret logf(b); }\nfun main() i32 { ret 0; }\n"))                                               { bad = 1; }
    if (!ut_sema_clean("fun logf(va: ...) u32 { ret 0; }\nrec Box[T] { v: T; }\nfun mk[T](x: T) Box[T] { var b: Box[T]; b.v = x; ret b; }\nfun f() u32 { ret logf(mk[u32](5)); }\nfun main() i32 { ret 0; }\n"))           { bad = 1; }
    if (!ut_sema_clean("fun logf(va: ...) u32 { ret 0; }\nrec Box[T] { v: T; }\nfun f() u32 { var b: Box[u32]; ret logf(b); }\nfun main() i32 { ret 0; }\n"))                                                              { bad = 1; }
    if (!ut_sema_rejects("fun logf(va: ...) u32 { ret 0; }\nrec N { next: *N; s: ^u32; }\nfun f(a: N) u32 { ret logf(a); }\nfun main() i32 { ret 0; }\n"))                                                                 { bad = 1; }
    if (!ut_sema_clean("fun logf(va: ...) u32 { ret 0; }\nrec N { next: *N; v: u32; }\nfun f(a: N) u32 { ret logf(a); }\nfun main() i32 { ret 0; }\n"))                                                                    { bad = 1; }

    if (!ut_sema_clean("fun takes(a: ^u32) u32 { ret a:>u32; }\nfun f(a: ^u32) u32 { ret takes(a); }\nfun main() i32 { ret 0; }\n")) { bad = 1; }
    ret bad;
}

test "mach.lang.driver:deep_secrecy_pointer_and_union" {
    var bad: i32 = 0;

    val erase: str = "rec P { x: ^u32; }\nfun e(p: *P) ptr { ret p::ptr; }\nfun main() i32 { ret 0; }\n";
    if (!ut_sema_rejects(erase))                                                                                         { bad = 1; }
    if (ut_vec_diag(erase, "secret-welded pointer cannot be erased") != 0)                                               { bad = 1; }
    if (!ut_sema_rejects("rec Box[T] { v: T; }\nfun e(p: *Box[^u32]) ptr { ret p::ptr; }\nfun main() i32 { ret 0; }\n")) { bad = 1; }
    if (!ut_sema_clean("rec R { x: u32; }\nfun e(p: *R) ptr { ret p::ptr; }\nfun main() i32 { ret 0; }\n"))              { bad = 1; }

    if (!ut_sema_rejects("rec P { x: ^u32; }\nrec Q { x: u32; }\nfun f(p: *P) *Q { ret p:~*Q; }\nfun main() i32 { ret 0; }\n"))           { bad = 1; }
    if (!ut_sema_rejects("rec P { x: ^u32; }\nrec Q { x: u32; }\nfun f(p: *P) *Q { ret p::*Q; }\nfun main() i32 { ret 0; }\n"))           { bad = 1; }
    if (!ut_sema_rejects("rec Box[T] { v: T; }\nrec Q { x: u32; }\nfun f(p: *Box[^u32]) *Q { ret p:~*Q; }\nfun main() i32 { ret 0; }\n")) { bad = 1; }
    if (!ut_sema_clean("fun f(a: ^u32) ^i32 { ret a:~^i32; }\nfun main() i32 { ret 0; }\n"))                                              { bad = 1; }
    if (!ut_sema_clean("rec A { x: u32; }\nrec B { y: u32; }\nfun f(p: *A) *B { ret p:~*B; }\nfun main() i32 { ret 0; }\n"))              { bad = 1; }

    val pun: str = "rec P { x: ^u32; }\nrec Q { x: u32; }\nuni U { a: P; b: Q; }\nfun main() i32 { ret 0; }\n";
    if (!ut_sema_rejects(pun))                                                                                                   { bad = 1; }
    if (ut_vec_diag(pun, "union variants must agree on secrecy") != 0)                                                           { bad = 1; }
    if (!ut_sema_rejects("rec Box[T] { v: T; }\nrec Q { x: u32; }\nuni U { a: Box[^u32]; b: Q; }\nfun main() i32 { ret 0; }\n")) { bad = 1; }
    if (!ut_sema_rejects("uni U { a: ^u32; b: u32; }\nfun main() i32 { ret 0; }\n"))                                             { bad = 1; }
    if (!ut_sema_clean("uni U { a: ^u32; b: ^u32; }\nfun main() i32 { ret 0; }\n"))                                              { bad = 1; }
    if (!ut_sema_clean("rec A { x: u32; }\nrec B { y: u32; }\nuni U { a: A; b: B; }\nfun main() i32 { ret 0; }\n"))              { bad = 1; }
    if (!ut_sema_clean("rec A { x: ^u32; }\nrec B { x: ^u32; y: ^u32; }\nuni U { a: A; b: B; }\nfun main() i32 { ret 0; }\n"))   { bad = 1; }

    if (!ut_sema_rejects("fun f(a: *^u32) u64 { ret a:~u64; }\nfun main() i32 { ret 0; }\n"))                  { bad = 1; }
    if (!ut_sema_rejects("fun f(a: *^u32) u64 { ret a::u64; }\nfun main() i32 { ret 0; }\n"))                  { bad = 1; }
    if (!ut_sema_rejects("rec P { x: ^u32; }\nfun f(a: *P) u64 { ret a:~u64; }\nfun main() i32 { ret 0; }\n")) { bad = 1; }
    if (!ut_sema_clean("fun f(a: *u32) u64 { ret a:~u64; }\nfun main() i32 { ret 0; }\n"))                     { bad = 1; }
    if (!ut_sema_clean("fun f(a: *^u32) *^i32 { ret a:~*^i32; }\nfun main() i32 { ret 0; }\n"))                { bad = 1; }

    if (!ut_sema_rejects("fun id(x: u32) u32 { ret x; }\nfun f() fun(^u32) u32 { ret id :~ fun(^u32) u32; }\nfun main() i32 { ret 0; }\n"))                 { bad = 1; }
    if (!ut_sema_rejects("fun id(x: u32) u32 { ret x; }\nfun f() fun(^u32) u32 { ret id :: fun(^u32) u32; }\nfun main() i32 { ret 0; }\n"))                 { bad = 1; }
    if (!ut_sema_rejects("fun sr(x: u32) ^u32 { var y: ^u32 = x; ret y; }\nfun f() fun(u32) u32 { ret sr :~ fun(u32) u32; }\nfun main() i32 { ret 0; }\n")) { bad = 1; }
    if (!ut_sema_rejects("fun id(x: ^u32) u32 { ret x:>u32; }\nfun f() u64 { ret id :~ u64; }\nfun main() i32 { ret 0; }\n"))                               { bad = 1; }
    if (!ut_sema_clean("fun id(x: ^u32) u32 { ret x:>u32; }\nfun f() fun(^u32) u32 { ret id :~ fun(^u32) u32; }\nfun main() i32 { ret 0; }\n"))             { bad = 1; }
    if (!ut_sema_clean("fun id(x: u32) u32 { ret x; }\nfun f() fun(u32) u32 { ret id :~ fun(u32) u32; }\nfun main() i32 { ret 0; }\n"))                     { bad = 1; }

    ret bad;
}

fun ut_chain_src(alloc: *A.Allocator, n: u32, r0: str, tail: str) err[fail.Fail] {
    val head: res[str, format.FormatError] = format.sprint(alloc, "rec R0 {{ {} }}\n", r0);
    if (sel head.err) { ret err[fail.Fail].ok{}; }
    var acc: str = head.ok;

    var i: u32 = 1;
    for (i < n) {
        val next: res[str, format.FormatError] = format.sprint(alloc, "{}rec R{} {{ a: R{}; }}\n", acc, i, i - 1);
        A.deallocate[char](alloc, acc::*char, str_len(acc) + 1);
        if (sel next.err) { ret err[fail.Fail].ok{}; }
        acc = next.ok;
        i   = i + 1;
    }

    val whole: res[str, format.FormatError] = format.sprint(alloc, "{}{}", acc, tail);
    A.deallocate[char](alloc, acc::*char, str_len(acc) + 1);
    if (sel whole.err) { ret err[fail.Fail].ok{}; }
    ret err[fail.Fail].err{fail.message(whole.ok)};
}

test "mach.lang.driver:deep_secret_walk_scales_with_the_type_graph" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var bad: i32 = 0;

    val n: u32 = 320;

    val tr: res[str, format.FormatError] = format.sprint(?alloc, "fun e(p: *R{}) ptr {{ ret p::ptr; }}\nfun main() i32 {{ ret 0; }}\n", n - 1);
    if (sel tr.err) { ret 1; }
    val tail: str = tr.ok;

    val br: res[str, format.FormatError] = format.sprint(?alloc, "a: *R{};", n - 1);
    if (sel br.err) { ret 1; }
    val back: str = br.ok;

    val pub_src: err[fail.Fail] = ut_chain_src(?alloc, n, "a: u32;", tail);
    if (sel pub_src.ok) { bad = 1; }
    if (sel pub_src.err) {
        val src: str = fail.describe(pub_src.err);
        if (!ut_sema_clean(src)) { bad = 1; }
        A.deallocate[char](?alloc, src::*char, str_len(src) + 1);
    }

    val sec_src: err[fail.Fail] = ut_chain_src(?alloc, n, "a: ^u32;", tail);
    if (sel sec_src.ok) { bad = 1; }
    if (sel sec_src.err) {
        val src: str = fail.describe(sec_src.err);
        if (ut_vec_diag(src, "secret-welded pointer cannot be erased") != 0) { bad = 1; }
        A.deallocate[char](?alloc, src::*char, str_len(src) + 1);
    }

    val cyc_src: err[fail.Fail] = ut_chain_src(?alloc, n, back, tail);
    if (sel cyc_src.ok) { bad = 1; }
    if (sel cyc_src.err) {
        val src: str = fail.describe(cyc_src.err);
        if (!ut_sema_clean(src)) { bad = 1; }
        A.deallocate[char](?alloc, src::*char, str_len(src) + 1);
    }

    A.deallocate[char](?alloc, back::*char, str_len(back) + 1);
    A.deallocate[char](?alloc, tail::*char, str_len(tail) + 1);
    ret bad;
}

test "mach.lang.driver:uni_instance_walk_scales_with_the_type_graph" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var bad: i32 = 0;

    val n: u32 = 320;

    val tr: res[str, format.FormatError] = format.sprint(?alloc, "uni U[T] {{ a: T; b: u32; }}\nfun e(p: *R{}) u32 {{ ret 0; }}\nfun main() i32 {{ ret 0; }}\n", n - 1);
    if (sel tr.err) { ret 1; }
    val tail: str = tr.ok;

    val br: res[str, format.FormatError] = format.sprint(?alloc, "a: ^u32; b: *R{};", n - 1);
    if (sel br.err) { ret 1; }
    val back: str = br.ok;

    val plain_src: err[fail.Fail] = ut_chain_src(?alloc, n, "a: ^u32;", tail);
    if (sel plain_src.ok) { bad = 1; }
    if (sel plain_src.err) {
        val src: str = fail.describe(plain_src.err);
        if (!ut_sema_clean(src)) { bad = 1; }
        A.deallocate[char](?alloc, src::*char, str_len(src) + 1);
    }

    val mixed_src: err[fail.Fail] = ut_chain_src(?alloc, n, "a: ^u32; u: U[^u32];", tail);
    if (sel mixed_src.ok) { bad = 1; }
    if (sel mixed_src.err) {
        val src: str = fail.describe(mixed_src.err);
        if (ut_vec_diag(src, "union variants must agree on secrecy") != 0) { bad = 1; }
        if (ut_vec_diag(src, "too large") == 0)                            { bad = 1; }
        A.deallocate[char](?alloc, src::*char, str_len(src) + 1);
    }

    val ok_src: err[fail.Fail] = ut_chain_src(?alloc, n, "a: ^u32; u: U[u32];", tail);
    if (sel ok_src.ok) { bad = 1; }
    if (sel ok_src.err) {
        val src: str = fail.describe(ok_src.err);
        if (!ut_sema_clean(src)) { bad = 1; }
        A.deallocate[char](?alloc, src::*char, str_len(src) + 1);
    }

    val cyc_src: err[fail.Fail] = ut_chain_src(?alloc, n, back, tail);
    if (sel cyc_src.ok) { bad = 1; }
    if (sel cyc_src.err) {
        val src: str = fail.describe(cyc_src.err);
        if (!ut_sema_clean(src)) { bad = 1; }
        A.deallocate[char](?alloc, src::*char, str_len(src) + 1);
    }

    A.deallocate[char](?alloc, back::*char, str_len(back) + 1);
    A.deallocate[char](?alloc, tail::*char, str_len(tail) + 1);
    ret bad;
}

fun ut_fanout_src(alloc: *A.Allocator, p: str, n: u32, last: str) err[fail.Fail] {
    var acc: str = "";
    var i:   u32 = 0;
    for (i < n) {
        var body: str = "a: u32; b: u32;";
        if (i == n - 1) { body = last; }
        val next: res[str, format.FormatError] = format.sprint(alloc, "{}rec {}{} {{ {} }}\n", acc, p, i, body);
        if (i > 0)        { A.deallocate[char](alloc, acc::*char, str_len(acc) + 1); }
        if (sel next.err) { ret err[fail.Fail].ok{}; }
        acc = next.ok;
        i   = i + 1;
    }

    val open: res[str, format.FormatError] = format.sprint(alloc, "{}rec {}P {{", acc, p);
    if (n > 0)        { A.deallocate[char](alloc, acc::*char, str_len(acc) + 1); }
    if (sel open.err) { ret err[fail.Fail].ok{}; }
    acc = open.ok;

    i = 0;
    for (i < n) {
        val fld: res[str, format.FormatError] = format.sprint(alloc, "{} f{}: {}{};", acc, i, p, i);
        A.deallocate[char](alloc, acc::*char, str_len(acc) + 1);
        if (sel fld.err) { ret err[fail.Fail].ok{}; }
        acc = fld.ok;
        i   = i + 1;
    }

    val close: res[str, format.FormatError] = format.sprint(alloc, "{} }}\n", acc);
    A.deallocate[char](alloc, acc::*char, str_len(acc) + 1);
    if (sel close.err) { ret err[fail.Fail].ok{}; }
    ret err[fail.Fail].err{fail.message(close.ok)};
}

fun ut_pair_src(alloc: *A.Allocator, n: u32, a_last: str, b_last: str, tail: str) err[fail.Fail] {
    val fa: err[fail.Fail] = ut_fanout_src(alloc, "A", n, a_last);
    if (sel fa.ok) { ret err[fail.Fail].ok{}; }
    val sa: str = fail.describe(fa.err);

    val fb: err[fail.Fail] = ut_fanout_src(alloc, "B", n, b_last);
    if (sel fb.ok) {
        A.deallocate[char](alloc, sa::*char, str_len(sa) + 1);
        ret err[fail.Fail].ok{};
    }
    val sb: str = fail.describe(fb.err);

    val whole: res[str, format.FormatError] = format.sprint(alloc, "{}{}{}", sa, sb, tail);
    A.deallocate[char](alloc, sa::*char, str_len(sa) + 1);
    A.deallocate[char](alloc, sb::*char, str_len(sb) + 1);
    if (sel whole.err) { ret err[fail.Fail].ok{}; }
    ret err[fail.Fail].err{fail.message(whole.ok)};
}

test "mach.lang.driver:secrecy_pair_walk_scales_with_the_type_graph" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var bad: i32 = 0;

    val n: u32 = 200;

    val same_src: err[fail.Fail] = ut_pair_src(?alloc, n, "a: ^u32; b: u32;", "a: ^u32; b: u32;",
        "uni V { x: AP; y: BP; }\nfun main() i32 { var v: V; ret 0; }\n");
    if (sel same_src.ok) { bad = 1; }
    if (sel same_src.err) {
        val src: str = fail.describe(same_src.err);
        if (!ut_sema_clean(src)) { bad = 1; }
        A.deallocate[char](?alloc, src::*char, str_len(src) + 1);
    }

    val diff_src: err[fail.Fail] = ut_pair_src(?alloc, n, "a: ^u32; b: u32;", "a: u32; b: ^u32;",
        "uni V { x: AP; y: BP; }\nfun main() i32 { var v: V; ret 0; }\n");
    if (sel diff_src.ok) { bad = 1; }
    if (sel diff_src.err) {
        val src: str = fail.describe(diff_src.err);
        if (ut_vec_diag(src, "union variants must agree on secrecy") != 0) { bad = 1; }
        if (ut_vec_diag(src, "ran out of room") == 0)                      { bad = 1; }
        A.deallocate[char](?alloc, src::*char, str_len(src) + 1);
    }

    val cast_ok: err[fail.Fail] = ut_pair_src(?alloc, n, "a: ^u32; b: u32;", "a: ^u32; b: u32;",
        "fun f(p: *AP) *BP { ret p :~ *BP; }\nfun main() i32 { ret 0; }\n");
    if (sel cast_ok.ok) { bad = 1; }
    if (sel cast_ok.err) {
        val src: str = fail.describe(cast_ok.err);
        if (!ut_sema_clean(src)) { bad = 1; }
        A.deallocate[char](?alloc, src::*char, str_len(src) + 1);
    }

    val cast_bad: err[fail.Fail] = ut_pair_src(?alloc, n, "a: ^u32; b: u32;", "a: u32; b: ^u32;",
        "fun f(p: *AP) *BP { ret p :~ *BP; }\nfun main() i32 { ret 0; }\n");
    if (sel cast_bad.ok) { bad = 1; }
    if (sel cast_bad.err) {
        val src: str = fail.describe(cast_bad.err);
        if (ut_vec_diag(src, "cannot add or drop the secret qualifier") != 0) { bad = 1; }
        A.deallocate[char](?alloc, src::*char, str_len(src) + 1);
    }

    val cyc_src: err[fail.Fail] = ut_pair_src(?alloc, n, "a: ^u32; b: u32; p: *AP;", "a: ^u32; b: u32; p: *BP;",
        "uni V { x: AP; y: BP; }\nfun main() i32 { var v: V; ret 0; }\n");
    if (sel cyc_src.ok) { bad = 1; }
    if (sel cyc_src.err) {
        val src: str = fail.describe(cyc_src.err);
        if (!ut_sema_clean(src)) { bad = 1; }
        A.deallocate[char](?alloc, src::*char, str_len(src) + 1);
    }

    ret bad;
}

test "mach.lang.driver:fin_boundary_control_flow_rejected" {
    var bad: i32 = 0;
    if (!ut_sema_rejects("fun f() i64 { fin { ret 1; } ret 0; }\nfun main() i32 { ret 0; }\n"))                                                        { bad = 1; }
    if (!ut_sema_rejects("fun f() { fin { fin { ret; } } }\nfun main() i32 { ret 0; }\n"))                                                             { bad = 1; }
    if (!ut_sema_rejects("fun f() { var i: i64 = 0; for (i < 3) { fin { brk; } i = i + 1; } }\nfun main() i32 { ret 0; }\n"))                          { bad = 1; }
    if (!ut_sema_rejects("fun f() { var i: i64 = 0; for (i < 3) { fin { cnt; } i = i + 1; } }\nfun main() i32 { ret 0; }\n"))                          { bad = 1; }
    if (!ut_sema_rejects("fun f() { fin { var j: i64 = 0; for (j < 2) { fin { brk; } j = j + 1; } } }\nfun main() i32 { ret 0; }\n"))                  { bad = 1; }
    if (!ut_sema_clean("fun f() { fin { var j: i64 = 0; for (j < 4) { if (j == 2) { brk; } j = j + 1; } } }\nfun main() i32 { ret 0; }\n"))            { bad = 1; }
    if (!ut_sema_clean("fun f() { fin { var j: i64 = 0; for (j < 4) { j = j + 1; cnt; } } }\nfun main() i32 { ret 0; }\n"))                            { bad = 1; }
    if (!ut_sema_clean("fun f() i64 { var i: i64 = 0; for (i < 3) { fin { i = i + 1; } if (i == 2) { brk; } } ret i; }\nfun main() i32 { ret 0; }\n")) { bad = 1; }
    ret bad;
}

fun ut_shard_len(s: *session.Session, kind: query.QueryKind) u32 {
    ret query.shard_len(?s.queries, kind);
}

fun ut_stable_of(s: *session.Session, fqn: str) session.StableModuleId {
    val idr: res[intern.StrId, A.Error] = intern.intern(?s.interner, fqn);
    if (sel idr.err) { ret session.STABLE_MODULE_NIL; }
    ret session.stable_module_id_lookup(s, idr.ok);
}

test "mach.lang.build.engine.execute:artifact_build_roots_at_reachable_modules" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [3]str;
    names[0] = "lib.mach";
    names[1] = "probe_frag.mach";
    names[2] = "other.mach";
    var texts: [3]str;
    texts[0] = "pub fun hello() i32 { ret missing_host_function(); }\n";
    texts[1] = "#[output(0)] var out_colour: f32x4;\n\n#[stage(\"fragment\")]\nfun frag_main() {\n    out_colour = f32x4{1.0, 0.0, 0.0, 1.0};\n}\n";
    texts[2] = "pub fun touch() { missing_unrelated_function(); }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold_m(?alloc, ut_manifest_mixed_targets(), ?names[0], ?texts[0], 3);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    val mr: res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var m:  manifest.Manifest    = mr.ok;
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    rq.target       = "spirv";
    rq.artifact     = "probe_frag";
    val pr: res[bplan.BuildPlan, outcome.Fail] = bplan.plan(?alloc, ?s.interner, s.registry, ?m, rq);
    if (sel pr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var bp: bplan.BuildPlan = pr.ok;

    var bad: i32                                     = 0;
    val r:   res[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, ?alloc, nil);
    if (sel r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    if (r.ok.severity != outcome.BUILD_OK) { bad = 1; }

    val st_shader: session.StableModuleId = ut_stable_of(?s, "mixtest.probe_frag");
    val st_host:   session.StableModuleId = ut_stable_of(?s, "mixtest.lib");
    val st_other:  session.StableModuleId = ut_stable_of(?s, "mixtest.other");
    if (st_shader == session.STABLE_MODULE_NIL)                                { bad = 1; }
    if (st_host != session.STABLE_MODULE_NIL)                                  { bad = 1; }
    if (st_other != session.STABLE_MODULE_NIL)                                 { bad = 1; }
    if (query.peek_revision(?s.queries, query.Q_SEMA, st_shader::u64) == 0)    { bad = 1; }
    if (query.peek_revision(?s.queries, query.Q_CODEGEN, st_shader::u64) == 0) { bad = 1; }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.build.engine.execute_warm:blocked_output_directory_is_environmental" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = ut_cc3(?alloc, "#[symbol(\"", ut_entry_symbol(), "\")]\nfun start() i32 { ret 0; }\n");
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    val out_path: str             = ut_cc3(?alloc, root, "/", "out");
    val blk:      err[fs.FsError] = fs.write_bytes(out_path, "blocked", 7, 420);
    if (sel blk.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }

    val mr: res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var m:  manifest.Manifest    = mr.ok;
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    val pr: res[bplan.BuildPlan, outcome.Fail] = bplan.plan(?alloc, ?s.interner, s.registry, ?m, rq);
    if (sel pr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var bp: bplan.BuildPlan = pr.ok;

    var bad: i32                                     = 0;
    val r:   res[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, ?alloc, nil);
    if (sel r.err) { bad = 1; }
    if (sel r.ok) {
        val bo: outcome.BuildOutcome = r.ok;
        if (bo.severity != outcome.BUILD_ENVIRONMENT) { bad = 1; }
    }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.build.engine.execute_warm:unchanged_rebuild_reuses_and_stays_bounded" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [3]str;
    names[0] = "main.mach";
    names[1] = "a.mach";
    names[2] = "b.mach";
    var texts: [3]str;
    texts[0] = ut_cc3(?alloc, "use uniontest.a.fa;\nuse uniontest.b.fb;\n#[symbol(\"", ut_entry_symbol(), "\")]\nfun start() i32 { ret fa() + fb(); }\n");
    texts[1] = "pub fun fa() i32 { ret 1; }\n";
    texts[2] = "pub fun fb() i32 { ret 2; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 3);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    val mr: res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var m:  manifest.Manifest    = mr.ok;
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    val pr: res[bplan.BuildPlan, outcome.Fail] = bplan.plan(?alloc, ?s.interner, s.registry, ?m, rq);
    if (sel pr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var bp: bplan.BuildPlan = pr.ok;

    var bad: i32 = 0;

    val r1: res[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, ?alloc, nil);
    if (sel r1.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    val bo1: outcome.BuildOutcome = r1.ok;
    if (bo1.severity != outcome.BUILD_OK) { bad = 1; }
    if (bo1.artifacts.len != 1)           { bad = 1; }
    or {
        val is_file_r: res[bool, io_error.Error] = fs.is_file(bo1.artifacts.data[0].path);
        if (sel is_file_r.err)                   { ret 99; }
        if (!(sel is_file_r.ok && is_file_r.ok)) { bad = 1; }
    }

    val st_main: session.StableModuleId = ut_stable_of(?s, "uniontest.main");
    val st_a:    session.StableModuleId = ut_stable_of(?s, "uniontest.a");
    val st_b:    session.StableModuleId = ut_stable_of(?s, "uniontest.b");
    if (st_main == session.STABLE_MODULE_NIL || st_a == session.STABLE_MODULE_NIL || st_b == session.STABLE_MODULE_NIL) { bad = 1; }

    val sema_a_1: query.Revision = query.peek_revision(?s.queries, query.Q_SEMA, st_a::u64);
    val low_a_1:  query.Revision = query.peek_revision(?s.queries, query.Q_LOWER, st_a::u64);
    val cg_m_1:   query.Revision = query.peek_revision(?s.queries, query.Q_CODEGEN, st_main::u64);
    val cg_a_1:   query.Revision = query.peek_revision(?s.queries, query.Q_CODEGEN, st_a::u64);
    val cg_b_1:   query.Revision = query.peek_revision(?s.queries, query.Q_CODEGEN, st_b::u64);
    val lk_1:     query.Revision = query.peek_revision(?s.queries, query.Q_LINK, 0);
    if (sema_a_1 == 0 || low_a_1 == 0 || cg_m_1 == 0 || cg_a_1 == 0 || cg_b_1 == 0 || lk_1 == 0) { bad = 1; }
    val interned_1: usize = intern.count(?s.interner);
    val sources_1:  usize = s.sources.len;
    val n_parse_1:  u32   = ut_shard_len(?s, query.Q_PARSE);
    val n_sema_1:   u32   = ut_shard_len(?s, query.Q_SEMA);
    val n_low_1:    u32   = ut_shard_len(?s, query.Q_LOWER);
    val n_cg_1:     u32   = ut_shard_len(?s, query.Q_CODEGEN);

    val r2: res[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, ?alloc, nil);
    if (sel r2.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    if (r2.ok.severity != outcome.BUILD_OK)                                       { bad = 1; }
    if (query.peek_revision(?s.queries, query.Q_SEMA, st_a::u64) != sema_a_1)     { bad = 1; }
    if (query.peek_revision(?s.queries, query.Q_LOWER, st_a::u64) != low_a_1)     { bad = 1; }
    if (query.peek_revision(?s.queries, query.Q_CODEGEN, st_main::u64) != cg_m_1) { bad = 1; }
    if (query.peek_revision(?s.queries, query.Q_CODEGEN, st_a::u64) != cg_a_1)    { bad = 1; }
    if (query.peek_revision(?s.queries, query.Q_CODEGEN, st_b::u64) != cg_b_1)    { bad = 1; }
    if (query.peek_revision(?s.queries, query.Q_LINK, 0) != lk_1)                 { bad = 1; }
    if (intern.count(?s.interner) != interned_1)                                  { bad = 1; }
    if (s.sources.len != sources_1)                                               { bad = 1; }
    if (ut_shard_len(?s, query.Q_PARSE) != n_parse_1)                             { bad = 1; }
    if (ut_shard_len(?s, query.Q_SEMA) != n_sema_1)                               { bad = 1; }
    if (ut_shard_len(?s, query.Q_LOWER) != n_low_1)                               { bad = 1; }
    if (ut_shard_len(?s, query.Q_CODEGEN) != n_cg_1)                              { bad = 1; }

    val src_dir:       str             = ut_cc3(?alloc, root, "/", "src");
    val a_path:        str             = ut_cc3(?alloc, src_dir, "/", "a.mach");
    val a_v2:          str             = "pub fun fa() i32 { val t: i32 = 1; ret t; }\n";
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(a_path, a_v2, str_len(a_v2), 420);
    if (sel write_bytes_r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }

    val r3: res[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, ?alloc, nil);
    if (sel r3.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    if (r3.ok.severity != outcome.BUILD_OK)                                    { bad = 1; }
    if (query.peek_revision(?s.queries, query.Q_CODEGEN, st_a::u64) == cg_a_1) { bad = 1; }
    if (query.peek_revision(?s.queries, query.Q_CODEGEN, st_b::u64) != cg_b_1) { bad = 1; }
    if (query.peek_revision(?s.queries, query.Q_LINK, 0) == lk_1)              { bad = 1; }
    if (s.sources.len != sources_1)                                            { bad = 1; }
    if (ut_shard_len(?s, query.Q_PARSE) != n_parse_1)                          { bad = 1; }
    if (ut_shard_len(?s, query.Q_SEMA) != n_sema_1)                            { bad = 1; }
    if (ut_shard_len(?s, query.Q_LOWER) != n_low_1)                            { bad = 1; }
    if (ut_shard_len(?s, query.Q_CODEGEN) != n_cg_1)                           { bad = 1; }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.build.engine.execute_warm:tampered_artifact_forces_relink_not_silent_reuse" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [3]str;
    names[0] = "main.mach";
    names[1] = "a.mach";
    names[2] = "b.mach";
    var texts: [3]str;
    texts[0] = ut_cc3(?alloc, "use uniontest.a.fa;\nuse uniontest.b.fb;\n#[symbol(\"", ut_entry_symbol(), "\")]\nfun start() i32 { ret fa() + fb(); }\n");
    texts[1] = "pub fun fa() i32 { ret 1; }\n";
    texts[2] = "pub fun fb() i32 { ret 2; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 3);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    val mr: res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var m:  manifest.Manifest    = mr.ok;
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    val pr: res[bplan.BuildPlan, outcome.Fail] = bplan.plan(?alloc, ?s.interner, s.registry, ?m, rq);
    if (sel pr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var bp: bplan.BuildPlan = pr.ok;

    var bad: i32 = 0;

    val r1: res[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, ?alloc, nil);
    if (sel r1.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    val bo1: outcome.BuildOutcome = r1.ok;
    if (bo1.severity != outcome.BUILD_OK) { bad = 1; }
    or (bo1.artifacts.len != 1)           { bad = 1; }
    or {
        val is_file_r: res[bool, io_error.Error] = fs.is_file(bo1.artifacts.data[0].path);
        if (sel is_file_r.err)                   { ret 99; }
        if (!(sel is_file_r.ok && is_file_r.ok)) { bad = 1; }
    }
    val artifact: str = bo1.artifacts.data[0].path;

    val lk_1: query.Revision = query.peek_revision(?s.queries, query.Q_LINK, 0);
    if (lk_1 == 0) { bad = 1; }

    val marker:        str             = "TAMPERED-DEFECT-B-MARKER-NOT-A-REAL-BINARY";
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(artifact, marker, str_len(marker), 420);
    if (sel write_bytes_r.err) { bad = 1; }

    val r2: res[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, ?alloc, nil);
    if (sel r2.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    val bo2: outcome.BuildOutcome = r2.ok;
    if (bo2.severity != outcome.BUILD_OK) { bad = 1; }

    val lk_2: query.Revision = query.peek_revision(?s.queries, query.Q_LINK, 0);
    if (lk_2 != lk_1) { bad = 1; }

    val rr: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, artifact);
    if (sel rr.err) { bad = 1; }
    if (sel rr.ok) {
        var buf:            Vector[u8] = rr.ok;
        val mbytes:         *u8        = marker::*u8;
        val mlen:           usize      = str_len(marker);
        var matches_marker: bool       = buf.len::usize == mlen;
        if (matches_marker) {
            var i: usize = 0;
            for (i < mlen) {
                if (buf.data[i] != mbytes[i]) {
                    matches_marker = false;
                    brk;
                }
                i = i + 1;
            }
        }
        if (matches_marker) { bad = 1; }
        vector.dnit[u8](?buf);
    }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.build.engine.execute_warm:failed_link_retries_at_unchanged_revision" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = ut_cc3(?alloc, "#[symbol(\"", ut_entry_symbol(), "\")]\nfun start() i32 { ret 0; }\n\ntest \"main.zero\" { ret 0; }\n");
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    val mr: res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var m:  manifest.Manifest    = mr.ok;
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    rq.goal         = request.GOAL_TESTS;
    val pr: res[bplan.BuildPlan, outcome.Fail] = bplan.plan(?alloc, ?s.interner, s.registry, ?m, rq);
    if (sel pr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var bp: bplan.BuildPlan = pr.ok;

    val artifact:         str             = bp.units.data[0].out_path;
    val create_dir_all_r: err[fs.FsError] = fs.create_dir_all(?alloc, artifact, 493);
    if (sel create_dir_all_r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }

    var bad: i32                                     = 0;
    val r1:  res[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, ?alloc, nil);
    if (sel r1.err) { bad = 1; }
    if (sel r1.ok) {
        val bo1: outcome.BuildOutcome = r1.ok;
        if (bo1.severity == outcome.BUILD_OK) { bad = 1; }
    }

    val lk_1: query.Revision = query.peek_revision(?s.queries, query.Q_LINK, 0);
    if (lk_1 == 0) { bad = 1; }
    fs.remove_all(?alloc, artifact);

    val r2: res[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, ?alloc, nil);
    if (sel r2.err) { bad = 1; }
    if (sel r2.ok) {
        val bo2: outcome.BuildOutcome = r2.ok;
        if (bo2.severity != outcome.BUILD_OK) { bad = 1; }
    }
    if (query.peek_revision(?s.queries, query.Q_LINK, 0) != lk_1) { bad = 1; }
    val is_file_r: res[bool, io_error.Error] = fs.is_file(artifact);
    if (sel is_file_r.err)                   { ret 99; }
    if (!(sel is_file_r.ok && is_file_r.ok)) { bad = 1; }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.build.engine.execute_warm:jobs_flip_holds_all_revisions" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [3]str;
    names[0] = "main.mach";
    names[1] = "a.mach";
    names[2] = "b.mach";
    var texts: [3]str;
    texts[0] = ut_cc3(?alloc, "use uniontest.a.fa;\nuse uniontest.b.fb;\n#[symbol(\"", ut_entry_symbol(), "\")]\nfun start() i32 { ret fa() + fb(); }\n");
    texts[1] = "pub fun fa() i32 { ret 1; }\n";
    texts[2] = "pub fun fb() i32 { ret 2; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 3);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    val mr: res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var m:  manifest.Manifest    = mr.ok;
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    rq.jobs         = 1;
    val pr: res[bplan.BuildPlan, outcome.Fail] = bplan.plan(?alloc, ?s.interner, s.registry, ?m, rq);
    if (sel pr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var bp: bplan.BuildPlan = pr.ok;

    var bad: i32 = 0;

    val r1: res[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, ?alloc, nil);
    if (sel r1.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    if (r1.ok.severity != outcome.BUILD_OK) { bad = 1; }

    val st_main: session.StableModuleId = ut_stable_of(?s, "uniontest.main");
    val st_a:    session.StableModuleId = ut_stable_of(?s, "uniontest.a");
    val st_b:    session.StableModuleId = ut_stable_of(?s, "uniontest.b");
    if (st_main == session.STABLE_MODULE_NIL || st_a == session.STABLE_MODULE_NIL || st_b == session.STABLE_MODULE_NIL) { bad = 1; }

    val tgt_1:   query.Revision = query.peek_revision(?s.queries, query.Q_TARGET, 0);
    val res_a1:  query.Revision = query.peek_revision(?s.queries, query.Q_RESOLVE, st_a::u64);
    val sema_a1: query.Revision = query.peek_revision(?s.queries, query.Q_SEMA, st_a::u64);
    val low_a1:  query.Revision = query.peek_revision(?s.queries, query.Q_LOWER, st_a::u64);
    val cg_m1:   query.Revision = query.peek_revision(?s.queries, query.Q_CODEGEN, st_main::u64);
    val cg_a1:   query.Revision = query.peek_revision(?s.queries, query.Q_CODEGEN, st_a::u64);
    val cg_b1:   query.Revision = query.peek_revision(?s.queries, query.Q_CODEGEN, st_b::u64);
    val lk_1:    query.Revision = query.peek_revision(?s.queries, query.Q_LINK, 0);
    if (tgt_1 == 0 || res_a1 == 0 || sema_a1 == 0 || low_a1 == 0 || cg_m1 == 0 || cg_a1 == 0 || cg_b1 == 0 || lk_1 == 0) { bad = 1; }
    val n_parse_1: u32 = ut_shard_len(?s, query.Q_PARSE);
    val n_sema_1:  u32 = ut_shard_len(?s, query.Q_SEMA);
    val n_low_1:   u32 = ut_shard_len(?s, query.Q_LOWER);
    val n_cg_1:    u32 = ut_shard_len(?s, query.Q_CODEGEN);

    rq.jobs = 4;
    val r2: res[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, ?alloc, nil);
    if (sel r2.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    if (r2.ok.severity != outcome.BUILD_OK) { bad = 1; }

    if (query.peek_revision(?s.queries, query.Q_TARGET, 0) != tgt_1)             { bad = 1; }
    if (query.peek_revision(?s.queries, query.Q_RESOLVE, st_a::u64) != res_a1)   { bad = 1; }
    if (query.peek_revision(?s.queries, query.Q_SEMA, st_a::u64) != sema_a1)     { bad = 1; }
    if (query.peek_revision(?s.queries, query.Q_LOWER, st_a::u64) != low_a1)     { bad = 1; }
    if (query.peek_revision(?s.queries, query.Q_CODEGEN, st_main::u64) != cg_m1) { bad = 1; }
    if (query.peek_revision(?s.queries, query.Q_CODEGEN, st_a::u64) != cg_a1)    { bad = 1; }
    if (query.peek_revision(?s.queries, query.Q_CODEGEN, st_b::u64) != cg_b1)    { bad = 1; }
    if (query.peek_revision(?s.queries, query.Q_LINK, 0) != lk_1)                { bad = 1; }
    if (ut_shard_len(?s, query.Q_PARSE) != n_parse_1)                            { bad = 1; }
    if (ut_shard_len(?s, query.Q_SEMA) != n_sema_1)                              { bad = 1; }
    if (ut_shard_len(?s, query.Q_LOWER) != n_low_1)                              { bad = 1; }
    if (ut_shard_len(?s, query.Q_CODEGEN) != n_cg_1)                             { bad = 1; }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.build.engine.execute_warm:parallel_pool_rebuilds_only_stale_modules" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [4]str;
    names[0] = "main.mach";
    names[1] = "a.mach";
    names[2] = "b.mach";
    names[3] = "c.mach";
    var texts: [4]str;
    texts[0] = ut_cc3(?alloc, "use uniontest.a.fa;\nuse uniontest.b.fb;\nuse uniontest.c.fc;\n#[symbol(\"", ut_entry_symbol(), "\")]\nfun start() i32 { ret fa() + fb() + fc(); }\n");
    texts[1] = "pub fun fa() i32 { ret 1; }\n";
    texts[2] = "pub fun fb() i32 { ret 2; }\n";
    texts[3] = "pub fun fc() i32 { ret 3; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 4);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    val mr: res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var m:  manifest.Manifest    = mr.ok;
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    rq.jobs         = 2;
    val pr: res[bplan.BuildPlan, outcome.Fail] = bplan.plan(?alloc, ?s.interner, s.registry, ?m, rq);
    if (sel pr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var bp: bplan.BuildPlan = pr.ok;

    var bad: i32 = 0;

    val r1: res[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, ?alloc, nil);
    if (sel r1.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    val bo1: outcome.BuildOutcome = r1.ok;
    if (bo1.severity != outcome.BUILD_OK) { bad = 1; }
    if (bo1.artifacts.len != 1)           { bad = 1; }
    or {
        val is_file_r: res[bool, io_error.Error] = fs.is_file(bo1.artifacts.data[0].path);
        if (sel is_file_r.err)                   { ret 99; }
        if (!(sel is_file_r.ok && is_file_r.ok)) { bad = 1; }
    }

    val st_main: session.StableModuleId = ut_stable_of(?s, "uniontest.main");
    val st_a:    session.StableModuleId = ut_stable_of(?s, "uniontest.a");
    val st_b:    session.StableModuleId = ut_stable_of(?s, "uniontest.b");
    val st_c:    session.StableModuleId = ut_stable_of(?s, "uniontest.c");
    if (st_main == session.STABLE_MODULE_NIL || st_a == session.STABLE_MODULE_NIL
        || st_b == session.STABLE_MODULE_NIL || st_c == session.STABLE_MODULE_NIL) { bad = 1; }

    val cg_m_1: query.Revision = query.peek_revision(?s.queries, query.Q_CODEGEN, st_main::u64);
    val cg_a_1: query.Revision = query.peek_revision(?s.queries, query.Q_CODEGEN, st_a::u64);
    val cg_b_1: query.Revision = query.peek_revision(?s.queries, query.Q_CODEGEN, st_b::u64);
    val cg_c_1: query.Revision = query.peek_revision(?s.queries, query.Q_CODEGEN, st_c::u64);
    val lk_1:   query.Revision = query.peek_revision(?s.queries, query.Q_LINK, 0);
    if (cg_m_1 == 0 || cg_a_1 == 0 || cg_b_1 == 0 || cg_c_1 == 0 || lk_1 == 0) { bad = 1; }
    val n_cg_1: u32 = ut_shard_len(?s, query.Q_CODEGEN);

    val r2: res[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, ?alloc, nil);
    if (sel r2.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    if (r2.ok.severity != outcome.BUILD_OK)                                    { bad = 1; }
    if (query.peek_revision(?s.queries, query.Q_CODEGEN, st_a::u64) != cg_a_1) { bad = 1; }
    if (query.peek_revision(?s.queries, query.Q_CODEGEN, st_c::u64) != cg_c_1) { bad = 1; }
    if (query.peek_revision(?s.queries, query.Q_LINK, 0) != lk_1)              { bad = 1; }

    val src_dir:       str             = ut_cc3(?alloc, root, "/", "src");
    val a_path:        str             = ut_cc3(?alloc, src_dir, "/", "a.mach");
    val c_path:        str             = ut_cc3(?alloc, src_dir, "/", "c.mach");
    val a_v2:          str             = "pub fun fa() i32 { val t: i32 = 1; ret t; }\n";
    val c_v2:          str             = "pub fun fc() i32 { val t: i32 = 3; ret t; }\n";
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(a_path, a_v2, str_len(a_v2), 420);
    if (sel write_bytes_r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    val write_bytes_r2: err[fs.FsError] = fs.write_bytes(c_path, c_v2, str_len(c_v2), 420);
    if (sel write_bytes_r2.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }

    val r3: res[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, ?alloc, nil);
    if (sel r3.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    val bo3: outcome.BuildOutcome = r3.ok;
    if (bo3.severity != outcome.BUILD_OK) { bad = 1; }
    if (bo3.artifacts.len != 1)           { bad = 1; }
    or {
        val is_file_r2: res[bool, io_error.Error] = fs.is_file(bo3.artifacts.data[0].path);
        if (sel is_file_r2.err)                    { ret 99; }
        if (!(sel is_file_r2.ok && is_file_r2.ok)) { bad = 1; }
    }
    if (query.peek_revision(?s.queries, query.Q_CODEGEN, st_a::u64) == cg_a_1)    { bad = 1; }
    if (query.peek_revision(?s.queries, query.Q_CODEGEN, st_c::u64) == cg_c_1)    { bad = 1; }
    if (query.peek_revision(?s.queries, query.Q_CODEGEN, st_main::u64) != cg_m_1) { bad = 1; }
    if (query.peek_revision(?s.queries, query.Q_CODEGEN, st_b::u64) != cg_b_1)    { bad = 1; }
    if (query.peek_revision(?s.queries, query.Q_LINK, 0) == lk_1)                 { bad = 1; }
    if (ut_shard_len(?s, query.Q_CODEGEN) != n_cg_1)                              { bad = 1; }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

fun ut_scale_names(alloc: *A.Allocator, names: *str, texts: *str) {
    names[0] = "main.mach";
    var uses:  str = "";
    var calls: str = "";
    var i:     u32 = 1;
    for (i <= 8) {
        val idx: str = ut_u32_str(alloc, i);
        val nm:  str = ut_cc3(alloc, "m", idx, ".mach");
        names[i] = nm;
        val head: str = ut_cc3(alloc, "pub fun f", idx, "() i32 {\n    val x: f64 = ");
        val mid:  str = ut_cc3(alloc, idx, ".25;\n    val y: f64 = x * 2.0 + 0.5;\n    var acc: i32 = 0;\n    var j: i32 = 0;\n    for (j < 40) {\n        acc = acc + j * 2;\n        j = j + 1;\n    }\n    ret acc + (y::i32) + ", idx);
        val body: str = ut_cc3(alloc, head, mid, ";\n}\n");
        texts[i] = body;
        uses     = ut_cc3(alloc, uses, "use scaletest.m", ut_cc3(alloc, idx, ".f", idx));
        uses     = ut_cc3(alloc, uses, ";\n", "");
        calls    = ut_cc3(alloc, calls, "acc = acc + f", ut_cc3(alloc, idx, "();\n", ""));
        i        = i + 1;
    }
    texts[0] = ut_cc3(alloc, uses, ut_cc3(alloc, "#[symbol(\"", "_start", "\")]\n"),
        ut_cc3(alloc, "fun start() i32 {\n    var acc: i32 = 0;\n", calls, "    ret acc;\n}\n"));
}

fun ut_u32_str(alloc: *A.Allocator, v: u32) str {
    var digits: [10]u8;
    var n:      u32 = 0;
    var t:      u32 = v;
    if (t == 0) {
        digits[0] = '0';
        n         = 1;
    }
    for (t > 0) {
        digits[n] = ('0'::u32 + (t % 10))::u8;
        t         = t / 10;
        n         = n + 1;
    }
    val r: res[*u8, A.Error] = A.allocate[u8](alloc, (n + 1)::usize);
    if (sel r.err) { ret "0"; }
    val buf: *u8 = r.ok;
    var i:   u32 = 0;
    for (i < n) {
        buf[i] = digits[n - 1 - i];
        i      = i + 1;
    }
    buf[n] = 0;
    ret buf::str;
}

fun ut_build_scale(alloc: *A.Allocator, root: str, jobs: u32, out_bytes: *Vector[u8]) i32 {
    val sr: res[session.Session, fail.Fail] = session.init(alloc);
    if (sel sr.err) { ret 1; }
    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }

    val mr: res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) {
        session.dnit(?s);
        ret 1;
    }
    var m:  manifest.Manifest    = mr.ok;
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    rq.jobs         = jobs;
    rq.opt          = pipeline.OPT_RELEASE;
    rq.debug        = true;
    val pr: res[bplan.BuildPlan, outcome.Fail] = bplan.plan(alloc, ?s.interner, s.registry, ?m, rq);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var bp: bplan.BuildPlan = pr.ok;

    val r: res[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, alloc, nil);
    if (sel r.err) {
        session.dnit(?s);
        ret 1;
    }
    val bo: outcome.BuildOutcome = r.ok;
    if (bo.severity != outcome.BUILD_OK || bo.artifacts.len != 1) {
        session.dnit(?s);
        ret 1;
    }
    val is_file_r: res[bool, io_error.Error] = fs.is_file(bo.artifacts.data[0].path);
    if (sel is_file_r.err) { ret 99; }
    if (!(sel is_file_r.ok && is_file_r.ok)) {
        session.dnit(?s);
        ret 1;
    }

    val rb: res[Vector[u8], fs.FsError] = fs.read_bytes(alloc, bo.artifacts.data[0].path);
    if (sel rb.err) {
        session.dnit(?s);
        ret 1;
    }
    @out_bytes = rb.ok;

    session.dnit(?s);
    ret 0;
}

fun ut_manifest_scale() str {
    ret "[project]\nid = \"scaletest\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.linux]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[artifact.scaletest]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/scaletest\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n";
}

test "mach.lang.build.engine.execute_warm:worker_count_does_not_change_the_artifact" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }

    var names: [9]str;
    var texts: [9]str;
    ut_scale_names(?alloc, ?names[0], ?texts[0]);
    val root_r: res[str, fail.Fail] = ut_scaffold_m(?alloc, ut_manifest_scale(), ?names[0], ?texts[0], 9);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;

    var b1: Vector[u8];
    val c1: i32 = ut_build_scale(?alloc, root, 1::u32, ?b1);
    if (c1 != 0) {
        fs.remove_all(?alloc, root);
        ret 1;
    }
    var b6: Vector[u8];
    val c6: i32 = ut_build_scale(?alloc, root, 6::u32, ?b6);
    fs.remove_all(?alloc, root);
    if (c6 != 0) { ret 1; }

    if (b1.len != b6.len) { ret 1; }
    var i: usize = 0;
    for (i < b1.len) {
        if (b1.data[i] != b6.data[i]) { ret 1; }
        i = i + 1;
    }
    ret 0;
}

test "mach.lang.build.engine.execute_warm:replaced_image_owns_section_bytes" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }

    val LIT: str = "warm-owned-section-bytes";

    var names: [3]str;
    names[0] = "main.mach";
    names[1] = "a.mach";
    names[2] = "b.mach";
    var texts: [3]str;
    texts[0] = ut_cc3(?alloc, "use uniontest.a.greeting;\n#[symbol(\"", ut_entry_symbol(), "\")]\nfun start() i32 { if (greeting[0] == 'w') { ret 0; } ret 1; }\n");
    texts[1] = "use uniontest.b.fb;\npub val greeting: *u8 = \"warm-owned-section-bytes\";\npub fun fa() i32 { ret fb(); }\n";
    texts[2] = "pub fun fb() i32 { ret 2; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 3);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    val mr: res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var m:  manifest.Manifest    = mr.ok;
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    val pr: res[bplan.BuildPlan, outcome.Fail] = bplan.plan(?alloc, ?s.interner, s.registry, ?m, rq);
    if (sel pr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var bp: bplan.BuildPlan = pr.ok;

    var bad: i32 = 0;

    val r1: res[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, ?alloc, nil);
    if (sel r1.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    if (r1.ok.severity != outcome.BUILD_OK) { bad = 1; }

    val src_dir:       str             = ut_cc3(?alloc, root, "/", "src");
    val b_path:        str             = ut_cc3(?alloc, src_dir, "/", "b.mach");
    val b_v2:          str             = "pub fun fb() i32 { ret 2; }\npub fun fb2() i32 { ret 3; }\n";
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(b_path, b_v2, str_len(b_v2), 420);
    if (sel write_bytes_r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }

    val r2: res[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, ?alloc, nil);
    if (sel r2.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    if (r2.ok.severity != outcome.BUILD_OK) { bad = 1; }

    val id_r: res[intern.StrId, A.Error] = intern.intern(?s.interner, LIT);
    if (sel id_r.ok) {
        val lo: opt[str] = intern.lookup(?s.interner, id_r.ok);
        if (sel lo.none)               { ret 99; }
        if (!str_equals(lo.some, LIT)) { bad = 1; }
    }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

fun ut_outcome_fail_count(bo: *outcome.BuildOutcome) u32 {
    var total: u32   = 0;
    var i:     usize = 0;
    for (i < bo.events.len) {
        if (sel bo.events.data[i].fail) { total = total + 1; }
        i = i + 1;
    }
    ret total;
}

fun ut_outcome_contains(bo: *outcome.BuildOutcome, needle: str) bool {
    var i: usize = 0;
    for (i < bo.events.len) {
        val ev: *outcome.BuildEvent = ?bo.events.data[i];
        if (sel ev.fail) {
            val carried: opt[str] = outcome.text(ev.fail);
            if (sel carried.some) {
                if (carried.some != nil && ut_str_contains(carried.some, needle)) { ret true; }
            }
        }
        or (sel ev.diagnostics) {
            var d: usize = 0;
            for (d < ev.diagnostics.diags.items.len) {
                if (ut_str_contains(ev.diagnostics.diags.items.data[d].message, needle)) { ret true; }
                d = d + 1;
            }
            var f: usize = 1;
            for (f < ev.diagnostics.sources.len) {
                if (ut_str_contains(ev.diagnostics.sources.files[f].path, needle)) { ret true; }
                f = f + 1;
            }
        }
        i = i + 1;
    }
    ret false;
}

fun ut_manifest_two_bins() str {
    ret "[project]\nid = \"uniontest\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.linux]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[target.windows]\nisa = \"x86_64\"\nos = \"windows\"\nabi = \"win64\"\n\n[target.linux-arm64]\nisa = \"aarch64\"\nos = \"linux\"\nabi = \"aapcs64\"\n\n[target.linux-riscv64]\nisa = \"riscv64\"\nos = \"linux\"\nabi = \"lp64d\"\n\n[target.darwin-x86_64]\nisa = \"x86_64\"\nos = \"darwin\"\nabi = \"sysv64\"\n\n[target.darwin-arm64]\nisa = \"aarch64\"\nos = \"darwin\"\nabi = \"aapcs64\"\n\n[artifact.alpha]\nkind = \"bin\"\nentry = \"alpha.mach\"\nout = \"bin/alpha\"\ntargets = [\"*\"]\nlink = []\nneed = []\n\n[artifact.beta]\nkind = \"bin\"\nentry = \"beta.mach\"\nout = \"bin/beta\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n";
}

test "mach.lang.build.engine.execute_warm_all:two_artifacts_both_link" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [2]str;
    names[0] = "alpha.mach";
    names[1] = "beta.mach";
    var texts: [2]str;
    texts[0] = ut_cc3(?alloc, "#[symbol(\"", ut_entry_symbol(), "\")]\nfun sa() i32 { ret 1; }\n");
    texts[1] = ut_cc3(?alloc, "#[symbol(\"", ut_entry_symbol(), "\")]\nfun sb() i32 { ret 2; }\n");
    val root_r: res[str, fail.Fail] = ut_scaffold_m(?alloc, ut_manifest_two_bins(), ?names[0], ?texts[0], 2);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    val mr: res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var m: manifest.Manifest = mr.ok;

    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    val pr: res[bplan.BuildPlan, outcome.Fail] = bplan.plan(?alloc, ?s.interner, s.registry, ?m, rq);
    if (sel pr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var bp: bplan.BuildPlan = pr.ok;

    var bad: i32 = 0;
    if (bp.units.len != 2) { bad = 1; }

    val r: res[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm_all(?bp, ?s, ?alloc, nil);
    if (sel r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    val bo: outcome.BuildOutcome = r.ok;

    if (bo.severity != outcome.BUILD_OK) { bad = 1; }
    if (bo.artifacts.len != 2)           { bad = 1; }
    or {
        val is_file_r: res[bool, io_error.Error] = fs.is_file(bo.artifacts.data[0].path);
        if (sel is_file_r.err)                   { ret 99; }
        if (!(sel is_file_r.ok && is_file_r.ok)) { bad = 1; }
        val is_file_r2: res[bool, io_error.Error] = fs.is_file(bo.artifacts.data[1].path);
        if (sel is_file_r2.err)                                   { ret 99; }
        if (!(sel is_file_r2.ok && is_file_r2.ok))                { bad = 1; }
        if (!ut_str_contains(bo.artifacts.data[0].path, "alpha")) { bad = 1; }
        if (!ut_str_contains(bo.artifacts.data[1].path, "beta"))  { bad = 1; }
        if (ut_str_contains(bo.artifacts.data[0].path, "beta"))   { bad = 1; }
    }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.build.engine.execute_warm:bin_name_keys_the_artifact_cache" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [3]str;
    names[0] = "alpha.mach";
    names[1] = "beta.mach";
    names[2] = "shared.mach";
    var texts: [3]str;
    texts[0] = ut_cc3(?alloc, "use uniontest.shared.sh;\n#[symbol(\"", ut_entry_symbol(), "\")]\nfun sa() i32 { ret sh(); }\n");
    texts[1] = ut_cc3(?alloc, "use uniontest.shared.sh;\n#[symbol(\"", ut_entry_symbol(), "\")]\nfun sb() i32 { ret sh(); }\n");
    texts[2] = "pub fun sh() i32 { $if ($bin.name == \"alpha\") { ret 111; } ret 222; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold_m(?alloc, ut_manifest_two_bins(), ?names[0], ?texts[0], 3);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    val mr: res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var m:  manifest.Manifest    = mr.ok;
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    val pr: res[bplan.BuildPlan, outcome.Fail] = bplan.plan(?alloc, ?s.interner, s.registry, ?m, rq);
    if (sel pr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var bp: bplan.BuildPlan = pr.ok;

    var bad: i32 = 0;
    if (bp.units.len != 2) { bad = 1; }

    val r0: res[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, ?alloc, nil);
    if (sel r0.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    val bo0: outcome.BuildOutcome                    = r0.ok;
    val r1:  res[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 1, ?s, ?alloc, nil);
    if (sel r1.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    val bo1: outcome.BuildOutcome = r1.ok;

    if (bo0.severity != outcome.BUILD_OK || bo1.severity != outcome.BUILD_OK) { bad = 1; }
    if (bo0.artifacts.len != 1 || bo1.artifacts.len != 1) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }

    val f0: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, bo0.artifacts.data[0].path);
    val f1: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, bo1.artifacts.data[0].path);
    if (sel f0.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    if (sel f1.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    val v0: Vector[u8] = f0.ok;
    val v1: Vector[u8] = f1.ok;

    var differ: bool = false;
    if (v0.len != v1.len) { differ = true; }
    or {
        var i: usize = 0;
        for (i < v0.len) {
            if (v0.data[i] != v1.data[i]) {
                differ = true;
                brk;
            }
            i = i + 1;
        }
    }
    if (!differ) { bad = 1; }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.build.engine.execute_warm:unit_failure_is_owned_after_teardown" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "#[symbol(\"_start\")]\nfun start() i32 { ret 0; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    val mr: res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var m:  manifest.Manifest    = mr.ok;
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    val pr: res[bplan.BuildPlan, outcome.Fail] = bplan.plan(?alloc, ?s.interner, s.registry, ?m, rq);
    if (sel pr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var bp: bplan.BuildPlan = pr.ok;

    val mf:            str             = ut_cc3(?alloc, root, "/", manifest.MANIFEST_FILE);
    val broken:        str             = "[project]\nid = \"uniontest\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out\"\nbogus_key = 1\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n";
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(mf, broken, str_len(broken), 420);
    if (sel write_bytes_r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }

    var bad: i32                                     = 0;
    val r:   res[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, ?alloc, nil);
    session.dnit(?s);
    if (sel r.err) { bad = 1; }
    if (sel r.ok) {
        var bo: outcome.BuildOutcome = r.ok;
        if (bo.severity == outcome.BUILD_OK)        { bad = 1; }
        if (bo.severity == outcome.BUILD_INTERNAL)  { bad = 1; }
        if (ut_outcome_fail_count(?bo) != 1)        { bad = 1; }
        if (!ut_outcome_contains(?bo, "bogus_key")) { bad = 1; }
        outcome.outcome_dnit(?bo);
    }

    fs.remove_all(?alloc, root);
    ret bad;
}

test "mach.lang.driver:inline_asm_unknown_mnemonic_located" {
    var bad: i32 = 0;
    val src: str = "#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 {\n    $if ($mach.build.arch == $mach.arch.x86_64) { asm x86_64 { frobnicate } }\n    $or ($mach.build.arch == $mach.arch.aarch64) { asm aarch64 { frobnicate } }\n    $or { asm riscv64 { frobnicate } }\n    ret 0;\n}\n";
    if (ut_codegen_rejects(src, "'frobnicate'") != 0) { bad = 1; }
    if (ut_codegen_rejects(src, "main.mach:") != 0)   { bad = 1; }
    $if ($mach.build.arch == $mach.arch.x86_64) {
        if (ut_codegen_rejects("#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 {\n    asm x86_64 { frobnicate }\n    ret 0;\n}\n",
            "main.mach:3:5: unknown x86_64 inline-asm instruction 'frobnicate'") != 0) { bad = 1; }
    }
    ret bad;
}

test "mach.lang.build.engine.execute_warm:pool_error_message_survives_teardown" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [4]str;
    names[0] = "main.mach";
    names[1] = "a.mach";
    names[2] = "b.mach";
    names[3] = "c.mach";
    var texts: [4]str;
    texts[0] = ut_cc3(?alloc, "use uniontest.a.fa;\nuse uniontest.b.fb;\nuse uniontest.c.fc;\n#[symbol(\"", ut_entry_symbol(), "\")]\nfun start() i32 { ret fa() + fb() + fc(); }\n");
    texts[1] = "pub fun fa() i32 { ret 1; }\n";
    texts[2] = "pub fun fb() i32 { ret 2; }\n";
    texts[3] = "pub fun fc() i32 {\n    $if ($mach.build.arch == $mach.arch.x86_64) { asm x86_64 { frobnicate } }\n    $or ($mach.build.arch == $mach.arch.aarch64) { asm aarch64 { frobnicate } }\n    $or { asm riscv64 { frobnicate } }\n    ret 3;\n}\n";
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 4);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    val mr: res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var m:  manifest.Manifest    = mr.ok;
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    rq.jobs         = 2;
    val pr: res[bplan.BuildPlan, outcome.Fail] = bplan.plan(?alloc, ?s.interner, s.registry, ?m, rq);
    if (sel pr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var bp: bplan.BuildPlan = pr.ok;

    var bad: i32                                     = 0;
    val r:   res[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, ?alloc, nil);
    session.dnit(?s);
    if (sel r.err) { bad = 1; }
    if (sel r.ok) {
        var bo: outcome.BuildOutcome = r.ok;
        if (bo.severity == outcome.BUILD_OK)           { bad = 1; }
        if (ut_outcome_fail_count(?bo) != 1)           { bad = 1; }
        if (!ut_outcome_contains(?bo, "'frobnicate'")) { bad = 1; }
        if (!ut_outcome_contains(?bo, "c.mach"))       { bad = 1; }
        outcome.outcome_dnit(?bo);
    }

    fs.remove_all(?alloc, root);
    ret bad;
}

fun ut_ro_mod_text() str {
    ret "pub fun f0(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 1; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\npub fun f1(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 2; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\npub fun f2(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 3; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\npub fun f3(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 4; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\npub fun f4(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 5; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\npub fun f5(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 6; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\npub fun f6(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 7; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\npub fun f7(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 8; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\npub fun f8(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 9; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\npub fun f9(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 10; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\npub fun f10(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 11; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\npub fun f11(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 12; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\npub fun f12(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 13; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\npub fun f13(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 14; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\npub fun f14(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 15; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\npub fun f15(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 16; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\npub fun f16(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 17; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\npub fun f17(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 18; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\npub fun f18(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 19; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\npub fun f19(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 20; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\n";
}

fun ut_ro_main_text(alloc: *A.Allocator) str {
    ret ut_cc3(alloc, "use uniontest.rm0;\nuse uniontest.rm1;\nuse uniontest.rm2;\nuse uniontest.rm3;\nuse uniontest.rm4;\nuse uniontest.rm5;\nuse uniontest.rm6;\nuse uniontest.rm7;\nuse uniontest.rm8;\nuse uniontest.rm9;\nuse uniontest.rm10;\nuse uniontest.rm11;\nuse uniontest.rm12;\nuse uniontest.rm13;\nuse uniontest.rm14;\nuse uniontest.rm15;\n\n#[symbol(\"", ut_entry_symbol(), "\")]\nfun start() i32 {\n    var t: i32 = 1;\n    t = t + rm0.f0(t + 0);\n    t = t + rm1.f1(t + 1);\n    t = t + rm2.f2(t + 2);\n    t = t + rm3.f3(t + 3);\n    t = t + rm4.f4(t + 4);\n    t = t + rm5.f5(t + 5);\n    t = t + rm6.f6(t + 6);\n    t = t + rm7.f7(t + 7);\n    t = t + rm8.f8(t + 8);\n    t = t + rm9.f9(t + 9);\n    t = t + rm10.f10(t + 10);\n    t = t + rm11.f11(t + 11);\n    t = t + rm12.f12(t + 12);\n    t = t + rm13.f13(t + 13);\n    t = t + rm14.f14(t + 14);\n    t = t + rm15.f15(t + 15);\n    ret t;\n}\n");
}

