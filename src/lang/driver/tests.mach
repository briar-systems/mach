    val ok:  str = "#[op(\"spirv\", \"GLSL.std.450\", \"Refract\")]\nfun refract(i: f32x3, n: f32x3, eta: f32) f32x3;\n\nfun main() i32 { ret 0; }\n";

    val n: str = "does not match the instruction's operand count";
    if (!ut_spv_diag_fired(?alloc, bad, n)) { ret 1; }
    if (ut_spv_diag_fired(?alloc, ok, n))   { ret 1; }
    ret 0;
}

