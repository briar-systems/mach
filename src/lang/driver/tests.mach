def CodegenTestPhase: u8;

val CODEGEN_TEST_SETUP:    CodegenTestPhase = 0;
val CODEGEN_TEST_SEMA:     CodegenTestPhase = 1;
val CODEGEN_TEST_LOWER:    CodegenTestPhase = 2;
val CODEGEN_TEST_SELECT:   CodegenTestPhase = 3;
val CODEGEN_TEST_CODEGEN:  CodegenTestPhase = 4;
val CODEGEN_TEST_ARTIFACT: CodegenTestPhase = 5;

def CodegenTestStatus: u8;

val CODEGEN_TEST_SETUP_FAILURE:       CodegenTestStatus = 0;
val CODEGEN_TEST_TARGET_UNAVAILABLE:  CodegenTestStatus = 1;
val CODEGEN_TEST_EMPTY_SELECTION:     CodegenTestStatus = 2;
val CODEGEN_TEST_NAMED_CASE_MISSING:  CodegenTestStatus = 3;
val CODEGEN_TEST_NAMED_CASE_EXECUTED: CodegenTestStatus = 4;
val CODEGEN_TEST_EXPECTED_EXCLUSION:  CodegenTestStatus = 5;
val CODEGEN_TEST_COMPILER_REJECTION:  CodegenTestStatus = 6;
val CODEGEN_TEST_ARTIFACT_FAILURE:    CodegenTestStatus = 7;
val CODEGEN_TEST_PASS:                CodegenTestStatus = 8;

def CodegenTestExpected: u8;

val CODEGEN_EXPECT_PASS:      CodegenTestExpected = 0;
val CODEGEN_EXPECT_EXCLUSION: CodegenTestExpected = 1;

def CodegenTestCase: u8;

val CODEGEN_CASE_NONE:                  CodegenTestCase = 0;
val CODEGEN_CASE_VECTOR_ADD:            CodegenTestCase = 1;
val CODEGEN_CASE_VECTOR_BUILD:          CodegenTestCase = 2;
val CODEGEN_CASE_PUBLIC_MUL:            CodegenTestCase = 3;
val CODEGEN_CASE_DECLASSIFIED_MUL:      CodegenTestCase = 4;
val CODEGEN_CASE_MEMZERO:               CodegenTestCase = 5;
val CODEGEN_CASE_PUBLIC_SHIFT:          CodegenTestCase = 6;
val CODEGEN_CASE_SECRET_SHIFT:          CodegenTestCase = 7;
val CODEGEN_CASE_WIDE_SECRET_RETURN:    CodegenTestCase = 8;
val CODEGEN_CASE_WIDE_SECRET_CALL:      CodegenTestCase = 9;
val CODEGEN_CASE_SECRET_MEMORY_ADDRESS: CodegenTestCase = 10;
val CODEGEN_CASE_SECRET_MUL:            CodegenTestCase = 11;

rec CodegenTestOutcome {
    status:    CodegenTestStatus;
    phase:     CodegenTestPhase;
    case_id:   CodegenTestCase;
    case_name: str;
}

fun ut_codegen_outcome(status: CodegenTestStatus, phase: CodegenTestPhase,
                       case_id: CodegenTestCase, case_name: str) CodegenTestOutcome {
    var out: CodegenTestOutcome;
    out.status    = status;
    out.phase     = phase;
    out.case_id   = case_id;
    out.case_name = case_name;
    ret out;
}

fun ut_codegen_phase_name(phase: CodegenTestPhase) str {
    if (phase == CODEGEN_TEST_SETUP)    { ret "setup"; }
    if (phase == CODEGEN_TEST_SEMA)     { ret "sema"; }
    if (phase == CODEGEN_TEST_LOWER)    { ret "lower"; }
    if (phase == CODEGEN_TEST_SELECT)   { ret "selection"; }
    if (phase == CODEGEN_TEST_CODEGEN)  { ret "codegen"; }
    if (phase == CODEGEN_TEST_ARTIFACT) { ret "artifact"; }
    ret "unknown";
}

fun ut_codegen_status_name(status: CodegenTestStatus) str {
    if (status == CODEGEN_TEST_SETUP_FAILURE)       { ret "setup failure"; }
    if (status == CODEGEN_TEST_TARGET_UNAVAILABLE)  { ret "target unavailable"; }
    if (status == CODEGEN_TEST_EMPTY_SELECTION)     { ret "empty selection"; }
    if (status == CODEGEN_TEST_NAMED_CASE_MISSING)  { ret "named case missing"; }
    if (status == CODEGEN_TEST_NAMED_CASE_EXECUTED) { ret "excluded case executed"; }
    if (status == CODEGEN_TEST_EXPECTED_EXCLUSION)  { ret "expected exclusion"; }
    if (status == CODEGEN_TEST_COMPILER_REJECTION)  { ret "compiler rejection"; }
    if (status == CODEGEN_TEST_ARTIFACT_FAILURE)    { ret "artifact failure"; }
    if (status == CODEGEN_TEST_PASS)                { ret "pass"; }
    ret "unknown";
}

fun ut_codegen_expected_name(expected: CodegenTestExpected) str {
    if (expected == CODEGEN_EXPECT_PASS) { ret "generated artifact"; }
    if (expected == CODEGEN_EXPECT_EXCLUSION) { ret "generated artifact without excluded case"; }
    ret "unknown";
}

fun ut_codegen_outcome_matches(got: CodegenTestOutcome, expected: CodegenTestExpected,
                               case_id: CodegenTestCase) bool {
    if (got.case_id != case_id || got.phase != CODEGEN_TEST_ARTIFACT) { ret false; }
    if (expected == CODEGEN_EXPECT_PASS) { ret got.status == CODEGEN_TEST_PASS; }
    if (expected == CODEGEN_EXPECT_EXCLUSION) { ret got.status == CODEGEN_TEST_EXPECTED_EXCLUSION; }
    ret false;
}

fun ut_codegen_result(got: CodegenTestOutcome, expected: CodegenTestExpected,
                      case_id: CodegenTestCase) i32 {
    if (ut_codegen_outcome_matches(got, expected, case_id)) { ret 0; }
    print.eprintlnf("codegen oracle '{}': expected {}, reached {} with {}",
        got.case_name, ut_codegen_expected_name(expected), ut_codegen_phase_name(got.phase),
        ut_codegen_status_name(got.status));
    ret 1;
}

fun ut_codegen_failure_rejected(status: CodegenTestStatus, phase: CodegenTestPhase) bool {
    val got: CodegenTestOutcome = ut_codegen_outcome(status, phase,
        CODEGEN_CASE_PUBLIC_MUL, "mutation");
    ret !ut_codegen_outcome_matches(got, CODEGEN_EXPECT_PASS, CODEGEN_CASE_PUBLIC_MUL)
        && !ut_codegen_outcome_matches(got, CODEGEN_EXPECT_EXCLUSION, CODEGEN_CASE_PUBLIC_MUL);
}

test "mach.lang.driver:codegen_test_outcome_exact" {
    if (!ut_codegen_failure_rejected(CODEGEN_TEST_SETUP_FAILURE, CODEGEN_TEST_SETUP)) { ret 1; }
    if (!ut_codegen_failure_rejected(CODEGEN_TEST_TARGET_UNAVAILABLE, CODEGEN_TEST_SETUP)) { ret 1; }
    if (!ut_codegen_failure_rejected(CODEGEN_TEST_EMPTY_SELECTION, CODEGEN_TEST_SELECT)) { ret 1; }
    if (!ut_codegen_failure_rejected(CODEGEN_TEST_NAMED_CASE_MISSING, CODEGEN_TEST_SELECT)) { ret 1; }
    if (!ut_codegen_failure_rejected(CODEGEN_TEST_NAMED_CASE_EXECUTED, CODEGEN_TEST_SELECT)) { ret 1; }
    if (!ut_codegen_failure_rejected(CODEGEN_TEST_COMPILER_REJECTION, CODEGEN_TEST_CODEGEN)) { ret 1; }
    if (!ut_codegen_failure_rejected(CODEGEN_TEST_ARTIFACT_FAILURE, CODEGEN_TEST_ARTIFACT)) { ret 1; }

    val pass: CodegenTestOutcome = ut_codegen_outcome(CODEGEN_TEST_PASS, CODEGEN_TEST_ARTIFACT,
        CODEGEN_CASE_PUBLIC_MUL, "public multiply");
    if (!ut_codegen_outcome_matches(pass, CODEGEN_EXPECT_PASS, CODEGEN_CASE_PUBLIC_MUL)) { ret 1; }
    if (ut_codegen_outcome_matches(pass, CODEGEN_EXPECT_EXCLUSION, CODEGEN_CASE_PUBLIC_MUL)) { ret 1; }
    if (ut_codegen_outcome_matches(pass, CODEGEN_EXPECT_PASS, CODEGEN_CASE_VECTOR_ADD)) { ret 1; }

    val early: CodegenTestOutcome = ut_codegen_outcome(CODEGEN_TEST_PASS, CODEGEN_TEST_CODEGEN,
        CODEGEN_CASE_PUBLIC_MUL, "early pass");
    if (ut_codegen_outcome_matches(early, CODEGEN_EXPECT_PASS, CODEGEN_CASE_PUBLIC_MUL)) { ret 1; }

    val exclusion: CodegenTestOutcome = ut_codegen_outcome(CODEGEN_TEST_EXPECTED_EXCLUSION,
        CODEGEN_TEST_ARTIFACT, CODEGEN_CASE_PUBLIC_SHIFT, "public shift");
    if (!ut_codegen_outcome_matches(exclusion, CODEGEN_EXPECT_EXCLUSION,
        CODEGEN_CASE_PUBLIC_SHIFT)) { ret 1; }
    if (ut_codegen_outcome_matches(exclusion, CODEGEN_EXPECT_PASS,
        CODEGEN_CASE_PUBLIC_SHIFT)) { ret 1; }
    ret 0;
}

fun ut_codegen_case_selected(p: *project.Project, case_id: CodegenTestCase) bool {
    if (case_id == CODEGEN_CASE_NONE) { ret false; }
    var saw_public_mul: bool = false;
    var saw_declassify: bool = false;
    var ti: u32 = 0;
    for (ti < p.topo_len) {
        val m: *ir.Module = p.modules[p.topo[ti]::u32].ir_module;
        if (m != nil) {
            var fi: u32 = 0;
            for (fi < m.function_len) {
                val fn: *ir.Function = ?m.functions[fi];
                var ii: u32 = 0;
                for (ii < fn.instr_len) {
                    val ins: *instruction.Instruction = ?fn.instrs[ii];
                    if (ins.kind == instruction.OP_DECLASSIFY) { saw_declassify = true; }

                    var operands_public: bool = true;
                    var oi: u32 = 0;
                    for (oi < ins.operand_count) {
                        if (ins.operands[oi].secret) { operands_public = false; }
                        oi = oi + 1;
                    }
                    if (ins.kind == instruction.OP_MUL && !ins.secret && operands_public) {
                        saw_public_mul = true;
                    }
                    if (case_id == CODEGEN_CASE_SECRET_MUL
                        && ins.kind == instruction.OP_MUL && !operands_public) { ret true; }

                    if (case_id == CODEGEN_CASE_VECTOR_ADD
                        && ins.kind == instruction.OP_ADD
                        && ir_type.is_vector(?m.types, ins.ty)) { ret true; }
                    if (case_id == CODEGEN_CASE_VECTOR_BUILD
                        && ins.kind == instruction.OP_VEC_BUILD) { ret true; }
                    if (case_id == CODEGEN_CASE_VECTOR_BUILD
                        && ins.kind == instruction.OP_STORE && ins.operand_count >= 1
                        && ins.operands[0].kind == value.VAL_CONST_AGG
                        && ir_type.is_vector(?m.types, ins.operands[0].ty)) { ret true; }
                    if (case_id == CODEGEN_CASE_VECTOR_BUILD
                        && ins.kind == instruction.OP_LOAD
                        && ir_type.is_vector(?m.types, ins.ty)) { ret true; }
                    if (case_id == CODEGEN_CASE_PUBLIC_MUL && saw_public_mul) { ret true; }
                    if (case_id == CODEGEN_CASE_MEMZERO
                        && ins.kind == instruction.OP_MEMZERO) { ret true; }
                    if ((case_id == CODEGEN_CASE_PUBLIC_SHIFT || case_id == CODEGEN_CASE_SECRET_SHIFT)
                        && (ins.kind == instruction.OP_SHL || ins.kind == instruction.OP_SHR_S
                            || ins.kind == instruction.OP_SHR_U)
                        && ins.operand_count >= 2) {
                        val count_secret: bool = ins.operands[1].secret;
                        if (case_id == CODEGEN_CASE_SECRET_SHIFT && count_secret) { ret true; }
                        if (case_id == CODEGEN_CASE_PUBLIC_SHIFT && !count_secret) { ret true; }
                    }
                    if (case_id == CODEGEN_CASE_WIDE_SECRET_RETURN
                        && ins.kind == instruction.OP_RET && ins.operand_count >= 1
                        && ins.operands[0].secret
                        && ir_type.byte_size_for_machine(?m.types, ins.operands[0].ty, resolved.layout_machine(?p.target))
                            > p.target.isa.pointer_width) { ret true; }
                    if (case_id == CODEGEN_CASE_WIDE_SECRET_CALL
                        && ins.kind == instruction.OP_CALL && ins.secret
                        && ir_type.byte_size_for_machine(?m.types, ins.ty, resolved.layout_machine(?p.target))
                            > p.target.isa.pointer_width) { ret true; }
                    if (case_id == CODEGEN_CASE_SECRET_MEMORY_ADDRESS) {
                        if (ins.kind == instruction.OP_LOAD && ins.operand_count >= 1
                            && ins.operands[0].secret) { ret true; }
                        if (ins.kind == instruction.OP_STORE && ins.operand_count >= 2
                            && ins.operands[1].secret) { ret true; }
                        if (ins.kind == instruction.OP_MEMZERO && ins.operand_count >= 1
                            && ins.operands[0].secret) { ret true; }
                    }
                    ii = ii + 1;
                }
                fi = fi + 1;
            }
        }
        ti = ti + 1;
    }
    if (case_id == CODEGEN_CASE_DECLASSIFIED_MUL) {
        ret saw_declassify && saw_public_mul;
    }
    ret false;
}

fun ut_codegen_artifact_valid(p: *project.Project) bool {
    if (p.emit_len == 0) { ret false; }
    var i: u32 = 0;
    for (i < p.emit_len) {
        val m: *project.ModuleEntry = ?p.modules[p.topo[i]::u32];
        if (m.object_image == nil || m.object_image.sections == nil
            || m.object_image.section_count == 0) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun ut_run_codegen_case(p: *project.Project, case_name: str, case_id: CodegenTestCase,
                        excluded: CodegenTestCase, expected: CodegenTestExpected) CodegenTestOutcome {
    val se: R.Result[R.Void, outcome.Fail] = passes.run_sema_pass(p);
    if (R.is_err[R.Void, outcome.Fail](se)) {
        ret ut_codegen_outcome(CODEGEN_TEST_COMPILER_REJECTION, CODEGEN_TEST_SEMA, case_id, case_name);
    }
    val le: R.Result[R.Void, outcome.Fail] = passes.run_lower_pass(p);
    if (R.is_err[R.Void, outcome.Fail](le)) {
        ret ut_codegen_outcome(CODEGEN_TEST_COMPILER_REJECTION, CODEGEN_TEST_LOWER, case_id, case_name);
    }
    if (p.emit_len == 0) {
        ret ut_codegen_outcome(CODEGEN_TEST_EMPTY_SELECTION, CODEGEN_TEST_SELECT, case_id, case_name);
    }
    if (!ut_codegen_case_selected(p, case_id)) {
        ret ut_codegen_outcome(CODEGEN_TEST_NAMED_CASE_MISSING, CODEGEN_TEST_SELECT, case_id, case_name);
    }
    if (expected == CODEGEN_EXPECT_EXCLUSION
        && (excluded == CODEGEN_CASE_NONE || ut_codegen_case_selected(p, excluded))) {
        ret ut_codegen_outcome(CODEGEN_TEST_NAMED_CASE_EXECUTED, CODEGEN_TEST_SELECT, case_id, case_name);
    }

    val ce: R.Result[R.Void, outcome.Fail] = passes.run_codegen_pass(p);
    if (R.is_err[R.Void, outcome.Fail](ce)) {
        ret ut_codegen_outcome(CODEGEN_TEST_COMPILER_REJECTION, CODEGEN_TEST_CODEGEN, case_id, case_name);
    }
    if (!ut_codegen_artifact_valid(p)) {
        ret ut_codegen_outcome(CODEGEN_TEST_ARTIFACT_FAILURE, CODEGEN_TEST_ARTIFACT, case_id, case_name);
    }
    if (expected == CODEGEN_EXPECT_EXCLUSION) {
        ret ut_codegen_outcome(CODEGEN_TEST_EXPECTED_EXCLUSION, CODEGEN_TEST_ARTIFACT, case_id, case_name);
    }
    ret ut_codegen_outcome(CODEGEN_TEST_PASS, CODEGEN_TEST_ARTIFACT, case_id, case_name);
}

fun ut_vec_codegen_defined(src: str, case_name: str, case_id: CodegenTestCase) i32 {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) {
        ret ut_codegen_result(ut_codegen_outcome(CODEGEN_TEST_SETUP_FAILURE, CODEGEN_TEST_SETUP,
            case_id, case_name), CODEGEN_EXPECT_PASS, case_id);
    }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) {
        ret ut_codegen_result(ut_codegen_outcome(CODEGEN_TEST_SETUP_FAILURE, CODEGEN_TEST_SETUP,
            case_id, case_name), CODEGEN_EXPECT_PASS, case_id);
    }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = src;
    val pr: R.Result[project.Project, outcome.Fail] = ut_build(?s, ?alloc, ?names[0], ?texts[0], 1);
    if (R.is_err[project.Project, outcome.Fail](pr)) {
        session.dnit(?s);
        ret ut_codegen_result(ut_codegen_outcome(CODEGEN_TEST_SETUP_FAILURE, CODEGEN_TEST_SETUP,
            case_id, case_name), CODEGEN_EXPECT_PASS, case_id);
    }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);
    val got: CodegenTestOutcome = ut_run_codegen_case(?p, case_name, case_id,
        CODEGEN_CASE_NONE, CODEGEN_EXPECT_PASS);
    project.dnit_project(?p);
    session.dnit(?s);
    ret ut_codegen_result(got, CODEGEN_EXPECT_PASS, case_id);
}

fun ut_run_codegen_err(p: *project.Project, needle: str) i32 {
    val se: R.Result[R.Void, outcome.Fail] = passes.run_sema_pass(p);
    if (R.is_err[R.Void, outcome.Fail](se)) { ret 1; }
    val le: R.Result[R.Void, outcome.Fail] = passes.run_lower_pass(p);
    if (R.is_err[R.Void, outcome.Fail](le)) { ret 1; }
    val ce: R.Result[R.Void, outcome.Fail] = passes.run_codegen_pass(p);
    if (R.is_err[R.Void, outcome.Fail](ce)
        && ut_str_contains(R.unwrap_err[R.Void, outcome.Fail](ce).message, needle)) { ret 0; }
    ret 1;
}

fun ut_run_codegen_without(p: *project.Project, case_name: str, case_id: CodegenTestCase,
                           excluded: CodegenTestCase) i32 {
    val got: CodegenTestOutcome = ut_run_codegen_case(p, case_name, case_id,
        excluded, CODEGEN_EXPECT_EXCLUSION);
    ret ut_codegen_result(got, CODEGEN_EXPECT_EXCLUSION, case_id);
}

fun ut_run_codegen_ok(p: *project.Project) i32 {
    val se: R.Result[R.Void, outcome.Fail] = passes.run_sema_pass(p);
    if (R.is_err[R.Void, outcome.Fail](se)) { ret 1; }
    val le: R.Result[R.Void, outcome.Fail] = passes.run_lower_pass(p);
    if (R.is_err[R.Void, outcome.Fail](le)) { ret 1; }
    val ce: R.Result[R.Void, outcome.Fail] = passes.run_codegen_pass(p);
    if (R.is_err[R.Void, outcome.Fail](ce)) { ret 1; }
    ret 0;
}

fun ut_codegen_target_ok(src: str, target_name: str) i32 {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = src;
    val root_r: R.Result[str, str] = ut_scaffold(?alloc, ?names[0], ?texts[0], 1);
    if (R.is_err[str, str](root_r)) { session.dnit(?s); ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);
    val rr: R.Result[R.Void, str] = driver.setup_registry(?s.registry);
    if (R.is_err[R.Void, str](rr)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    var tsel_1773: manifest.Selection = ut_target_sel(target_name);
    val pr: R.Result[project.Project, outcome.Fail] = driver.build_project(?s, root, ?tsel_1773);
    fs.remove_all(?alloc, root);
    if (R.is_err[project.Project, outcome.Fail](pr)) { session.dnit(?s); ret 1; }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);

    val code: i32 = ut_run_codegen_ok(?p);
    project.dnit_project(?p);
    session.dnit(?s);
    ret code;
}

