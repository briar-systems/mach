fun ut_embed_diag(main_src: str, asset: str, needle: str) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [2]str;
    names[0] = "main.mach";
    names[1] = "asset.bin";
    var texts: [2]str;
    texts[0] = main_src;
    texts[1] = asset;

    val pr: res[project.Project, outcome.Fail] = ut_vec_sema_n(?s, ?alloc, ?names[0], ?texts[0], 2);
    if (sel pr.ok) {
        var p: project.Project = pr.ok;
        project.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }
    val hit: bool = outcome.is_reported(pr.err) && ut_diag_has(?s.diags, needle);
    session.dnit(?s);
    if (hit) { ret 0; }
    ret 1;
}

fun ut_embed_unreadable_diag() i32 {
    $if ($mach.build.os != $mach.os.linux) { ret 0; }

    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [2]str;
    names[0] = "main.mach";
    names[1] = "asset.bin";
    var texts: [2]str;
    texts[0] = "#[embed(\"asset.bin\")]\nval A: [_]u8;\nfun main() i32 { ret 0; }\n";
    texts[1] = "abc";

    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 2);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root:    str = root_r.ok;
    val src_dir: str = ut_cc3(?alloc, root, "/", "src");
    val a_path:  str = ut_cc3(?alloc, src_dir, "/", "asset.bin");

    val remove_file_r: err[io_error.Error] = fs.remove_file(a_path);
    if (sel remove_file_r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(a_path, "abc", 3::usize, 0);
    if (sel write_bytes_r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }

    val pr: res[project.Project, outcome.Fail] = ut_sema_build(?s, root);
    if (sel pr.ok) {
        var p: project.Project = pr.ok;
        project.dnit_project(?p);
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    val hit: bool = outcome.is_reported(pr.err) && ut_diag_has(?s.diags, "permission denied");
    fs.remove_all(?alloc, root);
    session.dnit(?s);
    if (hit) { ret 0; }
    ret 1;
}

test "mach.lang.driver:embed_sizes_and_checks_annotation" {
    var bad: i32 = 0;

    if (ut_embed_diag("#[embed(\"asset.bin\")]\nval A: [_]u8;\nfun main() i32 { val b: [9]u8 = A; ret b[0]::i32; }\n",
        "abc", "found [3]u8") != 0) { bad = 1; }

    if (ut_embed_diag("#[embed(\"asset.bin\")]\nval A: [4]u8;\nfun main() i32 { ret A[0]::i32; }\n",
        "abc", "declares 4 bytes but the file holds 3") != 0) { bad = 1; }

    ret bad;
}

test "mach.lang.driver:embed_path_diagnostics" {
    var bad: i32 = 0;

    if (ut_embed_diag("#[embed(\"nope.bin\")]\nval A: [_]u8;\nfun main() i32 { ret A[0]::i32; }\n",
        "abc", "`embed` on `A` cannot read") != 0) { bad = 1; }
    if (ut_embed_diag("#[embed(\"nope.bin\")]\nval A: [_]u8;\nfun main() i32 { ret A[0]::i32; }\n",
        "abc", "no such file or directory") != 0) { bad = 1; }

    if (ut_embed_diag("#[embed(\".\")]\nval A: [_]u8;\nfun main() i32 { ret A[0]::i32; }\n",
        "abc", "is a directory") != 0) { bad = 1; }
    if (ut_embed_unreadable_diag() != 0) { bad = 1; }

    ret bad;
}

fun ut_diag_has_warning(d: *diagnostic.DiagnosticStore, needle: str) bool {
    var i: usize = 0;
    for (i < diagnostic.len(d)) {
        if (d.items.data[i].severity == diagnostic.SEVERITY_WARNING
            && ut_str_contains(d.items.data[i].message, needle)) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun ut_embed_escape_arm(alloc: *A.Allocator, escaped: bool) i32 {
    val sr: res[session.Session, fail.Fail] = session.init(alloc);
    if (sel sr.err) { ret 1; }
    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [2]str;
    names[0] = "main.mach";
    names[1] = "asset.bin";
    var texts: [2]str;
    texts[0] = "#[embed(\"asset.bin\")]\nval A: [_]u8;\nfun main() i32 { ret A[0]::i32; }\n";
    texts[1] = "abc";
    val root_r: res[str, fail.Fail] = ut_scaffold(alloc, ?names[0], ?texts[0], 2);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root:    str = root_r.ok;
    val outside: str = ut_cc3(alloc, root, "-outside", ".bin");
    if (escaped) {
        val leaf:          str             = path.filename(outside);
        val main_path:     str             = ut_cc3(alloc, root, "/src/", "main.mach");
        val src:           str             = ut_cc3(alloc, "#[embed(\"../../", leaf, "\")]\nval A: [_]u8;\nfun main() i32 { ret A[0]::i32; }\n");
        val write_bytes_r: err[fs.FsError] = fs.write_bytes(main_path, src, str_len(src), 420);
        if (sel write_bytes_r.err) {
            fs.remove_all(alloc, root);
            session.dnit(?s);
            ret 1;
        }
        val write_bytes_r2: err[fs.FsError] = fs.write_bytes(outside, "xyz", 3::usize, 420);
        if (sel write_bytes_r2.err) {
            fs.remove_all(alloc, root);
            session.dnit(?s);
            ret 1;
        }
    }

    var bad: i32                                = 0;
    val pr:  res[project.Project, outcome.Fail] = ut_sema_build(?s, root);
    if (escaped) {
        # refused at the decorator, and the outside file's bytes were never read
        if (sel pr.ok) {
            var p: project.Project = pr.ok;
            project.dnit_project(?p);
            bad = 1;
        }
        if (!ut_diag_has(?s.diags, "`embed` path escapes the project root"))       { bad = 2; }
        if (!ut_diag_has(?s.diags, "5.0.0 refuses it and does not read the file")) { bad = 3; }
        val outside_r: res[intern.StrId, A.Error] = intern.intern(?s.interner, outside);
        if (sel outside_r.ok) {
            val cached: opt[*embed.EmbedFile] = embed.get(?s.embeds, outside_r.ok);
            if (sel cached.some) { bad = 4; }
        }
    }
    or {
        if (sel pr.err) { bad = 5; }
        if (sel pr.ok) {
            var p: project.Project = pr.ok;
            if (diagnostic.has_errors(?s.diags)) { bad = 6; }
            project.dnit_project(?p);
        }
    }
    if (escaped) { fs.remove_file(outside); }
    fs.remove_all(alloc, root);
    session.dnit(?s);
    ret bad;
}

# intentional removal test (#3226, #3112): the 4.30 warning is a refusal that never reads the file
test "mach.lang.driver:embed_outside_the_project_root_is_refused_and_never_read" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val escaped: i32 = ut_embed_escape_arm(?alloc, true);
    if (escaped != 0) { ret 10 + escaped; }
    val inside: i32 = ut_embed_escape_arm(?alloc, false);
    if (inside != 0) { ret 20 + inside; }
    ret 0;
}

test "mach.lang.driver:debug_info_on_a_target_without_a_debug_model_fails_the_artifact" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "fun main() i32 { ret 0; }\n";
    val mtext:  str                 = "[project]\nid = \"nodbg\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.windows]\nisa = \"x86_64\"\nos = \"windows\"\nabi = \"win64\"\n\n[artifact.app]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/app.exe\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n";
    val root_r: res[str, fail.Fail] = ut_scaffold_m(?alloc, mtext, ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    var pick: manifest.Selection;
    pick.target       = "windows";
    pick.profile      = "";
    pick.artifact     = "";
    pick.want_lib     = false;
    pick.has_artifact = false;
    val pr: res[project.Project, outcome.Fail] = driver.build_project_sel(?s, root, ?pick);
    if (sel pr.err) {
        print.print(outcome.describe(pr.err));
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var p:   project.Project = pr.ok;
    var bad: i32             = 0;
    if (p.target.debug != nil) { bad = 1; }
    p.req.debug = true;
    if (ut_run_codegen_err(?p, "registers no debug model") != 0) { bad = 1; }
    project.dnit_project(?p);
    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

fun ut_divide_program() str {
    ret "pub var Z: i32 = 0;\npub var N: i32 = 1;\npub var M: i32 = -2147483648;\npub var Q: i32 = -1;\npub var ZL: i64 = 0;\npub var ML: i64 = -9223372036854775807 - 1;\npub var QL: i64 = -1;\n\n#[symbol(\"main\")]\nfun main(argc: i64) i64 {\n    if (argc == 1) { val q: i32x4 = i32x4{-10, 10, -10, 1} / i32x4{3, -3, -3, 2}; if (q[0] != -3 || q[1] != -3 || q[2] != 3 || q[3] != 0) { ret 4; } if (100 / N == 100) { ret 0; } ret 3; }\n    if (argc == 2) { ret (100 / Z)::i64; }\n    if (argc == 3) { ret (M / Q)::i64; }\n    if (argc == 4) { ret 100 / ZL; }\n    if (argc == 5) { ret ML / QL; }\n    if (argc == 6) { val q: i32x4 = i32x4{100, 200, 300, 400} / i32x4{N, Z, N, N}; ret q[0]::i64; }\n    if (argc == 7) { val q: u64x2 = u64x2{18446744073709551615, 80} / u64x2{N::u64, ZL::u64}; ret q[0]::i64; }\n    if (argc == 8) { val q: i32x4 = i32x4{N, M, N, N} / i32x4{N, Q, N, N}; ret q[0]::i64; }\n    val q: i64x2 = i64x2{N::i64, ML} / i64x2{N::i64, QL}; ret q[0];\n}\n\n#[symbol(\"_start\")]\npub fun start() {\n    $if ($mach.build.arch == $mach.arch.x86_64) {\n        asm x86_64 {\n            mov rdi, [rsp]\n            and rsp, -16\n            call main\n            mov rdi, rax\n            mov rax, 60\n            syscall\n        }\n    }\n    $or ($mach.build.arch == $mach.arch.aarch64) {\n        asm aarch64 {\n            ldr x0, [sp]\n            bl main\n            mov x8, 93\n            svc 0\n        }\n    }\n    $or {\n        asm riscv64 {\n            ld a0, 0(sp)\n            call main\n            li a7, 93\n            ecall\n        }\n    }\n}\n";
}

fun ut_divide_manifest() str {
    ret "[project]\nid = \"divtrap\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.linux-x86_64]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[target.linux-arm64]\nisa = \"aarch64\"\nos = \"linux\"\nabi = \"aapcs64\"\n\n[target.linux-riscv64]\nisa = \"riscv64\"\nos = \"linux\"\nabi = \"lp64d\"\n\n[artifact.divtrap]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/divtrap\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n";
}

fun ut_run_with_argc(cwd: str, runner: str, program: str, argc: usize, trapped: *bool, exit_code: *i32) bool {
    var argv:   [12]*u8;
    var n:      usize = 0;
    var launch: str   = program;
    if (!str_empty(runner)) {
        argv[n] = runner::*u8;
        n       = n + 1;
        launch  = runner;
    }
    argv[n] = program::*u8;
    n       = n + 1;
    var extra: usize = 1;
    for (extra < argc) {
        argv[n] = "x"::*u8;
        n       = n + 1;
        extra   = extra + 1;
    }
    argv[n] = nil;
    val spawned: res[exec.Child, exec.Error] = exec.spawn_in(launch, ?argv[0], env.environ(), cwd);
    if (sel spawned.err) { ret false; }
    val rr: res[exec.ExitStatus, exec.Error] = exec.wait(spawned.ok);
    if (sel rr.err) { ret false; }
    val status: exec.ExitStatus = rr.ok;
    @trapped   = false;
    @exit_code = -1;
    if (exec.signaled(status)) {
        val sig: i32 = exec.signal(status);
        @trapped = sig == 4 || sig == 5 || sig == 8;
        ret true;
    }
    if (!exec.exited(status)) { ret false; }
    @exit_code = exec.code(status)::i32;
    @trapped   = @exit_code == 132 || @exit_code == 133 || @exit_code == 136;
    ret true;
}

fun ut_divide_trap_target(alloc: *A.Allocator, target_name: str, runner_name: str) i32 {
    var runner: str = "";
    if (!str_empty(runner_name)) {
        val rr: res[str, exec.Error] = exec.resolve(alloc, runner_name);
        if (sel rr.err) {
            print.print("divide-trap: runner absent, arm skipped: ");
            print.print(runner_name);
            print.print("\n");
            ret 0;
        }
        runner = rr.ok;
    }
    val sr: res[session.Session, fail.Fail] = session.init(alloc);
    if (sel sr.err) { ret 1; }
    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = ut_divide_program();
    val root_r: res[str, fail.Fail] = ut_scaffold_m(alloc, ut_divide_manifest(), ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    var bad: i32                                  = 0;
    val mr:  res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) {
        fs.remove_all(alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var m:  manifest.Manifest    = mr.ok;
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    rq.target       = target_name;
    val pr: res[bplan.BuildPlan, outcome.Fail] = bplan.plan(alloc, ?s.interner, s.registry, ?m, rq);
    if (sel pr.err) {
        fs.remove_all(alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var bp: bplan.BuildPlan                         = pr.ok;
    val br: res[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, alloc, nil);
    if (sel br.err) { bad = 1; }
    if (sel br.ok) {
        val bo: outcome.BuildOutcome = br.ok;
        if (bo.severity != outcome.BUILD_OK || bo.artifacts.len != 1) { bad = 1; }
        or {
            val program: str  = bo.artifacts.data[0].path;
            var trapped: bool = false;
            var code:    i32  = 0;
            if (!ut_run_with_argc(root, runner, program, 1, ?trapped, ?code) || trapped || code != 0) { bad = 2; }
            var argc: usize = 2;
            for (argc <= 9) {
                if (!ut_run_with_argc(root, runner, program, argc, ?trapped, ?code) || !trapped) {
                    print.print("divide-trap: no trap on ");
                    print.print(target_name);
                    print.printf(" for argc {} (exit {})\n", argc, code);
                    bad = 3;
                }
                argc = argc + 1;
            }
        }
    }
    val remove_all_r: err[fs.FsError] = fs.remove_all(alloc, root);
    if (sel remove_all_r.err) { bad = 4; }
    session.dnit(?s);
    ret bad;
}

test "mach.lang.driver:exceptional_division_traps_identically_on_every_native_backend" {
    $if ($mach.build.os != $mach.os.linux || $mach.build.arch != $mach.arch.x86_64) { ret 0; }
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err)                                                      { ret 1; }
    if (ut_divide_trap_target(?alloc, "linux-x86_64", "") != 0)              { ret 1; }
    if (ut_divide_trap_target(?alloc, "linux-arm64", "qemu-aarch64") != 0)   { ret 2; }
    if (ut_divide_trap_target(?alloc, "linux-riscv64", "qemu-riscv64") != 0) { ret 3; }
    ret 0;
}

fun ut_native_start_stub() str {
    ret "\n#[symbol(\"_start\")]\npub fun start() {\n    $if ($mach.build.arch == $mach.arch.x86_64) {\n        asm x86_64 {\n            mov rdi, [rsp]\n            and rsp, -16\n            call main\n            mov rdi, rax\n            mov rax, 60\n            syscall\n        }\n    }\n    $or ($mach.build.arch == $mach.arch.aarch64) {\n        asm aarch64 {\n            ldr x0, [sp]\n            bl main\n            mov x8, 93\n            svc 0\n        }\n    }\n    $or {\n        asm riscv64 {\n            ld a0, 0(sp)\n            call main\n            li a7, 93\n            ecall\n        }\n    }\n}\n";
}

# builds a freestanding fixture for one target and profile and runs it; the fixture exits 0 when every check holds
fun ut_native_fixture_case(alloc: *A.Allocator, target_name: str, runner_name: str, release: bool, program: str, label: str) i32 {
    var runner: str = "";
    if (!str_empty(runner_name)) {
        val rr: res[str, exec.Error] = exec.resolve(alloc, runner_name);
        if (sel rr.err) {
            print.print("native-fixture: runner absent, arm skipped: ");
            print.print(runner_name);
            print.print("\n");
            ret 0;
        }
        runner = rr.ok;
    }
    val sr: res[session.Session, fail.Fail] = session.init(alloc);
    if (sel sr.err) { ret 1; }
    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = ut_cc3(alloc, program, "\n", ut_native_start_stub());
    val root_r: res[str, fail.Fail] = ut_scaffold_m(alloc, ut_divide_manifest(), ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    var bad: i32                                  = 0;
    val mr:  res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) {
        fs.remove_all(alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var m:  manifest.Manifest    = mr.ok;
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    rq.target       = target_name;
    if (release) {
        rq.profile = "release";
        rq.opt     = pipeline.OPT_RELEASE;
    }
    val pr: res[bplan.BuildPlan, outcome.Fail] = bplan.plan(alloc, ?s.interner, s.registry, ?m, rq);
    if (sel pr.err) {
        fs.remove_all(alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var bp: bplan.BuildPlan                         = pr.ok;
    val br: res[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, alloc, nil);
    if (sel br.err) {
        print.print("native-fixture: build failed for ");
        print.print(label);
        print.print(" on ");
        print.print(target_name);
        print.print("\n");
        bad = 2;
    }
    if (sel br.ok) {
        val bo: outcome.BuildOutcome = br.ok;
        if (bo.severity != outcome.BUILD_OK || bo.artifacts.len != 1) { bad = 3; }
        or {
            var trapped: bool = false;
            var code:    i32  = 0;
            if (!ut_run_with_argc(root, runner, bo.artifacts.data[0].path, 1, ?trapped, ?code)) { bad = 4; }
            or (trapped || code != 0) {
                print.print("native-fixture: ");
                print.print(label);
                print.print(" on ");
                print.print(target_name);
                var profile_name: str = "debug";
                if (release) { profile_name = "release"; }
                print.print(" ");
                print.print(profile_name);
                print.printf(" (trapped {}, exit {})\n", trapped::u8, code);
                bad = 5;
            }
        }
    }
    val remove_all_r: err[fs.FsError] = fs.remove_all(alloc, root);
    if (sel remove_all_r.err) { bad = 6; }
    session.dnit(?s);
    ret bad;
}

# runs one fixture on the three native linux targets in both profiles
fun ut_native_fixture_all(alloc: *A.Allocator, program: str, label: str) i32 {
    var release: bool = false;
    var pass:    u32  = 0;
    for (pass < 2) {
        if (ut_native_fixture_case(alloc, "linux-x86_64", "", release, program, label) != 0)              { ret 1; }
        if (ut_native_fixture_case(alloc, "linux-arm64", "qemu-aarch64", release, program, label) != 0)   { ret 2; }
        if (ut_native_fixture_case(alloc, "linux-riscv64", "qemu-riscv64", release, program, label) != 0) { ret 3; }
        release = true;
        pass    = pass + 1;
    }
    ret 0;
}

# record transport extents (#3263): every carrier class on a poisoned stack, the callee never reads carrier padding
# as payload, a returned carrier never writes beyond the logical object, and padding, including the eightbyte no
# register delivered, is zero after the round trip
fun ut_record_extents_program() str {
    ret "rec P1 { a: u8; }\nrec T3 { a: u8; b: [2]u8; }\nrec T9 { a: u8; b: [8]u8; }\nrec S4 { a: u8; b: u16; }\nrec Nest { a: u8; b: S4; }\n#[packed]\nrec PK9 { a: u8; b: u64; }\n#[align(16)]\nrec AL16 { a: u8; b: u8; }\nrec TF { a: u8; b: f64; }\nrec TFM { b: f64; c: i64; }\nrec Mid { a: u8; b: [3]u8; c: [10]u8; }\n#[packed]\nrec Cell { lo: u8; t: T3; hi: u8; }\nrec Row { lo: u8; t: T9; hi: u8; }\n\n#[noinline] fun byte_at(p: *u8, i: u64) u8 { ret p[i]; }\n#[noinline] fun sink(p: *u8) u8 { ret p[0]; }\n# dirties the stack region a following callee's frame and its carrier homes will occupy\n#[noinline] fun dirty() u8 { var junk: [2048]u8; var i: u64 = 0; for (i < 2048) { junk[i] = 0xAA; i = i + 1; } ret sink(?junk[0]); }\n#[noinline] fun zeros_from(p: *u8, from: u64, to: u64) u8 { var i: u64 = from; for (i < to) { if (p[i] != 0) { ret 0; } i = i + 1; } ret 1; }\n\n#[noinline] fun mk_p1(x: u8) P1 { var r: P1; r.a = x; ret r; }\n#[noinline] fun mk_t3(x: u8) T3 { var r: T3; r.a = 1; r.b[0] = x; r.b[1] = x + 1; ret r; }\n#[noinline] fun mk_t9(x: u8) T9 { var r: T9; r.a = 1; r.b[0] = x; r.b[7] = x + 1; ret r; }\n#[noinline] fun mk_s4(x: u16) S4 { var r: S4; r.a = 1; r.b = x; ret r; }\n#[noinline] fun mk_nest(x: u16) Nest { var r: Nest; r.a = 1; r.b = mk_s4(x); ret r; }\n#[noinline] fun mk_pk9(x: u64) PK9 { var r: PK9; r.a = 1; r.b = x; ret r; }\n#[noinline] fun mk_al16(x: u8) AL16 { var r: AL16; r.a = 1; r.b = x; ret r; }\n#[noinline] fun mk_tf(x: f64) TF { var r: TF; r.a = 1; r.b = x; ret r; }\n#[noinline] fun mk_tfm(x: i64) TFM { var r: TFM; r.b = 2.5; r.c = x; ret r; }\n#[noinline] fun mk_mid(x: u8) Mid { var r: Mid; r.a = 1; r.b[0] = x; r.b[2] = x + 2; ret r; }\n\n# callee-side checks: the carrier's padding never becomes payload, and a copy of the parameter keeps its zero suffix\n#[noinline] fun t_p1(v: P1) u8 { ret v.a; }\n#[noinline] fun t_t3(v: T3) u8 { val c: T3 = v; if (c.a != 1) { ret 0xFF; } ret c.b[0] + c.b[1]; }\n#[noinline] fun t_t9(v: T9) u8 { val c: T9 = v; val p: *u8 = (?c)::*u8; if (byte_at(p, 0) != 1) { ret 0xFE; } ret c.b[0] + c.b[7]; }\n#[noinline] fun t_s4(v: S4) u16 { val p: *u8 = (?v)::*u8; if (byte_at(p, 1) != 0) { ret 0xFFFE; } if (v.a != 1) { ret 0xFFFF; } ret v.b; }\n#[noinline] fun t_nest(v: Nest) u16 { val p: *u8 = (?v)::*u8; if (byte_at(p, 1) != 0 || byte_at(p, 3) != 0) { ret 0xFFFE; } if (v.a != 1) { ret 0xFFFF; } ret t_s4(v.b); }\n#[noinline] fun t_pk9(v: PK9) u64 { val c: PK9 = v; if (c.a != 1) { ret 0; } ret c.b; }\n#[noinline] fun t_al16(v: AL16) u8 { val p: *u8 = (?v)::*u8; if (zeros_from(p, 2, 16) == 0) { ret 0xFE; } val c: AL16 = v; val q: *u8 = (?c)::*u8; if (zeros_from(q, 2, 16) == 0) { ret 0xFD; } if (c.a != 1) { ret 0xFF; } ret c.b; }\n#[noinline] fun t_tf(v: TF) f64 { val p: *u8 = (?v)::*u8; if (zeros_from(p, 1, 8) == 0) { ret -2.0; } if (v.a != 1) { ret -1.0; } ret v.b; }\n#[noinline] fun t_tfm(v: TFM) i64 { if (v.b != 2.5) { ret -1; } ret v.c; }\n#[noinline] fun t_mid(v: Mid) u8 { val p: *u8 = (?v)::*u8; if (zeros_from(p, 4, 14) == 0) { ret 0xFE; } if (v.a != 1) { ret 0xFF; } ret v.b[0] + v.b[2]; }\n#[noinline] fun many9(a: T9, b: T9, c: T9, d: T9, e: T9, f: T9, g: T9, h: T9, i: T9) u64 { ret t_t9(a)::u64 + t_t9(b)::u64 + t_t9(c)::u64 + t_t9(d)::u64 + t_t9(e)::u64 + t_t9(f)::u64 + t_t9(g)::u64 + t_t9(h)::u64 + t_t9(i)::u64; }\n#[noinline] fun many_al(a: AL16, b: AL16, c: AL16, d: AL16, e: AL16, f: AL16, g: AL16, h: AL16, i: AL16) u64 { ret t_al16(a)::u64 + t_al16(b)::u64 + t_al16(c)::u64 + t_al16(d)::u64 + t_al16(e)::u64 + t_al16(f)::u64 + t_al16(g)::u64 + t_al16(h)::u64 + t_al16(i)::u64; }\n#[noinline] fun after_al(a: AL16, next: i64) i64 { if (a.a != 1) { ret -1; } ret a.b::i64 + next; }\n#[noinline] fun al_after(first: i64, a: AL16, next: i64) i64 { if (a.a != 1) { ret -1; } ret a.b::i64 + next + first; }\n\n#[symbol(\"main\")]\nfun main(argc: i64) i64 {\n    if ($size_of(T3) != 3 || $size_of(T9) != 9 || $size_of(S4) != 4 || $size_of(Nest) != 6 || $size_of(PK9) != 9 || $size_of(AL16) != 16 || $align_of(AL16) != 16 || $size_of(TF) != 16 || $size_of(Mid) != 14) { ret 100; }\n    # round trips through carriers wider than the object, on a poisoned stack\n    dirty();\n    if (t_p1(mk_p1(0)) != 0 || t_p1(mk_p1(1)) != 1) { ret 1; }\n    dirty();\n    if (t_t3(mk_t3(3)) != 7) { ret 2; }\n    dirty();\n    if (t_t9(mk_t9(4)) != 9) { ret 3; }\n    dirty();\n    if (t_s4(mk_s4(0x1234)) != 0x1234) { ret 4; }\n    dirty();\n    if (t_nest(mk_nest(0x0506)) != 0x0506) { ret 5; }\n    dirty();\n    if (t_pk9(mk_pk9(0x1122334455667788)) != 0x1122334455667788) { ret 6; }\n    dirty();\n    if (t_al16(mk_al16(9)) != 9) { ret 7; }\n    dirty();\n    if (t_tf(mk_tf(2.5)) != 2.5) { ret 8; }\n    dirty();\n    if (t_tfm(mk_tfm(-77)) != -77) { ret 9; }\n    dirty();\n    if (t_mid(mk_mid(1)) != 4) { ret 10; }\n    dirty();\n    if (many9(mk_t9(1), mk_t9(2), mk_t9(3), mk_t9(4), mk_t9(5), mk_t9(6), mk_t9(7), mk_t9(8), mk_t9(9)) != 99) { ret 11; }\n    dirty();\n    if (many_al(mk_al16(1), mk_al16(2), mk_al16(3), mk_al16(4), mk_al16(5), mk_al16(6), mk_al16(7), mk_al16(8), mk_al16(9)) != 45) { ret 12; }\n    # the argument after an over-aligned record lands where the convention puts it\n    if (after_al(mk_al16(3), 40) != 43 || al_after(100, mk_al16(3), 40) != 143) { ret 13; }\n    # storing a returned carrier never writes beyond the logical object\n    var cell: Cell;\n    cell.lo = 0x5A; cell.hi = 0xA5;\n    dirty();\n    cell.t = mk_t3(1);\n    if (cell.lo != 0x5A || cell.hi != 0xA5 || t_t3(cell.t) != 3) { ret 20; }\n    var row: Row;\n    row.lo = 0x5A; row.hi = 0xA5;\n    dirty();\n    row.t = mk_t9(1);\n    if (row.lo != 0x5A || row.hi != 0xA5 || t_t9(row.t) != 3) { ret 21; }\n    var arr: [3]T9;\n    val pa: *u8 = (?arr)::*u8;\n    var i: u64 = 0;\n    for (i < 27) { pa[i] = 0xCC; i = i + 1; }\n    dirty();\n    arr[1] = mk_t9(2);\n    if (byte_at(pa, 8) != 0xCC || byte_at(pa, 18) != 0xCC || byte_at(pa, 9) != 1 || t_t9(arr[1]) != 5) { ret 22; }\n    var cells: [3]T3;\n    val pc: *u8 = (?cells)::*u8;\n    i = 0;\n    for (i < 9) { pc[i] = 0xCC; i = i + 1; }\n    dirty();\n    cells[1] = mk_t3(2);\n    if (byte_at(pc, 2) != 0xCC || byte_at(pc, 6) != 0xCC || byte_at(pc, 3) != 1 || byte_at(pc, 4) != 2 || byte_at(pc, 5) != 3) { ret 23; }\n    # the padding of a returned object is zero after the round trip, including the eightbyte no register delivered\n    dirty();\n    var s: S4 = mk_s4(7);\n    val ps: *u8 = (?s)::*u8;\n    if (byte_at(ps, 1) != 0) { ret 30; }\n    dirty();\n    var n: Nest = mk_nest(8);\n    val pn: *u8 = (?n)::*u8;\n    if (byte_at(pn, 1) != 0 || byte_at(pn, 3) != 0) { ret 31; }\n    dirty();\n    var al: AL16 = mk_al16(1);\n    if (zeros_from((?al)::*u8, 2, 16) == 0) { ret 32; }\n    dirty();\n    var tf: TF = mk_tf(1.0);\n    if (zeros_from((?tf)::*u8, 1, 8) == 0) { ret 33; }\n    dirty();\n    var m: Mid = mk_mid(0);\n    if (zeros_from((?m)::*u8, 4, 14) == 0) { ret 34; }\n    ret 0;\n}\n";
}

test "mach.lang.driver:record_transport_preserves_logical_extents_through_wider_carriers_on_every_native_backend" {
    $if ($mach.build.os != $mach.os.linux || $mach.build.arch != $mach.arch.x86_64) { ret 0; }
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    ret ut_native_fixture_all(?alloc, ut_record_extents_program(), "transport extents");
}

# the pipeline's verdict on one program: 0 accepted, 1 rejected (a reported diagnostic, or the constant-time
# validator's refusal, which the backend still surfaces as an internal failure naming the oblivious function), -1 apparatus
fun ut_pipeline_verdict(alloc: *A.Allocator, text: str, found: pipeline.OptLevel) i32 {
    val sr: res[session.Session, fail.Fail] = session.init(alloc);
    if (sel sr.err) { ret -1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) { ret -1; }
    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = text;
    val root_r: res[str, fail.Fail] = ut_scaffold(alloc, ?names[0], ?texts[0], 1);
    if (sel root_r.err) { ret -1; }
    val root: str = root_r.ok;
    fin { fs.remove_all(alloc, root); }
    val pr: res[project.Project, outcome.Fail] = ut_back_half_opt(?s, root, found);
    if (sel pr.err) {
        val f: outcome.Fail = pr.err;
        if (sel f.reported)                                                         { ret 1; }
        if (sel f.internal && ut_str_contains(outcome.describe(f), "#[oblivious]")) { ret 1; }
        ret -1;
    }
    var p: project.Project = pr.ok;
    project.dnit_project(?p);
    ret 0;
}

# secret content in an aggregate is a property of its bytes, not of the home that holds them (#3263)
test "mach.lang.driver:record_secret_content_transport_keeps_content_secrecy_and_public_fields_public" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val head:   str    = "rec Rec { a: u64; b: u64; } rec S { d: u64; p: ^u64; } rec P { d: u64; p: u64; } ";
    var bodies: [9]str = [9]str{
        "#[oblivious] fun f(v: ^Rec) u64 { ret (v.a):>u64; }",
        "#[oblivious] #[noinline] fun c(v: ^Rec) ^Rec { val u: ^Rec = v; ret u; }",
        "#[oblivious] #[noinline] fun mk() ^Rec { var r: ^Rec; ret r; } #[oblivious] fun use() u64 { val r: ^Rec = mk(); ret (r.a):>u64; }",
        "#[oblivious] fun g(v: S) u64 { ret (v.p):>u64; }",
        "#[oblivious] #[noinline] fun k(v: S) S { ret v; } #[oblivious] fun m() u64 { var t: S; t.d = 1; t.p = 5; val u: S = k(t); ret (u.p):>u64; }",
        "#[oblivious] fun q(v: P) u64 { if (v.p > 3) { ret 1; } ret 0; }",
        "#[oblivious] fun d(v: S) u64 { if (v.d > 3) { ret 1; } ret 0; }",
        "#[oblivious] fun h(v: S) u64 { if (v.p > 3) { ret 1; } ret 0; }",
        "#[oblivious] fun x(v: S, p: *u8) u8 { ret p[v.p]; }"
    };
    var want: [9]i32 = [9]i32{0, 0, 0, 0, 0, 0, 0, 1, 1};
    var i:    usize  = 0;
    for (i < 9) {
        val text:      str = ut_cc3(?alloc, head, " ", bodies[i]);
        val debug_v:   i32 = ut_pipeline_verdict(?alloc, text, pipeline.OPT_DEBUG);
        val release_v: i32 = ut_pipeline_verdict(?alloc, text, pipeline.OPT_RELEASE);
        str_free(?alloc, text);
        if (debug_v != want[i]) {
            print.printf("record-secrecy: debug verdict {} for fixture {}\n", debug_v, i);
            ret 2;
        }
        if (release_v != want[i]) {
            print.printf("record-secrecy: release verdict {} for fixture {}\n", release_v, i);
            ret 3;
        }
        i = i + 1;
    }
    ret 0;
}

fun ut_record_secrecy_program() str {
    ret "rec S { d: u64; p: ^u64; }\nrec P { d: u64; p: u64; }\n#[noinline] fun take_s(v: S) u64 { if (v.d == 1) { ret (v.p):>u64; } ret 0; }\n#[noinline] fun take_p(v: P) u64 { if (v.d == 1) { ret v.p; } ret 0; }\n#[noinline] fun give_s(x: ^u64) S { var r: S; r.d = 1; r.p = x; ret r; }\n#[noinline] fun give_p(x: u64) P { var r: P; r.d = 1; r.p = x; ret r; }\nfun call_s(x: ^u64) u64 { ret take_s(give_s(x)); }\nfun call_p(x: u64) u64 { ret take_p(give_p(x)); }\n";
}

fun ut_str_ends_with(hay: str, needle: str) bool {
    val hn: usize = str_len(hay);
    val nn: usize = str_len(needle);
    if (nn > hn) { ret false; }
    var k: usize = 0;
    for (k < nn) {
        if (hay[hn - nn + k] != needle[k]) { ret false; }
        k = k + 1;
    }
    ret true;
}

# counts the argument moves of a vreg into a physical register (those ahead of a block's last call) in the function
# whose name ends with `suffix`, and how many of those vregs are secret; also whether any conditional branch in it
# reads a secret vreg. a function without a call has only return moves, which count as its argument moves here
fun ut_transport_moves(s: *session.Session, mm: *mir.MirModule, suffix: str, moves: *u32, secret: *u32, branch_secret: *bool) bool {
    var vregs: u32 = 0;
    ret ut_transport_moves_v(s, mm, suffix, moves, secret, branch_secret, ?vregs);
}

# the same, also counting the function's secret vregs of any role
fun ut_transport_moves_v(s: *session.Session, mm: *mir.MirModule, suffix: str, moves: *u32, secret: *u32, branch_secret: *bool, secret_vregs: *u32) bool {
    @moves         = 0;
    @secret        = 0;
    @branch_secret = false;
    @secret_vregs  = 0;
    var fi: u32 = 0;
    for (fi < mm.function_len) {
        val mf:   *mir.MirFunction = ?mm.functions[fi];
        val name: opt[str]         = intern.lookup(?s.interner, mf.name);
        if (sel name.none) {
            fi = fi + 1;
            cnt;
        }
        if (!ut_str_ends_with(name.some, suffix)) {
            fi = fi + 1;
            cnt;
        }
        var vi: u32 = 0;
        for (vi < mf.vreg_count) {
            if (mf.vregs[vi].secret) { @secret_vregs = @secret_vregs + 1; }
            vi = vi + 1;
        }
        var bi: u32 = 0;
        for (bi < mf.block_count) {
            val blk:       *mir.MirBlock = ?mf.blocks[bi];
            var last_call: u32           = 0;
            var has_call:  bool          = false;
            var ci:        u32           = 0;
            for (ci < blk.instr_count) {
                if (blk.instrs[ci].opcode == mir.MIR_CALL) {
                    last_call = ci;
                    has_call  = true;
                }
                ci = ci + 1;
            }
            var ii: u32 = 0;
            for (ii < blk.instr_count) {
                val mi: *mir.MirInstr = ?blk.instrs[ii];
                if (mi.opcode == mir.MIR_MOV && mi.operand_count >= 2
                    && mi.operands[0].kind == mir.MIR_OP_PREG && mi.operands[1].kind == mir.MIR_OP_VREG
                    && (!has_call || ii < last_call)) {
                    @moves = @moves + 1;
                    if (mf.vregs[mi.operands[1].vreg.n].secret) { @secret = @secret + 1; }
                }
                if (mi.opcode == mir.MIR_CBR || mir.is_fused_cbr(mi.opcode)) {
                    var k: u32 = 0;
                    for (k < mi.operand_count) {
                        if (mi.operands[k].kind == mir.MIR_OP_VREG && mf.vregs[mi.operands[k].vreg.n].secret) { @branch_secret = true; }
                        k = k + 1;
                    }
                }
                ii = ii + 1;
            }
            bi = bi + 1;
        }
        ret true;
    }
    ret false;
}

fun ut_record_secrecy_carriers(alloc: *A.Allocator, target_name: str, found: pipeline.OptLevel) i32 {
    val sr: res[session.Session, fail.Fail] = session.init(alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    val pr: res[project.Project, outcome.Fail] = ut_vec_lower_opt(?s, alloc, ut_record_secrecy_program(), target_name, found);
    if (sel pr.err) { ret 2; }
    var p: project.Project = pr.ok;
    fin { project.dnit_project(?p); }
    var bad: i32 = 0;
    var mi:  u32 = 0;
    for (mi < p.module_len) {
        val me: *project.ModuleEntry = ?p.modules[mi];
        if (me.ir_module == nil) {
            mi = mi + 1;
            cnt;
        }
        val mr: res[mir.MirModule, fail.Fail] = mirlower.lower_module(?p.target, me.ir_module, alloc, ?s.interner, ?s.sources);
        if (sel mr.err) { ret 3; }
        var mm:     mir.MirModule = mr.ok;
        var moves:  u32           = 0;
        var secret: u32           = 0;
        var branch: bool          = false;
        # the secret argument and both carrier pieces of the secret-content record are secret at the call
        if (!ut_transport_moves(?s, ?mm, ".call_s", ?moves, ?secret, ?branch)) { ret 4; }
        if (moves < 3 || secret != moves) {
            print.printf("record-secrecy: call_s moved {} vregs, {} secret\n", moves, secret);
            bad = 5;
        }
        # the public record's carriers and the public argument stay public
        if (!ut_transport_moves(?s, ?mm, ".call_p", ?moves, ?secret, ?branch)) { ret 6; }
        if (secret != 0) {
            print.printf("record-secrecy: call_p moved {} vregs, {} secret\n", moves, secret);
            bad = 7;
        }
        # the returned carriers of a secret-content record are secret; a public record's are not
        if (!ut_transport_moves(?s, ?mm, ".give_s", ?moves, ?secret, ?branch)) { ret 8; }
        if (moves < 2 || secret != moves) {
            print.printf("record-secrecy: give_s moved {} vregs, {} secret\n", moves, secret);
            bad = 9;
        }
        if (!ut_transport_moves(?s, ?mm, ".give_p", ?moves, ?secret, ?branch)) { ret 10; }
        if (secret != 0)                                                       { bad = 11; }
        # reading the public field keeps its public provenance: the test on it never branches on a secret, while the
        # secret field's value still reaches the function as a secret vreg after the profile's own passes ran over
        # the by-value copy (release splits it into per-field slots and promotes them)
        var vregs: u32 = 0;
        if (!ut_transport_moves_v(?s, ?mm, ".take_s", ?moves, ?secret, ?branch, ?vregs)) { ret 12; }
        if (branch)                                                                      { bad = 13; }
        if (vregs == 0) {
            print.print("record-secrecy: take_s holds no secret vreg\n");
            bad = 16;
        }
        if (!ut_transport_moves_v(?s, ?mm, ".take_p", ?moves, ?secret, ?branch, ?vregs)) { ret 14; }
        if (branch || vregs != 0)                                                        { bad = 15; }
        mir.dnit_module(?mm);
        mi = mi + 1;
    }
    ret bad;
}

test "mach.lang.driver:record_secret_content_carriers_are_secret_and_the_public_field_test_is_public_on_x86_64_and_aarch64" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val x86: i32 = ut_record_secrecy_carriers(?alloc, "linux", pipeline.OPT_DEBUG);
    if (x86 != 0) { ret 20 + x86; }
    val arm: i32 = ut_record_secrecy_carriers(?alloc, "linux-arm64", pipeline.OPT_DEBUG);
    if (arm != 0) { ret 40 + arm; }
    val x86r: i32 = ut_record_secrecy_carriers(?alloc, "linux", pipeline.OPT_RELEASE);
    if (x86r != 0) { ret 60 + x86r; }
    val armr: i32 = ut_record_secrecy_carriers(?alloc, "linux-arm64", pipeline.OPT_RELEASE);
    if (armr != 0) { ret 80 + armr; }
    ret 0;
}

fun ut_tag_guard_program() str {
    ret "tag res[T, E]: u8 { err: E; ok: T; } tag opt[T]: u8 { none; some: T; } tag err[E]: u8 { err: E; ok; }\ntag Reply: u8 { empty; value: i64; }\n\npub var SEED: i64 = 42;\n\n#[noinline]\nfun make(v: i64) Reply { ret Reply.value{v}; }\n\n#[symbol(\"main\")]\nfun main(argc: i64) i64 {\n    var r: Reply = make(SEED);\n    if (argc == 1) { if (sel r.value) { ret r.value; } ret 1; }\n    if (argc == 2) { val g: res[i64, u8] = res[i64, u8].err{7}; if (sel g.err) { ret g.err::i64; } ret 1; }\n    if (argc == 3) {\n        var t: i64 = 0;\n        var i: i64 = 0;\n        for (i < 3) { i = i + 1; val item: opt[i64] = opt[i64].some{i}; if (!sel item.some) { cnt; } t = t + item.some; }\n        ret t;\n    }\n    if (sel r.value) {\n        val code: *u8 = (?r)::*u8;\n        @code = 0;\n        ret r.value;\n    }\n    ret 1;\n}\n\n#[symbol(\"_start\")]\npub fun start() {\n    $if ($mach.build.arch == $mach.arch.x86_64) {\n        asm x86_64 {\n            mov rdi, [rsp]\n            and rsp, -16\n            call main\n            mov rdi, rax\n            mov rax, 60\n            syscall\n        }\n    }\n    $or ($mach.build.arch == $mach.arch.aarch64) {\n        asm aarch64 {\n            ldr x0, [sp]\n            bl main\n            mov x8, 93\n            svc 0\n        }\n    }\n    $or {\n        asm riscv64 {\n            ld a0, 0(sp)\n            call main\n            li a7, 93\n            ecall\n        }\n    }\n}\n";
}

# builds the guard program for one target and runs it: argc 1..3 read guarded payloads, argc 4 switches
# the case through a pointer under a guard, which traps in the debug profile and reads through in release
# builds the guard program for one target and runs it: argc 1..3 read guarded payloads, argc 4 switches
# the case through a pointer under a guard, which traps in the debug profile and reads through in release
fun ut_tag_guard_target(alloc: *A.Allocator, target_name: str, runner_name: str, release: bool) i32 {
    var runner: str = "";
    if (!str_empty(runner_name)) {
        val rr: res[str, exec.Error] = exec.resolve(alloc, runner_name);
        if (sel rr.err) {
            print.print("tag-guard: runner absent, arm skipped: ");
            print.print(runner_name);
            print.print("\n");
            ret 0;
        }
        runner = rr.ok;
    }
    val sr: res[session.Session, fail.Fail] = session.init(alloc);
    if (sel sr.err) { ret 1; }
    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = ut_tag_guard_program();
    val root_r: res[str, fail.Fail] = ut_scaffold_m(alloc, ut_divide_manifest(), ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    var bad: i32                                  = 0;
    val mr:  res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) {
        fs.remove_all(alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var m:  manifest.Manifest    = mr.ok;
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    rq.target       = target_name;
    if (release) {
        rq.profile = "release";
        rq.opt     = pipeline.OPT_RELEASE;
    }
    val pr: res[bplan.BuildPlan, outcome.Fail] = bplan.plan(alloc, ?s.interner, s.registry, ?m, rq);
    if (sel pr.err) {
        fs.remove_all(alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var bp: bplan.BuildPlan                         = pr.ok;
    val br: res[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, alloc, nil);
    if (sel br.err) { bad = 1; }
    if (sel br.ok) {
        val bo: outcome.BuildOutcome = br.ok;
        if (bo.severity != outcome.BUILD_OK || bo.artifacts.len != 1) { bad = 1; }
        or {
            val program: str  = bo.artifacts.data[0].path;
            var trapped: bool = false;
            var code:    i32  = 0;
            if (!ut_run_with_argc(root, runner, program, 1, ?trapped, ?code) || trapped || code != 42) { bad = 2; }
            if (!ut_run_with_argc(root, runner, program, 2, ?trapped, ?code) || trapped || code != 7)  { bad = 3; }
            if (!ut_run_with_argc(root, runner, program, 3, ?trapped, ?code) || trapped || code != 6)  { bad = 4; }
            if (!ut_run_with_argc(root, runner, program, 4, ?trapped, ?code))                          { bad = 5; }
            or (release) {
                if (trapped || code != 42) { bad = 6; }
            }
            or (!trapped) { bad = 7; }
            if (bad != 0) {
                print.print("tag-guard: unexpected outcome on ");
                print.print(target_name);
                print.printf(" (step {}, trapped {}, exit {})\n", bad, trapped::u8, code);
            }
        }
    }
    val remove_all_r: err[fs.FsError] = fs.remove_all(alloc, root);
    if (sel remove_all_r.err) { bad = 8; }
    session.dnit(?s);
    ret bad;
}

test "mach.lang.driver:guarded_payload_reads_return_the_payload_on_every_native_backend" {
    $if ($mach.build.os != $mach.os.linux || $mach.build.arch != $mach.arch.x86_64) { ret 0; }
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err)                                                          { ret 1; }
    if (ut_tag_guard_target(?alloc, "linux-x86_64", "", true) != 0)              { ret 1; }
    if (ut_tag_guard_target(?alloc, "linux-arm64", "qemu-aarch64", true) != 0)   { ret 2; }
    if (ut_tag_guard_target(?alloc, "linux-riscv64", "qemu-riscv64", true) != 0) { ret 3; }
    ret 0;
}

test "mach.lang.driver:debug_profile_traps_a_guarded_read_after_the_case_changes" {
    $if ($mach.build.os != $mach.os.linux || $mach.build.arch != $mach.arch.x86_64) { ret 0; }
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err)                                                           { ret 1; }
    if (ut_tag_guard_target(?alloc, "linux-x86_64", "", false) != 0)              { ret 1; }
    if (ut_tag_guard_target(?alloc, "linux-arm64", "qemu-aarch64", false) != 0)   { ret 2; }
    if (ut_tag_guard_target(?alloc, "linux-riscv64", "qemu-riscv64", false) != 0) { ret 3; }
    ret 0;
}

# the freestanding entry stub shared by the native tag fixtures
fun ut_tag_start_stub() str {
    ret "\n#[symbol(\"_start\")]\npub fun start() {\n    $if ($mach.build.arch == $mach.arch.x86_64) {\n        asm x86_64 {\n            mov rdi, [rsp]\n            and rsp, -16\n            call main\n            mov rdi, rax\n            mov rax, 60\n            syscall\n        }\n    }\n    $or ($mach.build.arch == $mach.arch.aarch64) {\n        asm aarch64 {\n            ldr x0, [sp]\n            bl main\n            mov x8, 93\n            svc 0\n        }\n    }\n    $or {\n        asm riscv64 {\n            ld a0, 0(sp)\n            call main\n            li a7, 93\n            ecall\n        }\n    }\n}\n";
}

# tag locals, globals, array elements, record fields, nested tags and pointer receivers: reads, writes, `?` addresses and whole copies
fun ut_l3_storage_program() str {
    ret "tag Reply: u8 { empty; value: i64; }\ntag Outer: u8 { none; inner: Reply; byte: u8; }\nrec Box { n: u8; r: Reply; m: i64; }\n\nvar g_zero: Reply;\nvar g_init: Reply = Reply.value{42};\nvar g_arr: [3]Reply;\nvar g_box: Box;\nvar g_out: Outer = Outer.inner{Reply.value{9}};\n\n#[noinline]\nfun make(v: i64) Reply { ret Reply.value{v}; }\n\n#[noinline]\nfun take(r: Reply) i64 { if (sel r.value) { ret r.value; } ret -1; }\n\n#[noinline]\nfun bump(p: *Reply) { if (sel (@p).value) { (@p).value = (@p).value + 1; } }\n\n#[symbol(\"main\")]\nfun main(argc: i64) i64 {\n    # locals\n    var l0: Reply;\n    if (take(l0) != -1) { ret 1; }\n    var l1: Reply = Reply.value{42};\n    if (!sel l1.value) { ret 2; }\n    if (l1.value != 42) { ret 3; }\n    if (sel l1.value) { l1.value = 7; }\n    if (sel l1.value && l1.value != 7) { ret 4; }\n    if (sel l1.value) { val q: *i64 = ?l1.value; @q = 8; }\n    if (take(l1) != 8) { ret 5; }\n    val c1: Reply = l1;\n    if (take(c1) != 8) { ret 6; }\n    l0 = c1;\n    if (take(l0) != 8) { ret 7; }\n    l0 = Reply.empty{};\n    if (take(l0) != -1) { ret 8; }\n    val m: Reply = make(11);\n    if (take(m) != 11) { ret 9; }\n\n    # globals\n    if (take(g_zero) != -1) { ret 10; }\n    if (take(g_init) != 42) { ret 11; }\n    g_zero = Reply.value{5};\n    if (take(g_zero) != 5) { ret 12; }\n    if (sel g_zero.value) { g_zero.value = 6; }\n    if (take(g_zero) != 6) { ret 13; }\n    if (sel g_zero.value) { val q: *i64 = ?g_zero.value; @q = @q + 1; }\n    if (take(g_zero) != 7) { ret 14; }\n    g_init = g_zero;\n    if (take(g_init) != 7) { ret 15; }\n    val gc: Reply = g_init;\n    if (take(gc) != 7) { ret 16; }\n\n    # arrays\n    var a: [3]Reply;\n    if (take(a[0]) != -1 || take(a[1]) != -1 || take(a[2]) != -1) { ret 20; }\n    a[1] = Reply.value{21};\n    if (take(a[1]) != 21) { ret 21; }\n    if (sel a[1].value) { a[1].value = 22; }\n    if (take(a[1]) != 22) { ret 22; }\n    if (sel a[1].value) { val q: *i64 = ?a[1].value; @q = 23; }\n    if (take(a[1]) != 23) { ret 23; }\n    a[2] = a[1];\n    if (take(a[2]) != 23) { ret 24; }\n    if (take(a[0]) != -1) { ret 25; }\n    val ac: [3]Reply = a;\n    if (take(ac[2]) != 23 || take(ac[0]) != -1) { ret 26; }\n    if (take(g_arr[2]) != -1) { ret 27; }\n    g_arr[2] = Reply.value{28};\n    if (take(g_arr[2]) != 28) { ret 28; }\n    g_arr = a;\n    if (take(g_arr[1]) != 23 || take(g_arr[0]) != -1) { ret 29; }\n\n    # record fields\n    var b: Box;\n    if (take(b.r) != -1) { ret 30; }\n    b.r = Reply.value{31};\n    if (take(b.r) != 31) { ret 31; }\n    if (sel b.r.value) { b.r.value = 32; }\n    if (take(b.r) != 32) { ret 32; }\n    if (sel b.r.value) { val q: *i64 = ?b.r.value; @q = 33; }\n    if (take(b.r) != 33) { ret 33; }\n    val bc: Box = b;\n    if (take(bc.r) != 33) { ret 34; }\n    val b2: Box = Box{n: 1, r: Reply.value{35}, m: 2};\n    if (take(b2.r) != 35 || b2.n != 1 || b2.m != 2) { ret 35; }\n    if (take(g_box.r) != -1) { ret 36; }\n    g_box = b2;\n    if (take(g_box.r) != 35) { ret 37; }\n\n    # tags in tags\n    var o: Outer;\n    if (is_none(o) == 0) { ret 40; }\n    o = Outer.inner{Reply.value{41}};\n    if (is_inner(o) == 0) { ret 41; }\n    if (sel o.inner && !sel o.inner.value) { ret 42; }\n    if (sel o.inner) { if (sel o.inner.value) { if (o.inner.value != 41) { ret 43; } } }\n    if (sel o.inner) { if (sel o.inner.value) { o.inner.value = 44; } }\n    if (sel o.inner) { if (take(o.inner) != 44) { ret 44; } }\n    if (sel o.inner) { o.inner = Reply.empty{}; if (!sel o.inner.empty) { ret 45; } }\n    if (sel o.inner) { val q: *Reply = ?o.inner; @q = Reply.value{46}; if (take(o.inner) != 46) { ret 46; } }\n    val oc: Outer = o;\n    if (sel oc.inner) { if (take(oc.inner) != 46) { ret 47; } } or { ret 47; }\n    if (is_inner(g_out) == 0) { ret 48; }\n    if (sel g_out.inner) { if (take(g_out.inner) != 9) { ret 49; } }\n    o = Outer.byte{3};\n    if (is_inner(o) != 0 || is_none(o) != 0) { ret 50; } if (sel o.byte && o.byte != 3) { ret 50; }\n\n    # through pointers\n    var pr: Reply = Reply.value{51};\n    val p: *Reply = ?pr;\n    if (take(@p) != 51) { ret 51; }\n    if (sel (@p).value && (@p).value != 51) { ret 52; }\n    if (sel (@p).value && (@p).value != 51) { ret 53; }\n    bump(p);\n    if (take(pr) != 52) { ret 54; }\n    @p = Reply.value{55};\n    if (take(pr) != 55) { ret 55; }\n    val d: Reply = @p;\n    if (take(d) != 55) { ret 56; }\n    if (sel (@p).value) { (@p).value = 57; }\n    if (take(pr) != 57) { ret 57; }\n    if (sel (@p).value) { val q: *i64 = ?(@p).value; @q = 58; }\n    if (take(pr) != 58) { ret 58; }\n    val pa: *[3]Reply = ?a;\n    if (take((@pa)[1]) != 23) { ret 59; }\n    (@pa)[0] = Reply.value{60};\n    if (take(a[0]) != 60) { ret 60; }\n    val pb: *Box = ?b;\n    if (take(pb.r) != 33) { ret 61; }\n    pb.r = Reply.value{62};\n    if (take(b.r) != 62) { ret 62; }\n    ret 0;\n}\n\n#[noinline]\nfun is_none(o: Outer) u8 { if (sel o.none) { ret 1; } ret 0; }\n#[noinline]\nfun is_inner(o: Outer) u8 { if (sel o.inner) { ret 1; } ret 0; }\n";
}

# byte-level replacement checks: inactive suffix, discriminator gap, payloadless replacement, tail padding, a 4-byte payload in a 20-byte tag,
# and constructions in callees whose frames overlay a poisoned stack region
# byte-level replacement checks: inactive suffix, discriminator gap, payloadless replacement, tail padding, a 4-byte payload in a 20-byte tag,
# and constructions in callees whose frames overlay a poisoned stack region
fun ut_l3_zeroing_program() str {
    ret "tag Reply: u8 { empty; value: i64; }\ntag Big: u8 { small: u8; big: [16]u8; mid: u32; }\ntag Wide: u32 { a; b: u64; }\ntag Tail: u8 { a; b: u16; c: [3]u8; }\n\n#[noinline]\nfun fill(n: u8) [16]u8 { var a: [16]u8; var i: u64 = 0; for (i < 16) { a[i] = n; i = i + 1; } ret a; }\n\n#[noinline]\nfun byte_at(p: *u8, i: u64) u8 { ret p[i]; }\n\n#[noinline]\nfun poison(p: *u8, from: u64, to: u64) { var i: u64 = from; for (i < to) { p[i] = 0xAA; i = i + 1; } }\n\n#[noinline]\nfun sink(p: *u8) u8 { ret p[0]; }\n\n# dirties the stack region a following callee's frame will occupy\n#[noinline]\nfun dirty() u8 { var junk: [1024]u8; var i: u64 = 0; for (i < 1024) { junk[i] = 0xAA; i = i + 1; } ret sink(?junk[0]); }\n\n#[noinline]\nfun mk_small(v: u8) Big { ret Big.small{v}; }\n#[noinline]\nfun mk_mid(v: u32) Big { ret Big.mid{v}; }\n#[noinline]\nfun mk_empty() Reply { ret Reply.empty{}; }\n#[noinline]\nfun mk_tail(v: u16) Tail { ret Tail.b{v}; }\n\n#[symbol(\"main\")]\nfun main(argc: i64) i64 {\n    # replacing a larger case by a smaller one clears the inactive suffix\n    if ($size_of(Big) != 20 || $offset_of(Big, big) != 4) { ret 100; }\n    var b: Big = Big.big{fill(0xFF)};\n    val pb: *u8 = (?b)::*u8;\n    if (byte_at(pb, 0) != 1) { ret 1; }\n    if (byte_at(pb, 4) != 0xFF || byte_at(pb, 19) != 0xFF) { ret 2; }\n    b = Big.small{7};\n    if (byte_at(pb, 0) != 0 || byte_at(pb, 4) != 7) { ret 3; }\n    var i: u64 = 1;\n    for (i < 20) { if (i != 4 && byte_at(pb, i) != 0) { ret 4; } i = i + 1; }\n    # tag-owned gap between discriminator and payload is zeroed on replacement\n    var r: Reply = Reply.value{-1};\n    val pr: *u8 = (?r)::*u8;\n    poison(pr, 1, 8);\n    r = Reply.value{5};\n    i = 1;\n    for (i < 8) { if (byte_at(pr, i) != 0) { ret 5; } i = i + 1; }\n    if (byte_at(pr, 8) != 5) { ret 6; }\n    # inactive suffix after replacing a payload case by the payloadless case\n    r = Reply.empty{};\n    i = 0;\n    for (i < 16) { if (byte_at(pr, i) != 0) { ret 7; } i = i + 1; }\n    # tail padding of a u32-discriminated tag (size 16: 4 disc + 4 gap + 8 payload; no tail) and a mid case\n    var w: Wide = Wide.b{0xFFFFFFFFFFFFFFFF};\n    val pw: *u8 = (?w)::*u8;\n    poison(pw, 4, 8);\n    w = Wide.a{};\n    i = 0;\n    for (i < 16) { if (byte_at(pw, i) != 0) { ret 8; } i = i + 1; }\n    # a u32 payload in a 17-byte payload area leaves bytes 5..17 zero\n    b = Big.big{fill(0xEE)};\n    b = Big.mid{0x01020304};\n    if (byte_at(pb, 0) != 2 || byte_at(pb, 4) != 4 || byte_at(pb, 7) != 1) { ret 9; }\n    i = 8;\n    for (i < 20) { if (byte_at(pb, i) != 0) { ret 10; } i = i + 1; }\n    # construction into a fresh local: poison the slot's stack before use is impossible here, so check an array element\n    var arr: [2]Big;\n    arr[1] = Big.big{fill(0xCC)};\n    arr[1] = Big.small{1};\n    val pa: *u8 = (?arr[1])::*u8;\n    i = 5;\n    for (i < 20) { if (byte_at(pa, i) != 0) { ret 11; } i = i + 1; }\n    # tail padding: size 6 with payload at 2, byte 5 is padding and is zeroed by construction\n    if ($size_of(Tail) != 6 || $offset_of(Tail, c) != 2) { ret 12; }\n    var t: Tail = Tail.c{[3]u8{1, 2, 3}};\n    val pt: *u8 = (?t)::*u8;\n    if (byte_at(pt, 0) != 2 || byte_at(pt, 2) != 1 || byte_at(pt, 4) != 3) { ret 13; }\n    poison(pt, 5, 6);\n    t = Tail.b{0x0102};\n    if (byte_at(pt, 0) != 1 || byte_at(pt, 1) != 0 || byte_at(pt, 2) != 2 || byte_at(pt, 3) != 1 || byte_at(pt, 4) != 0 || byte_at(pt, 5) != 0) { ret 14; }\n    # constructions whose temp slot sits on a poisoned stack region are still fully zeroed\n    if (dirty() != 0xAA) { ret 15; }\n    var d1: Big = mk_small(7);\n    val pd1: *u8 = (?d1)::*u8;\n    if (byte_at(pd1, 0) != 0 || byte_at(pd1, 4) != 7) { ret 16; }\n    i = 1;\n    for (i < 20) { if (i != 4 && byte_at(pd1, i) != 0) { ret 17; } i = i + 1; }\n    if (dirty() != 0xAA) { ret 18; }\n    var d2: Big = mk_mid(0x01020304);\n    val pd2: *u8 = (?d2)::*u8;\n    if (byte_at(pd2, 0) != 2 || byte_at(pd2, 4) != 4 || byte_at(pd2, 7) != 1) { ret 19; }\n    i = 1;\n    for (i < 20) { if ((i < 4 || i > 7) && byte_at(pd2, i) != 0) { ret 20; } i = i + 1; }\n    if (dirty() != 0xAA) { ret 21; }\n    var d3: Reply = mk_empty();\n    val pd3: *u8 = (?d3)::*u8;\n    i = 0;\n    for (i < 16) { if (byte_at(pd3, i) != 0) { ret 22; } i = i + 1; }\n    if (dirty() != 0xAA) { ret 23; }\n    var d4: Tail = mk_tail(0x0102);\n    val pd4: *u8 = (?d4)::*u8;\n    if (byte_at(pd4, 0) != 1 || byte_at(pd4, 1) != 0 || byte_at(pd4, 2) != 2 || byte_at(pd4, 3) != 1 || byte_at(pd4, 4) != 0 || byte_at(pd4, 5) != 0) { ret 24; }\n    ret 0;\n}\n";
}

# rhs-first assignment: the destination index, a replacement initializer reading the old payload, a destination call and an aliasing self-copy
fun ut_l3_order_program() str {
    ret "tag Reply: u8 { empty; value: i64; }\nvar seq: i64 = 0;\n\n#[noinline]\nfun next(i: *i64) Reply { @i = @i + 1; ret Reply.value{@i * 10}; }\n\n#[noinline]\nfun peek(r: *Reply) i64 { if (sel (@r).value) { ret (@r).value; } ret 0; }\n\n#[noinline]\nfun take(r: Reply) i64 { if (sel r.value) { ret r.value; } ret -1; }\n\n#[noinline]\nfun pick(a: *[2]Reply, which: *i64) *Reply { @which = 1; ret ?(@a)[1]; }\n\n#[symbol(\"main\")]\nfun main(argc: i64) i64 {\n    # rhs-first: the index reads the value the rhs call wrote\n    var a: [2]Reply;\n    var i: i64 = 0;\n    a[i] = next(?i);\n    if (take(a[1]) != 10) { ret 1; }\n    if (take(a[0]) != -1) { ret 2; }\n    # a replacement initializer may read the old payload before the destination is overwritten\n    var r: Reply = Reply.value{5};\n    r = Reply.value{peek(?r) + 1};\n    if (take(r) != 6) { ret 3; }\n    # destination through a call that runs after the rhs\n    var which: i64 = 0;\n    var b: [2]Reply;\n    @pick(?b, ?which) = next(?which);\n    if (take(b[1]) != 10) { ret 4; }\n    # self-copy through an aliasing pointer: rhs snapshot precedes the overwrite\n    var s: Reply = Reply.value{9};\n    val ps: *Reply = ?s;\n    s = @ps;\n    if (take(s) != 9) { ret 5; }\n    ret 0;\n}\n";
}

# `#[packed]` tags: size, offsets, stride 17 unaligned payloads, nested record payload writes, copies, `u16` discriminator
fun ut_l3_packed_program() str {
    ret "rec Pair { a: u32; b: u64; }\n#[packed]\ntag P: u8 { empty; value: u64; pair: Pair; }\n#[packed]\ntag Q: u16 { empty; value: u32; }\ntag N: u8 { empty; value: u64; }\n\nvar g: [3]P;\n\n#[noinline]\nfun take(p: P) u64 { if (sel p.value) { ret p.value; } if (sel p.pair) { ret p.pair.a::u64 + p.pair.b; } ret 0xFFFF; }\n#[noinline]\nfun takeq(q: Q) u32 { if (sel q.value) { ret q.value; } ret 0xFFFF; }\n\n#[symbol(\"main\")]\nfun main(argc: i64) i64 {\n    if ($size_of(P) != 17 || $align_of(P) != 1) { ret 1; }\n    if ($offset_of(P, value) != 1 || $offset_of(P, pair) != 1) { ret 2; }\n    if ($size_of(Q) != 6 || $align_of(Q) != 1 || $offset_of(Q, value) != 2) { ret 3; }\n    if ($size_of(N) != 16 || $align_of(N) != 8 || $offset_of(N, value) != 8) { ret 4; }\n    var a: [3]P;\n    val base: u64 = (?a)::u64;\n    if ((?a[1])::u64 - base != 17) { ret 5; }\n    a[1] = P.value{0x0102030405060708};\n    if (take(a[1]) != 0x0102030405060708) { ret 6; }\n    val pa: *u8 = (?a)::*u8;\n    if (pa[17] != 1 || pa[18] != 0x08 || pa[25] != 0x01) { ret 7; }\n    if (sel a[1].value) { a[1].value = a[1].value + 1; }\n    if (take(a[1]) != 0x0102030405060709) { ret 8; }\n    a[2] = P.pair{Pair{a: 3, b: 4}};\n    if (take(a[2]) != 7) { ret 9; }\n    if (pa[34] != 2 || pa[35] != 3 || pa[43] != 4) { ret 10; }\n    if (sel a[2].pair) { a[2].pair.b = 40; }\n    if (take(a[2]) != 43) { ret 11; }\n    a[0] = a[2];\n    if (take(a[0]) != 43) { ret 12; }\n    g = a;\n    if (take(g[0]) != 43 || take(g[1]) != 0x0102030405060709) { ret 13; }\n    val pp: *P = ?g[1];\n    if (sel (@pp).value && (@pp).value != 0x0102030405060709) { ret 14; }\n    @pp = P.empty{};\n    if (take(g[1]) != 0xFFFF) { ret 15; }\n    var qs: [3]Q;\n    qs[1] = Q.value{0xDEADBEEF};\n    if (takeq(qs[1]) != 0xDEADBEEF) { ret 16; }\n    val pq: *u8 = (?qs)::*u8;\n    if (pq[6] != 1 || pq[7] != 0 || pq[8] != 0xEF || pq[11] != 0xDE) { ret 17; }\n    ret 0;\n}\n";
}

# `#[align(N)]` tags: object alignment and size, locals in a frame with saved registers, globals, array elements and record fields
fun ut_l3_aligned_program() str {
    ret "#[align(16)]\ntag A: u8 { empty; value: u64; }\n#[align(32)]\ntag B: u8 { empty; value: u8; }\nrec Holder { c: u8; a: A; }\n\nvar ga: A = A.value{1};\nvar garr: [3]A;\nvar gh: Holder;\n\n#[noinline]\nfun take(a: A) u64 { if (sel a.value) { ret a.value; } ret 0xFFFF; }\n#[noinline]\nfun takeb(b: B) u8 { if (sel b.value) { ret b.value; } ret 0xFF; }\n#[noinline]\nfun spill(x: u64, y: u64, z: u64) u64 {\n    var a: A = A.value{x};\n    var b: A = A.value{y};\n    var c: A = A.value{z};\n    if ((?a)::u64 % 16 != 0 || (?b)::u64 % 16 != 0 || (?c)::u64 % 16 != 0) { ret 0xFFFF; }\n    ret take(a) + take(b) + take(c);\n}\n\n#[symbol(\"main\")]\nfun main(argc: i64) i64 {\n    if ($size_of(A) != 16 || $align_of(A) != 16) { ret 1; }\n    if ($size_of(B) != 32 || $align_of(B) != 32) { ret 2; }\n    if ($size_of(Holder) != 32 || $offset_of(Holder, a) != 16) { ret 3; }\n    var a: A = A.value{5};\n    if ((?a)::u64 % 16 != 0) { ret 4; }\n    if ((?ga)::u64 % 16 != 0 || (?garr[1])::u64 % 16 != 0 || (?gh.a)::u64 % 16 != 0) { ret 5; }\n    var b: B = B.value{9};\n    if ((?b)::u64 % 32 != 0) { ret 6; }\n    if (takeb(b) != 9) { ret 7; }\n    if (spill(1, 2, 3) != 6) { ret 8; }\n    var arr: [3]A;\n    if ((?arr[2])::u64 - (?arr[0])::u64 != 32) { ret 9; }\n    arr[2] = a;\n    if (take(arr[2]) != 5) { ret 10; }\n    gh.a = arr[2];\n    if (take(gh.a) != 5) { ret 11; }\n    ret 0;\n}\n";
}

# by-value transfer of tags from 2 to 32 bytes, a float payload, a nested tag and nine tag arguments
fun ut_l3_abi_program() str {
    ret "tag T1: u8 { a; b; }\ntag T2: u8 { a; b: u8; }\ntag T9: u8 { a; b: [8]u8; }\ntag T16: u8 { a; b: i64; }\ntag T24: u8 { a; b: [2]i64; c: u8; }\ntag T32: u8 { a; b: [3]i64; }\ntag TF: u8 { a; b: f64; }\ntag Nest: u8 { a; b: T16; c: T2; }\n\n#[noinline] fun m1(x: u8) T1 { if (x == 0) { ret T1.a{}; } ret T1.b{}; }\n#[noinline] fun m2(x: u8) T2 { ret T2.b{x}; }\n#[noinline] fun m9(x: u8) T9 { var a: [8]u8; a[0] = x; a[7] = x + 1; ret T9.b{a}; }\n#[noinline] fun m16(x: i64) T16 { ret T16.b{x}; }\n#[noinline] fun m24(x: i64) T24 { var a: [2]i64; a[0] = x; a[1] = x + 1; ret T24.b{a}; }\n#[noinline] fun m32(x: i64) T32 { var a: [3]i64; a[0] = x; a[1] = x + 1; a[2] = x + 2; ret T32.b{a}; }\n#[noinline] fun mf(x: f64) TF { ret TF.b{x}; }\n#[noinline] fun mn(x: i64) Nest { ret Nest.b{m16(x)}; }\n\n#[noinline] fun t1(v: T1) u8 { if (sel v.b) { ret 1; } ret 0; }\n#[noinline] fun t2(v: T2) u8 { if (sel v.b) { ret v.b; } ret 0; }\n#[noinline] fun t9(v: T9) u8 { if (sel v.b) { ret v.b[0] + v.b[7]; } ret 0; }\n#[noinline] fun t16(v: T16) i64 { if (sel v.b) { ret v.b; } ret -1; }\n#[noinline] fun t24(v: T24) i64 { if (sel v.b) { ret v.b[0] + v.b[1]; } ret -1; }\n#[noinline] fun t32(v: T32) i64 { if (sel v.b) { ret v.b[0] + v.b[1] + v.b[2]; } ret -1; }\n#[noinline] fun tf(v: TF) f64 { if (sel v.b) { ret v.b; } ret -1.0; }\n#[noinline] fun tn(v: Nest) i64 { if (sel v.b) { ret t16(v.b); } ret -1; }\n#[noinline] fun many(a: T16, b: T16, c: T16, d: T16, e: T16, f: T16, g: T16, h: T16, i: T16) i64 { ret t16(a) + t16(b) + t16(c) + t16(d) + t16(e) + t16(f) + t16(g) + t16(h) + t16(i); }\n\n#[symbol(\"main\")]\nfun main(argc: i64) i64 {\n    if (t1(m1(0)) != 0 || t1(m1(1)) != 1) { ret 1; }\n    if (t2(m2(7)) != 7) { ret 2; }\n    if (t9(m9(3)) != 7) { ret 3; }\n    if (t16(m16(100)) != 100) { ret 4; }\n    if (t24(m24(5)) != 11) { ret 5; }\n    if (t32(m32(5)) != 18) { ret 6; }\n    if (tf(mf(2.5)) != 2.5) { ret 7; }\n    if (tn(mn(77)) != 77) { ret 8; }\n    if (many(m16(1), m16(2), m16(3), m16(4), m16(5), m16(6), m16(7), m16(8), m16(9)) != 45) { ret 9; }\n    val n: Nest = mn(3);\n    val c: Nest = n;\n    if (tn(c) != 3) { ret 10; }\n    var arr: [4]Nest;\n    arr[3] = c;\n    val arr2: [4]Nest = arr;\n    if (tn(arr2[3]) != 3 || tn(arr2[0]) != -1) { ret 11; }\n    ret 0;\n}\n";
}

# static `val` tags, arrays, records and a packed tag byte-compared with their runtime construction
fun ut_l3_static_program() str {
    ret "tag Reply: u8 { empty; value: i64; }\ntag Big: u8 { small: u8; big: [16]u8; mid: u32; }\nrec Box { n: u8; r: Reply; }\n#[packed]\ntag P: u8 { empty; value: u64; }\n\nval S_VAL: Reply = Reply.value{42};\nval S_EMPTY: Reply = Reply.empty{};\nval S_ARR: [3]Reply = [3]Reply{Reply.value{1}, Reply.empty{}, Reply.value{3}};\nval S_BOX: Box = Box{n: 9, r: Reply.value{7}};\nval S_MID: Big = Big.mid{0x01020304};\nval S_P: P = P.value{0x0102030405060708};\nval S_NEST: [2]Box = [2]Box{Box{n: 1}, Box{n: 2, r: Reply.value{5}}};\n\n#[noinline] fun take(r: Reply) i64 { if (sel r.value) { ret r.value; } ret -1; }\n#[noinline] fun rt_val() Reply { ret Reply.value{42}; }\n#[noinline] fun rt_mid() Big { ret Big.mid{0x01020304}; }\n#[noinline] fun rt_p() P { ret P.value{0x0102030405060708}; }\n#[noinline] fun same(a: *u8, b: *u8, n: u64) u8 { var i: u64 = 0; for (i < n) { if (a[i] != b[i]) { ret 0; } i = i + 1; } ret 1; }\n\n#[symbol(\"main\")]\nfun main(argc: i64) i64 {\n    if (take(S_VAL) != 42 || take(S_EMPTY) != -1) { ret 1; }\n    if (take(S_ARR[0]) != 1 || take(S_ARR[1]) != -1 || take(S_ARR[2]) != 3) { ret 2; }\n    if (S_BOX.n != 9 || take(S_BOX.r) != 7) { ret 3; }\n    var r: Reply = rt_val();\n    if (same((?S_VAL)::*u8, (?r)::*u8, 16) == 0) { ret 4; }\n    var m: Big = rt_mid();\n    if (same((?S_MID)::*u8, (?m)::*u8, 17) == 0) { ret 5; }\n    var p: P = rt_p();\n    if (same((?S_P)::*u8, (?p)::*u8, 9) == 0) { ret 6; }\n    if (take(S_NEST[0].r) != -1 || take(S_NEST[1].r) != 5) { ret 7; }\n    val pe: *u8 = (?S_EMPTY)::*u8;\n    var i: u64 = 0;\n    for (i < 16) { if (pe[i] != 0) { ret 8; } i = i + 1; }\n    ret 0;\n}\n";
}

# generic tags nested three deep, arrays and record fields of generic instances, runtime indices
fun ut_l3_generic_program() str {
    ret "tag rs[T, E]: u8 { err: E; ok: T; }\ntag op[T]: u8 { none; some: T; }\ntag Reply: u8 { empty; value: i64; }\nrec Pair { a: op[i64]; b: rs[Reply, u8]; }\n\nvar g: op[op[i64]];\nvar garr: [2]rs[Reply, u8];\n\n#[noinline] fun take(r: Reply) i64 { if (sel r.value) { ret r.value; } ret -1; }\n#[noinline] fun inner(o: op[op[i64]]) i64 { if (sel o.some) { if (sel o.some.some) { ret o.some.some; } ret -2; } ret -1; }\n#[noinline] fun okv(r: rs[Reply, u8]) i64 { if (sel r.ok) { ret take(r.ok); } if (sel r.err) { ret -100 - r.err::i64; } ret -1000; }\n#[noinline] fun mk(v: i64) rs[Reply, u8] { ret rs[Reply, u8].ok{Reply.value{v}}; }\n\n#[symbol(\"main\")]\nfun main(argc: i64) i64 {\n    if (inner(g) != -1) { ret 1; }\n    g = op[op[i64]].some{op[i64].none{}};\n    if (inner(g) != -2) { ret 2; }\n    g = op[op[i64]].some{op[i64].some{7}};\n    if (inner(g) != 7) { ret 3; }\n    if (sel g.some) { if (sel g.some.some) { g.some.some = 8; } }\n    if (inner(g) != 8) { ret 4; }\n    if (sel g.some) { g.some = op[i64].none{}; }\n    if (inner(g) != -2) { ret 5; }\n    var l: op[op[i64]] = g;\n    if (inner(l) != -2) { ret 6; }\n    if (okv(garr[0]) != -100) { ret 7; }\n    garr[1] = mk(9);\n    if (okv(garr[1]) != 9) { ret 8; }\n    var i: i64 = 1;\n    if (sel garr[i].ok) { if (sel garr[i].ok.value) { garr[i].ok.value = 10; } }\n    if (okv(garr[i]) != 10) { ret 9; }\n    if (sel garr[i].ok) { val q: *Reply = ?garr[i].ok; @q = Reply.empty{}; }\n    if (okv(garr[1]) != -1) { ret 10; }\n    garr[1] = rs[Reply, u8].err{3};\n    if (okv(garr[1]) != -103) { ret 11; }\n    var p: Pair;\n    if (okv(p.b) != -100) { ret 12; }\n    p = Pair{a: op[i64].some{4}, b: mk(5)};\n    if (okv(p.b) != 5) { ret 13; }\n    if (sel p.a.some && p.a.some != 4) { ret 14; }\n    val pc: Pair = p;\n    if (okv(pc.b) != 5) { ret 15; }\n    val q: Pair = Pair{a: op[i64].some{1}};\n    if (okv(q.b) != -100) { ret 16; }\n    ret 0;\n}\n";
}

# vector, 4096-byte, `u16`/`u64`-discriminated and union payloads, capture through a pointer into the destination, omitted runtime tag field
fun ut_l3_payloads_program() str {
    ret "tag V: u8 { none; v: f32x4; }\ntag Huge: u8 { none; buf: [4096]u8; small: u16; }\ntag D16: u16 { a; b: u8; }\ntag D64: u64 { a; b: u8; c: [3]u8; }\nuni U { a: u8; b: u64; }\ntag TU: u8 { none; u: U; }\ntag Reply: u8 { empty; value: i64; }\ntag Outer: u8 { none; inner: Reply; }\nrec Box { n: u8; r: Reply; }\n\n#[noinline] fun fill(n: u8) [4096]u8 { var a: [4096]u8; var i: u64 = 0; for (i < 4096) { a[i] = n; i = i + 1; } ret a; }\n#[noinline] fun sumv(t: V) f32 { if (sel t.v) { ret t.v[0] + t.v[1] + t.v[2] + t.v[3]; } ret -1.0; }\n#[noinline] fun last(h: Huge) u8 { if (sel h.buf) { ret h.buf[4095]; } ret 0xFF; }\n#[noinline] fun d16(t: D16) u8 { if (sel t.b) { ret t.b; } ret 0xFF; }\n#[noinline] fun d64(t: D64) u8 { if (sel t.b) { ret t.b; } if (sel t.c) { ret t.c[2]; } ret 0xFF; }\n#[noinline] fun ub(t: TU) u64 { if (sel t.u) { ret t.u.b; } ret 0; }\n#[noinline] fun take(r: Reply) i64 { if (sel r.value) { ret r.value; } ret -1; }\n\n#[symbol(\"main\")]\nfun main(argc: i64) i64 {\n    var v: V = V.v{f32x4{1.0, 2.0, 3.0, 4.0}};\n    if ($align_of(V) != 16 || $offset_of(V, v) != 16 || $size_of(V) != 32) { ret 1; }\n    if (sumv(v) != 10.0) { ret 2; }\n    if (sel v.v) { v.v = f32x4{2.0, 2.0, 2.0, 2.0}; }\n    if (sumv(v) != 8.0) { ret 3; }\n    val vc: V = v;\n    if (sumv(vc) != 8.0) { ret 4; }\n    var arr: [2]V;\n    arr[1] = vc;\n    if (sumv(arr[1]) != 8.0 || sumv(arr[0]) != -1.0) { ret 5; }\n\n    var h: Huge = Huge.buf{fill(0x5A)};\n    if (last(h) != 0x5A) { ret 6; }\n    val ph: *u8 = (?h)::*u8;\n    if (ph[0] != 1 || ph[2] != 0x5A || ph[4097] != 0x5A) { ret 7; }\n    h = Huge.small{0x0102};\n    if (ph[0] != 2 || ph[2] != 2 || ph[3] != 1) { ret 8; }\n    var i: u64 = 4;\n    for (i < 4098) { if (ph[i] != 0) { ret 9; } i = i + 1; }\n    var hc: Huge = h;\n    hc = Huge.buf{fill(0x33)};\n    if (last(hc) != 0x33) { ret 10; }\n    h = hc;\n    if (last(h) != 0x33 || ph[4097] != 0x33) { ret 11; }\n\n    if ($size_of(D16) != 4 || $offset_of(D16, b) != 2) { ret 12; }\n    if ($size_of(D64) != 16 || $offset_of(D64, b) != 8) { ret 13; }\n    var s: D16 = D16.b{9};\n    val ps: *u8 = (?s)::*u8;\n    if (ps[0] != 1 || ps[1] != 0 || ps[2] != 9 || ps[3] != 0) { ret 14; }\n    if (d16(s) != 9) { ret 15; }\n    var w: D64 = D64.c{[3]u8{1, 2, 3}};\n    val pw: *u8 = (?w)::*u8;\n    if (pw[0] != 2 || pw[7] != 0 || pw[8] != 1 || pw[10] != 3 || pw[11] != 0) { ret 16; }\n    if (d64(w) != 3) { ret 17; }\n    w = D64.b{5};\n    if (pw[0] != 1 || pw[8] != 5 || pw[9] != 0 || pw[10] != 0) { ret 18; }\n\n    var u: U;\n    u.b = 0x1122334455667788;\n    u.a = 0xFF;\n    var tu: TU = TU.u{u};\n    val pu: *u8 = (?tu)::*u8;\n    if (pu[8] != 0xFF || pu[9] != 0x77 || pu[15] != 0x11) { ret 19; }\n    if (ub(tu) != 0x11223344556677FF) { ret 20; }\n\n    # a replacement initializer reading the old payload through a pointer sees the old bytes\n    var o: Outer = Outer.inner{Reply.value{21}};\n    var q: *Reply = nil;\n    if (sel o.inner) { q = ?o.inner; }\n    o = Outer.inner{@q};\n    if (sel o.inner) { if (take(o.inner) != 21) { ret 21; } } or { ret 21; }\n    var r: Reply = Reply.value{22};\n    val pr: *Reply = ?r;\n    r = Reply.value{take(@pr) + 1};\n    if (take(r) != 23) { ret 22; }\n    # omitted tag field of a runtime record literal is zero\n    var bx: Box = Box{n: 1};\n    if (take(bx.r) != -1) { ret 23; }\n    val pbx: *u8 = (?bx)::*u8;\n    i = 8;\n    for (i < 24) { if (pbx[i] != 0) { ret 24; } i = i + 1; }\n    ret 0;\n}\n";
}

# a packed record holding a natural tag and a packed `u32` tag, and 65-byte packed tag copies through arrays and globals
fun ut_l3_packedrec_program() str {
    ret "tag Reply: u8 { empty; value: i64; }\n#[packed]\ntag Q4: u32 { empty; value: u32; }\n#[packed]\ntag PB: u8 { empty; buf: [64]u8; }\n#[packed]\nrec W { c: u8; r: Reply; q: Q4; }\nrec Wrap { c: u8; w: W; }\n\nvar garr: [3]PB;\n\n#[noinline] fun fill(n: u8) [64]u8 { var a: [64]u8; var i: u64 = 0; for (i < 64) { a[i] = n + i::u8; i = i + 1; } ret a; }\n#[noinline] fun take(r: Reply) i64 { if (sel r.value) { ret r.value; } ret -1; }\n#[noinline] fun q4(q: Q4) u32 { if (sel q.value) { ret q.value; } ret 0xFFFF; }\n#[noinline] fun pb(p: PB) u32 { if (sel p.buf) { ret p.buf[0]::u32 + p.buf[63]::u32; } ret 0xFFFF; }\n\n#[symbol(\"main\")]\nfun main(argc: i64) i64 {\n    if ($size_of(W) != 1 + 16 + 8 || $offset_of(W, r) != 1 || $offset_of(W, q) != 17) { ret 1; }\n    var w: W;\n    if (take(w.r) != -1 || q4(w.q) != 0xFFFF) { ret 2; }\n    w.r = Reply.value{0x0102030405060708};\n    if (take(w.r) != 0x0102030405060708) { ret 3; }\n    if (sel w.r.value) { w.r.value = w.r.value + 1; }\n    if (take(w.r) != 0x0102030405060709) { ret 4; }\n    w.q = Q4.value{0xDEADBEEF};\n    if (sel w.q.value && w.q.value != 0xDEADBEEF) { ret 5; }\n    if (sel w.q.value) { w.q.value = 0xCAFEBABE; }\n    if (q4(w.q) != 0xCAFEBABE) { ret 6; }\n    val pw: *u8 = (?w)::*u8;\n    if (pw[1] != 1 || pw[9] != 0x09 || pw[16] != 0x01 || pw[17] != 1 || pw[21] != 0xBE || pw[24] != 0xCA) { ret 7; }\n    var wrap: Wrap = Wrap{c: 1, w: w};\n    if (take(wrap.w.r) != 0x0102030405060709 || q4(wrap.w.q) != 0xCAFEBABE) { ret 8; }\n    val wc: W = wrap.w;\n    if (take(wc.r) != 0x0102030405060709) { ret 9; }\n    wrap.w.r = Reply.empty{};\n    if (take(wrap.w.r) != -1) { ret 10; }\n    var i: u64 = 0;\n    val pwr: *u8 = (?wrap.w)::*u8;\n    i = 1;\n    for (i < 17) { if (pwr[i] != 0) { ret 11; } i = i + 1; }\n\n    var a: [3]PB;\n    if ($size_of(PB) != 65 || (?a[1])::u64 - (?a[0])::u64 != 65) { ret 12; }\n    a[1] = PB.buf{fill(0x10)};\n    if (pb(a[1]) != 0x10 + 0x4F) { ret 13; }\n    a[2] = a[1];\n    a[0] = a[2];\n    if (pb(a[0]) != 0x10 + 0x4F) { ret 14; }\n    garr = a;\n    if (pb(garr[0]) != 0x10 + 0x4F || pb(garr[2]) != 0x10 + 0x4F) { ret 15; }\n    val pa: *u8 = (?a)::*u8;\n    if (pa[0] != 1 || pa[1] != 0x10 || pa[64] != 0x4F || pa[65] != 1 || pa[66] != 0x10 || pa[129] != 0x4F) { ret 16; }\n    a[2] = PB.empty{};\n    i = 130;\n    for (i < 195) { if (pa[i] != 0) { ret 17; } i = i + 1; }\n    if (sel a[0].buf) { a[0].buf[63] = 1; }\n    if (pb(a[0]) != 0x11) { ret 18; }\n    ret 0;\n}\n";
}

# builds a freestanding tag fixture for one target and profile and runs it; the fixture exits 0 when every check holds
fun ut_tag_native_case(alloc: *A.Allocator, target_name: str, runner_name: str, release: bool, program: str, label: str) i32 {
    ret ut_tag_native_case_files(alloc, ut_divide_manifest(), nil, nil, 0, target_name, runner_name, release, program, label);
}

# the same with the project's manifest and extra files at the project root (a C probe and the script that compiles it)
fun ut_tag_native_case_files(alloc: *A.Allocator, manifest_text: str, root_names: *str, root_texts: *str, root_count: u32,
    target_name: str, runner_name: str, release: bool, program: str, label: str) i32 {
    var runner: str = "";
    if (!str_empty(runner_name)) {
        val rr: res[str, exec.Error] = exec.resolve(alloc, runner_name);
        if (sel rr.err) {
            print.print("tag-native: runner absent, arm skipped: ");
            print.print(runner_name);
            print.print("\n");
            ret 0;
        }
        runner = rr.ok;
    }
    val sr: res[session.Session, fail.Fail] = session.init(alloc);
    if (sel sr.err) { ret 1; }
    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = program;
    if (root_count == 0) { texts[0] = ut_cc3(alloc, program, "\n", ut_tag_start_stub()); }
    val root_r: res[str, fail.Fail] = ut_scaffold_m(alloc, manifest_text, ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;
    var ri:   u32 = 0;
    for (ri < root_count) {
        val fp:            str             = ut_cc3(alloc, root, "/", root_names[ri]);
        val write_bytes_r: err[fs.FsError] = fs.write_bytes(fp, root_texts[ri], str_len(root_texts[ri]), 420);
        if (sel write_bytes_r.err) {
            fs.remove_all(alloc, root);
            session.dnit(?s);
            ret 1;
        }
        ri = ri + 1;
    }

    var bad: i32                                  = 0;
    val mr:  res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) {
        fs.remove_all(alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var m:  manifest.Manifest    = mr.ok;
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    rq.target       = target_name;
    if (release) {
        rq.profile = "release";
        rq.opt     = pipeline.OPT_RELEASE;
    }
    val pr: res[bplan.BuildPlan, outcome.Fail] = bplan.plan(alloc, ?s.interner, s.registry, ?m, rq);
    if (sel pr.err) {
        fs.remove_all(alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var bp: bplan.BuildPlan                         = pr.ok;
    val br: res[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, alloc, nil);
    if (sel br.err) {
        print.print("tag-native: build failed for ");
        print.print(label);
        print.print(" on ");
        print.print(target_name);
        print.print("\n");
        bad = 2;
    }
    if (sel br.ok) {
        val bo: outcome.BuildOutcome = br.ok;
        if (bo.severity != outcome.BUILD_OK || bo.artifacts.len != 1) { bad = 3; }
        or {
            var trapped: bool = false;
            var code:    i32  = 0;
            if (!ut_run_with_argc(root, runner, bo.artifacts.data[0].path, 1, ?trapped, ?code)) { bad = 4; }
            or (trapped || code != 0) {
                print.print("tag-native: ");
                print.print(label);
                print.print(" on ");
                print.print(target_name);
                var profile_name: str = "debug";
                if (release) { profile_name = "release"; }
                print.print(" ");
                print.print(profile_name);
                print.printf(" (trapped {}, exit {})\n", trapped::u8, code);
                bad = 5;
            }
        }
    }
    val remove_all_r: err[fs.FsError] = fs.remove_all(alloc, root);
    if (sel remove_all_r.err) { bad = 6; }
    session.dnit(?s);
    ret bad;
}

# runs one fixture on the three native linux targets in both profiles
fun ut_tag_native_all(alloc: *A.Allocator, program: str, label: str) i32 {
    var release: bool = false;
    var pass:    u32  = 0;
    for (pass < 2) {
        if (ut_tag_native_case(alloc, "linux-x86_64", "", release, program, label) != 0)              { ret 1; }
        if (ut_tag_native_case(alloc, "linux-arm64", "qemu-aarch64", release, program, label) != 0)   { ret 2; }
        if (ut_tag_native_case(alloc, "linux-riscv64", "qemu-riscv64", release, program, label) != 0) { ret 3; }
        release = true;
        pass    = pass + 1;
    }
    ret 0;
}

