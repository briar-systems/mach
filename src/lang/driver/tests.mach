        "linux", "branches on a secret value") != 0) { bad = 1; }
    if (ut_codegen_target_rejects("#[oblivious]\nfun f(k: ^u64) ^u64 { var r: ^u64 = k; asm x86_64 { mov rsi, {r}\n cmp rsi, 1\n swapgs\n jc 1f\n 1:\n nop } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "linux", "branches on a secret value") != 0) { bad = 1; }
    ret bad;
}

# AND IT IS CLEARED BY EVERY ROW THAT DOES DEFINE THEM
#
# The other direction, and the reason this model is not simply "any secret in the
# block poisons it": an instruction that unconditionally overwrites every flag
# this grammar can read leaves nothing of the earlier secret behind, so a branch
# after it is public and is accepted. Remove any of these rows' `defines_flags`
# and its case fails, which is what makes the fact load-bearing rather than
# merely asserted.
test "mach.lang.driver:oblivious_asm_taint_cleared_by_every_defining_row" {
    var bad: i32 = 0;
    if (ut_codegen_target_ok("#[oblivious]\nfun f(k: ^u64) ^u64 { var r: ^u64 = k; asm x86_64 { mov rsi, {r}\n cmp rsi, 1\n add rbx, rdx\n je 1f\n 1:\n nop } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n", "linux") != 0) { bad = 1; }
    if (ut_codegen_target_ok("#[oblivious]\nfun f(k: ^u64) ^u64 { var r: ^u64 = k; asm x86_64 { mov rsi, {r}\n cmp rsi, 1\n sub rbx, rdx\n je 1f\n 1:\n nop } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n", "linux") != 0) { bad = 1; }
    if (ut_codegen_target_ok("#[oblivious]\nfun f(k: ^u64) ^u64 { var r: ^u64 = k; asm x86_64 { mov rsi, {r}\n cmp rsi, 1\n and rbx, rdx\n je 1f\n 1:\n nop } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n", "linux") != 0) { bad = 1; }
    if (ut_codegen_target_ok("#[oblivious]\nfun f(k: ^u64) ^u64 { var r: ^u64 = k; asm x86_64 { mov rsi, {r}\n cmp rsi, 1\n or rbx, rdx\n je 1f\n 1:\n nop } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n", "linux") != 0) { bad = 1; }
    if (ut_codegen_target_ok("#[oblivious]\nfun f(k: ^u64) ^u64 { var r: ^u64 = k; asm x86_64 { mov rsi, {r}\n cmp rsi, 1\n xor rbx, rdx\n je 1f\n 1:\n nop } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n", "linux") != 0) { bad = 1; }
    if (ut_codegen_target_ok("#[oblivious]\nfun f(k: ^u64) ^u64 { var r: ^u64 = k; asm x86_64 { mov rsi, {r}\n cmp rsi, 1\n cmp rbx, rdx\n je 1f\n 1:\n nop } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n", "linux") != 0) { bad = 1; }
    if (ut_codegen_target_ok("#[oblivious]\nfun f(k: ^u64) ^u64 { var r: ^u64 = k; asm x86_64 { mov rsi, {r}\n cmp rsi, 1\n test rbx, rdx\n je 1f\n 1:\n nop } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n", "linux") != 0) { bad = 1; }
    if (ut_codegen_target_ok("#[oblivious]\nfun f(k: ^u64) ^u64 { var r: ^u64 = k; asm x86_64 { mov rsi, {r}\n cmp rsi, 1\n neg rbx\n je 1f\n 1:\n nop } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n", "linux") != 0) { bad = 1; }
    if (ut_codegen_target_ok("#[oblivious]\nfun f(k: ^u64) ^u64 { var r: ^u64 = k; asm x86_64 { mov rsi, {r}\n cmp rsi, 1\n cmpxchg rbx, rdx\n je 1f\n 1:\n nop } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n", "linux") != 0) { bad = 1; }
    if (ut_codegen_target_ok("#[oblivious]\nfun f(k: ^u64) ^u64 { var r: ^u64 = k; asm x86_64 { mov rsi, {r}\n cmp rsi, 1\n xadd rbx, rdx\n je 1f\n 1:\n nop } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n", "linux") != 0) { bad = 1; }
    ret bad;
}

# AN UNMODELED FLAG SOURCE TAINTS WITH NO SECRET IN SIGHT
#
# `popfq` and `iretq` load FLAGS from the stack or the interrupt frame, and
# `syscall` masks the existing RFLAGS - none of which this model represents. All
# three carry NO operands, so the ordinary "secret operand taints" rule is
# structurally unable to fire for them and they need their own unconditional
# arm. Nothing in these blocks reads a secret binding at all.
test "mach.lang.driver:oblivious_asm_unmodeled_flag_sources_taint" {
    var bad: i32 = 0;
    if (ut_codegen_target_rejects("#[oblivious]\nfun f(k: ^u64) ^u64 { var r: ^u64 = k; asm x86_64 { popfq\n jc 1f\n 1:\n nop } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "linux", "branches on a secret value") != 0) { bad = 1; }
    if (ut_codegen_target_rejects("#[oblivious]\nfun f(k: ^u64) ^u64 { var r: ^u64 = k; asm x86_64 { iretq\n jc 1f\n 1:\n nop } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "linux", "branches on a secret value") != 0) { bad = 1; }
    if (ut_codegen_target_rejects("#[oblivious]\nfun f(k: ^u64) ^u64 { var r: ^u64 = k; asm x86_64 { syscall\n jc 1f\n 1:\n nop } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "linux", "branches on a secret value") != 0) { bad = 1; }
    ret bad;
}

# BOTH SETcc SPELLINGS CARRY A SECRET OUT OF FLAGS AND INTO A REGISTER
#
# `setb` and `setae` are distinct grammar rows on distinct opcodes, so covering
# one leaves the other free to launder. The destination becomes secret-derived,
# and indexing memory with it leaks through the cache.
test "mach.lang.driver:oblivious_asm_setcc_does_not_launder_flags" {
    var bad: i32 = 0;
    if (ut_codegen_target_rejects("#[oblivious]\nfun f(k: ^u64) ^u64 { var r: ^u64 = k; asm x86_64 { mov rax, {r}\n cmp rax, 1\n setb bl\n mov rcx, [rbx] } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "linux", "addresses memory with a secret value") != 0) { bad = 1; }
    if (ut_codegen_target_rejects("#[oblivious]\nfun f(k: ^u64) ^u64 { var r: ^u64 = k; asm x86_64 { mov rax, {r}\n cmp rax, 1\n setae bl\n mov rcx, [rbx] } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "linux", "addresses memory with a secret value") != 0) { bad = 1; }
    ret bad;
}

# EVERY DEFINING ROW ALSO TAINTS ON ITS OWN SECRET OPERAND
#
# `defines_flags` implies `writes_flags`, and the second half needs its own
# coverage: a definer whose operands are secret must TAINT, not clear. The clear
# arm requires public operands, so these two behaviours are disjoint and a test of
# one says nothing about the other.
#
# One case per row rather than one for the family. The mutation sweep is why:
# with only `cmp` covered, deleting `writes_flags` from `add`, `sub`, `and`, `or`,
# `xor`, `test`, `neg`, `cmpxchg` or `xadd` left the suite green - nine facts that
# nothing depended on, which reads identically to nine facts that are wrong.
test "mach.lang.driver:oblivious_asm_defining_rows_taint_on_secret_operands" {
    var bad: i32 = 0;
    if (ut_codegen_target_rejects("#[oblivious]\nfun f(k: ^u64) ^u64 { var r: ^u64 = k; asm x86_64 { mov rax, {r}\n add rax, rbx\n je 1f\n1:\n nop } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "linux", "branches on a secret value") != 0) { bad = 1; }
    if (ut_codegen_target_rejects("#[oblivious]\nfun f(k: ^u64) ^u64 { var r: ^u64 = k; asm x86_64 { mov rax, {r}\n sub rax, rbx\n je 1f\n1:\n nop } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "linux", "branches on a secret value") != 0) { bad = 1; }
    if (ut_codegen_target_rejects("#[oblivious]\nfun f(k: ^u64) ^u64 { var r: ^u64 = k; asm x86_64 { mov rax, {r}\n and rax, rbx\n je 1f\n1:\n nop } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "linux", "branches on a secret value") != 0) { bad = 1; }
    if (ut_codegen_target_rejects("#[oblivious]\nfun f(k: ^u64) ^u64 { var r: ^u64 = k; asm x86_64 { mov rax, {r}\n or rax, rbx\n je 1f\n1:\n nop } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "linux", "branches on a secret value") != 0) { bad = 1; }
    if (ut_codegen_target_rejects("#[oblivious]\nfun f(k: ^u64) ^u64 { var r: ^u64 = k; asm x86_64 { mov rax, {r}\n xor rax, rbx\n je 1f\n1:\n nop } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "linux", "branches on a secret value") != 0) { bad = 1; }
    if (ut_codegen_target_rejects("#[oblivious]\nfun f(k: ^u64) ^u64 { var r: ^u64 = k; asm x86_64 { mov rax, {r}\n test rax, rbx\n je 1f\n1:\n nop } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "linux", "branches on a secret value") != 0) { bad = 1; }
    if (ut_codegen_target_rejects("#[oblivious]\nfun f(k: ^u64) ^u64 { var r: ^u64 = k; asm x86_64 { mov rax, {r}\n neg rax\n je 1f\n1:\n nop } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "linux", "branches on a secret value") != 0) { bad = 1; }
    if (ut_codegen_target_rejects("#[oblivious]\nfun f(k: ^u64) ^u64 { var r: ^u64 = k; asm x86_64 { mov rax, {r}\n cmpxchg rbx, rax\n je 1f\n1:\n nop } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "linux", "branches on a secret value") != 0) { bad = 1; }
    if (ut_codegen_target_rejects("#[oblivious]\nfun f(k: ^u64) ^u64 { var r: ^u64 = k; asm x86_64 { mov rax, {r}\n xadd rbx, rax\n je 1f\n1:\n nop } ret r; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n",
        "linux", "branches on a secret value") != 0) { bad = 1; }
    ret bad;
}

# the terminator of a function whose inline-asm body cannot return, and the shape it
# is NOT allowed to have (#2791)
#
# Walks every function reachable in the lowered project and reports what it found for
# the one named by `disp`: 1 when its last block ends in OP_UNREACHABLE, 2 when it
# ends in OP_RET, 0 when the function was not found. Reading the TERMINATOR rather
# than counting instructions is what makes this a statement about the CFG: an epilogue
# is not an instruction the middle end emits, so "no epilogue" is only observable here
# as "this block does not end in a return".
# ---
# p:    the lowered project
# disp: the function's source spelling
# ret:  1 unreachable-terminated, 2 return-terminated, 0 not found
fun ut_asm_fn_terminator(p: *project.Project, disp: str) i32 {
    var mi: u32 = 0;
    for (mi < p.module_len) {
        val me: *project.ModuleEntry = ?p.modules[mi];
        if (me.ir_module == nil) { mi = mi + 1; cnt; }
        val m: *ir.Module = me.ir_module;
        var fi: u32 = 0;
        for (fi < m.function_len) {
            val fn: *ir.Function = ?m.functions[fi];
            if (fn.block_count == 0) { fi = fi + 1; cnt; }
            val nm_o: O.Option[str] = intern.lookup(?p.s.interner, fn.disp);
            if (O.is_none[str](nm_o)) { fi = fi + 1; cnt; }
            if (!str_equals(O.unwrap[str](nm_o), disp)) { fi = fi + 1; cnt; }
            var found: i32 = 0;
            var bi: u32 = 0;
            for (bi < fn.block_count) {
                val blk: *ir.Block = ?fn.blocks[bi];
                if (blk.terminator == ir.INSTR_NIL) { bi = bi + 1; cnt; }
                val t: *instruction.Instruction = ?fn.instrs[blk.terminator::u32];
                if (t.kind == instruction.OP_UNREACHABLE) { found = 1; }
                or (t.kind == instruction.OP_RET && found == 0) { found = 2; }
                bi = bi + 1;
            }
            ret found;
        }
        mi = mi + 1;
    }
    ret 0;
}

# lowering: an inline-asm body that cannot return terminates its block with
# OP_UNREACHABLE, and a body that can return still terminates with OP_RET
#
# THE REAL TEST FOR #2791, and the reason it reads the CFG rather than the emitted
# bytes. The defect was found through a debugger aborting, but "gdb survives" pins one
# consumer's tolerance and would keep passing against a compiler that emitted a
# truthful CFG for the wrong reason - or stopped emitting one and happened not to
# upset that gdb. What was actually wrong is that the IR asserted control returns from
# `exit_group`, and this is that claim, stated directly.
#
# BOTH DIRECTIONS, because the conservatism here runs opposite to `writes_sp`: a wrong
# "does not return" deletes the caller's continuation, so `lives` must keep its OP_RET
# or the fix is worse than the defect it replaces.
test "mach.lang.driver:asm_that_cannot_return_terminates_its_block" {
    val src: str = "fun dies(v: i64) i64 { asm x86_64 { mov eax, 231\nsyscall\nhlt } ret v; }\nfun lives(v: i64) i64 { asm x86_64 { nop } ret v; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret dies(argc)::i32 + lives(argc)::i32; }\n";
    var bad: i32 = 0;
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    val pr: R.Result[project.Project, outcome.Fail] = ut_vec_lower(?s, ?alloc, src, "linux");
    if (R.is_err[project.Project, outcome.Fail](pr)) { session.dnit(?s); ret 1; }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);

    # the trap ends the thread of control, so the block does not run on to `ret v`.
    if (ut_asm_fn_terminator(?p, "dies") != 1)  { bad = 1; }
    # an ordinary body returns, and removing its `ret` would be the miscompile.
    if (ut_asm_fn_terminator(?p, "lives") != 2) { bad = 1; }

    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

# --- the SPIR-V emission unit: what a shader's module carries (#2823) ---------
#
# These read the EMITTED SPIR-V, in process, off the ObjectImage codegen returns.
# That is deliberate and it is what makes them unit tests rather than integration
# ones: the instruction sequence a shader compiles to is this repo's own fact,
# produced in memory, and nothing outside owns it. A golden diffed after a build
# would assert the same thing later, localize nothing, and need spirv-tools on the
# runner to say anything at all.
#
# WHAT THEY HAVE TO SEE THAT A VALIDATOR CANNOT. Every wrong outcome available to
# cross-module emission is a module `spirv-val` accepts: a helper emitted once per
# entry point that reaches it, an imported module's unreachable functions dragged
# in with the reachable ones, a call resolved to the wrong same-shaped helper, a
# drawn-in body published under a linkage export its owning module already
# publishes. So the assertions are about the functions and the calls between them.
#
# IDENTIFYING A FUNCTION BY ITS ARITY is what keeps these readable. A shader
# module's internal functions carry no name in the emitted module - no entry point,
# no export, nothing but an id that renumbers whenever anything else changes - so
# the fixtures give every function in the tree a DISTINCT parameter count, and an
# arity is then a name. "no five-parameter function in this module" is exactly "the
# unreachable helper did not come along", stated in the only vocabulary the module
# itself has.

# the manifest for a spirv fixture: the tuple, one profile, one bin artifact, and
# optionally one path dependency
# ---
# alloc:     allocator for the composed string
# dep_alias: the dependency's name, or "" for a fixture with none
# ret:       the mach.toml text
fun ut_spv_manifest(alloc: *A.Allocator, dep_alias: str) str {
    val head: str = "[project]\nid = \"spvcase\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.spirv]\nisa = \"spirv\"\nos = \"freestanding\"\nabi = \"spirv\"\n\n[profile.debug]\nopt = 0\ndebug = false\nsimd = \"scalarize\"\n\n[artifact.spvcase]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/spvcase\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
    if (str_len(dep_alias) == 0::usize) { ret head; }
    val a: str = ut_cc3(alloc, head, "\n[dep.", dep_alias);
    val b: str = ut_cc3(alloc, a, "]\npath = \"", dep_alias);
    ret ut_cc3(alloc, b, "\"\n", "");
}

# the manifest for a spirv path DEPENDENCY: the same tuple, no artifact
fun ut_spv_dep_manifest(alloc: *A.Allocator, id: str) str {
    ret ut_cc3(alloc, "[project]\nid = \"", id, "\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.spirv]\nisa = \"spirv\"\nos = \"freestanding\"\nabi = \"spirv\"\n\n[profile.debug]\nopt = 0\ndebug = false\nsimd = \"scalarize\"\n");
}

# write a project node carrying SEVERAL source files
#
# `ut_write_node` writes one, and a dependency that is itself several modules -
# which is what a transitive draw-in needs - cannot be built from it.
# ---
# alloc:         allocator for the composed paths
# dir:           the node's root, created along with its `src`
# manifest_text: its mach.toml
# names/texts:   `n` source file names and bodies
# ret:           none on success, or the first error
fun ut_write_node_multi(alloc: *A.Allocator, dir: str, manifest_text: str,
                        names: *str, texts: *str, n: u32) O.Option[str] {
    val d1: O.Option[str] = fs.create_dir_all(alloc, dir, 493);
    if (O.is_some[str](d1)) { ret d1; }
    val src_dir: str = ut_cc3(alloc, dir, "/", "src");
    val d2: O.Option[str] = fs.create_dir_all(alloc, src_dir, 493);
    if (O.is_some[str](d2)) { ret d2; }
    val mf: str = ut_cc3(alloc, dir, "/", manifest.MANIFEST_FILE);
    val w0: O.Option[str] = fs.write_bytes(mf, manifest_text, str_len(manifest_text), 420);
    if (O.is_some[str](w0)) { ret w0; }
    var i: u32 = 0;
    for (i < n) {
        val sf: str = ut_cc3(alloc, src_dir, "/", names[i]);
        val w: O.Option[str] = fs.write_bytes(sf, texts[i], str_len(texts[i]), 420);
        if (O.is_some[str](w)) { ret w; }
        i = i + 1;
    }
    ret O.none[str]();
}

# scaffold a spirv project (optionally with one path dep), load it for the `spirv`
# target, and run sema + lower so every module's IR is resident
#
# Stops after lowering rather than going on to codegen: these tests generate ONE
# named module at a time and look at what came out, because the emission unit is
# assembled per module and that is the seam under test.
# ---
# s, alloc:    the caller's session and allocator
# names/texts: the root project's `src` files
# dep_*:       the dependency node, or dep_n = 0 for a fixture with none
# ret:         the loaded, lowered project
fun ut_spv_lower(s: *session.Session, alloc: *A.Allocator,
                 names: *str, texts: *str, n: u32,
                 dep_id: str, dep_names: *str, dep_texts: *str, dep_n: u32) R.Result[project.Project, outcome.Fail] {
    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(alloc, "mach_spv_test");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret R.err[project.Project, outcome.Fail](outcome.user(R.unwrap_err[fs.TempFile, str](tf_r))); }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);
    val dup_r: R.Result[str, str] = str_dup(alloc, fs.temp_path(?tf));
    fs.temp_close_and_remove(?tf);
    if (R.is_err[str, str](dup_r)) { ret R.err[project.Project, outcome.Fail](outcome.user(R.unwrap_err[str, str](dup_r))); }
    val root: str = R.unwrap_ok[str, str](dup_r);

    var alias: str = "";
    if (dep_n > 0) { alias = dep_id; }
    val wr: O.Option[str] = ut_write_node_multi(alloc, root, ut_spv_manifest(alloc, alias), names, texts, n);
    if (O.is_some[str](wr)) { fs.remove_all(alloc, root); ret R.err[project.Project, outcome.Fail](outcome.user(O.unwrap[str](wr))); }

    # the dep node goes at `dep/<alias>`, the MATERIALIZED location the loader reads.
    # the manifest's `path` names where `mach dep pull` would fetch it from, which
    # nothing here runs, so writing the node where a pull would have put it is what
    # makes the dependency resolvable.
    if (dep_n > 0) {
        val dep_dir: str = ut_cc3(alloc, root, "/dep/", dep_id);
        val dw: O.Option[str] = ut_write_node_multi(alloc, dep_dir, ut_spv_dep_manifest(alloc, dep_id), dep_names, dep_texts, dep_n);
        if (O.is_some[str](dw)) { fs.remove_all(alloc, root); ret R.err[project.Project, outcome.Fail](outcome.user(O.unwrap[str](dw))); }
    }

    val rr: R.Result[bool, str] = driver.setup_registry(?s.registry);
    if (R.is_err[bool, str](rr)) { fs.remove_all(alloc, root); ret R.err[project.Project, outcome.Fail](outcome.user(R.unwrap_err[bool, str](rr))); }
    val pr: R.Result[project.Project, outcome.Fail] = driver.build_project(s, root, "spirv");
    fs.remove_all(alloc, root);
    if (R.is_err[project.Project, outcome.Fail](pr)) { ret pr; }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);

    val sr2: R.Result[bool, outcome.Fail] = passes.run_sema_pass(?p);
    if (R.is_err[bool, outcome.Fail](sr2)) { project.dnit_project(?p); ret R.err[project.Project, outcome.Fail](R.unwrap_err[bool, outcome.Fail](sr2)); }
    val lr: R.Result[bool, outcome.Fail] = passes.run_lower_pass(?p);
    if (R.is_err[bool, outcome.Fail](lr)) { project.dnit_project(?p); ret R.err[project.Project, outcome.Fail](R.unwrap_err[bool, outcome.Fail](lr)); }
    ret R.ok[project.Project, outcome.Fail](p);
}

# codegen one named module of a lowered spirv project, assembling its emission unit
# exactly as the build would
#
# This is the seam under test as the driver actually drives it: `code_sources`
# decides which modules the emitter may draw bodies from, and `codegen_module`
# lowers them and runs the emitter over the unit.
# ---
# p, s:    the lowered project and its session
# fqn:     the module to generate
# out_img: receives the image on success; untouched on failure
# out_err: receives the diagnostic on failure; untouched on success
# ret:     true when codegen succeeded
fun ut_spv_codegen(p: *project.Project, s: *session.Session, fqn: str,
                   out_img: *of.ObjectImage, out_err: *str) bool {
    val mid: session.ModuleId = ut_mid(p, s, fqn);
    if (mid == session.MODULE_NIL) { @out_err = "module not loaded"; ret false; }
    val m: *project.ModuleEntry = ?p.modules[mid::u32];
    if (m.ir_module == nil)      { @out_err = "module has no lowered IR"; ret false; }

    val sr: R.Result[passes.CodeSources, str] = passes.code_sources(p, mid, s.alloc);
    if (R.is_err[passes.CodeSources, str](sr)) { @out_err = R.unwrap_err[passes.CodeSources, str](sr); ret false; }
    var srcs: passes.CodeSources = R.unwrap_ok[passes.CodeSources, str](sr);

    val cg: R.Result[of.ObjectImage, str] =
        codegen.codegen_module(s, ?p.target, m.ir_module, srcs.set, nil, codegen.no_debug());
    passes.sources_dnit(s.alloc, ?srcs);
    if (R.is_err[of.ObjectImage, str](cg)) { @out_err = R.unwrap_err[of.ObjectImage, str](cg); ret false; }
    @out_img = R.unwrap_ok[of.ObjectImage, str](cg);
    ret true;
}

# the SPIR-V instruction words of a codegen'd image
#
# The emitter's output is the single `.spirv` section, little-endian words. The
# five-word header is skipped, so `out_n` counts instruction words only.
# ---
# img:   the image
# out_n: receives the word count
# ret:   the first instruction word, or nil
fun ut_spv_words(img: *of.ObjectImage, out_n: *u32) *u32 {
    @out_n = 0;
    var i: u32 = 0;
    for (i < img.section_count) {
        val sec: *of.Section = ?img.sections[i];
        if (sec.len >= 20 && sec.bytes != nil) {
            val w: *u32 = sec.bytes::ptr::*u32;
            @out_n = sec.len / 4 - 5;
            ret ?w[5];
        }
        i = i + 1;
    }
    ret nil;
}

# how many instructions of one opcode the stream carries
# ---
# w, n:   the instruction words
# opcode: the SPIR-V opcode
# ret:    the count
fun ut_spv_count(w: *u32, n: u32, opcode: u32) u32 {
    var i: u32 = 0;
    var c: u32 = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0) { ret c; }
        if ((w[i] & 0xFFFF) == opcode) { c = c + 1; }
        i = i + len;
    }
    ret c;
}

# the parameter count of the OpTypeFunction the `fn_ix`-th OpFunction names
#
# `OpFunction <result-type> <id> <control> <fn-type>` and
# `<id> = OpTypeFunction <return-type> <param-types...>`, so the arity is the type's
# word count less the fixed three. The fixtures give every function in the tree a
# distinct arity, which is what lets an assertion name one.
# ---
# w, n:  the instruction words
# fn_ix: which OpFunction, in emission order
# ret:   the arity, or UT_SPV_NO_FN when there is no such function
fun ut_spv_fn_arity(w: *u32, n: u32, fn_ix: u32) u32 {
    var i: u32 = 0;
    var seen: u32 = 0;
    var ty: u32 = 0;
    var got: bool = false;
    for (i < n && !got) {
        val len: u32 = w[i] >> 16;
        if (len == 0) { ret UT_SPV_NO_FN; }
        if ((w[i] & 0xFFFF) == spirv.OP_FUNCTION) {
            if (seen == fn_ix) { ty = w[i + 4]; got = true; }
            seen = seen + 1;
        }
        i = i + len;
    }
    if (!got) { ret UT_SPV_NO_FN; }
    i = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0) { ret UT_SPV_NO_FN; }
        if ((w[i] & 0xFFFF) == spirv.OP_TYPE_FUNCTION && w[i + 1] == ty) { ret len - 3; }
        i = i + len;
    }
    ret UT_SPV_NO_FN;
}

# no OpFunction at that position, or no OpTypeFunction behind the one there is
val UT_SPV_NO_FN: u32 = 0xFFFFFFFF;

# how many functions of the given arity the module defines
#
# A COUNT rather than a presence test, because the duplication this guards against
# leaves the function present either way: a helper emitted once per entry point
# that reaches it is there, twice.
fun ut_spv_arity_count(w: *u32, n: u32, arity: u32) u32 {
    val fns: u32 = ut_spv_count(w, n, spirv.OP_FUNCTION);
    var i: u32 = 0;
    var c: u32 = 0;
    for (i < fns) {
        if (ut_spv_fn_arity(w, n, i) == arity) { c = c + 1; }
        i = i + 1;
    }
    ret c;
}

# whether every OpFunctionCall's callee names a function this module defines
#
# The closure assertion, and the one that catches a draw-in stopping a hop short: a
# call whose callee id has no OpFunction is a module calling into nothing, which is
# exactly what a self-contained module must never be.
# ---
# w, n: the instruction words
# ret:  true when every call resolves
fun ut_spv_calls_all_resolve(w: *u32, n: u32) bool {
    var i: u32 = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0) { ret true; }
        if ((w[i] & 0xFFFF) == spirv.OP_FUNCTION_CALL) {
            if (!ut_spv_defines_fn(w, n, w[i + 3])) { ret false; }
        }
        i = i + len;
    }
    ret true;
}

# whether some OpFunction in the module carries the given result id
fun ut_spv_defines_fn(w: *u32, n: u32, id: u32) bool {
    var i: u32 = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0) { ret false; }
        if ((w[i] & 0xFFFF) == spirv.OP_FUNCTION && w[i + 2] == id) { ret true; }
        i = i + len;
    }
    ret false;
}

# the callee id of the first OpFunctionCall inside the `fn_ix`-th OpFunction, or 0
#
# "both entry points reach the SAME helper" is a statement about two ids being
# equal, so an id is what this returns - the only place these tests handle one, and
# they only ever compare it with another from the same module.
fun ut_spv_first_callee_in(w: *u32, n: u32, fn_ix: u32) u32 {
    var i: u32 = 0;
    var seen: u32 = 0;
    var started: bool = false;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0) { ret 0; }
        val op: u32 = w[i] & 0xFFFF;
        if (op == spirv.OP_FUNCTION) {
            if (started) { seen = seen + 1; }
            started = true;
        }
        if (op == spirv.OP_FUNCTION_CALL && started && seen == fn_ix) { ret w[i + 3]; }
        i = i + len;
    }
    ret 0;
}

# the id the `k`-th OpEntryPoint names, or 0
#
# `OpEntryPoint <model> <fn> "<name>" <interface...>`, so the function id is the
# second operand and needs no string decoding.
fun ut_spv_entry_fn(w: *u32, n: u32, k: u32) u32 {
    var i: u32 = 0;
    var seen: u32 = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0) { ret 0; }
        if ((w[i] & 0xFFFF) == spirv.OP_ENTRY_POINT) {
            if (seen == k) { ret w[i + 2]; }
            seen = seen + 1;
        }
        i = i + len;
    }
    ret 0;
}

# the position, in emission order, of the OpFunction carrying `id`, or UT_SPV_NO_FN
fun ut_spv_fn_index_of(w: *u32, n: u32, id: u32) u32 {
    var i: u32 = 0;
    var seen: u32 = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0) { ret UT_SPV_NO_FN; }
        if ((w[i] & 0xFFFF) == spirv.OP_FUNCTION) {
            if (w[i + 2] == id) { ret seen; }
            seen = seen + 1;
        }
        i = i + len;
    }
    ret UT_SPV_NO_FN;
}

# how many functions carry a LinkageAttributes Export decoration
#
# A drawn-in body must never be one of them: its owning module publishes that
# symbol from its own module, and a second definition of one name is a collision
# this module would have invented over a function it does not own.
fun ut_spv_export_count(w: *u32, n: u32) u32 {
    var i: u32 = 0;
    var c: u32 = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0) { ret c; }
        if ((w[i] & 0xFFFF) == spirv.OP_DECORATE && len >= 3
            && w[i + 2] == spirv.DECOR_LINKAGE_ATTRIBUTES) { c = c + 1; }
        i = i + len;
    }
    ret c;
}

# whether lowering `src` as a single-module spirv shader reports `needle`
# ---
# alloc:  allocator for a fresh session
# src:    the module text
# needle: substring of the diagnostic being looked for
# ret:    true when a matching diagnostic fired
fun ut_spv_diag_fired(alloc: *A.Allocator, src: str, needle: str) bool {
    val sr: R.Result[session.Session, str] = session.init(alloc);
    if (R.is_err[session.Session, str](sr)) { ret false; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    var names: [1]str;
    var texts: [1]str;
    names[0] = "main.mach"; texts[0] = src;
    val pr: R.Result[project.Project, outcome.Fail] =
        ut_spv_lower(?s, alloc, ?names[0], ?texts[0], 1, "", nil, nil, 0);
    if (R.is_ok[project.Project, outcome.Fail](pr)) {
        var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);
        project.dnit_project(?p);
    }
    val fired: bool = ut_diag_has(?s.diags, needle);
    session.dnit(?s);
    ret fired;
}

# a target-operation declaration is checked against the instruction's own arity
# (#2888)
#
# The decorator's contract is that operands come from the parameters in order, so a
# declaration whose parameter list is the wrong length assembles the instruction with
# the wrong operand count, and nothing checked that before the target published its
# own definition table. The family looks uniform and is not: `Reflect` takes two
# operands where `Refract` takes three.
#
# THE ASSERTION IS THE DIAGNOSTIC, not the pass result. `context.report` records an
# error and sema still returns ok, so asserting on the result would pass whether or
# not the check exists - which is exactly what a first draft of this test did.
#
# BOTH ARMS ARE THE TEST, and the second is what makes the first mean anything. A
# refusal arm alone passes just as well if the declaration were refused for some
# unrelated reason, so the control is the SAME instruction with the SAME parameter
# types at the arity the table states, which must not fire.
test "mach.lang.driver:a_target_op_arity_must_match_the_instruction" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }

    val bad: str = "#[op(\"spirv\", \"GLSL.std.450\", \"Refract\")]\nfun refract(i: f32x3, n: f32x3) f32x3;\n\nfun main() i32 { ret 0; }\n";
    val ok:  str = "#[op(\"spirv\", \"GLSL.std.450\", \"Refract\")]\nfun refract(i: f32x3, n: f32x3, eta: f32) f32x3;\n\nfun main() i32 { ret 0; }\n";

    val n: str = "does not match the instruction's operand count";
    if (!ut_spv_diag_fired(?alloc, bad, n)) { ret 1; }
    if (ut_spv_diag_fired(?alloc, ok, n))   { ret 1; }
    ret 0;
}

# an instruction set name is refused unless the target publishes that set (#2888)
#
# The typo must not fall back to the extended set, which is what would make it
# invisible. The control is the same declaration under the correctly spelled set,
# so a refusal that fired for any other reason shows up as the control failing.
test "mach.lang.driver:a_target_op_set_must_be_one_the_target_publishes" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }

    val bad: str = "#[op(\"spirv\", \"GLSL.std.451\", \"Sqrt\")]\nfun sq(x: f32) f32;\n\nfun main() i32 { ret 0; }\n";
    val ok:  str = "#[op(\"spirv\", \"GLSL.std.450\", \"Sqrt\")]\nfun sq(x: f32) f32;\n\nfun main() i32 { ret 0; }\n";

    val n: str = "defines no instruction set of this name";
    if (!ut_spv_diag_fired(?alloc, bad, n)) { ret 1; }
    if (ut_spv_diag_fired(?alloc, ok, n))   { ret 1; }
    ret 0;
}

# an instruction name is answered for only by its own set (#2888)
#
# Three mistakes, each a different way to miss. `Sqrtf` is what a C programmer
# reaches for and GLSL.std.450 has no such entry. The other two are the cross-set
# borrow in both directions: `Normalize` is extended-only and `OpDot` is core-only,
# and the sets must not answer for each other. GLSL spells `dot` beside
# `normalize`, which is what invites the second.
#
# EACH REFUSAL IS PAIRED WITH THE SAME INSTRUCTION IN ITS RIGHT SET. Without that,
# a compiler that refused every name equally would pass all three refusal arms.
test "mach.lang.driver:a_target_op_name_belongs_only_to_its_own_set" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }

    val misspelled: str = "#[op(\"spirv\", \"GLSL.std.450\", \"Sqrtf\")]\nfun f(x: f32) f32;\n\nfun main() i32 { ret 0; }\n";
    val ext_in_core: str = "#[op(\"spirv\", \"core\", \"Normalize\")]\nfun f(v: f32x4) f32x4;\n\nfun main() i32 { ret 0; }\n";
    val core_in_ext: str = "#[op(\"spirv\", \"GLSL.std.450\", \"OpDot\")]\nfun f(a: f32x4, b: f32x4) f32;\n\nfun main() i32 { ret 0; }\n";
    val ext_ok:  str = "#[op(\"spirv\", \"GLSL.std.450\", \"Normalize\")]\nfun f(v: f32x4) f32x4;\n\nfun main() i32 { ret 0; }\n";
    val core_ok: str = "#[op(\"spirv\", \"core\", \"OpDot\")]\nfun f(a: f32x4, b: f32x4) f32;\n\nfun main() i32 { ret 0; }\n";

    val n: str = "defines no instruction of this name";
    if (!ut_spv_diag_fired(?alloc, misspelled, n))  { ret 1; }
    if (!ut_spv_diag_fired(?alloc, ext_in_core, n)) { ret 1; }
    if (!ut_spv_diag_fired(?alloc, core_in_ext, n)) { ret 1; }
    if (ut_spv_diag_fired(?alloc, ext_ok, n))       { ret 1; }
    if (ut_spv_diag_fired(?alloc, core_ok, n))      { ret 1; }
    ret 0;
}

# the handle declarations every `#[handle]` test is written against
#
# One prelude rather than a per-test one so a test's own text is only what it is
# testing, and so the CONTROL arm of each pair is the same declarations with the one
# offending line changed. `IMG` is the operand list the target's `image` row states:
# texel scalar, dimensionality, depth, arrayedness, multisampledness, sampled-ness.
val UT_H_PRELUDE: str = "#[handle(\"spirv\", \"image\", 0, 1, 0, 0, 0, 1)]\npub def Texture2D;\n#[handle(\"spirv\", \"sampled_image\", Texture2D)]\npub def Sampler2D;\n#[handle(\"spirv\", \"sampler\")]\npub def Sampler;\n#[op(\"spirv\", \"core\", \"OpImageSampleImplicitLod\")]\nfun sample2(s: Sampler2D, uv: f32x2) f32x4;\n#[sampler(0, 0)] var albedo: Sampler2D;\n#[input(0)] var in_uv: f32x2;\n#[output(0)] var out_colour: f32x4;\n";

# whether lowering the prelude plus `tail` reports `needle`
# ---
# alloc:  allocator for a fresh session
# tail:   the module text appended to the handle prelude
# needle: substring of the diagnostic being looked for
# ret:    true when a matching diagnostic fired
fun ut_h_diag(alloc: *A.Allocator, tail: str, needle: str) bool {
    val rj: R.Result[str, str] = format.sprint(alloc, "{}{}", UT_H_PRELUDE, tail);
    if (R.is_err[str, str](rj)) { ret false; }
    val src: str = R.unwrap_ok[str, str](rj);
    val fired: bool = ut_spv_diag_fired(alloc, src, needle);
    A.deallocate[char](alloc, src::*char, str_len(src) + 1);
    ret fired;
}

# a handle type is not a value, so it cannot be constructed or read a field of
# (#2888)
#
# THE FIRST OF THE FIVE RULES, and it follows from the one fact the directive
# states: the program does not own the representation, so there is no literal of it
# to write and no field of it to reach. The message is its own rather than the type
# alias one beside it, because there is no aliased type to reach for instead.
#
# THE CONTROL IS AN ORDINARY `def`, which is refused as a value too but for a
# different reason and with a different sentence. Without it a compiler that refused
# every `def` in value position would pass the refusal arm.
test "mach.lang.driver:a_handle_type_is_not_a_value" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }

    val bad: str = "fun f() i32 { val x: i32 = Sampler2D; ret 0; }\n\nfun main() i32 { ret 0; }\n";
    val ok:  str = "def Alias: i32;\nfun f() i32 { val x: i32 = Alias; ret 0; }\n\nfun main() i32 { ret 0; }\n";

    val n: str = "is a handle type, not a value";
    if (!ut_h_diag(?alloc, bad, n)) { ret 1; }
    if (ut_h_diag(?alloc, ok, n))   { ret 1; }
    ret 0;
}

# a handle cannot be a local binding (#2888)
#
# THE SECOND RULE. A local is storage the program owns and a handle's representation
# is not the program's, so there is nothing that may be written into it. The handle
# goes straight to the operation that consumes it.
#
# THE CONTROL IS THE SAME EXPRESSION HANDED STRAIGHT TO THE OPERATION, which is the
# whole difference the rule is about: naming it is refused, passing it is not.
test "mach.lang.driver:a_handle_cannot_be_a_local_binding" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }

    val bad: str = "#[stage(\"fragment\")]\nfun frag_main() { val s: Sampler2D = albedo; out_colour = sample2(s, in_uv); }\n\nfun main() i32 { ret 0; }\n";
    val ok:  str = "#[stage(\"fragment\")]\nfun frag_main() { out_colour = sample2(albedo, in_uv); }\n\nfun main() i32 { ret 0; }\n";

    val n: str = "cannot be a local binding";
    if (!ut_h_diag(?alloc, bad, n)) { ret 1; }
    if (ut_h_diag(?alloc, ok, n))   { ret 1; }
    ret 0;
}

# a handle cannot be a record or union field (#2888)
#
# THE THIRD RULE. A record is storage at offsets the program computes, and a handle
# has no such offsets, so an aggregate holding one has no layout at all. Reported on
# the field rather than on whatever later gives the record an address, because the
# field is a declaration in its own right.
#
# THE CONTROL IS THE SAME RECORD AT AN ORDINARY FIELD TYPE, so a compiler that
# refused every field of a `def` type would fail it.
test "mach.lang.driver:a_handle_cannot_be_a_record_field" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }

    val bad_rec: str = "rec Material { tex: Sampler2D; }\n\nfun main() i32 { ret 0; }\n";
    val bad_uni: str = "uni Either { tex: Sampler2D; n: i32; }\n\nfun main() i32 { ret 0; }\n";
    val ok:      str = "def Alias: i32;\nrec Material { tex: Alias; }\n\nfun main() i32 { ret 0; }\n";

    val n: str = "cannot be a record or union field";
    if (!ut_h_diag(?alloc, bad_rec, n)) { ret 1; }
    if (!ut_h_diag(?alloc, bad_uni, n)) { ret 1; }
    if (ut_h_diag(?alloc, ok, n))       { ret 1; }
    ret 0;
}

# a handle reaches an operation only through a descriptor binding (#2888)
#
# THE FOURTH RULE. The only thing a program does with a handle is hand it to an
# operation, and the only way one arrives is bound as a descriptor. A handle global
# with no binding is reachable from no stage, so it would compile and be unreachable
# rather than fail.
#
# THE CONTROL IS THE SAME DECLARATION WITH THE BINDING, which is the one difference
# the rule turns on.
test "mach.lang.driver:a_handle_global_needs_a_descriptor_binding" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }

    val bad: str = "var unbound: Sampler2D;\n\nfun main() i32 { ret 0; }\n";
    val ok:  str = "#[sampler(0, 1)] var bound: Sampler2D;\n\nfun main() i32 { ret 0; }\n";

    val n: str = "needs a `#[sampler(set, binding)]` decorator";
    if (!ut_h_diag(?alloc, bad, n)) { ret 1; }
    if (ut_h_diag(?alloc, ok, n))   { ret 1; }
    ret 0;
}

# a handle's extent is the owning target's, so the program cannot step over one
# (#2888)
#
# THE FIFTH RULE. A pointer and an array are both extents the program computes, and
# a handle's extent is declared by the target rather than by the program, so there
# is no element size to step by. Both shapes are the same rule and both are refused.
#
# THE CONTROL IS THE HANDLE ITSELF, declared exactly as the two refused shapes are
# but without the pointer or the array around it.
test "mach.lang.driver:a_handle_has_no_extent_the_program_owns" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }

    val bad_ptr: str = "#[sampler(0, 1)] var p: *Sampler2D;\n\nfun main() i32 { ret 0; }\n";
    val bad_arr: str = "#[sampler(0, 1)] var a: [4]Sampler2D;\n\nfun main() i32 { ret 0; }\n";
    val ok:      str = "#[sampler(0, 1)] var h: Sampler2D;\n\nfun main() i32 { ret 0; }\n";

    val n: str = "cannot sit behind a pointer or inside an array";
    if (!ut_h_diag(?alloc, bad_ptr, n)) { ret 1; }
    if (!ut_h_diag(?alloc, bad_arr, n)) { ret 1; }
    if (ut_h_diag(?alloc, ok, n))       { ret 1; }
    ret 0;
}

# the four by-name refusals survive, re-keyed to the operand that causes each
# (#2888)
#
# THE LOSS THE RFC NAMES, RECOVERED. A grammar used to parse `sampler2dshadow` and
# refuse it with a sentence naming depth comparison. There is no grammar now, so
# each reason is triggered by the OPERAND instead: the target reads the words it was
# handed and says which one it cannot emit and why.
#
# EVERY ARM IS PAIRED WITH THE SAME DECLARATION AT THE ACCEPTED VALUE of that one
# operand, so a compiler that refused every `image` would fail four controls. The
# controls differ from their refusals in exactly one word.
test "mach.lang.driver:a_handle_operand_is_refused_by_the_operand" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }

    # Depth 1: depth-comparison sampling needs `OpImageSampleDref*` and a reference
    # value the sampling operation here has no operand for.
    val depth_bad: str = "#[handle(\"spirv\", \"image\", 0, 1, 1, 0, 0, 1)]\npub def T;\n\nfun main() i32 { ret 0; }\n";
    val depth_ok:  str = "#[handle(\"spirv\", \"image\", 0, 1, 0, 0, 0, 1)]\npub def T;\n\nfun main() i32 { ret 0; }\n";
    if (!ut_h_diag(?alloc, depth_bad, "`Depth` operand is not `0`")) { ret 1; }
    if (ut_h_diag(?alloc, depth_ok, "`Depth` operand is not `0`"))   { ret 1; }

    # MS 1: a multisampled image is fetched per sample, not sampled.
    val ms_bad: str = "#[handle(\"spirv\", \"image\", 0, 1, 0, 0, 1, 1)]\npub def T;\n\nfun main() i32 { ret 0; }\n";
    val ms_ok:  str = "#[handle(\"spirv\", \"image\", 0, 1, 0, 0, 0, 1)]\npub def T;\n\nfun main() i32 { ret 0; }\n";
    if (!ut_h_diag(?alloc, ms_bad, "`MS` operand is not `0`")) { ret 1; }
    if (ut_h_diag(?alloc, ms_ok, "`MS` operand is not `0`"))   { ret 1; }

    # Dim past Cube: Rect, Buffer and SubpassData each need a capability and a
    # sampling path beyond the ones emitted here.
    val dim_bad: str = "#[handle(\"spirv\", \"image\", 0, 4, 0, 0, 0, 1)]\npub def T;\n\nfun main() i32 { ret 0; }\n";
    val dim_ok:  str = "#[handle(\"spirv\", \"image\", 0, 3, 0, 0, 0, 1)]\npub def T;\n\nfun main() i32 { ret 0; }\n";
    if (!ut_h_diag(?alloc, dim_bad, "`Dim` operand names a dimensionality")) { ret 1; }
    if (ut_h_diag(?alloc, dim_ok, "`Dim` operand names a dimensionality"))   { ret 1; }

    # Sampled 2: a storage image is read and written rather than sampled, and needs
    # an Image Format operand this cut does not spell.
    val store_bad: str = "#[handle(\"spirv\", \"image\", 0, 1, 0, 0, 0, 2)]\npub def T;\n\nfun main() i32 { ret 0; }\n";
    val store_ok:  str = "#[handle(\"spirv\", \"image\", 0, 1, 0, 0, 0, 1)]\npub def T;\n\nfun main() i32 { ret 0; }\n";
    if (!ut_h_diag(?alloc, store_bad, "`Sampled` operand is not `1`")) { ret 1; }
    if (ut_h_diag(?alloc, store_ok, "`Sampled` operand is not `1`"))   { ret 1; }

    ret 0;
}

# a handle declaration is checked against the constructor's own operand count
# (#2888)
#
# The same fact the operation side checks and for the same reason: every operand the
# constructor takes is written, so a missing one would be minted as whatever the
# target defaulted it to and describe something the declaration never said.
test "mach.lang.driver:a_handle_operand_count_must_match_the_constructor" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }

    val few: str = "#[handle(\"spirv\", \"image\", 0, 1, 0)]\npub def T;\n\nfun main() i32 { ret 0; }\n";
    val many: str = "#[handle(\"spirv\", \"image\", 0, 1, 0, 0, 0, 1, 1)]\npub def T;\n\nfun main() i32 { ret 0; }\n";
    val ok:  str = "#[handle(\"spirv\", \"image\", 0, 1, 0, 0, 0, 1)]\npub def T;\n\nfun main() i32 { ret 0; }\n";

    val n: str = "operand count does not match the constructor's";
    if (!ut_h_diag(?alloc, few, n))  { ret 1; }
    if (!ut_h_diag(?alloc, many, n)) { ret 1; }
    if (ut_h_diag(?alloc, ok, n))    { ret 1; }
    ret 0;
}

# a constructor name is closed against the target's own table (#2888)
#
# The value set is closed here for the same reason the instruction names are: a
# misspelled constructor would otherwise declare a type denoting nothing, and the
# declaration is where a reader can act on it.
test "mach.lang.driver:a_handle_constructor_must_be_one_the_target_defines" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }

    val bad: str = "#[handle(\"spirv\", \"sampled_imag\", Texture2D)]\npub def T;\n\nfun main() i32 { ret 0; }\n";
    val ok:  str = "#[handle(\"spirv\", \"sampled_image\", Texture2D)]\npub def T;\n\nfun main() i32 { ret 0; }\n";

    val n: str = "defines no type constructor of this name";
    if (!ut_h_diag(?alloc, bad, n)) { ret 1; }
    if (ut_h_diag(?alloc, ok, n))   { ret 1; }
    ret 0;
}

# a composing constructor NAMES the handle it wraps, and only the right one (#2888)
#
# THIS IS THE COMPOSITION RULE, and it is why the operand is a type rather than four
# more words. `sampled_image` wrapping `Texture2D` cannot disagree with it about the
# image's operands, because there is only one statement of them. The operand is
# constrained to the constructor the position takes, so a `Sampler` - which is a
# handle, and is minted by this same target - is still refused there.
#
# THE CONTROLS ARE BOTH DIRECTIONS: the right handle in the position must pass, and
# an ordinary type in it must be refused, so the rule is neither "any handle" nor
# "any type".
test "mach.lang.driver:a_composed_handle_names_the_one_it_wraps" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }

    val wrong_ctor: str = "#[handle(\"spirv\", \"sampled_image\", Sampler)]\npub def T;\n\nfun main() i32 { ret 0; }\n";
    val ok:         str = "#[handle(\"spirv\", \"sampled_image\", Texture2D)]\npub def T;\n\nfun main() i32 { ret 0; }\n";

    val n: str = "minted by the target's `image` constructor";
    if (!ut_h_diag(?alloc, wrong_ctor, n)) { ret 1; }
    if (ut_h_diag(?alloc, ok, n))          { ret 1; }

    # an ordinary type in the position is not a handle at all, which is a different
    # sentence: there is nothing there for the constructor to wrap.
    val not_handle: str = "rec Plain { a: i32; }\n#[handle(\"spirv\", \"sampled_image\", Plain)]\npub def T;\n\nfun main() i32 { ret 0; }\n";
    val m: str = "must name a handle the same target mints";
    if (!ut_h_diag(?alloc, not_handle, m)) { ret 1; }
    if (ut_h_diag(?alloc, ok, m))          { ret 1; }
    ret 0;
}

# a type name is a decorator argument ONLY in the directive that asks for one
# (#2888)
#
# The scope of the change is the whole point of it. `#[handle]` reads an operand
# position as a type when the name denotes a handle, and nothing else does: a type
# name in any other decorator is still refused as a value, with the message it
# already had.
#
# BOTH ARMS ARE THE SAME NAME IN TWO DIRECTIVES, so the test measures the scoping
# rather than the name.
test "mach.lang.driver:a_type_name_argument_is_scoped_to_handle" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }

    # `#[align]` is an ordinary comptime-integer argument, and a type name in it is
    # refused exactly as it was before this directive existed.
    val elsewhere: str = "rec Inner { a: i32; }\n#[align(Inner)]\nvar g: i32;\n\nfun main() i32 { ret 0; }\n";
    if (!ut_h_diag(?alloc, elsewhere, "is a record type, not a value")) { ret 1; }

    # and the same shape of name inside `#[handle]` is not read as a value at all,
    # so it never reaches that sentence.
    val inside: str = "#[handle(\"spirv\", \"sampled_image\", Texture2D)]\npub def T;\n\nfun main() i32 { ret 0; }\n";
    if (ut_h_diag(?alloc, inside, "not a value")) { ret 1; }
    ret 0;
}

# a `#[handle]` declaration carries no body, and a `def` with one is not a handle
# (#2888)
#
# `def` already means "this name denotes a type" and promises no fields and no
# storage, which is what makes it the carrier. The two forms are told apart by the
# body rather than by the decorator, so a declaration that has both is a
# contradiction rather than a preference.
test "mach.lang.driver:a_handle_declaration_has_no_body" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }

    val bad: str = "#[handle(\"spirv\", \"sampler\")]\npub def T: i32;\n\nfun main() i32 { ret 0; }\n";
    val ok:  str = "#[handle(\"spirv\", \"sampler\")]\npub def T;\n\nfun main() i32 { ret 0; }\n";

    val n: str = "a `handle` declaration has no body";
    if (!ut_h_diag(?alloc, bad, n)) { ret 1; }
    if (ut_h_diag(?alloc, ok, n))   { ret 1; }
    ret 0;
}

# whether the module declares one capability
# ---
# w, n: the instruction words
# cap:  the capability
# ret:  true when an OpCapability names it
fun ut_spv_has_cap(w: *u32, n: u32, cap: u32) bool {
    var i: u32 = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0) { ret false; }
        if ((w[i] & 0xFFFF) == spirv.OP_CAPABILITY && len >= 2 && w[i + 1] == cap) { ret true; }
        i = i + len;
    }
    ret false;
}

# lower and emit a single-module shader, and report whether it declares Int64
# ---
# s, alloc:  session and allocator
# src:       the module text
# out_has:   receives whether OpCapability Int64 is declared
# ret:       true when the module lowered and emitted
fun ut_spv_declares_int64(s: *session.Session, alloc: *A.Allocator, src: str, out_has: *bool) bool {
    var names: [1]str;
    var texts: [1]str;
    names[0] = "main.mach"; texts[0] = src;
    val pr: R.Result[project.Project, outcome.Fail] = ut_spv_lower(s, alloc, ?names[0], ?texts[0], 1, "", nil, nil, 0);
    if (R.is_err[project.Project, outcome.Fail](pr)) { ret false; }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);

    var img: of.ObjectImage;
    var err: str = nil;
    if (!ut_spv_codegen(?p, s, "spvcase.main", ?img, ?err)) { project.dnit_project(?p); ret false; }
    var n: u32 = 0;
    val w: *u32 = ut_spv_words(?img, ?n);
    if (w == nil) { obj.dnit(?img); project.dnit_project(?p); ret false; }

    @out_has = ut_spv_has_cap(w, n, spirv.CAP_INT64);
    obj.dnit(?img);
    project.dnit_project(?p);
    ret true;
}

# a shader indexing an array with a u32 does not acquire Int64 (#2878)
#
# `widen_index` normalized every gep index to the target's POINTER width, which is
# how a byte-addressed machine gets a full-width index register to scale. SPIR-V
# addresses logically: an OpAccessChain index selects a member and nothing scales
# it, so the widening bought nothing and cost a `shaderInt64` device requirement on
# a module whose arithmetic is entirely 32-bit. A device without the feature refuses
# the module outright, so this narrowed the hardware a shader ran on.
#
# BOTH ARMS ARE THE TEST. Asserting only the u32 arm would pass just as well if the
# emitter had stopped declaring Int64 at all, which would take a genuinely 64-bit
# shader from a wrong capability list to an invalid module. The u64 arm holds the
# declaration in place where the program actually asked for it.
test "mach.lang.driver:spirv_u32_index_does_not_declare_int64" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    val narrow: str = "rec Palette { columns: [64]f32x4; }\n#[storage(0, 0)] var palette: Palette;\n\n#[input(0)]            var in_ix:    u32;\n#[builtin(\"position\")] var position: f32x4;\n\n#[stage(\"vertex\")]\nfun vs() { position = palette.columns[in_ix * 2]; }\n\nfun main() i32 { ret 0; }\n";
    val wide:   str = "rec Palette { columns: [64]f32x4; }\n#[storage(0, 0)] var palette: Palette;\n\n#[input(0)]            var in_ix:    u32;\n#[builtin(\"position\")] var position: f32x4;\n\n#[stage(\"vertex\")]\nfun vs() { val w: u64 = in_ix::u64 * 2::u64; position = palette.columns[w]; }\n\nfun main() i32 { ret 0; }\n";

    var bad: i32 = 0;
    var has_narrow: bool = false;
    var has_wide:   bool = false;
    if (!ut_spv_declares_int64(?s, ?alloc, narrow, ?has_narrow)) { session.dnit(?s); ret 1; }
    if (!ut_spv_declares_int64(?s, ?alloc, wide,   ?has_wide))   { session.dnit(?s); ret 1; }

    if (has_narrow) { bad = 1; }
    if (!has_wide)  { bad = 1; }

    session.dnit(?s);
    ret bad;
}

# the cross-module fixture's root module: two stages reaching one helper chain
#
# `#[noinline]` throughout, because the subject is what the EMITTER put in the
# module and an inliner folding the chain first would leave nothing to look at.
#
# Every function in the tree has a distinct arity, which is how the assertions name
# one: 0 for the stages, 1 for the same-module helper, 2 for the sibling module's
# reachable function, 3 for the dependency's, 4 for the dependency's own
# dependency, and 5 and 6 for the two unreachable ones.
fun ut_spv_root_src() str {
    ret "use lo: spvcase.local;\nuse tn: shlib.tone;\n\n#[input(0)]  var in_x:  f32;\n#[output(0)] var out_a: f32;\n#[output(1)] var out_b: f32;\n\n#[stage(\"vertex\")]\nfun vert_main() { out_a = shared(in_x); }\n\n#[stage(\"fragment\")]\nfun frag_main() { out_b = shared(in_x); }\n\n#[noinline]\nfun shared(v: f32) f32 { ret tn.curve(lo.scale(v, 2.0), 3.0, 4.0); }\n\nfun main() i32 { ret 0; }\n";
}

# the SIBLING module: same project, found under its own `src`
fun ut_spv_local_src() str {
    ret "#[noinline]\npub fun scale(a: f32, b: f32) f32 { ret a * b; }\n\n#[noinline]\npub fun unused(a: f32, b: f32, c: f32, d: f32, e: f32) f32 { ret a + b + c + d + e; }\n";
}

# the DEPENDENCY's entry module, which a consumer resolves the dep through
fun ut_spv_dep_lib_src() str {
    ret "fwd shlib.tone;\nfwd shlib.base;\n";
}

# the DEPENDENCY module the shader calls, which itself calls one module further out
fun ut_spv_dep_tone_src() str {
    ret "use b: shlib.base;\n\n#[noinline]\npub fun curve(a: f32, c: f32, d: f32) f32 { ret b.gain(a, c, d, 2.0); }\n\n#[noinline]\npub fun never_used(a: f32, b_: f32, c: f32, d: f32, e: f32, f: f32) f32 { ret a + b_ + c + d + e + f; }\n";
}

# one boundary further out again: nothing in the shader names this module
fun ut_spv_dep_base_src() str {
    ret "#[noinline]\npub fun gain(a: f32, b: f32, c: f32, d: f32) f32 { ret a * b + c * d; }\n";
}

# load and lower the four-module cross-module fixture
fun ut_spv_fixture(s: *session.Session, alloc: *A.Allocator) R.Result[project.Project, outcome.Fail] {
    var names: [2]str;
    var texts: [2]str;
    names[0] = "main.mach";  texts[0] = ut_spv_root_src();
    names[1] = "local.mach"; texts[1] = ut_spv_local_src();
    var dnames: [3]str;
    var dtexts: [3]str;
    dnames[0] = "lib.mach";  dtexts[0] = ut_spv_dep_lib_src();
    dnames[1] = "tone.mach"; dtexts[1] = ut_spv_dep_tone_src();
    dnames[2] = "base.mach"; dtexts[2] = ut_spv_dep_base_src();
    ret ut_spv_lower(s, alloc, ?names[0], ?texts[0], 2, "shlib", ?dnames[0], ?dtexts[0], 3);
}

# a shader emits the bodies it calls across a module boundary, from a sibling module
# and from a dependency alike (#2823)
#
# Before this, the emitter was handed one `ir.Module` and refused any call whose
# callee was not in it, so a shader project could factor nothing with a body into a
# shared module: `a call to a function defined outside the module is not yet
# supported by the SPIR-V target`.
#
# The arities carry the assertion. 2 is the sibling module's `scale` and 3 the
# dependency's `curve`, so their presence is the two boundaries crossed; 4 is
# `shlib.base.gain`, which THE SHADER NEVER NAMES - it arrives only because the
# closure the driver walks is a fixpoint, and a one-hop closure would leave `curve`
# calling a body this module does not define. That last failure mode is caught
# independently by the resolve check, which is the property `spirv-val` would also
# have caught and the only one it would.
test "mach.lang.driver:spirv_emits_a_callee_from_another_module" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    val pr: R.Result[project.Project, outcome.Fail] = ut_spv_fixture(?s, ?alloc);
    if (R.is_err[project.Project, outcome.Fail](pr)) { session.dnit(?s); ret 1; }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);

    var bad: i32 = 0;
    var img: of.ObjectImage;
    var err: str = nil;
    if (!ut_spv_codegen(?p, ?s, "spvcase.main", ?img, ?err)) {
        project.dnit_project(?p); session.dnit(?s); ret 1;
    }
    var n: u32 = 0;
    val w: *u32 = ut_spv_words(?img, ?n);
    if (w == nil) { obj.dnit(?img); project.dnit_project(?p); session.dnit(?s); ret 1; }

    # the sibling module's `scale`, emitted here as an ordinary OpFunction.
    if (ut_spv_arity_count(w, n, 2) != 1) { bad = 1; }
    # the dependency's `curve`, across a `[dep.*]` boundary rather than a file one.
    if (ut_spv_arity_count(w, n, 3) != 1) { bad = 1; }
    # `shlib.base.gain`, which this module never names: the closure is transitive.
    if (ut_spv_arity_count(w, n, 4) != 1) { bad = 1; }
    # every call names a body this module defines - no call left dangling.
    if (!ut_spv_calls_all_resolve(w, n))  { bad = 1; }
    # a shader module declares no linkage, so nothing here is exported.
    if (ut_spv_export_count(w, n) != 0)   { bad = 1; }

    obj.dnit(?img);
    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

# only what the entry points reach is emitted, so importing a shared module costs
# the helpers actually called and nothing else (#2823)
#
# The two `pub fun`s nothing reaches - `spvcase.local.unused` at arity 5 and
# `shlib.tone.never_used` at arity 6 - must be absent from the shader while their
# own modules still publish them. A shader that dragged its imports' unreachable
# halves along would validate perfectly and grow without bound.
#
# `main` is the same rule applied to the module's OWN functions: it is unreachable
# from any stage, so the shader carries six functions and not seven.
test "mach.lang.driver:spirv_omits_what_no_entry_point_reaches" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    val pr: R.Result[project.Project, outcome.Fail] = ut_spv_fixture(?s, ?alloc);
    if (R.is_err[project.Project, outcome.Fail](pr)) { session.dnit(?s); ret 1; }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);

    var bad: i32 = 0;
    var img: of.ObjectImage;
    var err: str = nil;
    if (!ut_spv_codegen(?p, ?s, "spvcase.main", ?img, ?err)) {
        project.dnit_project(?p); session.dnit(?s); ret 1;
    }
    var n: u32 = 0;
    val w: *u32 = ut_spv_words(?img, ?n);
    if (w == nil) { obj.dnit(?img); project.dnit_project(?p); session.dnit(?s); ret 1; }

    # the sibling module's unreachable `pub fun`.
    if (ut_spv_arity_count(w, n, 5) != 0) { bad = 1; }
    # the dependency's unreachable `pub fun`.
    if (ut_spv_arity_count(w, n, 6) != 0) { bad = 1; }
    # two stages, one same-module helper, three drawn in: six, with `main` dropped.
    if (ut_spv_count(w, n, spirv.OP_FUNCTION) != 6) { bad = 1; }

    # and the two are still published by the modules that own them, so this is a
    # statement about what the SHADER carries, not about the functions vanishing.
    var lib: of.ObjectImage;
    if (!ut_spv_codegen(?p, ?s, "spvcase.local", ?lib, ?err)) { bad = 1; }
    or {
        var ln: u32 = 0;
        val lw: *u32 = ut_spv_words(?lib, ?ln);
        if (lw == nil) { bad = 1; }
        or {
            if (ut_spv_count(lw, ln, spirv.OP_FUNCTION) != 2) { bad = 1; }
            if (ut_spv_arity_count(lw, ln, 5) != 1)           { bad = 1; }
            if (ut_spv_export_count(lw, ln) != 2)             { bad = 1; }
        }
        obj.dnit(?lib);
    }

    obj.dnit(?img);
    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

# two entry points reaching one helper emit it ONCE (#2823)
#
# A closure walked per entry point rather than once over the emitted set would emit
# `shared`, `scale`, `curve` and `gain` twice over, and the result would validate -
# so the count is the assertion, not the presence, and the two entry points are
# checked to reach the same id rather than merely to reach something.
test "mach.lang.driver:spirv_shares_one_helper_between_two_entry_points" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    val pr: R.Result[project.Project, outcome.Fail] = ut_spv_fixture(?s, ?alloc);
    if (R.is_err[project.Project, outcome.Fail](pr)) { session.dnit(?s); ret 1; }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);

    var bad: i32 = 0;
    var img: of.ObjectImage;
    var err: str = nil;
    if (!ut_spv_codegen(?p, ?s, "spvcase.main", ?img, ?err)) {
        project.dnit_project(?p); session.dnit(?s); ret 1;
    }
    var n: u32 = 0;
    val w: *u32 = ut_spv_words(?img, ?n);
    if (w == nil) { obj.dnit(?img); project.dnit_project(?p); session.dnit(?s); ret 1; }

    if (ut_spv_count(w, n, spirv.OP_ENTRY_POINT) != 2) { bad = 1; }
    # one of each, however many stages reach them.
    if (ut_spv_arity_count(w, n, 1) != 1) { bad = 1; }
    if (ut_spv_arity_count(w, n, 2) != 1) { bad = 1; }
    if (ut_spv_arity_count(w, n, 3) != 1) { bad = 1; }
    if (ut_spv_arity_count(w, n, 4) != 1) { bad = 1; }

    # and both stages call the SAME id, which is what "shared" means here. Comparing
    # the ids rather than the counts alone rules out two stages that each got their
    # own copy of a helper the count then reported once by luck of the fixture.
    val e0: u32 = ut_spv_entry_fn(w, n, 0);
    val e1: u32 = ut_spv_entry_fn(w, n, 1);
    val i0: u32 = ut_spv_fn_index_of(w, n, e0);
    val i1: u32 = ut_spv_fn_index_of(w, n, e1);
    if (e0 == 0 || e1 == 0 || e0 == e1)               { bad = 1; }
    if (i0 == UT_SPV_NO_FN || i1 == UT_SPV_NO_FN)     { bad = 1; }
    or {
        val c0: u32 = ut_spv_first_callee_in(w, n, i0);
        val c1: u32 = ut_spv_first_callee_in(w, n, i1);
        if (c0 == 0 || c0 != c1) { bad = 1; }
    }

    obj.dnit(?img);
    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

# a library module that draws a body in carries it as an INTERNAL function, never as
# a second export of a symbol its owner already publishes (#2823)
#
# `shlib.tone` has no entry point, so it is a library module and publishes its own
# functions under LinkageAttributes. It also calls `shlib.base.gain`, which it must
# now emit - there is no SPIR-V import to bind instead. Exporting that copy would
# put two definitions of one name in front of a consumer linking the pair, a
# collision this module invented over a function it does not own.
#
# So: three functions, two exports. The count is the whole assertion, and it is one
# `spirv-val` has nothing to say about - a module with a duplicate export is valid
# on its own and fails only at whatever links it.
test "mach.lang.driver:spirv_does_not_export_a_drawn_in_body" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    val pr: R.Result[project.Project, outcome.Fail] = ut_spv_fixture(?s, ?alloc);
    if (R.is_err[project.Project, outcome.Fail](pr)) { session.dnit(?s); ret 1; }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);

    var bad: i32 = 0;
    var img: of.ObjectImage;
    var err: str = nil;
    if (!ut_spv_codegen(?p, ?s, "shlib.tone", ?img, ?err)) {
        project.dnit_project(?p); session.dnit(?s); ret 1;
    }
    var n: u32 = 0;
    val w: *u32 = ut_spv_words(?img, ?n);
    if (w == nil) { obj.dnit(?img); project.dnit_project(?p); session.dnit(?s); ret 1; }

    # a library module: no entry points, and its own two functions published.
    if (ut_spv_count(w, n, spirv.OP_ENTRY_POINT) != 0) { bad = 1; }
    # `curve` (3), `never_used` (6), and the drawn-in `gain` (4).
    if (ut_spv_count(w, n, spirv.OP_FUNCTION) != 3)    { bad = 1; }
    if (ut_spv_arity_count(w, n, 4) != 1)              { bad = 1; }
    # two exports, not three: the drawn-in body is not one of them.
    if (ut_spv_export_count(w, n) != 2)                { bad = 1; }
    if (!ut_spv_calls_all_resolve(w, n))               { bad = 1; }

    obj.dnit(?img);
    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

# recursion drawn in across a module boundary is refused BY THE MODULE THAT DRAWS IT
# IN, naming the cycle and qualifying it with the module it came from (#2823, #2748)
#
# The fixture is arranged so the importing shader is the only thing that can catch
# it. `spvcase.helper` has an entry point of its own, so it is a shader module and
# emits the closure of its entry points; `step` is outside that closure, so its own
# module builds CLEAN. Only the module that actually emits `step` sees the cycle -
# which is the #2748 check having widened along with the emitter, and the arrangement
# that fails against an emitter which never looked across the boundary.
#
# `spirv-val` cannot be the observable: its cycle rule is scoped to entry points, so
# a module carrying an unreached cycle validates clean, which is how #2748's defect
# survived eleven releases.
#
# The qualification is asserted, not just the refusal: two modules may spell a helper
# the same way, and a message naming a bare `step` sends the reader to the wrong file.
test "mach.lang.driver:spirv_refuses_recursion_drawn_in_from_another_module" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    var names: [2]str;
    var texts: [2]str;
    names[0] = "main.mach";
    texts[0] = "use h: spvcase.helper;\n\n#[input(0)]  var in_n:  i32;\n#[output(0)] var out_n: i32;\n\n#[stage(\"vertex\")]\nfun vert_main() { out_n = h.step(in_n); }\n\nfun main() i32 { ret 0; }\n";
    names[1] = "helper.mach";
    texts[1] = "#[builtin(\"position\")] var position: f32x4;\n\n#[stage(\"vertex\")]\nfun pass() { position = f32x4{0.0, 0.0, 0.0, 1.0}; }\n\n#[noinline]\npub fun step(n: i32) i32 {\n    if (n <= 1) { ret 1; }\n    ret n * step(n - 1);\n}\n";
    var dn: [1]str;
    var dt: [1]str;
    val pr: R.Result[project.Project, outcome.Fail] =
        ut_spv_lower(?s, ?alloc, ?names[0], ?texts[0], 2, "", ?dn[0], ?dt[0], 0);
    if (R.is_err[project.Project, outcome.Fail](pr)) { session.dnit(?s); ret 1; }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);

    var bad: i32 = 0;
    var img: of.ObjectImage;
    var err: str = nil;

    # the DEFINING module is clean: `step` is outside its entry point's closure, so
    # it never emits it and has no cycle to refuse. Without this the test would pass
    # against a compiler that simply refused everything.
    if (!ut_spv_codegen(?p, ?s, "spvcase.helper", ?img, ?err)) { bad = 1; }
    or { obj.dnit(?img); }

    # the IMPORTING module refuses, because it is the one that emits `step`.
    var img2: of.ObjectImage;
    var err2: str = nil;
    if (ut_spv_codegen(?p, ?s, "spvcase.main", ?img2, ?err2)) {
        bad = 1;
        obj.dnit(?img2);
    }
    or {
        if (err2 == nil)                                             { bad = 1; }
        or {
            # names recursion rather than falling back to a generic message.
            if (!ut_str_contains(err2, "cycle"))                     { bad = 1; }
            if (!ut_str_contains(err2, "has no call stack"))         { bad = 1; }
            # and qualifies the chain with the module the body came from.
            if (!ut_str_contains(err2, "spvcase.helper.step -> spvcase.helper.step")) { bad = 1; }
        }
    }

    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

# a call to a foreign `ext` import is refused as FOREIGN, not as cross-module (#2823)
#
# The other direction. Before this change one message covered every callee with no
# body in reach, and it said "defined outside the module" - which is now the normal,
# working case. What is left has to be told apart: a mach function in another module
# is drawn in, and a foreign symbol never can be, because no mach module defines it
# and a self-contained module has nothing to bind at load time. The two have
# different fixes, so asserting the refusal alone would not be enough - the test
# pins which one it is, and that the superseded wording is gone.
#
# `ext fun` parses and resolves cleanly, so this reaches the emitter: a refusal here
# cannot be a front-end rejection wearing a back-end test's name.
test "mach.lang.driver:spirv_refuses_a_foreign_ext_call_by_name" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    var names: [1]str;
    var texts: [1]str;
    names[0] = "main.mach";
    texts[0] = "ext fun host_sqrtf(v: f32) f32;\n\n#[input(0)]  var in_x:  f32;\n#[output(0)] var out_x: f32;\n\n#[stage(\"vertex\")]\nfun vert_main() { out_x = host_sqrtf(in_x); }\n\nfun main() i32 { ret 0; }\n";
    var dn: [1]str;
    var dt: [1]str;
    val pr: R.Result[project.Project, outcome.Fail] =
        ut_spv_lower(?s, ?alloc, ?names[0], ?texts[0], 1, "", ?dn[0], ?dt[0], 0);
    if (R.is_err[project.Project, outcome.Fail](pr)) { session.dnit(?s); ret 1; }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);

    var bad: i32 = 0;
    var img: of.ObjectImage;
    var err: str = nil;
    if (ut_spv_codegen(?p, ?s, "spvcase.main", ?img, ?err)) {
        bad = 1;
        obj.dnit(?img);
    }
    or {
        if (err == nil) { bad = 1; }
        or {
            if (!ut_str_contains(err, "host_sqrtf"))          { bad = 1; }
            if (!ut_str_contains(err, "declared `ext`"))      { bad = 1; }
            if (!ut_str_contains(err, "self-contained"))      { bad = 1; }
            # the message this one replaced, which must not come back for a case it
            # never described correctly.
            if (ut_str_contains(err, "defined outside the module")) { bad = 1; }
        }
    }

    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

# --- interface variables across the emission unit (#2843) --------------------
#
# The same in-process reading as the #2823 tests above, over the other namespace a
# drawn-in body can name. What these have to see is again beyond a validator: a
# module that declares a descriptor it never uses, or one that omits a drawn-in
# module's input from an entry point's interface list, is well-formed SPIR-V.
#
# IDENTIFYING A VARIABLE BY ITS DECORATION is the counterpart of naming a function
# by its arity. An interface variable carries no name in the emitted module either,
# but it carries the thing the author actually wrote - a location, or a descriptor
# pair - and that survives renumbering.

# the id decorated with `decor` carrying `value`, or 0
# ---
# w, n:  the instruction words
# decor: the SPIR-V decoration
# value: the decoration's single operand
# ret:   the decorated id, or 0 when nothing carries it
fun ut_spv_decorated_id(w: *u32, n: u32, decor: u32, value: u32) u32 {
    var i: u32 = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0) { ret 0; }
        if ((w[i] & 0xFFFF) == spirv.OP_DECORATE && len >= 4
            && w[i + 2] == decor && w[i + 3] == value) { ret w[i + 1]; }
        i = i + len;
    }
    ret 0;
}

# how many ids carry `decor` at all
fun ut_spv_decor_count(w: *u32, n: u32, decor: u32) u32 {
    var i: u32 = 0;
    var c: u32 = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0) { ret c; }
        if ((w[i] & 0xFFFF) == spirv.OP_DECORATE && len >= 3 && w[i + 2] == decor) { c = c + 1; }
        i = i + len;
    }
    ret c;
}

# the id of the variable decorated with both `DescriptorSet set` and `Binding bind`
#
# Both halves are required rather than either, because a descriptor is the PAIR: a
# variable matching only one of them is a different binding that happens to share a
# number, and accepting it would let a test about `(0, 1)` pass on `(0, 0)`.
#
# THE SEARCH IS OVER EVERY VARIABLE IN THE SET, not the first one found in it. Two
# variables in one descriptor set differing only in binding is the normal shape -
# it is exactly what two shared modules that do NOT collide look like - so keying
# on the first `DescriptorSet` match and then testing its binding answers "no such
# descriptor" for every one but the first.
# ---
# w, n: the instruction words
# set:  the descriptor set
# bind: the binding
# ret:  the variable id, or 0
fun ut_spv_descriptor_var(w: *u32, n: u32, set: u32, bind: u32) u32 {
    var i: u32 = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0) { ret 0; }
        if ((w[i] & 0xFFFF) == spirv.OP_DECORATE && len >= 4
            && w[i + 2] == spirv.DECOR_DESCRIPTOR_SET && w[i + 3] == set) {
            val cand: u32 = w[i + 1];
            var j: u32 = 0;
            for (j < n) {
                val jl: u32 = w[j] >> 16;
                if (jl == 0) { j = n; cnt; }
                if ((w[j] & 0xFFFF) == spirv.OP_DECORATE && jl >= 4 && w[j + 1] == cand
                    && w[j + 2] == spirv.DECOR_BINDING && w[j + 3] == bind) { ret cand; }
                j = j + jl;
            }
        }
        i = i + len;
    }
    ret 0;
}

# whether entry point `k`'s interface list names `id`
#
# The interface operands follow the name, which is a NUL-padded literal string of
# whatever length, so the list cannot be found at a fixed offset: the walk steps
# over the words of the name until one of them ends in a zero byte, and what
# follows to the end of the instruction is the list.
# ---
# w, n: the instruction words
# k:    which entry point, in emission order
# id:   the variable id
# ret:  true when the list carries it
fun ut_spv_entry_iface_has(w: *u32, n: u32, k: u32, id: u32) bool {
    var i: u32 = 0;
    var seen: u32 = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0) { ret false; }
        if ((w[i] & 0xFFFF) == spirv.OP_ENTRY_POINT) {
            if (seen == k) {
                var j: u32 = i + 3;
                var ended: bool = false;
                for (j < i + len && !ended) {
                    if ((w[j] & 0xFF000000) == 0 || (w[j] & 0x00FF0000) == 0
                        || (w[j] & 0x0000FF00) == 0 || (w[j] & 0x000000FF) == 0) { ended = true; }
                    j = j + 1;
                }
                for (j < i + len) {
                    if (w[j] == id) { ret true; }
                    j = j + 1;
                }
                ret false;
            }
            seen = seen + 1;
        }
        i = i + len;
    }
    ret false;
}

# the shared module of the interface fixture: a descriptor and a location pair it
# owns, one helper that reaches them, and a second that reaches neither
#
# `unused_cam` and `unused_in` are the whole point of the omission test: they are
# declared by a module the shader draws from, and nothing the shader reaches names
# them. A shader that declared them anyway would validate perfectly.
fun ut_spv_iface_lib_src() str {
    ret "rec Used   { a: f32; b: f32; c: f32; d: f32; }\nrec Unused { a: f32; b: f32; c: f32; d: f32; }\n\n#[uniform(0, 0)] pub var used_cam:   Used;\n#[uniform(0, 3)] pub var unused_cam: Unused;\n#[input(6)]      pub var lib_in:     f32;\n#[input(7)]      pub var unused_in:  f32;\n\n#[noinline]\npub fun touch_used(v: f32) f32 { ret v * used_cam.a + lib_in; }\n\n#[noinline]\npub fun touch_nothing(v: f32) f32 { ret v * 2.0; }\n\n#[noinline]\npub fun never_called(v: f32) f32 { ret v * unused_cam.a + unused_in; }\n";
}

# the shader: one stage reaching the shared module's variables, one reaching none
fun ut_spv_iface_root_src() str {
    ret "use l: spvcase.ilib;\n\n#[input(0)]  var in_x:  f32;\n#[output(0)] var out_a: f32;\n#[output(1)] var out_b: f32;\n\n#[stage(\"vertex\")]\nfun vert_main() { out_a = l.touch_used(in_x); }\n\n#[stage(\"fragment\")]\nfun frag_main() { out_b = l.touch_nothing(in_x); }\n\nfun main() i32 { ret 0; }\n";
}

# load and lower the interface fixture
fun ut_spv_iface_fixture(s: *session.Session, alloc: *A.Allocator) R.Result[project.Project, outcome.Fail] {
    var names: [2]str;
    var texts: [2]str;
    names[0] = "main.mach"; texts[0] = ut_spv_iface_root_src();
    names[1] = "ilib.mach"; texts[1] = ut_spv_iface_lib_src();
    var dn: [1]str;
    var dt: [1]str;
    ret ut_spv_lower(s, alloc, ?names[0], ?texts[0], 2, "", ?dn[0], ?dt[0], 0);
}

# a shader emits an interface variable declared in a module it draws a body from,
# with the descriptor the shared module's author wrote (#2843)
#
# Before this, every global resolved against the root, so a drawn-in body naming
# one found nothing and the access was refused as computed addressing - a shared
# module could own functions but not the descriptor set they read, which is the
# first thing a shader library needs beyond pure math.
#
# The assertions are about the DECORATIONS rather than about the variable count,
# because the decoration is what a pipeline binds against and it is what the author
# wrote. `(0, 0)` present says the descriptor crossed the boundary intact; the
# Location assertions say the same for the other two roles.
test "mach.lang.driver:spirv_emits_an_interface_global_from_another_module" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    val pr: R.Result[project.Project, outcome.Fail] = ut_spv_iface_fixture(?s, ?alloc);
    if (R.is_err[project.Project, outcome.Fail](pr)) { session.dnit(?s); ret 1; }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);

    var bad: i32 = 0;
    var img: of.ObjectImage;
    var err: str = nil;
    if (!ut_spv_codegen(?p, ?s, "spvcase.main", ?img, ?err)) {
        project.dnit_project(?p); session.dnit(?s); ret 1;
    }
    var n: u32 = 0;
    val w: *u32 = ut_spv_words(?img, ?n);
    if (w == nil) { obj.dnit(?img); project.dnit_project(?p); session.dnit(?s); ret 1; }

    # the shared module's `#[uniform(0, 0)]`, carried across with both halves of its
    # descriptor. this is the case the issue is named for.
    val cam: u32 = ut_spv_descriptor_var(w, n, 0, 0);
    if (cam == 0) { bad = 1; }
    # its `#[input(6)]`, reached through the same drawn-in body.
    if (ut_spv_decorated_id(w, n, spirv.DECOR_LOCATION, 6) == 0) { bad = 1; }
    # and the root's own variables still land where they always did, so widening the
    # table did not renumber or drop what already worked.
    if (ut_spv_decorated_id(w, n, spirv.DECOR_LOCATION, 0) == 0) { bad = 1; }
    if (ut_spv_decorated_id(w, n, spirv.DECOR_LOCATION, 1) == 0) { bad = 1; }
    # every call still names a body this module defines.
    if (!ut_spv_calls_all_resolve(w, n)) { bad = 1; }
    # and the shader publishes nothing, so the variable it drew in is its own
    # private copy rather than a second definition of the library's symbol.
    if (ut_spv_export_count(w, n) != 0)  { bad = 1; }

    obj.dnit(?img);
    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

# a drawn-in module's interface variables arrive by REACHABILITY, not by membership
# (#2843)
#
# The rule the function table already stated, applied to globals, and the reason it
# has to hold: a shared module may declare a whole descriptor set, and a shader
# importing it for one helper must not inherit the rest. Two unrelated libraries
# would otherwise collide on a binding neither the shader nor either author used.
#
# `unused_cam` at `(0, 3)` and `unused_in` at location 7 are declared by a module
# this shader DOES draw from, and are named only by `never_called`. Their absence
# is the assertion. The control underneath it matters as much: the library's own
# module still declares both, so this is the shader narrowing what it carries
# rather than the compiler losing a declaration.
test "mach.lang.driver:spirv_omits_an_unreached_interface_global" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    val pr: R.Result[project.Project, outcome.Fail] = ut_spv_iface_fixture(?s, ?alloc);
    if (R.is_err[project.Project, outcome.Fail](pr)) { session.dnit(?s); ret 1; }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);

    var bad: i32 = 0;
    var img: of.ObjectImage;
    var err: str = nil;
    if (!ut_spv_codegen(?p, ?s, "spvcase.main", ?img, ?err)) {
        project.dnit_project(?p); session.dnit(?s); ret 1;
    }
    var n: u32 = 0;
    val w: *u32 = ut_spv_words(?img, ?n);
    if (w == nil) { obj.dnit(?img); project.dnit_project(?p); session.dnit(?s); ret 1; }

    # what nothing reaches is absent.
    if (ut_spv_descriptor_var(w, n, 0, 3) != 0)                      { bad = 1; }
    if (ut_spv_decorated_id(w, n, spirv.DECOR_LOCATION, 7) != 0)     { bad = 1; }
    # exactly one descriptor came across, so the omission is not the whole set going
    # missing.
    if (ut_spv_decor_count(w, n, spirv.DECOR_DESCRIPTOR_SET) != 1)   { bad = 1; }
    obj.dnit(?img);

    # THE CONTROL: the library compiled on its own still declares both descriptors.
    # Without it this test would pass against a compiler that dropped every drawn-in
    # global, which is the bug it is meant to guard the fix against.
    var lib: of.ObjectImage;
    var lerr: str = nil;
    if (!ut_spv_codegen(?p, ?s, "spvcase.ilib", ?lib, ?lerr)) { bad = 1; }
    or {
        var ln: u32 = 0;
        val lw: *u32 = ut_spv_words(?lib, ?ln);
        if (lw == nil)                                                { bad = 1; }
        or {
            if (ut_spv_descriptor_var(lw, ln, 0, 0) == 0)             { bad = 1; }
            if (ut_spv_descriptor_var(lw, ln, 0, 3) == 0)             { bad = 1; }
            if (ut_spv_decorated_id(lw, ln, spirv.DECOR_LOCATION, 7) == 0) { bad = 1; }
            # NEITHER MODULE PUBLISHES THE VARIABLE. A consumer linking the library
            # and a shader that draws from it must meet one definition of each
            # symbol, and a variable declared in both would be two. The library
            # exports its three functions and nothing else, so the count is what
            # says the four interface variables stayed private; the shader exports
            # nothing at all, being a shader module.
            if (ut_spv_export_count(lw, ln) != 3)                     { bad = 1; }
        }
        obj.dnit(?lib);
    }

    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

# an entry point names a drawn-in module's interface variable exactly when it can
# reach it, and not otherwise (#2843)
#
# The interface list is per entry point while the declarations are per module, so
# "declared" and "listed" are different questions and only the second is about
# reachability. `vert_main` reaches the shared module's variables through
# `touch_used`; `frag_main` calls `touch_nothing`, which reaches none of them.
#
# BOTH DIRECTIONS ARE ASSERTED deliberately. Presence alone would pass against an
# emitter that listed every declared variable in every entry point - which is a
# module `spirv-val` accepts and a driver would bind, and which silently makes the
# reachability walk decorative.
test "mach.lang.driver:spirv_entry_lists_a_drawn_in_global_only_when_reached" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    val pr: R.Result[project.Project, outcome.Fail] = ut_spv_iface_fixture(?s, ?alloc);
    if (R.is_err[project.Project, outcome.Fail](pr)) { session.dnit(?s); ret 1; }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);

    var bad: i32 = 0;
    var img: of.ObjectImage;
    var err: str = nil;
    if (!ut_spv_codegen(?p, ?s, "spvcase.main", ?img, ?err)) {
        project.dnit_project(?p); session.dnit(?s); ret 1;
    }
    var n: u32 = 0;
    val w: *u32 = ut_spv_words(?img, ?n);
    if (w == nil) { obj.dnit(?img); project.dnit_project(?p); session.dnit(?s); ret 1; }

    val cam: u32 = ut_spv_descriptor_var(w, n, 0, 0);
    val lin: u32 = ut_spv_decorated_id(w, n, spirv.DECOR_LOCATION, 6);
    val ob:  u32 = ut_spv_decorated_id(w, n, spirv.DECOR_LOCATION, 1);
    if (cam == 0 || lin == 0 || ob == 0) {
        obj.dnit(?img); project.dnit_project(?p); session.dnit(?s); ret 1;
    }

    # the fixture's stages are emitted in source order, so entry 0 is `vert_main`.
    # asserted rather than assumed: `out_b` at location 1 is written only by
    # `frag_main`, so whichever entry lists it is the fragment one.
    var vx: u32 = 0;
    if (ut_spv_entry_iface_has(w, n, 0, ob)) { vx = 1; }
    val fx: u32 = 1 - vx;

    # the vertex stage reaches both, through `touch_used`.
    if (!ut_spv_entry_iface_has(w, n, vx, cam)) { bad = 1; }
    if (!ut_spv_entry_iface_has(w, n, vx, lin)) { bad = 1; }
    # the fragment stage reaches neither, and must not list them.
    if (ut_spv_entry_iface_has(w, n, fx, cam))  { bad = 1; }
    if (ut_spv_entry_iface_has(w, n, fx, lin))  { bad = 1; }
    # and it does list its own output, so an empty list is not what makes the two
    # assertions above pass.
    if (!ut_spv_entry_iface_has(w, n, fx, ob))  { bad = 1; }

    obj.dnit(?img);
    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

# two modules claiming one descriptor are refused, and the diagnostic names the
# MODULES (#2843)
#
# Within one module a repeated `(set, binding)` is a typo its author can see. Across
# modules it is not: two shared libraries can each declare `#[uniform(0, 0)]`
# without either author seeing the other, and the shader importing both is where
# the conflict first exists. So the message has to carry the module paths - naming
# two variables tells the one person who can act on it nothing.
#
# `spirv-val` does not catch this. Two variables at one `(set, binding)` are
# well-formed SPIR-V; the conflict is with the pipeline layout, which is not in the
# module. This check is therefore here or nowhere.
#
# THE COUNTERFACTUAL IS PART OF THE TEST. The same two modules with `libb` moved to
# binding 1 must BUILD, because a refusal test whose fixture would be refused for
# any reason - a parse error, a missing symbol, an unrelated rule - asserts nothing
# about the rule it names.
#
# THE MESSAGE IS ASSERTED, NOT MERELY THE REFUSAL, for the same reason. Before this
# change these very modules were refused too, as computed addressing, because a
# drawn-in global resolved to nothing. An `is_err` assertion would have passed
# against the unfixed compiler and gone on passing forever while proving nothing:
# whenever the fixed and the broken behaviour are both spelled "an error", only the
# text tells them apart.
test "mach.lang.driver:spirv_refuses_a_descriptor_collision_across_modules" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    var names: [3]str;
    var texts: [3]str;
    names[0] = "main.mach";
    texts[0] = "use a: spvcase.liba;\nuse b: spvcase.libb;\n\n#[input(0)]  var in_x:  f32;\n#[output(0)] var out_a: f32;\n\n#[stage(\"vertex\")]\nfun vert_main() { out_a = a.from_a(in_x) + b.from_b(in_x); }\n\nfun main() i32 { ret 0; }\n";
    names[1] = "liba.mach";
    texts[1] = "rec CamA { x: f32; y: f32; z: f32; w: f32; }\n#[uniform(0, 0)] pub var cam_a: CamA;\n\n#[noinline]\npub fun from_a(v: f32) f32 { ret v * cam_a.x; }\n";
    names[2] = "libb.mach";
    texts[2] = "rec CamB { p: f32; q: f32; r: f32; s: f32; }\n#[uniform(0, 0)] pub var cam_b: CamB;\n\n#[noinline]\npub fun from_b(v: f32) f32 { ret v * cam_b.p; }\n";
    var dn: [1]str;
    var dt: [1]str;
    val pr: R.Result[project.Project, outcome.Fail] =
        ut_spv_lower(?s, ?alloc, ?names[0], ?texts[0], 3, "", ?dn[0], ?dt[0], 0);
    if (R.is_err[project.Project, outcome.Fail](pr)) { session.dnit(?s); ret 1; }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);

    var bad: i32 = 0;

    # each library alone is clean: one descriptor, no one to collide with. without
    # this the test would pass against a compiler that refused the fixture outright.
    var la: of.ObjectImage;
    var lae: str = nil;
    if (!ut_spv_codegen(?p, ?s, "spvcase.liba", ?la, ?lae)) { bad = 1; }
    or { obj.dnit(?la); }

    var img: of.ObjectImage;
    var err: str = nil;
    if (ut_spv_codegen(?p, ?s, "spvcase.main", ?img, ?err)) {
        bad = 1;
        obj.dnit(?img);
    }
    or {
        if (err == nil) { bad = 1; }
        or {
            # the rule it broke, stated as the pair rather than as one number.
            if (!ut_str_contains(err, "set = 0, binding = 0")) { bad = 1; }
            # and BOTH declaring modules, which is the whole point of the message.
            if (!ut_str_contains(err, "spvcase.liba"))         { bad = 1; }
            if (!ut_str_contains(err, "spvcase.libb"))         { bad = 1; }
        }
    }

    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

# the counterfactual for the collision above: the same shape at two DIFFERENT
# bindings builds, and carries both descriptors (#2843)
#
# Separated into its own test rather than tacked onto the refusal so that a failure
# says which half broke. A check that refuses too much and a check that refuses the
# right thing are indistinguishable from the refusal alone.
test "mach.lang.driver:spirv_accepts_two_modules_at_distinct_bindings" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    var names: [3]str;
    var texts: [3]str;
    names[0] = "main.mach";
    texts[0] = "use a: spvcase.liba;\nuse b: spvcase.libb;\n\n#[input(0)]  var in_x:  f32;\n#[output(0)] var out_a: f32;\n\n#[stage(\"vertex\")]\nfun vert_main() { out_a = a.from_a(in_x) + b.from_b(in_x); }\n\nfun main() i32 { ret 0; }\n";
    names[1] = "liba.mach";
    texts[1] = "rec CamA { x: f32; y: f32; z: f32; w: f32; }\n#[uniform(0, 0)] pub var cam_a: CamA;\n\n#[noinline]\npub fun from_a(v: f32) f32 { ret v * cam_a.x; }\n";
    names[2] = "libb.mach";
    # the ONLY difference from the refused fixture: binding 1 rather than binding 0.
    texts[2] = "rec CamB { p: f32; q: f32; r: f32; s: f32; }\n#[uniform(0, 1)] pub var cam_b: CamB;\n\n#[noinline]\npub fun from_b(v: f32) f32 { ret v * cam_b.p; }\n";
    var dn: [1]str;
    var dt: [1]str;
    val pr: R.Result[project.Project, outcome.Fail] =
        ut_spv_lower(?s, ?alloc, ?names[0], ?texts[0], 3, "", ?dn[0], ?dt[0], 0);
    if (R.is_err[project.Project, outcome.Fail](pr)) { session.dnit(?s); ret 1; }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);

    var bad: i32 = 0;
    var img: of.ObjectImage;
    var err: str = nil;
    if (!ut_spv_codegen(?p, ?s, "spvcase.main", ?img, ?err)) {
        project.dnit_project(?p); session.dnit(?s); ret 1;
    }
    var n: u32 = 0;
    val w: *u32 = ut_spv_words(?img, ?n);
    if (w == nil) { obj.dnit(?img); project.dnit_project(?p); session.dnit(?s); ret 1; }

    # both libraries' descriptors are present, and they are DIFFERENT variables.
    val va: u32 = ut_spv_descriptor_var(w, n, 0, 0);
    val vb: u32 = ut_spv_descriptor_var(w, n, 0, 1);
    if (va == 0 || vb == 0 || va == vb) { bad = 1; }
    if (ut_spv_decor_count(w, n, spirv.DECOR_DESCRIPTOR_SET) != 2) { bad = 1; }

    obj.dnit(?img);
    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

# capture of one phase's reported roll-up, for the load-count regression (#2850)
# ---
# counts:  per-phase count as reported to `phase_end`
# dropped: per-phase excluded count as reported to `phase_dropped`
# items:   per-phase `-vv` item count, as counted from the `item` events
# seen:    whether the phase reported at all
rec UtRowCapture {
    counts:  [8]u32;
    dropped: [8]u32;
    items:   [8]u32;
    seen:    [8]bool;
}

fun ut_rc_unit_begin(ctx: ptr) { }
fun ut_rc_phase_begin(ctx: ptr, ph: u8) { }
fun ut_rc_phase_carved(ctx: ptr, ph: u8) { }
fun ut_rc_item_begin(ctx: ptr) ctime.Time { ret ctime.monotonic(); }
fun ut_rc_span_end(ctx: ptr, ph: u8, host: u8, start: ctime.Time) { }
fun ut_rc_phase_workers(ctx: ptr, ph: u8, n: u32) { }
fun ut_rc_summary(ctx: ptr, path: str, n: u32, mag: i64, unit: str, show: bool) { }

fun ut_rc_item(ctx: ptr, ph: u8, name: str, d: cdur.Duration) {
    val c: *UtRowCapture = ctx::*UtRowCapture;
    c.items[ph::u32] = c.items[ph::u32] + 1;
}

fun ut_rc_phase_end(ctx: ptr, ph: u8, count: u32, one: str, many: str) {
    val c: *UtRowCapture = ctx::*UtRowCapture;
    c.counts[ph::u32] = count;
    c.seen[ph::u32]   = true;
}

fun ut_rc_phase_dropped(ctx: ptr, ph: u8, n: u32) {
    val c: *UtRowCapture = ctx::*UtRowCapture;
    c.dropped[ph::u32] = n;
}

# install a capturing progress sink over `cap`
fun ut_rc_sink(ev: *readout.Progress, cap: *UtRowCapture) {
    ev.ctx              = cap::ptr;
    ev.fn_unit_begin    = ut_rc_unit_begin;
    ev.fn_phase_begin   = ut_rc_phase_begin;
    ev.fn_phase_carved  = ut_rc_phase_carved;
    ev.fn_item_begin    = ut_rc_item_begin;
    ev.fn_item          = ut_rc_item;
    ev.fn_phase_end     = ut_rc_phase_end;
    ev.fn_phase_workers = ut_rc_phase_workers;
    ev.fn_phase_dropped = ut_rc_phase_dropped;
    ev.fn_span_end      = ut_rc_span_end;
    ev.fn_summary       = ut_rc_summary;
}

# EVERY PHASE'S ROLL-UP COUNT IS WHAT IT PROCESSED, NOT WHAT SURVIVED IT (#2850)
#
# `load` reported `p.topo_len`, the modules that survive INTO the front-end work set,
# while it had just read, lexed, parsed and timed every module including the ones it
# then dropped - and had emitted a `-vv` item for each. So the header disagreed with
# the lines printed under it on the same screen, and understated the phase's own work
# by every target-gated orphan.
#
# THE FIXTURE HAS TO CONTAIN A TARGET-GATED MODULE, because that is the only shape
# where "processed" and "survived" differ. That is exactly why this survived #2816's
# audit: every table in it was measured on the mach self-build, whose own tree has no
# target-gated modules, so `load` and `resolve` both read 228 and matched perfectly.
# A fixture where the two counts coincide validates any rule that returns either.
#
# The assertion is the RELATIONSHIP, not a literal: load's count equals the items it
# emitted, load's count exceeds resolve's by exactly the number it reported dropping,
# and the drop is non-zero so the fixture cannot silently degenerate into the
# coinciding case if the scaffolding changes.
test "mach.lang.driver.readout:a_phase_counts_what_it_processed" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    if (R.is_err[bool, str](driver.setup_registry(?s.registry))) { session.dnit(?s); ret 1; }

    # A test-list build supplies the whole-source root set this count needs: the
    # entry, a plain orphan that survives, and a target-gated orphan whose
    # load-time `$error` guard fires and is dropped from topo.
    var names: [3]str;
    names[0] = "main.mach"; names[1] = "keep.mach"; names[2] = "gated.mach";
    var texts: [3]str;
    texts[0] = ut_cc3(?alloc, "#[symbol(\"", ut_entry_symbol(), "\")]\nfun start() i32 { ret 0; }\n");
    texts[1] = "pub fun keep() i32 { ret 1; }\n\ntest \"keep\" { ret 0; }\n";
    texts[2] = "$error(\"gated: not for this target\");\n\npub fun gated() i32 { ret 2; }\n";
    val root_r: R.Result[str, str] = ut_scaffold(?alloc, ?names[0], ?texts[0], 3);
    if (R.is_err[str, str](root_r)) { session.dnit(?s); ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);

    val mr: R.Result[manifest.Manifest, str] = driver.load_manifest(?s, root);
    if (R.is_err[manifest.Manifest, str](mr)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    var m: manifest.Manifest = R.unwrap_ok[manifest.Manifest, str](mr);
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    rq.goal         = request.GOAL_TEST_LIST;
    val pr: R.Result[bplan.BuildPlan, outcome.Fail] = bplan.plan(?alloc, ?s.interner, ?s.registry, ?m, ?rq);
    if (R.is_err[bplan.BuildPlan, outcome.Fail](pr)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    var bp: bplan.BuildPlan = R.unwrap_ok[bplan.BuildPlan, outcome.Fail](pr);

    var cap: UtRowCapture;
    var ev: readout.Progress;
    ut_rc_sink(?ev, ?cap);

    var bad: i32 = 0;
    val r: R.Result[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, ?alloc, ?ev, nil);
    if (R.is_err[outcome.BuildOutcome, outcome.Fail](r)) { bad = 1; }

    val ld: u32 = readout.PH_LOAD::u32;
    val rs: u32 = readout.PH_RESOLVE::u32;

    if (!cap.seen[ld]) { bad = 1; }
    if (!cap.seen[rs]) { bad = 1; }

    # THE FIXTURE IS NOT DEGENERATE: something really was dropped. Without this the
    # whole test would pass on a tree where the two counts coincide, which is the
    # condition that hid the defect in the first place.
    if (cap.dropped[ld] == 0) { bad = 1; }

    # the row's count equals the items printed beneath it.
    if (cap.counts[ld] != cap.items[ld]) { bad = 1; }

    # and the drop is fully accounted for: load counted the gated module, resolve did
    # not, and the difference is exactly what load reported dropping.
    if (cap.counts[ld] != cap.counts[rs] + cap.dropped[ld]) { bad = 1; }

    # every other phase counts what it processed too - each equals its own items.
    if (cap.seen[readout.PH_SEMA::u32] && cap.counts[readout.PH_SEMA::u32] != cap.items[readout.PH_SEMA::u32]) { bad = 1; }
    if (cap.seen[readout.PH_LOWER::u32] && cap.counts[readout.PH_LOWER::u32] != cap.items[readout.PH_LOWER::u32]) { bad = 1; }
    if (cap.seen[readout.PH_OPTIMIZE::u32] && cap.counts[readout.PH_OPTIMIZE::u32] != cap.items[readout.PH_OPTIMIZE::u32]) { bad = 1; }
    if (cap.seen[readout.PH_CODEGEN::u32] && cap.counts[readout.PH_CODEGEN::u32] != cap.items[readout.PH_CODEGEN::u32]) { bad = 1; }
    if (cap.seen[readout.PH_EMIT::u32] && cap.counts[readout.PH_EMIT::u32] != cap.items[readout.PH_EMIT::u32]) { bad = 1; }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

# whether `id` carries the operand-less decoration `decor`
#
# The length is checked exactly rather than as a minimum: an operand-less
# decoration is a three-word instruction, and a longer one at the same target is a
# DIFFERENT decoration whose operand happens to sit where this one's would not.
# ---
# w, n:  the instruction words
# id:    the decorated id
# decor: the decoration
# ret:   true when the stream carries it
fun ut_spv_has_bare_decor(w: *u32, n: u32, id: u32, decor: u32) bool {
    var i: u32 = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0) { ret false; }
        if ((w[i] & 0xFFFF) == spirv.OP_DECORATE && len == 3
            && w[i + 1] == id && w[i + 2] == decor) { ret true; }
        i = i + len;
    }
    ret false;
}

# the read-only / written storage fixture: three storage bindings in one stage
#
# `(0, 3)` is only ever read, `(0, 4)` is read AND written, and `(0, 5)` is read and
# carries the explicit qualifier. All three are reached by the same stage, so what
# separates them is what the module does through them and nothing else.
fun ut_spv_nonwritable_src() str {
    ret "rec P { c: [8]f32x4; }\n\n#[storage(0, 3)] var ro: P;\n#[storage(0, 4)] var rw: P;\n#[storage(0, 5, \"readonly\")] var ro_marked: P;\n\n#[input(0)] var in_x: f32x4;\n#[builtin(\"position\")] var position: f32x4;\n\n#[stage(\"vertex\")]\nfun vert_main() {\n    rw.c[1] = in_x;\n    position = ro.c[2] + rw.c[3] + ro_marked.c[4];\n}\n";
}

# a storage binding no body stores through is decorated NonWritable, and one that is
# written is not (#2879)
#
# BOTH DIRECTIONS ARE THE TEST. A pass that decorated every storage buffer would
# satisfy the first assertion and be a miscompile: the decoration tells a driver the
# module does not write the descriptor, so `(0, 4)` - which stores into it two
# instructions earlier - must not carry it. The two bindings differ in nothing else.
#
# The read is through an ACCESS CHAIN, which is the shape that matters: a member walk
# off the variable is how a shader actually reads a block, so an analysis that only
# looked at whole-variable loads and stores would answer about neither binding.
test "mach.lang.driver:spirv_marks_an_unwritten_storage_binding_nonwritable" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    var names: [1]str;
    var texts: [1]str;
    names[0] = "main.mach"; texts[0] = ut_spv_nonwritable_src();
    var dn: [1]str;
    var dt: [1]str;
    val pr: R.Result[project.Project, outcome.Fail] =
        ut_spv_lower(?s, ?alloc, ?names[0], ?texts[0], 1, "", ?dn[0], ?dt[0], 0);
    if (R.is_err[project.Project, outcome.Fail](pr)) { session.dnit(?s); ret 1; }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);

    var bad: i32 = 0;
    var img: of.ObjectImage;
    var err: str = nil;
    if (!ut_spv_codegen(?p, ?s, "spvcase.main", ?img, ?err)) {
        project.dnit_project(?p); session.dnit(?s); ret 1;
    }
    var n: u32 = 0;
    val w: *u32 = ut_spv_words(?img, ?n);
    if (w == nil) { obj.dnit(?img); project.dnit_project(?p); session.dnit(?s); ret 1; }

    val ro: u32 = ut_spv_descriptor_var(w, n, 0, 3);
    val rw: u32 = ut_spv_descriptor_var(w, n, 0, 4);
    val mk: u32 = ut_spv_descriptor_var(w, n, 0, 5);
    # the fixture is not degenerate: all three descriptors are really in the module.
    if (ro == 0 || rw == 0 || mk == 0) { bad = 1; }
    or {
        if (!ut_spv_has_bare_decor(w, n, ro, spirv.DECOR_NON_WRITABLE)) { bad = 1; }
        if (ut_spv_has_bare_decor(w, n, rw, spirv.DECOR_NON_WRITABLE))  { bad = 1; }
        # the explicit qualifier reaches the same decoration the inference does.
        if (!ut_spv_has_bare_decor(w, n, mk, spirv.DECOR_NON_WRITABLE)) { bad = 1; }
    }

    obj.dnit(?img);
    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

# a store written as an assignment through a `"readonly"` binding is refused where it
# is written, on every target (#2879)
#
# The qualifier's value over the inference is precisely this diagnostic: without it
# an accidental write silently widens the module's hardware requirement, and the
# author learns about it from a validation layer. Checked through the plain sema
# helper rather than a SPIR-V fixture on purpose - which target a module is compiled
# for is not a property of its source, so the CPU build of the same file refuses it.
test "mach.lang.driver:storage_readonly_refuses_a_store" {
    val src: str = "rec P { c: [8]f32x4; }\n\n#[storage(0, 3, \"readonly\")] var ro: P;\n\nfun poke(v: f32x4) { ro.c[1] = v; }\n\nfun main() i32 { ret 0; }\n";
    if (!ut_sema_rejects_with(src, "cannot store through a `#[storage(set, binding, \"readonly\")]` binding")) { ret 1; }
    # and the same program without the qualifier is accepted, so the refusal is the
    # qualifier's and not the shape of the write.
    val ok: str = "rec P { c: [8]f32x4; }\n\n#[storage(0, 3)] var rw: P;\n\nfun poke(v: f32x4) { rw.c[1] = v; }\n\nfun main() i32 { ret 0; }\n";
    if (ut_sema_rejects_with(ok, "cannot store through")) { ret 1; }
    ret 0;
}

# an unknown `storage` memory qualifier is refused rather than ignored (#2879)
#
# A misspelling that was quietly dropped would compile to the UNCONSTRAINED binding -
# the exact requirement the author wrote the qualifier to drop - and the module would
# be correct, valid, and more expensive to bind than the one they asked for.
test "mach.lang.driver:storage_refuses_an_unknown_qualifier" {
    val src: str = "rec P { c: [8]f32x4; }\n\n#[storage(0, 3, \"readonlyy\")] var ro: P;\n\nfun main() i32 { ret 0; }\n";
    if (!ut_sema_rejects_with(src, "unknown `storage` memory qualifier")) { ret 1; }
    # `uniform` takes no qualifier: it is read-only by its storage class already.
    val un: str = "rec P { c: [8]f32x4; }\n\n#[uniform(0, 3, \"readonly\")] var u: P;\n\nfun main() i32 { ret 0; }\n";
    if (!ut_sema_rejects_with(un, "takes two arguments")) { ret 1; }
    ret 0;
}

# a store the emitter can still see through a `"readonly"` binding is refused there
# too (#2879)
#
# Sema refuses the ASSIGNMENT, which is the spelling an author reaches for. This is
# the other half: an address handed somewhere the emitter cannot follow is a write it
# must assume happens, and the qualifier turns that assumption into a refusal rather
# than a decoration the module would break. Without it the emitter's promise and the
# front end's guarantee could differ, and the decoration would be the one that lies.
test "mach.lang.driver:spirv_refuses_an_escaping_readonly_storage_address" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    var names: [1]str;
    var texts: [1]str;
    names[0] = "main.mach";
    texts[0] = "rec P { c: [8]f32x4; }\n\n#[storage(0, 3, \"readonly\")] var ro: P;\n\n#[input(0)] var in_x: f32x4;\n#[builtin(\"position\")] var position: f32x4;\n\n#[noinline]\nfun bump(p: *f32x4, v: f32x4) { @p = v; }\n\n#[stage(\"vertex\")]\nfun vert_main() {\n    bump(?ro.c[1], in_x);\n    position = ro.c[2];\n}\n";
    var dn: [1]str;
    var dt: [1]str;
    val pr: R.Result[project.Project, outcome.Fail] =
        ut_spv_lower(?s, ?alloc, ?names[0], ?texts[0], 1, "", ?dn[0], ?dt[0], 0);
    if (R.is_err[project.Project, outcome.Fail](pr)) { session.dnit(?s); ret 1; }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);

    var bad: i32 = 0;
    var img: of.ObjectImage;
    var err: str = nil;
    if (ut_spv_codegen(?p, ?s, "spvcase.main", ?img, ?err)) { bad = 1; obj.dnit(?img); }
    or {
        if (err == nil) { bad = 1; }
        or (!ut_str_contains(err, "a store reaches the `#[storage(0, 3, \"readonly\")]` binding")) { bad = 1; }
    }

    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

# the module's OpTypeBool id, or 0 when it declares none
fun ut_spv_bool_type(w: *u32, n: u32) u32 {
    var i: u32 = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0) { ret 0; }
        if ((w[i] & 0xFFFF) == spirv.OP_TYPE_BOOL) { ret w[i + 1]; }
        i = i + len;
    }
    ret 0;
}

# whether `id` names a value whose type is the boolean one
#
# An id that appears in a RESULT-TYPE position holding the bool type id is a boolean
# value, and that position is word one of every instruction that has one. A type id
# and a value id are never the same id, so nothing but a result type can match: the
# condition operand of `OpBranchConditional` and the pointer of `OpStore` are value
# ids, and `OpTypePointer` names the bool type a word later.
fun ut_spv_is_bool_value(w: *u32, n: u32, bool_ty: u32, id: u32) bool {
    if (bool_ty == 0 || id == 0) { ret false; }
    var i: u32 = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0) { ret false; }
        if (len >= 3 && w[i + 1] == bool_ty && w[i + 2] == id) { ret true; }
        i = i + len;
    }
    ret false;
}

# how many OpFunctionCall arguments are boolean values
#
# `OpFunctionCall <result-type> <id> <callee> <args...>`, so the arguments start at
# word four. None of the fixture's callees declares a boolean parameter, so any hit
# is a boolean handed where a number is declared.
fun ut_spv_bool_call_args(w: *u32, n: u32, bool_ty: u32) u32 {
    var i: u32 = 0;
    var c: u32 = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0) { ret c; }
        if ((w[i] & 0xFFFF) == spirv.OP_FUNCTION_CALL) {
            var k: u32 = 4;
            for (k < len) {
                if (ut_spv_is_bool_value(w, n, bool_ty, w[i + k])) { c = c + 1; }
                k = k + 1;
            }
        }
        i = i + len;
    }
    ret c;
}

# how many OpReturnValue instructions return a boolean out of a non-boolean function
#
# The enclosing function's declared result type is word one of its OpFunction, so a
# function that really does return a boolean is not counted and the check stays about
# the mismatch rather than about booleans.
fun ut_spv_bool_returns(w: *u32, n: u32, bool_ty: u32) u32 {
    var i: u32 = 0;
    var c: u32 = 0;
    var fn_ret: u32 = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0) { ret c; }
        val op: u32 = w[i] & 0xFFFF;
        if (op == spirv.OP_FUNCTION) { fn_ret = w[i + 1]; }
        if (op == spirv.OP_RETURN_VALUE && fn_ret != bool_ty
            && ut_spv_is_bool_value(w, n, bool_ty, w[i + 1])) { c = c + 1; }
        i = i + len;
    }
    ret c;
}

# how many OpBranchConditional conditions are boolean values
#
# The counterpart assertion: SPIR-V requires a real `OpTypeBool` here, so this is what
# would break if a comparison were retyped as a number to settle the boundary.
fun ut_spv_bool_conditions(w: *u32, n: u32, bool_ty: u32) u32 {
    var i: u32 = 0;
    var c: u32 = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0) { ret c; }
        if ((w[i] & 0xFFFF) == spirv.OP_BRANCH_CONDITIONAL
            && ut_spv_is_bool_value(w, n, bool_ty, w[i + 1])) { c = c + 1; }
        i = i + len;
    }
    ret c;
}

# the fixture for the boundary a comparison result has to cross (#2910)
#
# Three positions, one comparison each, distinguished by nothing but where the result
# goes: into a call argument the callee declares as a byte, out of a function whose
# result is a byte, and into a conditional branch. The first two are the defect, the
# third is what must not change.
fun ut_spv_cmp_boundary_src() str {
    ret "fun mix(h: u64, b: u8) u64 { ret h * 31 + b::u64; }\n\npub fun crosses(seed: u32) u64 {\n    val x: u32 = 7 + seed;\n    ret mix(1, x == x);\n}\n\npub fun returns_cmp(seed: u32) u8 {\n    val x: u32 = 7 + seed;\n    ret x == x;\n}\n\npub fun branches(seed: u32) u64 {\n    val x: u32 = 7 + seed;\n    if (x == x) { ret 1; }\n    ret 0;\n}\n";
}

# a comparison result converts to the declared type where it crosses a call or return
# boundary, and stays a boolean where a branch consumes it (#2910)
#
# A SPIR-V comparison yields an `OpTypeBool`, which has no storage layout and so
# cannot be an argument or a return value where a byte is declared. Both of those
# positions go through the ABI pre-coloring's nominal register file, which is emitted
# at the machine word and therefore cannot type the value, so the conversion belongs
# at the use site, the first point that knows what the declaration asks for.
#
# THE BRANCH ASSERTION IS THE HALF THAT PINS THE FIX. Retyping comparisons as numbers
# would satisfy the first two counts and produce a module `spirv-val` rejects at the
# branch instead, so the test insists the same fixture still hands a real boolean to
# `OpBranchConditional`. The `OpIEqual` and `OpSelect` counts keep the zeroes honest:
# three comparisons really are in the module, and exactly the two boundary crossings
# widen.
test "mach.lang.driver:spirv_converts_a_comparison_at_a_call_boundary" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    var names: [1]str;
    var texts: [1]str;
    names[0] = "main.mach"; texts[0] = ut_spv_cmp_boundary_src();
    var dn: [1]str;
    var dt: [1]str;
    val pr: R.Result[project.Project, outcome.Fail] =
        ut_spv_lower(?s, ?alloc, ?names[0], ?texts[0], 1, "", ?dn[0], ?dt[0], 0);
    if (R.is_err[project.Project, outcome.Fail](pr)) { session.dnit(?s); ret 1; }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);

    var bad: i32 = 0;
    var img: of.ObjectImage;
    var err: str = nil;
    if (!ut_spv_codegen(?p, ?s, "spvcase.main", ?img, ?err)) {
        project.dnit_project(?p); session.dnit(?s); ret 1;
    }
    var n: u32 = 0;
    val w: *u32 = ut_spv_words(?img, ?n);
    if (w == nil) { obj.dnit(?img); project.dnit_project(?p); session.dnit(?s); ret 1; }

    val bt: u32 = ut_spv_bool_type(w, n);
    # the fixture is not degenerate: the module declares a boolean and compares three
    # times, so a zero below is a conversion rather than a missing comparison.
    if (bt == 0) { bad = 1; }
    if (ut_spv_count(w, n, spirv.OP_I_EQUAL) != 3) { bad = 1; }
    or {
        if (ut_spv_bool_call_args(w, n, bt) != 0) { bad = 1; }
        if (ut_spv_bool_returns(w, n, bt) != 0)   { bad = 1; }
        # and the branch still gets the boolean SPIR-V requires there.
        if (ut_spv_bool_conditions(w, n, bt) != 1) { bad = 1; }
        # exactly the two crossings widen, so nothing converted the branch's.
        if (ut_spv_count(w, n, spirv.OP_SELECT) != 2) { bad = 1; }
    }

    obj.dnit(?img);
    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

# a manifest carrying the two riscv members side by side, both writing ELF, so one
# fixture can be compiled at either pointer width. freestanding is the only os that
# runs riscv32 today, and `of = "elf"` overrides its "raw" default
# ---
# ret: the manifest text
fun ut_manifest_riscv_pair() str {
    ret "[project]\nid = \"uniontest\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.rv32]\nisa = \"riscv32\"\nos = \"freestanding\"\nabi = \"ilp32d\"\nof = \"elf\"\n\n[target.rv64]\nisa = \"riscv64\"\nos = \"freestanding\"\nabi = \"lp64d\"\nof = \"elf\"\n\n[artifact.uniontest]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/uniontest\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
}

# the widest absolute relocation kind attached to a named debug section of a
# codegen image
#
# Returns 8 for an RK_ABS64, 4 for an RK_ABS32, 0 when the section carries no
# absolute relocation at all (which the caller treats as a failure, so a section
# that silently stopped being relocated cannot read as a pass).
# ---
# image:   the codegen image to search
# itn:     interner resolving the section names
# section: the debug section name to look in
# ret:     8, 4, or 0
fun ut_debug_abs_width(image: *of.ObjectImage, itn: *intern.Interner, section: str) u32 {
    var sec: i32 = -1;
    var s: u32 = 0;
    for (s < image.section_count) {
        val lo: O.Option[str] = intern.lookup(itn, image.sections[s].name);
        if (O.is_some[str](lo) && str_equals(O.unwrap[str](lo), section)) { sec = s::i32; }
        s = s + 1;
    }
    if (sec < 0) { ret 0; }

    var widest: u32 = 0;
    var r: u32 = 0;
    for (r < image.reloc_count) {
        if (image.relocations[r].section == sec::u32) {
            if (image.relocations[r].kind == of.RK_ABS64) { widest = 8; }
            or (image.relocations[r].kind == of.RK_ABS32 && widest == 0) { widest = 4; }
        }
        r = r + 1;
    }
    ret widest;
}

# codegen one fixture module for a named target with debug info on, and report the
# widest absolute relocation attached to a named debug section
# ---
# target_name: the manifest target to build for
# section:     the debug section to inspect
# ret:         8, 4, or 0 (0 also covers every build failure)
fun ut_dwarf_addr_reloc_width(target_name: str, section: str) u32 {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 0; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 0; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "fun helper(x: i32) i32 { ret x + 1; }\n#[symbol(\"_start\")]\npub fun start() { val a: i32 = helper(41); }\n";
    val root_r: R.Result[str, str] = ut_scaffold_m(?alloc, ut_manifest_riscv_pair(), ?names[0], ?texts[0], 1);
    if (R.is_err[str, str](root_r)) { session.dnit(?s); ret 0; }
    val root: str = R.unwrap_ok[str, str](root_r);
    val rr: R.Result[bool, str] = driver.setup_registry(?s.registry);
    if (R.is_err[bool, str](rr)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 0; }
    val pr: R.Result[project.Project, outcome.Fail] = driver.build_project(?s, root, target_name);
    fs.remove_all(?alloc, root);
    if (R.is_err[project.Project, outcome.Fail](pr)) { session.dnit(?s); ret 0; }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);

    var width: u32 = 0;
    if (R.is_ok[bool, outcome.Fail](passes.run_sema_pass(?p))
        && R.is_ok[bool, outcome.Fail](passes.run_lower_pass(?p))) {
        val mid: session.ModuleId = ut_mid(?p, ?s, "uniontest.main");
        if (mid != session.MODULE_NIL) {
            val me: *project.ModuleEntry = ?p.modules[mid::u32];
            if (me.ir_module != nil) {
                var dbg: codegen.DebugInfo;
                dbg.emit = true;
                val pd: R.Result[intern.StrId, str] = intern.intern(?s.interner, "mach test");
                val cd: R.Result[intern.StrId, str] = intern.intern(?s.interner, root);
                if (R.is_ok[intern.StrId, str](pd) && R.is_ok[intern.StrId, str](cd)) {
                    dbg.producer = R.unwrap_ok[intern.StrId, str](pd);
                    dbg.comp_dir = R.unwrap_ok[intern.StrId, str](cd);
                    val cg: R.Result[of.ObjectImage, str] =
                        codegen.codegen_module(?s, ?p.target, me.ir_module, unit.ir_set_empty(), nil, dbg);
                    if (R.is_ok[of.ObjectImage, str](cg)) {
                        var image: of.ObjectImage = R.unwrap_ok[of.ObjectImage, str](cg);
                        width = ut_debug_abs_width(?image, ?s.interner, section);
                        obj.dnit(?image);
                    }
                }
            }
        }
    }

    project.dnit_project(?p);
    session.dnit(?s);
    ret width;
}

# every relocated DWARF address field is `address_size` bytes wide, and DWARF already
# derives `address_size` from the target pointer width - but every relocation attached
# to those fields was a hardcoded RK_ABS64, so on a 4-byte-pointer target an 8-byte
# relocation was written over a 4-byte field and corrupted whatever followed it
# (#2861). the kind now comes from `of.abs_kind_for_pointer_width`, the same call the
# data-pointer path already used, so the relocation width and the field width are one
# decision. asserted on both riscv members so the 64-bit leg proves the check is not
# vacuous
test "mach.lang.be.codegen.dwarf.produce:address_reloc_matches_pointer_width" {
    var bad: bool = false;

    # `.debug_line` carries one DW_LNE_set_address per function; `.debug_info` carries
    # each subprogram's DW_AT_low_pc. both are address-width fields.
    if (ut_dwarf_addr_reloc_width("rv64", ".debug_line") != 8) { bad = true; }
    if (ut_dwarf_addr_reloc_width("rv64", ".debug_info") != 8) { bad = true; }
    if (ut_dwarf_addr_reloc_width("rv32", ".debug_line") != 4) { bad = true; }
    if (ut_dwarf_addr_reloc_width("rv32", ".debug_info") != 4) { bad = true; }

    if (bad) { ret 1; }
    ret 0;
}

# a manifest carrying every freestanding ELF member side by side plus a linux member,
# so one fixture links on both sides of the loader-mapped question (#2895). `of =
# "elf"` overrides freestanding's "raw" default
# ---
# ret: the manifest text
fun ut_fs_elf_manifest() str {
    ret "[project]\nid = \"fself\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.fsx]\nisa = \"x86_64\"\nos = \"freestanding\"\nabi = \"sysv64\"\nof = \"elf\"\n\n[target.fsa]\nisa = \"aarch64\"\nos = \"freestanding\"\nabi = \"aapcs64\"\nof = \"elf\"\n\n[target.fsr]\nisa = \"riscv64\"\nos = \"freestanding\"\nabi = \"lp64d\"\nof = \"elf\"\n\n[target.fsr32]\nisa = \"riscv32\"\nos = \"freestanding\"\nabi = \"ilp32d\"\nof = \"elf\"\n\n[target.lx]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[profile.debug]\nopt = 0\ndebug = false\nsimd = \"scalarize\"\n\n[artifact.fself]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/fself\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
}

# the fixture: an entry symbol reaching a read-only table and mutable globals, so the
# link produces text, rodata, data and bss rather than one segment
# ---
# ret: the module source
fun ut_fs_elf_src() str {
    ret "val table: [4]u32 = [4]u32{11, 22, 33, 44};\nvar counter: u32 = 0;\nvar scratch: [16]u32;\n#[symbol(\"_start\")]\npub fun start() {\n    var i: u32 = 0;\n    for (i < 4) {\n        counter = counter + table[i];\n        scratch[i] = counter;\n        i = i + 1;\n    }\n}\n";
}

# one PT_LOAD of a linked image, in the fields the header-segment assertions read
rec UtLoadSeg {
    off:    u64;
    vaddr:  u64;
    filesz: u64;
}

# little-endian scalar reads over a linked image's bytes
fun ut_le16(b: *u8, off: usize) u64 {
    ret b[off]::u64 | (b[off + 1]::u64 << 8);
}

fun ut_le32(b: *u8, off: usize) u64 {
    ret b[off]::u64 | (b[off + 1]::u64 << 8) | (b[off + 2]::u64 << 16) | (b[off + 3]::u64 << 24);
}

fun ut_le64(b: *u8, off: usize) u64 {
    ret ut_le32(b, off) | (ut_le32(b, off + 4) << 32);
}

# collect every PT_LOAD out of a linked ELF image, at either class
#
# Reads the class byte and takes every field offset from it, so an ELF32 image is read
# as ELF32 rather than through 64-bit offsets that would land in the wrong bytes.
# ---
# img:       the linked image bytes
# segs:      out - the PT_LOADs, in program-header order
# cap:       capacity of segs
# entry_out: out - the image entry address
# ret:       number of PT_LOADs written to segs
fun ut_elf_loads(img: *Vector[u8], segs: *UtLoadSeg, cap: u32, entry_out: *u64) u32 {
    if (img.len < 64) { ret 0; }
    val b: *u8 = img.data;
    val elf32: bool = b[4] == 1;

    var phoff:     u64 = 0;
    var phentsize: u64 = 0;
    var phnum:     u64 = 0;
    if (elf32) {
        @entry_out = ut_le32(b, 24);
        phoff      = ut_le32(b, 28);
        phentsize  = ut_le16(b, 42);
        phnum      = ut_le16(b, 44);
    }
    or {
        @entry_out = ut_le64(b, 24);
        phoff      = ut_le64(b, 32);
        phentsize  = ut_le16(b, 54);
        phnum      = ut_le16(b, 56);
    }

    var n: u32 = 0;
    var i: u64 = 0;
    for (i < phnum && n < cap) {
        val p: usize = (phoff + i * phentsize)::usize;
        if (p + phentsize::usize > img.len) { ret n; }
        if (ut_le32(b, p) == 1) {
            if (elf32) {
                segs[n].off    = ut_le32(b, p + 4);
                segs[n].vaddr  = ut_le32(b, p + 8);
                segs[n].filesz = ut_le32(b, p + 16);
            }
            or {
                segs[n].off    = ut_le64(b, p + 8);
                segs[n].vaddr  = ut_le64(b, p + 16);
                segs[n].filesz = ut_le64(b, p + 32);
            }
            n = n + 1;
        }
        i = i + 1;
    }
    ret n;
}

# link a built project's codegen images into an executable and hand back its bytes
#
# The link is the shipping one - `linker.link_images`, the same call `mach build` makes
# - so the writer under test is reached through the code that reaches it in a real
# build, image options and all.
# ---
# p:    the built project, after codegen
# root: the scaffold root the image is written into
# out:  out - the image bytes, owned by the caller
# ret:  true when the link succeeded and the image was read back
fun ut_link_exe_image(p: *project.Project, root: str, out: *Vector[u8]) bool {
    val alloc: *A.Allocator = p.alloc;
    if (p.emit_len == 0) { ret false; }

    val ir: R.Result[*of.ObjectImage, str] = A.allocate[of.ObjectImage](alloc, p.emit_len::usize);
    if (R.is_err[*of.ObjectImage, str](ir)) { ret false; }
    val images: *of.ObjectImage = R.unwrap_ok[*of.ObjectImage, str](ir);
    var missing: bool = false;
    var i: u32 = 0;
    for (i < p.emit_len) {
        val m: *project.ModuleEntry = ?p.modules[(p.topo[i])::u32];
        if (m.object_image == nil) { missing = true; }
        or                         { images[i] = @m.object_image; }
        i = i + 1;
    }

    var linked: bool = false;
    val path: str = ut_cc3(alloc, root, "/", "image.elf");
    if (!missing) {
        val lr: R.Result[bool, str] = linker.link_images(p.s, ?p.target, images, p.emit_len,
            nil::*of.DynLib, 0, path::*u8, "fself"::*u8, linker.LINK_EXE, false,
            of.image_options_default(of.SUBSYSTEM_CONSOLE));
        linked = R.is_ok[bool, str](lr);
    }
    A.deallocate[of.ObjectImage](alloc, images, p.emit_len::usize);
    if (!linked) { ret false; }

    val br: R.Result[Vector[u8], str] = fs.read_bytes(alloc, path);
    if (R.is_err[Vector[u8], str](br)) { ret false; }
    @out = R.unwrap_ok[Vector[u8], str](br);
    ret true;
}

# build the fixture for `target_name` and link it into an ELF image
# ---
# alloc:       allocator owning the returned bytes
# target_name: the manifest target to build for
# out:         out - the image bytes
# ret:         true when the build and the link both succeeded
fun ut_fs_elf_image(alloc: *A.Allocator, target_name: str, out: *Vector[u8]) bool {
    val sr: R.Result[session.Session, str] = session.init(alloc);
    if (R.is_err[session.Session, str](sr)) { ret false; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = ut_fs_elf_src();
    val root_r: R.Result[str, str] = ut_scaffold_m(alloc, ut_fs_elf_manifest(), ?names[0], ?texts[0], 1);
    if (R.is_err[str, str](root_r)) { session.dnit(?s); ret false; }
    val root: str = R.unwrap_ok[str, str](root_r);

    var ok: bool = false;
    val rr: R.Result[bool, str] = driver.setup_registry(?s.registry);
    if (R.is_ok[bool, str](rr)) {
        val pr: R.Result[project.Project, outcome.Fail] = driver.build_project(?s, root, target_name);
        if (R.is_ok[project.Project, outcome.Fail](pr)) {
            var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);
            if (ut_run_codegen_ok(?p) == 0) { ok = ut_link_exe_image(?p, root, out); }
            project.dnit_project(?p);
        }
    }
    fs.remove_all(alloc, root);
    session.dnit(?s);
    ret ok;
}

# the ceiling a bare-metal segment address must stay under. the fixture links at base
# address 0 and is a few hundred bytes, so anything at or above a megabyte is an address
# no segment was placed at deliberately - in particular the 0xFFFFFFFFFFFFFFFF a header
# segment framed a page below zero carries
val UT_FS_VADDR_CEIL: u64 = 0x100000;

# every PT_LOAD of a bare-metal image maps real content at a real address
# ---
# alloc:       allocator for the image bytes
# target_name: the freestanding manifest target to check
# ret:         true when the image links and every segment holds
fun ut_fs_elf_unmapped_header(alloc: *A.Allocator, target_name: str) bool {
    var img: Vector[u8];
    if (!ut_fs_elf_image(alloc, target_name, ?img)) { ret false; }

    var segs: [16]UtLoadSeg;
    var entry: u64 = 0;
    val n: u32 = ut_elf_loads(?img, ?segs[0], 16, ?entry);

    var ok: bool = n > 0;
    var covers_entry: bool = false;
    var i: u32 = 0;
    for (i < n) {
        # a segment at file offset 0 covers the header block, which is the thing an
        # image with no loader must not map.
        if (segs[i].off == 0)                            { ok = false; }
        if (segs[i].vaddr >= UT_FS_VADDR_CEIL)           { ok = false; }
        if (segs[i].off + segs[i].filesz > img.len::u64) { ok = false; }
        if (entry >= segs[i].vaddr && entry < segs[i].vaddr + segs[i].filesz) { covers_entry = true; }
        i = i + 1;
    }
    if (!covers_entry) { ok = false; }

    vector.dnit[u8](?img);
    ret ok;
}

# a loader-mapped image still maps its header block, one page below its first content
# segment - the counterfactual arm, so a fix that dropped the header segment everywhere
# could not read as a pass
# ---
# alloc: allocator for the image bytes
# ret:   true when the linux image carries exactly one header segment, correctly placed
fun ut_linux_elf_maps_header(alloc: *A.Allocator) bool {
    var img: Vector[u8];
    if (!ut_fs_elf_image(alloc, "lx", ?img)) { ret false; }

    var segs: [16]UtLoadSeg;
    var entry: u64 = 0;
    val n: u32 = ut_elf_loads(?img, ?segs[0], 16, ?entry);

    var headers: u32 = 0;
    var content: u32 = 0;
    var ok: bool = n > 1;
    var i: u32 = 0;
    for (i < n) {
        if (segs[i].off == 0) {
            headers = headers + 1;
            if (segs[i].vaddr != oslinux.LINUX_BASE_ADDR - oslinux.LINUX_PAGE_SIZE) { ok = false; }
        }
        or {
            content = content + 1;
            if (segs[i].vaddr < oslinux.LINUX_BASE_ADDR) { ok = false; }
        }
        i = i + 1;
    }
    if (headers != 1 || content == 0) { ok = false; }

    vector.dnit[u8](?img);
    ret ok;
}

# a freestanding target selecting `of = "elf"` links, on every architecture, and the
# image it produces is well formed (#2895)
#
# WHAT WAS BROKEN. `os = "freestanding"` declares `page_size = 1` deliberately - bare
# metal has no paging, so segments need no alignment - and the ELF writer read that
# length as the size of the one-page reservation the header block must fit inside, so
# `64 + n*56 <= 1` refused every image on every architecture. Behind that refusal sat a
# second fault: `header_segment_vaddr` frames the header block a page BELOW segment 0,
# which at base address 0 is `0 - 1`, an underflow to the top of the address space. A
# fix that only relaxed the check would have traded a loud link error for a silently
# malformed image, so these assertions check the addresses rather than that a file
# appeared.
#
# WHY THERE IS NO HEADER SEGMENT TO PLACE. The leading PT_LOAD covering the ELF header
# and the program-header table exists so a LOADER can read the program headers out of
# memory. Bare metal has no loader: the reset vector enters at the entry point and
# nothing parses a header at run time. So the header block stays file metadata, which is
# also the only shape available at base address 0, where there is nothing below segment
# 0 to map it in.
#
# THE LINUX ARM IS NOT DECORATION. It is what stops this passing for the wrong reason:
# an image that dropped the header segment everywhere would satisfy every bare-metal
# assertion here, and only the linux arm notices.
test "mach.lang.driver:freestanding_elf_links_with_no_header_segment" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }

    var bad: bool = false;
    if (!ut_fs_elf_unmapped_header(?alloc, "fsx"))   { bad = true; }
    if (!ut_fs_elf_unmapped_header(?alloc, "fsa"))   { bad = true; }
    if (!ut_fs_elf_unmapped_header(?alloc, "fsr"))   { bad = true; }
    if (!ut_fs_elf_unmapped_header(?alloc, "fsr32")) { bad = true; }
    if (!ut_linux_elf_maps_header(?alloc))           { bad = true; }

    if (bad) { ret 1; }
    ret 0;
}

# the shader both assertions below read: two locals holding the same four values,
# one filled by an array literal initializer and one element by element
#
# The weights are positional, so a copy that permutes, truncates or drops elements
# reads back a different number rather than the same total.
fun ut_spv_array_init_src() str {
    ret "#[output(0)] var o_lit: u32;\n#[output(1)] var o_elem: u32;\n\n#[stage(\"vertex\")]\nfun vs() {\n    val lit: [4]u32 = [4]u32{7, 6, 5, 4};\n    var elem: [4]u32;\n    elem[0] = 7; elem[1] = 6; elem[2] = 5; elem[3] = 4;\n    o_lit  = lit[0]  + lit[1]  * 10 + lit[2]  * 100 + lit[3]  * 1000;\n    o_elem = elem[0] + elem[1] * 10 + elem[2] * 100 + elem[3] * 1000;\n}\n\nfun main() i32 { ret 0; }\n";
}

# an array literal initializer on a function-local array reaches the local, with the
# elements it was written with (#2911)
#
# WHAT WAS BROKEN. The initializer lowers to a temporary filled element by element
# and then an aggregate store into the declared local, and that store expanded into
# a run of word-sized load / store pairs walking the two objects by byte offset.
# Under logical addressing there is no pointer INTO an object, so the run was
# refused outright for an array and - worse - accepted for a two-word record, whose
# single 8-byte chunk resolved to the variable itself and produced a load at the
# wrong type. The copy now reaches the emitter whole, which spells it as one load
# and one store of the object's own value.
#
# THE ELEMENT-WISE ARM IS THE CONTROL, and it is the arm that already worked. Both
# locals hold the same four values in the same order, so both locations must read
# back the same number; asserting the literal arm alone would pass just as well if
# the whole fixture were mis-evaluated, and asserting that a copy instruction is
# present would pass on a copy that moved the wrong bytes.
test "mach.lang.driver:an_array_literal_initializer_reaches_a_local_on_spirv" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    var names: [1]str;
    var texts: [1]str;
    names[0] = "main.mach"; texts[0] = ut_spv_array_init_src();
    val pr: R.Result[project.Project, outcome.Fail] = ut_spv_lower(?s, ?alloc, ?names[0], ?texts[0], 1, "", nil, nil, 0);
    if (R.is_err[project.Project, outcome.Fail](pr)) { session.dnit(?s); ret 1; }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);

    var img: of.ObjectImage;
    var err: str = nil;
    if (!ut_spv_codegen(?p, ?s, "spvcase.main", ?img, ?err)) {
        project.dnit_project(?p); session.dnit(?s); ret 1;
    }
    var bad: i32 = 0;
    # 7 + 6*10 + 5*100 + 4*1000, the elements in their declared positions.
    if (ut_spv_read_location(?alloc, ?img, 0) != 4567) { bad = 1; }
    if (ut_spv_read_location(?alloc, ?img, 1) != 4567) { bad = 1; }

    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

# count, over a lowered MIR module, the whole-object copies and the byte-chunked
# loads the flat expansion of one produces
# ---
# mm:        the lowered MIR module
# out_loads: receives the number of MIR_LOAD instructions
# ret:       the number of MIR_MEMCPY instructions
fun ut_memcpy_and_loads(mm: *mir.MirModule, out_loads: *u32) u32 {
    var mc: u32 = 0;
    var ld: u32 = 0;
    var fi: u32 = 0;
    for (fi < mm.function_len) {
        val mf: *mir.MirFunction = ?mm.functions[fi];
        var bi: u32 = 0;
        for (bi < mf.block_count) {
            val blk: *mir.MirBlock = ?mf.blocks[bi];
            var ii: u32 = 0;
            for (ii < blk.instr_count) {
                if (blk.instrs[ii].opcode == mir.MIR_MEMCPY) { mc = mc + 1; }
                if (blk.instrs[ii].opcode == mir.MIR_LOAD)   { ld = ld + 1; }
                ii = ii + 1;
            }
            bi = bi + 1;
        }
        fi = fi + 1;
    }
    @out_loads = ld;
    ret mc;
}

# lower `src` for `tname` to MIR and report (memcpy count, load count)
fun ut_memcpy_shape(alloc: *A.Allocator, src: str, tname: str, out_loads: *u32) i64 {
    val sr: R.Result[session.Session, str] = session.init(alloc);
    if (R.is_err[session.Session, str](sr)) { ret -1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    val pr: R.Result[project.Project, outcome.Fail] = ut_vec_lower(?s, alloc, src, tname);
    if (R.is_err[project.Project, outcome.Fail](pr)) { session.dnit(?s); ret -1; }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);
    var out: i64 = -1;
    var loads: u32 = 0;
    var mi: u32 = 0;
    for (mi < p.module_len) {
        val me: *project.ModuleEntry = ?p.modules[mi];
        if (me.ir_module == nil) { mi = mi + 1; cnt; }
        val mr: R.Result[mir.MirModule, str] = mirlower.lower_ir(?p.target, me.ir_module, alloc, ?s.interner, ?s.sources);
        if (R.is_err[mir.MirModule, str](mr)) { mi = mi + 1; cnt; }
        var mm: mir.MirModule = R.unwrap_ok[mir.MirModule, str](mr);
        var lc: u32 = 0;
        val c: u32 = ut_memcpy_and_loads(?mm, ?lc);
        if (out < 0) { out = 0; }
        out = out + c::i64;
        loads = loads + lc;
        mi = mi + 1;
    }
    @out_loads = loads;
    project.dnit_project(?p);
    session.dnit(?s);
    ret out;
}

# an aggregate store stays a whole-object copy on a logical-addressing target and
# still expands into the byte-chunked run on a flat one (#2911)
#
# THE MACHINE TARGETS ARE THE HALF THAT MATTERS HERE. The gate exists so the flat
# expansion is untouched, and a fix applied one level too high - rewriting the
# initializer for everyone - moves their numbers too. So both sides are asserted:
# spirv carries the copy whole, while every flat target carries no copy instruction
# at all and still issues the chunk loads that ARE its copy. Dropping the gate, or
# gating it the wrong way round, moves one of the two.
test "mach.lang.driver:an_aggregate_copy_survives_whole_on_logical_addressing" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val src: str = ut_spv_array_init_src();
    val nsrc: str = "fun rd() u32 {\n    val lit: [4]u32 = [4]u32{7, 6, 5, 4};\n    ret lit[0] + lit[1] * 10 + lit[2] * 100 + lit[3] * 1000;\n}\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret rd()::i32; }\n";

    var bad: i32 = 0;

    var sl: u32 = 0;
    if (ut_memcpy_shape(?alloc, src, "spirv", ?sl) < 1) { bad = 1; }

    var fl: u32 = 0;
    if (ut_memcpy_shape(?alloc, nsrc, "linux", ?fl)         != 0) { bad = 1; }
    if (fl < 2) { bad = 1; }
    if (ut_memcpy_shape(?alloc, nsrc, "linux-arm64", ?fl)   != 0) { bad = 1; }
    if (fl < 2) { bad = 1; }
    if (ut_memcpy_shape(?alloc, nsrc, "linux-riscv64", ?fl) != 0) { bad = 1; }
    if (fl < 2) { bad = 1; }

    ret bad;
}

# opaque unit multipliers for the float-to-unsigned case: reading a mutable global
# keeps the conversion source out of reach of constant folding, so the value is
# produced by the backend's convert rather than by the frontend
var ut_fp2u_one:  f64 = 1.0;
var ut_fp2u_onef: f32 = 1.0;

# `::` from a float to an unsigned integer must be value-preserving across the whole
# destination range (#2909). x86-64 has no unsigned truncating convert, so SSE2's
# signed CVTTSS/SD2SI was selected directly and returned the integer-indefinite value
# for every source at or above 2^31 (`::u32`) or 2^63 (`::u64`) - silently, since the
# indefinite value is a plausible-looking number.
#
# THE BOUNDARY ITSELF IS NOT COVERAGE. At exactly 2^31 and exactly 2^63 the
# indefinite value equals the correct answer, so the 2^63 row below is a positive
# control and nothing more; the rows that fail without the fix are the ones STRICTLY
# ABOVE the boundary. The below-boundary rows are the other control: they were
# correct before the fix and must stay correct, which is what separates a real
# conversion from one that now merely biases everything.
#
# every source is exactly representable in its own float width, so each expected
# value is the one true answer and not a rounding choice. this runs wherever the
# suite runs, so it holds the aarch64 and riscv64 selections to the same result
test "mach.lang.driver:float_to_unsigned_spans_the_whole_destination_range" {
    val one:  f64 = ut_fp2u_one;
    val onef: f32 = ut_fp2u_onef;
    var bad: bool = false;

    # controls: below the signed boundary, correct before the fix and after it.
    if ((2147483647.0 * one)::u32 != 2147483647)                    { bad = true; }
    if ((2147483520.0::f32 * onef)::u32 != 2147483520)              { bad = true; }
    if ((1.0e18 * one)::u64 != 1000000000000000000)                 { bad = true; }
    if ((1099511627776.0::f32 * onef)::u64 != 1099511627776)        { bad = true; }

    # positive controls at the boundary, where the indefinite value happens to agree.
    if ((2147483648.0 * one)::u32 != 2147483648)                    { bad = true; }
    if ((9223372036854775808.0 * one)::u64 != (1::u64 << 63))       { bad = true; }
    if ((9223372036854775808.0::f32 * onef)::u64 != (1::u64 << 63)) { bad = true; }

    # strictly above the boundary: the whole of what was wrong.
    if ((3000000000.0 * one)::u32 != 3000000000)                    { bad = true; }
    if ((4294967295.0 * one)::u32 != 4294967295)                    { bad = true; }
    if ((3000000000.0::f32 * onef)::u32 != 3000000000)              { bad = true; }
    if ((4294967040.0::f32 * onef)::u32 != 4294967040)              { bad = true; }

    if ((1.0e19 * one)::u64 != 1000000000::u64 * 10000000000::u64)  { bad = true; }
    if ((18446744073709549568.0 * one)::u64 != ~(2047::u64))        { bad = true; }
    if ((9223373136366403584.0::f32 * onef)::u64
        != (1::u64 << 63) + (1::u64 << 40))                         { bad = true; }
    if ((18446742974197923840.0::f32 * onef)::u64
        != ~((1::u64 << 40) - 1))                                   { bad = true; }

    # sub-word unsigned destinations ride the same 64-bit convert.
    if ((250.0 * one)::u8 != 250)                                   { bad = true; }
    if ((65535.0 * one)::u16 != 65535)                              { bad = true; }

    if (bad) { ret 1; }
    ret 0;
}

# the id, per-object and call-depth capacities of the SPIR-V evaluator below
#
# A fixture module binds a few hundred ids, no object in one is wider than a
# handful of words, and no helper calls another, so each is slack rather than a
# limit. A module past any of them FAILS the evaluation rather than aliasing an
# object or silently truncating one.
val UT_AGG_IDS:     u32 = 1024;
val UT_AGG_WORDS:   u32 = 16;
val UT_AGG_MEMBERS: u32 = 8;
val UT_AGG_DEPTH:   u32 = 4;

# the evaluator answers with this when the module is outside what it models
#
# A value no fixture computes, returned by every arm that cannot proceed, so an
# assertion against an expected number can never be satisfied by an evaluation that
# quietly gave up.
val UT_AGG_BAD: u64 = 0xFFFFFFFFFFFFFFFF;

# the type kinds the evaluator's object model distinguishes
#
# The whole model, and it is a model of LAYOUT rather than of types: a scalar is one
# word, a vector or array is `mcnt` members of one element type, and a struct is its
# member list. That is exactly what is needed to say where a member of an object
# sits, which is what an access chain asks and what a whole-object copy has to get
# right.
val UT_AGG_TY_NONE:   u8 = 0;
val UT_AGG_TY_SCALAR: u8 = 1;
val UT_AGG_TY_SEQ:    u8 = 2;
val UT_AGG_TY_STRUCT: u8 = 3;
val UT_AGG_TY_PTR:    u8 = 4;

# the evaluator's state: a layout table, an object pool, and the pointers into it
#
# Every id owns one `UT_AGG_WORDS`-word block. A scalar uses its first word, a
# composite value uses as many words as its type has, and a variable's block IS its
# storage - so a pointer is a (block, word offset, pointee type) triple and a
# whole-object load or store is a word run of the pointee type's own length.
rec UtAggEval {
    ty_kind:  [1024]u8;
    ty_words: [1024]u32;
    ty_bits:  [1024]u32;
    ty_elem:  [1024]u32;
    ty_mcnt:  [1024]u32;
    ty_mem:   [8192]u32;
    val:      [16384]u64;
    val_ty:   [1024]u32;
    is_ptr:   [1024]bool;
    ptr_blk:  [1024]u32;
    ptr_off:  [1024]u32;
    ptr_ty:   [1024]u32;
    fn_at:    [1024]u32;
}

# clear the evaluator state
#
# The allocation is not zeroed, and a stale id would read as a bound object rather
# than as an unset one, which is the difference between a wrong answer and a
# refused evaluation.
fun ut_agg_reset(st: *UtAggEval) {
    var i: u32 = 0;
    for (i < UT_AGG_IDS) {
        st.ty_kind[i] = UT_AGG_TY_NONE;
        st.ty_words[i] = 0;
        st.ty_bits[i] = 0;
        st.ty_elem[i] = 0;
        st.ty_mcnt[i] = 0;
        st.val_ty[i] = 0;
        st.is_ptr[i] = false;
        st.ptr_blk[i] = 0;
        st.ptr_off[i] = 0;
        st.ptr_ty[i] = 0;
        st.fn_at[i] = 0;
        i = i + 1;
    }
    i = 0;
    for (i < UT_AGG_IDS * UT_AGG_MEMBERS) { st.ty_mem[i] = 0; i = i + 1; }
    i = 0;
    for (i < UT_AGG_IDS * UT_AGG_WORDS) { st.val[i] = 0; i = i + 1; }
}

# where member `k` of type `ty` sits, and what type it is
# ---
# st:      the evaluator state
# ty:      the composite type
# k:       the member ordinal
# out_off: receives the member's word offset within the object
# out_ty:  receives the member's type
# ret:     false when `ty` has no member `k`
fun ut_agg_member(st: *UtAggEval, ty: u32, k: u32, out_off: *u32, out_ty: *u32) bool {
    if (ty >= UT_AGG_IDS || k >= st.ty_mcnt[ty]) { ret false; }
    if (st.ty_kind[ty] == UT_AGG_TY_SEQ) {
        @out_off = k * st.ty_words[st.ty_elem[ty]];
        @out_ty  = st.ty_elem[ty];
        ret true;
    }
    if (st.ty_kind[ty] == UT_AGG_TY_STRUCT) {
        var off: u32 = 0;
        var j: u32 = 0;
        for (j < k) { off = off + st.ty_words[st.ty_mem[ty * UT_AGG_MEMBERS + j]]; j = j + 1; }
        @out_off = off;
        @out_ty  = st.ty_mem[ty * UT_AGG_MEMBERS + k];
        ret true;
    }
    ret false;
}

# copy `words` words between two object blocks
fun ut_agg_copy(st: *UtAggEval, dblk: u32, doff: u32, sblk: u32, soff: u32, words: u32) bool {
    if (words == 0 || dblk >= UT_AGG_IDS || sblk >= UT_AGG_IDS) { ret false; }
    if (doff + words > UT_AGG_WORDS || soff + words > UT_AGG_WORDS) { ret false; }
    var k: u32 = 0;
    for (k < words) {
        st.val[dblk * UT_AGG_WORDS + doff + k] = st.val[sblk * UT_AGG_WORDS + soff + k];
        k = k + 1;
    }
    ret true;
}

# narrow a computed value to its result type's width
fun ut_agg_mask(st: *UtAggEval, ty: u32, v: u64) u64 {
    if (ty >= UT_AGG_IDS) { ret v; }
    val bits: u32 = st.ty_bits[ty];
    if (bits == 0 || bits >= 64) { ret v; }
    ret v & ((1::u64 << bits::u64) - 1);
}

# read the type, constant and function tables out of the module
#
# One forward pass, which is all SPIR-V needs: a type or constant is declared
# before anything names it, so an array's length constant and a struct's member
# types are already sized by the time the aggregate that uses them is reached.
# ---
# st:   the evaluator state
# w, n: the instruction words, header already skipped
# ret:  false when the module is outside the model's capacities
fun ut_agg_prepare(st: *UtAggEval, w: *u32, n: u32) bool {
    var i: u32 = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0) { ret false; }
        val op: u32 = w[i] & 0xFFFF;

        if (op == spirv.OP_TYPE_VOID || op == spirv.OP_TYPE_BOOL) {
            val r: u32 = w[i + 1];
            if (r >= UT_AGG_IDS) { ret false; }
            st.ty_kind[r] = UT_AGG_TY_SCALAR; st.ty_words[r] = 1; st.ty_bits[r] = 32;
        }
        or (op == spirv.OP_TYPE_INT || op == spirv.OP_TYPE_FLOAT) {
            val r: u32 = w[i + 1];
            if (r >= UT_AGG_IDS) { ret false; }
            st.ty_kind[r] = UT_AGG_TY_SCALAR; st.ty_words[r] = 1; st.ty_bits[r] = w[i + 2];
        }
        or (op == spirv.OP_TYPE_VECTOR || op == spirv.OP_TYPE_ARRAY) {
            val r: u32 = w[i + 1];
            val e: u32 = w[i + 2];
            if (r >= UT_AGG_IDS || e >= UT_AGG_IDS) { ret false; }
            var cnt: u32 = w[i + 3];
            # a vector states its lane count directly, an array names a constant
            if (op == spirv.OP_TYPE_ARRAY) {
                if (cnt >= UT_AGG_IDS) { ret false; }
                cnt = st.val[cnt * UT_AGG_WORDS]::u32;
            }
            if (cnt == 0 || cnt > UT_AGG_WORDS) { ret false; }
            st.ty_kind[r] = UT_AGG_TY_SEQ;
            st.ty_elem[r] = e;
            st.ty_mcnt[r] = cnt;
            st.ty_words[r] = cnt * st.ty_words[e];
        }
        or (op == spirv.OP_TYPE_STRUCT) {
            val r: u32 = w[i + 1];
            val m: u32 = len - 2;
            if (r >= UT_AGG_IDS || m == 0 || m > UT_AGG_MEMBERS) { ret false; }
            var words: u32 = 0;
            var k: u32 = 0;
            for (k < m) {
                val mt: u32 = w[i + 2 + k];
                if (mt >= UT_AGG_IDS || st.ty_words[mt] == 0) { ret false; }
                st.ty_mem[r * UT_AGG_MEMBERS + k] = mt;
                words = words + st.ty_words[mt];
                k = k + 1;
            }
            if (words > UT_AGG_WORDS) { ret false; }
            st.ty_kind[r] = UT_AGG_TY_STRUCT;
            st.ty_mcnt[r] = m;
            st.ty_words[r] = words;
        }
        or (op == spirv.OP_TYPE_POINTER) {
            val r: u32 = w[i + 1];
            if (r >= UT_AGG_IDS || w[i + 3] >= UT_AGG_IDS) { ret false; }
            st.ty_kind[r] = UT_AGG_TY_PTR;
            st.ty_elem[r] = w[i + 3];
            st.ty_words[r] = 1;
        }
        or (op == spirv.OP_CONSTANT) {
            val r: u32 = w[i + 2];
            if (r >= UT_AGG_IDS || len < 4) { ret false; }
            var v: u64 = w[i + 3]::u64;
            if (len >= 5) { v = v | (w[i + 4]::u64 << 32); }
            st.val[r * UT_AGG_WORDS] = v;
            st.val_ty[r] = w[i + 1];
        }
        or (op == spirv.OP_CONSTANT_NULL) {
            val t: u32 = w[i + 1];
            val r: u32 = w[i + 2];
            if (r >= UT_AGG_IDS || t >= UT_AGG_IDS || st.ty_words[t] > UT_AGG_WORDS) { ret false; }
            var k: u32 = 0;
            for (k < st.ty_words[t]) { st.val[r * UT_AGG_WORDS + k] = 0; k = k + 1; }
            st.val_ty[r] = t;
        }
        or (op == spirv.OP_CONSTANT_COMPOSITE) {
            val t: u32 = w[i + 1];
            val r: u32 = w[i + 2];
            if (r >= UT_AGG_IDS || t >= UT_AGG_IDS) { ret false; }
            var off: u32 = 0;
            var k: u32 = 0;
            for (k < len - 3) {
                val c: u32 = w[i + 3 + k];
                if (c >= UT_AGG_IDS || st.val_ty[c] == 0) { ret false; }
                val cw: u32 = st.ty_words[st.val_ty[c]];
                if (!ut_agg_copy(st, r, off, c, 0, cw)) { ret false; }
                off = off + cw;
                k = k + 1;
            }
            st.val_ty[r] = t;
        }
        or (op == spirv.OP_VARIABLE) {
            val pt: u32 = w[i + 1];
            val r:  u32 = w[i + 2];
            if (r >= UT_AGG_IDS || pt >= UT_AGG_IDS || st.ty_kind[pt] != UT_AGG_TY_PTR) { ret false; }
            st.is_ptr[r]  = true;
            st.ptr_blk[r] = r;
            st.ptr_off[r] = 0;
            st.ptr_ty[r]  = st.ty_elem[pt];
        }
        or (op == spirv.OP_FUNCTION) {
            val r: u32 = w[i + 2];
            if (r >= UT_AGG_IDS) { ret false; }
            st.fn_at[r] = i;
        }

        i = i + len;
    }
    ret true;
}

# the id of the interface variable decorated `Location loc`, or 0
fun ut_agg_location_var(w: *u32, n: u32, loc: u32) u32 {
    var i: u32 = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0) { ret 0; }
        if ((w[i] & 0xFFFF) == spirv.OP_DECORATE && len == 4
            && w[i + 2] == spirv.DECOR_LOCATION && w[i + 3] == loc) { ret w[i + 1]; }
        i = i + len;
    }
    ret 0;
}

# the id of the module's first entry-point function, or 0
fun ut_agg_entry_fn(w: *u32, n: u32) u32 {
    var i: u32 = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0) { ret 0; }
        if ((w[i] & 0xFFFF) == spirv.OP_ENTRY_POINT && len >= 4) { ret w[i + 2]; }
        i = i + len;
    }
    ret 0;
}

# the word index of a function's first body instruction, past its parameters
fun ut_agg_body_start(st: *UtAggEval, w: *u32, n: u32, fn: u32) u32 {
    if (fn >= UT_AGG_IDS || st.fn_at[fn] == 0) { ret 0; }
    var i: u32 = st.fn_at[fn];
    i = i + (w[i] >> 16);
    for (i < n) {
        if ((w[i] & 0xFFFF) != spirv.OP_FUNCTION_PARAMETER) { ret i; }
        i = i + (w[i] >> 16);
    }
    ret 0;
}

# bind a callee's parameters to a call's arguments, each as a whole object
#
# THE ONE PLACE A BY-VALUE AGGREGATE ARGUMENT IS OBSERVED. The parameter takes as
# many words as its own declared type has, so an argument that arrived permuted or
# truncated reads back a different number at the other end rather than being
# repaired here.
# ---
# st:        the evaluator state
# w, n:      the instruction words
# fn:        the callee
# arg_first: the word index of the call's first argument operand
# argc:      the number of argument operands
# ret:       false unless every declared parameter took exactly one argument
fun ut_agg_bind_params(st: *UtAggEval, w: *u32, n: u32, fn: u32, arg_first: u32, argc: u32) bool {
    if (fn >= UT_AGG_IDS || st.fn_at[fn] == 0) { ret false; }
    var i: u32 = st.fn_at[fn];
    i = i + (w[i] >> 16);
    var k: u32 = 0;
    for (i < n) {
        if ((w[i] & 0xFFFF) != spirv.OP_FUNCTION_PARAMETER) { ret k == argc; }
        if (k >= argc) { ret false; }
        val pty: u32 = w[i + 1];
        val pid: u32 = w[i + 2];
        val aid: u32 = w[arg_first + k];
        if (pty >= UT_AGG_IDS || pid >= UT_AGG_IDS || aid >= UT_AGG_IDS) { ret false; }
        if (!ut_agg_copy(st, pid, 0, aid, 0, st.ty_words[pty])) { ret false; }
        st.val_ty[pid] = pty;
        k = k + 1;
        i = i + (w[i] >> 16);
    }
    ret false;
}

# run the entry point's body, following every call it makes
#
# ANY INSTRUCTION IT DOES NOT MODEL FAILS THE EVALUATION. The set below is what the
# fixtures emit and nothing more, so an emitter change that routes an argument or a
# return through some other instruction is REPORTED rather than skipped - which is
# what would otherwise let a read-back keep answering out of a stale store.
# ---
# st:    the evaluator state
# w, n:  the instruction words
# entry: the entry-point function
# ret:   true when the body ran to its return
fun ut_agg_exec(st: *UtAggEval, w: *u32, n: u32, entry: u32) bool {
    var i: u32 = ut_agg_body_start(st, w, n, entry);
    if (i == 0) { ret false; }

    var sp:    u32 = 0;
    var r_ix:  [4]u32;
    var r_res: [4]u32;
    var r_ty:  [4]u32;
    var steps: u32 = 0;

    for (i < n) {
        steps = steps + 1;
        if (steps > 100000) { ret false; }
        val len: u32 = w[i] >> 16;
        if (len == 0) { ret false; }
        val op: u32 = w[i] & 0xFFFF;

        # a label opens the block and a variable was already bound in the type pass.
        if (op == spirv.OP_LABEL || op == spirv.OP_VARIABLE) { i = i + len; cnt; }

        if (op == spirv.OP_ACCESS_CHAIN) {
            val res:  u32 = w[i + 2];
            val base: u32 = w[i + 3];
            if (res >= UT_AGG_IDS || base >= UT_AGG_IDS || !st.is_ptr[base]) { ret false; }
            var cur_off: u32 = st.ptr_off[base];
            var cur_ty:  u32 = st.ptr_ty[base];
            var k: u32 = 0;
            for (k < len - 4) {
                val ixid: u32 = w[i + 4 + k];
                if (ixid >= UT_AGG_IDS) { ret false; }
                var moff: u32 = 0;
                var mty:  u32 = 0;
                if (!ut_agg_member(st, cur_ty, st.val[ixid * UT_AGG_WORDS]::u32, ?moff, ?mty)) { ret false; }
                cur_off = cur_off + moff;
                cur_ty  = mty;
                k = k + 1;
            }
            st.is_ptr[res]  = true;
            st.ptr_blk[res] = st.ptr_blk[base];
            st.ptr_off[res] = cur_off;
            st.ptr_ty[res]  = cur_ty;
            i = i + len; cnt;
        }

        if (op == spirv.OP_LOAD) {
            val ty:  u32 = w[i + 1];
            val res: u32 = w[i + 2];
            val ptr: u32 = w[i + 3];
            if (ty >= UT_AGG_IDS || res >= UT_AGG_IDS || ptr >= UT_AGG_IDS || !st.is_ptr[ptr]) { ret false; }
            if (!ut_agg_copy(st, res, 0, st.ptr_blk[ptr], st.ptr_off[ptr], st.ty_words[ty])) { ret false; }
            st.val_ty[res] = ty;
            i = i + len; cnt;
        }

        if (op == spirv.OP_STORE) {
            val ptr: u32 = w[i + 1];
            val v:   u32 = w[i + 2];
            if (ptr >= UT_AGG_IDS || v >= UT_AGG_IDS || !st.is_ptr[ptr]) { ret false; }
            if (!ut_agg_copy(st, st.ptr_blk[ptr], st.ptr_off[ptr], v, 0, st.ty_words[st.ptr_ty[ptr]])) { ret false; }
            i = i + len; cnt;
        }

        if (op == spirv.OP_I_ADD || op == spirv.OP_I_MUL) {
            val ty:  u32 = w[i + 1];
            val res: u32 = w[i + 2];
            val a:   u32 = w[i + 3];
            val b:   u32 = w[i + 4];
            if (ty >= UT_AGG_IDS || res >= UT_AGG_IDS || a >= UT_AGG_IDS || b >= UT_AGG_IDS) { ret false; }
            if (st.ty_words[ty] != 1) { ret false; }
            val x: u64 = st.val[a * UT_AGG_WORDS];
            val y: u64 = st.val[b * UT_AGG_WORDS];
            if (op == spirv.OP_I_ADD) { st.val[res * UT_AGG_WORDS] = ut_agg_mask(st, ty, x + y); }
            or                        { st.val[res * UT_AGG_WORDS] = ut_agg_mask(st, ty, x * y); }
            st.val_ty[res] = ty;
            i = i + len; cnt;
        }

        # a widening or narrowing between unsigned integers, which is what reading a
        # `u8` member into `u32` arithmetic emits. the result is masked to its own
        # width, so a member that arrived carrying another member's bytes reads back
        # as those bytes rather than being tidied up here.
        if (op == spirv.OP_U_CONVERT) {
            val ty:  u32 = w[i + 1];
            val res: u32 = w[i + 2];
            val src: u32 = w[i + 3];
            if (ty >= UT_AGG_IDS || res >= UT_AGG_IDS || src >= UT_AGG_IDS) { ret false; }
            if (st.ty_words[ty] != 1) { ret false; }
            st.val[res * UT_AGG_WORDS] = ut_agg_mask(st, ty, st.val[src * UT_AGG_WORDS]);
            st.val_ty[res] = ty;
            i = i + len; cnt;
        }

        # the whole value moves and only its type changes: the two types describe one
        # object, so the words are the same words. modelling it as anything narrower
        # would let a block that lost members on the crossing read back intact.
        if (op == spirv.OP_COPY_LOGICAL) {
            val ty:  u32 = w[i + 1];
            val res: u32 = w[i + 2];
            val src: u32 = w[i + 3];
            if (ty >= UT_AGG_IDS || res >= UT_AGG_IDS || src >= UT_AGG_IDS) { ret false; }
            if (st.val_ty[src] == 0 || st.ty_words[st.val_ty[src]] != st.ty_words[ty]) { ret false; }
            if (!ut_agg_copy(st, res, 0, src, 0, st.ty_words[ty])) { ret false; }
            st.val_ty[res] = ty;
            i = i + len; cnt;
        }

        if (op == spirv.OP_COMPOSITE_EXTRACT) {
            val ty:  u32 = w[i + 1];
            val res: u32 = w[i + 2];
            val c:   u32 = w[i + 3];
            if (ty >= UT_AGG_IDS || res >= UT_AGG_IDS || c >= UT_AGG_IDS || st.val_ty[c] == 0) { ret false; }
            var cur_off: u32 = 0;
            var cur_ty:  u32 = st.val_ty[c];
            var k: u32 = 0;
            # the indices are LITERALS here, unlike an access chain's constant ids
            for (k < len - 4) {
                var moff: u32 = 0;
                var mty:  u32 = 0;
                if (!ut_agg_member(st, cur_ty, w[i + 4 + k], ?moff, ?mty)) { ret false; }
                cur_off = cur_off + moff;
                cur_ty  = mty;
                k = k + 1;
            }
            if (!ut_agg_copy(st, res, 0, c, cur_off, st.ty_words[ty])) { ret false; }
            st.val_ty[res] = ty;
            i = i + len; cnt;
        }

        if (op == spirv.OP_COMPOSITE_CONSTRUCT) {
            val ty:  u32 = w[i + 1];
            val res: u32 = w[i + 2];
            if (ty >= UT_AGG_IDS || res >= UT_AGG_IDS) { ret false; }
            var off: u32 = 0;
            var k: u32 = 0;
            for (k < len - 3) {
                val c: u32 = w[i + 3 + k];
                if (c >= UT_AGG_IDS || st.val_ty[c] == 0) { ret false; }
                val cw: u32 = st.ty_words[st.val_ty[c]];
                if (!ut_agg_copy(st, res, off, c, 0, cw)) { ret false; }
                off = off + cw;
                k = k + 1;
            }
            st.val_ty[res] = ty;
            i = i + len; cnt;
        }

        if (op == spirv.OP_FUNCTION_CALL) {
            if (sp >= UT_AGG_DEPTH || len < 4) { ret false; }
            r_ix[sp]  = i + len;
            r_res[sp] = w[i + 2];
            r_ty[sp]  = w[i + 1];
            sp = sp + 1;
            if (!ut_agg_bind_params(st, w, n, w[i + 3], i + 4, len - 4)) { ret false; }
            val b: u32 = ut_agg_body_start(st, w, n, w[i + 3]);
            if (b == 0) { ret false; }
            i = b; cnt;
        }

        if (op == spirv.OP_RETURN_VALUE) {
            val v: u32 = w[i + 1];
            if (sp == 0) { ret true; }
            sp = sp - 1;
            if (v >= UT_AGG_IDS || r_res[sp] >= UT_AGG_IDS || r_ty[sp] >= UT_AGG_IDS) { ret false; }
            if (!ut_agg_copy(st, r_res[sp], 0, v, 0, st.ty_words[r_ty[sp]])) { ret false; }
            st.val_ty[r_res[sp]] = r_ty[sp];
            i = r_ix[sp]; cnt;
        }

        # only the entry point returns void here. A callee that did would be a
        # value-returning call with nothing to hand back.
        if (op == spirv.OP_RETURN) {
            if (sp == 0) { ret true; }
            ret false;
        }

        ret false;
    }
    ret false;
}

# run a codegen'd module's entry point and report the value it leaves in the
# interface variable decorated `Location loc`
#
# THIS READS VALUES BACK, which is the only thing that settles whether an aggregate
# survived a call. A structural assertion - that an `OpFunctionParameter` of the
# record's type is present, that the module validates - is satisfied just as well by
# a parameter carrying the wrong object, and a whole-object transfer emitted at the
# wrong type is exactly the shape that passes one and fails the other.
# ---
# alloc: the allocator backing the evaluator state
# img:   the codegen'd image
# loc:   the interface location to read
# ret:   the value stored there, or UT_AGG_BAD
fun ut_spv_read_location(alloc: *A.Allocator, img: *of.ObjectImage, loc: u32) u64 {
    var n: u32 = 0;
    val w: *u32 = ut_spv_words(img, ?n);
    if (w == nil || n == 0) { ret UT_AGG_BAD; }

    val ar: R.Result[*UtAggEval, str] = A.allocate[UtAggEval](alloc, 1::usize);
    if (R.is_err[*UtAggEval, str](ar)) { ret UT_AGG_BAD; }
    val st: *UtAggEval = R.unwrap_ok[*UtAggEval, str](ar);
    ut_agg_reset(st);

    var out: u64 = UT_AGG_BAD;
    val tgt:   u32 = ut_agg_location_var(w, n, loc);
    val entry: u32 = ut_agg_entry_fn(w, n);
    if (ut_agg_prepare(st, w, n) && tgt != 0 && tgt < UT_AGG_IDS && entry != 0
        && ut_agg_exec(st, w, n, entry)) {
        if (st.is_ptr[tgt] && st.ty_words[st.ptr_ty[tgt]] == 1) {
            out = st.val[st.ptr_blk[tgt] * UT_AGG_WORDS + st.ptr_off[tgt]];
        }
    }

    A.deallocate[UtAggEval](alloc, st, 1::usize);
    ret out;
}

# the shader both aggregate-crossing assertions read: five record shapes, each
# handed to a helper by value and each recomputed inline beside it
#
# THE SHAPES ARE THE POINT. A two-member record is the smallest thing that can be
# permuted. An eight-member one outgrows every register pair a convention would
# otherwise split it into. A nested record shares its first member's offset with
# itself, which is what an offset-keyed copy cannot tell apart from the outer
# object. An array member and a vector member are the two composites whose members
# are reached by ordinal rather than by name, and a record holding a vector is the
# shape shaders are actually written with.
#
# THE WEIGHTS ARE POSITIONAL, so a copy that permutes, truncates or drops members
# reads back a different number rather than the same total.
fun ut_agg_call_src() str {
    ret "rec Small { a: u32; b: u32; }\nrec Big { a: u32; b: u32; c: u32; d: u32; e: u32; f: u32; g: u32; h: u32; }\nrec Inner { x: u32; y: u32; }\nrec Nest { i: Inner; z: u32; }\nrec WithArr { v: [4]u32; t: u32; }\nrec WithVec { v: u32x4; t: u32; }\n\nfun sum_small(p: Small) u32 { ret p.a + p.b * 10; }\nfun make_small() Small { ret Small{a: 7, b: 6}; }\nfun sum_big(p: Big) u32 { ret p.a + p.b * 10 + p.c * 100 + p.d * 1000 + p.e * 10000 + p.f * 100000 + p.g * 1000000 + p.h * 10000000; }\nfun sum_nest(p: Nest) u32 { ret p.i.x + p.i.y * 10 + p.z * 100; }\nfun sum_arr(p: WithArr) u32 { ret p.v[0] + p.v[1] * 10 + p.v[2] * 100 + p.v[3] * 1000 + p.t * 10000; }\nfun sum_vec(p: WithVec) u32 { ret p.v[0] + p.v[1] * 10 + p.v[2] * 100 + p.v[3] * 1000 + p.t * 10000; }\n\n#[output(0)] var o_small: u32;\n#[output(1)] var o_small_ctl: u32;\n#[output(2)] var o_ret: u32;\n#[output(3)] var o_big: u32;\n#[output(4)] var o_big_ctl: u32;\n#[output(5)] var o_nest: u32;\n#[output(6)] var o_nest_ctl: u32;\n#[output(7)] var o_arr: u32;\n#[output(8)] var o_arr_ctl: u32;\n#[output(9)] var o_vec: u32;\n#[output(10)] var o_vec_ctl: u32;\n\n#[stage(\"vertex\")]\nfun vs() {\n    val s: Small = Small{a: 7, b: 6};\n    o_small = sum_small(s);\n    o_small_ctl = s.a + s.b * 10;\n\n    val r: Small = make_small();\n    o_ret = r.a + r.b * 10;\n\n    val b: Big = Big{a: 1, b: 2, c: 3, d: 4, e: 5, f: 6, g: 7, h: 8};\n    o_big = sum_big(b);\n    o_big_ctl = b.a + b.b * 10 + b.c * 100 + b.d * 1000 + b.e * 10000 + b.f * 100000 + b.g * 1000000 + b.h * 10000000;\n\n    val nn: Nest = Nest{i: Inner{x: 4, y: 3}, z: 2};\n    o_nest = sum_nest(nn);\n    o_nest_ctl = nn.i.x + nn.i.y * 10 + nn.z * 100;\n\n    val wa: WithArr = WithArr{v: [4]u32{9, 8, 7, 6}, t: 5};\n    o_arr = sum_arr(wa);\n    o_arr_ctl = wa.v[0] + wa.v[1] * 10 + wa.v[2] * 100 + wa.v[3] * 1000 + wa.t * 10000;\n\n    val qv: WithVec = WithVec{v: u32x4{2, 3, 4, 5}, t: 1};\n    o_vec = sum_vec(qv);\n    o_vec_ctl = qv.v[0] + qv.v[1] * 10 + qv.v[2] * 100 + qv.v[3] * 1000 + qv.t * 10000;\n}\n\nfun main() i32 { ret 0; }\n";
}

# an aggregate passed BY VALUE to a function arrives with its members intact, and an
# aggregate RETURNED by value carries its own (#2914, #2915)
#
# WHAT WAS BROKEN. The shared ABI lowering described every aggregate placement in
# BYTES: an argument was copied into an outgoing stack frame in 8/4/2/1-byte chunks
# and a return was written through a caller-supplied sret pointer. SPIR-V has
# neither a frame nor a pointer to follow, so the argument was refused outright and
# the return failed earlier still, in the sret move. Both now classify
# `abi.CLASS_AGG` - the object travels whole, as the `OpFunctionParameter` and the
# `OpReturnValue` of its own type that SPIR-V already had.
#
# THE INLINE ARM OF EACH PAIR IS THE CONTROL, and it is the arm that already worked:
# the same members, the same weights, computed without crossing a call. Asserting
# the crossing arm alone would pass just as well if the whole fixture were
# mis-evaluated, and asserting that a parameter of the record's type is present
# would pass on a parameter carrying the wrong object.
test "mach.lang.driver:an_aggregate_crosses_a_call_by_value_on_spirv" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    var names: [1]str;
    var texts: [1]str;
    names[0] = "main.mach"; texts[0] = ut_agg_call_src();
    val pr: R.Result[project.Project, outcome.Fail] = ut_spv_lower(?s, ?alloc, ?names[0], ?texts[0], 1, "", nil, nil, 0);
    if (R.is_err[project.Project, outcome.Fail](pr)) { session.dnit(?s); ret 1; }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);

    var img: of.ObjectImage;
    var err: str = nil;
    if (!ut_spv_codegen(?p, ?s, "spvcase.main", ?img, ?err)) {
        project.dnit_project(?p); session.dnit(?s); ret 1;
    }

    var bad: i32 = 0;
    # 7 + 6*10, the two members in their declared positions
    if (ut_spv_read_location(?alloc, ?img, 0)  != 67)       { bad = 1; }
    if (ut_spv_read_location(?alloc, ?img, 1)  != 67)       { bad = 1; }
    # the same record, returned by value rather than passed
    if (ut_spv_read_location(?alloc, ?img, 2)  != 67)       { bad = 1; }
    # eight members, each at its own decimal place
    if (ut_spv_read_location(?alloc, ?img, 3)  != 87654321) { bad = 1; }
    if (ut_spv_read_location(?alloc, ?img, 4)  != 87654321) { bad = 1; }
    # a nested record: the inner members and the outer one that follows them
    if (ut_spv_read_location(?alloc, ?img, 5)  != 234)      { bad = 1; }
    if (ut_spv_read_location(?alloc, ?img, 6)  != 234)      { bad = 1; }
    # an array member, walked by ordinal, and the scalar behind it
    if (ut_spv_read_location(?alloc, ?img, 7)  != 56789)    { bad = 1; }
    if (ut_spv_read_location(?alloc, ?img, 8)  != 56789)    { bad = 1; }
    # a vector member, which is the shape a shader is actually written with
    if (ut_spv_read_location(?alloc, ?img, 9)  != 15432)    { bad = 1; }
    if (ut_spv_read_location(?alloc, ?img, 10) != 15432)    { bad = 1; }

    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

# count, over a lowered MIR module, the whole-object calling-convention transfers
# and the byte-chunked loads a placement described in bytes produces
# ---
# mm:        the lowered MIR module
# out_loads: receives the number of MIR_LOAD instructions
# ret:       the number of MIR_AGG_LOAD / MIR_AGG_STORE instructions
fun ut_agg_ops_and_loads(mm: *mir.MirModule, out_loads: *u32) u32 {
    var ac: u32 = 0;
    var ld: u32 = 0;
    var fi: u32 = 0;
    for (fi < mm.function_len) {
        val mf: *mir.MirFunction = ?mm.functions[fi];
        var bi: u32 = 0;
        for (bi < mf.block_count) {
            val blk: *mir.MirBlock = ?mf.blocks[bi];
            var ii: u32 = 0;
            for (ii < blk.instr_count) {
                if (blk.instrs[ii].opcode == mir.MIR_AGG_LOAD)  { ac = ac + 1; }
                if (blk.instrs[ii].opcode == mir.MIR_AGG_STORE) { ac = ac + 1; }
                if (blk.instrs[ii].opcode == mir.MIR_LOAD)      { ld = ld + 1; }
                ii = ii + 1;
            }
            bi = bi + 1;
        }
        fi = fi + 1;
    }
    @out_loads = ld;
    ret ac;
}

# lower `src` for `tname` to MIR and report (whole-object transfer count, load count)
fun ut_agg_shape(alloc: *A.Allocator, src: str, tname: str, out_loads: *u32) i64 {
    val sr: R.Result[session.Session, str] = session.init(alloc);
    if (R.is_err[session.Session, str](sr)) { ret -1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    val pr: R.Result[project.Project, outcome.Fail] = ut_vec_lower(?s, alloc, src, tname);
    if (R.is_err[project.Project, outcome.Fail](pr)) { session.dnit(?s); ret -1; }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);
    var out: i64 = -1;
    var loads: u32 = 0;
    var mi: u32 = 0;
    for (mi < p.module_len) {
        val me: *project.ModuleEntry = ?p.modules[mi];
        if (me.ir_module == nil) { mi = mi + 1; cnt; }
        val mr: R.Result[mir.MirModule, str] = mirlower.lower_ir(?p.target, me.ir_module, alloc, ?s.interner, ?s.sources);
        if (R.is_err[mir.MirModule, str](mr)) { mi = mi + 1; cnt; }
        var mm: mir.MirModule = R.unwrap_ok[mir.MirModule, str](mr);
        var lc: u32 = 0;
        val c: u32 = ut_agg_ops_and_loads(?mm, ?lc);
        if (out < 0) { out = 0; }
        out = out + c::i64;
        loads = loads + lc;
        mi = mi + 1;
    }
    @out_loads = loads;
    project.dnit_project(?p);
    session.dnit(?s);
    ret out;
}

# the aggregate calling convention is the CONVENTION'S choice, not everyone's
# (#2914, #2915)
#
# THE MACHINE TARGETS ARE THE HALF THAT MATTERS HERE. The whole-object placement
# exists because one convention declares `abi.CLASS_AGG`. A fix applied one level
# too high - rewriting the argument or return lowering for everyone - would move
# their numbers too. So both sides are asserted: spirv carries the object whole,
# while every flat target emits no whole-object transfer at all and still issues the
# chunked loads that ARE its by-value copy. Deleting the class arm, or reaching it
# from the wrong condition, moves one of the two.
test "mach.lang.driver:an_aggregate_call_is_classified_by_the_convention" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val src: str = ut_agg_call_src();
    val nsrc: str = "rec Small { a: u32; b: u32; }\nfun sum_small(p: Small) u32 { ret p.a + p.b * 10; }\nfun make_small() Small { ret Small{a: 7, b: 6}; }\nfun rd() u32 {\n    val s: Small = Small{a: 7, b: 6};\n    val r: Small = make_small();\n    ret sum_small(s) + r.a;\n}\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret rd()::i32; }\n";

    var bad: i32 = 0;

    var sl: u32 = 0;
    # six calls plus six returns' worth of whole-object transfers, at least
    if (ut_agg_shape(?alloc, src, "spirv", ?sl) < 6) { bad = 1; }

    var fl: u32 = 0;
    if (ut_agg_shape(?alloc, nsrc, "linux", ?fl)         != 0) { bad = 1; }
    if (fl < 2) { bad = 1; }
    if (ut_agg_shape(?alloc, nsrc, "linux-arm64", ?fl)   != 0) { bad = 1; }
    if (fl < 2) { bad = 1; }
    if (ut_agg_shape(?alloc, nsrc, "linux-riscv64", ?fl) != 0) { bad = 1; }
    if (fl < 2) { bad = 1; }

    ret bad;
}

# a SPIR-V backend refusal names its instruction, its function and its source
# position (#2915)
#
# THE SECOND DEFECT #2915 CARRIED, and it is a diagnostic bug in its own right: the
# aggregate return failed as a bare `spirv.emit: unreadable move source`, which
# bypassed `mir.instr_refusal` entirely and so localized nothing. Every refusal the
# emitter raises from inside instruction emission now goes through the same stamp,
# `unsupported` and internal errors alike.
#
# THE FIXTURE REFUSES FOR A DECLARED REASON - a shader cannot call a foreign import
# - so this holds the LOCATED SHAPE rather than the feature: the message must carry
# the MIR opcode, the enclosing function's source name, and a `path:line:column`.
# Asserting only that an error came back would pass on the bare sentence that
# started this.
test "mach.lang.driver:a_spirv_backend_refusal_is_located" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    var names: [1]str;
    var texts: [1]str;
    names[0] = "main.mach";
    texts[0] = "ext fun helper(x: u32) u32;\n\n#[output(0)] var o: u32;\n\n#[stage(\"vertex\")]\nfun vs() {\n    o = helper(1);\n}\n\nfun main() i32 { ret 0; }\n";
    val pr: R.Result[project.Project, outcome.Fail] = ut_spv_lower(?s, ?alloc, ?names[0], ?texts[0], 1, "", nil, nil, 0);
    if (R.is_err[project.Project, outcome.Fail](pr)) { session.dnit(?s); ret 1; }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);

    var img: of.ObjectImage;
    var err: str = nil;
    var bad: i32 = 0;
    if (ut_spv_codegen(?p, ?s, "spvcase.main", ?img, ?err)) { bad = 1; }
    or {
        if (!ut_str_contains(err, "MIR_CALL")) { bad = 1; }
        if (!ut_str_contains(err, " in vs,"))  { bad = 1; }
        if (!ut_str_contains(err, "main.mach:")) { bad = 1; }
        # the unlocated form the fix deleted, which carried none of the above
        if (ut_str_contains(err, "no source location on this instruction")) { bad = 1; }
    }

    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

# lower `src` for `tname`, run the RELEASE pipeline over every module, and report
# how many vector-typed instructions survive
#
# `ut_vec_lower` builds at the fixture's default profile, which is the debug
# pipeline, so the release stages have to be asked for explicitly: the auto-
# vectorizer is the only thing in the module that introduces a vector where the
# source names none.
# ---
# alloc: the allocator
# src:   the one-file source
# tname: the manifest target to select
# out:   receives the vector-typed instruction count
# ret:   0 on success, 1 when the fixture could not be lowered
fun ut_release_vector_count(alloc: *A.Allocator, src: str, tname: str, out: *u32) i32 {
    val sr: R.Result[session.Session, str] = session.init(alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    val pr: R.Result[project.Project, outcome.Fail] = ut_vec_lower(?s, alloc, src, tname);
    if (R.is_err[project.Project, outcome.Fail](pr)) { session.dnit(?s); ret 1; }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);

    var mi: u32 = 0;
    for (mi < p.module_len) {
        val me: *project.ModuleEntry = ?p.modules[mi];
        if (me.ir_module == nil) { mi = mi + 1; cnt; }
        val rr: R.Result[bool, str] = pipeline.run(me.ir_module, ?p.target, pipeline.OPT_RELEASE,
            false, true, false, false, ?s.interner, ?s.sources);
        if (R.is_err[bool, str](rr)) { project.dnit_project(?p); session.dnit(?s); ret 1; }
        mi = mi + 1;
    }
    @out = ut_count_vector_typed_instrs(?p);
    project.dnit_project(?p);
    session.dnit(?s);
    ret 0;
}

# auto-vectorization stays off on a logical-addressing target (#2921)
#
# The vectorizer rewrites an element-wise loop into a runtime-guarded vector copy
# plus a scalar remainder. Both halves of that are byte-oriented: the guard compares
# the two ranges' end ADDRESSES, and the fast copy re-reads an element pointer as a
# packed vector. A logical-addressing target has neither - its pointer names one
# object at one pointee type - so the rewrite produces IR the SPIR-V back end cannot
# express, which is how #2921 showed up: a function that built at -O0 was refused at
# -O2. Having vector registers is not the same question, and spirv answers that one
# yes, so `has_v128` alone did not keep the pass out.
#
# THE FLAT TARGETS ARE THE HALF THAT MATTERS. Gating this one level too high would
# cost every machine target its vectorization silently, so x86-64 and arm64 are
# asserted to still vectorize the same loop rather than merely "not crash".
test "mach.lang.driver:autovectorization_is_off_under_logical_addressing" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val src: str = "fun scale(a: *u32, b: *u32, n: u64) {\n    var i: u64 = 0;\n    for (i < n) { b[i] = a[i] + 1; i = i + 1; }\n}\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { scale(argv:~*u32, argv:~*u32, 8); ret 0; }\n";

    var bad: i32 = 0;
    var flat_x: u32 = 0;
    var flat_a: u32 = 0;
    var logical: u32 = 0;
    if (ut_release_vector_count(?alloc, src, "linux", ?flat_x) != 0)          { bad = 1; }
    if (ut_release_vector_count(?alloc, src, "linux-arm64", ?flat_a) != 0)    { bad = 1; }
    if (ut_release_vector_count(?alloc, src, "spirv", ?logical) != 0)         { bad = 1; }
    if (bad == 0 && flat_x == 0) { bad = 2; }
    if (bad == 0 && flat_a == 0) { bad = 3; }
    if (bad == 0 && logical != 0) { bad = 4; }
    ret bad;
}

# whether an opcode's first two words really are a result type and a result id
#
# The membership matters: scanning every instruction long enough to have the pair
# would read an `OpStore`'s pointer and object as one, which is a different pair of
# numbers that can collide with a real id.
# ---
# op:  the SPIR-V opcode
# ret: true when word one is a result type and word two a result id
fun ut_spv_defines_typed_value(op: u32) bool {
    ret op == spirv.OP_LOAD || op == spirv.OP_CONSTANT || op == spirv.OP_FUNCTION_PARAMETER
     || op == spirv.OP_I_ADD || op == spirv.OP_I_SUB || op == spirv.OP_I_MUL
     || op == spirv.OP_BITCAST || op == spirv.OP_COMPOSITE_EXTRACT;
}

# the type an instruction gave the value `id`, or 0 when nothing in the typed-value
# set defines it
# ---
# w, n: the instruction words
# id:   the value id
# ret:  the value's type id, or 0
fun ut_spv_value_type(w: *u32, n: u32, id: u32) u32 {
    if (id == 0) { ret 0; }
    var i: u32 = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0) { ret 0; }
        if (len >= 3 && w[i + 2] == id && ut_spv_defines_typed_value(w[i] & 0xFFFF)) {
            ret w[i + 1];
        }
        i = i + len;
    }
    ret 0;
}

# whether an opcode is a two-operand integer arithmetic or comparison instruction
# ---
# op:  the SPIR-V opcode
# ret: true for the forms whose two operands must share one type
fun ut_spv_is_binary_int(op: u32) bool {
    ret op == spirv.OP_I_ADD || op == spirv.OP_I_SUB || op == spirv.OP_I_MUL
     || op == spirv.OP_U_LESS_THAN || op == spirv.OP_S_LESS_THAN
     || op == spirv.OP_I_EQUAL || op == spirv.OP_I_NOT_EQUAL;
}

# how many two-operand integer instructions read operands of DIFFERENT types
#
# This is the validator's rule stated in-tree: SPIR-V requires both operands of an
# arithmetic or comparison instruction to have the same component bit width. An
# operand nothing in the typed-value set defines answers 0 and is skipped, so only
# pairs both sides of which are visible are counted.
# ---
# w, n: the instruction words
# ret:  the number of mixed-type instructions
fun ut_spv_mixed_operand_types(w: *u32, n: u32) u32 {
    var i: u32 = 0;
    var c: u32 = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0) { ret c; }
        if (len == 5 && ut_spv_is_binary_int(w[i] & 0xFFFF)) {
            val ta: u32 = ut_spv_value_type(w, n, w[i + 3]);
            val tb: u32 = ut_spv_value_type(w, n, w[i + 4]);
            if (ta != 0 && tb != 0 && ta != tb) { c = c + 1; }
        }
        i = i + len;
    }
    ret c;
}

# how many OpTypeInt declarations the module makes at `bits` width
# ---
# w, n: the instruction words
# bits: the width to count
# ret:  the number of declarations
fun ut_spv_int_type_count(w: *u32, n: u32, bits: u32) u32 {
    var i: u32 = 0;
    var c: u32 = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0) { ret c; }
        if ((w[i] & 0xFFFF) == spirv.OP_TYPE_INT && len >= 3 && w[i + 2] == bits) { c = c + 1; }
        i = i + len;
    }
    ret c;
}

# how many OpBitcast results carry their OPERAND's type rather than the one the
# reinterpret produces
#
# A `:~` that came out typed as its source is a no-op cast the validator accepts,
# and every later read of the result is then a type error somewhere else in the
# module, which is why this is asserted at the bitcast rather than at the use.
# ---
# w, n: the instruction words
# ret:  the number of bitcasts that kept their source type
fun ut_spv_bitcasts_keeping_source_type(w: *u32, n: u32) u32 {
    var i: u32 = 0;
    var c: u32 = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0) { ret c; }
        if ((w[i] & 0xFFFF) == spirv.OP_BITCAST && len == 4) {
            val st: u32 = ut_spv_value_type(w, n, w[i + 3]);
            if (st != 0 && st == w[i + 1]) { c = c + 1; }
        }
        i = i + len;
    }
    ret c;
}

# an 8- or 16-bit loop counter is stored at its declared width, so nothing compares
# or adds across widths (#2919)
#
# A phi merge materializes its constant at the machine word, because a sub-word
# write to a machine register leaves the upper bits unspecified. That is a statement
# about a register file, and the SPIR-V emitter was reading it as the value's TYPE:
# the counter became a 64-bit Function variable while the increment and the loop
# bound stayed at the declared width, and `OpULessThan` mixed a 64-bit load with an
# 8-bit constant. mach reported success and wrote the module, and only `spirv-val`
# refused it.
#
# THE MIXED-OPERAND COUNT IS THE ASSERTION and the comparison counts are its
# positive control: four loops really are in the module, two unsigned and two
# signed, so a zero is agreement rather than a fixture that emitted nothing. The
# absence of any 64-bit integer type is the sharper half - it is the width that was
# wrong, and no other value in the fixture is 64 bits - while the 8- and 16-bit
# declarations keep that honest by showing the module does type these values.
test "mach.lang.driver:a_narrow_spirv_loop_counter_keeps_its_declared_width" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    var names: [1]str;
    var texts: [1]str;
    names[0] = "main.mach";
    texts[0] = "pub fun c8() u8 { var i: u8 = 0; for (i < 32) { i = i + 1; } ret i; }\n\npub fun s8() i8 { var i: i8 = 0; for (i < 32) { i = i + 1; } ret i; }\n\npub fun c16() u16 { var i: u16 = 0; for (i < 32) { i = i + 1; } ret i; }\n\npub fun s16() i16 { var i: i16 = 0; for (i < 32) { i = i + 1; } ret i; }\n";
    val pr: R.Result[project.Project, outcome.Fail] =
        ut_spv_lower(?s, ?alloc, ?names[0], ?texts[0], 1, "", nil, nil, 0);
    if (R.is_err[project.Project, outcome.Fail](pr)) { session.dnit(?s); ret 1; }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);

    var bad: i32 = 0;
    var img: of.ObjectImage;
    var err: str = nil;
    if (!ut_spv_codegen(?p, ?s, "spvcase.main", ?img, ?err)) {
        project.dnit_project(?p); session.dnit(?s); ret 1;
    }
    var n: u32 = 0;
    val w: *u32 = ut_spv_words(?img, ?n);
    if (w == nil) { obj.dnit(?img); project.dnit_project(?p); session.dnit(?s); ret 1; }

    if (ut_spv_count(w, n, spirv.OP_U_LESS_THAN) != 2) { bad = 1; }
    if (ut_spv_count(w, n, spirv.OP_S_LESS_THAN) != 2) { bad = 1; }
    if (ut_spv_int_type_count(w, n, 8) != 1)  { bad = 1; }
    if (ut_spv_int_type_count(w, n, 16) != 1) { bad = 1; }
    or {
        if (ut_spv_mixed_operand_types(w, n) != 0) { bad = 1; }
        if (ut_spv_int_type_count(w, n, 64) != 0)  { bad = 1; }
    }

    obj.dnit(?img);
    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

# a loop-carried scalar whose first path comes from an immediate keeps its declared
# type (#2969)
#
# out-of-SSA lowering gives the state phi one vreg and writes it from each
# predecessor. the entry path materializes zero at the machine word while the
# conditional path writes an i32 value. that word width is a register convention,
# not the phi's type: letting the immediate copy claim the shared vreg makes the
# later `state != 0::i32` compare a 64-bit load against a 32-bit constant.
#
# the staged shader is the reproduction, including the conditional assignment
# before the loop: without that join the loop counter coverage above already owns
# the simpler shape. the inequality count is the positive control, so successful
# codegen cannot satisfy this by dropping the comparison.
test "mach.lang.driver:a_loop_carried_spirv_scalar_keeps_its_concrete_type" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    var names: [1]str;
    var texts: [1]str;
    names[0] = "main.mach";
    texts[0] = "#[input(0)] var in_uv: f32x2;\n#[output(0)] var out_colour: f32x4;\n\n#[stage(\"fragment\")]\nfun frag_main() {\n    var state: i32 = 0;\n    if (in_uv[0] < 0.5) { state = 1; }\n    var i: i32 = 0;\n    for (i < 2) {\n        if (state != 0::i32) { state = 0; }\n        i = i + 1;\n    }\n    out_colour = f32x4{state::f32, 0.0, 0.0, 1.0};\n}\n";
    val pr: R.Result[project.Project, outcome.Fail] =
        ut_spv_lower(?s, ?alloc, ?names[0], ?texts[0], 1, "", nil, nil, 0);
    if (R.is_err[project.Project, outcome.Fail](pr)) { session.dnit(?s); ret 1; }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);

    var bad: i32 = 0;
    var img: of.ObjectImage;
    var err: str = nil;
    if (!ut_spv_codegen(?p, ?s, "spvcase.main", ?img, ?err)) {
        project.dnit_project(?p); session.dnit(?s); ret 1;
    }
    var n: u32 = 0;
    val w: *u32 = ut_spv_words(?img, ?n);
    if (w == nil) { obj.dnit(?img); project.dnit_project(?p); session.dnit(?s); ret 1; }

    if (ut_spv_count(w, n, spirv.OP_I_NOT_EQUAL) != 1) { bad = 1; }
    or {
        if (ut_spv_mixed_operand_types(w, n) != 0) { bad = 1; }
        if (ut_spv_int_type_count(w, n, 32) != 1)  { bad = 1; }
        if (ut_spv_int_type_count(w, n, 64) != 0)  { bad = 1; }
    }

    obj.dnit(?img);
    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

# a bit reinterpret between two vector types declares no scalar integer and takes
# the type it produces (#2920)
#
# `f32x4 :~ u32x4` is 16 bytes wide on both sides. Reading that width as a scalar
# integer declared an `OpTypeInt 128`, which SPIR-V has no form for, and describing
# the instruction by its OPERAND'S lane shape typed the result as another `f32x4`,
# so the lane read that followed pulled a `u32` out of a float vector. Both were
# written into a module mach reported success for.
#
# THE SCALAR BITCAST IS THE POSITIVE CONTROL: it is the shape that always worked, it
# keeps the bitcast count from being satisfied by an emitter that stopped emitting
# one, and it holds the retype assertion to something a same-type cast could not
# pass either.
test "mach.lang.driver:a_spirv_vector_reinterpret_declares_no_scalar_integer" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    var names: [1]str;
    var texts: [1]str;
    names[0] = "main.mach";
    texts[0] = "pub fun lane(a: f32x4) u32 { val u: u32x4 = a:~u32x4; ret u[0]; }\n\npub fun flat(x: f32) u32 { ret x:~u32; }\n";
    val pr: R.Result[project.Project, outcome.Fail] =
        ut_spv_lower(?s, ?alloc, ?names[0], ?texts[0], 1, "", nil, nil, 0);
    if (R.is_err[project.Project, outcome.Fail](pr)) { session.dnit(?s); ret 1; }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);

    var bad: i32 = 0;
    var img: of.ObjectImage;
    var err: str = nil;
    if (!ut_spv_codegen(?p, ?s, "spvcase.main", ?img, ?err)) {
        project.dnit_project(?p); session.dnit(?s); ret 1;
    }
    var n: u32 = 0;
    val w: *u32 = ut_spv_words(?img, ?n);
    if (w == nil) { obj.dnit(?img); project.dnit_project(?p); session.dnit(?s); ret 1; }

    if (ut_spv_count(w, n, spirv.OP_BITCAST) != 2) { bad = 1; }
    or {
        if (ut_spv_int_type_count(w, n, 128) != 0)      { bad = 1; }
        if (ut_spv_bitcasts_keeping_source_type(w, n) != 0) { bad = 1; }
    }

    obj.dnit(?img);
    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}


# true when instruction `iid` is reachable from `f`'s block lists
#
# The instruction POOL retains everything a pass ever created, including what it
# detached, so a pool lookup answers yes for a dropped value. Only the block lists
# say what still reaches the back end.
fun ut_instr_in_blocks(f: *ir.Function, iid: ir.InstructionId) bool {
    var bi: u32 = 0;
    for (bi < f.block_count) {
        val b: *ir.Block = ?f.blocks[bi];
        var k: u32 = 0;
        for (k < b.phi_count) {
            if (b.phis[k] == iid) { ret true; }
            k = k + 1;
        }
        k = 0;
        for (k < b.instr_count) {
            if (b.instructions[k] == iid) { ret true; }
            k = k + 1;
        }
        if (b.terminator == iid) { ret true; }
        bi = bi + 1;
    }
    ret false;
}

# how many of instruction `iid`'s operands name an instruction outside `f`'s blocks
fun ut_dangling_ops(f: *ir.Function, iid: ir.InstructionId) u32 {
    val opt_ins: O.Option[*instruction.Instruction] = ir.instruction_get(f, iid);
    if (O.is_none[*instruction.Instruction](opt_ins)) { ret 0; }
    val ins: *instruction.Instruction = O.unwrap[*instruction.Instruction](opt_ins);
    var hits: u32 = 0;
    var oi: u32 = 0;
    for (oi < ins.operand_count) {
        val v: *value.Value = ?ins.operands[oi];
        if (v.kind == value.VAL_INSTR) {
            if (!ut_instr_in_blocks(f, v.data.instr)) { hits = hits + 1; }
        }
        oi = oi + 1;
    }
    ret hits;
}

# audit every live instruction's operands across `p`'s lowered modules
#
# `@phis` is how many phis survive - the fixture's own positive control, since an
# audit over a function with no merge proves nothing - and `@dangling` is how many
# VAL_INSTR operands name an instruction no block list holds. A dangling operand is
# a silent wrong answer rather than a crash: MIR phi destruction emits a merge copy
# only for an incoming it can resolve, so the merge register is left unwritten on
# that edge and read undefined (#2917).
fun ut_operand_audit(p: *project.Project, phis: *u32, dangling: *u32) {
    @phis     = 0;
    @dangling = 0;
    var ti: u32 = 0;
    for (ti < p.topo_len) {
        val m: *ir.Module = p.modules[p.topo[ti]::u32].ir_module;
        if (m != nil) {
            var fi: u32 = 0;
            for (fi < m.function_len) {
                val f: *ir.Function = ?m.functions[fi];
                var bi: u32 = 0;
                for (bi < f.block_count) {
                    val b: *ir.Block = ?f.blocks[bi];
                    @phis = @phis + b.phi_count;
                    var k: u32 = 0;
                    for (k < b.phi_count) {
                        @dangling = @dangling + ut_dangling_ops(f, b.phis[k]);
                        k = k + 1;
                    }
                    k = 0;
                    for (k < b.instr_count) {
                        @dangling = @dangling + ut_dangling_ops(f, b.instructions[k]);
                        k = k + 1;
                    }
                    @dangling = @dangling + ut_dangling_ops(f, b.terminator);
                    bi = bi + 1;
                }
                fi = fi + 1;
            }
        }
        ti = ti + 1;
    }
}

# the fixture from #2917: a vector local whose lane feeds a conditional scalar merge
#
# `mx` is a[0] on the fall-through edge and a[1] on the taken one, so the merge phi
# sits in a block the lowerer emits BEFORE the block that computes the lanes. On a
# target with no vector unit the placement stage rewrites each lane read into a gep
# and a load, and the phi's fall-through incoming has to follow that rewrite even
# though its own block was walked first.
#
# Lowered at opt 2, and both the call and the vector local are load-bearing. At opt
# 0 the merge's fall-through incoming is a load out of `mx`'s own slot rather than
# the lane read. At opt 2 inlining `sink` SPLITS the entry block, and the halves
# after the split are appended past the end of the block array - which is what puts
# the block computing the lanes at a HIGHER index than the merge that reads them.
# Without the call every lane read precedes the merge in block order and the forward
# reference the substitution has to survive never forms.
fun ut_lane_merge_src() str {
    ret "fun sink(h: u64, v: f32) u64 { ret h + 1; }\n\npub fun probe(seed: u64) f32 {\n    val z: f32 = seed::f32;\n    var a: f32x4 = f32x4{1.5, -2.25, 3.75, -0.5};\n    a[0] = a[0] + z;\n    var h: u64 = 0;\n    h = sink(h, a[0]);\n    var mx: f32 = a[0];\n    if (a[1] > mx) { mx = a[1]; }\n    ret mx;\n}\n\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n";
}

# the three machine targets over a single opt-2 profile, so an empty profile
# selector resolves to it and the fixture lowers the way a release build does
fun ut_manifest_o2() str {
    ret "[project]\nid = \"uniontest\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.linux]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[target.linux-arm64]\nisa = \"aarch64\"\nos = \"linux\"\nabi = \"aapcs64\"\n\n[target.linux-riscv64]\nisa = \"riscv64\"\nos = \"linux\"\nabi = \"lp64d\"\n\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\n\n[artifact.uniontest]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/uniontest\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
}

# scaffold one-file `src` under the opt-2 manifest, select `target_name`, and run
# resolve + sema + lower so each module's `ir_module` carries its post-pipeline IR.
# the session is the caller's to tear down
fun ut_o2_lower(s: *session.Session, alloc: *A.Allocator, src: str, target_name: str) R.Result[project.Project, outcome.Fail] {
    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = src;
    val root_r: R.Result[str, str] = ut_scaffold_m(alloc, ut_manifest_o2(), ?names[0], ?texts[0], 1);
    if (R.is_err[str, str](root_r)) { ret R.err[project.Project, outcome.Fail](outcome.user(R.unwrap_err[str, str](root_r))); }
    val root: str = R.unwrap_ok[str, str](root_r);
    val rr: R.Result[bool, str] = driver.setup_registry(?s.registry);
    if (R.is_err[bool, str](rr)) { fs.remove_all(alloc, root); ret R.err[project.Project, outcome.Fail](outcome.user(R.unwrap_err[bool, str](rr))); }
    val pr: R.Result[project.Project, outcome.Fail] = driver.build_project(s, root, target_name);
    fs.remove_all(alloc, root);
    if (R.is_err[project.Project, outcome.Fail](pr)) { ret pr; }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);
    val se: R.Result[bool, outcome.Fail] = passes.run_sema_pass(?p);
    if (R.is_err[bool, outcome.Fail](se)) { project.dnit_project(?p); ret R.err[project.Project, outcome.Fail](R.unwrap_err[bool, outcome.Fail](se)); }
    val le: R.Result[bool, outcome.Fail] = passes.run_lower_pass(?p);
    if (R.is_err[bool, outcome.Fail](le)) { project.dnit_project(?p); ret R.err[project.Project, outcome.Fail](R.unwrap_err[bool, outcome.Fail](le)); }
    ret R.ok[project.Project, outcome.Fail](p);
}

# 0 when the fixture lowers for `target_name` with at least one surviving phi and no
# operand naming a dropped instruction; 1 on any other outcome
fun ut_lane_merge_operands_ok(target_name: str) i32 {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    val pr: R.Result[project.Project, outcome.Fail] = ut_o2_lower(?s, ?alloc, ut_lane_merge_src(), target_name);
    if (R.is_err[project.Project, outcome.Fail](pr)) { session.dnit(?s); ret 1; }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);

    var bad:      i32 = 0;
    var phis:     u32 = 0;
    var dangling: u32 = 0;
    ut_operand_audit(?p, ?phis, ?dangling);
    # the positive control: the merge the audit is about is actually there.
    if (phis == 0)     { bad = 1; }
    if (dangling != 0) { bad = 1; }

    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

# a lane read feeding a conditional merge keeps the phi pointing at the value that
# replaced it (#2917)
#
# The placement stage rewrites a lane read into a gep and a load, and its
# substitution has to be a WHOLE-FUNCTION step: the merge phi of an `if` sits at a
# lower block index than the block computing the condition's lanes, so rewriting a
# block's phis while later blocks were still unwalked left the fall-through incoming
# naming the dropped lane read. MIR phi destruction then emitted no copy on that
# edge and the merge register was read undefined - on riscv64 at -O2 the fixture
# returned 0x00000000 where every other leg returned 0x3fc00000.
#
# All three machine targets are checked, not only the one that was wrong: rv64 has
# no vector unit so the placement stage rewrites there, and the two capable targets
# are the standing controls that the whole-function substitution did not disturb a
# leg that was already right.
test "mach.lang.me.pass.scalarize:lane_merge_phi_keeps_its_incoming" {
    var bad: i32 = 0;
    if (ut_lane_merge_operands_ok("linux-riscv64") != 0) { bad = 1; }
    if (ut_lane_merge_operands_ok("linux") != 0)         { bad = 1; }
    if (ut_lane_merge_operands_ok("linux-arm64") != 0)   { bad = 1; }
    ret bad;
}

# the bits of module `m`'s global whose linkage name contains `needle`, when its
# initialiser is a folded float constant; -1 when there is no such global or it
# did not fold to one
#
# BITS, not a float value: a near miss and an exact answer are different u64s
# that an epsilon comparison would call equal, and -0.0 has to stay
# distinguishable from +0.0.
# ---
# s:      the session owning the interner
# m:      the lowered module
# needle: substring of the global's linkage name
# is_f32: true to read the value as its IEEE single pattern, false for double
# ret:    the bit pattern, or -1
fun ut_global_float_bits(s: *session.Session, m: *ir.Module, needle: str, is_f32: bool) i64 {
    val gi: i64 = ut_global_ix(s, m, needle);
    if (gi < 0) { ret 0 - 1; }
    val g: *ir.Global = ?m.globals[gi::u32];
    if (g.init.kind != value.VAL_CONST_FLOAT) { ret 0 - 1; }
    if (is_f32) { ret float.f64_to_f32_bits(float.f64_bits(g.init.data.float_lit))::i64; }
    ret float.f64_bits(g.init.data.float_lit)::i64;
}

# a comptime float constant is evaluated at its DECLARED width, rounding after
# every step of the chain (#2918)
#
# THE PROPERTY IS COMPTIME == RUN TIME for one expression. The evaluator carried
# every float in an f64 and never narrowed it, so an `f32` chain folded at double
# precision and the emitted constant disagreed with the identical computation at
# run time - the exact thing the codegen corpus case `comptime/ct_runtime_agree`
# exists to hold.
#
# `C` IS THE ONE THAT MATTERS. It is a multi-step chain of untyped literals at a
# declared `f32`, so it separates the three candidate rules that a single
# operation cannot: rounding nothing gives 0x3eaaaaab, rounding once at the end
# gives that same 0x3eaaaaab, and rounding after every step - what the running
# program does - gives 0x3eaaaab0. A fix that narrowed only at the binding would
# still pass on `A` and `B` alone.
#
# Every f32 assertion is paired with the run-time value of the identical
# expression, and with an f64 chain that must NOT move: the narrowing has to
# reach f32 without reaching the type the language says is already f64.
test "mach.lang.driver:a_comptime_float_folds_at_its_declared_width" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "val A: f32 = 16777217.0;\nval B: f32 = A - 16777216.0;\nval C: f32 = 1.0 / 3.0 * 7.0 - 2.0;\nval H: f32 = 1.0 / 3.0 * 0.1;\nval N: f32 = 0.0 - (1.0 / 3.0);\nval D: f64 = 1.0 / 3.0 * 7.0 - 2.0;\nval E: f64 = 16777217.0 - 16777216.0;\nfun main() i32 { ret 0; }\n";

    val pr: R.Result[project.Project, outcome.Fail] = ut_lower_n(?s, ?alloc, ?names[0], ?texts[0], 1);
    if (R.is_err[project.Project, outcome.Fail](pr)) { session.dnit(?s); ret 1; }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);

    # the run-time answers: the same expressions at the same declared types,
    # computed through the path the emitted program runs
    var ra: f32 = 16777217.0;
    var rb: f32 = ra - 16777216.0;
    var rc: f32 = 1.0 / 3.0 * 7.0 - 2.0;
    var rh: f32 = 1.0 / 3.0 * 0.1;
    var rn: f32 = 0.0 - (1.0 / 3.0);
    var rd: f64 = 1.0 / 3.0 * 7.0 - 2.0;
    var re: f64 = 16777217.0 - 16777216.0;

    var bad: i32 = 0;
    val m: *ir.Module = ut_ir_of(?p, ?s, "uniontest.main");
    if (m == nil) { bad = 1; }
    or {
        # a literal not representable in f32 IS its f32 rounding
        if (ut_global_float_bits(?s, m, "uniontest.main.A", true) != 0x4B800000)      { bad = 1; }
        if (ut_global_float_bits(?s, m, "uniontest.main.A", true) != (ra:~u32)::i64)  { bad = 1; }

        # so the difference is exactly zero, not the 1.0f (0x3F800000) the f64
        # subtraction produced
        if (ut_global_float_bits(?s, m, "uniontest.main.B", true) != 0x00000000)      { bad = 1; }
        if (ut_global_float_bits(?s, m, "uniontest.main.B", true) != (rb:~u32)::i64)  { bad = 1; }

        # THE MULTI-STEP DISCRIMINATOR: round at each step, not once at the end
        if (ut_global_float_bits(?s, m, "uniontest.main.C", true) != 0x3EAAAAB0)      { bad = 1; }
        if (ut_global_float_bits(?s, m, "uniontest.main.C", true) != (rc:~u32)::i64)  { bad = 1; }

        # an inexact literal beside an f32 operand is the f32 literal
        if (ut_global_float_bits(?s, m, "uniontest.main.H", true) != 0x3D088889)      { bad = 1; }
        if (ut_global_float_bits(?s, m, "uniontest.main.H", true) != (rh:~u32)::i64)  { bad = 1; }

        # negation keeps the width and stays a pure sign flip
        if (ut_global_float_bits(?s, m, "uniontest.main.N", true) != 0xBEAAAAAB)      { bad = 1; }
        if (ut_global_float_bits(?s, m, "uniontest.main.N", true) != (rn:~u32)::i64)  { bad = 1; }

        # POSITIVE CONTROLS: an f64 chain must not move. the digits that cancel
        # at f32 do not cancel at f64, and the f64 chain keeps every bit it had
        if (ut_global_float_bits(?s, m, "uniontest.main.D", false) != 0x3FD5555555555550) { bad = 1; }
        if (ut_global_float_bits(?s, m, "uniontest.main.D", false) != (rd:~u64)::i64)     { bad = 1; }
        if (ut_global_float_bits(?s, m, "uniontest.main.E", false) != 0x3FF0000000000000) { bad = 1; }
        if (ut_global_float_bits(?s, m, "uniontest.main.E", false) != (re:~u64)::i64)     { bad = 1; }
    }

    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

# a comptime GATE on a float constant reads it at the constant's width (#2918)
#
# The value path and the gate path are two different readers of the same folded
# constant, and a fix that reached only the first would leave `$if` selecting
# arms by a precision the program does not have. Both an equality and an
# ordering are held, because they are separate comparisons in the evaluator.
#
# EVERY ARM IS PAIRED WITH ITS f64 TWIN, which must select the OTHER way for the
# equality gate (16777217.0 - 16777216.0 is 1.0 at f64 and 0.0 at f32) and the
# SAME way for the ordering gate (0.1 is equal to itself at either width, once
# both sides are read at one width).
test "mach.lang.driver:a_comptime_gate_on_a_float_reads_it_at_its_width" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "val K: f32 = 16777217.0;\n$if (K - 16777216.0 == 0.0) { val G: i64 = 1; }\n$or { val G: i64 = 0; }\nval K64: f64 = 16777217.0;\n$if (K64 - 16777216.0 == 0.0) { val G64: i64 = 1; }\n$or { val G64: i64 = 0; }\nval P: f32 = 0.1;\n$if (P > 0.1) { val GT: i64 = 1; }\n$or { val GT: i64 = 0; }\nval P64: f64 = 0.1;\n$if (P64 > 0.1) { val GT64: i64 = 1; }\n$or { val GT64: i64 = 0; }\nfun main() i32 { ret 0; }\n";

    val pr: R.Result[project.Project, outcome.Fail] = ut_lower_n(?s, ?alloc, ?names[0], ?texts[0], 1);
    if (R.is_err[project.Project, outcome.Fail](pr)) { session.dnit(?s); ret 1; }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);

    var bad: i32 = 0;
    val m: *ir.Module = ut_ir_of(?p, ?s, "uniontest.main");
    if (m == nil) { bad = 1; }
    or {
        # at f32 the difference cancels, so the gate takes the first arm
        val gg: i64 = ut_global_ix(?s, m, "uniontest.main.G");
        if (gg < 0) { bad = 1; }
        or { if ((?m.globals[gg::u32]).init.data.int_lit != 1) { bad = 1; } }

        # POSITIVE CONTROL: the f64 twin does not cancel, and must not move
        val gg64: i64 = ut_global_ix(?s, m, "uniontest.main.G64");
        if (gg64 < 0) { bad = 1; }
        or { if ((?m.globals[gg64::u32]).init.data.int_lit != 0) { bad = 1; } }

        # an f32 constant against an untyped literal orders at f32, where the two
        # are one value; against the f64 `0.1` the f32 read as a double was greater
        val gt: i64 = ut_global_ix(?s, m, "uniontest.main.GT");
        if (gt < 0) { bad = 1; }
        or { if ((?m.globals[gt::u32]).init.data.int_lit != 0) { bad = 1; } }

        # POSITIVE CONTROL: the f64 twin was already equal and stays equal
        val gt64: i64 = ut_global_ix(?s, m, "uniontest.main.GT64");
        if (gt64 < 0) { bad = 1; }
        or { if ((?m.globals[gt64::u32]).init.data.int_lit != 0) { bad = 1; } }
    }

    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

# one descriptor's storage, seeded before a module runs
#
# A descriptor-bound block has no initializer: a host writes it, and nothing in the
# module says what is in it. Reading one back out of an all-zero block would report
# the same number whether every member arrived or none did, so the words go in from
# outside and come back through the shader's own arithmetic.
# ---
# set:   the descriptor set
# bind:  the binding
# words: the values, one per scalar member in declaration order
# n:     how many
rec UtSeed {
    set:   u32;
    bind:  u32;
    words: *u64;
    n:     u32;
}

# run a codegen'd module's entry point with descriptor storage seeded, and report the
# value it leaves in the interface variable decorated `Location loc`
#
# The evaluator lays a scalar out as one word, so a seed word per scalar member in
# declaration order IS the block's contents. A permuted or truncated copy therefore
# reads back a different number rather than the same total.
# ---
# alloc: the allocator backing the evaluator state
# img:   the codegen'd image
# loc:   the interface location to read
# seeds: the descriptors to fill before the entry point runs
# ns:    how many
# ret:   the value stored there, or UT_AGG_BAD
fun ut_spv_read_seeded(alloc: *A.Allocator, img: *of.ObjectImage, loc: u32,
                       seeds: *UtSeed, ns: u32) u64 {
    var n: u32 = 0;
    val w: *u32 = ut_spv_words(img, ?n);
    if (w == nil || n == 0) { ret UT_AGG_BAD; }

    val ar: R.Result[*UtAggEval, str] = A.allocate[UtAggEval](alloc, 1::usize);
    if (R.is_err[*UtAggEval, str](ar)) { ret UT_AGG_BAD; }
    val st: *UtAggEval = R.unwrap_ok[*UtAggEval, str](ar);
    ut_agg_reset(st);

    var out: u64 = UT_AGG_BAD;
    val tgt:   u32 = ut_agg_location_var(w, n, loc);
    val entry: u32 = ut_agg_entry_fn(w, n);
    var seeded: bool = true;
    if (ut_agg_prepare(st, w, n)) {
        var i: u32 = 0;
        for (i < ns) {
            val sd: *UtSeed = ?seeds[i];
            val v: u32 = ut_spv_descriptor_var(w, n, sd.set, sd.bind);
            if (v == 0 || v >= UT_AGG_IDS || sd.n > UT_AGG_WORDS) { seeded = false; i = ns; cnt; }
            var k: u32 = 0;
            for (k < sd.n) { st.val[v * UT_AGG_WORDS + k] = sd.words[k]; k = k + 1; }
            i = i + 1;
        }
    }
    or { seeded = false; }
    if (seeded && tgt != 0 && tgt < UT_AGG_IDS && entry != 0 && ut_agg_exec(st, w, n, entry)) {
        if (st.is_ptr[tgt] && st.ty_words[st.ptr_ty[tgt]] == 1) {
            out = st.val[st.ptr_blk[tgt] * UT_AGG_WORDS + st.ptr_off[tgt]];
        }
    }

    A.deallocate[UtAggEval](alloc, st, 1::usize);
    ret out;
}

# the shader the descriptor assertions read: a uniform block and a readonly storage
# block each handed to a helper whole, each copied whole into a local, and a padded
# record copied whole between two locals
#
# THE SHAPES ARE THE POINT. A descriptor-bound block is stored at its Block-decorated
# type and reaches a call at the plain one, so it is the only object in the language
# whose storage type and position type differ. `Plain` is `{u8, u32, u8}`, which has
# padding both before and after its wide member, so a copy that walked the object by
# machine word rather than as a value reads a member back out of a neighbour's bytes.
#
# EVERY CROSSING HAS AN INLINE CONTROL beside it: the same members, the same weights,
# read without crossing anything. Asserting the crossing alone would pass just as
# well if the whole fixture were mis-evaluated.
fun ut_spv_descriptor_value_src() str {
    ret "rec Blk { a: u32; b: u32; c: u32; }\nrec Plain { tag: u8; v: u32; tail: u8; }\n\n#[uniform(0, 0)] var ub: Blk;\n#[storage(1, 0, \"readonly\")] var sb: Blk;\n\nfun sum_blk(p: Blk) u32 { ret p.a + p.b * 10 + p.c * 100; }\nfun sum_plain(p: Plain) u32 { ret p.tag::u32 + p.v * 10 + p.tail::u32 * 100; }\n\n#[output(0)] var o_ub: u32;\n#[output(1)] var o_ub_ctl: u32;\n#[output(2)] var o_sb: u32;\n#[output(3)] var o_sb_ctl: u32;\n#[output(4)] var o_ub_copy: u32;\n#[output(5)] var o_rec: u32;\n#[output(6)] var o_rec_ctl: u32;\n\n#[stage(\"vertex\")]\nfun vs() {\n    o_ub = sum_blk(ub);\n    o_ub_ctl = ub.a + ub.b * 10 + ub.c * 100;\n    o_sb = sum_blk(sb);\n    o_sb_ctl = sb.a + sb.b * 10 + sb.c * 100;\n    var l: Blk = ub;\n    o_ub_copy = l.a + l.b * 10 + l.c * 100;\n    var r: Plain;\n    r.tag = ub.a::u8;\n    r.v = ub.b;\n    r.tail = ub.c::u8;\n    var r2: Plain = r;\n    o_rec = sum_plain(r2);\n    o_rec_ctl = r.tag::u32 + r.v * 10 + r.tail::u32 * 100;\n}\n\nfun main() i32 { ret 0; }\n";
}

# a whole descriptor block reaches a call by value, and a whole record reaches
# another local, with every member intact (#2922, #2926)
#
# WHAT WAS BROKEN, in two places that look like one. A global in a value position had
# its symbol address materialized into a register before the placement was made,
# which is a repair for a machine that records no relocation for a move's symbol
# operand and which destroys the direct reference logical addressing reaches an
# object through - so a `#[uniform]` block was refused before the whole-object
# transfer ran at all. Behind that, a block's storage carries its layout decorations
# and its Block-decorated struct is a DIFFERENT type from the plain one the same
# record has in a signature, so a load re-derived from the IR type produced an
# `OpLoad` whose result type did not match its pointer and a module a validator
# rejects, which the compiler wrote without complaint. The load now reads the
# variable's own type and `OpCopyLogical` carries the value to the position's.
#
# THE VALUES COME FROM OUTSIDE. The blocks are seeded with positional weights and the
# shader multiplies each member by its decimal place, so a copy that permutes,
# truncates, or drops a member reads back a different number. `Plain` is padded on
# both sides of its wide member, which is what a copy that walked machine words
# rather than the object gets wrong.
test "mach.lang.driver:a_descriptor_block_crosses_a_call_by_value_on_spirv" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    var names: [1]str;
    var texts: [1]str;
    names[0] = "main.mach"; texts[0] = ut_spv_descriptor_value_src();
    val pr: R.Result[project.Project, outcome.Fail] = ut_spv_lower(?s, ?alloc, ?names[0], ?texts[0], 1, "", nil, nil, 0);
    if (R.is_err[project.Project, outcome.Fail](pr)) { session.dnit(?s); ret 1; }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);

    var img: of.ObjectImage;
    var err: str = nil;
    if (!ut_spv_codegen(?p, ?s, "spvcase.main", ?img, ?err)) {
        project.dnit_project(?p); session.dnit(?s); ret 1;
    }

    var uw: [3]u64;
    uw[0] = 3::u64; uw[1] = 4::u64; uw[2] = 5::u64;
    var sw: [3]u64;
    sw[0] = 6::u64; sw[1] = 7::u64; sw[2] = 8::u64;
    var seeds: [2]UtSeed;
    seeds[0].set = 0; seeds[0].bind = 0; seeds[0].words = ?uw[0]; seeds[0].n = 3;
    seeds[1].set = 1; seeds[1].bind = 0; seeds[1].words = ?sw[0]; seeds[1].n = 3;

    var bad: i32 = 0;
    # the load reads the variable at the type it was DECLARED with, which no value
    # assertion can see: two identically-shaped types read back the same number
    var wn: u32 = 0;
    val ww: *u32 = ut_spv_words(?img, ?wn);
    if (ww == nil || wn == 0 || !ut_spv_var_loads_typed(ww, wn)) { bad = 1; }

    # 3 + 4*10 + 5*100, the uniform block's members in their declared positions
    if (ut_spv_read_seeded(?alloc, ?img, 0, ?seeds[0], 2) != 543) { bad = 1; }
    if (ut_spv_read_seeded(?alloc, ?img, 1, ?seeds[0], 2) != 543) { bad = 1; }
    # 6 + 7*10 + 8*100, the storage block's, which is a different storage class
    if (ut_spv_read_seeded(?alloc, ?img, 2, ?seeds[0], 2) != 876) { bad = 1; }
    if (ut_spv_read_seeded(?alloc, ?img, 3, ?seeds[0], 2) != 876) { bad = 1; }
    # the same block copied WHOLE into a local and read back from there
    if (ut_spv_read_seeded(?alloc, ?img, 4, ?seeds[0], 2) != 543) { bad = 1; }
    # a padded record copied whole between two locals, then handed to a helper
    if (ut_spv_read_seeded(?alloc, ?img, 5, ?seeds[0], 2) != 543) { bad = 1; }
    if (ut_spv_read_seeded(?alloc, ?img, 6, ?seeds[0], 2) != 543) { bad = 1; }

    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

# count, over a lowered MIR module, the symbol-address materializations and the
# whole-object calling-convention transfers
# ---
# mm:      the lowered MIR module
# out_agg: receives the number of MIR_AGG_LOAD / MIR_AGG_STORE instructions
# ret:     the number of MIR_GEP instructions carrying no index list, which is the
#          address materialization's flat form
fun ut_symaddr_and_agg(mm: *mir.MirModule, out_agg: *u32) u32 {
    var lea: u32 = 0;
    var ac:  u32 = 0;
    var fi: u32 = 0;
    for (fi < mm.function_len) {
        val mf: *mir.MirFunction = ?mm.functions[fi];
        var bi: u32 = 0;
        for (bi < mf.block_count) {
            val blk: *mir.MirBlock = ?mf.blocks[bi];
            var ii: u32 = 0;
            for (ii < blk.instr_count) {
                val mi: *mir.MirInstr = ?blk.instrs[ii];
                if (mi.opcode == mir.MIR_GEP && mi.operand_count == 2
                    && mi.operands[1].kind == mir.MIR_OP_SYM) { lea = lea + 1; }
                if (mi.opcode == mir.MIR_AGG_LOAD)  { ac = ac + 1; }
                if (mi.opcode == mir.MIR_AGG_STORE) { ac = ac + 1; }
                ii = ii + 1;
            }
            bi = bi + 1;
        }
        fi = fi + 1;
    }
    @out_agg = ac;
    ret lea;
}

# lower `src` for `tname` to MIR and report (symbol-address materializations, whole
# object transfers)
fun ut_symaddr_shape(alloc: *A.Allocator, src: str, tname: str, out_agg: *u32) i64 {
    val sr: R.Result[session.Session, str] = session.init(alloc);
    if (R.is_err[session.Session, str](sr)) { ret -1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    val pr: R.Result[project.Project, outcome.Fail] = ut_vec_lower(?s, alloc, src, tname);
    if (R.is_err[project.Project, outcome.Fail](pr)) { session.dnit(?s); ret -1; }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);
    var out: i64 = -1;
    var aggs: u32 = 0;
    var mi: u32 = 0;
    for (mi < p.module_len) {
        val me: *project.ModuleEntry = ?p.modules[mi];
        if (me.ir_module == nil) { mi = mi + 1; cnt; }
        val mr: R.Result[mir.MirModule, str] = mirlower.lower_ir(?p.target, me.ir_module, alloc, ?s.interner, ?s.sources);
        if (R.is_err[mir.MirModule, str](mr)) { mi = mi + 1; cnt; }
        var mm: mir.MirModule = R.unwrap_ok[mir.MirModule, str](mr);
        var ac: u32 = 0;
        val c: u32 = ut_symaddr_and_agg(?mm, ?ac);
        if (out < 0) { out = 0; }
        out = out + c::i64;
        aggs = aggs + ac;
        mi = mi + 1;
    }
    @out_agg = aggs;
    project.dnit_project(?p);
    session.dnit(?s);
    ret out;
}

# materializing a global's address into a register is a BYTE-SPACE repair, gated on
# the addressing model (#2926)
#
# THE FLAT TARGETS ARE THE HALF THAT MATTERS HERE. The materialization exists because
# a move records no relocation for its operand's symbol, so on a byte-addressed
# machine the address has to be in a register before the argument is placed. Removing
# it for everyone, rather than gating it, would take that repair away from three
# machine conventions at once and the fault would surface as a wrong address rather
# than as a refusal. So both sides are asserted: a logical-addressing target
# materializes nothing and carries the object whole, while every flat target still
# materializes the address and carries no whole-object transfer at all.
test "mach.lang.driver:a_symbol_address_materializes_only_on_a_flat_target" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }

    val ssrc: str = "rec P { a: u32; b: u32; }\n#[uniform(0, 0)] var blk: P;\nfun sum(p: P) u32 { ret p.a + p.b * 10; }\n#[output(0)] var o: u32;\n#[stage(\"vertex\")]\nfun vs() { o = sum(blk); }\nfun main() i32 { ret 0; }\n";
    val nsrc: str = "rec P { a: u32; b: u32; }\nvar g: P;\nfun sum(p: P) u32 { ret p.a + p.b * 10; }\nfun rd() u32 { ret sum(g); }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret rd()::i32; }\n";

    var bad: i32 = 0;

    var sa: u32 = 0;
    # the block reaches the call as the symbol itself, carried whole
    if (ut_symaddr_shape(?alloc, ssrc, "spirv", ?sa) != 0) { bad = 1; }
    if (sa < 1) { bad = 1; }

    var fa: u32 = 0;
    if (ut_symaddr_shape(?alloc, nsrc, "linux", ?fa)         < 1) { bad = 1; }
    if (fa != 0) { bad = 1; }
    if (ut_symaddr_shape(?alloc, nsrc, "linux-arm64", ?fa)   < 1) { bad = 1; }
    if (fa != 0) { bad = 1; }
    if (ut_symaddr_shape(?alloc, nsrc, "linux-riscv64", ?fa) < 1) { bad = 1; }
    if (fa != 0) { bad = 1; }

    ret bad;
}

# the pointee type of the pointer type an id was declared with, or 0
#
# Walks the declarations rather than a cached table so the answer comes from the
# module as written, which is the whole point of asking it.
# ---
# w, n: the instruction words
# var_id: the OpVariable id
# ret:  the pointee type id, or 0
fun ut_spv_var_pointee(w: *u32, n: u32, var_id: u32) u32 {
    var ptr_ty: u32 = 0;
    var i: u32 = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0) { ret 0; }
        if ((w[i] & 0xFFFF) == spirv.OP_VARIABLE && len >= 3 && w[i + 2] == var_id) {
            ptr_ty = w[i + 1];
            i = n; cnt;
        }
        i = i + len;
    }
    if (ptr_ty == 0) { ret 0; }
    i = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0) { ret 0; }
        if ((w[i] & 0xFFFF) == spirv.OP_TYPE_POINTER && len == 4 && w[i + 1] == ptr_ty) {
            ret w[i + 3];
        }
        i = i + len;
    }
    ret 0;
}

# whether every `OpLoad` straight off a module-scope variable reads it at the type
# the variable was declared with
#
# THE RULE A VALIDATOR ENFORCES AND A READ-BACK CANNOT SEE. An evaluator reading an
# object's words answers the same number whichever of two identically-shaped types
# the load names, so a load at the wrong type is invisible to every value assertion
# while being a module no driver will accept. A descriptor-bound block is where the
# two types genuinely differ, which is what makes this worth asking.
# ---
# w, n: the instruction words
# ret:  false when some load names a type its pointer does not hold
fun ut_spv_var_loads_typed(w: *u32, n: u32) bool {
    var i: u32 = 0;
    for (i < n) {
        val len: u32 = w[i] >> 16;
        if (len == 0) { ret false; }
        if ((w[i] & 0xFFFF) == spirv.OP_LOAD && len >= 4) {
            val pointee: u32 = ut_spv_var_pointee(w, n, w[i + 3]);
            if (pointee != 0 && pointee != w[i + 1]) { ret false; }
        }
        i = i + len;
    }
    ret true;
}
