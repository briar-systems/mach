    ret 0;
}

test "mach.lang.driver:lower_diagnostic_fails_build" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var bad: i32 = 0;

    val pk: str = ut_cc3(?alloc,
        "fun sink(va: ...) u32 { var acc: *u8 = nil; $each a in va { acc = a; } ret 0; }\n#[symbol(\"",
        ut_entry_symbol(), "\")]\nfun start() i32 { sink(7u32); ret 0; }\n");
    val ok: str = ut_cc3(?alloc,
        "fun sink(va: ...) u32 { var acc: u32 = 0; $each a in va { acc = acc + a; } ret acc; }\n#[symbol(\"",
        ut_entry_symbol(), "\")]\nfun start() i32 { sink(7::u32, 8::u32); ret 0; }\n");
    val ok_suffixed: str = ut_cc3(?alloc,
        "fun sink(va: ...) u32 { var acc: u32 = 0; $each a in va { acc = acc + a; } ret acc; }\n#[symbol(\"",
        ut_entry_symbol(), "\")]\nfun start() i32 { sink(7u32, 8u32); ret 0; }\n");

    if (!ut_sema_clean(pk))             { bad = 1; }
    if (ut_engine_build_fails(pk) != 0) { bad = 1; }

    if (ut_engine_build_fails(ok) == 0) { bad = 1; }
    if (!ut_sema_clean(ok))             { bad = 1; }

    if (ut_engine_build_fails(ok_suffixed) == 0) { bad = 1; }
    if (!ut_sema_clean(ok_suffixed))             { bad = 1; }

    ret bad;
}

test "mach.lang.driver:literal_suffix_is_the_literal_type" {
    var bad: i32 = 0;

    if (!ut_sema_clean("fun f() u32 { val x: u32 = 7u32; ret x; }\nfun main() i32 { ret 0; }\n"))   { bad = 1; }
    if (!ut_sema_clean("fun f() f32 { val x: f32 = 1.5f32; ret x; }\nfun main() i32 { ret 0; }\n")) { bad = 2; }
    if (!ut_sema_clean("fun f() i8 { val x: i8 = -128i8; ret x; }\nfun main() i32 { ret 0; }\n"))   { bad = 3; }

    if (ut_vec_diag("fun f() u64 { val x: u64 = 7u32; ret x; }\nfun main() i32 { ret 0; }\n",
        "type mismatch: expected") != 0) { bad = 4; }
    if (ut_vec_diag("fun f() f64 { val x: f64 = 1.5f32; ret x; }\nfun main() i32 { ret 0; }\n",
        "type mismatch: expected") != 0) { bad = 5; }
    if (ut_vec_diag("fun f() u32 { val x: u32 = 7u32 + 8u64; ret x; }\nfun main() i32 { ret 0; }\n",
        "are different types") != 0) { bad = 6; }

    ret bad;
}

