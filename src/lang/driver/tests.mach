test "mach.lang.driver:dep_closure_registers_transitive" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    val rr: R.Result[R.Void, str] = driver.setup_registry(?s.registry);
    if (R.is_err[R.Void, str](rr)) { session.dnit(?s); ret 1; }

    var names: [1]str; names[0] = "main.mach";
    var texts: [1]str; texts[0] = "fun main() i32 { ret 0; }\n";
    val root_r: R.Result[str, str] = ut_scaffold_m(?alloc, ut_dep_root_one(?alloc, "a", "./vendor/a"), ?names[0], ?texts[0], 1);
    if (R.is_err[str, str](root_r)) { session.dnit(?s); ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);

    var bad: i32 = 0;
    val a_manifest: str = ut_cc3(?alloc, ut_lib_manifest(?alloc, "alib"), "\n[dep.b]\npath = \"./vendor/b\"\n", "");
    val libsrc: str = "pub fun v() i32 { ret 1; }\n";
    val wa: O.Option[str] = ut_write_node(?alloc, ut_cc3(?alloc, root, "/", "dep/a"), a_manifest, "lib.mach", libsrc);
    val wb: O.Option[str] = ut_write_node(?alloc, ut_cc3(?alloc, root, "/", "dep/b"), ut_lib_manifest(?alloc, "blib"), "lib.mach", libsrc);
    if (O.is_some[str](wa) || O.is_some[str](wb)
        || !ut_git_repo(?alloc, root, "https://example.invalid/app.git")) {
        fs.remove_all(?alloc, root); session.dnit(?s); ret 1;
    }

    val pr: R.Result[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
    if (R.is_err[project.Project, outcome.Fail](pr)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);

    if (p.config.dep_count != 2) { bad = 1; }
    or {
        val a_id: intern.StrId = project.intern_unwrap(?s.interner, "alib");
        val b_id: intern.StrId = project.intern_unwrap(?s.interner, "blib");
        var saw_a: bool = false;
        var saw_b: bool = false;
        var a_idx: u32 = 0;
        var b_idx: u32 = 0;
        var i: u32 = 0;
        for (i < p.config.dep_count) {
            if (p.config.deps[i].project_id == a_id) { saw_a = true; a_idx = i; }
            if (p.config.deps[i].project_id == b_id) { saw_b = true; b_idx = i; }
            i = i + 1;
        }
        if (!saw_a || !saw_b) { bad = 1; }
        or {
            if (p.config.deps[a_idx].direct_count != 1
                || p.config.deps[a_idx].direct[0] != b_id) { bad = 1; }
            val b_root_opt: O.Option[str] = intern.lookup(?s.interner, p.config.deps[b_idx].vendor_root);
            if (O.is_none[str](b_root_opt)
                || !ut_native_path_is(?alloc, O.unwrap[str](b_root_opt), root, "dep/b")) { bad = 1; }
        }
    }

    val a_manifest_path: str = ut_cc3(?alloc, root, "/", "dep/a/mach.toml");
    if (O.is_some[str](fs.write_bytes(a_manifest_path, "not = [", 7, 420))) { bad = 1; }
    or {
        val isa_opt: O.Option[str] = intern.lookup(?s.interner, p.target_entry.isa_name);
        val os_opt: O.Option[str] = intern.lookup(?s.interner, p.target_entry.os_name);
        val abi_opt: O.Option[str] = intern.lookup(?s.interner, p.target_entry.abi_name);
        if (O.is_none[str](isa_opt) || O.is_none[str](os_opt) || O.is_none[str](abi_opt)) { bad = 1; }
        or {
            val step_r: R.Result[R.Void, str] = dcfg.execute_dep_steps(?p,
                O.unwrap[str](isa_opt), O.unwrap[str](os_opt), O.unwrap[str](abi_opt));
            if (R.is_err[R.Void, str](step_r)) { bad = 1; }
        }
    }

    project.dnit_project(?p);
    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.driver:cascade_libs_fail_at_n_releases_scratch" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    val rr: R.Result[R.Void, str] = driver.setup_registry(?s.registry);
    if (R.is_err[R.Void, str](rr)) { session.dnit(?s); ret 1; }

    var names: [1]str; names[0] = "main.mach";
    var texts: [1]str; texts[0] = "fun main() i32 { ret 0; }\n";
    val root_r: R.Result[str, str] = ut_scaffold_m(?alloc,
        ut_dep_root_two(?alloc, "a", "./vendor/a", "b", "./vendor/b"), ?names[0], ?texts[0], 1);
    if (R.is_err[str, str](root_r)) { session.dnit(?s); ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);

    val a_manifest: str = ut_dep_lib_with_export(?alloc, "alib");
    val b_manifest: str = ut_lib_manifest(?alloc, "blib");
    val libsrc: str = "pub fun v() i32 { ret 1; }\n";
    val wa: O.Option[str] = ut_write_node(?alloc, ut_cc3(?alloc, root, "/", "dep/a"), a_manifest, "lib.mach", libsrc);
    if (O.is_some[str](wa)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    val wb: O.Option[str] = ut_write_node(?alloc, ut_cc3(?alloc, root, "/", "dep/b"), b_manifest, "lib.mach", libsrc);
    if (O.is_some[str](wb) || !ut_git_repo(?alloc, root, "https://example.invalid/app.git")) {
        fs.remove_all(?alloc, root); session.dnit(?s); ret 1;
    }

    val pr: R.Result[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
    if (R.is_err[project.Project, outcome.Fail](pr)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);

    var bad: i32 = 0;
    if (p.config.dep_count != 2) { bad = 1; }
    or {
        val isa_opt: O.Option[str] = intern.lookup(?s.interner, p.target_entry.isa_name);
        val os_opt: O.Option[str] = intern.lookup(?s.interner, p.target_entry.os_name);
        val abi_opt: O.Option[str] = intern.lookup(?s.interner, p.target_entry.abi_name);
        if (O.is_none[str](isa_opt) || O.is_none[str](os_opt) || O.is_none[str](abi_opt)) { bad = 1; }
        or {
            val isa_s: str = O.unwrap[str](isa_opt);
            val os_s: str = O.unwrap[str](os_opt);
            val abi_s: str = O.unwrap[str](abi_opt);
            val orig_alloc: *A.Allocator = p.alloc;

            var fail_at: u32 = 1;
            val scratch_construction_fail_at_max: u32 = 3;
            for (fail_at <= scratch_construction_fail_at_max && bad == 0) {
                if (p.config.cascade_libs != nil && p.config.cascade_lib_count > 0) {
                    manifest.free_link_claims(orig_alloc, p.config.cascade_libs, p.config.cascade_lib_count);
                    A.deallocate[manifest.LinkRequirement](orig_alloc, p.config.cascade_libs, p.config.cascade_lib_count::usize);
                    p.config.cascade_libs      = nil;
                    p.config.cascade_lib_count = 0;
                }

                var probe: DepsScratchProbe;
                var probe_alloc: A.Allocator;
                if (!deps_scratch_probe_make(?probe, ?probe_alloc, fail_at)) { bad = 1; brk; }
                p.alloc = ?probe_alloc;
                val cr: R.Result[R.Void, str] = ddep.resolve_cascade_libs(?p, isa_s, os_s, abi_s,
                    p.target_entry.libs, p.target_entry.lib_count);
                p.alloc = orig_alloc;

                val pre_diagnostic_fail_at_max: u32 = 3;
                if (R.is_ok[R.Void, str](cr)) { bad = 1; }
                or {
                    if (fail_at <= pre_diagnostic_fail_at_max) {
                        if (probe.live != 0 || probe.live_count != 0) { bad = 1; }
                    }
                    or {
                        val retained_diagnostic_string_count: i64 = 1;
                        if (probe.live_count > retained_diagnostic_string_count) { bad = 1; }
                    }
                }

                fail_at = fail_at + 1;
            }
        }
    }

    project.dnit_project(?p);
    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

