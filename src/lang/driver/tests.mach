    if (R.is_err[project.Project, outcome.Fail](pr)) { session.dnit(?s); ret 1; }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);

    var bad: i32 = 0;
    if (ut_has(?p, ?s, "uniontest.a"))  { bad = 1; }
    or (!ut_has(?p, ?s, "uniontest.b")) { bad = 1; }

    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

# driver union: a non-default module that fails to resolve degrades gracefully (#1391)
test "mach.lang.driver:union_unresolvable_module_degrades_gracefully" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    var names: [3]str;
    names[0] = "main.mach"; names[1] = "a.mach"; names[2] = "b.mach";
    var texts: [3]str;
    texts[0] = "$if ($mach.build.os == $mach.os.linux) { use uniontest.a; }\n$or ($mach.build.os == $mach.os.windows) { use uniontest.b; }\n\nfun main() i32 { ret 0; }\n";
    texts[1] = "pub fun fa() i32 { ret 1; }\n";
    # b references an undefined symbol, so it fails to resolve under the default ctx.
    texts[2] = "pub fun fb() i32 { ret undefined_symbol_xyz; }\n";

    val pr: R.Result[project.Project, outcome.Fail] = ut_build(?s, ?alloc, ?names[0], ?texts[0], 3);
    # the union build must NOT abort on a per-module resolve failure.
    if (R.is_err[project.Project, outcome.Fail](pr)) { session.dnit(?s); ret 1; }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);

    # the broken module is still loaded (tooling sees it) and its failure surfaces as
    # a diagnostic rather than aborting the whole Project.
    var bad: i32 = 0;
    if (!ut_has(?p, ?s, "uniontest.b"))   { bad = 1; }
    or (!diagnostic.has_errors(?s.diags)) { bad = 1; }

    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

# driver union: a malformed branch condition is reported once, not once per target (#1391)
test "mach.lang.driver:union_malformed_condition_reported_once" {
    # build the same malformed-condition project two ways - a single-target build and
    # the multi-target union - and require equal error counts. the union evaluates the
    # condition under every target tuple but emits diagnostics only under the default
    # one, so it must not multiply the condition error per target.
    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "$if (5) { use uniontest.a; }\n\nfun main() i32 { ret 0; }\n";

    var a1: A.Allocator;
    if (O.is_some[str](page.make(?a1))) { ret 1; }
    val sr1: R.Result[session.Session, str] = session.init(?a1);
    if (R.is_err[session.Session, str](sr1)) { ret 1; }
    var s1: session.Session = R.unwrap_ok[session.Session, str](sr1);
    val root1_r: R.Result[str, str] = ut_scaffold(?a1, ?names[0], ?texts[0], 1);
    if (R.is_err[str, str](root1_r)) { session.dnit(?s1); ret 1; }
    val root1: str = R.unwrap_ok[str, str](root1_r);
    val rr1: R.Result[bool, str] = driver.setup_registry(?s1.registry);
    if (R.is_err[bool, str](rr1)) { fs.remove_all(?a1, root1); session.dnit(?s1); ret 1; }
    var sel: manifest.Selection;
    sel.target = ""; sel.profile = ""; sel.artifact = ""; sel.want_lib = false; sel.has_artifact = false;
    val p1r: R.Result[project.Project, outcome.Fail] = driver.build_project_sel(?s1, root1, ?sel);
    fs.remove_all(?a1, root1);
    if (R.is_err[project.Project, outcome.Fail](p1r)) { session.dnit(?s1); ret 1; }
    var p1: project.Project = R.unwrap_ok[project.Project, outcome.Fail](p1r);
    val single_errs: u32 = ut_count_errors(?s1.diags);

    var a2: A.Allocator;
    if (O.is_some[str](page.make(?a2))) { project.dnit_project(?p1); session.dnit(?s1); ret 1; }
    val sr2: R.Result[session.Session, str] = session.init(?a2);
    if (R.is_err[session.Session, str](sr2)) { project.dnit_project(?p1); session.dnit(?s1); ret 1; }
    var s2: session.Session = R.unwrap_ok[session.Session, str](sr2);
    val p2r: R.Result[project.Project, outcome.Fail] = ut_build(?s2, ?a2, ?names[0], ?texts[0], 1);
    if (R.is_err[project.Project, outcome.Fail](p2r)) { project.dnit_project(?p1); session.dnit(?s1); session.dnit(?s2); ret 1; }
    var p2: project.Project = R.unwrap_ok[project.Project, outcome.Fail](p2r);
    val union_errs: u32 = ut_count_errors(?s2.diags);

    var bad: i32 = 0;
    if (single_errs == 0)          { bad = 1; }
    or (union_errs != single_errs) { bad = 1; }

    project.dnit_project(?p1);
    project.dnit_project(?p2);
    session.dnit(?s1);
    session.dnit(?s2);
    ret bad;
}

# driver union: branch selection via the $project.target.os string tag exercises and restores the StrId tuple (#1391)
test "mach.lang.driver:union_string_tag_branch_selection_restores_strid_tuple" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    var names: [3]str;
    names[0] = "main.mach"; names[1] = "a.mach"; names[2] = "b.mach";
    var texts: [3]str;
    # gate on the $project.target.os STRING tag (the StrId-backed ctx field), not the
    # numeric $mach.build.os - so the per-target StrId override and its restore are both
    # load-bearing (the numeric-tag tests would pass even with a broken StrId restore).
    texts[0] = "$if ($project.target.os == \"linux\") { use uniontest.a; }\n$or ($project.target.os == \"windows\") { use uniontest.b; }\n\nfun main() i32 { ret 0; }\n";
    texts[1] = "pub fun fa() i32 { ret 1; }\n";
    texts[2] = "pub fun fb() i32 { ret 2; }\n";

    val pr: R.Result[project.Project, outcome.Fail] = ut_build(?s, ?alloc, ?names[0], ?texts[0], 3);
    if (R.is_err[project.Project, outcome.Fail](pr)) { session.dnit(?s); ret 1; }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);

    var bad: i32 = 0;
    # both string-gated branches are taken - the per-target StrId override drives selection.
    if (!ut_has(?p, ?s, "uniontest.a")) { bad = 1; }
    or (!ut_has(?p, ?s, "uniontest.b")) { bad = 1; }

    # the StrId tuple fields (target_os/isa/abi) must be restored to the default after
    # the walk: main runs the union $if walk, a and b do not, so a broken StrId restore
    # would leave main carrying a non-default tuple while a/b keep the default.
    val cm: *comptime.ComptimeCtx = ut_ctx(?p, ?s, "uniontest.main");
    val ca: *comptime.ComptimeCtx = ut_ctx(?p, ?s, "uniontest.a");
    val cb: *comptime.ComptimeCtx = ut_ctx(?p, ?s, "uniontest.b");
    if (cm == nil || ca == nil || cb == nil) { bad = 1; }
    or (cm.target_os != ca.target_os)        { bad = 1; }
    or (cm.target_os != cb.target_os)        { bad = 1; }
    or (cm.target_isa != ca.target_isa)      { bad = 1; }
    or (cm.target_isa != cb.target_isa)      { bad = 1; }
    or (cm.target_abi != ca.target_abi)      { bad = 1; }
    or (cm.target_abi != cb.target_abi)      { bad = 1; }

    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

# driver union: a taken branch's body that reallocates p.modules does not dangle the next branch's deref (#1540)
test "mach.lang.driver:union_realloc_midwalk_no_dangling_deref" {
    # regression for the use-after-realloc in walk_comptime_if_union: it cached
    # `m: *ModuleEntry` (Ast embedded by value) and deref'd m.a.comptime_branches
    # per taken branch. the windows branch (taken first) imports enough modules to
    # grow p.modules mid-walk, moving the array and dangling m; pre-fix the next
    # taken (linux) branch read the freed m.a.comptime_branches -> SIGSEGV. needs
    # all three: union mode, 2+ taken branches diverging on OS, and an earlier
    # taken branch crossing the INITIAL_MODULE_CAP boundary.
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    var names: [26]str;
    var texts: [26]str;
    val n: u32 = ut_realloc_fixture(?alloc, ?names[0], ?texts[0]);

    val pr: R.Result[project.Project, outcome.Fail] = ut_build(?s, ?alloc, ?names[0], ?texts[0], n);
    if (R.is_err[project.Project, outcome.Fail](pr)) { session.dnit(?s); ret 1; }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);

    # both branches' closures land in the union: the windows leaves AND the linux
    # leaf. spot-check the first/last windows leaf and the linux leaf, plus that
    # the realloc actually happened (module_len past INITIAL_MODULE_CAP).
    var bad: i32 = 0;
    if (!ut_has(?p, ?s, "uniontest.main"))  { bad = 1; }
    or (!ut_has(?p, ?s, "uniontest.w00"))   { bad = 1; }
    or (!ut_has(?p, ?s, "uniontest.w23"))   { bad = 1; }
    or (!ut_has(?p, ?s, "uniontest.lx"))    { bad = 1; }
    or (p.module_len <= load.INITIAL_MODULE_CAP) { bad = 1; }

    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

# driver union: every artifact's entry closure is loaded, not just the primary's (#1505)
test "mach.lang.driver:union_all_artifact_entries_loaded" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    var names: [4]str;
    names[0] = "alpha.mach"; names[1] = "beta.mach"; names[2] = "shared_a.mach"; names[3] = "beta_only.mach";
    var texts: [4]str;
    # alpha is the primary (first declared) bin; beta is a second bin. beta_only is
    # reachable ONLY from beta's entry - a single-artifact build resolving alpha alone
    # would never see it, so its presence proves the artifact axis is unioned.
    texts[0] = "use uniontest.shared_a;\n\nfun main() i32 { ret 0; }\n";
    texts[1] = "use uniontest.beta_only;\n\nfun main() i32 { ret 0; }\n";
    texts[2] = "pub fun sa() i32 { ret 1; }\n";
    texts[3] = "pub fun bo() i32 { ret 2; }\n";

    val pr: R.Result[project.Project, outcome.Fail] = ut_build_multi(?s, ?alloc, ?names[0], ?texts[0], 4);
    if (R.is_err[project.Project, outcome.Fail](pr)) { session.dnit(?s); ret 1; }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);

    # both artifacts' entries and their closures land in one deduplicated Project.
    var bad: i32 = 0;
    if (!ut_has(?p, ?s, "uniontest.alpha"))     { bad = 1; }
    or (!ut_has(?p, ?s, "uniontest.beta"))      { bad = 1; }
    or (!ut_has(?p, ?s, "uniontest.shared_a"))  { bad = 1; }
    or (!ut_has(?p, ?s, "uniontest.beta_only")) { bad = 1; }

    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

# driver union: an ambiguous multi-artifact default errors for a single build but loads for the union (#1505)
test "mach.lang.driver:union_ambiguous_multi_artifact_default" {
    # the SAME multi-artifact project, built three ways on one reused session: a
    # selector-less single build is ambiguous and must error; a --bin alpha build
    # loads only alpha's closure (never beta_only); the union loads every artifact.
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    val rr: R.Result[bool, str] = driver.setup_registry(?s.registry);
    if (R.is_err[bool, str](rr)) { session.dnit(?s); ret 1; }

    var names: [4]str;
    names[0] = "alpha.mach"; names[1] = "beta.mach"; names[2] = "shared_a.mach"; names[3] = "beta_only.mach";
    var texts: [4]str;
    texts[0] = "use uniontest.shared_a;\n\nfun main() i32 { ret 0; }\n";
    texts[1] = "use uniontest.beta_only;\n\nfun main() i32 { ret 0; }\n";
    texts[2] = "pub fun sa() i32 { ret 1; }\n";
    texts[3] = "pub fun bo() i32 { ret 2; }\n";

    val root_r: R.Result[str, str] = ut_scaffold_m(?alloc, ut_manifest_multi(), ?names[0], ?texts[0], 4);
    if (R.is_err[str, str](root_r)) { session.dnit(?s); ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);

    var bad: i32 = 0;

    # 1) no selector: the ambiguity error build_project_sel raises must still fire.
    var sel_none: manifest.Selection;
    sel_none.target = ""; sel_none.profile = ""; sel_none.artifact = ""; sel_none.want_lib = false; sel_none.has_artifact = false;
    val p0r: R.Result[project.Project, outcome.Fail] = driver.build_project_sel(?s, root, ?sel_none);
    if (R.is_ok[project.Project, outcome.Fail](p0r)) { var p0: project.Project = R.unwrap_ok[project.Project, outcome.Fail](p0r); project.dnit_project(?p0); bad = 1; }

    # 2) --bin alpha: the single-selected build loads alpha's closure and NOT beta's.
    var sel_alpha: manifest.Selection;
    sel_alpha.target = ""; sel_alpha.profile = ""; sel_alpha.artifact = "alpha"; sel_alpha.want_lib = false; sel_alpha.has_artifact = true;
    val par: R.Result[project.Project, outcome.Fail] = driver.build_project_sel(?s, root, ?sel_alpha);
    if (R.is_err[project.Project, outcome.Fail](par)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    var pa: project.Project = R.unwrap_ok[project.Project, outcome.Fail](par);
    if (!ut_has(?pa, ?s, "uniontest.alpha"))    { bad = 1; }
    or (!ut_has(?pa, ?s, "uniontest.shared_a")) { bad = 1; }
    or (ut_has(?pa, ?s, "uniontest.beta"))      { bad = 1; }
    or (ut_has(?pa, ?s, "uniontest.beta_only")) { bad = 1; }
    project.dnit_project(?pa);

    # 3) the union loads every artifact, including the beta-only module.
    val pur: R.Result[project.Project, outcome.Fail] = driver.build_project_union(?s, root);
    if (R.is_err[project.Project, outcome.Fail](pur)) { fs.remove_all(?alloc, root); session.dnit(?s); ret 1; }
    var pu: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pur);
    if (!ut_has(?pu, ?s, "uniontest.alpha"))     { bad = 1; }
    or (!ut_has(?pu, ?s, "uniontest.beta"))      { bad = 1; }
    or (!ut_has(?pu, ?s, "uniontest.beta_only")) { bad = 1; }
    project.dnit_project(?pu);

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

