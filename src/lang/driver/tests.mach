test "mach.lang.driver:dep_transitive_manifest_failures_are_not_leaves" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    if (R.is_err[R.Void, str](driver.setup_registry(?s.registry))) { session.dnit(?s); ret 1; }

    var names: [1]str; names[0] = "main.mach";
    var texts: [1]str; texts[0] = "fun main() i32 { ret 0; }\n";
    val root_r: R.Result[str, str] = ut_scaffold_m(?alloc,
        ut_dep_root_one(?alloc, "a", "../source-a"), ?names[0], ?texts[0], 1);
    if (R.is_err[str, str](root_r)) { session.dnit(?s); ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);
    val a_manifest: str = ut_cc3(?alloc, ut_lib_manifest(?alloc, "a"),
        "\n[dep.b]\npath = \"../source-b\"\n", "");
    val a_root: str = ut_cc3(?alloc, root, "/", "dep/a");
    val b_root: str = ut_cc3(?alloc, root, "/", "dep/b");
    if (O.is_some[str](ut_write_node(?alloc, a_root, a_manifest, "lib.mach", "pub fun a() i32 { ret 1; }\n"))
        || O.is_some[str](ut_write_node(?alloc, b_root, "not = [", "lib.mach", "pub fun b() i32 { ret 2; }\n"))
        || !ut_git_repo(?alloc, root, "https://example.invalid/app.git")) {
        fs.remove_all(?alloc, root); session.dnit(?s); ret 1;
    }

    var bad: i32 = 0;
    if (!ut_dep_build_fails(?s, root, "dep 'b'")) { bad = 1; }
    val b_manifest: str = ut_cc3(?alloc, b_root, "/", manifest.MANIFEST_FILE);
    val b_manifest_marker: str = ut_cc3(?alloc, b_manifest, "/", "keep");
    if (O.is_some[str](fs.remove_file(b_manifest))
        || O.is_some[str](fs.create_dir_all(?alloc, b_manifest, 493))
        || O.is_some[str](fs.write_bytes(b_manifest_marker, "keep\n", 5, 420))
        || !ut_git_commit_all(?alloc, root, "replace transitive manifest with directory")
        || !ut_dep_build_fails(?s, root, "cannot read")) { bad = 1; }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

