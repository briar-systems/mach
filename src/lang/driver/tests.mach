test "mach.lang.driver:naked_body_admits_only_asm" {
    val restrict: str = "a `naked` function's body may contain only inline `asm` statements";

    if (ut_vec_diag("#[naked]\nfun f() { var x: i64 = 0; }\n", restrict) != 0)                                                                               { ret 1; }
    if (ut_vec_diag("#[naked]\nfun f() { g(); }\nfun g() {}\n", restrict) != 0)                                                                              { ret 1; }
    if (ut_vec_diag("#[naked]\nfun f() i64 { ret 1; }\n", restrict) != 0)                                                                                    { ret 1; }
    if (ut_vec_diag("#[naked]\nfun f() { for (false) {} }\n", restrict) != 0)                                                                                { ret 1; }
    if (ut_vec_diag("#[naked]\nfun f() { if (false) {} }\n", restrict) != 0)                                                                                 { ret 1; }
    if (ut_vec_diag("#[naked]\next fun f();\n", "`naked` decorator applies only to a function with a body") != 0)                                            { ret 1; }
    if (!ut_sema_clean("#[naked]\nfun f() { asm x86_64 { nop } }\n"))                                                                                        { ret 1; }
    if (!ut_sema_clean("#[naked]\nfun f() {\n    $if ($mach.build.arch == $mach.arch.x86_64) { asm x86_64 { nop } }\n    $or { asm aarch64 { nop } }\n}\n")) { ret 1; }
    ret 0;
}

test "mach.lang.driver:naked_decorator_rejections" {
    if (ut_vec_diag("#[naked] #[inline]\nfun f() { asm x86_64 { nop } }\n",
        "`naked` and `inline` decorators are mutually exclusive; a naked function cannot be inlined") != 0) { ret 1; }
    if (ut_vec_diag("#[naked] #[oblivious]\nfun f() { asm x86_64 { nop } }\n",
        "`naked` and `oblivious` decorators are mutually exclusive; a naked body is inline asm, which `oblivious` forbids") != 0) { ret 1; }
    if (ut_vec_diag("#[naked]\nvar g: i64 = 0;\n",
        "`naked` decorator applies only to functions") != 0) { ret 1; }
    if (ut_vec_diag("#[naked(1)]\nfun f() { asm x86_64 { nop } }\n",
        "`naked` decorator takes no arguments") != 0) { ret 1; }
    ret 0;
}

test "mach.lang.driver:incremental_lower_isolated_edit_reuses_sibling" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var sA:               session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(sA.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?sA);
        ret 1;
    }

    var names: [3]str;
    names[0] = "main.mach";
    names[1] = "a.mach";
    names[2] = "b.mach";
    var texts: [3]str;
    texts[0] = "use uniontest.a.fa;\nuse uniontest.b.fb;\nfun main() i32 { ret fa() + fb(); }\n";
    texts[1] = "pub fun fa() i32 { ret 1; }\n";
    texts[2] = "pub fun fb() i32 { ret 2; }\n";

    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 3);
    if (sel root_r.err) {
        session.dnit(?sA);
        ret 1;
    }
    val root: str = root_r.ok;

    var bad: i32 = 0;

    val p1r: res[project.Project, outcome.Fail] = driver.build_project_union(?sA, root);
    if (sel p1r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var p1:              project.Project   = p1r.ok;
    val run_sema_pass_r: err[outcome.Fail] = driver.run_sema_pass(?p1);
    if (sel run_sema_pass_r.err) {
        project.dnit_project(?p1);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    val run_lower_pass_r: err[outcome.Fail] = driver.run_lower_pass(?p1);
    if (sel run_lower_pass_r.err) {
        project.dnit_project(?p1);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    val st_main:   session.StableModuleId = ut_stable(?p1, ?sA, "uniontest.main");
    val st_a:      session.StableModuleId = ut_stable(?p1, ?sA, "uniontest.a");
    val st_b:      session.StableModuleId = ut_stable(?p1, ?sA, "uniontest.b");
    val lc_main_1: query.Revision         = ut_lower_lc(?sA, st_main);
    val lc_a_1:    query.Revision         = ut_lower_lc(?sA, st_a);
    val lc_b_1:    query.Revision         = ut_lower_lc(?sA, st_b);
    project.dnit_project(?p1);

    val src_dir:       str             = ut_cc3(?alloc, root, "/", "src");
    val a_path:        str             = ut_cc3(?alloc, src_dir, "/", "a.mach");
    val a_v2:          str             = "pub fun fa() i32 { val t: i32 = 1; ret t; }\n";
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(a_path, a_v2, str_len(a_v2), 420);
    if (sel write_bytes_r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }

    val p2r: res[project.Project, outcome.Fail] = driver.build_project_union(?sA, root);
    if (sel p2r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var p2:               project.Project   = p2r.ok;
    val run_sema_pass_r2: err[outcome.Fail] = driver.run_sema_pass(?p2);
    if (sel run_sema_pass_r2.err) {
        project.dnit_project(?p2);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    val run_lower_pass_r2: err[outcome.Fail] = driver.run_lower_pass(?p2);
    if (sel run_lower_pass_r2.err) {
        project.dnit_project(?p2);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    val lc_main_2: query.Revision = ut_lower_lc(?sA, st_main);
    val lc_a_2:    query.Revision = ut_lower_lc(?sA, st_a);
    val lc_b_2:    query.Revision = ut_lower_lc(?sA, st_b);
    project.dnit_project(?p2);

    if (lc_a_2 == lc_a_1)       { bad = 1; }
    if (lc_main_2 != lc_main_1) { bad = 1; }
    if (lc_b_2 != lc_b_1)       { bad = 1; }

    fs.remove_all(?alloc, root);
    session.dnit(?sA);
    ret bad;
}

