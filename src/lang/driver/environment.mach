use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.fail;
use mach.lang.host;
use collections_vector: std.collections.vector;
use std.collections.vector.Vector;
use std_format: std.format;
use std.process.env;
use std.process.exec;
use std.runtime.native.view.NativeName;
use std.runtime.native.view.Unit;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use A: std.allocator;

# one variable, NAME=value in std.runtime.native units, so an inherited
# variable with no UTF-8 spelling is carried as it is
# ---
# units:  the entry, owned and terminated
# length: its length in units
# name:   the units of its name, before its first '='
pub rec Entry {
    units:  *Unit;
    length: usize;
    name:   usize;
}

# a child's environment, one entry per name by the host's name identity
pub rec Environment {
    entries: Vector[Entry];
}

# a nil-terminated array of native NAME=value entries, owned, for
# exec.NativeEnvironment.given
pub rec Strings {
    items: **Unit;
    count: u32;
}

pub fun init(a: *A.Allocator) Environment {
    ret Environment{entries: collections_vector.init[Entry](a)};
}

# release an entry's native text; an empty entry owns none
pub fun entry_free(a: *A.Allocator, entry: *Entry) {
    if (entry.units == nil) { ret; }
    A.deallocate[Unit](a, entry.units, entry.length + 1);
    entry.units  = nil;
    entry.length = 0;
    entry.name   = 0;
}

pub fun dnit(values: *Environment) {
    var i: usize = 0;
    for (i < values.entries.len) {
        entry_free(values.entries.a, ?values.entries.data[i]);
        i = i + 1;
    }
    collections_vector.dnit[Entry](?values.entries);
}

# the length of a native entry's name, its units before the first '=', or a
# refusal when it has no name or no '='
fun entry_name(units: *Unit, length: usize) res[usize, fail.Fail] {
    var name: usize = 0;
    for (name < length && units[name] != '='::Unit) { name = name + 1; }
    if (name == 0 || name == length) {
        ret res[usize, fail.Fail].err{fail.message("environment entry must have a name and '='")};
    }
    ret res[usize, fail.Fail].ok{name};
}

# a native entry copied from `units`, nul-terminated
pub fun entry_native(a: *A.Allocator, units: *Unit) res[Entry, fail.Fail] {
    if (units == nil) { ret res[Entry, fail.Fail].err{fail.message("environment entry is nil")}; }
    var length: usize = 0;
    for (units[length] != 0) { length = length + 1; }
    val nr: res[usize, fail.Fail] = entry_name(units, length);
    if (sel nr.err) { ret res[Entry, fail.Fail].err{nr.err}; }
    val cr: res[*Unit, A.Error] = A.allocate[Unit](a, length + 1);
    if (sel cr.err) { ret res[Entry, fail.Fail].err{fail.refused(cr.err)}; }
    var i: usize = 0;
    for (i <= length) {
        cr.ok[i] = units[i];
        i        = i + 1;
    }
    ret res[Entry, fail.Fail].ok{Entry{units: cr.ok, length: length, name: nr.ok}};
}

# a UTF-8 NAME=value entry in native units
pub fun entry_text(a: *A.Allocator, text: str) res[Entry, fail.Fail] {
    if (text == nil) { ret res[Entry, fail.Fail].err{fail.message("environment entry is nil")}; }
    var split: usize = 0;
    for (text[split] != 0 && text[split] != '=') { split = split + 1; }
    if (split == 0 || text[split] != '=') {
        ret res[Entry, fail.Fail].err{fail.message("environment entry must have a name and '='")};
    }
    val cr: res[NativeName, host.NativeTextError] = host.native_text(a, text);
    if (sel cr.err) { ret res[Entry, fail.Fail].err{fail.message(host.native_text_message(cr.err))}; }
    var converted: NativeName            = cr.ok;
    val nr:        res[usize, fail.Fail] = entry_name(converted.units, converted.length);
    if (sel nr.err) {
        host.native_text_free(a, ?converted);
        ret res[Entry, fail.Fail].err{nr.err};
    }
    ret res[Entry, fail.Fail].ok{Entry{units: converted.units, length: converted.length, name: nr.ok}};
}

# add `entry`, which the environment takes: a name already present keeps its
# value unless `replace`, and the entry not kept is released
pub fun put_owned(values: *Environment, entry: Entry, replace: bool) err[fail.Fail] {
    val a:     *A.Allocator = values.entries.a;
    var owned: Entry        = entry;
    var kept:  bool         = false;
    fin {
        if (!kept) { entry_free(a, ?owned); }
    }
    var found: usize = values.entries.len;
    var i:     usize = 0;
    for (i < values.entries.len) {
        val held:  *Entry              = ?values.entries.data[i];
        val order: res[i32, fail.Fail] = host.compare_env_names(a, held.units, held.name, owned.units, owned.name);
        if (sel order.err) { ret err[fail.Fail].err{order.err}; }
        if (order.ok == 0) {
            found = i;
            brk;
        }
        i = i + 1;
    }
    if (found < values.entries.len) {
        if (!replace) { ret err[fail.Fail].ok{}; }
        entry_free(a, ?values.entries.data[found]);
        values.entries.data[found] = owned;
        kept                       = true;
        ret err[fail.Fail].ok{};
    }
    val pushed: res[usize, A.Error] = collections_vector.push[Entry](?values.entries, owned);
    if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
    kept = true;
    ret err[fail.Fail].ok{};
}

# entries own both strings and use host identity before any overlay is applied
pub fun put(values: *Environment, name: str, value: str, replace: bool) err[fail.Fail] {
    val n: usize = str_len(name);
    if (n == 0) { ret err[fail.Fail].err{fail.message("environment variable name is empty")}; }
    var i: usize = 0;
    for (i < n) {
        if (name[i] == '=') { ret err[fail.Fail].err{fail.message("environment variable name contains '='")}; }
        i = i + 1;
    }
    val a:  *A.Allocator                     = values.entries.a;
    val sr: res[str, std_format.FormatError] = std_format.sprint(a, "{}={}", name, value);
    if (sel sr.err) { ret err[fail.Fail].err{fail.message(fail.format_text(sr.err))}; }
    val er: res[Entry, fail.Fail] = entry_text(a, sr.ok);
    str_free(a, sr.ok);
    if (sel er.err) { ret err[fail.Fail].err{er.err}; }
    ret put_owned(values, er.ok, replace);
}

fun put_entry(values: *Environment, entry: str, replace: bool) err[fail.Fail] {
    val er: res[Entry, fail.Fail] = entry_text(values.entries.a, entry);
    if (sel er.err) { ret err[fail.Fail].err{er.err}; }
    ret put_owned(values, er.ok, replace);
}

# drop the entry at `index`, keeping the order of the rest
pub fun remove(values: *Environment, index: usize) {
    if (index >= values.entries.len) { ret; }
    entry_free(values.entries.a, ?values.entries.data[index]);
    var i: usize = index + 1;
    for (i < values.entries.len) {
        values.entries.data[i - 1] = values.entries.data[i];
        i                          = i + 1;
    }
    collections_vector.truncate[Entry](?values.entries, values.entries.len - 1);
}

# the environment `e` describes, in native units: a given UTF-8 array, or this
# process's own as the native capture holds it, so a variable with no UTF-8
# spelling is carried unit for unit. duplicate names keep their first value,
# matching native lookup
pub fun capture(a: *A.Allocator, e: exec.Environment) res[Environment, fail.Fail] {
    var values: Environment = init(a);
    var handed: bool        = false;
    fin {
        if (!handed) { dnit(?values); }
    }
    var i: usize = 0;
    if (sel e.given) {
        if (e.given == nil) { ret res[Environment, fail.Fail].err{fail.environment(diagnostic_kind.ENV_READ, "the given environment is nil")}; }
        for (e.given[i] != nil) {
            val added: err[fail.Fail] = put_entry(?values, e.given[i]::str, false);
            if (sel added.err) { ret res[Environment, fail.Fail].err{added.err}; }
            i = i + 1;
        }
        handed = true;
        ret res[Environment, fail.Fail].ok{values};
    }
    val native: **Unit = env.environ_native();
    if (native == nil) { ret res[Environment, fail.Fail].err{fail.refusal(a, diagnostic_kind.ENV_READ, fail.Op{verb: "read", role: "the process environment"}, fail.Cause.env{env.EnvError.unavailable{}})}; }
    for (native[i] != nil) {
        val er: res[Entry, fail.Fail] = entry_native(a, native[i]);
        if (sel er.err) { ret res[Environment, fail.Fail].err{er.err}; }
        val added: err[fail.Fail] = put_owned(?values, er.ok, false);
        if (sel added.err) { ret res[Environment, fail.Fail].err{added.err}; }
        i = i + 1;
    }
    handed = true;
    ret res[Environment, fail.Fail].ok{values};
}

fun canonicalize(values: *Environment) err[fail.Fail] {
    var i: usize = 1;
    for (i < values.entries.len) {
        var j: usize = i;
        for (j > 0) {
            val left:  *Entry              = ?values.entries.data[j - 1];
            val right: *Entry              = ?values.entries.data[j];
            val order: res[i32, fail.Fail] = host.compare_env_names(values.entries.a, left.units, left.name, right.units, right.name);
            if (sel order.err) { ret err[fail.Fail].err{order.err}; }
            if (order.ok <= 0) { brk; }
            val previous: Entry = values.entries.data[j - 1];
            values.entries.data[j - 1] = values.entries.data[j];
            values.entries.data[j]     = previous;
            j                          = j - 1;
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# the length of a native entry in units
pub fun units_length(units: *Unit) usize {
    var n: usize = 0;
    for (units[n] != 0) { n = n + 1; }
    ret n;
}

# release a list of native strings; an empty list owns nothing
pub fun strings_free(a: *A.Allocator, strings: *Strings) {
    if (strings.items == nil) { ret; }
    var i: u32 = 0;
    for (i < strings.count) {
        A.deallocate[Unit](a, strings.items[i], units_length(strings.items[i]) + 1);
        i = i + 1;
    }
    A.deallocate[*Unit](a, strings.items, strings.count::usize + 1);
    strings.items = nil;
    strings.count = 0;
}

# the entries sorted by name, each copied, for a child
pub fun to_strings(values: *Environment) res[Strings, fail.Fail] {
    val sorted: err[fail.Fail] = canonicalize(values);
    if (sel sorted.err) { ret res[Strings, fail.Fail].err{sorted.err}; }
    val count: usize = values.entries.len;
    if (count > 0xffffffff) { ret res[Strings, fail.Fail].err{fail.message("environment has too many entries")}; }
    val a:  *A.Allocator         = values.entries.a;
    val ar: res[**Unit, A.Error] = A.allocate[*Unit](a, count + 1);
    if (sel ar.err) { ret res[Strings, fail.Fail].err{fail.refused(ar.err)}; }
    val items: **Unit = ar.ok;
    var i:     usize  = 0;
    for (i < count) {
        val entry: Entry               = values.entries.data[i];
        val cr:    res[*Unit, A.Error] = A.allocate[Unit](a, entry.length + 1);
        if (sel cr.err) {
            var j: usize = 0;
            for (j < i) {
                A.deallocate[Unit](a, items[j], values.entries.data[j].length + 1);
                j = j + 1;
            }
            A.deallocate[*Unit](a, items, count + 1);
            ret res[Strings, fail.Fail].err{fail.refused(cr.err)};
        }
        var k: usize = 0;
        for (k <= entry.length) {
            cr.ok[k] = entry.units[k];
            k        = k + 1;
        }
        items[i] = cr.ok;
        i        = i + 1;
    }
    items[count] = nil;
    ret res[Strings, fail.Fail].ok{Strings{items: items, count: count::u32}};
}
