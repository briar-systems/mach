use std.types.result.res;
use std.types.error.err;
use mach.lang.build.outcome;
use string: std.types.string;
use std.types.option.opt;
use vector: std.collections.vector;
use std.collections.vector.Vector;
use format: std.format;
use env: std.process.env;
use std.text.string.str_dup;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_copy_slice;
use std.types.string.str_len;

use A: std.allocator;
use page: std.allocator.page;
use std.types.string.str_equals;

pub rec Entry {
    name: str;
    value: str;
}

pub rec Environment {
    entries: Vector[Entry];
}

pub rec Strings {
    items: **u8;
    count: u32;
}

pub fun init(a: *A.Allocator) Environment {
    ret Environment{entries: vector.init[Entry](a)};
}

pub fun dnit(values: *Environment) {
    var i: usize = 0;
    for (i < values.entries.len) {
        str_free(values.entries.a, values.entries.data[i].name);
        str_free(values.entries.a, values.entries.data[i].value);
        i = i + 1;
    }
    vector.dnit[Entry](?values.entries);
}

# entries own both strings and use host identity before any overlay is applied
pub fun put(values: *Environment, name: str, value: str, replace: bool) err[outcome.Fail] {
    val n: usize = str_len(name);
    if (n == 0) { ret err[outcome.Fail].err{outcome.internal("environment variable name is empty")}; }
    var i: usize = 0;
    for (i < n) {
        if (name[i] == '=') { ret err[outcome.Fail].err{outcome.internal("environment variable name contains '='")}; }
        i = i + 1;
    }
    val valid: res[i32, env.EnvError] = env.compare_names(name, name);
    if (sel valid.err) { ret err[outcome.Fail].err{outcome.internal(outcome.env_text(valid.err))}; }
    var found: usize = values.entries.len;
    i = 0;
    for (i < values.entries.len) {
        val order: res[i32, env.EnvError] = env.compare_names(values.entries.data[i].name, name);
        if (sel order.err) { ret err[outcome.Fail].err{outcome.internal(outcome.env_text(order.err))}; }
        if (order.ok == 0) { found = i; brk; }
        i = i + 1;
    }
    if (found < values.entries.len && !replace) { ret err[outcome.Fail].ok{}; }
    val a: *A.Allocator = values.entries.a;
    val nr: res[str, A.Error] = str_dup(a, name);
    if (sel nr.err) { ret err[outcome.Fail].err{outcome.refused(nr.err)}; }
    val owned_name: str = nr.ok;
    val vr: res[str, A.Error] = str_dup(a, value);
    if (sel vr.err) { str_free(a, owned_name); ret err[outcome.Fail].err{outcome.refused(vr.err)}; }
    val entry: Entry = Entry{name: owned_name, value: vr.ok};
    if (found < values.entries.len) {
        str_free(a, values.entries.data[found].name);
        str_free(a, values.entries.data[found].value);
        values.entries.data[found] = entry;
    } or {
        val pushed: res[usize, A.Error] = vector.push[Entry](?values.entries, entry);
        if (sel pushed.err) {
            str_free(a, entry.name);
            str_free(a, entry.value);
            ret err[outcome.Fail].err{outcome.refused(pushed.err)};
        }
    }
    ret err[outcome.Fail].ok{};
}

pub fun put_entry(values: *Environment, entry: str, replace: bool) err[outcome.Fail] {
    var split: usize = 0;
    if (entry == nil) { ret err[outcome.Fail].err{outcome.internal("environment entry is nil")}; }
    for (entry[split] != 0 && entry[split] != '=') { split = split + 1; }
    if (split == 0 || entry[split] != '=') {
        ret err[outcome.Fail].err{outcome.internal("environment entry must have a name and '='")};
    }
    val a: *A.Allocator = values.entries.a;
    val nr: res[str, string.StrError] = str_copy_slice(a, entry, 0, split);
    if (sel nr.err) { ret err[outcome.Fail].err{outcome.internal(outcome.str_text(nr.err))}; }
    val name: str = nr.ok;
    val added: err[outcome.Fail] = put(values, name, ?entry[split + 1], replace);
    str_free(a, name);
    ret added;
}

# inherited duplicate names retain the first value, matching native lookup
pub fun capture(a: *A.Allocator, inherited: **u8) res[Environment, outcome.Fail] {
    var values: Environment = init(a);
    var i: usize = 0;
    for (inherited != nil && inherited[i] != nil) {
        val added: err[outcome.Fail] = put_entry(?values, inherited[i]::str, false);
        if (sel added.err) { dnit(?values); ret res[Environment, outcome.Fail].err{added.err}; }
        i = i + 1;
    }
    ret res[Environment, outcome.Fail].ok{values};
}

pub fun canonicalize(values: *Environment) err[outcome.Fail] {
    var i: usize = 1;
    for (i < values.entries.len) {
        var j: usize = i;
        for (j > 0) {
            val order: res[i32, env.EnvError] = env.compare_names(values.entries.data[j - 1].name, values.entries.data[j].name);
            if (sel order.err) { ret err[outcome.Fail].err{outcome.internal(outcome.env_text(order.err))}; }
            if (order.ok <= 0) { brk; }
            val previous: Entry = values.entries.data[j - 1];
            values.entries.data[j - 1] = values.entries.data[j];
            values.entries.data[j] = previous;
            j = j - 1;
        }
        i = i + 1;
    }
    ret err[outcome.Fail].ok{};
}

pub fun strings_free(a: *A.Allocator, strings: *Strings) {
    if (strings.items == nil) { ret; }
    var i: u32 = 0;
    for (i < strings.count) { str_free(a, strings.items[i]::str); i = i + 1; }
    A.deallocate[*u8](a, strings.items, strings.count::usize + 1);
    strings.items = nil;
    strings.count = 0;
}

pub fun to_strings(values: *Environment) res[Strings, outcome.Fail] {
    val sorted: err[outcome.Fail] = canonicalize(values);
    if (sel sorted.err) { ret res[Strings, outcome.Fail].err{sorted.err}; }
    val count: usize = values.entries.len;
    if (count > 0xffffffff) { ret res[Strings, outcome.Fail].err{outcome.internal("environment has too many entries")}; }
    val a: *A.Allocator = values.entries.a;
    val ar: res[**u8, A.Error] = A.allocate[*u8](a, count + 1);
    if (sel ar.err) { ret res[Strings, outcome.Fail].err{outcome.refused(ar.err)}; }
    val items: **u8 = ar.ok;
    var i: usize = 0;
    for (i < count) {
        val entry: Entry = values.entries.data[i];
        val sr: res[str, format.FormatError] = format.sprint(a, "{}={}", entry.name, entry.value);
        if (sel sr.err) {
            var j: usize = 0;
            for (j < i) { str_free(a, items[j]::str); j = j + 1; }
            A.deallocate[*u8](a, items, count + 1);
            ret res[Strings, outcome.Fail].err{outcome.internal(outcome.format_text(sr.err))};
        }
        items[i] = sr.ok::*u8;
        i = i + 1;
    }
    items[count] = nil;
    ret res[Strings, outcome.Fail].ok{Strings{items: items, count: count::u32}};
}


pub fun capture_planner(a: *A.Allocator) res[Environment, outcome.Fail] {
    val inherited: **u8 = env.environ();
    if (inherited == nil) { ret res[Environment, outcome.Fail].err{outcome.internal("planner environment unavailable")}; }
    ret capture(a, inherited);
}


test "mach.lang.driver.environment: owned overlays use host name identity" {
    var a: A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    var entry: [11]u8;
    val initial: str = "MACH_X=one";
    var i: usize = 0;
    for (i <= 10) { entry[i] = initial[i]; i = i + 1; }
    var inherited: [3]usize;
    inherited[0] = (?entry[0])::usize;
    inherited[1] = ("MACH_X=ignored")::usize;
    inherited[2] = 0;
    val cr: res[Environment, outcome.Fail] = capture(?a, (?inherited[0])::**u8);
    if (sel cr.err) { ret 2; }
    var values: Environment = cr.ok;
    fin { dnit(?values); }
    entry[7] = 'X';
    if (values.entries.len != 1 || !str_equals(values.entries.data[0].value, "one")) { ret 3; }
    val put_r: err[outcome.Fail] = put(?values, "MACH_X", "declared=value", true);
    if (sel put_r.err) { ret 4; }
    val put_r2: err[outcome.Fail] = put(?values, "MACH_ÄΩ", "first", true);
    if (sel put_r2.err) { ret 5; }
    val put_r3: err[outcome.Fail] = put(?values, "mach_äω", "second", true);
    if (sel put_r3.err) { ret 6; }
    $if ($mach.build.os == $mach.os.windows) { if (values.entries.len != 2) { ret 7; } }
    $or { if (values.entries.len != 3) { ret 8; } }
    val sr: res[Strings, outcome.Fail] = to_strings(?values);
    if (sel sr.err) { ret 9; }
    var strings: Strings = sr.ok;
    fin { strings_free(?a, ?strings); }
    if (!str_equals(strings.items[0]::str, "MACH_X=declared=value") || strings.items[strings.count] != nil) { ret 10; }
    val put_entry_r: err[outcome.Fail] = put_entry(?values, "=bad", true);
    if (sel put_entry_r.ok) { ret 11; }
    val put_entry_r2: err[outcome.Fail] = put_entry(?values, "missing", true);
    if (sel put_entry_r2.ok) { ret 12; }
    ret 0;
}

rec EnvProbe {
    backing: A.Allocator;
    pointers: [128]ptr;
    sizes: [128]usize;
    count: usize;
    calls: usize;
    fail_at: usize;
    bad: bool;
}

fun t_env_allocate(ctx: ptr, size: usize, align: usize) opt[ptr] {
    val probe: *EnvProbe = ctx::*EnvProbe;
    probe.calls = probe.calls + 1;
    if (probe.calls == probe.fail_at) { ret opt[ptr].none{}; }
    if (probe.count == 128) { probe.bad = true; ret opt[ptr].none{}; }
    val r: opt[ptr] = probe.backing.fn_allocate(probe.backing.ctx, size, align);
    if (sel r.some) {
        probe.pointers[probe.count] = r.some;
        probe.sizes[probe.count] = size;
        probe.count = probe.count + 1;
    }
    ret r;
}

fun t_env_reallocate(ctx: ptr, pointer: ptr, old_size: usize, new_size: usize, align: usize) opt[ptr] {
    if (pointer == nil) { ret t_env_allocate(ctx, new_size, align); }
    val probe: *EnvProbe = ctx::*EnvProbe;
    probe.calls = probe.calls + 1;
    if (probe.calls == probe.fail_at) { ret opt[ptr].none{}; }
    var i: usize = 0;
    for (i < probe.count && probe.pointers[i] != pointer) { i = i + 1; }
    if (i == probe.count) { probe.bad = true; ret opt[ptr].none{}; }
    if (probe.sizes[i] != old_size) { probe.bad = true; }
    val r: opt[ptr] = probe.backing.fn_reallocate(probe.backing.ctx, pointer, probe.sizes[i], new_size, align);
    if (sel r.some) { probe.pointers[i] = r.some; probe.sizes[i] = new_size; }
    ret r;
}

fun t_env_deallocate(ctx: ptr, pointer: ptr, size: usize, align: usize) i64 {
    val probe: *EnvProbe = ctx::*EnvProbe;
    var i: usize = 0;
    for (i < probe.count && probe.pointers[i] != pointer) { i = i + 1; }
    if (i == probe.count) { probe.bad = true; ret -1; }
    if (probe.sizes[i] != size) { probe.bad = true; }
    val result: i64 = probe.backing.fn_deallocate(probe.backing.ctx, pointer, probe.sizes[i], align);
    probe.count = probe.count - 1;
    probe.pointers[i] = probe.pointers[probe.count];
    probe.sizes[i] = probe.sizes[probe.count];
    ret result;
}

fun t_env_attempt(a: *A.Allocator) bool {
    var inherited: [11]usize;
    inherited[0] = ("MACH_Z=initial")::usize;
    inherited[1] = ("MACH_A=retained")::usize;
    inherited[2] = ("MACH_B=retained")::usize;
    inherited[3] = ("MACH_C=retained")::usize;
    inherited[4] = ("MACH_D=retained")::usize;
    inherited[5] = ("MACH_E=retained")::usize;
    inherited[6] = ("MACH_F=retained")::usize;
    inherited[7] = ("MACH_G=retained")::usize;
    inherited[8] = ("MACH_H=retained")::usize;
    inherited[9] = ("MACH_I=retained")::usize;
    inherited[10] = 0;
    val cr: res[Environment, outcome.Fail] = capture(a, (?inherited[0])::**u8);
    if (sel cr.err) { ret false; }
    var values: Environment = cr.ok;
    fin { dnit(?values); }
    val put_entry_r: err[outcome.Fail] = put_entry(?values, "MACH_Z=replacement", true);
    if (sel put_entry_r.err) { ret false; }
    val sr: res[Strings, outcome.Fail] = to_strings(?values);
    if (sel sr.err) { ret false; }
    var strings: Strings = sr.ok;
    strings_free(a, ?strings);
    ret true;
}

test "mach.lang.driver.environment: allocation failures release exact owned extents" {
    var fail_at: usize = 1;
    for (fail_at < 128) {
        var probe: EnvProbe;
        val make_r: err[A.Error] = page.make(?probe.backing);
        if (sel make_r.err) { ret 1; }
        probe.fail_at = fail_at;
        probe.calls = 0;
        probe.count = 0;
        probe.bad = false;
        var a: A.Allocator;
        a.ctx = (?probe)::ptr;
        a.fn_allocate = t_env_allocate;
        a.fn_reallocate = t_env_reallocate;
        a.fn_deallocate = t_env_deallocate;
        val completed: bool = t_env_attempt(?a);
        if (probe.bad || probe.count != 0) { ret 2; }
        if (completed) {
            if (probe.calls >= fail_at) { ret 3; }
            ret 0;
        }
        if (probe.calls < fail_at) { ret 4; }
        fail_at = fail_at + 1;
    }
    ret 5;
}
