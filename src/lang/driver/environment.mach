use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.fail;
use collections_vector: std.collections.vector;
use std.collections.vector.Vector;
use std_format: std.format;
use std.process.env;
use std.process.exec;
use std.text.string.str_dup;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use types_string: std.types.string;
use std.types.string.str;
use std.types.string.str_copy_slice;
use std.types.string.str_len;

use A: std.allocator;
use std.allocator.page;
use T: std.allocator.testing;
use std.types.string.str_equals;

pub rec Entry {
    name:  str;
    value: str;
}

pub rec Environment {
    entries: Vector[Entry];
}

pub rec Strings {
    items: **u8;
    count: u32;
}

pub fun init(a: *A.Allocator) Environment {
    ret Environment{entries: collections_vector.init[Entry](a)};
}

pub fun dnit(values: *Environment) {
    var i: usize = 0;
    for (i < values.entries.len) {
        str_free(values.entries.a, values.entries.data[i].name);
        str_free(values.entries.a, values.entries.data[i].value);
        i = i + 1;
    }
    collections_vector.dnit[Entry](?values.entries);
}

# entries own both strings and use host identity before any overlay is applied
pub fun put(values: *Environment, name: str, value: str, replace: bool) err[fail.Fail] {
    val n: usize = str_len(name);
    if (n == 0) { ret err[fail.Fail].err{fail.message("environment variable name is empty")}; }
    var i: usize = 0;
    for (i < n) {
        if (name[i] == '=') { ret err[fail.Fail].err{fail.message("environment variable name contains '='")}; }
        i = i + 1;
    }
    val valid: res[i32, env.EnvError] = env.compare_names(name, name);
    if (sel valid.err) { ret err[fail.Fail].err{fail.message(fail.env_text(valid.err))}; }
    var found: usize = values.entries.len;
    i = 0;
    for (i < values.entries.len) {
        val order: res[i32, env.EnvError] = env.compare_names(values.entries.data[i].name, name);
        if (sel order.err) { ret err[fail.Fail].err{fail.message(fail.env_text(order.err))}; }
        if (order.ok == 0) {
            found = i;
            brk;
        }
        i = i + 1;
    }
    if (found < values.entries.len && !replace) { ret err[fail.Fail].ok{}; }
    val a:  *A.Allocator      = values.entries.a;
    val nr: res[str, A.Error] = str_dup(a, name);
    if (sel nr.err) { ret err[fail.Fail].err{fail.refused(nr.err)}; }
    val owned_name: str  = nr.ok;
    var stored:     bool = false;
    fin {
        if (!stored) { str_free(a, owned_name); }
    }
    val vr: res[str, A.Error] = str_dup(a, value);
    if (sel vr.err) { ret err[fail.Fail].err{fail.refused(vr.err)}; }
    fin {
        if (!stored) { str_free(a, vr.ok); }
    }
    val entry: Entry = Entry{name: owned_name, value: vr.ok};
    if (found < values.entries.len) {
        str_free(a, values.entries.data[found].name);
        str_free(a, values.entries.data[found].value);
        values.entries.data[found] = entry;
    }
    or {
        val pushed: res[usize, A.Error] = collections_vector.push[Entry](?values.entries, entry);
        if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
    }
    stored = true;
    ret err[fail.Fail].ok{};
}

pub fun put_entry(values: *Environment, entry: str, replace: bool) err[fail.Fail] {
    var split: usize = 0;
    if (entry == nil) { ret err[fail.Fail].err{fail.message("environment entry is nil")}; }
    for (entry[split] != 0 && entry[split] != '=') { split = split + 1; }
    if (split == 0 || entry[split] != '=') {
        ret err[fail.Fail].err{fail.message("environment entry must have a name and '='")};
    }
    val a:  *A.Allocator                    = values.entries.a;
    val nr: res[str, types_string.StrError] = str_copy_slice(a, entry, 0, split);
    if (sel nr.err) { ret err[fail.Fail].err{fail.message(fail.str_text(nr.err))}; }
    val name:  str            = nr.ok;
    val added: err[fail.Fail] = put(values, name, ?entry[split + 1], replace);
    str_free(a, name);
    ret added;
}

# the entries of an environment, read in UTF-8
# ---
# items:  nil-terminated NAME=value entries
# listed: the listing that owns the entries when they were inherited
# owned:  whether items and listed are this value's to release
pub rec Entries {
    items:  **u8;
    listed: Vector[env.Listed];
    owned:  bool;
}

# the entries of `e` for reading: a given array as it is, or this process's
# environment listed for inherit. an inherited variable with no UTF-8 spelling
# is refused, since whatever reads the entries builds an environment in UTF-8
# that could not carry it
pub fun entries(a: *A.Allocator, e: exec.Environment) res[Entries, fail.Fail] {
    if (sel e.given) {
        if (e.given == nil) { ret res[Entries, fail.Fail].err{fail.environment(diagnostic_kind.ENV_READ, "the given environment is nil")}; }
        ret res[Entries, fail.Fail].ok{Entries{items: e.given, listed: collections_vector.init[env.Listed](a), owned: false}};
    }
    val lr: res[Vector[env.Listed], env.EnvError] = env.environ(a);
    if (sel lr.err) { ret res[Entries, fail.Fail].err{fail.environment(diagnostic_kind.ENV_READ, fail.env_text(lr.err))}; }
    var listed: Vector[env.Listed] = lr.ok;
    var handed: bool               = false;
    fin {
        if (!handed) { env.environ_free(?listed); }
    }
    val ar: res[**u8, A.Error] = A.allocate[*u8](a, listed.len + 1);
    if (sel ar.err) { ret res[Entries, fail.Fail].err{fail.refused(ar.err)}; }
    val items: **u8 = ar.ok;
    fin {
        if (!handed) { A.deallocate[*u8](a, items, listed.len + 1); }
    }
    var i: usize = 0;
    for (i < listed.len) {
        val entry: env.Listed = listed.data[i];
        if (sel entry.unspellable) {
            ret res[Entries, fail.Fail].err{fail.environment(diagnostic_kind.ENV_READ, "the environment holds a variable with no UTF-8 spelling, which an edited environment cannot carry")};
        }
        items[i] = entry.variable::*u8;
        i        = i + 1;
    }
    items[listed.len] = nil;
    handed            = true;
    ret res[Entries, fail.Fail].ok{Entries{items: items, listed: listed, owned: true}};
}

# release what entries listed for inherit. a given array stays the caller's
pub fun entries_free(a: *A.Allocator, e: *Entries) {
    if (!e.owned) { ret; }
    A.deallocate[*u8](a, e.items, e.listed.len + 1);
    env.environ_free(?e.listed);
    e.items = nil;
    e.owned = false;
}

# inherited duplicate names retain the first value, matching native lookup
pub fun capture(a: *A.Allocator, inherited: **u8) res[Environment, fail.Fail] {
    var values: Environment = init(a);
    var i:      usize       = 0;
    for (inherited != nil && inherited[i] != nil) {
        val added: err[fail.Fail] = put_entry(?values, inherited[i]::str, false);
        if (sel added.err) {
            dnit(?values);
            ret res[Environment, fail.Fail].err{added.err};
        }
        i = i + 1;
    }
    ret res[Environment, fail.Fail].ok{values};
}

fun canonicalize(values: *Environment) err[fail.Fail] {
    var i: usize = 1;
    for (i < values.entries.len) {
        var j: usize = i;
        for (j > 0) {
            val order: res[i32, env.EnvError] = env.compare_names(values.entries.data[j - 1].name, values.entries.data[j].name);
            if (sel order.err) { ret err[fail.Fail].err{fail.message(fail.env_text(order.err))}; }
            if (order.ok <= 0) { brk; }
            val previous: Entry = values.entries.data[j - 1];
            values.entries.data[j - 1] = values.entries.data[j];
            values.entries.data[j]     = previous;
            j                          = j - 1;
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

pub fun strings_free(a: *A.Allocator, strings: *Strings) {
    if (strings.items == nil) { ret; }
    var i: u32 = 0;
    for (i < strings.count) {
        str_free(a, strings.items[i]::str);
        i = i + 1;
    }
    A.deallocate[*u8](a, strings.items, strings.count::usize + 1);
    strings.items = nil;
    strings.count = 0;
}

pub fun to_strings(values: *Environment) res[Strings, fail.Fail] {
    val sorted: err[fail.Fail] = canonicalize(values);
    if (sel sorted.err) { ret res[Strings, fail.Fail].err{sorted.err}; }
    val count: usize = values.entries.len;
    if (count > 0xffffffff) { ret res[Strings, fail.Fail].err{fail.message("environment has too many entries")}; }
    val a:  *A.Allocator       = values.entries.a;
    val ar: res[**u8, A.Error] = A.allocate[*u8](a, count + 1);
    if (sel ar.err) { ret res[Strings, fail.Fail].err{fail.refused(ar.err)}; }
    val items: **u8  = ar.ok;
    var i:     usize = 0;
    for (i < count) {
        val entry: Entry                            = values.entries.data[i];
        val sr:    res[str, std_format.FormatError] = std_format.sprint(a, "{}={}", entry.name, entry.value);
        if (sel sr.err) {
            var j: usize = 0;
            for (j < i) {
                str_free(a, items[j]::str);
                j = j + 1;
            }
            A.deallocate[*u8](a, items, count + 1);
            ret res[Strings, fail.Fail].err{fail.message(fail.format_text(sr.err))};
        }
        items[i] = sr.ok::*u8;
        i        = i + 1;
    }
    items[count] = nil;
    ret res[Strings, fail.Fail].ok{Strings{items: items, count: count::u32}};
}

test owned_overlays_use_host_name_identity {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    var entry:   [11]u8;
    val initial: str   = "MACH_X=one";
    var i:       usize = 0;
    for (i <= 10) {
        entry[i] = initial[i];
        i        = i + 1;
    }
    var inherited: [3]usize;
    inherited[0] = (?entry[0])::usize;
    inherited[1] = ("MACH_X=ignored")::usize;
    inherited[2] = 0;
    val cr: res[Environment, fail.Fail] = capture(?a, (?inherited[0])::**u8);
    if (sel cr.err) { ret 2; }
    var values: Environment = cr.ok;
    fin { dnit(?values); }
    entry[7] = 'X';
    if (values.entries.len != 1 || !str_equals(values.entries.data[0].value, "one")) { ret 3; }
    val put_r: err[fail.Fail] = put(?values, "MACH_X", "declared=value", true);
    if (sel put_r.err) { ret 4; }
    val put_r2: err[fail.Fail] = put(?values, "MACH_ÄΩ", "first", true);
    if (sel put_r2.err) { ret 5; }
    val put_r3: err[fail.Fail] = put(?values, "mach_äω", "second", true);
    if (sel put_r3.err) { ret 6; }
    $if ($mach.build.os == $mach.os.windows) {
        if (values.entries.len != 2) { ret 7; }
    }
    $or {
        if (values.entries.len != 3) { ret 8; }
    }
    val sr: res[Strings, fail.Fail] = to_strings(?values);
    if (sel sr.err) { ret 9; }
    var strings: Strings = sr.ok;
    fin { strings_free(?a, ?strings); }
    if (!str_equals(strings.items[0]::str, "MACH_X=declared=value") || strings.items[strings.count] != nil) { ret 10; }
    val put_entry_r: err[fail.Fail] = put_entry(?values, "=bad", true);
    if (sel put_entry_r.ok) { ret 11; }
    val put_entry_r2: err[fail.Fail] = put_entry(?values, "missing", true);
    if (sel put_entry_r2.ok) { ret 12; }
    ret 0;
}

#[testing]
fun t_env_attempt(a: *A.Allocator) bool {
    var inherited: [11]usize;
    inherited[0]  = ("MACH_Z=initial")::usize;
    inherited[1]  = ("MACH_A=retained")::usize;
    inherited[2]  = ("MACH_B=retained")::usize;
    inherited[3]  = ("MACH_C=retained")::usize;
    inherited[4]  = ("MACH_D=retained")::usize;
    inherited[5]  = ("MACH_E=retained")::usize;
    inherited[6]  = ("MACH_F=retained")::usize;
    inherited[7]  = ("MACH_G=retained")::usize;
    inherited[8]  = ("MACH_H=retained")::usize;
    inherited[9]  = ("MACH_I=retained")::usize;
    inherited[10] = 0;
    val cr: res[Environment, fail.Fail] = capture(a, (?inherited[0])::**u8);
    if (sel cr.err) { ret false; }
    var values: Environment = cr.ok;
    fin { dnit(?values); }
    val put_entry_r: err[fail.Fail] = put_entry(?values, "MACH_Z=replacement", true);
    if (sel put_entry_r.err) { ret false; }
    val sr: res[Strings, fail.Fail] = to_strings(?values);
    if (sel sr.err) { ret false; }
    var strings: Strings = sr.ok;
    strings_free(a, ?strings);
    ret true;
}

test allocation_failures_release_exact_owned_extents {
    var fail_at: usize = 1;
    for (fail_at < 128) {
        var t:      T.Testing;
        val make_r: err[A.Error] = T.make(?t);
        if (sel make_r.err) { ret 1; }
        T.fail_at_ordinal(?t, fail_at);
        val completed: bool  = t_env_attempt(T.allocator_of(?t));
        val clean:     bool  = T.clean(?t);
        val attempts:  usize = T.attempt_count(?t);
        T.dnit(?t);
        if (!clean) { ret 2; }
        if (completed) {
            if (attempts >= fail_at) { ret 3; }
            ret 0;
        }
        if (attempts < fail_at) { ret 4; }
        fail_at = fail_at + 1;
    }
    ret 5;
}
