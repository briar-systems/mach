# one module's object, made by a step that owns everything it works in: the module is
# lowered into a mirl module on a heap of the step's own, verified, written as text when
# asked, compiled, and the heap torn down before the step returns. the step reads its
# job and writes only what it returns, so steps for different modules can run side by
# side on one shared target (mirl#406)

use std.types.bool.bool;
use std.types.error.err;
use std.types.result.res;
use std.types.string.str;
use std.types.string.str_len;

use A: std.allocator;
use std.allocator.heap;
use io_writer: std.io.writer;

use mach.lang.driver.backend;
use mach.lang.fail;
use me_lower:      mach.lang.me.lower;
use lower_context: mach.lang.me.lower.context;
use mach.lang.output;
use mink.model.object.Object;
use mirl.ir.module.Module;
use text_item:    mirl.ir.text.item;
use text_printer: mirl.ir.text.printer;
use mirl.pass.relaxation;

# how mirl compiles a module: its level, whether the schedule's own checks run, whether
# the linker may relax the code, and the float relaxations permitted
pub rec Codegen {
    level:   u8;
    checked: bool;
    relax:   bool;
    floats:  relaxation.Relaxations;
}

# what one module's object is made from, all of it read only to the step
# ---
# lower:   the module's lowering request; its `malloc` holds the facts and any refusal
# back:    the assembled target, shared by every step and never written
# codegen: how mirl compiles the module
# out:     where the object lives, which outlives the step
# ir_path: where mirl's text of the module is written before it compiles, "" for nowhere
# name:    the module's name, for refusals
pub rec Job {
    lower:   *lower_context.LowerRequest;
    back:    *backend.Back;
    codegen: Codegen;
    out:     *A.Allocator;
    ir_path: str;
    name:    str;
}

# a module's object and the facts its lowering kept, both owned by the caller
pub rec Made {
    object: Object;
    facts:  lower_context.Unit;
}

# the object of the module `job` names, or why it was not made
pub fun make(job: *Job) res[Made, fail.Fail] {
    val machine: res[*lower_context.Machine, fail.Fail] = backend.machine(job.back);
    if (sel machine.err) { ret res[Made, fail.Fail].err{machine.err}; }

    var src: heap.Source;
    var h:   heap.Heap;
    heap.native_source(?src);
    val begun: err[A.Error] = heap.init(?h, ?src, 0);
    if (sel begun.err) { ret res[Made, fail.Fail].err{fail.refused(begun.err)}; }
    # the teardown frees the module whole
    fin { val freed: err[A.Error] = heap.dnit(?h); }
    var ir:    A.Allocator;
    val wired: err[A.Error] = heap.make(?ir, ?h);
    if (sel wired.err) { ret res[Made, fail.Fail].err{fail.refused(wired.err)}; }

    val made: res[Module, fail.Fail] = lower_context.module_init(?ir, machine.ok);
    if (sel made.err) { ret res[Made, fail.Fail].err{made.err}; }
    var m:       Module                             = made.ok;
    val lowered: res[lower_context.Unit, fail.Fail] = me_lower.lower_module(job.lower, ?m);
    if (sel lowered.err) { ret res[Made, fail.Fail].err{lowered.err}; }
    var facts: lower_context.Unit = lowered.ok;

    if (str_len(job.ir_path) != 0) {
        val written: err[fail.Fail] = output.writer[Module](nil, job.out, job.ir_path, ?m, write_text, 0o644, "write");
        if (sel written.err) {
            lower_context.unit_dnit(?facts);
            ret res[Made, fail.Fail].err{written.err};
        }
    }
    val c:        Codegen                = job.codegen;
    val compiled: res[Object, fail.Fail] = backend.compile(job.back, job.out, ?m, c.level, c.checked, c.relax, c.floats, job.name);
    if (sel compiled.err) {
        lower_context.unit_dnit(?facts);
        ret res[Made, fail.Fail].err{compiled.err};
    }
    ret res[Made, fail.Fail].ok{Made{object: compiled.ok, facts: facts}};
}

fun write_text(m: *Module, out: *io_writer.Writer) err[io_writer.WriteError] {
    val written: err[text_printer.Error] = text_item.print(out, m);
    if (sel written.err) { ret err[io_writer.WriteError].err{io_writer.WriteError.stalled{0}}; }
    ret err[io_writer.WriteError].ok{};
}
