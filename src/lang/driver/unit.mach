# one object, of a module or an instance unit, made in two steps. `lower` lowers the unit's
# code into a mirl module on a heap of its own and hands both back as one value, which its
# owner keeps until `compile` has verified it, written it as text when asked and compiled it
# into an object; `release` then tears the heap down. compiling reads the lowered unit and its
# job and writes only what it returns, so compiles of different units can run side by side on
# one shared target (mirl#406). each step times the stages it runs and keeps the counts each
# owner holds of the module, for the readout

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.string.str;
use std.types.string.str_len;

use chrono_duration: std.chrono.duration;

use A: std.allocator;
use std.allocator.heap;
use io_writer: std.io.writer;

use mach.lang.driver.backend;
use backend_compile: mach.lang.driver.backend.compile;
use mach.lang.fail;
use sema_product: mach.lang.fe.sema.product;
use mach.lang.intern;
use me_lower:      mach.lang.me.lower;
use lower_context: mach.lang.me.lower.context;
use mach.lang.output;
use mach.lang.readout;
use lang_source: mach.lang.source;
use mirl_stats:  mirl.base.stats;
use mirl_module: mirl.ir.module;
use mirl.ir.module.Module;
use text_item:    mirl.ir.text.item;
use text_printer: mirl.ir.text.printer;
use mirl.pass.relaxation;

# how mirl compiles a module: its level, whether the schedule's own checks run, whether
# the linker may relax the code, and the float relaxations permitted
pub rec Codegen {
    level:   u8;
    checked: bool;
    relax:   bool;
    floats:  relaxation.Relaxations;
}

# an instance unit's lowering: its request, its name and its members in the order they lower
pub rec UnitLowering {
    req:     *lower_context.LowerRequest;
    name:    intern.StrId;
    members: **sema_product.InstanceResult;
    count:   u32;
}

# what a step lowers: a module, or an instance unit. the request's `malloc` holds the facts
# and any refusal
pub tag Lowering: u8 {
    module: *lower_context.LowerRequest;
    unit:   UnitLowering;
}

# a unit lowered and not yet compiled: the heap its module lives on, the module, the facts
# its lowering kept and what lowering it measured. it lives where `lower` was told to put it
# until `release`
# ---
# lower:     lowering the module into mirl
# functions: the module's functions, as mirl's module holds them
# ir_count:  the instructions lowering built into its bodies, as mirl's bodies hold them
pub rec Lowered {
    src:       heap.Source;
    h:         heap.Heap;
    ir:        A.Allocator;
    m:         Module;
    facts:     lower_context.Unit;
    lower:     chrono_duration.Duration;
    functions: u64;
    ir_count:  u64;
}

# how one lowered unit is compiled, all of it read only to the step
# ---
# back:     the assembled target, shared by every step and never written
# codegen:  how mirl compiles the module
# out:      where the object lives, which outlives the step
# ir_path:  where mirl's text of the module is written before it compiles, "" for nowhere
# asm_path: where masc's listing of the object is written as it compiles, "" for nowhere
# name:     the name of the object it makes, the module's, its test object's or the unit's, no other object's in a link, which
#           refusals name and the object's format may name symbols after
# timed:    whether mirl times and counts its stages, which only a readout reads
# sources:  the texts a failure or warning of the compile points into
pub rec Job {
    back:     *backend.Back;
    codegen:  Codegen;
    out:      *A.Allocator;
    ir_path:  str;
    asm_path: str;
    name:     str;
    timed:    bool;
    sources:  *lang_source.SourceMap;
}

# what compiling one lowered unit measured: mach's verifier and mirl's own stages and counts
# ---
# verify:   mirl's verifier over the lowered module
# verifies: the verifier runs mach made over it
# blocks:   the blocks the unit's heap allocated, lowering and compiling, as std's heap counts them, and not what the
#           compile allocates on the object's allocator, which outlives the step
# bytes:    the bytes of those allocations
# peak:     the most bytes the unit's heap mapped
# mirl:     mirl's stages and counts, masc's beside them, all zero for an untimed job
pub rec Stats {
    verify:   chrono_duration.Duration;
    verifies: u64;
    blocks:   u64;
    bytes:    u64;
    peak:     u64;
    mirl:     mirl_stats.Stats;
}

# a unit's object and the warnings mirl gave compiling it, owned by the caller, and what the
# compile measured
pub rec Made {
    compiled: backend_compile.Compiled;
    stats:    Stats;
}

# the unit `lowering` names lowered for `back`'s target onto a heap drawing its spans from
# `spans`, which the unit owns alone and so takes no lock, the value held in `out` until
# `release`, or why it was not lowered
pub fun lower(lowering: Lowering, back: *backend.Back, spans: *heap.Pool, out: *A.Allocator) res[*Lowered, fail.Fail] {
    val machine: res[*lower_context.Machine, fail.Fail] = backend.machine(back);
    if (sel machine.err) { ret res[*Lowered, fail.Fail].err{machine.err}; }
    val boxed: res[*Lowered, A.Error] = A.allocate[Lowered](out, 1);
    if (sel boxed.err) { ret res[*Lowered, fail.Fail].err{fail.refused(boxed.err)}; }
    val l: *Lowered = boxed.ok;
    heap.pool_source(?l.src, spans);
    val begun: err[A.Error] = heap.init(?l.h, ?l.src, 0);
    if (sel begun.err) {
        A.deallocate[Lowered](out, l, 1);
        ret res[*Lowered, fail.Fail].err{fail.refused(begun.err)};
    }
    var kept: bool = false;
    fin {
        if (!kept) { release(out, l); }
    }
    val wired: err[A.Error] = heap.make_owned(?l.ir, ?l.h);
    if (sel wired.err) { ret res[*Lowered, fail.Fail].err{fail.refused(wired.err)}; }

    val made: res[Module, fail.Fail] = lower_context.module_init(?l.ir, machine.ok);
    if (sel made.err) { ret res[*Lowered, fail.Fail].err{made.err}; }
    l.m = made.ok;
    val t_lower: readout.Instant                    = readout.sample();
    var lowered: res[lower_context.Unit, fail.Fail] = res[lower_context.Unit, fail.Fail].err{fail.message("lower: a step names nothing to lower")};
    if (sel lowering.module) { lowered = me_lower.lower_module(lowering.module, ?l.m); }
    if (sel lowering.unit) {
        val u: UnitLowering = lowering.unit;
        lowered = me_lower.lower_unit(u.req, u.name, u.members, u.count, ?l.m);
    }
    l.lower = readout.elapsed(t_lower);
    if (sel lowered.err) { ret res[*Lowered, fail.Fail].err{lowered.err}; }
    l.facts = lowered.ok;
    val size: mirl_module.Size = mirl_module.size(?l.m);
    l.functions = size.functions::u64;
    l.ir_count  = size.instructions::u64;
    kept        = true;
    ret res[*Lowered, fail.Fail].ok{l};
}

# tear down what `lower` made in `out`: the heap and the module on it. the facts are the
# holder's, who gives them back or hands them on
pub fun release(out: *A.Allocator, l: *Lowered) {
    val freed: err[A.Error] = heap.dnit(?l.h);
    A.deallocate[Lowered](out, l, 1);
}

# the object of the lowered unit `l`, compiled as `job` says, or why it was not made.
# compiling spends the module, so a lowered unit is compiled once
pub fun compile(job: *Job, l: *Lowered) res[Made, fail.Fail] {
    var stats: Stats;
    stats.mirl = mirl_stats.init();
    val c: Codegen = job.codegen;
    if (c.checked) {
        val machine: res[*lower_context.Machine, fail.Fail] = backend.machine(job.back);
        if (sel machine.err) { ret res[Made, fail.Fail].err{machine.err}; }
        val t_verify: readout.Instant = readout.sample();
        val verified: err[fail.Fail]  = me_lower.verify_module(machine.ok, job.out, job.name, ?l.m);
        stats.verify   = readout.elapsed(t_verify);
        stats.verifies = 1;
        if (sel verified.err) { ret res[Made, fail.Fail].err{verified.err}; }
    }

    if (str_len(job.ir_path) != 0) {
        var printed: Printed        = Printed{m: ?l.m, failed: opt[text_printer.Error].none{}};
        val written: err[fail.Fail] = output.writer[Printed](nil, job.out, job.ir_path, ?printed, write_text, 0o644, nil);
        if (sel printed.failed.some) { ret res[Made, fail.Fail].err{printer_fail(printed.failed.some)}; }
        if (sel written.err)         { ret res[Made, fail.Fail].err{written.err}; }
    }
    var sink: opt[*mirl_stats.Stats] = opt[*mirl_stats.Stats].none{};
    if (job.timed) { sink = opt[*mirl_stats.Stats].some{?stats.mirl}; }
    val compiled: res[backend_compile.Compiled, fail.Fail] = compile_listed(job, ?l.m, sink);
    if (sel compiled.err) { ret res[Made, fail.Fail].err{compiled.err}; }
    stats.blocks = heap.allocated_blocks(?l.h)::u64;
    stats.bytes  = heap.allocated_bytes(?l.h)::u64;
    stats.peak   = heap.peak_mapped_bytes(?l.h)::u64;
    ret res[Made, fail.Fail].ok{Made{compiled: compiled.ok, stats: stats}};
}

# what a listed compile carries through the writer that streams its listing
rec Listed {
    job:   *Job;
    m:     *Module;
    stats: opt[*mirl_stats.Stats];
    made:  res[backend_compile.Compiled, fail.Fail];
}

# the module `m` compiled as `job` says, its listing streamed to the job's asm path when it
# names one, and its stages timed into `stats` when there is one. a refused compile is the
# compile's failure, not the listing's
fun compile_listed(job: *Job, m: *Module, stats: opt[*mirl_stats.Stats]) res[backend_compile.Compiled, fail.Fail] {
    val c: Codegen = job.codegen;
    if (str_len(job.asm_path) == 0) {
        ret backend_compile.compile(job.back, job.out, job.sources, m, c.level, c.checked, c.relax, c.floats, opt[*io_writer.Writer].none{}, stats, job.name);
    }
    var listed:  Listed         = Listed{job: job, m: m, stats: stats, made: res[backend_compile.Compiled, fail.Fail].err{fail.message("the listing's compile did not run")}};
    val written: err[fail.Fail] = output.writer[Listed](nil, job.out, job.asm_path, ?listed, write_listing, 0o644, nil);
    if (sel listed.made.err) { ret listed.made; }
    if (sel written.err) {
        if (sel listed.made.ok) { backend_compile.release(job.out, ?listed.made.ok); }
        ret res[backend_compile.Compiled, fail.Fail].err{written.err};
    }
    ret listed.made;
}

fun write_listing(listed: *Listed, out: *io_writer.Writer) err[io_writer.WriteError] {
    val c: Codegen = listed.job.codegen;
    listed.made = backend_compile.compile(listed.job.back, listed.job.out, listed.job.sources, listed.m, c.level, c.checked, c.relax, c.floats, opt[*io_writer.Writer].some{out}, listed.stats, listed.job.name);
    ret err[io_writer.WriteError].ok{};
}

# what printing a module's text carries through the writer that streams it: the module, and a
# failure of the printer's own, which is no failure of the writer's
rec Printed {
    m:      *Module;
    failed: opt[text_printer.Error];
}

# the module's text, a refusal of the writer handed back as the writer's and any other kept for
# the caller
fun write_text(printed: *Printed, out: *io_writer.Writer) err[io_writer.WriteError] {
    val written: err[text_printer.Error] = text_item.print(out, printed.m);
    if (sel written.ok) { ret err[io_writer.WriteError].ok{}; }
    val e: text_printer.Error = written.err;
    if (sel e.write) { ret err[io_writer.WriteError].err{e.write}; }
    printed.failed = opt[text_printer.Error].some{e};
    ret err[io_writer.WriteError].ok{};
}

# why the printer could not write a module's text
fun printer_fail(e: text_printer.Error) fail.Fail {
    if (sel e.alloc) { ret fail.refused(e.alloc); }
    ret fail.message(text_printer.describe(e));
}
