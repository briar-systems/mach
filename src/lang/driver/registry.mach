# the toolchain's target registry: every member composed once, on first use,
# and published for the life of the process. a session holds no registry, so
# whoever resolves a target borrows this one. the first use comes before any
# worker runs, since every target a build reads is resolved before it fans out
use codegen_dwarf: mach.lang.be.codegen.dwarf;
use mach.lang.fail;
use lang_target: mach.lang.target;
use target_of:   mach.lang.target.of;
use std.allocator.page;
use std.system.panic.panic;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;

use A: std.allocator;

var toolchain_alloc: A.Allocator;
var toolchain:       lang_target.TargetRegistry;
var toolchain_ready: bool = false;

fun provide_debug_descriptor() res[target_of.DebugVTable, fail.Fail] {
    ret res[target_of.DebugVTable, fail.Fail].ok{codegen_dwarf.debug_descriptor()};
}

pub fun setup_registry(reg: *lang_target.TargetRegistry) err[fail.Fail] {
    val register_all_r: err[fail.Fail] = lang_target.register_all(reg, provide_debug_descriptor);
    if (sel register_all_r.err) { ret err[fail.Fail].err{register_all_r.err}; }
    ret err[fail.Fail].ok{};
}

pub fun registry() res[*lang_target.TargetRegistry, fail.Fail] {
    if (!toolchain_ready) {
        val made: err[A.Error] = page.make(?toolchain_alloc);
        if (sel made.err) { ret res[*lang_target.TargetRegistry, fail.Fail].err{fail.refused(made.err)}; }
        toolchain = lang_target.registry_init_with_allocator(?toolchain_alloc);
        val composed: err[fail.Fail] = setup_registry(?toolchain);
        if (sel composed.err) {
            lang_target.registry_dnit(?toolchain);
            ret res[*lang_target.TargetRegistry, fail.Fail].err{composed.err};
        }
        toolchain_ready = true;
    }
    ret res[*lang_target.TargetRegistry, fail.Fail].ok{?toolchain};
}

# the toolchain registry a test resolves against; a registry that cannot be
# composed fails the test outright
#[testing]
pub fun t_registry() *lang_target.TargetRegistry {
    val r: res[*lang_target.TargetRegistry, fail.Fail] = registry();
    if (sel r.ok) { ret r.ok; }
    panic("driver: the toolchain target registry failed to compose\n");
    ret nil;
}
