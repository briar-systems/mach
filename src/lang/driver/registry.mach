use fail: mach.lang.fail;
use std.types.canonical.res;
use std.types.canonical.err;
use mach.lang.build.outcome;
use std.types.string.str;
use R: std.types.result;
use mach.lang.be.codegen.dwarf;
use mach.lang.target;
use mach.lang.target.of;

# the target registry's descriptor provider keeps its 1.x contract (C3a)
fun provide_debug_descriptor() R.Result[of.DebugVTable, str] {
    ret R.ok[of.DebugVTable, str](dwarf.debug_descriptor());
}

# translation shim (#3226): the legacy carrier for call sites in lanes that
# read it as such; removed with the last one
pub fun setup_registry(reg: *target.TargetRegistry) R.Result[R.Void, str] {
    ret outcome.lower_unit(setup_registry_typed(reg));
}

pub fun setup_registry_typed(reg: *target.TargetRegistry) err[outcome.Fail] {
    val register_all_r: err[fail.Fail] = target.register_all(reg, provide_debug_descriptor);
    if (sel register_all_r.err) { ret err[outcome.Fail].err{outcome.from_fail(register_all_r.err)}; }
    ret err[outcome.Fail].ok{};
}
