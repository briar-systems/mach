use codegen_dwarf: mach.lang.be.codegen.dwarf;
use mach.lang.build.outcome;
use mach.lang.fail;
use lang_target: mach.lang.target;
use target_of:   mach.lang.target.of;
use std.types.error.err;
use std.types.result.res;

fun provide_debug_descriptor() res[target_of.DebugVTable, fail.Fail] {
    ret res[target_of.DebugVTable, fail.Fail].ok{codegen_dwarf.debug_descriptor()};
}

pub fun setup_registry(reg: *lang_target.TargetRegistry) err[outcome.Fail] {
    val register_all_r: err[fail.Fail] = lang_target.register_all(reg, provide_debug_descriptor);
    if (sel register_all_r.err) { ret err[outcome.Fail].err{outcome.from_fail(register_all_r.err)}; }
    ret err[outcome.Fail].ok{};
}
