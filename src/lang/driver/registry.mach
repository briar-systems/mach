use mach.lang.be.codegen.dwarf;
use mach.lang.build.outcome;
use mach.lang.fail;
use mach.lang.target;
use mach.lang.target.of;
use std.types.error.err;
use std.types.result.res;
use std.types.string.str;

fun provide_debug_descriptor() res[of.DebugVTable, fail.Fail] {
    ret res[of.DebugVTable, fail.Fail].ok{dwarf.debug_descriptor()};
}

pub fun setup_registry(reg: *target.TargetRegistry) err[outcome.Fail] {
    val register_all_r: err[fail.Fail] = target.register_all(reg, provide_debug_descriptor);
    if (sel register_all_r.err) { ret err[outcome.Fail].err{outcome.from_fail(register_all_r.err)}; }
    ret err[outcome.Fail].ok{};
}
