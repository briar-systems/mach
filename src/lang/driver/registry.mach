use std.types.canonical.res;
use std.types.canonical.err;
use mach.lang.build.outcome;
use std.types.string.str;
use R: std.types.result;
use mach.lang.be.codegen.dwarf;
use mach.lang.target;
use mach.lang.target.of;

fun provide_debug_descriptor() res[of.DebugVTable, outcome.Fail] {
    ret res[of.DebugVTable, outcome.Fail].ok{dwarf.debug_descriptor()};
}

pub fun setup_registry(reg: *target.TargetRegistry) err[outcome.Fail] {
    ret outcome.lift_user_unit(target.register_all(reg, provide_debug_descriptor));
}
